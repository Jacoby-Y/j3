// Acceptance: a user program can `use j3.game`.
// The wrapper itself is shipped as `j3c/stdlib/j3/game.j3`
// (`use lib`, `#[singleton]`, `poll`; C strings stay behind that file).

module speculative.stdlib_game;

use j3.game;
use j3.math.Vec2;

fn touch(title: string, pos: Vec2) {
    game.init(title, 320, 240);
    game.poll();
    if game.quitRequested() || game.keyDown(game.Key.Escape) {
        game.clear();
        game.drawRect(pos, Vec2 { x: 8, y: 8 });
        game.present();
    }
    game.setResizable(true);
    game.setMinSize(160, 120);
    game.setMaxSize(1920, 1080);
    game.setWindowSize(320, 240);
    let size = game.windowSize();
    game.destroy();
}
