<script>
    use dialog_flicker.state.State;

    props { state: &State; }
</script>

<div class="play">
    <canvas class="arena"></canvas>
    {#if state.fps}<div class="fps">{state.frame} FPS</div>{/if}
    {#if !state.full}
        <div class="toasts">
            {#each 0..state.toasts as i}
                <div class="toast" style:opacity={0.5 + f32((state.frame + i) % 5) * 0.1}>toast {i}</div>
            {/each}
        </div>
    {/if}
    {#if state.frame < 0}
        <div>never</div>
    {:else if state.stats_open}
        <Settings state={state} />
    {/if}
</div>

<style>
    .play { position: relative; width: 100%; height: 100%; }
    .arena { position: absolute; inset: 0; background: #224; }
    .fps { position: absolute; top: 4px; left: 4px; }
    .toasts { position: absolute; top: 30px; left: 4px; display: flex; flex-direction: column; }
</style>
