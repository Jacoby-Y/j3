// Repro: a `<dialog modal>` in an `overflow-y: auto` absolute page, behind `{#if}`/`{#each}` siblings that change every few
// frames, with text in the dialog changing every frame. Panics on a frame where the dialog is not centered.
//   timeout 120 j3c run speculative/71_ui_dialog_flicker --headless --frames 60
module dialog_flicker;

use dialog_flicker.state.State;
use dialog_flicker.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;
use j3.io.printLn;
use j3.sys.panic;
use j3.ui.dom.K_ELEM;

struct World {
    state: State;
    root: Screen;
}

fn boot(mem: &Arena): World {
    return World { state: State {}, root: Screen.new(mem) };
}

fn draw(w: &World) {
    let s = &w.state;
    s.frame += 1;
    // earlier siblings change shape: toasts 0..3 every 3 frames, the camera block every 7, the fps div every 11
    s.toasts = (s.frame / 3) % 4;
    s.full = (s.frame / 7) % 2 == 1;
    s.fps = (s.frame / 11) % 2 == 0;
    w.root.render(windowSize(), ScreenProps { state: s });
    // the open dialog stays centered (it fell to 0,0 when `Dom.abs` listed it before its absolute ancestor)
    let d = &w.root.dom;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].tag == d.tDialog && d.nodes.items[i].kind == K_ELEM && d.absY(i) < 1.0 {
            printLn(`FAIL: frame {s.frame}: dialog at {d.absX(i)},{d.absY(i)}`);
            panic("dialog left the center");
        }
    }
}

fn main() {
    let app = App<World>.create("dialog_flicker", 640, 360, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
