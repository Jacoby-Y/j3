module padnav_probe;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.testkit;
use padnav_probe.ui.{ Screen, ScreenProps };
struct World { mode: string; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { mode: env("PADNAV_MODE"), root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // PADNAV_MODE: none = nothing; walk = Down to the music box, A toggles it, Down to the slider, Right x2, Down to quality;
    // pick = and A opens the list, Down x2, A chooses; end = then Down (Back), Right wraps to Apply, A, Right, A; mouse = the mouse moves: the ring goes
    if same(w.mode, "walk") || same(w.mode, "pick") || same(w.mode, "end") || same(w.mode, "mouse") {
        testkit.padPress(d, w.frame, 6, "Down");
        testkit.padPress(d, w.frame, 8, "A");
        testkit.padPress(d, w.frame, 10, "Down");
        testkit.padPress(d, w.frame, 12, "Right");
        testkit.padPress(d, w.frame, 14, "Right");
        testkit.padPress(d, w.frame, 16, "Down");
    }
    if same(w.mode, "pick") || same(w.mode, "end") {
        testkit.padPress(d, w.frame, 18, "A");
        testkit.padPress(d, w.frame, 20, "Down");
        testkit.padPress(d, w.frame, 22, "Down");
        testkit.padPress(d, w.frame, 24, "A");
    }
    if same(w.mode, "end") {
        testkit.padPress(d, w.frame, 26, "Down");
        testkit.padPress(d, w.frame, 28, "Right");
        testkit.padPress(d, w.frame, 30, "A");
        testkit.padPress(d, w.frame, 32, "Right");
        testkit.padPress(d, w.frame, 34, "A");
    }
    // summary = a bare <summary> (the generated tabindex) is reached by the pad: Down x5 from nothing, A opens it
    if same(w.mode, "summary") {
        for i in 0..5 { testkit.padPress(d, w.frame, 6 + i * 2, "Down"); }
        testkit.padPress(d, w.frame, 16, "A");
    }
    // tab = the same by Tab x6 and Enter
    if same(w.mode, "tab") {
        for i in 0..6 { testkit.simKeys(d, w.frame, 6 + i * 2, "", "Tab"); }
        testkit.simKeys(d, w.frame, 18, "", "Enter");
    }
    if (same(w.mode, "summary") || same(w.mode, "tab")) && w.frame == 30 && !w.root.more { panic("padnav: the summary was not reached or did not open"); }
    if same(w.mode, "mouse") && w.frame == 20 {
        d.simInput(250.0, 190.0, false, 0.0);
    }
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 45 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 45 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("padnav steady frame changed layout style or allocation"); }
    if w.frame == 60 { printLn("padnav_probe ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("padnav probe", 320, 240, boot);
    app.useGl(); app.draw(draw); app.run();
}
