<script>
    props { }
    let music = false;
    let volume: f32 = 0.5;
    let quality = "Low";
    let applied = 0;
    let backs = 0;
    let more = false;
</script>
<div class="screen">
    <div class="title">Settings</div>
    <div class="row">
        <span class="lab">Music</span>
        <input type="checkbox" aria-label="Music" bind:checked={music} />
        <span class="val">{if music { "on" } else { "off" }}</span>
    </div>
    <div class="row">
        <span class="lab">Volume</span>
        <input type="range" min={0} max={1} step={0.1} aria-label="Volume" bind:value={volume} />
    </div>
    <div class="row">
        <span class="lab">Quality</span>
        <select aria-label="Quality" bind:value={quality}>
            <option value="Low">Low</option>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Ultra">Ultra</option>
        </select>
    </div>
    <div class="buttons" focus-group="wrap">
        <button on:click={applied += 1}>Apply</button>
        <button on:click={backs += 1}>Back</button>
    </div>
    <details bind:open={more}>
        <summary>More</summary>
        <p class="more">extra {more}</p>
    </details>
    <p class="status">applied {applied} back {backs} quality {quality}</p>
</div>
<style>
    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }
    .title { margin-bottom: 8px; color: #a0b0d0; font-size: 18px; }
    .row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .lab { width: 70px; }
    .val { color: #a0b0d0; }
    select { width: 120px; height: 28px; }
    input[type="range"] { width: 140px; }
    .buttons { display: flex; gap: 10px; margin-top: 4px; }
    button { width: 70px; height: 28px; background: #3050a0; color: #ffffff; border: none; border-radius: 4px; }
    button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #f9e2af; outline-offset: 2px; }
    summary { margin-top: 6px; width: 70px; height: 20px; }
    summary:focus-visible { outline: 3px solid #f9e2af; outline-offset: 2px; }
    .more { font-size: 12px; color: #a0b0d0; }
    .status { margin-top: 10px; font-size: 12px; color: #a0b0d0; }
</style>
