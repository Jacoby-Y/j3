<script>
    use rich.state.State;
    use j3.ui.spans.SPAN_MENTION;
    use rich.state.matches;
    props { state: &State; }
</script>
<div class="box">
    <p>Chat</p>
    <div class="composer">
        <textarea rich rows="4" placeholder="Message" bind:value={state.text} bind:spans={state.spans} triggers="@" on:trigger={state.open = trigger.len > 0; state.q = trigger; state.tlo = tlo; state.thi = thi;}></textarea>
        {#if state.open}
            <div popover="caret" class="complete" on:close={state.open = false}>
                {#each 0..state.names.len as i}
                    {#if matches(state.names[i], state.q)}
                        <button class="opt" on:click={d.insertToken(d.trigNode, state.tlo, state.thi, state.names[i], SPAN_MENTION, state.names[i]); state.open = false}>{state.names[i]}</button>
                    {/if}
                {/each}
            </div>
        {/if}
    </div>
    <p class="meta">{state.text.len} bytes, {state.spans.len} spans</p>
</div>
