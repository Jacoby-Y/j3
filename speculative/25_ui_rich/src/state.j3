module rich.state;

use j3.ui.spans.Span;

pub struct State {
    text: string = "";
    spans: []Span;
    /// The completion list: shown while a `@` trigger is active; `tlo..thi` is the typed `@ja`.
    open: bool = false;
    q: string = "";
    tlo: int = 0;
    thi: int = 0;
    names: []string;
}

/// Whether `name` starts with the typed `q`, ignoring ASCII case.
pub fn matches(name: string, q: string): bool {
    if q.len > name.len { return false; }
    for i in 0..q.len {
        let a = int(name[i]);
        let b = int(q[i]);
        if a >= 65 && a <= 90 { a += 32; }
        if b >= 65 && b <= 90 { b += 32; }
        if a != b { return false; }
    }
    return true;
}
