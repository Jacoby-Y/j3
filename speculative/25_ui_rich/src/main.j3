// Headless rich-textarea fixture for plan 023 stage 5b: a chat box with a bold run and an atomic @mention chip.
// Prints PASS/FAIL lines and exits 1 on a failure; J3_CAPTURE=out.png:N saves a frame (tools/golden.sh).
module rich;
use rich.state.State;
use rich.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ env, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.dom.Dom;
use j3.ui.spans.{ Span, SPAN_BOLD, SPAN_MENTION };

struct World { mem: &Arena; state: State; root: Screen; frame: int; fails: int; ta: int; }
fn boot(mem: &Arena): World {
    let nm = mem.alloc::<string>(3);
    nm[0] = "@Jane";
    nm[1] = "@Jack";
    nm[2] = "@Jamal";
    return World { mem: mem, state: State { text: "", spans: mem.alloc::<Span>(0), names: nm }, root: Screen.new(mem), frame: 0, fails: 0, ta: -1 };
}
fn check(w: &World, ok: bool, what: string) {
    if ok { printLn(`PASS {what}`); } else { printLn(`FAIL {what}`); w.fails += 1; }
}
fn draw(w: &World) {
    let d = &w.root.dom;
    let s = &w.state;
    if w.frame == 2 {
        for i in 0..d.nodes.len {
            if d.nodes.items[i].tag == d.tInput { w.ta = i; }
        }
        d.focusNode(w.ta);
    } else if w.frame == 4 {
        d.simKeys("Hey @ja", "");
    } else if w.frame == 6 {
        d.simKeys("", "Down");
    } else if w.frame == 7 {
        d.simKeys("", "Up");
    } else if w.frame == 8 {
        d.simKeys("", "Enter");
    } else if w.frame == 12 {
        d.simKeys(" are you there?", "");
    } else if w.frame == 14 {
        let e = &d.eds.items[d.nodes.items[w.ta].edit];
        e.anc = 14;
        e.cur = 17;
        d.simKeys("", "C+b");
    } else if w.frame == 15 {
        d.simKeys("", "End");
    }
    w.root.render(windowSize(), ScreenProps { state: s });
    if w.frame == 5 {
        check(w, s.open && same(s.q, "@ja") && s.tlo == 4 && s.thi == 7, "typing @ja reports the trigger and opens the list");
        let pop = -1;
        for i in 0..d.ovs.len { pop = d.ovs.items[i].v; }
        let cr = d.caretRect(w.ta);
        check(w, pop >= 0 && d.nodes.items[pop].ovCaret, "the list is a caret popover");
        check(w, pop >= 0 && d.absX(pop) >= cr.x - 1.0 && d.absX(pop) <= cr.x + 1.0 && d.absY(pop) >= cr.y + cr.h, "the list hangs under the caret");
    }
    if w.frame == 6 {
        let pe = &d.eds.items[d.nodes.items[w.ta].edit];
        let cp = d.caretRect(w.ta);
        check(w, pe.px >= 0.0 && cp.x - d.absX(w.ta) - 7.0 - pe.px < 0.5 && pe.px - (cp.x - d.absX(w.ta) - 7.0) < 0.5 && cp.y - d.absY(w.ta) - 7.0 - pe.py < 0.5 && pe.py - (cp.y - d.absY(w.ta) - 7.0) < 0.5, "the layout-time caret rect equals what the paint drew");
    }
    if w.frame == 6 {
        check(w, d.cpHot >= 0 && d.caret(w.ta) == 7, "the first entry is active and the caret is untouched");
    }
    if w.frame == 7 {
        check(w, d.caret(w.ta) == 7 && same(s.text, "Hey @ja"), "Down keeps the caret and the text");
    }
    if w.frame == 9 {
        check(w, same(s.text, "Hey @Jane") && s.spans.len == 1 && s.spans[0].kind == SPAN_MENTION && same(s.spans[0].data, "@Jane"), "Enter swaps @ja for the @Jane chip");
        check(w, !s.open && d.ovs.len == 0, "the list closed");
    }
    if w.frame == 16 {
        check(w, same(s.text, "Hey @Jane are you there?"), "typed text and the token label are the bound value");
        check(w, s.spans.len == 2, "a mention and a bold run are bound");
        check(w, s.spans[0].kind == SPAN_MENTION && s.spans[0].start == 4 && same(s.spans[0].data, "@Jane"), "the mention is an atomic span with its id");
        check(w, s.spans[1].kind == SPAN_BOLD && s.spans[1].start == 14 && s.spans[1].len == 3, "Ctrl+B bolded the selection");
        let c = d.caretRect(w.ta);
        check(w, c.x > 0.0 && c.h > 0.0, "the caret rect is known after paint");
        // a capture run ends itself at its frame; a plain run ends here
        if env("J3_CAPTURE").len == 0 || w.fails > 0 { sys.exit(if w.fails == 0 { 0 } else { 1 }); }
    }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("rich", 400, 200, boot);
    app.useGl(); app.draw(draw); app.run();
}
