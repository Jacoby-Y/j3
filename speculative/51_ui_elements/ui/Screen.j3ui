<script>
    props { }
    let open = true;
</script>
<div class="screen page">
    <p class="txt">First line<br>second line<br/>third</p>
    <p class="txt nw">nowrap line one<br>nowrap line two</p>
    <progress class="bar" value="0.4"></progress>
    <meter class="gauge" value="9" min="0" max="10" low="3" high="7" optimum="10"></meter>
    <meter class="gauge" value="5" min="0" max="10" low="3" high="7" optimum="10"></meter>
    <meter class="gauge" value="1" min="0" max="10" low="3" high="7" optimum="10"></meter>
    <details class="box" bind:open={open}><summary>Open section</summary><div class="body">Visible body</div></details>
    <details class="box"><summary>Closed section</summary><div class="body">Hidden body</div></details>
</div>
<style>
    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; color: #202030; }
    .txt { margin-bottom: 8px; font-size: 13px; }
    .nw { white-space: nowrap; }
    .bar { display: block; width: 200px; height: 10px; margin-bottom: 8px; accent-color: #2080e0; background: #d8d8e4; }
    .gauge { display: block; width: 200px; height: 10px; margin-bottom: 6px; background: #d8d8e4; }
    .box { width: 240px; margin-top: 8px; }
    .box summary { font-size: 13px; font-weight: bold; }
    .box summary::before { content: "▸ "; }
    .box:open > summary::before { content: "▾ "; }
    .body { padding: 4px 0 0 14px; font-size: 13px; }
</style>
