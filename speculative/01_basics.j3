// This is a speculative idea of what the language could/should look like

// Notes of things not found in this code:
// types: 
// - u8, u16, u32, u64
// - i8, i16, i32, i64
// - f32, f64
// - bool, void
// - int = i64, float = f64; gameplay math uses f32
// - integer literals default to int unless context says otherwise

// name of this module for importing
module speculative.basics;

// importing from j3 stdlib
use j3.io.printLn;

// module-level constants are allowed; no mutable globals
const name = "Coby";

fn main() {
    // locals infer; `let` is mutable
    let a = 10;
    let b = 20;
    let c = add(a, b);
    increment(&c);

    sayHello();
    greeting(name);
}

fn add(a: int, b: int): int {
    return a + b;
}

fn increment(n: &int) {
    *n += 1;
}

// `(): void` is optional/implied
fn sayHello() {
    printLn("Hello, world!");
}

fn greeting(name: string) {
    // ` for string formatting
    // I'm ok with this being compiler magic
    printLn(`Hello, {name}, how are you?`);
}
