// Threads: `j3.thread` is pthreads behind a small surface. Hand buffers to workers, then read
// results after a signal. Output is deterministic: the counters add up, and the parallel sum is
// reduced in index order.
//
// - `spawn`/`join` run a plain `fn(ptr)`; its state is one `ptr` to a struct the spawner owns.
// - `Mutex` and `@atomicAdd` both make a shared counter exact.
// - `Queue<T>` is a blocking ring; `Pool` runs jobs on workers; `parallelFor` splits `0..n`.
// - `Pool.trySubmit` never blocks: false means the queue is full, keep the job for next frame.
// - `#[thread]` is one global per thread.

module threads;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.thread.{ Mutex, Pool, Queue, Thread, join, spawn };

#[singleton]
#[thread]
let SEEN: int = 0;

struct Shared {
    locked: int;
    atomic: int;
    m: Mutex;
}

fn bump(arg: ptr) {
    let s = arg as &Shared;
    SEEN = SEEN + 1;
    for i in 0..10000 {
        s.m.lock();
        s.locked += 1;
        s.m.unlock();
        @atomicAdd(&s.atomic, 1);
    }
}

struct Feed {
    q: Queue<int>;
}

fn produce(arg: ptr) {
    let f = arg as &Feed;
    for i in 1..=100 {
        f.q.push(i);
    }
    f.q.close();
}

struct Squares {
    out: []int;
}

fn square(ctx: ptr, lo: int, hi: int) {
    let s = ctx as &Squares;
    for i in lo..hi {
        s.out[i] = i * i;
    }
}

struct Gate {
    m: Mutex;
    started: int;
    ran: int;
}

/// Holds the only worker until main unlocks the gate.
fn blocker(arg: ptr) {
    let g = arg as &Gate;
    @atomicStore(&g.started, 1);
    g.m.lock();
    g.m.unlock();
    @atomicAdd(&g.ran, 1);
}

fn count(arg: ptr) {
    let g = arg as &Gate;
    @atomicAdd(&g.ran, 1);
}

fn main() {
    let arena = Arena.create(1048576);

    let s = Shared { locked: 0, atomic: 0, m: Mutex {} };
    let ts = arena.alloc::<Thread>(4);
    for i in 0..4 {
        spawn(&ts[i], "bump", bump, &s as ptr);
    }
    for i in 0..4 {
        join(&ts[i]);
    }
    printLn(`locked={s.locked} atomic={s.atomic} main seen={SEEN}`);

    let f = Feed { q: Queue<int>.create(&arena, 8) };
    let p = Thread { f: produce };
    spawn(&p, "producer", produce, &f as ptr);
    let sum = 0;
    while true {
        match f.q.pop() {
            Option.None { break; }
            Option.Some(v) { sum += v; }
        }
    }
    join(&p);
    printLn(`queue sum={sum}`);

    let pool = Pool.create(&arena, 4, 16);
    let sq = Squares { out: arena.alloc::<int>(1000) };
    pool.parallelFor(1000, square, &sq as ptr);
    let total = 0;
    for i in 0..1000 {
        total += sq.out[i];
    }
    printLn(`squares total={total}`);
    pool.shutdown();

    // One worker, one queue slot: hold the worker, fill the slot, and the next job is refused.
    let g = Gate { m: Mutex {}, started: 0, ran: 0 };
    let small = Pool.create(&arena, 1, 1);
    g.m.lock();
    small.submit(blocker, &g as ptr);
    while @atomicLoad(&g.started) == 0 {
    }
    let first = small.trySubmit(count, &g as ptr);
    let second = small.trySubmit(count, &g as ptr);
    let queued = small.pendingJobs();
    g.m.unlock();
    small.wait();
    printLn(`trySubmit first={first} second={second} pending={queued} ran={g.ran} after={small.pendingJobs()}`);
    small.shutdown();
}
