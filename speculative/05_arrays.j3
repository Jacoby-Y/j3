// Arrays and slices. Decisions in this file:
// - `[N]T` is a real stack value (size known at compile time)
// - `[]T` is sugar for `{ ptr: &T, len: int }` — a view, no alloc
// - `[N]T` auto-converts to `[]T` (convenient)
// - index with `int`; `xs[i]` is an lvalue when the backing is `let`
// - bounds checks on by default; `j3 build --fast` strips them
// - `xs[1..3]` half-open slice; `xs[:]` whole view
// - `string` is stdlib: a read-only `[]u8` view, UTF-8; mutate via `Text`
// - growable lists live in 07 (they need an arena)

module speculative.arrays;

use j3.io.printLn;

fn sum(xs: []int): int {
    let total = 0;
    for i in 0..xs.len {
        total += xs[i];
    }
    return total;
}

fn main() {
    let xs: [4]int = [10, 20, 30, 40];

    // fixed array -> slice (view into xs, no copy)
    let all: []int = xs[:];
    let mid: []int = xs[1..3];

    xs[0] = 11;
    mid[0] = 21; // writes xs[1]

    printLn(`sum={sum(all)} mid0={mid[0]}`);

    for i, n in xs {
        printLn(`xs[{i}]={n}`);
    }

    let name: string = "Coby";
    printLn(`hi {name} bytes={name.len}`);
}
