<script>
    use dataflow.state.State;
    props { state: &State; }
    provide state;
</script>
<div>
    <Pad on:pick={state.slot = event.slot} on:rename={state.name = event.name; state.n = event.n} on:close={state.n += 100} />
    <Panel on:done={state.sum += event.v * 100} />
    <Holder><Deep /></Holder>
    {#each 0..2 as i}
        <Mid />
    {/each}
</div>
