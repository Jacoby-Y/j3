// Plan 023 stage 5 at runtime: event payloads (`pick(slot: int)` inside the component's own {#each}, a
// string + int payload, a plain event beside them, an emit from slot content), and `provide`/`inject`
// through a slot and through components inside an {#each}.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 20 j3c run speculative/17_ui_dataflow --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module dataflow;

use dataflow.state.State;
use dataflow.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.testkit.{ clickTag, hasText };

struct World {
    state: State;
    root: Screen;
    frame: int;
    fails: int;
}

fn boot(mem: &Arena): World {
    return World { state: State {}, root: Screen.new(mem), frame: 0, fails: 0 };
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    let d = &w.root.dom;
    let s = &w.state;
    w.frame += 1;
    clickTag(d, w.frame, 3, "button", 1);
    if w.frame == 7 {
        check(w, s.slot == 1, "pick(i) from the component's own {#each} carries the index");
    }
    clickTag(d, w.frame, 7, "button", 3);
    if w.frame == 11 {
        check(w, same(s.name, "bob") && s.n == 7, "two payload fields (string, int)");
    }
    clickTag(d, w.frame, 11, "button", 4);
    if w.frame == 15 {
        check(w, s.n == 107 && s.slot == 1, "a plain event next to payload events");
    }
    clickTag(d, w.frame, 15, "button", 5);
    if w.frame == 19 {
        check(w, s.sum == 400, "payload emitted from slot content reaches the handler");
    }
    clickTag(d, w.frame, 19, "button", 6);
    clickTag(d, w.frame, 23, "button", 8);
    if w.frame == 27 {
        check(w, s.sum == 402, "inject through slot content and a component in an {#each}");
        check(w, hasText(d, "d402"), "injected state is shared");
        if w.fails == 0 {
            printLn("all passed");
        }
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
}

fn main() {
    let app = App<World>.create("dataflow", 640, 480, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
