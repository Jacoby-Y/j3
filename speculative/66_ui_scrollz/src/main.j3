module uiscrollz;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use uiscrollz.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; builds: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("STACK_MODE"), frame: 0, builds: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // scrolled: one wheel notch over the first demo's z 10 child (the page is at 10, 10; the demo 140 x 110)
    if same(w.mode, "scrolled") && w.frame >= 3 {
        d.simInput(45.0, 50.0, false, if w.frame == 3 { -1.0 } else { 0.0 });
    } else {
        d.simInput(-5.0, -5.0, false, 0.0);
    }
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 40 { w.builds = d.stackBuilds; }
    if w.frame > 40 && d.stackBuilds != w.builds { panic("uiscrollz idle frame rebuilt the stacking lists"); }
    if w.frame == 100 { printLn("uiscrollz ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uiscrollz", 640, 330, boot);
    app.useGl(); app.draw(draw); app.run();
}
