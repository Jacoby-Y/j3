<script>
    props { }
    let size = "m";
    let tone = "b";
    let level = 2;
</script>
<div class="screen page">
    <div class="col" role="radiogroup">
        <p class="hd">default</p>
        <label class="row"><input type="radio" name="size" value="s" bind:group={size} /> <span>Small</span></label>
        <label class="row"><input type="radio" name="size" value="m" bind:group={size} /> <span>Medium</span></label>
        <label class="row"><input type="radio" name="size" value="l" bind:group={size} /> <span>Large</span></label>
        <label class="row"><input type="radio" name="size" value="x" disabled bind:group={size} /> <span>Huge (off)</span></label>
    </div>
    <div class="col styled" role="radiogroup">
        <p class="hd">styled</p>
        <label class="row"><input id="ta" type="radio" name="tone" value="a" bind:group={tone} /> <span>Rose</span></label>
        <label class="row"><input id="tb" type="radio" name="tone" value="b" bind:group={tone} /> <span>Moss</span></label>
        <label class="row"><input id="tc" type="radio" name="tone" value="c" disabled bind:group={tone} /> <span>Sky (off)</span></label>
    </div>
    <div class="col" role="radiogroup">
        <p class="hd">ints, same name</p>
        <label class="row"><input type="radio" name="size" value={1} bind:group={level} /> <span>One</span></label>
        <label class="row"><input type="radio" name="size" value={2} bind:group={level} /> <span>Two</span></label>
        <label class="row"><input type="radio" name="size" value={3} bind:group={level} /> <span>Three</span></label>
        <p class="out">level {level}, size {size}</p>
    </div>
</div>
<style>
    .screen { display: flex; gap: 14px; width: 100%; height: 100%; padding: 12px; }
    .col { display: flex; flex-direction: column; gap: 8px; width: 104px; }
    .hd { font-size: 11px; color: #707088; }
    .row { display: flex; align-items: center; gap: 6px; }
    .out { font-size: 11px; margin-top: 6px; }
    .styled input { width: 22px; height: 22px; accent-color: #3f9a5a; background: #fdeaea; border-radius: 50%; }
    .styled input:disabled { opacity: 0.4; }
    .styled input:focus-visible { outline: 2px solid #d04060; outline-offset: 2px; }
    .styled input:checked + span { color: #3f9a5a; font-weight: 700; }
    input:focus-visible { outline: 2px solid #3070c0; outline-offset: 1px; }
    input:disabled + span { opacity: 0.5; }
</style>
