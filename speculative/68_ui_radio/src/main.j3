// Plan 027 chunk 9: `<input type="radio">` with `bind:group` (strings, ints), `name` groups scoped by `role="radiogroup"`, accent-color and
// :checked / :disabled / :focus-visible styling. Needs DejaVu Sans. States: rest; keys (Tab to the first group's checked radio, Down to the
// next: focus ring and check move); styled (Tab twice then Down: the styled group, ring in its own colour).
module uiradio;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.memory.Arena;
use j3.ui.testkit;
use uiradio.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("RADIO_MODE"), frame: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    w.root.render(windowSize(), ScreenProps { });
    if !same(w.mode, "rest") && w.mode.len > 0 {
        let tabs = if same(w.mode, "styled") { 2 } else { 1 };
        for i in 0..tabs { testkit.simKeys(d, w.frame, 3 + 3 * i, "", "Tab"); }
        testkit.simKeys(d, w.frame, 3 + 3 * tabs, "", "Down");
    }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uiradio", 400, 190, boot);
    app.useGl(); app.draw(draw); app.run();
}
