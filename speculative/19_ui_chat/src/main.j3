// Plan 023 stage 1 (chunk 1c) at runtime: a 100000-line chat in a `virtual stick-to-bottom` box with rows of
// varied (wrapped) height. Checks: heights are measured and converge (idle frames lay out nothing), it sticks to
// the bottom on append, scrolling up releases it, rows that load above keep the visible message in place
// (scroll anchoring), jump-to-latest through `bind:at-end`, `keep` rows survive off screen, and a long run of
// random jumps does not grow the arena.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 300 j3c run speculative/19_ui_chat --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module chat;

use chat.state.{ Msg, State };
use chat.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ micros, windowSize };
use j3.io.printLn;
use j3.math.{ abs, max };
use j3.memory.{ Arena, rewindScratch };
use j3.sys;
use j3.ui.dom.{ Dom, DP_NONE, K_FREE };

const N: int = 100000;
const OLD: int = 100;
const SPARE: int = 50;
const BIG: f32 = 100000000.0;
const GONE: f32 = 99999.0;
const LOREM: string = "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega";

struct World {
    mem: &Arena;
    state: State;
    root: Screen;
    fails: int;
    all: []Msg;
    noKeep: []string;
}

fn boot(mem: &Arena): World {
    let total = OLD + N + SPARE;
    let all = mem.alloc::<Msg>(total);
    let lorem = LOREM;
    for i in 0..total {
        // 1 to about 9 wrapped lines
        all[i] = Msg { id: i, text: lorem[0..6 + (i * 37) % (lorem.len - 6)] };
    }
    let none = mem.alloc::<string>(0);
    let w = World { mem: mem, state: State { msgs: all[OLD..OLD + N], atEnd: false, keep: none }, root: Screen.new(mem), fails: 0, all: all, noKeep: none };
    w.root.dom.setFrameMs(10.0);
    return w;
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn frame(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    rewindScratch();
}

fn frames(w: &World, n: int) {
    for i in 0..n {
        frame(w);
    }
}

fn box(d: &Dom): int {
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE && d.nodes.items[i].tag == d.tag("div") {
            return i;
        }
    }
    return -1;
}

fn live(d: &Dom): int {
    let n = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE {
            n += 1;
        }
    }
    return n;
}

/// The id shown in row `c` (a `<p>`; its first span).
fn idOf(d: &Dom, c: int): int {
    let s = d.textOf(d.nodes.items[d.nodes.items[c].first].first);
    let v = 0;
    for i in 0..s.len {
        v = v * 10 + (s[i] - 48) as int;
    }
    return v;
}

/// The row `<p>` for message `id` among the box's children, -1 if it is not alive.
fn rowOf(d: &Dom, b: int, id: int): int {
    let c = d.nodes.items[b].first;
    while c >= 0 {
        if idOf(d, c) == id {
            return c;
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

/// Px from the top of the box to the top of message `id` (NaN-free: -99999 when it is not alive).
fn offsetOf(d: &Dom, b: int, id: int): f32 {
    let c = rowOf(d, b, id);
    if c < 0 {
        return 0.0 - GONE;
    }
    return d.nodes.items[c].y - d.nodes.items[b].scrollY;
}

/// The row that holds the viewport's top edge (the scroll anchor), as a message id.
fn firstVisible(d: &Dom, b: int): int {
    let c = d.nodes.items[b].first;
    while c >= 0 {
        if d.nodes.items[c].y + d.nodes.items[c].h > d.nodes.items[b].scrollY && d.nodes.items[c].disp != DP_NONE {
            return idOf(d, c);
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

fn lastRowId(d: &Dom, b: int): int {
    let c = d.nodes.items[b].last;
    return idOf(d, c);
}

fn near(a: f32, b: f32, tol: f32): bool {
    return abs(a - b) <= tol;
}

fn run(w: &World) {
    let d = &w.root.dom;
    let st = &w.state;
    frames(w, 6);
    let b = box(d);
    let lastId = OLD + N - 1;

    // starts at the bottom (stick-to-bottom), measured rows, bounded nodes
    check(w, lastRowId(d, b) == lastId, `starts at the end: last row {lastRowId(d, b)} of {lastId}`);
    check(w, near(d.nodes.items[b].scrollY, d.nodes.items[b].scrollMax, 1.5), `scroll offset at the end ({d.nodes.items[b].scrollY} of {d.nodes.items[b].scrollMax})`);
    check(w, st.atEnd, "bind:at-end reads true at the end");
    check(w, live(d) < 200, `100000 rows: {live(d)} live nodes`);
    let c0 = d.nodes.items[b].first;
    let hmin: f32 = 99999.0;
    let hmax: f32 = 0.0;
    while c0 >= 0 {
        hmin = if d.nodes.items[c0].h < hmin { d.nodes.items[c0].h } else { hmin };
        hmax = if d.nodes.items[c0].h > hmax { d.nodes.items[c0].h } else { hmax };
        c0 = d.nodes.items[c0].next;
    }
    check(w, hmax > hmin + 20.0, `rows have varied heights ({hmin}..{hmax})`);

    // idle at the end: converged, nothing laid out or restyled, no allocation
    frames(w, 60);
    let laid = d.laid;
    let rs = d.restyled;
    let used = w.mem.used;
    frames(w, 300);
    check(w, d.laid == laid && d.restyled == rs, `300 idle frames: 0 layouts, 0 restyles ({d.laid - laid}, {d.restyled - rs})`);
    check(w, w.mem.used == used, "300 idle frames: 0 arena growth");

    // appends keep it at the end
    let worst = 0;
    for k in 0..5 {
        st.msgs = w.all[OLD..OLD + N + 1 + k];
        let t0 = micros();
        frame(w);
        let us = micros() - t0;
        worst = if us > worst { us } else { worst };
        frames(w, 2);
    }
    // before the append fast path this frame formatted all 100000 keys: 17.7 ms (dev build)
    printLn(`append 1 message to 100000 (stuck at the end): worst frame {worst} us`);
    check(w, worst < 5000, `an append is not O(rows): worst frame {worst} us (< 5000)`);
    lastId = OLD + N + 4;
    check(w, lastRowId(d, b) == lastId && near(d.nodes.items[b].scrollY, d.nodes.items[b].scrollMax, 1.5), `5 appends: still at the end ({d.nodes.items[b].scrollY} of {d.nodes.items[b].scrollMax}, last row {lastRowId(d, b)})`);

    // scrolling up releases the stick; appends no longer move the view
    d.scrollBy(b, f32(0 - 900));
    frames(w, 4);
    check(w, !st.atEnd, "scrolled up: at-end is false");
    let top = firstVisible(d, b);
    let off = offsetOf(d, b, top);
    let y0 = d.nodes.items[b].scrollY;
    for k in 0..3 {
        st.msgs = w.all[OLD..OLD + N + 6 + k];
        frames(w, 3);
    }
    check(w, near(offsetOf(d, b, top), off, 1.0) && near(d.nodes.items[b].scrollY, y0, 1.0), `released: 3 appends leave the view alone (message {top} at {offsetOf(d, b, top)}, was {off})`);
    check(w, !st.atEnd, "still not at the end");

    // jump to latest: the button sets the bound variable
    st.atEnd = true;
    frames(w, 4);
    check(w, lastRowId(d, b) == OLD + N + 7 && near(d.nodes.items[b].scrollY, d.nodes.items[b].scrollMax, 1.5), `jump to latest ({d.nodes.items[b].scrollY} of {d.nodes.items[b].scrollMax})`);
    st.msgs = w.all[OLD..OLD + N + 9];
    frames(w, 3);
    check(w, lastRowId(d, b) == OLD + N + 8, "stuck again after the jump: an append stays at the end");

    // anchoring: jump into unmeasured space. The rows around the viewport are built with the estimate and
    // measured one frame later (the average, and with it every px above, changes by thousands); once measured,
    // the message at the top of the view does not move (the first frame after a long jump can be a few px off:
    // the rows above the view are laid out at their real height before they are measured)
    d.scrollBy(b, f32(0 - 100000000));
    d.scrollBy(b, f32(60000 * 60));
    frames(w, 2);
    let a = firstVisible(d, b);
    let ao = offsetOf(d, b, a);
    frames(w, 6);
    let ao2 = offsetOf(d, b, a);
    check(w, near(ao2, ao, 1.0), `jump into unmeasured rows: message {a} at {ao2}, was {ao} (anchored)`);
    // a message is kept in place when rows above it are measured: scroll 40 px at a time, the anchor offset
    // before each step plus 40 is the offset after it
    let bad = 0;
    for step in 0..40 {
        let t = firstVisible(d, b);
        let o1 = offsetOf(d, b, t);
        d.scrollBy(b, f32(0 - 40));
        frames(w, 2);
        let o2 = offsetOf(d, b, t);
        if o2 > 1.0 - GONE && !near(o2, o1 + 40, 1.5) {
            bad += 1;
        }
    }
    check(w, bad == 0, `40 small scroll steps: {bad} jumps`);

    // older messages load above: the visible message stays within 1 px
    frames(w, 6);
    let v = firstVisible(d, b);
    let vo = offsetOf(d, b, v);
    let y1 = d.nodes.items[b].scrollY;
    st.msgs = w.all[0..OLD + N + 9];
    frames(w, 4);
    let v2 = offsetOf(d, b, v);
    check(w, near(v2, vo, 1.0), `{OLD} older messages loaded above: message {v} at {v2}, was {vo}`);
    check(w, d.nodes.items[b].scrollY > y1 + 100, `the scroll offset moved down by the new rows ({d.nodes.items[b].scrollY - y1} px)`);
    check(w, !st.atEnd, "loading older messages does not stick to the end");
    // and again, from the middle of unmeasured space, with all heights unknown above
    d.scrollBy(b, 0.0 - BIG);
    d.scrollBy(b, f32(30000 * 70));
    frames(w, 6);
    v = firstVisible(d, b);
    vo = offsetOf(d, b, v);
    st.msgs = w.all[0..OLD + N + 7];
    frames(w, 4);
    check(w, near(offsetOf(d, b, v), vo, 1.0), `removing 2 rows at the end leaves message {v} in place`);
    st.msgs = w.all[0..OLD + N + 9];
    frames(w, 4);

    // idle in the middle
    frames(w, 30);
    laid = d.laid;
    rs = d.restyled;
    used = w.mem.used;
    frames(w, 300);
    check(w, d.laid == laid && d.restyled == rs, `idle mid-list: 0 layouts, 0 restyles ({d.laid - laid}, {d.restyled - rs})`);
    check(w, w.mem.used == used, "idle mid-list: 0 arena growth");

    // keep: a row named in `keep` stays alive (hidden) outside the window, and keeps its nodes
    let keys = w.mem.alloc::<string>(1);
    keys[0] = "50000";
    st.keep = keys;
    d.scrollBy(b, 0.0 - BIG);
    d.scrollBy(b, f32(50000 * 70));
    frames(w, 8);
    let kc = rowOf(d, b, 50000);
    d.scrollBy(b, 0.0 - BIG);
    frames(w, 4);
    let kc2 = rowOf(d, b, 50000);
    check(w, kc >= 0 && kc2 == kc && d.nodes.items[kc2].disp == DP_NONE, "kept row stays alive off screen, hidden, same nodes");
    check(w, live(d) < 200, `kept row costs a few nodes ({live(d)} live)`);
    laid = d.laid;
    frames(w, 30);
    check(w, d.laid == laid, "kept row off screen: 0 layouts when idle");
    st.keep = w.noKeep;
    frames(w, 3);
    check(w, rowOf(d, b, 50000) < 0, "dropped from keep: the row goes");
    keys[0] = "no such key";
    st.keep = keys;
    frames(w, 3);
    check(w, live(d) < 200, "a kept key that is not in the list holds nothing");
    st.keep = w.noKeep;

    // 10000 frames jumping across the list, twice with the same jumps: the first passes reach the high-water
    // marks (windows of short rows hold more nodes, and a recycled node keeps the largest text it ever held, so the pool
    // converges over a few passes), the last replay must not allocate at all
    let grown = 0;
    for pass in 0..4 {
        let seed = 777;
        let u0 = w.mem.used;
        for it in 0..10000 {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            d.scrollBy(b, f32(0 - 100000000));
            d.scrollBy(b, f32(seed % 90000) * 60.0);
            frame(w);
        }
        grown = w.mem.used - u0;
        printLn(`jumping pass {pass}: arena grew {grown} bytes`);
    }
    check(w, grown == 0, `10000 jumping frames, replayed: arena grew {grown} bytes`);
    check(w, live(d) < 300, `live nodes after the jumps: {live(d)}`);

    // shrink and empty
    st.msgs = w.all[0..5];
    frames(w, 4);
    check(w, d.nodes.items[b].first >= 0 && d.nodes.items[b].scrollY <= d.nodes.items[b].scrollMax + 1.0, "shrunk to 5 messages");
    st.msgs = w.all[0..0];
    frames(w, 3);
    check(w, d.nodes.items[b].first < 0, "empty chat");
    st.msgs = w.all[OLD..OLD + N];
    frames(w, 6);
    check(w, lastRowId(d, b) == OLD + N - 1, "grows back from empty and sticks to the end");
}

fn draw(w: &World) {
    run(w);
    if w.fails == 0 {
        printLn("all passed");
    }
    sys.exit(if w.fails == 0 { 0 } else { 1 });
}

fn main() {
    let app = App<World>.create("chat", 320, 240, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
