module flip_probe;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.testkit;
use flip_probe.ui.{ Screen, ScreenProps };
struct World { order: []int; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    let order = mem.alloc::<int>(5);
    for i in 0..5 { order[i] = i; }
    return World { order: order, root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // frame 6: reverse the list; the rows glide for 300 ms (about 19 frames at 16 ms)
    if w.frame == 6 {
        for i in 0..5 { w.order[i] = 4 - i; }
    }
    w.root.render(windowSize(), ScreenProps { order: w.order, n: 5 });
    if w.frame == 40 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 40 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("flip steady frame changed layout style or allocation"); }
    if w.frame == 60 { printLn("flip_probe ok: reorder glides, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("flip probe", 340, 260, boot);
    app.useGl(); app.draw(draw); app.run();
}
