<script>
    props { order: []int; n: int; }
    fn name(v: int): string { return if v == 0 { "Apple" } else if v == 1 { "Bread" } else if v == 2 { "Cheese" } else if v == 3 { "Dates" } else { "Eggs" }; }
</script>
<div class="screen">
    <div class="title">Pantry</div>
    <div class="list">
        {#each 0..n as i (order[i])}
            <div class="row r{order[i]}" animate:flip={300} animate-easing="linear">{name(order[i])}</div>
        {/each}
    </div>
</div>
<style>
    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }
    .title { margin-bottom: 8px; color: #a0b0d0; }
    .list { display: flex; flex-direction: column; gap: 6px; }
    .row { height: 26px; padding: 6px 10px; box-sizing: border-box; border-radius: 4px; background: #3050a0; }
    .r1 { background: #a05030; }
    .r3 { background: #308050; }
</style>
