<script>
    use steady.state.State;
    props { state: &State; }
</script>
<div>
    <p>{state.n}</p>
    <p class="size {state.cls()}" title={state.tip()}>{state.size()}</p>
    {#each 0..3 as i (state.key(i))}
        <p class="row" title={state.tip()}>{state.row(i)}</p>
    {/each}
    <div class="stage"><div class="pa" style:left={state.pos} style:top={state.pos}></div><div class="pb" style:right={state.pos} style:bottom={state.pos}></div></div>
    <input type="text" value={state.row(1)} />
</div>
