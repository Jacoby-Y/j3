<script>
    use steady.state.State;
    props { state: &State; }
</script>
<div>
    <p>{state.n}</p>
    <p class="size {state.cls()}" title={state.tip()}>{state.size()}</p>
    {#each 0..3 as i (state.key(i))}
        <p class="row" title={state.tip()}>{state.row(i)}</p>
    {/each}
    <div class="stage"><div class="pa" style:left={state.pos} style:top={state.pos}></div><div class="pb" style:right={state.pos} style:bottom={state.pos}></div></div>
    <input type="text" value={state.row(1)} />
    <!-- icons fill paths every frame: `rss_growth_kb` catches GL uploads the driver keeps (NVIDIA queued them unfenced) -->
    <div><icon name="gear" /><icon name="x-lg" /><icon name="command" /><icon name="dash-lg" /><icon name="square" /><icon name="plus-lg" /><icon name="kanban" /><icon name="journal-text" /><icon name="layout-split" /><icon name="terminal" /><icon name="trash" /><icon name="folder" /></div>
</div>
