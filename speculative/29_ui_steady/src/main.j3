// Plan 023 stage 8a: `J3_STEADY=a:b` catches per-frame work. Idle: rc 0. `STEADY_CHURN=1` changes a value every frame: rc 1.
// 9b: the markup calls fns that return strings built in frame scratch (text, title, class, keyed each key); churn asserts the text.
//   J3_STEADY=30:60 j3c run speculative/29_ui_steady --headless --frames 80
//   STEADY_CHURN=1 J3_STEADY=30:60 j3c run speculative/29_ui_steady --headless --frames 80
module steady;

use steady.state.State;
use steady.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ env, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.testkit.{ hasText, tagNode, textNode };

struct World { state: State; root: Screen; churn: bool; frame: int; }

fn boot(mem: &Arena): World {
    return World { state: State {}, root: Screen.new(mem), churn: env("STEADY_CHURN").len > 0, frame: 0 };
}

fn draw(w: &World) {
    if w.churn {
        // the `value=` copy must survive the rewind: the scratch bytes it came from are gone by now
        let inp = tagNode(&w.root.dom, "input", 0);
        if inp >= 0 && w.state.n > 0 && !same(w.root.dom.strValue(inp), w.state.row(1)) {
            panic("steady: value= kept a scratch view");
        }
        w.state.n += 1;
    }
    if w.frame == 10 {
        w.state.pos = 17;
    }
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    if w.frame == 3 || w.frame == 12 {
        offsets(w, if w.frame == 3 { 5.0 } else { 17.0 });
    }
    w.frame += 1;
    // 9b: the scratch strings of this frame are on screen (the node holds its own copy, not the scratch view)
    if w.churn {
        let d = &w.root.dom;
        if !hasText(d, w.state.size()) || !hasText(d, w.state.row(0)) || !hasText(d, w.state.row(2)) {
            panic("steady: scratch text did not reach the screen");
        }
        let tn = textNode(d, w.state.row(0));
        let tip = w.state.tip();
        if tn < 0 || !same(d.tipOf(d.nodes.items[tn].parent), tip) {
            panic("steady: title did not reach the node");
        }
        let inp2 = tagNode(d, "input", 0);
        let want = w.state.row(1);
        if inp2 < 0 || !same(d.strValue(inp2), want) {
            panic("steady: value= text did not reach the node");
        }
    }
}

/// 14: `style:left/top` offset (node x/y are local to the parent) from the stage's top left, `style:right/bottom` from its bottom right.
fn offsets(w: &World, v: f32) {
    let d = &w.root.dom;
    let st = &d.nodes.items[tagNode(d, "div", 1)];
    let a = &d.nodes.items[tagNode(d, "div", 2)];
    let b = &d.nodes.items[tagNode(d, "div", 3)];
    if a.x != v || a.y != v || st.w - (b.x + b.w) != v || st.h - (b.y + b.h) != v {
        panic("steady: style:left/top/right/bottom did not place the boxes");
    }
    printLn("style:left/top/right/bottom place absolute boxes");
}

/// 9a: `App.shutdown` callbacks run once each, in order, on every way out (`--frames`, `J3_STEADY`).
fn bye1(w: &World) {
    printLn("shutdown 1");
}

fn bye2(w: &World) {
    printLn("shutdown 2");
}

fn main() {
    let app = App<World>.create("steady", 320, 200, boot);
    app.useGl();
    app.draw(draw);
    app.shutdown(bye1);
    app.shutdown(bye2);
    app.run();
}
