module steady.state;

use j3.text.{ Text, scratchText, fmtBytes, fmtInt };

/// `n` counts up with `STEADY_CHURN=1`; `big` is a constant that makes the sizes non-trivial.
pub struct State {
    n: int = 0;
    /// 14: offset of the absolutely positioned boxes (`style:left` / `top` / `right` / `bottom`).
    pos: int = 5;

    /// 9b: strings built in frame scratch and returned to markup. The views die at the next frame.
    fn size(this: &State): string {
        let t = scratchText();
        return fmtBytes(&t, this.n * 1000 + 1500);
    }

    fn tip(this: &State): string {
        let t = scratchText();
        t.pushStr("tip ");
        fmtInt(&t, this.n);
        return t.str();
    }

    fn cls(this: &State): string {
        let t = scratchText();
        t.pushStr(if this.n % 2 == 0 { "even" } else { "odd" });
        return t.str();
    }

    fn key(this: &State, i: int): string {
        let t = scratchText();
        t.pushStr("k");
        fmtInt(&t, i);
        return t.str();
    }

    fn row(this: &State, i: int): string {
        let t = scratchText();
        fmtInt(&t, this.n * 1000 + i);
        return t.str();
    }
}
