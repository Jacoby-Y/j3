// Generated markup integration; run --headless. Panics on a regression, quits itself after 100 frames.
module context;
use context.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ windowSize };
use j3.memory.Arena;
use j3.sys.{ panic, exit };
use j3.io.printLn;
struct World { root: Screen; frame: int; }
fn boot(mem: &Arena): World { return World { root: Screen.new(mem), frame: 0 }; }
fn draw(w: &World) {
    let d = &w.root.dom; d.setFrameMs(16.0);
    d.simInput(380.0, 280.0, false, 0.0);
    d.simRight(w.frame == 2);
    if w.frame == 5 { d.simKeys("b", ""); }
    if w.frame == 7 { d.simKeys("", "Escape"); }
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 4 && (d.ovs.len != 1 || d.focus < 0) { panic("context markup opens and focuses"); }
    if w.frame == 9 && d.ovs.len != 0 { panic("Escape closes bound context popup"); }
    if w.frame == 60 && (d.ovs.len != 1) { panic("hover binding opens markup without focus steal"); }
    if w.frame == 99 { printLn("PASS generated context popover and hover-card binding"); exit(0); }
    w.frame += 1;
}
fn main() { let app = App<World>.create("context", 400, 300, boot); app.useGl(); app.draw(draw); app.run(); }
