<script>
let menu: bool = false;
let card: bool = false;
</script>
<div class="page">
  <div class="owner" bind:tooltip={card} on:contextmenu={menu = true}>
    Right click or hover
    {#if menu}
      <div class="menu" popover="context" on:close={menu = false}>
        <button>Apple</button><button>Blueberry</button><button>Éclair</button>
      </div>
    {/if}
    {#if card}
      <div class="card" popover><span>Custom markup</span><button>Details</button></div>
    {/if}
  </div>
</div>
<style>
.page { width: 400px; height: 300px; background: #181825; color: #ffffff; }
.owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; }
.menu, .card { width: 160px; padding: 8px; background: #313244; border-radius: 8px; box-shadow: 0 4px 12px #000000; }
button { display: block; width: 140px; height: 28px; }
</style>
