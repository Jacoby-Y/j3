// What the language is for. Decisions in this file:
// - platform/window/time are stdlib (`j3.game`), not compiler hooks
// - systems are fn pointers, no vtables, no capturing closures
// - SoA world + integer ids (see 07)
// - one Arena header in `main`; Game holds `&Arena` (never Arena by value)
// - `game.poll()` pumps input and returns f32 dt — call it once per frame

module speculative.game_loop;

use j3.game;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;

struct World {
    pos: []Vec2;
    vel: []Vec2;
    count: int;
}

struct Game {
    mem: &Arena;
    world: World;
    running: bool;
}

fn moveSystem(world: &World, dt: f32) {
    for i in 0..world.count {
        world.pos[i] = world.pos[i] + world.vel[i] * dt;
    }
}

fn boot(mem: &Arena): Game {
    let pos = mem.alloc::<Vec2>(256);
    let vel = mem.alloc::<Vec2>(256);
    pos[0] = Vec2 { x: 40, y: 40 };
    vel[0] = Vec2 { x: 60, y: 0 };

    return Game {
        mem: mem,
        world: World {
            pos: pos,
            vel: vel,
            count: 1,
        },
        running: true,
    };
}

fn tick(g: &Game, dt: f32) {
    // g.mem is a place of type &Arena; checkpoint hits the header in main
    let frame = g.mem.checkpoint();
    defer g.mem.rewind(frame);

    if game.quitRequested() || game.keyDown(game.Key.Escape) {
        g.running = false;
        return;
    }

    let systems: []fn(&World, f32) = [moveSystem];
    for sys in systems {
        sys(&g.world, dt);
    }

    game.clear();
    for i in 0..g.world.count {
        game.drawRect(g.world.pos[i], Vec2 { x: 8, y: 8 });
    }
}

fn main() {
    let mem = Arena.create(16 * 1024 * 1024);
    defer mem.destroy();

    let g = boot(&mem);

    while g.running {
        tick(&g, game.poll());
        game.present();
    }

    printLn("bye");
}
