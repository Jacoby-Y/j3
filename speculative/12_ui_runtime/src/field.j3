// Bricks and balls, drawn from Sim with plain j3.game calls. ui/Game.j3ui
// calls these from its <canvas>, in canvas-local coordinates.

module idle.field;

use idle.sim.{ Sim, BRICK_H, COLS, FIELD_H, FIELD_W, ROWS, brickPos };
use j3.game.{ Color, Font, drawRect, drawText, rgb, setColor };
use j3.math.Vec2;

/// Where the field lands on screen: top-left and field-units-to-pixels.
pub struct View {
    at: Vec2;
    scale: f32;

    /// Fit the field into `size` at `at`, keeping its aspect.
    fn fit(at: Vec2, size: Vec2): View {
        let sx = size.x / FIELD_W;
        let sy = size.y / FIELD_H;
        let s = sx;
        if sy < s {
            s = sy;
        }
        let pad = Vec2 { x: (size.x - FIELD_W * s) / 2, y: (size.y - FIELD_H * s) / 2 };
        return View { at: at + pad, scale: s };
    }

    fn toScreen(this: View, p: Vec2): Vec2 {
        return this.at + p * this.scale;
    }

    fn toField(this: View, p: Vec2): Vec2 {
        return (p - this.at) * (1 / this.scale);
    }
}

/// The field fitted into a canvas of `size`.
pub fn view(size: Vec2): View {
    return View.fit(Vec2 { x: 0, y: 0 }, size);
}

fn rowColor(row: int): Color {
    let colors: [6]Color = [rgb(243, 139, 168), rgb(250, 179, 135), rgb(249, 226, 175), rgb(166, 227, 161), rgb(137, 180, 250), rgb(203, 166, 247)];
    return colors[row % 6];
}

pub fn draw(sim: &Sim, v: View, font: Font) {
    setColor(rgb(24, 24, 37));
    drawRect(v.at, Vec2 { x: FIELD_W, y: FIELD_H } * v.scale);
    let bw = FIELD_W / f32(COLS);
    for cell in 0..ROWS * COLS {
        let hp = sim.bricks[cell];
        if hp == 0 {
            continue;
        }
        setColor(rowColor(cell / COLS));
        let p = v.toScreen(brickPos(cell) + Vec2 { x: 2, y: 2 });
        drawRect(p, Vec2 { x: bw - 4, y: BRICK_H - 4 } * v.scale);
        if sim.showHp && font.raw != 0 {
            setColor(rgb(17, 17, 27));
            drawText(font, p + Vec2 { x: 4, y: 1 }, `{hp}`);
        }
    }
    setColor(rgb(205, 214, 244));
    for i in 0..sim.ballCount {
        let b = sim.balls[i];
        let r = sim.shop[b.kind].radius;
        // ponytail: square balls, drawCircle when j3.game grows one.
        drawRect(v.toScreen(b.pos - Vec2 { x: r, y: r }), Vec2 { x: r * 2, y: r * 2 } * v.scale);
    }
}
