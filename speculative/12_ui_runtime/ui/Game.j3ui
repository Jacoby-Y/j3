<!-- The whole window. The game is a <canvas> in the layout; the sidebar is the
     other half. -->

<script>
    use idle.field;
    use idle.sim.Sim;
    use j3.game.Font;

    props {
        sim: &Sim;
        font: Font;
    }
</script>

<div class="app">
    <!-- Inside on:draw and on:mouse*, `size` is the canvas box and `mouse` is
         canvas-local. The viewport and scissor are already set, so 0,0 is the
         canvas corner. Clicks on the HUD below never reach the canvas. -->
    <canvas class="field"
        on:draw={field.draw(sim, field.view(size), font)}
        on:mousedown={sim.click(field.view(size).toField(mouse))}>

        <!-- Children paint over the game, after on:draw. -->
        <div class="hud">
            <span class="level">Level {sim.level}</span>
            <span>{sim.alive} bricks</span>
        </div>
        {#if sim.paused}
            <div class="paused" transition:fade={150}>
                <h1>Paused</h1>
                <button on:click={sim.paused = false}>Resume</button>
            </div>
        {/if}
    </canvas>

    <div class="half">
        <Sidebar sim={sim} />
    </div>
</div>

<style>
    .app { display: flex; height: 100%; background: var(--bg); }
    /* min-width: 0 so content can't push the halves off 50/50. */
    .field { flex: 1; min-width: 0; position: relative; }
    .half { flex: 1; min-width: 0; }

    .hud {
        position: absolute;
        left: 12px;
        bottom: 12px;
        display: flex;
        gap: 12px;
        padding: 6px 12px;
        background: rgba(17, 17, 27, 0.7);
        border-radius: var(--radius);
        font-size: 13px;
        color: var(--muted);
    }
    .level { color: var(--text); font-weight: bold; }

    .paused {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: rgba(17, 17, 27, 0.6);
    }
</style>
