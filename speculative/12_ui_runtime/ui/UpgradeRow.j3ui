<!-- A label, the current value, and a buy button. Knows nothing about Sim. -->

<script>
    props {
        label: string;
        value: int;
        cost: int;
        gold: int;
    }

    // No closures in J3, so a child reports upward with events: the parent's
    // on:buy={...} body runs where the parent rendered this row.
    events {
        buy;
    }
</script>

<div class="row">
    <span class="label">{label}</span>
    <span class="value">{value}</span>
    <button disabled={gold < cost} on:click={emit buy}>{cost}</button>
</div>

<style>
    .row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        background: var(--raised);
        border-radius: var(--radius);
    }
    .label { flex: 1; }
    .value { color: var(--good); min-width: 48px; text-align: right; }
    button { min-width: 90px; color: var(--gold); }
</style>
