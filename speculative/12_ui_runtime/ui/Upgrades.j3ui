<!-- Click damage plus per-kind damage and speed. Each row is an UpgradeRow that
     emits `buy`; the parent decides what buying means. -->

<script>
    use idle.sim.{ Sim, KINDS };

    props {
        sim: &Sim;
    }

    fn anyOwned(): bool {
        return sim.ballCount > 0;
    }
</script>

<section>
    <h2>Click</h2>
    <UpgradeRow
        label="Click damage"
        value={sim.clickDamage}
        cost={sim.clickCost}
        gold={sim.gold}
        on:buy={sim.upgradeClick()} />
</section>

{#each 0..KINDS as k}
    {#if sim.shop[k].owned > 0}
        <section>
            <h2>{sim.shop[k].name}</h2>
            <UpgradeRow
                label="Damage · lv {sim.shop[k].damageLvl}"
                value={sim.shop[k].damage}
                cost={sim.shop[k].damageCost}
                gold={sim.gold}
                on:buy={sim.upgradeDamage(k)} />
            <UpgradeRow
                label="Speed · lv {sim.shop[k].speedLvl}"
                value={int(sim.shop[k].speed)}
                cost={sim.shop[k].speedCost}
                gold={sim.gold}
                on:buy={sim.upgradeSpeed(k)} />
        </section>
    {/if}
{/each}

{#if !anyOwned()}
    <small>Buy a ball to unlock its upgrades.</small>
{/if}

<style>
    section {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 18px;
    }
</style>
