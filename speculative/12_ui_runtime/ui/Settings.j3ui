<!-- bind: writes straight through the pointer, so these edit Sim in place. -->

<script>
    use idle.sim.Sim;

    props {
        sim: &Sim;
    }
</script>

<div class="list">
    <label>
        <span>Paused</span>
        <input type="checkbox" bind:checked={sim.paused} />
    </label>
    <label>
        <span>Game speed</span>
        <input type="range" min={0.5} max={4} step={0.5} bind:value={sim.timeScale} />
        <span class="val">{sim.timeScale}x</span>
    </label>
    <label>
        <span>Show brick HP</span>
        <input type="checkbox" bind:checked={sim.showHp} />
    </label>
</div>

<style>
    .list { display: flex; flex-direction: column; gap: var(--gap); }
    label {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: var(--raised);
        border-radius: var(--radius);
    }
    label:hover { background: var(--hover); }
    label span:first-child { flex: 1; }
    input[type="range"] { width: 140px; accent-color: var(--accent); }
    .val { min-width: 36px; text-align: right; color: var(--muted); }
</style>
