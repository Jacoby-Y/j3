// Plan 027 chunk 8: `tabindex={ti}` passed through a component. Tab goes b c a d e (positive first, ascending, then tree order,
// -1 skipped), wraps to b; Shift+Tab then goes back to e. Prints `uitabindex ok`.
module uitabindex;
use j3.app.App;
use j3.game.{ clearTo, Color, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.text.same;
use j3.ui.testkit;
use uitabindex.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; seen: [8]u8; n: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, frame: 0, seen: [0, 0, 0, 0, 0, 0, 0, 0], n: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let f = w.frame;
    let d = &w.root.dom;
    w.root.render(windowSize(), ScreenProps { });
    // a key on frame 5, 10, ..., a look on the frame after it
    if f >= 5 && f < 40 && f % 5 == 0 {
        testkit.simKeys(d, f, f, "", if f == 35 { "S+Tab" } else { "Tab" });
    }
    if f >= 6 && f < 40 && f % 5 == 1 && d.focused() >= 0 {
        let t = d.textOf(d.nodes.items[d.focused()].first);
        w.seen[w.n] = t[0];
        w.n += 1;
    }
    if f == 60 {
        let good = w.n == 7 && w.seen[0] == 98 && w.seen[1] == 99 && w.seen[2] == 97 && w.seen[3] == 100 && w.seen[4] == 101 && w.seen[5] == 98 && w.seen[6] == 101;
        printLn(if good { "uitabindex ok" } else { "uitabindex FAIL" });
    }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uitabindex", 360, 200, boot);
    app.useGl(); app.draw(draw); app.run();
}
