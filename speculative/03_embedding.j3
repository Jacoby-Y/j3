// Embedding via `use` (not inheritance).
// Promoting two fields with the same member names is a compile error.
// Methods are not promoted (`transform.length()` is invalid; use `transform.position.length()`).
// Local `use` aliases are places: `width = 2` writes `transform.width`.

module speculative.embedding;

use j3.io.printLn;

struct Vec2 {
    x: f32;
    y: f32;
}

struct Scale2 {
    width: f32;
    height: f32;
}

struct Transform {
    use position: Vec2;
    use scale: Scale2;
}

fn main() {
    let transform = Transform {
        position: Vec2 { x: 10, y: 10 },
        scale: Scale2 { width: 1, height: 1 }
    };

    // can now access `transform.x` or `transform.width`, etc.
    printLn(`x={transform.x}, width={transform.width}`);

    // or, bring members into scope (places, not copies)
    use transform;

    printLn(`x={x}, width={width}`);

    width = 2;
    // is just sugar, due to `use`, for:
    transform.width = 2;
}
