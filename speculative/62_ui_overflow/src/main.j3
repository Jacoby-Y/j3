module overflow_probe;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use overflow_probe.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 25 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 25 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("overflow steady frame changed layout style or allocation"); }
    if w.frame == 40 { printLn("overflow_probe ok: overflow-x, overflow-y, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("overflow probe", 360, 440, boot);
    app.useGl(); app.draw(draw); app.run();
}
