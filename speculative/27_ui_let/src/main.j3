// Plan 023 stage 7a at runtime: `{#let}` in each / if / top level (one using an earlier one) and `{#each xs as &x}`
// changing the source array in place from a handler.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 20 j3c run speculative/27_ui_let --headless --frames 20
module letfx;

use letfx.state.{ State, Item, VRow };
use letfx.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.ui.dom.Dom;
use j3.ui.testkit.{ hasText };

struct World { mem: &Arena; state: State; root: Screen; frame: int; fails: int; laid: int; restyled: int; used: int; }

fn boot(mem: &Arena): World {
    let items = mem.alloc::<Item>(2);
    items[0] = Item { name: "a", n: 1 };
    items[1] = Item { name: "b", n: 2 };
    let vrows = mem.alloc::<VRow>(1000);
    for i in 0..1000 { vrows[i] = VRow { id: i, n: 0 }; }
    return World { mem: mem, laid: 0, restyled: 0, used: 0, state: State { items: items, vrows: vrows }, root: Screen.new(mem), frame: 0, fails: 0 };
}

fn check(w: &World, ok: bool, what: string) {
    if ok { printLn(`PASS {what}`); } else { printLn(`FAIL {what}`); w.fails += 1; }
}

fn button(d: &Dom, k: int): int {
    let seen = 0;
    let t = d.tag("button");
    for i in 0..d.nodes.len {
        if d.nodes.items[i].tag == t {
            if seen == k { return i; }
            seen += 1;
        }
    }
    return -1;
}

fn click(w: &World, f0: int, k: int) {
    let d = &w.root.dom;
    let id = button(d, k);
    let x = d.absX(id) + 3.0;
    let y = d.absY(id) + 3.0;
    if w.frame == f0 { d.simInput(x, y, false, 0.0); }
    else if w.frame == f0 + 1 { d.simInput(x, y, true, 0.0); }
    else if w.frame == f0 + 2 { d.simInput(x, y, false, 0.0); }
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    let d = &w.root.dom;
    let s = &w.state;
    if w.frame == 0 {
        check(w, hasText(d, "slot=0") && hasText(d, "m=100"), "a let in slot content and in a match arm");
        check(w, hasText(d, "total=2 twice=4"), "a let at the top uses an earlier let");
        check(w, hasText(d, "a:10") && hasText(d, "b:21"), "lets in an each see the row and index");
        check(w, hasText(d, "big=1021") && !hasText(d, "big=1010"), "a let inside an if arm");
        check(w, hasText(d, "n=1") && hasText(d, "n=2"), "&x reads the element");
    }
    click(w, 3, 0);
    click(w, 8, 2);
    click(w, 13, 3);
    w.frame += 1;
    if w.frame == 7 {
        check(w, s.counter == 1, "the plain button ran");
    }
    if w.frame == 13 {
        check(w, s.items[1].n == 3 && s.items[0].n == 1, "a handler on &x changes the source element in place");
    }
    if w.frame == 17 {
        check(w, s.vrows[0].n == 1 && s.vrows[1].n == 0, "a handler on &x in a virtual list changes the source element");
        s.mode = 1;
    }
    if w.frame == 22 {
        check(w, hasText(d, "b:31") && hasText(d, "n=3"), "the change shows on the next frame");
        check(w, hasText(d, "slot=2"), "a let used in slot content is recomputed when it changes");
        check(w, hasText(d, "e=201") && !hasText(d, "m=101"), "a let in a {#match} arm follows the arm and the state");
        check(w, hasText(d, "=1"), "the virtual row shows its element");
        w.laid = d.laid; w.restyled = d.restyled; w.used = w.mem.used;
    }
    if w.frame == 60 {
        check(w, d.laid == w.laid && d.restyled == w.restyled && w.mem.used == w.used, `38 idle frames with lets and &x: {d.laid - w.laid} layouts, {d.restyled - w.restyled} restyles, {w.mem.used - w.used} bytes`);
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
}

fn main() {
    let app = App<World>.create("letfx", 640, 480, boot);
    app.useGl(); app.draw(draw); app.run();
}
