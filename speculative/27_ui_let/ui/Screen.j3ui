<script>
    use letfx.state.State;
    props { state: &State; }
</script>
<div>
    {#let total = state.items.len}
    {#let twice = total * 2}
    {#let dbl = state.counter * 2}
    <p>total={total} twice={twice}</p>
    <button on:click={state.counter += 1}>inc</button>
    {#each state.items as it, i}
        {#let label = it.name}
        {#let score = it.n * 10 + i}
        <span>{label}:{score}</span>
        {#if it.n > 1}
            {#let big = score + 1000}
            <span>big={big}</span>
        {/if}
    {/each}
    {#each state.items as &bt (bt.name)}
        <button on:click={bt.n += 1}>{bt.name}</button>
    {/each}
    {#each state.items as &ct}
        <small>n={ct.n}</small>
    {/each}
    <Wrap><span>slot={dbl}</span></Wrap>
    {#match state.mode}
        {:case 0}
            {#let m = state.counter + 100}
            <span>m={m}</span>
        {:else}
            {#let e = state.counter + 200}
            <span>e={e}</span>
    {/match}
    {#let base = 7}
    <div class="vlist" virtual row-height={26}>
        {#each state.vrows as &vr (vr.id + base)}
            <p class="vrow"><button on:click={vr.n += 1}>v{vr.id}</button><span>={vr.n}</span></p>
        {/each}
    </div>
</div>
