<script>
    props { }
    let input = -1;
    let panel = -1;
    let stale = -1;
    let rows: [3]int = [-1, -1, -1];
    let tick = 0;
    let show = true;
    let param = 1;
    let w = 0;
    let h = 0;
    let mounts = 0;
    let updates = 0;
    let destroys = 0;
    let focused = false;
    let rejected = false;
    let distinct = false;
    let good = false;
    let gone = false;
    const NAMES: [4]string = ["a", "bcd", "efghijkl", "m"];
    let spin = 0;
    let lupd = 0;
    let ids: [4]int = [1, 2, 3, 4];
    let cnt = 4;
    let bump = 0;
    let rm = 0;
    let ru = 0;
    let rd = 0;
    fn lab(node: int, s: string) { }
    fn lab_update(node: int, s: string) { lupd += 1; }
    fn rowact(node: int, v: int) { rm += 1; }
    fn rowact_update(node: int, v: int) { ru += 1; }
    fn rowact_destroy(node: int) { rd += 1; }
    fn measure(node: int, v: int) {
        let s = d.size(node);
        w = s.x as int;
        h = s.y as int;
        mounts += 1;
    }
    fn measure_update(node: int, v: int) { updates += 1; }
    fn measure_destroy(node: int) { destroys += 1; }
    fn onMount() {
        d.focusNode(input);
        focused = d.alive(input);
    }
    fn onFrame(dt: f32) {
        if tick < 50 { tick += 1; }
        spin += 1;
        if tick == 12 { let t = ids[0]; ids[0] = ids[2]; ids[2] = t; }
        if tick == 14 { ids[0] = 3; ids[1] = 1; ids[2] = 4; cnt = 3; }
        if tick == 16 { bump = 100; }
        if tick == 10 { param = 2; }
        if tick == 19 { stale = panel; }
        if tick == 20 { show = false; }
        if tick == 25 { gone = panel == -1; }
        if tick == 30 { show = true; }
        if tick == 35 {
            d.focusNode(stale);
            rejected = !d.alive(stale) && d.alive(panel) && stale != panel && d.node(stale) == -1;
            distinct = rows[0] != rows[1] && rows[1] != rows[2] && d.alive(rows[2]);
            good = gone && focused && rejected && distinct && mounts == 2 && updates == 1 && destroys == 1 && rm == 4 && ru == 1 && rd == 1 && lupd > 20 && w > 0 && h > 0;
        }
    }
</script>
<div class="page">
    <input type="text" placeholder="focused by bind:this" bind:this={input} />
    {#if show}
        <div class="panel" bind:this={panel} use:measure={param}>panel</div>
    {/if}
    <div class="row">
        {#each 0..3 as i}
            <span class="chip" bind:this={rows[i]}>r{i}</span>
        {/each}
    </div>
    <div class="row">
        {#each ids[0..cnt] as id (id)}
            <span class="chip" use:rowact={id + (if id == 3 { bump } else { 0 })}>k{id}</span>
        {/each}
    </div>
    <span use:lab={NAMES[spin % 4]}></span>
    <p>m{mounts} u{updates} d{destroys} size {w}x{h} param {param}</p>
    <p>focused {focused} rejected {rejected} rows {distinct} t{tick}</p>
</div>
<style>
    .page { gap: 6px; padding: 8px; }
    .panel { width: 120px; height: 28px; padding: 4px; background: #313244; }
    .chip { padding: 2px 8px; background: #45475a; border-radius: 4px; }
    p { font-size: 13px; }
</style>
