module uilabel;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use uilabel.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("SEL_PTR"), frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // click: press and release on the text of the first two labels
    if same(w.mode, "click") {
        let y: f32 = if w.frame < 12 { 20.0 } else { 46.0 };
        d.simInput(80.0, y, (w.frame >= 5 && w.frame < 8) || (w.frame >= 13 && w.frame < 16), 0.0);
    } else {
        d.simInput(-5.0, -5.0, false, 0.0);
    }
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 20 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 20 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("uilabel steady frame changed layout style or allocation"); }
    if w.frame == 30 { printLn("uilabel ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uilabel", 300, 440, boot);
    app.useGl(); app.draw(draw); app.run();
}
