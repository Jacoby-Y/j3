<script>
    use j3.sys.panic;
    props { toggle: bool; }
    fn hiddenDraw() { panic("hidden canvas callback ran"); }
</script>
<div class="textProbe">
    <div class="pre" class:wrap={toggle}>{"aa  bb\ncc"}</div>
    <div class="pre wrap">{"aa  bb\ncc"}</div>
    <div class="justify">{"aa bb cccccccc"}</div>
    <div class="justifyReference"><span>aa</span><span>bb</span></div>
    <div class="clamp" style:line-clamp={if toggle { 2 } else { 1 }}>{"alpha beta gamma delta epsilon zeta eta theta"}</div>
    <div class="hidden" class:shown={!toggle}>
        <button>must hide</button><canvas on:draw={hiddenDraw()} />
        <div class="visible"></div>
    </div>
    <div class="reference"><div class="visible"></div></div>
</div>
<style>
    .textProbe { position: absolute; left: 0; top: 380px; width: 320px; height: 270px; font-size: 16px; line-height: 20px; color: #ffffff; }
    .pre { width: 120px; height: 40px; white-space: pre; }
    .wrap { white-space: pre-wrap; }
    .justify { width: 100px; height: 40px; text-align: justify; }
    .justifyReference { display: flex; justify-content: space-between; width: 100px; height: 20px; }
    .clamp { width: 100px; line-clamp: 2; user-select: text; }
    .hidden { position: absolute; left: 120px; top: 160px; width: 100px; height: 30px; background: #ff0000; visibility: hidden; }
    .shown { visibility: visible; }
    .hidden button { width: 80px; height: 30px; }
    canvas { width: 10px; height: 10px; visibility: hidden; }
    .visible { position: absolute; left: 20px; top: 5px; width: 40px; height: 20px; background: #00ff00; visibility: visible; }
    .reference { position: absolute; left: 120px; top: 190px; width: 100px; height: 30px; }
</style>
