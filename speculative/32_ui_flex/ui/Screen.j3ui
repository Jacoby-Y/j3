<script>
    use flex_probe.probe;
    props { flip: bool; show: bool; rotate: bool; }
    fn logical(i: int): int { return if rotate { (i + 1) % 3 } else { i }; }
    fn key(i: int): string {
        let v = logical(i);
        return if v == 0 { "a" } else if v == 1 { "b" } else { "c" };
    }
</script>
<div>
    <TextCSS toggle={rotate} />
    <div class="row" class:reversed={flip}>
        <canvas class="item red" style:order={if flip { -3 } else { 2 }} on:draw={probe.mark(1)} />
        {#if show}
            <div class="item" style:order={-1} transition:fade={48}><Piece index={2}><canvas style:margin-right="-80px" on:draw={probe.mark(6)} /></Piece></div>
        {/if}
        {#each 0..3 as i (key(i))}
            <div class="item" style:order={0 - logical(i)}><canvas class="blue" on:draw={probe.mark(3 + logical(i))} /></div>
        {/each}
        <div class="item plain" style:order={-2}><button>plain</button></div>
    </div>
    <div class="paintCheck">
        {#each 0..3 as i}
            <Tile index={i} style:order={2 - i}><span>slot</span></Tile>
        {/each}
    </div>
    <div class="paintCheck">
        {#each 0..3 as i}
            <Tile index={2 - i}><span>slot</span></Tile>
        {/each}
    </div>
    <div class="reverseCheck">
        {#each 0..3 as i}
            <div class="reverseItem" class:red={i == 0} class:green={i == 1} class:blue={i == 2} style:order={2 - i}></div>
        {/each}
    </div>
    <div class="reverseCheck">
        {#each 0..3 as i}
            <div class="reverseItem" class:red={i == 2} class:green={i == 1} class:blue={i == 0}></div>
        {/each}
    </div>
    <div class="columns">
        {#each 0..5 as i}<div class="columnItem" style:order={4 - i}></div>{/each}
    </div>
    <div class="many">
        {#each 0..300 as i}
            <div class="tile" style:order={300 - i}></div>
        {/each}
    </div>
</div>
<style>
    .row { display: flex; width: 200px; height: 100px; }
    .row.reversed { width: 80px; flex-direction: row-reverse; }
    .reversed .item { margin-left: -80px; margin-right: 0; }
    .item { flex-basis: 80px; flex-shrink: 0; margin-right: -80px; height: 80px; }
    canvas { width: 80px; height: 80px; }
    .red { background: #cc0000; }
    .green { background: #00cc00; }
    .blue { background: #0000cc; }
    .plain { background: #eeee00; }
    .paintCheck { display: flex; width: 100px; height: 30px; align-items: center; overflow: hidden; opacity: 0.7; }
    .reverseCheck { display: flex; flex-direction: row-reverse; width: 100px; height: 30px; overflow: hidden; }
    .reverseItem { flex-basis: 40px; flex-shrink: 0; margin-right: -30px; height: 30px; }
    .columns { display: flex; flex-direction: column-reverse; flex-wrap: wrap-reverse; width: 120px; height: 50px; gap: 2px 6px; align-content: space-between; }
    .columnItem { width: 20px; height: 20px; flex-shrink: 0; background: #00cc00; }
    .many { display: flex; flex-wrap: wrap; width: 300px; }
    .tile { flex-basis: 10px; height: 10px; background: #222222; }
</style>
