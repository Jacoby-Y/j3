module flex_probe.probe;
use j3.sys.panic;
#[singleton]
let COUNT: int;
#[singleton]
let SEEN: [6]int;
pub fn reset() { COUNT = 0; }
pub fn mark(id: int) {
    if COUNT >= 6 { panic("duplicate canvas callback"); }
    SEEN[COUNT] = id;
    COUNT += 1;
}
pub fn verify(flip: bool, show: bool) {
    let expected: [6]int = if flip { [1, 5, 6, 2, 4, 3] } else { [5, 6, 2, 4, 3, 1] };
    if !show { expected = [1, 5, 4, 3, 0, 0]; }
    let count = if show { 6 } else { 4 };
    if COUNT != count { panic("missing canvas callback"); }
    for i in 0..count { if SEEN[i] != expected[i] { panic("canvas callbacks out of visual order"); } }
}
