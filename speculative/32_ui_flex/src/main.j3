module flex_probe;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.P_BACKGROUND;
use flex_probe.probe;
use flex_probe.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    let flip = w.frame >= 3;
    d.simInput(if w.frame >= 13 { 95.0 } else { 20.0 }, if w.frame >= 13 { 175.0 } else { 20.0 }, false, 0.0);
    probe.reset();
    w.root.render(windowSize(), ScreenProps { flip: flip, show: w.frame < 6 || w.frame >= 9, rotate: w.frame >= 12 });
    probe.verify(flip, w.frame < 6 || w.frame >= 9);
    if w.frame == 2 || (w.frame >= 4 && w.frame < 13) {
        if d.hover < 0 { panic("ordered overlap missed by hit test"); }
        let color = d.css.get(d.nodes.items[d.hover].style, P_BACKGROUND);
        if color.c != (if flip { 52479 } else { 3422552319 }) { panic("hit order differs from paint order"); }
    }
    if w.frame >= 14 && (d.hover < 0 || d.css.get(d.nodes.items[d.hover].style, P_BACKGROUND).c != 3422552319) { panic("reverse geometry changed order paint/hit priority"); }
    if w.frame == 15 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 15 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("ordered flex steady frame changed layout style or allocation"); }
    if w.frame == 30 { printLn("flex_probe ok: canvas callbacks, conditional reentry/component/nested slot/keyed move order, 300 ordinary ordered children, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("flex probe", 320, 680, boot);
    app.useGl(); app.draw(draw); app.run();
}
