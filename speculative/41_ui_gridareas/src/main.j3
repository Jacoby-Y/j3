module grid_areas;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use grid_areas.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    return World { root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 40 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 40 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("areas steady frame changed layout style or allocation"); }
    if w.frame == 50 { printLn("grid_areas ok: areas, alignment, steady frames"); }
    w.frame += 1;
}
fn main() {
    // GRID_MODE=narrow: a 320 px window (the smallest the window can be), else 420 px
    let narrow = same(env("GRID_MODE"), "narrow");
    let app = App<World>.create("grid areas", if narrow { 320 } else { 420 }, 260, boot);
    app.useGl(); app.draw(draw); app.run();
}
