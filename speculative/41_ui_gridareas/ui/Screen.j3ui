<script>
</script>
<div class="screen">
    <div class="page">
        <div class="head"></div>
        <div class="side"></div>
        <div class="main"></div>
        <div class="foot"></div>
    </div>
    <div class="menu">
        <div class="btn b1"></div>
        <div class="btn b2"></div>
        <div class="btn b3"></div>
    </div>
    <div class="cells">
        <div class="cell"><div class="chip start"></div></div>
        <div class="cell"><div class="chip mid"></div></div>
        <div class="cell"><div class="chip end"></div></div>
        <div class="cell"><div class="chip auto"></div></div>
    </div>
</div>
<style>
    .screen { width: 100%; height: 100%; padding: 8px; background: #181c28; }
    /* header, sidebar, main and footer as named areas; the middle row takes the rest of the height */
    .page { display: grid; height: 90px; gap: 4px; grid-template-columns: 70px 1fr; grid-template-rows: 20px 1fr 18px; grid-template-areas: "head head" "side main" "foot foot"; }
    .head { grid-area: head; background: #6080c0; }
    .side { grid-area: side; background: #c08060; }
    .main { grid-area: main; background: #60c080; }
    .foot { grid-area: foot; background: #909090; }
    /* a menu centered in its box in both directions */
    .menu { display: grid; height: 76px; margin-top: 8px; gap: 6px; grid-template-columns: 120px; justify-content: center; align-content: center; background: #242a3c; }
    .btn { height: 18px; border-radius: 4px; }
    .b1 { background: #4060a0; } .b2 { background: #40a060; } .b3 { background: #a06040; }
    /* one chip per cell: start, centered, end, and auto margins */
    .cells { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 44px; gap: 4px; margin-top: 8px; }
    .cell { display: grid; grid-template-columns: 1fr; grid-template-rows: 1fr; background: #242a3c; }
    .chip { width: 18px; height: 14px; background: #c0a060; }
    .start { justify-self: start; align-self: start; }
    .mid { place-self: center; background: #8060c0; }
    .end { justify-self: end; align-self: end; background: #60c0c0; }
    .auto { margin: auto; background: #c06080; }
</style>
