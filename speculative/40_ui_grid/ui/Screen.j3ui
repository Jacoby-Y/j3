<style>
    .screen { width: 100%; height: 100%; padding: 8px; background: #181c28; }
    /* inventory: as many 48px+ slots as fit, sharing the width; the count changes with the window */
    .inv { display: grid; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr)); grid-auto-rows: 36px; gap: 4px; }
    .slot { border-radius: 4px; }
    .a { background: #4060a0; } .b { background: #40a060; } .c { background: #a06040; } .d { background: #a04080; }
    /* dashboard: header across, a sidebar two rows tall, spans and explicit lines */
    .dash { display: grid; grid-template-columns: 56px 1fr 1fr; grid-template-rows: 20px minmax(28px, auto) 24px 18px; gap: 4px; margin-top: 10px; }
    .head { grid-column: 1 / -1; background: #6080c0; }
    .side { grid-row: 2 / span 2; background: #c08060; }
    .main { grid-column: 2 / span 2; height: 40px; background: #60c080; }
    .tile { background: #c0a060; }
    .t2 { background: #8060c0; }
    .foot { grid-column: 1 / span 3; grid-row: 4; background: #909090; }
</style>
