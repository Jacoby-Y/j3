// Plan 023 stage 1 (chunk 1b) at runtime: a `virtual` list of 100000 fixed-height rows keeps a bounded number of
// nodes alive, shows the right rows after a scroll (the window follows the scroll in the same frame), has a
// true scroll range, costs nothing on idle frames, and survives shrinking under a scrolled-down box.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 120 j3c run speculative/18_ui_virtual --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module virtual;

use virtual.state.{ Item, State };
use virtual.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ micros, windowSize };
use j3.io.printLn;
use j3.math.maxi;
use j3.memory.{ Arena, rewindScratch };
use j3.sys;
use j3.ui.dom.{ Dom, DP_NONE, K_FREE };

const H: f32 = 26.0;
const N: int = 100000;
const BIG: f32 = 100000000.0;

struct World {
    mem: &Arena;
    state: State;
    root: Screen;
    fails: int;
    rows: []Item;
}

fn boot(mem: &Arena): World {
    let w = World { mem: mem, state: State { rows: mem.alloc::<Item>(N) }, root: Screen.new(mem), fails: 0, rows: mem.alloc::<Item>(0) };
    w.rows = w.state.rows;
    for i in 0..N {
        w.state.rows[i] = Item { id: i, name: "x" };
    }
    w.root.dom.setFrameMs(10.0);
    return w;
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn frame(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    rewindScratch();
}

/// The scroll box: the first live `<div>`.
fn box(d: &Dom): int {
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE && d.nodes.items[i].tag == d.tag("div") {
            return i;
        }
    }
    return -1;
}

fn live(d: &Dom): int {
    let n = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE {
            n += 1;
        }
    }
    return n;
}

/// The index shown in row `k` (first span of the k-th `<p>`), -1 if there is none.
fn rowIndex(d: &Dom, k: int): int {
    let c = d.nodes.items[box(d)].first;
    for j in 0..k {
        if c < 0 {
            return -1;
        }
        c = d.nodes.items[c].next;
    }
    if c < 0 {
        return -1;
    }
    let s = d.textOf(d.nodes.items[d.nodes.items[c].first].first);
    let v = 0;
    for i in 0..s.len {
        v = v * 10 + (s[i] - 48) as int;
    }
    return v;
}

/// The id shown in row `k` (second span), -1 if there is none.
fn rowId(d: &Dom, k: int): int {
    let c = d.nodes.items[box(d)].first;
    for j in 0..k {
        if c < 0 {
            return -1;
        }
        c = d.nodes.items[c].next;
    }
    if c < 0 {
        return -1;
    }
    let s = d.textOf(d.nodes.items[d.nodes.items[d.nodes.items[c].first].next].first);
    let v = 0;
    for i in 0..s.len {
        v = v * 10 + (s[i] - 48) as int;
    }
    return v;
}

/// Every live row `k` shows index `i` and the id the list holds at `i` (the view may have moved: scroll anchoring follows a key).
fn idsMatch(w: &World, d: &Dom): bool {
    let ok = rowCount(d) > 0;
    for k in 0..rowCount(d) {
        if rowId(d, k) != w.rows[rowIndex(d, k)].id {
            ok = false;
        }
    }
    return ok;
}

fn reverse10(w: &World) {
    for q in 0..5 {
        let t = w.rows[q];
        w.rows[q] = w.rows[9 - q];
        w.rows[9 - q] = t;
    }
}

fn rowCount(d: &Dom): int {
    let n = 0;
    let c = d.nodes.items[box(d)].first;
    while c >= 0 {
        n += 1;
        c = d.nodes.items[c].next;
    }
    return n;
}

fn run(w: &World) {
    let d = &w.root.dom;
    frame(w);
    frame(w);
    let b = box(d);
    check(w, rowCount(d) > 0 && rowIndex(d, 0) == 0, "first frame shows the top rows");
    check(w, live(d) < 200, `100000 rows: {live(d)} live nodes (< 200)`);
    let box0 = &d.nodes.items[b];
    check(w, box0.scrollMax > f32(N) * H - 201.0 && box0.scrollMax < f32(N) * H - 199.0, `scrollMax is the true range ({box0.scrollMax})`);

    // middle: the first rendered row is the first row of the window (overscan above)
    d.scrollBy(b, 50000.0 * H);
    frame(w);
    let first = rowIndex(d, 0);
    check(w, first <= 50000 && first >= 50000 - 5 && live(d) < 200, `scrolled to the middle in one frame: first row {first}`);
    check(w, d.nodes.items[b].scrollY == 50000.0 * H, "scroll offset kept");
    // the row at the viewport top is row 50000 at y = 0
    let k = 50000 - first;
    check(w, rowIndex(d, k) == 50000, "row 50000 follows the window start");
    let top = d.nodes.items[b].y;
    let c = d.nodes.items[b].first;
    for j in 0..k {
        c = d.nodes.items[c].next;
    }
    check(w, d.nodes.items[c].y - d.nodes.items[b].scrollY < 1.0 && d.nodes.items[c].y - d.nodes.items[b].scrollY > -1.0, "row 50000 is laid out at the viewport top");

    // the end
    d.scrollBy(b, BIG);
    frame(w);
    let n = rowCount(d);
    check(w, rowIndex(d, n - 1) == N - 1, "scrolled to the end shows the last row");
    check(w, d.nodes.items[b].scrollY > f32(N) * H - 201.0, "scrolled to the end");

    // idle
    // which frames restyle after a scroll? (the scroll bar fading out, not the list)
    let trace = "";
    for i in 0..60 {
        let r0 = d.restyled;
        let l0 = d.laid;
        frame(w);
        if d.restyled != r0 || d.laid != l0 {
            trace = `{trace} f{i}:+{d.restyled - r0}r/+{d.laid - l0}l`;
        }
    }
    printLn(`after scrolling to the end:{trace}`);
    let laid = d.laid;
    let rs = d.restyled;
    let used = w.mem.used;
    for i in 0..300 {
        frame(w);
    }
    check(w, d.laid == laid && d.restyled == rs, `300 idle frames: 0 layouts, 0 restyles ({d.laid - laid}, {d.restyled - rs})`);
    check(w, w.mem.used == used, "300 idle frames: 0 arena growth");

    // a page scroll in the middle
    d.scrollBy(b, 0.0 - BIG);
    d.scrollBy(b, 30000.0 * H);
    frame(w);
    let t0 = micros();
    d.scrollBy(b, 200.0);
    frame(w);
    let us = micros() - t0;
    printLn(`scroll by one page: {us} us`);
    check(w, us < 100000 && rowIndex(d, 0) > 29990, "a one-page scroll frame is bounded");
    let l2 = d.laid;
    d.scrollBy(b, 26.0);
    frame(w);
    printLn(`one-row scroll laid {d.laid - l2} boxes`);

    // a real wheel notch: input is applied before the build walk, so the window is not a frame late
    d.scrollBy(b, 0.0 - BIG);
    frame(w);
    let notches: f32 = 100.0;
    d.simInput(100.0, 100.0, false, 0.0 - notches);
    frame(w);
    let y = d.nodes.items[b].scrollY;
    check(w, y > 4000.0 && rowIndex(d, 0) == maxi(0, int(y / H) - 4), `wheel: window follows the same frame (scrollY {y}, first row {rowIndex(d, 0)})`);

    // focus in a row that scrolls out of the window: the focused row is kept alive (hidden, not laid out), so
    // focus and the typed text survive; scrolling back shows it again; blurring lets it go
    d.scrollBy(b, 0.0 - BIG);
    frame(w);
    let ic = d.nodes.items[d.nodes.items[b].first].last;
    d.focusNode(ic);
    frame(w);
    check(w, d.focused() == ic, "an input in a visible row takes focus");
    d.scrollBy(b, 50000.0 * H);
    frame(w);
    frame(w);
    check(w, d.focused() == ic && d.nodes.items[ic].kind != K_FREE, "focus survives: its row is kept outside the window");
    check(w, d.nodes.items[d.nodes.items[ic].parent].disp == DP_NONE && live(d) < 200, `the kept row is display:none ({live(d)} live nodes)`);
    let l3 = d.laid;
    for i in 0..30 {
        frame(w);
    }
    check(w, d.laid == l3, "a kept row off screen costs no layout");
    d.scrollBy(b, 0.0 - BIG);
    frame(w);
    frame(w);
    check(w, d.focused() == ic && d.nodes.items[d.nodes.items[ic].parent].disp != DP_NONE && rowIndex(d, 0) == 0, "scrolling back shows the kept row again");
    d.scrollBy(b, 50000.0 * H);
    frame(w);
    d.focusNode(-1);
    frame(w);
    frame(w);
    check(w, d.nodes.items[ic].kind == K_FREE || rowCount(d) < 40, "blurred: the row leaves with the window");
    d.scrollBy(b, 0.0 - BIG);
    frame(w);

    // 10000 frames jumping across the 100000 rows: the row pool is reused, the arena stays flat
    let seed = 12345;
    let u0 = 0;
    for it in 0..10000 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        d.scrollBy(b, 0.0 - BIG);
        d.scrollBy(b, f32(seed % 99000) * H);
        frame(w);
        if it == 500 {
            u0 = w.mem.used;
        }
    }
    check(w, w.mem.used - u0 < 4096, `10000 jumping frames: arena grew {w.mem.used - u0} bytes after warm-up`);
    check(w, live(d) < 300, `live nodes after the jumps: {live(d)}`);

    // shrink under a scrolled-down box
    d.scrollBy(b, BIG);
    frame(w);
    w.state.rows = w.state.rows[0..10];
    frame(w);
    frame(w);
    check(w, rowCount(d) == 10 && rowIndex(d, 0) == 0 && rowIndex(d, 9) == 9, "list shrunk under a scrolled-down box: top rows, valid window");
    w.state.rows = w.state.rows[0..0];
    frame(w);
    frame(w);
    check(w, rowCount(d) == 0, "empty list: no rows");
    w.state.rows = w.rows;
    frame(w);
    frame(w);
    check(w, rowCount(d) > 0 && rowIndex(d, 0) == 0 && d.nodes.items[b].scrollMax > 2500000.0, "growing from empty: rows and range are back");

    // int keys (`(r.id : int)`): reorder the first ten rows in place, scroll away and back
    d.scrollBy(b, 0.0 - BIG);
    frame(w);
    frame(w);
    check(w, rowId(d, 0) == 0 && rowId(d, 9) == 9 && rowIndex(d, 0) == 0, "int keys: at the top, ids are in order");
    reverse10(w);
    frame(w);
    frame(w);
    frame(w);
    check(w, idsMatch(w, d) && w.rows[0].id == 9, "int keys: after a reorder every live row shows the list's id at its index");
    d.scrollBy(b, 2600.0);
    frame(w);
    frame(w);
    check(w, rowId(d, 8) == rowIndex(d, 8) && rowIndex(d, 8) >= 90, "int keys: scrolled to rows 100+, ids match their positions");
    d.scrollBy(b, 0.0 - BIG);
    frame(w);
    frame(w);
    check(w, idsMatch(w, d) && rowIndex(d, 0) < 10, "int keys: scrolling back shows the reordered ids");
    reverse10(w);
    frame(w);
    frame(w);
    frame(w);
    check(w, idsMatch(w, d) && w.rows[0].id == 0 && w.rows[9].id == 9, "int keys: reordering back restores the order");
}

fn draw(w: &World) {
    run(w);
    if w.fails == 0 {
        printLn("all passed");
    }
    sys.exit(if w.fails == 0 { 0 } else { 1 });
}

fn main() {
    let app = App<World>.create("virtual", 320, 240, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
