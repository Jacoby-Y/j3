// Plan 023/3b visual fixture. tools/golden.sh runs every state offscreen.
module popups;
use popups.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ env, windowSize };
use j3.memory.Arena;
use j3.text.same;

struct World { root: Screen; frame: int; }
fn boot(mem: &Arena): World { return World { root: Screen.new(mem), frame: 0 }; }
fn draw(w: &World) {
    let mode = env("POP_GOLDEN");
    let themed = same(mode, "themed") || same(mode, "color-themed") || same(mode, "coexist");
    let color = same(mode, "color") || same(mode, "color-themed") || same(mode, "coexist");
    let x: f32 = if color { 60.0 } else { 400.0 };
    let y: f32 = 36.0;
    if color && w.frame >= 7 { x = if same(mode, "coexist") { 400.0 } else { 600.0 }; y = if same(mode, "coexist") { 36.0 } else { 440.0 }; }
    w.root.dom.simInput(x, y, color && w.frame == 4, 0.0);
    w.root.render(windowSize(), ScreenProps { themed: themed, long: !same(mode, "tooltip") });
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("popups", 640, 480, boot);
    app.useGl(); app.draw(draw); app.run();
}
