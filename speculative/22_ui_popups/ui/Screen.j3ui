<script>
    props { themed: bool; long: bool; }
</script>
<div class="app" class:themed={themed}>
    <input class="picker" type="color" value="#89b4fa" />
    <button class="tip" title={if long { "A long tooltip wraps ordinary words and preserves explicit\nnewlines. SupercalifragilisticexpialidociousSupercalifragilisticexpialidocious also breaks to fit the box." } else { "Open it" }}>Hover for title</button>
    <p>Real DOM popup boxes and children</p>
</div>
<style>
    .app { width: 640px; height: 480px; background: #11111b; position: relative; }
    .picker { position: absolute; left: 20px; top: 20px; width: 100px; height: 32px; }
    .tip { position: absolute; left: 360px; top: 20px; width: 160px; height: 32px; background: #313244; border-radius: 5px; }
    p { position: absolute; left: 20px; top: 360px; }
    .themed .j3-tooltip { width: 180px; padding: 12px 16px; border: 2px solid #cba6f7; border-radius: 12px; background: #302341; color: #f5e0dc; box-shadow: 0 8px 20px rgba(203,166,247,0.5); }
    .themed .j3-color-panel { width: 260px; padding: 18px; border: 2px solid #a6e3a1; border-radius: 14px; background: #18362d; box-shadow: 0 8px 20px rgba(166,227,161,0.4); }
    .themed .j3-color-sv { height: 150px; }
    .themed .j3-color-hue { height: 20px; margin-top: 12px; }
    .themed .j3-color-handle { top: 2px; }
    .themed .j3-color-value { color: #a6e3a1; }
</style>
