module uiinspect;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.ui.inspect;
use uiinspect.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    root.dom.setInspector(true);
    return World { root: root, frame: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    // the pointer rests on card b; card a is pinned
    w.root.dom.simInput(230.0, 70.0, false, 0.0);
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 3 { w.root.dom.inspPin = inspect.find(&w.root.dom, "#a"); }
    if w.frame == 100 { printLn("uiinspect ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uiinspect", 700, 500, boot);
    app.useGl(); app.draw(draw); app.run();
}
