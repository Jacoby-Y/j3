<script>
    props { later: bool; rows: []int; }
    fn name(i: int): string { return if i == 0 { "A" } else if i == 1 { "B" } else if i == 2 { "C" } else { "D" }; }
</script>
<div class="screen">
    <div class="list">
        {#each 0..(if later { 4 } else { 3 }) as i (name(i))}
            <div class="row" class:on={later && i == 1}>{name(i)}</div>
        {/each}
    </div>
    <div class="card" class:alt={later}><div class="body">card body</div></div>
    <div class="vl" virtual row-height={20}>
        {#each rows as r (r : int)}
            <div class="vrow">{r}</div>
        {/each}
    </div>
    <div id="hero" class="row">hero</div>
</div>
<style>
    .screen { width: 320px; padding: 10px; color: #ffffff; font-size: 16px; }
    .list { width: 200px; background: #202040; }
    .row { height: 28px; padding-left: 8px; background: #3050a0; }
    .row + .row { border-top: 3px solid #ffd040; }
    .row.on { background: #20a050; }
    .row.on ~ .row { background: #a03030; }
    .card { position: relative; margin-top: 20px; width: 200px; height: 80px; background: #404040; }
    .card::before { content: "TITLE"; display: block; height: 22px; padding-left: 6px; background: #606080; }
    .card::after { content: "*"; position: absolute; right: 0; top: 0; width: 18px; height: 18px; background: #ff8000; }
    .card.alt::before { content: "CHANGED"; background: #806060; }
    .body { padding-left: 6px; }
    #hero { margin-top: 20px; width: 150px; background: #808000; }
    .vl { position: absolute; left: 220px; top: 10px; width: 90px; height: 100px; overflow-y: auto; background: #303030; }
    .vrow { height: 20px; }
    .vrow + .vrow { background: #383838; }
    .vl::before { content: "top"; display: block; height: 20px; background: #206060; }
    .vl::after { content: "end"; display: block; height: 20px; background: #206060; }
</style>
