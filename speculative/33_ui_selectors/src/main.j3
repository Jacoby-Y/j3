module selectors_probe;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use selectors_probe.ui.{ Screen, ScreenProps };
struct World { fwd: []int; rev: []int; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    let fwd = mem.alloc::<int>(200);
    let rev = mem.alloc::<int>(200);
    for i in 0..200 { fwd[i] = i; rev[i] = 199 - i; }
    return World { fwd: fwd, rev: rev, root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    w.root.render(windowSize(), ScreenProps { later: w.frame >= 10, rows: if w.frame >= 10 { w.rev } else { w.fwd } });
    for i in 0..d.nodes.len {
        let n = &d.nodes.items[i];
        if n.kind == 0 && n.pe == 1 && d.nodes.items[n.parent].first != i { panic("::before is not the first child"); }
        if n.kind == 0 && n.pe == 2 && d.nodes.items[n.parent].last != i { panic("::after is not the last child"); }
    }
    if w.frame == 25 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 25 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("selector steady frame changed layout style or allocation"); }
    if w.frame == 40 { printLn("selectors_probe ok: sibling combinators, pseudo-element boxes, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("selectors probe", 320, 360, boot);
    app.useGl(); app.draw(draw); app.run();
}
