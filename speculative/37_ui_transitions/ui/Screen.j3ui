<script>
    props { on: bool; }
</script>
<div class="screen">
    <div class="title">Transitions</div>
    <div class="grid">
        {#if on}<div class="box b0" transition:fade={200} transition-easing="linear">fade</div>{/if}
        {#if on}<div class="box b1" transition:fly={200} fly-x={60} fly-y={0} transition-easing="linear">fly</div>{/if}
        {#if on}<div class="box b2" transition:slide={200} transition-easing="linear">slide</div>{/if}
        {#if on}<div class="box b3" transition:scale={200} scale-from={0.2} transition-easing="linear">scale</div>{/if}
        {#if on}<div class="box b4" in:fly={200} out:fade={200} fly-x={0} fly-y={-30} transition-easing="linear">in fly out fade</div>{/if}
    </div>
</div>
<style>
    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }
    .title { margin-bottom: 8px; color: #a0b0d0; }
    .grid { display: flex; flex-wrap: wrap; gap: 8px; height: 150px; }
    .box { width: 90px; height: 60px; padding: 8px; box-sizing: border-box; border-radius: 4px; background: #3050a0; }
    .b1 { background: #a05030; }
    .b2 { background: #308050; }
    .b3 { background: #806030; }
