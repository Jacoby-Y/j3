// Plan 023 stage 3 at runtime: onMount / onFrame(dt) / onDestroy through an {#if} toggle (a component
// holding a component) and an {#each} that shrinks and grows again.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 20 j3c run speculative/15_ui_lifecycle --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module life;

use life.state.State;
use life.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.testkit.tagNode;

struct World {
    state: State;
    root: Screen;
    frame: int;
    fails: int;
}

fn boot(mem: &Arena): World {
    let w = World { state: State {}, root: Screen.new(mem), frame: 0, fails: 0 };
    w.root.dom.setFrameMs(10.0);
    return w;
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn draw(w: &World) {
    let s = &w.state;
    if w.frame == 0 {
        s.txt = "hi";
    }
    if w.frame == 1 {
        s.n = 1;
    } else if w.frame == 2 {
        s.show = false;
    } else if w.frame == 3 {
        s.show = true;
    } else if w.frame == 4 {
        s.n = 3;
    } else if w.frame == 5 {
        s.pg = 0;
    } else if w.frame == 6 {
        s.pg = 1;
    } else if w.frame == 7 {
        s.pg = 2;
    } else if w.frame == 8 {
        s.pg = 9;
    }
    let fr = s.frames;
    w.root.render(windowSize(), ScreenProps { state: s });
    if w.frame == 0 {
        check(w, s.mounts == 5 && s.destroys == 0, "first frame mounts the Holder, its Probe and 3 listed Probes");
        check(w, s.frames == 4, "onFrame runs once per live component that has one");
    } else if w.frame == 1 {
        check(w, s.mounts == 5 && s.destroys == 2, "an {#each} that shrinks destroys the dropped items");
        near(w, s.lastDt, 0.01, "dt is the fixed step in seconds");
    } else if w.frame == 2 {
        check(w, s.destroys == 4 && s.frames - fr == 1, "leaving an {#if} destroys the component and its child; no onFrame while hidden");
    } else if w.frame == 3 {
        check(w, s.mounts == 7 && s.destroys == 4, "re-entering the branch mounts again");
        check(w, s.fresh == 5, "a re-entered component starts with fresh state");
        let inp = tagNode(&w.root.dom, "input", 0);
        check(w, inp >= 0 && same(w.root.dom.strValue(inp), "hi") && same(s.txt, "hi"), "a re-entered child shows its bind: value and leaves the parent's alone");
    } else if w.frame == 4 {
        check(w, s.mounts == 9 && s.destroys == 4, "growing the list mounts the new items");
    } else if w.frame == 5 {
        check(w, s.mounts == 11 && s.destroys == 4, "a {#match} case mounts its component (and its child)");
    } else if w.frame == 6 {
        check(w, s.mounts == 12 && s.destroys == 6, "switching case destroys the old one, mounts the new");
    } else if w.frame == 7 {
        check(w, s.mounts == 12 && s.destroys == 6, "two values of one case keep its state");
    } else if w.frame == 8 {
        check(w, s.mounts == 12 && s.destroys == 7, "{:else} destroys the case it replaces");
    } else if w.frame == 10 {
        check(w, s.mounts == 12 && s.destroys == 7, "idle frames mount and destroy nothing");
        s.show = true;
        s.pg = 0;
        for i in 0..300 {
            s.show = i % 2 == 0;
            s.pg = i % 3;
            w.root.render(windowSize(), ScreenProps { state: s });
        }
        let used = w.root.mem.used;
        let cap = w.root.mem.cap;
        for i in 0..1000 {
            s.show = i % 2 == 0;
            s.pg = i % 3;
            w.root.render(windowSize(), ScreenProps { state: s });
        }
        printLn(`arena after 300 warm-up cycles: grew {w.root.mem.used - used} bytes over 1000 cycles (cap {cap} -> {w.root.mem.cap})`);
        check(w, w.root.mem.used == used && w.root.mem.cap == cap, "1000 {#if}/{#match} cycles: 0 arena growth");
        if w.fails == 0 {
            printLn("all passed");
        }
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
    w.frame += 1;
}

fn near(w: &World, a: f32, b: f32, what: string) {
    check(w, a > b - 0.0005 && a < b + 0.0005, what);
}

fn main() {
    let app = App<World>.create("life", 320, 240, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
