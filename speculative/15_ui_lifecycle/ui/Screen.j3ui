<script>
    use life.state.State;
    props { state: &State; }
    const LABELS: [3]string = ["a", "b", "c"];
    const TWO = 2;
</script>
<div>
    {#if state.show}
        <Holder state={state} />
    {/if}
    {#each 0..state.n as i}
        <Probe state={state} />
    {/each}
    {#match state.pg}
        {:case 0}
            <Holder state={state} />
        {:case 1, TWO}
            <Probe state={state} />
        {:else}
            <span>{LABELS[1]}</span>
    {/match}
</div>
