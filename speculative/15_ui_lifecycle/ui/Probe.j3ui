<script>
    use life.state.State;
    props { state: &State; }
    let seen = 0;
    fn onMount() { state.mounts += 1; }
    fn onFrame(dt: f32) { state.frames += 1; seen += 1; if seen == 1 { state.fresh += 1; } state.lastDt = dt; }
    fn onDestroy() { state.destroys += 1; }
</script>
<span>probe</span><input type="text" bind:value={state.txt} />
