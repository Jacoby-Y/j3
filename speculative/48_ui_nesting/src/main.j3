module uinesting;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use uinesting.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("NEST_PTR"), frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // hover: over the first card's title; active: pressing its button
    if same(w.mode, "hover") {
        d.simInput(100.0, 30.0, false, 0.0);
    } else if same(w.mode, "active") {
        d.simInput(50.0, 65.0, w.frame >= 5, 0.0);
    } else {
        d.simInput(-5.0, -5.0, false, 0.0);
    }
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 10 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 10 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("uinesting steady frame changed layout style or allocation"); }
    if w.frame == 20 { printLn("uinesting ok"); }
    w.frame += 1;
}
fn main() {
    let w = 480;
    if same(env("NEST_NARROW"), "1") { w = 320; }
    let app = App<World>.create("uinesting", w, 260, boot);
    app.useGl(); app.draw(draw); app.run();
}
