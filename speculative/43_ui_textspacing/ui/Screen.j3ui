<div class="screen">
    <h1 class="title">Spaced Title</h1>
    <div class="bar">
        <button class="btn">save</button>
        <button class="btn">cancel</button>
        <button class="btn ls">open file</button>
    </div>
    <p class="para">The first line of this paragraph starts indented while the lines after it begin at the edge, and the text keeps wrapping.</p>
    <p class="just">word spacing widens each gap, then justify stretches the line to the edge of the box</p>
    <p class="cap">capitalize turns the first letter of each word up, even in don't and day-off</p>
    <p class="tween">tween spacing</p>
    <p class="clip">letter spacing narrows how many letters fit before the ellipsis</p>
</div>
<style>
    .screen { width: 520px; padding: 10px; color: #ffffff; font-size: 14px; }
    .title { font-size: 26px; letter-spacing: 6px; color: #80c0ff; margin-bottom: 6px; }
    .bar { display: flex; gap: 8px; margin-bottom: 8px; }
    .btn { text-transform: uppercase; letter-spacing: 1px; padding: 4px 8px; background: #303050; color: #ffffff; border: 0; font-size: 12px; }
    .btn.ls { letter-spacing: -0.5px; word-spacing: 3px; }
    .para { text-indent: 2em; margin-bottom: 6px; }
    .just { width: 300px; word-spacing: 4px; text-align: justify; background: #202030; margin-bottom: 6px; }
    .cap { text-transform: capitalize; margin-bottom: 6px; }
    @keyframes grow { from { letter-spacing: 0px; word-spacing: 0px; } to { letter-spacing: 12px; word-spacing: 24px; } }
    .tween { white-space: nowrap; color: #ffd080; margin-bottom: 6px; animation: grow 160ms linear forwards; }
    .clip { width: 200px; letter-spacing: 3px; white-space: nowrap; overflow-y: hidden; text-overflow: ellipsis; background: #202030; }
</style>
