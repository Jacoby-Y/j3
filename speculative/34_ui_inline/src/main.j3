module inline_probe;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use inline_probe.ui.{ Screen, ScreenProps };
struct World { sel: bool; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { sel: same(env("INLINE_SEL"), "1"), root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // INLINE_SEL=1: double-click "Mira" (inside a pill) in the first paragraph (golden `sel`)
    let down = w.sel && (w.frame == 7 || w.frame == 9);
    if w.sel && w.frame >= 6 { d.simInput(28.0, 22.0, down, 0.0); } else { d.simInput(-5.0, -5.0, false, 0.0); }
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 25 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 25 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("inline steady frame changed layout style or allocation"); }
    if w.frame == 40 { printLn("inline_probe ok: inline boxes, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("inline probe", 320, 300, boot);
    app.useGl(); app.draw(draw); app.run();
}
