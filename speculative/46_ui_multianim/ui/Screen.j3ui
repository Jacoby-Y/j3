<script>
    props { finished: bool; }
</script>
<div class="screen" class:finished={finished}>
    <div class="box a">spin + pulse</div>
    <div class="track"><div class="bar">slide</div></div>
    <div class="cyc b">name list</div>
    <div class="cyc c">cycles</div>
    <div class="box d">two accents</div>
    <div class="pct">translate %</div>
</div>
<style>
    .screen { position: relative; width: 380px; height: 280px; background: #f2f2f6; color: #ffffff; font-size: 13px; --accent: #d03080; }
    .box { position: absolute; left: 20px; top: 20px; width: 110px; height: 50px; padding: 6px; background: #2060d0; animation: spin 2s linear infinite, pulse 600ms ease-in-out infinite alternate; }
    .d { left: 150px; --accent: #20b080; animation: pulse 600ms linear 2 alternate forwards; }
    .track { position: absolute; left: 20px; top: 110px; width: 340px; height: 30px; background: #d8d8e0; }
    .bar { position: absolute; top: 0; left: 0; width: 20%; height: 30px; padding: 6px; background: #8060c0; animation: slide 1s linear infinite alternate; }
    .cyc { position: absolute; top: 170px; width: 80px; padding: 6px; background: #f0a030; animation-name: fade, grow, fade; animation-duration: 400ms, 800ms; animation-timing-function: linear; animation-iteration-count: infinite; animation-direction: alternate; }
    .b { left: 20px; }
    .c { left: 190px; }
    .pct { position: absolute; left: 20px; top: 230px; width: 120px; padding: 6px; background: #20a0c0; animation: shove 800ms linear infinite alternate; }
    .finished .box, .finished .bar, .finished .cyc, .finished .pct { animation-iteration-count: 1; animation-fill-mode: forwards; animation-direction: normal; animation-duration: 80ms, 80ms; }
    .finished .d { animation-iteration-count: 1; }
    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse { to { background: var(--accent); } }
    @keyframes slide { from { left: 0px; width: 20%; } to { left: 80%; width: 40%; } }
    @keyframes fade { to { opacity: 0.35; } }
    @keyframes grow { to { width: 130px; } }
    @keyframes shove { from { translate: 0px 0px; } to { translate: 100% 0px; } }
</style>
