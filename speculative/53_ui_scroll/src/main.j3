module uiscroll;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.testkit;
use uiscroll.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("SCROLL_MODE"), frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // wheel: five notches over the carousel in frames 5-9; it snaps to a card once the wheel rests
    if same(w.mode, "wheel") && w.frame >= 5 && w.frame < 10 {
        d.simInput(100.0, 80.0, false, -1.0);
    } else {
        d.simInput(-5.0, -5.0, false, 0.0);
    }
    // into: a click on the button runs `d.scrollIntoView(d.byId("last"), ..)` from the component's handler
    if same(w.mode, "into") && w.frame >= 5 && w.frame < 9 {
        testkit.clickText(d, w.frame, 5, "To last");
    }
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 90 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 90 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("uiscroll steady frame changed layout style or allocation"); }
    if w.frame == 100 { printLn("uiscroll ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uiscroll", 300, 440, boot);
    app.useGl(); app.draw(draw); app.run();
}
