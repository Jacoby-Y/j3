<script>
    use j3.ui.dom.SC_CENTER;
    props { }
</script>
<div class="screen page">
    <p class="title">Carousel</p>
    <div id="carousel" class="carousel">
        {#each 0..6 as c}
            <div class="card c{c + 1}">Card {c + 1}</div>
        {/each}
    </div>
    <p class="title">List</p>
    <div id="list" class="list">
        {#each 0..20 as it}
            <div class="item">Item {it + 1}</div>
        {/each}
        <div id="last" class="item">Last item (static id)</div>
    </div>
    <button class="jump" on:click={d.scrollIntoView(d.byId("last"), SC_CENTER, true)}>To last</button>
</div>
<style>
    .screen { width: 100%; height: 100%; padding: 10px; }
    .title { margin: 6px 0; font-size: 14px; }
    .carousel { display: flex; gap: 10px; width: 240px; height: 90px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding: 0 12px; border: 1px solid #909098; background: #e4e4ee; }
    .card { flex-shrink: 0; width: 200px; height: 80px; margin: 4px 0; scroll-snap-align: start; scroll-margin: 0; border-radius: 6px; color: #fff; font-size: 16px; padding: 28px 10px; }
    .c1 { background: #d04060; } .c2 { background: #d08030; } .c3 { background: #40a060; } .c4 { background: #3070c0; } .c5 { background: #8050c0; } .c6 { background: #606070; }
    .list { width: 240px; height: 140px; overflow-y: auto; border: 1px solid #909098; background: #fff; }
    .jump { margin-top: 8px; padding: 4px 10px; }
    .item { height: 28px; padding: 6px 8px; border-bottom: 1px solid #e0e0e8; }
</style>
