<script>
    use grid.state.State;
    use j3.ui.gridstate.Grid;
    props { state: &State; g: &Grid; }
</script>
<div class="sheet">
    <div class="head">
        <div class="hrow" style:margin-left={0.0 - g.sx} style:width={g.total} style:padding-left={g.fw()}>
            {#each 0..g.cols as j}
                <div class="hc" class:frozen={g.fz(j)} style:left={g.hx(j)} style:width={g.w(j)}>C{j}<div class="grip" on:mousedown={g.grab(j)}></div></div>
            {/each}
        </div>
    </div>
    <div class="body" tabindex="0" virtual row-height={24} grid={g.sized(state.rows.len)} on:edit={
        if kind == 0 {
            g.draft = g.initial(state.get(row, col));
        } else if kind == 1 {
            state.set(row, col, text);
        } else if kind == 2 {
            for i in 0..g.pasteRows {
                for j in 0..g.pasteCols {
                    state.set(row + i, col + j, g.pasteCell(i, j));
                }
            }
        }
    }>
        {#each state.rows as r, i (r.id)}
            <div class="row" style:width={g.total} style:padding-left={g.fw()}>
                {#each 0..g.cols as j}
                    <div class="cell" class:active={g.on(i, j)} class:sel={g.inRange(i, j)} class:frozen={g.fz(j)} style:left={g.bx(j)} style:width={g.w(j)}>
                        {#if g.editAt(i, j)}
                            <input type="text" bind:value={g.draft} />
                        {:else}
                            {state.get(r.id, j)}
                        {/if}
                    </div>
                {/each}
            </div>
        {/each}
    </div>
</div>
