// Plan 023 stage 6 (chunk 6a) at runtime: a 100000 x 50 data grid over a `virtual` list. Keyboard cell navigation
// (arrows, Ctrl+arrows to the edge, Tab wrap, Home/End, PageUp/PageDown), the in-place editor (Enter, F2 or a typed
// character starts it; Enter commits and moves down, Tab commits and moves right, Escape cancels), scroll-into-view on
// both axes, and the steady cost (0 layouts, 0 restyles, flat arena on idle frames).
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 120 j3c run speculative/26_ui_grid --headless
// Prints PASS/FAIL lines and exits 1 on a failure; J3_CAPTURE=out.png:N saves a frame (tools/golden.sh).

module grid;

use grid.state.{ Cell, Item, State };
use grid.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ env, windowSize };
use j3.io.printLn;
use j3.memory.{ Arena, rewindScratch };
use j3.sys;
use j3.text.{ same, Text };
use j3.ui.dom.{ Dom, K_FREE };
use j3.ui.gridstate.Grid;

const N: int = 100000;
const COLS: int = 50;

#[singleton] let SHEET: &State;

/// The text of a cell for copy (a module function: the grid holds no app state).
fn cellText(row: int, col: int): string {
    return SHEET.get(row, col);
}

struct World {
    mem: &Arena;
    state: State;
    g: Grid;
    root: Screen;
    fails: int;
    frames: int;
}

fn boot(mem: &Arena): World {
    let rows = mem.alloc::<Item>(N);
    for i in 0..N {
        rows[i] = Item { id: i };
    }
    let w = World { mem: mem, state: State { mem: mem, rows: rows, cells: mem.alloc::<Cell>(64), n: 0, tmp: Text.new(mem) }, g: Grid.new(mem, COLS, 24.0, 80.0), root: Screen.new(mem), fails: 0, frames: 0 };
    w.root.dom.setFrameMs(10.0);
    w.g.freeze(1);
    return w;
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn frame(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state, g: &w.g });
    rewindScratch();
    w.frames += 1;
}

/// One key press (names as `keys.parse`, text typed) and two frames to settle.
fn press(w: &World, typed: string, names: string) {
    w.root.dom.simKeys(typed, names);
    frame(w);
    frame(w);
}

/// Paste `tsv` as the clipboard would deliver it (the stub clipboard is empty headless).
fn paste(w: &World, tsv: string) {
    w.g.queuePaste(tsv);
    frame(w);
    frame(w);
}

fn live(d: &Dom): int {
    let n = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE {
            n += 1;
        }
    }
    return n;
}

fn at(w: &World, r: int, c: int): bool {
    return w.g.row == r && w.g.col == c;
}

/// The editor box (the one `<input>`), or -1.
fn editor(d: &Dom): int {
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE && d.nodes.items[i].tag == d.tInput {
            return i;
        }
    }
    return -1;
}

/// The box's first row's cell `j`, and the header's cell `j` (`Screen`: sheet > head > hrow > hc, sheet > body > row > cell).
fn nth(d: &Dom, n: int, j: int): int {
    let c = d.nodes.items[n].first;
    for i in 0..j {
        c = d.nodes.items[c].next;
    }
    return c;
}

fn headRow(d: &Dom, b: int): int {
    let sheet = d.nodes.items[b].parent;
    return d.nodes.items[d.nodes.items[sheet].first].first;
}

/// Press at (x, y), move to x2, release, with a frame between.
fn dragTo(w: &World, x: f32, y: f32, x2: f32) {
    let d = &w.root.dom;
    d.simInput(x, y, false, 0.0);
    frame(w);
    d.simInput(x, y, true, 0.0);
    frame(w);
    d.simInput(x2, y, true, 0.0);
    frame(w);
    frame(w);
    d.simInput(x2, y, false, 0.0);
    frame(w);
    frame(w);
}

/// Stage 6c: the frozen first column and header cell stay put while the rest scroll under them; a header-edge drag
/// resizes a column for the header and the rows in the same frame, to a minimum width.
fn frozenAndResize(w: &World, b: int) {
    let d = &w.root.dom;
    let g = &w.g;
    press(w, "", "C+Home");
    d.scrollByX(b, 0.0 - d.nodes.items[b].scrollX);
    frame(w);
    let hr = headRow(d, b);
    let bx = d.absX(b);
    let hx = d.absX(d.nodes.items[hr].parent);
    check(w, d.absX(nth(d, nth(d, b, 0), 0)) == bx && d.absX(nth(d, hr, 0)) == hx, "at the left edge the frozen column and header cell sit at the box edge");
    press(w, "", "C+Right");
    let sx = d.nodes.items[b].scrollX;
    check(w, sx > 3000.0 && g.sx == sx, `scrolled right to {sx}`);
    check(w, d.absX(nth(d, nth(d, b, 0), 0)) == bx && d.absX(nth(d, hr, 0)) == hx, "scrolled: the frozen cell and the frozen header cell have not moved");
    check(w, d.absX(nth(d, hr, 49)) == hx - sx + g.colX(49), "scrolled: the header follows the scroll in the same frame (no lag)");
    check(w, d.absX(nth(d, nth(d, b, 0), 49)) == bx - sx + g.colX(49), "scrolled: a body cell scrolls under (and past) the frozen one");
    // one more scroll step: cost is the visible rows, not the sheet
    let l0 = d.laid;
    let r0 = d.restyled;
    d.scrollByX(b, -80.0);
    frame(w);
    check(w, d.nodes.items[b].scrollX == sx - 80.0 && d.absX(nth(d, nth(d, b, 0), 0)) == bx && d.absX(nth(d, hr, 0)) == hx, "a 80 px scroll step moves the frozen cells with it, same frame");
    printLn(`one scroll step laid {d.laid - l0} boxes, restyled {d.restyled - r0} of {live(d)}`);
    check(w, d.laid - l0 < 400 && d.restyled - r0 < 400, "horizontal scroll costs the visible rows, not 100000");
    press(w, "", "C+Home");
    d.scrollByX(b, 0.0 - d.nodes.items[b].scrollX);
    frame(w);
    // resize column 2 by its header edge
    d.focusNode(b);
    frame(w);
    let hc = nth(d, hr, 2);
    let grip = d.nodes.items[hc].last;
    let gx = d.absX(grip) + d.nodes.items[grip].w / 2.0;
    let gy = d.absY(grip) + 6.0;
    let w2 = g.w(2);
    let t0 = g.total;
    let row0 = g.row;
    let col0 = g.col;
    dragTo(w, gx, gy, gx + 30.0);
    check(w, g.w(2) == w2 + 30.0 && g.total == t0 + 30.0, `dragging the edge widens the column ({g.w(2)}, total {g.total})`);
    check(w, d.nodes.items[hc].w == w2 + 30.0 && d.nodes.items[nth(d, nth(d, b, 0), 2)].w == w2 + 30.0, "header and body cells have the new width");
    check(w, g.colAt(g.colX(3) + 1.0) == 3 && g.colAt(g.colX(3) - 1.0) == 2 && g.colX(3) == g.w(0) + g.w(1) + w2 + 30.0, "colAt/colX follow the new widths");
    check(w, g.row == row0 && g.col == col0 && !g.hasRange() && !g.drag, "a resize does not touch the selection");
    check(w, d.focused() == b, "a resize leaves focus on the grid");
    gx = gx + 30.0;
    dragTo(w, gx, gy, gx - 500.0);
    check(w, g.w(2) == 24.0, `the width stops at the minimum ({g.w(2)})`);
    // the resize event: kind 3 with the column, once, on release
    let laid = d.laid;
    let rs = d.restyled;
    let used = w.mem.used;
    for i in 0..100 {
        frame(w);
    }
    check(w, d.laid == laid && d.restyled == rs && w.mem.used == used, `100 idle frames after a resize: {d.laid - laid} layouts, {d.restyled - rs} restyles, {w.mem.used - used} bytes`);
    g.setWidth(2, 130.0);
    frame(w);
    frame(w);
}

fn run(w: &World) {
    let d = &w.root.dom;
    let g = &w.g;
    SHEET = &w.state;
    g.cells(cellText);
    frame(w);
    frame(w);
    let b = d.grids.items[0].node;
    check(w, b >= 0 && g.rows == N, `the grid box is bound with {g.rows} rows`);
    check(w, live(d) < 3000, `100000 x 50 cells: {live(d)} live nodes`);
    d.focusNode(b);
    frame(w);

    // navigation
    press(w, "", "Down");
    press(w, "", "Down");
    press(w, "", "Right");
    check(w, at(w, 2, 1), "arrows move the active cell");
    press(w, "", "Up");
    press(w, "", "Left");
    check(w, at(w, 1, 0), "Up and Left");
    press(w, "", "Left");
    check(w, at(w, 1, 0), "Left stops at the first column");
    press(w, "", "C+Down");
    check(w, at(w, N - 1, 0), "Ctrl+Down runs to the last row");
    check(w, d.nodes.items[b].scrollY > f32(N) * 24.0 - 200.0, `the box scrolled to the end ({d.nodes.items[b].scrollY})`);
    check(w, live(d) < 3000, `still bounded at the end ({live(d)} live nodes)`);
    press(w, "", "C+Up");
    check(w, at(w, 0, 0) && d.nodes.items[b].scrollY == 0.0, "Ctrl+Up runs back to the top");
    press(w, "", "C+Right");
    check(w, at(w, 0, COLS - 1) && d.nodes.items[b].scrollX > 3000.0, `Ctrl+Right to the last column scrolls sideways ({d.nodes.items[b].scrollX})`);
    press(w, "", "Tab");
    check(w, at(w, 1, 0) && d.nodes.items[b].scrollX > 3000.0, "Tab at the last column wraps to the next row's first (frozen, always visible) column: the scroll stays");
    press(w, "", "S+Tab");
    check(w, at(w, 0, COLS - 1), "Shift+Tab wraps back");
    press(w, "", "Home");
    check(w, at(w, 0, 0), "Home");
    press(w, "", "End");
    check(w, at(w, 0, COLS - 1), "End");
    press(w, "", "Home");
    press(w, "", "PageDown");
    let page = g.row;
    check(w, page >= 6 && page <= 9, `PageDown moves a screenful ({page} rows)`);
    press(w, "", "PageDown");
    press(w, "", "PageUp");
    check(w, g.row == page, "PageUp undoes a PageDown");
    press(w, "", "C+Home");
    check(w, at(w, 0, 0), "Ctrl+Home");
    press(w, "", "C+End");
    check(w, at(w, N - 1, COLS - 1), "Ctrl+End");
    press(w, "", "C+Home");

    // editing
    press(w, "", "Down");
    press(w, "", "Down");
    press(w, "", "Right");
    press(w, "", "Enter");
    let ed = editor(d);
    check(w, g.editing && ed >= 0 && d.focused() == ed, "Enter opens the editor on the active cell, focused");
    check(w, same(d.eds.items[d.nodes.items[ed].edit].str(), "101"), `the editor starts with the cell text ("{d.eds.items[d.nodes.items[ed].edit].str()}")`);
    press(w, "x", "");
    check(w, same(d.eds.items[d.nodes.items[ed].edit].str(), "101x"), "typing goes into the editor");
    press(w, "", "C+z");
    check(w, same(d.eds.items[d.nodes.items[ed].edit].str(), "101"), "undo works inside the editor");
    press(w, "", "Escape");
    check(w, !g.editing && editor(d) < 0 && same(w.state.get(2, 1), "101") && d.focused() == b && at(w, 2, 1), "Escape cancels: value kept, focus back on the grid");
    press(w, "", "Enter");
    d.eds.items[d.nodes.items[editor(d)].edit].selectAll();
    press(w, "hello", "");
    press(w, "", "Enter");
    check(w, same(w.state.get(2, 1), "hello") && at(w, 3, 1) && !g.editing && d.focused() == b, "Enter commits, moves down, focus back on the grid");
    press(w, "7", "");
    check(w, g.editing && same(d.eds.items[d.nodes.items[editor(d)].edit].str(), "7"), "a typed character opens the editor with it replacing the text");
    press(w, "2", "");
    press(w, "", "Tab");
    check(w, same(w.state.get(3, 1), "72") && at(w, 3, 2) && !g.editing, "Tab commits and moves right");
    press(w, "", "F2");
    check(w, g.editing && same(d.eds.items[d.nodes.items[editor(d)].edit].str(), "152"), "F2 edits the cell text");
    // a click elsewhere commits
    let cy: f32 = 132.0;
    d.eds.items[d.nodes.items[editor(d)].edit].selectAll();
    press(w, "z", "");
    d.simInput(200.0, cy, false, 0.0);
    frame(w);
    d.simInput(200.0, cy, true, 0.0);
    frame(w);
    d.simInput(200.0, cy, false, 0.0);
    frame(w);
    frame(w);
    check(w, same(w.state.get(3, 2), "z") && !g.editing && g.row == 4 && g.col == 2, `a click on another cell commits and selects it ({g.row},{g.col}, "{w.state.get(3, 2)}")`);
    // a click on the grid focuses it and picks the cell
    check(w, d.focused() == b, "the click left focus on the grid");

    // the editor's row scrolls out of the window: the focused row is kept alive, so the edit goes on and commits from far away
    press(w, "", "C+Home");
    press(w, "", "Enter");
    d.eds.items[d.nodes.items[editor(d)].edit].selectAll();
    press(w, "far", "");
    d.scrollBy(b, 1200000.0);
    frame(w);
    frame(w);
    check(w, g.editing && editor(d) >= 0 && d.focused() == editor(d) && live(d) < 3200, `the edit survives its row leaving the window ({live(d)} live nodes)`);
    press(w, "!", "");
    press(w, "", "Enter");
    check(w, same(w.state.get(0, 0), "far!") && g.row == 1 && !g.editing && d.focused() == b && d.nodes.items[b].scrollY < 100.0, "committed from far away, and the grid scrolled back to the active cell");

    // range selection, copy, paste (the system clipboard is a stub headless: the TSV is read from the grid)
    press(w, "", "C+Home");
    press(w, "", "S+Down");
    press(w, "", "S+Down");
    press(w, "", "S+Right");
    check(w, at(w, 2, 1) && g.hasRange() && g.inRange(1, 0) && !g.inRange(3, 0), "Shift+arrows select a range");
    check(w, same(g.copyText(), "far!\t1\n50\t51\n100\thello"), `copy gives the range as TSV ("{g.copyText()}")`);
    press(w, "", "C+S+Right");
    check(w, g.col == COLS - 1 && g.ac == 0, "Ctrl+Shift+Right extends to the last column");
    press(w, "", "Down");
    check(w, !g.hasRange(), "a plain move collapses the range");
    press(w, "", "C+Home");
    press(w, "", "Down");
    press(w, "", "S+Down");
    press(w, "", "S+Right");
    paste(w, "a\tb\n\"c\td\"\te\n");
    check(w, same(w.state.get(1, 0), "a") && same(w.state.get(1, 1), "b") && same(w.state.get(2, 0), "c\td") && same(w.state.get(2, 1), "e"), "pasting TSV writes the block (quoted cell with a tab) in one event");
    check(w, g.hasRange() && g.row == 2 && g.col == 1, "the pasted block is the new selection");
    press(w, "", "C+Home");

    // navigation cost: moves inside the window relayout little
    press(w, "", "C+Home");
    let l0 = d.laid;
    for i in 0..5 {
        press(w, "", "Down");
    }
    printLn(`5 Down presses laid {d.laid - l0} boxes of {live(d)}`);
    check(w, d.laid - l0 < 2500, "moving inside the window does not relayout the whole grid");

    // steady
    for i in 0..30 {
        frame(w);
    }
    let laid = d.laid;
    let rs = d.restyled;
    let used = w.mem.used;
    for i in 0..300 {
        frame(w);
    }
    check(w, d.laid == laid && d.restyled == rs, `300 idle frames: 0 layouts, 0 restyles ({d.laid - laid}, {d.restyled - rs})`);
    check(w, w.mem.used == used, "300 idle frames: 0 arena growth");
    // while editing, idle too
    press(w, "", "Enter");
    for i in 0..30 {
        frame(w);
    }
    laid = d.laid;
    rs = d.restyled;
    used = w.mem.used;
    for i in 0..100 {
        frame(w);
    }
    check(w, d.laid == laid && d.restyled == rs && w.mem.used == used, `100 idle frames while editing: {d.laid - laid} layouts, {d.restyled - rs} restyles, {w.mem.used - used} bytes`);
    press(w, "", "Escape");

    frozenAndResize(w, b);

    // the picture: a cell far down being edited, scrolled sideways under the frozen column, column 2 resized
    press(w, "", "C+Down");
    press(w, "", "Up");
    press(w, "", "Up");
    for i in 0..6 {
        press(w, "", "Right");
    }
    press(w, "", "Enter");
    d.eds.items[d.nodes.items[editor(d)].edit].selectAll();
    press(w, "99.5", "");
    // the picture: a cell far down with a range selected
    press(w, "", "Escape");
    press(w, "", "S+Down");
    press(w, "", "S+Down");
    press(w, "", "S+Right");
    // GRID_PIC=resized: the top of the sheet scrolled 100 px, the frozen column beside the resized column 2
    if same(env("GRID_PIC"), "resized") {
        press(w, "", "C+Home");
        d.scrollByX(b, 100.0 - d.nodes.items[b].scrollX);
        frame(w);
        frame(w);
    }
}

fn draw(w: &World) {
    if w.frames == 0 {
        run(w);
        if w.fails == 0 {
            printLn("all passed");
        }
        // a capture run ends itself at its frame; a plain run ends here
        if env("J3_CAPTURE").len == 0 || w.fails > 0 {
            sys.exit(if w.fails == 0 { 0 } else { 1 });
        }
    } else {
        frame(w);
    }
}

fn main() {
    let app = App<World>.create("grid", 400, 220, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
