module grid.state;

use j3.memory.Arena;
use j3.text.Text;

pub struct Item {
    id: int;
}

/// One edited cell (the rest of the sheet is `row * 50 + col`).
pub struct Cell {
    row: int;
    col: int;
    text: string;
}

pub struct State {
    mem: &Arena;
    rows: []Item;
    cells: []Cell;
    n: int;
    /// Scratch for `get` (a string made in a function cannot be returned from scratch memory).
    tmp: Text;

    /// The text of cell (row, col): an edit, else its number.
    fn get(this: &State, row: int, col: int): string {
        for i in 0..this.n {
            if this.cells[i].row == row && this.cells[i].col == col {
                return this.cells[i].text;
            }
        }
        this.tmp.clear();
        this.tmp.pushInt(row * 50 + col);
        return this.tmp.str();
    }

    /// Store an edit (a copy: `text` is a view of the editor's buffer).
    fn set(this: &State, row: int, col: int, text: string) {
        let b = this.mem.alloc::<u8>(text.len);
        for i in 0..text.len {
            b[i] = text[i];
        }
        let s = b as string;
        for i in 0..this.n {
            if this.cells[i].row == row && this.cells[i].col == col {
                this.cells[i].text = s;
                return;
            }
        }
        this.cells[this.n] = Cell { row: row, col: col, text: s };
        this.n += 1;
    }
}
