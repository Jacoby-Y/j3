<script>
    use passthrough.state.{ Item, State };
    props { state: &State; }
</script>
<div class="app">
    <Chip label="plain" />
    <Chip label="wide" class="wide" />
    <Chip label="hole" class="c{state.n} x" class:on={state.on} />
    <Chip label="style" style:width={state.w} />
    <Chip label="both" class="wide" style:width="{state.w}px" style:height={state.h} />
    <Pair />
    {#each state.rows as it (it.id)}
        <Chip label={it.name} class="wide" class:on={state.on} style:opacity={state.alpha} />
    {/each}
</div>
<style>
    .wide { width: 120px; }
    .c1 { width: 60px; }
    .c2 { width: 70px; }
    .on { height: 33px; }
</style>
