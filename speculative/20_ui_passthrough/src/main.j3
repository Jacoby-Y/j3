// Plan 023 stage 2 (chunk 2b): `class` and `style:` on a component tag go to the component's root element.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run speculative/20_ui_passthrough --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module passthrough;

use passthrough.state.State;
use passthrough.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.dom.{ Dom, K_TEXT };

struct World {
    mem: &Arena;
    state: State;
    root: Screen;
    frame: int;
    fails: int;
}

fn boot(mem: &Arena): World {
    return World { mem: mem, state: State.new(mem, 1000), root: Screen.new(mem), frame: 0, fails: 0 };
}

/// The element holding the text `want` (the first one in tree order), -1 when there is none.
fn chip(d: &Dom, want: string): int {
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_TEXT && same(d.textOf(i), want) {
            return d.nodes.items[i].parent;
        }
    }
    return -1;
}

fn wide(d: &Dom, want: string): f32 {
    return d.size(chip(d, want)).x;
}

fn high(d: &Dom, want: string): f32 {
    return d.size(chip(d, want)).y;
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn near(a: f32, b: f32): bool {
    return a > b - 0.6 && a < b + 0.6;
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    let d = &w.root.dom;
    w.frame += 1;
    if w.frame == 3 {
        check(w, near(wide(d, "plain"), 40.0), `no passthrough: the child's own rule ({wide(d, "plain")})`);
        check(w, near(wide(d, "wide"), 120.0), `class from the parent: its scoped rule beats the child's own ({wide(d, "wide")})`);
        check(w, near(wide(d, "hole"), 60.0), `class hole: c1 ({wide(d, "hole")})`);
        check(w, near(high(d, "hole"), 20.0), `class:on off: the child's own style:height stays ({high(d, "hole")})`);
        check(w, near(wide(d, "style"), 90.0) && near(high(d, "style"), 20.0), `style: from the parent on the root ({wide(d, "style")})`);
        check(w, near(wide(d, "both"), 90.0) && near(high(d, "both"), 25.0), `a passed style: beats the root's own style:height ({high(d, "both")})`);
        check(w, near(wide(d, "r"), 120.0), "a keyed {#each} of components passing a class");
        w.state.on = true;
        w.state.n = 2;
    }
    if w.frame == 5 {
        check(w, near(wide(d, "hole"), 70.0), `class hole changed at runtime: c2 ({wide(d, "hole")})`);
        check(w, near(high(d, "hole"), 20.0), `class:on (height 33) loses to the root's inline style:height ({high(d, "hole")})`);
        w.state.w = 50.0;
    }
    if w.frame == 7 {
        check(w, near(wide(d, "style"), 50.0), `style: follows the parent's value ({wide(d, "style")})`);
        // idle: converged, then nothing restyles, lays out or allocates, with 1000 passing rows
        w.state.alpha = 0.5;
    }
    if w.frame == 9 {
        let laid = d.laid;
        let rs = d.restyled;
        let used = w.mem.used;
        // a changed class text restyles only the nodes that pass it; counted next
        w.state.n = 1;
        w.root.render(windowSize(), ScreenProps { state: &w.state });
        let one = d.restyled - rs;
        check(w, one >= 1 && one < 20, `class hole change restyles the chip, not the 1000 rows ({one})`);
        rs = d.restyled;
        laid = d.laid;
        for k in 0..300 {
            w.root.render(windowSize(), ScreenProps { state: &w.state });
        }
        check(w, d.laid == laid && d.restyled == rs, `300 idle frames: 0 restyles ({d.restyled - rs}), layouts ({d.laid - laid})`);
        check(w, w.mem.used == used, `300 idle frames: 0 arena growth ({w.mem.used - used})`);
        if w.fails == 0 {
            printLn("all passed");
        }
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
}

fn main() {
    let app = App<World>.create("passthrough", 640, 480, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
