module passthrough.state;

use j3.memory.Arena;

pub struct Item {
    id: int;
    name: string;
}

pub struct State {
    n: int = 1;
    on: bool = false;
    w: f32 = 90.0;
    h: f32 = 25.0;
    alpha: f32 = 1.0;
    rows: []Item;

    fn new(mem: &Arena, count: int): State {
        let rows = mem.alloc::<Item>(count);
        for i in 0..count {
            rows[i] = Item { id: i, name: "r" };
        }
        return State { rows: rows };
    }
}
