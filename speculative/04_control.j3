// Control flow. Decisions in this file:
// - no parens on `if`/`while` (script-like); braces required
// - `if` statement may omit else; if-expression (value captured) requires else
// - `for i in 0..n` is sugar for a C loop (exclusive end), not an iterator protocol
// - `defer` runs at end of the current block
// - integer overflow wraps (game-typical); no traps
// - `break` / `continue` act on the innermost loop; a label (`'rows:`) reaches an outer one

module speculative.control;

use j3.io.printLn;

fn abs(n: int): int {
    return if n < 0 { -n } else { n };
}

fn main() {
    let hp = 3;
    let invincible = false;

    if hp <= 0 && !invincible {
        printLn("dead");
    } else if invincible {
        printLn("cheat");
    } else {
        printLn(`hp={hp}`);
    }

    let n = 3;
    while n > 0 {
        printLn(`n={n}`);
        n -= 1;
    }

    printLn(`abs={abs(-4)}`);

    for i in 0..5 {
        if i == 2 { continue; }
        if i == 4 { break; }
        printLn(`i={i}`);
    }

    let name = "player";
    defer printLn("leaving main");
    printLn(`hello {name}`);
}
