module focus_probe;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.testkit;
use focus_probe.ui.{ Screen, ScreenProps };
struct World { mode: string; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { mode: env("FOCUS_MODE"), root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // FOCUS_MODE: key = Tab, Tab (second button, ring); mouse = click the second button (no ring, card still lit);
    // text = click the text box (ring even from the mouse); none = nothing
    if same(w.mode, "key") {
        testkit.simKeys(d, w.frame, 6, "", "Tab");
        testkit.simKeys(d, w.frame, 8, "", "Tab");
    } else if same(w.mode, "mouse") {
        testkit.clickTag(d, w.frame, 6, "button", 1);
    } else if same(w.mode, "text") {
        testkit.clickTag(d, w.frame, 6, "input", 0);
    }
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 25 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 25 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("focus steady frame changed layout style or allocation"); }
    if w.frame == 40 { printLn("focus_probe ok: focus-visible, focus-within, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("focus probe", 320, 220, boot);
    app.useGl(); app.draw(draw); app.run();
}
