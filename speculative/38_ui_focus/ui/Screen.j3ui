<div class="screen">
    <div class="title">Focus</div>
    <div class="card">
        <button class="btn">One</button>
        <button class="btn">Two</button>
        <input type="text" class="field" value="text box">
    </div>
    <div class="card">
        <button class="btn">Three</button>
    </div>
</div>
<style>
    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }
    .title { margin-bottom: 8px; color: #a0b0d0; }
    .card { display: flex; gap: 8px; padding: 8px; margin-bottom: 10px; border: 2px solid #303848; border-radius: 6px; }
    .card:focus-within { border-color: #4caf50; background: #1a2a1a; }
    .btn { width: 70px; height: 28px; background: #3050a0; color: #ffffff; border: none; border-radius: 4px; }
    .btn:focus-visible { outline: 2px solid #89b4fa; outline-offset: 2px; }
    .field { width: 100px; height: 28px; }
    .field:focus-visible { outline: 2px solid #f9e2af; outline-offset: 1px; }
</style>
