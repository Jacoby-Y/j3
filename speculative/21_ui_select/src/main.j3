// Plan 023 chunk 3a: the open `<select>` list is a real DOM subtree on the overlay layer. This project is the
// golden and cost harness (the checks of the mechanism are in `stdlib/tests/overlay_test.j3`).
// Headless goldens:  tools/golden.sh [--update]   (captures `SEL_GOLDEN=default|themed|multi|long`)
// Cost and behaviour through a generated component: SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run speculative/21_ui_select --headless
// (no SEL_GOLDEN: prints PASS/FAIL lines, exit code 1 on a failure).

module selects;

use selects.state.State;
use selects.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ env, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.dom.Dom;

struct World {
    mem: &Arena;
    state: State;
    root: Screen;
    frame: int;
    fails: int;
    mx: f32;
    my: f32;
    down: bool;
    laid: int;
    restyled: int;
    used: int;
}

fn boot(mem: &Arena): World {
    return World { mem: mem, state: State.new(mem, 5000), root: Screen.new(mem), frame: 0, fails: 0, mx: -5.0, my: -5.0, down: false, laid: 0, restyled: 0, used: 0 };
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

/// Move the pointer (and press or release) for the next frame.
fn mouse(w: &World, x: f32, y: f32, down: bool) {
    w.mx = x;
    w.my = y;
    w.down = down;
}

fn step(w: &World) {
    w.root.dom.simInput(w.mx, w.my, w.down, 0.0);
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    w.frame += 1;
}

fn frames(w: &World, n: int) {
    for i in 0..n {
        step(w);
    }
}

fn click(w: &World, x: f32, y: f32) {
    mouse(w, x, y, false);
    frames(w, 2);
    mouse(w, x, y, true);
    frames(w, 1);
    mouse(w, x, y, false);
    frames(w, 2);
}

fn key(w: &World, names: string) {
    w.root.dom.simKeys("", names);
    step(w);
}

/// One real frame of a golden run: click the select of `which` at frame 4, park the pointer off the list, so the
/// highlighted row is the chosen one. `J3_CAPTURE=out.png:30` takes frame 30.
fn goldenDraw(w: &World, which: string) {
    w.state.custom = same(which, "custom");
    let x: f32 = 60.0;
    let y: f32 = 36.0;
    if same(which, "custom") {
        x = 60.0; y = 116.0;
    } else if same(which, "themed") {
        x = 270.0;
    } else if same(which, "multi") {
        x = 60.0;
        y = 316.0;
    } else if same(which, "long") {
        x = 480.0;
    }
    if w.frame == 3 {
        mouse(w, x, y, false);
    } else if w.frame == 4 {
        mouse(w, x, y, true);
    } else if w.frame == 5 {
        mouse(w, x, y, false);
    } else if w.frame >= 7 {
        mouse(w, 600.0, 460.0, false);
    }
    step(w);
}

fn tests(w: &World) {
    let d = &w.root.dom;
    frames(w, 3);
    check(w, d.ptRoot < 0, "closed: no list nodes");
    let before = d.count();
    // a 5000-option select opens without building 5000 rows
    click(w, 480.0, 36.0);
    frames(w, 3);
    check(w, d.pop.kind == 1 && d.ptRoot >= 0, "click opens the list");
    let live = d.count() - before;
    check(w, live > 5 && live < 200, `5000 options: {live} live list nodes`);
    // arrow keys move the highlight, Enter picks, bind:value and on:input see it
    let c0 = w.state.changes;
    key(w, "Down");
    key(w, "Down");
    key(w, "Enter");
    frames(w, 2);
    check(w, d.pop.kind == 0 && d.ptRoot < 0, "Enter closes and removes the list");
    check(w, same(w.state.big, "v2502"), `Enter picked the row after the chosen one ({w.state.big})`);
    // a long list scrolls the chosen row into view and End goes to the last
    click(w, 480.0, 36.0);
    frames(w, 3);
    key(w, "End");
    frames(w, 2);
    check(w, d.pop.hot == 4999, "End highlights the last option");
    key(w, "Enter");
    frames(w, 2);
    check(w, same(w.state.big, "v4999"), `End, Enter: {w.state.big}`);
    // on:input fired for the picks on the first select
    click(w, 60.0, 36.0);
    frames(w, 3);
    key(w, "Down");
    key(w, "Enter");
    frames(w, 2);
    check(w, same(w.state.fruit, "banana") && w.state.changes == c0 + 1, `first select: on:input once ({w.state.changes - c0}), value {w.state.fruit}`);
    // idle with a list open: nothing lays out, restyles or allocates
    click(w, 60.0, 36.0);
    mouse(w, 600.0, 460.0, false);
    frames(w, 6);
    w.laid = d.laid;
    w.restyled = d.restyled;
    w.used = w.mem.used;
    frames(w, 200);
    check(w, d.laid == w.laid && d.restyled == w.restyled, `200 frames with a list open: 0 layouts ({d.laid - w.laid}), 0 restyles ({d.restyled - w.restyled})`);
    check(w, w.mem.used == w.used, `200 frames with a list open: 0 arena growth ({w.mem.used - w.used})`);
    key(w, "Escape");
    frames(w, 2);
    check(w, d.ptRoot < 0, "Escape closes it");
    if w.fails == 0 {
        printLn("all passed");
    }
    sys.exit(if w.fails == 0 { 0 } else { 1 });
}

fn draw(w: &World) {
    let g = env("SEL_GOLDEN");
    if g.len > 0 {
        goldenDraw(w, g);
        return;
    }
    if w.frame == 0 {
        tests(w);
    }
}

fn main() {
    let app = App<World>.create("selects", 640, 480, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
