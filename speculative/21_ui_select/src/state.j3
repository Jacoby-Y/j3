module selects.state;

use j3.memory.Arena;

pub struct Row {
    id: int;
    value: string;
    label: string;
}

/// A copy of `s` that outlives the frame (template text is frame scratch).
fn keep(mem: &Arena, s: string): string {
    let b = mem.alloc::<u8>(s.len);
    for i in 0..s.len {
        b[i] = s[i];
    }
    return b as string;
}

pub struct State {
    custom: bool = false;
    visual: string = "apple";
    fruit: string = "apple";
    fancy: string = "two";
    big: string = "v2500";
    multi: string = "cheese,olives";
    changes: int = 0;
    rows: []Row;

    fn new(mem: &Arena, count: int): State {
        let rows = mem.alloc::<Row>(count);
        for i in 0..count {
            rows[i] = Row { id: i, value: keep(mem, `v{i}`), label: keep(mem, `Option number {i}`) };
        }
        return State { rows: rows };
    }
}
