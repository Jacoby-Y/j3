<script>
    use selects.state.State;
    props { state: &State; }
</script>
<div class="app">
    <select class="a" bind:value={state.fruit} on:input={state.changes += 1}>
        <option value="apple">Apple</option>
        <option value="banana">Banana</option>
        <option value="cherry">Cherry</option>
        <option value="durian" disabled>Durian (sold out)</option>
        <option value="elder">Elderberry</option>
    </select>
    <select class="b fancy" bind:value={state.fancy}>
        <option value="one">One</option>
        <option value="two">Two</option>
        <option value="three">Three</option>
        <option value="four">Four</option>
        <option value="five">Five</option>
        <option value="six">Six</option>
        <option value="seven">Seven</option>
    </select>
    <select class="c" bind:value={state.big}>
        {#each state.rows as r (r.id)}
            <option value={r.value}>{r.label}</option>
        {/each}
    </select>
    <select class="d" multiple bind:value={state.multi}>
        <option value="cheese">Cheese</option>
        <option value="olives">Olives</option>
        <option value="peppers">Peppers</option>
        <option value="onions">Onions</option>
    </select>
    {#if state.custom}
    <select class="e" bind:value={state.visual}>
        <option value="apple"><svg class="fruit-icon" viewBox="0 0 16 16"><path d="M8 5 C2 0 0 8 4 13 C6 16 7 13 8 14 C9 13 10 16 12 13 C16 8 14 0 8 5 Z" fill="#a6e3a1" /></svg><span class="fruit-name">Green <span class="detail">Apple</span></span></option>
        <option value="berry"><img class="fruit-icon" src="assets/icon.png" /><span class="fruit-name">Sweet <span class="detail">Berry</span></span></option>
        <option value="sold" disabled><span class="fruit-name">Sold out</span></option>
    </select>
    {/if}
    <span class="out">{state.fruit} {state.changes}</span>
</div>
<style>
    .app { width: 640px; height: 480px; background: var(--bg); position: relative; }
    select { position: absolute; top: 20px; width: 180px; height: 32px; }
    .a { left: 20px; }
    .b { left: 230px; }
    .c { left: 440px; }
    .d { left: 20px; top: 300px; }
    .e { left: 20px; top: 100px; width: 260px; }
    .e .j3-option { height: 34px; }
    .fruit-icon { width: 20px; height: 20px; margin-right: 10px; }
    option .fruit-name { color: #a6e3a1; font-weight: bold; }
    option .detail { color: #f9e2af; }
    .out { position: absolute; left: 230px; top: 300px; }
    /* A component's own rules reach its select lists: the popup nodes carry the owner's style scope. */
    select.fancy .j3-select-list { box-shadow: 0 8px 22px rgba(203, 166, 247, 0.55); max-height: 120px; border-radius: 12px; background: #2a2540; border-color: #cba6f7; padding: 4px 0; }
    select.fancy .j3-option { height: auto; padding: 7px 10px; border-radius: 8px; margin: 0 4px 2px; }
    select.fancy .j3-option.selected { background: #45475a; }
    select.fancy .j3-option:hover { background: #7f5fbf; }
    select.fancy .j3-check { accent-color: #a6e3a1; width: 14px; height: 12px; margin: 0 8px 0 0; }
</style>
