<script>
    props { finished: bool; }
</script>
<div class="screen" class:finished={finished}>
    <div class="ring"><div class="hole">progress</div></div>
    <div class="spin"><div class="hole">spinner</div></div>
    <div class="card">
        <div class="fill">inherits --w</div>
        <div class="fill own">own --w</div>
    </div>
    <div class="swatch">--c</div>
</div>
<style>
    @property --p { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
    @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
    @property --w { syntax: '<length>'; inherits: true; initial-value: 0px; }
    @property --c { syntax: '<color>'; inherits: false; initial-value: #2060d0; }
    .screen { position: relative; width: 380px; height: 280px; background: #f2f2f6; color: #303040; font-size: 12px; }
    .ring { position: absolute; left: 20px; top: 20px; width: 120px; height: 120px; border-radius: 60px; background: conic-gradient(#4080ff var(--p), #dde0ea var(--p)); animation: fill 1s linear forwards; }
    .spin { position: absolute; left: 160px; top: 20px; width: 120px; height: 120px; border-radius: 60px; background: conic-gradient(from var(--a), #f08040, #ffffff 50%, #f08040); animation: turn 2s linear infinite; }
    .hole { position: absolute; left: 15px; top: 15px; width: 90px; height: 90px; border-radius: 45px; background: #f2f2f6; text-align: center; padding-top: 38px; box-sizing: border-box; }
    .card { position: absolute; left: 20px; top: 170px; width: 240px; height: 80px; background: #d8d8e0; animation: widen 1s linear forwards; }
    .fill { height: 24px; width: var(--w); background: #20b080; color: #ffffff; margin-bottom: 8px; overflow: hidden; }
    .own { --w: 120px; background: #8060c0; }
    .swatch { position: absolute; left: 290px; top: 170px; width: 70px; height: 70px; background: var(--c); color: #ffffff; animation: tint 1s linear forwards; }
    .finished .ring, .finished .card, .finished .swatch { animation-duration: 80ms; }
    .finished .spin { animation-iteration-count: 1; animation-duration: 80ms; animation-fill-mode: forwards; }
    @keyframes fill { to { --p: 70%; } }
    @keyframes turn { to { --a: 360deg; } }
    @keyframes widen { to { --w: 200px; } }
    @keyframes tint { to { --c: #d03080; } }
</style>
