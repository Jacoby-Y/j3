// `extend T { fn .. }`: methods of T written outside its struct body, in any file of T's module.
// - a part file (`extend/*.j3` saying `module speculative.extend;`) can hold a big type's methods
// - same as writing them in the body: `x.m()`, UFCS, private names of the module
// - a generic struct is extended with its own parameter names: `extend Box<T> { .. }`
// - errors: unknown type, type of another module, enum, duplicate method, parameter mismatch

module speculative.extend;

use j3.io.printLn;

struct Counter {
    n: int;
    fn get(this: &Counter): int { return this.n; }
}

struct Box<T> {
    v: T;
}

extend Counter {
    fn bump(this: &Counter, by: int) { this.n += by; }
}

fn main() {
    let c = Counter { n: 1 };
    c.bump(4);
    c.scale(3);
    printLn(`counter={c.get()} double={c.double()}`);
    let b = Box<int> { v: 20 };
    let s = Box<string> { v: "hi" };
    printLn(`box={b.twice()} {s.twice()}`);
}
