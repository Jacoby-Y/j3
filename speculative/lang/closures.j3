// Closures: `fn(x: int): int { body }` captures the variables it names, by address.
// - a write inside the closure is visible after it
// - the type is `closure(A, B): R`, usable as a parameter or a `let` only (it points into the creating frame)
// - a plain `fn` converts to a closure; a closure never converts to a plain `fn` or `ptr`
// - a literal with no captures can stand for a plain `fn(..)`

module speculative.closures;

use j3.io.printLn;

struct Counter {
    n: int;

    fn bumper(this: &Counter, by: int): int {
        let add = fn(k: int) { this.n += k * by; };
        add(1);
        add(2);
        return this.n;
    }
}

fn apply(f: closure(int): int, x: int): int { return f(x); }
fn twice(f: closure(int)) { f(1); f(2); }
fn triple(x: int): int { return x * 3; }
fn plain(f: fn(int): int, x: int): int { return f(x); }

fn main() {
    let total = 0;
    let base = 10;
    let c = fn(x: int): int { total += x; return base + x; };
    printLn(`{c(1)} {c(2)} total={total}`);
    printLn(`apply={apply(fn(x) { return x * base; }, 4)} thunk={apply(triple, 5)}`);
    twice(fn(i) { total += i * 100; });
    printLn(`total={total}`);

    let hold = 0;
    for i in 0..3 {
        let each = fn(): int { return i; };
        hold += each() * 10 + 1;
    }
    printLn(`hold={hold}`);

    let outer = fn(a: int): int {
        let inner = fn(b: int): int { total += 1; return a + b + base; };
        return inner(a) + inner(1);
    };
    printLn(`nested={outer(2)} total={total}`);

    let ctr = Counter { n: 0 };
    printLn(`method={ctr.bumper(5)} n={ctr.n}`);

    let nocap: fn(int): int = fn(x: int): int { return x + 1; };
    printLn(`plain={plain(nocap, 1)} {plain(fn(x: int): int { return x - 1; }, 1)}`);

    let d = 1;
    let early = fn(): int {
        defer { d += 100; }
        if d == 1 { return 7; }
        return 8;
    };
    printLn(`early={early()} d={d}`);
}
