// Small gaps, all of them already in `j3c doc lang`:
// - an untyped literal takes the other operand's type (`2 * far` is f32)
// - `/=` and `%=`
// - `match` on integers takes int literals and needs a `_` arm
// - labeled `break` and `continue` reach an outer loop
// - a `let` ends with its block, so sibling blocks can reuse the name
// - `& | ^ ~`, `&=` `|=` `^=`, and `0b` literals
// - `int(e)` of a C-like enum is its variant's index; a const table may hold such variants
// - a fn takes and returns `[N]T` by value (a copy), on both backends

module speculative.small_gaps;

use j3.io.printLn;

enum Dir { North, East, South, West }

const TURNS: [3]Dir = [Dir.East, Dir.West, Dir.South];

fn corners(w: int): [4]int { return [0, w, w * 2, w * 3]; }

fn bump(xs: [4]int): [4]int {
    xs[0] = 9;
    return xs;
}

fn main() {
    let far: f32 = 3.0;
    let scaled = 2 * far;
    printLn(`scaled={scaled}`);

    let total = 17;
    total /= 5;
    let rest = 17;
    rest %= 5;
    printLn(`total={total} rest={rest}`);

    for code in 0..4 {
        match code {
            0 { printLn("zero"); }
            2 { printLn("two"); }
            _ { printLn(`other {code}`); }
        }
    }

    'rows: for r in 0..3 {
        for c in 0..3 {
            if c == 1 { continue 'rows; }
            if r == 2 { break 'rows; }
            printLn(`r{r} c{c}`);
        }
    }

    if far > 1.0 { let a = 1; printLn(`a={a}`); }
    if far > 1.0 { let a = 2; printLn(`a={a}`); }

    let flags: u8 = 0b1010;
    flags |= 0b0001;
    flags &= 0b0111;
    printLn(`flags={flags} low={flags & 0b0011} inv={flags ^ 0xff} all={~u8(0)}`);
    printLn(`dir={int(Dir.South)} turn={int(TURNS[1])}`);
    let cs = corners(5);
    let moved = bump(cs);
    printLn(`array {cs[0]} {cs[3]} {moved[0]} {moved[2]}`);
}
