// Small gaps, all of them already in `j3c doc lang`:
// - an untyped literal takes the other operand's type (`2 * far` is f32)
// - `/=` and `%=`
// - `match` on integers takes int literals and needs a `_` arm
// - labeled `break` and `continue` reach an outer loop
// - a `let` ends with its block, so sibling blocks can reuse the name
// - `& | ^ ~`, `&=` `|=` `^=`, and `0b` literals

module speculative.small_gaps;

use j3.io.printLn;

fn main() {
    let far: f32 = 3.0;
    let scaled = 2 * far;
    printLn(`scaled={scaled}`);

    let total = 17;
    total /= 5;
    let rest = 17;
    rest %= 5;
    printLn(`total={total} rest={rest}`);

    for code in 0..4 {
        match code {
            0 { printLn("zero"); }
            2 { printLn("two"); }
            _ { printLn(`other {code}`); }
        }
    }

    'rows: for r in 0..3 {
        for c in 0..3 {
            if c == 1 { continue 'rows; }
            if r == 2 { break 'rows; }
            printLn(`r{r} c{c}`);
        }
    }

    if far > 1.0 { let a = 1; printLn(`a={a}`); }
    if far > 1.0 { let a = 2; printLn(`a={a}`); }

    let flags: u8 = 0b1010;
    flags |= 0b0001;
    flags &= 0b0111;
    printLn(`flags={flags} low={flags & 0b0011} inv={flags ^ 0xff} all={~u8(0)}`);
}
