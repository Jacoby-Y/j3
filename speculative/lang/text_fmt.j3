// Formatting into a growable `Text`:
// - `t.fmt(`..{x}..`)` appends each part straight into `t`: no 512-byte limit (a plain
//   `"{x}"` string still uses a 512-byte stack buffer and aborts past it)
// - every primitive and `#[Debug]` structs/enums print the same as in `"{x}"`
// - `pushU64`, `pushHex`, `pushF64` (shortest round-trip), `pushChar` (UTF-8), `indent(n)`, `pushLine`
// - `flushTo(fd)` writes the bytes out and empties the buffer (keeps its capacity)

module speculative.text_fmt;

use j3.io.printLn;
use j3.memory.Arena;
use j3.text.Text;

#[Debug]
struct Span {
    lo: int;
    hi: int;
}

#[Debug]
struct Tok {
    name: string;
    at: Span;
    hot: bool;
}

#[Debug]
enum Kind {
    Word(string),
    Num(int, f64),
    End,
}

fn main() {
    let arena = Arena.create(1 << 20);
    let t = Text.new(&arena);
    let i: i8 = -5;
    let u = ~u64(0);
    let f: f32 = 1.5;
    let x = 0.1;
    let tok = Tok { name: "let", at: Span { lo: 4, hi: 7 }, hot: true };
    t.fmt(`i={i} u={u} f={f} x={x} b={true} {tok}`);
    printLn(t.str());
    printLn(`i={i} u={u} f={f} x={x} b={true} {tok}`);

    t.clear();
    let k = Kind.Num(3, 2.5);
    t.fmt(`{k} {Kind.Word("w")} {Kind.End}`).fmt(` done`);
    printLn(t.str());

    t.clear();
    t.pushU64(u);
    t.push(' ');
    t.pushHex(255);
    t.push(' ');
    t.pushF64(0.1);
    t.push(' ');
    t.pushChar(0x1F600);
    t.pushChar('A');
    t.push(' ');
    t.indent(2);
    t.pushLine("end");
    t.flushTo(1);

    // past the 512-byte cap of a plain interpolation
    let long = Text.new(&arena);
    for n in 0..100 {
        long.fmt(`{n},`);
    }
    t.fmt(`{long.str()}{long.str()}`);
    printLn(`len={t.len()}`);
}
