// f16 is storage only. Keep halves in structs, arrays, and `List<f16>`; convert to `f32` to
// compute. `f16(x)` rounds to nearest even (overflow is infinity); `f32(h)` / `f64(h)` are exact.
// Same bits on the LLVM and C backends. Not available in `.j3s` scripts or as a `j3.gpu` attribute.

module speculative.f16;

use j3.io.printLn;

struct Vertex {
    h: f16;
    w: f32;
}

fn mid(a: f16, b: f16): f16 {
    return f16((f32(a) + f32(b)) * 0.5);
}

fn main() {
    let x: f16 = 1.5;
    let xs: [3]f16 = [0.25, f16(2.0), x];
    xs[1] = mid(xs[0], xs[2]);
    printLn(`{f32(xs[0])} {f32(xs[1])} {f32(xs[2])}`);
    printLn(`{f32(f16(65504.0))} {f32(f16(70000.0)) > 100000.0}`);
    printLn(`{f32(f16(2049))} {f32(f16(2051))} {f64(f16(0.1))}`);
    let v = Vertex { h: 3.0, w: 4.0 };
    printLn(`{@sizeof(f16)} {@sizeof(Vertex)} {f32(v.h) * v.w}`);
}
