// Collections for compiler-style code (plan 08 (bootstrap features) A8 + A5):
// - a generic struct's methods are checked per instance and only when called (lazy generic-struct methods):
//   `List<Tok>` compiles though `Tok` has no `==`, because nothing calls `indexOf` on it
// - a generic method infers its type args from the arguments: `mem.new(Expr.Num(1))` is `Arena.new::<Expr>`
// - `sort` / `sortBy` are stable; `Map.sortedKeys` gives a deterministic order; `Map.each` takes a closure
// - `Pool<T>` hands out typed `Id<T>` handles (usable as `Map` keys); `Interner` maps strings to `u32`
// - a recursive enum through `&` has a layout, and `#[Debug]` prints a pointer as its type (no recursion)

module speculative.collections;

use j3.cmp.{ sort, sortBy };
use j3.data.intern.Interner;
use j3.data.map.Map;
use j3.data.pool.{ Id, Pool };
use j3.io.printLn;
use j3.memory.{ Arena, List };

struct Tok {
    text: string;
    line: int;
}

#[Debug]
enum Expr {
    Num(int),
    Add(&Expr, &Expr),
}

fn eval(e: &Expr): int {
    return match *e {
        Expr.Num(n) { n }
        Expr.Add(l, r) { eval(l) + eval(r) }
    };
}

fn main() {
    let mem = Arena.create(1 << 16);

    let toks = List<Tok>.new(&mem);
    toks.push(Tok { text: "let", line: 2 });
    toks.push(Tok { text: "fn", line: 1 });
    toks.push(Tok { text: "if", line: 1 });
    sortBy(toks.slice(), fn(a: Tok, b: Tok): bool { return a.line < b.line; });
    printLn(`{toks.items[0].text} {toks.items[1].text} {toks.last().text}`);

    let nums = List<int>.new(&mem);
    let raw = [5, 3, 5, 1];
    for n in raw { nums.push(n); }
    nums.insert(0, 9);
    sort(nums.slice());
    printLn(`sorted {nums.items[0]} {nums.items[1]} {nums.items[4]} has3={nums.contains(3)} at5={nums.indexOf(5)} pop={nums.pop()}`);

    let counts = Map<string, int>.new(&mem, 8);
    let words = ["b", "a", "b", "c", "b"];
    for w in words {
        let p = counts.getOrPut(w, 0);
        *p += 1;
    }
    let keys = counts.sortedKeys(&mem);
    printLn(`{keys[0]}={counts.getOr(keys[0], 0)} {keys[1]}={counts.getOr(keys[1], 0)} {keys[2]}={counts.getOr(keys[2], 0)}`);
    let total = 0;
    counts.each(fn(k: string, v: int) { total += v; });
    printLn(`total={total}`);

    let exprs = Pool<Expr>.new(&mem);
    let one = exprs.add(Expr.Num(1));
    let uses = Map<Id<Expr>, int>.new(&mem, 8);
    uses.put(one, 3);
    let tree = mem.new(Expr.Add(mem.new(Expr.Num(2)), exprs.get(one)));
    printLn(`eval={eval(tree)} uses={uses.getOr(one, 0)} {*tree}`);

    let names = Interner.new(&mem);
    let x = names.intern("x");
    let y = names.intern("y");
    printLn(`x={x} y={y} again={names.intern("x")} str={names.str(y)}`);
}
