// Traits: bounds on generic parameters, checked where the generic is used.
// A type satisfies a trait by having its methods; `#[impl]` fns give them to types you can't edit.
module speculative.traits;

use j3.io.printLn;

pub trait Weigh { fn weigh(this: Self): int; }
pub trait Eq { fn operator==(this: Self, other: Self): bool; }
pub trait Ord { fn operator<(this: Self, other: Self): bool; }

struct Pt {
    x: int;
    y: int;
    fn weigh(this: &Pt): int { return this.x + this.y; }
    fn operator==(this: Pt, other: Pt): bool { return this.x == other.x && this.y == other.y; }
    fn operator<(this: Pt, other: Pt): bool { return this.x < other.x; }
}

#[impl]
fn weigh(x: int): int { return x * 10; }

#[impl]
fn weigh(x: string): int { return x.len; }

fn describe<T: Weigh>(v: T): int { return v.weigh(); }

fn same<T: Eq>(a: T, b: T): bool { return a == b; }
fn differ<T: Eq>(a: T, b: T): bool { return a != b; }
fn biggest<T: Ord>(a: T, b: T): T { if a > b { return a; } return b; }
fn atMost<T: Ord>(a: T, b: T): bool { return a <= b; }

struct Pair<A: Weigh, B: Weigh> {
    a: A;
    b: B;
    fn total(this: &Pair<A, B>): int { return this.a.weigh() + this.b.weigh(); }
}

fn main() {
    let p = Pt { x: 1, y: 2 };
    printLn(`{describe(p)} | {describe(7)} | {describe("hi")}`);
    printLn(`{same(1, 1)} {differ(1, 1)} {same(p, Pt { x: 1, y: 2 })} {differ(p, Pt { x: 3, y: 2 })}`);
    let q = Pt { x: 5, y: 1 };
    printLn(`{biggest(2, 9)} {biggest(p, q).weigh()} {atMost(p, q)} {atMost(q, p)}`);
    let pair = Pair<Pt, int> { a: p, b: 4 };
    printLn(`total={pair.total()}`);
}
