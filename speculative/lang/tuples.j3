// Tuples and multiple returns (plan 08 B3):
// - `(int, string)` is a type, `(a, b)` a value, `.0` / `.1` its elements (`t.0.1` nests)
// - `let (q, r) = f();` destructures; tuple patterns work in `match` arms, inside variants
//   (`Option.Some((k, v))`) and in `for (k, v) in xs`
// - a tuple is a plain struct: one type program-wide per element list
// - `==` and `hash()` exist when every element has them, so a tuple can be a `Map` key
// - interpolation prints `(1, x)`

module speculative.tuples;

use j3.data.map.Map;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;

enum Op { Add, Mul }

fn divmod(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

fn find(xs: []int, x: int): Option<(int, int)> {
    for i in 0..xs.len {
        if xs[i] == x { return Option.Some((i, xs[i] * 10)); }
    }
    return Option.None;
}

fn apply(p: (Op, int), x: int): int {
    match p {
        (Op.Add, n) { return x + n; }
        (Op.Mul, 0) { return 0; }
        (Op.Mul, n) { return x * n; }
    }
}

fn main() {
    let (q, r) = divmod(17, 5);
    let t = divmod(9, 4);
    printLn(`q={q} r={r} t={t.0},{t.1}`);
    let nest: ((int, f32), string) = ((1, 2.5), "hi");
    let ((a, b), s) = nest;
    printLn(`{nest.0.1} {a} {b} {s} {nest}`);
    let xs = [3, 5, 7];
    match find(xs, 5) {
        Option.Some((i, v)) { printLn(`found at {i} -> {v}`); }
        Option.None { printLn("none"); }
    }
    printLn(`{apply((Op.Add, 2), 3)} {apply((Op.Mul, 2), 3)} {apply((Op.Mul, 0), 3)}`);
    printLn(`{(1, "x") == (1, "x")} {(1, "x") != (2, "x")} {(1, "x").hash() == (1, "x").hash()}`);

    let arena = Arena.create(1 << 16);
    let seen = Map<(int, int), string>.new(&arena, 8);
    seen.put((0, 0), "origin");
    seen.put((2, 3), "far");
    seen.put((0, 0), "home");
    let total = 0;
    for (k, v) in seen.entries(&arena) { total += k.0 + k.1 + v.len; }
    printLn(`len={seen.len} at={seen.getOr((0, 0), "?")} total={total}`);
    arena.destroy();
}
