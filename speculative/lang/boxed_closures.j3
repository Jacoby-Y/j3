// Boxed closures: `fn[mem](x: int): int { body }` copies the values it captures into arena `mem`.
// - the type is `boxed closure(A): R`: a value like any other (field, return, `List` element, pool job)
// - captures are copies taken at creation: a later write to the original is not seen
// - a write inside the closure changes its own copy, kept between calls
// - it never frees itself; it lives as long as `mem` (rewind or free the arena only when done with it)
// - it can be passed where a `closure(..)` of the same signature is wanted, never the other way
// - a stack closure cannot be captured (it would dangle); a captured `&local` is yours to keep alive
// - a `#[singleton] let` may hold one: it starts empty (calling it then crashes), set it at startup;
//   a `const` cannot (its captures live in an arena made at run time)

module speculative.boxed_closures;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.thread.Pool;

fn adder(mem: &Arena, k: int): boxed closure(int): int {
    return fn[mem](x: int): int { return x + k; };
}

fn apply(f: closure(int): int, x: int): int { return f(x); }

/// 1 on the main thread only: a job that reads 0 ran on a worker.
#[singleton]
#[thread]
let ON_MAIN: int = 0;

#[singleton]
let ON_HIT: boxed closure(int): int;

struct Handler {
    name: string;
    run: boxed closure(int): int;
}

fn main() {
    ON_MAIN = 1;
    let mem = Arena.create(4096);

    // returned from a fn and called later
    let add5 = adder(&mem, 5);
    let add7 = adder(&mem, 7);
    printLn(`add5={add5(1)} add7={add7(1)} via stack param={apply(add5, 10)}`);

    // capture by value
    let base = 100;
    let snap = fn[mem](x: int): int { return base + x; };
    base = 0;
    printLn(`snap={snap(1)} base={base}`);

    // own state between calls
    let n = 0;
    let counter = fn[&mem](): int { n += 1; return n; };
    counter();
    counter();
    printLn(`counter={counter()} n={n}`);

    // several in a List, and one as a struct field
    let fns = List<boxed closure(int): int>.new(&mem);
    for i in 1..4 {
        fns.push(fn[mem](x: int): int { return x * i; });
    }
    let total = 0;
    for f in fns.slice() {
        total += f(10);
    }
    let h = Handler { name: "double", run: fn[mem](x: int): int { return x * 2; } };
    let hr = h.run;
    ON_HIT = fn[mem](x: int): int { return x + total; };
    printLn(`list total={total} {h.name}={hr(21)} global={ON_HIT(1)}`);

    // a pool job: the closure and its captures live in `mem`, which outlives `wait`
    let pool = Pool.create(&mem, 2, 8);
    let out = mem.alloc::<int>(3);
    let onMain = mem.alloc::<int>(3);
    for i in 0..3 {
        let slot = &out[i];
        let where = &onMain[i];
        pool.submitBoxed(fn[mem]() { *slot = (i + 1) * 11; *where = ON_MAIN; });
    }
    pool.wait();
    pool.shutdown();
    printLn(`pool {out[0]} {out[1]} {out[2]} on main={onMain[0] + onMain[1] + onMain[2]} here={ON_MAIN}`);
}
