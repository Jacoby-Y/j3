// Match patterns:
// - `_` on an enum: the arms it leaves out (a `_` that covers nothing is a warning)
// - `A | B`: or-patterns; every alternative binds the same names with the same types
// - `Tok.Num(n) if n < 0`: a guard; when it is false the next arms are tried, and a guarded arm
//   does not count toward "every variant has an arm"
// - `'a'..='z'` / `0..=9`: ranges in an int match, both ends included; ranges and values may
//   not overlap
// - nested payloads: `Shape.Pair(Tok.Num(n))`

module speculative.patterns;

use j3.io.printLn;

enum Tok { Plus, Minus, Star, Slash, Num(int), Name(string), Eof }

enum Shape { Dot(int), Pair(Tok) }

fn kind(c: u8): string {
    match c {
        'a'..='z' | 'A'..='Z' | '_' { return "name"; }
        '0'..='9' { return "digit"; }
        ' ' | '\t' | '\n' { return "space"; }
        _ { return "other"; }
    }
}

fn describe(t: Tok) {
    match t {
        Tok.Plus | Tok.Minus { printLn("add"); }
        Tok.Star | Tok.Slash { printLn("mul"); }
        Tok.Num(n) if n < 0 { printLn(`negative {n}`); }
        Tok.Num(n) { printLn(`number {n}`); }
        _ { printLn("other"); }
    }
}

fn size(s: Shape): int {
    match s {
        Shape.Dot(n) | Shape.Pair(Tok.Num(n)) { return n; }
        _ { return -1; }
    }
}

fn main() {
    printLn(`{kind('q')} {kind('Z')} {kind('_')} {kind('7')} {kind(' ')} {kind('+')}`);
    describe(Tok.Minus);
    describe(Tok.Slash);
    describe(Tok.Num(-3));
    describe(Tok.Num(8));
    describe(Tok.Eof);
    printLn(`{size(Shape.Dot(4))} {size(Shape.Pair(Tok.Num(9)))} {size(Shape.Pair(Tok.Star))}`);
    let score = 0;
    for n in 0..12 {
        match n {
            0 { score += 100; }
            1..=3 | 10 { score += 10; }
            _ if n % 2 == 0 { score += 1; }
            _ {}
        }
    }
    printLn(`score={score}`);
}
