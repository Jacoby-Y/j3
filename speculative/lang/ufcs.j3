// UFCS: `x.f(args)` calls the free fn `f(x, args)` when x's type has no method `f`.
// - the fn must be visible by bare name (defined here, or `use m.{ f }`)
// - the first parameter takes the receiver by value, or `&T` (the call takes the address)
// - the type's own method wins
// - works on structs, primitives, slices, strings

module speculative.ufcs;

use j3.io.printLn;
use j3.math.{ abs };

struct P {
    x: int;
    y: int;
}

fn sum(p: P): int { return p.x + p.y; }
fn bump(p: &P, by: int) { p.x += by; }
fn dbl(n: int): int { return n * 2; }
fn count(xs: []int): int { return xs.len; }
fn shout(s: string): int { return s.len; }

fn main() {
    let p = P { x: 1, y: 2 };
    p.bump(10);
    printLn(`sum={p.sum()} chain={p.sum().dbl().dbl()}`);
    let far: f32 = -2.5;
    let xs: []int = [1, 2, 3];
    printLn(`abs={far.abs()} count={xs.count()} len={"hello".shout()}`);
}
