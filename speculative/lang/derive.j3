// Derives (plan 08 (bootstrap features) B4): `#[derive(Eq, Hash, Ord, Debug, Clone)]` on a struct or enum writes the
// methods field by field, the same as writing them by hand:
// - `==`: every field (an enum: same variant, then its fields)
// - `<`: the first field that differs decides (an enum: variant order, then fields)
// - `hash`: the fields' hashes folded in order, the same as a tuple of the fields
// - `clone`: a copy; `Debug` is `#[Debug]`
// A struct gets methods, an enum `#[impl]` fns; a derived type can be a `Map` key and meets
// `j3.cmp`'s `Eq`, `Ord`, `Hash`, `Clone`. A generic enum (`Opt<T>`) derives too: each instance
// has the methods when its type arguments do (`Opt<int>` yes, `Opt<SomeStructWithoutEq>` no).

module speculative.derive;

use j3.cmp.{ maxOf, sort };
use j3.data.map.Map;
use j3.io.printLn;
use j3.memory.Arena;

#[derive(Eq, Hash, Ord, Debug, Clone)]
struct Key {
    name: string;
    n: int;
}

#[derive(Eq, Hash, Ord, Debug)]
enum Shape { Dot, Circle(int), Rect(int, int) }

#[derive(Eq, Hash, Ord, Clone)]
enum Opt<T> { Some(T), None }

#[derive(Eq, Hash)]
struct Pair<A, B> {
    a: A;
    b: B;
}

fn main() {
    let a = Key { name: "x", n: 1 };
    let b = Key { name: "x", n: 2 };
    printLn(`{a == a.clone()} {a == b} {a < b} {maxOf(a, b)} {a.hash() == Key { name: "x", n: 1 }.hash()}`);
    let r = Shape.Rect(1, 2);
    printLn(`{r == Shape.Rect(1, 2)} {r < Shape.Rect(1, 3)} {Shape.Dot < r} {Shape.Circle(9) < r} {r}`);
    let shapes = [Shape.Rect(0, 1), Shape.Dot, Shape.Circle(4), Shape.Circle(2)];
    sort(shapes);
    printLn(`{shapes[0]} {shapes[1]} {shapes[2]} {shapes[3]}`);

    let arena = Arena.create(1 << 16);
    let count = Map<Key, int>.new(&arena, 8);
    count.put(a, 1);
    count.put(Key { name: "x", n: 1 }, 5);
    count.put(b, 2);
    let p = Pair<int, string> { a: 7, b: "q" };
    printLn(`len={count.len} a={count.getOr(a, 0)} pair={p == Pair<int, string> { a: 7, b: "q" }} same-as-tuple={p.hash() == (7, "q").hash()}`);
    let o: Opt<string> = Opt.Some("k");
    let none: Opt<string> = Opt.None;
    let seen = Map<Opt<int>, int>.new(&arena, 8);
    seen.put(Opt.Some(3), 1);
    seen.put(Opt.None, 2);
    printLn(`opt={o == Opt.Some("k")} {o == none} {o < none} {o.clone() == o} map={seen.getOr(Opt.Some(3), 0)}{seen.getOr(Opt.None, 0)}`);
    arena.destroy();
}
