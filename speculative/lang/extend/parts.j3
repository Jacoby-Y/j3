module speculative.extend;

extend Counter {
    fn scale(this: &Counter, k: int) { this.n *= k; }
    /// Calls a method from the struct body and one from another block.
    fn double(this: &Counter): int { return this.get() * 2; }
}

extend Box<T> {
    fn twice(this: &Box<T>): T { return this.v; }
}
