// Embedding files at compile time:
// - `const X = @embed("f")` is the file as a read-only `string` in static data
// - `@embedBytes("f")` is a `[]u8` (any bytes, NUL included)
// - `@embedDir("dir", "*.txt")` is a table `[N]{ path: string, data: string }`, sorted by path,
//   searching subfolders; `path` is below `dir`
// - a path is relative to this file, else to the package root; a missing file is a compile error
// - editing an embedded file rebuilds the program

module speculative.embed;

use j3.io.printLn;

const GREETING = @embed("embed/greeting.txt");
const BLOB = @embedBytes("embed/blob.bin");
const TEXTS = @embedDir("embed", "*.txt");

fn main() {
    printLn(`greeting {GREETING.len} bytes: {GREETING}`);
    let sum = 0;
    for i in 0..BLOB.len {
        sum = sum * 31 + int(BLOB[i]);
    }
    printLn(`blob len={BLOB.len} nul={BLOB[1]} ff={BLOB[3]} sum={sum}`);
    for i in 0..TEXTS.len {
        printLn(`{TEXTS[i].path}: {TEXTS[i].data.len}`);
    }
    let inline = @embed("embed/b.txt");
    printLn(`inline {inline}`);
}
