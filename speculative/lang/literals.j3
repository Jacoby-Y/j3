// Literal and loop gaps:
// - `match` on a `string` with string literal arms (`|` and guards work; `_` is required)
// - `let buf: [64]u8;`: a typed `let` without a value is zero-filled
// - int literals above i64::MAX where a `u64` is expected (`0xFFFFFFFFFFFFFFFF`)
// - float exponents: `1e9`, `2.5e-3`, `1E+2`
// - `<<=` and `>>=`
// - `for x in it` over an iterator: a struct with `fn next(this: &Self): Option<T>` (`j3.text`'s
//   `split(s, sep)`, `lines(s)` and `runes()` are iterators)
// - a `u64` const folds on all 64 bits (`0xFFFF_FFFF_FFFF_FFFF & X`, `/` `%` `>>` unsigned) and
//   matches as an int arm even above i64::MAX

module speculative.literals;

use j3.io.printLn;
use j3.option.Option;
use j3.text.{ lines, runes, split };

const ALL: u64 = 0xFFFFFFFFFFFFFFFF;
const HIGH: u64 = ALL & 0xFF00000000000000;
const HALF: u64 = ALL / 2 + 1;

fn bits(v: u64): string {
    match v {
        HIGH { return "high"; }
        HALF { return "half"; }
        ALL { return "all"; }
        _ { return "other"; }
    }
}

fn keyword(w: string): int {
    match w {
        "let" { return 1; }
        "fn" | "func" { return 2; }
        "if" if w.len > 5 { return 99; }
        "if" { return 3; }
        _ { return 0; }
    }
}

struct Pt { x: int; y: f32; on: bool; }

/// Counts down from `n` to 1.
struct Down {
    n: int;

    fn next(this: &Down): Option<int> {
        if this.n == 0 { return Option.None; }
        this.n -= 1;
        return Option.Some(this.n + 1);
    }
}

fn main() {
    let k = keyword("let") * 1000 + keyword("func") * 100 + keyword("if") * 10 + keyword("x");
    let tag = match "fn" { "fn" { "two" } _ { "?" } };
    printLn(`kw={k} {tag}`);

    let buf: [64]u8;
    let pts: [3]Pt;
    let sum = 0;
    for b in buf { sum += int(b); }
    pts[1].x = 4;
    printLn(`zero sum={sum} x={pts[0].x}+{pts[1].x} y={pts[2].y} on={pts[2].on}`);

    let m: u64 = 18446744073709551615;
    let hi: u64 = 0x8000000000000000;
    printLn(`u64 max={m == ALL} top={hi >> 63} low={(m & 0xFF) == 255}`);

    let big = 1e9;
    let small: f32 = 2.5e-3;
    printLn(`floats {int(big)} {int(small * 1000.0)} {int(1E+2)} {int(15e-1 * 2.0)}`);

    let s = 1;
    s <<= 4;
    let t = s;
    t >>= 2;
    printLn(`shift {s} {t}`);

    let total = 0;
    'outer: for v in Down { n: 6 } {
        if v == 5 { continue; }
        for w in Down { n: 3 } {
            if v == 2 { break 'outer; }
            total += v * w;
        }
    }
    let n = 0;
    let cps: u32 = 0;
    for cp in "aé€".runes() {
        n += 1;
        cps += cp;
    }
    printLn(`iter total={total} runes={n} sum={cps}`);

    let parts = 0;
    let longest = 0;
    for part in split("a,bb,,ccc", ",") {
        parts += 1;
        if part.len > longest { longest = part.len; }
    }
    let rows = 0;
    for line in lines("x\r\ny\n") { rows += line.len; }
    printLn(`split {parts} {longest} lines {rows} {bits(HIGH)} {bits(HALF)} {bits(ALL)} {bits(7)} {HIGH >> 56}`);
}
