// `match` as a value, `if let`, `let .. else`:
// - `let n = match op { Op.Add { 1 } Op.Sub { 2 } };` the arm's last expression, written with
//   no `;`, is its value (statements may come before it); every arm gives the same type
// - an arm that leaves (`return`, `break`, `continue`, `panic`) gives no value and fits any type
// - `if let Shape.Circle(r) = s { .. } else { .. }` is a one-arm match; a value like `if`
// - `let Shape.Circle(r) = s else { return 0; };` binds `r` after the statement; the `else`
//   must leave
// - a `match` written as a statement stays one (no `;`), with a `void` value

module speculative.match_expr;

use j3.io.printLn;

enum Op { Add, Sub, Mul }

enum Shape { Circle(int), Rect(int, int), Dot }

fn cost(op: Op): int {
    return match op {
        Op.Add { 1 }
        Op.Sub { 2 }
        Op.Mul {
            let base = 3;
            base * 2
        }
    };
}

fn digit(c: u8): string {
    let kind = match c {
        '0'..='9' { "digit" }
        ' ' | '\t' { "space" }
        _ { "other" }
    };
    return kind;
}

fn area(s: Shape): int {
    let a = match s {
        Shape.Circle(r) { 3 * r * r }
        Shape.Rect(w, h) { w * h }
        Shape.Dot { return -1; }
    };
    return a;
}

fn radius(s: Shape): int {
    let Shape.Circle(r) = s else { return 0; };
    return r;
}

fn describe(s: Shape): string {
    return if let Shape.Rect(w, h) = s {
        if w == h { "square" } else { "rect" }
    } else if let Shape.Circle(_) = s {
        "circle"
    } else {
        "dot"
    };
}

fn main() {
    printLn(`cost={cost(Op.Add) + cost(Op.Sub) + cost(Op.Mul)}`);
    printLn(`{digit('7')} {digit(' ')} {digit('x')}`);
    printLn(`area={area(Shape.Circle(2))} {area(Shape.Rect(3, 4))} {area(Shape.Dot)}`);
    printLn(`radius={radius(Shape.Circle(5))} {radius(Shape.Dot)}`);
    printLn(`{describe(Shape.Rect(2, 2))} {describe(Shape.Rect(2, 3))} {describe(Shape.Circle(1))} {describe(Shape.Dot)}`);
    let shapes: [3]Shape = [Shape.Circle(1), Shape.Dot, Shape.Rect(2, 5)];
    let total = 0;
    for s in shapes {
        if let Shape.Rect(w, h) = s {
            total += w * h;
        }
        let n = match s {
            Shape.Dot { continue; }
            _ { 1 }
        };
        total += n;
    }
    printLn(`total={total}`);
    match Op.Sub {
        Op.Add { printLn("add"); }
        _ { printLn("not add"); }
    }
}
