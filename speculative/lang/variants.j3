// Multi-field variants and struct patterns:
// - `Bin(BinOp, &Expr, &Expr)`: a variant holds several positional fields, built as
//   `Expr.Bin(op, l, r)` and matched as `Expr.Bin(op, l, r)`
// - patterns nest in any position, `_` skips a field, a literal tests one
// - `Span { lo, hi }` / `Span { lo, .. }` destructure a struct in a `match` arm or in a `let`
// - a match counts a variant as covered only when its arms cover every value of its fields
// - `#[Debug]` prints `Expr.Bin(BinOp.Add, &Expr, &Expr)`: a pointer prints as its type

module speculative.variants;

use j3.io.printLn;

#[Debug]
enum BinOp { Add, Mul }

#[Debug]
struct Span { lo: int; hi: int; }

#[Debug]
enum Expr { Bin(BinOp, &Expr, &Expr), Lit(int), Named(string, Span, bool) }

fn eval(e: &Expr): int {
    match *e {
        Expr.Bin(BinOp.Add, l, r) { return eval(l) + eval(r); }
        Expr.Bin(BinOp.Mul, l, r) { return eval(l) * eval(r); }
        Expr.Lit(n) { return n; }
        Expr.Named(_, Span { lo, .. }, true) { return lo; }
        Expr.Named(_, _, false) { return 0; }
    }
}

fn width(e: Expr): int {
    match e {
        Expr.Named(_, Span { lo, hi }, _) { return hi - lo; }
        _ { return 0; }
    }
}

fn main() {
    let two = Expr.Lit(2);
    let three = Expr.Lit(3);
    let sum = Expr.Bin(BinOp.Add, &two, &three);
    let prod = Expr.Bin(BinOp.Mul, &sum, &three);
    printLn(`eval={eval(&prod)}`);
    let name = Expr.Named("x", Span { lo: 4, hi: 9 }, true);
    printLn(`named={eval(&name)} width={width(name)}`);
    printLn(`{name}`);
    printLn(`{sum}`);
    let Span { lo, hi: end } = Span { lo: 1, hi: 7 };
    printLn(`lo={lo} end={end}`);
}
