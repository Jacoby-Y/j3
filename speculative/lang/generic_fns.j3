// Generic free fns: `fn name<T>(..)`.
// - T is inferred from the arguments, or written `name::<int>(..)`
// - a bare number takes the type of the other arguments
// - each set of types is compiled once; the body is checked per instance
// - UFCS (`xs.first()`) and closure parameters work

module speculative.generic_fns;

use j3.io.printLn;

struct Tag {
    n: int;
}

fn first<T>(xs: []T): T { return xs[0]; }
fn maxOf<T>(a: T, b: T): T { if a > b { return a; } return b; }
fn swap<T>(a: &T, b: &T) { let t = *a; *a = *b; *b = t; }
fn apply<T>(x: T, f: closure(T): T): T { return f(f(x)); }
fn count<T>(x: T, n: int): int {
    if n == 0 { return 0; }
    return 1 + count(x, n - 1);
}
fn zero<T>(): int { return 0; }

fn show(xs: []int) { printLn(`explicit={xs.first() + zero::<f32>() + 2}`); }

fn main() {
    let nums: [2]int = [4, 5];
    let fs: [2]f32 = [2.5, 3.5];
    let words: [1]string = ["hi"];
    printLn(`first={first(nums)} {first(fs)} {first(words)}`);

    let f: f32 = 2.5;
    printLn(`max={maxOf(3, 7)} {maxOf(f, 1)} {maxOf(0.5, 9.0)}`);

    let a = 1;
    let b = 2;
    swap(&a, &b);
    printLn(`swap={a} {b}`);

    let k = 3;
    printLn(`chain={count(Tag { n: 1 }, 9)} apply={apply(4, fn(v: int): int { return v * k; })} two={count(f, 2) + 3}`);

    show(nums);
}
