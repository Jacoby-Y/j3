// Shaders as J3. `#[shader(vertex)]` / `#[shader(fragment)]` fns are checked against the GPU subset and become
// GLSL text at compile time; `@shader(vs, fs)` pairs them into a `Source`. No window, no GL here: the CPU side just
// reads the text and the vertex attributes (`j3c dump-glsl speculative/lang/shader.j3` prints it). Same on both
// backends. Rules and builtins: `j3c doc shaders`; a driver-compiled example: `j3c/stdlib/tests/gpu_glsl_test.j3`.

module speculative.shader;

use j3.gpu.{ Source, attrib };
use j3.io.printLn;
use j3.math.Vec2;

#[vertex] struct Corner { at: Vec2; }
#[vertex(instance)] struct Sprite { pos: Vec2; size: Vec2; tint: vec4f; }
#[varying] struct V { position: vec4; uv: vec2; tint: vec4; }

#[uniform] let uScreen: vec2;
#[uniform] let uAtlas: sampler2D;

#[shader]
fn toNdc(p: vec2): vec4 {
    return vec4(p / uScreen * 2.0 - 1.0, 0.0, 1.0);
}

#[shader(vertex)]
fn vs(c: Corner, s: Sprite): V {
    return V { position: toNdc(s.pos + c.at * s.size), uv: c.at, tint: s.tint };
}

#[shader(fragment)]
fn fs(v: V): vec4 {
    let t = @texture(uAtlas, v.uv) * v.tint;
    if t.a < 0.01 { @discard(); }
    return t;
}

const SPRITES: Source = @shader(vs, fs);

/// A rolling hash of the bytes (wraps), so the text is compared without printing it.
fn hash(s: string): int {
    let h = 7;
    for i in 0..s.len {
        h = h * 31 + int(s[i]);
    }
    return h;
}

fn main() {
    printLn(`vert {SPRITES.vert.len} bytes, frag {SPRITES.frag.len} bytes`);
    printLn(`uniforms: {SPRITES.uniforms}`);
    printLn(`attributes: {SPRITES.count}`);
    for i in 0..SPRITES.count {
        let a = SPRITES.attrib(i);
        printLn(`  loc {a.loc} comps {a.comps} offset {a.offset} stride {a.stride} divisor {a.divisor}`);
    }
    printLn(`hash {hash(SPRITES.vert)} {hash(SPRITES.frag)}`);
}
