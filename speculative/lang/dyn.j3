// Dynamic dispatch: `dyn Trait` holds a pointer to any value whose type has the trait's methods,
// plus that type's method table. Make one from a reference (`&value`); calls go through the table.
// A `dyn` trait's methods take `this: &Self` and use `Self` nowhere else. Default bodies and
// supertrait methods work through `dyn` too. A `dyn Backend` converts to a `dyn Named` (a
// supertrait): its table holds the same type's `Named` table. `==` on two `dyn` values is an error.
module speculative.dyn;

use j3.io.printLn;
use j3.memory.{ Arena, List };

pub trait Named { fn name(this: &Self): string; }

pub trait Backend: Named {
    fn emit(this: &Self, n: int): int;
    fn lines(this: &Self): int { return this.emit(1) + 100; }
}

struct Llvm {
    calls: int;
    fn name(this: &Llvm): string { return "llvm"; }
    fn emit(this: &Llvm, n: int): int { this.calls += 1; return n * 2; }
}

struct C {
    base: int;
    fn emit(this: &C, n: int): int { return this.base + n; }
    fn lines(this: &C): int { return 7; }
}

#[impl]
fn name(x: &C): string { return "c"; }

struct Pass {
    out: dyn Backend;
    fn run(this: &Pass): int { return this.out.emit(10); }
}

fn pick(a: dyn Backend, b: dyn Backend, first: bool): dyn Backend {
    if first { return a; }
    return b;
}

fn main() {
    let l = Llvm { calls: 0 };
    let c = C { base: 5 };
    let b: dyn Backend = &l;
    printLn(`{b.name()} {b.emit(3)} {b.lines()} calls={l.calls}`);
    let mem = Arena.create(4096);
    let all = List<dyn Backend>.new(&mem);
    all.push(&l);
    all.push(&c);
    let total = 0;
    for i in 0..all.len {
        let d = all.items[i];
        total += d.emit(i);
        printLn(`{d.name()} lines={d.lines()}`);
    }
    printLn(`total={total} calls={l.calls}`);
    let p = Pass { out: &c };
    let n: dyn Named = &c;
    let up: dyn Named = all.items[0];
    printLn(`pass={p.run()} picked={pick(&l, &c, false).name()} named={n.name()} up={up.name()}`);
}
