// Char literals:
// - `'a'` is a `u8` when ASCII; a code point past ASCII (or `'\u{..}'`) is a `u32`
// - like a number literal it takes the other operand's int type (`ch == 'a'` with `ch: int`)
// - escapes: `\n \r \t \0 \\ \' \"`, `\x7f` (ASCII), `\u{1F600}`
// - `'rows:` is still a loop label: a char is one character or escape, then `'`

module speculative.chars;

use j3.io.printLn;

/// How many decimal digits lead `s`, and their value.
fn leadingInt(s: string): int {
    let v = 0;
    for i in 0..s.len {
        let ch = s[i];
        if ch < '0' || ch > '9' { break; }
        v = v * 10 + int(ch - '0');
    }
    return v;
}

fn main() {
    let a = 'a';
    let smile = '\u{1F600}';
    let e = 'é';
    printLn(`a={a} smile={smile} e={e}`);
    printLn(`{'\n'} {'\r'} {'\t'} {'\0'} {'\\'} {'\''} {'"'} {'\x7f'}`);

    let wide: int = 'A';
    let upper = a - 32;
    printLn(`wide={wide} upper={upper} same={upper == 'A'}`);
    printLn(`n={leadingInt("42 apples")}`);

    let found = 0;
    'rows: for r in 0..3 {
        for c in "x'y" {
            if c == '\'' {
                found += r;
                continue 'rows;
            }
        }
    }
    printLn(`found={found}`);

    // strings take the same escapes as chars (minus `\'`): `\x` is ASCII, `\u{..}` is written as UTF-8
    let bold = "\x1b[1m";
    let s = "\x41\u{e9}\u{1F600}";
    printLn(`bold={bold.len} {bold[0]} s={s} {s.len}`);
}
