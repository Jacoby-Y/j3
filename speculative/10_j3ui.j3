// `@j3ui` components desugar to `j3.ui` calls.

module speculative.j3ui;

use j3.game.Font;
use j3.ui.Ui;

@j3ui rowItem(ui: &Ui, name: string) {
    label(name);
}

@j3ui page(ui: &Ui) {
    panel(220, 120) {
        rowItem(ui, "one");
        rowItem(ui, "two");
        scroll(1, 40) {
            button("ok") {
            }
        }
    }
}

fn main() {
    let ui = Ui.begin(Font { raw: 0 }, 0, 0);
    page(&ui);
}
