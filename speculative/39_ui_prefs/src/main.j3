module prefs_probe;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use prefs_probe.ui.{ Screen, ScreenProps };
struct World { mode: string; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { mode: env("PREFS_MODE"), root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // PREFS_MODE: dark = dark scheme; reduced = reduced motion (the fade-in, started at frame 6, is instant);
    // motion/light = defaults. Set at frame 2, so the toggle restyles once mid-run.
    if w.frame == 2 {
        d.setColorScheme(same(w.mode, "dark"));
        d.setReducedMotion(same(w.mode, "reduced"));
    }
    w.root.render(windowSize(), ScreenProps { on: w.frame >= 6 });
    if w.frame == 40 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 40 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("prefs steady frame changed layout style or allocation"); }
    if w.frame == 50 { printLn("prefs_probe ok: scheme, reduced motion, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("prefs probe", 320, 220, boot);
    app.useGl(); app.draw(draw); app.run();
}
