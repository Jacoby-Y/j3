<script>
    use slots.state.State;
    props { state: &State; }
    let names: []string = ["a", "b"];
    fn bump() { state.clicks += 10; }
</script>
<div class="app">
    <Card title="Audio" on:ping={state.clicks += 100}>
        <button slot="actions" on:click={bump()}>Reset</button>
        <p>count {state.clicks}</p>
        <p slot="footer">Foot {state.clicks}</p>
    </Card>
    {#each names as nm, i}
        <Card title={nm}>
            <span>item {nm} {i}</span>
            <Row n={i} />
            <button slot="actions" on:click={state.clicks += 1000}>x</button>
        </Card>
    {/each}
    <Card title="Outer">
        <Card title="Inner"><span>deep {state.clicks}</span></Card>
    </Card>
    <Card title="Empty" />
    <Tag />
    <Tag label="given" size={2}><p slot="footer">f</p></Tag>
    <Tag><p>body</p></Tag>
    <Panel on={state.clicks > 5} on:done={state.clicks += 5000}><span>passed {state.clicks}</span></Panel>
    <Modal open={state.show}><Probe state={state} /></Modal>
    {#each names as mn, mi}
        <Modal open={state.show}><Probe state={state} /></Modal>
    {/each}
</div>
