<script>
    props { on: bool; }
    events { done; }
</script>
<div>
    <Card title="Pnl">
        {#each 2..4 as q}
            {#if on}
                <Row n={q} />
            {/if}
        {/each}
        <button slot="actions" on:click={emit done}>done</button>
        <slot />
    </Card>
</div>
