// Plan 023 stage 1 (slots) at runtime: default, named and fallback slots, a slot in an {#each} that
// reads the loop variable, a Card inside a Card, slot content that emits an event of its owner, and
// a slot passed on through a second component, and slot content destroyed when its child hides the slot.
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 20 j3c run speculative/14_ui_slots --headless
// Prints PASS/FAIL lines; exit code 1 on a failure.

module slots;

use slots.state.State;
use slots.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.ui.testkit.{ clickTag, countText, hasText };

struct World {
    state: State;
    root: Screen;
    frame: int;
    fails: int;
}

fn boot(mem: &Arena): World {
    return World { state: State {}, root: Screen.new(mem), frame: 0, fails: 0 };
}

fn check(w: &World, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        w.fails += 1;
    }
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    let d = &w.root.dom;
    w.frame += 1;
    if w.frame == 3 {
        check(w, hasText(d, "Foot 0"), "named slot with parent state");
        check(w, hasText(d, "Default footer"), "fallback content");
        check(w, hasText(d, "item b 1"), "slot in {#each} reads item and index");
        check(w, hasText(d, "deep 0"), "Card inside Card");
        check(w, hasText(d, "row 1 h0"), "component inside slot content in an {#each}");
    }
    if w.frame == 3 {
        check(w, hasText(d, "dflt 7") && hasText(d, "given 2"), "omitted props use their default, given ones win");
        check(w, countText(d, "has footer") == 1 && countText(d, "has body") == 1, "$slots is true only at the sites that fill the slot");
    }
    clickTag(d, w.frame, 4, "button", 0);
    if w.frame == 8 {
        check(w, w.state.clicks == 10, "click on a slotted button runs the parent's fn");
        check(w, hasText(d, "Foot 10") && hasText(d, "count 10"), "slot content follows parent state");
    }
    clickTag(d, w.frame, 9, "button", 3);
    if w.frame == 13 {
        check(w, w.state.clicks == 5010, "emit from slot content reaches the owner's handler");
        check(w, hasText(d, "row 2 h0") && hasText(d, "passed 5010"), "slot passed through a second component");
    }
    // a child that stops rendering its <slot> destroys the owner's slot content (Svelte), and shows it fresh
    if w.frame == 14 {
        check(w, w.state.mounts == 3 && w.state.destroys == 0, "slot content mounted once while shown");
        w.state.show = false;
    } else if w.frame == 17 {
        check(w, w.state.mounts == 3 && w.state.destroys == 3, "hiding the slot destroys its content once (also in an {#each})");
        w.state.show = true;
    } else if w.frame == 20 {
        check(w, w.state.mounts == 6 && w.state.destroys == 3, "showing the slot again mounts fresh content");
        if w.fails == 0 {
            printLn("all passed");
        }
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
}

fn main() {
    let app = App<World>.create("slots", 640, 480, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
