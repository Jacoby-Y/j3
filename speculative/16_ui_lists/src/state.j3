module lists.state;

use j3.memory.Arena;

pub struct Item {
    id: int;
    name: string;
}

pub struct Group {
    id: int;
    rows: []Item;
}

pub struct State {
    rows: []Item;
    groups: []Group;
    outer: []Group;
    mixed: []Item;
    extra: []Item;
    cards: []Item;
    fades: []Item;
    flag: bool = false;
    mounts: int = 0;
    destroys: int = 0;
    nextBirth: int = 0;
    /// birth number of the Row instance showing item `id` (0 = none): equal across frames only if the instance followed its key
    birth: []int;

    fn new(mem: &Arena): State {
        return State { rows: mem.alloc::<Item>(0), groups: mem.alloc::<Group>(0), outer: mem.alloc::<Group>(0), mixed: mem.alloc::<Item>(0), extra: mem.alloc::<Item>(0), cards: mem.alloc::<Item>(0), fades: mem.alloc::<Item>(0), birth: mem.alloc::<int>(4096) };
    }
}
