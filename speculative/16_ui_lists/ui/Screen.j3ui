<script>
    use lists.state.State;
    props { state: &State; }
</script>
<div>
    <div class="rows">
        {#each state.rows as it (it.id : int)}
            <Row state={state} item={it} />
        {/each}
    </div>
    <div class="groups">
        {#each state.groups as g (g.id)}
            <section>
                {#each g.rows as gr (gr.id)}
                    <Row state={state} item={gr} />
                {/each}
            </section>
        {/each}
    </div>
    <div class="outer">
        {#each state.outer as og}
            <section>
                {#each og.rows as oi (oi.id)}
                    <Row state={state} item={oi} />
                {/each}
            </section>
        {/each}
    </div>
    <div class="mixed">
        {#each state.mixed as m (m.id)}
            {#if m.id % 2 == 0}<small>e</small>{/if}
            <p class="row"><span>{m.name}</span></p>
            {#if m.id % 3 == 0}<h2>t</h2>{/if}
        {/each}
    </div>
    <div class="gated">
        {#if state.flag}
            {#each state.extra as ex (ex.id)}
                <Row state={state} item={ex} />
            {/each}
        {/if}
    </div>
    <div class="cards">
        {#each state.cards as cd (cd.id)}
            <Card><Row state={state} item={cd} /></Card>
        {/each}
    </div>
    <div class="fades">
        {#each state.fades as fd (fd.id)}
            <p class="row" transition:fade={80}><span>{fd.name}</span></p>
        {/each}
    </div>
</div>
