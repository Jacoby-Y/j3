<script>
    use lists.state.{ State, Item };
    props { state: &State; item: Item; }
    let born = 0;
    fn onMount() { state.nextBirth += 1; born = state.nextBirth; state.mounts += 1; }
    fn onFrame(dt: f32) { state.birth[item.id] = born; }
    fn onDestroy() { state.destroys += 1; }
</script>
<p class="row">{#if item.id % 2 == 0}<small>e</small>{/if}<span>{item.name}</span></p>
