module uistacking;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use uistacking.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; builds: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { root: root, mode: env("STACK_MODE"), frame: 0, builds: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    // hover: the pointer over where the z 9999 box and the z 2 card overlap: the card is hit (and outlined), as it is painted on top
    if same(w.mode, "hover") && w.frame >= 3 {
        d.simInput(65.0, 50.0, false, 0.0);
    } else {
        d.simInput(-5.0, -5.0, false, 0.0);
    }
    w.root.render(windowSize(), ScreenProps { });
    if w.frame == 40 { w.builds = d.stackBuilds; }
    if w.frame > 40 && d.stackBuilds != w.builds { panic("uistacking idle frame rebuilt the stacking lists"); }
    if same(w.mode, "hover") && w.frame == 10 && d.hover < 0 { panic("uistacking hover found nothing"); }
    if w.frame == 100 { printLn("uistacking ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uistacking", 640, 330, boot);
    app.useGl(); app.draw(draw); app.run();
}
