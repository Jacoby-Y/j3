// Structs, methods, and operators. Data is explicit and POD-like.
// Notes:
// - `Vec2` would live in stdlib later; defined here to show the mechanism
// - operators are sugar over functions, not compiler magic
// - `.` auto-derefs pointers (convenient implicit)
// - `fn` on a method with `this: &T` auto-takes `&` at the call site

module speculative.data;

use j3.io.printLn;
use j3.math.sqrt;

#[Debug]
struct Vec2 {
    x: f32;
    y: f32;

    fn operator+(this: Vec2, other: Vec2) {
        return Vec2 {
            x: this.x + other.x,
            y: this.y + other.y,
        };
    }

    fn operator-(this: Vec2, other: Vec2) {
        return Vec2 {
            x: this.x - other.x,
            y: this.y - other.y,
        };
    }

    fn operator*(this: Vec2, s: f32) {
        return Vec2 {
            x: this.x * s,
            y: this.y * s,
        };
    }

    // by-value `this` — small structs are copied
    fn length(this: Vec2) {
        return sqrt(this.x * this.x + this.y * this.y);
    }

    // pointer `this` — in-place update; `.` is a place, not a copy
    fn scale(this: &Vec2, s: f32) {
        this.x *= s;
        this.y *= s;
    }
}

struct Entity {
    pos: Vec2;
    vel: Vec2;
}

fn main() {
    let pos = Vec2 { x: 10, y: 10 };
    let vel = Vec2 { x: 2, y: -1 };

    let next = pos + vel;
    let offset = next - pos;
    let doubled = offset * 2;
    let len = doubled.length();

    doubled.scale(0.5);

    let player = Entity {
        pos: next,
        vel: vel,
    };

    printLn(`len={len} player.pos={player.pos}`);
}
