// Plan 023 stage 12b: caret, selection rectangles and hit test in mixed-direction text (golden `sel`).
module rtl;

use j3.app.App;
use j3.game.{ textShaping, tryLoadFont, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use rtl.ui.{ Screen, ScreenProps };

struct World { root: Screen; frame: int; ta: int; }

fn boot(mem: &Arena): World {
    if tryLoadFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 16).raw == 0 || !textShaping() {
        printLn("FAIL: speculative/31_ui_rtl needs DejaVu Sans and HarfBuzz in SDL_ttf (the golden cannot be checked)");
        sys.exit(1);
    }
    return World { root: Screen.new(mem), frame: 0, ta: -1 };
}

fn draw(w: &World) {
    let d = &w.root.dom;
    if w.frame == 2 {
        for i in 0..d.nodes.len {
            if d.nodes.items[i].tag == d.tInput && w.ta < 0 { w.ta = i; }
        }
        d.focusNode(w.ta);
    } else if w.frame == 4 {
        // select "c " and the first hebrew letter: bytes 2..6 of "abc אבג def"
        let e = &d.eds.items[d.nodes.items[w.ta].edit];
        e.anc = 2;
        e.cur = 6;
    }
    w.root.render(windowSize(), ScreenProps { a: "abc אבג def", b: "abc אבג def سلام hello עברית world, a long mixed line that wraps" });
    w.frame += 1;
}

fn main() {
    let app = App<World>.create("rtl", 360, 180, boot);
    app.useGl(); app.draw(draw); app.run();
}
