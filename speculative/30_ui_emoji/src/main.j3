// Plan 023 stage 12a: color emoji scaled to the font size, inline with text at 16 and 32 px (golden `emoji`).
module emoji;

use emoji.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.{ tryLoadFont, windowSize };
use j3.io.printLn;
use j3.sys;
use j3.memory.Arena;

struct World { root: Screen; }

fn boot(mem: &Arena): World {
    if tryLoadFont("/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf", 16).raw == 0 {
        printLn("FAIL: speculative/30_ui_emoji needs Noto Color Emoji at /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf (not installed; the golden cannot be checked)");
        sys.exit(1);
    }
    return World { root: Screen.new(mem) };
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { n: 0 });
}

fn main() {
    let app = App<World>.create("emoji", 360, 180, boot);
    app.useGl(); app.draw(draw); app.run();
}
