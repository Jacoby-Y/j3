// A 100 KB string as a text node, a `title`, and inside mixed text and a mixed `title`: no
// "string interpolation overflowed" abort, and nothing to do once it is up (rc 0, `layouts=0`):
//   J3_FIXED_DT=0.016 J3_STEADY=60:120 j3c run speculative/70_ui_bigtext --frames 130 --headless
// (`J3_FIXED_DT`: without it, slow first frames shift clock-driven work into the 60..120 window.)

module bigtext;

use bigtext.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;
use j3.text.Text;

struct World {
    big: string;
    root: Screen;
}

fn boot(mem: &Arena): World {
    let t = Text.new(mem);
    for i in 0..100 * 1024 { t.push(u8(97 + i % 26)); }
    return World { big: t.str(), root: Screen.new(mem) };
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { text: w.big, n: w.big.len });
}

fn main() {
    let app = App<World>.create("bigtext", 640, 360, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
