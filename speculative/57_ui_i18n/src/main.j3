module uii18n;
use j3.app.App;
use j3.game.{ clearTo, env, Color, windowSize };
use j3.i18n;
use j3.io.printLn;
use j3.memory.Arena;
use j3.text.same;
use uii18n.ui.{ Screen, ScreenProps };
struct World { root: Screen; frame: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    let loc = env("LOCALE");
    if loc.len > 0 { i18n.setLocale(loc); }
    return World { root: root, frame: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    w.root.render(windowSize(), ScreenProps { n: 3 });
    // locale switch at run time, once: the next frame shows the new strings and later frames cost nothing
    if w.frame == 2 && same(env("LOCALE"), "") { i18n.setLocale("de"); }
    if w.frame == 100 { printLn("uii18n ok"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uii18n", 360, 200, boot);
    app.useGl(); app.draw(draw); app.run();
}
