<script>
    use j3.i18n;
    use j3.i18n.{ t, tf, tf2, num };
    props { n: int; }
</script>
<div class="page" class:rtl={i18n.rtl()}>
    <h1>{t("app.title")}</h1>
    <div class="row"><span>{t("app.stock")}</span><span>{i18n.fmtNum(1234567)}</span></div>
    <p>{tf("shop.items", num(n))}</p>
    <p>{tf("shop.total", num(n * 100))}</p>
    <div class="row"><button>{t("shop.buy")}</button></div>
</div>
