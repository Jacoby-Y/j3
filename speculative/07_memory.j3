// Memory. Decisions in this file:
// - no GC. stack values never heap-allocate
// - heap only through an `Arena` (stdlib, backed by a malloc syscall)
// - `arena.alloc::<T>(n)` — type args are monomorphized, not runtime
// - `checkpoint` / `rewind` cheap; games rewind frame scratch every tick
// - entities are `int` indices, not pointers (survives compact/reset better)
// - `List<T>` is a growable slice that pulls from an arena
// - no capturing closures; fn pointers only if you need callbacks
// - nothing here is a compiler builtin except taking `&` / sizeof-for-alloc

module speculative.memory;

use j3.io.printLn;
use j3.memory.{ Arena, List };

struct Vec2 {
    x: f32;
    y: f32;
}

struct World {
    pos: []Vec2;
    vel: []Vec2;
    count: int;
}

fn spawn(world: &World, p: Vec2, v: Vec2): int {
    let id = world.count;
    world.pos[id] = p;
    world.vel[id] = v;
    world.count += 1;
    return id;
}

fn main() {
    // Arena is a small header (ptr/used/cap) over one malloc'd block
    let mem = Arena.create(16 * 1024 * 1024);
    defer mem.destroy();

    // alloc bump-carves a slice out of that block; World stores views, not copies
    let world = World {
        pos: mem.alloc::<Vec2>(256),
        vel: mem.alloc::<Vec2>(256),
        count: 0,
    };

    // id is an index into the SoA arrays, not a pointer
    let player = spawn(&world, Vec2 { x: 0, y: 0 }, Vec2 { x: 1, y: 0 });

    // snapshot `used` so later scratch can be thrown away without touching world
    let frame = mem.checkpoint();
    defer mem.rewind(frame); // LIFO: rewind runs before destroy

    // List grows by allocating from `mem` — this is after the checkpoint, so scratch
    let hits = List<int>.new(&mem);
    hits.push(player);

    printLn(`entities={world.count} hits={hits.len}`);
    // end of main: rewind frees hits, world slices stay valid, then destroy
}
