// Plan 023 stage 7b at runtime: `emit` in a script `fn` (called from two handlers, transitively, and from onMount).
// Headless:  SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 20 j3c run speculative/28_ui_emit_fn --headless --frames 20
module emitfn;

use emitfn.state.State;
use emitfn.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.dom.Dom;

struct World { mem: &Arena; state: State; root: Screen; frame: int; fails: int; }

fn boot(mem: &Arena): World {
    return World { mem: mem, state: State {}, root: Screen.new(mem), frame: 0, fails: 0 };
}

fn check(w: &World, ok: bool, what: string) {
    if ok { printLn(`PASS {what}`); } else { printLn(`FAIL {what}`); w.fails += 1; }
}

fn button(d: &Dom, k: int): int {
    let seen = 0;
    let t = d.tag("button");
    for i in 0..d.nodes.len {
        if d.nodes.items[i].tag == t {
            if seen == k { return i; }
            seen += 1;
        }
    }
    return -1;
}

fn click(w: &World, f0: int, k: int) {
    let d = &w.root.dom;
    let id = button(d, k);
    let x = d.absX(id) + 3.0;
    let y = d.absY(id) + 3.0;
    if w.frame == f0 { d.simInput(x, y, false, 0.0); }
    else if w.frame == f0 + 1 { d.simInput(x, y, true, 0.0); }
    else if w.frame == f0 + 2 { d.simInput(x, y, false, 0.0); }
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
    let s = &w.state;
    click(w, 3, 0);
    click(w, 8, 1);
    click(w, 13, 2);
    w.frame += 1;
    if w.frame == 3 {
        check(w, s.mounted == 1, "an emit in onMount reaches the parent once");
    }
    if w.frame == 8 {
        check(w, s.sum == 7 && s.pings == 1 && s.ons == 1 && same(s.last, "t"), "a fn emits int, string and bool payloads");
    }
    if w.frame == 13 {
        check(w, s.sum == 8 && s.pings == 2 && s.dones == 1,  "a fn that calls an emitting fn emits both");
    }
    if w.frame == 20 {
        check(w, s.sum == 17 && s.pings == 3 && s.dones == 1 && s.mounted == 1, "a second handler calling the same fn; nothing repeats");
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
}

fn main() {
    let app = App<World>.create("emitfn", 640, 480, boot);
    app.useGl(); app.draw(draw); app.run();
}
