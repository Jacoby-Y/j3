<script>
    events { ping(n: int, tag: string, on: bool); mounted; done; }

    fn send(n: int) { emit ping(n, "t", true); }
    fn finish() { emit done; }
    fn twice() { send(1); finish(); }
    fn onMount() { emit mounted; }
</script>
<div>
    <button on:click={send(7)}>a</button>
    <button on:click={twice()}>b</button>
    <button on:click={send(9)}>c</button>
</div>
