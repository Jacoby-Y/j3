// Plan 027 chunk 10: `<glyph>` input prompts. Needs DejaVu Sans (setFallbackFont; it has the PlayStation symbols) and, for psplain, Open Sans (it has not). States: rest (keyboard keycaps);
// pad (xbox pill labels after a pad press); ps (the same with `setGlyphStyle("playstation")`); psplain (ps in a font without the symbols: Cross, Circle, ...). The mouse stays parked, so the pad mode holds.
module uiglyph;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color, env };
use j3.text.same;
use j3.memory.Arena;
use j3.ui.padin;
use uiglyph.ui.{ Screen, ScreenProps };
struct World { root: Screen; mode: string; frame: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    let mode = env("GLYPH_MODE");
    // psplain: Open Sans has no PlayStation symbols, so the face buttons are named
    let font = if same(mode, "psplain") { "/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf" } else { "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" };
    root.dom.setFallbackFont(font);
    if same(mode, "ps") || same(mode, "psplain") { root.dom.setGlyphStyle("playstation"); }
    return World { root: root, mode: mode, frame: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    if w.mode.len > 0 && !same(w.mode, "rest") {
        if w.frame == 3 { d.setPad(padin.parse("LB")); }
        if w.frame == 5 { d.setPad(padin.parse("")); }
    }
    w.root.render(windowSize(), ScreenProps { });
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("uiglyph", 420, 230, boot);
    app.useGl(); app.draw(draw); app.run();
}
