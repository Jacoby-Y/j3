module urlvar;
use j3.app.App;
use j3.game.{ env, windowSize, clearTo, Color };
use j3.text.same;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use urlvar.ui.{ Screen, ScreenProps };
struct World { mode: string; root: Screen; frame: int; used: int; laid: int; styles: int; loads: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    return World { mode: env("THEME_MODE"), root: root, frame: 0, used: 0, laid: 0, styles: 0, loads: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // flip the scheme every frame for a while (each flip swaps --tile), then settle on the state's own
    if w.frame >= 2 && w.frame < 20 { d.setColorScheme(w.frame % 2 == 0); }
    if w.frame == 20 { d.setColorScheme(same(w.mode, "dark")); }
    w.root.render(windowSize(), ScreenProps {});
    if w.frame == 40 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; w.loads = d.imgs.ents.len; }
    if w.frame > 40 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("urlvar steady frame changed layout style or allocation"); }
    // frame, dots, stripes: once each however often the scheme flipped
    if w.frame > 40 && d.imgs.ents.len != w.loads { panic("urlvar loaded a texture after the flips"); }
    if w.frame == 50 { printLn(`urlvar ok: {d.imgs.ents.len} textures loaded in total (3 paths)`); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("urlvar", 700, 330, boot);
    app.useGl(); app.draw(draw); app.run();
}
