module drag_probe;
use j3.app.App;
use j3.game.{ windowSize, clearTo, Color };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.testkit;
use drag_probe.ui.{ Screen, ScreenProps };
struct World { cells: []int; root: Screen; frame: int; used: int; laid: int; styles: int; }
fn boot(mem: &Arena): World {
    let root = Screen.new(mem);
    root.dom.setFrameMs(16.0);
    root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
    let cells = mem.alloc::<int>(8);
    for i in 0..8 { cells[i] = 0; }
    cells[0] = 1; cells[1] = 2; cells[2] = 3;
    return World { cells: cells, root: root, frame: 0, used: 0, laid: 0, styles: 0 };
}
fn draw(w: &World) {
    clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    let d = &w.root.dom;
    d.simInput(-5.0, -5.0, false, 0.0);
    // frames 6..11: drag "Sword" (slot 0) onto slot 5, the 12th `div` (screen, title, grid, then slot 0 and its item, ...)
    testkit.drag(d, w.frame, 6, testkit.textNode(d, "Sword"), testkit.tagNode(d, "div", 11));
    w.root.render(windowSize(), ScreenProps { cells: w.cells });
    if w.frame == 16 && (w.cells[5] != 1 || w.cells[0] != 0) { panic("the drop did not move the sword"); }
    if w.frame == 25 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
    if w.frame > 25 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("drag steady frame changed layout style or allocation"); }
    if w.frame == 40 { printLn("drag_probe ok: item drag, drop, steady frames"); }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("drag probe", 340, 200, boot);
    app.useGl(); app.draw(draw); app.run();
}
