<script>
    props { cells: []int; }
    fn label(v: int): string { return if v == 1 { "Sword" } else if v == 2 { "Bow" } else if v == 3 { "Potion" } else { "" }; }
    fn move(from: int, to: int) {
        if from != to && cells[to] == 0 {
            cells[to] = cells[from];
            cells[from] = 0;
        }
    }
</script>
<div class="screen">
    <div class="title">Inventory</div>
    <div class="grid">
        {#each 0..8 as i}
            <div class="slot" on:drop={move(dragId, i)}>
                {#if cells[i] != 0}
                    <div class="item" draggable drag-id={i}>{label(cells[i])}</div>
                {/if}
            </div>
        {/each}
    </div>
</div>
<style>
    .screen { width: 320px; padding: 10px; color: #ffffff; font-size: 14px; user-select: none; }
    .title { margin-bottom: 8px; color: #a0b0d0; }
    .grid { display: flex; flex-wrap: wrap; gap: 6px; }
    .slot { width: 66px; height: 54px; background: #20243a; border: 2px solid #3a4060; border-radius: 6px; }
    .slot:drop-target { border-color: #ffd040; background: #384060; }
    .item { width: 62px; height: 50px; background: #3050a0; border-radius: 4px; text-align: center; padding-top: 16px; box-sizing: border-box; cursor: grab; }
    .item:dragging { opacity: 0.35; }
</style>
