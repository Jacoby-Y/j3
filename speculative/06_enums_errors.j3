// Enums, tagged unions, errors. Decisions in this file:
// - C-like enums *and* tagged unions; both are `enum`
// - payloadless enum is i32; any payload → tagged union
// - variants are namespaced (`Dir.N`), not dumped into scope
// - `Option<T>` / `Result<T, E>` are stdlib; `?` is `#[TryCatch]`, not Result-by-name
// - `match` is exhaustive
// - no null, no exceptions, no `try`
// - `panic` is a stdlib abort syscall, not a language keyword

module speculative.enums_errors;

use j3.io.printLn;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;

enum Dir {
    N, E, S, W
}

enum IoError {
    NotFound,
    Permission,
}

fn heading(dir: Dir): string {
    match dir {
        Dir.N { return "north"; }
        Dir.E { return "east"; }
        Dir.S { return "south"; }
        Dir.W { return "west"; }
    }
}

fn find(xs: []int, want: int): Option<int> {
    for n in xs {
        if n == want {
            return Option.Some(n);
        }
    }
    return Option.None;
}

fn loadName(): Result<string, IoError> {
    return Result.Err(IoError.NotFound);
}

fn greet(): Result<string, IoError> {
    let name = loadName()?;
    return Result.Ok(`hello {name}`);
}

fn main() {
    printLn(heading(Dir.N));

    let xs: [3]int = [1, 2, 3];
    match find(xs[:], 2) {
        Option.None { printLn("miss"); }
        Option.Some(n) { printLn(`hit {n}`); }
    }

    match greet() {
        Result.Ok(msg) { printLn(msg); }
        Result.Err(IoError.NotFound) { printLn("missing"); }
        Result.Err(_) { panic("unexpected io"); }
    }
}
