// Headless generated mixed-message check: switches, invalid indices, keyed moves, slots and passthrough.
module dynamic;
use dynamic.state.{ State, Msg };
use dynamic.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;
use j3.ui.dom.{ Dom, K_TEXT };

struct World { mem: &Arena; state: State; root: Screen; frame: int; fails: int; saved: []int; }
fn boot(mem: &Arena): World {
    let rows = mem.alloc::<Msg>(3);
    for i in 0..3 { rows[i] = Msg { id: i, kind: i }; }
    return World { mem: mem, state: State { rows: rows, single: Msg { id: 3, kind: 0 }, birth: mem.alloc::<int>(4) }, root: Screen.new(mem), frame: 0, fails: 0, saved: mem.alloc::<int>(4) };
}
fn check(w: &World, ok: bool, what: string) {
    if ok { printLn(`PASS {what}`); } else { printLn(`FAIL {what}`); w.fails += 1; }
}
fn count(d: &Dom, text: string): int {
    let n = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_TEXT && same(d.textOf(i), text) { n += 1; }
    }
    return n;
}
fn draw(w: &World) {
    let s = &w.state;
    if w.frame == 1 {
        let tmp = s.rows[0]; s.rows[0] = s.rows[2]; s.rows[2] = tmp;
    } else if w.frame == 2 {
        s.rows[1].kind = 2; s.choice = 1;
    } else if w.frame == 3 { s.rows[1].kind = -1;
    } else if w.frame == 4 { s.rows[1].kind = 99;
    } else if w.frame == 5 { s.rows[1].kind = 1; s.choice = 2;
    } else if w.frame == 8 {
        w.saved[3] = s.birth[3]; s.choice = 0;
    } else if w.frame == 9 {
        w.saved[2] = s.birth[3]; s.choice = 2;
    } else if w.frame == 10 { w.saved[1] = s.birth[3]; s.choice = 0;
    } else if w.frame == 11 { w.saved[0] = s.birth[3]; s.choice = 1; }
    w.root.render(windowSize(), ScreenProps { state: s });
    let d = &w.root.dom;
    if w.frame == 0 {
        check(w, s.mounts == 4 && s.destroys == 0, "all integer candidates and enum selector mount");
        check(w, count(d, "TextMsg") == 2 && count(d, "ImageMsg") == 1 && count(d, "Embed") == 1, "mixed message kinds render");
        check(w, count(d, "body") == 4 && count(d, "footer") == 4, "default and named slots reach every candidate");
        let roots = 0;
        for i in 0..d.nodes.len {
            if d.nodes.items[i].tag == d.tag("section") {
                let size = d.size(i);
                if size.x > 122.9 && size.x < 123.1 && size.y > 23.9 && size.y < 24.1 { roots += 1; }
            }
        }
        check(w, roots == 4, "class and style passthrough reach every candidate");
        for i in 0..4 { w.saved[i] = s.birth[i]; }
    } else if w.frame == 1 {
        let stable = true;
        for i in 0..4 { if w.saved[i] != s.birth[i] { stable = false; } }
        check(w, stable && s.mounts == 4 && s.destroys == 0, "keyed moves preserve selected component state");
    } else if w.frame == 2 {
        check(w, s.mounts == 6 && s.destroys == 2, "int and enum switches destroy and remount");
        check(w, s.birth[1] != w.saved[1] && s.birth[3] != w.saved[3], "switches discard old local state");
    } else if w.frame == 3 {
        check(w, s.mounts == 6 && s.destroys == 3 && count(d, "footer") == 3, "negative index is empty and destroys old arm");
    } else if w.frame == 4 {
        check(w, s.mounts == 6 && s.destroys == 3 && count(d, "footer") == 3, "out-of-range index remains empty");
    } else if w.frame == 5 {
        check(w, s.mounts == 8 && s.destroys == 4 && count(d, "footer") == 4, "re-entry mounts fresh and enum selects third candidate");
        check(w, s.birth[1] != w.saved[1], "returning to first candidate does not revive state");
    } else if w.frame == 7 {
        check(w, s.mounts == 8 && s.destroys == 4, "idle does not remount");
        check(w, s.selects == 8, "selector evaluated once per update");
    } else if w.frame == 8 {
        // 14: a switched-away arm is reset in place when it is chosen again; inject, slots and local state must all come back
        check(w, s.mounts == 9 && s.destroys == 5, "single: Embed -> TextMsg destroys one and mounts one");
        check(w, s.birth[3] != w.saved[3] && count(d, "TextMsg") == 2 && count(d, "Embed") == 1 && count(d, "footer") == 4, "single: TextMsg arm has its slots and fresh state");
    } else if w.frame == 9 {
        check(w, s.mounts == 10 && s.destroys == 6 && s.birth[3] != w.saved[2], "single: back to Embed (reset, fresh state, inject resolved)");
        check(w, count(d, "Embed") == 2 && count(d, "footer") == 4 && count(d, "body") == 4, "single: Embed arm has its slots again");
    } else if w.frame == 10 {
        check(w, s.mounts == 11 && s.destroys == 7 && s.birth[3] != w.saved[1] && s.birth[3] != w.saved[3], "single: TextMsg again, a third distinct state");
    } else if w.frame == 11 {
        check(w, s.mounts == 12 && s.destroys == 8 && count(d, "footer") == 4 && s.birth[3] != w.saved[0], "single: ImageMsg after the others");
    } else if w.frame == 13 {
        check(w, s.mounts == 12 && s.destroys == 8, "idle after the switches mounts nothing");
        w.root.destroy();
        check(w, s.destroys == 12, "root destruction destroys each live arm once");
        sys.exit(if w.fails == 0 { 0 } else { 1 });
    }
    w.frame += 1;
}
fn main() {
    let app = App<World>.create("dynamic", 640, 480, boot);
    app.useGl(); app.draw(draw); app.run();
}
