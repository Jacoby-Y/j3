<script>
    use dynamic.state.{ State, Msg };
    props { msg: Msg; }
    inject state: &State;
    let birth: int = 0;
    fn onMount() { state.mounts += 1; state.next += 1; birth = state.next; state.birth[msg.id] = birth; }
    fn onFrame(dt: f32) { state.birth[msg.id] = birth; }
    fn onDestroy() { state.destroys += 1; }
</script>
<section><p>Embed</p><slot/><slot name="footer"/></section>
