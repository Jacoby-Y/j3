<script>
    use dynamic.state.State;
    props { state: &State; }
    provide state;
    fn kind(): Of_TextMsg_ImageMsg_Embed {
        state.selects += 1;
        if state.choice == 0 { return Of_TextMsg_ImageMsg_Embed.TextMsg; }
        if state.choice == 1 { return Of_TextMsg_ImageMsg_Embed.ImageMsg; }
        return Of_TextMsg_ImageMsg_Embed.Embed;
    }
</script>
<div>
    {#each state.rows as msg (msg.id)}
        <component this={msg.kind} of={TextMsg, ImageMsg, Embed} msg={msg} class="wide" style:height={24.0}>
            <span>body</span><span slot="footer">footer</span>
        </component>
    {/each}
    <component this={kind()} of={TextMsg, ImageMsg, Embed} msg={state.single} class="wide" style:height={24.0}><span>body</span><span slot="footer">footer</span></component>
</div>
<style>.wide { width: 123px; }</style>
