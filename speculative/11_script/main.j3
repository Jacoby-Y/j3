module script_demo;

use scene.{ Scene, Node };
use j3.io.printLn;

const Door = @script("scripts/door.j3s");

fn main() {
    let scene = Scene { angles: [0.0, 0.0, 0.0, 0.0] };
    let front = Door { hinge: Node { id: 1 } };
    let vault = Door { hinge: Node { id: 2 }, openAngle: 120.0, seconds: 2.0 };
    vault.toggle();
    front.toggle();
    for i in 0..10 {
        front.update(&scene, 0.1);
        vault.update(&scene, 0.1);           // separate state, same code
    }
    front.toggle();
    front.update(&scene, 0.1);
    front.report();
    vault.report();
    let shed = @script("scripts/door.j3s") { hinge: Node { id: 3 } };
    shed.toggle();
    shed.update(&scene, 0.25);
    shed.report();
    printLn(`angles {scene.angles[1]} {scene.angles[2]} {scene.angles[3]}`);
}
