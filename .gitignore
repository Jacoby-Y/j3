# cargo (`j3c/target`) and `j3c build` (`target/<name>` in a package); also holds every
# project's editor state (`target/j3-editor/`), goldens output, logs. Covers examples/.
target/

# runtime saves
*.save

# packed editor extension
*.vsix

# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# editor leftovers
.idea/
*.swp
*~

# personal agent settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Steamworks SDK (never commit Valve files)
**/steamworks_sdk*/
**/steamworks_sdk*.zip

# release packages (tools/release/package.sh)
/dist/
