// `j3c editor`: build the bundled editor program and open a project; its stdout protocol and the game it plays.
//
// Port of: j3c/src/editor/mod.rs, (editor/frontend.rs `note_open`, `project_lock`)
// J3: Headless scene ops (`scene/ops.runTool`) run the built editor program in its `cli` mode, as a
// subprocess, so j3c-boot links no SDL2/GL. The open editor is reached through Rust's file protocol (`target/j3-editor/events`
// + `replies`, the `lock` try-lock): `j3.instance` to the editor (B12.2) needs an edit in the frozen
// `j3c/editor/src`, so it is deferred (contracts-c5.md). Never run in tests (it opens a window).
// J3: Deferred (user, 2026-11-18): not ported yet; stubs keep their signatures. See plans/12-deferred-tools.md.
module j3c.editor;

use j3c.base.diag;

/// `j3c editor [--new [--fps]] [DIR]`: Rust `editor::cmd`.
pub fn editorCmd(rest: []string): int { return diag.notPortedCmdHelp("editor", "not in this j3c build yet (plans/12-deferred-tools.md); edit scenes with `j3c -e scene --help` and look with `j3c -e render --help`"); } // STUB EDDEV
