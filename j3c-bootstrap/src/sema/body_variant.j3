// Enum constructors: `E.V`, `E.V(x)`, `E.V(a, b)` and the `E` / `alias.E` base that names the enum.
//
// Part of module j3c.sema.
// Port of: check/lower/enums.rs (enum_ctor_name, ctor_enum_id, find_variant, construct_variant)
// J3: Split from `body_call.j3` (wave 10, the 600-line limit). Generic enums go to `gen_call.genVariant`.
module j3c.sema;

extend BodyCx {
    /// Rust `enum_ctor_name`: `E` or `alias.E` naming an enum (the base of `E.V`).
    fn enumCtor(this: &BodyCx, e: Id<Expr>): Option<Id<EnumDecl>> {
        match this.cx.ast.expr(e) {
            Expr.Name(n) {
                match this.lookupName(n.name) {
                    Option.Some(r) { if r.kind == DeclKind.Enum { return Option.Some(r.asEnum()); } }
                    Option.None {}
                }
            }
            Expr.Field(f) {
                match this.cx.ast.expr(f.base) {
                    Expr.Name(n) {
                        match this.prefixOf(n.name) {
                            Option.Some(pm) {
                                match lookup(this.cx, pm, f.field.name) {
                                    Option.Some(r) { if r.kind == DeclKind.Enum { return Option.Some(r.asEnum()); } }
                                    Option.None {}
                                }
                            }
                            Option.None {}
                        }
                    }
                    _ {}
                }
            }
            _ {}
        }
        return Option.None;
    }

    /// Rust `construct_variant`: `E.V`, `E.V(x)`, `E.V(a, b)` (generic enums are C2b).
    fn constructVariant(this: &BodyCx, sp: Span, en: Id<EnumDecl>, variant: Ident, args: &List<Id<Expr>>, want: Option<Id<Ty>>): Result<Id<TExpr>, TErr> {
        let ed = *this.cx.tables.enumAt(en);
        match ed.gen { Option.Some(_) { return this.genVariant(sp, en, variant, args, want); } Option.None {} }
        let vi = -1;
        for i in 0..ed.variants.len {
            if ed.variants.items[i].name == variant.name { vi = i; }
        }
        if vi < 0 {
            let t = Text.new(this.cx.arena);
            t.add("unknown variant `").add(this.str(variant.name)).add("`");
            return Result.Err(this.err(sp, t.str()));
        }
        let v = ed.variants.items[vi];
        let ftys = List<Id<Ty>>.new(this.cx.arena);
        match v.payload {
            Option.Some(p) {
                if v.multi {
                    match this.ty(p) {
                        Ty.Tuple(tt) { ftys.extend(this.cx.tables.items(tt.elems)); }
                        _ { return Result.Err(this.tupleMultiPayload(sp, p)); }
                    }
                } else {
                    ftys.push(p);
                }
            }
            Option.None {}
        }
        let name = Text.new(this.cx.arena);
        name.add(this.str(ed.name)).add(".").add(this.str(variant.name));
        if args.len != ftys.len {
            let t = Text.new(this.cx.arena);
            if ftys.len == 0 {
                t.add("`").add(name.str()).add("` has no payload");
            } else if ftys.len == 1 && args.len == 0 {
                t.add("`").add(name.str()).add("` needs a payload");
            } else {
                t.add("`").add(name.str()).add("` takes ");
                t.pushInt(ftys.len);
                t.add(" field");
                if ftys.len != 1 { t.add("s"); }
                t.add(", got ");
                t.pushInt(args.len);
            }
            return Result.Err(this.err(sp, t.str()));
        }
        let payload = List<Id<TExpr>>.new(this.cx.arena);
        if ftys.len == 1 && !v.multi {
            payload.push(this.operand(args.items[0], Option.Some(ftys.items[0]))?);
        } else {
            for k in 0..args.len {
                match this.operand(args.items[k], Option.Some(ftys.items[k])) {
                    Result.Ok(x) { payload.push(x); }
                    Result.Err(e) {
                        let t = Text.new(this.cx.arena);
                        t.add("field ");
                        t.pushInt(k);
                        t.add(" of `").add(name.str()).add("`: ").add(e.diag.msg);
                        let out = e;
                        out.diag.msg = own(this.cx.arena, t.str());
                        return Result.Err(out);
                    }
                }
            }
        }
        let t = this.cx.tables.enumTy(en, this.cx.arena.alloc::<Id<Ty>>(0));
        match want {
            Option.Some(w) { if t != w { return Result.Err(this.err(sp, "enum type does not match expected type")); } }
            Option.None {}
        }
        return Result.Ok(this.expr(TExpr.EnumVal(TEnumVal { variant: vi, payload: payload }), t, sp));
    }
}
