// Declaration errors as `Diag`s with Rust's text, and the small lookups every declaration pass shares
// (a decl's name and owner by `DeclRef`, which scope entries are types).
//
// Part of module j3c.sema.
// Port of: (new; Rust's `CheckError::new(path, span, msg).note(..).help(..)` chains in check/*.rs)
// J3: Rust names a module path on each error and then replaces it with the span's file; a `Diag` span
// already names its file, so only the two span-less errors need a stand-in: `fileOf` (a module's file,
// `--> path`) and `programSpan` (Rust's `<program>`).
module j3c.sema;

/// Report the error `msg` at `at` (code 0 until codes are assigned). Returns false for `return fail(..)`.
fn fail(cx: &SemaCx, at: Span, msg: string): bool { return failWith(cx, at, msg, "", ""); }

fn failHelp(cx: &SemaCx, at: Span, msg: string, help: string): bool { return failWith(cx, at, msg, "", help); }

fn failNote(cx: &SemaCx, at: Span, msg: string, note: string): bool { return failWith(cx, at, msg, note, ""); }

/// `msg` with an optional note and help ("" = none); rendered notes first, then helps, as Rust does.
fn failWith(cx: &SemaCx, at: Span, msg: string, note: string, help: string): bool {
    let d = cx.diags.make(0, Severity.Error, at, msg);
    if note.len > 0 { d.notes.push(Note { kind: NoteKind.Note, span: noSpan(), msg: note }); }
    if help.len > 0 { d.notes.push(Note { kind: NoteKind.Help, span: noSpan(), msg: help }); }
    cx.diags.add(d);
    return false;
}

/// Rust checked a template (generic struct, enum, fn, method) only when it was instantiated, so an unused
/// one with a bad type compiled. Template content is resolved quietly: the Diags it made are dropped
/// (`dropSince`) and the type poisoned; `resolve.templateErrors` reports them when a template is named
/// with arguments outside a template, where Rust instantiated it.
fn dropSince(cx: &SemaCx, n0: int) { cx.diags.items.len = n0; }

/// `tyOf`, quiet unless `loud`: a failure inside a template is `Ty.Error` with no Diag.
fn tyIn(cx: &SemaCx, env: TyEnv, t: Id<Type>, loud: bool): Option<Id<Ty>> {
    let n0 = cx.diags.count();
    match tyOf(cx, env, t) {
        Option.Some(x) { return Option.Some(x); }
        Option.None {}
    }
    if loud { return Option.None; }
    dropSince(cx, n0);
    return Option.Some(cx.tables.common.error);
}

/// `a` + `b` + `c` (message pieces) in the arena.
fn cat3(cx: &SemaCx, a: string, b: string, c: string): string { return Text.new(cx.arena).add(a).add(b).add(c).str(); }

fn cat5(cx: &SemaCx, a: string, b: string, c: string, d: string, e: string): string {
    return Text.new(cx.arena).add(a).add(b).add(c).add(d).add(e).str();
}

/// "`name`" pieces: `pre` + "`" + name + "`" + `post`.
fn quoted(cx: &SemaCx, pre: string, name: Sym, post: string): string {
    return Text.new(cx.arena).add(pre).add("`").add(cx.tables.str(name)).add("`").add(post).str();
}

/// The whole-file span of module `m`'s first file (Rust's `(m.path, Span::dummy())`).
fn fileOf(cx: &SemaCx, m: Id<ModDecl>): Span {
    let md = cx.tables.modAt(m);
    return fileSpan(cx.parsed.files.items[md.files.items[0]].src);
}

/// A span that renders as `--> <program>` (Rust's error path for a program-wide error).
fn programSpan(cx: &SemaCx): Span {
    let id = cx.sources.add(Source { path: "<program>", text: "", lines: Lines.of("", cx.arena) });
    return fileSpan(id);
}

/// The name a scope entry was declared with.
fn declName(cx: &SemaCx, d: DeclRef): Sym {
    let t = cx.tables;
    match d.kind {
        DeclKind.Struct { return t.structAt(d.asStruct()).name; }
        DeclKind.Enum { return t.enumAt(d.asEnum()).name; }
        DeclKind.Fn { return t.fnAt(d.asFn()).name; }
        DeclKind.Global { return t.globalAt(d.asGlobal()).name; }
        DeclKind.Const { return t.constAt(d.asConst()).name; }
        DeclKind.Trait { return t.traitAt(d.asTrait()).name; }
        DeclKind.Module { return t.modAt(d.asModule()).path.last(); }
    }
    return t.sym("");
}

/// The module that declares `d` (a module owns itself).
fn declOwner(cx: &SemaCx, d: DeclRef): Id<ModDecl> {
    let t = cx.tables;
    match d.kind {
        DeclKind.Struct { return t.structAt(d.asStruct()).owner; }
        DeclKind.Enum { return t.enumAt(d.asEnum()).owner; }
        DeclKind.Fn { return t.fnAt(d.asFn()).owner; }
        DeclKind.Global { return t.globalAt(d.asGlobal()).owner; }
        DeclKind.Const { return t.constAt(d.asConst()).owner; }
        DeclKind.Trait { return t.traitAt(d.asTrait()).owner; }
        DeclKind.Module { return d.asModule(); }
    }
    return d.asModule();
}

/// Struct or enum: the entries Rust kept in `types` / `struct_temps` / `enum_temps`.
fn isTypeRef(d: DeclRef): bool { return d.kind == DeclKind.Struct || d.kind == DeclKind.Enum; }

/// A struct or enum with type parameters (Rust's `struct_temps` / `enum_temps`).
fn isTemplate(cx: &SemaCx, d: DeclRef): bool {
    match d.kind {
        DeclKind.Struct { match cx.tables.structAt(d.asStruct()).gen { Option.Some(_) { return true; } Option.None {} } }
        DeclKind.Enum { match cx.tables.enumAt(d.asEnum()).gen { Option.Some(_) { return true; } Option.None {} } }
        _ {}
    }
    return false;
}

/// The scope entry `name` of `m` when it has kind `k`.
fn scopeOf(cx: &SemaCx, m: Id<ModDecl>, name: Sym, k: DeclKind): Option<DeclRef> {
    match cx.tables.modAt(m).scope.get(name) {
        Option.Some(d) { if d.kind == k { return Option.Some(d); } }
        Option.None {}
    }
    return Option.None;
}

/// The trait a bound names in `m`: a scope name, or a key `module::Name` (Rust `bind_list`: written by
/// `derive.j3` as `j3.cmp::Eq`; no source name has `::`).
fn boundTrait(cx: &SemaCx, m: Id<ModDecl>, name: Sym): Option<DeclRef> {
    let s = cx.tables.str(name);
    for i in 0..s.len - 1 {
        if s[i] == ':' && s[i + 1] == ':' {
            match cx.tables.modKeys.get(cx.tables.sym(s[0..i])) {
                Option.Some(km) { return scopeOf(cx, km, cx.tables.sym(s[i + 2..s.len]), DeclKind.Trait); }
                Option.None { return Option.None; }
            }
        }
    }
    return scopeOf(cx, m, name, DeclKind.Trait);
}

/// `name` bound in `m` to a struct or enum (own or imported, template or not).
fn scopeType(cx: &SemaCx, m: Id<ModDecl>, name: Sym): Option<DeclRef> {
    match cx.tables.modAt(m).scope.get(name) {
        Option.Some(d) { if isTypeRef(d) { return Option.Some(d); } }
        Option.None {}
    }
    return Option.None;
}

/// Bind `name` to `d` in `m`'s scope. Rust kept types, fns, consts, globals and traits in separate maps;
/// here they share one, so a name already bound to another kind keeps its first binding.
// ponytail: one scope per module; a type and a fn of the same name in one module lose the second (none in
// the stdlib or the corpus). A second namespace map is the upgrade if a program needs it.
fn bind(cx: &SemaCx, m: Id<ModDecl>, name: Sym, d: DeclRef) {
    let md = cx.tables.modAt(m);
    if md.scope.has(name) { return; }
    md.scope.put(name, d);
}
