// One fn's dataflow for `frame_str`: what each local may hold (a param's data, the frame buffer, a pointer
// to another local), statement by statement. Branches join, loops run to a fixed point, a whole-local store
// replaces what the local held, a field store adds to it; calls apply the callee's summary.
//
// Part of module j3c.sema.
// Port of: j3c/src/check/frame_str/flow.rs, check/frame_str/flow/call.rs
// J3: Walks typed-tree statements instead of structured IR (see `frame_str`).
module j3c.sema;
