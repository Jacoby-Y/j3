// The bound checks of generic struct / enum types written with args (`Map<K, V>` in a signature, a field,
// a body): queued where the type is resolved, checked before bodies (signatures), after each body that
// typed (`instances.drainBodyBounds`), and at the end of a template's placeholder pass (`checkTemplate`).
//
// Part of module j3c.sema.
// Port of: check/traits.rs (queue_bounds), check/lower/bounds.rs (drain_bounds)
// J3: A `Bound` instance's key is `(Bound, the generic struct or enum, its args)`, not the
// contracts-c2b.md `(Bound, trait, [type])`: Rust's message names the parameter and the type
// ("`K` of `Map`") and the span where each bound is written, which a per-trait key loses. The key dedups
// like Rust's per-instance queueing (`at` is the first site).
module j3c.sema;

/// Rust `queue_bounds`: generic struct / enum type `t` (outside a template) was just resolved at `at`;
/// request a `Bound` instance when some parameter of its template has bounds.
pub fn traitQueueBounds(cx: &SemaCx, t: Id<Ty>, at: Span) {
    let tb = cx.tables;
    let item: DeclRef = refStruct(Id<StructDecl> { i: 0 });
    let args = tb.common.none;
    let gen: Option<Id<Generics>> = Option.None;
    match tb.ty(t) {
        Ty.Struct(s) { item = refStruct(s.decl); args = s.args; gen = tb.structAt(s.decl).gen; }
        Ty.Enum(e) { item = refEnum(e.decl); args = e.args; gen = tb.enumAt(e.decl).gen; }
        _ { return; }
    }
    let g = match gen { Option.Some(x) { x } Option.None { return; } };
    let bs = tb.genericsAt(g).bounds;
    let any = false;
    for i in 0..bs.len { if bs.items[i].len > 0 { any = true; } }
    if !any { return; }
    request(cx, InstKey { kind: InstKind.Bound, item: item, args: args }, at);
}

/// `traitQueueBounds` for every generic struct / enum type inside `t`, type args before the type that
/// holds them (Rust instantiates in that order). A body's written types go through this: in an instance
/// body after substitution, in a template's placeholder pass with its `Ty.Param`s (Rust
/// `instantiate_struct` / `_enum` run by a body, resolve.rs:247/355).
// ponytail: every nested type is queued at the whole written type's span; Rust has each inner name's own.
pub fn traitQueueBoundsIn(cx: &SemaCx, t: Id<Ty>, at: Span) {
    let tb = cx.tables;
    match tb.ty(t) {
        Ty.Ref(r) { traitQueueBoundsIn(cx, r.inner, at); }
        Ty.Array(a) { traitQueueBoundsIn(cx, a.elem, at); }
        Ty.Slice(s) { traitQueueBoundsIn(cx, s.elem, at); }
        Ty.Fn(f) { queueList(cx, f.params, at); traitQueueBoundsIn(cx, f.ret, at); }
        Ty.Closure(c) { queueList(cx, c.params, at); traitQueueBoundsIn(cx, c.ret, at); }
        Ty.Tuple(tu) { queueList(cx, tu.elems, at); }
        Ty.Struct(s) { queueList(cx, s.args, at); traitQueueBounds(cx, t, at); }
        Ty.Enum(e) { queueList(cx, e.args, at); traitQueueBounds(cx, t, at); }
        _ {}
    }
}

fn queueList(cx: &SemaCx, l: Id<TyList>, at: Span) {
    let xs = cx.tables.items(l);
    for i in 0..xs.len { traitQueueBoundsIn(cx, xs[i], at); }
}

/// `instances.drain` (and `drainBounds`) for an `InstKind.Bound` instance: do its args meet the bounds of
/// the template's parameters (Rust `check_bounds` with "`P` of `Name`"), Rust's message at `Instance.at`.
/// `hint` is the module whose plain fns the "a plain fn is in scope" help looks at (Rust `funcs`: the
/// module being lowered; None before bodies and in the template pass). False after the error Diag.
pub fn traitDrainBound(cx: &SemaCx, id: Id<Instance>, hint: Option<Id<ModDecl>>): bool {
    let tb = cx.tables;
    let inst = *tb.instanceAt(id);
    let xs = tb.items(inst.key.args);
    let reqs = List<BoundReq>.new(cx.arena);
    let name = "";
    match inst.key.item.kind {
        DeclKind.Struct {
            let sd = tb.structAt(inst.key.item.asStruct());
            name = tb.str(sd.name);
            match sd.item { Option.Some(it) { reqs = reqsOf(cx, sd.owner, &it.typeParams, &it.bounds, xs, 0); } Option.None {} }
        }
        DeclKind.Enum {
            let ed = tb.enumAt(inst.key.item.asEnum());
            name = tb.str(ed.name);
            match ed.item { Option.Some(it) { reqs = reqsOf(cx, ed.owner, &it.typeParams, &it.bounds, xs, 0); } Option.None {} }
        }
        _ { return true; }
    }
    match checkBoundReqs(cx, inst.at, cat3(cx, "`", name, "`"), &reqs, hint) {
        Option.Some(d) { cx.diags.add(d); return false; }
        Option.None {}
    }
    return true;
}
