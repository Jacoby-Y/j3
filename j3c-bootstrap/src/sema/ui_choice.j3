// `@uiChoice(Set, value, index)`: whether `value` is arm `index` of the candidate-set enum `Set` (what
// the parser's `@j3ui` desugaring emits for a choice widget).
//
// Part of module j3c.sema.
// Port of: j3c/src/check/lower/expr.rs (the UiChoice arm of rvalue_raw)
module j3c.sema;
// J3: Contract (wave 13): contracts-c2d.md, chunk C. `infer.peek` already answers `bool`. `want` is unused,
// as in Rust (the result is always `bool`).

extend BodyCx {
    /// Rust expr.rs:190-205: `Set` must be a payloadless enum and `index` a constant in range; the result is
    /// `value == index` for an `int` value, `value == Set.<arm index>` for a `Set` value.
    fn uiChoice(this: &BodyCx, sp: Span, u: &UiChoiceExpr, want: Option<Id<Ty>>): Result<Id<TExpr>, TErr> {
        let ty = this.resolve(u.set)?;
        let eid = match this.enumOf(ty) {
            Option.Some(e) { e }
            Option.None { return Result.Err(this.err(sp, "`@uiChoice` needs a payloadless candidate-set enum")); }
        };
        if !this.cLike(eid) { return Result.Err(this.err(sp, "`@uiChoice` needs a payloadless candidate-set enum")); }
        let n: i64 = -1;
        match this.foldInt(u.index) { Option.Some(v) { n = v; } Option.None {} }
        if n < 0 || n >= i64(this.cx.tables.enumAt(eid).variants.len) {
            return Result.Err(this.err(this.cx.ast.exprSpan(u.index), "`@uiChoice` arm index must be a constant within the candidate set"));
        }
        let op = this.operand(u.value, Option.None)?;
        let c = this.com();
        if this.exprTy(op) == c.i64 {
            return Result.Ok(this.expr(TExpr.Binary(TBinary { op: BinOp.Eq, kind: BinKind.Prim, lhs: op, rhs: this.intLit(u64(n), c.i64, sp) }), c.bool, sp));
        }
        if this.exprTy(op) != ty {
            let t = Text.new(this.cx.arena);
            t.add("component selector must be `int` or `").add(this.str(this.cx.tables.enumAt(eid).name)).add("`");
            return Result.Err(this.err(this.cx.ast.exprSpan(u.value), t.str()));
        }
        // Rust holds the arm in `_choiceN` after the selector's operand, then compares against a copy.
        let arm = this.exprFrom(Origin.Choice, TExpr.EnumVal(TEnumVal { variant: int(n), payload: List<Id<TExpr>>.new(this.cx.arena) }), ty, sp);
        return Result.Ok(this.expr(TExpr.Binary(TBinary { op: BinOp.Eq, kind: BinKind.Prim, lhs: op, rhs: arm }), c.bool, sp));
    }
}
