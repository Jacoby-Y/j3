// What each module makes `pub`, and whether a module may name another module's item.
//
// Part of module j3c.sema.
// Port of: j3c/src/check/exports.rs, check/traits.rs (`trait_docs`)
// J3: `program_exports` / `const_docs` / `trait_docs` (LSP completion and hover) are computed on demand from
// `Checked` (Rust kept them in `Program`), into the arena given (the Session's, for one request).
// `share_methods` has nothing to do here: methods live on their `StructDecl`, which every module sees.
module j3c.sema;

/// Rust `collect_exports`: the `pub` names of `m` (fns other than `#[impl]`, traits, structs, enums,
/// consts) into `ModDecl.exports`.
pub fn collectExports(cx: &SemaCx, m: Id<ModDecl>) {
    let md = cx.tables.modAt(m);
    for k in 0..md.items.len {
        match pubName(md.items.items[k]) { Option.Some(n) { md.exports.add(n); } Option.None {} }
    }
}

/// The name an item exports, when it is `pub` and exportable.
fn pubName(it: Item): Option<Sym> {
    match it {
        Item.Fn(f) { if f.visPub && !f.isImpl { return Option.Some(f.name.name); } }
        Item.Trait(t) { if t.visPub { return Option.Some(t.name.name); } }
        Item.Struct(s) { if s.visPub { return Option.Some(s.name.name); } }
        Item.Enum(e) { if e.visPub { return Option.Some(e.name.name); } }
        Item.Const(c) { if c.visPub { return Option.Some(c.name.name); } }
        _ {}
    }
    return Option.None;
}

/// `m`'s exported names in declaration order (did-you-mean candidates).
fn exportNames(cx: &SemaCx, m: Id<ModDecl>): []string {
    let md = cx.tables.modAt(m);
    let out = List<string>.new(cx.arena);
    for k in 0..md.items.len {
        match pubName(md.items.items[k]) { Option.Some(n) { out.push(cx.tables.str(n)); } Option.None {} }
    }
    return out.slice();
}

/// Rust `share_methods`: methods of a struct are visible wherever the struct is. Nothing to do: they are
/// on the `StructDecl`.
pub fn shareMethods(cx: &SemaCx) {}

/// Can module `from` name `d` (its own item, or one `pub` in its module)?
pub fn visible(cx: &SemaCx, from: Id<ModDecl>, d: DeclRef): bool {
    let owner = declOwner(cx, d);
    return owner == from || cx.tables.modAt(owner).exports.has(declName(cx, d));
}

/// Rust `ExportKind`.
pub enum ExportKind { Fn, Struct, Enum, Const }

/// Rust `check::Export`: a name a module makes `pub` (or, from `constDocs`, any `const`).
pub struct Export {
    modPath: string;
    name: string;
    doc: string;
    kind: ExportKind;
}

/// Rust `program_exports`: per module (load order, `use lib` namespaces left out), its `pub` names sorted,
/// each with its kind and doc. A `pub` trait, generic fn or `const` array has no kind (Rust skips it).
pub fn programExports(c: &Checked, arena: &Arena): List<Export> {
    let t = c.tables;
    let out = List<Export>.new(arena);
    for i in 0..t.mods.len() {
        let m = t.mods.idAt(i);
        let md = t.modAt(m);
        if md.isLib { continue; }
        let names = List<string>.new(arena);
        for k in 0..md.items.len {
            match pubName(md.items.items[k]) {
                Option.Some(n) { let s = t.str(n); if !names.contains(s) { names.push(s); } }
                Option.None {}
            }
        }
        sort(names.slice());
        for k in 0..names.len {
            match exportKind(c, m, names.items[k]) {
                Option.Some(kind) { out.push(Export { modPath: md.key, name: names.items[k], doc: itemDoc(c, m, names.items[k]), kind: kind }); }
                Option.None {}
            }
        }
    }
    return out;
}

/// Rust `export_kind`: a non-generic fn, a struct, an enum, then a `const` that is not an array.
fn exportKind(c: &Checked, m: Id<ModDecl>, name: string): Option<ExportKind> {
    let t = c.tables;
    let md = t.modAt(m);
    for k in 0..md.items.len {
        match md.items.items[k] {
            Item.Fn(f) { if !f.isImpl && f.typeParams.len == 0 && t.str(f.name.name) == name { return Option.Some(ExportKind.Fn); } }
            _ {}
        }
    }
    for k in 0..md.items.len {
        match md.items.items[k] {
            Item.Struct(s) { if t.str(s.name.name) == name { return Option.Some(ExportKind.Struct); } }
            Item.Enum(e) { if t.str(e.name.name) == name { return Option.Some(ExportKind.Enum); } }
            _ {}
        }
    }
    for k in 0..md.consts.len {
        let cd = t.constAt(md.consts.items[k]);
        if t.str(cd.name) != name { continue; }
        match cd.table { Option.Some(_) {} Option.None { return Option.Some(ExportKind.Const); } }
    }
    return Option.None;
}

/// Rust `item_doc`: the doc of the first fn, struct, enum or const of `m` named `name`.
fn itemDoc(c: &Checked, m: Id<ModDecl>, name: string): string {
    let t = c.tables;
    let md = t.modAt(m);
    for k in 0..md.items.len {
        match md.items.items[k] {
            Item.Fn(f) { if t.str(f.name.name) == name { return f.doc; } }
            Item.Struct(s) { if t.str(s.name.name) == name { return s.doc; } }
            Item.Enum(e) { if t.str(e.name.name) == name { return e.doc; } }
            Item.Const(k2) { if t.str(k2.name.name) == name { return k2.doc; } }
            _ {}
        }
    }
    return "";
}

/// Rust `const_docs`: every `const` of every module (private ones and arrays too), for hover.
pub fn constDocs(c: &Checked, arena: &Arena): List<Export> {
    let t = c.tables;
    let out = List<Export>.new(arena);
    for i in 0..t.mods.len() {
        let md = t.modAt(t.mods.idAt(i));
        if md.isLib { continue; }
        for k in 0..md.items.len {
            match md.items.items[k] {
                Item.Const(k2) { out.push(Export { modPath: md.key, name: t.str(k2.name.name), doc: k2.doc, kind: ExportKind.Const }); }
                _ {}
            }
        }
    }
    return out;
}

/// Rust `check::TraitDoc`: a trait as hover shows it; `sig` is the declaration's source, `span` its name.
pub struct TraitDoc {
    name: string;
    modPath: string;
    doc: string;
    sig: string;
    span: Span;
    decl: Id<TraitDecl>;
}

/// Rust `trait_docs`: every trait, sorted by (module, name).
pub fn traitDocs(c: &Checked, sources: &Pool<Source>, arena: &Arena): List<TraitDoc> {
    let t = c.tables;
    let out = List<TraitDoc>.new(arena);
    for i in 0..t.traits.len() {
        let id = t.traits.idAt(i);
        let td = t.traitAt(id);
        let nameSpan = td.span;
        match td.item { Option.Some(it) { nameSpan = it.name.span; } Option.None {} }
        let sig = "";
        if !isNone(td.span) {
            let src = sources.get(td.span.file).text;
            if td.span.hi <= u32(src.len) { sig = trimAscii(src[int(td.span.lo)..int(td.span.hi)]); }
        }
        let d = TraitDoc { name: t.str(td.name), modPath: t.modAt(td.owner).key, doc: td.doc, sig: sig, span: nameSpan, decl: id };
        out.push(d);
        let k = out.len - 1;
        while k > 0 && traitBefore(&d, &out.items[k - 1]) {
            out.items[k] = out.items[k - 1];
            out.items[k - 1] = d;
            k -= 1;
        }
    }
    return out;
}

fn traitBefore(a: &TraitDoc, b: &TraitDoc): bool {
    if a.modPath != b.modPath { return a.modPath < b.modPath; }
    return a.name < b.name;
}

/// `s` without leading and trailing ASCII whitespace (Rust `str::trim` on source text).
fn trimAscii(s: string): string {
    let a = 0;
    let b = s.len;
    while a < b && isWs(s[a]) { a += 1; }
    while b > a && isWs(s[b - 1]) { b -= 1; }
    return s[a..b];
}

fn isWs(b: u8): bool { return b == ' ' || b == '\t' || b == '\n' || b == '\r'; }
