// What each module makes `pub`, and whether a module may name another module's item.
//
// Part of module j3c.sema.
// Port of: j3c/src/check/exports.rs
// J3: `program_exports` / `const_docs` (LSP import completion and hover) come with the LSP port (C5).
// `share_methods` has nothing to do here: methods live on their `StructDecl`, which every module sees.
module j3c.sema;

/// Rust `collect_exports`: the `pub` names of `m` (fns other than `#[impl]`, traits, structs, enums,
/// consts) into `ModDecl.exports`.
pub fn collectExports(cx: &SemaCx, m: Id<ModDecl>) {
    let md = cx.tables.modAt(m);
    for k in 0..md.items.len {
        match pubName(md.items.items[k]) { Option.Some(n) { md.exports.add(n); } Option.None {} }
    }
}

/// The name an item exports, when it is `pub` and exportable.
fn pubName(it: Item): Option<Sym> {
    match it {
        Item.Fn(f) { if f.visPub && !f.isImpl { return Option.Some(f.name.name); } }
        Item.Trait(t) { if t.visPub { return Option.Some(t.name.name); } }
        Item.Struct(s) { if s.visPub { return Option.Some(s.name.name); } }
        Item.Enum(e) { if e.visPub { return Option.Some(e.name.name); } }
        Item.Const(c) { if c.visPub { return Option.Some(c.name.name); } }
        _ {}
    }
    return Option.None;
}

/// `m`'s exported names in declaration order (did-you-mean candidates).
fn exportNames(cx: &SemaCx, m: Id<ModDecl>): []string {
    let md = cx.tables.modAt(m);
    let out = List<string>.new(cx.arena);
    for k in 0..md.items.len {
        match pubName(md.items.items[k]) { Option.Some(n) { out.push(cx.tables.str(n)); } Option.None {} }
    }
    return out.slice();
}

/// Rust `share_methods`: methods of a struct are visible wherever the struct is. Nothing to do: they are
/// on the `StructDecl`.
pub fn shareMethods(cx: &SemaCx) {}

/// Can module `from` name `d` (its own item, or one `pub` in its module)?
pub fn visible(cx: &SemaCx, from: Id<ModDecl>, d: DeclRef): bool {
    let owner = declOwner(cx, d);
    return owner == from || cx.tables.modAt(owner).exports.has(declName(cx, d));
}
