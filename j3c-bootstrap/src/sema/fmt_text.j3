// `t.fmt(`..`)` on a `j3.text.Text`: every part appended to `t`, no length limit.
//
// Part of module j3c.sema.
// Port of: check/lower/interp.rs (text_fmt)
// J3: C2c hook (contracts-c2c.md, owner: frame strings / Text.fmt). The result is a `TExpr.TextFmt` whose
// type is `this`'s (`&Text`, like `add`). No folding and no `{s}` shortcut, as in Rust.
module j3c.sema;

extend BodyCx {
    /// Rust `text_fmt`: `recv.fmt(parts)` where `recv` is a `Text` (struct `s`, through any `&`).
    fn fmtText(this: &BodyCx, sp: Span, recv: Id<TPlace>, s: Id<StructDecl>, parts: &List<InterpPart>): Result<Id<TExpr>, TErr> {
        let push = Id<FnDecl> { i: 0 };
        match this.findMethod(s, this.sym("pushBytes")) {
            Option.Some(f) { push = f; }
            Option.None { return Result.Err(this.err(sp, "`fmt` needs `Text.pushBytes`")); }
        }
        let want = this.cx.tables.fnAt(push).params.items[0].ty;
        let me = this.autoThis(sp, recv, want)?;
        let out = List<TInterpPart>.new(this.cx.arena);
        for i in 0..parts.len {
            match parts.items[i] {
                InterpPart.Lit(b) { out.push(TInterpPart.Lit(b)); }
                InterpPart.Expr(h) {
                    let v = this.interpOperand(h.expr)?;
                    out.push(TInterpPart.Value(TInterpValue { expr: v, debug: Option.None }));
                }
            }
        }
        // Rust refuses an unprintable inner type while expanding (`interp_expand`), after every hole.
        for i in 0..out.len {
            match out.items[i] { TInterpPart.Value(v) { this.printable(sp, this.exprTy(v.expr))?; } TInterpPart.Lit(_) {} }
        }
        return Result.Ok(this.expr(TExpr.TextFmt(TTextFmt { this: me, push: push, parts: out }), want, sp));
    }
}
