// Read-only queries over `Checked` for the tools (the LSP): find things by name the way Rust's `lsp/query.rs`
// does (`ident_at` + `find_*`): locals of the fn whose span holds the offset (last non-temp match), fns
// preferring the current file, structs, enums, globals, consts, fields, traits.
//
// Part of module j3c.sema.
// Port of: j3c/src/lsp/query.rs (`file_by_path`, `find_local`, `find_func`, `find_struct`, `find_enum`, `module_path`)
// J3: Never writes `Checked`. No `typeAt` / `references` (nothing in Rust uses them). `tyText` prints what Rust
// `dump::ty_string` prints (`int`/`float` aliases included). Names are compared as text (`Names` lookups).
module j3c.sema;

/// The file of `path` among the loaded sources, as `Source` ids show it (Rust `file_by_path`).
pub fn fileByPath(c: &Checked, sources: &Pool<Source>, path: string): Option<Id<Source>> { return Option.None; } // STUB LSPQ

/// The fn (plain or method) whose span in `file` holds `off`.
pub fn fnAt(c: &Checked, file: Id<Source>, off: u32): Option<Id<FnDecl>> { return Option.None; } // STUB LSPQ

/// Rust `find_local`: the last local named `name` of the fn around `off` (params included, temps skipped).
pub fn findLocal(c: &Checked, file: Id<Source>, off: u32, name: string): Option<Id<TLocal>> { return Option.None; } // STUB LSPQ

/// Rust `find_func`: the first fn named `name` in `prefer`, else the first anywhere.
pub fn lookupFn(c: &Checked, name: string, prefer: Id<Source>): Option<Id<FnDecl>> { return Option.None; } // STUB LSPQ

pub fn findStruct(c: &Checked, name: string): Option<Id<StructDecl>> { return Option.None; } // STUB LSPQ
pub fn findEnum(c: &Checked, name: string): Option<Id<EnumDecl>> { return Option.None; } // STUB LSPQ
pub fn findGlobal(c: &Checked, name: string): Option<Id<GlobalDecl>> { return Option.None; } // STUB LSPQ
pub fn findConst(c: &Checked, name: string): Option<Id<ConstDecl>> { return Option.None; } // STUB LSPQ
pub fn findTrait(c: &Checked, name: string): Option<Id<TraitDecl>> { return Option.None; } // STUB LSPQ

/// The struct a value of type `ty` has members of (`&` stripped).
pub fn structOf(c: &Checked, ty: Id<Ty>): Option<Id<StructDecl>> { return Option.None; } // STUB LSPQ

/// `ty` as Rust `dump::ty_string` prints it.
pub fn tyString(c: &Checked, ty: Id<Ty>, out: &Text) {} // STUB LSPQ

/// `fn name(params): ret` as the hover shows it.
pub fn sigText(c: &Checked, f: Id<FnDecl>, out: &Text) {} // STUB LSPQ

/// Rust `module_path`: the dotted module name of `m`.
pub fn moduleKey(c: &Checked, m: Id<ModDecl>, out: &Text) {} // STUB LSPQ
