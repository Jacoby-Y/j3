// TextMate grammar dump for editors (`j3c dump-syntax`), generated from the lexer's own tables.
//
// Port of: j3c/src/parse/syntax.rs (the grammar; the name lists are in `syntax/token`), cli/dump.rs `dump_syntax`
// J3: Parts: `textmate/tm` (JSON/regex helpers, `tmGrammar`), `rules` (items, strings), `tokens`
// (keywords, types, operators), `ui` (`uiTmGrammar`). Word lists come from `syntax/token`
// (`keywords.txt` + `names(NameList.X)`), the `.j3ui` element list is a copy of `ui/gen`'s (`ui.j3`).
module j3c.textmate;

use j3.cmp.sortBy;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, replace, startsWith };
use j3c.base.fsx;
use j3c.ui.gen;
use j3c.syntax.token.{ FN_WHERE, ITEM_EXTEND, ITEM_TRAIT, NameList, SCRIPT_PROPS, SCRIPT_SHARED, TYPE_BOXED, TYPE_CLOSURE,
    TYPE_DYN, TokenKind, keywordNames, kindOf, names, operatorClass, operatorSrc, scopeOf, wordsOf };

const USAGE = "usage: j3c dump-syntax [--ui] [file]";

/// `j3c dump-syntax [--ui] [FILE]`: Rust `cli::dump_syntax`. FILE (the first argument not starting with
/// `-`) gets the grammar instead of stdout.
pub fn dumpSyntaxCmd(rest: []string): int {
    for i in 0..rest.len {
        if rest[i] == "--help" || rest[i] == "-h" {
            out(USAGE);
            out("\n  --ui   print the .j3ui grammar instead; no file prints to stdout\n");
            return 0;
        }
    }
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    for i in 0..rest.len {
        if startsWith(rest[i], "-") && rest[i] != "--ui" {
            err(Text.new(&mem).add("j3c dump-syntax: unknown flag `").add(rest[i]).add("`; ").add(USAGE).add("\n").str());
            return 1;
        }
    }
    let ui = false;
    for i in 0..rest.len { if rest[i] == "--ui" { ui = true; } }
    let g = if ui { uiTmGrammar(&mem) } else { tmGrammar(&mem) };
    for i in 0..rest.len {
        if !startsWith(rest[i], "-") {
            match fsx.writeFile(rest[i], g as []u8, &mem) {
                Result.Ok(_) { return 0; }
                Result.Err(e) {
                    err(Text.new(&mem).add("j3c: write ").add(rest[i]).add(": ").add(e).add("\n").str());
                    return 1;
                }
            }
        }
    }
    out(g);
    return 0;
}

fn out(s: string) { sys.write(1, s.ptr as ptr, s.len); }

fn err(s: string) { sys.write(2, s.ptr as ptr, s.len); }
