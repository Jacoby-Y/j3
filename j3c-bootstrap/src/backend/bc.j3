// Bytecode printer for checked script IR (`.j3sb`, versioned): one `BcModule` per script module, encoded for
// the `.j3s` VM (`stdlib/j3/script/load.j3` reads it: magic `J3SB`, `VERSION`).
//
// Port of: j3c/src/emit/bc/mod.rs
// J3: A register machine (Rust's module doc): register 0 holds the frame pointer; scalar locals that are never
//     addressed live in registers, everything else in the frame at an `ir/abi.j3` offset. Ops are typed here,
//     so the VM never looks at a type. Integer registers hold the value sign- or zero-extended to 64 bits.
// J3: Parts: `bc/op.j3` (ops, `Instr`, call sites, register classes; frozen), `bc/encode.j3` (binary, `dump-bc`
//     text, paths), `bc/codegen.j3` + `bc/stmt.j3` + `bc/call.j3` (+ new parts) fn codegen. Every `use` of the
//     module is here (stage 0 rejects a repeated `use` across part files).
// J3: Rust `Vec<(u64, String)>` natives are `List<BcNative>`; byte vectors are `List<u8>`. Strings in a
//     `BcModule` are arena copies (rule 1). Structs stored by value in lists keep payload enums / `Option`
//     first and bools last (stage-0 hazard (a)); they are in `tests/unit/layout_test.j3`.
// J3: Keys are FNV-1a 64 (`j3.hash.fnv1a64`, the same function as Rust `hash`) of `fnLabel`; byte-exact with
//     stage 0, so `.j3sb` files compare with `cmp` (`tests/diff.sh bc`).
module j3c.backend.bc;

use j3.data.map.Map;
use j3.data.pool.Id;
use j3.hash.fnv1a64;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.ir.{ BinOp, Block, Body, ConstInit, ConstKind, EnumDef, FieldId, FloatTy, Func, FuncKind, GlobalDef, IntTy, IrCx, LocalDecl,
    Module, Operand, Place, PlaceRoot, Proj, Rvalue, RvalueKind, Stmt, StmtKind, StructDef, TyKind, UnaryOp, Vis };
use j3c.ir.{ abiAlign, abiSize, fieldOffset };
use j3c.ir.dump.tyString;

/// File format version (`load.j3` panics "bytecode version differs; rerun j3c" on another).
pub const VERSION: u16 = 2;
/// No register: a param or value that lives in the frame.
pub const NO_REG: u32 = 0xFFFFFFFF;
/// Register 0 is the frame pointer.
pub const FP: u32 = 0;

pub struct BcParam {
    /// Register the argument lands in, or `NO_REG` when the param lives in the frame.
    reg: u32;
    offset: u32;
    size: u32;
    /// Load op code for a scalar param read from memory (0 for an aggregate).
    load: u16;
}

pub struct BcFunction {
    params: List<BcParam>;
    calls: List<CallSite>;
    code: List<Instr>;
    name: string;
    signature: string;
    key: u64;
    frameSize: u32;
    regs: u32;
    retSize: u32;
    public: bool;
    retAggregate: bool;
}

pub struct BcField {
    /// Index into `BcModule.constants` when the default is a string (Rust `default_const`).
    defaultConst: Option<u32>;
    default: List<u8>;
    name: string;
    offset: u32;
    size: u32;
}

pub struct BcGlobal {
    initConst: Option<u32>;
    init: List<u8>;
    name: string;
    key: u64;
    size: u32;
}

/// A native fn a script calls (Rust `(u64, String)`): its key and label.
pub struct BcNative {
    label: string;
    key: u64;
}

pub struct BcModule {
    fields: List<BcField>;
    globals: List<BcGlobal>;
    constants: List<List<u8>>;
    natives: List<BcNative>;
    /// Other scripts this one calls into; the VM loads them first.
    scripts: List<string>;
    functions: List<BcFunction>;
    name: string;
    /// Path from the project root, e.g. `scripts/door.j3s`.
    path: string;
    layoutHash: u64;
    signatureHash: u64;
    instanceSize: u32;
    props: u32;
}

