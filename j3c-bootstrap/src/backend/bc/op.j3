// Opcodes, instructions and call sites. The numbers are the file format, which the VM (`stdlib/j3/script/exec.j3`)
// reads: never renumber. Also the register classes of scalar types (Rust `emit/bc/mod.rs` `Class`, `class`,
// `load_op`, `store_op`, `ext_op`, `canonical`): tables both the module and the codegen half use.
//
// Part of module j3c.backend.bc.
// Port of: j3c/src/emit/bc/op.rs
// J3: The table stays here, not shared with `stdlib/j3/script/opcodes.j3`: that file is a part of `j3.script`
//     (importing it drags the VM into the compiler) and the stdlib is frozen. `tests/unit/bc_op_test.j3` reads
//     `$J3_STDLIB/j3/script/opcodes.j3` and checks every `const NAME: u16 = N` against `ALL_OPS`.
// J3: `Op` is a C-like enum in file order: `opCode(op)` is `int(op) + 1` (Rust `op as u16`). Frozen in wave 22.
module j3c.backend.bc;

/// One VM operation. The variant order is the file number minus one.
pub enum Op {
    Const, Mov, Addr, Idx, Global, Str, Ld8s, Ld8u,
    Ld16s, Ld16u, Ld32s, Ld32u, Ld64, St8, St16, St32,
    St64, Copy, Add, Sub, Mul, Divs, Rems, Divu,
    Remu, Neg, Not, Eq, Ne, Lts, Les, Ltu,
    Leu, Sext8, Sext16, Sext32, Zext8, Zext16, Zext32, Fadd,
    Fsub, Fmul, Fdiv, Fneg, Feq, Fne, Flt, Fle,
    Dadd, Dsub, Dmul, Ddiv, Dneg, Deq, Dne, Dlt,
    Dle, I2f, U2f, F2i, F2u, I2d, U2d, D2i,
    D2u, F2d, D2f, Jmp, Jz, Jnz, JnLts, JnLes,
    JnLtu, JnLeu, JnEq, JnNe, JnFlt, JnFle, JnDlt, JnDle,
    Call, Ret, RetV, RetA, Abort, Div0, AppLit, AppStr,
    AppInt, AppF64, AppBool, Land, Lor, Band, Bor, Bxor,
    Bnot
}

/// Number of ops; the last one's code.
pub const OP_COUNT: int = 97;

/// Every op in code order (`ALL_OPS[i]` has code `i + 1`): `opAt` reads it (a const array is not importable).
const ALL_OPS: [97]Op = [
    Op.Const, Op.Mov, Op.Addr, Op.Idx, Op.Global, Op.Str, Op.Ld8s, Op.Ld8u,
    Op.Ld16s, Op.Ld16u, Op.Ld32s, Op.Ld32u, Op.Ld64, Op.St8, Op.St16, Op.St32,
    Op.St64, Op.Copy, Op.Add, Op.Sub, Op.Mul, Op.Divs, Op.Rems, Op.Divu,
    Op.Remu, Op.Neg, Op.Not, Op.Eq, Op.Ne, Op.Lts, Op.Les, Op.Ltu,
    Op.Leu, Op.Sext8, Op.Sext16, Op.Sext32, Op.Zext8, Op.Zext16, Op.Zext32, Op.Fadd,
    Op.Fsub, Op.Fmul, Op.Fdiv, Op.Fneg, Op.Feq, Op.Fne, Op.Flt, Op.Fle,
    Op.Dadd, Op.Dsub, Op.Dmul, Op.Ddiv, Op.Dneg, Op.Deq, Op.Dne, Op.Dlt,
    Op.Dle, Op.I2f, Op.U2f, Op.F2i, Op.F2u, Op.I2d, Op.U2d, Op.D2i,
    Op.D2u, Op.F2d, Op.D2f, Op.Jmp, Op.Jz, Op.Jnz, Op.JnLts, Op.JnLes,
    Op.JnLtu, Op.JnLeu, Op.JnEq, Op.JnNe, Op.JnFlt, Op.JnFle, Op.JnDlt, Op.JnDle,
    Op.Call, Op.Ret, Op.RetV, Op.RetA, Op.Abort, Op.Div0, Op.AppLit, Op.AppStr,
    Op.AppInt, Op.AppF64, Op.AppBool, Op.Land, Op.Lor, Op.Band, Op.Bor, Op.Bxor,
    Op.Bnot
];

/// The op with code `i + 1`, for `i` in `0..OP_COUNT` (the unit test walks every op).
pub fn opAt(i: int): Op {
    let t = ALL_OPS;
    return t[i];
}

/// The op's number in the file (Rust `op as u16`).
pub fn opCode(op: Op): u16 { return u16(int(op) + 1); }

/// The op's name in `dump-bc` text (Rust `Op::name`).
pub fn opName(op: Op): string {
    match op {
        Op.Const { return "const"; }
        Op.Mov { return "mov"; }
        Op.Addr { return "addr"; }
        Op.Idx { return "idx"; }
        Op.Global { return "global"; }
        Op.Str { return "str"; }
        Op.Ld8s { return "ld8s"; }
        Op.Ld8u { return "ld8u"; }
        Op.Ld16s { return "ld16s"; }
        Op.Ld16u { return "ld16u"; }
        Op.Ld32s { return "ld32s"; }
        Op.Ld32u { return "ld32u"; }
        Op.Ld64 { return "ld64"; }
        Op.St8 { return "st8"; }
        Op.St16 { return "st16"; }
        Op.St32 { return "st32"; }
        Op.St64 { return "st64"; }
        Op.Copy { return "copy"; }
        Op.Add { return "add"; }
        Op.Sub { return "sub"; }
        Op.Mul { return "mul"; }
        Op.Divs { return "divs"; }
        Op.Rems { return "rems"; }
        Op.Divu { return "divu"; }
        Op.Remu { return "remu"; }
        Op.Neg { return "neg"; }
        Op.Not { return "not"; }
        Op.Eq { return "eq"; }
        Op.Ne { return "ne"; }
        Op.Lts { return "lts"; }
        Op.Les { return "les"; }
        Op.Ltu { return "ltu"; }
        Op.Leu { return "leu"; }
        Op.Sext8 { return "sext8"; }
        Op.Sext16 { return "sext16"; }
        Op.Sext32 { return "sext32"; }
        Op.Zext8 { return "zext8"; }
        Op.Zext16 { return "zext16"; }
        Op.Zext32 { return "zext32"; }
        Op.Fadd { return "fadd"; }
        Op.Fsub { return "fsub"; }
        Op.Fmul { return "fmul"; }
        Op.Fdiv { return "fdiv"; }
        Op.Fneg { return "fneg"; }
        Op.Feq { return "feq"; }
        Op.Fne { return "fne"; }
        Op.Flt { return "flt"; }
        Op.Fle { return "fle"; }
        Op.Dadd { return "dadd"; }
        Op.Dsub { return "dsub"; }
        Op.Dmul { return "dmul"; }
        Op.Ddiv { return "ddiv"; }
        Op.Dneg { return "dneg"; }
        Op.Deq { return "deq"; }
        Op.Dne { return "dne"; }
        Op.Dlt { return "dlt"; }
        Op.Dle { return "dle"; }
        Op.I2f { return "i2f"; }
        Op.U2f { return "u2f"; }
        Op.F2i { return "f2i"; }
        Op.F2u { return "f2u"; }
        Op.I2d { return "i2d"; }
        Op.U2d { return "u2d"; }
        Op.D2i { return "d2i"; }
        Op.D2u { return "d2u"; }
        Op.F2d { return "f2d"; }
        Op.D2f { return "d2f"; }
        Op.Jmp { return "jmp"; }
        Op.Jz { return "jz"; }
        Op.Jnz { return "jnz"; }
        Op.JnLts { return "jn.lts"; }
        Op.JnLes { return "jn.les"; }
        Op.JnLtu { return "jn.ltu"; }
        Op.JnLeu { return "jn.leu"; }
        Op.JnEq { return "jn.eq"; }
        Op.JnNe { return "jn.ne"; }
        Op.JnFlt { return "jn.flt"; }
        Op.JnFle { return "jn.fle"; }
        Op.JnDlt { return "jn.dlt"; }
        Op.JnDle { return "jn.dle"; }
        Op.Call { return "call"; }
