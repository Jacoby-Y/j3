/// Ops whose `imm` is a code index (Rust `is_jump`): shifted by the const prologue, patched by loops.
pub fn isJump(op: Op): bool {
    // Rust's list (`Jmp` `Jz` `Jnz` and the ten `Jn*`) is exactly codes 68..=80; the numbers are frozen.
    let c = opCode(op);
    return c >= opCode(Op.Jmp) && c <= opCode(Op.JnDle);
}

/// One instruction. Encoded as 24 bytes in the VM's `Instr` layout: u16 op, u16 aux, u32 dst, u32 a, u32 b, u64 imm.
pub struct Instr {
    op: Op;
    aux: u16;
    dst: u32;
    a: u32;
    b: u32;
    imm: u64;
}

/// Rust `Instr::new`: `aux` 0.
pub fn instr(op: Op, dst: u32, a: u32, b: u32, imm: u64): Instr {
    return Instr { op: op, aux: 0, dst: dst, a: a, b: b, imm: imm };
}

/// How a call site reaches its target. `int(kind)` is the file value (stdlib `CALL_LOCAL` 0, `CALL_SCRIPT` 1,
/// `CALL_NATIVE` 2).
pub enum CallKind {
    /// A function in this module, by index.
    Local,
    /// A function in another script, by key.
    Script,
    /// A native function, through the program's thunk table, by key.
    Native,
}

pub struct CallArg {
    reg: u32;
    size: u32;
    /// The register holds the address of an aggregate, not the value.
    aggregate: bool;
}

pub struct CallSite {
    args: List<CallArg>;
    key: u64;
    kind: CallKind;
    /// Into `BcModule.natives` / `scripts` / `functions` by `kind`.
    index: u32;
    retSize: u32;
    /// Load op that widens a native scalar result into a register (0 for void/aggregate): an op code.
    retLoad: u16;
    retAggregate: bool;
}

/// Scalar register class of a type (Rust `Class`; `Int { bits, signed }` is spelled out per width).
pub enum Class { Void, Bool, I8, U8, I16, U16, I32, U32, I64, U64, F32, F64, Ptr }

/// Width in bits of an integer class, 64 for the rest.
pub fn classBits(c: Class): u32 {
    match c {
        Class.I8 | Class.U8 { return 8; }
        Class.I16 | Class.U16 { return 16; }
        Class.I32 | Class.U32 { return 32; }
        Class.Void | Class.Bool | Class.I64 | Class.U64 | Class.F32 | Class.F64 | Class.Ptr { return 64; }
    }
}

/// A signed integer class.
pub fn classSigned(c: Class): bool {
    match c {
        Class.I8 | Class.I16 | Class.I32 | Class.I64 { return true; }
        Class.Void | Class.Bool | Class.U8 | Class.U16 | Class.U32 | Class.U64 | Class.F32 | Class.F64 | Class.Ptr { return false; }
    }
}

/// Rust `class`: `None` for an aggregate that lives in memory.
pub fn class(cx: &IrCx, ty: Id<TyKind>): Option<Class> {
    match cx.tyKind(ty) {
        TyKind.Void { return Option.Some(Class.Void); }
        TyKind.Bool { return Option.Some(Class.Bool); }
        TyKind.Int(i) {
            match i {
                IntTy.I8 { return Option.Some(Class.I8); }
                IntTy.U8 { return Option.Some(Class.U8); }
                IntTy.I16 { return Option.Some(Class.I16); }
                IntTy.U16 { return Option.Some(Class.U16); }
                IntTy.I32 { return Option.Some(Class.I32); }
                IntTy.U32 { return Option.Some(Class.U32); }
                IntTy.I64 { return Option.Some(Class.I64); }
                IntTy.U64 { return Option.Some(Class.U64); }
            }
        }
        TyKind.Float(f) {
            match f {
                FloatTy.F32 { return Option.Some(Class.F32); }
                FloatTy.F64 { return Option.Some(Class.F64); }
            }
        }
        TyKind.Ptr | TyKind.CStr | TyKind.Ref(_) | TyKind.Fn(_) { return Option.Some(Class.Ptr); }
        // a payloadless enum is its `i32` tag (`ir/abi.j3`)
        TyKind.Enum(e) {
            if cx.enumDef(e.id).isCLike() { return Option.Some(Class.I32); }
            return Option.None;
        }
        TyKind.String | TyKind.Array(_) | TyKind.Slice(_) | TyKind.Struct(_) | TyKind.Half | TyKind.Vec(_) { return Option.None; }
    }
}

/// Rust `is_scalar`: a class other than `Void`.
pub fn isScalar(cx: &IrCx, ty: Id<TyKind>): bool {
    match class(cx, ty) {
        Option.Some(c) { return c != Class.Void; }
        Option.None { return false; }
    }
}

/// The load op that reads a value of this class from memory into a canonical register (Rust `load_op`).
pub fn loadOp(c: Class): Op {
    match c {
        Class.Bool | Class.U8 { return Op.Ld8u; }
        Class.I8 { return Op.Ld8s; }
        Class.I16 { return Op.Ld16s; }
        Class.U16 { return Op.Ld16u; }
        Class.I32 { return Op.Ld32s; }
        Class.U32 | Class.F32 { return Op.Ld32u; }
        Class.Void | Class.I64 | Class.U64 | Class.F64 | Class.Ptr { return Op.Ld64; }
    }
}

/// The store op for `size` bytes (Rust `store_op`).
pub fn storeOp(size: u64): Op {
    if size == 1 { return Op.St8; }
    if size == 2 { return Op.St16; }
    if size == 4 { return Op.St32; }
    return Op.St64;
}

/// The op that re-extends a narrow integer result, if any (Rust `ext_op`).
pub fn extOp(c: Class): Option<Op> {
    match c {
        Class.I8 { return Option.Some(Op.Sext8); }
        Class.U8 { return Option.Some(Op.Zext8); }
        Class.I16 { return Option.Some(Op.Sext16); }
        Class.U16 { return Option.Some(Op.Zext16); }
        Class.I32 { return Option.Some(Op.Sext32); }
        Class.U32 { return Option.Some(Op.Zext32); }
        Class.Void | Class.Bool | Class.I64 | Class.U64 | Class.F32 | Class.F64 | Class.Ptr { return Option.None; }
    }
}

/// A constant's register bits in canonical form (Rust `canonical`).
pub fn canonical(c: Class, bits: u64): u64 {
    match c {
        Class.Bool { if bits != 0 { return 1; } return 0; }
        Class.I8 | Class.I16 | Class.I32 {
            let shift = u64(64) - u64(classBits(c));
            return u64(i64(bits << shift) >> i64(shift));
        }
        Class.U8 | Class.U16 | Class.U32 {
            let shift = u64(64) - u64(classBits(c));
            return (bits << shift) >> shift;
        }
        Class.F32 { return bits & 0xffffffff; }
        Class.Void | Class.I64 | Class.U64 | Class.F64 | Class.Ptr { return bits; }
    }
}
