// Binary encoding (`.j3sb`), the `dump-bc` text, and where a script's bytecode lives on disk.
//
// Part of module j3c.backend.bc.
// Port of: j3c/src/emit/bc/encode.rs
// J3: Little endian, strings length-prefixed, 8-byte pad before each code array, 24 bytes per `Instr`
//     (`load.j3` is the reader, field by field). `dump` prints u64 hashes as 16 hex digits through `Text`
//     (stage-0 hazard (d): a `u64` in `{..}` interpolation prints signed).
module j3c.backend.bc;

/// Rust `BcModule::encode`: the file bytes.
pub fn encode(m: &BcModule, arena: &Arena): List<u8> {
    let out = List<u8>.new(arena);
    out.extend("J3SB" as []u8);
    u16Out(&out, VERSION);
    u16Out(&out, 0);
    u64Out(&out, m.layoutHash);
    u64Out(&out, m.signatureHash);
    stringOut(&out, m.name);
    stringOut(&out, m.path);
    u32Out(&out, m.instanceSize);
    u32Out(&out, m.props);
    u32Out(&out, u32(m.fields.len));
    for i in 0..m.fields.len {
        let f = &m.fields.items[i];
        stringOut(&out, f.name);
        u32Out(&out, f.offset);
        u32Out(&out, f.size);
        bytesOut(&out, f.default.slice());
        u32Out(&out, idxOr(f.defaultConst));
    }
    u32Out(&out, u32(m.globals.len));
    for i in 0..m.globals.len {
        let g = &m.globals.items[i];
        u64Out(&out, g.key);
        stringOut(&out, g.name);
        u32Out(&out, g.size);
        bytesOut(&out, g.init.slice());
        u32Out(&out, idxOr(g.initConst));
    }
    u32Out(&out, u32(m.constants.len));
    for i in 0..m.constants.len { bytesOut(&out, m.constants.items[i].slice()); }
    u32Out(&out, u32(m.natives.len));
    for i in 0..m.natives.len {
        u64Out(&out, m.natives.items[i].key);
        stringOut(&out, m.natives.items[i].label);
    }
    u32Out(&out, u32(m.scripts.len));
    for i in 0..m.scripts.len { stringOut(&out, m.scripts.items[i]); }
    u32Out(&out, u32(m.functions.len));
    for fi in 0..m.functions.len {
        let f = &m.functions.items[fi];
        u64Out(&out, f.key);
        stringOut(&out, f.name);
        stringOut(&out, f.signature);
        u32Out(&out, flag(f.public));
        u32Out(&out, f.frameSize);
        u32Out(&out, f.regs);
        u32Out(&out, f.retSize);
        u32Out(&out, flag(f.retAggregate));
        u32Out(&out, u32(f.params.len));
        for i in 0..f.params.len {
            let p = f.params.items[i];
            u32Out(&out, p.reg);
            u32Out(&out, p.offset);
            u32Out(&out, p.size);
            u32Out(&out, u32(p.load));
        }
        u32Out(&out, u32(f.calls.len));
        for ci in 0..f.calls.len {
            let c = &f.calls.items[ci];
            u32Out(&out, u32(int(c.kind)));
            u64Out(&out, c.key);
            u32Out(&out, c.index);
            u32Out(&out, c.retSize);
            u32Out(&out, u32(c.retLoad));
            u32Out(&out, flag(c.retAggregate));
            u32Out(&out, u32(c.args.len));
            for ai in 0..c.args.len {
                let a = c.args.items[ai];
                u32Out(&out, a.reg);
                u32Out(&out, a.size);
                u32Out(&out, flag(a.aggregate));
            }
        }
        u32Out(&out, u32(f.code.len));
        // Pad so the instruction array starts 8-aligned in the file.
        while out.len % 8 != 0 { out.push(0); }
        for i in 0..f.code.len {
            let ins = f.code.items[i];
            u16Out(&out, opCode(ins.op));
            u16Out(&out, ins.aux);
            u32Out(&out, ins.dst);
            u32Out(&out, ins.a);
            u32Out(&out, ins.b);
            u64Out(&out, ins.imm);
        }
    }
    return out;
}

/// Rust `BcModule::dump`: the `dump-bc` text, appended to `out`.
pub fn dump(m: &BcModule, out: &Text) {
    out.add("j3sb ").pushInt(int(VERSION));
    out.add(" ").add(m.name).add(" (").add(m.path).add(")\nlayout ");
    hex16(out, m.layoutHash);
    out.add(" signatures ");
    hex16(out, m.signatureHash);
    out.add("\ninstance ").pushU64(u64(m.instanceSize));
    out.add(" bytes, ").pushU64(u64(m.props));
    out.add(" props\n");
    for i in 0..m.fields.len {
        let f = &m.fields.items[i];
        out.add("  field ").add(f.name).add(" @").pushU64(u64(f.offset));
        out.add(" size ").pushU64(u64(f.size));
        if f.default.len > 0 { out.add(" default"); }
        out.add("\n");
    }
    for i in 0..m.globals.len {
        out.add("  shared ").add(m.globals.items[i].name).add(" size ").pushU64(u64(m.globals.items[i].size));
        out.add("\n");
    }
    for i in 0..m.natives.len { out.add("  native ").add(m.natives.items[i].label).add("\n"); }
    for i in 0..m.scripts.len { out.add("  script ").add(m.scripts.items[i]).add("\n"); }
    for fi in 0..m.functions.len {
        let f = &m.functions.items[fi];
        out.add("\n");
        if f.public { out.add("pub "); }
        out.add("fn ").add(f.name).add(" [").add(f.signature).add("] frame ").pushU64(u64(f.frameSize));
        out.add(" regs ").pushU64(u64(f.regs));
        out.add("\n");
        for pc in 0..f.code.len {
            out.add("  ");
            pad4(out, u64(pc));
            out.add(" ");
            dumpInstr(f.code.items[pc], f, out);
            out.add("\n");
        }
    }
}

/// Rust `write_to`: write `bytecodePath(root, m.path)`, skipped when the file already holds these bytes (its
/// mtime then stays: the VM's reload and the dev watcher depend on it). Ok = the path.
pub fn writeTo(m: &BcModule, root: string, arena: &Arena): Result<string, string> {
    let p = bytecodePath(root, m.path, arena);
    let bytes = encode(m, arena);
    match io.readFile(p, arena) {
        Result.Ok(old) { if sameBytes(old, bytes.slice()) { return Result.Ok(p); } }
        Result.Err(_) {}
    }
    match io.makeDirs(path.dirname(p)) {
        Result.Ok(_) {}
        Result.Err(_) { return Result.Err(Text.new(arena).add("create ").add(p).add(": ").add(fsx.osError(sys.errno(), arena)).str()); }
    }
    match io.writeFile(p, bytes.slice()) {
        Result.Ok(_) {}
        Result.Err(_) { return Result.Err(Text.new(arena).add("write ").add(p).add(": ").add(fsx.osError(sys.errno(), arena)).str()); }
    }
    return Result.Ok(p);
}

/// `ROOT/target/j3s/SCRIPT` with the extension `.j3sb` (Rust `bytecode_path`: `join` then `with_extension`).
pub fn bytecodePath(root: string, script: string, arena: &Arena): string {
    let full = path.join(path.join(root, "target/j3s", arena), script, arena);
    // Rust `with_extension`: replace the last name's extension (a leading dot is not one), else add it.
    let start = 0;
    for i in 0..full.len { if full[i] == '/' { start = i + 1; } }
    let dot = -1;
    for i in start + 1..full.len { if full[i] == '.' { dot = i; } }
    if dot < 0 { return Text.new(arena).add(full).add(".j3sb").str(); }
    return Text.new(arena).add(full[0..dot]).add(".j3sb").str();
}

fn sameBytes(a: []u8, b: []u8): bool {
    if a.len != b.len { return false; }
    for i in 0..a.len { if a[i] != b[i] { return false; } }
    return true;
}

/// Rust `default_const.unwrap_or(u32::MAX)`.
fn idxOr(o: Option<u32>): u32 {
    match o {
        Option.Some(i) { return i; }
        Option.None { return NO_REG; }
    }
}

fn flag(b: bool): u32 {
    if b { return 1; }
    return 0;
}

/// Rust `{:016x}`.
fn hex16(out: &Text, v: u64) {
    let digits = "0123456789abcdef";
    for i in 0..16 { out.push(digits[int((v >> u64(60 - 4 * i)) & 15)]); }
}

/// Rust `{:04}` of an unsigned number (wider numbers print whole).
fn pad4(out: &Text, v: u64) {
    if v < 1000 { out.add("0"); }
    if v < 100 { out.add("0"); }
    if v < 10 { out.add("0"); }
    out.pushU64(v);
}

/// Rust `reg_name`: `_` (no register), `fp`, `rN`.
fn regName(r: u32, out: &Text) {
    if r == NO_REG {
        out.add("_");
    } else if r == FP {
        out.add("fp");
    } else {
        out.add("r").pushU64(u64(r));
    }
}

/// Rust `dump_instr`: one instruction's `dump-bc` text.
fn dumpInstr(ins: Instr, f: &BcFunction, out: &Text) {
    out.add(opName(ins.op));
    match ins.op {
        Op.Const {
            out.add(" "); regName(ins.dst, out); out.add(", 0x"); out.pushHex(ins.imm);
        }
        Op.Global { out.add(" "); regName(ins.dst, out); out.add(", shared#").pushU64(ins.imm); }
        Op.Str { out.add(" ["); regName(ins.a, out); out.add("], const#").pushU64(ins.imm); }
        Op.Addr { out.add(" "); regName(ins.dst, out); out.add(", "); regName(ins.a, out); out.add("+").pushU64(ins.imm); }
        Op.Idx {
            out.add(" "); regName(ins.dst, out); out.add(", "); regName(ins.a, out); out.add("+"); regName(ins.b, out);
            out.add("*").pushU64(ins.imm);
        }
        Op.Ld8s | Op.Ld8u | Op.Ld16s | Op.Ld16u | Op.Ld32s | Op.Ld32u | Op.Ld64 {
            out.add(" "); regName(ins.dst, out); out.add(", ["); regName(ins.a, out); out.add("+").pushU64(ins.imm); out.add("]");
        }
        Op.St8 | Op.St16 | Op.St32 | Op.St64 {
            out.add(" ["); regName(ins.a, out); out.add("+").pushU64(ins.imm); out.add("], "); regName(ins.b, out);
        }
        Op.Copy { out.add(" ["); regName(ins.a, out); out.add("], ["); regName(ins.b, out); out.add("], ").pushU64(ins.imm); }
        Op.Jmp { out.add(" "); pad4(out, ins.imm); }
        Op.Jz | Op.Jnz { out.add(" "); regName(ins.a, out); out.add(", "); pad4(out, ins.imm); }
        Op.JnLts | Op.JnLes | Op.JnLtu | Op.JnLeu | Op.JnEq | Op.JnNe | Op.JnFlt | Op.JnFle | Op.JnDlt | Op.JnDle {
            out.add(" "); regName(ins.a, out); out.add(", "); regName(ins.b, out); out.add(", "); pad4(out, ins.imm);
        }
        Op.Call { out.add(" "); regName(ins.dst, out); out.add(" = "); dumpCall(&f.calls.items[int(ins.imm)], out); }
        Op.Ret | Op.Abort | Op.Div0 {}
        Op.RetV { out.add(" "); regName(ins.a, out); }
        Op.RetA { out.add(" ["); regName(ins.a, out); out.add("], ").pushU64(ins.imm); }
        Op.AppLit { out.add(" ["); regName(ins.dst, out); out.add("], ["); regName(ins.a, out); out.add("], const#").pushU64(ins.imm); }
        Op.AppStr | Op.AppInt | Op.AppF64 | Op.AppBool {
            out.add(" ["); regName(ins.dst, out); out.add("], ["); regName(ins.a, out); out.add("], "); regName(ins.b, out);
        }
        Op.Mov | Op.Neg | Op.Not | Op.Bnot | Op.Fneg | Op.Dneg | Op.Sext8 | Op.Sext16 | Op.Sext32 | Op.Zext8 | Op.Zext16 | Op.Zext32
            | Op.I2f | Op.U2f | Op.F2i | Op.F2u | Op.I2d | Op.U2d | Op.D2i | Op.D2u | Op.F2d | Op.D2f {
            out.add(" "); regName(ins.dst, out); out.add(", "); regName(ins.a, out);
        }
        Op.Add | Op.Sub | Op.Mul | Op.Divs | Op.Rems | Op.Divu | Op.Remu | Op.Eq | Op.Ne | Op.Lts | Op.Les | Op.Ltu | Op.Leu
            | Op.Fadd | Op.Fsub | Op.Fmul | Op.Fdiv | Op.Feq | Op.Fne | Op.Flt | Op.Fle
            | Op.Dadd | Op.Dsub | Op.Dmul | Op.Ddiv | Op.Deq | Op.Dne | Op.Dlt | Op.Dle
            | Op.Land | Op.Lor | Op.Band | Op.Bor | Op.Bxor {
            out.add(" "); regName(ins.dst, out); out.add(", "); regName(ins.a, out); out.add(", "); regName(ins.b, out);
        }
    }
}

/// A call's target and arguments: `local#N(..)`, `script KEY(..)`, `native KEY(..)`; aggregates in `[..]`.
fn dumpCall(site: &CallSite, out: &Text) {
    match site.kind {
        CallKind.Local { out.add("local#").pushU64(u64(site.index)); }
        CallKind.Script { out.add("script "); hex16(out, site.key); }
        CallKind.Native { out.add("native "); hex16(out, site.key); }
    }
    out.add("(");
    for i in 0..site.args.len {
        let a = site.args.items[i];
        if i > 0 { out.add(", "); }
        if a.aggregate { out.add("["); regName(a.reg, out); out.add("]"); } else { regName(a.reg, out); }
    }
    out.add(")");
}

fn u16Out(out: &List<u8>, n: u16) {
    out.push(u8(n & 0xFF));
    out.push(u8(n >> 8));
}

fn u32Out(out: &List<u8>, n: u32) {
    for i in 0..4 { out.push(u8((n >> u32(8 * i)) & 0xFF)); }
}

fn u64Out(out: &List<u8>, n: u64) {
    for i in 0..8 { out.push(u8((n >> u64(8 * i)) & 0xFF)); }
}

/// Length (u32) then the bytes.
fn bytesOut(out: &List<u8>, bytes: []u8) {
    u32Out(out, u32(bytes.len));
    out.extend(bytes);
}

fn stringOut(out: &List<u8>, s: string) { bytesOut(out, s as []u8); }
