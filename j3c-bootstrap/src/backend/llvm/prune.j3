// Drop declarations no emitted line mentions.
//
// Part of module j3c.backend.llvm.
// Port of: j3c/src/emit/llvm/prune.rs
// J3: Entry: `pruneUnused(text, out)` = Rust `prune_unused(text) -> String`; the kept lines append to
// `out`. The name sets are `Set<string>` used for membership only; the output follows the line order
// (rule 3). The type closure walks a worklist like Rust's (its order does not change the result).
module j3c.backend.llvm;

fn nameByte(c: u8): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '.' || c == '$';
}

/// Length of the name at the start of `s`.
fn nameLen(s: string): int {
    let n = 0;
    while n < s.len && nameByte(s[n]) { n += 1; }
    return n;
}

/// The name a declaration line introduces: `declare ... @f(`, `@g = external ...`, `%T = type ...`;
/// sigil 0 for none.
struct Decl {
    sigil: u8;
    name: string;
}

fn declaredName(line: string): Decl {
    let none = Decl { sigil: 0, name: "" };
    if startsWith(line, "declare ") {
        let at = 0;
        while at < line.len && line[at] != '@' { at += 1; }
        if at == line.len { return none; }
        let rest = line[at + 1..line.len];
        return Decl { sigil: '@', name: rest[0..nameLen(rest)] };
    }
    if line.len > 0 && (line[0] == '@' || line[0] == '%') {
        let rest = line[1..line.len];
        let n = nameLen(rest);
        if line[0] == '@' && startsWith(rest[n..rest.len], " = external ") { return Decl { sigil: '@', name: rest[0..n] }; }
        if line[0] == '%' && startsWith(rest[n..rest.len], " = type ") { return Decl { sigil: '%', name: rest[0..n] }; }
    }
    return none;
}

/// Where the line starting at `s` ends (its `\n`, or the end of `text`).
fn lineEnd(text: string, s: int): int {
    let e = s;
    while e < text.len && text[e] != '\n' { e += 1; }
    return e;
}

/// The `@name` / `%name` tokens of an LLVM text line that `known` has (the only ones a later lookup asks
/// about; `%` also matches locals, which `known` drops).
fn llNamesKnown(line: string, sigil: u8, known: &Map<string, int>, out: &Set<string>) {
    let i = 0;
    while i < line.len {
        if line[i] != sigil { i += 1; continue; }
        let rest = line[i + 1..line.len];
        let n = nameLen(rest);
        if n > 0 && known.has(rest[0..n]) { out.add(rest[0..n]); }
        i += 1 + n;
    }
}

/// Drop the declarations and types a per-module text never uses. Every module declares the whole
/// program (types, `use lib` bindings, foreign globals and functions), which clang would parse for
/// every object. A `; use lib` comment goes with the declaration under it (Rust `prune_unused`).
/// J3: The lines are walked in place (no line or decl lists) and the name sets hold declared names only
/// (Rust's hold every `%` local too); `out` is sized for the whole text once. Same kept lines: a name no
/// line declares is never looked up.
pub fn pruneUnused(text: string, out: &Text) {
    let arena = out.arena;
    let need = out.bytes.len + text.len + 1;
    if out.cap < need {
        let fresh = arena.alloc::<u8>(need);
        for k in 0..out.bytes.len { fresh[k] = out.bytes[k]; }
        out.bytes = []u8 { ptr: fresh.ptr, len: out.bytes.len };
        out.cap = need;
    }
    // Declared names: `@` ones (value unused) and `%` types with the start of their line (the last wins).
    let funcs = Map<string, int>.new(arena, 256);
    let byType = Map<string, int>.new(arena, 64);
    let s = 0;
    while s < text.len {
        let e = lineEnd(text, s);
        let d = declaredName(text[s..e]);
        if d.sigil == '@' { funcs.put(d.name, s); }
        if d.sigil == '%' { byType.put(d.name, s); }
        s = e + 1;
    }
    let used = Set<string>.new(arena, 256);
    let types = Set<string>.new(arena, 256);
    s = 0;
    while s < text.len {
        let e = lineEnd(text, s);
        let line = text[s..e];
        let d = declaredName(line);
        if d.sigil == 0 && !isLibNote(line) {
            llNamesKnown(line, '@', &funcs, &used);
            llNamesKnown(line, '%', &byType, &types);
        }
        s = e + 1;
    }
    // Kept `@` declarations name types too; then close over the type lines themselves.
    s = 0;
    while s < text.len {
        let e = lineEnd(text, s);
        let line = text[s..e];
        let d = declaredName(line);
        if d.sigil == '@' && used.has(d.name) { llNamesKnown(line, '%', &byType, &types); }
        s = e + 1;
    }
    let stack = List<string>.new(arena);
    s = 0;
    while s < text.len {
        let e = lineEnd(text, s);
        let d = declaredName(text[s..e]);
        // the seed set is every name seen so far; walking each type line once covers it
        if d.sigil == '%' && types.has(d.name) { stack.push(d.name); }
        s = e + 1;
    }
    while stack.len > 0 {
        let t = stack.pop();
        match byType.get(t) {
            Option.Some(at) {
                let line = text[at..lineEnd(text, at)];
                let k = 0;
                while k + 8 <= line.len && line[k..k + 8] != " = type " { k += 1; }
                if k + 8 <= line.len {
                    let body = line[k + 8..line.len];
                    let j = 0;
                    while j < body.len {
                        if body[j] != '%' { j += 1; continue; }
                        let n = nameLen(body[j + 1..body.len]);
                        let name = body[j + 1..j + 1 + n];
                        if n > 0 && byType.has(name) && types.add(name) { stack.push(name); }
                        j += 1 + n;
                    }
                }
            }
            Option.None {}
        }
    }
    s = 0;
    while s < text.len {
        let e = lineEnd(text, s);
        let line = text[s..e];
        s = e + 1;
        if isLibNote(line) {
            if s < text.len {
                let next = declaredName(text[s..lineEnd(text, s)]);
                if next.sigil != 0 && !keepDecl(next, &used, &types) { continue; }
            }
        } else if !keepDecl(declaredName(line), &used, &types) {
            continue;
        }
        out.add(line).push('\n');
    }
}

fn keepDecl(d: Decl, used: &Set<string>, types: &Set<string>): bool {
    if d.sigil == 0 { return true; }
    if d.sigil == '@' { return used.has(d.name); }
    return types.has(d.name);
}

/// A `; use lib "NAME"` note line.
// ponytail: spelled without the space before the quote: stage 0's link-lib scan (Rust `host::libs_from_c`)
// is not anchored and would read a `"; use lib "` string constant in this binary's own .ll as a library.
fn isLibNote(line: string): bool {
    return startsWith(line, "; use lib") && line.len > 9 && line[9] == ' ';
}
