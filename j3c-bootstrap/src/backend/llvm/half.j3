// `f16` as `i16` bits; `half` only inside conversions (`fptrunc` / `fpext`, round to nearest even). Ints go
// through `double` so there is a single rounding.
//
// Part of module j3c.backend.llvm.
// Port of: j3c/src/emit/llvm_expr/half.rs
// J3: Entry: `halfCast` (None when neither side is `f16`).
module j3c.backend.llvm;

extend LlvmFn {
    /// Value `v` (LLVM type `ft`) converted from `from` to `to` when one of them is `f16`.
    fn halfCast(this: &LlvmFn, from: Id<TyKind>, to: Id<TyKind>, v: string, ft: string): Result<Option<string>, string> {
        let h = this.cx.common.f16;
        if to == h && from != h {
            let src = v;
            let st = ft;
            if isInt(this.cx, from) {
                let op = if isSignedInt(this.cx, from) { "sitofp" } else { "uitofp" };
                src = this.fresh();
                this.inst(this.l().add(src).add(" = ").add(op).add(" ").add(ft).add(" ").add(v).add(" to double").str());
                st = "double";
            }
            let half = this.fresh();
            this.inst(this.l().add(half).add(" = fptrunc ").add(st).add(" ").add(src).add(" to half").str());
            let bits = this.fresh();
            this.inst(this.l().add(bits).add(" = bitcast half ").add(half).add(" to i16").str());
            return Result.Ok(Option.Some(bits));
        }
        if from == h && to != h {
            let half = this.fresh();
            this.inst(this.l().add(half).add(" = bitcast i16 ").add(v).add(" to half").str());
            let tt = llType(this.cx, to, this.arena)?;
            let out = this.fresh();
            this.inst(this.l().add(out).add(" = fpext half ").add(half).add(" to ").add(tt).str());
            return Result.Ok(Option.Some(out));
        }
        return Result.Ok(Option.None);
    }
}
