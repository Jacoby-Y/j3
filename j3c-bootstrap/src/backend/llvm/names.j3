// Symbol names: struct/enum type names, global and fn linker symbols, the stable type text fn names hash.
//
// Part of module j3c.backend.llvm.
// Port of: j3c/src/emit/c_ty.rs (sanitize, module_ident, struct_c_name, enum_c_name), emit/c_expr/names.rs
// J3: `sanitize`, `module_ident` and `stable_ty` live in `ir/names.j3` (lower names instances with them).
// J3: The C backend is gone (DELETED.md) but LLVM kept its symbol names; these are its only readers.
// J3: `func_c_name` hashes with Rust's `DefaultHasher` (SipHash-1-3, keys 0, each `str` written as its bytes
// then 0xff), ported as `sip13`: the suffix must match stage 0's byte for byte. The name is recomputed per
// use, as in Rust.
// ponytail: no memo of fn names; a `Map<Id<Func>, string>` if emit profiles show the hash.
module j3c.backend.llvm;

/// `j3_<module>_<Name>_<id>` (Rust `c_ty::struct_c_name`).
pub fn pushStructName(t: &Text, cx: &IrCx, id: Id<StructDef>) {
    let def = cx.structDef(id);
    t.add("j3_");
    pushModuleIdent(t, cx, &def.moduleName);
    t.push('_');
    pushSanitized(t, cx.nameStr(def.name));
    t.fmt(`_{id.i}`);
}

/// `j3_<module>_<Name>_<id>` (Rust `c_ty::enum_c_name`).
pub fn pushEnumName(t: &Text, cx: &IrCx, id: Id<EnumDef>) {
    let def = cx.enumDef(id);
    t.add("j3_");
    pushModuleIdent(t, cx, &def.moduleName);
    t.push('_');
    pushSanitized(t, cx.nameStr(def.name));
    t.fmt(`_{id.i}`);
}

/// `j3g_<module>_<name>` (Rust `global_c_name`).
pub fn globalName(cx: &IrCx, g: &GlobalDef, arena: &Arena): string {
    let t = Text.new(arena);
    t.add("j3g_");
    pushModuleIdent(&t, cx, &g.moduleName);
    t.push('_');
    pushSanitized(&t, cx.nameStr(g.name));
    return t.str();
}

/// `pushFuncName`'s hash input (the process has one thread; forked workers get their own copy).
#[singleton]
let NAME_HASH: [4096]u8;

/// Linker symbol `j3_<module>_<name>_<hash>`. The suffix is a hash of the signature (and a method's type
/// arguments), not the fn id: ids are assigned from the entry file outward, so a new function there would
/// rename the stdlib and bust an object cache (Rust `func_c_name`).
pub fn pushFuncName(t: &Text, cx: &IrCx, func: &Func) {
    // The hash input goes in one reused buffer (a fresh `Text` per call left ~1 KB per symbol in the
    // arena); a longer one spills into `t.arena` as before.
    let h = Text { bytes: []u8 { ptr: NAME_HASH[..].ptr, len: 0 }, cap: 4096, arena: t.arena };
    pushModuleIdent(&h, cx, &func.moduleName);
    h.push(0xFF);
    h.add(cx.nameStr(func.name)).push(0xFF);
    match func.methodOf {
        Option.Some(sid) {
            let def = cx.structDef(sid);
            pushModuleIdent(&h, cx, &def.moduleName);
            h.push(0xFF);
            h.add(cx.nameStr(def.name)).push(0xFF);
            for i in 0..def.tyArgs.len {
                h.add(def.tyArgs.items[i].name).push(0xFF);
                pushStableTy(&h, cx, def.tyArgs.items[i].ty, 0);
                h.push(0xFF);
            }
        }
        Option.None {}
    }
    match cx.fnSig(func.ty) {
        Option.Some(sig) {
            for i in 0..sig.params.len {
                pushStableTy(&h, cx, sig.params.items[i], 0);
                h.push(0xFF);
            }
            pushStableTy(&h, cx, sig.ret, 0);
            h.push(0xFF);
        }
        Option.None {}
    }
    t.add("j3_");
    pushModuleIdent(t, cx, &func.moduleName);
    t.push('_');
    pushSanitized(t, cx.nameStr(func.name));
    t.push('_');
    pushHex16(t, sip13(h.str() as []u8), false);
}

pub fn funcName(cx: &IrCx, func: &Func, arena: &Arena): string {
    let t = Text.new(arena);
    pushFuncName(&t, cx, func);
    return t.str();
}

/// `v` as 16 hex digits (Rust `{:016x}` / `{:016X}`).
pub fn pushHex16(t: &Text, v: u64, upper: bool) {
    let digits = "0123456789abcdef";
    if upper { digits = "0123456789ABCDEF"; }
    let s = 60;
    while s >= 0 {
        t.push(digits[int((v >> u64(s)) & 15)]);
        s -= 4;
    }
}

fn rotl(x: u64, b: u64): u64 { return (x << b) | (x >> (64 - b)); }

/// SipHash-1-3 with zero keys over `m` (Rust's `DefaultHasher` fed the same bytes).
pub fn sip13(m: []u8): u64 {
    let v0: u64 = 0x736f6d6570736575;
    let v1: u64 = 0x646f72616e646f6d;
    let v2: u64 = 0x6c7967656e657261;
    let v3: u64 = 0x7465646279746573;
    let n = m.len;
    let full = n - n % 8;
    let i = 0;
    let rounds = 0;
    let last: u64 = u64(n & 255) << 56;
    for k in 0..(n % 8) { last = last | (u64(m[full + k]) << u64(8 * k)); }
    while i <= full {
        let w: u64 = last;
        if i < full {
            w = 0;
            for k in 0..8 { w = w | (u64(m[i + k]) << u64(8 * k)); }
        }
        v3 = v3 ^ w;
        // one compression round (c = 1)
        v0 += v1; v1 = rotl(v1, 13); v1 = v1 ^ v0; v0 = rotl(v0, 32);
        v2 += v3; v3 = rotl(v3, 16); v3 = v3 ^ v2;
        v0 += v3; v3 = rotl(v3, 21); v3 = v3 ^ v0;
        v2 += v1; v1 = rotl(v1, 17); v1 = v1 ^ v2; v2 = rotl(v2, 32);
        v0 = v0 ^ w;
        i += 8;
    }
    v2 = v2 ^ 0xff;
    while rounds < 3 {
        v0 += v1; v1 = rotl(v1, 13); v1 = v1 ^ v0; v0 = rotl(v0, 32);
        v2 += v3; v3 = rotl(v3, 16); v3 = v3 ^ v2;
        v0 += v3; v3 = rotl(v3, 21); v3 = v3 ^ v0;
        v2 += v1; v1 = rotl(v1, 17); v1 = v1 ^ v2; v2 = rotl(v2, 32);
        rounds += 1;
    }
    return v0 ^ v1 ^ v2 ^ v3;
}
