// Chunked modules: the cost of each fn and which chunk defines it.
//
// Part of module j3c.backend.llvm.
// Port of: j3c/src/emit/llvm.rs (`func_weights`, `chunk_assign`)
// J3: `funcWeights` needs the IR dump of one fn; `backend/llvm.j3` (frozen in wave 20) does not import
// `j3c.ir.dump`, so that one `use` is here (the only part file with a `use`; move it to `llvm.j3` when it
// thaws).
module j3c.backend.llvm;

use j3.cmp.sortBy;
use j3c.ir.dump.dumpFunc;

/// Rust `func_weights`: rough cost of each fn of `m.funcs`, the length of its IR dump (0 for non-J3 kinds).
pub fn funcWeights(cx: &IrCx, m: &Module, arena: &Arena): List<int> {
    let out = List<int>.new(arena);
    let t = Text.new(arena);
    for i in 0..m.funcs.len {
        let f = cx.func(m.funcs.items[i]);
        match f.kind {
            FuncKind.J3(_) {
                t.clear();
                dumpFunc(cx, &f, &t);
                out.push(t.len());
            }
            FuncKind.Lib(_) { out.push(0); }
            FuncKind.Decl { out.push(0); }
        }
    }
    return out;
}

struct Weighed {
    w: int;
    i: int;
}

/// Rust `chunk_assign`: which of `n` chunks defines each fn given the weights `w`: biggest first into the
/// lightest chunk (ties: the lowest index, stable order).
pub fn chunkAssign(w: []int, n: int, arena: &Arena): List<int> {
    let order = List<Weighed>.new(arena);
    let part = List<int>.new(arena);
    for i in 0..w.len {
        order.push(Weighed { w: w[i], i: i });
        part.push(0);
    }
    sortBy(order.items[0..order.len], fn(a: Weighed, b: Weighed): bool { return a.w > b.w; });
    let load = List<int>.new(arena);
    for _ in 0..(if n < 1 { 1 } else { n }) { load.push(0); }
    for k in 0..order.len {
        let c = 0;
        for j in 1..load.len {
            if load.items[j] < load.items[c] { c = j; }
        }
        let x = order.items[k].w;
        load.items[c] += if x < 1 { 1 } else { x };
        part.items[order.items[k].i] = c;
    }
    return part;
}
