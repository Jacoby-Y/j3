// The one compiler entry (plan 11 B1). `Options` says what to do: entry, target, mode (Build, Check, Lib, Tool,
// Dev), headless, fast, opt, debug, emit. `Session` owns one compile: options, arena, interner, diags, sources,
// the module graph and tables. `driver.run(&Session, upTo: Stage)` runs load, sema, lower, the IR passes,
// backend, toolchain and cache, stopping after `upTo`.
//
// Port of: j3c/src/compile.rs (its eight compile_*/check_path_lib entry points and analyze_*)
// J3: Every command and tool (cmd/*, lsp, mcp, editor, pkgtool, dist) builds `Options` and calls `run`. A new
//     flag is one field plus the code that reads it, never another entry point.
// J3: One arena per `Session` (B6): a compile allocates only there, and the session is dropped whole when a
//     newer one replaces it (LSP, MCP and editor helpers run for hours). Memo entries that outlive it are
//     copied into a size-capped cache arena. `Session.new` returns a pointer into the session's own arena;
//     `free` unmaps it, so the pointer is dead after.
// J3: `Options` strings are argv or static text (they outlive every session); anything else is copied in.
// J3: Stage functions take explicit inputs (B5): load one file, sema one module given its deps' signatures,
//     lower one module given all signatures, one object per module. No global state, so the
//     `(stage, module, input hash)` memo table can be added after parity without reshaping them.
// J3: Holds the ordered IR pass list (`ir/passes.j3` has the runner): only this stage sees `ir` and `devmode`.
//     Order is Rust's: validate (in check), fast (end of load_and_check), devmode (devrun, after bytecode).
// J3: `run` walks `STAGES` (one row per `Stage`). Load is real (C1: `load.loadProgram`, the program in
//     `Session.loaded`); sema and lower call their entries (C2); passes run `ir/passes.j3` (validate is
//     real, fast is `ir/fast.j3`, devmode is `devmode.j3` (bytecode into `Session.bytecode`, then lower)); backend (C2a) works out the build settings
//     (`Session.emit`, Rust `emit_opts`) and emits the `.ll` text into `Session.ll` (not when the object
//     cache takes the build: C3); link runs clang through `toolchain`, or `cache.compile` (per-module or
//     ThinLTO objects), and leaves the program's path in `Session.exe`. A not-ported stage adds a code-0
//     error "STAGE: not ported yet" and returns false, which stops the walk.
// J3: `Options` covers compile.rs's entry-point params (entry, target, headless = GameBackend::Headless,
//     Mode Lib = !require_main, Mode Dev = load_and_check_with(dev), Tool = compile_tool) and the build/run
//     flags that reach the compiler (`--fast`, `--release`, `--emit`, `--opt`, `--file`, `--host`, `--hot`,
//     plus the new `--dump-after`, `--time-passes`). `--frames`/`--screenshot`/`--splash` are env for the
//     program, not compiler options.
// J3: `Mode.Dev` with a `.j3s` loaded is Rust's `devrun` build (`cmd/devrun.j3` drives it): the `devmode` pass
//     runs, `emitOpts` points the output at `devOut`, and below `-O2` without the object cache `linkStage`
//     builds the VM apart (`splitVm`, `toolchain.compileLlvmSplit`). Without scripts it is a plain build.
// J3: Part `driver/emit.j3`: build settings (`emitOpts`, `applyFlags`), the backend and link stages, `dump-llvm`'s
//     text. `failText` (the errors of a failed run as Rust's error string) is here so `pkgtool` and `cmd/*` share it.
module j3c.driver;

use j3.data.pool.{ Id, Pool };
use j3.data.set.Set;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.backend;
use j3c.cache;
use j3c.backend.bc.BcModule;
use j3c.backend.llvm;
use j3c.backend.llvm.{ LlOpts, Part, PartKind };
use j3c.devmode;
use j3c.base.diag;
use j3c.base.diag.{ Diags, Severity };
use j3c.base.intern.{ Names, Sym };
use j3c.base.phase.Phases;
use j3c.base.span.{ Source, isNone, noSpan };
use j3c.ir.{ Func, Pass, PassCx, Program, runPasses };
use j3c.ir.dump;
use j3c.ir.fast;
use j3c.ir.validate;
use j3c.load;
use j3c.load.{ LoadCx, LoadOpts, Parsed };
use j3c.lower;
use j3c.lower.LowerCx;
use j3c.project.manifest;
use j3c.project.manifest.Manifest;
use j3c.sema;
use j3c.sema.Checked;
use j3c.toolchain;
use j3c.ui;
use j3c.toolchain.{ EmitOpts, defaultEmitOpts };

pub enum Mode { Build, Check, Lib, Tool, Dev }

/// Pipeline stages in order; `run` stops after the one it is given.
pub enum Stage { Load, Sema, Lower, Passes, Backend, Link }

/// Everything a command can ask of the compiler. One field per flag.
pub struct Options {
    /// Entry file, project dir or `j3.toml`; "" for the project in the cwd, else the built-in hello.
    entry: string;
    /// The command line had a path (Rust `Option<&str>`): an explicit `""` is then a bad path, not the cwd.
    entryGiven: bool;
    /// Target triple, "" for the host.
    target: string;
    mode: Mode;
    headless: bool;
    fast: bool;
    /// `--opt LEVEL` (`0`..`3`, `s`, `z`), "" for the manifest's (Rust `cli::OPT`).
    opt: string;
    debug: bool;
    /// Backend name (`llvm`, `bc`), "" for the manifest's.
    emit: string;
    /// `--dump-after=PASS`, "" for none.
    dumpAfter: string;
    timePasses: bool;
    /// `--release`: opt s, no `-g`, stripped, no unwind tables (Rust `cli::RELEASE`).
    release: bool;
    /// `--file`: a `.j3` entry is built alone even inside a project (`project::FILE_ONLY`).
    fileOnly: bool;
    /// `--host`: ignore the manifest's `[emit] targets` (`project::HOST`).
    host: bool;
    /// `run --hot`: rebuild and reload on change (`cli::HOT`).
    hot: bool;
    /// The command runs the program after the link (`run`): an Android target is refused, and a program
    /// without a manifest output path goes to a temp file (`build` writes `target/a.out`).
    run: bool;
    /// A ready manifest to build instead of resolving `entry` (Rust `compile_tool(&manifest)`, `pkgtool`).
    project: Option<Manifest>;
}

/// Rust `run_loaded`: why an Android target is not run here (`cmd/run.j3` prints it before `preflight`).
pub const ANDROID_RUN: string = "this is an Android target, which can't run on this machine; build an apk to run it on a device or emulator, or `j3c run --host` for a host build of the same source";

/// Defaults: check the project in the cwd, dev settings.
pub fn defaults(): Options {
    return Options { entry: ".", entryGiven: true, target: "", mode: Mode.Check, headless: false, fast: false, opt: "", debug: true, emit: "", dumpAfter: "", timePasses: false, release: false, fileOnly: false, host: false, hot: false,
        run: false, project: Option.None };
}

/// One compile. Everything it allocates is in `arena`.
pub struct Session {
    opts: Options;
    arena: &Arena;
    names: Names;
    diags: Diags;
    sources: Pool<Source>;
    phases: Phases;
    /// The parsed module graph, after `Stage.Load`.
    loaded: Option<Parsed>;
    /// Sema's output (tables + typed tree), after `Stage.Sema`.
    checked: Option<&Checked>;
    /// The lowered IR, after `Stage.Lower` (the passes change it in place).
    program: Option<&Program>;
    /// Build settings (Rust `EmitOpts`), set by `Stage.Backend`.
    emit: EmitOpts;
    /// The backend's output (`.ll` text), after `Stage.Backend`.
    ll: string;
    /// The built program, after `Stage.Link`.
    exe: string;
    /// Script bytecode from the un-rewritten IR, filled by the `devmode` pass (Mode.Dev with scripts) just before
    /// it rewrites the IR; `cmd/devrun` writes the `.j3sb` files from it. Empty otherwise.
    bytecode: List<BcModule>;
    /// Stages already run (`stageIndex` of the last + 1): a second `run` resumes after them.
    done: int;

    /// A new session in its own arena.
    fn new(opts: Options): &Session {
        let a = Arena.create(1 << 16);
        // The arena lives inside itself: copy it into its own first cell, then allocate only through that.
        let cell = a.alloc::<Arena>(1);
        cell[0] = a;
        let ap = &cell[0];
        let s = ap.new::<Session>(Session { opts: opts, arena: ap, names: Names.new(ap), diags: Diags.new(ap), sources: Pool<Source>.new(ap), phases: Phases.new(ap), loaded: Option.None,
            checked: Option.None, program: Option.None, emit: defaultEmitOpts(ap), ll: "", exe: "", bytecode: List<BcModule>.new(ap), done: 0 });
        if opts.timePasses { s.phases.enable(); }
        return s;
    }

    /// Release everything the session allocated, the session itself included. `this` is dead after.
    fn free(this: &Session) {
        let a = *this.arena;
        a.destroy();
    }
}

/// The IR passes in order (validate, fast, devmode), allocated in `arena`. A new pass is one entry.
pub fn passes(arena: &Arena): []Pass {
    let ps = arena.alloc::<Pass>(3);
    ps[0] = Pass { name: "validate", cond: fn(cx: &PassCx): bool { return cx.validate; }, run: validatePass };
    ps[1] = Pass { name: "fast", cond: fn(cx: &PassCx): bool { return cx.fast; }, run: fastPass };
    ps[2] = Pass { name: "devmode", cond: fn(cx: &PassCx): bool { return cx.dev && cx.scripts; }, run: devPass };
    return ps;
}

/// Rust `check/mod.rs`: `validate_module` on every module; the first failure is an error (a compiler bug).
fn validatePass(cx: &PassCx, prog: &Program) {
    match validate.validateProgram(prog) {
        Result.Ok(_) {}
        Result.Err(e) { cx.diags.add(cx.diags.make(0, Severity.Error, noSpan(), e.message)); }
    }
}
/// Rust `compile::apply_fast` / the `[cc] fast` branch of `load_and_check`.
fn fastPass(cx: &PassCx, prog: &Program) { fast.stripAborts(&prog.cx); }
/// Rust `devrun::prepare` steps 3-4: bytecode from the IR as checked (into `Session.bytecode` through
/// `cx.bytecode`), then `devmode.lower` with it. An Err is a code-0 error with Rust's text.
fn devPass(cx: &PassCx, prog: &Program) {
    let out = cx.bytecode as &List<BcModule>;
    match devmode.bytecode(prog, cx.arena) {
        Result.Ok(bc) { *out = bc; }
        Result.Err(e) { cx.diags.add(cx.diags.make(0, Severity.Error, noSpan(), e)); return; }
    }
    match devmode.lower(prog, out.slice(), cx.arena) {
        Result.Ok(_) {}
        Result.Err(e) { cx.diags.add(cx.diags.make(0, Severity.Error, noSpan(), e)); }
    }
}

/// The pass context for `s` (flags from its `Options`); `dump` runs after `--dump-after`'s pass.
pub fn passCx(s: &Session, dump: fn(&PassCx, &Program)): PassCx {
    let dev = false;
    match s.opts.mode {
        Mode.Dev { dev = true; }
        Mode.Build {}
        Mode.Check {}
        Mode.Lib {}
        Mode.Tool {}
    }
    // `scripts`: any loaded `.j3s` (Rust `dev::has_scripts`). `fast`: the flag, or the manifest's `[cc] fast` /
    // `[emit] fast` (Rust `load_and_check`).
    let isFast = s.opts.fast;
    let scripts = scriptsLoaded(s);
    match s.loaded {
        Option.Some(p) {
            match p.project {
                Option.Some(m) { if m.cc.fast || m.emit.fast { isFast = true; } }
                Option.None {}
            }
        }
        Option.None {}
    }
    // Rust validates in every check (`check/mod.rs`), release or not.
    return PassCx { dev: dev, fast: isFast, validate: true, scripts: scripts, dumpAfter: s.opts.dumpAfter,
        timePasses: s.opts.timePasses, arena: s.arena, diags: &s.diags, phases: &s.phases, dump: dump, bytecode: &s.bytecode as ptr };
}

/// Any loaded `.j3s` (Rust `dev::has_scripts` before lowering): with `Mode.Dev` the `devmode` pass runs and
/// the program is the dev binary (`devOut`).
pub fn scriptsLoaded(s: &Session): bool {
    match s.loaded {
        Option.Some(p) { for i in 0..p.files.len { if p.files.items[i].ast.isScript { return true; } } }
        Option.None {}
    }
    return false;
}

/// A dev build of a program with scripts (`Mode.Dev`, a `.j3s` loaded).
fn devScripts(s: &Session): bool { return s.opts.mode == Mode.Dev && scriptsLoaded(s); }

/// Rust `devrun::dev_out`: the dev binary `<bin>-dev` in its own `target/.j3c/<host>/<bin>-dev/` folder,
/// never beside the real output.
pub fn devOut(m: &Manifest, arena: &Arena): string {
    let out = m.outPath(arena);
    let name = Text.new(arena).add(m.bin).add("-dev").str();
    let dev = path.join(path.dirname(out), name, arena);
    return path.join(toolchain.cacheDir(dev, m.emit.primary(), arena), name, arena);
}

/// Run the IR passes of `s` on `prog`; false on an error.
pub fn runIr(s: &Session, prog: &Program): bool {
    let cx = passCx(s, dumpToStdout);
    return runPasses(passes(s.arena), &cx, prog);
}

/// `--dump-after`: the IR text of `prog` on stdout.
fn dumpToStdout(cx: &PassCx, prog: &Program) {
    let t = Text.new(cx.arena);
    dump.dumpProgram(prog, &t);
    t.flushTo(1);
}

/// One row of the pipeline: `run` false (or an error Diag) stops the walk. `phase` is the Rust `phase.rs`
/// `OUTER` name the stage runs under (lower and the passes run inside Rust's `check`; clang's `compile`
/// is part of link here), so `[n/6]` progress and `--time-passes` match `compilation.log`.
struct Step {
    phase: string;
    run: fn(&Session): bool;
}

/// Run the pipeline up to and including `upTo`, resuming after the stages an earlier call ran (so `run`
/// can stop after `Passes`, print warnings, then go on to `Link`); false when a diagnostic is an error.
pub fn run(s: &Session, upTo: Stage): bool {
    // One row per `Stage`, in its order.
    let steps: [6]Step = [
        Step { phase: "parse", run: loadStage },
        Step { phase: "check", run: semaStage },
        Step { phase: "check", run: lowerStage },
        Step { phase: "check", run: passesStage },
        Step { phase: "emit", run: backendStage },
        Step { phase: "", run: linkStage }, // `emit` stays open: `toolchain` / `cache` begin `compile` after their key pass (Rust)
    ];
    let last = stageIndex(upTo);
    for i in s.done..last + 1 {
        if steps[i].phase.len > 0 { s.phases.begin(steps[i].phase); } // a repeated name continues the open phase
        let f = steps[i].run;
        let ok = f(s);
        remapUi(s);
        if !ok || s.diags.hasErrors() { return false; }
        s.done = i + 1;
    }
    return !s.diags.hasErrors();
}

/// Diagnostics that point into the generated `<package>.ui` module move to the `.j3ui` they came from
/// (Rust compile.rs: `g.remap(e)` before the render). A diagnostic already moved stays as it is.
fn remapUi(s: &Session) {
    match s.loaded {
        Option.Some(p) {
            match p.ui {
                Option.Some(g) { ui.remapAll(g, &s.sources, &s.diags, 0); }
                Option.None {}
            }
        }
        Option.None {}
    }
}

fn stageIndex(st: Stage): int {
    match st {
        Stage.Load { return 0; }
        Stage.Sema { return 1; }
        Stage.Lower { return 2; }
        Stage.Passes { return 3; }
        Stage.Backend { return 4; }
        Stage.Link { return 5; }
    }
    return 0;
}

// The stage rows. Each port replaces one body (see the header for which chunk).

/// Rust `load_input` + `compile_input` + the load half of `load_and_check_with`: the parsed program goes
/// to `s.loaded`; errors (resolve, read, parse, imports, cycles) are in `s.diags`.
fn loadStage(s: &Session): bool {
    // Rust keeps `--host` / `--file` in `project` statics; the manifest code reads them there.
    manifest.setHost(s.opts.host);
    manifest.setFileOnly(s.opts.fileOnly);
    // `--emit c` (B8a) fails before anything is read, so no up-to-date output hides it.
    if s.opts.emit == "c" || s.opts.emit == "C" {
        match backend.find(s.opts.emit, noSpan(), &s.diags) {
            Option.Some(_) {}
            Option.None { return false; }
        }
    }
    let dev = false;
    match s.opts.mode {
        Mode.Dev { dev = true; }
        Mode.Build {}
        Mode.Check {}
        Mode.Lib {}
        Mode.Tool {}
    }
    let cx = LoadCx { arena: s.arena, names: &s.names, diags: &s.diags, sources: &s.sources };
    let lo = LoadOpts { entry: s.opts.entry, given: s.opts.entryGiven, target: s.opts.target, headless: s.opts.headless, release: s.opts.release, dev: dev,
        analyze: s.opts.mode == Mode.Lib, project: s.opts.project };
    match load.loadProgram(cx, lo) {
        Option.Some(p) {
            s.loaded = Option.Some(p);
            return true;
        }
        Option.None { return false; }
    }
}
/// Rust `check_files` (`check_files_lib` for `Mode.Lib`): sema over `s.loaded`, result in `s.checked`.
fn semaStage(s: &Session): bool {
    match s.loaded {
        Option.Some(p) {
            let parsed = s.arena.new::<Parsed>(p);
            let cx = sema.newCx(s.arena, &s.names, &s.diags, &s.sources, parsed);
            match sema.checkProgram(&cx, s.opts.mode != Mode.Lib) {
                Option.Some(c) {
                    s.checked = Option.Some(s.arena.new::<Checked>(c));
                    return true;
                }
                Option.None { return false; }
            }
        }
        Option.None { return false; }
    }
}

/// `lower` over `s.checked` (B11.1: a walk, no type decisions), the IR program in `s.program`.
fn lowerStage(s: &Session): bool {
    match s.checked {
        Option.Some(c) {
            let dyns = List<Sym>.new(s.arena);
            match s.loaded {
                Option.Some(p) { for i in 0..p.files.len { dyns.extend(p.files.items[i].ast.dyns.slice()); } }
                Option.None {}
            }
            let cx = LowerCx { arena: s.arena, names: &s.names, diags: &s.diags, checked: c, dyns: dyns };
            match lower.lowerProgram(&cx) {
                Option.Some(p) {
                    // lower builds over an empty source pool (LowerCx has none): debug info and panic lines read these
                    p.cx.sources = &s.sources;
                    s.program = Option.Some(s.arena.new::<Program>(p));
                    return true;
                }
                Option.None { return false; }
            }
        }
        Option.None { return false; }
    }
}

/// The IR pass list (validate, fast, devmode) on `s.program`.
fn passesStage(s: &Session): bool {
    match s.program {
        Option.Some(p) { return runIr(s, p); }
        Option.None { return false; }
    }
}

/// `dump-ir`: the text of `s.program` (Rust `ir::dump`) into `out`, after `run(s, Stage.Passes)`.
pub fn dumpIr(s: &Session, out: &Text): bool {
    match s.program {
        Option.Some(p) {
            dump.dumpProgram(p, out);
            return true;
        }
        Option.None { return false; }
    }
}

/// The diagnostics of a failed run as Rust's error string: rendered diags, except that a plain message
/// (code 0, no span, no notes: a Rust `Err(String)` such as a read or manifest error) is the bare text.
pub fn failText(s: &Session): string {
    let t = Text.new(s.arena);
    let shown = 0;
    let omitted = 0;
    for i in 0..s.diags.count() {
        let d = s.diags.at(i);
        match d.severity {
            Severity.Error {}
            Severity.Warning { continue; }
        }
        if shown >= MAX_SHOWN { omitted += 1; continue; }
        if shown > 0 { t.add("\n"); }
        shown += 1;
        if d.code == 0 && isNone(d.span) && d.notes.len == 0 {
            t.add(d.msg);
        } else {
            diag.render(d, &s.sources, &t);
        }
    }
    // Rust `CheckError::render`'s footer under several errors.
    if omitted > 0 { t.add("\n").fmt(`error: {shown} errors (and {omitted} more not shown)`).add("\n"); }
    else if shown > 1 { t.add("\n").fmt(`error: {shown} errors`).add("\n"); }
    return t.str();
}

/// Errors a failed run prints (Rust `MAX_ERRORS`); the rest are counted in the footer.
const MAX_SHOWN = 20;
