// `j3c doc search <word>`: names, comments, guide pages.
//
// Part of module j3c.doc.
// Port of: j3c/src/doc/search.rs
module j3c.doc;
// J3: Every stdlib file is parsed in one scratch arena rewound per file; the lines found are built in the
// caller's arena first. Rust's stable `sort_by_key(internal)` is two passes (game APIs, then internals).

/// One public name: `drawText`, `Texture`, `Texture.destroy`, `Key.Space` (strings in the module's arena).
pub struct DocSymbol {
    qual: string;
    doc: string;
}

/// Every public name of `m`, in item order (Rust `symbols`).
fn symbols(m: &Module, a: &Arena): List<DocSymbol> {
    let ast = m.ast;
    let out = List<DocSymbol>.new(a);
    for i in 0..m.file.items.len {
        match m.file.items.items[i] {
            Item.Fn(f) { if f.visPub && shown(ast.str(f.name.name)) { out.push(DocSymbol { qual: ast.str(f.name.name), doc: f.doc }); } }
            Item.Const(c) { if c.visPub && shown(ast.str(c.name.name)) { out.push(DocSymbol { qual: ast.str(c.name.name), doc: c.doc }); } }
            Item.Trait(t) { if t.visPub { out.push(DocSymbol { qual: ast.str(t.name.name), doc: t.doc }); } }
            Item.Struct(s) {
                if s.visPub {
                    let n = ast.str(s.name.name);
                    out.push(DocSymbol { qual: n, doc: s.doc });
                    for k in 0..s.fields.len { out.push(DocSymbol { qual: dotted(n, ast.str(s.fields.items[k].name.name), a), doc: s.fields.items[k].doc }); }
                    for k in 0..s.methods.len { out.push(DocSymbol { qual: dotted(n, ast.str(s.methods.items[k].name.name), a), doc: s.methods.items[k].doc }); }
                }
            }
            Item.Enum(e) {
                if e.visPub {
                    let n = ast.str(e.name.name);
                    out.push(DocSymbol { qual: n, doc: e.doc });
                    for k in 0..e.variants.len { out.push(DocSymbol { qual: dotted(n, ast.str(e.variants.items[k].name.name), a), doc: e.variants.items[k].doc }); }
                }
            }
            _ {}
        }
    }
    return out;
}

fn dotted(x: string, y: string, a: &Arena): string { return Text.new(a).add(x).add(".").add(y).str(); }

/// A found line and whether its module is internal.
pub struct SearchHit {
    line: string;
    internal: bool;
}

/// `j3c doc search <word>`: modules about it, public names containing it, then names whose comment mentions
/// it, then guide sections and recipes (Rust `search`).
fn search(word: string, a: &Arena): Result<string, string> {
    let w = lower(word, a);
    let modules = List<SearchHit>.new(a);
    let names = List<SearchHit>.new(a);
    let docs = List<SearchHit>.new(a);
    let files = stdlibFiles(a)?;
    let scratch = Arena.create(SCRATCH);
    let mark = scratch.checkpoint();
    let skim = !overridden() && plainWord(w);
    for f in 0..files.len {
        scratch.rewind(mark);
        if skim {   // J3 (speed): parse only the embedded modules whose text holds the word
            let ps = List<PartAt>.new(&scratch);
            let all = withParts(files.items[f], readSource(files.items[f], &scratch)?, stdDir(), &ps, &scratch)?;
            if !mayMention(all, w) { continue; }
        }
        let px = newPx(&scratch);
        let m = loadStdlib(&px, files.items[f])?;
        let internal = isInternal(m.key);
        if contains(lower(m.key, &scratch), w) || contains(lower(m.file.doc, &scratch), w) {
            let t = Text.new(a);
            t.add("    j3c doc ").add(m.key).add("  — ");
            snippet(&t, firstLine(m.file.doc), 70);
            t.add("\n");
            modules.push(SearchHit { line: t.str(), internal: internal });
        }
        let syms = symbols(m, &scratch);
        for i in 0..syms.len {
            let s = syms.items[i];
            let k = s.qual.len - 1;
            while k >= 0 && s.qual[k] != '.' { k -= 1; }
            let isName = contains(lower(s.qual[k + 1..s.qual.len], &scratch), w);
            if !isName && !contains(lower(s.doc, &scratch), w) { continue; }
            let t = Text.new(a);
            t.add("    j3c doc ").add(m.key).add(" ").add(s.qual);
            let first = firstLine(s.doc);
            if first.len > 0 { t.add("  — "); snippet(&t, first, 70); }
            t.add("\n");
            if isName { names.push(SearchHit { line: t.str(), internal: internal }); } else { docs.push(SearchHit { line: t.str(), internal: internal }); }
        }
    }
    scratch.destroy();
    let out = Text.new(a);
    hitBlock(&out, "modules about", word, &modules);
    hitBlock(&out, "names containing", word, &names);
    hitBlock(&out, "comments mentioning", word, &docs);
    // Guide pages and recipes, so a task word finds the section that teaches it.
    let pages = Text.new(a);
    for g in 0..GUIDES.len {
        let gname = firstWord(GUIDES[g]);
        let txt = guidePage(g, a);
        let secs = sections(txt, a);
        let n = 0;
        for i in 0..secs.len {
            let sec = secs.items[i];
            if !contains(lower(txt[sec.lo..sec.hi], a), w) { continue; }
            n += 1;
            if n > 3 { continue; }
            pages.add("    j3c doc ").add(gname).add(" ");
            if text.find(sec.name, " ") >= 0 { pages.add("\"").add(sec.name).add("\""); } else { pages.add(sec.name); }
            pages.add("\n");
        }
        if n > 3 { pages.add("    j3c doc ").add(gname).add(" --short  (").pushInt(n - 3); pages.add(" more sections)\n"); }
    }
    let rs = guide.recipes(a);
    for i in 0..rs.len {
        let r = rs.items[i];
        if contains(r.name, w) || contains(lower(r.what, a), w) || contains(lower(r.text, a), w) {
            pages.add("    j3c doc recipes ").add(r.name).add("  — ").add(r.what).add("\n");
        }
    }
    if pages.len() > 0 {
        out.add("guide pages and recipes mentioning `").add(word).add("`:\n").add(pages.str()).add("\n");
    }
    if out.len() == 0 {
        return Result.Err(Text.new(a).add("no public name or comment mentions `").add(word)
            .add("`\n  = help: `j3c doc` lists modules by task").str());
    }
    return Result.Ok(out.str());
}

/// `title `word`:` then up to 30 lines, game APIs before internals.
fn hitBlock(out: &Text, title: string, word: string, list: &List<SearchHit>) {
    if list.len == 0 { return; }
    out.add(title).add(" `").add(word).add("`:\n");
    let shown = 0;
    for pass in 0..2 {
        for i in 0..list.len {
            if list.items[i].internal != (pass == 1) { continue; }
            if shown < SEARCH_MAX { out.add(list.items[i].line); }
            shown += 1;
        }
    }
    if list.len > SEARCH_MAX { out.add("    ... ").pushInt(list.len - SEARCH_MAX); out.add(" more; use a longer word\n"); }
    out.push('\n');
}

const SEARCH_MAX: int = 30;
