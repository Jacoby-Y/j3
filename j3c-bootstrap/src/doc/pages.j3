// Guide pages: verbatim `j3c/src/doc/pages/*.md` stay `@embed`ded from there until C6 (`git mv`); the `lang` and
// `j3ui` prose that is Rust code today moves to `text/doc/`. Also the Unicode helpers the pages and search share.
//
// Part of module j3c.doc.
// Port of: j3c/src/doc/pages.rs, doc/pages/*.md, helptext/recipes/*
module j3c.doc;
// J3: `text/doc/lang.txt` and `j3ui_immediate.txt` hold `@NAME@` where Rust formats a name list in (Rust `{{`/`}}`
// undone); the lists come from `syntax/token` (`keywords.txt` and `names(NameList.X)`). `editor.txt` / `urp.txt`
// are the lines Rust puts before the embedded README. Recipes are `cmd/guide`'s (NEW).
// J3: Rust `to_lowercase` / `is_alphanumeric` / `is_alphabetic` are `syntax/lex` `pushLower` / `isAlphanumeric` /
// `isAlphabetic` (Rust's tables; `pushLower` covers the scripts its header names).

const TASKS = @embed("../../text/doc/pages/tasks.md");
const J3UI_PAGE = @embed("../../text/doc/pages/j3ui.md");
const CSS_PAGE = @embed("../../text/doc/pages/css.md");
const TESTING_PAGE = @embed("../../text/doc/pages/testing.md");
const THREADS_PAGE = @embed("../../text/doc/pages/threads.md");
const TERM_PAGE = @embed("../../text/doc/pages/term.md");
const I18N_PAGE = @embed("../../text/doc/pages/i18n.md");
const SHIP_PAGE = @embed("../../text/doc/pages/ship.md");
const PACKAGES_PAGE = @embed("../../text/doc/pages/packages.md");
const SHADERS_PAGE = @embed("../../text/doc/pages/shaders.md");
const ANDROID_PAGE = @embed("../../text/doc/pages/android.md");
const J2_PAGE = @embed("../../text/doc/pages/j2.md");
const STEAM_PAGE = @embed("../../text/doc/pages/steam.md");
const EDITOR_README = @embed("../../../j3c/editor/README.md");
const URP_README = @embed("../../../j3c/stdlib/j3/gfx/urp/README.md");
const LANG_TXT = @embed("../../text/doc/lang.txt");
const IMMEDIATE_TXT = @embed("../../text/doc/j3ui_immediate.txt");
const EDITOR_TXT = @embed("../../text/doc/editor.txt");
const URP_TXT = @embed("../../text/doc/urp.txt");
/// `j3c doc --help` (Rust `USAGE` plus the newline `println!` adds).
const USAGE_TXT = @embed("../../text/doc/usage.txt");

/// Every text this file embeds, for `docsId`.
fn pageTexts(out: &List<string>) {
    out.push(TASKS); out.push(J3UI_PAGE); out.push(CSS_PAGE); out.push(TESTING_PAGE); out.push(THREADS_PAGE);
    out.push(TERM_PAGE); out.push(I18N_PAGE); out.push(SHIP_PAGE); out.push(PACKAGES_PAGE); out.push(SHADERS_PAGE);
    out.push(ANDROID_PAGE); out.push(J2_PAGE); out.push(STEAM_PAGE); out.push(EDITOR_README); out.push(URP_README);
    out.push(LANG_TXT); out.push(IMMEDIATE_TXT); out.push(EDITOR_TXT); out.push(URP_TXT); out.push(USAGE_TXT);
}

/// `j3c doc urp` (Rust `urp_page`).
fn urpPage(a: &Arena): string { return Text.new(a).add(URP_TXT).add(URP_README).str(); }

/// `j3c doc editor` (Rust `editor_page`).
fn editorPage(a: &Arena): string { return Text.new(a).add(EDITOR_TXT).add(EDITOR_README).str(); }

/// `` `a`, `b` `` (Rust `names`).
fn nameList(xs: []string, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..xs.len {
        if i > 0 { t.add(", "); }
        t.add("`").add(xs[i]).add("`");
    }
    return t.str();
}

/// `tpl` with each `@KEY@` of `keys` replaced by the same index of `vals`.
fn fill(tpl: string, keys: []string, vals: []string, a: &Arena): string {
    let t = Text.new(a);
    let i = 0;
    while i < tpl.len {
        let hit = -1;
        if tpl[i] == '@' {
            for k in 0..keys.len {
                let key = keys[k];
                if i + key.len <= tpl.len && tpl[i..i + key.len] == key { hit = k; break; }
            }
        }
        if hit >= 0 {
            t.add(vals[hit]);
            i += keys[hit].len;
        } else {
            t.push(tpl[i]);
            i += 1;
        }
    }
    return t.str();
}

/// `j3c doc lang` (Rust `lang_page`).
fn langPage(a: &Arena): string {
    let keys: [4]string = ["@TYPES@", "@KEYWORDS@", "@ATTRS@", "@INTRINSICS@"];
    let vals: [4]string = [nameList(token.wordsOf("type", a), a), nameList(token.keywordNames(a), a),
        nameList(token.names(NameList.Attributes), a), nameList(token.names(NameList.Intrinsics), a)];
    return fill(LANG_TXT, keys[..], vals[..], a);
}

/// `j3c doc j3ui-immediate` (Rust `j3ui_page`).
fn j3uiPage(a: &Arena): string {
    let keys: [4]string = ["@END@", "@POP@", "@IF@", "@CALL@"];
    let vals: [4]string = [nameList(token.names(NameList.J3uiEnd), a), nameList(token.names(NameList.J3uiPop), a),
        nameList(token.names(NameList.J3uiIf), a), nameList(token.names(NameList.J3uiCall), a)];
    return fill(IMMEDIATE_TXT, keys[..], vals[..], a);
}

/// The number of code points in `s` (Rust `chars().count()`).
fn charCount(s: string): int {
    let n = 0;
    for i in 0..s.len { if (s[i] & 0xC0) != 0x80 { n += 1; } }
    return n;
}

/// `s` then spaces up to `width` code points (Rust `{:<width}`).
fn padTo(t: &Text, s: string, width: int) {
    t.add(s);
    for i in charCount(s)..width { t.push(' '); }
}

/// `s` lower-cased (Rust `to_lowercase`), in `a`; `s` itself when it has no capital.
fn lower(s: string, a: &Arena): string {
    let ascii = true;
    let caps = false;
    for i in 0..s.len {
        if s[i] >= 0x80 { ascii = false; break; }
        if s[i] >= 'A' && s[i] <= 'Z' { caps = true; }
    }
    if ascii && !caps { return s; }
    let t = Text.new(a);
    if ascii {
        for i in 0..s.len { t.push(if s[i] >= 'A' && s[i] <= 'Z' { s[i] + 32 } else { s[i] }); }
        return t.str();
    }
    let i = 0;
    while i < s.len {
        let (cp, n) = text.decodeRune(s, i);
        lex.pushLower(&t, cp);
        i += n;
    }
    return t.str();
}

/// Every code point of `s` is alphabetic (with `alnum`, alphanumeric: Rust `char::is_alphanumeric`) or one of `extra`.
fn allLetters(s: string, alnum: bool, extra: string): bool {
    let i = 0;
    while i < s.len {
        let (cp, n) = text.decodeRune(s, i);
        i += n;
        let ok = if alnum { lex.isAlphanumeric(cp) } else { lex.isAlphabetic(cp) };
        if ok { continue; }
        if cp < 0x80 && text.find(extra, s[i - n..i]) >= 0 { continue; }
        return false;
    }
    return true;
}
