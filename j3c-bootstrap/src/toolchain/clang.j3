// Which clang a build runs: `J3_CLANG`, the `j3c setup` llvm-mingw, `clang` on PATH (plan 08 decision 3).
//
// Part of module j3c.toolchain.
module j3c.toolchain;
// J3: Files only, no spawn, so `build` and `doctor` stay fast and offline. `clangFor` asks `defaultClang`,
//     which looks once per process.

/// Which clang a build runs, and why (`j3c doctor` prints it).
pub struct ClangPick {
    /// What to spawn: a path, or `clang` (found on PATH).
    cmd: string;
    /// `J3_CLANG`, `j3c setup` or `PATH`.
    source: string;
    /// The file found.
    file: string;
}

/// `findClang` with the environment passed in: `J3_CLANG`, then `<cacheRoot>/toolchain/llvm-mingw-*/bin/clang`
/// (`.exe` on Windows; the highest number wins), then `clang` in a `PATH` folder. Files only, no spawn.
pub fn findClangIn(env: fn(string): string, arena: &Arena): Option<ClangPick> {
    let exe = if sys.PLATFORM == sys.PLATFORM_WINDOWS { "clang.exe" } else { "clang" };
    let j = env("J3_CLANG");
    if j.len > 0 { return Option.Some(ClangPick { cmd: own(arena, j), source: "J3_CLANG", file: own(arena, j) }); }
    match config.cacheRootIn(env, arena) {
        Option.Some(root) {
            let tc = path.join(root, "toolchain", arena);
            match io.listDir(tc, arena) {
                Result.Ok(ents) {
                    let names = List<string>.new(arena);
                    for i in 0..ents.len {
                        let f = path.join(path.join(path.join(tc, ents[i].name, arena), "bin", arena), exe, arena);
                        if fsx.isFile(f) { names.push(ents[i].name); }
                    }
                    match newestLlvmMingw(names.items[0..names.len]) {
                        Option.Some(n) {
                            let f = path.join(path.join(path.join(tc, n, arena), "bin", arena), exe, arena);
                            return Option.Some(ClangPick { cmd: f, source: "j3c setup", file: f });
                        }
                        Option.None {}
                    }
                }
                Result.Err(_) {}
            }
        }
        Option.None {}
    }
    let it = split(env("PATH"), if sys.PLATFORM == sys.PLATFORM_WINDOWS { ";" } else { ":" });
    while true {
        match it.next() {
            Option.Some(d) {
                if d.len == 0 { continue; }
                let f = path.join(d, exe, arena);
                if fsx.isFile(f) { return Option.Some(ClangPick { cmd: "clang", source: "PATH", file: f }); }
            }
            Option.None { break; }
        }
    }
    return Option.None;
}

/// The clang this process builds with (see `findClangIn`), None when there is none.
pub fn findClang(arena: &Arena): Option<ClangPick> { return findClangIn(fn(n: string): string { return sys.env(n); }, arena); }

/// The `llvm-mingw-<n>` name with the highest `<n>`, compared as a number (a longer run of digits is bigger,
/// whatever its first digit). Names without a number are skipped.
pub fn newestLlvmMingw(names: []string): Option<string> {
    let best = "";
    let bestNum = "";
    for i in 0..names.len {
        let n = names[i];
        if !startsWith(n, "llvm-mingw-") { continue; }
        let d = n["llvm-mingw-".len..n.len];
        let e = 0;
        while e < d.len && d[e] >= '0' && d[e] <= '9' { e += 1; }
        if e == 0 { continue; }
        let num = d[0..e];
        while num.len > 1 && num[0] == '0' { num = num[1..num.len]; }
        if best.len == 0 || num.len > bestNum.len || (num.len == bestNum.len && num > bestNum) {
            best = n;
            bestNum = num;
        }
    }
    return if best.len == 0 { Option.None } else { Option.Some(best) };
}

#[singleton]
let DEFAULT_CLANG_SET: bool;
#[singleton]
let DEFAULT_CLANG: string;
#[singleton]
let DEFAULT_CLANG_MEM: Arena;
#[singleton]
let DEFAULT_CLANG_FILE: string;

/// `findClang`'s command, looked up once per process; `clang` when there is none (the spawn error then says
/// how to get one).
pub fn defaultClang(): string {
    if !DEFAULT_CLANG_SET {
        DEFAULT_CLANG_MEM = Arena.create(1 << 12);
        DEFAULT_CLANG = "clang";
        match findClang(&DEFAULT_CLANG_MEM) {
            Option.Some(p) { DEFAULT_CLANG = p.cmd; DEFAULT_CLANG_FILE = p.file; }
            Option.None {}
        }
        DEFAULT_CLANG_SET = true;
    }
    return DEFAULT_CLANG;
}

/// Programs to try for a binutils-style tool, in order: `llvm-<name>` in the folder of the clang `defaultClang`
/// picked (llvm-mingw ships its own; nothing else puts it on `PATH` on Windows), then `rest` (looked up on `PATH`
/// when spawned).
pub fn besideClang(name: string, rest: []string, arena: &Arena): List<string> {
    let out = List<string>.new(arena);
    defaultClang();
    let dir = path.dirname(DEFAULT_CLANG_FILE);
    if dir.len > 0 {
        let exe = Text.new(arena).add("llvm-").add(name).add(if sys.PLATFORM == sys.PLATFORM_WINDOWS { ".exe" } else { "" }).str();
        let f = path.join(dir, exe, arena);
        if fsx.isFile(f) { out.push(f); }
    }
    for i in 0..rest.len { out.push(rest[i]); }
    return out;
}
