// Android: NDK lookup, triple to ABI, SDL lib dir.
//
// Part of module j3c.toolchain.
// Port of: j3c/src/emit/android.rs
module j3c.toolchain;
// J3: C2a has the entries the host toolchain calls; the NDK/SDL lookup (`ndk`, `sdl_dir`, `abi`) is not
//     ported, so `androidReady` refuses every Android build with one line and the flags name no sysroot.

/// Rust `API_LEVEL`: the minimum Android API the triple is compiled for.
const API_LEVEL: string = "24";

/// Rust `target_flags`: compile and link flags for an Android triple, in place of plain `--target=`.
pub fn androidTargetFlags(out: &List<string>, triple: string, arena: &Arena) {
    out.push(Text.new(arena).add("--target=").add(triple).add(API_LEVEL).str());
    out.push("-fPIC");
}

/// Rust `compiler`: an explicit `[emit] clang` (plain `clang` counts as unset), else the NDK's.
pub fn androidCompiler(explicit: string, arena: &Arena): string {
    if explicit.len > 0 && explicit != "clang" { return explicit; }
    return "clang";
}

/// Rust `link_flags`: a shared library with every symbol resolved at build time.
pub fn androidLinkFlags(out: &List<string>, triple: string) {
    out.push("-shared");
    out.push("-Wl,--no-undefined");
    out.push("-ldl");
    out.push("-lm");
    out.push("-llog");
}

/// Rust `lib_name`: `use lib` name on Android (desktop GL is GLES 3 there).
pub fn androidLibName(name: string): string {
    if name == "GL" { return "GLESv3"; }
    return name;
}

/// Rust `ready`: Err (one line) when this machine can't build for `triple`.
pub fn androidReady(triple: string): Result<bool, string> {
    return Result.Err("Android builds are not ported to j3c-boot yet: use stage0 j3c");
}
