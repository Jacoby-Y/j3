// The `[dist] icon` PNG as a Windows exe icon: wrapped in a one-image `.ico` (PNG inside, Vista and later),
// compiled to a COFF resource object by `windres`, and linked like any object file.
//
// Part of module j3c.toolchain.
module j3c.toolchain;

/// `<out>.icon.o`, the resource object with `png` as icon 1 (Explorer and the taskbar show the first icon).
/// Err when the PNG cannot be read or no `windres` runs.
fn iconObject(png: string, out: string, target: string, arena: &Arena): Result<string, string> {
    let data: []u8 = "" as []u8;
    match io.readFile(png, arena) {
        Result.Ok(d) { data = d; }
        Result.Err(_) { return Result.Err(Text.new(arena).add("[dist] icon: cannot read ").add(png).str()); }
    }
    if data.len < 24 || data[1] != 'P' || data[2] != 'N' || data[3] != 'G' {
        return Result.Err(Text.new(arena).add("[dist] icon: not a PNG: ").add(png).str());
    }
    let ico = Text.new(arena).add(out).add(".icon.ico").str();
    let rc = Text.new(arena).add(out).add(".icon.rc").str();
    let obj = Text.new(arena).add(out).add(".icon.o").str();
    fsx.writeFile(ico, icoOf(data, arena), arena)?;
    fsx.writeFile(rc, Text.new(arena).add("1 ICON \"").add(ico).add("\"\n").str() as []u8, arena)?;
    let triple = if startsWith(target, "aarch64") { "aarch64-w64-mingw32" } else { "x86_64-w64-mingw32" };
    let tools: [3]string = [Text.new(arena).add(triple).add("-windres").str(), "llvm-windres", "windres"];
    for i in 0..tools.len {
        let argv: [6]string = [tools[i], "-O", "coff", "-i", rc, Text.new(arena).add("-o").add(obj).str()];
        match spawnRun(argv[:], arena) {
            Result.Ok(o) { if o.code == 0 { return Result.Ok(obj); } }
            Result.Err(_) {}
        }
    }
    return Result.Err("[dist] icon not embedded in the .exe: no windres (install mingw-w64 binutils or llvm)");
}

/// A one-image `.ico` holding `png` as is; width and height come from its IHDR (0 means 256 or more).
fn icoOf(png: []u8, arena: &Arena): []u8 {
    let b = arena.alloc::<u8>(22 + png.len);
    for i in 0..22 { b[i] = 0; }
    b[2] = 1;
    b[4] = 1;
    let w = int(png[16]) * 16777216 + int(png[17]) * 65536 + int(png[18]) * 256 + int(png[19]);
    let h = int(png[20]) * 16777216 + int(png[21]) * 65536 + int(png[22]) * 256 + int(png[23]);
    b[6] = if w >= 256 { 0 } else { u8(w) };
    b[7] = if h >= 256 { 0 } else { u8(h) };
    b[10] = 1;
    b[12] = 32;
    let n = png.len;
    b[14] = u8(n % 256);
    b[15] = u8(n / 256 % 256);
    b[16] = u8(n / 65536 % 256);
    b[17] = u8(n / 16777216 % 256);
    b[18] = 22;
    for i in 0..n { b[22 + i] = png[i]; }
    return b;
}

/// `warning: msg` on stderr.
fn warn(msg: string) {
    let t = "warning: ";
    sys.write(2, t.ptr as ptr, t.len);
    sys.write(2, msg.ptr as ptr, msg.len);
    sys.write(2, "\n".ptr as ptr, 1);
}
