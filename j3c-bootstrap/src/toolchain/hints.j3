// Which package to install when a build or link error names a missing library.
//
// Part of module j3c.toolchain.
// Port of: j3c/src/emit/host/hints.rs

module j3c.toolchain;

/// Rust `failure_hint`: the extra line for a failed `run`/`build` that is not a J3 diagnostic, naming the
/// package to install when the log mentions a known library or a missing compiler. None otherwise.
pub fn failureHint(err: string, arena: &Arena): Option<string> {
    if contains(err, "-->") || contains(err, "sdl2-mingw") { return Option.None; }
    let pkgs = List<string>.new(arena);
    if contains(err, "SDL2_image") || contains(err, "libSDL2_image") || contains(err, "IMG_") { pushNew(&pkgs, "libsdl2-image-2.0-0"); }
    if contains(err, "SDL2_mixer") || contains(err, "libSDL2_mixer") || contains(err, "Mix_") { pushNew(&pkgs, "libsdl2-mixer-2.0-0"); }
    if contains(err, "SDL2_ttf") || contains(err, "libSDL2_ttf") || contains(err, "TTF_") { pushNew(&pkgs, "libsdl2-ttf-2.0-0"); }
    if sdl2Core(err) { pushNew(&pkgs, "libsdl2-2.0-0"); }
    if contains(err, "library `GL`") || contains(err, "-lGL") || contains(err, "libGL") { pushNew(&pkgs, "libgl1"); }
    let t = Text.new(arena);
    if pkgs.len > 0 {
        let list = Text.new(arena);
        for i in 0..pkgs.len {
            if i > 0 { list.push(' '); }
            list.add(pkgs.items[i]);
        }
        t.add("install ").add(list.str()).add("\n         `sudo apt install ").add(list.str()).add("`");
    }
    if contains(err, "spawn clang") || contains(err, "spawn cc") || contains(err, "clang: not found") || contains(err, "cc: not found") {
        if t.len() > 0 { t.add("\n  = help: "); }
        t.add("install clang\n         `sudo apt install clang`");
    }
    if t.len() == 0 { return Option.None; }
    return Option.Some(t.str());
}

/// A failed build for `target`: `err` with the mingw SDL hint added when a Windows link cannot find a
/// library (the apt package `failureHint` would name is the Linux one, not what the mingw linker wants).
pub fn targetFailText(err: string, target: string, arena: &Arena): string {
    if !windowsTarget(target) || !contains(err, "cannot find -l") { return err; }
    let t = Text.new(arena).add(err);
    if !endsWith(err, "\n") { t.add("\n"); }
    let kit = mingwSdlRoot(arena);
    t.add("  = help: the mingw SDL libs for ").add(target).add(" are missing from ").add(kit).add(" (or [link] search)\n");
    t.add("         fetch them: `j3c setup --sdl-only`; or build only the Linux target: `j3c build --target x86_64-unknown-linux-gnu`\n");
    return t.str();
}

fn pushNew(xs: &List<string>, s: string) {
    for i in 0..xs.len { if xs.items[i] == s { return; } }
    xs.push(s);
}

/// `SDL2` itself, not `SDL2_image` / `SDL2_mixer` / `SDL2_ttf`.
fn sdl2Core(err: string): bool {
    let rest = err;
    while true {
        let i = find(rest, "SDL2");
        if i < 0 { return false; }
        if i + 4 >= rest.len || rest[i + 4] != '_' { return true; }
        rest = rest[i + 4..rest.len];
    }
    return false;
}

/// The first `libNAME-*` / `libNAME.so*` entry of `dir` with `.so` in its name, as a path (Rust takes
/// `read_dir`'s order, which is `listDir`'s).
fn findSoname(dir: string, name: string, arena: &Arena): Option<string> {
    let dashed = Text.new(arena).add("lib").add(name).add("-").str();
    let dotted = Text.new(arena).add("lib").add(name).add(".so").str();
    match io.listDir(dir, arena) {
        Result.Ok(ents) {
            for i in 0..ents.len {
                let f = ents[i].name;
                if (startsWith(f, dashed) || startsWith(f, dotted)) && contains(f, ".so") {
                    return Option.Some(path.join(dir, f, arena));
                }
            }
        }
        Result.Err(_) {}
    }
    return Option.None;
}

/// Rust `spawn_err`: the error for a compiler or linker that did not start. A missing one is a one-line fix;
/// `cc` is the C-backend fallback, named `clang (or cc)`.
pub fn spawnErr(tool: string, e: ProcError, arena: &Arena): string {
    match e {
        ProcError.NotFound {
            if sys.PLATFORM == sys.PLATFORM_WINDOWS && (tool == "clang" || tool == "cc") { return "error: no clang: run `j3c setup`"; }
            let shown = if tool == "cc" { "clang (or cc)" } else { tool };
            return Text.new(arena).add("error: ").add(shown).add(" not found on PATH; install clang (Debian/Ubuntu: sudo apt install clang)").str();
        }
        ProcError.ExecFailed { return Text.new(arena).add("spawn ").add(tool).add(": Permission denied (os error 13)").str(); }
        ProcError.Fail { return Text.new(arena).add("spawn ").add(tool).add(": ").add(fsx.osError(sys.errno(), arena)).str(); }
    }
    return "";
}
