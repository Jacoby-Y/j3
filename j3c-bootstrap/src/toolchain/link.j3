// Link arguments and `-lNAME` lookup.
//
// Part of module j3c.toolchain.
// Port of: j3c/src/emit/host/link.rs, the `libs_from_c` helper of emit/host.rs
module j3c.toolchain;

/// Library dirs searched after `[link] search` (Rust's list, in its order).
const LIB_DIRS: [5]string = ["/usr/lib/x86_64-linux-gnu", "/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/usr/lib", "/usr/local/lib"];

/// Rust `append_link_args`: the files, `-L`/rpath dirs, `-l` libs (`use lib`s named in `source` first, then
/// `cc.libs`) and kept flags for `cc`, appended to `out`; Err is the missing-library message.
pub fn appendLinkArgs(out: &List<string>, cc: &CcOpts, source: string, target: string, arena: &Arena): Result<bool, string> {
    let win = windowsTarget(target);
    if targetOs(target) == TargetOs.Android { androidLinkFlags(out, target, arena); }
    for i in 0..cc.files.len { out.push(cc.files.items[i]); }
    for i in 0..cc.search.len {
        let dir = cc.search.items[i];
        // ponytail: path sniff; a per-target [link] table is the real fix
        if !win && contains(dir, "mingw") { continue; }
        out.push(Text.new(arena).add("-L").add(dir).str());
        if !foreignTarget(target) { out.push(Text.new(arena).add("-Wl,-rpath-link,").add(dir).str()); }
    }
    if win {
        let dirs = mingwSdlLibs(target, arena);
        for i in 0..dirs.len { out.push(Text.new(arena).add("-L").add(dirs.items[i]).str()); }
    }
    let libs = libsFromSource(source, arena);
    for i in 0..cc.libs.len { pushNew(&libs, cc.libs.items[i]); }
    for i in 0..libs.len {
        let ln = libs.items[i];
        if win {
            match windowsLib(ln) {
                Option.Some(n) { out.push(Text.new(arena).add("-l").add(n).str()); }
                Option.None {}
            }
            continue;
        }
        out.push(linkLib(ln, &cc.search, target, arena)?);
    }
    for i in 0..cc.flags.len {
        if keepFlag(cc.flags.items[i], target) { out.push(cc.flags.items[i]); }
    }
    if win {
        // The mingw link leaves the TLS directory without base relocations (see Rust).
        out.push("-Wl,--disable-dynamicbase");
        out.push("-Wl,--disable-high-entropy-va");
        if cc.winGui { out.push("-Wl,--subsystem,windows"); }
        if cc.winIcon.len > 0 && cc.out.len > 0 {
            match iconObject(cc.winIcon, cc.out, target, arena) {
                Result.Ok(obj) { out.push(obj); }
                Result.Err(e) { warn(e); }
            }
        }
    }
    return Result.Ok(true);
}

/// Rust `host_lib_present`: the host linker can see `libNAME`.
pub fn hostLibPresent(name: string, search: &List<string>): bool {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    match linkLib(name, search, "", &mem) {
        Result.Ok(_) { return true; }
        Result.Err(_) { return false; }
    }
}

/// Rust `link_lib`: `-lNAME` when the linker can see `libNAME.so`, else a found `libNAME*.so*` path
/// (Debian ships `libSDL2-2.0.so.0` without the `-dev` symlink). Windows and macOS pass `-lNAME` through.
fn linkLib(name: string, search: &List<string>, target: string, arena: &Arena): Result<string, string> {
    if targetOs(target) == TargetOs.Android { return Result.Ok(Text.new(arena).add("-l").add(androidLibName(name)).str()); }
    if foreignTarget(target) { return Result.Ok(Text.new(arena).add("-l").add(name).str()); }
    if name == "m" { return Result.Ok("-lm"); }
    let dirs = List<string>.new(arena);
    for i in 0..search.len { dirs.push(search.items[i]); }
    for i in 0..LIB_DIRS.len {
        let p = LIB_DIRS[i];
        let seen = false;
        for j in 0..dirs.len { if dirs.items[j] == p { seen = true; } }
        if fsx.isDir(p) && !seen { dirs.push(p); }
    }
    let so = Text.new(arena).add("lib").add(name).add(".so").str();
    for i in 0..dirs.len {
        if fsx.isFile(path.join(dirs.items[i], so, arena)) { return Result.Ok(Text.new(arena).add("-l").add(name).str()); }
    }
    for i in 0..dirs.len {
        match findSoname(dirs.items[i], name, arena) {
            Option.Some(f) { return Result.Ok(f); }
            Option.None {}
        }
    }
    let msg = Text.new(arena).add("cannot find library `").add(name).add("`").str();
    let t = Text.new(arena);
    t.add(msg).add("\n  = help: ");
    match failureHint(msg, arena) {
        Option.Some(h) { t.add(h); }
        Option.None { t.add("install it, or take it out of [link] libs"); }
    }
    return Result.Err(t.str());
}

/// Rust `libs_from_c`: the names in `/* use lib "X"` and `; use lib "X"` markers of the emitted source,
/// first seen first, no repeats.
fn libsFromSource(source: string, arena: &Arena): List<string> {
    let libs = List<string>.new(arena);
    let markers: [2]string = ["/* use lib \"", "; use lib \""];
    for m in 0..2 {
        let marker = markers[m];
        let rest = source;
        while true {
            let start = find(rest, marker);
            if start < 0 { break; }
            rest = rest[start + marker.len..rest.len];
            let end = find(rest, "\"");
            if end < 0 { break; }
            let name = rest[0..end];
            if name.len > 0 { pushNew(&libs, name); }
            rest = rest[end..rest.len];
        }
    }
    return libs;
}
