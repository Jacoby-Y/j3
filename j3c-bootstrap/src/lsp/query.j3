// Hover, goto-definition, formatting, positions; traits and char literals (part `lsp/query/traits.j3`).
//
// Port of: j3c/src/lsp/query.rs
// J3: Asks the read-only query functions of `sema` (`sema/query.j3`: by name, as Rust's `ident_at` + `find_*`;
// plan 11 B2, B12.5) over `Session.checked` instead of walking checker internals. No `use j3c.lower`. A name
// defined twice may resolve to another match than Rust's fn-table order (B12.5, PORT_DEBT "not copied").
// J3: Results are allocated in the caller's `arena` (they outlive the Session). Columns are bytes, as Rust.
module j3c.lsp.query;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3c.base.span.Span;
use j3c.driver.Session;
use j3c.load.Overlay;

pub struct Hover {
    text: string;
    span: Span;
}

pub struct Location {
    path: string;
    span: Span;
}

/// An LSP position: 0-based line, byte column.
pub struct LspPos {
    line: u32;
    col: u32;
}

/// Rust `range_of`'s `((sl, sc), (el, ec))`.
pub struct LspRange {
    start: LspPos;
    end: LspPos;
}

/// Rust `query::analyze`: a fresh `Mode.Check` Session of the program around `path` with `overlays`, checked to
/// `Stage.Sema` (the caller frees it). Err = the check failed (the Session is freed). → LSPS, LSPU
pub fn analyze(path: string, overlays: []Overlay): Result<&Session, string> { return Result.Err("lsp: not ported yet"); } // STUB LSPQ

/// Rust `query::hover`: markdown `\`\`\`j3\n<kind> name: ty\n\`\`\`` then the doc. → LSPS, LSPU
pub fn hover(s: &Session, path: string, offset: u32, arena: &Arena): Option<Hover> { return Option.None; } // STUB LSPQ

/// Rust `query::definition`. → LSPS, LSPU
pub fn definition(s: &Session, path: string, offset: u32, arena: &Arena): Option<Location> { return Option.None; } // STUB LSPQ

/// Rust `query::format_file` (`syntax.fmt`). → LSPS
pub fn formatFile(src: string, arena: &Arena): Result<string, string> { return Result.Err("lsp: not ported yet"); } // STUB LSPQ

/// Rust `query::range_of`: `span` as LSP lines and byte columns in `src`. → LSPS, LSPU
pub fn rangeOf(src: string, span: Span): LspRange { return LspRange { start: LspPos { line: 0, col: 0 }, end: LspPos { line: 0, col: 0 } }; } // STUB LSPQ

/// Rust `query::offset_at`: the byte offset of (line, col) in `src`, clamped. → LSPS, LSPU
pub fn offsetAt(src: string, line: u32, col: u32): u32 { return 0; } // STUB LSPQ
