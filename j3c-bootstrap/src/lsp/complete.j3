// Scoped completion, signature help, outline (document symbols), import quick-fixes.
//
// Port of: j3c/src/lsp/complete/mod.rs
// J3: Parts: `items`, `members`, `symbols` (LSPQ, sema-backed) and the text scanners `scan`, `uses`, `script`
// (LSPU; fallback only for source that does not parse yet, B12.5). `finish` sorts by (sortText, label), dedups
// (label, kind) keeping the first, caps 200 on an empty prefix. Results are in the caller's `arena`.
module j3c.lsp.complete;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3c.base.span.Span;
use j3c.driver.Session;
use j3c.load.Overlay;

/// One completion item (Rust `complete::Completion`; `kind` is the LSP CompletionItemKind).
pub struct Completion {
    label: string;
    detail: string;
    insert: string;
    documentation: string;
    sort: string;
    kind: int;
    snippet: bool;
    commitDot: bool;
}

pub struct Signature {
    params: List<string>;
    label: string;
    documentation: string;
}

pub struct SignatureHelp {
    signatures: List<Signature>;
    active: u32;
}

/// One outline entry (`kind` is the LSP SymbolKind).
pub struct Symbol {
    name: string;
    container: string;
    span: Span;
    kind: int;
}

pub struct ImportEdit {
    title: string;
    newText: string;
    offset: u32;
}

/// Rust `complete_at`: completion at `offset` of `src` (the buffer of `path`) on a checked Session. → LSPS
pub fn completeAt(s: &Session, path: string, src: string, offset: u32, arena: &Arena): List<Completion> { return List<Completion>.new(arena); } // STUB LSPQ

/// Rust `complete_buffer`: `.j3s` paths first, else analyze with `overlays`, else the heal path (blank the
/// line, recheck), else disk. → LSPS
pub fn completeBuffer(path: string, overlays: []Overlay, src: string, offset: u32, arena: &Arena): List<Completion> { return List<Completion>.new(arena); } // STUB LSPQ

/// Rust `member_items`: members of `base` for `base.prefix` (the `.j3ui` bridge). → LSPU
pub fn memberItems(s: &Session, path: string, offset: u32, base: string, prefix: string, arena: &Arena): List<Completion> { return List<Completion>.new(arena); } // STUB LSPQ

/// Rust `signature`: at most 8, deduplicated by label, `this` skipped. → LSPS, LSPU
pub fn signature(s: &Session, path: string, src: string, offset: u32, arena: &Arena): Option<SignatureHelp> { return Option.None; } // STUB LSPQ

/// Rust `symbols`: the outline of `path`. → LSPS
pub fn symbols(s: &Session, path: string, arena: &Arena): List<Symbol> { return List<Symbol>.new(arena); } // STUB LSPQ
