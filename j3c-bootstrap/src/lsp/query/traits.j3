// Hover for traits (`dyn Trait`) and char literals: neither has a sema entity of its own.
//
// Part of module j3c.lsp.query.
// Port of: j3c/src/lsp/query/traits.rs
// J3: Traits come from `sema.traitDocs` (Rust `Program.traits`, sorted by module then name), built per call.
module j3c.lsp.query;

/// Rust `find_trait`: the trait `name` names here: the one declared in `file` first, else the first.
pub fn findTraitDoc(s: &Session, file: Id<Source>, name: string): Option<TraitDoc> {
    let c = s.checked?;
    let all = sema.traitDocs(c, &s.sources, s.arena);
    let first: Option<TraitDoc> = Option.None;
    let found = false;
    for i in 0..all.len {
        let t = all.items[i];
        if t.name != name { continue; }
        if t.span.file == file { return Option.Some(t); }
        if !found { first = Option.Some(t); found = true; }
    }
    return first;
}

/// Rust `trait_hover`: the declaration, `*module.Name*`, the `dyn` note, the doc.
pub fn traitHover(t: &TraitDoc, dynKw: bool, out: &Text) {
    out.add("```j3\n").add(t.sig).add("\n```\n*").add(t.modPath).add(".").add(t.name).add("*");
    if dynKw {
        out.add("\n\n`dyn` value: a pointer to any value whose type has these methods, plus that type's method table");
    }
    if t.doc.len > 0 { out.add("\n\n").add(t.doc); }
}

/// Rust `after_dyn`: the name after the `dyn` keyword at `span`.
pub fn afterDyn(src: string, span: Span): Option<string> {
    let i = int(span.hi);
    if i > src.len { return Option.None; }
    // Rust `trim_start`: Unicode whitespace; source here is ASCII around a keyword.
    while i < src.len && (src[i] == ' ' || src[i] == '\t' || src[i] == '\n' || src[i] == '\r') { i += 1; }
    let e = i;
    while e < src.len && isIdentByte(src[e]) { e += 1; }
    if e == i { return Option.None; }
    return Option.Some(src[i..e]);
}

/// Rust `char_hover`: the char literal (`'a'`, `'\n'`, `'\u{1F600}'`) under `offset`: its code point and type.
// ponytail: lexes the whole file per hover (in the Session's arena, freed with it), as Rust does.
pub fn charHover(s: &Session, src: string, file: Id<Source>, offset: u32, arena: &Arena): Option<Hover> {
    let toks = match lex.lex(src, file, s.arena) { Result.Ok(ts) { ts } Result.Err(_) { return Option.None; } };
    for i in 0..toks.len {
        let tk = toks.items[i];
        if tk.kind != TokenKind.Char || tk.span.lo > offset || offset >= tk.span.hi { continue; }
        let v = u32(0);
        if tk.text.len == 0 { return Option.None; }
        for k in 0..tk.text.len {
            let d = tk.text[k];
            if d < '0' || d > '9' { return Option.None; }
            v = v * 10 + u32(d - '0');
        }
        let t = Text.new(arena);
        t.add("```j3\n");
        if tk.span.hi <= u32(src.len) { t.add(src[int(tk.span.lo)..int(tk.span.hi)]); }
        t.add(": ").add(if v < 128 { "u8" } else { "u32" }).add("\n```\ncode point ");
        t.pushInt(int(v));
        t.add(" (U+");
        pushHex4(&t, v);
        t.add(")");
        return Option.Some(Hover { text: t.str(), span: tk.span });
    }
    return Option.None;
}

/// Rust `{v:04X}`: upper-case hex, at least 4 digits.
fn pushHex4(t: &Text, v: u32) {
    let digits = "0123456789ABCDEF";
    let n = 1;
    let x = v >> 4;
    while x > 0 { n += 1; x = x >> 4; }
    for _ in n..4 { t.add("0"); }
    let k = n - 1;
    while k >= 0 {
        t.push(digits[int((v >> u32(k * 4)) & 15)]);
        k -= 1;
    }
}
