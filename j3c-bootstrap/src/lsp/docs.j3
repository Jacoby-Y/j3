// Open documents, the request's cursor, URIs, and the small JSON builders `lsp` and `lsp.ui` share.
//
// Port of: j3c/src/lsp/docs.rs, (lsp/proto.rs `completion_json`, `pos_json`, `uri_to_path`, `path_to_uri`, `url_decode`)
// J3: Open buffers are a list in uri order (Rust: a HashMap; AGENTS rule 3), so `docsKey` and diagnostics never
// depend on hash order. Strings are in the server's arena (they outlive every Session).
// J3: Deferred (user, 2026-11-18): not ported yet; stubs keep their signatures. See plans/12-deferred-tools.md.
module j3c.lsp.docs;

use j3.data.json;
use j3.data.json.Json;
use j3.memory.Arena;
use j3.option.Option;
use j3c.load.Overlay;
use j3c.lsp.complete.Completion;

/// One open buffer.
pub struct Doc {
    uri: string;
    path: string;
    text: string;
}

/// Rust `docs::Cursor`: the request's document and byte offset.
pub struct Cursor {
    uri: string;
    path: string;
    src: string;
    offset: u32;
}

/// Rust `uri_to_path` (`file://`, percent-decoded). → LSPU
pub fn uriToPath(uri: string, arena: &Arena): Option<string> { return Option.None; } // STUB LSPS

/// Rust `path_to_uri` (canonical path). → LSPU
pub fn pathToUri(path: string, arena: &Arena): string { return ""; } // STUB LSPS

/// Rust `pos_json`: `{"line":..,"character":..}`. → LSPU
pub fn posJson(line: u32, col: u32, arena: &Arena): &Json { return json.obj(arena); } // STUB LSPS

/// Rust `completion_json`. → LSPU
pub fn completionJson(c: &Completion, arena: &Arena): &Json { return json.obj(arena); } // STUB LSPS

/// Rust `overlays_from`: the open buffers as loader overlays. → LSPU
pub fn overlaysFrom(docs: []Doc, arena: &Arena): []Overlay { return arena.alloc::<Overlay>(0); } // STUB LSPS

/// Rust `paths_match` (canonical paths equal, else the strings). → LSPU
pub fn pathsMatch(a: string, b: string, arena: &Arena): bool { return a == b; } // STUB LSPS

/// Rust `docs_key`: a hash of the open buffers (uri and text, in list order) for the cache. → LSPU
pub fn docsKey(docs: []Doc): u64 { return 0; } // STUB LSPS
