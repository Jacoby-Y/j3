module j3c.lsp.complete;

/// One `(String, String)` of Rust `Uses`, in its tuple order.
pub struct UsePair {
    first: string;
    second: string;
}

/// Rust `uses::Uses`: what the file imports and aliases.
pub struct Uses {
    imports: List<UsePair>;
    aliases: List<UsePair>;
}

/// Rust `UseAt`: a `use` statement the cursor is in.
pub struct UseAt {
    path: List<string>;
    prefix: string;
    isLib: bool;
    brace: bool;
}

/// Rust `import_edits`: `use` lines that fix the unknown names in `messages`. → LSPS (codeAction)
pub fn importEdits(s: &Session, src: string, messages: []string, arena: &Arena): List<ImportEdit> { return List<ImportEdit>.new(arena); } // STUB LSPU

/// Rust `use_at`. → LSPQ
pub fn useAt(src: string, offset: int, arena: &Arena): Option<UseAt> { return Option.None; } // STUB LSPU

/// Rust `complete_use`. → LSPQ
pub fn completeUse(s: &Session, u: &UseAt, arena: &Arena): List<Completion> { return List<Completion>.new(arena); } // STUB LSPU

/// Rust `uses_of`. → LSPQ
pub fn usesOf(s: &Session, src: string, arena: &Arena): Uses { return Uses { imports: List<UsePair>.new(arena), aliases: List<UsePair>.new(arena) }; } // STUB LSPU
