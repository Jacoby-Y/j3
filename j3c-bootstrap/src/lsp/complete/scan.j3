// Scan the text around the cursor for context: the call being typed, the word before it, lexical mode.
//
// Part of module j3c.lsp.complete.
// Port of: j3c/src/lsp/complete/scan.rs
// J3: Fallback only, for source that doesn't parse yet (plan 11 B12.5); everything else asks `sema`. Skips char
// literals (`lex.charLit`).
// J3: Deferred (user, 2026-11-18): not ported yet; stubs keep their signatures. See plans/06-deferred-tools.md.
module j3c.lsp.complete;

/// Rust `CallSite`: the call around the cursor.
pub struct CallSite {
    receiver: Option<string>;
    name: string;
    commas: u32;
}

/// Rust `prefix_of`'s `(prefix, start, receiver)`.
pub struct PrefixAt {
    receiver: Option<string>;
    prefix: string;
    at: int;
}

/// Rust `scan::Mode`.
pub enum LexMode { Code, Str, Tick, Comment }

/// Rust `find_call`. → LSPQ
pub fn findCall(src: string, offset: int, arena: &Arena): Option<CallSite> { return Option.None; } // STUB LSPU

/// Rust `prefix_of`. → LSPQ
pub fn prefixOf(src: string, offset: int, arena: &Arena): PrefixAt { return PrefixAt { receiver: Option.None, prefix: "", at: offset }; } // STUB LSPU

/// Rust `attr_prefix`: the name typed after `#[`. → LSPQ
pub fn attrPrefix(src: string, offset: int, arena: &Arena): Option<string> { return Option.None; } // STUB LSPU

/// Rust `lexical_mode`. → LSPQ
pub fn lexicalMode(src: string, offset: int): LexMode { return LexMode.Code; } // STUB LSPU

/// Rust `is_ident_name`. → LSPQ
pub fn isIdentName(s: string): bool { return false; } // STUB LSPU
