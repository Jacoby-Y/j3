// `.j3ui` in the editor: J3 regions through the typed program (span map both ways), markup and CSS completion.
//
// Port of: j3c/src/lsp/ui.rs
// J3: Parts `lsp/ui/items.j3` (markup), `lsp/ui/css.j3` (CSS tables read from the stdlib `ui/css*.j3` at run time).
// Never imports `j3c.lsp` (Rust's `use super::...` would be a cycle): shared helpers are in `lsp/docs`.
// J3: Deferred (user, 2026-11-18): not ported yet; stubs keep their signatures. See plans/12-deferred-tools.md.
module j3c.lsp.ui;

use j3.data.json;
use j3.data.json.Json;
use j3.memory.Arena;
use j3c.lsp.docs.Doc;

/// The last analyzed `.j3ui` project, keyed on the open buffers (Rust `UiCache`). LSPU decides the fields.
pub struct UiCache {
    key: u64;
    set: bool;
}

/// An empty cache.
pub fn newCache(): UiCache { return UiCache { key: 0, set: false }; }

/// Rust `is_ui_request`: the request's document is a `.j3ui` (or the theme `.css`). → LSPS
pub fn isUiRequest(params: &Json): bool { return false; } // STUB LSPU

/// Rust `ui::handle`: the reply for `method` on a `.j3ui` (null / `[]` for what it does not answer). → LSPS
pub fn handle(method: string, params: &Json, docs: []Doc, cache: &UiCache, arena: &Arena): &Json { return json.null(arena); } // STUB LSPU
