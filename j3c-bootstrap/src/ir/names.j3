// Stable name text shared by lower (generic instance names `name<A,B>`) and the LLVM backend (symbol names
// and the signature text fn names hash): sanitized identifiers, module idents, type text without intern ids.
//
// Port of: emit/c_ty.rs (sanitize, module_ident), emit/c_expr/names.rs (stable_ty; the rest of both is
// backend/llvm/names.j3)
// J3: In `ir/` because lower sits below backend (tools/layers.txt) and both need the same spelling.
module j3c.ir.names;

use j3.data.pool.Id;
use j3.memory.List;
use j3.option.Option;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.ir.{ FloatTy, IntTy, IrCx, TyKind, vecName };

/// `name` with every char that is not ASCII alphanumeric or `_` as `_` (one per char), `x` when empty,
/// `_` before a leading digit (Rust `c_ty::sanitize`).
pub fn pushSanitized(t: &Text, name: string) {
    if name.len == 0 { t.push('x'); return; }
    let c0 = name[0];
    if c0 >= '0' && c0 <= '9' { t.push('_'); }
    for i in 0..name.len {
        let c = name[i];
        if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' {
            t.push(c);
        } else if (c & 0xC0) != 0x80 {
            // one `_` per char: UTF-8 continuation bytes add nothing
            t.push('_');
        }
    }
}

/// Module path parts joined by `_`, `mod` when empty (Rust `c_ty::module_ident`).
pub fn pushModuleIdent(t: &Text, cx: &IrCx, parts: &List<Sym>) {
    if parts.len == 0 { t.add("mod"); return; }
    for i in 0..parts.len {
        if i > 0 { t.push('_'); }
        pushSanitized(t, cx.nameStr(parts.items[i]));
    }
}

/// Type text without intern ids, so two compiles of the same source match (Rust `stable_ty`).
pub fn pushStableTy(t: &Text, cx: &IrCx, ty: Id<TyKind>, depth: int) {
    if depth > 32 { t.add("rec"); return; }
    let d = depth + 1;
    match cx.tyKind(ty) {
        TyKind.Void { t.add("void"); }
        TyKind.Bool { t.add("bool"); }
        TyKind.Int(i) {
            match i {
                IntTy.I8 { t.add("i8"); }
                IntTy.I16 { t.add("i16"); }
                IntTy.I32 { t.add("i32"); }
                IntTy.I64 { t.add("int"); }
                IntTy.U8 { t.add("u8"); }
                IntTy.U16 { t.add("u16"); }
                IntTy.U32 { t.add("u32"); }
                IntTy.U64 { t.add("u64"); }
            }
        }
        TyKind.Float(f) { if f == FloatTy.F32 { t.add("f32"); } else { t.add("float"); } }
        TyKind.Half { t.add("f16"); }
        TyKind.Vec(v) { t.add(vecName(v)); }
        TyKind.Ptr { t.add("ptr"); }
        TyKind.CStr { t.add("cstr"); }
        TyKind.String { t.add("string"); }
        TyKind.Ref(r) { t.push('&'); pushStableTy(t, cx, r.inner, d); }
        TyKind.Array(a) { t.fmt(`[{a.len}]`); pushStableTy(t, cx, a.elem, d); }
        TyKind.Slice(s) { t.add("[]"); pushStableTy(t, cx, s.elem, d); }
        TyKind.Fn(f) {
            t.add("fn(");
            for i in 0..f.params.len {
                if i > 0 { t.push(','); }
                pushStableTy(t, cx, f.params.items[i], d);
            }
            t.push(')');
            pushStableTy(t, cx, f.ret, d);
        }
        TyKind.Struct(s) {
            let def = cx.structDef(s.id);
            pushModuleIdent(t, cx, &def.moduleName);
            t.add(".").add(cx.nameStr(def.name));
            if def.tyArgs.len > 0 {
                t.push('<');
                for i in 0..def.tyArgs.len {
                    if i > 0 { t.push(','); }
                    t.add(def.tyArgs.items[i].name).push('=');
                    pushStableTy(t, cx, def.tyArgs.items[i].ty, d);
                }
                t.push('>');
            }
        }
        TyKind.Enum(e) {
            let def = cx.enumDef(e.id);
            pushModuleIdent(t, cx, &def.moduleName);
            t.add(".").add(cx.nameStr(def.name)).push('{');
            for i in 0..def.variants.len {
                let v = def.variants.items[i];
                t.add(cx.nameStr(v.name));
                match v.payload {
                    Option.Some(p) { t.push(':'); pushStableTy(t, cx, p, d); }
                    Option.None {}
                }
                t.push(';');
            }
            t.push('}');
        }
    }
}
