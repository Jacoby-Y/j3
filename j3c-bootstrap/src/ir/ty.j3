// Primitive widths and interned IR types.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/ty.rs
// J3: Rust `Ty(u32)` is `Id<TyKind>` into `IrCx.tys`. Variants with data hold payload structs: `Ref(Ty)` is
// `Ref(RefTy { inner })`, `Array { elem, len }` `Array(ArrayTy { elem, len })`, `Slice { elem }`
// `Slice(SliceTy { elem })`, `Fn { params, ret }` `Fn(FnTy { params, ret })`, `Struct(id)`
// `Struct(StructTy { id })`, `Enum(id)` `Enum(EnumTy { id })`. Methods on Rust enums are free fns
// (`intBits`, `vecName`, ...). `int`/`float` are `i64`/`f64` (one interned type each, Rust's rule).
module j3c.ir;

pub enum IntTy { I8, I16, I32, I64, U8, U16, U32, U64 }

pub fn intBits(t: IntTy): u32 {
    match t {
        IntTy.I8 { return 8; }
        IntTy.U8 { return 8; }
        IntTy.I16 { return 16; }
        IntTy.U16 { return 16; }
        IntTy.I32 { return 32; }
        IntTy.U32 { return 32; }
        IntTy.I64 { return 64; }
        IntTy.U64 { return 64; }
    }
}

pub fn intWidthBytes(t: IntTy): u64 { return u64(intBits(t) / 8); }

pub fn intSigned(t: IntTy): bool {
    match t {
        IntTy.I8 { return true; }
        IntTy.I16 { return true; }
        IntTy.I32 { return true; }
        IntTy.I64 { return true; }
        IntTy.U8 { return false; }
        IntTy.U16 { return false; }
        IntTy.U32 { return false; }
        IntTy.U64 { return false; }
    }
}

pub enum FloatTy { F32, F64 }

/// SIMD vector types: 4 lanes, 16 bytes, align 16. `vec4f` is 4 x f32, `vec4i` is 4 x i32.
pub enum VecTy { F32x4, I32x4 }

/// Rust `VecTy::LANES`.
pub const VEC_LANES: u64 = 4;

/// Source spelling.
pub fn vecName(v: VecTy): string {
    match v {
        VecTy.F32x4 { return "vec4f"; }
        VecTy.I32x4 { return "vec4i"; }
    }
}

/// LLVM type.
pub fn vecLlvm(v: VecTy): string {
    match v {
        VecTy.F32x4 { return "<4 x float>"; }
        VecTy.I32x4 { return "<4 x i32>"; }
    }
}

/// LLVM type of one lane.
pub fn vecLaneLlvm(v: VecTy): string {
    match v {
        VecTy.F32x4 { return "float"; }
        VecTy.I32x4 { return "i32"; }
    }
}

/// Canonical type. Interned in `IrCx`.
pub enum TyKind {
    Void,
    Bool,
    Int(IntTy),
    Float(FloatTy),
    /// Untyped address. FFI / stdlib only.
    Ptr,
    /// `char*`. Stdlib / `use lib` only.
    CStr,
    /// Lang item. Read-only `[]u8` view. Not writable.
    String,
    Ref(RefTy),
    Array(ArrayTy),
    Slice(SliceTy),
    Fn(FnTy),
    Struct(StructTy),
    Enum(EnumTy),
    /// `f16`: storage only (2 bytes, align 2). Held as its IEEE-754 binary16 bits.
    Half,
    /// `vec4f` / `vec4i`. Lanes are `.x .y .z .w`.
    Vec(VecTy),
}

pub struct RefTy { inner: Id<TyKind>; }
pub struct ArrayTy { elem: Id<TyKind>; len: u64; }
pub struct SliceTy { elem: Id<TyKind>; }
pub struct FnTy { params: List<Id<TyKind>>; ret: Id<TyKind>; }
pub struct StructTy { id: Id<StructDef>; }
pub struct EnumTy { id: Id<EnumDef>; }

/// `int` (`i64`), which dumps print as `int`.
pub fn isIntAlias(k: TyKind): bool {
    match k {
        TyKind.Int(t) { return t == IntTy.I64; }
        _ { return false; }
    }
}

/// `float` (`f64`), which dumps print as `float`.
pub fn isFloatAlias(k: TyKind): bool {
    match k {
        TyKind.Float(t) { return t == FloatTy.F64; }
        _ { return false; }
    }
}
