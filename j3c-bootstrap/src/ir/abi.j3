// The one layout rule: size, align, field offsets; `@sizeof` and arena bumps read it.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/abi.rs
// J3: Matches System V LP64 / gcc for the types we emit. Rust's free fns `size`/`align`/`field_offset`
// are `abiSize`/`abiAlign`/`fieldOffset` (shorter names collide inside module j3c.ir).
module j3c.ir;

pub fn abiSize(cx: &IrCx, ty: Id<TyKind>): u64 {
    match cx.tyKind(ty) {
        TyKind.Void { return 0; }
        TyKind.Bool { return 1; }
        TyKind.Int(i) { return intWidthBytes(i); }
        TyKind.Half { return 2; }
        TyKind.Float(f) { if f == FloatTy.F32 { return 4; } return 8; }
        TyKind.Ptr { return 8; }
        TyKind.CStr { return 8; }
        TyKind.Ref(_) { return 8; }
        TyKind.Fn(_) { return 8; }
        TyKind.String { return 16; }
        TyKind.Slice(_) { return 16; }
        TyKind.Vec(_) { return 16; }
        TyKind.Array(a) { return abiSize(cx, a.elem) * a.len; }
        TyKind.Struct(s) {
            let def = cx.structDef(s.id);
            let off: u64 = 0;
            if def.packed {
                for i in 0..def.fields.len { off += abiSize(cx, def.fields.items[i].ty); }
                return off;
            }
            let a: u64 = 1;
            for i in 0..def.fields.len {
                let fty = def.fields.items[i].ty;
                let fa = abiAlign(cx, fty);
                if fa > a { a = fa; }
                off = alignUp(off, fa) + abiSize(cx, fty);
            }
            return alignUp(off, a);
        }
        TyKind.Enum(e) {
            let def = cx.enumDef(e.id);
            if def.isCLike() { return 4; }
            // `int32_t tag; union { T v; } u;`: padding after tag.
            let payload: u64 = 0;
            let ua: u64 = 1;
            for i in 0..def.variants.len {
                match def.variants.items[i].payload {
                    Option.Some(p) {
                        let s = abiSize(cx, p);
                        if s > payload { payload = s; }
                        let pa = abiAlign(cx, p);
                        if pa > ua { ua = pa; }
                    }
                    Option.None {}
                }
            }
            let sa: u64 = 4;
            if ua > 4 { sa = ua; }
            return alignUp(alignUp(4, ua) + payload, sa);
        }
    }
}

pub fn abiAlign(cx: &IrCx, ty: Id<TyKind>): u64 {
    match cx.tyKind(ty) {
        TyKind.Void { return 1; }
        TyKind.Bool { return 1; }
        TyKind.Int(i) { return intWidthBytes(i); }
        TyKind.Half { return 2; }
        TyKind.Float(f) { if f == FloatTy.F32 { return 4; } return 8; }
        TyKind.Ptr { return 8; }
        TyKind.CStr { return 8; }
        TyKind.Ref(_) { return 8; }
        TyKind.Fn(_) { return 8; }
        TyKind.String { return 8; }
        TyKind.Slice(_) { return 8; }
        TyKind.Vec(_) { return 16; }
        TyKind.Array(a) { return abiAlign(cx, a.elem); }
        TyKind.Struct(s) {
            let def = cx.structDef(s.id);
            if def.packed { return 1; }
            let a: u64 = 1;
            for i in 0..def.fields.len {
                let fa = abiAlign(cx, def.fields.items[i].ty);
                if fa > a { a = fa; }
            }
            return a;
        }
        TyKind.Enum(e) {
            let def = cx.enumDef(e.id);
            if def.isCLike() { return 4; }
            return maxPayloadAlign(cx, &def, 4);
        }
    }
}

/// The largest payload alignment of `def`'s variants, at least `floor`.
fn maxPayloadAlign(cx: &IrCx, def: &EnumDef, floor: u64): u64 {
    let a = floor;
    for i in 0..def.variants.len {
        match def.variants.items[i].payload {
            Option.Some(p) {
                let pa = abiAlign(cx, p);
                if pa > a { a = pa; }
            }
            Option.None {}
        }
    }
    return a;
}

fn alignUp(n: u64, a: u64): u64 {
    if a == 0 { return n; }
    return (n + a - 1) / a * a;
}

/// SysV LP64 field offset. Slice/string are `{ ptr @ 0, len @ 8 }`. Tagged enum: `i32 tag` at 0, union at
/// `alignUp(4, payload align)`. A C-like enum is `i32` (no fields).
pub fn fieldOffset(cx: &IrCx, ty: Id<TyKind>, field: int): Option<u64> {
    match cx.tyKind(ty) {
        TyKind.String { return ptrLenOffset(field); }
        TyKind.Slice(_) { return ptrLenOffset(field); }
        TyKind.Struct(s) {
            let def = cx.structDef(s.id);
            if field >= def.fields.len { return Option.None; }
            let off: u64 = 0;
            if def.packed {
                for i in 0..field { off += abiSize(cx, def.fields.items[i].ty); }
                return Option.Some(off);
            }
            for i in 0..field {
                let fty = def.fields.items[i].ty;
                off = alignUp(off, abiAlign(cx, fty)) + abiSize(cx, fty);
            }
            return Option.Some(alignUp(off, abiAlign(cx, def.fields.items[field].ty)));
        }
        TyKind.Enum(e) {
            let def = cx.enumDef(e.id);
            if def.isCLike() { return Option.None; }
            if field == 0 { return Option.Some(0); }
            if field == 1 { return Option.Some(alignUp(4, maxPayloadAlign(cx, &def, 1))); }
            return Option.None;
        }
        _ { return Option.None; }
    }
}

fn ptrLenOffset(field: int): Option<u64> {
    if field == 0 { return Option.Some(0); }
    if field == 1 { return Option.Some(8); }
    return Option.None;
}
