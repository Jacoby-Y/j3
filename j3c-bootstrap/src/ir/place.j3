// Places: slots you can load from or store to, with projection chains.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/place.rs
// J3: Payload structs: `Proj::Field { field, ty }` is `Field(FieldProj { field, ty })`, `Index { index, ty }`
// `Index(IndexProj { index, ty })`, `Lane { lane, ty }` `Lane(LaneProj { lane, ty })`, `EnumPayload
// { variant, ty }` `EnumPayload(PayloadProj { variant, ty })`; `PlaceRoot::Local(id)` is
// `Local(LocalRoot { id })`, `Global(id)` `Global(GlobalRoot { id })`. `Place.project` returns the
// extended place like Rust's by-value `project`, in a new exact-size proj list (never `this`'s buffer).
module j3c.ir;

/// What you may do with a place. Not a type; the type is `Place.ty`.
pub struct Access {
    /// Store / `+=` allowed (`let`, or through `&T`).
    assign: bool;
    /// `&place` allowed. False for `const` bindings.
    takeRef: bool;

    fn operator==(this: Access, o: Access): bool { return this.assign == o.assign && this.takeRef == o.takeRef; }
}

pub fn letBinding(): Access { return Access { assign: true, takeRef: true }; }
pub fn constBinding(): Access { return Access { assign: false, takeRef: false }; }
/// Read-only view (`string`, slice of a const). Index is not an lvalue.
pub fn readOnlyView(): Access { return Access { assign: false, takeRef: true }; }
/// Through `&T`: writable, can take another `&`.
pub fn throughRef(): Access { return Access { assign: true, takeRef: true }; }

pub enum Proj {
    /// `*p`. `p` must have type `&T`. Result type is `T`.
    Deref,
    Field(FieldProj),
    /// `xs[i]`. `i` is evaluated when the place is bound (once for `+=`).
    Index(IndexProj),
    /// `.ptr` on `[]T` / `string`. Type is `&T`.
    Ptr,
    /// `.len` on `[]T` / `string`. Type is `int`.
    Len,
    /// Tag of a tagged-union enum. Type is `i32`.
    EnumTag,
    /// `.x .y .z .w` / `v[0..3]` of a `vec4f` / `vec4i`. `ty` is the lane type.
    Lane(LaneProj),
    /// Payload of a tagged-union variant.
    EnumPayload(PayloadProj),
}

pub struct FieldProj { field: FieldId; ty: Id<TyKind>; }
// `pad` makes the size a multiple of 8 (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct IndexProj { index: Operand; ty: Id<TyKind>; pad: u32 = 0; }
pub struct LaneProj { lane: u8; ty: Id<TyKind>; }
pub struct PayloadProj { variant: VariantId; ty: Id<TyKind>; }

pub enum PlaceRoot {
    Local(LocalRoot),
    Global(GlobalRoot),
}

pub struct LocalRoot { id: Id<LocalDecl>; }
pub struct GlobalRoot { id: Id<GlobalDef>; }

pub struct Place {
    /// Type of the value in the slot (`Arena`, not `&Arena`, after deref).
    ty: Id<TyKind>;
    access: Access;
    span: Span;
    root: PlaceRoot;
    proj: List<Proj>;

    fn local(arena: &Arena, local: Id<LocalDecl>, ty: Id<TyKind>, access: Access, span: Span): Place {
        return Place { ty: ty, access: access, span: span, root: PlaceRoot.Local(LocalRoot { id: local }), proj: List<Proj>.new(arena) };
    }

    fn global(arena: &Arena, global: Id<GlobalDef>, ty: Id<TyKind>, access: Access, span: Span): Place {
        return Place { ty: ty, access: access, span: span, root: PlaceRoot.Global(GlobalRoot { id: global }), proj: List<Proj>.new(arena) };
    }

    /// `this` with `proj` appended and the new type, access and span.
    fn project(this: Place, proj: Proj, ty: Id<TyKind>, access: Access, span: Span): Place {
        let p = this;
        // an exact-size copy: no spare room (a 4-slot list per one-step place was most of `Place`'s memory),
        // and the result never writes into `this`'s buffer
        let n = this.proj.len;
        let items = this.proj.arena.alloc::<Proj>(n + 1);
        for i in 0..n { items[i] = this.proj.items[i]; }
        items[n] = proj;
        p.proj = List<Proj> { items: items, len: n + 1, arena: this.proj.arena };
        p.ty = ty;
        p.access = access;
        p.span = span;
        return p;
    }
}
