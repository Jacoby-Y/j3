// Structs, enums, fns as entities. Layout is C; payloadless enums are i32. Tuples are structs with fields
// `0`, `1`.. interned by element list; `dyn Trait` is a `{ $data, $vt }` struct with a per-trait table layout.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/entity.rs, ir/tuple.rs
// J3: entity.rs is ported field for field (C2a). Rust `module: Vec<Name>` is `moduleName: List<Sym>`
// (`module` is a keyword), `lib` is `libName`, snake_case is camelCase. Docs and other `String`s are arena
// copies. `FuncKind::J3 { body }` is `J3(J3Fn { body })`, `Lib { lib, symbol }` `Lib(LibFn { libName,
// symbol })`; `ConstInit::Fields(Vec<(String, ConstInit)>)` is `Fields(ConstFields { fields:
// List<ConstField { name, init }> })`, `Elems` `Elems(ConstElems { elems })`, `Scalar(op)` `Scalar(ScalarInit { value })`. `StructDef.ty_args:
// Vec<(String, Ty)>` is `List<TyArg { name, ty }>`.
// J3: ir/tuple.rs: the tuple struct is made by `lower` (`Lw.tupleTy` / `Lw.tuples`; sema interns the
// type, so no `TupleTables`). The `dyn` tables are `ir/dyn_ty.j3`, the closure tables `ir/closure.j3`.
module j3c.ir;

pub enum Vis { Pub, Private }

pub struct FieldDef {
    name: Sym;
    doc: string;
    ty: Id<TyKind>;
    /// `use field: Type` embedding. Methods are not promoted.
    embedded: bool;
    /// Literal from `name: Type = 0`. Omitted struct-lit fields copy this.
    default: Option<Operand>;
}

/// One type argument of a generic struct instance (Rust `(String, Ty)`).
pub struct TyArg {
    name: string;
    ty: Id<TyKind>;
}

pub struct StructDef {
    moduleName: List<Sym>;
    name: Sym;
    doc: string;
    fields: List<FieldDef>;
    packed: bool;
    debug: bool;
    span: Span;
    /// Type arguments this instance was built with. Empty for non-generic structs.
    tyArgs: List<TyArg>;
    /// Script rules without changing the native struct layout.
    script: Option<ScriptMeta>;

    /// Field `id.index` (a copy).
    fn field(this: &StructDef, id: FieldId): FieldDef { return this.fields.items[int(id.index)]; }
}

pub struct ScriptMeta {
    path: string;
    propSpans: List<Span>;
}

pub struct VariantDef {
    name: Sym;
    doc: string;
    /// `None` = payloadless. Any payload makes the whole enum a tagged union.
    payload: Option<Id<TyKind>>;
    /// `V(A, B, ..)`: `payload` is a struct of the fields, named `0`, `1`, .. (C layout). `false` for `V(A)`.
    multi: bool;
}

pub struct TryCatch {
    success: VariantId;
    failure: VariantId;
}

pub struct EnumDef {
    moduleName: List<Sym>;
    name: Sym;
    doc: string;
    variants: List<VariantDef>;
    tryCatch: Option<TryCatch>;
    debug: bool;
    span: Span;
    /// Type arguments of a generic instance (empty otherwise); with `span`, its identity.
    tyArgs: List<Id<TyKind>>;

    /// No variant has a payload (the enum is an `i32`).
    fn isCLike(this: &EnumDef): bool {
        for i in 0..this.variants.len {
            match this.variants.items[i].payload {
                Option.Some(_) { return false; }
                Option.None {}
            }
        }
        return true;
    }
}

pub enum FuncKind {
    /// Ordinary J3 function with a typed body.
    J3(J3Fn),
    /// `use lib` import. Linker resolves `symbol` in `libName`.
    Lib(LibFn),
    /// Declared, body filled in later.
    Decl,
}

pub struct J3Fn { body: Body; }
pub struct LibFn { libName: Sym; symbol: Sym; }

// Field order: payload-enum fields at 8-aligned offsets, bools last (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct GlobalDef {
    id: Id<GlobalDef>;
    doc: string;
    moduleName: List<Sym>;
    /// `None` = BSS zero. Const-folded singleton initializer.
    init: Option<ConstInit>;
    name: Sym;
    ty: Id<TyKind>;
    span: Span;
    /// `#[thread]`: one copy per thread.
    thread: bool;
    /// `const NAME: [N]T = [..]`: static read-only data; stores are a compile error.
    readonly: bool;
}

pub enum ConstInit {
    Scalar(ScalarInit),
    Fields(ConstFields),
    Elems(ConstElems),
}

pub struct ScalarInit { value: Operand; }
pub struct ConstFields { fields: List<ConstField>; }
pub struct ConstField { name: string; init: ConstInit; }
pub struct ConstElems { elems: List<ConstInit>; }

// Field order: `kind` at an 8-aligned offset (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct Func {
    id: Id<Func>;
    doc: string;
    moduleName: List<Sym>;
    kind: FuncKind;
    name: Sym;
    ty: Id<TyKind>;
    vis: Vis;
    methodOf: Option<Id<StructDef>>;
    span: Span;
}
