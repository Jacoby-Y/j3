// Integer wrap and divide-by-zero: one rule every backend follows.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/wrap.rs
// J3: Overflow wraps (two's complement). Division or remainder by zero is `Abort`, not a host trap.
// `INT_MIN / -1` wraps to `MIN` (and `% -1` is 0): J3's own `/` would wrap the same way, but the
// `-1` case is spelled out so the fold never depends on the host's division.
module j3c.ir;

/// Debug interpolate cap. Overflow of this buffer is `Abort`.
pub const INTERP_CAP: u64 = 512;

pub fn wrappingBin(op: BinOp): bool {
    match op {
        BinOp.Add { return true; }
        BinOp.Sub { return true; }
        BinOp.Mul { return true; }
        BinOp.Div { return true; }
        BinOp.Rem { return true; }
        BinOp.Shl { return true; }
        BinOp.Shr { return true; }
        _ { return false; }
    }
}

pub fn wrappingUnary(op: UnaryOp): bool { return op == UnaryOp.Neg; }

/// Fold a primitive int binop. None means do not fold (`/0`, non-int op).
pub fn foldBin(op: BinOp, a: i64, b: i64): Option<i64> {
    match op {
        BinOp.Add { return Option.Some(a + b); }
        BinOp.Sub { return Option.Some(a - b); }
        BinOp.Mul { return Option.Some(a * b); }
        BinOp.Div {
            if b == 0 { return Option.None; }
            if b == -1 { return Option.Some(foldNeg(a)); }
            return Option.Some(a / b);
        }
        BinOp.Rem {
            if b == 0 { return Option.None; }
            if b == -1 { return Option.Some(0); }
            return Option.Some(a % b);
        }
        _ { return Option.None; }
    }
}

/// `-a`, wrapping (`MIN` stays `MIN`).
pub fn foldNeg(a: i64): i64 { return i64(0 - u64(a)); }
