// Operands: a constant or a copy of a place.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/operand.rs
// J3: Rust `Const` is `ConstVal` (`const` is a keyword). `ConstKind::FnAddr(id)` is `FnAddr(FnAddrConst
// { func })`, `Bytes(Vec<u8>)` `Bytes(BytesConst { bytes })` (an arena copy). The constructors are free fns
// (`opUnit`, `opInt`, ...) since `Operand` is an enum.
module j3c.ir;

pub struct ConstVal {
    ty: Id<TyKind>;
    span: Span;
    kind: ConstKind;
}

pub enum ConstKind {
    Void,
    Bool(bool),
    /// Bit pattern. Width/sign come from `ConstVal.ty`.
    Int(u64),
    F32Bits(u32),
    F64Bits(u64),
    FnAddr(FnAddrConst),
    Null,
    /// UTF-8 bytes for a `string` lang-item constant.
    Bytes(BytesConst),
}

pub struct FnAddrConst { func: Id<Func>; }
pub struct BytesConst { bytes: []u8; }

pub enum Operand {
    Const(ConstVal),
    /// Load / memcpy from a place. Copying `&T` is a pointer copy (fine).
    Copy(Place),
}

/// Rust `Operand::ty`.
pub fn operandTy(o: Operand): Id<TyKind> {
    match o {
        Operand.Const(c) { return c.ty; }
        Operand.Copy(p) { return p.ty; }
    }
}

fn constOp(span: Span, ty: Id<TyKind>, kind: ConstKind): Operand {
    return Operand.Const(ConstVal { ty: ty, span: span, kind: kind });
}

pub fn opUnit(span: Span, voidTy: Id<TyKind>): Operand { return constOp(span, voidTy, ConstKind.Void); }
pub fn opInt(span: Span, ty: Id<TyKind>, bits: u64): Operand { return constOp(span, ty, ConstKind.Int(bits)); }
pub fn opFnAddr(span: Span, ty: Id<TyKind>, id: Id<Func>): Operand { return constOp(span, ty, ConstKind.FnAddr(FnAddrConst { func: id })); }
pub fn opBool(span: Span, ty: Id<TyKind>, value: bool): Operand { return constOp(span, ty, ConstKind.Bool(value)); }
/// `bits` is the IEEE-754 pattern (Rust `f32::to_bits`).
pub fn opF32Bits(span: Span, ty: Id<TyKind>, bits: u32): Operand { return constOp(span, ty, ConstKind.F32Bits(bits)); }
pub fn opF64Bits(span: Span, ty: Id<TyKind>, bits: u64): Operand { return constOp(span, ty, ConstKind.F64Bits(bits)); }
pub fn opNull(span: Span, ty: Id<TyKind>): Operand { return constOp(span, ty, ConstKind.Null); }
/// The bytes are copied into `arena`.
pub fn opBytes(arena: &Arena, span: Span, ty: Id<TyKind>, bytes: []u8): Operand {
    return constOp(span, ty, ConstKind.Bytes(BytesConst { bytes: own(arena, bytes as string) as []u8 }));
}
