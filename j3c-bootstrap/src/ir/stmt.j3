// Statements (all `void`): assign, call, if, loop, break, return, abort, defer-expanded blocks.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/stmt.rs
// J3: Payload structs with Rust's field names: `Assign(AssignStmt { place, rvalue })`, `AssignOp(AssignOpStmt
// { place, op, rhs })`, `Defer(DeferStmt { body })`, `If(IfStmt { cond, thenBlock, elseBlock })`,
// `Switch(SwitchStmt { scrut, cases: List<SwitchCase { value, block }>, default })`, `While(WhileStmt
// { cond, body })`, `Return(ReturnStmt { value })`, `Break(u32)`, `Continue(u32)`, `Expr(Rvalue)`,
// `ForRange(ForRangeStmt { index, end, body })`, `Abort(AbortStmt { kind, args })`, `Div0`,
// `Block(Block)`, `InterpFill(InterpFillStmt { buf, used, parts })`. Constructors are `Stmt.assign` etc.
module j3c.ir;

pub struct Stmt {
    ty: Id<TyKind>;
    span: Span;
    kind: StmtKind;

    fn assign(span: Span, voidTy: Id<TyKind>, place: Place, rvalue: Rvalue): Stmt {
        return Stmt { ty: voidTy, span: span, kind: StmtKind.Assign(AssignStmt { place: place, rvalue: rvalue }) };
    }
    fn assignOp(span: Span, voidTy: Id<TyKind>, place: Place, op: BinOp, rhs: Operand): Stmt {
        return Stmt { ty: voidTy, span: span, kind: StmtKind.AssignOp(AssignOpStmt { place: place, op: op, rhs: rhs }) };
    }
    fn expr(span: Span, voidTy: Id<TyKind>, rvalue: Rvalue): Stmt {
        return Stmt { ty: voidTy, span: span, kind: StmtKind.Expr(rvalue) };
    }
    fn returnValue(span: Span, voidTy: Id<TyKind>, value: Option<Operand>): Stmt {
        return Stmt { ty: voidTy, span: span, kind: StmtKind.Return(ReturnStmt { value: value }) };
    }
    fn ifThen(span: Span, voidTy: Id<TyKind>, cond: Operand, thenBlock: Block): Stmt {
        return Stmt { ty: voidTy, span: span, kind: StmtKind.If(IfStmt { cond: cond, thenBlock: thenBlock, elseBlock: Option.None }) };
    }
}

pub enum StmtKind {
    /// Store `rvalue` into `place`. Place is bound once.
    Assign(AssignStmt),
    /// `place += rhs` (and `*=`, ...). Place, including `xs[i]`, is bound once. Never lowered from
    /// `place = place + rhs` in source.
    AssignOp(AssignOpStmt),
    /// Runs at end of the current block, LIFO.
    Defer(DeferStmt),
    If(IfStmt),
    /// Integer `match`: runs the case whose value equals `scrut` (bit pattern of its int type), else
    /// `default`. Values are distinct. Printers emit a `switch`.
    Switch(SwitchStmt),
    /// `cond` is a value, not a re-tested expression. Source `while` is rewritten so the test is assigned
    /// at the top of `body` each iteration.
    While(WhileStmt),
    Return(ReturnStmt),
    /// Leaves the loop `n` levels out (0 is the innermost); `break 'outer;` sets it.
    Break(u32),
    Continue(u32),
    Expr(Rvalue),
    /// `for i in start..end`. `index` is bound once. Step is `+= 1`.
    ForRange(ForRangeStmt),
    /// Bounds-check / panic abort. `--fast` strips these. The operands are `int` values shown in the
    /// message (`abortDetail`): index and len, or a slice's ends.
    Abort(AbortStmt),
    /// Integer division by zero. `--fast` does not strip this.
    Div0,
    /// Nested `{}`. Defers in `body` run at the end of this block.
    Block(Block),
    /// Fill `buf` (`[N]u8`) from interpolate parts; write byte count to `used`. Printers emit ordinary
    /// stmts and `Abort` if `used` would exceed `buf` len.
    InterpFill(InterpFillStmt),
}

pub struct AssignStmt { place: Place; rvalue: Rvalue; }
// Operand before `op` and `pad` (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct AssignOpStmt { place: Place; rhs: Operand; op: BinOp; pad: u32 = 0; }
pub struct DeferStmt { body: Block; }
pub struct IfStmt { cond: Operand; thenBlock: Block; elseBlock: Option<Block>; }
pub struct SwitchCase { value: u64; block: Block; }
pub struct SwitchStmt { scrut: Operand; cases: List<SwitchCase>; default: Block; }
pub struct WhileStmt { cond: Operand; body: Block; }
pub struct ReturnStmt { value: Option<Operand>; }
pub struct ForRangeStmt { index: Place; end: Operand; body: Block; }
pub struct AbortStmt { kind: AbortKind; args: List<Operand>; }
pub struct InterpFillStmt { buf: Place; used: Place; parts: List<InterpPart>; }

/// Why a runtime check failed; picks the message `j3c` prints before exit 102.
pub enum AbortKind {
    Index,
    Slice,
    Div0,
    Fmt,
    NoReturn,
    /// `xs[a..b]` with `b < a`.
    SliceOrder,
}

/// Every kind in `abortCode` order (the packed-abort table in the LLVM printer), Rust `AbortKind::ALL`.
pub fn abortKinds(arena: &Arena): []AbortKind {
    let ks = arena.alloc::<AbortKind>(6);
    ks[0] = AbortKind.Index;
    ks[1] = AbortKind.Slice;
    ks[2] = AbortKind.Div0;
    ks[3] = AbortKind.Fmt;
    ks[4] = AbortKind.NoReturn;
    ks[5] = AbortKind.SliceOrder;
    return ks;
}

pub fn abortCode(k: AbortKind): u64 {
    match k {
        AbortKind.Index { return 0; }
        AbortKind.Slice { return 1; }
        AbortKind.Div0 { return 2; }
        AbortKind.Fmt { return 3; }
        AbortKind.NoReturn { return 4; }
        AbortKind.SliceOrder { return 5; }
    }
}

pub fn abortMessage(k: AbortKind): string {
    match k {
        AbortKind.Index { return "index out of bounds"; }
        AbortKind.Slice { return "slice range out of bounds"; }
        AbortKind.Div0 { return "integer divide by zero"; }
        AbortKind.Fmt { return "string interpolation overflowed its buffer"; }
        AbortKind.NoReturn { return "function ended without returning a value"; }
        AbortKind.SliceOrder { return "slice range out of bounds"; }
    }
}

/// The text around the two values after the message (Rust `detail()[0]` / `[1]`): `": index "`, `", len "`
/// read `index out of bounds: index 5, len 3`. Both "" for a kind without values.
pub fn abortDetail(k: AbortKind): (string, string) {
    match k {
        AbortKind.Index { return (": index ", ", len "); }
        AbortKind.Slice { return (": ", " is past len "); }
        AbortKind.SliceOrder { return (": end ", " is before start "); }
        AbortKind.Div0 { return ("", ""); }
        AbortKind.Fmt { return ("", ""); }
        AbortKind.NoReturn { return ("", ""); }
    }
}

/// `abortMessage` plus the values, as a backend that formats at run time prints it (Rust `text_with`).
pub fn abortTextWith(k: AbortKind, vals: []i64, t: &Text): &Text {
    let d = abortDetail(k);
    t.add(abortMessage(k));
    if vals.len == 2 && d.0.len > 0 {
        t.add(d.0).fmt(`{vals[0]}`).add(d.1).fmt(`{vals[1]}`);
    }
    return t;
}
