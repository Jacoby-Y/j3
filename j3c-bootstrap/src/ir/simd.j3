// SIMD ops that are not plain operators (shuffle, sum, min/max, load/store).
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/simd.rs
// J3: `+ - * /` and the bit ops are ordinary `BinOp`s on vector operands (a scalar operand is splatted
// first); lane reads and writes are `Proj.Lane`. `Shuffle([u8; 4])` is `Shuffle(ShuffleLanes { lanes })`.
module j3c.ir;

pub enum SimdOp {
    /// One lane value in all four lanes.
    Splat,
    /// Four lane values `x y z w`.
    Build,
    /// `a < b ? a : b` per lane (a NaN lane gives `b`; equal lanes, even `-0.0` vs `0.0`, give `b`).
    Min,
    /// `a > b ? a : b` per lane.
    Max,
    /// `vec4f` only: IEEE square root.
    Sqrt,
    /// Absolute value per lane (`vec4i`: `i32::MIN` wraps to itself).
    Abs,
    /// Horizontal add, fixed tree `(x + y) + (z + w)`; result is the lane type.
    Sum,
    /// `[a.i0, a.i1, a.i2, a.i3]`, indices 0..3.
    Shuffle(ShuffleLanes),
    /// `vec4i` to `vec4f`.
    ToFloat,
    /// `vec4f` to `vec4i`, truncating toward zero; saturates, NaN gives 0.
    ToInt,
    /// `args[0]` is `&lane` of `xs[i]`; reads four lanes with `align 4`.
    Load,
    /// `args[0]` is `&lane` of `xs[i]`, `args[1]` the vector. Type is `void`.
    Store,
}

pub struct ShuffleLanes { lanes: [4]u8; }

pub fn simdName(op: SimdOp): string {
    match op {
        SimdOp.Splat { return "splat"; }
        SimdOp.Build { return "build"; }
        SimdOp.Min { return "min"; }
        SimdOp.Max { return "max"; }
        SimdOp.Sqrt { return "sqrt"; }
        SimdOp.Abs { return "abs"; }
        SimdOp.Sum { return "sum"; }
        SimdOp.Shuffle(_) { return "shuffle"; }
        SimdOp.ToFloat { return "tofloat"; }
        SimdOp.ToInt { return "toint"; }
        SimdOp.Load { return "load"; }
        SimdOp.Store { return "store"; }
    }
}

/// Lane letter `i` (0..3) in order `x y z w` (Rust `LANE_NAMES[i]`).
pub fn laneName(i: int): string {
    if i == 0 { return "x"; }
    if i == 1 { return "y"; }
    if i == 2 { return "z"; }
    return "w";
}

pub fn laneIndex(name: string): Option<u8> {
    for i in 0..4 {
        if laneName(i) == name { return Option.Some(u8(i)); }
    }
    return Option.None;
}
