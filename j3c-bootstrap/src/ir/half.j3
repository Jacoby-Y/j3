// `f16` conversions done in integers so constants match on every backend.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/half.rs
module j3c.ir;
// J3: C2c (contracts-c2c.md, owner: simd/f16/intrinsics). Rust's unit test is `tests/unit/ir_half_test.j3`.

/// Rust `half::from_f64`: `d` as IEEE binary16 bits (round to nearest even, overflow to infinity, NaN
/// kept quiet with its payload's top bits).
pub fn halfFromF64(d: f64): u16 {
    let v = d;
    let raw: []u64 = @slice(&v as ptr, 1);
    let bits = raw[0];
    let sign = (bits >> 48) & 0x8000;
    let abs = bits & 0x7fffffffffffffff;
    if abs > 0x7ff0000000000000 {
        return u16(sign | 0x7c00 | 0x200 | ((abs & 0x0007ffffffffffff) >> 42));
    }
    let e = int(abs >> 52) - 1023;
    if e > 15 { return u16(sign | 0x7c00); }
    let mant = (abs & 0x000fffffffffffff) | 0x0010000000000000;
    let r: u64 = 0;
    let shift = 42;
    if e >= -14 {
        r = (u64(e + 15) << 10) + ((mant >> 42) - 1024);
    } else {
        shift = 42 + (-14 - e);
    }
    if (abs >> 52) == 0 || shift > 53 { return u16(sign); }
    let rem = mant & ((u64(1) << u64(shift)) - 1);
    let half = u64(1) << u64(shift - 1);
    if e < -14 { r = mant >> u64(shift); }
    if rem > half || (rem == half && (r & 1) == 1) { r += 1; }
    if r > 0x7c00 { r = 0x7c00; }
    return u16(sign | r);
}
