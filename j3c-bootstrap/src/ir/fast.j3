// `--fast`: drop bounds-check aborts and the ifs that only abort. An IR-to-IR pass.
//
// Port of: j3c/src/ir/fast.rs
// J3: Separate module j3c.ir.fast. A conditional entry (`opts.fast`) in the pass table (plan 11 B8).
// J3: Rust rewrites each block in place (`drain`); here `stripBlock` returns the kept statements as a new
// list and the caller stores the block back (enum payloads are values). `Div0` stays, as in Rust.
module j3c.ir.fast;

use j3.data.pool.Id;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3c.ir.{ Block, Func, FuncKind, IrCx, Stmt, StmtKind };

/// Rust `strip_aborts`: every J3 fn body of `cx`.
pub fn stripAborts(cx: &IrCx) {
    for i in 0..cx.funcs.len() {
        let f = cx.funcMut(Id<Func> { i: u32(i) });
        match f.kind {
            FuncKind.J3(j) {
                j.body.block = stripBlock(cx.arena, j.body.block);
                f.kind = FuncKind.J3(j);
            }
            FuncKind.Lib(_) {}
            FuncKind.Decl {}
        }
    }
}

fn stripBlock(a: &Arena, block: Block): Block {
    let out = List<Stmt>.new(a);
    for i in 0..block.stmts.len {
        let st = block.stmts.items[i];
        match st.kind {
            StmtKind.Abort(_) {}
            StmtKind.If(f) {
                let dropIf = isAbortOnly(f.thenBlock) && noElse(f.elseBlock);
                f.thenBlock = stripBlock(a, f.thenBlock);
                match f.elseBlock {
                    Option.Some(e) { f.elseBlock = Option.Some(stripBlock(a, e)); }
                    Option.None {}
                }
                if !dropIf && !(f.thenBlock.stmts.len == 0 && noElse(f.elseBlock)) {
                    st.kind = StmtKind.If(f);
                    out.push(st);
                }
            }
            StmtKind.While(w) {
                w.body = stripBlock(a, w.body);
                st.kind = StmtKind.While(w);
                out.push(st);
            }
            StmtKind.ForRange(r) {
                r.body = stripBlock(a, r.body);
                st.kind = StmtKind.ForRange(r);
                out.push(st);
            }
            StmtKind.Defer(d) {
                d.body = stripBlock(a, d.body);
                st.kind = StmtKind.Defer(d);
                out.push(st);
            }
            StmtKind.Block(b) {
                st.kind = StmtKind.Block(stripBlock(a, b));
                out.push(st);
            }
            StmtKind.Switch(s) {
                // the case list is shared with `st`, so its blocks are stored in place
                for k in 0..s.cases.len { s.cases.items[k].block = stripBlock(a, s.cases.items[k].block); }
                s.default = stripBlock(a, s.default);
                st.kind = StmtKind.Switch(s);
                out.push(st);
            }
            StmtKind.Assign(_) { out.push(st); }
            StmtKind.AssignOp(_) { out.push(st); }
            StmtKind.Return(_) { out.push(st); }
            StmtKind.Break(_) { out.push(st); }
            StmtKind.Continue(_) { out.push(st); }
            StmtKind.Expr(_) { out.push(st); }
            StmtKind.Div0 { out.push(st); }
            StmtKind.InterpFill(_) { out.push(st); }
        }
    }
    return Block { stmts: out };
}

/// No `else`, or an empty one.
fn noElse(e: Option<Block>): bool {
    match e {
        Option.Some(b) { return b.stmts.len == 0; }
        Option.None { return true; }
    }
}

fn isAbortOnly(block: Block): bool {
    if block.stmts.len != 1 { return false; }
    match block.stmts.items[0].kind {
        StmtKind.Abort(_) { return true; }
        _ { return false; }
    }
}
