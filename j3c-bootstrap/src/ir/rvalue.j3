// Rvalues: anything that produces a value; always typed.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/rvalue.rs
// J3: Payload structs with Rust's field names: `Use(Operand)`, `Ref(RefRv { place })`, `Binary(BinaryRv
// { op, lhs, rhs })`, `Unary(UnaryRv { op, arg })`, `Call(CallRv { func, args })`, `Syscall(SyscallRv
// { nr, args })`, `Atomic(AtomicRv { op, order, args })`, `Simd(SimdRv { op, args })`, `Aggregate(AggregateRv
// { fields })`, `Enum(EnumRv { variant, payload })`, `Cast(CastRv { from })`, `Interpolate(InterpolateRv
// { parts })`; `InterpPart::Lit(bytes)` is `Lit(InterpLit { bytes })` (arena copy), `Value(Operand)`.
module j3c.ir;

pub struct Rvalue {
    ty: Id<TyKind>;
    span: Span;
    kind: RvalueKind;

    fn useOp(span: Span, operand: Operand): Rvalue { return Rvalue { ty: operandTy(operand), span: span, kind: RvalueKind.Use(operand) }; }
    fn refPlace(span: Span, refTy: Id<TyKind>, place: Place): Rvalue { return Rvalue { ty: refTy, span: span, kind: RvalueKind.Ref(RefRv { place: place }) }; }
    fn binary(span: Span, ty: Id<TyKind>, op: BinOp, lhs: Operand, rhs: Operand): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Binary(BinaryRv { op: op, lhs: lhs, rhs: rhs }) };
    }
    fn call(span: Span, ty: Id<TyKind>, func: Operand, args: List<Operand>): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Call(CallRv { func: func, args: args }) };
    }
    fn syscall(span: Span, intTy: Id<TyKind>, nr: Operand, args: List<Operand>): Rvalue {
        return Rvalue { ty: intTy, span: span, kind: RvalueKind.Syscall(SyscallRv { nr: nr, args: args }) };
    }
    fn atomic(span: Span, ty: Id<TyKind>, op: AtomicOp, order: AtomicOrder, args: List<Operand>): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Atomic(AtomicRv { op: op, order: order, args: args }) };
    }
    fn simd(span: Span, ty: Id<TyKind>, op: SimdOp, args: List<Operand>): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Simd(SimdRv { op: op, args: args }) };
    }
    fn cast(span: Span, ty: Id<TyKind>, from: Operand): Rvalue { return Rvalue { ty: ty, span: span, kind: RvalueKind.Cast(CastRv { from: from }) }; }
    fn aggregate(span: Span, ty: Id<TyKind>, fields: List<Operand>): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Aggregate(AggregateRv { fields: fields }) };
    }
    fn enumNew(span: Span, ty: Id<TyKind>, variant: VariantId, payload: Option<Operand>): Rvalue {
        return Rvalue { ty: ty, span: span, kind: RvalueKind.Enum(EnumRv { variant: variant, payload: payload }) };
    }
}

pub enum RvalueKind {
    Use(Operand),
    /// `&place`. Place is bound once. Requires `place.access.takeRef`.
    Ref(RefRv),
    Binary(BinaryRv),
    Unary(UnaryRv),
    Call(CallRv),
    /// `@syscall(nr, args...)`. Type is `int`.
    Syscall(SyscallRv),
    /// `@atomicLoad(p)` and friends: `args[0]` is a `&T`, the rest are `T` values. Type is `T` (`int` for
    /// `Store`, `bool` for `Cas`).
    Atomic(AtomicRv),
    /// `vec4f` / `vec4i` op that is not an operator (`ir/simd.j3`).
    Simd(SimdRv),
    Aggregate(AggregateRv),
    /// Enum construction. C-like variants have `payload: None`.
    Enum(EnumRv),
    Cast(CastRv),
    /// `` `hello {name}` `` debug dump. Type is `string`.
    Interpolate(InterpolateRv),
}

pub struct RefRv { place: Place; }
// Operands first and `pad` so the size is a multiple of 8 (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct BinaryRv { lhs: Operand; rhs: Operand; op: BinOp; pad: u32 = 0; }
pub struct UnaryRv { arg: Operand; op: UnaryOp; pad: u32 = 0; }
pub struct CallRv { func: Operand; args: List<Operand>; }
pub struct SyscallRv { nr: Operand; args: List<Operand>; }
pub struct AtomicRv { op: AtomicOp; order: AtomicOrder; args: List<Operand>; }
pub struct SimdRv { op: SimdOp; args: List<Operand>; }
pub struct AggregateRv { fields: List<Operand>; }
pub struct EnumRv { variant: VariantId; payload: Option<Operand>; }
pub struct CastRv { from: Operand; }
pub struct InterpolateRv { parts: List<InterpPart>; }

pub enum InterpPart {
    Lit(InterpLit),
    Value(Operand),
}

/// Literal bytes of an interpolation (arena copy).
pub struct InterpLit { bytes: []u8; }
