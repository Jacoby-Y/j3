// Closure types as a two-field struct `{ fn, ctx }`.
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/closure.rs
module j3c.ir;
// J3: C2c (contracts-c2c.md, owner: closures). `closure(P..): R` is an ordinary struct `{ $f: fn(ptr, P..): R,
// $ctx: ptr }` named `closure(A, B): R` (`boxed closure(..)` when boxed: a second, distinct struct of the
// same layout); equal signatures intern to one struct. Sema owns the closure *type* rules (`Ty.Closure`);
// these tables are what `lower` asks so each signature gets one IR struct, made where Rust made it.
// J3: Rust's three maps are one list of signatures plus a struct-id index: signatures are few, the
// by-signature lookup runs only when `lower` first meets a type or a literal, and nothing is printed from
// here (rule 3).

/// One interned closure signature and its struct.
pub struct ClosureSig {
    params: List<Id<TyKind>>;
    ret: Id<TyKind>;
    ty: Id<TyKind>;
    id: Id<StructDef>;
    boxed: bool;
}

/// Rust `ClosureTables`. `sigs` in creation order.
pub struct ClosureTables {
    sigs: List<ClosureSig>;
    /// Struct id to its index in `sigs` (Rust `sigs` / `boxed`).
    byStruct: Map<u32, int>;
    /// Plain fn id to the `(ctx: ptr, ..)` thunk that lets it stand in for a closure (Rust `thunks`).
    thunks: Map<u32, u32>;
}

/// Empty tables (`IrCx.new`).
pub fn closureTablesNew(arena: &Arena): ClosureTables {
    return ClosureTables { sigs: List<ClosureSig>.new(arena), byStruct: Map<u32, int>.new(arena, 16), thunks: Map<u32, u32>.new(arena, 16) };
}

extend IrCx {
    /// Rust `closure_lookup`: the struct for `closure(params): ret`, when it already exists.
    fn closureLookup(this: &IrCx, params: &List<Id<TyKind>>, ret: Id<TyKind>, boxed: bool): Option<Id<TyKind>> {
        for i in 0..this.closures.sigs.len {
            let s = this.closures.sigs.items[i];
            if s.boxed != boxed || s.ret != ret || s.params.len != params.len { continue; }
            let same = true;
            for k in 0..params.len {
                if s.params.items[k] != params.items[k] { same = false; break; }
            }
            if same { return Option.Some(s.ty); }
        }
        return Option.None;
    }

    /// Rust `closure_sig`: the signature when `ty` is a closure type, stack or boxed.
    fn closureSig(this: &IrCx, ty: Id<TyKind>): Option<ClosureSig> {
        match this.tyKind(ty) {
            TyKind.Struct(s) {
                match this.closures.byStruct.get(s.id.i) {
                    Option.Some(i) { return Option.Some(this.closures.sigs.items[i]); }
                    Option.None {}
                }
            }
            _ {}
        }
        return Option.None;
    }

    /// Rust `is_boxed_closure`.
    fn isBoxedClosure(this: &IrCx, ty: Id<TyKind>): bool {
        match this.closureSig(ty) { Option.Some(s) { return s.boxed; } Option.None {} }
        return false;
    }

    /// Rust `closure_fn_ty`: `fn(ptr, params..): ret`, the type of a closure's body fn.
    fn closureFnTy(this: &IrCx, params: &List<Id<TyKind>>, ret: Id<TyKind>): Id<TyKind> {
        let ps = List<Id<TyKind>>.new(this.arena);
        ps.push(this.common.ptr);
        ps.extend(params.slice());
        return this.tyFn(ps, ret);
    }

    /// Rust `closure_ty`: interns `closure(params): ret`; a new struct (module `moduleName`, at `span`)
    /// is pushed on `structs`, the creating module's list. `name` is Rust's `closure(A, B): R` spelling
    /// (`boxed closure(..)`), built by the caller: `ir/dump` sits above this module, so `dumpTy` is not
    /// callable here (`lower/closure.j3` `closureName`).
    fn closureTy(this: &IrCx, params: &List<Id<TyKind>>, ret: Id<TyKind>, boxed: bool, name: string, moduleName: List<Sym>, span: Span,
        structs: &List<Id<StructDef>>): Id<TyKind> {
        match this.closureLookup(params, ret, boxed) { Option.Some(t) { return t; } Option.None {} }
        let fields = List<FieldDef>.new(this.arena);
        fields.push(FieldDef { name: this.internName("$f"), doc: "", ty: this.closureFnTy(params, ret), embedded: false, default: Option.None });
        fields.push(FieldDef { name: this.internName("$ctx"), doc: "", ty: this.common.ptr, embedded: false, default: Option.None });
        let id = this.allocStruct(StructDef { moduleName: moduleName, name: this.internName(name), doc: "", fields: fields,
            packed: false, debug: false, span: span, tyArgs: List<TyArg>.new(this.arena), script: Option.None });
        structs.push(id);
        let ty = this.tyStruct(id);
        let ps = List<Id<TyKind>>.new(this.arena);
        ps.extend(params.slice());
        this.closures.byStruct.put(id.i, this.closures.sigs.len);
        this.closures.sigs.push(ClosureSig { params: ps, ret: ret, ty: ty, id: id, boxed: boxed });
        return ty;
    }
}
