// Operators: compiler-known primitive math (user `operator+` is a call).
//
// Part of module j3c.ir.
// Port of: j3c/src/ir/op.rs
// J3: Integer `BinOp` wraps (two's complement), no traps. `AtomicOp`/`AtomicOrder` and their
// name/fromName/values/allows live in `syntax/ast/expr.j3` (the parser needs them first); the LLVM
// keyword and the compare-exchange failure order are here. `AtomicOrder::c11` was for the C backend
// (removed, plan 11 B8a).
module j3c.ir;

pub enum BinOp { Add, Sub, Mul, Div, Rem, Eq, Ne, Lt, Le, Gt, Ge, And, Or, BitAnd, BitOr, BitXor, Shl, Shr }

pub fn binOpStr(op: BinOp): string {
    match op {
        BinOp.Add { return "+"; }
        BinOp.Sub { return "-"; }
        BinOp.Mul { return "*"; }
        BinOp.Div { return "/"; }
        BinOp.Rem { return "%"; }
        BinOp.Eq { return "=="; }
        BinOp.Ne { return "!="; }
        BinOp.Lt { return "<"; }
        BinOp.Le { return "<="; }
        BinOp.Gt { return ">"; }
        BinOp.Ge { return ">="; }
        BinOp.And { return "&&"; }
        BinOp.Or { return "||"; }
        BinOp.BitAnd { return "&"; }
        BinOp.BitOr { return "|"; }
        BinOp.BitXor { return "^"; }
        BinOp.Shl { return "<<"; }
        BinOp.Shr { return ">>"; }
    }
}

/// `+=` and friends; None for an op with no compound form.
pub fn assignOpStr(op: BinOp): Option<string> {
    match op {
        BinOp.Add { return Option.Some("+="); }
        BinOp.Sub { return Option.Some("-="); }
        BinOp.Mul { return Option.Some("*="); }
        BinOp.Div { return Option.Some("/="); }
        BinOp.Rem { return Option.Some("%="); }
        BinOp.BitAnd { return Option.Some("&="); }
        BinOp.BitOr { return Option.Some("|="); }
        BinOp.BitXor { return Option.Some("^="); }
        BinOp.Shl { return Option.Some("<<="); }
        BinOp.Shr { return Option.Some(">>="); }
        _ { return Option.None; }
    }
}

pub enum UnaryOp {
    Neg,
    Not,
    /// Bitwise not.
    BitNot,
}

pub fn unaryOpStr(op: UnaryOp): string {
    match op {
        UnaryOp.Neg { return "-"; }
        UnaryOp.Not { return "!"; }
        UnaryOp.BitNot { return "~"; }
    }
}

/// LLVM keyword of an atomic order (Rust `AtomicOrder::llvm`).
pub fn atomicOrderLlvm(o: AtomicOrder): string {
    match o {
        AtomicOrder.Relaxed { return "monotonic"; }
        AtomicOrder.Acquire { return "acquire"; }
        AtomicOrder.Release { return "release"; }
        AtomicOrder.AcqRel { return "acq_rel"; }
        AtomicOrder.SeqCst { return "seq_cst"; }
    }
}

/// Order for the failure path of a compare-exchange: no release part, no stronger than `o`.
pub fn atomicCasFailure(o: AtomicOrder): AtomicOrder {
    match o {
        AtomicOrder.Relaxed { return AtomicOrder.Relaxed; }
        AtomicOrder.Release { return AtomicOrder.Relaxed; }
        AtomicOrder.Acquire { return AtomicOrder.Acquire; }
        AtomicOrder.AcqRel { return AtomicOrder.Acquire; }
        AtomicOrder.SeqCst { return AtomicOrder.SeqCst; }
    }
}
