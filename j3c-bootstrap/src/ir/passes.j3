// The IR pass runner (plan 11 B8): a pass is `{ name, cond: fn(&PassCx): bool, run: fn(&PassCx, &Program) }`,
// run in list order after lowering. `validate` (dev builds and tests), `devmode` (dev builds with scripts) and
// `fast` (`--fast`) are entries with a `cond`; a new pass is one entry, not a new call site.
//
// Part of module j3c.ir.
// J3: New in plan 11 B8, no Rust file of its own: replaces the hardcoded fast/dev/validate calls in compile.rs
//     and compile/dev.rs.
// J3: `--dump-after=PASS` calls `PassCx.dump` after that entry (the driver supplies it: `ir/dump` is not
//     ported yet) and `--time-passes` times each entry with `base/phase`; both come from the runner, so
//     every pass gets them.
// J3: `PassCx` (flags, arena, diags, phases) is built by the driver from its `Session`, since `driver` is below `ir`.
//     The ordered list itself is a constant in `driver.j3`, the only stage that sees both `ir` and `devmode`.
//     This file may not use `backend` or `devmode` (tools/layers.txt).
// J3: `Program` is defined in `ir.j3` (C2a).
module j3c.ir;

use j3.memory.Arena;
use j3.sys.monotonicMs;
use j3.text.Text;
use j3c.base.diag.{ Diags, Severity };
use j3c.base.phase.Phases;
use j3c.base.span.noSpan;

/// What a pass can see: build flags plus the session's arena, diagnostics and phase timer.
pub struct PassCx {
    dev: bool;
    fast: bool;
    validate: bool;
    scripts: bool;
    /// Pass name for `--dump-after`, "" for none.
    dumpAfter: string;
    timePasses: bool;
    arena: &Arena;
    diags: &Diags;
    phases: &Phases;
    /// Prints the program after the `dumpAfter` pass (the driver passes `ir.dump` once it is ported).
    dump: fn(&PassCx, &Program);
    /// `&List<BcModule>` (the driver's `Session.bytecode`) that the `devmode` pass fills before it rewrites the
    /// IR; 0 outside dev mode. `ptr` because `backend.bc` sits below `ir` (tools/layers.txt).
    bytecode: ptr = 0;
}

/// One IR-to-IR pass: runs when `cond` says so.
pub struct Pass {
    name: string;
    cond: fn(&PassCx): bool;
    run: fn(&PassCx, &Program);
}

/// Run `passes` in order on `prog`; false when a pass raised an error (the rest are skipped) or `dumpAfter`
/// names no pass. `dumpAfter` dumps at that entry's slot even when its `cond` skipped it, so the flag never
/// prints nothing silently.
pub fn runPasses(passes: []Pass, cx: &PassCx, prog: &Program): bool {
    if cx.dumpAfter != "" && !hasPass(passes, cx.dumpAfter) {
        let t = Text.new(cx.arena);
        t.add("--dump-after: no IR pass named `").add(cx.dumpAfter).add("`");
        // J3: code 0 until the driver's flag errors get codes (C1/C2).
        cx.diags.add(cx.diags.make(0, Severity.Error, noSpan(), t.str()));
        return false;
    }
    let before = cx.diags.count();
    for i in 0..passes.len {
        let p = passes[i];
        let cond = p.cond;
        if cond(cx) {
            let t0 = monotonicMs();
            let run = p.run;
            run(cx, prog);
            if cx.timePasses { cx.phases.step(p.name, f64(monotonicMs() - t0) / 1000.0); }
            if raisedError(cx.diags, before) { return false; }
        }
        if p.name == cx.dumpAfter {
            let dump = cx.dump;
            dump(cx, prog);
        }
    }
    return true;
}

fn hasPass(passes: []Pass, name: string): bool {
    for i in 0..passes.len {
        if passes[i].name == name { return true; }
    }
    return false;
}

/// An error among the diagnostics raised since index `from`.
fn raisedError(diags: &Diags, from: int): bool {
    for i in from..diags.count() {
        match diags.at(i).severity {
            Severity.Error { return true; }
            Severity.Warning {}
        }
    }
    return false;
}
