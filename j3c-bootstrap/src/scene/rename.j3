// A v2 scene file's text with every reference to one asset path changed (the asset menu's rename).
//
// Port of: j3c/src/scenefile.rs (`rename_v2`, `tokens`, `unquote`, `is_data_line`, `short_of`, `quoted`)
// J3: The rest of `scenefile.rs` is `j3.scene3d` (DELETED.md); this edits lines in place, so object lines it
// does not touch keep their bytes (a `scene3d` read + store would rewrite the whole file).
module j3c.scene.rename;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.text.Text;

/// Rust `tokens`: `s` split on spaces outside quotes (a `\` escapes inside them).
pub fn tokens(s: string, arena: &Arena): List<string> {
    let out = List<string>.new(arena);
    let start = -1;
    let quoted = false;
    let escaped = false;
    for i in 0..s.len {
        let c = s[i];
        if start < 0 && c != ' ' { start = i; }
        if quoted {
            if escaped { escaped = false; } else if c == '\\' { escaped = true; } else if c == '"' { quoted = false; }
        } else if c == '"' {
            quoted = true;
        } else if c == ' ' {
            if start >= 0 { out.push(s[start..i]); start = -1; }
        }
    }
    if start >= 0 { out.push(s[start..s.len]); }
    return out;
}

/// Rust `unquote`: a `"..."` token's text with `\` escapes undone; any other token as it is.
pub fn unquote(t: string, arena: &Arena): string {
    if t.len == 0 || t[0] != '"' { return t; }
    let inner = t[1..t.len];
    if inner.len > 0 && inner[inner.len - 1] == '"' { inner = inner[0..inner.len - 1]; }
    let out = Text.new(arena);
    let i = 0;
    while i < inner.len {
        if inner[i] == '\\' {
            if i + 1 < inner.len { out.push(inner[i + 1]); }
            i += 2;
            continue;
        }
        out.push(inner[i]);
        i += 1;
    }
    return out.str();
}

/// Rust `is_data_line`: `key=value` or `key f=value` (a data section line, not an object).
fn isDataLine(line: string): bool {
    let n = 0;
    while n < line.len && line[n] != ' ' && line[n] != '=' && line[n] != '"' { n += 1; }
    let rest = line[n..line.len];
    if n == 0 { return false; }
    if rest.len > 0 && rest[0] == '=' { return true; }
    return rest.len > 2 && rest[0] == ' ' && (rest[1] == 'f' || rest[1] == 's' || rest[1] == 'r') && rest[2] == '=';
}

/// Rust `short_of`: `value` as `<folder><name><ext>`'s short name (no `/` or `.` in it), or None.
fn shortOf(value: string, folder: string, ext: string): Option<string> {
    if value.len < folder.len + ext.len || value[0..folder.len] != folder || value[value.len - ext.len..value.len] != ext { return Option.None; }
    let mid = value[folder.len..value.len - ext.len];
    if mid.len == 0 { return Option.None; }
    for i in 0..mid.len { if mid[i] == '/' || mid[i] == '.' { return Option.None; } }
    return Option.Some(mid);
}

fn shortOr(value: string, folder: string, ext: string): string {
    match shortOf(value, folder, ext) { Option.Some(s) { return s; } Option.None { return value; } }
}

fn isShort(old: string, folder: string, ext: string, v: string): bool {
    match shortOf(old, folder, ext) { Option.Some(s) { return s == v; } Option.None { return false; } }
}

/// Rust `quoted`: `v`, quoted and escaped when it has a space, `"` or tab.
fn quoted(v: string, t: &Text) {
    let q = false;
    for i in 0..v.len { if v[i] == ' ' || v[i] == '"' || v[i] == '\t' { q = true; } }
    if !q { t.add(v); return; }
    t.push('"');
    for i in 0..v.len {
        if v[i] == '\\' || v[i] == '"' { t.push('\\'); }
        t.push(v[i]);
    }
    t.push('"');
}

/// Rust `rename_v2`: the v2 file `text` with every value `old` (a project path) changed to `new`: a mesh or
/// scene path, a `key=value` path, or the short form of a material or effect. None when nothing matched.
pub fn renameV2(text: string, old: string, new: string, arena: &Arena): Option<string> {
    let hit = false;
    let out = Text.new(arena);
    let a = 0;
    let first = true;
    for li in 0..text.len + 1 {
        if li < text.len && text[li] != '\n' { continue; }
        let line = text[a..li];
        if line.len > 0 && line[line.len - 1] == '\r' { line = line[0..line.len - 1]; }
        a = li + 1;
        if li == text.len && line.len == 0 && li > 0 && text[li - 1] == '\n' { break; }
        if li == text.len && text.len == 0 { break; }
        if !first { out.push('\n'); }
        first = false;
        let ind = 0;
        while ind < line.len && line[ind] == ' ' { ind += 1; }
        let body = line[ind..line.len];
        if body.len == 0 || (body.len >= 2 && body[0..2] == "//") || (ind == 0 && isDataLine(body)) {
            out.add(line);
            continue;
        }
        let toks = tokens(body, arena);
        let row = Text.new(arena);
        let changed = false;
        for i in 0..toks.len {
            let t = toks.items[i];
            if i > 0 { row.push(' '); }
            if i < 2 { row.add(t); continue; }
            let eq = -1;
            if t[0] != '"' {
                let k = 0;
                while k < t.len && t[k] != '=' { k += 1; }
                if k < t.len { eq = k; }
            }
            let key = if eq >= 0 { t[0..eq] } else { "" };
            let value = if eq >= 0 { unquote(t[eq + 1..t.len], arena) } else { unquote(t, arena) };
            let replaced = "";
            let did = true;
            if value == old {
                replaced = new;
            } else if key == "material" && isShort(old, "assets/materials/", ".j3mat", value) {
                replaced = shortOr(new, "assets/materials/", ".j3mat");
            } else if key == "fx" && fxHas(value, old) {
                let f = Text.new(arena);
                let s = 0;
                for j in 0..value.len + 1 {
                    if j < value.len && value[j] != '|' { continue; }
                    let p = value[s..j];
                    if s > 0 { f.push('|'); }
                    if p == old { f.add(new); }
                    else if isShort(old, "assets/fx/", ".j3fx", p) { f.add(shortOr(new, "assets/fx/", ".j3fx")); }
                    else { f.add(p); }
                    s = j + 1;
                }
                replaced = f.str();
            } else {
                did = false;
            }
            if !did { row.add(t); continue; }
            changed = true;
            if key.len > 0 { row.add(key).push('='); }
            quoted(replaced, &row);
        }
        if changed {
            hit = true;
            out.add(line[0..ind]).add(row.str());
        } else {
            out.add(line);
        }
    }
    if !hit { return Option.None; }
    out.push('\n');
    return Option.Some(out.str());
}

/// A `|`-separated effect list holding `old` or its short name.
fn fxHas(value: string, old: string): bool {
    let s = 0;
    for j in 0..value.len + 1 {
        if j < value.len && value[j] != '|' { continue; }
        let p = value[s..j];
        if p == old || isShort(old, "assets/fx/", ".j3fx", p) { return true; }
        s = j + 1;
    }
    return false;
}
