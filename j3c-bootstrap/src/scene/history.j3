// Undo backups under `target/j3-editor/history/` (20 kept, named by epoch ms).
//
// Port of: j3c/src/scene/history.rs
// J3: The clock is a raw `clock_gettime(CLOCK_REALTIME)` (Linux x86-64, as `project/config` does).
module j3c.scene.history;

use j3.cmp.sortBy;
use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.text.{ Text, parseInt };
use j3c.base.fsx;

/// Backups kept per scene (Rust `KEEP`).
pub const KEEP: int = 20;

/// One backup: its stamp (epoch ms) and path.
pub struct Backup {
    stamp: int;
    path: string;
}

/// Backups of `rel`, oldest first: `target/j3-editor/history/<rel, / as __>.<unix millis>` (Rust `history`).
/// `base` gets the path every backup name starts with.
pub fn history(root: string, rel: string, base: &string, arena: &Arena): List<string> {
    let dir = path.join(root, "target/j3-editor/history", arena);
    let r = rel;
    while r.len >= 2 && r[0..2] == "./" { r = r[2..r.len]; }
    let p = Text.new(arena);
    for i in 0..r.len { if r[i] == '/' { p.add("__"); } else { p.push(r[i]); } }
    p.push('.');
    let prefix = p.str();
    *base = path.join(dir, prefix, arena);
    let found = List<Backup>.new(arena);
    match io.listDir(dir, arena) {
        Result.Ok(ents) {
            for i in 0..ents.len {
                let name = ents[i].name;
                if name.len <= prefix.len || name[0..prefix.len] != prefix { continue; }
                let digits = name[prefix.len..name.len];
                let ok = true;
                for k in 0..digits.len { if digits[k] < '0' || digits[k] > '9' { ok = false; } }
                if !ok { continue; }
                match parseInt(digits, 10) {
                    Option.Some(v) { found.push(Backup { stamp: v, path: path.join(dir, name, arena) }); }
                    Option.None {}
                }
            }
        }
        Result.Err(_) {}
    }
    sortBy(found.items[0..found.len], fn(a: Backup, b: Backup): bool { return a.stamp < b.stamp || (a.stamp == b.stamp && a.path < b.path); });
    let out = List<string>.new(arena);
    for i in 0..found.len { out.push(found.items[i].path); }
    return out;
}

fn nowMs(): int {
    let ts: [2]int = [0, 0];
    // CLOCK_REALTIME = 0, Linux amd64 `clock_gettime` = 228
    if @syscall(228, 0, &ts[0] as ptr) < 0 { return 0; }
    return ts[0] * 1000 + ts[1] / 1000000;
}

/// Copy the scene aside before a change; keeps the newest `KEEP` (Rust `backup`). None when it could not.
pub fn backup(root: string, rel: string, arena: &Arena): Option<string> {
    let base = "";
    let old = history(root, rel, &base, arena);
    match io.makeDirs(path.dirname(base)) { Result.Ok(_) {} Result.Err(_) { return Option.None; } }
    let millis = nowMs();
    if old.len > 0 {
        let last = old.items[old.len - 1];
        match parseInt(last[base.len..last.len], 10) {
            Option.Some(prev) { if prev + 1 > millis { millis = prev + 1; } }
            Option.None { return Option.None; }
        }
    }
    let t = Text.new(arena);
    t.add(base);
    t.pushInt(millis);
    let p = t.str();
    match io.copyFile(path.join(root, rel, arena), p) { Result.Ok(_) {} Result.Err(_) { return Option.None; } }
    let drop = old.len + 1 - KEEP;
    for i in 0..drop { io.remove(old.items[i]); }
    return Option.Some(p);
}

/// Rust `scene::undo`: put `rel` back as it was before the last change; Ok = the reply text. → MCP (`undo`)
pub fn undo(root: string, rel: string, arena: &Arena): Result<string, string> {
    let base = "";
    let old = history(root, rel, &base, arena);
    if old.len == 0 { return Result.Err(Text.new(arena).add("no earlier version of ").add(rel).add(" to go back to").str()); }
    let last = old.items[old.len - 1];
    match io.copyFile(last, path.join(root, rel, arena)) { Result.Ok(_) {} Result.Err(_) { return Result.Err(fsx.osError(sys.errno(), arena)); } }
    match io.remove(last) { Result.Ok(_) {} Result.Err(_) { return Result.Err(fsx.osError(sys.errno(), arena)); } }
    let t = Text.new(arena);
    t.add(rel).add(" is back to how it was before the last change (");
    t.pushInt(old.len - 1);
    t.add(" earlier versions left)");
    return Result.Ok(t.str());
}
