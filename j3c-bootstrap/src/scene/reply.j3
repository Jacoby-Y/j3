// The scene tools' reply: tab-separated lines from `j3_editor.tool`, as text (`-e scene`) or JSON (MCP).
//
// Port of: j3c/src/scene/reply.rs, (scene/mod.rs `Reply`)
module j3c.scene.reply;

use j3.data.json;
use j3.data.json.Json;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.text.Text;

/// What a scene op answered (Rust `scene::Reply`): its lines split on tabs; `ok` false when it failed or any
/// line is `err`.
pub struct Reply {
    lines: List<List<string>>;
    ok: bool;
}

/// Rust `Reply::parse`. → MCP (live editor replies)
pub fn parse(text: string, ok: bool, arena: &Arena): Reply { return Reply { lines: List<List<string>>.new(arena), ok: ok }; } // STUB SCENE

/// Rust `Reply::error`: the first `err` line's message.
pub fn error(r: &Reply, arena: &Arena): Option<string> { return Option.None; } // STUB SCENE

/// Rust `reply::to_json` (MCP `structuredContent`). → MCP
pub fn toJson(op: string, scene: string, r: &Reply, arena: &Arena): &Json { return json.obj(arena); } // STUB SCENE

/// Rust `reply::to_text` (what `-e scene` prints, the MCP text block). → MCP
pub fn toText(r: &Reply, out: &Text) {} // STUB SCENE
