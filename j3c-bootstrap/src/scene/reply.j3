// The scene tools' reply: tab-separated lines from `j3_editor.tool` (the editor's `cli` subprocess), as text (`-e scene`) or JSON (MCP).
//
// Port of: j3c/src/scene/reply.rs, (scene/mod.rs `Reply`)
// J3: Rust `Json::Obj` keeps duplicate keys, so objects here are filled with `keys.push`/`items.push`, not
// `Json.set` (which replaces). `{:<N}`/`{:>N}` pad by chars (`pad`).
module j3c.scene.reply;

use j3.data.json;
use j3.data.json.Json;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.text.{ Text, parseF64 };
use j3c.base.intern.own;

/// What a scene op answered (Rust `scene::Reply`): its lines split on tabs; `ok` false when it failed or any
/// line is `err`.
pub struct Reply {
    lines: List<List<string>>;
    ok: bool;
}

/// Rust `Reply::parse`: non-empty lines (Rust `str::lines`: a trailing `\r` dropped), split on tabs. → MCP
pub fn parse(text: string, ok: bool, arena: &Arena): Reply {
    let s = own(arena, text);
    let lines = List<List<string>>.new(arena);
    let a = 0;
    while a < s.len {
        let b = a;
        while b < s.len && s[b] != '\n' { b += 1; }
        let e = b;
        if e > a && s[e - 1] == '\r' { e -= 1; }
        if e > a {
            let l = List<string>.new(arena);
            let k = a;
            for i in a..e + 1 {
                if i == e || s[i] == '\t' {
                    l.push(s[k..i]);
                    k = i + 1;
                }
            }
            lines.push(l);
        }
        a = b + 1;
    }
    let bad = false;
    for i in 0..lines.len { if lines.items[i].items[0] == "err" { bad = true; } }
    return Reply { lines: lines, ok: ok && !bad };
}

/// A new reply with no lines.
pub fn empty(ok: bool, arena: &Arena): Reply { return Reply { lines: List<List<string>>.new(arena), ok: ok }; }

/// `l[i]`, or "" past its end (Rust `at`).
pub fn at(l: &List<string>, i: int): string {
    if i < l.len { return l.items[i]; }
    return "";
}

/// `l[from..]` joined with `sep`.
fn joinFrom(l: &List<string>, from: int, sep: string, t: &Text) {
    for i in from..l.len {
        if i > from { t.add(sep); }
        t.add(l.items[i]);
    }
}

fn joined(l: &List<string>, from: int, sep: string, arena: &Arena): string {
    let t = Text.new(arena);
    joinFrom(l, from, sep, &t);
    return t.str();
}

/// Rust `Reply::error`: the first `err` line's message.
pub fn error(r: &Reply, arena: &Arena): Option<string> {
    for i in 0..r.lines.len {
        let l = &r.lines.items[i];
        if l.items[0] == "err" { return Option.Some(joined(l, 1, " ", arena)); }
    }
    return Option.None;
}

/// The first line whose head is `head`, or -1.
fn find(r: &Reply, head: string): int {
    for i in 0..r.lines.len { if r.lines.items[i].items[0] == head { return i; } }
    return -1;
}

/// Rust `s.parse::<f64>().unwrap_or(0.0)`.
fn number(s: string): f64 {
    match parseF64(s) { Option.Some(v) { return v; } Option.None { return 0.0; } }
}

fn num(s: string, arena: &Arena): &Json { return json.num(number(s), arena); }

/// Rust `vec3`: comma-separated numbers (0 where one does not parse).
fn vec3(s: string, arena: &Arena): &Json {
    let a = json.arr(arena);
    let k = 0;
    for i in 0..s.len + 1 {
        if i == s.len || s[i] == ',' {
            a.push(num(s[k..i], arena));
            k = i + 1;
        }
    }
    return a;
}

/// Append `key: v` (duplicates kept, as Rust's `Json::Obj`).
fn put(o: &Json, key: string, v: &Json) {
    o.keys.push(key);
    o.items.push(v);
}

fn nodeJson(l: &List<string>, arena: &Arena): &Json {
    let o = json.obj(arena);
    put(o, "id", num(at(l, 1), arena));
    put(o, "path", json.str(at(l, 2), arena));
    put(o, "kind", json.str(at(l, 3), arena));
    put(o, "parent", num(at(l, 4), arena));
    put(o, "asset", json.str(at(l, 5), arena));
    put(o, "worldPosition", vec3(at(l, 6), arena));
    put(o, "rotation", vec3(at(l, 7), arena));
    put(o, "scale", vec3(at(l, 8), arena));
    put(o, "script", json.str(at(l, 9), arena));
    put(o, "material", json.str(at(l, 10), arena));
    put(o, "scene", json.str(at(l, 11), arena));
    return o;
}

/// Rust `reply::to_json` (MCP `structuredContent`): `{ok, scene, nodes|fields|issues|looks, lines, id, path,
/// message}` or `{ok, scene, error}`. → MCP
pub fn toJson(op: string, scene: string, r: &Reply, arena: &Arena): &Json {
    let o = json.obj(arena);
    put(o, "ok", json.boolean(r.ok, arena));
    put(o, "scene", json.str(own(arena, scene), arena));
    match error(r, arena) {
        Option.Some(e) {
            put(o, "error", json.str(e, arena));
            return o;
        }
        Option.None {}
    }
    if op == "list" {
        let nodes = json.arr(arena);
        let groups = json.obj(arena);
        for i in 0..r.lines.len {
            let l = &r.lines.items[i];
            if l.items[0] == "node" { nodes.push(nodeJson(l, arena)); }
            if l.items[0] == "group" { put(groups, at(l, 1), num(at(l, 2), arena)); }
        }
        put(o, "nodes", nodes);
        if groups.keys.len > 0 { put(o, "groups", groups); }
    } else if op == "get" {
        let fields = json.obj(arena);
        for i in 0..r.lines.len {
            let l = &r.lines.items[i];
            if l.items[0] == "field" { put(fields, at(l, 1), json.str(at(l, 2), arena)); }
        }
        put(o, "fields", fields);
    } else if op == "check" {
        let issues = json.arr(arena);
        for i in 0..r.lines.len {
            let l = &r.lines.items[i];
            if l.items[0] != "issue" { continue; }
            let x = json.obj(arena);
            put(x, "severity", json.str(at(l, 1), arena));
            put(x, "node", num(at(l, 2), arena));
            put(x, "message", json.str(joined(l, 3, " ", arena), arena));
            issues.push(x);
        }
        put(o, "issues", issues);
    } else if op == "stats" {
        let looks = json.arr(arena);
        for i in 0..r.lines.len {
            let l = &r.lines.items[i];
            if l.items[0] != "look" { continue; }
            let x = json.obj(arena);
            put(x, "count", num(at(l, 1), arena));
            put(x, "asset", json.str(at(l, 2), arena));
            put(x, "material", json.str(at(l, 3), arena));
            put(x, "texture", json.str(at(l, 4), arena));
            put(x, "tint", vec3(at(l, 5), arena));
            put(x, "example", json.str(at(l, 6), arena));
            looks.push(x);
        }
        put(o, "looks", looks);
    }
    let lines = json.arr(arena);
    for i in 0..r.lines.len {
        let l = &r.lines.items[i];
        if l.items[0] == "text" { lines.push(json.str(joined(l, 1, "\t", arena), arena)); }
    }
    if lines.items.len > 0 { put(o, "lines", lines); }
    let k = find(r, "added");
    if k >= 0 {
        let l = &r.lines.items[k];
        put(o, "id", num(at(l, 1), arena));
        put(o, "path", json.str(at(l, 2), arena));
    }
    k = find(r, "ok");
    if k >= 0 { put(o, "message", json.str(joined(&r.lines.items[k], 1, " ", arena), arena)); }
    return o;
}

/// Chars in `s` (UTF-8 lead bytes), what Rust's `{:<N}` pads by.
fn chars(s: string): int {
    let n = 0;
    for i in 0..s.len { if (s[i] & 0xC0) != 0x80 { n += 1; } }
    return n;
}

/// `s` padded with spaces to `w` chars, on the right (`left`, Rust `{:<w}`) or the left (`{:>w}`).
fn pad(t: &Text, s: string, w: int, left: bool) {
    if !left { for i in chars(s)..w { t.push(' '); } }
    t.add(s);
    if left { for i in chars(s)..w { t.push(' '); } }
}

/// Rust `reply::to_text` (what `-e scene` prints, the MCP text block). → MCP
pub fn toText(r: &Reply, out: &Text) {
    for i in 0..r.lines.len {
        let l = &r.lines.items[i];
        let h = l.items[0];
        if h == "node" {
            let start = out.len();
            out.push('#');
            pad(out, at(l, 1), 5, true);
            out.push(' ');
            pad(out, at(l, 2), 32, true);
            out.push(' ');
            pad(out, at(l, 3), 8, true);
            if at(l, 5).len > 0 { out.push(' '); out.add(at(l, 5)); }
            if at(l, 11).len > 0 { out.push(' '); out.add(at(l, 11)); }
            out.add("  at ").add(at(l, 6));
            if at(l, 9).len > 0 { out.add("  [").add(at(l, 9)).add("]"); }
            // Rust `trim_end`
            while out.len() > start && isWs(out.str()[out.len() - 1]) { out.pop(); }
            out.push('\n');
        } else if h == "field" {
            out.add(at(l, 1)).add(": ").add(at(l, 2)).add("\n");
        } else if h == "group" {
            pad(out, at(l, 2), 6, false);
            out.add("  ").add(at(l, 1)).add("*\n");
        } else if h == "added" {
            out.add("added #").add(at(l, 1)).add(" ").add(at(l, 2)).add("\n");
        } else if h == "issue" {
            out.add(at(l, 1)).add(": ");
            joinFrom(l, 3, " ", out);
            out.add("\n");
        } else if h == "look" {
            out.add("  ");
            pad(out, at(l, 1), 5, false);
            out.add("x ").add(at(l, 2)).add(" ").add(at(l, 3)).add(" ").add(at(l, 4)).add(" tint ").add(at(l, 5)).add("  (e.g. ").add(at(l, 6)).add(")\n");
        } else if h == "text" {
            joinFrom(l, 1, "\t", out);
            out.add("\n");
        } else if h == "ok" {
            joinFrom(l, 1, " ", out);
            out.add("\n");
        } else if h == "err" {
            out.add("error: ");
            joinFrom(l, 1, " ", out);
            out.add("\n");
        } else {
            joinFrom(l, 0, " ", out);
            out.add("\n");
        }
    }
}

fn isWs(c: u8): bool { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 11 || c == 12; }
