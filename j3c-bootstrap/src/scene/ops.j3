// The scene ops in-process: find the project and scene, run one `j3_editor.tool` request on the file, render
// through the editor subprocess.
//
// Port of: j3c/src/scene/mod.rs (`execute`, `run_tool`, `render`, `find_root`, `scene_rel`, `all_scenes`,
// `placed_scenes`, `check_scene`, `request_text`, `apply_args`), editor/mod.rs (`config_value`, `scene_path`)
// J3: `runTool` loads `scene3d.read` + the catalog and calls `j3_editor.tool.apply` (`j3c/editor/src/tool.j3`), the
// same code the editor runs, and stores the scene when the reply is ok and it changed (B12.1). `render` stays an
// offscreen subprocess of the editor program built by `editor/frontend` (a GL crash must not kill a server).
module j3c.scene.ops;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3_editor.tool; // unused until SCENE: proves the `j3_editor` dependency builds into j3c-boot
use j3c.scene.reply.Reply;

/// Rust `scene::BATCH` (`\x1e`): the byte joining the requests of one batch (one file write, one editor undo step).
pub const BATCH: u8 = 0x1e;

/// What `render` wrote: the PNG (project-relative) and the editor's text reply.
pub struct Rendered {
    png: string;
    text: string;
}

/// Rust `scene::find_root`: the project folder at or above `start` (`j3.editor.toml` or `j3.toml`). → MCP, IMG (gen)
pub fn findRoot(start: string, arena: &Arena): Result<string, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::scene_rel`: `scene` checked, or the project's scene (`j3.editor.toml`). → MCP
pub fn sceneRel(root: string, scene: Option<string>, arena: &Arena): Result<string, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::all_scenes`: every `scenes/**/*.j3scene`, sorted. → MCP (`check`)
pub fn allScenes(root: string, arena: &Arena): Result<List<string>, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::placed_scenes`: every scene another scene places, sorted (Rust: a HashSet). → MCP
pub fn placedScenes(root: string, arena: &Arena): List<string> { return List<string>.new(arena); } // STUB SCENE

/// Rust `scene::check_scene`: the `check` op on one scene plus the project's check script. → MCP
pub fn checkScene(root: string, rel: string, placed: []string, arena: &Arena): Result<Reply, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::run_tool`: one request (`args[0]` is the op; a `BATCH`-joined list for batches) on the file at
/// `rel`, with an undo backup first for a changing op. → MCP
pub fn runTool(root: string, rel: string, args: []string, arena: &Arena): Result<Reply, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::request_text`: `args` as the tool's request line (tabs refused). → MCP (live editor)
pub fn requestText(args: []string, arena: &Arena): Result<string, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::apply_args`: `scene_apply` lines (+ parent) as request args. → MCP
pub fn applyArgs(text: string, parent: Option<string>, arena: &Arena): Result<List<string>, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `scene::render`: render `rel` with `opts` (`out=`, `at=`, ...) through the editor program. → MCP
pub fn render(root: string, rel: string, opts: []string, arena: &Arena): Result<Rendered, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE

/// Rust `editor::config_value`: `key = "value"` from the project's `j3.editor.toml`. → MCP (project notes), EDDEV
pub fn configValue(root: string, key: string, arena: &Arena): Option<string> { return Option.None; } // STUB SCENE

/// Rust `editor::scene_path`: the project's main scene file. → EDDEV
pub fn scenePath(root: string, arena: &Arena): Result<string, string> { return Result.Err("scene: not ported yet"); } // STUB SCENE
