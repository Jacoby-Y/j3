// `j3c -e mcp`: Model Context Protocol server over stdio (newline JSON-RPC).
//
// Port of: j3c/src/mcp/mod.rs
// J3: Lives for hours: each `check`/`play` build is a fresh `driver.Session`, freed when the call returns (the
// wave-25 probe ran 1000 Session create/check/free cycles in j3c-boot with flat RSS; contracts-c5.md).
// J3: Deferred (user, 2026-11-18): the server is not ported yet (stubs keep their signatures; plans/12-deferred-tools.md).
// `--help`, `--tools` (the ported tool table) and the argument errors work.
module j3c.mcp;

use j3.memory.Arena;
use j3.sys;
use j3.text.Text;
use j3c.base.diag;
use j3c.mcp.schema.cliHelp;
use j3c.scene;

const USAGE: string = "usage: j3c -e mcp [--project DIR]\n\nServes the Model Context Protocol on stdin/stdout for an agent working on a j3 project.\nWithout --project it follows the editor: the project `j3c editor` has open, else the\nnearest j3.toml at or above the current directory. With --project DIR it stays on the\nnearest j3.toml at or above DIR. Tools: scene_list,\nscene_get, scene_add, scene_add_many, scene_set, scene_delete, place, undo, render, check, play, console, import,\nasset_search, asset_online_search, asset_fetch, gen, scene_stats, scene_diff. `j3c -e mcp --tools` prints each tool's\narguments and the CLI command that does the same work.\n\nSaving and undo depend on the editor. With `j3c editor` open on the project, scene edits go\nto it live: each is one undo step there (Ctrl+Z), and nothing is saved until the person saves\nor scene_set passes save: true. With it closed, each edit writes the scene file at once and\nthe undo tool puts the file back (20 steps). Every edit reply says which one happened.\n\nClaude Code:  claude mcp add -s user j3 -- j3c -e mcp\n.mcp.json:    {\"mcpServers\": {\"j3\": {\"command\": \"j3c\", \"args\": [\"-e\", \"mcp\"]}}}\n";

fn put(fd: int, s: string) { sys.write(fd, s.ptr as ptr, s.len); }

/// `j3c -e mcp [--project DIR] [--tools]`: Rust `mcp::cmd`. `--help`, `--tools` and the argument errors are
/// real; the server loop is deferred.
pub fn mcpCmd(rest: []string): int {
    let i = 0;
    while i < rest.len {
        let a = rest[i];
        if a == "--help" || a == "-h" {
            put(1, USAGE);
            return 0;
        }
        if a == "--tools" {
            let arena = Arena.create(256 * 1024);
            let t = Text.new(&arena);
            cliHelp(scene.tools(&arena), &t);
            t.flushTo(1);
            arena.destroy();
            return 0;
        }
        if a == "--project" {
            if i + 1 >= rest.len {
                put(2, "j3c -e mcp: --project needs a directory\n");
                return 1;
            }
            i += 2;
            continue;
        }
        let arena = Arena.create(4096);
        put(2, Text.new(&arena).add("j3c -e mcp: unknown argument `").add(a).add("`\n").str());
        arena.destroy();
        return 1;
    }
    return diag.notPortedCmd("-e mcp"); // STUB MCP: the server loop (plans/12-deferred-tools.md)
}
