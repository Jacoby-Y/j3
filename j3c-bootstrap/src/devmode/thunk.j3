// One `j3s_dev` thunk per native fn a script may call, and `add_func`.
//
// Part of module j3c.devmode.
// Port of: j3c/src/compile/dev/thunk.rs
// J3: The thunk name `thunk_{:016x}` is 16 lower-case hex digits pushed one by one, never `{..}` on a u64.
module j3c.devmode;

/// `fn(args: ptr, ret: ptr)` that reads each argument from an 8-byte-aligned slot in `args`, calls `target`, and
/// writes the result to `ret`. Same slots `Vm.callNative` packs.
fn thunk(cx: &IrCx, target: Id<Func>): Result<Id<Func>, string> {
    let func = cx.func(target);
    let params = List<Id<TyKind>>.new(cx.arena);
    let ret = cx.common.void;
    match cx.fnSig(func.ty) {
        Option.Some(sig) { params = sig.params; ret = sig.ret; }
        Option.None { return Result.Err("thunk target without a signature"); }
    }
    let ptr = cx.common.ptr;
    let int = cx.common.int;
    let void = cx.common.void;
    let fb = Fb.new(cx);
    let argsName = cx.internName("args");
    let retName = cx.internName("ret");
    let args = fb.local(argsName, ptr, LocalKind.Param);
    let out = fb.local(retName, ptr, LocalKind.Param);
    let base = fb.value(cx, Rvalue.cast(devSpan(), int, Operand.Copy(args)));
    let callArgs = List<Operand>.new(cx.arena);
    let offset: u64 = 0;
    for i in 0..params.len {
        let ty = params.items[i];
        let at = fb.value(cx, Rvalue.binary(devSpan(), int, BinOp.Add, base, opInt(devSpan(), int, offset)));
        let raw = fb.value(cx, Rvalue.cast(devSpan(), ptr, at));
        let refTy = cx.tyRef(ty);
        let typed = placeOf(fb.value(cx, Rvalue.cast(devSpan(), refTy, raw)));
        callArgs.push(Operand.Copy(deref(cx, typed)));
        offset += (abiSize(cx, ty) + 7) / 8 * 8;
    }
    let call = Rvalue.call(devSpan(), ret, opFnAddr(devSpan(), func.ty, target), callArgs);
    if ret == void {
        fb.expr(call);
    } else {
        let refTy = cx.tyRef(ret);
        let typed = placeOf(fb.value(cx, Rvalue.cast(devSpan(), refTy, Operand.Copy(out))));
        fb.assign(deref(cx, typed), call);
    }
    let body = fb.finish();
    let ps = List<Id<TyKind>>.new(cx.arena);
    ps.push(ptr);
    ps.push(ptr);
    let ty = cx.tyFn(ps, void);
    let devName = List<Sym>.new(cx.arena);
    devName.push(cx.internName(DEV_MODULE));
    let t = Text.new(cx.arena);
    t.add("thunk_");
    let key = bc.fnKey(cx, target, cx.arena);
    let digits = "0123456789abcdef";
    for k in 0..16 { t.push(digits[int((key >> u64(60 - 4 * k)) & 15)]); }
    return Result.Ok(addFunc(cx, devName, t.str(), ty, body));
}

fn addFunc(cx: &IrCx, moduleName: List<Sym>, name: string, ty: Id<TyKind>, body: Body): Id<Func> {
    return cx.allocFunc(Func { id: Id<Func> { i: 0 }, doc: "", moduleName: moduleName, kind: FuncKind.J3(J3Fn { body: body }),
        name: cx.internName(name), ty: ty, vis: Vis.Private, methodOf: Option.None, span: devSpan() });
}
