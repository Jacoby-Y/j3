// Script props and assets the inspector shows; the catalog every scene op reads; imports and editor events.
//
// Port of: j3c/src/editor/assets.rs, (cli/mod.rs `script_props_cmd`)
// J3: The catalog bytes equal Rust's (`target/j3-editor/catalog`); script props come from the port's parser.
module j3c.editor.assets;

use j3.memory.{ Arena, List };
use j3.result.Result;
use j3c.base.diag;

/// One prop of a scene script the inspector edits (Rust `ScriptProp`).
pub struct ScriptProp {
    name: string;
    /// `f32`, `int`, `bool`, `string`, `vec3`, or `object`.
    kind: string;
    /// As written in the script, "" when required.
    default: string;
    required: bool;
}

/// `j3c -e script-props <path.j3s>`: the props as JSON (Rust `script_props_cmd`).
pub fn scriptPropsCmd(rest: []string): int { return diag.notPortedCmd("-e script-props"); } // STUB SCENE

/// Rust `script_props`. → MCP
pub fn scriptProps(root: string, rel: string, arena: &Arena): Result<List<ScriptProp>, string> { return Result.Err("script props: not ported yet"); } // STUB SCENE

/// Rust `generate_catalog`: `target/j3-editor/catalog` (assets + script props). → EDDEV, MCP
pub fn generateCatalog(root: string, arena: &Arena): Result<bool, string> { return Result.Err("catalog: not ported yet"); } // STUB SCENE

/// Rust `generate_assets_catalog`: the asset list part only. → EDDEV, MCP (`import`, `asset_fetch`)
pub fn generateAssetsCatalog(root: string, arena: &Arena): Result<bool, string> { return Result.Err("catalog: not ported yet"); } // STUB SCENE

/// Rust `append_event`: one line onto `target/j3-editor/events` (the open editor reads it). → EDDEV, MCP
pub fn appendEvent(root: string, line: string, arena: &Arena) {} // STUB SCENE

/// Rust `event`: a `KIND\tSCENE\tMESSAGE` event. → EDDEV, MCP
pub fn event(root: string, kind: string, scene: string, message: string, arena: &Arena) {} // STUB SCENE

/// Rust `import_asset`: a model (`gltf.import`), image or scene file into the project; Ok = files written. → MCP, EDDEV
pub fn importAsset(root: string, scene: string, raw: string, bake: bool, arena: &Arena): Result<List<string>, string> { return Result.Err("import: not ported yet"); } // STUB SCENE

/// Rust `keep_import`: move an imported fragment into the project's scene folder. → MCP, EDDEV
pub fn keepImport(root: string, fragment: string, source: string, arena: &Arena): Result<string, string> { return Result.Err("import: not ported yet"); } // STUB SCENE

/// Rust `import_name`: the object name an import of `source` gets. → MCP, EDDEV
pub fn importName(source: string, arena: &Arena): string { return ""; } // STUB SCENE

/// Rust `is_main_scene`. → EDDEV
pub fn isMainScene(root: string, rel: string, arena: &Arena): bool { return false; } // STUB SCENE

/// Rust `rename_asset`: rename and fix references; Ok = files changed. → EDDEV
pub fn renameAsset(root: string, old: string, newName: string, arena: &Arena): Result<int, string> { return Result.Err("assets: not ported yet"); } // STUB SCENE

/// Rust `delete_asset`. → EDDEV
pub fn deleteAsset(root: string, rel: string, arena: &Arena): Result<string, string> { return Result.Err("assets: not ported yet"); } // STUB SCENE

/// Rust `create_script`: a new `scripts/NAME.j3s`; Ok = its path. → EDDEV
pub fn createScript(root: string, name: string, arena: &Arena): Result<string, string> { return Result.Err("assets: not ported yet"); } // STUB SCENE
