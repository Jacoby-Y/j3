// Locate this binary and the editor sources (`J3_EDITOR_SRC`), build the editor program per version.
//
// Port of: j3c/src/editor/frontend.rs
// J3: Builds through `driver.run()` in-process (plan 11 B12.6) into `~/.cache/j3/editor-boot/<xxh3>`, never
// Rust's `~/.cache/j3/editor` (its `cleanup_frontends` deletes hash folders it does not know). Only the
// windowed editor and `render` use it; headless scene ops run in-process (B12.1).
// J3: `note_open` and `project_lock` (only `j3c editor` takes them) are in `editor.j3`.
module j3c.editor.frontend;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;

/// The editor UI font (Rust `editor::FONT`): written beside the built editor and into `new --template ui`.
pub const FONT = @embedBytes("../../../j3c/editor/font.ttf");

/// Rust `editor::host_exe`: this binary's path. → IMG (gen runs `run --file` with it), EDDEV
pub fn hostExe(arena: &Arena): Result<string, string> { return Result.Err("editor: not ported yet"); } // STUB SCENE

/// The cache root `~/.cache/j3` (Rust `editor::cache_root`), None without a home. → IMG (doctor), ASSETS, MCP
pub fn cacheRoot(arena: &Arena): Option<string> { return Option.None; } // STUB SCENE

/// This compiler's editor cache, `<cacheRoot>/editor-boot` (Rust `cache_dir`: `editor`). → MCP (`open-project`), EDDEV
pub fn cacheDir(arena: &Arena): Option<string> { return Option.None; } // STUB SCENE

/// Rust `editor::frontend`: build (or reuse) the editor program for this version under a lock; Ok = its path. → EDDEV
pub fn build(arena: &Arena): Result<string, string> { return Result.Err("editor frontend: not ported yet"); } // STUB SCENE
