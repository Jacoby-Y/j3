// The markup tree: ranges, errors, nodes, and the `<script>` item list.
//
// Part of module j3c.ui.markup.
// Port of: j3c/src/ui/markup/types.rs
// J3: Frozen by the C2e contract (`.swarm-opus/11-port/contracts-c2e.md`); also holds the `Script` types of
// Rust `markup/script.rs`, so the parser and the generator share one file nobody edits.
// J3: Every J3 fragment is a `Range` of bytes into the `.j3ui` text, never a copy. Names and literal text
// (`tag`, `Attr.name`, `Part.Lit`) are arena copies or slices of the source (which the Session keeps).
// J3: Identity. Rust keys side tables by the address of an `Elem` and numbers nodes through `Cell` ids. A
// `match` binding is a copy here, so every `Elem`, `IfNode` and `EachNode` carries a `uid` instead: unique
// in the whole project (the parser takes the counter), fresh for every clone `lowerChoices` makes. The
// numbers Rust keeps in `id` cells live in `gen.G.ids[uid]`. A tree is changed in place only by writing
// `list.items[i] = ..` (a `match` binding of a node is a copy; its `List` fields still share the buffer).
// J3: Errors are `Result<T, UiError>` with `?`; there is no generic `err<T>` (stage 0 does not infer a type
// parameter from the return type): write `return Result.Err(uiErr(lo, hi, msg));`. `()` is `bool` (`true`).
// `help` is "" for none.
module j3c.ui.markup;

/// Bytes `lo..hi` of the `.j3ui` text (Rust `(usize, usize)`).
pub struct Range {
    lo: int;
    hi: int;
}

pub struct UiError {
    lo: int;
    hi: int;
    msg: string;
    /// "" for none.
    help: string;

    /// This error with the help line `h` (Rust `UiError::help`).
    fn withHelp(this: UiError, h: string): UiError { return UiError { lo: this.lo, hi: this.hi, msg: this.msg, help: h }; }
}

/// An error at `lo..hi` without help (Rust `err`, minus the `Err(..)`). `msg` must outlive the frame: a
/// literal or an arena string (`Text.new(a)...str()`).
pub fn uiErr(lo: int, hi: int, msg: string): UiError { return UiError { lo: lo, hi: hi, msg: msg, help: "" }; }

/// A name with its place in the source (Rust's `(String, Range)` pairs).
pub struct Named {
    name: string;
    r: Range;
}

pub enum Part {
    Lit(string),
    Hole(Range),
}

/// The parts of a quoted attribute value (an enum payload cannot be a generic type in stage 0).
pub struct Parts {
    items: List<Part>;
}

pub enum Value {
    None,
    Expr(Range),
    Str(Parts),
}

pub struct Attr {
    name: string;
    range: Range;
    value: Value;
}

pub struct Elem {
    tag: string;
    /// A capitalised tag: the component `ui/<Tag>.j3ui`.
    comp: bool;
    attrs: List<Attr>;
    children: List<Node>;
    /// The opening tag, `<div ...>`.
    open: Range;
    /// Project-unique identity (Rust: the address). `G.ids[uid]` is the child-instance number (Rust `id`).
    uid: int;
}

pub struct Branch {
    cond: Option<Range>;
    /// `{:case a, b}` values of a `{#match}` (`cond` is `None` there; an `{:else}` has none).
    vals: List<Range>;
    nodes: List<Node>;
}

pub struct IfNode {
    branches: List<Branch>;
    /// `{#match X}`: the value the cases compare.
    scrut: Option<Range>;
    /// Dynamic component candidate-set enum; lowered before component scans.
    choice: Option<string>;
    range: Range;
    /// `G.ids[uid]` is the state number when a branch holds components, else 0 (Rust `id`).
    uid: int;
}

pub struct EachNode {
    head: Range;
    body: List<Node>;
    range: Range;
    /// `G.ids[uid]` is the list number (Rust `id`).
    uid: int;
}

/// `{#let name = expr}`: a local for the rest of the block.
pub struct LetNode {
    name: string;
    nameR: Range;
    expr: Range;
    range: Range;
}

/// Rust `Node::Text { parts, range }`.
pub struct TextNode {
    parts: List<Part>;
    range: Range;
}

pub enum Node {
    Let(LetNode),
    Text(TextNode),
    Elem(Elem),
    If(IfNode),
    Each(EachNode),
}

pub struct Markup {
    nodes: List<Node>;
    script: Option<Range>;
    style: Option<Range>;
}

// ---- `<script>` items (Rust markup/script.rs)

pub struct Prop {
    name: string;
    nameR: Range;
    ty: Range;
    /// Added by `provide`/`inject` resolution: the type as text, and the parent supplies it.
    hidden: Option<string>;
    /// `props { gap: int = 8; }`: the source range of the default, used when a use site omits the prop.
    default: Option<Range>;
}

/// One payload field of an event: `pick(slot: int)`.
pub struct EvParam {
    ev: string;
    name: string;
    nameR: Range;
    ty: Range;
}

pub struct LetDef {
    name: string;
    nameR: Range;
    ty: Option<Range>;
    init: Range;
    /// Type read off a literal initialiser, when there is no annotation ("" for none).
    guess: string;
}

pub struct FnDef {
    name: string;
    nameR: Range;
    params: Range;
    paramNames: List<Named>;
    ret: Option<Range>;
    body: Range;
}

/// `inject name: Type;`
pub struct Inject {
    name: string;
    nameR: Range;
    ty: Range;
}

pub struct Script {
    uses: List<Range>;
    props: List<Prop>;
    events: List<Named>;
    evParams: List<EvParam>;
    /// `provide a, b;`
    provides: List<Named>;
    injects: List<Inject>;
    lets: List<LetDef>;
    /// `const NAME: Type = value;`
    consts: List<LetDef>;
    fns: List<FnDef>;
}

/// A script with no items (Rust `Script::default()`).
pub fn emptyScript(a: &Arena): Script {
    return Script { uses: List<Range>.new(a), props: List<Prop>.new(a), events: List<Named>.new(a), evParams: List<EvParam>.new(a),
        provides: List<Named>.new(a), injects: List<Inject>.new(a), lets: List<LetDef>.new(a), consts: List<LetDef>.new(a), fns: List<FnDef>.new(a) };
}
