// One element and its attributes.
//
// Part of module j3c.ui.markup.
// Port of: j3c/src/ui/markup/element.rs
// J3: A quoted value's literal run is a slice of the source (Rust pushes its chars one by one); `decode`
// copies only when it holds an entity.
module j3c.ui.markup;

fn isVoid(tag: string): bool { return tag == "input" || tag == "img" || tag == "br"; }

extend P {
    /// The element at the cursor; None for `<script>` / `<style>` at the top level (their ranges go to `out`).
    fn element(this: &P, top: bool): Result<Option<Elem>, UiError> {
        let s = this.s;
        let a = this.a;
        let lo = this.i;
        let j = lo + 1;
        while j < s.len && isTagChar(s[j]) { j += 1; }
        let written = s[lo + 1..j];
        // `<textarea>` is an `<input type="textarea">` (void, like `<input>`)
        let tag = if written == "textarea" { "input" } else { written };
        this.i = j;
        if top && (tag == "script" || tag == "style") {
            this.ws();
            if !this.at(">") { return Result.Err(uiErr(lo, j, Text.new(a).add("`<").add(tag).add(">` takes no attributes").str())); }
            this.i += 1;
            let close = Text.new(a).add("</").add(tag).add(">").str();
            let k = text.find(s[this.i..s.len], close);
            if k < 0 { return Result.Err(uiErr(lo, j, Text.new(a).add("`<").add(tag).add(">` is never closed").str())); }
            let r = Range { lo: this.i, hi: this.i + k };
            let had = match (if tag == "script" { this.out.script } else { this.out.style }) {
                Option.Some(_) { true }
                Option.None { false }
            };
            if had { return Result.Err(uiErr(lo, j, Text.new(a).add("a component has one `<").add(tag).add(">`").str())); }
            if tag == "script" { this.out.script = Option.Some(r); } else { this.out.style = Option.Some(r); }
            this.i += k + close.len;
            return Result.Ok(Option.None);
        }
        let attrs = List<Attr>.new(a);
        let selfClose = false;
        while true {
            this.ws();
            if this.i >= s.len {
                return Result.Err(uiErr(lo, j, Text.new(a).add("`<").add(tag).add(">` is never closed (the tag ends the file)").str()));
            }
            if this.at("/>") {
                this.i += 2;
                selfClose = true;
                break;
            }
            if this.at(">") {
                this.i += 1;
                break;
            }
            attrs.push(this.attr()?);
        }
        if written == "textarea" {
            let kept = List<Attr>.new(a);
            let lit = List<Part>.new(a);
            lit.push(Part.Lit("textarea"));
            kept.push(Attr { name: "type", range: Range { lo: lo, hi: j }, value: Value.Str(Parts { items: lit }) });
            for q in 0..attrs.len { if attrs.items[q].name != "type" { kept.push(attrs.items[q]); } }
            attrs = kept;
        }
        let open = Range { lo: lo, hi: this.i };
        let dot = tag.len;
        while dot > 0 && tag[dot - 1] != '.' { dot -= 1; }
        let comp = dot < tag.len && tag[dot] >= 'A' && tag[dot] <= 'Z';
        let children = List<Node>.new(a);
        if !selfClose && !isVoid(tag) {
            let ne = this.nodes(false)?;
            match ne.end {
                End.Close(c) {
                    if c.name != tag {
                        if c.name == "input" || c.name == "textarea" { return Result.Err(uiErr(c.r.lo, c.r.hi, closeMsg(c.name, a))); }
                        return Result.Err(uiErr(c.r.lo, c.r.hi, Text.new(a).add("expected `</").add(tag).add(">`, found `</").add(c.name).add(">`").str()));
                    }
                }
                End.Eof { return Result.Err(uiErr(lo, open.hi, Text.new(a).add("`<").add(tag).add(">` is never closed").str())); }
                End.Else(e) { return Result.Err(this.openBlock(tag, open, e.r)); }
                End.EndIf(r) { return Result.Err(this.openBlock(tag, open, r)); }
                End.EndEach(r) { return Result.Err(this.openBlock(tag, open, r)); }
                End.Case(c) { return Result.Err(this.openBlock(tag, open, c.r)); }
                End.EndMatch(r) { return Result.Err(this.openBlock(tag, open, r)); }
            }
            children = ne.nodes;
        } else if isVoid(tag) && !selfClose && this.at(Text.new(a).add("</").add(written).add(">").str()) {
            this.i += written.len + 3;
        } else if tag == "input" && !selfClose {
            // `<textarea><br /></textarea>`: a text box takes no content, say so at the `<br>`
            let rest = s[this.i..s.len];
            let t = trimStart(rest);
            let at = this.i + (rest.len - t.len);
            if startsWith(t, "<br") && !(t.len > 3 && isTagChar(t[3])) {
                let e = text.find(t, ">");
                if e >= 0 && startsWith(trimStart(t[e + 1..t.len]), Text.new(a).add("</").add(written).add(">").str()) {
                    return Result.Err(uiErr(at, at + e + 1, Text.new(a).add("`<br>` is not allowed inside `<").add(written).add(">`: a text box takes no content").str()));
                }
            }
        }
        return Result.Ok(Option.Some(Elem { tag: tag, comp: comp, attrs: attrs, children: children, open: open, uid: this.nextUid() }));
    }

    /// `<tag>` still open when the block tag at `r` ends its block.
    fn openBlock(this: &P, tag: string, open: Range, r: Range): UiError {
        let t = Text.new(this.a).add("`<").add(tag).add(">` is never closed before the block ends at ");
        t.pushInt(r.lo);
        return uiErr(open.lo, open.hi, t.str());
    }

    /// `name`, `name={expr}` or `name="text {hole}"` at the cursor.
    fn attr(this: &P): Result<Attr, UiError> {
        let s = this.s;
        let a = this.a;
        let lo = this.i;
        while this.i < s.len && (isNameChar(s[this.i]) || s[this.i] == ':' || s[this.i] == '|' || s[this.i] == '.') { this.i += 1; }
        if this.i == lo { return Result.Err(uiErr(lo, lo + 1, "expected an attribute name")); }
        let name = s[lo..this.i];
        if !this.at("=") { return Result.Ok(Attr { name: name, range: Range { lo: lo, hi: this.i }, value: Value.None }); }
        this.i += 1;
        let q: u8 = if this.i < s.len { s[this.i] } else { 0 };
        if q == '{' {
            let e = this.braceEnd(this.i)?;
            let r = trimRange(s, this.i + 1, e);
            // `on:mousedown|stop={}` only stops the bubble walk, so it may be empty
            if r.lo == r.hi && !endsWith(name, "|stop") { return Result.Err(uiErr(this.i, e + 1, "empty `{}`")); }
            this.i = e + 1;
            return Result.Ok(Attr { name: name, range: Range { lo: lo, hi: this.i }, value: Value.Expr(r) });
        }
        if q != '"' && q != '\'' { return Result.Err(uiErr(this.i, this.i + 1, "expected `\"text\"` or `{expr}` after `=`")); }
        this.i += 1;
        let parts = List<Part>.new(a);
        let litLo = this.i;
        while true {
            if this.i >= s.len { return Result.Err(uiErr(lo, this.i, "this attribute value is never closed")); }
            let c = s[this.i];
            if c == q { break; }
            if c == '{' {
                if this.i > litLo { parts.push(Part.Lit(decode(s[litLo..this.i], a))); }
                let e = this.braceEnd(this.i)?;
                let r = trimRange(s, this.i + 1, e);
                if r.lo == r.hi { return Result.Err(uiErr(this.i, e + 1, "empty `{}`")); }
                parts.push(Part.Hole(r));
                this.i = e + 1;
                litLo = this.i;
                continue;
            }
            this.i += 1;
        }
        if this.i > litLo || parts.len == 0 { parts.push(Part.Lit(decode(s[litLo..this.i], a))); }
        this.i += 1;
        return Result.Ok(Attr { name: name, range: Range { lo: lo, hi: this.i }, value: Value.Str(Parts { items: parts }) });
    }
}
