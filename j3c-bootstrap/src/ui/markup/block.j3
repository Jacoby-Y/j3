// Blocks: `{#if}`, `{:else}`, `{#match}` / `{:case}`, `{#each}`, `{#let}` and their ends.
//
// Part of module j3c.ui.markup.
// Port of: j3c/src/ui/markup/block.rs
// J3: Rust's one `match kw` is one method per block here (`ifBlock`, `letBlock`, `eachBlock`, `matchBlock`).
module j3c.ui.markup;

/// A text node of only whitespace literals (what may sit between `{#match}` and its first `{:case}`).
fn blankText(n: Node): bool {
    match n {
        Node.Text(t) {
            for i in 0..t.parts.len {
                match t.parts.items[i] {
                    Part.Lit(l) { if uTrim(l).len != 0 { return false; } }
                    Part.Hole(_) { return false; }
                }
            }
            return true;
        }
        Node.Let(_) { return false; }
        Node.Elem(_) { return false; }
        Node.If(_) { return false; }
        Node.Each(_) { return false; }
    }
    return false;
}

fn lastIsElse(branches: &List<Branch>): bool {
    return branches.len > 0 && branches.items[branches.len - 1].vals.len == 0;
}

extend P {
    /// `</t>` at `r` inside the block `what` (`{#if}`).
    fn closeInside(this: &P, c: Named, what: string): UiError {
        return uiErr(c.r.lo, c.r.hi, Text.new(this.a).add("`</").add(c.name).add(">` found inside `").add(what).add("`; close the block first").str());
    }

    /// The `{/if}`, `{:else ..}`, `{/each}`, `{:case ..}` or `{/match}` at the cursor.
    fn blockEnd(this: &P): Result<End, UiError> {
        let s = this.s;
        let lo = this.i;
        let e = this.braceEnd(lo)?;
        let inner = s[lo + 1..e];
        this.i = e + 1;
        let r = Range { lo: lo, hi: e + 1 };
        if inner == "/if" { return Result.Ok(End.EndIf(r)); }
        if inner == "/each" { return Result.Ok(End.EndEach(r)); }
        if inner == "/match" { return Result.Ok(End.EndMatch(r)); }
        if startsWith(inner, ":case") && wsLen(inner, 5) > 0 {
            // values split at top-level commas (not inside brackets, strings, or char/backtick text)
            let vals = List<Range>.new(this.a);
            let from = lo + 6;
            let depth = 0;
            let q = lo + 6;
            while q <= e {
                let c: u8 = if q < e { s[q] } else { ',' };
                if c == '(' || c == '[' || c == '{' {
                    depth += 1;
                } else if c == ')' || c == ']' || c == '}' {
                    depth -= 1;
                } else if c == '"' || c == '`' {
                    q += 1;
                    while q < e && s[q] != c {
                        if s[q] == '\\' { q += 1; }
                        q += 1;
                    }
                } else if c == ',' && depth == 0 {
                    let v = trimRange(s, from, q);
                    if v.lo == v.hi { return Result.Err(uiErr(lo, e + 1, "`{:case}` needs a value (`{:case 1, 2}`)")); }
                    vals.push(v);
                    from = q + 1;
                }
                q += 1;
            }
            return Result.Ok(End.Case(CaseEnd { vals: vals, r: r }));
        }
        if uTrim(inner) == ":else" { return Result.Ok(End.Else(ElseEnd { cond: Option.None, r: r })); }
        if startsWith(inner, ":else if") && wsLen(inner, 8) > 0 {
            let c = trimRange(s, lo + 9, e);
            if c.lo == c.hi { return Result.Err(uiErr(lo, e + 1, "`{:else if}` needs a condition")); }
            return Result.Ok(End.Else(ElseEnd { cond: Option.Some(c), r: r }));
        }
        return Result.Err(uiErr(lo, e + 1, "unknown block tag").withHelp("blocks: {#if}{:else if}{:else}{/if}, {#match X}{:case 1, 2}{:else}{/match} and {#each X as x, i}{/each}"));
    }

    /// The `{#if}`, `{#match}`, `{#each}` or `{#let}` at the cursor, with its body.
    fn block(this: &P): Result<Node, UiError> {
        let s = this.s;
        let lo = this.i;
        let e = this.braceEnd(lo)?;
        let inner = s[lo + 2..e];
        let kwEnd = 0;
        while kwEnd < inner.len && wsLen(inner, kwEnd) == 0 { kwEnd += 1; }
        let kw = inner[0..kwEnd];
        let head = trimRange(s, lo + 2 + kwEnd, e);
        this.i = e + 1;
        let at = Range { lo: lo, hi: e + 1 };
        if kw == "if" { return this.ifBlock(at, head); }
        if kw == "let" { return this.letBlock(at, head); }
        if kw == "each" { return this.eachBlock(at, head); }
        if kw == "match" { return this.matchBlock(at, head); }
        return Result.Err(uiErr(lo, e + 1, Text.new(this.a).add("unknown block `{#").add(kw).add("}`").str()).withHelp("blocks: #if, #match, #each and #let"));
    }

    fn ifBlock(this: &P, at: Range, head: Range): Result<Node, UiError> {
        if head.lo == head.hi { return Result.Err(uiErr(at.lo, at.hi, "`{#if}` needs a condition")); }
        let branches = List<Branch>.new(this.a);
        let cond: Option<Range> = Option.Some(head);
        while true {
            let ne = this.nodes(false)?;
            branches.push(Branch { cond: cond, vals: List<Range>.new(this.a), nodes: ne.nodes });
            match ne.end {
                End.Else(el) {
                    match cond {
                        Option.Some(_) {}
                        Option.None { return Result.Err(uiErr(el.r.lo, el.r.hi, "`{:else}` must be the last branch")); }
                    }
                    cond = el.cond;
                }
                End.EndIf(r) {
                    return Result.Ok(Node.If(IfNode { branches: branches, scrut: Option.None, choice: Option.None, range: Range { lo: at.lo, hi: r.hi }, uid: this.nextUid() }));
                }
                End.Eof { return Result.Err(uiErr(at.lo, at.hi, "`{#if}` is never closed with `{/if}`")); }
                End.Close(c) { return Result.Err(this.closeInside(c, "{#if}")); }
                End.EndEach(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/each}` found where `{/if}` was expected")); }
                End.Case(c) { return Result.Err(uiErr(c.r.lo, c.r.hi, "`{:case}` outside `{#match}`")); }
                End.EndMatch(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/match}` found where `{/if}` was expected")); }
            }
        }
        return Result.Err(uiErr(at.lo, at.hi, ""));
    }

    fn letBlock(this: &P, at: Range, head: Range): Result<Node, UiError> {
        let s = this.s;
        let bad = uiErr(at.lo, at.hi, "`{#let}` needs `name = expr`").withHelp("`{#let f = state.files[id]}`; it has no `{/let}`");
        let h = s[head.lo..head.hi];
        let eq = text.find(h, "=");
        if eq < 0 { return Result.Err(bad); }
        let name = uTrim(h[0..eq]);
        let valid = name.len > 0 && !(name[0] >= '0' && name[0] <= '9');
        for i in 0..name.len {
            let c = name[i];
            if !(isAlpha(c) || (c >= '0' && c <= '9') || c == '_') { valid = false; }
        }
        let expr = trimRange(s, head.lo + eq + 1, head.hi);
        if !valid || expr.lo == expr.hi || startsWith(h[eq + 1..h.len], "=") { return Result.Err(bad); }
        let a = head.lo + text.find(h, name);
        return Result.Ok(Node.Let(LetNode { name: name, nameR: Range { lo: a, hi: a + name.len }, expr: expr, range: at }));
    }

    fn eachBlock(this: &P, at: Range, head: Range): Result<Node, UiError> {
        if head.lo == head.hi { return Result.Err(uiErr(at.lo, at.hi, "`{#each}` needs `X as x`")); }
        let ne = this.nodes(false)?;
        match ne.end {
            End.EndEach(r) { return Result.Ok(Node.Each(EachNode { head: head, body: ne.nodes, range: Range { lo: at.lo, hi: r.hi }, uid: this.nextUid() })); }
            End.Eof { return Result.Err(uiErr(at.lo, at.hi, "`{#each}` is never closed with `{/each}`")); }
            End.Else(el) { return Result.Err(uiErr(el.r.lo, el.r.hi, "`{#each}` has no `{:else}`")); }
            End.EndIf(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/if}` found where `{/each}` was expected")); }
            End.Case(c) { return Result.Err(uiErr(c.r.lo, c.r.hi, "`{:case}` outside `{#match}`")); }
            End.EndMatch(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/match}` found where `{/each}` was expected")); }
            End.Close(c) { return Result.Err(this.closeInside(c, "{#each}")); }
        }
        return Result.Err(uiErr(at.lo, at.hi, ""));
    }

    fn matchBlock(this: &P, at: Range, head: Range): Result<Node, UiError> {
        let s = this.s;
        if head.lo == head.hi { return Result.Err(uiErr(at.lo, at.hi, "`{#match}` needs a value")); }
        let branches = List<Branch>.new(this.a);
        let seen = List<string>.new(this.a);
        let pre = this.nodes(false)?;
        for i in 0..pre.nodes.len {
            if !blankText(pre.nodes.items[i]) {
                return Result.Err(uiErr(at.lo, at.hi, "`{#match}` holds only `{:case}` and `{:else}`; put content inside a case"));
            }
        }
        let end = pre.end;
        while true {
            let vals = List<Range>.new(this.a);
            match end {
                End.Case(c) {
                    if lastIsElse(&branches) { return Result.Err(uiErr(c.r.lo, c.r.hi, "`{:case}` after `{:else}`; `{:else}` must be last")); }
                    for i in 0..c.vals.len {
                        let v = c.vals.items[i];
                        let t = s[v.lo..v.hi];
                        for k in 0..seen.len {
                            if seen.items[k] == t {
                                return Result.Err(uiErr(v.lo, v.hi, Text.new(this.a).add("duplicate `{:case ").add(t).add("}`: the first one wins, so this branch would never run").str()));
                            }
                        }
                        seen.push(t);
                    }
                    vals = c.vals;
                }
                End.Else(el) {
                    match el.cond {
                        Option.Some(_) { return Result.Err(uiErr(el.r.lo, el.r.hi, "`{:else if}` isn't allowed in `{#match}`; use `{:case a, b}` or `{:else}`")); }
                        Option.None {}
                    }
                    if lastIsElse(&branches) { return Result.Err(uiErr(el.r.lo, el.r.hi, "`{:else}` must be the last branch")); }
                }
                End.EndMatch(r) {
                    if branches.len == 0 { return Result.Err(uiErr(at.lo, at.hi, "`{#match}` has no `{:case}`")); }
                    return Result.Ok(Node.If(IfNode { branches: branches, scrut: Option.Some(head), choice: Option.None, range: Range { lo: at.lo, hi: r.hi }, uid: this.nextUid() }));
                }
                End.Eof { return Result.Err(uiErr(at.lo, at.hi, "`{#match}` is never closed with `{/match}`")); }
                End.Close(c) { return Result.Err(this.closeInside(c, "{#match}")); }
                End.EndIf(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/if}` found where `{/match}` was expected")); }
                End.EndEach(r) { return Result.Err(uiErr(r.lo, r.hi, "`{/each}` found where `{/match}` was expected")); }
            }
            let ne = this.nodes(false)?;
            branches.push(Branch { cond: Option.None, vals: vals, nodes: ne.nodes });
            end = ne.end;
        }
        return Result.Err(uiErr(at.lo, at.hi, ""));
    }
}
