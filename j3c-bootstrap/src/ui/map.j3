// Generated J3 text plus the map back to the `.j3ui` source.
//
// Port of: j3c/src/ui/map.rs
// J3: Every byte of generated text sits in one segment. A `copy` segment is J3 lifted verbatim from a
// `.j3ui` (offsets line up one to one). A `glue` segment is generated code; it maps to the `.j3ui` range
// of the element or construct that produced it, so an error in glue is shown at that element and never as
// generated code. The map answers both ways (`toGen` is for the LSP).
// J3: `Out.text` is a `Text` (rule 2); `hint` is a static string, "" for none (Rust `Option<&'static str>`);
// `file` is the index into the scan-ordered file list (`ui.Generated.files`), not an `Id<Source>`.
// `copy` / `copyFlat` append the source bytes straight from `src[lo..hi]` (a view): no string per token.
module j3c.ui.map;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.text.Text;

/// Generated bytes `lo..hi` and the source range `slo..shi` of file `file` they stand for.
pub struct Seg {
    lo: int;
    hi: int;
    file: int;
    slo: int;
    shi: int;
    copy: bool;
    /// Extra help line for an error landing in this segment ("" = none).
    hint: string;
}

/// Where a generated span lands in the sources.
pub struct SrcSpan {
    file: int;
    lo: int;
    hi: int;
    hint: string;
}

pub struct SpanMap {
    segs: List<Seg>;

    /// Index of the segment holding generated byte `g`, -1 when none does.
    fn find(this: &SpanMap, g: int): int {
        let a = 0;
        let b = this.segs.len;
        while a < b {
            let mid = (a + b) / 2;
            if this.segs.items[mid].hi <= g { a = mid + 1; } else { b = mid; }
        }
        if a >= this.segs.len || this.segs.items[a].lo > g { return -1; }
        return a;
    }

    /// A generated byte range to the source range it stands for.
    fn toSrc(this: &SpanMap, lo: int, hi: int): Option<SrcSpan> {
        let ai = this.find(lo);
        if ai < 0 { return Option.None; }
        let a = this.segs.items[ai];
        let end = hi;
        if end < lo + 1 { end = lo + 1; }
        if !a.copy {
            let shi = a.shi;
            if shi < a.slo + 1 { shi = a.slo + 1; }
            return Option.Some(SrcSpan { file: a.file, lo: a.slo, hi: shi, hint: a.hint });
        }
        let start = a.slo + (lo - a.lo);
        let stop = a.shi;
        if end <= a.hi {
            stop = a.slo + (end - a.lo);
        } else {
            let bi = this.find(end - 1);
            if bi >= 0 {
                let b = this.segs.items[bi];
                if b.copy && b.file == a.file { stop = b.slo + (end - b.lo); }
            }
        }
        if stop < start + 1 { stop = start + 1; }
        return Option.Some(SrcSpan { file: a.file, lo: start, hi: stop, hint: a.hint });
    }

    /// A source offset to the generated offset of the same byte (copied text only), -1 when none.
    fn toGen(this: &SpanMap, file: int, pos: int): int {
        // A copy that starts at or contains `pos` wins over one that merely ends there: with
        // `!this.canBuy()` the cursor at `canBuy` must not land before the inserted `this.`.
        for i in 0..this.segs.len {
            let s = this.segs.items[i];
            if s.copy && s.file == file && s.slo <= pos && pos < s.shi { return s.lo + (pos - s.slo); }
        }
        for i in 0..this.segs.len {
            let s = this.segs.items[i];
            if s.copy && s.file == file && s.slo <= pos && pos <= s.shi { return s.lo + (pos - s.slo); }
        }
        return -1;
    }
}

/// Text under construction. `file`, `slo`, `shi` are the source range glue is attributed to (Rust `ctx`).
pub struct Out {
    text: Text;
    segs: List<Seg>;
    file: int;
    slo: int;
    shi: int;
    hint: string;
    ind: int;

    /// Empty, glue attributed to the start of file `file` (Rust `with_ctx`).
    fn new(arena: &Arena, file: int): Out {
        return Out { text: Text.new(arena), segs: List<Seg>.new(arena), file: file, slo: 0, shi: 0, hint: "", ind: 0 };
    }

    fn set(this: &Out, file: int, lo: int, hi: int) {
        this.file = file;
        this.slo = lo;
        this.shi = hi;
    }

    /// Generated code.
    fn s(this: &Out, t: string) {
        if t.len == 0 { return; }
        let lo = this.text.len();
        this.text.pushStr(t);
        if this.segs.len > 0 {
            let last = &this.segs.items[this.segs.len - 1];
            if !last.copy && last.hi == lo && last.file == this.file && last.slo == this.slo && last.shi == this.shi && last.hint == this.hint {
                last.hi = this.text.len();
                return;
            }
        }
        this.segs.push(Seg { lo: lo, hi: this.text.len(), file: this.file, slo: this.slo, shi: this.shi, copy: false, hint: this.hint });
    }

    /// Generated code that stands for the single point `at` in the source.
    fn at(this: &Out, file: int, at: int, t: string) {
        let f = this.file;
        let lo = this.slo;
        let hi = this.shi;
        this.set(file, at, at);
        this.s(t);
        this.set(f, lo, hi);
    }

    /// Indent, then `t`, then a newline.
    fn line(this: &Out, t: string) {
        this.pad();
        this.s(t);
        this.s("\n");
    }

    fn pad(this: &Out) {
        // one `s` call, as Rust (`"    ".repeat(ind)`): a run of pads is one glue segment either way
        for i in 0..this.ind { this.s("    "); }
    }

    /// J3 copied from the source.
    fn copy(this: &Out, file: int, src: string, lo: int, hi: int) {
        if lo >= hi { return; }
        let g = this.text.len();
        this.text.pushStr(src[lo..hi]);
        this.segs.push(Seg { lo: g, hi: this.text.len(), file: file, slo: lo, shi: hi, copy: true, hint: this.hint });
    }

    /// Like `copy`, but newlines become spaces and `\r` goes (a template hole is one line). As in Rust
    /// the segment keeps the unflattened length when a `\r` was dropped.
    fn copyFlat(this: &Out, file: int, src: string, lo: int, hi: int) {
        let g = this.text.len();
        this.copy(file, src, lo, hi);
        let nl = false;
        for i in g..this.text.len() { if this.text.bytes[i] == '\n' { nl = true; break; } }
        if !nl { return; }
        let w = g;
        let n = this.text.len();
        for i in g..n {
            let c = this.text.bytes[i];
            if c == '\r' { continue; }
            this.text.bytes[w] = if c == '\n' { ' ' } else { c };
            w += 1;
        }
        this.text.remove(w, n - w);
    }

    /// `other`'s text and segments after this one's.
    fn append(this: &Out, other: &Out) {
        let shift = this.text.len();
        this.text.pushStr(other.text.str());
        for i in 0..other.segs.len {
            let s = other.segs.items[i];
            s.lo += shift;
            s.hi += shift;
            this.segs.push(s);
        }
    }
}
