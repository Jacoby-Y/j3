// `class`, `class:name`, `style:prop` passed on a component tag.
//
// Port of: j3c/src/ui/pass.rs
// J3: The component is generated once and shared by every use, so the values travel as hidden `j3pass_*`
// fields of its `Props`; the root element applies them each frame (`d.scopePass`, `d.clsPass`, `d.stylePass`).
// J3: `roots` and `out` are lookups only (never iterated into output). `singleRoot` returns a copy of the
// root `Elem`; its `uid` says which element it is (Rust returns a reference and callers take its address).
// Its two built messages live in the arena of `nodes` (the signature has no arena).
module j3c.ui.pass;

use j3.data.map.Map;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.{ Text, startsWith };
use j3c.syntax.lex.{ trimEnd, trimStart };
use j3c.ui.markup.{ Attr, Elem, Node, Part, UiError, uiErr };

/// Slots 0..8 of `dynattr`; slot 8 is the virtual list's row hide.
pub const MAX_STYLE: int = 8;

/// Hidden `Props` field names start with this; user names may not.
pub const PREFIX = "j3pass";

/// What the uses of one component pass.
pub struct Pass {
    /// Some use passes `class` / `class:name`.
    cls: bool;
    /// The most `style:` attributes any use passes.
    styles: int;
    /// `style:` attributes on the root element itself (the passed ones start after them).
    own: int;
}

pub fn isPass(a: &Attr): bool {
    return a.name == "class" || startsWith(a.name, "class:") || startsWith(a.name, "style:");
}

fn blank(n: Node): bool {
    match n {
        Node.Let(_) { return true; }
        Node.Text(t) {
            for i in 0..t.parts.len {
                match t.parts.items[i] {
                    Part.Lit(l) { if trimEnd(trimStart(l)).len != 0 { return false; } }
                    Part.Hole(_) { return false; }
                }
            }
            return true;
        }
        Node.Elem(_) { return false; }
        Node.If(_) { return false; }
        Node.Each(_) { return false; }
    }
    return false;
}

/// The component's one root element, or why it has none (the Err text is part of an error message).
pub fn singleRoot(nodes: &List<Node>): Result<Elem, string> {
    let real = 0;
    let at = 0;
    for i in 0..nodes.len {
        if !blank(nodes.items[i]) {
            real += 1;
            at = i;
        }
    }
    if real == 0 { return Result.Err("its markup is empty"); }
    if real > 1 {
        let t = Text.new(nodes.arena).add("it has ");
        t.pushInt(real);
        return Result.Err(t.add(" root nodes").str());
    }
    match nodes.items[at] {
        Node.Elem(e) {
            if e.comp { return Result.Err(Text.new(nodes.arena).add("its root is the component `<").add(e.tag).add(">`").str()); }
            if e.tag == "slot" { return Result.Err("its root is a `<slot />`"); }
            return Result.Ok(e);
        }
        Node.If(i) {
            match i.scrut {
                Option.Some(_) { return Result.Err("its root is a `{#match}`"); }
                Option.None { return Result.Err("its root is an `{#if}`"); }
            }
        }
        Node.Each(_) { return Result.Err("its root is an `{#each}`"); }
        Node.Text(_) { return Result.Err("its root is text"); }
        Node.Let(_) { return Result.Err("its markup is empty"); }
    }
    return Result.Err("its markup is empty");
}

/// `style:` attributes on the root element itself.
pub fn ownStyles(root: &Elem): int {
    let n = 0;
    for i in 0..root.attrs.len { if startsWith(root.attrs.items[i].name, "style:") { n += 1; } }
    return n;
}

/// Record in `out` what every component use under `nodes` passes; `roots` is each component's top nodes by name.
pub fn scan(nodes: &List<Node>, roots: &Map<string, List<Node>>, out: &Map<string, Pass>): Result<bool, UiError> {
    let a = nodes.arena;
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                // the first passed attribute, the first `style:` one, and the counts
                let first = -1;
                let firstStyle = -1;
                let styles = 0;
                let cls = false;
                for k in 0..e.attrs.len {
                    if !isPass(&e.attrs.items[k]) { continue; }
                    if first < 0 { first = k; }
                    if startsWith(e.attrs.items[k].name, "style:") {
                        if firstStyle < 0 { firstStyle = k; }
                        styles += 1;
                    } else {
                        cls = true;
                    }
                }
                if e.comp && first >= 0 {
                    match roots.get(e.tag) {
                        Option.Some(child) {
                            let p0 = e.attrs.items[first];
                            let root = match singleRoot(&child) {
                                Result.Ok(r) { r }
                                Result.Err(why) {
                                    let msg = Text.new(a).add("`").add(p0.name).add("` on `<").add(e.tag).add(">` has no element to go to: ").add(why).str();
                                    let help = Text.new(a).add("`class` and `style:` land on the root element of `").add(e.tag)
                                        .add("`, so its markup must be exactly one element (not a component, `<slot />`, `{#if}`, `{#each}` or text); pass a prop instead").str();
                                    return Result.Err(uiErr(p0.range.lo, p0.range.hi, msg).withHelp(help));
                                }
                            };
                            let own = ownStyles(&root);
                            if own + styles > MAX_STYLE {
                                let sa = e.attrs.items[firstStyle];
                                let t = Text.new(a).add("`<").add(e.tag).add(">` passes ");
                                t.pushInt(styles);
                                t.add(" `style:` and its root has ");
                                t.pushInt(own);
                                t.add(" of its own: at most ");
                                t.pushInt(MAX_STYLE);
                                return Result.Err(uiErr(sa.range.lo, sa.range.hi, t.add(" together").str()));
                            }
                            let p = match out.get(e.tag) {
                                Option.Some(p) { p }
                                Option.None { Pass { cls: false, styles: 0, own: 0 } }
                            };
                            if cls { p.cls = true; }
                            if styles > p.styles { p.styles = styles; }
                            p.own = own;
                            out.put(e.tag, p);
                        }
                        Option.None {}
                    }
                }
                scan(&e.children, roots, out)?;
            }
            Node.If(n) { for k in 0..n.branches.len { scan(&n.branches.items[k].nodes, roots, out)?; } }
            Node.Each(e) { scan(&e.body, roots, out)?; }
        }
    }
    return Result.Ok(true);
}

/// `j3pass_<c><k>` (a hidden field name).
fn fld(t: &Text, c: string, k: int) {
    t.add(PREFIX).add("_").add(c);
    t.pushInt(k);
}

/// The hidden `Props` fields for `p`, as struct-field text.
pub fn fields(p: Pass, a: &Arena): string {
    let t = Text.new(a).add("    ").add(PREFIX).add("_scope: int;\n    ").add(PREFIX).add("_cls: string;\n");
    for k in 0..p.styles {
        t.add("    ");
        fld(t, "k", k);
        t.add(": int;\n    ");
        fld(t, "n", k);
        t.add(": string;\n    ");
        fld(t, "f", k);
        t.add(": f32;\n    ");
        fld(t, "s", k);
        t.add(": string;\n");
    }
    return t.str();
}

/// The statements that apply the passed class and styles to root node variable `n`.
pub fn apply(p: Pass, n: string, a: &Arena): List<string> {
    let v = List<string>.new(a);
    v.push(Text.new(a).add("d.scopePass(").add(n).add(", p.").add(PREFIX).add("_scope);").str());
    if p.cls { v.push(Text.new(a).add("d.clsPass(").add(n).add(", p.").add(PREFIX).add("_cls);").str()); }
    for k in 0..p.styles {
        let t = Text.new(a).add("d.stylePass(").add(n).add(", ");
        t.pushInt(p.own + k);
        t.add(", p.");
        fld(t, "k", k);
        t.add(", p.");
        fld(t, "n", k);
        t.add(", p.");
        fld(t, "f", k);
        t.add(", p.");
        fld(t, "s", k);
        v.push(t.add(");").str());
    }
    return v;
}

/// The value of an unused passed-style slot `k`.
pub fn unused(k: int, a: &Arena): string {
    let t = Text.new(a);
    fld(&t, "k", k);
    t.add(": 0, ");
    fld(&t, "n", k);
    t.add(": \"\", ");
    fld(&t, "f", k);
    t.add(": 0.0, ");
    fld(&t, "s", k);
    return t.add(": \"\"").str();
}
