// `class`, `class:name`, `style:prop` passed on a component tag.
//
// Port of: j3c/src/ui/pass.rs
// J3: C2e chunk A fills the bodies; the signatures are the contract (`contracts-c2e.md`). `roots` and `out`
// are lookups only (never iterated into output). `singleRoot` returns a copy of the root `Elem`; its `uid`
// says which element it is (Rust returns a reference and callers take its address).
module j3c.ui.pass;

use j3.data.map.Map;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text.{ Text, startsWith };
use j3c.ui.markup.{ Attr, Elem, Node, Part, UiError, notYet, uiErr };

/// Slots 0..8 of `dynattr`; slot 8 is the virtual list's row hide.
pub const MAX_STYLE: int = 8;

/// Hidden `Props` field names start with this; user names may not.
pub const PREFIX = "j3pass";

/// What the uses of one component pass.
pub struct Pass {
    /// Some use passes `class` / `class:name`.
    cls: bool;
    /// The most `style:` attributes any use passes.
    styles: int;
    /// `style:` attributes on the root element itself (the passed ones start after them).
    own: int;
}

pub fn isPass(a: &Attr): bool {
    return a.name == "class" || startsWith(a.name, "class:") || startsWith(a.name, "style:");
}

/// The component's one root element, or why it has none (the Err text is part of an error message).
pub fn singleRoot(nodes: &List<Node>): Result<Elem, string> {
    return Result.Err("ui: pass.singleRoot: not ported yet (chunk A)"); // STUB A
}

/// `style:` attributes on the root element itself.
pub fn ownStyles(root: &Elem): int {
    return 0; // STUB A
}

/// Record in `out` what every component use under `nodes` passes; `roots` is each component's top nodes by name.
pub fn scan(nodes: &List<Node>, roots: &Map<string, List<Node>>, out: &Map<string, Pass>): Result<bool, UiError> {
    return Result.Err(notYet("pass.scan (chunk A)")); // STUB A
}

/// The hidden `Props` fields for `p`, as struct-field text.
pub fn fields(p: Pass, a: &Arena): string {
    return ""; // STUB A
}

/// The statements that apply the passed class and styles to root node variable `n`.
pub fn apply(p: Pass, n: string, a: &Arena): List<string> {
    return List<string>.new(a); // STUB A
}

/// The value of an unused passed-style slot `k`.
pub fn unused(k: int, a: &Arena): string {
    return ""; // STUB A
}
