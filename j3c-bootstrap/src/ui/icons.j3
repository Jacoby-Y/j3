    return List<string>.new(a); // STUB A
}

/// Read `dir/*.svg` (a project's `icons/`), sorted by path; a missing folder is no icons. Err is
/// `PATH: reason`.
pub fn loadDir(dir: string, a: &Arena): Result<List<Icon>, string> {
    return Result.Ok(List<Icon>.new(a)); // STUB A (no corpus project has an `icons/` folder)
}

