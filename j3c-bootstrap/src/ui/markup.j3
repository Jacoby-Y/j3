// The `.j3ui` container: markup, `{...}` holes, blocks, the `<script>` item list.
//
// Port of: j3c/src/ui/markup/mod.rs
// J3: This is not a J3 parser. It only finds where each `{...}` ends (brace counting that skips strings and
// templates) and splits `<script>` into items with the real lexer (`syntax/lex.j3`). Every J3 fragment
// stays a byte range into the file; `gen` copies those ranges verbatim and the real parser reads the result.
// J3: The tree types are in `markup/types.j3` (frozen). This file holds every `use` of the module (part
// files share them; a part adds a `use` only for a name no other file of the module imports).
// J3: C2e chunk A fills `parse`, `trimRange`, `isNameChar` here, `P`'s methods in `markup/block.j3` and
// `markup/element.j3`, and `parseScript` in `markup/script.j3`. `P` and `End` are chunk A's to shape.
module j3c.ui.markup;

use j3.data.pool.Id;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text;
use j3.text.{ Text, contains, endsWith, startsWith };
use j3c.base.intern.own;
use j3c.base.span.Source;
use j3c.syntax.lex.lex;
use j3c.syntax.token.{ ParseError, Token, TokenKind };

/// What ended a node list (Rust `End`).
enum End {
    Eof,
    Close(Named),
    Else(ElseEnd),
    EndIf(Range),
    EndEach(Range),
    Case(CaseEnd),
    EndMatch(Range),
}

/// `{:else}` / `{:else if cond}` and its range.
struct ElseEnd {
    cond: Option<Range>;
    r: Range;
}

/// `{:case a, b}` and its range.
struct CaseEnd {
    vals: List<Range>;
    r: Range;
}

/// The parser state (Rust `P`). `uid` is the project's identity counter (see `types.j3`).
struct P {
    s: string;
    i: int;
    out: Markup;
    a: &Arena;
    uid: &int;
}

/// Parse one `.j3ui` text. Strings of the tree are slices of `src` or copies in `a`; every `Elem`,
/// `IfNode` and `EachNode` takes its `uid` from `*uid` (then `*uid += 1`).
pub fn parse(src: string, a: &Arena, uid: &int): Result<Markup, UiError> {
    return Result.Err(notYet("markup.parse (chunk A)")); // STUB A
}

/// `lo..hi` of `s` without the whitespace at both ends (Rust `trim_range`).
pub fn trimRange(s: string, lo: int, hi: int): Range {
    return Range { lo: lo, hi: hi }; // STUB A
}

/// A byte of a tag or attribute name (Rust `is_name_char`).
pub fn isNameChar(c: u8): bool {
    return false; // STUB A
}
