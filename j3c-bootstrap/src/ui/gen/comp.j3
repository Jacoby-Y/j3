// Component use: props, events, passed class/style, slot methods, `<slot>`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/comp.rs
// J3: C2e chunk C. `slotMethod` takes the slot's nodes as a `List<Node>` (shallow copies; Rust `&[&Node]`).
// Rust swaps `upd` / `pnt` / `used_u` / `used_p` with `mem::replace`: here a copy out, a fresh one in, and the
// copy back. Rust's `res.and_then(..)` chain is `if rok(res) { res = ..; }`.
module j3c.ui.gen;

extend G {
    fn placeBad(this: &G, r: Range): UiError {
        return uiErr(r.lo, r.hi, "`bind:` needs a place: a name, a field, or an index").withHelp(cf(this.a, "found `%`", [this.src[r.lo..r.hi]]));
    }

    /// `bind:` takes a place: a name, then `.field` and `[index]` steps.
    fn placeCheck(this: &G, r: Range): Result<bool, UiError> {
        let toks = lexAt(this.src, r, this.a)?;
        if toks.len == 0 || (toks.items[0].kind != TokenKind.Ident && toks.items[0].kind != TokenKind.This) { return Result.Err(this.placeBad(r)); }
        let k = 1;
        while toks.items[k].kind != TokenKind.Eof {
            if toks.items[k].kind == TokenKind.Dot && toks.items[k + 1].kind == TokenKind.Ident {
                k += 2;
            } else if toks.items[k].kind == TokenKind.LBracket {
                let depth = 0;
                while toks.items[k].kind != TokenKind.Eof {
                    if toks.items[k].kind == TokenKind.LBracket { depth += 1; }
                    else if toks.items[k].kind == TokenKind.RBracket {
                        depth -= 1;
                        if depth == 0 { break; }
                    }
                    k += 1;
                }
                if toks.items[k].kind == TokenKind.Eof { return Result.Err(this.placeBad(r)); }
                k += 1;
            } else {
                return Result.Err(this.placeBad(r));
            }
        }
        return Result.Ok(true);
    }

    /// A component use at child slot expression `slot`.
    fn comp(this: &G, e: &Elem, slot: string, depth: int): Result<bool, UiError> {
        let a = this.a;
        let ci = -1;
        for i in 0..this.all.len { if this.all.items[i].name == e.tag { ci = i; break; } }
        if ci < 0 {
            let known = Text.new(a);
            for i in 0..this.all.len {
                if i > 0 { known.add(", "); }
                known.add(this.all.items[i].name);
            }
            return Result.Err(uiErr(e.open.lo, e.open.lo + 1 + e.tag.len, cf(a, "unknown component `<%>`", [e.tag])).withHelp(cf(a, "known components: %", [known.str()])));
        }
        let child = &this.all.items[ci];
        let id = this.ids[e.uid];
        this.insts.push(Inst { id: id, comp: child.id, container: this.cont() });
        let inst = cf(a, "%.c%", [this.owner(), num(a, id)]);
        // validate attributes
        let cprops = List<string>.new(a);
        for i in 0..child.sc.props.len {
            match child.sc.props.items[i].hidden { Option.Some(_) {} Option.None { cprops.push(child.sc.props.items[i].name); } }
        }
        let cevents = List<string>.new(a);
        for i in 0..child.sc.events.len { cevents.push(child.sc.events.items[i].name); }
        let slotted = this.slots.slotted.has(e.uid);
        for i in 0..e.attrs.len {
            let at = &e.attrs.items[i];
            let nm = at.name;
            if (nm == "slot" && slotted) || pass.isPass(at) { continue; } // `class` / `style:` go to the child's root element (`pass`)
            let msg = "";
            let help = "";
            if startsWith(nm, "on:") {
                let ev = nm[3..nm.len];
                if hasStr(&cevents, ev) { continue; }
                help = if cevents.len == 0 { cf(a, "`%` declares no events", [e.tag]) } else { cf(a, "`%` events: %", [e.tag, joinStr(a, &cevents, ", ")]) };
                msg = cf(a, "`<%>` has no event `%`", [e.tag, ev]);
            } else if nm == "animate:flip" || nm == "animate-easing" {
                msg = cf(a, "`%` goes on the row element, not a component (`<%>`)", [nm, e.tag]);
                help = "wrap it: `{#each xs as x (x.id)}<div animate:flip><Row .../></div>{/each}`";
            } else if nm == "bind:this" {
                msg = "`bind:this` on a component isn't supported yet";
                help = "put `bind:this` on an element inside it, or on a wrapper `<div>` around the component";
            } else if contains(nm, ":") {
                msg = cf(a, "`%` isn't supported on a component", [nm]);
                help = "only props and `on:event` handlers go on `<Component>`";
            } else if !hasStr(&cprops, nm) {
                help = if cprops.len == 0 { cf(a, "`%` takes no props", [e.tag]) } else { cf(a, "`%` props: %", [e.tag, joinStr(a, &cprops, ", ")]) };
                msg = cf(a, "unknown prop `%` for `<%>`", [nm, e.tag]);
            } else {
                continue;
            }
            return Result.Err(uiErr(at.range.lo, at.range.hi, msg).withHelp(help));
        }
        for i in 0..child.sc.props.len {
            let p = &child.sc.props.items[i];
            let need = true;
            match p.hidden { Option.Some(_) { need = false; } Option.None {} }
            match p.default { Option.Some(_) { need = false; } Option.None {} }
            if need && cattr(e, p.name) < 0 {
                return Result.Err(uiErr(e.open.lo, e.open.hi, cf(a, "missing prop `%` for `<%>`", [p.name, e.tag])).withHelp(cf(a, "`%` props: %", [e.tag, joinStr(a, &cprops, ", ")])));
            }
        }
        let si = -1;
        match this.slots.byUid.get(e.uid) { Option.Some(x) { si = x; } Option.None {} }
        let siteId = "";
        if si >= 0 {
            let site = &this.slots.list.items[si];
            siteId = num(a, site.id);
            for q in 0..site.names.len {
                let name = site.names.items[q];
                let nodes = List<Node>.new(a);
                for c in 0..e.children.len { if slotOf(&e.children.items[c]) == name { nodes.push(e.children.items[c]); } }
                this.slotMethod(site.id, name, &nodes, depth, e.open)?;
            }
        }
        let ks = num(a, this.nk());
        this.upd.set(this.fi, e.open.lo, e.open.hi);
        this.cul("let s% = d.enter(%);", [ks, slot]);
        if si >= 0 {
            let iv = if this.idx.len > 0 { this.idx.items[this.idx.len - 1] } else { "0" };
            this.cul("%.slotSite = %;", [inst, siteId]);
            this.cul("%.slotOwn = this as int;", [inst]);
            this.cul("%.slotI = %;", [inst, iv]);
        }
        this.upd.pad();
        this.cus("let e% = %.update(d, %Props { ", [ks, inst, child.id]);
        for i in 0..child.sc.props.len {
            let p = &child.sc.props.items[i];
            if i > 0 { this.upd.s(", "); }
            let hidden = false;
            match p.hidden { Option.Some(_) { hidden = true; } Option.None {} }
            if hidden {
                // `provide`d by this component (a `let` or a prop) or handed down to it
                this.upd.set(this.fi, e.open.lo, e.open.hi);
                if hasStr(&this.names.lets, p.name) {
                    this.cus("%: this.%", [p.name, p.name]);
                } else {
                    sortedInsert(&this.usedU, p.name);
                    this.cus("%: %", [p.name, p.name]);
                }
                continue;
            }
            let ai = cattr(e, p.name);
            if ai < 0 {
                // omitted: the child's default, a constant, sent every frame like any prop (the child's `const`s renamed)
                let r = Range { lo: 0, hi: 0 };
                match p.default { Option.Some(d) { r = d; } Option.None {} } // required props are checked above
                let names = emptyNames(a);
                for q in 0..child.sc.consts.len {
                    let l = child.sc.consts.items[q].name;
                    names.consts.push(ConstName { name: l, j3: cf(a, "%_%", [child.id, l]) });
                }
                let noLocals = List<string>.new(a);
                let noRename = List<Rename>.new(a);
                let rw = Rw { a: a, src: this.files.items[child.fi].text, fi: child.fi, names: &names, locals: &noLocals, rename: &noRename, emitOk: false, sev: false, callsEmit: false };
                this.cus("%: ", [p.name]);
                let used = List<string>.new(a);
                rewrite(&rw, &this.upd, &used, r.lo, r.hi, false)?;
                continue;
            }
            let at = &e.attrs.items[ai];
            this.upd.set(this.fi, at.range.lo, at.range.hi);
            this.cus("%: ", [p.name]);
            match at.value {
                Value.Expr(r) { this.expr(Mode.U, r)?; }
                Value.Str(parts) { this.strParts(Mode.U, &parts.items, at.range)?; }
                Value.None { this.upd.s("true"); }
            }
        }
        this.upd.set(this.fi, e.open.lo, e.open.hi);
        match this.slots.pass.get(child.name) {
            Option.Some(pi) { this.passArgs(e, pi, child.sc.props.len > 0)?; }
            Option.None {}
        }
        this.upd.s(" });\n");
        this.cul("d.leave(s%);", [ks]);
        for i in 0..e.attrs.len {
            let at = &e.attrs.items[i];
            if !startsWith(at.name, "on:") { continue; }
            let ev = at.name[3..at.name.len];
            let r = Range { lo: 0, hi: 0 };
            match at.value {
                Value.Expr(x) { r = x; }
                Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs `={ statements }`", [at.name]))); }
                Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs `={ statements }`", [at.name]))); }
            }
            this.upd.set(this.fi, at.range.lo, at.range.hi);
            this.cul("if e%.% {", [ks, ev]);
            this.upd.ind += 1;
            let nren = this.rename.len;
            let ps = Text.new(a);
            for q in 0..child.sc.evParams.len {
                let p = &child.sc.evParams.items[q];
                if p.ev != ev { continue; }
                if ps.len() > 0 { ps.add(", "); }
                ps.add(cf(a, "%: e%.%_%", [p.name, ks, ev, p.name]));
            }
            if ps.len() > 0 {
                let evt = cf(a, "evt%_%", [ks, ev]);
                this.cul("let % = %Event_% { % };", [evt, child.id, ev, ps.str()]);
                this.rename.push(Rename { from: "event", to: evt });
            }
            this.stmts(Mode.U, r, true)?;
            this.rename.len = nren;
            this.upd.ind -= 1;
            this.upd.line("}");
        }
        this.pnt.set(this.fi, e.open.lo, e.open.hi);
        this.cpl("let s% = d.enter(%);", [ks, slot]);
        if si >= 0 { this.cpl("%.slotOwn = this as int;", [inst]); }
        this.cpl("%.paint(d);", [inst]);
        this.cpl("d.leave(s%);", [ks]);
        return Result.Ok(true);
    }

    /// What the uses of this component passed, applied after the root's own attributes (a passed style wins).
    fn passApply(this: &G, e: &Elem, n: string) {
        match this.slots.pass.get(this.c.name) {
            Option.Some(p) {
                this.upd.set(this.fi, e.open.lo, e.open.hi);
                let ls = pass.apply(p, n, this.a);
                for i in 0..ls.len { this.upd.line(ls.items[i]); }
            }
            Option.None {} // `passRoot` is only set when the entry exists
        }
    }

    /// The hidden `j3pass_*` fields of the `Props` literal for a use of a component that takes `class` / `style:`:
    /// the parent's scope (only with a class), the class text, and the `style:` values (see `pass`).
    fn passArgs(this: &G, e: &Elem, pi: Pass, comma: bool): Result<bool, UiError> {
        let a = this.a;
        let pre = pass.PREFIX;
        let cls = List<int>.new(a);
        for i in 0..e.attrs.len {
            let nm = e.attrs.items[i].name;
            if nm == "class" || startsWith(nm, "class:") { cls.push(i); }
        }
        if comma { this.upd.s(", "); }
        this.cus("%_scope: %, %_cls: ", [pre, if cls.len == 0 { "0" } else { cf(a, "SCOPE_%", [this.c.id]) }, pre]);
        let parts = List<Part>.new(a);
        let condNames = List<string>.new(a);
        let condRs = List<Range>.new(a);
        for q in 0..cls.len {
            let at = &e.attrs.items[cls.items[q]];
            if startsWith(at.name, "class:") {
                let c = at.name[6..at.name.len];
                let ok = false;
                match at.value {
                    Value.Expr(r) {
                        if c.len > 0 {
                            condNames.push(c);
                            condRs.push(r);
                            ok = true;
                        }
                    }
                    Value.None {}
                    Value.Str(_) {}
                }
                if !ok { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs a condition: %={condition}", [at.name, at.name]))); }
            } else {
                match at.value {
                    Value.Str(p) { for i in 0..p.items.len { parts.push(p.items.items[i]); } }
                    Value.None {}
                    Value.Expr(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, "`class` takes text").withHelp("`class=\"a b{x}\"`; switch a class with `class:name={condition}`")); }
                }
            }
        }
        if condNames.len == 0 {
            let r = if cls.len > 0 { e.attrs.items[cls.items[0]].range } else { e.open };
            this.strParts(Mode.U, &parts, r)?;
        } else {
            // one template: the written words, then each `class:x` as `x` or nothing; copied to the
            // frame scratch `Text`, since the child keeps its props past this call
            this.upd.s("Text.scratch().add(`");
            for i in 0..parts.len {
                match parts.items[i] {
                    Part.Lit(l) {
                        if contains(l, "`") || contains(l, "\n") { return Result.Err(uiErr(e.open.lo, e.open.hi, "text next to `{...}` can't hold a backtick")); }
                        this.upd.s(l);
                    }
                    Part.Hole(r) {
                        this.upd.s("{");
                        this.rw(Mode.U, r.lo, r.hi, true, true, false)?;
                        this.upd.s("}");
                    }
                }
            }
            for i in 0..condNames.len {
                this.upd.s(" {if ");
                this.expr(Mode.U, condRs.items[i])?;
                this.cus(" { % } else { \"\" }}", [lit(condNames.items[i], a)]);
            }
            this.upd.s("`).str()");
        }
        let styles = List<int>.new(a);
        for i in 0..e.attrs.len { if startsWith(e.attrs.items[i].name, "style:") { styles.push(i); } }
        for k in 0..pi.styles {
            this.upd.s(", ");
            if k >= styles.len {
                this.upd.s(pass.unused(k, a));
                continue;
            }
            let at = &e.attrs.items[styles.items[k]];
            let prop = at.name[6..at.name.len];
            let isNum = this.styleVal(at, prop)?;
            let ks = num(a, k);
            this.cus("%_n%: %, ", [pre, ks, lit(prop, a)]);
            match at.value {
                Value.Expr(r) {
                    if isNum {
                        this.cus("%_k%: 1, %_f%: f32(", [pre, ks, pre, ks]);
                        this.expr(Mode.U, r)?;
                        this.cus("), %_s%: \"\"", [pre, ks]);
                    } else {
                        this.cus("%_k%: 2, %_f%: 0.0, %_s%: ", [pre, ks, pre, ks, pre, ks]);
                        this.expr(Mode.U, r)?;
                    }
                }
                Value.Str(p) {
                    this.cus("%_k%: 2, %_f%: 0.0, %_s%: ", [pre, ks, pre, ks, pre, ks]);
                    this.strParts(Mode.U, &p.items, at.range)?;
                }
                Value.None {} // refused by `styleVal`
            }
        }
        return Result.Ok(true);
    }

    /// `let <j3> = <expr>;` of a `{#let}` in scope, computed again in a slot method.
    fn slotLet(this: &G, j3: string, ex: Range): Result<bool, UiError> {
        this.upd.pad();
        this.cus("let % = ", [j3]);
        this.expr(Mode.U, ex)?;
        this.upd.s(";\n");
        return Result.Ok(true);
    }

    /// The content a use of a component passes to one of its slots, as a method pair on this
    /// component (`this` is the owner, so the content sees its props, lets and fns). The child
    /// calls it through `slotOwn`; an enclosing `{#each}` item is re-bound from the index `slotI`.
    fn slotMethod(this: &G, site: int, name: string, nodes: &List<Node>, depth: int, at: Range): Result<bool, UiError> {
        let a = this.a;
        this.ownsSlot = true;
        let su = this.upd;
        let sp = this.pnt;
        this.upd = Out.new(a, this.fi);
        this.pnt = Out.new(a, this.fi);
        this.upd.ind = 2;
        this.pnt.ind = 2;
        let uu = this.usedU;
        let up = this.usedP;
        this.usedU = List<string>.new(a);
        this.usedP = List<string>.new(a);
        let res: Result<bool, UiError> = Result.Ok(true);
        let ne = this.ectx.len;
        if this.inVirt > 0 {
            res = Result.Err(uiErr(at.lo, at.hi, "slot content inside a `virtual` list isn't supported"));
        } else if ne > 1 {
            res = Result.Err(uiErr(at.lo, at.hi, "slot content inside two nested `{#each}` blocks isn't supported yet"));
        }
        for i in 0..ne {
            let cx = this.ectx.items[i];
            if rok(res) { res = this.rebind(&cx.head, cx.k, cx.eid, cx.rows); }
        }
        // the `{#let}`s in scope at the use are computed again here (this is another fn)
        let nl = this.lets.len;
        for i in 0..nl {
            let l = this.lets.items[i];
            if rok(res) { res = this.slotLet(l.j3, l.expr); }
        }
        let j = 0;
        if rok(res) { res = this.seq(nodes, &j, depth, Option.None); }
        let bu = this.upd;
        let bp = this.pnt;
        this.upd = su;
        this.pnt = sp;
        let usedU = this.usedU;
        let usedP = this.usedP;
        this.usedU = uu;
        this.usedP = up;
        res?;
        let iv = if this.idx.len > 0 { this.idx.items[this.idx.len - 1] } else { "slotI" };
        let n = san(if name.len == 0 { "default" } else { name }, a);
        let id = this.c.id;
        let sites = num(a, site);
        for q in 0..2 {
            let o = Out.new(a, this.fi);
            o.set(this.fi, at.lo, at.hi);
            o.s(cf(a, "\n    fn slot%_%_%(this: &%, d: &Dom, %: int) {\n", [sites, n, if q == 0 { "update" } else { "paint" }, id, iv]));
            if q == 0 && this.c.sc.events.len > 0 { o.s("        let ev = &this.sev;\n"); }
            let used = if q == 0 { &usedU } else { &usedP };
            for i in 0..used.len { o.s(cf(a, "        let % = this.p.%;\n", [used.items[i], used.items[i]])); }
            o.append(if q == 0 { &bu } else { &bp });
            o.s("    }\n");
            this.slotFns.append(&o);
        }
        // the child stopped rendering the slot: the content's state dies with it, as in Svelte
        let dead = List<string>.new(a);
        let fresh = List<string>.new(a);
        this.resets(nodes, true, &dead);
        this.resets(nodes, false, &fresh);
        let o = Out.new(a, this.fi);
        o.s(cf(a, "\n    fn slot%_%_leave(this: &%, d: &Dom, %: int) {\n", [sites, n, id, iv]));
        for i in 0..ne {
            let cx = this.ectx.items[i];
            if cx.rows { o.s(cf(a, "        let r% = this.e%.items[%];\n", [num(a, cx.eid), num(a, cx.eid), iv])); }
        }
        for i in 0..dead.len { o.s(cf(a, "        %\n", [dead.items[i]])); }
        for i in 0..fresh.len { o.s(cf(a, "        %\n", [fresh.items[i]])); }
        o.s("    }\n");
        this.slotFns.append(&o);
        return Result.Ok(true);
    }

    /// The loop item of an enclosing `{#each}`, from its index (the slot method's parameter).
    fn rebind(this: &G, h: &EachHead, k: int, eid: int, rows: bool): Result<bool, UiError> {
        let a = this.a;
        let iv = if this.idx.len > 0 { this.idx.items[this.idx.len - 1] } else { "" };
        let item = h.item.name;
        let ks = num(a, k);
        if rows {
            let es = num(a, eid);
            this.cul("let r% = this.e%.items[%];", [es, es, iv]);
            this.cpl("let r% = this.e%.items[%];", [es, es, iv]);
        }
        match h.range {
            Option.Some(p) {
                if markup.uTrim(this.src[p.a.lo..p.a.hi]) != "0" {
                    this.upd.pad();
                    this.cus("let a% = ", [ks]);
                    this.expr(Mode.U, p.a)?;
                    this.upd.s(";\n");
                    this.cul("let % = a% + %;", [item, ks, iv]);
                }
            }
            Option.None {
                this.upd.pad();
                this.cus("let x% = ", [ks]);
                this.expr(Mode.U, h.expr)?;
                this.upd.s(";\n");
                this.cul("let % = %x%[%];", [item, if h.byRef { "&" } else { "" }, ks, iv]);
            }
        }
        return Result.Ok(true);
    }

    /// `<slot>` / `<slot name="x">fallback</slot>`: run the content the owner passed, else the fallback.
    fn slotElem(this: &G, e: &Elem, slot: string, depth: int): Result<bool, UiError> {
        let a = this.a;
        this.hasSlot = true;
        let name = "";
        let ni = cattr(e, "name");
        if ni >= 0 {
            match litValue(&e.attrs.items[ni].value) { Option.Some(v) { name = v; } Option.None {} }
        }
        let k = this.nk();
        let ks = num(a, k);
        let n = san(if name.len == 0 { "default" } else { name }, a);
        // every use of this component that fills this slot
        let calls = List<SlotUse>.new(a);
        for i in 0..this.slots.list.len {
            let s = &this.slots.list.items[i];
            if s.child == this.c.name && hasStr(&s.names, name) { calls.push(SlotUse { site: s.id, owner: s.owner }); }
        }
        for q in 0..2 {
            let o = this.out(if q == 0 { Mode.U } else { Mode.P });
            o.set(this.fi, e.open.lo, e.open.hi);
            o.line(cf(a, "let s% = d.enter(%);", [ks, slot]));
            if q == 0 && calls.len > 0 { o.line(cf(a, "this.slotNow% = true;", [ks])); }
            for i in 0..calls.len {
                let id = num(a, calls.items[i].site);
                o.line(cf(a, "%if this.slotSite == % {", [if i > 0 { "} else " } else { "" }, id]));
                o.ind += 1;
                o.line(cf(a, "((this.slotOwn as ptr) as &%).slot%_%_%(d, this.slotI);", [calls.items[i].owner, id, n, if q == 0 { "update" } else { "paint" }]));
                o.ind -= 1;
            }
            if calls.len > 0 {
                o.line("} else {");
                o.ind += 1;
            }
        }
        if calls.len > 0 { this.slotMarks.push(SlotMark { k: k, name: n, calls: calls }); }
        let j = 0;
        this.seq(&e.children, &j, depth, Option.None)?;
        for q in 0..2 {
            let o = this.out(if q == 0 { Mode.U } else { Mode.P });
            if calls.len > 0 {
                o.ind -= 1;
                o.line("}");
            }
            o.line(cf(a, "d.leave(s%);", [ks]));
        }
        return Result.Ok(true);
    }
}
