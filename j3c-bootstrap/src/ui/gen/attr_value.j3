// `bind:this`, `use:`, `bind:open`, ranges, media sources, aria and focus attributes, `name`, `value`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr_value.rs
// J3: C2e chunk D. One slice of the `attr` chain; true when it handled the attribute.
module j3c.ui.gen;

extend G {
    /// One attribute family: true when it handled `a` (`name` is the attribute name, `n` the node variable).
    fn attrValue(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if name == "bind:this" {
            let r = Range { lo: 0, hi: 0 };
            match a.value {
                Value.Expr(x) { r = x; }
                Value.None { return Result.Err(attrErr(a, "`bind:this` needs `={place}`, an `int` to write the element's handle to")); }
                Value.Str(_) { return Result.Err(attrErr(a, "`bind:this` needs `={place}`, an `int` to write the element's handle to")); }
            }
            this.placeCheck(r)?;
            this.upd.hint = BIND_HINT;
            this.upd.pad();
            this.expr(Mode.U, r)?;
            this.upd.s(" = d.handle(");
            this.upd.s(n);
            this.upd.s(");\n");
            this.upd.hint = "";
            let bl = 0;
            let bt = 0;
            if this.bases.len > 0 {
                let b = this.bases.items[this.bases.len - 1];
                bl = b.locals;
                bt = b.lets;
            }
            if bl == this.locals.len && bt == this.lets.len {
                let k = this.nk();
                let o = this.owner();
                let t = Text.new(this.a).add(o).add(".bh");
                t.pushInt(k);
                this.aLine(t.str(), " = d.handle(", this.aMsg(n, ");", ""));
                this.binds.push(BindDef { k: k, container: if this.own.len > 0 { this.own.items[this.own.len - 1] } else { 0 }, place: r });
            }
        } else if startsWith(name, "use:") {
            this.action(a, name[4..name.len], n)?;
        } else if name == "bind:open" {
            let r = Range { lo: 0, hi: 0 };
            match a.value {
                Value.Expr(x) { r = x; }
                Value.None { return Result.Err(attrErr(a, "`bind:open` needs `={place}`, a `bool` to write to")); }
                Value.Str(_) { return Result.Err(attrErr(a, "`bind:open` needs `={place}`, a `bool` to write to")); }
            }
            this.placeCheck(r)?;
            this.upd.hint = BIND_HINT;
            this.aWriteBack("userToggled", "isOpen", n, r)?;
            this.aCall("attrOpen", n, r)?;
            this.upd.hint = "";
        } else if name == "min" || name == "max" || name == "step" || name == "high" || (name == "value" && (isRange(e) || e.tag == "progress" || e.tag == "meter")) {
            let call = "attrValue";
            if name == "min" { call = "attrMin"; }
            else if name == "max" { call = "attrMax"; }
            else if name == "step" { call = "attrStep"; }
            else if name == "high" { call = "attrHigh"; }
            if name == "high" { this.aLine("d.attrMultiple(", n, ", true);"); }
            this.numAttr(a, call, n)?;
        } else if name == "alt" || name == "aria-label" {
            // nothing draws it; `j3.ui.a11y` reads it as the accessible name
            this.strAttr(a, "attrAria", n)?;
        } else if name == "role" {
            this.strAttr(a, "attrRole", n)?;
        } else if name == "aria-live" {
            // "polite", "assertive" or "off"; `j3.ui.a11y.liveChanges`
            this.strAttr(a, "attrLive", n)?;
        } else if name == "aria-describedby" {
            // ids are static names (`attrId`), so is this
            if !attrAllLit(a.value) {
                return Result.Err(attrErr(a, "aria-describedby= takes static ids").withHelp("write `aria-describedby=\"hint\"`, the `id=\"hint\"` of the element that describes this one (several ids separated by spaces)"));
            }
            this.strAttr(a, "attrDescBy", n)?;
        } else if name == "aria-selected" {
            this.upd.pad();
            this.aHead("attrSelected", n);
            match a.value {
                Value.None { this.upd.s("true"); }
                Value.Expr(r) { this.expr(Mode.U, r)?; }
                Value.Str(_) {
                    let l = "";
                    match attrOneLit(a.value) {
                        Option.Some(s) { l = s; }
                        Option.None {}
                    }
                    if l != "true" && l != "false" { return Result.Err(attrErr(a, "`aria-selected` takes `=\"true\"`, `=\"false\"` or `={condition}`")); }
                    this.upd.s(l);
                }
            }
            this.upd.s(");\n");
        } else if name == "focus-group" || startsWith(name, "nav-") {
            // gamepad / arrow-key focus (`j3.ui.padnav`): names of ids, so static like `for`
            let which = ", 4";
            if name == "focus-group" { which = ", 0"; }
            else if name == "nav-up" { which = ", 1"; }
            else if name == "nav-down" { which = ", 2"; }
            else if name == "nav-left" { which = ", 3"; }
            if !attrAllLit(a.value) {
                return Result.Err(attrErr(a, this.aMsg(name, "= takes a static string", "")).withHelp("write `nav-down=\"id\"`, the `id=\"name\"` of the element to focus; `focus-group=\"wrap trap arrows\"` takes any of the three words"));
            }
            this.strAttr(a, "attrNav", this.aMsg(n, which, ""))?;
        } else if name == "name" {
            this.strAttr(a, "attrName", n)?;
        } else if name == "value" && isRadio(e) {
            // a radio's value is read by its `bind:group`, which writes it into the variable
        } else if name == "value" || name == "placeholder" {
            this.strAttr(a, if name == "value" { "attrText" } else { "attrPlaceholder" }, n)?;
        } else {
            match mediaCode(name) {
                Option.Some(code) {
                    // `<img>` / `<svg>` / `<path>` data: `media.M_*` string kinds and `media.N_*` number kinds
                    let t = Text.new(this.a).add(n).add(", ");
                    t.pushInt(code.code);
                    this.upd.hint = "image and shape attributes are text (`src=\"a.png\"`) or `={expr}`; `frame`, `fps` and `stroke-width` take numbers";
                    if code.num { this.numAttr(a, "attrMediaNum", t.str())?; }
                    else { this.strAttr(a, "attrMedia", t.str())?; }
                    this.upd.hint = "";
                }
                Option.None { return Result.Ok(false); }
            }
        }
        return Result.Ok(true);
    }
}
