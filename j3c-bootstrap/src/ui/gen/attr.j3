// The attribute chain dispatcher (each family returns whether it handled one) and `class`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr.rs
// J3: C2e chunk D. Dispatch order is the contract: the first family that returns true wins.
// J3: Rust `format!` lines are runs of `upd.s` (adjacent glue merges into one segment either way); the
// small `a*` helpers here are shared by the `attr_*` parts. Rust `char::is_whitespace` / `str::trim` are
// the lexer's `isWhitespace` / `markup.uTrim` (Unicode White_Space, not just ASCII).
module j3c.ui.gen;

/// The help of every `bind:` that writes a place (Rust sets it as `upd.hint` around the copy).
const BIND_HINT: string = "`bind:` writes to the expression, so it must be assignable; props are read-only (bind to a field behind a prop, or to a `let`)";

/// An error at attribute `a`.
pub fn attrErr(a: &Attr, msg: string): UiError { return uiErr(a.range.lo, a.range.hi, msg); }

/// Element `e` has an attribute called `name`.
pub fn attrHas(e: &Elem, name: string): bool {
    for i in 0..e.attrs.len { if e.attrs.items[i].name == name { return true; } }
    return false;
}

/// The text of a quoted value that is exactly one literal part (Rust `[Part::Lit(l)]`).
pub fn attrOneLit(v: Value): Option<string> {
    match v {
        Value.Str(p) {
            if p.items.len != 1 { return Option.None; }
            match p.items.items[0] {
                Part.Lit(l) { return Option.Some(l); }
                Part.Hole(_) { return Option.None; }
            }
        }
        Value.None { return Option.None; }
        Value.Expr(_) { return Option.None; }
    }
    return Option.None;
}

/// A quoted value without `{holes}` (an empty one too).
pub fn attrAllLit(v: Value): bool {
    match v {
        Value.Str(p) {
            for i in 0..p.items.len {
                match p.items.items[i] {
                    Part.Lit(_) {}
                    Part.Hole(_) { return false; }
                }
            }
            return true;
        }
        Value.None { return false; }
        Value.Expr(_) { return false; }
    }
    return false;
}

pub fn attrIsNone(v: Value): bool {
    match v {
        Value.None { return true; }
        Value.Expr(_) { return false; }
        Value.Str(_) { return false; }
    }
    return false;
}

extend G {
    /// `upd.line` of the three pieces joined.
    fn aLine(this: &G, p1: string, p2: string, p3: string) {
        this.upd.pad();
        this.upd.s(p1);
        this.upd.s(p2);
        this.upd.s(p3);
        this.upd.s("\n");
    }

    /// An arena string of the three pieces (an error message outlives the frame).
    fn aMsg(this: &G, p1: string, p2: string, p3: string): string { return Text.new(this.a).add(p1).add(p2).add(p3).str(); }

    /// `d.<call>(<n>, <expr r>);` as one line.
    fn aCall(this: &G, call: string, n: string, r: Range): Result<bool, UiError> {
        this.upd.pad();
        this.aHead(call, n);
        this.expr(Mode.U, r)?;
        this.upd.s(");\n");
        return Result.Ok(true);
    }

    /// `d.<call>(<n>, ` (no indent).
    fn aHead(this: &G, call: string, n: string) {
        this.upd.s("d.");
        this.upd.s(call);
        this.upd.s("(");
        this.upd.s(n);
        this.upd.s(", ");
    }

    /// `d.<call>(<n>, true|<condition>);`; a quoted value is the error `msg`.
    fn aFlag(this: &G, a: &Attr, call: string, n: string, msg: string): Result<bool, UiError> {
        this.upd.pad();
        this.aHead(call, n);
        match a.value {
            Value.None { this.upd.s("true"); }
            Value.Expr(r) { this.expr(Mode.U, r)?; }
            Value.Str(_) { return Result.Err(attrErr(a, msg)); }
        }
        this.upd.s(");\n");
        return Result.Ok(true);
    }

    /// `if d.<test>(<n>) {` + `<place> = d.<get>(<n>);` + `}`: the write-back half of a `bind:`.
    fn aWriteBack(this: &G, test: string, get: string, n: string, r: Range): Result<bool, UiError> {
        this.aLine(Text.new(this.a).add("if d.").add(test).add("(").str(), n, ") {");
        this.upd.ind += 1;
        this.upd.pad();
        this.expr(Mode.U, r)?;
        this.upd.s(" = d.");
        this.upd.s(get);
        this.upd.s("(");
        this.upd.s(n);
        this.upd.s(");\n");
        this.upd.ind -= 1;
        this.upd.line("}");
        return Result.Ok(true);
    }

    /// One attribute of element `e` on node variable `n` (called by chunk C's `elem`).
    fn attr(this: &G, e: &Elem, a: &Attr, n: string): Result<bool, UiError> {
        let name = a.name;
        // The slices run in the order of the old else-if chain; the first that matches wins.
        if this.attrClass(e, a, n, name)? { return Result.Ok(true); }
        if this.attrElem(e, a, n, name)? { return Result.Ok(true); }
        if this.attrValue(e, a, n, name)? { return Result.Ok(true); }
        if this.attrExtra(e, a, n, name)? { return Result.Ok(true); }
        if this.attrBind(e, a, n, name)? { return Result.Ok(true); }
        this.attrEvent(e, a, n, name)?;
        return Result.Ok(true);
    }

    /// One finished word of a `class` value: a lone literal is a static class, anything else joins `dynp`.
    fn classWord(this: &G, word: &List<Part>, dynp: &List<Part>, n: string) {
        if word.len == 1 {
            match word.items[0] {
                Part.Lit(w) {
                    let f = this.cls(w);
                    this.aLine("d.clsId(", Text.new(this.a).add(n).add(", ").add(f).str(), ");");
                    word.clear();
                    return;
                }
                Part.Hole(_) {}
            }
        }
        if word.len > 0 {
            if dynp.len > 0 { dynp.push(Part.Lit(" ")); }
            for i in 0..word.len { dynp.push(word.items[i]); }
        }
        word.clear();
    }

    /// `class="a b{x}"`: whole literal words are static; a word with a `{hole}` is joined into one dynamic text.
    fn classText(this: &G, a: &Attr, p: &List<Part>, n: string): Result<bool, UiError> {
        let dynp = List<Part>.new(this.a);
        let word = List<Part>.new(this.a);
        let buf = Text.new(this.a);
        // Rust chains a `Lit(" ")` after the parts: the last word ends there
        for pi in 0..p.len + 1 {
            let part = if pi < p.len { p.items[pi] } else { Part.Lit(" ") };
            match part {
                Part.Hole(_) {
                    if buf.len() > 0 {
                        word.push(Part.Lit(buf.str()));
                        buf = Text.new(this.a);
                    }
                    word.push(part);
                }
                Part.Lit(l) {
                    let i = 0;
                    while i < l.len {
                        let (cp, w) = text.decodeRune(l, i);
                        if !isWhitespace(cp) {
                            buf.pushStr(l[i..i + w]);
                            i += w;
                            continue;
                        }
                        i += w;
                        if buf.len() > 0 {
                            word.push(Part.Lit(buf.str()));
                            buf = Text.new(this.a);
                        }
                        this.classWord(&word, &dynp, n);
                    }
                }
            }
        }
        if dynp.len > 0 {
            this.upd.pad();
            this.upd.s("d.clsDyn(");
            this.upd.s(n);
            this.upd.s(", ");
            this.strParts(Mode.U, &dynp, a.range)?;
            this.upd.s(");\n");
        }
        return Result.Ok(true);
    }

    /// `class`, `class:name`, `style:prop`, the boolean flags, overlays, panels, drag attributes, `menuitem`.
    fn attrClass(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if name == "class" {
            match a.value {
                Value.Str(p) { this.classText(a, &p.items, n)?; }
                Value.None {}
                Value.Expr(_) {
                    return Result.Err(attrErr(a, "`class` takes text").withHelp("`class=\"a b{x}\"`; switch a class with `class:name={condition}`"));
                }
            }
        } else if startsWith(name, "style:") {
            this.styleAttr(e, a, name[6..name.len], n)?;
        } else if startsWith(name, "class:") {
            match a.value {
                Value.Expr(r) {
                    let f = this.cls(name[6..name.len]);
                    this.upd.pad();
                    this.upd.s("d.clsIfId(");
                    this.upd.s(n);
                    this.upd.s(", ");
                    this.upd.s(f);
                    this.upd.s(", ");
                    this.expr(Mode.U, r)?;
                    this.upd.s(");\n");
                }
                Value.None { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs a condition")).withHelp(this.aMsg(name, "={condition}", ""))); }
                Value.Str(_) { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs a condition")).withHelp(this.aMsg(name, "={condition}", ""))); }
            }
        } else if name == "disabled" || name == "checked" || name == "multiple" {
            let call = "attrChecked";
            if name == "disabled" { call = "attrDisabled"; }
            else if name == "multiple" { call = "attrMultiple"; }
            else if isRadio(e) { call = "attrRadio"; }
            this.aFlag(a, call, n, this.aMsg("`", name, "` takes `{condition}`"))?;
        } else if name == "popover" || name == "modal" {
            // an overlay: the element is in the tree while it is open (`{#if open}`)
            let kind = if name == "modal" { "1" } else { "2" };
            let one = "";
            match attrOneLit(a.value) {
                Option.Some(l) { one = l; }
                Option.None {}
            }
            if name == "popover" && one == "context" { this.aLine("d.attrContext(", n, ");"); return Result.Ok(true); }
            if name == "popover" && one == "caret" { this.aLine("d.attrCaret(", n, ");"); return Result.Ok(true); }
            match a.value {
                Value.None { this.aLine("d.attrOverlay(", Text.new(this.a).add(n).add(", ").add(kind).str(), ");"); }
                Value.Expr(r) {
                    this.upd.pad();
                    this.upd.s("if ");
                    this.expr(Mode.U, r)?;
                    this.upd.s(" { d.attrOverlay(");
                    this.upd.s(n);
                    this.upd.s(", ");
                    this.upd.s(kind);
                    this.upd.s("); }\n");
                }
                Value.Str(_) { return Result.Err(attrErr(a, this.aMsg("`", name, "` takes `{condition}`"))); }
            }
        } else if name == "panel" {
            // a draggable panel; `panel="dock"` lets it snap to the workspace edges
            if attrIsNone(a.value) { this.aLine("d.attrPanel(", n, ", \"\");"); }
            else { this.strAttr(a, "attrPanel", n)?; }
        } else if name == "panel-handle" || name == "panel-resize" {
            if !attrIsNone(a.value) { return Result.Err(attrErr(a, this.aMsg("`", name, "` takes no value"))); }
            // dom.PK_HANDLE / PK_GRIP
            this.aLine("d.attrPanelRole(", n, if name == "panel-handle" { ", 2);" } else { ", 3);" });
        } else if name == "window-drag" {
            // a client-side title bar: the box moves the window (`j3.ui.windrag`)
            if !attrIsNone(a.value) { return Result.Err(attrErr(a, "`window-drag` takes no value")); }
            this.aLine("d.attrWindowDrag(", n, ");");
        } else if name == "draggable" {
            this.aFlag(a, "attrDraggable", n, "`draggable` takes `{condition}`")?;
        } else if name == "drag-data" || name == "drag-id" || name == "drag-ghost" {
            if !attrHas(e, "draggable") { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `draggable` on the same element"))); }
            if name == "drag-data" {
                this.strAttr(a, "attrDragData", n)?;
            } else if name == "drag-ghost" {
                let none = false;
                match attrOneLit(a.value) {
                    Option.Some(l) { none = l == "none"; }
                    Option.None {}
                }
                if !none {
                    return Result.Err(attrErr(a, "`drag-ghost` takes only `\"none\"`").withHelp("the page paints its own drag image; leave the attribute out for the default ghost"));
                }
                this.strAttr(a, "attrDragGhost", n)?;
            } else {
                match a.value {
                    Value.Expr(r) { this.aCall("attrDragId", n, r)?; }
                    Value.None { return Result.Err(attrErr(a, "`drag-id` needs `={integer}`")); }
                    Value.Str(_) { return Result.Err(attrErr(a, "`drag-id` needs `={integer}`")); }
                }
            }
        } else if name == "menuitem" {
            if !attrIsNone(a.value) { return Result.Err(attrErr(a, "`menuitem` takes no value")); }
            this.aLine("d.attrMenuItem(", n, ");");
        } else {
            return Result.Ok(false);
        }
        return Result.Ok(true);
    }
}
