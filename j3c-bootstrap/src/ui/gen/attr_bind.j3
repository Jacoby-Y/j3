// `bind:group`, `bind:checked` / `value` / `high`, `bind:scrollX` / `scrollY`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr_bind.rs
// J3: C2e chunk D. One slice of the `attr` chain; true when it handled the attribute.
module j3c.ui.gen;

extend G {
    /// One attribute family: true when it handled `a` (`name` is the attribute name, `n` the node variable).
    fn attrBind(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if name == "bind:group" {
            this.bindGroup(e, a, n)?;
        } else if name == "bind:checked" || name == "bind:value" || name == "bind:high" {
            let r = Range { lo: 0, hi: 0 };
            match a.value {
                Value.Expr(x) { r = x; }
                Value.None { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={place}`, a name, field, or index to write to"))); }
                Value.Str(_) { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={place}`, a name, field, or index to write to"))); }
            }
            this.placeCheck(r)?;
            this.upd.hint = BIND_HINT;
            if name == "bind:checked" && isRadio(e) {
                // a radio flips by itself (and its group-mates with it): write back every one that flipped
                this.aWriteBack("userToggled", "isChecked", n, r)?;
                this.aCall("attrRadio", n, r)?;
            } else if name == "bind:checked" {
                this.aLine("if d.clicked(", n, ") {");
                this.upd.ind += 1;
                this.upd.pad();
                this.expr(Mode.U, r)?;
                this.upd.s(" = !");
                this.expr(Mode.U, r)?;
                this.upd.s(";\n");
                this.upd.ind -= 1;
                this.upd.line("}");
                this.aCall("attrChecked", n, r)?;
            } else {
                // a range binds a number, anything else (text, search, color, select) a string
                let get = "strValue";
                let set = "attrText";
                if name == "bind:high" {
                    get = "highValue";
                    set = "attrHigh";
                } else if isRange(e) {
                    get = "value";
                    set = "attrValue";
                } else {
                    match inputType(e) {
                        Option.Some(_) {}
                        Option.None { return Result.Err(attrErr(a, "`bind:value` needs a literal `type` (`type=\"text\"`), so the compiler knows what it binds")); }
                    }
                }
                if name == "bind:high" { this.aLine("d.attrMultiple(", n, ", true);"); }
                this.aWriteBack("changed", get, n, r)?;
                this.aCall(set, n, r)?;
            }
            this.upd.hint = "";
        } else if name == "bind:scrollX" || name == "bind:scrollY" {
            let r = Range { lo: 0, hi: 0 };
            match a.value {
                Value.Expr(x) { r = x; }
                Value.None { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={place}`, an `f32` offset in px"))); }
                Value.Str(_) { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={place}`, an `f32` offset in px"))); }
            }
            this.placeCheck(r)?;
            this.upd.hint = BIND_HINT;
            this.upd.pad();
            this.expr(Mode.U, r)?;
            this.upd.s(" = d.bindScroll(");
            this.upd.s(n);
            this.upd.s(", ");
            this.expr(Mode.U, r)?;
            this.upd.s(if name == "bind:scrollX" { ", true);\n" } else { ", false);\n" });
            this.upd.hint = "";
        } else {
            return Result.Ok(false);
        }
        return Result.Ok(true);
    }
}
