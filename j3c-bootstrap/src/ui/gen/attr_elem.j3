// Attributes of specific elements: tabindex, grid, ids, `for`, `type`, meter, `open`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr_elem.rs
// J3: C2e chunk D. One slice of the `attr` chain; true when it handled the attribute.
// J3: `tabindex={expr}` writes no indent before `d.attrTabIndexN(` (Rust has no `pad()` there): kept.
module j3c.ui.gen;

extend G {
    /// One attribute family: true when it handled `a` (`name` is the attribute name, `n` the node variable).
    fn attrElem(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if name == "tabindex" {
            // focusable like a button: -1 skips Tab, 0 is tree order, a positive integer goes first (ascending); `={expr}` is an int
            let bad = "`tabindex` takes `-1`, `0`, a positive integer or `={int}`";
            match a.value {
                Value.Expr(r) {
                    this.aHead("attrTabIndexN", n);
                    this.expr(Mode.U, r)?;
                    this.upd.s(");\n");
                }
                Value.None { this.aLine("d.attrTabIndex(", n, ");"); }
                Value.Str(_) {
                    let v = -2;
                    match attrOneLit(a.value) {
                        Option.Some(l) {
                            match text.parseInt(uTrim(l), 10) {
                                Option.Some(x) { v = x; }
                                Option.None {}
                            }
                        }
                        Option.None {}
                    }
                    if v < -1 { return Result.Err(attrErr(a, bad)); }
                    if v == -1 { this.aLine("d.attrTabIndexOff(", n, ");"); }
                    else if v == 0 { this.aLine("d.attrTabIndex(", n, ");"); }
                    else {
                        let t = Text.new(this.a).add(n).add(", ");
                        t.pushInt(v);
                        this.aLine("d.attrTabIndexN(", t.str(), ");");
                    }
                }
            }
        } else if name == "grid" {
            // the window's data grid (`j3.ui.grid`): `grid={g.sized(rows.len)}`, a `&Grid`, on the `virtual` scroll box
            let bad = "`grid` needs `={g.sized(rows.len)}`, a `&Grid` (`j3.ui.gridstate.Grid`)";
            match a.value {
                Value.Expr(r) {
                    if !attrHas(e, "virtual") { return Result.Err(attrErr(a, "`grid` goes on the `virtual` scroll box (`<div virtual row-height={h} grid={..}>`)")); }
                    this.aCall("gridBind", n, r)?;
                }
                Value.None { return Result.Err(attrErr(a, bad)); }
                Value.Str(_) { return Result.Err(attrErr(a, bad)); }
            }
        } else if name == "autoselect" || name == "default" {
            // bare flags: the dialog selects its first text box when it opens; the button Enter clicks (`Dom.attrFlag`)
            if !attrIsNone(a.value) { return Result.Err(attrErr(a, this.aMsg("`", name, "` takes no value"))); }
            this.aLine("d.attrFlag(", n, if name == "default" { ", 3);" } else { ", 1);" });
        } else if name == "closedby" {
            this.strAttr(a, "attrClosedBy", n)?;
        } else if name == "title" {
            this.strAttr(a, "attrTitle", n)?;
        } else if name == "left" || name == "top" {
            this.numAttr(a, if name == "left" { "attrLeft" } else { "attrTop" }, n)?;
        } else if name == "id" {
            this.strAttr(a, "attrId", n)?;
        } else if name == "for" {
            // an id is a static name (`attrId`), so the label's target is one too
            if !attrAllLit(a.value) { return Result.Err(attrErr(a, "for= takes a static id").withHelp("write `for=\"name\"`, the `id=\"name\"` of the control")); }
            this.strAttr(a, "attrFor", n)?;
        } else if name == "type" {
            this.strAttr(a, "attrType", n)?;
        } else if name == "maxlength" || name == "rows" {
            this.numAttr(a, if name == "rows" { "attrRows" } else { "attrMaxLen" }, n)?;
        } else if e.tag == "meter" && (name == "low" || name == "high" || name == "optimum") {
            // `Dom.attrMeter`: 0 low, 1 high, 2 optimum
            let which = if name == "low" { ", 0" } else if name == "high" { ", 1" } else { ", 2" };
            this.numAttr(a, "attrMeter", this.aMsg(n, which, ""))?;
        } else if name == "open" {
            this.aFlag(a, "attrOpen", n, "`open` takes `={condition}` or no value")?;
        } else {
            return Result.Ok(false);
        }
        return Result.Ok(true);
    }
}
