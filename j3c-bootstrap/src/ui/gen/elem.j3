// One element: create, attributes, children; transitions, `virtual`. Icons, `style:`, `use:` actions and the
// string / number attribute helpers are `elem_icon.j3`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/elem.rs
// J3: C2e chunk C. `flip_rows.contains(&addr(e))` is `flipRows` holding `e.uid`; `pass_root == addr(e)` is
// `passRoot == e.uid`. Rust `parse::<f64>().is_ok()` ("is a number") is `text.parseF64` (same grammar:
// `inf`, `nan`, `1e3`, `+1`, `.5`, `1.`). The two directions of `transitions` are plain locals (`dk0` / `dk1`
// kind, 0 = none; `dr0` / `dr1` the `={ms}` range), Rust's `[Option<(usize, Value)>; 2]`.
module j3c.ui.gen;

const TRANS_KINDS: [4]string = ["fade", "fly", "slide", "scale"];
const TRANS_EASE: [7]string = ["ease", "linear", "ease-in", "ease-out", "ease-in-out", "bounce", "spring"];

/// `xs` joined with `sep` (Rust `join` on a const array).
fn joinArr(a: &Arena, xs: []string, sep: string): string {
    let t = Text.new(a);
    for i in 0..xs.len {
        if i > 0 { t.add(sep); }
        t.add(xs[i]);
    }
    return t.str();
}

/// Where a "takes no children" error points: the first child when it is an element, else the open tag.
fn firstChildAt(e: &Elem): Range {
    match e.children.items[0] {
        Node.Elem(x) { return x.open; }
        Node.Let(_) {}
        Node.Text(_) {}
        Node.If(_) {}
        Node.Each(_) {}
    }
    return e.open;
}

/// The trimmed text is a number (Rust `l.trim().parse::<f64>().is_ok()`).
fn isNumber(l: string): bool {
    match text.parseF64(markup.uTrim(l)) {
        Option.Some(_) { return true; }
        Option.None { return false; }
    }
    return false;
}

/// The value of a number setting of `virtual` (Rust closure `num`).
fn virtValue(at: &Attr, what: string, a: &Arena): Result<Value, UiError> {
    match at.value {
        Value.Expr(_) { return Result.Ok(at.value); }
        Value.Str(_) {
            match oneLit(&at.value) {
                Option.Some(l) { if isNumber(l) { return Result.Ok(at.value); } }
                Option.None {}
            }
        }
        Value.None {}
    }
    return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs a number: `%={26}`", [what, what])));
}

extend G {
    /// An element at child slot expression `slot`.
    fn elem(this: &G, e: &Elem, slot: string, depth: int): Result<bool, UiError> {
        let a = this.a;
        if e.tag == "option" { optionVisuals(&e.children)?; }
        if !inList(ELEMENTS[0..ELEMENTS.len], e.tag) {
            return Result.Err(uiErr(e.open.lo, e.open.lo + 1 + e.tag.len, cf(a, "unknown element `<%>`", [e.tag])).withHelp(cf(a, "elements: %. A capitalised tag is a component (ui/Name.j3ui).", [joinArr(a, ELEMENTS[0..ELEMENTS.len], " ")])));
        }
        let k = this.nk();
        let ks = num(a, k);
        let n = cf(a, "n%", [ks]);
        let tag = this.tag(e.tag);
        this.upd.set(this.fi, e.open.lo, e.open.hi);
        this.cul("let % = d.open(%, %, SCOPE_%);", [n, slot, tag, this.c.id]);
        let acc = accepted(e.tag, a);
        let draw: Option<Range> = Option.None;
        // `bind:spans` runs after every other attribute: replacing the text drops the box's spans, so the spans must come last
        let spans = -1;
        this.virtualAttrs(e, n)?;
        this.transitions(e, n)?;
        for i in 0..e.attrs.len {
            let at = &e.attrs.items[i];
            let nm = at.name;
            let ok = hasStr(&acc, nm) || (startsWith(nm, "use:") && nm.len > 4) || (startsWith(nm, "class:") && nm.len > 6) || (startsWith(nm, "style:") && nm.len > 6);
            if nm == "slot" && this.slots.slotted.has(e.uid) { continue; } // goes to the parent component's slot
            if (e.tag == "glyph" && (nm == "action" || nm == "key" || nm == "pad")) || (e.tag == "icon" && nm == "name") { continue; } // read by the `glyph` / `icon` arm below
            if nm == "virtual" || nm == "row-height" || nm == "est-height" || nm == "stick-to-bottom" || nm == "keep" || nm == "bind:at-end" { continue; } // read by `virtualAttrs`
            if nm == "fly-x" || nm == "fly-y" || nm == "scale-from" || nm == "slide-axis" || nm == "transition-easing" || startsWith(nm, "transition:") || startsWith(nm, "in:") || startsWith(nm, "out:") { continue; } // read by `transitions`
            if nm == "animate-easing" {
                if cattr(e, "animate:flip") < 0 { return Result.Err(uiErr(at.range.lo, at.range.hi, "`animate-easing` needs `animate:flip` on the same element")); }
                continue; // read with `animate:flip`
            }
            if nm == "animate:flip" && !this.flipRows.contains(e.uid) {
                let why = if this.inVirt > 0 { "a `virtual` list scrolls its rows, which would flip" } else { "it must be the row element of a keyed `{#each}`" };
                return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`animate:flip` is not allowed here: %", [why])).withHelp("`{#each items as it (it.id)}<li animate:flip={200}>...</li>{/each}`"));
            }
            if !ok {
                return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "unknown attribute `%` on `<%>`", [nm, e.tag])).withHelp(cf(a, "`<%>` accepts: %", [e.tag, joinStr(a, &acc, ", ")])));
            }
            this.upd.set(this.fi, at.range.lo, at.range.hi);
            if nm == "on:draw" {
                match at.value {
                    Value.Expr(r) { draw = Option.Some(r); }
                    Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, "`on:draw` needs `={ statements }`")); }
                    Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, "`on:draw` needs `={ statements }`")); }
                }
                continue;
            }
            if nm == "bind:spans" {
                spans = i;
                continue;
            }
            this.attr(e, at, n)?;
        }
        if spans >= 0 {
            let at = &e.attrs.items[spans];
            this.upd.set(this.fi, at.range.lo, at.range.hi);
            this.attr(e, at, n)?;
        }
        if e.tag == "progress" || e.tag == "meter" {
            // gauges: no `value` is an indeterminate progress (-1), `max` is 1 like a browser's
            if e.children.len > 0 {
                let at = firstChildAt(e);
                return Result.Err(uiErr(at.lo, at.hi, cf(a, "`<%>` is painted by the runtime and takes no children", [e.tag])));
            }
            if e.tag == "progress" && cattr(e, "value") < 0 { this.cul("d.attrValue(%, -1.0);", [n]); }
            if cattr(e, "max") < 0 { this.cul("d.attrMax(%, 1.0);", [n]); }
        } else if e.tag == "glyph" {
            // an input prompt: the runtime picks the label for the device in use (`dom/glyph.j3`)
            this.glyph(e, n)?;
        } else if e.tag == "icon" {
            // a vector icon: only the named icons' data is copied in (`ui/icons.j3`, `Dom.attrIcon`)
            this.icon(e, n)?;
        } else if e.tag == "summary" {
            // the disclosure button: focusable, Enter / Space click it (`inputs.begin` flips the `<details>`)
            this.cul("d.attrTabIndex(%);", [n]);
        }
        if this.passRoot == e.uid { this.passApply(e, n); }
        // paint
        this.pnt.set(this.fi, e.open.lo, e.open.hi);
        this.cpl("let % = d.paintNext(%);", [n, slot]);
        this.cpl("if % >= 0 {", [n]);
        this.pnt.ind += 1;
        this.cpl("d.paintBox(%);", [n]);
        if e.tag == "canvas" {
            match draw {
                Option.Some(r) {
                    let size = cf(a, "size%", [ks]);
                    this.cpl("if d.beginCanvas(%) {", [n]);
                    this.pnt.ind += 1;
                    this.cpl("let % = d.size(%);", [size, n]);
                    this.rename.insert(0, Rename { from: "size", to: size });
                    this.locals.push(size);
                    this.stmts(Mode.P, r, false)?;
                    this.locals.len -= 1;
                    this.rename.remove(0);
                    this.cpl("d.endCanvas(%);", [n]);
                    this.pnt.ind -= 1;
                    this.pnt.line("}");
                }
                Option.None {}
            }
        }
        this.cpl("let pass% = 0;", [ks]);
        this.cpl("while d.paintChildren(pass%) {", [ks]);
        this.pnt.ind += 1;
        let j = 0;
        this.seq(&e.children, &j, depth, Option.None)?;
        this.cpl("pass% += 1;", [ks]);
        this.pnt.ind -= 1;
        this.pnt.line("}");
        this.pnt.set(this.fi, e.open.lo, e.open.hi);
        this.cpl("d.paintEnd(%);", [n]);
        this.pnt.ind -= 1;
        this.pnt.line("}");
        this.upd.set(this.fi, e.open.lo, e.open.hi);
        this.upd.line("d.close();");
        return Result.Ok(true);
    }

    /// `<glyph action= key= pad=>` (the `"glyph"` arm of Rust `elem`).
    fn glyph(this: &G, e: &Elem, n: string): Result<bool, UiError> {
        let a = this.a;
        if e.children.len > 0 {
            let at = firstChildAt(e);
            return Result.Err(uiErr(at.lo, at.hi, "`<glyph>` is filled by the runtime and takes no children"));
        }
        let act = cattr(e, "action");
        if act < 0 && cattr(e, "key") < 0 && cattr(e, "pad") < 0 {
            return Result.Err(uiErr(e.open.lo, e.open.hi, "`<glyph>` needs `action=\"confirm\"`, or `key=\"Space\"` and/or `pad=\"x\"`"));
        }
        if act >= 0 {
            let at = &e.attrs.items[act];
            match oneLit(&at.value) {
                Option.Some(l) {
                    if !inList(GLYPH_ACTIONS[0..GLYPH_ACTIONS.len], l) {
                        return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "unknown glyph action `%`", [l])).withHelp(cf(a, "built-in actions: %; a game's own action needs `key=` / `pad=` or `d.setGlyphBinding`", [joinArr(a, GLYPH_ACTIONS[0..GLYPH_ACTIONS.len], " ")])));
                    }
                }
                Option.None {}
            }
        }
        this.upd.set(this.fi, e.open.lo, e.open.hi);
        this.upd.pad();
        this.cus("d.glyph(%", [n]);
        let names: [3]string = ["action", "key", "pad"];
        for q in 0..3 {
            this.upd.s(", ");
            let i = cattr(e, names[q]);
            if i < 0 {
                this.upd.s("\"\"");
                continue;
            }
            let at = &e.attrs.items[i];
            match at.value {
                Value.Str(p) { this.strParts(Mode.U, &p.items, at.range)?; }
                Value.Expr(r) { this.expr(Mode.U, r)?; }
                Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs a value", [names[q]]))); }
            }
        }
        this.upd.s(");\n");
        return Result.Ok(true);
    }

    /// `transition:` / `in:` / `out:` (fade, fly, slide, scale) and their parameters become one `d.trans(...)` call.
    /// Kinds are `Trans.ik` / `ok` in `j3.ui.dom`: 0 none, 1 fade, 2 fly, 3 slide, 4 scale.
    fn transitions(this: &G, e: &Elem, n: string): Result<bool, UiError> {
        let a = this.a;
        let dk0 = 0; // enter
        let dk1 = 0; // leave
        let dr0: Option<Range> = Option.None;
        let dr1: Option<Range> = Option.None;
        for i in 0..e.attrs.len {
            let at = &e.attrs.items[i];
            let rest = "";
            let ins = false;
            let outs = false;
            if startsWith(at.name, "transition:") { rest = at.name[11..at.name.len]; ins = true; outs = true; }
            else if startsWith(at.name, "in:") { rest = at.name[3..at.name.len]; ins = true; }
            else if startsWith(at.name, "out:") { rest = at.name[4..at.name.len]; outs = true; }
            else { continue; }
            let k = -1;
            for q in 0..4 { if TRANS_KINDS[q] == rest { k = q; break; } }
            if k < 0 { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "unknown transition `%`: use fade, fly, slide or scale", [rest]))); }
            let vr: Option<Range> = Option.None;
            match at.value {
                Value.None {}
                Value.Expr(r) { vr = Option.Some(r); }
                Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` takes `={milliseconds}`", [at.name]))); }
            }
            let rep = "`%` repeats the % transition of this element: use `transition:` for both directions, or one `in:` and one `out:`";
            if ins {
                if dk0 != 0 { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, rep, [at.name, "enter"]))); }
                dk0 = k + 1;
                dr0 = vr;
            }
            if outs {
                if dk1 != 0 { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, rep, [at.name, "leave"]))); }
                dk1 = k + 1;
                dr1 = vr;
            }
        }
        let none = dk0 == 0 && dk1 == 0;
        let pnames: [5]string = ["fly-x", "fly-y", "scale-from", "slide-axis", "transition-easing"];
        let pkinds: [5]int = [2, 2, 4, 3, 0];
        for q in 0..5 {
            let i = cattr(e, pnames[q]);
            if i < 0 { continue; }
            let at = &e.attrs.items[i];
            let kind = pkinds[q];
            if kind == 0 && none { return Result.Err(uiErr(at.range.lo, at.range.hi, "`transition-easing` needs `transition:`, `in:` or `out:` on the same element")); }
            if kind != 0 && dk0 != kind && dk1 != kind {
                return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` needs a `%` transition on the same element", [pnames[q], TRANS_KINDS[kind - 1]])));
            }
        }
        if none { return Result.Ok(true); }
        let ease = -1;
        let ei = cattr(e, "transition-easing");
        if ei >= 0 {
            let l = "";
            match oneLit(&e.attrs.items[ei].value) { Option.Some(v) { l = v; } Option.None {} }
            for q in 0..7 { if TRANS_EASE[q] == l { ease = q; break; } }
            if ease < 0 {
                let r = e.attrs.items[ei].range;
                return Result.Err(uiErr(r.lo, r.hi, "`transition-easing` takes one of \"ease\", \"linear\", \"ease-in\", \"ease-out\", \"ease-in-out\", \"bounce\", \"spring\""));
            }
        }
        let axis = 0;
        let ai = cattr(e, "slide-axis");
        if ai >= 0 {
            let l = "";
            match oneLit(&e.attrs.items[ai].value) { Option.Some(v) { l = v; } Option.None {} }
            if l == "x" { axis = 1; }
            else if l != "y" {
                let r = e.attrs.items[ai].range;
                return Result.Err(uiErr(r.lo, r.hi, "`slide-axis` takes \"x\" or \"y\""));
            }
        }
        this.upd.pad();
        this.cus("d.trans(%", [n]);
        this.transDir(dk0, dr0)?;
        this.transDir(dk1, dr1)?;
        this.cus(", %", [num(a, ease)]);
        let fnames: [3]string = ["fly-x", "fly-y", "scale-from"];
        let fdefs: [3]string = ["0.0", "20.0", "0.5"];
        for q in 0..3 {
            this.upd.s(", ");
            let i = cattr(e, fnames[q]);
            if i < 0 {
                this.upd.s(fdefs[q]);
                continue;
            }
            let at = &e.attrs.items[i];
            match at.value {
                Value.Expr(r) {
                    this.upd.set(this.fi, at.range.lo, at.range.hi);
                    this.upd.s("f32(");
                    this.expr(Mode.U, r)?;
                    this.upd.s(")");
                }
                Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` takes `={number}`", [fnames[q]]))); }
                Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "`%` takes `={number}`", [fnames[q]]))); }
            }
        }
        this.cus(", %);\n", [num(a, axis)]);
        return Result.Ok(true);
    }

    /// One direction of `d.trans`: `, kind, milliseconds`.
    fn transDir(this: &G, kind: int, ms: Option<Range>): Result<bool, UiError> {
        if kind == 0 {
            this.upd.s(", 0, 0.0");
            return Result.Ok(true);
        }
        this.cus(", %, ", [num(this.a, kind)]);
        match ms {
            Option.Some(r) {
                this.upd.s("f32(");
                this.expr(Mode.U, r)?;
                this.upd.s(")");
            }
            Option.None { this.upd.s("150.0"); }
        }
        return Result.Ok(true);
    }

    /// `virtual` on a scroll box: its one child must be a keyed `{#each}`, which `each` then lowers to the rows
    /// near the viewport. `row-height={26}` makes every row that tall; without it (or `row-height="auto"`) rows
    /// are measured, starting from `est-height={40}`. `stick-to-bottom`, `keep={keys}` and
    /// `bind:at-end={place}` are described in `j3c doc j3ui`.
    fn virtualAttrs(this: &G, e: &Elem, n: string): Result<bool, UiError> {
        let a = this.a;
        let vi = cattr(e, "virtual");
        if vi < 0 {
            let need: [5]string = ["row-height", "est-height", "stick-to-bottom", "keep", "bind:at-end"];
            for q in 0..5 {
                let i = cattr(e, need[q]);
                if i >= 0 {
                    let r = e.attrs.items[i].range;
                    return Result.Err(uiErr(r.lo, r.hi, cf(a, "`%` needs `virtual` on the same element", [need[q]])));
                }
            }
            return Result.Ok(true);
        }
        let va = e.attrs.items[vi].range;
        if e.comp { return Result.Err(uiErr(va.lo, va.hi, "`virtual` goes on a plain element (the scroll box), not a component")); }
        let list = false; // one child, an `{#each}` with a key over a list
        let one = false;
        if e.children.len == 1 {
            match e.children.items[0] {
                Node.Each(h) {
                    one = true;
                    match parseEachHead(this.src, h.head, a) {
                        Result.Ok(hd) {
                            match hd.key { Option.Some(_) { list = true; } Option.None {} }
                            match hd.range { Option.Some(_) { list = false; } Option.None {} }
                        }
                        Result.Err(_) {}
                    }
                }
                Node.Let(_) {}
                Node.Text(_) {}
                Node.Elem(_) {}
                Node.If(_) {}
            }
        }
        if !one {
            return Result.Err(uiErr(va.lo, va.hi, "a `virtual` element holds exactly one child, a keyed `{#each}`").withHelp("`<div virtual row-height={26}>{#each rows as r (r.id)} ... {/each}</div>`, with nothing else inside"));
        }
        if !list {
            return Result.Err(uiErr(va.lo, va.hi, "the `{#each}` in a `virtual` element needs a key and a list").withHelp("`{#each rows as r (r.id)}`; a `0..n` range has no list to window"));
        }
        let styles = 0;
        for i in 0..e.attrs.len { if startsWith(e.attrs.items[i].name, "style:") { styles += 1; } }
        if styles > 6 { return Result.Err(uiErr(va.lo, va.hi, "a `virtual` element takes at most 6 `style:` attributes (two are its spacers)")); }
        // `row-height="auto"` is the same as no `row-height`
        let rh: Option<Value> = Option.None;
        let ri = cattr(e, "row-height");
        if ri >= 0 {
            let auto = false;
            match oneLit(&e.attrs.items[ri].value) { Option.Some(l) { auto = markup.uTrim(l) == "auto"; } Option.None {} }
            if !auto { rh = Option.Some(virtValue(&e.attrs.items[ri], "row-height", a)?); }
        }
        let est: Option<Value> = Option.None;
        let si = cattr(e, "est-height");
        if si >= 0 {
            match rh {
                Option.Some(_) {
                    let r = e.attrs.items[si].range;
                    return Result.Err(uiErr(r.lo, r.hi, "`est-height` is the guess for measured rows; this list has a `row-height`"));
                }
                Option.None {}
            }
            est = Option.Some(virtValue(&e.attrs.items[si], "est-height", a)?);
        }
        let stick = false;
        let ti = cattr(e, "stick-to-bottom");
        if ti >= 0 {
            let at = &e.attrs.items[ti];
            match at.value {
                Value.None { stick = true; }
                Value.Expr(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, "`stick-to-bottom` takes no value")); }
                Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, "`stick-to-bottom` takes no value")); }
            }
        }
        let keep: Option<Range> = Option.None;
        let ki = cattr(e, "keep");
        if ki >= 0 {
            let at = &e.attrs.items[ki];
            match at.value { Value.Expr(r) { keep = Option.Some(r); } Value.None {} Value.Str(_) {} }
            match keep {
                Option.Some(_) {}
                Option.None { return Result.Err(uiErr(at.range.lo, at.range.hi, "`keep` needs `={keys}`, a `[]string` of row keys").withHelp("`<div virtual keep={state.pinned}>`; the keys are the `{#each}` key formatted as text")); }
            }
        }
        let atEnd: Option<Range> = Option.None;
        let bi = cattr(e, "bind:at-end");
        if bi >= 0 {
            let at = &e.attrs.items[bi];
            match at.value {
                Value.Expr(r) {
                    this.placeCheck(r)?;
                    atEnd = Option.Some(r);
                }
                Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, "`bind:at-end` needs `={place}`, a `bool` to write to")); }
                Value.Str(_) { return Result.Err(uiErr(at.range.lo, at.range.hi, "`bind:at-end` needs `={place}`, a `bool` to write to")); }
            }
        }
        this.virt = Option.Some(Virt { n: n, rh: rh, est: est, stick: stick, keep: keep, atEnd: atEnd });
        return Result.Ok(true);
    }

    /// `call(`{key}`)` for row `ix` of the list `x<k>`, with the item (and index) names bound to that row.
    /// `tag` makes the temporaries unique in their scope.
    fn virtKey(this: &G, item: string, index: Option<string>, key: Range, isInt: bool, call: string, ix: string, tag: string): Result<bool, UiError> {
        let a = this.a;
        let d = 0;
        while d < tag.len && tag[d] >= '0' && tag[d] <= '9' { d += 1; }
        let nren = this.rename.len;
        this.cul("let kr% = x%[%];", [tag, tag[0..d], ix]);
        this.rename.push(Rename { from: item, to: cf(a, "kr%", [tag]) });
        match index {
            Option.Some(x) {
                this.cul("let ks% = %;", [tag, ix]);
                this.rename.push(Rename { from: x, to: cf(a, "ks%", [tag]) });
            }
            Option.None {}
        }
        this.upd.set(this.fi, key.lo, key.hi);
        this.upd.pad();
        this.cus(if isInt { "%Int(" } else { "%(`{" }, [call]);
        let r = this.expr(Mode.U, key);
        this.upd.s(if isInt { ");\n" } else { "}`);\n" });
        this.rename.len = nren;
        return r;
    }

    /// A number attribute value as J3 text (`dflt` when absent).
    fn virtNum(this: &G, v: Option<Value>, dflt: string): Result<bool, UiError> {
        match v {
            Option.Some(x) {
                match x {
                    Value.Expr(r) { this.expr(Mode.U, r)?; }
                    Value.Str(_) {
                        match oneLit(&x) { Option.Some(l) { this.upd.s(markup.uTrim(l)); } Option.None {} }
                    }
                    Value.None { this.upd.s(dflt); }
                }
            }
            Option.None { this.upd.s(dflt); }
        }
        return Result.Ok(true);
    }
}
