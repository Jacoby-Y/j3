// `bind:group` on radios (split from `attr.rs`, whose `attr` is one long match on the name).
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/bind_group.rs
// J3: C2e chunk D. Rust's `declared: Option<String>` is `known` + `declared` ("" also when the `let` has
// neither a type nor a guess, which matches none of the tested names).
module j3c.ui.gen;

extend G {
    /// The radio's `value` as an expression (Rust's `val` closure).
    fn groupVal(this: &G, v: &Attr): Result<bool, UiError> {
        match v.value {
            Value.Str(p) { this.strParts(Mode.U, &p.items, v.range)?; }
            Value.Expr(x) { this.expr(Mode.U, x)?; }
            Value.None {}
        }
        return Result.Ok(true);
    }

    /// `bind:group={x}` on a radio: when the user checks this radio `x` becomes its `value`, and the radio is checked while `x` equals it.
    /// A quoted `value="a"` makes `x` a `string`; `value={expr}` an `int` (or a `string` when `x` is a `let` declared as one).
    fn bindGroup(this: &G, e: &Elem, a: &Attr, n: string): Result<bool, UiError> {
        let r = Range { lo: 0, hi: 0 };
        match a.value {
            Value.Expr(x) { r = x; }
            Value.None { return Result.Err(attrErr(a, "`bind:group` needs `={place}`, the variable the checked radio's `value` goes to")); }
            Value.Str(_) { return Result.Err(attrErr(a, "`bind:group` needs `={place}`, the variable the checked radio's `value` goes to")); }
        }
        if !isRadio(e) {
            return Result.Err(attrErr(a, "`bind:group` is for `<input type=\"radio\">`").withHelp("write `type=\"radio\"` as a literal on the same element"));
        }
        this.placeCheck(r)?;
        let vi = -1;
        for i in 0..e.attrs.len { if e.attrs.items[i].name == "value" { vi = i; break; } }
        if vi < 0 {
            return Result.Err(attrErr(a, "`bind:group` needs a `value` on the same radio").withHelp("`value=\"a\"` for a string group, `value={1}` for an int one"));
        }
        let v = &e.attrs.items[vi];
        let place = uTrim(this.src[r.lo..r.hi]);
        let declared = "";
        for i in 0..this.c.sc.lets.len {
            let l = this.c.sc.lets.items[i];
            if l.name != place { continue; }
            match l.ty {
                Option.Some(t) { declared = uTrim(this.src[t.lo..t.hi]); }
                Option.None { declared = l.guess; }
            }
            break;
        }
        let isStr = false;
        match v.value {
            Value.Str(_) {
                if !attrAllLit(v.value) {
                    return Result.Err(attrErr(v, "a radio's `value` text can't have `{}` holes").withHelp("the variable keeps it past the frame: use `value={expr}` with a `string` that outlives it"));
                }
                if declared == "int" || declared == "float" || declared == "f32" || declared == "bool" {
                    let m = Text.new(this.a).add("`").add(place).add("` is ").add(declared).add(", but `value=\"..\"` is text").str();
                    return Result.Err(attrErr(v, m).withHelp("write `value={1}` for an int group"));
                }
                isStr = true;
            }
            Value.Expr(_) { isStr = declared == "string"; }
            Value.None { return Result.Err(attrErr(v, "`value` needs a value")); }
        }
        this.upd.hint = BIND_HINT;
        this.aLine("if d.changed(", n, ") {");
        this.upd.ind += 1;
        this.upd.pad();
        this.expr(Mode.U, r)?;
        this.upd.s(" = ");
        this.groupVal(v)?;
        this.upd.s(";\n");
        this.upd.ind -= 1;
        this.upd.line("}");
        this.upd.hint = "";
        this.upd.pad();
        this.aHead("attrGroup", n);
        if isStr {
            this.upd.s("d.textIs(");
            this.expr(Mode.U, r)?;
            this.upd.s(", ");
            this.groupVal(v)?;
            this.upd.s(")");
        } else {
            this.upd.s("(");
            this.expr(Mode.U, r)?;
            this.upd.s(") == (");
            this.groupVal(v)?;
            this.upd.s(")");
        }
        this.upd.s(");\n");
        return Result.Ok(true);
    }
}
