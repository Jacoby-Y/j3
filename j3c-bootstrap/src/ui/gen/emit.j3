// The per-component run: names, numbering, script fns, the markup walk into `upd` / `pnt`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/emit.rs
// J3: C2e chunk B. `run` and `scriptFn` are in `emit_run.j3`. `G::new` is `newG` in `gen.j3`. Rust `G::slot` is the free fn `slotIndex`; `G::string` is `strParts`
// (`string` is a type name); `seq` / `seqIn` take a `List<Node>` (callers that filter build one: nodes are shallow copies).
module j3c.ui.gen;

extend G {
    /// The next temp number (`n3`, `if2`, ..). Call order is the contract.
    fn nk(this: &G): int {
        this.k += 1;
        return this.k;
    }

    /// The buffer of mode `m`.
    fn out(this: &G, m: Mode): &Out {
        match m {
            Mode.U { return &this.upd; }
            Mode.P { return &this.pnt; }
        }
        return &this.upd;
    }

    /// Copy J3 `lo..hi` into mode `m`'s buffer through `rewrite` (`flat`: newlines to spaces; `emitOk`: `emit x` allowed; `calls`: calling an emitting fn allowed).
    fn rw(this: &G, m: Mode, lo: int, hi: int, flat: bool, emitOk: bool, calls: bool): Result<bool, UiError> {
        let rw = Rw { a: this.a, src: this.src, fi: this.fi, names: &this.names, locals: &this.locals, rename: &this.rename, emitOk: emitOk, sev: false, callsEmit: calls };
        match m {
            Mode.U { return rewrite(&rw, &this.upd, &this.usedU, lo, hi, flat); }
            Mode.P { return rewrite(&rw, &this.pnt, &this.usedP, lo, hi, flat); }
        }
        return Result.Ok(true);
    }

    /// An expression, copied in place (no newline, no semicolon).
    fn expr(this: &G, m: Mode, r: Range): Result<bool, UiError> {
        return this.rw(m, r.lo, r.hi, false, true, false);
    }

    /// Handler statements on their own lines.
    fn stmts(this: &G, m: Mode, r: Range, emitOk: bool): Result<bool, UiError> {
        let t = markup.trimRange(this.src, r.lo, r.hi);
        if t.lo == t.hi { return Result.Ok(true); }
        this.out(m).pad();
        this.rw(m, t.lo, t.hi, false, emitOk, emitOk)?;
        let last = this.src[t.hi - 1]; // the last byte decides: no multi-byte char ends in `;` or `}`
        if last != ';' && last != '}' { this.out(m).s(";"); }
        this.out(m).s("\n");
        return Result.Ok(true);
    }

    /// The `tag_<name>` constant for tag `t` (first use adds it to `tags`).
    fn tag(this: &G, t: string): string {
        if !hasStr(&this.tags, t) { this.tags.push(own(this.a, t)); }
        return fm(this.a, "this.$0", [fieldName("tag_", &this.tags, t, this.a)]);
    }

    /// The `cls_<name>` constant for class `t` (first use adds it to `classes`).
    fn cls(this: &G, t: string): string {
        if !hasStr(&this.classes, t) { this.classes.push(own(this.a, t)); }
        return fm(this.a, "this.$0", [fieldName("cls_", &this.classes, t, this.a)]);
    }

    /// A string expression from attribute or text parts: a literal, or a template (Rust `string`).
    fn strParts(this: &G, m: Mode, parts: &List<Part>, at: Range): Result<bool, UiError> {
        let allLit = true;
        for i in 0..parts.len {
            match parts.items[i] {
                Part.Lit(_) {}
                Part.Hole(_) { allLit = false; }
            }
        }
        if allLit {
            let s = Text.new(this.a);
            for i in 0..parts.len {
                match parts.items[i] {
                    Part.Lit(l) { s.pushStr(l); }
                    Part.Hole(_) {}
                }
            }
            this.out(m).s(lit(s.str(), this.a));
            return Result.Ok(true);
        }
        // One hole: a backtick template (`{s}` of a string is `s` itself, any length).
        // Text around holes, or several holes: appended into a scratch `Text`, each hole its own
        // template, so only one number or struct, never the whole string, has to fit a template buffer.
        let single = parts.len == 1;
        if !single { this.out(m).s("Text.scratch()"); }
        for i in 0..parts.len {
            match parts.items[i] {
                Part.Lit(l) { this.out(m).s(fm(this.a, ".add($0)", [lit(l, this.a)])); }
                Part.Hole(r) {
                    this.out(m).s(if single { "`{" } else { ".add(`{" });
                    this.rw(m, r.lo, r.hi, true, true, false)?;
                    this.out(m).s(if single { "}`" } else { "}`)" });
                }
            }
        }
        if !single { this.out(m).s(".str()"); }
        return Result.Ok(true);
    }

    /// Error when `name` (declared at `r`) shadows a prop, `let`, fn, local or reserved name.
    fn checkLocal(this: &G, name: string, r: Range): Result<bool, UiError> {
        let rw = Rw { a: this.a, src: this.src, fi: this.fi, names: &this.names, locals: &this.locals, rename: &this.rename, emitOk: false, sev: false, callsEmit: false };
        if rw.declared(name) || isReserved(name) {
            return Result.Err(uiErr(r.lo, r.hi, fm(this.a, "`$0` shadows a prop, `let`, `fn`, or name used by the generated code", [name])).withHelp("pick another name"));
        }
        return Result.Ok(true);
    }

    // ---- the walk

    /// A node list at child slots `*j..`: text, elements, components, blocks (advances `*j`).
    fn seq(this: &G, nodes: &List<Node>, j: &int, depth: int, base: Option<Base>): Result<bool, UiError> {
        // `{#let}`s end with the block that holds them
        let nl = this.lets.len;
        let nr = this.rename.len;
        let r = this.seqIn(nodes, j, depth, base);
        this.lets.len = nl;
        this.rename.len = nr;
        return r;
    }

    /// `{#let name = expr}`: a J3 local (own name, so sibling blocks never collide) for the rest of the block.
    fn letNode(this: &G, l: &LetNode): Result<bool, UiError> {
        for i in 0..this.lets.len {
            if this.lets.items[i].name == l.name {
                return Result.Err(uiErr(l.nameR.lo, l.nameR.hi, fm(this.a, "`$0` is already declared by an earlier `{#let}` in this scope", [l.name])));
            }
        }
        this.checkLocal(l.name, l.nameR)?;
        let j3 = fm(this.a, "lt$0", [num(this.a, this.nk())]);
        this.upd.set(this.fi, l.range.lo, l.range.hi);
        this.upd.pad();
        this.upd.s(fm(this.a, "let $0 = ", [j3]));
        this.expr(Mode.U, l.expr)?;
        this.upd.s(";\n");
        this.lets.push(LetIn { name: l.name, j3: j3, expr: l.expr });
        this.rename.push(Rename { from: l.name, to: j3 });
        return Result.Ok(true);
    }

    /// `seq` without the scope: `{#let}`s and renames added here stay for the caller.
    fn seqIn(this: &G, nodes: &List<Node>, j: &int, depth: int, base: Option<Base>): Result<bool, UiError> {
        for i in 0..nodes.len {
            match nodes.items[i] {
                Node.Let(l) { this.letNode(&l)?; }
                Node.Text(t) {
                    this.upd.set(this.fi, t.range.lo, t.range.hi);
                    this.upd.pad();
                    this.upd.s("d.text(");
                    this.strParts(Mode.U, &t.parts, t.range)?;
                    this.upd.s(");\n");
                }
                Node.Elem(e) {
                    let slot = slotIndex(base, *j, this.a);
                    *j += 1;
                    if e.comp { this.comp(&e, slot, depth)?; }
                    else if e.tag == "slot" { this.slotElem(&e, slot, depth)?; }
                    else { this.elem(&e, slot, depth)?; }
                }
                Node.If(f) { this.ifnode(&f, j, depth, base)?; }
                Node.Each(e) {
                    let slot = slotIndex(base, *j, this.a);
                    *j += 1;
                    this.each(&e, slot, depth)?;
                }
            }
        }
        return Result.Ok(true);
    }
}

/// The child slot expression: `iv * k + j` inside a row, else `j` (Rust `G::slot`).
pub fn slotIndex(base: Option<Base>, j: int, a: &Arena): string {
    match base {
        Option.Some(b) { return fm(a, "$0 * $1 + $2", [b.iv, num(a, b.k), num(a, j)]); }
        Option.None { return num(a, j); }
    }
    return "";
}

fn addAll(v: &List<string>, xs: []string) {
    for i in 0..xs.len { v.push(xs[i]); }
}

/// Attributes and directives `tag` accepts (Rust `G::accepted`; chunk D's `attr` families must agree with it).
pub fn accepted(tag: string, a: &Arena): List<string> {
    let v = List<string>.new(a);
    addAll(&v, ["id", "class", "class:name", "on:click", "on:mousedown", "on:mousedown|stop", "on:mouseup", "on:mouseup|stop", "on:mousemove", "on:wheel", "on:wheel|stop", "on:close", "on:contextmenu", "on:contextmenu|stop", "popover", "bind:tooltip", "closedby", "title", "left", "top", "panel", "panel-handle", "panel-resize", "window-drag", "menuitem", "tabindex", "aria-label", "aria-live", "aria-describedby", "aria-selected", "role", "focus-group", "nav-up", "nav-down", "nav-left", "nav-right", "transition:fade", "transition:fly", "transition:slide", "transition:scale", "in:fade", "in:fly", "in:slide", "in:scale", "out:fade", "out:fly", "out:slide", "out:scale", "fly-x", "fly-y", "scale-from", "slide-axis", "transition-easing", "animate:flip", "animate-easing", "anim-delay", "virtual", "row-height", "est-height", "stick-to-bottom", "keep", "bind:at-end", "bind:scrollX", "bind:scrollY", "grid", "on:edit", "draggable", "drag-data", "drag-id", "drag-ghost", "on:dragstart", "on:dragend", "on:dragenter", "on:dragleave", "on:dragover", "on:drop", "bind:this"]);
    if tag == "dialog" { addAll(&v, ["modal", "autoselect"]); }
    else if tag == "label" { v.push("for"); }
    else if tag == "button" { addAll(&v, ["disabled", "default"]); }
    else if tag == "input" || tag == "textarea" { addAll(&v, ["disabled", "type", "min", "max", "step", "value", "high", "checked", "placeholder", "maxlength", "rows", "rich", "noprimary", "name", "bind:value", "bind:spans", "bind:high", "bind:checked", "bind:group", "on:input", "on:change", "on:submit", "on:trigger", "triggers"]); }
    else if tag == "select" { addAll(&v, ["disabled", "multiple", "value", "placeholder", "bind:value", "on:input"]); }
    else if tag == "option" { addAll(&v, ["disabled", "value"]); }
    else if tag == "canvas" { v.push("on:draw"); }
    else if tag == "img" { addAll(&v, ["src", "alt", "sprite", "frame", "fps"]); }
    else if tag == "progress" { addAll(&v, ["value", "max"]); }
    else if tag == "meter" { addAll(&v, ["value", "min", "max", "low", "high", "optimum"]); }
    else if tag == "glyph" { addAll(&v, ["action", "key", "pad"]); }
    else if tag == "icon" { v.push("name"); }
    else if tag == "details" { addAll(&v, ["open", "bind:open", "on:toggle"]); }
    else if tag == "svg" { v.push("viewBox"); }
    else if tag == "path" { addAll(&v, ["d", "fill", "fill-rule", "stroke", "stroke-width"]); }
    return v;
}
