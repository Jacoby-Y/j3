// Read-only queries over elements, nodes and script text.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/query.rs
// J3: C2e chunk B; called from chunks C and D. `number` writes `ids[uid]` (Rust: the nodes' `id` cells).
// `cssProps` takes the embedded stdlib file's text (`ui` sits below `load`).
module j3c.ui.gen;

/// `(is a number, code)` of an attribute that fills `j3.ui.media.Media` (`M_*` and `N_*` there).
pub struct MediaCode {
    num: bool;
    code: int;
}

/// The literal `type` of an `<input>` ("text" when it has none), `None` when it is an expression.
pub fn inputType(e: &Elem): Option<string> {
    for i in 0..e.attrs.len {
        let at = e.attrs.items[i];
        if at.name != "type" { continue; }
        match at.value {
            Value.Str(p) {
                // one literal part is the common case: no copy
                if p.items.len == 1 {
                    match p.items.items[0] {
                        Part.Lit(l) { return Option.Some(l); }
                        Part.Hole(_) { return Option.None; }
                    }
                }
                let t = Text.new(e.attrs.arena);
                for k in 0..p.items.len {
                    match p.items.items[k] {
                        Part.Lit(l) { t.add(l); }
                        Part.Hole(_) { return Option.None; }
                    }
                }
                return Option.Some(t.str());
            }
            Value.None { return Option.None; }
            Value.Expr(_) { return Option.None; }
        }
    }
    return Option.Some("text");
}

/// Rust `media_code`.
pub fn mediaCode(name: string): Option<MediaCode> {
    let strs: [7]string = ["src", "sprite", "viewBox", "d", "fill", "stroke", "fill-rule"];
    for i in 0..strs.len { if strs[i] == name { return Option.Some(MediaCode { num: false, code: i }); } }
    let nums: [3]string = ["frame", "fps", "stroke-width"];
    for i in 0..nums.len { if nums[i] == name { return Option.Some(MediaCode { num: true, code: i }); } }
    return Option.None;
}

fn inputIs(e: &Elem, ty: string): bool {
    if e.tag != "input" { return false; }
    match inputType(e) {
        Option.Some(t) { return t == ty; }
        Option.None { return false; }
    }
}

/// `<input type="range">`.
pub fn isRange(e: &Elem): bool { return inputIs(e, "range"); }

/// `<input type="radio">`.
pub fn isRadio(e: &Elem): bool { return inputIs(e, "radio"); }

/// How many child slots `nodes` take.
pub fn width(nodes: &List<Node>): int {
    let w = 0;
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(_) { w += 1; }
            Node.Each(_) { w += 1; }
            Node.If(f) { for b in 0..f.branches.len { w += width(&f.branches.items[b].nodes); } }
        }
    }
    return w;
}

/// `nodes` hold state (a component, a `use:` action, a `bind:this`).
pub fn holds(nodes: &List<Node>): bool {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                if e.comp { return true; }
                for k in 0..e.attrs.len {
                    let n = e.attrs.items[k].name;
                    if startsWith(n, "use:") || n == "bind:this" { return true; }
                }
                if holds(&e.children) { return true; }
            }
            Node.If(f) { for b in 0..f.branches.len { if holds(&f.branches.items[b].nodes) { return true; } } }
            Node.Each(e) { if holds(&e.body) { return true; } }
        }
    }
    return false;
}

/// Number component instances (`*cn`), stateful `{#if}`s (`*ifn`) and `{#each}`s (`*en`) in pre-order into `ids[uid]` (Rust writes the nodes' `id` cells).
pub fn number(nodes: &List<Node>, ids: []int, cn: &int, ifn: &int, en: &int) {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                if e.comp {
                    *cn += 1;
                    ids[e.uid] = *cn;
                }
                number(&e.children, ids, cn, ifn, en);
            }
            Node.If(f) {
                let st = false;
                for b in 0..f.branches.len { if holds(&f.branches.items[b].nodes) { st = true; break; } }
                if st {
                    *ifn += 1;
                    ids[f.uid] = *ifn;
                }
                for b in 0..f.branches.len { number(&f.branches.items[b].nodes, ids, cn, ifn, en); }
            }
            Node.Each(e) {
                *en += 1;
                ids[e.uid] = *en;
                number(&e.body, ids, cn, ifn, en);
            }
        }
    }
}

/// The component names used under `nodes`, in tree order (repeats kept).
pub fn childrenOf(nodes: &List<Node>, out: &List<string>) {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                if e.comp { out.push(e.tag); }
                childrenOf(&e.children, out);
            }
            Node.If(f) { for b in 0..f.branches.len { childrenOf(&f.branches.items[b].nodes, out); } }
            Node.Each(e) { childrenOf(&e.body, out); }
        }
    }
}

/// The `use` item kept whole: without the `use` and the `;` (aliases, anything odd).
fn useWhole(s: string, a: &Arena): List<string> {
    let t = markup.uTrim(s);
    while startsWith(t, "use") { t = t[3..t.len]; }
    t = markup.uTrim(t);
    while endsWith(t, ";") { t = t[0..t.len - 1]; }
    let v = List<string>.new(a);
    v.push(markup.uTrim(t));
    return v;
}

/// A script `use` item as one full name per imported name: `a.b.{ C, D }` gives `a.b.C`, `a.b.D`.
pub fn useNames(s: string, a: &Arena): List<string> {
    let toks = match lex(s, noFile(), a) {
        Result.Ok(t) { t }
        Result.Err(_) { return useWhole(s, a); }
    };
    let path = List<string>.new(a);
    let names = List<string>.new(a);
    let inSet = false;
    for i in 1..toks.len {
        let k = toks.items[i].kind;
        if k == TokenKind.Ident {
            if inSet { names.push(toks.items[i].text); } else { path.push(toks.items[i].text); }
        } else if k == TokenKind.LBrace {
            inSet = true;
        } else if !(k == TokenKind.Dot || k == TokenKind.Comma || k == TokenKind.RBrace || k == TokenKind.Semi || k == TokenKind.Eof) {
            return useWhole(s, a);
        }
    }
    let p = joinStr(a, &path, ".");
    let v = List<string>.new(a);
    if names.len == 0 {
        v.push(p);
        return v;
    }
    for i in 0..names.len { v.push(fm(a, "$0.$1", [p, names.items[i]])); }
    return v;
}

/// The longhand CSS property names, space separated: the `PROP_NAMES` string of `propsText` (the embedded stdlib `ui/css/props.j3`; Rust `css_props`).
pub fn cssProps(propsText: string): string {
    let key = "PROP_NAMES: string = \"";
    let at = text.find(propsText, key);
    if at < 0 { return ""; }
    let lo = at + key.len;
    let hi = lo;
    while hi < propsText.len && propsText[hi] != '"' { hi += 1; }
    return propsText[lo..hi];
}

/// Conditionals do not add a DOM parent; components/elements do.
pub fn tooltipChild(nodes: &List<Node>): bool {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Elem(e) {
                if e.comp { continue; }
                for k in 0..e.attrs.len {
                    if e.attrs.items[k].name != "popover" { continue; }
                    match e.attrs.items[k].value {
                        Value.None { return true; }
                        Value.Expr(_) {}
                        Value.Str(_) {}
                    }
                }
            }
            Node.If(f) { for b in 0..f.branches.len { if tooltipChild(&f.branches.items[b].nodes) { return true; } } }
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Each(_) {}
        }
    }
    return false;
}

const OPTION_TAGS: [10]string = ["div", "span", "p", "small", "h1", "h2", "img", "svg", "path", "icon"];
const OPTION_ATTRS: [12]string = ["src", "alt", "sprite", "frame", "fps", "viewBox", "d", "fill", "fill-rule", "stroke", "stroke-width", "name"];

/// Option content is mirrored into popup rows: keep controls, handlers and component identities out.
pub fn optionVisuals(nodes: &List<Node>): Result<bool, UiError> {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Elem(e) {
                if e.comp || !inList(OPTION_TAGS[0..OPTION_TAGS.len], e.tag) {
                    return Result.Err(uiErr(e.open.lo, e.open.hi, "option content must be visual markup (text, div/span/p/small/h1/h2, img, svg, path, icon); put controls outside the select"));
                }
                for k in 0..e.attrs.len {
                    let at = e.attrs.items[k];
                    if !(at.name == "class" || startsWith(at.name, "class:") || startsWith(at.name, "style:") || inList(OPTION_ATTRS[0..OPTION_ATTRS.len], at.name)) {
                        return Result.Err(uiErr(at.range.lo, at.range.hi, "option visual descendants cannot have events, bindings, focus or overlay attributes; handle selection with on:input on the select"));
                    }
                }
                optionVisuals(&e.children)?;
            }
            Node.If(f) { for b in 0..f.branches.len { optionVisuals(&f.branches.items[b].nodes)?; } }
            Node.Each(e) { optionVisuals(&e.body)?; }
            Node.Let(_) {}
        }
    }
    return Result.Ok(true);
}
