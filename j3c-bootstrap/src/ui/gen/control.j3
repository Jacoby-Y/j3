// Control flow: `{#if}` / `{#match}`, the `{#each}` head, branch resets. `each` itself is `control_each.j3`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/control.rs
// J3: C2e chunk C. `EachHead` is in `gen.j3`. Rust `i.id.get()` is `this.ids[i.uid]`. `branchHead` takes the
// choice enum as `Option<string>` plus the branch index (Rust `Option<(&str, usize)>`).
// J3: `cul` / `cus` / `cpl` are `upd.line` / `upd.s` / `pnt.line` of a `cf` format (see `slots.j3`).
module j3c.ui.gen;

const EACH_HELP = "`{#each items as item}`, `{#each items as &item}`, `{#each items as item, i}`, `{#each items as item (item.id)}`, or `{#each 0..n as i}`";

extend G {
    fn cul(this: &G, pat: string, args: []string) { this.upd.line(cf(this.a, pat, args)); }
    fn cus(this: &G, pat: string, args: []string) { this.upd.s(cf(this.a, pat, args)); }
    fn cpl(this: &G, pat: string, args: []string) { this.pnt.line(cf(this.a, pat, args)); }

    /// The container being built: the innermost `{#each}` with a row struct, 0 for the component.
    fn cont(this: &G): int {
        if this.own.len == 0 { return 0; }
        return this.own.items[this.own.len - 1];
    }

    /// An `{#if}` / `{#match}` at child slots `*j..`.
    fn ifnode(this: &G, i: &IfNode, j: &int, depth: int, base: Option<Base>): Result<bool, UiError> {
        let a = this.a;
        let id = this.ids[i.uid];
        let ids = num(a, id);
        let stateful = id != 0;
        let lo = i.range.lo;
        let hi = i.range.hi;
        this.upd.set(this.fi, lo, hi);
        let state = "";
        let bv = "";
        // `{#match X}`: X is evaluated once
        let mv = "";
        match i.scrut {
            Option.Some(sc) {
                mv = cf(a, "m%", [num(a, this.nk())]);
                this.upd.pad();
                this.cus("let % = ", [mv]);
                this.expr(Mode.U, sc)?;
                this.upd.s(";\n");
            }
            Option.None {}
        }
        if stateful {
            this.ifs.push(IfState { id: id, container: this.cont() });
            state = cf(a, "%.if%", [this.owner(), ids]);
            bv = cf(a, "b%", [num(a, this.nk())]);
            this.cul("let % = -1;", [bv]);
            for bi in 0..i.branches.len {
                this.upd.pad();
                if bi > 0 { this.upd.s("} else "); }
                this.branchHead(&i.branches.items[bi], mv, i.choice, bi)?;
                this.upd.ind += 1;
                this.cul("% = %;", [bv, num(a, bi)]);
                this.upd.ind -= 1;
            }
            this.upd.line("}");
            this.cul("if % != % {", [bv, state]);
            this.upd.ind += 1;
            // leaving a branch destroys its components (onDestroy), entering one starts them fresh
            let first = true;
            for bi in 0..i.branches.len {
                let dead = List<string>.new(a);
                this.resets(&i.branches.items[bi].nodes, true, &dead);
                if dead.len == 0 { continue; }
                this.cul("%if % == % {", [if first { "" } else { "} else " }, state, num(a, bi)]);
                first = false;
                this.upd.ind += 1;
                for r in 0..dead.len { this.upd.line(dead.items[r]); }
                this.upd.ind -= 1;
            }
            if !first { this.upd.line("}"); }
            this.cul("% = %;", [state, bv]);
            first = true;
            for bi in 0..i.branches.len {
                let fresh = List<string>.new(a);
                this.resets(&i.branches.items[bi].nodes, false, &fresh);
                if fresh.len == 0 { continue; }
                this.cul("%if % == % {", [if first { "" } else { "} else " }, bv, num(a, bi)]);
                first = false;
                this.upd.ind += 1;
                for r in 0..fresh.len { this.upd.line(fresh.items[r]); }
                this.upd.ind -= 1;
            }
            if !first { this.upd.line("}"); }
            this.upd.ind -= 1;
            this.upd.line("}");
        }
        for bi in 0..i.branches.len {
            this.upd.set(this.fi, lo, hi);
            this.upd.pad();
            if bi > 0 { this.upd.s("} else "); }
            if stateful {
                this.cus("if % == % {\n", [bv, num(a, bi)]);
            } else {
                this.branchHead(&i.branches.items[bi], mv, i.choice, bi)?;
            }
            this.upd.ind += 1;
            this.seq(&i.branches.items[bi].nodes, j, depth, base)?;
            this.upd.ind -= 1;
        }
        this.upd.set(this.fi, lo, hi);
        this.upd.line("}");
        return Result.Ok(true);
    }

    /// `if cond {`, or for a `{#match}` case `if m == a || m == b {`; an else branch opens a bare `{`.
    fn branchHead(this: &G, b: &Branch, mv: string, choice: Option<string>, index: int): Result<bool, UiError> {
        match choice {
            Option.Some(set) {
                this.cus("if @uiChoice(%, %, %) {\n", [set, mv, num(this.a, index)]);
                return Result.Ok(true);
            }
            Option.None {}
        }
        match b.cond {
            Option.Some(c) {
                this.upd.s("if ");
                this.expr(Mode.U, c)?;
                this.upd.s(" {\n");
                return Result.Ok(true);
            }
            Option.None {}
        }
        if b.vals.len == 0 {
            this.upd.s("{\n");
            return Result.Ok(true);
        }
        this.upd.s("if ");
        for q in 0..b.vals.len {
            if q > 0 { this.upd.s(" || "); }
            this.cus("% == ", [mv]);
            this.expr(Mode.U, b.vals.items[q])?;
        }
        this.upd.s(" {\n");
        return Result.Ok(true);
    }

    /// Statements that reset what a branch holds when it is entered (Svelte destroys it), or with
    /// `destroy` the `destroy()` calls for its components when it is left. The branch's own level only:
    /// rows of a list in it are destroyed (and dropped) as a whole.
    fn resets(this: &G, nodes: &List<Node>, destroy: bool, out: &List<string>) {
        let a = this.a;
        let own = this.owner();
        for n in 0..nodes.len {
            match nodes.items[n] {
                Node.Text(_) {}
                Node.Let(_) {}
                Node.Elem(e) {
                    if e.comp {
                        let id = num(a, this.ids[e.uid]);
                        out.push(cf(a, if destroy { "%.c%.destroy();" } else { "%.c%.j3Reset();" }, [own, id]));
                    }
                    this.resets(&e.children, destroy, out);
                }
                Node.If(i) {
                    let id = this.ids[i.uid];
                    if id != 0 && !destroy { out.push(cf(a, "%.if% = -1;", [own, num(a, id)])); }
                    for b in 0..i.branches.len { this.resets(&i.branches.items[b].nodes, destroy, out); }
                }
                Node.Each(e) {
                    let id = num(a, this.ids[e.uid]);
                    let keyed = false;
                    match parseEachHead(this.src, e.head, a) {
                        Result.Ok(h) { match h.key { Option.Some(_) { keyed = true; } Option.None {} } }
                        Result.Err(_) { continue; }
                    }
                    if !keyed && !holds(&e.body) { continue; }
                    if destroy {
                        out.push(cf(a, "for q% in 0..%.e%.len { %.e%.items[q%].destroy(); }", [id, own, id, own, id, id]));
                    } else {
                        out.push(cf(a, "for q% in 0..%.e%.len { %.fp%.push(%.e%.items[q%]); }", [id, own, id, own, id, own, id, id]));
                        out.push(cf(a, "%.e%.len = 0;", [own, id]));
                        if keyed { out.push(cf(a, "%.kd%.reset();", [own, id])); }
                    }
                }
            }
        }
    }

    /// The struct that holds the state of what is being built: the component, or the `{#each}` row.
    fn owner(this: &G): string {
        if this.own.len == 0 { return "this"; }
        return cf(this.a, "r%", [num(this.a, this.own.items[this.own.len - 1])]);
    }
}

fn eachBad(r: Range, msg: string): UiError { return uiErr(r.lo, r.hi, msg).withHelp(EACH_HELP); }

fn isOpen(k: TokenKind): bool { return k == TokenKind.LParen || k == TokenKind.LBracket || k == TokenKind.LBrace; }

fn isClose(k: TokenKind): bool { return k == TokenKind.RParen || k == TokenKind.RBracket || k == TokenKind.RBrace; }

/// Lex `src[r]`; token spans are relative to `r.lo` (Rust `lex(..).map_err(..)`).
pub fn lexAt(src: string, r: Range, a: &Arena): Result<List<Token>, UiError> {
    match lex(src[r.lo..r.hi], Id<Source> { i: 0 }, a) {
        Result.Ok(t) { return Result.Ok(t); }
        Result.Err(e) { return Result.Err(uiErr(r.lo + int(e.span.lo), r.lo + int(e.span.hi), e.msg)); }
    }
    return Result.Err(uiErr(r.lo, r.hi, ""));
}

/// Parse `items as item, i (key)` at `r` (Rust `parse_each_head`).
pub fn parseEachHead(src: string, r: Range, a: &Arena): Result<EachHead, UiError> {
    let toks = lexAt(src, r, a)?;
    let n = toks.len;
    // the last top-level `as`
    let depth = 0;
    let at = -1;
    for k in 0..n {
        let kind = toks.items[k].kind;
        if isOpen(kind) { depth += 1; }
        else if isClose(kind) { depth -= 1; }
        else if kind == TokenKind.As && depth == 0 { at = k; }
    }
    if at < 0 { return Result.Err(eachBad(r, "`{#each}` needs `as`")); }
    let ri = at + 1;
    let byRef = ri < n && toks.items[ri].kind == TokenKind.Amp;
    if byRef { ri += 1; }
    // `item`, `item, index`, each with an optional `(key)` to the end
    let names = 0;
    if n - ri >= 3 && toks.items[ri].kind == TokenKind.Ident && toks.items[ri + 1].kind == TokenKind.Comma && toks.items[ri + 2].kind == TokenKind.Ident { names = 2; }
    else if n - ri >= 1 && toks.items[ri].kind == TokenKind.Ident { names = 1; }
    else { return Result.Err(eachBad(r, "expected `as item` or `as item, index` at the end of `{#each}`")); }
    let ti = if names == 2 { ri + 3 } else { ri + 1 };
    let keyInt = false;
    let key: Option<Range> = Option.None;
    if n - ti == 1 && toks.items[ti].kind == TokenKind.Eof {
        // no key
    } else if n - ti >= 3 && toks.items[ti].kind == TokenKind.LParen && toks.items[n - 2].kind == TokenKind.RParen && toks.items[n - 1].kind == TokenKind.Eof {
        let open = r.lo + int(toks.items[ti].span.hi);
        let k = markup.trimRange(src, open, r.lo + int(toks.items[n - 2].span.lo));
        let mlo = ti + 1;
        let mhi = n - 2;
        if mhi - mlo >= 2 && toks.items[mhi - 2].kind == TokenKind.Colon && toks.items[mhi - 1].kind == TokenKind.Ident && toks.items[mhi - 1].text == "int" {
            keyInt = true;
            k = markup.trimRange(src, open, r.lo + int(toks.items[mhi - 2].span.lo));
        }
        if k.lo == k.hi { return Result.Err(eachBad(r, "the `(key)` is empty")); }
        let d = 0;
        for q in mlo..mhi {
            if toks.items[q].kind == TokenKind.LParen { d += 1; }
            else if toks.items[q].kind == TokenKind.RParen { d -= 1; }
            if d < 0 { return Result.Err(eachBad(r, "unbalanced `)` in the `(key)`")); }
        }
        key = Option.Some(k);
    } else {
        return Result.Err(eachBad(r, "expected `as item`, `as item, index` or `as item (key)` (`(key : int)` for an int key) at the end of `{#each}`"));
    }
    let it = toks.items[ri];
    let item = Named { name: it.text, r: Range { lo: r.lo + int(it.span.lo), hi: r.lo + int(it.span.hi) } };
    let index: Option<Named> = Option.None;
    if names == 2 {
        let ix = toks.items[ri + 2];
        index = Option.Some(Named { name: ix.text, r: Range { lo: r.lo + int(ix.span.lo), hi: r.lo + int(ix.span.hi) } });
    }
    let end = r.lo + int(toks.items[at].span.lo);
    let expr = markup.trimRange(src, r.lo, end);
    if expr.lo == expr.hi { return Result.Err(eachBad(r, "`{#each}` has nothing before `as`")); }
    depth = 0;
    let range: Option<RangePair> = Option.None;
    for q in 0..at {
        let t = toks.items[q];
        let tlo = r.lo + int(t.span.lo);
        let thi = r.lo + int(t.span.hi);
        if isOpen(t.kind) { depth += 1; }
        else if isClose(t.kind) { depth -= 1; }
        else if t.kind == TokenKind.DotDotEq && depth == 0 { return Result.Err(uiErr(tlo, thi, "use `a..b` (b excluded); `..=` isn't supported in `{#each}`")); }
        else if t.kind == TokenKind.DotDot && depth == 0 { range = Option.Some(RangePair { a: markup.trimRange(src, expr.lo, tlo), b: markup.trimRange(src, tlo + (thi - tlo), expr.hi) }); }
    }
    return Result.Ok(EachHead { expr: expr, range: range, item: item, byRef: byRef, index: index, key: key, keyInt: keyInt });
}
