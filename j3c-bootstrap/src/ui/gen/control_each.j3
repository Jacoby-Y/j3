// `{#each}`: the four shapes (plain, keyed, rows, virtual). Split from `control.j3` (file size).
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/control.rs
// J3: C2e chunk C. Rust `e.id.get()` is `this.ids[e.uid]`. `self.virt.take()` is a copy + `Option.None`;
// `truncate(n)` is `list.len = n`. The virtual-list table code is `eachVirt` (one Rust block, own fn here).
module j3c.ui.gen;

/// 1-based line of byte `at` in `src` (Rust `src[..at].matches('\n').count() + 1`).
fn lineAt(src: string, at: int): int {
    let n = 1;
    for i in 0..at { if src[i] == '\n' { n += 1; } }
    return n;
}

fn rok(r: Result<bool, UiError>): bool {
    match r {
        Result.Ok(_) { return true; }
        Result.Err(_) { return false; }
    }
    return false;
}

extend G {
    /// `"path:line"` of byte `lo`, as a J3 string literal (the place a duplicate key is reported at).
    fn hereLit(this: &G, lo: int): string {
        return lit(cf(this.a, "%:%", [this.files.items[this.fi].path, num(this.a, lineAt(this.src, lo))]), this.a);
    }

    /// A `{#each}` at child slot expression `slot`.
    fn each(this: &G, e: &EachNode, slot: string, depth: int): Result<bool, UiError> {
        let a = this.a;
        let src = this.src;
        let lo = e.range.lo;
        let head = parseEachHead(src, e.head, a)?;
        this.checkLocal(head.item.name, head.item.r)?;
        let hasIndex = false;
        let ixName = "";
        let ixR = Range { lo: 0, hi: 0 };
        match head.index {
            Option.Some(x) { hasIndex = true; ixName = x.name; ixR = x.r; }
            Option.None {}
        }
        if hasIndex { this.checkLocal(ixName, ixR)?; }
        let isRange = false;
        let ra = Range { lo: 0, hi: 0 };
        let rb = Range { lo: 0, hi: 0 };
        match head.range {
            Option.Some(p) { isRange = true; ra = p.a; rb = p.b; }
            Option.None {}
        }
        if head.byRef && isRange {
            return Result.Err(uiErr(head.item.r.lo - 1, head.item.r.hi, "a range loop gives numbers; `&x` is for a list of structs").withHelp("`{#each items as &item}`"));
        }
        if isRange && hasIndex {
            return Result.Err(uiErr(ixR.lo, ixR.hi, "a range loop has no index").withHelp("the item is the index: `{#each 0..n as i}`"));
        }
        let id = this.ids[e.uid];
        let ids = num(a, id);
        let keyed = false;
        match head.key { Option.Some(_) { keyed = true; } Option.None {} }
        let rows = keyed || holds(&e.body);
        let own = this.owner();
        let virt = this.virt;
        this.virt = Option.None;
        let isVirt = false;
        match virt { Option.Some(_) { isVirt = true; } Option.None {} }
        this.eachs.push(EachDef { id: id, container: this.cont(), keyed: keyed, rows: rows, virt: isVirt });
        if isVirt { this.usesVirt = true; }
        if rows { this.usesList = true; }
        if keyed { this.usesKeyed = true; }
        let k = this.nk();
        let ks = num(a, k);
        let sv = cf(a, "s%", [ks]);
        let mv = cf(a, "m%", [ks]);
        this.upd.set(this.fi, lo, e.head.hi);
        this.cul("let % = d.enter(%);", [sv, slot]);
        let item = head.item.name;
        let amp = if head.byRef { "&" } else { "" };
        let bind = "";
        // the iteration variable and where `mv` comes from
        let iv = "";
        if isRange {
            let zero = markup.uTrim(src[ra.lo..ra.hi]) == "0";
            this.upd.pad();
            if zero {
                this.cus("let % = ", [mv]);
                this.expr(Mode.U, rb)?;
                this.upd.s(";\n");
                iv = item;
            } else {
                this.cus("let a% = ", [ks]);
                this.expr(Mode.U, ra)?;
                this.upd.s(";\n");
                this.upd.pad();
                this.cus("let % = ", [mv]);
                this.expr(Mode.U, rb)?;
                this.cus(" - a%;\n", [ks]);
                iv = cf(a, "i%", [ks]);
                bind = cf(a, "let % = a% + %;", [item, ks, iv]);
            }
        } else {
            this.upd.pad();
            this.cus("let x% = ", [ks]);
            this.expr(Mode.U, head.expr)?;
            this.upd.s(";\n");
            match virt {
                Option.Some(va) {
                    this.eachVirt(e, &head, &va, k, id, own)?;
                    let vl = cf(a, "%.vl%", [own, ids]);
                    iv = cf(a, "i%", [ks]);
                    bind = cf(a, "let ax% = %.at(%); let % = %x%[ax%];", [ks, vl, iv, item, amp, ks, ks]);
                    if hasIndex { bind = cf(a, "% let % = ax%;", [bind, ixName, ks]); }
                }
                Option.None {
                    this.cul("let % = x%.len;", [mv, ks]);
                    iv = if hasIndex { ixName } else { cf(a, "i%", [ks]) };
                    bind = cf(a, "let % = %x%[%];", [item, amp, ks, iv]);
                }
            }
        }
        this.cul("%.cnt% = %;", [own, ids, mv]);
        let saved = this.locals.len;
        let rn = cf(a, "%_R%", [this.c.id, ids]);
        let er = cf(a, "%.e%", [own, ids]);
        let parent = if this.gstk.len > 0 { this.gstk.items[this.gstk.len - 1] } else { "-1" };
        match head.key {
            Option.Some(key) {
                // match this frame's keys to last frame's rows, then reorder the rows to match
                let kd = cf(a, "%.kd%", [own, ids]);
                // the key sees the item under other names (the body binds it again below)
                let kv = cf(a, "kv%", [ks]);
                let ki = cf(a, "ki%", [ks]);
                let nren = this.rename.len;
                this.cul("%.begin();", [kd]);
                this.cul("for % in 0..% {", [kv, mv]);
                this.upd.ind += 1;
                if isRange {
                    if markup.uTrim(src[ra.lo..ra.hi]) == "0" {
                        this.rename.push(Rename { from: item, to: kv });
                    } else {
                        this.cul("let % = a% + %;", [ki, ks, kv]);
                        this.rename.push(Rename { from: item, to: ki });
                    }
                } else {
                    let at = if isVirt { cf(a, "kj%", [ks]) } else { kv };
                    if isVirt { this.cul("let kj% = %.vl%.at(%);", [ks, own, ids, kv]); }
                    this.cul("let % = x%[%];", [ki, ks, at]);
                    this.rename.push(Rename { from: item, to: ki });
                    if hasIndex { this.rename.push(Rename { from: ixName, to: at }); }
                }
                this.upd.set(this.fi, key.lo, key.hi);
                this.upd.pad();
                this.cus(if head.keyInt { "%.addInt(" } else { "%.add(`{" }, [kd]);
                let r = this.expr(Mode.U, key);
                this.upd.s(if head.keyInt { ");\n" } else { "}`);\n" });
                this.rename.len = nren;
                r?;
                this.upd.ind -= 1;
                this.upd.set(this.fi, lo, e.head.hi);
                this.upd.line("}");
                this.cul("%.finish(%);", [kd, this.hereLit(lo)]);
                if isVirt { this.cul("%.vl%.verify(&%);", [own, ids, kd]); }
                this.cul("if %.changed {", [kd]);
                this.upd.ind += 1;
                this.cul("for dq% in 0..%.dead.len { let dr% = %.items[%.dead.items[dq%]]; dr%.destroy(); %.fp%.push(dr%); }", [ks, kd, ks, er, kd, ks, ks, own, ids, ks]);
                this.cul("%.eb%.len = 0;", [own, ids]);
                this.cul("for rq% in 0..% {", [ks, mv]);
                this.upd.ind += 1;
                this.cul("let f% = %.from.items[rq%];", [ks, kd, ks]);
                this.cul("if f% >= 0 { %.eb%.push(%.items[f%]); } else { %.eb%.push(%.take(&%.fp%, this.mem, d, d.groupNew(%), this as int)); }", [ks, own, ids, er, ks, own, ids, rn, own, ids, parent]);
                this.upd.ind -= 1;
                this.upd.line("}");
                this.cul("let t% = %;", [ks, er]);
                this.cul("% = %.eb%;", [er, own, ids]);
                this.cul("%.eb% = t%;", [own, ids, ks]);
                this.upd.ind -= 1;
                this.upd.line("}");
            }
            Option.None {
                if rows {
                    this.cul("while %.len < % { %.push(%.take(&%.fp%, this.mem, d, -1, this as int)); }", [er, mv, er, rn, own, ids]);
                    this.cul("if %.len > % {", [er, mv]);
                    this.upd.ind += 1;
                    this.cul("for zq% in %..%.len { %.items[zq%].destroy(); %.fp%.push(%.items[zq%]); }", [ks, mv, er, er, ks, own, ids, er, ks]);
                    this.cul("%.len = %;", [er, mv]);
                    this.upd.ind -= 1;
                    this.upd.line("}");
                }
            }
        }
        this.locals.push(item);
        if hasIndex { this.locals.push(ixName); }
        this.cul("for % in 0..% {", [iv, mv]);
        this.upd.ind += 1;
        if bind.len > 0 { this.upd.line(bind); }
        if rows { this.cul("let r% = %.items[%];", [ids, er, iv]); }
        if keyed { this.cul("d.keyBegin(r%.uid);", [ids]); }
        this.pnt.set(this.fi, lo, e.head.hi);
        this.cpl("let % = d.enter(%);", [sv, slot]);
        this.cpl("let % = %.cnt%;", [mv, own, ids]);
        this.cpl("for % in 0..% {", [iv, mv]);
        this.pnt.ind += 1;
        if rows { this.cpl("let r% = %.items[%];", [ids, er, iv]); }
        if keyed { this.cpl("d.paintGroup(r%.uid);", [ids]); }
        if rows { this.own.push(id); }
        if keyed { this.gstk.push(cf(a, "r%.uid", [ids])); }
        this.idx.push(iv);
        this.ectx.push(EachCx { head: head, k: k, eid: id, rows: rows });
        // a keyed row's nodes are told apart by the row (`keyBegin`), not by an index in the slot
        let base: Option<Base> = Option.None;
        if !keyed { base = Option.Some(Base { iv: iv, k: width(&e.body) }); }
        let j = 0;
        if isVirt { this.inVirt += 1; }
        if keyed && !isVirt { rowElems(&e.body, &this.flipRows); }
        if rows { this.bases.push(ScopeBase { locals: this.locals.len, lets: this.lets.len }); }
        let res = this.seq(&e.body, &j, depth + 1, base);
        if rows {
            this.bases.len -= 1;
            if rok(res) { res = this.actSweep(id, cf(a, "r%", [ids])); }
        }
        if isVirt { this.inVirt -= 1; }
        this.ectx.len -= 1;
        this.idx.len -= 1;
        if keyed { this.gstk.len -= 1; }
        if rows { this.own.len -= 1; }
        this.locals.len = saved;
        res?;
        if keyed {
            this.upd.line("d.keyEnd();");
            this.pnt.line("d.paintGroupEnd();");
        }
        this.upd.ind -= 1;
        this.upd.set(this.fi, lo, e.head.hi);
        this.upd.line("}");
        match virt {
            // kept rows outside the window are hidden now that the rows are built
            Option.Some(va) { this.cul("vlist.finish(d, %, &%.vl%);", [va.n, own, ids]); }
            Option.None {}
        }
        this.cul("d.leave(%);", [sv]);
        this.pnt.ind -= 1;
        this.pnt.line("}");
        this.cpl("d.leave(%);", [sv]);
        return Result.Ok(true);
    }

    /// The window of a `virtual` list `x<k>`: settings, the key table carried over, `vlist.step`, `m<k>`.
    fn eachVirt(this: &G, e: &EachNode, head: &EachHead, va: &Virt, k: int, id: int, own: string): Result<bool, UiError> {
        let a = this.a;
        let lo = e.range.lo;
        let ks = num(a, k);
        // the rows alive (`lo..hi` plus kept ones); the box pads for the rest, and `vl.at(i)` is a row's index
        let vl = cf(a, "%.vl%", [own, num(a, id)]);
        let hasKeep = false;
        match va.keep { Option.Some(_) { hasKeep = true; } Option.None {} }
        this.upd.pad();
        this.cus("%.cfg(f32(", [vl]);
        this.virtNum(va.rh, "0.0")?;
        this.upd.s("), f32(");
        this.virtNum(va.est, "40.0")?;
        this.cus("), %, %);\n", [if va.stick { "true" } else { "false" }, if hasKeep { "true" } else { "false" }]);
        match va.keep {
            Option.Some(r) {
                if head.keyInt {
                    return Result.Err(uiErr(r.lo, r.hi, "`keep` lists text keys, but this `{#each}` has an int key (`: int`)").withHelp("drop `: int` from the key, or drop `keep`"));
                }
                this.upd.pad();
                this.cus("%.keep = ", [vl]);
                this.expr(Mode.U, r)?;
                this.upd.s(";\n");
            }
            Option.None {}
        }
        match va.atEnd {
            Option.Some(r) {
                this.upd.pad();
                this.upd.s("if ");
                this.expr(Mode.U, r)?;
                this.cus(" && !%.atEnd { %.toEnd = true; }\n", [vl, vl]);
            }
            Option.None {}
        }
        // the list changed: carry the table over. A list that only grew at its tail (checked on its
        // first and last old row) formats just the new keys; anything else formats every key once.
        let key = Range { lo: 0, hi: 0 };
        match head.key {
            Option.Some(r) { key = r; }
            Option.None {} // virtual lists are keyed (`virtualAttrs`)
        }
        let ki = head.keyInt;
        let item = head.item.name;
        let index: Option<string> = Option.None;
        match head.index {
            Option.Some(x) { index = Option.Some(x.name); }
            Option.None {}
        }
        let kq = cf(a, "kq%", [ks]);
        this.cul("if %.stale(x%.len) {", [vl, ks]);
        this.upd.ind += 1;
        this.cul("let ap% = %.grew(x%.len);", [ks, vl, ks]);
        this.cul("if ap% {", [ks]);
        this.upd.ind += 1;
        this.cul("%.pk.begin();", [vl]);
        this.virtKey(item, index, key, ki, cf(a, "%.pk.add", [vl]), "0", cf(a, "%a", [ks]))?;
        this.virtKey(item, index, key, ki, cf(a, "%.pk.add", [vl]), cf(a, "%.n - 1", [vl]), cf(a, "%b", [ks]))?;
        this.cul("ap% = %.probeOk();", [ks, vl]);
        this.upd.ind -= 1;
        this.upd.line("}");
        this.cul("if ap% {", [ks]);
        this.upd.ind += 1;
        this.cul("for % in %.n..x%.len {", [kq, vl, ks]);
        this.upd.ind += 1;
        this.virtKey(item, index, key, ki, cf(a, "%.all.push", [vl]), kq, cf(a, "%c", [ks]))?;
        this.upd.ind -= 1;
        this.upd.set(this.fi, lo, e.head.hi);
        this.upd.line("}");
        this.cul("%.appended(x%.len);", [vl, ks]);
        this.upd.ind -= 1;
        this.upd.line("} else {");
        this.upd.ind += 1;
        this.cul("%.all.begin();", [vl]);
        this.cul("for % in 0..x%.len {", [kq, ks]);
        this.upd.ind += 1;
        this.virtKey(item, index, key, ki, cf(a, "%.all.add", [vl]), kq, cf(a, "%d", [ks]))?;
        this.upd.ind -= 1;
        this.upd.set(this.fi, lo, e.head.hi);
        this.upd.line("}");
        this.cul("%.all.finish(%);", [vl, this.hereLit(lo)]);
        this.cul("%.rebuilt(x%.len);", [vl, ks]);
        this.upd.ind -= 1;
        this.upd.line("}");
        this.upd.ind -= 1;
        this.upd.line("}");
        this.cul("let w% = vlist.step(d, %, &%, x%.len);", [ks, va.n, vl, ks]);
        this.cul("let m% = %.cnt;", [ks, vl]);
        match va.atEnd {
            Option.Some(r) {
                this.upd.pad();
                this.expr(Mode.U, r)?;
                this.cus(" = %.atEnd;\n", [vl]);
            }
            Option.None {}
        }
        return Result.Ok(true);
    }
}
