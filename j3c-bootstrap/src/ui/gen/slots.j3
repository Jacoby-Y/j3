// Slots a component use fills; dynamic `<component this=.. of=..>` lowered to a `{#match}` + enum.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/slots.rs
// J3: C2e chunk C. `Site` and `Slots` are in `gen.j3`. Rust `addr(e)` is `e.uid`. Renamed against UFCS clashes with `G` /
// `Rw` methods: `slot_elem` -> `slotElemOf`, `declared` -> `declaredSlots`. `lowerChoices` deep-copies the candidate
// element into each branch and gives every `Elem` / `IfNode` / `EachNode` of the copy a fresh uid from `*uid`
// (two branches must not share slot or pass state); it rewrites with `nodes.items[i] = ..`.
// J3: Chunk C's text helpers live here: `cf(a, "let % = %;", [x, y])` is Rust `format!` (`%` takes the next
// argument; no generated line of the tree walk has a `%`). `num`, `hasStr`, `joinStr` are chunk B's in `gen.j3`.
module j3c.ui.gen;

/// `pat` with each `%` replaced by the next of `args`, as an arena string (Rust `format!`).
/// Two formatters on purpose: `fm` (`gen.j3`, `$N`) for templates that repeat or reorder arguments or hold a
/// `%`; `cf` for the tree walk's lines, where arguments come once and in order.
pub fn cf(a: &Arena, pat: string, args: []string): string {
    let t = Text.new(a);
    let k = 0;
    for i in 0..pat.len {
        if pat[i] == '%' {
            t.add(args[k]);
            k += 1;
        } else {
            t.push(pat[i]);
        }
    }
    return t.str();
}

/// Index of the first attribute `name` of `e`, -1 when absent.
pub fn cattr(e: &Elem, name: string): int {
    for i in 0..e.attrs.len { if e.attrs.items[i].name == name { return i; } }
    return -1;
}

/// The text of a value that is exactly one literal part (`[Part::Lit(l)]`).
pub fn oneLit(v: &Value): Option<string> {
    match *v {
        Value.Str(p) {
            if p.items.len == 1 {
                match p.items.items[0] {
                    Part.Lit(l) { return Option.Some(l); }
                    Part.Hole(_) {}
                }
            }
        }
        Value.None {}
        Value.Expr(_) {}
    }
    return Option.None;
}

/// The `uid`s of the row elements of `nodes` (the elements `animate:flip` may sit on).
pub fn rowElems(nodes: &List<Node>, out: &List<int>) {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Elem(e) { out.push(e.uid); }
            Node.If(n) { for b in 0..n.branches.len { rowElems(&n.branches.items[b].nodes, out); } }
            Node.Let(_) {}
            Node.Text(_) {}
            Node.Each(_) {}
        }
    }
}

/// A value that is one literal string.
// The parser alternates literals and holes, so a value without a hole has at most one part.
pub fn litValue(v: &Value): Option<string> {
    match *v {
        Value.Str(p) {
            if p.items.len == 0 { return Option.Some(""); }
            if p.items.len == 1 {
                match p.items.items[0] {
                    Part.Lit(l) { return Option.Some(markup.uTrim(l)); }
                    Part.Hole(_) {}
                }
            }
        }
        Value.None {}
        Value.Expr(_) {}
    }
    return Option.None;
}

/// The `slot="x"` a node asks for, "" for the default slot.
pub fn slotOf(n: &Node): string {
    match slotElemOf(n) {
        Option.Some(e) {
            let k = cattr(&e, "slot");
            if k >= 0 {
                match litValue(&e.attrs.items[k].value) {
                    Option.Some(v) { return v; }
                    Option.None {}
                }
            }
        }
        Option.None {}
    }
    return "";
}

/// The element of a node that can carry `slot=` (Rust `slot_elem`).
pub fn slotElemOf(n: &Node): Option<Elem> {
    match *n {
        Node.Elem(e) { return Option.Some(e); }
        Node.If(i) {
            match i.choice {
                Option.Some(_) {
                    if i.branches.len > 0 && i.branches.items[0].nodes.len > 0 { return slotElemOf(&i.branches.items[0].nodes.items[0]); }
                }
                Option.None {}
            }
        }
        Node.Let(_) {}
        Node.Text(_) {}
        Node.Each(_) {}
    }
    return Option.None;
}

/// Add the `uid`s of the slotted elements of `n` to `out`.
pub fn markSlotted(n: &Node, out: &Set<int>) {
    match *n {
        Node.Elem(e) { out.add(e.uid); }
        Node.If(i) {
            match i.choice {
                Option.Some(_) { for b in 0..i.branches.len { markSlotted(&i.branches.items[b].nodes.items[0], out); } }
                Option.None {}
            }
        }
        Node.Let(_) {}
        Node.Text(_) {}
        Node.Each(_) {}
    }
}

/// The `<slot>` names `nodes` declare, in tree order ("" is the default; Rust `declared`).
pub fn declaredSlots(nodes: &List<Node>, out: &List<string>): Result<bool, UiError> {
    let a = out.arena;
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                if e.tag == "slot" {
                    let name = "";
                    for k in 0..e.attrs.len {
                        let at = e.attrs.items[k];
                        let ok = false;
                        if at.name == "name" {
                            match litValue(&at.value) {
                                Option.Some(v) {
                                    if v == "default" { return Result.Err(uiErr(at.range.lo, at.range.hi, "`<slot name=\"default\">` is the default slot: use `<slot />`")); }
                                    name = v;
                                    ok = true;
                                }
                                Option.None {}
                            }
                        }
                        if !ok { return Result.Err(uiErr(at.range.lo, at.range.hi, "`<slot>` takes only a plain `name=\"...\"`")); }
                    }
                    if hasStr(out, name) {
                        let msg = if name.len == 0 { "a component has one default `<slot />`" } else { cf(a, "two `<slot name=\"%\">` in one component", [name]) };
                        return Result.Err(uiErr(e.open.lo, e.open.hi, msg));
                    }
                    out.push(name);
                }
                declaredSlots(&e.children, out)?;
            }
            Node.If(n) { for b in 0..n.branches.len { declaredSlots(&n.branches.items[b].nodes, out)?; } }
            Node.Each(e) { declaredSlots(&e.body, out)?; }
        }
    }
    return Result.Ok(true);
}

/// Record every component use with children under `nodes` in `s` (`Site.id` is 1-based and project-wide). `decl[i]` is `all[i]`'s declared slots; `owner` is the using component's J3 name.
pub fn scanSites(nodes: &List<Node>, all: &List<Comp>, decl: &List<List<string>>, owner: string, s: &Slots): Result<bool, UiError> {
    let a = s.list.arena;
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Text(_) {}
            Node.Let(_) {}
            Node.Elem(e) {
                let ci_ = -1;
                if e.comp && e.children.len > 0 {
                    for c in 0..all.len { if all.items[c].name == e.tag { ci_ = c; break; } }
                }
                if ci_ >= 0 {
                    let want = &decl.items[ci_];
                    if want.len == 0 { return Result.Err(uiErr(e.open.lo, e.open.hi, cf(a, "`<%>` takes no children (it has no `<slot />`)", [e.tag]))); }
                    let names = List<string>.new(a);
                    for c in 0..e.children.len {
                        let ch = &e.children.items[c];
                        let at = e.open;
                        match slotElemOf(ch) {
                            Option.Some(ce) {
                                let k = cattr(&ce, "slot");
                                if k >= 0 {
                                    let sa = ce.attrs.items[k];
                                    let plain = false;
                                    match litValue(&sa.value) {
                                        Option.Some(v) { plain = v.len > 0; }
                                        Option.None {}
                                    }
                                    if !plain { return Result.Err(uiErr(sa.range.lo, sa.range.hi, "`slot` takes a plain name: `slot=\"footer\"`")); }
                                    markSlotted(ch, &s.slotted);
                                    at = sa.range;
                                }
                            }
                            Option.None {}
                        }
                        let nm = slotOf(ch);
                        if !hasStr(want, nm) {
                            let have = Text.new(a);
                            for w in 0..want.len {
                                if w > 0 { have.add(", "); }
                                have.add(if want.items[w].len == 0 { "default" } else { want.items[w] });
                            }
                            let msg = if nm.len == 0 { cf(a, "`<%>` has no default `<slot />` for these children", [e.tag]) } else { cf(a, "`<%>` has no `<slot name=\"%\">`", [e.tag, nm]) };
                            return Result.Err(uiErr(at.lo, at.hi, msg).withHelp(cf(a, "`%` slots: %", [e.tag, have.str()])));
                        }
                        if !hasStr(&names, nm) { names.push(nm); }
                    }
                    s.byUid.put(e.uid, s.list.len);
                    s.list.push(Site { id: s.list.len + 1, child: e.tag, owner: owner, names: names });
                }
                scanSites(&e.children, all, decl, owner, s)?;
            }
            Node.If(n) { for b in 0..n.branches.len { scanSites(&n.branches.items[b].nodes, all, decl, owner, s)?; } }
            Node.Each(e) { scanSites(&e.body, all, decl, owner, s)?; }
        }
    }
    return Result.Ok(true);
}

/// A deep copy of `nodes` in which every `Elem`, `IfNode` and `EachNode` has a fresh uid.
fn cloneNodes(nodes: &List<Node>, uid: &int, a: &Arena): List<Node> {
    let out = List<Node>.new(a);
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Let(l) { out.push(Node.Let(l)); }
            Node.Text(t) { out.push(Node.Text(t)); }
            Node.Elem(e) { out.push(Node.Elem(cloneElem(&e, uid, a))); }
            Node.If(n) {
                let bs = List<Branch>.new(a);
                for b in 0..n.branches.len {
                    let br = n.branches.items[b];
                    bs.push(Branch { cond: br.cond, vals: br.vals, nodes: cloneNodes(&br.nodes, uid, a) });
                }
                let id = *uid;
                *uid += 1;
                out.push(Node.If(IfNode { branches: bs, scrut: n.scrut, choice: n.choice, range: n.range, uid: id }));
            }
            Node.Each(e) {
                let id = *uid;
                *uid += 1;
                out.push(Node.Each(EachNode { head: e.head, body: cloneNodes(&e.body, uid, a), range: e.range, uid: id }));
            }
        }
    }
    return out;
}

// Attributes are shared with the original: nothing writes an `Attr` after the parse.
fn cloneElem(e: &Elem, uid: &int, a: &Arena): Elem {
    let id = *uid;
    *uid += 1;
    let attrs = List<Attr>.new(a);
    for i in 0..e.attrs.len { attrs.push(e.attrs.items[i]); }
    return Elem { tag: e.tag, comp: e.comp, attrs: attrs, children: cloneNodes(&e.children, uid, a), open: e.open, uid: id };
}

/// The `{...}` of attribute `name` on a `<component>`.
fn choiceExpr(e: &Elem, src: string, name: string, a: &Arena): Result<Range, UiError> {
    let k = cattr(e, name);
    if k >= 0 {
        match e.attrs.items[k].value {
            Value.Expr(r) { if markup.uTrim(src[r.lo..r.hi]).len > 0 { return Result.Ok(r); } }
            Value.None {}
            Value.Str(_) {}
        }
    }
    return Result.Err(uiErr(e.open.lo, e.open.hi, cf(a, "`<component>` needs `%={...}`", [name])));
}

/// Rewrite every `<component this={x} of={A, B}>` under `nodes` into a `{#match}` node with one branch per candidate; `sets` is byte-sorted by enum name (`choiceSetAt`).
pub fn lowerChoices(nodes: &List<Node>, src: string, known: &List<string>, sets: &List<ChoiceSet>, uid: &int, a: &Arena): Result<bool, UiError> {
    for i in 0..nodes.len {
        match nodes.items[i] {
            Node.Elem(e) {
                lowerChoices(&e.children, src, known, sets, uid, a)?;
                if e.tag != "component" { continue; }
                for k in 0..e.attrs.len {
                    let at = e.attrs.items[k];
                    for q in 0..k {
                        if e.attrs.items[q].name == at.name { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "duplicate attribute `%` on `<component>`", [at.name]))); }
                    }
                    if startsWith(at.name, pass.PREFIX) { return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "reserved attribute `%`", [at.name]))); }
                }
                let scrut = choiceExpr(&e, src, "this", a)?;
                let of = choiceExpr(&e, src, "of", a)?;
                let candidates = List<string>.new(a);
                let set = Text.new(a).add("Of_");
                let it = text.split(src[of.lo..of.hi], ",");
                while true {
                    let name = "";
                    match it.next() {
                        Option.Some(p) { name = markup.uTrim(p); }
                        Option.None { break; }
                    }
                    if !hasStr(known, name) { return Result.Err(uiErr(of.lo, of.hi, cf(a, "unknown component `%` in `of` (expected a comma-separated component list)", [name]))); }
                    if hasStr(&candidates, name) { return Result.Err(uiErr(of.lo, of.hi, cf(a, "duplicate component `%` in `of`", [name]))); }
                    if candidates.len > 0 { set.add("_"); }
                    for q in 0..name.len { set.push(if name[q] == '.' { '_' } else { name[q] }); }
                    candidates.push(name);
                }
                let at = 0;
                let have = choiceSetAt(sets, set.str(), &at);
                if have >= 0 {
                    let prev = &sets.items[have].candidates;
                    let same = prev.len == candidates.len;
                    if same { for q in 0..prev.len { if prev.items[q] != candidates.items[q] { same = false; } } }
                    if !same { return Result.Err(uiErr(of.lo, of.hi, cf(a, "candidate lists generate the same enum `%`; rename a component", [set.str()]))); }
                } else {
                    sets.insert(at, ChoiceSet { name: set.str(), candidates: candidates });
                }
                let branches = List<Branch>.new(a);
                for q in 0..candidates.len {
                    let child = cloneElem(&e, uid, a);
                    child.tag = candidates.items[q];
                    child.comp = true;
                    let attrs = List<Attr>.new(a);
                    for k in 0..e.attrs.len {
                        let n = e.attrs.items[k].name;
                        if n != "this" && n != "of" { attrs.push(e.attrs.items[k]); }
                    }
                    child.attrs = attrs;
                    let one = List<Node>.new(a);
                    one.push(Node.Elem(child));
                    branches.push(Branch { cond: Option.None, vals: List<Range>.new(a), nodes: one });
                }
                let id = *uid;
                *uid += 1;
                nodes.items[i] = Node.If(IfNode { branches: branches, scrut: Option.Some(scrut), choice: Option.Some(set.str()), range: e.open, uid: id });
            }
            Node.If(n) { for b in 0..n.branches.len { lowerChoices(&n.branches.items[b].nodes, src, known, sets, uid, a)?; } }
            Node.Each(e) { lowerChoices(&e.body, src, known, sets, uid, a)?; }
            Node.Text(_) {}
            Node.Let(_) {}
        }
    }
    return Result.Ok(true);
}
