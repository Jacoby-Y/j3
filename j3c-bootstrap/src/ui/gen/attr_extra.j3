// `animate:`, `anim-delay`, `bind:tooltip`, `triggers`, `noprimary`, `rich` and `bind:spans`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr_extra.rs
// J3: C2e chunk D. One slice of the `attr` chain; true when it handled the attribute.
module j3c.ui.gen;

/// `Css.eases` seeds the presets in this order.
const EASINGS: [7]string = ["ease", "linear", "ease-in", "ease-out", "ease-in-out", "bounce", "spring"];

extend G {
    /// One attribute family: true when it handled `a` (`name` is the attribute name, `n` the node variable).
    fn attrExtra(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if name == "animate:flip" {
            let ms: Option<Range> = Option.None;
            match a.value {
                Value.None {}
                Value.Expr(r) { ms = Option.Some(r); }
                Value.Str(_) { return Result.Err(attrErr(a, "`animate:flip` takes `={milliseconds}`")); }
            }
            let ease = 3; // ease-out
            for i in 0..e.attrs.len {
                let x = &e.attrs.items[i];
                if x.name != "animate-easing" { continue; }
                let l = "";
                match attrOneLit(x.value) {
                    Option.Some(s) { l = s; }
                    Option.None {}
                }
                ease = -1;
                for k in 0..EASINGS.len { if EASINGS[k] == l { ease = k; break; } }
                if ease < 0 {
                    return Result.Err(attrErr(x, "`animate-easing` takes one of \"ease\", \"linear\", \"ease-in\", \"ease-out\", \"ease-in-out\", \"bounce\", \"spring\""));
                }
                break;
            }
            this.upd.pad();
            this.aHead("flip", n);
            match ms {
                Option.None { this.upd.s("200.0"); }
                Option.Some(r) {
                    this.upd.s("f32(");
                    this.expr(Mode.U, r)?;
                    this.upd.s(")");
                }
            }
            let t = Text.new(this.a).add(", ");
            t.pushInt(ease);
            this.upd.s(t.add(");\n").str());
        } else if name == "anim-delay" {
            match a.value {
                Value.Expr(r) {
                    this.upd.pad();
                    this.aHead("animDelay", n);
                    this.upd.s("f32(");
                    this.expr(Mode.U, r)?;
                    this.upd.s("));\n");
                }
                Value.None { return Result.Err(attrErr(a, "`anim-delay` takes `={milliseconds}`")); }
                Value.Str(_) { return Result.Err(attrErr(a, "`anim-delay` takes `={milliseconds}`")); }
            }
        } else if name == "bind:tooltip" {
            match a.value {
                Value.Expr(r) {
                    this.placeCheck(r)?;
                    if !tooltipChild(&e.children) {
                        return Result.Err(attrErr(a, "`bind:tooltip` needs a direct child with bare `popover`, usually `{#if card}<div popover>...</div>{/if}` inside an owner wrapper"));
                    }
                    this.upd.pad();
                    this.expr(Mode.U, r)?;
                    this.upd.s(" = d.hoverCard(");
                    this.upd.s(n);
                    this.upd.s(");\n");
                }
                Value.None { return Result.Err(attrErr(a, "`bind:tooltip` needs `={boolean_place}`")); }
                Value.Str(_) { return Result.Err(attrErr(a, "`bind:tooltip` needs `={boolean_place}`")); }
            }
        } else if name == "triggers" {
            // the characters that start a trigger for `on:trigger` (a literal: the box keeps it as a view)
            if !attrHas(e, "on:trigger") { return Result.Err(attrErr(a, "`triggers` needs `on:trigger` on the same element")); }
            let ok = false;
            match attrOneLit(a.value) {
                Option.Some(l) { ok = l.len > 0; }
                Option.None {}
            }
            if !ok { return Result.Err(attrErr(a, "`triggers` takes a literal such as `triggers=\"@:#\"`")); }
            this.strAttr(a, "attrTriggers", n)?;
        } else if name == "noprimary" {
            // the box neither sets PRIMARY on select nor pastes it on a middle click
            let textBox = e.tag == "textarea";
            if e.tag == "input" {
                match inputType(e) {
                    Option.Some(t) { textBox = t == "text" || t == "search" || t == "password" || t == "email" || t == "number" || t == "textarea"; }
                    Option.None {}
                }
            }
            if !textBox { return Result.Err(attrErr(a, "`noprimary` is for text boxes (`<input type=\"text\">`, `<textarea>`)")); }
            if !attrIsNone(a.value) { return Result.Err(attrErr(a, "`noprimary` takes no value")); }
            this.aLine("d.attrNoPrimary(", n, ", true);");
        } else if name == "rich" || name == "bind:spans" {
            // a `rich` textarea keeps styled spans and atomic tokens beside its text (`j3.ui.spans.Span`)
            let area = false;
            match inputType(e) {
                Option.Some(t) { area = t == "textarea"; }
                Option.None {}
            }
            if !area { return Result.Err(attrErr(a, this.aMsg("`", name, "` is for `<textarea rich>`"))); }
            if name == "rich" {
                if !attrIsNone(a.value) { return Result.Err(attrErr(a, "`rich` takes no value")); }
                this.aLine("d.attrRich(", n, ", true);");
            } else {
                if !attrHas(e, "rich") { return Result.Err(attrErr(a, "`bind:spans` needs `rich` on the `<textarea>`")); }
                match a.value {
                    Value.Expr(r) {
                        this.placeCheck(r)?;
                        this.aWriteBack("changed", "spansValue", n, r)?;
                        this.aCall("attrSpans", n, r)?;
                    }
                    Value.None { return Result.Err(attrErr(a, "`bind:spans` needs `={place}` holding a `[]Span` (`use j3.ui.spans.Span;`)")); }
                    Value.Str(_) { return Result.Err(attrErr(a, "`bind:spans` needs `={place}` holding a `[]Span` (`use j3.ui.spans.Span;`)")); }
                }
            }
        } else {
            return Result.Ok(false);
        }
        return Result.Ok(true);
    }
}
