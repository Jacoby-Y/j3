// The state a container holds (the component, or one `{#each}` row struct): fields, initial values, resets, destroys.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/assemble.rs
// J3: C2e chunk B. Also called by chunk C (`control.j3`, `comp.j3`). Container 0 is the component.
module j3c.ui.gen;

fn tyIs(ty: Option<string>, s: string): bool {
    match ty {
        Option.Some(t) { return t == s; }
        Option.None { return false; }
    }
    return false;
}

extend G {
    /// Struct fields for the state held by container `cont` (0 is the component, else a row).
    fn stateFields(this: &G, cont: int): string {
        let a = this.a;
        let name = this.c.id;
        let o = Text.new(a);
        for i in 0..this.insts.len {
            let x = this.insts.items[i];
            if x.container == cont { o.add(fm(a, "    c$0: $1;\n", [num(a, x.id), x.comp])); }
        }
        for i in 0..this.ifs.len {
            let x = this.ifs.items[i];
            if x.container == cont { o.add(fm(a, "    if$0: int;\n", [num(a, x.id)])); }
        }
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container != cont { continue; }
            let k = num(a, x.k);
            o.add(fm(a, "    ua$0: int;\n    us$0: int;\n", [k]));
            match x.ty {
                Option.Some(t) {
                    if t == "string" { o.add(fm(a, "    up$0: []u8;\n    ul$0: int;\n", [k])); }
                    else { o.add(fm(a, "    up$0: $1;\n", [k, t])); }
                }
                Option.None {}
            }
        }
        for i in 0..this.binds.len {
            let x = this.binds.items[i];
            if x.container == cont { o.add(fm(a, "    bh$0: int;\n", [num(a, x.k)])); }
        }
        for i in 0..this.eachs.len {
            let e = this.eachs.items[i];
            if e.container != cont { continue; }
            let id = num(a, e.id);
            o.add(fm(a, "    cnt$0: int;\n", [id]));
            if e.rows { o.add(fm(a, "    e$1: List<&$0_R$1>;\n    fp$1: List<&$0_R$1>;\n", [name, id])); }
            if e.keyed { o.add(fm(a, "    eb$1: List<&$0_R$1>;\n    kd$1: Keyed;\n", [name, id])); }
            if e.virt { o.add(fm(a, "    vl$0: VList;\n", [id])); }
        }
        return o.str();
    }

    /// Initial values for `stateFields`, as struct-literal lines (`mem` is in scope).
    fn stateInits(this: &G, cont: int): string {
        let a = this.a;
        let name = this.c.id;
        let o = Text.new(a);
        for i in 0..this.insts.len {
            let x = this.insts.items[i];
            if x.container == cont { o.add(fm(a, "            c$0: $1.new(mem),\n", [num(a, x.id), x.comp])); }
        }
        for i in 0..this.ifs.len {
            let x = this.ifs.items[i];
            if x.container == cont { o.add(fm(a, "            if$0: -1,\n", [num(a, x.id)])); }
        }
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container != cont { continue; }
            let k = num(a, x.k);
            o.add(fm(a, "            ua$0: -1,\n            us$0: 0,\n", [k]));
            match x.ty {
                Option.Some(t) {
                    if t == "string" { o.add(fm(a, "            up$0: mem.alloc::<u8>(0),\n            ul$0: 0,\n", [k])); }
                    else { o.add(fm(a, "            up$0: $1,\n", [k, evDefault(t)])); }
                }
                Option.None {}
            }
        }
        for i in 0..this.binds.len {
            let x = this.binds.items[i];
            if x.container == cont { o.add(fm(a, "            bh$0: -1,\n", [num(a, x.k)])); }
        }
        for i in 0..this.eachs.len {
            let e = this.eachs.items[i];
            if e.container != cont { continue; }
            let id = num(a, e.id);
            o.add(fm(a, "            cnt$0: 0,\n", [id]));
            if e.rows { o.add(fm(a, "            e$1: List<&$0_R$1>.new(mem),\n            fp$1: List<&$0_R$1>.new(mem),\n", [name, id])); }
            if e.keyed { o.add(fm(a, "            eb$1: List<&$0_R$1>.new(mem),\n            kd$1: Keyed.new(mem),\n", [name, id])); }
            if e.virt { o.add(fm(a, "            vl$0: VList.new(mem),\n", [id])); }
        }
        return o.str();
    }

    /// Fresh state for container `cont` without allocating: components reset, `{#if}`s unset, lists emptied
    /// (their dead rows go to the pool).
    fn stateResets(this: &G, cont: int, who: string): string {
        let a = this.a;
        let o = Text.new(a);
        for i in 0..this.insts.len {
            let x = this.insts.items[i];
            if x.container == cont { o.add(fm(a, "        $0.c$1.j3Reset();\n", [who, num(a, x.id)])); }
        }
        for i in 0..this.ifs.len {
            let x = this.ifs.items[i];
            if x.container == cont { o.add(fm(a, "        $0.if$1 = -1;\n", [who, num(a, x.id)])); }
        }
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container != cont { continue; }
            o.add(fm(a, "        $0.ua$1 = -1;\n        $0.us$1 = 0;\n", [who, num(a, x.k)]));
            if tyIs(x.ty, "string") { o.add(fm(a, "        $0.ul$1 = 0;\n", [who, num(a, x.k)])); }
        }
        for i in 0..this.binds.len {
            let x = this.binds.items[i];
            if x.container == cont { o.add(fm(a, "        $0.bh$1 = -1;\n", [who, num(a, x.k)])); }
        }
        for i in 0..this.eachs.len {
            let e = this.eachs.items[i];
            if e.container != cont { continue; }
            let id = num(a, e.id);
            o.add(fm(a, "        $0.cnt$1 = 0;\n", [who, id]));
            if e.rows { o.add(fm(a, "        for q$1 in 0..$0.e$1.len {\n            $0.fp$1.push($0.e$1.items[q$1]);\n        }\n        $0.e$1.len = 0;\n", [who, id])); }
            if e.keyed { o.add(fm(a, "        $0.eb$1.len = 0;\n        $0.kd$1.reset();\n", [who, id])); }
            if e.virt { o.add(fm(a, "        $0.vl$1.reset();\n", [who, id])); }
        }
        return o.str();
    }

    /// `destroy()` calls for what container `cont` holds: components, then every row of its lists.
    fn stateDestroy(this: &G, cont: int, who: string): string {
        let a = this.a;
        let o = Text.new(a);
        // a row reaches its component through `comp`
        let comp = if cont == 0 { "this" } else { fm(a, "(($0.comp as ptr) as &$1)", [who, this.c.id]) };
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container == cont && x.destroy {
                o.add(fm(a, "        if $0.ua$1 >= 0 && $0.us$1 == 1 {\n            $2.$3_destroy($0.ua$1);\n        }\n", [who, num(a, x.k), comp, x.name]));
            }
        }
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container == cont { o.add(fm(a, "        $0.ua$1 = -1;\n        $0.us$1 = 0;\n", [who, num(a, x.k)])); }
        }
        for i in 0..this.insts.len {
            let x = this.insts.items[i];
            if x.container == cont { o.add(fm(a, "        $0.c$1.destroy();\n", [who, num(a, x.id)])); }
        }
        for i in 0..this.eachs.len {
            let e = this.eachs.items[i];
            if e.container != cont || !e.rows { continue; }
            o.add(fm(a, "        for q$1 in 0..$0.e$1.len {\n            $0.e$1.items[q$1].destroy();\n        }\n", [who, num(a, e.id)]));
        }
        return o.str();
    }

    /// The `.j3ui` path the hot-reload code watches for this component's `<style>`.
    fn stylePath(this: &G): string { return this.files.items[this.fi].path; }
}
