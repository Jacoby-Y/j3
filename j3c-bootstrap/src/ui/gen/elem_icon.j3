// `<icon>`, string / number attributes, `style:prop`, `use:` actions and the end-of-build sweep. Split from
// `elem.j3` (file size).
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/elem.rs
// J3: C2e chunk C. `strAttr`, `numAttr`, `styleVal`, `styleAttr`, `action` are called by chunk D's attribute
// families. `styleAttr` finds its attribute among the `style:` ones by source position (Rust: by address).
// `csslint::line_col` is `lineAt` + the column here (csslint itself is C5).
module j3c.ui.gen;

const STYLE_SHORTHAND: [16]string = ["padding", "margin", "inset", "border", "border-color", "border-width", "border-radius", "border-top", "border-right", "border-bottom", "border-left", "overflow", "gap", "background", "text-stroke", "text-wave"];

/// The `"..."` literals in an expression's text (icon names in `name={...}`).
fn stringLiterals(t: string, a: &Arena): List<string> {
    let out = List<string>.new(a);
    let it = text.split(t, "\"");
    let odd = false;
    while true {
        match it.next() {
            Option.Some(s) { if odd && !hasStr(&out, s) { out.push(s); } }
            Option.None { break; }
        }
        odd = !odd;
    }
    return out;
}

/// The parameter types of a script fn, as written (`fn f(node: int, p: T)` gives `int`, `T`).
fn paramTypes(src: string, f: &FnDef, a: &Arena): List<string> {
    let out = List<string>.new(a);
    let t = markup.uTrim(src[f.params.lo..f.params.hi]);
    if t.len == 0 { return out; }
    let it = text.split(t, ",");
    while true {
        match it.next() {
            Option.Some(x) {
                let parts = text.split(x, ":");
                let ty = "";
                match parts.next() { Option.Some(_) {} Option.None {} }
                match parts.next() { Option.Some(y) { ty = markup.uTrim(y); } Option.None {} }
                out.push(ty);
            }
            Option.None { break; }
        }
    }
    return out;
}

fn sameStrs(x: &List<string>, y: &List<string>): bool {
    if x.len != y.len { return false; }
    for i in 0..x.len { if x.items[i] != y.items[i] { return false; } }
    return true;
}

fn hasRet(f: &FnDef): bool {
    match f.ret {
        Option.Some(_) { return true; }
        Option.None { return false; }
    }
    return false;
}

extend G {
    /// The script fn called `name`, -1 when there is none.
    fn scriptFnAt(this: &G, name: string): int {
        for i in 0..this.c.sc.fns.len { if this.c.sc.fns.items[i].name == name { return i; } }
        return -1;
    }

    /// `<icon name="trash">` or `name={done ? "check" : "circle"}`: every name is checked here and its
    /// data goes into a `name\tdata` table literal that `Dom.attrIcon` picks from.
    fn icon(this: &G, e: &Elem, n: string): Result<bool, UiError> {
        let a = this.a;
        if e.children.len > 0 {
            let at = firstChildAt(e);
            return Result.Err(uiErr(at.lo, at.hi, "`<icon>` takes no children"));
        }
        let ni = cattr(e, "name");
        if ni < 0 {
            return Result.Err(uiErr(e.open.lo, e.open.hi, "`<icon>` needs `name=\"trash\"` (a Bootstrap Icons id, or a file in the project's icons/)").withHelp("`j3c doc icons` lists the names; `j3c doc icons <word>` filters them"));
        }
        let at = &e.attrs.items[ni];
        let names = List<string>.new(a);
        match at.value {
            Value.Str(_) {
                match oneLit(&at.value) {
                    Option.Some(l) { names.push(markup.uTrim(l)); }
                    Option.None { return Result.Err(uiErr(at.range.lo, at.range.hi, "`name` can't have `{}` holes").withHelp("write `name={if done { \"check\" } else { \"x\" }}`: the names must be string literals so their data can be copied in")); }
                }
            }
            Value.Expr(r) {
                names = stringLiterals(this.src[r.lo..r.hi], a);
                if names.len == 0 {
                    return Result.Err(uiErr(at.range.lo, at.range.hi, "`name={...}` has no string literals to take icons from").withHelp("write the names as literals in the expression: `name={if on { \"volume-up\" } else { \"volume-mute\" }}`"));
                }
            }
            Value.None { return Result.Err(uiErr(at.range.lo, at.range.hi, "`name` needs a value")); }
        }
        let table = Text.new(a);
        for i in 0..names.len {
            let name = names.items[i];
            match icons.find(name, this.icons) {
                Option.Some(data) { table.add(name).add("\t").add(data).add("\n"); }
                Option.None {
                    let sug = icons.suggest(name, this.icons, a);
                    let near = Text.new(a);
                    for q in 0..sug.len {
                        if q > 0 { near.add(", "); }
                        near.add("`").add(sug.items[q]).add("`");
                    }
                    return Result.Err(uiErr(at.range.lo, at.range.hi, cf(a, "unknown icon `%`", [name])).withHelp(cf(a, "did you mean %? `j3c doc icons <word>` searches the names; your own go in icons/<name>.svg", [near.str()])));
                }
            }
        }
        this.upd.set(this.fi, at.range.lo, at.range.hi);
        this.upd.pad();
        this.cus("d.attrIcon(%, ", [n]);
        match at.value {
            Value.Expr(r) { this.expr(Mode.U, r)?; }
            Value.Str(_) { this.upd.s(lit(names.items[0], a)); }
            Value.None {}
        }
        this.upd.s(", ");
        this.upd.s(lit(table.str(), a));
        this.upd.s(");\n");
        return Result.Ok(true);
    }

    /// A string attribute: literal text, `"a {b}"`, or `{expr}`, passed to `d.<call>(n, s)`.
    fn strAttr(this: &G, a: &Attr, call: string, n: string): Result<bool, UiError> {
        this.upd.pad();
        this.cus("d.%(%, ", [call, n]);
        match a.value {
            Value.Str(p) {
                // a template string dies when `update` returns, and `value` is kept as a view
                if call == "attrText" {
                    for i in 0..p.items.len {
                        match p.items.items[i] {
                            Part.Hole(_) { return Result.Err(uiErr(a.range.lo, a.range.hi, "`value` text can't have `{}` holes").withHelp("use `value={expr}` with a `string` that outlives the frame")); }
                            Part.Lit(_) {}
                        }
                    }
                }
                this.strParts(Mode.U, &p.items, a.range)?;
            }
            Value.Expr(r) { this.expr(Mode.U, r)?; }
            Value.None { return Result.Err(uiErr(a.range.lo, a.range.hi, cf(this.a, "`%` needs a value", [a.name]))); }
        }
        this.upd.s(");\n");
        return Result.Ok(true);
    }

    /// A number attribute: `{expr}` or a literal number, passed to `d.<call>(n, f32(..))`.
    fn numAttr(this: &G, a: &Attr, call: string, n: string): Result<bool, UiError> {
        this.upd.pad();
        this.cus("d.%(%, f32(", [call, n]);
        let ok = false;
        match a.value {
            Value.Expr(r) {
                this.expr(Mode.U, r)?;
                ok = true;
            }
            Value.Str(_) {
                match oneLit(&a.value) {
                    Option.Some(l) {
                        if isNumber(l) {
                            this.upd.s(markup.uTrim(l));
                            ok = true;
                        }
                    }
                    Option.None {}
                }
            }
            Value.None {}
        }
        if !ok { return Result.Err(uiErr(a.range.lo, a.range.hi, cf(this.a, "`%` needs a number: `%={expr}`", [a.name, a.name]))); }
        this.upd.s("));\n");
        return Result.Ok(true);
    }

    /// `style:prop={number}` or `style:prop="css {value}"` (or `={"text"}`): an inline style, `d.styleNum` / `d.styleStr`.
    /// Checks `style:prop` and says whether its value is a number (`={n}`) or text.
    fn styleVal(this: &G, a: &Attr, prop: string): Result<bool, UiError> {
        let ar = this.a;
        let longhand = false;
        let it = text.split(this.cssProps, " ");
        while true {
            match it.next() {
                Option.Some(p) { if p == prop { longhand = true; break; } }
                Option.None { break; }
            }
        }
        let shorthand = inList(STYLE_SHORTHAND[0..STYLE_SHORTHAND.len], prop);
        if startsWith(prop, "animation") || startsWith(prop, "transition") || startsWith(prop, "-") || startsWith(prop, "grid-") || !(longhand || shorthand) {
            return Result.Err(uiErr(a.range.lo, a.range.hi, cf(ar, "`style:%` is not a CSS property that can be set inline", [prop])).withHelp("any property of `j3c doc css` except `animation`, `transition`, grid properties and custom properties"));
        }
        match a.value {
            Value.Expr(r) {
                let t = markup.uTrim(this.src[r.lo..r.hi]);
                if t.len > 0 && (t[0] == '"' || t[0] == '`') { return Result.Ok(false); }
                // `gap` is in the longhand list (column gap) but `style:gap={n}` would set only that one, so a shorthand is text
                if !longhand || shorthand {
                    return Result.Err(uiErr(a.range.lo, a.range.hi, cf(ar, "`style:%` is a shorthand: give it text, `style:%=\"{v}px\"`", [prop, prop])));
                }
                return Result.Ok(true);
            }
            Value.None { return Result.Err(uiErr(a.range.lo, a.range.hi, cf(ar, "`style:%` needs a value: `style:%={number}` or `style:%=\"text\"`", [prop, prop, prop]))); }
            Value.Str(_) {}
        }
        return Result.Ok(false);
    }

    /// `style:prop` on node `n`: `d.styleNumAt` / `d.styleStrAt` with the attribute's place for warnings.
    fn styleAttr(this: &G, e: &Elem, a: &Attr, prop: string, n: string): Result<bool, UiError> {
        let ar = this.a;
        let isNum = this.styleVal(a, prop)?;
        let k = 0;
        let seen = 0;
        for i in 0..e.attrs.len {
            let x = &e.attrs.items[i];
            if !startsWith(x.name, "style:") { continue; }
            if x.range.lo == a.range.lo { k = seen; break; }
            seen += 1;
        }
        if k >= 8 { return Result.Err(uiErr(a.range.lo, a.range.hi, "an element takes at most 8 `style:` attributes")); }
        // where a bad value warns: the attribute in the `.j3ui`
        let pos = if a.range.lo < this.src.len { a.range.lo } else { this.src.len };
        let bol = pos;
        while bol > 0 && this.src[bol - 1] != '\n' { bol -= 1; }
        let at = cf(ar, "%, %, %", [lit(this.files.items[this.fi].path, ar), num(ar, lineAt(this.src, pos)), num(ar, pos - bol + 1)]);
        let ks = num(ar, k);
        let pl = lit(prop, ar);
        this.upd.pad();
        match a.value {
            Value.Expr(r) {
                if isNum {
                    this.cus("d.styleNumAt(%, %, %, f32(", [n, ks, pl]);
                    this.expr(Mode.U, r)?;
                    this.cus("), %);\n", [at]);
                } else {
                    this.cus("d.styleStrAt(%, %, %, ", [n, ks, pl]);
                    this.expr(Mode.U, r)?;
                    this.cus(", %);\n", [at]);
                }
            }
            Value.Str(p) {
                this.cus("d.styleStrAt(%, %, %, ", [n, ks, pl]);
                this.strParts(Mode.U, &p.items, a.range)?;
                this.cus(", %);\n", [at]);
            }
            Value.None {} // refused by `styleVal`
        }
        return Result.Ok(true);
    }

    /// `use:name={param}` / `use:name` on element `n`: `fn name(node: int, param: T)` runs on the first build after the element's first layout
    /// (so it can measure), `name_update(node, param)` when the parameter changes, `name_destroy(node)` once the element is gone.
    fn action(this: &G, a: &Attr, an: string, n: string): Result<bool, UiError> {
        let ar = this.a;
        let fi = this.scriptFnAt(an);
        if fi < 0 {
            let help = if contains(an, ".") { "a dotted module function isn't supported: wrap it in a script `fn`" } else { cf(ar, "add `fn %(node: int, param: T) { ... }` to the script", [an]) };
            return Result.Err(uiErr(a.range.lo, a.range.hi, cf(ar, "`use:%` needs a script fn `%`", [an, an])).withHelp(help));
        }
        let f = &this.c.sc.fns.items[fi];
        let want = 2;
        match a.value { Value.None { want = 1; } Value.Expr(_) {} Value.Str(_) {} }
        let t = paramTypes(this.src, f, ar);
        let sig = if want == 1 { cf(ar, "fn %(node: int)", [an]) } else { cf(ar, "fn %(node: int, param: T)", [an]) };
        if t.len != want || t.items[0] != "int" || hasRet(f) {
            return Result.Err(uiErr(f.nameR.lo, f.nameR.hi, cf(ar, "`use:%` calls `%`, with no return type", [an, sig])).withHelp("the first parameter is the element's handle"));
        }
        let ty = "";
        if want == 2 {
            ty = t.items[1];
            if !isEvType(ty) {
                return Result.Err(uiErr(f.nameR.lo, f.nameR.hi, cf(ar, "the parameter of `%` is `%`, but a `use:` parameter is a plain value", [an, ty])).withHelp(cf(ar, "types: %", [joinArr(ar, EV_TYPES[0..EV_TYPES.len], ", ")])));
            }
        }
        let upn = cf(ar, "%_update", [an]);
        let ui = this.scriptFnAt(upn);
        if ui >= 0 {
            let u = &this.c.sc.fns.items[ui];
            let ut = paramTypes(this.src, u, ar);
            if !sameStrs(&ut, &t) || hasRet(u) {
                let scratch = Text.new(ar);
                return Result.Err(uiErr(u.nameR.lo, u.nameR.hi, cf(ar, "`%` must take the same parameters as `%`: `%`", [upn, an, text.replace(&scratch, sig, an, upn)])));
            }
            if want == 1 { return Result.Err(uiErr(u.nameR.lo, u.nameR.hi, cf(ar, "`%` never runs: `use:%` has no parameter to change", [upn, an]))); }
        }
        let dn = cf(ar, "%_destroy", [an]);
        let di = this.scriptFnAt(dn);
        if di >= 0 {
            let u = &this.c.sc.fns.items[di];
            let pt = paramTypes(this.src, u, ar);
            if pt.len != 1 || pt.items[0] != "int" || hasRet(u) {
                return Result.Err(uiErr(u.nameR.lo, u.nameR.hi, cf(ar, "`%` must be `fn %(node: int)`", [dn, dn])));
            }
        }
        let k = this.nk();
        let ks = num(ar, k);
        let o = this.owner();
        let h = cf(ar, "uh%", [ks]);
        this.cul("let % = d.handle(%);", [h, n]);
        if want == 2 {
            match a.value {
                Value.Expr(r) {
                    this.upd.pad();
                    this.cus("let pv%: % = ", [ks, ty]);
                    this.expr(Mode.U, r)?;
                    this.upd.s(";\n");
                }
                Value.None {}
                Value.Str(_) {}
            }
        }
        let args = if want == 2 { cf(ar, "%, pv%", [h, ks]) } else { h };
        let gone = if di >= 0 { cf(ar, "if %.us% == 1 { this.%(%.ua%); } ", [o, ks, dn, o, ks]) } else { "" };
        this.cul("if %.ua% != % { %%.ua% = %; %.us% = 0; }", [o, ks, h, gone, o, ks, h, o, ks]);
        let keep = "";
        if want == 2 {
            keep = if ty == "string" { cf(ar, "%.up% = d.strPut(%.up%, pv%); %.ul% = pv%.len; ", [o, ks, o, ks, ks, o, ks, ks]) } else { cf(ar, "%.up% = pv%; ", [o, ks, ks]) };
        }
        this.cul("else if %.us% == 0 { %.us% = 1; %this.%(%); }", [o, ks, o, ks, keep, an, args]);
        if ui >= 0 {
            let diff = if ty == "string" { cf(ar, "!d.strHas(%.up%, %.ul%, pv%)", [o, ks, o, ks, ks]) } else { cf(ar, "%.up% != pv%", [o, ks, ks]) };
            this.cul("else if % { %this.%(%); }", [diff, keep, upn, args]);
        }
        let tyo: Option<string> = Option.None;
        if want == 2 { tyo = Option.Some(ty); }
        this.acts.push(ActDef { k: k, container: this.cont(), name: an, ty: tyo, destroy: di >= 0 });
        return Result.Ok(true);
    }

    /// End of a container's build (`who` is `this` or the row): run `name_destroy` for the `use:`s of container `cont` whose element is
    /// gone, and put `bind:this` places whose element went back to -1.
    fn actSweep(this: &G, cont: int, who: string): Result<bool, UiError> {
        let ar = this.a;
        for i in 0..this.acts.len {
            let x = this.acts.items[i];
            if x.container != cont { continue; }
            let ks = num(ar, x.k);
            let call = if x.destroy { cf(ar, "if %.us% == 1 { this.%_destroy(%.ua%); } ", [who, ks, x.name, who, ks]) } else { "" };
            this.cul("if %.ua% >= 0 && !d.alive(%.ua%) { %%.ua% = -1; %.us% = 0; }", [who, ks, who, ks, call, who, ks, who, ks]);
        }
        // a place something else has written since is left alone
        let nb = this.binds.len;
        for i in 0..nb {
            let b = this.binds.items[i];
            if b.container != cont { continue; }
            let ks = num(ar, b.k);
            this.upd.pad();
            this.cus("if %.bh% >= 0 && !d.alive(%.bh%) { if ", [who, ks, who, ks]);
            this.expr(Mode.U, b.place)?;
            this.cus(" == %.bh% { ", [who, ks]);
            this.expr(Mode.U, b.place)?;
            this.cus(" = -1; } %.bh% = -1; }\n", [who, ks, who, ks]);
        }
        return Result.Ok(true);
    }
}
