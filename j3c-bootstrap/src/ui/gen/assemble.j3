// Put a component's pieces together: the struct, `Props`, `Events`, `new`, `styles`, `render`, `hot`, `update`, `paint`.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/assemble.rs
// J3: C2e chunk B. `assemble` is split at Rust's own comment seams into `asmTypes` (to the row structs), `asmNew`
// (the struct, `new`, `j3Reset`, `styles`, `init`), `asmRoot` (`render`, `hot`) and `asmUpdate` (`update`, `destroy`,
// `paint`, `slotHas_*`) in `assemble_body.j3`; the `state*` helpers (also called by chunk C) are in `assemble_state.j3`.
// Rust `format!` is `fm` (`$0` is always the component's J3 name here).
module j3c.ui.gen;

extend G {
    /// Wrap `upd` / `pnt` and the script fns `fns` into the component's text (Rust `assemble`).
    fn assemble(this: &G, fns: &Out): Result<Out, UiError> {
        let o = Out.new(this.a, this.fi);
        this.asmTypes(&o)?;
        let bridge = (this.ownsSlot || this.names.emitting.len > 0) && this.c.sc.events.len > 0;
        this.asmNew(&o, bridge)?;
        o.append(fns);
        o.append(&this.slotFns);
        if this.root { this.asmRoot(&o); }
        this.asmUpdate(&o, bridge);
        return Result.Ok(o);
    }

    /// The header consts, `Props`, `Events`, script `const`s, event structs and row structs.
    fn asmTypes(this: &G, o: &Out): Result<bool, UiError> {
        let a = this.a;
        let c = this.c;
        let name = c.id;
        let src = this.src;
        let fi = this.fi;
        o.s(fm(a, "// ---- $0\n", [this.files.items[fi].path]));
        o.s(fm(a, "pub const SCOPE_$0: int = $1;\n", [name, num(a, c.scope)]));
        match c.mk.style {
            Option.Some(r) {
                o.set(fi, r.lo, r.hi);
                let lo = r.lo;
                let hi = r.hi;
                while lo < hi && src[lo] == '\n' { lo += 1; }
                while hi > lo && src[hi - 1] == '\n' { hi -= 1; }
                o.s(fm(a, "const CSS_$0: string = $1;\n", [name, lit(src[lo..hi], a)]));
                // lines above the trimmed style text: `file:line` of rules and warnings are the `.j3ui`'s own
                let lines = 0;
                for i in 0..lo { if src[i] == '\n' { lines += 1; } }
                o.s(fm(a, "const LINE0_$0: int = $1;\n", [name, num(a, lines)]));
            }
            Option.None { o.s(fm(a, "const CSS_$0: string = \"\";\nconst LINE0_$0: int = 0;\n", [name])); }
        }
        o.set(fi, 0, 0);
        o.s(fm(a, "\npub struct $0Props {\n", [name]));
        for i in 0..c.sc.props.len {
            let p = c.sc.props.items[i];
            o.set(fi, p.nameR.lo, p.nameR.hi);
            o.s(fm(a, "    $0: ", [p.name]));
            match p.hidden {
                Option.Some(t) { o.s(t); }
                Option.None { o.copy(fi, src, p.ty.lo, p.ty.hi); }
            }
            o.s(";\n");
        }
        o.set(fi, 0, 0);
        match this.slots.pass.get(c.name) {
            Option.Some(pi) { o.s(pass.fields(pi, a)); }
            Option.None {}
        }
        o.s(fm(a, "}\n\npub struct $0Events {\n", [name]));
        for i in 0..c.sc.events.len {
            let e = c.sc.events.items[i];
            o.set(fi, e.r.lo, e.r.hi);
            o.s(fm(a, "    $0: bool;\n", [e.name]));
            for k in 0..c.sc.evParams.len {
                let p = c.sc.evParams.items[k];
                if p.ev != e.name { continue; }
                o.set(fi, p.nameR.lo, p.nameR.hi);
                o.s(fm(a, "    $0_$1: ", [e.name, p.name]));
                o.copy(fi, src, p.ty.lo, p.ty.hi);
                o.s(";\n");
            }
        }
        o.set(fi, 0, 0);
        o.s("}\n\n");
        // `const`: a literal is a module const; anything else (an array) is a singleton filled by `styles`
        // (J3 consts hold scalars only), which runs before the first `update`
        for i in 0..c.sc.consts.len {
            let l = c.sc.consts.items[i];
            let ty = l.guess;
            match l.ty {
                Option.Some(t) { ty = src[t.lo..t.hi]; }
                Option.None {
                    if l.guess.len == 0 {
                        return Result.Err(uiErr(l.nameR.lo, l.nameR.hi, fm(a, "can't tell the type of `const $0`", [l.name])).withHelp(fm(a, "write it out: `const $0: Type = ...;`", [l.name])));
                    }
                }
            }
            o.set(fi, l.nameR.lo, l.nameR.hi);
            if l.guess.len > 0 {
                o.s(fm(a, "const $0_$1: $2 = ", [name, l.name, ty]));
                o.copy(fi, src, l.init.lo, l.init.hi);
                o.s(";\n\n");
            } else {
                o.s(fm(a, "#[singleton]\nlet $0_$1: $2;\n\n", [name, l.name, ty]));
            }
        }
        o.set(fi, 0, 0);
        // what `on:name` sees as `event`
        for i in 0..c.sc.events.len {
            let e = c.sc.events.items[i].name;
            let any = false;
            for k in 0..c.sc.evParams.len { if c.sc.evParams.items[k].ev == e { any = true; break; } }
            if !any { continue; }
            o.s(fm(a, "pub struct $0Event_$1 {\n", [name, e]));
            for k in 0..c.sc.evParams.len {
                let p = c.sc.evParams.items[k];
                if p.ev != e { continue; }
                o.set(fi, p.nameR.lo, p.nameR.hi);
                o.s(fm(a, "    $0: ", [p.name]));
                o.copy(fi, src, p.ty.lo, p.ty.hi);
                o.s(";\n");
            }
            o.set(fi, 0, 0);
            o.s("}\n\n");
        }
        for i in 0..this.eachs.len {
            if !this.eachs.items[i].rows { continue; }
            let idn = this.eachs.items[i].id;
            let id = num(a, idn);
            o.s(fm(a, "struct $0_R$1 {\n    uid: int;\n    comp: int;\n    dom: &Dom;\n$2", [name, id, this.stateFields(idn)]));
            o.s(fm(a, "\n    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &$0_R$1 {\n        let a = mem.alloc::<$0_R$1>(1);\n        a[0] = $0_R$1 {\n            uid: uid,\n            comp: comp,\n            dom: d,\n$2        };\n        return &a[0];\n    }\n", [name, id, this.stateInits(idn)]));
            o.s(fm(a, "\n    fn reset(this: &$0_R$1, uid: int, comp: int) {\n        this.uid = uid;\n        this.comp = comp;\n$2    }\n", [name, id, this.stateResets(idn, "this")]));
            o.s(fm(a, "\n    fn take(pool: &List<&$0_R$1>, mem: &Arena, d: &Dom, uid: int, comp: int): &$0_R$1 {\n        if pool.len > 0 {\n            pool.len -= 1;\n            let r = pool.items[pool.len];\n            r.reset(uid, comp);\n            return r;\n        }\n        return $0_R$1.make(mem, d, uid, comp);\n    }\n", [name, id]));
            o.s(fm(a, "\n    fn destroy(this: &$0_R$1) {\n$2        if this.uid >= 0 {\n            this.dom.groupFree(this.uid);\n            this.uid = -1;\n        }\n    }\n}\n\n", [name, id, this.stateDestroy(idn, "this")]));
        }
        return Result.Ok(true);
    }

    /// The component struct, `new`, `j3Reset`, `styles`, `init`.
    fn asmNew(this: &G, o: &Out, bridge: bool): Result<bool, UiError> {
        let a = this.a;
        let c = this.c;
        let name = c.id;
        let src = this.src;
        let fi = this.fi;
        o.s(fm(a, "pub struct $0 {\n    mem: &Arena;\n    ready: bool;\n    dm: int;\n    p: &$0Props;\n", [name]));
        if this.root { o.s("    css: &Css;\n    dom: Dom;\n"); }
        for i in 0..c.sc.lets.len {
            let l = c.sc.lets.items[i];
            o.set(fi, l.nameR.lo, l.nameR.hi);
            o.s(fm(a, "    $0: ", [l.name]));
            match l.ty {
                Option.Some(t) { o.copy(fi, src, t.lo, t.hi); }
                Option.None {
                    if l.guess.len == 0 {
                        return Result.Err(uiErr(l.nameR.lo, l.nameR.hi, fm(a, "can't tell the type of `let $0`", [l.name])).withHelp(fm(a, "write it out: `let $0: Type = ...;`", [l.name])));
                    }
                    o.s(l.guess);
                }
            }
            o.s(";\n");
        }
        o.set(fi, 0, 0);
        for i in 0..this.tags.len { o.s(fm(a, "    $0: int;\n", [fieldName("tag_", &this.tags, this.tags.items[i], a)])); }
        for i in 0..this.classes.len { o.s(fm(a, "    $0: int;\n", [fieldName("cls_", &this.classes, this.classes.items[i], a)])); }
        o.s(this.stateFields(0));
        if this.hasSlot {
            o.s("    slotSite: int;\n    slotOwn: int;\n    slotI: int;\n");
            for i in 0..this.slotMarks.len { o.s(fm(a, "    slotNow$0: bool;\n    slotWas$0: bool;\n", [num(a, this.slotMarks.items[i].k)])); }
        }
        if bridge { o.s(fm(a, "    sev: $0Events;\n", [name])); }
        // new
        o.s(fm(a, "\n    fn new(mem: &Arena): $0 {\n        let ps = mem.alloc::<$0Props>(1);\n", [name]));
        if this.root {
            o.s("        let cs = mem.alloc::<Css>(1);\n        cs[0] = Css.new(mem);\n        let css = &cs[0];\n");
            // the built-in popup sheet goes first, so the theme overrides it
            o.s("        uastyle.load(css);\n");
            match this.themePath {
                Option.Some(tp) { o.s(fm(a, "        parse(css, THEME, $0, 0);\n", [lit(tp, a)])); }
                Option.None {}
            }
            o.s(fm(a, "        $0.styles(css);\n", [name]));
        }
        o.s(fm(a, "        return $0 {\n            mem: mem, ready: false, dm: 0, p: &ps[0],\n", [name]));
        if this.root { o.s("            css: css, dom: Dom.new(mem, css),\n"); }
        for i in 0..c.sc.lets.len {
            let l = c.sc.lets.items[i];
            o.set(fi, l.init.lo, l.init.hi);
            o.s(fm(a, "            $0: ", [l.name]));
            o.copy(fi, src, l.init.lo, l.init.hi);
            o.s(",\n");
        }
        o.set(fi, 0, 0);
        for i in 0..this.tags.len { o.s(fm(a, "            $0: 0,\n", [fieldName("tag_", &this.tags, this.tags.items[i], a)])); }
        for i in 0..this.classes.len { o.s(fm(a, "            $0: 0,\n", [fieldName("cls_", &this.classes, this.classes.items[i], a)])); }
        o.s(this.stateInits(0));
        if this.hasSlot {
            o.s("            slotSite: 0, slotOwn: 0, slotI: 0,\n");
            for i in 0..this.slotMarks.len { o.s(fm(a, "            slotNow$0: false, slotWas$0: false,\n", [num(a, this.slotMarks.items[i].k)])); }
        }
        if bridge { o.s(fm(a, "            sev: $0Events { $1 },\n", [name, evInit(&c.sc, src, a)])); }
        o.s("        };\n    }\n");
        // reset: `new` again without allocating (a pooled `{#each}` row reuses its components)
        o.s(fm(a, "\n    fn j3Reset(this: &$0) {\n        let mem = this.mem;\n        this.ready = false;\n", [name]));
        for i in 0..c.sc.lets.len {
            let l = c.sc.lets.items[i];
            o.set(fi, l.init.lo, l.init.hi);
            o.s(fm(a, "        this.$0 = ", [l.name]));
            o.copy(fi, src, l.init.lo, l.init.hi);
            o.s(";\n");
        }
        o.set(fi, 0, 0);
        o.s(this.stateResets(0, "this"));
        if this.hasSlot {
            o.s("        this.slotSite = 0;\n        this.slotOwn = 0;\n        this.slotI = 0;\n");
            for i in 0..this.slotMarks.len { o.s(fm(a, "        this.slotNow$0 = false;\n        this.slotWas$0 = false;\n", [num(a, this.slotMarks.items[i].k)])); }
        }
        if bridge { o.s(fm(a, "        this.sev = $0Events { $1 };\n", [name, evInit(&c.sc, src, a)])); }
        o.s("    }\n");
        // styles
        o.s(fm(a, "\n    fn styles(css: &Css) {\n        parseAt(css, CSS_$0, $1, SCOPE_$0, LINE0_$0);\n", [name, lit(this.stylePath(), a)]));
        for i in 0..c.sc.consts.len {
            let l = c.sc.consts.items[i];
            if l.guess.len > 0 { continue; }
            o.set(fi, l.init.lo, l.init.hi);
            o.s(fm(a, "        $0_$1 = ", [name, l.name]));
            o.copy(fi, src, l.init.lo, l.init.hi);
            o.s(";\n");
        }
        o.set(fi, 0, 0);
        let done = List<string>.new(a);
        for i in 0..this.insts.len {
            let child = this.insts.items[i].comp;
            if hasStr(&done, child) { continue; }
            done.push(child);
            o.s(fm(a, "        $0.styles(css);\n", [child]));
        }
        o.s("    }\n");
        // init
        o.s(fm(a, "\n    fn init(this: &$0, d: &Dom) {\n        this.ready = true;\n        this.dm = d as int;\n", [name]));
        for i in 0..this.tags.len { o.s(fm(a, "        this.$0 = d.tag($1);\n", [fieldName("tag_", &this.tags, this.tags.items[i], a), lit(this.tags.items[i], a)])); }
        for i in 0..this.classes.len { o.s(fm(a, "        this.$0 = d.css.intern($1);\n", [fieldName("cls_", &this.classes, this.classes.items[i], a), lit(this.classes.items[i], a)])); }
        o.s("    }\n");
        return Result.Ok(true);
    }
}
