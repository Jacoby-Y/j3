// `on:` event handlers.
//
// Part of module j3c.ui.gen.
// Port of: j3c/src/ui/gen/attr_event.rs
// J3: C2e chunk D. One slice of the `attr` chain; true when it handled the attribute.
// J3: Rust's `lets: Vec<(&str, String)>` is two parallel lists; the `name_<node>_<event>` names are arena
// strings (they sit in `locals` / `rename` while the handler is copied).
module j3c.ui.gen;

extend G {
    /// The `if d.<test>(<n>) {` head of event `ev` (after its checks and the lines that go before it).
    fn eventHead(this: &G, e: &Elem, a: &Attr, n: string, name: string, ev: string): Result<string, UiError> {
        let call = "mouseMove";
        if ev == "click" { call = "clicked"; }
        else if ev == "dblclick" { call = "dblclicked"; }
        else if ev == "wheel" { return Result.Ok(this.aMsg("if d.wheelAt(", n, ") != 0.0 {")); }
        else if ev == "input" { call = "changed"; }
        else if ev == "change" {
            if !isRadio(e) {
                return Result.Err(attrErr(a, "`on:change` is for `<input type=\"radio\">` (the radio that just got checked); a text box or slider has `on:input`"));
            }
            call = "changed";
        } else if ev == "submit" {
            this.aLine("d.attrFlag(", n, ", 2);");
            call = "submitted";
        } else if ev == "trigger" {
            if !attrHas(e, "triggers") { this.aLine("d.attrTriggers(", n, ", \"@:\");"); }
            call = "triggered";
        } else if ev == "close" { call = "closeRequested"; }
        else if ev == "toggle" { call = "toggled"; }
        else if ev == "edit" {
            if !attrHas(e, "grid") { return Result.Err(attrErr(a, "`on:edit` needs `grid={..}` on the same element")); }
            call = "gridEdit";
        } else if ev == "contextmenu" { call = "contextAt"; }
        else if ev == "dragstart" || ev == "dragend" {
            if !attrHas(e, "draggable") { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `draggable` on the same element"))); }
            call = if ev == "dragend" { "dragEnded" } else { "dragStarted" };
        } else if ev == "dragenter" || ev == "dragleave" || ev == "dragover" || ev == "drop" {
            // dom.attrDragTarget bits: 1 enter, 2 leave, 4 over, 8 drop
            let bit = ", 8);";
            call = "dropAt";
            if ev == "dragenter" { bit = ", 1);"; call = "dragEntered"; }
            else if ev == "dragleave" { bit = ", 2);"; call = "dragLeft"; }
            else if ev == "dragover" { bit = ", 4);"; call = "dragOver"; }
            this.aLine("d.attrDragTarget(", n, bit);
        } else if ev == "mousedown" { call = "mouseDown"; }
        else if ev == "mouseup" { call = "mouseUp"; }
        return Result.Ok(Text.new(this.a).add("if d.").add(call).add("(").add(n).add(") {").str());
    }

    /// One attribute family: true when it handled `a` (`name` is the attribute name, `n` the node variable).
    fn attrEvent(this: &G, e: &Elem, a: &Attr, n: string, name: string): Result<bool, UiError> {
        if !startsWith(name, "on:") { return Result.Ok(false); }
        let ev = name[3..name.len];
        let r = Range { lo: 0, hi: 0 };
        match a.value {
            Value.Expr(x) { r = x; }
            Value.None { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={ statements }`"))); }
            Value.Str(_) { return Result.Err(attrErr(a, this.aMsg("`", name, "` needs `={ statements }`"))); }
        }
        // `|stop` ends the bubble walk (dom.attrFlag bits: 4 wheel, 8 mousedown, 16 mouseup, 32 contextmenu)
        if ev == "wheel|stop" || ev == "mousedown|stop" || ev == "mouseup|stop" || ev == "contextmenu|stop" {
            ev = ev[0..ev.len - 5];
            this.aLine("d.attrFlag(", n, if ev == "wheel" { ", 4);" } else if ev == "mousedown" { ", 8);" } else if ev == "mouseup" { ", 16);" } else { ", 32);" });
        }
        let known = false;
        for i in 0..MOUSE.len { if MOUSE[i] == ev { known = true; break; } }
        if !known {
            let h = Text.new(this.a).add("events:");
            for i in 0..MOUSE.len { h.add(" ").add(MOUSE[i]); }
            if e.tag == "canvas" { h.add(" draw"); }
            return Result.Err(attrErr(a, Text.new(this.a).add("unknown event `").add(name).add("` on `<").add(e.tag).add(">`").str()).withHelp(h.str()));
        }
        let head = this.eventHead(e, a, n, name, ev)?;
        this.upd.line(head);
        this.upd.ind += 1;
        // the names a handler sees; J3 has no shadowing, even across sibling blocks, so each is written `name_<node>_<event>`
        let ln = List<string>.new(this.a);
        let lv = List<string>.new(this.a);
        let drag = ev == "dragstart" || ev == "dragend";
        let target = ev == "dragenter" || ev == "dragleave" || ev == "dragover" || ev == "drop";
        if ev == "wheel" {
            ln.push("wheel"); lv.push(this.aMsg("d.wheelAt(", n, ")"));
        } else if ev == "toggle" {
            ln.push("open"); lv.push(this.aMsg("d.isOpen(", n, ")"));
        } else if ev == "contextmenu" {
            ln.push("mouse"); lv.push("d.mouseAt()");
        } else if ev == "trigger" {
            ln.push("trigger"); lv.push(this.aMsg("d.triggerText(", n, ")"));
            ln.push("tlo"); lv.push("d.trigLo");
            ln.push("thi"); lv.push("d.trigHi");
        } else if ev == "edit" {
            ln.push("kind"); lv.push(this.aMsg("d.gridOf(", n, ").evKind"));
            ln.push("row"); lv.push(this.aMsg("d.gridOf(", n, ").evRow"));
            ln.push("col"); lv.push(this.aMsg("d.gridOf(", n, ").evCol"));
            ln.push("text"); lv.push(this.aMsg("d.gridOf(", n, ").evText"));
        } else if drag || target {
            if target { ln.push("mouse"); lv.push(this.aMsg("d.localMouse(", n, ")")); }
            ln.push("data"); lv.push("d.dragData()");
            ln.push("dragId"); lv.push("d.dragIdOf()");
            if ev == "dragend" { ln.push("dropped"); lv.push("d.dragDropped()"); }
            else if ev == "dragover" { ln.push("accept"); lv.push("true"); }
        }
        if !(ev == "click" || ev == "input" || ev == "change" || ev == "submit" || ev == "close" || ev == "toggle"
            || ev == "contextmenu" || ev == "trigger" || ev == "edit" || drag || target) {
            ln.push("mouse"); lv.push(this.aMsg("d.localMouse(", n, ")"));
        }
        if ev == "mousedown" { ln.push("button"); lv.push("d.downBtn"); }
        else if ev == "mouseup" { ln.push("button"); lv.push("d.upBtn"); }
        if e.tag == "canvas" { ln.push("size"); lv.push(this.aMsg("d.size(", n, ")")); }
        let saved = this.locals.len;
        for i in 0..ln.len {
            let to = Text.new(this.a).add(ln.items[i]).add("_").add(n).add("_").add(ev).str();
            this.upd.pad();
            this.upd.s("let ");
            this.upd.s(to);
            this.upd.s(" = ");
            this.upd.s(lv.items[i]);
            this.upd.s(";\n");
            this.rename.insert(0, Rename { from: ln.items[i], to: to });
            this.locals.push(to);
        }
        this.stmts(Mode.U, r, true)?;
        while this.locals.len > saved { this.locals.pop(); }
        for i in 0..ln.len { this.rename.remove(0); }
        if ev == "dragover" {
            this.upd.pad();
            this.upd.s("if !accept_");
            this.upd.s(n);
            this.upd.s("_dragover { d.dragReject(");
            this.upd.s(n);
            this.upd.s("); }\n");
        }
        this.upd.ind -= 1;
        this.upd.line("}");
        return Result.Ok(true);
    }
}
