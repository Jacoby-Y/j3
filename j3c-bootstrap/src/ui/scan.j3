// Find `.j3ui` files under `ui/` and name their components: `ui/game/hud/Cool.j3ui` is `game.hud.Cool`
// (written with its full path in markup).
//
// Port of: j3c/src/ui/scan.rs
// J3: Ported in wave 16 (the loader and `dump-ui` wiring run through it). Paths are strings; `shown` is
// `/`-separated. `extra` (unsaved editor buffers, the loader's overlay paths) joins the files on disk.
module j3c.ui.scan;

use j3.cmp.sortBy;
use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text.{ Text, contains, endsWith, startsWith };
use j3c.base.fsx;

pub struct Found {
    /// The file to read.
    path: string;
    /// Dotted component name, `game.hud.Cool`.
    name: string;
    /// As shown in errors, `/`-separated: `ui/game/hud/Cool.j3ui`.
    shown: string;
}

const MAX_DEPTH: int = 16;

/// `.j3ui` files under `dir` as paths relative to the scan root (`rel` is `dir`'s own, "" at the root).
fn walk(dir: string, rel: string, depth: int, out: &List<string>, a: &Arena): Result<bool, string> {
    if depth > MAX_DEPTH {
        let t = Text.new(a).add(dir).add(" is nested deeper than ");
        t.pushInt(MAX_DEPTH);
        return Result.Err(t.add(" folders").str());
    }
    let es = match io.listDir(dir, a) {
        Result.Ok(es) { es }
        Result.Err(_) { return Result.Ok(true); }
    };
    for i in 0..es.len {
        let n = es[i].name;
        if startsWith(n, ".") { continue; }
        let p = path.join(dir, n, a);
        let r = if rel.len == 0 { n } else { Text.new(a).add(rel).add("/").add(n).str() };
        // symlinked folders are not followed (loops); a symlinked file is fine
        if es[i].isDir && !es[i].isLink {
            walk(p, r, depth + 1, out, a)?;
        } else if endsWith(n, ".j3ui") && fsx.isFile(p) {
            out.push(r);
        }
    }
    return Result.Ok(true);
}

/// Every `.j3ui` under `dir`, sorted by `shown` (byte order). `shownDir` is how `dir` is written in errors
/// (`ui`). Strings are in `a`.
pub fn scan(dir: string, shownDir: string, extra: &List<string>, a: &Arena): Result<List<Found>, string> {
    let rels = List<string>.new(a);
    walk(dir, "", 0, &rels, a)?;
    // Rust `strip_prefix(dir)`, a `.j3ui`, no hidden folder, not on disk already
    let head = Text.new(a).add(dir).add("/").str();
    for i in 0..extra.len {
        let p = extra.items[i];
        if !startsWith(p, head) || !endsWith(p, ".j3ui") { continue; }
        let r = p[head.len..p.len];
        if startsWith(r, ".") || contains(r, "/.") { continue; }
        let dup = false;
        for k in 0..rels.len { if rels.items[k] == r { dup = true; } }
        if !dup { rels.push(r); }
    }
    let found = List<Found>.new(a);
    for i in 0..rels.len {
        let r = rels.items[i];
        let shown = Text.new(a).add(shownDir).add("/").add(r).str();
        let slash = r.len;
        while slash > 0 && r[slash - 1] != '/' { slash -= 1; }
        let stem = r[slash..r.len - 5];
        if contains(stem, ".") {
            return Result.Err(Text.new(a).add(shown).add(": a component file name cannot contain `.` (dots are folder separators in component names)").str());
        }
        // folders become name segments: `game/hud/Cool` -> `game.hud.Cool`
        let name = Text.new(a);
        for k in 0..r.len - 5 { name.push(if r[k] == '/' { '.' } else { r[k] }); }
        found.push(Found { path: path.join(dir, r, a), name: name.str(), shown: shown });
    }
    sortBy(found.items[0..found.len], fn(x: Found, y: Found): bool { return x.shown < y.shown; });
    return Result.Ok(found);
}
