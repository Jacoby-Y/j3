// Scripts attached to objects in scene files (`script=` on an object line) and the `j3.scene3d.scripts`
// table.
//
// Part of module j3c.load.
// Port of: j3c/src/compile/scene_scripts.rs (MODULE, LABEL), compile/loader.rs (load_registry)
// J3: Reads scenes through `j3.scene3d` directly; Rust's `scenefile.rs` parser goes away.
module j3c.load;
// J3: The `Loader` side only: the scan is `load/scene_scan.j3` and the checks and generated source are
// `load/scene_registry.j3` (own modules, own `use`s). Uses: `load.j3`'s.

/// The synthesized module's name (`scene_registry.MODULE`).
const SCENE_MODULE: string = "j3.scene3d.scripts";
/// What diagnostics call it (`scene_registry.LABEL`).
const SCENE_LABEL: string = "(scene scripts)";

extend Loader {
    /// `j3.scene3d.scripts`, made from the project's scenes.
    fn loadRegistry(this: &Loader): Result<bool, string> {
        if this.loaded.has(SCENE_MODULE) { return Result.Ok(true); }
        let scan = this.scenes();
        return this.registryFrom(&scan);
    }

    /// The project's scenes, scanned on first use (Rust `scene_scan()`).
    fn scenes(this: &Loader): Scan {
        match this.sceneScan {
            Option.Some(s) { return s; }
            Option.None {}
        }
        let s = scene_scan.scan(this.scriptRoot, this.arena);
        this.sceneScan = Option.Some(s);
        return s;
    }

    /// `loadRegistry` with the scan in hand. Err: Rust's scene error text (plain, not a Diag).
    fn registryFrom(this: &Loader, scan: &Scan): Result<bool, string> {
        if this.loaded.has(SCENE_MODULE) { return Result.Ok(true); }
        let text = scene_registry.registry(this.scriptRoot, scan, this.ast)?;
        return this.parseText(SCENE_LABEL, text);
    }
}
