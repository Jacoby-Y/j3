// Where a module's file lives: the embedded stdlib, the project's `src/`, a dependency; path helpers.
//
// Part of module j3c.load.
// Port of: j3c/src/compile/loader/paths.rs
module j3c.load;
// J3: A part of `load.j3` (its `use`s). Paths are strings joined with `j3.io.path.join` (Rust `Path::join`,
// never normalized), so messages print the paths Rust prints. `same_path` is `fsx.samePath`.

extend Loader {
    fn modulePath(this: &Loader, ps: List<string>): string {
        let a = this.arena;
        let j3 = path.join(this.stdlib, "j3", a);
        if ps.len == 2 && ps.items[0] == "j3" {
            let m = ps.items[1];
            if m == "game" {
                return path.join(j3, match this.game { GameBackend.Sdl { "game.j3" } GameBackend.Headless { "game_headless.j3" } }, a);
            }
            if m == "build" {
                // `--release` swaps in the file with `RELEASE = true`, `DEV = false`
                return path.join(j3, if this.release { "build_release.j3" } else { "build.j3" }, a);
            }
            if m == "sys" {
                return path.join(j3, match this.os {
                    OsKind.Linux { "sys.j3" } OsKind.Windows { "sys_windows.j3" } OsKind.Macos { "sys_macos.j3" }
                    OsKind.Android { "sys_android.j3" } OsKind.Web { "sys_web.j3" }
                }, a);
            }
            if m == "threadsys" {
                return path.join(j3, match this.os {
                    OsKind.Windows { "threadsys_windows.j3" } OsKind.Android { "threadsys_android.j3" } OsKind.Web { "threadsys_web.j3" }
                    OsKind.Linux { "threadsys.j3" } OsKind.Macos { "threadsys.j3" }
                }, a);
            }
            if m == "instance" {
                // x86-64 Linux syscall numbers; Windows uses a named pipe; the rest get the stub
                return path.join(j3, match this.os {
                    OsKind.Linux { "instance.j3" } OsKind.Windows { "instance_windows.j3" }
                    OsKind.Macos { "instance_other.j3" } OsKind.Android { "instance_other.j3" } OsKind.Web { "instance_other.j3" }
                }, a);
            }
        }
        let key = joinKey(ps.items[0..ps.len], a);
        let macOrWeb = match this.os { OsKind.Macos { true } OsKind.Web { true } _ { false } };
        let windows = match this.os { OsKind.Windows { true } _ { false } };
        // `j3.io.watch` is raw x86-64 Linux syscalls: macOS and web get a stub with no OS calls
        if macOrWeb && key == "j3.io.watch" { return path.join(path.join(j3, "io", a), "watch_other.j3", a); }
        // Win32 twins of Linux-only modules: same pub names, one file each (`<path>_windows.j3`)
        if windows && ps.len > 0 && ps.items[0] == "j3" {
            if key == "j3.proc" || key == "j3.term.pty" || key == "j3.io.watch" || key == "j3.game.hotkey" {
                let p = joinMod(this.stdlib, ps, a);
                return Text.new(a).add(p[0..p.len - 3]).add("_windows.j3").str();
            }
        }
        if ps.len == 2 && ps.items[0] == "j3" && ps.items[1] == "netsys" {
            return path.join(j3, match this.os {
                OsKind.Linux { "netsys.j3" } OsKind.Windows { "netsys_windows.j3" } OsKind.Macos { "netsys_macos.j3" }
                OsKind.Android { "netsys_android.j3" } OsKind.Web { "netsys_web.j3" }
            }, a);
        }
        match this.depModule(ps) { Option.Some(p) { return p; } Option.None {} }
        match this.projectModule(ps) { Option.Some(p) { return p; } Option.None {} }
        return joinMod(this.stdlib, ps, a);
    }

    fn depModule(this: &Loader, ps: List<string>): Option<string> {
        if ps.len == 0 { return Option.None; }
        let a = this.arena;
        for i in 0..this.deps.len {
            let d = this.deps.items[i];
            if d.name != ps.items[0] { continue; }
            let p = "";
            if ps.len == 1 {
                // `use hello;` is the package's root module, `src/hello.j3`
                p = path.join(d.root, Text.new(a).add(d.name).add(".j3").str(), a);
            } else {
                p = joinMod(d.root, suffix(ps, 1, a), a);
            }
            if fsx.isFile(p) { return Option.Some(p); }
            return Option.None;
        }
        return Option.None;
    }

    /// A dep file must say `module <dep>.<path>;`, as project files say `module <package>.<path>;`.
    fn depModuleLine(this: &Loader, key: string, p: string): Result<bool, string> {
        let a = this.arena;
        let depName = "";
        let found = false;
        for i in 0..this.deps.len {
            if hasPrefix(p, this.deps.items[i].root) { depName = this.deps.items[i].name; found = true; break; }
        }
        if !found { return Result.Ok(true); }
        for i in 0..this.files.len {
            if this.files.items[i].path != p { continue; }
            let k = this.files.items[i].ast.moduleKey(this.ast);
            if k != key {
                return this.fail(Text.new(a).add(p).add(": imported as `").add(key).add("` but says `module ").add(k)
                    .add(";`; write `module ").add(key).add(";` (dep `").add(depName).add("`)").str());
            }
            return Result.Ok(true);
        }
        return Result.Ok(true);
    }

    fn projectModule(this: &Loader, ps: List<string>): Option<string> {
        let a = this.arena;
        let src = match this.srcDir { Option.Some(s) { s } Option.None { return Option.None; } };
        if ps.len > 0 && ps.items[0] == "j3" { return Option.None; }
        let direct = joinMod(src, ps, a);
        if fsx.isFile(direct) { return Option.Some(direct); }
        match this.package {
            Option.Some(pkg) {
                if ps.len > 1 && ps.items[0] == pkg {
                    let stripped = joinMod(src, suffix(ps, 1, a), a);
                    if fsx.isFile(stripped) { return Option.Some(stripped); }
                }
            }
            Option.None {}
        }
        return Option.None;
    }
}

/// `ps[from..]`.
fn suffix(ps: List<string>, from: int, a: &Arena): List<string> {
    let out = List<string>.new(a);
    for i in from..ps.len { out.push(ps.items[i]); }
    return out;
}

extend Loader {
    /// Rust `source_exists`: embedded, the built-in hello, or a file on disk.
    fn exists(this: &Loader, p: string): bool {
        match this.embedded(p) { Option.Some(_) { return true; } Option.None {} }
        return p == this.hello || fsx.isFile(p);
    }
}

/// `root/a/b.j3` for `[a, b]` (Rust `join_mod`).
pub fn joinMod(root: string, ps: List<string>, a: &Arena): string {
    let p = root;
    for i in 0..ps.len {
        if i + 1 == ps.len {
            p = path.join(p, Text.new(a).add(ps.items[i]).add(".j3").str(), a);
        } else {
            p = path.join(p, ps.items[i], a);
        }
    }
    return p;
}

/// The next component of `p` at or after byte `i` as (start, end), start -1 at the end; empty and
/// non-leading `.` components skipped (Rust `Path::components`).
fn comp(p: string, i: int): (int, int) {
    while true {
        let lead = i == 0;
        while i < p.len && p[i] == '/' { i += 1; }
        if i >= p.len { return (-1, i); }
        let e = i;
        while e < p.len && p[e] != '/' { e += 1; }
        if e - i == 1 && p[i] == '.' && !lead { i = e; continue; }
        return (i, e);
    }
    return (-1, i);
}

/// Rust `Path::starts_with`: `root`'s components are a prefix of `p`'s.
pub fn hasPrefix(p: string, root: string): bool {
    return prefixEnd(p, root) >= 0;
}

/// Byte offset in `p` after `root`'s components, or -1 (rooted-ness must match).
fn prefixEnd(p: string, root: string): int {
    let rp = p.len > 0 && p[0] == '/';
    let rr = root.len > 0 && root[0] == '/';
    if rp != rr { return -1; }
    let ip = 0;
    let ir = 0;
    while true {
        let (sr, er) = comp(root, ir);
        if sr < 0 { return ip; }
        let (sp, ep) = comp(p, ip);
        if sp < 0 { return -1; }
        if p[sp..ep] != root[sr..er] { return -1; }
        ip = ep;
        ir = er;
    }
    return -1;
}

/// Rust `Path::strip_prefix(root)` shown with `/`: the rest of `p` below `root`, in `a`.
pub fn stripPrefix(p: string, root: string, a: &Arena): Option<string> {
    let at = prefixEnd(p, root);
    if at < 0 { return Option.None; }
    let t = Text.new(a);
    let i = at;
    while true {
        let (s, e) = comp(p, i);
        if s < 0 { break; }
        if t.bytes.len > 0 { t.push('/'); }
        t.pushStr(p[s..e]);
        i = e;
    }
    return Option.Some(t.str());
}
