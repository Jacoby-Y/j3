// `.j3s` scripts joining the program: `@script(..)` edges in the module graph and the script modules they
// pull in.
//
// Part of module j3c.load.
// Port of: j3c/src/compile/loader/scripts.rs
module j3c.load;
// J3: The `Loader` methods only. Finding `@script`/`@embed*` edges (Rust `script_deps.rs`), `script_paths`
// and `script_module_parts` are in `load/scripts_deps.j3`, its own module. Uses: `load.j3`'s.

extend Loader {
    /// When a scene attaches scripts, they and the registry join the program.
    fn loadSceneScripts(this: &Loader): Result<bool, string> {
        let scan = this.scenes();
        if scan.attachments.len == 0 { return Result.Ok(true); }
        this.registryFrom(&scan)?;
        return this.loadImports();
    }

    /// The script `rel` (relative to the project root) that file `source` names at `span`. A missing file
    /// is a spanned error in `diags` (`Err("")`), with a did-you-mean over the project's scripts.
    fn loadScript(this: &Loader, rel: string, source: int, span: Span): Result<bool, string> {
        let a = this.arena;
        let ps = scriptModuleParts(rel, a)?;
        let key = joinKey(ps.items[0..ps.len], a);
        if this.loaded.has(key) { return Result.Ok(true); }
        let p = path.join(this.scriptRoot, rel, a);
        let overlaid = false;
        for i in 0..this.overlays.len { if fsx.samePath(this.overlays.items[i].path, p, a) { overlaid = true; } }
        if !fsx.isFile(p) && !overlaid {
            // `span` is in `files[source]`'s Source, so the Diag renders against that file.
            let d = this.diags.make(0, Severity.Error, span, Text.new(a).add("no script at ").add(rel).str());
            let known = scripts_deps.scriptPaths(this.scriptRoot, a);
            match diag.didYouMean(rel, known.items[0..known.len], a) {
                Option.Some(s) {
                    d.notes.push(Note { kind: NoteKind.Help, span: noSpan(), msg: Text.new(a).add("did you mean `").add(s).add("`?").str() });
                }
                Option.None {}
            }
            this.diags.add(d);
            return Result.Err("");
        }
        return this.loadPath(p);
    }
}
