// The embedded stdlib: every `stdlib/j3/**/*.j3` as a const table, with `J3_STDLIB` overriding from disk.
//
// Part of module j3c.load.
// Port of: j3c/src/stdlib/mod.rs, stdlib/files.rs
// J3: `@embedDir` replaces the hand-kept file list (`stdlib/files.rs` is in DELETED.md).
module j3c.load;
// J3: A part of `load.j3` (its `use`s). `stdlib_dir()` is a path key, not a place that must exist. Rust's is
// `CARGO_MANIFEST_DIR/stdlib` (where that binary was built); here it is `<repo>/j3c/stdlib`, the repo found
// by walking up from the executable (`manifestDir`). ponytail: a copied binary falls back to `<exe dir>/j3c`;
// messages naming a stdlib path differ from stage 0 (built in a scratch tree) either way.
// J3: `docs_id` / `provenance` (hashes of the Rust doc pages) come with `cmd/version` and `doc` (C5).

/// `j3c/stdlib/j3/**/*.j3`, sorted by path; `path` is below `j3/` (Rust `FILES` names).
const FILES = @embedDir("../../../j3c/stdlib/j3", "*.j3");

/// True when `J3_STDLIB` names a directory that replaces the embedded sources.
pub fn usingOverride(): bool { return sys.env("J3_STDLIB").len > 0; }

/// Rust `CARGO_MANIFEST_DIR`: the `j3c` folder of the repo this binary lives in, in `a`.
pub fn manifestDir(a: &Arena): string {
    let up = own(a, sys.exeDir());
    for i in 0..8 {
        let j3c = path.join(up, "j3c", a);
        if fsx.isDir(path.join(j3c, "stdlib/j3", a)) { return j3c; }
        match parentOf(up) { Option.Some(p) { if p.len == 0 { break; } up = p; } Option.None { break; } }
    }
    return path.join(own(a, sys.exeDir()), "j3c", a);
}

/// Parent of `j3/`: `J3_STDLIB`, else `<manifestDir>/stdlib` (Rust `stdlib_dir`).
pub fn stdlibDir(a: &Arena): string {
    let d = sys.env("J3_STDLIB");
    if d.len > 0 { return own(a, d); }
    return path.join(manifestDir(a), "stdlib", a);
}

/// The source of embedded stdlib file `name` (`game/anim.j3`), if there is one.
pub fn stdlibFile(name: string): Option<string> {
    for i in 0..FILES.len { if FILES[i].path == name { return Option.Some(FILES[i].data); } }
    return Option.None;
}

/// Every embedded file name, in order (Rust `stdlib::files()` names).
pub fn stdlibNames(a: &Arena): List<string> {
    let out = List<string>.new(a);
    for i in 0..FILES.len { out.push(FILES[i].path); }
    return out;
}

extend Loader {
    /// Embedded source when `p` is `stdlib_dir()/j3/<file>` and `J3_STDLIB` is unset (Rust `embedded`).
    fn embedded(this: &Loader, p: string): Option<string> {
        if this.override { return Option.None; }
        if !hasPrefix(p, this.stdlib) { return Option.None; }
        let name = match stripPrefix(p, path.join(this.stdlib, "j3", this.arena), this.arena) {
            Option.Some(n) { n }
            Option.None { return Option.None; }
        };
        match this.stdIndex.get(name) {
            Option.Some(i) { return Option.Some(FILES[i].data); }
            Option.None { return Option.None; }
        }
    }

    /// The extra files of a module spread over several: `dir` is the module path without `.j3`. Embedded
    /// when under the stdlib and `J3_STDLIB` is unset, else `*.j3` on disk; sorted (Rust `stdlib::parts`).
    fn parts(this: &Loader, dir: string): List<string> {
        let a = this.arena;
        let out = List<string>.new(a);
        let j3 = path.join(this.stdlib, "j3", a);
        if !this.override {
            match stripPrefix(dir, j3, a) {
                Option.Some(rel) {
                    let pre = Text.new(a).add(rel).add("/").str();
                    // FILES is sorted by path, so siblings come out in name order (Rust sorts the paths)
                    for i in 0..FILES.len {
                        let n = FILES[i].path;
                        if !startsWith(n, pre) { continue; }
                        if text.find(n[pre.len..n.len], "/") >= 0 { continue; }
                        out.push(path.join(j3, n, a));
                    }
                    return out;
                }
                Option.None {}
            }
        }
        match io.listDir(dir, a) {
            Result.Ok(ents) {
                for i in 0..ents.len {
                    let n = ents[i].name;
                    if ents[i].isDir || n.len <= 3 || !endsWith(n, ".j3") { continue; }
                    out.push(path.join(dir, n, a));
                }
            }
            Result.Err(_) {}
        }
        sortBy(out.items[0..out.len], fn(x: string, y: string): bool { return x < y; });
        return out;
    }
}

/// `name -> FILES index`, for `Loader.embedded`.
fn stdIndex(a: &Arena): Map<string, int> {
    let m = Map<string, int>.new(a, FILES.len * 2);
    for i in 0..FILES.len { m.put(FILES[i].path, i); }
    return m;
}
