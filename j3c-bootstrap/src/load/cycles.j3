// Import cycle check over the parsed module graph, with the cycle printed.
//
// Part of module j3c.load.
// Port of: j3c/src/compile/loader/cycles.rs
module j3c.load;
// J3: A part of `load.j3` (its `use`s). The graph keeps each module's edges in file order and the walk
// starts from the files in load order, so the cycle printed is Rust's. Keys are looked up in a `Set`
// (Rust scanned the key list per `use`).

/// The module a `use` imports, when it is one of the loaded `keys` (Rust `use_mod_key`).
fn useModKey(ast: &Ast, u: &UseItem, keys: &Set<string>, a: &Arena): Option<string> {
    let ps = List<string>.new(a);
    for i in 0..u.path.len { ps.push(ast.str(u.path.items[i].name)); }
    let whole = joinKey(ps.items[0..ps.len], a);
    match u.names {
        Option.Some(_) {
            if keys.has(whole) { return Option.Some(whole); }
            return Option.None;
        }
        Option.None {}
    }
    if keys.has(whole) { return Option.Some(whole); }
    if ps.len >= 2 {
        let k = joinKey(ps.items[0..ps.len - 1], a);
        if keys.has(k) { return Option.Some(k); }
    }
    return Option.None;
}

/// Edges out of one module, in the order they were found.
struct Edges {
    to: List<string>;
}

/// Rust `check_import_cycles`: Err `import cycle: a -> b -> a`.
fn checkImportCycles(l: &Loader): Result<bool, string> {
    let a = l.arena;
    let keys = List<string>.new(a);
    let keySet = Set<string>.new(a, l.files.len * 2 + 8);
    for i in 0..l.files.len {
        let k = l.files.items[i].ast.moduleKey(l.ast);
        keys.push(k);
        keySet.add(k);
    }
    let graph = Map<string, Edges>.new(a, l.files.len * 2 + 8);
    for i in 0..l.files.len {
        let f = &l.files.items[i].ast;
        let from = keys.items[i];
        for j in 0..f.items.len {
            match f.items.items[j] {
                Item.Use(u) {
                    match useModKey(l.ast, &u, &keySet, a) {
                        Option.Some(to) { if to != from { addEdge(&graph, from, to, a); } }
                        Option.None {}
                    }
                }
                _ {}
            }
        }
        let scripts = scripts_deps.find(l.ast, f);
        for j in 0..scripts.len {
            let ps = scriptModuleParts(scripts.items[j].path, a)?;
            let to = joinKey(ps.items[0..ps.len], a);
            if to != from { addEdge(&graph, from, to, a); }
        }
    }
    let done = Set<string>.new(a, keys.len * 2 + 8);
    let stack = List<string>.new(a);
    let onStack = Set<string>.new(a, 64);
    for i in 0..keys.len {
        match dfs(&graph, keys.items[i], &stack, &onStack, &done, a) {
            Option.Some(cycle) {
                let t = Text.new(a);
                t.add("import cycle: ");
                for j in 0..cycle.len {
                    if j > 0 { t.add(" -> "); }
                    t.add(cycle.items[j]);
                }
                return Result.Err(t.str());
            }
            Option.None {}
        }
    }
    return Result.Ok(true);
}

fn addEdge(g: &Map<string, Edges>, from: string, to: string, a: &Arena) {
    if !g.has(from) { g.put(from, Edges { to: List<string>.new(a) }); }
    g.getPtr(from).to.push(to);
}

/// Depth-first from `node`: the cycle (first repeated node at both ends), or None.
fn dfs(g: &Map<string, Edges>, node: string, stack: &List<string>, onStack: &Set<string>, done: &Set<string>, a: &Arena): Option<List<string>> {
    if onStack.has(node) {
        let c = List<string>.new(a);
        let at = -1;
        for i in 0..stack.len { if stack.items[i] == node { at = i; break; } }
        if at < 0 { return Option.None; }
        for i in at..stack.len { c.push(stack.items[i]); }
        c.push(node);
        return Option.Some(c);
    }
    if done.has(node) { return Option.None; }
    stack.push(node);
    onStack.add(node);
    match g.get(node) {
        Option.Some(e) {
            for i in 0..e.to.len {
                match dfs(g, e.to.items[i], stack, onStack, done, a) {
                    Option.Some(c) { return Option.Some(c); }
                    Option.None {}
                }
            }
        }
        Option.None {}
    }
    onStack.remove(node);
    stack.len -= 1;
    done.add(node);
    return Option.None;
}
