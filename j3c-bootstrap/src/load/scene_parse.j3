// The `.j3scene` reader j3c-boot uses (objects in file order, every other line as `scene.data` holds it):
// `j3.scene3d.parse` copied with only the fields a file sets. Callers: `load/scene_scan`, `scene/diff`, `scene/ops`.
//
// Port of: none (Rust's `scenefile.rs` is deleted; the stdlib reader is j3c/stdlib/j3/scene3d/fields.j3, format.j3)
module j3c.load.scene_parse;
// J3: Copied from stdlib fields.j3 `parse`/`nodeLine`/`setField`, format.j3 v2 reader, graph.j3 `grow`, scene3d.j3
// `blank`. Linking `j3.scene3d` pulls `j3.game` and so libSDL2 (+ ~40 libs) into j3c-boot as NEEDED entries, ~3 MB
// RSS and ~1.4 ms per process (plan 07 wave 2). A rule changed in the stdlib reader must change here too (`diff.sh
// tool` scene/* and `diff.sh run` on scene-loading programs were frozen from the stdlib reader's output).

use j3.data.save;
use j3.math.Vec3;
use j3.memory.{ Arena, List };
use j3.text.Text;

pub const GROUP: int = 0;
pub const MESH: int = 1;
pub const CAMERA: int = 2;
pub const INSTANCE: int = 3;
pub const LIGHT: int = 4;
const OPAQUE: int = 0;
const CUTOUT: int = 1;
const BLEND: int = 2;

/// One object as `scene3d.Node` reads it from a file (rotation in radians, as there).
pub struct SceneNode {
    id: int;
    parent: int;
    kind: int;
    name: string;
    asset: string;
    texture: string;
    script: string;
    doubleSided: bool;
    position: Vec3;
    rotation: Vec3;
    scale: Vec3;
    fov: f32;
    near: f32;
    far: f32;
    scene: string;
    color: Vec3;
    tint: Vec3;
    range: f32;
    alpha: int;
    opacity: f32;
    material: string;
    effects: string;
    tags: string;
    note: string;
}

/// A parsed scene file: its objects in file order and every other line as `scene.data` holds it.
pub struct SceneFile {
    nodes: List<SceneNode>;
    data: string;
    parseError: string;
    arena: &Arena;

    /// Slot of the first object with `id`, or -1 (`scene3d.index`; ids are probed in slot order there).
    fn index(this: &SceneFile, id: int): int {
        for k in 0..this.nodes.len { if this.nodes.items[k].id == id { return k; } }
        return -1;
    }
}

fn blank(id: int): SceneNode {
    return SceneNode {
        id: id, parent: 0, kind: GROUP, name: "Object", asset: "", texture: "", script: "", doubleSided: false,
        position: Vec3.xyz(0, 0, 0), rotation: Vec3.xyz(0, 0, 0), scale: Vec3.xyz(1, 1, 1),
        fov: 60, near: 0.15, far: 200, scene: "", color: Vec3.xyz(1, 0.9, 0.75), tint: Vec3.xyz(1, 1, 1),
        range: 8, alpha: OPAQUE, opacity: 1, material: "", effects: "", tags: "", note: "",
    };
}

fn grow(scene: &SceneFile, count: int) {
    while scene.nodes.len < count { scene.nodes.push(blank(scene.nodes.len + 1)); }
}

/// `scene3d.parse(bytes, true, arena)`: object strings point into `bytes`.
pub fn parseScene(bytes: []u8, arena: &Arena): SceneFile {
    let rest = Text.new(arena);
    let scene = SceneFile { nodes: List<SceneNode>.new(arena), data: "", parseError: "", arena: arena };
    let line = 0;
    if bytesStart(bytes, 0, bytes.len, "j3scene") {
        parseV2(&scene, bytes, &rest);
        line = bytes.len;
    }
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let i = nodeLine(bytes, line, end);
        if i >= 0 {
            let f = line + 5;
            while bytes[f] != 46 { f += 1; }
            f += 1;
            let fe = f;
            while fe < end && bytes[fe] != 32 && bytes[fe] != 61 { fe += 1; }
            let v = fe;
            while v < end && bytes[v] != 61 { v += 1; }
            if v < end {
                grow(&scene, i + 1);
                setField(&scene.nodes.items[i], bytes, f, fe, v + 1, end);
            }
        } else {
            let k = line;
            while k < end { rest.push(bytes[k]); k += 1; }
            rest.push(10);
        }
        line = end + 1;
    }
    scene.data = rest.str();
    return scene;
}

fn nodeLine(bytes: []u8, at: int, end: int): int {
    let prefix = "node.";
    if end - at <= prefix.len { return -1; }
    for k in 0..prefix.len { if bytes[at + k] != prefix[k] { return -1; } }
    let c = at + prefix.len;
    let i = 0;
    let any = false;
    while c < end && bytes[c] >= 48 && bytes[c] <= 57 {
        i = i * 10 + int(bytes[c]) - 48;
        if i > bytes.len { return -1; }
        c += 1;
        any = true;
    }
    if !any || c >= end || bytes[c] != 46 { return -1; }
    return i;
}

fn fieldIs(bytes: []u8, at: int, end: int, name: string): bool {
    if end - at != name.len { return false; }
    for i in 0..name.len { if bytes[at + i] != name[i] { return false; } }
    return true;
}

fn bytesStart(bytes: []u8, at: int, end: int, prefix: string): bool {
    if end - at < prefix.len { return false; }
    for k in 0..prefix.len { if bytes[at + k] != prefix[k] { return false; } }
    return true;
}

fn setField(n: &SceneNode, bytes: []u8, f: int, fe: int, v: int, end: int) {
    let text = bytes[v..end] as string;
    if fieldIs(bytes, f, fe, "id") { n.id = save.parseInt(bytes, v, n.id); }
    else if fieldIs(bytes, f, fe, "parent") { n.parent = save.parseInt(bytes, v, 0); }
    else if fieldIs(bytes, f, fe, "kind") { n.kind = save.parseInt(bytes, v, GROUP); }
    else if fieldIs(bytes, f, fe, "doubleSided") { n.doubleSided = save.parseInt(bytes, v, 0) != 0; }
    else if fieldIs(bytes, f, fe, "name") { n.name = text; }
    else if fieldIs(bytes, f, fe, "asset") { n.asset = text; }
    else if fieldIs(bytes, f, fe, "texture") { n.texture = text; }
    else if fieldIs(bytes, f, fe, "script") { n.script = text; }
    else if fieldIs(bytes, f, fe, "scene") { n.scene = text; }
    else if fieldIs(bytes, f, fe, "px") { n.position.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "py") { n.position.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "pz") { n.position.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rx") { n.rotation.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "ry") { n.rotation.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rz") { n.rotation.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sx") { n.scale.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sy") { n.scale.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sz") { n.scale.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "fov") { n.fov = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "near") { n.near = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "far") { n.far = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cr") { n.color.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cg") { n.color.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cb") { n.color.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tr") { n.tint.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tg") { n.tint.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tb") { n.tint.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "range") { n.range = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "alpha") { n.alpha = save.parseInt(bytes, v, OPAQUE); }
    else if fieldIs(bytes, f, fe, "opacity") { n.opacity = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "material") { n.material = text; }
    else if fieldIs(bytes, f, fe, "effects") { n.effects = text; }
    else if fieldIs(bytes, f, fe, "tags") { n.tags = text; }
}

fn eol(bytes: []u8, at: int): int {
    let end = at;
    while end < bytes.len && bytes[end] != 10 { end += 1; }
    return end;
}

fn skipSp(bytes: []u8, at: int, end: int): int {
    while at < end && bytes[at] == 32 { at += 1; }
    return at;
}

fn tokEnd(bytes: []u8, at: int, end: int): int {
    let i = at;
    let quoted = false;
    while i < end {
        let b = bytes[i];
        if quoted {
            if b == 92 { i += 1; } else if b == 34 { quoted = false; }
        } else if b == 34 {
            quoted = true;
        } else if b == 32 {
            return i;
        }
        i += 1;
    }
    return end;
}

fn eqAt(bytes: []u8, at: int, end: int): int {
    if at < end && bytes[at] == 34 { return -1; }
    let i = at;
    while i < end && bytes[i] != 61 { i += 1; }
    if i >= end { return -1; }
    return i;
}

fn hasByte(bytes: []u8, at: int, end: int, b: u8): bool {
    for i in at..end { if bytes[i] == b { return true; } }
    return false;
}

fn trailingId(bytes: []u8, s: int, end: int, start: &int): int {
    let e = end;
    while e > s && (bytes[e - 1] == 32 || bytes[e - 1] == 13) { e -= 1; }
    let b = e;
    while b > s && bytes[b - 1] != 32 { b -= 1; }
    if b + 1 >= e || bytes[b] != 35 { return 0; }
    for i in b + 1..e { if bytes[i] < 48 || bytes[i] > 57 { return 0; } }
    *start = b;
    return save.parseInt(bytes, b + 1, 0);
}

fn isDataLine(bytes: []u8, s: int, end: int): bool {
    let i = s;
    while i < end && bytes[i] != 32 && bytes[i] != 61 && bytes[i] != 34 { i += 1; }
    if i == s || i >= end { return false; }
    if bytes[i] == 61 { return true; }
    if bytes[i] != 32 || i + 2 >= end || bytes[i + 2] != 61 { return false; }
    return bytes[i + 1] == 102 || bytes[i + 1] == 115 || bytes[i + 1] == 114;
}

/// 0 blank, 1 `//` note, 2 header, 3 `env`, 4 data, 5 object.
fn lineKind(bytes: []u8, at: int, s: int, end: int): int {
    if s >= end || (s == end - 1 && bytes[s] == 13) { return 0; }
    if bytesStart(bytes, s, end, "//") { return 1; }
    if at == 0 && bytesStart(bytes, s, end, "j3scene") { return 2; }
    if s == at && bytesStart(bytes, s, end, "env ") {
        let t = skipSp(bytes, s + 3, end);
        if eqAt(bytes, t, tokEnd(bytes, t, end)) >= 0 { return 3; }
    }
    if s == at && isDataLine(bytes, s, end) { return 4; }
    return 5;
}

struct V2 {
    scene: &SceneFile;
    bytes: []u8;
    rest: &Text;
    arena: &Arena;
    auto: int;
    stack: []int;
    open: int;
    note: Text;
    hasNote: bool;
    ln: int;
}

fn v2Fail(p: &V2, message: string) {
    if p.scene.parseError.len > 0 { return; }
    let t = Text.new(p.arena);
    t.add("line ");
    t.pushInt(p.ln);
    t.add(": ").add(message);
    p.scene.parseError = t.str();
}

fn v2FailKey(p: &V2, message: string, at: int, end: int) {
    v2Fail(p, Text.new(p.arena).add(message).add(" ").add(p.bytes[at..end] as string).str());
}

fn unq(p: &V2, at: int, end: int): string {
    let bytes = p.bytes;
    if at < end && bytes[at] == 34 {
        let stop = end;
        if stop > at + 1 && bytes[stop - 1] == 34 { stop -= 1; }
        if !hasByte(bytes, at + 1, stop, 92) { return bytes[at + 1..stop] as string; }
        let t = Text.new(p.arena);
        let i = at + 1;
        while i < stop {
            if bytes[i] == 92 && i + 1 < stop { i += 1; }
            t.push(bytes[i]);
            i += 1;
        }
        return t.str();
    }
    return bytes[at..end] as string;
}

fn radians(degrees: f32): f32 { return f32(f64(degrees) * 0.017453292519943295); }

fn parseVec3(bytes: []u8, at: int, end: int, v: &Vec3, uniform: bool): bool {
    let vals: [3]f32 = [0.0, 0.0, 0.0];
    let n = 0;
    let i = at;
    while n < 3 && i < end {
        vals[n] = save.parseFloat(bytes, i);
        n += 1;
        while i < end && bytes[i] != 44 { i += 1; }
        i += 1;
    }
    if n == 3 { *v = Vec3.xyz(vals[0], vals[1], vals[2]); return true; }
    if n == 1 && uniform { *v = Vec3.xyz(vals[0], vals[0], vals[0]); return true; }
    return false;
}

fn plainName(s: string): bool { return s.len == 0 || hasByte(s as []u8, 0, s.len, 47) || hasByte(s as []u8, 0, s.len, 46); }

fn expandName(p: &V2, at: int, end: int, folder: string, ext: string): string {
    let raw = unq(p, at, end);
    if plainName(raw) { return raw; }
    return Text.new(p.arena).add(folder).add(raw).add(ext).str();
}

fn expandList(p: &V2, at: int, end: int, folder: string, ext: string): string {
    let raw = unq(p, at, end);
    let t = Text.new(p.arena);
    let from = 0;
    while from <= raw.len {
        let to = from;
        while to < raw.len && raw[to] != 124 { to += 1; }
        if from > 0 { t.push(124); }
        let part = raw[from..to];
        if plainName(part) { t.add(part); } else { t.add(folder).add(part).add(ext); }
        from = to + 1;
    }
    return t.str();
}

fn v2Data(p: &V2, head: string, id: int, fa: int, fe: int, v: int, e: int, text: bool) {
    let bytes = p.bytes;
    let t = p.rest;
    t.add(head);
    t.pushInt(id);
    t.push(46);
    t.add(bytes[fa..fe] as string);
    if text || (v < e && bytes[v] == 34) {
        t.add(" s=").add(unq(p, v, e));
    } else if v < e && bytes[v] == 35 {
        t.add(" r=").add(bytes[v + 1..e] as string);
    } else if hasByte(bytes, v, e, 46) {
        t.add(" f=").add(bytes[v..e] as string);
    } else {
        t.push(61);
        t.add(bytes[v..e] as string);
    }
    t.push(10);
}

fn isShape(name: string): bool {
    return name == "cube" || name == "sphere" || name == "cylinder" || name == "cone" || name == "capsule"
        || name == "torus" || name == "quad" || name == "plane" || name == "sky";
}

fn v2Kind(p: &V2, n: &SceneNode, a: int, e: int) {
    let bytes = p.bytes;
    if fieldIs(bytes, a, e, "group") { n.kind = GROUP; }
    else if fieldIs(bytes, a, e, "mesh") { n.kind = MESH; }
    else if fieldIs(bytes, a, e, "place") { n.kind = INSTANCE; }
    else if fieldIs(bytes, a, e, "light") { n.kind = LIGHT; }
    else if fieldIs(bytes, a, e, "camera") { n.kind = CAMERA; }
    else if isShape(bytes[a..e] as string) {
        n.kind = MESH;
        n.asset = Text.new(p.arena).add("builtin:").add(bytes[a..e] as string).str();
    } else {
        v2FailKey(p, "unknown kind", a, e);
    }
}

fn v2Field(p: &V2, n: &SceneNode, id: int, a: int, e: int) {
    let bytes = p.bytes;
    let eq = eqAt(bytes, a, e);
    if eq < 0 {
        if n.kind == MESH { n.asset = unq(p, a, e); }
        else if n.kind == INSTANCE { n.scene = unq(p, a, e); }
        else { v2FailKey(p, "a path only goes on mesh and place objects:", a, e); }
        return;
    }
    let v = eq + 1;
    let ok = true;
    if fieldIs(bytes, a, eq, "pos") { ok = parseVec3(bytes, v, e, &n.position, false); }
    else if fieldIs(bytes, a, eq, "rot") {
        let d = Vec3.zero();
        ok = parseVec3(bytes, v, e, &d, false);
        n.rotation = Vec3.xyz(radians(d.x), radians(d.y), radians(d.z));
    }
    else if fieldIs(bytes, a, eq, "scale") { ok = parseVec3(bytes, v, e, &n.scale, true); }
    else if fieldIs(bytes, a, eq, "tint") { ok = parseVec3(bytes, v, e, &n.tint, true); }
    else if fieldIs(bytes, a, eq, "color") { ok = parseVec3(bytes, v, e, &n.color, true); }
    else if fieldIs(bytes, a, eq, "range") { n.range = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "fov") { n.fov = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "near") { n.near = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "far") { n.far = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "opacity") { n.opacity = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "material") { n.material = expandName(p, v, e, "assets/materials/", ".j3mat"); }
    else if fieldIs(bytes, a, eq, "fx") || fieldIs(bytes, a, eq, "effects") {
        n.effects = expandList(p, v, e, "assets/fx/", ".j3fx");
    }
    else if fieldIs(bytes, a, eq, "texture") { n.texture = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "script") { n.script = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "tags") { n.tags = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "asset") { n.asset = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "scene") { n.scene = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "doubleSided") { n.doubleSided = save.parseInt(bytes, v, 0) != 0; }
    else if fieldIs(bytes, a, eq, "alpha") {
        if fieldIs(bytes, v, e, "cutout") { n.alpha = CUTOUT; }
        else if fieldIs(bytes, v, e, "blend") { n.alpha = BLEND; }
        else if fieldIs(bytes, v, e, "opaque") { n.alpha = OPAQUE; }
        else { n.alpha = save.parseInt(bytes, v, OPAQUE); }
    }
    else if bytesStart(bytes, a, eq, "param.") { v2Data(p, "param.", id, a + 6, eq, v, e, false); }
    else if bytesStart(bytes, a, eq, "fx.") { v2Data(p, "param.", id, a, eq, v, e, false); }
    else if bytesStart(bytes, a, eq, "prop.") { v2Data(p, "over.", id, a, eq, v, e, true); }
    else if bytesStart(bytes, a, eq, "over.") { v2Data(p, "over.", id, a + 5, eq, v, e, false); }
    else { v2FailKey(p, "unknown key", a, eq); }
    if !ok { v2FailKey(p, "bad value in", a, e); }
}

fn v2Object(p: &V2, at: int, s: int, end: int) {
    let bytes = p.bytes;
    let scene = p.scene;
    let depth = (s - at) / 2;
    if (s - at) - depth * 2 != 0 {
        v2Fail(p, "indent must be a multiple of two spaces");
        depth = 0;
    } else if depth > p.open || depth >= 64 {
        v2Fail(p, "indented more than one level below its parent");
        depth = 0;
    }
    let parent = 0;
    if depth > 0 { parent = p.stack[depth - 1]; }
    let idAt = end;
    let id = trailingId(bytes, s, end, &idAt);
    if id == 0 {
        id = p.auto;
        p.auto += 1;
    }
    let stop = idAt;
    while stop > s && (bytes[stop - 1] == 32 || bytes[stop - 1] == 13) { stop -= 1; }
    grow(scene, scene.nodes.len + 1);
    let n = &scene.nodes.items[scene.nodes.len - 1];
    n.id = id;
    n.parent = parent;
    if p.hasNote {
        n.note = p.note.str();
        p.note = Text.new(p.arena);
        p.hasNote = false;
    }
    p.stack[depth] = id;
    p.open = depth + 1;
    let cur = s;
    let te = tokEnd(bytes, cur, stop);
    n.name = unq(p, cur, te);
    cur = skipSp(bytes, te, stop);
    te = tokEnd(bytes, cur, stop);
    if cur >= stop { v2Fail(p, "object needs a kind after its name"); return; }
    v2Kind(p, n, cur, te);
    cur = skipSp(bytes, te, stop);
    while cur < stop {
        te = tokEnd(bytes, cur, stop);
        v2Field(p, n, id, cur, te);
        cur = skipSp(bytes, te, stop);
    }
}

fn envLine(p: &V2, name: string, float: bool, at: int, end: int) {
    p.rest.add("scene.env.").add(name);
    if float { p.rest.add(" f="); } else { p.rest.push(61); }
    p.rest.add(p.bytes[at..end] as string);
    p.rest.push(10);
}

fn envVec(p: &V2, x: string, y: string, z: string, at: int, end: int) {
    let to = at;
    while to < end && p.bytes[to] != 44 { to += 1; }
    envLine(p, x, true, at, to);
    let from = to + 1;
    to = from;
    while to < end && p.bytes[to] != 44 { to += 1; }
    envLine(p, y, true, from, to);
    from = to + 1;
    envLine(p, z, true, from, end);
}

fn v2Env(p: &V2, s: int, end: int) {
    let bytes = p.bytes;
    let cur = skipSp(bytes, s + 3, end);
    while cur < end {
        let te = tokEnd(bytes, cur, end);
        let eq = eqAt(bytes, cur, te);
        if eq < 0 { v2FailKey(p, "env needs key=value, got", cur, te); }
        else {
            let v = eq + 1;
            if fieldIs(bytes, cur, eq, "sun") { envVec(p, "sunX", "sunY", "sunZ", v, te); }
            else if fieldIs(bytes, cur, eq, "sunColor") { envVec(p, "sunR", "sunG", "sunB", v, te); }
            else if fieldIs(bytes, cur, eq, "sky") { envVec(p, "skyR", "skyG", "skyB", v, te); }
            else if fieldIs(bytes, cur, eq, "fogStart") { envLine(p, "fogStart", true, v, te); }
            else if fieldIs(bytes, cur, eq, "fogEnd") { envLine(p, "fogEnd", true, v, te); }
            else if fieldIs(bytes, cur, eq, "shadowSize") { envLine(p, "shadowSize", true, v, te); }
            else if fieldIs(bytes, cur, eq, "urpShadowNear") { envLine(p, "urpShadowNear", true, v, te); }
            else if fieldIs(bytes, cur, eq, "shadows") { envLine(p, "shadows", false, v, te); }
            else if fieldIs(bytes, cur, eq, "urp") { envLine(p, "urp", false, v, te); }
            else if fieldIs(bytes, cur, eq, "urpBounces") { envLine(p, "urpBounces", false, v, te); }
            else if fieldIs(bytes, cur, eq, "urpSamples") { envLine(p, "urpSamples", false, v, te); }
            else if fieldIs(bytes, cur, eq, "urpShadows") { envLine(p, "urpShadows", false, v, te); }
            else { v2FailKey(p, "unknown env key", cur, eq); }
        }
        cur = skipSp(bytes, te, end);
    }
}

fn parseV2(scene: &SceneFile, bytes: []u8, rest: &Text) {
    let arena = scene.arena;
    let p = V2 { scene: scene, bytes: bytes, rest: rest, arena: arena, auto: 1, stack: arena.alloc::<int>(64),
        open: 0, note: Text.new(arena), hasNote: false, ln: 0 };
    // First pass: the header's `next=` and the largest `#id`, so a line without one gets a free id.
    let at = 0;
    while at < bytes.len {
        let end = eol(bytes, at);
        let s = skipSp(bytes, at, end);
        let kind = lineKind(bytes, at, s, end);
        if kind == 2 {
            for k in s..end {
                if bytesStart(bytes, k, end, "next=") {
                    let next = save.parseInt(bytes, k + 5, 1);
                    if next > p.auto { p.auto = next; }
                }
            }
        } else if kind == 5 {
            let ignore = end;
            let id = trailingId(bytes, s, end, &ignore);
            if id >= p.auto { p.auto = id + 1; }
        }
        at = end + 1;
    }
    at = 0;
    while at < bytes.len {
        let end = eol(bytes, at);
        p.ln += 1;
        let s = skipSp(bytes, at, end);
        let kind = lineKind(bytes, at, s, end);
        if kind == 1 {
            let from = s + 2;
            if from < end && bytes[from] == 32 { from += 1; }
            let to = end;
            if to > from && bytes[to - 1] == 13 { to -= 1; }
            if p.hasNote { p.note.push(10); }
            p.note.add(bytes[from..to] as string);
            p.hasNote = true;
        } else if kind == 2 {
            for h in s..end {
                if bytesStart(bytes, h, end, "next=") {
                    rest.add("scene.nextId=");
                    rest.pushInt(save.parseInt(bytes, h + 5, 1));
                    rest.push(10);
                }
            }
        } else if kind == 3 {
            v2Env(&p, s, end);
        } else if kind == 4 {
            rest.add(bytes[s..end] as string);
            rest.push(10);
        } else if kind == 5 {
            v2Object(&p, at, s, end);
        }
        at = end + 1;
    }
}
