// The import walk (every `use` of every loaded file, then its scripts), generated modules (`j3.i18nconfig`,
// `<package>.ui`), the `.j3s` tool host, and the target's OS and CPU.
//
// Part of module j3c.load.
// Port of: j3c/src/compile/loader.rs (load_imports, imports_of, load_ui, derives_generic, other_module),
// compile.rs (tool_host, os_kind, arch_kind, builtin_hello), i18n.rs (MODULE, LABEL, config_module)
module j3c.load;
// J3: A part of `load.j3` (its `use`s). `os_kind`'s `target_os` is a copy of `toolchain/target`'s rule,
// which sits below `load` (ponytail, as `manifest.isAndroid`).

/// The module `j3.i18n` imports: the project's `[i18n]` settings as constants (Rust `i18n::MODULE`).
pub const I18N_MODULE: string = "j3.i18nconfig";
pub const I18N_LABEL: string = "<j3.i18nconfig>";

/// `j3.cmp`, whose traits a derive on a generic type names in its bounds.
const CMP: string = "j3.cmp";

/// Rust's built-in hello program (`j3c/tests/programs/hello.j3`), for a command with no project.
const HELLO_SRC = @embed("../../../j3c/tests/programs/hello.j3");

/// Rust `default_hello_path`: `<j3c>/tests/programs/hello.j3`.
pub fn helloPath(a: &Arena): string { return path.join(manifestDir(a), "tests/programs/hello.j3", a); }

extend Loader {
    /// Breadth-first over `files`: each file's imports load (appending files) before the next file's.
    /// ponytail: serial; Rust plans each wave's plain loads and parses them on all cores in this order.
    fn loadImports(this: &Loader): Result<bool, string> {
        let i = 0;
        while i < this.files.len {
            this.importsOf(i)?;
            i += 1;
        }
        return Result.Ok(true);
    }

    /// The serial walk for one file: every `use`, then its scripts.
    fn importsOf(this: &Loader, i: int): Result<bool, string> {
        let a = this.arena;
        let uses = List<UseItem>.new(a);
        let items = this.files.items[i].ast.items;
        for k in 0..items.len {
            match items.items[k] {
                Item.Use(u) { uses.push(u); }
                _ {}
            }
        }
        for k in 0..uses.len {
            let ps = List<string>.new(a);
            for j in 0..uses.items[k].path.len { ps.push(this.ast.str(uses.items[k].path.items[j].name)); }
            let key = joinKey(ps.items[0..ps.len], a);
            let hasNames = match uses.items[k].names { Option.Some(_) { true } Option.None { false } };
            // ponytail (Rust's): a stub module cannot fail on `use`, and `j3.steam.game.attach` has no file to stub
            if ps.len >= 2 && ps.items[0] == "j3" && ps.items[1] == "steam" && !this.exists(this.modulePath(prefix(ps, 2, a))) {
                return this.fail(Text.new(a).add("`use ").add(key).add("`: j3.steam moved to the \"steam\" package: add steam = { git = \"https://github.com/Jacoby-Y/j3-steam\", tag = \"v0.1.0\" } under [dependencies] and write `use steam;` (j3c doc steam)").str());
            }
            if key == SCENE_MODULE {
                this.loadRegistry()?;
            } else if key == I18N_MODULE || key == appconfig.MODULE {
                this.loadModule(ps)?;
            } else if hasNames {
                this.loadModule(ps)?;
            } else if this.exists(this.modulePath(ps)) {
                this.loadModule(ps)?;
            } else if ps.len >= 2 {
                this.loadModule(prefix(ps, ps.len - 1, a))?;
            } else {
                return this.fail(Text.new(a).add("cannot resolve `use ").add(key).add("`").str());
            }
        }
        if derivesGeneric(&this.files.items[i].ast) { this.loadModule(mods(a, "j3", "cmp"))?; }
        let scripts = scripts_deps.find(this.ast, &this.files.items[i].ast);
        for k in 0..scripts.len { this.loadScript(scripts.items[k].path, i, scripts.items[k].span)?; }
        return Result.Ok(true);
    }

    /// `<package>.ui`, generated from the project's `*.j3ui`.
    // J3: C4 ports `ui::scan`, the icons and `ui::try_build`; until then importing it is an error.
    fn loadUi(this: &Loader): Result<bool, string> {
        return this.fail("ui: .j3ui components: not ported yet");
    }
}

/// The first `n` parts of `ps`.
fn prefix(ps: List<string>, n: int, a: &Arena): List<string> {
    let out = List<string>.new(a);
    for i in 0..n { out.push(ps.items[i]); }
    return out;
}

/// A `#[derive(..)]` on a generic struct or enum: its methods are bounded by `j3.cmp`'s traits, so that
/// module loads even when the file does not `use` it.
fn derivesGeneric(f: &File): bool {
    for i in 0..f.items.len {
        match f.items.items[i] {
            Item.Struct(s) { if s.derives.len > 0 && s.typeParams.len > 0 { return true; } }
            Item.Enum(e) { if e.derives.len > 0 && e.typeParams.len > 0 { return true; } }
            _ {}
        }
    }
    return false;
}

/// A file in a parts folder whose `module` line names another module is its own module, so it is not
/// parsed as a part. No such line (or an odd one): the parser decides.
fn otherModule(src: string, key: string): bool {
    let at = 0;
    while at <= src.len {
        let e = at;
        while e < src.len && src[e] != '\n' { e += 1; }
        let line = text.trim(src[at..e]);
        if startsWith(line, "module ") {
            let rest = line[7..line.len];
            if !endsWith(rest, ";") { return false; }
            return text.trim(rest[0..rest.len - 1]) != key;
        }
        if e >= src.len { break; }
        at = e + 1;
    }
    return false;
}

/// Rust `i18n::config_module`: `[i18n]` of `root/j3.toml` as constants.
fn i18nConfigModule(root: string, a: &Arena): string {
    let t = match fsx.readText(path.join(root, "j3.toml", a), a) { Result.Ok(x) { x } Result.Err(_) { "" } };
    let get = fn(k: string, d: string): string {
        return match toml.str(t, "i18n", k, a) { Option.Some(v) { v } Option.None { d } };
    };
    let out = Text.new(a);
    out.add("/// `[i18n]` of j3.toml, baked in at build time.\nmodule j3.i18nconfig;\npub const DIR: string = \"");
    pushEscaped(&out, get("dir", "locales"), false);
    out.add("\";\npub const DEFAULT: string = \"");
    pushEscaped(&out, get("default", "en"), false);
    out.add("\";\npub const FALLBACK: string = \"");
    pushEscaped(&out, get("fallback", "en"), false);
    out.add("\";\n");
    return out.str();
}

/// A `.j3s` entry is a tool: one instance, then `pub fn main()` (Rust `compile::tool_host`).
fn toolHost(l: &Loader, entry: string): Result<string, string> {
    let a = l.arena;
    let src = fsx.readText(entry, a)?;
    let id = l.sources.add(Source { path: own(a, entry), text: src, lines: Lines.of(src, a) });
    let modPath: [2]string = ["script", "tool"];
    let f = match parse.parseScript(src, id, modPath, l.ast) {
        Result.Ok(f) { f }
        Result.Err(e) { parse.report(e, l.diags); return Result.Err(""); }
    };
    let ready = false;
    for i in 0..f.items.len {
        match f.items.items[i] {
            Item.Fn(fi) {
                let noRet = match fi.ret { Option.Some(_) { false } Option.None { true } };
                if fi.visPub && l.ast.str(fi.name.name) == "main" && fi.params.len == 0 && noRet { ready = true; }
            }
            _ {}
        }
    }
    if !ready {
        return Result.Err(Text.new(a).add(entry).add(" has no `pub fn main()`\n  = help: this file is a tool entry; scene scripts are started by the game (`script=` on an object)").str());
    }
    let typeName = scriptName(entry, a);
    let ident = typeName.len > 0 && (isAlpha(typeName[0]) || typeName[0] == '_');
    for i in 0..typeName.len {
        let c = typeName[i];
        if !(isAlpha(c) || (c >= '0' && c <= '9') || c == '_') { ident = false; }
    }
    if !ident {
        return Result.Err(Text.new(a).add(entry).add(" script type `").add(typeName).add("` is not a name the host can bind").str());
    }
    let fileName = path.basename(entry);
    let t = Text.new(a);
    t.add("module tool_host;\nconst ").add(typeName).add(" = @script(\"").add(fileName).add("\");\nfn main() {\n    let tool = ");
    t.add(typeName).add(" {};\n    tool.main();\n}\n");
    return Result.Ok(t.str());
}

/// Rust `check::script::script_name`: the file stem's `_` words, each capitalized, joined.
// ponytail: ASCII uppercasing only (Rust `char::to_uppercase`); script names are identifiers.
pub fn scriptName(p: string, a: &Arena): string {
    let stem = stripExt(path.basename(p));
    if stem.len == 0 { return "Script"; }
    let t = Text.new(a);
    let start = true;
    for i in 0..stem.len {
        let c = stem[i];
        if c == '_' { start = true; continue; }
        if start && c >= 'a' && c <= 'z' { c = c - 32; }
        start = false;
        t.push(c);
    }
    return t.str();
}

/// The CPU a target triple names, as the index of `j3.sys.ARCH_*` (empty: the host).
fn archKind(target: string): int {
    if target.len == 0 { return sys.ARCH; }
    let e = 0;
    while e < target.len && target[e] != '-' { e += 1; }
    let t = target[0..e];
    if t == "x86_64" || t == "amd64" { return 0; }
    if t == "aarch64" || t == "arm64" || t == "arm64e" { return 1; }
    if t == "i386" || t == "i486" || t == "i586" || t == "i686" || t == "x86" { return 2; }
    if startsWith(t, "arm") || startsWith(t, "thumb") { return 3; }
    if startsWith(t, "riscv") { return 4; }
    return 5;
}

/// Rust `compile::os_kind` (`emit::host::target_os`); "" is Linux.
fn osKind(target: string): OsKind {
    if target.len == 0 { return OsKind.Linux; }
    if hasLower(target, "windows") { return OsKind.Windows; }
    if hasLower(target, "apple") || hasLower(target, "darwin") { return OsKind.Macos; }
    if hasLower(target, "emscripten") { return OsKind.Web; }
    if hasLower(target, "android") { return OsKind.Android; }
    return OsKind.Linux;
}
