// `@embed*`: read the files a parsed file embeds, so `sema` sees their bytes. A path is relative to the
// source file's folder, else to the package root (`@script`'s root).
//
// Part of module j3c.load.
// Port of: j3c/src/compile/loader/embed.rs
// J3: The embedded bytes and their content hash are part of the module's load output (plan 11 B5), so an
// edited embedded file changes that module's key and nothing else.
module j3c.load;
// J3: A part of `load.j3` (its `use`s). The calls come from `findEmbeds` (`load/scripts.j3`, Rust
// `script_deps::embeds`). An error is a Diag at the call's span (Rust renders a `CheckError` there).

extend Loader {
    /// Fill `f.embeds` with what each `@embed*` in `f` (file `p`) reads.
    fn readEmbeds(this: &Loader, p: string, f: &File): Result<bool, string> {
        let a = this.arena;
        let refs = scripts_deps.embeds(this.ast, f);
        for k in 0..refs.len {
            let r = refs.items[k];
            let dir = match parentOf(p) { Option.Some(d) { d } Option.None { "." } };
            let wantDir = r.kind == EmbedKind.Dir;
            let c0 = path.join(dir, r.path, a);
            let c1 = path.join(this.scriptRoot, r.path, a);
            let found = "";
            let ok = false;
            if this.embedAt(c0, wantDir) { found = c0; ok = true; } else if this.embedAt(c1, wantDir) { found = c1; ok = true; }
            if !ok {
                let t = Text.new(a);
                t.add("`@").add(kindName(r.kind)).add("`: no ").add(if wantDir { "folder" } else { "file" }).add(" `").add(r.path);
                t.add("` (looked beside ").add(dir).add(" and in ").add(this.scriptRoot).add(")");
                return this.embedFail(r.span, t.str());
            }
            let files = List<EmbedFile>.new(a);
            if wantDir {
                let names = List<string>.new(a);
                walkEmbed(found, "", r.glob, &names, a);
                sortBy(names.items[0..names.len], fn(x: string, y: string): bool { return x < y; });
                if names.len == 0 {
                    return this.embedFail(r.span, Text.new(a).add("`@embedDir`: no `").add(r.glob).add("` files under `").add(found).add("`").str());
                }
                for i in 0..names.len {
                    match this.readEmbed(path.join(found, names.items[i], a), names.items[i]) {
                        Result.Ok(e) { files.push(e); }
                        Result.Err(e) { return this.embedFail(r.span, e); }
                    }
                }
            } else {
                match this.readEmbed(found, r.path) {
                    Result.Ok(e) { files.push(e); }
                    Result.Err(e) { return this.embedFail(r.span, e); }
                }
            }
            f.embeds.push(EmbedRead { at: r.span, files: files });
        }
        return Result.Ok(true);
    }

    /// `p` is what the call wants: a folder, else a file (or an overlay).
    fn embedAt(this: &Loader, p: string, wantDir: bool): bool {
        if wantDir { return fsx.isDir(p); }
        if fsx.isFile(p) { return true; }
        match this.overlay(p) { Option.Some(_) { return true; } Option.None { return false; } }
    }

    fn embedFail(this: &Loader, sp: Span, msg: string): Result<bool, string> {
        this.diags.add(this.diags.make(0, Severity.Error, sp, msg));
        return Result.Err("");
    }

    fn overlay(this: &Loader, p: string): Option<string> {
        for i in 0..this.overlays.len {
            if fsx.samePath(this.overlays.items[i].path, p, this.arena) { return Option.Some(this.overlays.items[i].text); }
        }
        return Option.None;
    }

    fn readEmbed(this: &Loader, disk: string, name: string): Result<EmbedFile, string> {
        let a = this.arena;
        let data = match this.overlay(disk) {
            Option.Some(s) { s as []u8 }
            Option.None {
                match io.readFile(disk, a) {
                    Result.Ok(b) { b }
                    Result.Err(_) {
                        return Result.Err(Text.new(a).add("cannot read `").add(disk).add("`: ").add(fsx.osError(sys.errno(), a)).str());
                    }
                }
            }
        };
        return Result.Ok(EmbedFile { name: own(a, name), disk: own(a, disk), data: data });
    }
}

fn kindName(k: EmbedKind): string {
    match k {
        EmbedKind.Text { return "embed"; }
        EmbedKind.Bytes { return "embedBytes"; }
        EmbedKind.Dir { return "embedDir"; }
    }
    return "";
}

/// Files under `dir` whose name matches `glob` (`*` is any run), as `/`-separated paths below the starting
/// folder. Dot entries are skipped; a `glob` with `/` matches the whole relative path.
fn walkEmbed(dir: string, rel: string, glob: string, out: &List<string>, a: &Arena) {
    match io.listDir(dir, a) {
        Result.Ok(ents) {
            let whole = text.find(glob, "/") >= 0;
            for i in 0..ents.len {
                let n = ents[i].name;
                if n.len > 0 && n[0] == '.' { continue; }
                let sub = if rel.len == 0 { n } else { Text.new(a).add(rel).add("/").add(n).str() };
                if ents[i].isDir {
                    walkEmbed(path.join(dir, n, a), sub, glob, out, a);
                } else if wild(glob, if whole { sub } else { n }) {
                    out.push(sub);
                }
            }
        }
        Result.Err(_) {}
    }
}

/// `name` matches `pat`, where `*` is any run of bytes (Rust `mcp::wild`).
pub fn wild(pat: string, name: string): bool {
    let star = text.find(pat, "*");
    if star < 0 { return pat == name; }
    let head = pat[0..star];
    if !startsWith(name, head) { return false; }
    let rest = pat[star + 1..pat.len];
    let tail = name[head.len..name.len];
    for i in 0..tail.len + 1 {
        if wild(rest, tail[i..tail.len]) { return true; }
    }
    return false;
}
