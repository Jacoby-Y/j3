// Script structs in the IR: the `ScriptMeta` (path, prop spans) that marks a struct as a `.j3s` script.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/types.rs (the `script` field of the struct made by collect_struct_names)
// J3: Every script rule is sema's (`sema/script_body.j3`); lower only carries the mark, which the IR
// validator and the bc backend (C4) read.
module j3c.lower;
use j3c.ir.ScriptMeta;
// J3: Contract (wave 13): contracts-c2d.md, chunk C.

/// The IR `StructDef.script` of sema struct `sd`: Some for a `.j3s` script's struct.
fn scriptMeta(sd: &StructDecl): Option<ScriptMeta> {
    match sd.scriptPath {
        Option.Some(p) { return Option.Some(ScriptMeta { path: p, propSpans: sd.propSpans }); }
        Option.None {}
    }
    return Option.None;
}
