// Waking struct-instance methods: after a body is lowered, every fn it names (calls and fn values) that
// is a not-yet-lowered method of a generic struct instance is queued, in the order the IR names them.
//
// Part of module j3c.lower.
// Port of: check/lower/lazy.rs (wake, walk_block and friends)
// J3: The walk is over the finished IR block, as in Rust, not over the order `instFn` was called in: the
// two differ (a `match` lowers its arms last to first), and the queue order is the IR's fn order.
module j3c.lower;

/// Rust `lazy::wake`: queue every still-lazy method `b` names.
fn instWake(lw: &Lw, b: &Block) {
    let found = List<u32>.new(lw.cx.arena);
    instWalkBlock(b, &found);
    for i in 0..found.len {
        let id = found.items[i];
        match lw.lazy.get(id) {
            Option.Some(inst) {
                if inst == 0 { panic("lower: a method named without its instance"); }
                lw.lazy.remove(id);
                lw.pending.push(Id<Instance> { i: inst - 1 });
            }
            Option.None {}
        }
    }
}

fn instWalkBlock(b: &Block, out: &List<u32>) {
    for i in 0..b.stmts.len {
        match b.stmts.items[i].kind {
            StmtKind.Assign(a) { instWalkPlace(&a.place, out); instWalkRv(&a.rvalue, out); }
            StmtKind.AssignOp(a) { instWalkPlace(&a.place, out); instWalkOp(a.rhs, out); }
            StmtKind.Defer(d) { instWalkBlock(&d.body, out); }
            StmtKind.Block(body) { instWalkBlock(&body, out); }
            StmtKind.If(s) {
                instWalkOp(s.cond, out);
                instWalkBlock(&s.thenBlock, out);
                match s.elseBlock { Option.Some(e) { instWalkBlock(&e, out); } Option.None {} }
            }
            StmtKind.Switch(s) {
                instWalkOp(s.scrut, out);
                for k in 0..s.cases.len { instWalkBlock(&s.cases.items[k].block, out); }
                instWalkBlock(&s.default, out);
            }
            StmtKind.While(w) { instWalkOp(w.cond, out); instWalkBlock(&w.body, out); }
            StmtKind.Return(r) { match r.value { Option.Some(v) { instWalkOp(v, out); } Option.None {} } }
            StmtKind.Expr(r) { instWalkRv(&r, out); }
            StmtKind.ForRange(f) { instWalkPlace(&f.index, out); instWalkOp(f.end, out); instWalkBlock(&f.body, out); }
            StmtKind.Abort(a) { instWalkOps(&a.args, out); }
            StmtKind.InterpFill(f) { instWalkPlace(&f.buf, out); instWalkPlace(&f.used, out); instWalkParts(&f.parts, out); }
            StmtKind.Break(_) {}
            StmtKind.Continue(_) {}
            StmtKind.Div0 {}
        }
    }
}

fn instWalkRv(r: &Rvalue, out: &List<u32>) {
    match r.kind {
        RvalueKind.Use(o) { instWalkOp(o, out); }
        RvalueKind.Unary(u) { instWalkOp(u.arg, out); }
        RvalueKind.Cast(c) { instWalkOp(c.from, out); }
        RvalueKind.Ref(p) { instWalkPlace(&p.place, out); }
        RvalueKind.Binary(b) { instWalkOp(b.lhs, out); instWalkOp(b.rhs, out); }
        RvalueKind.Call(c) { instWalkOp(c.func, out); instWalkOps(&c.args, out); }
        RvalueKind.Syscall(s) { instWalkOp(s.nr, out); instWalkOps(&s.args, out); }
        RvalueKind.Atomic(a) { instWalkOps(&a.args, out); }
        RvalueKind.Simd(s) { instWalkOps(&s.args, out); }
        RvalueKind.Aggregate(a) { instWalkOps(&a.fields, out); }
        RvalueKind.Enum(e) { match e.payload { Option.Some(p) { instWalkOp(p, out); } Option.None {} } }
        RvalueKind.Interpolate(it) { instWalkParts(&it.parts, out); }
    }
}

fn instWalkOps(ops: &List<Operand>, out: &List<u32>) {
    for i in 0..ops.len { instWalkOp(ops.items[i], out); }
}

fn instWalkParts(parts: &List<InterpPart>, out: &List<u32>) {
    for i in 0..parts.len {
        match parts.items[i] {
            InterpPart.Value(o) { instWalkOp(o, out); }
            InterpPart.Lit(_) {}
        }
    }
}

fn instWalkPlace(p: &Place, out: &List<u32>) {
    for i in 0..p.proj.len {
        match p.proj.items[i] {
            Proj.Index(ix) { instWalkOp(ix.index, out); }
            _ {}
        }
    }
}

fn instWalkOp(o: Operand, out: &List<u32>) {
    match o {
        Operand.Const(c) {
            match c.kind {
                ConstKind.FnAddr(fa) { out.push(fa.func.i); }
                _ {}
            }
        }
        Operand.Copy(p) { instWalkPlace(&p, out); }
    }
}
