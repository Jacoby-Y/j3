// `f16` storage rules: conversions in and out, everything else an error with the fix.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/half.rs
module j3c.lower;
use j3c.ir.halfFromF64;
// J3: C2c hooks (contracts-c2c.md, owner: simd/f16/intrinsics). The rules and their errors are sema's
// (`body_expr.convert`, `halfError`); here the constants (`ir.halfFromF64`) and the casts.

extend FnLower {
    /// Rust `half_const`: float `f` rounded to an `f16` constant (its binary16 bits as an int constant).
    fn halfConst(this: &FnLower, sp: Span, ty: Id<TyKind>, f: f64): Operand { return opInt(sp, ty, u64(halfFromF64(f))); }

    /// `ConvKind.ToHalf` / `FromHalf` (Rust: a plain cast after `half_cast`'s checks).
    fn halfConvert(this: &FnLower, e: Id<TExpr>, inner: Id<TExpr>): Rvalue {
        let from = this.operand(inner);
        return Rvalue.cast(this.spanOf(e), this.tyOf(e), from);
    }

    /// Rust `zeroed` for `f16` (check/lower/zeroed.rs:15): the zero scalar a typed `let` stores.
    fn halfZero(this: &FnLower, sp: Span): Operand { return this.halfConst(sp, this.ir().common.f16, 0.0); }
}
