// Tuples: `(a, b)` values and the hidden temporaries of tuple `==` / `!=` / `hash()`.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/tuple.rs, check/lower/lit.rs (tuple_lit)
// J3: C2c hooks (contracts-c2c.md, owner: tuples). The tuple struct is `Lw.tupleTy` (`lower/decls.j3`);
// `.0` is an ordinary `TPlace.Field`. Sema wrote the element-wise expression (`TExpr.LetIn`).
module j3c.lower;

extend FnLower {
    /// Rust `tuple_lit`: the element operands in order, one aggregate.
    fn tupleLit(this: &FnLower, e: Id<TExpr>, t: &TElems): Rvalue {
        let ops = List<Operand>.new(this.cx.arena);
        for i in 0..t.items.len { ops.push(this.operand(t.items.items[i])); }
        return Rvalue.aggregate(this.spanOf(e), this.tyOf(e), ops);
    }

    /// `TExpr.LetIn` (Rust `bind_named`): every value's operand first (Rust had them before it bound any),
    /// then one `_tupN = use(op)` per local, then the body.
    fn tupleLetIn(this: &FnLower, e: Id<TExpr>, l: &TLetIn): Rvalue {
        let sp = this.spanOf(e);
        let ops = List<Operand>.new(this.cx.arena);
        for i in 0..l.values.len { ops.push(this.operand(l.values.items[i])); }
        for i in 0..l.locals.len {
            let d = this.lw.typed.local(l.locals.items[i]);
            let id = this.b.tmp(this.fresh(this.lw.t.str(d.name)), operandTy(ops.items[i]), sp);
            this.locals.put(l.locals.items[i].i, id.i);
            this.b.assign(sp, this.b.localPlace(id, sp), Rvalue.useOp(sp, ops.items[i]));
        }
        return this.rvalue(l.body);
    }
}
