// A sema global initializer (`sema.ConstInit`) as a plain tree `lower` can read without naming sema's
// `ConstInit` (it clashes with ir's, and stage 0 has no `use as`).
//
// Port of: (new in plan 11 B11; Rust `fold_global_init` built the IR `ConstInit` directly)
// J3: Its own module (not a `j3c.lower` part): the one place that names sema's `ConstInit`.
module j3c.lower.seminit;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3c.base.intern.Sym;
use j3c.sema.{ ConstInit, ConstVal };

pub enum InitKind { Scalar, Fields, Elems }

/// `Scalar`: `val`; `Fields`: `names[i]` = `kids[i]`; `Elems`: `kids`.
pub struct FlatInit {
    val: Option<ConstVal>;
    kind: InitKind;
    names: List<Sym>;
    kids: List<FlatInit>;
}

/// `init` as a `FlatInit` (arena lists).
pub fn flatten(arena: &Arena, init: ConstInit): FlatInit {
    let out = FlatInit { val: Option.None, kind: InitKind.Scalar, names: List<Sym>.new(arena), kids: List<FlatInit>.new(arena) };
    match init {
        ConstInit.Scalar(v) { out.val = Option.Some(v); }
        ConstInit.Fields(f) {
            out.kind = InitKind.Fields;
            for i in 0..f.vals.len {
                out.names.push(f.names.items[i]);
                out.kids.push(flatten(arena, f.vals.items[i]));
            }
        }
        ConstInit.Elems(e) {
            out.kind = InitKind.Elems;
            for i in 0..e.items.len { out.kids.push(flatten(arena, e.items.items[i])); }
        }
    }
    return out;
}
