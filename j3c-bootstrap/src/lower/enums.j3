// Enum values: variant constructors, payload places, variant tests, `?` on `#[TryCatch]` enums.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/enums.rs
// J3: Which variant a path or call names is sema's decision (B11.1); this only builds the value or place.
module j3c.lower;
// J3: Variant tests inside patterns are in `pat_test.j3`.

extend FnLower {
    /// Rust `construct_variant`: no payload, one value, or several in a `_tN` payload struct.
    fn enumVal(this: &FnLower, e: Id<TExpr>, variant: int, payload: &List<Id<TExpr>>): Rvalue {
        let sp = this.spanOf(e);
        let ty = this.tyOf(e);
        let ir = this.ir();
        let eid = Id<EnumDef> { i: 0 };
        match ir.tyKind(ty) { TyKind.Enum(en) { eid = en.id; } _ { panic("lower: variant of a non-enum"); } }
        let vid = VariantId { enumId: eid, index: u32(variant) };
        let vd = ir.enumDef(eid).variants.items[variant];
        let op: Option<Operand> = Option.None;
        match vd.payload {
            Option.Some(pty) {
                if vd.multi {
                    let ops = List<Operand>.new(this.cx.arena);
                    for k in 0..payload.len { ops.push(this.operand(payload.items[k])); }
                    op = Option.Some(Operand.Copy(this.spill("t", Rvalue.aggregate(sp, pty, ops), sp)));
                } else {
                    op = Option.Some(this.operand(payload.items[0]));
                }
            }
            Option.None {}
        }
        return Rvalue.enumNew(sp, ty, vid, op);
    }

    /// Rust `variant_field_place`: payload field `k` of variant `vid` (the payload itself when single).
    fn variantFieldPlace(this: &FnLower, place: Place, vid: VariantId, k: int, sp: Span): Place {
        let ir = this.ir();
        let vd = ir.enumDef(vid.enumId).variants.items[int(vid.index)];
        let pty = ir.common.void;
        match vd.payload { Option.Some(t) { pty = t; } Option.None { panic("lower: payload of a bare variant"); } }
        let payload = this.b.enumPayload(place, vid, pty, sp);
        if !vd.multi { return payload; }
        match ir.tyKind(pty) {
            TyKind.Struct(s) { return this.b.field(ir, payload, FieldId { structId: s.id, index: u32(k) }, sp); }
            _ { panic("lower: a multi-field payload is a struct"); }
        }
        return payload;
    }

    /// Rust `is_variant`: a C-like enum compares with `_evN`, a tagged one compares its tag.
    fn isVariant(this: &FnLower, place: Place, vid: VariantId, sp: Span): Operand {
        let ir = this.ir();
        if ir.enumDef(vid.enumId).isCLike() {
            let ev = this.spill("ev", Rvalue.enumNew(sp, place.ty, vid, Option.None), sp);
            return this.eqOps(sp, Operand.Copy(place), Operand.Copy(ev));
        }
        let tag = this.b.enumTag(ir, place, sp);
        return this.eqOps(sp, Operand.Copy(tag), opInt(sp, ir.common.i32, u64(vid.index)));
    }

    /// `TExpr.Question` `e` (Rust `question`): the success payload, else return the failure (as is when
    /// the fn returns the same enum, `retErr` -1; else its payload in the return enum's failure variant).
    fn patQuestion(this: &FnLower, e: Id<TExpr>, q: TQuestion): Rvalue {
        let sp = this.spanOf(e);
        let ir = this.ir();
        let op = this.operand(q.expr);
        let ok = this.patVariantId(operandTy(op), q.ok);
        let fail = this.patVariantId(operandTy(op), q.err);
        let scrut = this.materialize(op, sp);
        let rplace = this.tmpPlace("q", this.tyOf(e), sp);
        let saved = this.b.beginBlock();
        match ir.enumDef(ok.enumId).variants.items[q.ok].payload {
            Option.Some(pty) {
                let src = this.b.enumPayload(this.copyOf(scrut), ok, pty, sp);
                this.b.assign(sp, this.copyOf(rplace), Rvalue.useOp(sp, Operand.Copy(src)));
            }
            Option.None {}
        }
        let thenBlock = this.b.endBlock(saved);
        saved = this.b.beginBlock();
        let retOp = Operand.Copy(this.copyOf(scrut));
        if q.retErr >= 0 {
            let retFail = this.patVariantId(this.ret, q.retErr);
            let payload: Option<Operand> = Option.None;
            match ir.enumDef(fail.enumId).variants.items[q.err].payload {
                Option.Some(pty) { payload = Option.Some(Operand.Copy(this.b.enumPayload(this.copyOf(scrut), fail, pty, sp))); }
                Option.None {}
            }
            retOp = Operand.Copy(this.spill("t", Rvalue.enumNew(sp, this.ret, retFail, payload), sp));
        }
        this.b.returnOp(sp, Option.Some(retOp));
        let elseBlock = this.b.endBlock(saved);
        let cond = this.isVariant(this.copyOf(scrut), ok, sp);
        this.pushIf(sp, cond, thenBlock, Option.Some(elseBlock));
        return Rvalue.useOp(sp, Operand.Copy(rplace));
    }
}
