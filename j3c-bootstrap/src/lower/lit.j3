// Literals: numbers with contextual typing, strings, chars, struct/array/enum literals, field defaults.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/lit.rs
// J3: Numbers, chars and strings arrive typed (`expr.j3` turns them into constants). A struct literal's
// values are in declaration order with defaults filled (sema); Rust lowered them in the order written
// (sema's `TStructLit.written`), and a default (a field not written) is the constant itself, as Rust's
// `FieldDef.default`.
module j3c.lower;

extend FnLower {
    /// Rust `struct_lit_sid`.
    fn structLit(this: &FnLower, e: Id<TExpr>, lit: &TStructLit): Rvalue {
        let sp = this.spanOf(e);
        let ops = List<Operand>.new(this.cx.arena);
        for i in 0..lit.items.len { ops.push(this.int(sp, 0)); }
        for k in 0..lit.written.len {
            let i = lit.written.items[k];
            ops.items[i] = this.operand(lit.items.items[i]);
        }
        let done = List<bool>.new(this.cx.arena);
        for i in 0..lit.items.len { done.push(false); }
        for k in 0..lit.written.len { done.items[lit.written.items[k]] = true; }
        for i in 0..lit.items.len { if !done.items[i] { ops.items[i] = this.constOf(lit.items.items[i]); } }
        return Rvalue.aggregate(sp, this.tyOf(e), ops);
    }

    /// A constant node as its IR constant (a field default: no temporary, unlike an operand `true`).
    fn constOf(this: &FnLower, e: Id<TExpr>): Operand {
        let sp = this.spanOf(e);
        let ty = this.tyOf(e);
        match this.node(e) {
            TExpr.Bool(v) { return opBool(sp, ty, v); }
            TExpr.Str(s) { return opBytes(this.cx.arena, sp, ty, s as []u8); }
            TExpr.FnAddr(f) { return opFnAddr(sp, ty, this.calleeFn(f.callee)); }
            _ {}
        }
        return this.operand(e);
    }
}
