// `t.fmt(`..`)`: interpolation parts appended to a `Text` (no 512-byte limit).
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/interp.rs (text_fmt, the `Dest::Text` half of append_parts / flush_fill)
// J3: C2c hook (contracts-c2c.md, owner: frame strings / Text.fmt). Literals and strings are pushed whole
// with `Text.pushBytes`; each number or bool is printed into a `TEXT_SCRATCH` buffer first, then pushed.
module j3c.lower;

/// A `Text` destination prints only `bool`, ints and floats into its scratch: at most 20 bytes
/// (`-9223372036854775808`; `%g` floats stay under 16). The backends check against `INTERP_CAP`.
const TEXT_SCRATCH: u64 = 64;

extend FnLower {
    /// Rust `text_fmt`: `TExpr.TextFmt`. The value is `t` as `&Text`, like `add`.
    fn interpTextFmt(this: &FnLower, e: Id<TExpr>, f: &TTextFmt): Rvalue {
        let sp = this.spanOf(e);
        let a = this.cx.arena;
        let me = this.int(sp, 0);
        let taken = false;
        match this.node(f.this) {
            TExpr.AddrOf(r) {
                if this.lw.typed.origin(f.this) == Origin.AutoRef {
                    // Rust `auto_this` TakeRef: `_thisN = &recv`.
                    let recv = this.place(r.place, "recv");
                    me = Operand.Copy(this.spill("this", Rvalue.refPlace(sp, this.tyOf(f.this), recv), sp));
                    taken = true;
                }
            }
            _ {}
        }
        if !taken { me = Operand.Copy(this.materialize(this.operand(f.this), sp)); }
        let ops = List<InterpPart>.new(a);
        for i in 0..f.parts.len {
            match f.parts.items[i] {
                TInterpPart.Lit(s) { ops.push(InterpPart.Lit(InterpLit { bytes: s as []u8 })); }
                TInterpPart.Value(v) { ops.push(InterpPart.Value(this.operand(v.expr))); }
            }
        }
        let d = this.newFill(sp, TEXT_SCRATCH);
        d.me = me;
        d.push = this.lw.funcOf(f.push.i);
        d.text = true;
        this.appendParts(sp, &d, &ops);
        return Rvalue.useOp(sp, this.interpMe(&d));
    }

    /// `d.me` again (its own copy of the place).
    fn interpMe(this: &FnLower, d: &InterpDest): Operand {
        match d.me {
            Operand.Copy(p) { return Operand.Copy(this.copyOf(p)); }
            Operand.Const(_) {}
        }
        return d.me;
    }

    /// The `Dest::Text` half of Rust `flush_fill`: literals joined and pushed, each value pushed.
    fn interpFlushText(this: &FnLower, sp: Span, d: &InterpDest, pending: &List<InterpPart>) {
        let ir = this.ir();
        let a = this.cx.arena;
        let bytesTy = ir.tySlice(ir.common.u8);
        let lit = Text.new(a);
        for i in 0..pending.len {
            let op = this.int(sp, 0);
            match pending.items[i] {
                InterpPart.Lit(l) { lit.pushBytes(l.bytes); continue; }
                InterpPart.Value(v) {
                    if operandTy(v) == ir.common.string {
                        op = Operand.Copy(this.spill("t", Rvalue.cast(sp, bytesTy, v), sp));
                    } else {
                        this.b.assign(sp, this.copyOf(d.used), Rvalue.useOp(sp, this.int(sp, 0)));
                        let one = List<InterpPart>.new(a);
                        one.push(InterpPart.Value(v));
                        this.push(sp, StmtKind.InterpFill(InterpFillStmt { buf: this.copyOf(d.buf), used: this.copyOf(d.used), parts: one }));
                        op = Operand.Copy(this.spill("t", this.fillValue(sp, d, bytesTy), sp));
                    }
                }
            }
            if lit.len() > 0 {
                this.interpPush(sp, d, opBytes(a, sp, bytesTy, lit.bytes));
                lit = Text.new(a);
            }
            this.interpPush(sp, d, op);
        }
        if lit.len() > 0 { this.interpPush(sp, d, opBytes(a, sp, bytesTy, lit.bytes)); }
        pending.clear();
    }

    /// Rust `push_text`: `me.pushBytes(bytes)`.
    fn interpPush(this: &FnLower, sp: Span, d: &InterpDest, bytes: Operand) {
        let ir = this.ir();
        let args = List<Operand>.new(this.cx.arena);
        args.push(this.interpMe(d));
        args.push(bytes);
        this.b.expr(sp, Rvalue.call(sp, ir.common.void, opFnAddr(sp, ir.funcMut(d.push).ty, d.push), args));
    }
}
