// Calls: free fns, methods, UFCS fallback with receiver adjustment, extern fns, intrinsics.
//
// Part of module j3c.lower.
// Port of: j3c/src/check/lower/call.rs, check/lower/ufcs.rs
// J3: Sema has picked the fn and adjusted the receiver (`AddrOf(recv)` for `this: &T`, `Load(Deref(..))`
// the other way). An auto-ref (`Origin.AutoRef`) gets Rust's `_thisN` temporary instead of `_tN`. `panic(msg)`
// is already `panicAt(file, line, msg)`. A call of a generic instance is ordered by `inst_call.j3`.
module j3c.lower;

extend FnLower {
    /// Rust `call_id` / `call_fn_op`.
    fn call(this: &FnLower, e: Id<TExpr>, callee: Callee, args: &List<Id<TExpr>>): Rvalue {
        let sp = this.spanOf(e);
        let ret = this.tyOf(e);
        let ops = List<Operand>.new(this.cx.arena);
        match callee {
            Callee.Value(v) {
                match this.lw.t.ty(this.lw.typed.exprTy(v.expr)) { Ty.Closure(_) { return this.closureCall(e, v.expr, args); } _ {} }
                let func = this.operand(v.expr);
                for i in 0..args.len { ops.push(this.operand(args.items[i])); }
                return Rvalue.call(sp, ret, func, ops);
            }
            Callee.Dyn(d) { return this.dynCall(e, d, args); }
            Callee.Inst(ic) { if instHasOwnParams(this.lw, ic.inst) { return this.instCall(e, callee, ic.inst, args); } }
            _ {}
        }
        let id = this.calleeFn(callee);
        let fty = this.ir().funcMut(id).ty;
        let panicAt = this.isPanicAt(id);
        for i in 0..args.len {
            let a = args.items[i];
            if i == 0 && panicAt {
                match this.node(a) {
                    TExpr.Str(s) { ops.push(opBytes(this.cx.arena, this.spanOf(a), this.tyOf(a), s as []u8)); continue; }
                    _ {}
                }
            }
            if i == 0 {
                match this.node(a) {
                    TExpr.AddrOf(r) {
                        if this.lw.typed.origin(a) == Origin.AutoRef {
                            // Rust `auto_this` TakeRef: `_thisN = &recv`.
                            let recv = this.place(r.place, "recv");
                            ops.push(Operand.Copy(this.spill("this", Rvalue.refPlace(sp, this.tyOf(a), recv), sp)));
                            continue;
                        }
                    }
                    _ {}
                }
            }
            ops.push(this.operand(a));
        }
        return Rvalue.call(sp, ret, opFnAddr(sp, fty, id), ops);
    }

    /// `j3.sys.panicAt` (Rust `panic_at_for`'s target), whose file argument is a constant.
    fn isPanicAt(this: &FnLower, id: Id<Func>): bool {
        let ir = this.ir();
        let f = ir.funcMut(id);
        if ir.nameStr(f.name) != "panicAt" || f.moduleName.len != 2 { return false; }
        return ir.nameStr(f.moduleName.items[0]) == "j3" && ir.nameStr(f.moduleName.items[1]) == "sys";
    }
}
