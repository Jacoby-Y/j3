// `j3c doc`: the public stdlib surface from the same parser, plus guide pages and recipes.
//
// Port of: j3c/src/doc/mod.rs, (stdlib/mod.rs `docs_id`, `provenance`)
// J3: One module in parts (`doc/load`, `pages`, `render`, `search`): Rust's `doc/*` use `super::*` with cycles.
// J3: Verbatim pages (`doc/pages/*.md`) stay `@embed`ded from `j3c/src/doc/pages/` until C6; prose that is Rust
// code today (`lang`, `j3ui` pages) moves to `text/doc/`. The `docs` id hashes this binary's embedded stdlib and
// page text (Rust hashes its own `.rs` sources too, so the ids never match: `tests/diff.sh tool` masks it).
module j3c.doc;

use j3.memory.Arena;
use j3c.base.diag;

/// `j3c doc [...]`: Rust `doc::cmd`.
pub fn docCmd(rest: []string): int { return diag.notPortedCmd("doc"); } // STUB DOC

/// Rust `stdlib::docs_id`: 8 lower-case hex digits (FNV-1a 64 `>> 32`, printed with `pushHex`). → `cmd/info` (version --verbose)
pub fn docsId(arena: &Arena): string { return "00000000"; } // STUB DOC
