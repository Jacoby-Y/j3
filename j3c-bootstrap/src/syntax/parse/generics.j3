// Type params and args, bounds (`<T: Hash + Eq>`), `trait` declarations, fn names and parameter lists.
// `trait` and `where` are contextual words (an identifier followed by an identifier), so variables with
// those names still parse.
//
// Part of module j3c.syntax.parse.
// Port of: j3c/src/parse/parser/generics.rs, parse/parser/traits.rs
// J3: Rust's `(Ident, Vec<Ident>)` where-pairs are `WhereBound`. Uses come from `parse.j3`.
module j3c.syntax.parse;

extend Parser {
    /// `<T: A + B, U>`: names and bounds, same index (Rust `type_params`).
    fn typeParams(this: &Parser): Result<(List<Ident>, List<List<Ident>>), ParseError> {
        let typeParams = List<Ident>.new(this.ast.arena);
        let bounds = List<List<Ident>>.new(this.ast.arena);
        if !this.at(TokenKind.Lt) { return Result.Ok((typeParams, bounds)); }
        this.bump();
        while true {
            typeParams.push(this.ident()?);
            bounds.push(this.boundList()?);
            if this.at(TokenKind.Comma) {
                this.bump();
                if this.at(TokenKind.Gt) { break; }
                continue;
            }
            break;
        }
        this.expect(TokenKind.Gt, "expected `>` after type parameters")?;
        return Result.Ok((typeParams, bounds));
    }

    /// `<int, List<T>>`.
    fn typeArgs(this: &Parser): Result<List<Id<Type>>, ParseError> {
        this.expect(TokenKind.Lt, "expected `<`")?;
        let args = List<Id<Type>>.new(this.ast.arena);
        while true {
            args.push(this.ty()?);
            if this.at(TokenKind.Comma) {
                this.bump();
                if this.at(TokenKind.Gt) { break; }
                continue;
            }
            break;
        }
        this.expect(TokenKind.Gt, "expected `>` after type arguments")?;
        return Result.Ok(args);
    }

    /// A fn name, or `operator+` and friends (`OVERLOADABLE`).
    fn fnName(this: &Parser): Result<Ident, ParseError> {
        if !this.at(TokenKind.Operator) { return this.ident(); }
        let start = this.cur().span;
        this.bump();
        let op = "";
        match operatorSrc(this.cur().kind) {
            Option.Some(o) { if isIn(o, names(NameList.Overloadable)) { op = o; } }
            Option.None {}
        }
        if op.len == 0 {
            let t = Text.new(this.ast.arena);
            t.add("expected an overloadable operator after `operator`: ").add(joinNames(NameList.Overloadable, " ", this.ast.arena));
            return Result.Err(this.err(t.str()));
        }
        let end = this.bump().span;
        let t = Text.new(this.ast.arena);
        t.add("operator").add(op);
        return Result.Ok(Ident { name: this.ast.sym(t.str()), span: join(start, end) });
    }

    /// `(a: int, b: T)`.
    fn paramList(this: &Parser): Result<List<Param>, ParseError> {
        if this.at(TokenKind.Dot) {
            return Result.Err(this.err("methods are declared inside the struct body (`struct T { fn name(this: &T, ...) { ... } }`), not as `fn T.name(`; see `j3c doc lang`"));
        }
        this.expect(TokenKind.LParen, "expected `(` after fn name")?;
        let params = List<Param>.new(this.ast.arena);
        if !this.at(TokenKind.RParen) {
            while true {
                let pname = this.ident()?;
                this.expect(TokenKind.Colon, "expected `:` after parameter name")?;
                let pty = this.ty()?;
                params.push(Param { name: pname, ty: pty });
                if this.at(TokenKind.Comma) {
                    this.bump();
                    if this.at(TokenKind.RParen) { break; }
                    continue;
                }
                break;
            }
        }
        this.expect(TokenKind.RParen, "expected `)` after parameters")?;
        return Result.Ok(params);
    }

    /// At `trait Name` (contextual `ITEM_TRAIT`).
    fn atTraitItem(this: &Parser): bool {
        return this.at(TokenKind.Ident) && this.cur().text == ITEM_TRAIT && this.look(1).kind == TokenKind.Ident;
    }

    /// `where T: Eq + Hash, U: Ord` before a fn body, or nothing. `where` counts only when `name :`
    /// follows.
    fn whereClause(this: &Parser): Result<List<WhereBound>, ParseError> {
        let out = List<WhereBound>.new(this.ast.arena);
        let at = this.at(TokenKind.Ident) && this.cur().text == FN_WHERE && this.look(1).kind == TokenKind.Ident
            && this.look(2).kind == TokenKind.Colon;
        if !at { return Result.Ok(out); }
        this.bump();
        while true {
            let p = this.ident()?;
            for i in 0..out.len {
                if out.items[i].name.name == p.name {
                    let t = Text.new(this.ast.arena);
                    t.add("`").add(this.ast.str(p.name)).add("` is listed twice in `where`; join the bounds with `+`");
                    return Result.Err(this.errAt(p.span, t.str()));
                }
            }
            let b = this.boundList()?;
            out.push(WhereBound { name: p, bounds: b });
            if !this.at(TokenKind.Comma) { break; }
            this.bump();
        }
        return Result.Ok(out);
    }

    /// After a type parameter's name: `: A + B`, or nothing.
    fn boundList(this: &Parser): Result<List<Ident>, ParseError> {
        let out = List<Ident>.new(this.ast.arena);
        if !this.at(TokenKind.Colon) { return Result.Ok(out); }
        this.bump();
        while true {
            let b = this.ident()?;
            for i in 0..out.len {
                if out.items[i].name == b.name {
                    let t = Text.new(this.ast.arena);
                    t.add("bound `").add(this.ast.str(b.name)).add("` is listed twice");
                    return Result.Err(this.errAt(b.span, t.str()));
                }
            }
            out.push(b);
            if !this.at(TokenKind.Plus) { break; }
            this.bump();
        }
        return Result.Ok(out);
    }

    /// `trait Name: Supers { fn m(..): R; fn d(..) { default } }`.
    fn traitItem(this: &Parser, visPub: bool, doc: string): Result<TraitItem, ParseError> {
        let start = this.cur().span;
        this.bump();
        let name = this.ident()?;
        if this.at(TokenKind.Lt) { return Result.Err(this.err("traits take no type parameters")); }
        let supers = this.boundList()?;
        this.expect(TokenKind.LBrace, "expected `{` after trait name")?;
        let methods = List<TraitMethod>.new(this.ast.arena);
        while !this.at(TokenKind.RBrace) && !this.at(TokenKind.Eof) {
            this.takeDoc(); // ponytail: trait method docs are dropped (as in Rust); the trait's own doc is kept
            let mstart = this.cur().span;
            this.expect(TokenKind.Fn, "expected `fn` in a trait body")?;
            let mname = this.fnName()?;
            if this.at(TokenKind.Lt) { return Result.Err(this.err("trait methods take no type parameters")); }
            let params = this.paramList()?;
            let ret: Option<Id<Type>> = Option.None;
            if this.at(TokenKind.Colon) {
                this.bump();
                ret = Option.Some(this.ty()?);
            }
            let sigEnd = this.prevEnd(mstart);
            let body: Option<Block> = Option.None;
            if this.at(TokenKind.LBrace) {
                body = Option.Some(this.block()?);
            } else {
                this.expect(TokenKind.Semi, "expected `;` or a default body `{ .. }` after a trait method signature")?;
            }
            methods.push(TraitMethod { span: join(mstart, sigEnd), name: mname, params: params, ret: ret, body: body });
        }
        this.expect(TokenKind.RBrace, "expected `}` after trait")?;
        return Result.Ok(TraitItem { span: this.since(start), doc: doc, visPub: visPub, name: name, supers: supers, methods: methods });
    }
}
