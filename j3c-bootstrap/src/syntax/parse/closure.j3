// Closure literals `fn(a: int, b): T { .. }` and the `closure(A, B): T` type.
//
// Part of module j3c.syntax.parse.
// Port of: j3c/src/parse/parser/closure.rs
// J3: Uses come from `parse.j3`.
module j3c.syntax.parse;

extend Parser {
    /// `closure(A, B): R` after `closure` (`boxed` when `boxed closure`), at `(`; `start` is the first
    /// word's span.
    fn closureType(this: &Parser, start: Span, boxed: bool): Result<Id<Type>, ParseError> {
        if boxed && !this.at(TokenKind.LParen) { return Result.Err(this.err("expected `(` after `boxed closure`")); }
        this.expect(TokenKind.LParen, "expected `(` after `closure`")?;
        let params = List<Id<Type>>.new(this.ast.arena);
        while !this.at(TokenKind.RParen) {
            params.push(this.ty()?);
            if !this.eat(TokenKind.Comma) { break; }
        }
        this.expect(TokenKind.RParen, "expected `)` after closure type params")?;
        let ret: Option<Id<Type>> = Option.None;
        if this.eat(TokenKind.Colon) { ret = Option.Some(this.ty()?); }
        return Result.Ok(this.ast.addType(Type.Closure(ClosureType { params: params, ret: ret, boxed: boxed }), this.since(start)));
    }

    /// `fn[mem](a: int, b): T { body }`, at `fn` in expression position.
    fn closureLit(this: &Parser): Result<Id<Expr>, ParseError> {
        let start = this.cur().span;
        this.expect(TokenKind.Fn, "expected `fn`")?;
        let mem: Option<Id<Expr>> = Option.None;
        if this.eat(TokenKind.LBracket) {
            mem = Option.Some(this.expr()?);
            this.expect(TokenKind.RBracket, "expected `]` after the arena of `fn[mem](..)`")?;
        }
        if !this.at(TokenKind.LParen) {
            return Result.Err(this.err("expected `(` after `fn`: a closure is `fn(x: int): int { ... }`; named functions are declared at the top level"));
        }
        this.bump();
        let params = List<ClosureParam>.new(this.ast.arena);
        while !this.at(TokenKind.RParen) {
            let name = this.ident()?;
            let t: Option<Id<Type>> = Option.None;
            if this.eat(TokenKind.Colon) { t = Option.Some(this.ty()?); }
            params.push(ClosureParam { name: name, ty: t });
            if !this.eat(TokenKind.Comma) { break; }
        }
        this.expect(TokenKind.RParen, "expected `)` after closure parameters")?;
        let ret: Option<Id<Type>> = Option.None;
        if this.eat(TokenKind.Colon) { ret = Option.Some(this.ty()?); }
        let body = this.block()?;
        let lit = ClosureLit { arena: mem, params: params, ret: ret, body: body };
        return Result.Ok(this.ast.addExpr(Expr.Closure(lit), join(start, body.span)));
    }
}
