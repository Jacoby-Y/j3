// Type syntax: primitives, `&T`, `[N]T`, `[]T`, `Name<..>`, `fn(..): R`, `closure(..)`, `dyn Trait`,
// tuples `(A, B)`.
//
// Part of module j3c.syntax.parse.
// Port of: j3c/src/parse/parser/types.rs
// J3: Returns `Id<Type>` with Rust's `Type.span` in the side table. Uses come from `parse.j3`.
module j3c.syntax.parse;

extend Parser {
    /// A type.
    fn ty(this: &Parser): Result<Id<Type>, ParseError> {
        let start = this.cur().span;
        if this.at(TokenKind.Amp) {
            this.bump();
            let inner = this.ty()?;
            return Result.Ok(this.ast.addType(Type.Ref(RefType { ty: inner }), join(start, this.ast.typeSpan(inner))));
        }
        if this.at(TokenKind.LBracket) {
            this.bump();
            if this.at(TokenKind.RBracket) {
                this.bump();
                let elem = this.ty()?;
                return Result.Ok(this.ast.addType(Type.Slice(SliceType { elem: elem }), join(start, this.ast.typeSpan(elem))));
            }
            let ntok = this.cur();
            if ntok.kind != TokenKind.Int { return Result.Err(this.err("expected array length or `[]`")); }
            this.bump();
            let len: u64 = 0;
            match parseInt(ntok.text, this.ast.arena) {
                Result.Ok(v) {
                    match v {
                        Expr.Int(n) { len = u64(n); }
                        _ { return Result.Err(this.errAt(ntok.span, "array length is too large")); }
                    }
                }
                Result.Err(m) { return Result.Err(this.errAt(ntok.span, m)); }
            }
            this.expect(TokenKind.RBracket, "expected `]` after array length")?;
            let elem = this.ty()?;
            return Result.Ok(this.ast.addType(Type.Array(ArrayType { len: len, elem: elem }), join(start, this.ast.typeSpan(elem))));
        }
        if this.at(TokenKind.LParen) {
            this.bump();
            let elems = List<Id<Type>>.new(this.ast.arena);
            elems.push(this.ty()?);
            while this.at(TokenKind.Comma) && this.look(1).kind != TokenKind.RParen {
                this.bump();
                elems.push(this.ty()?);
            }
            if this.at(TokenKind.Comma) { this.bump(); }
            if elems.len < 2 { return Result.Err(this.errAt(start, "a tuple type has two or more elements")); }
            this.expect(TokenKind.RParen, "expected `,` or `)` in a tuple type")?;
            return Result.Ok(this.ast.addType(Type.Tuple(TupleType { elems: elems }), this.since(start)));
        }
        if this.at(TokenKind.Fn) {
            this.bump();
            this.expect(TokenKind.LParen, "expected `(` after `fn`")?;
            let params = List<Id<Type>>.new(this.ast.arena);
            if !this.at(TokenKind.RParen) {
                while true {
                    params.push(this.ty()?);
                    if this.at(TokenKind.Comma) {
                        this.bump();
                        if this.at(TokenKind.RParen) { break; }
                        continue;
                    }
                    break;
                }
            }
            this.expect(TokenKind.RParen, "expected `)` after fn type params")?;
            let ret: Option<Id<Type>> = Option.None;
            if this.at(TokenKind.Colon) {
                this.bump();
                ret = Option.Some(this.ty()?);
            }
            return Result.Ok(this.ast.addType(Type.Fn(FnType { params: params, ret: ret }), this.since(start)));
        }
        let name = this.ident()?;
        let n = this.ast.str(name.name);
        if n == "closure" && this.at(TokenKind.LParen) { return this.closureType(name.span, false); }
        if n == TYPE_BOXED && this.at(TokenKind.Ident) && this.cur().text == TYPE_CLOSURE {
            this.bump();
            return this.closureType(name.span, true);
        }
        if n == TYPE_DYN && this.at(TokenKind.Ident) {
            let tr = this.ident()?;
            let seen = false;
            for i in 0..this.dyns.len {
                if this.dyns.items[i] == tr.name { seen = true; }
            }
            if !seen { this.dyns.push(tr.name); }
            return Result.Ok(this.ast.addType(Type.Dyn(tr), join(start, tr.span)));
        }
        if this.at(TokenKind.Lt) {
            this.bump();
            let args = List<Id<Type>>.new(this.ast.arena);
            while true {
                args.push(this.ty()?);
                if this.at(TokenKind.Comma) {
                    this.bump();
                    if this.at(TokenKind.Gt) { break; }
                    continue;
                }
                break;
            }
            this.expect(TokenKind.Gt, "expected `>` after type arguments")?;
            return Result.Ok(this.ast.addType(Type.Generic(GenericType { name: name.name, args: args }), this.since(name.span)));
        }
        return Result.Ok(this.ast.addType(Type.Named(NamedType { name: name.name }), name.span));
    }
}
