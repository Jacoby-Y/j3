// Expression nodes: `Expr` and its kinds, closure literals, string interpolation parts, operators.
//
// Part of module j3c.syntax.ast.
// Port of: j3c/src/parse/expr.rs
// J3: Rust `Expr { span, kind }` is `Id<Expr>` into `Ast.exprs` (the kind) plus `Ast.exprSpans`. Rust
// struct variants are payload structs `<Variant>Expr` with Rust's field names (rule in `ast.j3`). `AtomicOp`/`AtomicOrder` live here,
// not in `ir` (Rust `ir/op.rs`), because the parser makes them and `ir` sits below `syntax`'s users.
module j3c.syntax.ast;

pub enum EmbedKind { Text, Bytes, Dir }

/// An expression; its span is `Ast.exprSpan(id)`.
pub enum Expr {
    Name(Ident),
    Int(i64),
    /// An int literal above `i64` max (`0xFFFFFFFFFFFFFFFF`): only a `u64` takes it.
    BigInt(u64),
    /// `let buf: [64]u8;`: the `let`'s type, zero-filled. Only a typed `let` makes it.
    Zeroed,
    /// `'a'` (u8 when ASCII, else a u32 code point; takes the other operand's int type).
    Char(u32),
    Float(f64),
    Bool(bool),
    /// The bytes of a string literal (escapes decoded), an arena copy.
    String(string),
    StructLit(StructLitExpr),
    TypePath(TypePathExpr),
    ArrayLit(ArrayLitExpr),
    /// `[]T { ptr: …, len: … }`
    SliceLit(SliceLitExpr),
    Index(IndexExpr),
    Slice(SliceExpr),
    Field(FieldExpr),
    Call(CallExpr),
    Syscall(SyscallExpr),
    /// `@atomicLoad(p)`, `@atomicStore(p, v)`, `@atomicAdd(p, v)`, `@atomicCas(p, old, new)`, each with an
    /// optional trailing order word (`acquire`); `order` is already validated for `op`.
    Atomic(AtomicExpr),
    /// The type of a project-local `.j3s` file (its path, an arena copy).
    ScriptType(string),
    /// `@embed("p")`, `@embedBytes("p")`, `@embedDir("dir", "glob")`: file contents at compile time; the
    /// loader reads them (`File.embeds`, keyed by this expression's span).
    Embed(EmbedExpr),
    /// `@script("path.j3s") { prop: value }`.
    ScriptLit(ScriptLitExpr),
    SizeOf(SizeOfExpr),
    /// Compiler UI lowering: test an int index or a candidate-set enum against one arm.
    UiChoice(UiChoiceExpr),
    SliceFrom(SliceFromExpr),
    Cast(CastExpr),
    Binary(BinaryExpr),
    Unary(UnaryExpr),
    Interpolate(InterpolateExpr),
    /// `(a, b)`: a tuple value (two or more elements).
    Tuple(TupleExpr),
    If(IfExpr),
    Question(QuestionExpr),
    /// `match x { A { 1 } B { 2 } }` (and `if let`) used as a value.
    Match(MatchStmt),
    /// `fn(a: int, b): T { body }`, a closure literal.
    Closure(ClosureLit),
}

pub struct StructLitExpr {
    name: Ident;
    typeArgs: List<Id<Type>>;
    fields: List<FieldInit>;
}

pub struct TypePathExpr {
    name: Ident;
    args: List<Id<Type>>;
}

pub struct ArrayLitExpr {
    elems: List<Id<Expr>>;
}

pub struct SliceLitExpr {
    elem: Id<Type>;
    fields: List<FieldInit>;
}

pub struct IndexExpr {
    base: Id<Expr>;
    index: Id<Expr>;
}

pub struct SliceExpr {
    base: Id<Expr>;
    start: Option<Id<Expr>>;
    end: Option<Id<Expr>>;
}

pub struct FieldExpr {
    base: Id<Expr>;
    field: Ident;
}

pub struct CallExpr {
    func: Id<Expr>;
    typeArgs: List<Id<Type>>;
    args: List<Id<Expr>>;
}

pub struct SyscallExpr {
    args: List<Id<Expr>>;
}

pub struct AtomicExpr {
    op: AtomicOp;
    order: AtomicOrder;
    args: List<Id<Expr>>;
}

/// Strings are arena copies.
pub struct EmbedExpr {
    kind: EmbedKind;
    path: string;
    glob: string;
}

pub struct ScriptLitExpr {
    path: string;
    fields: List<FieldInit>;
}

pub struct SizeOfExpr {
    ty: Id<Type>;
}

pub struct UiChoiceExpr {
    set: Id<Type>;
    value: Id<Expr>;
    index: Id<Expr>;
}

pub struct SliceFromExpr {
    ptr: Id<Expr>;
    len: Id<Expr>;
}

pub struct CastExpr {
    expr: Id<Expr>;
    ty: Id<Type>;
}

pub struct BinaryExpr {
    op: BinOp;
    lhs: Id<Expr>;
    rhs: Id<Expr>;
}

pub struct UnaryExpr {
    op: UnaryOp;
    expr: Id<Expr>;
}

pub struct InterpolateExpr {
    parts: List<InterpPart>;
}

pub struct TupleExpr {
    elems: List<Id<Expr>>;
}

pub struct IfExpr {
    cond: Id<Expr>;
    thenExpr: Id<Expr>;
    elseExpr: Id<Expr>;
}

pub struct QuestionExpr {
    expr: Id<Expr>;
}

/// `name: value` in a struct, slice or script literal (Rust `(Ident, Expr)`).
pub struct FieldInit {
    name: Ident;
    value: Id<Expr>;
}

pub struct ClosureLit {
    /// `fn[mem](..)`: the arena a boxed closure copies its captures into.
    arena: Option<Id<Expr>>;
    params: List<ClosureParam>;
    ret: Option<Id<Type>>;
    body: Block;
}

/// A closure parameter; the type may be left out when the expected type gives it.
pub struct ClosureParam {
    name: Ident;
    ty: Option<Id<Type>>;
}

pub enum InterpPart {
    /// Literal bytes, an arena copy.
    Lit(string),
    Expr(InterpHole),
}

/// `{expr}` inside an interpolated string.
pub struct InterpHole {
    expr: Id<Expr>;
}

pub enum BinOp { Add, Sub, Mul, Div, Rem, Shl, Shr, BitAnd, BitOr, BitXor, Eq, Ne, Lt, Le, Gt, Ge, And, Or }

pub enum UnaryOp { Neg, BitNot, Ref, Deref, Not }

/// `@atomic*` ops (Rust `ir::op::AtomicOp`).
pub enum AtomicOp { Load, Store, Add, Sub, Xchg, Cas }

/// Memory order of an atomic op. Default `SeqCst`.
pub enum AtomicOrder { Relaxed, Acquire, Release, AcqRel, SeqCst }

/// Name after the `@`.
pub fn atomicOpName(op: AtomicOp): string {
    match op {
        AtomicOp.Load { return "atomicLoad"; }
        AtomicOp.Store { return "atomicStore"; }
        AtomicOp.Add { return "atomicAdd"; }
        AtomicOp.Sub { return "atomicSub"; }
        AtomicOp.Xchg { return "atomicExchange"; }
        AtomicOp.Cas { return "atomicCas"; }
    }
}

/// The op named `s` (without `@`).
pub fn atomicOpFromName(s: string): Option<AtomicOp> {
    if s == "atomicLoad" { return Option.Some(AtomicOp.Load); }
    if s == "atomicStore" { return Option.Some(AtomicOp.Store); }
    if s == "atomicAdd" { return Option.Some(AtomicOp.Add); }
    if s == "atomicSub" { return Option.Some(AtomicOp.Sub); }
    if s == "atomicExchange" { return Option.Some(AtomicOp.Xchg); }
    if s == "atomicCas" { return Option.Some(AtomicOp.Cas); }
    return Option.None;
}

/// Operands after the pointer: this many values of the pointee type.
pub fn atomicOpValues(op: AtomicOp): int {
    match op {
        AtomicOp.Load { return 0; }
        AtomicOp.Store { return 1; }
        AtomicOp.Add { return 1; }
        AtomicOp.Sub { return 1; }
        AtomicOp.Xchg { return 1; }
        AtomicOp.Cas { return 2; }
    }
}

/// True when `op` accepts `o` (the C11 rule: a load cannot release, a store cannot acquire). Rust's
/// `orders()` list order is `Relaxed, Acquire, Release, AcqRel, SeqCst` minus the refused ones.
pub fn atomicOpAllows(op: AtomicOp, o: AtomicOrder): bool {
    match op {
        AtomicOp.Load { match o { AtomicOrder.Release { return false; } AtomicOrder.AcqRel { return false; } _ { return true; } } }
        AtomicOp.Store { match o { AtomicOrder.Acquire { return false; } AtomicOrder.AcqRel { return false; } _ { return true; } } }
        _ { return true; }
    }
}

/// The spelling in source.
pub fn atomicOrderName(o: AtomicOrder): string {
    match o {
        AtomicOrder.Relaxed { return "relaxed"; }
        AtomicOrder.Acquire { return "acquire"; }
        AtomicOrder.Release { return "release"; }
        AtomicOrder.AcqRel { return "acqrel"; }
        AtomicOrder.SeqCst { return "seqcst"; }
    }
}

/// The order spelled `s`.
pub fn atomicOrderFromName(s: string): Option<AtomicOrder> {
    if s == "relaxed" { return Option.Some(AtomicOrder.Relaxed); }
    if s == "acquire" { return Option.Some(AtomicOrder.Acquire); }
    if s == "release" { return Option.Some(AtomicOrder.Release); }
    if s == "acqrel" { return Option.Some(AtomicOrder.AcqRel); }
    if s == "seqcst" { return Option.Some(AtomicOrder.SeqCst); }
    return Option.None;
}

/// `-3` and `-0.5` as the literals they are (the parser keeps them as negation); a char literal as its
/// code point. Anything else is returned unchanged (Rust `Expr::folded_literal`; the span is `id`'s).
pub fn foldedLiteral(ast: &Ast, id: Id<Expr>): Expr {
    let e = ast.expr(id);
    match e {
        Expr.Char(v) { return Expr.Int(i64(v)); }
        Expr.Unary(u) {
            if u.op != UnaryOp.Neg { return e; }
            match ast.expr(u.expr) {
                Expr.Int(v) { return Expr.Int(-v); }
                Expr.Float(v) { return Expr.Float(-v); }
                _ { return e; }
            }
        }
        _ { return e; }
    }
}
