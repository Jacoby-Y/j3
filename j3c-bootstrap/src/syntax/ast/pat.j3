// `match` (statement and `Expr.Match`), destructuring `let` / `let .. else`, and their patterns;
// `if let` is a `match` with a `_` arm.
//
// Part of module j3c.syntax.ast.
// Port of: j3c/src/parse/pat.rs
// J3: `Pat` lives in `Ast.pats`; `Ast.patSpan(id)` is what Rust's `Pat::span()` computed (the parser
// sets it: a `Bind`'s ident span, `Wild`'s, a `Range`'s lo start to hi end).
module j3c.syntax.ast;

pub struct MatchStmt {
    span: Span;
    expr: Id<Expr>;
    arms: List<MatchArm>;
}

/// `A | B if guard { body }`: one or more alternatives, an optional guard, a body.
pub struct MatchArm {
    span: Span;
    /// The `|` alternatives, at least one.
    pats: List<Id<Pat>>;
    /// `if cond`: checked after the pattern's names are bound; when false, later arms are tried.
    guard: Option<Id<Expr>>;
    body: Block;
    /// The arm's value: an expression after the statements with no `;` (`Op.Add { 1 }`). In a statement
    /// `match` it runs as an expression statement.
    tail: Option<Id<Expr>>;
}

/// `let Span { lo, hi } = s;`: the pattern always matches (checked), and binds its names.
/// `let E.A(x) = e else { return; };`: a pattern that may not match, and an `else` that leaves.
// `elseBlock` first and `pad` so the size is a multiple of 8 (stage-0 ABI hazard (a), PORT_DEBT.md).
pub struct LetPatStmt {
    elseBlock: Option<Block>;
    span: Span;
    pat: Id<Pat>;
    value: Id<Expr>;
    pad: u32 = 0;
}

/// `name: pat` in a struct pattern (Rust `(Ident, Pat)`).
pub struct PatField {
    name: Ident;
    pat: Id<Pat>;
}

pub enum Pat {
    /// A name (only inside a payload or tuple: a top-level single name is a `Variant` path or a `const`).
    Bind(Ident),
    Wild,
    /// `Enum.Name(a, b)` (one sub-pattern per field, none without parens), or in an int match a `const`
    /// (`LIMIT`, `lex.T_EOF`).
    Variant(VariantPat),
    /// `Span { lo, hi: h, .. }`: `lo` is short for `lo: lo`; `rest` is the trailing `..`, without which every
    /// field is listed.
    Struct(StructPat),
    /// `(a, b)`: a tuple's elements; names inside bind, as in a payload.
    Tuple(TuplePat),
    /// An int or char literal: `3`, `-1`, `'a'`.
    Lit(LitPat),
    /// `lo..=hi`, both ends included; each end a literal or a `const`.
    Range(RangePat),
}

pub struct VariantPat {
    span: Span;
    path: List<Ident>;
    payload: List<Id<Pat>>;
}

pub struct StructPat {
    span: Span;
    path: List<Ident>;
    fields: List<PatField>;
    rest: bool;
}

pub struct TuplePat {
    span: Span;
    elems: List<Id<Pat>>;
}

pub struct LitPat {
    expr: Id<Expr>;
}

pub struct RangePat {
    lo: Id<Expr>;
    hi: Id<Expr>;
}

/// Matches every value of its type: `_`, a name, or a struct/tuple pattern of such patterns. A variant
/// pattern is refutable even on a one-variant enum.
pub fn irrefutable(ast: &Ast, p: Id<Pat>): bool {
    match ast.pat(p) {
        Pat.Bind(_) { return true; }
        Pat.Wild { return true; }
        Pat.Struct(sp) {
            for i in 0..sp.fields.len {
                if !irrefutable(ast, sp.fields.items[i].pat) { return false; }
            }
            return true;
        }
        Pat.Tuple(t) {
            for i in 0..t.elems.len {
                if !irrefutable(ast, t.elems.items[i]) { return false; }
            }
            return true;
        }
        Pat.Variant(_) { return false; }
        Pat.Lit(_) { return false; }
        Pat.Range(_) { return false; }
    }
}

/// `a.b.c` as a name/field expression (an int `const` named in a pattern), the outer node at `span`.
pub fn pathExpr(ast: &Ast, path: List<Ident>, span: Span): Id<Expr> {
    let n = path.len;
    if n == 1 { return ast.addExpr(Expr.Name(path.items[0]), span); }
    let e = ast.addExpr(Expr.Name(path.items[0]), path.items[0].span);
    for i in 1..n {
        let sp = path.items[i].span;
        if i == n - 1 { sp = span; }
        e = ast.addExpr(Expr.Field(FieldExpr { base: e, field: path.items[i] }), sp);
    }
    return e;
}
