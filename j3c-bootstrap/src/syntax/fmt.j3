// `j3c fmt`: pretty-print from the same lexer, comments kept.
//
// Port of: j3c/src/fmt.rs
// J3: Token-driven: it lexes and never parses, so it matches no AST. Token kind sets are `==` chains
// (no `match` with a `_` arm). Output must match the Rust `fmt` byte for byte (`tests/diff.sh fmt`).
// J3: Rust's recursive `emit_gap` is a loop that scans each comment's text once (Rust rescans the rest of
// the gap per comment). The `inline_braces` HashSet is a bool per token.
module j3c.syntax.fmt;

use j3.data.pool.Id;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text;
use j3.text.Text;
use j3c.base.span.Source;
use j3c.syntax.lex;
use j3c.syntax.lex.{ trimEnd, trimStart };
use j3c.syntax.token.{ Token, TokenKind };

/// `src` formatted, in `arena`; Err is the lex error's message (Rust `format_src`).
pub fn format(src: string, arena: &Arena): Result<string, string> {
    match lex.lex(src, Id<Source> { i: 1 }, arena) {
        Result.Ok(toks) { return Result.Ok(reprint(src, toks, arena)); }
        Result.Err(e) { return Result.Err(e.msg); }
    }
}

/// The output being built and where its cursor stands.
struct Out {
    t: Text;
    indent: int;
    atLine: bool;

    fn ends(this: &Out, s: string): bool { return text.endsWith(this.t.str(), s); }

    fn nl(this: &Out) { this.t.push('\n'); this.atLine = true; }

    fn pushIndent(this: &Out) { for _ in 0..this.indent { this.t.add("    "); } }

    /// The whitespace and comments between two tokens (Rust `emit_gap`).
    fn gap(this: &Out, g: string) {
        let gap = g;
        while gap.len > 0 {
            let idx = text.find(gap, "//");
            if idx < 0 {
                let nls = count(gap, '\n');
                if nls >= 2 && this.t.len() > 0 {
                    if !this.ends("\n") { this.t.push('\n'); }
                    if !this.ends("\n\n") { this.t.push('\n'); }
                    this.atLine = true;
                } else if nls > 0 && !this.atLine {
                    this.nl();
                }
                return;
            }
            // only the newlines before this comment decide a blank line above it; the rest loops
            let before = count(gap[0..idx], '\n');
            let after = gap[idx..gap.len];
            let more = text.find(after, "\n");
            let line = after;
            if more >= 0 { line = after[0..more]; }
            let comment = trimEnd(line);
            if before == 0 && !this.atLine {
                this.t.push(' ');
                this.t.add(comment);
                if more >= 0 { this.nl(); }
            } else {
                if before >= 2 && !this.ends("\n\n") {
                    if !this.ends("\n") { this.t.push('\n'); }
                    this.t.push('\n');
                } else if !this.atLine {
                    this.t.push('\n');
                }
                this.pushIndent();
                this.t.add(comment);
                this.nl();
            }
            if more < 0 { return; }
            gap = after[more + 1..after.len];
        }
    }
}

fn count(s: string, b: u8): int {
    let n = 0;
    for i in 0..s.len { if s[i] == b { n += 1; } }
    return n;
}

fn reprint(src: string, toks: List<Token>, arena: &Arena): string {
    let o = Out { t: Text.new(arena), indent: 0, atLine: true };
    let hasPrev = false;
    let prev = TokenKind.Eof;
    let prevPrefix = false; // prev is `& - * ! ~` in prefix position
    let prevEnd = 0;
    let flatAt = inlineBraces(toks, arena);
    for i in 0..toks.len {
        let tok = toks.items[i];
        let flat = flatAt[i];
        if tok.kind == TokenKind.Eof { break; }
        let start = int(tok.span.lo);
        if start >= prevEnd { o.gap(src[prevEnd..start]); }

        if tok.kind == TokenKind.Doc && !o.atLine { o.nl(); }

        if tok.kind == TokenKind.RBrace && flat {
            o.t.push(' ');
        } else if tok.kind == TokenKind.RBrace {
            if o.indent > 0 { o.indent -= 1; }
            if !o.atLine { o.nl(); }
        }

        if o.atLine {
            o.pushIndent();
            o.atLine = false;
        } else if (hasPrev && isAngle(prev)) || isAngle(tok.kind) {
            // `<` `>` touching a neighbour carry meaning (`a << b`, `List<T>.new`, `Map<K, List<V>>`):
            // keep the source's spacing around them.
            if start != prevEnd { o.t.push(' '); }
        } else if hasPrev && needsSpace(prev, tok.kind, prevPrefix) {
            o.t.push(' ');
        }

        o.t.add(src[start..int(tok.span.hi)]);

        if !flat {
            let k = tok.kind;
            if k == TokenKind.Doc {
                o.nl();
            } else if k == TokenKind.LBrace {
                o.indent += 1;
                if !nextIs(toks, i, TokenKind.RBrace) { o.nl(); }
            } else if k == TokenKind.Semi {
                if !nextIs(toks, i, TokenKind.RBrace) && !trailingComment(src, tok) { o.nl(); }
            } else if k == TokenKind.RBrace {
                if !nextIs(toks, i, TokenKind.Eof) && !nextIs(toks, i, TokenKind.Else)
                    && !nextIs(toks, i, TokenKind.Semi) && !trailingComment(src, tok) {
                    o.nl();
                }
            }
        }

        let k = tok.kind;
        if k == TokenKind.Not || k == TokenKind.Tilde { prevPrefix = true; }
        else if k == TokenKind.Amp || k == TokenKind.Minus || k == TokenKind.Star { prevPrefix = !(hasPrev && endsOperand(prev)); }
        else { prevPrefix = false; }
        hasPrev = true;
        prev = k;
        prevEnd = int(tok.span.hi);
    }
    if prevEnd < src.len { o.gap(src[prevEnd..src.len]); }
    if !o.ends("\n") { o.t.push('\n'); }
    return o.t.str();
}

/// `S { a, b: c, .. }` written on one line: a `{` after a name holding only names, literals, `,` `:`
/// `..`, whose `}` is followed by what follows a pattern (`)` `=` `{` `|` `,` `if`). True at both braces.
fn inlineBraces(toks: List<Token>, arena: &Arena): []bool {
    let out = arena.alloc::<bool>(toks.len);
    for i in 0..toks.len { out[i] = false; }
    for i in 1..toks.len {
        if toks.items[i].kind != TokenKind.LBrace || toks.items[i - 1].kind != TokenKind.Ident { continue; }
        let close = i + 1;
        while close < toks.len && inPattern(toks.items[close].kind) { close += 1; }
        if close >= toks.len || toks.items[close].kind != TokenKind.RBrace || close + 1 >= toks.len { continue; }
        let n = toks.items[close + 1].kind;
        if n == TokenKind.RParen || n == TokenKind.Eq || n == TokenKind.LBrace || n == TokenKind.Pipe
            || n == TokenKind.Comma || n == TokenKind.If {
            out[i] = true;
            out[close] = true;
        }
    }
    return out;
}

fn inPattern(k: TokenKind): bool {
    return k == TokenKind.Ident || k == TokenKind.Comma || k == TokenKind.Colon || k == TokenKind.DotDot
        || k == TokenKind.Int || k == TokenKind.Char;
}

/// The first non-`Eof` token starting after token `at` is `want` (Rust `next_is`; never true for `Eof`).
fn nextIs(toks: List<Token>, at: int, want: TokenKind): bool {
    let lo = toks.items[at].span.lo;
    let j = at + 1;
    while j < toks.len && toks.items[j].span.lo <= lo { j += 1; }
    while j < toks.len && toks.items[j].kind == TokenKind.Eof { j += 1; }
    return j < toks.len && toks.items[j].kind == want;
}

/// A `//` comment follows `tok` on its line with nothing between.
fn trailingComment(src: string, tok: Token): bool {
    let i = int(tok.span.hi);
    let e = i;
    while e < src.len && src[e] != '\n' { e += 1; }
    return text.startsWith(trimStart(src[i..e]), "//");
}

/// `< > <= >=`: the lexer keeps `<<`, `>>` and generic brackets as these, so touching matters.
fn isAngle(k: TokenKind): bool {
    return k == TokenKind.Lt || k == TokenKind.Gt || k == TokenKind.Le || k == TokenKind.Ge;
}

/// Token that can end an operand, so a following `& - *` is binary.
fn endsOperand(k: TokenKind): bool {
    return k == TokenKind.Ident || k == TokenKind.Int || k == TokenKind.Float || k == TokenKind.String
        || k == TokenKind.Interpolate || k == TokenKind.RParen || k == TokenKind.RBracket || k == TokenKind.This;
}

fn needsSpace(p: TokenKind, next: TokenKind, prevPrefix: bool): bool {
    // `xs[0]` / `f()[0]` index tight; `= [..]`, `, [..]`, `: []u8` keep the space
    if next == TokenKind.LBracket {
        // `fn[mem](..)`: a boxed closure's arena sits tight on `fn`
        return !(endsOperand(p) || prevPrefix || p == TokenKind.Hash || p == TokenKind.Fn);
    }
    // `[]u8`, `[4]i32`: a type's element name follows its `]` directly
    if p == TokenKind.RBracket && next == TokenKind.Ident { return false; }
    // `{ a, .. }` in a struct pattern
    if next == TokenKind.DotDot && (p == TokenKind.Comma || p == TokenKind.LBrace) { return true; }
    // `f(x)`, `fn(int)`, `-(a)` tight; `return (a, b)`, `x: (int, int)`, `let (a, b)`, `= (..)` spaced
    if next == TokenKind.LParen {
        return !(endsOperand(p) || prevPrefix || p == TokenKind.Fn || p == TokenKind.LParen || p == TokenKind.LBracket
            || p == TokenKind.Dot || p == TokenKind.ColonColon || p == TokenKind.Hash || p == TokenKind.At
            || p == TokenKind.Not || p == TokenKind.Tilde || p == TokenKind.Lt || p == TokenKind.Gt);
    }
    if next == TokenKind.Doc || next == TokenKind.Comma || next == TokenKind.Semi || next == TokenKind.RParen
        || next == TokenKind.RBracket || next == TokenKind.RBrace || next == TokenKind.Colon || next == TokenKind.Dot
        || next == TokenKind.DotDot || next == TokenKind.DotDotEq || next == TokenKind.ColonColon
        || next == TokenKind.Question {
        return false;
    }
    if p == TokenKind.Dot || p == TokenKind.DotDot || p == TokenKind.DotDotEq || p == TokenKind.ColonColon
        || p == TokenKind.LParen || p == TokenKind.LBracket || p == TokenKind.Hash || p == TokenKind.At
        || p == TokenKind.Not || p == TokenKind.Tilde {
        return false;
    }
    if (p == TokenKind.Amp || p == TokenKind.Minus || p == TokenKind.Star) && prevPrefix { return false; }
    if p == TokenKind.LBrace && next == TokenKind.RBrace { return false; }
    return true;
}
