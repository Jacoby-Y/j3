// Fold `extend T { .. }` blocks into `T`'s struct once all of a module's files are parsed.
//
// Port of: j3c/src/parse/extend.rs, check/extend.rs
// J3: Rust did this in two places (parse and check); one pass here. `merge` (parse/extend.rs) is ported;
// the per-module driver with the `elsewhere` lookup (check/extend.rs `merge_extends`) comes with sema (C2).
module j3c.syntax.extend;

use j3.memory.List;
use j3.option.Option;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.base.span.Span;
use j3c.syntax.ast.{ Ast, ExtendItem, Ident, Item };

/// Why a merge failed: message plus a `help:` line ("" = none). Strings are arena copies.
pub struct ExtendErr {
    span: Span;
    message: string;
    help: string;
}

/// `name` or `name<A, B>`, in the AST's arena.
fn withParams(ast: &Ast, name: string, ps: &List<Ident>): string {
    let t = Text.new(ast.arena);
    t.add(name);
    if ps.len > 0 {
        t.add("<");
        for i in 0..ps.len {
            if i > 0 { t.add(", "); }
            t.add(ast.str(ps.items[i].name));
        }
        t.add(">");
    }
    return t.str();
}

fn sameParams(a: &List<Ident>, b: &List<Ident>): bool {
    if a.len != b.len { return false; }
    for i in 0..a.len {
        if !(a.items[i].name == b.items[i].name) { return false; }
    }
    return true;
}

/// The error for `extend name` with no struct `name` in `items`.
fn noStruct(ast: &Ast, items: &List<Item>, e: &ExtendItem, moduleName: string, elsewhere: closure(Sym): Option<string>): ExtendErr {
    let name = ast.str(e.name.name);
    let at = e.name.span;
    for i in 0..items.len {
        match items.items[i] {
            Item.Enum(d) {
                if d.name.name == e.name.name {
                    return ExtendErr { span: at,
                        message: Text.new(ast.arena).add("cannot `extend` the enum `").add(name).add("`; only structs take methods").str(),
                        help: Text.new(ast.arena).add("write a free fn `fn m(this: ").add(name).add(")`; it calls as `x.m()`").str() };
                }
            }
            _ {}
        }
    }
    match elsewhere(e.name.name) {
        Option.Some(m) {
            return ExtendErr { span: at,
                message: Text.new(ast.arena).add("`").add(name).add("` is declared in module ").add(m).add(", not in ").add(moduleName).str(),
                help: Text.new(ast.arena).add("methods of `").add(name).add("` go in module ").add(m).add(": its file or a part file").str() };
        }
        Option.None {}
    }
    return ExtendErr { span: at,
        message: Text.new(ast.arena).add("`extend ").add(name).add("`: no struct `").add(name).add("` in module ").add(moduleName).str(),
        help: Text.new(ast.arena).add("declare `struct ").add(name).add("` in module ").add(moduleName).add(" (its file or a part file), or fix the name").str() };
}

/// Move every `Item.Extend` in `items` into its struct's methods. `moduleName`: the module being merged (for
/// messages). `elsewhere(name)`: the module that declares `name` when it is not this one. None = ok
/// (Rust `merge`). On an error `items` has lost its `extend` blocks and kept the methods merged so far, as
/// in Rust.
pub fn merge(ast: &Ast, items: &List<Item>, moduleName: string, elsewhere: closure(Sym): Option<string>): Option<ExtendErr> {
    let blocks = List<ExtendItem>.new(ast.arena);
    let kept = List<Item>.new(ast.arena);
    for i in 0..items.len {
        match items.items[i] {
            Item.Extend(e) { blocks.push(e); }
            _ { kept.push(items.items[i]); }
        }
    }
    if blocks.len == 0 { return Option.None; }
    items.clear();
    for i in 0..kept.len { items.push(kept.items[i]); }
    for b in 0..blocks.len {
        let e = blocks.items[b];
        let at = -1;
        for i in 0..items.len {
            match items.items[i] {
                Item.Struct(s) { if at < 0 && s.name.name == e.name.name { at = i; } }
                _ {}
            }
        }
        if at < 0 { return Option.Some(noStruct(ast, items, &e, moduleName, elsewhere)); }
        match items.items[at] {
            Item.Struct(s) {
                if !sameParams(&s.typeParams, &e.typeParams) {
                    let name = ast.str(e.name.name);
                    let want = withParams(ast, name, &s.typeParams);
                    return Option.Some(ExtendErr { span: e.name.span,
                        message: Text.new(ast.arena).add("`extend ").add(withParams(ast, name, &e.typeParams)).add("` does not match `struct ").add(want).add("`").str(),
                        help: Text.new(ast.arena).add("write `extend ").add(want).add("`; the parameters are named as in the struct").str() });
                }
                for k in 0..e.methods.len {
                    let m = e.methods.items[k];
                    for o in 0..s.methods.len {
                        if s.methods.items[o].name.name == m.name.name {
                            items.items[at] = Item.Struct(s);
                            return Option.Some(ExtendErr { span: m.name.span,
                                message: Text.new(ast.arena).add("`").add(ast.str(e.name.name)).add("` already has a method `").add(ast.str(m.name.name)).add("`").str(),
                                help: "a method is written once, in the struct body or in one `extend` block; rename one" });
                        }
                    }
                    s.methods.push(m);
                }
                items.items[at] = Item.Struct(s);
            }
            _ {}
        }
    }
    return Option.None;
}
