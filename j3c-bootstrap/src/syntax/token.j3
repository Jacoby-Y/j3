// Token kinds and the overloadable-operator table shared by the parser's errors and the highlighter; the
// names the parser knows (attributes, intrinsics, contextual words, `@j3ui` widgets); `ParseError`.
//
// Port of: j3c/src/parse/token.rs, parse/error.rs (`ParseError`), parse/syntax.rs (the name lists the parser reads)
// J3: A plain enum; char literals are a token kind.
// J3: Keyword kinds match `text/syntax/keywords.txt` (B10); the lexer and textmate read that one list.
// J3: Rust `highlight_scope` is the SCOPE column of `keywords.txt` (`scopeOf`) and `BUILTIN_TYPES` its `type`
// lines (`wordsOf("type")`); `operatorClass` and the textmate/doc/LSP lists (`ATTRIBUTES`, `INTRINSICS`,
// `ATOMIC_ORDERS`) sit with the parser's, reached through `names(NameList.X)`.
// J3: `ParseError` lives here, not in `parse`, because `lex` raises it too and sits below `parse`.
module j3c.syntax.token;

use j3.memory.Arena;
use j3.option.Option;
use j3.text;
use j3.text.Text;
use j3c.base.intern.own;
use j3c.base.span.Span;

/// The keyword list (format in its header). Relative to this file: unit-test packages have their own root.
const KEYWORDS_TXT = @embed("../../text/syntax/keywords.txt");

/// Every token kind, in Rust's order.
pub enum TokenKind {
    Eof,
    Ident,
    /// `'outer`, a loop label; `text` keeps the quote.
    Label,
    /// `'a'`, `'\n'`, `'\u{1F600}'`; `text` is the code point in decimal.
    Char,
    Int,
    Float,
    String,
    Module,
    Use,
    Lib,
    As,
    Pub,
    Fn,
    Struct,
    Enum,
    Const,
    Let,
    If,
    Else,
    While,
    For,
    In,
    Match,
    Return,
    Break,
    Continue,
    Defer,
    Operator,
    This,
    LParen,
    RParen,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Comma,
    Semi,
    Colon,
    ColonColon,
    Dot,
    DotDot,
    DotDotEq,
    At,
    Hash,
    Question,
    Amp,
    Eq,
    EqEq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    AndAnd,
    OrOr,
    Not,
    Plus,
    PlusEq,
    Minus,
    MinusEq,
    Star,
    StarEq,
    Slash,
    SlashEq,
    Percent,
    PercentEq,
    Pipe,
    PipeEq,
    Caret,
    CaretEq,
    Tilde,
    AmpEq,
    /// `<<=` and `>>=`. A lone `<<` / `>>` stays two `Lt` / `Gt` (generics close with `>>`).
    ShlEq,
    ShrEq,
    Interpolate,
    /// `///` line. `text` is the body, without the slashes or one leading space.
    Doc,
}

/// One token. `text` is a slice of the source text or an arena copy (AGENTS.md rule 1), never a frame string.
pub struct Token {
    kind: TokenKind;
    span: Span;
    text: string;
}

/// The end-of-input token at `span`.
pub fn eof(span: Span): Token { return Token { kind: TokenKind.Eof, span: span, text: "" }; }

/// A lex or parse error: one message at one span (Rust stops at the first). `msg` is an arena copy.
/// The command or loader turns it into a `Diag` (`parse.report`).
pub struct ParseError {
    span: Span;
    msg: string;
}

/// A `ParseError` with `msg` copied into `arena` (callers pass frame strings from interpolation).
pub fn parseError(arena: &Arena, span: Span, msg: string): ParseError {
    return ParseError { span: span, msg: own(arena, msg) };
}

/// Operators a user `fn operator<op>` can overload. Parser error text and the highlighter share it.
const OVERLOADABLE: [10]string = ["+", "-", "*", "/", "==", "!=", "<", "<=", ">", ">="];

/// The keyword token of `name`, `None` for an identifier (`true`/`false` are identifiers: class
/// `literal` in `keywords.txt`).
// J3 (plan 07): `kindOf` is exactly the `keyword` class of `keywords.txt` (unit test `syntax_ast` checks
// both ways), so no file scan per identifier.
pub fn keyword(name: string): Option<TokenKind> { return kindOf(name); }

/// The SCOPE column of `word` in `keywords.txt` (a keyword's TextMate scope, Rust `highlight_scope`), ""
/// when it has none.
pub fn scopeOf(word: string): string { return column(lineOf(word), 2); }

/// The `keywords.txt` line whose WORD is `word`, "" when none.
fn lineOf(word: string): string {
    let s = KEYWORDS_TXT;
    let i = 0;
    while i < s.len {
        let e = i;
        while e < s.len && s[e] != '\n' { e += 1; }
        let line = s[i..e];
        i = e + 1;
        if line.len == 0 || line[0] == '#' { continue; }
        if column(line, 0) == word { return line; }
    }
    return "";
}

/// Column `n` (0-based, split on single spaces) of `line`, trimmed; "" past the end.
fn column(line: string, n: int): string {
    let i = 0;
    let k = 0;
    while i <= line.len {
        let e = i;
        while e < line.len && line[e] != ' ' { e += 1; }
        if k == n { return text.trim(line[i..e]); }
        k += 1;
        i = e + 1;
    }
    return "";
}

/// The token kind a keyword word lexes to. Every `keyword` line of `keywords.txt` has one (unit test
/// `syntax_ast`).
pub fn kindOf(word: string): Option<TokenKind> {
    // ponytail: length and first-byte filter; most identifiers fail here
    if word.len < 2 || word.len > 8 { return Option.None; }
    let c = word[0];
    if c < 'a' || c > 'w' || c == 'g' || c == 'h' || c == 'j' || c == 'k' || c == 'n' || c == 'q' || c == 'v' { return Option.None; }
    if word == "module" { return Option.Some(TokenKind.Module); }
    if word == "use" { return Option.Some(TokenKind.Use); }
    if word == "lib" { return Option.Some(TokenKind.Lib); }
    if word == "as" { return Option.Some(TokenKind.As); }
    if word == "pub" { return Option.Some(TokenKind.Pub); }
    if word == "fn" { return Option.Some(TokenKind.Fn); }
    if word == "struct" { return Option.Some(TokenKind.Struct); }
    if word == "enum" { return Option.Some(TokenKind.Enum); }
    if word == "const" { return Option.Some(TokenKind.Const); }
    if word == "let" { return Option.Some(TokenKind.Let); }
    if word == "if" { return Option.Some(TokenKind.If); }
    if word == "else" { return Option.Some(TokenKind.Else); }
    if word == "while" { return Option.Some(TokenKind.While); }
    if word == "for" { return Option.Some(TokenKind.For); }
    if word == "in" { return Option.Some(TokenKind.In); }
    if word == "match" { return Option.Some(TokenKind.Match); }
    if word == "return" { return Option.Some(TokenKind.Return); }
    if word == "break" { return Option.Some(TokenKind.Break); }
    if word == "continue" { return Option.Some(TokenKind.Continue); }
    if word == "defer" { return Option.Some(TokenKind.Defer); }
    if word == "operator" { return Option.Some(TokenKind.Operator); }
    if word == "this" { return Option.Some(TokenKind.This); }
    return Option.None;
}

/// Every `keyword`-class word of `keywords.txt`, in file order, allocated in `arena` (textmate, docs).
pub fn keywordNames(arena: &Arena): []string { return wordsOf("keyword", arena); }

/// Every word of `keywords.txt` whose CLASS is `class` (`keyword`, `literal`, `type`), in file order, in
/// `arena`. `wordsOf("literal")` is Rust `BOOL_LITS`, `wordsOf("type")` is `BUILTIN_TYPES`.
pub fn wordsOf(class: string, arena: &Arena): []string {
    let n = 0;
    let s = KEYWORDS_TXT;
    for pass in 0..2 {
        let out = arena.alloc::<string>(n);
        let k = 0;
        let i = 0;
        while i < s.len {
            let e = i;
            while e < s.len && s[e] != '\n' { e += 1; }
            let line = s[i..e];
            i = e + 1;
            if line.len == 0 || line[0] == '#' || column(line, 1) != class { continue; }
            if pass == 1 { out[k] = column(line, 0); }
            k += 1;
        }
        if pass == 1 { return out; }
        n = k;
    }
    return arena.alloc::<string>(0);
}

/// Source spelling of an operator kind (`+=`, `..=`), `None` for the rest.
pub fn operatorSrc(k: TokenKind): Option<string> {
    match k {
        TokenKind.ColonColon { return Option.Some("::"); }
        TokenKind.Dot { return Option.Some("."); }
        TokenKind.DotDot { return Option.Some(".."); }
        TokenKind.DotDotEq { return Option.Some("..="); }
        TokenKind.Question { return Option.Some("?"); }
        TokenKind.Amp { return Option.Some("&"); }
        TokenKind.AmpEq { return Option.Some("&="); }
        TokenKind.Pipe { return Option.Some("|"); }
        TokenKind.PipeEq { return Option.Some("|="); }
        TokenKind.Caret { return Option.Some("^"); }
        TokenKind.CaretEq { return Option.Some("^="); }
        TokenKind.ShlEq { return Option.Some("<<="); }
        TokenKind.ShrEq { return Option.Some(">>="); }
        TokenKind.Tilde { return Option.Some("~"); }
        TokenKind.Eq { return Option.Some("="); }
        TokenKind.EqEq { return Option.Some("=="); }
        TokenKind.Ne { return Option.Some("!="); }
        TokenKind.Lt { return Option.Some("<"); }
        TokenKind.Le { return Option.Some("<="); }
        TokenKind.Gt { return Option.Some(">"); }
        TokenKind.Ge { return Option.Some(">="); }
        TokenKind.AndAnd { return Option.Some("&&"); }
        TokenKind.OrOr { return Option.Some("||"); }
        TokenKind.Not { return Option.Some("!"); }
        TokenKind.Plus { return Option.Some("+"); }
        TokenKind.PlusEq { return Option.Some("+="); }
        TokenKind.Minus { return Option.Some("-"); }
        TokenKind.MinusEq { return Option.Some("-="); }
        TokenKind.Star { return Option.Some("*"); }
        TokenKind.StarEq { return Option.Some("*="); }
        TokenKind.Slash { return Option.Some("/"); }
        TokenKind.SlashEq { return Option.Some("/="); }
        TokenKind.Percent { return Option.Some("%"); }
        TokenKind.PercentEq { return Option.Some("%="); }
        _ { return Option.None; }
    }
}

/// The TextMate scope of an operator kind (Rust `operator_class`), `None` for the rest.
pub fn operatorClass(k: TokenKind): Option<string> {
    match k {
        TokenKind.Eq | TokenKind.PlusEq | TokenKind.MinusEq | TokenKind.StarEq | TokenKind.SlashEq | TokenKind.PercentEq |
        TokenKind.AmpEq | TokenKind.PipeEq | TokenKind.CaretEq { return Option.Some("keyword.operator.assignment.j3"); }
        // own scope (a sub-scope of assignment) so the grammar tries it before `<` / `<=`
        TokenKind.ShlEq | TokenKind.ShrEq { return Option.Some("keyword.operator.assignment.shift.j3"); }
        TokenKind.EqEq | TokenKind.Ne | TokenKind.Lt | TokenKind.Le | TokenKind.Gt | TokenKind.Ge { return Option.Some("keyword.operator.comparison.j3"); }
        TokenKind.AndAnd | TokenKind.OrOr | TokenKind.Not { return Option.Some("keyword.operator.logical.j3"); }
        TokenKind.Plus | TokenKind.Minus | TokenKind.Star | TokenKind.Slash | TokenKind.Percent { return Option.Some("keyword.operator.arithmetic.j3"); }
        TokenKind.ColonColon | TokenKind.Dot | TokenKind.DotDot | TokenKind.DotDotEq | TokenKind.Question | TokenKind.Amp |
        TokenKind.Pipe | TokenKind.Caret | TokenKind.Tilde { return Option.Some("keyword.operator.j3"); }
        _ { return Option.None; }
    }
}

// Names the parser knows (Rust `parse/syntax.rs`). Contextual words are identifiers to the lexer.
pub const ATTR_DEBUG = "Debug";
pub const ATTR_SINGLETON = "singleton";
pub const ATTR_TRY_CATCH = "TryCatch";
pub const ATTR_THREAD = "thread";
pub const ATTR_IMPL = "impl";
/// `#[derive(Eq, Hash, Ord, Debug, Clone)]` on a struct or enum.
pub const ATTR_DERIVE = "derive";
const DERIVES: [5]string = ["Eq", "Hash", "Ord", "Debug", "Clone"];
/// Contextual item word: `trait Name { .. }`, only when an identifier follows.
pub const ITEM_TRAIT = "trait";
/// Contextual item word: `extend Type { fn .. }`, only when an identifier follows.
pub const ITEM_EXTEND = "extend";
/// Contextual word after a method's signature: `where T: Eq`.
pub const FN_WHERE = "where";
pub const INTRINSIC_SYSCALL = "syscall";
pub const INTRINSIC_SIZEOF = "sizeof";
pub const INTRINSIC_UI_CHOICE = "uiChoice";
pub const INTRINSIC_SLICE = "slice";
pub const INTRINSIC_J3UI = "j3ui";
pub const INTRINSIC_SCRIPT = "script";
/// `@atomicLoad(..)` and friends.
const INTRINSIC_ATOMICS: [6]string = ["atomicLoad", "atomicStore", "atomicAdd", "atomicSub", "atomicExchange", "atomicCas"];
/// Memory-order words, the last argument of `@atomic*(..)`.
const ATOMIC_ORDERS: [5]string = ["relaxed", "acquire", "release", "acqrel", "seqcst"];
/// `#[name]` attributes (Rust `ATTRIBUTES`).
const ATTRIBUTES: [11]string = ["Debug", "derive", "singleton", "TryCatch", "thread", "impl", "shader", "vertex", "varying", "uniform", "flat"];
/// Stdlib-only: pull a closure apart into a trampoline's `ptr` pair, or rebuild one.
const INTRINSIC_CLOSURES: [3]string = ["closureFn", "closureCtx", "closureFrom"];
/// `@vmin(a, b)` and friends on `vec4f` / `vec4i`; parsed as calls of the name `@vmin`.
const INTRINSIC_SIMD: [10]string = ["vmin", "vmax", "vsqrt", "vabs", "vsum", "vshuffle", "vfloat", "vint", "vload", "vstore"];
/// `@shader(vs, fs)` and the GLSL builtins shader fns call; parsed as calls of `@name`.
const INTRINSIC_GPU: [40]string = ["shader", "discard", "fragCoord", "vertexId", "mix", "clamp", "dot", "cross", "length",
    "distance", "normalize", "min", "max", "abs", "sign", "floor", "ceil", "fract", "pow", "exp", "log", "sqrt", "sin", "cos",
    "tan", "atan", "step", "smoothstep", "mod", "fwidth", "dFdx", "dFdy", "texture", "textureLod", "texelFetch", "textureSize",
    "reflect", "refract", "transpose", "inverse"];
/// `@embed("f")` (string), `@embedBytes("f")` (`[]u8`), `@embedDir("dir", "*.j3")`.
const INTRINSIC_EMBED: [3]string = ["embed", "embedBytes", "embedDir"];
/// Contextual type word: `closure(A): R`, only when followed by `(`.
pub const TYPE_CLOSURE = "closure";
/// Contextual type word: `boxed closure(A): R`, only when `closure` follows.
pub const TYPE_BOXED = "boxed";
/// Contextual type word: `dyn Trait`, only when an identifier follows.
pub const TYPE_DYN = "dyn";
/// Every `@name` intrinsic (Rust `INTRINSICS`, its order: the six singles, embed, atomics, closures, simd, gpu).
const INTRINSICS: [68]string = ["syscall", "sizeof", "uiChoice", "slice", "j3ui", "script", "embed", "embedBytes", "embedDir",
    "atomicLoad", "atomicStore", "atomicAdd", "atomicSub", "atomicExchange", "atomicCas", "closureFn", "closureCtx", "closureFrom",
    "vmin", "vmax", "vsqrt", "vabs", "vsum", "vshuffle", "vfloat", "vint", "vload", "vstore",
    "shader", "discard", "fragCoord", "vertexId", "mix", "clamp", "dot", "cross", "length",
    "distance", "normalize", "min", "max", "abs", "sign", "floor", "ceil", "fract", "pow", "exp", "log", "sqrt", "sin", "cos",
    "tan", "atan", "step", "smoothstep", "mod", "fwidth", "dFdx", "dFdy", "texture", "textureLod", "texelFetch", "textureSize",
    "reflect", "refract", "transpose", "inverse"];
pub const SCRIPT_PROPS = "props";
pub const SCRIPT_SHARED = "shared";
/// `@j3ui` widgets whose body is the call, then `end`.
const J3UI_END: [4]string = ["panel", "row", "scroll", "card"];
/// `@j3ui` widgets whose body is the call, then `popId`.
const J3UI_POP: [1]string = ["pushId"];
/// `@j3ui` widgets whose body runs when the call returns true.
const J3UI_IF: [1]string = ["button"];
/// `@j3ui` widgets that are one call. A `{ }` on these is an error.
const J3UI_CALL: [21]string = ["label", "labelBold", "gap", "buttonOff", "bar", "image", "slider", "range", "toggle", "check",
    "stepper", "chip", "rule", "wash", "drop", "field", "drag", "worldLabel", "worldLabel3", "popId", "end"];

/// The name lists above (stage 0 cannot import a `const` array, so they are reached through this):
/// `isIn(name, names(NameList.IntrinsicGpu))`, `joinNames(NameList.Derives, ", ", arena)` for messages.
pub enum NameList { Overloadable, Derives, Attributes, Intrinsics, IntrinsicAtomics, AtomicOrders, IntrinsicClosures, IntrinsicSimd, IntrinsicGpu, IntrinsicEmbed, J3uiEnd, J3uiPop, J3uiIf, J3uiCall }

/// The words of `l`, in Rust's order.
pub fn names(l: NameList): []string {
    match l {
        NameList.Overloadable { return OVERLOADABLE; }
        NameList.Derives { return DERIVES; }
        NameList.Attributes { return ATTRIBUTES; }
        NameList.Intrinsics { return INTRINSICS; }
        NameList.IntrinsicAtomics { return INTRINSIC_ATOMICS; }
        NameList.AtomicOrders { return ATOMIC_ORDERS; }
        NameList.IntrinsicClosures { return INTRINSIC_CLOSURES; }
        NameList.IntrinsicSimd { return INTRINSIC_SIMD; }
        NameList.IntrinsicGpu { return INTRINSIC_GPU; }
        NameList.IntrinsicEmbed { return INTRINSIC_EMBED; }
        NameList.J3uiEnd { return J3UI_END; }
        NameList.J3uiPop { return J3UI_POP; }
        NameList.J3uiIf { return J3UI_IF; }
        NameList.J3uiCall { return J3UI_CALL; }
    }
}

/// True when `xs` holds `s`.
pub fn isIn(s: string, xs: []string): bool {
    for i in 0..xs.len {
        if xs[i] == s { return true; }
    }
    return false;
}

/// The words of `l` joined by `sep`, in `arena` (Rust `LIST.join(sep)`).
pub fn joinNames(l: NameList, sep: string, arena: &Arena): string {
    let xs = names(l);
    let t = Text.new(arena);
    for i in 0..xs.len {
        if i > 0 { t.add(sep); }
        t.add(xs[i]);
    }
    return t.str();
}

/// A widget name `@j3ui` knows.
pub fn isJ3uiWidget(name: string): bool {
    return isIn(name, J3UI_END) || isIn(name, J3UI_POP) || isIn(name, J3UI_IF) || isIn(name, J3UI_CALL);
}
