// `dump-ast` of blocks, statements, `match`, patterns and expressions.
//
// Part of module j3c.syntax.dump.
// Port of: j3c/src/parse/dump.rs
// J3: Uses come from `dump.j3`. Exhaustive (no `_` arm): a new `Stmt`, `Pat` or `Expr` variant fails to
// compile here. Rust's `Break(..) | Continue(..)` and `ArrayLit | Tuple` style or-arms are separate arms.
module j3c.syntax.dump;

extend W {
    fn block(this: &W, b: &Block) {
        this.open(" block");
        this.depth += 1;
        for i in 0..b.stmts.len {
            this.nl();
            this.stmt(b.stmts.items[i]);
        }
        this.depth -= 1;
        this.close();
    }

    fn optBlock(this: &W, b: Option<Block>) {
        match b {
            Option.Some(x) { this.block(&x); }
            Option.None {}
        }
    }

    fn stmt(this: &W, id: Id<Stmt>) {
        match this.ast.stmt(id) {
            Stmt.Let(s) {
                this.open("let");
                this.doc(s.doc);
                this.name(s.name);
                this.optTy(s.ty);
                this.expr(s.value);
            }
            Stmt.Return(s) {
                this.open("return");
                match s.value {
                    Option.Some(v) { this.expr(v); }
                    Option.None {}
                }
            }
            Stmt.Assign(s) {
                this.open("=");
                this.expr(s.place);
                this.expr(s.value);
            }
            Stmt.AssignOp(s) {
                this.open(bin(s.op));
                this.out.push('=');
                this.expr(s.place);
                this.expr(s.value);
            }
            Stmt.Expr(e) { this.open("expr"); this.expr(e.expr); }
            Stmt.If(s) {
                this.open("if");
                this.expr(s.cond);
                this.block(&s.thenBlock);
                this.optBlock(s.elseBlock);
            }
            Stmt.While(s) { this.open("while"); this.expr(s.cond); this.block(&s.body); }
            Stmt.For(s) {
                this.open("for");
                this.name(s.name);
                if s.inclusive { this.open(" ..="); } else { this.open(" .."); }
                this.expr(s.start);
                this.expr(s.end);
                this.close();
                this.block(&s.body);
            }
            Stmt.ForEach(s) {
                this.open("for-each");
                match s.index {
                    Option.Some(i) { this.name(i); }
                    Option.None { this.atom("_"); }
                }
                this.name(s.name);
                this.expr(s.iter);
                this.block(&s.body);
            }
            Stmt.UseLocal(s) { this.open("use-local"); this.name(s.name); }
            Stmt.Match(m) {
                this.match_(&m);
                return;
            }
            Stmt.LetPat(s) {
                this.open("let-pat");
                this.pat(s.pat);
                this.expr(s.value);
                this.optBlock(s.elseBlock);
            }
            Stmt.Defer(s) { this.open("defer"); this.block(&s.body); }
            Stmt.Labeled(s) {
                this.open("label");
                this.name(s.label);
                this.out.push(' ');
                this.stmt(s.body);
            }
            Stmt.Break(j) { this.jump("break", j.label); }
            Stmt.Continue(j) { this.jump("continue", j.label); }
            Stmt.Block(b) {
                let at = this.out.len();
                this.block(&b);
                this.out.remove(at, 1);
                return;
            }
        }
        this.close();
    }

    fn jump(this: &W, head: string, label: Option<Ident>) {
        this.open(head);
        match label {
            Option.Some(l) { this.name(l); }
            Option.None {}
        }
    }

    fn match_(this: &W, m: &MatchStmt) {
        this.open("match");
        this.expr(m.expr);
        this.depth += 1;
        for i in 0..m.arms.len {
            let arm = m.arms.items[i];
            this.nl();
            this.open("arm");
            this.open(" pats");
            for j in 0..arm.pats.len { this.pat(arm.pats.items[j]); }
            this.close();
            match arm.guard {
                Option.Some(g) {
                    this.open(" guard");
                    this.expr(g);
                    this.close();
                }
                Option.None {}
            }
            this.block(&arm.body);
            match arm.tail {
                Option.Some(t) {
                    this.open(" tail");
                    this.expr(t);
                    this.close();
                }
                Option.None {}
            }
            this.close();
        }
        this.depth -= 1;
        this.close();
    }

    fn pat(this: &W, id: Id<Pat>) {
        match this.ast.pat(id) {
            Pat.Bind(n) { this.open(" bind"); this.name(n); }
            Pat.Wild { this.open(" wild"); }
            Pat.Variant(v) {
                this.open(" variant");
                this.path(&v.path);
                for i in 0..v.payload.len { this.pat(v.payload.items[i]); }
            }
            Pat.Struct(s) {
                this.open(" struct-pat");
                this.path(&s.path);
                for i in 0..s.fields.len {
                    this.open(" ");
                    this.bare(s.fields.items[i].name);
                    this.pat(s.fields.items[i].pat);
                    this.close();
                }
                this.flag(s.rest, "..");
            }
            Pat.Tuple(t) {
                this.open(" tuple-pat");
                for i in 0..t.elems.len { this.pat(t.elems.items[i]); }
            }
            Pat.Lit(l) { this.open(" lit"); this.expr(l.expr); }
            Pat.Range(r) { this.open(" range"); this.expr(r.lo); this.expr(r.hi); }
        }
        this.close();
    }

    fn exprs(this: &W, es: &List<Id<Expr>>) {
        for i in 0..es.len { this.expr(es.items[i]); }
    }
    /// `(targs ..)`, left out when empty.
    fn targs(this: &W, ts: &List<Id<Type>>) {
        if ts.len == 0 { return; }
        this.open(" targs");
        for i in 0..ts.len { this.ty(ts.items[i]); }
        this.close();
    }

    fn expr(this: &W, id: Id<Expr>) {
        match this.ast.expr(id) {
            Expr.Name(n) {
                this.name(n);
                return;
            }
            Expr.Int(v) {
                this.out.push(' ');
                this.out.pushInt(v);
                return;
            }
            Expr.BigInt(v) { this.open(" bigint "); this.out.pushU64(v); }
            Expr.Zeroed { this.open(" zeroed"); }
            Expr.Char(c) { this.open(" char "); this.out.pushU64(u64(c)); }
            Expr.Float(f) {
                this.open(" float 0x");
                this.hex(f64Bits(f), 16);
            }
            Expr.Bool(b) {
                this.open(" bool");
                if b { this.atom("true"); } else { this.atom("false"); }
            }
            Expr.String(s) {
                this.str(s);
                return;
            }
            Expr.StructLit(s) {
                this.open(" struct-lit");
                this.name(s.name);
                this.targs(&s.typeArgs);
                this.fields(&s.fields);
            }
            Expr.TypePath(t) {
                this.open(" type-path");
                this.name(t.name);
                for i in 0..t.args.len { this.ty(t.args.items[i]); }
            }
            Expr.ArrayLit(a) { this.open(" array-lit"); this.exprs(&a.elems); }
            Expr.SliceLit(s) { this.open(" slice-lit"); this.ty(s.elem); this.fields(&s.fields); }
            Expr.Index(x) { this.open(" index"); this.expr(x.base); this.expr(x.index); }
            Expr.Slice(s) {
                this.open(" slice-expr");
                this.expr(s.base);
                this.optExpr(s.start);
                this.optExpr(s.end);
            }
            Expr.Field(f) { this.open(" ."); this.expr(f.base); this.name(f.field); }
            Expr.Call(c) {
                this.open(" call");
                this.expr(c.func);
                this.targs(&c.typeArgs);
                this.exprs(&c.args);
            }
            Expr.Syscall(s) { this.open(" syscall"); this.exprs(&s.args); }
            Expr.Atomic(a) {
                this.open(" atomic");
                this.atom(atomicOpName(a.op));
                this.atom(atomicOrderName(a.order));
                this.exprs(&a.args);
            }
            Expr.ScriptType(s) { this.open(" script-type"); this.str(s); }
            Expr.Embed(e) {
                this.open(" embed");
                match e.kind {
                    EmbedKind.Text { this.atom("text"); }
                    EmbedKind.Bytes { this.atom("bytes"); }
                    EmbedKind.Dir { this.atom("dir"); }
                }
                this.str(e.path);
                this.str(e.glob);
            }
            Expr.ScriptLit(s) { this.open(" script-lit"); this.str(s.path); this.fields(&s.fields); }
            Expr.SizeOf(s) { this.open(" sizeof"); this.ty(s.ty); }
            Expr.UiChoice(u) {
                this.open(" ui-choice");
                this.ty(u.set);
                this.expr(u.value);
                this.expr(u.index);
            }
            Expr.SliceFrom(s) { this.open(" slice-from"); this.expr(s.ptr); this.expr(s.len); }
            Expr.Cast(c) { this.open(" as"); this.expr(c.expr); this.ty(c.ty); }
            Expr.Binary(b) {
                this.binary(b);
                return;
            }
            Expr.Unary(u) {
                this.open(" ");
                match u.op {
                    UnaryOp.Neg { this.out.push('-'); }
                    UnaryOp.BitNot { this.out.push('~'); }
                    UnaryOp.Ref { this.out.push('&'); }
                    UnaryOp.Deref { this.out.push('*'); }
                    UnaryOp.Not { this.out.push('!'); }
                }
                this.expr(u.expr);
            }
            Expr.Interpolate(x) {
                this.open(" interp");
                for i in 0..x.parts.len {
                    match x.parts.items[i] {
                        InterpPart.Lit(s) { this.str(s); }
                        InterpPart.Expr(h) { this.expr(h.expr); }
                    }
                }
            }
            Expr.Tuple(t) { this.open(" tuple"); this.exprs(&t.elems); }
            Expr.If(x) {
                this.open(" if-expr");
                this.expr(x.cond);
                this.expr(x.thenExpr);
                this.expr(x.elseExpr);
            }
            Expr.Question(q) { this.open(" ?"); this.expr(q.expr); }
            Expr.Match(m) {
                this.out.push(' ');
                this.match_(&m);
                return;
            }
            Expr.Closure(c) {
                this.open(" fn-lit");
                match c.arena {
                    Option.Some(a) {
                        this.open(" arena");
                        this.expr(a);
                        this.close();
                    }
                    Option.None {}
                }
                this.open(" params");
                for i in 0..c.params.len {
                    let p = c.params.items[i];
                    this.open(" ");
                    this.bare(p.name);
                    this.optTy(p.ty);
                    this.close();
                }
                this.close();
                this.optTy(c.ret);
                this.block(&c.body);
            }
        }
        this.close();
    }

    /// `(op lhs rhs)` with the closing `)`. A left-deep chain (`a + b + c + ...`, 20000 terms in generated
    /// code) is walked down its `lhs` spine in a loop, so the stack stays flat: open every level, print the
    /// innermost lhs, then each level's rhs and `)` from the inside out. Same text as Rust's recursion.
    fn binary(this: &W, top: BinaryExpr) {
        let base = this.rhs.len;
        let b = top;
        let leaf = top.lhs;
        while true {
            this.rhs.push(b.rhs);
            this.open(" ");
            this.out.add(bin(b.op));
            leaf = b.lhs;
            match this.ast.expr(leaf) {
                Expr.Binary(inner) { b = inner; }
                _ { break; }
            }
        }
        this.expr(leaf);
        while this.rhs.len > base {
            this.expr(this.rhs.pop());
            this.close();
        }
    }
}
