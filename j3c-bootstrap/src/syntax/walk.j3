// Walk over the names a block mentions (used by closures, lint, LSP).
//
// Port of: j3c/src/parse/walk.rs
// J3: Exhaustive on purpose: every `match` over `Expr`, `Stmt` and `Pat` has no `_` arm, so a new AST node
// is a compile error here until it is handled (plan 11 B7). Rust's or-arms are one arm per variant; visit
// order is Rust's.
module j3c.syntax.walk;

use j3.data.pool.Id;
use j3.memory.List;
use j3.option.Option;
use j3c.syntax.ast.{ Ast, Block, Expr, FieldInit, Ident, InterpPart, MatchStmt, Pat, Stmt };

/// Calls `f` for every identifier used as a value or `use`d local anywhere in `block`, closure literals
/// nested inside included (Rust `names_in_block`).
pub fn namesInBlock(ast: &Ast, block: &Block, f: closure(Ident)) {
    for i in 0..block.stmts.len { namesInStmt(ast, block.stmts.items[i], f); }
}

fn namesInOptBlock(ast: &Ast, b: Option<Block>, f: closure(Ident)) {
    match b {
        Option.Some(x) { namesInBlock(ast, &x, f); }
        Option.None {}
    }
}

fn namesInOptExpr(ast: &Ast, e: Option<Id<Expr>>, f: closure(Ident)) {
    match e {
        Option.Some(x) { namesInExpr(ast, x, f); }
        Option.None {}
    }
}

fn namesInExprs(ast: &Ast, es: &List<Id<Expr>>, f: closure(Ident)) {
    for i in 0..es.len { namesInExpr(ast, es.items[i], f); }
}

fn namesInFields(ast: &Ast, fs: &List<FieldInit>, f: closure(Ident)) {
    for i in 0..fs.len { namesInExpr(ast, fs.items[i].value, f); }
}

fn namesInStmt(ast: &Ast, id: Id<Stmt>, f: closure(Ident)) {
    match ast.stmt(id) {
        Stmt.Let(s) { namesInExpr(ast, s.value, f); }
        Stmt.LetPat(s) {
            namesInPat(ast, s.pat, f);
            namesInExpr(ast, s.value, f);
            namesInOptBlock(ast, s.elseBlock, f);
        }
        Stmt.Return(s) { namesInOptExpr(ast, s.value, f); }
        Stmt.Assign(s) {
            namesInExpr(ast, s.place, f);
            namesInExpr(ast, s.value, f);
        }
        Stmt.AssignOp(s) {
            namesInExpr(ast, s.place, f);
            namesInExpr(ast, s.value, f);
        }
        Stmt.Expr(e) { namesInExpr(ast, e.expr, f); }
        Stmt.If(s) {
            namesInExpr(ast, s.cond, f);
            namesInBlock(ast, &s.thenBlock, f);
            namesInOptBlock(ast, s.elseBlock, f);
        }
        Stmt.While(s) {
            namesInExpr(ast, s.cond, f);
            namesInBlock(ast, &s.body, f);
        }
        Stmt.For(s) {
            namesInExpr(ast, s.start, f);
            namesInExpr(ast, s.end, f);
            namesInBlock(ast, &s.body, f);
        }
        Stmt.ForEach(s) {
            namesInExpr(ast, s.iter, f);
            namesInBlock(ast, &s.body, f);
        }
        Stmt.UseLocal(s) { f(s.name); }
        Stmt.Match(s) { namesInMatch(ast, &s, f); }
        Stmt.Defer(s) { namesInBlock(ast, &s.body, f); }
        Stmt.Labeled(s) { namesInStmt(ast, s.body, f); }
        Stmt.Break(_) {}
        Stmt.Continue(_) {}
        Stmt.Block(b) { namesInBlock(ast, &b, f); }
    }
}

fn namesInMatch(ast: &Ast, s: &MatchStmt, f: closure(Ident)) {
    namesInExpr(ast, s.expr, f);
    for i in 0..s.arms.len {
        let arm = s.arms.items[i];
        for j in 0..arm.pats.len { namesInPat(ast, arm.pats.items[j], f); }
        namesInOptExpr(ast, arm.guard, f);
        namesInBlock(ast, &arm.body, f);
        namesInOptExpr(ast, arm.tail, f);
    }
}

/// Calls `f` for every name `pat` binds (Rust `pat_binds`).
pub fn patBinds(ast: &Ast, pat: Id<Pat>, f: closure(Ident)) {
    match ast.pat(pat) {
        Pat.Bind(n) { f(n); }
        Pat.Variant(v) {
            for i in 0..v.payload.len { patBinds(ast, v.payload.items[i], f); }
        }
        Pat.Struct(s) {
            for i in 0..s.fields.len { patBinds(ast, s.fields.items[i].pat, f); }
        }
        Pat.Tuple(t) {
            for i in 0..t.elems.len { patBinds(ast, t.elems.items[i], f); }
        }
        Pat.Wild {}
        Pat.Lit(_) {}
        Pat.Range(_) {}
    }
}

fn namesInPat(ast: &Ast, pat: Id<Pat>, f: closure(Ident)) {
    match ast.pat(pat) {
        Pat.Bind(_) {}
        Pat.Wild {}
        Pat.Variant(v) {
            for i in 0..v.payload.len { namesInPat(ast, v.payload.items[i], f); }
        }
        Pat.Struct(s) {
            for i in 0..s.fields.len { namesInPat(ast, s.fields.items[i].pat, f); }
        }
        Pat.Tuple(t) {
            for i in 0..t.elems.len { namesInPat(ast, t.elems.items[i], f); }
        }
        Pat.Lit(l) { namesInExpr(ast, l.expr, f); }
        Pat.Range(r) {
            namesInExpr(ast, r.lo, f);
            namesInExpr(ast, r.hi, f);
        }
    }
}

fn namesInExpr(ast: &Ast, id: Id<Expr>, f: closure(Ident)) {
    match ast.expr(id) {
        Expr.Name(n) { f(n); }
        Expr.Int(_) {}
        Expr.BigInt(_) {}
        Expr.Zeroed {}
        Expr.Char(_) {}
        Expr.Float(_) {}
        Expr.Bool(_) {}
        Expr.String(_) {}
        Expr.TypePath(_) {}
        Expr.ScriptType(_) {}
        Expr.Embed(_) {}
        Expr.SizeOf(_) {}
        Expr.StructLit(s) { namesInFields(ast, &s.fields, f); }
        Expr.SliceLit(s) { namesInFields(ast, &s.fields, f); }
        Expr.ScriptLit(s) { namesInFields(ast, &s.fields, f); }
        Expr.ArrayLit(a) { namesInExprs(ast, &a.elems, f); }
        Expr.Tuple(t) { namesInExprs(ast, &t.elems, f); }
        Expr.Index(x) {
            namesInExpr(ast, x.base, f);
            namesInExpr(ast, x.index, f);
        }
        Expr.Slice(s) {
            namesInExpr(ast, s.base, f);
            namesInOptExpr(ast, s.start, f);
            namesInOptExpr(ast, s.end, f);
        }
        Expr.Field(x) { namesInExpr(ast, x.base, f); }
        Expr.Call(c) {
            namesInExpr(ast, c.func, f);
            namesInExprs(ast, &c.args, f);
        }
        Expr.Syscall(s) { namesInExprs(ast, &s.args, f); }
        Expr.Atomic(a) { namesInExprs(ast, &a.args, f); }
        Expr.UiChoice(u) {
            namesInExpr(ast, u.value, f);
            namesInExpr(ast, u.index, f);
        }
        Expr.SliceFrom(s) {
            namesInExpr(ast, s.ptr, f);
            namesInExpr(ast, s.len, f);
        }
        Expr.Cast(c) { namesInExpr(ast, c.expr, f); }
        Expr.Unary(u) { namesInExpr(ast, u.expr, f); }
        Expr.Question(q) { namesInExpr(ast, q.expr, f); }
        Expr.Binary(b) {
            namesInExpr(ast, b.lhs, f);
            namesInExpr(ast, b.rhs, f);
        }
        Expr.Interpolate(x) {
            for i in 0..x.parts.len {
                match x.parts.items[i] {
                    InterpPart.Expr(h) { namesInExpr(ast, h.expr, f); }
                    InterpPart.Lit(_) {}
                }
            }
        }
        Expr.If(x) {
            namesInExpr(ast, x.cond, f);
            namesInExpr(ast, x.thenExpr, f);
            namesInExpr(ast, x.elseExpr, f);
        }
        Expr.Closure(c) {
            namesInOptExpr(ast, c.arena, f);
            namesInBlock(ast, &c.body, f);
        }
        Expr.Match(m) { namesInMatch(ast, &m, f); }
    }
}
