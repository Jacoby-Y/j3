// Rules for tokens: keywords, types, numbers, calls, members, operators.
//
// Part of module j3c.textmate.
// Port of: j3c/src/parse/syntax/rules_tokens.rs (and syntax.rs `OPERATOR_KINDS`)
// J3: Keyword words and their scopes, the bool literals and the builtin type names are one data file,
// `text/syntax/keywords.txt` (plan 11 B10), read by both `syntax/lex` and this grammar, so they can't drift.
// Groups (keywords by scope, operators by class) keep first-seen order, as Rust's `Vec` find-or-push does.
module j3c.textmate;

/// Operator kinds the grammar highlights, in Rust's `OPERATOR_KINDS` order (it sets the group order).
const OPERATOR_KINDS: [34]TokenKind = [TokenKind.ShlEq, TokenKind.ShrEq, TokenKind.ColonColon, TokenKind.DotDot,
    TokenKind.DotDotEq, TokenKind.EqEq, TokenKind.Ne, TokenKind.Le, TokenKind.Ge, TokenKind.AndAnd, TokenKind.OrOr,
    TokenKind.PlusEq, TokenKind.MinusEq, TokenKind.StarEq, TokenKind.SlashEq, TokenKind.PercentEq, TokenKind.AmpEq,
    TokenKind.PipeEq, TokenKind.CaretEq, TokenKind.Pipe, TokenKind.Caret, TokenKind.Tilde, TokenKind.Dot,
    TokenKind.Question, TokenKind.Amp, TokenKind.Eq, TokenKind.Lt, TokenKind.Gt, TokenKind.Not, TokenKind.Plus,
    TokenKind.Minus, TokenKind.Star, TokenKind.Slash, TokenKind.Percent];

/// `scopes[i]` is the scope of `words[i]`; returns the distinct scopes in first-seen order.
fn groupOrder(scopes: []string, arena: &Arena): List<string> {
    let out = List<string>.new(arena);
    for i in 0..scopes.len {
        let seen = false;
        for j in 0..out.len { if out.items[j] == scopes[i] { seen = true; } }
        if !seen { out.push(scopes[i]); }
    }
    return out;
}

/// The words of `words` whose scope (same index in `scopes`) is `scope`, in order.
fn groupOf(words: []string, scopes: []string, scope: string, arena: &Arena): List<string> {
    let out = List<string>.new(arena);
    for i in 0..words.len { if scopes[i] == scope { out.push(words[i]); } }
    return out;
}

fn repoKeywords(t: &Text) {
    let a = t.arena;
    let words = keywordNames(a);
    let scopes = a.alloc::<string>(words.len);
    for i in 0..words.len {
        scopes[i] = scopeOf(words[i]);
        if scopes[i].len == 0 { panic("keyword needs a highlight scope (keywords.txt SCOPE column)"); }
    }
    let groups = groupOrder(scopes, a);
    t.add("    \"keywords\": {\n");
    t.add("      \"patterns\": [\n");
    // Contextual: `trait Name`, so a variable called `trait` stays a variable.
    matchRule(t, 4, "storage.type.trait.j3", cat(a, ["\\b", ITEM_TRAIT, "(?=\\s+", IDENT, ")"]), true);
    matchRule(t, 4, "storage.type.extend.j3", cat(a, ["\\b", ITEM_EXTEND, "(?=\\s+", IDENT, ")"]), true);
    matchRule(t, 4, "keyword.other.where.j3", cat(a, ["\\b", FN_WHERE, "(?=\\s+", IDENT, "\\s*:)"]), true);
    matchRule(t, 4, "storage.type.dyn.j3", cat(a, ["\\b", TYPE_DYN, "(?=\\s+", IDENT, ")"]), true);
    matchRule(t, 4, "storage.modifier.boxed.j3", cat(a, ["\\b", TYPE_BOXED, "(?=\\s+", TYPE_CLOSURE, "\\()"]), true);
    for i in 0..groups.len {
        let g = groupOf(words, scopes, groups.items[i], a);
        matchRule(t, 4, groups.items[i], wordAlts(g.slice(), a), i + 1 != groups.len);
    }
    t.add("      ]\n");
    t.add("    }");
}

fn repoTypes(t: &Text) {
    let a = t.arena;
    let slice = cat(a, ["(\\[)(\\])(?=", IDENT, ")"]);
    let array = cat(a, ["(\\[)([0-9]+)(\\])(?=", IDENT, ")"]);
    let genericBegin = cat(a, ["\\b(", PASCAL, ")\\s*(<)"]);
    t.add("    \"types\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, slice, ["1", "punctuation.definition.bracket.square.j3", "2", "punctuation.definition.bracket.square.j3"], true);
    matchCaptures(t, 4, array, ["1", "punctuation.definition.bracket.square.j3", "2", "constant.numeric.integer.j3",
        "3", "punctuation.definition.bracket.square.j3"], true);
    matchRule(t, 4, "support.type.builtin.j3", wordAlts(wordsOf("type", a), a), true);
    matchRule(t, 4, "support.type.builtin.j3", cat(a, ["\\b", TYPE_CLOSURE, "(?=\\()"]), true);
    t.add("        {\n");
    t.add("          \"begin\": ");
    jsonString(t, genericBegin);
    t.add(",\n");
    t.add("          \"beginCaptures\": {\n");
    t.add("            \"1\": { \"name\": \"entity.name.type.j3\" },\n");
    t.add("            \"2\": { \"name\": \"punctuation.definition.typeparameters.begin.j3\" }\n");
    t.add("          },\n");
    t.add("          \"end\": \">\",\n");
    t.add("          \"endCaptures\": {\n");
    t.add("            \"0\": { \"name\": \"punctuation.definition.typeparameters.end.j3\" }\n");
    t.add("          },\n");
    t.add("          \"patterns\": [\n");
    includes(t, 6, ["comments", "types", "punctuation"]);
    t.add("          ]\n");
    t.add("        },\n");
    matchRule(t, 4, "entity.name.type.j3", cat(a, ["\\b", PASCAL, "\\b"]), false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoConstantsBool(t: &Text) {
    t.add("    \"constants-bool\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "constant.language.boolean.j3", wordAlts(wordsOf("literal", t.arena), t.arena), false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoNumbers(t: &Text) {
    t.add("    \"numbers\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "constant.numeric.hex.j3", "\\b0x[0-9A-Fa-f]+\\b", true);
    matchRule(t, 4, "constant.numeric.binary.j3", "\\b0b[01]+\\b", true);
    matchRule(t, 4, "constant.numeric.float.j3", "\\b[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b", true);
    matchRule(t, 4, "constant.numeric.integer.j3", "\\b[0-9]+\\b", false);
    t.add("      ]\n");
    t.add("    }");
}

/// Char literals (`'a'`, `'\n'`, `'\u{1F600}'`), matched before labels so `'a'` is not `'a`.
fn repoChars(t: &Text) {
    t.add("    \"chars\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "constant.character.j3", "'(?:[^'\\\\\\n]|\\\\(?:[nrt0\\\\'\"]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\}))'", false);
    t.add("      ]\n");
    t.add("    }");
}

/// Loop labels (`'rows:`, `break 'rows;`).
fn repoLabels(t: &Text) {
    t.add("    \"labels\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "entity.name.label.j3", "'[A-Za-z_][A-Za-z0-9_]*", false);
    t.add("      ]\n");
    t.add("    }");
}

/// Order word as the last argument of `@atomic*(..)`. Contextual (after a comma, before `)`).
fn repoAtomicOrders(t: &Text) {
    let pat = cat(t.arena, ["(?<=,)[ \\t]*", wordAlts(names(NameList.AtomicOrders), t.arena), "(?=\\s*\\))"]);
    t.add("    \"atomic-orders\": {\n");
    t.add("      \"match\": ");
    jsonString(t, pat);
    t.add(",\n");
    t.add("      \"name\": \"constant.language.atomic-order.j3\"\n");
    t.add("    }");
}

fn repoCalls(t: &Text) {
    let a = t.arena;
    let turbofish = cat(a, ["\\b(", IDENT, ")(?=\\s*::<)"]);
    let call = cat(a, ["\\b(", IDENT, ")(?=\\s*\\()"]);
    t.add("    \"calls\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, turbofish, ["1", "entity.name.function.j3"], true);
    matchCaptures(t, 4, call, ["1", "entity.name.function.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoMembers(t: &Text) {
    let a = t.arena;
    let method = cat(a, ["(\\.)(", CAMEL, ")(?=\\s*\\()"]);
    let enumCall = cat(a, ["(\\.)(", PASCAL, "|", CONST_NAME, ")(?=\\s*\\()"]);
    let constMem = cat(a, ["(\\.)(", CONST_NAME, ")\\b"]);
    let enumMem = cat(a, ["(\\.)(", PASCAL, ")\\b"]);
    let prop = cat(a, ["(\\.)(", IDENT, ")\\b"]);
    t.add("    \"members\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, method, ["1", "punctuation.accessor.j3", "2", "entity.name.function.j3"], true);
    matchCaptures(t, 4, enumCall, ["1", "punctuation.accessor.j3", "2", "variable.other.enummember.j3"], true);
    matchCaptures(t, 4, constMem, ["1", "punctuation.accessor.j3", "2", "variable.other.constant.j3"], true);
    matchCaptures(t, 4, enumMem, ["1", "punctuation.accessor.j3", "2", "variable.other.enummember.j3"], true);
    matchCaptures(t, 4, prop, ["1", "punctuation.accessor.j3", "2", "variable.other.property.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoConstantsNamed(t: &Text) {
    t.add("    \"constants-named\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "variable.other.constant.j3", cat(t.arena, ["\\b", CONST_NAME, "\\b"]), false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoVariables(t: &Text) {
    let a = t.arena;
    t.add("    \"variables\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, cat(a, ["(", IDENT, ")\\s*(:)"]), ["1", "variable.parameter.j3", "2", "punctuation.separator.j3"], true);
    matchRule(t, 4, "variable.other.j3", cat(a, ["\\b", IDENT, "\\b"]), false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoOperators(t: &Text) {
    let a = t.arena;
    let srcs = a.alloc::<string>(OPERATOR_KINDS.len);
    let scopes = a.alloc::<string>(OPERATOR_KINDS.len);
    for i in 0..OPERATOR_KINDS.len {
        let Option.Some(src) = operatorSrc(OPERATOR_KINDS[i]) else { panic("operator kind"); return; };
        let Option.Some(scope) = operatorClass(OPERATOR_KINDS[i]) else { panic("operator class"); return; };
        srcs[i] = src;
        scopes[i] = scope;
    }
    let groups = groupOrder(scopes, a);
    t.add("    \"operators\": {\n");
    t.add("      \"patterns\": [\n");
    for i in 0..groups.len {
        let ops = groupOf(srcs, scopes, groups.items[i], a);
        matchRule(t, 4, groups.items[i], altsOf(ops.slice(), a), i + 1 != groups.len);
    }
    t.add("      ]\n");
    t.add("    }");
}

fn repoPunctuation(t: &Text) {
    t.add("    \"punctuation\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "punctuation.bracket.j3", "[\\(\\)\\[\\]\\{\\}]", true);
    matchRule(t, 4, "punctuation.separator.j3", "[,;]", true);
    matchRule(t, 4, "punctuation.separator.j3", ":", false);
    t.add("      ]\n");
    t.add("    }");
}
