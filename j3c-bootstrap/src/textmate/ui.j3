// The `.j3ui` grammar (`--ui`).
//
// Part of module j3c.textmate.
// Port of: j3c/src/parse/syntax/ui.rs
// J3: The grammar text (Rust `UI_GRAMMAR`) is `text/syntax/j3ui.tmLanguage.json.in`, embedded; `@ELEMENTS@`
// becomes the `.j3ui` element table joined by `|`, then `|component`.
// J3: The elements come from `ui/gen.elements()` (stage 0 cannot read another module's `const` array).
module j3c.textmate;

/// Rust `UI_GRAMMAR`. Relative to this file: unit-test packages have their own root.
const UI_GRAMMAR = @embed("../../text/syntax/j3ui.tmLanguage.json.in");

/// The `.j3ui` TextMate grammar, `editors/vscode/syntaxes/j3ui.tmLanguage.json` byte for byte, in
/// `arena` (Rust `ui_tm_grammar`).
pub fn uiTmGrammar(arena: &Arena): string {
    let els = Text.new(arena);
    let names = gen.elements();
    for i in 0..names.len {
        if i > 0 { els.add("|"); }
        els.add(names[i]);
    }
    els.add("|component");
    let t = Text.new(arena);
    return replace(&t, UI_GRAMMAR, "@ELEMENTS@", els.str());
}

