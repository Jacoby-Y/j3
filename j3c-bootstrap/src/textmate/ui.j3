// The `.j3ui` grammar (`--ui`).
//
// Part of module j3c.textmate.
// Port of: j3c/src/parse/syntax/ui.rs
// J3: The grammar text (Rust `UI_GRAMMAR`) is `text/syntax/j3ui.tmLanguage.json.in`, embedded; `@ELEMENTS@`
// becomes the `.j3ui` element table joined by `|`, then `|component`.
// J3: stage 0 cannot read another module's `const` array (`ELEMENTS`), so `ELEMENTS` is a copy of
// `ui/gen.j3`'s until `ui/gen` exports `pub fn elements(): []string` (Ownership request, wave 26). The unit
// test `textmate_grammar` fails if the copy drifts from the shipped grammar.
module j3c.textmate;

/// Rust `UI_GRAMMAR`. Relative to this file: unit-test packages have their own root.
const UI_GRAMMAR = @embed("../../text/syntax/j3ui.tmLanguage.json.in");

// ponytail: copy of `ui/ELEMENTS`; swap for `gen.elements()` once ui/gen exports it.
const ELEMENTS: [47]string = [
    "div", "span", "p", "h1", "h2", "small", "header", "nav", "main", "section", "label", "button", "input", "textarea", "select", "option", "dl", "dt", "dd", "canvas", "dialog", "aside", "img", "svg", "path", "h3", "h4", "h5", "h6", "ul", "ol", "li", "a", "hr", "strong", "em", "b", "i", "pre", "code", "br", "progress", "meter", "details", "summary", "glyph", "icon"
];

/// The `.j3ui` TextMate grammar, `editors/vscode/syntaxes/j3ui.tmLanguage.json` byte for byte, in
/// `arena` (Rust `ui_tm_grammar`).
pub fn uiTmGrammar(arena: &Arena): string {
    let els = Text.new(arena);
    for i in 0..ELEMENTS.len {
        if i > 0 { els.add("|"); }
        els.add(ELEMENTS[i]);
    }
    els.add("|component");
    let t = Text.new(arena);
    return replace(&t, UI_GRAMMAR, "@ELEMENTS@", els.str());
}

