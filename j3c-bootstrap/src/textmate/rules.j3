// Repository rules: items, blocks, strings, interpolation.
//
// Part of module j3c.textmate.
// Port of: j3c/src/parse/syntax/rules.rs
// J3: Each `repo*` appends to `t`; scratch patterns go in `t.arena`.
module j3c.textmate;

fn repoComments(t: &Text) {
    t.add("    \"comments\": {\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "comment.line.double-slash.j3", "//.*$", false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoStrings(t: &Text) {
    t.add("    \"strings\": {\n");
    t.add("      \"name\": \"string.quoted.double.j3\",\n");
    t.add("      \"begin\": \"\\\"\",\n");
    t.add("      \"end\": \"\\\"\",\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "constant.character.escape.j3", "\\\\(?:[\\\\\"nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})", false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoInterpolate(t: &Text) {
    t.add("    \"interpolate\": {\n");
    t.add("      \"name\": \"string.interpolated.j3\",\n");
    t.add("      \"begin\": \"`\",\n");
    t.add("      \"end\": \"`\",\n");
    t.add("      \"patterns\": [\n");
    t.add("        {\n");
    t.add("          \"name\": \"meta.template.expression.j3\",\n");
    t.add("          \"begin\": \"\\\\{\",\n");
    t.add("          \"beginCaptures\": {\n");
    t.add("            \"0\": { \"name\": \"punctuation.definition.template-expression.begin.j3\" }\n");
    t.add("          },\n");
    t.add("          \"end\": \"\\\\}\",\n");
    t.add("          \"endCaptures\": {\n");
    t.add("            \"0\": { \"name\": \"punctuation.definition.template-expression.end.j3\" }\n");
    t.add("          },\n");
    t.add("          \"patterns\": [\n");
    includes(t, 6, ["comments", "keywords", "types", "constants-bool", "numbers", "calls", "members", "constants-named", "variables", "operators"]);
    t.add("          ]\n");
    t.add("        }\n");
    t.add("      ]\n");
    t.add("    }");
}

fn repoAttributes(t: &Text) {
    t.add("    \"attributes\": {\n");
    t.add("      \"name\": \"meta.attribute.j3\",\n");
    t.add("      \"begin\": \"(#)(\\\\[)\",\n");
    t.add("      \"beginCaptures\": {\n");
    t.add("        \"1\": { \"name\": \"punctuation.definition.annotation.j3\" },\n");
    t.add("        \"2\": { \"name\": \"punctuation.definition.bracket.square.j3\" }\n");
    t.add("      },\n");
    t.add("      \"end\": \"\\\\]\",\n");
    t.add("      \"endCaptures\": {\n");
    t.add("        \"0\": { \"name\": \"punctuation.definition.bracket.square.j3\" }\n");
    t.add("      },\n");
    t.add("      \"patterns\": [\n");
    matchRule(t, 4, "entity.other.attribute.j3", wordAlts(names(NameList.Attributes), t.arena), true);
    includes(t, 4, ["comments", "types", "punctuation"]);
    t.add("      ]\n");
    t.add("    }");
}

fn repoIntrinsics(t: &Text) {
    let p = Text.new(t.arena);
    p.add("(@)(");
    let xs = names(NameList.Intrinsics);
    for i in 0..xs.len {
        if i > 0 { p.add("|"); }
        addEscaped(&p, xs[i]);
    }
    p.add(")\\b");
    t.add("    \"intrinsics\": {\n");
    t.add("      \"match\": ");
    jsonString(t, p.str());
    t.add(",\n");
    t.add("      \"captures\": {\n");
    t.add("        \"1\": { \"name\": \"punctuation.definition.keyword.j3\" },\n");
    t.add("        \"2\": { \"name\": \"support.function.intrinsic.j3\" }\n");
    t.add("      }\n");
    t.add("    }");
}

fn repoModuleDecl(t: &Text) {
    let a = t.arena;
    let pat = cat(a, ["\\b(", reEscape(kw(TokenKind.Module, a), a), ")\\s+(", IDENT, "(?:\\.", IDENT, ")*)"]);
    t.add("    \"module-decl\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, pat, ["1", "keyword.other.j3", "2", "entity.name.namespace.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoUseLib(t: &Text) {
    let a = t.arena;
    let begin = cat(a, ["\\b(", reEscape(kw(TokenKind.Use, a), a), ")\\s+(", reEscape(kw(TokenKind.Lib, a), a), ")\\b"]);
    t.add("    \"use-lib\": {\n");
    t.add("      \"begin\": ");
    jsonString(t, begin);
    t.add(",\n");
    t.add("      \"beginCaptures\": {\n");
    t.add("        \"1\": { \"name\": \"keyword.other.j3\" },\n");
    t.add("        \"2\": { \"name\": \"keyword.other.j3\" }\n");
    t.add("      },\n");
    t.add("      \"end\": \"\\\\}\",\n");
    t.add("      \"endCaptures\": {\n");
    t.add("        \"0\": { \"name\": \"punctuation.section.block.end.j3\" }\n");
    t.add("      },\n");
    t.add("      \"patterns\": [\n");
    includes(t, 4, ["comments", "strings", "fn-decl", "keywords", "types", "variables", "operators", "punctuation"]);
    t.add("      ]\n");
    t.add("    }");
}

fn repoUseDecl(t: &Text) {
    let a = t.arena;
    let begin = cat(a, ["\\b(", reEscape(kw(TokenKind.Use, a), a), ")\\b(?!\\s+", reEscape(kw(TokenKind.Lib, a), a), ")"]);
    t.add("    \"use-decl\": {\n");
    t.add("      \"begin\": ");
    jsonString(t, begin);
    t.add(",\n");
    t.add("      \"beginCaptures\": {\n");
    t.add("        \"0\": { \"name\": \"keyword.other.j3\" }\n");
    t.add("      },\n");
    t.add("      \"end\": \";\",\n");
    t.add("      \"endCaptures\": {\n");
    t.add("        \"0\": { \"name\": \"punctuation.terminator.statement.j3\" }\n");
    t.add("      },\n");
    t.add("      \"patterns\": [\n");
    includes(t, 4, ["comments", "keywords", "types", "constants-named", "calls", "members", "variables", "punctuation"]);
    t.add("      ]\n");
    t.add("    }");
}

fn repoFnDecl(t: &Text) {
    let a = t.arena;
    let fnKw = reEscape(kw(TokenKind.Fn, a), a);
    let opKw = reEscape(kw(TokenKind.Operator, a), a);
    let opFn = cat(a, ["\\b(", fnKw, ")\\s+(", opKw, ")(", opAlts(a), ")"]);
    let named = cat(a, ["\\b(", fnKw, ")\\s+(", IDENT, ")"]);
    t.add("    \"fn-decl\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, opFn, ["1", "storage.type.j3", "2", "keyword.other.j3", "3", "entity.name.operator.j3"], true);
    matchCaptures(t, 4, named, ["1", "storage.type.j3", "2", "entity.name.function.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoTypeDecl(t: &Text) {
    let a = t.arena;
    let pat = cat(a, ["\\b(", reEscape(kw(TokenKind.Struct, a), a), "|", reEscape(kw(TokenKind.Enum, a), a), ")\\s+(", IDENT, ")"]);
    t.add("    \"type-decl\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, pat, ["1", "storage.type.j3", "2", "entity.name.type.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoConstDecl(t: &Text) {
    let a = t.arena;
    let pat = cat(a, ["\\b(", reEscape(kw(TokenKind.Const, a), a), ")\\s+(", IDENT, ")"]);
    t.add("    \"const-decl\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, pat, ["1", "storage.type.j3", "2", "variable.other.constant.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoLetDecl(t: &Text) {
    let a = t.arena;
    let pat = cat(a, ["\\b(", reEscape(kw(TokenKind.Let, a), a), ")\\s+(", IDENT, ")"]);
    t.add("    \"let-decl\": {\n");
    t.add("      \"patterns\": [\n");
    matchCaptures(t, 4, pat, ["1", "storage.type.j3", "2", "variable.other.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}

fn repoScriptBlock(t: &Text) {
    t.add("    \"script-block\": {\n");
    t.add("      \"patterns\": [\n");
    let pat = cat(t.arena, ["\\b(", SCRIPT_PROPS, "|", SCRIPT_SHARED, "|events)\\b(?=\\s*\\{)"]);
    matchCaptures(t, 4, pat, ["1", "keyword.other.j3"], true);
    // `.j3ui` script statements: `provide x;` `inject x: T;` `emit pick(i)`
    matchCaptures(t, 4, "\\b(provide|inject|emit)\\b(?=\\s+[A-Za-z_])", ["1", "keyword.other.j3"], false);
    t.add("      ]\n");
    t.add("    }");
}
