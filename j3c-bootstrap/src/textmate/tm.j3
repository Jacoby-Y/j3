// Grammar JSON writing and regex helpers, and the top-level `j3.tmLanguage.json` (`tmGrammar`).
//
// Part of module j3c.textmate.
// Port of: j3c/src/parse/syntax/tm.rs
// J3: Everything writes into one `Text`; patterns built on the side are `Text`s in the same arena. Rust's
// `includes_block` and `include_items` are the same fn (`includes`). Capture lists are flat
// `[num, scope, num, scope, ...]` slices instead of `(&str, &str)` pairs.
module j3c.textmate;

/// ASCII ident. Lexer also allows Unicode letters.
const IDENT = "[A-Za-z_][A-Za-z0-9_]*";
const PASCAL = "[A-Z][A-Za-z0-9]*";
const CAMEL = "[a-z_][A-Za-z0-9_]*";
const CONST_NAME = "[A-Z][A-Z0-9_]+";

const TOP_INCLUDES: [26]string = ["comments", "strings", "interpolate", "attributes", "intrinsics", "atomic-orders",
    "module-decl", "use-lib", "use-decl", "fn-decl", "type-decl", "const-decl", "let-decl", "script-block", "keywords",
    "chars", "labels", "types", "constants-bool", "numbers", "calls", "members", "constants-named", "variables",
    "operators", "punctuation"];

/// The J3 TextMate grammar, `editors/vscode/syntaxes/j3.tmLanguage.json` byte for byte, in `arena`
/// (Rust `tm_grammar`).
pub fn tmGrammar(arena: &Arena): string {
    let t = Text.new(arena);
    t.add("{\n");
    field(&t, 1, "name", "J3");
    field(&t, 1, "scopeName", "source.j3");
    field(&t, 1, "comment", "Generated by j3c dump-syntax from lexer/parser tables. Do not edit.");
    t.add("  \"patterns\": [\n");
    includes(&t, 2, TOP_INCLUDES);
    t.add("  ],\n");
    t.add("  \"repository\": {\n");
    repoComments(&t);
    sep(&t);
    repoStrings(&t);
    sep(&t);
    repoInterpolate(&t);
    sep(&t);
    repoAttributes(&t);
    sep(&t);
    repoIntrinsics(&t);
    sep(&t);
    repoAtomicOrders(&t);
    sep(&t);
    repoModuleDecl(&t);
    sep(&t);
    repoUseLib(&t);
    sep(&t);
    repoUseDecl(&t);
    sep(&t);
    repoFnDecl(&t);
    sep(&t);
    repoTypeDecl(&t);
    sep(&t);
    repoConstDecl(&t);
    sep(&t);
    repoLetDecl(&t);
    sep(&t);
    repoScriptBlock(&t);
    sep(&t);
    repoKeywords(&t);
    sep(&t);
    repoChars(&t);
    sep(&t);
    repoLabels(&t);
    sep(&t);
    repoTypes(&t);
    sep(&t);
    repoConstantsBool(&t);
    sep(&t);
    repoNumbers(&t);
    sep(&t);
    repoCalls(&t);
    sep(&t);
    repoMembers(&t);
    sep(&t);
    repoConstantsNamed(&t);
    sep(&t);
    repoVariables(&t);
    sep(&t);
    repoOperators(&t);
    sep(&t);
    repoPunctuation(&t);
    t.add("\n");
    t.add("  }\n");
    t.add("}\n");
    return t.str();
}

/// The spelling of keyword kind `k`, from `keywords.txt` (Rust `kw`, which panics on a missing kind).
fn kw(k: TokenKind, arena: &Arena): string {
    let names = keywordNames(arena);
    for i in 0..names.len {
        match kindOf(names[i]) {
            Option.Some(x) { if x == k { return names[i]; } }
            Option.None {}
        }
    }
    panic("keyword kind missing from keywords.txt");
    return "";
}

fn sep(t: &Text) { t.add(",\n"); }

fn field(t: &Text, indent: int, key: string, value: string) {
    pad(t, indent);
    t.add("\"").add(key).add("\": ");
    jsonString(t, value);
    t.add(",\n");
}

/// `{ "include": "#name" }` lines (Rust `includes_block` / `include_items`).
fn includes(t: &Text, indent: int, names: []string) {
    for i in 0..names.len {
        pad(t, indent);
        t.add("{ \"include\": \"#").add(names[i]).add("\" }");
        if i + 1 != names.len { t.add(","); }
        t.add("\n");
    }
}

fn pad(t: &Text, n: int) {
    for _ in 0..n { t.add("  "); }
}

/// `s` as a JSON string (Rust `json_string`: only `"`, `\`, `\n`, `\r`, `\t` escaped).
pub fn jsonString(t: &Text, s: string) {
    t.add("\"");
    for i in 0..s.len {
        let c = s[i];
        if c == '"' { t.add("\\\""); }
        else if c == '\\' { t.add("\\\\"); }
        else if c == '\n' { t.add("\\n"); }
        else if c == '\r' { t.add("\\r"); }
        else if c == '\t' { t.add("\\t"); }
        else { t.push(c); }
    }
    t.add("\"");
}

/// `s` with regex metacharacters backslashed, in `arena` (Rust `re_escape`).
pub fn reEscape(s: string, arena: &Arena): string {
    let t = Text.new(arena);
    addEscaped(&t, s);
    return t.str();
}

fn addEscaped(t: &Text, s: string) {
    let meta = ".+*?^$()[]{}|\\";
    for i in 0..s.len {
        for j in 0..meta.len {
            if meta[j] == s[i] { t.push('\\'); break; }
        }
        t.push(s[i]);
    }
}

/// `\b(?:a|b|...)\b` over `names`, escaped (Rust `word_alts`).
fn wordAlts(names: []string, arena: &Arena): string {
    let t = Text.new(arena);
    t.add("\\b(?:");
    for i in 0..names.len {
        if i > 0 { t.add("|"); }
        addEscaped(&t, names[i]);
    }
    t.add(")\\b");
    return t.str();
}

fn matchRule(t: &Text, indent: int, name: string, pat: string, comma: bool) {
    pad(t, indent);
    t.add("{\n");
    pad(t, indent + 1);
    t.add("\"name\": ");
    jsonString(t, name);
    t.add(",\n");
    pad(t, indent + 1);
    t.add("\"match\": ");
    jsonString(t, pat);
    t.add("\n");
    pad(t, indent);
    t.add("}");
    if comma { t.add(","); }
    t.add("\n");
}

/// A `match` + `captures` rule; `caps` is `[num, scope, num, scope, ...]`.
fn matchCaptures(t: &Text, indent: int, pat: string, caps: []string, comma: bool) {
    pad(t, indent);
    t.add("{\n");
    pad(t, indent + 1);
    t.add("\"match\": ");
    jsonString(t, pat);
    t.add(",\n");
    pad(t, indent + 1);
    t.add("\"captures\": {\n");
    let i = 0;
    while i + 1 < caps.len {
        pad(t, indent + 2);
        jsonString(t, caps[i]);
        t.add(": { \"name\": ");
        jsonString(t, caps[i + 1]);
        t.add(" }");
        if i + 2 != caps.len { t.add(","); }
        t.add("\n");
        i += 2;
    }
    pad(t, indent + 1);
    t.add("}\n");
    pad(t, indent);
    t.add("}");
    if comma { t.add(","); }
    t.add("\n");
}

/// The overloadable operators longest first (then byte order), escaped and joined by `|` (Rust `op_alts`).
fn opAlts(arena: &Arena): string {
    return altsOf(names(NameList.Overloadable), arena);
}

/// `ops` sorted longest first, then by bytes, escaped, joined by `|`, in `arena` (the input is not changed).
fn altsOf(ops: []string, arena: &Arena): string {
    let xs = arena.alloc::<string>(ops.len);
    for i in 0..ops.len { xs[i] = ops[i]; }
    sortBy(xs, fn(a: string, b: string): bool { return a.len > b.len || (a.len == b.len && a < b); });
    let t = Text.new(arena);
    for i in 0..xs.len {
        if i > 0 { t.add("|"); }
        addEscaped(&t, xs[i]);
    }
    return t.str();
}

/// Strings joined, in `arena` (Rust `format!` of pattern pieces).
fn cat(arena: &Arena, parts: []string): string {
    let t = Text.new(arena);
    for i in 0..parts.len { t.add(parts[i]); }
    return t.str();
}
