// `dump-ast`, `dump-ir`, `dump-bc`, `dump-glsl`, `dump-ui`, `dump-syntax`.
//
// Port of: j3c/src/cli/dump.rs, cli/glsl.rs, parse/syntax.rs (dump-syntax entry)
// J3: `dump-ast` (the parse oracle, plan 11 A5) is a pre-freeze Rust addition; see PORT_DEBT.md.
module j3c.cmd.dump;
// J3: C1 ports `dump-ast`; C2a `dump-ir` / `dump-llvm` (Rust `dispatch` + `dump_ir_*` / `dump_ll_*`, through the
// driver to `Stage.Passes`). `dump-ir samples` / `dump-llvm samples` print a not-supported line: the IR
// samples are a unit-test fixture (`tests/unit/ir_samples`). C4 ports `dump-bc` (Rust `dump_bc_path`: `Mode.Lib`
// = `analyze_path`, then `bc.emitScript` / `writeTo` / `dump`). The other dump commands print `not ported yet`
// from `cmd.args`. One Session per file (scale check A11: one Session for the whole corpus held 500 MB).

use j3.data.pool.Id;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.backend.bc;
use j3c.base.diag;
use j3c.base.fsx;
use j3c.base.intern.own;
use j3c.base.span.Source;
use j3c.cmd.check.{ collectJ3, err, failText, out, printFail };
use j3c.cmd.run.{ noFlags, peelRun };
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use j3c.ir.Program;
use j3c.syntax.ast.{ Ast, File };
use j3c.syntax.dump;
use j3c.syntax.fmt;
use j3c.syntax.parse;
use j3c.syntax.token.ParseError;

const DUMP_AST_USAGE = "usage: j3c dump-ast <file.j3|file.j3s|dir>\n";

/// `j3c dump-ast <file|dir>`: each file's AST as S-expressions (a dir: `;; path` before each). Every file
/// must also pass `fmt` (Rust `dump_ast`).
pub fn dumpAstCmd(rest: []string): int {
    if rest.len == 1 && (rest[0] == "--help" || rest[0] == "-h") {
        out(DUMP_AST_USAGE);
        out("  prints the parsed AST of each file as S-expressions (a dir: `;; path` before each)\n");
        return 0;
    }
    if rest.len != 1 || (rest[0].len > 0 && rest[0][0] == '-') {
        err(DUMP_AST_USAGE);
        return 1;
    }
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let files = List<string>.new(&mem);
    match collectJ3(rest[0], true, &mem) {
        Result.Ok(v) { files = v; }
        Result.Err(e) { err(Text.new(&mem).add("j3c: ").add(e).add("\n").str()); return 1; }
    }
    for fi in 0..files.len {
        if !dumpOne(files.items[fi], files.len > 1) { return 1; }
    }
    return 0;
}

/// `j3c dump-ir [path]` (Rust `dump_ir_path`): typecheck, run the IR passes, print the IR.
/// `j3c dump-bc FILE.j3s` (Rust `dump_bc_path`): the script alone, its `dump` text on stdout, and its `.j3sb`
/// written under the project root (else the file's folder).
pub fn dumpBcCmd(rest: []string): int {
    if rest.len == 0 {
        err("usage: j3c dump-bc <file.j3s>\n");
        return 1;
    }
    let p = rest[0];
    if p.len < 4 || p[p.len - 4..p.len] != ".j3s" {
        err("j3c dump-bc: expected a .j3s file\n");
        return 1;
    }
    // Rust `analyze_path`: check as a library (no `main`), no fast pass (a `.j3s` path is never a project).
    let opts = driver.defaults();
    opts.mode = Mode.Lib;
    opts.entry = p;
    opts.entryGiven = true;
    let s = Session.new(opts);
    defer s.free();
    if !driver.run(s, Stage.Passes) {
        printFail(failText(s), s.arena);
        return 1;
    }
    match s.program {
        Option.Some(prog) { return dumpBcProg(prog, p, s.arena); }
        Option.None { return 1; }
    }
}

/// The rest of `dumpBcCmd` on the checked program: find the script module of `p`, write its `.j3sb`, print it.
fn dumpBcProg(prog: &Program, p: string, arena: &Arena): int {
    let at = -1;
    for mi in 0..prog.modules.len {
        let m = &prog.modules.items[mi];
        for si in 0..m.structs.len {
            match prog.cx.structDef(m.structs.items[si]).script {
                Option.Some(meta) { if pathEndsWith(meta.path, p, arena) { at = mi; } }
                Option.None {}
            }
            if at >= 0 { break; }
        }
        if at >= 0 { break; }
    }
    if at < 0 {
        err(Text.new(arena).add("j3c dump-bc: no script module for ").add(p).add("\n").str());
        return 1;
    }
    match bc.emitScript(&prog.cx, &prog.modules.items[at], arena) {
        Result.Ok(m) {
            // Rust `project::resolve` takes a `.j3s` path as a file: the root is its folder (`Path::parent`).
            let root = "";
            for i in 0..p.len { if p[i] == '/' { root = path.dirname(p); break; } }
            match bc.writeTo(&m, root, arena) {
                Result.Ok(_) {}
                Result.Err(e) {
                    err(Text.new(arena).add("j3c dump-bc: ").add(e).add("\n").str());
                    return 1;
                }
            }
            let t = Text.new(arena);
            bc.dump(&m, &t);
            t.flushTo(1);
            return 0;
        }
        Result.Err(e) {
            err(Text.new(arena).add("j3c dump-bc: ").add(e).add("\n").str());
            return 1;
        }
    }
}

/// Rust `Path::ends_with`: the last components of `full` are those of `tail` (empty and `.` parts skipped).
/// ponytail: a leading `./` of either side is ignored, where Rust keeps it as a component.
fn pathEndsWith(full: string, tail: string, arena: &Arena): bool {
    let a = parts(full, arena);
    let b = parts(tail, arena);
    if b.len > a.len { return false; }
    for i in 0..b.len {
        if a.items[a.len - b.len + i] != b.items[i] { return false; }
    }
    return true;
}

fn parts(p: string, arena: &Arena): List<string> {
    let out = List<string>.new(arena);
    let start = 0;
    for i in 0..p.len + 1 {
        if i == p.len || p[i] == '/' {
            let c = p[start..i];
            if c.len > 0 && c != "." { out.push(c); }
            start = i + 1;
        }
    }
    return out;
}

pub fn dumpIrCmd(rest: []string): int { return dumpProgram(rest, false); }

/// `j3c dump-llvm [path]` (Rust `dump_ll_path`): the program's LLVM IR text.
pub fn dumpLlvmCmd(rest: []string): int { return dumpProgram(rest, true); }

/// Compile the path (none: the project in the cwd, else the built-in hello) through `Stage.Passes`, then print
/// the IR or the `.ll` (Rust `dispatch` with `peel_args`: `--release`, `--emit`, `--opt` reach the build
/// settings `dump-llvm` uses; `--fast` is refused).
fn dumpProgram(rest: []string, llvm: bool): int {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let f = noFlags(&mem);
    peelRun(rest, &f, false);
    if f.fast {
        err("j3c: `--fast` is only for `run` / `build`\n");
        return 1;
    }
    if f.path == "samples" {
        err("j3c: `samples` is not supported by j3c-boot: the IR samples are a unit-test fixture (tests/unit/ir_samples)\n");
        return 1;
    }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = f.path;
    opts.entryGiven = f.hasPath;
    opts.release = f.release;
    opts.emit = f.emit;
    opts.opt = f.opt;
    let s = Session.new(opts);
    defer s.free();
    if !driver.run(s, Stage.Passes) {
        // Rust: `dump-ir` prints the failure with `print_fail`, `dump-llvm` as `j3c: E`.
        if llvm {
            err(Text.new(s.arena).add("j3c: ").add(failText(s)).add("\n").str());
        } else {
            printFail(failText(s), s.arena);
        }
        return 1;
    }
    let t = Text.new(s.arena);
    if llvm {
        if !driver.emitLlvm(s, &t) {
            err(Text.new(s.arena).add("j3c: emit LLVM failed: ").add(failText(s)).add("\n").str());
            return 1;
        }
    } else {
        driver.dumpIr(s, &t);
    }
    t.flushTo(1);
    return 0;
}

/// Read, fmt-gate, parse and print one file; false after printing its error. Each file gets its own
/// Session, dropped after it is printed (Rust drops each file's AST too), so memory stays one file's worth.
fn dumpOne(file: string, many: bool): bool {
    let s = Session.new(driver.defaults());
    defer s.free();
    let src = "";
    match fsx.readText(file, s.arena) {
        Result.Ok(x) { src = x; }
        Result.Err(e) { err(Text.new(s.arena).add("j3c: ").add(e).add("\n").str()); return false; }
    }
    match fmt.format(src, s.arena) {
        Result.Ok(_) {}
        Result.Err(e) { err(Text.new(s.arena).add("j3c: fmt ").add(file).add(": ").add(e).add("\n").str()); return false; }
    }
    let ast = Ast.new(s.arena, &s.names);
    let id = s.sources.add(Source.of(own(s.arena, file), src, s.arena));
    match parseOne(file, src, id, &ast) {
        Result.Ok(f) {
            let t = Text.new(s.arena);
            if many { t.add(";; ").add(file).add("\n"); }
            dump.dumpAst(&ast, &f, &t);
            out(t.str());
            return true;
        }
        Result.Err(e) {
            parse.report(e, &s.diags);
            let t = Text.new(s.arena);
            diag.render(s.diags.at(s.diags.count() - 1), &s.sources, &t);
            err(t.str());
            return false;
        }
    }
}

/// A `.j3s` file parses as a script of module `script`, anything else as a `.j3` file.
fn parseOne(file: string, src: string, id: Id<Source>, ast: &Ast): Result<File, ParseError> {
    if path.ext(file) == ".j3s" {
        let script: [1]string = ["script"];
        return parse.parseScript(src, id, script, ast);
    }
    return parse.parseFile(src, id, ast);
}
