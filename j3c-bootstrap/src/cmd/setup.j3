// `j3c setup [--sdl-only]`: fetch the pinned toolchain and SDL kit into the cache (`toolchain/setup.j3`).
module j3c.cmd.setup;

use j3.memory.Arena;
use j3.sys;
use j3c.toolchain.setupRun;

const HELP: string = "usage: j3c setup [--sdl-only]\n  Downloads into the j3c cache (J3_CACHE, else XDG_CACHE_HOME/j3, ~/.cache/j3, %LOCALAPPDATA%\\j3):\n    toolchain/llvm-mingw-<ver>/  clang, lld, windres for a Windows host (skipped elsewhere and with --sdl-only)\n    sdl2-mingw/                  SDL2, SDL2_image, SDL2_ttf, SDL2_mixer mingw dev kits and dll/, for\n                                 `[emit] target = \"x86_64-pc-windows-gnu\"` builds\n  Every archive is checked against a sha256 pinned in j3c before it is unpacked. A second run with\n  everything present prints `up to date`. Needs curl and tar (unzip off Windows for the toolchain).\n";

/// `j3c setup ...`: the exit code.
pub fn setupCmd(rest: []string): int {
    let sdlOnly = false;
    for i in 0..rest.len {
        let a = rest[i];
        if a == "--help" || a == "-h" {
            let h = HELP;
            sys.write(1, h.ptr as ptr, h.len);
            return 0;
        }
        if a == "--sdl-only" {
            sdlOnly = true;
        } else {
            let m = "j3c setup: unknown argument (want --sdl-only)\n";
            sys.write(2, m.ptr as ptr, m.len);
            return 2;
        }
    }
    let arena = Arena.create(1 << 20);
    defer arena.destroy();
    return setupRun(sdlOnly, &arena);
}
