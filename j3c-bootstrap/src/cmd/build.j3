// `j3c build`: compile a project or file to its executable and print the path.
//
// Port of: j3c/src/cli/build.rs (the build path: `build_cwd`, `build_path`, `build_loaded`, `build_inner`,
//     `link_built`, `build_samples_err`)
// J3: Checks to `Stage.Passes`, prints warnings, then builds to `Stage.Link` (the driver writes `target/a.out` for a program with no
//     manifest). Shares `peelRun`, `printFail`, `printWarnings`, `refuseLib` and `noHello` with `cmd/run.j3`.
// J3: Not ported yet: `size_cmd`/`symbol_owners` (`j3c size`), the up-to-date shortcuts (`unchanged_project`,
//     `up_to_date`, `mark_built`, `inputs_key`: j3c-boot always rebuilds), multi-target builds (one thread
//     per `[emit] targets` entry), `[dist] build_outputs` packaging (`package`, `dist.rs`), and the
//     `compilation.log` line (`config::log_compile`).
module j3c.cmd.build;

use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;
use j3c.cmd.check.{ err, failText, out };
use j3c.cmd.run.{ noFlags, noHello, peelRun, printFail, printWarnings, refuseLib, sessionFor };
use j3c.driver;
use j3c.driver.Stage;
use j3c.project.manifest;
use j3c.project.manifest.Input;

/// `j3c build [flags] [path]` (Rust `dispatch(build_cwd, build_samples_err, build_path)`): exit code.
pub fn buildCmd(rest: []string): int {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let f = noFlags(&mem);
    peelRun(rest, &f, false);
    if f.path == "samples" {
        err("j3c: `build samples` is not a thing; use `run samples`\n");
        return 1;
    }
    let refused = refuseLib(f.path, "build", &mem);
    if refused != 0 { return refused; }
    // J3: `--host`/`--file` are `run` flags in Rust (`take_run_flags`); `build` keeps the manifest's targets.
    let r = if !f.hasPath { manifest.resolveCwd(&mem) } else { manifest.resolve(f.path, &mem) };
    match r {
        Result.Ok(inp) {
            match inp {
                Input.Project(m) {
                    if m.emit.targets.len > 1 {
                        err("j3c-boot: build: multi-target builds ([emit] targets) are not ported yet\n");
                        return 1;
                    }
                    if f.release && m.dist.outputs.len > 0 {
                        err("j3c-boot: build: [dist] build_outputs packaging is not ported yet\n");
                        return 1;
                    }
                }
                Input.Hello {}
                Input.File(_) {}
            }
        }
        Result.Err(_) {}
    }
    let s = sessionFor(&f, false);
    defer s.free();
    s.phases.begin("parse");
    if !noHello(s, f.hasPath) { return 1; }
    // Rust `run_loaded`/`build_loaded`: warnings once the check (through lower and validate) is clean,
    // before the backend and clang, so a failed link still shows them.
    if !driver.run(s, Stage.Passes) {
        printFail(failText(s), s.arena);
        return 1;
    }
    printWarnings(s);
    if !driver.run(s, Stage.Link) {
        printFail(failText(s), s.arena);
        return 1;
    }
    out(Text.new(s.arena).add(s.exe).add("\n").str());
    return 0;
}
