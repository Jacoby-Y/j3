// `dump-glsl [path] [--es]`: every `@shader(vs, fs)` program as the GLSL the compiler emitted.
//
// Port of: j3c/src/cli/glsl.rs
// J3: Reads `Checked.shaders` (filled by `shader.prepare` through sema) after a normal check of the input,
// through `driver` like `cmd/dump.j3`; `--es` is `shader.prepEs` on each stage's text.
module j3c.cmd.glsl;

use j3.memory.Arena;
use j3.option.Option;
use j3.text.{ Text, startsWith };
use j3c.cmd.check.{ err, failText, out };
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use j3c.shader.{ ATTR_INTS, prepEs };

const USAGE = "usage: j3c dump-glsl [path] [--es]";

/// Rust `dump_glsl`: usage and flag errors, then per program `// ===== MODULE.NAME (AT) =====`, the two
/// stages under `// ----- vertex -----` / `// ----- fragment -----`, the uniforms line and one line per
/// attribute. Exit 1 with `j3c dump-glsl: no `@shader(vs, fs)` in the program` when there is none.
pub fn dumpGlslCmd(rest: []string): int {
    let es = false;
    let path = "";
    let hasPath = false;
    for i in 0..rest.len {
        if rest[i] == "--help" || rest[i] == "-h" {
            out(USAGE);
            out("\n  prints each `const X = @shader(vs, fs);` program: vertex, fragment, uniforms, attributes\n");
            out("  --es   the text an OpenGL ES 3.0 driver gets (`#version 300 es`, precision lines), as `glsl.prep` makes it\n");
            return 0;
        }
    }
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    for i in 0..rest.len {
        let a = rest[i];
        if startsWith(a, "-") {
            if a != "--es" {
                err(Text.new(&mem).add("j3c dump-glsl: unknown flag `").add(a).add("`; ").add(USAGE).add("\n").str());
                return 1;
            }
            es = true;
        } else if !hasPath {
            path = a;
            hasPath = true;
        }
    }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = path;
    opts.entryGiven = hasPath;
    let s = Session.new(opts);
    defer s.free();
    if !driver.run(s, Stage.Sema) {
        err(Text.new(s.arena).add("j3c: ").add(failText(s)).add("\n").str());
        return 1;
    }
    let Option.Some(c) = s.checked else { return 1; };
    if c.shaders.len == 0 {
        err("j3c dump-glsl: no `@shader(vs, fs)` in the program\n");
        return 1;
    }
    let t = Text.new(s.arena);
    for i in 0..c.shaders.len {
        let p = c.shaders.items[i];
        t.add("// ===== ").add(p.moduleName).add(".").add(p.name).add(" (").add(p.at).add(") =====\n");
        t.add("// ----- vertex -----\n");
        if es { t.add(prepEs(p.vert, s.arena)); } else { t.add(p.vert); }
        t.add("// ----- fragment -----\n");
        if es { t.add(prepEs(p.frag, s.arena)); } else { t.add(p.frag); }
        t.add("// ----- uniforms: ");
        for k in 0..p.uniforms.len {
            if k > 0 { t.add(" "); }
            t.add(p.uniforms.items[k]);
        }
        t.add("\n");
        let k = 0;
        while k + ATTR_INTS <= p.attribs.len {
            let v = p.attribs.items[k..k + ATTR_INTS];
            t.add("// ----- attrib loc=");
            t.pushU64(u64(v[0]));
            t.add(" comps=");
            t.pushU64(u64(v[1]));
            t.add(" gltype=0x");
            t.pushHex(u64(v[2]));
            t.add(" offset=");
            t.pushU64(u64(v[3]));
            t.add(" stride=");
            t.pushU64(u64(v[4]));
            t.add(" divisor=");
            t.pushU64(u64(v[5]));
            t.add(" int=");
            t.pushU64(u64(v[6]));
            t.add("\n");
            k += ATTR_INTS;
        }
    }
    t.flushTo(1);
    return 0;
}
