// `dump-glsl [path] [--es]`: every `@shader(vs, fs)` program as the GLSL the compiler emitted.
//
// Port of: j3c/src/cli/glsl.rs
// J3: Reads `Checked.shaders` (filled by `shader.prepare` through sema) after a normal check of the input,
// through `driver` like `cmd/dump.j3`; `--es` is `shader.prepEs` on each stage's text.
module j3c.cmd.glsl;
// J3: Contract (wave 13): contracts-c2d.md, chunk B. Stub: the old "not ported yet" exit.

use j3.sys;

/// Rust `dump_glsl`: usage and flag errors, then per program `// ===== MODULE.NAME (AT) =====`, the two
/// stages under `// ----- vertex -----` / `// ----- fragment -----`, the uniforms line and one line per
/// attribute. Exit 1 with `j3c dump-glsl: no `@shader(vs, fs)` in the program` when there is none.
pub fn dumpGlslCmd(rest: []string): int {
    let msg = "j3c-boot: dump-glsl: not ported yet\n";
    sys.write(2, msg.ptr as ptr, msg.len);
    return 1;
}
