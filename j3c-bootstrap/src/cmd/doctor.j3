// `j3c doctor`: is this machine ready to build and run J3 programs? One table of checks, one line each, exit 1
// when a required one is missing. Each missing row names the one command that fixes it: the apt package on
// Linux, `fix` (`j3c setup`) where that is the fix. Linux libraries and fonts are not checked elsewhere.
//
// Port of: j3c/src/doctor.rs
// J3: The check table is data (`CHECKS`), in Rust's order. ponytail: a tool that ends by a signal prints
// `exit status: 128+N` (`j3.proc` folds the signal into the code) where Rust prints `signal: N (SIGx)`.
module j3c.cmd.doctor;

use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.text.{ Text, lines, trim };
use j3c.base.fsx;
use j3c.editor.frontend;
use j3c.project.config.j3cBuild;
use j3c.project.manifest.parseManifest;
use j3c.toolchain.{ ClangPick, findClang, hostLibPresent, mingwSdlLibs, mingwSdlRoot, windowsTarget };

/// How a check looks (Rust `Probe`).
enum Probe {
    /// A program on PATH; the first line of `<it> --version` is the detail.
    Tool,
    /// A shared library the linker can find (`[link] libs` name).
    Lib,
    File,
    CacheWritable,
    /// `toolchain.findClang`: which clang won and why, its version and `-dumpmachine`.
    Clang,
    /// The mingw SDL kit in `<cacheRoot>/sdl2-mingw` (Windows builds).
    MingwSdl,
}

pub struct Check {
    what: string;
    /// The tool, library or file the probe looks for.
    arg: string;
    /// Debian/Ubuntu package (Linux fix, and the all-at-once line).
    apt: string;
    /// The fix where it is not an apt package (every OS when `apt` is empty, else non-Linux); "" = none.
    fix: string;
    probe: Probe;
    /// Required on Linux / on Windows.
    required: bool;
    requiredWin: bool;
    /// Checked only on a Linux host (host libraries, fonts, `ld`).
    linuxOnly: bool;
}

const N: int = 14; // `checks().len`

fn checks(): [14]Check {
    return [
        Check { what: "clang (compiles and links every program)", arg: "clang", apt: "clang", fix: "j3c setup", probe: Probe.Clang,
            required: true, requiredWin: true, linuxOnly: false },
        Check { what: "ld (linker clang calls)", arg: "ld", apt: "binutils", fix: "", probe: Probe.Tool, required: true, requiredWin: false, linuxOnly: true },
        Check { what: "SDL2 (windows, input, audio)", arg: "SDL2", apt: "libsdl2-2.0-0", fix: "", probe: Probe.Lib, required: true, requiredWin: false, linuxOnly: true },
        Check { what: "libGL (3D, .j3ui, paint)", arg: "GL", apt: "libgl1", fix: "", probe: Probe.Lib, required: true, requiredWin: false, linuxOnly: true },
        Check { what: "SDL2_ttf (text)", arg: "SDL2_ttf", apt: "libsdl2-ttf-2.0-0", fix: "", probe: Probe.Lib, required: false, requiredWin: false, linuxOnly: true },
        Check { what: "SDL2_image (loadTexture)", arg: "SDL2_image", apt: "libsdl2-image-2.0-0", fix: "", probe: Probe.Lib, required: false, requiredWin: false,
            linuxOnly: true },
        Check { what: "SDL2_mixer (sounds, music)", arg: "SDL2_mixer", apt: "libsdl2-mixer-2.0-0", fix: "", probe: Probe.Lib, required: false, requiredWin: false,
            linuxOnly: true },
        Check { what: "DejaVu Sans (editor UI font; J3_EDITOR_FONT overrides)", arg: "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            apt: "fonts-dejavu-core", fix: "", probe: Probe.File, required: false, requiredWin: false, linuxOnly: true },
        Check { what: "Noto Color Emoji (emoji fallback in text)", arg: "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf",
            apt: "fonts-noto-color-emoji", fix: "", probe: Probe.File, required: false, requiredWin: false, linuxOnly: true },
        Check { what: "cache folder writable (editor, incremental builds, j3c setup)", arg: "", apt: "", fix: "set J3_CACHE to a writable folder",
            probe: Probe.CacheWritable, required: true, requiredWin: true, linuxOnly: false },
        Check { what: "mingw SDL kit (Windows builds and Windows-target games)", arg: "", apt: "", fix: "j3c setup --sdl-only", probe: Probe.MingwSdl,
            required: false, requiredWin: true, linuxOnly: false },
        Check { what: "git (git dependencies: j3c add / fetch)", arg: "git", apt: "git", fix: "install Git for Windows: winget install Git.Git",
            probe: Probe.Tool, required: false, requiredWin: false, linuxOnly: false },
        Check { what: "curl (j3c setup downloads)", arg: "curl", apt: "curl", fix: "in Windows 10 1803 and later: update Windows", probe: Probe.Tool, required: false, requiredWin: true, linuxOnly: false },
        Check { what: "tar (j3c setup unpacks)", arg: "tar", apt: "tar", fix: "in Windows 10 1803 and later: update Windows", probe: Probe.Tool, required: false, requiredWin: true, linuxOnly: false }
    ];
}

/// `j3c doctor ...`: the exit code (Rust `cmd`; arguments are ignored).
pub fn doctorCmd(rest: []string): int {
    let arena = Arena.create(1 << 16);
    defer arena.destroy();
    let a = &arena;
    let t = Text.new(a);
    t.add("j3c ").add(j3cBuild()).add(" doctor\n");
    let linux = sys.PLATFORM == sys.PLATFORM_LINUX;
    let windows = sys.PLATFORM == sys.PLATFORM_WINDOWS;
    if !linux { t.add("note: Linux libraries, fonts and packages are not checked on this OS\n"); }
    let missingRequired = false;
    let apt = List<string>.new(a);
    let cs = checks();
    for i in 0..N {
        let c = cs[i];
        if c.linuxOnly && !linux {
            t.add("  skip     ").add(c.what).add("\n");
            continue;
        }
        let required = if windows { c.requiredWin } else { c.required };
        match probe(&c, a) {
            Result.Ok(detail) {
                t.add("  ok       ").add(c.what);
                if detail.len > 0 { t.add(": ").add(detail); }
                t.add("\n");
            }
            Result.Err(why) {
                t.add("  ").add(if required { "MISSING " } else { "optional" }).add(" ").add(c.what).add(": ").add(why);
                if c.apt.len > 0 && linux {
                    t.add(" (sudo apt install ").add(c.apt).add(")");
                    apt.push(c.apt);
                } else if c.fix.len > 0 {
                    t.add(" (").add(c.fix).add(")");
                }
                t.add("\n");
                if required { missingRequired = true; }
            }
        }
    }
    mingwLine(&t, a);
    if apt.len > 0 && linux {
        t.add("all at once (Debian/Ubuntu): sudo apt install");
        for i in 0..apt.len { t.add(" ").add(apt.items[i]); }
        t.add("\n");
    }
    t.add(if missingRequired { "not ready: a required item is missing\n" } else { "ready\n" });
    let s = t.str();
    sys.write(1, s.ptr as ptr, s.len);
    return if missingRequired { 1 } else { 0 };
}

/// `./j3.toml` with a Windows `[emit] target`: are the mingw SDL libs in `mingwSdlRoot`? Optional.
fn mingwLine(t: &Text, a: &Arena) {
    let src = "";
    match io.readFile("j3.toml", a) {
        Result.Ok(b) { src = b as string; }
        Result.Err(_) { return; }
    }
    match parseManifest(src, ".", a) {
        Result.Ok(m) {
            for i in 0..m.emit.targets.len {
                let tr = m.emit.targets.items[i];
                if !windowsTarget(tr) { continue; }
                let what = Text.new(a).add("mingw SDL libs for ").add(tr).add(" (this project's Windows target)").str();
                if mingwSdlLibs(tr, a).len > 0 {
                    t.add("  ok       ").add(what).add("\n");
                } else {
                    t.add("  optional ").add(what).add(": none in ").add(mingwSdlRoot(a)).add(" (j3c setup --sdl-only)\n");
                }
            }
        }
        Result.Err(_) {}
    }
}

fn probe(c: &Check, a: &Arena): Result<string, string> {
    match c.probe {
        Probe.Tool {
            let argv: [2]string = [c.arg, "--version"];
            match proc.run(argv[..], "", a) {
                Result.Ok(o) {
                    if o.code == 0 {
                        for l in lines(o.outStr()) { return Result.Ok(trim(l)); }
                        return Result.Ok("");
                    }
                    let m = Text.new(a);
                    m.add("`").add(c.arg).add(" --version` exited exit status: ");
                    m.pushInt(o.code);
                    return Result.Err(m.str());
                }
                Result.Err(_) { return Result.Err("not on PATH"); }
            }
        }
        Probe.Lib {
            let none = List<string>.new(a);
            if hostLibPresent(c.arg, &none) { return Result.Ok(""); }
            return Result.Err("not found");
        }
        Probe.File {
            if fsx.isFile(c.arg) { return Result.Ok(""); }
            return Result.Err(Text.new(a).add("no ").add(c.arg).str());
        }
        Probe.Clang {
            match findClang(a) {
                Option.Some(p) { return clangDetail(&p, a); }
                Option.None { return Result.Err("none in J3_CLANG, the j3c setup toolchain, or PATH"); }
            }
        }
        Probe.MingwSdl {
            if mingwSdlLibs("x86_64-pc-windows-gnu", a).len > 0 { return Result.Ok(mingwSdlRoot(a)); }
            let root = mingwSdlRoot(a);
            return Result.Err(Text.new(a).add("none in ").add(if root.len > 0 { root } else { "(no cache folder)" }).str());
        }
        Probe.CacheWritable {
            let dir = "";
            match frontend.cacheRoot(a) {
                Option.Some(d) { dir = d; }
                Option.None { return Result.Err("no J3_CACHE, XDG_CACHE_HOME, HOME or LOCALAPPDATA"); }
            }
            match fsx.makeDirs(dir, a) {
                Result.Ok(_) {}
                Result.Err(e) { return Result.Err(Text.new(a).add(dir).add(": ").add(e).str()); }
            }
            let p = path.join(dir, Text.new(a).fmt(`.doctor-{sys.getpid()}`).str(), a);
            match fsx.writeFile(p, "" as []u8, a) {
                Result.Ok(_) {}
                Result.Err(e) { return Result.Err(Text.new(a).add(dir).add(": ").add(e).str()); }
            }
            io.remove(p);
            return Result.Ok(dir);
        }
    }
}

/// `<file> (<source>), <first line of --version>, targets <-dumpmachine>`; Err when it does not run.
fn clangDetail(p: &ClangPick, a: &Arena): Result<string, string> {
    let t = Text.new(a).add(p.file).add(" (").add(p.source).add(")");
    let v: [2]string = [p.cmd, "--version"];
    match proc.run(v[..], "", a) {
        Result.Ok(o) {
            if o.code != 0 { return Result.Err(t.add(": `--version` failed").str()); }
            for l in lines(o.outStr()) {
                t.add(", ").add(trim(l));
                break;
            }
        }
        Result.Err(_) { return Result.Err(t.add(": does not start").str()); }
    }
    let d: [2]string = [p.cmd, "-dumpmachine"];
    match proc.run(d[..], "", a) {
        Result.Ok(o) { if o.code == 0 { t.add(", targets ").add(trim(o.outStr())); } }
        Result.Err(_) {}
    }
    return Result.Ok(t.str());
}
