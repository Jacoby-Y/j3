/// One `j3c doc recipes NAME`: prose, then every file of a program that checks (Rust `helptext::Recipe`).
pub struct Recipe {
    /// Project-relative path and contents; a unit test writes them out and runs `check`.
    files: List<FileText>;
    name: string;
    what: string;
    text: string;
}

/// `j3c help [manifest]`, also no argument at all (exit 0): Rust `help_cmd` / `print_help`.
pub fn helpCmd(rest: []string): int {
    if rest.len == 0 {
        let mem = Arena.create(1 << 13);
        defer mem.destroy();
        let t = Text.new(&mem);
        out(replace(&t, HELP, "@VERSION@", j3cSemver()));
        return 0;
    }
    if rest[0] == "manifest" {
        out(MANIFEST);
        return 0;
    }
    let mem = Arena.create(1 << 10);
    defer mem.destroy();
    err(Text.new(&mem).add("j3c: unknown help topic `").add(rest[0]).add("`\n  = help: `j3c help` or `j3c help manifest`\n").str());
    return 1;
}

/// `j3c explain E0042` (or `42`): the error code's title and long text from `text/errors.txt`.
pub fn explainCmd(rest: []string): int {
    if rest.len != 1 {
        err("usage: j3c explain E0042  (the code an `error[E0042]:` line shows)\n");
        return 1;
    }
    let a = rest[0];
    let i = 0;
    if a.len > 0 && (a[0] == 'E' || a[0] == 'e') { i = 1; }
    let code: u32 = 0;
    let ok = i < a.len;
    while i < a.len {
        if a[i] < '0' || a[i] > '9' { ok = false; break; }
        code = code * 10 + u32(a[i] - '0');
        i += 1;
    }
    let t = diag.title(code);
    if !ok || t == "" {
        let mem = Arena.create(1 << 10);
        defer mem.destroy();
        err(Text.new(&mem).add("j3c: no error code `").add(a).add("`\n").str());
        return 1;
    }
    let mem = Arena.create(1 << 14);
    defer mem.destroy();
    let o = Text.new(&mem);
    o.add(a).add(": ").add(t).add("\n");
    diag.explainTo(code, &o);
    out(o.str());
    return 0;
}

/// `j3c guide`: `helptext::GUIDE`.
pub fn guideCmd(rest: []string): int {
    out(GUIDE);
    return 0;
}

/// `helptext::MANIFEST` (`j3c manifest` without `--json`, `j3c help manifest`); static text.
pub fn manifestText(): string { return MANIFEST; }

/// A `j3.toml` with `[package] name` and `entry = "src/main.j3"` only.
fn plainToml(name: string, arena: &Arena): string {
    return Text.new(arena).add("[package]\nname = \"").add(name).add("\"\nentry = \"src/main.j3\"\n").str();
}

/// `PAINT_TOML` renamed to `name`; `noTtf` drops the SDL2_ttf library.
fn paintToml(name: string, noTtf: bool, arena: &Arena): string {
    let a = Text.new(arena);
    let s = replace(&a, PAINT_TOML, "painted", name);
    if !noTtf { return s; }
    let b = Text.new(arena);
    return replace(&b, s, ", \"SDL2_ttf\"", "");
}

fn f(p: string, text: string): FileText { return FileText { path: p, text: text }; }

/// A recipe whose files are `j3.toml` and `src/main.j3`.
fn two(l: &List<Recipe>, name: string, what: string, text: string, toml: string, main: string, arena: &Arena) {
    let files = List<FileText>.new(arena);
    files.push(f("j3.toml", toml));
    files.push(f("src/main.j3", main));
    l.push(Recipe { files: files, name: name, what: what, text: text });
}

fn one(l: &List<Recipe>, name: string, what: string, text: string, files: List<FileText>) {
    l.push(Recipe { files: files, name: name, what: what, text: text });
}

/// Every recipe, in Rust's order (22). → DOC (`doc recipes`, search hits).
pub fn recipes(arena: &Arena): List<Recipe> {
    let l = List<Recipe>.new(arena);
    let appMain = match fmt.format(new.appMain("mygame", arena), arena) {
        Result.Ok(s) { s }
        Result.Err(_) { "" }
    };
    two(&l, "app2d", "a window, a game loop, keys, and 2D drawing", R_APP2D, new.appToml("mygame", arena), appMain, arena);
    one(&l, "scene3d", "load an editor scene, run its scripts, and draw it lit and shadowed", R_SCENE3D, new.projectFiles("mygame", false, arena));
    two(&l, "canvas", "draw a sprite in code and save it as a PNG, no window", R_CANVAS, plainToml("sprites", arena), CANVAS_MAIN, arena);
    two(&l, "paint", "batched 2D shapes, text, clip, and transforms with j3.gfx.paint", R_PAINT, PAINT_TOML, PAINT_MAIN, arena);
    two(&l, "audio", "a PCM output stream: a sine tone queued per frame, playhead from queued()", R_AUDIO, paintToml("tone", true, arena), AUDIO_MAIN, arena);
    two(&l, "display", "a Video settings page: window mode, resolution, monitor, vsync, frame cap, saved", R_DISPLAY, paintToml("videomenu", false, arena), DISPLAY_MAIN, arena);
    two(&l, "hotkey", "a global hotkey: F8 toggles pause while another app has focus (Linux X11)", R_HOTKEY, paintToml("recorder", true, arena), HOTKEY_MAIN, arena);
    two(&l, "watch", "notice files changed outside the app (a folder and a file)", R_WATCH, paintToml("watcher", true, arena), WATCH_MAIN, arena);
    two(&l, "paste", "Ctrl+V pastes an image, GIF, or file list from the clipboard (clipboardTypes/clipboardData)", R_PASTE, paintToml("paster", true, arena), PASTE_MAIN, arena);
    two(&l, "dragout", "drag a file out of the window into Discord, a browser, or a file manager (dragFiles, Linux X11)", R_DRAGOUT, paintToml("dragger", true, arena), DRAGOUT_MAIN, arena);
    one(&l, "components", "a `.j3ui` window: a component with a canvas and a button, styled with CSS", R_COMPONENTS, new.componentsFiles("mygame", arena));
    let ansi = List<FileText>.new(arena);
    ansi.push(f("j3.toml", new.componentsToml()));
    ansi.push(f("ui/Screen.j3ui", ANSI_SCREEN));
    ansi.push(f("ui/theme.css", new.componentsTheme()));
    ansi.push(f("src/main.j3", ANSI_MAIN));
    one(&l, "ansi", "colored process or build output in a `.j3ui` pane: AnsiLog turns escapes into styled spans", R_ANSI, ansi);
    two(&l, "tui", "a full-screen terminal program: Screen.open, draw a box and text, poll keys, q quits", R_TUI, plainToml("tuidemo", arena), TUI_MAIN, arena);
    two(&l, "pty", "run `ls --color=always` in a pty, read until eof, feed a Grid, print the screen as text", R_PTY, plainToml("ptydemo", arena), PTY_MAIN, arena);
    let script = List<FileText>.new(arena);
    script.push(f("j3.toml", plainToml("counters", arena)));
    script.push(f("scripts/counter.j3s", SCRIPT_COUNTER));
    script.push(f("src/main.j3", SCRIPT_MAIN));
    one(&l, "script", "a `.j3s` script with props, shared and per-instance state, made from J3", R_SCRIPT, script);
    let j2 = List<FileText>.new(arena);
    j2.push(f("j3.toml", plainToml("modhost", arena)));
    j2.push(f("mods/hello.j2", J2_HELLO));
    j2.push(f("src/main.j3", J2_MAIN));
    one(&l, "j2", "load a j2 mod at runtime: bind a native, call its fn, read a field, show an error", R_J2, j2);
    let mesh = List<FileText>.new(arena);
    mesh.push(f("assets/gen/tree.j3", new.treeGen()));
    one(&l, "meshgen", "build a mesh in code for an editor project", R_MESHGEN, mesh);
    two(&l, "threads", "build chunks on a worker pool and accept only current results, no window", R_THREADS, plainToml("chunks", arena), THREADS_MAIN, arena);
    two(&l, "config", "read settings.toml with defaults, change a value, save it back (j3.data.toml)", R_CONFIG, plainToml("settings", arena), CONFIG_MAIN, arena);
    two(&l, "http", "call a web API on a worker thread: JSON body, https, reply read on the frame loop", R_HTTP, plainToml("webcall", arena), HTTP_MAIN, arena);
    one(&l, "material", "a `.j3mat` material with a `.j3fx` shader effect", R_MATERIAL, List<FileText>.new(arena));
    one(&l, "urp", "traced mirrors, glass, and sun shadows", R_URP, List<FileText>.new(arena));
    one(&l, "check", "the edit, check, look, play loop and what each step catches", R_CHECK, List<FileText>.new(arena));
    return l;
}

/// Rust `recipe_index`: the `j3c doc recipes` text. → DOC
pub fn recipeIndex(arena: &Arena): string {
    let t = Text.new(arena).add("recipes (`j3c doc recipes <name>`):\n\n");
    let all = recipes(arena);
    for i in 0..all.len {
        let r = all.items[i];
        // `{:<9}`: names are ASCII
        t.add("    ").add(r.name);
        for k in r.name.len..9 { t.add(" "); }
        t.add(" ").add(r.what).add("\n");
    }
    t.add("\nEach prints the files of a whole program; write them into an empty directory and run `j3c check`.\n");
    return t.str();
}

/// Rust `recipe`: one recipe's page and files; Err = `no recipe `X`` with its `= help:` line. → DOC
pub fn recipe(name: string, arena: &Arena): Result<string, string> {
    let all = recipes(arena);
    for i in 0..all.len {
        let r = all.items[i];
        if r.name != name { continue; }
        let t = Text.new(arena).add("recipe ").add(r.name).add(": ").add(r.what).add("\n\n").add(r.text);
        for k in 0..r.files.len {
            let x = r.files.items[k];
            t.add("\n==> ").add(x.path).add(" <==\n").add(x.text);
            if !endsWith(x.text, "\n") { t.add("\n"); }
        }
        return Result.Ok(t.str());
    }
    let t = Text.new(arena).add("no recipe `").add(name).add("`\n  = help: one of ");
    for i in 0..all.len {
        if i > 0 { t.add(", "); }
        t.add(all.items[i].name);
    }
    return Result.Err(t.str());
}
