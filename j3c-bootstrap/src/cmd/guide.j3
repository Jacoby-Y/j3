// `j3c help`, `j3c guide`, `j3c help manifest` / plain `j3c manifest`, the recipes `j3c doc recipes` prints.
//
// Port of: j3c/src/helptext/mod.rs, (cli/mod.rs `print_help`, `help_cmd`, the `guide` arm)
// J3: `guide.md`, `manifest.md` and the recipe pages stay `@embed`ded from their `j3c/src/helptext/` paths until
// C6 (`git mv`); text that is Rust code today (`print_help`) moves to `text/help/` with `@NAME@` placeholders.
// J3: `explain` (plan 11 B10, the error-code list `text/errors.txt`) has no Rust command yet: not ported.
module j3c.cmd.guide;

use j3.memory.{ Arena, List };
use j3.result.Result;
use j3c.base.diag;
use j3c.cmd.new.FileText;

/// One `j3c doc recipes NAME`: prose, then every file of a program that checks (Rust `helptext::Recipe`).
pub struct Recipe {
    /// Project-relative path and contents; a unit test writes them out and runs `check`.
    files: List<FileText>;
    name: string;
    what: string;
    text: string;
}

/// `j3c help [manifest]`, also no argument at all (exit 0): Rust `help_cmd` / `print_help`.
pub fn helpCmd(rest: []string): int { return diag.notPortedCmd("help"); } // STUB NEW

/// `j3c guide`: `helptext::GUIDE`.
pub fn guideCmd(rest: []string): int { return diag.notPortedCmd("guide"); } // STUB NEW

/// `helptext::MANIFEST` (`j3c manifest` without `--json`, `j3c help manifest`); static text.
pub fn manifestText(): string { return ""; } // STUB NEW

/// Every recipe, in Rust's order (22). → DOC (`doc recipes`, search hits).
pub fn recipes(arena: &Arena): List<Recipe> { return List<Recipe>.new(arena); } // STUB NEW

/// Rust `recipe_index`: the `j3c doc recipes` text. → DOC
pub fn recipeIndex(arena: &Arena): string { return ""; } // STUB NEW

/// Rust `recipe`: one recipe's page and files; Err = `no recipe `X`` with its `= help:` line. → DOC
pub fn recipe(name: string, arena: &Arena): Result<string, string> { return Result.Err("recipes: not ported yet"); } // STUB NEW
