// `j3c help`, `j3c guide`, `j3c help manifest` / plain `j3c manifest`, the recipes `j3c doc recipes` prints.
//
// Port of: j3c/src/helptext/mod.rs, (cli/mod.rs `print_help`, `help_cmd`, the `guide` arm)
// J3: `guide.md`, `manifest.md` and the recipe pages stay `@embed`ded from their `j3c/src/helptext/` paths until
// C6 (`git mv`); text that is Rust code today (`print_help`) moves to `text/help/` with `@NAME@` placeholders.
// J3: `explain` (plan 11 B10) prints an entry of `text/errors.txt` through `base/diag.explain`.
// J3: The recipe table is data built per call (as Rust's `recipes()`); files that need a module name or `fmt`
//     come from `cmd/new` (`appMain`, `projectFiles`, `componentsFiles`).
module j3c.cmd.guide;

use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text.{ Text, endsWith, replace };
use j3c.base.diag;
use j3c.cmd.check.{ err, out };
use j3c.cmd.new;
use j3c.cmd.new.FileText;
use j3c.project.config.j3cSemver;
use j3c.syntax.fmt;

const HELP = @embed("../../text/help/help.txt.in");
const GUIDE = @embed("../../text/helptext/guide.md");
const MANIFEST = @embed("../../text/helptext/manifest.md");

const R_APP2D = @embed("../../text/helptext/recipes/app2d.md");
const R_SCENE3D = @embed("../../text/helptext/recipes/scene3d.md");
const R_CANVAS = @embed("../../text/helptext/recipes/canvas.md");
const CANVAS_MAIN = @embed("../../text/helptext/recipes/canvas_main.j3");
const R_PAINT = @embed("../../text/helptext/recipes/paint.md");
const PAINT_TOML = @embed("../../text/helptext/recipes/paint.toml");
const PAINT_MAIN = @embed("../../text/helptext/recipes/paint_main.j3");
const R_AUDIO = @embed("../../text/helptext/recipes/audio.md");
const AUDIO_MAIN = @embed("../../text/helptext/recipes/audio_main.j3");
const R_DISPLAY = @embed("../../text/helptext/recipes/display.md");
const DISPLAY_MAIN = @embed("../../text/helptext/recipes/display_main.j3");
const R_HOTKEY = @embed("../../text/helptext/recipes/hotkey.md");
const HOTKEY_MAIN = @embed("../../text/helptext/recipes/hotkey_main.j3");
const R_WATCH = @embed("../../text/helptext/recipes/watch.md");
const WATCH_MAIN = @embed("../../text/helptext/recipes/watch_main.j3");
const R_PASTE = @embed("../../text/helptext/recipes/paste.md");
const PASTE_MAIN = @embed("../../text/helptext/recipes/paste_main.j3");
const R_DRAGOUT = @embed("../../text/helptext/recipes/dragout.md");
const DRAGOUT_MAIN = @embed("../../text/helptext/recipes/dragout_main.j3");
const R_COMPONENTS = @embed("../../text/helptext/recipes/components.md");
const R_ANSI = @embed("../../text/helptext/recipes/ansi.md");
const ANSI_SCREEN = @embed("../../text/helptext/recipes/ansi_Screen.j3ui");
const ANSI_MAIN = @embed("../../text/helptext/recipes/ansi_main.j3");
const R_CONFIG = @embed("../../text/helptext/recipes/config.md");
const CONFIG_MAIN = @embed("../../text/helptext/recipes/config_main.j3");
const R_TUI = @embed("../../text/helptext/recipes/tui.md");
const TUI_MAIN = @embed("../../text/helptext/recipes/tui_main.j3");
const R_PTY = @embed("../../text/helptext/recipes/pty.md");
const PTY_MAIN = @embed("../../text/helptext/recipes/pty_main.j3");
const R_SCRIPT = @embed("../../text/helptext/recipes/script.md");
const SCRIPT_COUNTER = @embed("../../text/helptext/recipes/script_counter.j3s");
const SCRIPT_MAIN = @embed("../../text/helptext/recipes/script_main.j3");
