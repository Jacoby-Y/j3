// `j3c -e gen`: run mesh generator scripts.
//
// Port of: j3c/src/gen.rs
module j3c.cmd.gen;

use j3.memory.{ Arena, List };
use j3c.base.diag;

/// What one `runAll` did (Rust `gen::Report`).
pub struct GenReport {
    /// Meshes written this time.
    made: List<string>;
    /// One message per script that failed, with its compiler or runtime output.
    failed: List<string>;
    /// Scripts in `assets/gen/`.
    scripts: int;
}

/// `j3c -e gen [--force] [--project DIR]`: Rust `gen::cmd`.
pub fn genCmd(rest: []string): int { return diag.notPortedCmd("-e gen"); } // STUB IMG

/// Rust `gen::run_all`: run every stale (or, `force`, every) `assets/gen/*.j3` under `root`, sorted. → MCP (`gen` tool),
/// EDDEV (`editor` start)
pub fn runAll(root: string, force: bool, arena: &Arena): GenReport {
    return GenReport { made: List<string>.new(arena), failed: List<string>.new(arena), scripts: 0 };
} // STUB IMG

/// Rust `gen::before_build`: run the project's stale `assets/gen/*.j3` generators before a build (not under
/// `J3_GEN_RUNNING`, so a generator's own build does not recurse).
// J3: A no-op until C5 (PORT_DEBT.md): a project whose generated meshes are not on disk builds without them.
pub fn beforeBuild(root: string) {} // STUB IMG
