// `j3c version [--verbose]` and `j3c manifest --json [path]`.
//
// Port of: j3c/src/cli/mod.rs (`version`, `print_provenance`, `manifest_cmd`)
// J3: `manifest` without `--json` prints the help page (`cmd/guide.manifestText`).
// J3: `version --verbose` differs from Rust on two lines: `docs` (`doc.docsId` hashes this binary's embedded
//     stdlib and pages; Rust's hashes its own doc and help sources, `stdlib::docs_id`) and `binary` (this binary's path).
// J3: Must not `use j3c.cmd.args` (it imports this module). `cmd/guide` and `doc` must not use this module.
module j3c.cmd.info;

use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.text.{ Text, find, startsWith };
use j3c.base.fsx;
use j3c.base.toml;
use j3c.cmd.check.{ err, out };
use j3c.cmd.guide;
use j3c.doc;
use j3c.project.config.j3cBuild;
use j3c.project.manifest.findTomlUp;

/// `j3c version` / `--version` / `-V` (`--verbose` / `-v` adds the build and stdlib provenance): exit code.
pub fn versionCmd(rest: []string): int {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let t = Text.new(&mem);
    versionText(rest, &t, &mem);
    out(t.str());
    return 0;
}

/// What `versionCmd` prints.
pub fn versionText(rest: []string, t: &Text, arena: &Arena) {
    t.add("j3c ").add(j3cBuild()).add("\n");
    let verbose = false;
    for i in 0..rest.len {
        if rest[i] == "--verbose" || rest[i] == "-v" { verbose = true; }
    }
    if !verbose { return; }
    // Rust `print_provenance`.
    t.add("docs     ").add(doc.docsId(arena)).add(" (`j3c doc` prints the same id; another id means other docs)\n");
    from(t, "stdlib   ", "J3_STDLIB");
    from(t, "editor   ", "J3_EDITOR_SRC");
    match path.exePath(arena) {
        Option.Some(p) { t.add("binary   ").add(p).add("\n"); }
        Option.None { t.add("binary   unknown (").add(fsx.osError(sys.errno(), arena)).add(")\n"); }
    }
}

/// `LABEL VAR=value`, or that the sources are embedded when `VAR` is unset or empty.
fn from(t: &Text, label: string, name: string) {
    let v = sys.env(name);
    t.add(label);
    if v.len > 0 { t.add(name).add("=").add(v).add("\n"); } else { t.add("embedded in this binary\n"); }
}

/// `j3c manifest [--json [path]]` (Rust `manifest_cmd`; the JSON is `base/toml/json.j3`): exit code.
pub fn manifestCmd(rest: []string): int {
    let json = false;
    let paths = 0;
    let dashed = false;
    let p = ".";
    for i in 0..rest.len {
        if rest[i] == "--json" { json = true; continue; }
        if paths == 0 { p = rest[i]; }
        paths += 1;
        if startsWith(rest[i], "-") { dashed = true; }
    }
    if !json || paths > 1 || dashed {
        if json || paths > 0 {
            err("usage: j3c manifest [--json [path]]\n");
            return 1;
        }
        out(guide.manifestText());
        return 0;
    }
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    match manifestJson(p, &mem) {
        Result.Ok(j) {
            out(Text.new(&mem).add(j).add("\n").str());
            return 0;
        }
        Result.Err(e) {
            err(Text.new(&mem).add("j3c manifest: ").add(e).add("\n").str());
            return 1;
        }
    }
}

/// The `j3.toml` found from `p` (a `j3.toml`, or the nearest one at or above `p`) as one line of JSON.
/// Err: Rust's message without its `j3c manifest: ` head.
pub fn manifestJson(p: string, arena: &Arena): Result<string, string> {
    // Rust `cwd.join(p)`: an absolute `p` stands alone; the text is kept as typed for the message (`/tmp/.`).
    let start = p;
    if !path.isAbs(p) {
        let cwd = match path.realpath(".", arena) {
            Option.Some(c) { c }
            Option.None { "" }
        };
        start = Text.new(arena).add(cwd).add(if cwd == "/" { "" } else { "/" }).add(p).str();
    }
    let none = Text.new(arena).add("no j3.toml at or above ").add(start).str();
    let clean = path.normalize(start, arena);
    let file = clean;
    if path.basename(clean) != "j3.toml" {
        match findTomlUp(clean, arena) {
            Option.Some(t) { file = t; }
            Option.None { return Result.Err(none); }
        }
    }
    if !fsx.isFile(file) { return Result.Err(none); }
    let text = fsx.readText(file, arena)?;
    match toml.json(text, arena) {
        Result.Ok(j) { return Result.Ok(j); }
        Result.Err(e) {
            // Rust `e.replacen("j3.toml", path, 1)`.
            let at = find(e, "j3.toml");
            if at < 0 { return Result.Err(e); }
            return Result.Err(Text.new(arena).add(e[0..at]).add(file).add(e[at + 7..e.len]).str());
        }
    }
}
