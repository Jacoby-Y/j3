// The scene-editor project templates (`j3c editor --new`, `j3c new --template fps`, the `scene3d` recipe) and
// the `--app` / `--lib` source templates.
//
// Part of module j3c.cmd.new.
// Port of: j3c/src/editor/templates.rs, scaffold/templates.rs
// J3: Text in `text/new/` (`@embed`, `@NAME@` / `@VERSION@` placeholders; Rust's `{{`/`}}` escapes undone).
// Templated files end in `.in` so no tool takes them for sources. The `components` files (`--template ui`,
// recipes) are Rust `helptext` text: `@embed`ded from `j3c/src/helptext/recipes/` until C6.
module j3c.cmd.new;

const AGENTS = @embed("../../../text/new/agents.md");
const SCENES = @embed("../../../text/new/scenes.md");
const SCENES_MARKER: string = "## 3D scenes and the editor";
const UI_COMPONENTS = @embed("../../../text/new/ui_components.md");
const HELLO_TOML = @embed("../../../text/new/hello.toml.in");
const HELLO_MAIN = @embed("../../../text/new/hello_main.j3.in");
const LIB_TOML = @embed("../../../text/new/lib.toml.in");
const LIB_MAIN = @embed("../../../text/new/lib_main.j3.in");
const LIB_DEMO_TOML = @embed("../../../text/new/lib_demo.toml.in");
const LIB_DEMO_MAIN = @embed("../../../text/new/lib_demo_main.j3.in");
const LIB_README = @embed("../../../text/new/lib_readme.md.in");
const APP_TOML = @embed("../../../text/new/app.toml.in");
const APP_MAIN = @embed("../../../text/new/app_main.j3.in");
const FPS_MAIN = @embed("../../../text/new/fps_main.j3.in");
const GAME_MAIN = @embed("../../../text/new/game_main.j3.in");
const START_SCENE = @embed("../../../text/new/start.j3scene.in");
const FPS_SCENE = @embed("../../../text/new/fps.j3scene.in");
const SPIN_SCRIPT = @embed("../../../text/new/spin.j3s.in");
const TREE_GEN: string = @embed("../../../text/new/tree_gen.j3.in");
const EDITOR_TOML: string = "[editor]\nscene = \"scenes/main.j3scene\"\n";
const LICENSE_DEJAVU = @embed("../../../../j3c/editor/LICENSE-DejaVu.txt");

/// The `components` recipe files (Rust `helptext::COMPONENTS_*`); `cmd/guide` reuses the toml and theme
/// (`componentsToml`, `componentsTheme`: an embedded const does not import under stage 0).
const COMPONENTS_TOML: string = @embed("../../../../j3c/src/helptext/recipes/components.toml");
const COMPONENTS_SCREEN = @embed("../../../../j3c/src/helptext/recipes/components_Screen.j3ui");
const COMPONENTS_THEME: string = @embed("../../../../j3c/src/helptext/recipes/components_theme.css");
const COMPONENTS_STATE = @embed("../../../../j3c/src/helptext/recipes/components_state.j3");
const COMPONENTS_MAIN = @embed("../../../../j3c/src/helptext/recipes/components_main.j3");

/// Rust `editor::TREE_GEN`: the example mesh generator (also the `meshgen` recipe).
pub fn treeGen(): string { return TREE_GEN; }

/// Rust `helptext::COMPONENTS_TOML` (the `ansi` recipe).
pub fn componentsToml(): string { return COMPONENTS_TOML; }

/// Rust `helptext::COMPONENTS_THEME` (the `ansi` recipe).
pub fn componentsTheme(): string { return COMPONENTS_THEME; }

/// `text` with `@NAME@` replaced by `name` and `@VERSION@` by this j3c's version, in `arena`.
fn fill(text: string, name: string, arena: &Arena): string {
    return sub(sub(text, "@NAME@", name, arena), "@VERSION@", J3C_VERSION, arena);
}

/// `text` with every `old` replaced by `new`, in `arena`.
fn sub(text: string, old: string, new: string, arena: &Arena): string {
    let t = Text.new(arena);
    return replace(&t, text, old, new);
}

fn file(p: string, text: string): FileText { return FileText { path: p, text: text }; }

/// Rust `editor::project_files`: the editor project for module `name` (`fps`: the first-person template). → recipes
pub fn projectFiles(name: string, fps: bool, arena: &Arena): List<FileText> {
    let l = List<FileText>.new(arena);
    let cfg = Text.new(arena).add("[package]\nname = \"").add(name);
    cfg.add("\"\nentry = \"src/main.j3\"\n\n[emit]\nbackend = \"llvm\"\nopt = 0\ndebug = true\n\n[link]\nlibs = [\"SDL2\", \"GL\"]\n");
    l.push(file("j3.toml", cfg.str()));
    l.push(file("j3.editor.toml", EDITOR_TOML));
    l.push(file("src/main.j3", fill(if fps { FPS_MAIN } else { GAME_MAIN }, name, arena)));
    l.push(file("scripts/spin.j3s", SPIN_SCRIPT));
    l.push(file("scenes/main.j3scene", if fps { FPS_SCENE } else { START_SCENE }));
    l.push(file("assets/gen/tree.j3", TREE_GEN));
    return l;
}

/// Rust `editor::create_project`: write `projectFiles` into `root` (named after its folder). → EDDEV (`editor --new`)
pub fn createProject(root: string, fps: bool, arena: &Arena): Result<bool, string> {
    let raw = match fileName(root) {
        Option.Some(n) { n }
        Option.None {
            match path.realpath(".", arena) {
                Option.Some(c) {
                    match fileName(c) {
                        Option.Some(n) { n }
                        Option.None { "game" }
                    }
                }
                Option.None { "game" }
            }
        }
    };
    let files = projectFiles(editorModuleName(raw, arena), fps, arena);
    for i in 0..files.len {
        let p = path.join(root, files.items[i].path, arena);
        if exists(p) { return Result.Err(Text.new(arena).add(p).add(" already exists").str()); }
    }
    let agents = path.join(root, "AGENTS.md", arena);
    if exists(agents) { return Result.Err(Text.new(arena).add(agents).add(" already exists").str()); }
    mkdirs(path.join(root, "assets", arena), arena)?;
    for i in 0..files.len {
        let p = path.join(root, files.items[i].path, arena);
        mkdirs(path.dirname(p), arena)?;
        put(p, files.items[i].text as []u8, arena)?;
    }
    return writeAgentFiles(root, true, arena);
}

/// Rust `editor::add_editor_files`: the scene, spin script and tree generator an existing project lacks. → EDDEV
pub fn addEditorFiles(root: string, arena: &Arena): Result<bool, string> {
    if !fsx.isFile(path.join(root, "j3.toml", arena)) {
        return Result.Err(Text.new(arena).add("no j3.toml in ").add(root).str());
    }
    let cfg = path.join(root, "j3.editor.toml", arena);
    if !exists(cfg) { put(cfg, EDITOR_TOML as []u8, arena)?; }
    let scene = ops.scenePath(root, arena)?;
    if !exists(scene) {
        mkdirs(path.dirname(scene), arena)?;
        put(scene, "j3scene 2 next=1\n" as []u8, arena)?;
    }
    return Result.Ok(true);
}

/// Rust `scaffold::add_scenes_section`: the scenes paragraph appended to the project's `AGENTS.md`. → EDDEV
pub fn addScenesSection(root: string, arena: &Arena) {
    let p = path.join(root, "AGENTS.md", arena);
    let text = match fsx.readText(p, arena) {
        Result.Ok(t) { t }
        Result.Err(_) { return; }
    };
    if contains(text, SCENES_MARKER) { return; }
    let t = Text.new(arena).add(lex.trimEnd(text)).add("\n\n").add(SCENES);
    put(p, t.str() as []u8, arena);
}

/// `AGENTS.md` (plus the scene and agent-tool section for an editor project) and a `CLAUDE.md` that imports
/// it; an existing `CLAUDE.md` is left alone (Rust `scaffold::write_agent_files`).
fn writeAgentFiles(root: string, scenes: bool, arena: &Arena): Result<bool, string> {
    let text = if scenes { Text.new(arena).add(AGENTS).add("\n").add(SCENES).str() } else { AGENTS };
    writeAs(path.join(root, "AGENTS.md", arena), text, "AGENTS.md", arena)?;
    let claude = path.join(root, "CLAUDE.md", arena);
    if !exists(claude) { writeAs(claude, "@AGENTS.md\n", "CLAUDE.md", arena)?; }
    return Result.Ok(true);
}

/// Rust `editor::module_name` (ASCII only, a leading digit gets `g`), not `scaffold`'s `moduleName`.
fn editorModuleName(s: string, arena: &Arena): string {
    let t = Text.new(arena);
    let i = 0;
    while i < s.len {
        let c = s[i];
        if isAlpha(c) || isDigit(c) || c == '_' {
            t.push(if c >= 'A' && c <= 'Z' { c + 32 } else { c });
            i += 1;
            continue;
        }
        let o = t.str();
        if o.len == 0 || o[o.len - 1] != '_' { t.add("_"); }
        i += decodeRune(s, i).1; // Rust walks chars: one `_` per non-ASCII char at most
    }
    let o = t.str();
    if o.len == 0 || isDigit(o[0]) { o = Text.new(arena).add("g").add(o).str(); }
    let e = o.len;
    while e > 0 && o[e - 1] == '_' { e -= 1; }
    o = o[0..e];
    if o.len == 0 { return "game"; }
    if isKeyword(o) { return Text.new(arena).add(o).add("_").str(); }
    return o;
}

fn helloToml(name: string, arena: &Arena): string { return fill(HELLO_TOML, name, arena); }

fn helloMain(name: string, arena: &Arena): string { return fill(HELLO_MAIN, name, arena); }
