// `j3c run --hot` for projects without scripts: watch the sources, rebuild in process, restart the program
// through the `J3_HOT_QUIT` / `J3_HOT_WIN` / `J3_HOT_STATE` handshake; the old run stays up when a build fails.
//
// Port of: j3c/src/hot.rs
// J3: Polls every 100 ms as Rust does (no `j3.io.watch`: Linux-only inotify, and the poll is the oracle's
//     behaviour). Children start through `cmd/devrun.j3` `launch`. Never run in tests (the loop never ends on its
//     own): unit tests cover `watched` and `withoutStyles` only.
// J3: Must not `use j3c.cmd.run` (`cmd/run.j3` calls `run` here: import cycle).
module j3c.cmd.hot;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.cmd.check.err;
use j3c.cmd.devrun;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.project.manifest.Manifest;
use j3c.toolchain.EmitOpts;

/// Rust `run`: `s` is the checked `Mode.Dev` session `devrun.prepare` answered `NoScripts` for, or `first` the
/// prepare error (the loop then waits for a fix). Returns only when the program is closed; the exit code.
pub fn run(s: &Session, m: &Manifest, e: &EmitOpts, first: Option<string>, args: []string): int {
    err("j3c-boot: run --hot: not ported yet\n"); // STUB E
    return 1;
}

/// Rust `watched`: `.j3`, `.j3ui`, `.j3s` files and `j3.toml`.
pub fn watched(p: string): bool {
    return false; // STUB E
}

/// Rust `without_styles`: `src` with top-level `<style>...</style>` blocks removed (a style edit is no restart).
pub fn withoutStyles(src: string, arena: &Arena): string {
    return src; // STUB E
}
