// Argv parsing and command dispatch: one table of commands, each with its flags and help text.
//
// Port of: j3c/src/cli/mod.rs
// J3: Every command builds a `driver.Options` and calls `driver.run` (plan 11 B1/B2). Tools reach the
// compiler only through `driver` and the read-only query functions of `sema` / `ir`; never
// `use j3c.lower` (tools/layers.sh fails on it).
module j3c.cmd.args;
// J3: Ported so far: `test-compiler`, `fmt`, `dump-ast`, `check`; through the whole driver pipeline (C2a):
// `dump-ir`, `dump-llvm`, `run` (`cmd/run.j3`), `build` (`cmd/build.j3`). Wired to stubs (C2d, contracts-c2d.md):
// `dump-glsl` (`cmd/glsl.j3`); `dump-ui` (`cmd/ui.j3`, C2e). Every other command prints
// `j3c-boot: CMD: not ported yet` and exits 1 (so `tests/diff.sh` reports CRASH, not DIFF). No command
// (Rust: help, exit 0) is not ported yet either.

use j3.sys;
use j3c.cmd.check;
use j3c.cmd.dump;
use j3c.cmd.glsl.dumpGlslCmd;
use j3c.cmd.build.buildCmd;
use j3c.cmd.run.runCmd;
use j3c.cmd.ui.dumpUiCmd;
use j3c.cmd.testcompiler;

/// Run the command `args[0]` with the rest; returns the exit code (Rust `cli::run`).
pub fn run(args: []string): int {
    let cmd = "";
    if args.len > 0 { cmd = args[0]; }
    let rest = args[0..0];
    if args.len > 1 { rest = args[1..args.len]; }
    if cmd == "test-compiler" { return testcompiler.run(rest); }
    if cmd == "fmt" { return check.fmtCmd(rest); }
    if cmd == "check" { return check.checkCmd(rest); }
    if cmd == "dump-ast" { return dump.dumpAstCmd(rest); }
    if cmd == "dump-ir" { return dump.dumpIrCmd(rest); }
    if cmd == "dump-llvm" { return dump.dumpLlvmCmd(rest); }
    if cmd == "run" { return runCmd(rest); }
    if cmd == "build" { return buildCmd(rest); }
    if cmd == "dump-glsl" { return dumpGlslCmd(rest); }
    if cmd == "dump-ui" { return dumpUiCmd(rest); }
    return notPortedCmd(cmd);
}

/// `j3c-boot: CMD: not ported yet` on stderr, exit 1 (`tests/diff.sh` reports CRASH, not DIFF).
fn notPortedCmd(cmd: string): int {
    let head = "j3c-boot: ";
    let tail = ": not ported yet\n";
    sys.write(2, head.ptr as ptr, head.len);
    sys.write(2, cmd.ptr as ptr, cmd.len);
    sys.write(2, tail.ptr as ptr, tail.len);
    return 1;
}
