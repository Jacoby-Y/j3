// Argv parsing and command dispatch: one table of commands, each with its flags and help text.
//
// Port of: j3c/src/cli/mod.rs
// J3: Every command builds a `driver.Options` and calls `driver.run` (plan 11 B1/B2). Tools reach the
// compiler only through `driver` and the read-only query functions of `sema` / `ir`; never
// `use j3c.lower` (tools/layers.sh fails on it).
module j3c.cmd.args;
// J3: Every Rust route is here (C5 wave 25): commands not ported yet reach a stub in their chunk's file that
// prints `j3c-boot: CMD: not ported yet` and exits 1 (`base/diag.notPortedCmd`; `tests/diff.sh` reports CRASH,
// not DIFF). The texts Rust prints right here (`-e --help`, unknown command / tool, `steam-check`) are data
// below, in full. `ice_hook` has no J3 twin (a panic in j3c-boot exits 101 with its own message).

use j3.sys;
use j3c.base.diag;
use j3c.cmd.android.androidCmd;
use j3c.cmd.build.buildCmd;
use j3c.cmd.check;
use j3c.cmd.doctor.doctorCmd;
use j3c.cmd.dump;
use j3c.cmd.gen.genCmd;
use j3c.cmd.glsl.dumpGlslCmd;
use j3c.cmd.golden.goldenCmd;
use j3c.cmd.guide;
use j3c.cmd.i18n.i18nCmd;
use j3c.cmd.imgdiff.imgdiffCmd;
use j3c.cmd.info;
use j3c.cmd.lsp.lspCmd;
use j3c.cmd.new.newCmd;
use j3c.cmd.pkg;
use j3c.cmd.run.runCmd;
use j3c.cmd.size.sizeCmd;
use j3c.cmd.testcompiler;
use j3c.cmd.ui.dumpUiCmd;
use j3c.cmd.web.webCmd;
use j3c.doc.docCmd;
use j3c.editor.editorCmd;
use j3c.editor.assets.scriptPropsCmd;
use j3c.mcp.mcpCmd;
use j3c.scene;
use j3c.textmate.dumpSyntaxCmd;

/// Run the command `args[0]` with the rest; returns the exit code (Rust `cli::run`).
pub fn run(args: []string): int {
    // Rust: no argument prints the help, exit 0
    if args.len == 0 { return guide.helpCmd(args); }
    let cmd = args[0];
    let rest = args[1..args.len];
    if cmd == "help" || cmd == "--help" || cmd == "-h" { return guide.helpCmd(rest); }
    if cmd == "version" || cmd == "--version" || cmd == "-V" { return info.versionCmd(rest); }
    if cmd == "test-compiler" { return testcompiler.run(rest); }
    if cmd == "fmt" { return check.fmtCmd(rest); }
    if cmd == "check" { return check.checkCmd(rest); }
    if cmd == "dump-ast" { return dump.dumpAstCmd(rest); }
    if cmd == "dump-ir" { return dump.dumpIrCmd(rest); }
    if cmd == "dump-llvm" { return dump.dumpLlvmCmd(rest); }
    if cmd == "dump-c" { return diag.notPortedCmdHelp(cmd, "the C backend was removed (E0002); `j3c dump-llvm` prints the program"); } // the C backend is not ported (DELETED.md)
    if cmd == "dump-glsl" { return dumpGlslCmd(rest); }
    if cmd == "dump-bc" { return dump.dumpBcCmd(rest); }
    if cmd == "dump-syntax" { return dumpSyntaxCmd(rest); }
    if cmd == "dump-ui" { return dumpUiCmd(rest); }
    if cmd == "new" { return newCmd(rest); }
    if cmd == "doctor" { return doctorCmd(rest); }
    if cmd == "editor" { return editorCmd(rest); }
    if cmd == "-e" || cmd == "--editor" { return editorTool(rest); }
    if cmd == "fetch" { return pkg.fetchCmd(rest); }
    if cmd == "update" { return pkg.updateCmd(rest); }
    if cmd == "add" { return pkg.addCmd(rest); }
    if cmd == "pkg" { return pkg.pkgCmd(rest); }
    if cmd == "i18n" { return i18nCmd(rest); }
    if cmd == "doc" { return docCmd(rest); }
    if cmd == "manifest" { return info.manifestCmd(rest); }
    if cmd == "guide" { return guide.guideCmd(rest); }
    if cmd == "explain" { return guide.explainCmd(rest); }
    if cmd == "run" { return runCmd(rest); } // `run --help` is `cmd/run.j3`'s
    if cmd == "build" { return buildCmd(rest); }
    if cmd == "size" { return sizeCmd(rest); }
    if cmd == "golden" { return goldenCmd(rest); }
    if cmd == "lsp" { return lspCmd(rest); }
    err("j3c: unknown command `");
    err(cmd);
    err("`\n");
    if cmd == "scene" || cmd == "render" || cmd == "gen" || cmd == "mcp" {
        err("editor tools take -e: `j3c -e ");
        err(cmd);
        err("`\n");
    } else {
        err("run `j3c help`\n");
    }
    return 1;
}

/// `j3c -e <tool>` (Rust `editor_tool`): the scene editor's tools, which work without its window.
fn editorTool(args: []string): int {
    let rest = args[0..0];
    if args.len > 1 { rest = args[1..args.len]; }
    let tool = if args.len > 0 { args[0] } else { "" };
    if tool == "scene" { return scene.sceneCmd(rest); }
    if tool == "render" { return scene.renderCmd(rest); }
    if tool == "gen" { return genCmd(rest); }
    if tool == "imgdiff" { return imgdiffCmd(rest); }
    if tool == "steam-check" {
        let m = STEAM_MOVED;
        err(m);
        return 1;
    }
    if tool == "--help" || tool == "-h" {
        let h = E_HELP;
        sys.write(1, h.ptr as ptr, h.len);
        return 0;
    }
    if tool == "mcp" { return mcpCmd(rest); }
    if tool == "android" { return androidCmd(rest); }
    if tool == "web" { return webCmd(rest); }
    if tool == "script-props" { return scriptPropsCmd(rest); }
    if args.len > 0 {
        err("j3c -e: unknown editor tool `");
        err(tool);
        err("`\n");
    }
    err("usage: j3c -e scene|render|gen|imgdiff|mcp|android|web|script-props ...  (or --editor)\n");
    return 1;
}

/// Rust `editor_tool`'s `steam-check` arm (the check moved to the steam package, `j3c pkg steam check`).
const STEAM_MOVED: string = "j3c -e steam-check moved to the steam package: j3c pkg steam check --sdk DIR (add steam = { git = \"https://github.com/Jacoby-Y/j3-steam\", tag = \"v0.1.0\" } under [dependencies])\n";

/// `j3c -e --help`.
const E_HELP: string = "usage: j3c -e <tool> ...  (or --editor)\n  scene|render|gen|mcp|android|script-props   scene editor tools and the MCP server (`j3c -e scene --help`)\n  imgdiff a.png b.png [--tol N] [--max N] [--out d.png]   pixel diff for goldens\n  web serve|run DIR [--headless] [--frames N] [--screenshot F]   serve or run a built web folder\n";

fn err(s: string) { sys.write(2, s.ptr as ptr, s.len); }
