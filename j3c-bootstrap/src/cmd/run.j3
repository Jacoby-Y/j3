// `j3c run`: projects, single files, `.j3s` tools, `--headless`, `--frames`, `--screenshot`.
//
// Port of: j3c/src/cli/runner.rs, devrun.rs, the run flags of cli/mod.rs (`take_run_flags`, run help)
// J3: Rust `run_user` + `run_loaded` in one function: the stat-only shortcut (`stamp.unchangedProject`), then the
//     check through `driver.run(s, Stage.Passes)`, warnings, the Android refusal, `toolchain.preflight`, the
//     source-key shortcut (`stamp.upToDate`), else the build on to `Stage.Link` (Options.run = true: temp
//     output for a program without a manifest), `toolchain.runExe` on `Session.exe`, `stamp.markBuilt` and
//     the report (Rust `report_run`). The shared failure printing (`printFail` with its `= help:` hint,
//     warnings, the library refusal) is here; `cmd/build.j3` uses it.
// J3: Not ported yet: dev mode for projects with `.j3s` scene scripts (`devrun.rs`, C4: such a project runs
//     as a plain build and, as in Rust, never writes or uses the `run` stamps), `--hot` (`hot.rs`, C4: refused),
//     `run samples` (the IR samples are a unit-test fixture now).
// J3: `--emit c` is an error (B8a), also when the output is up to date: the shortcuts are skipped for it.
module j3c.cmd.run;

use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.text.{ Text, contains, endsWith, parseInt, startsWith };
use j3c.base.diag;
use j3c.base.diag.Severity;
use j3c.base.fsx;
use j3c.cmd.check.{ err, failText, out };
use j3c.cmd.gen;
use j3c.cmd.stamp;
use j3c.cmd.stamp.StampFlags;
use j3c.driver;
use j3c.driver.{ ANDROID_RUN, Mode, Session, Stage };
use j3c.project.manifest;
use j3c.project.manifest.Input;
use j3c.toolchain;
use j3c.toolchain.{ TargetOs, discard };

const RUN_HELP: string = "usage: j3c run [path | file.j3 | tool.j3s] [--frames N] [--screenshot F.png] [--headless] [--hot] [--file] [--host] [--splash]\n  --hot       rebuild and restart on .j3/.j3ui/.j3s edits; the old run stays up if the build fails (`j3c doc j3ui`).\n  --headless  offscreen video, silent audio: no window. Agents always pass it (`j3c doc testing`).\n  --host      ignore [emit] target: build and run an Android package for this machine, in place (`j3c doc testing`).\n  --splash    show the startup splash in a dev run (`j3c doc ship`); same as J3_SPLASH=1\n  --frames N  stop an App after N frames; --screenshot saves the last one (relative to your cwd).\n";

/// `run`/`build` flags (Rust `peel_run`/`peel_args` + `take_run_flags`): one path, then the program's arguments.
pub struct RunFlags {
    /// The path argument; without one (`hasPath` false) the project in the cwd.
    path: string;
    hasPath: bool;
    args: List<string>;
    fast: bool;
    release: bool;
    /// `--emit NAME`, "" = the manifest's.
    emit: string;
    /// `--opt LEVEL`, "" = the manifest's.
    opt: string;
    hot: bool;
    fileOnly: bool;
    host: bool;
}

/// Rust `take_run_flags`: strip `--frames N`, `--screenshot F`, `--headless`, `--splash` (passed to the
/// program as env) and `--hot`/`--file`/`--host` from `rest`; the other arguments in order. Err: the usage
/// error text.
pub fn takeRunFlags(rest: []string, f: &RunFlags, arena: &Arena): Result<List<string>, string> {
    let out = List<string>.new(arena);
    let i = 0;
    while i < rest.len {
        let a = rest[i];
        if a == "--frames" {
            if i + 1 >= rest.len { return Result.Err("--frames needs a count"); }
            let n = rest[i + 1];
            i += 1;
            // Rust `parse::<u32>()`: digits with an optional `+`, at most u32::MAX; 0 is refused too.
            let digits = if n.len > 1 && n[0] == '+' { n[1..n.len] } else { n };
            let ok = false;
            if digits.len > 0 && digits[0] != '-' && digits[0] != '+' {
                match parseInt(digits, 10) {
                    Option.Some(v) { ok = v > 0 && v <= 4294967295; }
                    Option.None {}
                }
            }
            if !ok { return Result.Err(Text.new(arena).add("--frames wants a positive whole number, not `").add(n).add("`").str()); }
            sys.setenv("J3_FRAMES", n);
        } else if a == "--screenshot" {
            if i + 1 >= rest.len { return Result.Err("--screenshot needs a file"); }
            let p = rest[i + 1];
            i += 1;
            // The program runs in its project root; keep the path the user meant.
            if !path.isAbs(p) {
                match path.realpath(".", arena) {
                    Option.Some(cwd) { p = path.join(cwd, p, arena); }
                    Option.None { return Result.Err("cannot read the current directory"); }
                }
            }
            sys.setenv("J3_SCREENSHOT", p);
        } else if a == "--hot" {
            f.hot = true;
        } else if a == "--file" {
            f.fileOnly = true;
        } else if a == "--host" {
            f.host = true;
        } else if a == "--splash" {
            sys.setenv("J3_SPLASH", "1");
        } else if a == "--headless" {
            sys.setenv("SDL_VIDEODRIVER", "offscreen");
            sys.setenv("SDL_AUDIODRIVER", "dummy");
        } else {
            out.push(a);
        }
        i += 1;
    }
    return Result.Ok(out);
}

/// Rust `peel_run` (`args` = true) / `peel_args` (false): `--fast`, `--release`, `--emit V`, `--opt V` anywhere,
/// the first other non-flag is the path; with `args`, everything else after the path is the program's.
pub fn peelRun(rest: []string, f: &RunFlags, args: bool) {
    let i = 0;
    while i < rest.len {
        let a = rest[i];
        if a == "--fast" {
            f.fast = true;
        } else if a == "--release" {
            f.release = true;
        } else if a == "--emit" {
            if i + 1 < rest.len {
                f.emit = emitName(rest[i + 1]);
                i += 1;
            }
        } else if startsWith(a, "--emit=") {
            f.emit = emitName(a[7..a.len]);
        } else if a == "--opt" {
            if i + 1 < rest.len {
                f.opt = rest[i + 1];
                i += 1;
            }
        } else if startsWith(a, "--opt=") {
            f.opt = a[6..a.len];
        } else if !f.hasPath && !startsWith(a, "-") {
            f.path = a;
            f.hasPath = true;
        } else if f.hasPath && args {
            f.args.push(a);
        }
        i += 1;
    }
}

/// Rust `emit_code`: the backend `--emit V` names; any other word is ignored (the manifest's backend).
pub fn emitName(v: string): string {
    if v == "c" || v == "C" { return "c"; }
    if v == "llvm" || v == "LLVM" || v == "ll" { return "llvm"; }
    return "";
}

/// No flags, no path.
pub fn noFlags(arena: &Arena): RunFlags {
    return RunFlags { path: "", hasPath: false, args: List<string>.new(arena), fast: false, release: false, emit: "", opt: "", hot: false,
        fileOnly: false, host: false };
}

/// The session for building `f` (`run` = Rust's run path: temp output, Android refused).
pub fn sessionFor(f: &RunFlags, run: bool): &Session {
    let opts = driver.defaults();
    opts.entry = f.path;
    opts.entryGiven = f.hasPath;
    opts.mode = Mode.Build;
    opts.fast = f.fast;
    opts.release = f.release;
    opts.emit = f.emit;
    opts.opt = f.opt;
    opts.hot = f.hot;
    opts.fileOnly = f.fileOnly;
    opts.host = f.host;
    opts.run = run;
    let s = Session.new(opts);
    s.phases.enable();
    return s;
}

/// `j3c run [flags] [path] [args]` (Rust `run_dispatch`): exit code.
pub fn runCmd(rest: []string): int {
    for i in 0..rest.len {
        if rest[i] == "--help" || rest[i] == "-h" {
            out(RUN_HELP);
            return 0;
        }
    }
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let f = noFlags(&mem);
    let left = List<string>.new(&mem);
    match takeRunFlags(rest, &f, &mem) {
        Result.Ok(v) { left = v; }
        Result.Err(e) { err(Text.new(&mem).add("j3c run: ").add(e).add("\n").str()); return 1; }
    }
    peelRun(left.items[0..left.len], &f, true);
    if f.path == "samples" {
        err("j3c: `run samples` is not supported by j3c-boot: the IR samples are a unit-test fixture (tests/unit/ir_samples)\n");
        return 1;
    }
    manifest.setHost(f.host);
    manifest.setFileOnly(f.fileOnly);
    let refused = refuseLib(f.path, "run", &mem);
    if refused != 0 { return refused; }
    // C4 dispatch point (chunk D, Rust `run_user`): a project goes through `devrun.prepare` on a `Mode.Dev`
    // session; `NoScripts` continues below (or `hot.run` with `--hot`), `Dev` goes to `devrun.watch`.
    if f.hot {
        err("j3c-boot: run --hot: not ported yet\n");
        return 1;
    }
    let s = sessionFor(&f, true);
    defer s.free();
    s.phases.begin("parse");
    // Rust `run_user`: a project whose files have not changed (stat only) runs its output as it is.
    if f.emit != "c" {
        let sf = StampFlags { path: f.path, hasPath: f.hasPath, fast: f.fast, release: f.release, opt: f.opt };
        match stamp.unchangedProject(&sf, "run", s.arena) {
            Option.Some(u) { return runBuilt(s, u.e.cc.out, u.e.cwd, &f); }
            Option.None {}
        }
    }
    let isProject = false;
    match if f.hasPath { manifest.resolve(f.path, s.arena) } else { manifest.resolveCwd(s.arena) } {
        Result.Ok(inp) {
            match inp {
                Input.Project(m) {
                    isProject = true;
                    match toolchain.emitOptsFromManifest(&m, s.arena) {
                        Result.Ok(_) {}
                        Result.Err(e) { printFail(e, s.arena); return 1; }
                    }
                    gen.beforeBuild(m.root);
                }
                Input.Hello {}
                Input.File(_) {}
            }
        }
        Result.Err(_) {}
    }
    if !isProject && !noHello(s, f.hasPath) { return 1; }
    // Rust `run_loaded`/`build_loaded`: warnings once the check (through lower and validate) is clean,
    // before the backend and clang, so a failed link still shows them.
    if !driver.run(s, Stage.Passes) {
        printFail(failText(s), s.arena);
        return 1;
    }
    printWarnings(s);
    let e = toolchain.defaultEmitOpts(s.arena);
    match driver.emitOpts(s) {
        Result.Ok(x) { e = x; }
        Result.Err(x) { printFail(x, s.arena); return 1; }
    }
    if toolchain.targetOs(e.target) == TargetOs.Android {
        printFail(ANDROID_RUN, s.arena);
        return 1;
    }
    // A project with `.j3s` scripts is Rust's dev runner, which keeps no `run` stamps.
    let stamps = f.emit != "c";
    match s.loaded {
        Option.Some(p) {
            for i in 0..p.files.len { if p.files.items[i].ast.isScript { stamps = false; } }
            match p.project {
                Option.Some(m) { gen.beforeBuild(m.root); }
                Option.None {}
            }
            match s.program {
                Option.Some(prog) {
                    match toolchain.preflight(prog, p.project, s.arena) {
                        Result.Ok(_) {}
                        Result.Err(x) { printFail(x, s.arena); return 1; }
                    }
                }
                Option.None {}
            }
        }
        Option.None {}
    }
    if stamps && e.cc.out.len > 0 && stamp.upToDate(s, &e) {
        stamp.markInputs(s);
        return runBuilt(s, e.cc.out, e.cwd, &f);
    }
    if !driver.run(s, Stage.Link) {
        printFail(failText(s), s.arena);
        return 1;
    }
    s.phases.begin("running");
    let code = 1;
    match toolchain.runExe(s.exe, s.emit.cwd, f.args.items[0..f.args.len], s.arena) {
        Result.Ok(r) {
            if stamps { stamp.markBuilt(s, &e); }
            code = reportRun(r.status, r.stdout, r.stderr, s.arena);
        }
        Result.Err(x) { printFail(x, s.arena); }
    }
    if s.emit.cc.out.len == 0 { discard(s.exe); }
    return code;
}

/// The up-to-date path of Rust `run_user` / `run_loaded`: run `exe` as it is and report.
fn runBuilt(s: &Session, exe: string, cwd: string, f: &RunFlags): int {
    s.phases.begin("up to date");
    s.phases.begin("running");
    match toolchain.runExe(exe, cwd, f.args.items[0..f.args.len], s.arena) {
        Result.Ok(r) { return reportRun(r.status, r.stdout, r.stderr, s.arena); }
        Result.Err(x) { printFail(x, s.arena); }
    }
    return 1;
}

/// Rust `compile_user`: no path and no `j3.toml` in the cwd is an error, not the built-in hello. False after
/// printing it.
pub fn noHello(s: &Session, given: bool): bool {
    if given { return true; }
    match manifest.resolveCwd(s.arena) {
        Result.Ok(inp) {
            match inp {
                Input.Hello {
                    printFail("no j3.toml in the current directory\n  = help: `j3c new`\n  = help: `j3c new --app`\n  = help: `j3c guide`", s.arena);
                    return false;
                }
                Input.File(_) {}
                Input.Project(_) {}
            }
        }
        Result.Err(e) {
            printFail(e, s.arena);
            return false;
        }
    }
    return true;
}

/// Rust `refuse_lib`: `run`/`build` of a library project prints why and returns 1; 0 otherwise.
pub fn refuseLib(p: string, cmd: string, arena: &Arena): int {
    let r = if p.len == 0 { manifest.resolveCwd(arena) } else { manifest.resolve(p, arena) };
    match r {
        Result.Ok(inp) {
            match inp {
                Input.Project(m) {
                    if !m.isLib { return 0; }
                    let t = Text.new(arena);
                    t.add("j3c ").add(cmd).add(": ").add(m.name).add(" is a library ([lib] in j3.toml), not a program\n");
                    let demo = path.join(m.root, "examples/demo", arena);
                    if fsx.isFile(path.join(demo, "j3.toml", arena)) {
                        t.add("  = help: `j3c ").add(cmd).add(" ").add(demo).add("`, or `j3c check` the library\n");
                    } else {
                        t.add("  = help: `j3c check` it; run it from a project that depends on it\n");
                    }
                    err(t.str());
                    return 1;
                }
                Input.Hello {}
                Input.File(_) {}
            }
        }
        Result.Err(_) {}
    }
    return 0;
}

/// Rust `print_fail`: a diagnostic as it is, anything else as `j3c: E`; then the `= help:` install hint
/// when the text names a missing library or compiler (and doesn't already carry it).
pub fn printFail(e: string, arena: &Arena) {
    let t = Text.new(arena);
    if contains(e, "error:") || contains(e, "warning:") || contains(e, "-->") {
        t.add(e);
        if !endsWith(e, "\n") { t.add("\n"); }
    } else {
        t.add("j3c: ").add(e).add("\n");
    }
    hint(&t, e, arena);
    err(t.str());
}

/// Rust `print_hint`, appended to `t`.
fn hint(t: &Text, text: string, arena: &Arena) {
    match toolchain.failureHint(text, arena) {
        Option.Some(h) { if !contains(text, h) { t.add("  = help: ").add(h).add("\n"); } }
        Option.None {}
    }
}

/// Rust `print_warnings`: code warnings to stderr (the program still builds and runs).
pub fn printWarnings(s: &Session) {
    let t = Text.new(s.arena);
    for i in 0..s.diags.count() {
        let d = s.diags.at(i);
        if d.severity == Severity.Warning {
            diag.render(d, &s.sources, &t);
            t.add("\n");
        }
    }
    err(t.str());
}

/// Rust `exit_reason`: what a non-zero exit code means.
fn exitReason(code: int, t: &Text) {
    if code == 101 { t.add(" (panic)"); }
    if code == 102 { t.add(" (runtime check failed)"); }
    if code >= 129 && code <= 159 {
        t.add(" (killed by signal ");
        t.pushInt(code - 128);
        t.add(")");
    }
}

/// Rust `report_run`: the program's stdout; its stderr on a clean exit; on a failure the exit line, its
/// stderr (or that it wrote none) and an install hint. Returns its exit code.
pub fn reportRun(status: int, stdout: string, stderr: string, arena: &Arena): int {
    out(stdout);
    if status == 0 && stderr.len > 0 { err(stderr); }
    if status != 0 {
        let t = Text.new(arena);
        t.add("j3c: program exited ");
        t.pushInt(status);
        exitReason(status, &t);
        t.add("\n");
        if stderr.len == 0 { t.add("j3c: it wrote nothing to stderr\n"); } else { t.add(stderr).add("\n"); }
        hint(&t, stderr, arena);
        err(t.str());
    }
    return status;
}
