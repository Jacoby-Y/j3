// What every backend gets (the IR program, target, opt level, debug info flag) and the backend table.
//
// Port of: j3c/src/emit/mod.rs, emit/opts.rs
// J3: Backends are `dyn Backend` (plan 11 B8): `emit(prog: &Program, opts: &Opts, out: &Text)`, `objectExt()`,
//     `link(objs, opts)`. `link` returns the link plan (argv) and `toolchain` runs it; a backend never spawns
//     processes. LLVM (`backend/llvm`) and bytecode (`backend/bc`) are the two implementations; a new one
//     (web, plan 04; native dev, Part D) is one folder plus one table entry in `find`.
// J3: Roles (B8a): LLVM text then clang for every native build, dev and release, every target; bytecode for
//     `.j3s` scripts. No C backend: `[emit] backend = "c"` and `--emit c` are errors in j3c-boot (the one
//     deliberate output difference from the oracle; `find` raises E0002). emit/c*.rs is in DELETED.md; there
//     is no `c` harness mode. Rust treated `--emit c` as a real choice; the E0002 message names the two backends.
// J3: The table entries (`Llvm`, `Bc`) live here, not in `backend/llvm`/`backend/bc`: those modules will use
//     `Opts`/`LinkPlan` from this one, and a `use` both ways is an import cycle. So this module uses
//     `backend.llvm` and never the reverse: `Llvm.emit` maps `Opts` to `llvm.LlOpts` and reports the
//     printer's error string as a code-0 Diag. `link` (per-module objects, with `emit/incr.rs`) is a stub; `Bc.emit` is an
//     error (scripts are emitted per module by `backend/bc`, C4).
// J3: `Opts` is the backend half of Rust's `EmitOpts` (the toolchain half is `toolchain.EmitOpts`, which maps
//     to this with `backendOpts`); `release` is Rust's `cc.release` (no unwind tables, packed aborts).
module j3c.backend;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.base.diag.{ Diags, Severity };
use j3c.base.span.Span;
use j3c.backend.llvm;
use j3c.backend.llvm.LlOpts;
use j3c.base.span.noSpan;
use j3c.ir.Program;

/// What every backend gets besides the program.
pub struct Opts {
    /// Target triple, "" for the host.
    target: string;
    /// 0, 1, 2, 3, `s` (-1) or `z` (-2), as `[emit] opt`.
    opt: int;
    debug: bool;
    /// `--release`: no unwind tables, packed aborts (Rust `cc.release`). Defaults false so older literals stay valid.
    release: bool = false;
}

/// The link command a backend asks for; `toolchain` runs it.
pub struct LinkPlan {
    argv: List<string>;
}

/// One code generator.
pub trait Backend {
    fn name(this: &Self): string;
    /// Append the output for `prog` to `out`; false (with Diags) on failure.
    fn emit(this: &Self, prog: &Program, opts: &Opts, out: &Text, diags: &Diags): bool;
    /// Object file extension (`o`, `j3bc`).
    fn objectExt(this: &Self): string;
    /// The link command for `objs`, allocated in `arena`.
    fn link(this: &Self, objs: []string, opts: &Opts, arena: &Arena): LinkPlan;
}

/// LLVM text then clang: every native build.
pub struct Llvm {
    fn name(this: &Llvm): string { return "llvm"; }
    fn emit(this: &Llvm, prog: &Program, opts: &Opts, out: &Text, diags: &Diags): bool {
        let lo = LlOpts { target: opts.target, opt: opts.opt, debug: opts.debug, release: opts.release };
        match llvm.emitLlvm(&prog.cx, prog.modules.slice(), &lo, out) {
            Result.Ok(_) { return true; }
            Result.Err(e) {
                diags.add(diags.make(0, Severity.Error, noSpan(), e));
                return false;
            }
        }
    }
    fn objectExt(this: &Llvm): string { return "o"; }
    // J3: empty until per-module objects land (`emit/incr.rs`); a whole-program build is one clang that
    //     compiles and links (`toolchain.clangArgv`).
    fn link(this: &Llvm, objs: []string, opts: &Opts, arena: &Arena): LinkPlan { return LinkPlan { argv: List<string>.new(arena) }; }
}

/// Script bytecode (`.j3sb`) for the `.j3s` VM.
pub struct Bc {
    fn name(this: &Bc): string { return "bc"; }
    // J3: Rust has no whole-program bytecode output (no `--emit bc`): scripts go to `.j3sb` one module at a time
    //     (`bc.emitScript` + `bc.writeTo`, from `dump-bc` and the dev runner). Asking for it here is an error.
    fn emit(this: &Bc, prog: &Program, opts: &Opts, out: &Text, diags: &Diags): bool {
        diags.add(diags.make(0, Severity.Error, noSpan(), "the bc backend has no program output: scripts compile to `.j3sb` through `j3c run` or `j3c dump-bc`"));
        return false;
    }
    fn objectExt(this: &Bc): string { return "j3sb"; }
    // J3: bytecode is loaded by the VM, never linked: an empty plan.
    fn link(this: &Bc, objs: []string, opts: &Opts, arena: &Arena): LinkPlan { return LinkPlan { argv: List<string>.new(arena) }; }
}

// Stateless table entries; `find` hands out their addresses (fixed size, nothing grows: B6).
#[singleton]
let LLVM: Llvm;
#[singleton]
let BC: Bc;

/// The backend called `name` (`ll` and `LLVM` are `llvm`, as Rust's `--emit` took them); `c` adds E0002 and
/// any other unknown name E0001 at `at`, both `None`.
pub fn find(name: string, at: Span, diags: &Diags): Option<dyn Backend> {
    let table: [2]dyn Backend = [&LLVM, &BC];
    let want = name;
    if name == "ll" || name == "LLVM" { want = "llvm"; }
    for i in 0..2 {
        if table[i].name() == want { return Option.Some(table[i]); }
    }
    if name == "c" || name == "C" {
        diags.add(diags.make(2, Severity.Error, at, "the C backend was removed: use `llvm` (native builds) or `bc` (scripts)"));
        return Option.None;
    }
    let t = Text.new(diags.arena);
    t.add("unknown backend `").add(name).add("`: use `llvm` (native builds) or `bc` (scripts)");
    diags.add(diags.make(1, Severity.Error, at, t.str()));
    return Option.None;
}
