// Dev mode for programs with scripts: rewrite IR so the native program never knows a script's layout
// (`devNew(path, props)` literals, `devCall` stubs, `j3s_dev` thunks), for a binary whose scripts run on the VM.
//
// Port of: j3c/src/compile/dev.rs
// J3: An IR-to-IR pass like `ir.fast`, one conditional entry in the driver's pass table (plan 11 B8): the driver's
//     `devPass` calls `bytecode` on the un-rewritten IR (kept in `Session.bytecode`), then `lower` with it
//     (Rust order: check, fast, bytecode, dev lower). Building, spawning and watching are `cmd/devrun.j3`.
// J3: Parts: `devmode/build.j3` (the `Fb` body builder), `devmode/literals.j3` (script literals to `devNew`),
//     `devmode/thunk.j3` (one `j3s_dev` thunk per callable native fn). Every `use` of the module is here.
// J3: Deterministic order everywhere, since the dumped IR is the `dev.key` (contracts-c4.md "Ordering rules"):
//     the script table in struct-id order, `called` in bytecode order, thunks by module order then fn order.
module j3c.devmode;

use j3.data.map.Map;
use j3.data.pool.Id;
use j3.data.set.Set;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.base.span.Span;
use j3c.backend.bc;
use j3c.backend.bc.BcModule;
use j3c.ir.{ Block, Body, Func, FuncKind, IrCx, Module, Operand, Place, Program, Rvalue, RvalueKind, Stmt, StmtKind, StructDef, TyKind };
use j3c.ir.dump;

/// The module the pass adds (thunks, `register`); last in `prog.modules`.
pub const DEV_MODULE: string = "j3s_dev";

