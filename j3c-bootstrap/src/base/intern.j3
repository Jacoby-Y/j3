// Interned names: `string` to `Sym` (u32) and back, one table for every name in a compile.
//
// Port of: j3c/src/intern.rs
// J3: Wraps the stdlib `j3.data.intern` `Interner`; the `Session` owns the one instance (`Names`). `Sym` is
// a typed handle so a symbol never mixes with a plain count.
module j3c.base.intern;

use j3.cmp.mix;
use j3.data.intern.Interner;
use j3.memory.Arena;

/// An interned string. Compare with `==`; hashes, so it works as a `Map` key.
pub struct Sym {
    i: u32;

    fn operator==(this: Sym, o: Sym): bool { return this.i == o.i; }
    fn hash(this: Sym): u64 { return mix(u64(this.i)); }
}

/// The name table of one `Session`. Strings are copied into its arena once.
pub struct Names {
    inner: Interner;

    /// Empty table allocating from `arena`.
    fn new(arena: &Arena): Names { return Names { inner: Interner.new(arena) }; }

    /// The symbol of `s`, adding it when new.
    fn intern(this: &Names, s: string): Sym { return Sym { i: this.inner.intern(s) }; }

    /// The string of `s` (lives as long as the arena).
    fn str(this: &Names, s: Sym): string { return this.inner.str(s.i); }

    /// Number of distinct names.
    fn len(this: &Names): int { return this.inner.len(); }
}

/// A copy of `s` in `arena` (AGENTS.md rule 1: a stored string that is not a `Sym` is an arena copy).
pub fn own(arena: &Arena, s: string): string {
    if s.len == 0 { return ""; }
    let b = arena.alloc::<u8>(s.len);
    for i in 0..s.len { b[i] = s[i]; }
    return b as string;
}
