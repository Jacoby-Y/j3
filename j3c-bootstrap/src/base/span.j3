// Source locations: a file id plus a byte range, and line/column lookup through a per-file line table.
//
// Port of: j3c/src/span.rs
// J3: Spans are real from day one (the Rust `Span::dummy` existed for hand-built IR before the parser).
// Trees keep them in a `base/ids` `Spans<T>` side table, not inline (plan 11 B4).
// J3: Byte offsets like Rust (`start`/`end` there, `lo`/`hi` here); `file` is an `Id<Source>` into the
// `Session`'s source pool. `NO_FILE` marks a span with no source (CLI flags, `j3.toml`-less errors).
module j3c.base.span;

use j3.data.pool.Id;
use j3.memory.{ Arena, List };

/// One loaded file: its path, bytes and line starts. Stored in the `Session`'s `Pool<Source>`.
pub struct Source {
    path: string;
    text: string;
    lines: Lines;
}

/// A byte range `lo..hi` of one file.
pub struct Span {
    file: Id<Source>;
    lo: u32;
    hi: u32;

    fn operator==(this: Span, o: Span): bool { return this.file == o.file && this.lo == o.lo && this.hi == o.hi; }
}

/// Not a real file id: a span with no source text.
pub const NO_FILE: u32 = 4294967295;

/// A span that points at no file (`span.file.i == NO_FILE`).
pub fn noSpan(): Span { return Span { file: Id<Source> { i: NO_FILE }, lo: 0, hi: 0 }; }

/// True for `noSpan()`.
pub fn isNone(s: Span): bool { return s.file.i == NO_FILE; }

/// A span naming `file` but no position in it (Rust's `(path, Span::dummy())`): renders as `--> path`.
pub fn fileSpan(file: Id<Source>): Span { return Span { file: file, lo: NO_FILE, hi: NO_FILE }; }

/// True for `fileSpan(..)`.
pub fn isWholeFile(s: Span): bool { return s.file.i != NO_FILE && s.lo == NO_FILE; }

/// 1-based line and column (column counts bytes, as Rust does).
pub struct LineCol {
    line: int;
    col: int;
}

/// Byte offset of each line start of one file.
pub struct Lines {
    starts: List<u32>;

    /// The line table of `text`, allocated in `arena`.
    fn of(text: string, arena: &Arena): Lines {
        let t = Lines { starts: List<u32>.new(arena) };
        t.starts.push(0);
        for i in 0..text.len {
            if text[i] == '\n' { t.starts.push(u32(i + 1)); }
        }
        return t;
    }

    /// Line and column of byte offset `off` (binary search; callers clamp `off` to the text length).
    fn at(this: &Lines, off: u32): LineCol {
        let lo = 0;
        let hi = this.starts.len - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if this.starts.items[mid] <= off { lo = mid; } else { hi = mid - 1; }
        }
        return LineCol { line: lo + 1, col: int(off - this.starts.items[lo]) + 1 };
    }

    /// Text of 1-based `line` without its line ending, "" past the end (Rust `str::lines().nth`).
    fn text(this: &Lines, src: string, line: int): string {
        if line < 1 || line > this.starts.len { return ""; }
        let a = int(this.starts.items[line - 1]);
        let b = src.len;
        if line < this.starts.len { b = int(this.starts.items[line]) - 1; }
        if a > b { return ""; }
        // `lines()` drops `\r` only before a `\n`.
        if line < this.starts.len && b > a && src[b - 1] == '\r' { b -= 1; }
        return src[a..b];
    }
}
