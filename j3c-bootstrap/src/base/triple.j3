// The host target triple: what an empty `[emit] target` means (plan 08 decision 4, plan 03 chunk 1).
module j3c.base.triple;
// J3: `j3.sys` `PLATFORM`/`ARCH` are compile-time in the j3c binary, so a j3c built for Windows resolves
// `""` to the Windows triple on its own host. Every OS/arch question about `""` goes through `resolveTriple`;
// `""` still means "this machine" where that is the question (`target/.j3c/host`, mold, no `--target=`).

use j3.sys;

/// The triple j3c uses for a host of `platform`/`arch` (`j3.sys` `PLATFORM_*`/`ARCH_*`). Pure, so tests can
/// ask for another host. macOS spells the 11.0 floor (plan 03).
pub fn tripleFor(platform: int, arch: int): string {
    let arm = arch == sys.ARCH_AARCH64;
    if platform == sys.PLATFORM_WINDOWS { return if arm { "aarch64-pc-windows-gnu" } else { "x86_64-pc-windows-gnu" }; }
    if platform == sys.PLATFORM_MACOS { return if arm { "arm64-apple-macosx11.0.0" } else { "x86_64-apple-macosx11.0.0" }; }
    if arm { return "aarch64-unknown-linux-gnu"; }
    if arch == sys.ARCH_RISCV { return "riscv64-unknown-linux-gnu"; }
    return "x86_64-pc-linux-gnu";
}

/// This machine's triple: the one j3c itself was built for.
pub fn hostTriple(): string { return tripleFor(sys.PLATFORM, sys.ARCH); }

/// `t`, or the host triple when `t` is empty.
pub fn resolveTriple(t: string): string { return if t.len == 0 { hostTriple() } else { t }; }

/// `t` names this machine: empty or the host triple.
pub fn isHost(t: string): bool { return t.len == 0 || t == hostTriple(); }
