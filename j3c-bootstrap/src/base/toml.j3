// The TOML subset `j3.toml` and the user config use: tables, strings, string arrays, ints, bools, inline
// tables. The reading is `j3.data.toml.items` (the stdlib's TOML reader, so there is one); this keeps the
// `Table` view the manifest, deps, golden and config readers want, and the subset's rules.
//
// Port of: j3c/src/project/toml.rs
module j3c.base.toml;
// J3: Strings in a `Table` are arena copies. The JSON view (`json`, Rust `toml/json.rs`) is the part
// `base/toml/json.j3`. Rust's `toml_doc` and `TomlVal::as_list` come with their callers (`manifest`,
// `j3c golden`); `list` inlines `as_list`.
// J3: Since the stdlib reader took over, the file reads full TOML lines (multi-line arrays, literal and
// multi-line strings, dotted keys, `1_000`); where it differs from Rust is in PORT_DEBT.md ("base/toml").
// Strings in a `Val` are kept as written: the decoded string escaped again (`written`), so `\u00e9` comes
// back as `é` but `unescape` still gives the same text. ponytail: a number in an inline table keeps its token.

use j3.data.json.{ Json, Kind };
use j3.data.toml;
use j3.data.toml.ItemKind;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.text.{ Text, decodeRune };
use j3c.base.text_fmt.{ isAlpha, isDigit };

/// One value (Rust `TomlVal`). Strings are kept as written; `unescape` decodes them.
pub enum Val {
    /// A quoted `"string"`.
    Str(string),
    /// An unquoted token (`true`, `2`, `1.5`, `llvm`). Read as a string everywhere except `json`, which
    /// types it.
    Bare(string),
    List(StrList),
    /// An inline table of string values, in file order.
    Map(StrMap),
}

pub struct StrList {
    items: List<string>;
}

pub struct StrMap {
    pairs: List<Pair>;
}

/// `key = "value"` in an inline table.
pub struct Pair {
    key: string;
    value: string;
}

/// `[section] key = val`, in file order.
pub struct Entry {
    section: string;
    key: string;
    val: Val;
}

/// A `[section]` header and its 1-based line (a header with no keys still counts).
pub struct Head {
    name: string;
    line: int;
}

/// A parsed file (Rust `TomlTable`): every entry, every header, and each entry's line.
pub struct Table {
    vals: List<Entry>;
    heads: List<Head>;
    lines: List<int>;

    fn hasSection(this: &Table, section: string): bool {
        for i in 0..this.heads.len {
            if this.heads.items[i].name == section { return true; }
        }
        return false;
    }

    /// The last value of `key` in `section`.
    fn get(this: &Table, section: string, key: string): Option<Val> {
        let i = this.vals.len - 1;
        while i >= 0 {
            let e = this.vals.items[i];
            if e.section == section && e.key == key { return Option.Some(e.val); }
            i -= 1;
        }
        return Option.None;
    }
}

/// The string of a `Str` / `Bare` value.
pub fn asStr(v: Val): Option<string> {
    match v {
        Val.Str(s) { return Option.Some(s); }
        Val.Bare(s) { return Option.Some(s); }
        Val.List(_) { return Option.None; }
        Val.Map(_) { return Option.None; }
    }
}

/// `j3.toml:LINE: msg`, in `arena` (every reader error has this shape; callers rename the file).
fn lineErr(arena: &Arena, line: int, msg: string): string {
    let t = Text.new(arena);
    t.add("j3.toml:");
    t.pushInt(line);
    t.add(": ").add(msg);
    return t.str();
}

/// `text` parsed; Err reads `j3.toml:3: key outside a section`, in `arena`. The lines are read by
/// `j3.data.toml.items` (the one TOML reader); this adds the subset's rules: every key under a `[section]`,
/// keys are `isIdent`, arrays hold strings, inline tables hold strings or bare tokens, no `[[...]]`.
pub fn parse(text: string, arena: &Arena): Result<Table, string> {
    let its = match toml.items(text, arena) {
        Result.Ok(x) { x }
        Result.Err(e) { return Result.Err(lineErr(arena, e.line, e.msg)); }
    };
    let section = "";
    let t = Table { vals: List<Entry>.new(arena), heads: List<Head>.new(arena), lines: List<int>.new(arena) };
    for i in 0..its.len {
        let it = its.items[i];
        match it.kind {
            ItemKind.Table {
                section = joinKeys(&it.keys, it.keys.len, arena);
                t.heads.push(Head { name: section, line: it.line });
            }
            ItemKind.ArrayTable {
                return Result.Err(lineErr(arena, it.line, "`[[...]]` (an array of tables) is not read in this file"));
            }
            ItemKind.Key {
                if section.len == 0 { return Result.Err(lineErr(arena, it.line, "key outside a section")); }
                for k in 0..it.keys.len {
                    if !isIdent(it.keys.items[k]) { return Result.Err(lineErr(arena, it.line, "bad key")); }
                }
                let key = it.keys.items[it.keys.len - 1];
                // `a.b = 1` under `[s]` is `b` in `[s.a]`
                let sec = section;
                if it.keys.len > 1 {
                    sec = Text.new(arena).add(section).add(".").add(joinKeys(&it.keys, it.keys.len - 1, arena)).str();
                }
                let val = fromJson(it.val, key, it.line, arena)?;
                t.vals.push(Entry { section: sec, key: key, val: val });
                t.lines.push(it.line);
            }
        }
    }
    return Result.Ok(t);
}

fn joinKeys(keys: &List<string>, n: int, arena: &Arena): string {
    let t = Text.new(arena);
    for i in 0..n {
        if i > 0 { t.push('.'); }
        t.add(keys.items[i]);
    }
    return t.str();
}

/// A decoded string back in its written form (`unescape` reverses it), so callers keep reading escapes.
fn written(s: string, arena: &Arena): string {
    let t = Text.new(arena);
    toml.escape(&t, s);
    return t.str();
}

/// A scalar as the subset keeps it: a string as written, a number or bool as its token, else None.
fn scalar(v: &Json, arena: &Arena): Option<Val> {
    if v.kind == Kind.Str { return Option.Some(Val.Str(written(v.s, arena))); }
    if v.kind == Kind.Num || v.kind == Kind.Bool { return Option.Some(Val.Bare(v.s)); }
    return Option.None;
}

fn fromJson(v: &Json, key: string, line: int, arena: &Arena): Result<Val, string> {
    if v.kind == Kind.Arr {
        let out = List<string>.new(arena);
        for i in 0..v.len() {
            let e = v.at(i);
            if e.kind != Kind.Str { return Result.Err(lineErr(arena, line, "expected a \"string\"")); }
            out.push(written(e.s, arena));
        }
        return Result.Ok(Val.List(StrList { items: out }));
    }
    if v.kind == Kind.Obj {
        let out = List<Pair>.new(arena);
        for i in 0..v.len() {
            match scalar(v.at(i), arena) {
                Option.Some(Val.Str(x)) { out.push(Pair { key: v.keys.items[i], value: x }); }
                Option.Some(Val.Bare(x)) { out.push(Pair { key: v.keys.items[i], value: x }); }
                _ { return Result.Err(notString(arena, line, v.keys.items[i])); }
            }
        }
        return Result.Ok(Val.Map(StrMap { pairs: out }));
    }
    match scalar(v, arena) {
        Option.Some(x) { return Result.Ok(x); }
        Option.None { return Result.Err(lineErr(arena, line, "expected a \"string\"")); }
    }
}

fn notString(arena: &Arena, lineNo: int, k: string): string {
    return lineErr(arena, lineNo, Text.new(arena).add("`").add(k).add("` in an inline table must be a string").str());
}

/// A bare key: ASCII letters, digits, `_`, `-`, not starting with a digit or `-` (Rust `is_ident`).
pub fn isIdent(s: string): bool {
    if s.len == 0 || (!isAlpha(s[0]) && s[0] != '_') { return false; }
    for i in 1..s.len {
        let c = s[i];
        if !isAlpha(c) && !isDigit(c) && c != '_' && c != '-' { return false; }
    }
    return true;
}

/// `[section] key` of `text` as a string, as written (escapes kept, as Rust), None when absent or not a
/// string (Rust `toml_str`).
pub fn str(text: string, section: string, key: string, arena: &Arena): Option<string> {
    match parse(text, arena) {
        Result.Ok(t) {
            match t.get(section, key) {
                Option.Some(v) { return asStr(v); }
                Option.None { return Option.None; }
            }
        }
        Result.Err(_) { return Option.None; }
    }
}

/// `[section] key` of `text` as a string array (Rust `toml_list`).
pub fn list(text: string, section: string, key: string, arena: &Arena): Option<List<string>> {
    match parse(text, arena) {
        Result.Ok(t) {
            match t.get(section, key) {
                Option.Some(Val.List(l)) { return Option.Some(l.items); }
                _ { return Option.None; }
            }
        }
        Result.Err(_) { return Option.None; }
    }
}

/// A quoted string's body with its escapes decoded (Rust `unescape`): `j3.data.toml.unescape`.
pub fn unescape(s: string, arena: &Arena): string {
    return toml.unescape(s, arena);
}
