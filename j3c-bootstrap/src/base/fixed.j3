// Fixed-precision float printing, Rust's `{:.N}`: the exact decimal value of the f64, rounded half to even
// at `digits` places (`0.125` -> `0.12`, `0.135` -> `0.14`, `2.5` at 0 places -> `2`), the sign kept on a
// negative zero (`-0.00`), `NaN` / `inf` / `-inf`.
//
// Port of: (Rust `format!("{:.2}")` in scene/diff.rs, `{:.6}` in gltf/mod.rs; no Rust file of its own)
// J3: `j3.text` only prints shortest round-trip floats. Exact: x = m * 2^e is m * 5^-e / 10^-e for e < 0,
// so the digits come from a decimal big number (at most ~1100 digits, a stack buffer); no float math.
module j3c.base.fixed;

use j3.text.{ Text, f64Bits };

const MAX: int = 1200;

/// Append `x` with exactly `digits` (0..=17) places after the point, as Rust `{:.digits}` prints it.
pub fn pushFixed(t: &Text, x: f64, digits: int) {
    let bits = f64Bits(x);
    let neg = (bits >> 63) != 0;
    let be = int((bits >> 52) & 0x7ff);
    let frac = bits & 0xfffffffffffff;
    if be == 0x7ff {
        if frac != 0 { t.add("NaN"); return; }
        t.add(if neg { "-inf" } else { "inf" });
        return;
    }
    if neg { t.add("-"); }
    let m = frac;
    let e = be - 1075;
    if be == 0 { e = -1074; } else { m = m | (1 << 52); }
    // d: little-endian decimal digits of m * 2^e (e >= 0) or m * 5^-e (e < 0), with `point` digits after the point
    let d: [1200]u8;
    let n = 0;
    while m > 0 { d[n] = u8(m % 10); m = m / 10; n += 1; }
    let point = 0;
    if e >= 0 {
        for k in 0..e { n = mulSmall(&d[0] as ptr, n, 2); }
    } else {
        for k in 0..-e { n = mulSmall(&d[0] as ptr, n, 5); }
        point = -e;
    }
    // keep the digits from index `cut` up (cut = point - digits); round on the ones below it
    let cut = point - digits;
    if cut > 0 {
        let up = false;
        let below = if cut - 1 < n { int(d[cut - 1]) } else { 0 };
        if below > 5 { up = true; }
        if below == 5 {
            let rest = false;
            for k in 0..min(cut - 1, n) { if d[k] != 0 { rest = true; } }
            let last = if cut < n { int(d[cut]) } else { 0 };
            up = rest || last % 2 == 1;
        }
        // drop the digits below `cut`
        if cut >= n { n = 0; } else {
            for k in cut..n { d[k - cut] = d[k]; }
            n = n - cut;
        }
        if up {
            let k = 0;
            while true {
                if k == n { d[n] = 1; n += 1; break; }
                if d[k] == 9 { d[k] = 0; k += 1; } else { d[k] += 1; break; }
            }
        }
        point = digits;
    }
    // now `point` <= digits: pad with zeros below so exactly `digits` follow the point
    let pad = digits - point;
    let width = max(n + pad, digits + 1); // at least one digit before the point
    for i in 0..width {
        let k = width - 1 - i; // index into d, counting the pad digits below
        if i == width - digits && digits > 0 { t.add("."); }
        let at = k - pad;
        t.push(if at >= 0 && at < n { u8(48) + d[at] } else { u8(48) });
    }
}

/// `d[0..n] *= f` (little-endian decimal digits, f < 10); the new length.
fn mulSmall(p: ptr, n: int, f: int): int {
    let d: []u8 = @slice(p, MAX);
    let carry = 0;
    for i in 0..n {
        let v = int(d[i]) * f + carry;
        d[i] = u8(v % 10);
        carry = v / 10;
    }
    while carry > 0 { d[n] = u8(carry % 10); carry = carry / 10; n += 1; }
    return n;
}

fn min(a: int, b: int): int { return if a < b { a } else { b }; }
fn max(a: int, b: int): int { return if a > b { a } else { b }; }
