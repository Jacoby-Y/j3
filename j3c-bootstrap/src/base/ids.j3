// Typed handles and tables: AST nodes, types, fns, modules and IR values live in per-stage `Pool<T>`s
// addressed by `Id<T>`, so an `Id<Expr>` never mixes with an `Id<Stmt>`; spans live on the side.
//
// Port of: j3c/src/ir/ids.rs
// J3: `Pool<T>` / `Id<T>` are `j3.data.pool` (use them from there; nothing is re-exported); this adds
// `Spans<T>`, a side table `Id<T>` to `Span` (plan 11 B4). Nodes carry no span inline: cheap equality and
// hashing, stage outputs that can be cached (B5), read-only tables shared across threads. Lives in base
// because AST, typed tree, IR and UI trees all use it.
// J3 (plan 13): `room` grows the big per-program tables (AST, typed tree, spans) 8x instead of List's 2x.
module j3c.base.ids;

use j3.data.pool.Id;
use j3.memory.{ Arena, List };
use j3c.base.span.{ noSpan, Span };

/// The span of each `Id<T>`, indexed like the `Pool<T>` it sits beside.
pub struct Spans<T> {
    items: List<Span>;

    /// Empty table allocating from `arena`.
    fn new(arena: &Arena): Spans<T> { return Spans<T> { items: List<Span>.new(arena) }; }

    /// Record the span of `id` (ids not set yet read as `noSpan()`).
    fn set(this: &Spans<T>, id: Id<T>, s: Span) {
        let i = int(id.i);
        while this.items.len <= i {
            room(&this.items);
            this.items.push(noSpan());
        }
        this.items.items[i] = s;
    }

    /// The span of `id`, `noSpan()` when never set.
    fn get(this: &Spans<T>, id: Id<T>): Span {
        let i = int(id.i);
        if i >= this.items.len { return noSpan(); }
        return this.items.items[i];
    }
}

/// Room for one more item in `l`: a full list grows 8x (List's own push grows 2x). Every grow leaves the old
/// buffer behind in the arena, touched; 8x leaves a seventh of the final size behind instead of all of it, and
/// the untouched tail of the new buffer costs no memory. For the big per-program tables (AST, typed tree).
pub fn room<T>(l: &List<T>) {
    if l.len < l.items.len { return; }
    l.reserve(if l.items.len < 64 { 64 } else { l.items.len * 8 });
}
