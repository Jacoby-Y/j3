// GLSL text: reserved-name mangling, number literals, fixed section order, the ES 3.0 variant.
//
// Part of module j3c.shader.
// Port of: j3c/src/emit/glsl/names.rs, emit/glsl/num.rs, emit/glsl/program.rs, emit/glsl/es.rs
// J3: Rust prints an `f32` with `{:?}`; `floatText` is `base/text_fmt.debugF32` (shared digit re-layout with `debugF64`).
module j3c.shader;
use j3.text.{ contains, endsWith, find, lastIndexOf, startsWith, trim, trimStart };
use j3c.base.text_fmt.debugF32;

// ---- names (emit/glsl/names.rs) ----

/// GLSL 3.30 core and ES 3.00 keywords, reserved words and built-in function names.
const RESERVED: [197]string = [
    "attribute", "const", "uniform", "varying", "buffer", "shared", "coherent", "volatile", "restrict", "readonly",
    "writeonly", "atomic_uint", "layout", "centroid", "flat", "smooth", "noperspective", "patch", "sample", "break",
    "continue", "do", "for", "while", "switch", "case", "default", "if", "else", "subroutine", "in", "out", "inout",
    "float", "double", "int", "void", "bool", "true", "false", "invariant", "precise", "discard", "return", "mat2",
    "mat3", "mat4", "mat2x2", "mat2x3", "mat2x4", "mat3x2", "mat3x3", "mat3x4", "mat4x2", "mat4x3", "mat4x4",
    "dmat2", "dmat3", "dmat4", "vec2", "vec3", "vec4", "ivec2", "ivec3", "ivec4", "bvec2", "bvec3", "bvec4",
    "uvec2", "uvec3", "uvec4", "dvec2", "dvec3", "dvec4", "uint", "lowp", "mediump", "highp", "precision",
    "sampler1D", "sampler2D", "sampler3D", "samplerCube", "sampler2DShadow", "sampler2DArray", "isampler2D",
    "usampler2D", "struct", "common", "partition", "active", "asm", "class", "union", "enum", "typedef", "template",
    "this", "resource", "goto", "inline", "noinline", "public", "static", "extern", "external", "interface", "long",
    "short", "half", "fixed", "unsigned", "superp", "input", "output", "filter", "sizeof", "cast", "namespace",
    "using", "main", "radians", "degrees", "sin", "cos", "tan", "asin", "acos", "atan", "sinh", "cosh", "tanh",
    "asinh", "acosh", "atanh", "pow", "exp", "log", "exp2", "log2", "sqrt", "inversesqrt", "abs", "sign", "floor",
    "trunc", "round", "roundEven", "ceil", "fract", "mod", "modf", "min", "max", "clamp", "mix", "step",
    "smoothstep", "isnan", "isinf", "floatBitsToInt", "floatBitsToUint", "intBitsToFloat", "uintBitsToFloat",
    "length", "distance", "dot", "cross", "normalize", "faceforward", "reflect", "refract", "matrixCompMult",
    "outerProduct", "transpose", "determinant", "inverse", "lessThan", "lessThanEqual", "greaterThan",
    "greaterThanEqual", "equal", "notEqual", "any", "all", "not", "texture", "textureSize", "textureLod",
    "textureProj", "texelFetch", "textureGrad", "textureOffset", "dFdx", "dFdy", "fwidth", "oColor"
];

/// Whether `name` cannot be used as is in emitted GLSL.
pub fn isReserved(name: string): bool {
    for i in 0..RESERVED.len {
        if RESERVED[i] == name { return true; }
    }
    // `v_` / `a_`: names the program writer makes for vertex inputs and varyings (Rust `is_io_name`).
    return startsWith(name, "gl_") || contains(name, "__") || startsWith(name, "j3_") || startsWith(name, "v_") || startsWith(name, "a_");
}

/// The emitted spelling of a local, parameter, field, fn, struct or const name (an arena string).
pub fn mangle(name: string, a: &Arena): string {
    if isReserved(name) { return Text.new(a).add("j3_").add(name).str(); }
    return own(a, name);
}

// ---- numbers (emit/glsl/num.rs) ----

/// A float literal GLSL reads as `float` (always has a `.` or exponent): Rust `format!("{:?}", v as f32)`.
pub fn floatText(v: f64, a: &Arena): string {
    let t = Text.new(a);
    debugF32(&t, f32(v), a);
    return t.str();
}

/// Whether `s` is a plain decimal integer literal (so `.0` or `u` can be appended to it).
pub fn isIntText(s: string): bool {
    let i = 0;
    if s.len > 0 && s[0] == '-' { i = 1; }
    if i == s.len { return false; }
    for k in i..s.len {
        if s[k] < '0' || s[k] > '9' { return false; }
    }
    return true;
}

/// `(a + b)` as `a + b`: the outer parentheses go when they wrap the whole text (statement positions need
/// none). A slice of `s`.
pub fn bare(s: string): string {
    if !(startsWith(s, "(") && endsWith(s, ")")) { return s; }
    let depth = 0;
    for i in 0..s.len {
        if s[i] == '(' { depth += 1; }
        else if s[i] == ')' {
            depth -= 1;
            if depth == 0 && i != s.len - 1 { return s; }
        }
    }
    return s[1..s.len - 1];
}

// ---- one stage's text (emit/glsl/program.rs) ----

fn renderSec(out: &Text, sec: &List<string>) {
    for i in 0..sec.len {
        let item = sec.items[i];
        out.add(item);
        if !endsWith(item, "\n") { out.push('\n'); }
    }
}

extend StageText {
    /// The stage's GLSL in the fixed section order: structs, io, uniforms, consts, fns, `main`.
    fn render(this: &StageText, a: &Arena): string {
        let out = Text.new(a);
        out.add("#version 330 core\n// ").add(this.title).add("\n");
        renderSec(&out, &this.structs);
        renderSec(&out, &this.io);
        renderSec(&out, &this.uniforms);
        renderSec(&out, &this.consts);
        renderSec(&out, &this.fns);
        out.add(this.main);
        return out.str();
    }
}

// ---- `dump-glsl --es` (emit/glsl/es.rs) ----

const SAMPLERS: [9]string = ["sampler2D", "samplerCube", "sampler3D", "sampler2DShadow", "sampler2DArray", "isampler2D", "usampler2D",
    "isampler3D", "usampler3D"];

/// Rust `lead_line`: a blank line, a comment or a directive other than a conditional, which may sit above
/// the `precision` lines.
fn leadLine(line: string): bool {
    let t = trim(line);
    if t.len == 0 || startsWith(t, "//") { return true; }
    if startsWith(t, "/*") {
        let body = t[2..t.len];
        let c = find(body, "*/");
        return c >= 0 && trim(body[c + 2..body.len]).len == 0;
    }
    if !startsWith(t, "#") { return false; }
    let d = trimStart(t[1..t.len]);
    return !(startsWith(d, "if") || startsWith(d, "else") || startsWith(d, "elif") || startsWith(d, "endif"));
}

/// The text `j3.gfx.glsl.prep(src, true)` hands an ES 3.0 driver: `#version 300 es`, the leading comment
/// lines, then the `precision` lines and the rest.
pub fn prepEs(src: string, a: &Arena): string {
    // The end of the leading lines (each line keeps its `\n`, Rust `split_inclusive`).
    let end = 0;
    let hasVersion = false;
    while end < src.len {
        let e = end;
        while e < src.len && src[e] != '\n' { e += 1; }
        if e < src.len { e += 1; }
        let line = src[end..e];
        if !leadLine(line) { break; }
        if startsWith(trimStart(line), "#version") { hasVersion = true; }
        end = e;
    }
    let out = Text.new(a);
    if !hasVersion { out.add("#version 300 es\n"); }
    let at = 0;
    while at < end {
        let e = at;
        while src[e] != '\n' && e + 1 < end { e += 1; }
        e += 1;
        let line = src[at..e];
        if startsWith(trimStart(line), "#version") { out.add("#version 300 es\n"); } else { out.add(line); }
        at = e;
    }
    out.add("precision highp float;precision highp int;");
    let rest = src[end..src.len];
    for i in 0..SAMPLERS.len {
        if contains(rest, SAMPLERS[i]) { out.add("precision highp ").add(SAMPLERS[i]).add(";"); }
    }
    out.add(rest);
    return out.str();
}
