// Shader types: scalars, vectors, matrices, samplers, structs, arrays.
//
// Part of module j3c.shader.
// Port of: j3c/src/check/gpu/ty.rs
// J3: `GTy` and `Base` are declared in `shader.j3` (shared types); this file holds their fns. Rust derives
// `==` on `GTy`; here it is `gtyEq`. Rust's `F32`/`I32`/`U32`/`BOOL` consts are the fns `gF32()` .. `gBool()`.
module j3c.shader;

pub fn gF32(): GTy { return GTy.Scalar(Base.F); }
pub fn gI32(): GTy { return GTy.Scalar(Base.I); }
pub fn gU32(): GTy { return GTy.Scalar(Base.U); }
pub fn gBool(): GTy { return GTy.Scalar(Base.B); }

/// Rust `Base::word`: the J3 name of a scalar.
pub fn baseWord(b: Base): string {
    match b {
        Base.F { return "f32"; }
        Base.I { return "i32"; }
        Base.U { return "u32"; }
        Base.B { return "bool"; }
    }
}

/// Rust `Base::prefix`: the letter before `vec`.
fn basePrefix(b: Base): string {
    match b {
        Base.F { return ""; }
        Base.I { return "i"; }
        Base.U { return "u"; }
        Base.B { return "b"; }
    }
}

/// Rust `GTy == GTy`.
pub fn gtyEq(a: GTy, b: GTy): bool {
    match a {
        GTy.Void { match b { GTy.Void { return true; } _ { return false; } } }
        GTy.Scalar(x) { match b { GTy.Scalar(y) { return x == y; } _ { return false; } } }
        GTy.Vec(x) { match b { GTy.Vec(y) { return x.base == y.base && x.n == y.n; } _ { return false; } } }
        GTy.Mat(x) { match b { GTy.Mat(y) { return x == y; } _ { return false; } } }
        GTy.Sampler(x) { match b { GTy.Sampler(y) { return x == y; } _ { return false; } } }
        GTy.Struct(x) { match b { GTy.Struct(y) { return x.key == y.key && x.glsl == y.glsl; } _ { return false; } } }
        GTy.Array(x) { match b { GTy.Array(y) { return x.len == y.len && gtyEq(*x.elem, *y.elem); } _ { return false; } } }
        GTy.LitInt { match b { GTy.LitInt { return true; } _ { return false; } } }
        GTy.LitFloat { match b { GTy.LitFloat { return true; } _ { return false; } } }
    }
}

// J3: stage 0 refuses `extend` on an enum, so the `GTy` methods of the contract are free fns taking
// `this: GTy`; they still call as `t.glsl(a)`, `t.name(a)`, `t.isFloat()` (UFCS).
/// The GLSL spelling (`vec3`, `float[4]`, a struct's emitted name).
pub fn glsl(this: GTy, a: &Arena): string {
    match this {
        GTy.Void { return "void"; }
        GTy.Scalar(b) {
            match b {
                Base.F { return "float"; }
                Base.I { return "int"; }
                Base.U { return "uint"; }
                Base.B { return "bool"; }
            }
        }
        GTy.LitFloat { return "float"; }
        GTy.LitInt { return "int"; }
        GTy.Vec(v) {
            let t = Text.new(a);
            t.add(basePrefix(v.base)).add("vec");
            t.pushInt(v.n);
            return t.str();
        }
        GTy.Mat(n) {
            let t = Text.new(a);
            t.add("mat");
            t.pushInt(n);
            return t.str();
        }
        GTy.Sampler(shadow) {
            if shadow { return "sampler2DShadow"; }
            return "sampler2D";
        }
        GTy.Struct(s) { return s.glsl; }
        GTy.Array(ar) {
            let e: GTy = *ar.elem;
            let t = Text.new(a);
            t.add(e.glsl(a)).add("[");
            t.pushU64(ar.len);
            t.add("]");
            return t.str();
        }
    }
}

/// The name in diagnostics (`f32` for a scalar, the J3 name for a struct).
pub fn name(this: GTy, a: &Arena): string {
    match this {
        GTy.Scalar(b) { return baseWord(b); }
        GTy.LitInt { return "an integer literal"; }
        GTy.LitFloat { return "a float literal"; }
        GTy.Struct(s) {
            let at = lastIndexOf(s.key, "::");
            if at < 0 { return s.key; }
            return s.key[at + 2..s.key.len];
        }
        GTy.Array(ar) {
            let e: GTy = *ar.elem;
            let t = Text.new(a);
            t.add("[");
            t.pushU64(ar.len);
            t.add("]").add(e.name(a));
            return t.str();
        }
        _ { return this.glsl(a); }
    }
}

pub fn isScalar(this: GTy): bool {
    match this {
        GTy.Scalar(b) { return true; }
        GTy.LitInt { return true; }
        GTy.LitFloat { return true; }
        _ { return false; }
    }
}

/// `f32`/`vec3`/`mat4`: float math.
pub fn isFloat(this: GTy): bool {
    match this {
        GTy.Scalar(b) { return b == Base.F; }
        GTy.LitFloat { return true; }
        GTy.Vec(v) { return v.base == Base.F; }
        GTy.Mat(n) { return true; }
        _ { return false; }
    }
}

pub fn isInt(this: GTy): bool {
    match this {
        GTy.Scalar(b) { return b == Base.I || b == Base.U; }
        GTy.LitInt { return true; }
        GTy.Vec(v) { return v.base == Base.I || v.base == Base.U; }
        _ { return false; }
    }
}

/// Scalar type of a scalar or vector (`vec3` -> `f32`).
pub fn elem(this: GTy): Option<GTy> {
    match this {
        GTy.Scalar(b) { return Option.Some(this); }
        GTy.LitInt { return Option.Some(this); }
        GTy.LitFloat { return Option.Some(this); }
        GTy.Vec(v) { return Option.Some(GTy.Scalar(v.base)); }
        _ { return Option.None; }
    }
}

/// Component count of a scalar (1) or vector.
pub fn lanes(this: GTy): Option<int> {
    match this {
        GTy.Scalar(b) { return Option.Some(1); }
        GTy.LitInt { return Option.Some(1); }
        GTy.LitFloat { return Option.Some(1); }
        GTy.Vec(v) { return Option.Some(v.n); }
        _ { return Option.None; }
    }
}

/// The type a literal settles on when nothing else decides.
pub fn settle(this: GTy): GTy {
    match this {
        GTy.LitInt { return gI32(); }
        GTy.LitFloat { return gF32(); }
        _ { return this; }
    }
}

/// `vec3`, `ivec2`, `mat4`, `sampler2D`, ... and the four scalars; None for any other word.
pub fn builtinType(name: string): Option<GTy> {
    if name == "f32" { return Option.Some(gF32()); }
    if name == "i32" { return Option.Some(gI32()); }
    if name == "u32" { return Option.Some(gU32()); }
    if name == "bool" { return Option.Some(gBool()); }
    if name == "sampler2D" { return Option.Some(GTy.Sampler(false)); }
    if name == "sampler2DShadow" { return Option.Some(GTy.Sampler(true)); }
    if name == "mat2" { return Option.Some(GTy.Mat(2)); }
    if name == "mat3" { return Option.Some(GTy.Mat(3)); }
    if name == "mat4" { return Option.Some(GTy.Mat(4)); }
    let base = Base.F;
    let at = 3;
    if startsWith(name, "ivec") { base = Base.I; at = 4; }
    else if startsWith(name, "uvec") { base = Base.U; at = 4; }
    else if startsWith(name, "bvec") { base = Base.B; at = 4; }
    else if !startsWith(name, "vec") { return Option.None; }
    if name.len != at + 1 { return Option.None; }
    let c = name[at];
    if c < '2' || c > '4' { return Option.None; }
    return Option.Some(GTy.Vec(GVec { base: base, n: int(c - '0') }));
}

/// Component count of swizzle `name` on an `n`-lane vector (`xyz`, `rg`, `stp`; one letter set), or None.
pub fn swizzleLen(name: string, n: int): Option<int> {
    if name.len == 0 || name.len > 4 { return Option.None; }
    let sets: [3]string = ["xyzw", "rgba", "stpq"];
    for s in 0..3 {
        let all = true;
        for i in 0..name.len {
            let found = false;
            for k in 0..n {
                if sets[s][k] == name[i] { found = true; }
            }
            if !found { all = false; break; }
        }
        if all { return Option.Some(name.len); }
    }
    return Option.None;
}

/// Whether the swizzle repeats a component (`xx`), which cannot be assigned to.
pub fn swizzleRepeats(name: string): bool {
    for i in 0..name.len {
        for j in i + 1..name.len {
            if name[i] == name[j] { return true; }
        }
    }
    return false;
}
