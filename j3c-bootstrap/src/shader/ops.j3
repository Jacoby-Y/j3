// Operator typing: GLSL's rules for arithmetic, comparison, logic, bits, and untyped literals.
//
// Part of module j3c.shader.
// Port of: j3c/src/check/gpu/ops.rs
// J3: Rust matches on `(&a, &b)` tuples with guards; here each operator group is a fn that answers the
// result type or None (`arith` then reports Rust's `bad`).
module j3c.shader;

pub fn opSym(op: BinOp): string {
    match op {
        BinOp.Add { return "+"; }
        BinOp.Sub { return "-"; }
        BinOp.Mul { return "*"; }
        BinOp.Div { return "/"; }
        BinOp.Rem { return "%"; }
        BinOp.Shl { return "<<"; }
        BinOp.Shr { return ">>"; }
        BinOp.BitAnd { return "&"; }
        BinOp.BitOr { return "|"; }
        BinOp.BitXor { return "^"; }
        BinOp.Eq { return "=="; }
        BinOp.Ne { return "!="; }
        BinOp.Lt { return "<"; }
        BinOp.Le { return "<="; }
        BinOp.Gt { return ">"; }
        BinOp.Ge { return ">="; }
        BinOp.And { return "&&"; }
        BinOp.Or { return "||"; }
    }
}

/// An untyped literal.
fn isLit(t: GTy): bool {
    match t {
        GTy.LitInt { return true; }
        GTy.LitFloat { return true; }
        _ { return false; }
    }
}

/// The scalar type a literal beside `t` becomes.
fn litTarget(t: GTy): Option<GTy> {
    match t {
        GTy.Mat(n) { return Option.Some(gF32()); }
        GTy.LitInt { return Option.None; }
        GTy.LitFloat { return Option.None; }
        _ { return t.elem(); }
    }
}

fn numeric(t: GTy): bool {
    match t {
        GTy.Scalar(b) { return b != Base.B; }
        GTy.Vec(v) { return v.base != Base.B; }
        GTy.Mat(n) { return true; }
        GTy.LitInt { return true; }
        GTy.LitFloat { return true; }
        _ { return false; }
    }
}

/// `i32`, `u32` or an integer literal.
fn intScalar(t: GTy): bool {
    match t {
        GTy.Scalar(b) { return b == Base.I || b == Base.U; }
        GTy.LitInt { return true; }
        _ { return false; }
    }
}

/// `+ - * /` on `a` and `b` (Rust's first `match (&a, &b)`).
pub fn arithRes(op: BinOp, a: GTy, b: GTy): Option<GTy> {
    if gtyEq(a, b) && numeric(a) { return Option.Some(a); }
    match a {
        GTy.Vec(v) {
            match b {
                GTy.Scalar(c) { if v.base == c && c != Base.B { return Option.Some(a); } }
                GTy.Mat(n) { if op == BinOp.Mul && v.base == Base.F && n == v.n { return Option.Some(a); } }
                _ {}
            }
        }
        GTy.Scalar(c) {
            match b {
                GTy.Vec(v) { if v.base == c && c != Base.B { return Option.Some(b); } }
                GTy.Mat(n) { if c == Base.F { return Option.Some(b); } }
                _ {}
            }
        }
        GTy.Mat(n) {
            match b {
                GTy.Scalar(c) { if c == Base.F { return Option.Some(a); } }
                GTy.Vec(v) { if op == BinOp.Mul && v.base == Base.F && v.n == n { return Option.Some(b); } }
                _ {}
            }
        }
        _ {}
    }
    return Option.None;
}

/// `%`: integers of one type, or an int vector and its scalar.
pub fn remRes(a: GTy, b: GTy): Option<GTy> {
    if gtyEq(a, b) && a.isInt() { return Option.Some(a); }
    match a {
        GTy.Vec(v) {
            match b {
                GTy.Scalar(c) { if v.base == c && (c == Base.I || c == Base.U) { return Option.Some(a); } }
                _ {}
            }
        }
        _ {}
    }
    return Option.None;
}

extend Gen {
    /// `v` as type `want`: a literal takes it, an exact type passes, anything else is the error every
    /// mismatch in shader code reports.
    fn coerce(this: &Gen, v: Val, want: GTy, sp: Span): Result<string, Diag> {
        let a = this.ix.arena;
        let text = v.text;
        if gtyEq(v.ty, want) { return Result.Ok(text); }
        let gotInt = false;
        let gotFloat = false;
        let gotScalar = false;
        match v.ty {
            GTy.LitInt { gotInt = true; }
            GTy.LitFloat { gotFloat = true; }
            GTy.Scalar(b) { gotScalar = true; }
            _ {}
        }
        let wantScalar = false;
        match want {
            GTy.Scalar(b) {
                wantScalar = true;
                if gotInt {
                    match b {
                        Base.F {
                            if isIntText(text) { return Result.Ok(Text.new(a).add(text).add(".0").str()); }
                            return Result.Ok(Text.new(a).add("float(").add(text).add(")").str());
                        }
                        Base.I { return Result.Ok(text); }
                        Base.U {
                            if isIntText(text) && !startsWith(text, "-") { return Result.Ok(Text.new(a).add(text).add("u").str()); }
                            return Result.Ok(Text.new(a).add("uint(").add(text).add(")").str());
                        }
                        Base.B {}
                    }
                }
                if gotFloat && b == Base.F { return Result.Ok(text); }
            }
            _ {}
        }
        let msg = Text.new(a).add("expected ").add(want.name(a)).add(", found ").add(v.ty.name(a)).str();
        if gotScalar && wantScalar {
            return Result.Err(this.errHelp(sp, msg, Text.new(a).add("convert it: `x as ").add(want.name(a)).add("`").str()));
        }
        if gotFloat && wantScalar { return Result.Err(this.errHelp(sp, msg, "an integer literal has no decimal point")); }
        return Result.Err(this.e(sp, msg));
    }

    /// Rust `arith`'s `bad`: the operator does not take these two types.
    fn arithBad(this: &Gen, op: BinOp, x: GTy, y: GTy, sp: Span): Diag {
        let a = this.ix.arena;
        let msg = Text.new(a).add("cannot apply `").add(opSym(op)).add("` to ").add(x.name(a)).add(" and ").add(y.name(a)).str();
        match x {
            GTy.Scalar(p) {
                match y {
                    GTy.Scalar(q) {
                        if p != q { return this.errHelp(sp, msg, Text.new(a).add("convert one side: `x as ").add(x.name(a)).add("`").str()); }
                    }
                    _ {}
                }
            }
            GTy.Vec(p) {
                match y {
                    GTy.Vec(q) { return this.errHelp(sp, msg, "vectors of different sizes or kinds do not combine; build one with a constructor"); }
                    _ {}
                }
            }
            _ {}
        }
        return this.e(sp, msg);
    }

    /// Both operands of `op` made concrete, and the result type.
    fn arith(this: &Gen, op: BinOp, l0: Val, r0: Val, sp: Span): Result<ArithOut, Diag> {
        let l = l0;
        let r = r0;
        if isLit(l.ty) && !isLit(r.ty) {
            match litTarget(r.ty) {
                Option.Some(t) { l = Val { text: this.coerce(l, t, sp)?, ty: t }; }
                Option.None {}
            }
        } else if isLit(r.ty) && !isLit(l.ty) {
            match litTarget(l.ty) {
                Option.Some(t) { r = Val { text: this.coerce(r, t, sp)?, ty: t }; }
                Option.None {}
            }
        } else if isLit(l.ty) && !gtyEq(l.ty, r.ty) {
            return Result.Err(this.errHelp(sp, "an integer literal and a float literal in one expression",
                "write both as floats (`2.0`) or both as integers"));
        }
        let x = l.ty;
        let y = r.ty;
        let same = gtyEq(x, y);
        let res: Option<GTy> = Option.None;
        match op {
            BinOp.Add { res = arithRes(op, x, y); }
            BinOp.Sub { res = arithRes(op, x, y); }
            BinOp.Mul { res = arithRes(op, x, y); }
            BinOp.Div { res = arithRes(op, x, y); }
            BinOp.Rem {
                res = remRes(x, y);
                match res {
                    Option.Some(t) {}
                    Option.None {
                        if x.isFloat() { return Result.Err(this.errHelp(sp, "`%` is for integers", "use `@mod(x, y)` for floats")); }
                    }
                }
            }
            BinOp.BitAnd { if same && intScalar(x) { res = Option.Some(x); } }
            BinOp.BitOr { if same && intScalar(x) { res = Option.Some(x); } }
            BinOp.BitXor { if same && intScalar(x) { res = Option.Some(x); } }
            BinOp.Shl { if same && intScalar(x) { res = Option.Some(x); } }
            BinOp.Shr { if same && intScalar(x) { res = Option.Some(x); } }
            BinOp.Lt { if same && x.isScalar() && !gtyEq(x, gBool()) { res = Option.Some(gBool()); } }
            BinOp.Le { if same && x.isScalar() && !gtyEq(x, gBool()) { res = Option.Some(gBool()); } }
            BinOp.Gt { if same && x.isScalar() && !gtyEq(x, gBool()) { res = Option.Some(gBool()); } }
            BinOp.Ge { if same && x.isScalar() && !gtyEq(x, gBool()) { res = Option.Some(gBool()); } }
            BinOp.Eq { if same && comparable(x) { res = Option.Some(gBool()); } }
            BinOp.Ne { if same && comparable(x) { res = Option.Some(gBool()); } }
            BinOp.And { if gtyEq(x, gBool()) && gtyEq(y, gBool()) { res = Option.Some(gBool()); } }
            BinOp.Or { if gtyEq(x, gBool()) && gtyEq(y, gBool()) { res = Option.Some(gBool()); } }
        }
        match res {
            Option.Some(t) { return Result.Ok(ArithOut { l: l.text, r: r.text, ty: t }); }
            Option.None { return Result.Err(this.arithBad(op, x, y, sp)); }
        }
    }
}

/// `==` / `!=` take everything but samplers, arrays and void.
fn comparable(t: GTy): bool {
    match t {
        GTy.Sampler(s) { return false; }
        GTy.Array(ar) { return false; }
        GTy.Void { return false; }
        _ { return true; }
    }
}
