// The `@name(..)` builtins shader code may call: one table with the argument rule, the GLSL name and
// the stage that has it.
//
// Part of module j3c.shader.
// Port of: j3c/src/check/gpu/builtins.rs
// J3: `Only` is declared in `shader.j3`. Rust's `F2 { scalar2 }` is the two rules `F2` and `F2s`. The
// parser's name list is `INTRINSIC_GPU` (`syntax/token`); the row count is checked in
// `tests/unit/shader_leaf_test.j3`.
module j3c.shader;

enum Rule {
    /// float scalar or vector -> same
    F1,
    /// float or signed int scalar or vector -> same
    N1,
    /// two floats of one type
    F2,
    /// two floats of one type; the second may be an `f32` when the first is a vector
    F2s,
    /// float or int, min/max: second may be a scalar
    MinMax,
    Mix,
    Clamp,
    Step,
    Smooth,
    Dot,
    Length,
    Distance,
    Cross,
    Reflect,
    Refract,
    Mat1,
    Texture,
    TextureLod,
    TexelFetch,
    TextureSize,
    /// `gl_FragCoord`: a vec4
    FragCoord,
    /// `gl_VertexID`: an i32
    VertexId,
    /// `discard;`
    Discard,
}

pub struct Builtin {
    name: string;
    glsl: string;
    min: int;
    max: int;
    rule: Rule;
    only: Only;
}

/// Number of rows in `builtinTable`.
pub const BUILTINS: int = 39;

/// Everything here exists in both GLSL 3.30 and ES 3.00, so a shader that checks is valid on both. To add a
/// builtin, add a row (and its name to `INTRINSIC_GPU` in `syntax/parse`).
const TABLE: [39]Builtin = [
    Builtin { name: "sin", glsl: "sin", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "cos", glsl: "cos", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "tan", glsl: "tan", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "exp", glsl: "exp", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "log", glsl: "log", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "sqrt", glsl: "sqrt", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "floor", glsl: "floor", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "ceil", glsl: "ceil", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "fract", glsl: "fract", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "normalize", glsl: "normalize", min: 1, max: 1, rule: Rule.F1, only: Only.Any },
    Builtin { name: "fwidth", glsl: "fwidth", min: 1, max: 1, rule: Rule.F1, only: Only.Fragment },
    Builtin { name: "dFdx", glsl: "dFdx", min: 1, max: 1, rule: Rule.F1, only: Only.Fragment },
    Builtin { name: "dFdy", glsl: "dFdy", min: 1, max: 1, rule: Rule.F1, only: Only.Fragment },
    Builtin { name: "abs", glsl: "abs", min: 1, max: 1, rule: Rule.N1, only: Only.Any },
    Builtin { name: "sign", glsl: "sign", min: 1, max: 1, rule: Rule.N1, only: Only.Any },
    Builtin { name: "pow", glsl: "pow", min: 2, max: 2, rule: Rule.F2, only: Only.Any },
    Builtin { name: "atan", glsl: "atan", min: 1, max: 2, rule: Rule.F2, only: Only.Any },
    Builtin { name: "mod", glsl: "mod", min: 2, max: 2, rule: Rule.F2s, only: Only.Any },
    Builtin { name: "min", glsl: "min", min: 2, max: 2, rule: Rule.MinMax, only: Only.Any },
    Builtin { name: "max", glsl: "max", min: 2, max: 2, rule: Rule.MinMax, only: Only.Any },
    Builtin { name: "mix", glsl: "mix", min: 3, max: 3, rule: Rule.Mix, only: Only.Any },
    Builtin { name: "clamp", glsl: "clamp", min: 3, max: 3, rule: Rule.Clamp, only: Only.Any },
    Builtin { name: "step", glsl: "step", min: 2, max: 2, rule: Rule.Step, only: Only.Any },
    Builtin { name: "smoothstep", glsl: "smoothstep", min: 3, max: 3, rule: Rule.Smooth, only: Only.Any },
    Builtin { name: "dot", glsl: "dot", min: 2, max: 2, rule: Rule.Dot, only: Only.Any },
    Builtin { name: "length", glsl: "length", min: 1, max: 1, rule: Rule.Length, only: Only.Any },
    Builtin { name: "distance", glsl: "distance", min: 2, max: 2, rule: Rule.Distance, only: Only.Any },
    Builtin { name: "cross", glsl: "cross", min: 2, max: 2, rule: Rule.Cross, only: Only.Any },
    Builtin { name: "reflect", glsl: "reflect", min: 2, max: 2, rule: Rule.Reflect, only: Only.Any },
    Builtin { name: "refract", glsl: "refract", min: 3, max: 3, rule: Rule.Refract, only: Only.Any },
    Builtin { name: "transpose", glsl: "transpose", min: 1, max: 1, rule: Rule.Mat1, only: Only.Any },
    Builtin { name: "inverse", glsl: "inverse", min: 1, max: 1, rule: Rule.Mat1, only: Only.Any },
    Builtin { name: "texture", glsl: "texture", min: 2, max: 2, rule: Rule.Texture, only: Only.Any },
    Builtin { name: "textureLod", glsl: "textureLod", min: 3, max: 3, rule: Rule.TextureLod, only: Only.Any },
    Builtin { name: "texelFetch", glsl: "texelFetch", min: 3, max: 3, rule: Rule.TexelFetch, only: Only.Any },
    Builtin { name: "textureSize", glsl: "textureSize", min: 2, max: 2, rule: Rule.TextureSize, only: Only.Any },
    Builtin { name: "discard", glsl: "discard", min: 0, max: 0, rule: Rule.Discard, only: Only.Fragment },
    Builtin { name: "vertexId", glsl: "gl_VertexID", min: 0, max: 0, rule: Rule.VertexId, only: Only.Vertex },
    Builtin { name: "fragCoord", glsl: "gl_FragCoord", min: 0, max: 0, rule: Rule.FragCoord, only: Only.Fragment },
];

pub fn builtinTable(): [39]Builtin { return TABLE; }

/// The row of `name` (without the `@`).
pub fn builtinLookup(name: string): Option<Builtin> {
    for i in 0..BUILTINS {
        if TABLE[i].name == name { return Option.Some(TABLE[i]); }
    }
    return Option.None;
}

/// A float scalar or vector.
fn gf(t: GTy): bool {
    match t {
        GTy.Scalar(b) { return b == Base.F; }
        GTy.Vec(v) { return v.base == Base.F; }
        _ { return false; }
    }
}

/// A float or `i32` scalar or vector; `u32` too when `unsigned`.
fn gn(t: GTy, unsigned: bool): bool {
    let b = Base.B;
    match t {
        GTy.Scalar(x) { b = x; }
        GTy.Vec(v) { b = v.base; }
        _ { return false; }
    }
    return b == Base.F || b == Base.I || (unsigned && b == Base.U);
}

/// `x` is `t` itself, or (for a vector `t`) a scalar of its element type.
fn sameOrScalar(t: GTy, x: GTy): bool {
    if gtyEq(x, t) { return true; }
    match t {
        GTy.Vec(v) { return gtyEq(GTy.Scalar(v.base), x); }
        _ { return false; }
    }
}

fn isMat(t: GTy): bool { match t { GTy.Mat(n) { return true; } _ { return false; } } }
fn isSampler(t: GTy): bool { match t { GTy.Sampler(s) { return true; } _ { return false; } } }
fn fvec(n: int): GTy { return GTy.Vec(GVec { base: Base.F, n: n }); }

extend Builtin {
    /// The result type for these (already literal-resolved) argument types, or what the call wants.
    fn result(this: Builtin, a: &List<GTy>): Result<GTy, string> {
        let a0 = GTy.Void;
        let a1 = GTy.Void;
        let a2 = GTy.Void;
        if a.len > 0 { a0 = a.items[0]; }
        if a.len > 1 { a1 = a.items[1]; }
        if a.len > 2 { a2 = a.items[2]; }
        match this.rule {
            Rule.F1 {
                if gf(a0) { return Result.Ok(a0); }
                return Result.Err("an f32 or a float vector");
            }
            Rule.N1 {
                if gn(a0, false) { return Result.Ok(a0); }
                return Result.Err("an f32/i32 or a vector of them");
            }
            Rule.F2 {
                if !gf(a0) { return Result.Err("float arguments of one type"); }
                if a.len == 1 || gtyEq(a1, a0) { return Result.Ok(a0); }
                return Result.Err("two floats of one type");
            }
            Rule.F2s {
                if !gf(a0) { return Result.Err("float arguments of one type"); }
                if a.len == 1 || gtyEq(a1, a0) || sameOrScalar(a0, a1) { return Result.Ok(a0); }
                return Result.Err("two floats of one type (the second may be an f32)");
            }
            Rule.MinMax {
                if gn(a0, true) && sameOrScalar(a0, a1) { return Result.Ok(a0); }
                return Result.Err("two numbers of one type (the second may be a scalar)");
            }
            Rule.Mix {
                if gf(a0) && gtyEq(a1, a0) && sameOrScalar(a0, a2) { return Result.Ok(a0); }
                return Result.Err("(x, y, t): x and y one float type, t the same or an f32");
            }
            Rule.Clamp {
                if gn(a0, true) && sameOrScalar(a0, a1) && sameOrScalar(a0, a2) { return Result.Ok(a0); }
                return Result.Err("(x, lo, hi): lo and hi the type of x or a scalar");
            }
            Rule.Step {
                if gf(a1) && sameOrScalar(a1, a0) { return Result.Ok(a1); }
                return Result.Err("(edge, x): edge the type of x or an f32");
            }
            Rule.Smooth {
                if gf(a2) && gtyEq(a1, a0) && sameOrScalar(a2, a0) { return Result.Ok(a2); }
                return Result.Err("(edge0, edge1, x): edges the type of x or f32");
            }
            Rule.Dot {
                if gf(a0) && gtyEq(a1, a0) { return Result.Ok(gF32()); }
                return Result.Err("two float vectors of one size");
            }
            Rule.Length {
                if gf(a0) { return Result.Ok(gF32()); }
                return Result.Err("a float vector");
            }
            Rule.Distance {
                if gf(a0) && gtyEq(a1, a0) { return Result.Ok(gF32()); }
                return Result.Err("two float vectors of one size");
            }
            Rule.Cross {
                if gtyEq(a0, fvec(3)) && gtyEq(a1, a0) { return Result.Ok(a0); }
                return Result.Err("two vec3");
            }
            Rule.Reflect {
                if gf(a0) && gtyEq(a1, a0) { return Result.Ok(a0); }
                return Result.Err("(incident, normal) of one float type");
            }
            Rule.Refract {
                if gf(a0) && gtyEq(a1, a0) && gtyEq(a2, gF32()) { return Result.Ok(a0); }
                return Result.Err("(incident, normal, eta: f32)");
            }
            Rule.Mat1 {
                if isMat(a0) { return Result.Ok(a0); }
                return Result.Err("a matrix");
            }
            Rule.Texture {
                if gtyEq(a0, GTy.Sampler(false)) && gtyEq(a1, fvec(2)) { return Result.Ok(fvec(4)); }
                if gtyEq(a0, GTy.Sampler(true)) && gtyEq(a1, fvec(3)) { return Result.Ok(gF32()); }
                return Result.Err("(sampler2D, vec2) or (sampler2DShadow, vec3)");
            }
            Rule.TextureLod {
                if gtyEq(a0, GTy.Sampler(false)) && gtyEq(a1, fvec(2)) && gtyEq(a2, gF32()) { return Result.Ok(fvec(4)); }
                return Result.Err("(sampler2D, vec2, lod: f32)");
            }
            Rule.TexelFetch {
                if gtyEq(a0, GTy.Sampler(false)) && gtyEq(a1, GTy.Vec(GVec { base: Base.I, n: 2 })) && gtyEq(a2, gI32()) { return Result.Ok(fvec(4)); }
                return Result.Err("(sampler2D, ivec2, lod: i32)");
            }
            Rule.TextureSize {
                if isSampler(a0) && gtyEq(a1, gI32()) { return Result.Ok(GTy.Vec(GVec { base: Base.I, n: 2 })); }
                return Result.Err("(sampler, lod: i32)");
            }
            Rule.FragCoord { return Result.Ok(fvec(4)); }
            Rule.VertexId { return Result.Ok(gI32()); }
            Rule.Discard { return Result.Ok(GTy.Void); }
        }
    }
}
