// A package's tools, from its own `j3.toml`: `[commands]` (run by `j3c pkg NAME CMD`) and `[dist_outputs]`
// (run by `j3c build --release` when the game's `[dist] build_outputs` names one). Each entry is
// `name = "tools/x.j3"` or `name = { file = "tools/x.j3", help = "one line" }`; the file is relative to the
// package root (beside `j3.toml`) and must exist.
//
// Port of: j3c/src/project/deps/tools.rs
module j3c.project.deps;
// J3: A part of `project/deps.j3` (its `use`s). `Tool.help` "" stands for Rust's None (`hasHelp` tells).

/// One command or dist output of a package.
pub struct Tool {
    /// A TOML key (`isIdent`: a letter or `_`, then letters, digits, `-`, `_`).
    name: string;
    /// Absolute path of the entry `.j3` (under the dep's `pkgRoot`).
    file: string;
    /// One line for listings; `hasHelp` false when not given.
    help: string;
    hasHelp: bool;
}

/// The tools under `[section]` of the dep `dep` (its `j3.toml` at `tomlPath`, package root `pkgRoot`).
fn readTools(dep: string, tomlPath: string, tbl: &Table, pkgRoot: string, section: string, arena: &Arena): Result<List<Tool>, string> {
    for i in 0..tbl.heads.len {
        let h = tbl.heads.items[i];
        if h.name.len > section.len && h.name[0..section.len] == section && h.name[section.len] == '.' {
            let name = h.name[section.len + 1..h.name.len];
            let t = Text.new(arena);
            t.add(tomlPath).add(":");
            t.pushInt(h.line);
            t.add(": package `").add(dep).add("` [").add(h.name).add("]: sub-tables are not read; under [").add(section);
            t.add("] write `").add(name).add(" = { file = \"tools/").add(name).add(".j3\", help = \"one line\" }`");
            return Result.Err(t.str());
        }
    }
    let out = List<Tool>.new(arena);
    for i in 0..tbl.vals.len {
        let ent = tbl.vals.items[i];
        if ent.section != section { continue; }
        let key = ent.key;
        let at = Text.new(arena);
        at.add(tomlPath).add(":");
        at.pushInt(tbl.lines.items[i]);
        at.add(": package `").add(dep).add("` [").add(section).add("] ").add(key).add(": ");
        let head = at.str();
        let usage = Text.new(arena);
        usage.add("write `").add(key).add(" = \"tools/").add(key).add(".j3\"` or `").add(key);
        usage.add(" = { file = \"tools/").add(key).add(".j3\", help = \"one line\" }`");
        let use_ = usage.str();
        let tool = Tool { name: key, file: "", help: "", hasHelp: false };
        let rel = "";
        match ent.val {
            Val.Str(f) { rel = f; }
            Val.Bare(f) { rel = f; }
            Val.Map(kv) {
                for j in 0..kv.pairs.len {
                    let n = kv.pairs.items[j].key;
                    if n != "file" && n != "help" {
                        return Result.Err(Text.new(arena).add(head).add("unknown key `").add(n).add("`; ").add(use_).str());
                    }
                }
                // the last of each key, as Rust's `rev().find`
                let hasFile = false;
                for j in 0..kv.pairs.len {
                    let p = kv.pairs.items[j];
                    if p.key == "file" { rel = p.value; hasFile = true; }
                    if p.key == "help" { tool.help = p.value; tool.hasHelp = true; }
                }
                if !hasFile { return Result.Err(Text.new(arena).add(head).add("no `file`; ").add(use_).str()); }
            }
            Val.List(_) {
                return Result.Err(Text.new(arena).add(head).add("must be a string (a file) or an inline table; ").add(use_).str());
            }
        }
        tool.file = path.join(pkgRoot, rel, arena);
        if !isFile(tool.file) {
            return Result.Err(Text.new(arena).add(head).add("no file `").add(rel).add("` (looked for ").add(tool.file).add(")").str());
        }
        for j in 0..out.len {
            if out.items[j].name == key { return Result.Err(Text.new(arena).add(head).add("listed twice").str()); }
        }
        out.push(tool);
    }
    return Result.Ok(out);
}

/// The index of the dep whose `[dist_outputs]` has `name` and of that tool in it, or (-1, -1).
/// `checkDistUnique` makes it at most one (Rust `dist_provider`).
pub fn distProvider(deps: &List<Dep>, name: string): (int, int) {
    for i in 0..deps.len {
        let d = deps.items[i];
        for j in 0..d.distOutputs.len { if d.distOutputs.items[j].name == name { return (i, j); } }
    }
    return (-1, -1);
}

/// Two deps providing the same dist output is an error: `build_outputs = ["x"]` must name one tool.
fn checkDistUnique(deps: &List<Dep>, arena: &Arena): Result<bool, string> {
    for i in 0..deps.len {
        let d = deps.items[i];
        for k in 0..d.distOutputs.len {
            let tn = d.distOutputs.items[k].name;
            for oi in 0..i {
                let other = deps.items[oi];
                let clash = false;
                for x in 0..other.distOutputs.len { if other.distOutputs.items[x].name == tn { clash = true; } }
                if clash {
                    let t = Text.new(arena);
                    t.add("[dist_outputs] ").add(tn).add(": provided by both `").add(other.name).add("` (");
                    t.add(path.join(other.pkgRoot, "j3.toml", arena)).add(") and `").add(d.name).add("` (");
                    t.add(path.join(d.pkgRoot, "j3.toml", arena)).add("); depend on only one of them");
                    return Result.Err(t.str());
                }
            }
        }
    }
    return Result.Ok(true);
}
