// `j3.appconfig`: `[splash]` and `[dist] icon` baked in as constants.
//
// Port of: j3c/src/appconfig.rs
module j3c.project.appconfig;
// J3: The module is made in memory by the loader (like `j3.i18nconfig`), so a built binary needs no
// j3.toml; `j3.app` reads it (`App.run` shows the splash and sets the window icon).

use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.text.{ Text, parseF64 };
use j3c.base.fsx;
use j3c.base.text_fmt.{ debugF64, pushEscaped };
use j3c.base.toml;

pub const MODULE: string = "j3.appconfig";
pub const LABEL: string = "<j3.appconfig>";

fn on(text: string, k: string, d: bool, arena: &Arena): bool {
    match toml.str(text, "splash", k, arena) { Option.Some(v) { return v == "true"; } Option.None { return d; } }
}

fn num(text: string, k: string, arena: &Arena): Option<f64> {
    match toml.str(text, "splash", k, arena) { Option.Some(v) { return parseF64(v); } Option.None { return Option.None; } }
}

/// `p` ends with `.png` in any ASCII case.
fn isPng(p: string): bool {
    if p.len < 4 { return false; }
    let e = p[p.len - 4..p.len];
    return e[0] == '.' && (e[1] | 32) == 'p' && (e[2] | 32) == 'n' && (e[3] | 32) == 'g';
}

/// The `j3.appconfig` source for the project at `root`.
pub fn configModule(root: string, arena: &Arena): string {
    let text = match fsx.readText(path.join(root, "j3.toml", arena), arena) { Result.Ok(t) { t } Result.Err(_) { "" } };
    let cardSize: f64 = 0.35;
    match num(text, "card_size", arena) {
        Option.Some(f) { cardSize = if f < 0.05 { 0.05 } else if f > 1.0 { 1.0 } else { f }; }
        Option.None {}
    }
    let cardMs = 1800;
    match num(text, "card_time", arena) {
        Option.Some(s) {
            // Rust `as i64` saturates and maps NaN to 0; `.max(0)` below drops the negatives
            let ms = s * 1000.0;
            cardMs = if !(ms > 0.0) { 0 } else if ms >= 9223372036854775807.0 { 9223372036854775807 } else { int(ms) };
        }
        Option.None {}
    }
    // The window icon loads PNGs only; an .svg `[dist] icon` still goes into packages, and the window keeps the logo.
    let icon = "";
    match toml.str(text, "dist", "icon", arena) {
        Option.Some(p) { if isPng(p) { icon = p; } }
        Option.None {}
    }
    let t = Text.new(arena);
    t.add("/// `[splash]` and `[dist] icon` of j3.toml, baked in at build time.\nmodule j3.appconfig;\n");
    t.add("pub const SPLASH: bool = ").add(if on(text, "enabled", false, arena) { "true" } else { "false" });
    t.add(";\npub const LOGO: bool = ").add(if on(text, "logo", true, arena) { "true" } else { "false" });
    let light = match toml.str(text, "splash", "theme", arena) { Option.Some(v) { v == "light" } Option.None { false } };
    t.add(";\npub const LIGHT: bool = ").add(if light { "true" } else { "false" });
    t.add(";\npub const SKIPPABLE: bool = ").add(if on(text, "skippable", true, arena) { "true" } else { "false" });
    t.add(";\npub const CARD_MS: int = ");
    t.pushInt(if cardMs < 0 { 0 } else { cardMs });
    t.add(";\npub const CARD_SIZE: f32 = ");
    debugF64(&t, cardSize, arena);
    t.add(";\npub const CARDS: string = \"");
    match toml.list(text, "splash", "cards", arena) {
        Option.Some(cards) {
            for i in 0..cards.len {
                if i > 0 { t.add("\\n"); }
                pushEscaped(&t, cards.items[i], true);
            }
        }
        Option.None {}
    }
    t.add("\";\npub const ICON: string = \"");
    pushEscaped(&t, icon, false); // Rust: cards get `\n`, the icon does not
    t.add("\";\n");
    return t.str();
}
