// Typed IR: a program is modules of structs, enums, globals and fns; a fn body is locals plus structured
// blocks.
// Every backend reads this and only this.
//
// Port of: j3c/src/ir/mod.rs, ir/module.rs, ir/body.rs
// J3: The IR data model is Rust's, field for field (plan 11 B11), so `ir/dump` prints Rust's text. Entity
// ids are `Id<T>` handles (B4, AGENTS.md rule 4): Rust `Ty` is `Id<TyKind>`, `StructId` `Id<StructDef>`,
// `EnumId` `Id<EnumDef>`, `FuncId` `Id<Func>`, `GlobalId` `Id<GlobalDef>` (all pools of `IrCx`, in the
// Session arena) and `LocalId` `Id<LocalDecl>` (the pool of its `Body`). `FieldId`/`VariantId` keep
// Rust's (owner, index) pairs. Stage 0 has no type aliases, so the long names are spelled out.
// J3: Statements, rvalues, operands and places are values (lists inside lists, as in Rust), not pooled:
// they never cross a stage alone, and `fast`/`devmode` rewrite them in place through `Body.block`.
// J3: Rust variants with fields become payload structs (stage 0 takes no generic or imported enum
// payload): `StmtKind::If { cond, then_block, else_block }` is `StmtKind.If(IfStmt { cond, thenBlock,
// elseBlock })`; the names are in each part's header and in `.swarm-opus/11-port/contracts-c2a-ir.md`.
// J3: Every `use` of module `j3c.ir` is here except the ones `ir/passes.j3` already has (`Arena`,
// `monotonicMs`, `Text`, `Diags`, `Severity`, `Phases`, `noSpan`): stage 0 rejects a duplicate `use`
// across part files.
// J3: `Program` (Rust `check::Program`, its IR half: `cx` + `modules`) lives here because every pass and
// backend takes it. The LSP/hover half (exports, docs, traits, warnings, fixes) belongs to `sema`.
// ir/ids.rs is `base/ids.j3` plus `FieldId`/`VariantId` below; ir/build.rs is `ir/build.j3`.
module j3c.ir;

use j3.data.map.Map;
use j3.data.pool.{ Id, Pool };
use j3.memory.List;
use j3.option.Option;
use j3.sys.panic;
use j3c.base.intern.{ Names, Sym, own };
use j3c.base.span.{ Source, Span };
use j3c.syntax.ast.{ AtomicOp, AtomicOrder };

/// One compile's IR: the entity tables and the modules in emit order.
pub struct Program {
    cx: IrCx;
    modules: List<Module>;

    /// Empty program: a fresh `IrCx` over the Session's arena, names and sources.
    fn new(arena: &Arena, names: &Names, sources: &Pool<Source>): Program {
        return Program { cx: IrCx.new(arena, names, sources), modules: List<Module>.new(arena) };
    }
}

/// A compiled module. Item bodies live on `Func` in the cx.
pub struct Module {
    /// Rust `name` (the module path).
    name: List<Sym>;
    structs: List<Id<StructDef>>;
    enums: List<Id<EnumDef>>;
    funcs: List<Id<Func>>;
    globals: List<Id<GlobalDef>>;

    fn new(arena: &Arena, name: List<Sym>): Module {
        return Module { name: name, structs: List<Id<StructDef>>.new(arena), enums: List<Id<EnumDef>>.new(arena),
            funcs: List<Id<Func>>.new(arena), globals: List<Id<GlobalDef>>.new(arena) };
    }
}

/// Field `index` of struct `structId` (Rust `FieldId`).
pub struct FieldId {
    structId: Id<StructDef>;
    index: u32;

    fn operator==(this: FieldId, o: FieldId): bool { return this.structId == o.structId && this.index == o.index; }
}

/// Variant `index` of enum `enumId` (Rust `VariantId`).
pub struct VariantId {
    enumId: Id<EnumDef>;
    index: u32;

    fn operator==(this: VariantId, o: VariantId): bool { return this.enumId == o.enumId && this.index == o.index; }
}

pub enum LocalKind {
    Param,
    Let,
    Const,
    /// Compiler temporary (e.g. `ref` of a place before a call).
    Tmp,
}

pub struct LocalDecl {
    id: Id<LocalDecl>;
    /// Arena copy, "" for none.
    doc: string;
    name: Sym;
    ty: Id<TyKind>;
    access: Access;
    kind: LocalKind;
    span: Span;
}

pub struct Block {
    stmts: List<Stmt>;

    fn empty(arena: &Arena): Block { return Block { stmts: List<Stmt>.new(arena) }; }
}

/// A fn body: locals plus a structured block.
pub struct Body {
    locals: Pool<LocalDecl>;
    params: List<Id<LocalDecl>>;
    block: Block;

    /// The decl of `id` (a copy; Rust `&LocalDecl`).
    fn local(this: &Body, id: Id<LocalDecl>): LocalDecl { return *this.locals.get(id); }
}
