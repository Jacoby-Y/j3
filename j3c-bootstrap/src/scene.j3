// `j3c -e scene` / `render`: scene edits and checks by object name.
//
// Port of: j3c/src/scene/mod.rs
// J3: In-process (plan 11 B12.1): uses `j3c/editor/src/tool.j3` (and `tool/` parts) and `j3.scene3d`
// directly. No editor build, no spawn per call, no per-version editor cache for headless ops. `render`
// needs GL: it stays an offscreen-SDL subprocess of the editor program (`editor/frontend`, cache
// `~/.cache/j3/editor-boot`; C5 decision: `render.cli` pulls most of the editor, and a GL driver crash must not
// kill a long-lived MCP server). With an editor open, edits go through Rust's events/replies file protocol;
// `j3.instance` (B12.2) needs an edit in the frozen `j3c/editor/src` and is deferred. Tool args and help come
// from the one tool table below (`tools`, types in `mcp/schema`, B12.3): one entry per MCP tool, in the Rust `TOOLS` order (the `--tools` text follows it). Each `run` is a
// named fn in `mcp/ops.j3` (the MCP server's `run_tool` arms); `-e scene` itself goes through `scene/ops`.
// J3: The `-e scene` / `-e render` usage texts are Rust's `USAGE` / `RENDER_USAGE`, embedded from
// `scene/usage.txt` and `scene/render_usage.txt` (each ends in the newline `println!` adds).
module j3c.scene;

use j3.data.json;
use j3.data.json.Json;
use j3.memory.{ Arena, List };
use j3.io.path;
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.text.Text;
use j3c.base.fsx;
use j3c.scene.diff;
use j3c.scene.history;
use j3c.scene.ops;
use j3c.scene.ops.BATCH;
use j3c.scene.patterns;
use j3c.scene.reply;
use j3c.scene.reply.Reply;
use j3c.mcp.ops.{ assetFetch, assetOnlineSearch, assetSearch, check, console, gen, import, place, play, render, sceneAdd, sceneAddMany,
    sceneApply, sceneDelete, sceneDiff, sceneFmt, sceneGet, sceneInline, sceneList, sceneSet, sceneSplit, sceneStats, undo };
use j3c.mcp.schema.{ Hint, Tool, def, entry, flag, integer, listOf, most, number, numList, object, oneOf, req, strList, text, vec3, withProps };

/// The scene tool table (one entry per MCP tool and `-e scene` op), allocated in `arena`.
pub fn tools(arena: &Arena): []Tool {
    let t = List<Tool>.new(arena);
    t.push(entry("scene_list", "List scene objects", "j3c -e scene list", Hint.ReadOnly,
        "Start here to learn what a scene holds (filter with a glob; group_by prefix counts names like DecoCorn). List every object in a scene: #id, Parent/Child path, kind (group, mesh, camera, light, instance), asset, world position, rotation (degrees), scale, script. Objects placed by an instance (another scene file) are not listed; edit that scene instead.",
        [
            text("scene", "Scene file, e.g. scenes/main.j3scene. Default: the scene in j3.editor.toml."),
            text("filter", "Only objects whose id, path, or kind contains this text; with * or ? a glob on name or path (DecoCorn*)."),
            text("group_by", "Count objects by name with trailing digits dropped instead of listing them.").oneOf("prefix"),
            flag("tree", "Print the objects as the scene file writes them: one line each, indent is depth, `Name kind key=value #id`. scene_apply takes those lines back."),
        ], sceneList, arena));
    t.push(entry("scene_get", "Get an object", "j3c -e scene get <object>|@scene", Hint.ReadOnly,
        "One object as the scene file writes it (its line, then its children's, indented; scene_apply takes the lines back), then all its fields including its script's props (param.<prop>). Pass node \"@scene\" for scene lighting (sun, sky, fog, shadows, URP).",
        [
            text("node", "Name, Parent/Child path, #id, or @scene.").req(),
            text("scene", ""),
        ], sceneGet, arena));
    t.push(entry("scene_add", "Add an object", "j3c -e scene add <kind> key=value ...", Hint.None,
        "Add one object and return its #id and path. For more than a few, use scene_add_many, or place for rings, walls, stairs, grids and scatter. Shapes (cube, sphere, cylinder, cone, capsule, torus, quad, plane, sky) are meshes with that built-in asset. Top-level meshes rest on y=0 unless pos is given; names are made unique. For a mesh file use kind mesh with fields.asset; to place another scene use kind instance with fields.scene.",
        [
            text("kind", "").oneOf("group|mesh|camera|light|instance|cube|sphere|cylinder|cone|capsule|torus|quad|plane|sky").req(),
            text("name", ""),
            text("parent", "Parent object (name, path, or #id); default top level."),
            object("fields", "Same keys as scene_set, e.g. {\"pos\":[0,1,0],\"scale\":2,\"material\":\"assets/materials/wood.j3mat\"}."),
            text("scene", ""),
        ], sceneAdd, arena));
    t.push(entry("scene_add_many", "Add several objects", "", Hint.None,
        "Use this (or place) instead of many scene_add calls. Add several objects in one step (one file write, or one undo step in the editor). Each item is a scene_add argument object. All or nothing: if one fails, none are added.",
        [
            listOf("adds", object("", "").withProps([text("kind", "").req(), text("name", ""), text("parent", ""), object("fields", "")], arena), arena, "").req(),
            text("scene", ""),
        ], sceneAddMany, arena));
    t.push(entry("scene_apply", "Write objects as scene lines", "j3c -e scene apply FILE|-", Hint.None,
        "Add or replace objects written the way the scene file writes them, which is what scene_get and scene_list tree print: `Name kind key=value ... #id`, two spaces of indent per level of nesting, `//` lines above an object are its note. Kinds: group, mesh [path], place <scene>, light, camera, or a shape (cube sphere cylinder cone capsule torus quad plane sky). Keys: pos rot (degrees) scale (one number or three) tint color range fov near far material (grain means assets/materials/grain.j3mat) texture fx alpha opacity doubleSided script tags param.<prop>=value prop.<name>=value. Numbers with a . are floats, \"text\" is a string, #7 is an object. A line whose #id is an object in the scene replaces that object: fields it leaves out go back to their defaults (use scene_set to change one field). A line without #id, or with an unused one, adds an object with a new id; objects it nests keep their place under it, and #refs between new lines follow. Top-level lines go under parent. One undo step; all or nothing. Use it to add many varied objects at once, copy a subtree (get it, edit the lines, drop the ids), or rewrite one object whole.",
        [
            text("lines", "The object lines, separated by newlines.").req(),
            text("parent", "Object to put the top-level lines under (name, path, or #id); default top level."),
            text("scene", ""),
        ], sceneApply, arena));
    t.push(entry("scene_split", "Move objects into their own scene file", "j3c -e scene split <object> ... out=FILE", Hint.None,
        "Move top-level objects, and everything under them, into a new scene file out (project-relative, must not exist yet), keeping their params. With center the new file is centred on the objects' middle (x, z); with instance a placed copy of the new file is left where they were, so the world looks the same and the part can be edited or reused on its own. Use it to break a big scene into regions or to make a reusable piece (a house, a tree); a game can load several files into one world with scene3d.loadParts. Objects inside another object must be moved to the top level first (scene_set parent \"\").",
        [
            text("node", "Object to move (name, path, #id, or a glob)."),
            strList("nodes", ""),
            text("out", "New scene file, e.g. scenes/biomes/forest.j3scene.").req(),
            flag("instance", "").def("false"),
            flag("center", "").def("false"),
            text("scene", ""),
        ], sceneSplit, arena));
    t.push(entry("scene_inline", "Turn a placed scene into real objects", "j3c -e scene inline <instance>", Hint.None,
        "Replace a placed scene (an instance object) with real copies of its objects, so they can be edited in this scene. Per-copy values and the placement's tint are kept; scenes the placed scene places stay placed. The instance becomes a group.",
        [
            text("node", "The instance object.").req(),
            text("scene", ""),
        ], sceneInline, arena));
    t.push(entry("scene_fmt", "Rewrite a scene file in the canonical layout", "j3c -e scene fmt", Hint.None,
        "Rewrite the scene file in the canonical layout: tree order, defaults left out, numbers trimmed. Only needed after the file was edited by hand; the tools always write it this way. Fails (changing nothing) when the file has a line it can't read, naming the line.",
        [
            text("scene", ""),
        ], sceneFmt, arena));
    t.push(entry("scene_set", "Change an object", "j3c -e scene set <object> key=value ...", Hint.None,
        "Set fields on an object (all or nothing). node may be a glob (DecoCorn*, *Tree?) to set every matching object; preview with scene_list filter. Keys: name; pos [x,y,z] (local to parent), x, y, z; rot [x,y,z] degrees; scale [x,y,z] or one number; parent (\"\" for top level; keeps local transform); asset (mesh file or builtin:cube|sphere|cylinder|cone|capsule|torus|quad|plane|sky); texture; material (.j3mat); scene (instance's scene file); script (a .j3s path, \"\" for none); tags (comma-separated, e.g. \"nocollide,launch=30\"; the game reads them with scene3d.hasTag/tagValue); param.<prop> (a prop of the object's script, typed by its props block); tint [r,g,b] or one number (meshes and placed scenes; multiplies color, 1 unchanged, above 1 allowed, e.g. [0.7,1,1.8] turns green teal); color [r,g,b] 0-1 and range (lights); fov, near, far (cameras); effects (cameras: kind=camera .j3fx files run in order, \"a.j3fx|b.j3fx\"; \"\" for none) and fx.<file stem>.<param> (their params); alpha opaque|cutout|blend; opacity; doubleSided; prop.<name> (on an instance: a prop its scene declares; \"\" goes back to the default). With node \"@scene\": prop.<name> = \"<type>:<default>\" declares a prop on this scene (type int, float, text, bool, material, mesh, scene; \"\" removes it), and sun [x,y,z] (direction toward the sun), sunColor, sky, fogStart, fogEnd, shadows, shadowSize, urp, urpBounces, urpSamples, urpShadows, urpShadowNear (meters traced sun shadows reach; the shadow map covers the rest; 0 no limit). save: true also saves the scene in the open editor.",
        [
            text("node", "Name, Parent/Child path, #id, or @scene.").req(),
            object("fields", ""),
            flag("save", "With the editor open, save the scene after the change (without it, edits stay unsaved in the editor)."),
            text("scene", ""),
        ], sceneSet, arena));
    t.push(entry("scene_delete", "Delete objects", "j3c -e scene delete <object> ...", Hint.Destructive,
        "Delete objects and everything under them. A node may be a glob (DecoCorn*) for every match; preview with scene_list filter.",
        [
            text("node", ""),
            strList("nodes", ""),
            text("scene", ""),
        ], sceneDelete, arena));
    t.push(entry("place", "Place objects", "j3c -e scene ground|ontop|scatter|ring|stairs|spiral|wall ... (grid is MCP only)", Hint.None,
        "Use for anything repeated or resting on something, instead of computing coordinates by hand. Placement without coordinates. ground: drop or lift node so its lowest point rests on the surface below it (or on target only; y=0 if nothing is below). ontop: center node over target and rest it on target's top. scatter: add count copies of what (a shape like cube or cylinder, a .j3mesh or builtin: asset, or a .j3scene placed as instances) at random spots in area [x0,z0,x1,z1] (in parent's space) under a new Scatter group, each grounded, with random yaw and a scale between scale[0] and scale[1]; the same seed gives the same layout. grid: add pieces (walls, floors, roof parts) on a grid in one step: each piece's what (a .j3scene, .j3mesh, builtin: asset, or shape) goes at [x*cell, floor*height, z*cell] turned turn*90 degrees about y, under parent. ring, stairs, spiral, wall build a shape from copies of what (default cube; size is scale, builtin shapes are 1 m) in one step, named name, under parent; angles are degrees. ring: count pieces at radius around center [x,z] (arc [a0,a1] for part of a circle), bottoms at y; face tangent (default: slabs whose local x points outward, widened so the ring has no slits when size z is 0), out or in (local +z faces out or in). stairs: steps from [x,y,z] along dir (x, -x, z, -z), each rise higher and run long, width wide; solid fills to the floor. spiral: floating slabs at radius around center, each turn degrees further and rise higher (keep rise*360/turn above about 2.5 m headroom), thickness thick, width radial, depth tangential. wall: a run from [x,z] to [x,z], height high and thickness thick, with door [width,height,at] cut at meters along it (lintel over it).",
        [
            text("op", "").oneOf("ground|ontop|scatter|grid|ring|stairs|spiral|wall").req(),
            text("node", "Object to move (ground, ontop)."),
            text("target", "ontop: object to put node on. ground: rest only on this object."),
            text("what", "scatter: shape, mesh asset, or scene file."),
            numList("area", 4, 4, "scatter: x0, z0, x1, z1.", arena),
            integer("count", "").def("10"),
            integer("seed", "").def("1"),
            numList("scale", 1, 2, "", arena),
            flag("yaw", "").def("true"),
            number("spacing", "scatter: least distance between copies."),
            text("parent", ""),
            text("name", "scatter: base name of the copies."),
            flag("ground", "").def("true"),
            number("cell", "grid: cell size.").def("1"),
            number("height", "grid: floor height (default cell). wall: its height (default 3)."),
            numList("center", 2, 2, "ring, spiral: [x,z].", arena),
            number("radius", "ring, spiral."),
            number("y", "ring, spiral, wall: base height."),
            vec3("size", "ring: piece scale [radial, height, tangential]; tangential 0 fits the ring."),
            text("face", "").oneOf("tangent|out|in"),
            numList("arc", 2, 2, "ring: from and to angle, degrees.", arena),
            numList("from", -1, -1, "stairs: [x,y,z] of the bottom edge's middle. wall: [x,z].", arena),
            numList("to", 2, 2, "wall: [x,z].", arena),
            text("dir", "").oneOf("x|-x|z|-z"),
            integer("steps", ""),
            number("rise", "").def("0.4"),
            number("run", "").def("1"),
            number("width", "stairs (default 2.5), spiral slab radial size (default 2)."),
            flag("solid", "").def("true"),
            number("turn", "spiral: degrees per step.").def("20"),
            number("start", "spiral: first step's angle, degrees.").def("0"),
            number("thickness", "spiral slab (default 0.6), wall (default 1.5)."),
            number("depth", "spiral: slab size along the turn.").def("1.2"),
            vec3("door", "wall: [width, height, at]."),
            listOf("pieces", object("", "").withProps([text("what", "").req(), number("x", ""), number("z", ""), number("floor", ""), integer("turn", "Quarter turns about y."), text("name", "")], arena), arena, "").most(2000),
            text("scene", ""),
        ], place, arena));
    t.push(entry("undo", "Undo the last change", "j3c -e scene undo", Hint.Destructive,
        "Put a scene file back as it was before the last change made through these tools (keeps 20 per scene). Only when the editor is closed; with it open, the person uses Ctrl+Z.",
        [
            text("scene", ""),
        ], undo, arena));
    t.push(entry("render", "Render the scene", "j3c -e render", Hint.ReadOnly,
        "Look at what you built; do this after every few edits, and from where the player would stand (at) for rooms, doors, stairs and jumps. Draw the scene as the game would (lights, shadows, sky, URP) and return the image. Default: through the main camera, or an overview if there is none. view frames all objects from a side; focus frames one object (with view's side); select outlines an object in orange. at looks from any spot (no camera object needed): yaw and pitch are degrees like a camera's rot y and x (yaw 0 looks toward -z, 90 toward -x, 180 toward +z, -90 toward +x; pitch above 0 looks up). views puts several such views in one image, two per row, width x height each. hide leaves out objects by name glob (Roof*) to see inside. ambient lifts dark interiors (default 0.25 with at/views). ortho with view top gives a true plan. With the editor open it renders the live, unsaved scene.",
        [
            text("scene", ""),
            text("camera", "Camera object to look through."),
            text("view", "").oneOf("iso|front|back|side|top"),
            text("focus", "Object to frame."),
            text("select", "Object to outline."),
            vec3("at", "Eye position [x,y,z] in world space."),
            number("yaw", "With at: degrees; 0 looks toward -z, 90 toward -x.").def("0"),
            number("pitch", "With at: degrees; above 0 looks up.").def("0"),
            listOf("views", numList("", 5, 5, "", arena), arena, "Several [x,y,z,yaw,pitch] views in one image, left to right, top to bottom.").most(16),
            number("fov", "Vertical field of view in degrees."),
            text("hide", "Comma-separated name globs to leave out with their children, e.g. \"Roof*,Ceiling\"."),
            number("ambient", "0 to 1: white mixed into the ambient light; render only."),
            flag("ortho", "view/focus without perspective."),
            integer("width", "").def("640"),
            integer("height", "").def("360"),
        ], render, arena));
    t.push(entry("check", "Check scenes and code", "j3c -e scene check --all, then j3c check", Hint.ReadOnly,
        "Run before play and before saying you are done; it names the object at fault, and runs the project's own rules (tools/check.j3s) too. Find problems before playing: broken parents, missing mesh/material/texture/scene files, placement cycles, missing scripts, object fields pointing at deleted objects, same-named siblings, and J3 compile errors (with file and line).",
        [
            text("scene", "One scene; default every scene under scenes/."),
            flag("code", "Also typecheck the project's code.").def("true"),
        ], check, arena));
    t.push(entry("play", "Play the game", "j3c run --frames N --screenshot F.png --headless", Hint.None,
        "Build the game and run it without a window for some frames (scripts run), then return the last frame as an image with the game's output. For a 3D game the output ends with a J3STATS line: average fps, draw calls, triangles, and CPU/GPU milliseconds. Build errors come back instead of an image.",
        [
            text("scene", "Scene to start in; default the project's main scene."),
            integer("frames", "Frames to run (60 per second).").def("120"),
            integer("timeout", "Seconds before the run is stopped.").def("60"),
        ], play, arena));
    t.push(entry("console", "Game output", "", Hint.ReadOnly,
        "Recent game and build output: the editor's console while the editor is open, else the last play run.",
        [
            integer("lines", "").def("50"),
        ], console, arena));
    t.push(entry("import", "Import a model", "", Hint.None,
        "Import .gltf, .glb, or .j3mesh files into assets/ as reusable scenes (assets/imported/<name>.j3scene), one line back per model. path may be a folder (its models, not recursive) or contain * wildcards; paths takes a list. Only a single imported model is placed (unless place is false).",
        [
            text("path", "Model file, folder, or wildcard like kit/wall*.glb, absolute or relative to the project."),
            strList("paths", ""),
            flag("bake", "Sample each textured triangle's texture at its UV center into vertex colors and drop the texture (for palette kits like Kenney's).").def("false"),
            flag("place", "").def("true"),
            flag("again", "Import even when assets/imported/<name>.j3scene exists (makes <name>_2). By default that model is skipped and the existing scene is used.").def("false"),
            text("scene", ""),
            text("name", ""),
            text("parent", ""),
            vec3("pos", ""),
        ], import, arena));
    t.push(entry("asset_search", "Find assets", "", Hint.ReadOnly,
        "Find meshes, models, materials, images, scenes, sounds, and scripts in the project, plus the built-in shapes. Paths are what asset, material, texture, scene, and script fields take.",
        [
            text("query", ""),
            text("kind", "").oneOf("any|mesh|model|material|image|scene|sound|font|script|code|file"),
        ], assetSearch, arena));
    t.push(entry("asset_online_search", "Search online assets", "", Hint.ReadOnly,
        "Search free CC0 assets online: Poly Haven models and skies, ambientCG materials, and Kenney model packs (a pack is a zip of many low-poly models). One line per result: source, id, kind, name, author. Then asset_fetch with the source and id.",
        [
            text("query", "Words to match, like chair, brick, or town. Empty lists everything (up to 40)."),
            text("source", "").oneOf("any|polyhaven|ambientcg|kenney").def("\"any\""),
            text("kind", "").oneOf("any|model|material|sky").def("\"any\""),
        ], assetOnlineSearch, arena));
    t.push(entry("asset_fetch", "Download an online asset", "", Hint.None,
        "Download an asset asset_online_search found (cached in ~/.cache/j3/assets) and add it to the project, with a line in assets/CREDITS.txt. A Poly Haven model is imported like the import tool (and placed unless place is false). An ambientCG material becomes assets/materials/<id>.j3mat with its color texture. A Poly Haven sky becomes assets/skies/<id>.png for a builtin:sky mesh's texture. A Kenney pack without file lists its models; with file (a name from that list, with or without .glb) it imports that one. Kenney models look best with bake:true.",
        [
            text("source", "").oneOf("polyhaven|ambientcg|kenney").req(),
            text("id", "").req(),
            text("file", "Kenney only: the model in the pack to import."),
            flag("bake", "").def("false"),
            flag("place", "").def("true"),
            flag("again", "").def("false"),
            text("scene", ""),
            text("name", ""),
            text("parent", ""),
            vec3("pos", ""),
        ], assetFetch, arena));
    t.push(entry("gen", "Run mesh generators", "j3c -e gen [--force]", Hint.None,
        "Run the project's mesh generator scripts: each assets/gen/<name>.j3 builds a mesh in code with j3.gfx.meshgen (box, cylinder, cone, frustum, sphere, capsule, torus, lathe, extrude, heightField, tri, quad; color, glow; at, turn, size, push, pop) and ends with b.save(meshgen.output(\"assets/gen/<name>.j3mesh\")). Write the script with your file tools, then run this; use the .j3mesh as a mesh asset. Unchanged scripts are skipped unless force. Render and play run it too. `j3c doc j3.gfx.meshgen` has the API.",
        [
            flag("force", "").def("false"),
        ], gen, arena));
    t.push(entry("scene_stats", "Scene draw cost", "j3c -e scene stats [--all]", Hint.ReadOnly,
        "Run after adding many objects or tints; slow scenes are usually too many distinct looks. How much a scene costs to draw: objects (placed scenes included), meshes, distinct looks (mesh, material, texture, tint: one instanced draw call each per pass), the ten biggest looks, and cutout/blended meshes that draw one by one. Above 60 looks frame time suffers; snap tints to a small palette.",
        [
            text("scene", ""),
        ], sceneStats, arena));
    t.push(entry("scene_diff", "What changed in a scene", "j3c -e scene diff [OLD]", Hint.ReadOnly,
        "Review your own work before finishing. Objects added, removed, moved (over 1 cm, with positions), and changed (field old -> new) in a scene file since git HEAD, or since another scene file (against). Matched by Parent/Child path, so renumbered ids don't matter. Reads saved files, not unsaved editor changes. Use it to review your own edits.",
        [
            text("scene", ""),
            text("against", "Project-relative .j3scene to compare with; default the scene at git HEAD."),
        ], sceneDiff, arena));
    return t.slice();
}

const USAGE = @embed("scene/usage.txt");
const RENDER_USAGE = @embed("scene/render_usage.txt");

fn out(s: string) { sys.write(1, s.ptr as ptr, s.len); }
fn err(s: string) { sys.write(2, s.ptr as ptr, s.len); }

/// `j3c -e scene OP ...` (Rust `scene::cmd`): the exit code.
pub fn sceneCmd(rest: []string): int {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    match execute(rest, &mem) {
        Result.Ok(code) { return code; }
        Result.Err(e) {
            err(Text.new(&mem).add("j3c -e scene: ").add(e).add("\n").str());
            return 1;
        }
    }
}

fn jsonList(v: &List<string>, arena: &Arena): &Json {
    let a = json.arr(arena);
    for i in 0..v.len { a.push(json.str(v.items[i], arena)); }
    return a;
}

fn put(o: &Json, key: string, v: &Json) {
    o.keys.push(key);
    o.items.push(v);
}

fn printJson(j: &Json, arena: &Arena) {
    let t = Text.new(arena);
    json.write(j, &t);
    t.push('\n');
    out(t.str());
}

fn printText(r: &Reply, arena: &Arena) {
    let t = Text.new(arena);
    reply.toText(r, &t);
    out(t.str());
}

/// Every byte of stdin.
fn readStdin(arena: &Arena): Result<string, string> {
    let t = Text.new(arena);
    let buf = arena.alloc::<u8>(65536);
    while true {
        let n = sys.read(0, buf.ptr as ptr, buf.len);
        if n < 0 { return Result.Err(fsx.osError(sys.errno(), arena)); }
        if n == 0 { break; }
        t.pushBytes(buf[0..n]);
    }
    return Result.Ok(t.str());
}

fn sceneOpt(s: string, given: bool): Option<string> {
    if given { return Option.Some(s); }
    return Option.None;
}

/// Rust `scene::execute`.
fn execute(rest: []string, mem: &Arena): Result<int, string> {
    let project = ".";
    let scene = "";
    let hasScene = false;
    let asJson = false;
    let all = false;
    let args = List<string>.new(mem);
    let i = 0;
    while i < rest.len {
        let a = rest[i];
        if a == "--help" || a == "-h" {
            out(USAGE);
            return Result.Ok(0);
        } else if a == "--project" {
            if i + 1 >= rest.len { return Result.Err("--project needs a directory"); }
            i += 1;
            project = rest[i];
        } else if a == "--scene" {
            if i + 1 >= rest.len { return Result.Err("--scene needs a file"); }
            i += 1;
            scene = rest[i];
            hasScene = true;
        } else if a == "--json" {
            asJson = true;
        } else if a == "--all" {
            all = true;
        } else {
            args.push(a);
        }
        i += 1;
    }
    if args.len == 0 {
        out(USAGE);
        return Result.Ok(2);
    }
    let root = ops.findRoot(project, mem)?;
    let op = args.items[0];
    if op == "diff" {
        if args.len > 2 { return Result.Err("diff takes at most one scene to compare with"); }
        let rel = ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?;
        let d = diff.diff(root, rel, if args.len > 1 { Option.Some(args.items[1]) } else { Option.None }, mem)?;
        if asJson {
            let o = json.obj(mem);
            put(o, "ok", json.boolean(true, mem));
            put(o, "scene", json.str(rel, mem));
            put(o, "against", json.str(d.against, mem));
            put(o, "added", jsonList(&d.added, mem));
            put(o, "removed", jsonList(&d.removed, mem));
            put(o, "moved", jsonList(&d.moved, mem));
            put(o, "changed", jsonList(&d.changed, mem));
            printJson(o, mem);
        } else {
            let t = Text.new(mem);
            diff.text(&d, 50, &t);
            out(t.str());
        }
        return Result.Ok(0);
    }
    if patterns.isPattern(op) {
        let rel = ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?;
        let reqs = patterns.patternRequests(op, args.items[1..args.len], mem)?;
        let sep = mem.alloc::<u8>(1);
        sep[0] = BATCH;
        let flat = List<string>.new(mem);
        for k in 0..reqs.len {
            if k > 0 { flat.push(sep as string); }
            for j in 0..reqs.items[k].len { flat.push(reqs.items[k].items[j]); }
        }
        let r = ops.runTool(root, rel, flat.slice(), mem)?;
        if asJson {
            printJson(reply.toJson("add", rel, &r, mem), mem);
        } else if r.ok {
            let t = Text.new(mem);
            t.add("added ");
            t.pushInt(reqs.len);
            t.add(" pieces in one step\n");
            out(t.str());
        } else {
            printText(&r, mem);
        }
        return Result.Ok(if r.ok { 0 } else { 1 });
    }
    if op == "apply" {
        // apply [parent=OBJECT] FILE|-   (the object lines, as `get` prints them)
        let parent: Option<string> = Option.None;
        let source = "";
        let hasSource = false;
        for k in 0..args.len {
            let a = args.items[k];
            let isParent = a.len >= 7 && a[0..7] == "parent=";
            match parent { Option.None { if isParent { parent = Option.Some(a[7..a.len]); } } Option.Some(_) {} }
            if k > 0 && !isParent && !hasSource { source = a; hasSource = true; }
        }
        if !hasSource { return Result.Err("apply needs a file of object lines, or - for stdin"); }
        let text = "";
        if source == "-" {
            text = readStdin(mem)?;
        } else {
            match fsx.readText(source, mem) { Result.Ok(t) { text = t; } Result.Err(e) { return Result.Err(e); } }
        }
        let rel = ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?;
        let lines = ops.applyArgs(text, parent, mem)?;
        let r = ops.runTool(root, rel, lines.slice(), mem)?;
        if asJson { printJson(reply.toJson("apply", rel, &r, mem), mem); } else { printText(&r, mem); }
        return Result.Ok(if r.ok { 0 } else { 1 });
    }
    if args.len == 1 && op == "undo" {
        let msg = history.undo(root, ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?, mem)?;
        out(Text.new(mem).add(msg).add("\n").str());
        return Result.Ok(0);
    }
    let scenes = List<string>.new(mem);
    if all {
        if op != "check" && op != "stats" { return Result.Err("--all only works with check and stats"); }
        scenes = ops.allScenes(root, mem)?;
    } else {
        scenes.push(ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?);
    }
    let isCheck = args.len == 1 && op == "check";
    let placed = if isCheck { ops.placedScenes(root, mem) } else { List<string>.new(mem) };
    let failed = false;
    let outputs = List<&Json>.new(mem);
    for k in 0..scenes.len {
        let rel = scenes.items[k];
        let r = if isCheck { ops.checkScene(root, rel, placed.slice(), mem)? } else { ops.runTool(root, rel, args.slice(), mem)? };
        if !r.ok { failed = true; }
        for j in 0..r.lines.len {
            let l = &r.lines.items[j];
            if l.items[0] == "issue" && reply.at(l, 1) == "error" { failed = true; }
        }
        if asJson {
            outputs.push(reply.toJson(op, rel, &r, mem));
        } else {
            if scenes.len > 1 { out(Text.new(mem).add(rel).add(":\n").str()); }
            printText(&r, mem);
        }
    }
    if asJson {
        if outputs.len == 1 {
            printJson(outputs.items[0], mem);
        } else {
            let a = json.arr(mem);
            for k in 0..outputs.len { a.push(outputs.items[k]); }
            printJson(a, mem);
        }
    }
    return Result.Ok(if failed { 1 } else { 0 });
}

/// `j3c -e render ...` (Rust `scene::render_cmd`): the exit code.
pub fn renderCmd(rest: []string): int {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    match renderRun(rest, &mem) {
        Result.Ok(code) { return code; }
        Result.Err(e) {
            err(Text.new(&mem).add("j3c -e render: ").add(e).add("\n").str());
            return 1;
        }
    }
}

/// The `--flag` → `key=` table of `-e render` (Rust's match arms; `--ortho` takes no value).
const RENDER_FLAGS: [13]string = ["camera", "view", "size", "select", "focus", "out", "at", "yaw", "pitch", "fov", "views", "hide", "ambient"];

fn renderRun(rest: []string, mem: &Arena): Result<int, string> {
    let project = ".";
    let scene = "";
    let hasScene = false;
    let opts = List<string>.new(mem);
    let i = 0;
    while i < rest.len {
        let a = rest[i];
        if a == "--help" || a == "-h" {
            out(RENDER_USAGE);
            return Result.Ok(0);
        }
        if a == "--ortho" {
            opts.push("ortho=true");
            i += 1;
            continue;
        }
        let known = a == "--project" || a == "--scene";
        let key = "";
        for k in 0..RENDER_FLAGS.len {
            if a.len == RENDER_FLAGS[k].len + 2 && a[0..2] == "--" && a[2..a.len] == RENDER_FLAGS[k] { key = RENDER_FLAGS[k]; known = true; }
        }
        if !known { return Result.Err(Text.new(mem).add("unknown argument `").add(a).add("`").str()); }
        if i + 1 >= rest.len { return Result.Err(Text.new(mem).add(a).add(" needs a value").str()); }
        let v = rest[i + 1];
        i += 2;
        if a == "--project" { project = v; }
        else if a == "--scene" { scene = v; hasScene = true; }
        else { opts.push(Text.new(mem).add(key).add("=").add(v).str()); }
    }
    let root = ops.findRoot(project, mem)?;
    let rel = ops.sceneRel(root, sceneOpt(scene, hasScene), mem)?;
    let r = ops.render(root, rel, opts.slice(), mem)?;
    out(Text.new(mem).add(path.join(root, r.png, mem)).add("\n").str());
    return Result.Ok(0);
}
