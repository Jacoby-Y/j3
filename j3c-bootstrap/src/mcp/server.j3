// Request loop, tool calls, which project it follows.
//
// Port of: j3c/src/mcp/server.rs
// J3: A handler table on the shared loop in `lsp/proto` (plan 11 B12.4), not its own framing and dispatch.
// Reaches an open editor with `j3.instance` `request(name, args, ms)` and gets a real reply (B12.2); no
// polling `target/j3-editor/events`. Today: `ping`, `tools/list` (generated from the tool table) and
// `tools/call` (dispatch to `Tool.run`); `initialize` (instructions, protocol versions, project notes), the
// edit/live notes and the coach hints land with the `-e mcp` command in C5.
module j3c.mcp.server;

use j3.data.json;
use j3.data.json.{ Json, Kind };
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;
use j3c.lsp.proto.{ Handler, RpcError };
use j3c.mcp.schema.{ Tool, mcpSchema };

pub const INVALID_PARAMS: int = -32602;

/// What the handlers see as their `state` (and pass on to `Tool.run`).
pub struct State {
    tools: []Tool;
}

/// The MCP methods, for `proto.serve` with `Framing.Line` and a `&State`.
pub fn handlers(arena: &Arena): []Handler {
    let hs = arena.alloc::<Handler>(3);
    hs[0] = Handler { method: "ping", run: ping };
    hs[1] = Handler { method: "tools/list", run: toolsList };
    hs[2] = Handler { method: "tools/call", run: toolsCall };
    return hs;
}

fn ping(state: ptr, params: &Json, arena: &Arena): Result<&Json, RpcError> {
    return Result.Ok(json.obj(arena));
}

fn toolsList(state: ptr, params: &Json, arena: &Arena): Result<&Json, RpcError> {
    let st = state as &State;
    return Result.Ok(mcpSchema(st.tools, arena));
}

fn toolsCall(state: ptr, params: &Json, arena: &Arena): Result<&Json, RpcError> {
    let st = state as &State;
    let name = params.get("name");
    if name.kind != Kind.Str {
        return Result.Err(RpcError { code: INVALID_PARAMS, msg: "tools/call needs a tool name" });
    }
    let args = if params.has("arguments") { params.get("arguments") } else { json.obj(arena) };
    for t in st.tools {
        if t.name != name.s { continue; }
        let out = Text.new(arena);
        let run = t.run;
        let ok = run(state, args, arena, &out);
        let block = json.obj(arena);
        block.set("type", json.str("text", arena));
        block.set("text", json.str(out.str(), arena));
        let content = json.arr(arena);
        content.push(block);
        let r = json.obj(arena);
        r.set("content", content);
        r.set("isError", json.boolean(!ok, arena));
        return Result.Ok(r);
    }
    let msg = Text.new(arena);
    msg.pushStr("unknown tool `");
    msg.pushStr(name.s);
    msg.pushStr("`");
    return Result.Err(RpcError { code: INVALID_PARAMS, msg: msg.str() });
}
