// The misses of one build: a pool of forked workers, each emitting a module's text and running its clang (one
// clang per chunk when the module is split), module after module.
//
// Part of module j3c.cache.
// Port of: j3c/src/emit/incr.rs (the job pool of `compile`, `emit_and_clang`, `clang_obj`,
//     `jobs_done_note`)
// J3: Rust's pool threads are worker processes: `sys.fork` gives each worker its own copy of the IR and
//     the arena, so emitting runs side by side without sharing the single-threaded Session arena, and the
//     megabytes of text a worker makes die with it. The compiler has no other thread when it gets here
//     (`sys.fork`'s rule). `jobCap()` workers are forked once (a fork of the multi-GB compiler costs tens
//     of ms of page-table copy in the parent, so one fork per module was most of the compile wall): the
//     parent hands out unit indices on pipe `q`, a worker writes `OBJ.job` (`ok EMIT_MS CLANG_MS`, or
//     `err` and the message) and sends the index back on pipe `r`. A worker never returns into the driver.
// J3: After the first failure no unit is handed out; the running ones finish (their clang ends by itself)
//     and every worker is waited for, so no child is left behind. Rust lets its pool run dry.
// J3: Fewer workers than asked (`fork` failed) share the units; with none, or no pipe, the modules are
//     built in the compiler itself. Rust's pool threads never fail to start mid-build.
// J3: Workers draw no status line (each has a copy of `Phases`); the parent counts finished modules.
module j3c.cache;

struct Jobs {
    arena: &Arena;
    cx: &IrCx;
    modules: []Module;
    e: &EmitOpts;
    units: &List<Unit>;
    phases: &Phases;
    /// One per started worker.
    workers: List<Child>;
    width: int;
    doneUnits: int;
    total: int;
    thin: bool;
}

fn pushTiming(what: string, label: string, ms: int, a: &Arena) {
    if !timings() { return; }
    let t = Text.new(a);
    t.add("j3c: ").add(what).add(" ").add(label).add(": ");
    pushSecs(&t, ms, 3);
    t.add("s\n");
    eprint(&t);
}

fn writeErr(what: string, p: string, a: &Arena): string {
    return Text.new(a).add(what).add(p).add(": ").add(fsx.osError(sys.errno(), a)).str();
}

/// A started clang of `clangStart`.
struct Clang {
    child: Child;
    label: string;
    obj: string;
    llPath: string;
    clang: string;
    started: int;
}

/// The first half of Rust `clang_obj`: write `ll` beside `obj` and start its clang.
fn clangStart(label: string, obj: string, ll: string, e: &EmitOpts, thin: bool, a: &Arena): Result<Clang, string> {
    let llPath = withExt(obj, "ll", a);
    match io.writeFile(llPath, ll as []u8) {
        Result.Ok(_) {}
        Result.Err(_) { return Result.Err(writeErr("write ", llPath, a)); }
    }
    let argv = List<string>.new(a);
    objArgv(&argv, obj, llPath, e, thin, a);
    let clang = argv.items[0];
    let started = sys.monotonicMs();
    match toolchain.spawnStart(argv.slice(), a) {
        Result.Ok(ch) { return Result.Ok(Clang { child: ch, label: label, obj: obj, llPath: llPath, clang: clang, started: started }); }
        Result.Err(x) {
            toolchain.discard(llPath);
            return Result.Err(toolchain.spawnErr(clang, x, a));
        }
    }
}

/// The second half of Rust `clang_obj`: wait for the clang; the `.ll` is removed again.
fn clangEnd(c: &Clang, a: &Arena): Result<bool, string> {
    let o = toolchain.spawnFinish(&c.child, a);
    toolchain.discard(c.llPath);
    if sys.env("J3C_TIME_REPORT").len > 0 {
        // One file per object next to it: `cat <obj dir>/*.time.txt`.
        match io.writeFile(withExt(c.obj, "time.txt", a), o.err) {
            Result.Ok(_) {}
            Result.Err(_) {}
        }
    }
    pushTiming("clang", c.label, sys.monotonicMs() - c.started, a);
    if o.code != 0 {
        toolchain.discard(c.obj);
        return Result.Err(Text.new(a).add(c.clang).add(" failed on ").add(c.label).add(":\n").add(o.errStr()).str());
    }
    return Result.Ok(true);
}

/// Rust `clang_obj`: compile the text `ll` to `obj` (the `.ll` beside it is removed again).
fn clangObj(label: string, obj: string, ll: string, e: &EmitOpts, thin: bool, a: &Arena): Result<bool, string> {
    let c = clangStart(label, obj, ll, e, thin, a)?;
    return clangEnd(&c, a);
}

fn llOpts(e: &EmitOpts): LlOpts {
    let bo = toolchain.backendOpts(e);
    return LlOpts { target: bo.target, opt: bo.opt, debug: bo.debug, release: bo.release };
}

/// Chunk `n` of a split module: emit it (its text in `mem`) and start its clang to `partPath(obj, n)`.
fn chunkStart(j: &Jobs, u: &Unit, sets: &List<Set<Id<Func>>>, n: int, mem: &Arena): Result<Clang, string> {
    let a = mem;
    let ll = Text.new(a);
    let lo = llOpts(j.e);
    emitLlvmModule(j.cx, j.modules, u.index, &lo, Option.Some(Chunk { no: n, defined: &sets.items[n] }), u.cost / sets.len, &ll)?;
    let label = Text.new(a);
    label.add(u.label).fmt(` [{n + 1}/{sets.len}]`);
    return clangStart(label.str(), partPath(u.obj, n, a), ll.str(), j.e, j.thin, a);
}

/// Rust `emit_and_clang`, in a worker: emit module `ui`, compile it (split: one clang per share, side by
/// side), write its `.parts` and `.libs`. Ok: emit and clang milliseconds.
/// J3: The module's text and every temporary of the unit live in an arena of its own, freed after the
/// module (it was most of a worker's growth from module to module); an error is copied out first.
fn work(j: &Jobs, ui: int): Result<(int, int), string> {
    let mem = Arena.create(1 << 20);
    let r = workIn(j, ui, &mem);
    match r {
        Result.Ok(_) {}
        Result.Err(x) { r = Result.Err(Text.new(j.arena).add(x).str()); }
    }
    mem.destroy();
    return r;
}

fn workIn(j: &Jobs, ui: int, mem: &Arena): Result<(int, int), string> {
    let a = mem;
    let u = &j.units.items[ui];
    let started = sys.monotonicMs();
    let ll = Text.new(a);
    let lo = llOpts(j.e);
    emitLlvmModule(j.cx, j.modules, u.index, &lo, Option.None, u.cost, &ll)?;
    let emit = sys.monotonicMs() - started;
    pushTiming("emit", u.label, emit, a);
    let note = libNotes(ll.str(), a);
    toolchain.discard(partsFile(u.obj, a));
    // Under J3_JOBS a worker's chunk clangs share its slice of the cap, so the total stays at J3_JOBS (a cold
    // build's giant modules then rarely split: slower wall). Unset: up to half the cores per split module.
    let slots = if sys.env("J3_JOBS").len > 0 { jobCap() / j.width } else { jobCap() };
    let sets = splitPlan(j.cx, &j.modules[u.index], ll.str(), j.e, slots, a);
    if sets.len == 0 {
        clangObj(u.label, u.obj, ll.str(), j.e, j.thin, a)?;
    } else {
        // The giant fns are the long pole: each chunk is emitted here in turn and its clang started at once
        // (Rust: a thread per chunk), so the clangs run side by side; the first failure in chunk order wins.
        let runs = List<Clang>.new(a);
        let first: Result<bool, string> = Result.Ok(true);
        for n in 0..sets.len {
            match chunkStart(j, u, &sets, n, mem) {
                Result.Ok(c) { runs.push(c); }
                Result.Err(x) {
                    first = Result.Err(x);
                    break;
                }
            }
        }
        for k in 0..runs.len {
            let r = clangEnd(&runs.items[k], a);
            match first {
                Result.Ok(_) { first = r; }
                Result.Err(_) {}
            }
        }
        first?;
        let n = Text.new(a);
        n.pushInt(sets.len);
        match io.writeFile(partsFile(u.obj, a), n.str() as []u8) {
            Result.Ok(_) {}
            Result.Err(_) { return Result.Err(Text.new(a).add("write parts file: ").add(fsx.osError(sys.errno(), a)).str()); }
        }
    }
    match io.writeFile(u.libs, note as []u8) {
        Result.Ok(_) {}
        Result.Err(_) { return Result.Err(writeErr("write ", u.libs, a)); }
    }
    return Result.Ok((emit, sys.monotonicMs() - started - emit));
}

/// The worker's report for the parent, beside the object.
fn jobFile(obj: string, a: &Arena): string { return withExt(obj, "job", a); }

/// One unit index through a pipe: 4 bytes, one `write` (atomic under `PIPE_BUF`). false: the reader is gone.
fn send(fd: int, v: int): bool {
    let b: [1]i32 = [i32(v)];
    let n = sys.write(fd, b[..].ptr as ptr, 4);
    while n == -4 { n = sys.write(fd, b[..].ptr as ptr, 4); }   // EINTR
    return n == 4;
}

/// The next unit index from a pipe; -1 once every writer has closed it.
fn recv(fd: int): int {
    let b: [1]i32 = [0];
    let got = 0;
    while got < 4 {
        let n = sys.read(fd, (b[..].ptr as int + got) as ptr, 4 - got);
        if n == -4 { continue; }   // EINTR
        if n <= 0 { return -1; }
        got += n;
    }
    return int(b[0]);
}

/// A worker: build each unit index read from `q` (writing `OBJ.job`) and send the index back on `r`, until
/// the parent closes `q`. Never returns.
fn serve(j: &Jobs, q: int, r: int) {
    let a = j.arena;
    while true {
        let ui = recv(q);
        if ui < 0 { sys.exit(0); }
        let u = j.units.items[ui];
        let t = Text.new(a);
        match work(j, ui) {
            Result.Ok(ms) { t.fmt(`ok {ms.0} {ms.1}`); }
            Result.Err(x) { t.add("err\n").add(x); }
        }
        // a report that cannot be written is read back as missing (`worker of LABEL ended with code 1`)
        match io.writeFile(jobFile(u.obj, a), t.str() as []u8) {
            Result.Ok(_) {}
            Result.Err(_) {}
        }
        if !send(r, ui) { sys.exit(1); }
    }
}

/// Take the report a worker wrote for unit `ui` into its unit; Err is its failure (Rust's `CLANG failed on
/// LABEL:` text).
fn collect(j: &Jobs, ui: int): Result<bool, string> {
    let a = j.arena;
    let u = &j.units.items[ui];
    let report = "";
    match io.readFile(jobFile(u.obj, a), a) {
        Result.Ok(b) { report = b as string; }
        Result.Err(_) {}
    }
    toolchain.discard(jobFile(u.obj, a));
    if !startsWith(report, "ok ") {
        if startsWith(report, "err\n") { return Result.Err(report[4..report.len]); }
        return Result.Err(Text.new(a).add("worker of ").add(u.label).add(" ended with code 1").str());
    }
    let nums = trim(report[3..report.len]);
    let sp = find(nums, " ");
    let emit = 0;
    let clang = 0;
    if sp > 0 {
        match parseInt(nums[0..sp], 10) { Option.Some(v) { emit = v; } Option.None {} }
        match parseInt(nums[sp + 1..nums.len], 10) { Option.Some(v) { clang = v; } Option.None {} }
    }
    return took(j, u, emit, clang);
}

/// Take a built unit's times, `.libs` note and parts, and count it done.
fn took(j: &Jobs, u: &Unit, emit: int, clang: int): Result<bool, string> {
    let a = j.arena;
    u.emitMs = emit;
    u.clangMs = clang;
    match io.readFile(u.libs, a) {
        Result.Ok(b) { u.note = b as string; }
        Result.Err(_) { return Result.Err(Text.new(a).add("read ").add(u.libs).add(": ").add(fsx.osError(sys.errno(), a)).str()); }
    }
    u.parts = partsOf(u.obj, a);
    j.doneUnits += 1;
    let d = Text.new(a);
    d.fmt(`{j.doneUnits}/{j.total} modules compiled`);
    j.phases.detail(d.str());
    return Result.Ok(true);
}

struct Cost {
    cost: int;
    unit: int;
}

/// Every unit of `order` built in this process, one after another (no pipe or no process to spare).
fn runHere(j: &Jobs, order: []Cost): Result<bool, string> {
    for k in 0..order.len {
        let ms = work(j, order[k].unit)?;
        took(j, &j.units.items[order[k].unit], ms.0, ms.1)?;
    }
    return Result.Ok(true);
}

/// Fork up to `j.width` workers that serve `q`/`r`, handing `order[k]` out right after fork `k` (a fork
/// takes ~20 ms here, so the costliest module starts at once instead of after every fork); how many
/// started, which is also how many units are out.
fn startWorkers(j: &Jobs, q: []i32, r: []i32, order: []Cost, held: &List<bool>): int {
    for k in 0..j.width {
        let pid = sys.fork();
        if pid < 0 { break; }
        if pid == 0 {
            sys.close(int(q[1]));
            sys.close(int(r[0]));
            serve(j, int(q[0]), int(r[1]));
        }
        j.workers.push(Child { pid: pid, stdin: -1, stdout: -1, stderr: -1 });
        // `q[0]` is still open here, so the write cannot fail for want of a reader
        send(int(q[1]), order[k].unit);
        held.items[order[k].unit] = true;
    }
    return j.workers.len;
}

/// `fd` has bytes (or EOF) within `ms`.
fn readable(fd: int, ms: int): bool {
    let pfd: [2]i32 = [i32(fd), i32(sys.POLLIN)];
    return sys.pollFds(&pfd[0] as ptr, 1, ms) > 0;
}

/// Some worker has exited (reaped; its `wait` later gives the same code).
fn anyEnded(j: &Jobs): bool {
    for k in 0..j.workers.len {
        if let Option.Some(_) = j.workers.items[k].tryWait() { return true; }
    }
    return false;
}

/// Build every miss of `units`: costliest module first (ties: module order), results kept by module, the
/// first failure returned once no worker is left running.
fn runJobs(cx: &IrCx, modules: []Module, units: &List<Unit>, misses: int, e: &EmitOpts, thin: bool, phases: &Phases, arena: &Arena): Result<bool, string> {
    let order = List<Cost>.new(arena);
    for i in 0..units.len {
        if units.items[i].miss { order.push(Cost { cost: units.items[i].cost, unit: i }); }
    }
    // Costliest modules first so the slowest job doesn't start last. Key text length is a rough cost.
    sortBy(order.slice(), fn(a: Cost, b: Cost): bool { return a.cost > b.cost; });
    let width = jobCap();
    if width > misses { width = misses; }
    let j = Jobs { arena: arena, cx: cx, modules: modules, e: e, units: units, phases: phases, workers: List<Child>.new(arena),
        width: width, doneUnits: 0, total: misses, thin: thin };
    let started = sys.monotonicMs();
    let q: [2]i32 = [-1, -1];
    let r: [2]i32 = [-1, -1];
    let first: Result<bool, string> = Result.Ok(true);
    if sys.pipe(q[..], sys.O_CLOEXEC) < 0 {
        first = runHere(&j, order.slice());
    } else if sys.pipe(r[..], sys.O_CLOEXEC) < 0 {
        sys.close(int(q[0]));
        sys.close(int(q[1]));
        first = runHere(&j, order.slice());
    } else {
        let held = List<bool>.new(arena);
        for _ in 0..units.len { held.push(false); }
        let n = startWorkers(&j, q[..], r[..], order.slice(), &held);
        sys.close(int(q[0]));
        sys.close(int(r[1]));
        sys.ignoreSigpipe(true);
        // One unit per worker; a finished one gets the next costliest. After the first failure none is
        // handed out; the running ones finish (their clang ends by itself) and see `q` close.
        let next = n;
        let out = n;
        while out > 0 {
            // a worker only exits before `q` closes by dying (panic, signal, OOM); its unit never comes
            // back, so stop waiting and fail the build below instead of hanging
            if !readable(int(r[0]), 50) {
                if anyEnded(&j) { break; }
                continue;
            }
            let ui = recv(int(r[0]));
            if ui < 0 { break; }
            out -= 1;
            held.items[ui] = false;
            let res = collect(&j, ui);
            match first {
                Result.Ok(_) { first = res; }
                Result.Err(_) {}
            }
            match first {
                Result.Ok(_) {
                    if next < order.len && send(int(q[1]), order.items[next].unit) {
                        held.items[order.items[next].unit] = true;
                        next += 1;
                        out += 1;
                    }
                }
                Result.Err(_) {}
            }
        }
        sys.close(int(q[1]));
        let code = 0;
        for k in 0..j.workers.len {
            let c = j.workers.items[k].wait();
            if c != 0 && code == 0 { code = c; }
        }
        // units finished after a death was seen: every writer is gone, so this reads to EOF
        let ui = recv(int(r[0]));
        while ui >= 0 {
            held.items[ui] = false;
            out -= 1;
            toolchain.discard(jobFile(units.items[ui].obj, arena));
            ui = recv(int(r[0]));
        }
        sys.close(int(r[0]));
        match first {
            Result.Ok(_) {
                if n == 0 {
                    first = runHere(&j, order.slice());
                } else if out > 0 || next < order.len {
                    // a worker died holding a unit, or every worker is gone before the last one was handed out
                    let lost = order.items[if next < order.len { next } else { order.len - 1 }].unit;
                    for k in 0..next {
                        if held.items[order.items[k].unit] {
                            lost = order.items[k].unit;
                            toolchain.discard(jobFile(units.items[lost].obj, arena));
                            break;
                        }
                    }
                    first = Result.Err(Text.new(arena).add("worker of ").add(units.items[lost].label).fmt(` ended with code {code}`).str());
                }
            }
            Result.Err(_) {}
        }
    }
    first?;
    jobsDoneNote(&j, order.slice(), sys.monotonicMs() - started);
    return Result.Ok(true);
}

/// Rust `jobs_done_note`: the build's time split and its five slowest modules.
fn jobsDoneNote(j: &Jobs, order: []Cost, wallMs: int) {
    let a = j.arena;
    let emit = 0;
    let clang = 0;
    for k in 0..order.len {
        emit += j.units.items[order[k].unit].emitMs;
        clang += j.units.items[order[k].unit].clangMs;
    }
    let t = Text.new(a);
    t.fmt(`{order.len} modules on {j.width} threads: `);
    pushSecs(&t, wallMs, 2);
    t.add("s wall, ");
    pushSecs(&t, emit, 2);
    t.add("s emit cpu, ");
    pushSecs(&t, clang, 2);
    t.add("s clang cpu");
    j.phases.note(t.str());
    let slow = List<Cost>.new(a);
    for k in 0..order.len {
        let u = j.units.items[order[k].unit];
        slow.push(Cost { cost: u.emitMs + u.clangMs, unit: order[k].unit });
    }
    sortBy(slow.slice(), fn(x: Cost, y: Cost): bool { return x.cost > y.cost; });
    for k in 0..slow.len {
        if k == 5 { break; }
        let u = j.units.items[slow.items[k].unit];
        let s = Text.new(a);
        s.add("  slow: ").add(u.label);
        if u.parts > 0 { s.fmt(` (split in {u.parts})`); }
        s.add(" (emit ");
        pushSecs(&s, u.emitMs, 2);
        s.add("s, clang ");
        pushSecs(&s, u.clangMs, 2);
        s.add("s)");
        j.phases.step(s.str(), f64(u.emitMs + u.clangMs) / 1000.0);
    }
}
