// Object keys: compiler id, layout digest, stable IR text hash.
//
// Part of module j3c.cache.
// Port of: j3c/src/emit/incr/key.rs
// J3: Hashes are `xxh3_64` (Rust: `DefaultHasher`), so a key never equals Rust's. The constant text the
// key walk adds (Rust: `{kind:?}`) is this file's own format: it only has to be stable and to change when
// the value changes.
// J3: `compilerId` keeps its stamp in `<cache>/compiler-boot.id`, not Rust's `compiler.id`: sharing the file would make
// each compiler re-hash itself after the other ran. The stamp is `size sec.nsec` (`fsx.statNs`; seconds only
// off x86-64 Linux).
// J3: `moduleKey` streams `moduleIr` piece by piece into the hash and the layout scan (Rust builds the
// whole text); the key takes the text's `xxh3_64`, not the text.
module j3c.cache;

/// Layout text of every struct and enum, with which other entries each one names (Rust `Layouts`).
/// A-internal past the three fields: chunk A may add lookup fields (lookups only, never iterated out).
pub struct Layouts {
    texts: List<string>;
    needles: List<string>;
    deps: List<List<int>>;
    /// Type name -> its entries (a lookup only; several modules may share a name).
    byNeedle: Map<string, List<int>>;
    /// `xxh3_64` of each entry's text: the key hashes these, not the joined text (`hashSeen`).
    hashes: List<u64>;
    /// `firsts[b]`: some type name starts with byte `b` (`pushNamed` skips the map for the other tokens).
    firsts: []bool;
}

#[singleton]
let COMPILER_ID: u64;

/// Rust `version_id`: the id when the binary cannot be read.
fn versionId(): u64 { return xxh3_64("j3c-boot" as []u8); }

/// Rust `compiler_id`: hash of this binary, cached in `~/.cache/j3/compiler-boot.id` by size + mtime. Also
/// in every stamp of `cmd/stamp.j3`.
pub fn compilerId(arena: &Arena): u64 {
    if COMPILER_ID == 0 { COMPILER_ID = readCompilerId(arena); }
    return COMPILER_ID;
}

fn readCompilerId(arena: &Arena): u64 {
    let exe = "/proc/self/exe";
    let stamp = Text.new(arena);
    match fsx.statNs(exe, arena) {
        Option.Some(st) { stamp.fmt(`{st.0} {st.1}.{st.2}`); }
        Option.None {
            match io.stat(exe) {
                Result.Ok(e) { stamp.fmt(`{e.size} {e.mtime}`); }
                Result.Err(_) { return versionId(); }
            }
        }
    }
    let file = "";
    match cacheRoot(arena) {
        Option.Some(d) { file = path.join(d, "compiler-boot.id", arena); }
        Option.None {}
    }
    if file.len > 0 {
        match fsx.readText(file, arena) {
            Result.Ok(c) {
                let line = trim(c);
                let sp = lastIndexOf(line, " ");
                if sp > 0 && line[0..sp] == stamp.str() {
                    match parseU64(line[sp + 1..line.len], 16) {
                        Option.Some(id) { if id != 0 { return id; } }
                        Option.None {}
                    }
                }
            }
            Result.Err(_) {}
        }
    }
    // The binary is tens of megabytes: read it into its own arena, not the Session's.
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let id: u64 = 0;
    match io.readFile(exe, &mem) {
        Result.Ok(b) { id = xxh3_64(b); }
        Result.Err(_) { return versionId(); }
    }
    if id == 0 { id = 1; }
    if file.len > 0 {
        match io.makeDirs(path.dirname(file)) {
            Result.Ok(_) {}
            Result.Err(_) {}
        }
        let t = Text.new(arena);
        t.add(stamp.str()).add(" ").add(hex16(id, arena)).add("\n");
        match io.writeFile(file, t.str() as []u8) {
            Result.Ok(_) {}
            Result.Err(_) {}
        }
    }
    return id;
}

/// One hashed field, closed with a 0 byte so `("ab", "c")` differs from `("a", "bc")`.
fn hashStr(h: &Xxh3, s: string) {
    let zero: [1]u8 = [0];
    h.update(s as []u8);
    h.update(zero[..]);
}

/// Rust `object_key`: 16 hex digits over chunks, the layout digest of the types `text` names (as entry
/// hashes, see `hashSeen`), the hash of `text`, opt, debug, release, target, cpu, flags, clang and `compilerId`.
pub fn objectKey(text: string, e: &EmitOpts, layouts: &Layouts, arena: &Arena): string {
    let seen = layoutsNamed(layouts, text, arena);
    return keyOf(e, layouts, &seen, xxh3_64(text as []u8), arena);
}

/// Buffers `moduleKey` reuses from module to module.
pub struct KeyBufs {
    piece: Text;
    seen: List<bool>;
    stack: List<int>;
}

pub fn keyBufs(l: &Layouts, arena: &Arena): KeyBufs {
    let b = KeyBufs { piece: Text.new(arena), seen: List<bool>.new(arena), stack: List<int>.new(arena) };
    for _ in 0..l.texts.len { b.seen.push(false); }
    return b;
}

/// `objectKey(moduleIr(m))` without ever holding the module's text: each piece of `moduleIr` goes into
/// `b.piece`, then into the layout scan and the text hash, so only the biggest piece (one fn) is held.
/// The same key, as no name spans two pieces. Also the text's length (the unit's cost).
/// J3: Rust builds the whole text (`module_ir`); on a self build that text and its growth were ~60 MB.
pub fn moduleKey(cx: &IrCx, m: &Module, e: &EmitOpts, l: &Layouts, b: &KeyBufs, arena: &Arena): (string, int) {
    let h = Xxh3.new();
    let n = 0;
    for p in 0..irPieces(m) {
        b.piece.clear();
        irPiece(cx, m, p, &b.piece);
        let s = b.piece.str();
        pushNamed(l, s, &b.stack, &b.seen);
        h.update(s as []u8);
        n += s.len;
    }
    closeNamed(l, &b.stack, &b.seen);
    let key = keyOf(e, l, &b.seen, h.finish(), arena);
    for i in 0..b.seen.len { b.seen.items[i] = false; }
    return (key, n);
}

fn keyOf(e: &EmitOpts, layouts: &Layouts, seen: &List<bool>, textHash: u64, arena: &Arena): string {
    let h = Xxh3.new();
    let t = Text.new(arena);
    t.fmt(`{e.chunks}`);
    hashStr(&h, t.str());
    hashSeen(&h, layouts, seen, arena);
    hashU64(&h, textHash);
    hashStr(&h, e.cc.opt);
    hashStr(&h, if e.cc.debug { "g" } else { "" });
    hashStr(&h, if e.cc.release { "r" } else { "" });
    hashStr(&h, e.target);
    hashStr(&h, e.cpu);
    for i in 0..e.flags.len { hashStr(&h, e.flags.items[i]); }
    hashStr(&h, "");
    hashStr(&h, e.clang);
    t.clear();
    t.pushHex(compilerId(arena));
    hashStr(&h, t.str());
    return hex16(h.finish(), arena);
}

fn hashU64(h: &Xxh3, x: u64) {
    let v: [1]u64 = [x];
    let bytes: []u8 = @slice(v[..].ptr as ptr, 8);
    h.update(bytes);
}

/// A byte of a name token (Rust `tokens`: alphanumeric or `_`; every non-ASCII byte counts, so a name is
/// never cut).
fn isTokenByte(b: u8): bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_' || b >= 128;
}

/// Push the layout entries named by the tokens of `s` onto `stack`.
/// Each entry goes on once: `seen` marks it (a module text names `Id` thousands of times).
fn pushNamed(l: &Layouts, s: string, stack: &List<int>, seen: &List<bool>) {
    let i = 0;
    while i < s.len {
        if !isTokenByte(s[i]) { i += 1; continue; }
        let start = i;
        while i < s.len && isTokenByte(s[i]) { i += 1; }
        if !l.firsts[int(s[start])] { continue; }
        let at = l.byNeedle.find(s[start..i]);
        if at < 0 { continue; }
        let hits = l.byNeedle.valAt(at);
        for k in 0..hits.len {
            let e = hits.items[k];
            if seen.items[e] { continue; }
            seen.items[e] = true;
            stack.push(e);
        }
    }
}

/// Rust `layout_digest`: one entry per struct and enum, in module order then declaration order.
pub fn layoutDigest(cx: &IrCx, modules: []Module, arena: &Arena): Layouts {
    let l = Layouts { texts: List<string>.new(arena), needles: List<string>.new(arena), deps: List<List<int>>.new(arena),
        byNeedle: Map<string, List<int>>.new(arena, 256), hashes: List<u64>.new(arena), firsts: arena.alloc::<bool>(256) };
    for b in 0..256 { l.firsts[b] = false; }
    for mi in 0..modules.len {
        let label = moduleLabel(cx, &modules[mi], arena);
        for i in 0..modules[mi].structs.len {
            let def = cx.structDef(modules[mi].structs.items[i]);
            let s = Text.new(arena);
            s.add(label).add(".").add(cx.nameStr(def.name)).add(if def.packed { "|true|" } else { "|false|" });
            for j in 0..def.fields.len {
                let f = def.fields.items[j];
                s.add(cx.nameStr(f.name)).add(if f.embedded { ":true:" } else { ":false:" });
                pushStableTy(&s, cx, f.ty, 0);
                s.push(',');
            }
            l.needles.push(cx.nameStr(def.name));
            l.texts.push(s.str());
        }
        for i in 0..modules[mi].enums.len {
            let def = cx.enumDef(modules[mi].enums.items[i]);
            let s = Text.new(arena);
            s.add(label).add(".").add(cx.nameStr(def.name)).add("|");
            for j in 0..def.variants.len {
                let v = def.variants.items[j];
                s.add(cx.nameStr(v.name));
                match v.payload {
                    Option.Some(p) { pushStableTy(&s, cx, p, 0); }
                    Option.None {}
                }
                s.push(',');
            }
            l.needles.push(cx.nameStr(def.name));
            l.texts.push(s.str());
        }
    }
    for i in 0..l.needles.len {
        let nd = l.needles.items[i];
        if nd.len > 0 { l.firsts[int(nd[0])] = true; }
        let hits = l.byNeedle.getOrPut(l.needles.items[i], List<int>.new(arena));
        hits.push(i);
    }
    let mark = List<bool>.new(arena);
    for _ in 0..l.texts.len { mark.push(false); }
    for i in 0..l.texts.len {
        l.hashes.push(xxh3_64(l.texts.items[i] as []u8));
        let d = List<int>.new(arena);
        pushNamed(&l, l.texts.items[i], &d, &mark);
        for k in 0..d.len { mark.items[d.items[k]] = false; }
        l.deps.push(d);
    }
    return l;
}

/// Rust `Layouts::for_module`: layout text of the types `moduleText` names, closed over embedded types, in
/// entry order joined by `;`.
pub fn layoutsFor(l: &Layouts, moduleText: string, arena: &Arena): string {
    let seen = layoutsNamed(l, moduleText, arena);
    let out = Text.new(arena);
    let any = false;
    for i in 0..seen.len {
        if !seen.items[i] { continue; }
        if any { out.push(';'); }
        any = true;
        out.add(l.texts.items[i]);
    }
    return out.str();
}

/// `layoutsFor` as the key takes it: the hash of each named entry in entry order, then the count. Rust
/// hashes the joined text; joining and hashing every module's layouts (hundreds of KB for a module that
/// names the IR types) was half of `emit: hash modules`. Same entries, same order: same digest; an edited
/// entry changes its hash.
fn hashSeen(h: &Xxh3, l: &Layouts, seen: &List<bool>, arena: &Arena) {
    let n = 0;
    for i in 0..seen.len {
        if !seen.items[i] { continue; }
        hashU64(h, l.hashes.items[i]);
        n += 1;
    }
    let t = Text.new(arena);
    t.fmt(`{n}`);
    hashStr(h, t.str());
}

/// Which entries `moduleText` names, closed over the entries they name.
fn layoutsNamed(l: &Layouts, moduleText: string, arena: &Arena): List<bool> {
    let seen = List<bool>.new(arena);
    for _ in 0..l.texts.len { seen.push(false); }
    let stack = List<int>.new(arena);
    pushNamed(l, moduleText, &stack, &seen);
    closeNamed(l, &stack, &seen);
    return seen;
}

/// Mark the entries the ones on `stack` name, until it is empty.
fn closeNamed(l: &Layouts, stack: &List<int>, seen: &List<bool>) {
    while stack.len > 0 {
        let d = l.deps.items[stack.pop()];
        for k in 0..d.len {
            let e = d.items[k];
            if seen.items[e] { continue; }
            seen.items[e] = true;
            stack.push(e);
        }
    }
}

/// Rust `module_ir`: the stable IR text of one module (no ids that change between compiles) into `out`:
/// the IR dump, type arguments and field types, globals with their initializers, each fn's symbol, local
/// types and constants. It is the pieces of `irPiece` joined.
pub fn moduleIr(cx: &IrCx, m: &Module, out: &Text) {
    for p in 0..irPieces(m) { irPiece(cx, m, p, out); }
}

/// How many pieces `moduleIr` has: the dump's head and structs, each fn's dump, the type and global text,
/// each fn's key text.
fn irPieces(m: &Module): int { return 2 * m.funcs.len + 2; }

/// Piece `p` of `moduleIr`, appended to `out`. Every piece ends in a byte no name holds (`moduleKey`
/// scans them one by one).
/// J3: Rust's text has no `\n` after a fn's key text (it is `module_ir`'s only change).
fn irPiece(cx: &IrCx, m: &Module, p: int, out: &Text) {
    let nf = m.funcs.len;
    if p == 0 {
        let head = *m;
        head.funcs.len = 0;
        dumpModule(cx, &head, out);
    } else if p <= nf {
        let f = cx.func(m.funcs.items[p - 1]);
        dumpFunc(cx, &f, out);
        out.push('\n');
    } else if p == nf + 1 {
        typesIr(cx, m, out);
    } else {
        let f = cx.func(m.funcs.items[p - nf - 2]);
        pushFuncName(out, cx, &f);
        out.push(';');
        match f.kind {
            FuncKind.J3(jf) {
                for k in 0..jf.body.locals.len() {
                    pushStableTy(out, cx, jf.body.local(Id<LocalDecl> { i: u32(k) }).ty, 0);
                    out.push(';');
                }
                hashBlock(cx, &jf.body.block, out);
            }
            FuncKind.Lib(_) {}
            FuncKind.Decl {}
        }
        out.push('\n');
    }
}

/// Type arguments and field types, enum payloads, globals with their initializers.
fn typesIr(cx: &IrCx, m: &Module, out: &Text) {
    for i in 0..m.structs.len {
        let def = cx.structDef(m.structs.items[i]);
        for j in 0..def.tyArgs.len {
            out.add(def.tyArgs.items[j].name).push('=');
            pushStableTy(out, cx, def.tyArgs.items[j].ty, 0);
            out.push(';');
        }
        for j in 0..def.fields.len {
            pushStableTy(out, cx, def.fields.items[j].ty, 0);
            out.push(';');
        }
    }
    for i in 0..m.enums.len {
        let def = cx.enumDef(m.enums.items[i]);
        for j in 0..def.variants.len {
            match def.variants.items[j].payload {
                Option.Some(p) {
                    pushStableTy(out, cx, p, 0);
                    out.push(';');
                }
                Option.None {}
            }
        }
    }
    for i in 0..m.globals.len {
        let g = cx.global(m.globals.items[i]);
        out.add(cx.nameStr(g.name)).push(':');
        pushStableTy(out, cx, g.ty, 0);
        match g.init {
            Option.Some(init) { hashInit(cx, &init, out); }
            Option.None {}
        }
        out.push(';');
    }
}
