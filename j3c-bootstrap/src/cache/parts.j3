// Split modules: the `.parts` file, per-part objects, the giant-fn split plan.
//
// Part of module j3c.cache.
// Port of: j3c/src/emit/incr/parts.rs
module j3c.cache;

/// Rust `Path::with_extension`: `p` with what follows the last `.` of its file name replaced by `ext`.
fn withExt(p: string, ext: string, arena: &Arena): string {
    let dot = lastIndexOf(p, ".");
    let stem = if dot > lastIndexOf(p, "/") + 1 { p[0..dot] } else { p };
    return Text.new(arena).add(stem).add(".").add(ext).str();
}

/// Rust `parts_file`: `OBJ` with the extension `parts`.
pub fn partsFile(obj: string, arena: &Arena): string { return withExt(obj, "parts", arena); }

/// Rust `part_path`: object `n` of a split module (`OBJ` with the extension `p<n>.o`).
pub fn partPath(obj: string, n: int, arena: &Arena): string {
    let ext = Text.new(arena);
    ext.fmt(`p{n}.o`);
    return withExt(obj, ext.str(), arena);
}

/// Rust `parts_of`: how many objects the module was split into last time (0 = one object).
pub fn partsOf(obj: string, arena: &Arena): int {
    match io.readFile(partsFile(obj, arena), arena) {
        Result.Ok(b) {
            match parseInt(trim(b as string), 10) {
                Option.Some(n) { if n > 0 { return n; } }
                Option.None {}
            }
        }
        Result.Err(_) {}
    }
    return 0;
}

/// Rust `define_sizes`: byte length of each `define` block in a module's LLVM text, by symbol.
pub fn defineSizes(ll: string, arena: &Arena): Map<string, int> {
    let sizes = Map<string, int>.new(arena, 256);
    let name = "";
    let open = false;
    let n = 0;
    let it = lines(ll);
    while true {
        match it.next() {
            Option.Some(line) {
                if startsWith(line, "define ") {
                    name = "";
                    let at = find(line, "@");
                    if at >= 0 {
                        let rest = line[at + 1..line.len];
                        let end = find(rest, "@");
                        if end >= 0 { rest = rest[0..end]; }
                        let paren = find(rest, "(");
                        name = if paren >= 0 { rest[0..paren] } else { rest };
                    }
                    open = true;
                    n = 0;
                }
                if open {
                    n += line.len + 1;
                    if line == "}" {
                        sizes.put(name, n);
                        open = false;
                    }
                }
            }
            Option.None { break; }
        }
    }
    return sizes;
}

/// A fn this large makes clang's backend slow on its own (it grows faster than linearly).
const GIANT_FN: int = 15000;

/// Rust `split_plan`: one fn set per object for a module with several giant fns, balanced by LLVM text
/// size; an empty list (Rust `None`) when it is not worth it or `[emit] chunks = 0`. `slots`: how many clangs
/// this worker may run at once (`jobCap() / workers`), so all workers' chunk clangs stay within `jobCap()`.
pub fn splitPlan(cx: &IrCx, m: &Module, ll: string, e: &EmitOpts, slots: int, arena: &Arena): List<Set<Id<Func>>> {
    let sets = List<Set<Id<Func>>>.new(arena);
    // ponytail: the share is fixed when the worker starts the unit, so a split late in a build cannot use
    // workers that went idle; a shared token pool would.
    let half = jobCap() / 2;
    if half > slots { half = slots; }
    if half < 1 { half = 1; }
    let cap = if e.chunks < 0 { 4 } else { e.chunks };
    if cap > half { cap = half; }
    if cap < 2 { return sets; }
    let sizes = defineSizes(ll, arena);
    let ids = List<Id<Func>>.new(arena);
    let weights = List<int>.new(arena);
    let giants = 0;
    let total = 0;
    let max = 0;
    for i in 0..m.funcs.len {
        let f = cx.func(m.funcs.items[i]);
        let at = sizes.find(funcName(cx, &f, arena));
        if at < 0 { continue; }
        let size = sizes.valAt(at);
        ids.push(m.funcs.items[i]);
        weights.push(size);
        if size >= GIANT_FN { giants += 1; }
        total += size;
        if size > max { max = size; }
    }
    let n = if giants < cap { giants } else { cap };
    // one giant: at least take everything else off its object
    if n < 2 && max >= GIANT_FN && total - max >= max / 3 { n = 2; }
    if n < 2 { return sets; }
    for _ in 0..n { sets.push(Set<Id<Func>>.new(arena, ids.len / n + 1)); }
    let part = chunkAssign(weights.slice(), n, arena);
    for i in 0..ids.len { sets.items[part.items[i]].add(ids.items[i]); }
    return sets;
}
