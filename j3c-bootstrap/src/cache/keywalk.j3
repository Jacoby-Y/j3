// The constants of a module body, as key text: the IR dump prints a fn address by its short name and no
// global initializer, so every constant's value is added here.
//
// Part of module j3c.cache.
// Port of: j3c/src/emit/incr/key.rs (`hash_init_into` .. `hash_operand_into`)
// J3: Exhaustive matches (rule 6): a new statement or rvalue kind has to say which operands it holds.
module j3c.cache;

fn hashInit(cx: &IrCx, init: &ConstInit, out: &Text) {
    match *init {
        ConstInit.Scalar(s) { hashOperand(cx, s.value, out); }
        ConstInit.Fields(fs) {
            for i in 0..fs.fields.len {
                out.add(fs.fields.items[i].name);
                hashInit(cx, &fs.fields.items[i].init, out);
            }
        }
        ConstInit.Elems(es) {
            for i in 0..es.elems.len { hashInit(cx, &es.elems.items[i], out); }
        }
    }
}

fn hashBlock(cx: &IrCx, b: &Block, out: &Text) {
    for i in 0..b.stmts.len { hashStmt(cx, &b.stmts.items[i], out); }
}

fn hashOperands(cx: &IrCx, xs: &List<Operand>, out: &Text) {
    for i in 0..xs.len { hashOperand(cx, xs.items[i], out); }
}

fn hashParts(cx: &IrCx, parts: &List<InterpPart>, out: &Text) {
    for i in 0..parts.len {
        match parts.items[i] {
            InterpPart.Value(op) { hashOperand(cx, op, out); }
            InterpPart.Lit(_) {}
        }
    }
}

fn hashStmt(cx: &IrCx, s: &Stmt, out: &Text) {
    match s.kind {
        StmtKind.Assign(a) { hashRvalue(cx, &a.rvalue, out); }
        StmtKind.AssignOp(a) { hashOperand(cx, a.rhs, out); }
        StmtKind.Defer(d) { hashBlock(cx, &d.body, out); }
        StmtKind.Block(b) { hashBlock(cx, &b, out); }
        StmtKind.If(i) {
            hashOperand(cx, i.cond, out);
            hashBlock(cx, &i.thenBlock, out);
            match i.elseBlock {
                Option.Some(e) { hashBlock(cx, &e, out); }
                Option.None {}
            }
        }
        StmtKind.While(w) {
            hashOperand(cx, w.cond, out);
            hashBlock(cx, &w.body, out);
        }
        StmtKind.Switch(sw) {
            hashOperand(cx, sw.scrut, out);
            for i in 0..sw.cases.len {
                out.add("case ").pushU64(sw.cases.items[i].value);
                out.push(';');
                hashBlock(cx, &sw.cases.items[i].block, out);
            }
            hashBlock(cx, &sw.default, out);
        }
        StmtKind.Return(r) {
            match r.value {
                Option.Some(v) { hashOperand(cx, v, out); }
                Option.None {}
            }
        }
        StmtKind.Expr(rv) { hashRvalue(cx, &rv, out); }
        StmtKind.ForRange(f) {
            hashOperand(cx, f.end, out);
            hashBlock(cx, &f.body, out);
        }
        StmtKind.InterpFill(f) { hashParts(cx, &f.parts, out); }
        StmtKind.Break(_) {}
        StmtKind.Continue(_) {}
        StmtKind.Abort(_) {}
        StmtKind.Div0 {}
    }
}

fn hashRvalue(cx: &IrCx, rv: &Rvalue, out: &Text) {
    match rv.kind {
        RvalueKind.Use(op) { hashOperand(cx, op, out); }
        RvalueKind.Cast(c) { hashOperand(cx, c.from, out); }
        RvalueKind.Ref(_) {}
        RvalueKind.Binary(b) {
            hashOperand(cx, b.lhs, out);
            hashOperand(cx, b.rhs, out);
        }
        RvalueKind.Unary(u) { hashOperand(cx, u.arg, out); }
        RvalueKind.Call(c) {
            hashOperand(cx, c.func, out);
            hashOperands(cx, &c.args, out);
        }
        RvalueKind.Syscall(c) {
            hashOperand(cx, c.nr, out);
            hashOperands(cx, &c.args, out);
        }
        RvalueKind.Simd(sm) {
            out.add(simdName(sm.op));
            match sm.op {
                SimdOp.Shuffle(sh) { for i in 0..4 { out.pushU64(u64(sh.lanes[i])); } }
                _ {}
            }
            hashOperands(cx, &sm.args, out);
        }
        RvalueKind.Atomic(a) {
            out.add(atomicOpName(a.op)).add(atomicOrderName(a.order));
            hashOperands(cx, &a.args, out);
        }
        RvalueKind.Aggregate(a) { hashOperands(cx, &a.fields, out); }
        RvalueKind.Enum(e) {
            match e.payload {
                Option.Some(p) { hashOperand(cx, p, out); }
                Option.None {}
            }
        }
        RvalueKind.Interpolate(ip) { hashParts(cx, &ip.parts, out); }
    }
}

/// A constant's value, closed with `;` (a place adds nothing: the dump has it).
fn hashOperand(cx: &IrCx, op: Operand, out: &Text) {
    match op {
        Operand.Copy(_) {}
        Operand.Const(c) {
            match c.kind {
                ConstKind.Void { out.add("Void"); }
                ConstKind.Null { out.add("Null"); }
                ConstKind.Bool(v) { out.add(if v { "Bool(true)" } else { "Bool(false)" }); }
                ConstKind.Int(v) { out.add("Int(").pushU64(v); out.push(')'); }
                ConstKind.F32Bits(v) { out.add("F32Bits(").pushU64(u64(v)); out.push(')'); }
                ConstKind.F64Bits(v) { out.add("F64Bits(").pushU64(v); out.push(')'); }
                ConstKind.FnAddr(fa) {
                    let f = cx.func(fa.func);
                    pushFuncName(out, cx, &f);
                }
                ConstKind.Bytes(b) {
                    // `@embed` data can be megabytes: its hash, not its bytes.
                    out.fmt(`Bytes#{b.bytes.len}:`);
                    if b.bytes.len > 256 { out.pushHex(xxh3_64(b.bytes)); } else { out.pushBytes(b.bytes); }
                }
            }
            out.push(';');
        }
    }
}
