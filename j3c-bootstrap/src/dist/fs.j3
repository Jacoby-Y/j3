// File helpers the dist outputs share: mode-keeping copies, `chmod`, umask `mkdir -p`, `objdump -p`, the logo.
//
// Port of: j3c/src/dist.rs (`copy`, `copy_all`, `objdump_p`, `LOGO_PNG`)
// J3: Modes as Rust's `fs` (zip members keep modes; the `.deb` control folder is `0777 & ~umask`) come from
//     `base/fsx` (`makeDirs`, `copyFile`, `modeOf`, `setMode`); this file adds dist's error texts.
module j3c.dist.fs;

use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.text.{ Text, lines, startsWith, trim };
use j3c.base.fsx;
use j3c.toolchain;

const LOGO_PNG = @embedBytes("../../text/dist/logo.png");

/// The J3 logo, 256x256: the package icon when `[dist] icon` is unset (Rust `LOGO_PNG`; a fn: an embed
/// const is not importable under stage 0).
pub fn logoPng(): []u8 { return LOGO_PNG; }

/// The permission bits of `p` (following symlinks), -1 when it cannot be read.
pub fn modeOf(p: string, arena: &Arena): int { return fsx.modeOf(p, arena); }

/// Rust `set_mode`: `chmod p mode`; Err `chmod P: E`.
pub fn setMode(p: string, mode: int, arena: &Arena): Result<bool, string> {
    match fsx.setMode(p, mode, arena) {
        Result.Ok(_) { return Result.Ok(true); }
        Result.Err(e) { return Result.Err(Text.new(arena).add("chmod ").add(p).add(": ").add(e).str()); }
    }
}

/// `mkdir -p dir`; Err `mkdir DIR: E` (Rust's message in dist, deb and apk).
pub fn mkdirs(dir: string, arena: &Arena): Result<bool, string> {
    match fsx.makeDirs(dir, arena) {
        Result.Ok(_) { return Result.Ok(true); }
        Result.Err(e) { return Result.Err(Text.new(arena).add("mkdir ").add(dir).add(": ").add(e).str()); }
    }
}

/// Rust `fs::copy`: the bytes and the mode of `from`. Err is the bare OS error text.
pub fn copyRaw(from: string, to: string, arena: &Arena): Result<bool, string> { return fsx.copyFile(from, to, arena); }

/// Rust `dist::copy`: Err `copy FROM to TO: E`.
pub fn copy(from: string, to: string, arena: &Arena): Result<bool, string> {
    match copyRaw(from, to, arena) {
        Result.Ok(_) { return Result.Ok(true); }
        Result.Err(e) { return Result.Err(Text.new(arena).add("copy ").add(from).add(" to ").add(to).add(": ").add(e).str()); }
    }
}

/// Rust `copy_all`: a file or a whole folder (following symlinks).
pub fn copyAll(from: string, to: string, arena: &Arena): Result<bool, string> {
    let parent = path.dirname(to);
    if parent.len > 0 { mkdirs(parent, arena)?; }
    if !fsx.isDir(from) { return copy(from, to, arena); }
    mkdirs(to, arena)?;
    match io.listDir(from, arena) {
        Result.Ok(ents) {
            for i in 0..ents.len { copyAll(path.join(from, ents[i].name, arena), path.join(to, ents[i].name, arena), arena)?; }
        }
        Result.Err(_) { return Result.Err(Text.new(arena).add("read ").add(from).add(": ").add(fsx.osError(sys.errno(), arena)).str()); }
    }
    return Result.Ok(true);
}

/// Rust `fs::read` with `read P: E`.
pub fn read(p: string, arena: &Arena): Result<[]u8, string> {
    match io.readFile(p, arena) {
        Result.Ok(b) { return Result.Ok(b); }
        Result.Err(_) { return Result.Err(Text.new(arena).add("read ").add(p).add(": ").add(fsx.osError(sys.errno(), arena)).str()); }
    }
}

/// Rust `fs::write` with `write P: E` (no parent made).
pub fn writeRaw(p: string, bytes: []u8, arena: &Arena): Result<bool, string> {
    match fsx.writeFile(p, bytes, arena) {
        Result.Ok(_) { return Result.Ok(true); }
        Result.Err(e) { return Result.Err(Text.new(arena).add("write ").add(p).add(": ").add(e).str()); }
    }
}

/// Rust `deb::write_bytes`: the parent made first, then the file.
pub fn writeBytes(p: string, bytes: []u8, arena: &Arena): Result<bool, string> {
    let dir = path.dirname(p);
    if dir.len > 0 { mkdirs(dir, arena)?; }
    return writeRaw(p, bytes, arena);
}

/// Rust `objdump_p`: values of `objdump -p BIN` lines starting with `key` (`DLL Name:` on PE, `NEEDED` on
/// ELF), from the first of llvm-objdump beside the picked clang, mingw, llvm and plain objdump that runs and
/// succeeds; empty when none does.
pub fn objdumpP(bin: string, key: string, arena: &Arena): List<string> {
    let rest: [3]string = ["x86_64-w64-mingw32-objdump", "llvm-objdump", "objdump"];
    let tools = toolchain.besideClang("objdump", rest[..], arena);
    let out = List<string>.new(arena);
    for i in 0..tools.len {
        let argv: [3]string = [tools.items[i], "-p", bin];
        match proc.run(argv[..], "", arena) {
            Result.Ok(o) {
                if o.code == 0 {
                    for l in lines(o.outStr()) {
                        let t = trim(l);
                        if startsWith(t, key) { out.push(trim(t[key.len..t.len])); }
                    }
                    return out;
                }
            }
            Result.Err(_) {}
        }
    }
    return out;
}
