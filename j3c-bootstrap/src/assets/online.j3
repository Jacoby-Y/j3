// Search and fetch CC0 assets (Poly Haven, ambientCG, Kenney) with `curl` (`--proto =https`), cached under
// `~/.cache/j3/assets`.
//
// Port of: j3c/src/online.rs, online/sources.rs
// J3: Never run in tests (network); unit tests feed canned JSON/HTML to the parsers.
module j3c.assets.online;

use j3.memory.{ Arena, List };
use j3.result.Result;

/// One search result (Rust `online::Hit`).
pub struct Hit {
    source: string;
    id: string;
    kind: string;
    name: string;
    author: string;
    thumb: string;
}

/// What `fetch` got (Rust `online::Fetched`).
pub enum Fetched {
    /// A model file in the cache, ready for `editor.assets.importAsset`.
    Model(string),
    /// A project-relative `.j3mat`.
    Material(string),
    /// A Kenney pack's model files in the cache; fetch again with `file` to import one.
    Pack([]string),
    /// A project-relative equirect PNG for a `builtin:sky` mesh.
    Sky(string),
}

/// Rust `online::search`. → MCP (`asset_online_search`), EDDEV
pub fn search(source: string, query: string, kind: string, arena: &Arena): Result<List<Hit>, string> {
    return Result.Err("online: not ported yet");
} // STUB ASSETS

/// Rust `online::fetch`; `file` "" = none. → MCP (`asset_fetch`), EDDEV
pub fn fetch(root: string, source: string, id: string, file: string, arena: &Arena): Result<Fetched, string> {
    return Result.Err("online: not ported yet");
} // STUB ASSETS
