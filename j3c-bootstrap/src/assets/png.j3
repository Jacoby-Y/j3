// PNG encode (real filtering, `base/deflate`), decode, shrink, base64: byte-equal with Rust's output, so
// `-e imgdiff --out` and the MCP render thumbnails compare.
//
// Port of: j3c/src/png.rs
module j3c.assets.png;

use j3.memory.{ Arena, List };
use j3.option.Option;

/// A decoded image: `px` is RGBA, `w * h * 4` bytes.
pub struct Image {
    px: List<u8>;
    w: int;
    h: int;
}

/// Rust `encode_rgba`: a PNG of `rgba` (`w * h * 4` bytes). → DIST (deb icon)
pub fn encodeRgba(w: int, h: int, rgba: []u8, arena: &Arena): List<u8> { return List<u8>.new(arena); } // STUB IMG

/// Rust `compact`: the same image re-encoded smaller, None when it isn't a PNG this can read. → MCP (render)
pub fn compact(png: []u8, arena: &Arena): Option<List<u8>> { return Option.None; } // STUB IMG

/// Rust `base64` (standard alphabet, padded). → MCP
pub fn base64(data: []u8, arena: &Arena): string { return ""; } // STUB IMG

/// Rust `decode`: 8-bit RGB/RGBA/grey PNG to RGBA; None otherwise. → ASSETS (gltf textures)
pub fn decode(png: []u8, arena: &Arena): Option<Image> { return Option.None; } // STUB IMG
