// Entry point: read argv and hand it to `cmd.args.run`. Nothing else lives here.
//
// Port of: j3c/src/main.rs, lib.rs
// J3: lib.rs's module list becomes the folder layout; there is no library/binary split.
// J3: The `use`s of tool modules no command reaches yet keep them typechecked by `stage0/j3c check
// j3c-bootstrap` (it only checks what main reaches); drop each one when a command dispatches to it.
module j3c;

use j3.memory.Arena;
use j3.sys;
use j3c.cmd.args;
use j3c.lsp.proto;
use j3c.mcp.server;
use j3c.syntax.walk;
use j3c.syntax.flow;
use j3c.syntax.extend;
use j3c.base.toml;
// C3 contract modules nothing calls yet (wave 20 wires them): imported so they compile.
use j3c.cmd.stamp;
// C4 stubs (wave 22) that nothing calls yet: imported so they compile.
use j3c.cmd.devrun;
use j3c.cmd.hot;
// C5 stubs (wave 25) no command reaches yet: imported so they compile. Drop each when its caller lands.
use j3c.assets.gltf;
use j3c.assets.gltf_material;
use j3c.assets.online;
use j3c.assets.pack;
use j3c.assets.png;
use j3c.base.deflate;
use j3c.base.fixed;
use j3c.base.zip;
use j3c.cmd.csslint;
use j3c.dist;
use j3c.dist.apk;
use j3c.dist.deb;
use j3c.dist.pkg;
use j3c.editor.frontend;
use j3c.editor.play;
use j3c.lsp;
use j3c.lsp.complete;
use j3c.lsp.diag;
use j3c.lsp.docs;
use j3c.lsp.query;
use j3c.lsp.ui;
use j3c.mcp;
use j3c.scene.diff;
use j3c.scene.history;
use j3c.scene.ops;
use j3c.scene.patterns;
use j3c.scene.reply;

fn main() {
    let mem = Arena.create(4096);
    let n = sys.argCount() - 1;
    if n < 0 { n = 0; }
    let argv = mem.alloc::<string>(n);
    for i in 0..n { argv[i] = sys.arg(i + 1); }
    sys.exit(i32(args.run(argv)));
}
