// Entry point: read argv and hand it to `cmd.args.dispatch`. Nothing else lives here.
//
// Port of: j3c/src/main.rs, lib.rs
// J3: lib.rs's module list becomes the folder layout; there is no library/binary split.
// J3: Until `cmd.args` is ported, every command fails with `j3c-boot: CMD: not ported yet` and exit 1,
// so `tests/diff.sh` reports CRASH, not DIFF.
module j3c;

use j3.sys;

fn main() {
    let cmd = sys.arg(1);
    let head = "j3c-boot: ";
    let tail = ": not ported yet\n";
    sys.write(2, head.ptr as ptr, head.len);
    sys.write(2, cmd.ptr as ptr, cmd.len);
    sys.write(2, tail.ptr as ptr, tail.len);
    sys.exit(1);
}
