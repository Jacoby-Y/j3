// Shader error: pair mismatch.
module shader_pair_mismatch;
#[varying] struct V { position: vec4; }
#[varying] struct W { position: vec4; }
#[shader(vertex)] fn vs(): V { return V { position: vec4(0.0) }; }
#[shader(fragment)] fn fs(w: W): vec4 { return w.position; }
const P = @shader(vs, fs);
fn main() {}
