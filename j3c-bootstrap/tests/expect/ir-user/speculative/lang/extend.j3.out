module speculative.extend;

struct Counter {
    n: int;
}

struct Box {
    v: int;
}

struct Box {
    v: string;
}

fn get(this: &Counter): int {
    return copy (*this).n;
}

fn bump(this: &Counter, by: int) {
    (*this).n += copy by;
}

fn scale(this: &Counter, k: int) {
    (*this).n *= copy k;
}

fn double(this: &Counter): int {
    let tmp _t0: int;
    let tmp _t1: int;

    _t0 = get(copy this);
    _t1 = copy _t0 * 2;
    return copy _t1;
}

