    let m: int;
    let tmp _s21: string;
    let tmp _s22: string;
    let m2: int;
    let tmp _s23: string;
    let tmp _s24: string;
    let n: int;
    let tmp _s25: string;

    a = grid(copy d, 0);
    _s0 = "explicit rows: first";
    at(copy d, copy a, 0, f32(0x0), f32(0x0), f32(0x42c80000), f32(0x41f00000), copy _s0);
    _s1 = "explicit rows: column gap";
    at(copy d, copy a, 1, f32(0x42f00000), f32(0x0), f32(0x42c80000), f32(0x41f00000), copy _s1);
    _s2 = "explicit rows: second row, row gap";
    at(copy d, copy a, 2, f32(0x0), f32(0x42200000), f32(0x42c80000), f32(0x42480000), copy _s2);
    _s3 = "explicit rows: fourth";
    at(copy d, copy a, 3, f32(0x42f00000), f32(0x42200000), f32(0x42c80000), f32(0x42480000), copy _s3);
    _s4 = "implicit auto row after the template";
    at(copy d, copy a, 4, f32(0x0), f32(0x42c80000), f32(0x42c80000), f32(0x41a00000), copy _s4);
    _bc5 = copy a < 0;
    _bc6 = copy a >= copy (*d).nodes.items.len;
    _bc7 = copy _bc5 || copy _bc6;
    if copy _bc7 {
        abort;
    }
    _s8 = "explicit rows: grid height";
    near(copy (*d).nodes.items[copy a].h, f32(0x42f00000), copy _s8);
    b = grid(copy d, 1);
    third = f32(0x42555554);
    _s9 = "fr rows with a definite height: 1fr";
    at(copy d, copy b, 0, f32(0x0), f32(0x0), f32(0x43480000), copy third, copy _s9);
    _t10 = copy third + f32(0x41200000);
    _t11 = copy third * f32(0x40000000);
    _s12 = "fr rows with a definite height: 2fr";
    at(copy d, copy b, 1, f32(0x0), copy _t10, f32(0x43480000), copy _t11, copy _s12);
    _s13 = "fr rows: fixed last row";
    at(copy d, copy b, 2, f32(0x0), f32(0x43340000), f32(0x43480000), f32(0x41a00000), copy _s13);
    b2 = grid(copy d, 2);
    _s14 = "fr rows with an unknown height are auto: first";
    at(copy d, copy b2, 0, f32(0x0), f32(0x0), f32(0x43480000), f32(0x41a00000), copy _s14);
    _s15 = "fr rows with an unknown height are auto: second";
    at(copy d, copy b2, 1, f32(0x0), f32(0x41f00000), f32(0x43480000), f32(0x41a00000), copy _s15);
    _s16 = "fixed row";
    at(copy d, copy b2, 2, f32(0x0), f32(0x42700000), f32(0x43480000), f32(0x41a00000), copy _s16);
    _bc17 = copy b2 < 0;
    _bc18 = copy b2 >= copy (*d).nodes.items.len;
    _bc19 = copy _bc17 || copy _bc18;
    if copy _bc19 {
        abort;
    }
    _s20 = "unknown height: grid height is the rows plus gaps";
    near(copy (*d).nodes.items[copy b2].h, f32(0x42a00000), copy _s20);
    m = grid(copy d, 15);
    _s21 = "percent row of a definite height";
    at(copy d, copy m, 0, f32(0x0), f32(0x0), f32(0x42c80000), f32(0x42480000), copy _s21);
    _s22 = "fr row takes the rest";
