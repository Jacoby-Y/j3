}

fn testMinmax(d: &Dom) {
    let c: int;
    let tmp _s0: string;
    let tmp _s1: string;
    let c2: int;
    let tmp _s2: string;
    let tmp _s3: string;
    let c3: int;
    let tmp _s4: string;
    let tmp _s5: string;

    c = grid(copy d, 3);
    _s0 = "minmax(100px, 200px) grows to its maximum";
    at(copy d, copy c, 0, f32(0x0), f32(0x0), f32(0x43480000), f32(0x0), copy _s0);
    _s1 = "minmax(50px, 1fr) takes the rest";
    at(copy d, copy c, 1, f32(0x43480000), f32(0x0), f32(0x42c80000), f32(0x0), copy _s1);
    c2 = grid(copy d, 4);
    _s2 = "minmax stops at its maximum";
    at(copy d, copy c2, 0, f32(0x0), f32(0x0), f32(0x43480000), f32(0x0), copy _s2);
    _s3 = "second minmax stops at its maximum";
    at(copy d, copy c2, 1, f32(0x43480000), f32(0x0), f32(0x42c80000), f32(0x0), copy _s3);
    c3 = grid(copy d, 5);
    _s4 = "minmax(100px, 1fr) is not squeezed below 100px";
    at(copy d, copy c3, 0, f32(0x0), f32(0x0), f32(0x42c80000), f32(0x0), copy _s4);
    _s5 = "the other fr gets what is left";
    at(copy d, copy c3, 1, f32(0x42c80000), f32(0x0), f32(0x41a00000), f32(0x0), copy _s5);
}

