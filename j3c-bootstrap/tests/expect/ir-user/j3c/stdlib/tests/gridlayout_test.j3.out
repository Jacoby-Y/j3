    _bc0 = copy id < 0;
    _bc1 = copy id >= copy (*d).nodes.items.len;
    _bc2 = copy _bc0 || copy _bc1;
    if copy _bc2 {
        abort;
    }
    c = copy (*d).nodes.items[copy id].first;
    q = 0;
    for q .. copy n {
        _bc3 = copy c < 0;
        _bc4 = copy c >= copy (*d).nodes.items.len;
        _bc5 = copy _bc3 || copy _bc4;
        if copy _bc5 {
            abort;
        }
        c = copy (*d).nodes.items[copy c].next;
    }
    return copy c;
}

