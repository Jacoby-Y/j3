+struct World {
+    root: Screen;
+    mode: string;
+    frame: int;
+    used: int;
+    laid: int;
+    styles: int;
+}
 fn boot(mem: &Arena): World {
     let root = Screen.new(mem);
     root.dom.setFrameMs(16.0);
     root.dom.setFallbackFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
-    return World { root: root, mode: env("SEL_PTR"), frame: 0, used: 0, laid: 0, styles: 0 };
+    return World {
+        root: root, mode: env("SEL_PTR"), frame: 0, used: 0, laid: 0, styles: 0
+    };
 }
 fn draw(w: &World) {
     clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
@@ -23,12 +36,22 @@
         d.simInput(-5.0, -5.0, false, 0.0);
     }
     w.root.render(windowSize(), ScreenProps { });
-    if w.frame == 10 { w.used = d.mem.used; w.laid = d.laid; w.styles = d.restyled; }
-    if w.frame > 10 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) { panic("uisel2 steady frame changed layout style or allocation"); }
-    if w.frame == 20 { printLn("uisel2 ok"); }
+    if w.frame == 10 {
+        w.used = d.mem.used;
+        w.laid = d.laid;
+        w.styles = d.restyled;
+    }
+    if w.frame > 10 && (d.mem.used != w.used || d.laid != w.laid || d.restyled != w.styles) {
+        panic("uisel2 steady frame changed layout style or allocation");
+    }
+    if w.frame == 20 {
+        printLn("uisel2 ok");
+    }
     w.frame += 1;
 }
