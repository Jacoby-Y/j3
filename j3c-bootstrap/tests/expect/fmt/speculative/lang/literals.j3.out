+}
 
 /// Counts down from `n` to 1.
 struct Down {
     n: int;
 
     fn next(this: &Down): Option<int> {
-        if this.n == 0 { return Option.None; }
+        if this.n == 0 {
+            return Option.None;
+        }
         this.n -= 1;
         return Option.Some(this.n + 1);
