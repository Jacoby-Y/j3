+        }
+        "if" if w.len > 5 {
+            return 99;
+        }
+        "if" {
+            return 3;
+        }
+        _ {
+            return 0;
+        }
     }
 }
 
-struct Pt { x: int; y: f32; on: bool; }
+struct Pt {
