 // - a tuple is a plain struct: one type program-wide per element list
 // - `==` and `hash()` exist when every element has them, so a tuple can be a `Map` key
 // - interpolation prints `(1, x)`
-
 module speculative.tuples;
 
 use j3.data.map.Map;
@@ -13,7 +12,9 @@
 use j3.memory.Arena;
 use j3.option.Option;
 
-enum Op { Add, Mul }
+enum Op {
+    Add, Mul
+}
 
 fn divmod(a: int, b: int): (int, int) {
     return (a / b, a % b);
@@ -21,16 +22,24 @@
 
 fn find(xs: []int, x: int): Option<(int, int)> {
     for i in 0..xs.len {
-        if xs[i] == x { return Option.Some((i, xs[i] * 10)); }
+        if xs[i] == x {
+            return Option.Some((i, xs[i] * 10));
+        }
     }
     return Option.None;
 }
 
 fn apply(p: (Op, int), x: int): int {
     match p {
-        (Op.Add, n) { return x + n; }
-        (Op.Mul, 0) { return 0; }
-        (Op.Mul, n) { return x * n; }
+        (Op.Add, n) {
+            return x + n;
+        }
+        (Op.Mul, 0) {
+            return 0;
+        }
+        (Op.Mul, n) {
+            return x * n;
+        }
     }
 }
 
