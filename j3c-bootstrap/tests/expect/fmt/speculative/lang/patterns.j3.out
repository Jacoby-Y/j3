 // - `'a'..='z'` / `0..=9`: ranges in an int match, both ends included; ranges and values may
 //   not overlap
 // - nested payloads: `Shape.Pair(Tok.Num(n))`
-
 module speculative.patterns;
 
 use j3.io.printLn;
 
-enum Tok { Plus, Minus, Star, Slash, Num(int), Name(string), Eof }
+enum Tok {
+    Plus, Minus, Star, Slash, Num(int), Name(string), Eof
+}
 
-enum Shape { Dot(int), Pair(Tok) }
+enum Shape {
+    Dot(int), Pair(Tok)
+}
 
 fn kind(c: u8): string {
     match c {
-        'a'..='z' | 'A'..='Z' | '_' { return "name"; }
-        '0'..='9' { return "digit"; }
-        ' ' | '\t' | '\n' { return "space"; }
-        _ { return "other"; }
+        'a'..='z' | 'A'..='Z' | '_' {
+            return "name";
+        }
+        '0'..='9' {
+            return "digit";
+        }
+        ' ' | '\t' | '\n' {
+            return "space";
+        }
+        _ {
+            return "other";
+        }
     }
 }
 
 fn describe(t: Tok) {
     match t {
-        Tok.Plus | Tok.Minus { printLn("add"); }
-        Tok.Star | Tok.Slash { printLn("mul"); }
-        Tok.Num(n) if n < 0 { printLn(`negative {n}`); }
-        Tok.Num(n) { printLn(`number {n}`); }
-        _ { printLn("other"); }
+        Tok.Plus | Tok.Minus {
+            printLn("add");
+        }
+        Tok.Star | Tok.Slash {
+            printLn("mul");
+        }
+        Tok.Num(n) if n < 0 {
+            printLn(`negative {n}`);
+        }
+        Tok.Num(n) {
+            printLn(`number {n}`);
+        }
+        _ {
+            printLn("other");
+        }
     }
 }
 
 fn size(s: Shape): int {
     match s {
-        Shape.Dot(n) | Shape.Pair(Tok.Num(n)) { return n; }
-        _ { return -1; }
+        Shape.Dot(n) | Shape.Pair(Tok.Num(n)) {
+            return n;
+        }
+        _ {
+            return -1;
+        }
     }
 }
 
