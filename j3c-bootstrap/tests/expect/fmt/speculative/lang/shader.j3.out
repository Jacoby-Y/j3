+    pos: Vec2;
+    size: Vec2;
+    tint: vec4f;
+}
+#[varying] struct V {
+    position: vec4;
+    uv: vec2;
+    tint: vec4;
+}
 
 #[uniform] let uScreen: vec2;
 #[uniform] let uAtlas: sampler2D;
