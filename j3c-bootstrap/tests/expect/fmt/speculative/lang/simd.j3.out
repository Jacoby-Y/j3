--- input
+++ fmt
@@ -1,11 +1,12 @@
 // SIMD. `vec4f` / `vec4i` are 16-byte vectors with lane-wise operators.
 // Same results on the LLVM and C backends (min/max give `b` on NaN, `@vsum` is the fixed tree
 // (x + y) + (z + w), `@vint` saturates and turns NaN into 0). Not available in `.j3s` scripts.
-
 module speculative.simd;
 
 use j3.io.printLn;
-use j3.math.{ Vec3, vec3FromVec4f };
+use j3.math.{
+    Vec3, vec3FromVec4f
+};
 
 fn show(v: vec4f) {
     printLn(`{v.x} {v.y} {v.z} {v.w}`);
@@ -31,7 +32,9 @@
     @vstore(s, 4, @vload(s, 0) + @vload(s, 4));
     printLn(`{xs[4]} {xs[7]}`);
 
-    let p = Vec3 { x: 1.0, y: 2.0, z: 3.0 };
+    let p = Vec3 {
+        x: 1.0, y: 2.0, z: 3.0
+    };
     let back = vec3FromVec4f(p.toVec4f(9.0) * 2.0);
     printLn(`{back.x} {back.y} {back.z}`);
 }
--- stderr
--- exit 0
