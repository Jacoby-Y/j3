     d.setFrameMs(16.0);
     d.simInput(-5.0, -5.0, false, 0.0);
-    STATE = St {};
-    IDS = Ids {};
+    STATE = St {
+    };
+    IDS = Ids {
+    };
     a11y.enable(&d);
     frame(&d);
     frame(&d);
@@ -132,8 +135,12 @@
