+            sawSel = true;
+        }
+        if ev2.items[i].kind == a11y.EV_EXPANDED && ev2.items[i].h == d.handle(IDS.det) {
+            sawExp = true;
+        }
     }
     ok(sawSel && sawExp, "selected and expanded changes are events");
     let s2 = Text.new(&mem);
@@ -149,7 +156,9 @@
