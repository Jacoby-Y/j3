--- input
+++ fmt
@@ -1,6 +1,5 @@
 // Arena.reserved / usedTotal span every chunk, and are 0 after destroy.
 //   timeout 60 j3c run j3c/stdlib/tests/arena_size_test.j3
-
 module arena_size_test;
 
 use j3.io.printLn;
@@ -9,13 +8,21 @@
 
 fn main() {
     let a = Arena.create(1024);
-    if a.reserved() != 1024 || a.usedTotal() != 0 { panic("fresh arena"); }
+    if a.reserved() != 1024 || a.usedTotal() != 0 {
+        panic("fresh arena");
+    }
     a.allocBytes(800);
-    a.allocBytes(800);   // grows to 2048
-    a.allocBytes(1600);  // grows to 4096
-    if a.reserved() != 1024 + 2048 + 4096 { panic("reserved is the sum of the chunks"); }
-    if a.usedTotal() < 3200 { panic("usedTotal covers every allocation"); }
+    a.allocBytes(800); // grows to 2048
+    a.allocBytes(1600); // grows to 4096
+    if a.reserved() != 1024 + 2048 + 4096 {
+        panic("reserved is the sum of the chunks");
+    }
+    if a.usedTotal() < 3200 {
+        panic("usedTotal covers every allocation");
+    }
     a.destroy();
-    if a.reserved() != 0 || a.usedTotal() != 0 { panic("zero after destroy"); }
+    if a.reserved() != 0 || a.usedTotal() != 0 {
+        panic("zero after destroy");
+    }
     printLn("arena_size_test: ok");
 }
--- stderr
--- exit 0
