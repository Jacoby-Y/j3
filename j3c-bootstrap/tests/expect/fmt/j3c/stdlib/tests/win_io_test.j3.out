 // Windows paths through j3.io: `\` separators, a drive prefix, and Linux-numbered open flags.
 // Built for x86_64-pc-windows-gnu and run under wine by `windows_io_runs_under_wine`.
-
 use j3.io;
 use j3.io.IoError;
 use j3.io.path;
@@ -13,13 +12,42 @@
 use j3.sys.panic;
 use j3.result.Result;
 
-fn mk(p: string): bool { match io.makeDirs(p) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }
-fn wr(p: string): bool { match io.writeFile(p, "hi" as []u8) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }
+fn mk(p: string): bool {
+    match io.makeDirs(p) {
+        Result.Ok(_) {
+            return true;
+        }
+        Result.Err(_) {
+            return false;
+        }
+    }
+}
+fn wr(p: string): bool {
+    match io.writeFile(p, "hi" as []u8) {
+        Result.Ok(_) {
+            return true;
+        }
+        Result.Err(_) {
+            return false;
+        }
+    }
+}
 
-fn isOk(r: Result<bool, IoError>): bool { match r { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }
+fn isOk(r: Result<bool, IoError>): bool {
+    match r {
+        Result.Ok(_) {
+            return true;
+        }
+        Result.Err(_) {
+            return false;
+        }
+    }
+}
 
 fn ok(c: bool, what: string) {
-    if !c { panic(what); }
+    if !c {
+        panic(what);
+    }
 }
 
 fn main() {
