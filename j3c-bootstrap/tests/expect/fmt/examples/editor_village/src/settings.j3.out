+    if same(name, "medium") {
+        medium(s);
+    }
+    if same(name, "high") {
+        high(s);
+    }
+    if same(name, "ultra") {
+        ultra(s);
+    }
+    if same(name, "traced") {
+        s.tracedShadows = true;
+    }
 }
 
