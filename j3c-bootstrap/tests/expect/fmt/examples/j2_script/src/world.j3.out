 // Key 1..9 for weapon slot 0..8.
 fn weaponKey(i: int): Key {
     match i {
-        0 { return Key.Num1; }
-        1 { return Key.Num2; }
-        2 { return Key.Num3; }
-        3 { return Key.Num4; }
-        4 { return Key.Num5; }
-        5 { return Key.Num6; }
-        6 { return Key.Num7; }
-        7 { return Key.Num8; }
-        _ { return Key.Num9; }
+        0 {
+            return Key.Num1;
+        }
+        1 {
+            return Key.Num2;
+        }
+        2 {
+            return Key.Num3;
+        }
+        3 {
+            return Key.Num4;
+        }
+        4 {
+            return Key.Num5;
+        }
+        5 {
+            return Key.Num6;
+        }
+        6 {
+            return Key.Num7;
+        }
+        7 {
+            return Key.Num8;
+        }
+        _ {
+            return Key.Num9;
+        }
     }
