(file (module merged_names)
  (use j3.io.printLn)
  (use merged_names.gen (names Holder twice))
  (use merged_names.box)
  (const n _ 40)
  (const scale _ 10)
  (fn boot (params (a int)) int (block
    (return (+ a 1000))))
  (fn inc (params (a int)) int (block
    (return (+ a 1))))
  (fn main (params) int (block
    (let h _ (struct-lit Holder (targs int) (field x 1)))
    (expr (call printLn (interp (call (. h run)) " " (call twice (targs int) 5 inc) " " (call (. box get)))))
