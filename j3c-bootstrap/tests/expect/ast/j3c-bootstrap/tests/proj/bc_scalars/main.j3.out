(file (module bc_scalars)
  (use j3.io.printLn)
  (const Widths _ (script-type "scripts/widths.j3s"))
  (fn main (params) _ (block
    (let w _ (struct-lit Widths (field seed 7)))
    (expr (call (. w ints)))
    (expr (call (. w floats)))
    (expr (call (. w logic) (bool true)))
    (expr (call (. w shapes)))
    (expr (call printLn (interp "sum " (call (. w sum) 250)))))))
--- stderr
--- exit 0
