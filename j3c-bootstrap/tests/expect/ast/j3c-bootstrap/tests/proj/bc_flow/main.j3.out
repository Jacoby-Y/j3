(file (module bc_flow)
  (use j3.io.printLn)
  (const Grid _ (script-type "scripts/grid.j3s"))
  (const Walker _ (script-type "scripts/walker.j3s"))
  (fn main (params) _ (block
    (let g _ (struct-lit Grid (field w 5) (field h 4)))
    (let a _ (struct-lit Walker (field grid (& g)) (field name "a")))
    (let b _ (struct-lit Walker (field grid (& g)) (field name "b") (field stride 3)))
    (for i (.. 0 6) (block
      (expr (call (. a step) i))
      (expr (call (. b step) (* i 2)))))
    (expr (call (. a report)))
    (expr (call (. b report)))
    (expr (call printLn (interp "scan " (call (. g scan) 3) " kind " (call (. g kind) 0) " " (call (. g kind) 2) " " (call (. g kind) 9)))))))
--- stderr
--- exit 0
