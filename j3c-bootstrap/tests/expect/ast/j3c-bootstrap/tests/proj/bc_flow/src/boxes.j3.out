(file (doc "Native code the scripts call: a generic struct (its methods are instantiated for the script) and a plain fn.") (module boxes)
  (struct pub Box (tparams T)
    (field value T)
    (field hits int 0)
    (fn get (params (this (ref (gen Box T)))) T (block
      (+= (. this hits) 1)
      (return (. this value)))))
  (fn pub wrap (params (v int)) (gen Box int) (block
    (return (struct-lit Box (targs int) (field value v)))))
  (fn pub clampTo (params (v int) (hi int)) int (block
    (if (> v hi) (block
      (return hi)))
    (return v))))
