(file (module tool_pkg echo)
  (use j3.io (names printLn readFile))
  (use j3.sys)
  (use j3.memory.Arena)
  (use j3.data.json)
  (use tool_pkg.words.label)
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 65536))
    (let args _ "")
    (for i (.. 1 (call (. sys argCount))) (block
      (= args (interp args " " (call (. sys arg) i)))))
    (expr (call printLn (interp (call label) ":" args)))
    (expr (call printLn (interp "root " (call (. sys env) "J3_PROJECT_ROOT"))))
    (expr (call printLn (interp "api " (call (. sys env) "J3_TOOL_API"))))
    (match (call readFile (call (. sys env) "J3_MANIFEST") (& a))
      (arm (pats (variant Result.Ok (bind bytes))) (block) (tail (match (call (. json parseStr) (as bytes string) (& a))
        (arm (pats (variant Result.Ok (bind j))) (block
          (expr (call printLn (interp "greeting " (call (. (call (. j path) "tool_pkg.greeting") asStr)))))))
        (arm (pats (variant Result.Err (bind e))) (block
          (expr (call printLn (interp "bad json: " (. e msg)))))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn "no manifest")))))
    (expr (call (. sys exit) 3)))))
--- stderr
--- exit 0
