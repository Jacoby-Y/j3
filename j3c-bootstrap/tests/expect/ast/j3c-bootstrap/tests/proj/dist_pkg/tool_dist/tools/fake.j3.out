(file (module tool_dist fake)
  (use j3.io (names printLn writeFile makeDirs))
  (use j3.sys)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 65536))
    (let t _ (call (. Text new) (& a)))
    (let dist _ "")
    (for i (.. 1 (call (. sys argCount))) (block
      (if (&& (> i 1) (== (call (. sys arg) (- i 1)) "--dist")) (block
        (= dist (call (. sys arg) i))))
      (expr (call (. t pushStr) (call (. sys arg) i)))
      (expr (call (. t push) (char 10)))))
    (let dir _ (call (. (call (. (call (. (call (. Text new) (& a)) add) dist) add) "/fake") str)))
    (match (call makeDirs dir)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn "mkdir failed"))
        (expr (call (. sys exit) 1)))))
    (match (call writeFile (call (. (call (. (call (. (call (. Text new) (& a)) add) dir) add) "/args.txt") str)) (. t bytes))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn "write failed"))
        (expr (call (. sys exit) 1)))))
    (expr (call printLn "fake: wrote args"))
    (expr (call printLn dir)))))
--- stderr
--- exit 0
