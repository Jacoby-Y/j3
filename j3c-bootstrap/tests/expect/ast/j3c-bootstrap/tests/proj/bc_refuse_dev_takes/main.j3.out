(file (module bc_refuse_dev_takes)
  (use j3.io.printLn)
  (const Thing _ (script-type "scripts/thing.j3s"))
  (const Other _ (script-type "scripts/other.j3s"))
  (fn main (params) _ (block
    (let a _ (struct-lit Other (field k 1)))
    (let t _ (struct-lit Thing (field n 2) (field other (& a))))
    (expr (call printLn (interp (call (. t go))))))))
--- stderr
--- exit 0
