(file (module bc_refuse_dev_ret)
  (use j3.io.printLn)
  (const Grid _ (script-type "scripts/grid.j3s"))
  (const Walker _ (script-type "scripts/walker.j3s"))
  (fn main (params) _ (block
    (let g _ (struct-lit Grid (field w 2)))
    (let a _ (struct-lit Walker (field grid (& g))))
    (let h _ (call (. a home)))
    (expr (call printLn (interp (call (. h width))))))))
--- stderr
--- exit 0
