(file (module term_pty_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.proc.ProcError)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.term.Color)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.grid.Grid)
  (use j3.term.pty)
  (use j3.term.pty.Pty)
  (use j3.text.Text)
  (use j3.text.contains)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn start (params (argv (slice string)) (env (slice string)) (cols int) (rows int) (a (ref Arena))) Pty (block
    (match (call (. pty spawn) argv "" env cols rows a)
      (arm (pats (variant Result.Ok (bind p))) (block
        (return p)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic (interp "could not spawn " (index argv 0)))))))
    (return (struct-lit Pty (field fd (- 1)) (field pid (- 1)) (field pend (call (. Text new) a))))))
  (fn (doc "Read into `out` until `needle` shows up (when not empty) or the program closes its side; false on the deadline.") readUntil (params (p (ref Pty)) (out (ref Text)) (needle string) (buf (slice u8))) bool (block
    (for i (.. 0 100) (block
      (let pfd (array 2 i32) (array-lit (call i32 (. p fd)) (call i32 (. sys POLLIN))))
      (expr (call (. sys pollFds) (as (& (index pfd 0)) ptr) 1 50))
      (expr (call (. out pushStr) (call (. p tryRead) buf)))
      (if (&& (> (. needle len) 0) (call contains (call (. out str)) needle)) (block
        (return (bool true))))
      (if (. p eof) (block
        (return (== (. needle len) 0))))))
    (return (bool false))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 4194304))
    (let buf _ (call (. a alloc) (targs u8) 4096))
    (let none (array 1 string) (array-lit ""))
    (let argv (array 3 string) (array-lit "sh" "-c" "stty size; printf '\\033[31mhi\\033[0m\\n'; tty"))
    (let p _ (call start (slice-expr argv _ _) (slice-expr none 0 0) 40 10 (& a)))
    (let out _ (call (. Text new) (& a)))
    (expr (call ok (call readUntil (& p) (& out) "" buf) "reads to the end"))
    (expr (call ok (== (call (. p wait)) 0) "exit code 0"))
    (let g _ (call (. Grid new) (& a) 40 10 100))
    (let parser _ (call (. Parser new) (& a)))
    (expr (call (. parser feed) (call (. out str)) (& g)))
    (let dump _ (call (. g dumpText) (& a)))
    (expr (call ok (call contains dump "10 40") "stty size sees 10 40"))
    (expr (call ok (call contains dump "/dev/pts/") "tty names a pts"))
    (let found _ (bool false))
    (for y (.. 0 10) (block
      (for x (.. 0 39) (block
        (if (&& (== (. (call (. g cell) x y) cp) 104) (== (. (call (. g cell) (+ x 1) y) cp) 105)) (block
          (= found (bool true))
          (expr (call ok (== (. (. (call (. g cell) x y) style) fg) (call (. Color palette) 1)) "hi is red"))))))))
    (expr (call ok found "hi is on the grid"))
    (expr (call ok (. p eof) "eof flagged"))
    (let argv2 (array 3 string) (array-lit "sh" "-c" "stty size; read x; stty size"))
    (let p2 _ (call start (slice-expr argv2 _ _) (slice-expr none 0 0) 80 24 (& a)))
    (let out2 _ (call (. Text new) (& a)))
    (expr (call ok (call readUntil (& p2) (& out2) "24 80" buf) "first size"))
    (expr (call ok (call (. p2 resize) 50 20) "resize"))
    (expr (call ok (call (. p2 write) (as "\n" (slice u8))) "write"))
    (expr (call ok (call readUntil (& p2) (& out2) "20 50" buf) "second size is 20 50"))
    (expr (call ok (call readUntil (& p2) (& out2) "" buf) "resize program ends"))
    (expr (call ok (== (call (. p2 wait)) 0) "resize program exit"))
    (let bad (array 1 string) (array-lit "no-such-program-j3"))
    (match (call (. pty spawn) (slice-expr bad _ _) "" (slice-expr none 0 0) 80 24 (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "missing program started"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant ProcError.NotFound)) (block))
        (arm (pats (variant ProcError.ExecFailed)) (block
          (expr (call panic "wrong error"))))
        (arm (pats (variant ProcError.Fail)) (block
          (expr (call panic "wrong error"))))))))
    (let argv3 (array 3 string) (array-lit "sh" "-c" "echo $TERM $FOO"))
    (let env3 (array 2 string) (array-lit "FOO=bar" "TERM=dumb"))
    (let p3 _ (call start (slice-expr argv3 _ _) (slice-expr env3 _ _) 80 24 (& a)))
    (let out3 _ (call (. Text new) (& a)))
    (expr (call ok (call readUntil (& p3) (& out3) "" buf) "env read"))
    (expr (call ok (call contains (call (. out3 str)) "dumb bar") "env override wins"))
    (expr (call (. p3 wait)))
    (let argv4 (array 3 string) (array-lit "sh" "-c" "echo $TERM $FOO"))
    (let env4 (array 1 string) (array-lit "FOO=bar"))
    (let p4 _ (call start (slice-expr argv4 _ _) (slice-expr env4 _ _) 80 24 (& a)))
    (let out4 _ (call (. Text new) (& a)))
    (expr (call ok (call readUntil (& p4) (& out4) "" buf) "env read 2"))
    (expr (call ok (call contains (call (. out4 str)) "xterm-256color bar") "TERM default and FOO"))
    (expr (call (. p4 wait)))
    (let argv5 (array 3 string) (array-lit "sh" "-c" "cat >/dev/null"))
    (let p5 _ (call start (slice-expr argv5 _ _) (slice-expr none 0 0) 80 24 (& a)))
    (let big _ (call (. a alloc) (targs u8) 204800))
    (for i (.. 0 (. big len)) (block
      (= (index big i) (if-expr (== (% i 64) 63) 10 97))))
    (expr (call ok (call (. p5 write) big) "big write queued"))
    (for i (.. 0 100) (block
      (if (== (call (. p5 pending)) 0) (block
        (break)))
      (let pfd (array 2 i32) (array-lit (call i32 (. p5 fd)) (call i32 (. sys POLLOUT))))
      (expr (call (. sys pollFds) (as (& (index pfd 0)) ptr) 1 50))
      (expr (call (. p5 tryRead) buf))))
    (expr (call ok (== (call (. p5 pending)) 0) "pending drained"))
    (expr (call ok (!= (call (. p5 wait)) 12345) "close and reap"))
    (expr (call ok (! (call (. p5 write) (as "x" (slice u8)))) "write after close is refused"))
    (expr (call printLn "term_pty_test ok")))))
--- stderr
--- exit 0
