(file (module json_test)
  (use j3.data.json)
  (use j3.data.json (names Json Kind))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn (doc "Parse `src`, write it back, and compare with `want`.") round (params (src string) (want string) (a (ref Arena))) _ (block
    (match (call (. json parseStr) src a)
      (arm (pats (variant Result.Ok (bind j))) (block
        (let got _ (call (. json stringify) j a))
        (if (! (call eq got want)) (block
          (expr (call printLn (interp "got  " got)))
          (expr (call printLn (interp "want " want)))))
        (expr (call ok (call eq got want) src))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (interp src ": " (. e msg) " at " (. e at))))
        (expr (call ok (bool false) src)))))))
  (fn bad (params (src string) (a (ref Arena))) _ (block
    (match (call (. json parseStr) src a)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) (interp "accepted bad input " src)))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool true) src)))))))
  (fn parsed (params (src string) (a (ref Arena))) (ref Json) (block
    (match (call (. json parseStr) src a)
      (arm (pats (variant Result.Ok (bind j))) (block
        (return j)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (interp src ": " (. e msg) " at " (. e at))))
        (expr (call panic "parse")))))
    (return (call (. json null) a))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 1048576))
    (expr (call round "null" "null" (& a)))
    (expr (call round " true " "true" (& a)))
    (expr (call round "[]" "[]" (& a)))
    (expr (call round "{}" "{}" (& a)))
    (expr (call round "[1, 2.5, -3, 0.1, 1e3, 1.5E-3, 123456789012]" "[1,2.5,-3,0.1,1000,0.0015,123456789012]" (& a)))
    (expr (call round "{\"a\":{\"b\":[true,false,null]},\"c\":\"d\"}" "{\"a\":{\"b\":[true,false,null]},\"c\":\"d\"}" (& a)))
    (expr (call round "\"tab\\there \\\"q\\\" back\\\\ slash\\/\"" "\"tab\\there \\\"q\\\" back\\\\ slash/\"" (& a)))
    (expr (call round "\"\\u0001\\u001f\"" "\"\\u0001\\u001f\"" (& a)))
    (expr (call round "\"\\u00e9\\u4e2d\\ud83d\\ude00\"" "\"\xc3\xa9\xe4\xb8\xad\xf0\x9f\x98\x80\"" (& a)))
    (expr (call round "\"\\ud800x\"" "\"\xef\xbf\xbdx\"" (& a)))
    (expr (call round "1e308" "1e+308" (& a)))
    (expr (call round "-0" "0" (& a)))
    (expr (call round "{\"k\":1,\"k\":2}" "{\"k\":2}" (& a)))
    (expr (call bad "" (& a)))
    (expr (call bad "[1,]" (& a)))
    (expr (call bad "{\"a\":1,}" (& a)))
    (expr (call bad "01" (& a)))
    (expr (call bad "1." (& a)))
    (expr (call bad ".5" (& a)))
    (expr (call bad "+1" (& a)))
    (expr (call bad "\"\\x\"" (& a)))
    (expr (call bad "\"a\nb\"" (& a)))
    (expr (call bad "[1 2]" (& a)))
    (expr (call bad "{a:1}" (& a)))
    (expr (call bad "tru" (& a)))
    (expr (call bad "1 2" (& a)))
    (expr (call bad "\"open" (& a)))
    (let deep _ (call (. Text new) (& a)))
    (for i (.. 0 600) (block
      (expr (call (. deep push) 91))))
    (for i (.. 0 600) (block
      (expr (call (. deep push) 93))))
    (expr (call bad (call (. deep str)) (& a)))
    (let doc _ (call parsed "{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"n\":42,\"ok\":true}" (& a)))
    (expr (call ok (call eq (call (. (call (. doc path) "choices.0.message.content") asStr)) "hi") "path"))
    (expr (call ok (call (. (call (. doc path) "choices.5.message") isNull)) "path past the end"))
    (expr (call ok (call (. (call (. doc path) "nope.deeper") isNull)) "missing path"))
    (expr (call ok (== (call (. (call (. doc get) "n") asInt)) 42) "asInt"))
    (expr (call ok (call (. (call (. doc get) "ok") asBool)) "asBool"))
    (expr (call ok (call eq (call (. (call (. doc get) "n") asStr)) "") "wrong kind gives empty"))
    (expr (call ok (== (call (. (call (. doc get) "choices") len)) 1) "len"))
    (expr (call ok (&& (call (. doc has) "n") (! (call (. doc has) "m"))) "has"))
    (expr (call ok (== (. (call (. doc get) "choices") kind) (. Kind Arr)) "kind"))
    (let msg _ (call (. json obj) (& a)))
    (expr (call (. msg set) "role" (call (. json str) "user" (& a))))
    (expr (call (. msg set) "content" (call (. json str) "line\none \"q\"" (& a))))
    (let list _ (call (. json arr) (& a)))
    (expr (call (. list push) msg))
    (expr (call (. list push) (call (. json num) (float 0x3fd0000000000000) (& a))))
    (expr (call (. list push) (call (. json boolean) (bool false) (& a))))
    (expr (call (. list push) (call (. json null) (& a))))
    (let body _ (call (. json obj) (& a)))
    (expr (call (. body set) "messages" list))
    (expr (call (. body set) "max" (call (. json num) (float 0x4059000000000000) (& a))))
    (expr (call (. body set) "max" (call (. json num) (float 0x4069000000000000) (& a))))
    (expr (call ok (call eq (call (. json stringify) body (& a)) "{\"messages\":[{\"role\":\"user\",\"content\":\"line\\none \\\"q\\\"\"},0.25,false,null],\"max\":200}") "build"))
    (let nums (array 4 f64) (array-lit (float 0x3fb999999999999a) (/ (float 0x3ff0000000000000) (float 0x4008000000000000)) (float 0x405edd2f1a9fbe77) (- (float 0x4004000000000000))))
    (for i (.. 0 4) (block
      (let t _ (call (. Text new) (& a)))
      (expr (call (. json writeNum) (index nums i) (& t)))
      (expr (call ok (== (call (. (call parsed (call (. t str)) (& a)) asNum)) (index nums i)) (interp "number " i " round trips")))))
    (let big _ (float 0x3ff0000000000000))
    (for i (.. 0 300) (block
      (= big (* big (float 0x4024000000000000)))))
    (let tiny _ (float 0x3ff0000000000000))
    (for i (.. 0 1074) (block
      (= tiny (/ tiny (float 0x4000000000000000)))))
    (let fs (array 7 f64) (array-lit (float 0x3fb999999999999a) (/ (float 0x3ff0000000000000) (float 0x4008000000000000)) (float 0x405edd2f1a9fbe77) (- (float 0x4004000000000000)) big (float 0x3e8421f5f40d8376) tiny))
    (let want (array 7 string) (array-lit "0.1" "0.3333333333333333" "123.456" "-2.5" "1.0000000000000002e+300" "1.5e-07" "5e-324"))
    (for i (.. 0 7) (block
      (let ft _ (call (. Text new) (& a)))
      (expr (call (. json writeNum) (index fs i) (& ft)))
      (expr (call ok (call eq (call (. ft str)) (index want i)) (interp "number " i " writes " (index want i))))))
    (let inf _ (float 0x3ff0000000000000))
    (for i (.. 0 400) (block
      (= inf (* inf (float 0x4024000000000000)))))
    (let it _ (call (. Text new) (& a)))
    (expr (call (. json writeNum) inf (& it)))
    (expr (call ok (call eq (call (. it str)) "null") "infinity writes null"))
    (expr (call printLn (interp "json_test: " CHECKS " checks ok"))))))
--- stderr
--- exit 0
