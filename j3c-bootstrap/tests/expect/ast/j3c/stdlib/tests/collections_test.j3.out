(file (module collections_test)
  (use j3.cmp (names sort sortBy))
  (use j3.data.intern.Interner)
  (use j3.data.map.Map)
  (use j3.data.set.Set)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.rand.Rng)
  (use j3.sys.panic)
  (const OPS int 1000000)
  (struct (doc "No `operator==`: a `List` of it compiles because `indexOf` is never called on it.") NoEq
    (field a int))
  (struct Rec
    (field key int)
    (field seq int))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "collections_test"))))))
  (fn (doc "A value in `0..n` from the high bits of the LCG.") roll (params (r (ref Rng)) (n int)) int (block
    (return (% (>> (call (. r next)) 20) n))))
  (fn listBasics (params (mem (ref Arena))) _ (block
    (let xs _ (call (. (type-path List int) new) mem))
    (expr (call (. xs extend) (call (. mem alloc) (targs int) 0)))
    (expr (call ok (== (. xs len) 0) "extend empty"))
    (for i (.. 0 5) (block
      (expr (call (. xs push) i))))
    (expr (call ok (&& (&& (== (call (. xs pop)) 4) (== (. xs len) 4)) (== (call (. xs last)) 3)) "pop last"))
    (expr (call (. xs insert) 0 9))
    (expr (call (. xs insert) 5 8))
    (expr (call (. xs insert) 2 7))
    (expr (call ok (&& (&& (&& (== (. xs len) 7) (== (index (. xs items) 0) 9)) (== (index (. xs items) 2) 7)) (== (index (. xs items) 6) 8)) "insert"))
    (expr (call ok (&& (&& (&& (== (call (. xs indexOf) 7) 2) (== (call (. xs indexOf) 42) (- 1))) (call (. xs contains) 8)) (! (call (. xs contains) 5))) "indexOf contains"))
    (let more _ (call (. mem alloc) (targs int) 3))
    (= (index more 0) 1)
    (= (index more 1) 2)
    (= (index more 2) 3)
    (expr (call (. xs extend) more))
    (expr (call ok (&& (&& (== (. xs len) 10) (== (. (call (. xs slice)) len) 10)) (== (index (call (. xs slice)) 9) 3)) "extend slice"))
    (expr (call (. xs clear)))
    (expr (call ok (== (. xs len) 0) "clear"))
    (let ne _ (call (. (type-path List NoEq) new) mem))
    (expr (call (. ne push) (struct-lit NoEq (field a 1))))
    (expr (call ok (== (. (call (. ne pop)) a) 1) "List of a type without =="))))
  (fn listRandom (params (mem (ref Arena))) _ (block
    (let r _ (call (. Rng new) 11))
    (let xs _ (call (. (type-path List int) new) mem))
    (let ref _ (call (. mem alloc) (targs int) 256))
    (let n _ 0)
    (for _ (.. 0 OPS) (block
      (let op _ (call roll (& r) 10))
      (let v _ (call roll (& r) 50))
      (if (&& (<= op 2) (< n 200)) (block
        (expr (call (. xs push) v))
        (= (index ref n) v)
        (+= n 1)) (block
        (if (&& (== op 3) (> n 0)) (block
          (-= n 1)
          (expr (call ok (== (call (. xs pop)) (index ref n)) "rand pop"))) (block
          (if (&& (== op 4) (< n 200)) (block
            (let at _ (call roll (& r) (+ n 1)))
            (expr (call (. xs insert) at v))
            (let j _ n)
            (while (> j at) (block
              (= (index ref j) (index ref (- j 1)))
              (-= j 1)))
            (= (index ref at) v)
            (+= n 1)) (block
            (if (&& (== op 5) (> n 0)) (block
              (let at _ (call roll (& r) n))
              (expr (call (. xs remove) at))
              (for j (.. at (- n 1)) (block
                (= (index ref j) (index ref (+ j 1)))))
              (-= n 1)) (block
              (if (&& (== op 6) (> n 0)) (block
                (let at _ (call roll (& r) n))
                (expr (call (. xs swapRemove) at))
                (= (index ref at) (index ref (- n 1)))
                (-= n 1)) (block
                (if (== op 7) (block
                  (let want _ (- 1))
                  (for j (.. 0 n) (block
                    (if (== (index ref j) v) (block
                      (= want j)
                      (break)))))
                  (expr (call ok (&& (== (call (. xs indexOf) v) want) (== (call (. xs contains) v) (>= want 0))) "rand indexOf"))) (block
                  (if (&& (== op 8) (> n 0)) (block
                    (expr (call ok (== (call (. xs last)) (index ref (- n 1))) "rand last"))) (block
                    (if (&& (== op 9) (== (call roll (& r) 1000) 0)) (block
                      (expr (call (. xs clear)))
                      (= n 0)))))))))))))))))
      (expr (call ok (== (. xs len) n) "rand len"))))
    (for j (.. 0 n) (block
      (expr (call ok (== (index (. xs items) j) (index ref j)) "rand final contents"))))))
  (fn sortTests (params (mem (ref Arena))) _ (block
    (let r _ (call (. Rng new) 5))
    (let recs _ (call (. mem alloc) (targs Rec) 5000))
    (let ints _ (call (. mem alloc) (targs int) 5000))
    (let total _ 0)
    (let round _ 0)
    (while (< total OPS) (block
      (let n _ (if-expr (< round 40) round (call roll (& r) 5000)))
      (+= round 1)
      (+= total (+ n 1))
      (let sum _ 0)
      (for i (.. 0 n) (block
        (= (index recs i) (struct-lit Rec (field key (call roll (& r) 20)) (field seq i)))
        (= (index ints i) (- (call roll (& r) 100000) 50000))
        (+= sum (index ints i))))
      (let rs _ (slice-expr recs 0 n))
      (expr (call sortBy rs (fn-lit (params (a Rec) (b Rec)) bool (block
        (return (< (. a key) (. b key)))))))
      (let is _ (slice-expr ints 0 n))
      (expr (call sort is))
      (let seen _ 0)
      (for i (.. 0 n) (block
        (+= seen (index is i))
        (if (> i 0) (block
          (expr (call ok (<= (index is (- i 1)) (index is i)) "sort order"))
          (expr (call ok (<= (. (index rs (- i 1)) key) (. (index rs i) key)) "sortBy order"))
          (if (== (. (index rs (- i 1)) key) (. (index rs i) key)) (block
            (expr (call ok (< (. (index rs (- i 1)) seq) (. (index rs i) seq)) "sortBy stable"))))))))
      (expr (call ok (== seen sum) "sort keeps the elements"))))))
  (fn mapBasics (params (mem (ref Arena))) _ (block
    (let m _ (call (. (type-path Map string int) new) mem 4))
    (expr (call (. m put) "a" 1))
    (let pa _ (call (. m getPtr) "a"))
    (+= (* pa) 10)
    (let pb _ (call (. m getOrPut) "b" 5))
    (+= (* pb) 1)
    (let pc _ (call (. m getOrPut) "a" 0))
    (+= (* pc) 1)
    (expr (call ok (&& (== (call (. m getOr) "a" 0) 12) (== (call (. m getOr) "b" 0) 6)) "getPtr getOrPut"))
    (let sum _ 0)
    (let count _ 0)
    (expr (call (. m each) (fn-lit (params (k string) (v int)) _ (block
      (+= sum v)
      (+= count (. k len))))))
    (expr (call ok (&& (== sum 18) (== count 2)) "each"))
    (let keys _ (call (. m sortedKeys) mem))
    (expr (call ok (&& (&& (== (. keys len) 2) (== (index keys 0) "a")) (== (index keys 1) "b")) "sortedKeys strings"))
    (expr (call (. m free)))
    (expr (call ok (&& (&& (== (. m len) 0) (! (call (. m has) "a"))) (== (. (call (. m sortedKeys) mem) len) 0)) "free empties"))
    (expr (call (. m put) "c" 3))
    (expr (call ok (&& (== (call (. m getOr) "c" 0) 3) (== (. m len) 1)) "put after free"))))
  (const KEYS int 2048)
  (fn mapRandom (params (mem (ref Arena))) _ (block
    (let r _ (call (. Rng new) 7))
    (let m _ (call (. (type-path Map int int) new) mem 0))
    (let s _ (call (. (type-path Set int) new) mem 0))
    (let has _ (call (. mem alloc) (targs bool) KEYS))
    (let val _ (call (. mem alloc) (targs int) KEYS))
    (let inSet _ (call (. mem alloc) (targs bool) KEYS))
    (for i (.. 0 KEYS) (block
      (= (index has i) (bool false))
      (= (index inSet i) (bool false))))
    (let n _ 0)
    (let sn _ 0)
    (for step (.. 0 OPS) (block
      (let k _ (call roll (& r) KEYS))
      (let op _ (call roll (& r) 8))
      (if (<= op 1) (block
        (let v _ (call roll (& r) 1000))
        (expr (call (. m put) k v))
        (if (! (index has k)) (block
          (+= n 1)))
        (= (index has k) (bool true))
        (= (index val k) v)) (block
        (if (== op 2) (block
          (expr (call ok (== (call (. m remove) k) (index has k)) "rand map remove"))
          (if (index has k) (block
            (-= n 1)))
          (= (index has k) (bool false))) (block
          (if (== op 3) (block
            (expr (call ok (&& (== (call (. m has) k) (index has k)) (== (call (. m getOr) k (- 1)) (if-expr (index has k) (index val k) (- 1)))) "rand map get"))) (block
            (if (== op 4) (block
              (let p _ (call (. m getOrPut) k 0))
              (+= (* p) 1)
              (if (! (index has k)) (block
                (+= n 1)
                (= (index has k) (bool true))
                (= (index val k) 0)))
              (+= (index val k) 1)) (block
              (if (== op 5) (block
                (expr (call ok (== (call (. s add) k) (! (index inSet k))) "rand set add"))
                (if (! (index inSet k)) (block
                  (+= sn 1)))
                (= (index inSet k) (bool true))) (block
                (if (== op 6) (block
                  (expr (call ok (== (call (. s remove) k) (index inSet k)) "rand set remove"))
                  (if (index inSet k) (block
                    (-= sn 1)))
                  (= (index inSet k) (bool false))) (block
                  (expr (call ok (== (call (. s has) k) (index inSet k)) "rand set has"))))))))))))))
      (expr (call ok (&& (== (. m len) n) (== (call (. s len)) sn)) "rand len"))
      (if (== (% step 100000) 99999) (block
        (let mark _ (call (. mem checkpoint)))
        (let keys _ (call (. m sortedKeys) mem))
        (let j _ 0)
        (for i (.. 0 KEYS) (block
          (if (index has i) (block
            (expr (call ok (== (index keys j) i) "rand sortedKeys"))
            (+= j 1)))))
        (expr (call ok (== j (. keys len)) "rand sortedKeys len"))
        (let total _ 0)
        (expr (call (. m each) (fn-lit (params (key int) (v int)) _ (block
          (+= total (+ (* key 7) v))))))
        (let want _ 0)
        (for i (.. 0 KEYS) (block
          (if (index has i) (block
            (+= want (+ (* i 7) (index val i)))))))
        (expr (call ok (== total want) "rand each"))
        (let sk _ (call (. s sorted) mem))
        (let c _ 0)
        (for i (.. 0 KEYS) (block
          (if (index inSet i) (block
            (expr (call ok (== (index sk c) i) "rand set sorted"))
            (+= c 1)))))
        (expr (call (. mem rewind) mark))))))))
  (fn internTests (params (mem (ref Arena))) _ (block
    (let it _ (call (. Interner new) mem))
    (expr (call ok (&& (&& (== (call (. it intern) "x") (call u32 0)) (== (call (. it intern) "y") (call u32 1))) (== (call (. it intern) "x") (call u32 0))) "intern ids"))
    (expr (call ok (&& (&& (== (call (. it str) (call u32 1)) "y") (== (call (. it find) "z") (- 1))) (== (call (. it len)) 2)) "intern str find"))
    (let r _ (call (. Rng new) 3))
    (let words _ 5000)
    (let ids _ (call (. mem alloc) (targs int) words))
    (for i (.. 0 words) (block
      (= (index ids i) (- 1))))
    (let next _ 2)
    (for _ (.. 0 OPS) (block
      (let w _ (call roll (& r) words))
      (let s _ (interp "w" w))
      (if (== (call roll (& r) 4) 0) (block
        (expr (call ok (== (call (. it find) s) (index ids w)) "rand intern find"))
        (continue)))
      (let id _ (call int (call (. it intern) s)))
      (if (< (index ids w) 0) (block
        (expr (call ok (== id next) "rand intern new id"))
        (= (index ids w) id)
        (+= next 1)))
      (expr (call ok (&& (== id (index ids w)) (== (call (. it str) (call u32 id)) s)) "rand intern round trip"))))
    (expr (call ok (== (call (. it len)) next) "rand intern len"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (expr (call listBasics (& mem)))
    (expr (call listRandom (& mem)))
    (expr (call sortTests (& mem)))
    (expr (call mapBasics (& mem)))
    (expr (call mapRandom (& mem)))
    (expr (call internTests (& mem)))
    (expr (call printLn "collections_test ok")))))
--- stderr
--- exit 0
