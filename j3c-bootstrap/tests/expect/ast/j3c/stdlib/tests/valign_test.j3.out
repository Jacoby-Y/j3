(file (module valign_test)
  (use j3.game (names fontAscent fontLine loadFont Font))
  (use j3.io.printLn)
  (use j3.math (names max Vec2))
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.inputs)
  (use j3.text.same)
  (use j3.ui.textsel)
  (mod-let CHECKS int _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .narrow { width: 100px; } .sm { font-size: 8px; } .big { font-size: 32px; } .sup { vertical-align: super; } .sub { vertical-align: sub; } .top { vertical-align: top; } .bot { vertical-align: bottom; } .mid { vertical-align: middle; } .tt { vertical-align: text-top; } .tb { vertical-align: text-bottom; } .up5 { vertical-align: 5px; } .dn3 { vertical-align: -3px; } .pct { vertical-align: 50%; } .bad { vertical-align: 5; } .pill { padding: 0 4px; background: #888888; } .kid { font-size: 8px; } .box { user-select: text; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff (float 0x3f947ae147ae147b)) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b)))
      (expr (call panic msg))))))
  (struct Run
    (field h f32)
    (field y3 f32)
    (field shLast f32)
    (field vmLast int)
    (field y0 f32)
    (field y1 f32)
    (field y2 f32)
    (field boxY f32)
    (field c int))
  (fn fragN (params (d (ref Dom)) (owner int) (k int)) Frag (block
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (while (> k 0) (block
      (= f (. (index (. (. d frags) items) f) next))
      (-= k 1)))
    (return (index (. (. d frags) items) f))))
  (fn (doc "The y of the k-th fragment, or -1 when the run has fewer.") fragY (params (d (ref Dom)) (owner int) (k int)) f32 (block
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (while (&& (> k 0) (>= f 0)) (block
      (= f (. (index (. (. d frags) items) f) next))
      (-= k 1)))
    (if (< f 0) (block
      (let none f32 (float 0x0000000000000000))
      (return (- none (float 0x3ff0000000000000)))))
    (return (. (index (. (. d frags) items) f) y))))
  (fn (doc "`class=\"a b\"` as one or two `d.cls` calls (it takes one name).") addCls (params (d (ref Dom)) (id int) (cls string)) _ (block
    (let sp _ 0)
    (while (&& (< sp (. cls len)) (!= (index cls sp) 32)) (block
      (+= sp 1)))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) id (slice-expr cls 0 sp)))))
    (if (< sp (. cls len)) (block
      (expr (call (. d cls) id (slice-expr cls (+ sp 1) (. cls len))))))))
  (fn (doc "One frame of `ab <span class=cls>text</span> cd` in a block of class `outer`; a non-empty `inner` makes the span\n`x<span class=inner>y</span>` instead. `user-select: text` is on the block.") frameOn (params (d (ref Dom)) (outer string) (cls string) (inner string) (text string)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call addCls d c outer))
    (expr (call (. d text) "ab "))
    (let s _ (call (. d open) 0 (call (. d tag) "span") 1))
    (expr (call addCls d s cls))
    (if (> (. inner len) 0) (block
      (expr (call (. d text) "x"))
      (let k _ (call (. d open) 0 (call (. d tag) "span") 1))
      (expr (call addCls d k inner))
      (expr (call (. d text) "y"))
      (expr (call (. d close)))) (block
      (expr (call (. d text) text))))
    (expr (call (. d close)))
    (expr (call (. d text) " cd"))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return c)))
  (fn build (params (mem (ref Arena)) (css (ref Css)) (outer string) (cls string) (inner string) (text string)) Run (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let c _ (call frameOn (& d) outer cls inner text))
    (= c (call frameOn (& d) outer cls inner text))
    (let tl _ (& (index (. (. d frags) items) (. (index (. (. d nodes) items) c) fragTail))))
    (let r _ (struct-lit Run (field h (. (index (. (. d nodes) items) c) h)) (field y0 (call fragY (& d) c 0)) (field y1 (call fragY (& d) c 1)) (field y2 (call fragY (& d) c 2)) (field y3 (call fragY (& d) c 3)) (field boxY (float 0x0000000000000000)) (field shLast (. tl sh)) (field vmLast (. tl vm)) (field c c)))
    (if (>= (. (index (. (. d nodes) items) c) box0) 0) (block
      (= (. r boxY) (. (index (. (. d boxes) items) (. (index (. (. d nodes) items) c) box0)) y))))
    (return r)))
  (fn (doc "Double-click the point and return the selected text.") dblClick (params (d (ref Dom)) (outer string) (cls string) (x f32) (y f32)) string (block
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frameOn d outer cls "" "Rare"))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frameOn d outer cls "" "Rare"))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frameOn d outer cls "" "Rare"))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frameOn d outer cls "" "Rare"))
    (return (call (. textsel selected) d))))
  (fn (doc "Hover and word selection at the middle of the shifted span's text land on the span's text, not on the unshifted spot.") testPick (params (mem (ref Arena)) (css (ref Css)) (cls string) (hover bool)) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let c _ (call frameOn (& d) "box" cls "" "Rare"))
    (= c (call frameOn (& d) "box" cls "" "Rare"))
    (let f _ (call fragN (& d) c 1))
    (let x _ (+ (+ (call (. d absX) c) (. f x)) (/ (. f w) (float 0x4000000000000000))))
    (let y _ (+ (+ (call (. d absY) c) (. f y)) (float 0x4010000000000000)))
    (if hover (block
      (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
      (expr (call frameOn (& d) "box" cls "" "Rare"))
      (expr (call frameOn (& d) "box" cls "" "Rare"))
      (expr (call ok (== (. d hover) (. (index (. (. d nodes) items) (. f node)) parent)) "a decorated shifted span is hovered at its text"))))
    (expr (call ok (call same (call dblClick (& d) "box" cls x y) "Rare") "a double click on the shifted text selects its word"))
    (expr (call (. textsel clear) (& d)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (let f16 _ (call loadFont (. (index (. (. css fonts) items) 0) path) 16))
    (let f8 _ (call loadFont (. (index (. (. css fonts) items) 0) path) 8))
    (let lh _ (call f32 (call fontLine f16)))
    (let asc _ (call f32 (call fontAscent f16)))
    (let sz f32 (float 0x4030000000000000))
    (let r _ (+ (/ sz (float 0x4008000000000000)) (float 0x3ff0000000000000)))
    (let sb _ (+ (/ sz (float 0x4014000000000000)) (float 0x3ff0000000000000)))
    (let half f32 (* lh (float 0x3fe0000000000000)))
    (let qtr _ (* sz (float 0x3fd0000000000000)))
    (let base _ (call build (& mem) (& css) "box" "" "" "Rare"))
    (expr (call near (. base h) lh "one plain line is the font's line height"))
    (expr (call near (. base y1) (. base y0) "baseline: the span sits on the line's baseline"))
    (let bad _ (call build (& mem) (& css) "box" "bad" "" "Rare"))
    (expr (call near (- (. bad y1) (. bad y0)) (float 0x0000000000000000) "a unitless length is dropped"))
    (let sup _ (call build (& mem) (& css) "box" "sup" "" "Rare"))
    (expr (call near (- (. sup y0) (. sup y1)) r "super raises by size/3 + 1"))
    (expr (call near (. sup h) (+ lh r) "super grows the line by the raise"))
    (expr (call near (. sup y2) (. sup y0) "text after the span is back on the baseline"))
    (let sub _ (call build (& mem) (& css) "box" "sub" "" "Rare"))
    (expr (call near (- (. sub y1) (. sub y0)) sb "sub lowers by size/5 + 1"))
    (expr (call near (. sub h) (+ lh sb) "sub grows the line below"))
    (let up _ (call build (& mem) (& css) "box" "up5" "" "Rare"))
    (expr (call near (- (. up y0) (. up y1)) (float 0x4014000000000000) "5px raises 5px"))
    (expr (call near (. up h) (+ lh (float 0x4014000000000000)) "5px grows the line"))
    (let dn _ (call build (& mem) (& css) "box" "dn3" "" "Rare"))
    (expr (call near (- (. dn y1) (. dn y0)) (float 0x4008000000000000) "-3px lowers 3px"))
    (expr (call near (. dn h) (+ lh (float 0x4008000000000000)) "-3px grows the line"))
    (let pct _ (call build (& mem) (& css) "box" "pct" "" "Rare"))
    (expr (call near (- (. pct y0) (. pct y1)) half "50% is half the line-height"))
    (expr (call near (. pct h) (+ lh half) "50% grows the line"))
    (let sm _ (call build (& mem) (& css) "box" "sm" "" "Rare"))
    (expr (call near (. sm h) lh "a smaller span does not change the line"))
    (expr (call near (+ (. sm y1) (call f32 (call fontAscent f8))) (+ (. sm y0) asc) "the small span shares the baseline"))
    (let ssup _ (call build (& mem) (& css) "box" "sm sup" "" "Rare"))
    (let a8 _ (call f32 (call fontAscent f8)))
    (let d8 _ (- (call f32 (call fontLine f8)) a8))
    (let wantA _ (call max asc (+ a8 r)))
    (let wantD _ (call max (- lh asc) (- d8 r)))
    (expr (call near (. ssup h) (+ wantA wantD) "small super: line is the larger of the strut and the raised text"))
    (expr (call near (- (+ (. ssup y0) asc) (+ (. ssup y1) a8)) r "small super: the text baseline is raised from the line's"))
    (let mid _ (call build (& mem) (& css) "box" "sm mid" "" "Rare"))
    (let midRaise _ (- qtr (/ (- a8 d8) (float 0x4000000000000000))))
    (expr (call near (- (+ (. mid y0) asc) (+ (. mid y1) a8)) midRaise "middle raises the small text to the midline"))
    (let tt _ (call build (& mem) (& css) "box" "sm tt" "" "Rare"))
    (expr (call near (- (+ (. tt y0) asc) (+ (. tt y1) a8)) (- asc a8) "text-top: the small text's top at the parent's ascent line"))
    (let tb _ (call build (& mem) (& css) "box" "sm tb" "" "Rare"))
    (expr (call near (- (+ (. tb y1) a8) (+ (. tb y0) asc)) (- (- lh asc) d8) "text-bottom: the small text's bottom at the parent's descent line"))
    (let top _ (call build (& mem) (& css) "box" "sm top" "" "Rare"))
    (expr (call near (. top h) lh "top: a small box does not grow the line"))
    (expr (call near (. top y1) (. top y0) "top: placed at the top edge of the line"))
    (let bot _ (call build (& mem) (& css) "box" "sm bot" "" "Rare"))
    (expr (call near (. bot h) lh "bottom: a small box does not grow the line"))
    (expr (call near (+ (. bot y1) (call f32 (call fontLine f8))) (+ (. top y0) lh) "bottom: its bottom on the line's bottom"))
    (let f32f _ (call loadFont (. (index (. (. css fonts) items) 0) path) 32))
    (let tallH _ (call f32 (call fontLine f32f)))
    (let bigTop _ (call build (& mem) (& css) "box" "big top" "" "Rare"))
    (expr (call near (. bigTop h) tallH "top: a taller box sets the line height"))
    (expr (call near (. bigTop y1) (. bigTop y0) "top: the taller box and the baseline text share the top edge"))
    (let bigBot _ (call build (& mem) (& css) "box" "big bot" "" "Rare"))
    (expr (call near (. bigBot h) tallH "bottom: a taller box sets the line height"))
    (expr (call near (- (. bigBot y0) (. bigBot y1)) (- (- tallH (- lh asc)) asc) "bottom: the baseline text is pushed down by the growth above it"))
    (let wrap _ (call build (& mem) (& css) "narrow" "sup" "" "alpha beta gamma delta"))
    (let plainWrap _ (call build (& mem) (& css) "narrow" "" "" "alpha beta gamma delta"))
    (let lines _ (/ (. plainWrap h) lh))
    (expr (call ok (> lines (float 0x4004000000000000)) "wrapped: more than two lines"))
    (expr (call near (. wrap h) (+ (. plainWrap h) (* lines r)) "wrapped: each line of the span grows by the raise"))
    (expr (call near (. wrap y0) (+ (. plainWrap y0) r) "wrapped: the first line's plain text moves down by the raise"))
    (let pill _ (call build (& mem) (& css) "box" "pill sup" "" "Rare"))
    (let pill0 _ (call build (& mem) (& css) "box" "pill" "" "Rare"))
    (expr (call near (. pill boxY) (+ (. pill0 boxY) (float 0x0000000000000000)) "the pill box moves with the raise (line grows by the raise, box up by it)"))
    (expr (call near (- (. pill y1) (. pill boxY)) (- (. pill0 y1) (. pill0 boxY)) "the box keeps its place around the text"))
    (let g _ (call build (& mem) (& css) "box" "top" "kid" ""))
    (expr (call near (. g y1) (. g y0) "top group: the 16px part sits at the line top"))
    (expr (call near (+ (. g y2) a8) (+ (. g y1) asc) "top group: the nested small text shares the group's baseline"))
    (expr (call near (. g y3) (. g y0) "text after a top group is on the baseline"))
    (expr (call near (. g h) lh "top group: a group no taller than the line leaves it alone"))
    (let gb _ (call build (& mem) (& css) "box" "big top" "kid" ""))
    (expr (call near (+ (. gb y2) a8) (+ (. gb y1) (call f32 (call fontAscent f32f))) "big top group: the small part shares the big part's baseline"))
    (expr (call near (. gb h) tallH "big top group: the line is the group's height"))
    (let gbot _ (call build (& mem) (& css) "box" "big bot" "kid" ""))
    (expr (call near (+ (. gbot y2) a8) (+ (. gbot y1) (call f32 (call fontAscent f32f))) "big bottom group: one baseline too"))
    (expr (call near (. gbot y3) (. gbot y0) "text after a bottom group is on the baseline"))
    (let ss _ (call build (& mem) (& css) "box" "sup" "sup" ""))
    (expr (call near (- (. ss y0) (. ss y1)) r "super: the outer text is raised once"))
    (expr (call near (- (. ss y0) (. ss y2)) (+ r r) "super in super: the raise accumulates"))
    (expr (call near (. ss h) (+ (+ lh r) r) "super in super: the line grows by both"))
    (expr (call near (. ss y3) (. ss y0) "text after nested supers is back on the baseline"))
    (expr (call ok (&& (== (. ss shLast) (float 0x0000000000000000)) (== (. ss vmLast) 0)) "no shift leaks to the last fragment"))
    (let ts _ (call build (& mem) (& css) "box" "top" "sub" ""))
    (expr (call near (. ts y1) (. ts y0) "sub in top: the top text sits at the line top"))
    (expr (call near (- (. ts y2) (. ts y1)) sb "sub in top: lowered from the group's baseline"))
    (expr (call near (. ts h) (+ lh sb) "sub in top: the group grows the line by the lowering"))
    (expr (call near (. ts y3) (. ts y0) "sub in top: text after it is back on the baseline (the line grew downward)"))
    (expr (call ok (&& (== (. ts shLast) (float 0x0000000000000000)) (== (. ts vmLast) 0)) "no top mode leaks past the closing tag"))
    (let wsup _ (call build (& mem) (& css) "narrow" "sup" "" "alpha beta gamma delta"))
    (expr (call ok (&& (== (. wsup shLast) (float 0x0000000000000000)) (== (. wsup vmLast) 0)) "a span that wraps leaves nothing behind for the text after it"))
    (let wtop _ (call build (& mem) (& css) "narrow" "top" "" "alpha beta gamma delta"))
    (expr (call near (. wtop h) (. plainWrap h) "a top span that wraps keeps every line's height"))
    (expr (call ok (== (. wtop vmLast) 0) "no top mode after a wrapped top span"))
    (expr (call testPick (& mem) (& css) "pill sup" (bool true)))
    (expr (call testPick (& mem) (& css) "sub" (bool false)))
    (expr (call testPick (& mem) (& css) "sm top" (bool false)))
    (expr (call testPick (& mem) (& css) "pill bot" (bool true)))
    (expr (call printLn (interp "valign_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
