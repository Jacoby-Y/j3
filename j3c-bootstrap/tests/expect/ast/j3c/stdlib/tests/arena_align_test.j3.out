(file (module arena_align_test)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.memory.Arena)
  (use j3.thread.Mutex)
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 64))
    (let odd _ (call (. a alloc) (targs u8) 1))
    (let m _ (call (. a alloc) (targs Mutex) 1))
    (if (!= (% (as (. m ptr) int) 8) 0) (block
      (expr (call panic "Mutex slot not 8-aligned"))))
    (expr (call (. a allocBytes) 3))
    (let p _ (call (. a allocBytes) 100))
    (if (!= (% (as p int) 8) 0) (block
      (expr (call panic "allocBytes not 8-aligned"))))
    (= (index odd 0) 1)
    (expr (call printLn "arena_align_test ok")))))
--- stderr
--- exit 0
