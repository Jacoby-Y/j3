(file (module radio_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains same Text))
  (use j3.ui.a11y)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, label, button, span { font-family: \"T\"; font-size: 16px; } label { display: block; } .sc { display: block; height: 40px; overflow-y: auto; } .sp { display: block; height: 200px; }")
  (mod-let CHECKS int _)
  (mod-let G1 string _)
  (mod-let G2 string _)
  (mod-let N int _)
  (mod-let SHOW_D bool _)
  (mod-let FORCE_A bool _)
  (mod-let ZN bool _)
  (mod-let Z (array 2 bool) _)
  (mod-let CHG (array 20 int) _)
  (mod-let WB (array 20 int) _)
  (mod-let ID (array 20 int) _)
  (mod-let AR int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "A radio the way `bind:group` generates it: the checked one writes its value, the variable checks it.") sradio (params (d (ref Dom)) (k int) (name string) (val string) (off bool) (g bool)) _ (block
    (let c _ (call (. d open) k (call (. d tag) "input") 1))
    (expr (call (. d attrType) c "radio"))
    (expr (call (. d attrName) c name))
    (if off (block
      (expr (call (. d attrDisabled) c (bool true)))))
    (= (index ID k) c)
    (if (call (. d changed) c) (block
      (+= (index CHG k) 1)
      (if g (block
        (= G1 val)) (block
        (= G2 val)))))
    (expr (call (. d attrGroup) c (call (. d textIs) (if-expr g G1 G2) val)))
    (expr (call (. d close)))))
  (fn iradio (params (d (ref Dom)) (k int) (v int)) _ (block
    (let c _ (call (. d open) k (call (. d tag) "input") 1))
    (expr (call (. d attrType) c "radio"))
    (expr (call (. d attrName) c "n"))
    (= (index ID k) c)
    (if (call (. d changed) c) (block
      (+= (index CHG k) 1)
      (= N v)))
    (expr (call (. d attrGroup) c (== N v)))
    (expr (call (. d close)))))
  (fn zradio (params (d (ref Dom)) (k int) (z int)) _ (block
    (let c _ (call (. d open) k (call (. d tag) "input") 1))
    (expr (call (. d attrType) c "radio"))
    (expr (call (. d attrName) c (if-expr (&& (== k 10) ZN) "z2" "z")))
    (= (index ID k) c)
    (if (call (. d userToggled) c) (block
      (= (index Z z) (call (. d isChecked) c))
      (+= (index WB k) 1)))
    (expr (call (. d attrRadio) c (index Z z)))
    (expr (call (. d close)))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let pre _ (call (. d open) 11 (call (. d tag) "button") 1))
    (= (index ID 11) pre)
    (expr (call (. d text) "Pre"))
    (expr (call (. d close)))
    (let ga _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d attrRole) ga "radiogroup"))
    (expr (call (. d open) 0 (call (. d tag) "label") 1))
    (expr (call sradio d 0 "g" "a" (bool false) (bool true)))
    (expr (call (. d text) "One"))
    (expr (call (. d close)))
    (expr (call sradio d 1 "g" "b" (bool false) (bool true)))
    (expr (call (. d attrId) (index ID 1) "rb"))
    (let l2 _ (call (. d open) 1 (call (. d tag) "label") 1))
    (expr (call (. d attrFor) l2 "rb"))
    (expr (call (. d text) "Two"))
    (expr (call (. d close)))
    (expr (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call sradio d 2 "g" "c" (bool true) (bool true)))
    (expr (call (. d close)))
    (if SHOW_D (block
      (expr (call (. d open) 3 (call (. d tag) "div") 1))
      (expr (call sradio d 3 "g" "d" (bool false) (bool true)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (if FORCE_A (block
      (= G1 "a")))
    (let gb _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d attrRole) gb "radiogroup"))
    (expr (call (. d open) 4 (call (. d tag) "div") 1))
    (expr (call sradio d 4 "g" "x" (bool false) (bool false)))
    (expr (call (. d close)))
    (expr (call (. d open) 5 (call (. d tag) "div") 1))
    (expr (call sradio d 5 "g" "y" (bool false) (bool false)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d open) 2 (call (. d tag) "div") 1))
    (for k (.. 0 3) (block
      (expr (call (. d open) (+ 6 k) (call (. d tag) "div") 1))
      (expr (call iradio d (+ 6 k) (+ k 1)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d open) 3 (call (. d tag) "div") 1))
    (expr (call zradio d 9 0))
    (expr (call zradio d 10 1))
    (expr (call (. d close)))
    (let post _ (call (. d open) 12 (call (. d tag) "button") 1))
    (= (index ID 12) post)
    (expr (call (. d text) "Post"))
    (expr (call (. d close)))
    (let fg _ (call (. d open) 4 (call (. d tag) "div") 1))
    (expr (call (. d attrNav) fg 0 "arrows"))
    (= (index ID 13) (call (. d open) 0 (call (. d tag) "button") 1))
    (expr (call (. d text) "AB"))
    (expr (call (. d close)))
    (let sc _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) sc "sc"))
    (= (index ID 17) sc)
    (expr (call (. d attrRole) sc "radiogroup"))
    (for k (.. 0 2) (block
      (let c _ (call (. d open) k (call (. d tag) "input") 1))
      (expr (call (. d attrType) c "radio"))
      (expr (call (. d attrName) c "ar"))
      (= (index ID (+ 14 k)) c)
      (if (call (. d changed) c) (block
        (= AR k)))
      (expr (call (. d attrGroup) c (== AR k)))
      (expr (call (. d close)))))
    (let sp _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) sp "sp"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (= (index ID 16) (call (. d open) 2 (call (. d tag) "button") 1))
    (expr (call (. d text) "AC"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (for k (.. 0 2) (block
      (let w _ (call (. d open) (+ 5 k) (call (. d tag) "input") 1))
      (expr (call (. d attrType) w "radio"))
      (expr (call (. d attrName) w "w"))
      (= (. (index (. (. d nodes) items) w) gk) (+ k 1))
      (= (index ID (+ 18 k)) w)
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn clickNode (params (d (ref Dom)) (id int)) _ (block
    (for f (.. 0 4) (block
      (expr (call (. testkit click) d f 0 id))
      (expr (call frame d))))))
  (fn clickText (params (d (ref Dom)) (text string)) _ (block
    (for f (.. 0 4) (block
      (expr (call (. testkit clickText) d f 0 text))
      (expr (call frame d))))))
  (fn idle (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn key (params (d (ref Dom)) (names string)) _ (block
    (expr (call (. d simKeys) "" names))
    (expr (call frame d))
    (expr (call frame d))))
  (fn on (params (d (ref Dom)) (k int)) bool (block
    (return (. (index (. (. d nodes) items) (index ID k)) checked))))
  (fn picks (params (d (ref Dom)) (want string)) bool (block
    (for i (.. 0 4) (block
      (if (!= (call on d i) (== (index want i) 49)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "radio.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. a11y enable) (& d)))
    (= G1 "b")
    (= G2 "")
    (= N 2)
    (= AR 0)
    (= SHOW_D (bool true))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (call picks (& d) "0100") "the variable checks its radio"))
    (expr (call ok (&& (&& (call on (& d) 7) (! (call on (& d) 6))) (! (call on (& d) 8))) "an int group checks the one equal to the variable"))
    (expr (call ok (&& (! (call on (& d) 4)) (! (call on (& d) 5))) "a variable that matches nothing checks nothing"))
    (expr (call clickNode (& d) (index ID 0)))
    (expr (call ok (&& (call same G1 "a") (call picks (& d) "1000")) "a click checks it and unchecks the other of its group"))
    (expr (call ok (&& (== (index CHG 0) 1) (== (index CHG 1) 0)) "on:change fires on the newly checked radio only"))
    (expr (call clickNode (& d) (index ID 0)))
    (expr (call ok (== (index CHG 0) 1) "a click on the checked radio is no change"))
    (expr (call ok (== (. d focus) (index ID 0)) "a click focuses the radio"))
    (expr (call clickText (& d) "Two"))
    (expr (call ok (&& (&& (call same G1 "b") (call picks (& d) "0100")) (== (index CHG 1) 1)) "a label with for= checks its radio"))
    (expr (call clickText (& d) "One"))
    (expr (call ok (&& (&& (call same G1 "a") (call picks (& d) "1000")) (== (index CHG 0) 2)) "a wrapping label checks its radio"))
    (expr (call clickNode (& d) (index ID 2)))
    (expr (call ok (&& (&& (call same G1 "a") (call picks (& d) "1000")) (== (index CHG 2) 0)) "a disabled radio can not be checked"))
    (expr (call ok (&& (&& (! (call on (& d) 4)) (! (call on (& d) 5))) (== (. G2 len) 0)) "the same name in another scope is untouched"))
    (expr (call clickNode (& d) (index ID 4)))
    (expr (call ok (&& (&& (call same G2 "x") (call on (& d) 4)) (call picks (& d) "1000")) "scope B checks its own radio, scope A keeps its choice"))
    (expr (call clickNode (& d) (index ID 5)))
    (expr (call ok (&& (&& (&& (call same G2 "y") (! (call on (& d) 4))) (call on (& d) 5)) (call picks (& d) "1000")) "and exclusivity holds inside scope B"))
    (expr (call clickNode (& d) (index ID 8)))
    (expr (call ok (&& (&& (== N 3) (call on (& d) 8)) (! (call on (& d) 7))) "bind:group with ints writes the int"))
    (= G1 "d")
    (= N 1)
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (&& (&& (call picks (& d) "0001") (call on (& d) 6)) (! (call on (& d) 8))) "setting the variable checks the radio and unchecks the rest"))
    (expr (call ok (== (index CHG 3) 0) "a program change is no on:change"))
    (expr (call clickNode (& d) (index ID 9)))
    (expr (call ok (&& (&& (index Z 0) (! (index Z 1))) (call on (& d) 9)) "bind:checked sets its variable"))
    (expr (call clickNode (& d) (index ID 10)))
    (expr (call ok (&& (&& (! (index Z 0)) (index Z 1)) (== (index WB 9) 2)) "bind:checked on the radio that lost the check sees it too"))
    (expr (call (. d focusNode) (index ID 0)))
    (expr (call (. d setKeyboard) (bool true)))
    (= G1 "a")
    (expr (call idle (& d)))
    (expr (call ok (call picks (& d) "1000") "start of the key tests"))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (&& (== (. d focus) (index ID 1)) (call same G1 "b")) (call picks (& d) "0100")) "Down moves focus and the check to the next"))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (&& (== (. d focus) (index ID 3)) (call same G1 "d")) (call picks (& d) "0001")) "Down skips the disabled radio"))
    (expr (call key (& d) "Right"))
    (expr (call ok (&& (== (. d focus) (index ID 0)) (call same G1 "a")) "Right wraps to the first"))
    (expr (call key (& d) "Up"))
    (expr (call ok (&& (== (. d focus) (index ID 3)) (call same G1 "d")) "Up wraps to the last"))
    (expr (call key (& d) "Left"))
    (expr (call ok (&& (== (. d focus) (index ID 1)) (call same G1 "b")) "Left goes back, skipping the disabled radio"))
    (expr (call ok (>= (index CHG 1) 2) "arrow checks fire on:change"))
    (expr (call (. d focusNode) (index ID 0)))
    (expr (call ok (! (call on (& d) 0)) "focus alone checks nothing"))
    (expr (call key (& d) "Space"))
    (expr (call ok (&& (call on (& d) 0) (call same G1 "a")) "Space checks the focused radio"))
    (expr (call key (& d) "Down"))
    (expr (call key (& d) "Up"))
    (expr (call ok (&& (== (. d focus) (index ID 0)) (call on (& d) 0)) "arrows come back"))
    (expr (call (. d focusNode) (index ID 9)))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (&& (== (. d focus) (index ID 10)) (index Z 1)) (! (index Z 0))) "Down in a pair moves to the other"))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (== (. d focus) (index ID 9)) (index Z 0)) "and wraps back"))
    (expr (call ok (&& (&& (call (. dom tabbable) (& d) (index ID 0)) (! (call (. dom tabbable) (& d) (index ID 1)))) (! (call (. dom tabbable) (& d) (index ID 3)))) "the checked radio is the group's tab stop"))
    (expr (call ok (call (. dom padReach) (& d) (index ID 1)) "the pad can still reach the other radios"))
    (expr (call (. d focusNode) (index ID 11)))
    (let seq _ (call (. Text new) (& mem)))
    (for i (.. 0 12) (block
      (expr (call key (& d) "Tab"))
      (expr (call (. seq pushInt) (. d focus)))
      (expr (call (. seq push) 32))))
    (let want _ (call (. Text new) (& mem)))
    (let order _ (array-lit (index ID 0) (index ID 5) (index ID 6) (index ID 9) (index ID 12) (index ID 13) (index ID 14) (index ID 16) (index ID 18) (index ID 11) (index ID 0) (index ID 5)))
    (for i (.. 0 12) (block
      (expr (call (. want pushInt) (index order i)))
      (expr (call (. want push) 32))))
    (expr (call ok (call same (call (. seq str)) (call (. want str))) (interp "Tab visits one radio per group: " (call (. seq str)) " vs " (call (. want str)))))
    (expr (call (. d focusNode) (index ID 12)))
    (let back _ (array-lit (index ID 9) (index ID 6) (index ID 5) (index ID 0) (index ID 11)))
    (for i (.. 0 5) (block
      (expr (call key (& d) "S+Tab"))
      (expr (call ok (== (. d focus) (index back i)) "Shift+Tab visits one radio per group"))))
    (expr (call clickNode (& d) (index ID 18)))
    (expr (call clickNode (& d) (index ID 19)))
    (expr (call clickNode (& d) (index ID 18)))
    (let ws _ 0)
    (for i (.. 0 (. (. css warns) len)) (block
      (if (call contains (. (index (. (. css warns) items) i) msg) "radio group \"w\" spans several") (block
        (+= ws 1)))))
    (expr (call ok (&& (&& (== ws 1) (call on (& d) 18)) (! (call on (& d) 19))) "radios of one name in different keyed rows warn once"))
    (expr (call (. d focusNode) (index ID 14)))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (== (. d focus) (index ID 15)) (== AR 1)) "a radio group takes the arrow inside a focus-group with arrows"))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (== (. d focus) (index ID 14)) (== AR 0)) "and wraps instead of leaving the group"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) (index ID 17)) scrollY) (float 0x0000000000000000)) (> (. (index (. (. d nodes) items) (index ID 17)) scrollMax) (float 0x0000000000000000))) "the arrow keys do not scroll the box around the radios"))
    (expr (call (. d focusNode) (index ID 13)))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (!= (. d focus) (index ID 13)) (>= (. d focus) 0)) "outside the radios the focus-group arrows still move focus"))
    (= G2 "")
    (expr (call idle (& d)))
    (expr (call ok (&& (! (call on (& d) 4)) (! (call on (& d) 5))) "variable cleared"))
    (expr (call ok (&& (call (. dom tabbable) (& d) (index ID 4)) (! (call (. dom tabbable) (& d) (index ID 5)))) "with none checked the first radio is the stop"))
    (= G1 "c")
    (expr (call idle (& d)))
    (expr (call ok (&& (&& (call on (& d) 2) (call (. dom tabbable) (& d) (index ID 0))) (! (call (. dom tabbable) (& d) (index ID 3)))) "a checked but disabled radio leaves the first enabled one as the stop"))
    (= G1 "zzz")
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (call picks (& d) "0000") "a variable no radio has unchecks them all"))
    (= G1 "b")
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (call picks (& d) "0100") "back to b"))
    (= FORCE_A (bool true))
    (= G1 "a")
    (expr (call idle (& d)))
    (expr (call clickNode (& d) (index ID 3)))
    (expr (call idle (& d)))
    (= FORCE_A (bool false))
    (expr (call ok (&& (call same G1 "a") (call picks (& d) "1000")) "the program writing the old value again wins over the user's pick"))
    (expr (call clickNode (& d) (index ID 10)))
    (expr (call ok (&& (&& (index Z 1) (call on (& d) 10)) (! (call on (& d) 9))) "start of the rename test"))
    (= ZN (bool true))
    (expr (call idle (& d)))
    (expr (call clickNode (& d) (index ID 9)))
    (expr (call ok (&& (call on (& d) 9) (call on (& d) 10)) "a radio renamed to z2 is exclusive with its new group only"))
    (= ZN (bool false))
    (expr (call idle (& d)))
    (expr (call ok (&& (! (call on (& d) 9)) (call on (& d) 10)) "renamed back into a group with a checked radio: the renamed one keeps the check"))
    (= G1 "d")
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (&& (&& (call on (& d) 3) (call (. dom tabbable) (& d) (index ID 3))) (! (call (. dom tabbable) (& d) (index ID 0)))) "d is checked and the stop"))
    (expr (call (. a11y events) (& d) (& mem)))
    (= SHOW_D (bool false))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (&& (&& (&& (== (call on (& d) 0) (bool false)) (== (call on (& d) 1) (bool false))) (call (. dom tabbable) (& d) (index ID 0))) (! (call (. dom tabbable) (& d) (index ID 1)))) "the checked radio is gone: the first enabled one is the stop"))
    (let gone _ (call (. a11y events) (& d) (& mem)))
    (for i (.. 0 (. gone len)) (block
      (if (== (. (index (. gone items) i) kind) (. a11y EV_CHECKED)) (block
        (expr (call ok (call (. d alive) (. (index (. gone items) i) h)) "no checked event for a removed radio"))))))
    (= SHOW_D (bool true))
    (= G1 "b")
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (= G1 "b")
    (expr (call idle (& d)))
    (let tx _ (call (. Text new) (& mem)))
    (expr (call (. a11y dump) (& d) (& mem) (& tx)))
    (let s _ (call (. tx str)))
    (expr (call ok (&& (call contains s "radio \"One\" checked=false group=\"g\"") (call contains s "radio \"Two\" checked=true group=\"g\"")) "the a11y tree has role, checked, group and the label name"))
    (expr (call (. a11y events) (& d) (& mem)))
    (expr (call clickNode (& d) (index ID 0)))
    (let ev _ (call (. a11y events) (& d) (& mem)))
    (let a0 _ (bool false))
    (let b0 _ (bool false))
    (for i (.. 0 (. ev len)) (block
      (if (&& (== (. (index (. ev items) i) kind) (. a11y EV_CHECKED)) (== (. (index (. ev items) i) h) (call (. d handle) (index ID 0)))) (block
        (= a0 (bool true))))
      (if (&& (== (. (index (. ev items) i) kind) (. a11y EV_CHECKED)) (== (. (index (. ev items) i) h) (call (. d handle) (index ID 1)))) (block
        (= b0 (bool true))))))
    (expr (call ok (&& a0 b0) "checked events for the radio that got checked and the one that lost it"))
    (expr (call ok (call (. a11y perform) (& d) (index ID 1) (. a11y A_CLICK) (float 0x0000000000000000) "") "a screen reader can activate a radio"))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call ok (&& (call on (& d) 1) (call same G1 "b")) "and that checks it"))
    (expr (call (. d focusNode) (index ID 0)))
    (expr (call (. testkit padPress) (& d) 0 0 "A"))
    (expr (call frame (& d)))
    (expr (call (. testkit padPress) (& d) 1 0 "A"))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (call on (& d) 0) (== (. G1 len) 1)) (== (index G1 0) 97)) "the pad's A checks the focused radio"))
    (expr (call printLn (interp "radio_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
