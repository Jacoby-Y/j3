(file (module overflow_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom (names Dom SC_START))
  (use j3.ui.inputs)
  (const SHEET string ".bx { position: absolute; width: 100px; height: 100px; } .big { width: 300px; height: 300px; } .a { left: 0px; top: 0px; overflow: hidden auto; } .b { left: 150px; top: 0px; overflow: auto hidden; } .c { left: 300px; top: 0px; overflow-x: hidden; } .d { left: 0px; top: 400px; overflow-x: clip; overflow-y: visible; } .o { left: 450px; top: 0px; overflow: auto; } .i { width: 100px; height: 100px; overflow: hidden auto; } .e { left: 150px; top: 400px; overflow-x: clip; overflow-y: auto; } .e .t { width: 20px; height: 20px; } .e .sp { height: 250px; } .ng { left: 570px; top: 150px; overflow: auto; } .nx { position: relative; z-index: 1; width: 60px; height: 40px; overflow-x: clip; overflow-y: visible; } .nk { width: 200px; height: 80px; } .yo { left: 570px; top: 300px; overflow-y: auto; overflow-x: hidden; } .sp2 { height: 150px; } .xi { width: 80px; height: 40px; overflow-x: auto; overflow-y: hidden; } .row { display: flex; width: 180px; height: 40px; } .cl { flex-shrink: 0; width: 60px; height: 40px; } .tl { height: 200px; } .rr { position: absolute; left: 300px; top: 560px; width: 100px; height: 40px; box-sizing: border-box; display: flex; overflow-x: auto; border-left: 3px solid #fff; border-right: 5px solid #fff; padding: 0 7px 0 4px; } .rr.rev { left: 450px; flex-direction: row-reverse; } .rr .cl { width: 60px; } .f { position: absolute; left: 300px; top: 400px; width: 150px; height: 60px; display: flex; overflow-x: auto; overflow-y: clip; scroll-snap-type: x mandatory; } .card { flex-shrink: 0; width: 100px; height: 40px; scroll-snap-align: start; }")
  (mod-let CHECKS int _)
  (mod-let ID (array 16 int) _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn box (params (d (ref Dom)) (k int) (cls string)) int (block
    (let b _ (call (. d open) k (call (. d tag) "div") 1))
    (expr (call (. d cls) b "bx"))
    (expr (call (. d cls) b cls))
    (= (index ID k) b)
    (return b)))
  (fn leaf (params (d (ref Dom)) (k int) (cls string)) int (block
    (let c _ (call (. d open) k (call (. d tag) "div") 1))
    (expr (call (. d cls) c cls))
    (expr (call (. d close)))
    (return c)))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4085e00000000000)) (field y (float 0x4085e00000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call box d 0 "a"))
    (= (index ID 8) (call leaf d 0 "big"))
    (expr (call (. d close)))
    (expr (call box d 1 "b"))
    (expr (call leaf d 0 "big"))
    (expr (call (. d close)))
    (expr (call box d 2 "c"))
    (expr (call leaf d 0 "big"))
    (expr (call (. d close)))
    (expr (call box d 3 "d"))
    (= (index ID 9) (call leaf d 0 "big"))
    (expr (call (. d close)))
    (expr (call box d 4 "o"))
    (let i _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) i "i"))
    (= (index ID 5) i)
    (expr (call leaf d 0 "big"))
    (expr (call (. d close)))
    (expr (call leaf d 1 "big"))
    (expr (call (. d close)))
    (expr (call box d 6 "e"))
    (expr (call leaf d 0 "sp"))
    (= (index ID 7) (call leaf d 1 "t"))
    (expr (call leaf d 2 "big"))
    (expr (call (. d close)))
    (let f _ (call (. d open) 7 (call (. d tag) "div") 1))
    (expr (call (. d cls) f "f"))
    (for q (.. 0 3) (block
      (expr (call leaf d q "card"))))
    (expr (call (. d close)))
    (expr (call box d 8 "ng"))
    (let nx _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) nx "nx"))
    (= (index ID 10) (call leaf d 0 "nk"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 11 "yo"))
    (expr (call leaf d 0 "sp2"))
    (let xi _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) xi "xi"))
    (= (index ID 12) xi)
    (let row _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) row "row"))
    (for q (.. 0 3) (block
      (let c _ (call leaf d q "cl"))
      (if (== q 2) (block
        (= (index ID 13) c)))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call leaf d 2 "tl"))
    (expr (call (. d close)))
    (for q (.. 0 2) (block
      (let r _ (call (. d open) (+ 10 q) (call (. d tag) "div") 1))
      (expr (call (. d cls) r "rr"))
      (if (== q 1) (block
        (expr (call (. d cls) r "rev"))))
      (= (index ID (+ 14 q)) r)
      (for k (.. 0 3) (block
        (expr (call leaf d k "cl"))))
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn idle (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d))))))
  (fn wheelAt (params (d (ref Dom)) (x f32) (y f32) (notches f32)) _ (block
    (expr (call (. d simInput) x y (bool false) (- (float 0x0000000000000000) notches)))
    (expr (call frame d))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (let e _ (- a b))
    (if (< e (float 0x0000000000000000)) (block
      (= e (- (float 0x0000000000000000) e))))
    (if (> e (float 0x3fe3333333333333)) (block
      (expr (call printLn (interp msg ": " a " vs " b)))))
    (expr (call ok (<= e (float 0x3fe3333333333333)) msg))))
  (fn sx (params (d (ref Dom)) (id int)) f32 (block
    (return (. (index (. (. d nodes) items) id) scrollX))))
  (fn sy (params (d (ref Dom)) (id int)) f32 (block
    (return (. (index (. (. d nodes) items) id) scrollY))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "overflow.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings (clip is a keyword)"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call idle (& d) 3))
    (let a _ (index ID 0))
    (let b _ (index ID 1))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) a) scrollMax) (float 0x4069000000000000)) (== (. (index (. (. d nodes) items) a) scrollMaxX) (float 0x4069000000000000))) "hidden auto: both axes have a range"))
    (expr (call wheelAt (& d) (float 0x4049000000000000) (float 0x4049000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (&& (> (call sy (& d) a) (float 0x0000000000000000)) (== (call sx (& d) a) (float 0x0000000000000000))) "shorthand order: the wheel scrolls the auto axis (y) of `hidden auto`"))
    (expr (call wheelAt (& d) (float 0x4069000000000000) (float 0x4049000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (&& (> (call sx (& d) b) (float 0x0000000000000000)) (== (call sy (& d) b) (float 0x0000000000000000))) "shorthand order: the wheel scrolls the auto axis (x) of `auto hidden`"))
    (let c _ (index ID 2))
    (expr (call ok (== (. (index (. (. d nodes) items) c) scrollMax) (float 0x4069000000000000)) "overflow-x: hidden makes visible y auto: it has a range"))
    (expr (call wheelAt (& d) (float 0x4075e00000000000) (float 0x4049000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (&& (> (call sy (& d) c) (float 0x0000000000000000)) (== (call sx (& d) c) (float 0x0000000000000000))) "the coerced y axis takes the wheel"))
    (let dd _ (index ID 3))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) dd) scrollMax) (float 0x0000000000000000)) (== (. (index (. (. d nodes) items) dd) scrollMaxX) (float 0x0000000000000000))) "clip and visible: no scroll range"))
    (expr (call (. d simInput) (float 0x4049000000000000) (float 0x4081300000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d hover) (index ID 9)) "below the box on the visible axis, the child is hit"))
    (expr (call (. d simInput) (float 0x4069000000000000) (float 0x407c200000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (!= (. d hover) (index ID 9)) "right of the box on the clipped axis, the child is missed"))
    (expr (call (. d simInput) (float 0x4049000000000000) (float 0x407c200000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d hover) (index ID 9)) "inside the box the child is hit"))
    (let o _ (index ID 4))
    (expr (call (. d simKeys) "" "Shift"))
    (expr (call wheelAt (& d) (float 0x407f400000000000) (float 0x4049000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (&& (== (call sx (& d) (index ID 5)) (float 0x0000000000000000)) (> (call sx (& d) o) (float 0x0000000000000000))) "a sideways wheel passes a y-only scroller to the parent"))
    (expr (call idle (& d) 2))
    (expr (call wheelAt (& d) (float 0x407f400000000000) (float 0x4049000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (&& (> (call sy (& d) (index ID 5)) (float 0x0000000000000000)) (== (call sy (& d) o) (float 0x0000000000000000))) "a plain wheel scrolls the y-only scroller itself"))
    (let e _ (index ID 6))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) e) scrollMaxX) (float 0x4069000000000000)) (> (. (index (. (. d nodes) items) e) scrollMax) (float 0x0000000000000000))) "clip next to auto computes to hidden: x has a range for code"))
    (expr (call (. d scrollIntoView) (index ID 7) SC_START (bool false)))
    (expr (call idle (& d) 2))
    (expr (call ok (&& (> (call sy (& d) e) (float 0x0000000000000000)) (== (call sx (& d) e) (float 0x0000000000000000))) "scrollIntoView moves y, and x stays when the target is in view"))
    (let f _ (- 1))
    (for q (.. 0 (. (. d nodes) len)) (block
      (if (&& (== (. (index (. (. d nodes) items) q) scrollMaxX) (float 0x4062c00000000000)) (== (. (index (. (. d nodes) items) q) h) (float 0x404e000000000000))) (block
        (= f q)))))
    (expr (call ok (&& (>= f 0) (== (. (index (. (. d nodes) items) f) scrollMax) (float 0x0000000000000000))) "x-only snap box found, no y range"))
    (expr (call wheelAt (& d) (float 0x4075e00000000000) (float 0x407a400000000000) (float 0x4000000000000000)))
    (expr (call idle (& d) 20))
    (expr (call ok (&& (== (call sx (& d) f) (float 0x4059000000000000)) (== (call sy (& d) f) (float 0x0000000000000000))) "snap settles on the x axis"))
    (expr (call (. d simInput) (float 0x4082700000000000) (float 0x406a400000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d hover) (index ID 10)) "stacking-context chain: a child past the box on the visible axis is hit"))
    (expr (call (. d simInput) (float 0x4084500000000000) (float 0x4064000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (!= (. d hover) (index ID 10)) "stacking-context chain: a child past the box on the clipped axis is missed"))
    (let yo _ (index ID 11))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) (index ID 12)) scrollMaxX) (float 0x4059000000000000)) (== (. (index (. (. d nodes) items) (index ID 12)) scrollMax) (float 0x0000000000000000))) "inner x range 100, no y range"))
    (expr (call (. d scrollIntoView) (index ID 13) SC_START (bool false)))
    (expr (call idle (& d) 2))
    (expr (call ok (&& (> (call sx (& d) (index ID 12)) (float 0x0000000000000000)) (== (call sy (& d) (index ID 12)) (float 0x0000000000000000))) "intoView scrolls the inner x-only box on x"))
    (expr (call ok (&& (> (call sy (& d) yo) (float 0x0000000000000000)) (== (call sx (& d) yo) (float 0x0000000000000000))) "intoView scrolls the outer y-only box on y"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 14)) scrollMaxX) (float 0x4058c00000000000) "row: padding on both sides, borders not content"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 15)) scrollMaxX) (float 0x0000000000000000) "row-reverse overflows to the start: no range"))
    (let used _ (. (. d mem) used))
    (let laid _ (. d laid))
    (expr (call idle (& d) 30))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (! (call (. d isLive)))) "idle frames allocate and lay out nothing"))
    (expr (call printLn (interp "overflow_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
