(file (module bubble_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let IDS (array 3 int) _)
  (const SHEET string ".a { width: 200px; height: 200px; } .b { width: 100px; height: 100px; } .c { width: 50px; height: 50px; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "outer `.a` > middle `.b` > inner `.c`; `stop` is the middle box's `|stop` bits.") frame (params (d (ref Dom)) (stop int)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let a _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) a "a"))
    (let b _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) b "b"))
    (if (!= stop 0) (block
      (expr (call (. d attrFlag) b stop))))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) c "c"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (= (index IDS 0) a)
    (= (index IDS 1) b)
    (= (index IDS 2) c)
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 8 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0))
    (expr (call frame (& d) 0))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d) 0))
    (expr (call ok (&& (&& (call (. d mouseDown) (index IDS 2)) (call (. d mouseDown) (index IDS 1))) (call (. d mouseDown) (index IDS 0))) "a press on the inner box reaches every ancestor"))
    (expr (call ok (== (. d downBtn) 0) "left button"))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0))
    (expr (call ok (&& (call (. d mouseUp) (index IDS 2)) (call (. d mouseUp) (index IDS 0))) "release bubbles"))
    (expr (call ok (! (call (. d mouseDown) (index IDS 0))) "the press is one frame"))
    (expr (call (. d simInput) (float 0x4054000000000000) (float 0x4054000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d) 0))
    (expr (call ok (&& (&& (! (call (. d mouseDown) (index IDS 2))) (call (. d mouseDown) (index IDS 1))) (call (. d mouseDown) (index IDS 0))) "only the hit node and its ancestors"))
    (expr (call (. d simInput) (float 0x4054000000000000) (float 0x4054000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (| (| 8 16) 32)))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d) (| (| 8 16) 32)))
    (expr (call ok (&& (&& (call (. d mouseDown) (index IDS 2)) (call (. d mouseDown) (index IDS 1))) (! (call (. d mouseDown) (index IDS 0)))) "mousedown|stop ends the walk at the middle box"))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (| (| 8 16) 32)))
    (expr (call ok (&& (call (. d mouseUp) (index IDS 1)) (! (call (. d mouseUp) (index IDS 0)))) "mouseup|stop"))
    (expr (call (. d simRight) (bool true)))
    (expr (call frame (& d) (| (| 8 16) 32)))
    (expr (call ok (&& (&& (call (. d contextAt) (index IDS 2)) (call (. d contextAt) (index IDS 1))) (! (call (. d contextAt) (index IDS 0)))) "contextmenu|stop"))
    (expr (call ok (&& (call (. d mouseDown) (index IDS 1)) (== (. d downBtn) 2)) "a right press bubbles with button 2"))
    (expr (call printLn "bubble_test ok")))))
--- stderr
--- exit 0
