(file (module context_test)
  (use j3.memory.Arena)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.math.Vec2)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let OPEN bool _)
  (mod-let CARD bool _)
  (mod-let OWNER int _)
  (mod-let MENU int _)
  (mod-let ITEM (array 5 int) _)
  (mod-let NESTED int _)
  (mod-let FIELD int _)
  (mod-let SIBSELECT int _)
  (mod-let SELECT int _)
  (mod-let HOVER int _)
  (mod-let BOX int _)
  (mod-let BUTTON int _)
  (mod-let SHOW bool _)
  (mod-let MODAL bool _)
  (mod-let CLICKS int _)
  (mod-let REQUESTS int _)
  (mod-let CHECKS int _)
  (fn ok (params (b bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! b) (block
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4072c00000000000)))))
    (expr (call (. inputs begin) d))
    (let page _ (call (. d open) 0 (call (. d tag) "div") 1))
    (= OWNER (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) OWNER "owner"))
    (expr (call (. d attrTabIndex) OWNER))
    (if (call (. d contextAt) OWNER) (block
      (= OPEN (bool true))
      (+= REQUESTS 1)))
    (if (call (. d clicked) OWNER) (block
      (+= CLICKS 1)))
    (if OPEN (block
      (= MENU (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) MENU "menu"))
      (expr (call (. d attrContext) MENU))
      (if (call (. d closeRequested) MENU) (block
        (= OPEN (bool false))))
      (for i (.. 0 5) (block
        (= (index ITEM i) (call (. d open) i (call (. d tag) "button") 1))
        (if (== i 0) (block
          (expr (call (. d text) "Apple"))) (block
          (if (== i 1) (block
            (expr (call (. d text) "Apricot"))) (block
            (if (== i 2) (block
              (expr (call (. d text) "Banana"))
              (expr (call (. d attrDisabled) (index ITEM i) (bool true)))) (block
              (if (== i 3) (block
                (expr (call (. d text) "Blueberry"))) (block
                (expr (call (. d text) "\xc3\x89clair"))))))))))
        (expr (call (. d close)))))
      (let hidden _ (call (. d open) 6 (call (. d tag) "button") 1))
      (expr (call (. d cls) hidden "hidden"))
      (expr (call (. d text) "Blackberry"))
      (expr (call (. d close)))
      (let sub _ (call (. d open) 7 (call (. d tag) "div") 1))
      (expr (call (. d cls) sub "sub"))
      (= NESTED (call (. d open) 0 (call (. d tag) "button") 1))
      (expr (call (. d text) "Blackberry"))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (= FIELD (call (. d open) 8 (call (. d tag) "input") 1))
      (expr (call (. d attrType) FIELD "text"))
      (expr (call (. d close)))
      (= SELECT (call (. d open) 9 (call (. d tag) "select") 1))
      (let opt _ (call (. d open) 0 (call (. d tag) "option") 1))
      (expr (call (. d text) "One"))
      (expr (call (. d close)))
      (let opt2 _ (call (. d open) 1 (call (. d tag) "option") 1))
      (expr (call (. d text) "Two"))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (if OPEN (block
      (= SIBSELECT (call (. d open) 1 (call (. d tag) "select") 1))
      (let siblingOpt _ (call (. d open) 0 (call (. d tag) "option") 1))
      (expr (call (. d text) "Blue choice"))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (if SHOW (block
      (= HOVER (call (. d open) 1 (call (. d tag) "div") 1))
      (expr (call (. d cls) HOVER "owner"))
      (expr (call (. d cls) HOVER "hover"))
      (expr (call (. d attrTitle) HOVER "ordinary title"))
      (= CARD (call (. d hoverCard) HOVER))
      (if CARD (block
        (= BOX (call (. d open) 0 (call (. d tag) "div") 1))
        (expr (call (. d cls) BOX "card"))
        (expr (call (. d attrOverlay) BOX (. dom OV_POPOVER)))
        (expr (call (. d text) "Custom content"))
        (= BUTTON (call (. d open) 0 (call (. d tag) "button") 1))
        (expr (call (. d text) "Focusable"))
        (expr (call (. d close)))
        (expr (call (. d close)))))
      (expr (call (. d close)))))
    (if MODAL (block
      (let modal _ (call (. d open) 2 (call (. d tag) "dialog") 1))
      (expr (call (. d attrOverlay) modal (. dom OV_MODAL)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn step (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call frame d))))))
  (fn key (params (d (ref Dom)) (text string) (names string)) _ (block
    (expr (call (. d simKeys) text names))
    (expr (call frame d))
    (expr (call frame d))))
  (fn mountFrameAt (params (d (ref Dom)) (show bool) (request bool) (w f32) (h f32)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x w) (field y h))))
    (expr (call (. inputs begin) d))
    (let page _ (call (. d open) 0 (call (. d tag) "div") 1))
    (let menu _ (- 1))
    (if show (block
      (let owner _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) owner "owner"))
      (if request (block
        (= (. d ctxNode) owner)
        (= (. d ctxX) (float 0x4077c00000000000))
        (= (. d ctxY) (float 0x4071800000000000))))
      (= menu (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) menu "menu"))
      (expr (call (. d attrContext) menu))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return menu)))
  (fn mountFrame (params (d (ref Dom)) (show bool) (request bool)) int (block
    (return (call mountFrameAt d show request (float 0x4079000000000000) (float 0x4072c00000000000)))))
  (fn testInitialAnchor (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; } .menu { width: 120px; height: 150px; }" "mount.css" 1))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let menu _ (call mountFrame (& d) (bool true) (bool false)))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) menu) atx) (float 0x4072c00000000000)) (== (. (index (. (. d nodes) items) menu) aty) (float 0x4072200000000000))) "first-render fallback uses laid-out owner geometry"))
    (expr (call ok (&& (== (call (. d absX) menu) (float 0x4071800000000000)) (== (call (. d absY) menu) (float 0x4062c00000000000))) "first-render fallback clamps in same layout"))
    (expr (call mountFrameAt (& d) (bool true) (bool false) (float 0x4074000000000000) (float 0x406e000000000000)))
    (expr (call ok (&& (&& (== (. (index (. (. d nodes) items) menu) atx) (float 0x4072c00000000000)) (== (call (. d absX) menu) (float 0x4069000000000000))) (== (call (. d absY) menu) (float 0x4056800000000000))) "resize preserves captured anchor and reclamps popup"))
    (expr (call mountFrame (& d) (bool false) (bool false)))
    (let mounted _ (call mountFrame (& d) (bool true) (bool false)))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) mounted) atx) (float 0x4072c00000000000)) (== (. (index (. (. d nodes) items) mounted) aty) (float 0x4072200000000000))) "new conditional owner resolves fallback on mount"))
    (expr (call mountFrame (& d) (bool false) (bool false)))
    (let pointed _ (call mountFrame (& d) (bool true) (bool true)))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) pointed) atx) (float 0x4077c00000000000)) (== (. (index (. (. d nodes) items) pointed) aty) (float 0x4071800000000000))) "current request wins over fallback on first layout"))
    (expr (call mountFrame (& d) (bool true) (bool false)))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) pointed) atx) (float 0x4077c00000000000)) (! (. (index (. (. d nodes) items) pointed) ctxPending))) "later frames cannot reapply fallback over captured request"))
    (expr (call mountFrame (& d) (bool false) (bool false)))
    (expr (call ok (== (. (. d ovs) len) 0) "anchored owner removal drops overlay"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call testInitialAnchor (& mem)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) ".owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; } .hover { left: 20px; top: 20px; } .menu { width: 120px; height: 150px; } .card { left: 20px; top: 76px; width: 180px; height: 90px; } .hidden { display: none; } button { display: block; width: 100px; height: 24px; }" "context.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (= SHOW (bool true))
    (expr (call (. d simInput) (float 0x4077c00000000000) (float 0x4071800000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d focusNode) OWNER))
    (expr (call (. d simRight) (bool true)))
    (expr (call step (& d) 3))
    (expr (call (. d simRight) (bool false)))
    (expr (call frame (& d)))
    (expr (call ok (&& (== REQUESTS 1) OPEN) "right click dispatches request once"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) MENU) atx) (float 0x4077c00000000000)) (== (. (index (. (. d nodes) items) MENU) aty) (float 0x4071800000000000))) "anchor captures pointer"))
    (expr (call ok (&& (== (call (. d absX) MENU) (float 0x4071800000000000)) (== (call (. d absY) MENU) (float 0x4062c00000000000))) "pointer popup clamps to viewport"))
    (expr (call ok (== (. d focus) (index ITEM 0)) "context popup takes first focus"))
    (expr (call key (& d) "a" ""))
    (expr (call ok (== (. d focus) (index ITEM 1)) "prefix starts from first matching entry with wrap"))
    (expr (call key (& d) "a" ""))
    (expr (call ok (== (. d focus) (index ITEM 0)) "repeated ASCII cycles"))
    (expr (call step (& d) 65))
    (expr (call key (& d) "b" ""))
    (expr (call ok (== (. d focus) (index ITEM 3)) "prefix skips disabled, hidden and other submenu levels"))
    (expr (call step (& d) 65))
    (expr (call key (& d) "\xc3\x89" ""))
    (expr (call ok (== (. d focus) (index ITEM 4)) "UTF8 prefix compares exact bytes"))
    (expr (call key (& d) "\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89\xc3\x89" ""))
    (expr (call ok (== (. d focus) (index ITEM 4)) "oversized UTF8 prefix is ignored without partial bytes"))
    (expr (call (. d simKeys) "" "Down"))
    (= (. (. d simK) comp) "\xc3\xa9")
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d focus) (index ITEM 4)) "IME composition keeps menu arrows from changing focus"))
    (expr (call (. d focusNode) NESTED))
    (expr (call key (& d) "b" ""))
    (expr (call ok (== (. d focus) NESTED) "prefix is scoped to submenu level"))
    (expr (call (. d focusNode) OWNER))
    (expr (call key (& d) "b" ""))
    (expr (call ok (== (. d focus) (index ITEM 3)) "typing from trigger enters menu with reset prefix"))
    (expr (call (. d focusNode) SIBSELECT))
    (expr (call key (& d) "b" ""))
    (expr (call ok (== (. d focus) SIBSELECT) "sibling select keeps typing instead of entering menu"))
    (expr (call key (& d) "" "Down"))
    (expr (call ok (== (. d focus) SIBSELECT) "sibling select keeps arrows instead of entering menu"))
    (expr (call (. d focusNode) FIELD))
    (expr (call key (& d) "hello" ""))
    (expr (call ok (== (. (call (. d strValue) FIELD) len) 5) "menu textbox keeps typed input"))
    (expr (call key (& d) "" "Down"))
    (expr (call ok (== (. d focus) FIELD) "textbox retains arrows"))
    (expr (call (. d focusNode) SELECT))
    (expr (call key (& d) "" "Down"))
    (expr (call ok (== (. d focus) SELECT) "select retains arrows"))
    (expr (call (. d focusNode) (index ITEM 4)))
    (expr (call key (& d) "" "Home"))
    (expr (call ok (== (. d focus) (index ITEM 0)) "Home navigates context menu"))
    (expr (call key (& d) "" "Escape"))
    (expr (call frame (& d)))
    (expr (call ok (&& (! OPEN) (== (. d focus) OWNER)) "Escape restores context owner focus"))
    (expr (call key (& d) "" "F10"))
    (expr (call ok (&& (&& (! OPEN) (== REQUESTS 1)) (== CLICKS 0)) "bare F10 and held right button do not synthesize a context request or click"))
    (expr (call key (& d) "" "S+F10"))
    (expr (call ok (&& OPEN (== REQUESTS 2)) "keyboard context request dispatches same handler"))
    (expr (call key (& d) "\xc3\x89" ""))
    (expr (call ok (== (. d focus) (index ITEM 4)) "closing and reopening clears prefix"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) MENU) atx) (float 0x4072c00000000000)) (== (. (index (. (. d nodes) items) MENU) aty) (float 0x4072200000000000))) "keyboard anchor is owner bottom"))
    (expr (call key (& d) "" "Escape"))
    (expr (call frame (& d)))
    (expr (call (. d simRight) (bool true)))
    (expr (call frame (& d)))
    (expr (call (. d simRight) (bool false)))
    (expr (call frame (& d)))
    (expr (call ok OPEN "reopen by pointer after keyboard close"))
    (expr (call (. d simInput) (float 0x4075e00000000000) (float 0x4070400000000000) (bool false) (float 0x0000000000000000)))
    (expr (call (. d simRight) (bool true)))
    (expr (call frame (& d)))
    (expr (call (. d simRight) (bool false)))
    (expr (call frame (& d)))
    (expr (call ok (&& OPEN (== (. (index (. (. d nodes) items) MENU) atx) (float 0x4075e00000000000))) "second context request reanchors without outside-close race"))
    (expr (call (. d simInput) (float 0x4020000000000000) (float 0x4066800000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (float 0x4020000000000000) (float 0x4066800000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 2))
    (expr (call ok (! OPEN) "outside press closes context popover"))
    (expr (call (. d simInput) (float 0x4075e00000000000) (float 0x406f400000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (float 0x4075e00000000000) (float 0x406f400000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (&& (== CLICKS 1) (! OPEN)) "normal left click remains independent of context dispatch"))
    (= OPEN (bool true))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (< (. d ctxNode) 0) (== (. (index (. (. d nodes) items) MENU) atx) (float 0x4072c00000000000))) (== (. (index (. (. d nodes) items) MENU) aty) (float 0x4072200000000000))) "fresh programmatic reopen cannot reuse old context coordinates"))
    (expr (call key (& d) "" "Escape"))
    (expr (call frame (& d)))
    (expr (call (. d focusNode) OWNER))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call step (& d) 20))
    (expr (call ok (! CARD) "hover card waits delay"))
    (expr (call step (& d) 20))
    (expr (call ok (&& CARD (== (. d focus) OWNER)) "delayed markup opens without stealing focus"))
    (expr (call step (& d) 2))
    (expr (call ok (< (. d ttRoot) 0) "shown custom card suppresses owner's title"))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x4052000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 8))
    (expr (call ok CARD "crossing gap has grace"))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x4056800000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 25))
    (expr (call ok CARD "pointer inside card keeps it open"))
    (expr (call (. d focusNode) BUTTON))
    (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 30))
    (expr (call ok CARD "keyboard focus inside retains card"))
    (expr (call key (& d) "" "Escape"))
    (expr (call frame (& d)))
    (expr (call ok (! CARD) "Escape closes custom card"))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 40))
    (expr (call ok CARD "returning opens card again"))
    (expr (call key (& d) "" "Escape"))
    (expr (call step (& d) 40))
    (expr (call ok (! CARD) "Escape while over owner suppresses immediate reopen"))
    (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 21))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 40))
    (= MODAL (bool true))
    (expr (call step (& d) 3))
    (expr (call ok (! CARD) "modal filters custom tooltip owner"))
    (= MODAL (bool false))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 30))
    (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call step (& d) 40))
    (for warm (.. 0 3) (block
      (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 21))
      (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 34))))
    (let replayStart _ (. mem used))
    (for replay (.. 0 3) (block
      (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 21))
      (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 34))))
    (expr (call ok (== (. mem used) replayStart) "warmup replay is flat before long reopen loop"))
    (let used _ (. mem used))
    (let laid _ (. d laid))
    (let styled _ (. d restyled))
    (expr (call step (& d) 100))
    (expr (call ok (&& (&& (== (. mem used) used) (== (. d laid) laid)) (== (. d restyled) styled)) "steady custom tooltip costs 0/0/0"))
    (for j (.. 0 1000) (block
      (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4059000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 21))
      (expr (call (. d simInput) (float 0x403e000000000000) (float 0x403e000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call step (& d) 34))))
    (expr (call printLn (interp "reopen arena growth: " (- (. mem used) used))))
    (expr (call ok (== (. mem used) used) "1000 custom card reopens allocate nothing after warmup"))
    (= SHOW (bool false))
    (expr (call step (& d) 2))
    (expr (call ok (== (. (. d ovs) len) 0) "owner removal removes hover card stack entry"))
    (= SHOW (bool true))
    (expr (call frame (& d)))
    (expr (call ok (! CARD) "recycled owner starts with fresh hover delay"))
    (expr (call step (& d) 20))
    (expr (call ok (! CARD) "recycled owner cannot inherit previous open state"))
    (expr (call printLn (interp "context_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
