(file (module ui_ansi_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.Text)
  (use j3.ui.ansi.AnsiLog)
  (use j3.term.paletteRgb)
  (fn eq (params (a string) (b string) (msg string)) _ (block
    (if (! (== a b)) (block
      (expr (call printLn (interp "FAIL: " msg ": want [" b "] got [" a "]")))
      (expr (call panic msg))))))
  (fn ok (params (c bool) (msg string)) _ (block
    (if (! c) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn esc (params (s string) (arena (ref Arena))) string (block
    (let t _ (call (. Text new) arena))
    (for i (.. 0 (. s len)) (block
      (if (== (index s i) 126) (block
        (expr (call (. t push) 27))) (block
        (expr (call (. t push) (index s i)))))))
    (return (call (. t str)))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 1048576))
    (let l _ (call (. AnsiLog new) 13421772 1052688 0))
    (expr (call (. l append) (call esc "plain ~[1;31mred bold~[0m ok\n~[38;5;196mx~[48;2;1;2;3my~[0m\n" (& a))))
    (expr (call eq (interp (. (. l lines) len)) "3" "lines"))
    (let s _ (call (. l line) 0))
    (expr (call eq (interp (. s len)) "3" "segs line0"))
    (expr (call eq (. (index s 0) text) "plain " "seg0"))
    (expr (call eq (. (index s 0) fg) "" "inherit fg"))
    (expr (call eq (. (index s 1) text) "red bold" "seg1"))
    (expr (call eq (. (index s 1) fg) "#cd3131" "red"))
    (expr (call eq (. (index s 1) weight) "bold" "bold"))
    (expr (call eq (. (index s 2) text) " ok" "seg2"))
    (expr (call eq (. (index (call (. l line) 1) 0) fg) "#ff0000" "256 red"))
    (expr (call eq (. (index (call (. l line) 1) 1) bg) "#010203" "rgb bg"))
    (expr (call eq (interp (call paletteRgb 232)) (interp 526344) "gray"))
    (expr (call eq (interp (call paletteRgb 231)) (interp 16777215) "cube end"))
    (let b _ (call (. AnsiLog new) 13421772 1052688 0))
    (expr (call (. b append) (call esc "a~[3" (& a))))
    (expr (call (. b append) (call esc "1mb~[2K~[1;1H~]0;title~Gc~[7mi~[0m\n" (& a))))
    (expr (call eq (interp (. (call (. b line) 0) len)) "3" "split segs"))
    (expr (call eq (. (index (call (. b line) 0) 0) text) "a" "split a"))
    (expr (call eq (. (index (call (. b line) 0) 1) text) "bc" "split bc"))
    (expr (call eq (. (index (call (. b line) 0) 1) fg) "#cd3131" "split red"))
    (expr (call eq (. (index (call (. b line) 0) 2) fg) "#101010" "inverse fg is pane bg"))
    (expr (call eq (. (index (call (. b line) 0) 2) bg) "#cd3131" "inverse bg is the old fg"))
    (let c _ (call (. AnsiLog new) 13421772 1052688 0))
    (expr (call (. c append) "10%\r50%\r100%\r\nab\tc\n"))
    (expr (call eq (. (index (call (. c line) 0) 0) text) "100%" "cr overwrite"))
    (expr (call eq (. (index (call (. c line) 1) 0) text) "ab      c" "tab"))
    (expr (call eq (interp (. (. c lines) len)) "3" "crlf lines"))
    (let d _ (call (. AnsiLog new) 13421772 1052688 1000))
    (let big _ 0)
    (for i (.. 0 100000) (block
      (let t _ (call (. Text new) (& a)))
      (expr (call (. t pushStr) "~[32mprogress "))
      (expr (call (. t pushInt) i))
      (expr (call (. t pushStr) " 10%\r~[32mprogress 50%\rdone "))
      (expr (call (. t pushInt) i))
      (expr (call (. t push) 10))
      (expr (call (. d append) (call esc (call (. t str)) (& a))))
      (if (> (call (. d memCap)) big) (block
        (= big (call (. d memCap)))))))
    (expr (call eq (interp (<= (call (. d count)) 1001)) "true" "capped count"))
    (expr (call eq (. (index (call (. d line) (- (call (. d count)) 2)) 0) text) "done 99999" "newest kept"))
    (expr (call eq (. (index (call (. d line) 0) 0) text) (interp "done " (- 100000 (- (call (. d count)) 1))) "oldest kept"))
    (expr (call ok (<= big 1048576) "arena bounded"))
    (expr (call (. d clear)))
    (expr (call eq (interp (call (. d count))) "1" "cleared"))
    (expr (call (. d append) "x\n"))
    (expr (call eq (. (index (call (. d line) 0) 0) text) "x" "after clear"))
    (expr (call (. d destroy)))
    (expr (call printLn "ui_ansi_test ok")))))
--- stderr
--- exit 0
