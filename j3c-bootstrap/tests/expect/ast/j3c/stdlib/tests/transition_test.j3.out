(file (module transition_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.anim)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CLICKED int _)
  (mod-let (doc "`Css.eases` index of the next `frame` (1 linear, 3 ease-out).") EASE int _)
  (mod-let (doc "The sibling after the sliding box in `slideFrame`.") SIB int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (if (|| (> (- a b) (float 0x3f947ae147ae147b)) (> (- b a) (float 0x3f947ae147ae147b))) (block
      (expr (call printLn (interp "FAIL: " msg ": " a " vs " b)))
      (expr (call panic msg))))))
  (const SHEET string ".e { width: 100px; height: 20px; } .s { width: 50px; height: 10px; } .row { display: flex; } .col { display: flex; flex-direction: column; }")
  (fn (doc "One element `.e` (when `on`) with transitions: enter kind `ik`, leave kind `ok_`, 160 ms, linear; fly (40, 0), scale from 0.5.") frame (params (d (ref Dom)) (on bool) (ik int) (ok_ int)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let e _ (- 1))
    (if on (block
      (= e (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "e"))
      (expr (call (. d trans) e ik (float 0x4064000000000000) ok_ (float 0x4064000000000000) EASE (float 0x4044000000000000) (float 0x0000000000000000) (float 0x3fe0000000000000) 0))
      (= CLICKED (if-expr (call (. d clicked) e) 1 0))
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return e)))
  (fn run (params (d (ref Dom)) (on bool) (ik int) (ok_ int) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d on ik ok_))))))
  (fn (doc "What the kind shows at amount `a`: fly offset, scale.") check (params (d (ref Dom)) (e int) (k int) (a f32) (msg string)) _ (block
    (expr (call near (call (. d trAmt) e) a (interp msg ": amount")))
    (expr (call near (call (. d trDx) e) (if-expr (== k 2) (* (float 0x4044000000000000) (- (float 0x3ff0000000000000) a)) (float 0x0000000000000000)) (interp msg ": fly offset")))
    (expr (call near (call (. d trScale) e) (if-expr (== k 4) (+ (float 0x3fe0000000000000) (* (float 0x3fe0000000000000) a)) (float 0x3ff0000000000000)) (interp msg ": scale")))))
  (fn kindTest (params (d (ref Dom)) (k int)) _ (block
    (expr (call run d (bool false) k k 2))
    (let e _ (call frame d (bool true) k k))
    (expr (call ok (&& (== (. (. d trns) len) 1) (== (. (index (. (. d nodes) items) e) trn) 0)) "one record"))
    (expr (call ok (== (call (. d trKind) e) k) "enter plays its kind"))
    (expr (call check d e k (float 0x0000000000000000) "enter start"))
    (let laid _ (. d laid))
    (let rest _ (. d restyled))
    (expr (call run d (bool true) k k 5))
    (expr (call check d e k (float 0x3fe0000000000000) "enter mid"))
    (expr (call ok (&& (|| (== k 3) (== (. d laid) laid)) (== (. d restyled) rest)) "a transition in flight neither lays out (slide does) nor restyles"))
    (expr (call run d (bool true) k k 6))
    (expr (call ok (== (call (. d trKind) e) 0) "enter done"))
    (expr (call check d e k (float 0x3ff0000000000000) "enter end"))
    (let used _ (. (. d mem) used))
    (= laid (. d laid))
    (= rest (. d restyled))
    (expr (call run d (bool true) k k 10))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (== (. d restyled) rest)) "steady frames are free"))
    (expr (call frame d (bool false) k k))
    (expr (call ok (&& (== (. d ghosts) 1) (. (index (. (. d nodes) items) e) ghost)) "removed element stays as a ghost"))
    (expr (call ok (== (call (. d trKind) e) k) "leave plays its kind"))
    (expr (call check d e k (float 0x3ff0000000000000) "leave start"))
    (expr (call run d (bool false) k k 5))
    (expr (call check d e k (float 0x3fe0000000000000) "leave mid"))
    (expr (call run d (bool false) k k 8))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "ghost dropped, record freed"))))
  (fn (doc "Keyed rows `ord[0..n]` each with a fly transition.") rowFrame (params (d (ref Dom)) (ord (slice int)) (n int) (uids (slice int)) (rows (slice int))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (for i (.. 0 n) (block
      (let r _ (index ord i))
      (if (< (index uids r) 0) (block
        (= (index uids r) (call (. d groupNew) (- 1)))))
      (expr (call (. d keyBegin) (index uids r)))
      (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "e"))
      (expr (call (. d trans) e 2 (float 0x4064000000000000) 2 (float 0x4064000000000000) 1 (float 0x4044000000000000) (float 0x0000000000000000) (float 0x3fe0000000000000) 0))
      (= (index rows r) e)
      (expr (call (. d close)))
      (expr (call (. d keyEnd)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "A keyed row that is removed (middle and tail) leaves as a ghost, then its state is freed.") eachTest (params (d (ref Dom))) _ (block
    (let ord _ (call (. (. d mem) alloc) (targs int) 4))
    (let uids _ (call (. (. d mem) alloc) (targs int) 4))
    (let rows _ (call (. (. d mem) alloc) (targs int) 4))
    (for i (.. 0 4) (block
      (= (index ord i) i)
      (= (index uids i) (- 1))
      (= (index rows i) (- 1))))
    (for i (.. 0 14) (block
      (expr (call rowFrame d ord 3 uids rows))))
    (expr (call ok (&& (== (. (. d trns) len) 3) (== (call (. d trKind) (index rows 1)) 0)) "rows entered"))
    (= (index ord 1) 2)
    (expr (call rowFrame d ord 2 uids rows))
    (expr (call ok (&& (&& (== (. d ghosts) 1) (. (index (. (. d nodes) items) (index rows 1)) ghost)) (== (call (. d trKind) (index rows 1)) 2)) "the removed middle row leaves"))
    (expr (call ok (&& (== (call (. d trKind) (index rows 0)) 0) (== (call (. d trKind) (index rows 2)) 0)) "the others stay"))
    (for i (.. 0 14) (block
      (expr (call rowFrame d ord 2 uids rows))))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 2)) "gone, two records left"))
    (expr (call rowFrame d ord 1 uids rows))
    (expr (call ok (== (. d ghosts) 1) "the removed tail row leaves"))
    (for i (.. 0 14) (block
      (expr (call rowFrame d ord 1 uids rows))))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 1)) "tail gone"))
    (for i (.. 0 14) (block
      (expr (call rowFrame d ord 0 uids rows))))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "all rows gone"))))
  (fn (doc "A flex box holding the element `.e` (when `on`; slide, 160 ms, linear, on `axis`) and a sibling `.s` after it.") slideFrame (params (d (ref Dom)) (on bool) (mode int)) int (block
    (let axis _ (if-expr (== mode 1) 1 0))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) c (if-expr (== mode 1) "row" (if-expr (== mode 2) "col" "blk"))))
    (let e _ (- 1))
    (if on (block
      (= e (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "e"))
      (expr (call (. d trans) e 3 (float 0x4064000000000000) 3 (float 0x4064000000000000) 1 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3fe0000000000000) axis))
      (expr (call (. d close)))))
    (= SIB (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) SIB "s"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return e)))
  (fn slideRun (params (d (ref Dom)) (on bool) (mode int) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call slideFrame d on mode))))))
  (fn sibAt (params (d (ref Dom)) (axis int)) f32 (block
    (return (if-expr (== axis 1) (. (index (. (. d nodes) items) SIB) x) (. (index (. (. d nodes) items) SIB) y)))))
  (fn (doc "A slide changes the size in layout while it flies, so the sibling after it sits at an interpolated place; idle after.") slideFlowTest (params (d (ref Dom)) (axis int)) _ (block
    (let size f32 (if-expr (== axis 1) (float 0x4059000000000000) (float 0x4034000000000000)))
    (expr (call slideRun d (bool false) axis 2))
    (expr (call near (call sibAt d axis) (float 0x0000000000000000) "no box, sibling first"))
    (let e _ (call slideFrame d (bool true) axis))
    (expr (call near (call sibAt d axis) (float 0x0000000000000000) "enter start: no space taken yet"))
    (expr (call slideRun d (bool true) axis 5))
    (expr (call near (call sibAt d axis) (* size (float 0x3fe0000000000000)) "enter mid: the sibling is half way"))
    (let laid _ (. d laid))
    (expr (call slideRun d (bool true) axis 1))
    (expr (call ok (> (. d laid) laid) "a flying slide lays out each frame"))
    (expr (call slideRun d (bool true) axis 6))
    (expr (call near (call sibAt d axis) size "enter end: full size"))
    (expr (call ok (== (call (. d trKind) e) 0) "enter done"))
    (let used _ (. (. d mem) used))
    (= laid (. d laid))
    (expr (call slideRun d (bool true) axis 10))
    (expr (call ok (&& (== (. d laid) laid) (== (. (. d mem) used) used)) "no layout once the slide is done"))
    (expr (call slideFrame d (bool false) axis))
    (expr (call near (call sibAt d axis) size "leave start"))
    (expr (call slideRun d (bool false) axis 5))
    (expr (call near (call sibAt d axis) (* size (float 0x3fe0000000000000)) "leave mid: the sibling is half way back"))
    (expr (call slideRun d (bool false) axis 8))
    (expr (call near (call sibAt d axis) (float 0x0000000000000000) "leave end"))
    (= laid (. d laid))
    (expr (call slideRun d (bool false) axis 10))
    (expr (call ok (&& (&& (== (. d laid) laid) (== (. d ghosts) 0)) (== (. (. d trns) len) 0)) "idle after the leave"))))
  (fn (doc "Toggled every other frame: the leaving ghost comes back instead of piling up copies.") toggleTest (params (d (ref Dom))) _ (block
    (let on _ (bool false))
    (let max_nodes _ 0)
    (for i (.. 0 100) (block
      (if (== (% i 2) 0) (block
        (= on (! on))))
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d on 1 1))
      (expr (call ok (&& (<= (. d ghosts) 1) (<= (. (. d trns) len) 1)) "toggling keeps one record and at most one ghost"))
      (let live _ 0)
      (for k (.. 0 (. (. d nodes) len)) (block
        (if (!= (. (index (. (. d nodes) items) k) kind) 0) (block
          (+= live 1)))))
      (if (> live max_nodes) (block
        (= max_nodes live)))))
    (expr (call ok (<= max_nodes 4) "the node count stays bounded"))
    (expr (call run d (bool true) 1 1 20))
    (let e _ (call frame d (bool true) 1 1))
    (expr (call ok (&& (== (call (. d trKind) e) 0) (== (. (. d trns) len) 1)) "back on and settled"))
    (expr (call near (call (. d trAmt) e) (float 0x3ff0000000000000) "fully shown"))
    (expr (call run d (bool false) 1 1 14))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "off: gone"))
    (= e (call frame d (bool true) 1 1))
    (expr (call run d (bool true) 1 1 14))
    (expr (call frame d (bool false) 1 1))
    (expr (call run d (bool false) 1 1 4))
    (let before _ (call (. d trAmt) e))
    (let e2 _ (call frame d (bool true) 1 1))
    (expr (call ok (&& (== e2 e) (== (. d ghosts) 0)) "the same node comes back"))
    (expr (call near (call (. d trAmt) e2) (+ (- before (float 0x3fb999999999999a)) (float 0x0000000000000000)) "enters from the visual amount (one frame later)"))
    (expr (call run d (bool true) 1 1 14))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (= EASE 1)
    (for k (.. 1 5) (block
      (expr (call kindTest (& d) k))))
    (let e _ (call frame (& d) (bool true) 2 1))
    (expr (call ok (== (call (. d trKind) e) 2) "enter is a fly"))
    (expr (call run (& d) (bool true) 2 1 12))
    (expr (call frame (& d) (bool false) 2 1))
    (expr (call ok (== (call (. d trKind) e) 1) "leave is a fade"))
    (expr (call near (call (. d trDx) e) (float 0x0000000000000000) "a fade does not move"))
    (expr (call run (& d) (bool false) 2 1 12))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "dropped"))
    (= e (call frame (& d) (bool true) 4 0))
    (expr (call run (& d) (bool true) 4 0 12))
    (expr (call frame (& d) (bool false) 4 0))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "no out: no ghost, state freed"))
    (= e (call frame (& d) (bool true) 0 3))
    (expr (call ok (== (call (. d trKind) e) 0) "no in: shown at once"))
    (expr (call frame (& d) (bool false) 0 3))
    (expr (call ok (&& (== (. d ghosts) 1) (== (call (. d trKind) e) 3)) "out: leaves"))
    (expr (call run (& d) (bool false) 0 3 12))
    (expr (call ok (== (. d ghosts) 0) "dropped"))
    (= e (call frame (& d) (bool true) 1 1))
    (expr (call run (& d) (bool true) 1 1 4))
    (let before _ (call (. d trAmt) e))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool false) 1 1))
    (expr (call near (call (. d trAmt) e) (+ before (float 0x3fb999999999999a)) "leave starts at the enter progress (one frame later)"))
    (expr (call run (& d) (bool false) 1 1 12))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "dropped"))
    (= e (call frame (& d) (bool true) 2 2))
    (= CLICKED 0)
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call (. d simInput) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call ok (== CLICKED 0) "a click on the empty layout slot misses the flying box"))
    (expr (call (. d simInput) (float 0x4054000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call (. d simInput) (float 0x4054000000000000) (float 0x4024000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call (. d simInput) (float 0x4054000000000000) (float 0x4024000000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) (bool true) 2 2))
    (expr (call ok (== CLICKED 1) "a click on the drawn box lands"))
    (expr (call eachTest (& d)))
    (expr (call slideFlowTest (& d) 0))
    (expr (call slideFlowTest (& d) 1))
    (expr (call slideFlowTest (& d) 2))
    (expr (call toggleTest (& d)))
    (= EASE 3)
    (expr (call run (& d) (bool false) 2 2 14))
    (= e (call frame (& d) (bool true) 2 2))
    (expr (call run (& d) (bool true) 2 2 5))
    (expr (call near (call (. d trAmt) e) (call (. anim ease) (& (index (. (. (. d css) eases) items) 3)) (float 0x3fe0000000000000)) "ease-out mid enter follows the curve"))
    (expr (call ok (> (call (. d trAmt) e) (float 0x3fe3333333333333)) "ease-out is ahead of linear"))
    (expr (call run (& d) (bool true) 2 2 8))
    (expr (call frame (& d) (bool false) 2 2))
    (expr (call run (& d) (bool false) 2 2 5))
    (expr (call near (call (. d trAmt) e) (- (float 0x3ff0000000000000) (call (. anim ease) (& (index (. (. (. d css) eases) items) 3)) (float 0x3fe0000000000000))) "and mirrored on the leave"))
    (expr (call run (& d) (bool false) 2 2 8))
    (= EASE 1)
    (expr (call printLn "transition_test ok")))))
--- stderr
--- exit 0
