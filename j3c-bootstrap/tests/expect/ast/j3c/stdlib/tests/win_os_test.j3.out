(file (module win_os_test)
  (use j3.instance)
  (use j3.io)
  (use j3.io.printLn)
  (use j3.io.watch)
  (use j3.io.watch (names Event Watcher))
  (use j3.memory (names Arena List))
  (use j3.option.Option)
  (use j3.proc)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.term.pty)
  (use j3.winsys)
  (fn has (params (s string) (w string)) bool (block
    (if (> (. w len) (. s len)) (block
      (return (bool false))))
    (for i (.. 0 (+ (- (. s len) (. w len)) 1)) (block
      (if (== (slice-expr s i (+ i (. w len))) w) (block
        (return (bool true))))))
    (return (bool false))))
  (fn ok (params (c bool) (what string)) _ (block
    (expr (call printLn (interp what ": " c)))
    (if (! c) (block
      (expr (call panic what))))))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) (<< 1 24)))
    (if (== (call (. sys arg) 1) "client") (block
      (let a (array 2 string) (array-lit "win_os_test" "ping"))
      (match (call (. instance request) "j3winostest" (slice-expr a _ _) 10000)
        (arm (pats (variant Option.Some (bind r))) (block
          (expr (call printLn (interp "reply=[" r "]")))))
        (arm (pats (variant Option.None)) (block
          (expr (call printLn "reply none")))))
      (return)))
    (let argv (array 4 string) (array-lit "cmd" "/c" "echo" "x"))
    (let out _ "")
    (match (call (. proc run) (slice-expr argv _ _) "" (& arena))
      (arm (pats (variant Result.Ok (bind o))) (block
        (= out (call (. o outStr)))
        (expr (call ok (== (. o code) 0) "proc code"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "proc run")))))
    (expr (call ok (&& (>= (. out len) 1) (== (index out 0) 120)) "proc out x"))
    (let bad (array 1 string) (array-lit "no_such_program_j3"))
    (match (call (. proc run) (slice-expr bad _ _) "" (& arena))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "proc NotFound"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (== e (. (. proc ProcError) NotFound)) "proc NotFound")))))
    (let exit5 (array 3 string) (array-lit "cmd" "/c" "exit 5"))
    (match (call (. proc start) (slice-expr exit5 _ _) (& arena))
      (arm (pats (variant Result.Ok (bind c))) (block
        (expr (call ok (== (call (. c wait)) 5) "proc exit code"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "proc start")))))
    (let env (array 1 string) (array-lit "J3TEST=bar"))
    (let pa (array 1 string) (array-lit "cmd.exe"))
    (match (call (. pty spawn) (slice-expr pa _ _) "C:\\" (slice-expr env _ _) 80 24 (& arena))
      (arm (pats (variant Result.Ok (bind p))) (block
        (let buf _ (call (. arena alloc) (targs u8) 65536))
        (expr (call (. p write) (as "echo hi%J3TEST%\r" (slice u8))))
        (let seen _ (bool false))
        (for i (.. 0 200) (block
          (if (&& (call (. p waitReadable) 50) (call has (call (. p tryRead) buf) "hibar")) (block
            (= seen (bool true))
            (break)))))
        (expr (call ok seen "pty echo"))
        (expr (call (. p resize) 120 40))
        (expr (call (. p write) (as "exit 3\r" (slice u8))))
        (for i (.. 0 200) (block
          (if (. p eof) (block
            (break)))
          (if (call (. p waitReadable) 50) (block
            (expr (call (. p tryRead) buf))))))
        (expr (call ok (. p eof) "pty eof"))
        (expr (call ok (== (call (. p wait)) 3) "pty exit code"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "pty spawn")))))
    (let dir _ "C:\\j3_win_os_test")
    (expr (call (. io makeDirs) dir))
    (expr (call (. io remove) "C:\\j3_win_os_test\\a.txt"))
    (let w _ (call (. Watcher create) (& arena)))
    (let got _ (bool false))
    (match (call (. w add) dir)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call (. io writeFile) "C:\\j3_win_os_test\\a.txt" (as "x" (slice u8))))
        (let evs _ (call (. (type-path List Event) new) (& arena)))
        (for i (.. 0 200) (block
          (expr (call (. w poll) (& evs)))
          (for-each _ e (slice-expr (. evs items) 0 (. evs len)) (block
            (if (&& (== (. e kind) (. (. watch Kind) Create)) (== (. e name) "a.txt")) (block
              (= got (bool true))))))
          (= (. evs len) 0)
          (if got (block
            (break)))
          (expr (call (. winsys sleepMs) 10))))))
      (arm (pats (variant Result.Err (wild))) (block)))
    (expr (call (. w close)))
    (expr (call (. io remove) "C:\\j3_win_os_test\\a.txt"))
    (expr (call ok got "watch create"))
    (expr (call ok (call (. instance claim) "j3winostest") "instance claim"))
    (let ca (array 2 string) (array-lit (call (. sys arg) 0) "client"))
    (match (call (. proc start) (slice-expr ca _ _) (& arena))
      (arm (pats (variant Result.Ok (bind c))) (block
        (for i (.. 0 1000) (block
          (let done _ (bool false))
          (match (call (. instance nextRequest))
            (arm (pats (variant Option.Some (bind r))) (block
              (expr (call (. r reply) (interp "pong " (index (call (. r args)) 1))))
              (= done (bool true))))
            (arm (pats (variant Option.None)) (block)))
          (if done (block
            (break)))
          (expr (call (. winsys sleepMs) 10))))
        (let o _ (call (. c collect) (as "" (slice u8)) (& arena)))
        (expr (call ok (call has (call (. o outStr)) "reply=[pong ping]") "instance request"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "instance client start")))))
    (expr (call printLn "win_os_test ok")))))
--- stderr
--- exit 0
