(file (module cssvar_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css (names Css MatchNode P_BG_IMAGE P_BOX_SHADOW P_BACKGROUND V_URL))
  (use j3.text.same)
  (use j3.ui.cssmatch.computeStyle)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.motion)
  (mod-let THEME int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (expr (call ok (&& (> a (- b (float 0x3ff0000000000000))) (< a (+ b (float 0x3ff0000000000000)))) msg))))
  (const USHEET string ":root { --bg: url(a.png); } .night { --bg: url(sub/b.png); } .pic { width: 4px; height: 4px; background-image: var(--bg); } .pulse { width: 10px; height: 10px; animation: pulse 1s linear infinite; } @keyframes pulse { from { opacity: 0.2; } to { opacity: 1; } }")
  (fn uframe (params (d (ref Dom))) int (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let root _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d clsIf) root "night" (== THEME 2)))
    (let pic _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) pic "pic"))
    (expr (call (. d close)))
    (for i (.. 1 500) (block
      (let more _ (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d cls) more "pic"))
      (expr (call (. d close)))))
    (let pl _ (call (. d open) 500 (call (. d tag) "div") 1))
    (expr (call (. d cls) pl "pulse"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return pic)))
  (fn run2 (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call uframe d))))))
  (const SHEET string ".t1 { --accent: #ff0000; --edge: #000000; } .t2 { --accent: #0000ff; --edge: #ffffff; } .card { width: 40px; height: 40px; background-image: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 50%, white) 80%); box-shadow: 0 2px 6px var(--edge); border: 2px solid var(--accent); transition: background-image 100ms linear; } .plain { width: 10px; height: 10px; }")
  (fn frame (params (d (ref Dom))) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let root _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d clsIf) root "t1" (== THEME 1)))
    (expr (call (. d clsIf) root "t2" (== THEME 2)))
    (let card _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) card "card"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let other _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) other "t2"))
    (let card2 _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) card2 "card"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return card)))
  (fn run (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d))))))
  (fn (doc "First stop (field f: 1 r, 2 g, 3 b) of the gradient of style `st`.") stop0 (params (css (ref Css)) (st int) (f int)) f32 (block
    (return (index (. (. css paints) items) (+ (+ (. (call (. css get) st P_BG_IMAGE) i) 4) f)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "v.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses clean"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (= THEME 1)
    (expr (call run (& d) 3))
    (let card _ (call frame (& d)))
    (let st _ (. (index (. (. d nodes) items) card) tstyle))
    (expr (call near (call stop0 (& css) st 1) (float 0x406fe00000000000) "theme 1: red first stop"))
    (expr (call near (call stop0 (& css) st 3) (float 0x0000000000000000) "theme 1: no blue"))
    (let rest _ (. d restyled))
    (expr (call run (& d) 10))
    (expr (call ok (== (. d restyled) rest) "steady frames do not restyle"))
    (= THEME 2)
    (= card (call frame (& d)))
    (expr (call ok (> (. d restyled) rest) "the class flip restyles"))
    (= st (. (index (. (. d nodes) items) card) tstyle))
    (expr (call near (call stop0 (& css) st 1) (float 0x0000000000000000) "theme 2: first stop lost its red"))
    (expr (call near (call stop0 (& css) st 3) (float 0x406fe00000000000) "theme 2: blue first stop"))
    (= rest (. d restyled))
    (let np _ (. (. css paints) len))
    (expr (call run (& d) 20))
    (expr (call ok (&& (== (. d restyled) rest) (== (. (. css paints) len) np)) "steady after the flip: no restyle, no new paint data"))
    (= THEME 1)
    (expr (call frame (& d)))
    (expr (call ok (> (. d restyled) rest) "flip back restyles"))
    (= rest (. d restyled))
    (= THEME 2)
    (expr (call frame (& d)))
    (= THEME 1)
    (expr (call frame (& d)))
    (= np (. (. css paints) len))
    (expr (call run (& d) 5))
    (expr (call ok (== (. (. css paints) len) np) "back and forth reuses cached styles"))
    (= THEME 1)
    (expr (call frame (& d)))
    (= THEME 2)
    (expr (call frame (& d)))
    (let used _ (. mem used))
    (= np (. (. css paints) len))
    (let nw _ (. (. css warns) len))
    (for i (.. 0 200) (block
      (= THEME (+ 1 (% i 2)))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. mem used) used) (== (. (. css paints) len) np)) (== (. (. css warns) len) nw)) "200 theme flips: arena, paint data and warnings stay flat"))
    (let c _ (call (. Css new) (& mem)))
    (expr (call parse (& c) SHEET "v2.css" 0))
    (let nodes _ (call (. mem alloc) (targs MatchNode) 4))
    (let cs _ (call (. mem alloc) (targs int) 1))
    (= (index cs 0) (call (. c intern) "t1"))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. c intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (let cs2 _ (call (. mem alloc) (targs int) 1))
    (= (index cs2 0) (call (. c intern) "t2"))
    (= (index nodes 1) (struct-lit MatchNode (field tag (call (. c intern) "div")) (field classes cs2) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (let cc _ (call (. mem alloc) (targs int) 1))
    (= (index cc 0) (call (. c intern) "card"))
    (= (index nodes 2) (struct-lit MatchNode (field tag (call (. c intern) "div")) (field classes cc) (field parent 0) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (= (index nodes 3) (struct-lit MatchNode (field tag (call (. c intern) "div")) (field classes cc) (field parent 1) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (let s0 _ (call computeStyle (& c) nodes 0 (- 1)))
    (let s1 _ (call computeStyle (& c) nodes 1 (- 1)))
    (let a _ (call computeStyle (& c) nodes 2 s0))
    (let b _ (call computeStyle (& c) nodes 3 s1))
    (expr (call ok (!= a b) "different --accent: different styles"))
    (expr (call near (call stop0 (& c) a 1) (float 0x406fe00000000000) "card under t1 is red"))
    (expr (call near (call stop0 (& c) b 3) (float 0x406fe00000000000) "card under t2 is blue"))
    (let g _ (. (call (. c get) a P_BG_IMAGE) i))
    (expr (call near (index (. (. c paints) items) (+ (+ (+ g 4) 5) 2)) (float 0x4060000000000000) "the second stop is color-mix of red and white"))
    (expr (call ok (&& (> (index (. (. c paints) items) (+ (+ g 4) 5)) (float 0x3fe947ae147ae148)) (< (index (. (. c paints) items) (+ (+ g 4) 5)) (float 0x3fe9eb851eb851ec))) "second stop sits at 80%"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& c) a b (float 0x0000000000000000)))
    (expr (call ok (call (. motion active) (& m)) "gradient transition starts"))
    (expr (call (. motion step) (& m) (& c) b (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call stop0 (& c) (. m ov) 1) (float 0x405fe00000000000) "red fades halfway"))
    (expr (call near (call stop0 (& c) (. m ov) 3) (float 0x405fe00000000000) "blue rises halfway"))
    (let uc _ (call (. Css new) (& mem)))
    (expr (call parse (& uc) USHEET "theme.css" 0))
    (expr (call ok (== (. (. uc warns) len) 0) "url() custom property sheet parses clean"))
    (let ud _ (call (. Dom new) (& mem) (& uc)))
    (expr (call (. ud setFrameMs) (float 0x4030000000000000)))
    (= THEME 1)
    (let pic _ (call uframe (& ud)))
    (let ust _ (. (index (. (. ud nodes) items) pic) tstyle))
    (expr (call ok (&& (== (. (call (. uc get) ust P_BG_IMAGE) kind) V_URL) (call same (call (. uc name) (. (call (. uc get) ust P_BG_IMAGE) i)) "a.png")) "day: a.png"))
    (= THEME 2)
    (= pic (call uframe (& ud)))
    (= ust (. (index (. (. ud nodes) items) pic) tstyle))
    (expr (call ok (&& (== (. (call (. uc get) ust P_BG_IMAGE) kind) V_URL) (call same (call (. uc name) (. (call (. uc get) ust P_BG_IMAGE) i)) "sub/b.png")) "night: sub/b.png"))
    (let loads _ (. (. (. ud imgs) ents) len))
    (let uused _ (. mem used))
    (let unp _ (. (. uc paints) len))
    (for i (.. 0 200) (block
      (= THEME (+ 1 (% i 2)))
      (expr (call uframe (& ud)))))
    (expr (call ok (&& (== (. (. (. ud imgs) ents) len) loads) (<= (. (. (. ud imgs) ents) len) 2)) "200 flips: no texture is loaded again"))
    (expr (call ok (&& (== (. mem used) uused) (== (. (. uc paints) len) unp)) "200 flips: arena and paint data stay flat"))
    (let urest _ (. ud restyled))
    (= uused (. mem used))
    (= unp (. (. uc paints) len))
    (let unw _ (. (. uc warns) len))
    (expr (call run2 (& ud) 60))
    (expr (call ok (&& (&& (&& (== (. ud restyled) urest) (== (. mem used) uused)) (== (. (. uc paints) len) unp)) (== (. (. uc warns) len) unw)) "an unrelated running animation does not re-substitute the var() images"))
    (expr (call printLn (interp "url flips: " (. (. (. ud imgs) ents) len) " textures (nothing paints in this test; golden 65 counts real loads)")))
    (expr (call printLn "cssvar_test ok")))))
--- stderr
--- exit 0
