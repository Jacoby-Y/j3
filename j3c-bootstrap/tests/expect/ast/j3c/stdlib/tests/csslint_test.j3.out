(file (module csslint_test)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.sys.panic)
  (use j3.text (names contains same))
  (use j3.ui.css (names Css Warning))
  (use j3.ui.csslint (names ElFact lint))
  (use j3.ui.cssparse.parse)
  (mod-let CHECKS int 0)
  (fn ok (params (c bool) (what string)) _ (block
    (+= CHECKS 1)
    (if (! c) (block
      (expr (call panic (interp "FAILED: " what)))))))
  (fn el (params (mem (ref Arena)) (css (ref Css)) (els (ref (gen List ElFact))) (tag string) (ws (slice string))) _ (block
    (let words _ (call (. (type-path List string) new) mem))
    (for i (.. 0 (. ws len)) (block
      (expr (call (. words push) (index ws i)))))
    (expr (call (. els push) (struct-lit ElFact (field scope 1) (field tag (if-expr (call same tag "*") (- 1) (call (. css intern) tag))) (field words words))))))
  (fn run (params (mem (ref Arena)) (src string) (build (fn-type ((ref Arena) (ref Css) (ref (gen List ElFact))) _))) (gen List Warning) (block
    (let css _ (call (. Css new) mem))
    (= (. css lintOn) (bool true))
    (expr (call parse (& css) src "t.css" 1))
    (let els _ (call (. (type-path List ElFact) new) mem))
    (expr (call build mem (& css) (& els)))
    (let out _ (call (. (type-path List Warning) new) mem))
    (expr (call lint (& css) (& els) (& out)))
    (return out)))
  (fn count (params (out (ref (gen List Warning))) (rule string)) int (block
    (let n _ 0)
    (for i (.. 0 (. out len)) (block
      (if (call contains (. (index (. out items) i) msg) rule) (block
        (+= n 1)))))
    (return n)))
  (fn facts (params (mem (ref Arena)) (css (ref Css)) (els (ref (gen List ElFact)))) _ (block
    (let a (array 2 string) (array-lit "card" "r*"))
    (expr (call el mem css els "div" (slice-expr a 0 2)))
    (let b (array 1 string) (array-lit "*"))
    (expr (call el mem css els "span" (slice-expr b 0 1)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 16 1024) 1024)))
    (let out _ (call run (& mem) ".card { color: red; color: blue; } .r7 { top: 1px; } div.nope { color: red; } p { color: red; } .card:hover { color: red; }" facts))
    (expr (call ok (== (call count (& out) "[duplicate-decl]") 1) "duplicate-decl"))
    (expr (call ok (== (call count (& out) "[never-matches]") 2) "never-matches: div.nope and p"))
    (expr (call ok (== (call count (& out) "[offset-without-position]") 1) "offset-without-position"))
    (= out (call run (& mem) ".card { position: absolute; top: 1px; text-overflow: ellipsis; overflow: hidden; } .card { left: 0 }" facts))
    (expr (call ok (== (. out len) 0) "no findings when position and overflow are set"))
    (= out (call run (& mem) ".card { background: var(--a); color: var(--b, red); } :root { --b: 1 }" facts))
    (expr (call ok (== (call count (& out) "[undefined-var]") 1) "undefined-var only without fallback"))
    (= out (call run (& mem) "div:has(.x) { color: red; } .card:has(.x) .y { color: red; }" facts))
    (expr (call ok (== (call count (& out) "[broad-has]") 1) "broad-has"))
    (expr (call ok (== (call count (& out) "[has-before-combinator]") 1) "has-before-combinator"))
    (expr (call printLn (interp "csslint_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
