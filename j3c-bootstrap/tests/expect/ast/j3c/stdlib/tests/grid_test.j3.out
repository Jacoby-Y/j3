(file (module grid_test)
  (use j3.memory (names Arena List))
  (use j3.game)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.text (names same Text))
  (use j3.math.Vec2)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom K_FREE))
  (use j3.ui.grid)
  (use j3.ui.gridstate (names Grid MAX_BYTES MAX_CELLS))
  (use j3.ui.tsv)
  (use j3.ui.inputs)
  (use j3.ui.uastyle)
  (use j3.ui.vlist)
  (use j3.ui.vstate.VList)
  (mod-let G Grid _)
  (mod-let CELLS Text _)
  (mod-let BOX int _)
  (mod-let CHECKS int _)
  (mod-let EVN int _)
  (mod-let EVK int _)
  (mod-let EVR int _)
  (mod-let EVC int _)
  (mod-let EVT Text _)
  (mod-let G2 Grid _)
  (mod-let G3 Grid _)
  (mod-let VL3 VList _)
  (mod-let TALL bool _)
  (mod-let VL VList _)
  (mod-let VL2 VList _)
  (mod-let BOX2 int _)
  (mod-let PLAIN bool _)
  (mod-let TWO bool _)
  (mod-let NR int _)
  (mod-let SPAN int _)
  (mod-let PASTE string _)
  (mod-let PN int _)
  (mod-let PT Text _)
  (mod-let PR int _)
  (mod-let PC int _)
  (mod-let CT Text _)
  (mod-let SPECIAL bool _)
  (mod-let FZ bool _)
  (mod-let EVRZ int _)
  (const ROWS int 100000)
  (const COLS int 50)
  (const SHEET string "@font-face { font-family: T; src: url(examples/big_ui_test/assets/font.ttf); } * { margin: 0; padding: 0; box-sizing: border-box; font-family: T; font-size: 12px; } .plain { box-sizing: content-box; } .page { width: 400px; height: 150px; overflow: auto; } .body { width: 400px; height: 196px; overflow: auto; } .row { display: flex; height: 24px; } .cell { height: 24px; } input { width: 70px; height: 24px; } .tall { height: 600px; } .sel { background: #ccf; } .sheet { width: 400px; height: 220px; } .head { position: relative; width: 400px; height: 24px; overflow: hidden; } .hrow { display: flex; height: 24px; } .hc { position: relative; height: 24px; } .hc.frozen { position: absolute; top: 0; z-index: 2; } .grip { position: absolute; top: 0; right: -4px; width: 8px; height: 24px; z-index: 3; } .row { position: relative; } .cell.frozen { position: absolute; top: 0; z-index: 2; background: #fff; }")
  (fn ok (params (b bool) (s string)) _ (block
    (+= CHECKS 1)
    (if (! b) (block
      (expr (call panic s))))))
  (fn (doc "Cells with data for Ctrl+arrow: rows 10..19 of columns 3..6, and everything in row 40.") filled (params (r int) (c int)) bool (block
    (return (|| (&& (&& (&& (>= r 10) (< r 20)) (>= c 3)) (< c 7)) (== r 40)))))
  (fn (doc "One grid box built like the generated code does: `vlist.step` picks the window (and keeps the focused row alive).") build (params (d (ref Dom)) (g (ref Grid)) (v (ref VList)) (which int) (plain bool)) int (block
    (let box _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) box "body"))
    (expr (call (. d clsIf) box "plain" plain))
    (expr (call (. d clsIf) box "tall" (== which 3)))
    (expr (call (. d attrTabIndex) box))
    (expr (call (. d gridBind) box (call (. g sized) NR)))
    (if (call (. d gridEdit) box) (block
      (if (&& (== which 1) (== (. g evKind) 3)) (block
        (= EVRZ (. g evCol))))
      (if (== which 1) (block
        (+= EVN 1)
        (= EVK (. g evKind))
        (= EVR (. g evRow))
        (= EVC (. g evCol))
        (expr (call (. EVT clear)))
        (expr (call (. EVT pushStr) (. g evText)))))
      (if (&& (== which 1) (== (. g evKind) 2)) (block
        (+= PN 1)
        (= PR (. g pasteRows))
        (= PC (. g pasteCols))
        (expr (call (. PT clear)))
        (for pi (.. 0 (. g pasteRows)) (block
          (for pj (.. 0 (. g pasteCols)) (block
            (expr (call (. PT pushStr) (call (. g pasteCell) pi pj)))
            (expr (call (. PT push) 124))))))))
      (if (== (. g evKind) 0) (block
        (= (. g draft) (call (. g initial) "cell"))))))
    (expr (call (. v cfg) (float 0x4038000000000000) (float 0x4044000000000000) (bool false) (bool false)))
    (let w _ (call (. vlist step) d box v NR))
    (= SPAN (- (. w hi) (. w lo)))
    (if (> SPAN 200) (block
      (expr (call panic "window not bounded"))))
    (for i (.. (. w lo) (. w hi)) (block
      (let tok _ (call (. d enter) (/ i 4096)))
      (let row _ (call (. d open) (% i 4096) (call (. d tag) "div") 1))
      (expr (call (. d cls) row "row"))
      (expr (call (. d styleNum) row 0 "width" (. g total)))
      (if FZ (block
        (expr (call (. d styleNum) row 1 "padding-left" (call (. g fw))))))
      (for j (.. 0 COLS) (block
        (let c _ (call (. d open) j (call (. d tag) "div") 1))
        (expr (call (. d cls) c "cell"))
        (expr (call (. d clsIf) c "active" (call (. g on) i j)))
        (expr (call (. d clsIf) c "sel" (call (. g inRange) i j)))
        (expr (call (. d styleNum) c 0 "width" (call (. g w) j)))
        (if FZ (block
          (expr (call (. d clsIf) c "frozen" (call (. g fz) j)))
          (expr (call (. d styleNum) c 1 "left" (call (. g bx) j)))))
        (if (call (. g editAt) i j) (block
          (let e _ (call (. d open) 0 (call (. d tag) "input") 1))
          (expr (call (. d attrType) e "text"))
          (if (call (. d changed) e) (block
            (= (. g draft) (call (. d strValue) e))))
          (expr (call (. d attrText) e (. g draft)))
          (expr (call (. d close)))) (block
          (expr (call (. d text) "x"))))
        (expr (call (. d close)))))
      (expr (call (. d close)))
      (expr (call (. d leave) tok))))
    (expr (call (. d close)))
    (return box)))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x406b800000000000)))))
    (expr (call (. inputs begin) d))
    (if (> (. PASTE len) 0) (block
      (expr (call (. grid paste) d (& G) PASTE))
      (= PASTE "")))
    (if FZ (block
      (let sh _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) sh "sheet"))
      (let hd _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) hd "head"))
      (let hr _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) hr "hrow"))
      (expr (call (. d styleNum) hr 0 "margin-left" (- (float 0x0000000000000000) (. G sx))))
      (expr (call (. d styleNum) hr 1 "width" (. G total)))
      (expr (call (. d styleNum) hr 2 "padding-left" (call (. G fw))))
      (for j (.. 0 COLS) (block
        (let hc _ (call (. d open) j (call (. d tag) "div") 1))
        (expr (call (. d cls) hc "hc"))
        (expr (call (. d clsIf) hc "frozen" (call (. G fz) j)))
        (expr (call (. d styleNum) hc 0 "left" (call (. G hx) j)))
        (expr (call (. d styleNum) hc 1 "width" (call (. G w) j)))
        (let gp _ (call (. d open) 0 (call (. d tag) "div") 1))
        (expr (call (. d cls) gp "grip"))
        (if (call (. d mouseDown) gp) (block
          (expr (call (. G grab) j))))
        (expr (call (. d close)))
        (expr (call (. d close)))))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (let wr _ (call (. d open) 1 (call (. d tag) "div") 1))
      (= BOX (call build d (& G) (& VL) 1 (bool false)))
      (expr (call (. d close)))
      (expr (call (. d close)))) (block
      (if TALL (block
        (let pg _ (call (. d open) 0 (call (. d tag) "div") 1))
        (expr (call (. d cls) pg "page"))
        (expr (call build d (& G3) (& VL3) 3 (bool false)))
        (expr (call (. d close)))) (block
        (= BOX (call build d (& G) (& VL) 1 PLAIN))
        (if TWO (block
          (= BOX2 (call build d (& G2) (& VL2) 2 (bool false)))))))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn frames (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call frame d))))))
  (fn key (params (d (ref Dom)) (k string)) _ (block
    (expr (call (. d simKeys) "" k))
    (expr (call frames d 2))))
  (fn type (params (d (ref Dom)) (s string)) _ (block
    (expr (call (. d simKeys) s ""))
    (expr (call frames d 2))))
  (fn at (params (r int) (c int)) bool (block
    (return (&& (== (. G row) r) (== (. G col) c)))))
  (fn editor (params (d (ref Dom))) int (block
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (== (. (index (. (. d nodes) items) i) tag) (. d tInput))) (block
        (return i)))))
    (return (- 1))))
  (fn text (params (d (ref Dom))) string (block
    (return (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) str)))))
  (fn pureModel (params (mem (ref Arena))) _ (block
    (let g _ (call (. Grid new) mem COLS (float 0x4038000000000000) (float 0x4054000000000000)))
    (expr (call (. g sized) ROWS))
    (expr (call ok (&& (&& (&& (&& (== (. g total) (float 0x40af400000000000)) (== (call (. g colX) 3) (float 0x406e000000000000))) (== (call (. g colAt) (float 0x406de00000000000)) 2)) (== (call (. g colAt) (float 0x406e000000000000)) 3)) (== (call (. g colAt) (float 0x40f869f000000000)) 49)) "column widths: total, left edge, hit test"))
    (expr (call ok (&& (&& (== (call (. g rowAt) (- (float 0x4014000000000000))) 0) (== (call (. g rowAt) (float 0x4048000000000000)) 2)) (== (call (. g rowAt) (float 0x41cdcd6500000000)) (- ROWS 1))) "row hit test clamps"))
    (expr (call (. g setWidth) 1 (float 0x405e000000000000)))
    (expr (call ok (&& (== (. g total) (float 0x40af900000000000)) (== (call (. g colX) 2) (float 0x4069000000000000))) "setWidth keeps total and offsets in step"))
    (expr (call (. g move) (- 1) (- 1)))
    (expr (call ok (call at2 (& g) 0 0) "move clamps at the top left"))
    (expr (call (. g jump) 1 0))
    (expr (call ok (call at2 (& g) (- ROWS 1) 0) "Ctrl+Down without data is the last row"))
    (expr (call (. g jump) 0 1))
    (expr (call ok (call at2 (& g) (- ROWS 1) (- COLS 1)) "Ctrl+Right without data is the last column"))
    (expr (call (. g jump) 1 0))
    (expr (call ok (call at2 (& g) (- ROWS 1) (- COLS 1)) "at the edge Ctrl+arrow stays"))
    (expr (call (. g tab) 1))
    (expr (call ok (call at2 (& g) (- ROWS 1) (- COLS 1)) "Tab at the last cell stays"))
    (expr (call (. g homeEnd) (bool false) (bool true)))
    (expr (call ok (call at2 (& g) 0 0) "Ctrl+Home"))
    (= (. g hasFilled) (bool true))
    (= (. g filled) filled)
    (expr (call (. g goto) 10 3))
    (expr (call (. g jump) 1 0))
    (expr (call ok (call at2 (& g) 19 3) "Ctrl+Down inside a run stops at its last cell"))
    (expr (call (. g jump) 1 0))
    (expr (call ok (call at2 (& g) 40 3) "Ctrl+Down from a run end skips blanks to the next data"))
    (expr (call (. g jump) 1 0))
    (expr (call ok (call at2 (& g) (- ROWS 1) 3) "Ctrl+Down past the last data runs to the edge"))
    (expr (call (. g jump) (- 1) 0))
    (expr (call ok (call at2 (& g) 40 3) "Ctrl+Up from the edge stops at the first data above"))))
  (fn (doc "Cell text for copy: \"r{row}c{col}\", with awkward cells when SPECIAL.") cellText (params (r int) (c int)) string (block
    (if SPECIAL (block
      (if (&& (== r 0) (== c 1)) (block
        (return "a\tb")))
      (if (&& (== r 1) (== c 0)) (block
        (return "line1\nline2")))
      (if (&& (== r 1) (== c 1)) (block
        (return "q\"uote\"\"")))
      (if (&& (== r 2) (== c 2)) (block
        (return "")))))
    (expr (call (. CT clear)))
    (expr (call (. CT pushStr) "r"))
    (expr (call (. CT pushInt) r))
    (expr (call (. CT pushStr) "c"))
    (expr (call (. CT pushInt) c))
    (return (call (. CT str)))))
  (fn is (params (data (ref Text)) (ends (ref (gen List int))) (rows (ref (gen List int))) (i int) (j int) (want string)) bool (block
    (return (call same (call (. tsv cell) data ends rows i j) want))))
  (fn tsvTests (params (mem (ref Arena))) _ (block
    (let o _ (call (. Text new) mem))
    (expr (call (. tsv field) (& o) "plain"))
    (expr (call (. o push) 9))
    (expr (call (. tsv field) (& o) "a\tb"))
    (expr (call (. o push) 9))
    (expr (call (. tsv field) (& o) "say \"hi\""))
    (expr (call (. o push) 9))
    (expr (call (. tsv field) (& o) "x\ny"))
    (expr (call ok (call same (call (. o str)) "plain\t\"a\tb\"\t\"say \"\"hi\"\"\"\t\"x\ny\"") "field quotes tab, quote and newline; quotes are doubled"))
    (let data _ (call (. Text new) mem))
    (let ends _ (call (. (type-path List int) new) mem))
    (let rows _ (call (. (type-path List int) new) mem))
    (expr (call ok (&& (call (. tsv parse) "a\tb\r\nc\t\"d\te\"\"f\ng\"\n" (& data) (& ends) (& rows) 1000 1000) (== (. rows len) 2)) "CRLF rows, quoted field with tab, doubled quote and newline; trailing newline ends no row"))
    (expr (call ok (&& (&& (call is (& data) (& ends) (& rows) 0 1 "b") (call is (& data) (& ends) (& rows) 1 0 "c")) (call is (& data) (& ends) (& rows) 1 1 "d\te\"f\ng")) "parsed fields"))
    (expr (call (. tsv parse) "a\t\tb\t\n\nx" (& data) (& ends) (& rows) 1000 1000))
    (expr (call ok (&& (&& (&& (&& (== (. rows len) 3) (== (call (. tsv rowLen) (& rows) 0) 4)) (== (call (. tsv rowLen) (& rows) 1) 1)) (== (call (. tsv rowLen) (& rows) 2) 1)) (== (call (. tsv maxCols) (& rows)) 4)) "empty cells, trailing tab, blank line, ragged rows"))
    (expr (call ok (&& (&& (&& (&& (&& (call is (& data) (& ends) (& rows) 0 1 "") (call is (& data) (& ends) (& rows) 0 2 "b")) (call is (& data) (& ends) (& rows) 0 3 "")) (call is (& data) (& ends) (& rows) 1 0 "")) (call is (& data) (& ends) (& rows) 1 5 "")) (call is (& data) (& ends) (& rows) 9 0 "")) "empty and out-of-range reads"))
    (expr (call (. tsv parse) "" (& data) (& ends) (& rows) 1000 1000))
    (expr (call ok (== (. rows len) 0) "empty text has no rows"))
    (expr (call (. tsv parse) "\"open\tnever closed" (& data) (& ends) (& rows) 1000 1000))
    (expr (call ok (&& (== (. rows len) 1) (call is (& data) (& ends) (& rows) 0 0 "open\tnever closed")) "an unclosed quote runs to the end"))
    (expr (call ok (&& (&& (! (call (. tsv parse) "a\tb\tc\td" (& data) (& ends) (& rows) 2 1000)) (== (. ends len) 2)) (== (. rows len) 1)) "cell cap truncates"))
    (= SPECIAL (bool true))
    (let g _ (call (. Grid new) mem 5 (float 0x4038000000000000) (float 0x4054000000000000)))
    (expr (call (. g sized) 10))
    (expr (call (. g cells) cellText))
    (expr (call (. g goto) 0 0))
    (= (. g ext) (bool true))
    (expr (call (. g goto) 2 2))
    (= (. g ext) (bool false))
    (let t _ (call (. g copyText)))
    (expr (call ok (&& (call (. tsv parse) t (& data) (& ends) (& rows) 1000 100000) (== (. rows len) 3)) "copyText parses back to 3 rows"))
    (for i (.. 0 3) (block
      (for j (.. 0 3) (block
        (expr (call ok (call is (& data) (& ends) (& rows) i j (call cellText i j)) (interp "round trip cell " i "," j)))))))
    (= SPECIAL (bool false))
    (expr (call (. g goto) 4 1))
    (expr (call ok (call same (call (. g copyText)) "r4c1") "no range: the active cell is copied"))
    (expr (call (. g goto) 8 3))
    (expr (call ok (&& (&& (&& (&& (call (. g stagePaste) "1\t2\t3\n4\n5\t6\t7") (== (. g pasteRow) 8)) (== (. g pasteCol) 3)) (== (. g pasteRows) 2)) (== (. g pasteCols) 2)) "paste clips to the grid edges"))
    (expr (call ok (&& (&& (call same (call (. g pasteCell) 0 1) "2") (call same (call (. g pasteCell) 1 0) "4")) (call same (call (. g pasteCell) 1 1) "")) "short row reads empty"))
    (expr (call (. g goto) 1 1))
    (= (. g ext) (bool true))
    (expr (call (. g goto) 3 2))
    (= (. g ext) (bool false))
    (expr (call ok (&& (&& (&& (&& (call (. g stagePaste) "z") (. g pasteFill)) (== (. g pasteRows) 3)) (== (. g pasteCols) 2)) (call same (call (. g pasteCell) 2 1) "z")) "one field fills the range"))
    (expr (call ok (! (call (. g stagePaste) "")) "empty clipboard stages nothing"))
    (expr (call ok (&& (&& (! (call (. tsv parse) "ab\xc3\xa9\tz" (& data) (& ends) (& rows) 1000 3)) (call same (call (. tsv cell) (& data) (& ends) (& rows) 0 0) "ab")) (== (. ends len) 1)) "a 2-byte character straddling the cap is dropped whole"))
    (expr (call ok (|| (! (call (. tsv parse) "ab\xc3\xa9" (& data) (& ends) (& rows) 1000 4)) (call same (call (. tsv cell) (& data) (& ends) (& rows) 0 0) "ab\xc3\xa9")) "a character that fits is kept"))
    (expr (call ok (&& (&& (&& (! (call (. tsv parse) "x\t\"ab\xe2\x82\xaccd\"\ty" (& data) (& ends) (& rows) 1000 3)) (call same (call (. tsv cell) (& data) (& ends) (& rows) 0 1) "ab")) (== (. rows len) 1)) (== (call (. tsv rowLen) (& rows) 0) 2)) "a quoted field cut mid-character ends the paste there"))
    (expr (call (. g sized) 10))
    (expr (call (. g goto) 2 1))
    (= (. g ext) (bool true))
    (expr (call (. g goto) 6 3))
    (= (. g ext) (bool false))
    (= (. g row) 1)
    (= (. g col) 0)
    (expr (call (. g sized) 10))
    (expr (call ok (! (call (. g hasRange))) "writing row/col directly collapses the range"))
    (expr (call (. g goto) 8 0))
    (= (. g ext) (bool true))
    (expr (call (. g goto) 9 1))
    (= (. g ext) (bool false))
    (expr (call (. g sized) 5))
    (expr (call ok (&& (== (. g row) 4) (== (. g ar) 4)) "shrinking the list clamps both corners"))
    (= (. g ext) (bool true))
    (expr (call (. g move) 1 0))
    (= (. g ext) (bool false))
    (expr (call ok (&& (&& (== (. g row) 4) (== (call (. g r0)) 4)) (== (call (. g r1)) 4)) "Shift+Down after the list shrank stays in range"))
    (expr (call (. g sized) 10))
    (let wide _ (call (. Grid new) mem 100 (float 0x4038000000000000) (float 0x4054000000000000)))
    (expr (call (. wide sized) 1000))
    (let blk _ (call (. Text new) mem))
    (for r (.. 0 1000) (block
      (for c (.. 0 100) (block
        (if (> c 0) (block
          (expr (call (. blk push) 9))))
        (expr (call (. blk push) (+ 48 (as (% c 10) u8))))))
      (expr (call (. blk push) 10))))
    (expr (call ok (&& (&& (call (. wide stagePaste) (call (. blk str))) (== (. wide pasteRows) 1000)) (== (. wide pasteCols) 100)) "1000 x 100 paste staged"))
    (let total _ 0)
    (for r (.. 0 1000) (block
      (for c (.. 0 100) (block
        (+= total (. (call (. wide pasteCell) r c) len))))))
    (expr (call ok (== total 100000) "every pasted cell read back"))
    (let u _ (. mem used))
    (for k (.. 0 3) (block
      (expr (call (. wide stagePaste) (call (. blk str))))))
    (expr (call ok (== (. mem used) u) "restaging the same paste allocates nothing"))
    (let big _ (call (. Text new) mem))
    (for i (.. 0 (+ MAX_BYTES 1000)) (block
      (expr (call (. big push) 120))))
    (expr (call (. g goto) 0 0))
    (expr (call ok (&& (&& (call (. g stagePaste) (call (. big str))) (== (call (. (. g pdata) len)) MAX_BYTES)) (== (. g pasteRows) 1)) (interp "one huge field is cut to " (call (. (. g pdata) len)) " bytes")))
    (expr (call (. big clear)))
    (for i (.. 0 (+ MAX_CELLS 5000)) (block
      (expr (call (. big push) 120))
      (expr (call (. big push) 9))))
    (expr (call ok (&& (&& (call (. g stagePaste) (call (. big str))) (== (. (. g pends) len) MAX_CELLS)) (== (. g pasteCols) 5)) (interp "many cells stop at " (. (. g pends) len))))))
  (fn at2 (params (g (ref Grid)) (r int) (c int)) bool (block
    (return (&& (== (. g row) r) (== (. g col) c)))))
  (fn nth (params (d (ref Dom)) (n int) (j int)) int (block
    (let c _ (. (index (. (. d nodes) items) n) first))
    (for i (.. 0 j) (block
      (= c (. (index (. (. d nodes) items) c) next))))
    (return c)))
  (fn headRow (params (d (ref Dom))) int (block
    (let wr _ (. (index (. (. d nodes) items) BOX) parent))
    (return (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) wr) prev)) first))))
  (fn unscroll (params (d (ref Dom))) _ (block
    (expr (call (. d scrollByX) BOX (- (float 0x0000000000000000) (. (index (. (. d nodes) items) BOX) scrollX))))
    (expr (call frames d 2))))
  (fn gripX (params (d (ref Dom)) (hr int) (j int)) f32 (block
    (return (+ (call (. d absX) (. (index (. (. d nodes) items) (call nth d hr j)) last)) (float 0x4010000000000000)))))
  (fn drag (params (d (ref Dom)) (x f32) (y f32) (x2 f32)) _ (block
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) x2 y (bool true) (float 0x0000000000000000)))
    (expr (call frames d 2))
    (expr (call (. d simInput) x2 y (bool false) (float 0x0000000000000000)))
    (expr (call frames d 2))))
  (fn (doc "Stage 6c: frozen first column, header following the scroll, resize by the header edge (a sheet with a header).") frozenResize (params (d (ref Dom)) (mem (ref Arena))) _ (block
    (= FZ (bool true))
    (expr (call (. G freeze) 1))
    (expr (call frames d 3))
    (expr (call (. d focusNode) BOX))
    (expr (call key d "C+Home"))
    (expr (call frames d 3))
    (expr (call ok (&& (&& (&& (&& (== (call (. G fw)) (float 0x4054000000000000)) (call (. G fz) 0)) (! (call (. G fz) 1))) (== (call (. G bx) 0) (float 0x0000000000000000))) (== (call (. G bx) 1) (float 0x0000000000000000))) "frozen width and flags"))
    (let hr _ (call headRow d))
    (let bl _ (call (. d absX) BOX))
    (let hl _ (call (. d absX) (. (index (. (. d nodes) items) hr) parent)))
    (expr (call ok (&& (&& (== bl hl) (== (call (. d absX) (call nth d (call nth d BOX 0) 0)) bl)) (== (call (. d absX) (call nth d hr 0)) hl)) "frozen cell and header cell at the left edge"))
