(file (module paint_batch_test)
  (use j3.game)
  (use j3.game (names Color rgb))
  (use j3.gfx.paint)
  (use j3.io.printLn)
  (use j3.math (names cos sin Vec2))
  (use j3.sys.panic)
  (mod-let CHECKS int _)
  (const W int 1024)
  (const H int 1024)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn poly (params (c Vec2) (r f32) (faces int) (col Color)) _ (block
    (let pts (array 18 f32) (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))
    (for i (.. 0 (+ faces 1)) (block
      (let a _ (/ (* (float 0x401921fb6134ce3e) (call f32 (% i faces))) (call f32 faces)))
      (= (index pts (* i 2)) (+ (. c x) (* r (call cos a))))
      (= (index pts (+ (* i 2) 1)) (+ (. c y) (* r (call sin a))))))
    (expr (call (. paint fillShape) (slice-expr pts 0 (+ (* faces 2) 2)) (+ faces 1) (bool false) col))))
  (fn (doc "Draw calls of a tree: 200 lines, 300 polygons, 200 circles under translate + scale.") treeDraws (params) int (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let before _ (call (. game drawsNow)))
    (expr (call (. paint pushTranslate) (struct-lit Vec2 (field x (float 0x4080000000000000)) (field y (float 0x4080000000000000)))))
    (expr (call (. paint pushScale) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000))) (float 0x3ff6666666666666)))
    (for k (.. 0 200) (block
      (let a _ (/ (* (float 0x401921fb6134ce3e) (call f32 (% k 8))) (float 0x4020000000000000)))
      (let b _ (/ (* (float 0x401921fb6134ce3e) (call f32 (% (+ k 3) 8))) (float 0x4020000000000000)))
      (let ra _ (+ (float 0x403e000000000000) (* (call f32 (/ k 8)) (float 0x4028000000000000))))
      (expr (call (. paint line) (struct-lit Vec2 (field x (* ra (call cos a))) (field y (* ra (call sin a)))) (struct-lit Vec2 (field x (* (+ ra (float 0x404e000000000000)) (call cos b))) (field y (* (+ ra (float 0x404e000000000000)) (call sin b)))) (float 0x4014000000000000) (call rgb 69 90 100)))))
    (for i (.. 0 300) (block
      (let a _ (* (/ (* (float 0x401921fb6134ce3e) (call f32 i)) (float 0x4072c00000000000)) (float 0x401c000000000000)))
      (let c _ (struct-lit Vec2 (field x (* (+ (float 0x403e000000000000) (call f32 i)) (call cos a))) (field y (* (+ (float 0x403e000000000000) (call f32 i)) (call sin a)))))
      (expr (call poly c (float 0x4022000000000000) (+ 4 (% i 5)) (call rgb 255 196 0)))
      (if (== (% i 3) 0) (block
        (expr (call (. paint circle) c (float 0x4014000000000000) (call rgb 16 23 26)))
        (expr (call (. paint circle) c (float 0x4008000000000000) (call rgb 0 200 255)))))))
    (expr (call (. paint popTransform)))
    (expr (call (. paint popTransform)))
    (expr (call (. game p2Flush)))
    (return (- (call (. game drawsNow)) before))))
  (fn (doc "Microseconds to draw 300 lines of length `len` at angle `deg`, GPU included (best of 5).") lineUs (params (len f32) (deg f32)) int (block
    (let finish _ (as (call (. game glProc) "glFinish") (fn-type () _)))
    (let dx _ (* len (call cos (* deg (float 0x3f91df469963e11d)))))
    (let dy _ (* len (call sin (* deg (float 0x3f91df469963e11d)))))
    (let best _ 1000000000)
    (for _rep (.. 0 5) (block
      (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
      (expr (call (. game p2Flush)))
      (expr (call finish))
      (let t _ (call (. game micros)))
      (for k (.. 0 300) (block
        (let o _ (call f32 (% k 10)))
        (expr (call (. paint line) (struct-lit Vec2 (field x (+ (float 0x4010000000000000) o)) (field y (+ (float 0x4010000000000000) o))) (struct-lit Vec2 (field x (+ (+ (float 0x4010000000000000) o) dx)) (field y (+ (+ (float 0x4010000000000000) o) dy))) (float 0x4014000000000000) (struct-lit Color (field r 200) (field g 200) (field b 200) (field a 40))))))
      (expr (call (. game p2Flush)))
      (expr (call finish))
      (let us _ (- (call (. game micros)) t))
      (if (< us best) (block
        (= best us)))))
    (return best)))
  (fn main (params) _ (block
    (expr (call (. game initGlHidden) "paint batch" W H))
    (expr (call treeDraws))
    (let draws _ (call treeDraws))
    (expr (call printLn (interp "tree: " draws " draw(s)")))
    (expr (call ok (== draws 1) "lines, circles and 300 fillShape polygons are one draw"))
    (let pts (array 10 f32) (array-lit (float 0x4059000000000000) (float 0x4059000000000000) (float 0x4072c00000000000) (float 0x4059000000000000) (float 0x4072c00000000000) (float 0x4072c00000000000) (float 0x4059000000000000) (float 0x4072c00000000000) (float 0x4059000000000000) (float 0x4059000000000000)))
    (expr (call (. paint pushShape) 1 (slice-expr pts 0 10) 5 (bool false)))
    (expr (call poly (struct-lit Vec2 (field x (float 0x4069000000000000)) (field y (float 0x4069000000000000))) (float 0x4049000000000000) 6 (call rgb 255 0 0)))
    (expr (call (. paint popShape) 1))
    (expr (call (. game p2Flush)))
    (expr (call ok (bool true) "fillShape inside pushShape(1) runs"))
    (expr (call lineUs (float 0x4096180000000000) (float 0x0000000000000000)))
    (let flat _ (call lineUs (float 0x4096180000000000) (float 0x0000000000000000)))
    (let diag _ (call lineUs (float 0x4096180000000000) (float 0x4046800000000000)))
    (expr (call printLn (interp "300 long lines: horizontal " flat " us, diagonal " diag " us")))
    (expr (call ok (< diag (+ (* flat 4) 2000)) "a diagonal line costs about what a horizontal one of the same length does"))
    (expr (call printLn (interp "paint_batch_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
