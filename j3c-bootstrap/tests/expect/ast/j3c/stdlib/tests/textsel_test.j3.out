(file (module textsel_test)
  (use j3.game (names clipboard setClipboard textWidth))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom (names Dom fontOf isBold))
  (use j3.ui.inputs)
  (use j3.ui.testkit.textNode)
  (use j3.ui.textsel)
  (mod-let CHECKS int _)
  (mod-let MODAL bool _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, input, dialog { font-family: \"T\"; font-size: 14px; } .sel { user-select: text; } .box { background: #223344; padding: 0 3px; } .tb { width: 120px; padding: 4px; border: 1px solid #888888; } .col { display: flex; flex-direction: column; gap: 6px; width: 400px; } dialog { padding: 10px; background: #333333; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) d))
    (let col _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) col "col"))
    (let a _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) a "sel"))
    (expr (call (. d text) "h\xc3\xa9llo w\xc3\xb6rld 123"))
    (expr (call (. d close)))
    (let b _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) b "sel"))
    (expr (call (. d text) "foo, bar"))
    (expr (call (. d close)))
    (let c _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) c "sel"))
    (expr (call (. d text) "ab "))
    (let s _ (call (. d open) 0 (call (. d tag) "span") 1))
    (expr (call (. d cls) s "box"))
    (expr (call (. d text) "cd"))
    (expr (call (. d close)))
    (expr (call (. d text) " ef"))
    (expr (call (. d close)))
    (let t _ (call (. d open) 3 (call (. d tag) "input") 1))
    (expr (call (. d cls) t "tb"))
    (expr (call (. d attrType) t "text"))
    (expr (call (. d attrText) t "boxed"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (if MODAL (block
      (let m _ (call (. d open) 1 (call (. d tag) "dialog") 1))
      (expr (call (. d attrOverlay) m (. dom OV_MODAL)))
      (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "sel"))
      (expr (call (. d text) "in dialog"))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4082c00000000000) (float 0x4079000000000000)))))
  (fn step (params (d (ref Dom)) (x f32) (y f32) (down bool)) _ (block
    (expr (call (. d simInput) x y down (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn (doc "Window x of byte `off` of text node `tn`, and y in its line.") px (params (d (ref Dom)) (tn int) (off int)) f32 (block
    (let owner _ tn)
    (while (< (. (index (. (. d nodes) items) owner) frag0) 0) (block
      (= owner (. (index (. (. d nodes) items) owner) parent))))
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (while (>= f 0) (block
      (let g _ (index (. (. d frags) items) f))
      (if (&& (&& (&& (== (. g kind) 0) (== (. g node) tn)) (>= off (. g start))) (<= off (. g end))) (block
        (let n _ (index (. (. d nodes) items) tn))
        (let whole _ (slice-lit u8 (field ptr (. (. n buf) ptr)) (field len (. n tlen))))
        (let w _ (call textWidth (call fontOf d (. n style)) (slice-expr whole (. g start) off) (call isBold d (. n style))))
        (return (+ (+ (call (. d absX) owner) (. g x)) w))))
      (= f (. g next))))
    (return (- (float 0x3ff0000000000000)))))
  (fn py (params (d (ref Dom)) (tn int)) f32 (block
    (let owner _ tn)
    (while (< (. (index (. (. d nodes) items) owner) frag0) 0) (block
      (= owner (. (index (. (. d nodes) items) owner) parent))))
    (return (+ (+ (call (. d absY) owner) (. (index (. (. d frags) items) (. (index (. (. d nodes) items) owner) frag0)) y)) (float 0x4014000000000000)))))
  (fn (doc "One click at byte `off` of text node `tn` (a little right of the boundary so the pick lands inside).") click (params (d (ref Dom)) (tn int) (off int) (shift bool)) _ (block
    (let x _ (+ (call px d tn off) (float 0x3ff0000000000000)))
    (let y _ (call py d tn))
    (expr (call step d x y (bool false)))
    (if shift (block
      (expr (call (. d simKeys) "" "S+q"))))
    (expr (call step d x y (bool true)))
    (expr (call step d x y (bool false)))))
  (fn away (params (d (ref Dom))) _ (block
    (expr (call step d (float 0x4082700000000000) (float 0x4078600000000000) (bool false)))
    (expr (call step d (float 0x4082700000000000) (float 0x4078600000000000) (bool true)))
    (expr (call step d (float 0x4082700000000000) (float 0x4078600000000000) (bool false)))))
  (fn sel (params (d (ref Dom))) string (block
    (return (call (. textsel selected) d))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 32 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "textsel.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simPrimary) ""))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d fontMissing) 0) "font loaded"))
    (let t1 _ (call textNode (& d) "h\xc3\xa9llo w\xc3\xb6rld 123"))
    (let t2 _ (call textNode (& d) "foo, bar"))
    (let t3 _ (call textNode (& d) "ab "))
    (let t4 _ (call textNode (& d) "cd"))
    (let t5 _ (call textNode (& d) " ef"))
    (expr (call ok (&& (&& (&& (&& (>= t1 0) (>= t2 0)) (>= t3 0)) (>= t4 0)) (>= t5 0)) "text nodes found"))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld") "double click selects the accented word"))
    (expr (call ok (call same (call (. d primary)) "w\xc3\xb6rld") "the settled selection is PRIMARY"))
    (expr (call away (& d)))
    (expr (call ok (! (call (. textsel active) (& d))) "a click elsewhere clears it"))
    (expr (call click (& d) t1 15 (bool false)))
    (expr (call click (& d) t1 15 (bool false)))
    (expr (call ok (call same (call sel (& d)) "123") "double click selects digits"))
    (expr (call away (& d)))
    (expr (call click (& d) t2 1 (bool false)))
    (expr (call click (& d) t2 1 (bool false)))
    (expr (call ok (call same (call sel (& d)) "foo") "double click on a word next to punctuation selects only the word"))
    (expr (call away (& d)))
    (expr (call click (& d) t2 3 (bool false)))
    (expr (call click (& d) t2 3 (bool false)))
    (expr (call ok (call same (call sel (& d)) ",") "double click on punctuation selects the punctuation run"))
    (expr (call away (& d)))
    (expr (call click (& d) t2 4 (bool false)))
    (expr (call click (& d) t2 4 (bool false)))
    (expr (call ok (&& (> (. (call sel (& d)) len) 0) (|| (|| (call same (call sel (& d)) " ") (call same (call sel (& d)) ",")) (call same (call sel (& d)) "bar"))) "double click on the space picks the space run or a neighbour"))
    (expr (call away (& d)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call ok (&& (! (call (. textsel active) (& d))) (== (. (call sel (& d)) len) 0)) "a plain click highlights nothing"))
    (expr (call ok (&& (! (. d selMarked)) (>= (. d selA) 0)) "a collapsed anchor leaves no marks"))
    (= (. (index (. (. d nodes) items) t2) sa) 99)
    (for i (.. 0 5) (block
      (expr (call step (& d) (float 0x4082700000000000) (float 0x4077c00000000000) (bool false)))))
    (expr (call ok (== (. (index (. (. d nodes) items) t2) sa) 99) "idle frames with a collapsed anchor do not walk the nodes"))
    (= (. (index (. (. d nodes) items) t2) sa) (- 1))
    (expr (call click (& d) t1 15 (bool true)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld 1") "Shift+click without a range selects from the clicked point"))
    (expr (call away (& d)))
    (expr (call click (& d) t2 5 (bool false)))
    (expr (call click (& d) t1 7 (bool true)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld 123\nfoo, ") "Shift+click backward from a plain click"))
    (expr (call away (& d)))
    (expr (call click (& d) t1 7 (bool false)))
    (for i (.. 0 40) (block
      (expr (call step (& d) (float 0x4082700000000000) (float 0x4078600000000000) (bool false)))))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call ok (! (call (. textsel active) (& d))) "slow clicks are two single clicks"))
    (expr (call away (& d)))
    (expr (call click (& d) t3 1 (bool false)))
    (expr (call click (& d) t3 1 (bool false)))
    (expr (call click (& d) t3 1 (bool false)))
    (expr (call ok (call same (call sel (& d)) "ab cd ef") "triple click selects the block across a decorated span"))
    (expr (call away (& d)))
    (expr (call click (& d) t4 1 (bool false)))
    (expr (call click (& d) t4 1 (bool false)))
    (expr (call ok (call same (call sel (& d)) "cd") "double click inside a decorated span"))
    (expr (call away (& d)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call click (& d) t1 15 (bool true)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld 1") "shift+click extends within a block"))
    (expr (call away (& d)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call click (& d) t1 7 (bool false)))
    (expr (call click (& d) t2 2 (bool true)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld 123\nfo") "shift+click extends forward across blocks"))
    (expr (call click (& d) t1 3 (bool true)))
    (expr (call ok (call same (call sel (& d)) "llo ") "shift+click backward moves the far end"))
    (expr (call away (& d)))
    (expr (call click (& d) t2 1 (bool false)))
    (expr (call click (& d) t2 1 (bool false)))
    (expr (call click (& d) t1 7 (bool true)))
    (expr (call ok (call same (call sel (& d)) "w\xc3\xb6rld 123") "shift+click backward selects up to the anchor"))
    (expr (call away (& d)))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))
    (expr (call ok (call same (call sel (& d)) "h\xc3\xa9llo w\xc3\xb6rld 123\nfoo, bar\nab cd ef") "Ctrl+A selects all selectable text"))
    (expr (call setClipboard "zz"))
    (let live _ (call same (call clipboard) "zz"))
    (expr (call (. d simKeys) "" "C+c"))
    (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))
    (expr (call ok (|| (! live) (call same (call clipboard) "h\xc3\xa9llo w\xc3\xb6rld 123\nfoo, bar\nab cd ef")) "Ctrl+C copies the Ctrl+A text"))
    (expr (call away (& d)))
    (let tb _ (- 1))
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (== (. (index (. (. d nodes) items) i) tag) (call (. d tag) "input")) (block
        (= tb i)))))
    (expr (call step (& d) (+ (call (. d absX) tb) (float 0x4014000000000000)) (+ (call (. d absY) tb) (float 0x4014000000000000)) (bool false)))
    (expr (call step (& d) (+ (call (. d absX) tb) (float 0x4014000000000000)) (+ (call (. d absY) tb) (float 0x4014000000000000)) (bool true)))
    (expr (call step (& d) (+ (call (. d absX) tb) (float 0x4014000000000000)) (+ (call (. d absY) tb) (float 0x4014000000000000)) (bool false)))
    (expr (call ok (== (. d focus) tb) "input focused"))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call step (& d) (+ (call (. d absX) tb) (float 0x4014000000000000)) (+ (call (. d absY) tb) (float 0x4014000000000000)) (bool false)))
    (expr (call ok (! (call (. textsel active) (& d))) "Ctrl+A in an input does not select page text"))
    (expr (call ok (&& (== (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) tb) edit)) lo)) 0) (== (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) tb) edit)) hi)) 5)) "and selects the input's text"))
    (expr (call away (& d)))
    (= MODAL (bool true))
    (for i (.. 0 12) (block
      (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))
    (expr (call ok (call same (call sel (& d)) "in dialog") "Ctrl+A in a modal selects only the dialog"))
    (= MODAL (bool false))
    (for i (.. 0 30) (block
      (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))))
    (expr (call away (& d)))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))
    (for i (.. 0 4) (block
      (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))))
    (let m0 _ (call (. mem checkpoint)))
    (for i (.. 0 20) (block
      (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))))
    (expr (call ok (call (. textsel active) (& d)) "selection persists across idle frames"))
    (expr (call ok (== (call (. mem checkpoint)) m0) "idle frames with a selection allocate nothing"))
    (expr (call printLn (interp "textsel_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
