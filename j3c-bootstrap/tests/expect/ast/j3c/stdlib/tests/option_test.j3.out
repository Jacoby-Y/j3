(file (module option_test)
  (use j3.memory.Arena)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.math.Vec2)
  (use j3.ui.css (names Css P_COLOR P_FONT_SIZE))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.a11y)
  (use j3.ui.dropdown)
  (use j3.ui.media)
  (use j3.ui.uastyle)
  (mod-let SHOW bool _)
  (mod-let EXTRA bool _)
  (mod-let ALT bool _)
  (mod-let N int _)
  (mod-let WIDTH f32 _)
  (mod-let EXPLICIT bool _)
  (mod-let SEL int _)
  (mod-let OPT int _)
  (mod-let SPAN int _)
  (mod-let VALUE string _)
  (mod-let CHECKS int _)
  (const SHEET string "@font-face { font-family: T; src: url(examples/big_ui_test/assets/font.ttf); } select { font-family: T; width: 180px; height: 30px; --tone: #112233; } select.hot { --tone: #445566; } .piece { color: var(--tone); } select option .name { color: #ff0000;  } select option .name.alt { color: #00ff00; } .icon { width: 14px; height: 14px; } @media (min-width: 500px) { .icon { width: 18px; } }")
  (fn ok (params (b bool) (s string)) _ (block
    (+= CHECKS 1)
    (if (! b) (block
      (expr (call panic s))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x WIDTH) (field y (float 0x4072c00000000000)))))
    (expr (call (. inputs begin) d))
    (if SHOW (block
      (= SEL (call (. d open) 0 (call (. d tag) "select") 1))
      (if (call (. d changed) SEL) (block
        (= VALUE (call (. d strValue) SEL))))
      (expr (call (. d attrText) SEL VALUE))
      (expr (call (. d clsIf) SEL "hot" ALT))
      (for i (.. 0 N) (block
        (let tok _ (call (. d enter) (/ i 4096)))
        (let o _ (call (. d open) (% i 4096) (call (. d tag) "option") 1))
        (expr (call (. d attrDisabled) o (== i 1)))
        (if (== i 0) (block
          (= OPT o)
          (expr (call (. d attrText) o (if-expr EXPLICIT "pear-value" "")))
          (let svg _ (call (. d open) 0 (call (. d tag) "svg") 1))
          (expr (call (. d cls) svg "icon"))
          (expr (call (. d attrMedia) svg (. media M_VIEWBOX) "0 0 10 10"))
          (let path _ (call (. d open) 0 (call (. d tag) "path") 1))
          (expr (call (. d attrMedia) path (. media M_D) (if-expr ALT "M0 0 L10 0 L5 10 Z" "M0 0 L10 10 L0 10 Z")))
          (expr (call (. d attrMedia) path (. media M_FILL) "currentColor"))
          (expr (call (. d close)))
          (expr (call (. d close)))
          (expr (call (. d text) "Red "))
          (= SPAN (call (. d open) 1 (call (. d tag) "span") 1))
          (expr (call (. d cls) SPAN "name"))
          (expr (call (. d clsIf) SPAN "alt" ALT))
          (expr (call (. d styleNum) SPAN 0 "font-size" (if-expr ALT (float 0x4031000000000000) (float 0x402c000000000000))))
          (let piece _ (call (. d open) 0 (call (. d tag) "span") 1))
          (expr (call (. d cls) piece "piece"))
          (expr (call (. d text) (if-expr ALT "Pear" "Apple")))
          (expr (call (. d close)))
          (expr (call (. d close)))
          (if EXTRA (block
            (let small _ (call (. d open) 2 (call (. d tag) "small") 1))
            (expr (call (. d text) " ripe"))
            (expr (call (. d close)))))) (block
          (expr (call (. d attrText) o (if-expr (== i 1) "disabled" "blue")))
          (let span _ (call (. d open) 0 (call (. d tag) "span") 1))
          (expr (call (. d text) (if-expr (== i 1) "Red disabled" "Blue berry")))
          (expr (call (. d close)))))
        (expr (call (. d close)))
        (expr (call (. d leave) tok))))
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. dropdown settle) d))
    (expr (call (. d endFrame)))))
  (fn frames (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call frame d))))))
  (fn click (params (d (ref Dom)) (x f32) (y f32)) _ (block
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frames d 2))))
  (fn key (params (d (ref Dom)) (k string)) _ (block
    (expr (call (. d simKeys) "" k))
    (expr (call frames d 2))))
  (fn label (params (d (ref Dom))) int (block
    (let row _ (. (index (. (. d nodes) items) (. d ptRoot)) first))
    (while (&& (>= row 0) (!= (. (index (. (. d nodes) items) row) pidx) 0)) (block
      (= row (. (index (. (. d nodes) items) row) next))))
    (if (< row 0) (block
      (return (- 1))))
    (return (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) row) first)) next))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 256 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call (. uastyle load) (& css)))
    (expr (call parse (& css) SHEET "option.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= SHOW (bool true))
    (= EXTRA (bool true))
    (= ALT (bool false))
    (= EXPLICIT (bool false))
    (= WIDTH (float 0x4079000000000000))
    (= N 3)
    (= VALUE "Red Apple ripe")
    (expr (call frames (& d) 3))
    (expr (call ok (call same (call (. dom optLabel) (& d) OPT) "Red Apple ripe") "full descendant label"))
    (expr (call ok (call same (call (. dom optValue) (& d) OPT) "Red Apple ripe") "fallback value is full label"))
    (expr (call ok (call same (call (. a11y name) (& d) (& mem) OPT) "Red Apple ripe") "accessible option name includes descendant fragments"))
    (let original _ SPAN)
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call ok (>= (. d ptRoot) 0) "opens custom list"))
    (let lb _ (call label (& d)))
    (let icon _ (. (index (. (. d nodes) items) lb) first))
    (let span _ (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) icon) next)) next))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) icon) tag) (. d tSvg)) (> (. (index (. (. d nodes) items) icon) media) 0)) "SVG mirror has real media"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) span) optionSource) SPAN) (== (. (index (. (. d nodes) items) SPAN) parent) OPT)) "mirror preserves source placement and identity"))
    (expr (call ok (== (. (call (. css get) (. (index (. (. d nodes) items) span) style) P_COLOR) c) 4278190335) "scoped source ancestor selector reaches mirror"))
    (expr (call ok (&& (>= (. (index (. (. d nodes) items) (call label (& d))) h) (float 0x402c000000000000)) (== (. (index (. (. d nodes) items) icon) w) (float 0x402c000000000000))) "visual children participate in layout"))
    (= WIDTH (float 0x4082c00000000000))
    (expr (call frame (& d)))
    (expr (call ok (== (. (index (. (. d nodes) items) icon) w) (float 0x4032000000000000)) "media query resize restyles visual content"))
    (= WIDTH (float 0x4079000000000000))
    (expr (call frame (& d)))
    (expr (call ok (== (. (index (. (. d nodes) items) icon) w) (float 0x402c000000000000)) "resize restores source-scoped icon size"))
    (= ALT (bool true))
    (= EXTRA (bool false))
    (expr (call frame (& d)))
    (expr (call ok (&& (== SPAN original) (call same (call (. dom optLabel) (& d) OPT) "Red Pear")) "live text and conditional removal retain source identity"))
    (expr (call ok (== (. (call (. css get) (. (index (. (. d nodes) items) span) style) P_COLOR) c) 16711935) "class change reaches mirror same frame"))
    (let child _ (. (index (. (. d nodes) items) span) first))
    (expr (call ok (&& (== (. (call (. css get) (. (index (. (. d nodes) items) child) style) P_COLOR) c) 1146447615) (== (. (call (. css get) (. (index (. (. d nodes) items) child) style) P_FONT_SIZE) f) (float 0x4031000000000000))) "changed ancestor custom vars and inline inherited size reach nested mirror"))
    (expr (call ok (&& (call same (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) span) first)) first)) "Pear") (< (. (index (. (. d nodes) items) span) next) 0)) "mirror text and conditional removal update same frame"))
    (expr (call ok (== (. (call (. css get) (. (index (. (. d nodes) items) span) style) P_FONT_SIZE) f) (float 0x4031000000000000)) "inline font-size reaches owned mirror style"))
    (= EXPLICIT (bool true))
    (expr (call frame (& d)))
    (expr (call ok (call same (call (. dom optValue) (& d) OPT) "pear-value") "dynamic explicit value overrides full label"))
    (expr (call click (& d) (+ (call (. d absX) icon) (float 0x4000000000000000)) (+ (call (. d absY) icon) (float 0x4000000000000000))))
    (expr (call ok (&& (< (. d ptRoot) 0) (call same VALUE "pear-value")) "clicking visual descendant selects updated explicit value"))
    (= EXPLICIT (bool false))
    (expr (call frame (& d)))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call key (& d) "End"))
    (expr (call key (& d) "Enter"))
    (expr (call ok (call same VALUE "blue") "keyboard preserves explicit value"))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call (. d simKeys) "Red" ""))
    (expr (call frames (& d) 2))
    (expr (call key (& d) "Enter"))
    (expr (call ok (call same VALUE "Red Pear") "typeahead uses full label and skips disabled option"))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call (. css reset)))
    (expr (call (. uastyle load) (& css)))
    (expr (call parse (& css) SHEET "option.css" 1))
    (expr (call (. d restyle)))
    (expr (call frames (& d) 3))
    (= lb (call label (& d)))
    (= icon (. (index (. (. d nodes) items) lb) first))
    (= span (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) icon) next)) next))
    (expr (call ok (&& (== (. (call (. css get) (. (index (. (. d nodes) items) span) style) P_COLOR) c) 16711935) (== (. (call (. css get) (. (index (. (. d nodes) items) span) style) P_FONT_SIZE) f) (float 0x4031000000000000))) "CSS reload restores class and inline styles"))
    (expr (call ok (== (. (call (. css get) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) span) first)) style) P_COLOR) c) 1146447615) "CSS reload preserves inherited custom vars"))
    (let laid _ (. d laid))
    (let rest _ (. d restyled))
    (let used _ (. mem used))
    (expr (call frames (& d) 300))
    (expr (call ok (&& (&& (== (. d laid) laid) (== (. d restyled) rest)) (== (. mem used) used)) "open steady frames have zero layouts/restyles/arena growth"))
    (expr (call key (& d) "Escape"))
    (for i (.. 0 20) (block
      (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
      (expr (call key (& d) "Escape"))))
    (= used (. mem used))
    (for i (.. 0 1000) (block
      (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
      (expr (call key (& d) "Escape"))))
    (expr (call printLn (interp "reopen growth " (- (. mem used) used) ", dyns " (. (. d dyns) len) ", free " (. (. d dynFree) len) ", media " (. (. d media) len) ", nodes " (. (. d nodes) len))))
    (expr (call ok (== (. mem used) used) "1000 custom reopen cycles allocate nothing after warmup"))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (= SHOW (bool false))
    (expr (call frames (& d) 2))
    (expr (call ok (< (. d ptRoot) 0) "owner removal frees mirror popup"))
    (= SHOW (bool true))
    (= N 5000)
    (expr (call frames (& d) 3))
    (let base _ (call (. d count)))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call ok (< (- (call (. d count)) base) 150) "5000 source options keep bounded real visual rows"))
    (expr (call key (& d) "End"))
    (expr (call frames (& d) 3))
    (expr (call ok (< (- (call (. d count)) base) 150) "scrolling retains bounded mirrors"))
    (expr (call key (& d) "Escape"))
    (= N 3)
    (expr (call frames (& d) 3))
    (expr (call click (& d) (float 0x4044000000000000) (float 0x402e000000000000)))
    (expr (call frames (& d) 2))
    (expr (call ok (>= (call label (& d)) 0) "custom content reopens after large list and owner recycle"))
    (expr (call printLn (interp "option_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
