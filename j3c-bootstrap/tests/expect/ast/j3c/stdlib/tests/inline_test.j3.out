(file (module inline_test)
  (use j3.game (names fontLine loadFont textWidth Font))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (mod-let ITEMS (array 8 int) _)
  (mod-let WPX int _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .n100 { width: 100px; } .n180 { width: 180px; } .pill { padding: 2px 6px; border: 1px solid #ff0000; background: #0000ff; } .pill:hover { background: #00ff00; } .o { padding: 0 4px; background: #888888; } .i { padding: 0 3px; background: #444444; } .m { margin: 0 10px; background: #888888; } .tag::before { content: \"[\"; padding: 0 2px; background: #00aa00; border-radius: 3px; } .clamp { line-clamp: 1; } .just { text-align: justify; } .nob { background: #888888; } .ib { position: absolute; } .fl { display: flex; width: 400px; } .fl30 { display: flex; width: 30px; } .padt { padding-top: 10px; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff tol) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b)))
      (expr (call panic msg))))))
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (const LONG string "alpha beta gamma delta epsilon zeta eta theta")
  (fn (doc "kind 0: `ab <pill>Rare</pill> cd`; 1: a pill alone with long text; 2: `<o><i>xyz</i></o>`; 3: `<tag>Rare</tag>`;\n4: margin only; 5: pill in the middle of long text; 6: plain (no box).") frame (params (d (ref Dom)) (kind int) (cls string) (spanCls string)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let outer _ (- 1))
    (if (== kind 7) (block
      (= outer (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) outer "padt"))
      (= (index ITEMS 3) outer)))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) c "box"))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) c (if-expr (> (. cls len) 4) "n100" cls)))))
    (if (call same cls "n100 clamp") (block
      (expr (call (. d cls) c "clamp"))) (block
      (if (call same cls "n100 just") (block
        (expr (call (. d cls) c "just"))))))
    (= (index ITEMS 0) c)
    (if (call same cls "title") (block
      (expr (call (. d attrTitle) c "tip"))))
    (if (== kind 0) (block
      (expr (call (. d text) "ab "))
      (let s _ (call (. d open) 0 (call (. d tag) "span") 1))
      (expr (call (. d cls) s spanCls))
      (= (index ITEMS 1) s)
      (expr (call (. d text) "Rare"))
      (expr (call (. d close)))
      (expr (call (. d text) " cd"))) (block
      (if (== kind 1) (block
        (let s1 _ (call (. d open) 0 (call (. d tag) "span") 1))
        (expr (call (. d cls) s1 spanCls))
        (= (index ITEMS 1) s1)
        (expr (call (. d text) LONG))
        (expr (call (. d close)))) (block
        (if (== kind 2) (block
          (let o _ (call (. d open) 0 (call (. d tag) "span") 1))
          (expr (call (. d cls) o "o"))
          (= (index ITEMS 1) o)
          (let i _ (call (. d open) 0 (call (. d tag) "span") 1))
          (expr (call (. d cls) i "i"))
          (= (index ITEMS 2) i)
          (expr (call (. d text) "xyz"))
          (expr (call (. d close)))
          (expr (call (. d close)))) (block
          (if (== kind 3) (block
            (let s3 _ (call (. d open) 0 (call (. d tag) "span") 1))
            (expr (call (. d cls) s3 "tag"))
            (= (index ITEMS 1) s3)
            (expr (call (. d text) "Rare"))
            (expr (call (. d close)))) (block
            (if (== kind 4) (block
              (expr (call (. d text) "ab"))
              (let s4 _ (call (. d open) 0 (call (. d tag) "span") 1))
              (expr (call (. d cls) s4 "m"))
              (= (index ITEMS 1) s4)
              (expr (call (. d text) "cd"))
              (expr (call (. d close)))
              (expr (call (. d text) "ef"))) (block
              (if (== kind 5) (block
                (expr (call (. d text) "alpha beta "))
                (let s5 _ (call (. d open) 0 (call (. d tag) "span") 1))
                (expr (call (. d cls) s5 spanCls))
                (= (index ITEMS 1) s5)
                (expr (call (. d text) "gamma delta epsilon zeta"))
                (expr (call (. d close)))
                (expr (call (. d text) " eta theta iota"))) (block
                (if (== kind 7) (block
                  (expr (call (. d text) "ab "))
                  (let s7 _ (call (. d open) 0 (call (. d tag) "span") 1))
                  (expr (call (. d cls) s7 "pill"))
                  (= (index ITEMS 1) s7)
                  (expr (call (. d text) "Rare"))
                  (expr (call (. d close)))) (block
                  (if (== kind 8) (block
                    (let ib _ (call (. d open) 0 (call (. d tag) "div") 1))
                    (expr (call (. d cls) ib "ib"))
                    (= (index ITEMS 2) ib)
                    (let s8 _ (call (. d open) 0 (call (. d tag) "span") 1))
                    (expr (call (. d cls) s8 "pill"))
                    (= (index ITEMS 1) s8)
                    (expr (call (. d text) "Rare"))
                    (expr (call (. d close)))
                    (expr (call (. d close)))) (block
                    (if (== kind 9) (block
                      (let fi _ (call (. d open) 0 (call (. d tag) "div") 1))
                      (= (index ITEMS 2) fi)
                      (let s9 _ (call (. d open) 0 (call (. d tag) "span") 1))
                      (expr (call (. d cls) s9 "pill"))
                      (= (index ITEMS 1) s9)
                      (expr (call (. d text) "Rare"))
                      (expr (call (. d close)))
                      (expr (call (. d close)))) (block
                      (if (== kind 10) (block
                        (expr (call (. d styleStr) c 0 "width" (interp WPX "px")))
                        (expr (call (. d text) "alpha beta "))
                        (let sa _ (call (. d open) 0 (call (. d tag) "span") 1))
                        (expr (call (. d cls) sa "pill"))
                        (= (index ITEMS 1) sa)
                        (expr (call (. d text) "gamma"))
                        (expr (call (. d close)))) (block
                        (expr (call (. d text) "ab "))
                        (let s6 _ (call (. d open) 0 (call (. d tag) "span") 1))
                        (= (index ITEMS 1) s6)
                        (expr (call (. d text) "Rare"))
                        (expr (call (. d close)))))))))))))))))))))))
    (if (== kind 7) (block
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn nbox (params (d (ref Dom)) (owner int)) int (block
    (let n _ 0)
    (let f _ (. (index (. (. d nodes) items) owner) box0))
    (while (>= f 0) (block
      (+= n 1)
      (= f (. (index (. (. d boxes) items) f) next))))
    (return n)))
  (fn boxN (params (d (ref Dom)) (owner int) (k int)) Frag (block
    (let f _ (. (index (. (. d nodes) items) owner) box0))
    (while (> k 0) (block
      (= f (. (index (. (. d boxes) items) f) next))
      (-= k 1)))
    (return (index (. (. d boxes) items) f))))
  (fn (doc "The k-th text fragment of `owner`.") fragN (params (d (ref Dom)) (owner int) (k int)) Frag (block
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (while (> k 0) (block
      (= f (. (index (. (. d frags) items) f) next))
      (-= k 1)))
    (return (index (. (. d frags) items) f))))
  (fn nfrag (params (d (ref Dom)) (owner int)) int (block
    (let n _ 0)
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (while (>= f 0) (block
      (+= n 1)
      (= f (. (index (. (. d frags) items) f) next))))
    (return n)))
  (fn testSingle (params (mem (ref Arena)) (css (ref Css)) (font Font)) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call frame (& d) 0 "" "pill"))
    (let c _ (index ITEMS 0))
    (let lh _ (call f32 (call fontLine font)))
    (expr (call ok (== (call nbox (& d) c) 1) "one box for a one-line span"))
    (let b _ (call boxN (& d) c 0))
    (let rare _ (call fragN (& d) c 1))
    (expr (call ok (== (. (index (. (. d nodes) items) (. rare node)) parent) (index ITEMS 1)) "the second fragment is the span's text"))
    (expr (call near (. b x) (- (. rare x) (float 0x401c000000000000)) (float 0x3f847ae147ae147b) "box starts padding + border before the text"))
    (expr (call near (. b w) (+ (. rare w) (float 0x402c000000000000)) (float 0x3f847ae147ae147b) "box is text + 2 x (padding 6 + border 1) wide"))
    (expr (call near (. b y) (- (. rare y) (float 0x4008000000000000)) (float 0x3f847ae147ae147b) "box top is padding 2 + border 1 above the text"))
    (expr (call near (. b ap) (+ lh (float 0x4018000000000000)) (float 0x3f847ae147ae147b) "box height is the line + vertical padding and border"))
    (expr (call ok (&& (&& (== (. b node) (index ITEMS 1)) (== (. b start) 1)) (== (. b end) 1)) "a one-line box is both first and last"))
    (let cd _ (call fragN (& d) c 2))
    (expr (call near (- (. cd x) (+ (. b x) (. b w))) (call textWidth font (call bytes " ") (bool false)) (float 0x3fe3333333333333) "text after the box follows its right edge plus the space"))
    (expr (call near (. (index (. (. d nodes) items) c) h) lh (float 0x3f847ae147ae147b) "vertical padding and border do not change the line height"))
    (let plain _ (call (. Dom new) mem css))
    (expr (call (. plain setFrameMs) (float 0x4030000000000000)))
    (expr (call (. plain simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& plain) 6 "" ""))
    (expr (call frame (& plain) 6 "" ""))
    (expr (call ok (== (call nbox (& plain) (index ITEMS 0)) 0) "a span with no decoration has no box"))
    (let w0 _ (. (call fragN (& plain) (index ITEMS 0) 1) x))
    (expr (call near (- (. rare x) w0) (float 0x401c000000000000) (float 0x3fe3333333333333) "the left edge pushes the text right"))
    (let m _ (call (. Dom new) mem css))
    (expr (call (. m setFrameMs) (float 0x4030000000000000)))
    (expr (call (. m simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& m) 4 "" ""))
    (expr (call frame (& m) 4 "" ""))
    (let ab _ (call fragN (& m) (index ITEMS 0) 0))
    (let cdm _ (call fragN (& m) (index ITEMS 0) 1))
    (let ef _ (call fragN (& m) (index ITEMS 0) 2))
    (expr (call near (- (. cdm x) (+ (. ab x) (. ab w))) (float 0x4024000000000000) (float 0x3fe3333333333333) "margin-left of a span pushes its text"))
    (expr (call near (- (. ef x) (+ (. cdm x) (. cdm w))) (float 0x4024000000000000) (float 0x3fe3333333333333) "margin-right pushes what follows"))
    (let mb _ (call boxN (& m) (index ITEMS 0) 0))
    (expr (call near (. mb x) (. cdm x) (float 0x3f847ae147ae147b) "the box excludes the margin"))
    (expr (call near (. mb w) (. cdm w) (float 0x3f847ae147ae147b) "and has no padding"))
    (expr (call (. d simInput) (+ (. b x) (float 0x4000000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call ok (== (. d hover) (index ITEMS 1)) "the pointer over the span's padding hovers the span"))
    (let sty _ (. (index (. (. d nodes) items) (index ITEMS 1)) style))
    (expr (call (. d simInput) (- (. b x) (float 0x4008000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call ok (== (. d hover) c) "left of the box hovers the block"))
    (expr (call ok (!= (. (index (. (. d nodes) items) (index ITEMS 1)) style) sty) "the :hover rule left the span's style"))
    (expr (call (. d simInput) (- (+ (. b x) (. b w)) (float 0x3ff0000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call frame (& d) 0 "" "pill"))
    (expr (call ok (== (. d hover) (index ITEMS 1)) "the right border hovers the span"))
    (let m2 _ (call (. Dom new) mem css))
    (expr (call (. m2 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. m2 simInput) (+ (. b x) (float 0x4000000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& m2) 0 "" "pill"))
    (expr (call frame (& m2) 0 "" "pill"))
    (expr (call (. m2 simInput) (+ (. b x) (float 0x4018000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& m2) 0 "" "pill"))
    (expr (call ok (&& (call (. m2 mouseMove) (index ITEMS 0)) (== (. m2 hover) (index ITEMS 1))) "mouseMove on the block fires over its span"))
    (expr (call (. m2 simInput) (+ (. b x) (float 0x4018000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& m2) 0 "" "pill"))
    (expr (call ok (&& (call (. m2 mouseDown) (index ITEMS 0)) (call (. m2 mouseDown) (index ITEMS 1))) "mouseDown on the block fires for a press on its span"))
    (expr (call (. m2 simInput) (+ (. b x) (float 0x4018000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& m2) 0 "" "pill"))
    (expr (call ok (call (. m2 mouseUp) (index ITEMS 0)) "mouseUp on the block fires for a release on its span"))
    (let t _ (call (. Dom new) mem css))
    (expr (call (. t setFrameMs) (float 0x4030000000000000)))
    (expr (call (. t simInput) (+ (. b x) (float 0x4000000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& t) 0 "title" "pill"))
    (expr (call frame (& t) 0 "title" "pill"))
    (expr (call ok (&& (== (. t hover) (index ITEMS 1)) (== (. t tipNode) (index ITEMS 0))) "the block's title is the tooltip of its span's padding"))
    (let l0 _ (. d laid))
    (let s0 _ (. d restyled))
    (let n0 _ (. (. d nodes) len))
    (let bx0 _ (. (. d boxes) len))
    (let fr0 _ (. (. d frags) len))
    (for i (.. 0 30) (block
      (expr (call frame (& d) 0 "" "pill"))))
    (expr (call ok (&& (&& (&& (&& (== (. d laid) l0) (== (. d restyled) s0)) (== (. (. d nodes) len) n0)) (== (. (. d boxes) len) bx0)) (== (. (. d frags) len) fr0)) "steady frames: no layout, restyle or allocation"))))
  (fn testWrap (params (mem (ref Arena)) (css (ref Css)) (font Font)) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 1 "n100" "pill"))
    (expr (call frame (& d) 1 "n100" "pill"))
    (let c _ (index ITEMS 0))
    (let nb _ (call nbox (& d) c))
    (expr (call ok (>= nb 3) "a wrapped span has a box per line"))
    (let b0 _ (call boxN (& d) c 0))
    (let b1 _ (call boxN (& d) c 1))
    (let bl _ (call boxN (& d) c (- nb 1)))
    (expr (call ok (&& (== (. b0 start) 1) (== (. b0 end) 0)) "first piece: left edge only"))
    (expr (call ok (&& (== (. b1 start) 0) (== (. b1 end) (if-expr (== nb 2) 1 0))) "middle piece: no edges"))
    (expr (call ok (&& (== (. bl start) 0) (== (. bl end) 1)) "last piece: right edge only"))
    (expr (call near (. b0 x) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "first piece starts at the line start"))
    (expr (call near (. bl x) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "later pieces start at the line start (no left padding)"))
    (expr (call ok (&& (> (. b1 y) (+ (. b0 y) (float 0x4024000000000000))) (> (. bl y) (- (. b1 y) (float 0x3f847ae147ae147b)))) "pieces sit on successive lines"))
    (let lastF _ (call fragN (& d) c (- (call nfrag (& d) c) 1)))
    (expr (call near (+ (. bl x) (. bl w)) (+ (+ (. lastF x) (. lastF w)) (float 0x401c000000000000)) (float 0x3f847ae147ae147b) "the last piece ends 7px past the last word"))
    (let firstLast _ (call fragN (& d) c 0))
    (let k _ 0)
    (while (&& (== (. (call fragN (& d) c (+ k 1)) y) (. firstLast y)) (< (+ k 1) (- (call nfrag (& d) c) 1))) (block
      (+= k 1)))
    (let fl _ (call fragN (& d) c k))
    (expr (call near (+ (. b0 x) (. b0 w)) (+ (. fl x) (. fl w)) (float 0x3f847ae147ae147b) "a wrapped line's piece ends at its last word"))
    (expr (call near (. (call fragN (& d) c 0) x) (float 0x401c000000000000) (float 0x3f847ae147ae147b) "first word is 7px in"))
    (expr (call (. d simInput) (+ (. b1 x) (float 0x4000000000000000)) (+ (. b1 y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 1 "n100" "pill"))
    (expr (call frame (& d) 1 "n100" "pill"))
    (expr (call ok (== (. d hover) (index ITEMS 1)) "a click on any line's piece targets the span"))
    (let lh _ (call f32 (call fontLine font)))
    (expr (call near (. (index (. (. d nodes) items) c) h) (* lh (call f32 nb)) (float 0x3f847ae147ae147b) "padding does not grow wrapped lines"))
    (= d (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 1 "n100 clamp" "pill"))
    (expr (call frame (& d) 1 "n100 clamp" "pill"))
    (expr (call ok (== (call nbox (& d) c) 1) "line-clamp: one piece, the cut-off lines have none"))
    (let cb _ (call boxN (& d) c 0))
    (expr (call ok (&& (== (. cb start) 1) (== (. cb end) 0)) "the clamped piece keeps no right edge"))
    (= d (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 1 "n100 just" "nob"))
    (expr (call frame (& d) 1 "n100 just" "nob"))
    (let j0 _ (call boxN (& d) c 0))
    (expr (call near (+ (. j0 x) (. j0 w)) (float 0x4059000000000000) (float 0x3fe0000000000000) "justify: the piece spans the stretched line"))
    (= d (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 5 "n180" "pill"))
    (expr (call frame (& d) 5 "n180" "pill"))
    (expr (call ok (>= (call nbox (& d) c) 2) "a span in the middle of the text wraps into pieces"))
    (let m0 _ (call boxN (& d) c 0))
    (expr (call ok (&& (== (. m0 start) 1) (> (. m0 x) (float 0x0000000000000000))) "the first piece starts after the preceding words"))))
  (fn testEdges (params (mem (ref Arena)) (css (ref Css)) (font Font)) _ (block
    (let w0 _ (+ (+ (call textWidth font (call bytes "alpha beta ") (bool false)) (float 0x401c000000000000)) (call textWidth font (call bytes "gamma") (bool false))))
    (= WPX (+ (call int w0) 3))
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 10 "" ""))
    (expr (call frame (& d) 10 "" ""))
    (let c _ (index ITEMS 0))
    (let lh _ (call f32 (call fontLine font)))
    (expr (call ok (> (. (index (. (. d nodes) items) c) h) (* lh (float 0x3ff8000000000000))) "the last word wraps when its closing edge would overflow"))
    (let b _ (call boxN (& d) c (- (call nbox (& d) c) 1)))
    (expr (call ok (<= (+ (. b x) (. b w)) (+ (call f32 WPX) (float 0x3f847ae147ae147b))) "the pill ends inside the line"))
    (= WPX (+ (call int w0) 8))
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& e) 10 "" ""))
    (expr (call frame (& e) 10 "" ""))
    (expr (call near (. (index (. (. e nodes) items) (index ITEMS 0)) h) lh (float 0x3f847ae147ae147b) "with room for the edge it stays on one line"))
    (let rare _ (call textWidth font (call bytes "Rare") (bool false)))
    (let f1 _ (call (. Dom new) mem css))
    (expr (call (. f1 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. f1 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& f1) 8 "" ""))
    (expr (call frame (& f1) 8 "" ""))
    (expr (call near (. (index (. (. f1 nodes) items) (index ITEMS 2)) w) (+ rare (float 0x402c000000000000)) (float 0x3fe3333333333333) "absolute (shrink-to-fit) width: text + both edges"))
    (let f2 _ (call (. Dom new) mem css))
    (expr (call (. f2 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. f2 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& f2) 9 "fl" ""))
    (expr (call frame (& f2) 9 "fl" ""))
    (expr (call near (. (index (. (. f2 nodes) items) (index ITEMS 2)) w) (+ rare (float 0x402c000000000000)) (float 0x3fe3333333333333) "flex item width: text + both edges"))
    (let f3 _ (call (. Dom new) mem css))
    (expr (call (. f3 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. f3 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& f3) 9 "fl30" ""))
    (expr (call frame (& f3) 9 "fl30" ""))
    (expr (call near (. (index (. (. f3 nodes) items) (index ITEMS 2)) w) (+ rare (float 0x402c000000000000)) (float 0x3fe3333333333333) "min-content of a flex item holds the word and both edges"))
    (let g _ (call (. Dom new) mem css))
    (expr (call (. g setFrameMs) (float 0x4030000000000000)))
    (expr (call (. g simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& g) 7 "" ""))
    (expr (call frame (& g) 7 "" ""))
    (let gb _ (call boxN (& g) (index ITEMS 0) 0))
    (let top _ (+ (call (. g absY) (index ITEMS 0)) (. gb y)))
    (expr (call ok (< top (- (call (. g absY) (index ITEMS 0)) (float 0x3ff0000000000000))) "the box starts above its block"))
    (expr (call (. g simInput) (+ (+ (call (. g absX) (index ITEMS 0)) (. gb x)) (float 0x4008000000000000)) (+ top (float 0x3ff0000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& g) 7 "" ""))
    (expr (call frame (& g) 7 "" ""))
    (expr (call ok (== (. g hover) (index ITEMS 1)) "a pill is hit where it sticks out of its block"))))
  (fn testNested (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 2 "" ""))
    (expr (call frame (& d) 2 "" ""))
    (let c _ (index ITEMS 0))
    (expr (call ok (== (call nbox (& d) c) 2) "two nested boxes"))
    (let o _ (call boxN (& d) c 0))
    (let i _ (call boxN (& d) c 1))
    (expr (call ok (&& (== (. o node) (index ITEMS 1)) (== (. i node) (index ITEMS 2))) "the outer box comes first (painted under the inner)"))
    (expr (call near (. i x) (+ (. o x) (float 0x4010000000000000)) (float 0x3f847ae147ae147b) "inner starts after the outer padding"))
    (expr (call near (. o w) (+ (. i w) (float 0x4020000000000000)) (float 0x3f847ae147ae147b) "outer is the inner plus its own padding"))
    (expr (call near (. i w) (+ (. (call fragN (& d) c 0) w) (float 0x4018000000000000)) (float 0x3f847ae147ae147b) "inner is the text plus its padding"))
    (expr (call (. d simInput) (+ (. i x) (float 0x3ff0000000000000)) (+ (. i y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 2 "" ""))
    (expr (call frame (& d) 2 "" ""))
    (expr (call ok (== (. d hover) (index ITEMS 2)) "the innermost box takes the pointer"))
    (expr (call (. d simInput) (+ (. o x) (float 0x3ff0000000000000)) (+ (. o y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 2 "" ""))
    (expr (call frame (& d) 2 "" ""))
    (expr (call ok (== (. d hover) (index ITEMS 1)) "the outer padding hovers the outer span"))))
  (fn testPseudo (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 3 "" ""))
    (expr (call frame (& d) 3 "" ""))
    (let c _ (index ITEMS 0))
    (expr (call ok (== (call nbox (& d) c) 1) "the ::before pill is a box"))
    (let b _ (call boxN (& d) c 0))
    (expr (call ok (== (. (index (. (. d nodes) items) (. b node)) pe) 1) "it belongs to the ::before node"))
    (expr (call ok (&& (&& (> (. b w) (float 0x4010000000000000)) (== (. b start) 1)) (== (. b end) 1)) "pill is the bracket plus 2 x 2px padding"))
    (expr (call (. d simInput) (+ (. b x) (float 0x3ff0000000000000)) (+ (. b y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 3 "" ""))
    (expr (call frame (& d) 3 "" ""))
    (expr (call ok (== (. d hover) (index ITEMS 1)) "the pill answers for its host span"))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) 3 "" ""))
    (expr (call frame (& d) 3 "" ""))
    (let l0 _ (. d laid))
    (let s0 _ (. d restyled))
    (let n0 _ (. (. d nodes) len))
    (let bx0 _ (. (. d boxes) len))
    (for i (.. 0 30) (block
      (expr (call frame (& d) 3 "" ""))))
    (expr (call ok (&& (&& (&& (== (. d laid) l0) (== (. d restyled) s0)) (== (. (. d nodes) len) n0)) (== (. (. d boxes) len) bx0)) "steady pill frames cost nothing"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (let font _ (call loadFont (. (index (. (. css fonts) items) 0) path) 16))
    (expr (call testSingle (& mem) (& css) font))
    (expr (call testWrap (& mem) (& css) font))
    (expr (call testEdges (& mem) (& css) font))
    (expr (call testNested (& mem) (& css)))
    (expr (call testPseudo (& mem) (& css)))
    (expr (call printLn (interp "inline_test: " CHECKS " checks passed"))))))
