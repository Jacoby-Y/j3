(file (module stacking_test)
  (use j3.game)
  (use j3.game.Color)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom OV_POPOVER))
  (use j3.ui.sticky)
  (mod-let CHECKS int _)
  (const W int 1340)
  (const H int 260)
  (const (doc "Scenario `k` sits in the 120 px cell at `130 * k` (`.sc` is a context of its own, so the scenarios never meet).") SHEET string ".stage { display: block; width: 1340px; height: 260px; } .sc { position: absolute; top: 0; width: 120px; height: 120px; z-index: 0; } .box { position: absolute; } .k0 { left: 0; } .k1 { left: 130px; } .k2 { left: 260px; } .k3 { left: 390px; } .k4 { left: 520px; } .k5 { left: 650px; } .k6 { left: 780px; } .k7 { left: 910px; } .k8 { left: 1040px; } .k9 { left: 1170px; } .red { background: #ff0000; } .green { background: #00ff00; } .blue { background: #0000ff; } .yellow { background: #ffff00; } .gray { background: #888888; } .pink { background: #ff00ff; } .c1 { left: 0; top: 0; width: 70px; height: 70px; z-index: 1; } .inn { left: 30px; top: 30px; width: 70px; height: 70px; z-index: 9999; } .c2 { left: 50px; top: 0; width: 70px; height: 70px; z-index: 2; } .pb { left: 0; top: 0; width: 100px; height: 100px; z-index: 0; } .negc { left: 20px; top: 20px; width: 60px; height: 60px; z-index: -1; } .flowc { display: block; margin: 40px 0 0 40px; width: 30px; height: 30px; } .oc { left: 0; top: 0; width: 100px; height: 100px; opacity: 0.999; } .tc { left: 0; top: 0; width: 100px; height: 100px; transform: translate(1px, 0); } .ic { left: 0; top: 0; width: 100px; height: 100px; isolation: isolate; } .ci { left: 0; top: 0; width: 70px; height: 70px; z-index: 5; } .cs { left: 40px; top: 40px; width: 60px; height: 60px; z-index: 3; } .fc { left: 0; top: 0; width: 60px; height: 60px; overflow: hidden; } .fx { position: fixed; left: 690px; top: 200px; width: 30px; height: 30px; } .hi { left: 0; top: 0; width: 70px; height: 70px; z-index: 99999; } .pop { width: 50px; height: 50px; } .row { position: absolute; left: 0; top: 0; display: flex; width: 120px; height: 60px; } .it { width: 50px; height: 50px; margin-right: -30px; } .frow { position: absolute; left: 0; top: 0; display: flex; width: 120px; height: 60px; } .fi { width: 50px; height: 50px; margin-right: -30px; } .fz { z-index: 2; } .tr1 { left: 0; top: 80px; width: 20px; height: 20px; color: #000000; transition: color 10s linear; } .tr2 { left: 30px; top: 80px; width: 20px; height: 20px; opacity: 1; transition: opacity 10s linear; } .tr1.on { color: #ffffff; } .tr2.on { opacity: 0.2; } .z3 { z-index: 3; } .pe1 { left: 0; top: 0; width: 70px; height: 70px; z-index: 1; } .pe2 { left: 20px; top: 20px; width: 70px; height: 70px; z-index: 2; pointer-events: none; } .k10 { left: 0; top: 130px; } .k11 { left: 130px; top: 130px; } .k12 { left: 260px; top: 130px; } .k13 { left: 390px; top: 130px; } .k14 { left: 520px; top: 130px; } .k15 { left: 1040px; top: 130px; } .s2 { display: block; width: 60px; height: 60px; overflow: auto; } .rel { position: relative; display: block; width: 20px; height: 20px; } .md { left: 0; top: 20px; width: 120px; height: 80px; z-index: 100; } .ss { position: absolute; left: 0; top: 0; width: 60px; height: 60px; overflow: auto; } .st { position: sticky; top: 0; display: block; width: 40px; height: 10px; } .sb { position: absolute; left: 0; top: 0; width: 60px; height: 60px; overflow: auto; } .sbo { position: absolute; left: 0; top: 0; width: 110px; height: 110px; overflow: auto; } .sbi { position: relative; display: block; margin: 10px; width: 70px; height: 70px; overflow: auto; } .tall { display: block; width: 40px; height: 300px; } .szc { left: 10px; top: 40px; width: 80px; height: 80px; z-index: 10; } .szs { left: 30px; top: 30px; width: 80px; height: 80px; z-index: 5; } .zc2 { left: 0; top: 0; width: 100px; height: 100px; z-index: 10; } .zs2 { left: 0; top: 0; width: 120px; height: 120px; z-index: 5; } .rw { left: 0; top: 0; width: 120px; height: 120px; transform: rotate(30deg); } .rsb { position: absolute; left: 0; top: 0; width: 60px; height: 40px; overflow: auto; } .rzc { left: 0; top: 0; width: 100px; height: 100px; z-index: 10; } .rzs { left: 0; top: 0; width: 100px; height: 100px; z-index: 5; }")
  (const NA1 int 0)
  (const NAINN int 1)
  (const NA2 int 2)
  (const NBPAR int 3)
  (const NBNEG int 4)
  (const NBFLOW int 5)
  (const NC0 int 6)
  (const NFX int 15)
  (const NHI int 16)
  (const NPOP int 17)
  (const NIT0 int 18)
  (const NPE1 int 21)
  (const NPE2 int 22)
  (const NSTAGE int 23)
  (const NFC int 24)
  (const NFI0 int 25)
  (const NTR1 int 27)
  (const NTR2 int 28)
  (const NSB int 29)
  (const NSBZC int 30)
  (const NSBZS int 31)
  (const NSBO int 32)
  (const NSBI int 33)
  (const NZC2 int 34)
  (const NZS2 int 35)
  (const NRW int 36)
  (const NRSB int 37)
  (const NRZC int 38)
  (const NRZS int 39)
  (const NMSB int 40)
  (const NMZC int 41)
  (const NMD int 42)
  (const NSS int 43)
  (const NSST int 44)
  (const NTALL int 45)
  (const NS2 int 46)
  (const NS2R int 47)
  (const NIDS int 48)
  (mod-let IDS (array 48 int) _)
  (mod-let ANIM bool _)
  (mod-let HOOKS (array 2 int) _)
  (fn hookA (params (p ptr)) _ (block
    (+= (index HOOKS 0) 1)))
  (fn hookB (params (p ptr)) _ (block
    (+= (index HOOKS 1) 1)))
  (fn canvasFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4059000000000000)) (field y (float 0x4059000000000000)))))
    (let c _ (call (. d open) 0 (call (. d tag) "canvas") 1))
    (expr (call (. d styleStr) c 0 "width" "40px"))
    (expr (call (. d styleStr) c 1 "height" "40px"))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d paintAll)))
    (expr (call (. d endFrame)))))
  (mod-let TWEAK bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn channel (params (p (slice u8)) (x int) (y int) (c int)) int (block
    (return (call int (index p (+ (* (+ (* y W) x) 4) c))))))
  (fn (doc "The pixel at `(x, y)` is the color `(r, g, b)`.") pixel (params (p (slice u8)) (x int) (y int) (r int) (g int) (b int) (msg string)) _ (block
    (+= CHECKS 1)
    (let dr _ (- (call channel p x y 0) r))
    (let dg _ (- (call channel p x y 1) g))
    (let db _ (- (call channel p x y 2) b))
    (if (|| (|| (|| (|| (|| (< dr (- 3)) (> dr 3)) (< dg (- 3))) (> dg 3)) (< db (- 3))) (> db 3)) (block
      (expr (call printLn (interp "FAIL: " msg ": (" (call channel p x y 0) ", " (call channel p x y 1) ", " (call channel p x y 2) "), expected (" r ", " g ", " b ")")))
      (expr (call panic msg))))))
  (fn box (params (d (ref Dom)) (slot int) (cls string) (name int)) int (block
    (let id _ (call (. d open) slot (call (. d tag) "div") 1))
    (expr (call (. d clsDyn) id cls))
    (= (index IDS name) id)
    (return id)))
  (fn (doc "One scenario cell: a context holding the boxes of `body`.") cell (params (d (ref Dom)) (slot int) (k int)) int (block
    (let sc _ (call (. d open) slot (call (. d tag) "div") 1))
    (expr (call (. d clsDyn) sc (interp "sc k" k)))
    (return sc)))
  (fn build (params (d (ref Dom))) _ (block
    (let stage _ (call box d 0 "stage" NSTAGE))
    (expr (call cell d 0 0))
    (expr (call box d 0 (if-expr TWEAK "box c1 red z3" "box c1 red") NA1))
    (expr (call box d 0 "box inn blue" NAINN))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "box c2 green" NA2))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 1 1))
    (expr (call box d 0 "box pb yellow" NBPAR))
    (expr (call box d 0 "box negc red" NBNEG))
    (expr (call (. d close)))
    (expr (call box d 1 "flowc blue" NBFLOW))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (for q (.. 0 3) (block
      (expr (call cell d (+ 2 q) (+ 2 q)))
      (expr (call box d 0 (if-expr (== q 0) "box oc" (if-expr (== q 1) "box tc" "box ic")) (+ NC0 (* q 3))))
      (expr (call box d 0 "box ci red" (+ (+ NC0 (* q 3)) 1)))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call box d 1 "box cs green" (+ (+ NC0 (* q 3)) 2)))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call cell d 5 5))
    (expr (call box d 0 "box fc gray" NFC))
    (expr (call box d 0 "fx pink" NFX))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 6 6))
    (expr (call box d 0 "box hi red" NHI))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let pop _ (call box d 7 "pop blue" NPOP))
    (expr (call (. d attrOverlay) pop OV_POPOVER))
    (expr (call (. d attrLeft) pop (float 0x4088b00000000000)))
    (expr (call (. d attrTop) pop (float 0x4024000000000000)))
    (expr (call (. d close)))
    (expr (call cell d 8 7))
    (expr (call box d 0 "row" NSTAGE))
    (let a _ (call box d 0 "it red" NIT0))
    (expr (call (. d styleNum) a 0 "order" (float 0x4000000000000000)))
    (expr (call (. d close)))
    (let b _ (call box d 1 "it green" (+ NIT0 1)))
    (expr (call (. d styleNum) b 0 "order" (float 0x3ff0000000000000)))
    (expr (call (. d close)))
    (let c _ (call box d 2 "it blue" (+ NIT0 2)))
    (expr (call (. d styleNum) c 0 "order" (float 0x0000000000000000)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 9 8))
    (expr (call box d 0 "box pe1 green" NPE1))
    (expr (call (. d close)))
    (expr (call box d 1 "box pe2 red" NPE2))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 10 9))
    (expr (call box d 0 "frow" NSTAGE))
    (expr (call box d 0 "fi fz red" NFI0))
    (expr (call (. d close)))
    (expr (call box d 1 "fi green" (+ NFI0 1)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let t1 _ (call box d 1 "box tr1" NTR1))
    (expr (call (. d clsIf) t1 "on" ANIM))
    (expr (call (. d close)))
    (let t2 _ (call box d 2 "box tr2" NTR2))
    (expr (call (. d clsIf) t2 "on" ANIM))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 11 10))
    (expr (call box d 0 "sb yellow" NSB))
    (expr (call box d 0 "tall gray" NTALL))
    (expr (call (. d close)))
    (expr (call box d 1 "box szc blue" NSBZC))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "box szs green" NSBZS))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 12 11))
    (expr (call box d 0 "sbo yellow" NSBO))
    (expr (call box d 0 "sbi gray" NSBI))
    (expr (call box d 0 "tall yellow" NTALL))
    (expr (call (. d close)))
    (expr (call box d 1 "box zc2 red" NZC2))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "box zs2 green" NZS2))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 13 12))
    (expr (call box d 0 "box rw gray" NRW))
    (expr (call box d 0 "rsb yellow" NRSB))
    (expr (call box d 0 "tall gray" NTALL))
    (expr (call (. d close)))
    (expr (call box d 1 "box rzc blue" NRZC))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "box rzs green" NRZS))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 14 13))
    (expr (call box d 0 "sb yellow" NMSB))
    (expr (call box d 0 "tall gray" NTALL))
    (expr (call (. d close)))
    (expr (call box d 1 "box szc blue" NMZC))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "box md red" NMD))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 15 14))
    (expr (call box d 0 "ss yellow" NSS))
    (expr (call box d 0 "st red" NSST))
    (expr (call (. d close)))
    (expr (call box d 1 "tall gray" NTALL))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call cell d 16 15))
    (expr (call box d 0 "s2 yellow" NS2))
    (expr (call box d 0 "rel blue" NS2R))
    (expr (call (. d close)))
    (expr (call box d 1 "tall gray" NTALL))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))))
  (fn frame (params (d (ref Dom)) (px f32) (py f32) (pixels (slice u8))) _ (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. d simInput) px py (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
    (expr (call build d))
    (expr (call (. d layout)))
    (expr (call (. sticky step) d))
    (expr (call (. d paintAll)))
    (expr (call (. d endFrame)))
    (expr (call ok (call (. game readWindow) pixels) "read the frame"))))
  (fn (doc "Move the pointer to `(x, y)` (two frames: the hit test reads the last layout), check the pixel there and the box it hits.") at (params (d (ref Dom)) (pixels (slice u8)) (x int) (y int) (r int) (g int) (b int) (hit int) (msg string)) _ (block
    (expr (call frame d (call f32 x) (call f32 y) pixels))
    (expr (call frame d (call f32 x) (call f32 y) pixels))
    (expr (call pixel pixels x y r g b (interp "paint: " msg)))
    (expr (call ok (== (. d hover) (index IDS hit)) (interp "hit: " msg)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call (. game initGlHidden) "stacking contexts" W H))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "stacking.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "fixture CSS parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let pixels _ (call (. mem alloc) (targs u8) (* (* W H) 4)))
    (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))
    (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))
    (let sc0 _ (. (index (. (. d nodes) items) (index IDS NA1)) parent))
    (expr (call ok (&& (. (index (. (. d nodes) items) sc0) ctx) (== (. (index (. (. d nodes) items) sc0) zc) 2)) "a z-indexed cell lists its two cards, not the inner box"))
    (expr (call ok (&& (== (. (index (. (. d zl) items) (. (index (. (. d nodes) items) sc0) zs)) v) (index IDS NA1)) (== (. (index (. (. d zl) items) (+ (. (index (. (. d nodes) items) sc0) zs) 1)) v) (index IDS NA2))) "entries in ascending z-index"))
    (expr (call ok (&& (. (index (. (. d nodes) items) (index IDS NA1)) ctx) (== (. (index (. (. d nodes) items) (index IDS NA1)) zc) 1)) "a z-indexed card is a context with the inner box as its entry"))
    (let sc1 _ (. (index (. (. d nodes) items) (index IDS NBPAR)) parent))
    (expr (call ok (&& (&& (== (. (index (. (. d nodes) items) (index IDS NBPAR)) zneg) 1) (== (. (index (. (. d nodes) items) (index IDS NBPAR)) zc) 1)) (>= sc1 0)) "a negative z-index is counted as below the in-flow content"))
    (expr (call ok (! (. (index (. (. d nodes) items) (index IDS NBFLOW)) lift)) "in-flow content is not lifted"))
    (expr (call ok (&& (&& (. (index (. (. d nodes) items) (index IDS (+ NC0 3))) ctx) (. (index (. (. d nodes) items) (index IDS (+ NC0 6))) ctx)) (. (index (. (. d nodes) items) (index IDS NC0)) ctx)) "opacity, transform and isolation make contexts"))
    (expr (call at (& d) pixels 60 40 0 255 0 NA2 "z-index 9999 inside a z-index 1 card is under the z-index 2 card"))
    (expr (call at (& d) pixels 10 10 255 0 0 NA1 "the card alone"))
    (expr (call at (& d) pixels 40 90 0 0 255 NAINN "the inner box outside the sibling"))
    (expr (call at (& d) pixels (+ 130 5) 5 255 255 0 NBPAR "context background"))
    (expr (call at (& d) pixels (+ 130 25) 25 255 0 0 NBNEG "negative z-index above the background"))
    (expr (call at (& d) pixels (+ 130 50) 50 0 0 255 NBFLOW "in-flow content above the negative z-index"))
    (for q (.. 0 3) (block
      (let x0 _ (+ 260 (* 130 q)))
      (expr (call at (& d) pixels (+ x0 50) 50 0 255 0 (+ (+ NC0 (* q 3)) 2) "sibling z-index 3 over z-index 5 inside an effect context"))
      (expr (call at (& d) pixels (+ x0 10) 10 255 0 0 (+ (+ NC0 (* q 3)) 1) "the inner box alone"))))
    (expr (call at (& d) pixels 700 210 255 0 255 NFX "a fixed box paints and is hit outside its parent's overflow clip"))
    (expr (call at (& d) pixels (+ 650 30) 30 136 136 136 NFC "the clipping parent"))
    (expr (call at (& d) pixels 800 20 0 0 255 NPOP "an overlay is above a z-index 99999 box"))
    (expr (call at (& d) pixels (+ 780 5) 65 255 0 0 NHI "the z-index box where no overlay is"))
    (expr (call at (& d) pixels (+ 910 45) 25 255 0 0 NIT0 "the last flex item in visual order is on top"))
    (expr (call at (& d) pixels (+ 910 25) 25 0 255 0 (+ NIT0 1) "the middle one over the first"))
    (expr (call at (& d) pixels (+ 1040 40) 40 255 0 0 NPE1 "a box with pointer-events: none paints on top and lets the pointer through"))
    (expr (call at (& d) pixels (+ 1170 40) 25 255 0 0 NFI0 "a z-index on a static flex item puts it over the later item"))
    (expr (call at (& d) pixels (+ 1170 60) 25 0 255 0 (+ NFI0 1) "the later item where the first is not"))
    (expr (call ok (&& (. (index (. (. d nodes) items) (index IDS NFI0)) ctx) (! (. (index (. (. d nodes) items) (index IDS (+ NFI0 1))) ctx))) "the z-indexed flex item is a context, the other is not"))
    (let by _ 130)
    (expr (call ok (&& (! (. (index (. (. d nodes) items) (index IDS NSB)) ctx)) (. (index (. (. d nodes) items) (index IDS NSB)) lift)) "a scroll box is no stacking context, only lifted by its position"))
    (expr (call at (& d) pixels 35 (+ by 50) 0 0 255 NSBZC "a z-index 10 child of a scroll box is above a z-index 5 sibling of the scroll box"))
    (expr (call at (& d) pixels 35 (+ by 80) 0 255 0 NSBZS "outside the scroll clip the child is gone and the z-index 5 sibling shows"))
    (expr (call frame (& d) (float 0x404b800000000000) (call f32 (+ by 50)) pixels))
    (expr (call frame (& d) (float 0x404b800000000000) (call f32 (+ by 50)) pixels))
    (expr (call ok (&& (&& (>= (call channel pixels 55 (+ by 50) 0) 8) (== (. d hover) (index IDS NSB))) (== (. d barOf) (index IDS NSB))) "a scroller's bar is above its z-index child, painted and hit"))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
    (expr (call build (& d)))
    (expr (call (. d layout)))
    (expr (call (. d paintAll)))
    (expr (call (. d paintDetached) (index IDS NSB)))
    (expr (call (. d endFrame)))
    (expr (call ok (call (. game readWindow) pixels) "read the frame"))
    (expr (call ok (&& (>= (call channel pixels 55 50 0) 8) (> (call channel pixels 55 50 2) 240)) "a detached scroller paints its bars over its child"))
    (expr (call (. d simInput) (float 0x4041800000000000) (call f32 (+ by 50)) (bool false) (- (float 0x3ff0000000000000))))
    (expr (call frame (& d) (float 0x4041800000000000) (call f32 (+ by 50)) pixels))
    (expr (call frame (& d) (float 0x4041800000000000) (call f32 (+ by 50)) pixels))
    (expr (call ok (> (. (index (. (. d nodes) items) (index IDS NSB)) scrollY) (float 0x0000000000000000)) "the wheel over a scroll box's z-index child scrolls the scroll box"))
    (expr (call at (& d) pixels 35 (+ by 5) 0 0 255 NSBZC "the child moved up with the scroll offset and shows where the box was bare"))
    (expr (call at (& d) pixels 35 (+ by 80) 0 255 0 NSBZS "and is still clipped below the scroll box"))
    (expr (call at (& d) pixels (+ 130 45) (+ by 45) 255 0 0 NZC2 "a z-index 10 child inside two scroll boxes is above the z-index 5 sibling"))
    (expr (call at (& d) pixels (+ 130 95) (+ by 95) 0 255 0 NZS2 "outside the inner scroll clip the sibling shows"))
    (expr (call (. d simInput) (call f32 (+ 130 45)) (call f32 (+ by 45)) (bool false) (- (float 0x3ff0000000000000))))
    (expr (call frame (& d) (call f32 (+ 130 45)) (call f32 (+ by 45)) pixels))
    (expr (call frame (& d) (call f32 (+ 130 45)) (call f32 (+ by 45)) pixels))
    (expr (call ok (&& (> (. (index (. (. d nodes) items) (index IDS NSBI)) scrollY) (float 0x0000000000000000)) (== (. (index (. (. d nodes) items) (index IDS NSBO)) scrollY) (float 0x0000000000000000))) "the wheel scrolls the nearest scroll box, the inner one"))
    (expr (call at (& d) pixels (+ 130 45) (+ by 45) 255 0 0 NZC2 "the child still fills the inner clip after it scrolled"))
    (expr (call at (& d) pixels (+ 260 54) (+ by 10) 0 0 255 NRZC "rotated: the z-index 10 child inside the scroll clip"))
    (expr (call at (& d) pixels (+ 260 46) (+ by 23) 0 0 255 NRZC "rotated: just inside the scroll clip edge"))
    (expr (call at (& d) pixels (+ 260 41) (+ by 33) 0 255 0 NRZS "rotated: just outside the scroll clip edge the sibling shows and is hit"))
    (expr (call at (& d) pixels (+ 260 29) (+ by 54) 0 255 0 NRZS "rotated: far outside the clip"))
    (expr (call at (& d) pixels (+ 390 35) (+ by 50) 255 0 0 NMD "a z-index 100 box covers a scroller and its z-index 10 child"))
    (expr (call at (& d) pixels (+ 390 55) (+ by 45) 255 0 0 NMD "and the scroller's bars"))
    (expr (call at (& d) pixels (+ 520 5) (+ by 5) 255 0 0 NSST "the sticky header at rest"))
    (expr (call (. d simInput) (call f32 (+ 520 5)) (call f32 (+ by 30)) (bool false) (- (float 0x3ff0000000000000))))
    (expr (call frame (& d) (call f32 (+ 520 5)) (call f32 (+ by 30)) pixels))
    (expr (call frame (& d) (call f32 (+ 520 5)) (call f32 (+ by 30)) pixels))
    (expr (call ok (> (. (index (. (. d nodes) items) (index IDS NSS)) scrollY) (float 0x0000000000000000)) "the wheel scrolled the scroller with the sticky header"))
    (expr (call at (& d) pixels (+ 520 5) (+ by 5) 255 0 0 NSST "the sticky header stays at the top of the scroller after it scrolled"))
    (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))
    (expr (call pixel pixels (+ 520 5) (+ by 70) 0 0 0 "and nothing of the scroller shows below its clip"))
    (expr (call ok (&& (. (index (. (. d nodes) items) (index IDS NS2)) ctx) (. (index (. (. d nodes) items) (index IDS NS2R)) lift)) "a scroller whose only lifted boxes are plain positioned ones inside it stays a context"))
    (expr (call ok (&& (! (. (index (. (. d nodes) items) (index IDS NSB)) ctx)) (! (. (index (. (. d nodes) items) (index IDS NMSB)) ctx))) "a scroller with a z-indexed box inside is none"))
    (= ANIM (bool true))
    (for i (.. 0 6) (block
      (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))))
    (expr (call ok (!= (. (index (. (. d nodes) items) (index IDS NTR1)) style) (. (index (. (. d nodes) items) (index IDS NTR1)) tstyle)) "the color transition is running"))
    (expr (call ok (! (. (index (. (. d nodes) items) (index IDS NTR1)) ctx)) "a color transition does not make a stacking context"))
    (expr (call ok (. (index (. (. d nodes) items) (index IDS NTR2)) ctx) "an opacity transition does"))
    (= ANIM (bool false))
    (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))
    (let builds _ (. d stackBuilds))
    (for i (.. 0 20) (block
      (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))))
    (expr (call ok (== (. d stackBuilds) builds) "idle frames do not rebuild the stacking lists"))
    (= TWEAK (bool true))
    (expr (call at (& d) pixels 60 40 0 0 255 NAINN "raising the first card's z-index above the second puts its inner box on top"))
    (expr (call ok (== (. d stackBuilds) (+ builds 1)) "one rebuild for one changed z-index"))
    (for i (.. 0 20) (block
      (expr (call frame (& d) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) pixels))))
    (expr (call ok (== (. d stackBuilds) (+ builds 1)) "and none after it"))
    (let da _ (call (. Dom new) (& mem) (& css)))
    (let db _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. da setPaintHook) hookA (as (& (index HOOKS 0)) ptr)))
    (expr (call (. db setPaintHook) hookB (as (& (index HOOKS 1)) ptr)))
    (expr (call canvasFrame (& da)))
    (expr (call ok (&& (== (index HOOKS 0) 1) (== (index HOOKS 1) 0)) "the first Dom's canvas calls its own hook"))
    (expr (call canvasFrame (& db)))
    (expr (call canvasFrame (& db)))
    (expr (call ok (&& (== (index HOOKS 0) 1) (== (index HOOKS 1) 2)) "the second Dom's canvas calls only its own"))
    (expr (call printLn (interp "stacking_test ok, checks passed: " CHECKS)))
    (expr (call (. game destroy)))
    (expr (call (. mem destroy))))))
