(file (module post_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.Text)
  (use j3.ui.css (names Css MatchNode P_BACKDROP_FILTER P_WIDTH V_NONE V_PX))
  (use j3.ui.css (names FILTER_NAMES NFILTERS P_FILTER P_MIX_BLEND_MODE P_PERSPECTIVE P_ROTATE_X P_ROTATE_Y V_LIST V_NUM))
  (use j3.ui.cssmatch.computeStyle)
  (use j3.ui.cssparse.parse)
  (use j3.ui.cssvalue (names inherits initial propId))
  (use j3.ui.dom (names Dom effectsOf))
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn testValues (params (mem (ref Arena))) _ (block
    (expr (call ok (== (call propId "backdrop-filter") P_BACKDROP_FILTER) "property table includes backdrop-filter"))
    (let start _ (call initial P_BACKDROP_FILTER))
    (expr (call ok (== (. start kind) V_NONE) "initial filter is none"))
    (expr (call ok (! (call inherits P_BACKDROP_FILTER)) "filter does not inherit by default"))
    (let values (array 5 string) (array-lit "none" "blur(0)" "blur(0px)" "blur(2.5px)" "blur(64px)"))
    (let sigmas (array 5 f32) (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4004000000000000) (float 0x4050000000000000)))
    (for i (.. 0 5) (block
      (let css _ (call (. Css new) mem))
      (let src _ (call (. Text new) mem))
      (expr (call (. src pushStr) "div { backdrop-filter: "))
      (expr (call (. src pushStr) (index values i)))
      (expr (call (. src pushStr) "; }"))
      (expr (call parse (& css) (call (. src str)) "post.css" 0))
      (expr (call ok (&& (== (. (. css warns) len) 0) (== (. (. css decls) len) 1)) (interp "accepted " (index values i))))
      (let v _ (. (index (. (. css decls) items) 0) v))
      (expr (call ok (&& (== (. v kind) (if-expr (== i 0) V_NONE V_PX)) (== (. v f) (index sigmas i))) (interp "typed " (index values i))))))
    (let bad (array 17 string) (array-lit "blur(-1px)" "blur(2)" "blur(2%)" "blur(2em)" "blur()" "blur(1px, 2px)" "blur(1px 2px)" "blur(1px) blur(2px)" "brightness(2)" "none blur(1px)" "blur(1px) none" "2px" "0" "blur(auto)" "blur(1px 0)" "blur(1deg)" "blur(1px))"))
    (for i (.. 0 17) (block
      (let rejected _ (call (. Css new) mem))
      (let badSrc _ (call (. Text new) mem))
      (expr (call (. badSrc pushStr) "div { backdrop-filter: "))
      (expr (call (. badSrc pushStr) (index bad i)))
      (expr (call (. badSrc pushStr) "; width: 17px; }"))
      (expr (call parse (& rejected) (call (. badSrc str)) "post.rejected" 0))
      (expr (call ok (== (. (. rejected warns) len) 1) (interp "diagnostic for " (index bad i))))
      (expr (call ok (&& (== (. (. rejected decls) len) 1) (== (. (index (. (. rejected decls) items) 0) prop) P_WIDTH)) (interp "invalid filter discarded, next declaration preserved: " (index bad i))))))))
  (fn testCascade (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) "div { backdrop-filter: blur(7px); } span { width: 30px; } .inherit { backdrop-filter: inherit; } .off { backdrop-filter: none; } .invalid { backdrop-filter: blur(3px); backdrop-filter: blur(-4px); } :root { --sigma: -4px; } .custom { backdrop-filter: blur(3px); backdrop-filter: var(--sigma); }" "cascade.css" 0))
    (expr (call ok (== (. (. css warns) len) 1) "cascade has only the intended negative-radius diagnostic"))
    (let nodes _ (call (. mem alloc) (targs MatchNode) 6))
    (let names (array 6 string) (array-lit "" "" "inherit" "off" "invalid" "custom"))
    (for i (.. 0 6) (block
      (let classes _ (call (. mem alloc) (targs int) (if-expr (< i 2) 0 1)))
      (if (>= i 2) (block
        (= (index classes 0) (call (. css intern) (index names i)))))
      (= (index nodes i) (struct-lit MatchNode (field tag (call (. css intern) (if-expr (== i 0) "div" "span"))) (field classes classes) (field parent (if-expr (== i 0) (- 1) 0)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))))
    (let parent _ (call computeStyle (& css) nodes 0 (- 1)))
    (let pv _ (call (. css get) parent P_BACKDROP_FILTER))
    (expr (call ok (&& (== (. pv kind) V_PX) (== (. pv f) (float 0x401c000000000000))) "parent blur applied"))
    (let child _ (call (. css get) (call computeStyle (& css) nodes 1 parent) P_BACKDROP_FILTER))
    (expr (call ok (== (. child kind) V_NONE) "child gets none"))
    (let inh _ (call (. css get) (call computeStyle (& css) nodes 2 parent) P_BACKDROP_FILTER))
    (expr (call ok (&& (== (. inh kind) V_PX) (== (. inh f) (float 0x401c000000000000))) "explicit inherit copies filter"))
    (let off _ (call (. css get) (call computeStyle (& css) nodes 3 parent) P_BACKDROP_FILTER))
    (expr (call ok (== (. off kind) V_NONE) "none disables inherited filter"))
    (let invalid _ (call (. css get) (call computeStyle (& css) nodes 4 parent) P_BACKDROP_FILTER))
    (expr (call ok (&& (== (. invalid kind) V_PX) (== (. invalid f) (float 0x4008000000000000))) "invalid declaration preserves previous valid filter"))
    (let custom _ (call (. css get) (call computeStyle (& css) nodes 5 parent) P_BACKDROP_FILTER))
    (expr (call ok (&& (== (. custom kind) V_PX) (== (. custom f) (float 0x4008000000000000))) "generic custom length cannot bypass filter grammar"))))
  (fn testDom (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".panel { display: block; width: 120px; height: 60px; border-radius: 12px; backdrop-filter: blur(8px); } .off { backdrop-filter: none; }" "dom.css" 1))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for frame (.. 0 3) (block
      (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4074000000000000)) (field y (float 0x4069000000000000)))))
      (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) id "panel"))
      (expr (call (. d clsIf) id "off" (== frame 1)))
      (expr (call (. d close)))
      (expr (call (. d layout)))
      (expr (call (. d endFrame)))
      (let n _ (& (index (. (. d nodes) items) id)))
      (let v _ (call (. css get) (. n style) P_BACKDROP_FILTER))
      (expr (call ok (&& (== (. n w) (float 0x405e000000000000)) (== (. n h) (float 0x404e000000000000))) "filter changes preserve box geometry"))
      (expr (call ok (== (. v kind) (if-expr (== frame 1) V_NONE V_PX)) "retained DOM filter toggles on, off, on"))
      (if (!= frame 1) (block
        (expr (call ok (== (. v f) (float 0x4020000000000000)) "retained DOM keeps sigma"))))))))
  (fn testContentValues (params (mem (ref Arena))) _ (block
    (expr (call ok (&& (== (call propId "filter") P_FILTER) (== (call propId "mix-blend-mode") P_MIX_BLEND_MODE)) "content property names"))
    (expr (call ok (&& (&& (== (call propId "perspective") P_PERSPECTIVE) (== (call propId "rotate-x") P_ROTATE_X)) (== (call propId "rotate-y") P_ROTATE_Y)) "projection extension property names"))
    (let empty _ (call initial P_FILTER))
    (let perspective _ (call initial P_PERSPECTIVE))
    (let angle _ (call initial P_ROTATE_X))
    (expr (call ok (&& (&& (&& (== (. empty kind) V_NONE) (== (. perspective kind) V_NONE)) (== (. angle kind) V_NUM)) (== (. angle f) (float 0x0000000000000000))) "content/projection defaults"))
    (expr (call ok (&& (&& (&& (&& (! (call inherits P_FILTER)) (! (call inherits P_MIX_BLEND_MODE))) (! (call inherits P_PERSPECTIVE))) (! (call inherits P_ROTATE_X))) (! (call inherits P_ROTATE_Y))) "post effects are non-inherited"))
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) "div { filter: blur(2.5px) bloom(75%) grain(0.1) scanlines(0.2) crt(0.3) brightness(120%) contrast(0.9) saturate(2) grayscale(0.4) sepia(0.5) invert(0.6) hue-rotate(0.25turn); mix-blend-mode: screen; perspective: 600px; rotate-x: -20deg; rotate-y: 0.125turn; }" "content.css" 0))
    (expr (call ok (&& (== (. (. css warns) len) 0) (== (. (. css decls) len) 5)) "canonical full chain and projection parse"))
    (let v _ (. (index (. (. css decls) items) 0) v))
    (expr (call ok (&& (== (. v kind) V_LIST) (== (. (. css paints) len) NFILTERS)) "filter typed list has one amount per renderer stage"))
    (let expected (array 12 f32) (array-lit (float 0x4004000000000000) (float 0x3fe8000000000000) (float 0x3fb999999999999a) (float 0x3fc999999999999a) (float 0x3fd3333333333333) (float 0x3ff3333333333333) (float 0x3feccccccccccccd) (float 0x4000000000000000) (float 0x3fd999999999999a) (float 0x3fe0000000000000) (float 0x3fe3333333333333) (float 0x4056800000000000)))
    (for i (.. 0 NFILTERS) (block
      (expr (call ok (== (index (. (. css paints) items) (+ (. v i) i)) (index expected i)) (interp "filter slot " i " has the right amount")))))
    (expr (call ok (&& (&& (&& (== (. (. (index (. (. css decls) items) 1) v) i) 2) (== (. (. (index (. (. css decls) items) 2) v) f) (float 0x4082c00000000000))) (== (. (. (index (. (. css decls) items) 3) v) f) (- (float 0x4034000000000000)))) (== (. (. (index (. (. css decls) items) 4) v) f) (float 0x4046800000000000))) "blend and projection typed values"))
    (let defaults _ (call (. Css new) mem))
    (expr (call parse (& defaults) "div { filter: brightness(1.5); }" "defaults.css" 0))
    (let dv _ (. (index (. (. defaults decls) items) 0) v))
    (expr (call ok (&& (&& (&& (&& (== (. (. defaults warns) len) 0) (== (index (. (. defaults paints) items) (. dv i)) (float 0x0000000000000000))) (== (index (. (. defaults paints) items) (+ (. dv i) 5)) (float 0x3ff8000000000000))) (== (index (. (. defaults paints) items) (+ (. dv i) 6)) (float 0x3ff0000000000000))) (== (index (. (. defaults paints) items) (+ (. dv i) 7)) (float 0x3ff0000000000000))) "omitted filter stages are neutral"))
    (let bad (array 25 string) (array-lit "blur(-1px)" "blur(2)" "bloom(-1)" "bloom(4.1)" "grain(1.1)" "scanlines(-0.1)" "crt(101%)" "brightness(5)" "contrast(-1)" "saturate(401%)" "grayscale(2)" "sepia(-1)" "invert(1px)" "hue-rotate(2)" "blur(2px) blur(3px)" "invert(0.2) grayscale(0.2)" "brightness(1) blur(2px)" "bloom(0.2) grain(0.1) bloom(0.3)" "noise(0.2)" "blur()" "grain(0.1,0.2)" "blur(1px) none" "none blur(1px)" "brightness(1em)" "blur(1px) unknown(1)"))
    (for i (.. 0 25) (block
      (let rejected _ (call (. Css new) mem))
      (let src _ (call (. Text new) mem))
      (expr (call (. src pushStr) "div { filter: "))
      (expr (call (. src pushStr) (index bad i)))
      (expr (call (. src pushStr) "; width: 17px; }"))
      (expr (call parse (& rejected) (call (. src str)) "invalid-content.css" 0))
      (expr (call ok (&& (&& (== (. (. rejected warns) len) 1) (== (. (. rejected decls) len) 1)) (== (. (index (. (. rejected decls) items) 0) prop) P_WIDTH)) (interp "invalid chain rejected with recovery: " (index bad i))))
      (expr (call ok (== (. (. rejected paints) len) 0) "invalid chain does not allocate partial stages"))))
    (let invalidProjection _ (call (. Css new) mem))
    (expr (call parse (& invalidProjection) "div { perspective: 0; perspective: -4px; perspective: 40%; rotate-x: 5; rotate-y: none; mix-blend-mode: difference; }" "projection.css" 0))
    (expr (call ok (&& (== (. (. invalidProjection warns) len) 6) (== (. (. invalidProjection decls) len) 0)) "unsupported projection/blend syntax is rejected"))))
  (fn testContentDom (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".panel { display: block; width: 120px; height: 60px; filter: blur(4px) bloom(0.5) grain(0.1) scanlines(0.2) crt(0.3) brightness(1.5) contrast(0.9) saturate(0.8) grayscale(0.2) sepia(0.3) invert(0.4) hue-rotate(15deg); mix-blend-mode: multiply; perspective: 500px; rotate-x: 10deg; rotate-y: -15deg; } .off { filter: none; mix-blend-mode: normal; perspective: none; rotate-x: 0; rotate-y: 0; } .child { display: block; width: 20px; height: 10px; z-index: 2; }" "content-dom.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "content DOM sheet parses"))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for frame (.. 0 3) (block
      (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4074000000000000)) (field y (float 0x4069000000000000)))))
      (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) id "panel"))
      (expr (call (. d clsIf) id "off" (== frame 1)))
      (let child _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) child "child"))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call (. d layout)))
      (expr (call (. d endFrame)))
      (let n _ (& (index (. (. d nodes) items) id)))
      (let fx _ (call effectsOf (& d) (. n style)))
      (expr (call ok (&& (== (. n w) (float 0x405e000000000000)) (== (. n h) (float 0x404e000000000000))) "content effects do not change layout"))
      (if (== frame 1) (block
        (expr (call ok (&& (&& (&& (&& (&& (&& (&& (&& (== (. fx blur) (float 0x0000000000000000)) (== (. fx bloom) (float 0x0000000000000000))) (== (. fx brightness) (float 0x3ff0000000000000))) (== (. fx contrast) (float 0x3ff0000000000000))) (== (. fx saturation) (float 0x3ff0000000000000))) (== (. fx blend) 0)) (== (. fx perspective) (float 0x0000000000000000))) (== (. fx rotateX) (float 0x0000000000000000))) (== (. fx rotateY) (float 0x0000000000000000))) "all effects reset through retained styles"))) (block
        (expr (call ok (&& (&& (&& (&& (== (. fx blur) (float 0x4010000000000000)) (== (. fx bloom) (float 0x3fe0000000000000))) (== (. fx grain) (float 0x3fb999999999999a))) (== (. fx scanlines) (float 0x3fc999999999999a))) (== (. fx crt) (float 0x3fd3333333333333))) "spatial effects map to paint settings"))
        (expr (call ok (&& (&& (&& (&& (&& (&& (== (. fx brightness) (float 0x3ff8000000000000)) (== (. fx contrast) (float 0x3feccccccccccccd))) (== (. fx saturation) (float 0x3fe999999999999a))) (== (. fx grayscale) (float 0x3fc999999999999a))) (== (. fx sepia) (float 0x3fd3333333333333))) (== (. fx invert) (float 0x3fd999999999999a))) (== (. fx hue) (float 0x402e000000000000))) "color stages map to paint settings"))
        (expr (call ok (&& (&& (&& (== (. fx blend) 1) (== (. fx perspective) (float 0x407f400000000000))) (== (. fx rotateX) (float 0x4024000000000000))) (== (. fx rotateY) (- (float 0x402e000000000000)))) "blend/projection map to paint settings"))))
      (let childFx _ (call effectsOf (& d) (. (index (. (. d nodes) items) child) style)))
      (expr (call ok (&& (&& (== (. childFx blur) (float 0x0000000000000000)) (== (. childFx blend) 0)) (== (. childFx perspective) (float 0x0000000000000000))) "child has neutral style (parent group affects painted subtree only)"))
      (expr (call (. d stack)))
      (expr (call ok (== (. (index (. (. d nodes) items) id) ctx) (!= frame 1)) "a box with post effects is a stacking context, one without is not"))
      (expr (call ok (! (. (index (. (. d nodes) items) child) lift)) "z-index on a static box does nothing"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call testValues (& mem)))
    (expr (call testCascade (& mem)))
    (expr (call testDom (& mem)))
    (expr (call testContentValues (& mem)))
    (expr (call testContentDom (& mem)))
    (expr (call printLn (interp "post_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
