(file (module tls_live_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.net.http)
  (use j3.net.tls)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn (doc "The request must fail with a TLS error; print OpenSSL's reason.") refused (params (url string) (a (ref Arena))) _ (block
    (let req _ (call (. http get) url a))
    (= (. req timeoutMs) 15000)
    (match (call (. http request) (& req) a)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) (interp url " was trusted")))))
      (arm (pats (variant Result.Err (bind e))) (block
        (let t _ (call (. Text new) a))
        (expr (call (. tls lastError) (& t)))
        (expr (call printLn (interp "  " url ": " (call (. http errorName) e) " (" (call (. t str)) ")")))
        (expr (call ok (call eq (call (. http errorName) e) "tls") url)))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 8388608))
    (let req _ (call (. http get) "https://example.com/" (& a)))
    (= (. req timeoutMs) 15000)
    (match (call (. http request) (& req) (& a))
      (arm (pats (variant Result.Ok (bind r))) (block
        (expr (call ok (&& (== (. r status) 200) (> (. (. r body) len) 100)) "https GET"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (bool false) (interp "https GET: " (call (. http errorName) e)))))))
    (expr (call refused "https://expired.badssl.com/" (& a)))
    (expr (call refused "https://wrong.host.badssl.com/" (& a)))
    (expr (call refused "https://self-signed.badssl.com/" (& a)))
    (expr (call refused "https://untrusted-root.badssl.com/" (& a)))
    (expr (call printLn (interp "tls_live_test: " CHECKS " checks ok"))))))
--- stderr
--- exit 0
