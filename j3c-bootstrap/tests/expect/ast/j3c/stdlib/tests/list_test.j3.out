(file (module list_test)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.sys.panic)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "list_test"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) 4096))
    (let xs _ (call (. (type-path List int) new) (& mem)))
    (for i (.. 0 5) (block
      (expr (call (. xs push) (* i 10)))))
    (expr (call (. xs remove) 1))
    (expr (call ok (&& (&& (&& (== (. xs len) 4) (== (index (. xs items) 0) 0)) (== (index (. xs items) 1) 20)) (== (index (. xs items) 3) 40)) "remove keeps order"))
    (expr (call (. xs swapRemove) 0))
    (expr (call ok (&& (&& (== (. xs len) 3) (== (index (. xs items) 0) 40)) (== (index (. xs items) 1) 20)) "swapRemove moves last"))
    (expr (call (. xs remove) 2))
    (expr (call ok (&& (== (. xs len) 2) (== (index (. xs items) 1) 20)) "remove last"))
    (expr (call (. xs remove) 5))
    (expr (call (. xs swapRemove) (- 1)))
    (expr (call ok (== (. xs len) 2) "out of range is a no-op"))
    (expr (call (. xs swapRemove) 1))
    (expr (call (. xs swapRemove) 0))
    (expr (call ok (== (. xs len) 0) "empty"))
    (expr (call printLn "list_test ok")))))
--- stderr
--- exit 0
