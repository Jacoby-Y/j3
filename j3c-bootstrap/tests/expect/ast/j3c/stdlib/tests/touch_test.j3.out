(file (module touch_test)
  (use j3.game)
  (use j3.game.Mouse)
  (use j3.io.printLn)
  (use j3.math.abs)
  (use j3.sys.panic)
  (use-lib "SDL2" sdl
    (lib-fn SDL_PushEvent (params (event ptr)) i32 _))
  (struct Finger
    (field ty u32)
    (field timestamp u32)
    (field touchId int)
    (field fingerId int)
    (field x f32)
    (field y f32)
    (field dx f32)
    (field dy f32)
    (field pressure f32)
    (field windowID u32))
  (struct Key
    (field ty u32)
    (field timestamp u32)
    (field windowID u32)
    (field state u8)
    (field repeat u8)
    (field pad2 u8)
    (field pad3 u8)
    (field scancode i32)
    (field sym i32))
  (mod-let BUF (array 8 int) _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "touch_test"))))))
  (fn near (params (a f32) (b f32)) bool (block
    (return (< (call abs (- a b)) (float 0x3fe0000000000000)))))
  (fn finger (params (ty u32) (id int) (x f32) (y f32)) _ (block
    (let i _ 0)
    (while (< i 8) (block
      (= (index BUF i) 0)
      (+= i 1)))
    (let e _ (as (as (& (index BUF 0)) ptr) (ref Finger)))
    (= (. e ty) ty)
    (= (. e fingerId) id)
    (= (. e x) x)
    (= (. e y) y)
    (expr (call ok (== (call (. sdl SDL_PushEvent) (as (& (index BUF 0)) ptr)) 1) "push finger"))))
  (fn plain (params (ty u32)) _ (block
    (let i _ 0)
    (while (< i 8) (block
      (= (index BUF i) 0)
      (+= i 1)))
    (let e _ (as (as (& (index BUF 0)) ptr) (ref Finger)))
    (= (. e ty) ty)
    (expr (call ok (== (call (. sdl SDL_PushEvent) (as (& (index BUF 0)) ptr)) 1) "push event"))))
  (fn button (params (ty u32) (b u8)) _ (block
    (let i _ 0)
    (while (< i 8) (block
      (= (index BUF i) 0)
      (+= i 1)))
    (let e _ (as (as (& (index BUF 0)) ptr) (ref Key)))
    (= (. e ty) ty)
    (let bytes (slice u8) (slice-lit u8 (field ptr (as (as (& (index BUF 0)) ptr) (ref u8))) (field len 64)))
    (= (index bytes 16) b)
    (expr (call ok (== (call (. sdl SDL_PushEvent) (as (& (index BUF 0)) ptr)) 1) "push button"))))
  (fn back (params (repeat u8)) _ (block
    (let i _ 0)
    (while (< i 8) (block
      (= (index BUF i) 0)
      (+= i 1)))
    (let e _ (as (as (& (index BUF 0)) ptr) (ref Key)))
    (= (. e ty) 768)
    (= (. e state) 1)
    (= (. e repeat) repeat)
    (= (. e scancode) 270)
    (= (. e sym) 1073742094)
    (expr (call ok (== (call (. sdl SDL_PushEvent) (as (& (index BUF 0)) ptr)) 1) "push back"))))
  (fn main (params) _ (block
    (expr (call (. game initGlHidden) "touch checks" 400 300))
    (expr (call (. game poll)))
    (expr (call ok (&& (== (call (. game fingerCount)) 0) (! (call (. game backgrounded)))) "starts empty"))
    (expr (call ok (== (. (call (. game finger) 0) id) (- 1)) "no finger 0"))
    (expr (call finger 1792 7 (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 1) "one finger down"))
    (let f _ (call (. game finger) 0))
    (expr (call ok (&& (&& (&& (== (. f id) 7) (. f down)) (. f held)) (! (. f up))) "down frame flags"))
    (let w _ (call (. game windowSize)))
    (expr (call ok (&& (call near (. f x) (* (. w x) (float 0x3fe0000000000000))) (call near (. f y) (* (. w y) (float 0x3fe0000000000000)))) "unletterboxed position"))
    (expr (call (. game poll)))
    (= f (call (. game finger) 0))
    (expr (call ok (&& (&& (&& (== (. f id) 7) (! (. f down))) (. f held)) (! (. f up))) "held frame flags"))
    (expr (call finger 1794 7 (float 0x3fd0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (= f (call (. game finger) 0))
    (expr (call ok (&& (. f held) (call near (. f x) (* (. w x) (float 0x3fd0000000000000)))) "motion moves it"))
    (expr (call finger 1793 7 (float 0x3fd0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (= f (call (. game finger) 0))
    (expr (call ok (&& (&& (&& (== (call (. game fingerCount)) 1) (. f up)) (! (. f held))) (! (. f down))) "up frame flags"))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 0) "gone after the up frame"))
    (expr (call finger 1792 1 (float 0x3fb999999999999a) (float 0x3fb999999999999a)))
    (expr (call finger 1792 2 (float 0x3feccccccccccccd) (float 0x3feccccccccccccd)))
    (expr (call (. game poll)))
    (expr (call ok (&& (&& (== (call (. game fingerCount)) 2) (== (. (call (. game finger) 0) id) 1)) (== (. (call (. game finger) 1) id) 2)) "two fingers"))
    (expr (call finger 1793 1 (float 0x3fb999999999999a) (float 0x3fb999999999999a)))
    (expr (call (. game poll)))
    (expr (call ok (&& (&& (&& (== (call (. game fingerCount)) 2) (. (call (. game finger) 0) up)) (. (call (. game finger) 1) held)) (! (. (call (. game finger) 1) up))) "one lifts"))
    (expr (call (. game poll)))
    (expr (call ok (&& (== (call (. game fingerCount)) 1) (== (. (call (. game finger) 0) id) 2)) "the other stays"))
    (let n _ 10)
    (while (< n 22) (block
      (expr (call finger 1792 n (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
      (+= n 1)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 10) "capacity is 10"))
    (= n 0)
    (while (< n 22) (block
      (expr (call finger 1793 n (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
      (+= n 1)))
    (expr (call (. game poll)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 0) "all gone"))
    (expr (call finger 1792 5 (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (expr (call finger 1793 5 (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
    (expr (call finger 1792 5 (float 0x3fc999999999999a) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 2) "old slot (up) and the new touch"))
    (expr (call ok (&& (&& (&& (. (call (. game finger) 0) up) (. (call (. game finger) 1) down)) (. (call (. game finger) 1) held)) (== (. (call (. game finger) 1) id) 5)) "up then down flags"))
    (expr (call (. game poll)))
    (expr (call ok (&& (&& (&& (== (call (. game fingerCount)) 1) (== (. (call (. game finger) 0) id) 5)) (. (call (. game finger) 0) held)) (! (. (call (. game finger) 0) down))) "one held finger next frame"))
    (expr (call finger 1793 5 (float 0x3fc999999999999a) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game fingerCount)) 0) "and it lifts normally"))
    (expr (call button 1025 1))
    (expr (call button 1026 1))
    (expr (call (. game poll)))
    (expr (call ok (&& (call (. game mousePressed) (. Mouse Left)) (call (. game mouseDown) (. Mouse Left))) "same-pump tap pressed"))
    (expr (call (. game poll)))
    (expr (call ok (&& (call (. game mouseReleased) (. Mouse Left)) (! (call (. game mouseDown) (. Mouse Left)))) "released the next frame"))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game mouseReleased) (. Mouse Left))) (! (call (. game mousePressed) (. Mouse Left)))) "then idle"))
    (expr (call (. game setVirtualSize) 200 100))
    (expr (call finger 1792 3 (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (= f (call (. game finger) 0))
    (expr (call ok (&& (call near (. f x) 100) (call near (. f y) 50)) "window center is virtual center"))
    (expr (call finger 1794 3 (float 0x3fd0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (= f (call (. game finger) 0))
    (expr (call ok (&& (call near (. f x) 50) (call near (. f y) 50)) "quarter across is 50 virtual"))
    (expr (call finger 1794 3 (float 0x3fe0000000000000) (float 0x3fa999999999999a)))
    (expr (call (. game poll)))
    (expr (call ok (< (. (call (. game finger) 0) y) 0) "a finger in the top bar is negative, like the mouse"))
    (expr (call finger 1793 3 (float 0x3fe0000000000000) (float 0x3fe0000000000000)))
    (expr (call (. game poll)))
    (expr (call (. game poll)))
    (expr (call (. game setVirtualSize) 0 0))
    (expr (call plain 259))
    (expr (call (. game poll)))
    (expr (call ok (call (. game backgrounded)) "will enter background"))
    (expr (call (. game waitBackground)))
    (expr (call ok (call (. game backgrounded)) "still backgrounded after a wait"))
    (expr (call plain 262))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game backgrounded))) "did enter foreground"))
    (expr (call plain 260))
    (expr (call (. game poll)))
    (expr (call ok (call (. game backgrounded)) "did enter background"))
    (expr (call plain 261))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game backgrounded))) "will enter foreground"))
    (expr (call plain 258))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game quitRequested))) "low memory does not quit"))
    (expr (call (. game holdClose) (bool true)))
    (expr (call back 0))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game closeRequested))) (! (call (. game quitRequested)))) "back ignored off Android"))
    (expr (call (. game holdClose) (bool false)))
    (expr (call (. game backKeyAnywhere) (bool true)))
    (expr (call (. game holdClose) (bool true)))
    (expr (call back 1))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game closeRequested))) (! (call (. game quitRequested)))) "repeat ignored"))
    (expr (call back 0))
    (expr (call (. game poll)))
    (expr (call ok (&& (call (. game closeRequested)) (! (call (. game quitRequested)))) "back asks under holdClose"))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game closeRequested))) "the ask lasts one frame"))
    (expr (call (. game holdClose) (bool false)))
    (expr (call back 0))
    (expr (call (. game poll)))
    (expr (call ok (call (. game quitRequested)) "back quits without holdClose"))
    (expr (call plain 257))
    (expr (call (. game poll)))
    (expr (call ok (call (. game quitRequested)) "terminating quits"))
    (expr (call printLn "touch_test ok"))
    (expr (call (. game destroy))))))
--- stderr
--- exit 0
