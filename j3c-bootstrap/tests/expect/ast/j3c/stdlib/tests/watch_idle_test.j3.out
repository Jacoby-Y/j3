(file (module watch_idle_test)
  (use j3.game)
  (use j3.io)
  (use j3.io.printLn)
  (use j3.io.watch (names Event Watcher))
  (use j3.memory (names List newArena))
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.thread)
  (use j3.thread.Thread)
  (const F _ "/tmp/j3_watch_idle_test.txt")
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "Write the file once the main thread is asleep.") writer (params (p ptr)) _ (block
    (expr (call (. game delayMs) 60))
    (expr (call (. io writeFile) F (as "changed" (slice u8))))))
  (fn (doc "One loop turn after a Dom frame said nothing is due; how long it slept, in ms.") frame (params) int (block
    (expr (call (. game idleReport) (. game IDLE_FOREVER)))
    (let t0 _ (call (. sys monotonicMs)))
    (expr (call ok (call (. game idleWait)) "slept"))
    (expr (call (. game poll)))
    (return (- (call (. sys monotonicMs)) t0))))
  (fn main (params) _ (block
    (let a _ (call newArena 1048576))
    (expr (call (. io writeFile) F (as "start" (slice u8))))
    (expr (call (. game initGlHidden) "watch idle checks" 200 100))
    (expr (call ok (call (. game idleSkipAllowed)) "run with J3_IDLE_SKIP=1"))
    (expr (call (. game poll)))
    (let w _ (call (. Watcher create) (& a)))
    (match (call (. w add) F)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "add")))))
    (let evs _ (call (. (type-path List Event) new) (& a)))
    (for i (.. 0 3) (block
      (expr (call frame))))
    (expr (call ok (>= (call frame) 200) "nothing changed: sleeps to the safety tick"))
    (let t _ (struct-lit Thread (field f writer)))
    (expr (call (. thread spawn) (& t) "writer" writer (as 0 ptr)))
    (let slept _ (call frame))
    (expr (call (. thread join) (& t)))
    (expr (call ok (< slept 200) (interp "woke on the change (" slept " ms)")))
    (expr (call ok (>= (call (. w poll) (& evs)) 1) "the change is there"))
    (expr (call (. w close)))
    (expr (call (. io remove) F))
    (expr (call printLn "watch_idle_test ok")))))
--- stderr
--- exit 0
