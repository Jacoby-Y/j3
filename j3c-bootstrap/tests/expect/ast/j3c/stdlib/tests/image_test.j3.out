    (expr (call parse css src "image_test.css" 0))))
  (fn cssTests (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call sheet (& css) ".a { background-image: url(\"assets/x.png\"); background-size: cover; background-position: right 20px; object-fit: cover; object-position: 25% 75%; image-tint: #ff8800; }"))
    (expr (call sheet (& css) ".b { border-image: url(frame.png) 12 16 fill / 10px; clip-path: circle(40% at 30% 60%); mask-image: linear-gradient(#000, transparent); }"))
    (expr (call sheet (& css) ".c { clip-path: polygon(evenodd, 50% 0, 100% 100%, 0 100%); background-size: 32px; background-position: center; }"))
    (expr (call sheet (& css) ".d { clip-path: inset(10px 5% round 8px); border-image-slice: 5 6 fill; }"))
    (expr (call sheet (& css) ".bad { clip-path: polygon(0 0, 10px); background-size: cover contain; clip-path: star(); }"))
    (for i (.. 0 (. (. css warns) len)) (block
      (expr (call printLn (interp "warn " (. (index (. (. css warns) items) i) line) ":" (. (index (. (. css warns) items) i) col) " " (. (index (. (. css warns) items) i) msg))))))
    (expr (call ok (== (. (. css warns) len) 3) "three bad declarations warn"))
    (let ok_ _ (. (. css rules) len))
    (expr (call ok (>= ok_ 5) "rules parsed"))
    (expr (call printLn "css parse ok"))))
