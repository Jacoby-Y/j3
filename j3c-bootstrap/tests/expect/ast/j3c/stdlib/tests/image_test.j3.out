    (expr (call ok (! (call (. clip contains) buf n (float 0x3ff0000000000000) (float 0x3ff0000000000000) (bool false))) "rrect corner cut"))
    (expr (call ok (call (. clip contains) buf n (float 0x4034000000000000) (float 0x3ff0000000000000) (bool false)) "rrect straight edge kept"))
    (let m _ (call (. clip rrect) buf (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4044000000000000) (float 0x4044000000000000) (float 0x4059000000000000) (float 0x4059000000000000) (float 0x4059000000000000) (float 0x4059000000000000)))
    (expr (call ok (call (. clip contains) buf m (float 0x4034000000000000) (float 0x4034000000000000) (bool false)) "oversized radii: center inside"))
    (expr (call ok (! (call (. clip contains) buf m (float 0x3ff0000000000000) (float 0x3ff0000000000000) (bool false))) "oversized radii: corner out (a circle)"))
    (let z _ (call (. clip rrect) buf (float 0x4024000000000000) (float 0x4024000000000000) (float 0x4034000000000000) (float 0x4034000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call ok (== z 5) "square corners: 4 points + closing"))
    (expr (call ok (&& (call (. clip contains) buf z (float 0x4026000000000000) (float 0x4026000000000000) (bool false)) (! (call (. clip contains) buf z (float 0x4022000000000000) (float 0x4026000000000000) (bool false)))) "square edges"))
    (let e _ (call (. clip ellipse) buf (float 0x4049000000000000) (float 0x4049000000000000) (float 0x4044000000000000) (float 0x4034000000000000)))
