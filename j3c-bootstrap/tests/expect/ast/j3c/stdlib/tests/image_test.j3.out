    (let fill _ (call (. imgfit fit) (. imgfit FILL) (float 0x4059000000000000) (float 0x4059000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4050000000000000) (float 0x4040000000000000) (float 0x4049000000000000) 1 (float 0x4049000000000000) 1))
