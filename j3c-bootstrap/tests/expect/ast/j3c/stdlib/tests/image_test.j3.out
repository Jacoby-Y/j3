    (expr (call ok (call (. clip contains) buf e (float 0x4049000000000000) (float 0x4049000000000000) (bool false)) "ellipse center"))
    (expr (call ok (&& (call (. clip contains) buf e (float 0x4055400000000000) (float 0x4049000000000000) (bool false)) (! (call (. clip contains) buf e (float 0x4057c00000000000) (float 0x4049000000000000) (bool false)))) "ellipse x radius"))
    (expr (call ok (! (call (. clip contains) buf e (float 0x4049000000000000) (float 0x4052c00000000000) (bool false))) "ellipse y radius"))
    (let l (array 14 f32) (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x4010000000000000) (float 0x4010000000000000) (float 0x4010000000000000) (float 0x4010000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call ok (call (. clip contains) (slice-expr l 0 14) 7 (float 0x4000000000000000) (float 0x4020000000000000) (bool false)) "L: the leg"))
    (expr (call ok (! (call (. clip contains) (slice-expr l 0 14) 7 (float 0x4020000000000000) (float 0x4020000000000000) (bool false))) "L: the notch is outside"))
    (let star (array 12 f32) (array-lit (float 0x4014000000000000) (float 0x0000000000000000) (float 0x4020000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x4010000000000000) (float 0x4024000000000000) (float 0x4010000000000000) (float 0x4000000000000000) (float 0x4024000000000000) (float 0x4014000000000000) (float 0x0000000000000000)))
    (expr (call ok (call (. clip contains) (slice-expr star 0 12) 6 (float 0x4014000000000000) (float 0x4014000000000000) (bool false)) "pentagram center: non-zero winding fills it"))
    (expr (call ok (! (call (. clip contains) (slice-expr star 0 12) 6 (float 0x4014000000000000) (float 0x4014000000000000) (bool true))) "pentagram center: even-odd leaves a hole"))
    (let ring (array 22 f32) (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x4024000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (- (float 0x41cdcd6500000000)) (float 0x0000000000000000) (float 0x4008000000000000) (float 0x4008000000000000) (float 0x4008000000000000) (float 0x401c000000000000) (float 0x401c000000000000) (float 0x401c000000000000) (float 0x401c000000000000) (float 0x4008000000000000) (float 0x4008000000000000) (float 0x4008000000000000)))
    (expr (call ok (call (. clip contains) (slice-expr ring 0 22) 11 (float 0x3ff0000000000000) (float 0x3ff0000000000000) (bool false)) "ring: the rim"))
    (expr (call ok (! (call (. clip contains) (slice-expr ring 0 22) 11 (float 0x4014000000000000) (float 0x4014000000000000) (bool false))) "ring: the opposite contour is a hole"))
    (expr (call ok (&& (== (call (. clip resolve) (float 0x4049000000000000) 1 (float 0x4069000000000000)) (float 0x4059000000000000)) (== (call (. clip resolve) (float 0x4020000000000000) 0 (float 0x4069000000000000)) (float 0x4020000000000000))) "resolve percent and px"))))
  (fn nineTests (params) _ (block
    (let s _ (call (. nineslice layout) (float 0x4048000000000000) (float 0x4048000000000000) (float 0x4028000000000000) (float 0x4028000000000000) (float 0x4028000000000000) (float 0x4028000000000000) (float 0x4069000000000000) (float 0x4056800000000000) (float 0x4028000000000000) (float 0x4028000000000000) (float 0x4028000000000000) (float 0x4028000000000000)))
