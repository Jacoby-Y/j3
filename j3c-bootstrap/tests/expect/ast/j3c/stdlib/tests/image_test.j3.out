    (let w _ (call (. nineslice layout) (float 0x4030000000000000) (float 0x4030000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4049000000000000) (float 0x4049000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call near (call cdw (& w) 4) (float 0x4049000000000000) (float 0x3f50624dd2f1a9fc) "zero insets: center is the box"))))
