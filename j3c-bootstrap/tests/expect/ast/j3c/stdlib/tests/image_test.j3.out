(file (module image_test)
  (use j3.gfx.clip)
  (use j3.gfx.nineslice)
  (use j3.gfx.nineslice.Slice9)
  (use j3.gfx.path)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.Text)
  (use j3.ui.css (names Css P_BG_POS P_BG_SIZE P_BORDER_SLICE P_CLIP_PATH P_MASK_IMAGE P_OBJECT_FIT P_TINT V_LIST V_NONE V_URL V_GRAD))
  (use j3.ui.cssparse.parse)
  (use j3.ui.gradmix)
  (use j3.ui.imgfit)
  (use j3.ui.media)
  (use j3.game.Color)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff tol) (block
      (expr (call printLn (interp "FAIL: " msg ": " a " vs " b)))
      (expr (call panic msg))))))
  (fn pOk (params (d string) (buf (slice f32))) bool (block
    (let p _ (call (. path parse) d buf 4))
    (return (. p ok))))
  (fn pN (params (d string) (buf (slice f32))) int (block
    (let p _ (call (. path parse) d buf 4))
    (return (. p n))))
  (fn cdw (params (s (ref Slice9)) (i int)) f32 (block
    (let c _ (call (. nineslice cell) s i))
    (return (. c dw))))
  (fn csw (params (s (ref Slice9)) (i int)) f32 (block
    (let c _ (call (. nineslice cell) s i))
    (return (. c sw))))
  (fn fitDw (params (mode int) (bw f32) (bh f32) (sw f32) (sh f32)) f32 (block
    (let p _ (call (. imgfit fit) mode bw bh (float 0x0000000000000000) (float 0x0000000000000000) sw sh (float 0x0000000000000000) 0 (float 0x0000000000000000) 0))
    (return (. p dw))))
  (fn cellX (params (frame int)) f32 (block
    (let c _ (call (. imgfit cell) 4 2 (float 0x4060000000000000) (float 0x4050000000000000) frame))
    (return (. c x))))
  (fn cellW (params (cols int) (rows int)) f32 (block
    (let c _ (call (. imgfit cell) cols rows (float 0x4024000000000000) (float 0x4024000000000000) 3))
    (return (. c w))))
  (fn tilesNx (params (w f32)) int (block
    (let t _ (call (. imgfit tiles) 0 (float 0x0000000000000000) 0 (float 0x0000000000000000) 0 (float 0x0000000000000000) 0 (float 0x0000000000000000) 0 (bool true) (bool true) (float 0x4024000000000000) (float 0x4024000000000000) w w))
    (return (. t nx))))
  (fn pathTests (params (mem (ref Arena))) _ (block
    (let buf _ (call (. mem alloc) (targs f32) (* 2 (. path MAXPT))))
    (let p _ (call (. path parse) "M2 2 L10 2 L10 10 L2 10 Z" buf 8))
    (expr (call ok (. p ok) "square parses"))
    (expr (call ok (== (. p n) 6) "square: 5 points (closed) + separator"))
    (expr (call near (. p minx) (float 0x4000000000000000) (float 0x3f50624dd2f1a9fc) "square minx"))
    (expr (call near (. p maxy) (float 0x4024000000000000) (float 0x3f50624dd2f1a9fc) "square maxy"))
    (expr (call ok (call (. path isSep) (index buf (* 2 5))) "separator after the closed contour"))
    (expr (call near (index buf (* 2 4)) (float 0x4000000000000000) (float 0x3f50624dd2f1a9fc) "closing point repeats the first x"))
    (let q _ (call (. path parse) "m1,1 h4 v4 l-4,0z" buf 8))
    (expr (call ok (. q ok) "relative commands"))
    (expr (call near (index buf 2) (float 0x4014000000000000) (float 0x3f50624dd2f1a9fc) "h4 from 1 is 5"))
    (expr (call near (index buf 5) (float 0x4014000000000000) (float 0x3f50624dd2f1a9fc) "v4 from 1 is 5"))
    (expr (call near (index buf 6) (float 0x3ff0000000000000) (float 0x3f50624dd2f1a9fc) "l-4 returns to x 1"))
    (let r _ (call (. path parse) "M.5.5-1e1,2E0" buf 8))
    (expr (call ok (. r ok) "number forms"))
    (expr (call near (index buf 0) (float 0x3fe0000000000000) (float 0x3f50624dd2f1a9fc) ".5"))
    (expr (call near (index buf 1) (float 0x3fe0000000000000) (float 0x3f50624dd2f1a9fc) "second .5 starts a new number"))
    (expr (call near (index buf 2) (- (float 0x4024000000000000)) (float 0x3f50624dd2f1a9fc) "-1e1"))
    (expr (call near (index buf 3) (float 0x4000000000000000) (float 0x3f50624dd2f1a9fc) "2E0"))
    (let c _ (call (. path parse) "M0 0 Q 10 20 20 0" buf 4))
    (expr (call ok (. c ok) "quadratic"))
    (expr (call near (index buf (* 2 2)) (float 0x4024000000000000) (float 0x3f847ae147ae147b) "quadratic midpoint x"))
    (expr (call near (index buf (+ (* 2 2) 1)) (float 0x4024000000000000) (float 0x3f847ae147ae147b) "quadratic midpoint y"))
    (expr (call near (index buf (* 2 4)) (float 0x4034000000000000) (float 0x3f50624dd2f1a9fc) "quadratic end x"))
    (let k _ (call (. path parse) "M0 0 C 0 10 10 10 10 0" buf 8))
    (expr (call ok (. k ok) "cubic"))
    (expr (call near (index buf (* 2 8)) (float 0x4024000000000000) (float 0x3f50624dd2f1a9fc) "cubic end x"))
    (expr (call near (index buf (+ (* 2 8) 1)) (float 0x0000000000000000) (float 0x3f50624dd2f1a9fc) "cubic end y"))
    (let sm _ (call (. path parse) "M0 0 C 0 10 10 10 10 0 S 20 -10 20 0" buf 4))
    (expr (call ok (. sm ok) "smooth cubic"))
    (let a _ (call (. path parse) "M0 0 L5 5 A 5 5 0 0 1 10 0" buf 4))
    (expr (call ok (. a ok) "arc parses"))
    (expr (call near (index buf (* 2 5)) (float 0x4024000000000000) (float 0x3f50624dd2f1a9fc) "arc exact endpoint x"))
    (expr (call near (index buf (+ (* 2 5) 1)) (float 0x0000000000000000) (float 0x3f50624dd2f1a9fc) "arc exact endpoint y"))
    (let ac _ (call (. path parse) "M10 0 A10 10 0 0110 20" buf 4))
    (expr (call ok (. ac ok) "adjacent flags and coordinate parse"))
    (expr (call near (index buf (* 2 2)) (float 0x4034000000000000) (float 0x3f50624dd2f1a9fc) "sweep 1 semicircle midpoint x"))
    (expr (call near (index buf (+ (* 2 2) 1)) (float 0x4024000000000000) (float 0x3f50624dd2f1a9fc) "semicircle midpoint y"))
    (let ar _ (call (. path parse) "M10 0 a10 10 0 0 0 0 20" buf 4))
    (expr (call ok (. ar ok) "relative arc parses"))
    (expr (call near (index buf (* 2 2)) (float 0x0000000000000000) (float 0x3f50624dd2f1a9fc) "sweep 0 semicircle midpoint x"))
    (expr (call near (index buf (+ (* 2 4) 1)) (float 0x4034000000000000) (float 0x3f50624dd2f1a9fc) "relative arc endpoint y"))
    (let corrected _ (call (. path parse) "M0 0 A-1 -1 0 0 1 10 0" buf 4))
    (expr (call ok (. corrected ok) "negative and undersized radii are corrected"))
    (expr (call near (index buf (* 2 2)) (float 0x4014000000000000) (float 0x3f50624dd2f1a9fc) "corrected arc midpoint x"))
    (expr (call near (index buf (+ (* 2 2) 1)) (- (float 0x4014000000000000)) (float 0x3f50624dd2f1a9fc) "corrected arc midpoint y"))
    (let rotated _ (call (. path parse) "M0 0 A10 5 90 0 1 0 20" buf 4))
    (expr (call ok (. rotated ok) "rotated ellipse parses"))
    (expr (call near (index buf (* 2 2)) (float 0x4014000000000000) (float 0x3f50624dd2f1a9fc) "rotated ellipse midpoint x"))
    (expr (call near (index buf (+ (* 2 2) 1)) (float 0x4024000000000000) (float 0x3f50624dd2f1a9fc) "rotated ellipse midpoint y"))
    (let large _ (call (. path parse) "M10 0 A10 10 0 1 1 0 10" buf 4))
    (expr (call ok (. large ok) "large arc parses"))
    (expr (call near (index buf (* 2 2)) (float 0x40311231832fcac9) (float 0x3f50624dd2f1a9fc) "large arc midpoint x"))
    (expr (call near (index buf (+ (* 2 2) 1)) (float 0x40311231832fcac9) (float 0x3f50624dd2f1a9fc) "large arc midpoint y"))
    (let zero _ (call (. path parse) "M1 2 A0 10 0 0 1 3 4 A10 10 0 1 0 3 4" buf 4))
    (expr (call ok (&& (. zero ok) (== (. zero n) 3)) "zero radius is a line; coincident endpoints skip the arc"))
    (expr (call near (index buf 2) (float 0x4008000000000000) (float 0x3f50624dd2f1a9fc) "zero radius endpoint x"))
    (expr (call ok (! (call pOk "M0 0 A5 5 0 2 0 10 0" buf)) "invalid arc flags fail"))
    (expr (call ok (! (call pOk "5 5" buf)) "no command"))
    (expr (call ok (! (call pOk "M x" buf)) "bad number"))
    (expr (call ok (== (call pN "" buf) 0) "empty path"))
    (let h _ (call (. path parse) "M0 0 H10 V10 H0 Z M3 3 H7 V7 H3 Z" buf 4))
    (expr (call ok (. h ok) "two contours"))
    (let seps _ 0)
    (for i (.. 0 (. h n)) (block
      (if (call (. path isSep) (index buf (* 2 i))) (block
        (+= seps 1)))))
    (expr (call ok (== seps 2) "one separator per contour"))
    (let big _ (call (. mem alloc) (targs f32) (* 2 40)))
    (let fitted _ (call (. path parseFit) "M0 0 C 0 10 10 10 10 0 C 10 -10 20 -10 20 0 C 20 10 30 10 30 0 C 30 -10 40 -10 40 0" big))
    (expr (call ok (&& (. fitted ok) (<= (. fitted n) 40)) "parseFit fits the buffer"))
    (let many _ (call (. Text new) mem))
    (for contour (.. 0 40) (block
      (expr (call (. many pushStr) "M0 0 h10 v10 h-10 z "))))
    (let compound _ (call (. path parseFit) (call (. many str)) buf))
    (expr (call ok (&& (. compound ok) (== (. compound n) 240)) "complex path keeps all contours"))
    (let filled _ (call (. mem alloc) (targs f32) (* 2 (. path MAXPT))))
    (expr (call ok (== (call (. path fillPoints) (& compound) filled (float 0x3ff0000000000000) (float 0x3ff0000000000000) (float 0x0000000000000000) (float 0x0000000000000000)) 240) "complex fill keeps all contours"))
    (let out _ (call (. mem alloc) (targs f32) (* 2 16)))
    (let open _ (call (. path parse) "M0 0 L10 0 L10 10" buf 4))
    (let fp _ (call (. path fillPoints) (& open) out (float 0x4000000000000000) (float 0x4008000000000000) (float 0x3ff0000000000000) (float 0x3ff0000000000000)))
    (expr (call ok (== fp 5) "open contour: 3 points + closing + separator"))
    (expr (call near (index out (* 2 3)) (float 0x3ff0000000000000) (float 0x3f50624dd2f1a9fc) "closing point is the first, mapped"))
    (expr (call near (index out (+ (* 2 2) 1)) (float 0x403f000000000000) (float 0x3f50624dd2f1a9fc) "y maps by scale and offset"))
    (expr (call ok (call (. path isSep) (index out (* 2 4))) "fill ends with a separator"))
    (let vb (array 4 f32) (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call ok (== (call (. path numbers) "0 0 24, 24" (slice-expr vb 0 4)) 4) "viewBox numbers"))
    (expr (call near (index vb 2) (float 0x4038000000000000) (float 0x3f50624dd2f1a9fc) "viewBox width"))
    (let paint _ (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 0)))
    (let ic _ (call (. media newMedia) mem))
    (let im _ (& (index (. ic items) (call (. media acquire) (& ic)))))
    (let ch _ (bool false))
    (expr (call ok (call (. media icon) im mem "ring" "dot\t0 0 2 2|NM0 0h1v1z\nring\t0 0 16 16|EM0 0h16v16H0z M4 4h8v8H4z|NM1 1h1v1z\n" (& ch)) "icon found in its table"))
    (expr (call ok (&& (&& (&& (&& (&& ch (. im hasVb)) (== (index (. im vb) 2) (float 0x4030000000000000))) (== (. im runs) 2)) (index (. im runEo) 0)) (! (index (. im runEo) 1))) "icon viewBox and fill runs"))
    (expr (call ok (&& (> (index (. im runEnd) 1) (index (. im runEnd) 0)) (== (. (. im flat) n) (index (. im runEnd) 1))) "icon runs share the flattened points"))
    (= ch (bool false))
    (expr (call ok (&& (call (. media icon) im mem "ring" "" (& ch)) (! ch)) "an unchanged icon name is not parsed again"))
    (expr (call ok (&& (! (call (. media icon) im mem "nope" "dot\t0 0 2 2|NM0 0h1v1z\n" (& ch))) (== (. im runs) 0)) "an unknown icon draws nothing"))
    (expr (call ok (&& (== (call (. media setStr) im mem (. media M_FILL_RULE) "evenodd") (bool false)) (. im evenOdd)) "fill-rule evenodd"))
    (expr (call ok (&& (&& (&& (&& (== (call (. media parsePaint) "white" (& paint)) (. media PAINT_COLOR)) (== (. paint r) 255)) (== (. paint g) 255)) (== (. paint b) 255)) (== (. paint a) 255)) "SVG white fill"))
    (expr (call ok (&& (&& (== (call (. media parsePaint) "black" (& paint)) (. media PAINT_COLOR)) (== (. paint r) 0)) (== (. paint a) 255)) "SVG black fill"))
    (expr (call ok (&& (== (call (. media parsePaint) "transparent" (& paint)) (. media PAINT_COLOR)) (== (. paint a) 0)) "SVG transparent fill"))
    (expr (call ok (&& (&& (&& (&& (== (call (. media parsePaint) "RebeccaPurple" (& paint)) (. media PAINT_COLOR)) (== (. paint r) 102)) (== (. paint g) 51)) (== (. paint b) 153)) (== (. paint a) 255)) "SVG named fill, any case"))
    (expr (call ok (== (call (. media parsePaint) "notacolor" (& paint)) (. media PAINT_NONE)) "SVG unknown name falls back to none"))))
  (fn clipTests (params (mem (ref Arena))) _ (block
    (let buf _ (call (. mem alloc) (targs f32) (* 2 64)))
