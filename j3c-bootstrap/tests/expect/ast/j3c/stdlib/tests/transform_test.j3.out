  (fn (doc "A scroll box holding a spacer and a group whose sticky header holds a rotated child.") sframe (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
