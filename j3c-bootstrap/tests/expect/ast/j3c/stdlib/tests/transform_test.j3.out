  (fn (doc "The pushed header's transformed child is found where it is drawn (the sticky offset counts).") testSticky (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
