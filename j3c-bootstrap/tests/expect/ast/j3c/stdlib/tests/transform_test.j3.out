(file (module transform_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css (names Css MatchNode P_WIDTH))
  (use j3.ui.cssmatch.computeStyle)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.sticky)
  (use j3.ui.motion)
  (use j3.ui.xform)
  (use j3.ui.xform.Xf)
  (mod-let CHECKS int _)
  (mod-let CLICKED int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d (float 0x3f847ae147ae147b)) (block
      (expr (call printLn (interp msg ": " a " vs " b)))))
    (expr (call ok (<= d (float 0x3f847ae147ae147b)) msg))))
  (const SHEET string ".z { transform-origin: 0 0; } .tr { transform: translate(10px, 0) rotate(90deg); } .rt { transform: rotate(90deg) translate(10px, 0); } .pct { transform: translate(50%, 10%); } .tl { transform: rotate(90deg); transform-origin: left top; } .ctr { transform: rotate(90deg); } .kw { transform: scale(2); transform-origin: right bottom; } .ind { translate: 10px 20px; rotate: 90deg; scale: 2; transform: translate(5px, 0); } .hit { width: 100px; height: 40px; transform: rotate(30deg) skewX(20deg) scale(2, 0.5); } .sing { width: 100px; height: 40px; transform: scale(0); } .a { transform: translate(0px, 0px) rotate(0deg); transform-origin: 0 0; transition: transform 100ms linear; } .b { transform: translate(100px, 0px) rotate(90deg); transform-origin: 0 0; transition: transform 100ms linear; } .c { transform: scale(2); transform-origin: 0 0; transition: transform 100ms linear; } .p { transform: translate(0px, 0px); transition: transform 100ms linear; } .q { transform: translate(50%, 0px); transition: transform 100ms linear; } .box { width: 100px; height: 40px; } .ia { rotate: 0deg; transition: rotate 100ms linear; } .ib { rotate: 90deg; transition: rotate 100ms linear; } .sl { width: 200px; height: 100px; overflow-y: auto; } .sp { height: 30px; } .grp { height: 200px; } .hd { position: sticky; top: 0; height: 20px; width: 100px; } .tk { width: 40px; height: 10px; transform: rotate(90deg); } .r10 { font-size: 10px; } .em { font-size: 20px; transform: translate(1em, 0.5em); } .rm { font-size: 30px; transform: translate(2rem, 1em); } .tp { font-size: 20px; translate: 1em 2em; } .eo { font-size: 20px; transform: rotate(90deg); transform-origin: 1em 2em; } .inh { transform: translate(3em, 0px); } .ep { font-size: 20px; transform: translate(1em, 10%); } .xa { font-size: 10px; transform: translate(0px, 0px); transition: transform 100ms linear; } .xb { font-size: 10px; transform: translate(2em, 0px); transition: transform 100ms linear; } @keyframes sl { from { transform: translate(0px, 0px); } to { transform: translate(2em, 0px); } } .kf { font-size: 10px; animation: sl 100ms linear forwards; } .vd { --d: 1em; font-size: 20px; transform: translate(var(--d), 0px); } @property --pl { syntax: \"<length>\"; inherits: false; initial-value: 0px; } .vp { font-size: 20px; --pl: 2em; translate: var(--pl) 0px; width: var(--pl); } @property --ty { syntax: \"<length>\"; inherits: false; initial-value: 0px; } .av { font-size: 20px; --ty: 0px; transform: translate(1em, var(--ty)); transition: --ty 100ms linear; } .av2 { font-size: 20px; --ty: 40px; transform: translate(1em, var(--ty)); transition: --ty 100ms linear; } .hem { width: 100px; height: 40px; font-size: 20px; transform: translate(2em, 0px); }")
  (fn style (params (mem (ref Arena)) (css (ref Css)) (cls string)) int (block
    (let nodes _ (call (. mem alloc) (targs MatchNode) 1))
    (let cs _ (call (. mem alloc) (targs int) 2))
    (= (index cs 0) (call (. css intern) cls))
    (= (index cs 1) (call (. css intern) "z"))
    (if (> (index cs 0) (index cs 1)) (block
      (let t _ (index cs 0))
      (= (index cs 0) (index cs 1))
      (= (index cs 1) t)))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. css intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (return (call computeStyle css nodes 0 (- 1)))))
  (fn (doc "Like `style`, but without the origin class.") style1 (params (mem (ref Arena)) (css (ref Css)) (cls string)) int (block
    (let nodes _ (call (. mem alloc) (targs MatchNode) 1))
    (let cs _ (call (. mem alloc) (targs int) 1))
    (= (index cs 0) (call (. css intern) cls))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. css intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (return (call computeStyle css nodes 0 (- 1)))))
  (fn frame (params (d (ref Dom)) (cls string)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) e cls))
    (= CLICKED (if-expr (call (. d clicked) e) 1 0))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return e)))
  (fn click (params (d (ref Dom)) (cls string) (x f32) (y f32)) bool (block
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d cls))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frame d cls))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d cls))
    (return (== CLICKED 1))))
  (fn testCompose (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let a _ (call (. xform of) css (call style mem css "tr") (float 0x4059000000000000) (float 0x4044000000000000)))
    (let b _ (call (. xform of) css (call style mem css "rt") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. a e) (float 0x4024000000000000) "translate then rotate: e"))
    (expr (call near (. a f) (float 0x0000000000000000) "translate then rotate: f"))
    (expr (call near (. b e) (float 0x0000000000000000) "rotate then translate: e"))
    (expr (call near (. b f) (float 0x4024000000000000) "rotate then translate: f"))
    (expr (call near (. a a) (float 0x0000000000000000) "rotate 90: a"))
    (expr (call near (. a b) (float 0x3ff0000000000000) "rotate 90: b"))
    (let p _ (call (. xform of) css (call style mem css "pct") (float 0x4069000000000000) (float 0x4059000000000000)))
    (expr (call near (. p e) (float 0x4059000000000000) "translate 50% of the width"))
    (expr (call near (. p f) (float 0x4024000000000000) "translate 10% of the height"))
    (let c _ (call (. xform of) css (call style1 mem css "ctr") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (+ (+ (* (. c a) (float 0x4049000000000000)) (* (. c c) (float 0x4034000000000000))) (. c e)) (float 0x4049000000000000) "center x fixed"))
    (expr (call near (+ (+ (* (. c b) (float 0x4049000000000000)) (* (. c d) (float 0x4034000000000000))) (. c f)) (float 0x4034000000000000) "center y fixed"))
    (let t _ (call (. xform of) css (call style1 mem css "tl") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. t e) (float 0x0000000000000000) "top left origin: e"))
    (expr (call near (. t f) (float 0x0000000000000000) "top left origin: f"))
    (expr (call near (* (. t c) (float 0x4044000000000000)) (- (float 0x4044000000000000)) "top left origin: y axis turns to -x"))
    (let k _ (call (. xform of) css (call style1 mem css "kw") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (+ (* (. k a) (float 0x4059000000000000)) (. k e)) (float 0x4059000000000000) "right bottom origin: x"))
    (expr (call near (+ (* (. k d) (float 0x4044000000000000)) (. k f)) (float 0x4044000000000000) "right bottom origin: y"))
    (let i _ (call (. xform of) css (call style mem css "ind") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (+ (* (. i a) (float 0x3ff0000000000000)) (. i e)) (float 0x4024000000000000) "individual properties x"))
    (expr (call near (+ (* (. i b) (float 0x3ff0000000000000)) (. i f)) (float 0x4040000000000000) "individual properties y"))
    (expr (call ok (! (. (call (. xform of) css (call style1 mem css "box") (float 0x4059000000000000) (float 0x4044000000000000)) on)) "no transform is the identity"))))
  (fn (doc "Like `style1`, under the style `parent`.") styleP (params (mem (ref Arena)) (css (ref Css)) (cls string) (parent int)) int (block
    (let nodes _ (call (. mem alloc) (targs MatchNode) 2))
    (let cs _ (call (. mem alloc) (targs int) 1))
    (= (index cs 0) (call (. css intern) cls))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. css intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (return (call computeStyle css nodes 0 parent))))
  (fn testEm (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let e _ (call (. xform of) css (call style1 mem css "em") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. e e) (float 0x4034000000000000) "translate(1em) at 20px"))
    (expr (call near (. e f) (float 0x4024000000000000) "translate(.., 0.5em) at 20px"))
    (let root _ (call style1 mem css "r10"))
    (let r _ (call (. xform of) css (call styleP mem css "rm" root) (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. r e) (float 0x4034000000000000) "translate(2rem) with a 10px root"))
    (expr (call near (. r f) (float 0x403e000000000000) "translate(.., 1em) at 30px"))
    (let t _ (call (. xform of) css (call style1 mem css "tp") (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. t e) (float 0x4034000000000000) "translate: 1em .."))
    (expr (call near (. t f) (float 0x4044000000000000) "translate: .. 2em"))
    (let o _ (call (. xform of) css (call style1 mem css "eo") (float 0x4059000000000000) (float 0x4054000000000000)))
    (expr (call near (+ (+ (* (. o a) (float 0x4034000000000000)) (* (. o c) (float 0x4044000000000000))) (. o e)) (float 0x4034000000000000) "transform-origin em: x fixed"))
    (expr (call near (+ (+ (* (. o b) (float 0x4034000000000000)) (* (. o d) (float 0x4044000000000000))) (. o f)) (float 0x4044000000000000) "transform-origin em: y fixed"))
    (let h _ (call (. xform of) css (call styleP mem css "inh" root) (float 0x4059000000000000) (float 0x4044000000000000)))
    (expr (call near (. h e) (float 0x403e000000000000) "translate(3em) with an inherited 10px"))
    (let p _ (call (. xform of) css (call style1 mem css "ep") (float 0x4069000000000000) (float 0x4059000000000000)))
    (expr (call near (. p e) (float 0x4034000000000000) "em in x beside a percentage"))
    (expr (call near (. p f) (float 0x4024000000000000) "10% of the height beside em"))
    (let m _ (call (. motion fresh)))
    (let xa _ (call style1 mem css "xa"))
    (let xb _ (call style1 mem css "xb"))
    (expr (call (. motion onStyle) (& m) css xa xb (float 0x0000000000000000)))
    (expr (call (. motion step) (& m) css xb (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (. (call (. xform of) css (. m ov) (float 0x4059000000000000) (float 0x4044000000000000)) e) (float 0x4024000000000000) "transition to translate(2em) halfway"))
    (let sk _ (call style1 mem css "kf"))
    (let k _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& k) css (- 1) sk (float 0x0000000000000000)))
    (expr (call (. motion step) (& k) css sk (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (. (call (. xform of) css (. k ov) (float 0x4059000000000000) (float 0x4044000000000000)) e) (float 0x4024000000000000) "keyframes to translate(2em) halfway"))
    (expr (call (. motion step) (& k) css sk (float 0x4062c00000000000) (float 0x0000000000000000)))
    (expr (call near (. (call (. xform of) css (. k ov) (float 0x4059000000000000) (float 0x4044000000000000)) e) (float 0x4034000000000000) "keyframes end at 2em"))
    (let va _ (call style1 mem css "av"))
    (let vb _ (call style1 mem css "av2"))
    (let vm _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& vm) css va vb (float 0x0000000000000000)))
    (let last f32 (- (float 0x3ff0000000000000)))
    (for f (.. 1 1000) (block
      (let tm _ (call f32 (% f 200)))
      (expr (call (. motion step) (& vm) css vb tm (float 0x0000000000000000)))
      (let xv _ (call (. xform of) css vb (float 0x4059000000000000) (float 0x4044000000000000)))
      (if (> (call (. motion live) (& vm)) 0) (block
        (= xv (call (. xform of) css (. vm ov) (float 0x4059000000000000) (float 0x4044000000000000)))))
      (expr (call near (. xv e) (float 0x4034000000000000) "em part of a translate that reads an animated var stays 1em"))
      (if (< f 100) (block
        (expr (call near (. xv f) (* (call f32 f) (float 0x3fd999999999999a)) "var(--ty) animates in the translate"))
        (= last (. xv f))))))
    (expr (call near last (float 0x4043cccccccccccd) "animated var reached its end"))
    (expr (call near (. (call (. xform of) css (call style1 mem css "vd") (float 0x4059000000000000) (float 0x4044000000000000)) e) (float 0x4034000000000000) "translate(var(--d)) with --d: 1em"))
    (let vp _ (call style1 mem css "vp"))
    (expr (call near (. (call (. xform of) css vp (float 0x4059000000000000) (float 0x4044000000000000)) e) (. (call (. css get) vp P_WIDTH) f) "translate: var(--pl) with a registered <length> matches width"))))
  (const GROW string ".g1 { width: 50px; height: 20px; font-size: 20px; transform: translate(1em, 0px); } .g2 { width: 50px; height: 20px; font-size: 10px; transform: translate(1em, 0px); } .gh { width: 50px; height: 20px; font-size: 20px; transform: translate(1em, 0px); } .gh:hover { font-size: 10px; } .gc { width: 50px; height: 20px; transform: translate(1em, 0px); }")
  (fn (doc "Add class `on`, drop class `off` (`cls` only adds); with `n` >= 0 the element is a parent whose `style:font-size` is\n10 or 20 px and a child of class `gc` (an em transform, font-size inherited, its own `style:width` changing so it rebuilds) is the one returned.") gframe (params (d (ref Dom)) (on string) (off string) (n int)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) e on))
    (if (> (. off len) 0) (block
      (expr (call (. d clsIf) e off (bool false)))))
    (if (>= n 0) (block
      (expr (call (. d styleNum) e 0 "font-size" (if-expr (== (% n 2) 0) (float 0x4024000000000000) (float 0x4034000000000000))))
      (= e (call (. d open) 1 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "gc"))
      (expr (call (. d styleNum) e 0 "width" (if-expr (== (% n 2) 0) (float 0x4049000000000000) (float 0x404e000000000000))))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return e)))
  (fn (doc "Paints floats added by 1800 changes of an inline `transform` (`a` and `b` alternate) after a warm-up.") inlineGrowth (params (d (ref Dom)) (css (ref Css)) (a string) (b string)) int (block
    (let sv _ 0)
    (for i (.. 0 2000) (block
      (if (== i 200) (block
        (= sv (. (. css paints) len))))
      (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
      (let se _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) se "gc"))
      (expr (call (. d styleStr) se 0 "transform" (if-expr (== (% i 2) 0) a b)))
      (expr (call (. d close)))
      (expr (call (. d layout)))
      (expr (call (. d endFrame)))))
    (return (- (. (. css paints) len) sv))))
  (fn (doc "Restyling an element with an em transform (class toggle, hover on/off, a dynamic `style:font-size`) reuses the px copy.") testGrowth (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) GROW "g.css" 0))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let base _ 0)
    (for i (.. 0 10400) (block
      (if (== i 400) (block
        (= base (. (. css paints) len))))
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (let e _ (call gframe (& d) (if-expr (== (% i 2) 0) "g1" "g2") (if-expr (== (% i 2) 0) "g2" "g1") (- 1)))
      (let n _ (& (index (. (. d nodes) items) e)))
      (expr (call near (. (call (. xform of) (& css) (. n style) (. n w) (. n h)) e) (if-expr (== (% i 2) 0) (float 0x4034000000000000) (float 0x4024000000000000)) "a class with another font-size moves the em transform"))))
    (expr (call ok (== (. (. css paints) len) base) "class toggles with em transforms do not grow paints"))
    (for i (.. 0 10400) (block
      (if (== i 400) (block
        (= base (. (. css paints) len))))
      (expr (call (. d simInput) (if-expr (== (% i 2) 0) (float 0x4014000000000000) (- (float 0x4014000000000000))) (float 0x4014000000000000) (bool false) (float 0x0000000000000000)))
      (expr (call gframe (& d) "gh" "" (- 1)))))
    (expr (call ok (== (. (. css paints) len) base) "hover on and off does not grow paints"))
    (for i (.. 0 10400) (block
      (if (== i 400) (block
        (= base (. (. css paints) len))))
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (let fe _ (call gframe (& d) "g1" "g2" i))
      (let fnode _ (& (index (. (. d nodes) items) fe)))
      (expr (call near (. (call (. xform of) (& css) (. fnode style) (. fnode w) (. fnode h)) e) (if-expr (== (% i 2) 0) (float 0x4024000000000000) (float 0x4034000000000000)) "a parent's style:font-size moves the inherited em transform"))))
    (expr (call ok (== (. (. css paints) len) base) "a parent's changing style:font-size does not grow paints"))
    (let px _ (call inlineGrowth (& d) (& css) "translate(1px, 0px)" "translate(2px, 0px)"))
    (let em _ (call inlineGrowth (& d) (& css) "translate(1em, 0px)" "translate(2em, 0px)"))
    (expr (call ok (<= em px) "resolving an inline em transform adds no paints beyond its parse"))))
  (fn testHit (params (d (ref Dom)) (css (ref Css))) _ (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let e _ (call frame d "hit"))
    (let n _ (& (index (. (. d nodes) items) e)))
    (let m _ (call (. xform of) css (. n style) (. n w) (. n h)))
    (expr (call ok (&& (. m on) (== (. n w) (float 0x4059000000000000))) "laid out"))
    (let ix f32 (float 0x4051800000000000))
    (let iy f32 (float 0x4024000000000000))
    (expr (call ok (call click d "hit" (+ (+ (+ (* (. m a) ix) (* (. m c) iy)) (. m e)) (. n x)) (+ (+ (+ (* (. m b) ix) (* (. m d) iy)) (. m f)) (. n y))) "mapped inside point hits"))
    (let ox f32 (- (float 0x4018000000000000)))
    (let oy f32 (float 0x4024000000000000))
    (expr (call ok (! (call click d "hit" (+ (+ (+ (* (. m a) ox) (* (. m c) oy)) (. m e)) (. n x)) (+ (+ (+ (* (. m b) ox) (* (. m d) oy)) (. m f)) (. n y)))) "mapped outside point misses"))
    (expr (call ok (! (call click d "hit" (float 0x4051800000000000) (float 0x4024000000000000))) "the untransformed spot misses"))
    (expr (call ok (! (call click d "sing" (float 0x4049000000000000) (float 0x4034000000000000))) "scale(0) is not hittable"))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let he _ (call frame d "hem"))
    (let hn _ (& (index (. (. d nodes) items) he)))
    (expr (call ok (call click d "hem" (+ (+ (. hn x) (float 0x4044000000000000)) (float 0x4024000000000000)) (+ (. hn y) (float 0x4024000000000000))) "em-moved box hits at its new spot"))
    (expr (call ok (! (call click d "hem" (+ (. hn x) (float 0x4024000000000000)) (+ (. hn y) (float 0x4024000000000000)))) "em-moved box misses at the old spot"))))
  (fn mat (params (a f32) (b f32) (c f32) (d f32) (e f32) (f f32)) Xf (block
    (return (struct-lit Xf (field on (bool true)) (field a a) (field b b) (field c c) (field d d) (field e e) (field f f)))))
  (fn same (params (m (ref Xf)) (n (ref Xf)) (msg string)) _ (block
    (expr (call near (. m a) (. n a) msg))
    (expr (call near (. m b) (. n b) msg))
    (expr (call near (. m c) (. n c) msg))
    (expr (call near (. m d) (. n d) msg))
    (expr (call near (. m e) (. n e) msg))
    (expr (call near (. m f) (. n f) msg))))
  (fn (doc "Taking a matrix apart for a blend and putting it back is exact, reflections and shear included.") testDecompose (params) _ (block
    (let ms _ (array-lit (call mat (float 0x3ff0000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3ff0000000000000) (float 0x4008000000000000) (float 0x4010000000000000)) (call mat (float 0x0000000000000000) (float 0x3ff0000000000000) (- (float 0x3ff0000000000000)) (float 0x0000000000000000) (float 0x3ff0000000000000) (float 0x4000000000000000)) (call mat (float 0x4000000000000000) (float 0x0000000000000000) (float 0x3ff0000000000000) (float 0x3fe0000000000000) (float 0x4014000000000000) (float 0x4018000000000000)) (call mat (float 0x3ff0000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (- (float 0x3ff0000000000000)) (float 0x0000000000000000) (float 0x0000000000000000)) (call mat (- (float 0x3ff0000000000000)) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3ff0000000000000) (float 0x0000000000000000) (float 0x0000000000000000)) (call mat (float 0x0000000000000000) (float 0x3ff0000000000000) (float 0x3ff0000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)) (call mat (- (float 0x4008000000000000)) (float 0x3fe0000000000000) (float 0x3ff0000000000000) (float 0x4000000000000000) (float 0x0000000000000000) (float 0x401c000000000000))))
    (for i (.. 0 7) (block
      (let r _ (call (. xform roundTrip) (& (index ms i))))
      (expr (call same (& r) (& (index ms i)) "round trip"))))))
  (fn (doc "A list blended into a reflected matrix starts at the from-matrix and ends exactly on the target.") testReflectBlend (params) _ (block
