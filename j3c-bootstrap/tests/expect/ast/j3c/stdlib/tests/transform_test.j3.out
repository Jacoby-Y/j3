  (fn micros (params) int (block
    (let ts (array 2 int) (array-lit 0 0))
    (expr (syscall 228 1 (& (index ts 0))))
    (return (+ (* (index ts 0) 1000000) (/ (index ts 1) 1000)))))
  (fn (doc "200 transformed boxes composed 100 times (a repaint of an idle page): per-call cost, and nothing allocates.") bench (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let st _ (call style1 mem css "hit"))
    (let used _ (. mem used))
    (let t0 _ (call micros))
    (let acc f32 (float 0x0000000000000000))
    (for r (.. 0 100) (block
      (for i (.. 0 200) (block
        (= acc (+ acc (. (call (. xform of) css st (float 0x4059000000000000) (float 0x4044000000000000)) a)))))))
    (let us _ (- (call micros) t0))
    (expr (call ok (== (. mem used) used) "composing a transform allocates nothing"))
    (expr (call printLn (interp "xform.of: 200 nodes, 100 frames: " (/ us 100) " us per frame")))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
