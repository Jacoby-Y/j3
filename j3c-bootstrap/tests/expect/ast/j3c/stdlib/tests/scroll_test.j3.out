(file (module scroll_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom (names Dom SC_CENTER SC_END SC_NEAREST SC_START))
  (use j3.ui.inputs)
  (use j3.ui.vlist)
  (use j3.ui.vstate.VList)
  (const SHEET string ".car { display: flex; width: 300px; height: 100px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; } .card { flex-shrink: 0; width: 100px; height: 100px; scroll-snap-align: start; } .card.wide { width: 150px; } .col { width: 100px; height: 100px; overflow-y: auto; scroll-snap-type: y mandatory; } .prox { scroll-snap-type: y proximity; } .pad { scroll-padding-top: 10px; } .row { height: 50px; scroll-snap-align: start; } .big { height: 200px; } .alw { scroll-snap-stop: always; } .outer { width: 100px; height: 100px; overflow-y: auto; } .outer.pm { scroll-padding-top: 15px; } .inner { height: 80px; overflow-y: auto; } .spacer { height: 200px; } .tgt { height: 20px; } .pm .tgt { scroll-margin-top: 5px; } .fill { height: 120px; } .tail { height: 300px; } .btn { display: block; height: 20px; } dialog { width: 80px; height: 300px; } .dbtn { display: block; margin-top: 250px; height: 20px; } .gone { display: none; } .virt { box-sizing: border-box; width: 100px; height: 100px; overflow-y: auto; } .vrow { height: 30px; } .vrow.tall { height: 50px; }")
  (mod-let CHECKS int _)
  (mod-let ID (array 12 int) _)
  (mod-let UID (array 1100 int) _)
  (mod-let ORDER (array 6 int) _)
  (mod-let CARD (array 7 int) _)
  (mod-let DROP2 bool _)
  (mod-let EXTRA bool _)
  (mod-let HIDEV bool _)
  (mod-let MODAL bool _)
  (mod-let DB int _)
  (mod-let WIDE bool _)
  (mod-let PM bool _)
  (mod-let VLF VList _)
  (mod-let VLV VList _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (let e _ (- a b))
    (if (< e (float 0x0000000000000000)) (block
      (= e (- (float 0x0000000000000000) e))))
    (if (> e (float 0x3fe3333333333333)) (block
      (expr (call printLn (interp msg ": " a " vs " b)))))
    (expr (call ok (<= e (float 0x3fe3333333333333)) msg))))
  (fn column (params (d (ref Dom)) (k int) (cls string) (big bool) (always bool)) _ (block
    (let c _ (call (. d open) k (call (. d tag) "div") 1))
    (expr (call (. d cls) c "col"))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) c cls))))
    (= (index ID k) c)
    (for i (.. 0 6) (block
      (let r _ (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d cls) r "row"))
      (if big (block
        (expr (call (. d cls) r "big"))))
      (if always (block
        (expr (call (. d cls) r "alw"))))
      (expr (call (. d close)))))
    (expr (call (. d close)))))
  (fn (doc "A virtual list built the way generated code does: keys `k0`.., window from `vlist.step`.") virt (params (d (ref Dom)) (k int) (v (ref VList)) (variable bool)) _ (block
    (let n _ 100)
    (let b _ (call (. d open) k (call (. d tag) "div") 1))
    (expr (call (. d cls) b "virt"))
    (if (== k 10) (block
      (expr (call (. d clsIf) b "gone" HIDEV))))
    (= (index ID k) b)
    (expr (call (. v cfg) (if-expr variable (float 0x0000000000000000) (float 0x403e000000000000)) (float 0x403e000000000000) (bool false) (bool false)))
    (if (call (. v stale) n) (block
      (expr (call (. (. v all) begin)))
      (for i (.. 0 n) (block
        (expr (call (. (. v all) add) (interp "k" i)))))
      (expr (call (. (. v all) finish) "virt"))
      (expr (call (. v rebuilt) n))))
    (let w _ (call (. vlist step) d b v n))
    (for q (.. 0 (. v cnt)) (block
      (let i _ (call (. v at) q))
      (if (< (index UID (+ (* k 100) i)) 0) (block
        (= (index UID (+ (* k 100) i)) (call (. d groupNew) (- 1)))))
      (expr (call (. d keyBegin) (index UID (+ (* k 100) i))))
      (let r _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) r "vrow"))
      (if (&& variable (== (% i 2) 1)) (block
        (expr (call (. d cls) r "tall"))))
      (expr (call (. d attrId) r (interp "r" k "_" i)))
      (expr (call (. d close)))
      (expr (call (. d keyEnd)))))
    (expr (call (. d close)))))
  (fn (doc "One keyed carousel card, as `{#each cards as c (c)}` makes it: it follows its key when the order changes.") card (params (d (ref Dom)) (key int)) _ (block
    (if (< (index UID (+ 1000 key)) 0) (block
      (= (index UID (+ 1000 key)) (call (. d groupNew) (- 1)))))
    (expr (call (. d keyBegin) (index UID (+ 1000 key))))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) c "card"))
    (expr (call (. d clsIf) c "wide" WIDE))
    (= (index CARD key) c)
    (expr (call (. d close)))
    (expr (call (. d keyEnd)))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x408f400000000000)))))
    (expr (call (. inputs begin) d))
    (let car _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) car "car"))
    (= (index ID 0) car)
    (for q (.. 0 6) (block
      (if (! (&& DROP2 (== (index ORDER q) 2))) (block
        (expr (call card d (index ORDER q)))))))
    (if EXTRA (block
      (expr (call card d 6))))
    (expr (call (. d close)))
    (expr (call column d 1 "" (bool false) (bool false)))
    (expr (call column d 2 "prox" (bool true) (bool false)))
    (expr (call column d 3 "" (bool false) (bool true)))
    (expr (call column d 4 "pad" (bool false) (bool false)))
    (let o _ (call (. d open) 5 (call (. d tag) "div") 1))
    (expr (call (. d cls) o "outer"))
    (expr (call (. d clsIf) o "pm" PM))
    (= (index ID 5) o)
    (let f _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) f "fill"))
    (let vb _ (call (. d open) 4 (call (. d tag) "button") 1))
    (expr (call (. d cls) vb "btn"))
    (= (index ID 11) vb)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let inn _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) inn "inner"))
    (= (index ID 6) inn)
    (let sp _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) sp "spacer"))
    (expr (call (. d close)))
    (let t _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) t "tgt"))
    (expr (call (. d attrId) t "tgt"))
    (= (index ID 7) t)
    (expr (call (. d close)))
    (let tl _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) tl "tail"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let tl2 _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) tl2 "tail"))
    (expr (call (. d close)))
    (if MODAL (block
      (let dg _ (call (. d open) 5 (call (. d tag) "dialog") 1))
      (expr (call (. d attrOverlay) dg (. dom OV_MODAL)))
      (let db _ (call (. d open) 0 (call (. d tag) "button") 1))
      (expr (call (. d cls) db "dbtn"))
      (= DB db)
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (let bt _ (call (. d open) 3 (call (. d tag) "button") 1))
    (expr (call (. d cls) bt "btn"))
    (= (index ID 8) bt)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call virt d 9 (& VLF) (bool false)))
    (expr (call virt d 10 (& VLV) (bool true)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn idle (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d))))))
  (fn cx (params (d (ref Dom)) (id int)) f32 (block
    (return (+ (call (. d absX) id) (/ (. (index (. (. d nodes) items) id) w) (float 0x4000000000000000))))))
  (fn cy (params (d (ref Dom)) (id int)) f32 (block
    (return (+ (call (. d absY) id) (/ (. (index (. (. d nodes) items) id) h) (float 0x4000000000000000))))))
  (fn (doc "`notches` forward over the middle of `id`.") wheel (params (d (ref Dom)) (id int) (notches f32)) _ (block
    (expr (call (. d simInput) (call cx d id) (call cy d id) (bool false) (- (float 0x0000000000000000) notches)))
    (expr (call frame d))))
  (fn sy (params (d (ref Dom)) (k int)) f32 (block
    (return (. (index (. (. d nodes) items) (index ID k)) scrollY))))
  (fn sx (params (d (ref Dom)) (k int)) f32 (block
    (return (. (index (. (. d nodes) items) (index ID k)) scrollX))))
  (fn testSnap (params (d (ref Dom))) _ (block
    (expr (call ok (&& (== (call sx d 0) (float 0x0000000000000000)) (== (. (index (. (. d nodes) items) (index ID 0)) scrollMaxX) (float 0x4072c00000000000))) "carousel starts at 0 and can scroll 300"))
    (expr (call wheel d (index ID 0) (float 0x4000000000000000)))
    (expr (call near (call sx d 0) (float 0x4058000000000000) "two notches scroll 96 px at once"))
    (expr (call idle d 2))
    (expr (call near (call sx d 0) (float 0x4058000000000000) "the box waits for the gesture to rest before snapping"))
    (expr (call ok (call (. d isLive)) "live while a snap is pending"))
    (expr (call idle d 10))
    (expr (call ok (|| (&& (> (call sx d 0) (float 0x4058000000000000)) (< (call sx d 0) (float 0x4059000000000000))) (call (. d isLive))) "the settle animates"))
    (expr (call ok (call (. d isLive)) "live while the settle runs"))
    (expr (call idle d 60))
    (expr (call near (call sx d 0) (float 0x4059000000000000) "mandatory snap lands on the nearest card"))
    (expr (call ok (&& (! (call (. d isLive))) (== (. d snapPend) 0)) "idle after the settle"))
    (expr (call wheel d (index ID 0) (float 0x3ff0000000000000)))
    (expr (call idle d 70))
    (expr (call near (call sx d 0) (float 0x4059000000000000) "48 px past a snap point returns to it"))
    (expr (call wheel d (index ID 0) (float 0x4014000000000000)))
    (expr (call idle d 70))
    (expr (call near (call sx d 0) (float 0x4072c00000000000) "the last card (clamped range) is a snap point"))
    (expr (call wheel d (index ID 0) (- (float 0x3ff0000000000000))))
    (expr (call idle d 70))
    (expr (call near (call sx d 0) (float 0x4072c00000000000) "backwards 48 px from 300 snaps back to 300"))
    (expr (call (. d scrollBy) (index ID 2) (float 0x4048000000000000)))
    (expr (call idle d 70))
    (expr (call near (call sy d 2) (float 0x4048000000000000) "proximity: 48 px from a point 200 px apart (view 100) stays"))
    (expr (call (. d scrollBy) (index ID 2) (- (float 0x403c000000000000))))
    (expr (call idle d 70))
    (expr (call near (call sy d 2) (float 0x0000000000000000) "proximity: 20 px from a point snaps to it"))
    (for i (.. 0 4) (block
      (expr (call wheel d (index ID 3) (float 0x3ff0000000000000)))))
    (expr (call near (call sy d 3) (float 0x4068000000000000) "four notches in one gesture"))
    (expr (call idle d 70))
    (expr (call near (call sy d 3) (float 0x4049000000000000) "always: the gesture stops at the first row it reached"))
    (for i (.. 0 4) (block
      (expr (call wheel d (index ID 1) (float 0x3ff0000000000000)))))
    (expr (call idle d 70))
    (expr (call near (call sy d 1) (float 0x4069000000000000) "normal stop: the nearest point, the end"))
    (expr (call wheel d (index ID 4) (float 0x3ff0000000000000)))
    (expr (call idle d 70))
    (expr (call near (call sy d 4) (float 0x4044000000000000) "scroll-padding-top 10 puts the row 10 px below the top"))
    (expr (call ok (! (call (. d isLive))) "steady after every settle"))
    (expr (call wheel d (index ID 0) (- (float 0x4010000000000000))))
    (expr (call idle d 70))
    (expr (call (. d scrollTo) (index ID 0) (float 0x4059000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call near (call sx d 0) (float 0x4059000000000000) "scrollTo a snap point"))
    (= WIDE (bool true))
    (expr (call frame d))
    (expr (call near (call sx d 0) (float 0x4062c00000000000) "after cards grow the box is still on the second card"))
    (= WIDE (bool false))
    (expr (call frame d))
    (expr (call near (call sx d 0) (float 0x4059000000000000) "and back"))
    (expr (call (. d scrollTo) (index ID 0) (float 0x4060400000000000) (float 0x0000000000000000) (bool false)))
    (expr (call near (call sx d 0) (float 0x4059000000000000) "scrollTo snaps to the nearest point"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call wheel d (index ID 0) (float 0x4000000000000000)))
    (expr (call idle d 9))
    (expr (call near (call sx d 0) (float 0x4069000000000000) "reduced motion: the snap is a jump"))
    (expr (call ok (! (call (. d isLive))) "no animation under reduced motion"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call (. d scrollTo) (index ID 0) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call idle d 3))
    (let work _ (. d snapWork))
    (let laid _ (. d laid))
    (let styled _ (. d restyled))
    (expr (call idle d 40))
    (expr (call ok (&& (&& (&& (&& (== (. d snapWork) work) (== (. d laid) laid)) (== (. d restyled) styled)) (== (. d snapPend) 0)) (! (. d snapDirty))) "idle frames with snap containers do no snap, layout or style work"))
    (expr (call (. d scrollTo) (index ID 0) (float 0x4069000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call ok (== (index CARD 2) (. (index (. (. d nodes) items) (index ID 0)) snapKx)) "card with key 2 is the snapped item"))
    (for q (.. 0 6) (block
      (= (index ORDER q) (- 5 q))))
    (expr (call frame d))
    (expr (call near (call sx d 0) (float 0x4072c00000000000) "after a reverse sort the box follows key 2 to index 3"))
    (expr (call near (- (call (. d absX) (index CARD 2)) (call (. d absX) (index ID 0))) (float 0x0000000000000000) "and it still sits at the start edge"))
    (for q (.. 0 6) (block
      (= (index ORDER q) q)))
    (expr (call frame d))
    (expr (call near (call sx d 0) (float 0x4069000000000000) "sorted back, back on index 2"))
    (expr (call (. d scrollTo) (index ID 0) (float 0x4069000000000000) (float 0x0000000000000000) (bool false)))
    (let old _ (index CARD 2))
    (expr (call ok (== (. (index (. (. d nodes) items) (index ID 0)) snapKx) old) "snapped to card 2"))
    (expr (call (. d scrollByX) (index ID 0) (float 0x3ff0000000000000)))
    (= DROP2 (bool true))
    (expr (call frame d))
    (= EXTRA (bool true))
    (expr (call frame d))
    (expr (call ok (== (index CARD 6) old) "the new card reuses the freed node id"))
    (= (. (index (. (. d nodes) items) (index ID 0)) snapAt) (- (float 0x3ff0000000000000)))
    (= (. d snapPend) 0)
    (= WIDE (bool true))
    (expr (call frame d))
    (expr (call ok (== (. (index (. (. d nodes) items) (index ID 0)) snapKx) (- 1)) "the reused id is not taken for the snapped card"))
    (= WIDE (bool false))
    (= DROP2 (bool false))
    (= EXTRA (bool false))
    (expr (call frame d))
    (expr (call (. d scrollTo) (index ID 0) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call idle d 3))))
  (fn testIntoView (params (d (ref Dom))) _ (block
    (expr (call frame d))
    (expr (call ok (&& (== (call (. d byId) "tgt") (index ID 7)) (== (call (. d byId) "nope") (- 1))) "byId finds a static id, -1 for none"))
    (expr (call (. d scrollIntoView) (index ID 7) SC_START (bool false)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4069000000000000) "start: the inner box scrolls the target to its top"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x405e000000000000) "start: then the outer box brings the inner one up"))
    (expr (call (. d scrollIntoView) (index ID 7) SC_CENTER (bool false)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4065400000000000) "center: inner"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x405b800000000000) "center: outer"))
    (expr (call (. d scrollIntoView) (index ID 7) SC_NEAREST (bool false)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4065400000000000) "nearest: nothing moves when it shows"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x405b800000000000) "nearest: outer too"))
    (expr (call (. d scrollIntoView) (index ID 7) SC_END (bool false)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4061800000000000) "end: inner"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x4059000000000000) "end: outer"))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call (. d scrollTo) (index ID 6) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (= PM (bool true))
    (expr (call frame d))
    (expr (call (. d scrollIntoView) (index ID 7) SC_START (bool false)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4068600000000000) "scroll-margin-top 5 of the target"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x405a400000000000) "scroll-padding-top 15 of the outer box"))
    (= PM (bool false))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call (. d scrollTo) (index ID 6) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call frame d))
    (expr (call (. d scrollIntoView) (index ID 7) SC_START (bool true)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x0000000000000000) "smooth: nothing moves at once"))
    (expr (call ok (call (. d isLive)) "smooth scroll is live"))
    (expr (call idle d 5))
    (expr (call ok (&& (> (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x0000000000000000)) (< (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4069000000000000))) "smooth: on the way"))
    (expr (call idle d 80))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4069000000000000) "smooth: arrives (inner)"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x405e000000000000) "smooth: arrives (outer)"))
    (expr (call ok (! (call (. d isLive))) "smooth scroll ends"))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call (. d scrollTo) (index ID 6) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call (. d scrollIntoView) (index ID 7) SC_START (bool true)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) scrollY) (float 0x4069000000000000) "reduced motion: smooth is instant"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call (. d scrollTo) (index ID 6) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call idle d 2))
    (expr (call (. d setKeyboard) (bool true)))
    (expr (call (. d focusNode) (index ID 8)))
    (expr (call idle d 3))
    (expr (call ok (> (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x0000000000000000)) "keyboard focus scrolls the box"))
    (let b _ (index ID 8))
    (expr (call ok (&& (>= (call (. d absY) b) (- (call (. d absY) (index ID 5)) (float 0x3fe0000000000000))) (<= (+ (call (. d absY) b) (float 0x4034000000000000)) (+ (call (. d absY) (index ID 5)) (float 0x4059200000000000)))) "and the button is inside it"))
    (expr (call (. d setKeyboard) (bool false)))
    (expr (call (. d focusNode) (- 1)))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call idle d 2))
    (expr (call (. d setKeyboard) (bool true)))
    (expr (call (. d focusNode) (index ID 11)))
    (expr (call idle d 3))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x0000000000000000) "focusing a fully visible button scrolls nothing"))
    (expr (call (. d scrollTo) (index ID 5) (float 0x4024000000000000) (float 0x0000000000000000) (bool false)))
    (expr (call idle d 2))
    (expr (call (. d focusNode) (- 1)))
    (expr (call (. d focusNode) (index ID 11)))
    (expr (call idle d 3))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x0000000000000000) "a button half out of view is brought in (nearest)"))
    (expr (call (. d scrollTo) (index ID 5) (float 0x0000000000000000) (float 0x0000000000000000) (bool false)))
    (= MODAL (bool true))
    (expr (call idle d 3))
    (expr (call ok (&& (. (index (. (. d nodes) items) DB) laid) (>= (call (. d absY) DB) (+ (call (. d absY) (index ID 5)) (float 0x4058e00000000000)))) "the dialog's button is below the box's view"))
    (expr (call (. d setKeyboard) (bool true)))
    (expr (call (. d focusNode) DB))
    (expr (call idle d 4))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) scrollY) (float 0x0000000000000000) "focus in a modal dialog does not scroll the page behind it"))
    (= MODAL (bool false))
    (expr (call (. d setKeyboard) (bool false)))
    (expr (call (. d focusNode) (- 1)))
    (expr (call idle d 3))))
  (fn rowTop (params (d (ref Dom)) (k int) (i int)) f32 (block
    (let r _ (call (. d byId) (interp "r" k "_" i)))
    (expr (call ok (>= r 0) (interp "row " i " is built")))
    (return (- (call (. d absY) r) (call (. d absY) (index ID k))))))
  (fn testVirtual (params (d (ref Dom))) _ (block
    (expr (call idle d 2))
    (expr (call ok (== (call (. d byId) "r9_60") (- 1)) "row 60 is not built yet"))
    (expr (call ok (! (call (. d scrollToKey) (index ID 9) "nokey" SC_START)) "an unknown key is refused"))
    (expr (call ok (! (call (. d scrollToKey) (index ID 3) "k1" SC_START)) "a box that is no virtual list is refused"))
    (expr (call ok (call (. d scrollToKey) (index ID 9) "k60" SC_START) "scrollToKey accepts a known key"))
    (expr (call idle d 2))
    (expr (call near (call sy d 9) (float 0x409c200000000000) "fixed rows: the box scrolled to row 60"))
    (expr (call near (call rowTop d 9 60) (float 0x0000000000000000) "row 60 is at the top"))
    (expr (call ok (call (. d scrollToKey) (index ID 9) "k10" SC_CENTER) "center"))
    (expr (call idle d 2))
    (expr (call near (call rowTop d 9 10) (float 0x4041800000000000) "row 10 is centered"))
    (expr (call ok (call (. d scrollToKey) (index ID 9) "k99" SC_END) "end"))
    (expr (call idle d 2))
    (expr (call near (call rowTop d 9 99) (float 0x4051800000000000) "row 99 ends at the bottom"))
    (expr (call idle d 2))
    (expr (call ok (call (. d scrollToKey) (index ID 10) "k61" SC_START) "variable list accepts the key"))
    (expr (call idle d 6))
    (expr (call near (call rowTop d 10 61) (float 0x0000000000000000) "variable rows: row 61 ends at the top once measured"))
    (let y _ (call sy d 10))
    (expr (call idle d 5))
    (expr (call near (call sy d 10) y "and stays there"))
    (expr (call ok (call (. d scrollToKey) (index ID 10) "k5" SC_START) "scroll back up"))
    (expr (call idle d 6))
    (expr (call near (call rowTop d 10 5) (float 0x0000000000000000) "row 5 at the top"))
    (expr (call ok (call (. d scrollToKey) (index ID 10) "k90" SC_START) "aim again"))
    (= HIDEV (bool true))
    (expr (call idle d 4))
    (expr (call ok (&& (== (. VLV want) (- 1)) (! (call (. d isLive)))) "a hidden list drops the aim and is not live"))
    (= HIDEV (bool false))
    (expr (call idle d 3))
    (expr (call ok (call (. d scrollToKey) (index ID 10) "k40" SC_START) "aim"))
    (= (. VLV wantN) 31)
    (expr (call idle d 2))
    (expr (call ok (== (. VLV want) (- 1)) "the aim is given up after its tries"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "scroll.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (for q (.. 0 1100) (block
      (= (index UID q) (- 1))))
    (for q (.. 0 6) (block
      (= (index ORDER q) q)))
    (= VLF (call (. VList new) (& mem)))
    (= VLV (call (. VList new) (& mem)))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call idle (& d) 3))
    (expr (call testSnap (& d)))
    (expr (call testIntoView (& d)))
    (expr (call testVirtual (& d)))
    (let used _ (. (. d mem) used))
    (let laid _ (. d laid))
    (expr (call idle (& d) 30))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (! (call (. d isLive)))) "idle frames after all that allocate and lay out nothing"))
    (expr (call printLn (interp "scroll_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
