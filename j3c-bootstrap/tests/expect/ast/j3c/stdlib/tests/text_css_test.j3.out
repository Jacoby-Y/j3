    (expr (call (. d cls) v "visible"))
    (expr (call (. d styleStr) v 1 "display" "block"))
    (expr (call (. d text) "v"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let z _ (call (. d open) 4 (call (. d tag) "button") 1))
    (expr (call (. d styleStr) z 1 "display" "block"))
    (expr (call (. d text) "z"))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call (. d focusNode) a))
    (= (. (. d kin) tab) (bool true))
    (expr (call (. inputs begin) (& d)))
    (= (. (. d kin) tab) (bool false))
    (expr (call ok (== (. d focus) v) "Tab skips the hidden button and stops on its visible child"))
    (= (. (. d kin) tab) (bool true))
    (expr (call (. inputs begin) (& d)))
    (= (. (. d kin) tab) (bool false))
    (expr (call ok (== (. d focus) z) "Tab goes on past the visible child"))
    (= (. (. d kin) tab) (bool true))
    (= (. (. d kin) shift) (bool true))
    (expr (call (. inputs begin) (& d)))
    (= (. (. d kin) tab) (bool false))
    (= (. (. d kin) shift) (bool false))
    (expr (call ok (== (. d focus) v) "Shift+Tab stops on the visible child, not the hidden sibling"))
    (let font _ (call loadFont FONTPATH 16))
    (let lh _ (call f32 (call fontLine font)))
    (let m _ (call (. Dom new) mem css))
    (expr (call (. m begin)))
    (let owner _ (call (. m open) 0 (call (. m tag) "div") 1))
    (expr (call (. m cls) owner "box"))
    (expr (call (. m cls) owner "clampSpan"))
    (expr (call (. m text) "alpha beta gamma "))
    (let sp _ (call (. m open) 1 (call (. m tag) "span") 1))
