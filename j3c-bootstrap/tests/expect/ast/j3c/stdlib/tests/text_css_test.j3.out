  (fn (doc "Tab skips a hidden button, stops on its visible child; line-clamp counts the whole inline context; inputs ignore white-space.") testTabClampInput (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let a _ (call (. d open) 0 (call (. d tag) "button") 1))
    (expr (call (. d styleStr) a 1 "display" "block"))
