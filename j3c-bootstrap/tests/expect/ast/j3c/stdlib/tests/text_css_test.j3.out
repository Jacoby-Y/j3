    (expr (call (. d cls) wrap "hidden"))
    (let h _ (call (. d open) 2 (call (. d tag) "button") 1))
    (expr (call (. d styleStr) h 1 "display" "block"))
    (expr (call (. d text) "h"))
    (expr (call (. d close)))
