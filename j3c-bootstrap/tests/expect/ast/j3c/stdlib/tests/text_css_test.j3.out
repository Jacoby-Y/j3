(file (module text_css_test)
  (use j3.game (names selRectW selRectX textBidi textCaretX textIndexAt textSelRects Font fontFallback fontLine fontShape loadFont textShaping textWidth tryLoadFont))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.math.Vec2)
  (use j3.sys.panic)
  (use j3.text (names Text fmtBytes fmtInt same))
  (use j3.ui.css (names Css CLIP_TEXT P_BG_CLIP P_OVERFLOW_WRAP P_OVERFLOW_Y P_STROKE_COLOR P_STROKE_WIDTH P_TEXT_SHADOW V_SHADOW WRAP_BREAK))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.textanim)
  (use j3.ui.dom)
  (use j3.ui.inputs)
  (use j3.ui.textsel)
  (use j3.ui.textfit)
  (mod-let FONTPATH string _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } @font-face { font-family: \"S\"; src: url(\"examples/big_ui_test/assets/symbols.ttf\"); } .box { font-family: \"T\"; font-size: 16px; width: 100px; } .nw { white-space: nowrap; } .el { white-space: nowrap; text-overflow: ellipsis; overflow-y: hidden; } .elv { white-space: nowrap; text-overflow: ellipsis; } .bw { overflow-wrap: break-word; } .pl { white-space: pre-line; } .fb { font-family: \"T\", \"S\", sans-serif; } .fn { font-family: \"T\", sans-serif; font-size: 16px; width: 100px; } .fx { text-shadow: 1px 2px 3px #ff0000, 0 0 5px #00ff00; -webkit-text-stroke: 2px #0000ff; -webkit-background-clip: text; word-wrap: break-word; overflow: hidden; }")
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (fn size (params (s string)) int (block
    (return (. s len))))
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (struct Built
    (field d Dom)
    (field id int))
  (fn (doc "A fresh tree with one `.box` block of `cls` and `text`, laid out at `w` x 400. A new `Dom` each time:\nclasses are only ever added to a reused node.") block (params (mem (ref Arena)) (css (ref Css)) (cls string) (text string) (w f32)) Built (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) id "box"))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) id cls))))
    (expr (call (. d text) text))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) w (float 0x4079000000000000)))
    (return (struct-lit Built (field d d) (field id id)))))
  (fn lines (params (b (ref Built))) int (block
    (let n _ 0)
    (let lastY f32 (- (float 0x408f400000000000)))
    (let f _ (. (index (. (. (. b d) nodes) items) (. b id)) frag0))
    (while (>= f 0) (block
      (let y _ (. (index (. (. (. b d) frags) items) f) y))
      (if (|| (> (- y lastY) (float 0x3fe0000000000000)) (> (- lastY y) (float 0x3fe0000000000000))) (block
        (+= n 1)
        (= lastY y)))
      (= f (. (index (. (. (. b d) frags) items) f) next))))
    (return n)))
  (fn lastFrag (params (b (ref Built))) Frag (block
    (let f _ (. (index (. (. (. b d) nodes) items) (. b id)) frag0))
    (while (>= (. (index (. (. (. b d) frags) items) f) next) 0) (block
      (= f (. (index (. (. (. b d) frags) items) f) next))))
    (return (index (. (. (. b d) frags) items) f))))
  (fn testTextCss (params (mem (ref Arena)) (css (ref Css))) _ (block
    (expr (call parse css ".pre { white-space: pre; } .pw { white-space: pre-wrap; } .clamp { line-clamp: 2; user-select: text; } .just { text-align: justify; user-select: text; } .justpre { text-align: justify; white-space: pre-line; } .hidden { visibility: hidden; } .visible { visibility: visible; } .clampSpan { line-clamp: 2; }" "textcss.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "new text properties parse"))
    (let font _ (call loadFont FONTPATH 16))
    (let lh _ (call f32 (call fontLine font)))
    (let pre _ (call block mem css "pre" "  alpha  beta  \n\t\xc3\xb1\n" (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& pre)) 2) "pre keeps explicit lines without wrapping"))
    (expr (call near (. (index (. (. (. pre d) nodes) items) (. pre id)) h) (* lh (float 0x4008000000000000)) (float 0x3f847ae147ae147b) "pre trailing newline retains blank final line"))
    (let f _ (. (index (. (. (. pre d) nodes) items) (. pre id)) frag0))
    (let first _ (index (. (. (. pre d) frags) items) f))
    (expr (call near (. first x) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "pre leading space starts at origin"))
    (let lastX f32 (float 0x0000000000000000))
    (let sawTab _ (bool false))
    (while (>= f 0) (block
      (let fr _ (index (. (. (. pre d) frags) items) f))
      (if (== (. fr y) (. first y)) (block
        (= lastX (+ (. fr x) (. fr w)))))
      (let tn _ (& (index (. (. (. pre d) nodes) items) (. fr node))))
      (if (&& (== (. fr end) (+ (. fr start) 1)) (== (index (. tn buf) (. fr start)) 9)) (block
        (expr (call near (. fr w) (* (call textWidth font (call bytes " ") (bool false)) (float 0x4020000000000000)) (float 0x3f847ae147ae147b) "tab stops at eight spaces"))
        (= sawTab (bool true))))
      (= f (. fr next))))
    (expr (call near lastX (call textWidth font (call bytes "  alpha  beta  ") (bool false)) (float 0x3f847ae147ae147b) "pre repeated and trailing spaces retain measured width"))
    (expr (call ok sawTab "pre tab has shared fragment geometry"))
    (expr (call (. (. pre d) styleStr) (. pre id) 0 "width" "40px"))
    (expr (call (. (. pre d) layoutAt) (float 0x4069000000000000) (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& pre)) 2) "pre never wraps after live resize"))
    (expr (call (. (. pre d) styleStr) (. pre id) 1 "white-space" "pre-wrap"))
    (expr (call (. (. pre d) layoutAt) (float 0x4069000000000000) (float 0x4079000000000000)))
    (expr (call ok (> (call lines (& pre)) 2) "live pre to pre-wrap invalidates geometry"))
    (let pw _ (call block mem css "pw" "alpha  beta gamma delta\n\xc3\xb1" (float 0x4079000000000000)))
    (expr (call ok (> (call lines (& pw)) 2) "pre-wrap preserves newline and wraps"))
    (let natural _ (call block mem css "" "alpha beta gamma delta epsilon zeta" (float 0x4079000000000000)))
    (let cl _ (call block mem css "clamp" "alpha beta gamma delta epsilon zeta" (float 0x4079000000000000)))
    (expr (call ok (&& (== (call lines (& cl)) 2) (> (call lines (& natural)) 2)) "clamp limits lines"))
    (expr (call near (. (index (. (. (. cl d) nodes) items) (. cl id)) h) (* lh (float 0x4000000000000000)) (float 0x3f847ae147ae147b) "clamp limits content height"))
    (let cf _ (call lastFrag (& cl)))
    (expr (call ok (&& (>= (. cf ell) (float 0x0000000000000000)) (<= (+ (. cf x) (. cf w)) (float 0x405900a3d70a3d71))) "clamp adds fitting ellipsis"))
    (let cn _ (. (index (. (. (. cl d) nodes) items) (. cl id)) first))
    (= (. (index (. (. (. cl d) nodes) items) cn) sa) 0)
    (= (. (index (. (. (. cl d) nodes) items) cn) sb) (. (index (. (. (. cl d) nodes) items) cn) tlen))
    (expr (call ok (== (. (call (. textsel selected) (& (. cl d))) len) (. cf end)) "copy excludes clamped tail"))
    (expr (call (. (. cl d) clsIf) (. cl id) "hidden" (bool true)))
    (expr (call (. (. cl d) layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (== (. (call (. textsel selected) (& (. cl d))) len) 0) "copy excludes hidden selection immediately"))
    (expr (call (. (. cl d) clsIf) (. cl id) "hidden" (bool false)))
    (expr (call (. (. cl d) styleStr) (. cl id) 0 "line-clamp" "none"))
    (expr (call (. (. cl d) layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (&& (== (call lines (& cl)) (call lines (& natural))) (< (. (call lastFrag (& cl)) ell) (float 0x0000000000000000))) "live clamp removal restores text"))
    (expr (call (. (. cl d) styleStr) (. cl id) 0 "line-clamp" "1"))
    (expr (call (. (. cl d) layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& cl)) 1) "live clamp replacement invalidates fragments"))
    (let warnings _ (. (. css warns) len))
    (expr (call parse css ".invalidClamp { line-clamp: 2; line-clamp: 0; line-clamp: -1; line-clamp: 1.5; line-clamp: 2px; }" "invalid.css" 1))
    (let invalid _ (call block mem css "invalidClamp" "alpha beta gamma delta epsilon" (float 0x4079000000000000)))
    (expr (call ok (&& (== (call lines (& invalid)) 2) (== (. (. css warns) len) (+ warnings 4))) "clamp rejects zero negative fractional and dimension values"))
    (= (. (. css warns) len) warnings)
    (let short _ (call block mem css "clamp" "alpha beta" (float 0x4079000000000000)))
    (expr (call ok (< (. (call lastFrag (& short)) ell) (float 0x0000000000000000)) "exact clamp content has no ellipsis"))
    (let just _ (call block mem css "just" "aa bb cc dd ee ff gg hh ii jj k" (float 0x4079000000000000)))
    (let jf _ (. (index (. (. (. just d) nodes) items) (. just id)) frag0))
    (let jy _ (. (index (. (. (. just d) frags) items) jf) y))
    (let edge f32 (float 0x0000000000000000))
    (while (&& (>= jf 0) (== (. (index (. (. (. just d) frags) items) jf) y) jy)) (block
      (= edge (+ (. (index (. (. (. just d) frags) items) jf) x) (. (index (. (. (. just d) frags) items) jf) w)))
      (= jf (. (index (. (. (. just d) frags) items) jf) next))))
    (expr (call near edge (float 0x4059000000000000) (float 0x3f847ae147ae147b) "justify reaches right edge on wrapped line"))
    (let gapId _ (. (index (. (. (. just d) frags) items) (. (index (. (. (. just d) nodes) items) (. just id)) frag0)) next))
    (let gap _ (index (. (. (. just d) frags) items) gapId))
    (expr (call ok (> (. gap w) (call textWidth font (call bytes " ") (bool false))) "justified space retains its full stretched fragment advance"))
    (expr (call (. (. just d) simInput) (+ (. gap x) (* (. gap w) (float 0x3fe8000000000000))) (+ (. gap y) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. (. just d) beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) (& (. just d))))
    (expr (call (. (. just d) simInput) (+ (. gap x) (* (. gap w) (float 0x3fe8000000000000))) (+ (. gap y) (float 0x4014000000000000)) (bool true) (float 0x0000000000000000)))
    (expr (call (. (. just d) beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) (& (. just d))))
    (expr (call ok (== (. (. just d) selAo) (. gap end)) "justified gap pointer picking uses stretched geometry"))
    (expr (call ok (< (+ (. (call lastFrag (& just)) x) (. (call lastFrag (& just)) w)) (float 0x4059000000000000)) "justify final line stays natural"))
    (let forced _ (call block mem css "justpre" "aa bb\ncc" (float 0x4079000000000000)))
    (let ff _ (. (index (. (. (. forced d) nodes) items) (. forced id)) frag0))
    (let fnx _ (. (index (. (. (. forced d) frags) items) (. (index (. (. (. forced d) frags) items) ff) next)) next))
    (expr (call near (. (index (. (. (. forced d) frags) items) fnx) x) (call textWidth font (call bytes "aa ") (bool false)) (float 0x3f847ae147ae147b) "explicit newline line is not justified"))
    (let single _ (call block mem css "just" "Supercalifragilisticexpialidocious tail" (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& single)) 2) "justify single overflowing word terminates without gap division"))
    (let laid _ (. (. cl d) laid))
    (let restyled _ (. (. cl d) restyled))
    (let used _ (. mem used))
    (for k (.. 0 100) (block
      (expr (call (. (. cl d) layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))))
    (expr (call ok (&& (&& (== (. (. cl d) laid) laid) (== (. (. cl d) restyled) restyled)) (== (. mem used) used)) "new text modes idle without layout/restyle/allocation"))))
  (fn testInlineWhitespace (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let owner _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) owner "box"))
    (let span _ (call (. d open) 1 (call (. d tag) "span") 1))
    (expr (call (. d cls) span "pre"))
    (expr (call (. d text) "alpha  beta gamma delta"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (let b _ (struct-lit Built (field d d) (field id owner)))
    (expr (call ok (&& (== (call lines (& b)) 1) (> (+ (. (call lastFrag (& b)) x) (. (call lastFrag (& b)) w)) (float 0x4059000000000000))) "inline whitespace override controls shared run"))
    (expr (call (. (. b d) styleStr) span 0 "white-space" "pre-wrap"))
    (expr (call (. (. b d) layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (> (call lines (& b)) 1) "inline whitespace override updates after live style change"))))
  (fn testVisibility (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let parent _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) parent "hidden"))
    (let hidden _ (call (. d open) 1 (call (. d tag) "button") 1))
    (expr (call (. d styleStr) hidden 1 "display" "block"))
    (expr (call (. d styleNum) hidden 2 "height" (float 0x4034000000000000)))
    (expr (call (. d text) "hidden"))
    (expr (call (. d close)))
    (let visible _ (call (. d open) 2 (call (. d tag) "button") 1))
    (expr (call (. d cls) visible "visible"))
    (expr (call (. d styleStr) visible 1 "display" "block"))
    (expr (call (. d styleNum) visible 2 "height" (float 0x4034000000000000)))
    (expr (call (. d text) "visible"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (&& (> (. (index (. (. d nodes) items) hidden) h) (float 0x0000000000000000)) (>= (. (index (. (. d nodes) items) visible) y) (. (index (. (. d nodes) items) hidden) h))) "hidden button retains layout"))
    (expr (call ok (&& (! (call (. dom isFocusable) (& d) hidden)) (call (. dom isFocusable) (& d) visible)) "visibility inherits and visible child overrides"))
    (expr (call (. d simInput) (float 0x4014000000000000) (float 0x4014000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call ok (&& (!= (. d downHit) hidden) (!= (. d hover) hidden)) "hidden control does not receive pointer hit"))
    (expr (call (. d simInput) (float 0x4014000000000000) (+ (call (. d absY) visible) (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call ok (== (. d hover) visible) "visible descendant is reachable through hidden ancestor"))
    (expr (call (. d focusNode) (- 1)))
    (expr (call (. d focusNode) hidden))
    (expr (call ok (== (. d focus) (- 1)) "hidden control rejects programmatic focus"))
    (expr (call (. d focusNode) visible))
    (expr (call ok (== (. d focus) visible) "visible descendant accepts focus"))
    (expr (call (. d styleStr) visible 0 "visibility" "hidden"))
    (expr (call (. d layoutAt) (float 0x4079000000000000) (float 0x4079000000000000)))
    (expr (call ok (&& (== (. d focus) (- 1)) (! (call (. dom isFocusable) (& d) visible))) "live visibility change clears focus"))
    (= (. d focus) hidden)
    (= (. (. d kin) enter) (bool true))
    (expr (call (. inputs begin) (& d)))
    (expr (call ok (&& (== (. d focus) (- 1)) (! (call (. d clicked) hidden))) "hidden stale focus cannot activate by keyboard"))
    (= (. d clickNode) hidden)
    (expr (call ok (! (call (. d clicked) hidden)) "hidden stale click cannot activate"))
    (expr (call (. d styleStr) visible 0 "visibility" "visible"))
    (expr (call (. d layoutAt) (float 0x4069000000000000) (float 0x4079000000000000)))
    (expr (call ok (call (. dom isFocusable) (& d) visible) "style toggle and resize restore visible control"))
    (expr (call (. d focusNode) visible))
    (expr (call (. d styleStr) visible 0 "display" "none"))
    (expr (call (. d layoutAt) (float 0x4069000000000000) (float 0x4079000000000000)))
    (expr (call ok (== (. d focus) visible) "display none alone keeps focus (virtual lists keep the focused row hidden)"))))
