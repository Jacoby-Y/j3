    (let mb _ (struct-lit Built (field d m) (field id owner)))
    (expr (call ok (== (call lines (& mb)) 2) "line-clamp counts lines across text and span runs of one block"))
    (expr (call near (. (index (. (. m nodes) items) owner) h) (* lh (float 0x4000000000000000)) (float 0x3f847ae147ae147b) "multi-run clamp height is N lines"))
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call frameFields (& e)))))
    (let p1 _ (. (index (. (. e nodes) items) (. (index (. (. e nodes) items) 0) first)) first))
    (let p2 _ (. (index (. (. e nodes) items) p1) next))
    (let t1 _ (. (index (. (. e nodes) items) p2) next))
    (let t2 _ (. (index (. (. e nodes) items) t1) next))
    (expr (call near (. (index (. (. e nodes) items) p1) w) (. (index (. (. e nodes) items) p2) w) (float 0x3f847ae147ae147b) "white-space pre leaves an input's width alone"))
    (expr (call near (. (index (. (. e nodes) items) t1) h) (. (index (. (. e nodes) items) t2) h) (float 0x3f847ae147ae147b) "white-space pre leaves a textarea's height alone"))
    (expr (call (. e focusNode) p1))
    (expr (call (. e simKeys) "" "End"))
    (expr (call frameFields (& e)))
    (let c1 _ (call (. e caretRect) p1))
    (expr (call (. e focusNode) p2))
    (expr (call (. e simKeys) "" "End"))
    (expr (call frameFields (& e)))
    (let c2 _ (call (. e caretRect) p2))
    (expr (call ok (>= (. c1 x) (float 0x0000000000000000)) "input caret is placed"))
    (expr (call near (- (. c2 x) (call (. e absX) p2)) (- (. c1 x) (call (. e absX) p1)) (float 0x3f847ae147ae147b) "input caret x is the same with white-space pre"))
    (expr (call (. e focusNode) t1))
    (expr (call (. e simKeys) "" "C+End"))
    (expr (call frameFields (& e)))
    (let d1 _ (call (. e caretRect) t1))
    (expr (call (. e focusNode) t2))
    (expr (call (. e simKeys) "" "C+End"))
    (expr (call frameFields (& e)))
    (let d2 _ (call (. e caretRect) t2))
    (expr (call ok (|| (> (. d1 y) (float 0x0000000000000000)) (> (. d1 x) (float 0x0000000000000000))) "textarea caret is placed"))
    (expr (call near (- (. d2 y) (call (. e absY) t2)) (- (. d1 y) (call (. e absY) t1)) (float 0x3f847ae147ae147b) "textarea caret y is the same with white-space pre"))
    (expr (call near (- (. d2 x) (call (. e absX) t2)) (- (. d1 x) (call (. e absX) t1)) (float 0x3f847ae147ae147b) "textarea caret x is the same with white-space pre"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (= FONTPATH (. (index (. (. css fonts) items) 0) path))
    (expr (call testTextCss (& mem) (& css)))
    (expr (call testVisibility (& mem) (& css)))
    (expr (call testInlineWhitespace (& mem) (& css)))
    (expr (call testTabClampInput (& mem) (& css)))
    (expr (call printLn (interp "text_css_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
