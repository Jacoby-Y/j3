(file (module a11y_test)
  (use j3.io (names printLn readFile))
  (use j3.result.Result)
  (use j3.ui.domhtml.dumpHtml)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains same Text))
  (use j3.ui.a11y)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (mod-let STATE St _)
  (struct St
    (field checked bool (bool false))
    (field clicks int 0)
    (field vol f32 (float 0x4008000000000000))
    (field name string "Ann")
    (field pw string "hunter2")
    (field changes int 0))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string ".gone { display: none; } input { width: 120px; } button { width: 80px; }")
  (fn leaf (params (d (ref Dom)) (slot int) (tag string) (text string)) int (block
    (let id _ (call (. d open) slot (call (. d tag) tag) 1))
    (expr (call (. d text) text))
    (expr (call (. d close)))
    (return id)))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call leaf d 0 "h1" "Settings"))
    (let b _ (call (. d open) 1 (call (. d tag) "button") 1))
    (expr (call (. d text) "  Save   now "))
    (if (call (. d clicked) b) (block
      (+= (. STATE clicks) 1)))
    (expr (call (. d close)))
    (let ic _ (call (. d open) 2 (call (. d tag) "button") 1))
    (expr (call (. d attrAria) ic "Close"))
    (expr (call (. d open) 0 (call (. d tag) "svg") 1))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let dis _ (call (. d open) 3 (call (. d tag) "button") 1))
    (expr (call (. d attrDisabled) dis (bool true)))
    (expr (call (. d text) "Nope"))
    (expr (call (. d close)))
    (let gone _ (call (. d open) 4 (call (. d tag) "button") 1))
    (expr (call (. d cls) gone "gone"))
    (expr (call (. d text) "Hidden"))
    (expr (call (. d close)))
    (let box _ (call (. d open) 12 (call (. d tag) "div") 1))
    (expr (call (. d cls) box "gone"))
    (expr (call leaf d 0 "button" "Deep"))
    (expr (call (. d close)))
    (let lb _ (call (. d open) 5 (call (. d tag) "label") 1))
    (expr (call (. d text) "Dark mode"))
    (let cb _ (call (. d open) 0 (call (. d tag) "input") 1))
    (expr (call (. d attrType) cb "checkbox"))
    (expr (call (. d attrChecked) cb (. STATE checked)))
    (if (call (. d clicked) cb) (block
      (= (. STATE checked) (! (. STATE checked)))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let tb _ (call (. d open) 6 (call (. d tag) "input") 1))
    (expr (call (. d attrType) tb "text"))
    (expr (call (. d attrPlaceholder) tb "Your name"))
    (if (call (. d changed) tb) (block
      (= (. STATE name) (call (. d strValue) tb))
      (+= (. STATE changes) 1)))
    (expr (call (. d attrText) tb (. STATE name)))
    (expr (call (. d close)))
    (let pw _ (call (. d open) 7 (call (. d tag) "input") 1))
    (expr (call (. d attrType) pw "password"))
    (expr (call (. d attrAria) pw "Passphrase"))
    (expr (call (. d attrText) pw (. STATE pw)))
    (expr (call (. d close)))
    (let rg _ (call (. d open) 8 (call (. d tag) "input") 1))
    (expr (call (. d attrType) rg "range"))
    (expr (call (. d attrMin) rg (float 0x0000000000000000)))
    (expr (call (. d attrMax) rg (float 0x4024000000000000)))
    (expr (call (. d attrStep) rg (float 0x3ff0000000000000)))
    (expr (call (. d attrTitle) rg "Volume"))
    (if (call (. d changed) rg) (block
      (= (. STATE vol) (call (. d value) rg))))
    (expr (call (. d attrValue) rg (. STATE vol)))
    (expr (call (. d close)))
    (let sl _ (call (. d open) 9 (call (. d tag) "select") 1))
    (expr (call (. d attrAria) sl "Color"))
    (expr (call (. d attrText) sl "g"))
    (let o1 _ (call (. d open) 0 (call (. d tag) "option") 1))
    (expr (call (. d attrText) o1 "r"))
    (expr (call (. d text) "Red"))
    (expr (call (. d close)))
    (let o2 _ (call (. d open) 1 (call (. d tag) "option") 1))
    (expr (call (. d attrText) o2 "g"))
    (expr (call (. d text) "Green"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let mi _ (call (. d open) 10 (call (. d tag) "div") 1))
    (expr (call (. d attrMenuItem) mi))
    (expr (call (. d text) "Copy"))
    (expr (call (. d close)))
    (let nv _ (call (. d open) 11 (call (. d tag) "div") 1))
    (expr (call (. d attrRole) nv "list"))
    (expr (call leaf d 0 "p" "one"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn dump (params (d (ref Dom)) (mem (ref Arena))) string (block
    (let t _ (call (. Text new) mem))
    (expr (call (. a11y dump) d mem (& t)))
    (return (call (. t str)))))
  (fn has (params (s string) (part string) (msg string)) _ (block
    (if (! (call contains s part)) (block
      (expr (call printLn s))))
    (expr (call ok (call contains s part) msg))))
  (fn htmlRoles (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let ul _ (call (. d open) 0 (call (. d tag) "ul") 1))
    (let li _ (call (. d open) 0 (call (. d tag) "li") 1))
    (expr (call (. d text) "one"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let a _ (call (. d open) 1 (call (. d tag) "a") 1))
    (expr (call (. d text) "link"))
    (expr (call (. d close)))
    (let hr _ (call (. d open) 2 (call (. d tag) "hr") 1))
    (expr (call (. d close)))
    (let h3 _ (call (. d open) 3 (call (. d tag) "h3") 1))
    (expr (call (. d text) "Three"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (expr (call ok (call same (call (. a11y role) (& d) ul) "list") "ul is a list"))
    (expr (call ok (call same (call (. a11y role) (& d) li) "listitem") "li is a listitem"))
    (expr (call ok (call same (call (. a11y role) (& d) a) "link") "a is a link"))
    (expr (call ok (call same (call (. a11y role) (& d) hr) "separator") "hr is a separator"))
    (expr (call ok (call same (call (. a11y role) (& d) h3) "heading") "h3 is a heading"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= STATE (struct-lit St))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let s _ (call dump (& d) (& mem)))
    (expr (call has s "heading \"Settings\"" "h1 is a heading named by its text"))
    (expr (call has s "button \"Save now\" actions=focus,click" "a button: text squashed, focus and click"))
    (expr (call has s "button \"Close\"" "an icon-only button takes its aria-label"))
    (expr (call has s "button \"Nope\" disabled\n" "a disabled button says so and offers nothing"))
    (expr (call ok (&& (! (call contains s "Hidden")) (! (call contains s "Deep"))) "display: none is left out, and so is what is inside it"))
    (expr (call has s "checkbox \"Dark mode\" checked=false actions=focus,click" "a wrapping label names the checkbox"))
    (expr (call has s "textbox \"Your name\" value=\"Ann\" actions=focus,set" "placeholder names a text box, value shown"))
    (expr (call has s "textbox \"Passphrase\" secret" "a password box has a role and a name"))
    (expr (call ok (! (call contains s "hunter2")) "the password value never appears"))
    (expr (call has s "slider \"Volume\" min=0 max=10 now=3" "a slider: title name, min, max, now"))
    (expr (call has s "combobox \"Color\" expanded=false" "a select is a combobox"))
    (expr (call has s "option \"Green\" selected" "the chosen option is selected"))
    (expr (call has s "menuitem \"Copy\"" "menuitem attribute"))
    (expr (call has s "list\n  paragraph\n    text \"one\"" "role= attribute, plain text kept"))
    (= (. STATE checked) (bool true))
    (expr (call frame (& d)))
    (expr (call ok (call dumpHtml (& d) "/tmp/j3_a11y_test.html") "dumpHtml writes"))
    (match (call readFile "/tmp/j3_a11y_test.html" (& mem))
      (arm (pats (variant Result.Ok (bind bytes))) (block
        (let h string (as bytes string))
        (expr (call has h "type=\"checkbox\" checked" "html: checkbox checked"))
        (expr (call has h "type=\"text\" value=\"Ann\"" "html: text value"))
        (expr (call has h "<select class=\"s1\" value=\"g\"" "html: select value"))
        (expr (call has h "selected>Green" "html: selected option"))
        (expr (call has h "disabled>Nope" "html: disabled"))
        (expr (call ok (! (call contains h "hunter2")) "html: no password value"))
        (expr (call ok (! (call contains h "type=\"password\" value")) "html: password has no value attribute"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "read snapshot back")))))
    (= (. STATE checked) (bool false))
    (expr (call frame (& d)))
    (let want _ 0)
    (let c _ 0)
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (== (. (index (. (. d nodes) items) i) kind) (. dom K_ELEM)) (!= (call (. a11y actions) (& d) i) 0)) (block
        (+= want 1)))))
    (expr (call ok (== want 8) "eight operable controls (disabled and hidden ones excluded)"))
    (let first _ (- 1))
    (let prev _ (- 1))
    (let steps _ 0)
    (while (< steps want) (block
      (expr (call (. d simKeys) "" "Tab"))
      (expr (call frame (& d)))
      (let f _ (call (. d focused)))
      (expr (call ok (> f prev) "Tab moves forward in document order"))
      (expr (call ok (!= (call (. a11y actions) (& d) f) 0) "and lands on an operable node"))
      (= prev f)
      (if (< first 0) (block
        (= first f)))
      (+= steps 1)))
    (expr (call (. d simKeys) "" "Tab"))
    (expr (call frame (& d)))
    (expr (call ok (== (call (. d focused)) first) "Tab wraps to the first control"))
    (expr (call ok (call contains (call dump (& d) (& mem)) "focused") "the focus shows in the tree"))
    (let cb _ (- 1))
    (let rg _ (- 1))
    (let tb _ (- 1))
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (== (. (index (. (. d nodes) items) i) kind) (. dom K_ELEM)) (!= (call (. a11y actions) (& d) i) 0)) (block
        (let r _ (call (. a11y role) (& d) i))
        (if (call same r "checkbox") (block
          (= cb i)))
        (if (call same r "slider") (block
          (= rg i)))
        (if (&& (call same r "textbox") (> (. (. (index (. (. d nodes) items) i) ph) len) 0)) (block
          (= tb i)))))))
    (expr (call ok (call (. a11y perform) (& d) cb (. a11y A_CLICK) (float 0x0000000000000000) "") "click is offered"))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (. STATE checked) "perform click flips the checkbox"))
    (expr (call ok (! (call (. a11y perform) (& d) cb (. a11y A_SET) (float 0x3ff0000000000000) "")) "set value is not offered on a checkbox"))
    (expr (call ok (call (. a11y perform) (& d) rg (. a11y A_SET) (float 0x401c000000000000) "") "set value on the slider"))
    (expr (call frame (& d)))
    (expr (call ok (== (. STATE vol) (float 0x401c000000000000)) "the slider took 7"))
    (expr (call ok (call (. a11y perform) (& d) tb (. a11y A_SET) (float 0x0000000000000000) "Bob") "set value on the text box"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (. STATE name) "Bob") (== (. STATE changes) 1)) "the text box took Bob"))
    (expr (call htmlRoles (& mem) (& css)))
    (+= CHECKS 0)
    (expr (call printLn (interp "a11y_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
