(file (module text_test)
  (use j3.game (names selRectW selRectX textBidi textCaretX textIndexAt textSelRects Font fontFallback fontLine fontShape loadFont textShaping textWidth tryLoadFont))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names Text fmtBytes fmtInt same))
  (use j3.ui.css (names Css CLIP_TEXT P_BG_CLIP P_OVERFLOW_WRAP P_OVERFLOW_Y P_STROKE_COLOR P_STROKE_WIDTH P_TEXT_SHADOW V_SHADOW WRAP_BREAK))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.textanim)
  (use j3.ui.textfit)
  (mod-let FONTPATH string _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } @font-face { font-family: \"S\"; src: url(\"examples/big_ui_test/assets/symbols.ttf\"); } .box { font-family: \"T\"; font-size: 16px; width: 100px; } .nw { white-space: nowrap; } .el { white-space: nowrap; text-overflow: ellipsis; overflow-y: hidden; } .elv { white-space: nowrap; text-overflow: ellipsis; } .bw { overflow-wrap: break-word; } .pl { white-space: pre-line; } .fb { font-family: \"T\", \"S\", sans-serif; } .fn { font-family: \"T\", sans-serif; font-size: 16px; width: 100px; } .fx { text-shadow: 1px 2px 3px #ff0000, 0 0 5px #00ff00; -webkit-text-stroke: 2px #0000ff; -webkit-background-clip: text; word-wrap: break-word; overflow: hidden; }")
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (fn size (params (s string)) int (block
    (return (. s len))))
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (struct Built
    (field d Dom)
    (field id int))
  (fn (doc "A fresh tree with one `.box` block of `cls` and `text`, laid out at `w` x 400. A new `Dom` each time:\nclasses are only ever added to a reused node.") block (params (mem (ref Arena)) (css (ref Css)) (cls string) (text string) (w f32)) Built (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) id "box"))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) id cls))))
    (expr (call (. d text) text))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) w (float 0x4079000000000000)))
    (return (struct-lit Built (field d d) (field id id)))))
  (fn lines (params (b (ref Built))) int (block
    (let n _ 0)
    (let lastY f32 (- (float 0x408f400000000000)))
    (let f _ (. (index (. (. (. b d) nodes) items) (. b id)) frag0))
    (while (>= f 0) (block
      (let y _ (. (index (. (. (. b d) frags) items) f) y))
      (if (|| (> (- y lastY) (float 0x3fe0000000000000)) (> (- lastY y) (float 0x3fe0000000000000))) (block
        (+= n 1)
        (= lastY y)))
      (= f (. (index (. (. (. b d) frags) items) f) next))))
    (return n)))
  (fn lastFrag (params (b (ref Built))) Frag (block
    (let f _ (. (index (. (. (. b d) nodes) items) (. b id)) frag0))
    (while (>= (. (index (. (. (. b d) frags) items) f) next) 0) (block
      (= f (. (index (. (. (. b d) frags) items) f) next))))
    (return (index (. (. (. b d) frags) items) f))))
  (fn testNoWrap (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let t _ "alpha beta gamma delta epsilon zeta")
    (let n _ (call block mem css "nw" t (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& n)) 1) "nowrap: one line"))
    (let fr _ (call lastFrag (& n)))
    (expr (call ok (> (+ (. fr x) (. fr w)) (float 0x4062c00000000000)) "nowrap: the line runs past the 100px box"))
    (let w _ (call block mem css "" t (float 0x4079000000000000)))
    (expr (call ok (> (call lines (& w)) 1) "normal: the same text wraps"))))
  (fn testEllipsis (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let t _ "alpha beta gamma delta epsilon zeta")
    (let e _ (call block mem css "el" t (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& e)) 1) "ellipsis: one line"))
    (let fr _ (call lastFrag (& e)))
    (expr (call ok (>= (. fr ell) (float 0x0000000000000000)) "ellipsis: the last run carries one"))
    (expr (call ok (<= (+ (. fr x) (. fr w)) (float 0x4059200000000000)) "ellipsis: run plus ellipsis fits the box"))
    (expr (call ok (< (. fr end) 35) "ellipsis: text was cut"))
    (let short _ (call block mem css "el" "alpha" (float 0x4079000000000000)))
    (let sf _ (call lastFrag (& short)))
    (expr (call ok (< (. sf ell) (float 0x0000000000000000)) "ellipsis: text that fits is untouched"))
    (let vis _ (call block mem css "elv" t (float 0x4079000000000000)))
    (let vf _ (call lastFrag (& vis)))
    (expr (call ok (< (. vf ell) (float 0x0000000000000000)) "ellipsis needs overflow other than visible, like a browser"))
    (let u _ (call block mem css "el" "\xc3\xb1and\xc3\xba fa\xc3\xa7ade \xd0\x9f\xd1\x80\xd0\xb8\xd0\xb2\xd0\xb5\xd1\x82 \xd0\xbc\xd0\xb8\xd1\x80 \xce\xb1\xce\xb2\xce\xb3\xce\xb4\xce\xb5 and then a long tail" (float 0x4079000000000000)))
    (let uf _ (call lastFrag (& u)))
    (let tn _ (. (index (. (. (. u d) nodes) items) (. u id)) first))
    (expr (call ok (>= (. uf ell) (float 0x0000000000000000)) "ellipsis utf8: cut"))
    (expr (call ok (! (call (. textfit isCont) (index (. (index (. (. (. u d) nodes) items) tn) buf) (. uf end)))) "ellipsis utf8: the cut is on a code point boundary"))
    (expr (call ok (<= (+ (. uf x) (. uf w)) (float 0x4059200000000000)) "ellipsis utf8: fits"))))
  (fn testBreakWord (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let word _ "Supercalifragilisticexpialidocious")
    (let plain _ (call block mem css "" word (float 0x4079000000000000)))
    (expr (call ok (== (call lines (& plain)) 1) "normal: a long word stays on one line"))
    (let pf _ (call lastFrag (& plain)))
    (expr (call ok (> (. pf w) (float 0x4062c00000000000)) "normal: and overflows"))
    (let id _ (call block mem css "bw" word (float 0x4079000000000000)))
    (expr (call ok (>= (call lines (& id)) 3) "break-word: several lines"))
    (let covered _ 0)
    (let f _ (. (index (. (. (. id d) nodes) items) (. id id)) frag0))
    (while (>= f 0) (block
      (let fr _ (index (. (. (. id d) frags) items) f))
      (expr (call ok (<= (. fr w) (float 0x4059200000000000)) "break-word: every piece fits the box"))
      (+= covered (- (. fr end) (. fr start)))
      (= f (. fr next))))
    (expr (call ok (== covered (. word len)) "break-word: no letters lost"))
    (let e _ (call block mem css "bw" "\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9\xc3\xa9" (float 0x4079000000000000)))
    (let g _ (. (index (. (. (. e d) nodes) items) (. e id)) frag0))
    (while (>= g 0) (block
      (let fe _ (index (. (. (. e d) frags) items) g))
      (expr (call ok (&& (== (% (. fe start) 2) 0) (== (% (. fe end) 2) 0)) "break-word utf8: pieces hold whole code points"))
      (= g (. fe next))))
    (let z _ (call block mem css "bw" "abc" (float 0x0000000000000000)))
    (expr (call ok (>= (call lines (& z)) 1) "zero width: terminates"))
    (let big _ "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")
    (let bg _ (call block mem css "bw" big (float 0x4079000000000000)))
    (let seen _ 0)
    (let h _ (. (index (. (. (. bg d) nodes) items) (. bg id)) frag0))
    (while (>= h 0) (block
      (let fh _ (index (. (. (. bg d) frags) items) h))
      (expr (call ok (<= (. fh w) (float 0x4059200000000000)) "long word: every piece fits"))
      (+= seen (- (. fh end) (. fh start)))
      (= h (. fh next))))
    (expr (call ok (== seen (. big len)) "long word: no letters lost"))
    (let empty _ (call block mem css "bw" "" (float 0x4079000000000000)))
    (expr (call ok (< (. (index (. (. (. empty d) nodes) items) (. empty id)) frag0) 0) "empty text: no runs"))))
  (fn testPreLine (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let b _ (call block mem css "pl" "a\nb\n\nc" (float 0x4079000000000000)))
    (let lh _ (call f32 (call fontLine (call loadFont FONTPATH 16))))
    (let h _ (. (index (. (. (. b d) nodes) items) (. b id)) h))
    (expr (call ok (&& (> h (* lh (float 0x400f333333333333))) (< h (* lh (float 0x4010666666666666)))) "pre-line: a blank line counts"))
    (expr (call ok (== (call lines (& b)) 3) "pre-line: three lines have text"))
    (let t _ (call block mem css "pl" "a\n" (float 0x4079000000000000)))
    (expr (call ok (< (. (index (. (. (. t d) nodes) items) (. t id)) h) (* lh (float 0x3ff199999999999a))) "pre-line: a trailing newline adds no line"))))
  (fn iv (params (css (ref Css)) (st int) (p int)) int (block
    (let v _ (call (. css get) st p))
    (return (. v i))))
  (fn fv (params (css (ref Css)) (st int) (p int)) f32 (block
    (let v _ (call (. css get) st p))
    (return (. v f))))
  (fn cv (params (css (ref Css)) (st int) (p int)) int (block
    (let v _ (call (. css get) st p))
    (return (. v c))))
  (fn kv (params (css (ref Css)) (st int) (p int)) int (block
    (let v _ (call (. css get) st p))
    (return (. v kind))))
  (fn (doc "The CSS side: values parse, vendor names alias, and the inherited ones reach the text node.") testStyle (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let b _ (call block mem css "fx" "x" (float 0x4079000000000000)))
    (let st _ (. (index (. (. (. b d) nodes) items) (. b id)) style))
    (let tst _ (. (index (. (. (. b d) nodes) items) (. (index (. (. (. b d) nodes) items) (. b id)) first)) style))
    (expr (call ok (== (call kv css st P_TEXT_SHADOW) V_SHADOW) "text-shadow parses"))
    (let o _ (call iv css st P_TEXT_SHADOW))
    (expr (call ok (== (index (. (. css paints) items) o) (float 0x4000000000000000)) "text-shadow: two shadows"))
    (expr (call ok (== (index (. (. css paints) items) (+ (+ o 1) 3)) (float 0x4008000000000000)) "text-shadow: blur of the first"))
    (expr (call ok (== (call fv css st P_STROKE_WIDTH) (float 0x4000000000000000)) "-webkit-text-stroke width"))
    (expr (call ok (== (call cv css st P_STROKE_COLOR) 65535) "-webkit-text-stroke color (blue)"))
    (expr (call ok (== (call iv css st P_BG_CLIP) CLIP_TEXT) "-webkit-background-clip: text"))
    (expr (call ok (== (call iv css st P_OVERFLOW_WRAP) WRAP_BREAK) "word-wrap aliases overflow-wrap"))
    (expr (call ok (== (call iv css st P_OVERFLOW_Y) 1) "overflow: hidden sets overflow-y"))
    (expr (call ok (== (call kv css tst P_TEXT_SHADOW) V_SHADOW) "text-shadow inherits"))
    (expr (call ok (== (call fv css tst P_STROKE_WIDTH) (float 0x4000000000000000)) "text-stroke inherits"))
    (expr (call ok (== (call iv css tst P_OVERFLOW_WRAP) WRAP_BREAK) "overflow-wrap inherits"))
    (expr (call ok (== (call iv css tst P_BG_CLIP) 0) "background-clip does not inherit"))))
  (fn testFit (params) _ (block
    (let font _ (call loadFont FONTPATH 16))
    (let s _ "h\xc3\xa9llo w\xc3\xb6rld")
    (let n _ (call (. textfit fitPrefix) font (bool false) (call bytes s) (float 0x408f400000000000)))
    (expr (call ok (== n (. s len)) "fitPrefix: everything fits"))
    (expr (call ok (== (call (. textfit fitPrefix) font (bool false) (call bytes s) (float 0x0000000000000000)) 0) "fitPrefix: zero width"))
    (expr (call ok (== (call (. textfit fitPrefix) font (bool false) (call bytes "") (float 0x4049000000000000)) 0) "fitPrefix: empty"))
    (let w _ (call textWidth font (call bytes (slice-expr s 0 6)) (bool false)))
    (let m _ (call (. textfit fitPrefix) font (bool false) (call bytes s) (+ w (float 0x3fe0000000000000))))
    (expr (call ok (== m 6) "fitPrefix: exact prefix width keeps the prefix (6 bytes = h \xc3\xa9 l l o)"))
    (expr (call ok (! (call (. textfit isCont) (index s m))) "fitPrefix: boundary"))
    (expr (call ok (== (call size (call (. textfit codePoints) "h\xc3\xa9llo" 2)) 3) "codePoints: two code points are three bytes"))))
  (fn testAnim (params) _ (block
    (expr (call ok (== (call size (call (. textanim typewriter) "h\xc3\xa9llo" (float 0x3fb999999999999a) (float 0x4034000000000000))) 3) "typewriter: two code points at 0.1s * 20"))
    (expr (call ok (== (call size (call (. textanim typewriter) "h\xc3\xa9llo" (float 0x0000000000000000) (float 0x4034000000000000))) 0) "typewriter: nothing at t = 0"))
    (expr (call ok (== (call size (call (. textanim typewriter) "h\xc3\xa9llo" (float 0x4058c00000000000) (float 0x4034000000000000))) 6) "typewriter: whole text when done"))
    (expr (call ok (== (call size (call (. textanim words) "one two three" (float 0x3fe0000000000000) (float 0x4010000000000000))) 7) "words: two words without the trailing space"))
    (expr (call ok (== (call size (call (. textanim words) "one two three" (float 0x4022000000000000) (float 0x4010000000000000))) 13) "words: all"))
    (expr (call ok (== (call size (call (. textanim words) "" (float 0x3ff0000000000000) (float 0x4010000000000000))) 0) "words: empty"))
    (expr (call ok (&& (> (call (. textanim cycle) (float 0x401c000000000000) (float 0x4000000000000000) (float 0x3ff0000000000000)) (float 0x3fefae147ae147ae)) (< (call (. textanim cycle) (float 0x401c000000000000) (float 0x4000000000000000) (float 0x3ff0000000000000)) (float 0x3ff028f5c28f5c29))) "cycle: 7 mod 3"))
    (expr (call ok (&& (call (. textanim blink) (float 0x3fb999999999999a) (float 0x3ff0000000000000)) (! (call (. textanim blink) (float 0x3fe3333333333333) (float 0x3ff0000000000000)))) "blink: first half on"))))
  (fn testFallback (params (mem (ref Arena)) (css (ref Css))) _ (block
    (expr (call ok (== (. (. css fonts) len) 2) "two @font-face"))
    (let sym _ "A\xf0\x9f\x8e\xaeB")
    (let plain _ (call block mem css "nw" sym (float 0x4079000000000000)))
    (let fb _ (call block mem css "fb" sym (float 0x4079000000000000)))
    (let pf _ (call loadFont (. (index (. (. css fonts) items) 0) path) 16))
    (let sf _ (call loadFont (. (index (. (. css fonts) items) 1) path) 16))
    (let pw _ (call textWidth pf (call bytes sym) (bool false)))
    (expr (call ok (== (. (call lastFrag (& plain)) w) pw) "no chain: the primary measures the whole run"))
    (expr (call fontFallback pf sf))
    (let cw _ (call textWidth pf (call bytes sym) (bool false)))
    (let want _ (+ (+ (call textWidth pf (call bytes "A") (bool false)) (call textWidth sf (call bytes "\xf0\x9f\x8e\xae") (bool false))) (call textWidth pf (call bytes "B") (bool false))))
    (expr (call ok (== cw want) "chain: runs are measured with the font that has the glyph"))
    (expr (call ok (!= cw pw) "chain: the symbol no longer uses the primary's missing-glyph box"))
    (expr (call ok (== (. (call lastFrag (& fb)) w) want) "layout of a font-family list matches the chain's measure"))
    (let fn2 _ (call block mem css "fn" sym (float 0x4079000000000000)))
    (expr (call ok (!= (. (call lastFrag (& fn2)) w) want) "a list with another fallback list does not share the chain"))
    (let fb2 _ (call block mem css "fb" sym (float 0x4079000000000000)))
    (expr (call ok (== (. (call lastFrag (& fb2)) w) want) "and the first list keeps its own"))
    (expr (call fontFallback pf sf))
    (expr (call ok (== (call textWidth pf (call bytes sym) (bool false)) cw) "duplicate fallback ignored"))
    (let kept _ (call textWidth pf (call bytes "A\xf0\x9f\x8e\xae\xef\xb8\x8fB") (bool false)))
    (expr (call ok (== kept cw) "a variation selector joins the run before it (and has no width)"))
    (expr (call ok (== (call textWidth pf (call bytes "h\xc3\xa9llo") (bool false)) (call textWidth (call loadFont (. (index (. (. css fonts) items) 0) path) 16) (call bytes "h\xc3\xa9llo") (bool false))) "latin text stays in the primary"))
    (expr (call ok (== (. (. css warns) len) 0) "font-family list parses"))))
  (fn (doc "Shaping: Arabic letters join (narrower than isolated forms), and mixed text measures as its runs.") testShaping (params) _ (block
    (let f _ (call tryLoadFont "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" 24))
    (if (|| (== (. f raw) 0) (! (call textShaping))) (block
      (expr (call printLn "shaping: skipped (no DejaVu or no HarfBuzz)"))
      (return)))
    (let ar _ "\xd8\xb3\xd9\x84\xd8\xa7\xd9\x85")
    (let joined _ (call textWidth f (call bytes ar) (bool false)))
    (expr (call fontShape f (bool true) "Arab"))
    (let direct _ (call textWidth f (call bytes ar) (bool false)))
    (expr (call fontShape f (bool false) "Latn"))
    (expr (call ok (== joined direct) "arabic run is measured shaped (rtl, Arab)"))
    (let isolated _ (+ (+ (+ (call textWidth f (call bytes "\xd8\xb3") (bool false)) (call textWidth f (call bytes "\xd9\x84") (bool false))) (call textWidth f (call bytes "\xd8\xa7") (bool false))) (call textWidth f (call bytes "\xd9\x85") (bool false))))
    (expr (call ok (< joined isolated) "arabic letters join: narrower than the isolated forms"))
    (let mixed _ (call textWidth f (call bytes "ab \xd8\xb3\xd9\x84\xd8\xa7\xd9\x85 12") (bool false)))
    (expr (call ok (== mixed (+ (+ (call textWidth f (call bytes "ab ") (bool false)) joined) (call textWidth f (call bytes " 12") (bool false)))) "mixed text measures as the sum of its runs"))))
  (fn (doc "Caret x, hit test and selection rectangles of reordered text: index to x is monotonic per run direction, x to index\nround trips at each boundary, a selection across a direction change is two rectangles.") testCaretRtl (params) _ (block
    (let f _ (call tryLoadFont "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" 24))
    (if (|| (== (. f raw) 0) (! (call textShaping))) (block
      (expr (call printLn "rtl caret: skipped (no DejaVu or no HarfBuzz)"))
      (return)))
    (let ar _ (call bytes "\xd9\x83\xd8\xaa\xd8\xa8"))
    (expr (call ok (call textBidi f ar) "arabic is reordered"))
    (expr (call ok (! (call textBidi f (call bytes "abc def"))) "latin is not"))
    (let w _ (call textWidth f ar (bool false)))
    (expr (call near (call textCaretX f ar (bool false) 0) w (float 0x3ff0000000000000) "arabic: caret at index 0 is the right edge"))
    (expr (call near (call textCaretX f ar (bool false) (. ar len)) (float 0x0000000000000000) (float 0x3ff0000000000000) "arabic: caret at the end is the left edge"))
    (let prev f32 (+ w (float 0x3ff0000000000000)))
    (let i _ 0)
    (while (<= i (. ar len)) (block
      (let x _ (call textCaretX f ar (bool false) i))
      (expr (call ok (< x prev) "arabic: x decreases with the index"))
      (= prev x)
      (expr (call ok (== (call textIndexAt f ar (bool false) x) i) "arabic: x maps back to the index"))
      (+= i 2)))
    (expr (call ok (&& (== (call textIndexAt f ar (bool false) (- (float 0x4024000000000000))) (. ar len)) (== (call textIndexAt f ar (bool false) (+ w (float 0x4024000000000000))) 0)) "arabic: past the edges"))
    (let m _ (call bytes "abc \xd7\x90\xd7\x91\xd7\x92 def"))
    (let wa _ (call textWidth f (call bytes "abc ") (bool false)))
    (let wh _ (call textWidth f (call bytes "\xd7\x90\xd7\x91\xd7\x92") (bool false)))
    (expr (call ok (call textBidi f m) "mixed is reordered"))
    (expr (call near (call textCaretX f m (bool false) 2) (call textWidth f (call bytes "ab") (bool false)) (float 0x3ff0000000000000) "mixed: ltr prefix x"))
    (expr (call near (call textCaretX f m (bool false) 4) wa (float 0x3ff0000000000000) "mixed: boundary belongs to the preceding ltr run (right edge of 'abc ')"))
    (expr (call near (call textCaretX f m (bool false) 10) wa (float 0x3ff0000000000000) "mixed: end of the hebrew run is its left edge"))
    (expr (call near (call textCaretX f m (bool false) 6) (- (+ wa wh) (call textWidth f (call bytes "\xd7\x90") (bool false))) (float 0x3ff8000000000000) "mixed: inside rtl run x counts from the right"))
    (let k _ 6)
    (let last f32 (+ (+ wa wh) (float 0x3ff0000000000000)))
    (while (<= k 10) (block
      (let xk _ (call textCaretX f m (bool false) k))
      (expr (call ok (< xk last) "mixed: x decreases through the hebrew run"))
      (= last xk)
      (expr (call ok (|| (== (call textIndexAt f m (bool false) xk) k) (== k 10)) "mixed: round trip inside the run"))
      (+= k 2)))
    (let j _ 0)
    (let lastl f32 (- (float 0x3ff0000000000000)))
    (while (<= j 4) (block
      (let xj _ (call textCaretX f m (bool false) j))
      (expr (call ok (> xj lastl) "mixed: x grows through the ltr run"))
      (= lastl xj)
      (expr (call ok (|| (== (call textIndexAt f m (bool false) xj) j) (== j 4)) "mixed: ltr round trip (index 4 shares its point with the hebrew run end)"))
      (+= j 1)))
    (= j 10)
    (while (< j (. m len)) (block
      (expr (call ok (== (call textIndexAt f m (bool false) (call textCaretX f m (bool false) (+ j 1))) (+ j 1)) "mixed: trailing ltr round trip"))
      (+= j 1)))
    (let n _ (call textSelRects f m (bool false) 2 6))
    (expr (call ok (== n 2) "selection across a direction change is two rectangles"))
    (expr (call near (call selRectX 0) (call textWidth f (call bytes "ab") (bool false)) (float 0x3ff0000000000000) "first rectangle starts at 'c'"))
    (expr (call near (+ (call selRectX 1) (call selRectW 1)) (+ wa wh) (float 0x3ff0000000000000) "second rectangle ends at the right edge of the hebrew run"))
    (expr (call ok (== (call textSelRects f m (bool false) 4 10) 1) "a whole run is one rectangle"))
    (expr (call ok (== (call textSelRects f m (bool false) 0 (. m len)) 1) "everything merges into one rectangle"))
    (expr (call near (call selRectW 0) (call textWidth f m (bool false)) (float 0x3ff8000000000000) "and covers the line"))
    (expr (call ok (== (call textSelRects f (call bytes "abc") (bool false) 1 2) 1) "plain text: one rectangle"))))
  (fn (doc "`j3.text.fmtInt` / `fmtBytes`: boundaries, negatives, i64 extremes, and the returned view is only what was appended.") testFmt (params (mem (ref Arena))) _ (block
    (let t _ (call (. Text new) mem))
    (let big _ 9223372036854775807)
    (let small _ (- (- 0 big) 1))
    (expr (call ok (call same (call fmtInt (& t) 0) "0") "fmtInt 0"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) 999) "999") "fmtInt 999"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) 1000) "1,000") "fmtInt 1000"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) 1234567) "1,234,567") "fmtInt 1234567"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) (- 0 1234567)) "-1,234,567") "fmtInt negative"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) (- 0 100)) "-100") "fmtInt -100 has no comma"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) big) "9,223,372,036,854,775,807") "fmtInt max"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtInt (& t) small) "-9,223,372,036,854,775,808") "fmtInt min"))
    (expr (call (. t clear)))
    (expr (call (. t pushStr) "a="))
    (let part _ (call fmtInt (& t) 12345))
    (expr (call ok (&& (call same part "12,345") (call same (call (. t str)) "a=12,345")) "fmtInt appends and returns only its part"))
    (expr (call (. t clear)))
    (expr (call (. t pushInt) small))
    (expr (call (. t pushStr) " "))
    (expr (call (. t pushInt) big))
    (expr (call (. t pushStr) " "))
    (expr (call (. t pushInt) (- 0 7)))
    (expr (call (. t pushStr) " "))
    (expr (call (. t pushInt) 0))
    (expr (call ok (call same (call (. t str)) "-9223372036854775808 9223372036854775807 -7 0") "pushInt handles the i64 extremes"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 0) "0 B") "fmtBytes 0"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 999) "999 B") "fmtBytes 999"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1000) "1000 B") "fmtBytes 1000 is still bytes"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1023) "1023 B") "fmtBytes 1023"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1024) "1.0 KB") "fmtBytes 1024"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1536) "1.5 KB") "fmtBytes 1536"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1048575) "1023.9 KB") "fmtBytes just under 1 MB never shows 1024.0"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 1572864) "1.5 MB") "fmtBytes 1.5 MB"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) 2147483648) "2.0 GB") "fmtBytes 2 GB"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) (- 0 1536)) "-1.5 KB") "fmtBytes negative"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) big) "7.9 EB") "fmtBytes max is EB"))
    (expr (call (. t clear)))
    (expr (call ok (call same (call fmtBytes (& t) small) "-7.9 EB") "fmtBytes min is EB"))))
  (fn (doc "Color emoji: the fixed 109 px strike is scaled to the font size (measure, line height), and a line with emoji is as tall as one without.") testEmoji (params (mem (ref Arena))) _ (block
    (let path _ "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf")
    (let e16 _ (call tryLoadFont path 16))
    (if (== (. e16 raw) 0) (block
      (expr (call printLn "emoji: SKIPPED (no color emoji font at /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf)"))
      (return)))
    (let e32 _ (call loadFont path 32))
    (let w16 _ (call textWidth e16 (call bytes "\xf0\x9f\xa5\xb3") (bool false)))
    (let w32 _ (call textWidth e32 (call bytes "\xf0\x9f\xa5\xb3") (bool false)))
    (expr (call ok (&& (>= w16 (float 0x4028000000000000)) (<= w16 (float 0x4038000000000000))) "emoji at 16 px measures about the font size, not the 109 px strike"))
    (expr (call ok (&& (>= w32 (float 0x4038000000000000)) (<= w32 (float 0x4046000000000000))) "emoji at 32 px measures about the font size"))
    (expr (call ok (&& (> w32 (* w16 (float 0x3ffccccccccccccd))) (< w32 (* w16 (float 0x400199999999999a)))) "emoji width is proportional to the size"))
    (expr (call ok (&& (== (call fontLine e16) 16) (== (call fontLine e32) 32)) "emoji font line height is the font size"))
    (let sheet _ "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } @font-face { font-family: \"E\"; src: url(\"/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf\"); } .a { font-family: \"T\", \"E\"; font-size: 16px; } .b { font-family: \"T\", \"E\"; font-size: 32px; }")
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) sheet "emoji.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "emoji sheet parses"))
    (for k (.. 0 2) (block
      (let cls _ "a")
      (if (== k 1) (block
        (= cls "b")))
      (let plain _ (call block mem (& css) cls "Hello world" (float 0x4082c00000000000)))
      (let mixed _ (call block mem (& css) cls "Hello \xf0\x9f\xa5\xb3 world" (float 0x4082c00000000000)))
      (expr (call ok (== (. (index (. (. (. mixed d) nodes) items) (. mixed id)) h) (. (index (. (. (. plain d) nodes) items) (. plain id)) h)) "a line with emoji is as tall as a plain one"))
      (expr (call ok (> (. (call lastFrag (& mixed)) w) (. (call lastFrag (& plain)) w)) "the emoji takes width"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses with no warnings"))
    (= FONTPATH (. (index (. (. css fonts) items) 0) path))
    (expr (call testNoWrap (& mem) (& css)))
    (expr (call testEllipsis (& mem) (& css)))
    (expr (call testBreakWord (& mem) (& css)))
    (expr (call testPreLine (& mem) (& css)))
    (expr (call testStyle (& mem) (& css)))
    (expr (call testFit))
    (expr (call testAnim))
    (expr (call testFallback (& mem) (& css)))
    (expr (call testShaping))
    (expr (call testEmoji (& mem)))
    (expr (call testCaretRtl))
    (expr (call testFmt (& mem)))
    (expr (call printLn (interp "text_test: " CHECKS " checks passed"))))))
