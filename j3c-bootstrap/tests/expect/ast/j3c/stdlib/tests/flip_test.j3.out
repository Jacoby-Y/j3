(file (module flip_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.anim)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (mod-let CLICKED int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (if (|| (> (- a b) (float 0x3f847ae147ae147b)) (> (- b a) (float 0x3f847ae147ae147b))) (block
      (expr (call printLn (interp "FAIL: " msg ": " a " vs " b)))
      (expr (call panic msg))))))
  (const SHEET string ".list { display: flex; flex-wrap: wrap; } .row { width: 100px; height: 20px; }")
  (fn (doc "Rows `ord[0..n]` (keyed by `uids`), each with `animate:flip={ms}` and easing `ease` (-1: no flip); `vw` wide.") frame (params (d (ref Dom)) (ord (slice int)) (n int) (uids (slice int)) (rows (slice int)) (ms f32) (ease int) (vw f32)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x vw) (field y (float 0x4079000000000000)))))
    (let l _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) l "list"))
    (= CLICKED (- 1))
    (for i (.. 0 n) (block
      (let r _ (index ord i))
      (if (< (index uids r) 0) (block
        (= (index uids r) (call (. d groupNew) (- 1)))))
      (expr (call (. d keyBegin) (index uids r)))
      (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "row"))
      (if (>= ease 0) (block
        (expr (call (. d flip) e ms ease))))
      (= (index rows r) e)
      (if (call (. d clicked) e) (block
        (= CLICKED r)))
      (expr (call (. d close)))
      (expr (call (. d keyEnd)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn run (params (d (ref Dom)) (ord (slice int)) (n int) (uids (slice int)) (rows (slice int)) (ms f32) (ease int) (vw f32) (frames int)) _ (block
    (for i (.. 0 frames) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d ord n uids rows ms ease vw))))))
  (fn click (params (d (ref Dom)) (ord (slice int)) (n int) (uids (slice int)) (rows (slice int)) (x f32) (y f32)) int (block
    (let hit _ (- 1))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d ord n uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000)))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frame d ord n uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000)))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame d ord n uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000)))
    (return CLICKED)))
  (mod-let DROP_TO int _)
  (fn (doc "Like `frame`, but every row is a draggable source and drop target (its index is the drag id).") dframe (params (d (ref Dom)) (ord (slice int)) (n int) (uids (slice int)) (rows (slice int))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x406b800000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) d))
    (let l _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) l "list"))
    (= DROP_TO (- 1))
    (for i (.. 0 n) (block
      (let r _ (index ord i))
      (if (< (index uids r) 0) (block
        (= (index uids r) (call (. d groupNew) (- 1)))))
      (expr (call (. d keyBegin) (index uids r)))
      (let e _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "row"))
      (expr (call (. d flip) e (float 0x4069000000000000) 1))
      (expr (call (. d attrDraggable) e (bool true)))
      (expr (call (. d attrDragId) e r))
      (expr (call (. d attrDragTarget) e 8))
      (= (index rows r) e)
      (if (call (. d dropAt) e) (block
        (= DROP_TO r)
        (= DROP_FROM (call (. d dragIdOf)))))
      (expr (call (. d close)))
      (expr (call (. d keyEnd)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (mod-let DROP_FROM int _)
  (fn (doc "Dragging a flipping row, and dropping it (which reorders keyed rows), flips the rows that moved.") dragFlip (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let ord _ (call (. mem alloc) (targs int) 4))
    (let uids _ (call (. mem alloc) (targs int) 4))
    (let rows _ (call (. mem alloc) (targs int) 4))
    (for i (.. 0 4) (block
      (= (index ord i) i)
      (= (index uids i) (- 1))
      (= (index rows i) (- 1))))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call dframe (& d) ord 4 uids rows))
    (expr (call dframe (& d) ord 4 uids rows))
    (let fr _ (+ (. d frame) 1))
    (for k (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ fr k) fr (index rows 0) (index rows 3)))
      (expr (call dframe (& d) ord 4 uids rows))
      (if (>= DROP_TO 0) (block
        (break)))))
    (expr (call ok (&& (== DROP_TO 3) (== DROP_FROM 0)) "the drop reached row 3 carrying row 0's drag id"))
    (expr (call ok (== (. d flipLive) 0) "dragging alone starts no flight"))
    (= (index ord 0) 1)
    (= (index ord 1) 2)
    (= (index ord 2) 3)
    (= (index ord 3) 0)
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call dframe (& d) ord 4 uids rows))
    (expr (call ok (== (. d flipLive) 4) "the drop's reorder flips every row that moved"))
    (expr (call near (call (. d flipDx) (index rows 0)) (- (float 0x4059000000000000)) "dropped row starts from its old x"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let ord _ (call (. mem alloc) (targs int) 8))
    (let uids _ (call (. mem alloc) (targs int) 8))
    (let rows _ (call (. mem alloc) (targs int) 8))
    (for i (.. 0 8) (block
      (= (index ord i) i)
      (= (index uids i) (- 1))
      (= (index rows i) (- 1))))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 3))
    (expr (call ok (&& (== (. (. d flips) len) 4) (== (. d flipLive) 0)) "four listed, none flying"))
    (for i (.. 0 4) (block
      (expr (call near (call (. d flipDx) (index rows i)) (float 0x0000000000000000) "no offset before any move"))))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) (index rows 0)) x) (float 0x0000000000000000)) (== (. (index (. (. d nodes) items) (index rows 1)) x) (float 0x4059000000000000))) "layout as expected"))
    (= (index ord 0) 1)
    (= (index ord 1) 0)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 1))
    (let r0 _ (& (index (. (. d nodes) items) (index rows 0))))
    (let r1 _ (& (index (. (. d nodes) items) (index rows 1))))
    (let f0 _ (& (index (. (. d flips) items) (. r0 flip))))
    (let f1 _ (& (index (. (. d flips) items) (. r1 flip))))
    (expr (call ok (&& (== (. r0 x) (float 0x4059000000000000)) (== (. r1 x) (float 0x0000000000000000))) "layout moved at once"))
    (expr (call near (. f0 ox) (- (float 0x4059000000000000)) "t=0: row 0 paints at its old x"))
    (expr (call near (. f1 ox) (float 0x4059000000000000) "t=0: row 1 paints at its old x"))
    (expr (call near (. f0 oy) (float 0x0000000000000000) "no y offset"))
    (expr (call near (call (. d flipDx) (index rows 2)) (float 0x0000000000000000) "rows that stayed do not move"))
    (expr (call ok (== (. d flipLive) 2) "two flights"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call ok (== (. d flipLive) 0) "turning it on ends the flights"))
    (expr (call near (call (. d flipDx) (index rows 0)) (float 0x0000000000000000) "offset 0 at once"))
    (expr (call (. d setReducedMotion) (bool false)))
    (= (index ord 0) 0)
    (= (index ord 1) 1)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 20))
    (= (index ord 0) 1)
    (= (index ord 1) 0)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 1))
    (expr (call ok (== (. d flipLive) 2) "flips work again once it is off"))
    (expr (call (. d setReducedMotion) (bool true)))
    (= (index ord 0) 0)
    (= (index ord 1) 1)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 2))
    (= (index ord 0) 1)
    (= (index ord 1) 0)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 1))
    (expr (call ok (&& (== (. r0 x) (float 0x4059000000000000)) (== (. d flipLive) 0)) "reduced motion: moved, no flight"))
    (expr (call near (call (. d flipDx) (index rows 0)) (float 0x0000000000000000) "reduced motion: offset 0"))
    (expr (call (. d setReducedMotion) (bool false)))
    (= (index ord 0) 0)
    (= (index ord 1) 1)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 20))
    (= (index ord 0) 1)
    (= (index ord 1) 0)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 1))
    (let laidF _ (. d laid))
    (let restF _ (. d restyled))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 6))
    (expr (call ok (&& (== (. d laid) laidF) (== (. d restyled) restF)) "mid flight frames neither lay out nor restyle"))
    (let t _ (/ (- (. d now) (. f0 t0)) (float 0x4069000000000000)))
    (expr (call ok (&& (> t (float 0x3fd3333333333333)) (< t (float 0x3fe6666666666666))) "mid flight"))
    (expr (call near (. f0 ox) (* (- (float 0x4059000000000000)) (- (float 0x3ff0000000000000) t)) "linear mid: row 0 offset"))
    (expr (call near (. f1 ox) (* (float 0x4059000000000000) (- (float 0x3ff0000000000000) t)) "linear mid: row 1 offset"))
    (expr (call ok (!= (call click (& d) ord 4 uids rows (float 0x4065400000000000) (float 0x4024000000000000)) 0) "mid flight: the click does not land on row 0's layout slot"))
    (let vis0 _ (+ (. r0 x) (. f0 ox)))
    (let vis1 _ (+ (. r1 x) (. f1 ox)))
    (= (index ord 0) 0)
    (= (index ord 1) 1)
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000)))
    (expr (call ok (&& (== (. r0 x) (float 0x0000000000000000)) (== (. r1 x) (float 0x4059000000000000))) "swapped back"))
    (expr (call ok (> (. f0 ox) (float 0x0000000000000000)) "interrupt: row 0 keeps part of the old flight (offset is now to the right)"))
    (expr (call near (+ (. r0 x) (. f0 ox)) vis0 "interrupt: row 0 starts from where it was drawn"))
    (expr (call near (+ (. r1 x) (. f1 ox)) vis1 "interrupt: row 1 starts from where it was drawn"))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 20))
    (expr (call ok (== (. d flipLive) 0) "all flights ended"))
    (for i (.. 0 4) (block
      (expr (call near (call (. d flipDx) (index rows i)) (float 0x0000000000000000) "end offset x"))
      (expr (call near (call (. d flipDy) (index rows i)) (float 0x0000000000000000) "end offset y"))))
    (expr (call ok (== (call click (& d) ord 4 uids rows (float 0x4065400000000000) (float 0x4024000000000000)) 1) "after the flight row 1 holds its slot"))
    (= (index ord 0) 1)
    (= (index ord 1) 0)
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 3 (float 0x406b800000000000) 1))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 3 (float 0x406b800000000000) 5))
    (let e _ (call (. anim preset) (. anim PRESET_OUT)))
    (let t2 _ (/ (- (. d now) (. f0 t0)) (float 0x4069000000000000)))
    (expr (call near (. f0 ox) (* (- (float 0x4059000000000000)) (- (float 0x3ff0000000000000) (call (. anim ease) (& e) t2))) "ease-out mid: row 0 offset"))
    (expr (call ok (> (. f0 ox) (* (- (float 0x4059000000000000)) (- (float 0x3ff0000000000000) t2))) "ease-out is ahead of linear"))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 3 (float 0x406b800000000000) 20))
    (expr (call ok (== (. d flipLive) 0) "eased flights ended"))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x405e000000000000) 1))
    (expr (call ok (|| (== (. (index (. (. d nodes) items) (index rows 0)) y) (float 0x4034000000000000)) (== (. (index (. (. d nodes) items) (index rows 0)) y) (float 0x0000000000000000))) "resized layout"))
    (expr (call ok (== (. d flipLive) 0) "resize starts no flight"))
    (expr (call near (call (. d flipDy) (index rows 3)) (float 0x0000000000000000) "resize: no offset"))
    (expr (call run (& d) ord 4 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 2))
    (expr (call ok (== (. d flipLive) 0) "resize back starts no flight either"))
    (let before _ (. (. d flips) len))
    (expr (call (. d groupFree) (index uids 3)))
    (= (index uids 3) (- 1))
    (expr (call run (& d) ord 3 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 3))
    (expr (call ok (== (. (. d flips) len) (- before 1)) "removed row leaves the flip list"))
    (for i (.. 0 (. (. d flips) len)) (block
      (expr (call ok (== (. (index (. (. d nodes) items) (. (index (. (. d flips) items) i) node)) flip) i) "flip index stays in step"))))
    (= (index ord 2) 4)
    (expr (call run (& d) ord 3 uids rows (float 0x4069000000000000) (- 1) (float 0x406b800000000000) 3))
    (let reuse _ (& (index (. (. d nodes) items) (index rows 4))))
    (expr (call ok (== (. reuse flip) (- 1)) "a recycled node carries no flip state"))
    (expr (call dragFlip (& mem) (& css)))
    (expr (call run (& d) ord 3 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 5))
    (let used0 _ (. mem used))
    (let laid0 _ (. d laid))
    (let re0 _ (. d restyled))
    (expr (call run (& d) ord 3 uids rows (float 0x4069000000000000) 1 (float 0x406b800000000000) 300))
    (expr (call ok (&& (&& (== (. mem used) used0) (== (. d laid) laid0)) (== (. d restyled) re0)) "300 idle frames: no allocation, layout or restyle"))
    (expr (call printLn "flip_test ok")))))
--- stderr
--- exit 0
