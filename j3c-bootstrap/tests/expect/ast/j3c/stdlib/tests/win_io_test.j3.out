(file (module win_io_test)
  (use j3.io)
  (use j3.io.IoError)
  (use j3.io.path)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.proc)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.result.Result)
  (fn mk (params (p string)) bool (block
    (match (call (. io makeDirs) p)
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn wr (params (p string)) bool (block
    (match (call (. io writeFile) p (as "hi" (slice u8)))
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn isOk (params (r (gen Result bool IoError))) bool (block
    (match r
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn ok (params (c bool) (what string)) _ (block
    (if (! c) (block
      (expr (call panic what))))))
  (fn main (params) _ (block
    (expr (call ok (call mk "C:\\j3_win_io_test\\a\\b/c") "makeDirs mixed separators"))
    (expr (call ok (call mk "C:\\j3_win_io_test\\a\\b/c") "makeDirs again"))
    (expr (call ok (call mk "C:\\j3_win_io_test\\d\\e\\") "makeDirs backslashes"))
    (expr (call ok (call wr "C:\\j3_win_io_test\\a\\b/c/f.txt") "writeFile O_WRONLY+O_CREAT+O_TRUNC"))
    (expr (call ok (call (. io exists) "C:\\j3_win_io_test\\d\\e") "dir exists"))
    (expr (call ok (call (. io exists) "C:\\j3_win_io_test\\a\\b\\c\\f.txt") "file exists"))
    (expr (call ok (call mk "C:/j3_win_io_test/r") "makeDirs r"))
    (expr (call ok (&& (call isOk (call (. io removeDir) "C:/j3_win_io_test/r")) (! (call (. io exists) "C:/j3_win_io_test/r"))) "removeDir empty"))
    (expr (call ok (! (call isOk (call (. io removeDir) "C:\\j3_win_io_test\\a"))) "removeDir not empty fails"))
    (expr (call ok (! (call isOk (call (. io removeDir) "C:/j3_win_io_test/none"))) "removeDir missing fails"))
    (let a _ (call (. Arena create) 1048576))
    (let here _ (call (. io cwd) (& a)))
    (expr (call ok (&& (> (. here len) 2) (== (index here 1) 58)) "io.cwd has a drive"))
    (match (call (. path realpath) "C:/j3_win_io_test/a/../d" (& a))
      (arm (pats (variant Option.Some (bind p))) (block
        (expr (call ok (== p "C:\\j3_win_io_test\\d") "realpath"))))
      (arm (pats (variant Option.None)) (block
        (expr (call ok (bool false) "realpath")))))
    (let argv (array 3 string) (array-lit "cmd.exe" "/c" "echo %JZ_TEST%"))
    (let env (array 1 string) (array-lit "JZ_TEST=hello"))
    (match (call (. proc runEnv) (slice-expr argv _ _) "" (slice-expr env _ _) (& a))
      (arm (pats (variant Result.Ok (bind o))) (block
        (expr (call ok (== (call (. o outStr)) "hello\r\n") "runEnv"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "runEnv starts")))))
    (expr (call ok (call wr "C:/j3_win_io_test/h.txt") "write h.txt"))
    (let attrib (array 5 string) (array-lit "cmd.exe" "/c" "attrib" "+h" "C:\\j3_win_io_test\\h.txt"))
    (expr (call (. proc run) (slice-expr attrib _ _) "" (& a)))
    (match (call (. io stat) "C:/j3_win_io_test/h.txt")
      (arm (pats (variant Result.Ok (bind e))) (block
        (expr (call ok (. e hidden) "stat hidden"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "stat h.txt")))))
    (match (call (. io stat) "C:/j3_win_io_test/a")
      (arm (pats (variant Result.Ok (bind e))) (block
        (expr (call ok (! (. e hidden)) "stat not hidden"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "stat a")))))
    (match (call (. io listDir) "C:/j3_win_io_test" (& a))
      (arm (pats (variant Result.Ok (bind es))) (block
        (let seen _ (bool false))
        (for i (.. 0 (. es len)) (block
          (if (== (. (index es i) name) "h.txt") (block
            (= seen (. (index es i) hidden))))))
        (expr (call ok seen "listDir hidden"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "listDir")))))
    (let t0 _ (call (. sys monotonicMs)))
    (while (< (call (. sys monotonicMs)) (+ t0 50)) (block))
    (expr (call ok (&& (> t0 0) (>= (call (. sys monotonicMs)) (+ t0 40))) "monotonicMs"))
    (expr (call (. io printLn) "win_io_test ok")))))
--- stderr
--- exit 0
