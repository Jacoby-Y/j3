(file (module bidi_test)
  (use j3.game (names Font textCaretX textIndexAt textShaping textVisualRuns textWidth tryLoadFont))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names Text same))
  (mod-let CHECKS int _)
  (mod-let OUT (array 96 int) _)
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (fn (doc "Visual runs of `s` as `text@level|...`; empty when the text is not reordered.") vis (params (mem (ref Arena)) (f Font) (s string)) string (block
    (let msg _ (call bytes s))
    (let n _ (call textVisualRuns f msg (slice-expr OUT 0 96)))
    (let t _ (call (. Text new) mem))
    (for k (.. 0 n) (block
      (if (> k 0) (block
        (expr (call (. t pushStr) "|"))))
      (expr (call (. t pushStr) (as (slice-expr msg (index OUT (* 3 k)) (index OUT (+ (* 3 k) 1))) string)))
      (expr (call (. t pushStr) "@"))
      (expr (call (. t pushInt) (index OUT (+ (* 3 k) 2))))))
    (return (call (. t str)))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (mem (ref Arena)) (f Font) (s string) (want string)) _ (block
    (+= CHECKS 1)
    (let got _ (call vis mem f s))
    (if (! (call same got want)) (block
      (expr (call printLn (interp "FAIL: \"" s "\"")))
      (expr (call printLn (interp "  got  " got)))
      (expr (call printLn (interp "  want " want)))
      (expr (call panic "bidi order"))))))
  (fn (doc "Caret and hit test across the finer runs of \"\xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9: 12\": x falls through the Arabic and \": \" (indices 0..16), then the\nleft-to-right \"12\" run reads left to right (16..18); every boundary maps back to its index.") testCaret (params (f Font)) _ (block
    (let m _ (call bytes "\xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9: 12"))
    (let w _ (call textWidth f m (bool false)))
    (let w12 _ (call textWidth f (call bytes "12") (bool false)))
    (let prev _ (+ w (float 0x3ff0000000000000)))
    (let i _ 0)
    (while (<= i 16) (block
      (let x _ (call textCaretX f m (bool false) i))
      (expr (call ok (< x prev) "caret x falls through the Arabic word and the colon"))
      (= prev x)
      (+= i 1)
      (if (&& (< i 14) (== (% i 2) 1)) (block
        (+= i 1)))))
    (expr (call ok (> (call textCaretX f m (bool false) 0) (- w (float 0x3ff0000000000000))) "index 0 is the right edge"))
    (let x17 _ (call textCaretX f m (bool false) 17))
    (expr (call ok (&& (> x17 (float 0x3fe0000000000000)) (< x17 (- w12 (float 0x3fe0000000000000)))) "caret between 1 and 2 lies inside the digit run"))
    (expr (call ok (&& (> (call textCaretX f m (bool false) 18) (- w12 (float 0x3ff0000000000000))) (< (call textCaretX f m (bool false) 18) (+ w12 (float 0x3ff0000000000000)))) "caret at the end is the right edge of 12"))
    (expr (call ok (== (call textIndexAt f m (bool false) x17) 17) "click between the digits maps to 17"))
    (expr (call ok (== (call textIndexAt f m (bool false) (call textCaretX f m (bool false) 0)) 0) "click at the right edge maps to 0"))
    (expr (call ok (== (call textIndexAt f m (bool false) (call textCaretX f m (bool false) 4)) 4) "click inside the word maps back"))))
  (fn (doc "More than 256 runs (the old cap) order correctly: the logical end is leftmost, \"199\" read left to right. A text past\nthe 1024-run cap only warns once on stderr (the tail is one run) and still returns.") testManyRuns (params (mem (ref Arena)) (f Font)) _ (block
    (for pass (.. 0 2) (block
      (let words _ (+ 200 (* 100 pass)))
      (let t _ (call (. Text new) mem))
      (for k (.. 0 words) (block
        (expr (call (. t pushStr) "\xd9\x83\xd9\x84\xd9\x85\xd8\xa9 "))
        (expr (call (. t pushInt) k))
        (expr (call (. t pushStr) " "))))
      (let msg _ (call bytes (call (. t str))))
      (let n _ (call textVisualRuns f msg (slice-expr OUT 0 96)))
      (expr (call ok (== n 32) "output is limited by the caller's buffer"))
      (if (== words 200) (block
        (expr (call ok (&& (&& (== (index OUT 2) 1) (== (index OUT 5) 2)) (== (- (index OUT 4) (index OUT 3)) 3)) "the last number sits at the left, in reading order"))))))))
  (fn main (params) _ (block
    (let f _ (call tryLoadFont "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" 24))
    (if (|| (== (. f raw) 0) (! (call textShaping))) (block
      (expr (call printLn "bidi: skipped (no DejaVu or no HarfBuzz)"))
      (return)))
    (let mem _ (call (. Arena create) (* 1024 1024)))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9: 12" "12@2|: @1|\xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9 10:30" "10:30@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1 3,5" "3,5@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1 1.000,50" "1.000,50@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd9\x86\xd8\xb3\xd8\xa8\xd8\xa9 1/2" "1/2@2| @1|\xd8\xa7\xd9\x84\xd9\x86\xd8\xb3\xd8\xa8\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd9\x86\xd8\xb3\xd8\xa8\xd8\xa9 50%" "%@1|50@2| @1|\xd9\x86\xd8\xb3\xd8\xa8\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd7\x90\xd7\x97\xd7\x95\xd7\x96 50%" "50%@2| @1|\xd7\x90\xd7\x97\xd7\x95\xd7\x96@1"))
    (expr (call eq (& mem) f "\xd7\x94\xd7\xa4\xd7\xa8\xd7\xa9 -5" "5@2| -@1|\xd7\x94\xd7\xa4\xd7\xa8\xd7\xa9@1"))
    (expr (call eq (& mem) f "\xd7\x9e\xd7\x97\xd7\x99\xd7\xa8 $20" "$20@2| @1|\xd7\x9e\xd7\x97\xd7\x99\xd7\xa8@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1 $20" "20@2| $@1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xb9\xd8\xb1@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9 \xd9\xa1\xd9\xa0:\xd9\xa3\xd9\xa0" "\xd9\xa1\xd9\xa0@2|:@2|\xd9\xa3\xd9\xa0@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9 \xdb\xb1\xdb\xb0:\xdb\xb3\xdb\xb0" "\xdb\xb1\xdb\xb0@2|:@2|\xdb\xb3\xdb\xb0@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9@1"))
    (expr (call eq (& mem) f "\xd7\x99\xd7\xa9 12." ".@1|12@2| @1|\xd7\x99\xd7\xa9@1"))
    (expr (call eq (& mem) f "Say \xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9 12 ok" "Say @0|12@2| @1|\xd8\xa7\xd9\x84\xd9\x86\xd8\xaa\xd9\x8a\xd8\xac\xd8\xa9@1| ok@0"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb1\xd9\x82\xd9\x85 \xd9\xa1\xd9\xa23" "\xd9\xa1\xd9\xa2@2|3@2| @1|\xd8\xa7\xd9\x84\xd8\xb1\xd9\x82\xd9\x85@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb1\xd9\x82\xd9\x85 \xd9\xa1\xd9\xa2\xd9\xa3,\xd9\xa4\xd9\xa5\xd9\xa6" "\xd9\xa1\xd9\xa2\xd9\xa3@2|,@2|\xd9\xa4\xd9\xa5\xd9\xa6@2| @1|\xd8\xa7\xd9\x84\xd8\xb1\xd9\x82\xd9\x85@1"))
    (expr (call eq (& mem) f "\xd7\x9e\xd7\xa1\xd7\xa4\xd7\xa8 \xd9\xa1\xd9\xa23" "\xd9\xa1\xd9\xa2@2|3@2| @1|\xd7\x9e\xd7\xa1\xd7\xa4\xd7\xa8@1"))
    (expr (call eq (& mem) f "\xd9\x83\xd9\x8e\xd8\xaa\xd9\x8e\xd8\xa8\xd9\x8e" "\xd9\x83\xd9\x8e\xd8\xaa\xd9\x8e\xd8\xa8\xd9\x8e@1"))
    (expr (call eq (& mem) f "\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9 12:30" "12:30@2| @1|\xd8\xa7\xd9\x84\xd8\xb3\xd8\xa7\xd8\xb9\xd8\xa9@1"))
    (expr (call eq (& mem) f "x 3,5.a \xd9\x86" "x 3,5.a @0|\xd9\x86@1"))
    (expr (call eq (& mem) f "abc 12, 3:4 5%" ""))
    (expr (call testCaret f))
    (expr (call testManyRuns (& mem) f))
    (expr (call printLn (interp "bidi_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
