(file (module env_test)
  (use j3.io.printLn)
  (use j3.sys)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call (. sys panic) msg))))))
  (fn main (params) _ (block
    (expr (call ok (== (call (. sys env) "J3_ENV_TEST_X") "") "unset at start"))
    (expr (call ok (call (. sys setenv) "J3_ENV_TEST_X" "one two") "setenv"))
    (expr (call ok (== (call (. sys env) "J3_ENV_TEST_X") "one two") "read back"))
    (expr (call ok (call (. sys setenv) "J3_ENV_TEST_X" "2") "overwrite"))
    (expr (call ok (== (call (. sys env) "J3_ENV_TEST_X") "2") "read back overwritten"))
    (expr (call ok (call (. sys setenv) "J3_ENV_TEST_X" "") "set empty"))
    (expr (call ok (== (call (. sys env) "J3_ENV_TEST_X") "") "read back empty"))
    (expr (call ok (|| (> (. (call (. sys env) "HOME") len) 0) (> (. (call (. sys env) "PATH") len) 0)) "inherited variables still read"))
    (expr (call ok (! (call (. sys setenv) "" "x")) "empty name refused"))
    (expr (call ok (! (call (. sys setenv) "A=B" "x")) "name with = refused"))
    (expr (call printLn "env_test ok")))))
--- stderr
--- exit 0
