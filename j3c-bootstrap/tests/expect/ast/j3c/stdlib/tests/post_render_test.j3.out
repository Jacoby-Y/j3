(file (module post_render_test)
  (use-lib "GL" gl
    (lib-fn glGetError (params) u32 _))
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.paint)
  (use j3.gfx.paint (names Corners Stop))
  (use j3.gfx.canvas (names Canvas Mode))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (fn ok (params (b bool) (msg string)) _ (block
    (if (! b) (block
      (expr (call panic msg))))))
  (fn gi (params (key u32)) i32 (block
    (let get _ (as (call (. game glProc) "glGetIntegerv") (fn-type (u32 ptr) _)))
    (let v i32 0)
    (expr (call get key (as (& v) ptr)))
    (return v)))
  (fn noError (params) _ (block
    (let err _ (as (call (. game glProc) "glGetError") (fn-type () u32)))
    (let e _ (call err))
    (if (!= e 0) (block
      (expr (call printLn (interp "GL error: " e)))
      (expr (call panic "GL operation failed"))))))
  (fn corners (params) Corners (block
    (return (struct-lit Corners (field tl 24) (field tr 24) (field br 24) (field bl 24)))))
  (fn stripes (params (w int) (h int)) _ (block
    (for i (.. 0 (/ w 4)) (block
      (let c _ (struct-lit Color (field r 240) (field g 70) (field b 40) (field a 255)))
      (if (== (% i 2) 0) (block
        (= c (struct-lit Color (field r 20) (field g 100) (field b 240) (field a 255)))))
      (expr (call (. paint rect) (struct-lit Vec2 (field x (call f32 (* i 4))) (field y 0)) (struct-lit Vec2 (field x 4) (field y (call f32 h))) c))))
    (expr (call (. paint flush)))))
  (fn save (params (mem (ref Arena)) (path string) (w int) (h int)) _ (block
    (let c _ (call (. Canvas create) mem (call i32 w) (call i32 h) (. Mode Pixel)))
    (expr (call ok (call (. game readWindow) (. c pixels)) "read screenshot"))
    (match (call (. c savePng) path mem)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save screenshot")))))))
  (fn variance (params (p (slice u8)) (w int) (y int) (x int)) int (block
    (let lo _ 255)
    (let hi _ 0)
    (for i (.. 0 64) (block
      (let v _ (call int (index p (* (+ (+ (* y w) x) i) 4))))
      (if (< v lo) (block
        (= lo v)))
      (if (> v hi) (block
        (= hi v)))))
    (return (- hi lo))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 8 1024) 1024)))
    (expr (call (. game initGlHidden) "backdrop checks" 480 320))
    (expr (call (. game clearTo) (struct-lit Color (field r 10) (field g 10) (field b 10) (field a 255))))
    (expr (call stripes 480 320))
    (let before _ (call (. mem alloc) (targs u8) (* (* 480 320) 4)))
    (expr (call ok (call (. game readWindow) before) "read sharp frame"))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) 0))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) (- 1)))
    (let after _ (call (. mem alloc) (targs u8) (* (* 480 320) 4)))
    (expr (call ok (call (. game readWindow) after) "read zero radius frame"))
    (for i (.. 0 (. after len)) (block
      (expr (call ok (== (index after i) (index before i)) "zero/negative radius is no-op"))))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) 12))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 248) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) 64))
    (expr (call ok (call (. game readWindow) after) "read blurred frame"))
    (expr (call ok (> (call variance before 480 100 64) 200) "sharp control has contrast"))
    (expr (call ok (< (call variance after 480 100 64) 8) "sigma 12 removes stripe contrast"))
    (expr (call ok (< (call variance after 480 100 280) 8) "sigma 64 prefilter avoids sparse tap aliasing"))
    (expr (call ok (== (index after (* (+ (* 20 480) 16) 4)) (index before (* (+ (* 20 480) 16) 4))) "rounded corner retains backdrop"))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 40) (field y 60)) (struct-lit Vec2 (field x 150) (field y 4)) (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 272) (field y 60)) (struct-lit Vec2 (field x 150) (field y 4)) (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255))))
    (expr (call (. paint pushClip) (struct-lit Vec2 (field x 30) (field y 258)) (struct-lit Vec2 (field x 140) (field y 48))))
    (expr (call (. paint pushAlpha) (float 0x3fe0000000000000)))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 250)) (struct-lit Vec2 (field x 200) (field y 60)) (call corners) 8))
    (expr (call (. paint popAlpha)))
    (expr (call (. paint popClip)))
    (expr (call (. paint pushRotate) (struct-lit Vec2 (field x 350) (field y 280)) (float 0x3fbeb851eb851eb8)))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 250) (field y 254)) (struct-lit Vec2 (field x 200) (field y 50)) (call corners) 8))
    (expr (call (. paint popTransform)))
    (expr (call (. paint flush)))
    (expr (call save (& mem) "/tmp/j3-post-render.png" 480 320))
    (expr (call noError))
    (expr (call stripes 480 320))
    (let stops (array 4 Stop) (array-lit (struct-lit Stop (field at 0) (field color (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 0)))) (struct-lit Stop (field at (float 0x3fd999999999999a)) (field color (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 0)))) (struct-lit Stop (field at (float 0x3fe3333333333333)) (field color (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255)))) (struct-lit Stop (field at 1) (field color (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255))))))
    (let row _ (call (. paint gradient) (slice-lit Stop (field ptr (& (index stops 0))) (field len 4))))
    (expr (call (. paint pushView) (struct-lit Vec2 (field x 60) (field y 40)) (struct-lit Vec2 (field x 240) (field y 160))))
    (expr (call (. paint pushMask) 1 row (float 0x3ff921fb4d12d84a) (struct-lit Vec2 (field x 10) (field y 10)) (struct-lit Vec2 (field x 200) (field y 120))))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 10) (field y 10)) (struct-lit Vec2 (field x 200) (field y 120)) (call corners) 12))
    (expr (call (. paint popMask)))
    (expr (call (. paint popView)))
    (expr (call ok (call (. game readWindow) after) "read masked view"))
    (expr (call ok (> (call variance after 480 100 76) 180) "transparent mask retains sharp stripes in subview"))
    (expr (call ok (< (call variance after 480 100 196) 8) "opaque mask applies blur in subview"))
    (expr (call ok (> (call variance after 480 100 330) 200) "pixels outside subview remain sharp"))
    (expr (call save (& mem) "/tmp/j3-post-mask-view.png" 480 320))
    (expr (call noError))
    (let vp _ (as (call (. game glProc) "glViewport") (fn-type (i32 i32 i32 i32) _)))
    (let sc _ (as (call (. game glProc) "glScissor") (fn-type (i32 i32 i32 i32) _)))
    (let en _ (as (call (. game glProc) "glEnable") (fn-type (u32) _)))
    (let dis _ (as (call (. game glProc) "glDisable") (fn-type (u32) _)))
    (let active _ (as (call (. game glProc) "glActiveTexture") (fn-type (u32) _)))
    (let useProg _ (as (call (. game glProc) "glUseProgram") (fn-type (u32) _)))
    (let blend _ (as (call (. game glProc) "glBlendFuncSeparate") (fn-type (u32 u32 u32 u32) _)))
    (expr (call vp 7 9 100 80))
    (expr (call sc 11 13 60 40))
    (expr (call en 3089))
    (expr (call en 3042))
    (expr (call en 2960))
    (expr (call dis 2929))
    (expr (call active 33987))
    (expr (call useProg 0))
    (expr (call blend 1 0 0 1))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) 4))
    (expr (call ok (&& (== (call gi 35725) 0) (== (call gi 34016) 33987)) "program and active texture restored"))
    (expr (call ok (&& (&& (&& (== (call gi 32969) 1) (== (call gi 32968) 0)) (== (call gi 32971) 0)) (== (call gi 32970) 1)) "separate blend factors restored"))
    (let enabled _ (as (call (. game glProc) "glIsEnabled") (fn-type (u32) u8)))
    (expr (call ok (&& (&& (&& (!= (call enabled 3089) 0) (!= (call enabled 3042) 0)) (!= (call enabled 2960) 0)) (== (call enabled 2929) 0)) "GL enables restored"))
    (let rect (array 4 i32) (array-lit 0 0 0 0))
    (let get _ (as (call (. game glProc) "glGetIntegerv") (fn-type (u32 ptr) _)))
    (expr (call get 2978 (as (& (index rect 0)) ptr)))
    (expr (call ok (&& (&& (&& (== (index rect 0) 7) (== (index rect 1) 9)) (== (index rect 2) 100)) (== (index rect 3) 80)) "viewport restored"))
    (expr (call get 3088 (as (& (index rect 0)) ptr)))
    (expr (call ok (&& (&& (&& (== (index rect 0) 11) (== (index rect 1) 13)) (== (index rect 2) 60)) (== (index rect 3) 40)) "scissor restored"))
    (expr (call dis 3089))
    (expr (call dis 3042))
    (expr (call dis 2960))
    (expr (call active 33984))
    (expr (call noError))
    (let gen _ (as (call (. game glProc) "glGenTextures") (fn-type (i32 ptr) _)))
    (let tex u32 0)
    (expr (call gen 1 (as (& tex) ptr)))
    (let bindTex _ (as (call (. game glProc) "glBindTexture") (fn-type (u32 u32) _)))
    (expr (call bindTex 3553 tex))
    (let image _ (as (call (. game glProc) "glTexImage2D") (fn-type (u32 i32 i32 i32 i32 i32 u32 u32 ptr) _)))
    (expr (call image 3553 0 32856 480 320 0 6408 5121 (as 0 ptr)))
    (let fb u32 0)
    (let genFb _ (as (call (. game glProc) "glGenFramebuffers") (fn-type (i32 ptr) _)))
    (expr (call genFb 1 (as (& fb) ptr)))
    (let bindFb _ (as (call (. game glProc) "glBindFramebuffer") (fn-type (u32 u32) _)))
    (expr (call bindFb 36160 fb))
    (let attach _ (as (call (. game glProc) "glFramebufferTexture2D") (fn-type (u32 u32 u32 u32 i32) _)))
    (expr (call attach 36160 36064 3553 tex 0))
    (expr (call stripes 480 320))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 16) (field y 20)) (struct-lit Vec2 (field x 200) (field y 220)) (call corners) 12))
    (expr (call ok (&& (== (call gi 36006) (call i32 fb)) (== (call gi 36010) (call i32 fb))) "user framebuffer bindings restored"))
    (let read _ (as (call (. game glProc) "glReadPixels") (fn-type (i32 i32 i32 i32 u32 u32 ptr) _)))
    (expr (call read 0 0 480 320 6408 5121 (as (. after ptr) ptr)))
    (expr (call ok (< (call variance after 480 160 64) 8) "blur samples current user framebuffer"))
    (expr (call noError))
    (expr (call (. game setWindowSize) 640 360))
    (expr (call bindTex 3553 tex))
    (expr (call image 3553 0 32856 640 360 0 6408 5121 (as 0 ptr)))
    (expr (call (. game clearTo) (struct-lit Color (field r 10) (field g 10) (field b 10) (field a 255))))
    (expr (call stripes 640 360))
    (expr (call (. paint backdropBlur) (struct-lit Vec2 (field x 32) (field y 24)) (struct-lit Vec2 (field x 576) (field y 312)) (call corners) 12))
    (let resized _ (call (. Canvas create) (& mem) 640 360 (. Mode Pixel)))
    (expr (call read 0 0 640 360 6408 5121 (as (. (. resized pixels) ptr) ptr)))
    (expr (call ok (< (call variance (. resized pixels) 640 180 64) 8) "resized target blurs new framebuffer dimensions"))
    (match (call (. resized savePng) "/tmp/j3-post-resize.png" (& mem))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save resize")))))
    (expr (call bindFb 36160 0))
    (let delFb _ (as (call (. game glProc) "glDeleteFramebuffers") (fn-type (i32 ptr) _)))
    (expr (call delFb 1 (as (& fb) ptr)))
    (let delTex _ (as (call (. game glProc) "glDeleteTextures") (fn-type (i32 ptr) _)))
    (expr (call delTex 1 (as (& tex) ptr)))
    (expr (call noError))
    (expr (call (. game destroy)))
    (expr (call (. mem destroy)))
    (expr (call printLn "post_render_test: passed (zero radius, blur contrast, rounded edges, multiple panels, transforms, masks, subviews, GL state, user framebuffer, resize, teardown)")))))
--- stderr
--- exit 0
