(file (module j2_host_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Error Args Value Limits Ref Table))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (struct Host
    (field out Text)
    (field count int)
    (field lastErr Text))
  (fn host (params (vm (ref Vm))) (ref Host) (block
    (return (as (. vm host) (ref Host)))))
  (fn capture (params (vm (ref Vm)) (args Args)) Value (block
    (let h _ (call host vm))
    (expr (call (. (. h out) pushStr) (call (. args joined) " ")))
    (expr (call (. (. h out) push) 10))
    (return (call (. j2 nil)))))
  (fn quiet (params (_vm (ref Vm)) (_args Args)) Value (block
    (return (call (. j2 nil)))))
  (fn (doc "`bump(n)`: adds `n` (default 1) to the host's counter and returns it.") bump (params (vm (ref Vm)) (args Args)) Value (block
    (let h _ (call host vm))
    (+= (. h count) (call (. args intOr) 0 1))
    (return (call (. j2 int) (. h count)))))
  (fn (doc "`apply(f, x)`: calls the script fn `f(x)` and returns what it gave; a script error inside\nis raised again here, so it unwinds through this native too.") apply (params (vm (ref Vm)) (args Args)) Value (block
    (let f _ (call (. args func) 0))
    (let one (array 1 Value) (array-lit (call (. args get) 1)))
    (match (call (. vm call) f (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (return v)))
      (arm (pats (variant Result.Err (bind e))) (block
        (let h _ (call host vm))
        (expr (call (. (. h lastErr) clear)))
        (expr (call (. (. h lastErr) pushStr) (. e message)))
        (return (call (. vm raise) (. e message))))))))
  (fn (doc "`spawn(kind, x, y)`: checks its argument types through the getters only.") spawn (params (vm (ref Vm)) (args Args)) Value (block
    (let kind _ (call (. args str) 0))
    (let x _ (call (. args num) 1))
    (let y _ (call (. args num) 2))
    (let t _ (call (. vm newTable)))
    (expr (call (. t set) "kind" (call (. j2 str) vm kind)))
    (expr (call (. t set) "x" (call (. j2 num) x)))
    (expr (call (. t set) "y" (call (. j2 num) y)))
    (return (call (. t value)))))
  (fn (doc "`recurse()`: calls itself through `vm.call` forever (stopped by the nesting limit).") recurse (params (vm (ref Vm)) (_args Args)) Value (block
    (let none (slice Value) (slice-from (as 0 ptr) 0))
    (match (call (. vm call) (call (. vm global) (call (. j2 str) vm "recurse")) none)
      (arm (pats (variant Result.Ok (bind v))) (block
        (return v)))
      (arm (pats (variant Result.Err (bind e))) (block
        (return (call (. vm raise) (. e message))))))))
  (fn check (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn newVm (params (mem (ref Arena)) (h (ref Host))) Vm (block
    (let vm _ (call (. Vm new) mem (struct-lit Limits)))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" capture))
    (expr (call (. vm bind) "bump" bump))
    (expr (call (. vm bind) "apply" apply))
    (expr (call (. vm bind) "spawn" spawn))
    (expr (call (. vm bind) "recurse" recurse))
    (= (. vm host) (as h ptr))
    (return vm)))
  (fn load (params (vm (ref Vm)) (name string) (src string)) Value (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (bind t))) (block
        (return t)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "unexpected load error")))))))
  (fn loadErr (params (vm (ref Vm)) (name string) (src string)) string (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "expected a load error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (return (. e message)))))))
  (fn unwound (params (vm (ref Vm))) _ (block
    (if (|| (|| (|| (|| (!= (. vm nframes) 0) (!= (. vm top) 0)) (!= (. vm open) (as 0 ptr))) (!= (. vm callDepth) 0)) (. vm raised)) (block
      (expr (call printLn (interp "frames " (. vm nframes) " top " (. vm top) " depth " (. vm callDepth))))
      (expr (call panic "vm not unwound"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (let h _ (struct-lit Host (field out (call (. Text new) (& mem))) (field count 0) (field lastErr (call (. Text new) (& mem)))))
    (let vm _ (call newVm (& mem) (& h)))
    (expr (call load (& vm) "c" "bump(); bump(); print(bump(5));"))
    (expr (call check (call (. (. h out) str)) "7\n" "counter"))
    (if (!= (. h count) 7) (block
      (expr (call panic "count"))))
    (expr (call (. (. h out) clear)))
    (expr (call load (& vm) "r" "fn inner(x) { return apply(fn(y) { return y * 2; }, x) + 1; }\nprint(apply(inner, 5));"))
    (expr (call check (call (. (. h out) str)) "11\n" "re-entrant"))
    (expr (call unwound (& vm)))
    (let msg _ (call loadErr (& vm) "u" "fn deep(x) { return x / 0; }\nfn mid(x) { let k = x; let g = fn() { return k; }; return apply(deep, g()); }\napply(mid, 1);"))
    (expr (call check (call (. (. h lastErr) str)) "u:2:64: u:1:23: division by zero" "inner error as the outer native saw it"))
    (expr (call check msg "u:3:6: u:2:64: u:1:23: division by zero" "error through two natives"))
    (expr (call unwound (& vm)))
    (expr (call load (& vm) "after" "print(apply(fn(v) { return v + 1; }, 1));"))
    (expr (call unwound (& vm)))
    (expr (call check (call loadErr (& vm) "s" "let e = spawn(\"bat\", 1, 2);\nspawn(\"bat\", \"x\", 2);") "s:2:6: spawn: argument 2 must be a number, got string" "wrong type"))
    (expr (call check (call loadErr (& vm) "s2" "spawn(\"bat\", 1);") "s2:1:6: spawn: argument 3 must be a number, got nil" "missing argument"))
    (expr (call check (call loadErr (& vm) "s3" "apply(1, 2);") "s3:1:6: apply: argument 1 must be a function, got int" "not a function"))
    (expr (call unwound (& vm)))
    (expr (call check (call loadErr (& vm) "rr" "recurse();") "rr:1:8: stack overflow" "native recursion"))
    (expr (call unwound (& vm)))
    (expr (call (. (. h out) clear)))
    (let exp _ (call load (& vm) "m" "pub let hp = 3;\npub fn hit(this, d) { this.hp -= d; return this.hp; }\npub fn add(a, b) { return a + b; }"))
    (let t _ (call (. exp asTable)))
    (let two (array 2 Value) (array-lit (call (. j2 int) 2) (call (. j2 int) 5)))
    (match (call (. vm call) (call (. t get) "add") (slice-expr two 0 2))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (!= (. v bits) 7) (block
          (expr (call panic "add"))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "call")))))
    (let self _ (call (. vm newTable)))
    (expr (call (. self set) "hp" (call (. j2 int) 10)))
    (match (call (. vm callWithThis) (call (. t get) "hit") (call (. self value)) (slice-expr two 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (|| (!= (. v bits) 8) (!= (call (. self getNum) "hp" (float 0x0000000000000000)) (float 0x4020000000000000))) (block
          (expr (call panic "callWithThis"))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "callWithThis")))))
    (match (call (. vm callWithThis) (call (. t get) "add") (call (. self value)) (slice-expr two 0 2))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (!= (. v bits) 7) (block
          (expr (call panic "callWithThis no this"))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "callWithThis no this")))))
    (let r _ (call (. vm keep) (call (. self value))))
    (expr (call (. vm setNum) r "x" (float 0x3ff8000000000000)))
    (if (|| (|| (!= (call (. vm getNum) r "x") (float 0x3ff8000000000000)) (!= (call (. vm getNum) r "hp") (float 0x4020000000000000))) (!= (call (. vm getNum) r "nope") (float 0x0000000000000000))) (block
      (expr (call panic "getNum"))))
    (let kind _ (call (. vm newTable)))
    (expr (call (. kind set) "r" (call (. j2 int) 14)))
    (expr (call (. kind set) "speed" (call (. j2 int) 60)))
    (expr (call (. kind set) "name" (call (. j2 str) (& vm) "grunt")))
    (let e _ (call (. vm newTable)))
    (expr (call (. e copyFields) kind (array-lit "r" "speed" "missing")))
    (expr (call (. e setDefault) "r" (call (. j2 int) 99)))
    (expr (call (. e setDefault) "touch" (call (. j2 int) 10)))
    (if (|| (|| (!= (call (. e count)) 3) (!= (call (. e getNum) "r" (float 0x0000000000000000)) (float 0x402c000000000000))) (!= (call (. e getNum) "touch" (float 0x0000000000000000)) (float 0x4024000000000000))) (block
      (expr (call panic "copyFields"))))
    (expr (call (. e merge) kind))
    (expr (call check (call (. e getStr) "name" "?") "grunt" "merge"))
    (expr (call check (call (. e getStr) "r" "?") "?" "getStr default"))
    (expr (call (. e set) "speed" (call (. j2 nil))))
    (if (|| (! (call (. (call (. e get) "speed") isNil))) (!= (call (. e count)) 3)) (block
      (expr (call panic "set nil"))))
    (expr (call check (call (. (call (. j2 str) (& vm) "abc") asStr)) "abc" "asStr"))
    (if (! (call (. (call (. (call (. (call (. j2 int) 1) asTable)) get) "x") isNil))) (block
      (expr (call panic "asTable of an int"))))
    (let arr _ (call (. vm newArray) 2))
    (expr (call (. arr push) (call (. j2 int) 1)))
    (expr (call (. arr push) (call (. e value))))
    (if (|| (!= (call (. arr count)) 2) (!= (. (call (. arr get) 0) bits) 1)) (block
      (expr (call panic "array"))))
    (let name _ (call (. vm intern) "weapon"))
    (expr (call check name "weapon" "intern"))
    (expr (call (. vm release) r))
    (expr (call (. vm release) r))
    (if (|| (! (call (. (call (. vm value) r) isNil))) (call (. (call (. vm get) r) isTable))) (block
      (expr (call panic "released ref"))))
    (let r2 _ (call (. vm keep) (call (. arr value))))
    (if (|| (!= (. (call (. vm value) r) tag) (. j2 T_NIL)) (!= (. (call (. vm value) r2) tag) (. j2 T_ARRAY))) (block
      (expr (call panic "reused slot"))))
    (expr (call (. vm release) (call (. j2 none))))
    (expr (call (. (. h out) clear)))
    (let p2 _ (call load (& vm) "rb" "pub fn say(x) { print(x); }"))
    (let one (array 1 Value) (array-lit (call (. j2 int) 1)))
    (expr (call (. vm bind) "print" quiet))
    (match (call (. vm call) (call (. (call (. p2 asTable)) get) "say") (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call check (call (. (. h out) str)) "" "rebound print"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "rebound call")))))
    (expr (call (. vm bind) "print" capture))
    (match (call (. vm call) (call (. (call (. p2 asTable)) get) "say") (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call check (call (. (. h out) str)) "1\n" "rebound back"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "rebound call")))))
    (expr (call unwound (& vm)))
    (expr (call (. vm destroy)))
    (expr (call printLn "j2_host_test ok")))))
--- stderr
--- exit 0
