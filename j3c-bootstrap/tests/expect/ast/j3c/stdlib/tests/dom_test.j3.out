(file (module dom_test)
  (use j3.game (names Font fontAscent fontLine loadFont textWidth))
  (use j3.io (names exists printLn readFile))
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text (names Text find))
  (use j3.ui.css (names Css FL_HOVER P_BACKGROUND P_COLOR P_FONT_SIZE V_PX Value P_PADDING_TOP V_AUTO V_COLOR P_BORDER_TOP_WIDTH P_CURSOR P_FONT_STYLE P_FONT_WEIGHT P_WHITE_SPACE P_WIDTH WS_PRE))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.uastyle)
  (const S_BALLCARD int 1)
  (const S_BALLSHOP int 2)
  (const S_GAME int 3)
  (const S_PRESTIGE int 4)
  (const S_SETTINGS int 5)
  (const S_SIDEBAR int 6)
  (const S_STATS int 7)
  (const S_UPGRADEROW int 8)
  (const S_UPGRADES int 9)
  (const S_TEST int 10)
  (const VH f32 (float 0x4087c00000000000))
  (const HW f32 (float 0x4084000000000000))
  (mod-let CHECKS int _)
  (mod-let FONTS (array 64 Font) _)
  (mod-let FONTPATH string _)
  (mod-let TMP (array 64 int) _)
  (mod-let CARDS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff tol) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b " (+-" tol ")")))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 256 1024) 1024)))
    (let dir _ "j3c/tests/fixtures/idle_ui/ui/")
    (if (! (call exists (interp dir "theme.css"))) (block
      (= dir "tests/fixtures/idle_ui/ui/")))
    (let files (array 9 string) (array-lit "BallCard" "BallShop" "Game" "Prestige" "Settings" "Sidebar" "Stats" "UpgradeRow" "Upgrades"))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) (call load (& mem) (interp dir "theme.css")) (interp dir "theme.css") 0))
    (for i (.. 0 9) (block
      (let name _ (index files i))
      (let src _ (call load (& mem) (interp dir name ".j3ui")))
      (let a _ (call find src "<style>"))
      (let b _ (call find src "</style>"))
      (expr (call parse (& css) (slice-expr src (+ a 7) b) (call (. css own) (interp dir name ".j3ui")) (+ i 1)))))
    (expr (call parse (& css) ".row { display: flex; width: 200px; } .fa { flex: 1; } .fz { flex: 1; min-width: 0; } .fb { width: 50px; } .s150 { width: 150px; } .wide { width: 300px; height: 10px; } .none { display: none; } .pct { width: 50%; height: 20px; } .cbx { box-sizing: content-box; width: 100px; padding: 10px; border: 2px solid #fff; height: 30px; } .ctr { text-align: center; } .mg { margin: 5px 7px; height: 10px; } .rel { position: relative; width: 100px; height: 80px; } .abr { position: absolute; right: 10px; bottom: 5px; width: 20px; height: 8px; } .abs2 { position: absolute; top: 3px; left: 4px; }" "test.css" S_TEST))
    (expr (call parse (& css) BOUND_CSS "bound.css" S_TEST))
    (expr (call ok (== (. (. css warns) len) 0) "styles parse with zero warnings"))
    (= FONTPATH (. (index (. (. css fonts) items) 0) path))
    (expr (call printLn (interp "font " FONTPATH)))
    (let longText _ "Start over at level 1 with no balls. Each crystal adds 10% to all gold, forever, and then some more words to make sure it wraps at least twice on a box.")
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call ok (== (. d fontMissing) 0) "no font missing"))
    (expr (call game (& d) 0 6 (bool true) longText "1234 gold"))
    (expr (call (. d layoutAt) (float 0x4094000000000000) (float 0x4087c00000000000)))
    (expr (call ok (== (. d fontMissing) 0) "fonts loaded"))
    (let app _ (call kid (& d) 0 0))
    (let field _ (call kid (& d) app 0))
    (let half _ (call kid (& d) app 1))
    (expr (call near (call nw (& d) app) (float 0x4094000000000000) (float 0x3f847ae147ae147b) "app width"))
    (expr (call near (call nh (& d) app) (float 0x4087c00000000000) (float 0x3f847ae147ae147b) "app height is 100% of the root"))
    (expr (call near (call nw (& d) field) (float 0x4084000000000000) (float 0x3f847ae147ae147b) "canvas half width"))
    (expr (call near (call nw (& d) half) (float 0x4084000000000000) (float 0x3f847ae147ae147b) "sidebar half width"))
    (expr (call near (call nx (& d) half) (float 0x4084000000000000) (float 0x3f847ae147ae147b) "sidebar half x"))
    (expr (call near (call nh (& d) field) (float 0x4087c00000000000) (float 0x3f847ae147ae147b) "canvas stretched to the app height"))
    (expr (call near (call nh (& d) half) (float 0x4087c00000000000) (float 0x3f847ae147ae147b) "half height"))
    (let hud _ (call kid (& d) field 0))
    (let paused _ (call kid (& d) field 1))
    (expr (call near (call nx (& d) hud) (float 0x4028000000000000) (float 0x3f847ae147ae147b) "hud left"))
    (let hudW _ (+ (+ (+ (float 0x4038000000000000) (call tw 13 (bool true) "Level 3")) (float 0x4028000000000000)) (call tw 13 (bool false) "42 bricks")))
    (expr (call near (call nw (& d) hud) hudW (float 0x3ff0000000000000) "hud shrink-to-fit width (padding 12 + two spans + gap 12)"))
    (expr (call near (call nh (& d) hud) (+ (call fl 13) (float 0x4028000000000000)) (float 0x3ff0000000000000) "hud height (line + padding 6 6)"))
    (expr (call near (call ny (& d) hud) (- (- VH (float 0x4028000000000000)) (call nh (& d) hud)) (float 0x3f847ae147ae147b) "hud bottom 12"))
    (expr (call near (call nx (& d) paused) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "overlay x"))
    (expr (call near (call ny (& d) paused) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "overlay y"))
    (expr (call near (call nw (& d) paused) (float 0x4084000000000000) (float 0x3f847ae147ae147b) "overlay covers the canvas width"))
    (expr (call near (call nh (& d) paused) (float 0x4087c00000000000) (float 0x3f847ae147ae147b) "overlay covers the canvas height"))
    (let h1 _ (call kid (& d) paused 0))
    (let resume _ (call kid (& d) paused 1))
    (let colH _ (+ (+ (+ (call fl 22) (float 0x4028000000000000)) (call fl 15)) (float 0x4030000000000000)))
    (expr (call near (call ny (& d) h1) (/ (- VH colH) (float 0x4000000000000000)) (float 0x3ff0000000000000) "overlay column centered vertically"))
    (expr (call near (call ny (& d) resume) (+ (+ (/ (- VH colH) (float 0x4000000000000000)) (call fl 22)) (float 0x4028000000000000)) (float 0x3ff0000000000000) "gap 12 between h1 and button"))
    (expr (call near (call nw (& d) h1) (call tw 22 (bool true) "Paused") (float 0x3ff0000000000000) "h1 shrink-to-fit in a centered column"))
    (expr (call near (call nx (& d) h1) (/ (- HW (call tw 22 (bool true) "Paused")) (float 0x4000000000000000)) (float 0x3ff0000000000000) "h1 centered horizontally"))
    (expr (call near (call nw (& d) resume) (+ (float 0x403c000000000000) (call tw 15 (bool false) "Resume")) (float 0x3ff0000000000000) "button width = text + padding 14 14"))
    (expr (call near (call nh (& d) resume) (+ (call fl 15) (float 0x4030000000000000)) (float 0x3f847ae147ae147b) "button height = line + padding 8 8"))
    (let side _ (call kid (& d) half 0))
    (expr (call near (call nw (& d) side) (float 0x4084000000000000) (float 0x3f847ae147ae147b) "side width"))
    (expr (call near (call nh (& d) side) (float 0x4087c00000000000) (float 0x3f847ae147ae147b) "side is 100% of a stretched flex item"))
    (let header _ (call kid (& d) side 0))
    (let nav _ (call kid (& d) side 1))
    (let mainEl _ (call kid (& d) side 2))
    (expr (call near (call nx (& d) header) (float 0x3ff0000000000000) (float 0x3f847ae147ae147b) "side border-left 1px shifts the children"))
    (expr (call near (call nh (& d) header) (+ (float 0x4040000000000000) (call fl 24)) (float 0x3ff0000000000000) "header = padding 16+16 + the 24px line (baseline row)"))
    (let wallet _ (call kid (& d) header 0))
    (let small _ (call kid (& d) header 1))
    (expr (call near (call ny (& d) wallet) (float 0x4030000000000000) (float 0x3f847ae147ae147b) "wallet top is the header padding"))
    (expr (call near (call ny (& d) small) (+ (float 0x4030000000000000) (call baselineGap 24 12)) (float 0x3ff8000000000000) "small aligned to the wallet baseline"))
    (expr (call near (call nw (& d) header) (float 0x4083f80000000000) (float 0x3f847ae147ae147b) "header stretches to the side content width"))
    (let gold _ (call kid (& d) wallet 0))
    (let crystal _ (call kid (& d) wallet 1))
    (expr (call near (call nx (& d) crystal) (+ (+ (call nx (& d) gold) (call nw (& d) gold)) (float 0x4030000000000000)) (float 0x3f847ae147ae147b) "wallet gap 16"))
    (expr (call near (call nw (& d) gold) (call tw 24 (bool true) "1234 gold") (float 0x3ff0000000000000) "gold span is its text (flex item shrink-to-fit)"))
    (expr (call near (call ny (& d) nav) (call nh (& d) header) (float 0x3f847ae147ae147b) "nav under the header"))
    (expr (call near (call nw (& d) nav) (float 0x4083f80000000000) (float 0x3f847ae147ae147b) "nav width"))
    (let navBtn _ (+ (call fl 15) (float 0x4032000000000000)))
    (expr (call near (call nh (& d) nav) (+ navBtn (float 0x3ff0000000000000)) (float 0x3ff0000000000000) "nav = tallest button (active has border-bottom 2) + border-bottom 1"))
    (for k (.. 0 5) (block
      (let btn _ (call kid (& d) nav k))
      (expr (call near (call nw (& d) btn) (float 0x405d8ccccccccccd) (float 0x3f947ae147ae147b) "nav button width (5 equal flex:1 columns)"))
      (expr (call near (call nx (& d) btn) (+ (float 0x4030000000000000) (* (call f32 k) (float 0x405e8ccccccccccd))) (float 0x3fa999999999999a) "nav button x"))
      (expr (call near (call nh (& d) btn) navBtn (float 0x3ff0000000000000) "nav buttons stretch to the active one"))
      (let bf _ (index (. (. d frags) items) (. (index (. (. d nodes) items) btn) frag0)))
      (expr (call near (. bf x) (/ (- (float 0x405d8ccccccccccd) (. bf w)) (float 0x4000000000000000)) (float 0x3fe3333333333333) "button text centered horizontally"))))
    (expr (call near (call ny (& d) mainEl) (+ (call nh (& d) header) (call nh (& d) nav)) (float 0x3f847ae147ae147b) "main y"))
    (expr (call near (call nh (& d) mainEl) (- (- (float 0x4087c00000000000) (call nh (& d) header)) (call nh (& d) nav)) (float 0x3f847ae147ae147b) "main fills the remaining height (flex:1, min-height 0)"))
    (expr (call near (call nw (& d) mainEl) (float 0x4083f80000000000) (float 0x3f847ae147ae147b) "main width"))
    (let h2 _ (call kid (& d) mainEl 0))
    (let grid _ (call kid (& d) mainEl 1))
    (expr (call near (call ny (& d) h2) (float 0x4030000000000000) (float 0x3f847ae147ae147b) "h2 at the main padding"))
    (expr (call near (call nx (& d) h2) (float 0x4034000000000000) (float 0x3f847ae147ae147b) "h2 x = padding 20"))
    (expr (call near (call nh (& d) h2) (call fl 17) (float 0x3ff0000000000000) "h2 line"))
    (expr (call near (call ny (& d) grid) (+ (+ (float 0x4030000000000000) (call fl 17)) (float 0x4028000000000000)) (float 0x3ff0000000000000) "grid margin-top 12"))
    (expr (call near (call nw (& d) grid) (float 0x4082b80000000000) (float 0x3f847ae147ae147b) "grid width = 639 - 40"))
    (let c0 _ (call kid (& d) grid 0))
    (let c1 _ (call kid (& d) grid 1))
    (let c2 _ (call kid (& d) grid 2))
    (expr (call near (call nw (& d) c0) (float 0x4072780000000000) (float 0x3f947ae147ae147b) "two equal columns: (599 - 8) / 2"))
    (expr (call near (call nw (& d) c1) (float 0x4072780000000000) (float 0x3f947ae147ae147b) "second column"))
    (expr (call near (- (- (call nx (& d) c1) (call nx (& d) c0)) (call nw (& d) c0)) (float 0x4020000000000000) (float 0x3f947ae147ae147b) "column gap 8"))
    (expr (call near (- (- (call ny (& d) c2) (call ny (& d) c0)) (call nh (& d) c0)) (float 0x4020000000000000) (float 0x3f947ae147ae147b) "row gap 8 (gap shorthand)"))
    (let cardH _ (+ (+ (+ (float 0x4050000000000000) (* (float 0x4000000000000000) (call fl 15))) (call fl 12)) (call fl 13)))
    (expr (call near (call nh (& d) c0) cardH (float 0x3ff8000000000000) "card = border 1+1, padding 12+12, rows + gaps 6, button margin-top 4"))
    (expr (call near (call nh (& d) c1) (call nh (& d) c0) (float 0x3f847ae147ae147b) "cards in a row are equally tall"))
    (let top _ (call kid (& d) c0 0))
    (let nameSp _ (call kid (& d) top 0))
    (let ownedSp _ (call kid (& d) top 1))
    (expr (call near (call nx (& d) nameSp) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "space-between: first at the start"))
    (expr (call near (+ (call nx (& d) ownedSp) (call nw (& d) ownedSp)) (call nw (& d) top) (float 0x3f847ae147ae147b) "space-between: last at the end"))
    (let buy _ (call kid (& d) c0 3))
    (expr (call near (call nw (& d) buy) (float 0x4070d80000000000) (float 0x3f947ae147ae147b) "button stretches in a column card"))
    (expr (call near (call nh (& d) buy) (+ (call fl 15) (float 0x4030000000000000)) (float 0x3f847ae147ae147b) "button height"))
    (expr (call ok (== (call lineCount (& d) buy) 1) "button text is one line"))
    (expr (call game (& d) 1 30 (bool false) longText "1234 gold"))
    (expr (call (. d layoutAt) (float 0x4094000000000000) (float 0x4087c00000000000)))
    (let app2 _ (call kid (& d) 0 0))
    (let side2 _ (call kid (& d) (call kid (& d) app2 1) 0))
    (let main2 _ (call kid (& d) side2 2))
    (let hdr2 _ (call kid (& d) side2 0))
    (let nav2 _ (call kid (& d) side2 1))
    (let ab1 _ (call (. (. d css) get) (. (index (. (. d nodes) items) (call kid (& d) nav2 1)) style) (+ P_BORDER_TOP_WIDTH 2)))
    (let ab0 _ (call (. (. d css) get) (. (index (. (. d nodes) items) (call kid (& d) nav2 0)) style) (+ P_BORDER_TOP_WIDTH 2)))
    (expr (call ok (&& (== (. ab1 f) (float 0x4000000000000000)) (== (. ab0 f) (float 0x0000000000000000))) "class:active moves with the tab (restyled on the class change)"))
    (expr (call ok (== (. (index (. (. d nodes) items) (call kid (& d) (call kid (& d) (call kid (& d) app2 0) 0) 0)) kind) 0) "the paused overlay is gone (field has only the hud)"))
    (expr (call ok (< (call kid (& d) (call kid (& d) app2 0) 1) 0) "no overlay child after paused = false"))
    (let mainH _ (- (- (float 0x4087c00000000000) (call nh (& d) hdr2)) (call nh (& d) nav2)))
    (expr (call near (call nh (& d) main2) mainH (float 0x3f847ae147ae147b) "main keeps its height with 30 rows"))
    (let sec _ (call kid (& d) main2 0))
    (let rowH _ (+ (call fl 15) (float 0x4040000000000000)))
    (let secH _ (+ (+ (call fl 17) (* (float 0x403e000000000000) rowH)) (float 0x4066800000000000)))
    (expr (call near (call nh (& d) sec) secH (float 0x4000000000000000) "section = h2 + 30 rows + 30 gaps of 6 (flex column)"))
    (let contentH _ (+ (+ (+ (float 0x4030000000000000) (call nh (& d) sec)) (float 0x4032000000000000)) (float 0x4030000000000000)))
    (expr (call near (. (index (. (. d nodes) items) main2) contentH) contentH (float 0x3f847ae147ae147b) "scroll height = padding + section + margin-bottom 18 + padding"))
    (expr (call near (. (index (. (. d nodes) items) main2) scrollMax) (- contentH mainH) (float 0x3f847ae147ae147b) "scroll range"))
    (expr (call ok (> (. (index (. (. d nodes) items) main2) scrollMax) (float 0x408f400000000000)) "30 rows overflow into a real scroll range"))
    (expr (call (. d scrollBy) main2 (float 0x40f86a0000000000)))
    (expr (call near (. (index (. (. d nodes) items) main2) scrollY) (. (index (. (. d nodes) items) main2) scrollMax) (float 0x3f847ae147ae147b) "scroll clamps at the end"))
    (expr (call near (call (. d absY) sec) (- (+ (+ (call nh (& d) hdr2) (call nh (& d) nav2)) (float 0x4030000000000000)) (. (index (. (. d nodes) items) main2) scrollMax)) (float 0x3f847ae147ae147b) "absY includes the scroll offset"))
    (expr (call (. d scrollBy) main2 (- (float 0x40f86a0000000000))))
    (let row _ (call kid (& d) sec 1))
    (expr (call near (call nw (& d) row) (float 0x4082b80000000000) (float 0x3f847ae147ae147b) "row stretches in the column"))
    (expr (call near (call nh (& d) row) rowH (float 0x3ff0000000000000) "row = button height + padding 8 8, items centered"))
    (let label _ (call kid (& d) row 0))
    (let value _ (call kid (& d) row 1))
    (let rbtn _ (call kid (& d) row 2))
    (expr (call near (call nw (& d) rbtn) (float 0x4056800000000000) (float 0x3f847ae147ae147b) "button min-width 90"))
    (expr (call near (call nw (& d) value) (float 0x4048000000000000) (float 0x3f847ae147ae147b) "value min-width 48"))
    (expr (call near (call nw (& d) label) (float 0x4079d00000000000) (float 0x3f947ae147ae147b) "label flex:1 = row - padding 24 - gaps 24 - value - button"))
    (expr (call near (call ny (& d) label) (/ (- (call nh (& d) row) (call nh (& d) label)) (float 0x4000000000000000)) (float 0x3fe3333333333333) "align-items: center"))
    (let vf _ (index (. (. d frags) items) (. (index (. (. d nodes) items) value) frag0)))
    (expr (call near (. vf x) (- (float 0x4048000000000000) (call tw 15 (bool false) "12")) (float 0x3ff0000000000000) "value text is right aligned"))
    (expr (call game (& d) 3 0 (bool false) longText "1234 gold"))
    (expr (call (. d layoutAt) (float 0x4094000000000000) (float 0x4087c00000000000)))
    (let side3 _ (call kid (& d) (call kid (& d) (call kid (& d) 0 0) 1) 0))
    (let main3 _ (call kid (& d) side3 2))
    (let dl _ (call kid (& d) main3 0))
    (expr (call near (call nw (& d) dl) (float 0x4082b80000000000) (float 0x3f847ae147ae147b) "dl width"))
    (let ddW _ (call tw 15 (bool true) "98765"))
    (expr (call near (call nx (& d) (call kid (& d) dl 0)) (float 0x4030000000000000) (float 0x3f847ae147ae147b) "dt at the left padding"))
    (expr (call near (call nw (& d) (call kid (& d) dl 1)) ddW (float 0x3ff0000000000000) "auto column = widest dd"))
    (expr (call near (+ (call nx (& d) (call kid (& d) dl 1)) (call nw (& d) (call kid (& d) dl 1))) (float 0x4082380000000000) (float 0x3f847ae147ae147b) "dd column ends at the right padding"))
    (expr (call near (call nw (& d) (call kid (& d) dl 0)) (- (float 0x4081b80000000000) ddW) (float 0x3ff0000000000000) "1fr column = the rest"))
    (expr (call near (- (call ny (& d) (call kid (& d) dl 2)) (call ny (& d) (call kid (& d) dl 0))) (+ (call fl 15) (float 0x4024000000000000)) (float 0x3ff0000000000000) "row-gap 10 between rows"))
    (expr (call near (call nh (& d) dl) (+ (+ (float 0x4040000000000000) (* (float 0x4022000000000000) (call fl 15))) (float 0x4054000000000000)) (float 0x3ff8000000000000) "dl height = 9 rows + 8 gaps + padding"))
    (let ddNode _ (call kid (& d) dl 1))
