(file (module glyph_test)
  (use j3.game (names fontHas tryLoadFont))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.a11y)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.padin)
  (use j3.ui.uastyle)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, p, button, glyph { font-family: \"T\"; font-size: 16px; } @font-face { font-family: \"O\"; src: url(\"/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf\"); } .os { font-family: \"O\"; } * { margin: 0; }")
  (mod-let CHECKS int _)
  (mod-let ID (array 9 int) _)
  (mod-let ACT string _)
  (mod-let SHOW bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn glyph (params (d (ref Dom)) (k int) (action string) (key string) (pad string)) _ (block
    (let g _ (call (. d open) k (call (. d tag) "glyph") 1))
    (expr (call (. d glyph) g action key pad))
    (= (index ID k) g)
    (expr (call (. d close)))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "p") 1))
    (expr (call (. d text) "Press "))
    (expr (call glyph d 0 "confirm" "" ""))
    (expr (call (. d text) " or "))
    (expr (call glyph d 1 "back" "" ""))
    (expr (call (. d close)))
    (expr (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call glyph d 2 "" "Space" "x"))
    (expr (call glyph d 3 "jump" "" ""))
    (expr (call glyph d 4 ACT "" ""))
    (expr (call glyph d 5 "" "" "rt"))
    (expr (call glyph d 6 "page-down" "" ""))
    (expr (call (. d close)))
    (let o _ (call (. d open) 3 (call (. d tag) "glyph") 1))
    (expr (call (. d cls) o "os"))
    (expr (call (. d glyph) o "" "" "a"))
    (= (index ID 8) o)
    (expr (call (. d close)))
    (let b _ (call (. d open) 2 (call (. d tag) "button") 1))
    (= (index ID 7) b)
    (expr (call (. d text) "Plain"))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn label (params (d (ref Dom)) (k int)) string (block
    (let f _ (. (index (. (. d nodes) items) (index ID k)) first))
    (return (if-expr (>= f 0) (call (. d textOf) f) ""))))
  (fn dev (params (d (ref Dom)) (k int)) string (block
    (return (call (. (. d css) name) (. (index (. (. d mnodes) items) (index ID k)) type)))))
  (fn press (params (d (ref Dom)) (names string)) _ (block
    (expr (call (. d setPad) (call (. padin parse) names)))
    (expr (call frame d))
    (expr (call (. d setPad) (call (. padin parse) "")))
    (expr (call frame d))))
  (fn mouse (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (float 0x4059000000000000) (float 0x4072c00000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) (float 0x4072c00000000000) (float 0x407f400000000000) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call (. uastyle load) (& css)))
    (expr (call parse (& css) SHEET "glyph.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. a11y enable) (& d)))
    (= ACT "next")
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 0) "Enter") (call same (call dev (& d) 0) "key")) "confirm shows Enter with the keyboard"))
    (expr (call ok (call same (call label (& d) 1) "Esc") "back shows Esc"))
    (expr (call ok (call same (call label (& d) 2) "Space") "an explicit key shows as written"))
    (expr (call ok (call same (call label (& d) 3) "jump") "an action nobody knows shows its name"))
    (expr (call ok (call same (call label (& d) 4) "Tab") "a dynamic action"))
    (expr (call ok (&& (call same (call label (& d) 5) "RT") (call same (call dev (& d) 5) "pad")) "pad= alone has no key: it shows the pad label even on the keyboard"))
    (expr (call ok (call same (call label (& d) 6) "PgDn") "page-down is PgDn"))
    (expr (call ok (&& (> (. (index (. (. d nodes) items) (index ID 0)) w) (float 0x4034000000000000)) (> (. (index (. (. d nodes) items) (index ID 0)) h) (float 0x4024000000000000))) "a glyph is a laid-out box"))
    (let wKey _ (. (index (. (. d nodes) items) (index ID 0)) w))
    (expr (call ok (call same (call (. a11y role) (& d) (index ID 0)) "img") "role img"))
    (expr (call ok (call same (call (. a11y name) (& d) (& mem) (index ID 0)) "Enter") "name is the key label"))
    (expr (call ok (call same (call (. d ariaOf) (index ID 0)) "Enter") "aria-label is the key label"))
    (expr (call press (& d) "LB"))
    (expr (call ok (&& (call same (call label (& d) 0) "A") (call same (call dev (& d) 0) "pad")) "confirm shows A once the pad is used"))
    (expr (call ok (call same (call label (& d) 1) "B") "back shows B"))
    (expr (call ok (call same (call label (& d) 2) "X") "an explicit pad button wins on the pad"))
    (expr (call ok (call same (call label (& d) 3) "jump") "an unknown action with nothing bound still shows its name"))
    (expr (call ok (&& (&& (call same (call label (& d) 4) "RB") (call same (call label (& d) 5) "RT")) (call same (call label (& d) 6) "RT")) "shoulders and triggers"))
    (expr (call ok (< (. (index (. (. d nodes) items) (index ID 0)) w) wKey) "the pad box is narrower than the Enter keycap"))
    (expr (call ok (&& (call same (call (. a11y name) (& d) (& mem) (index ID 0)) "A button") (call same (call (. d ariaOf) (index ID 1)) "B button")) "the pad name is 'A button'"))
    (expr (call mouse (& d)))
    (expr (call ok (&& (&& (call same (call label (& d) 0) "Enter") (call same (call dev (& d) 0) "key")) (== (. (index (. (. d nodes) items) (index ID 0)) w) wKey)) "a mouse move brings the keyboard prompts back"))
    (expr (call ok (call same (call label (& d) 2) "Space") "explicit key again"))
    (expr (call press (& d) "B"))
    (expr (call ok (call same (call label (& d) 0) "A") "and the pad again"))
    (expr (call (. d setGlyphStyle) "playstation"))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (&& (&& (call same (call label (& d) 0) "\xe2\x9c\x95") (call same (call label (& d) 1) "\xe2\x97\x8b")) (call same (call label (& d) 2) "\xe2\x96\xa1")) (call same (call label (& d) 4) "R1")) (call same (call label (& d) 6) "R2")) "playstation labels"))
    (let os _ (call tryLoadFont "/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf" 12))
    (if (&& (!= (. os raw) 0) (! (call fontHas os 10005))) (block
      (expr (call ok (call same (call label (& d) 8) "Cross") "a font without the symbols falls back to a name"))) (block
      (expr (call printLn "glyph_test: no font without the PlayStation symbols here, fallback left to golden 69 psplain"))))
    (expr (call (. d setGlyphStyle) "nintendo"))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (&& (&& (call same (call label (& d) 0) "B") (call same (call label (& d) 1) "A")) (call same (call label (& d) 2) "Y")) (call same (call label (& d) 4) "R")) (call same (call label (& d) 6) "ZR")) "nintendo swaps A and B"))
    (expr (call (. d setGlyphStyle) "generic"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 0) "South") (call same (call label (& d) 4) "R1")) "generic labels"))
    (let w0 _ (. (. css warns) len))
    (expr (call (. d setGlyphStyle) "sega"))
    (expr (call ok (== (. (. css warns) len) (+ w0 1)) "an unknown style warns"))
    (expr (call frame (& d)))
    (expr (call ok (call same (call label (& d) 0) "A") "and falls back to xbox"))
    (expr (call mouse (& d)))
    (expr (call (. d setGlyphStyle) "playstation"))
    (expr (call frame (& d)))
    (expr (call ok (call same (call label (& d) 0) "Enter") "a pad style does not change key labels"))
    (expr (call (. d setGlyphStyle) "xbox"))
    (expr (call (. d setGlyphBinding) "confirm" "Return" "x"))
    (expr (call (. d setGlyphBinding) "jump" "Space" "y"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 0) "Return") (call same (call label (& d) 3) "Space")) "bindings replace the keyboard table"))
    (expr (call press (& d) "A"))
    (expr (call ok (&& (&& (call same (call label (& d) 0) "X") (call same (call label (& d) 3) "Y")) (call same (call label (& d) 1) "B")) "bindings replace the pad table; other actions keep theirs"))
    (expr (call (. d setGlyphBinding) "confirm" "Enter" ""))
    (expr (call frame (& d)))
    (expr (call ok (call same (call label (& d) 0) "A") "an empty button keeps the built-in for that device"))
    (expr (call mouse (& d)))
    (expr (call ok (call same (call label (& d) 0) "Enter") "rebound again"))
    (expr (call (. d setGlyphBinding) "confirm" "" ""))
    (expr (call press (& d) "A"))
    (expr (call ok (call same (call dev (& d) 0) "pad") "pad in use"))
    (expr (call (. d simKeys) "" "Tab"))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call dev (& d) 0) "key") (call same (call label (& d) 0) "Enter")) "a key press switches to the keyboard glyphs"))
    (expr (call press (& d) "A"))
    (expr (call ok (call same (call dev (& d) 0) "pad") "and a pad button back"))
    (expr (call (. d setGlyphBinding) "jump" "Space" "start"))
    (expr (call (. d setGlyphBinding) "page-down" "PgDn" "select"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 3) "Menu") (call same (call label (& d) 6) "View")) "start and select on xbox"))
    (expr (call (. d setGlyphStyle) "playstation"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 3) "Options") (call same (call label (& d) 6) "Share")) "start and select on playstation"))
    (expr (call (. d setGlyphStyle) "nintendo"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call same (call label (& d) 3) "+") (call same (call label (& d) 6) "-")) "start and select on nintendo"))
    (expr (call (. d setGlyphStyle) "xbox"))
    (expr (call (. d setGlyphBinding) "jump" "Space" "ls"))
    (expr (call frame (& d)))
    (expr (call ok (call same (call label (& d) 3) "LS") "left stick press"))
    (expr (call (. d setGlyphBinding) "jump" "" ""))
    (expr (call (. d setGlyphBinding) "page-down" "" ""))
    (expr (call mouse (& d)))
    (let used0 _ 0)
    (for i (.. 0 10100) (block
      (if (== i 100) (block
        (= used0 (. mem used))))
      (if (== (% i 2) 0) (block
        (expr (call (. d setPad) (call (. padin parse) "LB")))) (block
        (expr (call (. d simKeys) "" "Tab"))))
      (expr (call frame (& d)))
      (expr (call (. d setGlyphBinding) "confirm" "Enter" "a"))))
    (expr (call (. d setPad) (call (. padin parse) "")))
    (expr (call ok (== (. mem used) used0) "10000 device switches allocate nothing"))
    (expr (call mouse (& d)))
    (= ACT "scroll")
    (expr (call frame (& d)))
    (expr (call ok (call same (call label (& d) 4) "Wheel") "the action expression is re-read"))
    (expr (call frame (& d)))
    (let r0 _ (. d restyled))
    (let l0 _ (. d laid))
    (for i (.. 0 5) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d laid) l0)) "idle frames neither restyle nor lay out"))
    (expr (call (. d setPad) (call (. padin parse) "A")))
    (expr (call frame (& d)))
    (expr (call (. d setPad) (call (. padin parse) "")))
    (let r1 _ (. d restyled))
    (expr (call ok (call same (call label (& d) 0) "A") "switched"))
    (expr (call ok (&& (&& (>= (- r1 r0) 1) (<= (- r1 r0) 14)) (<= (- (. d laid) l0) 9)) "a switch restyles and lays out only the glyph boxes, their text and the two lines holding them"))
    (expr (call frame (& d)))
    (let r2 _ (. d restyled))
    (let l2 _ (. d laid))
    (for i (.. 0 5) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (. d restyled) r2) (== (. d laid) l2)) "steady again after the switch"))
    (expr (call ok (> (. (index (. (. d nodes) items) (index ID 7)) w) (float 0x0000000000000000)) "the plain button is untouched"))
    (expr (call printLn (interp "glyph_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
