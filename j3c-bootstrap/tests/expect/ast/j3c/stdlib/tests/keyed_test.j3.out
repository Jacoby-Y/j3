(file (module keyed_test)
  (use j3.game.micros)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.rand.Rng)
  (use j3.sys.panic)
  (use j3.text.Text)
  (use j3.ui.keyed (names Keyed encode decode))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "keyed_test"))))))
  (fn (doc "Feed key ids (key text is `k<id>`) and finish.") frame (params (k (ref Keyed)) (names (slice string)) (ids (gen List int))) _ (block
    (expr (call (. k begin)))
    (for i (.. 0 (. ids len)) (block
      (expr (call (. k add) (index names (index (. ids items) i))))))
    (expr (call (. k finish) "t"))))
  (fn list (params (mem (ref Arena)) (xs (slice int))) (gen List int) (block
    (let l _ (call (. (type-path List int) new) mem))
    (for i (.. 0 (. xs len)) (block
      (expr (call (. l push) (index xs i)))))
    (return l)))
  (fn seq (params (mem (ref Arena)) (n int)) (gen List int) (block
    (let l _ (call (. (type-path List int) new) mem))
    (for i (.. 0 n) (block
      (expr (call (. l push) i))))
    (return l)))
  (fn (doc "Unique ids: `from[i]` is where id `now[i]` sat in `prev` (-1 if absent); `dead` the ids no longer present.") checkUnique (params (k (ref Keyed)) (prev (gen List int)) (now (gen List int)) (what string)) _ (block
    (expr (call ok (== (. (. k from) len) (. now len)) (interp what ": from length")))
    (let pos _ (call (. (type-path List int) new) (. k mem)))
    (for i (.. 0 (. prev len)) (block
      (while (<= (. pos len) (index (. prev items) i)) (block
        (expr (call (. pos push) (- 1)))))
      (= (index (. pos items) (index (. prev items) i)) i)))
    (let claimed _ 0)
    (for i (.. 0 (. now len)) (block
      (let want _ (if-expr (< (index (. now items) i) (. pos len)) (index (. pos items) (index (. now items) i)) (- 1)))
      (expr (call ok (== (index (. (. k from) items) i) want) (interp what ": from[" i "] is " (index (. (. k from) items) i) ", want " want)))
      (if (>= want 0) (block
        (+= claimed 1)))))
    (expr (call ok (== (. (. k dead) len) (- (. prev len) claimed)) (interp what ": dead count")))))
  (fn (doc "`addInt` keys: ids map to big, negative and clustered ints; same results as text keys.") intFrame (params (k (ref Keyed)) (vals (slice int)) (ids (gen List int))) _ (block
    (expr (call (. k begin)))
    (for i (.. 0 (. ids len)) (block
      (expr (call (. k addInt) (index vals (index (. ids items) i))))))
    (expr (call (. k finish) "t"))))
  (fn intKeys (params (mem (ref Arena)) (ids (gen List int)) (sh (gen List int)) (N int)) _ (block
    (let vals _ (call (. mem alloc) (targs int) (+ N 10)))
    (for i (.. 0 (+ N 10)) (block
      (= (index vals i) i)
      (if (== (% i 3) 0) (block
        (= (index vals i) (+ (* i 4294967296) 7))))
      (if (== (% i 3) 1) (block
        (= (index vals i) (- 0 (* i 1000003)))))))
    (= (index vals 0) (- 0 9223372036854775807))
    (= (index vals 1) 9223372036854775807)
    (let buf _ (call (. mem alloc) (targs u8) 9))
    (let rt _ (array-lit 0 1 255 256 65535 65536 (- 0 1) (- 0 256) (- 0 257) 9223372036854775807 (- 0 9223372036854775807) (- (- 0 9223372036854775807) 1) (+ 4294967296 7)))
    (for q (.. 0 (. rt len)) (block
      (let n _ (call encode buf 0 (index rt q)))
      (expr (call ok (&& (>= n 2) (<= n 9)) "encode length"))
      (expr (call ok (== (call decode (slice-expr buf 0 n)) (index rt q)) (interp "int round trip " (index rt q))))))
    (expr (call ok (== (call encode buf 0 17) 2) "small ints are two bytes"))
    (let k _ (call (. Keyed new) mem))
    (let a _ (call seq mem 50))
    (expr (call intFrame (& k) vals a))
    (expr (call ok (. k changed) "int: first frame changed"))
    (expr (call intFrame (& k) vals a))
    (expr (call ok (! (. k changed)) "int: steady"))
    (let used _ (call (. mem checkpoint)))
    (for f (.. 0 200) (block
      (expr (call intFrame (& k) vals a))
      (expr (call ok (! (. k changed)) "int: steady frame"))))
    (expr (call ok (== (call (. mem checkpoint)) used) "int: steady frames allocate nothing"))
    (let rev _ (call (. (type-path List int) new) mem))
    (for i (.. 0 50) (block
      (expr (call (. rev push) (- 49 i)))))
    (expr (call intFrame (& k) vals rev))
    (expr (call checkUnique (& k) a rev "int reverse"))
    (let b _ (call list mem (array-lit 5 1 2 3 4)))
    (expr (call intFrame (& k) vals b))
    (let c _ (call list mem (array-lit 5 9 1 3 4 8)))
    (expr (call intFrame (& k) vals c))
    (expr (call checkUnique (& k) b c "int insert/remove"))
    (expr (call ok (&& (== (. (. k dead) len) 1) (== (index (. (. k dead) items) 0) 2)) "int: removed row 2 is dead"))
    (let e _ (call (. (type-path List int) new) mem))
    (expr (call intFrame (& k) vals e))
    (expr (call ok (&& (&& (. k changed) (== (. (. k from) len) 0)) (== (. (. k dead) len) 6)) "int: to empty"))
    (let k1 _ (call (. Keyed new) mem))
    (expr (call (. k1 begin)))
    (expr (call (. k1 addInt) 1))
    (expr (call (. k1 addInt) 256))
    (expr (call (. k1 addInt) 65536))
    (expr (call (. k1 finish) "t"))
    (expr (call (. k1 begin)))
    (expr (call (. k1 addInt) 65536))
    (expr (call (. k1 addInt) 1))
    (expr (call (. k1 addInt) 256))
    (expr (call (. k1 finish) "t"))
    (expr (call ok (&& (&& (== (index (. (. k1 from) items) 0) 2) (== (index (. (. k1 from) items) 1) 0)) (== (index (. (. k1 from) items) 2) 1)) "int: keys 1, 256, 65536 stay apart"))
    (let k2 _ (call (. Keyed new) mem))
    (expr (call intFrame (& k2) vals (call list mem (array-lit 1 2 1 3 1))))
    (expr (call intFrame (& k2) vals (call list mem (array-lit 3 1 1 2 1 1))))
    (let w _ (array-lit 3 0 2 1 4 (- 1)))
    (for i (.. 0 6) (block
      (expr (call ok (== (index (. (. k2 from) items) i) (index w i)) (interp "int dup from[" i "] is " (index (. (. k2 from) items) i))))))
    (expr (call ok (== (. (. k2 dead) len) 0) "int dup none dead"))
    (let kk _ (call (. Keyed new) mem))
    (expr (call intFrame (& kk) vals ids))
    (let t0 _ (call micros))
    (expr (call (. kk begin)))
    (for q (.. 0 (. sh len)) (block
      (expr (call (. kk addInt) (index vals (index (. sh items) q))))))
    (expr (call (. kk finish) "t"))
    (let us _ (- (call micros) t0))
    (expr (call printLn (interp "10k shuffled int finish: " us " us")))
    (expr (call checkUnique (& kk) ids sh "int shuffle"))
    (expr (call ok (== (. (. kk dead) len) 0) "int shuffle none dead"))
    (expr (call ok (< us 200000) "int 10k shuffle under 200 ms"))
    (let kr _ (call (. Keyed new) mem))
    (expr (call intFrame (& kr) (. ids items) ids))
    (let t1 _ (call micros))
    (expr (call (. kr begin)))
    (for q (.. 0 (. sh len)) (block
      (expr (call (. kr addInt) (index (. sh items) q)))))
    (expr (call (. kr finish) "t"))
    (expr (call printLn (interp "10k shuffled plain-id int finish: " (- (call micros) t1) " us")))
    (expr (call checkUnique (& kr) ids sh "plain int shuffle"))
    (let kp _ (call (. Keyed new) mem))
    (expr (call intFrame (& kp) vals (call list mem (array-lit 1 2))))
    (expr (call (. kp pushInt) (index vals 3)))
    (expr (call ok (== (. kp cn) 3) "int push appends"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) 1048576))
    (let N _ 10000)
    (let names _ (call (. mem alloc) (targs string) (+ N 10)))
    (for i (.. 0 (+ N 10)) (block
      (let tx _ (call (. Text new) (& mem)))
      (expr (call (. tx pushStr) (interp "k" i)))
      (= (index names i) (call (. tx str)))))
    (let k _ (call (. Keyed new) (& mem)))
    (let a _ (call seq (& mem) 50))
    (expr (call frame (& k) names a))
    (expr (call ok (. k changed) "first frame changed"))
    (expr (call frame (& k) names a))
    (expr (call ok (! (. k changed)) "steady"))
    (let used _ (call (. mem checkpoint)))
    (for f (.. 0 200) (block
      (expr (call frame (& k) names a))
      (expr (call ok (! (. k changed)) "steady frame"))))
    (expr (call ok (== (call (. mem checkpoint)) used) "steady frames allocate nothing"))
    (let rev _ (call (. (type-path List int) new) (& mem)))
    (for i (.. 0 50) (block
      (expr (call (. rev push) (- 49 i)))))
    (expr (call frame (& k) names rev))
    (expr (call ok (. k changed) "reverse changed"))
    (expr (call checkUnique (& k) a rev "reverse"))
    (expr (call ok (== (. (. k dead) len) 0) "reverse no dead"))
    (let b _ (call list (& mem) (array-lit 5 1 2 3 4)))
    (expr (call frame (& k) names b))
    (let c _ (call list (& mem) (array-lit 5 9 1 3 4 8)))
    (expr (call frame (& k) names c))
    (expr (call checkUnique (& k) b c "insert/remove"))
    (expr (call ok (&& (== (. (. k dead) len) 1) (== (index (. (. k dead) items) 0) 2)) "removed row 2 is dead"))
    (let d _ (call list (& mem) (array-lit 20 21 22)))
    (expr (call frame (& k) names d))
    (expr (call checkUnique (& k) c d "all new"))
    (expr (call ok (== (. (. k dead) len) 6) "all old dead"))
    (let e _ (call (. (type-path List int) new) (& mem)))
    (expr (call frame (& k) names e))
    (expr (call ok (&& (&& (. k changed) (== (. (. k from) len) 0)) (== (. (. k dead) len) 3)) "to empty"))
    (expr (call frame (& k) names e))
    (expr (call ok (! (. k changed)) "empty steady"))
    (expr (call frame (& k) names d))
    (expr (call ok (&& (&& (&& (. k changed) (== (. (. k from) len) 3)) (== (index (. (. k from) items) 0) (- 1))) (== (. (. k dead) len) 0)) "from empty"))
    (let k2 _ (call (. Keyed new) (& mem)))
    (expr (call frame (& k2) names (call list (& mem) (array-lit 1 2 1 3 1))))
    (expr (call frame (& k2) names (call list (& mem) (array-lit 3 1 1 2 1 1))))
    (let w _ (array-lit 3 0 2 1 4 (- 1)))
    (expr (call ok (== (. (. k2 from) len) 6) "dup from length"))
    (for i (.. 0 6) (block
      (expr (call ok (== (index (. (. k2 from) items) i) (index w i)) (interp "dup from[" i "] is " (index (. (. k2 from) items) i))))))
    (expr (call ok (== (. (. k2 dead) len) 0) "dup none dead"))
    (expr (call frame (& k2) names (call list (& mem) (array-lit 1 2))))
    (expr (call ok (&& (&& (== (index (. (. k2 from) items) 0) 1) (== (index (. (. k2 from) items) 1) 3)) (== (. (. k2 dead) len) 4)) "dup shrink"))
    (let ids _ (call seq (& mem) N))
    (let kk _ (call (. Keyed new) (& mem)))
    (expr (call frame (& kk) names ids))
    (let rng _ (call (. Rng new) 12345))
    (let sh _ (call seq (& mem) N))
    (let i _ (- N 1))
    (while (> i 0) (block
      (let j _ (call (. rng intRange) 0 (+ i 1)))
      (let t _ (index (. sh items) i))
      (= (index (. sh items) i) (index (. sh items) j))
      (= (index (. sh items) j) t)
      (-= i 1)))
    (let t0 _ (call micros))
    (expr (call (. kk begin)))
    (for q (.. 0 (. sh len)) (block
      (expr (call (. kk add) (index names (index (. sh items) q))))))
    (expr (call printLn (interp "adds: " (- (call micros) t0) " us")))
    (expr (call (. kk finish) "t"))
    (let us _ (- (call micros) t0))
    (expr (call printLn (interp "10k shuffled finish: " us " us")))
    (expr (call checkUnique (& kk) ids sh "shuffle"))
    (expr (call ok (== (. (. kk dead) len) 0) "shuffle none dead"))
    (expr (call ok (< us 200000) "10k shuffle under 200 ms"))
    (let half _ (call (. (type-path List int) new) (& mem)))
    (for q (.. 0 N) (block
      (expr (call (. half push) (if-expr (== (% q 2) 0) (index (. sh items) q) (+ N (% q 10)))))))
    (expr (call frame (& kk) names half))
    (expr (call ok (== (. (. kk from) len) N) "half from length"))
    (for q (.. 0 N) (block
      (if (== (% q 2) 0) (block
        (expr (call ok (== (index (. (. kk from) items) q) q) "half kept"))))))
    (let kg _ (call (. Keyed new) (& mem)))
    (expr (call frame (& kg) names ids))
    (let small _ (call list (& mem) (array-lit 7 9000 3)))
    (expr (call frame (& kg) names small))
    (expr (call checkUnique (& kg) ids small "shrink"))
    (expr (call ok (== (. (. kg dead) len) (- N 3)) "shrink dead"))
    (expr (call frame (& kg) names sh))
    (expr (call checkUnique (& kg) small sh "regrow"))
    (let kf _ (call (. Keyed new) (& mem)))
    (expr (call ok (== (call (. kf find) (index names 5)) (- 1)) "find before any finish"))
    (expr (call frame (& kf) names sh))
    (let fo _ (bool true))
    (for q (.. 0 N) (block
      (if (!= (call (. kf find) (index names (index (. sh items) q))) q) (block
        (= fo (bool false))))))
    (expr (call ok fo "find returns the row of every key"))
    (expr (call ok (&& (== (call (. kf find) "nope") (- 1)) (== (call (. kf find) "") (- 1))) "find: missing keys"))
    (expr (call frame (& kf) names small))
    (expr (call ok (&& (== (call (. kf find) (index names 9000)) 1) (== (call (. kf find) (index names 8)) (- 1))) "find follows the latest keys"))
    (let ko _ (call (. Keyed new) (& mem)))
    (expr (call frame (& ko) names (call list (& mem) (array-lit 3 9000 7))))
    (expr (call ok (&& (&& (call (. kf sameAs) 1 (& ko) 1) (call (. kf sameAs) 2 (& ko) 0)) (! (call (. kf sameAs) 0 (& ko) 0))) "sameAs compares keys across lists"))
    (let kp _ (call (. Keyed new) (& mem)))
    (expr (call frame (& kp) names (call list (& mem) (array-lit 1 2))))
    (let pk _ (bool true))
    (for q (.. 2 3000) (block
      (expr (call (. kp push) (index names (+ q 1))))
      (if (!= (. kp cn) (+ q 1)) (block
        (= pk (bool false))))))
    (for q (.. 0 3000) (block
      (if (!= (call (. kp find) (index names (if-expr (< q 2) (+ q 1) (+ q 1)))) q) (block
        (= pk (bool false))))))
    (expr (call ok (&& pk (== (call (. kp find) (index names 3001)) (- 1))) "push appends keys and keeps find right across rehashes"))
    (expr (call (. kf reset)))
    (expr (call ok (== (call (. kf find) (index names 9000)) (- 1)) "find after reset"))
    (expr (call intKeys (& mem) ids sh N))
    (expr (call printLn "keyed_test: PASS")))))
--- stderr
--- exit 0
