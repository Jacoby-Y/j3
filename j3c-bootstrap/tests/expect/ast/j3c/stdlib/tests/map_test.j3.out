(file (module map_test)
  (use j3.cmp (names Hash combine hashOf))
  (use j3.data.map.Map)
  (use j3.game.ecs.Entity)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.sys.panic)
  (struct (doc "Every key hashes the same: all probes collide.") Bad
    (field n int)
    (fn operator== (params (this Bad) (o Bad)) bool (block
      (return (== (. this n) (. o n)))))
    (fn hash (params (this Bad)) u64 (block
      (return (call u64 7)))))
  (struct (doc "Every key's home is the last slot, so runs wrap around the end of the table.") Wrap
    (field n int)
    (fn operator== (params (this Wrap) (o Wrap)) bool (block
      (return (== (. this n) (. o n)))))
    (fn hash (params (this Wrap)) u64 (block
      (return (call u64 (- 1))))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "map_test"))))))
  (fn getOr (params (m (ref (gen Map int int))) (k int)) int (block
    (match (call (. m get) k)
      (arm (pats (variant Option.Some (bind v))) (block
        (return v)))
      (arm (pats (variant Option.None)) (block
        (return (- 1)))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (let m _ (call (. (type-path Map int int) new) (& mem) 0))
    (expr (call ok (&& (&& (== (. m len) 0) (! (call (. m has) 1))) (== (call getOr (& m) 1) (- 1))) "empty"))
    (for i (.. 0 1000) (block
      (expr (call (. m put) i (* i 3)))))
    (expr (call ok (== (. m len) 1000) "grow len"))
    (for i (.. 0 1000) (block
      (expr (call ok (== (call getOr (& m) i) (* i 3)) "grow get"))))
    (expr (call (. m put) 5 99))
    (expr (call ok (&& (== (. m len) 1000) (== (call getOr (& m) 5) 99)) "overwrite"))
    (expr (call ok (&& (== (call (. m getOr) 5000 7) 7) (== (call (. m getOr) 5 7) 99)) "getOr"))
    (for i (.. 0 1000) (block
      (if (== (% i 2) 0) (block
        (expr (call ok (call (. m remove) i) "remove"))))))
    (expr (call ok (&& (! (call (. m remove) 0)) (== (. m len) 500)) "remove twice"))
    (for i (.. 0 1000) (block
      (expr (call ok (== (call (. m has) i) (== (% i 2) 1)) "after remove"))))
    (for i (.. 0 1000) (block
      (if (== (% i 2) 0) (block
        (expr (call (. m put) i (- i)))))))
    (expr (call ok (&& (&& (== (. m len) 1000) (== (call getOr (& m) 4) (- 4))) (== (call getOr (& m) 5) 99)) "reinsert"))
    (let t _ (call (. (type-path Map int int) new) (& mem) 4))
    (for round (.. 0 5000) (block
      (expr (call (. t put) round round))
      (if (>= round 3) (block
        (expr (call ok (call (. t remove) (- round 3)) "churn remove"))))
      (expr (call ok (< (call (. t find) (+ round 100000)) 0) "churn miss terminates"))))
    (expr (call ok (&& (&& (&& (&& (== (. t len) 3) (<= (. t cap) 32)) (call (. t has) 4999)) (call (. t has) 4997)) (! (call (. t has) 4996))) "churn state"))
    (let b _ (call (. (type-path Map Bad int) new) (& mem) 0))
    (for i (.. 0 40) (block
      (expr (call (. b put) (struct-lit Bad (field n i)) i))))
    (expr (call (. b remove) (struct-lit Bad (field n 10))))
    (expr (call (. b put) (struct-lit Bad (field n 41)) 41))
    (expr (call ok (&& (&& (&& (== (. b len) 40) (! (call (. b has) (struct-lit Bad (field n 10))))) (== (call (. b getOr) (struct-lit Bad (field n 39)) (- 1)) 39)) (== (call (. b getOr) (struct-lit Bad (field n 41)) (- 1)) 41)) "colliding keys"))
    (expr (call (. b put) (struct-lit Bad (field n 10)) 1010))
    (expr (call ok (&& (== (call (. b getOr) (struct-lit Bad (field n 10)) (- 1)) 1010) (== (. b len) 41)) "colliding reinsert"))
    (let w _ (call (. (type-path Map Wrap int) new) (& mem) 0))
    (for i (.. 0 30) (block
      (expr (call (. w put) (struct-lit Wrap (field n i)) i))))
    (for i (.. 0 30) (block
      (if (== (% i 3) 0) (block
        (expr (call ok (call (. w remove) (struct-lit Wrap (field n i))) "wrap remove"))))))
    (for i (.. 0 30) (block
      (expr (call ok (== (call (. w has) (struct-lit Wrap (field n i))) (!= (% i 3) 0)) "wrap survivors"))))
    (for i (.. 0 30) (block
      (if (== (% i 3) 0) (block
        (expr (call (. w put) (struct-lit Wrap (field n i)) (+ i 100)))))))
    (expr (call ok (&& (&& (== (. w len) 30) (== (call (. w getOr) (struct-lit Wrap (field n 9)) (- 1)) 109)) (== (call (. w getOr) (struct-lit Wrap (field n 10)) (- 1)) 10)) "wrap reinsert"))
    (let lk _ (call (. Arena create) (<< 1 16)))
    (let c _ (call (. (type-path Map int int) new) (& lk) 8))
    (let before _ (. lk used))
    (for i (.. 0 100000) (block
      (expr (call (. c put) i i))
      (expr (call ok (call (. c remove) i) "leak remove"))))
    (expr (call ok (&& (== (. lk used) before) (== (. c len) 0)) "churn does not allocate"))
    (let s _ (call (. (type-path Map string int) new) (& mem) 0))
    (expr (call (. s put) "alpha" 1))
    (expr (call (. s put) "beta" 2))
    (expr (call (. s put) "alpha" 3))
    (expr (call ok (&& (&& (&& (== (. s len) 2) (== (call (. s getOr) "alpha" 0) 3)) (== (call (. s getOr) "beta" 0) 2)) (! (call (. s has) "gamma"))) "string keys"))
    (let e _ (call (. (type-path Map Entity int) new) (& mem) 0))
    (expr (call (. e put) (struct-lit Entity (field id 1) (field gen 0)) 10))
    (expr (call (. e put) (struct-lit Entity (field id 1) (field gen 1)) 11))
    (expr (call ok (&& (&& (== (. e len) 2) (== (call (. e getOr) (struct-lit Entity (field id 1) (field gen 0)) 0) 10)) (== (call (. e getOr) (struct-lit Entity (field id 1) (field gen 1)) 0) 11)) "entity keys"))
    (let sum _ 0)
    (let seen _ 0)
    (for i (.. 0 (. m cap)) (block
      (if (call (. m live) i) (block
        (+= sum (call (. m keyAt) i))
        (+= seen 1)))))
    (expr (call ok (&& (== seen 1000) (== sum 499500)) "iterate"))
    (expr (call (. m clear)))
    (expr (call ok (&& (== (. m len) 0) (! (call (. m has) 5))) "clear"))
    (expr (call (. m put) 5 1))
    (expr (call ok (== (call getOr (& m) 5) 1) "put after clear"))
    (expr (call printLn "map_test ok")))))
--- stderr
--- exit 0
