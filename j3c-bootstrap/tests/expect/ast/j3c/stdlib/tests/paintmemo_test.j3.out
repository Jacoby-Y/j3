(file (module paintmemo_test)
  (use j3.game)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CHECKS int _)
  (mod-let (doc "The frame number: the inline width and `.swap`'s class follow it when `MOVE` is on.") STEP int _)
  (mod-let MOVE bool _)
  (mod-let (doc "Box 0 takes the class `.nw`, a row no box had.") NEW bool _)
  (const (doc "One box per case: the plain ones take the memo, the rest its long way (effects, one-sided and dashed borders, shadows,\ngradients, percentages, a `style:` slot overriding paint).") SHEET string ".page { display: flex; flex-wrap: wrap; gap: 3px; padding: 4px; width: 400px; } .b { width: 40px; height: 30px; } .bg { background: #336699; } .rd { background: #224466; border-radius: 6px; } .bd { border: 2px solid #ff8800; border-radius: 4px; background: #101820; } .bo { border: 2px solid #ff8800; } .one { border-left: 3px solid #00ff00; background: #202020; } .dash { border: 2px dashed #ffffff; } .op { background: #ff0000; opacity: 0.5; } .tf { background: #00ff00; transform: rotate(10deg); } .ol { background: #0000ff; outline: 2px solid #ffff00; } .ov { background: #444444; overflow: hidden; } .sh { background: #555555; box-shadow: 2px 2px 4px #000000; } .gr { background-image: linear-gradient(90deg, #ff0000, #0000ff); } .pc { background: #777777; border-radius: 50%; } .cur { color: #ff00ff; border: 1px solid currentcolor; } .c0 { background: #111111; } .c1 { background: #222222; } .fill { height: 4px; background: #89b4fa; border-radius: 2px; } .nw { background: #123456; } .inner { width: 10px; height: 10px; background: #abcdef; }")
  (const CLASSES (array 16 string) (array-lit "bg" "rd" "bd" "bo" "one" "dash" "op" "tf" "ol" "ov" "sh" "gr" "pc" "cur" "c0" "fill"))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn build (params (d (ref Dom))) _ (block
    (let page _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) page "page"))
    (for i (.. 0 16) (block
      (let b _ (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d cls) b "b"))
      (expr (call (. d cls) b (if-expr (&& NEW (== i 0)) "nw" (index CLASSES i))))
      (if (== i 9) (block
        (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
        (expr (call (. d cls) c "inner"))
        (expr (call (. d close)))))
      (expr (call (. d close)))))
    (let f _ (call (. d open) 16 (call (. d tag) "div") 1))
    (expr (call (. d cls) f "fill"))
    (expr (call (. d styleStr) f 0 "width" (if-expr MOVE (interp (+ 10 (% STEP 20)) "px") "12px")))
    (expr (call (. d close)))
    (let g _ (call (. d open) 17 (call (. d tag) "div") 1))
    (expr (call (. d cls) g "b"))
    (expr (call (. d styleStr) g 0 "background" (if-expr (&& MOVE (== (% STEP 2) 1)) "#00ffff" "#ff00ff")))
    (expr (call (. d close)))
    (let s _ (call (. d open) 18 (call (. d tag) "div") 1))
    (expr (call (. d cls) s "b"))
    (expr (call (. d cls) s (if-expr (&& MOVE (== (% STEP 2) 1)) "c1" "c0")))
    (expr (call (. d close)))
    (expr (call (. d close)))))
  (fn (doc "One frame; the hash of every instance it queued.") frame (params (d (ref Dom))) u64 (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x407a400000000000)) (field y (float 0x4069000000000000)))))
    (expr (call build d))
    (expr (call (. d layout)))
    (expr (call (. game p2Watch) (bool true)))
    (expr (call (. d paintAll)))
    (let h _ (call (. game p2Watched)))
    (expr (call (. game p2Watch) (bool false)))
    (expr (call (. d endFrame)))
    (expr (call (. game p2Flush)))
    (+= STEP 1)
    (return h)))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call (. game initGlHidden) "paint memo" 420 200))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "paintmemo.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "fixture CSS parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call frame (& d)))
    (let a _ (call frame (& d)))
    (expr (call ok (!= a 0) "the frame queued something"))
    (let built _ (. d pmBuilt))
    (expr (call ok (> built 0) "the plain boxes have memo rows"))
    (let b _ (call frame (& d)))
    (expr (call ok (== a b) "a second identical frame queues a byte-identical batch"))
    (expr (call ok (== (. d pmBuilt) built) "and works out no memo row again"))
    (= (. d pmOn) (bool false))
    (let c _ (call frame (& d)))
    (expr (call ok (== a c) "the memo queues exactly what the long way queues"))
    (= (. d pmOn) (bool true))
    (= MOVE (bool true))
    (for i (.. 0 6) (block
      (let on _ (call frame (& d)))
      (-= STEP 1)
      (= (. d pmOn) (bool false))
      (let off _ (call frame (& d)))
      (= (. d pmOn) (bool true))
      (expr (call ok (== on off) "a changing frame paints the same from the memo as the long way"))))
    (let before _ (. d pmBuilt))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d pmBuilt) before) "rows seen before are not worked out again"))
    (= MOVE (bool false))
    (= NEW (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (. d pmBuilt) (+ before 1)) "one box on a new class works out that one row"))
    (expr (call frame (& d)))
    (expr (call ok (== (. d pmBuilt) (+ before 1)) "and nothing after it"))
    (expr (call printLn (interp "paintmemo_test ok, checks passed: " CHECKS)))
    (expr (call (. game destroy)))
    (expr (call (. mem destroy))))))
--- stderr
--- exit 0
