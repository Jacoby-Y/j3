  (fn (doc "One block of `text` in the shape `kind`: 0 the block itself carries `transition` and the class `cls`; 1 a static block with a\n`<span>` that transitions (`lsb` on); 2 the block transitions `lsb` and holds a `<span>` with its own `letter-spacing: 0px`;\n3 `transition: all`; 4 `@property --ls` transitioned and read by `letter-spacing: var(--ls)` (`von` on). Returns the block's width.") spframe (params (e (ref Dom)) (kind int) (cls string) (text string)) f32 (block
    (let on _ (> (. cls len) 0))
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let row _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e styleStr) row 1 "display" "flex"))
    (let id _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e cls) id "box"))
    (expr (call (. e cls) id "nw"))
    (if (== kind 0) (block
      (expr (call (. e cls) id "tr2"))
      (expr (call (. e clsIf) id "px0" (call same (call bytes cls) "px0")))
      (expr (call (. e clsIf) id "lsb" (call same (call bytes cls) "lsb")))
      (expr (call (. e clsIf) id "lse" (call same (call bytes cls) "lse")))
      (expr (call (. e clsIf) id "wsa" (call same (call bytes cls) "wsa")))
      (expr (call (. e clsIf) id "wsb" (call same (call bytes cls) "wsb")))
      (expr (call (. e clsIf) id "kfa" (call same (call bytes cls) "kfa")))
      (expr (call (. e text) text))) (block
      (if (== kind 1) (block
        (let sp _ (call (. e open) 0 (call (. e tag) "span") 1))
        (expr (call (. e cls) sp "sps"))
        (expr (call (. e clsIf) sp "lsb" on))
        (expr (call (. e text) text))
        (expr (call (. e close)))) (block
        (if (== kind 2) (block
          (expr (call (. e cls) id "tr2"))
          (expr (call (. e clsIf) id "lsb" on))
          (expr (call (. e text) "ab"))
          (let sq _ (call (. e open) 0 (call (. e tag) "span") 1))
          (expr (call (. e cls) sq "own"))
          (expr (call (. e text) "cd"))
          (expr (call (. e close)))) (block
          (if (== kind 5) (block
            (expr (call (. e cls) id "tr2"))
            (expr (call (. e clsIf) id "lsb" on))
            (let sf _ (call (. e open) 0 (call (. e tag) "span") 1))
            (expr (call (. e cls) sf "fd"))
            (expr (call (. e text) text))
            (expr (call (. e close)))) (block
            (if (== kind 3) (block
              (expr (call (. e cls) id "all"))
              (expr (call (. e clsIf) id "lsb" (call same (call bytes cls) "lsb")))
              (expr (call (. e clsIf) id "bgc" (call same (call bytes cls) "bgc")))
              (expr (call (. e text) text))) (block
              (expr (call (. e cls) id "vp"))
              (expr (call (. e clsIf) id "von" on))
              (expr (call (. e text) text))))))))))))
    (expr (call (. e close)))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))
    (return (. (index (. (. e nodes) items) id) w))))
  (fn (doc "Settle on `from`, switch to `to`, and check the text width moves between the two while the transition runs\n(it lays out then) and is steady (no layout) once it has finished.") glide (params (mem (ref Arena)) (css (ref Css)) (from string) (to string) (text string) (w0 f32) (w1 f32) (msg string)) _ (block
    (expr (call glideK mem css 0 from to text w0 w1 w1 msg))))
  (fn (doc "`glide` for block shape `kind` (`spframe`); the width never goes past `cap` on the way.") glideK (params (mem (ref Arena)) (css (ref Css)) (kind int) (from string) (to string) (text string) (w0 f32) (w1 f32) (cap f32) (msg string)) _ (block
    (let e _ (call (. Dom new) mem css))
