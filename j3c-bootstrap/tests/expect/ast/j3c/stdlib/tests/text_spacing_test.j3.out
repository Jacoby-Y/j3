  (fn (doc "A long spaced paragraph (ASCII and non-ASCII) lays out in a blink, and idle frames afterwards cost nothing.") testScale (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let para _ (call (. mem alloc) (targs u8) 2400))
    (for i (.. 0 2400) (block
      (= (index para i) (if-expr (== (% i 6) 5) 32 (+ 97 (call u8 (% i 7)))))))
