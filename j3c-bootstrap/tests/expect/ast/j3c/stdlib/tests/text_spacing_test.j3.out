    (let rs _ (. e restyled))
    (let used _ (. (. e mem) used))
    (for k (.. 0 6) (block
      (expr (call tframe (& e) "abc \xc3\xa9\xe6\x97\xa5 d\xc3\xa9j\xc3\xa0"))))
    (expr (call ok (&& (&& (== (. e laid) laid) (== (. e restyled) rs)) (== (. (. e mem) used) used)) "steady spaced non-ASCII frames lay out, restyle and allocate nothing"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
