    (let dt _ (- (call micros) t0))
    (expr (call ok (> (call lines (& d) LASTID) 5) "the long paragraph wraps"))
    (expr (call ok (< dt 500000) "2400 spaced characters lay out in under half a second"))
    (let acc _ "\xc3\xa9")
    (let ub _ (call (. mem alloc) (targs u8) 2000))
    (for i (.. 0 1000) (block
      (= (index ub (* 2 i)) (index acc 0))
      (= (index ub (+ (* 2 i) 1)) (index acc 1))))
