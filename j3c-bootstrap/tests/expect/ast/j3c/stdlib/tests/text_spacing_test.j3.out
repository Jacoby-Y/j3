    (expr (call ok mono (interp msg ": width moves one way")))
    (expr (call ok (> (. e laid) laid) (interp msg ": lays out while it runs")))
    (for k (.. 0 30) (block
      (= x (call spframe (& e) kind to text))))
    (expr (call near x w1 (float 0x3f847ae147ae147b) (interp msg ": ends on the target")))
    (= laid (. e laid))
    (for k (.. 0 30) (block
      (= x (call spframe (& e) kind to text))))
    (expr (call ok (== (. e laid) laid) (interp msg ": steady afterwards")))))
  (fn (doc "`letter-spacing` and `word-spacing` transition and animate like other lengths.") testTransition (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let e _ (call (. Dom new) mem css))
