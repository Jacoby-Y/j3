    (expr (call ok (< (- (call micros) t1) 500000) "1000 spaced non-ASCII code points lay out in under half a second"))
    (expr (call ok (> (. (index (. (. d2 nodes) items) LASTID) w) (float 0x0000000000000000)) "laid out"))
    (let e _ (call (. Dom new) mem css))
