(file (module text_spacing_test)
  (use j3.game (names micros selRectW selRectX textSelRects loadFont setTextMode textCaretX TextMode textWidth Font))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.math.Vec2)
  (use j3.sys.panic)
  (use j3.ui.css (names Css P_LETTER_SPACING))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"speculative/42_ui_numeric/assets/num.ttf\"); } .box { font-family: \"T\"; font-size: 16px; } .ls { letter-spacing: 2px; } .lsem { letter-spacing: 0.5em; } .lsneg { letter-spacing: -1px; } .ws { word-spacing: 6px; } .nw { white-space: nowrap; } .blk { width: 200px; } .just { text-align: justify; } .ell { width: 80px; white-space: nowrap; overflow-y: hidden; text-overflow: ellipsis; } .clamp { width: 90px; line-clamp: 2; } .up { text-transform: uppercase; } .low { text-transform: lowercase; } .cap { text-transform: capitalize; } .ind { text-indent: 30px; } .indp { text-indent: 10%; } .right { text-align: right; } .kid { text-indent: 0px; } .tr { transition: letter-spacing 200ms linear; } .tr2 { transition: letter-spacing 160ms linear, word-spacing 160ms linear; } .px0 { letter-spacing: 0px; } .lsb { letter-spacing: 10px; } .lse { letter-spacing: 1em; } .wsa { word-spacing: 20px; } .wsb { word-spacing: 40px; } @keyframes sp { from { letter-spacing: 0px; } to { letter-spacing: 10px; } } .kfa { animation: sp 160ms linear forwards; } .sps { transition: letter-spacing 160ms linear; } .own { letter-spacing: 0px; } @keyframes fade { from { opacity: 0.2; } to { opacity: 0.9; } } .fd { animation: fade 1s linear forwards; } .all { transition: all 160ms linear; } .bgc { background: #333333; } @property --ls { syntax: '<length>'; inherits: true; initial-value: 0px; } .vp { transition: --ls 160ms linear; letter-spacing: var(--ls); } .vp.von { --ls: 10px; }")
  (mod-let CHECKS int _)
  (mod-let LASTID int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (expr (call ok (<= d tol) msg))))
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (fn w (params (f Font) (s string)) f32 (block
    (return (call textWidth f (call bytes s) (bool false)))))
  (fn mode (params (ls f32) (ws f32)) _ (block
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool false)) (field letterSp ls) (field wordSp ws) (field shaped (bool false)))))))
  (fn (doc "One block `cls` holding `text`, laid out in a 600 x 400 view; the block is `LASTID`.") build (params (mem (ref Arena)) (css (ref Css)) (cls string) (text string)) Dom (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let row _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d styleStr) row 1 "display" "flex"))
    (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) id "box"))
    (let a _ 0)
    (for i (.. 0 (+ (. cls len) 1)) (block
      (if (|| (== i (. cls len)) (== (index cls i) 32)) (block
        (if (> i a) (block
          (expr (call (. d cls) id (slice-expr cls a i)))))
        (= a (+ i 1))))))
    (expr (call (. d text) text))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4082c00000000000) (float 0x4079000000000000)))
    (= LASTID id)
    (return d)))
  (fn boxW (params (mem (ref Arena)) (css (ref Css)) (cls string) (text string)) f32 (block
    (let d _ (call build mem css cls text))
    (return (. (index (. (. d nodes) items) LASTID) w))))
  (fn testGame (params (f Font)) _ (block
    (let base _ (call w f "abc"))
    (let ab _ (call w f "a b"))
    (expr (call mode (float 0x4000000000000000) (float 0x0000000000000000)))
    (expr (call near (call w f "abc") (+ base (float 0x4018000000000000)) (float 0x3f50624dd2f1a9fc) "letter-spacing adds after every glyph, the last included"))
    (expr (call near (call w f "a b") (+ ab (float 0x4018000000000000)) (float 0x3f50624dd2f1a9fc) "a space is a glyph too"))
    (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
    (let plain _ (call w f "a b c"))
    (expr (call mode (float 0x0000000000000000) (float 0x4014000000000000)))
    (expr (call near (call w f "a b c") (+ plain (float 0x4024000000000000)) (float 0x3f50624dd2f1a9fc) "word-spacing adds on each space only"))
    (expr (call near (call w f "abc") base (float 0x3f50624dd2f1a9fc) "no spaces, no word-spacing"))
    (expr (call mode (float 0x4000000000000000) (float 0x4014000000000000)))
    (expr (call near (call w f "a b c") (+ plain (float 0x4034000000000000)) (float 0x3f50624dd2f1a9fc) "both compose"))
    (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
    (let e1 _ (call w f "\xc3\xa9"))
    (expr (call mode (float 0x4008000000000000) (float 0x0000000000000000)))
    (expr (call near (call w f "\xc3\xa9") (+ e1 (float 0x4008000000000000)) (float 0x3f50624dd2f1a9fc) "non-ASCII: one spacing per code point"))
    (expr (call near (call w f "\xc3\xa9\xc3\xa9") (* (float 0x4000000000000000) (+ e1 (float 0x4008000000000000))) (float 0x3ff8000000000000) "two code points, two spacings"))
    (expr (call mode (- (float 0x3ff0000000000000)) (float 0x0000000000000000)))
    (expr (call near (call w f "abc") (- base (float 0x4008000000000000)) (float 0x3f50624dd2f1a9fc) "negative spacing narrows"))
    (expr (call mode (float 0x4000000000000000) (float 0x0000000000000000)))
    (expr (call near (call textCaretX f (call bytes "abc") (bool false) 2) (call w f "ab") (float 0x3f50624dd2f1a9fc) "caret x follows the spaced prefix width"))
    (let n _ (call textSelRects f (call bytes "abc") (bool false) 1 2))
    (expr (call ok (== n 1) "one selection rect"))
    (expr (call near (call selRectX 0) (call w f "a") (float 0x3f50624dd2f1a9fc) "selection starts after the spaced 'a'"))
    (expr (call near (call selRectW 0) (call w f "b") (float 0x3f50624dd2f1a9fc) "selection is as wide as the spaced 'b'"))
    (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call near (call w f "abc") base (float 0x3f50624dd2f1a9fc) "mode restored"))))
  (fn testBlocks (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let p _ (call boxW mem css "nw" "abcd"))
    (expr (call near (call boxW mem css "nw ls" "abcd") (+ p (float 0x4020000000000000)) (float 0x3f847ae147ae147b) "block width includes letter-spacing"))
    (expr (call near (call boxW mem css "nw lsem" "abcd") (+ p (float 0x4040000000000000)) (float 0x3f847ae147ae147b) "0.5em at 16px is 8px a letter"))
    (expr (call near (call boxW mem css "nw lsneg" "abcd") (- p (float 0x4010000000000000)) (float 0x3f847ae147ae147b) "negative letter-spacing"))
    (let q _ (call boxW mem css "nw" "a b"))
    (expr (call near (call boxW mem css "nw ws" "a b") (+ q (float 0x4018000000000000)) (float 0x3f847ae147ae147b) "word-spacing on the space"))
    (expr (call mode (float 0x4000000000000000) (float 0x0000000000000000)))
    (expr (call near (call boxW mem css "nw ls" "abcd") (call w f "abcd") (float 0x3f847ae147ae147b) "block width equals the spaced text width"))
    (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call near (call w f "abcd") p (float 0x3f847ae147ae147b) "layout leaves no spacing behind"))))
  (fn frame (params (e (ref Dom)) (cls string)) _ (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) e))
    (let p _ (call (. e open) 0 (call (. e tag) "input") 1))
    (expr (call (. e cls) p "box"))
    (if (> (. cls len) 0) (block
      (expr (call (. e cls) p cls))))
    (expr (call (. e attrType) p "text"))
    (expr (call (. e attrText) p "abcd"))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))))
  (fn testInput (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call frame (& e) "ls"))))
    (let id _ (. (index (. (. e nodes) items) 0) first))
    (expr (call (. e focusNode) id))
    (expr (call (. e simKeys) "" "End"))
    (expr (call frame (& e) "ls"))
    (let c _ (call (. e caretRect) id))
    (expr (call mode (float 0x4000000000000000) (float 0x0000000000000000)))
    (let want _ (call w f "abcd"))
    (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call near (- (. c x) (call (. e absX) id)) want (float 0x4000000000000000) "input caret at the end follows the letter-spaced text"))
    (expr (call ok (> want (+ (call w f "abcd") (float 0x401c000000000000))) "(spaced text is wider)"))))
  (fn iframe (params (e (ref Dom)) (on bool)) _ (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) e))
    (let p _ (call (. e open) 0 (call (. e tag) "input") 1))
    (expr (call (. e cls) p "box"))
    (expr (call (. e cls) p "tr2"))
    (expr (call (. e clsIf) p "lsb" on))
    (expr (call (. e attrType) p "text"))
    (expr (call (. e attrText) p "abcd"))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))))
  (fn (doc "The caret of a focused `<input>` follows the painted, mid-transition letter-spacing frame by frame.") testInputGlide (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call iframe (& e) (bool false)))))
    (let id _ (. (index (. (. e nodes) items) 0) first))
    (expr (call (. e focusNode) id))
    (expr (call (. e simKeys) "" "End"))
    (let mid _ (bool false))
    (for k (.. 0 8) (block
      (expr (call iframe (& e) (bool true)))
      (let ls _ (. (call (. (. e css) get) (. (index (. (. e nodes) items) id) style) P_LETTER_SPACING) f))
      (if (&& (> ls (float 0x3fe0000000000000)) (< ls (float 0x4023000000000000))) (block
        (= mid (bool true))))
      (expr (call mode ls (float 0x0000000000000000)))
      (let want _ (call w f "abcd"))
      (expr (call mode (float 0x0000000000000000) (float 0x0000000000000000)))
      (expr (call near (- (. (call (. e caretRect) id) x) (call (. e absX) id)) want (float 0x4000000000000000) "input caret tracks the spacing mid-transition"))))
    (expr (call ok mid "the input's letter-spacing was mid-transition"))))
  (fn (doc "The first line's fragments: their right edge, and how many lines (distinct y) there are.") lines (params (d (ref Dom)) (owner int)) int (block
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (let n _ 0)
    (let y f32 (- (float 0x408f400000000000)))
    (while (>= f 0) (block
      (if (!= (. (index (. (. d frags) items) f) y) y) (block
        (+= n 1)
        (= y (. (index (. (. d frags) items) f) y))))
      (= f (. (index (. (. d frags) items) f) next))))
    (return n)))
  (fn firstLineRight (params (d (ref Dom)) (owner int)) f32 (block
    (let f _ (. (index (. (. d nodes) items) owner) frag0))
    (let y _ (. (index (. (. d frags) items) f) y))
    (let r f32 (float 0x0000000000000000))
    (while (&& (>= f 0) (== (. (index (. (. d frags) items) f) y) y)) (block
      (= r (+ (. (index (. (. d frags) items) f) x) (. (index (. (. d frags) items) f) w)))
      (= f (. (index (. (. d frags) items) f) next))))
    (return r)))
  (fn testJustify (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let t _ "aa bb cc dd ee ff gg hh ii jj kk ll mm")
    (let d _ (call build mem css "blk just ws" t))
    (expr (call ok (> (call lines (& d) LASTID) 1) "justify + word-spacing wraps"))
    (expr (call near (call firstLineRight (& d) LASTID) (float 0x4069000000000000) (float 0x3fe3333333333333) "justified first line still fills the box with word-spacing"))
    (let d2 _ (call build mem css "blk just ls" t))
    (expr (call near (call firstLineRight (& d2) LASTID) (float 0x4069000000000000) (float 0x3fe3333333333333) "justified first line fills the box with letter-spacing"))))
  (fn testClip (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let t _ "abcdefghijklmnopqrstuvwxyz")
    (let d _ (call build mem css "ell ls" t))
    (let tail _ (. (index (. (. d nodes) items) LASTID) fragTail))
    (let fr _ (index (. (. d frags) items) tail))
    (expr (call ok (>= (. fr ell) (float 0x0000000000000000)) "ellipsis cuts the spaced line"))
    (expr (call ok (<= (+ (. fr x) (. fr w)) (float 0x405400a3d70a3d71)) "the cut line with its ellipsis fits the box"))
    (let d0 _ (call build mem css "ell" t))
    (let fr0 _ (index (. (. d0 frags) items) (. (index (. (. d0 nodes) items) LASTID) fragTail)))
    (expr (call ok (< (. fr end) (. fr0 end)) "letter-spacing fits fewer letters before the ellipsis"))
    (let c _ (call build mem css "clamp ls" "aaa bbb ccc ddd eee fff ggg hhh"))
    (expr (call ok (== (call lines (& c) LASTID) 2) "line-clamp: 2 keeps two spaced lines"))))
  (fn testTransform (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (expr (call near (call boxW mem css "nw up" "abc xyz") (call w f "ABC XYZ") (float 0x3f847ae147ae147b) "uppercase measures the upper case"))
    (expr (call near (call boxW mem css "nw low" "ABC XYZ") (call w f "abc xyz") (float 0x3f847ae147ae147b) "lowercase measures the lower case"))
    (expr (call near (call boxW mem css "nw cap" "hello wide world") (call w f "Hello Wide World") (float 0x3f847ae147ae147b) "capitalize raises each word's first letter"))
    (expr (call near (call boxW mem css "nw cap" "it's a day-off") (call w f "It's A Day-Off") (float 0x3f847ae147ae147b) "capitalize: apostrophe stays in the word, hyphen splits"))
    (expr (call near (call boxW mem css "nw up" "\xc3\xa9a \xc3\xa0") (call w f "\xc3\x89A \xc3\x80") (float 0x3f847ae147ae147b) "Latin-1 letters change case"))
    (expr (call near (call boxW mem css "nw up" "\xc3\x9f\xc3\x97") (call w f "\xc3\x9f\xc3\x97") (float 0x3f847ae147ae147b) "sharp s and the sign are left alone"))
    (let d _ (call build mem css "up" "abc \xc3\xa9"))
    (let s _ (call (. dom shownText) (& d) (. (index (. (. d nodes) items) LASTID) first)))
    (expr (call ok (&& (&& (&& (&& (&& (== (. s len) 6) (== (index s 0) 65)) (== (index s 1) 66)) (== (index s 2) 67)) (== (index s 4) 195)) (== (index s 5) 137)) "shownText bytes"))
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call tframe (& e) "abc"))))
    (let laid _ (. e laid))
    (let rs _ (. e restyled))
    (let used _ (. (. e mem) used))
    (for k (.. 0 6) (block
      (expr (call tframe (& e) "abc"))))
    (expr (call ok (&& (&& (== (. e laid) laid) (== (. e restyled) rs)) (== (. (. e mem) used) used)) "steady uppercase frames do not lay out, restyle or allocate"))
    (let before _ (. (index (. (. e nodes) items) (call tframe (& e) "abc")) w))
    (let after _ (. (index (. (. e nodes) items) (call tframe (& e) "mmmmmm")) w))
    (expr (call ok (> after before) "new text is re-transformed and re-measured"))))
  (fn tframe (params (e (ref Dom)) (text string)) int (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let row _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e styleStr) row 1 "display" "flex"))
    (let id _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e cls) id "box"))
    (expr (call (. e cls) id "up"))
    (expr (call (. e cls) id "ls"))
    (expr (call (. e text) text))
    (expr (call (. e close)))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))
    (return id)))
  (fn testIndent (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let t _ "aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk")
    (let d _ (call build mem css "blk ind" t))
    (let f0 _ (. (index (. (. d nodes) items) LASTID) frag0))
    (expr (call near (. (index (. (. d frags) items) f0) x) (float 0x403e000000000000) (float 0x3f847ae147ae147b) "the first line starts 30px in"))
    (let y0 _ (. (index (. (. d frags) items) f0) y))
    (let g _ f0)
    (while (&& (>= g 0) (== (. (index (. (. d frags) items) g) y) y0)) (block
      (= g (. (index (. (. d frags) items) g) next))))
    (expr (call ok (>= g 0) "wraps"))
    (expr (call near (. (index (. (. d frags) items) g) x) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "the second line is not indented"))
    (let d1 _ (call build mem css "blk" t))
    (let n1 _ (index (. (. d1 frags) items) (. (index (. (. d1 nodes) items) LASTID) frag0)))
    (expr (call near (. n1 x) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "no indent without text-indent"))
    (let a _ (call firstLineRight (& d) LASTID))
    (expr (call ok (<= a (float 0x40690051eb851eb8)) "first line stays inside the box"))
    (let cnt _ 0)
    (let cnt1 _ 0)
    (let q _ (. (index (. (. d nodes) items) LASTID) frag0))
    (while (&& (>= q 0) (== (. (index (. (. d frags) items) q) y) y0)) (block
      (= cnt (. (index (. (. d frags) items) q) end))
      (= q (. (index (. (. d frags) items) q) next))))
    (let q1 _ (. (index (. (. d1 nodes) items) LASTID) frag0))
    (let y1 _ (. (index (. (. d1 frags) items) q1) y))
    (while (&& (>= q1 0) (== (. (index (. (. d1 frags) items) q1) y) y1)) (block
      (= cnt1 (. (index (. (. d1 frags) items) q1) end))
      (= q1 (. (index (. (. d1 frags) items) q1) next))))
    (expr (call ok (< cnt cnt1) "the indent shortens the first line's break"))
    (let p _ (call build mem css "blk indp" t))
    (expr (call near (. (index (. (. p frags) items) (. (index (. (. p nodes) items) LASTID) frag0)) x) (float 0x4034000000000000) (float 0x3f847ae147ae147b) "10% of the 200px box"))
    (let r _ (call build mem css "blk ind right" "aaa bbb"))
    (expr (call near (call firstLineRight (& r) LASTID) (float 0x4069000000000000) (float 0x3f847ae147ae147b) "right alignment still ends at the box edge, indent inside the line"))
    (expr (call near (call boxW mem css "nw ind" "abcd") (+ (call boxW mem css "nw" "abcd") (float 0x403e000000000000)) (float 0x3f847ae147ae147b) "shrink-to-fit width includes the indent"))))
  (fn same (params (a (slice u8)) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn tgl (params (e (ref Dom)) (up bool) (low bool)) int (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let row _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e styleStr) row 1 "display" "flex"))
    (let id _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e cls) id "box"))
    (expr (call (. e clsIf) id "up" up))
    (expr (call (. e clsIf) id "low" low))
    (expr (call (. e text) "Ab \xc3\xa9"))
    (expr (call (. e close)))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))
    (return id)))
  (fn (doc "A style-only change (class toggled, text unchanged) switches the shown text both ways, and the one copy buffer is reused.") testToggleTransform (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let id _ 0)
    (for k (.. 0 3) (block
      (= id (call tgl (& e) (bool false) (bool false)))))
    (let t _ (. (index (. (. e nodes) items) id) first))
    (expr (call ok (call same (call (. dom shownText) (& e) t) "Ab \xc3\xa9") "none shows the text as written"))
    (= id (call tgl (& e) (bool true) (bool false)))
    (expr (call ok (call same (call (. dom shownText) (& e) t) "AB \xc3\x89") "toggling uppercase on shows the upper case"))
    (= id (call tgl (& e) (bool false) (bool true)))
    (expr (call ok (call same (call (. dom shownText) (& e) t) "ab \xc3\xa9") "switching to lowercase does not serve the uppercase copy"))
    (= id (call tgl (& e) (bool false) (bool false)))
    (expr (call ok (call same (call (. dom shownText) (& e) t) "Ab \xc3\xa9") "toggling it off shows the original again"))
    (let used _ (. (. e mem) used))
    (for k (.. 0 6) (block
      (= id (call tgl (& e) (== (% k 2) 0) (== (% k 2) 1)))
      (expr (call ok (call same (call (. dom shownText) (& e) t) (if-expr (== (% k 2) 0) "AB \xc3\x89" "ab \xc3\xa9")) "back and forth stays correct"))))
    (expr (call ok (== (. (. e mem) used) used) "toggling back and forth reuses the copy buffer"))))
  (fn (doc "Multibyte characters outside the Latin-1 letters pass through byte for byte; edge letters are left alone (documented).") testUtf8 (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call build mem css "up" "stra\xc3\x9fe \xc7\x86 \xc3\xbf \xe6\x97\xa5\xe6\x9c\xac \xc3\xa6"))
