(file (module sim_input_test)
  (use j3.game)
  (use j3.game.Key)
  (use j3.game.Mouse)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.term.grid.Grid)
  (use j3.term.pty)
  (use j3.term.pty.Pty)
  (use j3.term.view.View)
  (use j3.text (names contains same Text))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 8 1024) 1024)))
    (expr (call (. game initGlHidden) "sim input" 320 200))
    (expr (call (. game poll)))
    (expr (call (. game simKey) (. Key Enter) (bool true)))
    (expr (call (. game poll)))
    (expr (call ok (&& (&& (call (. game keyPressedRaw) (. Key Enter)) (call (. game keyPressed) (. Key Enter))) (call (. game keyDown) (. Key Enter))) "sim press"))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game keyPressed) (. Key Enter))) (call (. game keyDown) (. Key Enter))) "press once, then held"))
    (expr (call (. game simKey) (. Key Enter) (bool true)))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game keyPressed) (. Key Enter))) "a down while held is a repeat"))
    (expr (call (. game simKey) (. Key Enter) (bool false)))
    (expr (call (. game poll)))
    (expr (call ok (&& (call (. game keyReleased) (. Key Enter)) (! (call (. game keyDown) (. Key Enter)))) "sim release"))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game keyReleased) (. Key Enter))) "release once"))
    (expr (call (. game simKey) (. Key Ctrl) (bool true)))
    (expr (call (. game simKey) (. Key Shift) (bool true)))
    (expr (call (. game simKey) (. Key V) (bool true)))
    (expr (call (. game poll)))
    (expr (call ok (&& (&& (call (. game keyDown) (. Key Ctrl)) (call (. game keyDown) (. Key Shift))) (call (. game keyPressed) (. Key V))) "Ctrl+Shift+V"))
    (expr (call (. game simKey) (. Key V) (bool false)))
    (expr (call (. game simKey) (. Key Shift) (bool false)))
    (expr (call (. game simKey) (. Key Ctrl) (bool false)))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game keyDown) (. Key Ctrl))) "modifiers up"))
    (expr (call (. game simText) "h\xc3\xa9llo"))
    (expr (call (. game poll)))
    (expr (call ok (call same (call (. game textTyped)) "h\xc3\xa9llo") "sim text"))
    (expr (call (. game poll)))
    (expr (call ok (== (. (call (. game textTyped)) len) 0) "text once"))
    (expr (call (. game simPreedit) "\xe3\x81\xab\xe3\x81\xbb" 3))
    (expr (call (. game poll)))
    (expr (call ok (&& (call same (call (. game textComposing)) "\xe3\x81\xab\xe3\x81\xbb") (== (call (. game textComposingCaret)) 3)) "sim preedit"))
    (expr (call (. game simText) "\xe6\x97\xa5\xe6\x9c\xac"))
    (expr (call (. game poll)))
    (expr (call ok (&& (== (. (call (. game textComposing)) len) 0) (call same (call (. game textTyped)) "\xe6\x97\xa5\xe6\x9c\xac")) "commit ends the composition"))
    (expr (call (. game simDrop) "/tmp/a.png"))
    (expr (call (. game poll)))
    (expr (call ok (call same (call (. game droppedFile)) "/tmp/a.png") "sim drop"))
    (expr (call (. game poll)))
    (expr (call ok (== (. (call (. game droppedFile)) len) 0) "drop once"))
    (expr (call (. game simMouse) 100 100))
    (expr (call (. game simButton) (. Mouse Left) (bool true)))
    (expr (call (. game poll)))
    (let mp _ (call (. game mousePos)))
    (expr (call ok (&& (== (. mp x) (float 0x4059000000000000)) (== (. mp y) (float 0x4059000000000000))) "sim mouse pos"))
    (expr (call ok (&& (call (. game mousePressed) (. Mouse Left)) (call (. game mouseDown) (. Mouse Left))) "sim press"))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game mousePressed) (. Mouse Left))) (call (. game mouseDown) (. Mouse Left))) "mouse press once, then held"))
    (expr (call (. game simButton) (. Mouse Left) (bool false)))
    (expr (call (. game poll)))
    (expr (call ok (&& (call (. game mouseReleased) (. Mouse Left)) (! (call (. game mouseDown) (. Mouse Left)))) "sim mouse release"))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game mouseReleased) (. Mouse Left))) "mouse release once"))
    (expr (call (. game simButton) (. Mouse Right) (bool true)))
    (expr (call (. game simButton) (. Mouse Right) (bool false)))
    (expr (call (. game poll)))
    (expr (call ok (call (. game mousePressed) (. Mouse Right)) "quick click: down frame"))
    (expr (call (. game poll)))
    (expr (call ok (call (. game mouseReleased) (. Mouse Right)) "quick click: up frame"))
    (expr (call (. game simWheel) (- 2)))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game mouseWheel)) (- (float 0x4000000000000000))) "sim wheel"))
    (expr (call (. game poll)))
    (expr (call ok (== (call (. game mouseWheel)) (float 0x0000000000000000)) "wheel once"))
    (expr (call (. game setVirtualSize) 160 100))
    (expr (call (. game simMouse) 160 100))
    (expr (call (. game poll)))
    (let vp _ (call (. game mousePos)))
    (expr (call ok (&& (== (. vp x) (float 0x4054000000000000)) (== (. vp y) (float 0x4049000000000000))) (interp "virtual size maps the sim cursor (got " (. vp x) ", " (. vp y) ")")))
    (expr (call (. game setVirtualSize) 0 0))
    (let fontPath _ (call (. Text new) (& a)))
    (expr (call (. fontPath pushStr) "examples/terminal/"))
    (expr (call (. fontPath pushStr) "assets/mono.ttf"))
    (let font _ (call (. game loadFont) (call (. fontPath str)) 14))
    (let view _ (call (. View new) (& a) font))
    (let g _ (call (. Grid new) (& a) 40 10 0))
    (let out _ (call (. Text new) (& a)))
    (let argv (array 3 string) (array-lit "/bin/sh" "-c" "read x; printf '<%s>' \"$x\""))
    (let none (array 1 string) (array-lit ""))
    (let p _ (struct-lit Pty (field fd (- 1)) (field pid (- 1)) (field pend (call (. Text new) (& a)))))
    (match (call (. pty spawn) argv "" (slice-expr none 0 0) 40 10 (& a))
      (arm (pats (variant Result.Ok (bind q))) (block
        (= p q)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "could not spawn /bin/sh")))))
    (expr (call (. game poll)))
    (expr (call (. view input) (& g) (& out)))
    (expr (call (. game simText) "ls"))
    (expr (call (. game simKey) (. Key Enter) (bool true)))
    (expr (call (. game poll)))
    (expr (call (. view input) (& g) (& out)))
    (expr (call ok (call same (call (. out str)) "ls\r") (interp "View.input sent \"ls\\\\r\" (got " (call (. out len)) " bytes)")))
    (expr (call ok (> (. view blinkT0) 0) "sending input restarts the blink phase"))
    (= (. view blinkMs) 500)
    (= (. view blinkT0) 1000)
    (expr (call ok (&& (&& (call (. view blinkOn) 0 1200) (! (call (. view blinkOn) 0 1700))) (call (. view blinkOn) 1 2100)) "blink phases"))
    (expr (call ok (&& (call (. view blinkOn) 2 1700) (call (. view blinkOn) 6 1700)) "steady shapes do not blink"))
    (= (. view blinkMs) 0)
    (expr (call ok (call (. view blinkOn) 0 1700) "blinkMs 0 is steady"))
    (expr (call ok (call (. p write) (as (call (. out str)) (slice u8))) "pty write"))
    (expr (call (. game simKey) (. Key Enter) (bool false)))
    (expr (call (. game poll)))
    (let got _ (call (. Text new) (& a)))
    (let buf _ (call (. a alloc) (targs u8) 4096))
    (for i (.. 0 100) (block
      (let pfd (array 2 i32) (array-lit (call i32 (. p fd)) (call i32 (. sys POLLIN))))
      (expr (call (. sys pollFds) (as (& (index pfd 0)) ptr) 1 50))
      (expr (call (. got pushStr) (call (. p tryRead) buf)))
      (if (|| (call contains (call (. got str)) "<ls>") (. p eof)) (block
        (break)))))
    (expr (call ok (call contains (call (. got str)) "<ls>") "the shell read the line ls"))
    (expr (call printLn "sim_input_test ok")))))
--- stderr
--- exit 0
