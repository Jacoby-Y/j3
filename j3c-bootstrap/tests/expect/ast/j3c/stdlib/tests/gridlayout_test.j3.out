    (expr (call leaf d 4 "n"))
    (expr (call (. d close)))
    (expr (call node d 12 "gdn"))
    (expr (call leaf d 0 "i s2"))
    (expr (call leaf d 1 "i s2"))
    (expr (call leaf d 2 "i"))
    (expr (call (. d close)))
    (expr (call node d 13 "gsp"))
    (expr (call leaf d 0 "i s2"))
    (expr (call leaf d 1 "i s2"))
    (expr (call leaf d 2 "i"))
    (expr (call (. d close)))
    (expr (call node d 14 "gk"))
    (expr (call leaf d 0 "w150s"))
    (expr (call leaf d 1 "w40"))
    (expr (call leaf d 2 "w30"))
    (expr (call (. d close)))
    (expr (call node d 15 "gm"))
    (expr (call leaf d 0 "n"))
    (expr (call leaf d 1 "n"))
    (expr (call (. d close)))
    (expr (call node d 16 "gm2"))
    (expr (call leaf d 0 "i"))
    (expr (call leaf d 1 "i"))
    (expr (call (. d close)))
    (expr (call node d 17 "gn"))
    (expr (call leaf d 0 "n"))
    (expr (call leaf d 1 "n"))
    (expr (call leaf d 2 "n"))
    (expr (call (. d close)))
    (expr (call node d 18 "gz"))
    (expr (call leaf d 0 "i"))
    (expr (call leaf d 1 "i"))
    (expr (call (. d close)))
    (expr (call node d 19 "gs"))
    (expr (call leaf d 0 "w300 s4 i"))
    (expr (call leaf d 1 "n c4"))
    (expr (call (. d close)))
    (expr (call node d 20 "gneg"))
    (expr (call leaf d 0 "n neg"))
    (expr (call (. d close)))
    (expr (call node d 21 "gemp"))
    (expr (call (. d close)))
    (expr (call node d 22 "gsame"))
    (expr (call leaf d 0 "n same"))
    (expr (call leaf d 1 "n same"))
    (expr (call (. d close)))
    (expr (call node d 23 "gfr"))
    (expr (call leaf d 0 "w500 s2x i"))
    (expr (call leaf d 1 "n"))
    (expr (call leaf d 2 "n"))
    (expr (call (. d close)))
    (expr (call node d 24 "gma"))
    (expr (call leaf d 0 "w150"))
