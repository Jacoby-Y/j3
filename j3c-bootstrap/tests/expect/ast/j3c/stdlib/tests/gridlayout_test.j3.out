    (expr (call node d 25 "gma"))
    (expr (call leaf d 0 "w60"))
    (expr (call leaf d 1 "n"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "The `n`th child of `id`.") kid (params (d (ref Dom)) (id int) (n int)) int (block
    (let c _ (. (index (. (. d nodes) items) id) first))
    (for q (.. 0 n) (block
      (= c (. (index (. (. d nodes) items) c) next))))
    (return c)))
  (fn (doc "The grid `n` of the page (the host's children, in `build` order).") grid (params (d (ref Dom)) (n int)) int (block
    (return (call kid d (. (index (. (. d nodes) items) 0) first) n))))
  (fn at (params (d (ref Dom)) (g int) (n int) (x f32) (y f32) (w f32) (h f32) (msg string)) _ (block
    (let c _ (call kid d g n))
    (let nd _ (& (index (. (. d nodes) items) c)))
    (expr (call near (. nd x) x (interp msg ": x")))
    (expr (call near (. nd y) y (interp msg ": y")))
    (expr (call near (. nd w) w (interp msg ": w")))
    (expr (call near (. nd h) h (interp msg ": h")))))
  (fn testRows (params (d (ref Dom))) _ (block
    (let a _ (call grid d 0))
    (expr (call at d a 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x403e000000000000) "explicit rows: first"))
    (expr (call at d a 1 (float 0x405e000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x403e000000000000) "explicit rows: column gap"))
    (expr (call at d a 2 (float 0x0000000000000000) (float 0x4044000000000000) (float 0x4059000000000000) (float 0x4049000000000000) "explicit rows: second row, row gap"))
    (expr (call at d a 3 (float 0x405e000000000000) (float 0x4044000000000000) (float 0x4059000000000000) (float 0x4049000000000000) "explicit rows: fourth"))
    (expr (call at d a 4 (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "implicit auto row after the template"))
    (expr (call near (. (index (. (. d nodes) items) a) h) (float 0x405e000000000000) "explicit rows: grid height"))
    (let b _ (call grid d 1))
    (let third f32 (float 0x404aaaaa8eb46349))
    (expr (call at d b 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4069000000000000) third "fr rows with a definite height: 1fr"))
    (expr (call at d b 1 (float 0x0000000000000000) (+ third (float 0x4024000000000000)) (float 0x4069000000000000) (* third (float 0x4000000000000000)) "fr rows with a definite height: 2fr"))
    (expr (call at d b 2 (float 0x0000000000000000) (float 0x4066800000000000) (float 0x4069000000000000) (float 0x4034000000000000) "fr rows: fixed last row"))
    (let b2 _ (call grid d 2))
    (expr (call at d b2 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4069000000000000) (float 0x4034000000000000) "fr rows with an unknown height are auto: first"))
    (expr (call at d b2 1 (float 0x0000000000000000) (float 0x403e000000000000) (float 0x4069000000000000) (float 0x4034000000000000) "fr rows with an unknown height are auto: second"))
    (expr (call at d b2 2 (float 0x0000000000000000) (float 0x404e000000000000) (float 0x4069000000000000) (float 0x4034000000000000) "fixed row"))
    (expr (call near (. (index (. (. d nodes) items) b2) h) (float 0x4054000000000000) "unknown height: grid height is the rows plus gaps"))
    (let m _ (call grid d 15))
    (expr (call at d m 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4049000000000000) "percent row of a definite height"))
    (expr (call at d m 1 (float 0x0000000000000000) (float 0x4049000000000000) (float 0x4059000000000000) (float 0x4062c00000000000) "fr row takes the rest"))
    (let m2 _ (call grid d 16))
    (expr (call at d m2 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "percent row of an unknown height is auto"))
    (expr (call at d m2 1 (float 0x0000000000000000) (float 0x4034000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "fr row of an unknown height is auto"))
    (let n _ (call grid d 17))
    (expr (call at d n 2 (float 0x0000000000000000) (float 0x403e000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "third item wraps to an implicit auto row"))))
  (fn testMinmax (params (d (ref Dom))) _ (block
    (let c _ (call grid d 3))
    (expr (call at d c 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4069000000000000) (float 0x0000000000000000) "minmax(100px, 200px) grows to its maximum"))
    (expr (call at d c 1 (float 0x4069000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "minmax(50px, 1fr) takes the rest"))
    (let c2 _ (call grid d 4))
    (expr (call at d c2 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4069000000000000) (float 0x0000000000000000) "minmax stops at its maximum"))
    (expr (call at d c2 1 (float 0x4069000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "second minmax stops at its maximum"))
    (let c3 _ (call grid d 5))
    (expr (call at d c3 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "minmax(100px, 1fr) is not squeezed below 100px"))
    (expr (call at d c3 1 (float 0x4059000000000000) (float 0x0000000000000000) (float 0x4034000000000000) (float 0x0000000000000000) "the other fr gets what is left"))))
  (fn testFill (params (d (ref Dom)) (w f32) (n int) (msg string)) _ (block
    (let g _ (call grid d 6))
    (let tw _ (/ (- w (* (float 0x4010000000000000) (call f32 (- n 1)))) (call f32 n)))
    (if (< w (float 0x4051000000000000)) (block
      (= tw (float 0x4050000000000000))))
    (let nd _ (& (index (. (. d nodes) items) g)))
    (expr (call near (. nd w) w (interp msg ": grid width")))
    (expr (call at d g 0 (float 0x0000000000000000) (float 0x0000000000000000) tw (float 0x4034000000000000) (interp msg ": first")))
    (if (> n 1) (block
      (expr (call at d g 1 (+ tw (float 0x4010000000000000)) (float 0x0000000000000000) tw (float 0x4034000000000000) (interp msg ": second")))))
    (expr (call at d g 5 (* (call f32 (% 5 n)) (+ tw (float 0x4010000000000000))) (* (call f32 (/ 5 n)) (float 0x4038000000000000)) tw (float 0x4034000000000000) (interp msg ": last wraps by the count")))))
  (fn testFit (params (d (ref Dom))) _ (block
    (let e _ (call grid d 7))
    (expr (call at d e 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4062c00000000000) (float 0x4034000000000000) "auto-fit: the empty tracks collapse, the others stretch"))
    (expr (call at d e 1 (float 0x4062c00000000000) (float 0x0000000000000000) (float 0x4062c00000000000) (float 0x4034000000000000) "auto-fit: second"))
    (let e2 _ (call grid d 8))
    (expr (call at d e2 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4049000000000000) (float 0x4034000000000000) "auto-fill keeps the empty tracks"))
    (expr (call at d e2 1 (float 0x4049000000000000) (float 0x0000000000000000) (float 0x4049000000000000) (float 0x4034000000000000) "auto-fill: second"))))
  (fn testPlacement (params (d (ref Dom))) _ (block
    (let f _ (call grid d 9))
    (expr (call at d f 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x406a400000000000) (float 0x4034000000000000) "span 2 includes the gap"))
    (expr (call at d f 1 (float 0x406b800000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "auto item takes the next free cell"))
    (expr (call at d f 2 (float 0x405b800000000000) (float 0x403e000000000000) (float 0x406a400000000000) (float 0x4034000000000000) "2 / 4 starts left of the cursor: next row"))
    (expr (call at d f 3 (float 0x0000000000000000) (float 0x404e000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "auto item skips the occupied cells and wraps"))
    (expr (call at d f 4 (float 0x0000000000000000) (float 0x403e000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "fixed row and column are placed first"))
    (expr (call near (. (index (. (. d nodes) items) f) h) (float 0x4054000000000000) "three rows with gaps"))
    (let g _ (call grid d 10))
    (expr (call at d g 1 (float 0x4062c00000000000) (float 0x0000000000000000) (float 0x4049000000000000) (float 0x403e000000000000) "implicit column and auto-rows size"))
    (expr (call near (. (index (. (. d nodes) items) g) h) (float 0x403e000000000000) "implicit row height"))
    (let h _ (call grid d 11))
    (expr (call at d h 1 (float 0x0000000000000000) (float 0x4034000000000000) (float 0x404e000000000000) (float 0x4034000000000000) "column flow fills the rows first"))
    (expr (call at d h 2 (float 0x404e000000000000) (float 0x0000000000000000) (float 0x404e000000000000) (float 0x4034000000000000) "column flow: next column"))
    (expr (call at d h 4 (float 0x405e000000000000) (float 0x0000000000000000) (float 0x404e000000000000) (float 0x4034000000000000) "column flow: third column"))
    (let dn _ (call grid d 12))
    (expr (call at d dn 1 (float 0x0000000000000000) (float 0x4034000000000000) (float 0x4059000000000000) (float 0x4034000000000000) "dense: the second span wraps"))
    (expr (call at d dn 2 (float 0x4059000000000000) (float 0x0000000000000000) (float 0x4049000000000000) (float 0x4034000000000000) "dense fills the hole"))
    (let sp _ (call grid d 13))
    (expr (call at d sp 2 (float 0x4059000000000000) (float 0x4034000000000000) (float 0x4049000000000000) (float 0x4034000000000000) "sparse leaves the hole"))
    (let k _ (call grid d 14))
    (expr (call at d k 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4062c00000000000) (float 0x0000000000000000) "item spanning two auto tracks"))
    (expr (call at d k 1 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4044000000000000) (float 0x0000000000000000) "spanned tracks share the extra: first"))
    (expr (call at d k 2 (float 0x4054000000000000) (float 0x0000000000000000) (float 0x403e000000000000) (float 0x0000000000000000) "spanned tracks share the extra: second starts at 80"))))
  (fn testEdges (params (d (ref Dom))) _ (block
    (let z _ (call grid d 18))
    (expr (call at d z 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4050000000000000) (float 0x4034000000000000) "zero-width container still has one track"))
    (expr (call at d z 1 (float 0x0000000000000000) (float 0x4034000000000000) (float 0x4050000000000000) (float 0x4034000000000000) "zero-width container: next item wraps"))
    (let s _ (call grid d 19))
    (expr (call at d s 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4072c00000000000) (float 0x4034000000000000) "span past the explicit grid"))
    (expr (call at d s 1 (float 0x4069000000000000) (float 0x4034000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "implicit tracks took the spanning item's extra, evenly"))
    (let neg _ (call grid d 20))
    (expr (call at d neg 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "negative lines past the start clamp to the first line"))
    (expr (call near (. (index (. (. d nodes) items) (call grid d 21)) h) (float 0x0000000000000000) "an empty grid with columns has no height"))
    (let same _ (call grid d 22))
    (expr (call at d same 0 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "items in one cell overlap: first"))
    (expr (call at d same 1 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "items in one cell overlap: second"))
    (let fr _ (call grid d 23))
    (expr (call at d fr 1 (float 0x0000000000000000) (float 0x4034000000000000) (float 0x406f400000000000) (float 0x0000000000000000) "fr tracks grow to a spanning item's minimum: first"))
    (expr (call at d fr 2 (float 0x406f400000000000) (float 0x4034000000000000) (float 0x406f400000000000) (float 0x0000000000000000) "fr tracks grow to a spanning item's minimum: second"))
    (expr (call at d (call grid d 24) 1 (float 0x4062c00000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "minmax(auto, 1fr) is not squeezed below its content"))
    (expr (call at d (call grid d 25) 1 (float 0x4059000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x0000000000000000) "minmax(auto, 1fr) shares when the content fits"))))
  (fn (doc "`n` items in `cls`, timed: the grid's last item, laid out at width 600.") bigFrame (params (d (ref Dom)) (n int) (cls string)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call node d 0 "host"))
    (expr (call node d 0 cls))
    (for q (.. 0 n) (block
      (expr (call leaf d 0 "i"))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn micros (params) int (block
    (let ts (array 2 int) (array-lit 0 0))
    (expr (syscall 228 1 (& (index ts 0))))
    (return (+ (* (index ts 0) 1000000) (/ (index ts 1) 1000)))))
  (fn (doc "1000 inventory slots and a 10000-row implicit grid must lay out in linear time (no per-item scans of the table).") testScale (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let t0 _ (call micros))
    (expr (call bigFrame (& d) 1000 "gbig"))
    (let t1 _ (call micros))
    (let g _ (call grid (& d) 0))
    (expr (call at (& d) g 999 (float 0x4080840000000000) (float 0x40a7400000000000) (float 0x4051e00000000000) (float 0x4034000000000000) "1000-slot inventory: last slot"))
    (expr (call bigFrame (& d) 10000 "grows"))
    (let t2 _ (call micros))
    (let g2 _ (call grid (& d) 0))
    (expr (call at (& d) g2 9999 (float 0x0000000000000000) (float 0x4108696000000000) (float 0x4082c00000000000) (float 0x4034000000000000) "10000-row implicit grid: last row"))
    (expr (call printLn (interp "grid scale: 1000 auto-fill items " (- t1 t0) " us, 10000 implicit rows " (- t2 t1) " us")))
    (+= CHECKS 1)
    (if (|| (> (- t1 t0) 500000) (> (- t2 t1) 1500000)) (block
      (expr (call panic "grid layout of 1000 / 10000 items is too slow"))))))
