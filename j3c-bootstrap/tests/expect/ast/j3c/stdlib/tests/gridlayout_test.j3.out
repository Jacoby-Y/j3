    (expr (call leaf d 5 "i"))
    (expr (call (. d close)))
    (expr (call node d 7 "ge"))
    (expr (call leaf d 0 "i"))
    (expr (call leaf d 1 "i"))
    (expr (call (. d close)))
    (expr (call node d 8 "ge2"))
    (expr (call leaf d 0 "i"))
    (expr (call leaf d 1 "i"))
    (expr (call (. d close)))
    (expr (call node d 9 "gf"))
    (expr (call leaf d 0 "i s2"))
    (expr (call leaf d 1 "i"))
    (expr (call leaf d 2 "i p"))
