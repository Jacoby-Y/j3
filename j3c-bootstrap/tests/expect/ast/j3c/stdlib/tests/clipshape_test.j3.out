(file (module clipshape_test)
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.paint)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CHECKS int _)
  (mod-let KIDS (array 5 int) _)
  (const W int 600)
  (const H int 400)
  (const (doc "Scenario cells centered at (100, 100), (300, 100), (500, 100); every box is 100x100 and turns about its center. `.k` is the red\ncontent, bigger than any box; the box itself paints nothing, so black means clipped.") SHEET string ".stage { display: block; width: 600px; height: 400px; } .o { position: absolute; top: 50px; width: 100px; height: 100px; overflow: hidden; transform: rotate(45deg); } .a { left: 50px; } .b { left: 250px; } .c { left: 450px; overflow-x: clip; overflow-y: visible; } .d { left: 50px; top: 250px; } .d2 { width: 100px; height: 100px; overflow: hidden; transform: rotate(-30deg); } .d3 { width: 60px; height: 60px; margin: 20px; overflow: hidden; transform: rotate(20deg); } .z { position: absolute; left: -100px; top: -100px; width: 300px; height: 300px; z-index: 1; background: #ff0000; } .kc { width: 20px; height: 8px; margin: 1px; background: #00ff00; } .in { width: 100px; height: 100px; overflow: hidden; transform: rotate(-30deg); } .k { width: 300px; height: 300px; background: #ff0000; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn box (params (d (ref Dom)) (slot int) (cls string)) int (block
    (let id _ (call (. d open) slot (call (. d tag) "div") 1))
    (expr (call (. d clsDyn) id cls))
    (return id)))
  (fn build (params (d (ref Dom))) _ (block
    (expr (call box d 0 "stage"))
    (expr (call box d 0 "o a"))
    (= (index KIDS 0) (call box d 0 "k"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 1 "o b"))
    (expr (call box d 0 "in"))
    (= (index KIDS 1) (call box d 0 "k"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 2 "o c"))
    (= (index KIDS 2) (call box d 0 "k"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call box d 3 "o d"))
    (expr (call box d 0 "d2"))
    (expr (call box d 0 "d3"))
    (= (index KIDS 3) (call box d 0 "z"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))))
  (fn frame (params (d (ref Dom)) (px f32) (py f32) (pixels (slice u8))) _ (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. d simInput) px py (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
    (expr (call build d))
    (expr (call (. d layout)))
    (expr (call (. d paintAll)))
    (expr (call (. d endFrame)))
    (expr (call ok (call (. game readWindow) pixels) "read the frame"))))
  (fn (doc "The pointer at `(x, y)` (two frames: the hit test reads the last layout): the pixel is red or black, and the red content is hit or not.") at (params (d (ref Dom)) (pixels (slice u8)) (x int) (y int) (red bool) (kid int) (msg string)) _ (block
    (expr (call frame d (call f32 x) (call f32 y) pixels))
    (expr (call frame d (call f32 x) (call f32 y) pixels))
    (let i _ (* (+ (* y W) x) 4))
    (let r _ (call int (index pixels i)))
    (expr (call ok (if-expr red (> r 250) (< r 5)) (interp "paint: " msg " (red " r ")")))
    (expr (call ok (== (== (. d hover) (index KIDS kid)) red) (interp "hit: " msg)))))
  (fn (doc "A `<canvas>` body is `pushView` + `pushIdentity`: the turned clip around it stays in place on screen.") testCanvas (params (pixels (slice u8))) _ (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint pushXform) (struct-lit Vec2 (field x (float 0x4059000000000000)) (field y (float 0x4059000000000000))) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000))) (float 0x3fe921fafc8b007a) (float 0x3ff0000000000000)))
    (expr (call (. paint pushClip) (struct-lit Vec2 (field x (float 0x4049000000000000)) (field y (float 0x4049000000000000))) (struct-lit Vec2 (field x (float 0x4059000000000000)) (field y (float 0x4059000000000000)))))
    (expr (call (. paint pushView) (struct-lit Vec2 (field x (float 0x404e000000000000)) (field y (float 0x4044000000000000))) (struct-lit Vec2 (field x (float 0x4069000000000000)) (field y (float 0x4069000000000000)))))
    (expr (call (. paint pushIdentity)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000))) (struct-lit Vec2 (field x (float 0x4069000000000000)) (field y (float 0x4069000000000000))) (struct-lit Color (field r 255) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint popTransform)))
    (expr (call (. paint popView)))
    (expr (call (. paint popClip)))
    (expr (call (. paint popTransform)))
    (expr (call (. paint flush)))
    (expr (call ok (call (. game readWindow) pixels) "read the canvas frame"))
    (let c _ (* (+ (* 100 W) 100) 4))
    (expr (call ok (> (index pixels c) 250) "canvas content shows in the middle of the turned clip"))
    (let k _ (* (+ (* 150 W) 150) 4))
    (expr (call ok (< (index pixels k) 5) "canvas content does not leak into the corner of the bounding box"))
    (let e _ (* (+ (* 100 W) 165) 4))
    (expr (call ok (> (index pixels e) 250) "canvas content shows inside the diamond near its tip"))))
  (fn micros (params) int (block
    (return (call (. game micros)))))
  (fn (doc "Cost of repainting a turned overflow box with 300 children, for the report.") bench (params (d (ref Dom)) (pixels (slice u8))) _ (block
    (let t0 _ (call micros))
    (for i (.. 0 60) (block
      (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
      (expr (call box d 0 "stage"))
      (expr (call box d 0 "o a"))
      (for j (.. 0 300) (block
        (expr (call box d j "kc"))
        (expr (call (. d close)))))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call (. d layout)))
      (expr (call (. d paintAll)))
      (expr (call (. d endFrame)))))
    (expr (call (. game readWindow) pixels))
    (expr (call printLn (interp "turned overflow box, 300 children: " (/ (- (call micros) t0) 60) " us per frame")))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call (. game initGlHidden) "clip shapes" W H))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "clipshape.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "fixture CSS parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let pixels _ (call (. mem alloc) (targs u8) (* (* W H) 4)))
    (expr (call at (& d) pixels 100 100 (bool true) 0 "centre of a turned clip shows"))
    (expr (call at (& d) pixels 150 100 (bool true) 0 "inside the diamond shows"))
    (expr (call at (& d) pixels 150 150 (bool false) 0 "a corner of the bounding box does not leak"))
    (expr (call at (& d) pixels 55 145 (bool false) 0 "the opposite corner does not leak either"))
    (expr (call at (& d) pixels 320 110 (bool true) 1 "inside both clips shows"))
    (expr (call at (& d) pixels 332 156 (bool false) 1 "inside the inner clip but outside the outer one is cut"))
    (expr (call at (& d) pixels 360 100 (bool false) 1 "inside the outer clip but outside the inner one is cut"))
    (expr (call at (& d) pixels 500 100 (bool true) 2 "x-only clip shows its centre"))
    (expr (call at (& d) pixels 429 171 (bool true) 2 "x-only clip lets the content past the turned top and bottom edge"))
    (expr (call at (& d) pixels 571 171 (bool false) 2 "x-only clip cuts past the turned side edge"))
    (expr (call at (& d) pixels 120 310 (bool true) 3 "inside all three turned clips shows (z-indexed child)"))
    (expr (call at (& d) pixels 145 300 (bool false) 3 "inside the two outer clips but outside the inner one is cut (z-indexed child)"))
    (expr (call at (& d) pixels 100 380 (bool false) 3 "far outside is cut (z-indexed child)"))
    (expr (call testCanvas pixels))
    (expr (call bench (& d) pixels))
    (expr (call printLn (interp "clipshape_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
