    (expr (call is (call window 1 (float 0x4034000000000000) (float 0x40d36f0000000000) (float 0x4059000000000000) 4) 0 1 "shrunk to one row"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x0000000000000000) (float 0x0000000000000000) 4) 0 4 "zero-height viewport"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x0000000000000000) (float 0x406e000000000000) 4) 0 16 "first frame uses the fallback height"))
    (expr (call is (call window 100000 (float 0x403a000000000000) (float 0x4133d62000000000) (float 0x4069000000000000) 4) 49996 50012 "100000 rows, middle"))
