(file (module virt_test)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.memory (names Arena List))
  (use j3.ui.virt (names follow Tree window windowTree Win))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "virt_test"))))))
  (fn is (params (w Win) (lo int) (hi int) (msg string)) _ (block
    (if (|| (!= (. w lo) lo) (!= (. w hi) hi)) (block
      (expr (call printLn (interp "FAIL: " msg ": got " (. w lo) ".." (. w hi) ", want " lo ".." hi)))
      (expr (call panic "virt_test"))))))
  (fn close (params (a f32) (b f32)) bool (block
    (return (&& (< (- a b) (float 0x3ff0000000000000)) (< (- b a) (float 0x3ff0000000000000))))))
  (fn near (params (a f32) (b f32)) bool (block
    (return (&& (< (- a b) (float 0x3f847ae147ae147b)) (< (- b a) (float 0x3f847ae147ae147b))))))
  (fn (doc "Reference: px above row `i` by walking every row (what the tree must equal).") walk (params (h (slice f32)) (n int) (i int) (avg f32)) f32 (block
    (let sum f32 (float 0x0000000000000000))
    (for r (.. 0 i) (block
      (+= sum (if-expr (>= (index h r) (float 0x0000000000000000)) (index h r) avg))))
    (return sum)))
  (fn trees (params) _ (block
    (let arena _ (call (. Arena create) 16777216))
    (let mem _ (& arena))
    (let t _ (call (. Tree new) mem (float 0x4044000000000000)))
    (expr (call (. t reset) 10))
    (expr (call ok (&& (&& (call near (call (. t total)) (float 0x4079000000000000)) (call near (call (. t prefix) 3) (float 0x405e000000000000))) (call near (call (. t avg)) (float 0x4044000000000000))) "unmeasured rows are the estimate"))
    (expr (call ok (&& (&& (&& (&& (== (call (. t find) (float 0x0000000000000000)) 0) (== (call (. t find) (float 0x4043f33333333333)) 0)) (== (call (. t find) (float 0x4044000000000000)) 1)) (== (call (. t find) (float 0x4078f00000000000)) 9)) (== (call (. t find) (float 0x40b3880000000000)) 9)) "find on estimates"))
    (expr (call ok (&& (call (. t set) 0 (float 0x4059000000000000)) (call (. t set) 1 (float 0x4034000000000000))) "set reports a change"))
    (expr (call ok (! (call (. t set) 1 (float 0x4034028f5c28f5c3))) "a change under 0.05 px is not one"))
    (expr (call ok (&& (call near (call (. t avg)) (float 0x404e000000000000)) (call near (call (. t total)) (float 0x4082c00000000000))) "the mean of the measured rows replaces the estimate"))
    (expr (call ok (&& (&& (&& (call near (call (. t prefix) 0) (float 0x0000000000000000)) (call near (call (. t prefix) 1) (float 0x4059000000000000))) (call near (call (. t prefix) 2) (float 0x405e000000000000))) (call near (call (. t prefix) 5) (float 0x4072c00000000000))) "prefix mixes measured and unmeasured"))
    (expr (call ok (&& (&& (&& (&& (== (call (. t find) (float 0x4058f9999999999a)) 0) (== (call (. t find) (float 0x4059000000000000)) 1)) (== (call (. t find) (float 0x405df9999999999a)) 1)) (== (call (. t find) (float 0x405e000000000000)) 2)) (== (call (. t find) (float 0x4082b80000000000)) 9)) "find follows measured heights"))
    (let n _ 1000)
    (let h _ (call (. mem alloc) (targs f32) n))
    (expr (call (. t reset) n))
    (for u (.. 0 n) (block
      (= (index h u) (- (float 0x3ff0000000000000)))))
    (let seed _ 7)
    (let sum f32 (float 0x0000000000000000))
    (let known _ 0)
    (for k (.. 0 300) (block
      (= seed (% (+ (* seed 1103515245) 12345) 2147483648))
      (let ri _ (% seed n))
      (let v _ (call f32 (+ 1 (% (/ seed 7) 90))))
      (if (< (index h ri) (float 0x0000000000000000)) (block
        (+= known 1)
        (+= sum v)) (block
        (+= sum (- v (index h ri)))))
      (= (index h ri) v)
      (expr (call (. t set) ri v))))
    (let avg _ (/ sum (call f32 known)))
    (expr (call ok (call close (call (. t avg)) avg) "avg over 300 measured rows"))
    (let allOk _ (bool true))
    (for p1 (.. 0 (+ n 1)) (block
      (if (! (&& (< (- (call (. t prefix) p1) (call walk h n p1 avg)) (float 0x3fe0000000000000)) (< (- (call walk h n p1 avg) (call (. t prefix) p1)) (float 0x3fe0000000000000)))) (block
        (= allOk (bool false))))))
    (expr (call ok allOk "prefix equals a walk over every row"))
    (let findOk _ (bool true))
    (for p2 (.. 0 n) (block
      (let mid _ (+ (call walk h n p2 avg) (/ (- (call walk h n (+ p2 1) avg) (call walk h n p2 avg)) (float 0x4000000000000000))))
      (if (!= (call (. t find) mid) p2) (block
        (= findOk (bool false))))))
    (expr (call ok findOk "find returns the row at the middle of every row"))
    (expr (call ok (call close (call (. t total)) (call walk h n n avg)) "total equals the walk"))
    (let from _ (call (. (type-path List int) new) mem))
    (for q (.. 0 100) (block
      (expr (call (. from push) (- 1)))))
    (for q (.. 0 n) (block
      (expr (call (. from push) q))))
    (let before _ (call (. t prefix) 500))
    (expr (call (. t remap) (& from)))
    (expr (call ok (&& (== (. t n) (+ n 100)) (== (call (. t isKnown) (+ 100 500)) (>= (index h 500) (float 0x0000000000000000)))) "remap keeps heights with their rows"))
    (expr (call ok (&& (! (call (. t isKnown) 0)) (! (call (. t isKnown) 99))) "remap: new rows are unmeasured"))
    (expr (call ok (call close (- (call (. t prefix) 600) (call (. t prefix) 100)) before) "remap: the rows after the 100 new ones keep their offsets"))
    (expr (call ok (call close (call (. t avg)) avg) "the mean survives a remap"))
    (let from2 _ (call (. (type-path List int) new) mem))
    (for q (.. 0 10) (block
      (expr (call (. from2 push) (* q 2)))))
    (expr (call (. t remap) (& from2)))
    (expr (call ok (== (. t n) 10) "remap to fewer rows"))
    (expr (call (. t reset) 0))
    (expr (call ok (&& (&& (== (call (. t total)) (float 0x0000000000000000)) (== (call (. t find) (float 0x4014000000000000)) 0)) (== (call (. t prefix) 0) (float 0x0000000000000000))) "empty tree"))
    (expr (call (. t reset) 3))
    (expr (call (. t set) 0 (float 0x4024000000000000)))
    (expr (call (. t set) 1 (float 0x4034000000000000)))
    (expr (call (. t set) 2 (float 0x403e000000000000)))
    (expr (call (. t append) 1))
    (expr (call ok (&& (&& (&& (== (. t n) 4) (call near (call (. t prefix) 3) (float 0x404e000000000000))) (call near (call (. t total)) (float 0x4054000000000000))) (! (call (. t isKnown) 3))) "append: one unmeasured row at the end"))
    (expr (call (. t append) 100))
    (expr (call ok (&& (&& (&& (== (. t n) 104) (call near (call (. t prefix) 3) (float 0x404e000000000000))) (call near (call (. t total)) (call f32 (+ 60 (* 101 20))))) (== (call (. t find) (call f32 (+ 60 (* 20 50)))) 53)) "append: many rows, the mean is unchanged"))
    (expr (call (. t set) 103 (float 0x4014000000000000)))
    (expr (call ok (&& (call near (call (. t prefix) 103) (float 0x409a540000000000)) (call near (call (. t prefix) 104) (call (. t total)))) "append: a new row can be measured"))
    (expr (call (. t reset) 10))
    (for p3 (.. 0 10) (block
      (expr (call (. t set) p3 (float 0x4059000000000000)))))
    (let w _ (call windowTree (& t) (float 0x4072c00000000000) (float 0x406f400000000000) 1))
    (expr (call ok (&& (&& (&& (== (. w lo) 2) (== (. w hi) 7)) (call near (. w top) (float 0x4069000000000000))) (call near (. w bottom) (float 0x4072c00000000000))) "windowTree: rows 3..5 visible plus one each side"))
    (let e _ (call windowTree (& t) (float 0x40f869f000000000) (float 0x406f400000000000) 1))
    (expr (call ok (&& (&& (&& (== (. e lo) 6) (== (. e hi) 10)) (call near (. e top) (float 0x4082c00000000000))) (call near (. e bottom) (float 0x0000000000000000))) "windowTree clamps a scroll past the end"))
    (let z _ (call windowTree (& t) (float 0x0000000000000000) (float 0x406f400000000000) 0))
    (expr (call ok (&& (== (. z lo) 0) (== (. z hi) 3)) "windowTree at the top, no overscan"))
    (let p3 _ (call (. t prefix) 3))
    (expr (call (. t set) 1 (float 0x4062c00000000000)))
    (expr (call ok (&& (&& (call near (call (. t prefix) 1) (float 0x4059000000000000)) (call near (call (. t prefix) 3) (+ p3 (float 0x4049000000000000)))) (call near (call (. t total)) (float 0x4090680000000000))) "a measured row moves only the rows below it"))))
  (fn followed (params (y f32) (last f32) (shift f32) (total f32) (view f32) (stick bool) (want bool) (wantY f32) (wantStick bool) (msg string)) _ (block
    (let f _ (call follow y last shift total view stick want))
    (if (|| (! (call near (. f y) wantY)) (!= (. f stick) wantStick)) (block
      (expr (call printLn (interp "FAIL: " msg ": got y " (. f y) " stick " (. f stick) ", want y " wantY " stick " wantStick)))
      (expr (call panic "virt_test"))))))
  (fn follows (params) _ (block
    (expr (call followed (float 0x407f400000000000) (float 0x407f400000000000) (float 0x405e000000000000) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x4083600000000000) (bool false) "rows above grew by 120"))
    (expr (call followed (float 0x407f400000000000) (float 0x407f400000000000) (call f32 (- 0 120)) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x4077c00000000000) (bool false) "rows above shrank by 120"))
    (expr (call followed (float 0x4049000000000000) (float 0x4049000000000000) (call f32 (- 0 120)) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x0000000000000000) (bool false) "never below 0"))
    (expr (call followed (float 0x409bf80000000000) (float 0x409bf80000000000) (float 0x4049000000000000) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x409c200000000000) (bool false) "never past the end"))
    (expr (call followed (float 0x407f400000000000) (float 0x407e000000000000) (float 0x0000000000000000) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x407f400000000000) (bool false) "the user scrolled 20 px: kept, no shift"))
    (expr (call followed (float 0x407f400000000000) (float 0x407e000000000000) (float 0x403e000000000000) (float 0x409f400000000000) (float 0x4069000000000000) (bool false) (bool false) (float 0x4080900000000000) (bool false) "user scroll and a shift add up"))
    (expr (call followed (float 0x409c200000000000) (float 0x409c200000000000) (float 0x0000000000000000) (float 0x40a1f80000000000) (float 0x4069000000000000) (bool true) (bool true) (float 0x40a0680000000000) (bool true) "an append moves the end: follow it"))
    (expr (call followed (float 0x409c200000000000) (float 0x409c200000000000) (float 0x4053400000000000) (float 0x40a1f80000000000) (float 0x4069000000000000) (bool true) (bool true) (float 0x40a0680000000000) (bool true) "stuck: the anchor shift is ignored"))
    (expr (call followed (float 0x409bf80000000000) (float 0x409c200000000000) (float 0x0000000000000000) (float 0x409f400000000000) (float 0x4069000000000000) (bool true) (bool true) (float 0x409bf80000000000) (bool false) "10 px up from the end is a release"))
