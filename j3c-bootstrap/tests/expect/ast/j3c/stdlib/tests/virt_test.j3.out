    (expr (call followed (float 0x40a1f80000000000) (float 0x409a900000000000) (float 0x0000000000000000) (float 0x40a3880000000000) (float 0x4069000000000000) (bool false) (bool true) (float 0x40a1f80000000000) (bool true) "scrolled back to the end: stuck again"))
    (expr (call followed (float 0x40a1f70000000000) (float 0x409a900000000000) (float 0x0000000000000000) (float 0x40a3880000000000) (float 0x4069000000000000) (bool false) (bool true) (float 0x40a1f80000000000) (bool true) "within 1 px of the end counts"))
    (expr (call followed (float 0x409c200000000000) (float 0x409c200000000000) (float 0x0000000000000000) (float 0x409f400000000000) (float 0x4079000000000000) (bool true) (bool true) (float 0x4099000000000000) (bool true) "a taller box lowers the end: still stuck"))
    (expr (call followed (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4069000000000000) (bool true) (bool true) (float 0x0000000000000000) (bool true) "content shorter than the box"))
    (expr (call followed (float 0x409c200000000000) (float 0x409c200000000000) (float 0x0000000000000000) (float 0x40a1f80000000000) (float 0x4069000000000000) (bool true) (bool false) (float 0x409c200000000000) (bool false) "without the attribute nothing sticks"))))
  (fn main (params) _ (block
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x0000000000000000) (float 0x4059000000000000) 4) 0 9 "top: overscan only below"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x409f400000000000) (float 0x4059000000000000) 4) 96 109 "middle: rows 100..105 visible"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x409f680000000000) (float 0x4059000000000000) 4) 96 110 "middle, mid-row offset"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x40d36f0000000000) (float 0x4059000000000000) 4) 991 1000 "end: overscan clamped at count"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x40f869f000000000) (float 0x4059000000000000) 4) 991 1000 "scrolled past the end is clamped"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (- (float 0x4049000000000000)) (float 0x4059000000000000) 4) 0 9 "negative scroll is clamped"))
    (expr (call is (call window 1000 (float 0x4034000000000000) (float 0x4044000000000000) (float 0x4059000000000000) 0) 2 7 "no overscan"))
    (expr (call is (call window 0 (float 0x4034000000000000) (float 0x0000000000000000) (float 0x4059000000000000) 4) 0 0 "empty list"))
