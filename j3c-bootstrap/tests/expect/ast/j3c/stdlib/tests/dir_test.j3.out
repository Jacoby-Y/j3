(file (module dir_test)
  (use j3.io)
  (use j3.io (names DirEntry IoError printLn))
  (use j3.memory (names Arena newArena))
  (use j3.result.Result)
  (use j3.proc)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.text.cstr)
  (use j3.thread)
  (use j3.thread.Thread)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn mk (params (p string)) bool (block
    (match (call (. io makeDirs) p)
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn mv (params (a string) (b string)) bool (block
    (match (call (. io rename) a b)
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn rm (params (p string)) bool (block
    (match (call (. io remove) p)
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn list (params (path string) (a (ref Arena))) (slice DirEntry) (block
    (match (call (. io listDir) path a)
      (arm (pats (variant Result.Ok (bind es))) (block
        (return es)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "listDir failed")))))
    (return (call (. a alloc) (targs DirEntry) 0))))
  (fn find (params (es (slice DirEntry)) (name string)) int (block
    (for i (.. 0 (. es len)) (block
      (if (call eq (. (index es i) name) name) (block
        (return i)))))
    (return (- 1))))
  (fn worker (params (arg ptr)) _ (block
    (let a _ (call newArena 65536))
    (let es _ (call list "/tmp/j3_dir_test/x" (& a)))
    (expr (call ok (>= (call find es "y") 0) "worker sees y"))))
  (fn sh (params (cmd string) (a (ref Arena))) _ (block
    (match (call (. proc run) (array-lit "/bin/sh" "-c" cmd) "" a)
      (arm (pats (variant Result.Ok (bind o))) (block
        (expr (call ok (== (. o code) 0) cmd))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) cmd)))))))
  (fn st (params (follow bool) (path string) (out (slice int))) bool (block
    (let p _ (as (call cstr path) ptr))
    (= (index out 3) 7)
    (let r _ (if-expr follow (call (. sys statAt) (. sys AT_FDCWD) p out) (call (. sys lstatAt) (. sys AT_FDCWD) p out)))
    (return (>= r 0))))
  (fn symlinks (params (a (ref Arena))) _ (block
    (expr (call sh "rm -rf /tmp/j3_dir_test/lt && mkdir -p /tmp/j3_dir_test/lt/d && cd /tmp/j3_dir_test/lt && printf 'hello\\n' > f && ln -s f lf && ln -s d ld && ln -s /no/such/target broken" a))
    (let s (array 4 int) (array-lit 0 0 0 0))
    (expr (call ok (&& (&& (&& (call st (bool false) "/tmp/j3_dir_test/lt/lf" (slice-expr s _ _)) (== (index s 0) 0)) (== (index s 1) 1)) (== (index s 3) 1)) "lstat lf"))
    (expr (call ok (&& (&& (&& (call st (bool false) "/tmp/j3_dir_test/lt/ld" (slice-expr s _ _)) (== (index s 0) 0)) (== (index s 1) 1)) (== (index s 3) 1)) "lstat ld"))
    (expr (call ok (&& (&& (call st (bool true) "/tmp/j3_dir_test/lt/ld" (slice-expr s _ _)) (== (index s 0) 1)) (== (index s 3) 0)) "stat ld"))
    (expr (call ok (&& (&& (call st (bool false) "/tmp/j3_dir_test/lt/broken" (slice-expr s _ _)) (== (index s 1) 15)) (== (index s 3) 1)) "lstat broken"))
    (expr (call ok (! (call st (bool true) "/tmp/j3_dir_test/lt/broken" (slice-expr s _ _))) "stat broken fails"))
    (expr (call ok (&& (&& (&& (call st (bool false) "/tmp/j3_dir_test/lt/f" (slice-expr s _ _)) (== (index s 0) 0)) (== (index s 1) 6)) (== (index s 3) 0)) "lstat f"))
    (expr (call ok (&& (&& (&& (call st (bool true) "/tmp/j3_dir_test/lt/f" (slice-expr s _ _)) (== (index s 0) 0)) (== (index s 1) 6)) (== (index s 3) 0)) "stat f"))
    (let three (array 3 int) (array-lit 0 0 0))
    (expr (call ok (&& (>= (call (. sys lstatAt) (. sys AT_FDCWD) (as (call cstr "/tmp/j3_dir_test/lt/lf") ptr) (slice-expr three _ _)) 0) (== (index three 1) 1)) "3-slot lstat"))
    (let es _ (call list "/tmp/j3_dir_test/lt" a))
    (expr (call ok (== (. es len) 5) "five lt entries"))
    (expr (call ok (&& (. (index es (call find es "lf")) isLink) (== (. (index es (call find es "lf")) size) 6)) "listDir lf"))
    (expr (call ok (&& (. (index es (call find es "ld")) isLink) (. (index es (call find es "ld")) isDir)) "listDir ld"))
    (expr (call ok (. (index es (call find es "broken")) isLink) "listDir broken"))
    (expr (call ok (&& (! (. (index es (call find es "f")) isLink)) (! (. (index es (call find es "d")) isLink))) "listDir plain"))
    (match (call (. io lstat) "/tmp/j3_dir_test/lt/ld")
      (arm (pats (variant Result.Ok (bind e))) (block
        (expr (call ok (&& (&& (. e isLink) (! (. e isDir))) (== (. e size) 1)) "io.lstat ld"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "io.lstat ld")))))
    (match (call (. io stat) "/tmp/j3_dir_test/lt/ld")
      (arm (pats (variant Result.Ok (bind e))) (block
        (expr (call ok (&& (! (. e isLink)) (. e isDir)) "io.stat ld"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "io.stat ld")))))
    (expr (call sh "rm -rf /tmp/j3_dir_test/lt" a))))
  (fn main (params) _ (block
    (let a _ (call newArena 1048576))
    (expr (call ok (call mk "/tmp/j3_dir_test/x/y/z") "makeDirs"))
    (expr (call ok (call mk "/tmp/j3_dir_test/x/y/z/") "makeDirs again"))
    (expr (call (. io writeFile) "/tmp/j3_dir_test/x/f.txt" (as "hello" (slice u8))))
    (expr (call ok (! (call mk "/tmp/j3_dir_test/x/f.txt")) "makeDirs over a file"))
    (let es _ (call list "/tmp/j3_dir_test/x" (& a)))
    (expr (call ok (== (. es len) 2) "two entries"))
    (expr (call ok (&& (< (call find es ".") 0) (< (call find es "..") 0)) "no dot entries"))
    (let f _ (call find es "f.txt"))
    (expr (call ok (&& (&& (&& (>= f 0) (! (. (index es f) isDir))) (== (. (index es f) size) 5)) (> (. (index es f) mtime) 1600000000)) "file entry"))
    (let y _ (call find es "y"))
    (expr (call ok (&& (>= y 0) (. (index es y) isDir)) "dir entry"))
    (match (call (. io stat) "/tmp/j3_dir_test/x/f.txt")
      (arm (pats (variant Result.Ok (bind e))) (block
        (expr (call ok (&& (== (. e size) 5) (! (. e isDir))) "stat file"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "stat file")))))
    (match (call (. io stat) "/tmp/j3_dir_test/nope")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "stat missing"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant IoError.NotFound)) (block))
        (arm (pats (variant IoError.Other)) (block
          (expr (call ok (bool false) "stat missing is NotFound"))))))))
    (match (call (. io listDir) "/tmp/j3_dir_test/nope" (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "listDir missing"))))
      (arm (pats (variant Result.Err (wild))) (block)))
    (expr (call ok (call mv "/tmp/j3_dir_test/x/f.txt" "/tmp/j3_dir_test/x/g.txt") "rename"))
    (expr (call ok (&& (! (call (. io exists) "/tmp/j3_dir_test/x/f.txt")) (call (. io exists) "/tmp/j3_dir_test/x/g.txt")) "renamed"))
    (expr (call ok (call rm "/tmp/j3_dir_test/x/g.txt") "remove"))
    (expr (call ok (! (call (. io exists) "/tmp/j3_dir_test/x/g.txt")) "removed"))
    (expr (call ok (! (call rm "/tmp/j3_dir_test/x/g.txt")) "remove missing"))
    (for i (.. 0 300) (block
      (expr (call (. io writeFile) (interp "/tmp/j3_dir_test/x/y/z/file_number_" i ".dat") (as "" (slice u8))))))
    (expr (call ok (== (. (call list "/tmp/j3_dir_test/x/y/z" (& a)) len) 300) "300 entries"))
    (for i (.. 0 300) (block
      (expr (call (. io remove) (interp "/tmp/j3_dir_test/x/y/z/file_number_" i ".dat")))))
    (expr (call symlinks (& a)))
    (let t _ (struct-lit Thread (field f worker)))
    (expr (call (. thread spawn) (& t) "dirw" worker (as 0 ptr)))
    (expr (call (. thread join) (& t)))
    (expr (call printLn "dir_test ok")))))
--- stderr
--- exit 0
