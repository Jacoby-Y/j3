(file (module cmp_test)
  (use j3.cmp (names Hash hashOf contains indexOf minOf maxOf combine))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (struct P
    (field x int)
    (field y int)
    (fn operator== (params (this P) (o P)) bool (block
      (return (&& (== (. this x) (. o x)) (== (. this y) (. o y))))))
    (fn operator< (params (this P) (o P)) bool (block
      (return (< (. this x) (. o x)))))
    (fn hash (params (this P)) u64 (block
      (return (call combine (call hashOf (. this x)) (call hashOf (. this y)))))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "cmp_test"))))))
  (fn main (params) _ (block
    (expr (call ok (&& (== (call hashOf 5) (call hashOf 5)) (!= (call hashOf 5) (call hashOf 6))) "int"))
    (expr (call ok (&& (&& (== (call hashOf "abc") (call hashOf "abc")) (!= (call hashOf "abc") (call hashOf "abd"))) (!= (call hashOf "") (call hashOf "a"))) "string"))
    (expr (call ok (&& (== (call hashOf (float 0x0000000000000000)) (call hashOf (- (float 0x0000000000000000)))) (!= (call hashOf (float 0x3ff8000000000000)) (call hashOf (float 0x4004000000000000)))) "float zero"))
    (expr (call ok (!= (call hashOf (bool true)) (call hashOf (bool false))) "bool"))
    (let mem _ (call (. Arena create) 4096))
    (let seen _ (call (. mem alloc) (targs int) 64))
    (for i (.. 0 64) (block
      (= (index seen i) 0)))
    (for i (.. 0 1000) (block
      (= (index seen (call int (& (call hashOf i) (call u64 63)))) 1)))
    (let n _ 0)
    (for i (.. 0 64) (block
      (+= n (index seen i))))
    (expr (call ok (> n 50) "low bits spread"))
    (expr (call ok (!= (call hashOf (struct-lit P (field x 1) (field y 2))) (call hashOf (struct-lit P (field x 2) (field y 1)))) "combine is ordered"))
    (let xs _ (call (. mem alloc) (targs int) 4))
    (= (index xs 0) 7)
    (= (index xs 1) 8)
    (= (index xs 2) 9)
    (= (index xs 3) 8)
    (expr (call ok (&& (&& (== (call indexOf xs 8) 1) (== (call indexOf xs 5) (- 1))) (call contains xs 9)) "indexOf"))
    (let ps _ (call (. mem alloc) (targs P) 2))
    (= (index ps 0) (struct-lit P (field x 1) (field y 1)))
    (= (index ps 1) (struct-lit P (field x 2) (field y 2)))
    (expr (call ok (&& (call contains ps (struct-lit P (field x 2) (field y 2))) (! (call contains ps (struct-lit P (field x 2) (field y 3))))) "contains struct"))
    (expr (call ok (&& (&& (== (call minOf 3 2) 2) (== (call maxOf 3 2) 3)) (== (call maxOf (float 0x3ff8000000000000) (float 0x4004000000000000)) (float 0x4004000000000000))) "min max"))
    (expr (call ok (== (. (call maxOf (struct-lit P (field x 1) (field y 0)) (struct-lit P (field x 5) (field y 0))) x) 5) "max struct"))
    (expr (call printLn "cmp_test ok")))))
--- stderr
--- exit 0
