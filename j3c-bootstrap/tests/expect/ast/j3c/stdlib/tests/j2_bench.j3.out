(file (module j2_bench)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Value Limits))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (const RUNS int 5)
  (fn (doc "Nanoseconds on the monotonic clock (`clock_gettime`, Linux x86-64).") nowNs (params) int (block
    (let ts (array 2 int) (array-lit 0 0))
    (expr (syscall 228 1 (as (& (index ts 0)) ptr)))
    (return (+ (* (index ts 0) 1000000000) (index ts 1)))))
  (const SRC (array 14 string) (array-lit "pub fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }" "pub fn fields(n) {" "    let p = { x: 0, y: 0, vx: 1, vy: 2 };" "    for i in 0..n { p.x = p.x + p.vx; p.y += p.vy; }" "    return p.x + p.y;" "}" "pub fn loop(n) { let s = 0; let i = 0; while i < n { if i % 3 == 0 { s += i; } i += 1; } return s; }" "pub fn strings(n) {" "    let parts = [];" "    for i in 0..n { parts.push(`item {i}`); }" "    return len(join(parts, \",\"));" "}" "pub fn update(this, dt) { this.x += this.vx * dt; this.t += dt; }" "pub fn enemy(i) { return { x: i, vx: 2, t: 0 }; }"))
  (fn load (params (vm (ref Vm)) (name string) (src string)) Value (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (bind t))) (block
        (return t)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "load")))))))
  (fn call1 (params (vm (ref Vm)) (f Value) (x int)) Value (block
    (let one (array 1 Value) (array-lit (call (. j2 int) x)))
    (match (call (. vm call) f (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (return v)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "call")))))))
  (fn (doc "Best-of-RUNS ns for `f(arg)`; checks the result against `want`.") bench (params (vm (ref Vm)) (exp Value) (name string) (arg int) (want int)) int (block
    (let f _ (call (. (call (. exp asTable)) get) name))
    (let best _ 0)
    (for r (.. 0 RUNS) (block
      (let t0 _ (call nowNs))
      (let v _ (call call1 vm f arg))
      (let dt _ (- (call nowNs) t0))
      (if (!= (. v bits) want) (block
        (expr (call panic name))))
      (if (|| (== r 0) (< dt best)) (block
        (= best dt)))))
    (return best)))
  (fn (doc "Print `label  12.345 ms` (a backtick string can't be returned: it lives in this frame).") report (params (label string) (ns int) (per int)) _ (block
    (let t _ (/ ns 1000))
    (let frac _ (% t 1000))
    (let pad _ (if-expr (< frac 10) "00" (if-expr (< frac 100) "0" "")))
    (if (> per 0) (block
      (expr (call printLn (interp label " " (/ t 1000) "." pad frac " ms (" (/ ns per) " ns each)")))) (block
      (expr (call printLn (interp label " " (/ t 1000) "." pad frac " ms")))))))
  (fn (doc "A 2000-line script: 200 functions of 10 lines (locals, arithmetic, branches, fields, calls).") genScript (params (t (ref Text))) _ (block
    (for i (.. 0 200) (block
      (expr (call (. t pushStr) "fn f"))
      (expr (call (. t pushInt) i))
      (expr (call (. t pushStr) "(a, b) {\n"))
      (expr (call (. t pushStr) "    let x = a * 2 + b;\n"))
      (expr (call (. t pushStr) "    let p = { x: x, y: b, name: \"thing\" };\n"))
      (expr (call (. t pushStr) "    if p.x > 10 { p.y = p.y - 1; } else { p.y += 3; }\n"))
      (expr (call (. t pushStr) "    for k in 0..4 { x += k * p.y; }\n"))
      (expr (call (. t pushStr) "    let s = `v={x} y={p.y}`;\n"))
      (expr (call (. t pushStr) "    while x > 100 { x = x / 2; }\n"))
      (expr (call (. t pushStr) "    if x == "))
      (expr (call (. t pushInt) i))
      (expr (call (. t pushStr) " { return f"))
      (expr (call (. t pushInt) (if-expr (> i 0) (- i 1) 0)))
      (expr (call (. t pushStr) "(x, b); }\n"))
      (expr (call (. t pushStr) "    return [x, s, p];\n"))
      (expr (call (. t pushStr) "}\n"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 4 20)))
    (let vm _ (call (. Vm new) (& mem) (struct-lit Limits (field heapBytes (<< 256 20)) (field stepsPerCall (<< 1 40)))))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (let st _ (call (. Text new) (& mem)))
    (for i (.. 0 (. SRC len)) (block
      (expr (call (. st pushStr) (index SRC i)))
      (expr (call (. st push) 10))))
    (let exp _ (call load (& vm) "bench" (call (. st str))))
    (expr (call report "fib(30)" (call bench (& vm) exp "fib" 30 832040) 0))
    (expr (call report "1M loop, table fields" (call bench (& vm) exp "fields" 1000000 3000000) 0))
    (expr (call report "1M while loop, % and if" (call bench (& vm) exp "loop" 1000000 166666833333) 0))
    (expr (call report "100k template strings + join" (call bench (& vm) exp "strings" 100000 1088889) 0))
    (let enemies _ (call (. mem alloc) (targs Value) 100))
    (let mk _ (call (. (call (. exp asTable)) get) "enemy"))
    (for i (.. 0 100) (block
      (= (index enemies i) (call call1 (& vm) mk i))
      (expr (call (. vm keep) (index enemies i)))))
    (let upd _ (call (. (call (. exp asTable)) get) "update"))
    (let dt (array 1 Value) (array-lit (call (. j2 num) (float 0x3f90624dd2f1a9fc))))
    (let best _ 0)
    (for r (.. 0 RUNS) (block
      (let t0 _ (call nowNs))
      (for i (.. 0 10000) (block
        (match (call (. vm callWithThis) upd (index enemies (% i 100)) (slice-expr dt 0 1))
          (arm (pats (variant Result.Ok (wild))) (block))
          (arm (pats (variant Result.Err (bind e))) (block
            (expr (call printLn (. e message)))
            (expr (call panic "update")))))))
      (let d _ (- (call nowNs) t0))
      (if (|| (== r 0) (< d best)) (block
        (= best d)))))
    (expr (call report "10k callWithThis" best 10000))
    (let t _ (call (. Text new) (& mem)))
    (expr (call genScript (& t)))
    (let src _ (call (. t str)))
    (let cbest _ 0)
    (for r (.. 0 RUNS) (block
      (let t0 _ (call nowNs))
      (match (call (. j2 compileChunk) (& vm) "gen" src)
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (bind e))) (block
          (expr (call printLn (. e message)))
          (expr (call panic "compile")))))
      (let d _ (- (call nowNs) t0))
      (if (|| (== r 0) (< d cbest)) (block
        (= cbest d)))))
    (expr (call report "compile 2000 lines" cbest 0))
    (expr (call printLn "j2_bench ok")))))
--- stderr
--- exit 0
