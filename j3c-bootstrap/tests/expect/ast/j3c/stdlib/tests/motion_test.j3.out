(file (module motion_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (use j3.sys.panic)
  (use j3.ui.anim)
  (use j3.ui.css (names Css MatchNode Value))
  (use j3.ui.cssmatch.computeStyle)
  (use j3.ui.cssparse.parse)
  (use j3.ui.css (names animAt animCount P_ANIM_EASE P_ANIM_DUR P_ANIM_ITER P_BACKGROUND P_LEFT P_TRANSLATE V_CALC V_PCT V_COLOR P_ANIM_NAME P_BOX_SHADOW P_OPACITY P_TRANSFORM P_TRANS0 P_WIDTH))
  (use j3.ui.css (names P_BG_IMAGE P_BORDER_IMAGE P_WAVE_AMP P_WAVE_LEN P_WAVE_PERIOD V_ANIM V_EASE V_GRAD V_PX V_TRANS V_XFORM))
  (use j3.ui.gradmix)
  (use j3.ui.textwave)
  (use j3.ui.csscalc.calcEval)
  (use j3.ui.motion)
  (use j3.ui.motionbase.Motion)
  (use j3.ui.xform)
  (use j3.ui.ripple)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (fn style (params (mem (ref Arena)) (css (ref Css)) (cls string)) int (block
    (let nodes _ (call (. mem alloc) (targs MatchNode) 1))
    (let cs _ (call (. mem alloc) (targs int) 1))
    (= (index cs 0) (call (. css intern) cls))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. css intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (return (call computeStyle css nodes 0 (- 1)))))
  (fn gk (params (css (ref Css)) (st int) (p int)) int (block
    (let v _ (call (. css get) st p))
    (return (. v kind))))
  (fn gf (params (css (ref Css)) (st int) (p int)) f32 (block
    (let v _ (call (. css get) st p))
    (return (. v f))))
  (fn testAnim (params) _ (block
    (let lin _ (call (. anim preset) (. anim PRESET_LINEAR)))
    (expr (call near (call (. anim ease) (& lin) (float 0x3fd3333333333333)) (float 0x3fd3333333333333) (float 0x3f60624dd2f1a9fc) "linear cubic is identity"))
    (let e _ (call (. anim preset) (. anim PRESET_EASE)))
    (expr (call ok (&& (== (call (. anim ease) (& e) (float 0x0000000000000000)) (float 0x0000000000000000)) (== (call (. anim ease) (& e) (float 0x3ff0000000000000)) (float 0x3ff0000000000000))) "ease endpoints"))
    (expr (call ok (&& (> (call (. anim ease) (& e) (float 0x3fe0000000000000)) (float 0x3fe6666666666666)) (< (call (. anim ease) (& e) (float 0x3fe0000000000000)) (float 0x3feccccccccccccd))) "ease is fast early"))
    (let back _ (call (. anim cubic) (float 0x3fd5c28f5c28f5c3) (float 0x3ff8f5c28f5c28f6) (float 0x3fe47ae147ae147b) (float 0x3ff0000000000000)))
    (expr (call ok (> (call (. anim ease) (& back) (float 0x3fe3333333333333)) (float 0x3ff0000000000000)) "back easing overshoots"))
    (let b _ (call (. anim preset) (. anim PRESET_BOUNCE)))
    (expr (call ok (&& (< (call (. anim ease) (& b) (float 0x3fe0000000000000)) (float 0x3ff0000000000000)) (== (call (. anim ease) (& b) (float 0x3ff0000000000000)) (float 0x3ff0000000000000))) "bounce lands at 1"))
    (let sp _ (call (. anim preset) (. anim PRESET_SPRING)))
    (expr (call ok (> (call (. anim ease) (& sp) (float 0x3fc999999999999a)) (float 0x3ff0000000000000)) "spring overshoots"))
    (let st _ (call (. anim steps) (float 0x4010000000000000) (bool false)))
    (expr (call near (call (. anim ease) (& st) (float 0x3fd3333333333333)) (float 0x3fd0000000000000) (float 0x3f1a36e2eb1c432d) "steps(4) at 0.3"))
    (expr (call ok (|| (== (call (. anim mixColor) 0 255 (float 0x3fe0000000000000)) (/ 255 2)) (> (call (. anim mixColor) 0 255 (float 0x3fe0000000000000)) 0)) "mixColor"))
    (let p _ (call (. anim phase) (float 0x4062c00000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4000000000000000) (. anim DIR_ALTERNATE) (. anim FILL_NONE)))
    (expr (call ok (&& (. p on) (! (. p done))) "mid second iteration runs"))
    (expr (call near (. p t) (float 0x3fe0000000000000) (float 0x3f50624dd2f1a9fc) "alternate runs backwards in iteration 2"))
    (= p (call (. anim phase) (float 0x406f400000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4000000000000000) (. anim DIR_NORMAL) (. anim FILL_NONE)))
    (expr (call ok (&& (! (. p on)) (. p done)) "finished without fill: no value"))
    (= p (call (. anim phase) (float 0x406f400000000000) (float 0x0000000000000000) (float 0x4059000000000000) (float 0x4000000000000000) (. anim DIR_NORMAL) (. anim FILL_FORWARDS)))
    (expr (call ok (&& (&& (. p on) (. p done)) (== (. p t) (float 0x3ff0000000000000))) "forwards fill holds the end"))
    (= p (call (. anim phase) (float 0x4024000000000000) (float 0x4049000000000000) (float 0x4059000000000000) (float 0x3ff0000000000000) (. anim DIR_NORMAL) (. anim FILL_NONE)))
    (expr (call ok (&& (! (. p on)) (! (. p done))) "before the delay: nothing"))
    (= p (call (. anim phase) (float 0x4024000000000000) (float 0x4049000000000000) (float 0x4059000000000000) (float 0x3ff0000000000000) (. anim DIR_NORMAL) (. anim FILL_BACKWARDS)))
    (expr (call ok (&& (. p on) (== (. p t) (float 0x0000000000000000))) "backwards fill shows the first frame"))
    (= p (call (. anim phase) (float 0x4014000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3ff0000000000000) (. anim DIR_NORMAL) (. anim FILL_FORWARDS)))
    (expr (call ok (&& (. p done) (. p on)) "zero duration is an instant"))
    (= p (call (. anim phase) (float 0x412e848000000000) (float 0x0000000000000000) (float 0x4059000000000000) (- (float 0x3ff0000000000000)) (. anim DIR_NORMAL) (. anim FILL_NONE)))
    (expr (call ok (&& (. p on) (! (. p done))) "infinite never ends"))
    (let r _ (call (. ripple none)))
    (expr (call (. ripple add) (& r) 3 (float 0x3ff0000000000000) (float 0x4000000000000000) (float 0x0000000000000000) (float 0x4059000000000000) 0))
    (expr (call ok (&& (== (. r n) 1) (== (call (. ripple progress) (& r) 0 (float 0x4049000000000000)) (float 0x3fe0000000000000))) "ripple progress"))
    (expr (call (. ripple prune) (& r) (float 0x4069000000000000) (- 1)))
    (expr (call ok (== (. r n) 0) "finished ripples are dropped"))))
  (fn testMotion (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".a { opacity: 0; width: 100px; transform: translateX(10px) rotate(90deg) scale(2); box-shadow: 0 0 0 0 #000000; transition: all 100ms linear; }\n.b { opacity: 1; width: 200px; box-shadow: 0 0 10px 0 #ffffff; transition: all 100ms linear 20ms; }\n@keyframes k { from { opacity: 0; } 50% { opacity: 1; animation-timing-function: linear; } to { opacity: 0.5; } }\n.k { animation: k 100ms linear forwards; }\n.z { animation: k 0s step-end both; transition: opacity 2s cubic-bezier(0.1, 0.7, 1, 0.1) 1s; }\n.bad { transform: rotate(10px); }\n" "m.css" 0))
    (expr (call ok (== (. (. css warns) len) 1) "one warning (bad rotate unit)"))
    (let sa _ (call style mem (& css) "a"))
    (let sb _ (call style mem (& css) "b"))
    (let tx _ (call (. css get) sa P_TRANSFORM))
    (expr (call ok (== (. tx kind) V_XFORM) "transform parses"))
    (expr (call ok (== (index (. (. css paints) items) (. tx i)) (float 0x4008000000000000)) "three functions"))
    (expr (call near (index (. (. css paints) items) (+ (. tx i) 2)) (float 0x4024000000000000) (float 0x3f1a36e2eb1c432d) "translateX"))
    (expr (call near (index (. (. css paints) items) (+ (+ (+ (. tx i) 1) 8) 1)) (float 0x3ff921fb67eacae5) (float 0x3f50624dd2f1a9fc) "rotate in radians"))
    (expr (call near (index (. (. css paints) items) (+ (+ (+ (. tx i) 1) 16) 1)) (float 0x4000000000000000) (float 0x3f1a36e2eb1c432d) "scale"))
    (let xr _ (call (. xform of) (& css) sa (float 0x4059000000000000) (float 0x4034000000000000)))
    (expr (call ok (. xr on) "xform.of"))
    (let q _ (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000))))
    (expr (call ok (call (. xform unmap) (& xr) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x404e000000000000) (float 0x405b800000000000) (& q)) "invertible"))
    (expr (call near (. q x) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "hit test inverse x"))
    (expr (call near (. q y) (float 0x4024000000000000) (float 0x3f847ae147ae147b) "hit test inverse y"))
    (expr (call ok (== (call gk (& css) sb P_TRANS0) V_TRANS) "transition parses"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& css) sa sb (float 0x0000000000000000)))
    (expr (call ok (&& (> (call (. motion live) (& m)) 3) (call (. motion active) (& m))) "transitions started"))
    (let r _ (call (. motion step) (& m) (& css) sb (float 0x4051800000000000) (float 0x0000000000000000)))
    (expr (call ok (&& (== (% r 2) 1) (== (/ r 2) 1)) "live and layout"))
    (let ov _ (. m ov))
    (expr (call near (call gf (& css) ov P_OPACITY) (float 0x3fe0000000000000) (float 0x3f947ae147ae147b) "opacity halfway (20ms delay)"))
    (expr (call near (call gf (& css) ov P_WIDTH) (float 0x4062c00000000000) (float 0x4000000000000000) "width halfway"))
    (expr (call ok (!= (call gk (& css) ov P_BOX_SHADOW) 0) "shadow blends"))
    (expr (call (. motion onStyle) (& m) (& css) sb sa (float 0x4051800000000000)))
    (expr (call (. motion step) (& m) (& css) sa (float 0x4057c00000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. m ov) P_OPACITY) (float 0x3fd8000000000000) (float 0x3f9eb851eb851eb8) "interrupted: continues from the current value"))
    (= r (call (. motion step) (& m) (& css) sa (float 0x407f400000000000) (float 0x0000000000000000)))
    (expr (call ok (&& (== (% r 2) 0) (! (call (. motion active) (& m)))) "settled"))
    (expr (call near (call gf (& css) (. m ov) P_WIDTH) (float 0x4059000000000000) (float 0x3f50624dd2f1a9fc) "ends on the target"))
    (expr (call ok (== (call (. motion live) (& m)) 0) "no tracks left"))
    (let sk _ (call style mem (& css) "k"))
    (expr (call ok (&& (== (call gk (& css) sk P_ANIM_NAME) V_ANIM) (== (call gf (& css) sk P_ANIM_DUR) (float 0x4059000000000000))) "animation shorthand"))
    (let k _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& k) (& css) (- 1) sk (float 0x0000000000000000)))
    (expr (call ok (&& (&& (== (. (. css kfs) len) 1) (== (. (index (. (. css kfs) items) 0) nprop) 1)) (== (. (index (. (. css kfs) items) 0) nf) 3)) "keyframes parsed and sorted"))
    (expr (call (. motion step) (& k) (& css) sk (float 0x4039000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. k ov) P_OPACITY) (float 0x3fe0000000000000) (float 0x3f847ae147ae147b) "keyframes sample"))
    (expr (call (. motion step) (& k) (& css) sk (float 0x4052c00000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. k ov) P_OPACITY) (float 0x3fe8000000000000) (float 0x3f847ae147ae147b) "second span"))
    (= r (call (. motion step) (& k) (& css) sk (float 0x4062c00000000000) (float 0x0000000000000000)))
    (expr (call ok (== (% r 2) 0) "finished"))
    (expr (call near (call gf (& css) (. k ov) P_OPACITY) (float 0x3fe0000000000000) (float 0x3f50624dd2f1a9fc) "forwards fill holds the last frame"))
    (expr (call (. motion onStyle) (& k) (& css) sk sk (float 0x4064000000000000)))
    (expr (call (. motion step) (& k) (& css) sk (float 0x4065400000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. k ov) P_OPACITY) (float 0x3fe0000000000000) (float 0x3f50624dd2f1a9fc) "a restyle keeps the held frame and does not restart"))
    (expr (call (. motion step) (& m) (& css) sa (float 0x3ff0000000000000) (float 0x0000000000000000)))
    (let g _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& g) (& css) (- 1) sk (float 0x0000000000000000)))
    (expr (call (. motion step) (& g) (& css) sk (float 0x4039000000000000) (float 0x4059000000000000)))
    (expr (call near (call gf (& css) (. g ov) P_OPACITY) (call gf (& css) sk P_OPACITY) (float 0x3f50624dd2f1a9fc) "delay holds the base value"))
    (let sz _ (call style mem (& css) "z"))
    (let z _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& z) (& css) (- 1) sz (float 0x0000000000000000)))
    (expr (call (. motion step) (& z) (& css) sz (float 0x3ff0000000000000) (float 0x0000000000000000)))
    (expr (call ok (&& (== (call gk (& css) sz P_TRANS0) V_TRANS) (== (call gf (& css) sz P_TRANS0) (float 0x409f400000000000))) "ms and s units"))
    (expr (call ok (== (call gf (& css) sz P_ANIM_ITER) (float 0x3ff0000000000000)) "iteration default"))))
  (fn (doc "Layer `l` stop `i` field `f` (0 at, 1 r, 2 g, 3 b, 4 a) of the single-layer gradient value at `st`.") off (params (css (ref Css)) (st int) (p int)) int (block
    (let v _ (call (. css get) st p))
    (return (. v i))))
  (fn stop (params (css (ref Css)) (st int) (p int) (i int) (f int)) f32 (block
    (return (index (. (. css paints) items) (+ (+ (+ (call off css st p) 4) (* i 5)) f)))))
  (fn angleOf (params (css (ref Css)) (st int) (p int)) f32 (block
    (return (index (. (. css paints) items) (+ (call off css st p) 2)))))
  (fn stops (params (css (ref Css)) (st int) (p int)) int (block
    (return (call int (index (. (. css paints) items) (+ (call off css st p) 3))))))
  (fn testGradients (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".ga { background-image: linear-gradient(0deg, #ff0000, #0000ff); border-image: conic-gradient(from 0deg, #ff0000, #0000ff) 1; transition: background-image 100ms linear; }\n.gb { background-image: linear-gradient(180deg, #0000ff, #00ff00 50%, #ffffff); transition: background-image 100ms linear; }\n.gc { background-image: radial-gradient(#ff0000, #0000ff); transition: background-image 100ms linear; }\n.gz { background-image: linear-gradient(90deg, #00ff00, #ffffff); transition: background-image 0s; }\n@keyframes gk { from { background-image: linear-gradient(0deg, #ff0000, #0000ff); border-image: conic-gradient(from 0deg, #ff0000, #0000ff) 1; } to { background-image: linear-gradient(360deg, #ff0000, #0000ff); border-image: conic-gradient(from 360deg, #ff0000, #0000ff) 1; } }\n@keyframes gm { from { background-image: linear-gradient(0deg, #ff0000, #0000ff); } to { background-image: radial-gradient(#ff0000, #0000ff); } }\n.gk { animation: gk 100ms linear infinite; }\n.gm { animation: gm 100ms linear both; }\n.w { text-wave: 6px 80px 1.4s; }\n.w0 { text-wave: none; }\n.wb { text-wave: 6px 80px; }\n" "g.css" 0))
    (expr (call ok (== (. (. css warns) len) 1) "one warning (text-wave without a period)"))
    (let sa _ (call style mem (& css) "ga"))
    (let sb _ (call style mem (& css) "gb"))
    (let sc _ (call style mem (& css) "gc"))
    (let sz _ (call style mem (& css) "gz"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& css) sa sb (float 0x0000000000000000)))
    (expr (call ok (call (. motion active) (& m)) "gradient transition starts"))
    (let r _ (call (. motion step) (& m) (& css) sb (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call ok (== (% r 2) 1) "still moving at the middle"))
    (expr (call ok (== (call gk (& css) (. m ov) P_BG_IMAGE) V_GRAD) "overlay holds a gradient"))
    (expr (call near (call angleOf (& css) (. m ov) P_BG_IMAGE) (float 0x4056800000000000) (float 0x3f847ae147ae147b) "angle blends"))
    (expr (call ok (== (call stops (& css) (. m ov) P_BG_IMAGE) 3) "stop count is the larger"))
    (expr (call near (call stop (& css) (. m ov) P_BG_IMAGE 0 0) (float 0x0000000000000000) (float 0x3f50624dd2f1a9fc) "first stop at 0"))
    (expr (call near (call stop (& css) (. m ov) P_BG_IMAGE 1 0) (float 0x3fe8000000000000) (float 0x3f50624dd2f1a9fc) "middle stop moves from 1 to .5"))
    (expr (call near (call stop (& css) (. m ov) P_BG_IMAGE 0 1) (float 0x405fe00000000000) (float 0x3ff0000000000000) "red fades"))
    (expr (call near (call stop (& css) (. m ov) P_BG_IMAGE 2 4) (float 0x406fe00000000000) (float 0x3fe0000000000000) "alpha stays opaque"))
    (let len _ (. (. css paints) len))
    (expr (call (. motion step) (& m) (& css) sb (float 0x404e000000000000) (float 0x0000000000000000)))
    (expr (call (. motion step) (& m) (& css) sb (float 0x4051800000000000) (float 0x0000000000000000)))
    (expr (call ok (== (. (. css paints) len) len) "steady blending does not grow paints"))
    (let m2 _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m2) (& css) sa sb (float 0x0000000000000000)))
    (expr (call (. motion step) (& m2) (& css) sb (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call (. motion onStyle) (& m2) (& css) sb sa (float 0x4049000000000000)))
    (expr (call (. motion step) (& m2) (& css) sa (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call angleOf (& css) (. m2 ov) P_BG_IMAGE) (float 0x4056800000000000) (float 0x3f847ae147ae147b) "retarget starts where it was"))
    (expr (call (. motion step) (& m2) (& css) sa (float 0x4059000000000000) (float 0x0000000000000000)))
    (expr (call near (call angleOf (& css) (. m2 ov) P_BG_IMAGE) (float 0x4046800000000000) (float 0x3f847ae147ae147b) "and heads for the new target"))
    (expr (call (. motion step) (& m2) (& css) sa (float 0x4069000000000000) (float 0x0000000000000000)))
    (expr (call ok (== (call (. motion live) (& m2)) 0) "done"))
    (expr (call ok (== (call off (& css) (. m2 ov) P_BG_IMAGE) (call off (& css) sa P_BG_IMAGE)) "ends on the target's own list"))
    (let mc _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mc) (& css) sa sc (float 0x0000000000000000)))
    (expr (call ok (! (call (. motion active) (& mc))) "different types jump"))
    (let mz _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mz) (& css) sa sz (float 0x0000000000000000)))
    (expr (call ok (! (call (. motion active) (& mz))) "zero duration jumps"))
    (expr (call ok (! (call (. gradmix compatible) (. (. css paints) items) (call off (& css) sa P_BG_IMAGE) (call off (& css) sc P_BG_IMAGE))) "compatible: types differ"))
    (expr (call ok (call (. gradmix compatible) (. (. css paints) items) (call off (& css) sa P_BG_IMAGE) (call off (& css) sb P_BG_IMAGE)) "compatible: stops may differ"))
    (let sk _ (call style mem (& css) "gk"))
    (let k _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& k) (& css) (- 1) sk (float 0x0000000000000000)))
    (expr (call (. motion step) (& k) (& css) sk (float 0x4039000000000000) (float 0x0000000000000000)))
    (expr (call near (call angleOf (& css) (. k ov) P_BG_IMAGE) (float 0x4056800000000000) (float 0x3f847ae147ae147b) "keyframes angle"))
    (expr (call near (call angleOf (& css) (. k ov) P_BORDER_IMAGE) (float 0x4056800000000000) (float 0x3f847ae147ae147b) "keyframes conic start"))
    (= len (. (. css paints) len))
    (for q (.. 0 50) (block
      (expr (call (. motion step) (& k) (& css) sk (+ (float 0x403e000000000000) (call f32 q)) (float 0x0000000000000000)))))
    (expr (call ok (== (. (. css paints) len) len) "keyframes do not allocate per frame"))
    (expr (call (. motion step) (& k) (& css) sk (float 0x4062c00000000000) (float 0x0000000000000000)))
    (expr (call near (call angleOf (& css) (. k ov) P_BG_IMAGE) (float 0x4066800000000000) (float 0x3f847ae147ae147b) "second iteration"))
    (let sm _ (call style mem (& css) "gm"))
    (let km _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& km) (& css) (- 1) sm (float 0x0000000000000000)))
    (expr (call (. motion step) (& km) (& css) sm (float 0x4034000000000000) (float 0x0000000000000000)))
    (expr (call ok (&& (== (call stops (& css) (. km ov) P_BG_IMAGE) 2) (== (index (. (. css paints) items) (+ (call off (& css) (. km ov) P_BG_IMAGE) 1)) (float 0x0000000000000000))) "before the middle: first list"))
    (expr (call (. motion step) (& km) (& css) sm (float 0x4051800000000000) (float 0x0000000000000000)))
    (expr (call ok (== (index (. (. css paints) items) (+ (call off (& css) (. km ov) P_BG_IMAGE) 1)) (float 0x3ff0000000000000)) "after the middle: second list"))
    (let sw _ (call style mem (& css) "w"))
    (expr (call near (call gf (& css) sw P_WAVE_AMP) (float 0x4018000000000000) (float 0x3f50624dd2f1a9fc) "wave amplitude"))
    (expr (call near (call gf (& css) sw P_WAVE_LEN) (float 0x4054000000000000) (float 0x3f50624dd2f1a9fc) "wave length"))
    (expr (call near (call gf (& css) sw P_WAVE_PERIOD) (float 0x4095e00000000000) (float 0x3f50624dd2f1a9fc) "wave period in ms"))
    (expr (call ok (== (call gf (& css) (call style mem (& css) "w0") P_WAVE_AMP) (float 0x0000000000000000)) "none turns it off"))
    (expr (call ok (&& (&& (&& (! (call (. textwave on) (float 0x0000000000000000) (float 0x4054000000000000) (float 0x4095e00000000000))) (! (call (. textwave on) (float 0x4018000000000000) (float 0x0000000000000000) (float 0x4095e00000000000)))) (! (call (. textwave on) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x0000000000000000)))) (call (. textwave on) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x4095e00000000000))) "on needs all three"))
    (expr (call near (call (. textwave lift) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x4095e00000000000) (float 0x0000000000000000) (float 0x0000000000000000)) (float 0x0000000000000000) (float 0x3f50624dd2f1a9fc) "lift at the origin"))
    (expr (call near (call (. textwave lift) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x4095e00000000000) (float 0x4075e00000000000) (float 0x0000000000000000)) (float 0x4018000000000000) (float 0x3f50624dd2f1a9fc) "a crest a quarter period in"))
    (expr (call near (call (. textwave lift) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x4095e00000000000) (float 0x0000000000000000) (float 0x4034000000000000)) (- (float 0x4018000000000000)) (float 0x3f50624dd2f1a9fc) "and a trough a quarter length along"))
    (expr (call near (call (. textwave lift) (float 0x4018000000000000) (float 0x4054000000000000) (float 0x4095e00000000000) (float 0x4095e00000000000) (float 0x4054000000000000)) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "periodic in both"))))
  (fn (doc "Several animations per element, `var()` and `%` in `@keyframes`.") testMulti (params (mem (ref Arena))) _ (block
