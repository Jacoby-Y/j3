(file (module focus_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css (names Css FL_FOCUS FL_FOCUS_VIS FL_FOCUS_WITHIN))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button, input { font-family: \"T\"; font-size: 14px; } .o { width: 300px; } .o:focus-within { width: 301px; } button { width: 50px; height: 20px; } button:focus-visible { height: 21px; } button:not(:focus-visible) { width: 51px; } .anchor { position: relative; width: 90px; height: 20px; } .menu { position: absolute; left: 0; top: 100%; width: 80px; height: 40px; } .fill { height: 2px; } .ct { display: contents; } .ct:focus-within > button { height: 33px; }")
  (mod-let SHOW_MID bool _)
  (mod-let SHOW_POP bool _)
  (mod-let FILL int _)
  (mod-let A int _)
  (mod-let B int _)
  (mod-let OUTER int _)
  (mod-let MID int _)
  (mod-let TB int _)
  (mod-let OTHER int _)
  (mod-let ANCHOR int _)
  (mod-let PB int _)
  (mod-let CHK int _)
  (mod-let CT int _)
  (mod-let CB int _)
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let page _ (call (. d open) 0 (call (. d tag) "div") 1))
    (for i (.. 0 FILL) (block
      (let f _ (call (. d open) (+ 100 i) (call (. d tag) "div") 1))
      (expr (call (. d cls) f "fill"))
      (expr (call (. d close)))))
    (= OUTER (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) OUTER "o"))
    (if SHOW_MID (block
      (= MID (call (. d open) 0 (call (. d tag) "div") 1))
      (= A (call (. d open) 0 (call (. d tag) "button") 1))
      (expr (call (. d close)))
      (= B (call (. d open) 1 (call (. d tag) "button") 1))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (= OTHER (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) OTHER "o"))
    (= TB (call (. d open) 0 (call (. d tag) "input") 1))
    (expr (call (. d attrType) TB "text"))
    (expr (call (. d close)))
    (= CHK (call (. d open) 1 (call (. d tag) "input") 1))
    (expr (call (. d attrType) CHK "checkbox"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (= ANCHOR (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) ANCHOR "anchor"))
    (if SHOW_POP (block
      (let m _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) m "menu"))
      (expr (call (. d attrOverlay) m (. dom OV_POPOVER)))
      (= PB (call (. d open) 0 (call (. d tag) "button") 1))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (= CT (call (. d open) 3 (call (. d tag) "div") 1))
    (expr (call (. d cls) CT "ct"))
    (= CB (call (. d open) 0 (call (. d tag) "button") 1))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn cx (params (d (ref Dom)) (id int)) f32 (block
    (return (+ (call (. d absX) id) (/ (. (index (. (. d nodes) items) id) w) (float 0x4000000000000000))))))
  (fn cy (params (d (ref Dom)) (id int)) f32 (block
    (return (+ (call (. d absY) id) (/ (. (index (. (. d nodes) items) id) h) (float 0x4000000000000000))))))
  (fn click (params (d (ref Dom)) (id int)) _ (block
    (expr (call (. d simInput) (call cx d id) (call cy d id) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) (call cx d id) (call cy d id) (bool true) (float 0x0000000000000000)))
    (expr (call frame d))
    (expr (call (. d simInput) (call cx d id) (call cy d id) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn key (params (d (ref Dom)) (names string)) _ (block
    (expr (call (. d simKeys) "" names))
    (expr (call frame d))))
  (fn has (params (d (ref Dom)) (id int) (bit int)) bool (block
    (return (== (% (/ (. (index (. (. d mnodes) items) id) flags) bit) 2) 1))))
  (fn fresh (params (mem (ref Arena)) (css (ref Css)) (fill int)) Dom (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= SHOW_MID (bool true))
    (= SHOW_POP (bool false))
    (= FILL fill)
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (return d)))
  (fn testKeyboardAndMouse (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call fresh mem css 0))
    (expr (call ok (&& (! (call has (& d) OUTER FL_FOCUS_WITHIN)) (! (call (. d focusVisible)))) "nothing focused at the start"))
    (expr (call key (& d) "Tab"))
    (expr (call ok (&& (== (call (. d focused)) A) (call (. d keyboard))) "Tab focuses the first button"))
    (expr (call ok (&& (&& (call has (& d) A FL_FOCUS) (call has (& d) A FL_FOCUS_VIS)) (call (. d focusVisible))) "a Tab focus is :focus-visible"))
    (expr (call ok (&& (&& (call has (& d) A FL_FOCUS_WITHIN) (call has (& d) MID FL_FOCUS_WITHIN)) (call has (& d) OUTER FL_FOCUS_WITHIN)) ":focus-within is the node and all its ancestors"))
    (expr (call ok (&& (! (call has (& d) OTHER FL_FOCUS_WITHIN)) (! (call has (& d) B FL_FOCUS_WITHIN))) "and nothing else"))
    (expr (call ok (&& (&& (== (. (index (. (. d nodes) items) OUTER) w) (float 0x4072d00000000000)) (== (. (index (. (. d nodes) items) A) h) (float 0x4035000000000000))) (== (. (index (. (. d nodes) items) A) w) (float 0x4049000000000000))) "the rules apply: ring on, :not(:focus-visible) off"))
    (expr (call key (& d) "Tab"))
    (expr (call ok (&& (&& (&& (== (call (. d focused)) B) (! (call has (& d) A FL_FOCUS_VIS))) (! (call has (& d) A FL_FOCUS_WITHIN))) (call has (& d) B FL_FOCUS_VIS)) "Tab moves visibility with the focus"))
    (expr (call ok (call has (& d) OUTER FL_FOCUS_WITHIN) "the shared ancestor stays"))
    (expr (call key (& d) "Tab"))
    (expr (call ok (&& (&& (&& (== (call (. d focused)) TB) (call has (& d) TB FL_FOCUS_VIS)) (call has (& d) OTHER FL_FOCUS_WITHIN)) (! (call has (& d) OUTER FL_FOCUS_WITHIN))) "focus-within moves to the other container"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) OUTER) w) (float 0x4072c00000000000)) (== (. (index (. (. d nodes) items) OTHER) w) (float 0x4072d00000000000))) "and the old ring is off"))
    (expr (call click (& d) A))
    (expr (call ok (&& (== (call (. d focused)) A) (! (call (. d keyboard)))) "a click focuses the button and flips the modality"))
    (expr (call ok (&& (&& (call has (& d) A FL_FOCUS) (! (call has (& d) A FL_FOCUS_VIS))) (! (call (. d focusVisible)))) "a click focus is not :focus-visible"))
    (expr (call ok (call has (& d) OUTER FL_FOCUS_WITHIN) ":focus-within does not care how"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) A) h) (float 0x4034000000000000)) (== (. (index (. (. d nodes) items) A) w) (float 0x4049800000000000))) "so :not(:focus-visible) applies"))
    (expr (call click (& d) TB))
    (expr (call ok (&& (&& (== (call (. d focused)) TB) (call has (& d) TB FL_FOCUS_VIS)) (! (call (. d keyboard)))) "a click on a text box is :focus-visible"))
    (expr (call click (& d) CHK))
    (expr (call ok (&& (== (call (. d focused)) CHK) (! (call has (& d) CHK FL_FOCUS_VIS))) "a click on a checkbox is not"))
    (expr (call key (& d) "Tab"))
    (expr (call ok (&& (call (. d keyboard)) (call (. d focusVisible))) "a key makes the next focus visible again"))
    (expr (call click (& d) A))
    (expr (call ok (&& (== (call (. d focused)) A) (! (call (. d focusVisible)))) "mouse focus again"))
    (let r0 _ (. d restyled))
    (expr (call key (& d) "Down"))
    (expr (call ok (&& (&& (== (call (. d focused)) A) (call (. d focusVisible))) (call (. d keyboard))) "a key shows the ring on the focused node"))
    (expr (call ok (<= (- (. d restyled) r0) 2) "and restyles that node only"))
    (expr (call (. d simInput) (call cx (& d) B) (call cy (& d) B) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d setKeyboard) (bool false)))
    (expr (call (. d simInput) (call cx (& d) B) (call cy (& d) B) (bool true) (float 0x0000000000000000)))
    (expr (call (. d simKeys) "" "Down"))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (== (call (. d focused)) B) (call (. d focusVisible))) (call (. d keyboard))) "press and key in one frame: keyboard mode, ring on the pressed button"))
    (expr (call (. d simInput) (call cx (& d) B) (call cy (& d) B) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call click (& d) (. (index (. (. d nodes) items) OTHER) next)))
    (expr (call ok (&& (&& (< (call (. d focused)) 0) (! (call has (& d) OTHER FL_FOCUS_WITHIN))) (! (call (. d focusVisible)))) "a click on nothing clears focus and the chain"))
    (expr (call (. d setKeyboard) (bool true)))
    (expr (call (. d focusNode) B))
    (expr (call ok (call (. d focusVisible)) "programmatic focus after setKeyboard(true) is visible"))
    (expr (call (. d setKeyboard) (bool false)))
    (expr (call (. d focusNode) A))
    (expr (call ok (&& (! (call (. d focusVisible))) (call has (& d) A FL_FOCUS)) "and not after setKeyboard(false)"))
    (expr (call (. d focusNode) TB))
    (expr (call ok (call (. d focusVisible)) "a text box is visible whatever the modality"))))
  (fn testContents (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call fresh mem css 0))
    (expr (call ok (== (. (index (. (. d nodes) items) CB) h) (float 0x4034000000000000)) "setup"))
    (expr (call (. d focusNode) CB))
    (expr (call frame (& d)))
    (expr (call ok (&& (call has (& d) CT FL_FOCUS_WITHIN) (== (. (index (. (. d nodes) items) CB) h) (float 0x4040800000000000))) "a contents parent is :focus-within and restyles its child"))
    (expr (call (. d focusNode) A))
    (expr (call frame (& d)))
    (expr (call ok (&& (! (call has (& d) CT FL_FOCUS_WITHIN)) (== (. (index (. (. d nodes) items) CB) h) (float 0x4034000000000000))) "and lets go"))))
  (fn testCost (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call fresh mem css 60))
    (expr (call key (& d) "Tab"))
    (let r0 _ (. d restyled))
    (expr (call key (& d) "Tab"))
    (expr (call ok (== (call (. d focused)) B) "to the second button"))
    (expr (call ok (<= (- (. d restyled) r0) 3) "a move inside one container restyles the two buttons at most"))
    (= r0 (. d restyled))
    (expr (call key (& d) "Tab"))
    (expr (call ok (== (call (. d focused)) TB) "to the text box"))
    (expr (call ok (<= (- (. d restyled) r0) 10) (interp "a move across containers restyles the two chains and what inherits from them (" (- (. d restyled) r0) ")")))
    (expr (call frame (& d)))
    (let u1 _ (. (. d mem) used))
    (let l1 _ (. d laid))
    (let r1 _ (. d restyled))
    (for i (.. 0 30) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. (. d mem) used) u1) (== (. d laid) l1)) (== (. d restyled) r1)) "idle frames with a focused text box are free"))
    (expr (call key (& d) "S+Tab"))
    (expr (call ok (&& (== (call (. d focused)) B) (call (. d focusVisible))) "back to the button"))
    (expr (call frame (& d)))
    (let used _ (. (. d mem) used))
    (let laid _ (. d laid))
    (let rest _ (. d restyled))
    (for i (.. 0 30) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (== (. d restyled) rest)) "idle frames allocate, lay out and restyle nothing"))))
  (fn testPopover (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call fresh mem css 0))
    (= SHOW_POP (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) PB) parent)) parent) ANCHOR) "the popover is a child of its owner"))
    (expr (call (. d setKeyboard) (bool true)))
    (expr (call (. d focusNode) PB))
    (expr (call ok (&& (== (call (. d focused)) PB) (call has (& d) ANCHOR FL_FOCUS_WITHIN)) "focus in a popover is :focus-within for its owner"))
    (= SHOW_POP (bool false))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (< (call (. d focused)) 0) (! (call has (& d) ANCHOR FL_FOCUS_WITHIN))) "the popover closing takes the focus and the chain with it"))))
  (fn testRemoved (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call fresh mem css 0))
    (expr (call key (& d) "Tab"))
    (expr (call ok (call has (& d) OUTER FL_FOCUS_WITHIN) "setup"))
    (= SHOW_MID (bool false))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (< (call (. d focused)) 0) "a removed focused node loses focus"))
    (expr (call ok (! (call has (& d) OUTER FL_FOCUS_WITHIN)) "and its surviving ancestor stops matching"))
    (expr (call ok (== (. (index (. (. d nodes) items) OUTER) w) (float 0x4072c00000000000)) "the ring is gone"))
    (= SHOW_MID (bool true))
    (expr (call frame (& d)))
    (expr (call ok (&& (&& (! (call has (& d) A FL_FOCUS_WITHIN)) (! (call has (& d) A FL_FOCUS))) (! (call has (& d) A FL_FOCUS_VIS))) "a recycled node starts clean"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "focus.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (expr (call testKeyboardAndMouse (& mem) (& css)))
    (expr (call testContents (& mem) (& css)))
    (expr (call testCost (& mem) (& css)))
    (expr (call testPopover (& mem) (& css)))
    (expr (call testRemoved (& mem) (& css)))
    (expr (call printLn (interp "focus_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
