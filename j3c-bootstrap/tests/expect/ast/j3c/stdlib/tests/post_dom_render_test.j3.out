(file (module post_dom_render_test)
  (use-lib "GL" gl
    (lib-fn glGetError (params) u32 _))
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.paint)
  (use j3.gfx.canvas (names Canvas Mode rgba))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom K_ELEM))
  (use j3.ui.media)
  (mod-let CHECKS int _)
  (const W int 480)
  (const H int 320)
  (const SHEET string ".stage { display: block; position: relative; width: 480px; height: 320px; } .host { display: block; position: relative; width: 480px; height: 320px; } .group { position: absolute; left: 40px; top: 40px; width: 140px; height: 80px; background: #ff0000; } .child { position: absolute; left: 40px; top: 20px; width: 80px; height: 40px; background: #0000ff; } .neutral { filter: brightness(1); } .half { opacity: .5; } .masked { mask-image: linear-gradient(90deg, #ffffff80, #ffffff80); } .rotated { transform: rotate(17deg); } .cliphost { position: absolute; left: 220px; top: 20px; width: 100px; height: 100px; overflow: hidden; } .oversize { left: 20px; top: 10px; width: 150px; height: 80px; filter: blur(8px); } .glass { background: transparent; backdrop-filter: blur(8px); } .gray { filter: grayscale(1); } .upper { z-index: 2; } .ownclip { overflow: hidden; filter: blur(8px); } .projected { rotate-y: 60deg; } .projective { perspective: 600px; } .gradmask { mask-image: linear-gradient(90deg, #ffffff00 0%, #ffffff00 40%, #ffffffff 60%, #ffffffff 100%); } .shaped { clip-path: circle(30px at 50% 50%); }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (v int) (expected int) (tolerance int) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- v expected))
    (if (< diff 0) (block
      (= diff (- 0 diff))))
    (if (> diff tolerance) (block
      (expr (call printLn (interp "FAIL: " msg ": " v ", expected " expected)))
      (expr (call panic msg))))))
  (fn channel (params (p (slice u8)) (x int) (y int) (c int)) int (block
    (return (call int (index p (+ (* (+ (* y W) x) 4) c))))))
  (fn stripes (params) _ (block
    (for i (.. 0 (/ W 4)) (block
      (expr (call (. paint rect) (struct-lit Vec2 (field x (call f32 (* i 4))) (field y (float 0x0000000000000000))) (struct-lit Vec2 (field x (float 0x4010000000000000)) (field y (call f32 H))) (struct-lit Color (field r (if-expr (== (% i 2) 0) 0 255)) (field g 0) (field b 0) (field a 255))))))))
  (fn frame (params (d (ref Dom)) (mode int) (pixels (slice u8))) _ (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (if (|| (== mode 6) (== mode 7)) (block
      (expr (call stripes))))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
    (let stage _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) stage "stage"))
    (let host _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) host "host"))
    (expr (call (. d clsIf) host "masked" (|| (== mode 1) (== mode 14))))
    (expr (call (. d clsIf) host "cliphost" (== mode 5)))
    (let group _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) group "group"))
    (expr (call (. d clsIf) group "neutral" (|| (|| (|| (|| (|| (== mode 0) (== mode 1)) (== mode 2)) (== mode 4)) (== mode 6)) (== mode 9))))
    (expr (call (. d clsIf) group "half" (|| (|| (|| (== mode 0) (== mode 2)) (== mode 11)) (== mode 14))))
    (expr (call (. d clsIf) group "rotated" (|| (== mode 3) (== mode 4))))
    (expr (call (. d clsIf) group "oversize" (== mode 5)))
    (expr (call (. d clsIf) group "glass" (|| (== mode 6) (== mode 7))))
    (expr (call (. d clsIf) group "gray" (== mode 8)))
    (expr (call (. d clsIf) group "masked" (|| (|| (== mode 9) (== mode 12)) (== mode 14))))
    (expr (call (. d clsIf) group "ownclip" (== mode 10)))
    (expr (call (. d clsIf) group "projected" (>= mode 11)))
    (expr (call (. d clsIf) group "projective" (== mode 14)))
    (expr (call (. d clsIf) group "gradmask" (== mode 11)))
    (expr (call (. d clsIf) group "shaped" (== mode 13)))
    (if (&& (!= mode 6) (!= mode 7)) (block
      (let child _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) child "child"))
      (expr (call (. d clsIf) child "neutral" (== mode 2)))
      (expr (call (. d clsIf) child "half" (== mode 2)))
      (expr (call (. d clsIf) child "upper" (== mode 8)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d paintAll)))
    (expr (call (. d endFrame)))
    (expr (call ok (call (. game readWindow) pixels) "read retained DOM output"))
    (let error _ (call (. gl glGetError)))
    (if (!= error 0) (block
      (expr (call printLn (interp "mode " mode ": GL error " error)))))
    (expr (call ok (== error 0) "retained DOM paint has no GL error"))))
  (fn equal (params (a (slice u8)) (b (slice u8)) (tolerance int) (msg string)) _ (block
    (let worst _ 0)
    (let bad _ 0)
    (for i (.. 0 (. a len)) (block
      (let diff _ (- (call int (index a i)) (call int (index b i))))
      (if (< diff 0) (block
        (= diff (- 0 diff))))
      (if (> diff worst) (block
        (= worst diff)))
      (if (> diff tolerance) (block
        (+= bad 1)))))
    (if (> bad 0) (block
      (expr (call printLn (interp msg ": " bad " channels differ, worst=" worst)))))
    (expr (call ok (== bad 0) msg))))
  (fn testSizing (params (mem (ref Arena)) (pixels (slice u8)) (reference (slice u8))) _ (block
    (let image _ (call (. Canvas create) mem 100 50 (. Mode Pixel)))
    (expr (call (. image clear) (call rgba 0 0 255 255)))
    (match (call (. image savePng) "/tmp/j3-sizing-media.png" mem)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save sizing image fixture")))))
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) ".host { width: 400px; } svg, img { width: 200px; max-width: 100px; background: #ff0000; border: 4px solid #00ff00; }" "sizing.css" 0))
    (expr (call ok (== (. (. css warns) len) 0) "media sizing sheet parses"))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d simInput) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) (bool false) (float 0x0000000000000000)))
    (for kind (.. 0 2) (block
      (for box (.. 0 2) (block
        (for px (.. 0 2) (block
          (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
          (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
          (let host _ (call (. d open) 0 (call (. d tag) "div") 1))
          (expr (call (. d cls) host "host"))
          (let id _ (call (. d open) 0 (call (. d tag) (if-expr (== kind 0) "svg" "img")) 1))
          (expr (call (. d styleStr) id 0 "box-sizing" (if-expr (== box 0) "border-box" "content-box")))
          (expr (call (. d styleStr) id 1 "padding" (if-expr (== px 0) "10%" "40px")))
          (expr (call (. d styleStr) id 2 "border-width" (if-expr (== px 0) "1%" "4px")))
          (if (== kind 0) (block
            (expr (call (. d attrMedia) id (. media M_VIEWBOX) "0 0 100 50"))
            (let path _ (call (. d open) 0 (call (. d tag) "path") 1))
            (expr (call (. d attrMedia) path (. media M_D) "M0 0H100V50H0Z"))
            (expr (call (. d attrMedia) path (. media M_FILL) "#0000ff"))
            (expr (call (. d close)))) (block
            (expr (call (. d attrMedia) id (. media M_SRC) "/tmp/j3-sizing-media.png"))))
          (expr (call (. d close)))
          (expr (call (. d close)))
          (expr (call (. d layout)))
          (let n _ (& (index (. (. d nodes) items) id)))
          (expr (call ok (== (. n basisW) (float 0x4079000000000000)) "clamped media retains containing width"))
          (expr (call ok (== (. n w) (if-expr (== box 0) (float 0x4059000000000000) (float 0x4067800000000000))) "media width obeys box sizing and max"))
          (expr (call ok (== (. n h) (if-expr (== box 0) (float 0x4057800000000000) (float 0x4061400000000000))) "media height uses the same padding and border basis"))
          (expr (call (. d paintAll)))
          (expr (call (. d endFrame)))
          (expr (call ok (call (. game readWindow) pixels) "read media sizing output"))
          (expr (call near (call channel pixels 20 30 0) 255 0 "media keeps red padding under a width clamp"))
          (expr (call near (call channel pixels 20 30 2) 0 0 "media does not draw into padding"))
          (expr (call near (call channel pixels 50 45 2) 255 0 "media content remains blue"))
          (expr (call near (call channel pixels 2 20 1) 255 0 "paint border matches layout percentage border"))
          (if (== px 0) (block
            (for i (.. 0 (. pixels len)) (block
              (= (index reference i) (index pixels i))))) (block
            (expr (call equal reference pixels 0 "percentage media edges paint identically to equivalent px"))))))))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call (. game initGlHidden) "retained post effects checks" W H))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "post-dom.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "retained fixture CSS parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d simInput) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let pixels _ (call (. mem alloc) (targs u8) (* (* W H) 4)))
    (let reference _ (call (. mem alloc) (targs u8) (* (* W H) 4)))
    (expr (call frame (& d) 0 pixels))
    (expr (call near (call channel pixels 50 50 0) 128 2 "group opacity applies once to parent fill"))
    (expr (call near (call channel pixels 100 80 0) 0 2 "opaque child replaces parent inside group"))
    (expr (call near (call channel pixels 100 80 2) 128 2 "group opacity applies once to child"))
    (expr (call frame (& d) 1 pixels))
    (expr (call near (call channel pixels 50 50 0) 128 2 "ancestor mask applied once to group"))
    (expr (call near (call channel pixels 100 80 2) 128 2 "ancestor mask applied once over child"))
    (expr (call frame (& d) 9 pixels))
    (expr (call near (call channel pixels 50 50 0) 128 2 "own mask applied once to group"))
    (expr (call near (call channel pixels 100 80 2) 128 2 "own mask applied once over child"))
    (expr (call frame (& d) 2 pixels))
    (expr (call near (call channel pixels 100 80 0) 64 3 "nested group preserves red through half-opacity blue"))
    (expr (call near (call channel pixels 100 80 2) 64 3 "nested group alpha multiplies once per group"))
    (expr (call frame (& d) 3 reference))
    (expr (call frame (& d) 4 pixels))
    (expr (call equal reference pixels 2 "neutral group preserves transformed content coordinates"))
    (expr (call frame (& d) 5 pixels))
    (expr (call near (call channel pixels 321 60 0) 0 0 "blur cannot escape ancestor right clip"))
    (expr (call near (call channel pixels 260 19 0) 0 0 "blur cannot escape ancestor top clip"))
    (expr (call ok (> (call channel pixels 260 55 0) 100) "clipped blur has visible content"))
    (expr (call frame (& d) 10 pixels))
    (expr (call ok (> (call channel pixels 36 80 0) 5) "own overflow clips captured children, then blur may spread outside the box"))
    (expr (call near (call channel pixels 5 80 0) 0 0 "own overflow blur spill remains local"))
    (expr (call frame (& d) 8 pixels))
    (expr (call near (call channel pixels 50 50 0) (call channel pixels 50 50 1) 2 "parent grayscale group is painted in its layer"))
    (expr (call near (call channel pixels 100 80 2) 18 2 "higher z child is inside its parent's group: grayscale turns blue dark gray"))
    (expr (call near (call channel pixels 100 80 0) 18 2 "higher z child color goes through the parent's filter"))
    (expr (call frame (& d) 7 reference))
    (expr (call frame (& d) 6 pixels))
    (expr (call equal reference pixels 2 "backdrop blur survives neutral content group"))
    (expr (call frame (& d) 11 pixels))
    (expr (call near (call channel pixels 100 80 2) 0 2 "gradient transparent region projects with own texture"))
    (expr (call near (call channel pixels 127 80 2) 128 3 "gradient opaque region projects with own texture and group opacity"))
    (expr (call near (call channel pixels 127 80 0) 0 2 "projected mask covers opaque child once over parent fill"))
    (expr (call frame (& d) 12 pixels))
    (expr (call near (call channel pixels 110 80 2) 128 3 "projected constant mask applies once over overlapping content"))
    (expr (call near (call channel pixels 110 80 0) 0 2 "projected masked child replaces parent fill"))
    (expr (call frame (& d) 13 pixels))
    (expr (call near (call channel pixels 90 80 0) 0 2 "own clip-path contracts with projected plane"))
    (expr (call near (call channel pixels 100 80 2) 255 3 "own clip-path preserves projected interior"))
    (expr (call frame (& d) 14 pixels))
    (expr (call near (call channel pixels 110 80 2) 32 3 "perspective own mask, ancestor mask and group alpha each apply once"))
    (expr (call near (call channel pixels 110 80 0) 0 2 "perspective masked overlapping content stays atomic"))
    (let capture _ (call (. Canvas create) (& mem) (call i32 W) (call i32 H) (. Mode Pixel)))
    (for i (.. 0 (. pixels len)) (block
      (= (index (. capture pixels) i) (index pixels i))))
    (match (call (. capture savePng) "/tmp/j3-post-dom.png" (& mem))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save retained DOM capture")))))
    (expr (call testSizing (& mem) pixels reference))
    (expr (call (. game destroy)))
    (expr (call (. mem destroy)))
    (expr (call printLn (interp "post_dom_render_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
