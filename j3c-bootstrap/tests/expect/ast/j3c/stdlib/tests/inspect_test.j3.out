(file (module inspect_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains same))
  (use j3.ui.css (names Css FL_ACTIVE hasBit))
  (use j3.ui.cssparse (names parse parseAt))
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.inspect)
  (use j3.ui.testkit)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); }\ndiv, button, p { font-family: \"T\"; font-size: 16px; display: block; } p { transform-origin: 1em 25%; }\nbutton { color: #ff0000; width: 100px; --accent: 3px; }\n.big { color: #0000ff; padding-top: 4px; }\n")
  (mod-let CLICKS int _)
  (mod-let IDS (array 4 int) _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (= (index IDS 0) (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d attrId) (index IDS 0) "root"))
    (= (index IDS 1) (call (. d open) 1 (call (. d tag) "button") 1))
    (expr (call (. d cls) (index IDS 1) "big"))
    (if (call (. d clicked) (index IDS 1)) (block
      (+= CLICKS 1)))
    (expr (call (. d text) "Go"))
    (expr (call (. d close)))
    (= (index IDS 2) (call (. d open) 2 (call (. d tag) "p") 1))
    (expr (call (. d styleStr) (index IDS 2) 0 "width" "50%"))
    (expr (call (. d styleStr) (index IDS 2) 1 "background-image" "linear-gradient(90deg, #ff0000, #0000ff)"))
    (expr (call (. d styleStr) (index IDS 2) 2 "box-shadow" "1px 2px 3px 4px #00000080"))
    (expr (call (. d styleStr) (index IDS 2) 3 "transform" "translate(0.5em, 6px) rotate(10deg)"))
    (expr (call (. d styleStr) (index IDS 2) 4 "transition" "color 200ms ease-in"))
    (expr (call (. d styleStr) (index IDS 2) 5 "grid-template-columns" "100px minmax(10px, 1fr) 20%"))
    (expr (call (. d styleStr) (index IDS 2) 6 "animation-duration" "300ms"))
    (expr (call (. d styleStr) (index IDS 2) 7 "background-size" "cover"))
    (expr (call (. d styleStr) (index IDS 2) 8 "color" "var(--accent)"))
    (expr (call (. d text) "Note"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (if (! (. d insp)) (block
      (expr (call (. inputs overlay) d))))
    (expr (call (. d endFrame)))))
  (fn click (params (d (ref Dom)) (id int)) _ (block
    (for f (.. 0 4) (block
      (expr (call (. testkit click) d f 0 id))
      (expr (call frame d))))))
  (fn key (params (d (ref Dom)) (names string)) _ (block
    (expr (call (. d simKeys) "" names))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "ui/i.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (! (. d insp)) (== (. d inspBuilds) 0)) "off by default, nothing built"))
    (expr (call click (& d) (index IDS 1)))
    (expr (call ok (== CLICKS 1) "the app gets clicks while the inspector is off"))
    (expr (call key (& d) "F12"))
    (expr (call ok (! (. d insp)) "F12 does nothing without J3_INSPECT"))
    (= (. d inspHot) (bool true))
    (expr (call key (& d) "F12"))
    (expr (call ok (. d insp) "F12 turns it on"))
    (expr (call key (& d) "F12"))
    (expr (call ok (! (. d insp)) "F12 turns it off"))
    (expr (call (. d setInspector) (bool true)))
    (expr (call (. testkit click) (& d) 0 0 (index IDS 1)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d rawHit) (index IDS 1)) "hover target is the hit element"))
    (for f (.. 1 4) (block
      (expr (call (. testkit click) (& d) f 0 (index IDS 1)))
      (expr (call frame (& d)))))
    (expr (call ok (== (. d inspPin) (index IDS 1)) "a click pins the element"))
    (expr (call ok (== CLICKS 1) "the click did not reach the app"))
    (expr (call ok (== (. d inspBuilds) 0) "no text built before the panel needs it"))
    (expr (call (. inspect panelText) (& d)))
    (expr (call (. inspect panelText) (& d)))
    (expr (call ok (== (. d inspBuilds) 1) "panel text is built once for a pin"))
    (expr (call frame (& d)))
    (expr (call (. inspect panelText) (& d)))
    (expr (call ok (== (. d inspBuilds) 1) "and not again while nothing changes"))
    (expr (call key (& d) "Up"))
    (expr (call ok (== (. d inspPin) (index IDS 0)) "Up walks to the parent"))
    (expr (call key (& d) "Down"))
    (expr (call ok (== (. d inspPin) (index IDS 1)) "Down walks to the first child"))
    (expr (call key (& d) "Right"))
    (expr (call ok (== (. d inspPin) (index IDS 2)) "Right walks to the next sibling"))
    (expr (call key (& d) "Left"))
    (expr (call ok (== (. d inspPin) (index IDS 1)) "Left walks to the previous sibling"))
    (expr (call key (& d) "Escape"))
    (expr (call ok (== (. d inspPin) (- 1)) "Escape unpins"))
    (expr (call ok (== (. d inspBuilds) 1) "walking built nothing"))
    (let ps _ (call (. inspect text) (& d) (index IDS 2)))
    (expr (call ok (! (call contains ps "<kind")) "no value prints as <kind N>"))
    (expr (call ok (call contains ps "style:  inline") "inline style: listed as the first pseudo-rule"))
    (expr (call ok (call contains ps "  width: 50.0%") "percentage"))
    (expr (call ok (call contains ps "linear-gradient(90.0deg, #ff0000ff 0.0%, #0000ffff 100.0%)") "gradient summary"))
    (expr (call ok (call contains ps "box-shadow: 1.0px 2.0px 3.0px 4.0px #00000080") "shadow"))
    (expr (call ok (call contains ps "transform: translate(8.0px, 6.0px) rotate(10.0deg)") "an em transform prints as px"))
    (expr (call ok (call contains ps "transform-origin: 16.0px 25.0%") "an em origin prints as px, a percentage as %"))
    (expr (call ok (call contains ps "color 200.0ms ease-in") "transition"))
    (expr (call ok (call contains ps "100.0px minmax(10.0px, 1.0fr) 20.0%") "grid tracks"))
    (expr (call ok (call contains ps "animation-duration: 300.0ms") "time"))
    (expr (call ok (call contains ps "background-size: cover") "background-size"))
    (expr (call ok (call contains ps "color: var(--accent)") "var() source"))
    (expr (call ok (== (call contains ps "display: block  (overridden)") (bool false)) "a rule declaration only inline style replaces is marked"))
    (let s _ (call (. inspect text) (& d) (index IDS 1)))
    (expr (call ok (call contains s "button.big") "header names tag and class"))
    (expr (call ok (call contains s "ui/i.css:3") "the tag rule's file:line"))
    (expr (call ok (call contains s "ui/i.css:4") "the class rule's file:line"))
    (expr (call ok (call contains s "color: #ff0000ff  (overridden)") "the beaten color declaration is marked"))
    (expr (call ok (call contains s "color: #0000ffff\n") "the winning color is not marked"))
    (expr (call ok (call contains s "width: 100.0px") "computed width"))
    (expr (call ok (call contains s "--accent: 3.0px") "custom property in scope"))
    (expr (call ok (|| (call contains s "padding: 4.0 0.0 0.0 0.0") (call contains s "padding: 4")) "box padding"))
    (expr (call ok (call same (call (. inspect text) (& d) 9999) "(no element)\n") "bad id"))
    (expr (call ok (&& (&& (== (call (. inspect find) (& d) ".big") (index IDS 1)) (== (call (. inspect find) (& d) "#root") (index IDS 0))) (== (call (. inspect find) (& d) "p") (index IDS 2))) "selectors find elements"))
    (expr (call (. inspect panelText) (& d)))
    (let used _ (. mem used))
    (for i (.. 0 100) (block
      (= (. d inspPin) (index IDS (+ 1 (% i 2))))
      (expr (call (. inspect panelText) (& d)))))
    (expr (call ok (>= (. d inspBuilds) 100) "every re-pin rebuilt the text"))
    (expr (call ok (== (. mem used) used) "re-pinning allocates nothing from the Dom arena"))
    (expr (call (. d setInspector) (bool false)))
    (expr (call (. d simInput) (+ (call (. d absX) (index IDS 1)) (float 0x4008000000000000)) (+ (call (. d absY) (index IDS 1)) (float 0x4008000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let hv _ (. d hover))
    (expr (call ok (>= hv 0) "the button is hovered while the inspector is off"))
    (expr (call (. d setInspector) (bool true)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d hover) hv) "app hover frozen while inspecting"))
    (expr (call (. d simInput) (+ (call (. d absX) (index IDS 0)) (float 0x4008000000000000)) (+ (call (. d absY) (index IDS 0)) (float 0x4008000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (&& (>= (. d rawHit) 0) (== (. d hover) hv)) "the inspector still sees its own hover target"))
    (let css2 _ (call (. Css new) (& mem)))
    (expr (call parseAt (& css2) "\n.x { color: red; }\n.y { bogus: 1; }" "ui/s.j3ui" 1 10))
    (expr (call ok (&& (== (. (index (. (. css2 rules) items) 0) line) 12) (> (. (. (index (. (. css2 rules) items) 0) file) len) 0)) "rule line is offset by line0"))
    (expr (call ok (&& (== (. (. css2 warns) len) 1) (== (. (index (. (. css2 warns) items) 0) line) 13)) "warning line is offset by line0, once"))
    (expr (call (. d setInspector) (bool false)))
    (let bx _ (+ (call (. d absX) (index IDS 1)) (float 0x4008000000000000)))
    (let by _ (+ (call (. d absY) (index IDS 1)) (float 0x4008000000000000)))
    (expr (call (. d simInput) bx by (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) bx by (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (call hasBit (. (index (. (. d mnodes) items) (index IDS 1)) flags) FL_ACTIVE) "pressed button is active"))
    (expr (call (. d setInspector) (bool true)))
    (expr (call (. d simInput) bx by (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d setInspector) (bool false)))
    (expr (call (. d simInput) bx by (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (! (call hasBit (. (index (. (. d mnodes) items) (index IDS 1)) flags) FL_ACTIVE)) (< (. d pressNode) 0)) "no stuck :active after the switch"))
    (expr (call ok (== CLICKS 1) "no click delivered for a press the inspector took over"))
    (expr (call (. d setInspector) (bool true)))
    (expr (call (. d simInput) bx by (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d setInspector) (bool false)))
    (expr (call (. d simInput) bx by (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) bx by (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== CLICKS 1) "no phantom click when the button is held while it turns off"))
    (expr (call (. d setInspector) (bool false)))
    (expr (call click (& d) (index IDS 1)))
    (expr (call ok (== CLICKS 2) "clicks reach the app again once it is off"))
    (expr (call printLn "inspect_test ok")))))
--- stderr
--- exit 0
