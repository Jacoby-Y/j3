(file (module j2_limits_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Error Args Value Limits))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys (names panic monotonicMs))
  (fn quiet (params (_vm (ref Vm)) (_args Args)) Value (block
    (return (call (. j2 nil)))))
  (fn check (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn newVm (params (mem (ref Arena)) (limits Limits)) Vm (block
    (let vm _ (call (. Vm new) mem limits))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" quiet))
    (return vm)))
  (fn loadErr (params (vm (ref Vm)) (name string) (src string)) Error (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "expected an error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (return e))))))
  (fn (doc "The VM is clean and the next call works.") usable (params (vm (ref Vm)) (what string)) _ (block
    (if (|| (|| (|| (!= (. vm nframes) 0) (!= (. vm top) 0)) (!= (. vm open) (as 0 ptr))) (!= (. vm callDepth) 0)) (block
      (expr (call panic what))))
    (match (call (. vm loadString) "ok" "fn f(n) { if n < 2 { return n; } return f(n - 1) + f(n - 2); } let x = f(15);")
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic what)))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (let vm _ (call newVm (& mem) (struct-lit Limits (field stepsPerCall 500000) (field maxDepth 50))))
    (let e _ (call loadErr (& vm) "tr" "fn a(x) { return b(x) + 1; }\nfn b(x) {\n    return c(x);\n}\nfn c(x) { return x.y.z; }\na(nil);"))
    (expr (call check (. e message) "tr:5:19: can't read field \"y\" of nil" "message"))
    (expr (call check (. e chunk) "tr" "chunk"))
    (if (|| (!= (. e line) 5) (!= (. e col) 19)) (block
      (expr (call panic "line:col"))))
    (expr (call check (. e trace) "at fn c (tr:5)\nat fn b (tr:3)\nat fn a (tr:1)\nat fn main (tr:6)" "trace"))
    (expr (call usable (& vm) "after a field error"))
    (= e (call loadErr (& vm) "deep" "fn r(n) { if n == 0 { return (fn() { return 1 / 0; })(); } return r(n - 1); }\nr(20);"))
    (expr (call check (. e trace) "at fn (anonymous) (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)\nat fn r (deep:1)" "trace cut at 8"))
    (= e (call loadErr (& vm) "er" "fn hurt(hp) { if hp < 0 { error(\"hp is\", hp); } }\nhurt(-2);"))
    (expr (call check (. e message) "er:1:32: hp is -2" "error()"))
    (expr (call usable (& vm) "after error()"))
    (let t0 _ (call monotonicMs))
    (= e (call loadErr (& vm) "inf" "let i = 0;\nwhile true { i += 1; }"))
    (let took _ (- (call monotonicMs) t0))
    (expr (call check (. e message) "inf:2:1: took too long (over 500000 steps)" "steps"))
    (if (> took 1000) (block
      (expr (call printLn (interp "while true took " took " ms")))
      (expr (call panic "step budget too slow"))))
    (= e (call loadErr (& vm) "inf2" "fn spin() { for i in 0..1000000000 { } }\nspin();"))
    (expr (call check (. e message) "inf2:1:13: took too long (over 500000 steps)" "range loop steps"))
    (= e (call loadErr (& vm) "inf3" "fn f(n) { return f(n) + g(n); }\nfn g(n) { if n > 0 { return g(n - 1) + g(n - 1); } return 0; }\ng(40);"))
    (expr (call check (. e message) "inf3:2:30: took too long (over 500000 steps)" "call steps"))
    (expr (call usable (& vm) "after the step budget"))
    (= e (call loadErr (& vm) "so" "fn r(n) { return r(n + 1); }\nr(0);"))
    (expr (call check (. e message) "so:1:19: stack overflow" "stack overflow"))
    (expr (call usable (& vm) "after stack overflow"))
    (let mem2 _ (call (. Arena create) (<< 1 16)))
    (let small _ (call newVm (& mem2) (struct-lit Limits (field heapBytes (<< 1 20)))))
    (let poke _ (call (. j2 nil)))
    (match (call (. small loadString) "p" "let t = { a: 1 };\npub fn poke() { t.a = t.a + 1; return t.a; }")
      (arm (pats (variant Result.Ok (bind x))) (block
        (= poke (call (. (call (. x asTable)) get) "poke"))
        (expr (call (. small keep) poke))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "load poke")))))
    (= e (call loadErr (& small) "mem" "let t = [];\nlet i = 0;\nwhile true { t[i] = { a: i, b: \"x\" + i }; i += 1; }"))
    (let m _ (. e message))
    (let tail _ ": out of script memory")
    (if (|| (|| (< (. m len) (+ 6 (. tail len))) (! (== (slice-expr m 0 6) "mem:3:"))) (! (== (slice-expr m (- (. m len) (. tail len)) (. m len)) tail))) (block
      (expr (call printLn (. e message)))
      (expr (call panic "out of memory"))))
    (if (> (. (. small heap) bytes) (<< 3 20)) (block
      (expr (call panic "allocated far past the cap"))))
    (if (|| (|| (!= (. small nframes) 0) (!= (. small top) 0)) (!= (. small callDepth) 0)) (block
      (expr (call panic "not unwound after out of memory"))))
    (match (call (. small call) (call (. small global) (call (. j2 str) (& small) "print")) (slice-from (as 0 ptr) 0))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (bind err))) (block
        (expr (call printLn (. err message)))
        (expr (call panic "vm unusable after out of memory")))))
    (match (call (. small call) poke (slice-from (as 0 ptr) 0))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (!= (. v bits) 2) (block
          (expr (call panic "poke"))))))
      (arm (pats (variant Result.Err (bind err))) (block
        (expr (call printLn (. err message)))
        (expr (call panic "code that doesn't allocate fails after out of memory")))))
    (expr (call (. small destroy)))
    (let slow (array 3 string) (array-lit "let a = \"a\";\nfor i in 0..16 { a = a + a; }\nlet p = a + \"b\";\nlet r = contains(a + a, p);" "let a = \"a\";\nfor i in 0..16 { a = a + a; }\nlet p = a + \"b\";\nlet r = split(a + a, p);" "let a = [];\nfor i in 0..1000000 { insert(a, 0, i); }"))
    (for-each _ src slow (block
      (let t1 _ (call monotonicMs))
      (= e (call loadErr (& vm) "slow" src))
      (let ms _ (- (call monotonicMs) t1))
      (let m2 _ (. e message))
      (let want _ ": took too long (over 500000 steps)")
      (if (|| (! (== (slice-expr m2 (- (. m2 len) (. want len)) (. m2 len)) want)) (> ms 3000)) (block
        (expr (call printLn (interp m2 " (" ms " ms)")))
        (expr (call panic "native work not charged"))))))
    (expr (call usable (& vm) "after a charged native"))
    (let mem3 _ (call (. Arena create) (<< 1 16)))
    (let tiny _ (call newVm (& mem3) (struct-lit Limits (field heapBytes (<< 1 20)))))
    (let big (array 2 string) (array-lit "let s = \"ab\";\nfor i in 0..60 { s = s + s; }" "let a = [];\nfor i in 0..1000 { push(a, i); }\nlet b = [];\nfor i in 0..1000 { push(b, a); }\nlet s = str([b, b, b]);"))
    (for-each _ src big (block
      (let t2 _ (call monotonicMs))
      (= e (call loadErr (& tiny) "big" src))
      (let ms2 _ (- (call monotonicMs) t2))
      (if (|| (! (== (slice-expr (. e message) (- (. (. e message) len) (. tail len)) (. (. e message) len)) tail)) (> ms2 3000)) (block
        (expr (call printLn (interp (. e message) " (" ms2 " ms)")))
        (expr (call panic "string past the cap"))))
      (if (> (. (. tiny heap) bytes) (<< 1 20)) (block
        (expr (call printLn (interp "heap bytes " (. (. tiny heap) bytes))))
        (expr (call panic "a string op overshot the cap"))))
      (expr (call usable (& tiny) "after a string past the cap"))))
    (expr (call (. tiny destroy)))
    (expr (call (. vm destroy)))
    (expr (call printLn "j2_limits_test ok")))))
--- stderr
--- exit 0
