(file (module elements_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains same Text))
  (use j3.ui.a11y)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (use j3.ui.uastyle)
  (use j3.ui.textsel)
  (mod-let CHECKS int _)
  (mod-let ID (array 16 int) _)
  (mod-let BRS int _)
  (mod-let BRCLS string _)
  (mod-let PV f32 _)
  (mod-let MV f32 _)
  (mod-let NOIND bool _)
  (mod-let OPEN bool _)
  (mod-let TOGGLES int _)
  (mod-let BODY bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff tol) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b)))
      (expr (call panic msg))))))
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, summary, p { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .nw { white-space: nowrap; } .sel { user-select: text; } .hud { --j3-meter-bad: #ff00aa; } .p { width: 100px; } .m { width: 100px; } details { width: 100px; } details:open { width: 200px; } details:open > summary { width: 77px; } summary { width: 50px; }")
  (const (doc "The same sheet after a hot reload: the `.hud` meters turn green.") SHEET2 string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, summary, p { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .nw { white-space: nowrap; } .sel { user-select: text; } .hud { --j3-meter-bad: #00ff00; } .p { width: 100px; } .m { width: 100px; } details { width: 100px; } details:open { width: 200px; } details:open > summary { width: 77px; } summary { width: 50px; }")
  (fn (doc "0: `ab cd`; 1: `ab<br>cd`; 2: `ab<br>` ; 3: `ab<br><br>cd`; 4: `<br>`") brFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let b _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) b "box"))
    (if (> (. BRCLS len) 0) (block
      (expr (call (. d cls) b BRCLS))))
    (= (index ID 0) b)
    (if (== BRS 4) (block
      (expr (call (. d open) 0 (call (. d tag) "br") 1))
      (expr (call (. d close)))) (block
      (expr (call (. d text) "ab"))
      (if (== BRS 0) (block
        (expr (call (. d text) " cd"))) (block
        (expr (call (. d open) 0 (call (. d tag) "br") 1))
        (expr (call (. d close)))
        (if (== BRS 3) (block
          (expr (call (. d open) 1 (call (. d tag) "br") 1))
          (expr (call (. d close)))))
        (if (!= BRS 2) (block
          (expr (call (. d text) "cd"))))))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn brHeight (params (d (ref Dom)) (kind int) (cls string)) f32 (block
    (= BRS kind)
    (= BRCLS cls)
    (expr (call brFrame d))
    (expr (call brFrame d))
    (return (. (index (. (. d nodes) items) (index ID 0)) h))))
  (fn testBr (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let one _ (call brHeight (& d) 0 ""))
    (expr (call ok (> one (float 0x4020000000000000)) "a line has a height"))
    (expr (call near (call brHeight (& d) 1 "") (* (float 0x4000000000000000) one) (float 0x3fe3333333333333) "br breaks the line in normal text"))
    (expr (call near (call brHeight (& d) 1 "nw") (* (float 0x4000000000000000) one) (float 0x3fe3333333333333) "br breaks the line under nowrap too"))
    (expr (call near (call brHeight (& d) 2 "") one (float 0x3fe3333333333333) "a trailing br adds no line"))
    (expr (call near (call brHeight (& d) 3 "") (* (float 0x4008000000000000) one) (float 0x3fe3333333333333) "two br leave an empty line"))
    (expr (call near (call brHeight (& d) 4 "") one (float 0x3fe3333333333333) "a lone br is one line"))
    (expr (call brHeight (& d) 1 "sel"))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call brFrame (& d)))
    (expr (call brFrame (& d)))
    (expr (call ok (call same (call (. textsel selected) (& d)) "ab\ncd") "copy of a<br>b is a newline"))
    (expr (call brHeight (& d) 3 "sel"))
    (expr (call (. d simKeys) "" "C+a"))
    (expr (call brFrame (& d)))
    (expr (call brFrame (& d)))
    (expr (call ok (call same (call (. textsel selected) (& d)) "ab\ncd") "two br copy as one newline between the texts"))))
  (fn gaugeFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let p _ (call (. d open) 0 (call (. d tag) "progress") 1))
    (expr (call (. d cls) p "p"))
    (expr (call (. d attrValue) p PV))
    (expr (call (. d attrMax) p (float 0x4000000000000000)))
    (= (index ID 1) p)
    (expr (call (. d close)))
    (let ind _ (call (. d open) 1 (call (. d tag) "progress") 1))
    (expr (call (. d attrValue) ind (if-expr NOIND (float 0x3fe0000000000000) (- (float 0x3ff0000000000000)))))
    (expr (call (. d attrMax) ind (float 0x3ff0000000000000)))
    (= (index ID 2) ind)
    (expr (call (. d close)))
    (let hud _ (call (. d open) 4 (call (. d tag) "div") 1))
    (expr (call (. d cls) hud "hud"))
    (let m2 _ (call (. d open) 0 (call (. d tag) "meter") 1))
    (expr (call (. d attrValue) m2 (float 0x3ff0000000000000)))
    (expr (call (. d attrMax) m2 (float 0x4024000000000000)))
    (expr (call (. d attrMeter) m2 0 (float 0x4008000000000000)))
    (expr (call (. d attrMeter) m2 1 (float 0x401c000000000000)))
    (expr (call (. d attrMeter) m2 2 (float 0x4024000000000000)))
    (= (index ID 8) m2)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let m _ (call (. d open) 2 (call (. d tag) "meter") 1))
    (expr (call (. d cls) m "m"))
    (expr (call (. d attrValue) m MV))
    (expr (call (. d attrMin) m (float 0x0000000000000000)))
    (expr (call (. d attrMax) m (float 0x4024000000000000)))
    (expr (call (. d attrMeter) m 0 (float 0x4008000000000000)))
    (expr (call (. d attrMeter) m 1 (float 0x401c000000000000)))
    (expr (call (. d attrMeter) m 2 (float 0x4024000000000000)))
    (= (index ID 3) m)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn testGauges (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= PV (float 0x3fe0000000000000))
    (= MV (float 0x4022000000000000))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call near (. (index (. (. d nodes) items) (index ID 1)) w) (float 0x4059000000000000) (float 0x3fb999999999999a) "a progress takes its width"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 1)) h) (float 0x4020000000000000) (float 0x3fb999999999999a) "and the default 8px height"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 2)) w) (float 0x4064000000000000) (float 0x3fb999999999999a) "the default width is 160"))
    (expr (call near (call (. dom gaugeFrac) (& d) (index ID 1)) (float 0x3fd0000000000000) (float 0x3f50624dd2f1a9fc) "progress fill is value / max"))
    (= PV (float 0x4014000000000000))
    (expr (call gaugeFrame (& d)))
    (expr (call near (call (. dom gaugeFrac) (& d) (index ID 1)) (float 0x3ff0000000000000) (float 0x3f50624dd2f1a9fc) "and never more than the track"))
    (expr (call near (call (. dom gaugeFrac) (& d) (index ID 2)) (- (float 0x3ff0000000000000)) (float 0x3f50624dd2f1a9fc) "no value is indeterminate"))
    (expr (call near (call (. dom gaugeFrac) (& d) (index ID 3)) (float 0x3feccccccccccccd) (float 0x3f50624dd2f1a9fc) "meter fill is (value - min) / (max - min)"))
    (expr (call ok (== (call (. dom meterGrade) (& d) (index ID 3)) 0) "a value in the optimum region is good"))
    (= MV (float 0x4014000000000000))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (== (call (. dom meterGrade) (& d) (index ID 3)) 1) "the middle region next to the optimum is ok"))
    (= MV (float 0x3ff0000000000000))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (== (call (. dom meterGrade) (& d) (index ID 3)) 2) "the far region is bad"))
    (expr (call ok (== (call (. dom meterFill) (& d) (index ID 3) (. (index (. (. d nodes) items) (index ID 3)) style)) 4166076927) "a bad meter has the default bad color"))
    (expr (call ok (== (call (. dom meterGrade) (& d) (index ID 8)) 2) "the scoped meter is bad too"))
    (expr (call ok (== (call (. dom meterFill) (& d) (index ID 8) (. (index (. (. d nodes) items) (index ID 8)) style)) 4278233855) "a scoped --j3-meter-bad overrides it"))
    (= MV (float 0x4022000000000000))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (== (call (. dom meterFill) (& d) (index ID 3) (. (index (. (. d nodes) items) (index ID 3)) style)) 1069109503) "a good meter has the default good color"))
    (let x0 _ (call (. dom sweepX) (& d) (float 0x4064000000000000) (float 0x4050000000000000)))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (let x1 _ (call (. dom sweepX) (& d) (float 0x4064000000000000) (float 0x4050000000000000)))
    (expr (call ok (!= x0 x1) "the indeterminate bar sweeps"))
    (expr (call ok (call (. d isLive)) "a visible indeterminate progress keeps the page live"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (! (call (. d isLive))) "not under reduced motion"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (call (. d isLive)) "live again"))
    (= NOIND (bool true))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (! (call (. d isLive))) "idle once the progress has a value"))
    (= NOIND (bool false))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (call (. d isLive)) "and live when it loses it"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call gaugeFrame (& d)))
    (expr (call near (call (. dom sweepX) (& d) (float 0x4064000000000000) (float 0x4050000000000000)) (float 0x4048000000000000) (float 0x3f847ae147ae147b) "under reduced motion it sits in the middle"))
    (expr (call gaugeFrame (& d)))
    (expr (call near (call (. dom sweepX) (& d) (float 0x4064000000000000) (float 0x4050000000000000)) (float 0x4048000000000000) (float 0x3f847ae147ae147b) "and stays"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call gaugeFrame (& d)))
    (let t _ (call (. Text new) mem))
    (expr (call (. a11y dump) (& d) mem (& t)))
    (let s _ (call (. t str)))
    (expr (call ok (call contains s "progressbar") "progress has the progressbar role"))
    (expr (call ok (call contains s "meter") "meter has the meter role"))
    (expr (call ok (call contains s "now=1") "a meter value is exposed"))
    (expr (call gaugeFrame (& d)))
    (let r0 _ (. d restyled))
    (let l0 _ (. d laid))
    (for i (.. 0 10) (block
      (expr (call gaugeFrame (& d)))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d laid) l0)) "idle gauge frames neither restyle nor lay out"))
    (expr (call ok (== (call (. dom meterFill) (& d) (index ID 8) (. (index (. (. d nodes) items) (index ID 8)) style)) 4278233855) "before the reload"))
    (expr (call (. css reset)))
    (expr (call (. uastyle load) css))
    (expr (call parse css SHEET2 "elements.css" 1))
    (expr (call (. d restyle)))
    (expr (call gaugeFrame (& d)))
    (expr (call gaugeFrame (& d)))
    (expr (call ok (== (call (. dom meterFill) (& d) (index ID 8) (. (index (. (. d nodes) items) (index ID 8)) style)) 16711935) "after the reload the scoped color is the new one"))))
  (fn (doc "`<details>` with a summary and a body div holding an input; OPEN is bound the way `bind:open` generates it.") detailsFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let det _ (call (. d open) 0 (call (. d tag) "details") 1))
    (= (index ID 4) det)
    (if (call (. d userToggled) det) (block
      (= OPEN (call (. d isOpen) det))))
    (if (call (. d toggled) det) (block
      (+= TOGGLES 1)))
    (expr (call (. d attrOpen) det OPEN))
    (let sm _ (call (. d open) 0 (call (. d tag) "summary") 1))
    (expr (call (. d attrTabIndex) sm))
    (expr (call (. d attrDraggable) sm (bool true)))
    (= (index ID 5) sm)
    (expr (call (. d text) "Sum"))
    (expr (call (. d close)))
    (let body _ (call (. d open) 1 (call (. d tag) "div") 1))
    (= (index ID 6) body)
    (let ip _ (call (. d open) 0 (call (. d tag) "input") 1))
    (expr (call (. d attrType) ip "text"))
    (= (index ID 7) ip)
    (expr (call (. d close)))
    (expr (call (. d text) "body text"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn step (params (d (ref Dom)) (x f32) (y f32) (down bool)) _ (block
    (expr (call (. d simInput) x y down (float 0x0000000000000000)))
    (expr (call detailsFrame d))))
  (fn clickSummary (params (d (ref Dom)) (f0 int)) _ (block
    (for f (.. f0 (+ f0 3)) (block
      (expr (call (. testkit click) d f f0 (index ID 5)))
      (expr (call detailsFrame d))))))
  (fn testDetails (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= OPEN (bool false))
    (= TOGGLES 0)
    (expr (call detailsFrame (& d)))
    (expr (call detailsFrame (& d)))
    (expr (call ok (! (call (. d isOpen) (index ID 4))) "closed at first"))
    (expr (call ok (== (. (index (. (. d nodes) items) (index ID 6)) disp) (. dom DP_NONE)) "a closed details hides its content"))
    (expr (call ok (!= (. (index (. (. d nodes) items) (index ID 5)) disp) (. dom DP_NONE)) "but shows its summary"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 4)) w) (float 0x4059000000000000) (float 0x3fb999999999999a) "closed style"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) (index ID 6)) kind) (. dom K_ELEM)) (== (. (index (. (. d nodes) items) (index ID 7)) kind) (. dom K_ELEM))) "the content stays mounted"))
    (expr (call clickSummary (& d) 2))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (call (. d isOpen) (index ID 4)) OPEN) "a click opens it and the bound variable follows"))
    (expr (call ok (== TOGGLES 1) "one toggle event"))
    (expr (call ok (!= (. (index (. (. d nodes) items) (index ID 6)) disp) (. dom DP_NONE)) "the content shows"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 4)) w) (float 0x4069000000000000) (float 0x3fb999999999999a) ":open restyles the details"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 5)) w) (float 0x4053400000000000) (float 0x3fb999999999999a) ":open > summary restyles the summary"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 6)) h) (- (+ (. (index (. (. d nodes) items) (index ID 7)) h) (. (index (. (. d nodes) items) (index ID 6)) h)) (. (index (. (. d nodes) items) (index ID 7)) h)) (float 0x3fb999999999999a) "body is laid out"))
    (expr (call ok (> (. (index (. (. d nodes) items) (index ID 6)) h) (float 0x0000000000000000)) "the body has a height once open"))
    (let body _ (index ID 6))
    (let ip _ (index ID 7))
    (= OPEN (bool false))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (! (call (. d isOpen) (index ID 4))) (== (. (index (. (. d nodes) items) body) disp) (. dom DP_NONE))) "the program closes it"))
    (expr (call near (. (index (. (. d nodes) items) (index ID 4)) w) (float 0x4059000000000000) (float 0x3fb999999999999a) "and :open stops matching"))
    (= OPEN (bool true))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (== (index ID 6) body) (== (index ID 7) ip)) "the same nodes come back"))
    (expr (call ok (&& (call (. d isOpen) (index ID 4)) (!= (. (index (. (. d nodes) items) body) disp) (. dom DP_NONE))) "the program opens it"))
    (expr (call detailsFrame (& d)))
    (expr (call ok (== TOGGLES 3) "the program's close and then its open each fired toggle once, a frame later"))
    (expr (call detailsFrame (& d)))
    (expr (call ok (== TOGGLES 3) "and nothing fires twice"))
    (expr (call (. d focusNode) (index ID 5)))
    (expr (call detailsFrame (& d)))
    (expr (call (. d simKeys) "" "Enter"))
    (expr (call detailsFrame (& d)))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (! (call (. d isOpen) (index ID 4))) (! OPEN)) "Enter on the focused summary closes it"))
    (expr (call ok (== TOGGLES 4) "one toggle for the key"))
    (expr (call (. d simKeys) "" "Space"))
    (expr (call detailsFrame (& d)))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (call (. d isOpen) (index ID 4)) OPEN) "Space opens it"))
    (expr (call ok (== TOGGLES 5) "and one for Space"))
    (expr (call detailsFrame (& d)))
    (let t0 _ TOGGLES)
    (let was _ (call (. d isOpen) (index ID 4)))
    (let sx _ (+ (call (. d absX) (index ID 5)) (float 0x4008000000000000)))
    (let sy _ (+ (call (. d absY) (index ID 5)) (float 0x4008000000000000)))
    (expr (call step (& d) sx sy (bool false)))
    (expr (call step (& d) sx sy (bool true)))
    (expr (call step (& d) (+ sx (float 0x4028000000000000)) sy (bool true)))
    (expr (call step (& d) (float 0x4072c00000000000) (float 0x4072c00000000000) (bool true)))
    (expr (call step (& d) (float 0x4072c00000000000) (float 0x4072c00000000000) (bool false)))
    (expr (call step (& d) (float 0x4072c00000000000) (float 0x4072c00000000000) (bool false)))
    (expr (call ok (&& (== TOGGLES t0) (== (call (. d isOpen) (index ID 4)) was)) "a drag from the summary to elsewhere does not toggle"))
    (expr (call step (& d) sx sy (bool false)))
    (expr (call step (& d) sx sy (bool true)))
    (expr (call step (& d) (+ sx (float 0x4028000000000000)) sy (bool true)))
    (expr (call step (& d) (+ sx (float 0x403e000000000000)) sy (bool true)))
    (expr (call step (& d) (+ sx (float 0x403e000000000000)) sy (bool false)))
    (expr (call step (& d) (+ sx (float 0x403e000000000000)) sy (bool false)))
    (expr (call ok (&& (== TOGGLES t0) (== (call (. d isOpen) (index ID 4)) was)) "a drag that ends on the summary does not toggle"))
    (expr (call step (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false)))
    (expr (call ok (== (call (. dom isFocusable) (& d) (index ID 7)) (call (. d isOpen) (index ID 4))) "content is focusable only while open"))
    (= OPEN (bool true))
    (expr (call detailsFrame (& d)))
    (expr (call detailsFrame (& d)))
    (expr (call ok (call (. dom isFocusable) (& d) (index ID 7)) "open: the input takes Tab"))
    (expr (call (. d focusNode) (index ID 7)))
    (expr (call detailsFrame (& d)))
    (expr (call ok (== (. d focus) (index ID 7)) "focus is in the content"))
    (= OPEN (bool false))
    (expr (call detailsFrame (& d)))
    (expr (call ok (&& (!= (. d focus) (index ID 7)) (! (call (. dom isFocusable) (& d) (index ID 7)))) "closing drops the focus from the content at once"))
    (expr (call detailsFrame (& d)))
    (expr (call ok (|| (< (. d focus) 0) (call (. dom styleVisible) (& d) (. d focus))) "never a focused invisible node"))
    (= OPEN (bool true))
    (expr (call detailsFrame (& d)))
    (expr (call detailsFrame (& d)))
    (let t _ (call (. Text new) mem))
    (expr (call (. a11y dump) (& d) mem (& t)))
    (let s _ (call (. t str)))
    (expr (call ok (&& (call contains s "button") (call contains s "expanded=true")) "an open summary is an expanded button"))
    (= OPEN (bool false))
    (expr (call detailsFrame (& d)))
    (let t2 _ (call (. Text new) mem))
    (expr (call (. a11y dump) (& d) mem (& t2)))
    (expr (call ok (call contains (call (. t2 str)) "expanded=false") "a closed one is not expanded"))
    (expr (call detailsFrame (& d)))
    (let r0 _ (. d restyled))
    (let l0 _ (. d laid))
    (for i (.. 0 10) (block
      (expr (call detailsFrame (& d)))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d laid) l0)) "idle details frames neither restyle nor lay out"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "elements.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (expr (call testBr (& mem) (& css)))
    (expr (call testGauges (& mem) (& css)))
    (expr (call testDetails (& mem) (& css)))
    (expr (call printLn (interp "elements_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
