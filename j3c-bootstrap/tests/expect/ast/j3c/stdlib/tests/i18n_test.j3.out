(file (module i18n_test)
  (use j3.i18n)
  (use j3.i18n (names Arg named num real t tf tf2))
  (use j3.io (names printLn writeFile))
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names same scratchText))
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CHECKS int _)
  (mod-let TID int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (got string) (want string) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! (call same got want)) (block
      (expr (call printLn (interp "FAIL: " msg ": got \"" got "\" want \"" want "\"")))
      (expr (call panic msg))))))
  (fn pl (params (lang string) (n int) (want string)) _ (block
    (expr (call eq (call (. i18n plural) lang n (bool false)) want (interp "plural " lang " " n)))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4059000000000000)))))
    (let a _ (call (. d open) 0 (call (. d tag) "div") 1))
    (= TID (call (. d text) (call t "app.title")))
    (expr (call (. d close)))
    (let b _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d text) (call tf "shop.items" (call named "count" (call num 3)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn main (params) _ (block
    (expr (call (. i18n quiet) (bool true)))
    (expr (call (. i18n init) "j3c/stdlib/tests/i18n_locales" "en" "en"))
    (expr (call eq (call t "app.title") "Shop" "en title"))
    (expr (call eq (call t "multi") "line one\nline two" "escape"))
    (expr (call eq (call tf "braces" (call text0)) "{literal} x" "doubled braces"))
    (expr (call ok (&& (call (. i18n has) "shop.buy") (! (call (. i18n has) "nope"))) "has"))
    (expr (call eq (call tf2 "shop.buy" (call num 1234567) (call named "price" (call real (float 0x4004000000000000)))) "Buy 1,234,567 for 2.5" "placeholders"))
    (expr (call eq (call tf "shop.buy" (call num 3)) "Buy 3 for {price}" "unknown placeholder stays"))
    (expr (call (. i18n setLocale) "de"))
    (expr (call eq (call t "app.title") "Laden" "de"))
    (expr (call eq (call t "only.en") "Only English" "de falls back to en"))
    (expr (call (. i18n setLocale) "pt-BR"))
    (expr (call eq (call t "app.title") "Loja" "pt-BR uses pt"))
    (expr (call eq (call t "only.pt") "So pt" "pt-BR base"))
    (expr (call eq (call t "only.en") "Only English" "pt-BR falls to en"))
    (expr (call ok (! (call (. i18n rtl))) "pt not rtl"))
    (let m0 _ (call (. i18n missing)))
    (expr (call eq (call t "zz.missing") "zz.missing" "missing returns key"))
    (expr (call eq (call t "zz.missing") "zz.missing" "missing again"))
    (expr (call ok (== (call (. i18n missing)) (+ m0 1)) "missing warned once per key"))
    (expr (call pl "en" 0 "other"))
    (expr (call pl "en" 1 "one"))
    (expr (call pl "en" 2 "other"))
    (expr (call pl "en" 101 "other"))
    (expr (call eq (call (. i18n plural) "en" 1 (bool true)) "other" "en 1.5"))
    (expr (call pl "de" 1 "one"))
    (expr (call pl "de" 0 "other"))
    (expr (call pl "es" 0 "other"))
    (expr (call pl "es" 1 "one"))
    (expr (call pl "it" 1 "one"))
    (expr (call pl "it" 5 "other"))
    (expr (call pl "fr" 0 "one"))
    (expr (call pl "fr" 1 "one"))
    (expr (call pl "fr" 2 "other"))
    (expr (call eq (call (. i18n plural) "fr" 1 (bool true)) "one" "fr 1.5"))
    (expr (call pl "pt" 0 "one"))
    (expr (call pl "pt-BR" 1 "one"))
    (expr (call pl "pt" 2 "other"))
    (expr (call pl "ru" 0 "many"))
    (expr (call pl "ru" 1 "one"))
    (expr (call pl "ru" 2 "few"))
    (expr (call pl "ru" 3 "few"))
    (expr (call pl "ru" 5 "many"))
    (expr (call pl "ru" 11 "many"))
    (expr (call pl "ru" 21 "one"))
    (expr (call pl "ru" 22 "few"))
    (expr (call pl "ru" 101 "one"))
    (expr (call pl "ru" 112 "many"))
    (expr (call eq (call (. i18n plural) "ru" 1 (bool true)) "other" "ru 1.5"))
    (expr (call pl "uk" 21 "one"))
    (expr (call pl "uk" 3 "few"))
    (expr (call pl "pl" 0 "many"))
    (expr (call pl "pl" 1 "one"))
    (expr (call pl "pl" 2 "few"))
    (expr (call pl "pl" 5 "many"))
    (expr (call pl "pl" 11 "many"))
    (expr (call pl "pl" 21 "many"))
    (expr (call pl "pl" 22 "few"))
    (expr (call pl "pl" 101 "many"))
    (expr (call pl "ar" 0 "zero"))
    (expr (call pl "ar" 1 "one"))
    (expr (call pl "ar" 2 "two"))
    (expr (call pl "ar" 3 "few"))
    (expr (call pl "ar" 5 "few"))
    (expr (call pl "ar" 11 "many"))
    (expr (call pl "ar" 21 "many"))
    (expr (call pl "ar" 22 "many"))
    (expr (call pl "ar" 101 "other"))
    (expr (call pl "ar" 102 "other"))
    (expr (call eq (call (. i18n plural) "ar" 1 (bool true)) "other" "ar 1.5"))
    (for n (.. 0 4) (block
      (expr (call pl "ja" n "other"))
      (expr (call pl "zh" n "other"))
      (expr (call pl "ko" n "other"))))
    (expr (call (. i18n setLocale) "en"))
    (expr (call eq (call tf "shop.items" (call num 1)) "1 item" "en one"))
    (expr (call eq (call tf "shop.items" (call num 2)) "2 items" "en other"))
    (expr (call eq (call tf "shop.items" (call real (float 0x3ff8000000000000))) "1.5 items" "en 1.5"))
    (expr (call (. i18n setLocale) "ru"))
    (expr (call eq (call tf "shop.items" (call num 2)) "2 \xd1\x88\xd1\x82\xd1\x83\xd0\xba\xd0\xb8" "ru few"))
    (expr (call eq (call tf "shop.items" (call num 5)) "5 \xd1\x88\xd1\x82\xd1\x83\xd0\xba" "ru many"))
    (expr (call eq (call tf "shop.items" (call num 21)) "21 \xd1\x88\xd1\x82\xd1\x83\xd0\xba\xd0\xb0" "ru one"))
    (expr (call (. i18n setLocale) "ar"))
    (expr (call ok (call (. i18n rtl)) "ar is rtl"))
    (expr (call eq (call tf "shop.items" (call num 0)) "\xd9\x84\xd8\xa7 \xd8\xb9\xd9\x86\xd8\xa7\xd8\xb5\xd8\xb1" "ar zero"))
    (expr (call eq (call tf "shop.items" (call num 2)) "\xd8\xb9\xd9\x86\xd8\xb5\xd8\xb1\xd8\xa7\xd9\x86" "ar two"))
    (expr (call eq (call tf "shop.items" (call num 101)) "101 \xd8\xb9\xd9\x86\xd8\xb5\xd8\xb1" "ar other"))
    (expr (call (. i18n setLocale) "en"))
    (expr (call eq (call (. i18n fmtNum) 1234567) "1,234,567" "en num"))
    (expr (call eq (call (. i18n fmtNum) (- 1234)) "-1,234" "en negative"))
    (expr (call eq (call (. i18n fmtNum) 999) "999" "en small"))
    (expr (call eq (call (. i18n fmtReal) (float 0x40934a0000000000)) "1,234.5" "en real"))
    (expr (call eq (call (. i18n fmtReal) (- (float 0x3fd0000000000000))) "-0.25" "en negative real"))
    (expr (call (. i18n setLocale) "de"))
    (expr (call eq (call (. i18n fmtNum) 1234567) "1.234.567" "de num"))
    (expr (call eq (call (. i18n fmtReal) (float 0x40934a0000000000)) "1.234,5" "de real"))
    (expr (call (. i18n setLocale) "fr"))
    (expr (call eq (call (. i18n fmtNum) 1234567) "1\xe2\x80\xaf234\xe2\x80\xaf567" "fr num"))
    (expr (call (. i18n setLocale) "ru"))
    (expr (call eq (call (. i18n fmtNum) 1234) "1\xc2\xa0234" "ru num"))
    (expr (call (. i18n setLocale) "es"))
    (expr (call eq (call (. i18n fmtNum) 1234) "1234" "es four digits"))
    (expr (call eq (call (. i18n fmtNum) 12345) "12.345" "es five digits"))
    (let mem _ (call (. Arena create) (* (* 8 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) "div { width: 200px; height: 20px; }" "i18n.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. i18n setLocale) "en"))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call eq (call (. d textOf) TID) "Shop" "dom en"))
    (expr (call (. i18n setLocale) "de"))
    (expr (call frame (& d)))
    (expr (call eq (call (. d textOf) TID) "Laden" "dom de after setLocale"))
    (expr (call frame (& d)))
    (let r0 _ (. d restyled))
    (let l0 _ (. d laid))
    (for i (.. 0 30) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d laid) l0)) "idle frames neither restyle nor lay out"))
    (let path _ "/tmp/j3i18n_reload.txt")
    (let v1 _ "greet = Hello\n")
    (expr (call writeFile path (slice-from (as (. v1 ptr) ptr) (. v1 len))))
    (expr (call (. i18n init) "/tmp" "j3i18n_reload" "j3i18n_reload"))
    (expr (call eq (call t "greet") "Hello" "reload: first load"))
    (let ver _ (call (. i18n version)))
    (expr (call ok (! (call (. i18n reloadIfChanged))) "reload: nothing changed"))
    (expr (call ok (== (call (. i18n version)) ver) "reload: version steady"))
    (let v2 _ "greet = Howdy\n")
    (expr (call writeFile path (slice-from (as (. v2 ptr) ptr) (. v2 len))))
    (expr (call ok (call (. i18n reloadIfChanged)) "reload: change seen"))
    (expr (call eq (call t "greet") "Howdy" "reload: new text"))
    (expr (call ok (== (call (. i18n version)) (+ ver 1)) "reload: version bumped"))
    (expr (call ok (! (call (. i18n reloadIfChanged))) "reload: settled"))
    (for i (.. 0 300) (block
      (expr (call t (call fmtKey i)))))
    (expr (call ok (== (call (. i18n missing)) 256) "missing cap"))
    (expr (call printLn (interp "i18n_test: " CHECKS " checks passed")))))
  (fn text0 (params) Arg (block
    (return (call (. i18n text) "x"))))
  (fn fmtKey (params (i int)) string (block
    (let k _ (call scratchText))
    (expr (call (. k pushStr) "cap."))
    (expr (call (. k pushInt) i))
    (return (as (. k bytes) string)))))
--- stderr
--- exit 0
