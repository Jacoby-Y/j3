(file (module handles_test)
  (use j3.data.map.Map)
  (use j3.data.pool (names Id Pool))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (enum debug Expr
    (case Num int)
    (case Neg (ref Expr))
    (case Add (ref Expr) (ref Expr)))
  (struct Stmt
    (field name string)
    (field value (gen Id Expr)))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "handles_test"))))))
  (fn eval (params (e (ref Expr))) int (block
    (match (* e)
      (arm (pats (variant Expr.Num (bind n))) (block
        (return n)))
      (arm (pats (variant Expr.Neg (bind x))) (block
        (return (- 0 (call eval x)))))
      (arm (pats (variant Expr.Add (bind l) (bind r))) (block
        (return (+ (call eval l) (call eval r))))))))
  (fn count (params (e (ref Expr))) int (block
    (match (* e)
      (arm (pats (variant Expr.Num (wild))) (block
        (return 1)))
      (arm (pats (variant Expr.Neg (bind x))) (block
        (return (+ 1 (call count x)))))
      (arm (pats (variant Expr.Add (bind l) (bind r))) (block
        (return (+ (+ 1 (call count l)) (call count r))))))))
  (fn (doc "A balanced tree of `n` leaves 1..n (2n - 1 nodes), built bottom-up with `mem.new`.") build (params (mem (ref Arena)) (lo int) (hi int)) (ref Expr) (block
    (if (== lo hi) (block
      (return (call (. mem new) (call (. Expr Num) lo)))))
    (let mid _ (/ (+ lo hi) 2))
    (return (call (. mem new) (call (. Expr Add) (call build mem lo mid) (call build mem (+ mid 1) hi))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 16)))
    (let leaves _ 5000)
    (let tree _ (call build (& mem) 1 leaves))
    (expr (call ok (== (call count tree) (- (* 2 leaves) 1)) "10k nodes"))
    (expr (call ok (== (call eval tree) (/ (* leaves (+ leaves 1)) 2)) "walk sums the leaves"))
    (let chain _ (call (. mem new) (call (. Expr Num) 7)))
    (for _ (.. 0 10000) (block
      (= chain (call (. mem new) (call (. Expr Neg) chain)))))
    (expr (call ok (&& (== (call count chain) 10001) (== (call eval chain) 7)) "deep chain"))
    (expr (call ok (== (interp (* tree)) "Expr.Add(&Expr, &Expr)") "debug of a recursive enum"))
    (let exprs _ (call (. (type-path Pool Expr) new) (& mem)))
    (let stmts _ (call (. (type-path Pool Stmt) new) (& mem)))
    (let a _ (call (. exprs add) (call (. Expr Num) 1)))
    (let b _ (call (. exprs add) (call (. Expr Num) 2)))
    (let s _ (call (. stmts add) (struct-lit Stmt (field name "x") (field value b))))
    (expr (call ok (&& (== (call (. exprs len)) 2) (== (call (. stmts len)) 1)) "pool len"))
    (expr (call ok (&& (== (call eval (call (. exprs get) (. (call (. stmts get) s) value))) 2) (== (. (call (. stmts get) s) name) "x")) "pool get"))
    (expr (call ok (&& (== a (call (. exprs idAt) 0)) (!= a b)) "id equality"))
    (let p _ (call (. exprs get) a))
    (= (* p) (call (. Expr Num) 10))
    (expr (call ok (== (call eval (call (. exprs get) a)) 10) "pool get is a pointer"))
    (let uses _ (call (. (type-path Map (gen Id Expr) int) new) (& mem) 0))
    (for i (.. 0 1000) (block
      (let id _ (call (. exprs add) (call (. Expr Num) i)))
      (expr (call (. uses put) id (* i 2)))))
    (expr (call (. uses put) a (- 1)))
    (expr (call ok (&& (&& (== (. uses len) 1001) (== (call (. uses getOr) (call (. exprs idAt) 500) 0) 996)) (== (call (. uses getOr) a 0) (- 1))) "Id as Map key"))
    (expr (call printLn "handles_test ok")))))
--- stderr
--- exit 0
