(file (module term_width_test)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.term.width.cpWidth)
  (fn want (params (cp i32) (w int)) _ (block
    (let got _ (call cpWidth cp))
    (if (!= got w) (block
      (expr (call printLn (interp "FAIL: cp " cp " want " w " got " got)))
      (expr (call panic "cpWidth"))))))
  (fn testControls (params) _ (block
    (expr (call want 0 0))
    (expr (call want 7 0))
    (expr (call want 27 0))
    (expr (call want 127 0))
    (expr (call want 128 0))
    (expr (call want 159 0))
    (expr (call want (- 1) 0))))
  (fn testAscii (params) _ (block
    (for i (.. 32 127) (block
      (expr (call want (call i32 i) 1))))
    (expr (call want 160 1))
    (expr (call want 173 1))
    (expr (call want 233 1))
    (expr (call want 1114111 1))))
  (fn testWide (params) _ (block
    (expr (call want 20013 2))
    (expr (call want 12354 2))
    (expr (call want 44032 2))
    (expr (call want 65313 2))
    (expr (call want 128512 2))
    (expr (call want 4352 2))
    (expr (call want 4447 2))
    (expr (call want 4351 1))
    (expr (call want 127744 2))
    (expr (call want 128591 2))
    (expr (call want 128592 1))
    (expr (call want 129280 2))
    (expr (call want 129535 2))
    (expr (call want 129536 1))
    (expr (call want 262141 2))
    (expr (call want 262142 1))))
  (fn testZero (params) _ (block
    (expr (call want 769 0))
    (expr (call want 8203 0))
    (expr (call want 65039 0))
    (expr (call want 768 0))
    (expr (call want 879 0))
    (expr (call want 880 1))
    (expr (call want 4448 0))
    (expr (call want 4607 0))
    (expr (call want 4608 1))
    (expr (call want 917999 0))
    (expr (call want 918000 1))
    (expr (call want 12330 0))
    (expr (call want 12441 0))))
  (fn main (params) _ (block
    (expr (call testControls))
    (expr (call testAscii))
    (expr (call testWide))
    (expr (call testZero))
    (expr (call printLn "term_width_test ok")))))
--- stderr
--- exit 0
