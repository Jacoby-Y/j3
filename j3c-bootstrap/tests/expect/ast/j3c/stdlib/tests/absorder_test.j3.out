(file (module absorder_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.testkit)
  (const SHEET string ".page { position: relative; height: 100%; } .extra { position: absolute; left: 4px; top: 4px; } .panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; } .info { position: absolute; left: 112px; top: 32px; display: flex; flex-direction: column; } .card { position: absolute; width: 120px; } .toasts { position: absolute; top: 30px; } .settings { position: absolute; inset: 0; overflow-y: auto; } dialog { width: 100px; height: 80px; }")
  (fn (doc "The shape `Upgrades.j3ui` generates: `{#if extra}` box, then a panel holding `.info` and an `{#if hover}` card.") frame (params (d (ref Dom)) (extra bool) (hover bool) (cardX f32)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4084000000000000)) (field y (float 0x4076800000000000)))))
    (let page _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) page "page"))
    (if extra (block
      (let x _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) x "extra"))
      (expr (call (. d text) "Extra"))
      (expr (call (. d close)))))
    (let panel _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) panel "panel"))
    (let info _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) info "info"))
    (expr (call (. d text) "Info"))
    (expr (call (. d close)))
    (if hover (block
      (let c _ (call (. d open) 1 (call (. d tag) "div") 1))
      (expr (call (. d cls) c "card"))
      (expr (call (. d styleNum) c 0 "left" cardX))
      (expr (call (. d styleNum) c 1 "top" (float 0x4044000000000000)))
      (expr (call (. d text) "Card"))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "The shape of a settings page: `{#if}` toasts (absolute) ahead of an absolute scroller whose rows hold a modal dialog.") dialogFrame (params (d (ref Dom)) (toasts bool) (tick int)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4084000000000000)) (field y (float 0x4076800000000000)))))
    (let page _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) page "page"))
    (if toasts (block
      (let t _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) t "toasts"))
      (expr (call (. d text) "Toast"))
      (expr (call (. d close)))))
    (let s _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) s "settings"))
    (let g _ (call (. d open) 0 (call (. d tag) "dialog") 1))
    (expr (call (. d attrOverlay) g 1))
    (expr (call (. d text) (interp "Stats " tick)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for f (.. 0 40) (block
      (expr (call frame (& d) (< f 2) (&& (>= f 4) (!= (% f 7) 0)) (+ (float 0x4049000000000000) (* (call f32 f) (float 0x4022000000000000)))))
      (let info _ (. (index (. (. d nodes) items) (call (. testkit textNode) (& d) "Info")) parent))
      (if (|| (!= (call (. d absX) info) (float 0x405c000000000000)) (!= (call (. d absY) info) (float 0x4040000000000000))) (block
        (expr (call printLn (interp "FAIL: frame " f ": .info at " (call (. d absX) info) "," (call (. d absY) info))))
        (expr (call panic ".info lost its offsets"))))))
    (for f (.. 0 20) (block
      (expr (call dialogFrame (& d) (== (% (/ f 3) 2) 0) f))
      (let g _ (. (index (. (. d nodes) items) (call (. testkit textNode) (& d) (interp "Stats " f))) parent))
      (if (|| (!= (call (. d absX) g) (float 0x4070e00000000000)) (!= (call (. d absY) g) (float 0x4061800000000000))) (block
        (expr (call printLn (interp "FAIL: frame " f ": dialog at " (call (. d absX) g) "," (call (. d absY) g))))
        (expr (call panic "the dialog left the center"))))))
    (expr (call printLn "absorder_test: PASS")))))
--- stderr
--- exit 0
