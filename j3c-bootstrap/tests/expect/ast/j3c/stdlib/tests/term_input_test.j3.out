(file (module term_input_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.term.grid.MODE_CURSOR_KEYS)
  (use j3.term.grid.MODE_MOUSE_CLICK)
  (use j3.term.grid.MODE_MOUSE_DRAG)
  (use j3.term.grid.MODE_MOUSE_MOVE)
  (use j3.term.grid.MODE_MOUSE_SGR)
  (use j3.term.grid.MODE_PASTE)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi)
  (use j3.term.grid.Grid)
  (use j3.term.input)
  (use j3.term.input.Decoder)
  (use j3.term.input.Event)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eqi (params (a int) (b int) (msg string)) _ (block
    (if (!= a b) (block
      (expr (call printLn (interp "FAIL: " msg ": want " b " got " a)))
      (expr (call panic msg))))))
  (fn s (params (x string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 (. x len)) (block
      (expr (call (. t push) (if-expr (== (index x i) 64) 27 (index x i))))))
    (return (call (. t str)))))
  (fn byte (params (b u8) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. t push) b))
    (return (call (. t str)))))
  (fn bs (params (xs (slice int)) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for-each _ x xs (block
      (expr (call (. t push) (call u8 x)))))
    (return (call (. t str)))))
  (fn feed (params (d (ref Decoder)) (x string) (now int)) _ (block
    (expr (call (. d feed) (as x (slice u8)) now))))
  (fn expectKey (params (d (ref Decoder)) (key int) (mods int) (cp i32) (msg string)) _ (block
    (let ev _ (struct-lit Event))
    (expr (call ok (call (. d next) 0 (& ev)) msg))
    (expr (call eqi (. ev kind) (. input EV_KEY) msg))
    (expr (call eqi (. ev key) key msg))
    (expr (call eqi (. ev mods) mods msg))
    (expr (call eqi (call int (. ev cp)) (call int cp) msg))))
  (fn drained (params (d (ref Decoder)) (msg string)) _ (block
    (let ev _ (struct-lit Event))
    (expr (call ok (! (call (. d next) 100000 (& ev))) msg))))
  (fn key1 (params (d (ref Decoder)) (x string) (key int) (mods int) (cp i32) (msg string)) _ (block
    (expr (call feed d x 0))
    (expr (call expectKey d key mods cp msg))
    (expr (call drained d msg))))
  (fn enc (params (key int) (mods int) (cp i32) (modes int) (want string) (a (ref Arena)) (msg string)) _ (block
    (let t _ (call (. Text new) a))
    (expr (call (. input encodeKey) key mods cp modes (& t)))
    (if (! (== (call (. t str)) want)) (block
      (expr (call printLn (interp "FAIL: " msg ": want " (. want len) " bytes, got " (call (. t len)) ": " (call (. t str)))))
      (expr (call panic msg))))))
  (fn arrows (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (expr (call key1 (& d) (call s "@[A" a) (. input KEY_UP) 0 0 "up"))
    (expr (call key1 (& d) (call s "@[B" a) (. input KEY_DOWN) 0 0 "down"))
    (expr (call key1 (& d) (call s "@[C" a) (. input KEY_RIGHT) 0 0 "right"))
    (expr (call key1 (& d) (call s "@[D" a) (. input KEY_LEFT) 0 0 "left"))
    (expr (call key1 (& d) (call s "@OA" a) (. input KEY_UP) 0 0 "ss3 up"))
    (expr (call key1 (& d) (call s "@OH" a) (. input KEY_HOME) 0 0 "ss3 home"))
    (expr (call key1 (& d) (call s "@[F" a) (. input KEY_END) 0 0 "end"))
    (expr (call key1 (& d) (call s "@[1;5A" a) (. input KEY_UP) (. input MOD_CTRL) 0 "ctrl up"))
    (expr (call key1 (& d) (call s "@[1;2D" a) (. input KEY_LEFT) (. input MOD_SHIFT) 0 "shift left"))
    (expr (call key1 (& d) (call s "@[1;8C" a) (. input KEY_RIGHT) 7 0 "all mods (meta ignored)"))
    (expr (call key1 (& d) (call s "@[Z" a) (. input KEY_TAB) (. input MOD_SHIFT) 0 "shift tab"))
    (expr (call key1 (& d) (call s "@[3~" a) (. input KEY_DELETE) 0 0 "delete"))
    (expr (call key1 (& d) (call s "@[5;3~" a) (. input KEY_PGUP) (. input MOD_ALT) 0 "alt pgup"))
    (expr (call key1 (& d) (call s "@[7~" a) (. input KEY_HOME) 0 0 "home 7"))
    (expr (call key1 (& d) (call s "@[8~" a) (. input KEY_END) 0 0 "end 8"))
    (expr (call key1 (& d) (call s "@[2~" a) (. input KEY_INSERT) 0 0 "insert"))
    (expr (call key1 (& d) (call s "@[6~" a) (. input KEY_PGDN) 0 0 "pgdn"))
    (expr (call enc (. input KEY_UP) 0 0 0 (call s "@[A" a) a "enc up"))
    (expr (call enc (. input KEY_UP) 0 0 MODE_CURSOR_KEYS (call s "@OA" a) a "enc app up"))
    (expr (call enc (. input KEY_DOWN) 0 0 MODE_CURSOR_KEYS (call s "@OB" a) a "enc app down"))
    (expr (call enc (. input KEY_RIGHT) 0 0 MODE_CURSOR_KEYS (call s "@OC" a) a "enc app right"))
    (expr (call enc (. input KEY_LEFT) 0 0 MODE_CURSOR_KEYS (call s "@OD" a) a "enc app left"))
    (expr (call enc (. input KEY_RIGHT) 0 0 0 (call s "@[C" a) a "enc right"))
    (expr (call enc (. input KEY_HOME) 0 0 MODE_CURSOR_KEYS (call s "@OH" a) a "enc app home"))
    (expr (call enc (. input KEY_END) 0 0 0 (call s "@[F" a) a "enc end"))
    (expr (call enc (. input KEY_UP) (. input MOD_CTRL) 0 MODE_CURSOR_KEYS (call s "@[1;5A" a) a "enc ctrl up in app mode"))
    (expr (call enc (. input KEY_TAB) (. input MOD_SHIFT) 0 0 (call s "@[Z" a) a "enc shift tab"))
    (expr (call enc (. input KEY_DELETE) 0 0 0 (call s "@[3~" a) a "enc delete"))
    (expr (call enc (. input KEY_PGDN) (. input MOD_ALT) 0 0 (call s "@[6;3~" a) a "enc alt pgdn"))))
  (fn functionKeys (params (a (ref Arena))) _ (block
    (let codes _ (array-lit "" "" "" "" "15" "17" "18" "19" "20" "21" "23" "24"))
    (let ss3 _ (array-lit "P" "Q" "R" "S"))
    (let d _ (call (. Decoder new) a))
    (for n (.. 0 12) (block
      (let k _ (+ (. input KEY_F1) n))
      (let plain _ (call (. Text new) a))
      (let ctrl _ (call (. Text new) a))
      (if (< n 4) (block
        (expr (call (. plain pushStr) (call s "@O" a)))
        (expr (call (. plain pushStr) (index ss3 n)))
        (expr (call (. ctrl pushStr) (call s "@[1;5" a)))
        (expr (call (. ctrl pushStr) (index ss3 n)))) (block
        (expr (call (. plain pushStr) (call s "@[" a)))
        (expr (call (. plain pushStr) (index codes n)))
        (expr (call (. plain pushStr) "~"))
        (expr (call (. ctrl pushStr) (call s "@[" a)))
        (expr (call (. ctrl pushStr) (index codes n)))
        (expr (call (. ctrl pushStr) ";5~"))))
      (expr (call key1 (& d) (call (. plain str)) k 0 0 (interp "F" (+ n 1) " decode")))
      (expr (call key1 (& d) (call (. ctrl str)) k (. input MOD_CTRL) 0 (interp "F" (+ n 1) " ctrl decode")))
      (expr (call enc k 0 0 0 (call (. plain str)) a (interp "F" (+ n 1) " encode")))
      (expr (call enc k 0 0 MODE_CURSOR_KEYS (call (. plain str)) a (interp "F" (+ n 1) " encode app")))
      (expr (call enc k (. input MOD_CTRL) 0 0 (call (. ctrl str)) a (interp "F" (+ n 1) " encode ctrl")))))))
  (fn altCtrl (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (expr (call key1 (& d) (call s "@x" a) (. input KEY_CHAR) (. input MOD_ALT) 120 "alt x"))
    (expr (call key1 (& d) (call s "@@[A" a) (. input KEY_UP) (. input MOD_ALT) 0 "alt up"))
    (expr (call key1 (& d) (call byte 3 a) (. input KEY_CHAR) (. input MOD_CTRL) 99 "ctrl c"))
    (expr (call key1 (& d) (call byte 1 a) (. input KEY_CHAR) (. input MOD_CTRL) 97 "ctrl a"))
    (expr (call key1 (& d) (call byte 13 a) (. input KEY_ENTER) 0 0 "enter"))
    (expr (call key1 (& d) (call byte 9 a) (. input KEY_TAB) 0 0 "tab"))
    (expr (call key1 (& d) (call byte 127 a) (. input KEY_BACKSPACE) 0 0 "bs 7f"))
    (expr (call key1 (& d) (call byte 8 a) (. input KEY_BACKSPACE) (. input MOD_CTRL) 0 "bs 08 is ctrl+bs"))
    (expr (call key1 (& d) (call byte 10 a) (. input KEY_CHAR) (. input MOD_CTRL) 106 "lf is ctrl+j"))
    (expr (call key1 (& d) (call byte 0 a) (. input KEY_CHAR) (. input MOD_CTRL) 32 "ctrl space"))
    (expr (call key1 (& d) (call byte 28 a) (. input KEY_CHAR) (. input MOD_CTRL) 92 "ctrl backslash"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 99 0 (call byte 3 a) a "enc ctrl c"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 67 0 (call byte 3 a) a "enc ctrl C"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 32 0 (call byte 0 a) a "enc ctrl space"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 64 0 (call byte 0 a) a "enc ctrl @"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 93 0 (call byte 29 a) a "enc ctrl ]"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_ALT) 120 0 (call s "@x" a) a "enc alt x"))
    (expr (call enc (. input KEY_CHAR) 0 233 0 (call bs (array-lit 195 169) a) a "enc utf8 2 bytes"))
    (expr (call enc (. input KEY_CHAR) 0 128512 0 (call bs (array-lit 240 159 152 128) a) a "enc utf8 4 bytes"))
    (expr (call enc (. input KEY_ENTER) 0 0 0 (call byte 13 a) a "enc enter"))
    (expr (call enc (. input KEY_BACKSPACE) 0 0 0 (call byte 127 a) a "enc bs"))
    (expr (call enc (. input KEY_BACKSPACE) (. input MOD_CTRL) 0 0 (call byte 8 a) a "enc ctrl bs"))
    (expr (call enc (. input KEY_TAB) 0 0 0 (call byte 9 a) a "enc tab"))
    (expr (call enc (. input KEY_ESC) 0 0 0 (call byte 27 a) a "enc esc"))))
  (fn utf8Split (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let e _ (call bs (array-lit 226 130 172) a))
    (let f _ (call bs (array-lit 240 159 152 128) a))
    (expr (call feed (& d) (slice-expr e 0 1) 0))
    (let ev _ (struct-lit Event))
    (expr (call ok (! (call (. d next) 0 (& ev))) "half a char waits"))
    (expr (call feed (& d) (slice-expr e 1 3) 0))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 8364 "euro"))
    (expr (call feed (& d) (slice-expr f 0 1) 0))
    (expr (call feed (& d) (slice-expr f 1 2) 0))
    (expr (call ok (! (call (. d next) 0 (& ev))) "still waiting"))
    (expr (call feed (& d) (slice-expr f 2 4) 0))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 128512 "emoji"))
    (expr (call drained (& d) "empty"))
    (expr (call feed (& d) (call bs (array-lit 128 226 65) a) 0))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 65533 "stray continuation"))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 65533 "bad sequence"))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 65 "A after it"))))
  (fn paste (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let ev _ (struct-lit Event))
    (expr (call feed (& d) (call s "a@[200~hel" a) 0))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 97 "key before paste"))
    (expr (call ok (! (call (. d next) 0 (& ev))) "paste incomplete"))
    (expr (call feed (& d) (call s "lo @[A and @[2" a) 0))
    (expr (call ok (! (call (. d next) 0 (& ev))) "paste still open"))
    (expr (call feed (& d) (call s "01~b" a) 0))
    (expr (call ok (call (. d next) 0 (& ev)) "paste done"))
    (expr (call eqi (. ev kind) (. input EV_PASTE) "kind"))
    (expr (call ok (== (. ev text) (call s "hello @[A and " a)) "paste text verbatim"))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 98 "key after paste"))
    (expr (call drained (& d) "empty"))
    (expr (call feed (& d) (call s "@[200~one" a) 0))
    (expr (call feed (& d) (call s "two@" a) 0))
    (expr (call ok (! (call (. d next) 0 (& ev))) "held at ESC"))
    (expr (call feed (& d) (call s "[201~" a) 0))
    (expr (call ok (call (. d next) 0 (& ev)) "paste 2 done"))
    (expr (call ok (== (. ev text) "onetwo") "paste 2 text"))
    (expr (call feed (& d) (call s "@[200~@[201~@[200~a\nb@[201~" a) 0))
    (expr (call ok (&& (call (. d next) 0 (& ev)) (== (. ev text) "")) "empty paste"))
    (expr (call ok (&& (call (. d next) 0 (& ev)) (== (. ev text) "a\nb")) "newline paste"))
    (let t _ (call (. Text new) a))
    (expr (call (. input encodePaste) "hi" 0 (& t)))
    (expr (call ok (== (call (. t str)) "hi") "raw paste"))
    (expr (call (. t clear)))
    (expr (call (. input encodePaste) "hi" MODE_PASTE (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[200~hi@[201~" a)) "wrapped paste"))
    (expr (call (. t clear)))
    (expr (call (. input encodePaste) (call s "a@[201~b@[20@[201~1~c" a) MODE_PASTE (& t)))
    (expr (call ok (|| (== (call (. t str)) (call s "@[200~ab@[201~" a)) (== (call (. t str)) (call s "@[200~abc@[201~" a))) "injection stripped"))
    (expr (call ok (== (call (. t str)) (call s "@[200~abc@[201~" a)) "joined marker stripped too"))))
  (fn mouse (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let ev _ (struct-lit Event))
    (expr (call feed (& d) (call s "@[<0;10;5M@[<0;10;5m@[<64;3;4M@[<65;1;1M@[<35;2;2M@[<34;2;2M@[<2;1;1M@[<16;7;7M" a) 0))
    (expr (call ok (call (. d next) 0 (& ev)) "press"))
    (expr (call eqi (. ev kind) (. input EV_MOUSE) "mouse"))
    (expr (call eqi (. ev x) 9 "x 0-based"))
    (expr (call eqi (. ev y) 4 "y 0-based"))
    (expr (call eqi (. ev button) (. input MB_LEFT) "left"))
    (expr (call eqi (. ev action) (. input MA_PRESS) "press action"))
    (expr (call ok (call (. d next) 0 (& ev)) "release"))
    (expr (call eqi (. ev action) (. input MA_RELEASE) "release action"))
    (expr (call eqi (. ev button) (. input MB_LEFT) "release button"))
    (expr (call ok (call (. d next) 0 (& ev)) "wheel up"))
    (expr (call eqi (. ev action) (. input MA_WHEEL) "wheel"))
    (expr (call eqi (. ev button) (. input MB_WHEEL_UP) "wheel up button"))
    (expr (call ok (call (. d next) 0 (& ev)) "wheel down"))
    (expr (call eqi (. ev button) (. input MB_WHEEL_DOWN) "wheel down button"))
    (expr (call ok (call (. d next) 0 (& ev)) "move"))
    (expr (call eqi (. ev action) (. input MA_MOVE) "move action"))
    (expr (call eqi (. ev button) (. input MB_NONE) "move without button"))
    (expr (call ok (call (. d next) 0 (& ev)) "drag"))
    (expr (call eqi (. ev action) (. input MA_MOVE) "drag action"))
    (expr (call eqi (. ev button) (. input MB_RIGHT) "drag button"))
    (expr (call ok (call (. d next) 0 (& ev)) "right"))
    (expr (call eqi (. ev button) (. input MB_RIGHT) "right press"))
    (expr (call ok (call (. d next) 0 (& ev)) "ctrl"))
    (expr (call eqi (. ev mods) (. input MOD_CTRL) "ctrl mouse"))
    (expr (call drained (& d) "mouse empty"))
    (expr (call feed (& d) (call s "@[I@[O" a) 0))
    (expr (call ok (&& (&& (call (. d next) 0 (& ev)) (== (. ev kind) (. input EV_FOCUS))) (. ev on)) "focus in"))
    (expr (call ok (&& (&& (call (. d next) 0 (& ev)) (== (. ev kind) (. input EV_FOCUS))) (! (. ev on))) "focus out"))
    (let m _ (| MODE_MOUSE_CLICK MODE_MOUSE_SGR))
    (let t _ (call (. Text new) a))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_PRESS) 9 4 0 m (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[<0;10;5M" a)) "enc press"))
    (expr (call (. t clear)))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_RELEASE) 9 4 0 m (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[<0;10;5m" a)) "enc release"))
    (expr (call (. t clear)))
    (expr (call (. input encodeMouse) (. input MB_WHEEL_DOWN) (. input MA_WHEEL) 0 0 (. input MOD_CTRL) m (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[<81;1;1M" a)) "enc wheel ctrl"))
    (expr (call (. t clear)))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_MOVE) 1 1 0 m (& t)))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_PRESS) 1 1 0 MODE_MOUSE_CLICK (& t)))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_PRESS) 1 1 0 MODE_MOUSE_SGR (& t)))
    (expr (call eqi (call (. t len)) 0 "no drag without drag mode, no SGR, no mouse mode"))
    (expr (call (. input encodeMouse) (. input MB_LEFT) (. input MA_MOVE) 1 1 0 (| m MODE_MOUSE_DRAG) (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[<32;2;2M" a)) "enc drag"))
    (expr (call (. t clear)))
    (expr (call (. input encodeMouse) (. input MB_NONE) (. input MA_MOVE) 1 1 0 (| m MODE_MOUSE_DRAG) (& t)))
    (expr (call eqi (call (. t len)) 0 "no bare motion in drag mode"))
    (expr (call (. input encodeMouse) (. input MB_NONE) (. input MA_MOVE) 1 1 0 (| m MODE_MOUSE_MOVE) (& t)))
    (expr (call ok (== (call (. t str)) (call s "@[<35;2;2M" a)) "enc bare motion"))))
  (fn escTimeout (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let ev _ (struct-lit Event))
    (expr (call feed (& d) (call s "@" a) 100))
    (expr (call ok (! (call (. d next) 100 (& ev))) "lone ESC held"))
    (expr (call ok (! (call (. d next) 124 (& ev))) "lone ESC held until the timeout"))
    (expr (call ok (call (. d next) 125 (& ev)) "lone ESC released"))
    (expr (call eqi (. ev key) (. input KEY_ESC) "esc key"))
    (expr (call eqi (. ev mods) 0 "esc has no mods"))
    (expr (call ok (! (call (. d next) 500 (& ev))) "nothing left"))
    (expr (call feed (& d) (call s "@" a) 200))
    (expr (call ok (! (call (. d next) 205 (& ev))) "held"))
    (expr (call feed (& d) "x" 210))
    (expr (call ok (&& (&& (&& (call (. d next) 210 (& ev)) (== (. ev key) (. input KEY_CHAR))) (== (. ev mods) (. input MOD_ALT))) (== (. ev cp) 120)) "alt x after a gap"))
    (expr (call feed (& d) (call s "@[1;" a) 300))
    (expr (call ok (! (call (. d next) 310 (& ev))) "truncated CSI waits"))
    (expr (call ok (&& (call (. d next) 330 (& ev)) (== (. ev key) (. input KEY_ESC))) "ESC released"))
    (expr (call ok (&& (call (. d next) 330 (& ev)) (== (. ev cp) 91)) "[ as a key"))
    (expr (call ok (&& (call (. d next) 330 (& ev)) (== (. ev cp) 49)) "1 as a key"))
    (expr (call ok (&& (call (. d next) 330 (& ev)) (== (. ev cp) 59)) "; as a key"))
    (expr (call ok (! (call (. d next) 330 (& ev))) "all released"))
    (expr (call feed (& d) (call bs (array-lit 226 130) a) 400))
    (expr (call ok (! (call (. d next) 401 (& ev))) "half char waits"))
    (expr (call ok (&& (call (. d next) 430 (& ev)) (== (. ev cp) 65533)) "released as replacement"))))
  (fn pasteTimeout (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let ev _ (struct-lit Event))
    (expr (call feed (& d) (call s "@[200~abc@[20" a) 100))
    (expr (call ok (! (call (. d next) 500 (& ev))) "open paste waits"))
    (expr (call ok (! (call (. d next) 1099 (& ev))) "open paste waits until the timeout"))
    (expr (call ok (&& (call (. d next) 1100 (& ev)) (== (. ev kind) (. input EV_PASTE))) "unterminated paste delivered"))
    (expr (call ok (== (. ev text) (call s "abc@[20" a)) "held marker prefix included"))
    (expr (call ok (! (call (. d next) 1100 (& ev))) "nothing left"))
    (expr (call feed (& d) "z" 1200))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 122 "input flows after the timeout"))))
  (fn garbage (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (expr (call feed (& d) (call s "@[99z@[?25h@[1 q@OZ@[12;@[AX" a) 0))
    (expr (call expectKey (& d) (. input KEY_UP) 0 0 "up after garbage"))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 88 "X after garbage"))
    (expr (call drained (& d) "empty"))
    (let t _ (call (. Text new) a))
    (expr (call (. t push) 27))
    (expr (call (. t push) 91))
    (for i (.. 0 1000) (block
      (expr (call (. t push) 49))))
    (expr (call (. t push) 122))
    (expr (call (. t push) 113))
    (expr (call feed (& d) (call (. t str)) 0))
    (expr (call expectKey (& d) (. input KEY_CHAR) 0 113 "q after a long CSI"))
    (expr (call drained (& d) "empty after long CSI"))))
  (fn roundTrip (params (a (ref Arena))) _ (block
    (let d _ (call (. Decoder new) a))
    (let keys _ (array-lit (. input KEY_ENTER) (. input KEY_TAB) (. input KEY_BACKSPACE) (. input KEY_ESC) (. input KEY_UP) (. input KEY_DOWN) (. input KEY_LEFT) (. input KEY_RIGHT) (. input KEY_HOME) (. input KEY_END) (. input KEY_PGUP) (. input KEY_PGDN) (. input KEY_INSERT) (. input KEY_DELETE)))
    (let n _ 0)
    (for m (.. 0 8) (block
      (for k (.. 0 12) (block
        (expr (call keys_check (& d) (+ (. input KEY_F1) k) m 0 0 a))
        (+= n 1)))
      (for-each _ k keys (block
        (if (|| (|| (== k (. input KEY_ESC)) (&& (== k (. input KEY_ENTER)) (!= (& m 5) 0))) (&& (== k (. input KEY_TAB)) (!= (& m 4) 0))) (block
          (continue)))
        (if (&& (== k (. input KEY_BACKSPACE)) (!= (& m 1) 0)) (block
          (continue)))
        (if (&& (&& (== k (. input KEY_TAB)) (!= (& m 1) 0)) (!= m 1)) (block
          (continue)))
        (expr (call keys_check (& d) k m 0 (* MODE_CURSOR_KEYS (% n 2)) a))
        (+= n 1)))))
    (let cps _ (array-lit 97 122 65 48 32 126 233 8364 128512))
    (for-each _ cp cps (block
      (expr (call keys_check (& d) (. input KEY_CHAR) 0 (call i32 cp) 0 a))
      (expr (call keys_check (& d) (. input KEY_CHAR) (. input MOD_ALT) (call i32 cp) 0 a))))
    (let letters _ (array-lit 97 99 122))
    (for-each _ cp letters (block
      (expr (call keys_check (& d) (. input KEY_CHAR) (. input MOD_CTRL) (call i32 cp) 0 a))
      (expr (call keys_check (& d) (. input KEY_CHAR) (| (. input MOD_CTRL) (. input MOD_ALT)) (call i32 cp) 0 a))))
    (expr (call ok (> n 100) "round trip covered many keys"))))
  (fn keys_check (params (d (ref Decoder)) (key int) (mods int) (cp i32) (modes int) (a (ref Arena))) _ (block
    (let t _ (call (. Text new) a))
    (expr (call (. input encodeKey) key mods cp modes (& t)))
    (expr (call ok (> (call (. t len)) 0) (interp "encoded something for key " key " mods " mods)))
    (expr (call feed d (call (. t str)) 0))
    (expr (call expectKey d key mods cp (interp "round trip key " key " mods " mods)))
    (expr (call drained d "round trip drained"))))
  (fn encEv (params (key int) (mods int) (cp i32) (ev int) (modes int) (want string) (a (ref Arena)) (msg string)) _ (block
    (let t _ (call (. Text new) a))
    (expr (call (. input encodeKeyEvent) key mods cp ev modes (& t)))
    (if (! (== (call (. t str)) want)) (block
      (expr (call printLn (interp "FAIL: " msg ": want " (. want len) " bytes, got " (call (. t len)) ": " (call (. t str)))))
      (expr (call panic msg))))))
  (fn kitty (params (a (ref Arena))) _ (block
    (let g _ (call (. Grid new) a 20 5 0))
    (let p _ (call (. Parser new) a))
    (expr (call (. ansi feed) (& p) (call s "@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?0u" a)) "kitty query empty"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@[>1u" a) (& g)))
    (expr (call (. ansi feed) (& p) (call s "@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?1u" a)) "kitty query after push"))
    (expr (call (. (. g reply) clear)))
    (let m _ (. g modes))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 105 m (call s "@[105;5u" a) a "ctrl+i disambiguated"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_CTRL) 105 0 "\t" a "ctrl+i legacy"))
    (expr (call enc (. input KEY_ESC) 0 0 m (call s "@[27u" a) a "esc"))
    (expr (call enc (. input KEY_CHAR) 0 97 m "a" a "plain a is text"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_SHIFT) 65 m "A" a "shift a is text"))
    (expr (call enc (. input KEY_ENTER) 0 0 m "\r" a "enter stays legacy"))
    (expr (call enc (. input KEY_ENTER) (. input MOD_SHIFT) 0 m (call s "@[13;2u" a) a "shift enter"))
    (expr (call enc (. input KEY_UP) (. input MOD_CTRL) 0 m (call s "@[1;5A" a) a "ctrl up"))
    (expr (call enc (+ (. input KEY_F1) 2) (. input MOD_SHIFT) 0 m (call s "@[13;2~" a) a "shift f3"))
    (expr (call encEv (. input KEY_CHAR) 0 97 (. input KEV_RELEASE) m "" a "no release without flag 2"))
    (expr (call (. ansi feed) (& p) (call s "@[=31;1u" a) (& g)))
    (= m (. g modes))
    (expr (call enc (. input KEY_CHAR) 0 97 m (call s "@[97;;97u" a) a "all keys: a with text"))
    (expr (call enc (. input KEY_CHAR) (. input MOD_SHIFT) 65 m (call s "@[97:65;2;65u" a) a "shift a alternate + text"))
    (expr (call enc (. input KEY_ENTER) 0 0 m (call s "@[13u" a) a "all keys: enter"))
    (expr (call enc (. input KEY_UP) 0 0 m (call s "@[A" a) a "all keys: up"))
    (expr (call encEv (. input KEY_CHAR) (. input MOD_CTRL) 97 (. input KEV_RELEASE) m (call s "@[97;5:3u" a) a "ctrl a release"))
    (expr (call encEv (. input KEY_UP) 0 0 (. input KEV_REPEAT) m (call s "@[1;1:2A" a) a "up repeat"))
    (expr (call (. ansi feed) (& p) (call s "@[=2;3u@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?29u" a)) "kitty and-not"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@[?1049h@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?0u" a)) "alt stack empty"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@[?1049l@[<u@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?0u" a)) "popped to base"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@[>8u@c@[?u" a) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@[?0u" a)) "RIS clears the stack"))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call arrows (& a)))
    (expr (call kitty (& a)))
    (expr (call functionKeys (& a)))
    (expr (call altCtrl (& a)))
    (expr (call utf8Split (& a)))
    (expr (call paste (& a)))
    (expr (call mouse (& a)))
    (expr (call escTimeout (& a)))
    (expr (call pasteTimeout (& a)))
    (expr (call garbage (& a)))
    (expr (call roundTrip (& a)))
    (expr (call printLn "term_input_test ok")))))
--- stderr
--- exit 0
