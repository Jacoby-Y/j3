(file (module j2_vm_test)
  (use j3.io (names exists printLn readFile))
  (use j3.j2)
  (use j3.j2 (names Vm Error Args Value Limits))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text (names Text find))
  (struct Case
    (field src string)
    (field want string))
  (const OUT (array 49 Case) (array-lit (struct-lit Case (field src "print(1 + 2);") (field want "3\n")) (struct-lit Case (field src "print(7 / 2, 7.0 / 2, 7 % 3, -7 % 3, 2 * 3.5, 7 - 10);") (field want "3 3.5 1 -1 7.0 -3\n")) (struct-lit Case (field src "print(1e9, 0.5 + 0.25, 10 / 4.0, 7.5 % 2, 1.0);") (field want "1000000000.0 0.75 2.5 1.5 1.0\n")) (struct-lit Case (field src "print(1.5 % 0.0, 7.0 / 0, -7.5 % 2, 1 / 0.0 * 0.0);") (field want "nan inf -1.5 nan\n")) (struct-lit Case (field src "print(1 == 1.0, 3 < 2, \"a\" < \"b\", 2 >= 2, 1 != 2, 2 > 1.5, \"b\" <= \"a\");") (field want "true false true true true true false\n")) (struct-lit Case (field src "print(9223372036854775807 + 1, (0 - 9223372036854775807 - 1) / -1, 5 % -1);") (field want "-9223372036854775808 -9223372036854775808 0\n")) (struct-lit Case (field src "fn fib(n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); } print(fib(20));") (field want "6765\n")) (struct-lit Case (field src "let s = 0; let i = 0; while true { i += 1; if i > 10 { break; } if i % 2 == 0 { continue; } s += i; } print(s);") (field want "25\n")) (struct-lit Case (field src "let s = 0; for i in 0..5 { s += i; } print(s); for i in 3..1 { print(\"no\"); }") (field want "10\n")) (struct-lit Case (field src "for i in 0..3 { for j in 0..3 { if j == 1 { continue; } if j == 2 { break; } print(i, j); } }") (field want "0 0\n1 0\n2 0\n")) (struct-lit Case (field src "fn f() { let a = 1; let b = 2; { let c = a + b; return c * 10; } } print(f());") (field want "30\n")) (struct-lit Case (field src "fn g() {} fn h(a, b) { return b; } print(g(), h(1), h(1, 2, 3));") (field want "nil nil 2\n")) (struct-lit Case (field src "let a = 5; let b = -a; print(b, -2.5, !nil, !0);") (field want "-5 -2.5 true false\n")) (struct-lit Case (field src "const MAX = 3; let hp = 10; hp += MAX; hp -= 1; hp *= 2; hp /= 4; hp %= 4; print(hp);") (field want "2\n")) (struct-lit Case (field src "if 1 > 2 { print(1); } else if 0 { print(\"0 is true\"); } else { print(3); }") (field want "0 is true\n")) (struct-lit Case (field src "print(nil || 5, false && (1 / 0), 1 && 2, nil && 1, false || nil);") (field want "5 false 2 nil nil\n")) (struct-lit Case (field src "print(later()); fn later() { return first(); } fn first() { return 1; }") (field want "1\n")) (struct-lit Case (field src "let wave = 0; fn next() { wave += 1; } next(); next(); print(wave);") (field want "2\n")) (struct-lit Case (field src "fn outer() { fn fact(n) { if n <= 1 { return 1; } return n * fact(n - 1); } return fact(10); } print(outer());") (field want "3628800\n")) (struct-lit Case (field src "fn d(n) { let a = 1; let b = 2; let c = 3; if n == 0 { return 0; } return d(n - 1) + a; } print(d(150));") (field want "150\n")) (struct-lit Case (field src "let p = { x: 1, y: 2 }; p.z = 3; p.z = nil; print(p.w, p); p[\"k\"] = true; print(p.k, p[\"x\"]);") (field want "nil {x: 1, y: 2}\ntrue 1\n")) (struct-lit Case (field src "let t = { a: 1, b: 2, c: 3 }; t.b = nil; t.b = 4; for k, v in t { print(k, v); }") (field want "a 1\nc 3\nb 4\n")) (struct-lit Case (field src "let xs = [10, 20]; xs[2] = 30; print(xs, xs[0], xs[5], xs[1.0]); for v in xs { print(v); } for i, v in xs { print(i, v); }") (field want "[10, 20, 30] 10 nil 20\n10\n20\n30\n0 10\n1 20\n2 30\n")) (struct-lit Case (field src "let t = { a: 1 }; t.a += 4; let xs = [1]; xs[0] *= 7; let m = { }; m[2.0] = \"two\"; print(t.a, xs[0], m[2]);") (field want "5 7 two\n")) (struct-lit Case (field src "let n = \"slime\"; let hp = 3; print(`{n} has {hp} hp`); print(\"plain \" + n, \"a\" + 1, 2.5 + \"b\");") (field want "slime has 3 hp\nplain slime a1 2.5b\n")) (struct-lit Case (field src "let p = { x: 1 }; print(`x={p.x} n={1 + 2} s={\"q\"} {[1, \"a\"]}`, ``, `{p}`);") (field want "x=1 n=3 s=q [1, \"a\"]  {x: 1}\n")) (struct-lit Case (field src "print(\"ab\" == \"a\" + \"b\", \"x\" != \"x\");") (field want "true false\n")) (struct-lit Case (field src "fn m(n) { match n { 1 { return \"one\"; } \"two\" { return 2; } true { return \"t\"; } -3 { return \"m3\"; } _ { return \"other\"; } } } print(m(1), m(\"two\"), m(true), m(-3), m(9), m(1.0));") (field want "one 2 t m3 other one\n")) (struct-lit Case (field src "match 5 { 1 { print(1); } } print(\"after\");") (field want "after\n")) (struct-lit Case (field src "let o = { n: 5, get: fn(this) { return this.n; }, plain: fn(x) { return x; } }; print(o.get(), o.plain(7));") (field want "5 7\n")) (struct-lit Case (field src "fn twice(x) { return x * 2; } fn dup(s) { return s + s; } print((3).twice()); let t = { v: 1 }; fn val(u, k) { return u.v + k; } print(t.val(10), \"s\".dup());") (field want "6\n11 ss\n")) (struct-lit Case (field src "let w = { pellets: 3, fire: fn(this, x) { let s = 0; for i in 0..this.pellets { s += x; } return s; } }; print(w.fire(2));") (field want "6\n")) (struct-lit Case (field src "let counter = fn() { let n = 0; return fn() { n += 1; return n; }; }; let c1 = counter(); let c2 = counter(); c1(); c1(); print(c1(), c2());") (field want "3 1\n")) (struct-lit Case (field src "fn every(n) { let count = 0; return fn() { count += 1; return count % n == 0; }; } let e = every(3); print(e(), e(), e(), e());") (field want "false false true false\n")) (struct-lit Case (field src "let fs = []; for i in 0..3 { fs[i] = fn() { return i; }; } print(fs[0](), fs[1](), fs[2]());") (field want "0 1 2\n")) (struct-lit Case (field src "let gs = []; let j = 0; while j < 3 { let k = j * 10; gs[j] = fn() { return k; }; j += 1; } print(gs[0](), gs[2]());") (field want "0 20\n")) (struct-lit Case (field src "let hs = []; for i, v in [5, 6, 7] { hs[i] = fn() { return v; }; } print(hs[0](), hs[2]());") (field want "5 7\n")) (struct-lit Case (field src "let hs = []; for i in 0..10 { hs[i] = fn() { return i; }; if i == 2 { break; } } print(hs[2](), hs[0]());") (field want "2 0\n")) (struct-lit Case (field src "let hs = []; for i in 0..4 { if i % 2 == 0 { continue; } let k = i; hs[len0(hs)] = fn() { return k; }; } fn len0(a) { let n = 0; for x in a { n += 1; } return n; } print(hs[0](), hs[1]());") (field want "1 3\n")) (struct-lit Case (field src "fn mk() { let v = 1; let get = fn() { return v; }; v = 5; return get; } print(mk()());") (field want "5\n")) (struct-lit Case (field src "fn a() { let x = 1; return fn() { return fn() { x += 1; return x; }; }; } let f = a()(); f(); print(f());") (field want "3\n")) (struct-lit Case (field src "fn pair() { let n = 0; return { inc: fn() { n += 1; }, get: fn() { return n; } }; } let p = pair(); p.inc(); p.inc(); print(p.get());") (field want "2\n")) (struct-lit Case (field src "{ let x = 1; let f = fn() { return x; }; x = 2; print(f()); }") (field want "2\n")) (struct-lit Case (field src "const ORBIT = 48;\nfn Turret(angle) {\n    return {\n        angle: angle,\n        level: 1,\n        bump: fn(this, dt) {\n            this.angle += dt;\n            match this.level {\n                1 { this.cool = 0.8; }\n                _ { this.cool = 0.3; }\n            }\n        },\n    };\n}\nlet ts = [Turret(0), Turret(1.5)];\nfor t in ts { t.bump(0.5); }\nts[1].level = 2;\nts[1].bump(0.5);\nprint(ts[0].angle, ts[1].angle, ts[0].cool, ts[1].cool, ORBIT);") (field want "0.5 2.5 0.8 0.3 48\n")) (struct-lit Case (field src "fn nearest(xs, from) { let best = nil; let bestD = 1e9; for e in xs { let d = (e.x - from) * (e.x - from); if d < bestD { best = e; bestD = d; } } return best; } print(nearest([{ x: 1 }, { x: 5 }, { x: 9 }], 6).x, nearest([], 0));") (field want "5 nil\n")) (struct-lit Case (field src "let x = 2.5; let n = 0; if x > 2 { n += 1; } if x >= 2.5 { n += 1; } if x < 3 { n += 1; } if x <= 2 { n += 100; } if 1 == 1.0 { n += 1; } if x != 2.5 { n += 100; } if \"a\" < \"b\" { n += 1; } let y = 3; if y > x { n += 1; } if y >= 3 { n += 1; } if 2 > y { n += 100; } print(n);") (field want "7\n")) (struct-lit Case (field src "let a = 7; print(a / 2, a % 3, -7 / 2, -7 % 3, a / -1, a % -1, a * 3, a - -2, a + 0.5, 1.5 * 2, a / 2.0, \"s\" + 1, a % 2.5);") (field want "3 1 -3 -1 -7 0 21 9 7.5 3.0 3.5 s1 2.0\n")) (struct-lit Case (field src "let i = 0; while i < 3 && true { i += 1; } let j = 0; while !(j >= 2) { j += 1; } let k = 0; while k != 4 { k += 1; if k == 2 { continue; } } print(i, j, k);") (field want "3 2 4\n")) (struct-lit Case (field src "let fish = r\"\n |\\ /  o\n | >  ))\n |/ \\__/\n \";\nlet ls = split(fish, \"\\n\");\nprint(len(ls), ls[1], len(r\"\\\"), r#\"say \"hi\"\"#, r\"\\n\" == \"\\\\n\");") (field want "5  |\\ /  o 1 say \"hi\" true\n"))))
  (const ERRS (array 22 Case) (array-lit (struct-lit Case (field src "let s = r#\"open\";") (field want "t:1:9: unterminated raw string")) (struct-lit Case (field src "print(7 / 0);") (field want "t:1:9: division by zero")) (struct-lit Case (field src "print(7 % 0);") (field want "t:1:9: modulo by zero")) (struct-lit Case (field src "let x = nil; x.y = 1;") (field want "t:1:15: can't set field \"y\" of nil")) (struct-lit Case (field src "let x = 5; x();") (field want "t:1:13: can't call int")) (struct-lit Case (field src "let n = nil; print(n.k);") (field want "t:1:21: can't read field \"k\" of nil")) (struct-lit Case (field src "let xs = [1];\nxs[3] = 1;") (field want "t:2:3: array index 3 is out of range (len 1)")) (struct-lit Case (field src "let xs = [1]; print(xs[\"a\"]);") (field want "t:1:23: an array index must be an int, not string")) (struct-lit Case (field src "print(1 + nil);") (field want "t:1:9: can't use + on int and nil")) (struct-lit Case (field src "undefinedThing(1);") (field want "t:1:1: unknown name \"undefinedThing\"")) (struct-lit Case (field src "const A = 1; A = 2;") (field want "t:1:14: can't assign to const \"A\"")) (struct-lit Case (field src "fn f() { break; }") (field want "t:1:10: `break` outside a loop")) (struct-lit Case (field src "let xs = [1]; xs.nope(1);") (field want "t:1:22: no field \"nope\" and no function nope")) (struct-lit Case (field src "fn r(n) { return r(n + 1); } r(0);") (field want "t:1:19: stack overflow")) (struct-lit Case (field src "for i in 0..1.5 { }") (field want "t:1:1: a range needs ints, not float")) (struct-lit Case (field src "for x in 5 { }") (field want "t:1:1: can't loop over int")) (struct-lit Case (field src "print(1 < \"a\");") (field want "t:1:9: can't compare int and string")) (struct-lit Case (field src "let = 1;") (field want "t:1:5: expected a name after `let`, found `=`")) (struct-lit Case (field src "let t = {};\nt[nil] = 1;") (field want "t:2:2: a table key can't be nil")) (struct-lit Case (field src "if 1 < \"a\" { }") (field want "t:1:6: can't compare int and string")) (struct-lit Case (field src "let x = \"s\"; if x > 1 { }") (field want "t:1:19: can't compare int and string")) (struct-lit Case (field src "let a = nil; print(a - 1);") (field want "t:1:22: can't use - on nil and int"))))
  (fn errText (params (e Error) (_mem (ref Arena))) string (block
    (return (. e message))))
  (fn (doc "`print` into the `Text` at `vm.host`, so cases compare what a script printed.") capture (params (vm (ref Vm)) (args Args)) Value (block
    (let t _ (as (. vm host) (ref Text)))
    (expr (call (. t pushStr) (call (. args joined) " ")))
    (expr (call (. t push) 10))
    (return (call (. j2 nil)))))
  (fn (doc "A VM with every lib and `print` captured into `out`.") newVm (params (mem (ref Arena)) (out (ref Text))) Vm (block
    (let vm _ (call (. Vm new) mem (struct-lit Limits)))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" capture))
    (= (. vm host) (as out ptr))
    (return vm)))
  (fn same (params (got string) (want string) (src string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "source: " src)))
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn (doc "Run `c` and compare; with `stress` the GC collects at every safe point (`J3_J2_GC_STRESS`),\nand the output must be the same.") runOut (params (mem (ref Arena)) (c Case) (stress bool)) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out)))
    (= (. vm gcStress) stress)
    (match (call (. vm loadString) "t" (. c src))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call same (call (. out str)) (. c want) (. c src) "printed output"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (interp "source: " (. c src))))
        (expr (call printLn (call errText e mem)))
        (expr (call panic "unexpected script error")))))
    (expr (call (. vm destroy)))))
  (fn runErr (params (mem (ref Arena)) (c Case) (stress bool)) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out)))
    (= (. vm gcStress) stress)
    (match (call (. vm loadString) "t" (. c src))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call printLn (interp "source: " (. c src))))
        (expr (call panic "expected a script error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call same (call errText e mem) (. c want) (. c src) "error text")))))
    (expr (call (. vm destroy)))))
  (fn (doc "Errors leave the VM usable: frames unwind, open upvalues close.") testRecovery (params (mem (ref Arena))) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out)))
    (let ok _ (bool true))
    (match (call (. vm loadString) "a" "fn f(n) { let k = n; let g = fn() { return k; }; return g() / 0; } f(1);")
      (arm (pats (variant Result.Ok (wild))) (block
        (= ok (bool false))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call same (call errText e mem) "a:1:61: division by zero" "f" "first error")))))
    (if (! ok) (block
      (expr (call panic "expected an error"))))
    (if (|| (|| (!= (. vm nframes) 0) (!= (. vm top) 0)) (!= (. vm open) (as 0 ptr))) (block
      (expr (call panic "vm not unwound"))))
    (match (call (. vm loadString) "b" "fn r(n) { return r(n + 1); } r(0);")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "expected stack overflow"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call same (call errText e mem) "b:1:19: stack overflow" "r" "second error")))))
    (match (call (. vm loadString) "c" "print(\"still fine\", 6 * 7);")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call same (call (. out str)) "still fine 42\n" "c" "after errors"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (call errText e mem)))
        (expr (call panic "vm broken after errors")))))
    (expr (call (. vm destroy)))))
  (fn testDump (params (mem (ref Arena))) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out)))
    (match (call (. j2 compileChunk) (& vm) "d" "let a = 1; fn f(this, x) { return this.v + x; } print(a.f(2));")
      (arm (pats (variant Result.Ok (bind f))) (block
        (let t _ (call (. Text new) mem))
        (expr (call (. j2 dumpProto) (& t) (call (. (call (. j2 closureOf) f) protoOf))))
        (let s _ (call (. t str)))
        (let wants (array 8 string) (array-lit "fn main" "fn f params=2" " this\n" "METHOD" "GETFIELD" "; \"v\"" "SETENV" "RETURN"))
        (for-each _ want wants (block
          (if (< (call find s want) 0) (block
            (expr (call printLn s))
            (expr (call printLn (interp "missing: " want)))
            (expr (call panic "dump"))))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (call errText e mem)))
        (expr (call panic "compile")))))
    (expr (call (. vm destroy)))))
  (fn scriptDir (params) string (block
    (if (call exists "examples/j2_script/j2-scripts/hello/main.j2") (block
      (return "examples/j2_script/j2-scripts/")))
    (return "../examples/j2_script/j2-scripts/")))
  (const (doc "The game's natives the example scripts read (`SCRIPTING.md`); the built-ins come from `openLibs`.") GAME_NAMES (array 12 string) (array-lit "defineEnemy" "defineWeapon" "spawn" "shoot" "enemies" "player" "score" "arena" "rgb" "drawText" "drawCircle" "drawRect"))
  (fn (doc "The example scripts without `use` compile (running them needs the game's natives).") testExamples (params (mem (ref Arena))) _ (block
    (let names (array 2 string) (array-lit "base" "hello"))
    (for-each _ name names (block
      (let path _ (call (. Text new) mem))
      (expr (call (. path pushStr) (call scriptDir)))
      (expr (call (. path pushStr) name))
      (expr (call (. path pushStr) "/main.j2"))
      (let src _ "")
      (match (call readFile (call (. path str)) mem)
        (arm (pats (variant Result.Ok (bind b))) (block
          (= src (as b string))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call panic "can't read an example script")))))
      (let out _ (call (. Text new) mem))
      (let vm _ (call newVm mem (& out)))
      (for-each _ g GAME_NAMES (block
        (expr (call (. vm bind) g capture))))
      (match (call (. j2 compileChunk) (& vm) name src)
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (bind e))) (block
          (expr (call printLn (call errText e mem)))
          (expr (call panic "example script doesn't compile")))))
      (expr (call (. vm destroy)))))))
  (fn (doc "`head` + `unit` x n + `tail`.") repeated (params (mem (ref Arena)) (head string) (unit string) (n int) (tail string)) string (block
    (let t _ (call (. Text new) mem))
    (expr (call (. t pushStr) head))
    (for _ (.. 0 n) (block
      (expr (call (. t pushStr) unit))))
    (expr (call (. t pushStr) tail))
    (return (call (. t str)))))
  (fn (doc "Left-nested chains: a long one is a clean error (not a native stack overflow in the\ncompiler), and one past 255 terms still compiles (the chain reuses one register).") testLongChains (params) _ (block
    (let mem _ (call (. Arena create) (<< 4 20)))
    (let out _ (call (. Text new) (& mem)))
    (let vm _ (call newVm (& mem) (& out)))
    (let deep (array 3 string) (array-lit (call repeated (& mem) "fn f() { return f; } let x = f" "()" 30000 ";") (call repeated (& mem) "let a = true; let x = a" " && a" 20000 ";") (call repeated (& mem) "let a = 1; let x = a" " + a" 20000 ";")))
    (for-each _ src deep (block
      (match (call (. vm loadString) "t" src)
        (arm (pats (variant Result.Ok (wild))) (block
          (expr (call panic "a 20000-term chain compiled"))))
        (arm (pats (variant Result.Err (bind e))) (block
          (let want _ ": expression too deeply nested")
          (let m _ (. e message))
          (if (|| (|| (< (. m len) (. want len)) (! (== (slice-expr m 0 4) "t:1:"))) (! (== (slice-expr m (- (. m len) (. want len)) (. m len)) want))) (block
            (expr (call printLn m))
            (expr (call panic "deep chain error")))))))))
    (let src _ (call repeated (& mem) "let a = 1; let t = {}; t.a = t; t.n = 3; let x = a" " + a" 600 "; let y = t"))
    (= src (call repeated (& mem) src ".a" 600 ".n;"))
    (= src (call repeated (& mem) src "" 0 " let z = `{a}{a}` + a + a; print(x, y, z);"))
    (match (call (. vm loadString) "u" src)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call same (call (. out str)) "601 3 1111\n" "600-term chains" "long chains"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "a 600-term chain failed to compile")))))
    (expr (call (. vm destroy)))
    (expr (call (. mem destroy)))))
  (fn main (params) _ (block
    (expr (call testLongChains))
    (let mem _ (call (. Arena create) (<< 1 20)))
    (for-each _ c OUT (block
      (expr (call runOut (& mem) c (bool false)))))
    (for-each _ c ERRS (block
      (expr (call runErr (& mem) c (bool false)))))
    (for-each _ c OUT (block
      (expr (call runOut (& mem) c (bool true)))))
    (for-each _ c ERRS (block
      (expr (call runErr (& mem) c (bool true)))))
    (expr (call testRecovery (& mem)))
    (expr (call testDump (& mem)))
    (expr (call testExamples (& mem)))
    (expr (call printLn "j2_vm_test ok")))))
--- stderr
--- exit 0
