(file (module proc_test)
  (use j3.io)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.proc)
  (use j3.proc (names Output ProcError))
  (use j3.option.Option)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn run (params (argv (slice string)) (input string) (a (ref Arena))) Output (block
    (match (call (. proc run) argv input a)
      (arm (pats (variant Result.Ok (bind o))) (block
        (return o)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic (interp "could not run " (index argv 0)))))))
    (return (struct-lit Output (field code (- 1)) (field out (as "" (slice u8))) (field err (as "" (slice u8)))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 4194304))
    (let echo (array 3 string) (array-lit "echo" "hi" "there"))
    (let o _ (call run (slice-expr echo _ _) "" (& a)))
    (expr (call ok (&& (call eq (call (. o outStr)) "hi there\n") (== (. o code) 0)) "echo"))
    (let sh (array 3 string) (array-lit "sh" "-c" "cat; echo oops >&2; exit 3"))
    (let o2 _ (call run (slice-expr sh _ _) "fed in" (& a)))
    (expr (call ok (call eq (call (. o2 outStr)) "fed in") "stdin reaches the program"))
    (expr (call ok (call eq (call (. o2 errStr)) "oops\n") "stderr kept apart"))
    (expr (call ok (== (. o2 code) 3) "exit code"))
    (let big _ (call (. a alloc) (targs u8) 1048576))
    (for i (.. 0 (. big len)) (block
      (= (index big i) (call u8 (+ 97 (% i 26))))))
    (let cat (array 1 string) (array-lit "cat"))
    (let o3 _ (call run (slice-expr cat _ _) (as big string) (& a)))
    (expr (call ok (== (. (. o3 out) len) (. big len)) "1 MiB through cat"))
    (expr (call ok (== (index (. o3 out) 777777) (index big 777777)) "bytes intact"))
    (let killed (array 3 string) (array-lit "sh" "-c" "kill -9 $$"))
    (expr (call ok (== (. (call run (slice-expr killed _ _) "" (& a)) code) (+ 128 9)) "signal shows as 128 + n"))
    (let nope (array 1 string) (array-lit "j3-no-such-program"))
    (match (call (. proc run) (slice-expr nope _ _) "" (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "missing program ran"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant ProcError.NotFound)) (block
          (expr (call ok (bool true) "missing program"))))
        (arm (pats (variant ProcError.ExecFailed)) (block
          (expr (call ok (bool false) "missing program: ExecFailed"))))
        (arm (pats (variant ProcError.Fail)) (block
          (expr (call ok (bool false) "missing program: Fail"))))))))
    (let notExec (array 1 string) (array-lit "/etc/hostname"))
    (match (call (. proc run) (slice-expr notExec _ _) "" (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "non-executable ran"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant ProcError.NotFound)) (block
          (expr (call ok (bool false) "non-executable: NotFound"))))
        (arm (pats (variant ProcError.ExecFailed)) (block
          (expr (call ok (bool true) "non-executable"))))
        (arm (pats (variant ProcError.Fail)) (block
          (expr (call ok (bool false) "non-executable: Fail"))))))))
    (let pwd (array 1 string) (array-lit "pwd"))
    (match (call (. proc startIn) (slice-expr pwd _ _) "/tmp" (& a))
      (arm (pats (variant Result.Ok (bind c))) (block
        (let out _ (call (. c collect) (as "" (slice u8)) (& a)))
        (expr (call ok (call eq (call (. out outStr)) "/tmp\n") "working directory"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "startIn")))))
    (expr (call ok (> (. (call (. sys env) "PATH") len) 0) "env PATH"))
    (expr (call ok (== (. (call (. sys env) "J3_SURELY_UNSET_VAR") len) 0) "env unset"))
    (let envsh (array 3 string) (array-lit "sh" "-c" "printf %s \"$HOME\""))
    (expr (call ok (call eq (call (. (call run (slice-expr envsh _ _) "" (& a)) outStr)) (call (. sys env) "HOME")) "child inherits the environment"))
    (let errsh (array 3 string) (array-lit "sh" "-c" "read x; printf err >&2; exit 3"))
    (match (call (. proc start) (slice-expr errsh _ _) (& a))
      (arm (pats (variant Result.Ok (bind c))) (block
        (let buf _ (call (. a alloc) (targs u8) 16))
        (let running _ (bool false))
        (match (call (. c tryWait))
          (arm (pats (variant Option.Some (wild))) (block))
          (arm (pats (variant Option.None)) (block
            (= running (bool true)))))
        (expr (call ok running "tryWait while running"))
        (let empty _ (bool false))
        (match (call (. c tryReadErr) buf)
          (arm (pats (variant Option.Some (wild))) (block))
          (arm (pats (variant Option.None)) (block
            (= empty (bool true)))))
        (expr (call ok empty "tryReadErr before output"))
        (expr (call ok (call (. c write) (as "go\n" (slice u8))) "write string bytes"))
        (let code _ (- 1))
        (let tries _ 0)
        (while (< tries 2000) (block
          (match (call (. c tryWait))
            (arm (pats (variant Option.Some (bind k))) (block
              (= code k)
              (break)))
            (arm (pats (variant Option.None)) (block
              (expr (call (. sys pollFds) (as 0 ptr) 0 1)))))
          (+= tries 1)))
        (expr (call ok (== code 3) "tryWait exit code"))
        (expr (call ok (&& (== (call (. c readErr) buf) 3) (call eq (as (slice-expr buf 0 3) string) "err")) "readErr after exit"))
        (expr (call ok (== (call (. c wait)) 3) "wait after tryWait"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "start sh")))))
    (expr (call ok (&& (call (. io canExec) "/bin/sh") (! (call (. io canExec) "/etc/passwd"))) "io.canExec"))
    (expr (call ok (< (call (. io openPath) "/surely/missing" (. sys O_RDONLY) 0) 0) "io.openPath missing"))
    (expr (call ok (&& (== (<< 1 20) 1048576) (== (>> (- 16) 2) (- 4))) "shifts"))
    (let envsh2 (array 3 string) (array-lit "sh" "-c" "echo $JZ_TEST$HOME"))
    (let extra (array 1 string) (array-lit "JZ_TEST=hello"))
    (let home _ (call (. sys env) "HOME"))
    (match (call (. proc runEnv) (slice-expr envsh2 _ _) "" (slice-expr extra _ _) (& a))
      (arm (pats (variant Result.Ok (bind eo))) (block
        (let s _ (call (. eo outStr)))
        (expr (call ok (&& (&& (== (. s len) (+ (. home len) 6)) (call eq (slice-expr s 0 5) "hello")) (call eq (slice-expr s 5 (+ 5 (. home len))) home)) "runEnv adds to the environment"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "runEnv")))))
    (expr (call ok (== (. (call (. (call run (slice-expr envsh2 _ _) "" (& a)) outStr)) len) (+ (. home len) 1)) "run without env"))
    (expr (call ok (&& (> (. (call (. io cwd) (& a)) len) 0) (== (index (call (. io cwd) (& a)) 0) 47)) "io.cwd"))
    (let t0 _ (call (. sys monotonicMs)))
    (expr (call ok (> t0 0) "monotonicMs"))
    (expr (call printLn (interp "proc_test: " CHECKS " checks ok"))))))
--- stderr
--- exit 0
