(file (module term_screen_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.memory.List)
  (use j3.option.Option)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.term.ATTR_BOLD)
  (use j3.term.ATTR_DIM)
  (use j3.term.ATTR_ITALIC)
  (use j3.term.ATTR_UNDERLINE)
  (use j3.term.Cell)
  (use j3.term.Color)
  (use j3.term.Style)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.grid.Grid)
  (use j3.term.input.Event)
  (use j3.term.screen)
  (use j3.term.screen.Screen)
  (use j3.term.tty)
  (use j3.term.tty.Raw)
  (use j3.text.Text)
  (use j3.text.contains)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn st (params (fg Color) (bg Color) (attr int)) Style (block
    (return (struct-lit Style (field fg fg) (field bg bg) (field attr (call u16 attr))))))
  (fn (doc "Everything waiting in the pipe, appended to `out`.") drain (params (fd int) (out (ref Text)) (buf (slice u8))) _ (block
    (while (bool true) (block
      (let n _ (call (. tty readFd) fd buf 0))
      (if (<= n 0) (block
        (break)))
      (expr (call (. out pushBytes) (slice-expr buf 0 n)))))))
  (fn openOrDie (params (fd int) (cols int) (rows int) (a (ref Arena))) Screen (block
    (match (call (. Screen openFds) (- 1) fd cols rows a)
      (arm (pats (variant Result.Ok (bind v))) (block
        (return v)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "open failed")))))
    (return (call openOrDie fd cols rows a))))
  (fn norm (params (cp i32)) i32 (block
    (return (if-expr (== cp 0) 32 cp))))
  (fn (doc "Feed the pipe into the replay grid and assert it matches the screen's back buffer cell for cell.") verify (params (s (ref Screen)) (g (ref Grid)) (p (ref Parser)) (rd int) (buf (slice u8)) (a (ref Arena)) (what string)) _ (block
    (let t _ (call (. Text new) a))
    (expr (call drain rd (& t) buf))
    (expr (call (. p feed) (call (. t str)) g))
    (expr (call ok (&& (== (call (. g cols)) (call (. s cols))) (== (call (. g rows)) (call (. s rows)))) (interp what ": size")))
    (expr (call ok (== (call (. g scrollbackLen)) 0) (interp what ": nothing scrolled")))
    (for y (.. 0 (call (. s rows))) (block
      (for x (.. 0 (call (. s cols))) (block
        (let want _ (call (. s cell) x y))
        (let got _ (call (. g cell) x y))
        (if (|| (|| (!= (. want width) (. got width)) (!= (. got style) (. want style))) (&& (!= (. want width) 0) (!= (call norm (. want cp)) (call norm (. got cp))))) (block
          (expr (call printLn (interp what ": cell " x "," y " want cp " (. want cp) " w " (call int (. want width)) " got cp " (. got cp) " w " (call int (. got width)))))
          (expr (call panic "replay differs from the back buffer"))))))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 4194304))
    (let buf _ (call (. a alloc) (targs u8) 65536))
    (let fds (array 2 i32) (array-lit 0 0))
    (expr (call ok (== (call (. sys pipe) (slice-expr fds _ _) 0) 0) "pipe"))
    (let rd _ (call int (index fds 0)))
    (let wr _ (call int (index fds 1)))
    (expr (call ok (! (call (. tty isTty) rd)) "pipe is not a tty"))
    (match (call (. tty size) wr)
      (arm (pats (variant Option.Some (wild))) (block
        (expr (call panic "pipe has a size"))))
      (arm (pats (variant Option.None)) (block)))
    (match (call (. Raw enter) rd)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "raw mode on a pipe"))))
      (arm (pats (variant Result.Err (wild))) (block)))
    (expr (call ok (== (call (. tty readFd) rd buf 10) 0) "empty pipe times out"))
    (let s _ (call openOrDie wr 40 12 (& a)))
    (let g _ (call (. Grid new) (& a) 40 12 0))
    (let p _ (call (. Parser new) (& a)))
    (let d _ (call (. Style plain)))
    (let red _ (call st (call (. Color palette) 1) (call (. Color default)) ATTR_BOLD))
    (let blue _ (call st (call (. Color rgb) 10 20 30) (call (. Color palette) 4) (| ATTR_UNDERLINE ATTR_ITALIC)))
    (let dim _ (call st (call (. Color palette) 200) (call (. Color palette) 9) ATTR_DIM))
    (expr (call (. s put) 2 1 "hello world" red))
    (expr (call (. s put) 14 1 "blue text" blue))
    (expr (call (. s put) 0 3 "dim and 256" dim))
    (expr (call ok (== (call (. s put) 1 5 "\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9ex" d) 7) "CJK width"))
    (expr (call (. s box) 20 4 12 5 red))
    (expr (call (. s fill) 21 5 10 3 46 blue))
    (expr (call (. s clipPush) 5 9 4 2))
    (expr (call (. s put) 0 9 "abcdefghij" d))
    (expr (call (. s put) 7 10 "\xe6\x97\xa5\xe6\x9c\xac" d))
    (expr (call (. s clipPop)))
    (expr (call ok (&& (&& (&& (== (. (call (. s cell) 4 9) cp) 0) (== (. (call (. s cell) 5 9) cp) 102)) (== (. (call (. s cell) 8 9) cp) 105)) (== (. (call (. s cell) 9 9) cp) 0)) "clip drew columns 5..8"))
    (expr (call ok (&& (&& (== (. (call (. s cell) 7 10) cp) 26085) (== (. (call (. s cell) 8 10) width) 0)) (== (. (call (. s cell) 9 10) cp) 0)) "wide cut by the clip dropped"))
    (expr (call (. s put) 39 11 "Z" red))
    (expr (call (. s setCursor) 3 2 (bool true)))
    (expr (call ok (call (. s flush)) "flush 1"))
    (let full _ (. s lastBytes))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 1"))
    (expr (call ok (&& (&& (call (. g cursorVisible)) (== (call (. g cursorX)) 3)) (== (call (. g cursorY)) 2)) "cursor shown at 3,2"))
    (expr (call (. s put) 8 1 "WORLD" red))
    (expr (call ok (call (. s flush)) "flush 2"))
    (expr (call ok (&& (> (. s lastBytes) 0) (< (. s lastBytes) 64)) (interp "one word diff is small (" (. s lastBytes) " bytes)")))
    (expr (call ok (< (* (. s lastBytes) 4) full) "diff is much smaller than the full redraw"))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 2"))
    (expr (call ok (&& (call (. s flush)) (== (. s lastBytes) 0)) "idle flush writes nothing"))
    (expr (call (. s put) 2 1 "hello" d))
    (expr (call (. s put) 14 1 "BLUE" (call st (call (. Color palette) 2) (call (. Color default)) 0)))
    (expr (call (. s setCursor) 0 0 (bool false)))
    (expr (call ok (call (. s flush)) "flush 4"))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 4"))
    (expr (call ok (! (call (. g cursorVisible))) "cursor hidden"))
    (expr (call (. s put) 0 7 "abcdef" d))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 5a"))
    (expr (call (. s put) 1 7 "\xe6\x97\xa5" red))
    (expr (call (. s put) 4 7 "\xe6\x9c\xac" d))
    (expr (call (. s put) 5 7 "q" d))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 5b"))
    (expr (call (. s put) 1 7 "xy" d))
    (expr (call (. s put) 2 5 "\xe6\x9c\xac" blue))
    (expr (call (. s put) 38 3 "\xe6\x97\xa5" d))
    (expr (call ok (== (. (call (. s cell) 38 3) cp) 26085) "wide fits in the last two columns"))
    (expr (call (. s put) 39 3 "\xe6\x97\xa5" d))
    (expr (call ok (== (. (call (. s cell) 39 3) cp) 0) "wide in the last column is dropped"))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 5c"))
    (expr (call (. s resize) 30 8))
    (expr (call (. g resize) 30 8))
    (expr (call (. s put) 0 0 "small" red))
    (expr (call (. s put) 29 7 "R" blue))
    (expr (call (. s box) 0 1 30 7 d))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 6 small"))
    (expr (call (. s resize) 40 12))
    (expr (call (. g resize) 40 12))
    (expr (call (. s put) 5 5 "big again" dim))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 6 big"))
    (for y (.. 0 12) (block
      (expr (call (. s fill) 0 y 40 1 (call i32 (+ 33 y)) (call st (call (. Color palette) y) (call (. Color palette) (- 15 y)) (& y 3))))))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 7"))
    (expr (call (. s clear)))
    (expr (call (. s flush)))
    (expr (call verify (& s) (& g) (& p) rd buf (& a) "frame 7 clear"))
    (let ev _ (call (. (type-path List Event) new) (& a)))
    (expr (call ok (== (call (. s poll) 0 (& ev)) 0) "no events"))
    (expr (call (. s close)))
    (expr (call (. s close)))
    (let t _ (call (. Text new) (& a)))
    (expr (call drain rd (& t) buf))
    (expr (call ok (&& (call contains (call (. t str)) "[?1049l") (call contains (call (. t str)) "[?25h")) "close restores the screen"))
    (let fds2 (array 2 i32) (array-lit 0 0))
    (expr (call ok (== (call (. sys pipe) (slice-expr fds2 _ _) 0) 0) "pipe 2"))
    (let pid _ (call (. sys fork)))
    (if (== pid 0) (block
      (let c _ (call (. Arena create) 65536))
      (match (call (. Screen openFds) (- 1) (call int (index fds2 1)) 10 4 (& c))
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call (. sys exit) 2)))))
      (expr (call panic "expected panic in the exit hook test"))))
    (expr (call ok (> pid 0) "fork"))
    (let status i32 0)
    (expr (call (. sys waitpid) pid (& status) 0))
    (expr (call ok (== (call (. sys exitCode) status) 101) "child panicked"))
    (let t2 _ (call (. Text new) (& a)))
    (expr (call drain (call int (index fds2 0)) (& t2) buf))
    (expr (call ok (call contains (call (. t2 str)) "[?1049h") "child entered the alt screen"))
    (expr (call ok (&& (&& (call contains (call (. t2 str)) "[?1049l") (call contains (call (. t2 str)) "[?25h")) (call contains (call (. t2 str)) "[?2004l")) "panic ran the restore"))
    (expr (call printLn "term_screen_test ok")))))
--- stderr
--- exit 0
