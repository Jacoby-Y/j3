(file (module png_test)
  (use j3.gfx.canvas)
  (use j3.gfx.canvas (names Canvas Mode rgb))
  (use j3.io (names printLn readFile))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let c _ (call (. Canvas create) (& mem) 301 97 (. Mode Pixel)))
    (for i (.. 0 (. (. c pixels) len)) (block
      (= (index (. c pixels) i) (call u8 (% (+ (* i 7) (/ i 1203)) 251)))))
    (expr (call (. c fillRect) 10 10 200 50 (call rgb 30 40 50)))
    (match (call (. c savePng) "/tmp/j3-png-test.png" (& mem))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save")))))
    (let back _ (call (. canvas loadPng) "/tmp/j3-png-test.png" (& mem)))
    (if (|| (!= (. back w) (. c w)) (!= (. back h) (. c h))) (block
      (expr (call panic "size"))))
    (for i (.. 0 (. (. c pixels) len)) (block
      (if (!= (index (. back pixels) i) (index (. c pixels) i)) (block
        (expr (call panic "pixel"))))))
    (expr (call printLn "png ok")))))
--- stderr
--- exit 0
