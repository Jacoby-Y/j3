(file (module term_ansi_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.memory.List)
  (use j3.rand.Rng)
  (use j3.sys.panic)
  (use j3.term)
  (use j3.term.Color)
  (use j3.term.Style)
  (use j3.term.ansi)
  (use j3.term.ansi.Params)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.ansi.Run)
  (use j3.text.Text)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! (== a b)) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call printLn (interp "  want: " b)))
      (expr (call printLn (interp "  got:  " a)))
      (expr (call panic msg))))))
  (fn (doc "`s` with `~` as ESC and `$` as BEL.") mk (params (s string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 (. s len)) (block
      (let c _ (index s i))
      (expr (call (. t push) (if-expr (== c 126) 27 (if-expr (== c 36) 7 (if-expr (== c 94) 24 (if-expr (== c 124) 26 c))))))))
    (return (call (. t str)))))
  (struct (doc "Writes every event as a token so two runs can be compared as strings.") Rec
    (field log Text)
    (fn print (params (this (ref Rec)) (cp i32)) _ (block
      (expr (call (. (call (. (. this log) add) "P") pushInt) (call int cp)))
      (expr (call (. (. this log) add) " "))))
    (fn exec (params (this (ref Rec)) (c0 u8)) _ (block
      (expr (call (. (call (. (. this log) add) "X") pushInt) (call int c0)))
      (expr (call (. (. this log) add) " "))))
    (fn csi (params (this (ref Rec)) (p (ref Params)) (final u8)) _ (block
      (expr (call (. (call (. (. this log) add) "C") pushInt) (call int (. p marker))))
      (expr (call (. (call (. (. this log) add) "/") pushInt) (. p inter)))
      (expr (call (. (. this log) add) "/"))
      (for k (.. 0 (. p n)) (block
        (if (> k 0) (block
          (expr (call (. (. this log) add) (if-expr (!= (index (. p colon) k) 0) ":" ";")))))
        (expr (call (. (. this log) pushInt) (call int (index (. p v) k))))))
      (expr (call (. (call (. (. this log) add) "/") pushInt) (call int final)))
      (expr (call (. (. this log) add) " "))))
    (fn esc (params (this (ref Rec)) (inter int) (final u8)) _ (block
      (expr (call (. (call (. (. this log) add) "E") pushInt) inter))
      (expr (call (. (call (. (. this log) add) "/") pushInt) (call int final)))
      (expr (call (. (. this log) add) " "))))
    (fn apc (params (this (ref Rec)) (bytes string)) _ (block))
    (fn osc (params (this (ref Rec)) (bytes string)) _ (block
      (expr (call (. (call (. (. this log) add) "O") add) bytes))
      (expr (call (. (. this log) add) " ")))))
  (fn whole (params (s string) (a (ref Arena))) string (block
    (let r _ (struct-lit Rec (field log (call (. Text new) a))))
    (let p _ (call (. Parser new) a))
    (expr (call (. p feed) s (& r)))
    (return (call (. (. r log) str)))))
  (fn split2 (params (s string) (at int) (a (ref Arena))) string (block
    (let r _ (struct-lit Rec (field log (call (. Text new) a))))
    (let p _ (call (. Parser new) a))
    (expr (call (. p feed) (slice-expr s 0 at) (& r)))
    (expr (call (. p feed) (slice-expr s at (. s len)) (& r)))
    (return (call (. (. r log) str)))))
  (fn bytewise (params (s string) (a (ref Arena))) string (block
    (let r _ (struct-lit Rec (field log (call (. Text new) a))))
    (let p _ (call (. Parser new) a))
    (for i (.. 0 (. s len)) (block
      (expr (call (. p feed) (slice-expr s i (+ i 1)) (& r)))))
    (return (call (. (. r log) str)))))
  (fn splits (params (s string) (a (ref Arena))) _ (block
    (let want _ (call whole s a))
    (expr (call eq (call bytewise s a) want "bytewise"))
    (for at (..= 0 (. s len)) (block
      (expr (call eq (call split2 s at a) want (interp "split at " at)))))))
  (struct (doc "Events with `Params` applied as SGR on top of `style`.") Pen
    (field style Style)
    (fn print (params (this (ref Pen)) (cp i32)) _ (block))
    (fn exec (params (this (ref Pen)) (c0 u8)) _ (block))
    (fn esc (params (this (ref Pen)) (inter int) (final u8)) _ (block))
    (fn apc (params (this (ref Pen)) (bytes string)) _ (block))
    (fn osc (params (this (ref Pen)) (bytes string)) _ (block))
    (fn csi (params (this (ref Pen)) (p (ref Params)) (final u8)) _ (block
      (if (== final 109) (block
        (= (. this style) (call (. ansi sgr) (. this style) p)))))))
  (fn pen (params (s string) (a (ref Arena))) Style (block
    (let w _ (struct-lit Pen (field style (call (. Style plain)))))
    (let p _ (call (. Parser new) a))
    (expr (call (. p feed) (call mk s a) (& w)))
    (return (. w style))))
  (struct (doc "Counts and checksums events: no allocation, for the fuzz.") Sum
    (field h int)
    (field n int)
    (fn print (params (this (ref Sum)) (cp i32)) _ (block
      (= (. this h) (+ (+ (* (. this h) 31) (call int cp)) 1))
      (+= (. this n) 1)))
    (fn exec (params (this (ref Sum)) (c0 u8)) _ (block
      (= (. this h) (+ (+ (* (. this h) 31) (call int c0)) 7))
      (+= (. this n) 1)))
    (fn esc (params (this (ref Sum)) (inter int) (final u8)) _ (block
      (= (. this h) (+ (+ (* (. this h) 31) inter) (* (call int final) 3)))
      (+= (. this n) 1)))
    (fn apc (params (this (ref Sum)) (bytes string)) _ (block))
    (fn osc (params (this (ref Sum)) (bytes string)) _ (block
      (= (. this h) (+ (+ (* (. this h) 31) (. bytes len)) 11))
      (+= (. this n) 1)))
    (fn csi (params (this (ref Sum)) (p (ref Params)) (final u8)) _ (block
      (= (. this h) (+ (+ (+ (+ (* (. this h) 31) (call int final)) (* (. p n) 5)) (. p inter)) (call int (. p marker))))
      (for k (.. 0 (. p n)) (block
        (= (. this h) (+ (* (. this h) 31) (call int (index (. p v) k))))))
      (+= (. this n) 1))))
  (fn testEvents (params (a (ref Arena))) _ (block
    (expr (call eq (call whole "hi" a) "P104 P105 " "ascii"))
    (expr (call eq (call whole (call mk "a~[1;31mb" a) a) "P97 C0/0/1;31/109 P98 " "sgr"))
    (expr (call eq (call whole (call mk "~[;5H" a) a) "C0/0/-1;5/72 " "empty param"))
    (expr (call eq (call whole (call mk "~[m" a) a) "C0/0//109 " "no params"))
    (expr (call eq (call whole (call mk "~[?25l" a) a) "C63/0/25/108 " "private marker"))
    (expr (call eq (call whole (call mk "~[2 q" a) a) "C0/32/2/113 " "intermediate"))
    (expr (call eq (call whole (call mk "~[38:2::1:2:3m" a) a) "C0/0/38:2:-1:1:2:3/109 " "colon params"))
    (expr (call eq (call whole (call mk "~(B~7~M" a) a) "E40/66 E0/55 E0/77 " "esc"))
    (expr (call eq (call whole (call mk "~]0;title$x" a) a) "O0;title P120 " "osc bel"))
    (expr (call eq (call whole (call mk "~]0;title~\\x" a) a) "O0;title P120 " "osc st"))
    (expr (call eq (call whole "\xc3\xa9\xe2\x82\xacx" a) "P233 P8364 P120 " "utf8"))
    (expr (call eq (call whole "\xf0\x9f\x98\x80" a) "P128512 " "utf8 4 bytes"))
    (expr (call eq (call whole (call mk "a\n\r\tb" a) a) "P97 X10 X13 X9 P98 " "c0"))
    (expr (call eq (call whole (call mk "~[1\n2m" a) a) "X10 C0/0/12/109 " "c0 inside csi runs and keeps the sequence"))
    (expr (call eq (call whole (call mk "~[1;2~[3m" a) a) "C0/0/3/109 " "esc restarts csi"))
    (expr (call eq (call whole (call mk "~[1;2^x" a) a) "X24 P120 " "can aborts"))
    (expr (call eq (call whole (call mk "~[1;2|x" a) a) "X26 P120 " "sub aborts"))
    (expr (call eq (call whole (call mk "~[1:2;3;4:5:6m" a) a) "C0/0/1:2;3;4:5:6/109 " "mixed groups"))
    (expr (call eq (call whole (call mk "~[?1;2<m" a) a) "" "private marker after a digit ignores the sequence"))
    (expr (call eq (call whole (call mk "~Pq0;2;0;0;0~\\ok" a) a) "P111 P107 " "dcs dropped"))
    (expr (call eq (call whole (call mk "~_apc$x~\\y" a) a) "P121 " "apc runs to ST, not BEL"))))
  (fn testMalformed (params (a (ref Arena))) _ (block
    (let t _ (call (. Text new) a))
    (let bad (array 17 int) (array-lit 128 65 226 130 65 192 175 237 160 128 244 144 128 128 255 226 130))
    (for-each _ b bad (block
      (expr (call (. t push) (call u8 b)))))
    (expr (call eq (call whole (call (. t str)) a) "P65533 P65 P65533 P65 P65533 P65533 P65533 P65533 P65533 " "bad utf8"))
    (expr (call splits (call (. t str)) a))
    (let big _ (call (. Text new) a))
    (expr (call (. big push) 27))
    (expr (call (. big push) 91))
    (for i (.. 0 60) (block
      (expr (call (. big pushInt) i))
      (expr (call (. big push) 59))))
    (expr (call (. big push) 109))
    (let log _ (call whole (call (. big str)) a))
    (expr (call ok (&& (> (. log len) 10) (== (index log 0) 67)) "too many params dispatches"))
    (expr (call ok (! (&& (== (index log (- (. log len) 2)) 53) (== (index log (- (. log len) 3)) 59))) "no param past the cap"))
    (expr (call eq (call whole (call mk "~[99999999999999999999m" a) a) "C0/0/65535/109 " "param clamp"))
    (expr (call eq (call whole (call mk "~[    m" a) a) "" "intermediate overflow"))
    (let o _ (call (. Text new) a))
    (expr (call (. o push) 27))
    (expr (call (. o add) "]0;"))
    (for i (.. 0 5000) (block
      (expr (call (. o push) 97))))
    (expr (call (. o push) 7))
    (expr (call (. o add) "z"))
    (expr (call eq (call whole (call (. o str)) a) "P122 " "overlong osc dropped"))
    (let o2 _ (call (. Text new) a))
    (expr (call (. o2 push) 27))
    (expr (call (. o2 add) "]"))
    (for i (.. 0 (. ansi MAX_OSC)) (block
      (expr (call (. o2 push) 97))))
    (expr (call (. o2 push) 7))
    (expr (call ok (== (. (call whole (call (. o2 str)) a) len) (+ (. ansi MAX_OSC) 2)) "osc at the cap"))
    (expr (call eq (call whole (call mk "~]2;h\xc3\xa9$" a) a) "O2;h\xc3\xa9 " "osc utf8"))))
  (fn testSplits (params (a (ref Arena))) _ (block
    (let sample _ (call mk "hi~[1;31mred~[0m \xc3\xa9\xe2\x82\xac\xf0\x9f\x98\x80 ~]0;ti\xc3\xa9tle$~]8;;http://x~\\link~(B~[38:2::1:2:3m~[;5H~[?25l$\n~[2 q~Pq1;2~\\z~[1\n2m~[3~[m^x~7" a))
    (expr (call splits sample a))
    (expr (call splits (call mk "~[1;2~[3m~]x~]y$~_z~\\w" a) a))))
  (fn testSgr (params (a (ref Arena))) _ (block
    (let s _ (call pen "~[1;3;4;9m" a))
    (expr (call ok (call (. s has) (| (| (| (. term ATTR_BOLD) (. term ATTR_ITALIC)) (. term ATTR_UNDERLINE)) (. term ATTR_STRIKE))) "attrs on"))
    (expr (call ok (! (call (. s has) (. term ATTR_DIM))) "dim off"))
    (expr (call ok (call (. (call pen "~[1;2;5;7;8m" a) has) (| (| (| (| (. term ATTR_BOLD) (. term ATTR_DIM)) (. term ATTR_BLINK)) (. term ATTR_INVERSE)) (. term ATTR_HIDDEN))) "more attrs"))
    (expr (call ok (== (call pen "~[1;2;3;4;5;7;8;9m~[21;22;23;24;25;27;28;29m" a) (call (. Style plain))) "21..29 clear"))
    (expr (call ok (== (call pen "~[1;31;42m~[0m" a) (call (. Style plain))) "0 resets"))
    (expr (call ok (== (call pen "~[1m~[m" a) (call (. Style plain))) "empty resets"))
    (expr (call ok (== (call pen "~[1m~[;m" a) (call (. Style plain))) "empty param is 0"))
    (expr (call ok (== (. (call pen "~[31m" a) fg) (call (. Color palette) 1)) "31"))
    (expr (call ok (== (. (call pen "~[37m" a) fg) (call (. Color palette) 7)) "37"))
    (expr (call ok (== (. (call pen "~[91m" a) fg) (call (. Color palette) 9)) "91"))
    (expr (call ok (== (. (call pen "~[97m" a) fg) (call (. Color palette) 15)) "97"))
    (expr (call ok (== (. (call pen "~[44m" a) bg) (call (. Color palette) 4)) "44"))
    (expr (call ok (== (. (call pen "~[107m" a) bg) (call (. Color palette) 15)) "107"))
    (expr (call ok (== (call pen "~[31;42;39;49m" a) (call (. Style plain))) "39 49"))
    (expr (call ok (== (. (call pen "~[38;5;200m" a) fg) (call (. Color palette) 200)) "38;5;n"))
    (expr (call ok (== (. (call pen "~[48;5;17m" a) bg) (call (. Color palette) 17)) "48;5;n"))
    (expr (call ok (== (. (call pen "~[38;2;10;20;30m" a) fg) (call (. Color rgb) 10 20 30)) "38;2;r;g;b"))
    (expr (call ok (== (. (call pen "~[48;2;1;2;3m" a) bg) (call (. Color rgb) 1 2 3)) "48;2;r;g;b"))
    (expr (call ok (== (. (call pen "~[38:5:99m" a) fg) (call (. Color palette) 99)) "38:5:n"))
    (expr (call ok (== (. (call pen "~[38:2:4:5:6m" a) fg) (call (. Color rgb) 4 5 6)) "38:2:r:g:b"))
    (expr (call ok (== (. (call pen "~[38:2::7:8:9m" a) fg) (call (. Color rgb) 7 8 9)) "38:2::r:g:b"))
    (expr (call ok (== (. (call pen "~[48:2:0:7:8:9m" a) bg) (call (. Color rgb) 7 8 9)) "48:2:cs:r:g:b"))
    (let c _ (call pen "~[38;2;1;2;3;1;4m" a))
    (expr (call ok (&& (== (. c fg) (call (. Color rgb) 1 2 3)) (call (. c has) (| (. term ATTR_BOLD) (. term ATTR_UNDERLINE)))) "codes after a color still apply"))
    (let d _ (call pen "~[38:5:9;1m" a))
    (expr (call ok (&& (== (. d fg) (call (. Color palette) 9)) (call (. d has) (. term ATTR_BOLD))) "colon color then more"))
    (expr (call ok (! (call (. (call pen "~[4:0m" a) has) (. term ATTR_UNDERLINE))) "4:0 is off"))
    (expr (call ok (call (. (call pen "~[4:3m" a) has) (. term ATTR_UNDERLINE)) "4:3 is on"))
    (expr (call ok (== (call pen "~[38;5m" a) (call (. Style plain))) "truncated 38 is ignored"))
    (expr (call ok (== (call pen "~[38;2;1;2m" a) (call (. Style plain))) "truncated rgb is ignored"))
    (expr (call ok (call (. (call pen "~[999;1m" a) has) (. term ATTR_BOLD)) "unknown code skipped"))
    (expr (call ok (== (call pen "~[58;2;1;2;3m" a) (call (. Style plain))) "58;2 consumed whole"))
    (expr (call ok (== (call pen "~[58;5;9m" a) (call (. Style plain))) "58;5 consumed whole (no blink)"))
    (expr (call ok (&& (== (call pen "~[58:2::1:2:3m" a) (call (. Style plain))) (== (call pen "~[58:5:9m" a) (call (. Style plain)))) "58 colon forms"))
    (let u _ (call pen "~[58;2;1;2;3;1;59m" a))
    (expr (call ok (&& (&& (call (. u has) (. term ATTR_BOLD)) (== (. u fg) (call (. Color default)))) (! (call (. u has) (. term ATTR_BLINK)))) "codes after 58 apply, 59 ignored"))
    (expr (call ok (&& (== (call pen "~[38;5;256m" a) (call (. Style plain))) (== (call pen "~[38:5:300m" a) (call (. Style plain)))) "palette over 255 ignored"))
    (expr (call ok (&& (== (call pen "~[48;2;1;256;3m" a) (call (. Style plain))) (== (call pen "~[38:2::1:2:999m" a) (call (. Style plain)))) "rgb over 255 ignored"))
    (expr (call ok (== (. (call pen "~[38;5;255m" a) fg) (call (. Color palette) 255)) "255 is fine"))
    (let k _ (call (. Color rgb) 1 2 3))
    (expr (call ok (&& (&& (&& (== (call (. k kind)) (. term COLOR_RGB)) (== (call (. k r)) 1)) (== (call (. k g)) 2)) (== (call (. k b)) 3)) "rgb read"))
    (expr (call ok (&& (== (call (. (call (. Color palette) 5) kind)) (. term COLOR_PALETTE)) (== (call (. (call (. Color palette) 5) index)) 5)) "palette read"))
    (expr (call ok (== (call (. (call (. Color default)) kind)) (. term COLOR_DEFAULT)) "default kind"))))
  (struct Grab
    (field n int)
    (field a int)
    (field b int)
    (field c int)
    (field sc int)
    (field s1 int)
    (field s2 int)
    (fn print (params (this (ref Grab)) (cp i32)) _ (block))
    (fn exec (params (this (ref Grab)) (c0 u8)) _ (block))
    (fn esc (params (this (ref Grab)) (inter int) (final u8)) _ (block))
    (fn apc (params (this (ref Grab)) (bytes string)) _ (block))
    (fn osc (params (this (ref Grab)) (bytes string)) _ (block))
    (fn csi (params (this (ref Grab)) (p (ref Params)) (final u8)) _ (block
      (= (. this n) (call (. p count)))
      (= (. this a) (call (. p param) 0 99))
      (= (. this b) (call (. p param) 1 98))
      (= (. this c) (call (. p param) 2 97))
      (= (. this sc) (call (. p subCount) 0))
      (= (. this s1) (call (. p sub) 0 1 55))
      (= (. this s2) (+ (call (. p sub) 7 1 44) (call (. p sub) (- 1) 0 0))))))
  (fn testParams (params (a (ref Arena))) _ (block
    (let h _ (struct-lit Grab (field n 0) (field a 0) (field b 0) (field c 0) (field sc 0) (field s1 0) (field s2 0)))
    (let q _ (call (. Parser new) a))
    (expr (call (. q feed) (call mk "~[1m" a) (& h)))
    (expr (call ok (&& (== (. h s1) 55) (== (. h s2) 44)) "sub on a missing group returns def"))
    (let g _ (struct-lit Grab (field n 0) (field a 0) (field b 0) (field c 0) (field sc 0) (field s1 0) (field s2 0)))
    (let p _ (call (. Parser new) a))
    (expr (call (. p feed) (call mk "~[;5H" a) (& g)))
    (expr (call ok (&& (&& (&& (== (. g n) 2) (== (. g a) 99)) (== (. g b) 5)) (== (. g c) 97)) "param defaults"))
    (expr (call (. p feed) (call mk "~[4:3;7;m" a) (& g)))
    (expr (call ok (&& (&& (&& (&& (&& (== (. g n) 3) (== (. g a) 4)) (== (. g b) 7)) (== (. g c) 97)) (== (. g sc) 1)) (== (. g s1) 3)) "sub params"))
    (expr (call (. p feed) (call mk "~[0m" a) (& g)))
    (expr (call ok (&& (&& (&& (== (. g n) 1) (== (. g a) 0)) (== (. g sc) 0)) (== (. g s1) 55)) "zero is not missing"))
    (expr (call (. p feed) (call mk "~[m" a) (& g)))
    (expr (call ok (&& (== (. g n) 0) (== (. g a) 99)) "none"))))
  (fn testText (params (a (ref Arena))) _ (block
    (expr (call eq (call (. ansi strip) (call mk "a~[1;31mb~[0mc~]0;t$d~(Be\n\xc3\xa9$f" a) a) "abcde\n\xc3\xa9f" "strip"))
    (expr (call eq (call (. ansi strip) "" a) "" "strip empty"))
    (let r _ (call (. ansi toRuns) (call mk "ab~[1mcd~[1me~[0mf~[31m~[0mg" a) a))
    (expr (call ok (== (. r len) 3) "runs merge same style"))
    (expr (call ok (&& (&& (== (. (index (. r items) 0) start) 0) (== (. (index (. r items) 0) len) 2)) (== (. (index (. r items) 0) style) (call (. Style plain)))) "run 0"))
    (expr (call ok (&& (&& (== (. (index (. r items) 1) start) 2) (== (. (index (. r items) 1) len) 3)) (call (. (. (index (. r items) 1) style) has) (. term ATTR_BOLD))) "run 1"))
    (expr (call ok (&& (&& (== (. (index (. r items) 2) start) 5) (== (. (index (. r items) 2) len) 2)) (== (. (index (. r items) 2) style) (call (. Style plain)))) "run 2 merges f and g"))
    (expr (call ok (== (. (call (. ansi toRuns) "" a) len) 0) "no runs for empty"))
    (expr (call ok (== (. (call (. ansi toRuns) (call mk "~[1m~[0m" a) a) len) 0) "no runs for style-only"))
    (let one _ (call (. ansi toRuns) "plain" a))
    (expr (call ok (&& (== (. one len) 1) (== (. (index (. one items) 0) len) 5)) "one run"))
    (let u _ (call (. ansi toRuns) (call mk "~[32m\xc3\xa9~[0mx" a) a))
    (expr (call ok (&& (&& (== (. u len) 2) (== (. (index (. u items) 0) len) 2)) (== (. (index (. u items) 1) start) 2)) "runs count bytes"))))
  (fn fuzzInput (params (a (ref Arena)) (n int)) string (block
    (let rng _ (call (. Rng new) 12345))
    (let t _ (call (. Text new) a))
    (let alpha _ (call mk "~~~[[[]];:?<>=0123456789 !\"%&'()*+,-./@AHJKmPqXZ_\\ $^|\n" a))
    (for i (.. 0 n) (block
      (let r _ (call (. rng intRange) 0 100))
      (if (< r 55) (block
        (expr (call (. t push) (index alpha (call (. rng intRange) 0 (. alpha len)))))) (block
        (if (< r 80) (block
          (expr (call (. t push) (call u8 (call (. rng intRange) 0 256))))) (block
          (expr (call (. t push) (call u8 (call (. rng intRange) 32 127))))))))))
    (return (call (. t str)))))
  (fn testFuzz (params (a (ref Arena))) _ (block
    (let data _ (call fuzzInput a 1048576))
    (let w _ (struct-lit Sum (field h 0) (field n 0)))
    (let p _ (call (. Parser new) a))
    (expr (call (. p feed) data (& w)))
    (expr (call ok (> (. w n) 1000) "fuzz produced events"))
    (let rng _ (call (. Rng new) 99))
    (let w2 _ (struct-lit Sum (field h 0) (field n 0)))
    (let p2 _ (call (. Parser new) a))
    (let i _ 0)
    (while (< i (. data len)) (block
      (let n _ (call (. rng intRange) 1 70))
      (if (> (+ i n) (. data len)) (block
        (= n (- (. data len) i))))
      (expr (call (. p2 feed) (slice-expr data i (+ i n)) (& w2)))
      (+= i n)))
    (expr (call ok (&& (== (. w h) (. w2 h)) (== (. w n) (. w2 n))) "fuzz chunked equals whole"))
    (let s _ (call (. ansi strip) (slice-expr data 0 65536) a))
    (expr (call ok (<= (. s len) (* 65536 3)) "strip bounded"))
    (expr (call ok (>= (. (call (. ansi toRuns) (slice-expr data 0 65536) a) len) 0) "runs survive"))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 33554432))
    (expr (call testEvents (& a)))
    (expr (call testMalformed (& a)))
    (expr (call testSplits (& a)))
    (expr (call testSgr (& a)))
    (expr (call testParams (& a)))
    (expr (call testText (& a)))
    (expr (call testFuzz (& a)))
    (expr (call printLn "term_ansi_test ok")))))
