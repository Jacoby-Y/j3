(file (module clipdata_test)
  (use j3.game)
  (use j3.io.printLn)
  (use j3.sys (names env panic))
  (use j3.text.same)
  (fn main (params) _ (block
    (let headless _ (call same (call env "SDL_VIDEODRIVER") "offscreen"))
    (let types _ (call (. game clipboardTypes)))
    (for i (.. 0 (. types len)) (block
      (expr (call printLn (index types i)))))
    (let png _ (call (. game clipboardData) "image/png"))
    (let text _ (call (. game clipboardData) "text/plain"))
    (let none _ (call (. game clipboardData) "application/x-not-offered"))
    (if (!= (. none len) 0) (block
      (expr (call panic "clipdata: unoffered type gave bytes"))))
    (if (&& headless (|| (|| (!= (. types len) 0) (!= (. png len) 0)) (!= (. text len) 0))) (block
      (expr (call panic "clipdata: headless clipboard not empty"))))
    (expr (call printLn "clipdata ok")))))
--- stderr
--- exit 0
