(file (module a11y_inbox_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory (names Arena rewindScratch))
  (use j3.sys.panic)
  (use j3.text (names same scratchText))
  (use j3.thread (names join spawn Thread))
  (use j3.ui.a11y)
  (use j3.ui.a11y.Inbox)
  (use j3.ui.css.Css)
  (use j3.ui.dom.Dom)
  (const TOTAL int 1000)
  (struct Job
    (field ib (ref Inbox))
    (field h int)
    (field sent int)
    (field full int)
    (field done int))
  (mod-let CHECKS int _)
  (mod-let TB int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (= TB (call (. d open) 0 (call (. d tag) "input") 1))
    (expr (call (. d attrType) TB "text"))
    (expr (call (. d attrAria) TB "Box"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "The value is `n,n,n,...` (about 200 bytes): every part must be the same number.") consistent (params (s string)) bool (block
    (if (== (. s len) 0) (block
      (return (bool true))))
    (let first _ 0)
    (while (&& (< first (. s len)) (!= (index s first) 44)) (block
      (+= first 1)))
    (let i _ 0)
    (while (< i (. s len)) (block
      (for k (.. 0 first) (block
        (if (|| (>= (+ i k) (. s len)) (!= (index s (+ i k)) (index s k))) (block
          (return (bool false))))))
      (+= i first)
      (if (&& (< i (. s len)) (!= (index s i) 44)) (block
        (return (bool false))))
      (+= i 1)))
    (return (bool true))))
  (fn worker (params (p ptr)) _ (block
    (let job _ (as p (ref Job)))
    (for n (.. 0 TOTAL) (block
      (expr (call rewindScratch))
      (let t _ (call scratchText))
      (for k (.. 0 40) (block
        (if (> k 0) (block
          (expr (call (. t push) 44))))
        (expr (call (. t pushInt) n))))
      (while (! (call (. a11y post) (. job ib) (. job h) (. a11y A_SET) (float 0x0000000000000000) (call (. t str)))) (block
        (+= (. job full) 1)))
      (+= (. job sent) 1)))
    (expr (atomic atomicStore seqcst (& (. job done)) 1))))
  (fn (doc "An action handler that posts back during `drain`: with the lock held this hangs.") repost (params (p ptr)) _ (block
    (let ib _ (as p (ref Inbox)))
    (expr (call (. a11y post) ib (- 1) (. a11y A_FOCUS) (float 0x0000000000000000) ""))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let ib _ (call (. a11y inbox) (& mem) (& d) 2))
    (let job _ (struct-lit Job (field ib ib) (field h (call (. d handle) TB)) (field sent 0) (field full 0) (field done 0)))
    (let th _ (struct-lit Thread (field f worker)))
    (expr (call spawn (& th) "poster" worker (as (& job) ptr)))
    (let got _ 0)
    (let torn _ 0)
    (let wakes _ 0)
    (while (|| (== (atomic atomicLoad seqcst (& (. job done))) 0) (> (. ib n) 0)) (block
      (if (call (. d wantsFrame)) (block
        (+= wakes 1)))
      (+= got (call (. a11y drain) ib (& mem)))
      (expr (call frame (& d)))
      (if (! (call consistent (call (. d strValue) TB))) (block
        (+= torn 1)))))
    (expr (call join (& th)))
    (+= got (call (. a11y drain) ib (& mem)))
    (expr (call frame (& d)))
    (expr (call ok (== (. job sent) TOTAL) "the worker sent everything"))
    (expr (call ok (== got TOTAL) (interp "every post delivered exactly once (got " got ")")))
    (expr (call ok (== torn 0) "no torn text"))
    (expr (call ok (> wakes 0) "the loop was woken"))
    (expr (call ok (call same (call (. d strValue) TB) (call a11y_last)) "the last post won"))
    (let ib2 _ (call (. a11y inbox) (& mem) (& d) 4))
    (expr (call (. a11y onAction) ib2 repost (as ib2 ptr)))
    (expr (call (. a11y post) ib2 (call (. d handle) TB) (. a11y A_FOCUS) (float 0x0000000000000000) ""))
    (expr (call ok (&& (== (call (. a11y drain) ib2 (& mem)) 1) (== (. ib2 n) 1)) "an action may post back during drain (no deadlock); it waits for the next drain"))
    (expr (call ok (== (call (. a11y drain) ib2 (& mem)) 1) "the re-posted action runs next"))
    (expr (call printLn (interp "a11y_inbox_test ok, checks passed: " CHECKS " (queue was full " (. job full) " times, woke " wakes ")")))))
  (fn a11y_last (params) string (block
    (let t _ (call scratchText))
    (for k (.. 0 40) (block
      (if (> k 0) (block
        (expr (call (. t push) 44))))
      (expr (call (. t pushInt) (- TOTAL 1)))))
    (return (call (. t str))))))
--- stderr
--- exit 0
