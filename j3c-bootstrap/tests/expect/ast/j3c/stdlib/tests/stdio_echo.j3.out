(file (module stdio_echo)
  (use j3.io)
  (use j3.io.IoError)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.result.Result)
  (use j3.text (names parseInt startsWith))
  (fn serve (params (a (ref Arena))) (gen Result int IoError) (block
    (let inp _ (call (. io stdin)))
    (let out _ (call (. io stdout)))
    (let count _ 0)
    (while (bool true) (block
      (let len _ (- 1))
      (while (bool true) (block
        (let line _ "")
        (match (? (call (. inp readLine) a))
          (arm (pats (variant Option.Some (bind l))) (block
            (= line l)))
          (arm (pats (variant Option.None)) (block
            (return (call (. Result Ok) count)))))
        (if (== (. line len) 0) (block
          (break)))
        (let key _ "Content-Length: ")
        (if (call startsWith line key) (block
          (match (call parseInt (slice-expr line (. key len) (. line len)) 10)
            (arm (pats (variant Option.Some (bind n))) (block
              (= len n)))
            (arm (pats (wild)) (block)))))))
      (if (< len 0) (block
        (return (call (. Result Err) (. IoError Other)))))
      (let body _ (? (call (. inp readExact) len a)))
      (expr (? (call (. out writeStr) (interp "Content-Length: " (+ len 6)))))
      (expr (? (call (. out writeStr) "\r\n\r\necho:")))
      (expr (? (call (. out write) body)))
      (expr (? (call (. out writeStr) "\n")))
      (expr (? (call (. out flush))))
      (+= count 1)))
    (return (call (. Result Ok) count))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (<< 1 16)))
    (match (call serve (& a))
      (arm (pats (variant Result.Ok (bind n))) (block
        (expr (call (. io printLn) (interp "done " n)))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call (. io printLn) "error"))))))))
--- stderr
--- exit 0
