(file (module drag_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.drag)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (mod-let CHECKS int _)
  (mod-let S St _)
  (struct St
    (field src int (- 1))
    (field b int (- 1))
    (field clicks int 0)
    (field starts int 0)
    (field startAt int (- 1))
    (field enters int 0)
    (field enterAt int (- 1))
    (field overs int 0)
    (field overAt int (- 1))
    (field leaves int 0)
    (field leaveAt int (- 1))
    (field drops int 0)
    (field dropAt int (- 1))
    (field ends int 0)
    (field endAt int (- 1))
    (field dropped bool (bool false))
    (field data string "")
    (field dragId int 0)
    (field reject bool (bool false))
    (field seq int 0)
    (field dropSeq int 0)
    (field endSeq int 0)
    (field zEnds int 0)
    (field zEndSeq int 0)
    (field z int (- 1))
    (field hide bool (bool false))
    (field showX bool (bool false))
    (field x int (- 1))
    (field old int (- 2))
    (field xEvents int 0)
    (field scroller int (- 1))
    (field g int (- 1))
    (field gDrops int 0))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string ".item { width: 60px; height: 40px; } .slot { width: 60px; height: 40px; } .item:dragging { height: 50px; } .slot:drop-target { width: 70px; } .wrap { width: 200px; } .scroller { height: 30px; overflow: auto; }")
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) d))
    (let w _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) w "wrap"))
    (if (! (. S hide)) (block
      (let a _ (call (. d open) 0 (call (. d tag) "div") 1))
      (= (. S src) a)
      (expr (call (. d cls) a "item"))
      (expr (call (. d attrDraggable) a (bool true)))
      (expr (call (. d attrDragData) a "sword"))
      (expr (call (. d attrDragId) a 7))
      (expr (call (. d text) "Sword"))
      (if (call (. d clicked) a) (block
        (+= (. S clicks) 1)))
      (if (call (. d dragStarted) a) (block
        (+= (. S starts) 1)
        (= (. S startAt) (. d frame))
        (= (. S data) (call (. d dragData)))
        (= (. S dragId) (call (. d dragIdOf)))))
      (if (call (. d dragEnded) a) (block
        (+= (. S ends) 1)
        (= (. S endAt) (. d frame))
        (= (. S dropped) (call (. d dragDropped)))
        (+= (. S seq) 1)
        (= (. S endSeq) (. S seq))))
      (expr (call (. d close)))) (block
      (if (. S showX) (block
        (for k (.. 0 8) (block
          (let x _ (call (. d open) (+ 1 k) (call (. d tag) "div") 1))
          (if (== x (. S old)) (block
            (= (. S x) x)))
          (expr (call (. d attrDraggable) x (bool true)))
          (expr (call (. d attrDragTarget) x 15))
          (if (|| (|| (|| (|| (|| (call (. d dragStarted) x) (call (. d dragEnded) x)) (call (. d dragEntered) x)) (call (. d dragLeft) x)) (call (. d dragOver) x)) (call (. d dropAt) x)) (block
            (+= (. S xEvents) 1)))
          (expr (call (. d close)))))))))
    (let b _ (call (. d open) 20 (call (. d tag) "div") 1))
    (= (. S b) b)
    (expr (call (. d cls) b "slot"))
    (expr (call (. d attrDragTarget) b 1))
    (expr (call (. d attrDragTarget) b 2))
    (expr (call (. d attrDragTarget) b 4))
    (expr (call (. d attrDragTarget) b 8))
    (expr (call (. d text) "B"))
    (if (call (. d dragEntered) b) (block
      (+= (. S enters) 1)
      (= (. S enterAt) (. d frame))))
    (if (call (. d dragOver) b) (block
      (+= (. S overs) 1)
      (= (. S overAt) (. d frame))
      (let accept _ (! (. S reject)))
      (if (! accept) (block
        (expr (call (. d dragReject) b))))))
    (if (call (. d dragLeft) b) (block
      (+= (. S leaves) 1)
      (= (. S leaveAt) (. d frame))))
    (if (call (. d dropAt) b) (block
      (+= (. S drops) 1)
      (= (. S dropAt) (. d frame))
      (= (. S data) (call (. d dragData)))
      (+= (. S seq) 1)
      (= (. S dropSeq) (. S seq))))
    (expr (call (. d close)))
    (let c _ (call (. d open) 21 (call (. d tag) "div") 1))
    (expr (call (. d cls) c "slot"))
    (expr (call (. d text) "C"))
    (expr (call (. d close)))
    (let z _ (call (. d open) 22 (call (. d tag) "div") 1))
    (= (. S z) z)
    (expr (call (. d cls) z "item"))
    (expr (call (. d attrDraggable) z (bool true)))
    (expr (call (. d attrDragData) z "z"))
    (expr (call (. d text) "Z"))
    (if (call (. d dragEnded) z) (block
      (+= (. S zEnds) 1)
      (+= (. S seq) 1)
      (= (. S zEndSeq) (. S seq))))
    (expr (call (. d close)))
    (let sc _ (call (. d open) 23 (call (. d tag) "div") 1))
    (= (. S scroller) sc)
    (expr (call (. d cls) sc "scroller"))
    (let r1 _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) r1 "slot"))
    (expr (call (. d text) "R1"))
    (expr (call (. d close)))
    (let g _ (call (. d open) 1 (call (. d tag) "div") 1))
    (= (. S g) g)
    (expr (call (. d cls) g "slot"))
    (expr (call (. d attrDragTarget) g 8))
    (expr (call (. d text) "G"))
    (if (call (. d dropAt) g) (block
      (+= (. S gDrops) 1)))
    (expr (call (. d close)))
    (let r3 _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) r3 "slot"))
    (expr (call (. d text) "R3"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn reset (params) _ (block
    (= S (struct-lit St))))
  (fn (doc "Run `n` frames with the pointer at `(x, y)`, button `down`.") hold (params (d (ref Dom)) (x f32) (y f32) (down bool) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) x y down (float 0x0000000000000000)))
      (expr (call frame d))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call reset))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let src _ (. S src))
    (let bn _ (. S b))
    (let zn _ (. S z))
    (let gn _ (. S g))
    (expr (call (. d scrollBy) (. S scroller) (float 0x4044000000000000)))
    (expr (call frame (& d)))
    (let f0 _ (+ (. d frame) 1))
    (for f (.. 0 5) (block
      (expr (call (. testkit click) (& d) (+ f0 f) f0 src))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. S clicks) 1) (== (. S starts) 0)) (== (. S ends) 0)) "plain click: one click, no drag"))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) 1))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4028000000000000) (float 0x4026000000000000) (bool true) 2))
    (expr (call ok (== (. S starts) 0) "3 px of travel does not start a drag"))
    (expr (call hold (& d) (float 0x4028000000000000) (float 0x4026000000000000) (bool false) 2))
    (expr (call ok (&& (== (. S clicks) 2) (== (. S starts) 0)) "press, small move, release is a click"))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4030000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call ok (&& (&& (== (. S starts) 1) (call same (. S data) "sword")) (== (. S dragId) 7)) "6 px of travel starts the drag; payload read in dragstart"))
    (expr (call ok (== (. (call (. d size) src) y) (float 0x4049000000000000)) ":dragging restyles the source"))
    (expr (call hold (& d) (float 0x4030000000000000) (float 0x4024000000000000) (bool false) 2))
    (expr (call ok (&& (&& (== (. S clicks) 2) (== (. S ends) 1)) (! (. S dropped))) "a drag released over nothing is no click, and ends undropped"))
    (expr (call ok (== (. (call (. d size) src) y) (float 0x4044000000000000)) ":dragging is gone after the drag"))
    (expr (call hold (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) 2))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (expr (call frame (& d)))
      (if (== f 3) (block
        (expr (call ok (&& (== (. S enters) 1) (== (. (call (. d size) bn) x) (float 0x4051800000000000))) ":drop-target on the hovered acceptor"))
        (expr (call ok (== (. (call (. d size) src) y) (float 0x4049000000000000)) ":dragging while it lasts"))))))
    (expr (call ok (&& (&& (&& (&& (== (. S starts) 1) (== (. S enters) 1)) (== (. S leaves) 0)) (== (. S drops) 1)) (== (. S ends) 1)) "start, enter, drop, end once each; no leave on a drop"))
    (expr (call ok (|| (== (. S enterAt) (- (. S overAt) 0)) (< (. S enterAt) (. S overAt))) "enter comes with or before the first over"))
    (expr (call ok (== (. S overs) 2) "over every frame the pointer rests on the target"))
    (expr (call ok (&& (== (. S endAt) (+ (. S dropAt) 1)) (> (. S dropAt) (. S overAt))) "drop lands on the release frame, dragend on the next"))
    (expr (call ok (< (. S dropSeq) (. S endSeq)) "drop before dragend, source before the target in the markup"))
    (expr (call ok (&& (< (. S startAt) (. S enterAt)) (== (. S enterAt) (- (. S overAt) 1))) "start before enter"))
    (expr (call ok (&& (&& (. S dropped) (call same (. S data) "sword")) (== (. S clicks) 0)) "dropped flag, payload in drop, no click"))
    (expr (call ok (&& (== (. (call (. d size) bn) x) (float 0x404e000000000000)) (== (. (call (. d size) src) y) (float 0x4044000000000000))) "pseudo-classes cleared after the drop"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit dragTag) (& d) (+ f0 f) f0 "div" 1 "div" 3))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (&& (&& (== (. S starts) 1) (== (. S drops) 0)) (== (. S enters) 0)) (== (. S ends) 1)) (! (. S dropped))) "drop on a plain element: dragend only"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit dragTo) (& d) (+ f0 f) f0 src (float 0x4072c00000000000) (float 0x4072c00000000000)))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (&& (== (. S starts) 1) (== (. S drops) 0)) (== (. S ends) 1)) (! (. S dropped))) "drop outside: dragend only"))
    (expr (call reset))
    (expr (call hold (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) 1))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4030000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x404e000000000000) (bool true) 2))
    (expr (call ok (&& (== (. S enters) 1) (== (. S leaves) 0)) "over B"))
    (expr (call hold (& d) (float 0x4072c00000000000) (float 0x4072c00000000000) (bool true) 1))
    (expr (call ok (&& (&& (== (. S leaves) 1) (== (. S leaveAt) (. d frame))) (== (. (call (. d size) bn) x) (float 0x404e000000000000))) "leaving B: dragleave and :drop-target gone"))
    (expr (call hold (& d) (float 0x4072c00000000000) (float 0x4072c00000000000) (bool false) 2))
    (expr (call ok (&& (&& (== (. S drops) 0) (== (. S ends) 1)) (! (. S dropped))) "released away from B: no drop"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (expr (call (. testkit simKeys) (& d) (+ f0 f) (+ f0 4) "" "Escape"))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (&& (== (. S starts) 1) (== (. S drops) 0)) (== (. S ends) 1)) (! (. S dropped))) "Escape: dragend, no drop"))
    (expr (call ok (&& (== (. S leaves) 1) (== (. S endAt) (+ (. S leaveAt) 1))) "Escape leaves the target, dragend follows next frame"))
    (expr (call ok (&& (== (. (call (. d size) src) y) (float 0x4044000000000000)) (== (. (call (. d size) bn) x) (float 0x404e000000000000))) "Escape clears the pseudo-classes"))
    (expr (call ok (== (. S clicks) 0) "no click after an Escape cancel"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (expr (call frame (& d)))))
    (expr (call ok (== (. S drops) 1) "a drag after a cancelled one drops"))
    (expr (call reset))
    (= (. S reject) (bool true))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (expr (call frame (& d)))
      (if (== f 4) (block
        (expr (call ok (&& (>= (. S overs) 1) (== (. (call (. d size) bn) x) (float 0x404e000000000000))) "a rejected target is not :drop-target"))))))
    (expr (call ok (&& (&& (== (. S drops) 0) (== (. S ends) 1)) (! (. S dropped))) "a rejected drop is only a dragend"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 zn bn))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. S drops) 1) (== (. S zEnds) 1)) (call same (. S data) "z")) "drag from the second source drops on B"))
    (expr (call ok (< (. S dropSeq) (. S zEndSeq)) "drop before dragend, source after the target in the markup"))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src gn))
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (. S gDrops) 1) (== (. S ends) 1)) "drop on a target inside a scrolled overflow box"))
    (expr (call (. d scrollBy) (. S scroller) (- (float 0x4044000000000000))))
    (expr (call frame (& d)))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit dragTo) (& d) (+ f0 f) f0 src (+ (call (. d absX) gn) (float 0x4008000000000000)) (+ (call (. d absY) gn) (float 0x4008000000000000))))
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. S gDrops) 0) (== (. S ends) 1)) (! (. S dropped))) "a target clipped away by the scroll box takes no drop"))
    (expr (call (. d scrollBy) (. S scroller) (float 0x4044000000000000)))
    (expr (call frame (& d)))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (if (== f 3) (block
        (= (. S hide) (bool true))
        (= (. S old) src)))
      (if (== f 4) (block
        (= (. S showX) (bool true))))
      (expr (call frame (& d)))
      (if (== f 4) (block
        (expr (call ok (== (. S x) src) "a new node took the removed source's id"))))
      (if (== f 3) (block
        (expr (call ok (== (. (. d drag) state) 0) "removing the source ends the drag"))))))
    (expr (call ok (&& (&& (&& (== (. S starts) 1) (== (. S drops) 0)) (== (. S ends) 0)) (== (. S xEvents) 0)) "no drop, no dragend and nothing on the node that reused the id"))
    (expr (call ok (== (. (call (. d size) bn) x) (float 0x404e000000000000)) "the target's :drop-target is cleared when the source goes"))
    (= (. S hide) (bool false))
    (= (. S showX) (bool false))
    (expr (call hold (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) 3))
    (= src (. S src))
    (expr (call reset))
    (= f0 (+ (. d frame) 1))
    (for f (.. 0 9) (block
      (expr (call (. testkit drag) (& d) (+ f0 f) f0 src bn))
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (. S drops) 1) (== (. S ends) 1)) "drag works again after the source came back"))
    (expr (call ok (== (. (index (. (. d nodes) items) src) kind) (. dom K_ELEM)) "source is a live element"))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool false) 1))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4044000000000000) (float 0x4024000000000000) (bool true) 2))
    (expr (call ok (== (. (. d drag) state) 2) "dragging"))
    (let nx _ (. (index (. (. d nodes) items) src) x))
    (let ny _ (. (index (. (. d nodes) items) src) y))
    (let lw _ (. d laid))
    (expr (call (. drag paint) (& d)))
    (expr (call ok (&& (&& (== (. (index (. (. d nodes) items) src) x) nx) (== (. (index (. (. d nodes) items) src) y) ny)) (== (. d laid) lw)) "the ghost does not move or dirty the source"))
    (expr (call hold (& d) (float 0x4044000000000000) (float 0x4024000000000000) (bool false) 2))
    (expr (call reset))
    (expr (call hold (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) 3))
    (let used _ (. (. d mem) used))
    (let laid _ (. d laid))
    (let styled _ (. d restyled))
    (expr (call hold (& d) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) 10))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (== (. d restyled) styled)) "idle frames do not allocate, lay out or restyle"))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4030000000000000) (float 0x4024000000000000) (bool true) 1))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x404e000000000000) (bool true) 2))
    (= used (. (. d mem) used))
    (= laid (. d laid))
    (= styled (. d restyled))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x404e000000000000) (bool true) 10))
    (expr (call ok (&& (&& (== (. (. d mem) used) used) (== (. d laid) laid)) (== (. d restyled) styled)) "a drag resting on a target does not allocate, lay out or restyle"))
    (expr (call hold (& d) (float 0x4024000000000000) (float 0x404e000000000000) (bool false) 2))
    (expr (call printLn (interp "all passed (" CHECKS " checks)"))))))
--- stderr
--- exit 0
