(file (module selector_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff (float 0x3f847ae147ae147b)) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b)))
      (expr (call panic msg))))))
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } .list { width: 300px; } .it { height: 20px; } .it + .it { margin-top: 10px; } .it.on ~ .it { width: 77px; } .it:hover + .it { height: 40px; } .it.on + .it + .it { padding-left: 5px; } #hero { width: 123px; } .it.k { width: 10px; } .card { position: relative; width: 200px; } .card::before { content: \"AB\"; display: block; width: 30px; height: 12px; } .card::after { content: \"x\"; display: block; position: absolute; right: 0; top: 0; width: 8px; height: 8px; } .card.plain::before { content: none; } .card.alt::before { content: \"CD\"; } .card > .kid { height: 10px; } .card > .kid:first-child { width: 11px; } .gone::after { content: \"!\"; } .kl::before { content: \"b\"; display: block; height: 4px; } .kl::after { content: \"a\"; display: block; height: 4px; }")
  (fn main (params) _ (block
    (let mem0 _ (call (. Arena create) (* (* 16 1024) 1024)))
    (expr (call testScoped (& mem0)))
    (expr (call testReload (& mem0)))
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "selector.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (expr (call ok (== (. css sibMode) 2) "the sheet needs the all-following sibling mode"))
    (expr (call testSiblings (& mem) (& css)))
    (expr (call testPseudo (& mem) (& css)))
    (expr (call testRows (& mem) (& css)))
    (expr (call testGhost (& mem) (& css)))
    (expr (call testRowsAfter (& mem) (& css)))
    (expr (call testStruct (& mem)))
    (expr (call testNested (& mem)))
    (expr (call testMass (& mem)))
    (expr (call printLn (interp "selector_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
