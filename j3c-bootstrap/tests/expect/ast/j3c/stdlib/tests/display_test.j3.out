(file (module display_test)
  (use j3.game)
  (use j3.game.display)
  (use j3.game.WindowMode)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names Text same))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "display_test"))))))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) (* 1024 1024)))
    (let mem _ (& arena))
    (expr (call ok (call same (call (. display modeName) (call (. display nextMode) (. WindowMode Windowed))) "Borderless") "windowed -> borderless"))
    (expr (call ok (call same (call (. display modeName) (call (. display nextMode) (. WindowMode Borderless))) "Fullscreen") "borderless -> fullscreen"))
    (expr (call ok (call same (call (. display modeName) (call (. display nextMode) (. WindowMode Fullscreen))) "Windowed") "fullscreen wraps"))
    (expr (call ok (== (call (. display stepFps) 0 1) 30) "off -> 30"))
    (expr (call ok (== (call (. display stepFps) 60 1) 120) "60 -> 120"))
    (expr (call ok (== (call (. display stepFps) 240 1) 240) "stops at 240"))
    (expr (call ok (== (call (. display stepFps) 30 (- 1)) 0) "30 -> off"))
    (expr (call ok (== (call (. display stepFps) 0 (- 1)) 0) "stops at off"))
    (expr (call ok (== (call (. display stepFps) 100 1) 120) "off-list steps up to the next"))
    (expr (call ok (== (call (. display stepFps) 100 (- 1)) 60) "off-list steps down to the previous"))
    (expr (call ok (== (call (. display wrapIndex) 0 (- 1) 4) 3) "wrap down"))
    (expr (call ok (== (call (. display wrapIndex) 3 1 4) 0) "wrap up"))
    (expr (call ok (== (call (. display wrapIndex) 2 1 0) 0) "empty list"))
    (let s _ (call (. display current)))
    (= (. s mode) (. WindowMode Fullscreen))
    (= (. s w) 1920)
    (= (. s h) 1080)
    (= (. s vsync) (bool true))
    (= (. s fpsLimit) 144)
    (expr (call (. display store) (& s) "/tmp/j3_display_test.cfg" mem))
    (let back _ (call (. display load) "/tmp/j3_display_test.cfg" mem))
    (expr (call ok (call same (call (. display modeName) (. back mode)) "Fullscreen") "mode round trip"))
    (expr (call ok (&& (== (. back w) 1920) (== (. back h) 1080)) "size round trip"))
    (expr (call ok (. back vsync) "vsync round trip"))
    (expr (call ok (== (. back fpsLimit) 144) "fps round trip"))
    (expr (call (. display apply) (& back)))
    (expr (call ok (&& (call (. game vsync)) (== (call (. game fpsLimit)) 144)) "apply records vsync and cap"))
    (let t _ (call (. Text new) mem))
    (expr (call ok (call same (call (. display resolutionLabel) (& back) (& t)) "1920 x 1080") "resolution label"))
    (expr (call ok (call same (call (. display fpsLabel) 0 (& t)) "Unlimited") "fps label off"))
    (expr (call ok (call same (call (. display fpsLabel) 60 (& t)) "60") "fps label"))
    (expr (call printLn "display_test ok")))))
--- stderr
--- exit 0
