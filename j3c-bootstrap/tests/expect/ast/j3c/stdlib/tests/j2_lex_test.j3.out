(file (module j2_lex_test)
  (use j3.io (names exists printLn readFile))
  (use j3.j2.lex)
  (use j3.j2.lex (names Token Tok))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call panic msg))))))
  (fn toks (params (src string) (mem (ref Arena))) (slice Token) (block
    (match (call (. lex lex) "t.j2" src mem)
      (arm (pats (variant Result.Ok (bind ts))) (block
        (return ts)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e text)))
        (expr (call panic "unexpected lex error")))))
    (return (call (. mem alloc) (targs Token) 0))))
  (fn lexErr (params (src string) (want string) (mem (ref Arena))) _ (block
    (match (call (. lex lex) "t.j2" src mem)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call printLn (interp "no error for: " src)))
        (expr (call panic "expected a lex error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (if (! (== (. e text) want)) (block
          (expr (call printLn (interp "got  [" (. e text) "]")))
          (expr (call printLn (interp "want [" want "]")))
          (expr (call panic "lex error text")))))))))
  (fn (doc "Kinds of `src`'s tokens, without the final EOF, as a comma list.") kinds (params (src string) (mem (ref Arena))) string (block
    (let ts _ (call toks src mem))
    (let t _ (call (. Text new) mem))
    (for i (.. 0 (- (. ts len) 1)) (block
      (if (> i 0) (block
        (expr (call (. t push) 44))))
      (expr (call (. t pushInt) (call int (. (index ts i) kind))))))
    (return (call (. t str)))))
  (fn testKinds (params (mem (ref Arena))) _ (block
    (let src _ "( ) { } [ ] , ; : . .. = == ! != < <= > >= + - * / % && || += -= *= /= %=")
    (let ts _ (call toks src mem))
    (let want (array 31 Tok) (array-lit (. Tok LParen) (. Tok RParen) (. Tok LBrace) (. Tok RBrace) (. Tok LBrack) (. Tok RBrack) (. Tok Comma) (. Tok Semi) (. Tok Colon) (. Tok Dot) (. Tok DotDot) (. Tok Assign) (. Tok Eq) (. Tok Not) (. Tok Ne) (. Tok Lt) (. Tok Le) (. Tok Gt) (. Tok Ge) (. Tok Plus) (. Tok Minus) (. Tok Star) (. Tok Slash) (. Tok Percent) (. Tok And) (. Tok Or) (. Tok PlusEq) (. Tok MinusEq) (. Tok StarEq) (. Tok SlashEq) (. Tok PercentEq)))
    (expr (call ok (== (. ts len) (+ (. want len) 1)) "punct count"))
    (for i (.. 0 (. want len)) (block
      (expr (call ok (== (. (index ts i) kind) (index want i)) "punct kind"))))
    (expr (call ok (== (. (index ts (. want len)) kind) (. Tok Eof)) "ends with EOF"))
    (let kw _ (call toks "let const fn return if else while for in break continue match pub use nil true false this _ x1" mem))
    (let kws (array 17 Tok) (array-lit (. Tok Let) (. Tok Const) (. Tok Fn) (. Tok Return) (. Tok If) (. Tok Else) (. Tok While) (. Tok For) (. Tok In) (. Tok Break) (. Tok Continue) (. Tok Match) (. Tok Pub) (. Tok Use) (. Tok Nil) (. Tok True) (. Tok False)))
    (for i (.. 0 17) (block
      (expr (call ok (== (. (index kw i) kind) (index kws i)) "keyword kind"))))
    (expr (call ok (&& (&& (== (. (index kw 17) kind) (. Tok Name)) (== (. (index kw 18) kind) (. Tok Name))) (== (. (index kw 19) kind) (. Tok Name))) "names"))
    (let nums _ (call toks "42 0xff 1_000 2.5 1e9 3.0e-2 0..3 7.x" mem))
    (expr (call ok (&& (== (. (index nums 0) kind) (. Tok Int)) (== (. (index nums 0) i) 42)) "int"))
    (expr (call ok (&& (== (. (index nums 1) kind) (. Tok Int)) (== (. (index nums 1) i) 255)) "hex"))
    (expr (call ok (&& (== (. (index nums 2) kind) (. Tok Int)) (== (. (index nums 2) i) 1000)) "underscores"))
    (expr (call ok (&& (== (. (index nums 3) kind) (. Tok Float)) (== (. (index nums 3) f) (float 0x4004000000000000))) "float"))
    (expr (call ok (&& (== (. (index nums 4) kind) (. Tok Float)) (== (. (index nums 4) f) (float 0x41cdcd6500000000))) "exponent"))
    (expr (call ok (&& (== (. (index nums 5) kind) (. Tok Float)) (== (. (index nums 5) f) (float 0x3f9eb851eb851eb8))) "negative exponent"))
    (expr (call ok (&& (&& (== (. (index nums 6) kind) (. Tok Int)) (== (. (index nums 7) kind) (. Tok DotDot))) (== (. (index nums 8) kind) (. Tok Int))) "range is int .. int"))
    (expr (call ok (&& (&& (== (. (index nums 9) kind) (. Tok Int)) (== (. (index nums 10) kind) (. Tok Dot))) (== (. (index nums 11) kind) (. Tok Name))) "7.x"))
    (let big _ (call toks "9223372036854775807" mem))
    (expr (call ok (== (. (index big 0) i) 9223372036854775807) "max int"))
    (let strs _ (call toks "\"a\\n\\\"b\" `plain` // comment\n" mem))
    (expr (call ok (&& (== (. (index strs 0) kind) (. Tok Str)) (== (call (. lex decode) "\"a\\n\\\"b\"" (. (index strs 0) s) (. (index strs 0) e) mem) "a\n\"b")) "escapes"))
    (expr (call ok (== (. (index strs 1) kind) (. Tok Str)) "backtick without holes is a string"))
    (let ansi _ "\"\\e[31mR\\x1b[0m \\u{e9}\\u{20ac}\\u{1F600}\"")
    (let at _ (call toks ansi mem))
    (let d _ (call (. lex decode) ansi (. (index at 0) s) (. (index at 0) e) mem))
    (let bytes (array 20 u8) (array-lit 27 91 51 49 109 82 27 91 48 109 32 195 169 226 130 172 240 159 152 128))
    (let same _ (&& (== (. (index at 0) kind) (. Tok Str)) (== (. d len) 20)))
    (for i (.. 0 20) (block
      (if (&& same (!= (index d i) (index bytes i))) (block
        (= same (bool false))))))
    (expr (call ok same "hex, esc, unicode escapes"))
    (expr (call ok (== (. (index strs 2) kind) (. Tok Eof)) "comment skipped"))))
  (fn testTemplates (params (mem (ref Arena))) _ (block
    (let src _ "`x {a.b(c)} y {f({k: `{n}`})} z`")
    (let k _ (call kinds src mem))
    (let t _ (call (. Text new) mem))
    (let parts (array 19 Tok) (array-lit (. Tok TplHead) (. Tok Name) (. Tok Dot) (. Tok Name) (. Tok LParen) (. Tok Name) (. Tok RParen) (. Tok TplMid) (. Tok Name) (. Tok LParen) (. Tok LBrace) (. Tok Name) (. Tok Colon) (. Tok TplHead) (. Tok Name) (. Tok TplTail) (. Tok RBrace) (. Tok RParen) (. Tok TplTail)))
    (for i (.. 0 19) (block
      (if (> i 0) (block
        (expr (call (. t push) 44))))
      (expr (call (. t pushInt) (call int (index parts i))))))
    (if (! (== k (call (. t str)))) (block
      (expr (call printLn (interp "got  " k)))
      (expr (call printLn (interp "want " (call (. t str)))))
      (expr (call panic "template tokens"))))
    (let ts _ (call toks src mem))
    (expr (call ok (== (call (. lex decode) src (. (index ts 0) s) (. (index ts 0) e) mem) "x ") "head text"))
    (expr (call ok (== (call (. lex decode) src (. (index ts 7) s) (. (index ts 7) e) mem) " y ") "mid text"))
    (expr (call ok (== (call (. lex decode) src (. (index ts 18) s) (. (index ts 18) e) mem) " z") "tail text"))
    (let esc _ (call toks "`a \\{b} c`" mem))
    (expr (call ok (&& (== (. (index esc 0) kind) (. Tok Str)) (== (. (index esc 1) kind) (. Tok Eof))) "escaped brace"))))
  (fn testPositions (params (mem (ref Arena))) _ (block
    (let src _ "let s = `one\ntwo {x}\nthree`;\n  next")
    (let ts _ (call toks src mem))
    (expr (call ok (&& (&& (== (. (index ts 3) kind) (. Tok TplHead)) (== (. (index ts 3) line) 1)) (== (. (index ts 3) col) 9)) "template start"))
    (expr (call ok (&& (&& (== (. (index ts 4) kind) (. Tok Name)) (== (. (index ts 4) line) 2)) (== (. (index ts 4) col) 6)) "hole name position"))
    (expr (call ok (&& (&& (== (. (index ts 5) kind) (. Tok TplTail)) (== (. (index ts 5) line) 2)) (== (. (index ts 5) col) 7)) "tail position"))
    (expr (call ok (&& (&& (== (. (index ts 6) kind) (. Tok Semi)) (== (. (index ts 6) line) 3)) (== (. (index ts 6) col) 7)) "after multiline string"))
    (expr (call ok (&& (&& (== (. (index ts 7) kind) (. Tok Name)) (== (. (index ts 7) line) 4)) (== (. (index ts 7) col) 3)) "next line"))))
  (fn testErrors (params (mem (ref Arena))) _ (block
    (expr (call lexErr "let s = \"abc" "t.j2:1:9: unterminated string" mem))
    (expr (call lexErr "let s = \"ab\nc\";" "t.j2:1:9: unterminated string" mem))
    (expr (call lexErr "x\n  `abc\n\n" "t.j2:2:3: unterminated string" mem))
    (expr (call lexErr "`a {b" "t.j2:1:1: unterminated string" mem))
    (expr (call lexErr "`a {`b {c}" "t.j2:1:5: unterminated string" mem))
    (expr (call lexErr "let a = 1 # 2;" "t.j2:1:11: unexpected character `#`" mem))
    (expr (call lexErr "a & b" "t.j2:1:3: unexpected character `&`" mem))
    (expr (call lexErr "\"bad \\q\"" "t.j2:1:6: unknown escape `\\q`" mem))
    (expr (call lexErr "\"bad \\x4\"" "t.j2:1:6: unknown escape `\\x`" mem))
    (expr (call lexErr "\"bad \\u{110000}\"" "t.j2:1:6: unknown escape `\\u`" mem))
    (expr (call lexErr "99999999999999999999" "t.j2:1:1: number too big" mem))
    (expr (call lexErr "1e999" "t.j2:1:1: number too big" mem))
    (expr (call lexErr "0x" "t.j2:1:1: expected hex digits after `0x`" mem))
    (expr (call lexErr "1e+" "t.j2:1:2: expected digits after the exponent" mem))
    (let soup _ (call (. mem alloc) (targs u8) 4096))
    (let seed _ 12345)
    (for i (.. 0 (. soup len)) (block
      (= seed (+ (* seed 6364136223846793005) 1442695040888963407))
      (= (index soup i) (call u8 (& (>> seed 33) 127)))))
    (for n (.. 0 64) (block
      (match (call (. lex lex) "soup" (as (slice-expr soup 0 (* n 64)) string) mem)
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (wild))) (block)))))))
  (fn scriptDir (params) string (block
    (if (call exists "examples/j2_script/j2-scripts/hello/main.j2") (block
      (return "examples/j2_script/j2-scripts/")))
    (return "../examples/j2_script/j2-scripts/")))
  (fn testScripts (params (mem (ref Arena))) _ (block
    (let names (array 4 string) (array-lit "base" "hello" "slimes" "turrets"))
    (for i (.. 0 (. names len)) (block
      (let path _ (call (. Text new) mem))
      (expr (call (. path pushStr) (call scriptDir)))
      (expr (call (. path pushStr) (index names i)))
      (expr (call (. path pushStr) "/main.j2"))
      (match (call readFile (call (. path str)) mem)
        (arm (pats (variant Result.Ok (bind bytes))) (block
          (let ts _ (call toks (as bytes string) mem))
          (expr (call ok (> (. ts len) 20) "script has tokens"))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call printLn (call (. path str))))
          (expr (call panic "cannot read example script")))))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (expr (call testKinds (& mem)))
    (expr (call testTemplates (& mem)))
    (expr (call testPositions (& mem)))
    (expr (call testErrors (& mem)))
    (expr (call testScripts (& mem)))
    (expr (call printLn "j2_lex_test ok")))))
--- stderr
--- exit 0
