(file (module net_test)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.net.dns)
  (use j3.net.http)
  (use j3.net.http (names Header Request Response))
  (use j3.net.tcp)
  (use j3.net.tcp (names Conn Listener TcpError))
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (use j3.thread (names Thread join spawn))
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn has (params (s string) (part string)) bool (block
    (if (> (. part len) (. s len)) (block
      (return (bool false))))
    (for i (.. 0 (+ (- (. s len) (. part len)) 1)) (block
      (if (call eq (slice-expr s i (+ i (. part len))) part) (block
        (return (bool true))))))
    (return (bool false))))
  (struct (doc "Replies the server sends, one per connection, and the requests it saw.") Server
    (field ls Listener)
    (field replies (slice string))
    (field seen (gen List string))
    (field mem (ref Arena)))
  (mod-let thread BUF (array 4096 u8) _)
  (fn scratchBuf (params) (slice u8) (block
    (return (slice-expr BUF _ _))))
  (fn (doc "Read one request (headers plus a `Content-Length` body), or until the client closes.") readRequest (params (c (ref Conn)) (t (ref Text))) _ (block
    (let buf _ (call scratchBuf))
    (let want _ (- 1))
    (while (bool true) (block
      (let n _ (call (. c read) buf))
      (if (<= n 0) (block
        (return)))
      (expr (call (. t pushBytes) (slice-expr buf 0 n)))
      (let s _ (call (. t str)))
      (if (< want 0) (block
        (for i (.. 0 (- (. s len) 3)) (block
          (if (&& (&& (&& (== (index s i) 13) (== (index s (+ i 1)) 10)) (== (index s (+ i 2)) 13)) (== (index s (+ i 3)) 10)) (block
            (= want (+ (+ i 4) (call contentLength (slice-expr s 0 i))))
            (break)))))))
      (if (&& (>= want 0) (>= (. s len) want)) (block
        (return)))))))
  (fn contentLength (params (head string)) int (block
    (let key _ "Content-Length: ")
    (for i (.. 0 (- (. head len) (. key len))) (block
      (if (call eq (slice-expr head i (+ i (. key len))) key) (block
        (let n _ 0)
        (let k _ (+ i (. key len)))
        (while (&& (&& (< k (. head len)) (>= (index head k) 48)) (<= (index head k) 57)) (block
          (= n (- (+ (* n 10) (call int (index head k))) 48))
          (+= k 1)))
        (return n)))))
    (return 0)))
  (fn serve (params (arg ptr)) _ (block
    (let s _ (as arg (ref Server)))
    (for i (.. 0 (. (. s replies) len)) (block
      (match (call (. (. s ls) accept))
        (arm (pats (variant Result.Ok (bind c))) (block
          (let t _ (call (. Text new) (. s mem)))
          (expr (call readRequest (& c) (& t)))
          (expr (call (. (. s seen) push) (call (. t str))))
          (let r _ (index (. s replies) i))
          (if (== (. r len) 0) (block
            (expr (call (. c setTimeout) 5000))
            (let one (array 1 u8) (array-lit 0))
            (expr (call (. c read) (slice-expr one _ _)))) (block
            (expr (call (. c writeAll) (as r (slice u8))))))
          (expr (call (. c close)))))
        (arm (pats (variant Result.Err (wild))) (block
          (return))))))))
  (fn url (params (port int) (path string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. t pushStr) "http://127.0.0.1:"))
    (expr (call (. t pushInt) port))
    (expr (call (. t pushStr) path))
    (return (call (. t str)))))
  (fn fetch (params (req (ref Request)) (a (ref Arena))) Response (block
    (match (call (. http request) req a)
      (arm (pats (variant Result.Ok (bind r))) (block
        (return r)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call panic (interp "request failed: " (call (. http errorName) e)))))))
    (return (struct-lit Response (field status 0) (field headers (call (. (type-path List Header) new) a)) (field body (as "" (slice u8)))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 4194304))
    (match (call (. http parseUrl) "https://Example.com:8443/a/b?q=1#frag")
      (arm (pats (variant Result.Ok (bind u))) (block
        (expr (call ok (&& (&& (&& (. u https) (call eq (. u host) "Example.com")) (== (. u port) 8443)) (call eq (. u path) "/a/b?q=1")) "parseUrl full"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "parseUrl full")))))
    (match (call (. http parseUrl) "http://[::1]/")
      (arm (pats (variant Result.Ok (bind u))) (block
        (expr (call ok (&& (&& (! (. u https)) (call eq (. u host) "::1")) (== (. u port) 80)) "parseUrl v6"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "parseUrl v6")))))
    (match (call (. http parseUrl) "https://h.io")
      (arm (pats (variant Result.Ok (bind u))) (block
        (expr (call ok (&& (call eq (. u path) "/") (== (. u port) 443)) "parseUrl bare host"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "parseUrl bare host")))))
    (let badUrls (array 5 string) (array-lit "ftp://x" "http://" "http://h:0/" "http://h:99999/" "http://[::1"))
    (for-each _ b badUrls (block
      (match (call (. http parseUrl) b)
        (arm (pats (variant Result.Ok (wild))) (block
          (expr (call ok (bool false) (interp "accepted " b)))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call ok (bool true) b)))))))
    (match (call (. dns resolve) "localhost" 80 (& a))
      (arm (pats (variant Result.Ok (bind eps))) (block
        (expr (call ok (>= (. eps len) 1) "localhost resolves"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "localhost resolves")))))
    (match (call (. dns resolve) "no-such-host.invalid" 80 (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) ".invalid resolved"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool true) ".invalid fails")))))
    (let probe _ (struct-lit Listener))
    (match (call (. tcp listen) 0)
      (arm (pats (variant Result.Ok (bind l))) (block
        (= probe l)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "listen")))))
    (let freePort _ (. probe port))
    (expr (call (. probe close)))
    (match (call (. tcp dial) "127.0.0.1" freePort 2000 (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "dial a closed port"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant TcpError.Refused)) (block
          (expr (call ok (bool true) "refused"))))
        (arm (pats (variant TcpError.Resolve)) (block
          (expr (call ok (bool false) "refused: Resolve"))))
        (arm (pats (variant TcpError.Timeout)) (block
          (expr (call ok (bool false) "refused: Timeout"))))
        (arm (pats (variant TcpError.Fail)) (block
          (expr (call ok (bool false) "refused: Fail"))))))))
    (let bad (array 5 string) (array-lit "not-an-ip" "1.2.3" "1.2.3.256" "1..2.3" "1.2.3.4.5"))
    (for i (.. 0 5) (block
      (match (call (. tcp listenOn) (index bad i) 0)
        (arm (pats (variant Result.Ok (bind l))) (block
          (expr (call (. l close)))
          (expr (call ok (bool false) (interp "listenOn accepted " (index bad i))))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call ok (bool true) (index bad i))))))))
    (match (call (. tcp listenOn) "0.0.0.0" 0)
      (arm (pats (variant Result.Ok (bind l))) (block
        (match (call (. tcp dial) "127.0.0.1" (. l port) 2000 (& a))
          (arm (pats (variant Result.Ok (bind c))) (block
            (expr (call (. c close)))
            (expr (call ok (bool true) "listenOn 0.0.0.0 reachable on loopback"))))
          (arm (pats (variant Result.Err (wild))) (block
            (expr (call ok (bool false) "listenOn 0.0.0.0 reachable on loopback")))))
        (match (call (. tcp listenOn) "0.0.0.0" (. l port))
          (arm (pats (variant Result.Ok (bind l2))) (block
            (expr (call (. l2 close)))
            (expr (call ok (bool false) "port in use"))))
          (arm (pats (variant Result.Err (wild))) (block
            (expr (call ok (bool true) "port in use is Err")))))
        (expr (call (. l close)))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) "listenOn 0.0.0.0")))))
    (let replies (array 8 string) (array-lit "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nX-Thing:  spaced  \r\n\r\nhello" "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5;ext=1\r\nhello\r\n6\r\n world\r\n0\r\nTrailer: x\r\n\r\n" "HTTP/1.1 302 Found\r\nLocation: /next\r\nContent-Length: 0\r\n\r\n" "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok" "HTTP/1.0 200 OK\r\n\r\nuntil close" "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 201 Created\r\nTransfer-Encoding: chunked\r\n\r\n8\r\ndata: a\n\r\nA\r\n\ndata: b\r\n\r\n0\r\n\r\n" "" "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nshort"))
    (let srvMem _ (call (. Arena create) 1048576))
    (let srv _ (struct-lit Server (field ls (struct-lit Listener)) (field replies (slice-expr replies _ _)) (field seen (call (. (type-path List string) new) (& srvMem))) (field mem (& srvMem))))
    (match (call (. tcp listen) 0)
      (arm (pats (variant Result.Ok (bind l))) (block
        (= (. srv ls) l)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "listen")))))
    (let port _ (. (. srv ls) port))
    (let th _ (struct-lit Thread (field f serve)))
    (expr (call spawn (& th) "server" serve (as (& srv) ptr)))
    (let r1 _ (call (. http post) (call url port "/one?x=1" (& a)) "{\"a\":1}" (& a)))
    (expr (call (. r1 header) "Content-Type" "application/json"))
    (expr (call (. r1 header) "Authorization" "Bearer secret"))
    (let res1 _ (call fetch (& r1) (& a)))
    (expr (call ok (&& (== (. res1 status) 200) (call eq (call (. res1 bodyStr)) "hello")) "content-length body"))
    (expr (call ok (call eq (call (. res1 header) "x-thing") "spaced") "header lookup ignores case and trims"))
    (let r2 _ (call (. http get) (call url port "/two" (& a)) (& a)))
    (let res2 _ (call fetch (& r2) (& a)))
    (expr (call ok (call eq (call (. res2 bodyStr)) "hello world") "chunked body"))
    (let r3 _ (call (. http get) (call url port "/three" (& a)) (& a)))
    (expr (call (. r3 header) "Authorization" "Bearer keep"))
    (let res3 _ (call fetch (& r3) (& a)))
    (expr (call ok (&& (== (. res3 status) 200) (call eq (call (. res3 bodyStr)) "ok")) "redirect followed"))
    (let r5 _ (call (. http get) (call url port "/five" (& a)) (& a)))
    (expr (call ok (call eq (call (. (call fetch (& r5) (& a)) bodyStr)) "until close") "close-delimited body"))
    (let r6 _ (call (. http get) (call url port "/six" (& a)) (& a)))
    (match (call (. http open) (& r6) (& a))
      (arm (pats (variant Result.Ok (bind s))) (block
        (expr (call ok (== (. s status) 201) "1xx skipped"))
        (let line _ (call (. Text new) (& a)))
        (let lines _ (call (. (type-path List string) new) (& a)))
        (while (call (. s readLine) (& line)) (block
          (let keep _ (call (. Text new) (& a)))
          (expr (call (. keep pushStr) (call (. line str))))
          (expr (call (. lines push) (call (. keep str))))))
        (expr (call (. s close)))
        (expr (call ok (== (. lines len) 3) "three lines"))
        (expr (call ok (&& (&& (call eq (index (. lines items) 0) "data: a") (call eq (index (. lines items) 1) "")) (call eq (index (. lines items) 2) "data: b")) "SSE lines"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (bool false) (interp "open: " (call (. http errorName) e)))))))
    (let r7 _ (call (. http get) (call url port "/seven" (& a)) (& a)))
    (= (. r7 timeoutMs) 300)
    (match (call (. http request) (& r7) (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "silent server answered"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (call eq (call (. http errorName) e) "timeout") (interp "timeout: got " (call (. http errorName) e)))))))
    (let r8 _ (call (. http get) (call url port "/eight" (& a)) (& a)))
    (match (call (. http request) (& r8) (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "short body accepted"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool true) "short body")))))
    (expr (call join (& th)))
    (expr (call (. (. srv ls) close)))
    (let seen _ (. srv seen))
    (expr (call ok (== (. seen len) 8) "server saw eight requests"))
    (let q1 _ (index (. seen items) 0))
    (expr (call ok (call has q1 "POST /one?x=1 HTTP/1.1\r\n") "request line"))
    (expr (call ok (call has q1 "Host: 127.0.0.1:") "host with port"))
    (expr (call ok (call has q1 "Content-Length: 7\r\n") "content length"))
    (expr (call ok (call has q1 "Authorization: Bearer secret\r\n") "custom header"))
    (expr (call ok (call has q1 "Connection: close\r\n") "connection close"))
    (expr (call ok (call has q1 "\r\n\r\n{\"a\":1}") "body sent"))
    (expr (call ok (call has (index (. seen items) 3) "GET /next HTTP/1.1") "redirect path"))
    (expr (call ok (call has (index (. seen items) 3) "Authorization: Bearer keep") "same-host redirect keeps auth"))
    (let inj _ (call (. http get) (call url port "/x" (& a)) (& a)))
    (expr (call (. inj header) "X-Evil" "a\r\nInjected: 1"))
    (match (call (. http request) (& inj) (& a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "header injection sent"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (call eq (call (. http errorName) e) "bad request") "header injection refused")))))
    (expr (call printLn (interp "net_test: " CHECKS " checks ok"))))))
--- stderr
--- exit 0
