(file (module term_setfont_test)
  (use j3.game)
  (use j3.game.Color)
  (use j3.io.printLn)
  (use j3.io.readFile)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.term.ansi)
  (use j3.term.ansi.Parser)
  (use j3.term.grid.Grid)
  (use j3.term.view.View)
  (use j3.text (names same Text))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn shot (params (v (ref View)) (g (ref Grid)) (path string) (a (ref Arena))) string (block
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. v draw) g (float 0x0000000000000000) (float 0x0000000000000000)))
    (expr (call (. game p2Flush)))
    (expr (call ok (call (. game captureFrame) path) "capture"))
    (match (call readFile path a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (return (as b string))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "read capture")))))
    (return "")))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 16 1024) 1024)))
    (expr (call (. game initGlHidden) "setFont" 400 200))
    (let path _ (call (. Text new) (& a)))
    (expr (call (. path pushStr) "examples/terminal/"))
    (expr (call (. path pushStr) "assets/mono.ttf"))
    (let small _ (call (. game loadFont) (call (. path str)) 12))
    (let big _ (call (. game loadFont) (call (. path str)) 22))
    (let g _ (call (. Grid new) (& a) 30 6 0))
    (let p _ (call (. Parser new) (& a)))
    (let t _ (call (. Text new) (& a)))
    (for-each _ ch "hello @[31mred@[0m world -> != ~~\r\n@[1mbold@[0m @[3mital@[0m" (block
      (if (== ch 64) (block
        (expr (call (. t push) 27))) (block
        (if (== ch 126) (block
          (expr (call (. t pushStr) "\xe2\x94\x80"))) (block
          (expr (call (. t push) ch))))))))
    (expr (call (. ansi feed) (& p) (call (. t str)) (& g)))
    (let fresh _ (call (. View new) (& a) big))
    (let v _ (call (. View new) (& a) small))
    (= (. v cursorColor) 65280)
    (= (index (. v pal) 1) 1193046)
    (= (. v defaultBg) 1052688)
    (for i (.. 0 4) (block
      (expr (call (. v setFont) (if-expr (== (% i 2) 0) big small)))
      (expr (call (. v draw) (& g) (float 0x0000000000000000) (float 0x0000000000000000)))))
    (let used _ (. a used))
    (for i (.. 0 1000) (block
      (expr (call (. v setFont) (if-expr (== (% i 2) 0) big small)))
      (expr (call (. v draw) (& g) (float 0x0000000000000000) (float 0x0000000000000000)))))
    (expr (call (. game p2Flush)))
    (expr (call ok (== (. a used) used) (interp "arena grew across setFont (" used " -> " (. a used) ")")))
    (expr (call (. v setFont) big))
    (expr (call ok (&& (&& (&& (== (. v cellW) (. fresh cellW)) (== (. v cellH) (. fresh cellH))) (== (. v fontH) (. fresh fontH))) (== (. v textDy) (. fresh textDy))) "metrics match View.new"))
    (expr (call ok (&& (== (call (. v colsFor) (float 0x4074d00000000000)) (call (. fresh colsFor) (float 0x4074d00000000000))) (== (call (. v rowsFor) (float 0x4066200000000000)) (call (. fresh rowsFor) (float 0x4066200000000000)))) "colsFor/rowsFor match"))
    (expr (call ok (&& (&& (== (. v cursorColor) 65280) (== (index (. v pal) 1) 1193046)) (== (. v defaultBg) 1052688)) "palette and cursor kept"))
    (= (. fresh cursorColor) 65280)
    (= (index (. fresh pal) 1) 1193046)
    (= (. fresh defaultBg) 1052688)
    (let pa _ (call shot (& fresh) (& g) "/tmp/j3-setfont-a.png" (& a)))
    (let pb _ (call shot (& v) (& g) "/tmp/j3-setfont-b.png" (& a)))
    (expr (call ok (call same pa pb) "frame after setFont matches a fresh View"))
    (expr (call printLn "term_setfont_test ok")))))
--- stderr
--- exit 0
