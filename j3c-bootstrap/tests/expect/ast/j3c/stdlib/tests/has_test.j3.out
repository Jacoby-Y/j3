(file (module has_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css (names Css FL_HOVER))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, label, input, img { font-family: \"T\"; font-size: 14px; display: block; } .row { height: 20px; width: 10px; } .row:has(input:checked) { width: 99px; } .card { width: 100px; height: 10px; } .card:has(> img) { width: 150px; } .card:has(> img) .title { width: 33px; } .box { width: 10px; } .box:has(.hot) { width: 77px; } .lab { width: 10px; } .lab:has(+ input:disabled) { width: 66px; } .sib { width: 10px; } .sib:has(~ .flag, > .flag) { width: 55px; } .hv { width: 10px; } .hv:has(:hover) { width: 44px; } .hv:has(.a, .b) { height: 31px; }")
  (mod-let CHK (array 3 bool) _)
  (mod-let IMG bool _)
  (mod-let HOT bool _)
  (mod-let Z bool _)
  (mod-let DIS bool _)
  (mod-let FLAG bool _)
  (mod-let B bool _)
  (mod-let ID (array 16 int) _)
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let ul _ (call (. d open) 0 (call (. d tag) "div") 1))
    (for i (.. 0 3) (block
      (let li _ (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d cls) li "row"))
      (= (index ID i) li)
      (let cb _ (call (. d open) 0 (call (. d tag) "input") 1))
      (expr (call (. d attrType) cb "checkbox"))
      (expr (call (. d attrChecked) cb (index CHK i)))
      (expr (call (. d close)))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (let card _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) card "card"))
    (= (index ID 3) card)
    (if IMG (block
      (expr (call (. d open) 0 (call (. d tag) "img") 1))
      (expr (call (. d close)))))
    (let ti _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) ti "title"))
    (= (index ID 4) ti)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let box _ (call (. d open) 2 (call (. d tag) "div") 1))
    (expr (call (. d cls) box "box"))
    (= (index ID 5) box)
    (for k (.. 0 12) (block
      (expr (call (. d open) 0 (call (. d tag) "div") 1))))
    (let deep _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d clsIf) deep "hot" HOT))
    (for k (.. 0 12) (block
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let noise _ (call (. d open) 3 (call (. d tag) "div") 1))
    (expr (call (. d clsIf) noise "z" Z))
    (= (index ID 6) noise)
    (expr (call (. d close)))
    (let lab _ (call (. d open) 4 (call (. d tag) "label") 1))
    (expr (call (. d cls) lab "lab"))
    (= (index ID 7) lab)
    (expr (call (. d close)))
    (let ip _ (call (. d open) 5 (call (. d tag) "input") 1))
    (expr (call (. d attrDisabled) ip DIS))
    (expr (call (. d close)))
    (let sib _ (call (. d open) 6 (call (. d tag) "div") 1))
    (expr (call (. d cls) sib "sib"))
    (= (index ID 8) sib)
    (if B (block
      (let kid _ (call (. d open) 0 (call (. d tag) "span") 1))
      (expr (call (. d cls) kid "flag"))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (let nx _ (call (. d open) 7 (call (. d tag) "span") 1))
    (expr (call (. d clsIf) nx "flag" FLAG))
    (expr (call (. d close)))
    (let hv _ (call (. d open) 8 (call (. d tag) "div") 1))
    (expr (call (. d cls) hv "hv"))
    (= (index ID 9) hv)
    (let hk _ (call (. d open) 0 (call (. d tag) "span") 1))
    (= (index ID 10) hk)
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn settle (params (d (ref Dom))) _ (block
    (expr (call frame d))
    (expr (call frame d))))
  (fn w (params (d (ref Dom)) (i int)) f32 (block
    (return (. (index (. (. d nodes) items) (index ID i)) w))))
  (const FONT string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, input { font-family: \"T\"; font-size: 14px; display: block; } ")
  (mod-let NLEAF int _)
  (mod-let DEPTH int _)
  (mod-let HOTLEAF bool _)
  (mod-let KIDS int _)
  (mod-let HOT2 bool _)
  (mod-let TXT bool _)
  (mod-let CARRIER int _)
  (fn combFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (for i (.. 0 DEPTH) (block
      (expr (call (. d open) 0 (call (. d tag) "div") 1))
      (for j (.. 0 NLEAF) (block
        (let l _ (call (. d open) (+ j 1) (call (. d tag) "div") 1))
        (if (&& (&& HOTLEAF (== i (- DEPTH 1))) (|| (== j 0) (&& HOT2 (== j 1)))) (block
          (expr (call (. d cls) l "x"))))
        (expr (call (. d close)))))))
    (for i (.. 0 DEPTH) (block
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn panelFrame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (for i (.. 0 10) (block
      (expr (call (. d open) 0 (call (. d tag) "div") 1))))
    (let p _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) p "panel"))
    (= CARRIER p)
    (for i (.. 0 KIDS) (block
      (expr (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d close)))))
    (if TXT (block
      (expr (call (. d text) "hello"))))
    (expr (call (. d close)))
    (for i (.. 0 10) (block
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn combEvals (params (mem (ref Arena)) (depth int) (leaves int)) int (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) FONT "font.css" 1))
    (expr (call parse (& css) "div:has(.x) { width: 77px; }" "comb.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "comb sheet parses"))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= DEPTH depth)
    (= NLEAF leaves)
    (= HOTLEAF (bool false))
    (expr (call settleWith (& d) 0))
    (= (. css hasEvals) 0)
    (= HOTLEAF (bool true))
    (expr (call combFrame (& d)))
    (return (. css hasEvals))))
  (fn settleWith (params (d (ref Dom)) (which int)) _ (block
    (if (== which 0) (block
      (expr (call combFrame d))
      (expr (call combFrame d))) (block
      (expr (call panelFrame d))
      (expr (call panelFrame d))))))
  (fn combRestyled (params (mem (ref Arena)) (rule string)) int (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) FONT "font.css" 1))
    (expr (call parse (& css) rule "cr.css" 1))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= DEPTH 50)
    (= NLEAF 20)
    (= HOTLEAF (bool true))
    (= HOT2 (bool false))
    (expr (call settleWith (& d) 0))
    (let r0 _ (. d restyled))
    (= HOT2 (bool true))
    (expr (call combFrame (& d)))
    (= HOT2 (bool false))
    (return (- (. d restyled) r0))))
  (fn testCost (params (mem (ref Arena))) _ (block
    (let e1 _ (call combEvals mem 50 20))
    (let e2 _ (call combEvals mem 100 20))
    (expr (call ok (&& (> e1 0) (> e2 0)) "the carriers were evaluated"))
    (expr (call ok (< e2 (* 3 e1)) "doubling the tree less than triples the :has() work"))
    (expr (call ok (<= e2 (* 4 2100)) "and it is about one test per node, not per node and ancestor"))
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) FONT "font.css" 1))
    (expr (call parse (& css) ".panel:has(input:checked) { width: 77px; }" "mass.css" 1))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= KIDS 2000)
    (= TXT (bool false))
    (= (. css hasWalked) 0)
    (expr (call panelFrame (& d)))
    (expr (call ok (<= (. css hasWalked) (* 3 2000)) "mounting 2000 children walks ancestors about once each, not once per insert"))
    (expr (call ok (> (. css hasWalked) 0) "the walk ran"))
    (expr (call panelFrame (& d)))
    (= (. css hasWalked) 0)
    (= TXT (bool true))
    (expr (call panelFrame (& d)))
    (expr (call ok (== (. css hasWalked) 0) "inserting a text node walks nothing"))
    (= TXT (bool false))
    (expr (call panelFrame (& d)))
    (expr (call ok (== (. css hasWalked) 0) "removing it walks nothing"))
    (expr (call ok (<= (call combRestyled mem "div:has(.x) { width: 77px; }") (* 3 50)) "a second match below matching carriers restyles the carriers, not their subtrees"))
    (expr (call ok (>= (call combRestyled mem "div:has(.x) .y { width: 77px; }") 1000) "with :has() before a combinator the subtrees restyle"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 32 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "has.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (expr (call ok (== (. css hasMode) 15) "all four relations in use"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call settle (& d)))
    (expr (call ok (&& (&& (== (call w (& d) 0) (float 0x4024000000000000)) (== (call w (& d) 3) (float 0x4059000000000000))) (== (call w (& d) 5) (float 0x4024000000000000))) "nothing matches at first"))
    (= (index CHK 1) (bool true))
    (expr (call frame (& d)))
    (expr (call ok (&& (== (call w (& d) 1) (float 0x4058c00000000000)) (== (call w (& d) 0) (float 0x4024000000000000))) "checking a box restyles its li"))
    (= (index CHK 1) (bool false))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 1) (float 0x4024000000000000)) "unchecking restores it"))
    (= IMG (bool true))
    (expr (call frame (& d)))
    (expr (call ok (&& (== (call w (& d) 3) (float 0x4062c00000000000)) (== (call w (& d) 4) (float 0x4040800000000000))) "an inserted img flips .card:has(> img) and .card:has(> img) .title"))
    (= IMG (bool false))
    (expr (call frame (& d)))
    (expr (call ok (&& (== (call w (& d) 3) (float 0x4059000000000000)) (!= (call w (& d) 4) (float 0x4040800000000000))) "removing it flips both back"))
    (= HOT (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 5) (float 0x4053400000000000)) "a class on a deep descendant flips the ancestor"))
    (= HOT (bool false))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 5) (float 0x4024000000000000)) "and back"))
    (expr (call settle (& d)))
    (let r0 _ (. d restyled))
    (= Z (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (- (. d restyled) r0) 1) "an unrelated class restyles one node, no ancestor walk"))
    (= Z (bool false))
    (expr (call settle (& d)))
    (= DIS (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 7) (float 0x4050800000000000)) "a later sibling's flag flips the earlier sibling"))
    (= DIS (bool false))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 7) (float 0x4024000000000000)) "and back"))
    (= FLAG (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 8) (float 0x404b800000000000)) "a class on a later sibling flips :has(~ .flag)"))
    (= FLAG (bool false))
    (= B (bool true))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 8) (float 0x404b800000000000)) "a child .flag flips the other argument"))
    (= B (bool false))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 8) (float 0x4024000000000000)) "neither: off"))
    (expr (call (. d setFlag) (index ID 10) FL_HOVER (bool true)))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 9) (float 0x4046000000000000)) "hover on a descendant flips the ancestor"))
    (expr (call (. d setFlag) (index ID 10) FL_HOVER (bool false)))
    (expr (call frame (& d)))
    (expr (call ok (== (call w (& d) 9) (float 0x4024000000000000)) "and back"))
    (let l0 _ (. d laid))
    (let s0 _ (. d restyled))
    (expr (call settle (& d)))
    (expr (call settle (& d)))
    (expr (call ok (&& (== (. d laid) l0) (== (. d restyled) s0)) "steady frames lay out and restyle nothing"))
    (let plain _ (call (. Css new) (& mem)))
    (expr (call parse (& plain) "div { width: 10px; } li:hover { width: 5px; }" "p2.css" 1))
    (expr (call ok (&& (== (. plain hasMode) 0) (== (. (. plain hasSubj) len) 0)) "without :has() rules the mode is off"))
    (expr (call testCost (& mem)))
    (expr (call printLn (interp "has_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
