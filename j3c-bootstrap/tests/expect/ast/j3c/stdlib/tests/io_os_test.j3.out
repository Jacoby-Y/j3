(file (module io_os_test)
  (use j3.io)
  (use j3.io (names printLn IoError))
  (use j3.io.path)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.proc)
  (use j3.proc (names Child StartOpts))
  (use j3.result.Result)
  (use j3.sys)
  (use j3.sys.panic)
  (use j3.text (names fmtTimeUtc parseInt same startsWith Text))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn is (params (got string) (want string) (msg string)) _ (block
    (if (! (call same got want)) (block
      (expr (call printLn (interp "FAIL: " msg ": got \"" got "\", want \"" want "\"")))
      (expr (call panic msg))))))
  (fn testPath (params (a (ref Arena))) _ (block
    (expr (call is (call (. path normalize) "./a//b/../c/" a) "a/c" "normalize dots"))
    (expr (call is (call (. path normalize) "/../x/./y/.." a) "/x" "normalize abs"))
    (expr (call is (call (. path normalize) "" a) "." "normalize empty"))
    (expr (call is (call (. path normalize) "a/.." a) "." "normalize to dot"))
    (expr (call is (call (. path normalize) "../../a/b/.." a) "../../a" "normalize leading dotdot"))
    (expr (call is (call (. path normalize) "a/../../b" a) "../b" "normalize climb"))
    (expr (call is (call (. path normalize) "/" a) "/" "normalize root"))
    (expr (call is (call (. path normalize) "//a//" a) "/a" "normalize slashes"))
    (expr (call is (call (. path join) "a" "b" a) "a/b" "join"))
    (expr (call is (call (. path join) "a/" "b" a) "a/b" "join slash"))
    (expr (call is (call (. path join) "a" "/b" a) "/b" "join abs"))
    (expr (call is (call (. path join) "" "b" a) "b" "join empty a"))
    (expr (call is (call (. path join) "a" "" a) "a" "join empty b"))
    (expr (call is (call (. path dirname) "a/b") "a" "dirname"))
    (expr (call is (call (. path dirname) "a") "." "dirname bare"))
    (expr (call is (call (. path dirname) "/a") "/" "dirname root child"))
    (expr (call is (call (. path dirname) "/") "/" "dirname root"))
    (expr (call is (call (. path dirname) "a/b/") "a" "dirname trailing"))
    (expr (call is (call (. path dirname) "a//b") "a" "dirname double"))
    (expr (call is (call (. path dirname) "/a/b") "/a" "dirname abs"))
    (expr (call is (call (. path basename) "a/b.j3") "b.j3" "basename"))
    (expr (call is (call (. path basename) "a/b/") "b" "basename trailing"))
    (expr (call is (call (. path basename) "/") "/" "basename root"))
    (expr (call is (call (. path ext) "a/b.tar.gz") ".gz" "ext"))
    (expr (call is (call (. path ext) ".bashrc") "" "ext dotfile"))
    (expr (call is (call (. path ext) "a/b") "" "ext none"))
    (expr (call is (call (. path ext) "..") "" "ext dotdot"))
    (expr (call ok (&& (call (. path isAbs) "/x") (! (call (. path isAbs) "x"))) "isAbs"))
    (expr (call ok (&& (call (. path glob) "*.j3" "main.j3") (! (call (. path glob) "*.j3" "main.j3s"))) "glob star"))
    (expr (call ok (&& (&& (call (. path glob) "a?c" "abc") (call (. path glob) "src/*/x" "src/a/b/x")) (! (call (. path glob) "a?c" "ac"))) "glob"))))
  (fn good (tparams T E) (params (r (gen Result T E))) bool (block
    (match r
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (wild)) (block)))
    (return (bool false))))
  (fn none (tparams T) (params (o (gen Option T))) bool (block
    (match o
      (arm (pats (variant Option.Some (wild))) (block
        (return (bool false))))
      (arm (pats (wild)) (block)))
    (return (bool true))))
  (fn read (params (p string) (a (ref Arena))) string (block
    (match (call (. io readFile) p a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (return (as b string))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic (interp "readFile " p))))))
    (return "")))
  (fn must (params (r (gen Result int IoError)) (msg string)) int (block
    (match r
      (arm (pats (variant Result.Ok (bind n))) (block
        (return n)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic msg)))))
    (return 0)))
  (fn (doc "Names in `dir` that start with `prefix`.") countPrefix (params (dir string) (prefix string) (a (ref Arena))) int (block
    (let n _ 0)
    (match (call (. io listDir) dir a)
      (arm (pats (variant Result.Ok (bind ents))) (block
        (for i (.. 0 (. ents len)) (block
          (let e _ (. (index ents i) name))
          (if (&& (>= (. e len) (. prefix len)) (call same (slice-expr e 0 (. prefix len)) prefix)) (block
            (+= n 1)))))))
      (arm (pats (wild)) (block)))
    (return n)))
  (fn testAtomic (params (base string) (a (ref Arena))) _ (block
    (let f _ (call (. path join) base "a.txt" a))
    (expr (call must (call (. io writeFile) f (as "old" (slice u8))) "writeFile"))
    (expr (call must (call (. io writeFileAtomic) f (as "new" (slice u8))) "writeFileAtomic"))
    (expr (call is (call read f a) "new" "atomic replaced"))
    (expr (call ok (== (call countPrefix base ".a.txt.tmp" a) 0) "no temp left after commit"))
    (let pid _ (call (. sys fork)))
    (if (== pid 0) (block
      (match (call (. io createAtomic) f a)
        (arm (pats (variant Result.Ok (bind w))) (block
          (expr (call (. w write) (as "partial" (slice u8))))
          (expr (call (. sys kill) (call (. sys getpid)) (. sys SIGKILL)))))
        (arm (pats (wild)) (block)))
      (expr (call (. sys exit) 1))))
    (let st i32 0)
    (expr (call (. sys waitpid) pid (& st) 0))
    (expr (call ok (== (call (. sys exitCode) st) (+ 128 9)) "child was killed"))
    (expr (call is (call read f a) "new" "killed halfway leaves old file"))
    (expr (call ok (== (call countPrefix base ".a.txt.tmp" a) 1) "killed writer left its temp"))
    (let d _ (call (. path join) base "d" a))
    (expr (call ok (call good (call (. io makeDirs) (call (. path join) d "e" a))) "makeDirs"))
    (expr (call ok (! (call good (call (. io writeFileAtomic) d (as "x" (slice u8))))) "atomic over dir fails"))
    (expr (call ok (== (call countPrefix base ".d.tmp" a) 0) "failed rename removed temp"))
    (expr (call ok (! (call good (call (. io writeFileAtomic) (call (. path join) base "nodir/x" a) (as "x" (slice u8))))) "atomic in missing dir fails"))
    (expr (call (. io removeDir) (call (. path join) d "e" a)))
    (expr (call ok (call good (call (. io removeDir) d)) "removeDir"))))
  (fn testCopyWalkTemp (params (base string) (a (ref Arena))) _ (block
    (let big _ (call (. a alloc) (targs u8) 200000))
    (for i (.. 0 (. big len)) (block
      (= (index big i) (call u8 (% i 251)))))
    (let src _ (call (. path join) base "big.bin" a))
    (expr (call must (call (. io writeFile) src big) "write big"))
    (expr (call ok (== (call must (call (. io copyFile) src (call (. path join) base "copy.bin" a)) "copyFile") (. big len)) "copy count"))
    (expr (call is (call read (call (. path join) base "copy.bin" a) a) (as big string) "copy bytes"))
    (expr (call ok (! (call good (call (. io copyFile) (call (. path join) base "missing" a) src))) "copy missing fails"))
    (let w _ (call (. path join) base "w" a))
    (expr (call (. io makeDirs) (call (. path join) w "sub/deep" a)))
    (expr (call must (call (. io writeFile) (call (. path join) w "y.txt" a) (as "" (slice u8))) "w y"))
    (expr (call must (call (. io writeFile) (call (. path join) w "x.j3" a) (as "" (slice u8))) "w x"))
    (expr (call must (call (. io writeFile) (call (. path join) w "sub/z.j3" a) (as "" (slice u8))) "w z"))
    (expr (call must (call (. io writeFile) (call (. path join) w "sub/deep/q.j3" a) (as "" (slice u8))) "w q"))
    (match (call (. io walk) w "*.j3" a)
      (arm (pats (variant Result.Ok (bind es))) (block
        (expr (call ok (== (. es len) 3) "walk count"))
        (expr (call is (. (index es 0) name) "x.j3" "walk 0"))
        (expr (call is (. (index es 1) name) "sub/z.j3" "walk 1"))
        (expr (call is (. (index es 2) name) "sub/deep/q.j3" "walk 2"))))
      (arm (pats (wild)) (block
        (expr (call panic "walk")))))
    (match (call (. io walk) w "sub/*" a)
      (arm (pats (variant Result.Ok (bind es))) (block
        (expr (call ok (== (. es len) 2) "walk slash pattern"))))
      (arm (pats (wild)) (block)))
    (match (call (. io walk) w "" a)
      (arm (pats (variant Result.Ok (bind es))) (block
        (expr (call ok (== (. es len) 4) "walk all"))))
      (arm (pats (wild)) (block)))
    (expr (call ok (! (call good (call (. io walk) (call (. path join) base "nope" a) "" a))) "walk missing root"))
    (match (call (. io tempFile) base "tf" a)
      (arm (pats (variant Result.Ok (bind t1))) (block
        (match (call (. io tempFile) base "tf" a)
          (arm (pats (variant Result.Ok (bind t2))) (block
            (expr (call ok (! (call same (. t1 path) (. t2 path))) "temp names differ"))
            (expr (call (. sys close) (. t2 fd)))))
          (arm (pats (wild)) (block)))
        (expr (call (. sys close) (. t1 fd)))))
      (arm (pats (wild)) (block
        (expr (call panic "tempFile")))))
    (expr (call ok (== (call countPrefix base "tf" a) 2) "two temp files"))
    (let real _ (call (. path realpath) base a))
    (match real
      (arm (pats (variant Option.Some (bind r))) (block
        (expr (call ok (call (. path isAbs) r) "realpath abs"))) (tail (match (call (. path realpath) (call (. path join) base "w/./sub/../x.j3" a) a)
        (arm (pats (variant Option.Some (bind r2))) (block
          (expr (call is r2 (call (. path join) r "w/x.j3" a) "realpath resolves"))))
        (arm (pats (wild)) (block
          (expr (call panic "realpath file")))))))
      (arm (pats (wild)) (block
        (expr (call panic "realpath")))))
    (expr (call ok (call none (call (. path realpath) (call (. path join) base "missing" a) a)) "realpath missing"))))
  (fn testLock (params (base string) (a (ref Arena))) _ (block
    (let lp _ (call (. path join) base "l.lock" a))
    (let held _ (call (. io lockFile) lp))
    (expr (call ok (call good held) "lockFile"))
    (let heldFd _ (- 1))
    (match held
      (arm (pats (variant Result.Ok (bind l))) (block
        (= heldFd (. l fd))))
      (arm (pats (wild)) (block)))
    (let fds (array 2 i32) (array-lit 0 0))
    (expr (call (. sys pipe) (slice-expr fds _ _) 0))
    (let pid _ (call (. sys fork)))
    (if (== pid 0) (block
      (expr (call (. sys close) heldFd))
      (let code _ 0)
      (match (call (. io tryLockFile) lp)
        (arm (pats (variant Result.Ok (bind o))) (block) (tail (match o
          (arm (pats (variant Option.Some (wild))) (block
            (= code 10)))
          (arm (pats (wild)) (block)))))
        (arm (pats (wild)) (block
          (= code 11))))
      (let b u8 1)
      (expr (call (. sys write) (call int (index fds 1)) (as (& b) ptr) 1))
      (if (&& (== code 0) (! (call good (call (. io lockFile) lp)))) (block
        (= code 12)))
      (expr (call (. sys exit) (call i32 code)))))
    (let b u8 0)
    (expr (call ok (== (call (. sys read) (call int (index fds 0)) (as (& b) ptr) 1) 1) "child tried the lock"))
    (match held
      (arm (pats (variant Result.Ok (bind l))) (block
        (expr (call (. l unlock)))))
      (arm (pats (wild)) (block)))
    (let st i32 0)
    (expr (call (. sys waitpid) pid (& st) 0))
    (expr (call ok (== (call (. sys exitCode) st) 0) (interp "lock child code " (call (. sys exitCode) st))))
    (expr (call (. sys close) (call int (index fds 0))))
    (expr (call (. sys close) (call int (index fds 1))))
    (match (call (. io tryLockFile) lp)
      (arm (pats (variant Result.Ok (bind o))) (block) (tail (match o
        (arm (pats (variant Option.Some (bind l))) (block
          (expr (call (. l unlock)))))
        (arm (pats (wild)) (block
          (expr (call panic "lock free after child exit")))))))
      (arm (pats (wild)) (block)))))
  (fn start (params (cmd string) (a (ref Arena))) Child (block
    (let argv (array 3 string) (array-lit "sh" "-c" cmd))
    (match (call (. proc start) (slice-expr argv _ _) a)
      (arm (pats (variant Result.Ok (bind c))) (block
        (return c)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "proc.start")))))
    (return (struct-lit Child (field pid 0) (field stdin (- 1)) (field stdout (- 1)) (field stderr (- 1))))))
  (fn next (params (cs (slice Child))) int (block
    (match (call (. proc waitAny) cs)
      (arm (pats (variant Result.Ok (bind i))) (block
        (return i)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "waitAny")))))
    (return (- 1))))
  (fn testWaitAny (params (a (ref Arena))) _ (block
    (let other _ (call (. sys fork)))
    (if (== other 0) (block
      (expr (call (. sys exit) 9))))
    (let cs _ (call (. a alloc) (targs Child) 3))
    (= (index cs 0) (call start "sleep 0.4; exit 3" a))
    (= (index cs 1) (call start "exit 5" a))
    (= (index cs 2) (call start "sleep 0.15; exit 7" a))
    (let i _ (call next cs))
    (expr (call ok (&& (== i 1) (== (. (index cs 1) code) 5)) "first done"))
    (= i (call next cs))
    (expr (call ok (&& (== i 2) (== (. (index cs 2) code) 7)) "second done"))
    (= i (call next cs))
    (expr (call ok (&& (== i 0) (== (. (index cs 0) code) 3)) "third done"))
    (expr (call ok (! (call good (call (. proc waitAny) cs))) "none left"))
    (for k (.. 0 3) (block
      (expr (call ok (== (call (. (index cs k) wait)) (index (array-lit 3 5 7) k)) "wait after waitAny"))))
    (let two _ (call (. a alloc) (targs Child) 2))
    (= (index two 0) (call start "exit 1" a))
    (= (index two 1) (call start "exit 2" a))
    (let sl (array 2 string) (array-lit "sleep" "0.2"))
    (expr (call (. proc run) (slice-expr sl _ _) "" a))
    (let x _ (call next two))
    (let y _ (call next two))
    (expr (call ok (&& (&& (!= x y) (== (. (index two 0) code) 1)) (== (. (index two 1) code) 2)) "two at once"))
    (expr (call (. (index two 0) wait)))
    (expr (call (. (index two 1) wait)))
    (let st i32 0)
    (expr (call ok (&& (== (call (. sys waitpid) other (& st) 0) other) (== (call (. sys exitCode) st) 9)) "unrelated child not reaped"))))
  (fn (doc "`readFile` of 0-size /proc files and of a file past the 4096 first chunk; `diskSpace`; the wall clock.") testProcDiskClock (params (base string) (a (ref Arena))) _ (block
    (match (call (. io readFile) "/proc/meminfo" a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (expr (call ok (call startsWith (as b string) "MemTotal:") "/proc/meminfo content"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "readFile /proc/meminfo")))))
    (match (call (. io readFile) "/proc/cpuinfo" a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (expr (call ok (> (. b len) 4096) "/proc/cpuinfo read past the first chunk"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "readFile /proc/cpuinfo")))))
    (let big _ (call (. a alloc) (targs u8) 10000))
    (for i (.. 0 (. big len)) (block
      (= (index big i) (call u8 (% i 251)))))
    (let p _ (call (. path join) base "big.bin" a))
    (match (call (. io writeFile) p big)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "write big.bin")))))
    (match (call (. io readFile) p a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (expr (call ok (&& (== (. b len) 10000) (== (index b 9999) (call u8 (% 9999 251)))) "readFile sized file"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "readFile big.bin")))))
    (match (call (. io diskSpace) base)
      (arm (pats (variant Result.Ok (bind d))) (block
        (expr (call ok (&& (&& (> (. d total) 0) (<= (. d free) (. d total))) (<= (. d available) (. d free))) "diskSpace sizes"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "diskSpace")))))
    (match (call (. io diskSpace) (call (. path join) base "nope/nope" a))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "diskSpace of a missing path"))))
      (arm (pats (variant Result.Err (variant IoError.NotFound))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "diskSpace missing should be NotFound")))))
    (let now _ (call (. sys unixMs)))
    (expr (call ok (&& (> now 1767225600000) (< now 4102444800000)) "unixMs is a plausible date"))
    (let ns _ (call (. sys unixNs)))
    (expr (call ok (&& (>= (/ ns 1000000) now) (< (- (/ ns 1000000) now) 5000)) "unixNs agrees with unixMs"))
    (let t _ (call (. Text new) a))
    (expr (call is (call fmtTimeUtc (& t) 0) "1970-01-01T00:00:00.000Z" "fmtTimeUtc epoch"))
    (expr (call (. t clear)))
    (expr (call is (call fmtTimeUtc (& t) 1795640645123) "2026-11-25T21:04:05.123Z" "fmtTimeUtc 2026"))
    (expr (call (. t clear)))
    (expr (call is (call fmtTimeUtc (& t) 951782400000) "2000-02-29T00:00:00.000Z" "fmtTimeUtc leap day"))
    (expr (call (. t clear)))
    (expr (call is (call fmtTimeUtc (& t) (- 1)) "1969-12-31T23:59:59.999Z" "fmtTimeUtc before epoch"))
    (expr (call (. t clear)))
    (expr (call (. t pushStr) "log "))
    (expr (call is (call fmtTimeUtc (& t) 253402300799999) "9999-12-31T23:59:59.999Z" "fmtTimeUtc returns only the appended part"))))
  (fn (doc "`sleepMs`; `startWith`: `killTree` reaches a grandchild, both streams appended to one file, an rlimit.") testProcExtras (params (base string) (a (ref Arena))) _ (block
    (let t0 _ (call (. sys monotonicMs)))
    (expr (call (. sys sleepMs) 50))
    (expr (call ok (>= (- (call (. sys monotonicMs)) t0) 50) "sleepMs sleeps the whole time"))
    (let pidFile _ (call (. path join) base "grandchild.pid" a))
    (let script (array 3 string) (array-lit "sh" "-c" (interp "sleep 30 & echo $! > " pidFile "; wait")))
    (let c _ (match (call (. proc startWith) (slice-expr script _ _) (slice-expr script 0 0) (struct-lit StartOpts (field group (bool true))) a)
      (arm (pats (variant Result.Ok (bind c))) (block) (tail c))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "startWith group"))
        (return)))))
    (let gpid _ 0)
    (for i (.. 0 200) (block
      (match (call (. io readFile) pidFile a)
        (arm (pats (variant Result.Ok (bind b))) (block
          (if (&& (> (. b len) 1) (== (index b (- (. b len) 1)) (call u8 10))) (block
            (match (call parseInt (as (slice-expr b 0 (- (. b len) 1)) string) 10)
              (arm (pats (variant Option.Some (bind v))) (block
                (= gpid v)))
              (arm (pats (variant Option.None)) (block)))))))
        (arm (pats (variant Result.Err (wild))) (block)))
      (if (> gpid 0) (block
        (break)))
      (expr (call (. sys sleepMs) 10))))
    (expr (call ok (> gpid 0) "grandchild pid written"))
    (expr (call (. c killTree) (. sys SIGKILL)))
    (expr (call ok (== (call (. c wait)) (+ 128 (. sys SIGKILL))) "group leader killed"))
    (let gone _ (bool false))
    (for i (.. 0 200) (block
      (if (< (call (. sys kill) gpid 0) 0) (block
        (= gone (bool true))
        (break)))
      (expr (call (. sys sleepMs) 10))))
    (expr (call ok gone "killTree reached the grandchild"))
    (let logPath _ (call (. path join) base "both.log" a))
    (let both (array 3 string) (array-lit "sh" "-c" "echo out; echo err >&2"))
    (for i (.. 0 2) (block
      (let fd _ (call (. io openPath) logPath (+ (+ (. sys O_WRONLY) (. sys O_CREAT)) (. sys O_APPEND)) 420))
      (expr (call ok (>= fd 0) "open log"))
      (match (call (. proc startWith) (slice-expr both _ _) (slice-expr both 0 0) (struct-lit StartOpts (field stdoutFd fd) (field stderrFd fd)) a)
        (arm (pats (variant Result.Ok (bind k))) (block
          (expr (call (. sys close) fd))
          (let o _ (call (. k collect) (as (slice-expr both 0 0) (slice u8)) a))
          (expr (call ok (&& (&& (== (. o code) 0) (== (. (. o out) len) 0)) (== (. (. o err) len) 0)) "redirected streams leave the pipes empty"))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call panic "startWith redirect")))))))
    (match (call (. io readFile) logPath a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (expr (call is (as b string) "out\nerr\nout\nerr\n" "both streams appended"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "read log")))))
    (let lim (array 3 string) (array-lit "sh" "-c" "ulimit -t"))
    (match (call (. proc startWith) (slice-expr lim _ _) (slice-expr lim 0 0) (struct-lit StartOpts (field cpuSecs 7)) a)
      (arm (pats (variant Result.Ok (bind k))) (block
        (expr (call is (call (. (call (. k collect) (as (slice-expr lim 0 0) (slice u8)) a) outStr)) "7\n" "cpuSecs rlimit"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "startWith rlimit")))))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (<< 1 20)))
    (expr (call testPath (& a)))
    (let base _ "")
    (match (call (. io tempDir) "" "j3iotest" (& a))
      (arm (pats (variant Result.Ok (bind d))) (block
        (= base d)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "tempDir")))))
    (expr (call testAtomic base (& a)))
    (expr (call testCopyWalkTemp base (& a)))
    (expr (call testLock base (& a)))
    (expr (call testWaitAny (& a)))
    (expr (call testProcDiskClock base (& a)))
    (expr (call testProcExtras base (& a)))
    (let rm (array 3 string) (array-lit "rm" "-rf" base))
    (expr (call (. proc run) (slice-expr rm _ _) "" (& a)))
    (expr (call ok (! (call (. io exists) base)) "cleaned up"))
    (expr (call printLn "io_os_test ok")))))
--- stderr
--- exit 0
