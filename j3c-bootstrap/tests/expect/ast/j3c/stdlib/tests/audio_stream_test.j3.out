(file (module audio_stream_test)
  (use j3.game)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "audio_stream_test"))))))
  (fn main (params) _ (block
    (let s _ (call (. game openAudioStream) 48000 2))
    (if (== (. s raw) 0) (block
      (expr (call printLn "skip: no audio device"))
      (return)))
    (let arena _ (call (. Arena create) (* 1024 1024)))
    (let buf _ (call (. arena alloc) (targs f32) 48000))
    (expr (call (. s queue) buf))
    (let q0 _ (call (. s queued)))
    (expr (call ok (&& (> q0 20000) (<= q0 24000)) (interp "queued " q0 " after 0.5 s")))
    (let t0 _ (call (. game ticks)))
    (while (< (- (call (. game ticks)) t0) 200) (block))
    (let q1 _ (call (. s queued)))
    (expr (call printLn (interp "queued " q0 " -> " q1 " after 200 ms")))
    (expr (call ok (&& (> (- q0 q1) 4800) (< (- q0 q1) 16000)) "drains in real time"))
    (expr (call (. s pause) (bool true)))
    (expr (call (. s clear)))
    (expr (call ok (== (call (. s queued)) 0) "clear empties the queue"))
    (expr (call (. s close)))
    (expr (call ok (== (. s raw) 0) "close empties the stream"))
    (expr (call (. s queue) (slice-expr buf 0 2)))
    (expr (call printLn "ok")))))
--- stderr
--- exit 0
