(file (module term_grid_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.term.Color)
  (use j3.term.Style)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.grid)
  (use j3.term.grid.Grid)
  (use j3.text.Text)
  (fn eq (params (a string) (b string) (msg string)) _ (block
    (if (! (== a b)) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call printLn "  want:"))
      (expr (call printLn b))
      (expr (call printLn "  got:"))
      (expr (call printLn a))
      (expr (call panic msg))))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eqi (params (a int) (b int) (msg string)) _ (block
    (if (!= a b) (block
      (expr (call printLn (interp "FAIL: " msg ": want " b " got " a)))
      (expr (call panic msg))))))
  (fn mk (params (s string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 (. s len)) (block
      (let c _ (index s i))
      (expr (call (. t push) (if-expr (== c 126) 27 (if-expr (== c 36) 7 (if-expr (== c 94) 8 c)))))))
    (return (call (. t str)))))
  (struct (doc "A grid and its parser; `go` feeds a sample.") Term
    (field g Grid)
    (field p Parser)
    (field a (ref Arena))
    (fn go (params (this (ref Term)) (s string)) _ (block
      (let b _ (call mk s (. this a)))
      (expr (call (. (. this p) feed) b (& (. this g))))))
    (fn dump (params (this (ref Term))) string (block
      (return (call (. (. this g) dumpText) (. this a))))))
  (fn term (params (a (ref Arena)) (cols int) (rows int) (sb int)) Term (block
    (return (struct-lit Term (field g (call (. Grid new) a cols rows sb)) (field p (call (. Parser new) a)) (field a a)))))
  (fn cursor (params (t (ref Term)) (x int) (y int) (msg string)) _ (block
    (expr (call eqi (call (. (. t g) cursorX)) x (interp msg " cursor x")))
    (expr (call eqi (call (. (. t g) cursorY)) y (interp msg " cursor y")))))
  (fn repeat (params (s string) (n int) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 n) (block
      (expr (call (. t add) s))))
    (return (call (. t str)))))
  (fn join (params (x string) (y string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. (call (. t add) x) add) y))
    (return (call (. t str)))))
  (fn moves (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 4 0))
    (expr (call (. t go) "abc~[2;3Hx~[Ay~[2Dz"))
    (expr (call eq (call (. t dump)) "abzy\n  x\n\n" "CUP, CUU, CUB"))
    (expr (call cursor (& t) 3 0 "after CUB"))
    (expr (call (. t go) "~[10C~[99B~[99;99H"))
    (expr (call cursor (& t) 9 3 "clamped"))
    (expr (call (. t go) "~[H~[0;0H"))
    (expr (call cursor (& t) 0 0 "0 means 1"))
    (expr (call (. t go) "~[3;4H~[E"))
    (expr (call cursor (& t) 0 3 "CNL clamps"))
    (expr (call (. t go) "~[2F"))
    (expr (call cursor (& t) 0 1 "CPL"))
    (expr (call (. t go) "~[5G"))
    (expr (call cursor (& t) 4 1 "CHA"))
    (expr (call (. t go) "~[3d"))
    (expr (call cursor (& t) 4 2 "VPA"))
    (expr (call (. t go) "~[1;1H~[2J~[3;1H1234567890~[1;8H~[2J"))
    (expr (call eq (call (. t dump)) "\n\n\n" "ED 2"))
    (expr (call (. t go) "~[65535A~[65535D"))
    (expr (call cursor (& t) 0 0 "huge moves clamp"))
    (expr (call (. t go) "~[3;3H~[s"))
    (expr (call cursor (& t) 2 2 "unknown CSI ignored"))
    (expr (call (. t go) "ab~D"))
    (expr (call cursor (& t) 4 3 "IND moves down"))
    (expr (call (. t go) "~E"))
    (expr (call cursor (& t) 0 3 "NEL"))))
  (fn tabs (params (a (ref Arena))) _ (block
    (let t _ (call term a 20 2 0))
    (expr (call (. t go) "a\tb\tc"))
    (expr (call eq (call (. t dump)) "a       b       c\n" "default tab stops"))
    (expr (call (. t go) "~[2J~[H~[3g~[5G~H~[1;1H\ty"))
    (expr (call eq (call (. t dump)) "    y\n" "TBC 3 and HTS"))
    (expr (call (. t go) "~[1;10H~[Z"))
    (expr (call cursor (& t) 4 0 "CBT to the stop"))
    (expr (call (. t go) "~[Z"))
    (expr (call cursor (& t) 0 0 "CBT to column 0"))
    (expr (call (. t go) "~[3I"))
    (expr (call cursor (& t) 19 0 "CHT past the last stop ends on the last column"))))
  (fn deferredWrap (params (a (ref Arena))) _ (block
    (let t _ (call term a 80 2 5))
    (expr (call (. t go) (call repeat "a" 80 a)))
    (expr (call cursor (& t) 79 0 "80 chars"))
    (expr (call ok (. (. t g) wrapPending) "pending wrap set"))
    (expr (call (. t go) (call repeat "b" 80 a)))
    (expr (call cursor (& t) 79 1 "160 chars"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 0 "no scroll until the 161st char"))
    (expr (call (. t go) "c"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 1 "161st char scrolls"))
    (expr (call eq (call (. t dump)) (call join (call repeat "b" 80 a) "\nc" a) "scrolled"))
    (let u _ (call term a 80 3 0))
    (expr (call (. u go) (call repeat "a" 80 a)))
    (expr (call (. u go) "\r\nb"))
    (expr (call eq (call (. u dump)) (call join (call repeat "a" 80 a) "\nb\n" a) "CR LF at the last column makes no blank line"))
    (let w _ (call term a 5 2 0))
    (expr (call (. w go) "abcde^X"))
    (expr (call eq (call (. w dump)) "abcXe\n" "BS from the pending column"))
    (let v _ (call term a 5 2 0))
    (expr (call (. v go) "abcde~[1;5Hf"))
    (expr (call eq (call (. v dump)) "abcdf\n" "CUP clears the pending wrap"))
    (let r _ (call term a 5 2 0))
    (expr (call (. r go) "abcde\rX"))
    (expr (call eq (call (. r dump)) "Xbcde\n" "CR clears the pending wrap"))
    (let n _ (call term a 5 2 0))
    (expr (call (. n go) "~[?7labcdefg"))
    (expr (call eq (call (. n dump)) "abcdg\n" "autowrap off overwrites the last column"))))
  (fn regions (params (a (ref Arena))) _ (block
    (let t _ (call term a 6 6 4))
    (expr (call (. t go) "1\r\n2\r\n3\r\n4\r\n5\r\n6"))
    (expr (call (. t go) "~[2;4r"))
    (expr (call cursor (& t) 0 0 "DECSTBM homes the cursor"))
    (expr (call (. t go) "~[4;1H\n"))
    (expr (call eq (call (. t dump)) "1\n3\n4\n\n5\n6" "LF at the bottom margin scrolls only the region"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 0 "region scroll does not reach scrollback"))
    (expr (call (. t go) "~[6;1H\n\n"))
    (expr (call eq (call (. t dump)) "1\n3\n4\n\n5\n6" "LF on the last row below the region does nothing"))
    (expr (call cursor (& t) 0 5 "stays on the last row"))
    (expr (call (. t go) "~[3;3H~[L"))
    (expr (call eq (call (. t dump)) "1\n3\n\n4\n5\n6" "IL inside the region"))
    (expr (call cursor (& t) 0 2 "IL resets x"))
    (expr (call (. t go) "~[M~[M"))
    (expr (call eq (call (. t dump)) "1\n3\n\n\n5\n6" "DL inside the region"))
    (expr (call (. t go) "~[1;1H~[L~[99M"))
    (expr (call eq (call (. t dump)) "1\n3\n\n\n5\n6" "IL/DL outside the region do nothing"))
    (expr (call (. t go) "~[3;1HX~[99L"))
    (expr (call eq (call (. t dump)) "1\n3\n\n\n5\n6" "huge IL clamps to the region"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 0 "IL/DL never feed scrollback"))
    (expr (call (. t go) "~[2;1H~[S"))
    (expr (call eq (call (. t dump)) "1\n\n\n\n5\n6" "SU"))
    (expr (call (. t go) "~[2;1Ha~[3;1Hb~[T"))
    (expr (call eq (call (. t dump)) "1\n\na\nb\n5\n6" "SD"))
    (expr (call (. t go) "~[1;1H~M"))
    (expr (call eq (call (. t dump)) "1\n\na\nb\n5\n6" "RI above the region just moves up"))
    (expr (call (. t go) "~[2;1H~M"))
    (expr (call eq (call (. t dump)) "1\n\n\na\n5\n6" "RI at the top margin scrolls the region down"))
    (expr (call (. t go) "~[r"))
    (expr (call cursor (& t) 0 0 "DECSTBM reset homes"))
    (expr (call (. t go) "~[6;1H\n"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 1 "full-screen region feeds scrollback"))
    (expr (call eq (call (. (. t g) lineString) 0 a) "1" "oldest scrollback line"))
    (expr (call (. t go) "~[3;3r"))
    (expr (call cursor (& t) 0 5 "one-row region is ignored"))
    (expr (call (. t go) "~[7;9r"))
    (expr (call cursor (& t) 0 5 "bad region is ignored"))))
  (fn origin (params (a (ref Arena))) _ (block
    (let t _ (call term a 6 6 0))
    (expr (call (. t go) "~[2;4r~[?6h~[1;1Hx~[99;1Hy"))
    (expr (call eq (call (. t dump)) "\nx\n\ny\n\n" "origin mode addresses inside the region"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call (. t go) "~[6n"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call mk "~[3;2R" a) "CPR is relative to the region in origin mode"))
    (expr (call (. t go) "~[?6l"))
    (expr (call cursor (& t) 0 0 "leaving origin mode homes"))))
  (fn erase (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 3 0))
    (let fill _ "~[2J~[Haaaaaaaaaa\r\nbbbbbbbbbb\r\ncccccccccc~[2;5H")
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[J"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb\n" "ED 0"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[1J"))
    (expr (call eq (call (. t dump)) "\n     bbbbb\ncccccccccc" "ED 1"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[K"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb\ncccccccccc" "EL 0"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[1K"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\n     bbbbb\ncccccccccc" "EL 1"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[2K"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\n\ncccccccccc" "EL 2"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[3X"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb   bbb\ncccccccccc" "ECH"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[2P"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbbbbbb\ncccccccccc" "DCH"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[2@"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb  bbbb\ncccccccccc" "ICH"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[65535X"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb\ncccccccccc" "huge ECH"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[65535@~[65535P"))
    (expr (call eq (call (. t dump)) "aaaaaaaaaa\nbbbb\ncccccccccc" "huge ICH and DCH"))
    (expr (call (. t go) fill))
    (expr (call (. t go) "~[4h~[1;1HXY~[4l"))
    (expr (call eq (call (. t dump)) "XYaaaaaaaa\nbbbbbbbbbb\ncccccccccc" "IRM shifts the row right"))
    (let b _ (call term a 8 2 0))
    (expr (call (. b go) "~[1;31;42m~[2J"))
    (expr (call eq (call (. (. b g) dumpStyled) a) "{-;p2;0}        {-;-;0}\n{-;p2;0}        {-;-;0}" "BCE keeps only the background"))
    (expr (call (. b go) "~[0m~[H~[44mab~[0mc~[K"))
    (expr (call eq (call (. (. b g) dumpStyled) a) "{-;p4;0}ab{-;-;0}c\n{-;p2;0}        {-;-;0}" "EL with a plain pen blanks plain"))
    (expr (call (. b go) "~[H~[44m~[K"))
    (expr (call eq (call (. (. b g) dumpStyled) a) "{-;p4;0}        {-;-;0}\n{-;p2;0}        {-;-;0}" "EL with a blue pen blanks blue"))))
  (fn pen (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 3 0))
    (expr (call (. t go) "~[1;38;5;196mX~[0m~[38;2;1;2;3mY"))
    (let x _ (call (. (. t g) cell) 0 0))
    (expr (call ok (&& (call (. (. x style) has) 1) (== (. (. x style) fg) (call (. Color palette) 196))) "SGR on a cell"))
    (expr (call ok (== (. (. (call (. (. t g) cell) 1 0) style) fg) (call (. Color rgb) 1 2 3)) "rgb color"))
    (expr (call (. t go) "~[0m~[31m~[2;3H~7~[0m~[H~8"))
    (expr (call cursor (& t) 2 1 "DECRC position"))
    (expr (call ok (== (. (. (. t g) pen) fg) (call (. Color palette) 1)) "DECRC pen"))
    (expr (call (. t go) "~[1;1H~[2Jx~[5b"))
    (expr (call eq (call (. t dump)) "xxxxxx\n\n" "REP"))
    (expr (call (. t go) "~[1;1H~[2Jx~[65535b"))
    (expr (call eq (call (. t dump)) "xxxxxxxxxx\nx\n" "huge REP is capped at the width"))
    (expr (call (. t go) "~[4 q"))
    (expr (call eqi (. (. t g) cursorShape) 4 "DECSCUSR"))))
  (fn wide (params (a (ref Arena))) _ (block
    (let t _ (call term a 5 3 0))
    (expr (call (. t go) "abcd\xe4\xb8\xad"))
    (expr (call eq (call (. t dump)) "abcd\n\xe4\xb8\xad\n" "wide char wraps when one column is left"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 0 1) width)) 2 "head width"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 1 1) width)) 0 "spacer width"))
    (expr (call cursor (& t) 2 1 "after a wide char"))
    (expr (call (. t go) "~[2;2Hx"))
    (expr (call eq (call (. t dump)) "abcd\n x\n" "overwriting the right half blanks the left"))
    (expr (call (. t go) "~[2;1H\xe4\xb8\xad~[2;1Hy"))
    (expr (call eq (call (. t dump)) "abcd\ny\n" "overwriting the left half blanks the right"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 1 1) width)) 1 "right half is a normal blank"))
    (expr (call (. t go) "~[3;4H\xe4\xb8\xad"))
    (expr (call eq (call (. t dump)) "abcd\ny\n   \xe4\xb8\xad" "wide char in the last two columns"))
    (expr (call ok (. (. t g) wrapPending) "pending after it"))
    (expr (call (. t go) "~[2J~[H~[4hab~[H\xe4\xb8\xad"))
    (expr (call eq (call (. t dump)) "\xe4\xb8\xadab\n\n" "insert mode shifts the row right by the width"))
    (expr (call (. t go) "~[4l~[2J~[Hab\xe4\xb8\xadd~[1;4H~[P"))
    (expr (call eq (call (. t dump)) "ab d\n\n" "DCH through the left half of a wide char blanks it"))
    (expr (call (. t go) "~[2J~[H~[1;5H\xe4\xb8\xad"))
    (expr (call eq (call (. t dump)) "\n\xe4\xb8\xad\n" "wide char at the last column wraps"))
    (let u _ (call term a 5 1 0))
    (expr (call (. (. u p) feed) "e" (& (. u g))))
    (let comb _ (call (. Text new) a))
    (expr (call (. comb push) 204))
    (expr (call (. comb push) 129))
    (expr (call (. (. u p) feed) (call (. comb str)) (& (. u g))))
    (expr (call (. u go) "x"))
    (expr (call eq (call (. u dump)) "e\xcc\x81x" "combining mark joins its base, cursor not moved"))))
  (fn altScreen (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 3 4))
    (expr (call (. t go) "~[31mabc\r\ndef"))
    (expr (call cursor (& t) 3 1 "primary"))
    (expr (call (. t go) "~[?1049h"))
    (expr (call ok (call (. (. t g) altScreen)) "alt on"))
    (expr (call eq (call (. t dump)) "\n\n" "alt screen starts blank"))
    (expr (call (. t go) "~[0m~[Hxyz\r\n\r\n\r\n\r\n\r\nlast"))
    (expr (call eq (call (. t dump)) "\n\nlast" "alt content scrolled"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 0 "alt scroll feeds no scrollback"))
    (expr (call (. t go) "~[?1049l"))
    (expr (call ok (! (call (. (. t g) altScreen))) "alt off"))
    (expr (call eq (call (. t dump)) "abc\ndef\n" "primary restored"))
    (expr (call cursor (& t) 3 1 "cursor restored"))
    (expr (call ok (== (. (. (. t g) pen) fg) (call (. Color palette) 1)) "pen restored"))
    (expr (call (. t go) "~[?1049h"))
    (expr (call eq (call (. t dump)) "\n\n" "second visit starts blank again"))
    (expr (call (. t go) "~[?1049l"))
    (expr (call (. t go) "~[?47hq~[?47l"))
    (expr (call eq (call (. t dump)) "abc\ndef\n" "?47 switches without touching primary"))
    (expr (call (. t go) "~[?47h"))
    (expr (call eq (call (. t dump)) "\n   q\n" "?47 keeps the alt content"))
    (expr (call (. t go) "~[?47l~[?1047h"))
    (expr (call eq (call (. t dump)) "\n\n" "?1047 clears on entry"))
    (expr (call (. t go) "~[?1047l"))
    (expr (call ok (! (call (. (. t g) altScreen))) "1047 off"))))
  (fn modes (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 3 0))
    (expr (call ok (&& (call (. (. t g) mode) (. grid MODE_WRAP)) (call (. (. t g) cursorVisible))) "defaults"))
    (expr (call (. t go) "~[?1h~=~[?25l~[?2004h~[?1000;1006;1004h"))
    (expr (call ok (call (. (. t g) mode) (. grid MODE_CURSOR_KEYS)) "cursor keys app"))
    (expr (call ok (call (. (. t g) mode) (. grid MODE_KEYPAD)) "keypad app"))
    (expr (call ok (! (call (. (. t g) cursorVisible))) "cursor hidden"))
    (expr (call ok (&& (&& (&& (call (. (. t g) mode) (. grid MODE_PASTE)) (call (. (. t g) mode) (. grid MODE_MOUSE_CLICK))) (call (. (. t g) mode) (. grid MODE_MOUSE_SGR))) (call (. (. t g) mode) (. grid MODE_FOCUS))) "paste, mouse, focus"))
    (expr (call (. t go) "~[?1l~>~[?25h~[?2004l~[?1000l~[?1002h~[?1003h"))
    (expr (call ok (&& (&& (! (call (. (. t g) mode) (. grid MODE_CURSOR_KEYS))) (! (call (. (. t g) mode) (. grid MODE_KEYPAD)))) (call (. (. t g) cursorVisible))) "reset"))
    (expr (call ok (&& (&& (call (. (. t g) mode) (. grid MODE_MOUSE_DRAG)) (call (. (. t g) mode) (. grid MODE_MOUSE_MOVE))) (! (call (. (. t g) mode) (. grid MODE_MOUSE_CLICK)))) "mouse modes are separate bits"))
    (expr (call (. t go) "~[?7l~[4h~[2;3r~[!p"))
    (expr (call ok (&& (call (. (. t g) mode) (. grid MODE_WRAP)) (! (call (. (. t g) mode) (. grid MODE_INSERT)))) "DECSTR"))
    (expr (call ok (call (. (. t g) mode) (. grid MODE_MOUSE_DRAG)) "DECSTR keeps mouse reporting"))
    (expr (call eqi (. (. t g) top) 0 "DECSTR region"))
    (expr (call (. t go) "abc~c"))
    (expr (call eq (call (. t dump)) "\n\n" "RIS clears"))
    (expr (call ok (! (call (. (. t g) mode) (. grid MODE_MOUSE_DRAG))) "RIS resets modes"))
    (expr (call cursor (& t) 0 0 "RIS homes"))))
  (fn replies (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 5 0))
    (expr (call (. t go) "~[3;5H~[6n"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call mk "~[3;5R" a) "CPR"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call (. t go) "~[5n"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call mk "~[0n" a) "DSR 5"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call (. t go) "~[c~[>c"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call mk "~[?62;22c~[>0;0;0c" a) "DA1 and DA2"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call eqi (call (. (. (. t g) reply) len)) 0 "drained"))
    (expr (call (. t go) "$$"))
    (expr (call eqi (. (. t g) bells) 2 "BEL counted"))
    (let rq _ (fn-lit (params (u (ref Term)) (m string)) _ (block
      (expr (call (. u go) m))
      (expr (call (. (. u p) feed) "$p" (& (. u g)))))))
    (expr (call rq (& t) "~[?2026"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call join (call mk "~[?2026;2" a) "$y" a) "DECRQM 2026 reset"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call (. t go) "~[?2026h"))
    (expr (call rq (& t) "~[?2026"))
    (expr (call rq (& t) "~[?9999"))
    (expr (call eq (call (. (. (. t g) reply) str)) (call join (call join (call mk "~[?2026;1" a) "$y" a) (call join (call mk "~[?9999;0" a) "$y" a) a) "DECRQM 2026 set, unknown mode 0"))
    (expr (call (. (. (. t g) reply) clear)))
    (expr (call ok (call (. (. t g) syncHeld) 1000) "held after ?2026 h"))
    (expr (call ok (call (. (. t g) syncHeld) 1149) "still held before the timeout"))
    (expr (call ok (! (call (. (. t g) syncHeld) 1150)) "released after 150 ms"))
    (expr (call ok (! (call (. (. t g) mode) (. grid MODE_SYNC))) "the timeout clears the mode"))
    (expr (call (. t go) "~[?2026h"))
    (expr (call ok (call (. (. t g) syncHeld) 5000) "held again"))
    (expr (call (. t go) "~[?2026l"))
    (expr (call ok (! (call (. (. t g) syncHeld) 5001)) "?2026 l releases"))))
  (fn textAttrs (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 2 0))
    (expr (call (. t go) "~(0lqqk~(Bq"))
    (expr (call eq (call (. t dump)) "\xe2\x94\x8c\xe2\x94\x80\xe2\x94\x80\xe2\x94\x90q\n" "DEC line drawing"))
    (expr (call (. t go) "~[2J~[H~(0x~(Bx"))
    (expr (call eq (call (. t dump)) "\xe2\x94\x82x\n" "charset back to ASCII"))
    (expr (call (. t go) "~[2J~[H~]2;my title$"))
    (expr (call eq (call (. (. (. t g) title) str)) "my title" "OSC 2"))
    (expr (call (. t go) "~]0;other~\\"))
    (expr (call eq (call (. (. (. t g) title) str)) "other" "OSC 0 with ST"))
    (expr (call (. t go) "~[2J~[H~]8;;http://x.test/a~\\ab~]8;;~\\c~]8;;http://x.test/a~\\d~]8;;http://y~\\e~]8;;~\\"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 0 0) link)) 1 "linked cell"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 2 0) link)) 0 "unlinked cell"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 3 0) link)) 1 "same URI reuses its id"))
    (expr (call eqi (call int (. (call (. (. t g) cell) 4 0) link)) 2 "new URI gets a new id"))
    (expr (call eq (call (. (. t g) linkUri) 1) "http://x.test/a" "linkUri"))
    (expr (call eq (call (. (. t g) linkUri) 2) "http://y" "linkUri 2"))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 256 1024) 1024)))
    (expr (call moves (& a)))
    (expr (call tabs (& a)))
    (expr (call deferredWrap (& a)))
    (expr (call regions (& a)))
    (expr (call origin (& a)))
    (expr (call erase (& a)))
    (expr (call pen (& a)))
    (expr (call wide (& a)))
    (expr (call altScreen (& a)))
    (expr (call modes (& a)))
    (expr (call replies (& a)))
    (expr (call textAttrs (& a)))
    (expr (call printLn "term_grid_test ok")))))
--- stderr
--- exit 0
