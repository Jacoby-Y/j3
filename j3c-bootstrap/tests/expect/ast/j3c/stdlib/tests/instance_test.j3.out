(file (module instance_test)
  (use j3.instance)
  (use j3.instance.Request)
  (use j3.io.printLn)
  (use j3.option.Option)
  (use j3.sys)
  (use j3.sys.panic)
  (const BIG _ 1048576)
  (mod-let NAME string _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "instance_test: FAIL " msg)))
      (expr (call (. sys exit) 1))))))
  (fn ask (params (cmd string) (ms int)) (gen Option string) (block
    (return (call (. instance request) NAME (array-lit "client" cmd) ms))))
  (fn got (params (r (gen Option string)) (want string)) bool (block
    (match r
      (arm (pats (variant Option.Some (bind s))) (block
        (return (== s want))))
      (arm (pats (variant Option.None)) (block
        (return (bool false)))))
    (return (bool false))))
  (fn isNone (params (r (gen Option string))) bool (block
    (match r
      (arm (pats (variant Option.Some (bind s))) (block
        (return (bool false))))
      (arm (pats (variant Option.None)) (block
        (return (bool true)))))
    (return (bool true))))
  (fn sleepMs (params (ms int)) _ (block
    (let t _ (+ (call (. sys monotonicMs)) ms))
    (while (< (call (. sys monotonicMs)) t) (block))))
  (fn client (params) _ (block
    (expr (call ok (call got (call ask "ping" 1000) "pong") "ping"))
    (expr (call ok (call got (call ask "defer" 2000) "late") "deferred reply"))
    (match (call ask "big" 5000)
      (arm (pats (variant Option.Some (bind s))) (block
        (expr (call ok (== (. s len) BIG) "big length"))
        (let good _ (bool true))
        (for i (.. 0 BIG) (block
          (if (!= (index s i) (call u8 (+ 97 (% i 26)))) (block
            (= good (bool false))))))
        (expr (call ok good "big bytes"))))
      (arm (pats (variant Option.None)) (block
        (expr (call ok (bool false) "big")))))
    (let t0 _ (call (. sys monotonicMs)))
    (expr (call ok (call isNone (call ask "never" 200)) "timeout gives None"))
    (let dt _ (- (call (. sys monotonicMs)) t0))
    (expr (call ok (&& (>= dt 190) (< dt 2000)) (interp "timeout took " dt " ms")))
    (let pid _ (call (. sys fork)))
    (if (== pid 0) (block
      (expr (call ask "dead" 0))
      (expr (call (. sys exit) 0))))
    (expr (call sleepMs 100))
    (expr (call (. sys kill) pid (. sys SIGKILL)))
    (let st i32 0)
    (expr (call (. sys waitpid) pid (& st) 0))
    (expr (call ok (call got (call ask "deadseen" 2000) "yes") "server saw the dead client"))
    (expr (call ok (! (call (. instance claim) NAME)) "claim forwards"))
    (let seen _ (bool false))
    (let t1 _ (call (. sys monotonicMs)))
    (while (&& (! seen) (< (- (call (. sys monotonicMs)) t1) 2000)) (block
      (= seen (call got (call ask "msgseen" 2000) "yes"))
      (if (! seen) (block
        (expr (call sleepMs 10))))))
    (expr (call ok seen "message arrived"))
    (expr (call ask "quit" 1000))
    (expr (call (. sys exit) 0))))
  (fn main (params) _ (block
    (= NAME (interp "itest-" (call (. sys getpid))))
    (expr (call ok (call isNone (call (. instance request) NAME (array-lit "client" "ping") 200)) "no copy running"))
    (expr (call ok (call (. instance claim) NAME) "claim"))
    (let pid _ (call (. sys fork)))
    (if (== pid 0) (block
      (expr (call client))))
    (let waiting _ (struct-lit Request (field slot (- 0 1)) (field gen 0)))
    (let waitFrames _ 0)
    (let dead _ (struct-lit Request (field slot (- 0 1)) (field gen 0)))
    (let msgSeen _ (bool false))
    (let quit _ (bool false))
    (let big _ "")
    (let frames _ 0)
    (while (! quit) (block
      (+= frames 1)
      (expr (call ok (< frames 20000) "server ran too long"))
      (while (call (. instance next)) (block
        (= msgSeen (&& (> (. (call (. instance args)) len) 0) (!= (index (call (. instance args)) 0) "client")))))
      (let more _ (bool true))
      (while more (block
        (match (call (. instance nextRequest))
          (arm (pats (variant Option.Some (bind req))) (block
            (let cmd _ (index (call (. req args)) 1))
            (if (== cmd "ping") (block
              (expr (call (. req reply) "pong"))
              (expr (call (. req reply) "twice is a no-op"))) (block
              (if (== cmd "defer") (block
                (= waiting req)
                (= waitFrames 0)) (block
                (if (== cmd "dead") (block
                  (= dead req)) (block
                  (if (== cmd "never") (block) (block
                    (if (== cmd "deadseen") (block
                      (expr (call (. req reply) (if-expr (! (call (. dead alive))) "yes" "no")))) (block
                      (if (== cmd "msgseen") (block
                        (expr (call (. req reply) (if-expr msgSeen "yes" "no")))) (block
                        (if (== cmd "quit") (block
                          (expr (call (. req reply) ""))
                          (= quit (bool true))) (block
                          (if (== cmd "big") (block
                            (let b (slice u8) (slice-from (call (. sys mmapAnon) BIG) BIG))
                            (for i (.. 0 BIG) (block
                              (= (index b i) (call u8 (+ 97 (% i 26))))))
                            (expr (call (. req reply) (as b string)))))))))))))))))))))
          (arm (pats (variant Option.None)) (block
            (= more (bool false)))))))
      (if (call (. waiting alive)) (block
        (+= waitFrames 1)
        (if (== waitFrames 30) (block
          (expr (call (. waiting reply) "late"))
          (expr (call ok (! (call (. waiting alive))) "replied is not alive"))))))
      (expr (call sleepMs 2))))
    (let st i32 0)
    (expr (call (. sys waitpid) pid (& st) 0))
    (expr (call ok (== (call (. sys exitCode) st) 0) "client checks"))
    (expr (call (. dead reply) "nobody hears this"))
    (expr (call ok (! (call (. dead alive))) "dead stays dead"))
    (expr (call printLn "instance_test ok")))))
--- stderr
--- exit 0
