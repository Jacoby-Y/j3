(file (module testkit_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (mod-let CHECKS int _)
  (mod-let STATE St _)
  (struct St
    (field clicks int 0)
    (field ok int 0)
    (field name string "")
    (field gone bool (bool false)))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string "button { width: 80px; height: 24px; } input { width: 120px; height: 24px; } dialog { width: 200px; height: 80px; } .gone { display: none; } .far { position: absolute; left: 900px; top: 0px; }")
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let b _ (call (. d open) 1 (call (. d tag) "button") 1))
    (expr (call (. d text) "Go"))
    (if (call (. d clicked) b) (block
      (+= (. STATE clicks) 1)))
    (expr (call (. d close)))
    (let tb _ (call (. d open) 2 (call (. d tag) "input") 1))
    (expr (call (. d attrType) tb "text"))
    (if (call (. d changed) tb) (block
      (= (. STATE name) (call (. d strValue) tb))))
    (expr (call (. d attrText) tb (. STATE name)))
    (expr (call (. d close)))
    (expr (call (. d open) 3 (call (. d tag) "dialog") 1))
    (let b2 _ (call (. d open) 0 (call (. d tag) "button") 1))
    (if (. STATE gone) (block
      (expr (call (. d cls) b2 "gone"))))
    (expr (call (. d text) "Go2"))
    (if (call (. d clicked) b2) (block
      (+= (. STATE ok) 1)))
    (expr (call (. d close)))
    (let b3 _ (call (. d open) 1 (call (. d tag) "button") 1))
    (expr (call (. d text) "Go"))
    (if (call (. d clicked) b3) (block
      (+= (. STATE ok) 100)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (let hb _ (call (. d open) 4 (call (. d tag) "button") 1))
    (expr (call (. d cls) hb "gone"))
    (expr (call (. d text) "Hidden"))
    (if (call (. d clicked) hb) (block
      (+= (. STATE clicks) 1000)))
    (expr (call (. d close)))
    (let fb _ (call (. d open) 5 (call (. d tag) "button") 1))
    (expr (call (. d cls) fb "far"))
    (expr (call (. d text) "Far"))
    (if (call (. d clicked) fb) (block
      (+= (. STATE clicks) 1000)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= STATE (struct-lit St))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (&& (call (. testkit hasText) (& d) "Go") (! (call (. testkit hasText) (& d) "Nope"))) "hasText"))
    (expr (call ok (== (call (. testkit countText) (& d) "Go") 2) "countText"))
    (expr (call ok (&& (>= (call (. testkit tagNode) (& d) "button" 2) 0) (< (call (. testkit tagNode) (& d) "button" 4) 0)) "tagNode counts elements in order"))
    (expr (call ok (&& (>= (call (. testkit textNodeIn) (& d) "dialog" "Go") 0) (< (call (. testkit textNodeIn) (& d) "div" "Nope") 0)) "textNodeIn"))
    (for f (.. 1 8) (block
      (expr (call (. testkit clickText) (& d) f 2 "Go"))
      (expr (call frame (& d)))
      (if (|| (== f 2) (== f 3)) (block
        (expr (call ok (== (. STATE clicks) 0) "no click before the release"))))))
    (expr (call ok (== (. STATE clicks) 1) "clickText clicks once (the first text)"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickTextIn) (& d) f 1 "dialog" "Go2"))
      (expr (call frame (& d)))))
    (expr (call ok (== (. STATE ok) 1) "clickTextIn finds the text inside the dialog"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickTag) (& d) f 1 "button" 2))
      (expr (call frame (& d)))))
    (expr (call ok (== (. STATE ok) 101) "clickTag clicks the k-th element"))
    (for f (.. 1 9) (block
      (expr (call (. testkit typeInto) (& d) f 1 "input" 0 "hello"))
      (expr (call frame (& d)))))
    (expr (call ok (&& (>= (call (. d focused)) 0) (== (. (. STATE name) len) 5)) "typeInto focuses the input and types"))
    (for f (.. 1 6) (block
      (expr (call (. testkit simKeys) (& d) f 2 "" "C+a Backspace"))
      (expr (call frame (& d)))))
    (expr (call ok (== (. (. STATE name) len) 0) "two key names in one frame"))
    (expr (call ok (== (call (. testkit misses)) 0) "no misses so far"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickText) (& d) f 1 "Nowhere"))
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (call (. testkit misses)) 1) (== (. STATE clicks) 1)) "a missing target is one miss over its three frames and clicks nothing"))
    (expr (call ok (&& (! (call (. testkit hasText) (& d) "Hidden")) (call (. testkit hasText) (& d) "Far")) "hasText skips display: none"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickText) (& d) f 1 "Hidden"))
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (call (. testkit misses)) 2) (== (. STATE clicks) 1)) "a display: none target is a miss, not a click"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickText) (& d) f 1 "Far"))
      (expr (call frame (& d)))))
    (expr (call ok (&& (== (call (. testkit misses)) 3) (== (. STATE clicks) 1)) "an off-screen target is a miss, not a click"))
    (for f (.. 1 6) (block
      (expr (call (. testkit clickText) (& d) f 1 "Go2"))
      (= (. STATE gone) (bool true))
      (expr (call frame (& d)))))
    (expr (call ok (== (call (. testkit misses)) 4) "a target gone mid-click counts once"))
    (expr (call (. testkit resetMisses)))
    (expr (call ok (== (call (. testkit misses)) 0) "resetMisses starts again"))
    (for f (.. 1 9) (block
      (expr (call (. testkit clickText) (& d) f 3 "A"))
      (expr (call (. testkit clickText) (& d) f 6 "B"))
      (expr (call frame (& d)))))
    (expr (call ok (== (call (. testkit misses)) 2) "two missing targets back to back count twice"))
    (expr (call (. testkit click) (& d) 1 1 (- 1)))
    (expr (call ok (== (call (. testkit misses)) 3) "click on a bad id is a miss"))
    (expr (call printLn (interp "all passed (" CHECKS " checks)"))))))
--- stderr
--- exit 0
