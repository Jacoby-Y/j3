(file (module dragout_test)
  (use j3.game)
  (use j3.game.DragState)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (fn main (params) _ (block
    (expr (call (. game init) "dragout" 64 64))
    (expr (call (. game poll)))
    (if (call (. game dragFiles) (array-lit "/tmp/x.png")) (block
      (expr (call panic "dragout: drag started headless"))))
    (expr (call (. game poll)))
    (if (!= (call (. game dragState)) (. DragState Idle)) (block
      (expr (call panic "dragout: state not Idle"))))
    (expr (call printLn "dragout ok")))))
--- stderr
--- exit 0
