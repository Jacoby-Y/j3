(file (module a11y_bounds_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.a11y)
  (use j3.ui.a11y.Rect)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CHECKS int _)
  (mod-let W World _)
  (struct World
    (field mode int 0)
    (field spacer f32 (float 0x0000000000000000))
    (field withNode bool (bool true))
    (field box int (- 1))
    (field node int (- 1))
    (field hover int (- 2))
    (field px f32 (- (float 0x4014000000000000)))
    (field py f32 (- (float 0x4014000000000000))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string "button { width: 80px; height: 30px; } .sc { width: 100px; height: 50px; overflow: scroll; } .pad { height: 100px; } .off { margin-left: 100px; margin-top: 60px; } .big { transform: scale(2); } .rot { transform: rotate(45deg); }")
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (. W px) (. W py) (bool false) (float 0x0000000000000000)))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4082c00000000000)) (field y (float 0x4079000000000000)))))
    (= (. W hover) (. d hover))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let sp _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d styleNum) sp 0 "height" (+ (. W spacer) (float 0x403e000000000000))))
    (expr (call (. d close)))
    (if (== (. W mode) 0) (block
      (= (. W box) (call (. d open) 1 (call (. d tag) "div") 1))
      (expr (call (. d cls) (. W box) "sc"))
      (expr (call (. d open) 0 (call (. d tag) "div") 1))
      (let pd _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) pd "pad"))
      (expr (call (. d close)))
      (= (. W node) (call (. d open) 1 (call (. d tag) "button") 1))
      (expr (call (. d text) "x"))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call (. d close)))) (block
      (if (. W withNode) (block
        (= (. W node) (call (. d open) 2 (call (. d tag) "button") 1))
        (expr (call (. d cls) (. W node) "off"))
        (if (== (. W mode) 1) (block
          (expr (call (. d cls) (. W node) "big"))))
        (if (== (. W mode) 2) (block
          (expr (call (. d cls) (. W node) "rot"))))
        (if (== (. W mode) 3) (block
          (expr (call (. d trans) (. W node) 4 (float 0x4079000000000000) 0 (float 0x0000000000000000) (- 1) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3fe0000000000000) 0))))
        (if (== (. W mode) 4) (block
          (expr (call (. d flip) (. W node) (float 0x408f400000000000) 0))))
        (expr (call (. d text) "x"))
        (expr (call (. d close)))))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn mk (params (mem (ref Arena)) (css (ref Css))) Dom (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (return d)))
  (fn (doc "The center of `id`'s bounds hits `id` on the next frame.") centerHits (params (d (ref Dom)) (msg string)) Rect (block
    (let r _ (call (. a11y bounds) d (. W node)))
    (expr (call ok (. r ok) (interp msg ": has bounds")))
    (= (. W px) (+ (. r x) (* (. r w) (float 0x3fe0000000000000))))
    (= (. W py) (+ (. r y) (* (. r h) (float 0x3fe0000000000000))))
    (expr (call frame d))
    (expr (call ok (== (. W hover) (. W node)) (interp msg ": the center of the bounds hits the node (hover " (. W hover) ", node " (. W node) ", rect " (. r x) "," (. r y) " " (. r w) "x" (. r h) ")")))
    (= (. W px) (- (float 0x4014000000000000)))
    (= (. W py) (- (float 0x4014000000000000)))
    (return r)))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (= W (struct-lit World))
    (let d _ (call mk (& mem) (& css)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let r0 _ (call (. a11y bounds) (& d) (. W node)))
    (expr (call (. d scrollTo) (. W box) (float 0x0000000000000000) (float 0x4054000000000000) (bool false)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let r1 _ (call centerHits (& d) "scrolled"))
    (expr (call ok (== (. r1 y) (- (. r0 y) (float 0x4054000000000000))) "bounds follow the scroll offset"))
    (= W (struct-lit World (field mode 1)))
    (let d1 _ (call mk (& mem) (& css)))
    (expr (call frame (& d1)))
    (expr (call frame (& d1)))
    (let r2 _ (call centerHits (& d1) "scale"))
    (expr (call ok (&& (&& (&& (> (. r2 w) (float 0x4063e00000000000)) (< (. r2 w) (float 0x4064200000000000))) (> (. r2 h) (float 0x404d800000000000))) (< (. r2 h) (float 0x404e800000000000))) "scale(2) doubles the bounds"))
    (= W (struct-lit World (field mode 2)))
    (let d2 _ (call mk (& mem) (& css)))
    (expr (call frame (& d2)))
    (expr (call frame (& d2)))
    (let r3 _ (call centerHits (& d2) "rotate"))
    (expr (call ok (&& (&& (&& (> (. r3 w) (float 0x4053400000000000)) (< (. r3 w) (float 0x4053c00000000000))) (> (. r3 h) (float 0x4053400000000000))) (< (. r3 h) (float 0x4053c00000000000))) "rotate(45deg) of 80x30 is a 78x78 box"))
    (= W (struct-lit World (field mode 3) (field withNode (bool false))))
    (let d3 _ (call mk (& mem) (& css)))
    (expr (call frame (& d3)))
    (expr (call frame (& d3)))
    (= (. W withNode) (bool true))
    (expr (call frame (& d3)))
    (expr (call frame (& d3)))
    (let full _ (call (. d3 size) (. W node)))
    (let r4 _ (call centerHits (& d3) "transition scale"))
    (expr (call ok (&& (< (. r4 w) (* (. full x) (float 0x3fee666666666666))) (> (. r4 w) (* (. full x) (float 0x3fd999999999999a)))) "a scale transition shrinks the bounds"))
    (= W (struct-lit World (field mode 4)))
    (let d4 _ (call mk (& mem) (& css)))
    (expr (call frame (& d4)))
    (expr (call frame (& d4)))
    (= (. W spacer) (float 0x404e000000000000))
    (expr (call frame (& d4)))
    (expr (call frame (& d4)))
    (let r5 _ (call centerHits (& d4) "flip"))
    (expr (call ok (!= (. r5 y) (call (. d4 absY) (. W node))) "the flip offset is in the bounds"))
    (expr (call printLn (interp "a11y_bounds_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
