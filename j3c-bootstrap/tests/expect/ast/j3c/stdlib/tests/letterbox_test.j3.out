(file (module letterbox_test)
  (use j3.game.letterbox (names fit glRect toVirtual toWindow))
  (use j3.io.printLn)
  (use j3.math.abs)
  (use j3.sys.panic)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic "letterbox_test"))))))
  (fn near (params (a f32) (b f32)) bool (block
    (return (< (call abs (- a b)) (float 0x3fe0000000000000)))))
  (fn main (params) _ (block
    (let r _ (call fit 1400 700 0 0))
    (expr (call ok (&& (&& (&& (&& (== (. r x) 0) (== (. r y) 0)) (== (. r w) 1400)) (== (. r h) 700)) (== (. r s) (float 0x3ff0000000000000))) "off"))
    (let v _ (call toVirtual r 30 40))
    (expr (call ok (&& (call near (. v x) 30) (call near (. v y) 40)) "off map"))
    (= r (call fit 1400 700 1920 1080))
    (expr (call ok (&& (&& (&& (== (. r h) 700) (== (. r w) 1244)) (== (. r x) 78)) (== (. r y) 0)) "pillarbox rect"))
    (expr (call ok (call near (. r s) (/ (call f32 700) (call f32 1080))) "pillarbox scale"))
    (= v (call toVirtual r 78 0))
    (expr (call ok (&& (call near (. v x) 0) (call near (. v y) 0)) "rect corner is virtual origin"))
    (= v (call toVirtual r 700 350))
    (expr (call ok (&& (call near (. v x) 960) (call near (. v y) 540)) "window center is virtual center"))
    (= v (call toVirtual r 10 350))
    (expr (call ok (< (. v x) 0) "a click in the left bar is negative, not clamped"))
    (= v (call toVirtual r 1390 350))
    (expr (call ok (> (. v x) 1920) "a click in the right bar is past the width"))
    (let w _ (call toWindow r 960 540))
    (expr (call ok (&& (call near (. w x) 700) (call near (. w y) 350)) "to window"))
    (= r (call fit 1000 900 1920 1080))
    (expr (call ok (&& (&& (&& (== (. r w) 1000) (== (. r h) 563)) (== (. r x) 0)) (== (. r y) 168)) "letterbox rect"))
    (= r (call fit 960 540 1920 1080))
    (expr (call ok (&& (&& (&& (&& (== (. r x) 0) (== (. r y) 0)) (== (. r w) 960)) (== (. r h) 540)) (call near (. r s) (float 0x3fe0000000000000))) "exact fit"))
    (= r (call fit 1 700 1920 1080))
    (expr (call ok (&& (&& (&& (== (. r w) 1) (>= (. r h) 1)) (<= (. r h) 700)) (== (. r x) 0)) "1px wide window"))
    (= r (call fit 1400 0 1920 1080))
    (expr (call ok (&& (&& (== (. r h) 1) (>= (. r w) 1)) (<= (. r w) 1400)) "0px tall window"))
    (= r (call fit 1400 700 1920 1080))
    (let g _ (call glRect r 700 0 0 1920 1080))
    (expr (call ok (&& (&& (&& (== (. g x) 78) (== (. g y) 0)) (== (. g w) 1244)) (== (. g h) 700)) "full rect in GL"))
    (let a _ (call glRect r 700 0 0 (float 0x4059200000000000) (float 0x4059200000000000)))
    (let b _ (call glRect r 700 (float 0x4059200000000000) 0 (float 0x4059200000000000) (float 0x4059200000000000)))
    (expr (call ok (== (+ (. a x) (. a w)) (. b x)) "adjacent rects meet without a seam"))
    (let t _ (call glRect r 700 0 0 (float 0x3fb999999999999a) (float 0x3fb999999999999a)))
    (expr (call ok (&& (>= (. t w) 1) (>= (. t h) 1)) "a tiny rect keeps one pixel"))
    (expr (call printLn "letterbox_test ok")))))
--- stderr
--- exit 0
