(file (module input_test)
  (use j3.game)
  (use j3.game.fontLine)
  (use j3.game.Font)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names same Text))
  (use j3.ui.colorpick)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.csv)
  (use j3.ui.dom (names Dom fontOf isBold))
  (use j3.ui.inputs)
  (use j3.ui.keys)
  (use j3.ui.dropdown)
  (use j3.ui.popup)
  (use j3.ui.slider)
  (use j3.ui.area)
  (use j3.ui.field)
  (use j3.ui.rich)
  (use j3.ui.textedit)
  (use j3.ui.textsel)
  (use j3.ui.spans (names covered isToken Span spanEdit SPAN_BOLD SPAN_COLOR SPAN_EMOJI SPAN_ITALIC SPAN_LINK SPAN_MENTION))
  (use j3.ui.textedit (names Edit UNDO_BYTES UNDO_CAP))
  (use j3.memory.List)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call testPercentageEdges (& mem)))
    (expr (call testEdit (& mem)))
    (expr (call testKeys))
    (expr (call testCsv))
    (expr (call testSlider))
    (expr (call testColor (& mem)))
    (expr (call testPopup))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "input.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "the test sheet parses with no warning"))
    (expr (call testFlow (& mem) (& css)))
    (expr (call testManyOptions (& mem) (& css)))
    (expr (call testArea (& mem) (& css)))
    (expr (call testPrimary (& mem) (& css)))
    (expr (call testUndo (& mem) (& css)))
    (expr (call testRich (& mem) (& css)))
    (expr (call testCaret (& mem) (& css)))
    (expr (call testTwoBoxes (& mem) (& css)))
    (expr (call testFocusHook (& mem) (& css)))
    (expr (call testSelect (& mem) (& css)))
    (expr (call testEmojiCaret (& mem)))
    (expr (call testRtlInput (& mem)))
    (expr (call testRtlRich (& mem)))
    (expr (call testLigatureBounds))
    (expr (call printLn (interp "input_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
