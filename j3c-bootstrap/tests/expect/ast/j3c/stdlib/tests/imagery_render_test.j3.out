(file (module imagery_render_test)
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.canvas (names Canvas Mode rgba))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let CHECKS int _)
  (const W int 400)
  (const H int 300)
  (const SHEET string ".stage { display: block; width: 400px; height: 300px; } .box { width: 300px; height: 200px; } .one { background: url(/tmp/j3-img-a.png); } .frame { border: 16px solid transparent; border-image: url(/tmp/j3-img-a.png) 8 fill / 16px repeat; } .round { border-image-repeat: round; } .layers { background: url(/tmp/j3-img-a.png) 0 0 / 8px 8px repeat, url(/tmp/j3-img-b.png) 0 0 / 8px 8px repeat; } .space { background: url(/tmp/j3-img-a.png) 0 0 / 10px 10px space; }")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn png (params (mem (ref Arena)) (path string) (w i32) (h i32) (c u8)) _ (block
    (let image _ (call (. Canvas create) mem w h (. Mode Pixel)))
    (expr (call (. image clear) (call rgba c (- 200 c) 128 255)))
    (match (call (. image savePng) path mem)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save image fixture")))))))
  (fn (doc "Draw calls one box with `cls` costs (the images are loaded by an earlier frame, so uploads do not count).") draws (params (d (ref Dom)) (cls string)) int (block
    (let n _ 0)
    (for pass (.. 0 2) (block
      (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
      (expr (call (. d beginFrame) (struct-lit Vec2 (field x (call f32 W)) (field y (call f32 H)))))
      (let stage _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) stage "stage"))
      (let box _ (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) box "box"))
      (expr (call (. d cls) box cls))
      (expr (call (. d close)))
      (expr (call (. d close)))
      (expr (call (. d layout)))
      (let before _ (call (. game drawsNow)))
      (expr (call (. d paintAll)))
      (expr (call (. game p2Flush)))
      (= n (- (call (. game drawsNow)) before))
      (expr (call (. d endFrame)))))
    (return n)))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call (. game initGlHidden) "imagery draw counts" W H))
    (expr (call png (& mem) "/tmp/j3-img-a.png" 24 24 60))
    (expr (call png (& mem) "/tmp/j3-img-b.png" 8 8 150))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "imagery.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "imagery fixture CSS parses"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d simInput) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (let one _ (call draws (& d) "one"))
    (expr (call printLn (interp "one stretched url background: " one " draw(s)")))
    (expr (call ok (== one 1) "a single url background is one draw"))
    (let frame _ (call draws (& d) "frame"))
    (expr (call printLn (interp "repeat frame: " frame " draw(s)")))
    (expr (call ok (== frame 1) "a repeat border-image frame is one draw"))
    (let round _ (call draws (& d) "frame round"))
    (expr (call ok (== round 1) "a round border-image frame is one draw"))
    (let layers _ (call draws (& d) "layers"))
    (expr (call printLn (interp "two tiled layers: " layers " draw(s)")))
    (expr (call ok (<= layers 2) "two tiled url layers cost at most one draw each"))
    (let space _ (call draws (& d) "space"))
    (expr (call ok (== space 1) "a space background is one draw"))
    (expr (call printLn (interp "imagery_render_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
