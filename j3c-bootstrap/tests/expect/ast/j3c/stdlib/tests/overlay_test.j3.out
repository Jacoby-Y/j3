(file (module overlay_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css (names Css P_BACKGROUND P_BOX_SHADOW P_FONT_SIZE V_SHADOW))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.dropdown)
  (use j3.ui.colorpick)
  (use j3.ui.inputs)
  (use j3.ui.overlays)
  (use j3.ui.popup)
  (use j3.ui.scroll)
  (use j3.ui.scrollbar)
  (use j3.ui.scrollbar.Bars)
  (use j3.ui.toast.Toasts)
  (use j3.ui.uastyle)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp msg ": " a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 256 1024) 1024)))
    (expr (call testMath))
    (expr (call testToast (& mem)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "overlay.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "the test sheet parses with no warning"))
    (expr (call testScroll (& mem) (& css)))
    (expr (call testInertia (& mem) (& css)))
    (expr (call testBars (& mem) (& css)))
    (expr (call testLongList (& mem) (& css)))
    (expr (call testModal (& mem) (& css)))
    (expr (call testBackdropAndRemoval (& mem) (& css)))
    (expr (call testPopover (& mem) (& css)))
    (expr (call testPlacement (& mem) (& css)))
    (expr (call testTooltip (& mem) (& css)))
    (expr (call testMenuKeys (& mem)))
    (expr (call testSelect (& mem)))
    (expr (call testSelectInModal (& mem)))
    (expr (call testSelectTheme (& mem)))
    (expr (call testSelectRem (& mem)))
    (expr (call testSelectBig (& mem)))
    (expr (call testRuntimePopups (& mem)))
    (expr (call testDialogInputs (& mem) (& css)))
    (expr (call printLn (interp "overlay_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
