(file (module arena_size_test)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.memory.Arena)
  (fn main (params) _ (block
    (let a _ (call (. Arena create) 1024))
    (if (|| (!= (call (. a reserved)) 1024) (!= (call (. a usedTotal)) 0)) (block
      (expr (call panic "fresh arena"))))
    (expr (call (. a allocBytes) 800))
    (expr (call (. a allocBytes) 800))
    (expr (call (. a allocBytes) 1600))
    (if (!= (call (. a reserved)) (+ (+ 1024 2048) 4096)) (block
      (expr (call panic "reserved is the sum of the chunks"))))
    (if (< (call (. a usedTotal)) 3200) (block
      (expr (call panic "usedTotal covers every allocation"))))
    (expr (call (. a destroy)))
    (if (|| (!= (call (. a reserved)) 0) (!= (call (. a usedTotal)) 0)) (block
      (expr (call panic "zero after destroy"))))
    (expr (call printLn "arena_size_test: ok")))))
--- stderr
--- exit 0
