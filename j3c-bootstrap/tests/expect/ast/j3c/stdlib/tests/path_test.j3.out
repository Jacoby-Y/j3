(file (module path_test)
  (use j3.io.printLn)
  (use j3.sys (names panic monotonicMs))
  (use j3.game.path)
  (use j3.memory (names scratch rewindScratch))
  (fn (doc "`n` x `n` open grid with column `n/2` blocked for y < `wall`.") grid (params (n int) (wall int)) (slice u8) (block
    (let c _ (call (. (call scratch 1) alloc) (targs u8) (* n n)))
    (for i (.. 0 (* n n)) (block
      (= (index c i) 0)))
    (for y (.. 0 wall) (block
      (= (index c (+ (* y n) (/ n 2))) 1)))
    (return c)))
  (fn main (params) _ (block
    (let sizes _ (array-lit 64 65 100 192 256))
    (for k (.. 0 5) (block
      (let n _ (index sizes k))
      (let wall _ (- (- n (/ n 20)) 1))
      (let c _ (call grid n wall))
      (let t0 _ (call monotonicMs))
      (let p _ (call (. path search) c n n 0 0 (- n 1) 0 0 0))
      (if (|| (|| (== (. p len) 0) (!= (index p 0) 0)) (!= (index p (- (. p len) 1)) (- n 1))) (block
        (expr (call panic (interp "no path at " n)))))
      (if (!= (. p len) (+ (* 2 wall) n)) (block
        (expr (call panic (interp "path at " n " has " (. p len) " cells, want " (+ (* 2 wall) n))))))
      (let around _ (bool false))
      (for i (.. 0 (. p len)) (block
        (if (&& (== (% (index p i) n) (/ n 2)) (>= (/ (index p i) n) wall)) (block
          (= around (bool true))))))
      (if (! around) (block
        (expr (call panic (interp "path at " n " does not go around the wall")))))
      (if (== n 192) (block
        (expr (call printLn (interp "192x192 detour: " (- (call monotonicMs) t0) " ms, " (. p len) " cells")))))
      (expr (call rewindScratch))))
    (let c _ (call grid 192 0))
    (let g _ (+ (* 100 192) 100))
    (= (index c (- g 1)) 1)
    (= (index c (+ g 1)) 1)
    (= (index c (- g 192)) 1)
    (= (index c (+ g 192)) 1)
    (if (!= (. (call (. path search) c 192 192 0 0 100 100 0 0) len) 0) (block
      (expr (call panic "walled-off goal returned a path"))))
    (expr (call printLn "path_test ok")))))
--- stderr
--- exit 0
