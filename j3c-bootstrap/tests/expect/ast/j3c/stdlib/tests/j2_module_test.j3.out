(file (module j2_module_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Args Value Limits Ref))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (const NSRC int 6)
  (struct (doc "The \"files\" a `use` may name, and the exports of the ones loaded (kept).") Lib
    (field loaded (array 6 Ref))
    (field out Text))
  (const NAMES (array 6 string) (array-lit "a" "b" "e" "c" "d" "self"))
  (const SRCS (array 6 string) (array-lit "pub let wave = 1;\npub const MAX = 3;\npub fn next() { wave += 1; return wave; }\npub fn twice(x) { return x * 2; }\npub fn six() { return (3).twice(); }" "use a;\npub fn get() { return a.wave; }\npub fn mod() { return a; }" "use a;\npub fn mod() { return a; }" "use d;\npub let x = 1;" "use c;\npub let y = 2;" "use self;"))
  (fn libOf (params (vm (ref Vm))) (ref Lib) (block
    (return (as (. vm host) (ref Lib)))))
  (fn capture (params (vm (ref Vm)) (args Args)) Value (block
    (let l _ (call libOf vm))
    (expr (call (. (. l out) pushStr) (call (. args joined) " ")))
    (expr (call (. (. l out) push) 10))
    (return (call (. j2 nil)))))
  (fn (doc "Loads a script by name the first time it is used and hands back the same exports after.") resolve (params (_ctx ptr) (vm (ref Vm)) (name string)) Value (block
    (let l _ (call libOf vm))
    (for i (.. 0 NSRC) (block
      (if (== (index NAMES i) name) (block
        (let have _ (call (. vm value) (index (. l loaded) i)))
        (if (! (call (. have isNil))) (block
          (return have)))
        (match (call (. vm loadString) name (index SRCS i))
          (arm (pats (variant Result.Ok (bind t))) (block
            (= (index (. l loaded) i) (call (. vm keep) t))
            (return t)))
          (arm (pats (variant Result.Err (bind e))) (block
            (return (call (. vm raise) (. e message))))))))))
    (return (call (. vm raise) "no such script"))))
  (fn check (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn call0 (params (vm (ref Vm)) (t Value) (name string)) Value (block
    (match (call (. vm call) (call (. (call (. t asTable)) get) name) (slice-from (as 0 ptr) 0))
      (arm (pats (variant Result.Ok (bind v))) (block
        (return v)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "call")))))))
  (fn loadOk (params (vm (ref Vm)) (name string) (src string)) Value (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (bind t))) (block
        (expr (call (. vm keep) t))
        (return t)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "unexpected load error")))))))
  (fn loadErr (params (vm (ref Vm)) (name string) (src string)) string (block
    (match (call (. vm loadString) name src)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "expected a load error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (return (. e message)))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (let l _ (struct-lit Lib (field loaded (array-lit (call (. j2 none)) (call (. j2 none)) (call (. j2 none)) (call (. j2 none)) (call (. j2 none)) (call (. j2 none)))) (field out (call (. Text new) (& mem)))))
    (let vm _ (call (. Vm new) (& mem) (struct-lit Limits)))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" capture))
    (= (. vm host) (as (& l) ptr))
    (= (. vm resolver) resolve)
    (let b _ (call loadOk (& vm) "b" "use a;\npub fn get() { return a.wave; }"))
    (let a _ (call (. vm value) (index (. l loaded) 0)))
    (if (!= (. (call call0 (& vm) b "get") bits) 1) (block
      (expr (call panic "first read"))))
    (if (!= (. (call call0 (& vm) a "next") bits) 2) (block
      (expr (call panic "next"))))
    (if (!= (. (call call0 (& vm) b "get") bits) 2) (block
      (expr (call panic "B sees A's write"))))
    (expr (call (. (call (. a asTable)) set) "wave" (call (. j2 int) 10)))
    (if (!= (. (call call0 (& vm) a "next") bits) 11) (block
      (expr (call panic "A sees the host's write to its exports"))))
    (if (|| (!= (call (. (call (. a asTable)) getNum) "MAX" (float 0x0000000000000000)) (float 0x4008000000000000)) (!= (. (call call0 (& vm) a "six") bits) 6)) (block
      (expr (call panic "pub const, pub fn fallback"))))
    (let e _ (call loadOk (& vm) "e" "use a;\npub fn mod() { return a; }"))
    (let b2 _ (call loadOk (& vm) "b2" "use a;\npub fn mod() { return a; }"))
    (if (|| (! (call (. j2 same) (call call0 (& vm) e "mod") (call call0 (& vm) b2 "mod"))) (! (call (. j2 same) (call call0 (& vm) e "mod") a))) (block
      (expr (call panic "use reuses exports"))))
    (let fresh _ (call loadOk (& vm) "a" (index SRCS 0)))
    (if (|| (call (. j2 same) fresh a) (!= (call (. (call (. fresh asTable)) getNum) "wave" (float 0x0000000000000000)) (float 0x3ff0000000000000))) (block
      (expr (call panic "reload is fresh"))))
    (if (!= (. (call call0 (& vm) b "get") bits) 11) (block
      (expr (call panic "old users keep the old module"))))
    (expr (call check (call loadErr (& vm) "c" (index SRCS 3)) "c:1:1: d:1:1: use cycle: c -> d -> c" "cycle"))
    (expr (call check (call loadErr (& vm) "self" "use self;") "self:1:1: use cycle: self -> self" "self cycle"))
    (expr (call check (call loadErr (& vm) "x" "let k = 1;\nuse nothing;") "x:2:1: no such script" "resolver raise"))
    (expr (call check (call loadErr (& vm) "t" "let x = 1;\nfn f() {\n    spwan(x);\n}") "t:3:5: unknown name \"spwan\"" "typo"))
    (expr (call check (call loadErr (& vm) "t" "pub const K = 1;\nfn f() { K = 2; }") "t:2:10: can't assign to const \"K\"" "pub const"))
    (expr (call check (call loadErr (& vm) "t" "print = 1;") "t:1:1: can't assign to the host's \"print\"" "host name"))
    (expr (call check (call loadErr (& vm) "t" "fn f() { use a; }") "t:1:10: `use` is only allowed at the top level" "nested use"))
    (let h _ (call loadOk (& vm) "h" "let n = 1;\nprint(later(2));\npub fn later(x) { return helper(x) + n; }\nfn helper(x) { return x * 10; }\npub let shown = 5;"))
    (expr (call check (call (. (. l out) str)) "21\n" "hoisting"))
    (if (|| (!= (call (. (call (. h asTable)) count)) 2) (! (call (. (call (. (call (. h asTable)) get) "helper") isNil)))) (block
      (expr (call panic "exports hold only pub names"))))
    (let mem2 _ (call (. Arena create) (<< 1 16)))
    (let bare _ (call (. Vm new) (& mem2) (struct-lit Limits)))
    (match (call (. bare loadString) "u" "use a;")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "use with no resolver"))))
      (arm (pats (variant Result.Err (bind err))) (block
        (expr (call check (. err message) "u:1:1: use a: this host loads no other scripts (vm.resolver is not set)" "no resolver")))))
    (expr (call (. bare destroy)))
    (match (call (. vm loadFile) "gone" "/nonexistent/j2/main.j2")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "missing file"))))
      (arm (pats (variant Result.Err (bind err))) (block
        (expr (call check (. err message) "can't read /nonexistent/j2/main.j2" "missing file"))
        (expr (call check (. err chunk) "gone" "missing file chunk")))))
    (expr (call (. vm destroy)))
    (expr (call printLn "j2_module_test ok")))))
--- stderr
--- exit 0
