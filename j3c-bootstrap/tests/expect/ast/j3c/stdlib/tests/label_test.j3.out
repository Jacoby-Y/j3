(file (module label_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains Text))
  (use j3.ui.a11y)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.testkit)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, label, button, span { font-family: \"T\"; font-size: 16px; } label { display: block; }")
  (mod-let CHECKS int _)
  (mod-let ID (array 9 int) _)
  (mod-let ON (array 8 bool) _)
  (mod-let HITS (array 8 int) _)
  (mod-let SHOW_B bool _)
  (mod-let LC (array 2 int) _)
  (mod-let MANY bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "A checkbox the way `bind:checked` generates it: a click flips the variable, which is written back.") box (params (d (ref Dom)) (k int)) _ (block
    (let c _ (call (. d open) k (call (. d tag) "input") 1))
    (expr (call (. d attrType) c "checkbox"))
    (= (index ID k) c)
    (if (call (. d clicked) c) (block
      (= (index ON k) (! (index ON k)))
      (+= (index HITS k) 1)))
    (expr (call (. d attrChecked) c (index ON k)))
    (expr (call (. d close)))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (let al _ (call (. d open) 0 (call (. d tag) "label") 1))
    (if (call (. d clicked) al) (block
      (+= (index LC 0) 1)))
    (expr (call box d 0))
    (expr (call (. d text) "Alpha"))
    (expr (call (. d close)))
    (let l _ (call (. d open) 1 (call (. d tag) "label") 1))
    (expr (call (. d attrFor) l "b"))
    (if (call (. d clicked) l) (block
      (+= (index LC 1) 1)))
    (expr (call (. d text) "Beta"))
    (expr (call (. d close)))
    (if SHOW_B (block
      (let bc _ (call (. d open) 1 (call (. d tag) "input") 1))
      (expr (call (. d attrId) bc "b"))
      (expr (call (. d attrType) bc "checkbox"))
      (= (index ID 1) bc)
      (if (call (. d clicked) bc) (block
        (= (index ON 1) (! (index ON 1)))
        (+= (index HITS 1) 1)))
      (expr (call (. d attrChecked) bc (index ON 1)))
      (expr (call (. d close)))))
    (expr (call (. d open) 2 (call (. d tag) "label") 1))
    (let t _ (call (. d open) 2 (call (. d tag) "input") 1))
    (expr (call (. d attrType) t "text"))
    (= (index ID 2) t)
    (expr (call (. d close)))
    (expr (call (. d text) "Name"))
    (expr (call (. d close)))
    (expr (call (. d open) 7 (call (. d tag) "label") 1))
    (let ta _ (call (. d open) 7 (call (. d tag) "input") 1))
    (expr (call (. d attrType) ta "textarea"))
    (= (index ID 7) ta)
    (expr (call (. d close)))
    (expr (call (. d text) "Notes"))
    (expr (call (. d close)))
    (let nl _ (call (. d open) 8 (call (. d tag) "label") 1))
    (expr (call (. d attrFor) nl "ta2"))
    (expr (call (. d text) "More"))
    (expr (call (. d close)))
    (let ta2 _ (call (. d open) 8 (call (. d tag) "input") 1))
    (expr (call (. d attrId) ta2 "ta2"))
    (expr (call (. d attrType) ta2 "textarea"))
    (= (index ID 8) ta2)
    (expr (call (. d close)))
    (let g _ (call (. d open) 3 (call (. d tag) "label") 1))
    (expr (call (. d attrFor) g "dis"))
    (expr (call (. d text) "Gamma"))
    (expr (call (. d close)))
    (let dis _ (call (. d open) 3 (call (. d tag) "input") 1))
    (expr (call (. d attrId) dis "dis"))
    (expr (call (. d attrType) dis "checkbox"))
    (expr (call (. d attrDisabled) dis (bool true)))
    (= (index ID 3) dis)
    (if (call (. d clicked) dis) (block
      (+= (index HITS 3) 1)))
    (expr (call (. d close)))
    (let dl _ (call (. d open) 4 (call (. d tag) "label") 1))
    (expr (call (. d attrFor) dl "dup"))
    (expr (call (. d text) "Dup"))
    (expr (call (. d close)))
    (for k (.. 4 6) (block
      (let c _ (call (. d open) k (call (. d tag) "input") 1))
      (expr (call (. d attrId) c "dup"))
      (expr (call (. d attrType) c "checkbox"))
      (= (index ID k) c)
      (if (call (. d clicked) c) (block
        (= (index ON k) (! (index ON k)))
        (+= (index HITS k) 1)))
      (expr (call (. d attrChecked) c (index ON k)))
      (expr (call (. d close)))))
    (expr (call (. d open) 6 (call (. d tag) "label") 1))
    (let bt _ (call (. d open) 6 (call (. d tag) "button") 1))
    (= (index ID 6) bt)
    (if (call (. d clicked) bt) (block
      (+= (index HITS 6) 1)))
    (expr (call (. d text) "Go"))
    (expr (call (. d close)))
    (expr (call (. d text) "Press"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (if MANY (block
      (for k (.. 0 500) (block
        (let mc _ (call (. d open) (+ 10 k) (call (. d tag) "input") 1))
        (expr (call (. d attrType) mc "text"))
        (expr (call (. d attrId) mc (interp "m" k)))
        (expr (call (. d close)))
        (if (== (% k 100) 0) (block
          (let ml _ (call (. d open) (+ 10 k) (call (. d tag) "label") 1))
          (expr (call (. d attrFor) ml (interp "m" k)))
          (expr (call (. d text) (interp "Many " k)))
          (expr (call (. d close)))))))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn clickText (params (d (ref Dom)) (text string)) _ (block
    (for f (.. 0 4) (block
      (expr (call (. testkit clickText) d f 0 text))
      (expr (call frame d))))))
  (fn clickNode (params (d (ref Dom)) (id int)) _ (block
    (for f (.. 0 4) (block
      (expr (call (. testkit click) d f 0 id))
      (expr (call frame d))))))
  (fn idle (params (d (ref Dom))) _ (block
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame d))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "label.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (= SHOW_B (bool true))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call clickText (& d) "Alpha"))
    (expr (call ok (&& (index ON 0) (== (index HITS 0) 1)) "a wrapping label toggles its checkbox once"))
    (expr (call ok (== (index LC 0) 1) "the wrapping label's own on:click fires once"))
    (expr (call clickNode (& d) (index ID 0)))
    (expr (call ok (&& (! (index ON 0)) (== (index HITS 0) 2)) "a click on the checkbox itself activates it once, not twice"))
    (expr (call clickText (& d) "Beta"))
    (expr (call ok (&& (index ON 1) (== (index HITS 1) 1)) "for= toggles a checkbox elsewhere"))
    (expr (call ok (== (index LC 1) 1) "the for= label's own on:click fires once too"))
    (expr (call clickText (& d) "Name"))
    (expr (call ok (== (. d focus) (index ID 2)) "a label focuses its text box"))
    (expr (call idle (& d)))
    (expr (call clickText (& d) "Notes"))
    (expr (call ok (== (. d focus) (index ID 7)) "a wrapping label focuses its textarea"))
    (expr (call idle (& d)))
    (expr (call clickText (& d) "More"))
    (expr (call ok (== (. d focus) (index ID 8)) "for= focuses a textarea"))
    (expr (call idle (& d)))
    (expr (call clickText (& d) "Gamma"))
    (expr (call ok (== (index HITS 3) 0) "a disabled control is not activated"))
    (expr (call clickText (& d) "Dup"))
    (expr (call ok (&& (&& (&& (index ON 4) (! (index ON 5))) (== (index HITS 4) 1)) (== (index HITS 5) 0)) "the first of duplicate ids wins"))
    (expr (call clickText (& d) "Press"))
    (expr (call ok (== (index HITS 6) 1) "a label clicks its button once"))
    (= SHOW_B (bool false))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (let h _ (index HITS 1))
    (expr (call clickText (& d) "Beta"))
    (expr (call ok (== (index HITS 1) h) "no control with that id: no activation"))
    (= SHOW_B (bool true))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (expr (call clickText (& d) "Beta"))
    (expr (call ok (&& (== (index HITS 1) (+ h 1)) (! (index ON 1))) "re-added: the label finds it again"))
    (expr (call clickText (& d) "Dup"))
    (expr (call ok (== (. (. (. d css) warns) len) 1) "the duplicate id warned once, not on every click"))
    (let t _ (call (. testkit textNode) (& d) "Alpha"))
    (let e _ (. (index (. (. d nodes) items) t) parent))
    (let sx _ (+ (call (. d absX) e) (float 0x4008000000000000)))
    (let sy _ (+ (call (. d absY) e) (float 0x4008000000000000)))
    (let h0 _ (index HITS 0))
    (expr (call (. d simInput) sx sy (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) sx sy (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (+ sx (float 0x4028000000000000)) sy (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (+ sx (float 0x4072c00000000000)) (+ sy (float 0x4069000000000000)) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d simInput) (+ sx (float 0x4072c00000000000)) (+ sy (float 0x4069000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call idle (& d)))
    (expr (call ok (== (index HITS 0) h0) "a drag does not activate"))
    (let tx _ (call (. Text new) (& mem)))
    (expr (call (. a11y dump) (& d) (& mem) (& tx)))
    (let s _ (call (. tx str)))
    (expr (call ok (&& (call contains s "checkbox \"Beta\"") (call contains s "checkbox \"Alpha\"")) "the label text names the control"))
    (= MANY (bool true))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (let big _ (call (. Text new) (& mem)))
    (expr (call (. a11y dump) (& d) (& mem) (& big)))
    (expr (call ok (call contains (call (. big str)) "Many 300") "the labels of the many are named"))
    (= MANY (bool false))
    (expr (call idle (& d)))
    (expr (call idle (& d)))
    (let r0 _ (. d restyled))
    (let l0 _ (. d laid))
    (for i (.. 0 10) (block
      (expr (call idle (& d)))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d laid) l0)) "idle frames neither restyle nor lay out"))
    (expr (call printLn (interp "label_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
