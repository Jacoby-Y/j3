(file (module idle_key_test)
  (use j3.game)
  (use j3.game.Key)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use-lib "SDL2" sdl
    (lib-fn SDL_PushEvent (params (event ptr)) i32 _))
  (mod-let BUF (array 8 int) _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "Push an Enter key event (scancode 40) and let the next loop sleep on it.") pushEnter (params (down bool) (repeat u8)) _ (block
    (let i _ 0)
    (while (< i 8) (block
      (= (index BUF i) 0)
      (+= i 1)))
    (let bytes (slice u8) (slice-lit u8 (field ptr (as (as (& (index BUF 0)) ptr) (ref u8))) (field len 64)))
    (= (index bytes 0) (if-expr down 0 1))
    (= (index bytes 1) 3)
    (= (index bytes 12) (if-expr down 1 0))
    (= (index bytes 13) repeat)
    (= (index bytes 16) 40)
    (expr (call ok (== (call (. sdl SDL_PushEvent) (as (& (index BUF 0)) ptr)) 1) "push key"))))
  (fn (doc "One `App.run` loop turn after a Dom frame said nothing is due.") frame (params) bool (block
    (expr (call (. game idleReport) (. game IDLE_FOREVER)))
    (let slept _ (call (. game idleWait)))
    (expr (call (. game poll)))
    (return slept)))
  (fn main (params) _ (block
    (expr (call (. game initGlHidden) "idle key checks" 200 100))
    (expr (call ok (call (. game idleSkipAllowed)) "run with J3_IDLE_SKIP=1"))
    (expr (call (. game poll)))
    (expr (call ok (! (call (. game keyPressedRaw) (. Key Enter))) "starts up"))
    (expr (call pushEnter (bool true) 0))
    (expr (call ok (call frame) "slept"))
    (expr (call ok (&& (call (. game keyPressedRaw) (. Key Enter)) (call (. game keyPressed) (. Key Enter))) "press seen after idle sleep"))
    (expr (call ok (! (call (. game keyReleased) (. Key Enter))) "no release yet"))
    (expr (call pushEnter (bool true) 1))
    (expr (call frame))
    (expr (call ok (! (call (. game keyPressedRaw) (. Key Enter))) "press once, repeat ignored"))
    (expr (call pushEnter (bool false) 0))
    (expr (call frame))
    (expr (call ok (&& (call (. game keyReleased) (. Key Enter)) (! (call (. game keyPressedRaw) (. Key Enter)))) "release seen after idle sleep"))
    (expr (call pushEnter (bool false) 0))
    (expr (call frame))
    (expr (call (. game poll)))
    (expr (call ok (&& (! (call (. game keyReleased) (. Key Enter))) (! (call (. game keyPressedRaw) (. Key Enter)))) "edges cleared"))
    (expr (call pushEnter (bool true) 0))
    (expr (call pushEnter (bool false) 0))
    (expr (call frame))
    (expr (call ok (&& (call (. game keyPressedRaw) (. Key Enter)) (call (. game keyReleased) (. Key Enter))) "tap in one pump"))
    (expr (call (. game simKey) (. Key Tab) (bool true)))
    (expr (call ok (call frame) "slept on a sim key"))
    (expr (call ok (&& (call (. game keyPressedRaw) (. Key Tab)) (call (. game keyDown) (. Key Tab))) "sim press after idle sleep"))
    (expr (call frame))
    (expr (call ok (&& (! (call (. game keyPressedRaw) (. Key Tab))) (call (. game keyDown) (. Key Tab))) "sim press once, then held"))
    (expr (call (. game simKey) (. Key Tab) (bool false)))
    (expr (call frame))
    (expr (call ok (&& (call (. game keyReleased) (. Key Tab)) (! (call (. game keyDown) (. Key Tab)))) "sim release after idle sleep"))
    (expr (call printLn "idle_key_test ok")))))
--- stderr
--- exit 0
