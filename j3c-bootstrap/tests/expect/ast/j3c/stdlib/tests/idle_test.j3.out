(file (module idle_test)
  (use j3.app)
  (use j3.game)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.dom.Dom)
  (mod-let TB int _)
  (mod-let CANVAS bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom))) _ (block
    (expr (call (. d simKeys) "" ""))
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (expr (call (. d open) 0 (call (. d tag) "div") 1))
    (= TB (call (. d open) 0 (call (. d tag) "input") 1))
    (expr (call (. d attrType) TB "text"))
    (expr (call (. d attrAria) TB "Box"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn main (params) _ (block
    (expr (call ok (== (call (. game idleSleepMs) (bool true) (bool true) 100 250) 100) "sleeps until the deadline"))
    (expr (call ok (== (call (. game idleSleepMs) (bool true) (bool true) (. game IDLE_FOREVER) 250) 250) "capped"))
    (expr (call ok (== (call (. game idleSleepMs) (bool true) (bool true) 0 250) 0) "due now: no sleep"))
    (expr (call ok (== (call (. game idleSleepMs) (bool false) (bool true) 100 250) 0) "no UI hosted: draws every frame"))
    (expr (call ok (== (call (. game idleSleepMs) (bool true) (bool false) 100 250) 0) "tests and captures never sleep"))
    (expr (call ok (== (call (. game idleClampWake) 250 1100 1000) 100) "wakeAt shortens the sleep"))
    (expr (call ok (== (call (. game idleClampWake) 250 2000 1000) 250) "a far wakeAt keeps the cap"))
    (expr (call ok (== (call (. game idleClampWake) 250 990 1000) 0) "a passed wakeAt runs a frame now"))
    (expr (call ok (== (call (. game idleClampWake) 0 1100 1000) 0) "wakeAt never makes a busy loop sleep"))
    (let wakes _ 0)
    (let t _ 0)
    (let edges _ 0)
    (while (< t 5000) (block
      (let next _ (* (+ (/ t 500) 1) 500))
      (let ms _ (call (. game idleClampWake) (call (. game idleSleepMs) (bool true) (bool true) (. game IDLE_FOREVER) 500) next t))
      (+= t ms)
      (+= wakes 1)
      (if (== (% t 500) 0) (block
        (+= edges 1)))))
    (expr (call ok (&& (== wakes 10) (== edges 10)) "blink: 10 wakes in 5 s, each on a 500 ms edge"))
    (expr (call ok (call (. app idleAllowed) (bool true) 0) "no systems: may sleep"))
    (expr (call ok (! (call (. app idleAllowed) (bool true) 1)) "a registered system keeps the loop awake"))
    (expr (call ok (! (call (. app idleAllowed) (bool false) 0)) "idleSkip(false)"))
    (let slept _ 0)
    (let now _ 0)
    (while (< now 1000) (block
      (let ms _ (call (. game idleSleepMs) (bool true) (bool true) (. game IDLE_FOREVER) 250))
      (if (> ms 0) (block
        (+= slept 1)
        (+= now ms)) (block
        (+= now 16)))))
    (expr (call ok (== slept 4) "an idle second is 4 wakes, not 60 frames"))
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (call (. d idleMs)) (. game IDLE_FOREVER)) "a still page sleeps until an event"))
    (expr (call (. d requestFrame)))
    (expr (call ok (== (call (. d idleMs)) 0) "requestFrame asks for a frame"))
    (expr (call ok (== (call (. d idleMs)) (. game IDLE_FOREVER)) "and it is consumed"))
    (expr (call (. d simInput) (float 0x4014000000000000) (float 0x4014000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (call (. d idleMs)) 0) "a held button keeps frames coming"))
    (expr (call (. d simInput) (float 0x4014000000000000) (float 0x4014000000000000) (bool false) (float 0x0000000000000000)))
    (= (. d simOn) (bool false))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (call (. d idleMs)) (. game IDLE_FOREVER)) "released: idle again"))
    (expr (call printLn "idle_test ok")))))
--- stderr
--- exit 0
