(file (module toml_test)
  (use j3.data.json)
  (use j3.data.json (names Json Kind))
  (use j3.data.toml)
  (use j3.data.toml.ItemKind)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn doc (params (text string) (arena (ref Arena))) (ref Json) (block
    (match (call (. toml parse) text arena)
      (arm (pats (variant Result.Ok (bind d))) (block
        (return d)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (interp "parse failed at line " (. e line) ": " (. e msg))))
        (expr (call panic "parse"))
        (return (call (. json null) arena)))))))
  (fn (doc "`text` must fail on `line` with a message starting with `msg`.") bad (params (text string) (line int) (msg string) (arena (ref Arena))) _ (block
    (match (call (. toml parse) text arena)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call printLn (interp "should fail: " text)))
        (expr (call panic "no error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (let head _ (if-expr (>= (. (. e msg) len) (. msg len)) (slice-expr (. e msg) 0 (. msg len)) (. e msg)))
        (if (|| (!= (. e line) line) (!= head msg)) (block
          (expr (call printLn (interp text ": got line " (. e line) ": " (. e msg) "; want line " line ": " msg)))
          (expr (call panic "wrong error"))))
        (+= CHECKS 1))))))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) (<< 1 22)))
    (let a _ (& arena))
    (let d _ (call doc "# top\ntitle = \"Game\" # trailing\n[window]\nwidth = 1_280\nheight = 720\nscale = 1.5\nvsync = true\n[window.pos]\nx = -10\n[audio]\nvol.music = 0.8\nvol.sfx = 1e-1\n" a))
    (expr (call ok (== (call (. (call (. d get) "title") asStr)) "Game") "title"))
    (expr (call ok (== (call (. (call (. d path) "window.width") asInt)) 1280) "underscores"))
    (expr (call ok (== (. (call (. d path) "window.width") s) "1_280") "number as written"))
    (expr (call ok (== (call (. (call (. d path) "window.scale") asNum)) (float 0x3ff8000000000000)) "float"))
    (expr (call ok (call (. (call (. d path) "window.vsync") asBool)) "bool"))
    (expr (call ok (== (call (. (call (. d path) "window.pos.x") asInt)) (- 10)) "sub-table"))
    (expr (call ok (== (call (. (call (. d path) "audio.vol.music") asNum)) (float 0x3fe999999999999a)) "dotted key"))
    (expr (call ok (== (call (. (call (. d path) "audio.vol.sfx") asNum)) (float 0x3fb999999999999a)) "exponent"))
    (expr (call ok (&& (&& (== (index (. (. d keys) items) 0) "title") (== (index (. (. d keys) items) 1) "window")) (== (index (. (. d keys) items) 2) "audio")) "key order"))
    (let n _ (call doc "a = 0xff\nb = 0o17\nc = 0b101\nd = +3\ne = -inf\nf = nan\ng = 0\nh = 6.02e23\n" a))
    (expr (call ok (&& (&& (== (call (. (call (. n get) "a") asInt)) 255) (== (call (. (call (. n get) "b") asInt)) 15)) (== (call (. (call (. n get) "c") asInt)) 5)) "prefixed ints"))
    (expr (call ok (== (call (. (call (. n get) "d") asInt)) 3) "plus sign"))
    (expr (call ok (&& (== (. (call (. n get) "e") kind) (. Kind Num)) (< (call (. (call (. n get) "e") asNum)) (- (float 0x7fe1ccf385ebc8a0)))) "inf"))
    (expr (call ok (&& (== (. (call (. n get) "f") kind) (. Kind Num)) (! (== (. (call (. n get) "f") n) (. (call (. n get) "f") n)))) "nan"))
    (expr (call ok (== (call (. (call (. n get) "h") asNum)) (float 0x44dfde9f10a8d361)) "big float"))
    (let w _ (call doc "[emit]\nbackend = llvm\nver = 1.2.3\nodd = 007\nwhen = 1979-05-27 07:32:00Z\nday = 1979-05-27\n" a))
    (expr (call ok (&& (== (. (call (. w path) "emit.backend") kind) (. Kind Str)) (== (call (. (call (. w path) "emit.backend") asStr)) "llvm")) "bare word"))
    (expr (call ok (== (call (. (call (. w path) "emit.ver") asStr)) "1.2.3") "dotted version"))
    (expr (call ok (== (call (. (call (. w path) "emit.odd") asStr)) "007") "leading zero is a word"))
    (expr (call ok (== (call (. (call (. w path) "emit.when") asStr)) "1979-05-27 07:32:00Z") "datetime with a space"))
    (expr (call ok (== (call (. (call (. w path) "emit.day") asStr)) "1979-05-27") "date"))
    (let s _ (call doc "a = \"tab\\there \\\"q\\\" \\u00e9 \\U0001F600\"\nb = 'C:\\new'\nc = \"\"\"\nline1\nline2\"\"\"\nd = '''\nraw \\n'''\ne = \"\"\"one \\\n    two\"\"\"\nf = \"\"\"x\"\"\"\"\"\ng = \"bad \\q\"\n" a))
    (expr (call ok (== (call (. (call (. s get) "a") asStr)) "tab\there \"q\" \xc3\xa9 \xf0\x9f\x98\x80") "basic escapes"))
    (expr (call ok (== (call (. (call (. s get) "b") asStr)) "C:\\new") "literal"))
    (expr (call ok (== (call (. (call (. s get) "c") asStr)) "line1\nline2") "multi-line basic"))
    (expr (call ok (== (call (. (call (. s get) "d") asStr)) "raw \\n") "multi-line literal"))
    (expr (call ok (== (call (. (call (. s get) "e") asStr)) "one two") "line-end backslash"))
    (expr (call ok (== (call (. (call (. s get) "f") asStr)) "x\"\"") "extra closing quotes"))
    (expr (call ok (== (call (. (call (. s get) "g") asStr)) "bad \\q") "bad escape kept"))
    (let r _ (call doc "nums = [\n  1, 2, # two\n  3,\n]\nmixed = [[1, 2], [\"a\"]]\npt = { x = 1, y.z = \"w\" }\nlist = [{ id = 1 }, { id = 2 }]\n" a))
    (expr (call ok (&& (== (call (. (call (. r get) "nums") len)) 3) (== (call (. (call (. r path) "nums.2") asInt)) 3)) "multi-line array"))
    (expr (call ok (== (call (. (call (. r path) "mixed.1.0") asStr)) "a") "nested array"))
    (expr (call ok (&& (== (call (. (call (. r path) "pt.x") asInt)) 1) (== (call (. (call (. r path) "pt.y.z") asStr)) "w")) "inline table"))
    (expr (call ok (== (call (. (call (. r path) "list.1.id") asInt)) 2) "array of inline tables"))
    (let t _ (call doc "[[enemy]]\nname = \"slime\"\nhp = 3\n[enemy.drop]\nitem = \"goo\"\n[[enemy]]\nname = \"bat\"\n" a))
    (expr (call ok (== (call (. (call (. t get) "enemy") len)) 2) "two tables"))
    (expr (call ok (== (call (. (call (. t path) "enemy.0.drop.item") asStr)) "goo") "sub-table of the last array element"))
    (expr (call ok (== (call (. (call (. t path) "enemy.1.name") asStr)) "bat") "second element"))
    (expr (call ok (== (call (. (call (. (call doc "a = 1\na = 2\n" a) get) "a") asInt)) 2) "key twice"))
    (match (call (. toml items) "[a]\nk = 1\nk = 2\n[[b]]\n" a)
      (arm (pats (variant Result.Ok (bind its))) (block
        (expr (call ok (== (. its len) 4) "items count"))
        (expr (call ok (&& (== (. (index (. its items) 0) kind) (. ItemKind Table)) (== (. (index (. its items) 0) line) 1)) "header item"))
        (expr (call ok (&& (&& (== (. (index (. its items) 2) kind) (. ItemKind Key)) (== (call (. (. (index (. its items) 2) val) asInt)) 2)) (== (. (index (. its items) 2) line) 3)) "key item"))
        (expr (call ok (&& (== (. (index (. its items) 3) kind) (. ItemKind ArrayTable)) (== (index (. (. (index (. its items) 3) keys) items) 0) "b")) "array table item"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "items")))))
    (let bom _ (call (. Text new) a))
    (expr (call (. bom push) 239))
    (expr (call (. bom push) 187))
    (expr (call (. bom push) 191))
    (expr (call (. bom add) "[a]\r\nb = \"x\"\r\n"))
    (let c _ (call doc (call (. bom str)) a))
    (expr (call ok (== (call (. (call (. c path) "a.b") asStr)) "x") "crlf + bom"))
    (expr (call bad "[a]\nnoeq\n" 2 "expected `key = value`" a))
    (expr (call bad "[a]\n= 1\n" 2 "bad key" a))
    (expr (call bad "[a]\nb = \"x\n" 2 "expected a \"string\"" a))
    (expr (call bad "[a]\nb = [\"x\",\n" 2 "expected an array" a))
    (expr (call bad "[a]\nb = [\"x\", y]\n" 2 "expected a \"string\"" a))
    (expr (call bad "[a]\nb = {x = \"1\"\n" 2 "expected `{ key = \"value\", ... }` on one line" a))
    (expr (call bad "a = 1\n[a.b]\n" 2 "`a` is already a value" a))
    (expr (call bad "a = 1 2\n" 1 "unexpected `2`" a))
    (expr (call bad "[a\nx = 1\n" 1 "bad table header" a))
    (expr (call bad "x = \"\"\"never closed\n\n" 1 "expected a \"string\"" a))
    (let src _ "title = \"G \\\"q\\\"\"\n[win]\nw = 1280\ns = 0.5\non = true\ntags = [\"a\", \"b\"]\npt = { x = 1 }\n[win.pos]\nx = -1\n[[enemy]]\nname = \"slime\"\n[[enemy]]\nname = \"bat\"\n[\"odd key\"]\nk = \"v\"\n")
    (let first _ (call doc src a))
    (let out _ (call (. toml stringify) first a))
    (let back _ (call doc out a))
    (expr (call ok (== (call (. json stringify) first a) (call (. json stringify) back a)) "round trip"))
    (let want _ "title = \"G \\\"q\\\"\"\n\n[win]\nw = 1280\ns = 0.5\non = true\ntags = [\"a\", \"b\"]\n\n[win.pt]\nx = 1\n\n[win.pos]\nx = -1\n\n[[enemy]]\nname = \"slime\"\n\n[[enemy]]\nname = \"bat\"\n\n[\"odd key\"]\nk = \"v\"\n")
    (expr (call ok (== out want) "stringify layout"))
    (let built _ (call (. json obj) a))
    (expr (call (. built set) "n" (call (. json num) (float 0x4000000000000000) a)))
    (let sub _ (call (. json obj) a))
    (expr (call (. sub set) "gone" (call (. json null) a)))
    (expr (call (. sub set) "f" (call (. json num) (float 0x3fd0000000000000) a)))
    (expr (call (. built set) "t" sub))
    (expr (call ok (== (call (. toml stringify) built a) "n = 2\n\n[t]\nf = 0.25\n") "stringify a built tree"))
    (expr (call printLn (interp "toml ok (" CHECKS " checks)"))))))
--- stderr
--- exit 0
