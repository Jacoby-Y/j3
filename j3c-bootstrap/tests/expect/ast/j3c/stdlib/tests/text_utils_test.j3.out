(file (module text_utils_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.sys.panic)
  (use j3.text)
  (use j3.text (names Text runes))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "The bits `parseF64(s)` gives, or 1 for None (never a result here: 1 is a subnormal printed `5e-324`).") parsedBits (params (s string)) u64 (block
    (match (call (. text parseF64) s)
      (arm (pats (variant Option.Some (bind v))) (block
        (return (call (. text f64Bits) v))))
      (arm (pats (variant Option.None)) (block
        (return 1))))))
  (fn printed (params (t (ref Text)) (bits u64)) string (block
    (expr (call (. t clear)))
    (expr (call (. t pushF64) (call (. text f64FromBits) bits)))
    (return (call (. t str)))))
  (fn intIs (params (s string) (base int) (want int)) bool (block
    (match (call (. text parseInt) s base)
      (arm (pats (variant Option.Some (bind v))) (block
        (return (== v want))))
      (arm (pats (variant Option.None)) (block
        (return (bool false)))))))
  (fn intNone (params (s string) (base int)) bool (block
    (match (call (. text parseInt) s base)
      (arm (pats (variant Option.Some (bind v))) (block
        (return (bool false))))
      (arm (pats (variant Option.None)) (block
        (return (bool true)))))))
  (fn u64Is (params (s string) (base int) (want u64)) bool (block
    (match (call (. text parseU64) s base)
      (arm (pats (variant Option.Some (bind v))) (block
        (return (== v want))))
      (arm (pats (variant Option.None)) (block
        (return (bool false)))))))
  (fn u64None (params (s string)) bool (block
    (match (call (. text parseU64) s 10)
      (arm (pats (variant Option.Some (bind v))) (block
        (return (bool false))))
      (arm (pats (variant Option.None)) (block
        (return (bool true)))))))
  (fn (doc "The code points of `s` and their byte lengths, as \"cp/len cp/len\".") decoded (params (t (ref Text)) (s string)) string (block
    (expr (call (. t clear)))
    (let i _ 0)
    (while (< i (. s len)) (block
      (let-pat (tuple-pat (bind cp) (bind n)) (call (. text decodeRune) s i))
      (if (> i 0) (block
        (expr (call (. t push) (char 32)))))
      (expr (call (. t pushHex) (call u64 cp)))
      (expr (call (. t push) (char 47)))
      (expr (call (. t pushInt) n))
      (+= i n)))
    (return (call (. t str)))))
  (fn (doc "The pieces of `split(s, sep)` joined with `|`.") pieces (params (t (ref Text)) (s string) (sep string)) string (block
    (expr (call (. t clear)))
    (let first _ (bool true))
    (for-each _ part (call (. text split) s sep) (block
      (if (! first) (block
        (expr (call (. t push) (char 124)))))
      (= first (bool false))
      (expr (call (. t pushStr) part))))
    (return (call (. t str)))))
  (fn lineList (params (t (ref Text)) (s string)) string (block
    (expr (call (. t clear)))
    (for-each _ line (call (. text lines) s) (block
      (expr (call (. t push) (char 91)))
      (expr (call (. t pushStr) line))
      (expr (call (. t push) (char 93)))))
    (return (call (. t str)))))
  (fn floats (params (t (ref Text))) _ (block
    (let cases (array 15 u64) (array-lit 4591870180066957722 4599676419421066581 1 9218868437227405311 4503599627370496 4503599627370495 0 9218868437227405312 4845873199050653696 4547007122018943789 4906019910204099648 4841369599423283200 4607182418800017409 4950912855330343670 4517329193108106637))
    (let want (array 15 string) (array-lit "0.1" "0.3333333333333333" "5e-324" "1.7976931348623157e+308" "2.2250738585072014e-308" "2.225073858507201e-308" "0" "inf" "9007199254740992" "0.0001" "1e+20" "4503599627370496" "1.0000000000000002" "1e+23" "1e-06"))
    (for i (.. 0 (. cases len)) (block
      (expr (call ok (== (call printed t (index cases i)) (index want i)) (interp "prints " (index want i))))
      (expr (call ok (== (call parsedBits (index want i)) (index cases i)) (interp "parses " (index want i))))))
    (expr (call ok (== (call printed t 9221120237041090560) "nan") "nan prints"))
    (let sign _ (<< (call u64 1) 63))
    (expr (call ok (== (call printed t (| sign 9218868437227405312)) "-inf") "-inf prints"))
    (expr (call ok (&& (== (call printed t sign) "-0") (== (call parsedBits "-0") sign)) "-0"))
    (for e (.. 1 2047) (block
      (let b _ (<< (call u64 e) 52))
      (expr (call ok (== (call parsedBits (call printed t b)) b) "binade start round-trips"))
      (expr (call ok (== (call parsedBits (call printed t (- b 1))) (- b 1)) "binade end round-trips"))))
    (let s u64 2685821657736338717)
    (for i (.. 0 1000000) (block
      (= s (^ s (<< s 13)))
      (= s (^ s (>> s 7)))
      (= s (^ s (<< s 17)))
      (if (== (& (>> s 52) 2047) 2047) (block
        (continue)))
      (if (!= (call parsedBits (call printed t s)) s) (block
        (expr (call (. t pushStr) " did not round-trip"))
        (expr (call ok (bool false) (call (. t str))))))))
    (expr (call (. t clear)))
    (expr (call (. t pushF32) (call f32 (float 0x3fb999999999999a))))
    (expr (call ok (== (call (. t str)) "0.1") "f32 0.1"))
    (expr (call (. t clear)))
    (expr (call (. t pushF32) (call (. text f32FromBits) 1)))
    (expr (call ok (== (call (. t str)) "1e-45") "f32 smallest"))
    (expr (call (. t clear)))
    (expr (call (. t pushF32) (call (. text f32FromBits) 2139095039)))
    (expr (call ok (== (call (. t str)) "3.4028235e+38") "f32 max"))
    (let r u32 2654435769)
    (for i (.. 0 200000) (block
      (= r (^ r (<< r 13)))
      (= r (^ r (>> r 17)))
      (= r (^ r (<< r 5)))
      (if (== (& (>> r 23) 255) 255) (block
        (continue)))
      (expr (call (. t clear)))
      (expr (call (. t pushF32) (call (. text f32FromBits) r)))
      (let back _ (call (. text f32Bits) (call f32 (call (. text f64FromBits) (call parsedBits (call (. t str)))))))
      (expr (call ok (== back r) "f32 round-trips"))))
    (expr (call ok (== (call parsedBits "9007199254740993") 4845873199050653696) "tie to even"))
    (expr (call ok (== (call parsedBits "9007199254740993.000000000000000000001") 4845873199050653697) "past the tie"))
    (expr (call ok (== (call parsedBits "2.4703282292062327e-324") 0) "below half the smallest subnormal"))
    (expr (call ok (== (call parsedBits "2.4703282292062328e-324") 1) "above half the smallest subnormal"))
    (expr (call ok (== (call parsedBits "1e400") 9218868437227405312) "overflow is inf"))
    (expr (call ok (== (call parsedBits "-1e-400") (<< (call u64 1) 63)) "underflow is -0"))
    (expr (call ok (&& (== (call parsedBits ".5") 4602678819172646912) (== (call parsedBits "5.") 4617315517961601024)) "bare dot"))
    (expr (call ok (== (call parsedBits "+1E+2") 4636737291354636288) "signs and E"))
    (expr (call ok (&& (== (call parsedBits "-Infinity") (| (<< (call u64 1) 63) 9218868437227405312)) (== (call parsedBits "NaN") 9221120237041090560)) "words"))
    (let bad (array 12 string) (array-lit "" "+" "-" "." "e5" "1e" "1e+" "1.2.3" " 1" "1 " "0x10" "1_0"))
    (for i (.. 0 (. bad len)) (block
      (expr (call ok (== (call parsedBits (index bad i)) 1) (interp "rejects \"" (index bad i) "\"")))))))
  (fn ints (params) _ (block
    (expr (call ok (&& (&& (call intIs "0" 10 0) (call intIs "-42" 10 (- 42))) (call intIs "+7" 10 7)) "small ints"))
    (expr (call ok (call intIs "9223372036854775807" 10 9223372036854775807) "i64 max"))
    (expr (call ok (call intIs "-9223372036854775808" 10 (- (- 9223372036854775807) 1)) "i64 min"))
    (expr (call ok (&& (call intNone "9223372036854775808" 10) (call intNone "-9223372036854775809" 10)) "i64 overflow"))
    (expr (call ok (call intNone "99999999999999999999999" 10) "far overflow"))
    (expr (call ok (&& (&& (&& (call intIs "ff" 16 255) (call intIs "-FF" 16 (- 255))) (call intIs "z" 36 35)) (call intIs "1010" 2 10)) "bases"))
    (expr (call ok (&& (&& (call intNone "" 10) (call intNone "-" 10)) (call intNone "+" 10)) "empty and lone sign"))
    (expr (call ok (&& (&& (&& (&& (call intNone "0x10" 16) (call intNone "12a" 10)) (call intNone "2" 2)) (call intNone " 1" 10)) (call intNone "1_000" 10)) "bad digits"))
    (expr (call ok (call u64Is "18446744073709551615" 10 (~ (call u64 0))) "u64 max"))
    (expr (call ok (&& (&& (&& (call u64None "18446744073709551616") (call u64None "-1")) (call u64None "+1")) (call u64None "")) "u64 rejects"))
    (expr (call ok (call u64Is "ffffffffffffffff" 16 (~ (call u64 0))) "u64 hex"))))
  (fn utf8 (params (t (ref Text)) (a (ref Arena))) _ (block
    (expr (call ok (== (call decoded t "a\xc3\xa9\xe2\x82\xac\xf0\x9f\x98\x80") "61/1 e9/2 20ac/3 1f600/4") "valid sequences"))
    (let cases (array 12 string) (array-lit (call raw a "C0 AF") (call raw a "E0 80 AF") (call raw a "F0 80 80 AF") (call raw a "ED A0 80") (call raw a "F4 90 80 80") (call raw a "F5 80 80 80") (call raw a "80") (call raw a "E2 82") (call raw a "E2 28 A1") (call raw a "FF") (call raw a "C2") (call raw a "F0 9F 98")))
    (let want (array 12 string) (array-lit "fffd/1 fffd/1" "fffd/1 fffd/1 fffd/1" "fffd/1 fffd/1 fffd/1 fffd/1" "fffd/1 fffd/1 fffd/1" "fffd/1 fffd/1 fffd/1 fffd/1" "fffd/1 fffd/1 fffd/1 fffd/1" "fffd/1" "fffd/1 fffd/1" "fffd/1 28/1 fffd/1" "fffd/1" "fffd/1" "fffd/1 fffd/1 fffd/1"))
    (for i (.. 0 (. cases len)) (block
      (expr (call ok (== (call decoded t (index cases i)) (index want i)) (interp "invalid case " i)))
      (expr (call ok (! (call (. text isValidUtf8) (index cases i))) (interp "invalid case " i " is invalid")))))
    (expr (call ok (&& (call (. text isValidUtf8) "") (call (. text isValidUtf8) (call raw a "61 C3 A9 E2 82 AC F0 9F 98 80 EF BF BD"))) "valid strings"))
    (expr (call ok (call (. text isValidUtf8) (call raw a "ED 9F BF EE 80 80 F4 8F BF BF")) "edges U+D7FF U+E000 U+10FFFF"))
    (expr (call (. t clear)))
    (expr (call (. text encodeRune) t 1114111))
    (expr (call (. text encodeRune) t 55296))
    (expr (call ok (== (call (. t str)) (call raw a "F4 8F BF BF EF BF BD")) "encodeRune"))
    (let r _ (call (. (call raw a "61 E2 82 AC FF 62") runes)))
    (let n _ 0)
    (let sum u32 0)
    (let ats _ 0)
    (for-each _ cp (& r) (block
      (+= n 1)
      (+= sum cp)
      (+= ats (. r at))))
    (expr (call ok (&& (&& (== n 4) (== sum (+ (+ (+ 97 8364) 65533) 98))) (== ats (+ (+ (+ 0 1) 4) 5))) "runes"))))
  (fn (doc "The bytes written as hex pairs (\"C0 AF\"), as a string on `a`.") raw (params (a (ref Arena)) (hex string)) string (block
    (let t _ (call (. Text new) a))
    (for-each _ part (call (. text split) hex " ") (block
      (match (call (. text parseInt) part 16)
        (arm (pats (variant Option.Some (bind v))) (block
          (expr (call (. t push) (call u8 v)))))
        (arm (pats (variant Option.None)) (block
          (expr (call panic "raw: bad hex")))))))
    (return (call (. t str)))))
  (fn strs (params (t (ref Text))) _ (block
    (expr (call ok (== (call pieces t "a,b,c" ",") "a|b|c") "split"))
    (expr (call ok (== (call pieces t "" ",") "") "split empty gives one empty piece"))
    (expr (call ok (== (call pieces t ",a," ",") "|a|") "split leading and trailing"))
    (expr (call ok (== (call pieces t "a,,b" ",") "a||b") "split adjacent"))
    (expr (call ok (== (call pieces t "a::b::" "::") "a|b|") "split long sep"))
    (expr (call ok (== (call pieces t "abc" "abcd") "abc") "split sep longer than s"))
    (let count _ 0)
    (for-each _ _p (call (. text split) "" ",") (block
      (+= count 1)))
    (expr (call ok (== count 1) "split empty count"))
    (expr (call ok (&& (== (call lineList t "a\nb\n") "[a][b]") (== (call lineList t "a\r\nb") "[a][b]")) "lines"))
    (expr (call ok (&& (&& (== (call lineList t "") "") (== (call lineList t "\n") "[]")) (== (call lineList t "\n\nx") "[][][x]")) "lines edges"))
    (expr (call ok (&& (&& (call (. text startsWith) "hello" "he") (call (. text startsWith) "x" "")) (! (call (. text startsWith) "h" "he"))) "startsWith"))
    (expr (call ok (&& (&& (call (. text endsWith) "hello" "lo") (call (. text endsWith) "" "")) (! (call (. text endsWith) "o" "lo"))) "endsWith"))
    (expr (call ok (&& (&& (&& (== (call (. text trim) " \t a b \r\n") "a b") (== (call (. text trim) "   ") "")) (== (call (. text trimStart) "  x ") "x ")) (== (call (. text trimEnd) " x  ") " x")) "trim"))
    (expr (call ok (&& (&& (== (call (. text lastIndexOf) "abcabc" "bc") 4) (== (call (. text lastIndexOf) "abc" "x") (- 1))) (== (call (. text lastIndexOf) "abc" "") 3)) "lastIndexOf"))
    (expr (call (. t clear)))
    (expr (call ok (== (call (. text replace) t "a-b--c" "-" "+") "a+b++c") "replace"))
    (expr (call ok (== (call (. text replace) t "aaa" "aa" "b") "ba") "replace no overlap"))
    (expr (call ok (== (call (. text replace) t "abc" "" "x") "abc") "replace empty old"))
    (expr (call ok (== (call (. t str)) "a+b++cbaabc") "replace appends"))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* 1024 1024)))
    (let t _ (call (. Text new) (& a)))
    (expr (call ints))
    (expr (call utf8 (& t) (& a)))
    (expr (call strs (& t)))
    (expr (call floats (& t)))
    (expr (call printLn "text_utils_test ok")))))
--- stderr
--- exit 0
