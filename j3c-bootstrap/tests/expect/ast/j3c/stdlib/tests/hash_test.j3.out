(file (module hash_test)
  (use j3.hash)
  (use j3.hash (names Fnv1a64 Sha256 Xxh3))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "`v` as 16 hex digits.") hex16 (params (t (ref Text)) (v u64)) string (block
    (expr (call (. t clear)))
    (let digits _ "0123456789abcdef")
    (let k _ 60)
    (while (>= k 0) (block
      (expr (call (. t push) (index digits (call int (& (>> v (call u64 k)) 15)))))
      (-= k 4)))
    (return (call (. t str)))))
  (fn sha (params (t (ref Text)) (b (slice u8))) string (block
    (expr (call (. t clear)))
    (expr (call (. (call (. hash sha256) b) hex) t))
    (return (call (. t str)))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 4 1024) 1024)))
    (let t _ (call (. Text new) (& a)))
    (let buf _ (call (. a alloc) (targs u8) 100000))
    (for i (.. 0 (. buf len)) (block
      (= (index buf i) (call u8 (& (+ (* i 31) 7) 255)))))
    (expr (call ok (== (call hex16 (& t) (call (. hash fnv1a64) (as "" (slice u8)))) "cbf29ce484222325") "fnv empty"))
    (expr (call ok (== (call hex16 (& t) (call (. hash fnv1a64) (as "a" (slice u8)))) "af63dc4c8601ec8c") "fnv a"))
    (expr (call ok (== (call hex16 (& t) (call (. hash fnv1a64) (as "foobar" (slice u8)))) "85944171f73967e8") "fnv foobar"))
    (let lens (array 34 int) (array-lit 0 1 2 3 4 5 8 9 15 16 17 31 32 33 64 65 96 97 127 128 129 200 239 240 241 255 256 257 1023 1024 1025 2048 4097 100000))
    (let want (array 34 string) (array-lit "2d06800538d394c2" "4c5cca45d0f4811f" "a7e250c97710ff27" "15f7093b173d005c" "dca012f95811b6b9" "b290cafc7b254345" "dec6a9a43575982e" "cbe393399f17ffbd" "545e19990471dc37" "7e484c18d74895d0" "208bde5ee2bed407" "a937652b0119ca11" "03df0ac5255d1446" "199a362122d71f46" "dd30702ab46b3745" "fab36b851b94ce20" "d245cd2541582982" "60e3e1d0d43785b3" "a915ed6396db8cc0" "f92b70eaa21a6288" "f8f76713f2bb60fa" "12fdb864685f344d" "caa9b7a588464745" "ccc7375172c41f03" "0b3b630948ce4a00" "89932170686cdd9a" "ec85b75bafe6ca74" "12ef0ff633841459" "f0d330ce2b3300fb" "23bc880ebf0d29c6" "c09fdfbc398c7d82" "19f6f9c987331373" "b319759b4671c221" "ccf90df7e7e37036"))
    (for k (.. 0 (. lens len)) (block
      (expr (call ok (== (call hex16 (& t) (call (. hash xxh3_64) (slice-expr buf 0 (index lens k)))) (index want k)) (interp "xxh3 len " (index lens k))))))
    (expr (call ok (== (call hex16 (& t) (call (. hash xxh3_64) (as "a" (slice u8)))) "e6c632b61e964e1f") "xxh3 a"))
    (expr (call ok (== (call hex16 (& t) (call (. hash xxh3_64) (as "abc" (slice u8)))) "78af5f94892f3950") "xxh3 abc"))
    (expr (call ok (== (call hex16 (& t) (call (. hash xxh3_64) (as "hello world" (slice u8)))) "d447b1ea40e6988b") "xxh3 hello world"))
    (expr (call ok (== (call hex16 (& t) (call (. hash xxh3_64) (as "The quick brown fox jumps over the lazy dog" (slice u8)))) "ce7d19a5418fb365") "xxh3 The quick brown fox jumps over the lazy dog"))
    (expr (call ok (== (call sha (& t) (as "" (slice u8))) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") "sha empty"))
    (expr (call ok (== (call sha (& t) (as "abc" (slice u8))) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") "sha abc"))
    (expr (call ok (== (call sha (& t) (as "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" (slice u8))) "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") "sha 448 bits"))
    (let ma _ (call (. a alloc) (targs u8) 1000000))
    (for i (.. 0 (. ma len)) (block
      (= (index ma i) (char 97))))
    (expr (call ok (== (call sha (& t) ma) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0") "sha million a"))
    (let n _ 3000)
    (let whole _ (slice-expr buf 0 n))
    (let wx _ (call (. hash xxh3_64) whole))
    (let wf _ (call (. hash fnv1a64) whole))
    (let ws _ (call sha (& t) whole))
    (for cut (.. 0 (+ n 1)) (block
      (let x _ (call (. Xxh3 new)))
      (expr (call (. x update) (slice-expr whole 0 cut)))
      (expr (call (. x update) (slice-expr whole cut n)))
      (expr (call ok (== (call (. x finish)) wx) (interp "xxh3 split at " cut)))
      (let f _ (call (. Fnv1a64 new)))
      (expr (call (. f update) (slice-expr whole 0 cut)))
      (expr (call (. f update) (slice-expr whole cut n)))
      (expr (call ok (== (call (. f finish)) wf) "fnv split"))
      (if (|| (== (% cut 7) 0) (< cut 130)) (block
        (let s _ (call (. Sha256 new)))
        (expr (call (. s update) (slice-expr whole 0 cut)))
        (expr (call (. s update) (slice-expr whole cut n)))
        (expr (call (. t clear)))
        (expr (call (. (call (. s finish)) hex) (& t)))
        (expr (call ok (== (call (. t str)) ws) (interp "sha split at " cut)))))))
    (for step (.. 1 300) (block
      (let x _ (call (. Xxh3 new)))
      (let s _ (call (. Sha256 new)))
      (let at _ 0)
      (while (< at n) (block
        (let e _ (if-expr (> (+ at step) n) n (+ at step)))
        (expr (call (. x update) (slice-expr whole at e)))
        (expr (call (. s update) (slice-expr whole at e)))
        (= at e)))
      (expr (call ok (== (call (. x finish)) wx) (interp "xxh3 pieces of " step)))
      (expr (call (. t clear)))
      (expr (call (. (call (. s finish)) hex) (& t)))
      (expr (call ok (== (call (. t str)) ws) (interp "sha pieces of " step)))))
    (for len (.. 0 600) (block
      (let x _ (call (. Xxh3 new)))
      (expr (call (. x update) (slice-expr buf 0 (/ len 2))))
      (expr (call (. x update) (slice-expr buf (/ len 2) len)))
      (expr (call ok (== (call (. x finish)) (call (. hash xxh3_64) (slice-expr buf 0 len))) (interp "xxh3 short " len)))))
    (expr (call printLn "hash_test ok")))))
--- stderr
--- exit 0
