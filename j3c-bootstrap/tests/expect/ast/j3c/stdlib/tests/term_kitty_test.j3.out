(file (module term_kitty_test)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.term.ansi)
  (use j3.term.ansi.Parser)
  (use j3.term.grid.Grid)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn s (params (x string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 (. x len)) (block
      (if (== (index x i) 64) (block
        (expr (call (. t push) 27))) (block
        (if (== (index x i) 126) (block
          (expr (call (. t push) 27))
          (expr (call (. t push) 92))) (block
          (expr (call (. t push) (index x i)))))))))
    (return (call (. t str)))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 16 1024) 1024)))
    (let g _ (call (. Grid new) (& a) 20 5 100))
    (= (. g cellPxW) 1)
    (= (. g cellPxH) 1)
    (let p _ (call (. Parser new) (& a)))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=T,f=32,s=2,v=2,i=7;/wAA//8AAP//AAD//wAA/w==~" (& a)) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@_Gi=7;OK~" (& a))) "transmit+display replies OK"))
    (expr (call (. (. g reply) clear)))
    (expr (call ok (== (. (call (. g kittyPlacements)) len) 1) "one placement"))
    (let pl _ (index (call (. g kittyPlacements)) 0))
    (expr (call ok (&& (&& (&& (&& (&& (== (. pl row) 0) (== (. pl col) 0)) (== (. pl cols) 2)) (== (. pl rows) 2)) (== (. pl dw) 2)) (== (. pl dh) 2)) "placed at the cursor, sized in cells"))
    (expr (call ok (&& (== (call (. g cursorY)) 1) (== (call (. g cursorX)) 2)) "cursor moved past the image"))
    (let im _ (call (. g kittyImage) (. pl serial)))
    (expr (call ok (&& (&& (&& (&& (== (. im w) 2) (== (. im h) 2)) (== (index (. im px) 0) 255)) (== (index (. im px) 1) 0)) (== (index (. im px) 3) 255)) "pixels stored"))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=t,f=24,s=2,v=2,i=8,q=1,m=1;AP8AAP8A~@_Gm=0;AP8AAP8A~" (& a)) (& g)))
    (expr (call ok (== (call (. (. g reply) len)) 0) "q=1 hides OK"))
    (let k _ (call (. g kittyImage) (+ (. (index (call (. g kittyPlacements)) 0) serial) 1)))
    (expr (call ok (&& (&& (== (. k w) 2) (== (index (. k px) 1) 255)) (== (index (. k px) 3) 255)) "chunked RGB becomes RGBA"))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=T,f=32,o=z,s=2,v=2,i=9,p=3,C=1,c=4,r=1;eJxjYPj/nwEJAwA71Af5~" (& a)) (& g)))
    (expr (call (. (. g reply) clear)))
    (expr (call ok (&& (== (call (. g cursorY)) 1) (== (call (. g cursorX)) 2)) "C=1 keeps the cursor"))
    (expr (call ok (&& (&& (== (. (call (. g kittyPlacements)) len) 2) (== (. (index (call (. g kittyPlacements)) 1) cols) 4)) (== (. (index (call (. g kittyPlacements)) 1) dw) 4)) "c/r size the box"))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=p,i=9,p=3,C=1~" (& a)) (& g)))
    (expr (call ok (&& (== (call (. (. g reply) str)) (call s "@_Gi=9,p=3;OK~" (& a))) (== (. (call (. g kittyPlacements)) len) 2)) "same placement id replaces"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=p,i=99~" (& a)) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@_Gi=99;ENOENT:no such image~" (& a))) "put of a missing image"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=q,f=32,s=5,v=5,i=31;AAAA~" (& a)) (& g)))
    (expr (call ok (&& (> (call (. (. g reply) len)) 0) (!= (index (call (. (. g reply) str)) (- (call (. (. g reply) len)) 3)) 75)) "query with short data is an error"))
    (expr (call (. (. g reply) clear)))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=q,f=24,s=2,v=2,i=31;AP8AAP8AAP8AAP8A~" (& a)) (& g)))
    (expr (call ok (== (call (. (. g reply) str)) (call s "@_Gi=31;OK~" (& a))) "query OK"))
    (expr (call (. (. g reply) clear)))
    (for i (.. 0 4) (block
      (expr (call (. ansi feed) (& p) "\n" (& g)))))
    (expr (call ok (== (. (index (call (. g kittyPlacements)) 0) row) (- 0 1)) "placement scrolled up one row"))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=d,d=I,i=9~" (& a)) (& g)))
    (expr (call ok (== (. (call (. g kittyPlacements)) len) 1) "delete by id"))
    (expr (call ok (== (. (call (. g kittyImage) (+ (. k serial) 1)) w) 0) "uppercase frees the image"))
    (expr (call (. ansi feed) (& p) (call s "@[2J" (& a)) (& g)))
    (expr (call (. ansi feed) (& p) (call s "@_Ga=p,i=7~" (& a)) (& g)))
    (expr (call (. (. g reply) clear)))
    (expr (call ok (== (. (call (. g kittyPlacements)) len) 1) "put again after clear"))
    (expr (call (. ansi feed) (& p) (call s "@c" (& a)) (& g)))
    (expr (call ok (&& (== (. (call (. g kittyPlacements)) len) 0) (== (. (call (. g kittyImage) (. pl serial)) w) 0)) "RIS frees all"))
    (expr (call (. ansi feed) (& p) (call s "@_Xnope~hi" (& a)) (& g)))
    (expr (call ok (&& (== (. (call (. g cell) 0 0) cp) 104) (== (. (call (. g cell) 1 0) cp) 105)) "non-G APC dropped, text continues"))
    (expr (call printLn "term_kitty_test ok")))))
--- stderr
--- exit 0
