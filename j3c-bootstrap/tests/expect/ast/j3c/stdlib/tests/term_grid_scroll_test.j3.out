(file (module term_grid_scroll_test)
  (use j3.io.exists)
  (use j3.io.printLn)
  (use j3.io.readFile)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.term.Style)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.grid)
  (use j3.term.grid.Grid)
  (use j3.text.Text)
  (fn eq (params (a string) (b string) (msg string)) _ (block
    (if (! (== a b)) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call printLn "  want:"))
      (expr (call printLn b))
      (expr (call printLn "  got:"))
      (expr (call printLn a))
      (expr (call panic msg))))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eqi (params (a int) (b int) (msg string)) _ (block
    (if (!= a b) (block
      (expr (call printLn (interp "FAIL: " msg ": want " b " got " a)))
      (expr (call panic msg))))))
  (fn mk (params (s string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 (. s len)) (block
      (let c _ (index s i))
      (expr (call (. t push) (if-expr (== c 126) 27 (if-expr (== c 36) 7 (if-expr (== c 94) 8 c)))))))
    (return (call (. t str)))))
  (struct (doc "A grid and its parser; `go` feeds a sample.") Term
    (field g Grid)
    (field p Parser)
    (field a (ref Arena))
    (fn go (params (this (ref Term)) (s string)) _ (block
      (let b _ (call mk s (. this a)))
      (expr (call (. (. this p) feed) b (& (. this g))))))
    (fn dump (params (this (ref Term))) string (block
      (return (call (. (. this g) dumpText) (. this a))))))
  (fn term (params (a (ref Arena)) (cols int) (rows int) (sb int)) Term (block
    (return (struct-lit Term (field g (call (. Grid new) a cols rows sb)) (field p (call (. Parser new) a)) (field a a)))))
  (fn cursor (params (t (ref Term)) (x int) (y int) (msg string)) _ (block
    (expr (call eqi (call (. (. t g) cursorX)) x (interp msg " cursor x")))
    (expr (call eqi (call (. (. t g) cursorY)) y (interp msg " cursor y")))))
  (fn repeat (params (s string) (n int) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (for i (.. 0 n) (block
      (expr (call (. t add) s))))
    (return (call (. t str)))))
  (fn join (params (x string) (y string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. (call (. t add) x) add) y))
    (return (call (. t str)))))
  (fn resizing (params (a (ref Arena))) _ (block
    (let t _ (call term a 10 4 10))
    (expr (call (. t go) "r0\r\nr1\r\nr2\r\nr3"))
    (expr (call cursor (& t) 2 3 "before resize"))
    (expr (call (. (. t g) resize) 6 2))
    (expr (call eq (call (. t dump)) "r2\nr3" "shrunk: the cursor line stays, the top goes to scrollback"))
    (expr (call cursor (& t) 2 1 "cursor after shrink"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 2 "two rows pushed"))
    (expr (call eq (call (. (. t g) lineString) 0 a) "r0" "scrollback line"))
    (expr (call (. (. t g) resize) 12 5))
    (expr (call eq (call (. t dump)) "r2\nr3\n\n\n" "grown: padded with blank rows"))
    (expr (call cursor (& t) 2 1 "cursor after growth"))
    (expr (call (. t go) "~[5;12Hz"))
    (expr (call ok (== (. (call (. (. t g) cell) 11 4) cp) 122) "new columns are usable"))
    (expr (call (. t go) "~[1;1H\ta"))
    (expr (call ok (== (. (call (. (. t g) cell) 8 0) cp) 97) "tab stops exist in new columns"))
    (expr (call (. (. t g) resize) 3 3))
    (expr (call cursor (& t) 2 2 "cursor follows its text through reflow"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 2 "no push when the cursor fits"))
    (let w _ (call term a 4 2 0))
    (expr (call (. w go) "ab\xe4\xb8\xad"))
    (expr (call (. (. w g) resize) 3 2))
    (expr (call eq (call (. w dump)) "ab\n\xe4\xb8\xad" "a wide char past the new edge moves to the next row"))
    (expr (call (. (. w g) resize) 8 2))
    (expr (call (. w go) "~[?1049h~[?1049l"))
    (expr (call eq (call (. w dump)) "ab\xe4\xb8\xad\n" "alt switch after resize"))
    (let v _ (call term a 4 2 0))
    (expr (call (. v go) "~[?1049hab\xe4\xb8\xad"))
    (expr (call (. (. v g) resize) 3 2))
    (expr (call eq (call (. v dump)) "ab\n" "the alt screen is cut, not reflowed"))
    (let s _ (call term a 10 6 0))
    (expr (call (. s go) "~[2;4r"))
    (expr (call (. (. s g) resize) 10 3))
    (expr (call eqi (. (. s g) top) 0 "region reset by resize"))
    (expr (call eqi (. (. s g) bot) 2 "region reset to the new height"))
    (expr (call (. s go) "~[1;1Habc"))
    (expr (call (. (. s g) resize) 300 100))
    (expr (call (. s go) "~[3;300Hz"))
    (expr (call ok (== (. (call (. (. s g) cell) 299 2) cp) 122) "storage growth past the limits keeps working"))
    (expr (call ok (&& (== (. (call (. (. s g) cell) 0 0) cp) 97) (== (. (call (. (. s g) cell) 2 0) cp) 99)) "content kept across growth"))))
  (fn reflow (params (a (ref Arena))) _ (block
    (let x30 _ (call repeat "x" 30 a))
    (let x10 _ (call repeat "x" 10 a))
    (let t _ (call term a 20 6 100))
    (expr (call (. t go) x30))
    (expr (call (. t go) "\r\nok"))
    (expr (call ok (&& (call (. (. t g) wrapped) 0) (! (call (. (. t g) wrapped) 1))) "a printed wrap is marked"))
    (expr (call (. (. t g) resize) 10 6))
    (expr (call eq (call (. t dump)) (call join (call repeat (call join x10 "\n" a) 3 a) "ok\n\n" a) "narrower: 3 rows of x then ok"))
    (expr (call cursor (& t) 2 3 "cursor after ok (narrow)"))
    (expr (call ok (&& (&& (call (. (. t g) wrapped) 0) (call (. (. t g) wrapped) 1)) (! (call (. (. t g) wrapped) 2))) "rewrapped rows are marked"))
    (expr (call (. (. t g) resize) 40 6))
    (expr (call eq (call (. t dump)) (call join x30 "\nok\n\n\n\n" a) "wider: one line again"))
    (expr (call cursor (& t) 2 1 "cursor after ok (wide)"))
    (let u _ (call term a 20 2 100))
    (expr (call (. u go) x30))
    (expr (call (. u go) "\r\nok"))
    (expr (call eqi (call (. (. u g) scrollbackLen)) 1 "first row in scrollback"))
    (expr (call (. (. u g) resize) 10 2))
    (expr (call eq (call (. u dump)) (call join x10 "\nok" a) "narrower with scrollback"))
    (expr (call eqi (call (. (. u g) scrollbackLen)) 2 "two rows of x in scrollback"))
    (expr (call cursor (& u) 2 1 "cursor (narrow, scrolled)"))
    (expr (call (. (. u g) resize) 40 2))
    (expr (call eq (call (. u dump)) (call join x30 "\nok" a) "wider with scrollback: joined back"))
    (expr (call eqi (call (. (. u g) scrollbackLen)) 0 "scrollback rows rejoined"))
    (expr (call cursor (& u) 2 1 "cursor (wide, scrolled)"))
    (let p _ (call term a 10 3 10))
    (expr (call (. p go) "abcdefghij"))
    (expr (call (. (. p g) resize) 5 3))
    (expr (call eq (call (. p dump)) "abcde\nfghij\n" "full row split"))
    (expr (call cursor (& p) 4 1 "cursor pending at the end"))
    (expr (call (. p go) "k"))
    (expr (call eq (call (. p dump)) "abcde\nfghij\nk" "the pending wrap survives a reflow"))))
  (fn marks (params (a (ref Arena))) _ (block
    (let t _ (call term a 4 2 0))
    (expr (call (. t go) "e\xcc\x81x"))
    (expr (call eq (call (. t dump)) "e\xcc\x81x\n" "a combining mark stays with its base"))
    (expr (call ok (&& (== (call (. (call (. (. t g) cell) 0 0) mark) 0) 769) (== (. (call (. (. t g) cell) 1 0) cp) 120)) "one cell for e + U+0301"))
    (expr (call (. t go) "\r\n\xcc\x81"))
    (expr (call eq (call (. t dump)) "e\xcc\x81x\n" "a mark at the start of a row is dropped"))
    (expr (call (. t go) "~[1;4Ho\xcc\x88\xcc\x84\xcc\x81"))
    (expr (call ok (&& (== (call (. (call (. (. t g) cell) 3 0) mark) 0) 776) (== (call (. (call (. (. t g) cell) 3 0) mark) 1) 772)) "two marks kept on a pending-wrap cell, a third dropped"))
    (expr (call (. t go) "~[2;1H\xe4\xb8\xad\xcc\x81"))
    (expr (call ok (== (call (. (call (. (. t g) cell) 0 1) mark) 0) 769) "a mark after a wide char goes on its head"))
    (expr (call (. t go) "~[2;1Hz"))
    (expr (call ok (== (. (call (. (. t g) cell) 0 1) marks) 0) "overwriting clears the marks"))))
  (fn dragWide (params (a (ref Arena))) _ (block
    (let t _ (call term a 80 4 50))
    (expr (call (. t go) "hello\r\nworld"))
    (for c (.. 81 1001) (block
      (expr (call (. (. t g) resize) c 4))))
    (for c (.. 0 920) (block
      (expr (call (. (. t g) resize) (- 1000 c) 4))))
    (expr (call ok (<= (. (. t g) reserves) 3) "one-column resizes grow storage geometrically"))
    (expr (call eq (call (. t dump)) "hello\nworld\n\n" "content survives a wide drag"))
    (expr (call (. (. t g) resize) 1000 4))
    (expr (call (. t go) "~[1;1H~[3;1Habc"))
    (expr (call ok (== (. (call (. (. t g) cell) 2 2) cp) 99) "grid usable after growth"))))
  (fn scrollback (params (a (ref Arena))) _ (block
    (let t _ (call term a 4 2 3))
    (expr (call (. t go) "1\r\n2\r\n3\r\n4\r\n5\r\n6\r\n7"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 3 "capped"))
    (expr (call eq (call (. (. t g) lineString) 0 a) "3" "oldest kept"))
    (expr (call eq (call (. (. t g) lineString) 2 a) "5" "newest scrollback"))
    (expr (call eq (call (. (. t g) lineString) 3 a) "6" "first screen row"))
    (expr (call eq (call (. (. t g) lineString) 4 a) "7" "last screen row"))
    (expr (call eqi (call (. (. t g) lineCount)) 5 "lineCount"))
    (expr (call eqi (. (call (. (. t g) viewLine) 1 0) len) 4 "view row width"))
    (expr (call eqi (call int (. (index (call (. (. t g) viewLine) 1 0) 0) cp)) 53 "viewLine scrolled back one line shows 5 first"))
    (expr (call eqi (call int (. (index (call (. (. t g) viewLine) 99 0) 0) cp)) 51 "view offset clamps to the oldest line"))
    (expr (call eqi (call int (. (index (call (. (. t g) viewLine) 0 1) 0) cp)) 55 "offset 0 is the screen"))
    (expr (call (. t go) "~[3J"))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 0 "ED 3 drops scrollback"))
    (let z _ (call term a 4 2 0))
    (expr (call (. z go) "1\r\n2\r\n3"))
    (expr (call eqi (call (. (. z g) scrollbackLen)) 0 "zero capacity keeps nothing"))
    (expr (call eq (call (. z dump)) "2\n3" "and still scrolls"))
    (let d _ (call term a 4 2 5))
    (expr (call (. (. d g) clearDirty)))
    (expr (call ok (! (call (. (. d g) anyDirty))) "clean after clearDirty"))
    (expr (call (. d go) "a"))
    (expr (call ok (&& (call (. (. d g) isDirty) 0) (! (call (. (. d g) isDirty) 1))) "print marks its row"))
    (expr (call (. (. d g) clearDirty)))
    (expr (call (. d go) "\r\n\r\nx"))
    (expr (call ok (&& (call (. (. d g) isDirty) 0) (call (. (. d g) isDirty) 1)) "a scroll marks the region"))))
  (fn lineOf (params (i int) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. t add) "line "))
    (expr (call (. t pushInt) i))
    (expr (call (. (call (. t add) " ") add) "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))
    (return (call (. t str)))))
  (fn bulk (params (a (ref Arena))) _ (block
    (let all _ (call (. Text new) a))
    (for i (.. 0 14000) (block
      (expr (call (. (call (. all add) (call lineOf i a)) add) "\r\n"))))
    (expr (call ok (> (call (. all len)) 900000) "about 1 MB of input"))
    (let t _ (call term a 80 24 1000))
    (expr (call (. (. t p) feed) (call (. all str)) (& (. t g))))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 1000 "scrollback capped"))
    (expr (call eq (call (. (. t g) lineString) (+ 1000 22) a) (call lineOf 13999 a) "last line"))
    (expr (call eq (call (. (. t g) lineString) (+ 1000 0) a) (call lineOf 13977 a) "first screen line"))
    (expr (call eq (call (. (. t g) lineString) (+ 1000 23) a) "" "cursor row is empty"))
    (expr (call eq (call (. (. t g) lineString) 0 a) (call lineOf (- 13977 1000) a) "oldest kept"))))
  (fn (doc "Scrollback is stored trimmed, and resizes free what they replace: storage stays at what the size needs.") memory (params (a (ref Arena))) _ (block
    (let t _ (call term a 200 24 10000))
    (for i (.. 0 20000) (block
      (expr (call (. t go) "hello world\r\n"))))
    (expr (call eqi (call (. (. t g) scrollbackLen)) 10000 "full scrollback"))
    (expr (call ok (<= (. (. (. t g) sbRing) len) (* (* 4 11) 10000)) "a short line takes words for its used cells, not the stride"))
    (expr (call (. t go) "~[31mred~]8;;http://x~\\link~]8;;~\\ e\xcc\x81~[0m\r\n"))
    (for i (.. 0 30) (block
      (expr (call (. t go) "x\r\n"))))
    (let want _ "redlink e\xcc\x81")
    (expr (call eq (call (. (. t g) lineString) (- (call (. (. t g) scrollbackLen)) 8) a) want "the marked line is in scrollback"))
    (expr (call (. (. t g) resize) 280 64))
    (let ring _ (. (. (. t g) sbRing) len))
    (let reserves _ (. (. t g) reserves))
    (for i (.. 0 300) (block
      (expr (call (. (. t g) resize) (+ 80 (% (* i 7) 201)) (+ 24 (% i 41))))))
    (expr (call (. (. t g) resize) 200 24))
    (expr (call eqi (. (. t g) reserves) reserves "no growth past the biggest size"))
    (expr (call ok (<= (. (. (. t g) sbRing) len) (* 2 ring)) "the ring does not grow with the number of resizes"))
    (expr (call ok (== (. (. (. t g) rfCells) len) 0) "reflow scratch is freed"))
    (let found _ (bool false))
    (for i (.. 0 (call (. (. t g) lineCount))) (block
      (= found (|| found (== (call (. (. t g) lineString) i a) want)))))
    (expr (call ok found "styled, linked, marked line survives"))
    (expr (call eq (call (. (. t g) lineString) 0 a) "hello world" "oldest line"))
    (expr (call (. (. t g) destroy)))))
  (fn fixtureDir (params) string (block
    (return (if-expr (call exists "stdlib/tests/term_fixtures/ls.bin") "stdlib/tests/term_fixtures/" "j3c/stdlib/tests/term_fixtures/"))))
  (fn readFix (params (name string) (a (ref Arena))) string (block
    (let t _ (call (. Text new) a))
    (expr (call (. (call (. t add) (call fixtureDir)) add) name))
    (let out _ "")
    (match (call readFile (call (. t str)) a)
      (arm (pats (variant Result.Ok (bind b))) (block
        (= out (as b string))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (interp "FAIL: cannot read fixture " (call (. t str)))))
        (expr (call panic "fixture")))))
    (return out)))
  (fn fixture (params (name string) (cols int) (rows int) (a (ref Arena))) _ (block
    (let bin _ (call (. Text new) a))
    (expr (call (. (call (. bin add) name) add) ".bin"))
    (let txt _ (call (. Text new) a))
    (expr (call (. (call (. txt add) name) add) ".txt"))
    (let t _ (call term a cols rows 100))
    (let bytes _ (call readFix (call (. bin str)) a))
    (expr (call (. (. t p) feed) bytes (& (. t g))))
    (let want _ (call readFix (call (. txt str)) a))
    (let got _ (call (. t dump)))
    (let w _ (if-expr (&& (> (. want len) 0) (== (index want (- (. want len) 1)) 10)) (slice-expr want 0 (- (. want len) 1)) want))
    (expr (call eq got w (interp "fixture " name)))
    (let u _ (call term a cols rows 100))
    (let i _ 0)
    (while (< i (. bytes len)) (block
      (let e _ (if-expr (< (+ i 7) (. bytes len)) (+ i 7) (. bytes len)))
      (expr (call (. (. u p) feed) (slice-expr bytes i e) (& (. u g))))
      (= i e)))
    (expr (call eq (call (. u dump)) got (interp "fixture " name " in pieces")))))
  (fn main (params) _ (block
    (let a _ (call (. Arena create) (* (* 256 1024) 1024)))
    (expr (call resizing (& a)))
    (expr (call reflow (& a)))
    (expr (call marks (& a)))
    (expr (call scrollback (& a)))
    (expr (call dragWide (& a)))
    (expr (call bulk (& a)))
    (expr (call memory (& a)))
    (expr (call fixture "ls" 80 24 (& a)))
    (expr (call fixture "vim" 80 24 (& a)))
    (expr (call fixture "less" 80 24 (& a)))
    (expr (call printLn "term_grid_scroll_test ok")))))
--- stderr
--- exit 0
