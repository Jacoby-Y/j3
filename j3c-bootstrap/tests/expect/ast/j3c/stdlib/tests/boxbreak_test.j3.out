(file (module boxbreak_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom (names Dom Frag))
  (use j3.ui.inputs)
  (use j3.text.same)
  (mod-let CHECKS int _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; width: 110px; } span { padding: 0 6px; border: 2px solid #ff0000; background: #888888; } .clone { box-decoration-break: clone; } .slice { box-decoration-break: slice; } .bad { box-decoration-break: nope; } .ra { text-align: right; } .ce { text-align: center; } .k { padding: 0 3px; border: 1px solid #00ff00; background: #444444; } .fx { display: flex; width: 20px; } .it { width: auto; } .top { vertical-align: top; } .tf { transform: translate(3px, 2px); } .sh { box-shadow: 0 2px 4px #000000; border-radius: 4px; }")
  (const WORDS string "alpha beta gamma delta epsilon zeta eta theta")
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff (float 0x3f947ae147ae147b)) (block
      (expr (call printLn (interp "FAIL: " msg ": got " a ", want " b)))
      (expr (call panic msg))))))
  (fn frame (params (d (ref Dom)) (cls string)) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (let s _ (call (. d open) 0 (call (. d tag) "span") 1))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) s cls))))
    (expr (call (. d text) WORDS))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return c)))
  (fn (doc "Lay out one frame set and return the block id.") build (params (d (ref Dom)) (cls string)) int (block
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let c _ (call frame d cls))
    (= c (call frame d cls))
    (return c)))
  (fn pieces (params (d (ref Dom)) (c int)) int (block
    (let n _ 0)
    (let b _ (. (index (. (. d nodes) items) c) box0))
    (while (>= b 0) (block
      (+= n 1)
      (= b (. (index (. (. d boxes) items) b) next))))
    (return n)))
  (fn piece (params (d (ref Dom)) (c int) (k int)) Frag (block
    (let b _ (. (index (. (. d nodes) items) c) box0))
    (while (> k 0) (block
      (= b (. (index (. (. d boxes) items) b) next))
      (-= k 1)))
    (return (index (. (. d boxes) items) b))))
  (fn (doc "Left edge and right edge of the text on the k-th line (by the pieces' y order).") lineMin (params (d (ref Dom)) (c int) (k int)) f32 (block
    (let y _ (. (call piece d c k) y))
    (let m f32 (float 0x40f86a0000000000))
    (let f _ (. (index (. (. d nodes) items) c) frag0))
    (while (>= f 0) (block
      (let fr _ (index (. (. d frags) items) f))
      (if (&& (&& (&& (== (. fr kind) 0) (> (+ (. fr y) (. fr asc)) y)) (< (+ (. fr y) (. fr asc)) (+ y (. (call piece d c k) ap)))) (< (. fr x) m)) (block
        (= m (. fr x))))
      (= f (. fr next))))
    (return m)))
  (fn lineMax (params (d (ref Dom)) (c int) (k int)) f32 (block
    (let y _ (. (call piece d c k) y))
    (let m f32 (float 0x0000000000000000))
    (let f _ (. (index (. (. d nodes) items) c) frag0))
    (while (>= f 0) (block
      (let fr _ (index (. (. d frags) items) f))
      (if (&& (&& (&& (== (. fr kind) 0) (> (+ (. fr y) (. fr asc)) y)) (< (+ (. fr y) (. fr asc)) (+ y (. (call piece d c k) ap)))) (> (+ (. fr x) (. fr w)) m)) (block
        (= m (+ (. fr x) (. fr w)))))
      (= f (. fr next))))
    (return m)))
  (struct (doc "The ids a nested frame hands back: block, outer span, inner span.") Ids
    (field c int)
    (field o int)
    (field i int))
  (fn addCls (params (d (ref Dom)) (id int) (cls string)) _ (block
    (let sp _ 0)
    (while (&& (< sp (. cls len)) (!= (index cls sp) 32)) (block
      (+= sp 1)))
    (if (> (. cls len) 0) (block
      (expr (call (. d cls) id (slice-expr cls 0 sp)))))
    (if (< sp (. cls len)) (block
      (expr (call (. d cls) id (slice-expr cls (+ sp 1) (. cls len))))))))
  (fn (doc "`<div blk><span o>alpha beta <span i>gamma delta epsilon </span>zeta eta theta</span>tail</div>`; without `i` the span is\nplain words, without `tail` nothing follows it. `wrap` puts the block in a flex container (its own item).") frame2 (params (d (ref Dom)) (blk string) (o string) (i string) (tail string) (wrap bool)) Ids (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4089000000000000)) (field y (float 0x4082c00000000000)))))
    (expr (call (. inputs begin) d))
    (let fx _ (- 1))
    (if wrap (block
      (= fx (call (. d open) 0 (call (. d tag) "div") 1))
      (expr (call (. d cls) fx "fx"))))
    (let c _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call addCls d c blk))
    (let os _ (call (. d open) 0 (call (. d tag) "span") 1))
    (expr (call addCls d os o))
    (let ins _ (- 1))
    (if (> (. i len) 0) (block
      (expr (call (. d text) "alpha beta "))
      (= ins (call (. d open) 0 (call (. d tag) "span") 1))
      (expr (call addCls d ins i))
      (expr (call (. d text) "gamma delta epsilon "))
      (expr (call (. d close)))
      (expr (call (. d text) "zeta eta theta"))) (block
      (expr (call (. d text) WORDS))))
    (expr (call (. d close)))
    (if (> (. tail len) 0) (block
      (expr (call (. d text) tail))))
    (expr (call (. d close)))
    (if wrap (block
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return (struct-lit Ids (field c c) (field o os) (field i ins)))))
  (fn build2 (params (d (ref Dom)) (blk string) (o string) (i string) (tail string) (wrap bool)) Ids (block
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let r _ (call frame2 d blk o i tail wrap))
    (= r (call frame2 d blk o i tail wrap))
    (return r)))
  (fn countOf (params (d (ref Dom)) (c int) (node int)) int (block
    (let n _ 0)
    (let b _ (. (index (. (. d nodes) items) c) box0))
    (while (>= b 0) (block
      (if (== (. (index (. (. d boxes) items) b) node) node) (block
        (+= n 1)))
      (= b (. (index (. (. d boxes) items) b) next))))
    (return n)))
  (fn pieceOf (params (d (ref Dom)) (c int) (node int) (k int)) Frag (block
    (let b _ (. (index (. (. d nodes) items) c) box0))
    (while (>= b 0) (block
      (if (== (. (index (. (. d boxes) items) b) node) node) (block
        (if (== k 0) (block
          (return (index (. (. d boxes) items) b))))
        (-= k 1)))
      (= b (. (index (. (. d boxes) items) b) next))))
    (expr (call panic "no such piece"))
    (return (index (. (. d boxes) items) 0))))
  (fn (doc "The text fragment that is last / first on the line whose top is within the piece `p`.") lineFrag (params (d (ref Dom)) (c int) (p Frag) (last bool)) Frag (block
    (let best _ (index (. (. d frags) items) (. (index (. (. d nodes) items) c) frag0)))
    (let have _ (bool false))
    (let f _ (. (index (. (. d nodes) items) c) frag0))
    (while (>= f 0) (block
      (let fr _ (index (. (. d frags) items) f))
      (if (&& (&& (== (. fr kind) 0) (> (+ (. fr y) (. fr asc)) (. p y))) (< (+ (. fr y) (. fr asc)) (+ (. p y) (. p ap)))) (block
        (if (|| (|| (! have) (&& last (> (. fr x) (. best x)))) (&& (! last) (< (. fr x) (. best x)))) (block
          (= best fr)
          (= have (bool true))))))
      (= f (. fr next))))
    (return best)))
  (fn (doc "Right / center alignment: the closing edge is counted once, so a piece that ends its line sits flush with the edge.") testAlign (params (mem (ref Arena)) (css (ref Css))) _ (block
    (for al (.. 0 2) (block
      (let cls _ (if-expr (== al 0) "ra" "ce"))
      (let d _ (call (. Dom new) mem css))
      (let r _ (call build2 (& d) cls "clone" "" "" (bool false)))
      (let m _ (call countOf (& d) (. r c) (. r o)))
      (expr (call ok (>= m 3) "aligned clone span wraps"))
      (for k (.. 0 m) (block
        (let p _ (call pieceOf (& d) (. r c) (. r o) k))
        (if (== al 0) (block
          (expr (call near (+ (. p x) (. p w)) (float 0x405b800000000000) "right-aligned clone piece is flush with the line end (closing edge counted once)"))) (block
          (expr (call near (+ (. p x) (/ (. p w) (float 0x4000000000000000))) (float 0x404b800000000000) "centered clone piece is centered (closing edge counted once)"))))))
      (let t _ (call (. Dom new) mem css))
      (let q _ (call build2 (& t) cls "clone" "" " tail" (bool false)))
      (let n _ (call countOf (& t) (. q c) (. q o)))
      (let lp _ (call pieceOf (& t) (. q c) (. q o) (- n 1)))
      (let tl _ (call lineFrag (& t) (. q c) lp (bool true)))
      (let gap _ (- (. tl x) (+ (. lp x) (. lp w))))
      (expr (call ok (&& (> gap (float 0x0000000000000000)) (< gap (float 0x4020000000000000))) "the last piece closes with its edge before the tail text, once"))
      (if (== al 0) (block
        (expr (call near (+ (. tl x) (. tl w)) (float 0x405b800000000000) "right-aligned line ends with the tail"))))))))
  (fn (doc "`inner` and `outer` pieces on a 3+ line wrap: edges per box follow its own value; the inner box sits inside the outer on every line.") testNested (params (mem (ref Arena)) (css (ref Css)) (o string) (i string)) _ (block
    (let d _ (call (. Dom new) mem css))
    (let r _ (call build2 (& d) "" o (if-expr (call same i "clone") "clone k" "slice k") "" (bool false)))
    (let mo _ (call countOf (& d) (. r c) (. r o)))
    (let mi _ (call countOf (& d) (. r c) (. r i)))
    (expr (call ok (>= mo 3) "nested: the outer span wraps over 3 lines"))
    (expr (call ok (>= mi 2) "nested: the inner span wraps"))
    (let oc _ (call same o "clone"))
    (let ic _ (call same i "clone"))
    (for k (.. 0 mo) (block
      (let p _ (call pieceOf (& d) (. r c) (. r o) k))
      (expr (call ok (== (. p start) (if-expr (|| oc (== k 0)) 1 0)) "nested: outer left edge"))
      (expr (call ok (== (. p end) (if-expr (|| oc (== k (- mo 1))) 1 0)) "nested: outer right edge"))
      (expr (call ok (<= (+ (. p x) (. p w)) (float 0x405b8147ae147ae1)) "nested: every outer piece fits the line"))
      (if oc (block
        (expr (call near (. p x) (float 0x0000000000000000) "nested: a cloned outer piece starts at the line start"))))))
    (for k (.. 0 mi) (block
      (let ip _ (call pieceOf (& d) (. r c) (. r i) k))
      (expr (call ok (== (. ip start) (if-expr (|| ic (== k 0)) 1 0)) "nested: inner left edge"))
      (expr (call ok (== (. ip end) (if-expr (|| ic (== k (- mi 1))) 1 0)) "nested: inner right edge"))
      (expr (call ok (<= (+ (. ip x) (. ip w)) (float 0x405b8147ae147ae1)) "nested: every inner piece fits the line"))
      (let inside _ (bool false))
      (for q (.. 0 mo) (block
        (let po _ (call pieceOf (& d) (. r c) (. r o) q))
        (if (&& (&& (&& (<= (- (. po y) (float 0x3f847ae147ae147b)) (. ip y)) (<= (. ip y) (+ (. po y) (float 0x4010000000000000)))) (<= (- (. po x) (float 0x3f847ae147ae147b)) (. ip x))) (<= (+ (. ip x) (. ip w)) (+ (+ (. po x) (. po w)) (float 0x3f847ae147ae147b)))) (block
          (= inside (bool true))))))
      (expr (call ok inside "nested: an inner piece lies inside an outer piece of its line"))))))
  (fn (doc "Min-content: a span as a shrink-to-fit flex item is exactly as wide as its widest piece, the longest word (`epsilon`, on a middle line) with its cloned edges.") testMin (params (mem (ref Arena)) (css (ref Css)) (cls string)) _ (block
    (let d _ (call (. Dom new) mem css))
    (let r _ (call build2 (& d) "it" cls "" "" (bool true)))
    (let w _ (. (index (. (. d nodes) items) (. r c)) w))
    (expr (call ok (&& (> w (float 0x4034000000000000)) (< w (float 0x405b800000000000))) "the flex item shrank to its min-content width"))
    (let widest f32 (float 0x0000000000000000))
    (for k (.. 0 (call countOf (& d) (. r c) (. r o))) (block
      (let p _ (call pieceOf (& d) (. r c) (. r o) k))
      (if (> (. p w) widest) (block
        (= widest (. p w))))
      (expr (call ok (<= (+ (. p x) (. p w)) (+ w (float 0x3f947ae147ae147b))) "no piece of the shrunk item overflows it"))))
    (expr (call near w widest "min-content is exactly the widest piece (clone counts both cloned edges of the longest word)"))))
  (fn (doc "`vertical-align: top` and a transform on the block: the pieces still follow their text, nothing moves in layout.") testPlace (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let d _ (call (. Dom new) mem css))
    (let r _ (call build2 (& d) "" "clone top" "" "" (bool false)))
    (let m _ (call countOf (& d) (. r c) (. r o)))
    (expr (call ok (>= m 3) "top: wraps"))
    (for k (.. 0 m) (block
      (let p _ (call pieceOf (& d) (. r c) (. r o) k))
      (let fr _ (call lineFrag (& d) (. r c) p (bool false)))
      (expr (call near (+ (. p y) (float 0x4000000000000000)) (. fr y) "top: a cloned piece sits on its line's text (border 2px)"))))
    (let t _ (call (. Dom new) mem css))
    (let q _ (call build2 (& t) "tf" "clone sh" "" "" (bool false)))
    (expr (call ok (|| (== (call countOf (& t) (. q c) (. q o)) m) (>= (call countOf (& t) (. q c) (. q o)) 3)) "transform + shadow: still wraps"))
    (for k (.. 0 (call countOf (& t) (. q c) (. q o))) (block
      (let tp _ (call pieceOf (& t) (. q c) (. q o) k))
      (let tfr _ (call lineFrag (& t) (. q c) tp (bool false)))
      (expr (call near (+ (. tp y) (float 0x4000000000000000)) (. tfr y) "transform + shadow: pieces sit on their lines"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (let ds _ (call (. Dom new) (& mem) (& css)))
    (let cs _ (call build (& ds) ""))
    (let n _ (call pieces (& ds) cs))
    (expr (call ok (>= n 3) "the span wraps over at least 3 lines"))
    (expr (call ok (&& (== (. (call piece (& ds) cs 0) start) 1) (== (. (call piece (& ds) cs 0) end) 0)) "slice: first piece is a start only"))
    (expr (call ok (&& (== (. (call piece (& ds) cs 1) start) 0) (== (. (call piece (& ds) cs 1) end) 0)) "slice: middle piece has neither edge"))
    (expr (call ok (&& (== (. (call piece (& ds) cs (- n 1)) start) 0) (== (. (call piece (& ds) cs (- n 1)) end) 1)) "slice: last piece is an end only"))
    (expr (call near (. (call piece (& ds) cs 0) x) (float 0x0000000000000000) "slice: first piece starts at the line start"))
    (expr (call near (call lineMin (& ds) cs 0) (float 0x4020000000000000) "slice: text starts after the padding and border on the first line"))
    (expr (call near (call lineMin (& ds) cs 1) (float 0x0000000000000000) "slice: a continuation line starts at the edge"))
    (expr (call near (. (call piece (& ds) cs 1) x) (float 0x0000000000000000) "slice: continuation piece starts at the edge"))
    (expr (call near (. (call piece (& ds) cs 0) w) (call lineMax (& ds) cs 0) "slice: a non-last piece ends at its text"))
    (expr (call near (. (call piece (& ds) cs (- n 1)) w) (+ (call lineMax (& ds) cs (- n 1)) (float 0x4020000000000000)) "slice: the last piece closes with the right edge"))
    (let dc _ (call (. Dom new) (& mem) (& css)))
    (let cc _ (call build (& dc) "clone"))
    (let m _ (call pieces (& dc) cc))
    (expr (call ok (> m n) "clone wraps over more lines: every piece is wider (here 6 vs 4)"))
    (for k (.. 0 m) (block
      (let p _ (call piece (& dc) cc k))
      (expr (call ok (&& (== (. p start) 1) (== (. p end) 1)) "clone: every piece has both edges"))
      (expr (call near (. p x) (float 0x0000000000000000) "clone: every piece starts at the line start"))
      (expr (call near (call lineMin (& dc) cc k) (float 0x4020000000000000) "clone: text on every line starts after the left padding and border"))
      (expr (call near (. p w) (+ (call lineMax (& dc) cc k) (float 0x4020000000000000)) "clone: every piece closes with the right padding and border"))
      (expr (call ok (<= (+ (. p x) (. p w)) (float 0x405b8147ae147ae1)) "clone: the closing edge fits in the line"))))
    (expr (call ok (|| (> m n) (<= (call lineMax (& dc) cc 0) (+ (call lineMax (& ds) cs 0) (float 0x3f847ae147ae147b)))) "clone's first line is no longer than slice's"))
    (let db _ (call (. Dom new) (& mem) (& css)))
    (let cb _ (call build (& db) "bad"))
    (expr (call ok (&& (== (call pieces (& db) cb) n) (== (. (call piece (& db) cb 1) start) 0)) "an invalid value is dropped (slice)"))
    (let dl _ (call (. Dom new) (& mem) (& css)))
    (let cl _ (call build (& dl) "slice"))
    (expr (call ok (&& (== (call pieces (& dl) cl) n) (== (. (call piece (& dl) cl 1) start) 0)) "explicit slice is the default"))
    (expr (call testAlign (& mem) (& css)))
    (expr (call testNested (& mem) (& css) "clone" "clone"))
    (expr (call testNested (& mem) (& css) "clone" "slice"))
    (expr (call testNested (& mem) (& css) "slice" "clone"))
    (expr (call testNested (& mem) (& css) "slice" "slice"))
    (expr (call testMin (& mem) (& css) "clone"))
    (expr (call testMin (& mem) (& css) "slice"))
    (expr (call testPlace (& mem) (& css)))
    (expr (call printLn (interp "boxbreak_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
