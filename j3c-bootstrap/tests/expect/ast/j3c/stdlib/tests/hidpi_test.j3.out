(file (module hidpi_test)
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.paint)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (fn ok (params (b bool) (msg string)) _ (block
    (if (! b) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 4 1024) 1024)))
    (expr (call (. game initGlHidden) "hidpi checks" 400 300))
    (let k f32 (float 0x3ff0000000000000))
    (if (call same (call (. game env) "J3_UI_SCALE") "2") (block
      (= k (float 0x4000000000000000))))
    (expr (call ok (== (call (. game dpiScale)) k) "dpiScale follows J3_UI_SCALE"))
    (let ws _ (call (. game windowSize)))
    (expr (call ok (&& (== (. ws x) (/ (float 0x4079000000000000) k)) (== (. ws y) (/ (float 0x4072c00000000000) k))) "windowSize is logical"))
    (let ds _ (call (. game drawSize)))
    (expr (call ok (&& (== (. ds x) (float 0x4079000000000000)) (== (. ds y) (float 0x4072c00000000000))) "drawSize is physical"))
    (let ui _ (call (. game uiSize)))
    (expr (call ok (== (. ui x) (. ws x)) "uiSize follows windowSize"))
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x 100) (field y 75)) (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255))))
    (expr (call (. paint flush)))
    (let px _ (call (. mem alloc) (targs u8) (* (* 400 300) 4)))
    (expr (call ok (call (. game readWindow) px) "read the frame"))
    (let edgeX _ (call int (* (float 0x4059000000000000) k)))
    (let edgeY _ (call int (* (float 0x4052c00000000000) k)))
    (expr (call ok (> (index px (* (- (+ (* (- edgeY 1) 400) edgeX) 1) 4)) 200) "the rect fills up to its scaled corner"))
    (expr (call ok (< (index px (* (+ (+ (* (+ edgeY 1) 400) edgeX) 1) 4)) 20) "and stops there"))
    (let ef _ (call (. game tryLoadFont) "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf" 16))
    (if (== (. ef raw) 0) (block
      (expr (call printLn "hidpi emoji: SKIPPED (no Noto Color Emoji)"))) (block
      (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
      (expr (call (. game p2Text) ef (struct-lit Vec2 (field x 20) (field y 20)) "\xf0\x9f\xa5\xb3" (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255)) (float 0x3ff0000000000000)))
      (expr (call (. paint flush)))
      (expr (call ok (call (. game readWindow) px) "read the emoji frame"))
      (let x0 _ 400)
      (let x1 _ 0)
      (for y (.. 0 300) (block
        (for x (.. 0 400) (block
          (if (> (+ (+ (call int (index px (* (+ (* y 400) x) 4))) (call int (index px (+ (* (+ (* y 400) x) 4) 1)))) (call int (index px (+ (* (+ (* y 400) x) 4) 2)))) 60) (block
            (if (< x x0) (block
              (= x0 x)))
            (if (> x x1) (block
              (= x1 x)))))))))
      (let span _ (call f32 (+ (- x1 x0) 1)))
      (expr (call ok (&& (&& (>= x1 x0) (>= span (* (float 0x4024000000000000) k))) (<= span (* (float 0x4038000000000000) k))) "emoji ink spans about the font size at this scale"))))
    (expr (call printLn "hidpi_test ok")))))
--- stderr
--- exit 0
