(file (module hotkey_test)
  (use j3.game.Key)
  (use j3.game.hotkey)
  (use j3.game.hotkey.HotkeyError)
  (use j3.io.printLn)
  (use j3.result.Result)
  (use j3.sys.panic)
  (fn main (params) _ (block
    (match (call (. hotkey register) (. Key F8) (+ (. hotkey CTRL) (. hotkey SHIFT)))
      (arm (pats (variant Result.Ok (bind h))) (block
        (expr (call panic "hotkey_test: registered under offscreen"))))
      (arm (pats (variant Result.Err (bind e))) (block) (tail (match e
        (arm (pats (variant HotkeyError.NoDisplay)) (block
          (expr (call printLn "ok: NoDisplay"))))
        (arm (pats (variant HotkeyError.Unsupported)) (block
          (expr (call panic "hotkey_test: Unsupported"))))
        (arm (pats (variant HotkeyError.Taken)) (block
          (expr (call panic "hotkey_test: Taken"))))
        (arm (pats (variant HotkeyError.UnknownKey)) (block
          (expr (call panic "hotkey_test: UnknownKey"))))
        (arm (pats (variant HotkeyError.Full)) (block
          (expr (call panic "hotkey_test: Full")))))))))))
--- stderr
--- exit 0
