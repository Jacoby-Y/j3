(file (module j2_lib_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Args Value Limits))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (struct Case
    (field src string)
    (field want string))
  (const OUT (array 38 Case) (array-lit (struct-lit Case (field src "print(len([1, 2, 3]), len(\"h\xc3\xa9llo\"), len({ a: 1, b: 2 }), len([]));") (field want "3 6 2 0\n")) (struct-lit Case (field src "print(type(nil), type(true), type(1), type(1.5), type(\"s\"), type([]), type({}), type(print), type(fn() {}));") (field want "nil bool int float string array table fn fn\n")) (struct-lit Case (field src "print(str(1) + str(2.5) + str(nil), str([1, \"a\"]), str(\"x\") == \"x\");") (field want "12.5nil [1, \"a\"] true\n")) (struct-lit Case (field src "print(int(3.9), int(-3.9), int(\"42\"), int(\" -7 \"), int(\"2.5\"), int(\"x\"), int(5));") (field want "3 -3 42 -7 2 nil 5\n")) (struct-lit Case (field src "print(float(2), float(\"1.5\"), float(\"1e3\"), float(\"no\"), 7 / float(2));") (field want "2.0 1.5 1000.0 nil 3.5\n")) (struct-lit Case (field src "let xs = [1]; push(xs, 2); xs.push(3); print(xs);") (field want "[1, 2, 3]\n")) (struct-lit Case (field src "let xs = [1, 2]; print(pop(xs), xs.pop(), xs.pop(), xs);") (field want "2 1 nil []\n")) (struct-lit Case (field src "let xs = [1, 3]; insert(xs, 1, 2); xs.insert(3, 4); xs.insert(0, 0); print(xs);") (field want "[0, 1, 2, 3, 4]\n")) (struct-lit Case (field src "let xs = [5, 6, 7]; print(remove(xs, 1), str(xs), xs.remove(0), xs);") (field want "6 [5, 7] 5 [7]\n")) (struct-lit Case (field src "print(pick([]), pick([9]), type(pick([1, 2, 3])));") (field want "nil 9 int\n")) (struct-lit Case (field src "print(map([1, 2, 3], fn(x) { return x * 10; }), [\"a\"].map(upper), map([], str));") (field want "[10, 20, 30] [\"A\"] []\n")) (struct-lit Case (field src "print(filter([1, 2, 3, 4], fn(x) { return x % 2 == 0; }), filter([1], fn(x) { return false; }));") (field want "[2, 4] []\n")) (struct-lit Case (field src "print(find([1, 5, 8], fn(x) { return x > 3; }), find([1], fn(x) { return x > 3; }));") (field want "5 nil\n")) (struct-lit Case (field src "let xs = [3, 1, 2, -5, 1.5]; sort(xs); print(xs); let ys = [\"b\", \"a\", \"c\"]; ys.sort(); print(ys);") (field want "[-5, 1, 1.5, 2, 3]\n[\"a\", \"b\", \"c\"]\n")) (struct-lit Case (field src "let es = [{ n: \"a\", hp: 3 }, { n: \"b\", hp: 1 }, { n: \"c\", hp: 3 }, { n: \"d\", hp: 0 }]; sort(es, fn(x, y) { return x.hp > y.hp; }); print(map(es, fn(e) { return e.n; }));") (field want "[\"a\", \"c\", \"b\", \"d\"]\n")) (struct-lit Case (field src "let xs = []; for i in 0..200 { xs.push((i * 7919) % 200); } sort(xs); let ok = true; for i in 0..200 { if xs[i] != i { ok = false; } } print(ok, len(xs));") (field want "true 200\n")) (struct-lit Case (field src "let xs = [5, 3, 9, 1, 4]; sort(xs, fn(a, b) { return true; }); print(len(xs)); sort(xs, fn(a, b) { return nil; }); print(len(xs));") (field want "5\n5\n")) (struct-lit Case (field src "print(join([1, \"a\", 2.5], \", \"), join([], \"-\"), [\"x\", \"y\"].join(\"\"), join([1, 2]));") (field want "1, a, 2.5  xy 12\n")) (struct-lit Case (field src "let t = { b: 1, a: 2 }; t.c = 3; t.b = nil; print(keys(t), keys({}));") (field want "[\"a\", \"c\"] []\n")) (struct-lit Case (field src "let t = { a: 1, n: nil }; print(has(t, \"a\"), has(t, \"n\"), t.has(\"zz\"));") (field want "true false false\n")) (struct-lit Case (field src "print(upper(\"abZ1\xc3\xa9\"), \"MiX\".lower());") (field want "ABZ1\xc3\xa9 mix\n")) (struct-lit Case (field src "print(`[{trim(\"  hi there \\n\")}]`, `[{trim(\"\")}]`);") (field want "[hi there] []\n")) (struct-lit Case (field src "print(split(\"a,,b\", \",\"), split(\"abc\", \"--\"), \"x--y--\".split(\"--\"));") (field want "[\"a\", \"\", \"b\"] [\"abc\"] [\"x\", \"y\", \"\"]\n")) (struct-lit Case (field src "print(contains(\"slime king\", \"me k\"), \"abc\".contains(\"\"), contains(\"ab\", \"abc\"));") (field want "true true false\n")) (struct-lit Case (field src "print(slice(\"hello\", 1, 3), slice(\"hello\", 2), slice(\"hi\", -5, 99), `[{slice(\"hi\", 3)}]`, `[{slice(\"abc\", 2, 1)}]`);") (field want "el llo hi [] []\n")) (struct-lit Case (field src "print(math.pi > 3.14, math.sqrt(16), math.abs(-3), math.abs(-2.5), math.floor(2.7), math.ceil(2.1), math.floor(-0.5));") (field want "true 4.0 3 2.5 2 3 -1\n")) (struct-lit Case (field src "print(math.sin(0), math.cos(0), math.tan(0), math.atan2(0, 1));") (field want "0.0 1.0 0.0 0.0\n")) (struct-lit Case (field src "print(math.min(3, 1.5, 2), math.max(1, 7, 2), math.min(4));") (field want "1.5 7 4\n")) (struct-lit Case (field src "print(math.clamp(5, 0, 1), math.clamp(-2, 0, 1), math.clamp(0.5, 0, 1), math.lerp(0, 10, 0.25));") (field want "1 0 0.5 2.5\n")) (struct-lit Case (field src "let r = rand(2, 3); let m = math.random(-1, 0); print(r >= 2 && r < 3, m >= -1 && m < 0, type(r));") (field want "true true float\n")) (struct-lit Case (field src "error(\"never\" + \"!\") ; print(1);") (field want "")) (struct-lit Case (field src "let ys = map([3, 1, 2], fn(x) { let t = { v: x, s: `#{x}`, junk: [x, x, x] }; return t; }); sort(ys, fn(a, b) { let tmp = [a.s, b.s, { k: a.v }]; return tmp[2].k < b.v; }); print(map(ys, fn(y) { return y.s; }));") (field want "[\"#1\", \"#2\", \"#3\"]\n")) (struct-lit Case (field src "let words = split(\"the quick brown fox\", \" \"); let big = map(words, fn(w) { return upper(w) + \"!\"; }); print(join(filter(big, fn(w) { return len(w) > 4; }), \"_\"), find(words, fn(w) { return contains(w, \"ow\"); }));") (field want "QUICK!_BROWN! brown\n")) (struct-lit Case (field src "let xs = [1, 2, 3, 4]; print(map(xs, fn(x) { xs.pop(); return x; }));") (field want "[1, 2]\n")) (struct-lit Case (field src "let a = [{ x: 1 }, { x: 2 }, { x: 3 }]; let r = filter(a, fn(v) { remove(a, 0); v = 0; let z = { q: 1 }; return true; }); let junk = []; for i in 0..50 { push(junk, { y: i }); } let f = find([{ x: 7 }], fn(v) { v = 0; let z = { q: 1 }; return true; }); push(junk, { y: 1 }); print(r[0].x, len(r), f.x);") (field want "1 2 7\n")) (struct-lit Case (field src "let xs = [4, 3, 2, 1]; sort(xs, fn(a, b) { xs.push(9); return a < b; }); print(xs);") (field want "[1, 2, 3, 4]\n")) (struct-lit Case (field src "fn deep(n) { if n == 0 { return [0]; } return map(deep(n - 1), fn(x) { return x + 1; }); } print(deep(20));") (field want "[20]\n")) (struct-lit Case (field src "let t = { a: 1 }; let u = {}; u[1] = 2; print(has(t, 1), keys(u));") (field want "false [1]\n"))))
  (const ERRS (array 20 Case) (array-lit (struct-lit Case (field src "len(5);") (field want "t:1:4: len: argument 1 must be an array, string or table, got int")) (struct-lit Case (field src "int(true);") (field want "t:1:4: int: argument 1 must be a number or string, got bool")) (struct-lit Case (field src "int(1e300);") (field want "t:1:4: int: 1e+300 doesn't fit in an int")) (struct-lit Case (field src "float([]);") (field want "t:1:6: float: argument 1 must be a number or string, got array")) (struct-lit Case (field src "push(\"s\", 1);") (field want "t:1:5: push: argument 1 must be an array, got string")) (struct-lit Case (field src "insert([1], 5, 0);") (field want "t:1:7: insert: index 5 is out of range (0 to 1)")) (struct-lit Case (field src "remove([], 0);") (field want "t:1:7: remove: index 0 is out of range (0 to -1)")) (struct-lit Case (field src "map([1], 5);") (field want "t:1:4: map: argument 2 must be a function, got int")) (struct-lit Case (field src "map([1, 2], fn(x) { return x / 0; });") (field want "t:1:30: division by zero")) (struct-lit Case (field src "filter([1], fn(x) { error(\"bad\", x); });") (field want "t:1:26: bad 1")) (struct-lit Case (field src "sort([1, \"a\", 2]);") (field want "t:1:5: can't compare string and int")) (struct-lit Case (field src "sort([3, 1], fn(a, b) { return a.x < 1; });") (field want "t:1:33: can't read field \"x\" of int")) (struct-lit Case (field src "sort([1], 3);") (field want "t:1:5: sort: argument 2 must be a function, got int")) (struct-lit Case (field src "keys([]);") (field want "t:1:5: keys: argument 1 must be a table, got array")) (struct-lit Case (field src "upper(1);") (field want "t:1:6: upper: argument 1 must be a string, got int")) (struct-lit Case (field src "split(\"a\", \"\");") (field want "t:1:6: split: the separator can't be empty")) (struct-lit Case (field src "slice(\"a\", \"b\");") (field want "t:1:6: slice: argument 2 must be an int, got string")) (struct-lit Case (field src "math.sqrt(\"4\");") (field want "t:1:10: math.sqrt: argument 1 must be a number, got string")) (struct-lit Case (field src "math.max();") (field want "t:1:9: math.max: argument 1 must be a number, got nil")) (struct-lit Case (field src "rand(1);") (field want "t:1:5: rand: argument 2 must be a number, got nil"))))
  (fn capture (params (vm (ref Vm)) (args Args)) Value (block
    (let t _ (as (. vm host) (ref Text)))
    (expr (call (. t pushStr) (call (. args joined) " ")))
    (expr (call (. t push) 10))
    (return (call (. j2 nil)))))
  (fn newVm (params (mem (ref Arena)) (out (ref Text)) (stress bool)) Vm (block
    (let vm _ (call (. Vm new) mem (struct-lit Limits)))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" capture))
    (= (. vm host) (as out ptr))
    (= (. vm gcStress) stress)
    (return vm)))
  (fn same (params (got string) (want string) (src string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "source: " src)))
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn runOut (params (mem (ref Arena)) (c Case) (stress bool)) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out) stress))
    (match (call (. vm loadString) "t" (. c src))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call same (call (. out str)) (. c want) (. c src) "printed output"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (if (> (. (. c want) len) 0) (block
          (expr (call printLn (interp "source: " (. c src))))
          (expr (call printLn (. e message)))
          (expr (call panic "unexpected script error"))))
        (expr (call same (. e message) "t:1:6: never!" (. c src) "error()")))))
    (expr (call (. vm destroy)))))
  (fn runErr (params (mem (ref Arena)) (c Case) (stress bool)) _ (block
    (let out _ (call (. Text new) mem))
    (let vm _ (call newVm mem (& out) stress))
    (match (call (. vm loadString) "t" (. c src))
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call printLn (interp "source: " (. c src))))
        (expr (call panic "expected a script error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call same (. e message) (. c want) (. c src) "error text")))))
    (match (call (. vm loadString) "u" "print(len([1]));")
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "vm broken after a lib error")))))
    (if (|| (|| (!= (. vm nframes) 0) (!= (. vm top) 0)) (!= (. vm callDepth) 0)) (block
      (expr (call panic "not unwound"))))
    (expr (call (. vm destroy)))))
  (fn (doc "`pick` / `rand` / `math.random` replay from `vm.seed`, whatever else ran.") testSeed (params (mem (ref Arena))) _ (block
    (let src _ "pub fn roll() { let xs = []; for i in 0..8 { xs.push(pick([1, 2, 3, 4, 5, 6])); xs.push(int(rand(0, 100))); xs.push(int(math.random(0, 100))); } return str(xs); }")
    (let got (array 3 string) (array-lit "" "" ""))
    (for k (.. 0 3) (block
      (let out _ (call (. Text new) mem))
      (let vm _ (call newVm mem (& out) (bool false)))
      (if (== k 2) (block
        (expr (call (. vm seed) 99))) (block
        (expr (call (. vm seed) 7))))
      (match (call (. vm loadString) "r" src)
        (arm (pats (variant Result.Ok (bind ex))) (block) (tail (match (call (. vm call) (call (. (call (. ex asTable)) get) "roll") (call (. j2 noArgs)))
          (arm (pats (variant Result.Ok (bind v))) (block
            (let t _ (call (. Text new) mem))
            (expr (call (. t pushStr) (call (. v asStr))))
            (= (index got k) (call (. t str)))))
          (arm (pats (variant Result.Err (bind e))) (block
            (expr (call printLn (. e message)))
            (expr (call panic "roll")))))))
        (arm (pats (variant Result.Err (bind e))) (block
          (expr (call printLn (. e message)))
          (expr (call panic "roll load")))))
      (expr (call (. vm destroy)))))
    (expr (call same (index got 0) (index got 1) "seed 7" "same seed, same rolls"))
    (if (== (index got 0) (index got 2)) (block
      (expr (call panic "different seeds gave the same rolls"))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (for-each _ c OUT (block
      (expr (call runOut (& mem) c (bool false)))))
    (for-each _ c ERRS (block
      (expr (call runErr (& mem) c (bool false)))))
    (for-each _ c OUT (block
      (expr (call runOut (& mem) c (bool true)))))
    (for-each _ c ERRS (block
      (expr (call runErr (& mem) c (bool true)))))
    (expr (call testSeed (& mem)))
    (expr (call printLn "j2_lib_test ok")))))
--- stderr
--- exit 0
