(file (module gpu_glsl_test)
  (use j3.gpu (names Source attrib))
  (use j3.io.printLn)
  (use j3.math (names Mat4 Vec2 Vec3))
  (use j3.game)
  (use j3.sys.panic)
  (use j3.text.cstr)
  (struct vertex Quad
    (field q Vec2))
  (struct vertex-instance Inst
    (field rect vec4f)
    (field k Vec2)
    (field _pad Vec2))
  (struct varying V
    (field position vec4)
    (field uv vec2)
    (field flat rect vec4))
  (mod-let uniform uScreen vec2 _)
  (mod-let uniform uTex sampler2D _)
  (mod-let uniform uTint vec4 _)
  (const KERNEL (array 3 f32) (array-lit (float 0x3fd0000000000000) (float 0x3fe0000000000000) (float 0x3fd0000000000000)))
  (fn shader unusedHelper (params (x f32)) f32 (block
    (return x)))
  (fn shader shade (params (input vec4) (sample f32)) vec4 (block
    (let mix _ input)
    (= (. mix rgb) (* (* (. mix rgb) sample) (. uTint rgb)))
    (return mix)))
  (fn shader-vertex vs (params (q Quad) (i Inst)) V (block
    (let p _ (+ (. (. i rect) xy) (* (. q q) (. (. i rect) zw))))
    (let ndc _ (- (* (/ p uScreen) (float 0x4000000000000000)) (float 0x3ff0000000000000)))
    (return (struct-lit V (field position (call vec4 (. ndc x) (- (. ndc y)) (float 0x0000000000000000) (float 0x3ff0000000000000))) (field uv (. q q)) (field rect (. i rect))))))
  (fn shader-fragment fs (params (v V)) vec4 (block
    (let c _ (call @texture uTex (. v uv)))
    (let a _ (float 0x0000000000000000))
    (for k (.. 0 3) (block
      (+= a (* (index KERNEL k) (. c a)))))
    (if (< a (float 0x3f847ae147ae147b)) (block
      (expr (call @discard))))
    (return (call shade c a))))
  (fn shader-vertex vsFull (params) V (block
    (let id _ (call @vertexId))
    (let p _ (call vec2 (call f32 (& (<< id 1) 2)) (call f32 (& id 2))))
    (return (struct-lit V (field position (call vec4 (- (* p (float 0x4000000000000000)) (float 0x3ff0000000000000)) (float 0x0000000000000000) (float 0x3ff0000000000000))) (field uv p) (field rect (call vec4 (float 0x0000000000000000)))))))
  (fn shader-fragment fsKinds (params (v V)) vec4 (block
    (let kind _ (call i32 (. (. v rect) x)))
    (let c _ (call vec4 (float 0x0000000000000000)))
    (match kind
      (arm (pats (lit 0)) (block
        (= c (call vec4 (. v uv) (float 0x0000000000000000) (float 0x3ff0000000000000)))))
      (arm (pats (lit 1)) (block
        (= c (call vec4 (float 0x3ff0000000000000)))))
      (arm (pats (wild)) (block
        (= c (call vec4 (call @mix (call vec3 (float 0x0000000000000000)) (call vec3 (float 0x3ff0000000000000)) (float 0x3fe0000000000000)) (float 0x3ff0000000000000))))))
    (return c)))
  (const PROG Source (call @shader vs fs))
  (const FULL Source (call @shader vsFull fsKinds))
  (struct vertex Mesh
    (field pos Vec3)
    (field uv Vec2)
    (field id u32))
  (struct vertex-instance Model
    (field m Mat4)
    (field tint vec4f))
  (struct varying KV
    (field position vec4)
    (field uv vec2)
    (field id u32)
    (field n vec3))
  (struct shader Light
    (field dir vec3)
    (field power f32))
  (mod-let uniform uViewProj mat4 _)
  (mod-let uniform uLights (array 2 vec4) _)
  (mod-let uniform uImg sampler2D _)
  (const PI _ (float 0x400921f9f01b866e))
  (const TAU f32 (float 0x401921f9f01b866e))
  (fn shader bump (params (x (ref f32)) (by f32)) _ (block
    (+= x by)))
  (fn shader lighting (params (l Light) (n vec3)) f32 (block
    (return (* (call @max (call @dot n (call @normalize (. l dir))) (float 0x0000000000000000)) (. l power)))))
  (fn shader-vertex kvs (params (m Mesh) (i Model)) KV (block
    (let w _ (* (. i m) (call vec4 (. m pos) (float 0x3ff0000000000000))))
    (return (struct-lit KV (field position (* uViewProj w)) (field uv (. m uv)) (field id (. m id)) (field n (. w xyz))))))
  (fn shader-fragment kfs (params (v KV)) vec4 (block
    (let lights (array 2 vec4) (array-lit (index uLights 0) (index uLights 1)))
    (let acc _ (float 0x0000000000000000))
    (let i _ 0)
    (while (< i 2) (block
      (let l _ (struct-lit Light (field dir (. (index lights i) xyz)) (field power (. (index lights i) w))))
      (expr (call bump (& acc) (call lighting l (call @normalize (. v n)))))
      (+= i 1)))
    (let size _ (call @textureSize uImg 0))
    (let t _ (call @texelFetch uImg (call ivec2 (call i32 (& (. v id) 3)) 0) 0))
    (let k _ (if-expr (> (. v id) 2) (float 0x3ff0000000000000) acc))
    (let flag _ (&& (== (& (. v id) 1) 1) (> acc (float 0x3fb999999999999a))))
    (let shade _ (if-expr flag (/ TAU PI) (float 0x3ff0000000000000)))
    (return (call vec4 (* (* (. t rgb) shade) k) (/ (call f32 (. size x)) (float 0x4070000000000000))))))
  (const KITCHEN Source (call @shader kvs kfs))
  (struct vertex A
    (field p Vec2))
  (struct varying W
    (field position vec4)
    (field mix vec2))
  (fn shader-vertex vq (params (input A) (r A)) W (block
    (return (struct-lit W (field position (call vec4 (+ (. input p) (. r p)) (float 0x0000000000000000) (float 0x3ff0000000000000))) (field mix (. r p))))))
  (fn shader-fragment fq (params (output W)) vec4 (block
    (return (call vec4 (. output mix) (float 0x0000000000000000) (float 0x3ff0000000000000)))))
  (const QUIRKS Source (call @shader vq fq))
  (mod-let LOG (array 4096 u8) _)
  (fn (doc "Compile one stage; the driver's log is printed when it refuses.") stage (params (what string) (kind u32) (src string)) u32 (block
    (let mk _ (as (call (. game glProc) "glCreateShader") (fn-type (u32) u32)))
    (let sh _ (call mk kind))
    (let source _ (as (call (. game glProc) "glShaderSource") (fn-type (u32 i32 ptr ptr) _)))
    (let full _ (call (. game prepGl) src))
    (let p _ (as (. full ptr) ptr))
    (let n _ (call i32 (. full len)))
    (expr (call source sh 1 (as (& p) ptr) (as (& n) ptr)))
    (let comp _ (as (call (. game glProc) "glCompileShader") (fn-type (u32) _)))
    (expr (call comp sh))
    (let status _ (as (call (. game glProc) "glGetShaderiv") (fn-type (u32 u32 ptr) _)))
    (let ok i32 0)
    (expr (call status sh 35713 (as (& ok) ptr)))
    (if (== ok 0) (block
      (let log _ (as (call (. game glProc) "glGetShaderInfoLog") (fn-type (u32 i32 ptr ptr) _)))
      (let len i32 0)
      (expr (call log sh 4095 (as (& len) ptr) (as (& (index LOG 0)) ptr)))
      (expr (call printLn (interp what " did not compile:")))
      (expr (call printLn (as (slice-lit u8 (field ptr (& (index LOG 0))) (field len (call int len))) string)))
      (return 0)))
    (return sh)))
  (fn (doc "Compile, link and look up every uniform the program names.") check (params (name string) (s (ref Source))) bool (block
    (let vs _ (call stage (interp name " vertex") 35633 (. s vert)))
    (let fs _ (call stage (interp name " fragment") 35632 (. s frag)))
    (if (|| (== vs 0) (== fs 0)) (block
      (return (bool false))))
    (let mk _ (as (call (. game glProc) "glCreateProgram") (fn-type () u32)))
    (let prog _ (call mk))
    (let attach _ (as (call (. game glProc) "glAttachShader") (fn-type (u32 u32) _)))
    (expr (call attach prog vs))
    (expr (call attach prog fs))
    (let linkFn _ (as (call (. game glProc) "glLinkProgram") (fn-type (u32) _)))
    (expr (call linkFn prog))
    (let status _ (as (call (. game glProc) "glGetProgramiv") (fn-type (u32 u32 ptr) _)))
    (let ok i32 0)
    (expr (call status prog 35714 (as (& ok) ptr)))
    (if (== ok 0) (block
      (let log _ (as (call (. game glProc) "glGetProgramInfoLog") (fn-type (u32 i32 ptr ptr) _)))
      (let len i32 0)
      (expr (call log prog 4095 (as (& len) ptr) (as (& (index LOG 0)) ptr)))
      (expr (call printLn (interp name " did not link:")))
      (expr (call printLn (as (slice-lit u8 (field ptr (& (index LOG 0))) (field len (call int len))) string)))
      (return (bool false))))
    (let loc _ (as (call (. game glProc) "glGetUniformLocation") (fn-type (u32 ptr) i32)))
    (let start _ 0)
    (for i (..= 0 (. (. s uniforms) len)) (block
      (if (|| (== i (. (. s uniforms) len)) (== (index (. s uniforms) i) 32)) (block
        (let u _ (as (slice-expr (. s uniforms) start i) string))
        (if (&& (> (. u len) 0) (< (call loc prog (as (call cstr u) ptr)) 0)) (block
          (expr (call printLn (interp name ": uniform " u " has no location")))
          (return (bool false))))
        (= start (+ i 1))))))
    (expr (call printLn (interp name " ok (" (. s count) " attributes)")))
    (return (bool true))))
  (fn main (params) _ (block
    (expr (call (. game initGlHidden) "gpu_glsl_test" 64 64))
    (let a _ (call check "PROG" (& PROG)))
    (let b _ (call check "FULL" (& FULL)))
    (let c _ (call check "KITCHEN" (& KITCHEN)))
    (let d _ (call check "QUIRKS" (& QUIRKS)))
    (if (|| (|| (|| (! a) (! b)) (! c)) (! d)) (block
      (expr (call panic "gpu_glsl_test FAILED"))))
    (expr (call printLn (interp "gpu_glsl_test ok es=" (call (. game isGles))))))))
--- stderr
--- exit 0
