(file (module j2_parse_test)
  (use j3.io (names exists printLn readFile))
  (use j3.j2.parse)
  (use j3.j2.lex.Tok)
  (use j3.j2.parse (names Ast Kind Node))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call panic msg))))))
  (fn parseOk (params (file string) (src string) (mem (ref Arena))) Ast (block
    (match (call (. parse parse) file src mem)
      (arm (pats (variant Result.Ok (bind ast))) (block
        (return ast)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e text)))
        (expr (call panic "unexpected parse error")))))
    (return (call parseOk file "" mem))))
  (fn (doc "print(parse(src)) reparses and prints the same text again.") roundTrip (params (file string) (src string) (mem (ref Arena))) string (block
    (let a _ (call parseOk file src mem))
    (let p1 _ (call (. parse print) (& a) mem))
    (let b _ (call parseOk file p1 mem))
    (let p2 _ (call (. parse print) (& b) mem))
    (if (! (== p1 p2)) (block
      (expr (call printLn "---- first print"))
      (expr (call printLn p1))
      (expr (call printLn "---- second print"))
      (expr (call printLn p2))
      (expr (call panic "round trip differs"))))
    (expr (call ok (== (. (. a nodes) len) (. (. b nodes) len)) "round trip keeps the node count"))
    (return p1)))
  (fn bad (params (src string) (want string) (mem (ref Arena))) _ (block
    (match (call (. parse parse) "bad.j2" src mem)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call printLn (interp "no error for: " src)))
        (expr (call panic "expected a parse error"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (if (! (== (. e text) want)) (block
          (expr (call printLn (interp "source [" src "]")))
          (expr (call printLn (interp "got  [" (. e text) "]")))
          (expr (call printLn (interp "want [" want "]")))
          (expr (call panic "parse error text")))))))))
  (fn scriptDir (params) string (block
    (if (call exists "examples/j2_script/j2-scripts/hello/main.j2") (block
      (return "examples/j2_script/j2-scripts/")))
    (return "../examples/j2_script/j2-scripts/")))
  (fn testScripts (params (mem (ref Arena))) _ (block
    (let names (array 4 string) (array-lit "base" "hello" "slimes" "turrets"))
    (for i (.. 0 (. names len)) (block
      (let path _ (call (. Text new) mem))
      (expr (call (. path pushStr) (call scriptDir)))
      (expr (call (. path pushStr) (index names i)))
      (expr (call (. path pushStr) "/main.j2"))
      (match (call readFile (call (. path str)) mem)
        (arm (pats (variant Result.Ok (bind bytes))) (block
          (expr (call roundTrip (call (. path str)) (as bytes string) mem))))
        (arm (pats (variant Result.Err (wild))) (block
          (expr (call printLn (call (. path str))))
          (expr (call panic "cannot read example script")))))))))
  (fn first (params (a (ref Ast))) (ref Node) (block
    (return (call (. a node) (call (. a kid) (. a root) 0)))))
  (fn testShapes (params (mem (ref Arena))) _ (block
    (let a _ (call parseOk "t" "let v = 1 + 2 * 3 == 7 && !x || y;" mem))
    (let let0 _ (call first (& a)))
    (expr (call ok (&& (== (. let0 kind) (. Kind Let)) (== (. let0 s) "v")) "let"))
    (let or _ (call (. a node) (. let0 a)))
    (expr (call ok (&& (== (. or kind) (. Kind Binary)) (== (. or op) (. Tok Or))) "|| loosest"))
    (let and _ (call (. a node) (. or a)))
    (expr (call ok (== (. and op) (. Tok And)) "&& under ||"))
    (let eq _ (call (. a node) (. and a)))
    (expr (call ok (&& (== (. eq op) (. Tok Eq)) (== (. (call (. a node) (. eq a)) op) (. Tok Plus))) "== over +"))
    (expr (call ok (== (. (call (. a node) (. (call (. a node) (. eq a)) b)) op) (. Tok Star)) "* binds tighter"))
    (expr (call ok (&& (== (. (call (. a node) (. and b)) kind) (. Kind Unary)) (== (. (call (. a node) (. and b)) op) (. Tok Not))) "unary !"))
    (expr (call ok (&& (== (. eq line) 1) (== (. eq col) 19)) "binary position is the operator"))
    (expr (call eqText (call roundTrip "t" "let v = (1 + 2) * -(3 - 4) - (5 - 6);" mem) "let v = (1 + 2) * -(3 - 4) - (5 - 6);\n" "parens kept where needed"))
    (expr (call eqText (call roundTrip "t" "let v = ((a.b)[1])(2);" mem) "let v = a.b[1](2);\n" "postfix needs none"))
    (let m _ (call parseOk "t" "let t = { pos: fn(this, a) { return this.x; }, \"a b\": 1, };\nt.pos(1);" mem))
    (let tbl _ (call a2 (& m) (. (call first (& m)) a)))
    (expr (call ok (&& (== (. tbl kind) (. Kind Table)) (== (. tbl count) 2)) "table pairs"))
    (let pos _ (call (. m node) (call (. m kid) (. (call first (& m)) a) 0)))
    (expr (call ok (&& (== (. pos s) "pos") (== (. (call (. m node) (. pos a)) kind) (. Kind Fn))) "fn field"))
    (expr (call ok (!= (& (. (call (. m node) (. pos a)) flags) (. parse F_THIS)) 0) "this flag"))
    (expr (call ok (!= (& (. (call (. m node) (call (. m kid) (. (call first (& m)) a) 1)) flags) (. parse F_QUOTED)) 0) "quoted key"))
    (let call _ (call (. m node) (. (call (. m node) (call (. m kid) (. m root) 1)) a)))
    (expr (call ok (&& (&& (== (. call kind) (. Kind Call)) (== (. (call (. m node) (. call a)) kind) (. Kind Field))) (== (. call count) 1)) "method call"))
    (let tp _ (call parseOk "t" "print(`a {x.y(z, `in {n}`)} b {1}`);" mem))
    (let tn _ (call (. tp node) (call (. tp kid) (. (call first (& tp)) a) 0)))
    (expr (call ok (&& (== (. tn kind) (. Kind Tpl)) (== (. tn count) 5)) "template parts"))
    (expr (call ok (== (. (call (. tp node) (call (. tp kid) (call (. tp kid) (. (call first (& tp)) a) 0) 0)) s) "a ") "template head text"))
    (expr (call roundTrip "t" "print(`a {x.y(z, `in {n}`)} b {1} \\{ \\` c`);" mem))
    (let src _ "use base;\npub const A = 1;\npub fn f(a, b) {\n    for i in 0..3 { continue; }\n    for k, v in t { break; }\n    for v in xs {}\n    while a < b { a += 1; }\n    match a { 1 {} -2 {} \"s\" {} true {} nil {} 2.5 {} _ { return; } }\n    if a {} else if b {} else {}\n    {}\n    return a;\n}\nlet half = fn(v) { return v / 2; };\nx.y[1] = nil;\n")
    (let s _ (call parseOk "t" src mem))
    (expr (call ok (== (. (call (. s node) (call (. s kid) (. s root) 0)) kind) (. Kind Use)) "use"))
    (let c _ (call (. s node) (call (. s kid) (. s root) 1)))
    (expr (call ok (&& (== (. c kind) (. Kind Let)) (== (. c flags) (| (. parse F_PUB) (. parse F_CONST)))) "pub const"))
    (let f _ (call (. s node) (call (. s kid) (. s root) 2)))
    (expr (call ok (&& (&& (&& (== (. f kind) (. Kind FnDecl)) (== (. f s) "f")) (== (. f count) 2)) (!= (& (. f flags) (. parse F_PUB)) 0)) "pub fn"))
    (let body _ (call (. s node) (. f b)))
    (expr (call ok (&& (== (. (call (. s node) (call (. s kid) (. f b) 0)) kind) (. Kind ForRange)) (== (. (call (. s node) (call (. s kid) (. f b) 0)) s) "i")) "range for"))
    (expr (call ok (&& (== (. (call (. s node) (call (. s kid) (. f b) 1)) kind) (. Kind ForIn)) (== (. (call (. s node) (call (. s kid) (. f b) 1)) count) 2)) "for k, v"))
    (expr (call ok (== (. (call (. s node) (call (. s kid) (. f b) 2)) count) 1) "for v"))
    (let mt _ (call (. s node) (call (. s kid) (. f b) 4)))
    (expr (call ok (&& (== (. mt kind) (. Kind Match)) (== (. mt count) 7)) "match arms"))
    (expr (call ok (== (. (call (. s node) (. (call (. s node) (call (. s kid) (call (. s kid) (. f b) 4) 1)) a)) i) (- 2)) "negative pattern"))
    (expr (call ok (== (. (call (. s node) (call (. s kid) (call (. s kid) (. f b) 4) 6)) a) (- 1)) "_ arm"))
    (expr (call ok (== (. body count) 8) "fn body statements"))
    (let asg _ (call (. s node) (call (. s kid) (. s root) 4)))
    (expr (call ok (&& (&& (== (. asg kind) (. Kind Assign)) (== (. asg op) (. Tok Assign))) (== (. (call (. s node) (. asg a)) kind) (. Kind Index))) "index assign"))
    (expr (call roundTrip "t" src mem))
    (expr (call roundTrip "t" "({a: 1}).b();\n({}).c = 1;\nlet e = 1e300 + 0.1 + 3.0 + 0x10;" mem))))
  (fn a2 (params (a (ref Ast)) (n int)) (ref Node) (block
    (return (call (. a node) n))))
  (fn eqText (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp what ": got [" got "] want [" want "]")))
      (expr (call panic what))))))
  (fn testErrors (params (mem (ref Arena))) _ (block
    (expr (call bad "fn f() {\n    let x = 1;\n" "bad.j2:3:1: expected `}`, found end of file" mem))
    (expr (call bad "let = 3;" "bad.j2:1:5: expected a name after `let`, found `=`" mem))
    (expr (call bad "match x {\n}" "bad.j2:2:1: expected a match arm, found `}`" mem))
    (expr (call bad "let a = 1;\nelse { }" "bad.j2:2:1: `else` without `if`" mem))
    (expr (call bad "let a = 1\nlet b = 2;" "bad.j2:2:1: expected `;`, found `let`" mem))
    (expr (call bad "f(1, 2;" "bad.j2:1:7: expected `,` or `)`, found `;`" mem))
    (expr (call bad "let t = { a 1 };" "bad.j2:1:13: expected `:`, found `1`" mem))
    (expr (call bad "1 + 2 = 3;" "bad.j2:1:1: can only assign to a name, a field or an index" mem))
    (expr (call bad "fn f() { pub let x = 1; }" "bad.j2:1:10: `pub` is only allowed at the top level" mem))
    (expr (call bad "fn f() { use a; }" "bad.j2:1:10: `use` is only allowed at the top level" mem))
    (expr (call bad "const C;" "bad.j2:1:8: expected `=`, found `;`" mem))
    (expr (call bad "print(`a {} b`);" "bad.j2:1:11: expected an expression, found `}`" mem))
    (expr (call bad "match x { y {} }" "bad.j2:1:11: expected a match pattern (a number, string, `true`, `false`, `nil` or `_`), found `y`" mem))
    (expr (call bad "for i, v in 0..3 {}" "bad.j2:1:14: a range loop takes one variable" mem))
    (expr (call bad "x = \"oops;" "bad.j2:1:5: unterminated string" mem))
    (expr (call bad "let s = `a\nb\n{c d}`;" "bad.j2:3:4: expected `}` to close the `{` in the string, found `d`" mem))
    (let deep _ (call (. Text new) mem))
    (expr (call (. deep pushStr) "let x = "))
    (for i (.. 0 5000) (block
      (expr (call (. deep push) 40))))
    (expr (call bad (call (. deep str)) "bad.j2:1:208: too deeply nested" mem))
    (let deepIf _ (call (. Text new) mem))
    (for i (.. 0 5000) (block
      (expr (call (. deepIf pushStr) "if a {"))))
    (match (call (. parse parse) "bad.j2" (call (. deepIf str)) mem)
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "deep blocks parsed"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call ok (== (. e msg) "too deeply nested") "deep blocks")))))
    (let src _ "pub fn f(a) { let t = {x: [1, `s{a.b(2)}`], y: fn(this) { return -this.x; }}; match a { 1 { } _ { } } for k, v in t { t[k] = nil; } }")
    (for n (.. 0 (. src len)) (block
      (match (call (. parse parse) "cut.j2" (slice-expr src 0 n) mem)
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (wild))) (block)))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 22)))
    (expr (call testScripts (& mem)))
    (expr (call testShapes (& mem)))
    (expr (call testErrors (& mem)))
    (expr (call printLn "j2_parse_test ok")))))
--- stderr
--- exit 0
