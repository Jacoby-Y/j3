(file (module glsl_test)
  (use j3.gfx.glsl)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.text (names contains find same))
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "Number of newline bytes in `s`.") lines (params (s string)) int (block
    (let n _ 0)
    (for i (.. 0 (. s len)) (block
      (if (== (index s i) 10) (block
        (+= n 1)))))
    (return n)))
  (fn main (params) _ (block
    (let plain _ "#version 330 core\nin vec2 vUv;\nout vec4 oColor;\nuniform sampler2D uTex;\nvoid main(){ oColor = texture(uTex, vUv); }\n")
    (let d _ (call (. glsl prep) plain (bool false)))
    (expr (call ok (&& (== (. d ptr) (. plain ptr)) (== (. d len) (. plain len))) "desktop returns the input unchanged"))
    (let e _ (call (. glsl prep) plain (bool true)))
    (expr (call ok (== (call find e "#version 300 es\n") 0) "starts with #version 300 es"))
    (expr (call ok (! (call contains e "330")) "no 330 left"))
    (expr (call ok (call contains e "precision highp float;") "float precision"))
    (expr (call ok (call contains e "precision highp int;") "int precision"))
    (expr (call ok (call contains e "precision highp sampler2D;") "sampler2D precision when used"))
    (expr (call ok (! (call contains e "sampler3D")) "no sampler3D precision when unused"))
    (expr (call ok (call contains e "void main(){ oColor = texture(uTex, vUv); }") "body kept"))
    (expr (call ok (< (call find e "precision highp float;") (call find e "in vec2 vUv;")) "precision before declarations"))
    (expr (call ok (== (call lines e) (call lines plain)) "line count unchanged, so driver log lines match the source"))
    (let ext _ "#version 330 core\n#extension GL_OES_standard_derivatives : enable\n#define TRACE_LEVEL 2\nuniform sampler2DShadow uShadow;\nvoid main(){}\n")
    (let x _ (call (. glsl prep) ext (bool true)))
    (expr (call ok (< (call find x "#extension") (call find x "precision highp float;")) "precision after #extension"))
    (expr (call ok (< (call find x "#define TRACE_LEVEL 2") (call find x "precision highp float;")) "precision after #define"))
    (expr (call ok (call contains x "precision highp sampler2DShadow;") "shadow sampler precision"))
    (expr (call ok (== (call lines x) (call lines ext)) "line count unchanged with directives"))
    (let bare _ "void main(){}\n")
    (expr (call ok (== (. (call (. glsl prep) bare (bool false)) ptr) (. bare ptr)) "desktop leaves a version-less source alone"))
    (let b _ (call (. glsl prep) bare (bool true)))
    (expr (call ok (== (call find b "#version 300 es\n") 0) "version-less source gets #version 300 es"))
    (expr (call ok (call contains b "void main(){}") "version-less body kept"))
    (let only _ (call (. glsl prep) "#version 330 core" (bool true)))
    (expr (call ok (&& (== (call find only "#version 300 es\n") 0) (call contains only "precision highp float;")) "version-only source"))
    (let cond _ "#version 330 core\n#ifdef FOO\nuniform float a;\n#endif\nvoid main(){}\n")
    (let c _ (call (. glsl prep) cond (bool true)))
    (expr (call ok (< (call find c "precision highp float;") (call find c "#ifdef FOO")) "precision before a leading #ifdef"))
    (expr (call ok (== (call lines c) (call lines cond)) "line count unchanged with #ifdef"))
    (let com _ "#version 330 core\n// note\n#extension GL_X : enable\nvoid main(){}\n")
    (let m _ (call (. glsl prep) com (bool true)))
    (expr (call ok (< (call find m "#extension") (call find m "precision highp float;")) "precision after comment then #extension"))
    (expr (call ok (== (call lines m) (call lines com)) "line count unchanged with comment"))
    (let blank _ "#version 330 core\n\n#extension GL_X : enable\nvoid main(){}\n")
    (let k _ (call (. glsl prep) blank (bool true)))
    (expr (call ok (< (call find k "#extension") (call find k "precision highp float;")) "precision after blank then #extension"))
    (expr (call ok (== (call lines k) (call lines blank)) "line count unchanged with blank line"))
    (let lead _ (call (. glsl prep) "// header\n#version 330 core\nvoid main(){}\n" (bool true)))
    (expr (call ok (&& (&& (> (call find lead "#version 300 es") 0) (! (call contains lead "330"))) (! (call contains lead "#version 300 es\n#version"))) "comment before #version"))
    (expr (call printLn "glsl_test ok")))))
--- stderr
--- exit 0
