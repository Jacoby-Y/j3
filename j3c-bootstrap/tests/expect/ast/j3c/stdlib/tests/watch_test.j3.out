(file (module watch_test)
  (use j3.io.printLn)
  (use j3.io.watch (names Event Kind Watcher))
  (use j3.memory (names Arena List newArena))
  (use j3.proc)
  (use j3.result.Result)
  (use j3.sys.panic)
  (const D _ "/tmp/j3_watch_test/d")
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn eq (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn sh (params (cmd string) (a (ref Arena))) _ (block
    (match (call (. proc run) (array-lit "/bin/sh" "-c" cmd) "" a)
      (arm (pats (variant Result.Ok (bind o))) (block
        (expr (call ok (== (. o code) 0) cmd))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) cmd)))))))
  (fn kindNo (params (k Kind)) int (block
    (match k
      (arm (pats (variant Kind.Create)) (block
        (return 0)))
      (arm (pats (variant Kind.Delete)) (block
        (return 1)))
      (arm (pats (variant Kind.Modify)) (block
        (return 2)))
      (arm (pats (variant Kind.MoveIn)) (block
        (return 3)))
      (arm (pats (variant Kind.MoveOut)) (block
        (return 4)))
      (arm (pats (variant Kind.Overflow)) (block
        (return 5))))
    (return (- 1))))
  (fn (doc "How many events in `evs` match.") count (params (evs (ref (gen List Event))) (id int) (k Kind) (name string)) int (block
    (let n _ 0)
    (for i (.. 0 (. evs len)) (block
      (let e _ (index (. evs items) i))
      (if (&& (&& (== (. e id) id) (== (call kindNo (. e kind)) (call kindNo k))) (call eq (. e name) name)) (block
        (+= n 1)))))
    (return n)))
  (fn countId (params (evs (ref (gen List Event))) (id int)) int (block
    (let n _ 0)
    (for i (.. 0 (. evs len)) (block
      (let e _ (index (. evs items) i))
      (if (== (. e id) id) (block
        (+= n 1)))))
    (return n)))
  (fn addOk (params (w (ref Watcher)) (path string)) int (block
    (match (call (. w add) path)
      (arm (pats (variant Result.Ok (bind id))) (block
        (return id)))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call ok (bool false) path)))))
    (return (- 1))))
  (fn drain (params (w (ref Watcher)) (evs (ref (gen List Event)))) _ (block
    (= (. evs len) 0)
    (expr (call (. w poll) evs))))
  (fn main (params) _ (block
    (let a _ (call newArena 1048576))
    (expr (call sh "rm -rf /tmp/j3_watch_test && mkdir -p /tmp/j3_watch_test/d && printf 'v1' > /tmp/j3_watch_test/d/f.txt" (& a)))
    (let w _ (call (. Watcher create) (& a)))
    (let dirId _ (call addOk (& w) D))
    (let fileId _ (call addOk (& w) "/tmp/j3_watch_test/d/f.txt"))
    (expr (call ok (!= dirId fileId) "two ids"))
    (match (call (. w add) "/tmp/j3_watch_test/nope")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call ok (bool false) "add missing"))))
      (arm (pats (variant Result.Err (wild))) (block)))
    (let evs _ (call (. (type-path List Event) new) (& a)))
    (expr (call ok (== (call (. w poll) (& evs)) 0) "quiet at start"))
    (expr (call sh "touch /tmp/j3_watch_test/d/new.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) dirId (. Kind Create) "new.txt") 1) "create"))
    (expr (call ok (== (call countId (& evs) fileId) 0) "file watch ignores siblings"))
    (expr (call sh "rm /tmp/j3_watch_test/d/new.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) dirId (. Kind Delete) "new.txt") 1) "delete"))
    (expr (call sh "printf x > /tmp/j3_watch_test/out.txt && mv /tmp/j3_watch_test/out.txt /tmp/j3_watch_test/d/in.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) dirId (. Kind MoveIn) "in.txt") 1) "move in"))
    (expr (call sh "mv /tmp/j3_watch_test/d/in.txt /tmp/j3_watch_test/gone.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) dirId (. Kind MoveOut) "in.txt") 1) "move out"))
    (expr (call sh "printf v2 >> /tmp/j3_watch_test/d/f.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (>= (call count (& evs) fileId (. Kind Modify) "") 1) "file modify"))
    (expr (call ok (>= (call count (& evs) dirId (. Kind Modify) "f.txt") 1) "folder sees the write"))
    (expr (call sh "printf v3 > /tmp/j3_watch_test/d/.f.tmp && mv /tmp/j3_watch_test/d/.f.tmp /tmp/j3_watch_test/d/f.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) fileId (. Kind Modify) "") 1) "rename over is Modify"))
    (expr (call ok (== (call count (& evs) fileId (. Kind Delete) "") 0) "rename over is not Delete"))
    (expr (call ok (== (call count (& evs) dirId (. Kind MoveIn) "f.txt") 1) "folder sees the rename"))
    (expr (call sh "printf v4 >> /tmp/j3_watch_test/d/f.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (>= (call count (& evs) fileId (. Kind Modify) "") 1) "modify after replace"))
    (expr (call sh "rm /tmp/j3_watch_test/d/f.txt && touch /tmp/j3_watch_test/d/f.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (&& (== (call count (& evs) fileId (. Kind Delete) "") 1) (== (call count (& evs) fileId (. Kind Create) "") 1)) "delete + create"))
    (expr (call (. w remove) fileId))
    (expr (call (. w remove) fileId))
    (expr (call (. w remove) 999))
    (expr (call sh "printf v5 >> /tmp/j3_watch_test/d/f.txt" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call countId (& evs) fileId) 0) "removed file watch is quiet"))
    (expr (call ok (>= (call count (& evs) dirId (. Kind Modify) "f.txt") 1) "folder still watched"))
    (expr (call sh "rm -rf /tmp/j3_watch_test/d" (& a)))
    (expr (call drain (& w) (& evs)))
    (expr (call ok (== (call count (& evs) dirId (. Kind Delete) "") 1) "folder deleted"))
    (expr (call (. w remove) dirId))
    (let used _ (. a used))
    (for i (.. 0 100) (block
      (expr (call drain (& w) (& evs)))))
    (expr (call ok (== (. a used) used) "poll allocates nothing"))
    (expr (call (. w close)))
    (expr (call (. w close)))
    (expr (call ok (== (call (. w poll) (& evs)) 0) "closed"))
    (expr (call sh "rm -rf /tmp/j3_watch_test" (& a)))
    (expr (call printLn "watch_test ok")))))
--- stderr
--- exit 0
