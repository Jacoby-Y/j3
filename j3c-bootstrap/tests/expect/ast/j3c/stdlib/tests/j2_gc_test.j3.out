(file (module j2_gc_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Vm Args Value Limits Ref))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (struct Host
    (field out Text)
    (field maxBytes int))
  (fn hostOf (params (vm (ref Vm))) (ref Host) (block
    (return (as (. vm host) (ref Host)))))
  (fn capture (params (vm (ref Vm)) (args Args)) Value (block
    (let h _ (call hostOf vm))
    (expr (call (. (. h out) pushStr) (call (. args joined) " ")))
    (expr (call (. (. h out) push) 10))
    (return (call (. j2 nil)))))
  (fn (doc "`probe()`: remember the largest heap size seen.") probe (params (vm (ref Vm)) (_args Args)) Value (block
    (let h _ (call hostOf vm))
    (let b _ (. (call (. vm stats)) bytes))
    (if (> b (. h maxBytes)) (block
      (= (. h maxBytes) b)))
    (return (call (. j2 nil)))))
  (fn (doc "`holder(f)`: a new table held only in this native's J3 local while `f` runs (and allocates);\nit must come back whole.") holder (params (vm (ref Vm)) (args Args)) Value (block
    (let f _ (call (. args func) 0))
    (let t _ (call (. vm newTable)))
    (expr (call (. t set) "name" (call (. j2 str) vm "held")))
    (let one (array 1 Value) (array-lit (call (. j2 int) 500)))
    (match (call (. vm call) f (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (return (call (. vm passOn))))))
    (let s _ (call (. j2 str) vm "made before more calls"))
    (match (call (. vm call) f (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (return (call (. vm passOn))))))
    (expr (call (. t set) "note" s))
    (return (call (. t value)))))
  (fn newVm (params (mem (ref Arena)) (h (ref Host)) (limits Limits)) Vm (block
    (let vm _ (call (. Vm new) mem limits))
    (expr (call (. vm openLibs) (. j2 LIB_ALL)))
    (expr (call (. vm bind) "print" capture))
    (expr (call (. vm bind) "probe" probe))
    (expr (call (. vm bind) "holder" holder))
    (= (. vm host) (as h ptr))
    (return vm)))
  (fn load (params (vm (ref Vm)) (src string)) Value (block
    (match (call (. vm loadString) "t" src)
      (arm (pats (variant Result.Ok (bind t))) (block
        (return t)))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "unexpected script error")))))))
  (fn check (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp "got  [" got "]")))
      (expr (call printLn (interp "want [" want "]")))
      (expr (call panic what))))))
  (fn (doc "1M short-lived tables: the heap never holds more than 4 MB.") testChurn (params (mem (ref Arena))) _ (block
    (let h _ (struct-lit Host (field out (call (. Text new) mem)) (field maxBytes 0)))
    (let vm _ (call newVm mem (& h) (struct-lit Limits)))
    (expr (call load (& vm) "let keep = { n: 0 };\nfor i in 0..1000000 {\n    let t = { a: i, b: [i] };\n    keep.n += t.a - i + 1;\n    if i % 5000 == 0 { probe(); }\n}\nprint(keep.n);"))
    (expr (call check (call (. (. h out) str)) "1000000\n" "churn result"))
    (let st _ (call (. vm stats)))
    (if (|| (>= (. h maxBytes) (<< 4 20)) (>= (. st bytes) (<< 4 20))) (block
      (expr (call panic (interp "churn heap too big: max " (. h maxBytes))))))
    (if (< (. st collections) 10) (block
      (expr (call panic "churn never collected"))))
    (expr (call (. vm destroy)))))
  (fn (doc "Kept values survive collections; released ones get freed.") testKeep (params (mem (ref Arena))) _ (block
    (let h _ (struct-lit Host (field out (call (. Text new) mem)) (field maxBytes 0)))
    (let vm _ (call newVm mem (& h) (struct-lit Limits)))
    (let ex _ (call (. vm keep) (call load (& vm) "pub fn make(n) { let xs = []; for i in 0..n { xs.push({ i: i, s: `item {i}` }); } return xs; }")))
    (expr (call (. vm collect)))
    (let base _ (. (call (. vm stats)) liveObjects))
    (let one (array 1 Value) (array-lit (call (. j2 int) 1000)))
    (let r _ (call (. j2 none)))
    (match (call (. vm call) (call (. (call (. vm get) ex) get) "make") (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (= r (call (. vm keep) v))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "make")))))
    (expr (call (. vm collect)))
    (let held _ (. (call (. vm stats)) liveObjects))
    (if (< held (+ base 2001)) (block
      (expr (call panic (interp "kept values were freed: " held " vs " base)))))
    (let xs _ (call (. vm value) r))
    (let last _ (call (. (call (. j2 arrOf) xs) get) 999))
    (if (|| (!= (call (. (call (. last asTable)) getNum) "i" (float 0x0000000000000000)) (float 0x408f380000000000)) (! (== (call (. (call (. last asTable)) getStr) "s" "") "item 999"))) (block
      (expr (call panic "kept value changed"))))
    (expr (call (. vm release) r))
    (expr (call (. vm collect)))
    (let after _ (. (call (. vm stats)) liveObjects))
    (if (> after (+ base 10)) (block
      (expr (call panic (interp "released values not freed: " after " vs " base)))))
    (match (call (. vm call) (call (. (call (. vm get) ex) get) "make") (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (!= (. (call (. j2 arrOf) v) len) 1000) (block
          (expr (call panic "module after collect"))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "make after collect")))))
    (expr (call (. vm release) ex))
    (expr (call (. vm destroy)))))
  (fn (doc "Dead strings leave the intern table; live ones (and new equal ones) still compare equal.") testWeakStrings (params (mem (ref Arena))) _ (block
    (let h _ (struct-lit Host (field out (call (. Text new) mem)) (field maxBytes 0)))
    (let vm _ (call newVm mem (& h) (struct-lit Limits)))
    (let ex _ (call (. vm keep) (call load (& vm) "pub let names = [];\nfor i in 0..20000 { let s = `tmp {i}`; if i % 1000 == 0 { names.push(s); } }\npub fn has(s) { for n in names { if n == s { return true; } } return false; }")))
    (expr (call (. vm collect)))
    (let n _ (. (. vm heap) strCount))
    (if (> n 2000) (block
      (expr (call panic (interp "dead strings stay interned: " n)))))
    (if (call (. (call (. (. vm heap) lookupStr) "tmp 5000") isNil)) (block
      (expr (call panic "live string lost"))))
    (if (! (call (. (call (. (. vm heap) lookupStr) "tmp 5001") isNil))) (block
      (expr (call panic "dead string still found"))))
    (let one (array 1 Value) (array-lit (call (. j2 str) (& vm) "tmp 7000")))
    (match (call (. vm call) (call (. (call (. vm get) ex) get) "has") (slice-expr one 0 1))
      (arm (pats (variant Result.Ok (bind v))) (block
        (if (! (call (. v truthy))) (block
          (expr (call panic "re-interned string differs"))))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call printLn (. e message)))
        (expr (call panic "has")))))
    (expr (call (. vm destroy)))))
  (fn (doc "Closures, upvalues, protos and their constants survive collections at every safe point; a\nnative's temporaries survive its callbacks.") testStress (params (mem (ref Arena))) _ (block
    (let h _ (struct-lit Host (field out (call (. Text new) mem)) (field maxBytes 0)))
    (let vm _ (call newVm mem (& h) (struct-lit Limits)))
    (= (. vm gcStress) (bool true))
    (expr (call load (& vm) "fn counter() { let n = 0; return fn() { n += 1; return `n={n}`; }; }\nlet c = counter();\nlet junk = fn(k) { let a = []; for i in 0..k { a.push({ v: str(i) }); } return a; };\nlet t = holder(junk);\nc(); junk(100);\nprint(c(), t.name, t.note, len(t));"))
    (expr (call check (call (. (. h out) str)) "n=2 held made before more calls 2\n" "stress output"))
    (if (< (. (call (. vm stats)) collections) 100) (block
      (expr (call panic "stress mode didn't collect"))))
    (expr (call (. vm destroy)))))
  (fn (doc "The heap cap counts live memory: garbage gets collected first, real growth stops the script,\nand the VM works again once the data is gone.") testCap (params (mem (ref Arena))) _ (block
    (let h _ (struct-lit Host (field out (call (. Text new) mem)) (field maxBytes 0)))
    (let vm _ (call newVm mem (& h) (struct-lit Limits (field heapBytes (<< 2 20)))))
    (expr (call load (& vm) "for i in 0..200000 { let t = { a: [i, i] }; } print(\"garbage is fine\");"))
    (match (call (. vm loadString) "grow" "let xs = []; while true { xs.push({ a: 1 }); }")
      (arm (pats (variant Result.Ok (wild))) (block
        (expr (call panic "expected out of script memory"))))
      (arm (pats (variant Result.Err (bind e))) (block
        (expr (call check (slice-expr (. e message) (- (. (. e message) len) 20) (. (. e message) len)) "out of script memory" "cap")))))
    (expr (call load (& vm) "let ys = []; for i in 0..1000 { ys.push({ b: i }); } print(len(ys));"))
    (expr (call check (call (. (. h out) str)) "garbage is fine\n1000\n" "after cap"))
    (expr (call (. vm destroy)))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (expr (call testChurn (& mem)))
    (expr (call testKeep (& mem)))
    (expr (call testWeakStrings (& mem)))
    (expr (call testStress (& mem)))
    (expr (call testCap (& mem)))
    (expr (call printLn "j2_gc_test ok")))))
--- stderr
--- exit 0
