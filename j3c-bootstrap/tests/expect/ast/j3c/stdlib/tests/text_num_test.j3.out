(file (module text_num_test)
  (use j3.game (names loadFont setTextMode textCaretX TextMode textWidth Font))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.math.Vec2)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let FONTPATH string _)
  (const SHEET string "@font-face { font-family: \"T\"; src: url(\"speculative/42_ui_numeric/assets/num.ttf\"); } .box { font-family: \"T\"; font-size: 16px; } .tab { font-variant-numeric: tabular-nums; } .wave { text-wave-amplitude: 2px; text-wave-length: 40px; text-wave-period: 1s; }")
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (expr (call ok (<= d tol) msg))))
  (fn bytes (params (s string)) (slice u8) (block
    (return (slice-lit u8 (field ptr (. s ptr)) (field len (. s len))))))
  (fn w (params (f Font) (s string)) f32 (block
    (return (call textWidth f (call bytes s) (bool false)))))
  (fn (doc "Width of the text of a nowrap block with `cls`, from its laid-out box (shrink-to-fit in a flex row).") boxW (params (mem (ref Arena)) (css (ref Css)) (cls string) (text string)) f32 (block
    (let d _ (call (. Dom new) mem css))
    (expr (call (. d begin)))
    (let row _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d styleStr) row 1 "display" "flex"))
    (let id _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) id "box"))
    (let a _ 0)
    (for i (.. 0 (+ (. cls len) 1)) (block
      (if (|| (== i (. cls len)) (== (index cls i) 32)) (block
        (if (> i a) (block
          (expr (call (. d cls) id (slice-expr cls a i)))))
        (= a (+ i 1))))))
    (expr (call (. d text) text))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d end)))
    (expr (call (. d layoutAt) (float 0x4089000000000000) (float 0x4079000000000000)))
    (return (. (index (. (. d nodes) items) id) w))))
  (fn testGame (params (f Font)) _ (block
    (let n1 _ (call w f "1111"))
    (let n8 _ (call w f "8888"))
    (let ni _ (call w f "iiii"))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool true)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (let t1 _ (call w f "1111"))
    (let t8 _ (call w f "8888"))
    (let mx _ (call w f "0"))
    (for c (.. 1 10) (block
      (let ch _ "0")
      (if (== c 1) (block
        (= ch "1")) (block
        (if (== c 2) (block
          (= ch "2")) (block
          (if (== c 3) (block
            (= ch "3")) (block
            (if (== c 4) (block
              (= ch "4")) (block
              (if (== c 5) (block
                (= ch "5")) (block
                (if (== c 6) (block
                  (= ch "6")) (block
                  (if (== c 7) (block
                    (= ch "7")) (block
                    (if (== c 8) (block
                      (= ch "8")) (block
                      (= ch "9")))))))))))))))))
      (if (> (call w f ch) mx) (block
        (= mx (call w f ch))))))
    (expr (call ok (== t1 t8) "tabular 1111 and 8888 are the same width"))
    (expr (call near t1 (* (float 0x4010000000000000) mx) (float 0x3f847ae147ae147b) "tabular width is 4 x the digit advance"))
    (expr (call ok (== (call w f "1234567890") (* (float 0x4024000000000000) mx)) "all ten digits share the advance"))
    (expr (call near (call w f "Score: 1,234") (+ (call w f "Score: ,") (* (float 0x4010000000000000) mx)) (float 0x3f847ae147ae147b) "mixed text: only digits change"))
    (expr (call ok (== (call w f "iiii") ni) "letters keep their advance"))
    (expr (call near (call textCaretX f (call bytes "1234") (bool false) 2) (* (float 0x4000000000000000) mx) (float 0x3f847ae147ae147b) "caret after two digits is two cells in"))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool false)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (expr (call ok (&& (== (call w f "1111") n1) (== (call w f "8888") n8)) "normal widths are unchanged after switching off"))))
  (fn testDom (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let p _ (call boxW mem css "" "1111"))
    (let t1 _ (call boxW mem css "tab" "1111"))
    (let t8 _ (call boxW mem css "tab" "8888"))
    (let tm _ (call boxW mem css "tab" "1,234"))
    (expr (call ok (== t1 t8) "a tabular block is as wide for 1111 as for 8888"))
    (expr (call near (call boxW mem css "" "1111") p (float 0x3f847ae147ae147b) "normal blocks measure as before"))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool true)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (let want _ (call w f "1,234"))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool false)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (expr (call near tm want (float 0x3fe3333333333333) "block width equals the tabular text width"))
    (expr (call ok (== (call boxW mem css "tab" "iiii") (call boxW mem css "" "iiii")) "letters only: no change"))
    (expr (call ok (&& (== (call boxW mem css "wave tab" "1111") t1) (!= t1 p)) "text-wave measures with tabular digits"))
    (expr (call boxW mem css "tab" "1111"))
    (expr (call near (call w f "1111") p (float 0x3f847ae147ae147b) "the latch does not leak out of layout"))))
  (fn frame (params (e (ref Dom)) (cls string)) _ (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (expr (call (. inputs begin) e))
    (let p _ (call (. e open) 0 (call (. e tag) "input") 1))
    (expr (call (. e cls) p "box"))
    (if (> (. cls len) 0) (block
      (expr (call (. e cls) p cls))))
    (expr (call (. e attrType) p "text"))
    (expr (call (. e attrText) p "1111"))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))))
  (fn testInput (params (mem (ref Arena)) (css (ref Css)) (f Font)) _ (block
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call frame (& e) "tab"))))
    (let id _ (. (index (. (. e nodes) items) 0) first))
    (expr (call (. e focusNode) id))
    (expr (call (. e simKeys) "" "End"))
    (expr (call frame (& e) "tab"))
    (let c _ (call (. e caretRect) id))
    (let x0 _ (call (. e absX) id))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool true)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (let want _ (call w f "1111"))
    (expr (call setTextMode (struct-lit TextMode (field tabular (bool false)) (field letterSp (float 0x0000000000000000)) (field wordSp (float 0x0000000000000000)) (field shaped (bool false)))))
    (expr (call near (- (. c x) x0) want (float 0x4000000000000000) "caret at the end of a tabular input sits after four tabular digits"))
    (let e2 _ (call (. Dom new) mem css))
    (expr (call (. e2 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e2 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for k (.. 0 3) (block
      (expr (call frame (& e2) ""))))
    (let id2 _ (. (index (. (. e2 nodes) items) 0) first))
    (expr (call (. e2 focusNode) id2))
    (expr (call (. e2 simKeys) "" "End"))
    (expr (call frame (& e2) ""))
    (let c2 _ (call (. e2 caretRect) id2))
    (expr (call near (- (. c2 x) (call (. e2 absX) id2)) (call w f "1111") (float 0x4000000000000000) "normal input caret follows the proportional width"))))
  (fn tframe (params (e (ref Dom)) (on bool)) int (block
    (expr (call (. e beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let row _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e styleStr) row 1 "display" "flex"))
    (let id _ (call (. e open) 0 (call (. e tag) "div") 1))
    (expr (call (. e cls) id "box"))
    (expr (call (. e clsIf) id "tab" on))
    (expr (call (. e text) "1111"))
    (expr (call (. e close)))
    (expr (call (. e close)))
    (expr (call (. e layout)))
    (expr (call (. e endFrame)))
    (return id)))
  (fn (doc "Toggling the class restyles and lays out, then idle frames cost nothing.") testToggle (params (mem (ref Arena)) (css (ref Css))) _ (block
    (let e _ (call (. Dom new) mem css))
    (expr (call (. e setFrameMs) (float 0x4030000000000000)))
    (expr (call (. e simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let id _ 0)
    (for k (.. 0 3) (block
      (= id (call tframe (& e) (bool false)))))
    (let off _ (. (index (. (. e nodes) items) id) w))
    (= id (call tframe (& e) (bool true)))
    (let on _ (. (index (. (. e nodes) items) id) w))
    (expr (call ok (> on off) "turning tabular-nums on widens '1111' in a proportional-digit font"))
    (let laid _ (. e laid))
    (let rs _ (. e restyled))
    (let used _ (. (. e mem) used))
    (for k (.. 0 4) (block
      (expr (call tframe (& e) (bool true)))))
    (expr (call ok (&& (&& (== (. e laid) laid) (== (. e restyled) rs)) (== (. (. e mem) used) used)) "steady frames after the toggle do not lay out, restyle or allocate"))
    (let f _ (call (. Dom new) mem css))
    (expr (call (. f setFrameMs) (float 0x4030000000000000)))
    (expr (call (. f simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. f beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let row _ (call (. f open) 0 (call (. f tag) "div") 1))
    (expr (call (. f styleStr) row 1 "display" "flex"))
    (let sid _ (call (. f open) 0 (call (. f tag) "div") 1))
    (expr (call (. f cls) sid "box"))
    (expr (call (. f styleStr) sid 0 "font-variant-numeric" "tabular-nums"))
    (expr (call (. f text) "1111"))
    (expr (call (. f close)))
    (expr (call (. f close)))
    (expr (call (. f layout)))
    (expr (call (. f endFrame)))
    (expr (call near (. (index (. (. f nodes) items) sid) w) on (float 0x3f847ae147ae147b) "style:font-variant-numeric text value gives tabular digits"))
    (= id (call tframe (& e) (bool false)))
    (expr (call near (. (index (. (. e nodes) items) id) w) off (float 0x3f847ae147ae147b) "turning it off restores the proportional width"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "test.css" 1))
    (= FONTPATH (. (index (. (. css fonts) items) 0) path))
    (let f _ (call loadFont FONTPATH 16))
    (expr (call testGame f))
    (expr (call testDom (& mem) (& css) f))
    (expr (call testInput (& mem) (& css) f))
    (expr (call testToggle (& mem) (& css)))
    (expr (call printLn (interp "text_num_test: " CHECKS " checks passed"))))))
--- stderr
--- exit 0
