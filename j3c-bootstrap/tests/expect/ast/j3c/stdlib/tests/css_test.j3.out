    (expr (call node (& mem) (& cvr) vnd 10 "div" "sz" 8 0 0))
    (let vsty _ (call (. mem alloc) (targs int) 12))
    (for i (.. 0 11) (block
      (let pvs _ (- 1))
      (if (>= (. (index vnd i) parent) 0) (block
        (= pvs (index vsty (. (index vnd i) parent)))))
      (= (index vsty i) (call computeStyle (& cvr) vnd i pvs))))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 0) P_PADDING_TOP) (float 0x4010000000000000)) (== (call gc (& cvr) (index vsty 0) P_COLOR) (call rgba 1 1 1 255))) ":root var applies to the root itself"))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 1) P_PADDING_TOP) (float 0x4020000000000000)) (== (call gc (& cvr) (index vsty 1) P_COLOR) (call rgba 2 2 2 255))) "a class sets a var for its own element"))
    (expr (call ok (== (call gf (& cvr) (index vsty 2) P_PADDING_TOP) (float 0x4020000000000000)) "the child inherits the class var"))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 3) P_PADDING_TOP) (float 0x4030000000000000)) (== (call gc (& cvr) (index vsty 3) P_COLOR) (call rgba 2 2 2 255))) "the grandchild overrides one var, inherits the other"))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 4) P_PADDING_TOP) (float 0x4028000000000000)) (== (call gc (& cvr) (index vsty 4) P_COLOR) (call rgba 1 1 1 255))) "a sibling subtree has its own value, :root for the rest"))
    (expr (call ok (== (call gf (& cvr) (index vsty 5) P_PADDING_TOP) (float 0x4028000000000000)) "its child follows it, not the other subtree"))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 0) P_MARGIN_TOP) (float 0x4008000000000000)) (== (call gkind (& cvr) (index vsty 0) P_MARGIN_TOP) V_PX)) "undefined var uses the fallback"))
    (expr (call ok (== (call gf (& cvr) (index vsty 1) P_WIDTH) (float 0x4020000000000000)) "a var() in the fallback resolves too"))
    (expr (call ok (== (call gkind (& cvr) (index vsty 0) P_HEIGHT) V_AUTO) "undefined var without fallback: the initial value"))
    (expr (call ok (== (call gf (& cvr) (index vsty 0) P_BORDER_TOP_WIDTH) (float 0x4014000000000000)) "undefined --a: the fallback"))
    (expr (call ok (== (call gf (& cvr) (index vsty 6) P_BORDER_TOP_WIDTH) (float 0x401c000000000000)) "a var() value may name a var declared later"))
    (expr (call ok (== (call gf (& cvr) (index vsty 7) P_BORDER_TOP_WIDTH) (float 0x4014000000000000)) "a var cycle is invalid: the fallback, no hang"))
    (expr (call ok (== (call gf (& cvr) (index vsty 8) P_PADDING_TOP) (float 0x4010000000000000)) "var in a custom value, fallback inside a custom value (--z and --y)"))
    (expr (call ok (&& (== (call gf (& cvr) (index vsty 10) P_PADDING_TOP) (float 0x4022000000000000)) (== (call gf (& cvr) (index vsty 10) P_MARGIN_TOP) (float 0x4010000000000000))) "custom fallbacks reach the grandchild"))
    (expr (call ok (&& (== (call gkind (& cvr) (index vsty 9) P_PADDING_TOP) V_PX) (== (call gf (& cvr) (index vsty 9) P_PADDING_TOP) (float 0x0000000000000000))) "a declared-invalid var is not the inherited value"))
    (expr (call ok (== (index vsty 2) (call computeStyle (& cvr) vnd 2 (index vsty 1))) "same rules and parent: one style id"))
    (let nv _ (. (. cvr vsEnt) len))
    (for k (.. 0 100) (block
      (for i (.. 0 11) (block
        (let pv3 _ (- 1))
        (if (>= (. (index vnd i) parent) 0) (block
          (= pv3 (index vsty (. (index vnd i) parent)))))
        (= (index vsty i) (call computeStyle (& cvr) vnd i pv3))))))
    (expr (call ok (== (. (. cvr vsEnt) len) nv) "recomputing hits the cache: no new var sets"))
    (expr (call (. cvr reset)))
    (expr (call parse (& cvr) ":root { --pad: 20px; }\ndiv { padding-top: var(--pad); }\n" "v.css" 0))
    (expr (call ok (== (call gf (& cvr) (call computeStyle (& cvr) vnd 0 (- 1)) P_PADDING_TOP) (float 0x4034000000000000)) "reset + parse: the new :root value"))
    (let nodes _ (call (. mem alloc) (targs MatchNode) 1200))
    (let st _ (call (. mem alloc) (targs int) 1200))
    (expr (call node (& mem) (& css) nodes 0 "div" "app" (- 1) 0 3))
    (expr (call node (& mem) (& css) nodes 1 "div" "card" 0 0 1))
    (expr (call node (& mem) (& css) nodes 2 "button" "" 1 FL_HOVER 1))
    (= (index st 0) (call computeStyle (& css) nodes 0 (- 1)))
    (= (index st 1) (call computeStyle (& css) nodes 1 (index st 0)))
    (= (index st 2) (call computeStyle (& css) nodes 2 (index st 1)))
    (expr (call ok (== (call gi (& css) (index st 0) P_DISPLAY) DISPLAY_FLEX) "Game .app is flex"))
    (expr (call ok (&& (== (call gf (& css) (index st 1) P_RADIUS_TL) (float 0x4024000000000000)) (== (call gc (& css) (index st 1) P_BACKGROUND) (call rgba 49 50 68 255))) "BallCard .card: var(--raised), var(--radius)"))
    (expr (call ok (== (call gc (& css) (index st 2) P_BACKGROUND) (call rgba 88 91 112 255)) "button:hover background is var(--active)"))
    (expr (call ok (== (call gf (& css) (index st 2) P_FONT_SIZE) (float 0x402e000000000000)) "button inherits 15px from the :root node"))
    (expr (call node (& mem) (& css) nodes 3 "label" "" 0 FL_HOVER 5))
    (expr (call node (& mem) (& css) nodes 4 "span" "" 3 FL_FIRST_CHILD 5))
    (expr (call node (& mem) (& css) nodes 5 "span" "" 3 0 5))
    (expr (call node (& mem) (& css) nodes 6 "input" "" 3 0 5))
    (= (. (index nodes 6) type) (call (. css intern) "range"))
    (= (index st 3) (call computeStyle (& css) nodes 3 (index st 0)))
    (= (index st 4) (call computeStyle (& css) nodes 4 (index st 3)))
    (= (index st 5) (call computeStyle (& css) nodes 5 (index st 3)))
    (= (index st 6) (call computeStyle (& css) nodes 6 (index st 3)))
    (expr (call ok (&& (== (call gf (& css) (index st 4) (call propId "flex")) (float 0x3ff0000000000000)) (== (call gf (& css) (index st 5) (call propId "flex")) (float 0x0000000000000000))) "label span:first-child only matches the first span"))
    (expr (call ok (== (call gf (& css) (index st 6) P_WIDTH) (float 0x4061800000000000)) "input[type=range]"))
    (expr (call ok (== (call gc (& css) (index st 3) P_BACKGROUND) (call rgba 69 71 90 255)) "label:hover background (var(--hover))"))
    (expr (call ok (&& (== (call gkind (& css) (index st 6) P_FONT_FAMILY) V_STR) (== (call gi (& css) (index st 6) P_FONT_FAMILY) (call (. css intern) "Ui"))) "font-family inherits \"Ui\" from :root"))
    (expr (call (. css clearCache)))
    (let reps _ 51)
    (let times _ (call (. mem alloc) (targs int) reps))
    (let theme _ (call load (& mem) (interp dir "theme.css")))
    (for r (.. 0 reps) (block
      (let cp _ (call (. mem checkpoint)))
      (let c2 _ (call (. Css new) (& mem)))
      (let t0 _ (call micros))
      (expr (call parse (& c2) theme "ui/theme.css" 0))
      (for i (.. 0 9) (block
        (expr (call parse (& c2) (index styles i) "ui/x.j3ui" (+ i 1)))))
      (= (index times r) (- (call micros) t0))
      (expr (call (. mem rewind) cp))))
    (expr (call printLn (interp "parse theme + 9 style blocks: median " (call median times) " us (target 200 us)")))
    (let c3 _ (call (. Css new) (& mem)))
    (expr (call loadAll (& c3) (& mem) dir (slice-expr files _ _) styles))
    (let n _ 0)
    (expr (call node (& mem) (& c3) nodes 0 "div" "app" (- 1) 0 3))
    (expr (call node (& mem) (& c3) nodes 1 "div" "half" 0 0 3))
    (expr (call node (& mem) (& c3) nodes 2 "main" "" 1 0 6))
    (expr (call node (& mem) (& c3) nodes 3 "div" "grid" 2 0 2))
    (= n 4)
    (while (<= (+ n 10) 1000) (block
      (let card _ n)
      (expr (call node (& mem) (& c3) nodes card "div" "card" 3 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 1) "div" "top" card 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 2) "span" "name" (+ card 1) FL_FIRST_CHILD 1))
      (expr (call node (& mem) (& c3) nodes (+ card 3) "span" "owned" (+ card 1) 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 4) "div" "stats" card 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 5) "span" "" (+ card 4) FL_FIRST_CHILD 1))
      (expr (call node (& mem) (& c3) nodes (+ card 6) "span" "" (+ card 4) 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 7) "button" "" card 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 8) "span" "price" (+ card 7) 0 1))
      (expr (call node (& mem) (& c3) nodes (+ card 9) "small" "" card 0 1))
      (+= n 10)))
    (let total _ n)
    (let cold _ (call (. mem alloc) (targs int) reps))
    (let hot _ (call (. mem alloc) (targs int) reps))
    (for r (.. 0 reps) (block
      (expr (call (. c3 clearCache)))
      (let t2 _ (call micros))
      (for id (.. 0 total) (block
        (let par _ (- 1))
        (if (>= (. (index nodes id) parent) 0) (block
          (= par (index st (. (index nodes id) parent)))))
        (= (index st id) (call computeStyle (& c3) nodes id par))))
      (= (index cold r) (- (call micros) t2))
      (let t1 _ (call micros))
      (for id (.. 0 total) (block
        (let par2 _ (- 1))
        (if (>= (. (index nodes id) parent) 0) (block
          (= par2 (index st (. (index nodes id) parent)))))
        (= (index st id) (call computeStyle (& c3) nodes id par2))))
      (= (index hot r) (- (call micros) t1))))
    (expr (call printLn (interp "computeStyle " total " nodes cold: median " (call median cold) " us (target 300 us), cache hit: median " (call median hot) " us (target 50 us)")))
    (expr (call printLn (interp "distinct styles per pass: " (. (. c3 cents) len) ", checks passed: " CHECKS)))
    (expr (call printLn "css_test ok")))))
--- stderr
--- exit 0
