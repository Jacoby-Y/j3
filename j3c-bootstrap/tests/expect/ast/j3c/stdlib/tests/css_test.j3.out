(file (module css_test)
  (use j3.io (names exists printLn readFile))
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text (names contains find same Text))
  (use j3.ui.css (names Css HotFile MatchNode Value))
  (use j3.ui.cssmatch (names computeStyle varValue))
  (use j3.ui.css.V_ANG)
  (use j3.ui.css (names P_SCROLL_MARGIN P_SCROLL_PAD P_SNAP_ALIGN P_SNAP_STOP P_SNAP_TYPE))
  (use j3.ui.cssparse (names inlineDecl parse))
  (use j3.ui.uastyle)
  (use j3.ui.cssvars.rebuildReaders)
  (use j3.ui.css.P_FONT_WEIGHT)
  (use j3.ui.cssvalue (names propId initial))
  (use j3.ui.css (names P_FLEX_BASIS P_FLEX_SHRINK P_ALIGN_SELF P_ORDER))
  (use j3.ui.css (names P_MAX_WIDTH animKind CK_LEN P_ORIGIN P_ROTATE P_SCALE P_TRANSLATE))
  (use j3.ui.css (names DISPLAY_CONTENTS V_LIST DISPLAY_FLEX FL_ACTIVE FL_FIRST_CHILD FL_HOVER JUSTIFY_BETWEEN))
  (use j3.ui.css (names P_BACKGROUND P_BORDER_TOP_COLOR P_COLOR P_DISPLAY P_FONT_FAMILY P_FONT_SIZE P_GAP P_GRID_ACOLS P_GRID_AROWS P_GRID_CE P_GRID_COL0 P_GRID_CS P_GRID_FLOW P_GRID_RE P_GRID_ROWS P_GRID_RS P_BORDER_TOP_WIDTH))
  (use j3.ui.css (names P_HEIGHT P_JUSTIFY_CONTENT P_MARGIN_TOP P_OPACITY P_PADDING_TOP P_RADIUS_TL P_TEXT_ALIGN P_TRANS0 P_TRANSFORM P_WIDTH))
  (use j3.ui.css (names V_AUTO V_COLOR V_FR V_KW V_EM V_NONE V_NUM V_PCT V_PX V_XFORM V_STR V_TRANS V_GRAD V_SHADOW))
  (use j3.ui.css (names P_LETTER_SPACING P_TEXT_INDENT P_TEXT_TRANSFORM P_WORD_SPACING FL_LAST_CHILD P_ASPECT_RATIO P_CURSOR P_FONT_STYLE P_FONT_VARIANT_NUMERIC P_OUTLINE_COLOR P_OUTLINE_OFFSET P_OUTLINE_STYLE P_OUTLINE_WIDTH P_TEXT_DECORATION))
  (use j3.ui.css (names FL_FOCUS FL_FOCUS_VIS FL_FOCUS_WITHIN P_ALIGN_ITEMS P_GRID_AREAS P_JUSTIFY_ITEMS P_JUSTIFY_SELF))
  (use j3.ui.css (names FL_CHECKED FL_DISABLED FL_NONBLANK FL_PH_SHOWN))
  (use j3.ui.css (names P_BG_POS P_BG_REPEAT P_BG_SIZE P_BORDER_IMG_W P_BORDER_OUTSET P_BORDER_REPEAT P_BORDER_SLICE V_URL))
  (use j3.ui.css (names P_TEXT_SHADOW P_LINE_HEIGHT V_CALC P_BG_IMAGE P_BORDER_IMAGE P_BORDER_STYLE P_BOX_SHADOW BORDER_DASHED BORDER_DOTTED BORDER_SOLID))
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn (doc "More distinct styles than the cache's starting size: a second pass must reuse every id, not build new ones\n(the cache used to be cleared when full, so a big dynamic UI built fresh styles every frame without bound).") testCacheGrows (params (mem (ref Arena))) _ (block
    (let c _ (call (. Css new) mem))
    (expr (call parse (& c) ".a { color: #123456; }\n" "g.css" 0))
    (let ns _ (call (. mem alloc) (targs MatchNode) 1))
    (expr (call node mem (& c) ns 0 "div" "a" (- 1) 0 0))
    (let n _ 5000)
    (let ids _ (call (. mem alloc) (targs int) n))
    (let p _ (- 1))
    (for i (.. 0 n) (block
      (= p (call computeStyle (& c) ns 0 p))
      (= (index ids i) p)))
    (let vals _ (. (. c vals) len))
    (= p (- 1))
    (let same_ _ (bool true))
    (for i (.. 0 n) (block
      (= p (call computeStyle (& c) ns 0 p))
      (if (!= p (index ids i)) (block
        (= same_ (bool false))))))
    (expr (call ok same_ "style cache: a second pass over 5000 distinct styles returns the same ids"))
    (expr (call ok (== (. (. c vals) len) vals) "style cache: no new styles built on the second pass"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call testCacheGrows (& mem)))
    (expr (call testTransformCss (& mem)))
    (expr (call testFocusCss (& mem)))
    (expr (call testHasCss (& mem)))
    (expr (call testSelectors2 (& mem)))
    (expr (call testNumericCss (& mem)))
    (expr (call testSpacingCss (& mem)))
    (expr (call testSnapCss (& mem)))
    (expr (call testNewCss (& mem)))
    (expr (call testSelectors (& mem)))
    (expr (call testFlexProps (& mem)))
    (expr (call testMaxWidth (& mem)))
    (expr (call testImagery (& mem)))
    (expr (call testGridAreas (& mem)))
    (expr (call testColorMix (& mem)))
    (expr (call testVarCompound (& mem)))
    (expr (call testProperty (& mem)))
    (expr (call testNesting (& mem)))
    (expr (call testWideKeywords (& mem)))
    (expr (call testRevertRegistered (& mem)))
    (expr (call testRevertAfterReset (& mem)))
    (let dir _ "j3c/tests/fixtures/idle_ui/ui/")
    (if (! (call exists (interp dir "theme.css"))) (block
      (= dir "tests/fixtures/idle_ui/ui/")))
    (let styles _ (call (. mem alloc) (targs string) 9))
    (let files (array 9 string) (array-lit "BallCard" "BallShop" "Game" "Prestige" "Settings" "Sidebar" "Stats" "UpgradeRow" "Upgrades"))
    (let css _ (call (. Css new) (& mem)))
    (let themeLen _ (call loadAll (& css) (& mem) dir (slice-expr files _ _) styles))
    (expr (call warnText (& css)))
    (expr (call ok (== (. (. css warns) len) 0) "idle-breakout styles parse with zero warnings"))
    (expr (call ok (&& (== (. (. css fonts) len) 1) (== (call same (. (index (. (. css fonts) items) 0) path) "ui/../assets/font.ttf") (bool false))) "font-face path collapsed"))
    (expr (call ok (call same (. (index (. (. css fonts) items) 0) path) "assets/font.ttf") "font-face path resolved against the css dir"))
    (expr (call printLn (interp "rules=" (. (. css rules) len) " decls=" (. (. css decls) len) " fonts=" (. (. css fonts) len) " steps=" (. (. css steps) len))))
    (let v _ (call (. Css new) (& mem)))
    (expr (call parse (& v) ".a { border-radius: 1px 2px 3px 4px; background: rgba(1, 2, 3, 0.5); color: #abc; }\n.b { background: #11223344; color: #123456; padding: 1px 2px 3px; margin: 0 auto; }\n.c { gap: 4px 6px; flex: 2; font-weight: bold; line-height: 1.4; opacity: 0.4; transition: background 120ms, border-color 150ms; transform: scale(0.97); grid-template-columns: repeat(2, 1fr); width: 50%; display: flex; justify-content: space-between; border-bottom: 2px solid #010203; }\n.d { grid-template-columns: 1fr auto; }\n" "v.css" 0))
    (expr (call warnText (& v)))
    (expr (call ok (== (. (. v warns) len) 0) "value forms parse"))
    (let vn _ (call (. mem alloc) (targs MatchNode) 4))
    (expr (call node (& mem) (& v) vn 0 "div" "a" (- 1) 0 0))
    (expr (call node (& mem) (& v) vn 1 "div" "b" (- 1) 0 0))
    (expr (call node (& mem) (& v) vn 2 "div" "c" (- 1) 0 0))
    (expr (call node (& mem) (& v) vn 3 "div" "d" (- 1) 0 0))
    (let sa _ (call computeStyle (& v) vn 0 (- 1)))
    (let sb _ (call computeStyle (& v) vn 1 (- 1)))
    (let sc _ (call computeStyle (& v) vn 2 (- 1)))
    (let sd _ (call computeStyle (& v) vn 3 (- 1)))
    (expr (call ok (&& (== (call gkind (& v) sa P_RADIUS_TL) V_PX) (== (call gf (& v) sa P_RADIUS_TL) (float 0x3ff0000000000000))) "radius tl"))
    (expr (call ok (&& (&& (== (call gf (& v) sa (+ P_RADIUS_TL 1)) (float 0x4000000000000000)) (== (call gf (& v) sa (+ P_RADIUS_TL 2)) (float 0x4008000000000000))) (== (call gf (& v) sa (+ P_RADIUS_TL 3)) (float 0x4010000000000000))) "4-value border-radius"))
    (expr (call ok (== (call gc (& v) sa P_BACKGROUND) (call rgba 1 2 3 128)) "rgba() with alpha 0.5"))
    (expr (call ok (== (call gc (& v) sa P_COLOR) (call rgba 170 187 204 255)) "3-digit hex"))
    (expr (call ok (== (call gc (& v) sb P_BACKGROUND) (call rgba 17 34 51 68)) "8-digit hex"))
    (expr (call ok (== (call gc (& v) sb P_COLOR) (call rgba 18 52 86 255)) "6-digit hex"))
    (expr (call ok (&& (== (call gf (& v) sb (+ P_PADDING_TOP 3)) (float 0x4000000000000000)) (== (call gf (& v) sb (+ P_PADDING_TOP 2)) (float 0x4008000000000000))) "3-value padding"))
    (expr (call ok (&& (== (call gkind (& v) sb (+ P_MARGIN_TOP 1)) V_AUTO) (== (call gkind (& v) sb P_MARGIN_TOP) V_PX)) "margin 0 auto"))
    (expr (call ok (&& (== (call gf (& v) sc P_GAP) (float 0x4018000000000000)) (== (call gf (& v) sc (call propId "row-gap")) (float 0x4010000000000000))) "gap row column"))
    (expr (call ok (&& (== (call gf (& v) sc (call propId "flex")) (float 0x4000000000000000)) (== (call gf (& v) sc (call propId "font-weight")) (float 0x4085e00000000000))) "flex, bold"))
    (expr (call ok (&& (== (call gkind (& v) sc (call propId "line-height")) V_NUM) (== (call gf (& v) sc (call propId "line-height")) (float 0x3ff6666666666666))) "line-height number"))
    (expr (call ok (== (call gf (& v) sc P_OPACITY) (float 0x3fd999999999999a)) "opacity"))
    (expr (call ok (&& (&& (== (call gkind (& v) sc P_TRANS0) V_TRANS) (== (call gi (& v) sc P_TRANS0) (call propId "background"))) (== (call gf (& v) sc P_TRANS0) (float 0x405e000000000000))) "transition 1"))
    (expr (call ok (&& (&& (== (call gi (& v) sc (+ P_TRANS0 1)) P_BORDER_TOP_COLOR) (== (call gc (& v) sc (+ P_TRANS0 1)) 4)) (== (call gf (& v) sc (+ P_TRANS0 1)) (float 0x4062c00000000000))) "transition 2 covers border-color"))
    (expr (call ok (== (call gkind (& v) sc (+ P_TRANS0 2)) V_NONE) "unused transition slot"))
    (expr (call ok (&& (== (call gkind (& v) sc P_TRANSFORM) V_XFORM) (== (index (. (. v paints) items) (+ (call gi (& v) sc P_TRANSFORM) 3)) (float 0x3fef0a3d70a3d70a))) "scale"))
    (expr (call ok (&& (&& (&& (== (call gkind (& v) sc P_GRID_COL0) V_LIST) (== (call gtn (& v) sc P_GRID_COL0) 2)) (== (call gtk (& v) sc P_GRID_COL0 1 2) V_FR)) (== (call gtv (& v) sc P_GRID_COL0 1 3) (float 0x3ff0000000000000))) "repeat(2, 1fr)"))
    (expr (call ok (&& (&& (&& (== (call gtn (& v) sd P_GRID_COL0) 2) (== (call gtk (& v) sd P_GRID_COL0 0 2) V_FR)) (== (call gtk (& v) sd P_GRID_COL0 0 0) V_AUTO)) (== (call gtk (& v) sd P_GRID_COL0 1 2) V_AUTO)) "1fr auto"))
    (expr (call ok (&& (== (call gkind (& v) sc P_WIDTH) V_PCT) (== (call gf (& v) sc P_WIDTH) (float 0x4049000000000000))) "percent"))
    (expr (call ok (&& (== (call gkind (& v) sc P_DISPLAY) V_KW) (== (call gi (& v) sc P_DISPLAY) DISPLAY_FLEX)) "display flex"))
    (expr (call ok (== (call gi (& v) sc P_JUSTIFY_CONTENT) JUSTIFY_BETWEEN) "space-between"))
    (expr (call ok (&& (== (call gc (& v) sc (+ P_BORDER_TOP_COLOR 2)) (call rgba 1 2 3 255)) (!= (call gkind (& v) sc P_BORDER_TOP_COLOR) V_COLOR)) "border-bottom only touches the bottom"))
    (let gt _ (call (. Css new) (& mem)))
    (expr (call parse (& gt) ".a { grid-template-columns: 1fr 140px 100px 50px 2fr; display: contents; }\n.b { grid-template-columns: repeat(3, 1fr 20px); }\n.c { grid-template-columns: repeat(33, 1fr 20px); }\n.d { grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr 1fr; }\n.e { grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); grid-template-rows: 40px minmax(10px, 2fr) 25%; }\n.f { grid-template-columns: repeat(auto-fit, 100px); grid-auto-rows: 30px; grid-auto-columns: minmax(20px, auto) 2em; grid-auto-flow: column dense; }\n" "gt.css" 0))
    (expr (call ok (== (. (. gt warns) len) 2) "each over-limit declaration warns once"))
    (expr (call ok (&& (&& (== (. (index (. (. gt warns) items) 0) line) 3) (== (. (index (. (. gt warns) items) 1) line) 4)) (call contains (. (index (. (. gt warns) items) 0) msg) "64 grid tracks")) "over-limit warnings point at the declaration"))
    (let gtnn _ (call (. mem alloc) (targs MatchNode) 6))
    (expr (call node (& mem) (& gt) gtnn 0 "div" "a" (- 1) 0 0))
    (expr (call node (& mem) (& gt) gtnn 1 "div" "b" (- 1) 0 0))
    (expr (call node (& mem) (& gt) gtnn 2 "div" "c" (- 1) 0 0))
    (expr (call node (& mem) (& gt) gtnn 3 "div" "d" (- 1) 0 0))
    (expr (call node (& mem) (& gt) gtnn 4 "div" "e" (- 1) 0 0))
    (expr (call node (& mem) (& gt) gtnn 5 "div" "f" (- 1) 0 0))
    (let gta _ (call computeStyle (& gt) gtnn 0 (- 1)))
    (let gtb _ (call computeStyle (& gt) gtnn 1 (- 1)))
    (let gtc _ (call computeStyle (& gt) gtnn 2 (- 1)))
    (let gtd _ (call computeStyle (& gt) gtnn 3 (- 1)))
    (let gte _ (call computeStyle (& gt) gtnn 4 (- 1)))
    (let gtf _ (call computeStyle (& gt) gtnn 5 (- 1)))
    (expr (call ok (&& (&& (== (call gkind (& gt) gta P_GRID_COL0) V_LIST) (== (call gtn (& gt) gta P_GRID_COL0) 5)) (== (call gtfill (& gt) gta P_GRID_COL0) 0)) "five tracks are one list"))
    (expr (call ok (&& (&& (&& (&& (&& (== (call gtk (& gt) gta P_GRID_COL0 0 2) V_FR) (== (call gtv (& gt) gta P_GRID_COL0 0 3) (float 0x3ff0000000000000))) (== (call gtk (& gt) gta P_GRID_COL0 1 0) V_PX)) (== (call gtv (& gt) gta P_GRID_COL0 1 1) (float 0x4061800000000000))) (== (call gtk (& gt) gta P_GRID_COL0 1 2) V_PX)) (== (call gtv (& gt) gta P_GRID_COL0 4 3) (float 0x4000000000000000))) "list holds min and max per track"))
    (expr (call ok (== (call gi (& gt) gta P_DISPLAY) DISPLAY_CONTENTS) "display: contents"))
    (expr (call ok (&& (&& (== (call gtn (& gt) gtb P_GRID_COL0) 6) (== (call gtk (& gt) gtb P_GRID_COL0 4 2) V_FR)) (== (call gtv (& gt) gtb P_GRID_COL0 5 1) (float 0x4034000000000000))) "repeat(3, 1fr 20px) is expanded"))
    (expr (call ok (&& (== (call gkind (& gt) gtc P_GRID_COL0) V_NONE) (== (call gkind (& gt) gtd P_GRID_COL0) V_NONE)) "over 64 tracks is dropped"))
    (expr (call ok (&& (&& (&& (&& (== (call gtfill (& gt) gte P_GRID_COL0) 1) (== (call gtn (& gt) gte P_GRID_COL0) 1)) (== (call gtk (& gt) gte P_GRID_COL0 0 0) V_PX)) (== (call gtv (& gt) gte P_GRID_COL0 0 1) (float 0x4050000000000000))) (== (call gtk (& gt) gte P_GRID_COL0 0 2) V_FR)) "auto-fill with minmax(64px, 1fr)"))
    (expr (call ok (&& (&& (&& (&& (&& (&& (== (call gtn (& gt) gte P_GRID_ROWS) 3) (== (call gtk (& gt) gte P_GRID_ROWS 0 0) V_PX)) (== (call gtk (& gt) gte P_GRID_ROWS 1 0) V_PX)) (== (call gtv (& gt) gte P_GRID_ROWS 1 1) (float 0x4024000000000000))) (== (call gtk (& gt) gte P_GRID_ROWS 1 2) V_FR)) (== (call gtv (& gt) gte P_GRID_ROWS 1 3) (float 0x4000000000000000))) (== (call gtk (& gt) gte P_GRID_ROWS 2 0) V_PCT)) "grid-template-rows: length, minmax, percent"))
    (expr (call ok (&& (== (call gtfill (& gt) gtf P_GRID_COL0) 2) (== (call gtk (& gt) gtf P_GRID_COL0 0 2) V_PX)) "auto-fit with a fixed track"))
    (expr (call ok (&& (== (call gtn (& gt) gtf P_GRID_AROWS) 1) (== (call gtv (& gt) gtf P_GRID_AROWS 0 1) (float 0x403e000000000000))) "grid-auto-rows"))
    (expr (call ok (&& (&& (&& (== (call gtn (& gt) gtf P_GRID_ACOLS) 2) (== (call gtk (& gt) gtf P_GRID_ACOLS 0 2) V_AUTO)) (== (call gtv (& gt) gtf P_GRID_ACOLS 0 1) (float 0x4034000000000000))) (== (call gtk (& gt) gtf P_GRID_ACOLS 1 2) V_EM)) "grid-auto-columns: minmax then em"))
    (expr (call ok (&& (== (call gi (& gt) gtf P_GRID_FLOW) 3) (== (call gi (& gt) gta P_GRID_FLOW) 0)) "grid-auto-flow: column dense, default row"))
    (expr (call ok (&& (== (call gkind (& gt) gta P_GRID_ROWS) V_NONE) (== (call gkind (& gt) gta P_GRID_AROWS) V_NONE)) "rows default to none"))
    (let gq _ (call (. Css new) (& mem)))
    (expr (call parse (& gq) ".a { grid-column: 2 / span 3; grid-row: span 2; }\n.b { grid-column-start: -1; grid-column-end: 4; grid-row-start: span 2; grid-row-end: auto; }\n.c { grid-column: 3; grid-row: 1 / -1; }\n.d { grid-column: auto / 5; }\n" "gq.css" 0))
    (expr (call ok (== (. (. gq warns) len) 0) "placement parses without warnings"))
    (let gqn _ (call (. mem alloc) (targs MatchNode) 5))
    (expr (call node (& mem) (& gq) gqn 0 "div" "a" (- 1) 0 0))
    (expr (call node (& mem) (& gq) gqn 1 "div" "b" (- 1) 0 0))
    (expr (call node (& mem) (& gq) gqn 2 "div" "c" (- 1) 0 0))
    (expr (call node (& mem) (& gq) gqn 3 "div" "d" (- 1) 0 0))
    (expr (call node (& mem) (& gq) gqn 4 "div" "z" (- 1) 0 0))
    (let gqa _ (call computeStyle (& gq) gqn 0 (- 1)))
    (let gqb _ (call computeStyle (& gq) gqn 1 (- 1)))
    (let gqc _ (call computeStyle (& gq) gqn 2 (- 1)))
    (let gqd _ (call computeStyle (& gq) gqn 3 (- 1)))
    (let gqz _ (call computeStyle (& gq) gqn 4 (- 1)))
    (expr (call ok (&& (&& (&& (&& (== (call gkind (& gq) gqa P_GRID_CS) V_NUM) (== (call gf (& gq) gqa P_GRID_CS) (float 0x4000000000000000))) (== (call gi (& gq) gqa P_GRID_CS) 0)) (== (call gf (& gq) gqa P_GRID_CE) (float 0x4008000000000000))) (== (call gi (& gq) gqa P_GRID_CE) 1)) "grid-column: 2 / span 3"))
    (expr (call ok (&& (&& (== (call gf (& gq) gqa P_GRID_RS) (float 0x4000000000000000)) (== (call gi (& gq) gqa P_GRID_RS) 1)) (== (call gkind (& gq) gqa P_GRID_RE) V_AUTO)) "grid-row: span 2"))
    (expr (call ok (&& (&& (&& (&& (== (call gf (& gq) gqb P_GRID_CS) (- (float 0x3ff0000000000000))) (== (call gf (& gq) gqb P_GRID_CE) (float 0x4010000000000000))) (== (call gi (& gq) gqb P_GRID_CE) 0)) (== (call gi (& gq) gqb P_GRID_RS) 1)) (== (call gkind (& gq) gqb P_GRID_RE) V_AUTO)) "start and end longhands"))
    (expr (call ok (&& (&& (&& (== (call gf (& gq) gqc P_GRID_CS) (float 0x4008000000000000)) (== (call gkind (& gq) gqc P_GRID_CE) V_AUTO)) (== (call gf (& gq) gqc P_GRID_RS) (float 0x3ff0000000000000))) (== (call gf (& gq) gqc P_GRID_RE) (- (float 0x3ff0000000000000)))) "one line, and 1 / -1"))
    (expr (call ok (&& (== (call gkind (& gq) gqd P_GRID_CS) V_AUTO) (== (call gf (& gq) gqd P_GRID_CE) (float 0x4014000000000000))) "auto / 5"))
    (expr (call ok (&& (== (call gkind (& gq) gqz P_GRID_CS) V_AUTO) (== (call gkind (& gq) gqz P_GRID_RE) V_AUTO)) "placement defaults to auto"))
    (let gx _ (call (. Css new) (& mem)))
    (expr (call parse (& gx) ".a {\n  grid-template-columns: repeat(auto-fill, 1fr);\n  grid-template-columns: repeat(0, 1fr);\n  grid-column: 0;\n  grid-row: 1 / 2 / 3;\n  grid-auto-flow: row column;\n  grid-template-rows: minmax(1fr, 2px);\n  grid-auto-rows: repeat(auto-fill, 10px);\n  grid-column: span 0;\n  grid-row-end: 1.5;\n  grid-template-columns: min-content 1fr;\n  grid-template-rows: 10px;\n}\n" "gx.css" 0))
    (expr (call ok (== (. (. gx warns) len) 10) "every bad grid declaration warns"))
    (for q (.. 0 10) (block
      (expr (call ok (&& (&& (== (. (index (. (. gx warns) items) q) line) (+ q 2)) (== (. (index (. (. gx warns) items) q) col) 3)) (call contains (. (index (. (. gx warns) items) q) msg) "invalid value")) "bad grid value warns at line:col"))))
    (let gxn _ (call (. mem alloc) (targs MatchNode) 1))
    (expr (call node (& mem) (& gx) gxn 0 "div" "a" (- 1) 0 0))
    (let gxa _ (call computeStyle (& gx) gxn 0 (- 1)))
    (expr (call ok (&& (&& (== (call gkind (& gx) gxa P_GRID_COL0) V_NONE) (== (call gkind (& gx) gxa P_GRID_CS) V_AUTO)) (== (call gtn (& gx) gxa P_GRID_ROWS) 1)) "bad values leave the rest alone"))
    (let w _ (call (. Css new) (& mem)))
    (expr (call parse (& w) "a {\n  color: #12;\n  width: 5px;\n  bogus: 1;\n  opacity: 2xx;\n  height: 7px !important;\n  padding: 1px;\n}\nb { color: notacolor }\n" "w.css" 0))
    (expr (call warnText (& w)))
    (expr (call ok (== (. (. w warns) len) 5) "five warnings"))
    (expr (call ok (&& (== (. (index (. (. w warns) items) 0) line) 2) (== (. (index (. (. w warns) items) 0) col) 3)) "bad color at 2:3"))
    (expr (call ok (&& (== (. (index (. (. w warns) items) 1) line) 4) (== (. (index (. (. w warns) items) 1) col) 3)) "unknown property at 4:3"))
    (expr (call ok (&& (&& (== (. (index (. (. w warns) items) 2) line) 5) (== (. (index (. (. w warns) items) 3) line) 6)) (== (. (index (. (. w warns) items) 4) line) 9)) "later warnings"))
    (let wn _ (call (. mem alloc) (targs MatchNode) 2))
