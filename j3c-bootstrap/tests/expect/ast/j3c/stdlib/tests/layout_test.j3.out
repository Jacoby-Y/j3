(file (module layout_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css (names Css FL_LAST_CHILD))
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (use j3.ui.panelmath)
  (use j3.ui.sticky)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (+= CHECKS 1)
    (let diff _ (- a b))
    (if (< diff (float 0x0000000000000000)) (block
      (= diff (- (float 0x0000000000000000) diff))))
    (if (> diff tol) (block
      (expr (call printLn (interp "FAIL: " msg ": " a " vs " b)))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 256 1024) 1024)))
    (expr (call testAutoMargin (& mem)))
    (expr (call testFlexReverse (& mem)))
    (expr (call testFixedOrder (& mem)))
    (expr (call testFlexItems (& mem)))
    (expr (call testLimits (& mem)))
    (expr (call testLimitEdges (& mem)))
    (expr (call testMath))
    (expr (call testMedia (& mem)))
    (expr (call testWrapCalc (& mem)))
    (expr (call testEmRem (& mem)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "layout.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "the test sheet parses with no warning"))
    (expr (call testResponsive (& mem) (& css)))
    (expr (call testSticky (& mem) (& css)))
    (expr (call testPanels (& mem) (& css)))
    (expr (call printLn (interp "layout_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
