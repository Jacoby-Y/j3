(file (module a11y_gaps_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text (names contains same Text))
  (use j3.i18n)
  (use j3.ui.a11y)
  (use j3.ui.a11y.TextInfo)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.inputs)
  (mod-let CHECKS int _)
  (mod-let STATE St _)
  (mod-let IDS Ids _)
  (struct St
    (field msg string "a")
    (field alert string "x")
    (field checked bool (bool false))
    (field withBtn bool (bool true))
    (field selTab bool (bool false))
    (field open bool (bool false)))
  (struct Ids
    (field btn int (- 1))
    (field mv int (- 1))
    (field tb int (- 1))
    (field pw int (- 1))
    (field cb int (- 1))
    (field tab int (- 1))
    (field det int (- 1))
    (field inp int (- 1))
    (field prog int (- 1))
    (field meter int (- 1))
    (field wrapB int (- 1))
    (field ctlA int (- 1))
    (field live int (- 1)))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (= STATE (struct-lit St))
    (= IDS (struct-lit Ids))
    (expr (call (. a11y enable) (& d)))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (let ev0 _ (call (. a11y events) (& d) (& mem)))
    (let lv0 _ (call (. a11y liveChanges) (& d) (& mem)))
    (expr (call ok (== (. lv0 len) 0) "a live region's first content is not announced"))
    (let total _ (. d aevTotal))
    (for i (.. 0 5) (block
      (expr (call frame (& d)))))
    (expr (call ok (&& (&& (== (. d aevTotal) total) (== (. (. d aev) len) 0)) (== (. (. d lq) len) 0)) "idle frames queue nothing"))
    (expr (call ok (&& (== (. (call (. a11y events) (& d) (& mem)) len) 0) (== (. (call (. a11y liveChanges) (& d) (& mem)) len) 0)) "idle frames: events and liveChanges are empty"))
    (let h _ (call (. d handle) (. IDS btn)))
    (expr (call ok (>= h (. dom HANDLE_UNIT)) "an AT id is a handle"))
    (expr (call ok (call same (call nm (& d) (& mem) h) "Save") "name by handle"))
    (expr (call ok (&& (call same (call (. a11y role) (& d) h) "button") (== (call (. a11y actions) (& d) h) 3)) "role and actions by handle"))
    (= (. STATE withBtn) (bool false))
    (expr (call frame (& d)))
    (expr (call ok (! (call (. d alive) h)) "the removed node's handle is gone"))
    (expr (call ok (&& (&& (== (. (call (. a11y name) (& d) (& mem) h) len) 0) (== (. (call (. a11y role) (& d) h) len) 0)) (== (call (. a11y actions) (& d) h) 0)) "a stale handle answers nothing"))
    (expr (call ok (! (call (. a11y perform) (& d) h (. a11y A_CLICK) (float 0x0000000000000000) "")) "a stale handle performs nothing"))
    (let ev _ (call (. a11y events) (& d) (& mem)))
    (let kids _ (bool false))
    (for i (.. 0 (. ev len)) (block
      (if (== (. (index (. ev items) i) kind) (. a11y EV_CHILDREN)) (block
        (= kids (bool true))))))
    (expr (call ok kids "removing a child queues a children-changed event"))
    (= (. STATE withBtn) (bool true))
    (expr (call frame (& d)))
    (expr (call ok (!= (call (. d handle) (. IDS btn)) h) "a recycled id has a new handle"))
    (expr (call ok (! (call (. d alive) h)) "and the old handle stays stale"))
    (expr (call (. a11y events) (& d) (& mem)))
    (let b _ (call (. a11y bounds) (& d) (. IDS btn)))
    (expr (call ok (&& (&& (. b ok) (== (. b w) (. (call (. d size) (. IDS btn)) x))) (== (. b h) (. (call (. d size) (. IDS btn)) y))) "bounds size"))
    (expr (call ok (&& (== (. b x) (call (. d absX) (. IDS btn))) (== (. b y) (call (. d absY) (. IDS btn)))) "bounds origin"))
    (let m _ (call (. a11y bounds) (& d) (. IDS mv)))
    (expr (call ok (&& (&& (&& (. m ok) (== (. m x) (+ (call (. d absX) (. IDS mv)) (float 0x403e000000000000)))) (== (. m y) (call (. d absY) (. IDS mv)))) (== (. m w) (. (call (. d size) (. IDS mv)) x))) "a transform moves the bounds"))
    (expr (call ok (! (. (call (. a11y bounds) (& d) h) ok)) "a stale handle has no bounds"))
    (let s _ (call (. Text new) (& mem)))
    (expr (call (. a11y dump) (& d) (& mem) (& s)))
    (let dump _ (call (. s str)))
    (expr (call ok (call contains dump "tab \"General\" selected=false") "aria-selected false"))
    (expr (call ok (|| (call contains dump "group \"\" expanded=false") (call contains dump "expanded=false")) "details has expanded of its own"))
    (expr (call ok (call contains dump "desc=\"At least 8 characters\"") "describedby is resolved by id"))
    (expr (call ok (&& (call contains dump "live=polite") (call contains dump "live=assertive")) "aria-live shows"))
    (expr (call ok (call same (call (. a11y describedBy) (& d) (& mem) (. IDS inp)) "At least 8 characters") "describedBy text"))
    (= (. STATE selTab) (bool true))
    (= (. STATE open) (bool true))
    (expr (call frame (& d)))
    (let ev2 _ (call (. a11y events) (& d) (& mem)))
    (let sawSel _ (bool false))
    (let sawExp _ (bool false))
    (for i (.. 0 (. ev2 len)) (block
      (if (&& (== (. (index (. ev2 items) i) kind) (. a11y EV_SELECTED)) (== (. (index (. ev2 items) i) h) (call (. d handle) (. IDS tab)))) (block
        (= sawSel (bool true))))
      (if (&& (== (. (index (. ev2 items) i) kind) (. a11y EV_EXPANDED)) (== (. (index (. ev2 items) i) h) (call (. d handle) (. IDS det)))) (block
        (= sawExp (bool true))))))
    (expr (call ok (&& sawSel sawExp) "selected and expanded changes are events"))
    (let s2 _ (call (. Text new) (& mem)))
    (expr (call (. a11y dump) (& d) (& mem) (& s2)))
    (expr (call ok (|| (call contains (call (. s2 str)) "tab \"General\" selected\n") (call contains (call (. s2 str)) "tab \"General\" selected ")) "aria-selected true"))
    (expr (call ok (call contains (call (. s2 str)) "expanded=true") "details open is expanded"))
    (expr (call ok (call same (call nm (& d) (& mem) (. IDS prog)) "Loading") "progress named by its wrapping label"))
    (expr (call ok (call same (call nm (& d) (& mem) (. IDS meter)) "Fuel") "meter named by label for"))
    (expr (call ok (call same (call nm (& d) (& mem) (. IDS ctlA)) "Alpha") "the control a label points at takes its text"))
    (expr (call ok (== (. (call nm (& d) (& mem) (. IDS wrapB)) len) 0) "a control inside a label that is for another control does not take its name"))
    (expr (call ok (call contains dump "text \"Alpha\"") "that label's text is still read"))
    (let ti _ (struct-lit TextInfo (field value "") (field caret 0) (field selLo 0) (field selHi 0)))
    (expr (call ok (call (. a11y perform) (& d) (. IDS tb) (. a11y A_SET) (float 0x0000000000000000) "hello world") "set a text box"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call (. a11y text) (& d) (. IDS tb) (& ti)) (call same (. ti value) "hello world")) "text value"))
    (let e _ (& (index (. (. d eds) items) (call (. d claim) (. IDS tb)))))
    (= (. e anc) 1)
    (= (. e cur) 4)
    (expr (call ok (&& (&& (&& (call (. a11y text) (& d) (. IDS tb) (& ti)) (== (. ti caret) 4)) (== (. ti selLo) 1)) (== (. ti selHi) 4)) "caret and selection"))
    (expr (call ok (! (call (. a11y text) (& d) (. IDS pw) (& ti))) "a password's text is refused"))
    (expr (call ok (! (call (. a11y text) (& d) (. IDS cb) (& ti))) "a checkbox has no text interface"))
    (expr (call (. a11y events) (& d) (& mem)))
    (= (. STATE checked) (bool true))
    (expr (call frame (& d)))
    (let ev3 _ (call (. a11y events) (& d) (& mem)))
    (let sawChk _ (bool false))
    (for i (.. 0 (. ev3 len)) (block
      (if (&& (== (. (index (. ev3 items) i) kind) (. a11y EV_CHECKED)) (== (. (index (. ev3 items) i) h) (call (. d handle) (. IDS cb)))) (block
        (= sawChk (bool true))))))
    (expr (call ok sawChk "checked change is an event"))
    (expr (call ok (call (. a11y perform) (& d) (call (. d handle) (. IDS btn)) (. a11y A_FOCUS) (float 0x0000000000000000) "") "focus by handle"))
    (expr (call ok (call (. d focusVisible)) "a screen-reader focus shows the focus ring"))
    (let ev4 _ (call (. a11y events) (& d) (& mem)))
    (let sawFocus _ (bool false))
    (for i (.. 0 (. ev4 len)) (block
      (if (&& (== (. (index (. ev4 items) i) kind) (. a11y EV_FOCUS)) (== (. (index (. ev4 items) i) h) (call (. d handle) (. IDS btn)))) (block
        (= sawFocus (bool true))))))
    (expr (call ok sawFocus "focus change is an event"))
    (expr (call frame (& d)))
    (expr (call (. a11y events) (& d) (& mem)))
    (let t2 _ (. d aevTotal))
    (expr (call frame (& d)))
    (expr (call frame (& d)))
    (expr (call ok (== (. d aevTotal) t2) "no events once things settle"))
    (expr (call (. a11y liveChanges) (& d) (& mem)))
    (= (. STATE msg) "saved")
    (expr (call frame (& d)))
    (let l _ (call (. a11y liveChanges) (& d) (& mem)))
    (expr (call ok (&& (&& (== (. l len) 1) (call same (. (index (. l items) 0) text) "saved")) (! (. (index (. l items) 0) assertive))) "a polite live change"))
    (expr (call ok (== (. (index (. l items) 0) h) (call (. d handle) (. IDS live))) "live change names the region"))
    (= (. STATE msg) "saved again")
    (= (. STATE alert) "error!")
    (expr (call frame (& d)))
    (let l2 _ (call (. a11y liveChanges) (& d) (& mem)))
    (expr (call ok (&& (&& (&& (== (. l2 len) 2) (! (. (index (. l2 items) 0) assertive))) (. (index (. l2 items) 1) assertive)) (call same (. (index (. l2 items) 1) text) "error!")) "polite then assertive"))
    (expr (call frame (& d)))
    (expr (call ok (== (. (call (. a11y liveChanges) (& d) (& mem)) len) 0) "drained once"))
    (expr (call ok (! (call (. d wantsFrame))) "idle: no frame wanted"))
    (let ib _ (call (. a11y inbox) (& mem) (& d) 4))
    (expr (call ok (call (. a11y post) ib (call (. d handle) (. IDS tb)) (. a11y A_SET) (float 0x0000000000000000) "from AT") "post"))
    (expr (call ok (call (. d wantsFrame)) "a post asks for a frame"))
    (expr (call ok (! (call (. d wantsFrame))) "and it is consumed"))
    (expr (call ok (== (call (. a11y drain) ib (& mem)) 1) "drain runs it"))
    (expr (call frame (& d)))
    (expr (call ok (&& (call (. a11y text) (& d) (. IDS tb) (& ti)) (call same (. ti value) "from AT")) "the posted action ran"))
    (expr (call ok (== (call (. a11y drain) ib (& mem)) 0) "nothing left"))
    (expr (call ok (! (call contains dump "Ghostly")) "visibility: hidden is left out of the tree"))
    (expr (call (. i18n setLocale) "de"))
    (expr (call ok (call same (call (. a11y language)) "de") "the locale is the document language"))
    (expr (call (. i18n setLocale) ""))
    (expr (call tabTest (& mem) (& css)))
    (expr (call ordTest (& mem) (& css)))
    (expr (call quietTest (& mem) (& css)))
    (expr (call printLn (interp "a11y_gaps_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
