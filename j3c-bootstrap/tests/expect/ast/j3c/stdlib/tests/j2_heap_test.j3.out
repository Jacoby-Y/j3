(file (module j2_heap_test)
  (use j3.io.printLn)
  (use j3.j2)
  (use j3.j2 (names Heap Value Tbl Arr))
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.Text)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call panic msg))))))
  (fn str (params (h (ref Heap)) (mem (ref Arena)) (v Value)) string (block
    (let t _ (call (. Text new) mem))
    (expr (call (. j2 fmtValue) (& t) v))
    (return (call (. t str)))))
  (fn eqs (params (got string) (want string) (what string)) _ (block
    (if (! (== got want)) (block
      (expr (call printLn (interp what ": got [" got "] want [" want "]")))
      (expr (call panic what))))))
  (fn testIntern (params (h (ref Heap))) _ (block
    (let a _ (call (. h intern) "hello"))
    (let b _ (call (. h intern) "hel"))
    (let c _ (call (. h intern) "hello"))
    (expr (call ok (call (. j2 same) a c) "same text interns to one object"))
    (expr (call ok (! (call (. j2 same) a b)) "different text, different object"))
    (expr (call ok (== (call (. j2 textOf) a) "hello") "bytes kept"))
    (expr (call ok (== (. (call (. h lookupStr) "hello") tag) (. j2 T_STR)) "lookup finds interned"))
    (expr (call ok (call (. (call (. h lookupStr) "nope") isNil)) "lookup misses without interning"))
    (let mem _ (call (. Arena create) (<< 1 16)))
    (let first _ (call (. h intern) "k0"))
    (for i (.. 0 5000) (block
      (let t _ (call (. Text new) (& mem)))
      (expr (call (. t pushStr) "k"))
      (expr (call (. t pushInt) i))
      (expr (call (. h intern) (call (. t str))))))
    (expr (call ok (call (. j2 same) first (call (. h intern) "k0")) "identity after growth"))
    (expr (call ok (call (. j2 same) (call (. h intern) "k4999") (call (. h lookupStr) "k4999")) "late string found"))
    (let empty _ (call (. h intern) ""))
    (expr (call ok (call (. j2 same) empty (call (. h intern) "")) "empty string interns"))
    (expr (call (. mem destroy)))))
  (fn testChurn (params (h (ref Heap))) _ (block
    (let tv _ (call (. h newTable)))
    (let t _ (call (. j2 tableOf) tv))
    (let n _ 100000)
    (for i (.. 0 n) (block
      (expr (call ok (call (. t set) h (call (. j2 intv) i) (call (. j2 intv) (* i 2))) "set"))))
    (expr (call ok (== (call (. t count)) n) "count after insert"))
    (for i (.. 0 (/ n 2)) (block
      (expr (call (. t set) h (call (. j2 intv) (* i 2)) (call (. j2 nilv))))))
    (expr (call ok (== (call (. t count)) (/ n 2)) "count after delete"))
    (expr (call ok (call (. (call (. t get) (call (. j2 intv) 4)) isNil)) "deleted key is nil"))
    (expr (call ok (== (. (call (. t get) (call (. j2 intv) 5)) bits) 10) "kept key"))
    (for i (.. 0 (/ n 2)) (block
      (expr (call (. t set) h (call (. j2 intv) (* i 2)) (call (. j2 intv) (- 1))))))
    (expr (call ok (== (call (. t count)) n) "count after reinsert"))
    (let es _ (call (. t entries)))
    (let i _ (call (. t next) 0))
    (let k _ 0)
    (while (>= i 0) (block
      (let want _ (if-expr (< k (/ n 2)) (+ (* k 2) 1) (* (- k (/ n 2)) 2)))
      (expr (call ok (== (. (. (index es i) key) bits) want) "insertion order after churn"))
      (+= k 1)
      (= i (call (. t next) (+ i 1)))))
    (expr (call ok (== k n) "walk count"))
    (let small _ (call (. j2 tableOf) (call (. h newTable))))
    (let key _ (call (. h intern) "x"))
    (expr (call (. small set) h (call (. h intern) "a") (call (. j2 intv) 1)))
    (for j (.. 0 100000) (block
      (expr (call (. small set) h key (call (. j2 intv) j)))
      (expr (call (. small set) h key (call (. j2 nilv))))))
    (expr (call ok (<= (. small cap) 8) "tombstones are reclaimed"))
    (expr (call ok (== (call (. small count)) 1) "churned table count"))))
  (fn testKeys (params (h (ref Heap)) (mem (ref Arena))) _ (block
    (let t _ (call (. j2 tableOf) (call (. h newTable))))
    (expr (call (. t set) h (call (. j2 floatv) (float 0x4000000000000000)) (call (. h intern) "two")))
    (expr (call ok (call (. j2 same) (call (. t get) (call (. j2 intv) 2)) (call (. h intern) "two")) "2.0 and 2 are one key"))
    (expr (call (. t set) h (call (. j2 floatv) (- (float 0x0000000000000000))) (call (. j2 intv) 7)))
    (expr (call ok (== (. (call (. t get) (call (. j2 intv) 0)) bits) 7) "-0.0 is key 0"))
    (expr (call (. t set) h (call (. j2 floatv) (float 0x4004000000000000)) (call (. j2 intv) 9)))
    (expr (call ok (== (. (call (. t get) (call (. j2 floatv) (float 0x4004000000000000))) bits) 9) "float key"))
    (expr (call ok (! (call (. t set) h (call (. j2 nilv)) (call (. j2 intv) 1))) "nil key rejected"))
    (let nan _ (call (. j2 floatv) (/ (float 0x0000000000000000) (call zero))))
    (expr (call ok (! (call (. t set) h nan (call (. j2 intv) 1))) "NaN key rejected"))
    (expr (call ok (call (. (call (. t get) nan) isNil)) "NaN get misses"))
    (expr (call (. t set) h (call (. j2 boolv) (bool true)) (call (. j2 intv) 3)))
    (expr (call ok (&& (== (. (call (. t get) (call (. j2 boolv) (bool true))) bits) 3) (call (. (call (. t get) (call (. j2 boolv) (bool false))) isNil))) "bool keys"))
    (let other _ (call (. h newTable)))
    (expr (call (. t set) h other (call (. j2 intv) 4)))
    (expr (call ok (&& (== (. (call (. t get) other) bits) 4) (call (. (call (. t get) (call (. h newTable))) isNil))) "table keys by identity"))
    (let mem2 _ (call (. Text new) mem))
    (expr (call (. mem2 pushStr) "na"))
    (expr (call (. mem2 pushStr) "me"))
    (expr (call (. t set) h (call (. h intern) "name") (call (. j2 intv) 1)))
    (expr (call (. t set) h (call (. h intern) (call (. mem2 str))) (call (. j2 intv) 2)))
    (expr (call ok (== (. (call (. t get) (call (. h intern) "name")) bits) 2) "built string is the same key"))
    (expr (call ok (call (. j2 equals) (call (. j2 intv) 2) (call (. j2 floatv) (float 0x4000000000000000))) "2 == 2.0"))
    (expr (call ok (! (call (. j2 equals) (call (. j2 intv) 2) (call (. h intern) "2"))) "2 != \"2\""))
    (expr (call ok (&& (! (call (. (call (. j2 nilv)) truthy))) (! (call (. (call (. j2 boolv) (bool false)) truthy)))) "nil and false are false"))
    (expr (call ok (&& (call (. (call (. j2 intv) 0) truthy)) (call (. (call (. h intern) "") truthy))) "0 and \"\" are true"))))
  (fn zero (params) f64 (block
    (return (float 0x0000000000000000))))
  (fn testArray (params (h (ref Heap))) _ (block
    (let a _ (call (. j2 arrOf) (call (. h newArray) 0)))
    (for i (.. 0 1000) (block
      (expr (call (. a push) h (call (. j2 intv) i)))))
    (expr (call ok (&& (== (. a len) 1000) (>= (. a cap) 1000)) "array growth"))
    (expr (call ok (&& (&& (== (. (call (. a get) 999) bits) 999) (call (. (call (. a get) 1000) isNil))) (call (. (call (. a get) (- 1)) isNil))) "array get"))
    (expr (call ok (call (. a set) h 1000 (call (. j2 intv) 5)) "set at len appends"))
    (expr (call ok (== (. a len) 1001) "append via set"))
    (expr (call ok (! (call (. a set) h 1002 (call (. j2 intv) 5))) "set past len fails"))
    (expr (call ok (! (call (. a set) h (- 1) (call (. j2 intv) 5))) "set negative fails"))
    (expr (call ok (&& (&& (call (. a insert) h 0 (call (. j2 intv) (- 1))) (== (. (call (. a get) 0) bits) (- 1))) (== (. (call (. a get) 1) bits) 0)) "insert front"))
    (expr (call ok (&& (== (. (call (. a remove) 0) bits) (- 1)) (== (. (call (. a get) 0) bits) 0)) "remove front"))
    (expr (call ok (&& (== (. (call (. a pop)) bits) 5) (== (. a len) 1000)) "pop"))
    (let e _ (call (. j2 arrOf) (call (. h newArray) 3)))
    (expr (call ok (&& (&& (== (. e len) 0) (call (. (call (. e pop)) isNil))) (call (. (call (. e remove) 0) isNil))) "empty array"))))
  (fn testKeep (params (h (ref Heap))) _ (block
    (let v _ (call (. h intern) "kept"))
    (let r _ (call (. h keep) v))
    (expr (call ok (call (. j2 same) (call (. h refValue) r) v) "kept value"))
    (expr (call (. h releaseRef) r))
    (expr (call ok (call (. (call (. h refValue) r) isNil)) "released ref reads nil"))
    (let r2 _ (call (. h keep) (call (. j2 intv) 3)))
    (expr (call ok (call (. (call (. h refValue) r) isNil)) "stale ref stays nil after its slot is reused"))
    (expr (call ok (== (. (call (. h refValue) r2) bits) 3) "new ref"))
    (expr (call (. h releaseRef) r))
    (expr (call ok (== (. (call (. h refValue) r2) bits) 3) "double release of a stale ref is harmless"))
    (expr (call (. h releaseRef) (call (. j2 none))))
    (expr (call ok (call (. (call (. h refValue) (call (. j2 none))) isNil)) "none"))
    (for i (.. 0 100) (block
      (expr (call (. h keep) (call (. j2 intv) i)))))
    (expr (call ok (== (. (call (. h refValue) r2) bits) 3) "ref survives slot growth"))))
  (fn testStr (params (h (ref Heap)) (mem (ref Arena))) _ (block
    (expr (call eqs (call str h mem (call (. j2 nilv))) "nil" "nil"))
    (expr (call eqs (call str h mem (call (. j2 boolv) (bool true))) "true" "true"))
    (expr (call eqs (call str h mem (call (. j2 intv) (- 42))) "-42" "int"))
    (expr (call eqs (call str h mem (call (. j2 floatv) (float 0x4008000000000000))) "3.0" "float integral"))
    (expr (call eqs (call str h mem (call (. j2 floatv) (float 0x400c000000000000))) "3.5" "float"))
    (expr (call eqs (call str h mem (call (. j2 floatv) (float 0x3fb999999999999a))) "0.1" "float shortest"))
    (expr (call eqs (call str h mem (call (. j2 floatv) (float 0x4415af1d78b58c40))) "1e+20" "float big"))
    (expr (call eqs (call str h mem (call (. j2 floatv) (/ (float 0x3ff0000000000000) (call zero)))) "inf" "inf"))
    (expr (call eqs (call str h mem (call (. h intern) "hi")) "hi" "string"))
    (let a _ (call (. h newArray) 0))
    (expr (call (. (call (. j2 arrOf) a) push) h (call (. j2 intv) 1)))
    (expr (call (. (call (. j2 arrOf) a) push) h (call (. h intern) "x\"y")))
    (expr (call eqs (call str h mem a) "[1, \"x\\\"y\"]" "array"))
    (let t _ (call (. h newTable)))
    (expr (call (. (call (. j2 tableOf) t) set) h (call (. h intern) "x") (call (. j2 intv) 1)))
    (expr (call (. (call (. j2 tableOf) t) set) h (call (. h intern) "a b") (call (. j2 floatv) (float 0x4000000000000000))))
    (expr (call (. (call (. j2 tableOf) t) set) h (call (. j2 intv) 7) a))
    (expr (call eqs (call str h mem t) "{x: 1, \"a b\": 2.0, 7: [1, \"x\\\"y\"]}" "table"))
    (let l1 _ (call (. h newTable)))
    (let l2 _ (call (. h newTable)))
    (let l3 _ (call (. h newTable)))
    (expr (call (. (call (. j2 tableOf) l1) set) h (call (. h intern) "b") l2))
    (expr (call (. (call (. j2 tableOf) l2) set) h (call (. h intern) "c") l3))
    (expr (call (. (call (. j2 tableOf) l3) set) h (call (. h intern) "d") (call (. j2 intv) 1)))
    (let top _ (call (. h newTable)))
    (expr (call (. (call (. j2 tableOf) top) set) h (call (. h intern) "a") l1))
    (expr (call eqs (call str h mem top) "{a: {b: {c: {...}}}}" "depth cut"))
    (expr (call (. (call (. j2 tableOf) l3) set) h (call (. h intern) "self") l3))
    (expr (call eqs (call str h mem l3) "{d: 1, self: {d: 1, self: {d: 1, self: {...}}}}" "cycle cut"))
    (expr (call eqs (call str h mem (call (. h newTable))) "{}" "empty table"))
    (expr (call eqs (call (. j2 typeName) a) "array" "typeName"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 20)))
    (let h _ (call (. j2 newHeap)))
    (expr (call testIntern (& h)))
    (expr (call testChurn (& h)))
    (expr (call testKeys (& h) (& mem)))
    (expr (call testArray (& h)))
    (expr (call testKeep (& h)))
    (expr (call testStr (& h) (& mem)))
    (expr (call ok (&& (> (. h bytes) 0) (> (. h liveObjects) 0)) "bytes and objects tracked"))
    (expr (call (. h destroy)))
    (expr (call printLn "j2_heap_test ok")))))
--- stderr
--- exit 0
