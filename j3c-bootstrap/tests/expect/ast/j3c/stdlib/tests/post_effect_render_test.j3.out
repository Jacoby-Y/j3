(file (module post_effect_render_test)
  (use-lib "GL" gl
    (lib-fn glGetError (params) u32 _))
  (use j3.game)
  (use j3.game.Color)
  (use j3.gfx.paint)
  (use j3.gfx.paint.Effects)
  (use j3.gfx.canvas (names Canvas Mode))
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.io.printLn)
  (use j3.result.Result)
  (use j3.sys.panic)
  (fn ok (params (b bool) (msg string)) _ (block
    (if (! b) (block
      (expr (call panic msg))))))
  (fn near (params (v int) (w int) (msg string)) _ (block
    (let d _ (- v w))
    (if (< d 0) (block
      (= d (- 0 d))))
    (if (> d 3) (block
      (expr (call printLn (interp msg ": " v " vs " w)))
      (expr (call panic msg))))))
  (fn rect (params (x f32) (y f32) (w f32) (h f32) (r u8) (g u8) (b u8)) _ (block
    (expr (call (. paint rect) (struct-lit Vec2 (field x x) (field y y)) (struct-lit Vec2 (field x w) (field y h)) (struct-lit Color (field r r) (field g g) (field b b) (field a 255))))))
  (fn pixel (params (p (slice u8)) (x int) (y int) (c int)) int (block
    (return (call int (index p (+ (* (+ (* y 480) x) 4) c))))))
  (fn read (params (p (slice u8))) _ (block
    (expr (call ok (call (. game readWindow) p) "read frame"))
    (let e _ (call (. gl glGetError)))
    (if (!= e 0) (block
      (expr (call printLn (interp "GL error " e)))
      (expr (call panic "effect GL error"))))))
  (fn end (params (f Effects)) _ (block
    (expr (call (. paint endLayer) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x 480) (field y 320)) f))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 16 1024) 1024)))
    (let p _ (call (. mem alloc) (targs u8) (* (* 480 320) 4)))
    (let reference _ (call (. mem alloc) (targs u8) (* (* 480 320) 4)))
    (expr (call (. game initGlHidden) "post effect checks" 480 320))
    (expr (call (. game clearTo) (struct-lit Color (field r 20) (field g 40) (field b 60) (field a 255))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 20) (field y 20)) (struct-lit Vec2 (field x 140) (field y 140)) (struct-lit Color (field r 255) (field g 20) (field b 40) (field a 128))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 80) (field y 60)) (struct-lit Vec2 (field x 140) (field y 140)) (struct-lit Color (field r 30) (field g 40) (field b 255) (field a 128))))
    (expr (call read reference))
    (expr (call (. game clearTo) (struct-lit Color (field r 20) (field g 40) (field b 60) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 20) (field y 20)) (struct-lit Vec2 (field x 140) (field y 140)) (struct-lit Color (field r 255) (field g 20) (field b 40) (field a 128))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 80) (field y 60)) (struct-lit Vec2 (field x 140) (field y 140)) (struct-lit Color (field r 30) (field g 40) (field b 255) (field a 128))))
    (expr (call end (struct-lit Effects)))
    (expr (call read p))
    (for i (.. 0 (. p len)) (block
      (expr (call near (call int (index p i)) (call int (index reference i)) "neutral transparent group equivalence"))))
    (expr (call (. game clearTo) (struct-lit Color (field r 255) (field g 255) (field b 255) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call rect 100 80 100 100 255 0 0))
    (expr (call end (struct-lit Effects (field blur 8))))
    (expr (call read p))
    (expr (call near (call pixel p 95 120 0) 255 "transparent blur retains saturated edge on white"))
    (expr (call ok (&& (> (call pixel p 95 120 1) 100) (< (call pixel p 95 120 1) 250)) "blur spreads smoothly beyond content"))
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call rect 100 80 30 30 255 255 255))
    (expr (call end (struct-lit Effects (field bloom 1))))
    (expr (call read p))
    (expr (call ok (> (call pixel p 90 95 0) 0) "bloom reaches outside source"))
    (expr (call (. game clearTo) (struct-lit Color (field r 128) (field g 64) (field b 192) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 200 200 128 128 128))
    (expr (call end (struct-lit Effects (field blend 1))))
    (expr (call read p))
    (expr (call near (call pixel p 80 80 0) 64 "multiply red"))
    (expr (call near (call pixel p 80 80 1) 32 "multiply green"))
    (expr (call near (call pixel p 80 80 2) 96 "multiply blue"))
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call rect 0 0 480 320 255 0 0))
    (expr (call end (struct-lit Effects (field grayscale 1))))
    (expr (call read p))
    (expr (call near (call pixel p 80 80 0) (call pixel p 80 80 1) "grayscale red/green"))
    (expr (call near (call pixel p 80 80 1) (call pixel p 80 80 2) "grayscale green/blue"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 0 0 480 320 128 128 128))
    (expr (call end (struct-lit Effects (field grain (float 0x3fe0000000000000)))))
    (expr (call read p))
    (let lo _ 255)
    (let hi _ 0)
    (for i (.. 0 60) (block
      (let c _ (call pixel p (+ 50 i) 80 0))
      (if (< c lo) (block
        (= lo c)))
      (if (> c hi) (block
        (= hi c)))))
    (expr (call ok (> (- hi lo) 50) "grain changes pixels"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 0 0 480 320 200 200 200))
    (expr (call end (struct-lit Effects (field scanlines (float 0x3fe0000000000000)))))
    (expr (call read p))
    (expr (call ok (!= (call pixel p 80 80 0) (call pixel p 80 81 0)) "scanlines alternate rows"))
    (let sh _ (call (. paint shader) "vec4 effect(vec2 uv,vec4 color){return vec4(0.0,1.0,0.0,color.a);}"))
    (expr (call ok (> sh 0) "custom shader compiles"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 200 200 255 0 0))
    (expr (call end (struct-lit Effects (field shader sh))))
    (expr (call read p))
    (expr (call near (call pixel p 80 80 1) 255 "custom shader applies"))
    (expr (call near (call pixel p 80 80 0) 0 "custom shader red removed"))
    (let bad _ (call (. paint shader) "vec4 effect(vec2 uv,vec4 c){return undefined_symbol;}"))
    (expr (call ok (== bad 0) "bad shader returns zero"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 200 200 255 0 0))
    (expr (call end (struct-lit Effects (field shader sh))))
    (expr (call read p))
    (expr (call near (call pixel p 80 80 1) 255 "failed shader leaves existing shader working"))
    (let target _ (call (. paint target) 160 100))
    (expr (call (. paint beginTarget) target))
    (let activeSize _ (call (. game windowSize)))
    (expr (call ok (== (. activeSize x) 160) "target dimensions active"))
    (expr (call rect 0 0 160 50 255 0 0))
    (expr (call rect 0 50 160 50 0 255 0))
    (expr (call (. paint beginLayer)))
    (expr (call rect 0 40 160 20 0 0 255))
    (expr (call (. paint endLayer) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x 160) (field y 100)) (struct-lit Effects (field brightness 1))))
    (expr (call (. paint endTarget)))
    (let parentSize _ (call (. game windowSize)))
    (expr (call ok (== (. parentSize x) 480) "target dimensions restored"))
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let tex _ (call (. paint targetTexture) target))
    (expr (call (. paint projectTexture) tex (struct-lit Vec2 (field x 20) (field y 20)) (struct-lit Vec2 (field x 160) (field y 100)) 0 0 0))
    (expr (call read p))
    (expr (call near (call pixel p 80 40 0) 255 "target top orientation"))
    (expr (call near (call pixel p 80 100 1) 255 "target bottom orientation"))
    (expr (call near (call pixel p 80 70 2) 255 "layer inside small target"))
    (expr (call (. paint projectTexture) tex (struct-lit Vec2 (field x 260) (field y 80)) (struct-lit Vec2 (field x 160) (field y 160)) 20 35 300))
    (expr (call read p))
    (expr (call ok (> (call pixel p 340 160 2) 100) "perspective plane preserves center content"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 180 200 100 255 100 30))
    (expr (call (. paint endLayer) (struct-lit Vec2 (field x 20) (field y 180)) (struct-lit Vec2 (field x 200) (field y 100)) (struct-lit Effects (field brightness (float 0x3ff199999999999a)) (field contrast (float 0x3ff3333333333333)) (field saturation (float 0x3fe999999999999a)) (field sepia (float 0x3fc999999999999a)) (field invert (float 0x3fb999999999999a)) (field hue 35) (field crt (float 0x3fd3333333333333)) (field blend 2) (field rotateY 20))))
    (expr (call read p))
    (let capture _ (call (. Canvas create) (& mem) 480 320 (. Mode Pixel)))
    (for i (.. 0 (. p len)) (block
      (= (index (. capture pixels) i) (index p i))))
    (match (call (. capture savePng) "/tmp/j3-post-features.png" (& mem))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "save features")))))
    (let vp _ (as (call (. game glProc) "glViewport") (fn-type (i32 i32 i32 i32) _)))
    (expr (call vp 7 9 100 80))
    (let useProg _ (as (call (. game glProc) "glUseProgram") (fn-type (u32) _)))
    (expr (call useProg 0))
    (let active _ (as (call (. game glProc) "glActiveTexture") (fn-type (u32) _)))
    (expr (call active 33987))
    (let blend _ (as (call (. game glProc) "glBlendFuncSeparate") (fn-type (u32 u32 u32 u32) _)))
    (expr (call blend 1 0 0 1))
    (let mask _ (as (call (. game glProc) "glColorMask") (fn-type (u8 u8 u8 u8) _)))
    (expr (call mask 1 0 1 0))
    (let en _ (as (call (. game glProc) "glEnable") (fn-type (u32) _)))
    (expr (call en 3089))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 100 100 255 255 255))
    (expr (call end (struct-lit Effects (field blur 4))))
    (let gi _ (as (call (. game glProc) "glGetIntegerv") (fn-type (u32 ptr) _)))
    (let v i32 0)
    (expr (call gi 35725 (as (& v) ptr)))
    (expr (call ok (== v 0) "layer program restored"))
    (expr (call gi 34016 (as (& v) ptr)))
    (expr (call ok (== v 33987) "layer active unit restored"))
    (expr (call gi 32969 (as (& v) ptr)))
    (expr (call ok (== v 1) "layer blend source restored"))
    (expr (call gi 32971 (as (& v) ptr)))
    (expr (call ok (== v 0) "layer alpha blend source restored"))
    (let values (array 4 i32) (array-lit 0 0 0 0))
    (expr (call gi 2978 (as (& (index values 0)) ptr)))
    (expr (call ok (&& (&& (&& (== (index values 0) 7) (== (index values 1) 9)) (== (index values 2) 100)) (== (index values 3) 80)) "layer viewport restored"))
    (expr (call gi 3107 (as (& (index values 0)) ptr)))
    (expr (call ok (&& (&& (&& (== (index values 0) 1) (== (index values 1) 0)) (== (index values 2) 1)) (== (index values 3) 0)) "layer color mask restored"))
    (expr (call mask 1 1 1 1))
    (let dis _ (as (call (. game glProc) "glDisable") (fn-type (u32) _)))
    (expr (call dis 3089))
    (expr (call active 33984))
    (expr (call (. game present)))
    (expr (call (. game clearTo) (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 100 100 255 255 255))
    (expr (call end (struct-lit Effects)))
    (expr (call (. game present)))
    (let plainStats _ (call (. game lastFrameStats)))
    (expr (call ok (== (. plainStats draws) 3) "neutral group reports content, FX and composite draws"))
    (expr (call (. paint beginLayer)))
    (expr (call rect 20 20 100 100 255 255 255))
    (expr (call (. paint endLayer) (struct-lit Vec2 (field x 20) (field y 20)) (struct-lit Vec2 (field x 100) (field y 100)) (struct-lit Effects (field blur 4) (field bloom 1) (field shader sh) (field rotateY 10) (field perspective 300))))
    (expr (call (. game present)))
    (let allStats _ (call (. game lastFrameStats)))
    (expr (call ok (== (. allStats draws) 10) "all effect passes counted in frame stats"))
    (expr (call (. paint destroyShader) sh))
    (expr (call (. paint destroyTarget) target))
    (expr (call (. game destroy)))
    (expr (call (. mem destroy)))
    (expr (call printLn "post_effect_render_test: passed (premultiplied blur, bloom, blend, filters, grain, scanlines, shader success/failure, target nesting, perspective, GL state, transparent equivalence, draw stats, teardown)")))))
--- stderr
--- exit 0
