(file (module apkassets_test)
  (use j3.apkassets (names boot safePath sync Source))
  (use j3.io.printLn)
  (use j3.sys (names close lseek open openMode panic read write O_CREAT O_RDONLY O_TRUNC O_WRONLY SEEK_END SEEK_SET))
  (use j3.text.cstr)
  (use-lib "c" c
    (lib-fn system (params (cmd cstr)) i32 _))
  (const BIG int 200000)
  (const SRC string "/tmp/j3_apkassets_src")
  (mod-let (doc "Added to every reported size: simulates a source that returns fewer bytes than it promised.") PADSIZE int 0)
  (mod-let PATHBUF (array 512 u8) _)
  (mod-let LOGS int 0)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn srcOpen (params (path ptr)) ptr (block
    (let k _ 0)
    (let root _ SRC)
    (for i (.. 0 (. root len)) (block
      (= (index PATHBUF k) (index root i))
      (+= k 1)))
    (= (index PATHBUF k) 47)
    (+= k 1)
    (let q _ (as path int))
    (while (< k 500) (block
      (let cp _ (as (as q ptr) (ref u8)))
      (let b _ (* cp))
      (if (== b 0) (block
        (break)))
      (= (index PATHBUF k) b)
      (+= k 1)
      (+= q 1)))
    (= (index PATHBUF k) 0)
    (let fd _ (call open (as (& (index PATHBUF 0)) ptr) O_RDONLY))
    (if (< fd 0) (block
      (return (as 0 ptr))))
    (return (as (+ fd 1) ptr))))
  (fn srcRead (params (h ptr) (buf ptr) (n int)) int (block
    (return (call read (- (as h int) 1) buf n))))
  (fn srcClose (params (h ptr)) _ (block
    (expr (call close (- (as h int) 1)))))
  (fn srcSize (params (h ptr)) int (block
    (let fd _ (- (as h int) 1))
    (let n _ (call lseek fd 0 SEEK_END))
    (expr (call lseek fd 0 SEEK_SET))
    (return (+ n PADSIZE))))
  (fn srcLog (params (msg ptr)) _ (block
    (+= LOGS 1)))
  (fn srcMs (params) int (block
    (return 0)))
  (fn source (params) Source (block
    (return (struct-lit Source (field open srcOpen) (field read srcRead) (field close srcClose) (field size srcSize) (field log srcLog) (field ms srcMs)))))
  (fn put (params (rel string) (data string)) _ (block
    (let fd _ (call openMode (as (call cstr (interp SRC "/" rel)) ptr) (+ (+ O_WRONLY O_CREAT) O_TRUNC) 420))
    (expr (call ok (>= fd 0) "put open"))
    (expr (call write fd (as (. data ptr) ptr) (. data len)))
    (expr (call close fd))))
  (fn (doc "Run a shell command; true when it exits 0.") sh (params (cmd string)) bool (block
    (return (== (call (. c system) (call cstr cmd)) 0))))
  (const DST string "/tmp/j3_apkassets_dst")
  (fn main (params) _ (block
    (expr (call sh "rm -rf /tmp/j3_apkassets_src /tmp/j3_apkassets_dst /tmp/j3_apkassets_dst2 && mkdir -p /tmp/j3_apkassets_src/sub/deep /tmp/j3_apkassets_dst"))
    (expr (call put "a.txt" "hello"))
    (expr (call put "sub/deep/b.bin" "nested"))
    (expr (call ok (call sh "head -c 200000 /dev/urandom > /tmp/j3_apkassets_src/big.bin") "make big file"))
    (expr (call ok (&& (&& (&& (call safePath "a/b.txt") (call safePath "a.b/c")) (call safePath "a/..b")) (call safePath "..a")) "safe paths"))
    (expr (call ok (&& (&& (&& (&& (&& (&& (&& (! (call safePath "/etc/x")) (! (call safePath "../x"))) (! (call safePath "a/../x"))) (! (call safePath "a/.."))) (! (call safePath "a\\b"))) (! (call safePath ""))) (! (call safePath "a//b"))) (! (call safePath "a/"))) "unsafe paths"))
    (let m1 _ "j3assets 1 s1\na.txt\n\nsub/deep/b.bin\r\nbig.bin\n../evil\n/abs\nback\\slash\n")
    (let r _ (call sync m1 (call source) DST))
    (expr (call ok (&& (&& (&& (&& (. r manifest) (! (. r upToDate))) (== (. r copied) 3)) (== (. r failed) 0)) (== (. r rejected) 3)) "fresh copy counts"))
    (expr (call ok (call sh "cmp -s /tmp/j3_apkassets_src/a.txt /tmp/j3_apkassets_dst/a.txt") "a.txt copied"))
    (expr (call ok (call sh "cmp -s /tmp/j3_apkassets_src/sub/deep/b.bin /tmp/j3_apkassets_dst/sub/deep/b.bin") "nested file copied"))
    (expr (call ok (call sh "cmp -s /tmp/j3_apkassets_src/big.bin /tmp/j3_apkassets_dst/big.bin") "big file copied whole"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/j3assets.stamp)\" = s1") "stamp is s1"))
    (expr (call ok (call sh "test -z \"$(find /tmp/j3_apkassets_dst -name '*.tmp')\"") "no tmp files left"))
    (expr (call ok (! (call sh "test -e /tmp/evil")) "nothing escaped the destination"))
    (expr (call put "a.txt" "changed"))
    (= r (call sync m1 (call source) DST))
    (expr (call ok (&& (&& (. r manifest) (. r upToDate)) (== (. r copied) 0)) "skip on same stamp"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/a.txt)\" = hello") "dest untouched"))
    (let m2 _ "j3assets 1 s2\na.txt\nsub/deep/b.bin\nbig.bin\n")
    (= r (call sync m2 (call source) DST))
    (expr (call ok (&& (&& (== (. r copied) 3) (== (. r failed) 0)) (! (. r upToDate))) "recopy on new stamp"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/a.txt)\" = changed") "a.txt updated"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/j3assets.stamp)\" = s2") "stamp is s2"))
    (expr (call put "a.txt" "third"))
    (let m3 _ "j3assets 1 s3\nmissing.txt\na.txt\nbig.bin\n")
    (= r (call sync m3 (call source) DST))
    (expr (call ok (&& (== (. r copied) 2) (== (. r failed) 1)) "missing file counts"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/a.txt)\" = third") "later files still copied"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/j3assets.stamp)\" = s2") "no stamp after a failure"))
    (expr (call ok (call sh "test ! -e /tmp/j3_apkassets_dst/missing.txt && test -z \"$(find /tmp/j3_apkassets_dst -name '*.tmp')\"") "no partial file"))
    (expr (call put "missing.txt" "now here"))
    (= r (call sync m3 (call source) DST))
    (expr (call ok (&& (== (. r copied) 3) (== (. r failed) 0)) "retry copies everything"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/j3assets.stamp)\" = s3") "stamp is s3 after the retry"))
    (= PADSIZE 10)
    (let m4 _ "j3assets 1 s4\na.txt\n")
    (= r (call sync m4 (call source) DST))
    (= PADSIZE 0)
    (expr (call ok (&& (== (. r copied) 0) (== (. r failed) 1)) "truncated asset fails"))
    (expr (call ok (call sh "test \"$(cat /tmp/j3_apkassets_dst/j3assets.stamp)\" = s3 && test \"$(cat /tmp/j3_apkassets_dst/a.txt)\" = third") "truncated: stamp and old file kept"))
    (expr (call ok (call sh "test -z \"$(find /tmp/j3_apkassets_dst -name '*.tmp')\"") "truncated: tmp removed"))
    (expr (call ok (&& (&& (&& (&& (! (call safePath "j3assets.stamp")) (! (call safePath "x.tmp"))) (! (call safePath "d/a.txt.tmp"))) (call safePath "sub/j3assets.stamp")) (call safePath "tmp")) "reserved names"))
    (= r (call sync "j3assets 1 s5\nj3assets.stamp\nx.tmp\na.txt\n" (call source) DST))
    (expr (call ok (&& (== (. r rejected) 2) (== (. r copied) 1)) "reserved names rejected in a manifest"))
    (= r (call sync "nonsense\na.txt\n" (call source) DST))
    (expr (call ok (&& (! (. r manifest)) (== (. r copied) 0)) "bad header"))
    (= r (call sync "j3assets 1 has space\na.txt\n" (call source) DST))
    (expr (call ok (! (. r manifest)) "stamp with a space"))
    (expr (call put "j3assets.txt" "j3assets 1 b1\na.txt\n"))
    (expr (call sh "mkdir -p /tmp/j3_apkassets_dst2"))
    (expr (call ok (call boot (call source) "/tmp/j3_apkassets_dst2") "boot chdir"))
    (expr (call ok (call sh "test \"$(pwd -P)\" = /tmp/j3_apkassets_dst2 && test -f a.txt && test -f j3assets.stamp") "boot copied and moved cwd"))
    (expr (call ok (> LOGS 0) "log was called"))
    (expr (call sh "rm -rf /tmp/j3_apkassets_src /tmp/j3_apkassets_dst /tmp/j3_apkassets_dst2"))
    (expr (call printLn "apkassets_test: ok")))))
--- stderr
--- exit 0
