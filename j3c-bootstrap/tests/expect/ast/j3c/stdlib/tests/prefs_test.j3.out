(file (module prefs_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (mod-let ON bool _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (const SHEET string ".a { width: 10px; height: 10px; ripple: #ffffff 200ms; } .l { width: 50px; height: 50px; overflow-y: auto; scroll-behavior: smooth; } .r { height: 40px; } .e { width: 20px; height: 20px; } .f { width: 20px; height: 20px; } .a { width: 10px; } @media (prefers-color-scheme: dark) { .a { width: 20px; } } @media (prefers-reduced-motion: reduce) { .a { height: 30px; } } @media (prefers-reduced-motion: reduce) and (prefers-color-scheme: light) and (min-width: 100px) { .a { width: 40px; } } @media not (prefers-color-scheme: dark), (max-width: 50px) { .e { width: 25px; } }")
  (fn frame (params (d (ref Dom))) int (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4072c00000000000)) (field y (float 0x4069000000000000)))))
    (let a _ (call (. d open) 0 (call (. d tag) "div") 1))
    (expr (call (. d cls) a "a"))
    (expr (call (. d close)))
    (let l _ (call (. d open) 1 (call (. d tag) "div") 1))
    (expr (call (. d cls) l "l"))
    (for i (.. 0 4) (block
      (let r _ (call (. d open) i (call (. d tag) "div") 1))
      (expr (call (. d cls) r "r"))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (if ON (block
      (let e _ (call (. d open) 2 (call (. d tag) "div") 1))
      (expr (call (. d cls) e "e"))
      (expr (call (. d trans) e 1 (float 0x4064000000000000) 1 (float 0x4064000000000000) 1 (float 0x0000000000000000) (float 0x0000000000000000) (float 0x3fe0000000000000) 0))
      (expr (call (. d close)))))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))
    (return a)))
  (fn run (params (d (ref Dom)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame d))))))
  (fn warns (params (src string)) int (block
    (let mem _ (call (. Arena create) (* 1024 1024)))
    (let c _ (call (. Css new) (& mem)))
    (expr (call parse (& c) src "w.css" 1))
    (return (. (. c warns) len))))
  (fn main (params) _ (block
    (expr (call ok (== (call warns "@media (prefers-reduced-motion: reduce) { .a { color: #ff0000; } } @media (prefers-reduced-motion: no-preference) { .a { color: #ff0000; } } @media (prefers-color-scheme: dark) { .a { color: #ff0000; } } @media (prefers-color-scheme: light) and (min-width: 300px), not (prefers-color-scheme: dark) { .a { color: #ff0000; } } @media screen and (prefers-reduced-motion: reduce) and (max-height: 400px) { .a { color: #ff0000; } }") 0) "valid prefers-* queries parse"))
    (expr (call ok (== (call warns "@media (prefers-color-scheme: blue) { .a { color: #ff0000; } }") 1) "bad color scheme value warns"))
    (expr (call ok (== (call warns "@media (prefers-reduced-motion: 3) { .a { color: #ff0000; } }") 1) "bad motion value warns"))
    (expr (call ok (== (call warns "@media (prefers-contrast: more) { .a { color: #ff0000; } }") 1) "other prefers-* warns"))
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "a.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses clean"))
    (let d _ (call (. Dom new) (& mem) (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (= ON (bool false))
    (expr (call run (& d) 3))
    (let a _ (call frame (& d)))
    (expr (call ok (&& (! (call (. d reducedMotion))) (! (call (. d darkScheme)))) "defaults: no-preference, light"))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) a) w) (float 0x4024000000000000)) (== (. (index (. (. d nodes) items) a) h) (float 0x4024000000000000))) "base style"))
    (let rest _ (. d restyled))
    (expr (call (. d setColorScheme) (bool true)))
    (= a (call frame (& d)))
    (expr (call ok (&& (> (. d restyled) rest) (== (. (index (. (. d nodes) items) a) w) (float 0x4034000000000000))) "dark restyles and applies"))
    (= rest (. d restyled))
    (expr (call run (& d) 5))
    (expr (call ok (== (. d restyled) rest) "steady after the toggle"))
    (expr (call (. d setColorScheme) (bool true)))
    (= a (call frame (& d)))
    (expr (call ok (== (. d restyled) rest) "same value restyles nothing"))
    (expr (call (. d setReducedMotion) (bool true)))
    (= a (call frame (& d)))
    (expr (call ok (&& (&& (> (. d restyled) rest) (== (. (index (. (. d nodes) items) a) h) (float 0x403e000000000000))) (== (. (index (. (. d nodes) items) a) w) (float 0x4034000000000000))) "reduced motion applies, dark kept"))
    (= rest (. d restyled))
    (expr (call run (& d) 5))
    (expr (call ok (== (. d restyled) rest) "steady again"))
    (expr (call (. d setColorScheme) (bool false)))
    (= a (call frame (& d)))
    (expr (call ok (== (. (index (. (. d nodes) items) a) w) (float 0x4044000000000000)) "reduce and light and min-width combine"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call (. d setColorScheme) (bool false)))
    (= a (call frame (& d)))
    (expr (call ok (&& (== (. (index (. (. d nodes) items) a) w) (float 0x4024000000000000)) (== (. (index (. (. d nodes) items) a) h) (float 0x4024000000000000))) "back to the base style"))
    (expr (call (. d setReducedMotion) (bool true)))
    (= ON (bool true))
    (expr (call run (& d) 1))
    (let e _ (. (index (. (. d nodes) items) 0) last))
    (expr (call ok (&& (== (call (. d trKind) e) 0) (== (call (. d trAmt) e) (float 0x3ff0000000000000))) "enter transition is instant"))
    (= ON (bool false))
    (expr (call run (& d) 1))
    (expr (call ok (&& (== (. d ghosts) 0) (== (. (. d trns) len) 0)) "no leave ghost"))
    (expr (call (. d setReducedMotion) (bool false)))
    (= ON (bool true))
    (expr (call run (& d) 1))
    (= ON (bool false))
    (expr (call run (& d) 1))
    (expr (call ok (== (. d ghosts) 1) "ghost without reduced motion"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call run (& d) 1))
    (expr (call ok (== (. d ghosts) 0) "turning reduced motion on finishes a leave in flight"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call run (& d) 2))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call (. d simInput) (float 0x4039000000000000) (float 0x403e000000000000) (bool false) (- (float 0x3ff0000000000000))))
    (expr (call frame (& d)))
    (let l _ (. (index (. (. d nodes) items) 0) last))
    (expr (call ok (== (. d coasting) 0) "no wheel inertia"))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call (. d simInput) (float 0x4039000000000000) (float 0x403e000000000000) (bool false) (- (float 0x3ff0000000000000))))
    (expr (call frame (& d)))
    (expr (call ok (> (. d coasting) 0) "inertia without reduced motion"))
    (expr (call run (& d) 40))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call (. d simInput) (float 0x4014000000000000) (float 0x4014000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (. (. d rip) n) 0) "no ripple"))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call (. d setReducedMotion) (bool false)))
    (expr (call run (& d) 30))
    (expr (call (. d simInput) (float 0x4014000000000000) (float 0x4014000000000000) (bool true) (float 0x0000000000000000)))
    (expr (call frame (& d)))
    (expr (call ok (== (. (. d rip) n) 1) "ripple without reduced motion"))
    (expr (call (. d setReducedMotion) (bool false)))
    (= ON (bool false))
    (expr (call run (& d) 20))
    (= ON (bool true))
    (expr (call run (& d) 4))
    (= e (. (index (. (. d nodes) items) 0) last))
    (expr (call ok (&& (== (call (. d trKind) e) 1) (< (call (. d trAmt) e) (float 0x3feccccccccccccd))) "enter in flight"))
    (expr (call (. d setReducedMotion) (bool true)))
    (expr (call ok (&& (== (call (. d trKind) e) 0) (== (call (. d trAmt) e) (float 0x3ff0000000000000))) "enter finished at once"))
    (expr (call run (& d) 2))
    (let laid _ (. d laid))
    (let used _ (. (. d mem) used))
    (expr (call run (& d) 10))
    (expr (call ok (&& (== (. d laid) laid) (== (. (. d mem) used) used)) "no layout or allocation after the toggle"))
    (expr (call (. d setReducedMotion) (bool false)))
    (= ON (bool false))
    (expr (call run (& d) 20))
    (= ON (bool true))
    (expr (call run (& d) 1))
    (= e (. (index (. (. d nodes) items) 0) last))
    (expr (call ok (== (call (. d trKind) e) 1) "enter plays again after reduced motion is off"))
    (= ON (bool false))
    (let mem2 _ (call (. Arena create) (* (* 8 1024) 1024)))
    (let c2 _ (call (. Css new) (& mem2)))
    (expr (call parse (& c2) SHEET "a.css" 1))
    (let base _ (call (. Dom new) (& mem2) (& c2)))
    (expr (call (. base setFrameMs) (float 0x4030000000000000)))
    (expr (call (. base simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& base)))
    (let c3 _ (call (. Css new) (& mem2)))
    (expr (call parse (& c3) SHEET "a.css" 1))
    (let d3 _ (call (. Dom new) (& mem2) (& c3)))
    (expr (call (. d3 setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d3 setColorScheme) (bool false)))
    (expr (call (. d3 setReducedMotion) (bool false)))
    (expr (call ok (== (. d3 restyled) 0) "a setter before the first render restyles nothing"))
    (expr (call (. d3 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call frame (& d3)))
    (expr (call ok (== (. d3 restyled) (. base restyled)) "first build costs the same with the setters called"))
    (let r3 _ (. d3 restyled))
    (let l3 _ (. d3 laid))
    (let u3 _ (. (. d3 mem) used))
    (for i (.. 0 20) (block
      (expr (call (. d3 setColorScheme) (bool false)))
      (expr (call (. d3 setReducedMotion) (bool false)))
      (expr (call (. d3 simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
      (expr (call frame (& d3)))))
    (expr (call ok (&& (&& (== (. d3 restyled) r3) (== (. d3 laid) l3)) (== (. (. d3 mem) used) u3)) "same value every frame is free"))
    (expr (call (. d3 setReducedMotion) (bool true)))
    (let d4 _ (call (. Dom new) (& mem2) (& c3)))
    (expr (call ok (&& (call (. d4 reducedMotion)) (. c3 prefsSet)) "the second Dom keeps the program's value"))
    (expr (call printLn "prefs_test ok")))))
--- stderr
--- exit 0
