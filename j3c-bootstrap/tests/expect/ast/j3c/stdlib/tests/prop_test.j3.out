(file (module prop_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css (names Css MatchNode P_BACKGROUND P_BG_IMAGE P_HEIGHT P_WIDTH V_CALC V_COLOR V_GRAD))
  (use j3.ui.csscalc.calcEval)
  (use j3.ui.cssmatch.computeStyle)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom.Dom)
  (use j3.ui.motion)
  (use j3.ui.motionbase.Motion)
  (const S_TEST int 1)
  (mod-let CHECKS int _)
  (fn micros (params) int (block
    (let ts (array 2 int) (array-lit 0 0))
    (expr (syscall 228 1 (& (index ts 0))))
    (return (+ (* (index ts 0) 1000000) (/ (index ts 1) 1000)))))
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn near (params (a f32) (b f32) (tol f32) (msg string)) _ (block
    (let d _ (- a b))
    (if (< d (float 0x0000000000000000)) (block
      (= d (- (float 0x0000000000000000) d))))
    (if (> d tol) (block
      (expr (call printLn (interp a " vs " b)))))
    (expr (call ok (<= d tol) msg))))
  (const SHEET string "@property --c { syntax: '<color>'; inherits: false; initial-value: #000000; }\n@property --w { syntax: '<length>'; inherits: true; initial-value: 0px; }\n@property --a { syntax: '<angle>'; inherits: true; initial-value: 0deg; }\n@property --n { syntax: '<number>'; inherits: true; initial-value: 0; }\n.c1 { --c: #000000; background: var(--c); transition: --c 100ms linear; }\n.c2 { --c: #ffffff; background: var(--c); transition: --c 100ms linear; }\n.w1 { --w: 0px; width: var(--w); height: calc(var(--w) * 2); transition: --w 100ms linear; }\n.w2 { --w: 100px; width: var(--w); height: calc(var(--w) * 2); transition: --w 100ms linear; }\n.all1 { --w: 0px; width: var(--w); transition: all 100ms linear; }\n.all2 { --w: 100px; width: var(--w); transition: all 100ms linear; }\n.g1 { --a: 0deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); transition: --a 100ms linear; }\n.g2 { --a: 180deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); transition: --a 100ms linear; }\n@keyframes spin { to { --a: 360deg; } }\n.k { --a: 0deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); animation: spin 1000ms linear infinite; }\n@keyframes grow { to { --w: 100px; } }\n.kw { --w: 0px; width: var(--w); animation: grow 100ms linear forwards; }\n.u1 { --z: 0px; width: var(--z); transition: --z 100ms linear; }\n.u2 { --z: 100px; width: var(--z); transition: --z 100ms linear; }\n@keyframes uz { to { --z: 100px; } }\n.uk { --z: 0px; width: var(--z); animation: uz 100ms linear forwards; }\n.pa { --w: 0px; animation: grow 100ms linear forwards; }\n.ch { width: var(--w); height: 10px; }\n.own { --w: 7px; width: var(--w); height: 10px; }\n.deep { height: 10px; }\n.gc { width: var(--w); height: 10px; }\n.none { animation: none; }\n.dr { --w: 0px; --b: var(--w); height: var(--b); animation: grow 100ms linear forwards; }\n.cb { width: var(--b, 7px); height: 10px; }\n.pb { --w: 0px; animation: grow 100ms linear; }\n.mp { width: 40px; height: 10px; }\n")
  (fn style (params (mem (ref Arena)) (css (ref Css)) (cls string)) int (block
    (let nodes _ (call (. mem alloc) (targs MatchNode) 1))
    (let cs _ (call (. mem alloc) (targs int) 1))
    (= (index cs 0) (call (. css intern) cls))
    (= (index nodes 0) (struct-lit MatchNode (field tag (call (. css intern) "div")) (field classes cs) (field parent (- 1)) (field prevSibling (- 1)) (field flags 0) (field type (- 1)) (field scope 0) (field scope2 0) (field id (- 1)) (field pe 0) (field next (- 1)) (field first (- 1))))
    (return (call computeStyle css nodes 0 (- 1)))))
  (fn gf (params (css (ref Css)) (st int) (p int)) f32 (block
    (return (. (call (. css get) st p) f))))
  (fn (doc "Angle of the first gradient layer of style `st`'s background-image.") gradAngle (params (css (ref Css)) (st int)) f32 (block
    (let v _ (call (. css get) st P_BG_IMAGE))
    (expr (call ok (== (. v kind) V_GRAD) "a gradient"))
    (return (index (. (. css paints) items) (+ (. v i) 2)))))
  (fn calcPx (params (css (ref Css)) (st int) (p int)) f32 (block
    (let v _ (call (. css get) st p))
    (if (!= (. v kind) V_CALC) (block
      (return (. v f))))
    (let px f32 (float 0x0000000000000000))
    (expr (call ok (call calcEval css v (float 0x0000000000000000) (& px)) "calc evaluates"))
    (return px)))
  (fn testTransitions (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" 0))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (let c1 _ (call style mem (& css) "c1"))
    (let c2 _ (call style mem (& css) "c2"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& css) c1 c2 (float 0x0000000000000000)))
    (let r _ (call (. motion step) (& m) (& css) c2 (float 0x4049000000000000) (float 0x0000000000000000)))
    (let v _ (call (. css get) (. m ov) P_BACKGROUND))
    (expr (call ok (&& (&& (== (. v kind) V_COLOR) (> (% (/ (. v c) 65536) 256) 120)) (< (% (/ (. v c) 65536) 256) 136)) "a registered color var is mid-blend"))
    (expr (call ok (== (% r 2) 1) "and the node is live"))
    (= r (call (. motion step) (& m) (& css) c2 (float 0x4069000000000000) (float 0x0000000000000000)))
    (expr (call ok (== (. (call (. css get) (. m ov) P_BACKGROUND) c) 4294967295) "the color var ends at its target"))
    (expr (call ok (== (% r 2) 0) "and the node is idle"))
    (expr (call (. motion step) (& m) (& css) c2 (float 0x406b000000000000) (float 0x0000000000000000)))
    (expr (call ok (&& (== (. m vn) 0) (== (. m vprev) 0)) "a frame later nothing is overridden"))
    (let w1 _ (call style mem (& css) "w1"))
    (let w2 _ (call style mem (& css) "w2"))
    (let mw _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mw) (& css) w1 w2 (float 0x0000000000000000)))
    (= r (call (. motion step) (& mw) (& css) w2 (float 0x4039000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. mw ov) P_WIDTH) (float 0x4039000000000000) (float 0x3f847ae147ae147b) "length var at a quarter"))
    (expr (call near (call calcPx (& css) (. mw ov) P_HEIGHT) (float 0x4049000000000000) (float 0x3f847ae147ae147b) "a calc() reader follows it"))
    (= r (call (. motion step) (& mw) (& css) w2 (float 0x407f400000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. mw ov) P_WIDTH) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "length var ends at 100"))
    (expr (call ok (== (% r 2) 0) "length transition finished"))
    (let a1 _ (call style mem (& css) "all1"))
    (let a2 _ (call style mem (& css) "all2"))
    (let ma _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& ma) (& css) a1 a2 (float 0x0000000000000000)))
    (expr (call (. motion step) (& ma) (& css) a2 (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. ma ov) P_WIDTH) (float 0x4049000000000000) (float 0x3f847ae147ae147b) "`all` transitions a registered var"))
    (let g1 _ (call style mem (& css) "g1"))
    (let g2 _ (call style mem (& css) "g2"))
    (expr (call near (call gradAngle (& css) g2) (float 0x4066800000000000) (float 0x3f847ae147ae147b) "the gradient reads the var"))
    (let mg _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mg) (& css) g1 g2 (float 0x0000000000000000)))
    (expr (call (. motion step) (& mg) (& css) g2 (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call gradAngle (& css) (. mg ov)) (float 0x4056800000000000) (float 0x3fe0000000000000) "angle var half way drives the gradient"))
    (let u1 _ (call style mem (& css) "u1"))
    (let u2 _ (call style mem (& css) "u2"))
    (let mu _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mu) (& css) u1 u2 (float 0x0000000000000000)))
    (expr (call ok (! (call (. motion active) (& mu))) "an unregistered var starts no transition"))
    (expr (call near (call gf (& css) u2 P_WIDTH) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "its readers jump at once"))))
  (fn testKeyframes (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" 0))
    (let k _ (call style mem (& css) "k"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& css) (- 1) k (float 0x0000000000000000)))
    (expr (call (. motion step) (& m) (& css) k (float 0x406f400000000000) (float 0x0000000000000000)))
    (expr (call near (call gradAngle (& css) (. m ov)) (float 0x4056800000000000) (float 0x3fe0000000000000) "keyframes drive a conic gradient's from angle"))
    (expr (call (. motion step) (& m) (& css) k (float 0x407f400000000000) (float 0x0000000000000000)))
    (expr (call near (call gradAngle (& css) (. m ov)) (float 0x4066800000000000) (float 0x3fe0000000000000) "half way round"))
    (let np _ (. (. css paints) len))
    (let nd _ (. (. css decls) len))
    (let nv _ (. (. css vsEnt) len))
    (let nvo _ (. (. css vso) len))
    (let nf _ (. (. css fbs) len))
    (let nw _ (. (. css warns) len))
    (let used _ (call (. mem checkpoint)))
    (for f (.. 0 40) (block
      (expr (call (. motion step) (& m) (& css) k (+ (float 0x4024000000000000) (* (call f32 f) (float 0x4030000000000000))) (float 0x0000000000000000)))))
    (expr (call ok (&& (&& (&& (&& (&& (== (. (. css paints) len) np) (== (. (. css decls) len) nd)) (== (. (. css vsEnt) len) nv)) (== (. (. css vso) len) nvo)) (== (. (. css fbs) len) nf)) (== (. (. css warns) len) nw)) "steady frames grow no list"))
    (expr (call ok (== (call (. mem checkpoint)) used) "steady frames allocate no memory"))
    (let kw _ (call style mem (& css) "kw"))
    (let mk _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mk) (& css) (- 1) kw (float 0x0000000000000000)))
    (expr (call (. motion step) (& mk) (& css) kw (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. mk ov) P_WIDTH) (float 0x4049000000000000) (float 0x3f847ae147ae147b) "a width driven by a keyframed var"))
    (let r _ (call (. motion step) (& mk) (& css) kw (float 0x4079000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. mk ov) P_WIDTH) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "holds the final value"))
    (expr (call ok (== (% r 2) 0) "and is no longer live"))
    (let uk _ (call style mem (& css) "uk"))
    (let mu _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& mu) (& css) (- 1) uk (float 0x0000000000000000)))
    (expr (call (. motion step) (& mu) (& css) uk (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. mu ov) P_WIDTH) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "keyframes on an unregistered var do not interpolate"))))
  (fn el (params (d (ref Dom)) (slot int) (cls string)) int (block
    (let id _ (call (. d open) slot (call (. d tag) "div") S_TEST))
    (expr (call (. d cls) id cls))
    (return id)))
  (fn (doc "`<div class=root><div class=\"ch\"/><div class=\"own\"/><div class=\"deep\"><div class=\"gc\"/></div></div>`; the ids are written to `ids`.") frame (params (d (ref Dom)) (root string) (ids (slice int))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (= (index ids 0) (call el d 0 "pa"))
    (expr (call (. d clsDyn) (index ids 0) root))
    (= (index ids 1) (call el d 0 "ch"))
    (expr (call (. d close)))
    (= (index ids 2) (call el d 1 "own"))
    (expr (call (. d close)))
    (= (index ids 3) (call el d 2 "deep"))
    (= (index ids 4) (call el d 0 "gc"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "Descendants that read an inherited animated var follow it; one that declares the var itself does not; nothing runs afterwards.") testDescendants (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let ids _ (call (. mem alloc) (targs int) 5))
    (expr (call frame (& d) "" ids))
    (expr (call ok (== (. d animating) 1) "the keyframes run on the parent"))
    (for k (.. 0 3) (block
      (expr (call frame (& d) "" ids))))
    (let w _ (. (index (. (. d nodes) items) (index ids 1)) w))
    (expr (call ok (&& (> w (float 0x4014000000000000)) (< w (float 0x4057c00000000000))) "a child reading the inherited var is mid-way"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 2)) w) (float 0x401c000000000000) (float 0x3f847ae147ae147b) "a child that declares the var itself is not animated"))
    (let wg _ (. (index (. (. d nodes) items) (index ids 4)) w))
    (expr (call ok (&& (> wg (float 0x4014000000000000)) (< wg (float 0x4057c00000000000))) "so is a grandchild under a non-reader"))
    (let used _ (call (. mem checkpoint)))
    (let np _ (. (. css paints) len))
    (let nv _ (. (. css vsEnt) len))
    (for k (.. 0 2) (block
      (expr (call frame (& d) "" ids))))
    (expr (call ok (&& (== (. (. css paints) len) np) (== (. (. css vsEnt) len) nv)) "descendant frames grow no list"))
    (expr (call ok (== (call (. mem checkpoint)) used) "and allocate no memory"))
    (for k (.. 0 12) (block
      (expr (call frame (& d) "" ids))))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "the child ends at the final value"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 4)) w) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "and the grandchild"))
    (expr (call ok (== (. d animating) 0) "the animation is over (held)"))
    (let r0 _ (. d restyled))
    (for k (.. 0 4) (block
      (expr (call frame (& d) "" ids))))
    (expr (call ok (== (. d restyled) r0) "idle frames restyle nothing"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "and the value stays"))
    (expr (call frame (& d) "none" ids))
    (expr (call frame (& d) "none" ids))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "dropping the animation puts the child back"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 4)) w) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "and the grandchild"))))
  (fn (doc "`<div class=\"pa root\"><div class=\"ch\"/><div class=\"cb\"/></div>`; mode 1 gives the `ch` child `style:width` and `style:height=\"var(--w)\"`.") frame2 (params (d (ref Dom)) (root string) (mode int) (ids (slice int))) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (= (index ids 0) (call el d 0 "pa"))
    (expr (call (. d clsDyn) (index ids 0) root))
    (= (index ids 1) (call el d 0 "ch"))
    (if (== mode 1) (block
      (expr (call (. d styleNum) (index ids 1) 0 "width" (float 0x4040800000000000)))
      (expr (call (. d styleStr) (index ids 1) 1 "height" "var(--w)"))))
    (expr (call (. d close)))
    (= (index ids 2) (call el d 1 "cb"))
    (expr (call (. d close)))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "`style:` overrides keep beating the rules while a var animates; a var() inside one follows it.") testInline (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let ids _ (call (. mem alloc) (targs int) 3))
    (for k (.. 0 4) (block
      (expr (call frame2 (& d) "" 1 ids))))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x4040800000000000) (float 0x3f847ae147ae147b) "style:width beats the rule that reads the var"))
    (for k (.. 0 12) (block
      (expr (call frame2 (& d) "" 1 ids))))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x4040800000000000) (float 0x3f847ae147ae147b) "and still does when the animation ends"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) h) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "an inline var() follows the animated var"))))
  (fn (doc "A property derived from an animated one (`--b: var(--w)`) follows it, on the node and in descendants.") testDerived (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" 0))
    (let dr _ (call style mem (& css) "dr"))
    (let m _ (call (. motion fresh)))
    (expr (call (. motion onStyle) (& m) (& css) (- 1) dr (float 0x0000000000000000)))
    (expr (call (. motion step) (& m) (& css) dr (float 0x4049000000000000) (float 0x0000000000000000)))
    (expr (call near (call gf (& css) (. m ov) P_HEIGHT) (float 0x4049000000000000) (float 0x3f847ae147ae147b) "a reader of a derived var follows the animated one"))
    (let css2 _ (call (. Css new) mem))
    (expr (call parse (& css2) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css2)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let ids _ (call (. mem alloc) (targs int) 3))
    (for k (.. 0 4) (block
      (expr (call frame2 (& d) "dr" 0 ids))))
    (let w _ (. (index (. (. d nodes) items) (index ids 2)) w))
    (expr (call ok (&& (> w (float 0x4020000000000000)) (< w (float 0x4057c00000000000))) "a descendant reading the derived var follows too"))
    (for k (.. 0 12) (block
      (expr (call frame2 (& d) "dr" 0 ids))))
    (expr (call near (. (index (. (. d nodes) items) (index ids 2)) w) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "and ends at the final value"))))
  (fn bigFrame (params (d (ref Dom)) (root string)) _ (block
    (expr (call (. d beginFrame) (struct-lit Vec2 (field x (float 0x4079000000000000)) (field y (float 0x4079000000000000)))))
    (let r _ (call el d 0 "pa"))
    (expr (call (. d clsDyn) r root))
    (for i (.. 0 1000) (block
      (let c _ (call (. d open) (+ i 1) (call (. d tag) "div") S_TEST))
      (expr (call (. d cls) c (if-expr (== (% i 333) 0) "ch" "mp")))
      (expr (call (. d close)))))
    (expr (call (. d close)))
    (expr (call (. d layout)))
    (expr (call (. d endFrame)))))
  (fn (doc "Only the readers of an animated var are rebuilt, in a big tree.") testBig (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (for f (.. 0 3) (block
      (expr (call bigFrame (& d) "none"))))
    (let t0 _ (call micros))
    (for f (.. 0 4) (block
      (expr (call bigFrame (& d) "none"))))
    (let still _ (/ (- (call micros) t0) 4))
    (expr (call ok (== (. d followed) 0) "no follower while nothing animates"))
    (expr (call bigFrame (& d) ""))
    (let before _ (. d followed))
    (= t0 (call micros))
    (for f (.. 0 4) (block
      (expr (call bigFrame (& d) ""))))
    (let moving _ (/ (- (call micros) t0) 4))
    (expr (call ok (== (- (. d followed) before) 16) "four readers of 1000 children are rebuilt each frame, not all"))
    (expr (call printLn (interp "1000 nodes, 4 readers: " still " us per frame still, " moving " us while a var animates")))))
  (fn (doc "An animation without fill lets everything go: followers and the node return to their computed styles and later restyles are ordinary.") testCleanup (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let ids _ (call (. mem alloc) (targs int) 3))
    (for k (.. 0 4) (block
      (expr (call frame2 (& d) "pb" 0 ids))))
    (expr (call ok (>= (. (index (. (. d nodes) items) (index ids 1)) tr) 0) "a follower while it runs"))
    (for k (.. 0 14) (block
      (expr (call frame2 (& d) "pb" 0 ids))))
    (let n1 _ (& (index (. (. d nodes) items) (index ids 1))))
    (expr (call ok (&& (< (. n1 tr) 0) (== (. n1 style) (. n1 tstyle))) "the follower is released and back on its computed style"))
    (let n0 _ (& (index (. (. d nodes) items) (index ids 0))))
    (expr (call ok (&& (! (call (. motion active) (& (index (. (. d trs) items) (. n0 tr))))) (== (. n0 style) (. n0 tstyle))) "so is the node"))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x0000000000000000) (float 0x3f847ae147ae147b) "reading the base value again"))
    (expr (call ok (== (. d animating) 0) "nothing counted as running"))
    (let r0 _ (. d restyled))
    (let f0 _ (. d followed))
    (for k (.. 0 5) (block
      (expr (call frame2 (& d) "pb" 0 ids))))
    (expr (call ok (&& (== (. d restyled) r0) (== (. d followed) f0)) "idle frames restyle and rebuild nothing"))
    (expr (call frame2 (& d) "mp" 0 ids))
    (expr (call ok (> (. d restyled) r0) "a class change restyles as usual"))
    (for k (.. 0 3) (block
      (expr (call frame2 (& d) "mp" 0 ids))))
    (expr (call ok (&& (== (. d animating) 0) (< (. (index (. (. d nodes) items) (index ids 1)) tr) 0)) "and starts nothing"))))
  (fn (doc "Hot reload: `Css.reset` and `parse` again register the properties anew and the animation runs.") testReload (params (mem (ref Arena))) _ (block
    (let css _ (call (. Css new) mem))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (let d _ (call (. Dom new) mem (& css)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (let ids _ (call (. mem alloc) (targs int) 5))
    (for k (.. 0 4) (block
      (expr (call frame (& d) "" ids))))
    (expr (call (. css reset)))
    (expr (call ok (== (. (. css regs) len) 0) "reset forgets the registrations"))
    (expr (call parse (& css) SHEET "prop.css" S_TEST))
    (expr (call ok (== (. (. css regs) len) 4) "parse registers them again"))
    (expr (call (. d restyle)))
    (expr (call frame (& d) "mp" ids))
    (expr (call ok (&& (< (. (index (. (. d nodes) items) (index ids 1)) tr) 0) (== (. d animating) 0)) "the reload let go of every follower"))
    (for k (.. 0 3) (block
      (expr (call frame (& d) "" ids))))
    (let w _ (. (index (. (. d nodes) items) (index ids 1)) w))
    (expr (call ok (&& (> w (float 0x4014000000000000)) (< w (float 0x4057c00000000000))) "the animation runs after a reload"))
    (for k (.. 0 14) (block
      (expr (call frame (& d) "" ids))))
    (expr (call near (. (index (. (. d nodes) items) (index ids 1)) w) (float 0x4059000000000000) (float 0x3f847ae147ae147b) "and ends"))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (expr (call testTransitions (& mem)))
    (expr (call testKeyframes (& mem)))
    (expr (call testDescendants (& mem)))
    (expr (call testInline (& mem)))
    (expr (call testDerived (& mem)))
    (expr (call testBig (& mem)))
    (expr (call testCleanup (& mem)))
    (expr (call testReload (& mem)))
    (expr (call printLn (interp "prop_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
