(file (module padnav_test)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.css.Css)
  (use j3.ui.cssparse.parse)
  (use j3.ui.dom)
  (use j3.ui.dom.Dom)
  (use j3.ui.dropdown)
  (use j3.ui.inputs)
  (use j3.ui.padin)
  (use j3.ui.padin.PadRaw)
  (use j3.ui.padnav)
  (use j3.ui.popup)
  (use j3.ui.testkit)
  (mod-let CHECKS int _)
  (fn ok (params (cond bool) (msg string)) _ (block
    (+= CHECKS 1)
    (if (! cond) (block
      (expr (call printLn (interp "FAIL: " msg)))
      (expr (call panic msg))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 64 1024) 1024)))
    (let css _ (call (. Css new) (& mem)))
    (expr (call parse (& css) SHEET "padnav.css" 1))
    (expr (call ok (== (. (. css warns) len) 0) "sheet parses without warnings"))
    (expr (call testGrid (& mem) (& css)))
    (expr (call testSkips (& mem) (& css)))
    (expr (call testGroups (& mem) (& css)))
    (expr (call testOverrides (& mem) (& css)))
    (expr (call testActivate (& mem) (& css)))
    (expr (call testModal (& mem) (& css)))
    (expr (call testScroll (& mem) (& css)))
    (expr (call testRepeat (& mem) (& css)))
    (expr (call testMisc (& mem) (& css)))
    (expr (call testArrows (& mem) (& css)))
    (expr (call testHotplug (& mem) (& css)))
    (expr (call testTextareaA (& mem) (& css)))
    (expr (call testMouseAfterPad (& mem) (& css)))
    (expr (call testIdleCost (& mem) (& css)))
    (expr (call testBig (& mem) (& css)))
    (expr (call testIdle (& mem) (& css)))
    (expr (call printLn (interp "padnav_test ok, checks passed: " CHECKS))))))
--- stderr
--- exit 0
