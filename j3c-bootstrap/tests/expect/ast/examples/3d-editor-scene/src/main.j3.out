(file (module g3d_editor_scene)
  (use j3.scene3d.scripts)
  (use j3.app.App)
  (use j3.game)
  (use j3.gfx)
  (use j3.gfx.Look)
  (use j3.math (names Vec3 asin atan2))
  (use j3.memory.Arena)
  (use j3.scene3d)
  (use j3.scene3d (names Scene CAMERA))
  (struct World
    (field scene Scene))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field scene (call (. scene3d load) (call (. scripts scene)) mem))))))
  (fn startup (params (w (ref World))) _ (block
    (expr (call (. gfx init)))
    (expr (call (. scene3d upload) (& (. w scene))))
    (expr (call (. scripts start) (& (. w scene))))))
  (fn update (params (w (ref World)) (dt f32)) _ (block
    (if (call (. game keyPressed) (. (. game Key) Escape)) (block
      (expr (call (. game requestQuit)))))
    (expr (call (. scripts update) (& (. w scene)) dt))))
  (fn camera (params (w (ref World))) Look (block
    (let i _ 0)
    (while (< i (. (. w scene) len)) (block
      (let n _ (index (. (. w scene) nodes) i))
      (if (== (. n kind) CAMERA) (block
        (let model _ (call (. scene3d world) (& (. w scene)) (. n id)))
        (let eye _ (call (. model transformPoint) (call (. Vec3 xyz) 0 0 0)))
        (let forward _ (call (. (- (call (. model transformPoint) (call (. Vec3 xyz) 0 0 (- 1))) eye) normalize)))
        (expr (call (. gfx setClip) (. n near) (. n far)))
        (return (call (. Look create) eye (call atan2 (. forward x) (- (. forward z))) (call asin (. forward y))))))
      (+= i 1)))
    (return (call (. Look create) (call (. Vec3 xyz) 0 3 8) 0 (- (float 0x3fc999999999999a))))))
  (fn draw (params (w (ref World))) _ (block
    (let env _ (call (. scene3d environment) (& (. w scene))))
    (expr (call (. scene3d shadows) (& (. w scene)) env))
    (expr (call (. scene3d lights) (& (. w scene))))
    (let fov f32 60)
    (let i _ 0)
    (while (< i (. (. w scene) len)) (block
      (if (== (. (index (. (. w scene) nodes) i) kind) CAMERA) (block
        (= fov (. (index (. (. w scene) nodes) i) fov))
        (break)))
      (+= i 1)))
    (expr (call (. gfx cameraPassLookFov) (call camera w) (. env sunDir) (. env sky) (. env sunColor) fov))
    (expr (call (. scene3d draw) (& (. w scene))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "g3d_editor_scene" 960 540 boot))
    (expr (call (. app useGl)))
    (expr (call (. app startup) startup))
    (expr (call (. app always) update))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
