(file (module j2_arena)
  (use j2_arena.api)
  (use j2_arena.arenatest)
  (use j2_arena.arenatest.Test)
  (use j2_arena.world (names World ARENA_H ARENA_W color))
  (use j3.j2)
  (use j3.app.App)
  (use j3.game (names Key env keyPressed requestQuit tryLoadFont))
  (use j3.gfx.paint)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (struct Game
    (field w World)
    (field test Test))
  (fn boot (params (mem (ref Arena))) Game (block
    (return (struct-lit Game (field w (call (. World new) mem (call same (call env "ARENA_TEST") "1"))) (field test (call (. arenatest new)))))))
  (fn start (params (g (ref Game))) _ (block
    (let w _ (& (. g w)))
    (= (. w font) (call tryLoadFont "assets/font.ttf" 15))
    (expr (call (. (. w scripts) attach)))
    (expr (call (. api bind) (& (. (. w scripts) vm)) w))
    (if (. w auto) (block
      (expr (call (. arenatest start) w))) (block
      (expr (call (. (. (. w scripts) vm) seed) (call (. sys monotonicMs))))))
    (expr (call (. w reloadScripts)))))
  (fn input (params (g (ref Game)) (_dt f32)) _ (block
    (let w _ (& (. g w)))
    (if (call keyPressed (. Key Escape)) (block
      (expr (call requestQuit))))
    (if (call keyPressed (. Key F5)) (block
      (expr (call (. w reloadScripts)))))
    (if (&& (<= (. w hp) 0) (call keyPressed (. Key R))) (block
      (expr (call (. w restart)))))))
  (fn update (params (g (ref Game)) (dt f32)) _ (block
    (let w _ (& (. g w)))
    (+= (. w tick) 1)
    (if (call (. (. w scripts) changed)) (block
      (expr (call (. w reloadScripts)))
      (if (. w auto) (block
        (expr (call (. arenatest reloaded) w (& (. g test))))))))
    (if (> (. w hp) 0) (block
      (expr (call (. w movePlayer) dt))
      (expr (call (. w fireWeapon) dt))
      (expr (call (. (. w scripts) callAll) "onTick" (array-lit (call (. j2 num) (call f64 dt)))))
      (expr (call (. w tickEnemies) dt))
      (if (. w auto) (block
        (expr (call (. arenatest ticked) w (& (. g test))))))
      (expr (call (. w moveBullets) dt))
      (expr (call (. w collide)))
      (expr (call (. w reapDead)))))
    (if (. w auto) (block
      (expr (call (. arenatest step) w (& (. g test))))))))
  (fn draw (params (g (ref Game))) _ (block
    (let w _ (& (. g w)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x (call f32 ARENA_W)) (field y (call f32 ARENA_H))) (call color 1184796)))
    (expr (call (. w drawEnemies)))
    (expr (call (. w drawBullets)))
    (expr (call (. w drawPlayer)))
    (expr (call (. (. w scripts) callAll) "onDraw" (call (. j2 noArgs))))
    (expr (call (. (. w scripts) drawLog) (. w font)))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App Game) create) "j2 arena" ARENA_W ARENA_H boot))
    (expr (call (. app useGl)))
    (expr (call (. app startup) start))
    (expr (call (. app always) input))
    (expr (call (. app add) update))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
