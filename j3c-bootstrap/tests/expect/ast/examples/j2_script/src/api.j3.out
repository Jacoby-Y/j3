(file (module j2_arena api)
  (use j2_arena.world (names World Bullet Enemy Weapon ARENA_H ARENA_W color))
  (use j3.j2)
  (use j3.j2 (names Args Value Vm))
  (use j3.math.Vec2)
  (use j3.gfx.paint)
  (use j3.text (names Text same))
  (fn pub bind (params (vm (ref Vm)) (w (ref World))) _ (block
    (expr (call (. vm openLibs) (| (| (| (. j2 LIB_BASE) (. j2 LIB_MATH)) (. j2 LIB_STRING)) (. j2 LIB_ARRAY))))
    (= (. vm host) (as w ptr))
    (expr (call (. vm bind) "print" print))
    (expr (call (. vm bind) "defineEnemy" defineEnemy))
    (expr (call (. vm bind) "defineWeapon" defineWeapon))
    (expr (call (. vm bind) "spawn" spawn))
    (expr (call (. vm bind) "shoot" shoot))
    (expr (call (. vm bind) "enemies" enemies))
    (expr (call (. vm bind) "player" player))
    (expr (call (. vm bind) "score" score))
    (expr (call (. vm bind) "arena" arena))
    (expr (call (. vm bind) "rgb" rgb))
    (expr (call (. vm bind) "drawText" drawText))
    (expr (call (. vm bind) "drawCircle" drawCircle))
    (expr (call (. vm bind) "drawRect" drawRect))))
  (fn world (params (vm (ref Vm))) (ref World) (block
    (return (as (. vm host) (ref World)))))
  (fn print (params (vm (ref Vm)) (args Args)) Value (block
    (expr (call (. (. (call world vm) scripts) say) (call (. args joined) " ")))
    (return (call (. j2 nil)))))
  (fn defineEnemy (params (vm (ref Vm)) (args Args)) Value (block
    (let kind _ (call (. args table) 1))
    (if (. vm raised) (block
      (return (call (. j2 nil)))))
    (expr (call (. kind setDefault) "hp" (call (. j2 int) 10)))
    (expr (call (. kind setDefault) "r" (call (. j2 int) 14)))
    (expr (call (. kind setDefault) "speed" (call (. j2 int) 60)))
    (expr (call (. kind setDefault) "touch" (call (. j2 int) 10)))
    (expr (call (. kind setDefault) "score" (call (. j2 int) 1)))
    (expr (call (. kind setDefault) "color" (call (. j2 int) 14438480)))
    (expr (call (. (call (. vm get) (. (call world vm) kinds)) set) (call (. args str) 0) (call (. kind value))))
    (return (call (. j2 nil)))))
  (fn defineWeapon (params (vm (ref Vm)) (args Args)) Value (block
    (let w _ (call world vm))
    (let name _ (call (. args str) 0))
    (let def _ (call (. args table) 1))
    (expr (call (. def setDefault) "cooldown" (call (. j2 num) (float 0x3fc999999999999a))))
    (if (call (. (call (. def get) "onFire") isNil)) (block
      (return (call (. vm raise) (call (. (call (. (call (. (call (. (call (. Text scratch)) add) "weapon \"") add) name) add) "\" has no onFire function") str))))))
    (for i (.. 0 (. w nWeapons)) (block
      (if (call same (. (index (. w weapons) i) name) name) (block
        (expr (call (. vm release) (. (index (. w weapons) i) def)))
        (= (. (index (. w weapons) i) def) (call (. vm keep) (call (. def value))))
        (return (call (. j2 nil)))))))
    (if (== (. w nWeapons) (. (. w weapons) len)) (block
      (return (call (. vm raise) (call (. (call (. (call (. (call (. (call (. Text scratch)) add) "too many weapons: keys 1-9 are taken, \"") add) name) add) "\" has none") str))))))
    (= (index (. w weapons) (. w nWeapons)) (struct-lit Weapon (field name (call (. vm intern) name)) (field def (call (. vm keep) (call (. def value))))))
    (+= (. w nWeapons) 1)
    (return (call (. j2 nil)))))
  (fn spawn (params (vm (ref Vm)) (args Args)) Value (block
    (let w _ (call world vm))
    (let name _ (call (. args str) 0))
    (let kind _ (call (. (call (. vm get) (. w kinds)) get) name))
    (if (call (. kind isNil)) (block
      (return (call (. vm raise) (call (. (call (. (call (. (call (. (call (. Text scratch)) add) "spawn: no enemy kind \"") add) name) add) "\" (defineEnemy it first)") str))))))
    (if (== (. w nEnemies) (. (. w enemies) len)) (block
      (return (call (. j2 nil)))))
    (let x _ (call (. args num) 1))
    (let y _ (call (. args num) 2))
    (let fields _ (if-expr (> (call (. args count)) 3) (call (. args table) 3) (call (. kind asTable))))
    (if (. vm raised) (block
      (return (call (. j2 nil)))))
    (let self _ (call (. vm newTable)))
    (expr (call (. self copyFields) (call (. kind asTable)) (array-lit "hp" "r" "speed" "touch" "score" "color")))
    (expr (call (. self set) "kind" (call (. j2 str) vm name)))
    (expr (call (. self set) "x" (call (. j2 num) x)))
    (expr (call (. self set) "y" (call (. j2 num) y)))
    (if (> (call (. args count)) 3) (block
      (expr (call (. self merge) fields))))
    (= (index (. w enemies) (. w nEnemies)) (struct-lit Enemy (field kind (call (. vm intern) name)) (field self (call (. vm keep) (call (. self value)))) (field alive (bool true))))
    (+= (. w nEnemies) 1)
    (expr (call (. (. w scripts) callMethod) kind "onSpawn" (call (. self value)) (call (. j2 noArgs))))
    (return (call (. self value)))))
  (fn shoot (params (vm (ref Vm)) (args Args)) Value (block
    (let w _ (call world vm))
    (if (< (. w nBullets) (. (. w bullets) len)) (block
      (= (index (. w bullets) (. w nBullets)) (struct-lit Bullet (field pos (struct-lit Vec2 (field x (call f32 (call (. args num) 0))) (field y (call f32 (call (. args num) 1))))) (field vel (struct-lit Vec2 (field x (call f32 (call (. args num) 2))) (field y (call f32 (call (. args num) 3))))) (field dmg (call f32 (call (. args numOr) 4 1))) (field life 2)))
      (+= (. w nBullets) 1)))
    (return (call (. j2 nil)))))
  (fn enemies (params (vm (ref Vm)) (_args Args)) Value (block
    (let w _ (call world vm))
    (let out _ (call (. vm newArray) (. w nEnemies)))
    (for i (.. 0 (. w nEnemies)) (block
      (if (. (index (. w enemies) i) alive) (block
        (expr (call (. out push) (call (. vm value) (. (index (. w enemies) i) self))))))))
    (return (call (. out value)))))
  (fn player (params (vm (ref Vm)) (_args Args)) Value (block
    (let w _ (call world vm))
    (let t _ (call (. vm newTable)))
    (expr (call (. t set) "x" (call (. j2 num) (call f64 (. (. w player) x)))))
    (expr (call (. t set) "y" (call (. j2 num) (call f64 (. (. w player) y)))))
    (expr (call (. t set) "hp" (call (. j2 num) (call f64 (. w hp)))))
    (if (> (. w nWeapons) 0) (block
      (expr (call (. t set) "weapon" (call (. j2 str) vm (. (index (. w weapons) (. w current)) name))))))
    (return (call (. t value)))))
  (fn score (params (vm (ref Vm)) (_args Args)) Value (block
    (return (call (. j2 int) (. (call world vm) score)))))
  (fn arena (params (vm (ref Vm)) (_args Args)) Value (block
    (let t _ (call (. vm newTable)))
    (expr (call (. t set) "w" (call (. j2 int) ARENA_W)))
    (expr (call (. t set) "h" (call (. j2 int) ARENA_H)))
    (return (call (. t value)))))
  (fn rgb (params (_vm (ref Vm)) (args Args)) Value (block
    (return (call (. j2 int) (| (| (<< (call byte (call (. args int) 0)) 16) (<< (call byte (call (. args int) 1)) 8)) (call byte (call (. args int) 2)))))))
  (fn byte (params (v int)) int (block
    (if (< v 0) (block
      (return 0)))
    (if (> v 255) (block
      (return 255)))
    (return v)))
  (fn drawText (params (vm (ref Vm)) (args Args)) Value (block
    (let c _ (call (. args intOr) 3 15132390))
    (expr (call (. paint text) (. (call world vm) font) (struct-lit Vec2 (field x (call f32 (call (. args num) 0))) (field y (call f32 (call (. args num) 1)))) (call (. args str) 2) (call color c)))
    (return (call (. j2 nil)))))
  (fn drawCircle (params (_vm (ref Vm)) (args Args)) Value (block
    (expr (call (. paint circle) (struct-lit Vec2 (field x (call f32 (call (. args num) 0))) (field y (call f32 (call (. args num) 1)))) (call f32 (call (. args num) 2)) (call color (call (. args int) 3))))
    (return (call (. j2 nil)))))
  (fn drawRect (params (_vm (ref Vm)) (args Args)) Value (block
    (expr (call (. paint rect) (struct-lit Vec2 (field x (call f32 (call (. args num) 0))) (field y (call f32 (call (. args num) 1)))) (struct-lit Vec2 (field x (call f32 (call (. args num) 2))) (field y (call f32 (call (. args num) 3)))) (call color (call (. args int) 4))))
    (return (call (. j2 nil))))))
--- stderr
--- exit 0
