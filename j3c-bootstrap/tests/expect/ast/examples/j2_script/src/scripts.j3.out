(file (module j2_arena scripts)
  (use j3.j2)
  (use j3.j2 (names Error Limits Ref Value Vm))
  (use j3.io (names DirEntry IoError listDir stat printLn))
  (use j3.game (names Color Font))
  (use j3.gfx.paint)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.text (names Text same))
  (const MAX_SCRIPTS int 64)
  (const MAX_ROOTS int 4)
  (const LOG_LINES int 8)
  (struct pub Script
    (field name string)
    (field path string)
    (field mtime int)
    (field loaded bool)
    (field exports Ref)
    (field err Text))
  (struct pub Scripts
    (field mem (ref Arena))
    (field roots (slice string))
    (field nRoots int)
    (field vm Vm)
    (field list (slice Script))
    (field n int)
    (field log (slice Text))
    (field logHead int)
    (field nLog int)
    (field loads int)
    (field errors int))
  (extend Scripts
    (fn new (params (mem (ref Arena)) (root string) (limits Limits)) Scripts (block
      (let s _ (struct-lit Scripts (field mem mem) (field roots (call (. mem alloc) (targs string) MAX_ROOTS)) (field nRoots 1) (field vm (call (. Vm new) mem limits)) (field list (call (. mem alloc) (targs Script) MAX_SCRIPTS)) (field n 0) (field log (call (. mem alloc) (targs Text) LOG_LINES)) (field logHead 0) (field nLog 0) (field loads 0) (field errors 0)))
      (= (index (. s roots) 0) root)
      (for i (.. 0 MAX_SCRIPTS) (block
        (= (. (index (. s list) i) err) (call (. Text new) mem))))
      (for i (.. 0 LOG_LINES) (block
        (= (index (. s log) i) (call (. Text new) mem))))
      (return s)))
    (fn attach (params (this (ref Scripts))) _ (block
      (= (. (. this vm) resolver) resolveUse)
      (= (. (. this vm) resolverCtx) (as this ptr))))
    (fn addRoot (params (this (ref Scripts)) (root string)) _ (block
      (if (< (. this nRoots) MAX_ROOTS) (block
        (= (index (. this roots) (. this nRoots)) root)
        (+= (. this nRoots) 1)))))
    (fn loadAll (params (this (ref Scripts))) _ (block
      (for i (.. 0 (. this n)) (block
        (expr (call (. (. this vm) release) (. (index (. this list) i) exports)))))
      (= (. this n) 0)
      (+= (. this loads) 1)
      (for r (.. 0 (. this nRoots)) (block
        (match (call listDir (index (. this roots) r) (. this mem))
          (arm (pats (variant Result.Ok (bind entries))) (block
            (for-each _ e entries (block
              (if (&& (. e isDir) (< (. this n) MAX_SCRIPTS)) (block
                (let m _ (& (index (. this list) (. this n))))
                (= (. m name) (. e name))
                (= (. m path) (call joinPath (. this mem) (index (. this roots) r) (. e name)))
                (= (. m mtime) (call mtimeOf (. m path)))
                (= (. m loaded) (bool false))
                (= (. m exports) (call (. j2 none)))
                (expr (call (. (. m err) clear)))
                (+= (. this n) 1)))))))
          (arm (pats (variant Result.Err (wild))) (block)))))
      (expr (call (. this sortByName)))
      (for i (.. 0 (. this n)) (block
        (expr (call (. this load) (& (index (. this list) i))))))
      (expr (call (. this callAll) "onStart" (call (. j2 noArgs))))))
    (fn sortByName (params (this (ref Scripts))) _ (block
      (for i (.. 1 (. this n)) (block
        (let j _ i)
        (while (&& (> j 0) (call less (. (index (. this list) j) name) (. (index (. this list) (- j 1)) name))) (block
          (let t _ (index (. this list) j))
          (= (index (. this list) j) (index (. this list) (- j 1)))
          (= (index (. this list) (- j 1)) t)
          (-= j 1)))))))
    (fn load (params (this (ref Scripts)) (m (ref Script))) _ (block
      (if (. m loaded) (block
        (return)))
      (= (. m loaded) (bool true))
      (match (call (. (. this vm) loadFile) (. m name) (. m path))
        (arm (pats (variant Result.Ok (bind t))) (block
          (= (. m exports) (call (. (. this vm) keep) t))))
        (arm (pats (variant Result.Err (bind e))) (block
          (expr (call (. this disable) m e)))))))
    (fn changed (params (this (ref Scripts))) bool (block
      (for i (.. 0 (. this n)) (block
        (if (!= (call mtimeOf (. (index (. this list) i) path)) (. (index (. this list) i) mtime)) (block
          (return (bool true))))))
      (return (bool false))))
    (fn find (params (this (ref Scripts)) (name string)) int (block
      (for i (.. 0 (. this n)) (block
        (if (call same (. (index (. this list) i) name) name) (block
          (return i)))))
      (return (- 1))))
    (fn callAll (params (this (ref Scripts)) (hook string) (args (slice Value))) _ (block
      (for i (.. 0 (. this n)) (block
        (let m _ (& (index (. this list) i)))
        (if (== (call (. (. m err) len)) 0) (block
          (let f _ (call (. (call (. (. this vm) get) (. m exports)) get) hook))
          (if (! (call (. f isNil))) (block
            (expr (call (. this check) (call (. (. this vm) call) f args)))))))))))
    (fn callMethod (params (this (ref Scripts)) (t Value) (name string) (self Value) (args (slice Value))) _ (block
      (let f _ (call (. (call (. t asTable)) get) name))
      (if (! (call (. f isNil))) (block
        (expr (call (. this check) (call (. (. this vm) callWithThis) f self args)))))))
    (fn check (params (this (ref Scripts)) (r (gen Result Value Error))) _ (block
      (match r
        (arm (pats (variant Result.Ok (wild))) (block))
        (arm (pats (variant Result.Err (bind e))) (block
          (let i _ (call (. this find) (. e chunk)))
          (if (>= i 0) (block
            (expr (call (. this disable) (& (index (. this list) i)) e))) (block
            (expr (call (. this sayError) "?" (. e message))))))))))
    (fn disable (params (this (ref Scripts)) (m (ref Script)) (e Error)) _ (block
      (expr (call (. (. m err) clear)))
      (expr (call (. (. m err) pushStr) (. e message)))
      (expr (call (. (. this vm) release) (. m exports)))
      (= (. m exports) (call (. j2 none)))
      (+= (. this errors) 1)
      (expr (call (. this sayError) (. m name) (call (. (. m err) str))))))
    (fn sayError (params (this (ref Scripts)) (name string) (msg string)) _ (block
      (let t _ (call (. this nextLine)))
      (expr (call (. t pushStr) "script "))
      (expr (call (. t pushStr) name))
      (expr (call (. t pushStr) " disabled: "))
      (expr (call (. t pushStr) msg))
      (expr (call printLn (call (. t str))))))
    (fn say (params (this (ref Scripts)) (line string)) _ (block
      (let t _ (call (. this nextLine)))
      (expr (call (. t pushStr) line))
      (expr (call printLn (call (. t str))))))
    (fn nextLine (params (this (ref Scripts))) (ref Text) (block
      (if (== (. this nLog) LOG_LINES) (block
        (= (. this logHead) (% (+ (. this logHead) 1) LOG_LINES))
        (-= (. this nLog) 1)))
      (let t _ (& (index (. this log) (% (+ (. this logHead) (. this nLog)) LOG_LINES))))
      (+= (. this nLog) 1)
      (expr (call (. t clear)))
      (return t)))
    (fn drawLog (params (this (ref Scripts)) (font Font)) _ (block
      (let y _ (- (call f32 690) (call f32 (* 18 (. this nLog)))))
      (for i (.. 0 (. this nLog)) (block
        (let line _ (call (. (index (. this log) (% (+ (. this logHead) i) LOG_LINES)) str)))
        (let isError _ (&& (>= (. line len) 7) (call same (slice-expr line 0 7) "script ")))
        (let c _ (if-expr isError (struct-lit Color (field r 255) (field g 110) (field b 110) (field a 255)) (struct-lit Color (field r 200) (field g 200) (field b 200) (field a 255))))
        (expr (call (. paint text) font (struct-lit Vec2 (field x 12) (field y y)) line c))
        (+= y 18))))))
  (fn resolveUse (params (ctx ptr) (vm (ref Vm)) (name string)) Value (block
    (let scripts _ (as ctx (ref Scripts)))
    (let i _ (call (. scripts find) name))
    (if (< i 0) (block
      (return (call (. vm raise) (call (. (call (. (call (. (call (. (call (. Text scratch)) add) "use ") add) name) add) ": no script folder with that name") str))))))
    (let m _ (& (index (. scripts list) i)))
    (expr (call (. scripts load) m))
    (if (!= (call (. (. m err) len)) 0) (block
      (return (call (. vm raise) (call (. (call (. (call (. (call (. (call (. Text scratch)) add) "use ") add) name) add) ": that script failed to load") str))))))
    (return (call (. vm value) (. m exports)))))
  (fn mtimeOf (params (path string)) int (block
    (match (call stat path)
      (arm (pats (variant Result.Ok (bind e))) (block
        (return (. e mtime))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (- 1)))))))
  (fn joinPath (params (mem (ref Arena)) (root string) (name string)) string (block
    (let t _ (call (. Text new) mem))
    (expr (call (. t pushStr) root))
    (expr (call (. t pushStr) "/"))
    (expr (call (. t pushStr) name))
    (expr (call (. t pushStr) "/main.j2"))
    (return (call (. t str)))))
  (fn less (params (a string) (b string)) bool (block
    (let n _ (if-expr (< (. a len) (. b len)) (. a len) (. b len)))
    (for i (.. 0 n) (block
      (if (!= (index a i) (index b i)) (block
        (return (< (index a i) (index b i)))))))
    (return (< (. a len) (. b len))))))
--- stderr
--- exit 0
