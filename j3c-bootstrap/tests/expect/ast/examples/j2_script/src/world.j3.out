(file (module j2_arena world)
  (use j2_arena.scripts (names Scripts))
  (use j3.j2)
  (use j3.j2 (names Limits Ref Value Vm))
  (use j3.game (names Color Font Key Mouse keyDown keyPressed mouseDown mousePos))
  (use j3.gfx.paint)
  (use j3.math)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (const pub ARENA_W int 1100)
  (const pub ARENA_H int 700)
  (const MAX_BULLETS int 1024)
  (const MAX_ENEMIES int 512)
  (const MAX_WEAPONS int 9)
  (struct pub Bullet
    (field pos Vec2)
    (field vel Vec2)
    (field dmg f32)
    (field life f32))
  (struct pub Enemy
    (field kind string)
    (field self Ref)
    (field alive bool))
  (struct pub Weapon
    (field name string)
    (field def Ref))
  (struct (doc "What the player does this tick: the real mouse and keys, or the test's fake ones.") pub Controls
    (field move Vec2)
    (field aim Vec2)
    (field fire bool))
  (struct pub World
    (field mem (ref Arena))
    (field scripts Scripts)
    (field font Font)
    (field auto bool)
    (field fake Controls)
    (field tick int)
    (field player Vec2)
    (field hp f32)
    (field score int)
    (field kills int)
    (field bullets (slice Bullet))
    (field nBullets int)
    (field enemies (slice Enemy))
    (field nEnemies int)
    (field kinds Ref)
    (field weapons (slice Weapon))
    (field nWeapons int)
    (field current int)
    (field reload f32))
  (fn (doc "A color packed as 0xRRGGBB (what the script `rgb()` returns), opaque.") pub color (params (rgb int)) Color (block
    (return (struct-lit Color (field r (call u8 (& (>> rgb 16) 255))) (field g (call u8 (& (>> rgb 8) 255))) (field b (call u8 (& rgb 255))) (field a 255)))))
  (extend World
    (fn new (params (mem (ref Arena)) (auto bool)) World (block
      (let scripts _ (call (. Scripts new) mem "j2-scripts" (struct-lit Limits (field heapBytes (<< 32 20)) (field stepsPerCall 500000))))
      (return (struct-lit World (field mem mem) (field scripts scripts) (field font (struct-lit Font (field raw 0))) (field auto auto) (field fake (struct-lit Controls (field move (struct-lit Vec2 (field x 0) (field y 0))) (field aim (struct-lit Vec2 (field x 0) (field y 0))) (field fire (bool false)))) (field tick 0) (field player (struct-lit Vec2 (field x 550) (field y 350))) (field hp 100) (field score 0) (field kills 0) (field bullets (call (. mem alloc) (targs Bullet) MAX_BULLETS)) (field nBullets 0) (field enemies (call (. mem alloc) (targs Enemy) MAX_ENEMIES)) (field nEnemies 0) (field kinds (call (. j2 none))) (field weapons (call (. mem alloc) (targs Weapon) MAX_WEAPONS)) (field nWeapons 0) (field current 0) (field reload 0)))))
    (fn reloadScripts (params (this (ref World))) _ (block
      (let vm _ (& (. (. this scripts) vm)))
      (expr (call (. vm release) (. this kinds)))
      (= (. this kinds) (call (. vm keep) (call (. (call (. vm newTable)) value))))
      (for i (.. 0 (. this nWeapons)) (block
        (expr (call (. vm release) (. (index (. this weapons) i) def)))))
      (= (. this nWeapons) 0)
      (expr (call (. (. this scripts) loadAll)))
      (if (>= (. this current) (. this nWeapons)) (block
        (= (. this current) 0)))))
    (fn restart (params (this (ref World))) _ (block
      (for i (.. 0 (. this nEnemies)) (block
        (expr (call (. (. (. this scripts) vm) release) (. (index (. this enemies) i) self)))))
      (= (. this nEnemies) 0)
      (= (. this nBullets) 0)
      (= (. this player) (struct-lit Vec2 (field x 550) (field y 350)))
      (= (. this hp) 100)
      (= (. this score) 0)
      (= (. this kills) 0)
      (expr (call (. this reloadScripts)))))
    (fn enemyHook (params (this (ref World)) (e (ref Enemy)) (hook string) (args (slice Value))) _ (block
      (let vm _ (& (. (. this scripts) vm)))
      (let kind _ (call (. (call (. vm get) (. this kinds)) get) (. e kind)))
      (if (! (call (. kind isNil))) (block
        (expr (call (. (. this scripts) callMethod) kind hook (call (. vm value) (. e self)) args))))))
    (fn controls (params (this (ref World))) Controls (block
      (if (. this auto) (block
        (return (. this fake))))
      (let c _ (struct-lit Controls (field move (struct-lit Vec2 (field x 0) (field y 0))) (field aim (call mousePos)) (field fire (call mouseDown (. Mouse Left)))))
      (if (call keyDown (. Key W)) (block
        (-= (. (. c move) y) 1)))
      (if (call keyDown (. Key S)) (block
        (+= (. (. c move) y) 1)))
      (if (call keyDown (. Key A)) (block
        (-= (. (. c move) x) 1)))
      (if (call keyDown (. Key D)) (block
        (+= (. (. c move) x) 1)))
      (for i (.. 0 (. this nWeapons)) (block
        (if (call keyPressed (call weaponKey i)) (block
          (= (. this current) i)))))
      (return c)))
    (fn movePlayer (params (this (ref World)) (dt f32)) _ (block
      (let c _ (call (. this controls)))
      (let speed _ (* (call f32 260) dt))
      (= (. (. this player) x) (call (. math clamp) (+ (. (. this player) x) (* (. (. c move) x) speed)) 12 (call f32 (- ARENA_W 12))))
      (= (. (. this player) y) (call (. math clamp) (+ (. (. this player) y) (* (. (. c move) y) speed)) 12 (call f32 (- ARENA_H 12))))))
    (fn fireWeapon (params (this (ref World)) (dt f32)) _ (block
      (-= (. this reload) dt)
      (let c _ (call (. this controls)))
      (if (|| (|| (! (. c fire)) (== (. this nWeapons) 0)) (> (. this reload) 0)) (block
        (return)))
      (let vm _ (& (. (. this scripts) vm)))
      (let w _ (& (index (. this weapons) (. this current))))
      (expr (call (. (. this scripts) callMethod) (call (. vm value) (. w def)) "onFire" (call (. vm value) (. w def)) (array-lit (call (. j2 num) (call f64 (. (. this player) x))) (call (. j2 num) (call f64 (. (. this player) y))) (call (. j2 num) (call f64 (. (. c aim) x))) (call (. j2 num) (call f64 (. (. c aim) y))))))
      (= (. this reload) (call (. vm getNum) (. w def) "cooldown"))))
    (fn tickEnemies (params (this (ref World)) (dt f32)) _ (block
      (let n _ (. this nEnemies))
      (for i (.. 0 n) (block
        (if (. (index (. this enemies) i) alive) (block
          (expr (call (. this enemyHook) (& (index (. this enemies) i)) "onTick" (array-lit (call (. j2 num) (call f64 dt)))))))))))
    (fn moveBullets (params (this (ref World)) (dt f32)) _ (block
      (for i (.. 0 (. this nBullets)) (block
        (let b _ (& (index (. this bullets) i)))
        (+= (. (. b pos) x) (* (. (. b vel) x) dt))
        (+= (. (. b pos) y) (* (. (. b vel) y) dt))
        (-= (. b life) dt)))))
    (fn collide (params (this (ref World))) _ (block
      (let vm _ (& (. (. this scripts) vm)))
      (let n _ (. this nEnemies))
      (for i (.. 0 n) (block
        (let e _ (& (index (. this enemies) i)))
        (if (! (. e alive)) (block
          (continue)))
        (let ex _ (call (. vm getNum) (. e self) "x"))
        (let ey _ (call (. vm getNum) (. e self) "y"))
        (let er _ (call (. vm getNum) (. e self) "r"))
        (for j (.. 0 (. this nBullets)) (block
          (let b _ (& (index (. this bullets) j)))
          (if (&& (> (. b life) 0) (< (call dist (. b pos) ex ey) er)) (block
            (= (. b life) 0)
            (expr (call (. vm setNum) (. e self) "hp" (- (call (. vm getNum) (. e self) "hp") (. b dmg))))
            (expr (call (. this enemyHook) e "onHit" (array-lit (call (. j2 num) (call f64 (. b dmg))))))))))
        (if (< (call dist (. this player) ex ey) (+ er 12)) (block
          (-= (. this hp) (/ (call (. vm getNum) (. e self) "touch") (call f32 60)))))))))
    (fn reapDead (params (this (ref World))) _ (block
      (let vm _ (& (. (. this scripts) vm)))
      (let n _ (. this nEnemies))
      (for i (.. 0 n) (block
        (let e _ (& (index (. this enemies) i)))
        (if (&& (. e alive) (<= (call (. vm getNum) (. e self) "hp") 0)) (block
          (= (. e alive) (bool false))
          (+= (. this score) (call int (call (. (call (. vm get) (. e self)) getNum) "score" (float 0x0000000000000000))))
          (+= (. this kills) 1)
          (expr (call (. this enemyHook) e "onDeath" (call (. j2 noArgs))))
          (expr (call (. (. this scripts) callAll) "onKill" (array-lit (call (. vm value) (. e self)))))
          (expr (call (. vm release) (. e self)))))))
      (let k _ 0)
      (for i (.. 0 (. this nEnemies)) (block
        (if (. (index (. this enemies) i) alive) (block
          (= (index (. this enemies) k) (index (. this enemies) i))
          (+= k 1)))))
      (= (. this nEnemies) k)
      (= k 0)
      (for i (.. 0 (. this nBullets)) (block
        (if (> (. (index (. this bullets) i) life) 0) (block
          (= (index (. this bullets) k) (index (. this bullets) i))
          (+= k 1)))))
      (= (. this nBullets) k)))
    (fn drawEnemies (params (this (ref World))) _ (block
      (let vm _ (& (. (. this scripts) vm)))
      (for i (.. 0 (. this nEnemies)) (block
        (let t _ (call (. vm get) (. (index (. this enemies) i) self)))
        (expr (call (. paint circle) (struct-lit Vec2 (field x (call f32 (call (. t getNum) "x" (float 0x0000000000000000)))) (field y (call f32 (call (. t getNum) "y" (float 0x0000000000000000))))) (call f32 (call (. t getNum) "r" (float 0x0000000000000000))) (call color (call int (call (. t getNum) "color" (float 0x0000000000000000))))))))))
    (fn drawBullets (params (this (ref World))) _ (block
      (for i (.. 0 (. this nBullets)) (block
        (expr (call (. paint circle) (. (index (. this bullets) i) pos) 3 (call color 16770680)))))))
    (fn drawPlayer (params (this (ref World))) _ (block
      (expr (call (. paint circle) (. this player) 12 (call color 7915775))))))
  (fn dist (params (a Vec2) (x f32) (y f32)) f32 (block
    (let dx _ (- (. a x) x))
    (let dy _ (- (. a y) y))
    (return (call (. math sqrt) (+ (* dx dx) (* dy dy))))))
  (fn weaponKey (params (i int)) Key (block
    (match i
      (arm (pats (lit 0)) (block
        (return (. Key Num1))))
      (arm (pats (lit 1)) (block
        (return (. Key Num2))))
      (arm (pats (lit 2)) (block
        (return (. Key Num3))))
      (arm (pats (lit 3)) (block
        (return (. Key Num4))))
      (arm (pats (lit 4)) (block
        (return (. Key Num5))))
      (arm (pats (lit 5)) (block
        (return (. Key Num6))))
      (arm (pats (lit 6)) (block
        (return (. Key Num7))))
      (arm (pats (lit 7)) (block
        (return (. Key Num8))))
      (arm (pats (wild)) (block
        (return (. Key Num9))))))))
--- stderr
--- exit 0
