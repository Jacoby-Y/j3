(file (module j2_arena arenatest)
  (use j2_arena.world (names World))
  (use j3.j2)
  (use j3.j2 (names Ref))
  (use j3.io (names makeDirs printLn stat writeFile))
  (use j3.math.Vec2)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.text (names contains cstr same))
  (use-lib "c" libc
    (lib-fn utimensat (params (dir i32) (path cstr) (times ptr) (flags i32)) i32 _)
    (lib-fn time (params (t ptr)) int _))
  (const SEED int 1234)
  (const TICKS int 1200)
  (const RELOAD_AFTER int 600)
  (const STRAFE int 90)
  (const TEMP_ROOT string "target/arena-test")
  (const BROKEN_PATH string "target/arena-test/broken/main.j2")
  (const BROKEN string "// written by ARENA_TEST: a typo, so this script must fail to load\nspwan(\"grunt\", 0, 0);\n")
  (const HELLO_PATH string "j2-scripts/hello/main.j2")
  (const AT_FDCWD i32 (- 100))
  (const UTIME_OMIT int 1073741822)
  (struct pub Test
    (field wave int)
    (field maxWave int)
    (field reloadTick int)
    (field loadsBefore int)
    (field enemiesAtReload int)
    (field enemiesAfterReload int)
    (field watched Ref)
    (field x0 f32)
    (field y0 f32)
    (field moved int)
    (field fails int))
  (fn pub new (params) Test (block
    (return (struct-lit Test (field wave 0) (field maxWave 0) (field reloadTick 0) (field loadsBefore 0) (field enemiesAtReload 0) (field enemiesAfterReload (- 1)) (field watched (call (. j2 none))) (field x0 0) (field y0 0) (field moved (- 1)) (field fails 0)))))
  (fn pub start (params (w (ref World))) _ (block
    (expr (call (. (. (. w scripts) vm) seed) SEED))
    (match (call makeDirs "target/arena-test/broken")
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call printLn "arena_test: cannot make target/arena-test/broken")))))
    (match (call writeFile BROKEN_PATH (as BROKEN (slice u8)))
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call printLn "arena_test: cannot write the broken script")))))
    (expr (call (. (. w scripts) addRoot) TEMP_ROOT))))
  (fn pub reloaded (params (w (ref World)) (t (ref Test))) _ (block
    (if (|| (== (. t reloadTick) 0) (>= (. t enemiesAfterReload) 0)) (block
      (return)))
    (= (. t enemiesAfterReload) (. w nEnemies))
    (if (> (. w nEnemies) 0) (block
      (= (. t watched) (. (index (. w enemies) 0) self))
      (= (. t x0) (call (. (. (. w scripts) vm) getNum) (. t watched) "x"))
      (= (. t y0) (call (. (. (. w scripts) vm) getNum) (. t watched) "y"))))))
  (fn pub ticked (params (w (ref World)) (t (ref Test))) _ (block
    (if (|| (>= (. t moved) 0) (<= (. t enemiesAfterReload) 0)) (block
      (return)))
    (let vm _ (& (. (. w scripts) vm)))
    (let moved _ (|| (!= (call (. vm getNum) (. t watched) "x") (. t x0)) (!= (call (. vm getNum) (. t watched) "y") (. t y0))))
    (= (. t moved) (if-expr moved 1 0))))
  (fn pub step (params (w (ref World)) (t (ref Test))) _ (block
    (let wave _ (call currentWave w))
    (if (!= wave (. t wave)) (block
      (expr (call printLn (interp "arena_test: tick " (. w tick) ": wave " wave ", " (. w nEnemies) " enemies, " (. w kills) " kills")))
      (= (. t wave) wave)))
    (if (> wave (. t maxWave)) (block
      (= (. t maxWave) wave)))
    (expr (call steer w))
    (if (&& (&& (== (. t reloadTick) 0) (>= (. w tick) RELOAD_AFTER)) (> (. w nEnemies) 0)) (block
      (= (. t reloadTick) (. w tick))
      (= (. t loadsBefore) (. (. w scripts) loads))
      (= (. t enemiesAtReload) (. w nEnemies))
      (expr (call touch HELLO_PATH))))
    (if (>= (. w tick) TICKS) (block
      (expr (call finish w t))))))
  (fn currentWave (params (w (ref World))) int (block
    (let s _ (& (. w scripts)))
    (let i _ (call (. s find) "base"))
    (if (|| (< i 0) (!= (call (. (. (index (. s list) i) err) len)) 0)) (block
      (return 0)))
    (match (call (. (. s vm) call) (call (. (call (. (. s vm) get) (. (index (. s list) i) exports)) get) "currentWave") (call (. j2 noArgs)))
      (arm (pats (variant Result.Ok (bind v))) (block
        (return (call int (call (. v asNum))))))
      (arm (pats (variant Result.Err (wild))) (block
        (return 0))))))
  (fn steer (params (w (ref World))) _ (block
    (let vm _ (& (. (. w scripts) vm)))
    (let dir _ (if-expr (== (% (/ (+ (. w tick) (/ STRAFE 2)) STRAFE) 2) 0) (call f32 1) (call f32 (- 1))))
    (= (. (. w fake) move) (struct-lit Vec2 (field x dir) (field y 0)))
    (= (. (. w fake) fire) (bool true))
    (let best _ (call f32 1000000000))
    (= (. (. w fake) aim) (struct-lit Vec2 (field x (+ (. (. w player) x) 100)) (field y (. (. w player) y))))
    (for i (.. 0 (. w nEnemies)) (block
      (let x _ (call (. vm getNum) (. (index (. w enemies) i) self) "x"))
      (let y _ (call (. vm getNum) (. (index (. w enemies) i) self) "y"))
      (let d _ (+ (* (- x (. (. w player) x)) (- x (. (. w player) x))) (* (- y (. (. w player) y)) (- y (. (. w player) y)))))
      (if (< d best) (block
        (= best d)
        (= (. (. w fake) aim) (struct-lit Vec2 (field x x) (field y y)))))))))
  (fn touch (params (path string)) _ (block
    (let old _ 0)
    (match (call stat path)
      (arm (pats (variant Result.Ok (bind e))) (block
        (= old (. e mtime))))
      (arm (pats (variant Result.Err (wild))) (block)))
    (let now _ (call (. libc time) (as 0 ptr)))
    (let m _ (if-expr (> now old) now (+ old 1)))
    (let ts _ (array-lit 0 UTIME_OMIT m 0))
    (if (!= (call (. libc utimensat) AT_FDCWD (call cstr path) (as (& (index ts 0)) ptr) 0) 0) (block
      (expr (call printLn "arena_test: cannot touch j2-scripts/hello/main.j2"))))))
  (fn finish (params (w (ref World)) (t (ref Test))) _ (block
    (let s _ (& (. w scripts)))
    (let b _ (call (. s find) "broken"))
    (let brokenErr _ (if-expr (>= b 0) (call (. (. (index (. s list) b) err) str)) ""))
    (let otherErrors _ (- (. s errors) (. s loads)))
    (expr (call printLn (interp "arena_test: wave=" (. t maxWave) " kills=" (. w kills) " score=" (. w score) " hp=" (. w hp) " loads=" (. s loads))))
    (expr (call printLn (interp "arena_test: reload at tick " (. t reloadTick) ": enemies " (. t enemiesAtReload) " -> " (. t enemiesAfterReload) ", moved=" (. t moved))))
    (expr (call printLn (interp "arena_test: script errors=" otherErrors "; the broken one says:")))
    (expr (call printLn brokenErr))
    (expr (call expect t (== otherErrors 0) "no script errors besides the broken one"))
    (expr (call expect t (>= (. t maxWave) 3) "reached wave 3"))
    (expr (call expect t (> (. w kills) 0) "killed something"))
    (expr (call expect t (&& (> (. t reloadTick) 0) (== (. s loads) (+ (. t loadsBefore) 1))) "touching hello reloaded the scripts once"))
    (expr (call expect t (&& (> (. t enemiesAtReload) 0) (== (. t enemiesAfterReload) (. t enemiesAtReload))) "the reload kept every enemy"))
    (expr (call expect t (== (. t moved) 1) "an enemy from before the reload moves under the new code"))
    (expr (call expect t (&& (call startsWith brokenErr BROKEN_PATH) (call contains brokenErr "unknown name")) "the broken script shows its error"))
    (expr (call printLn (if-expr (== (. t fails) 0) "arena_test PASS" "arena_test FAIL")))
    (expr (call (. sys exit) (if-expr (== (. t fails) 0) 0 1)))))
  (fn expect (params (t (ref Test)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "  ok    " what)))) (block
      (expr (call printLn (interp "  FAIL  " what)))
      (+= (. t fails) 1)))))
  (fn startsWith (params (s string) (p string)) bool (block
    (return (&& (>= (. s len) (. p len)) (call same (slice-expr s 0 (. p len)) p))))))
--- stderr
--- exit 0
