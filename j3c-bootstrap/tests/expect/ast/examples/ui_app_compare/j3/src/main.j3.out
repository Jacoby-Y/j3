(file (module todo)
  (use todo.state (names State StressRun))
  (use todo.ui (names Screen ScreenProps Stress StressProps))
  (use j3.app.App)
  (use j3.game (names env setVsync windowSize))
  (use j3.io.printLn)
  (use j3.sys.monotonicMs)
  (use j3.memory.Arena)
  (struct World
    (field state State)
    (field root Screen)
    (field stress bool)
    (field s StressRun)
    (field sroot Stress))
  (fn boot (params (mem (ref Arena))) World (block
    (let stress _ (> (. (call env "STRESS") len) 0))
    (if stress (block
      (expr (call setVsync (bool false)))))
    (return (struct-lit World (field state (call (. State new) mem)) (field root (call (. Screen new) mem)) (field stress stress) (field s (struct-lit StressRun (field t0 (call monotonicMs)))) (field sroot (call (. Stress new) mem))))))
  (fn draw (params (w (ref World))) _ (block
    (if (. w stress) (block
      (expr (call (. (. w sroot) render) (call windowSize) (struct-lit StressProps (field s (& (. w s))))))
      (return)))
    (expr (call (. (. w state) flush)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))))
  (fn (doc "Runs every frame (`app.always`), which also tells `App` the UI is animating, so it never idles.") stressFrame (params (w (ref World)) (_dt f32)) _ (block
    (if (! (. w stress)) (block
      (return)))
    (let s _ (& (. w s)))
    (+= (. s frame) 1)
    (let t _ (- (call monotonicMs) (. s t0)))
    (if (&& (== (. s phase) 0) (>= t 2000)) (block
      (= (. s phase) 1)
      (= (. s marked) (. s frame))
      (expr (call printLn "mark"))) (block
      (if (&& (== (. s phase) 1) (>= t 10000)) (block
        (= (. s phase) 2)
        (expr (call printLn (interp "done frames=" (- (. s frame) (. s marked)))))))))))
  (fn main (params) _ (block
    (let w _ 480)
    (let h _ 520)
    (if (> (. (call env "STRESS") len) 0) (block
      (= w 1280)
      (= h 800)))
    (let app _ (call (. (type-path App World) create) "Todos" w h boot))
    (expr (call (. app useGl)))
    (expr (call (. app hiDpi)))
    (expr (call (. app always) stressFrame))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
