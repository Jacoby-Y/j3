(file (module todo state)
  (use j3.memory (names Arena List))
  (use j3.text.Text)
  (struct pub Item
    (field id int)
    (field text string)
    (field done bool))
  (struct pub State
    (field mem (ref Arena))
    (field items (gen List Item))
    (field draft string "")
    (field nextId int 1)
    (field removeId int 0)
    (fn new (params (mem (ref Arena))) State (block
      (let s _ (struct-lit State (field mem mem) (field items (call (. (type-path List Item) new) mem))))
      (expr (call (. s push) "Write the app"))
      (expr (call (. s push) "Measure the build"))
      (return s)))
    (fn push (params (this (ref State)) (s string)) _ (block
      (let t _ (call (. Text new) (. this mem)))
      (expr (call (. t pushStr) s))
      (expr (call (. (. this items) push) (struct-lit Item (field id (. this nextId)) (field text (call (. t str))) (field done (bool false)))))
      (+= (. this nextId) 1)))
    (fn add (params (this (ref State))) _ (block
      (if (> (. (. this draft) len) 0) (block
        (expr (call (. this push) (. this draft)))
        (= (. this draft) "")))))
    (fn (doc "Rows only queue a removal; it is applied here, outside the list loop.") flush (params (this (ref State))) _ (block
      (for i (.. 0 (. (. this items) len)) (block
        (if (== (. (index (. (. this items) items) i) id) (. this removeId)) (block
          (expr (call (. (. this items) remove) i))
          (break)))))
      (= (. this removeId) 0)))
    (fn left (params (this (ref State))) int (block
      (let n _ 0)
      (for i (.. 0 (. (. this items) len)) (block
        (if (! (. (index (. (. this items) items) i) done)) (block
          (+= n 1)))))
      (return n))))
  (const (doc "Cards in the stress scene (the same in every stack).") pub N int 1200)
  (struct (doc "Stress run: warm up for 2 s, then count frames for 8 s, printing `mark` and `done` lines for ../stress.py.") pub StressRun
    (field frame int 0)
    (field t0 int 0)
    (field marked int 0)
    (field phase int 0)))
--- stderr
--- exit 0
