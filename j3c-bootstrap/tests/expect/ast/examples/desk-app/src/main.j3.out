(file (module desk_app)
  (use desk_app.prefs)
  (use desk_app.selftest)
  (use desk_app.selftest.Test)
  (use desk_app.state (names BY_SIZE PAGE_SETTINGS State))
  (use desk_app.ui (names Shell ShellProps))
  (use j3.app.App)
  (use j3.game (names env requestQuit windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.text.same)
  (use j3.ui.domhtml (names dumpA11y dumpHtml))
  (const (doc "The preferences are written when they have not changed for this many frames.") SETTLE _ 20)
  (struct World
    (field state State)
    (field root Shell)
    (field mem (ref Arena))
    (field path string)
    (field golden bool)
    (field frame int)
    (field sig int)
    (field saved int)
    (field quiet int)
    (field tester bool)
    (field test Test)
    (field snapshotAt int))
  (fn toInt (params (s string)) int (block
    (let n _ 0)
    (for i (.. 0 (. s len)) (block
      (= n (- (+ (* n 10) (call int (index s i))) 48))))
    (return n)))
  (fn (doc "A fixed state for a golden capture.") golden (params (s (ref State)) (name string)) _ (block
    (= (. s sortKey) BY_SIZE)
    (= (. s sortAsc) (bool false))
    (= (. s sel) 3)
    (if (call same name "filter") (block
      (= (. s sortKey) 0)
      (= (. s sortAsc) (bool true))
      (= (. s filter) "o")
      (= (. s sel) (- 1))) (block
      (if (call same name "rename") (block
        (= (. s sortKey) 0)
        (= (. s sortAsc) (bool true))
        (= (. s sel) 4)
        (expr (call (. s openRename)))) (block
        (if (call same name "settings") (block
          (= (. s page) PAGE_SETTINGS)
          (= (. s density) 1)
          (= (. s showHidden) (bool true))) (block
          (if (call same name "toast") (block
            (expr (call (. s toast) "Renamed to notes.png" 1))))))))))))
  (fn boot (params (mem (ref Arena))) World (block
    (let w _ (struct-lit World (field state (call (. State new) mem)) (field root (call (. Shell new) mem)) (field mem mem) (field path "desk-app.save") (field golden (bool false)) (field frame 0) (field sig 0) (field saved 0) (field quiet 0) (field tester (call same (call env "DESK_TEST") "1")) (field test (struct-lit Test)) (field snapshotAt (call toInt (call env "DESK_SNAPSHOT")))))
    (let pf _ (call env "DESK_PREFS"))
    (if (> (. pf len) 0) (block
      (= (. w path) pf)))
    (let g _ (call env "DESK_GOLDEN"))
    (= (. w golden) (> (. g len) 0))
    (if (. w golden) (block
      (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4030000000000000)))
      (expr (call golden (& (. w state)) g))) (block
      (expr (call (. prefs load) (& (. w state)) (. w path) mem))))
    (= (. w sig) (call (. prefs signature) (& (. w state))))
    (= (. w saved) (. w sig))
    (return w)))
  (fn (doc "Save a moment after the last change, not on every step of a slider drag.") persist (params (w (ref World))) _ (block
    (let sig _ (call (. prefs signature) (& (. w state))))
    (if (!= sig (. w sig)) (block
      (= (. w sig) sig)
      (= (. w quiet) 0)) (block
      (if (< (. w quiet) SETTLE) (block
        (+= (. w quiet) 1)
        (expr (call (. (. (. w root) dom) requestFrame)))
        (if (&& (&& (&& (== (. w quiet) SETTLE) (!= sig (. w saved))) (! (. w golden))) (! (. w tester))) (block
          (expr (call (. prefs store) (& (. w state)) (. w path)))
          (= (. w saved) sig)))))))))
  (fn draw (params (w (ref World))) _ (block
    (= (. (. w state) now) (call (. (. (. w root) dom) timeMs)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ShellProps (field state (& (. w state))))))
    (+= (. w frame) 1)
    (expr (call persist w))
    (let d _ (& (. (. w root) dom)))
    (if (== (. w snapshotAt) (. w frame)) (block
      (if (call dumpHtml d "target/ui-snapshot.html") (block
        (expr (call printLn "wrote target/ui-snapshot.html"))))
      (if (call dumpA11y d "target/ui-a11y.txt") (block
        (expr (call printLn "wrote target/ui-a11y.txt"))))))
    (if (. w tester) (block
      (expr (call (. selftest step) (& (. w test)) d (& (. w state)) (. w frame)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "desk app" 1100 680 boot))
    (expr (call (. app useGl)))
    (expr (call (. app hiDpi)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
