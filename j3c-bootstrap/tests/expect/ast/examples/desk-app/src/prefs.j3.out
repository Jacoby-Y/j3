(file (module desk_app prefs)
  (use desk_app.state (names NAME_MAX State))
  (use j3.data.save)
  (use j3.memory.Arena)
  (const pub MIN_SIDE f32 (float 0x4064000000000000))
  (const pub MAX_SIDE f32 (float 0x4074000000000000))
  (fn clampInt (params (v int) (lo int) (hi int) (fallback int)) int (block
    (return (if-expr (|| (< v lo) (> v hi)) fallback v))))
  (fn (doc "Read `path` into `s`. `mem` must outlive `s` (the owner name stays a view of the file bytes).") pub load (params (s (ref State)) (path string) (mem (ref Arena))) _ (block
    (let sv _ (call (. save load) path mem))
    (= (. s density) (call clampInt (call (. save getInt) (& sv) "density" 0) 0 1 0))
    (= (. s units) (call clampInt (call (. save getInt) (& sv) "units" 0) 0 1 0))
    (= (. s showHidden) (== (call (. save getInt) (& sv) "hidden" 0) 1))
    (= (. s sortKey) (call clampInt (call (. save getInt) (& sv) "sortKey" 0) 0 2 0))
    (= (. s sortAsc) (!= (call (. save getInt) (& sv) "sortAsc" 1) 0))
    (let w _ (call (. save getFloat) (& sv) "sideW" (float 0x406b800000000000)))
    (= (. s sideW) (if-expr (|| (! (>= w MIN_SIDE)) (! (<= w MAX_SIDE))) (float 0x406b800000000000) w))
    (let o _ (call (. save getStr) (& sv) "owner" "You"))
    (= (. s owner) (if-expr (|| (== (. o len) 0) (> (. o len) NAME_MAX)) "You" o))))
  (fn (doc "A number that changes whenever a saved value does.") pub signature (params (s (ref State))) int (block
    (let h _ (+ (+ (+ (+ (* (. s density) 3) (* (. s units) 5)) (if-expr (. s showHidden) 7 0)) (* (. s sortKey) 11)) (if-expr (. s sortAsc) 13 0)))
    (= h (+ (* h 31) (call int (* (. s sideW) (float 0x4010000000000000)))))
    (for i (.. 0 (. (. s owner) len)) (block
      (= h (% (+ (* h 31) (call int (index (. s owner) i))) 1000000007))))
    (return h)))
  (fn (doc "Write the preferences to `path` (write errors are ignored, like `save.store`).") pub store (params (s (ref State)) (path string)) _ (block
    (let arena _ (call (. Arena create) 4096))
    (let mem _ (& arena))
    (let sv _ (call (. save empty) mem))
    (expr (call (. save putInt) (& sv) "density" (. s density)))
    (expr (call (. save putInt) (& sv) "units" (. s units)))
    (expr (call (. save putInt) (& sv) "hidden" (if-expr (. s showHidden) 1 0)))
    (expr (call (. save putInt) (& sv) "sortKey" (. s sortKey)))
    (expr (call (. save putInt) (& sv) "sortAsc" (if-expr (. s sortAsc) 1 0)))
    (expr (call (. save putFloat) (& sv) "sideW" (. s sideW)))
    (expr (call (. save putStr) (& sv) "owner" (. s owner)))
    (expr (call (. save store) (& sv) path))
    (expr (call (. arena destroy))))))
--- stderr
--- exit 0
