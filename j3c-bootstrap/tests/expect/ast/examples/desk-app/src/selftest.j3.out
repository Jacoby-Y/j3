(file (module desk_app selftest)
  (use desk_app.prefs)
  (use desk_app.state.State)
  (use j3.io)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys)
  (use j3.text (names contains same))
  (use j3.ui.a11y)
  (use j3.ui.dom (names Dom K_ELEM))
  (use j3.ui.testkit)
  (struct pub Test
    (field fails int 0)
    (field (doc "The file whose name the rename steps use.") pick int 0)
    (field (doc "The keyboard walk: how many controls offer focus, and the first one Tab reached.") want int 0)
    (field first int (- 1)))
  (fn check (params (t (ref Test)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. t fails) 1)))))
  (fn (doc "Every neighbour pair is in order and ties keep id order (a stable sort), whichever way it runs.") ordered (params (s (ref State))) bool (block
    (let o _ (call (. s view)))
    (for i (.. 1 (. o len)) (block
      (if (call (. s before) (index o i) (index o (- i 1))) (block
        (return (bool false))))
      (if (&& (! (call (. s before) (index o (- i 1)) (index o i))) (> (index o (- i 1)) (index o i))) (block
        (return (bool false))))))
    (return (bool true))))
  (fn (doc "Keyboard only, from frame 62: Tab goes round exactly the controls that offer focus (each press lands on\none, the cycle is as long as there are controls, so none is skipped or trapped), then Enter on a focused\nrow selects it.") keyboardWalk (params (t (ref Test)) (d (ref Dom)) (s (ref State)) (f int)) _ (block
    (if (== f 62) (block
      (for i (.. 0 (. (. d nodes) len)) (block
        (if (&& (== (. (index (. (. d nodes) items) i) kind) K_ELEM) (== (% (call (. a11y actions) d i) 2) 1)) (block
          (+= (. t want) 1)))))))
    (if (&& (>= f 62) (<= f (+ 62 (. t want)))) (block
      (expr (call (. d simKeys) "" "Tab"))))
    (let k _ (- f 62))
    (if (&& (>= k 1) (<= k (+ (. t want) 1))) (block
      (let at _ (call (. d focused)))
      (if (== k 1) (block
        (= (. t first) at)))
      (if (&& (&& (> k 1) (<= k (. t want))) (== at (. t first))) (block
        (expr (call check t (bool false) "Tab cycle is shorter than the controls: one is skipped or trapped"))))
      (if (== (call (. a11y actions) d at) 0) (block
        (expr (call check t (bool false) "Tab landed on a node that is not operable"))))
      (if (== k (+ (. t want) 1)) (block
        (expr (call check t (&& (== at (. t first)) (> (. t want) 10)) "Tab wraps after reaching every control"))))))
    (if (== f (+ 70 (. t want))) (block
      (= (. s sel) (- 1))
      (for i (.. 0 (. (. d nodes) len)) (block
        (if (&& (== (. (index (. (. d nodes) items) i) kind) K_ELEM) (call same (call (. a11y role) d i) "option")) (block
          (expr (call (. d focusNode) i))
          (break)))))
      (expr (call (. d simKeys) "" "Enter"))))
    (if (== f (+ 73 (. t want))) (block
      (expr (call check t (>= (. s sel) 0) "Enter on a focused row selects it"))))
    (if (== f (+ 74 (. t want))) (block
      (expr (call (. s openRename)))))
    (expr (call (. testkit clickTextIn) d f (+ 82 (. t want)) "dialog" "Rename"))
    (if (== f (+ 85 (. t want))) (block
      (expr (call check t (! (. s renaming)) "the Rename button applies the (unchanged, valid) name and closes the modal"))))))
  (fn (doc "Frame `f` (1-based). Exits the program after the last step.") pub step (params (t (ref Test)) (d (ref Dom)) (s (ref State)) (f int)) _ (block
    (expr (call (. testkit clickText) d f 3 "Size"))
    (if (== f 7) (block
      (expr (call check t (&& (&& (== (. s sortKey) 1) (. s sortAsc)) (call ordered s)) "Size header sorts ascending, ties keep id order"))))
    (expr (call (. testkit clickText) d f 8 "Size"))
    (if (== f 12) (block
      (expr (call check t (&& (&& (== (. s sortKey) 1) (! (. s sortAsc))) (call ordered s)) "second click sorts descending, ties still keep id order"))))
    (expr (call (. testkit clickText) d f 13 "Modified"))
    (if (== f 17) (block
      (expr (call check t (&& (&& (== (. s sortKey) 2) (. s sortAsc)) (call ordered s)) "another header starts ascending"))))
    (expr (call (. testkit typeInto) d f 18 "input" 0 "ro"))
    (if (== f 24) (block
      (let all _ (bool true))
      (let o _ (call (. s view)))
      (for i (.. 0 (. o len)) (block
        (if (&& (! (call contains (. (index (. s files) (index o i)) name) "ro")) (! (call contains (. (index (. s files) (index o i)) name) "RO"))) (block
          (= all (bool false))))))
      (expr (call check t (&& (&& (&& (call same (. s filter) "ro") (> (. o len) 0)) (< (. o len) 29)) all) "typing filters the rows"))
      (= (. t pick) (index o 0))))
    (expr (call (. testkit clickText) d f 25 (. (index (. s files) (. t pick)) name)))
    (if (== f 29) (block
      (expr (call check t (== (. s sel) (. t pick)) "clicking a row selects its file"))))
    (expr (call (. testkit clickTag) d f 30 "input" 0))
    (expr (call (. testkit simKeys) d f 33 "" "End"))
    (expr (call (. testkit simKeys) d f 34 "" "Backspace"))
    (if (== f 36) (block
      (expr (call check t (&& (&& (== (. s sel) (. t pick)) (call same (. s filter) "r")) (> (. (call (. s view)) len) 0)) "selection survives a filter change"))))
    (expr (call (. testkit clickText) d f 38 "Rename"))
    (if (== f 42) (block
      (expr (call check t (&& (. s renaming) (call same (. s draft) (. (index (. s files) (. t pick)) name))) "Rename opens the modal with the current name"))
      (expr (call (. d simKeys) "" "C+a"))))
    (expr (call (. testkit simKeys) d f 43 (. (index (. s files) (% (+ (. t pick) 1) (. s n))) name) ""))
    (if (== f 45) (block
      (expr (call check t (> (. (call (. s problem)) len) 0) "a name another file has is refused"))
      (expr (call (. d simKeys) "" "Enter"))))
    (if (== f 48) (block
      (expr (call check t (&& (&& (. s renaming) (> (. (. (index (. s files) (. t pick)) name) len) 0)) (! (call same (. (index (. s files) (. t pick)) name) (. s draft)))) "Enter with a bad name keeps the modal open and the file unchanged"))
      (expr (call (. d simKeys) "" "C+a"))))
    (expr (call (. testkit simKeys) d f 49 "zebra.txt" ""))
    (expr (call (. testkit simKeys) d f 51 "" "Enter"))
    (if (== f 54) (block
      (expr (call check t (&& (&& (! (. s renaming)) (call same (. (index (. s files) (. t pick)) name) "zebra.txt")) (call (. (. s toasts) live) 0)) "Enter renames, closes the modal and shows a toast"))))
    (if (== f 55) (block
      (expr (call (. s openRename)))))
    (expr (call (. testkit simKeys) d f 58 "" "Escape"))
    (if (== f 61) (block
      (expr (call check t (&& (! (. s renaming)) (call same (. (index (. s files) (. t pick)) name) "zebra.txt")) "Escape closes the modal without renaming"))))
    (expr (call keyboardWalk t d s f))
    (if (== f (+ 90 (. t want))) (block
      (+= (. t fails) (call (. testkit misses)))
      (expr (call prefsTests t))
      (if (== (. t fails) 0) (block
        (expr (call printLn "all passed"))))
      (expr (call (. sys exit) (if-expr (== (. t fails) 0) 0 1)))))))
  (fn writeAll (params (path string) (data (slice u8))) bool (block
    (match (call (. io writeFile) path data)
      (arm (pats (variant Result.Ok (wild))) (block
        (return (bool true))))
      (arm (pats (variant Result.Err (wild))) (block
        (return (bool false)))))))
  (fn (doc "Preferences: a round trip, a missing file, garbage, and out-of-range values.") prefsTests (params (t (ref Test))) _ (block
    (let arena _ (call (. Arena create) 65536))
    (let mem _ (& arena))
    (let a _ (call (. State new) mem))
    (= (. a density) 1)
    (= (. a units) 1)
    (= (. a showHidden) (bool true))
    (= (. a sortKey) 2)
    (= (. a sortAsc) (bool false))
    (= (. a sideW) (float 0x4070400000000000))
    (= (. a owner) "Ada")
    (expr (call (. prefs store) (& a) "target/test-a.save"))
    (let b _ (call (. State new) mem))
    (expr (call (. prefs load) (& b) "target/test-a.save" mem))
    (expr (call check t (&& (&& (== (call (. prefs signature) (& a)) (call (. prefs signature) (& b))) (== (. b sideW) (float 0x4070400000000000))) (call same (. b owner) "Ada")) "preferences round trip"))
    (let c _ (call (. State new) mem))
    (expr (call (. prefs load) (& c) "target/does-not-exist.save" mem))
    (expr (call check t (&& (&& (== (. c density) 0) (== (. c sideW) (float 0x406b800000000000))) (call same (. c owner) "You")) "a missing preferences file gives the defaults"))
    (let g _ (call (. State new) mem))
    (let junk _ (call (. Arena create) 4096))
    (let blob _ (call (. junk alloc) (targs u8) 300))
    (for i (.. 0 300) (block
      (= (index blob i) (call u8 (% (+ (* i 37) 11) 256)))))
    (let io _ (call writeAll "target/test-junk.save" blob))
    (expr (call (. prefs load) (& g) "target/test-junk.save" mem))
    (expr (call check t (&& (&& (&& (&& io (== (. g density) 0)) (== (. g sortKey) 0)) (== (. g sideW) (float 0x406b800000000000))) (call same (. g owner) "You")) "a garbage preferences file gives the defaults"))
    (let h _ (call (. State new) mem))
    (let bad _ "density=7\nunits=-3\nsortKey=99\nsideW f=9999.0\nowner s=\n")
    (let io2 _ (call writeAll "target/test-range.save" (as bad (slice u8))))
    (expr (call (. prefs load) (& h) "target/test-range.save" mem))
    (expr (call check t (&& (&& (&& (&& (&& io2 (== (. h density) 0)) (== (. h units) 0)) (== (. h sortKey) 0)) (== (. h sideW) (float 0x406b800000000000))) (call same (. h owner) "You")) "out-of-range values fall back to the defaults"))
    (expr (call (. junk destroy)))
    (expr (call (. arena destroy))))))
--- stderr
--- exit 0
