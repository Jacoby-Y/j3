(file (module desk_app state)
  (use j3.memory.Arena)
  (use j3.rand.Rng)
  (use j3.text (names Text fmtBytes same))
  (use j3.ui.toast.Toasts)
  (const pub MAXF _ 40)
  (const pub NAME_MAX _ 40)
  (const pub KINDS _ 5)
  (const pub PAGE_ALL _ 0)
  (const pub PAGE_STARRED _ 1)
  (const pub PAGE_SETTINGS _ 2)
  (const (doc "Sort columns.") pub BY_NAME _ 0)
  (const pub BY_SIZE _ 1)
  (const pub BY_DATE _ 2)
  (struct pub File
    (field id int)
    (field name string)
    (field (doc "0 folder, 1 document, 2 image, 3 code, 4 audio.") kind int)
    (field bytes int)
    (field (doc "Days after 2025-01-01.") day int)
    (field starred bool)
    (field hidden bool)
    (field (doc "Text for the size and date columns, rebuilt when the units preference changes.") sizeText string)
    (field dayText string))
  (struct pub State
    (field mem (ref Arena))
    (field files (slice File))
    (field n int)
    (field (doc "Visible file ids in table order (`view()` rebuilds it when an input of it changed).") order (slice int))
    (field shown int)
    (field maxBytes int)
    (field (doc "Bumped by changes `view()` cannot see on its own (rename, star).") revision int 0)
    (field page int 0)
    (field sel int (- 1))
    (field sortKey int 0)
    (field sortAsc bool (bool true))
    (field (doc "The filter box writes here; it is a view of the box's buffer, so `seen` keeps a copy.") filter string "")
    (field seen (slice u8))
    (field seenLen int 0)
    (field seenKey int (- 1))
    (field seenUnits int (- 1))
    (field renaming bool (bool false))
    (field draft string "")
    (field toasts Toasts)
    (field now f32 (float 0x0000000000000000))
    (field (doc "0 comfortable, 1 compact.") density int 0)
    (field (doc "0 human (KB, MB), 1 plain bytes.") units int 0)
    (field showHidden bool (bool false))
    (field sideW f32 (float 0x406b800000000000))
    (field owner string "You")
    (fn new (params (mem (ref Arena))) State (block
      (let s _ (struct-lit State (field mem mem) (field files (call (. mem alloc) (targs File) MAXF)) (field n 0) (field order (call (. mem alloc) (targs int) MAXF)) (field shown 0) (field maxBytes 1) (field seen (call (. mem alloc) (targs u8) NAME_MAX)) (field toasts (call (. Toasts new)))))
      (expr (call (. s fake)))
      (return s)))
    (fn (doc "32 deterministic files. Sizes come from a short list and dates from a 12-day window, so several\nfiles tie on every column (the sort must keep them in id order).") fake (params (this (ref State))) _ (block
      (let stems (array 16 string) (array-lit "report" "budget" "photo" "notes" "main" "song" "plan" "logo" "draft" "intro" "data" "icon" "theme" "demo" "readme" "todo"))
      (let exts (array 5 string) (array-lit "" ".txt" ".png" ".j3" ".wav"))
      (let sizes (array 6 int) (array-lit 4096 12288 20480 524288 3145728 41943040))
      (let rng _ (call (. Rng new) 2026))
      (for i (.. 0 32) (block
        (let kind _ (call (. rng intRange) 0 KINDS))
        (if (>= i 16) (block
          (let other _ (. (index (. this files) (- i 16)) kind))
          (= kind (if-expr (== kind other) (% (+ kind 1) KINDS) kind))))
        (let t _ (call (. Text new) (. this mem)))
        (if (>= i 29) (block
          (expr (call (. t push) 46))))
        (expr (call (. t pushStr) (index stems (% i 16))))
        (expr (call (. t pushStr) (index exts kind)))
        (let bytes _ 0)
        (if (!= kind 0) (block
          (= bytes (index sizes (call (. rng intRange) 0 6)))))
        (= (index (. this files) i) (struct-lit File (field id i) (field name (call (. t str))) (field kind kind) (field bytes bytes) (field day (+ 400 (call (. rng intRange) 0 12))) (field starred (== (% i 5) 0)) (field hidden (>= i 29)) (field sizeText "") (field dayText "")))
        (if (> bytes (. this maxBytes)) (block
          (= (. this maxBytes) bytes)))))
      (= (. this n) 32)))
    (fn (doc "The visible ids in order. Filter + sort run only when something they depend on changed.") view (params (this (ref State))) (slice int) (block
      (let key _ (+ (+ (+ (+ (* (. this sortKey) 4) (if-expr (. this sortAsc) 1 0)) (if-expr (== (. this page) PAGE_STARRED) 2 0)) (if-expr (. this showHidden) 100 0)) (* (. this revision) 1000)))
      (let same_filter _ (== (. (. this filter) len) (. this seenLen)))
      (if same_filter (block
        (for i (.. 0 (. this seenLen)) (block
          (if (!= (index (. this filter) i) (index (. this seen) i)) (block
            (= same_filter (bool false))))))))
      (if (&& (&& (== key (. this seenKey)) same_filter) (== (. this units) (. this seenUnits))) (block
        (return (slice-expr (. this order) 0 (. this shown)))))
      (if (!= (. this units) (. this seenUnits)) (block
        (expr (call (. this relabel)))))
      (= (. this seenKey) key)
      (= (. this seenUnits) (. this units))
      (= (. this seenLen) (if-expr (< (. (. this filter) len) NAME_MAX) (. (. this filter) len) NAME_MAX))
      (for i (.. 0 (. this seenLen)) (block
        (= (index (. this seen) i) (index (. this filter) i))))
      (= (. this shown) 0)
      (for i (.. 0 (. this n)) (block
        (let f _ (index (. this files) i))
        (let ok _ (&& (&& (|| (. this showHidden) (! (. f hidden))) (|| (!= (. this page) PAGE_STARRED) (. f starred))) (call matches (. f name) (. this filter))))
        (if ok (block
          (let j _ (. this shown))
          (while (&& (> j 0) (call (. this before) i (index (. this order) (- j 1)))) (block
            (= (index (. this order) j) (index (. this order) (- j 1)))
            (-= j 1)))
          (= (index (. this order) j) i)
          (+= (. this shown) 1)))))
      (return (slice-expr (. this order) 0 (. this shown)))))
    (fn (doc "Does file `a` sort strictly before `b` under the current column and direction?") before (params (this (ref State)) (a int) (b int)) bool (block
      (let x _ (index (. this files) a))
      (let y _ (index (. this files) b))
      (let c _ 0)
      (if (== (. this sortKey) BY_NAME) (block
        (= c (call compareNames (. x name) (. y name)))) (block
        (if (== (. this sortKey) BY_SIZE) (block
          (= c (call cmp (. x bytes) (. y bytes)))) (block
          (= c (call cmp (. x day) (. y day)))))))
      (return (if-expr (. this sortAsc) (< c 0) (> c 0)))))
    (fn (doc "Header click: same column flips the direction, another column starts ascending.") sortBy (params (this (ref State)) (k int)) _ (block
      (if (== (. this sortKey) k) (block
        (= (. this sortAsc) (! (. this sortAsc)))) (block
        (= (. this sortKey) k)
        (= (. this sortAsc) (bool true))))))
    (fn (doc "0 not sorted by this column, 1 ascending, 2 descending.") dir (params (this (ref State)) (k int)) int (block
      (if (!= (. this sortKey) k) (block
        (return 0)))
      (return (if-expr (. this sortAsc) 1 2))))
    (fn pick (params (this (ref State)) (id int)) _ (block
      (= (. this sel) id)))
    (fn (doc "The selected file, or file 0 when nothing is selected (callers check `sel >= 0` first).") cur (params (this (ref State))) File (block
      (return (index (. this files) (if-expr (>= (. this sel) 0) (. this sel) 0)))))
    (fn toggleStar (params (this (ref State))) _ (block
      (if (>= (. this sel) 0) (block
        (= (. (index (. this files) (. this sel)) starred) (! (. (index (. this files) (. this sel)) starred)))
        (+= (. this revision) 1)))))
    (fn openRename (params (this (ref State))) _ (block
      (if (>= (. this sel) 0) (block
        (= (. this draft) (. (index (. this files) (. this sel)) name))
        (= (. this renaming) (bool true))))))
    (fn (doc "Why the draft name cannot be used (\"\" when it can).") problem (params (this (ref State))) string (block
      (if (== (. (. this draft) len) 0) (block
        (return "A name is needed")))
      (if (> (. (. this draft) len) NAME_MAX) (block
        (return "At most 40 bytes")))
      (for i (.. 0 (. this n)) (block
        (if (&& (!= i (. this sel)) (call lowerSame (. (index (. this files) i) name) (. this draft))) (block
          (return "That name is taken")))))
      (return "")))
    (fn (doc "Apply the draft if it is valid. Returns whether it was.") commitRename (params (this (ref State)) (name string)) bool (block
      (= (. this draft) name)
      (if (> (. (call (. this problem)) len) 0) (block
        (return (bool false))))
      (let t _ (call (. Text new) (. this mem)))
      (expr (call (. t pushStr) name))
      (= (. (index (. this files) (. this sel)) name) (call (. t str)))
      (+= (. this revision) 1)
      (= (. this renaming) (bool false))
      (expr (call (. this toast) (interp "Renamed to " name) 1))
      (return (bool true))))
    (fn toast (params (this (ref State)) (msg string) (kind int)) _ (block
      (expr (call (. (. this toasts) push) msg kind (float 0x40a7700000000000) (. this now)))))
    (fn (doc "Size and date columns as text. Rebuilt on a units change, never per frame.") relabel (params (this (ref State))) _ (block
      (for i (.. 0 (. this n)) (block
        (let f _ (& (index (. this files) i)))
        (let t _ (call (. Text new) (. this mem)))
        (if (== (. f kind) 0) (block
          (expr (call (. t pushStr) "-"))) (block
          (if (== (. this units) 1) (block
            (expr (call (. t pushInt) (. f bytes)))
            (expr (call (. t pushStr) " B"))) (block
            (expr (call fmtBytes (& t) (. f bytes)))))))
        (= (. f sizeText) (call (. t str)))
        (if (== (. (. f dayText) len) 0) (block
          (= (. f dayText) (call dayName (. this mem) (. f day))))))))))
  (fn (doc "`YYYY-MM-DD` for a day count after 2025-01-01 (years of 365 days: it is fake data).") dayName (params (mem (ref Arena)) (day int)) string (block
    (let md (array 12 int) (array-lit 31 28 31 30 31 30 31 31 30 31 30 31))
    (let y _ (+ 2025 (/ day 365)))
    (let d _ (% day 365))
    (let m _ 0)
    (while (>= d (index md m)) (block
      (-= d (index md m))
      (+= m 1)))
    (let t _ (call (. Text new) mem))
    (expr (call (. t pushInt) y))
    (expr (call (. t pushStr) (if-expr (< m 9) "-0" "-")))
    (expr (call (. t pushInt) (+ m 1)))
    (expr (call (. t pushStr) (if-expr (< d 9) "-0" "-")))
    (expr (call (. t pushInt) (+ d 1)))
    (return (call (. t str)))))
  (fn cmp (params (a int) (b int)) int (block
    (if (< a b) (block
      (return (- 1))))
    (return (if-expr (> a b) 1 0))))
  (fn lower (params (b u8)) u8 (block
    (return (if-expr (&& (>= b 65) (<= b 90)) (+ b 32) b))))
  (fn (doc "Case-insensitive byte order: negative, 0 or positive.") compareNames (params (a string) (b string)) int (block
    (let n _ (if-expr (< (. a len) (. b len)) (. a len) (. b len)))
    (for i (.. 0 n) (block
      (let x _ (call int (call lower (index a i))))
      (let y _ (call int (call lower (index b i))))
      (if (!= x y) (block
        (return (- x y))))))
    (return (- (. a len) (. b len)))))
  (fn lowerSame (params (a string) (b string)) bool (block
    (return (&& (== (. a len) (. b len)) (== (call compareNames a b) 0)))))
  (fn (doc "Case-insensitive substring test; an empty filter matches everything.") matches (params (name string) (part string)) bool (block
    (if (== (. part len) 0) (block
      (return (bool true))))
    (for i (.. 0 (+ (- (. name len) (. part len)) 1)) (block
      (let ok _ (bool true))
      (for j (.. 0 (. part len)) (block
        (if (!= (call lower (index name (+ i j))) (call lower (index part j))) (block
          (= ok (bool false))))))
      (if ok (block
        (return (bool true))))))
    (return (bool false)))))
--- stderr
--- exit 0
