(file (module gen_tree)
  (use j3.memory.Arena)
  (use j3.gfx.meshgen)
  (use j3.gfx.meshgen.Builder)
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 4 1024) 1024)))
    (let b _ (call (. Builder new) (& mem)))
    (expr (call (. b color) (float 0x3fdccccccccccccd) (float 0x3fd3333333333333) (float 0x3fc70a3d70a3d70a)))
    (expr (call (. b push)))
    (expr (call (. b at) 0 (float 0x3fe3333333333333) 0))
    (expr (call (. b frustum) (float 0x3fc47ae147ae147b) (float 0x3fb999999999999a) (float 0x3ff3333333333333) 10))
    (expr (call (. b pop)))
    (expr (call (. b color) (float 0x3fc999999999999a) (float 0x3fe199999999999a) (float 0x3fd0000000000000)))
    (let tier _ 0)
    (while (< tier 3) (block
      (expr (call (. b push)))
      (expr (call (. b at) 0 (+ (float 0x3ff4cccccccccccd) (* (call f32 tier) (float 0x3fe199999999999a))) 0))
      (expr (call (. b cone) (- (float 0x3fe999999999999a) (* (call f32 tier) (float 0x3fc999999999999a))) (float 0x3ff0000000000000) 12))
      (expr (call (. b pop)))
      (+= tier 1)))
    (expr (call (. b save) (call (. meshgen output) "assets/gen/tree.j3mesh"))))))
--- stderr
--- exit 0
