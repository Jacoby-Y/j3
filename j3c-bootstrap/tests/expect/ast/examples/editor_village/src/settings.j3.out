(file (module editor_village settings)
  (use j3.game)
  (use j3.game (names Font rgb))
  (use j3.math (names Vec2 Vec3 clamp cos sin lerp))
  (use j3.memory.scratch)
  (use j3.scene3d)
  (use j3.scene3d (names Env Scene))
  (use j3.text (names Text cstr same))
  (use-lib "c" libc
    (lib-fn getenv (params (name cstr)) cstr _)
    (lib-fn strlen (params (s cstr)) int _))
  (use j3.ui.Ui)
  (struct pub Settings
    (field urp bool)
    (field bounces int)
    (field samples int)
    (field tracedShadows bool)
    (field (doc "Traced shadows stop this far away; the shadow map covers the rest (0: no limit).") traceNear f32)
    (field shadows bool)
    (field (doc "Half size of the sun's shadow box around the player; smaller is sharper.") shadowRange f32)
    (field viewDistance f32)
    (field (doc "Degrees above the horizon, and around from +z.") sunHeight f32)
    (field sunTurn f32)
    (field fov f32)
    (field sensitivity f32)
    (field walkSpeed f32)
    (field open bool)
    (field quit bool)
    (field (doc "Smoothed frames per second.") fps f32))
  (fn pub defaults (params) Settings (block
    (let s _ (struct-lit Settings (field urp (bool true)) (field bounces 2) (field samples 1) (field tracedShadows (bool false)) (field traceNear 40) (field shadows (bool true)) (field shadowRange 45) (field viewDistance 260) (field sunHeight 33) (field sunTurn 57) (field fov 70) (field sensitivity 1) (field walkSpeed (float 0x4012000000000000)) (field open (bool false)) (field quit (bool false)) (field fps 60)))
    (expr (call preset (& s)))
    (return s)))
  (fn (doc "Quality presets.") low (params (s (ref Settings))) _ (block
    (= (. s urp) (bool false))
    (= (. s shadows) (bool true))
    (= (. s shadowRange) 35)
    (= (. s viewDistance) 160)))
  (fn medium (params (s (ref Settings))) _ (block
    (= (. s urp) (bool true))
    (= (. s bounces) 1)
    (= (. s samples) 1)
    (= (. s tracedShadows) (bool false))
    (= (. s shadows) (bool true))
    (= (. s shadowRange) 45)
    (= (. s viewDistance) 220)))
  (fn high (params (s (ref Settings))) _ (block
    (= (. s urp) (bool true))
    (= (. s bounces) 2)
    (= (. s samples) 2)
    (= (. s tracedShadows) (bool false))
    (= (. s shadows) (bool true))
    (= (. s shadowRange) 55)
    (= (. s viewDistance) 300)))
  (fn ultra (params (s (ref Settings))) _ (block
    (= (. s urp) (bool true))
    (= (. s bounces) 4)
    (= (. s samples) 4)
    (= (. s tracedShadows) (bool true))
    (= (. s traceNear) 100)
    (= (. s shadows) (bool true))
    (= (. s shadowRange) 70)
    (= (. s viewDistance) 400)))
  (fn (doc "`VILLAGE_PRESET` (low, medium, high, ultra, traced) for headless benchmarks.") preset (params (s (ref Settings))) _ (block
    (let raw _ (call (. libc getenv) (call cstr "VILLAGE_PRESET")))
    (if (== raw 0) (block
      (return)))
    (let name _ (as (slice-lit u8 (field ptr (as raw (ref u8))) (field len (call (. libc strlen) raw))) string))
    (if (call same name "low") (block
      (expr (call low s))))
    (if (call same name "medium") (block
      (expr (call medium s))))
    (if (call same name "high") (block
      (expr (call high s))))
    (if (call same name "ultra") (block
      (expr (call ultra s))))
    (if (call same name "traced") (block
      (= (. s tracedShadows) (bool true))))))
  (fn (doc "`VILLAGE_POND` is set: start at the pond (reflection benchmark).") pub pondView (params) bool (block
    (return (!= (call (. libc getenv) (call cstr "VILLAGE_POND")) 0))))
  (fn (doc "Direction toward the sun.") pub sunDir (params (s (ref Settings))) Vec3 (block
    (let up _ (* (. s sunHeight) (float 0x3f91df469963e11d)))
    (let around _ (* (. s sunTurn) (float 0x3f91df469963e11d)))
    (return (call (. Vec3 xyz) (* (call cos up) (call sin around)) (call sin up) (* (call cos up) (call cos around))))))
  (fn mix (params (a Vec3) (b Vec3) (t f32)) Vec3 (block
    (return (call (. Vec3 xyz) (call lerp (. a x) (. b x) t) (call lerp (. a y) (. b y) t) (call lerp (. a z) (. b z) t)))))
  (fn (doc "The scene lighting these settings give: a low sun is orange and dims the sky.") pub environment (params (s (ref Settings)) (scene (ref Scene))) Env (block
    (let env _ (call (. scene3d environment) scene))
    (let day _ (call clamp (/ (. s sunHeight) 45) 0 1))
    (let dusk _ (call clamp (/ (+ (. s sunHeight) 4) 12) 0 1))
    (= (. env sunDir) (call sunDir s))
    (= (. env sunColor) (* (call mix (call (. Vec3 xyz) (float 0x3ff0000000000000) (float 0x3fdccccccccccccd) (float 0x3fcc28f5c28f5c29)) (call (. Vec3 xyz) (float 0x3ff0000000000000) (float 0x3fedc28f5c28f5c3) (float 0x3feae147ae147ae1)) day) dusk))
    (= (. env sky) (call mix (call mix (call (. Vec3 xyz) (float 0x3fb999999999999a) (float 0x3fb999999999999a) (float 0x3fc70a3d70a3d70a)) (call (. Vec3 xyz) (float 0x3fe8f5c28f5c28f6) (float 0x3fe199999999999a) (float 0x3fe0000000000000)) dusk) (call (. Vec3 xyz) (float 0x3fe3d70a3d70a3d7) (float 0x3fe7ae147ae147ae) (float 0x3fec28f5c28f5c29)) day))
    (= (. env fogEnd) (. s viewDistance))
    (= (. env fogStart) (* (. s viewDistance) (float 0x3fd3333333333333)))
    (= (. env shadows) (. s shadows))
    (= (. env shadowSize) (. s shadowRange))
    (= (. env urp) (. s urp))
    (= (. env bounces) (. s bounces))
    (= (. env samples) (. s samples))
    (= (. env tracedShadows) (. s tracedShadows))
    (= (. env traceNear) (. s traceNear))
    (return env)))
  (fn (doc "Tab or Esc opens and closes the panel; the mouse is captured while it's closed.") pub input (params (s (ref Settings)) (dt f32)) _ (block
    (if (> dt 0) (block
      (= (. s fps) (call lerp (. s fps) (/ 1 dt) (float 0x3fa999999999999a)))))
    (if (|| (call (. game keyPressed) (. (. game Key) Tab)) (call (. game keyPressed) (. (. game Key) Escape))) (block
      (= (. s open) (! (. s open)))))
    (let want _ (! (. s open)))
    (if (!= (call (. game mouseCaptured)) want) (block
      (expr (call (. game captureMouse) want))))))
  (fn line (params (ui (ref Ui)) (head string) (n f32)) _ (block
    (let t _ (call (. Text new) (call scratch 0)))
    (expr (call (. t pushStr) head))
    (expr (call (. t pushInt) (call int (+ n (float 0x3fe0000000000000)))))
    (expr (call (. ui label) (call (. t str))))))
  (fn pub panel (params (s (ref Settings)) (font Font)) _ (block
    (if (== (. font raw) 0) (block
      (return)))
    (let win _ (call (. game windowSize)))
    (if (! (. s open)) (block
      (expr (call (. game setColor) (call rgb 255 255 255)))
      (expr (call (. game drawText) font (struct-lit Vec2 (field x 14) (field y (- (. win y) 30))) "WASD walk  Shift run  Space jump  Tab settings"))
      (return)))
    (let ui _ (call (. Ui begin) font 16 16))
    (expr (call (. ui panel) 330 (- (. win y) 32)))
    (expr (call (. ui labelBold) "Village settings"))
    (expr (call line (& ui) "FPS " (. s fps)))
    (let st _ (call (. game frameStats)))
    (let t _ (call (. Text new) (call scratch 0)))
    (expr (call (. t pushStr) "draws "))
    (expr (call (. t pushInt) (. st draws)))
    (expr (call (. t pushStr) "  tris "))
    (expr (call (. t pushInt) (. st tris)))
    (expr (call (. t pushStr) "  cpu "))
    (expr (call (. t pushInt) (call int (+ (. st cpuMs) (float 0x3fe0000000000000)))))
    (expr (call (. t pushStr) " ms  (F3: profiler)"))
    (expr (call (. ui label) (call (. t str))))
    (expr (call (. ui scroll) 1 (- (. win y) 120)))
    (expr (call (. ui labelBold) "Quality"))
    (expr (call (. ui row)))
    (if (call (. ui button) "Low") (block
      (expr (call low s))))
    (if (call (. ui button) "Medium") (block
      (expr (call medium s))))
    (if (call (. ui button) "High") (block
      (expr (call high s))))
    (if (call (. ui button) "Ultra") (block
      (expr (call ultra s))))
    (expr (call (. ui end)))
    (expr (call (. ui toggle) "URP ray tracing" (& (. s urp))))
    (expr (call (. ui stepper) "Ray bounces" (& (. s bounces)) 1 6))
    (expr (call (. ui stepper) "Samples per pixel" (& (. s samples)) 1 8))
    (expr (call (. ui toggle) "Traced sun shadows" (& (. s tracedShadows))))
    (expr (call (. ui slider) "Traced shadow distance" (& (. s traceNear)) 0 200))
    (expr (call (. ui toggle) "Shadow map" (& (. s shadows))))
    (expr (call (. ui slider) "Shadow range" (& (. s shadowRange)) 15 120))
    (expr (call (. ui slider) "View distance" (& (. s viewDistance)) 80 500))
    (expr (call (. ui rule)))
    (expr (call (. ui labelBold) "Sun"))
    (expr (call (. ui slider) "Height" (& (. s sunHeight)) (- 6) 85))
    (expr (call (. ui slider) "Direction" (& (. s sunTurn)) 0 360))
    (expr (call (. ui row)))
    (if (call (. ui button) "Morning") (block
      (= (. s sunHeight) 12)
      (= (. s sunTurn) 95)))
    (if (call (. ui button) "Noon") (block
      (= (. s sunHeight) 68)
      (= (. s sunTurn) 170)))
    (if (call (. ui button) "Sunset") (block
      (= (. s sunHeight) 5)
      (= (. s sunTurn) 265)))
    (expr (call (. ui end)))
    (expr (call (. ui rule)))
    (expr (call (. ui labelBold) "Camera"))
    (expr (call (. ui slider) "Field of view" (& (. s fov)) 50 100))
    (expr (call (. ui slider) "Mouse speed" (& (. s sensitivity)) (float 0x3fc999999999999a) 3))
    (expr (call (. ui slider) "Walk speed" (& (. s walkSpeed)) 2 12))
    (expr (call (. ui rule)))
    (if (call (. ui button) "Back to the village") (block
      (= (. s open) (bool false))))
    (if (call (. ui button) "Quit") (block
      (= (. s quit) (bool true))))
    (expr (call (. ui end)))
    (expr (call (. ui end))))))
--- stderr
--- exit 0
