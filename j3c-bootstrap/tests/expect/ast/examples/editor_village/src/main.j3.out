(file (module editor_village)
  (use j3.scene3d.scripts)
  (use editor_village.settings)
  (use editor_village.settings.Settings)
  (use j3.app.App)
  (use j3.scene3d.fpwalk)
  (use j3.scene3d.fpwalk.Walker)
  (use j3.game)
  (use j3.game.Font)
  (use j3.gfx)
  (use j3.math.Vec3)
  (use j3.memory.Arena)
  (use j3.scene3d)
  (use j3.scene3d.Scene)
  (struct World
    (field scene Scene)
    (field walker Walker)
    (field settings Settings)
    (field font Font)
    (field mem (ref Arena)))
  (fn boot (params (mem (ref Arena))) World (block
    (let scene _ (call (. scene3d load) (call (. scripts scene)) mem))
    (return (struct-lit World (field scene scene) (field walker (call (. fpwalk spawn) (& scene) mem)) (field settings (call (. settings defaults))) (field font (struct-lit Font (field raw 0))) (field mem mem)))))
  (fn startup (params (w (ref World))) _ (block
    (expr (call (. gfx init)))
    (expr (call (. scene3d upload) (& (. w scene))))
    (= (. w walker) (call (. fpwalk spawn) (& (. w scene)) (. w mem)))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "grass"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "flower"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "crops_"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "plant_bush"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "campfire"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "mushroom"))
    (expr (call (. fpwalk walkThrough) (& (. w walker)) "builtin:cylinder"))
    (expr (call (. fpwalk trunks) (& (. w walker)) "tree" (float 0x3fc999999999999a)))
    (if (call (. settings pondView)) (block
      (= (. (. w walker) pos) (call (. Vec3 xyz) 60 0 67))
      (= (. (. w walker) yaw) 0)
      (= (. (. w walker) pitch) (- (float 0x3fe3333333333333)))))
    (= (. w font) (call (. game loadFont) "assets/font.ttf" 16))
    (expr (call (. game captureMouse) (bool true)))
    (expr (call (. scripts start) (& (. w scene))))))
  (fn update (params (w (ref World)) (dt f32)) _ (block
    (expr (call (. settings input) (& (. w settings)) dt))
    (if (. (. w settings) quit) (block
      (expr (call (. game requestQuit)))))
    (expr (call (. fpwalk update) (& (. w walker)) dt (! (. (. w settings) open)) (. (. w settings) sensitivity) (. (. w settings) walkSpeed)))
    (expr (call (. scripts update) (& (. w scene)) dt))))
  (fn draw (params (w (ref World))) _ (block
    (let s _ (& (. w settings)))
    (let env _ (call (. settings environment) s (& (. w scene))))
    (expr (call (. scene3d setEnvironment) (& (. w scene)) env))
    (expr (call (. scene3d drawFrame) (& (. w scene)) (call (. fpwalk look) (& (. w walker))) env (. s fov)))
    (expr (call (. settings panel) s (. w font)))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "Village" 1280 720 boot))
    (expr (call (. app useGl)))
    (expr (call (. app startup) startup))
    (expr (call (. app always) update))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
