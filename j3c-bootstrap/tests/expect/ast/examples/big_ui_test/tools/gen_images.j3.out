(file (module gen_images)
  (use j3.gfx.canvas)
  (use j3.gfx.canvas (names Canvas Mode))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.result.Result)
  (use j3.sys.panic)
  (fn save (params (c Canvas) (name string) (arena (ref Arena))) _ (block
    (match (call (. c savePng) name arena)
      (arm (pats (variant Result.Ok (wild))) (block))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic name)))))
    (expr (call printLn name))))
  (fn (doc "A 192x128 \"photo\": sky gradient, a sun, two hills, noise.") photo (params (arena (ref Arena))) _ (block
    (let c _ (call (. Canvas create) arena 192 128 (. Mode Smooth)))
    (expr (call (. c gradientRect) 0 0 192 128 (call (. canvas rgb) 70 120 200) (call (. canvas rgb) 250 190 140) (bool true)))
    (expr (call (. c fillCircle) 140 40 18 (call (. canvas rgb) 255 238 170)))
    (expr (call (. c fillCircle) 140 40 12 (call (. canvas rgb) 255 250 220)))
    (expr (call (. c fillTriangle) (float 0x0000000000000000) (float 0x4060000000000000) (float 0x4051800000000000) (float 0x404c000000000000) (float 0x4062c00000000000) (float 0x4060000000000000) (call (. canvas rgb) 60 110 80)))
    (expr (call (. c fillTriangle) (float 0x404e000000000000) (float 0x4060000000000000) (float 0x4061800000000000) (float 0x4051800000000000) (float 0x4068000000000000) (float 0x4060000000000000) (call (. canvas rgb) 40 85 70)))
    (expr (call (. c noiseRect) 0 100 192 28 7 2 (call (. canvas rgba) 20 50 40 90) (call (. canvas rgba) 90 150 100 90)))
    (expr (call (. c fillRect) 0 0 16 16 (call (. canvas rgb) 230 60 60)))
    (expr (call (. c strokeRect) 0 0 192 128 2 (call (. canvas rgb) 255 255 255)))
    (expr (call save c "assets/img/photo.png" arena))))
  (fn (doc "A 48x48 frame for nine-slice: 12 px corners with a stud, gradient edges, plain center.") frame (params (arena (ref Arena))) _ (block
    (let c _ (call (. Canvas create) arena 48 48 (. Mode Pixel)))
    (expr (call (. c clear) (call (. canvas rgba) 0 0 0 0)))
    (expr (call (. c fillRect) 0 0 48 48 (call (. canvas rgb) 60 52 90)))
    (expr (call (. c fillRect) 3 3 42 42 (call (. canvas rgb) 232 196 110)))
    (expr (call (. c fillRect) 6 6 36 36 (call (. canvas rgb) 38 34 62)))
    (expr (call (. c fillRect) 12 12 24 24 (call (. canvas rgb) 52 48 84)))
    (expr (call (. c fillRect) 3 3 6 6 (call (. canvas rgb) 250 120 90)))
    (expr (call (. c fillRect) 39 3 6 6 (call (. canvas rgb) 250 120 90)))
    (expr (call (. c fillRect) 3 39 6 6 (call (. canvas rgb) 250 120 90)))
    (expr (call (. c fillRect) 39 39 6 6 (call (. canvas rgb) 250 120 90)))
    (for i (.. 0 4) (block
      (expr (call (. c fillRect) (+ 16 (* (call i32 i) 6)) 3 3 3 (call (. canvas rgb) 60 52 90)))
      (expr (call (. c fillRect) (+ 16 (* (call i32 i) 6)) 42 3 3 (call (. canvas rgb) 60 52 90)))))
    (expr (call save c "assets/img/frame.png" arena))))
  (fn (doc "A 4x2 sprite sheet of 32x32 frames: a pulsing ring with a marker that walks around it.") sheet (params (arena (ref Arena))) _ (block
    (let c _ (call (. Canvas create) arena 128 64 (. Mode Smooth)))
    (expr (call (. c clear) (call (. canvas rgba) 0 0 0 0)))
    (let rad (array 8 f32) (array-lit (float 0x4020000000000000) (float 0x4024000000000000) (float 0x4028000000000000) (float 0x402c000000000000) (float 0x402c000000000000) (float 0x4028000000000000) (float 0x4024000000000000) (float 0x4020000000000000)))
    (let mdx (array 8 f32) (array-lit (float 0x4028000000000000) (float 0x4022000000000000) (float 0x0000000000000000) (- (float 0x4022000000000000)) (- (float 0x4028000000000000)) (- (float 0x4022000000000000)) (float 0x0000000000000000) (float 0x4022000000000000)))
    (let mdy (array 8 f32) (array-lit (float 0x0000000000000000) (float 0x4022000000000000) (float 0x4028000000000000) (float 0x4022000000000000) (float 0x0000000000000000) (- (float 0x4022000000000000)) (- (float 0x4028000000000000)) (- (float 0x4022000000000000))))
    (for f (.. 0 8) (block
      (let ox _ (call f32 (* (% f 4) 32)))
      (let oy _ (call f32 (* (/ f 4) 32)))
      (expr (call (. c fillCircle) (+ ox (float 0x4030000000000000)) (+ oy (float 0x4030000000000000)) (index rad f) (call (. canvas rgb) 90 170 250)))
      (expr (call (. c fillCircle) (+ ox (float 0x4030000000000000)) (+ oy (float 0x4030000000000000)) (- (index rad f) (float 0x4008000000000000)) (call (. canvas rgb) 30 50 90)))
      (expr (call (. c fillCircle) (+ (+ ox (float 0x4030000000000000)) (index mdx f)) (+ (+ oy (float 0x4030000000000000)) (index mdy f)) (float 0x4008000000000000) (call (. canvas rgb) 250 220 90)))
      (for p (.. 0 (+ f 1)) (block
        (expr (call (. c fillRect) (+ (+ (call i32 ox) 2) (* (call i32 p) 3)) (+ (call i32 oy) 28) 2 2 (call (. canvas rgb) 255 255 255)))))))
    (expr (call save c "assets/img/sheet.png" arena))))
  (fn (doc "A 16x16 pattern tile for repeating backgrounds.") tile (params (arena (ref Arena))) _ (block
    (let c _ (call (. Canvas create) arena 16 16 (. Mode Pixel)))
    (expr (call (. c fillRect) 0 0 16 16 (call (. canvas rgb) 40 44 70)))
    (expr (call (. c fillRect) 0 0 8 8 (call (. canvas rgb) 52 58 92)))
    (expr (call (. c fillRect) 8 8 8 8 (call (. canvas rgb) 52 58 92)))
    (expr (call (. c fillCircle) 4 4 2 (call (. canvas rgb) 140 170 255)))
    (expr (call (. c fillCircle) 12 12 2 (call (. canvas rgb) 255 170 140)))
    (expr (call save c "assets/img/tile.png" arena))))
  (fn (doc "A white 32x32 gear-ish icon on transparent: tint it with `image-tint`.") icon (params (arena (ref Arena))) _ (block
    (let c _ (call (. Canvas create) arena 32 32 (. Mode Smooth)))
    (expr (call (. c clear) (call (. canvas rgba) 0 0 0 0)))
    (expr (call (. c fillCircle) 16 16 11 (call (. canvas rgb) 255 255 255)))
    (expr (call (. c fillCircle) 16 16 5 (call (. canvas rgba) 0 0 0 0)))
    (expr (call (. c fillRect) 14 1 4 6 (call (. canvas rgb) 255 255 255)))
    (expr (call (. c fillRect) 14 25 4 6 (call (. canvas rgb) 255 255 255)))
    (expr (call (. c fillRect) 1 14 6 4 (call (. canvas rgb) 255 255 255)))
    (expr (call (. c fillRect) 25 14 6 4 (call (. canvas rgb) 255 255 255)))
    (expr (call save c "assets/img/icon.png" arena))))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) (* (* 4 1024) 1024)))
    (expr (call photo (& arena)))
    (expr (call frame (& arena)))
    (expr (call sheet (& arena)))
    (expr (call tile (& arena)))
    (expr (call icon (& arena)))
    (expr (call (. arena destroy))))))
--- stderr
--- exit 0
