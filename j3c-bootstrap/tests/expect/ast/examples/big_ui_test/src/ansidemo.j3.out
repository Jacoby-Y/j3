(file (module big_ui_test ansidemo)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (use j3.ui.ansi.AnsiLog)
  (mod-let LOG AnsiLog _)
  (mod-let ARENA Arena _)
  (mod-let STARTED bool _)
  (fn (doc "`~` stands for ESC, since J3 strings have no escape for it.") esc (params (s string) (mem (ref Arena))) string (block
    (let t _ (call (. Text new) mem))
    (for i (.. 0 (. s len)) (block
      (expr (call (. t push) (if-expr (== (index s i) 126) 27 (index s i))))))
    (return (call (. t str)))))
  (fn (doc "The one demo log, filled once: captured `ls --color`, a compiler error, SGR attributes, a progress bar, a\n256-color ramp. 0xcdd6f4 and 0x11111b are the page's text and pane colors (the page CSS), for inverse and dim.") pub demoLog (params) (ref AnsiLog) (block
    (if (! STARTED) (block
      (= ARENA (call (. Arena create) 4194304))
      (= LOG (call (. AnsiLog new) 13489908 1118491 1000))
      (let a _ (& ARENA))
      (expr (call (. LOG append) (call esc "$ ls --color\n~[1;34msrc~[0m  ~[1;34mui~[0m  ~[0;32mrun.sh~[0m  ~[1;36mlatest~[0m  ~[0;31marchive.tar.gz~[0m  notes.txt\n" a)))
      (expr (call (. LOG append) (call esc "$ j3c build\n~[1m~[31merror~[0m~[1m: no method `new`~[0m\n  ~[34m-->~[0m src/main.j3:34:19\n   ~[34m|~[0m\n~[34m34 |~[0m     let a = Arena.~[1;31m^^^~[0m\n" a)))
      (expr (call (. LOG append) (call esc "~[1mbold~[0m ~[2mdim~[0m ~[3mitalic~[0m ~[4munderline~[0m ~[9mstrike~[0m ~[7minverse~[0m ~[8mhidden~[0m ~[1;3;4mall three~[0m\n" a)))
      (expr (call (. LOG append) (call esc "~[31mred~[0m ~[32mgreen~[0m ~[33myellow~[0m ~[34mblue~[0m ~[35mmagenta~[0m ~[36mcyan~[0m ~[91mbright red~[0m ~[42;30m on green ~[0m\n" a)))
      (let t _ (call (. Text new) a))
      (for i (.. 16 232) (block
        (expr (call (. t pushStr) "~[48;5;"))
        (expr (call (. t pushInt) i))
        (expr (call (. t pushStr) "m ~[0m"))
        (if (== (% (- i 15) 36) 0) (block
          (expr (call (. t push) 10))))))
      (expr (call (. LOG append) (call esc (call (. t str)) a)))
      (expr (call (. LOG append) (call esc "~[38;2;255;160;40mtruecolor~[0m ~[2K~[1;1H(cursor escapes are dropped)\n" a)))
      (expr (call (. LOG append) "downloading 10%\rdownloading 55%\rdownloading 100%\n"))
      (= STARTED (bool true))))
    (return (& LOG)))))
--- stderr
--- exit 0
