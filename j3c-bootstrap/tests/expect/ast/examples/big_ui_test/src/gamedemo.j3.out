(file (module big_ui_test gamedemo)
  (use big_ui_test.dialogue)
  (use big_ui_test.items)
  (use big_ui_test.gameworld)
  (use j3.game.frameCount)
  (use j3.math (names cos sin))
  (use j3.memory.Arena)
  (use j3.ui.toast.Toasts)
  (const pub SLOTS int 100)
  (const pub FLOATS int 24)
  (const pub MOBS int 10)
  (const pub SKILLS int 4)
  (const NO_MOB int (- 1))
  (const DT f32 (float 0x3f9111134dba9df6))
  (struct (doc "One damage number. `mob` is the mob it floats over, or -1 for the player; `kind`: 0 hurt, 1 crit, 2 heal, 3 hit.\n`id` is its pool slot, the `{#each}` key.") pub Floater
    (field id int)
    (field live bool)
    (field age f32)
    (field mob int)
    (field amt int)
    (field kind int)
    (field jit f32))
  (struct (doc "One mob: world position, health, and its projection to the view (`sx`, `sy`, `depth`, `shown`).") pub Mob
    (field id int)
    (field x f32)
    (field z f32)
    (field hp int)
    (field maxHp int)
    (field lvl int)
    (field seed f32)
    (field sx f32)
    (field sy f32)
    (field depth f32)
    (field shown bool))
  (struct pub Demo
    (field t f32 (float 0x0000000000000000))
    (field last int (- 1))
    (field auto bool (bool true))
    (field rng int 12345)
    (field hp int 100)
    (field hpMax int 100)
    (field mana int 80)
    (field manaMax int 80)
    (field stam int 100)
    (field stamMax int 100)
    (field regen f32 (float 0x0000000000000000))
    (field deadFor f32 (float 0x0000000000000000))
    (field px f32 (float 0x0000000000000000))
    (field pz f32 (- (float 0x4024000000000000)))
    (field yaw f32 (float 0x0000000000000000))
    (field tHit f32 (float 0x0000000000000000))
    (field tHurt f32 (float 0x0000000000000000))
    (field tCast f32 (float 0x0000000000000000))
    (field cd (slice f32))
    (field cdTotal (slice f32))
    (field cost (slice int))
    (field kind (slice int))
    (field rarity (slice int))
    (field count (slice int))
    (field sel int (- 1))
    (field floats (slice Floater))
    (field mobs (slice Mob))
    (field toasts Toasts)
    (field kills int 0)
    (field questOn bool (bool false))
    (field dlgLine int 0)
    (field dlgT0 f32 (float 0x0000000000000000))
    (field dlgAnswer int (- 1))
    (fn new (params) Demo (block
      (let mem _ (call (. Arena create) 65536))
      (let d _ (struct-lit Demo (field toasts (call (. Toasts new))) (field cd (call (. mem alloc) (targs f32) SKILLS)) (field cdTotal (call (. mem alloc) (targs f32) SKILLS)) (field cost (call (. mem alloc) (targs int) SKILLS)) (field kind (call (. mem alloc) (targs int) SLOTS)) (field rarity (call (. mem alloc) (targs int) SLOTS)) (field count (call (. mem alloc) (targs int) SLOTS)) (field floats (call (. mem alloc) (targs Floater) FLOATS)) (field mobs (call (. mem alloc) (targs Mob) MOBS))))
      (for s (.. 0 SKILLS) (block
        (= (index (. d cd) s) (float 0x0000000000000000))
        (= (index (. d cdTotal) s) (+ (float 0x4008000000000000) (* (call f32 (* s s)) (float 0x3ff8000000000000))))
        (= (index (. d cost) s) (+ 8 (* s 6)))))
      (= (index (. d cd) 1) (float 0x4000000000000000))
      (for i (.. 0 SLOTS) (block
        (= (index (. d kind) i) (call (. items kindAt) i))
        (= (index (. d rarity) i) (if-expr (< (index (. d kind) i) 0) 0 (call (. items rarityAt) i)))
        (= (index (. d count) i) (call (. items countAt) i))))
      (for i (.. 0 FLOATS) (block
        (= (. (index (. d floats) i) id) i)))
      (for i (.. 0 MOBS) (block
        (= (. (index (. d mobs) i) id) i)
        (= (. (index (. d mobs) i) seed) (* (call f32 i) (float 0x3feccccccccccccd)))
        (= (. (index (. d mobs) i) maxHp) (+ 40 (* (% i 3) 20)))
        (= (. (index (. d mobs) i) hp) (. (index (. d mobs) i) maxHp))
        (= (. (index (. d mobs) i) lvl) (+ 2 (% i 5)))))
      (expr (call (. d place)))
      (return d)))
    (fn (doc "Uniform int in 0..n.") roll (params (this (ref Demo)) (n int)) int (block
      (= (. this rng) (% (+ (* (. this rng) 1103515245) 12345) 2147483648))
      (return (% (/ (. this rng) 65536) n))))
    (fn (doc "Move the world on by the frames since the last call (call it once per frame; repeats are ignored).") step (params (this (ref Demo))) _ (block
      (let f _ (call frameCount))
      (if (== f (. this last)) (block
        (return)))
      (let n _ (if-expr (< (. this last) 0) 0 (- f (. this last))))
      (= (. this last) f)
      (if (> n 6) (block
        (= n 6)))
      (for k (.. 0 n) (block
        (expr (call (. this tick) DT))))
      (expr (call (. this place)))))
    (fn tick (params (this (ref Demo)) (dt f32)) _ (block
      (+= (. this t) dt)
      (expr (call (. (. this toasts) tick) (* (. this t) (float 0x408f400000000000))))
      (for s (.. 0 SKILLS) (block
        (= (index (. this cd) s) (if-expr (> (index (. this cd) s) dt) (- (index (. this cd) s) dt) (float 0x0000000000000000)))))
      (+= (. this regen) dt)
      (if (>= (. this regen) (float 0x3fb999999999999a)) (block
        (-= (. this regen) (float 0x3fb999999999999a))
        (= (. this mana) (if-expr (< (. this mana) (. this manaMax)) (+ (. this mana) 1) (. this manaMax)))
        (= (. this stam) (if-expr (< (. this stam) (. this stamMax)) (+ (. this stam) 1) (. this stamMax)))))
      (for i (.. 0 FLOATS) (block
        (if (. (index (. this floats) i) live) (block
          (+= (. (index (. this floats) i) age) dt)
          (if (> (. (index (. this floats) i) age) (float 0x3ff4cccccccccccd)) (block
            (= (. (index (. this floats) i) live) (bool false))))))))
      (if (<= (. this hp) 0) (block
        (+= (. this deadFor) dt)
        (if (> (. this deadFor) (float 0x3ffccccccccccccd)) (block
          (= (. this deadFor) (float 0x0000000000000000))
          (= (. this hp) (. this hpMax))))))
      (if (&& (. this auto) (> (. this hp) 0)) (block
        (expr (call (. this script) dt))))))
    (fn (doc "The scripted fight: hits on mobs, hits on the player, skills used when ready.") script (params (this (ref Demo)) (dt f32)) _ (block
      (+= (. this tHit) dt)
      (+= (. this tHurt) dt)
      (+= (. this tCast) dt)
      (if (> (. this tHit) (float 0x3feb333333333333)) (block
        (= (. this tHit) (float 0x0000000000000000))
        (expr (call (. this hitMob) (call (. this roll) MOBS) (+ 4 (call (. this roll) 20)) (== (call (. this roll) 5) 0)))))
      (if (> (. this tHurt) (float 0x4003333333333333)) (block
        (= (. this tHurt) (float 0x0000000000000000))
        (expr (call (. this hurt) (+ 5 (call (. this roll) 14))))
        (= (. this stam) (if-expr (> (. this stam) 12) (- (. this stam) 12) 0))))
      (if (> (. this tCast) (float 0x3fe6666666666666)) (block
        (= (. this tCast) (float 0x0000000000000000))
        (expr (call (. this cast) (call (. this roll) SKILLS)))))))
    (fn (doc "Positions: the player walks a circle, the mobs wander; then project the mobs to the view.") place (params (this (ref Demo))) _ (block
      (let a _ (* (. this t) (float 0x3fd6666666666666)))
      (= (. this px) (* (float 0x4024000000000000) (call cos a)))
      (= (. this pz) (* (float 0x4024000000000000) (call sin a)))
      (= (. this yaw) (+ (+ (+ (- (float 0x0000000000000000) a) (float 0x400921f9f01b866e)) (* (float 0x3fe0000000000000) (call sin (* (. this t) (float 0x3fe3333333333333))))) (float 0x3ff3333333333333)))
      (for i (.. 0 MOBS) (block
        (let ring _ (+ (float 0x4018000000000000) (* (call f32 (% i 4)) (float 0x4012000000000000))))
        (let w _ (+ (* (. this t) (+ (float 0x3fbeb851eb851eb8) (* (call f32 (% i 3)) (float 0x3fa999999999999a)))) (* (. (index (. this mobs) i) seed) (float 0x4000000000000000))))
        (= (. (index (. this mobs) i) x) (* ring (call cos (+ w (call f32 i)))))
        (= (. (index (. this mobs) i) z) (* ring (call sin (+ w (call f32 i)))))
        (let p _ (call (. gameworld project) (. this px) (. this pz) (. this yaw) (. (index (. this mobs) i) x) (. (index (. this mobs) i) z) (float 0x4002666666666666)))
        (= (. (index (. this mobs) i) sx) (. p x))
        (= (. (index (. this mobs) i) sy) (. p y))
        (= (. (index (. this mobs) i) depth) (. p depth))
        (= (. (index (. this mobs) i) shown) (&& (. p shown) (> (. (index (. this mobs) i) hp) 0)))))))
    (fn hurt (params (this (ref Demo)) (n int)) _ (block
      (= (. this hp) (if-expr (> (. this hp) n) (- (. this hp) n) 0))
      (expr (call (. this spawn) NO_MOB n 0))))
    (fn heal (params (this (ref Demo)) (n int)) _ (block
      (if (<= (. this hp) 0) (block
        (return)))
      (let before _ (. this hp))
      (= (. this hp) (if-expr (< (+ (. this hp) n) (. this hpMax)) (+ (. this hp) n) (. this hpMax)))
      (expr (call (. this spawn) NO_MOB (- (. this hp) before) 2))))
    (fn spend (params (this (ref Demo)) (mana int) (stam int)) _ (block
      (= (. this mana) (if-expr (> (. this mana) mana) (- (. this mana) mana) 0))
      (= (. this stam) (if-expr (> (. this stam) stam) (- (. this stam) stam) 0))))
    (fn hitMob (params (this (ref Demo)) (i int) (dmg int) (crit bool)) _ (block
      (if (<= (. (index (. this mobs) i) hp) 0) (block
        (return)))
      (let d _ (if-expr crit (* dmg 2) dmg))
      (= (. (index (. this mobs) i) hp) (if-expr (> (. (index (. this mobs) i) hp) d) (- (. (index (. this mobs) i) hp) d) 0))
      (expr (call (. this spawn) i d (if-expr crit 1 3)))
      (if (== (. (index (. this mobs) i) hp) 0) (block
        (expr (call (. this onKill) i))))))
    (fn onKill (params (this (ref Demo)) (i int)) _ (block
      (+= (. this kills) 1)
      (= (. (index (. this mobs) i) hp) (. (index (. this mobs) i) maxHp))
      (+= (. (index (. this mobs) i) seed) (float 0x4000cccccccccccd))
      (if (. this questOn) (block
        (let goal _ (call (. dialogue questGoal) 0))
        (let done _ (>= (. this kills) goal))
        (expr (call (. this quest) 0 (if-expr done 2 1)))
        (if done (block
          (= (. this kills) 0)
          (= (. this questOn) (bool false))))))))
    (fn (doc "Cast skill `s` if it is ready and affordable: a strong hit on the nearest mob in view.") cast (params (this (ref Demo)) (s int)) _ (block
      (if (|| (|| (> (index (. this cd) s) (float 0x0000000000000000)) (< (. this mana) (index (. this cost) s))) (<= (. this hp) 0)) (block
        (return)))
      (expr (call (. this spend) (index (. this cost) s) 0))
      (= (index (. this cd) s) (index (. this cdTotal) s))
      (let best _ NO_MOB)
      (for i (.. 0 MOBS) (block
        (if (&& (. (index (. this mobs) i) shown) (|| (== best NO_MOB) (< (. (index (. this mobs) i) depth) (. (index (. this mobs) best) depth)))) (block
          (= best i)))))
      (if (!= best NO_MOB) (block
        (expr (call (. this hitMob) best (+ 14 (* s 9)) (== s 3)))))))
    (fn (doc "A damage number. `mob` is the mob it floats over, or -1 for the player. `kind`: 0 hurt, 1 crit, 2 heal, 3 hit.\nWith the pool full the oldest number is replaced.") spawn (params (this (ref Demo)) (mob int) (amount int) (kind int)) _ (block
      (let slot _ 0)
      (let oldest f32 (- (float 0x3ff0000000000000)))
      (let free _ (bool false))
      (for i (.. 0 FLOATS) (block
        (if (&& (! free) (! (. (index (. this floats) i) live))) (block
          (= slot i)
          (= free (bool true))) (block
          (if (&& (! free) (> (. (index (. this floats) i) age) oldest)) (block
            (= oldest (. (index (. this floats) i) age))
            (= slot i)))))))
      (= (. (index (. this floats) slot) live) (bool true))
      (= (. (index (. this floats) slot) age) (float 0x0000000000000000))
      (= (. (index (. this floats) slot) mob) mob)
      (= (. (index (. this floats) slot) amt) amount)
      (= (. (index (. this floats) slot) kind) kind)
      (= (. (index (. this floats) slot) jit) (- (call f32 (call (. this roll) 41)) (float 0x4034000000000000)))))
    (fn (doc "A quest toast. `status`: 0 started, 1 progress, 2 complete.") quest (params (this (ref Demo)) (q int) (status int)) _ (block
      (for i (.. 0 (. (. this toasts) cap)) (block
        (if (&& (call (. (. this toasts) live) i) (== (/ (call (. (. this toasts) kind) i) 3) q)) (block
          (expr (call (. (. this toasts) dismiss) i))))))
      (expr (call (. (. this toasts) push) (call (. dialogue quest) q) (+ (* q 3) status) (float 0x40b3880000000000) (* (. this t) (float 0x408f400000000000))))))
    (fn acceptQuest (params (this (ref Demo))) _ (block
      (= (. this questOn) (bool true))
      (= (. this kills) 0)
      (expr (call (. this quest) 0 0))))
    (fn clickSlot (params (this (ref Demo)) (i int)) _ (block
      (if (&& (>= (. this sel) 0) (!= (. this sel) i)) (block
        (let k _ (index (. this kind) (. this sel)))
        (let r _ (index (. this rarity) (. this sel)))
        (let c _ (index (. this count) (. this sel)))
        (= (index (. this kind) (. this sel)) (index (. this kind) i))
        (= (index (. this rarity) (. this sel)) (index (. this rarity) i))
        (= (index (. this count) (. this sel)) (index (. this count) i))
        (= (index (. this kind) i) k)
        (= (index (. this rarity) i) r)
        (= (index (. this count) i) c)
        (= (. this sel) (- 1))) (block
        (= (. this sel) (if-expr (== (. this sel) i) (- 1) i))))))
    (fn (doc "Seconds the current line has been typing.") typed (params (this (ref Demo))) f32 (block
      (return (- (. this t) (. this dlgT0)))))
    (fn lineDone (params (this (ref Demo))) bool (block
      (let line _ (call (. dialogue text) (. this dlgLine)))
      (return (>= (* (call (. this typed)) (float 0x4041000000000000)) (call f32 (. line len))))))
    (fn (doc "Click: finish the line at once, or go to the next one (the last line waits for an answer).") advance (params (this (ref Demo))) _ (block
      (if (! (call (. this lineDone))) (block
        (= (. this dlgT0) (- (. this t) (float 0x408f400000000000)))) (block
        (if (< (. this dlgLine) (- (. dialogue LINES) 1)) (block
          (+= (. this dlgLine) 1)
          (= (. this dlgT0) (. this t))))))))
    (fn answer (params (this (ref Demo)) (yes bool)) _ (block
      (if yes (block
        (expr (call (. this acceptQuest)))))
      (= (. this dlgLine) 0)
      (= (. this dlgT0) (. this t)))))
  (mod-let SHARED Demo _)
  (mod-let STARTED bool _)
  (fn (doc "The one demo state. The page may be mounted many times; the state (and its memory) is made once, so\nleaving the page and coming back keeps the fight going instead of allocating again.") pub shared (params) (ref Demo) (block
    (if (! STARTED) (block
      (= SHARED (call (. Demo new)))
      (= STARTED (bool true))))
    (return (& SHARED)))))
--- stderr
--- exit 0
