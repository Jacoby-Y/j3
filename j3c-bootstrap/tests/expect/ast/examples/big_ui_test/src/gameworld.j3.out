(file (module big_ui_test gameworld)
  (use j3.math (names cos sin))
  (const pub VIEW_W f32 (float 0x4081800000000000))
  (const pub VIEW_H f32 (float 0x4074a00000000000))
  (const EYE f32 (float 0x3ff999999999999a))
  (const NEAR f32 (float 0x3fe3333333333333))
  (const FAR f32 (float 0x4041000000000000))
  (struct pub Proj
    (field x f32)
    (field y f32)
    (field depth f32)
    (field shown bool))
  (fn pub horizon (params) f32 (block
    (return (* VIEW_H (float 0x3fdae147ae147ae1)))))
  (fn (doc "Where world point (`wx`, `h` up, `wz`) lands for a camera at (`px`, `pz`) looking along `yaw`\n(90 degree field of view). `shown` is false behind the camera, past the far plane or off screen.") pub project (params (px f32) (pz f32) (yaw f32) (wx f32) (wz f32) (h f32)) Proj (block
    (let dx _ (- wx px))
    (let dz _ (- wz pz))
    (let depth _ (+ (* dx (call sin yaw)) (* dz (call cos yaw))))
    (let side _ (- (* dx (call cos yaw)) (* dz (call sin yaw))))
    (if (|| (< depth NEAR) (> depth FAR)) (block
      (return (struct-lit Proj (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000)) (field depth depth) (field shown (bool false))))))
    (let focal _ (* VIEW_W (float 0x3fe0000000000000)))
    (let x _ (+ (* VIEW_W (float 0x3fe0000000000000)) (* (/ side depth) focal)))
    (let y _ (+ (call horizon) (* (/ (- EYE h) depth) focal)))
    (let on _ (&& (&& (&& (> x (- (float 0x403e000000000000))) (< x (+ VIEW_W (float 0x403e000000000000)))) (> y (- (float 0x403e000000000000)))) (< y (+ VIEW_H (float 0x403e000000000000)))))
    (return (struct-lit Proj (field x x) (field y y) (field depth depth) (field shown on)))))
  (fn (doc "0 near, 1 middle, 2 far: which nameplate size to use.") pub tier (params (depth f32)) int (block
    (if (< depth (float 0x4022000000000000)) (block
      (return 0)))
    (if (< depth (float 0x4032000000000000)) (block
      (return 1)))
    (return 2)))
  (fn (doc "A point of the minimap: world (`wx`, `wz`) relative to the player, rotated so the view points up.") pub mapPoint (params (px f32) (pz f32) (yaw f32) (wx f32) (wz f32)) Proj (block
    (let dx _ (- wx px))
    (let dz _ (- wz pz))
    (let depth _ (+ (* dx (call sin yaw)) (* dz (call cos yaw))))
    (let side _ (- (* dx (call cos yaw)) (* dz (call sin yaw))))
    (return (struct-lit Proj (field x side) (field y (- (float 0x0000000000000000) depth)) (field depth depth) (field shown (bool true)))))))
