(file (module big_ui_test postpaint)
  (use j3.game (names frameCount rgb))
  (use j3.gfx.paint)
  (use j3.gfx.paint.Effects)
  (use j3.math.Vec2)
  (mod-let BOARD int _)
  (mod-let SHADER int _)
  (fn prepare (params) _ (block
    (if (!= BOARD 0) (block
      (return)))
    (= BOARD (call (. paint target) 320 200))
    (= SHADER (call (. paint shader) "vec4 effect(vec2 uv, vec4 color) { float bands = 0.8 + 0.2 * sin(uv.x * 70.0 + uTime); return vec4(mix(color.rgb, color.bgr, 0.7) * bands, color.a); }"))
    (expr (call (. paint beginTarget) BOARD))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x 320) (field y 200)) (call rgb 20 35 58)))
    (for i (.. 0 8) (block
      (expr (call (. paint rect) (struct-lit Vec2 (field x (* (call f32 i) 40)) (field y 0)) (struct-lit Vec2 (field x 18) (field y 200)) (call rgb 35 93 115)))))
    (expr (call (. paint circle) (struct-lit Vec2 (field x 246) (field y 56)) 46 (call rgb 255 197 104)))
    (expr (call (. paint roundRect) (struct-lit Vec2 (field x 30) (field y 38)) (struct-lit Vec2 (field x 180) (field y 124)) 18 (call rgb 98 200 198)))
    (expr (call (. paint roundRect) (struct-lit Vec2 (field x 42) (field y 50)) (struct-lit Vec2 (field x 156) (field y 100)) 10 (call rgb 20 35 58)))
    (for i (.. 0 4) (block
      (expr (call (. paint line) (struct-lit Vec2 (field x 54) (field y (+ 68 (* (call f32 i) 22)))) (struct-lit Vec2 (field x 172) (field y (+ 68 (* (call f32 i) 22)))) 5 (call rgb 238 246 255)))))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 0) (field y 174)) (struct-lit Vec2 (field x 320) (field y 8)) (call rgb 255 118 152)))
    (expr (call (. paint endTarget)))))
  (fn (doc "The texture and shader are cached; the renderer releases both when the GL context closes.") pub draw (params (size Vec2) (custom bool) (tilt bool)) _ (block
    (expr (call prepare))
    (expr (call (. paint rect) (struct-lit Vec2 (field x 0) (field y 0)) size (call rgb 15 22 36)))
    (let width _ (* (- (. size x) 60) (float 0x3fe0000000000000)))
    (let height _ (* width (float 0x3fe4000000000000)))
    (if (> height (- (. size y) 60)) (block
      (= height (- (. size y) 60))
      (= width (* height (float 0x3ff999999999999a)))))
    (let imageSize _ (struct-lit Vec2 (field x width) (field y height)))
    (let left _ (struct-lit Vec2 (field x 20) (field y (* (- (. size y) height) (float 0x3fe0000000000000)))))
    (let right _ (struct-lit Vec2 (field x (+ (* (. size x) (float 0x3fe0000000000000)) 10)) (field y (. left y))))
    (let tex _ (call (. paint targetTexture) BOARD))
    (expr (call (. paint projectTexture) tex left imageSize 0 0 0))
    (expr (call (. paint beginLayer)))
    (expr (call (. paint projectTexture) tex right imageSize (if-expr tilt (float 0x4028000000000000) (float 0x0000000000000000)) (if-expr tilt (- (float 0x403c000000000000)) (float 0x0000000000000000)) 600))
    (let fx _ (struct-lit Effects))
    (if custom (block
      (= (. fx shader) SHADER)))
    (= (. fx time) (/ (call f32 (call frameCount)) 60))
    (expr (call (. paint endLayer) right imageSize fx)))))
--- stderr
--- exit 0
