(file (module big_ui_test page)
  (use j3.game.env)
  (use j3.math.Vec2)
  (fn (doc "The page to open first: `UI_PAGE=<number>` (0-based; headless screenshots of one page), else 0.") pub startPage (params) int (block
    (let e _ (call env "UI_PAGE"))
    (let v _ 0)
    (for i (.. 0 (. e len)) (block
      (if (&& (>= (call int (index e i)) 48) (< (call int (index e i)) 58)) (block
        (= v (- (+ (* v 10) (call int (index e i))) 48))))))
    (if (> v 18) (block
      (return 18)))
    (return v)))
  (fn (doc "The window size: `UI_SIZE=<w>x<h>` (headless screenshots at another size, to see `@media`), else 1100 by 700.") pub startSize (params) Vec2 (block
    (let e _ (call env "UI_SIZE"))
    (let v _ (array-lit 0 0))
    (let k _ 0)
    (for i (.. 0 (. e len)) (block
      (if (&& (>= (call int (index e i)) 48) (< (call int (index e i)) 58)) (block
        (= (index v k) (- (+ (* (index v k) 10) (call int (index e i))) 48))) (block
        (if (== k 0) (block
          (= k 1)))))))
    (if (|| (< (index v 0) 200) (< (index v 1) 200)) (block
      (return (struct-lit Vec2 (field x (float 0x4091300000000000)) (field y (float 0x4085e00000000000))))))
    (return (struct-lit Vec2 (field x (call f32 (index v 0))) (field y (call f32 (index v 1)))))))
  (fn (doc "`UI_VIRTUAL=<w>x<h>` draws at that virtual size, letterboxed in the window (`game.setVirtualSize`); else off.") pub startVirtual (params) Vec2 (block
    (let e _ (call env "UI_VIRTUAL"))
    (let v _ (array-lit 0 0))
    (let k _ 0)
    (for i (.. 0 (. e len)) (block
      (if (&& (>= (call int (index e i)) 48) (< (call int (index e i)) 58)) (block
        (= (index v k) (- (+ (* (index v k) 10) (call int (index e i))) 48))) (block
        (if (== k 0) (block
          (= k 1)))))))
    (return (struct-lit Vec2 (field x (call f32 (index v 0))) (field y (call f32 (index v 1))))))))
--- stderr
--- exit 0
