(file (module big_ui_test)
  (use big_ui_test.page (names startSize startVirtual))
  (use big_ui_test.sim)
  (use big_ui_test.ui (names Shell ShellProps))
  (use j3.app.App)
  (use j3.game (names setVirtualSize windowSize))
  (use j3.memory.Arena)
  (struct World
    (field root Shell))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field root (call (. Shell new) mem))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. sim apply) (& (. (. w root) dom))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ShellProps)))))
  (fn main (params) _ (block
    (let size _ (call startSize))
    (let app _ (call (. (type-path App World) create) "big_ui_test" (call int (. size x)) (call int (. size y)) boot))
    (let virt _ (call startVirtual))
    (expr (call setVirtualSize (call int (. virt x)) (call int (. virt y))))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
