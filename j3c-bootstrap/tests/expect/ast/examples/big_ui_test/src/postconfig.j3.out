(file (module big_ui_test postconfig)
  (use j3.game.env)
  (fn (doc "Deterministic initial state for headless Post Effects captures.") pub digit (params (key string) (fallback int) (max int)) int (block
    (let e _ (call env key))
    (if (&& (&& (> (. e len) 0) (>= (index e 0) 48)) (<= (call int (index e 0)) (+ 48 max))) (block
      (return (- (call int (index e 0)) 48))))
    (return fallback)))
  (fn pub option (params (key string) (fallback string)) string (block
    (let e _ (call env key))
    (return (if-expr (> (. e len) 0) e fallback)))))
--- stderr
--- exit 0
