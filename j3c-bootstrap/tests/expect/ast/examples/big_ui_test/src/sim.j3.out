(file (module big_ui_test sim)
  (use j3.game (names env setWindowSize))
  (use j3.ui.dom.Dom)
  (mod-let MX f32 _)
  (mod-let MY f32 _)
  (mod-let MDOWN bool _)
  (mod-let MRIGHT bool _)
  (mod-let STARTED bool _)
  (fn digit (params (c u8)) bool (block
    (return (&& (>= c 48) (< c 58)))))
  (fn (doc "The unsigned number at `s[i..]` (0 when there is none); `at` is set past it.") number (params (s string) (i int) (at (ref int))) int (block
    (let v _ 0)
    (let k _ i)
    (while (&& (< k (. s len)) (call digit (index s k))) (block
      (= v (- (+ (* v 10) (call int (index s k))) 48))
      (+= k 1)))
    (= (* at) k)
    (return v)))
  (fn (doc "Headless input for screenshots. `UI_MOUSE=x,y[,1]` hovers there, `1` also holds the button from\nframe 6 to 8 (a click). `UI_SIM=\"6:m=300,200,0;8:m=300,200,1;10:m=300,200,0;14:t=hello;16:k=S+Left C+a\"`\nis a script: at frame N, `m=x,y,down` moves the mouse (it stays; `down` is 0 up, 1 left button,\n2 right button), `w=n` turns the wheel `n` notches down once (negative: up; `Shift` with `k=` for\nsideways), `s=w,h` resizes the window, `t=text` types, `k=names` presses keys (`j3.ui.keys.parse`) once. Entries are\nseparated by `;`.") pub apply (params (d (ref Dom))) _ (block
    (if (! STARTED) (block
      (= STARTED (bool true))
      (= MX (- (float 0x4014000000000000)))
      (= MY (- (float 0x4014000000000000)))))
    (let m _ (call env "UI_MOUSE"))
    (if (> (. m len) 0) (block
      (let at _ 0)
      (= MX (call f32 (call number m 0 (& at))))
      (= MY (call f32 (call number m (+ at 1) (& at))))
      (= MDOWN (&& (&& (&& (< at (. m len)) (== (call number m (+ at 1) (& at)) 1)) (>= (. d frame) 6)) (< (. d frame) 9)))
      (expr (call (. d simInput) MX MY MDOWN (float 0x0000000000000000)))
      (return)))
    (let e _ (call env "UI_SIM"))
    (if (== (. e len) 0) (block
      (return)))
    (let typed _ "")
    (let names _ "")
    (let wheel f32 (float 0x0000000000000000))
    (let i _ 0)
    (while (< i (. e len)) (block
      (let q _ 0)
      (let n _ (call number e i (& q)))
      (let kind _ (index e (+ q 1)))
      (let start _ (+ q 3))
      (= i start)
      (while (&& (< i (. e len)) (!= (index e i) 59)) (block
        (+= i 1)))
      (let val _ (slice-expr e start i))
      (+= i 1)
      (if (== n (+ (. d frame) 1)) (block
        (if (== kind 109) (block
          (let p _ 0)
          (= MX (call f32 (call number val 0 (& p))))
          (= MY (call f32 (call number val (+ p 1) (& p))))
          (let btn _ (call number val (+ p 1) (& p)))
          (= MDOWN (== btn 1))
          (= MRIGHT (== btn 2))) (block
          (if (== kind 119) (block
            (let neg _ (&& (> (. val len) 0) (== (index val 0) 45)))
            (let wat _ 0)
            (let notches _ (call f32 (call number val (if-expr neg 1 0) (& wat))))
            (= wheel (if-expr neg notches (- (float 0x0000000000000000) notches)))) (block
            (if (== kind 115) (block
              (let sp _ 0)
              (let sw _ (call number val 0 (& sp)))
              (expr (call setWindowSize sw (call number val (+ sp 1) (& sp))))) (block
              (if (== kind 116) (block
                (= typed val)) (block
                (if (== kind 107) (block
                  (= names val)))))))))))))))
    (expr (call (. d simRight) MRIGHT))
    (expr (call (. d simInput) MX MY MDOWN wheel))
    (if (|| (> (. typed len) 0) (> (. names len) 0)) (block
      (expr (call (. d simKeys) typed names)))))))
--- stderr
--- exit 0
