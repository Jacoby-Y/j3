(file (module big_ui_test items)
  (const pub KINDS int 12)
  (const pub RARITIES int 5)
  (fn pub glyph (params (kind int)) string (block
    (let t (array 12 string) (array-lit "\xf0\x9f\x97\xa1" "\xf0\x9f\x9b\xa1" "\xe2\x9d\xa4" "\xe2\x9a\xa1" "\xf0\x9f\xaa\x99" "\xf0\x9f\x92\xa3" "\xf0\x9f\x97\x9d" "\xe2\xad\x90" "\xe2\x98\xa0" "\xf0\x9f\x8f\x86" "\xf0\x9f\x92\xb0" "\xf0\x9f\x91\x8d"))
    (return (index t kind))))
  (fn pub name (params (kind int)) string (block
    (let t (array 12 string) (array-lit "Iron Sword" "Oak Shield" "Healing Draught" "Storm Charm" "Gold Coins" "Bomb" "Rusty Key" "Star Shard" "Cursed Skull" "Champion Cup" "Treasure Bag" "Lucky Glove"))
    (return (index t kind))))
  (fn pub desc (params (kind int)) string (block
    (let t (array 12 string) (array-lit "A plain blade. Reliable." "Blocks the first hit." "Restores 40 health." "Crackles when you run." "Spend them wisely." "Handle with care." "Opens something old." "Hums with light." "Whispers at night." "Proof of victory." "Heavy and clinking." "Better odds, maybe."))
    (return (index t kind))))
  (fn pub rarityName (params (r int)) string (block
    (let t (array 5 string) (array-lit "Common" "Uncommon" "Rare" "Epic" "Legendary"))
    (return (index t r))))
  (fn (doc "A cheap deterministic hash, so the demo inventory is the same every run.") pub hash (params (i int)) int (block
    (let h _ (% (+ (* i 2654435761) 12345) 1000003))
    (if (< h 0) (block
      (= h (- 0 h))))
    (return h)))
  (fn (doc "Kind stored in slot `i`, or -1 for an empty slot.") pub kindAt (params (i int)) int (block
    (let h _ (call hash i))
    (if (== (% h 4) 0) (block
      (return (- 1))))
    (return (% (/ h 7) KINDS))))
  (fn (doc "Rarity (0..4) of slot `i`: mostly common, legendary is rare.") pub rarityAt (params (i int)) int (block
    (let r _ (% (call hash (+ i 91)) 20))
    (if (< r 9) (block
      (return 0)))
    (if (< r 14) (block
      (return 1)))
    (if (< r 17) (block
      (return 2)))
    (if (< r 19) (block
      (return 3)))
    (return 4)))
  (fn pub countAt (params (i int)) int (block
    (let k _ (call kindAt i))
    (if (|| (== k 4) (== k 5)) (block
      (return (+ 1 (% (call hash (+ i 5)) 40)))))
    (return 1))))
