(file (module big_ui_test gameart)
  (use big_ui_test.gamedemo (names Demo MOBS))
  (use big_ui_test.gameworld)
  (use j3.game (names Color rgb rgba))
  (use j3.gfx.paint)
  (use j3.math (names cos min sin PI TAU Vec2))
  (mod-let PTS (array 160 f32) _)
  (fn put (params (k int) (x f32) (y f32)) _ (block
    (= (index PTS (* 2 k)) x)
    (= (index PTS (+ (* 2 k) 1)) y)))
  (fn (doc "A pie slice of `frac` (0..1) of a circle, clockwise from the top: the cooldown \"clock wipe\".") pub pie (params (c Vec2) (r f32) (frac f32) (color Color)) _ (block
    (if (<= frac (float 0x0000000000000000)) (block
      (return)))
    (let f _ (call min frac (float 0x3ff0000000000000)))
    (let steps _ 48)
    (expr (call put 0 (. c x) (. c y)))
    (for k (..= 0 steps) (block
      (let a _ (+ (- (float 0x0000000000000000) (* PI (float 0x3fe0000000000000))) (/ (* (* TAU f) (call f32 k)) (call f32 steps))))
      (expr (call put (+ k 1) (+ (. c x) (* r (call cos a))) (+ (. c y) (* r (call sin a)))))))
    (expr (call put (+ steps 2) (. c x) (. c y)))
    (expr (call (. paint fillShape) (slice-expr PTS 0 160) (+ steps 3) (bool false) color))))
  (fn poly4 (params (a Vec2) (b Vec2) (c Vec2) (d Vec2) (color Color)) _ (block
    (expr (call put 0 (. a x) (. a y)))
    (expr (call put 1 (. b x) (. b y)))
    (expr (call put 2 (. c x) (. c y)))
    (expr (call put 3 (. d x) (. d y)))
    (expr (call put 4 (. a x) (. a y)))
    (expr (call (. paint fillShape) (slice-expr PTS 0 160) 5 (bool false) color))))
  (fn (doc "Where a minimap point lands: `c` is the center, `scale` px per world unit.") mapAt (params (d (ref Demo)) (c Vec2) (scale f32) (wx f32) (wz f32)) Vec2 (block
    (let p _ (call (. gameworld mapPoint) (. d px) (. d pz) (. d yaw) wx wz))
    (return (struct-lit Vec2 (field x (+ (. c x) (* (. p x) scale))) (field y (+ (. c y) (* (. p y) scale)))))))
  (fn (doc "The minimap: a rotating map around the player, buildings, mobs (pinned to the rim when far), a view wedge.") pub minimap (params (size Vec2) (d (ref Demo))) _ (block
    (let c _ (struct-lit Vec2 (field x (* (. size x) (float 0x3fe0000000000000))) (field y (* (. size y) (float 0x3fe0000000000000)))))
    (let r _ (- (* (. size x) (float 0x3fe0000000000000)) (float 0x4000000000000000)))
    (let scale _ (/ r (float 0x4030000000000000)))
    (expr (call (. paint circle) c r (call rgb 24 36 30)))
    (expr (call (. paint ring) c (* r (float 0x3fe0000000000000)) (float 0x3ff0000000000000) (call rgba 255 255 255 26)))
    (expr (call (. paint ring) c (* r (float 0x3fef0a3d70a3d70a)) (float 0x3ff0000000000000) (call rgba 255 255 255 40)))
    (for b (.. 0 3) (block
      (let bx _ (* (call f32 (- b 1)) (float 0x4028000000000000)))
      (let bz _ (+ (* (call f32 (- (% (* b 5) 3) 1)) (float 0x4022000000000000)) (float 0x4010000000000000)))
      (let h f32 (float 0x4000000000000000))
      (expr (call poly4 (call mapAt d c scale (- bx h) (- bz h)) (call mapAt d c scale (+ bx h) (- bz h)) (call mapAt d c scale (+ bx h) (+ bz h)) (call mapAt d c scale (- bx h) (+ bz h)) (call rgb 73 80 102)))))
    (expr (call put 0 (. c x) (. c y)))
    (expr (call put 1 (- (. c x) (* r (float 0x3feccccccccccccd))) (- (. c y) (* r (float 0x3feccccccccccccd)))))
    (expr (call put 2 (+ (. c x) (* r (float 0x3feccccccccccccd))) (- (. c y) (* r (float 0x3feccccccccccccd)))))
    (expr (call put 3 (. c x) (. c y)))
    (expr (call (. paint fillShape) (slice-expr PTS 0 160) 4 (bool false) (call rgba 137 180 250 40)))
    (for i (.. 0 MOBS) (block
      (if (<= (. (index (. d mobs) i) hp) 0) (block
        (continue)))
      (let p _ (call mapAt d c scale (. (index (. d mobs) i) x) (. (index (. d mobs) i) z)))
      (let off _ (struct-lit Vec2 (field x (- (. p x) (. c x))) (field y (- (. p y) (. c y)))))
      (let len _ (call (. off length)))
      (let far _ (> len (- r (float 0x4014000000000000))))
      (let q _ (if-expr far (struct-lit Vec2 (field x (+ (. c x) (* (/ (. off x) len) (- r (float 0x4014000000000000))))) (field y (+ (. c y) (* (/ (. off y) len) (- r (float 0x4014000000000000)))))) p))
      (expr (call (. paint circle) q (if-expr far (float 0x4000000000000000) (float 0x4008000000000000)) (if-expr far (call rgba 243 139 168 140) (call rgb 243 139 168))))))
    (expr (call put 0 (. c x) (- (. c y) (float 0x4018000000000000))))
    (expr (call put 1 (+ (. c x) (float 0x4012000000000000)) (+ (. c y) (float 0x4014000000000000))))
    (expr (call put 2 (. c x) (+ (. c y) (float 0x4004000000000000))))
    (expr (call put 3 (- (. c x) (float 0x4012000000000000)) (+ (. c y) (float 0x4014000000000000))))
    (expr (call put 4 (. c x) (- (. c y) (float 0x4018000000000000))))
    (expr (call (. paint fillShape) (slice-expr PTS 0 160) 5 (bool false) (call rgb 249 226 175)))))
  (fn (doc "The 3D-ish backdrop: sky, ground, stripes sliding past, and the mobs as blobs (far to near).") pub backdrop (params (size Vec2) (d (ref Demo))) _ (block
    (let hz _ (call (. gameworld horizon)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (float 0x0000000000000000))) (struct-lit Vec2 (field x (. size x)) (field y hz)) (call rgb 30 34 60)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y (* hz (float 0x3fe3333333333333)))) (struct-lit Vec2 (field x (. size x)) (field y (* hz (float 0x3fd999999999999a)))) (call rgb 48 52 86)))
    (expr (call (. paint rect) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y hz)) (struct-lit Vec2 (field x (. size x)) (field y (- (. size y) hz))) (call rgb 30 46 40)))
    (let focal _ (* (. size x) (float 0x3fe0000000000000)))
    (let travel _ (* (. d t) (float 0x400c000000000000)))
    (for k (.. 0 9) (block
      (let depth _ (- (+ (float 0x3ff3333333333333) (* (call f32 k) (float 0x400c000000000000))) (% travel (float 0x400c000000000000))))
      (if (> depth (float 0x3fe999999999999a)) (block
        (let y _ (+ hz (* (/ (float 0x3ff999999999999a) depth) focal)))
        (if (< y (. size y)) (block
          (expr (call (. paint rect) (struct-lit Vec2 (field x (float 0x0000000000000000)) (field y y)) (struct-lit Vec2 (field x (. size x)) (field y (float 0x3ff0000000000000))) (call rgba 255 255 255 18)))))))))
    (for t (.. 0 3) (block
      (let tierNow _ (- 2 t))
      (for i (.. 0 MOBS) (block
        (if (&& (. (index (. d mobs) i) shown) (== (call (. gameworld tier) (. (index (. d mobs) i) depth)) tierNow)) (block
          (expr (call blob d i focal hz))))))))))
  (fn blob (params (d (ref Demo)) (i int) (focal f32) (hz f32)) _ (block
    (let z _ (. (index (. d mobs) i) depth))
    (let foot _ (+ hz (* (/ (float 0x3ff999999999999a) z) focal)))
    (let top _ (- hz (* (/ (float 0x3fc999999999999a) z) focal)))
    (let w _ (* (/ (float 0x3feccccccccccccd) z) focal))
    (let x _ (. (index (. d mobs) i) sx))
    (expr (call (. paint roundRect) (struct-lit Vec2 (field x (- x (* w (float 0x3fe6666666666666)))) (field y (- foot (* w (float 0x3fbeb851eb851eb8))))) (struct-lit Vec2 (field x (* w (float 0x3ff6666666666666))) (field y (* w (float 0x3fceb851eb851eb8)))) (* w (float 0x3fbeb851eb851eb8)) (call rgba 0 0 0 90)))
    (expr (call (. paint roundRect) (struct-lit Vec2 (field x (- x (* w (float 0x3fe0000000000000)))) (field y top)) (struct-lit Vec2 (field x w) (field y (- foot top))) (* w (float 0x3fd999999999999a)) (call rgb (+ 90 (call u8 (* (. (index (. d mobs) i) lvl) 20))) 70 90)))
    (expr (call (. paint circle) (struct-lit Vec2 (field x (- x (* w (float 0x3fc70a3d70a3d70a)))) (field y (+ top (* (- foot top) (float 0x3fd3333333333333))))) (* w (float 0x3fb1eb851eb851ec)) (call rgb 250 240 200)))
    (expr (call (. paint circle) (struct-lit Vec2 (field x (+ x (* w (float 0x3fc70a3d70a3d70a)))) (field y (+ top (* (- foot top) (float 0x3fd3333333333333))))) (* w (float 0x3fb1eb851eb851ec)) (call rgb 250 240 200))))))
--- stderr
--- exit 0
