(file (module scripted)
  (use j3.io.printLn)
  (use j3.rand.Rng)
  (const Fighter _ (script-type "scripts/fighter.j3s"))
  (const Duel _ (script-type "scripts/duel.j3s"))
  (fn main (params) _ (block
    (let rng _ (call (. Rng new) 42))
    (let ada _ (struct-lit Fighter (field name "Ada")))
    (let bo _ (struct-lit Fighter (field name "Bo") (field hp 26) (field attack 3)))
    (let cy _ (struct-lit Fighter (field name "Cy") (field attack 6)))
    (let dee _ (struct-lit Fighter (field name "Dee") (field hp 14)))
    (let first _ (struct-lit Duel (field left (& ada)) (field right (& bo)) (field label "north")))
    (let second _ (struct-lit Duel (field left (& cy)) (field right (& dee)) (field label "south")))
    (let going _ (bool true))
    (while going (block
      (let north _ (call (. first round) (call (. rng intRange) 0 12)))
      (let south _ (call (. second round) (call (. rng intRange) 0 12)))
      (= going (|| north south))))
    (expr (call (. ada report)))
    (expr (call (. bo report)))
    (expr (call (. cy report)))
    (expr (call (. dee report))))))
--- stderr
--- exit 0
