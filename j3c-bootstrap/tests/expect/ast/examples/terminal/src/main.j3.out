(file (module terminal)
  (use j3.app.App)
  (use j3.game)
  (use j3.game.Font)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.result.Result)
  (use j3.term.ansi.Parser)
  (use j3.term.ansi.feed)
  (use j3.term.grid.Grid)
  (use j3.term.pty)
  (use j3.term.pty.Pty)
  (use j3.term.view.View)
  (use j3.text.Text)
  (const READ_CHUNK _ 16384)
  (const READ_BUDGET _ 131072)
  (const SCROLLBACK _ 5000)
  (struct World
    (field mem (ref Arena))
    (field grid Grid)
    (field parser Parser)
    (field pty Pty)
    (field view View)
    (field buf (slice u8))
    (field out Text)
    (field title Text)
    (field cols int)
    (field rows int)
    (field live bool)
    (field dead bool)
    (field hold bool))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field mem mem) (field grid (call (. Grid new) mem 80 24 0)) (field parser (call (. Parser new) mem)) (field pty (index (call (. mem alloc) (targs Pty) 1) 0)) (field view (index (call (. mem alloc) (targs View) 1) 0)) (field buf (call (. mem alloc) (targs u8) READ_CHUNK)) (field out (call (. Text new) mem)) (field title (call (. Text new) mem)) (field cols 80) (field rows 24) (field live (bool false)) (field dead (bool false)) (field hold (bool false))))))
  (fn loadMono (params) Font (block
    (let f _ (call (. game tryLoadFont) "assets/mono.ttf" 16))
    (if (== (. f raw) 0) (block
      (= f (call (. game tryLoadFont) "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf" 16))))
    (if (== (. f raw) 0) (block
      (= f (call (. game tryLoadFont) "/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf" 16))))
    (return f)))
  (fn startup (params (w (ref World))) _ (block
    (let font _ (call loadMono))
    (if (== (. font raw) 0) (block
      (expr (call (. game requestQuit)))
      (return)))
    (expr (call (. game fontFallback) font (call (. game tryLoadFont) "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc" 16)))
    (expr (call (. game fontFallback) font (call (. game tryLoadFont) "/usr/share/fonts/truetype/noto/NotoSansMono-Regular.ttf" 16)))
    (= (. w view) (call (. View new) (. w mem) font))
    (let it _ (call (. game env) "TERM_ITALIC"))
    (if (> (. it len) 0) (block
      (= (. (. w view) italic) (call (. game tryLoadFont) it 16))))
    (= (. (. w view) ligatures) (> (. (call (. game env) "TERM_LIGATURES") len) 0))
    (let lh _ (call (. game env) "TERM_LINE_HEIGHT"))
    (if (> (. lh len) 0) (block
      (let pct _ 0)
      (for i (.. 0 (. lh len)) (block
        (if (&& (>= (index lh i) 48) (<= (index lh i) 57)) (block
          (= pct (+ (* pct 10) (call int (- (index lh i) 48))))))))
      (expr (call (. (. w view) setLineHeight) pct))))
    (let size _ (call (. game windowSize)))
    (= (. w cols) (call (. (. w view) colsFor) (. size x)))
    (= (. w rows) (call (. (. w view) rowsFor) (. size y)))
    (expr (call (. (. w grid) destroy)))
    (= (. w grid) (call (. Grid withLimits) (. w mem) (. w cols) (. w rows) SCROLLBACK 512 160))
    (let cmd _ (call (. game env) "TERM_CMD"))
    (let argv _ (call (. (. w mem) alloc) (targs string) (if-expr (> (. cmd len) 0) 3 1)))
    (if (> (. cmd len) 0) (block
      (= (index argv 0) "sh")
      (= (index argv 1) "-c")
      (= (index argv 2) cmd)
      (= (. w hold) (bool true))) (block
      (let sh _ (call (. game env) "SHELL"))
      (= (index argv 0) (if-expr (> (. sh len) 0) sh "/bin/sh"))))
    (let env _ (call (. (. w mem) alloc) (targs string) 2))
    (= (index env 0) "TERM=xterm-256color")
    (= (index env 1) "COLORTERM=truecolor")
    (match (call (. pty spawn) argv "" env (. w cols) (. w rows) (. w mem))
      (arm (pats (variant Result.Ok (bind p))) (block
        (= (. w pty) p)
        (expr (call (. (. w pty) resizePx) (. w cols) (. w rows) (. (. w view) cellW) (. (. w view) cellH)))
        (= (. w live) (bool true))))
      (arm (pats (variant Result.Err (bind _e))) (block
        (expr (call (. game requestQuit))))))))
  (fn frame (params (w (ref World)) (dt f32)) _ (block
    (if (! (. w live)) (block
      (return)))
    (if (! (. w dead)) (block
      (expr (call pump w))))
    (let size _ (call (. game windowSize)))
    (let c _ (call (. (. w view) colsFor) (. size x)))
    (let r _ (call (. (. w view) rowsFor) (. size y)))
    (if (&& (|| (!= c (. w cols)) (!= r (. w rows))) (! (. w dead))) (block
      (= (. w cols) c)
      (= (. w rows) r)
      (expr (call (. (. w grid) resize) c r))
      (expr (call (. (. w pty) resizePx) c r (. (. w view) cellW) (. (. w view) cellH)))))
    (if (! (. w dead)) (block
      (expr (call (. (. w out) clear)))
      (expr (call (. (. w view) input) (& (. w grid)) (& (. w out))))
      (if (> (call (. (. w out) len)) 0) (block
        (expr (call (. (. w pty) write) (. (. w out) bytes)))))
      (expr (call (. (. w pty) flush)))) (block
      (expr (call (. (. w out) clear)))
      (expr (call (. (. w view) input) (& (. w grid)) (& (. w out))))))
    (if (! (== (call (. (. (. w grid) title) str)) (call (. (. w title) str)))) (block
      (expr (call (. (. w title) clear)))
      (expr (call (. (. w title) pushStr) (call (. (. (. w grid) title) str))))
      (expr (call (. game setWindowTitle) (if-expr (> (call (. (. w title) len)) 0) (call (. (. w title) str)) "terminal")))))
    (if (&& (. w hold) (! (. w dead))) (block
      (expr (call (. game delayMs) 10))))))
  (fn (doc "Read what the child wrote (bounded), feed the grid, answer its queries, notice its exit.") pump (params (w (ref World))) _ (block
    (let total _ 0)
    (while (< total READ_BUDGET) (block
      (let got _ (call (. (. w pty) tryRead) (. w buf)))
      (if (== (. got len) 0) (block
        (break)))
      (+= total (. got len))
      (expr (call (. (. w parser) feed) got (& (. w grid))))))
    (if (> total 0) (block
      (expr (call (. (. w view) snap)))))
    (if (> (call (. (. (. w grid) reply) len)) 0) (block
      (expr (call (. (. w pty) write) (. (. (. w grid) reply) bytes)))
      (expr (call (. (. (. w grid) reply) clear)))))
    (if (. (. w pty) eof) (block
      (match (call (. (. w pty) tryWait))
        (arm (pats (variant Option.Some (bind _code))) (block
          (= (. w dead) (bool true))
          (expr (call (. (. w pty) close)))
          (if (! (. w hold)) (block
            (expr (call (. game requestQuit)))))))
        (arm (pats (variant Option.None)) (block)))))))
  (fn draw (params (w (ref World))) _ (block
    (if (! (. w live)) (block
      (return)))
    (expr (call (. (. w view) draw) (& (. w grid)) (float 0x0000000000000000) (float 0x0000000000000000)))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "terminal" 960 540 boot))
    (expr (call (. app useGl)))
    (expr (call (. app startup) startup))
    (expr (call (. app always) frame))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
