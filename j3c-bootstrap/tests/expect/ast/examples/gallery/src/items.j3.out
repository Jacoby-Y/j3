(file (module gallery items)
  (use j3.game (names drawRect rgb setColor))
  (use j3.math.Vec2)
  (const pub COBBLE int 1)
  (const pub PLANK int 2)
  (const pub DIRT int 3)
  (const pub GRASS int 4)
  (const pub LOG int 5)
  (const pub COAL int 6)
  (const pub IRON int 7)
  (const pub GOLD int 8)
  (const pub DIAMOND int 9)
  (const pub STICK int 10)
  (const pub APPLE int 11)
  (const pub BREAD int 12)
  (const pub TORCH int 13)
  (const pub PICK int 14)
  (const pub CHEST int 15)
  (const pub TABLE int 16)
  (fn pub itemName (params (kind int)) string (block
    (if (== kind COBBLE) (block
      (return "Cobblestone")))
    (if (== kind PLANK) (block
      (return "Oak Planks")))
    (if (== kind DIRT) (block
      (return "Dirt")))
    (if (== kind GRASS) (block
      (return "Grass Block")))
    (if (== kind LOG) (block
      (return "Oak Log")))
    (if (== kind COAL) (block
      (return "Coal")))
    (if (== kind IRON) (block
      (return "Iron Ingot")))
    (if (== kind GOLD) (block
      (return "Gold Ingot")))
    (if (== kind DIAMOND) (block
      (return "Diamond")))
    (if (== kind STICK) (block
      (return "Stick")))
    (if (== kind APPLE) (block
      (return "Apple")))
    (if (== kind BREAD) (block
      (return "Bread")))
    (if (== kind TORCH) (block
      (return "Torch")))
    (if (== kind PICK) (block
      (return "Wooden Pickaxe")))
    (if (== kind CHEST) (block
      (return "Chest")))
    (if (== kind TABLE) (block
      (return "Crafting Table")))
    (return "")))
  (fn (doc "Tools stack to one. Everything else stacks to 64.") pub stackCap (params (kind int)) int (block
    (if (== kind PICK) (block
      (return 1)))
    (return 64)))
  (fn blot (params (x f32) (y f32) (s int) (tx int) (ty int) (tw int) (th int)) _ (block
    (expr (call drawRect (struct-lit Vec2 (field x (+ x (call f32 (* tx s)))) (field y (+ y (call f32 (* ty s))))) (struct-lit Vec2 (field x (call f32 (* tw s))) (field y (call f32 (* th s))))))))
  (fn paintCobble (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 128 128 128)))
    (expr (call blot x y s 1 1 14 14))
    (expr (call setColor (call rgb 86 86 86)))
    (expr (call blot x y s 2 2 3 2))
    (expr (call blot x y s 8 3 4 3))
    (expr (call blot x y s 3 8 4 3))
    (expr (call blot x y s 10 10 3 3))
    (expr (call setColor (call rgb 168 168 168)))
    (expr (call blot x y s 6 2 2 2))
    (expr (call blot x y s 2 6 2 2))
    (expr (call blot x y s 9 7 3 2))
    (expr (call blot x y s 5 12 3 2))))
  (fn paintPlank (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 186 149 86)))
    (expr (call blot x y s 1 1 14 14))
    (expr (call setColor (call rgb 148 114 64)))
    (expr (call blot x y s 1 4 14 1))
    (expr (call blot x y s 1 8 14 1))
    (expr (call blot x y s 1 12 14 1))
    (expr (call setColor (call rgb 210 176 112)))
    (expr (call blot x y s 2 2 8 1))))
  (fn paintDirt (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 134 96 67)))
    (expr (call blot x y s 1 1 14 14))
    (expr (call setColor (call rgb 108 74 50)))
    (expr (call blot x y s 3 3 2 2))
    (expr (call blot x y s 9 4 3 2))
    (expr (call blot x y s 5 8 2 2))
    (expr (call blot x y s 11 10 2 2))
    (expr (call setColor (call rgb 156 116 82)))
    (expr (call blot x y s 6 5 2 2))
    (expr (call blot x y s 2 11 2 2))))
  (fn paintGrass (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 134 96 67)))
    (expr (call blot x y s 1 1 14 14))
    (expr (call setColor (call rgb 96 168 58)))
    (expr (call blot x y s 1 1 14 5))
    (expr (call setColor (call rgb 72 140 42)))
    (expr (call blot x y s 1 5 14 1))
    (expr (call blot x y s 2 6 2 2))
    (expr (call blot x y s 7 6 2 2))
    (expr (call blot x y s 12 6 2 1))
    (expr (call setColor (call rgb 128 196 72)))
    (expr (call blot x y s 3 2 4 1))))
  (fn paintLog (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 102 81 51)))
    (expr (call blot x y s 1 1 14 14))
    (expr (call setColor (call rgb 168 140 96)))
    (expr (call blot x y s 4 2 8 12))
    (expr (call setColor (call rgb 120 92 58)))
    (expr (call blot x y s 7 3 2 10))
    (expr (call setColor (call rgb 86 64 38)))
    (expr (call blot x y s 1 1 3 14))))
  (fn paintCoal (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 28 28 28)))
    (expr (call blot x y s 3 4 10 8))
    (expr (call blot x y s 4 3 7 2))
    (expr (call blot x y s 5 12 6 2))
    (expr (call setColor (call rgb 58 58 58)))
    (expr (call blot x y s 5 5 3 2))
    (expr (call setColor (call rgb 16 16 16)))
    (expr (call blot x y s 8 8 3 3))))
  (fn paintIngot (params (x f32) (y f32) (s int) (body int) (edge int)) _ (block
    (if (== body 0) (block
      (expr (call setColor (call rgb 220 220 220)))) (block
      (expr (call setColor (call rgb 236 196 58)))))
    (expr (call blot x y s 2 5 12 6))
    (expr (call blot x y s 3 4 10 1))
    (expr (call blot x y s 3 11 10 1))
    (if (== edge 0) (block
      (expr (call setColor (call rgb 160 160 160)))) (block
      (expr (call setColor (call rgb 176 128 28)))))
    (expr (call blot x y s 2 9 12 2))
    (if (== body 0) (block
      (expr (call setColor (call rgb 255 255 255)))) (block
      (expr (call setColor (call rgb 255 230 140)))))
    (expr (call blot x y s 4 6 6 1))))
  (fn paintDiamond (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 72 214 208)))
    (expr (call blot x y s 6 1 4 2))
    (expr (call blot x y s 4 3 8 2))
    (expr (call blot x y s 2 5 12 4))
    (expr (call blot x y s 4 9 8 3))
    (expr (call blot x y s 6 12 4 2))
    (expr (call setColor (call rgb 180 255 250)))
    (expr (call blot x y s 6 3 2 3))
    (expr (call setColor (call rgb 36 140 150)))
    (expr (call blot x y s 9 8 3 3))))
  (fn paintStick (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 146 110 62)))
    (expr (call blot x y s 7 1 2 14))
    (expr (call setColor (call rgb 96 70 38)))
    (expr (call blot x y s 8 1 1 14))))
  (fn paintApple (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 188 36 36)))
    (expr (call blot x y s 4 4 8 9))
    (expr (call blot x y s 3 6 10 6))
    (expr (call setColor (call rgb 140 20 20)))
    (expr (call blot x y s 5 11 6 2))
    (expr (call setColor (call rgb 92 58 28)))
    (expr (call blot x y s 7 2 2 3))
    (expr (call setColor (call rgb 64 150 40)))
    (expr (call blot x y s 9 3 3 2))
    (expr (call setColor (call rgb 255 180 180)))
    (expr (call blot x y s 5 6 2 2))))
  (fn paintBread (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 196 148 78)))
    (expr (call blot x y s 2 5 12 7))
    (expr (call blot x y s 3 4 10 1))
    (expr (call blot x y s 3 12 10 1))
    (expr (call setColor (call rgb 150 100 48)))
    (expr (call blot x y s 3 7 10 1))
    (expr (call blot x y s 3 10 10 1))
    (expr (call setColor (call rgb 220 180 110)))
    (expr (call blot x y s 4 5 6 1))))
  (fn paintTorch (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 124 92 48)))
    (expr (call blot x y s 7 7 2 8))
    (expr (call setColor (call rgb 240 160 32)))
    (expr (call blot x y s 5 3 6 4))
    (expr (call blot x y s 6 2 4 2))
    (expr (call setColor (call rgb 255 236 140)))
    (expr (call blot x y s 7 4 2 2))))
  (fn paintPick (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 146 110 62)))
    (expr (call blot x y s 3 11 2 2))
    (expr (call blot x y s 4 9 2 2))
    (expr (call blot x y s 5 7 2 2))
    (expr (call blot x y s 6 5 2 2))
    (expr (call blot x y s 7 4 2 2))
    (expr (call setColor (call rgb 168 128 72)))
    (expr (call blot x y s 6 2 3 2))
    (expr (call blot x y s 8 3 3 2))
    (expr (call blot x y s 10 4 3 2))
    (expr (call setColor (call rgb 110 78 40)))
    (expr (call blot x y s 7 3 2 1))
    (expr (call blot x y s 9 4 2 1))))
  (fn paintChest (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 158 104 40)))
    (expr (call blot x y s 2 4 12 9))
    (expr (call setColor (call rgb 196 140 64)))
    (expr (call blot x y s 2 4 12 3))
    (expr (call setColor (call rgb 110 70 28)))
    (expr (call blot x y s 2 7 12 1))
    (expr (call setColor (call rgb 212 186 64)))
    (expr (call blot x y s 7 8 2 3))))
  (fn paintTable (params (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 176 140 80)))
    (expr (call blot x y s 1 1 14 9))
    (expr (call setColor (call rgb 120 90 50)))
    (expr (call blot x y s 1 4 14 1))
    (expr (call blot x y s 1 8 14 1))
    (expr (call blot x y s 5 1 1 9))
    (expr (call blot x y s 10 1 1 9))
    (expr (call setColor (call rgb 140 100 56)))
    (expr (call blot x y s 2 10 5 4))
    (expr (call blot x y s 9 10 5 4))
    (expr (call setColor (call rgb 96 68 36)))
    (expr (call blot x y s 7 10 2 4))))
  (fn pub paintItem (params (kind int) (x f32) (y f32) (s int)) _ (block
    (if (== kind COBBLE) (block
      (expr (call paintCobble x y s))
      (return)))
    (if (== kind PLANK) (block
      (expr (call paintPlank x y s))
      (return)))
    (if (== kind DIRT) (block
      (expr (call paintDirt x y s))
      (return)))
    (if (== kind GRASS) (block
      (expr (call paintGrass x y s))
      (return)))
    (if (== kind LOG) (block
      (expr (call paintLog x y s))
      (return)))
    (if (== kind COAL) (block
      (expr (call paintCoal x y s))
      (return)))
    (if (== kind IRON) (block
      (expr (call paintIngot x y s 0 0))
      (return)))
    (if (== kind GOLD) (block
      (expr (call paintIngot x y s 1 1))
      (return)))
    (if (== kind DIAMOND) (block
      (expr (call paintDiamond x y s))
      (return)))
    (if (== kind STICK) (block
      (expr (call paintStick x y s))
      (return)))
    (if (== kind APPLE) (block
      (expr (call paintApple x y s))
      (return)))
    (if (== kind BREAD) (block
      (expr (call paintBread x y s))
      (return)))
    (if (== kind TORCH) (block
      (expr (call paintTorch x y s))
      (return)))
    (if (== kind PICK) (block
      (expr (call paintPick x y s))
      (return)))
    (if (== kind CHEST) (block
      (expr (call paintChest x y s))
      (return)))
    (if (== kind TABLE) (block
      (expr (call paintTable x y s))))))
  (fn (doc "Faint armor or offhand mark in an empty slot. `part` is 0..3 armor, 4 offhand.") pub paintGhost (params (part int) (x f32) (y f32) (s int)) _ (block
    (expr (call setColor (call rgb 64 64 64)))
    (if (== part 0) (block
      (expr (call blot x y s 4 3 8 3))
      (expr (call blot x y s 3 6 10 6))
      (expr (call blot x y s 6 6 4 2))
      (return)))
    (if (== part 1) (block
      (expr (call blot x y s 4 2 8 4))
      (expr (call blot x y s 3 6 10 8))
      (expr (call blot x y s 1 6 2 5))
      (expr (call blot x y s 13 6 2 5))
      (return)))
    (if (== part 2) (block
      (expr (call blot x y s 4 2 8 3))
      (expr (call blot x y s 4 5 3 9))
      (expr (call blot x y s 9 5 3 9))
      (return)))
    (if (== part 3) (block
      (expr (call blot x y s 2 8 5 4))
      (expr (call blot x y s 9 8 5 4))
      (expr (call blot x y s 2 11 5 2))
      (expr (call blot x y s 9 11 5 2))
      (return)))
    (expr (call blot x y s 4 3 8 10))
    (expr (call blot x y s 3 4 2 6))
    (expr (call blot x y s 11 4 2 6))
    (expr (call setColor (call rgb 90 90 90)))
    (expr (call blot x y s 7 5 2 4))))
  (fn (doc "Steve, standing in the inventory portrait. `look` is -1, 0, or 1.") pub paintSteve (params (ox f32) (oy f32) (s int) (look int)) _ (block
    (let hx _ (+ 47 look))
    (expr (call setColor (call rgb 198 158 118)))
    (expr (call blot ox oy s hx 16 8 8))
    (expr (call blot ox oy s 43 25 4 10))
    (expr (call blot ox oy s 55 25 4 10))
    (expr (call blot ox oy s 47 37 4 10))
    (expr (call blot ox oy s 51 37 4 10))
    (expr (call setColor (call rgb 56 36 22)))
    (expr (call blot ox oy s hx 16 8 3))
    (expr (call blot ox oy s hx 16 1 6))
    (expr (call blot ox oy s (+ hx 7) 16 1 6))
    (expr (call setColor (call rgb 40 60 90)))
    (expr (call blot ox oy s (+ (+ hx 2) look) 20 1 1))
    (expr (call blot ox oy s (+ (+ hx 5) look) 20 1 1))
    (expr (call setColor (call rgb 72 166 186)))
    (expr (call blot ox oy s 47 24 8 12))
    (expr (call blot ox oy s 43 24 4 4))
    (expr (call blot ox oy s 55 24 4 4))
    (expr (call setColor (call rgb 48 52 140)))
    (expr (call blot ox oy s 47 36 8 8))
    (expr (call setColor (call rgb 64 64 68)))
    (expr (call blot ox oy s 47 44 4 3))
    (expr (call blot ox oy s 51 44 4 3)))))
--- stderr
--- exit 0
