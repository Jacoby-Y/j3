(file (module gallery widgets)
  (use gallery.world (names World addClick))
  (use j3.game (names drawTextureEx rgb))
  (use j3.math.Vec2)
  (use j3.ui (names Ui dragDelta))
  (fn pub widgetsPage (params (ui (ref Ui)) (w (ref World))) _ (block
    (block
      (expr (call (. ui panel) 420 240))
      (expr (call (. ui label) "widgets"))
      (expr (call (. ui label) "Tab/Shift-Tab focus, Enter/Space click"))
      (expr (call (. ui label) (interp "clicks " (. w clicks))))
      (if (call (. ui button) "count") (block
        (expr (call addClick w))))
      (expr (call (. ui field) "name" (& (. w name))))
      (expr (call (. ui label) (call (. (. w name) str))))
      (expr (call (. ui drag) "drag"))
      (let d _ (call dragDelta))
      (if (|| (!= (. d x) 0) (!= (. d y) 0)) (block
        (expr (call (. ui label) (interp "drag " (. d x))))))
      (expr (call (. ui bar) (/ (call f32 (. w clicks)) 10)))
      (if (!= (. (. w mark) raw) 0) (block
        (let i _ (call (. (. w player) frame) (& (. w clip))))
        (let fr _ (index (. (. w clip) frames) i))
        (expr (call drawTextureEx (. w mark) (. fr src) (. fr size) (struct-lit Vec2 (field x 48) (field y 520)) (. fr size) (* (. (. w player) time) 40) 0 (call rgb 255 255 255)))))
      (if (!= (. (. w mark) raw) 0) (block
        (expr (call (. ui image) (. w mark)))))
      (expr (call (. ui end)))))))
--- stderr
--- exit 0
