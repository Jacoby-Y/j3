    (expr (call drawRect (struct-lit Vec2 (field x (+ ox (call f32 (* gx SCALE)))) (field y (+ oy (call f32 (* gy SCALE))))) (struct-lit Vec2 (field x (call f32 (* gw SCALE))) (field y (call f32 (* gh SCALE))))))))
