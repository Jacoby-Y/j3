(file (module gallery controls)
  (use gallery.world.World)
  (use j3.ui.Ui)
  (fn pub controlsPage (params (ui (ref Ui)) (w (ref World))) _ (block
    (block
      (expr (call (. ui panel) 440 460))
      (expr (call (. ui label) "controls"))
      (expr (call (. ui toggle) "music" (& (. w music))))
      (expr (call (. ui toggle) "shake" (& (. w shake))))
      (expr (call (. ui check) "hints" (& (. w hints))))
      (if (. w hints) (block
        (expr (call (. ui label) "escape quits"))))
      (expr (call (. ui rule)))
      (expr (call (. ui range) "low" (& (. w low)) 0 100))
      (expr (call (. ui label) (interp "low " (call int (. w low)))))
      (expr (call (. ui range) "high" (& (. w high)) 0 100))
      (expr (call (. ui label) (interp "high " (call int (. w high)))))
      (expr (call (. ui rule)))
      (expr (call (. ui stepper) "volume" (& (. w volume)) 0 10))
      (expr (call (. ui buttonOff) "locked"))
      (expr (call (. ui end)))))))
--- stderr
--- exit 0
