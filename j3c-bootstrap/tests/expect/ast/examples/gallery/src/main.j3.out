(file (module gallery)
  (use gallery.draw.draw)
  (use gallery.world (names World boot input load))
  (use j3.app.App)
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "gallery" 1020 760 boot))
    (expr (call (. app startup) load))
    (expr (call (. app always) input))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
