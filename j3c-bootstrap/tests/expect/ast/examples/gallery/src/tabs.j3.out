(file (module gallery tabs)
  (use gallery.world (names World pickTab))
  (use j3.ui.Ui)
  (fn tabButton (params (ui (ref Ui)) (w (ref World)) (id int) (name string)) _ (block
    (block
      (expr (call (. ui pushId) id))
      (if (== (. w tab) id) (block
        (if (call (. ui button) (interp "[" name "]")) (block
          (expr (call pickTab w id))))) (block
        (if (call (. ui button) name) (block
          (expr (call pickTab w id))))))
      (expr (call (. ui popId))))))
  (fn pub tabBar (params (ui (ref Ui)) (w (ref World))) _ (block
    (block
      (expr (call (. ui row)))
      (expr (call tabButton ui w 0 "widgets"))
      (expr (call tabButton ui w 1 "controls"))
      (expr (call tabButton ui w 2 "layout"))
      (expr (call tabButton ui w 3 "style"))
      (expr (call tabButton ui w 4 "inventory"))
      (expr (call (. ui end)))))))
--- stderr
--- exit 0
