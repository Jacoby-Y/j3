(file (module gallery layout)
  (use gallery.world.World)
  (use j3.ui.Ui)
  (fn pub layoutPage (params (ui (ref Ui)) (w (ref World))) _ (block
    (block
      (expr (call (. ui panel) 440 400))
      (expr (call (. ui label) "layout"))
      (expr (call (. ui label) "wheel, or drag the bar"))
      (block
        (expr (call (. ui panel) 380 100))
        (expr (call (. ui label) "inner panel"))
        (expr (call (. ui label) "nested chrome"))
        (expr (call (. ui end))))
      (expr (call (. ui gap) 8))
      (block
        (expr (call (. ui scroll) 1 160))
        (for i (.. 0 20) (block
          (block
            (expr (call (. ui pushId) i))
            (expr (call (. ui label) (interp "row " i)))
            (expr (call (. ui popId))))))
        (expr (call (. ui end))))
      (expr (call (. ui end)))))))
--- stderr
--- exit 0
