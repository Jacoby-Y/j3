(file (module gallery style)
  (use gallery.world.World)
  (use j3.game.rgb)
  (use j3.ui.Ui)
  (fn pub stylePage (params (ui (ref Ui)) (w (ref World))) _ (block
    (block
      (expr (call (. ui card) 520 560 (call rgb 22 18 42) (call rgb (call u8 (call int (. w red))) (call u8 (call int (. w green))) (call u8 (call int (. w blue)))) (. w radius)))
      (expr (call (. ui label) "style"))
      (expr (call (. ui label) "sliders tint this card"))
      (expr (call (. ui range) "red" (& (. w red)) 0 255))
      (expr (call (. ui label) (interp "red " (call int (. w red)))))
      (expr (call (. ui range) "green" (& (. w green)) 0 255))
      (expr (call (. ui label) (interp "green " (call int (. w green)))))
      (expr (call (. ui range) "blue" (& (. w blue)) 0 255))
      (expr (call (. ui label) (interp "blue " (call int (. w blue)))))
      (expr (call (. ui range) "radius" (& (. w radius)) 0 28))
      (expr (call (. ui label) (interp "radius " (call int (. w radius)))))
      (expr (call (. ui rule)))
      (expr (call (. ui label) "shadow"))
      (block
        (expr (call (. ui row)))
        (expr (call (. ui drop) 120 72 0))
        (expr (call (. ui drop) 120 72 (. w radius)))
        (expr (call (. ui end))))
      (expr (call (. ui gap) 16))
      (expr (call (. ui wash) 400 48 (call rgb 255 214 150) (call rgb 168 52 36) 18))
      (block
        (expr (call (. ui row)))
        (expr (call (. ui chip) "round"))
        (expr (call (. ui chip) "shadow"))
        (expr (call (. ui chip) "wash"))
        (expr (call (. ui end))))
      (expr (call (. ui end)))))))
--- stderr
--- exit 0
