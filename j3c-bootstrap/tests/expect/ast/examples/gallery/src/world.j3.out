(file (module gallery world)
  (use j3.game.anim (names Clip Frame Player))
  (use j3.game (names Font Texture bakeText keyPressed requestQuit rgb setColor tryLoadFont Key))
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (struct pub World
    (field tab int)
    (field clicks int)
    (field music bool)
    (field shake bool)
    (field hints bool)
    (field volume int)
    (field low f32)
    (field high f32)
    (field (doc "Bottom red of the style card, 0..255.") red f32)
    (field (doc "Bottom green of the style card, 0..255.") green f32)
    (field (doc "Bottom blue of the style card, 0..255.") blue f32)
    (field (doc "Corner radius of the style card and the round sample.") radius f32)
    (field font Font)
    (field (doc "Smaller face for the inventory counts and tooltips.") small Font)
    (field mark Texture)
    (field (doc "Text edited by the widgets-page field.") name Text)
    (field (doc "One-frame clip covering `mark`.") clip Clip)
    (field (doc "Playback cursor for `clip`.") player Player))
  (fn pub boot (params (mem (ref Arena))) World (block
    (let frames _ (call (. mem alloc) (targs Frame) 1))
    (= (index frames 0) (struct-lit Frame (field src (struct-lit Vec2 (field x 0) (field y 0))) (field size (struct-lit Vec2 (field x 64) (field y 32)))))
    (return (struct-lit World (field tab 0) (field clicks 0) (field music (bool true)) (field shake (bool false)) (field hints (bool true)) (field volume 4) (field low 25) (field high 70) (field red 120) (field green 64) (field blue 96) (field radius 16) (field font (struct-lit Font (field raw 0))) (field small (struct-lit Font (field raw 0))) (field mark (struct-lit Texture (field raw 0) (field w 0) (field h 0))) (field name (call (. Text new) mem)) (field clip (struct-lit Clip (field frames frames) (field fps 8))) (field player (call (. Player fresh)))))))
  (fn pub load (params (w (ref World))) _ (block
    (= (. w font) (call tryLoadFont "assets/font.ttf" 18))
    (= (. w small) (call tryLoadFont "assets/font.ttf" 12))
    (if (!= (. (. w font) raw) 0) (block
      (expr (call setColor (call rgb 240 230 210)))
      (= (. w mark) (call bakeText (. w font) "mark"))))))
  (fn pub input (params (w (ref World)) (dt f32)) _ (block
    (expr (call (. (. w player) tick) dt (& (. w clip))))
    (if (< dt 0) (block
      (return)))
    (if (call keyPressed (. Key Escape)) (block
      (expr (call requestQuit))))))
  (fn pub pickTab (params (w (ref World)) (tab int)) _ (block
    (= (. w tab) tab)))
  (fn pub addClick (params (w (ref World))) _ (block
    (= (. w clicks) (+ (. w clicks) 1)))))
--- stderr
--- exit 0
