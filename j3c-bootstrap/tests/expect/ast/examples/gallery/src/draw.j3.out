(file (module gallery draw)
  (use gallery.controls.controlsPage)
  (use gallery.layout.layoutPage)
  (use gallery.pack.show)
  (use gallery.style.stylePage)
  (use gallery.tabs.tabBar)
  (use gallery.widgets.widgetsPage)
  (use gallery.world.World)
  (use j3.game (names Camera clearTo drawRect rgb rgba setColor windowSize))
  (use j3.math (names Mat4 Vec2 Vec3))
  (use j3.ui (names Theme Ui))
  (fn frame (params (ui (ref Ui)) (w (ref World))) _ (block
    (expr (call tabBar ui w))
    (expr (call (. ui gap) 12))
    (if (== (. w tab) 0) (block
      (expr (call widgetsPage ui w))))
    (if (== (. w tab) 1) (block
      (expr (call controlsPage ui w))))
    (if (== (. w tab) 2) (block
      (expr (call layoutPage ui w))))
    (if (== (. w tab) 3) (block
      (expr (call stylePage ui w))))))
  (fn pub draw (params (w (ref World))) _ (block
    (expr (call clearTo (call rgb 22 18 32)))
    (if (== (. w tab) 4) (block
      (expr (call setColor (call rgba 0 0 0 150)))
      (expr (call drawRect (struct-lit Vec2 (field x 0) (field y 0)) (call windowSize)))))
    (let ui _ (call (. Ui begin) (. w font) 24 24))
    (= (. ui theme) (call (. Theme dusk)))
    (expr (call frame (& ui) w))
    (let cam _ (call (. Camera create) 1))
    (expr (call (. ui worldLabel) cam (struct-lit Vec2 (field x 40) (field y 700)) "here"))
    (expr (call (. ui worldLabel3) (call (. Mat4 identity)) (call (. Vec3 xyz) 0 0 0) "world"))
    (if (== (. w tab) 4) (block
      (expr (call show (. w font) (. w small))))))))
--- stderr
--- exit 0
