(file (module life)
  (use life.state.State)
  (use life.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.testkit.tagNode)
  (struct World
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int))
  (fn boot (params (mem (ref Arena))) World (block
    (let w _ (struct-lit World (field state (struct-lit State)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))
    (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4024000000000000)))
    (return w)))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn draw (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (if (== (. w frame) 0) (block
      (= (. s txt) "hi")))
    (if (== (. w frame) 1) (block
      (= (. s n) 1)) (block
      (if (== (. w frame) 2) (block
        (= (. s show) (bool false))) (block
        (if (== (. w frame) 3) (block
          (= (. s show) (bool true))) (block
          (if (== (. w frame) 4) (block
            (= (. s n) 3)) (block
            (if (== (. w frame) 5) (block
              (= (. s pg) 0)) (block
              (if (== (. w frame) 6) (block
                (= (. s pg) 1)) (block
                (if (== (. w frame) 7) (block
                  (= (. s pg) 2)) (block
                  (if (== (. w frame) 8) (block
                    (= (. s pg) 9)))))))))))))))))
    (let fr _ (. s frames))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (if (== (. w frame) 0) (block
      (expr (call check w (&& (== (. s mounts) 5) (== (. s destroys) 0)) "first frame mounts the Holder, its Probe and 3 listed Probes"))
      (expr (call check w (== (. s frames) 4) "onFrame runs once per live component that has one"))) (block
      (if (== (. w frame) 1) (block
        (expr (call check w (&& (== (. s mounts) 5) (== (. s destroys) 2)) "an {#each} that shrinks destroys the dropped items"))
        (expr (call near w (. s lastDt) (float 0x3f847ae147ae147b) "dt is the fixed step in seconds"))) (block
        (if (== (. w frame) 2) (block
          (expr (call check w (&& (== (. s destroys) 4) (== (- (. s frames) fr) 1)) "leaving an {#if} destroys the component and its child; no onFrame while hidden"))) (block
          (if (== (. w frame) 3) (block
            (expr (call check w (&& (== (. s mounts) 7) (== (. s destroys) 4)) "re-entering the branch mounts again"))
            (expr (call check w (== (. s fresh) 5) "a re-entered component starts with fresh state"))
            (let inp _ (call tagNode (& (. (. w root) dom)) "input" 0))
            (expr (call check w (&& (&& (>= inp 0) (call same (call (. (. (. w root) dom) strValue) inp) "hi")) (call same (. s txt) "hi")) "a re-entered child shows its bind: value and leaves the parent's alone"))) (block
            (if (== (. w frame) 4) (block
              (expr (call check w (&& (== (. s mounts) 9) (== (. s destroys) 4)) "growing the list mounts the new items"))) (block
              (if (== (. w frame) 5) (block
                (expr (call check w (&& (== (. s mounts) 11) (== (. s destroys) 4)) "a {#match} case mounts its component (and its child)"))) (block
                (if (== (. w frame) 6) (block
                  (expr (call check w (&& (== (. s mounts) 12) (== (. s destroys) 6)) "switching case destroys the old one, mounts the new"))) (block
                  (if (== (. w frame) 7) (block
                    (expr (call check w (&& (== (. s mounts) 12) (== (. s destroys) 6)) "two values of one case keep its state"))) (block
                    (if (== (. w frame) 8) (block
                      (expr (call check w (&& (== (. s mounts) 12) (== (. s destroys) 7)) "{:else} destroys the case it replaces"))) (block
                      (if (== (. w frame) 10) (block
                        (expr (call check w (&& (== (. s mounts) 12) (== (. s destroys) 7)) "idle frames mount and destroy nothing"))
                        (= (. s show) (bool true))
                        (= (. s pg) 0)
                        (for i (.. 0 300) (block
                          (= (. s show) (== (% i 2) 0))
                          (= (. s pg) (% i 3))
                          (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))))
                        (let used _ (. (. (. w root) mem) used))
                        (let cap _ (. (. (. w root) mem) cap))
                        (for i (.. 0 1000) (block
                          (= (. s show) (== (% i 2) 0))
                          (= (. s pg) (% i 3))
                          (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))))
                        (expr (call printLn (interp "arena after 300 warm-up cycles: grew " (- (. (. (. w root) mem) used) used) " bytes over 1000 cycles (cap " cap " -> " (. (. (. w root) mem) cap) ")")))
                        (expr (call check w (&& (== (. (. (. w root) mem) used) used) (== (. (. (. w root) mem) cap) cap)) "1000 {#if}/{#match} cycles: 0 arena growth"))
                        (if (== (. w fails) 0) (block
                          (expr (call printLn "all passed"))))
                        (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))))))))))))))))))
    (+= (. w frame) 1)))
  (fn near (params (w (ref World)) (a f32) (b f32) (what string)) _ (block
    (expr (call check w (&& (> a (- b (float 0x3f40624dd2f1a9fc))) (< a (+ b (float 0x3f40624dd2f1a9fc)))) what))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "life" 320 240 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
