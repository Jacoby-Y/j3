(file (module context)
  (use context.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names windowSize))
  (use j3.memory.Arena)
  (use j3.sys (names panic exit))
  (use j3.io.printLn)
  (struct World
    (field root Screen)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field root (call (. Screen new) mem)) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d setFrameMs) (float 0x4030000000000000)))
    (expr (call (. d simInput) (float 0x4077c00000000000) (float 0x4071800000000000) (bool false) (float 0x0000000000000000)))
    (expr (call (. d simRight) (== (. w frame) 2)))
    (if (== (. w frame) 5) (block
      (expr (call (. d simKeys) "b" ""))))
    (if (== (. w frame) 7) (block
      (expr (call (. d simKeys) "" "Escape"))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (&& (== (. w frame) 4) (|| (!= (. (. d ovs) len) 1) (< (. d focus) 0))) (block
      (expr (call panic "context markup opens and focuses"))))
    (if (&& (== (. w frame) 9) (!= (. (. d ovs) len) 0)) (block
      (expr (call panic "Escape closes bound context popup"))))
    (if (&& (== (. w frame) 60) (!= (. (. d ovs) len) 1)) (block
      (expr (call panic "hover binding opens markup without focus steal"))))
    (if (== (. w frame) 99) (block
      (expr (call printLn "PASS generated context popover and hover-card binding"))
      (expr (call exit 0))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "context" 400 300 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
