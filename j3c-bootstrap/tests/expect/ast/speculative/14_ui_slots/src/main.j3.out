(file (module slots)
  (use slots.state.State)
  (use slots.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.ui.testkit (names clickTag countText hasText))
  (struct World
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field state (struct-lit State)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (let d _ (& (. (. w root) dom)))
    (+= (. w frame) 1)
    (if (== (. w frame) 3) (block
      (expr (call check w (call hasText d "Foot 0") "named slot with parent state"))
      (expr (call check w (call hasText d "Default footer") "fallback content"))
      (expr (call check w (call hasText d "item b 1") "slot in {#each} reads item and index"))
      (expr (call check w (call hasText d "deep 0") "Card inside Card"))
      (expr (call check w (call hasText d "row 1 h0") "component inside slot content in an {#each}"))))
    (if (== (. w frame) 3) (block
      (expr (call check w (&& (call hasText d "dflt 7") (call hasText d "given 2")) "omitted props use their default, given ones win"))
      (expr (call check w (&& (== (call countText d "has footer") 1) (== (call countText d "has body") 1)) "$slots is true only at the sites that fill the slot"))))
    (expr (call clickTag d (. w frame) 4 "button" 0))
    (if (== (. w frame) 8) (block
      (expr (call check w (== (. (. w state) clicks) 10) "click on a slotted button runs the parent's fn"))
      (expr (call check w (&& (call hasText d "Foot 10") (call hasText d "count 10")) "slot content follows parent state"))))
    (expr (call clickTag d (. w frame) 9 "button" 3))
    (if (== (. w frame) 13) (block
      (expr (call check w (== (. (. w state) clicks) 5010) "emit from slot content reaches the owner's handler"))
      (expr (call check w (&& (call hasText d "row 2 h0") (call hasText d "passed 5010")) "slot passed through a second component"))))
    (if (== (. w frame) 14) (block
      (expr (call check w (&& (== (. (. w state) mounts) 3) (== (. (. w state) destroys) 0)) "slot content mounted once while shown"))
      (= (. (. w state) show) (bool false))) (block
      (if (== (. w frame) 17) (block
        (expr (call check w (&& (== (. (. w state) mounts) 3) (== (. (. w state) destroys) 3)) "hiding the slot destroys its content once (also in an {#each})"))
        (= (. (. w state) show) (bool true))) (block
        (if (== (. w frame) 20) (block
          (expr (call check w (&& (== (. (. w state) mounts) 6) (== (. (. w state) destroys) 3)) "showing the slot again mounts fresh content"))
          (if (== (. w fails) 0) (block
            (expr (call printLn "all passed"))))
          (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "slots" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
