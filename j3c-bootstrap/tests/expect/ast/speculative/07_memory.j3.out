(file (module speculative memory)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (struct Vec2
    (field x f32)
    (field y f32))
  (struct World
    (field pos (slice Vec2))
    (field vel (slice Vec2))
    (field count int))
  (fn spawn (params (world (ref World)) (p Vec2) (v Vec2)) int (block
    (let id _ (. world count))
    (= (index (. world pos) id) p)
    (= (index (. world vel) id) v)
    (+= (. world count) 1)
    (return id)))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 16 1024) 1024)))
    (defer (block
      (expr (call (. mem destroy)))))
    (let world _ (struct-lit World (field pos (call (. mem alloc) (targs Vec2) 256)) (field vel (call (. mem alloc) (targs Vec2) 256)) (field count 0)))
    (let player _ (call spawn (& world) (struct-lit Vec2 (field x 0) (field y 0)) (struct-lit Vec2 (field x 1) (field y 0))))
    (let frame _ (call (. mem checkpoint)))
    (defer (block
      (expr (call (. mem rewind) frame))))
    (let hits _ (call (. (type-path List int) new) (& mem)))
    (expr (call (. hits push) player))
    (expr (call printLn (interp "entities=" (. world count) " hits=" (. hits len)))))))
--- stderr
--- exit 0
