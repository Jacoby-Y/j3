(file (module script_demo)
  (use scene (names Scene Node))
  (use j3.io.printLn)
  (const Door _ (script-type "scripts/door.j3s"))
  (fn main (params) _ (block
    (let scene _ (struct-lit Scene (field angles (array-lit (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000) (float 0x0000000000000000)))))
    (let front _ (struct-lit Door (field hinge (struct-lit Node (field id 1)))))
    (let vault _ (struct-lit Door (field hinge (struct-lit Node (field id 2))) (field openAngle (float 0x405e000000000000)) (field seconds (float 0x4000000000000000))))
    (expr (call (. vault toggle)))
    (expr (call (. front toggle)))
    (for i (.. 0 10) (block
      (expr (call (. front update) (& scene) (float 0x3fb999999999999a)))
      (expr (call (. vault update) (& scene) (float 0x3fb999999999999a)))))
    (expr (call (. front toggle)))
    (expr (call (. front update) (& scene) (float 0x3fb999999999999a)))
    (expr (call (. front report)))
    (expr (call (. vault report)))
    (let shed _ (script-lit "scripts/door.j3s" (field hinge (struct-lit Node (field id 3)))))
    (expr (call (. shed toggle)))
    (expr (call (. shed update) (& scene) (float 0x3fd0000000000000)))
    (expr (call (. shed report)))
    (expr (call printLn (interp "angles " (index (. scene angles) 1) " " (index (. scene angles) 2) " " (index (. scene angles) 3)))))))
--- stderr
--- exit 0
