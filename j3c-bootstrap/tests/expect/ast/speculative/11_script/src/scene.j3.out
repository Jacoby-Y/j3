(file (doc "A headless stand-in for `j3.scene3d`: nodes are ids, and the scene keeps one angle each.") (module scene)
  (struct pub Node
    (field id int))
  (struct pub Scene
    (field angles (array 4 f32))
    (fn setAngle (params (this (ref Scene)) (node Node) (degrees f32)) _ (block
      (= (index (. this angles) (. node id)) degrees)))))
