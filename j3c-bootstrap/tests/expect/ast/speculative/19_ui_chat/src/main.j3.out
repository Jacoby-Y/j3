(file (module chat)
  (use chat.state (names Msg State))
  (use chat.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names micros windowSize))
  (use j3.io.printLn)
  (use j3.math (names abs max))
  (use j3.memory (names Arena rewindScratch))
  (use j3.sys)
  (use j3.ui.dom (names Dom DP_NONE K_FREE))
  (const N int 100000)
  (const OLD int 100)
  (const SPARE int 50)
  (const BIG f32 (float 0x4197d78400000000))
  (const GONE f32 (float 0x40f869f000000000))
  (const LOREM string "alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega")
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field fails int)
    (field all (slice Msg))
    (field noKeep (slice string)))
  (fn boot (params (mem (ref Arena))) World (block
    (let total _ (+ (+ OLD N) SPARE))
    (let all _ (call (. mem alloc) (targs Msg) total))
    (let lorem _ LOREM)
    (for i (.. 0 total) (block
      (= (index all i) (struct-lit Msg (field id i) (field text (slice-expr lorem 0 (+ 6 (% (* i 37) (- (. lorem len) 6)))))))))
    (let none _ (call (. mem alloc) (targs string) 0))
    (let w _ (struct-lit World (field mem mem) (field state (struct-lit State (field msgs (slice-expr all OLD (+ OLD N))) (field atEnd (bool false)) (field keep none))) (field root (call (. Screen new) mem)) (field fails 0) (field all all) (field noKeep none)))
    (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4024000000000000)))
    (return w)))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn frame (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (expr (call rewindScratch))))
  (fn frames (params (w (ref World)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call frame w))))))
  (fn box (params (d (ref Dom))) int (block
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (== (. (index (. (. d nodes) items) i) tag) (call (. d tag) "div"))) (block
        (return i)))))
    (return (- 1))))
  (fn live (params (d (ref Dom))) int (block
    (let n _ 0)
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (block
        (+= n 1)))))
    (return n)))
  (fn (doc "The id shown in row `c` (a `<p>`; its first span).") idOf (params (d (ref Dom)) (c int)) int (block
    (let s _ (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) first)) first)))
    (let v _ 0)
    (for i (.. 0 (. s len)) (block
      (= v (+ (* v 10) (as (- (index s i) 48) int)))))
    (return v)))
  (fn (doc "The row `<p>` for message `id` among the box's children, -1 if it is not alive.") rowOf (params (d (ref Dom)) (b int) (id int)) int (block
    (let c _ (. (index (. (. d nodes) items) b) first))
    (while (>= c 0) (block
      (if (== (call idOf d c) id) (block
        (return c)))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (- 1))))
  (fn (doc "Px from the top of the box to the top of message `id` (NaN-free: -99999 when it is not alive).") offsetOf (params (d (ref Dom)) (b int) (id int)) f32 (block
    (let c _ (call rowOf d b id))
    (if (< c 0) (block
      (return (- (float 0x0000000000000000) GONE))))
    (return (- (. (index (. (. d nodes) items) c) y) (. (index (. (. d nodes) items) b) scrollY)))))
  (fn (doc "The row that holds the viewport's top edge (the scroll anchor), as a message id.") firstVisible (params (d (ref Dom)) (b int)) int (block
    (let c _ (. (index (. (. d nodes) items) b) first))
    (while (>= c 0) (block
      (if (&& (> (+ (. (index (. (. d nodes) items) c) y) (. (index (. (. d nodes) items) c) h)) (. (index (. (. d nodes) items) b) scrollY)) (!= (. (index (. (. d nodes) items) c) disp) DP_NONE)) (block
        (return (call idOf d c))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (- 1))))
  (fn lastRowId (params (d (ref Dom)) (b int)) int (block
    (let c _ (. (index (. (. d nodes) items) b) last))
    (return (call idOf d c))))
  (fn near (params (a f32) (b f32) (tol f32)) bool (block
    (return (<= (call abs (- a b)) tol))))
  (fn run (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (let st _ (& (. w state)))
    (expr (call frames w 6))
    (let b _ (call box d))
    (let lastId _ (- (+ OLD N) 1))
    (expr (call check w (== (call lastRowId d b) lastId) (interp "starts at the end: last row " (call lastRowId d b) " of " lastId)))
    (expr (call check w (call near (. (index (. (. d nodes) items) b) scrollY) (. (index (. (. d nodes) items) b) scrollMax) (float 0x3ff8000000000000)) (interp "scroll offset at the end (" (. (index (. (. d nodes) items) b) scrollY) " of " (. (index (. (. d nodes) items) b) scrollMax) ")")))
    (expr (call check w (. st atEnd) "bind:at-end reads true at the end"))
    (expr (call check w (< (call live d) 200) (interp "100000 rows: " (call live d) " live nodes")))
    (let c0 _ (. (index (. (. d nodes) items) b) first))
    (let hmin f32 (float 0x40f869f000000000))
    (let hmax f32 (float 0x0000000000000000))
    (while (>= c0 0) (block
      (= hmin (if-expr (< (. (index (. (. d nodes) items) c0) h) hmin) (. (index (. (. d nodes) items) c0) h) hmin))
      (= hmax (if-expr (> (. (index (. (. d nodes) items) c0) h) hmax) (. (index (. (. d nodes) items) c0) h) hmax))
      (= c0 (. (index (. (. d nodes) items) c0) next))))
    (expr (call check w (> hmax (+ hmin (float 0x4034000000000000))) (interp "rows have varied heights (" hmin ".." hmax ")")))
    (expr (call frames w 60))
    (let laid _ (. d laid))
    (let rs _ (. d restyled))
    (let used _ (. (. w mem) used))
    (expr (call frames w 300))
    (expr (call check w (&& (== (. d laid) laid) (== (. d restyled) rs)) (interp "300 idle frames: 0 layouts, 0 restyles (" (- (. d laid) laid) ", " (- (. d restyled) rs) ")")))
    (expr (call check w (== (. (. w mem) used) used) "300 idle frames: 0 arena growth"))
    (let worst _ 0)
    (for k (.. 0 5) (block
      (= (. st msgs) (slice-expr (. w all) OLD (+ (+ (+ OLD N) 1) k)))
      (let t0 _ (call micros))
      (expr (call frame w))
      (let us _ (- (call micros) t0))
      (= worst (if-expr (> us worst) us worst))
      (expr (call frames w 2))))
    (expr (call printLn (interp "append 1 message to 100000 (stuck at the end): worst frame " worst " us")))
    (expr (call check w (< worst 5000) (interp "an append is not O(rows): worst frame " worst " us (< 5000)")))
    (= lastId (+ (+ OLD N) 4))
    (expr (call check w (&& (== (call lastRowId d b) lastId) (call near (. (index (. (. d nodes) items) b) scrollY) (. (index (. (. d nodes) items) b) scrollMax) (float 0x3ff8000000000000))) (interp "5 appends: still at the end (" (. (index (. (. d nodes) items) b) scrollY) " of " (. (index (. (. d nodes) items) b) scrollMax) ", last row " (call lastRowId d b) ")")))
    (expr (call (. d scrollBy) b (call f32 (- 0 900))))
    (expr (call frames w 4))
    (expr (call check w (! (. st atEnd)) "scrolled up: at-end is false"))
    (let top _ (call firstVisible d b))
    (let off _ (call offsetOf d b top))
    (let y0 _ (. (index (. (. d nodes) items) b) scrollY))
    (for k (.. 0 3) (block
      (= (. st msgs) (slice-expr (. w all) OLD (+ (+ (+ OLD N) 6) k)))
      (expr (call frames w 3))))
    (expr (call check w (&& (call near (call offsetOf d b top) off (float 0x3ff0000000000000)) (call near (. (index (. (. d nodes) items) b) scrollY) y0 (float 0x3ff0000000000000))) (interp "released: 3 appends leave the view alone (message " top " at " (call offsetOf d b top) ", was " off ")")))
    (expr (call check w (! (. st atEnd)) "still not at the end"))
    (= (. st atEnd) (bool true))
    (expr (call frames w 4))
    (expr (call check w (&& (== (call lastRowId d b) (+ (+ OLD N) 7)) (call near (. (index (. (. d nodes) items) b) scrollY) (. (index (. (. d nodes) items) b) scrollMax) (float 0x3ff8000000000000))) (interp "jump to latest (" (. (index (. (. d nodes) items) b) scrollY) " of " (. (index (. (. d nodes) items) b) scrollMax) ")")))
    (= (. st msgs) (slice-expr (. w all) OLD (+ (+ OLD N) 9)))
    (expr (call frames w 3))
    (expr (call check w (== (call lastRowId d b) (+ (+ OLD N) 8)) "stuck again after the jump: an append stays at the end"))
    (expr (call (. d scrollBy) b (call f32 (- 0 100000000))))
    (expr (call (. d scrollBy) b (call f32 (* 60000 60))))
    (expr (call frames w 2))
    (let a _ (call firstVisible d b))
    (let ao _ (call offsetOf d b a))
    (expr (call frames w 6))
    (let ao2 _ (call offsetOf d b a))
    (expr (call check w (call near ao2 ao (float 0x3ff0000000000000)) (interp "jump into unmeasured rows: message " a " at " ao2 ", was " ao " (anchored)")))
    (let bad _ 0)
    (for step (.. 0 40) (block
      (let t _ (call firstVisible d b))
      (let o1 _ (call offsetOf d b t))
      (expr (call (. d scrollBy) b (call f32 (- 0 40))))
      (expr (call frames w 2))
      (let o2 _ (call offsetOf d b t))
      (if (&& (> o2 (- (float 0x3ff0000000000000) GONE)) (! (call near o2 (+ o1 40) (float 0x3ff8000000000000)))) (block
        (+= bad 1)))))
    (expr (call check w (== bad 0) (interp "40 small scroll steps: " bad " jumps")))
    (expr (call frames w 6))
    (let v _ (call firstVisible d b))
    (let vo _ (call offsetOf d b v))
    (let y1 _ (. (index (. (. d nodes) items) b) scrollY))
    (= (. st msgs) (slice-expr (. w all) 0 (+ (+ OLD N) 9)))
    (expr (call frames w 4))
    (let v2 _ (call offsetOf d b v))
    (expr (call check w (call near v2 vo (float 0x3ff0000000000000)) (interp OLD " older messages loaded above: message " v " at " v2 ", was " vo)))
    (expr (call check w (> (. (index (. (. d nodes) items) b) scrollY) (+ y1 100)) (interp "the scroll offset moved down by the new rows (" (- (. (index (. (. d nodes) items) b) scrollY) y1) " px)")))
    (expr (call check w (! (. st atEnd)) "loading older messages does not stick to the end"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call (. d scrollBy) b (call f32 (* 30000 70))))
    (expr (call frames w 6))
    (= v (call firstVisible d b))
    (= vo (call offsetOf d b v))
    (= (. st msgs) (slice-expr (. w all) 0 (+ (+ OLD N) 7)))
    (expr (call frames w 4))
    (expr (call check w (call near (call offsetOf d b v) vo (float 0x3ff0000000000000)) (interp "removing 2 rows at the end leaves message " v " in place")))
    (= (. st msgs) (slice-expr (. w all) 0 (+ (+ OLD N) 9)))
    (expr (call frames w 4))
    (expr (call frames w 30))
    (= laid (. d laid))
    (= rs (. d restyled))
    (= used (. (. w mem) used))
    (expr (call frames w 300))
    (expr (call check w (&& (== (. d laid) laid) (== (. d restyled) rs)) (interp "idle mid-list: 0 layouts, 0 restyles (" (- (. d laid) laid) ", " (- (. d restyled) rs) ")")))
    (expr (call check w (== (. (. w mem) used) used) "idle mid-list: 0 arena growth"))
    (let keys _ (call (. (. w mem) alloc) (targs string) 1))
    (= (index keys 0) "50000")
    (= (. st keep) keys)
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call (. d scrollBy) b (call f32 (* 50000 70))))
    (expr (call frames w 8))
    (let kc _ (call rowOf d b 50000))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frames w 4))
    (let kc2 _ (call rowOf d b 50000))
    (expr (call check w (&& (&& (>= kc 0) (== kc2 kc)) (== (. (index (. (. d nodes) items) kc2) disp) DP_NONE)) "kept row stays alive off screen, hidden, same nodes"))
    (expr (call check w (< (call live d) 200) (interp "kept row costs a few nodes (" (call live d) " live)")))
    (= laid (. d laid))
    (expr (call frames w 30))
    (expr (call check w (== (. d laid) laid) "kept row off screen: 0 layouts when idle"))
    (= (. st keep) (. w noKeep))
    (expr (call frames w 3))
    (expr (call check w (< (call rowOf d b 50000) 0) "dropped from keep: the row goes"))
    (= (index keys 0) "no such key")
    (= (. st keep) keys)
    (expr (call frames w 3))
    (expr (call check w (< (call live d) 200) "a kept key that is not in the list holds nothing"))
    (= (. st keep) (. w noKeep))
    (let grown _ 0)
    (for pass (.. 0 4) (block
      (let seed _ 777)
      (let u0 _ (. (. w mem) used))
      (for it (.. 0 10000) (block
        (= seed (% (+ (* seed 1103515245) 12345) 2147483648))
        (expr (call (. d scrollBy) b (call f32 (- 0 100000000))))
        (expr (call (. d scrollBy) b (* (call f32 (% seed 90000)) (float 0x404e000000000000))))
        (expr (call frame w))))
      (= grown (- (. (. w mem) used) u0))
      (expr (call printLn (interp "jumping pass " pass ": arena grew " grown " bytes")))))
    (expr (call check w (== grown 0) (interp "10000 jumping frames, replayed: arena grew " grown " bytes")))
    (expr (call check w (< (call live d) 300) (interp "live nodes after the jumps: " (call live d))))
    (= (. st msgs) (slice-expr (. w all) 0 5))
    (expr (call frames w 4))
    (expr (call check w (&& (>= (. (index (. (. d nodes) items) b) first) 0) (<= (. (index (. (. d nodes) items) b) scrollY) (+ (. (index (. (. d nodes) items) b) scrollMax) (float 0x3ff0000000000000)))) "shrunk to 5 messages"))
    (= (. st msgs) (slice-expr (. w all) 0 0))
    (expr (call frames w 3))
    (expr (call check w (< (. (index (. (. d nodes) items) b) first) 0) "empty chat"))
    (= (. st msgs) (slice-expr (. w all) OLD (+ OLD N)))
    (expr (call frames w 6))
    (expr (call check w (== (call lastRowId d b) (- (+ OLD N) 1)) "grows back from empty and sticks to the end"))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call run w))
    (if (== (. w fails) 0) (block
      (expr (call printLn "all passed"))))
    (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "chat" 320 240 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
