(file (module chat state)
  (struct pub Msg
    (field id int)
    (field text string))
  (struct pub State
    (field msgs (slice Msg))
    (field (doc "Written by the list (`bind:at-end`); set it to true to jump to the latest message.") atEnd bool)
    (field (doc "Keys of rows that stay alive outside the window.") keep (slice string))))
--- stderr
--- exit 0
