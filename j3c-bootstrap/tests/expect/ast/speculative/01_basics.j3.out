(file (module speculative basics)
  (use j3.io.printLn)
  (const name _ "Coby")
  (fn main (params) _ (block
    (let a _ 10)
    (let b _ 20)
    (let c _ (call add a b))
    (expr (call increment (& c)))
    (expr (call sayHello))
    (expr (call greeting name))))
  (fn add (params (a int) (b int)) int (block
    (return (+ a b))))
  (fn increment (params (n (ref int))) _ (block
    (+= (* n) 1)))
  (fn sayHello (params) _ (block
    (expr (call printLn "Hello, world!"))))
  (fn greeting (params (name string)) _ (block
    (expr (call printLn (interp "Hello, " name ", how are you?"))))))
--- stderr
--- exit 0
