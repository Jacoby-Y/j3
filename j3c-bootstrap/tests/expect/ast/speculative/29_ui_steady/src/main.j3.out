(file (module steady)
  (use steady.state.State)
  (use steady.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names env windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.text.same)
  (use j3.ui.testkit (names hasText tagNode textNode))
  (struct World
    (field state State)
    (field root Screen)
    (field churn bool)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field state (struct-lit State)) (field root (call (. Screen new) mem)) (field churn (> (. (call env "STEADY_CHURN") len) 0)) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (if (. w churn) (block
      (let inp _ (call tagNode (& (. (. w root) dom)) "input" 0))
      (if (&& (&& (>= inp 0) (> (. (. w state) n) 0)) (! (call same (call (. (. (. w root) dom) strValue) inp) (call (. (. w state) row) 1)))) (block
        (expr (call panic "steady: value= kept a scratch view"))))
      (+= (. (. w state) n) 1)))
    (if (== (. w frame) 10) (block
      (= (. (. w state) pos) 17)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (if (|| (== (. w frame) 3) (== (. w frame) 12)) (block
      (expr (call offsets w (if-expr (== (. w frame) 3) (float 0x4014000000000000) (float 0x4031000000000000))))))
    (+= (. w frame) 1)
    (if (. w churn) (block
      (let d _ (& (. (. w root) dom)))
      (if (|| (|| (! (call hasText d (call (. (. w state) size)))) (! (call hasText d (call (. (. w state) row) 0)))) (! (call hasText d (call (. (. w state) row) 2)))) (block
        (expr (call panic "steady: scratch text did not reach the screen"))))
      (let tn _ (call textNode d (call (. (. w state) row) 0)))
      (let tip _ (call (. (. w state) tip)))
      (if (|| (< tn 0) (! (call same (call (. d tipOf) (. (index (. (. d nodes) items) tn) parent)) tip))) (block
        (expr (call panic "steady: title did not reach the node"))))
      (let inp2 _ (call tagNode d "input" 0))
      (let want _ (call (. (. w state) row) 1))
      (if (|| (< inp2 0) (! (call same (call (. d strValue) inp2) want))) (block
        (expr (call panic "steady: value= text did not reach the node"))))))))
  (fn (doc "14: `style:left/top` offset (node x/y are local to the parent) from the stage's top left, `style:right/bottom` from its bottom right.") offsets (params (w (ref World)) (v f32)) _ (block
    (let d _ (& (. (. w root) dom)))
    (let st _ (& (index (. (. d nodes) items) (call tagNode d "div" 1))))
    (let a _ (& (index (. (. d nodes) items) (call tagNode d "div" 2))))
    (let b _ (& (index (. (. d nodes) items) (call tagNode d "div" 3))))
    (if (|| (|| (|| (!= (. a x) v) (!= (. a y) v)) (!= (- (. st w) (+ (. b x) (. b w))) v)) (!= (- (. st h) (+ (. b y) (. b h))) v)) (block
      (expr (call panic "steady: style:left/top/right/bottom did not place the boxes"))))
    (expr (call printLn "style:left/top/right/bottom place absolute boxes"))))
  (fn (doc "9a: `App.shutdown` callbacks run once each, in order, on every way out (`--frames`, `J3_STEADY`).") bye1 (params (w (ref World))) _ (block
    (expr (call printLn "shutdown 1"))))
  (fn bye2 (params (w (ref World))) _ (block
    (expr (call printLn "shutdown 2"))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "steady" 320 200 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app shutdown) bye1))
    (expr (call (. app shutdown) bye2))
    (expr (call (. app run))))))
--- stderr
--- exit 0
