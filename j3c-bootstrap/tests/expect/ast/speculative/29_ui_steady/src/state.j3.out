(file (module steady state)
  (use j3.text (names Text scratchText fmtBytes fmtInt))
  (struct (doc "`n` counts up with `STEADY_CHURN=1`; `big` is a constant that makes the sizes non-trivial.") pub State
    (field n int 0)
    (field (doc "14: offset of the absolutely positioned boxes (`style:left` / `top` / `right` / `bottom`).") pos int 5)
    (fn (doc "9b: strings built in frame scratch and returned to markup. The views die at the next frame.") size (params (this (ref State))) string (block
      (let t _ (call scratchText))
      (return (call fmtBytes (& t) (+ (* (. this n) 1000) 1500)))))
    (fn tip (params (this (ref State))) string (block
      (let t _ (call scratchText))
      (expr (call (. t pushStr) "tip "))
      (expr (call fmtInt (& t) (. this n)))
      (return (call (. t str)))))
    (fn cls (params (this (ref State))) string (block
      (let t _ (call scratchText))
      (expr (call (. t pushStr) (if-expr (== (% (. this n) 2) 0) "even" "odd")))
      (return (call (. t str)))))
    (fn key (params (this (ref State)) (i int)) string (block
      (let t _ (call scratchText))
      (expr (call (. t pushStr) "k"))
      (expr (call fmtInt (& t) i))
      (return (call (. t str)))))
    (fn row (params (this (ref State)) (i int)) string (block
      (let t _ (call scratchText))
      (expr (call fmtInt (& t) (+ (* (. this n) 1000) i)))
      (return (call (. t str)))))))
--- stderr
--- exit 0
