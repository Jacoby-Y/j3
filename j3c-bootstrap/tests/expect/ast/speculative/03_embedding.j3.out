(file (module speculative embedding)
  (use j3.io.printLn)
  (struct Vec2
    (field x f32)
    (field y f32))
  (struct Scale2
    (field width f32)
    (field height f32))
  (struct Transform
    (field embedded position Vec2)
    (field embedded scale Scale2))
  (fn main (params) _ (block
    (let transform _ (struct-lit Transform (field position (struct-lit Vec2 (field x 10) (field y 10))) (field scale (struct-lit Scale2 (field width 1) (field height 1)))))
    (expr (call printLn (interp "x=" (. transform x) ", width=" (. transform width))))
    (use-local transform)
    (expr (call printLn (interp "x=" x ", width=" width)))
    (= width 2)
    (= (. transform width) 2))))
--- stderr
--- exit 0
