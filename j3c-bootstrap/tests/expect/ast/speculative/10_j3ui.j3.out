(file (module speculative j3ui)
  (use j3.game.Font)
  (use j3.ui.Ui)
  (fn rowItem (params (ui (ref Ui)) (name string)) _ (block
    (expr (call (. ui label) name))))
  (fn page (params (ui (ref Ui))) _ (block
    (block
      (expr (call (. ui panel) 220 120))
      (expr (call rowItem ui "one"))
      (expr (call rowItem ui "two"))
      (block
        (expr (call (. ui scroll) 1 40))
        (if (call (. ui button) "ok") (block))
        (expr (call (. ui end))))
      (expr (call (. ui end))))))
  (fn main (params) _ (block
    (let ui _ (call (. Ui begin) (struct-lit Font (field raw 0)) 0 0))
    (expr (call page (& ui))))))
--- stderr
--- exit 0
