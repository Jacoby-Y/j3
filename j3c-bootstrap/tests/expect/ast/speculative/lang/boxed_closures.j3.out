(file (module speculative boxed_closures)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (use j3.thread.Pool)
  (fn adder (params (mem (ref Arena)) (k int)) (closure-type boxed (int) int) (block
    (return (fn-lit (arena mem) (params (x int)) int (block
      (return (+ x k)))))))
  (fn apply (params (f (closure-type (int) int)) (x int)) int (block
    (return (call f x))))
  (mod-let (doc "1 on the main thread only: a job that reads 0 ran on a worker.") thread ON_MAIN int 0)
  (mod-let ON_HIT (closure-type boxed (int) int) _)
  (struct Handler
    (field name string)
    (field run (closure-type boxed (int) int)))
  (fn main (params) _ (block
    (= ON_MAIN 1)
    (let mem _ (call (. Arena create) 4096))
    (let add5 _ (call adder (& mem) 5))
    (let add7 _ (call adder (& mem) 7))
    (expr (call printLn (interp "add5=" (call add5 1) " add7=" (call add7 1) " via stack param=" (call apply add5 10))))
    (let base _ 100)
    (let snap _ (fn-lit (arena mem) (params (x int)) int (block
      (return (+ base x)))))
    (= base 0)
    (expr (call printLn (interp "snap=" (call snap 1) " base=" base)))
    (let n _ 0)
    (let counter _ (fn-lit (arena (& mem)) (params) int (block
      (+= n 1)
      (return n))))
    (expr (call counter))
    (expr (call counter))
    (expr (call printLn (interp "counter=" (call counter) " n=" n)))
    (let fns _ (call (. (type-path List (closure-type boxed (int) int)) new) (& mem)))
    (for i (.. 1 4) (block
      (expr (call (. fns push) (fn-lit (arena mem) (params (x int)) int (block
        (return (* x i))))))))
    (let total _ 0)
    (for-each _ f (call (. fns slice)) (block
      (+= total (call f 10))))
    (let h _ (struct-lit Handler (field name "double") (field run (fn-lit (arena mem) (params (x int)) int (block
      (return (* x 2)))))))
    (let hr _ (. h run))
    (= ON_HIT (fn-lit (arena mem) (params (x int)) int (block
      (return (+ x total)))))
    (expr (call printLn (interp "list total=" total " " (. h name) "=" (call hr 21) " global=" (call ON_HIT 1))))
    (let pool _ (call (. Pool create) (& mem) 2 8))
    (let out _ (call (. mem alloc) (targs int) 3))
    (let onMain _ (call (. mem alloc) (targs int) 3))
    (for i (.. 0 3) (block
      (let slot _ (& (index out i)))
      (let where _ (& (index onMain i)))
      (expr (call (. pool submitBoxed) (fn-lit (arena mem) (params) _ (block
        (= (* slot) (* (+ i 1) 11))
        (= (* where) ON_MAIN)))))))
    (expr (call (. pool wait)))
    (expr (call (. pool shutdown)))
    (expr (call printLn (interp "pool " (index out 0) " " (index out 1) " " (index out 2) " on main=" (+ (+ (index onMain 0) (index onMain 1)) (index onMain 2)) " here=" ON_MAIN))))))
--- stderr
--- exit 0
