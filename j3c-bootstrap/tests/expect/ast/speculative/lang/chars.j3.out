(file (module speculative chars)
  (use j3.io.printLn)
  (fn (doc "How many decimal digits lead `s`, and their value.") leadingInt (params (s string)) int (block
    (let v _ 0)
    (for i (.. 0 (. s len)) (block
      (let ch _ (index s i))
      (if (|| (< ch (char 48)) (> ch (char 57))) (block
        (break)))
      (= v (+ (* v 10) (call int (- ch (char 48)))))))
    (return v)))
  (fn main (params) _ (block
    (let a _ (char 97))
    (let smile _ (char 128512))
    (let e _ (char 233))
    (expr (call printLn (interp "a=" a " smile=" smile " e=" e)))
    (expr (call printLn (interp (char 10) " " (char 13) " " (char 9) " " (char 0) " " (char 92) " " (char 39) " " (char 34) " " (char 127))))
    (let wide int (char 65))
    (let upper _ (- a 32))
    (expr (call printLn (interp "wide=" wide " upper=" upper " same=" (== upper (char 65)))))
    (expr (call printLn (interp "n=" (call leadingInt "42 apples"))))
    (let found _ 0)
    (label rows (for r (.. 0 3) (block
      (for-each _ c "x'y" (block
        (if (== c (char 39)) (block
          (+= found r)
          (continue rows))))))))
    (expr (call printLn (interp "found=" found)))
    (let bold _ "\x1b[1m")
    (let s _ "A\xc3\xa9\xf0\x9f\x98\x80")
    (expr (call printLn (interp "bold=" (. bold len) " " (index bold 0) " s=" s " " (. s len)))))))
--- stderr
--- exit 0
