(file (module speculative tuples)
  (use j3.data.map.Map)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (enum Op
    (case Add)
    (case Mul))
  (fn divmod (params (a int) (b int)) (tuple-type int int) (block
    (return (tuple (/ a b) (% a b)))))
  (fn find (params (xs (slice int)) (x int)) (gen Option (tuple-type int int)) (block
    (for i (.. 0 (. xs len)) (block
      (if (== (index xs i) x) (block
        (return (call (. Option Some) (tuple i (* (index xs i) 10))))))))
    (return (. Option None))))
  (fn apply (params (p (tuple-type Op int)) (x int)) int (block
    (match p
      (arm (pats (tuple-pat (variant Op.Add) (bind n))) (block
        (return (+ x n))))
      (arm (pats (tuple-pat (variant Op.Mul) (lit 0))) (block
        (return 0)))
      (arm (pats (tuple-pat (variant Op.Mul) (bind n))) (block
        (return (* x n)))))))
  (fn main (params) _ (block
    (let-pat (tuple-pat (bind q) (bind r)) (call divmod 17 5))
    (let t _ (call divmod 9 4))
    (expr (call printLn (interp "q=" q " r=" r " t=" (. t 0) "," (. t 1))))
    (let nest (tuple-type (tuple-type int f32) string) (tuple (tuple 1 (float 0x4004000000000000)) "hi"))
    (let-pat (tuple-pat (tuple-pat (bind a) (bind b)) (bind s)) nest)
    (expr (call printLn (interp (. (. nest 0) 1) " " a " " b " " s " " nest)))
    (let xs _ (array-lit 3 5 7))
    (match (call find xs 5)
      (arm (pats (variant Option.Some (tuple-pat (bind i) (bind v)))) (block
        (expr (call printLn (interp "found at " i " -> " v)))))
      (arm (pats (variant Option.None)) (block
        (expr (call printLn "none")))))
    (expr (call printLn (interp (call apply (tuple (. Op Add) 2) 3) " " (call apply (tuple (. Op Mul) 2) 3) " " (call apply (tuple (. Op Mul) 0) 3))))
    (expr (call printLn (interp (== (tuple 1 "x") (tuple 1 "x")) " " (!= (tuple 1 "x") (tuple 2 "x")) " " (== (call (. (tuple 1 "x") hash)) (call (. (tuple 1 "x") hash))))))
    (let arena _ (call (. Arena create) (<< 1 16)))
    (let seen _ (call (. (type-path Map (tuple-type int int) string) new) (& arena) 8))
    (expr (call (. seen put) (tuple 0 0) "origin"))
    (expr (call (. seen put) (tuple 2 3) "far"))
    (expr (call (. seen put) (tuple 0 0) "home"))
    (let total _ 0)
    (for-each _ $each1819 (call (. seen entries) (& arena)) (block
      (let-pat (tuple-pat (bind k) (bind v)) $each1819)
      (+= total (+ (+ (. k 0) (. k 1)) (. v len)))))
    (expr (call printLn (interp "len=" (. seen len) " at=" (call (. seen getOr) (tuple 0 0) "?") " total=" total)))
    (expr (call (. arena destroy))))))
--- stderr
--- exit 0
