(file (module speculative extend)
  (use j3.io.printLn)
  (struct Counter
    (field n int)
    (fn get (params (this (ref Counter))) int (block
      (return (. this n)))))
  (struct Box (tparams T)
    (field v T))
  (extend Counter
    (fn bump (params (this (ref Counter)) (by int)) _ (block
      (+= (. this n) by))))
  (fn main (params) _ (block
    (let c _ (struct-lit Counter (field n 1)))
    (expr (call (. c bump) 4))
    (expr (call (. c scale) 3))
    (expr (call printLn (interp "counter=" (call (. c get)) " double=" (call (. c double)))))
    (let b _ (struct-lit Box (targs int) (field v 20)))
    (let s _ (struct-lit Box (targs string) (field v "hi")))
    (expr (call printLn (interp "box=" (call (. b twice)) " " (call (. s twice))))))))
--- stderr
--- exit 0
