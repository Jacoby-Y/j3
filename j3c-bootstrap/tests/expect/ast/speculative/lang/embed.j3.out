(file (module speculative embed)
  (use j3.io.printLn)
  (const GREETING _ (embed text "embed/greeting.txt" ""))
  (const BLOB _ (embed bytes "embed/blob.bin" ""))
  (const TEXTS _ (embed dir "embed" "*.txt"))
  (fn main (params) _ (block
    (expr (call printLn (interp "greeting " (. GREETING len) " bytes: " GREETING)))
    (let sum _ 0)
    (for i (.. 0 (. BLOB len)) (block
      (= sum (+ (* sum 31) (call int (index BLOB i))))))
    (expr (call printLn (interp "blob len=" (. BLOB len) " nul=" (index BLOB 1) " ff=" (index BLOB 3) " sum=" sum)))
    (for i (.. 0 (. TEXTS len)) (block
      (expr (call printLn (interp (. (index TEXTS i) path) ": " (. (. (index TEXTS i) data) len))))))
    (let inline _ (embed text "embed/b.txt" ""))
    (expr (call printLn (interp "inline " inline))))))
--- stderr
--- exit 0
