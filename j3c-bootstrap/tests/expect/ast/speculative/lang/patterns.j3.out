(file (module speculative patterns)
  (use j3.io.printLn)
  (enum Tok
    (case Plus)
    (case Minus)
    (case Star)
    (case Slash)
    (case Num int)
    (case Name string)
    (case Eof))
  (enum Shape
    (case Dot int)
    (case Pair Tok))
  (fn kind (params (c u8)) string (block
    (match c
      (arm (pats (range (char 97) (char 122)) (range (char 65) (char 90)) (lit (char 95))) (block
        (return "name")))
      (arm (pats (range (char 48) (char 57))) (block
        (return "digit")))
      (arm (pats (lit (char 32)) (lit (char 9)) (lit (char 10))) (block
        (return "space")))
      (arm (pats (wild)) (block
        (return "other"))))))
  (fn describe (params (t Tok)) _ (block
    (match t
      (arm (pats (variant Tok.Plus) (variant Tok.Minus)) (block
        (expr (call printLn "add"))))
      (arm (pats (variant Tok.Star) (variant Tok.Slash)) (block
        (expr (call printLn "mul"))))
      (arm (pats (variant Tok.Num (bind n))) (guard (< n 0)) (block
        (expr (call printLn (interp "negative " n)))))
      (arm (pats (variant Tok.Num (bind n))) (block
        (expr (call printLn (interp "number " n)))))
      (arm (pats (wild)) (block
        (expr (call printLn "other")))))))
  (fn size (params (s Shape)) int (block
    (match s
      (arm (pats (variant Shape.Dot (bind n)) (variant Shape.Pair (variant Tok.Num (bind n)))) (block
        (return n)))
      (arm (pats (wild)) (block
        (return (- 1)))))))
  (fn main (params) _ (block
    (expr (call printLn (interp (call kind (char 113)) " " (call kind (char 90)) " " (call kind (char 95)) " " (call kind (char 55)) " " (call kind (char 32)) " " (call kind (char 43)))))
    (expr (call describe (. Tok Minus)))
    (expr (call describe (. Tok Slash)))
    (expr (call describe (call (. Tok Num) (- 3))))
    (expr (call describe (call (. Tok Num) 8)))
    (expr (call describe (. Tok Eof)))
    (expr (call printLn (interp (call size (call (. Shape Dot) 4)) " " (call size (call (. Shape Pair) (call (. Tok Num) 9))) " " (call size (call (. Shape Pair) (. Tok Star))))))
    (let score _ 0)
    (for n (.. 0 12) (block
      (match n
        (arm (pats (lit 0)) (block
          (+= score 100)))
        (arm (pats (range 1 3) (lit 10)) (block
          (+= score 10)))
        (arm (pats (wild)) (guard (== (% n 2) 0)) (block
          (+= score 1)))
        (arm (pats (wild)) (block)))))
    (expr (call printLn (interp "score=" score))))))
--- stderr
--- exit 0
