(file (module speculative shader)
  (use j3.gpu (names Source attrib))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (struct vertex Corner
    (field at Vec2))
  (struct vertex-instance Sprite
    (field pos Vec2)
    (field size Vec2)
    (field tint vec4f))
  (struct varying V
    (field position vec4)
    (field uv vec2)
    (field tint vec4))
  (mod-let uniform uScreen vec2 _)
  (mod-let uniform uAtlas sampler2D _)
  (fn shader toNdc (params (p vec2)) vec4 (block
    (return (call vec4 (- (* (/ p uScreen) (float 0x4000000000000000)) (float 0x3ff0000000000000)) (float 0x0000000000000000) (float 0x3ff0000000000000)))))
  (fn shader-vertex vs (params (c Corner) (s Sprite)) V (block
    (return (struct-lit V (field position (call toNdc (+ (. s pos) (* (. c at) (. s size))))) (field uv (. c at)) (field tint (. s tint))))))
  (fn shader-fragment fs (params (v V)) vec4 (block
    (let t _ (* (call @texture uAtlas (. v uv)) (. v tint)))
    (if (< (. t a) (float 0x3f847ae147ae147b)) (block
      (expr (call @discard))))
    (return t)))
  (const SPRITES Source (call @shader vs fs))
  (fn (doc "A rolling hash of the bytes (wraps), so the text is compared without printing it.") hash (params (s string)) int (block
    (let h _ 7)
    (for i (.. 0 (. s len)) (block
      (= h (+ (* h 31) (call int (index s i))))))
    (return h)))
  (fn main (params) _ (block
    (expr (call printLn (interp "vert " (. (. SPRITES vert) len) " bytes, frag " (. (. SPRITES frag) len) " bytes")))
    (expr (call printLn (interp "uniforms: " (. SPRITES uniforms))))
    (expr (call printLn (interp "attributes: " (. SPRITES count))))
    (for i (.. 0 (. SPRITES count)) (block
      (let a _ (call (. SPRITES attrib) i))
      (expr (call printLn (interp "  loc " (. a loc) " comps " (. a comps) " offset " (. a offset) " stride " (. a stride) " divisor " (. a divisor))))))
    (expr (call printLn (interp "hash " (call hash (. SPRITES vert)) " " (call hash (. SPRITES frag))))))))
--- stderr
--- exit 0
