(file (module speculative f16)
  (use j3.io.printLn)
  (struct Vertex
    (field h f16)
    (field w f32))
  (fn mid (params (a f16) (b f16)) f16 (block
    (return (call f16 (* (+ (call f32 a) (call f32 b)) (float 0x3fe0000000000000))))))
  (fn main (params) _ (block
    (let x f16 (float 0x3ff8000000000000))
    (let xs (array 3 f16) (array-lit (float 0x3fd0000000000000) (call f16 (float 0x4000000000000000)) x))
    (= (index xs 1) (call mid (index xs 0) (index xs 2)))
    (expr (call printLn (interp (call f32 (index xs 0)) " " (call f32 (index xs 1)) " " (call f32 (index xs 2)))))
    (expr (call printLn (interp (call f32 (call f16 (float 0x40effc0000000000))) " " (> (call f32 (call f16 (float 0x40f1170000000000))) (float 0x40f86a0000000000)))))
    (expr (call printLn (interp (call f32 (call f16 2049)) " " (call f32 (call f16 2051)) " " (call f64 (call f16 (float 0x3fb999999999999a))))))
    (let v _ (struct-lit Vertex (field h (float 0x4008000000000000)) (field w (float 0x4010000000000000))))
    (expr (call printLn (interp (sizeof f16) " " (sizeof Vertex) " " (* (call f32 (. v h)) (. v w))))))))
--- stderr
--- exit 0
