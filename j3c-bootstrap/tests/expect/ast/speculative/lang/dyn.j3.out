(file (module speculative dyn) (dyns Backend Named)
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (trait pub Named
    (trait-fn name (params (this (ref Self))) string _))
  (trait pub Backend (supers Named)
    (trait-fn emit (params (this (ref Self)) (n int)) int _)
    (trait-fn lines (params (this (ref Self))) int (block
      (return (+ (call (. this emit) 1) 100)))))
  (struct Llvm
    (field calls int)
    (fn name (params (this (ref Llvm))) string (block
      (return "llvm")))
    (fn emit (params (this (ref Llvm)) (n int)) int (block
      (+= (. this calls) 1)
      (return (* n 2)))))
  (struct C
    (field base int)
    (fn emit (params (this (ref C)) (n int)) int (block
      (return (+ (. this base) n))))
    (fn lines (params (this (ref C))) int (block
      (return 7))))
  (fn impl name (params (x (ref C))) string (block
    (return "c")))
  (struct Pass
    (field out (dyn Backend))
    (fn run (params (this (ref Pass))) int (block
      (return (call (. (. this out) emit) 10)))))
  (fn pick (params (a (dyn Backend)) (b (dyn Backend)) (first bool)) (dyn Backend) (block
    (if first (block
      (return a)))
    (return b)))
  (fn main (params) _ (block
    (let l _ (struct-lit Llvm (field calls 0)))
    (let c _ (struct-lit C (field base 5)))
    (let b (dyn Backend) (& l))
    (expr (call printLn (interp (call (. b name)) " " (call (. b emit) 3) " " (call (. b lines)) " calls=" (. l calls))))
    (let mem _ (call (. Arena create) 4096))
    (let all _ (call (. (type-path List (dyn Backend)) new) (& mem)))
    (expr (call (. all push) (& l)))
    (expr (call (. all push) (& c)))
    (let total _ 0)
    (for i (.. 0 (. all len)) (block
      (let d _ (index (. all items) i))
      (+= total (call (. d emit) i))
      (expr (call printLn (interp (call (. d name)) " lines=" (call (. d lines)))))))
    (expr (call printLn (interp "total=" total " calls=" (. l calls))))
    (let p _ (struct-lit Pass (field out (& c))))
    (let n (dyn Named) (& c))
    (let up (dyn Named) (index (. all items) 0))
    (expr (call printLn (interp "pass=" (call (. p run)) " picked=" (call (. (call pick (& l) (& c) (bool false)) name)) " named=" (call (. n name)) " up=" (call (. up name))))))))
--- stderr
--- exit 0
