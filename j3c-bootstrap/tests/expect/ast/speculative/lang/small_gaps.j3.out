(file (module speculative small_gaps)
  (use j3.io.printLn)
  (enum Dir
    (case North)
    (case East)
    (case South)
    (case West))
  (const TURNS (array 3 Dir) (array-lit (. Dir East) (. Dir West) (. Dir South)))
  (fn corners (params (w int)) (array 4 int) (block
    (return (array-lit 0 w (* w 2) (* w 3)))))
  (fn bump (params (xs (array 4 int))) (array 4 int) (block
    (= (index xs 0) 9)
    (return xs)))
  (fn main (params) _ (block
    (let far f32 (float 0x4008000000000000))
    (let scaled _ (* 2 far))
    (expr (call printLn (interp "scaled=" scaled)))
    (let total _ 17)
    (/= total 5)
    (let rest _ 17)
    (%= rest 5)
    (expr (call printLn (interp "total=" total " rest=" rest)))
    (for code (.. 0 4) (block
      (match code
        (arm (pats (lit 0)) (block
          (expr (call printLn "zero"))))
        (arm (pats (lit 2)) (block
          (expr (call printLn "two"))))
        (arm (pats (wild)) (block
          (expr (call printLn (interp "other " code))))))))
    (label rows (for r (.. 0 3) (block
      (for c (.. 0 3) (block
        (if (== c 1) (block
          (continue rows)))
        (if (== r 2) (block
          (break rows)))
        (expr (call printLn (interp "r" r " c" c))))))))
    (if (> far (float 0x3ff0000000000000)) (block
      (let a _ 1)
      (expr (call printLn (interp "a=" a)))))
    (if (> far (float 0x3ff0000000000000)) (block
      (let a _ 2)
      (expr (call printLn (interp "a=" a)))))
    (let flags u8 10)
    (|= flags 1)
    (&= flags 7)
    (expr (call printLn (interp "flags=" flags " low=" (& flags 3) " inv=" (^ flags 255) " all=" (~ (call u8 0)))))
    (expr (call printLn (interp "dir=" (call int (. Dir South)) " turn=" (call int (index TURNS 1)))))
    (let cs _ (call corners 5))
    (let moved _ (call bump cs))
    (expr (call printLn (interp "array " (index cs 0) " " (index cs 3) " " (index moved 0) " " (index moved 2)))))))
--- stderr
--- exit 0
