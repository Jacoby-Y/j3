(file (module speculative ufcs)
  (use j3.io.printLn)
  (use j3.math (names abs))
  (struct P
    (field x int)
    (field y int))
  (fn sum (params (p P)) int (block
    (return (+ (. p x) (. p y)))))
  (fn bump (params (p (ref P)) (by int)) _ (block
    (+= (. p x) by)))
  (fn dbl (params (n int)) int (block
    (return (* n 2))))
  (fn count (params (xs (slice int))) int (block
    (return (. xs len))))
  (fn shout (params (s string)) int (block
    (return (. s len))))
  (fn main (params) _ (block
    (let p _ (struct-lit P (field x 1) (field y 2)))
    (expr (call (. p bump) 10))
    (expr (call printLn (interp "sum=" (call (. p sum)) " chain=" (call (. (call (. (call (. p sum)) dbl)) dbl)))))
    (let far f32 (- (float 0x4004000000000000)))
    (let xs (slice int) (array-lit 1 2 3))
    (expr (call printLn (interp "abs=" (call (. far abs)) " count=" (call (. xs count)) " len=" (call (. "hello" shout))))))))
--- stderr
--- exit 0
