(file (module speculative generic_fns)
  (use j3.cmp.Ord)
  (use j3.io.printLn)
  (struct Tag
    (field n int))
  (fn first (tparams T) (params (xs (slice T))) T (block
    (return (index xs 0))))
  (fn maxOf (tparams (T Ord)) (params (a T) (b T)) T (block
    (if (> a b) (block
      (return a)))
    (return b)))
  (fn swap (tparams T) (params (a (ref T)) (b (ref T))) _ (block
    (let t _ (* a))
    (= (* a) (* b))
    (= (* b) t)))
  (fn apply (tparams T) (params (x T) (f (closure-type (T) T))) T (block
    (return (call f (call f x)))))
  (fn count (tparams T) (params (x T) (n int)) int (block
    (if (== n 0) (block
      (return 0)))
    (return (+ 1 (call count x (- n 1))))))
  (fn zero (tparams T) (params) int (block
    (return 0)))
  (fn show (params (xs (slice int))) _ (block
    (expr (call printLn (interp "explicit=" (+ (+ (call (. xs first)) (call zero (targs f32))) 2))))))
  (fn main (params) _ (block
    (let nums (array 2 int) (array-lit 4 5))
    (let fs (array 2 f32) (array-lit (float 0x4004000000000000) (float 0x400c000000000000)))
    (let words (array 1 string) (array-lit "hi"))
    (expr (call printLn (interp "first=" (call first nums) " " (call first fs) " " (call first words))))
    (let f f32 (float 0x4004000000000000))
    (expr (call printLn (interp "max=" (call maxOf 3 7) " " (call maxOf f 1) " " (call maxOf (float 0x3fe0000000000000) (float 0x4022000000000000)))))
    (let a _ 1)
    (let b _ 2)
    (expr (call swap (& a) (& b)))
    (expr (call printLn (interp "swap=" a " " b)))
    (let k _ 3)
    (expr (call printLn (interp "chain=" (call count (struct-lit Tag (field n 1)) 9) " apply=" (call apply 4 (fn-lit (params (v int)) int (block
      (return (* v k))))) " two=" (+ (call count f 2) 3))))
    (expr (call show nums)))))
--- stderr
--- exit 0
