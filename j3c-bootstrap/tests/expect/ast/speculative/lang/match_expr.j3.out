(file (module speculative match_expr)
  (use j3.io.printLn)
  (enum Op
    (case Add)
    (case Sub)
    (case Mul))
  (enum Shape
    (case Circle int)
    (case Rect int int)
    (case Dot))
  (fn cost (params (op Op)) int (block
    (return (match op
      (arm (pats (variant Op.Add)) (block) (tail 1))
      (arm (pats (variant Op.Sub)) (block) (tail 2))
      (arm (pats (variant Op.Mul)) (block
        (let base _ 3)) (tail (* base 2)))))))
  (fn digit (params (c u8)) string (block
    (let kind _ (match c
      (arm (pats (range (char 48) (char 57))) (block) (tail "digit"))
      (arm (pats (lit (char 32)) (lit (char 9))) (block) (tail "space"))
      (arm (pats (wild)) (block) (tail "other"))))
    (return kind)))
  (fn area (params (s Shape)) int (block
    (let a _ (match s
      (arm (pats (variant Shape.Circle (bind r))) (block) (tail (* (* 3 r) r)))
      (arm (pats (variant Shape.Rect (bind w) (bind h))) (block) (tail (* w h)))
      (arm (pats (variant Shape.Dot)) (block
        (return (- 1))))))
    (return a)))
  (fn radius (params (s Shape)) int (block
    (let-pat (variant Shape.Circle (bind r)) s (block
      (return 0)))
    (return r)))
  (fn describe (params (s Shape)) string (block
    (return (match s
      (arm (pats (variant Shape.Rect (bind w) (bind h))) (block) (tail (if-expr (== w h) "square" "rect")))
      (arm (pats (wild)) (block) (tail (match s
        (arm (pats (variant Shape.Circle (wild))) (block) (tail "circle"))
        (arm (pats (wild)) (block) (tail "dot")))))))))
  (fn main (params) _ (block
    (expr (call printLn (interp "cost=" (+ (+ (call cost (. Op Add)) (call cost (. Op Sub))) (call cost (. Op Mul))))))
    (expr (call printLn (interp (call digit (char 55)) " " (call digit (char 32)) " " (call digit (char 120)))))
    (expr (call printLn (interp "area=" (call area (call (. Shape Circle) 2)) " " (call area (call (. Shape Rect) 3 4)) " " (call area (. Shape Dot)))))
    (expr (call printLn (interp "radius=" (call radius (call (. Shape Circle) 5)) " " (call radius (. Shape Dot)))))
    (expr (call printLn (interp (call describe (call (. Shape Rect) 2 2)) " " (call describe (call (. Shape Rect) 2 3)) " " (call describe (call (. Shape Circle) 1)) " " (call describe (. Shape Dot)))))
    (let shapes (array 3 Shape) (array-lit (call (. Shape Circle) 1) (. Shape Dot) (call (. Shape Rect) 2 5)))
    (let total _ 0)
    (for-each _ s shapes (block
      (match s
        (arm (pats (variant Shape.Rect (bind w) (bind h))) (block
          (+= total (* w h))))
        (arm (pats (wild)) (block)))
      (let n _ (match s
        (arm (pats (variant Shape.Dot)) (block
          (continue)))
        (arm (pats (wild)) (block) (tail 1))))
      (+= total n)))
    (expr (call printLn (interp "total=" total)))
    (match (. Op Sub)
      (arm (pats (variant Op.Add)) (block
        (expr (call printLn "add"))))
      (arm (pats (wild)) (block
        (expr (call printLn "not add"))))))))
--- stderr
--- exit 0
