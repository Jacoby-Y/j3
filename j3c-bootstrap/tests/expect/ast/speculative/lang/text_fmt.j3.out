(file (module speculative text_fmt)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (struct debug Span
    (field lo int)
    (field hi int))
  (struct debug Tok
    (field name string)
    (field at Span)
    (field hot bool))
  (enum debug Kind
    (case Word string)
    (case Num int f64)
    (case End))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) (<< 1 20)))
    (let t _ (call (. Text new) (& arena)))
    (let i i8 (- 5))
    (let u _ (~ (call u64 0)))
    (let f f32 (float 0x3ff8000000000000))
    (let x _ (float 0x3fb999999999999a))
    (let tok _ (struct-lit Tok (field name "let") (field at (struct-lit Span (field lo 4) (field hi 7))) (field hot (bool true))))
    (expr (call (. t fmt) (interp "i=" i " u=" u " f=" f " x=" x " b=" (bool true) " " tok)))
    (expr (call printLn (call (. t str))))
    (expr (call printLn (interp "i=" i " u=" u " f=" f " x=" x " b=" (bool true) " " tok)))
    (expr (call (. t clear)))
    (let k _ (call (. Kind Num) 3 (float 0x4004000000000000)))
    (expr (call (. (call (. t fmt) (interp k " " (call (. Kind Word) "w") " " (. Kind End))) fmt) (interp " done")))
    (expr (call printLn (call (. t str))))
    (expr (call (. t clear)))
    (expr (call (. t pushU64) u))
    (expr (call (. t push) (char 32)))
    (expr (call (. t pushHex) 255))
    (expr (call (. t push) (char 32)))
    (expr (call (. t pushF64) (float 0x3fb999999999999a)))
    (expr (call (. t push) (char 32)))
    (expr (call (. t pushChar) 128512))
    (expr (call (. t pushChar) (char 65)))
    (expr (call (. t push) (char 32)))
    (expr (call (. t indent) 2))
    (expr (call (. t pushLine) "end"))
    (expr (call (. t flushTo) 1))
    (let long _ (call (. Text new) (& arena)))
    (for n (.. 0 100) (block
      (expr (call (. long fmt) (interp n ",")))))
    (expr (call (. t fmt) (interp (call (. long str)) (call (. long str)))))
    (expr (call printLn (interp "len=" (call (. t len))))))))
--- stderr
--- exit 0
