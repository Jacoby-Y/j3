(file (module speculative variants)
  (use j3.io.printLn)
  (enum debug BinOp
    (case Add)
    (case Mul))
  (struct debug Span
    (field lo int)
    (field hi int))
  (enum debug Expr
    (case Bin BinOp (ref Expr) (ref Expr))
    (case Lit int)
    (case Named string Span bool))
  (fn eval (params (e (ref Expr))) int (block
    (match (* e)
      (arm (pats (variant Expr.Bin (variant BinOp.Add) (bind l) (bind r))) (block
        (return (+ (call eval l) (call eval r)))))
      (arm (pats (variant Expr.Bin (variant BinOp.Mul) (bind l) (bind r))) (block
        (return (* (call eval l) (call eval r)))))
      (arm (pats (variant Expr.Lit (bind n))) (block
        (return n)))
      (arm (pats (variant Expr.Named (wild) (struct-pat Span (lo (bind lo)) ..) (lit (bool true)))) (block
        (return lo)))
      (arm (pats (variant Expr.Named (wild) (wild) (lit (bool false)))) (block
        (return 0))))))
  (fn width (params (e Expr)) int (block
    (match e
      (arm (pats (variant Expr.Named (wild) (struct-pat Span (lo (bind lo)) (hi (bind hi))) (wild))) (block
        (return (- hi lo))))
      (arm (pats (wild)) (block
        (return 0))))))
  (fn main (params) _ (block
    (let two _ (call (. Expr Lit) 2))
    (let three _ (call (. Expr Lit) 3))
    (let sum _ (call (. Expr Bin) (. BinOp Add) (& two) (& three)))
    (let prod _ (call (. Expr Bin) (. BinOp Mul) (& sum) (& three)))
    (expr (call printLn (interp "eval=" (call eval (& prod)))))
    (let name _ (call (. Expr Named) "x" (struct-lit Span (field lo 4) (field hi 9)) (bool true)))
    (expr (call printLn (interp "named=" (call eval (& name)) " width=" (call width name))))
    (expr (call printLn (interp name)))
    (expr (call printLn (interp sum)))
    (let-pat (struct-pat Span (lo (bind lo)) (hi (bind end))) (struct-lit Span (field lo 1) (field hi 7)))
    (expr (call printLn (interp "lo=" lo " end=" end))))))
--- stderr
--- exit 0
