(file (module speculative collections)
  (use j3.cmp (names sort sortBy))
  (use j3.data.intern.Interner)
  (use j3.data.map.Map)
  (use j3.data.pool (names Id Pool))
  (use j3.io.printLn)
  (use j3.memory (names Arena List))
  (struct Tok
    (field text string)
    (field line int))
  (enum debug Expr
    (case Num int)
    (case Add (ref Expr) (ref Expr)))
  (fn eval (params (e (ref Expr))) int (block
    (return (match (* e)
      (arm (pats (variant Expr.Num (bind n))) (block) (tail n))
      (arm (pats (variant Expr.Add (bind l) (bind r))) (block) (tail (+ (call eval l) (call eval r))))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (<< 1 16)))
    (let toks _ (call (. (type-path List Tok) new) (& mem)))
    (expr (call (. toks push) (struct-lit Tok (field text "let") (field line 2))))
    (expr (call (. toks push) (struct-lit Tok (field text "fn") (field line 1))))
    (expr (call (. toks push) (struct-lit Tok (field text "if") (field line 1))))
    (expr (call sortBy (call (. toks slice)) (fn-lit (params (a Tok) (b Tok)) bool (block
      (return (< (. a line) (. b line)))))))
    (expr (call printLn (interp (. (index (. toks items) 0) text) " " (. (index (. toks items) 1) text) " " (. (call (. toks last)) text))))
    (let nums _ (call (. (type-path List int) new) (& mem)))
    (let raw _ (array-lit 5 3 5 1))
    (for-each _ n raw (block
      (expr (call (. nums push) n))))
    (expr (call (. nums insert) 0 9))
    (expr (call sort (call (. nums slice))))
    (expr (call printLn (interp "sorted " (index (. nums items) 0) " " (index (. nums items) 1) " " (index (. nums items) 4) " has3=" (call (. nums contains) 3) " at5=" (call (. nums indexOf) 5) " pop=" (call (. nums pop)))))
    (let counts _ (call (. (type-path Map string int) new) (& mem) 8))
    (let words _ (array-lit "b" "a" "b" "c" "b"))
    (for-each _ w words (block
      (let p _ (call (. counts getOrPut) w 0))
      (+= (* p) 1)))
    (let keys _ (call (. counts sortedKeys) (& mem)))
    (expr (call printLn (interp (index keys 0) "=" (call (. counts getOr) (index keys 0) 0) " " (index keys 1) "=" (call (. counts getOr) (index keys 1) 0) " " (index keys 2) "=" (call (. counts getOr) (index keys 2) 0))))
    (let total _ 0)
    (expr (call (. counts each) (fn-lit (params (k string) (v int)) _ (block
      (+= total v)))))
    (expr (call printLn (interp "total=" total)))
    (let exprs _ (call (. (type-path Pool Expr) new) (& mem)))
    (let one _ (call (. exprs add) (call (. Expr Num) 1)))
    (let uses _ (call (. (type-path Map (gen Id Expr) int) new) (& mem) 8))
    (expr (call (. uses put) one 3))
    (let tree _ (call (. mem new) (call (. Expr Add) (call (. mem new) (call (. Expr Num) 2)) (call (. exprs get) one))))
    (expr (call printLn (interp "eval=" (call eval tree) " uses=" (call (. uses getOr) one 0) " " (* tree))))
    (let names _ (call (. Interner new) (& mem)))
    (let x _ (call (. names intern) "x"))
    (let y _ (call (. names intern) "y"))
    (expr (call printLn (interp "x=" x " y=" y " again=" (call (. names intern) "x") " str=" (call (. names str) y)))))))
--- stderr
--- exit 0
