(file (module speculative literals)
  (use j3.io.printLn)
  (use j3.option.Option)
  (use j3.text (names lines runes split))
  (const ALL u64 (bigint 18446744073709551615))
  (const HIGH u64 (& ALL (bigint 18374686479671623680)))
  (const HALF u64 (+ (/ ALL 2) 1))
  (fn bits (params (v u64)) string (block
    (match v
      (arm (pats (variant HIGH)) (block
        (return "high")))
      (arm (pats (variant HALF)) (block
        (return "half")))
      (arm (pats (variant ALL)) (block
        (return "all")))
      (arm (pats (wild)) (block
        (return "other"))))))
  (fn keyword (params (w string)) int (block
    (match w
      (arm (pats (lit "let")) (block
        (return 1)))
      (arm (pats (lit "fn") (lit "func")) (block
        (return 2)))
      (arm (pats (lit "if")) (guard (> (. w len) 5)) (block
        (return 99)))
      (arm (pats (lit "if")) (block
        (return 3)))
      (arm (pats (wild)) (block
        (return 0))))))
  (struct Pt
    (field x int)
    (field y f32)
    (field on bool))
  (struct (doc "Counts down from `n` to 1.") Down
    (field n int)
    (fn next (params (this (ref Down))) (gen Option int) (block
      (if (== (. this n) 0) (block
        (return (. Option None))))
      (-= (. this n) 1)
      (return (call (. Option Some) (+ (. this n) 1))))))
  (fn main (params) _ (block
    (let k _ (+ (+ (+ (* (call keyword "let") 1000) (* (call keyword "func") 100)) (* (call keyword "if") 10)) (call keyword "x")))
    (let tag _ (match "fn"
      (arm (pats (lit "fn")) (block) (tail "two"))
      (arm (pats (wild)) (block) (tail "?"))))
    (expr (call printLn (interp "kw=" k " " tag)))
    (let buf (array 64 u8) (zeroed))
    (let pts (array 3 Pt) (zeroed))
    (let sum _ 0)
    (for-each _ b buf (block
      (+= sum (call int b))))
    (= (. (index pts 1) x) 4)
    (expr (call printLn (interp "zero sum=" sum " x=" (. (index pts 0) x) "+" (. (index pts 1) x) " y=" (. (index pts 2) y) " on=" (. (index pts 2) on))))
    (let m u64 (bigint 18446744073709551615))
    (let hi u64 (bigint 9223372036854775808))
    (expr (call printLn (interp "u64 max=" (== m ALL) " top=" (>> hi 63) " low=" (== (& m 255) 255))))
    (let big _ (float 0x41cdcd6500000000))
    (let small f32 (float 0x3f647ae147ae147b))
    (expr (call printLn (interp "floats " (call int big) " " (call int (* small (float 0x408f400000000000))) " " (call int (float 0x4059000000000000)) " " (call int (* (float 0x3ff8000000000000) (float 0x4000000000000000))))))
    (let s _ 1)
    (<<= s 4)
    (let t _ s)
    (>>= t 2)
    (expr (call printLn (interp "shift " s " " t)))
    (let total _ 0)
    (label outer (for-each _ v (struct-lit Down (field n 6)) (block
      (if (== v 5) (block
        (continue)))
      (for-each _ w (struct-lit Down (field n 3)) (block
        (if (== v 2) (block
          (break outer)))
        (+= total (* v w)))))))
    (let n _ 0)
    (let cps u32 0)
    (for-each _ cp (call (. "a\xc3\xa9\xe2\x82\xac" runes)) (block
      (+= n 1)
      (+= cps cp)))
    (expr (call printLn (interp "iter total=" total " runes=" n " sum=" cps)))
    (let parts _ 0)
    (let longest _ 0)
    (for-each _ part (call split "a,bb,,ccc" ",") (block
      (+= parts 1)
      (if (> (. part len) longest) (block
        (= longest (. part len))))))
    (let rows _ 0)
    (for-each _ line (call lines "x\r\ny\n") (block
      (+= rows (. line len))))
    (expr (call printLn (interp "split " parts " " longest " lines " rows " " (call bits HIGH) " " (call bits HALF) " " (call bits ALL) " " (call bits 7) " " (>> HIGH 56)))))))
--- stderr
--- exit 0
