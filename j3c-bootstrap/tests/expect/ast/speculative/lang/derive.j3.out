(file (module speculative derive)
  (use j3.cmp (names maxOf sort))
  (use j3.data.map.Map)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (struct debug (derives Eq Hash Ord Clone) Key
    (field name string)
    (field n int))
  (enum debug (derives Eq Hash Ord) Shape
    (case Dot)
    (case Circle int)
    (case Rect int int))
  (enum (derives Eq Hash Ord Clone) Opt (tparams T)
    (case Some T)
    (case None))
  (struct (derives Eq Hash) Pair (tparams A B)
    (field a A)
    (field b B))
  (fn main (params) _ (block
    (let a _ (struct-lit Key (field name "x") (field n 1)))
    (let b _ (struct-lit Key (field name "x") (field n 2)))
    (expr (call printLn (interp (== a (call (. a clone))) " " (== a b) " " (< a b) " " (call maxOf a b) " " (== (call (. a hash)) (call (. (struct-lit Key (field name "x") (field n 1)) hash))))))
    (let r _ (call (. Shape Rect) 1 2))
    (expr (call printLn (interp (== r (call (. Shape Rect) 1 2)) " " (< r (call (. Shape Rect) 1 3)) " " (< (. Shape Dot) r) " " (< (call (. Shape Circle) 9) r) " " r)))
    (let shapes _ (array-lit (call (. Shape Rect) 0 1) (. Shape Dot) (call (. Shape Circle) 4) (call (. Shape Circle) 2)))
    (expr (call sort shapes))
    (expr (call printLn (interp (index shapes 0) " " (index shapes 1) " " (index shapes 2) " " (index shapes 3))))
    (let arena _ (call (. Arena create) (<< 1 16)))
    (let count _ (call (. (type-path Map Key int) new) (& arena) 8))
    (expr (call (. count put) a 1))
    (expr (call (. count put) (struct-lit Key (field name "x") (field n 1)) 5))
    (expr (call (. count put) b 2))
    (let p _ (struct-lit Pair (targs int string) (field a 7) (field b "q")))
    (expr (call printLn (interp "len=" (. count len) " a=" (call (. count getOr) a 0) " pair=" (== p (struct-lit Pair (targs int string) (field a 7) (field b "q"))) " same-as-tuple=" (== (call (. p hash)) (call (. (tuple 7 "q") hash))))))
    (let o (gen Opt string) (call (. Opt Some) "k"))
    (let none (gen Opt string) (. Opt None))
    (let seen _ (call (. (type-path Map (gen Opt int) int) new) (& arena) 8))
    (expr (call (. seen put) (call (. Opt Some) 3) 1))
    (expr (call (. seen put) (. Opt None) 2))
    (expr (call printLn (interp "opt=" (== o (call (. Opt Some) "k")) " " (== o none) " " (< o none) " " (== (call (. o clone)) o) " map=" (call (. seen getOr) (call (. Opt Some) 3) 0) (call (. seen getOr) (. Opt None) 0))))
    (expr (call (. arena destroy)))))
  (use j3.cmp (names)))
--- stderr
--- exit 0
