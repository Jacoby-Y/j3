(file (module speculative closures)
  (use j3.io.printLn)
  (struct Counter
    (field n int)
    (fn bumper (params (this (ref Counter)) (by int)) int (block
      (let add _ (fn-lit (params (k int)) _ (block
        (+= (. this n) (* k by)))))
      (expr (call add 1))
      (expr (call add 2))
      (return (. this n)))))
  (fn apply (params (f (closure-type (int) int)) (x int)) int (block
    (return (call f x))))
  (fn twice (params (f (closure-type (int) _))) _ (block
    (expr (call f 1))
    (expr (call f 2))))
  (fn triple (params (x int)) int (block
    (return (* x 3))))
  (fn plain (params (f (fn-type (int) int)) (x int)) int (block
    (return (call f x))))
  (fn main (params) _ (block
    (let total _ 0)
    (let base _ 10)
    (let c _ (fn-lit (params (x int)) int (block
      (+= total x)
      (return (+ base x)))))
    (expr (call printLn (interp (call c 1) " " (call c 2) " total=" total)))
    (expr (call printLn (interp "apply=" (call apply (fn-lit (params (x _)) _ (block
      (return (* x base)))) 4) " thunk=" (call apply triple 5))))
    (expr (call twice (fn-lit (params (i _)) _ (block
      (+= total (* i 100))))))
    (expr (call printLn (interp "total=" total)))
    (let hold _ 0)
    (for i (.. 0 3) (block
      (let each _ (fn-lit (params) int (block
        (return i))))
      (+= hold (+ (* (call each) 10) 1))))
    (expr (call printLn (interp "hold=" hold)))
    (let outer _ (fn-lit (params (a int)) int (block
      (let inner _ (fn-lit (params (b int)) int (block
        (+= total 1)
        (return (+ (+ a b) base)))))
      (return (+ (call inner a) (call inner 1))))))
    (expr (call printLn (interp "nested=" (call outer 2) " total=" total)))
    (let ctr _ (struct-lit Counter (field n 0)))
    (expr (call printLn (interp "method=" (call (. ctr bumper) 5) " n=" (. ctr n))))
    (let nocap (fn-type (int) int) (fn-lit (params (x int)) int (block
      (return (+ x 1)))))
    (expr (call printLn (interp "plain=" (call plain nocap 1) " " (call plain (fn-lit (params (x int)) int (block
      (return (- x 1)))) 1))))
    (let d _ 1)
    (let early _ (fn-lit (params) int (block
      (defer (block
        (+= d 100)))
      (if (== d 1) (block
        (return 7)))
      (return 8))))
    (expr (call printLn (interp "early=" (call early) " d=" d))))))
--- stderr
--- exit 0
