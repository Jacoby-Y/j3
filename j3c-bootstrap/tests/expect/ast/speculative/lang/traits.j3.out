(file (module speculative traits)
  (use j3.io.printLn)
  (trait pub Weigh
    (trait-fn weigh (params (this Self)) int _))
  (trait pub Eq
    (trait-fn operator== (params (this Self) (other Self)) bool _))
  (trait pub Ord (supers Eq)
    (trait-fn operator< (params (this Self) (other Self)) bool _))
  (trait pub Named
    (trait-fn name (params (this Self)) string _))
  (trait pub Labeled (supers Named Weigh)
    (trait-fn tag (params (this Self)) int (block
      (return (+ (* (. (call (. this name)) len) 100) (call (. this weigh)))))))
  (struct Pt
    (field x int)
    (field y int)
    (fn weigh (params (this (ref Pt))) int (block
      (return (+ (. this x) (. this y)))))
    (fn operator== (params (this Pt) (other Pt)) bool (block
      (return (&& (== (. this x) (. other x)) (== (. this y) (. other y))))))
    (fn operator< (params (this Pt) (other Pt)) bool (block
      (return (< (. this x) (. other x)))))
    (fn name (params (this (ref Pt))) string (block
      (return "pt"))))
  (fn impl weigh (params (x int)) int (block
    (return (* x 10))))
  (fn impl weigh (params (x string)) int (block
    (return (. x len))))
  (fn describe (tparams (T Weigh)) (params (v T)) int (block
    (return (call (. v weigh)))))
  (fn same (tparams (T Eq)) (params (a T) (b T)) bool (block
    (return (== a b))))
  (fn differ (tparams (T Eq)) (params (a T) (b T)) bool (block
    (return (!= a b))))
  (fn biggest (tparams (T Ord)) (params (a T) (b T)) T (block
    (if (> a b) (block
      (return a)))
    (return b)))
  (fn atMost (tparams (T Ord)) (params (a T) (b T)) bool (block
    (return (<= a b))))
  (fn tagOf (tparams (T Labeled)) (params (v T)) int (block
    (return (call (. v tag)))))
  (fn sameOrLess (tparams (T Ord)) (params (a T) (b T)) bool (block
    (return (|| (== a b) (< a b)))))
  (struct Pair (tparams (A Weigh) (B Weigh))
    (field a A)
    (field b B)
    (fn total (params (this (ref (gen Pair A B)))) int (block
      (return (+ (call (. (. this a) weigh)) (call (. (. this b) weigh))))))
    (fn heavier (where (A Ord)) (params (this (ref (gen Pair A B))) (o A)) bool (block
      (return (< o (. this a))))))
  (fn main (params) _ (block
    (let p _ (struct-lit Pt (field x 1) (field y 2)))
    (expr (call printLn (interp (call describe p) " | " (call describe 7) " | " (call describe "hi"))))
    (expr (call printLn (interp (call same 1 1) " " (call differ 1 1) " " (call same p (struct-lit Pt (field x 1) (field y 2))) " " (call differ p (struct-lit Pt (field x 3) (field y 2))))))
    (let q _ (struct-lit Pt (field x 5) (field y 1)))
    (expr (call printLn (interp (call biggest 2 9) " " (call (. (call biggest p q) weigh)) " " (call atMost p q) " " (call atMost q p))))
    (let pair _ (struct-lit Pair (targs Pt int) (field a p) (field b 4)))
    (expr (call printLn (interp "total=" (call (. pair total)) " " (call (. pair heavier) (struct-lit Pt (field x 0) (field y 0))))))
    (expr (call printLn (interp "tag=" (call tagOf p) " direct=" (call (. p tag)) " " (call sameOrLess p p)))))))
--- stderr
--- exit 0
