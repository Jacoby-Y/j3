(file (module speculative stdlib_game)
  (use j3.game)
  (use j3.math.Vec2)
  (fn touch (params (title string) (pos Vec2)) _ (block
    (expr (call (. game init) title 320 240))
    (expr (call (. game poll)))
    (if (|| (call (. game quitRequested)) (call (. game keyDown) (. (. game Key) Escape))) (block
      (expr (call (. game clear)))
      (expr (call (. game drawRect) pos (struct-lit Vec2 (field x 8) (field y 8))))
      (expr (call (. game present)))))
    (expr (call (. game setResizable) (bool true)))
    (expr (call (. game setMinSize) 160 120))
    (expr (call (. game setMaxSize) 1920 1080))
    (expr (call (. game setWindowSize) 320 240))
    (let size _ (call (. game windowSize)))
    (expr (call (. game destroy))))))
--- stderr
--- exit 0
