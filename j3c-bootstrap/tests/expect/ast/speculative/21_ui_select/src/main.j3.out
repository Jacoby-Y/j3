(file (module selects)
  (use selects.state.State)
  (use selects.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names env windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom.Dom)
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int)
    (field mx f32)
    (field my f32)
    (field down bool)
    (field laid int)
    (field restyled int)
    (field used int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field mem mem) (field state (call (. State new) mem 5000)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0) (field mx (- (float 0x4014000000000000))) (field my (- (float 0x4014000000000000))) (field down (bool false)) (field laid 0) (field restyled 0) (field used 0)))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn (doc "Move the pointer (and press or release) for the next frame.") mouse (params (w (ref World)) (x f32) (y f32) (down bool)) _ (block
    (= (. w mx) x)
    (= (. w my) y)
    (= (. w down) down)))
  (fn step (params (w (ref World))) _ (block
    (expr (call (. (. (. w root) dom) simInput) (. w mx) (. w my) (. w down) (float 0x0000000000000000)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (+= (. w frame) 1)))
  (fn frames (params (w (ref World)) (n int)) _ (block
    (for i (.. 0 n) (block
      (expr (call step w))))))
  (fn click (params (w (ref World)) (x f32) (y f32)) _ (block
    (expr (call mouse w x y (bool false)))
    (expr (call frames w 2))
    (expr (call mouse w x y (bool true)))
    (expr (call frames w 1))
    (expr (call mouse w x y (bool false)))
    (expr (call frames w 2))))
  (fn key (params (w (ref World)) (names string)) _ (block
    (expr (call (. (. (. w root) dom) simKeys) "" names))
    (expr (call step w))))
  (fn (doc "One real frame of a golden run: click the select of `which` at frame 4, park the pointer off the list, so the\nhighlighted row is the chosen one. `J3_CAPTURE=out.png:30` takes frame 30.") goldenDraw (params (w (ref World)) (which string)) _ (block
    (= (. (. w state) custom) (call same which "custom"))
    (let x f32 (float 0x404e000000000000))
    (let y f32 (float 0x4042000000000000))
    (if (call same which "custom") (block
      (= x (float 0x404e000000000000))
      (= y (float 0x405d000000000000))) (block
      (if (call same which "themed") (block
        (= x (float 0x4070e00000000000))) (block
        (if (call same which "multi") (block
          (= x (float 0x404e000000000000))
          (= y (float 0x4073c00000000000))) (block
          (if (call same which "long") (block
            (= x (float 0x407e000000000000))))))))))
    (if (== (. w frame) 3) (block
      (expr (call mouse w x y (bool false)))) (block
      (if (== (. w frame) 4) (block
        (expr (call mouse w x y (bool true)))) (block
        (if (== (. w frame) 5) (block
          (expr (call mouse w x y (bool false)))) (block
          (if (>= (. w frame) 7) (block
            (expr (call mouse w (float 0x4082c00000000000) (float 0x407cc00000000000) (bool false)))))))))))
    (expr (call step w))))
  (fn tests (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (expr (call frames w 3))
    (expr (call check w (< (. d ptRoot) 0) "closed: no list nodes"))
    (let before _ (call (. d count)))
    (expr (call click w (float 0x407e000000000000) (float 0x4042000000000000)))
    (expr (call frames w 3))
    (expr (call check w (&& (== (. (. d pop) kind) 1) (>= (. d ptRoot) 0)) "click opens the list"))
    (let live _ (- (call (. d count)) before))
    (expr (call check w (&& (> live 5) (< live 200)) (interp "5000 options: " live " live list nodes")))
    (let c0 _ (. (. w state) changes))
    (expr (call key w "Down"))
    (expr (call key w "Down"))
    (expr (call key w "Enter"))
    (expr (call frames w 2))
    (expr (call check w (&& (== (. (. d pop) kind) 0) (< (. d ptRoot) 0)) "Enter closes and removes the list"))
    (expr (call check w (call same (. (. w state) big) "v2502") (interp "Enter picked the row after the chosen one (" (. (. w state) big) ")")))
    (expr (call click w (float 0x407e000000000000) (float 0x4042000000000000)))
    (expr (call frames w 3))
    (expr (call key w "End"))
    (expr (call frames w 2))
    (expr (call check w (== (. (. d pop) hot) 4999) "End highlights the last option"))
    (expr (call key w "Enter"))
    (expr (call frames w 2))
    (expr (call check w (call same (. (. w state) big) "v4999") (interp "End, Enter: " (. (. w state) big))))
    (expr (call click w (float 0x404e000000000000) (float 0x4042000000000000)))
    (expr (call frames w 3))
    (expr (call key w "Down"))
    (expr (call key w "Enter"))
    (expr (call frames w 2))
    (expr (call check w (&& (call same (. (. w state) fruit) "banana") (== (. (. w state) changes) (+ c0 1))) (interp "first select: on:input once (" (- (. (. w state) changes) c0) "), value " (. (. w state) fruit))))
    (expr (call click w (float 0x404e000000000000) (float 0x4042000000000000)))
    (expr (call mouse w (float 0x4082c00000000000) (float 0x407cc00000000000) (bool false)))
    (expr (call frames w 6))
    (= (. w laid) (. d laid))
    (= (. w restyled) (. d restyled))
    (= (. w used) (. (. w mem) used))
    (expr (call frames w 200))
    (expr (call check w (&& (== (. d laid) (. w laid)) (== (. d restyled) (. w restyled))) (interp "200 frames with a list open: 0 layouts (" (- (. d laid) (. w laid)) "), 0 restyles (" (- (. d restyled) (. w restyled)) ")")))
    (expr (call check w (== (. (. w mem) used) (. w used)) (interp "200 frames with a list open: 0 arena growth (" (- (. (. w mem) used) (. w used)) ")")))
    (expr (call key w "Escape"))
    (expr (call frames w 2))
    (expr (call check w (< (. d ptRoot) 0) "Escape closes it"))
    (if (== (. w fails) 0) (block
      (expr (call printLn "all passed"))))
    (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))
  (fn draw (params (w (ref World))) _ (block
    (let g _ (call env "SEL_GOLDEN"))
    (if (> (. g len) 0) (block
      (expr (call goldenDraw w g))
      (return)))
    (if (== (. w frame) 0) (block
      (expr (call tests w))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "selects" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
