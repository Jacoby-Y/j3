(file (module selects state)
  (use j3.memory.Arena)
  (struct pub Row
    (field id int)
    (field value string)
    (field label string))
  (fn (doc "A copy of `s` that outlives the frame (template text is frame scratch).") keep (params (mem (ref Arena)) (s string)) string (block
    (let b _ (call (. mem alloc) (targs u8) (. s len)))
    (for i (.. 0 (. s len)) (block
      (= (index b i) (index s i))))
    (return (as b string))))
  (struct pub State
    (field custom bool (bool false))
    (field visual string "apple")
    (field fruit string "apple")
    (field fancy string "two")
    (field big string "v2500")
    (field multi string "cheese,olives")
    (field changes int 0)
    (field rows (slice Row))
    (fn new (params (mem (ref Arena)) (count int)) State (block
      (let rows _ (call (. mem alloc) (targs Row) count))
      (for i (.. 0 count) (block
        (= (index rows i) (struct-lit Row (field id i) (field value (call keep mem (interp "v" i))) (field label (call keep mem (interp "Option number " i)))))))
      (return (struct-lit State (field rows rows)))))))
--- stderr
--- exit 0
