(file (module passthrough)
  (use passthrough.state.State)
  (use passthrough.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom (names Dom K_TEXT))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field mem mem) (field state (call (. State new) mem 1000)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))))
  (fn (doc "The element holding the text `want` (the first one in tree order), -1 when there is none.") chip (params (d (ref Dom)) (want string)) int (block
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (== (. (index (. (. d nodes) items) i) kind) K_TEXT) (call same (call (. d textOf) i) want)) (block
        (return (. (index (. (. d nodes) items) i) parent))))))
    (return (- 1))))
  (fn wide (params (d (ref Dom)) (want string)) f32 (block
    (return (. (call (. d size) (call chip d want)) x))))
  (fn high (params (d (ref Dom)) (want string)) f32 (block
    (return (. (call (. d size) (call chip d want)) y))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn near (params (a f32) (b f32)) bool (block
    (return (&& (> a (- b (float 0x3fe3333333333333))) (< a (+ b (float 0x3fe3333333333333)))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (let d _ (& (. (. w root) dom)))
    (+= (. w frame) 1)
    (if (== (. w frame) 3) (block
      (expr (call check w (call near (call wide d "plain") (float 0x4044000000000000)) (interp "no passthrough: the child's own rule (" (call wide d "plain") ")")))
      (expr (call check w (call near (call wide d "wide") (float 0x405e000000000000)) (interp "class from the parent: its scoped rule beats the child's own (" (call wide d "wide") ")")))
      (expr (call check w (call near (call wide d "hole") (float 0x404e000000000000)) (interp "class hole: c1 (" (call wide d "hole") ")")))
      (expr (call check w (call near (call high d "hole") (float 0x4034000000000000)) (interp "class:on off: the child's own style:height stays (" (call high d "hole") ")")))
      (expr (call check w (&& (call near (call wide d "style") (float 0x4056800000000000)) (call near (call high d "style") (float 0x4034000000000000))) (interp "style: from the parent on the root (" (call wide d "style") ")")))
      (expr (call check w (&& (call near (call wide d "both") (float 0x4056800000000000)) (call near (call high d "both") (float 0x4039000000000000))) (interp "a passed style: beats the root's own style:height (" (call high d "both") ")")))
      (expr (call check w (call near (call wide d "r") (float 0x405e000000000000)) "a keyed {#each} of components passing a class"))
      (= (. (. w state) on) (bool true))
      (= (. (. w state) n) 2)))
    (if (== (. w frame) 5) (block
      (expr (call check w (call near (call wide d "hole") (float 0x4051800000000000)) (interp "class hole changed at runtime: c2 (" (call wide d "hole") ")")))
      (expr (call check w (call near (call high d "hole") (float 0x4034000000000000)) (interp "class:on (height 33) loses to the root's inline style:height (" (call high d "hole") ")")))
      (= (. (. w state) w) (float 0x4049000000000000))))
    (if (== (. w frame) 7) (block
      (expr (call check w (call near (call wide d "style") (float 0x4049000000000000)) (interp "style: follows the parent's value (" (call wide d "style") ")")))
      (= (. (. w state) alpha) (float 0x3fe0000000000000))))
    (if (== (. w frame) 9) (block
      (let laid _ (. d laid))
      (let rs _ (. d restyled))
      (let used _ (. (. w mem) used))
      (= (. (. w state) n) 1)
      (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
      (let one _ (- (. d restyled) rs))
      (expr (call check w (&& (>= one 1) (< one 20)) (interp "class hole change restyles the chip, not the 1000 rows (" one ")")))
      (= rs (. d restyled))
      (= laid (. d laid))
      (for k (.. 0 300) (block
        (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))))
      (expr (call check w (&& (== (. d laid) laid) (== (. d restyled) rs)) (interp "300 idle frames: 0 restyles (" (- (. d restyled) rs) "), layouts (" (- (. d laid) laid) ")")))
      (expr (call check w (== (. (. w mem) used) used) (interp "300 idle frames: 0 arena growth (" (- (. (. w mem) used) used) ")")))
      (if (== (. w fails) 0) (block
        (expr (call printLn "all passed"))))
      (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "passthrough" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
