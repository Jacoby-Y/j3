(file (module passthrough state)
  (use j3.memory.Arena)
  (struct pub Item
    (field id int)
    (field name string))
  (struct pub State
    (field n int 1)
    (field on bool (bool false))
    (field w f32 (float 0x4056800000000000))
    (field h f32 (float 0x4039000000000000))
    (field alpha f32 (float 0x3ff0000000000000))
    (field rows (slice Item))
    (fn new (params (mem (ref Arena)) (count int)) State (block
      (let rows _ (call (. mem alloc) (targs Item) count))
      (for i (.. 0 count) (block
        (= (index rows i) (struct-lit Item (field id i) (field name "r")))))
      (return (struct-lit State (field rows rows)))))))
--- stderr
--- exit 0
