(file (module padnav_probe)
  (use j3.app.App)
  (use j3.game (names env windowSize clearTo Color))
  (use j3.text.same)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.testkit)
  (use padnav_probe.ui (names Screen ScreenProps))
  (struct World
    (field mode string)
    (field root Screen)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field mode (call env "PADNAV_MODE")) (field root root) (field frame 0) (field used 0) (field laid 0) (field styles 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (if (|| (|| (|| (call same (. w mode) "walk") (call same (. w mode) "pick")) (call same (. w mode) "end")) (call same (. w mode) "mouse")) (block
      (expr (call (. testkit padPress) d (. w frame) 6 "Down"))
      (expr (call (. testkit padPress) d (. w frame) 8 "A"))
      (expr (call (. testkit padPress) d (. w frame) 10 "Down"))
      (expr (call (. testkit padPress) d (. w frame) 12 "Right"))
      (expr (call (. testkit padPress) d (. w frame) 14 "Right"))
      (expr (call (. testkit padPress) d (. w frame) 16 "Down"))))
    (if (|| (call same (. w mode) "pick") (call same (. w mode) "end")) (block
      (expr (call (. testkit padPress) d (. w frame) 18 "A"))
      (expr (call (. testkit padPress) d (. w frame) 20 "Down"))
      (expr (call (. testkit padPress) d (. w frame) 22 "Down"))
      (expr (call (. testkit padPress) d (. w frame) 24 "A"))))
    (if (call same (. w mode) "end") (block
      (expr (call (. testkit padPress) d (. w frame) 26 "Down"))
      (expr (call (. testkit padPress) d (. w frame) 28 "Right"))
      (expr (call (. testkit padPress) d (. w frame) 30 "A"))
      (expr (call (. testkit padPress) d (. w frame) 32 "Right"))
      (expr (call (. testkit padPress) d (. w frame) 34 "A"))))
    (if (call same (. w mode) "summary") (block
      (for i (.. 0 5) (block
        (expr (call (. testkit padPress) d (. w frame) (+ 6 (* i 2)) "Down"))))
      (expr (call (. testkit padPress) d (. w frame) 16 "A"))))
    (if (call same (. w mode) "tab") (block
      (for i (.. 0 6) (block
        (expr (call (. testkit simKeys) d (. w frame) (+ 6 (* i 2)) "" "Tab"))))
      (expr (call (. testkit simKeys) d (. w frame) 18 "" "Enter"))))
    (if (&& (&& (|| (call same (. w mode) "summary") (call same (. w mode) "tab")) (== (. w frame) 30)) (! (. (. w root) more))) (block
      (expr (call panic "padnav: the summary was not reached or did not open"))))
    (if (&& (call same (. w mode) "mouse") (== (. w frame) 20)) (block
      (expr (call (. d simInput) (float 0x406f400000000000) (float 0x4067c00000000000) (bool false) (float 0x0000000000000000)))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 45) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))))
    (if (&& (> (. w frame) 45) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "padnav steady frame changed layout style or allocation"))))
    (if (== (. w frame) 60) (block
      (expr (call printLn "padnav_probe ok"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "padnav probe" 320 240 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
