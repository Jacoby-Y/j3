(file (module rtl)
  (use j3.app.App)
  (use j3.game (names textShaping tryLoadFont windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use rtl.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int)
    (field ta int))
  (fn boot (params (mem (ref Arena))) World (block
    (if (|| (== (. (call tryLoadFont "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" 16) raw) 0) (! (call textShaping))) (block
      (expr (call printLn "FAIL: speculative/31_ui_rtl needs DejaVu Sans and HarfBuzz in SDL_ttf (the golden cannot be checked)"))
      (expr (call (. sys exit) 1))))
    (return (struct-lit World (field root (call (. Screen new) mem)) (field frame 0) (field ta (- 1))))))
  (fn draw (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (if (== (. w frame) 2) (block
      (for i (.. 0 (. (. d nodes) len)) (block
        (if (&& (== (. (index (. (. d nodes) items) i) tag) (. d tInput)) (< (. w ta) 0)) (block
          (= (. w ta) i)))))
      (expr (call (. d focusNode) (. w ta)))) (block
      (if (== (. w frame) 4) (block
        (let e _ (& (index (. (. d eds) items) (. (index (. (. d nodes) items) (. w ta)) edit))))
        (= (. e anc) 2)
        (= (. e cur) 6)))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field a "abc \xd7\x90\xd7\x91\xd7\x92 def") (field b "abc \xd7\x90\xd7\x91\xd7\x92 def \xd8\xb3\xd9\x84\xd8\xa7\xd9\x85 hello \xd7\xa2\xd7\x91\xd7\xa8\xd7\x99\xd7\xaa world, a long mixed line that wraps"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "rtl" 360 180 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
