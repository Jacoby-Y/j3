(file (module urlvar)
  (use j3.app.App)
  (use j3.game (names env windowSize clearTo Color))
  (use j3.text.same)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use urlvar.ui (names Screen ScreenProps))
  (struct World
    (field mode string)
    (field root Screen)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int)
    (field loads int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field mode (call env "THEME_MODE")) (field root root) (field frame 0) (field used 0) (field laid 0) (field styles 0) (field loads 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (if (&& (>= (. w frame) 2) (< (. w frame) 20)) (block
      (expr (call (. d setColorScheme) (== (% (. w frame) 2) 0)))))
    (if (== (. w frame) 20) (block
      (expr (call (. d setColorScheme) (call same (. w mode) "dark")))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 40) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))
      (= (. w loads) (. (. (. d imgs) ents) len))))
    (if (&& (> (. w frame) 40) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "urlvar steady frame changed layout style or allocation"))))
    (if (&& (> (. w frame) 40) (!= (. (. (. d imgs) ents) len) (. w loads))) (block
      (expr (call panic "urlvar loaded a texture after the flips"))))
    (if (== (. w frame) 50) (block
      (expr (call printLn (interp "urlvar ok: " (. (. (. d imgs) ents) len) " textures loaded in total (3 paths)")))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "urlvar" 700 330 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
