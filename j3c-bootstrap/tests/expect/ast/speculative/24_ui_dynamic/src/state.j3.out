(file (module dynamic state)
  (struct pub Msg
    (field id int)
    (field kind int))
  (struct pub State
    (field rows (slice Msg))
    (field single Msg)
    (field choice int 0)
    (field selects int 0)
    (field mounts int 0)
    (field destroys int 0)
    (field next int 0)
    (field birth (slice int))))
--- stderr
--- exit 0
