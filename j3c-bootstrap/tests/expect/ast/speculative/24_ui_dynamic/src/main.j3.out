(file (module dynamic)
  (use dynamic.state (names State Msg))
  (use dynamic.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom (names Dom K_TEXT))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int)
    (field saved (slice int)))
  (fn boot (params (mem (ref Arena))) World (block
    (let rows _ (call (. mem alloc) (targs Msg) 3))
    (for i (.. 0 3) (block
      (= (index rows i) (struct-lit Msg (field id i) (field kind i)))))
    (return (struct-lit World (field mem mem) (field state (struct-lit State (field rows rows) (field single (struct-lit Msg (field id 3) (field kind 0))) (field birth (call (. mem alloc) (targs int) 4)))) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0) (field saved (call (. mem alloc) (targs int) 4))))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn count (params (d (ref Dom)) (text string)) int (block
    (let n _ 0)
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (== (. (index (. (. d nodes) items) i) kind) K_TEXT) (call same (call (. d textOf) i) text)) (block
        (+= n 1)))))
    (return n)))
  (fn draw (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (if (== (. w frame) 1) (block
      (let tmp _ (index (. s rows) 0))
      (= (index (. s rows) 0) (index (. s rows) 2))
      (= (index (. s rows) 2) tmp)) (block
      (if (== (. w frame) 2) (block
        (= (. (index (. s rows) 1) kind) 2)
        (= (. s choice) 1)) (block
        (if (== (. w frame) 3) (block
          (= (. (index (. s rows) 1) kind) (- 1))) (block
          (if (== (. w frame) 4) (block
            (= (. (index (. s rows) 1) kind) 99)) (block
            (if (== (. w frame) 5) (block
              (= (. (index (. s rows) 1) kind) 1)
              (= (. s choice) 2)) (block
              (if (== (. w frame) 8) (block
                (= (index (. w saved) 3) (index (. s birth) 3))
                (= (. s choice) 0)) (block
                (if (== (. w frame) 9) (block
                  (= (index (. w saved) 2) (index (. s birth) 3))
                  (= (. s choice) 2)) (block
                  (if (== (. w frame) 10) (block
                    (= (index (. w saved) 1) (index (. s birth) 3))
                    (= (. s choice) 0)) (block
                    (if (== (. w frame) 11) (block
                      (= (index (. w saved) 0) (index (. s birth) 3))
                      (= (. s choice) 1)))))))))))))))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (let d _ (& (. (. w root) dom)))
    (if (== (. w frame) 0) (block
      (expr (call check w (&& (== (. s mounts) 4) (== (. s destroys) 0)) "all integer candidates and enum selector mount"))
      (expr (call check w (&& (&& (== (call count d "TextMsg") 2) (== (call count d "ImageMsg") 1)) (== (call count d "Embed") 1)) "mixed message kinds render"))
      (expr (call check w (&& (== (call count d "body") 4) (== (call count d "footer") 4)) "default and named slots reach every candidate"))
      (let roots _ 0)
      (for i (.. 0 (. (. d nodes) len)) (block
        (if (== (. (index (. (. d nodes) items) i) tag) (call (. d tag) "section")) (block
          (let size _ (call (. d size) i))
          (if (&& (&& (&& (> (. size x) (float 0x405eb9999999999a)) (< (. size x) (float 0x405ec66666666666))) (> (. size y) (float 0x4037e66666666666))) (< (. size y) (float 0x403819999999999a))) (block
            (+= roots 1)))))))
      (expr (call check w (== roots 4) "class and style passthrough reach every candidate"))
      (for i (.. 0 4) (block
        (= (index (. w saved) i) (index (. s birth) i))))) (block
      (if (== (. w frame) 1) (block
        (let stable _ (bool true))
        (for i (.. 0 4) (block
          (if (!= (index (. w saved) i) (index (. s birth) i)) (block
            (= stable (bool false))))))
        (expr (call check w (&& (&& stable (== (. s mounts) 4)) (== (. s destroys) 0)) "keyed moves preserve selected component state"))) (block
        (if (== (. w frame) 2) (block
          (expr (call check w (&& (== (. s mounts) 6) (== (. s destroys) 2)) "int and enum switches destroy and remount"))
          (expr (call check w (&& (!= (index (. s birth) 1) (index (. w saved) 1)) (!= (index (. s birth) 3) (index (. w saved) 3))) "switches discard old local state"))) (block
          (if (== (. w frame) 3) (block
            (expr (call check w (&& (&& (== (. s mounts) 6) (== (. s destroys) 3)) (== (call count d "footer") 3)) "negative index is empty and destroys old arm"))) (block
            (if (== (. w frame) 4) (block
              (expr (call check w (&& (&& (== (. s mounts) 6) (== (. s destroys) 3)) (== (call count d "footer") 3)) "out-of-range index remains empty"))) (block
              (if (== (. w frame) 5) (block
                (expr (call check w (&& (&& (== (. s mounts) 8) (== (. s destroys) 4)) (== (call count d "footer") 4)) "re-entry mounts fresh and enum selects third candidate"))
                (expr (call check w (!= (index (. s birth) 1) (index (. w saved) 1)) "returning to first candidate does not revive state"))) (block
                (if (== (. w frame) 7) (block
                  (expr (call check w (&& (== (. s mounts) 8) (== (. s destroys) 4)) "idle does not remount"))
                  (expr (call check w (== (. s selects) 8) "selector evaluated once per update"))) (block
                  (if (== (. w frame) 8) (block
                    (expr (call check w (&& (== (. s mounts) 9) (== (. s destroys) 5)) "single: Embed -> TextMsg destroys one and mounts one"))
                    (expr (call check w (&& (&& (&& (!= (index (. s birth) 3) (index (. w saved) 3)) (== (call count d "TextMsg") 2)) (== (call count d "Embed") 1)) (== (call count d "footer") 4)) "single: TextMsg arm has its slots and fresh state"))) (block
                    (if (== (. w frame) 9) (block
                      (expr (call check w (&& (&& (== (. s mounts) 10) (== (. s destroys) 6)) (!= (index (. s birth) 3) (index (. w saved) 2))) "single: back to Embed (reset, fresh state, inject resolved)"))
                      (expr (call check w (&& (&& (== (call count d "Embed") 2) (== (call count d "footer") 4)) (== (call count d "body") 4)) "single: Embed arm has its slots again"))) (block
                      (if (== (. w frame) 10) (block
                        (expr (call check w (&& (&& (&& (== (. s mounts) 11) (== (. s destroys) 7)) (!= (index (. s birth) 3) (index (. w saved) 1))) (!= (index (. s birth) 3) (index (. w saved) 3))) "single: TextMsg again, a third distinct state"))) (block
                        (if (== (. w frame) 11) (block
                          (expr (call check w (&& (&& (&& (== (. s mounts) 12) (== (. s destroys) 8)) (== (call count d "footer") 4)) (!= (index (. s birth) 3) (index (. w saved) 0))) "single: ImageMsg after the others"))) (block
                          (if (== (. w frame) 13) (block
                            (expr (call check w (&& (== (. s mounts) 12) (== (. s destroys) 8)) "idle after the switches mounts nothing"))
                            (expr (call (. (. w root) destroy)))
                            (expr (call check w (== (. s destroys) 12) "root destruction destroys each live arm once"))
                            (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))))))))))))))))))))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "dynamic" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
