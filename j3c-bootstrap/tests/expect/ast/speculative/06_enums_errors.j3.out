(file (module speculative enums_errors)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.result.Result)
  (use j3.sys.panic)
  (use j3.text.Text)
  (enum Dir
    (case N)
    (case E)
    (case S)
    (case W))
  (enum IoError
    (case NotFound)
    (case Permission))
  (fn heading (params (dir Dir)) string (block
    (match dir
      (arm (pats (variant Dir.N)) (block
        (return "north")))
      (arm (pats (variant Dir.E)) (block
        (return "east")))
      (arm (pats (variant Dir.S)) (block
        (return "south")))
      (arm (pats (variant Dir.W)) (block
        (return "west"))))))
  (fn find (params (xs (slice int)) (want int)) (gen Option int) (block
    (for-each _ n xs (block
      (if (== n want) (block
        (return (call (. Option Some) n))))))
    (return (. Option None))))
  (fn loadName (params) (gen Result string IoError) (block
    (return (call (. Result Err) (. IoError NotFound)))))
  (fn greet (params (t (ref Text))) (gen Result string IoError) (block
    (let name _ (? (call loadName)))
    (expr (call (. t fmt) (interp "hello " name)))
    (return (call (. Result Ok) (call (. t str))))))
  (fn main (params) _ (block
    (expr (call printLn (call heading (. Dir N))))
    (let xs (array 3 int) (array-lit 1 2 3))
    (match (call find (slice-expr xs _ _) 2)
      (arm (pats (variant Option.None)) (block
        (expr (call printLn "miss"))))
      (arm (pats (variant Option.Some (bind n))) (block
        (expr (call printLn (interp "hit " n))))))
    (let mem _ (call (. Arena create) 256))
    (let t _ (call (. Text new) (& mem)))
    (match (call greet (& t))
      (arm (pats (variant Result.Ok (bind msg))) (block
        (expr (call printLn msg))))
      (arm (pats (variant Result.Err (variant IoError.NotFound))) (block
        (expr (call printLn "missing"))))
      (arm (pats (variant Result.Err (wild))) (block
        (expr (call panic "unexpected io"))))))))
--- stderr
--- exit 0
