(file (module threads)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.option.Option)
  (use j3.thread (names Mutex Pool Queue Thread join spawn))
  (mod-let thread SEEN int 0)
  (struct Shared
    (field locked int)
    (field atomic int)
    (field m Mutex))
  (fn bump (params (arg ptr)) _ (block
    (let s _ (as arg (ref Shared)))
    (= SEEN (+ SEEN 1))
    (for i (.. 0 10000) (block
      (expr (call (. (. s m) lock)))
      (+= (. s locked) 1)
      (expr (call (. (. s m) unlock)))
      (expr (atomic atomicAdd seqcst (& (. s atomic)) 1))))))
  (struct Feed
    (field q (gen Queue int)))
  (fn produce (params (arg ptr)) _ (block
    (let f _ (as arg (ref Feed)))
    (for i (..= 1 100) (block
      (expr (call (. (. f q) push) i))))
    (expr (call (. (. f q) close)))))
  (struct Squares
    (field out (slice int)))
  (fn square (params (ctx ptr) (lo int) (hi int)) _ (block
    (let s _ (as ctx (ref Squares)))
    (for i (.. lo hi) (block
      (= (index (. s out) i) (* i i))))))
  (struct Gate
    (field m Mutex)
    (field started int)
    (field ran int))
  (fn (doc "Holds the only worker until main unlocks the gate.") blocker (params (arg ptr)) _ (block
    (let g _ (as arg (ref Gate)))
    (expr (atomic atomicStore seqcst (& (. g started)) 1))
    (expr (call (. (. g m) lock)))
    (expr (call (. (. g m) unlock)))
    (expr (atomic atomicAdd seqcst (& (. g ran)) 1))))
  (fn count (params (arg ptr)) _ (block
    (let g _ (as arg (ref Gate)))
    (expr (atomic atomicAdd seqcst (& (. g ran)) 1))))
  (fn main (params) _ (block
    (let arena _ (call (. Arena create) 1048576))
    (let s _ (struct-lit Shared (field locked 0) (field atomic 0) (field m (struct-lit Mutex))))
    (let ts _ (call (. arena alloc) (targs Thread) 4))
    (for i (.. 0 4) (block
      (expr (call spawn (& (index ts i)) "bump" bump (as (& s) ptr)))))
    (for i (.. 0 4) (block
      (expr (call join (& (index ts i))))))
    (expr (call printLn (interp "locked=" (. s locked) " atomic=" (. s atomic) " main seen=" SEEN)))
    (let f _ (struct-lit Feed (field q (call (. (type-path Queue int) create) (& arena) 8))))
    (let p _ (struct-lit Thread (field f produce)))
    (expr (call spawn (& p) "producer" produce (as (& f) ptr)))
    (let sum _ 0)
    (while (bool true) (block
      (match (call (. (. f q) pop))
        (arm (pats (variant Option.None)) (block
          (break)))
        (arm (pats (variant Option.Some (bind v))) (block
          (+= sum v))))))
    (expr (call join (& p)))
    (expr (call printLn (interp "queue sum=" sum)))
    (let pool _ (call (. Pool create) (& arena) 4 16))
    (let sq _ (struct-lit Squares (field out (call (. arena alloc) (targs int) 1000))))
    (expr (call (. pool parallelFor) 1000 square (as (& sq) ptr)))
    (let total _ 0)
    (for i (.. 0 1000) (block
      (+= total (index (. sq out) i))))
    (expr (call printLn (interp "squares total=" total)))
    (expr (call (. pool shutdown)))
    (let g _ (struct-lit Gate (field m (struct-lit Mutex)) (field started 0) (field ran 0)))
    (let small _ (call (. Pool create) (& arena) 1 1))
    (expr (call (. (. g m) lock)))
    (expr (call (. small submit) blocker (as (& g) ptr)))
    (while (== (atomic atomicLoad seqcst (& (. g started))) 0) (block))
    (let first _ (call (. small trySubmit) count (as (& g) ptr)))
    (let second _ (call (. small trySubmit) count (as (& g) ptr)))
    (let queued _ (call (. small pendingJobs)))
    (expr (call (. (. g m) unlock)))
    (expr (call (. small wait)))
    (expr (call printLn (interp "trySubmit first=" first " second=" second " pending=" queued " ran=" (. g ran) " after=" (call (. small pendingJobs)))))
    (expr (call (. small shutdown))))))
--- stderr
--- exit 0
