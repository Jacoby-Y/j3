(file (module dialog_flicker)
  (use dialog_flicker.state.State)
  (use dialog_flicker.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.memory.Arena)
  (use j3.io.printLn)
  (use j3.sys.panic)
  (use j3.ui.dom.K_ELEM)
  (struct World
    (field state State)
    (field root Screen))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field state (struct-lit State)) (field root (call (. Screen new) mem))))))
  (fn draw (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (+= (. s frame) 1)
    (= (. s toasts) (% (/ (. s frame) 3) 4))
    (= (. s full) (== (% (/ (. s frame) 7) 2) 1))
    (= (. s fps) (== (% (/ (. s frame) 11) 2) 0))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (let d _ (& (. (. w root) dom)))
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (&& (== (. (index (. (. d nodes) items) i) tag) (. d tDialog)) (== (. (index (. (. d nodes) items) i) kind) K_ELEM)) (< (call (. d absY) i) (float 0x3ff0000000000000))) (block
        (expr (call printLn (interp "FAIL: frame " (. s frame) ": dialog at " (call (. d absX) i) "," (call (. d absY) i))))
        (expr (call panic "dialog left the center"))))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "dialog_flicker" 640 360 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
