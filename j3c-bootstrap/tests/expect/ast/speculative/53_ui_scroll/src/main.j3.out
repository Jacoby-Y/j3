(file (module uiscroll)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color env))
  (use j3.text.same)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.testkit)
  (use uiscroll.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field mode string)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field mode (call env "SCROLL_MODE")) (field frame 0) (field used 0) (field laid 0) (field styles 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (if (&& (&& (call same (. w mode) "wheel") (>= (. w frame) 5)) (< (. w frame) 10)) (block
      (expr (call (. d simInput) (float 0x4059000000000000) (float 0x4054000000000000) (bool false) (- (float 0x3ff0000000000000))))) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))))
    (if (&& (&& (call same (. w mode) "into") (>= (. w frame) 5)) (< (. w frame) 9)) (block
      (expr (call (. testkit clickText) d (. w frame) 5 "To last"))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 90) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))))
    (if (&& (> (. w frame) 90) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "uiscroll steady frame changed layout style or allocation"))))
    (if (== (. w frame) 100) (block
      (expr (call printLn "uiscroll ok"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uiscroll" 300 440 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
