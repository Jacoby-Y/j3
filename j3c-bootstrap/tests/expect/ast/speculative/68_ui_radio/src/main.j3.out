(file (module uiradio)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color env))
  (use j3.text.same)
  (use j3.memory.Arena)
  (use j3.ui.testkit)
  (use uiradio.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field mode string)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field mode (call env "RADIO_MODE")) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (&& (! (call same (. w mode) "rest")) (> (. (. w mode) len) 0)) (block
      (let tabs _ (if-expr (call same (. w mode) "styled") 2 1))
      (for i (.. 0 tabs) (block
        (expr (call (. testkit simKeys) d (. w frame) (+ 3 (* 3 i)) "" "Tab"))))
      (expr (call (. testkit simKeys) d (. w frame) (+ 3 (* 3 tabs)) "" "Down"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uiradio" 400 190 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
