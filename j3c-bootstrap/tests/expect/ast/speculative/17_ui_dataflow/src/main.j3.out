(file (module dataflow)
  (use dataflow.state.State)
  (use dataflow.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.testkit (names clickTag hasText))
  (struct World
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field state (struct-lit State)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (let d _ (& (. (. w root) dom)))
    (let s _ (& (. w state)))
    (+= (. w frame) 1)
    (expr (call clickTag d (. w frame) 3 "button" 1))
    (if (== (. w frame) 7) (block
      (expr (call check w (== (. s slot) 1) "pick(i) from the component's own {#each} carries the index"))))
    (expr (call clickTag d (. w frame) 7 "button" 3))
    (if (== (. w frame) 11) (block
      (expr (call check w (&& (call same (. s name) "bob") (== (. s n) 7)) "two payload fields (string, int)"))))
    (expr (call clickTag d (. w frame) 11 "button" 4))
    (if (== (. w frame) 15) (block
      (expr (call check w (&& (== (. s n) 107) (== (. s slot) 1)) "a plain event next to payload events"))))
    (expr (call clickTag d (. w frame) 15 "button" 5))
    (if (== (. w frame) 19) (block
      (expr (call check w (== (. s sum) 400) "payload emitted from slot content reaches the handler"))))
    (expr (call clickTag d (. w frame) 19 "button" 6))
    (expr (call clickTag d (. w frame) 23 "button" 8))
    (if (== (. w frame) 27) (block
      (expr (call check w (== (. s sum) 402) "inject through slot content and a component in an {#each}"))
      (expr (call check w (call hasText d "d402") "injected state is shared"))
      (if (== (. w fails) 0) (block
        (expr (call printLn "all passed"))))
      (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "dataflow" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
