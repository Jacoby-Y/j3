(file (module idle field)
  (use idle.sim (names Sim BRICK_H COLS FIELD_H FIELD_W ROWS brickPos))
  (use j3.game (names Color Font drawRect drawText rgb setColor))
  (use j3.math.Vec2)
  (struct (doc "Where the field lands on screen: top-left and field-units-to-pixels.") pub View
    (field at Vec2)
    (field scale f32)
    (fn (doc "Fit the field into `size` at `at`, keeping its aspect.") fit (params (at Vec2) (size Vec2)) View (block
      (let sx _ (/ (. size x) FIELD_W))
      (let sy _ (/ (. size y) FIELD_H))
      (let s _ sx)
      (if (< sy s) (block
        (= s sy)))
      (let pad _ (struct-lit Vec2 (field x (/ (- (. size x) (* FIELD_W s)) 2)) (field y (/ (- (. size y) (* FIELD_H s)) 2))))
      (return (struct-lit View (field at (+ at pad)) (field scale s)))))
    (fn toScreen (params (this View) (p Vec2)) Vec2 (block
      (return (+ (. this at) (* p (. this scale))))))
    (fn toField (params (this View) (p Vec2)) Vec2 (block
      (return (* (- p (. this at)) (/ 1 (. this scale)))))))
  (fn (doc "The field fitted into a canvas of `size`.") pub view (params (size Vec2)) View (block
    (return (call (. View fit) (struct-lit Vec2 (field x 0) (field y 0)) size))))
  (fn rowColor (params (row int)) Color (block
    (let colors (array 6 Color) (array-lit (call rgb 243 139 168) (call rgb 250 179 135) (call rgb 249 226 175) (call rgb 166 227 161) (call rgb 137 180 250) (call rgb 203 166 247)))
    (return (index colors (% row 6)))))
  (fn pub draw (params (sim (ref Sim)) (v View) (font Font)) _ (block
    (expr (call setColor (call rgb 24 24 37)))
    (expr (call drawRect (. v at) (* (struct-lit Vec2 (field x FIELD_W) (field y FIELD_H)) (. v scale))))
    (let bw _ (/ FIELD_W (call f32 COLS)))
    (for cell (.. 0 (* ROWS COLS)) (block
      (let hp _ (index (. sim bricks) cell))
      (if (== hp 0) (block
        (continue)))
      (expr (call setColor (call rowColor (/ cell COLS))))
      (let p _ (call (. v toScreen) (+ (call brickPos cell) (struct-lit Vec2 (field x 2) (field y 2)))))
      (expr (call drawRect p (* (struct-lit Vec2 (field x (- bw 4)) (field y (- BRICK_H 4))) (. v scale))))
      (if (&& (. sim showHp) (!= (. font raw) 0)) (block
        (expr (call setColor (call rgb 17 17 27)))
        (expr (call drawText font (+ p (struct-lit Vec2 (field x 4) (field y 1))) (interp hp)))))))
    (expr (call setColor (call rgb 205 214 244)))
    (for i (.. 0 (. sim ballCount)) (block
      (let b _ (index (. sim balls) i))
      (let r _ (. (index (. sim shop) (. b kind)) radius))
      (expr (call drawRect (call (. v toScreen) (- (. b pos) (struct-lit Vec2 (field x r) (field y r)))) (* (struct-lit Vec2 (field x (* r 2)) (field y (* r 2))) (. v scale)))))))))
--- stderr
--- exit 0
