(file (module idle sim)
  (use j3.math (names Vec2 sqrt))
  (use j3.memory.Arena)
  (use j3.rand.Rng)
  (const pub COLS _ 10)
  (const pub ROWS _ 12)
  (const (doc "Field size in field units; field.view fits it into the canvas.") pub FIELD_W f32 (float 0x407f400000000000))
  (const pub FIELD_H f32 (float 0x4085e00000000000))
  (const pub BRICK_H f32 (float 0x4036000000000000))
  (const (doc "Gap above the first brick row.") pub TOP f32 (float 0x4044000000000000))
  (const pub MAX_BALLS _ 200)
  (const (doc "Fixed sim tick (200 Hz), so a run replays the same at any frame rate.") pub TICK f32 (float 0x3f747ae147ae147b))
  (const (doc "Ball kinds, index into `Sim.shop`.") pub BASIC _ 0)
  (const pub FAST _ 1)
  (const pub HEAVY _ 2)
  (const pub SPLASH _ 3)
  (const pub KINDS _ 4)
  (struct pub Ball
    (field pos Vec2)
    (field vel Vec2)
    (field kind int))
  (struct (doc "One buyable ball kind and its two upgrades.") pub Shop
    (field name string)
    (field blurb string)
    (field owned int)
    (field cost int)
    (field damage int)
    (field damageLvl int 1)
    (field damageCost int)
    (field speed f32)
    (field speedLvl int 1)
    (field speedCost int)
    (field radius f32))
  (struct pub Sim
    (field (doc "Hit points per brick, row-major, 0 is empty.") bricks (slice int))
    (field alive int)
    (field balls (slice Ball))
    (field ballCount int 0)
    (field shop (slice Shop))
    (field gold int 0)
    (field (doc "Gold earned this run; prestige pays from it.") earned int 0)
    (field broken int 0)
    (field level int 1)
    (field clickDamage int 1)
    (field clickCost int 25)
    (field (doc "Prestige currency. Each one is +10% gold.") crystals int 0)
    (field prestiges int 0)
    (field (doc "Damage dealt in the current second, and the last full second.") dmgAcc int 0)
    (field dps int 0)
    (field dpsTimer f32 0)
    (field (doc "Scaled time not yet simulated, below one TICK.") acc f32 0)
    (field rng Rng)
    (field paused bool (bool false))
    (field timeScale f32 1)
    (field showHp bool (bool true))
    (field spent int 0)
    (field clicks int 0)
    (field lastClick Vec2)
    (fn new (params (mem (ref Arena))) Sim (block
      (let shop _ (call (. mem alloc) (targs Shop) KINDS))
      (expr (call stockShop shop))
      (let sim _ (struct-lit Sim (field bricks (call (. mem alloc) (targs int) (* COLS ROWS))) (field alive 0) (field balls (call (. mem alloc) (targs Ball) MAX_BALLS)) (field shop shop) (field rng (call (. Rng new) 7)) (field lastClick (struct-lit Vec2 (field x (- 1)) (field y (- 1))))))
      (expr (call (. sim fill)))
      (= (. sim gold) 25)
      (return sim)))
    (fn fill (params (this (ref Sim))) _ (block
      (= (. this alive) 0)
      (for r (.. 0 ROWS) (block
        (for c (.. 0 COLS) (block
          (let hp _ (* (. this level) (+ 1 (/ (- (- ROWS 1) r) 4))))
          (if (== (% (+ (+ c r) (. this level)) 7) 0) (block
            (= hp 0)))
          (= (index (. this bricks) (+ (* r COLS) c)) hp)
          (if (> hp 0) (block
            (+= (. this alive) 1)))))))))
    (fn update (params (this (ref Sim)) (dt f32)) _ (block
      (if (. this paused) (block
        (return)))
      (let frame _ dt)
      (if (> frame (float 0x3fd0000000000000)) (block
        (= frame (float 0x3fd0000000000000))))
      (+= (. this acc) (* frame (. this timeScale)))
      (while (>= (. this acc) TICK) (block
        (-= (. this acc) TICK)
        (expr (call (. this tick)))))))
    (fn tick (params (this (ref Sim))) _ (block
      (for i (.. 0 (. this ballCount)) (block
        (expr (call (. this step) (& (index (. this balls) i)) TICK))))
      (+= (. this dpsTimer) TICK)
      (if (>= (. this dpsTimer) 1) (block
        (= (. this dps) (. this dmgAcc))
        (= (. this dmgAcc) 0)
        (= (. this dpsTimer) 0)))
      (if (== (. this alive) 0) (block
        (+= (. this level) 1)
        (expr (call (. this fill)))))))
    (fn (doc "Move in pieces of at most 8 units, so fast balls can't skip a brick.") step (params (this (ref Sim)) (b (ref Ball)) (dt f32)) _ (block
      (let n _ (+ (call int (/ (* (call (. (. b vel) length)) dt) 8)) 1))
      (for i (.. 0 n) (block
        (expr (call (. this move) b (/ dt (call f32 n))))))))
    (fn move (params (this (ref Sim)) (b (ref Ball)) (dt f32)) _ (block
      (let s _ (index (. this shop) (. b kind)))
      (let old _ (. b pos))
      (= (. b pos) (+ (. b pos) (* (. b vel) dt)))
      (if (|| (< (. (. b pos) x) (. s radius)) (> (. (. b pos) x) (- FIELD_W (. s radius)))) (block
        (= (. (. b vel) x) (- 0 (. (. b vel) x)))
        (= (. (. b pos) x) (. old x))))
      (if (|| (< (. (. b pos) y) (. s radius)) (> (. (. b pos) y) (- FIELD_H (. s radius)))) (block
        (= (. (. b vel) y) (- 0 (. (. b vel) y)))
        (= (. (. b pos) y) (. old y))))
      (let lead _ (* (call (. (. b vel) normalize)) (. s radius)))
      (let cell _ (call cellAt (+ (. b pos) lead)))
      (let was _ (call cellAt (+ old lead)))
      (if (|| (|| (< cell 0) (== (index (. this bricks) cell) 0)) (== was cell)) (block
        (return)))
      (expr (call (. this hit) cell (. s damage)))
      (if (== (. b kind) SPLASH) (block
        (expr (call (. this splash) cell (+ (/ (. s damage) 2) 1)))))
      (if (&& (&& (>= was 0) (!= (% was COLS) (% cell COLS))) (== (/ was COLS) (/ cell COLS))) (block
        (= (. (. b vel) x) (- 0 (. (. b vel) x)))) (block
        (= (. (. b vel) y) (- 0 (. (. b vel) y)))))
      (= (. b pos) old)))
    (fn splash (params (this (ref Sim)) (cell int) (dmg int)) _ (block
      (let r _ (/ cell COLS))
      (let c _ (% cell COLS))
      (if (> c 0) (block
        (expr (call (. this hit) (- cell 1) dmg))))
      (if (< c (- COLS 1)) (block
        (expr (call (. this hit) (+ cell 1) dmg))))
      (if (> r 0) (block
        (expr (call (. this hit) (- cell COLS) dmg))))
      (if (< r (- ROWS 1)) (block
        (expr (call (. this hit) (+ cell COLS) dmg))))))
    (fn hit (params (this (ref Sim)) (cell int) (dmg int)) _ (block
      (let hp _ (index (. this bricks) cell))
      (if (== hp 0) (block
        (return)))
      (let dealt _ dmg)
      (if (> dealt hp) (block
        (= dealt hp)))
      (= (index (. this bricks) cell) (- hp dealt))
      (+= (. this dmgAcc) dealt)
      (if (== (- hp dealt) 0) (block
        (-= (. this alive) 1)
        (+= (. this broken) 1)
        (let pay _ (/ (* (. this level) (+ 10 (. this crystals))) 10))
        (if (< pay 1) (block
          (= pay 1)))
        (+= (. this gold) pay)
        (+= (. this earned) pay)))))
    (fn (doc "Click at a field-space point.") click (params (this (ref Sim)) (at Vec2)) _ (block
      (+= (. this clicks) 1)
      (= (. this lastClick) at)
      (let cell _ (call cellAt at))
      (if (>= cell 0) (block
        (expr (call (. this hit) cell (. this clickDamage)))))))
    (fn spend (params (this (ref Sim)) (cost int)) bool (block
      (if (< (. this gold) cost) (block
        (return (bool false))))
      (-= (. this gold) cost)
      (+= (. this spent) cost)
      (return (bool true))))
    (fn buyBall (params (this (ref Sim)) (kind int)) _ (block
      (let s _ (& (index (. this shop) kind)))
      (if (|| (>= (. this ballCount) MAX_BALLS) (! (call (. this spend) (. s cost)))) (block
        (return)))
      (let angle _ (call (. (. this rng) floatRange) (float 0x400ccccccccccccd) (float 0x4017333333333333)))
      (= (index (. this balls) (. this ballCount)) (struct-lit Ball (field pos (struct-lit Vec2 (field x (/ FIELD_W 2)) (field y (- FIELD_H 40)))) (field vel (* (call (. Vec2 fromAngle) angle) (. s speed))) (field kind kind)))
      (+= (. this ballCount) 1)
      (+= (. s owned) 1)
      (= (. s cost) (+ (/ (* (. s cost) 115) 100) 1))))
    (fn upgradeDamage (params (this (ref Sim)) (kind int)) _ (block
      (let s _ (& (index (. this shop) kind)))
      (if (! (call (. this spend) (. s damageCost))) (block
        (return)))
      (+= (. s damage) (+ (/ (. s damage) 4) 1))
      (+= (. s damageLvl) 1)
      (= (. s damageCost) (/ (* (. s damageCost) 150) 100))))
    (fn upgradeSpeed (params (this (ref Sim)) (kind int)) _ (block
      (let s _ (& (index (. this shop) kind)))
      (if (! (call (. this spend) (. s speedCost))) (block
        (return)))
      (= (. s speed) (* (. s speed) (float 0x3ff199999999999a)))
      (+= (. s speedLvl) 1)
      (= (. s speedCost) (/ (* (. s speedCost) 160) 100))
      (for i (.. 0 (. this ballCount)) (block
        (let b _ (& (index (. this balls) i)))
        (if (== (. b kind) kind) (block
          (= (. b vel) (* (call (. (. b vel) normalize)) (. s speed)))))))))
    (fn upgradeClick (params (this (ref Sim))) _ (block
      (if (! (call (. this spend) (. this clickCost))) (block
        (return)))
      (+= (. this clickDamage) (+ (/ (. this clickDamage) 2) 1))
      (= (. this clickCost) (/ (* (. this clickCost) 140) 100))))
    (fn (doc "Crystals a prestige now would pay.") prestigeGain (params (this (ref Sim))) int (block
      (return (call int (call sqrt (/ (call f32 (. this earned)) 1000))))))
    (fn (doc "Trade the run for crystals. Settings stay.") prestige (params (this (ref Sim))) _ (block
      (let gain _ (call (. this prestigeGain)))
      (if (== gain 0) (block
        (return)))
      (+= (. this crystals) gain)
      (+= (. this prestiges) 1)
      (= (. this gold) 25)
      (= (. this earned) 0)
      (= (. this level) 1)
      (= (. this ballCount) 0)
      (= (. this clickDamage) 1)
      (= (. this clickCost) 25)
      (expr (call stockShop (. this shop)))
      (expr (call (. this fill))))))
  (fn (doc "Starting prices and stats for every ball kind.") stockShop (params (shop (slice Shop))) _ (block
    (= (index shop BASIC) (struct-lit Shop (field name "Basic") (field blurb "Bounces. Hits.") (field owned 0) (field cost 25) (field damage 1) (field damageCost 50) (field speed 260) (field speedCost 40) (field radius 6)))
    (= (index shop FAST) (struct-lit Shop (field name "Fast") (field blurb "Twice the speed, half the punch.") (field owned 0) (field cost 200) (field damage 1) (field damageCost 300) (field speed 520) (field speedCost 250) (field radius 4)))
    (= (index shop HEAVY) (struct-lit Shop (field name "Heavy") (field blurb "Slow and brutal.") (field owned 0) (field cost 1500) (field damage 8) (field damageCost 2000) (field speed 160) (field speedCost 1200) (field radius 10)))
    (= (index shop SPLASH) (struct-lit Shop (field name "Splash") (field blurb "Hits the neighbours too.") (field owned 0) (field cost 8000) (field damage 3) (field damageCost 9000) (field speed 240) (field speedCost 6000) (field radius 7)))))
  (fn (doc "Brick index under a field-space point, or -1.") pub cellAt (params (p Vec2)) int (block
    (if (|| (|| (< (. p x) 0) (>= (. p x) FIELD_W)) (< (. p y) TOP)) (block
      (return (- 1))))
    (let c _ (call int (/ (. p x) (/ FIELD_W (call f32 COLS)))))
    (let r _ (call int (/ (- (. p y) TOP) BRICK_H)))
    (if (>= r ROWS) (block
      (return (- 1))))
    (return (+ (* r COLS) c))))
  (fn (doc "Top-left of brick `cell` in field space.") pub brickPos (params (cell int)) Vec2 (block
    (let w _ (/ FIELD_W (call f32 COLS)))
    (return (struct-lit Vec2 (field x (* (call f32 (% cell COLS)) w)) (field y (+ TOP (* (call f32 (/ cell COLS)) BRICK_H))))))))
--- stderr
--- exit 0
