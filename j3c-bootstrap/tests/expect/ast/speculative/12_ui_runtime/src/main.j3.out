(file (module idle)
  (use idle.field)
  (use idle.sim.Sim)
  (use idle.ui (names Game GameProps))
  (use j3.app.App)
  (use j3.game (names Font loadFont requestQuit windowSize))
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom.Dom)
  (const MODE_APP int 0)
  (const MODE_GOLDEN int 1)
  (const MODE_TEST int 2)
  (const MODE_STEADY int 3)
  (struct World
    (field mem (ref Arena))
    (field sim Sim)
    (field font Font)
    (field root Game)
    (field mode int)
    (field frame int)
    (field fails int)
    (field used0 int)
    (field laid0 int)
    (field restyled0 int)
    (field spent0 int)
    (field gold0 int)
    (field clicks0 int)
    (field px f32)
    (field py f32)
    (field steadyN int))
  (fn (doc "`steady N`: idle frames to run (default 10000; the offscreen GL driver needs about 0.9 ms per frame, so use 5000 under `timeout 10`).") steadyFrames (params) int (block
    (let a _ (call (. sys arg) 2))
    (let n _ 0)
    (for i (.. 0 (. a len)) (block
      (= n (- (+ (* n 10) (call int (index a i))) 48))))
    (if (== n 0) (block
      (return 10000)))
    (return n)))
  (fn boot (params (mem (ref Arena))) World (block
    (let mode _ MODE_APP)
    (let a _ (call (. sys arg) 1))
    (if (call same a "golden") (block
      (= mode MODE_GOLDEN)) (block
      (if (call same a "test") (block
        (= mode MODE_TEST)) (block
        (if (call same a "steady") (block
          (= mode MODE_STEADY)))))))
    (let sim _ (call (. Sim new) mem))
    (= (. sim gold) 500)
    (= (. (index (. sim shop) 0) owned) 1)
    (= (. sim ballCount) 1)
    (return (struct-lit World (field mem mem) (field sim sim) (field font (struct-lit Font (field raw 0))) (field root (call (. Game new) mem)) (field mode mode) (field frame 0) (field fails 0) (field used0 0) (field laid0 0) (field restyled0 0) (field spent0 0) (field gold0 0) (field clicks0 0) (field px (float 0x0000000000000000)) (field py (float 0x0000000000000000)) (field steadyN (call steadyFrames))))))
  (fn load (params (w (ref World))) _ (block
    (= (. w font) (call loadFont "assets/font.ttf" 12))
    (if (!= (. w mode) MODE_APP) (block
      (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4030000000000000)))))))
  (fn check (params (w (ref World)) (ok bool) (name string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " name)))) (block
      (expr (call printLn (interp "FAIL " name)))
      (+= (. w fails) 1)))))
  (struct Count
    (field k int))
  (fn (doc "The `nth` element (document order) with tag `t` and, when `text` is non-empty, first child text `text`.") dfs (params (d (ref Dom)) (id int) (t int) (text string) (nth int) (c (ref Count))) int (block
    (let n _ (index (. (. d nodes) items) id))
    (if (&& (== (. n kind) 0) (! (. n ghost))) (block
      (let hit _ (== (. n tag) t))
      (if (&& hit (> (. text len) 0)) (block
        (= hit (&& (&& (>= (. n first) 0) (== (. (index (. (. d nodes) items) (. n first)) kind) 1)) (call same (call (. d textOf) (. n first)) text)))))
      (if hit (block
        (if (== (. c k) nth) (block
          (return id)))
        (+= (. c k) 1)))
      (let ch _ (. n first))
      (while (>= ch 0) (block
        (let r _ (call dfs d ch t text nth c))
        (if (>= r 0) (block
          (return r)))
        (= ch (. (index (. (. d nodes) items) ch) next))))))
    (return (- 1))))
  (fn findText (params (d (ref Dom)) (tag string) (text string)) int (block
    (let c _ (struct-lit Count (field k 0)))
    (return (call dfs d 0 (call (. d tag) tag) text 0 (& c)))))
  (fn findTag (params (d (ref Dom)) (tag string) (nth int)) int (block
    (let c _ (struct-lit Count (field k 0)))
    (return (call dfs d 0 (call (. d tag) tag) "" nth (& c)))))
  (fn (doc "Aim the script's mouse at the middle of node `id`.") aim (params (w (ref World)) (id int)) _ (block
    (let d _ (& (. (. w root) dom)))
    (= (. w px) (+ (call (. d absX) id) (/ (. (index (. (. d nodes) items) id) w) (float 0x4000000000000000))))
    (= (. w py) (+ (call (. d absY) id) (/ (. (index (. (. d nodes) items) id) h) (float 0x4000000000000000))))))
  (fn near (params (a f32) (b f32)) bool (block
    (let e _ (- a b))
    (if (< e (float 0x0000000000000000)) (block
      (= e (- (float 0x0000000000000000) e))))
    (return (< e (float 0x3fe3333333333333)))))
  (fn (doc "One synthetic mouse step: position and button for this frame.") mouse (params (w (ref World)) (p Vec2) (down bool)) _ (block
    (expr (call (. (. (. w root) dom) simInput) (. p x) (. p y) down (float 0x0000000000000000)))
    (= (. w px) (. p x))
    (= (. w py) (. p y))))
  (fn off (params (w (ref World))) _ (block
    (expr (call (. (. (. w root) dom) simInput) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) (bool false) (float 0x0000000000000000)))))
  (fn (doc "Click = move, press, release over three frames starting at `f0`; returns true on the frame\nafter the release (results are visible).") clickAt (params (w (ref World)) (f0 int) (p Vec2)) bool (block
    (let f _ (- (. w frame) f0))
    (if (== f 0) (block
      (expr (call mouse w p (bool false)))) (block
      (if (== f 1) (block
        (expr (call mouse w p (bool true)))) (block
        (if (== f 2) (block
          (expr (call mouse w p (bool false)))) (block
          (expr (call off w))))))))
    (return (== f 3))))
  (fn (doc "The scripted run. Each stage waits for a layout, aims at a node found by text, then checks the sim.") script (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (let sim _ (& (. w sim)))
    (let f _ (. w frame))
    (if (< f 4) (block
      (expr (call off w))
      (return)))
    (if (< f 10) (block
      (if (== f 4) (block
        (= (. w spent0) (. sim spent))
        (= (. w gold0) (. sim gold))
        (let b _ (call findText d "button" (interp (. sim clickCost))))
        (if (< b 0) (block
          (expr (call check w (bool false) "found the UpgradeRow button"))
          (expr (call requestQuit))
          (return)))
        (expr (call aim w b))))
      (if (call clickAt w 4 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (&& (> (- (. sim spent) (. w spent0)) 0) (== (- (. w gold0) (. sim gold)) (- (. sim spent) (. w spent0)))) "click on UpgradeRow raises spent (parent on:buy ran)"))))
      (return)))
    (if (< f 18) (block
      (if (== f 10) (block
        (= (. sim gold) 0)))
      (if (< f 12) (block
        (expr (call off w))
        (return)))
      (if (== f 12) (block
        (= (. w spent0) (. sim spent))
        (expr (call aim w (call findText d "button" (interp (. sim clickCost)))))))
      (if (call clickAt w 12 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (== (. sim spent) (. w spent0)) "disabled button ignores the click"))
        (= (. sim gold) 5000)))
      (return)))
    (if (< f 24) (block
      (let cv _ (call findTag d "canvas" 0))
      (if (== f 18) (block
        (= (. w clicks0) (. sim clicks))
        (= (. w px) (+ (call (. d absX) cv) (float 0x4060400000000000)))
        (= (. w py) (+ (call (. d absY) cv) (float 0x4069000000000000)))))
      (if (call clickAt w 18 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (let want _ (call (. (call (. field view) (call (. d size) cv)) toField) (struct-lit Vec2 (field x (float 0x4060400000000000)) (field y (float 0x4069000000000000)))))
        (expr (call check w (== (. sim clicks) (+ (. w clicks0) 1)) "click on the canvas reaches on:mousedown"))
        (expr (call check w (&& (call near (. (. sim lastClick) x) (. want x)) (call near (. (. sim lastClick) y) (. want y))) "canvas mouse is canvas-local"))))
      (return)))
    (if (< f 30) (block
      (if (== f 24) (block
        (= (. w clicks0) (. sim clicks))
        (let lv _ (call findText d "span" "Level 1"))
        (expr (call aim w (. (index (. (. d nodes) items) lv) parent)))))
      (if (call clickAt w 24 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (== (. sim clicks) (. w clicks0)) "click on the HUD does not reach the canvas"))))
      (return)))
    (if (< f 36) (block
      (if (== f 30) (block
        (expr (call aim w (call findText d "button" "Settings")))))
      (if (call clickAt w 30 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (== (. (. (. w root) c1) tab) 1) "nav button sets the Sidebar let (tab == 1)"))))
      (return)))
    (if (< f 42) (block
      (if (== f 36) (block
        (expr (call aim w (call findTag d "input" 0)))))
      (if (call clickAt w 36 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (. sim paused) "bind:checked toggles sim.paused"))))
      (return)))
    (if (< f 50) (block
      (let rg _ (call findTag d "input" 1))
      (let x0 _ (call (. d absX) rg))
      (let ww _ (. (index (. (. d nodes) items) rg) w))
      (let y _ (+ (call (. d absY) rg) (/ (. (index (. (. d nodes) items) rg) h) (float 0x4000000000000000))))
      (if (== f 42) (block
        (expr (call mouse w (struct-lit Vec2 (field x (+ x0 (* ww (float 0x3fb999999999999a)))) (field y y)) (bool false)))) (block
        (if (== f 43) (block
          (expr (call mouse w (struct-lit Vec2 (field x (+ x0 (* ww (float 0x3fb999999999999a)))) (field y y)) (bool true)))) (block
          (if (== f 44) (block
            (expr (call mouse w (struct-lit Vec2 (field x (+ x0 (* ww (float 0x3fe999999999999a)))) (field y y)) (bool true)))) (block
            (if (== f 45) (block
              (expr (call mouse w (struct-lit Vec2 (field x (+ x0 (* ww (float 0x3fe999999999999a)))) (field y y)) (bool false)))) (block
              (if (== f 47) (block
                (expr (call check w (call near (. sim timeScale) (float 0x400c000000000000)) (interp "bind:value follows the drag (timeScale " (. sim timeScale) ")")))
                (let ov _ (call findText d "button" "Resume"))
                (expr (call check w (>= ov 0) "overlay with transition:fade is in the tree while paused"))
                (expr (call aim w ov))) (block
                (expr (call off w))))))))))))
      (return)))
    (if (< f 54) (block
      (if (call clickAt w 50 (struct-lit Vec2 (field x (. w px)) (field y (. w py)))) (block
        (expr (call check w (! (. sim paused)) "Resume (in the canvas, in the if-block) sets sim.paused = false"))))
      (return)))
    (if (< f 80) (block
      (expr (call off w))
      (if (== f 56) (block
        (expr (call check w (== (. d ghosts) 1) (interp "leaving the if-block keeps a ghost for the fade (ghosts " (. d ghosts) ")")))))
      (if (== f 79) (block
        (expr (call check w (== (. d ghosts) 0) (interp "ghost removed after its fade (ghosts " (. d ghosts) ")")))
        (expr (call check w (< (call findText d "button" "Resume") 0) "overlay gone from the tree"))
        (expr (call printLn (interp "script done, " (. w fails) " failures")))
        (expr (call requestQuit))))))))
  (fn steady (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (expr (call off w))
    (if (== (. w frame) 40) (block
      (= (. w used0) (. (. w mem) used))
      (= (. w laid0) (. d laid))
      (= (. w restyled0) (. d restyled))))
    (if (== (. w frame) (+ 40 (. w steadyN))) (block
      (expr (call printLn (interp "steady: " (- (. w frame) 40) " idle frames, layouts " (- (. d laid) (. w laid0)) ", style recomputes " (- (. d restyled) (. w restyled0)) ", arena growth " (- (. (. w mem) used) (. w used0)) " bytes, nodes " (call (. d count)))))
      (expr (call requestQuit))))))
  (fn draw (params (w (ref World))) _ (block
    (+= (. w frame) 1)
    (if (== (. w mode) MODE_TEST) (block
      (expr (call script w))) (block
      (if (|| (== (. w mode) MODE_STEADY) (== (. w mode) MODE_GOLDEN)) (block
        (expr (call (. (. (. w root) dom) simInput) (- (float 0x4024000000000000)) (- (float 0x4024000000000000)) (bool false) (float 0x0000000000000000)))
        (if (== (. w mode) MODE_STEADY) (block
          (expr (call steady w))))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit GameProps (field sim (& (. w sim))) (field font (. w font)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) createSized) "idle breakout" 1280 760 (* (* 64 1024) 1024) boot))
    (expr (call (. app useGl)))
    (expr (call (. app startup) load))
    (expr (call (. app draw) draw))
    (expr (call (. app run)))
    (if (> (. (. app world) fails) 0) (block
      (expr (call (. sys exit) 1)))))))
--- stderr
--- exit 0
