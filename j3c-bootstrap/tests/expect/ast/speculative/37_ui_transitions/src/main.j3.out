(file (module transitions_probe)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.testkit)
  (use transitions_probe.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field frame 0) (field used 0) (field laid 0) (field styles 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field on (&& (>= (. w frame) 6) (< (. w frame) 30))))))
    (if (== (. w frame) 50) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))))
    (if (&& (> (. w frame) 50) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "transitions steady frame changed layout style or allocation"))))
    (if (== (. w frame) 60) (block
      (expr (call printLn "transitions_probe ok: enter and leave, steady frames"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "transitions probe" 340 260 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
