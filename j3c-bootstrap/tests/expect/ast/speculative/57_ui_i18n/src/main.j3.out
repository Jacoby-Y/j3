(file (module uii18n)
  (use j3.app.App)
  (use j3.game (names clearTo env Color windowSize))
  (use j3.i18n)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.text.same)
  (use uii18n.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (let loc _ (call env "LOCALE"))
    (if (> (. loc len) 0) (block
      (expr (call (. i18n setLocale) loc))))
    (return (struct-lit World (field root root) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field n 3))))
    (if (&& (== (. w frame) 2) (call same (call env "LOCALE") "")) (block
      (expr (call (. i18n setLocale) "de"))))
    (if (== (. w frame) 100) (block
      (expr (call printLn "uii18n ok"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uii18n" 360 200 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
