(file (module uitabindex)
  (use j3.app.App)
  (use j3.game (names clearTo Color windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.text.same)
  (use j3.ui.testkit)
  (use uitabindex.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int)
    (field seen (array 8 u8))
    (field n int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field frame 0) (field seen (array-lit 0 0 0 0 0 0 0 0)) (field n 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let f _ (. w frame))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (&& (&& (>= f 5) (< f 40)) (== (% f 5) 0)) (block
      (expr (call (. testkit simKeys) d f f "" (if-expr (== f 35) "S+Tab" "Tab")))))
    (if (&& (&& (&& (>= f 6) (< f 40)) (== (% f 5) 1)) (>= (call (. d focused)) 0)) (block
      (let t _ (call (. d textOf) (. (index (. (. d nodes) items) (call (. d focused))) first)))
      (= (index (. w seen) (. w n)) (index t 0))
      (+= (. w n) 1)))
    (if (== f 60) (block
      (let good _ (&& (&& (&& (&& (&& (&& (&& (== (. w n) 7) (== (index (. w seen) 0) 98)) (== (index (. w seen) 1) 99)) (== (index (. w seen) 2) 97)) (== (index (. w seen) 3) 100)) (== (index (. w seen) 4) 101)) (== (index (. w seen) 5) 98)) (== (index (. w seen) 6) 101)))
      (expr (call printLn (if-expr good "uitabindex ok" "uitabindex FAIL")))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uitabindex" 360 200 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
