(file (module popups)
  (use popups.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names env windowSize))
  (use j3.memory.Arena)
  (use j3.text.same)
  (struct World
    (field root Screen)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field root (call (. Screen new) mem)) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (let mode _ (call env "POP_GOLDEN"))
    (let themed _ (|| (|| (call same mode "themed") (call same mode "color-themed")) (call same mode "coexist")))
    (let color _ (|| (|| (call same mode "color") (call same mode "color-themed")) (call same mode "coexist")))
    (let x f32 (if-expr color (float 0x404e000000000000) (float 0x4079000000000000)))
    (let y f32 (float 0x4042000000000000))
    (if (&& color (>= (. w frame) 7)) (block
      (= x (if-expr (call same mode "coexist") (float 0x4079000000000000) (float 0x4082c00000000000)))
      (= y (if-expr (call same mode "coexist") (float 0x4042000000000000) (float 0x407b800000000000)))))
    (expr (call (. (. (. w root) dom) simInput) x y (&& color (== (. w frame) 4)) (float 0x0000000000000000)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field themed themed) (field long (! (call same mode "tooltip"))))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "popups" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
