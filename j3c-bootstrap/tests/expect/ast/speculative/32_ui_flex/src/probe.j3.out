(file (module flex_probe probe)
  (use j3.sys.panic)
  (mod-let COUNT int _)
  (mod-let SEEN (array 6 int) _)
  (fn pub reset (params) _ (block
    (= COUNT 0)))
  (fn pub mark (params (id int)) _ (block
    (if (>= COUNT 6) (block
      (expr (call panic "duplicate canvas callback"))))
    (= (index SEEN COUNT) id)
    (+= COUNT 1)))
  (fn pub verify (params (flip bool) (show bool)) _ (block
    (let expected (array 6 int) (if-expr flip (array-lit 1 5 6 2 4 3) (array-lit 5 6 2 4 3 1)))
    (if (! show) (block
      (= expected (array-lit 1 5 4 3 0 0))))
    (let count _ (if-expr show 6 4))
    (if (!= COUNT count) (block
      (expr (call panic "missing canvas callback"))))
    (for i (.. 0 count) (block
      (if (!= (index SEEN i) (index expected i)) (block
        (expr (call panic "canvas callbacks out of visual order")))))))))
--- stderr
--- exit 0
