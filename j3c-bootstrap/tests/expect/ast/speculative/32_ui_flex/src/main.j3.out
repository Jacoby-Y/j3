(file (module flex_probe)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.css.P_BACKGROUND)
  (use flex_probe.probe)
  (use flex_probe.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field frame 0) (field used 0) (field laid 0) (field styles 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (let flip _ (>= (. w frame) 3))
    (expr (call (. d simInput) (if-expr (>= (. w frame) 13) (float 0x4057c00000000000) (float 0x4034000000000000)) (if-expr (>= (. w frame) 13) (float 0x4065e00000000000) (float 0x4034000000000000)) (bool false) (float 0x0000000000000000)))
    (expr (call (. probe reset)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field flip flip) (field show (|| (< (. w frame) 6) (>= (. w frame) 9))) (field rotate (>= (. w frame) 12)))))
    (expr (call (. probe verify) flip (|| (< (. w frame) 6) (>= (. w frame) 9))))
    (if (|| (== (. w frame) 2) (&& (>= (. w frame) 4) (< (. w frame) 13))) (block
      (if (< (. d hover) 0) (block
        (expr (call panic "ordered overlap missed by hit test"))))
      (let color _ (call (. (. d css) get) (. (index (. (. d nodes) items) (. d hover)) style) P_BACKGROUND))
      (if (!= (. color c) (if-expr flip 52479 3422552319)) (block
        (expr (call panic "hit order differs from paint order"))))))
    (if (&& (>= (. w frame) 14) (|| (< (. d hover) 0) (!= (. (call (. (. d css) get) (. (index (. (. d nodes) items) (. d hover)) style) P_BACKGROUND) c) 3422552319))) (block
      (expr (call panic "reverse geometry changed order paint/hit priority"))))
    (if (== (. w frame) 15) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))))
    (if (&& (> (. w frame) 15) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "ordered flex steady frame changed layout style or allocation"))))
    (if (== (. w frame) 30) (block
      (expr (call printLn "flex_probe ok: canvas callbacks, conditional reentry/component/nested slot/keyed move order, 300 ordinary ordered children, steady frames"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "flex probe" 320 680 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
