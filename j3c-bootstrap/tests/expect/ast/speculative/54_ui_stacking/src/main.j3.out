(file (module uistacking)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color env))
  (use j3.text.same)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use uistacking.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field mode string)
    (field frame int)
    (field builds int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field root root) (field mode (call env "STACK_MODE")) (field frame 0) (field builds 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (if (&& (call same (. w mode) "hover") (>= (. w frame) 3)) (block
      (expr (call (. d simInput) (float 0x4050400000000000) (float 0x4049000000000000) (bool false) (float 0x0000000000000000)))) (block
      (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 40) (block
      (= (. w builds) (. d stackBuilds))))
    (if (&& (> (. w frame) 40) (!= (. d stackBuilds) (. w builds))) (block
      (expr (call panic "uistacking idle frame rebuilt the stacking lists"))))
    (if (&& (&& (call same (. w mode) "hover") (== (. w frame) 10)) (< (. d hover) 0)) (block
      (expr (call panic "uistacking hover found nothing"))))
    (if (== (. w frame) 100) (block
      (expr (call printLn "uistacking ok"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uistacking" 640 330 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
