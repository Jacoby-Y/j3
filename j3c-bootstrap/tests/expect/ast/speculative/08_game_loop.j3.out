(file (module speculative game_loop)
  (use j3.game)
  (use j3.io.printLn)
  (use j3.math.Vec2)
  (use j3.memory.Arena)
  (struct World
    (field pos (slice Vec2))
    (field vel (slice Vec2))
    (field count int))
  (struct Game
    (field mem (ref Arena))
    (field world World)
    (field running bool))
  (fn moveSystem (params (world (ref World)) (dt f32)) _ (block
    (for i (.. 0 (. world count)) (block
      (= (index (. world pos) i) (+ (index (. world pos) i) (* (index (. world vel) i) dt)))))))
  (fn boot (params (mem (ref Arena))) Game (block
    (let pos _ (call (. mem alloc) (targs Vec2) 256))
    (let vel _ (call (. mem alloc) (targs Vec2) 256))
    (= (index pos 0) (struct-lit Vec2 (field x 40) (field y 40)))
    (= (index vel 0) (struct-lit Vec2 (field x 60) (field y 0)))
    (return (struct-lit Game (field mem mem) (field world (struct-lit World (field pos pos) (field vel vel) (field count 1))) (field running (bool true))))))
  (fn tick (params (g (ref Game)) (dt f32)) _ (block
    (let frame _ (call (. (. g mem) checkpoint)))
    (defer (block
      (expr (call (. (. g mem) rewind) frame))))
    (if (|| (call (. game quitRequested)) (call (. game keyDown) (. (. game Key) Escape))) (block
      (= (. g running) (bool false))
      (return)))
    (let systems (slice (fn-type ((ref World) f32) _)) (array-lit moveSystem))
    (for-each _ sys systems (block
      (expr (call sys (& (. g world)) dt))))
    (expr (call (. game clear)))
    (for i (.. 0 (. (. g world) count)) (block
      (expr (call (. game drawRect) (index (. (. g world) pos) i) (struct-lit Vec2 (field x 8) (field y 8))))))))
  (fn main (params) _ (block
    (let mem _ (call (. Arena create) (* (* 16 1024) 1024)))
    (defer (block
      (expr (call (. mem destroy)))))
    (let g _ (call boot (& mem)))
    (while (. g running) (block
      (expr (call tick (& g) (call (. game poll))))
      (expr (call (. game present)))))
    (expr (call printLn "bye")))))
--- stderr
--- exit 0
