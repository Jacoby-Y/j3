(file (module speculative control)
  (use j3.io.printLn)
  (fn abs (params (n int)) int (block
    (return (if-expr (< n 0) (- n) n))))
  (fn main (params) _ (block
    (let hp _ 3)
    (let invincible _ (bool false))
    (if (&& (<= hp 0) (! invincible)) (block
      (expr (call printLn "dead"))) (block
      (if invincible (block
        (expr (call printLn "cheat"))) (block
        (expr (call printLn (interp "hp=" hp)))))))
    (let n _ 3)
    (while (> n 0) (block
      (expr (call printLn (interp "n=" n)))
      (-= n 1)))
    (expr (call printLn (interp "abs=" (call abs (- 4)))))
    (for i (.. 0 5) (block
      (if (== i 2) (block
        (continue)))
      (if (== i 4) (block
        (break)))
      (expr (call printLn (interp "i=" i)))))
    (let name _ "player")
    (defer (block
      (expr (call printLn "leaving main"))))
    (expr (call printLn (interp "hello " name))))))
--- stderr
--- exit 0
