(file (module lists)
  (use lists.state (names Group Item State))
  (use lists.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names micros windowSize))
  (use j3.rand.Rng)
  (use j3.io.printLn)
  (use j3.memory (names Arena rewindScratch))
  (use j3.sys)
  (use j3.text (names Text scratchText))
  (use j3.ui.dom.Dom)
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int)
    (field used int)
    (field mark int)
    (field b200 int)
    (field b300 int)
    (field destroys0 int)
    (field (doc "DOM node of the row first seen for item id") node (slice int)))
  (fn boot (params (mem (ref Arena))) World (block
    (let w _ (struct-lit World (field mem mem) (field state (call (. State new) mem)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0) (field used 0) (field mark 0) (field b200 0) (field b300 0) (field destroys0 0) (field node (call (. mem alloc) (targs int) 4096))))
    (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4024000000000000)))
    (return w)))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn (doc "`v` as text in `mem` (a template's buffer is reused by the next one).") text (params (mem (ref Arena)) (v int)) string (block
    (let t _ (interp v))
    (let b _ (call (. mem alloc) (targs u8) (. t len)))
    (for i (.. 0 (. t len)) (block
      (= (index b i) (index t i))))
    (return (as b string))))
  (fn (doc "\"5,4,3\" to items with those ids (name = the id as text).") items (params (mem (ref Arena)) (spec string)) (slice Item) (block
    (let n _ 0)
    (let i _ 0)
    (while (< i (. spec len)) (block
      (if (== (index spec i) 44) (block
        (+= n 1)))
      (+= i 1)))
    (if (== (. spec len) 0) (block
      (return (call (. mem alloc) (targs Item) 0))))
    (let out _ (call (. mem alloc) (targs Item) (+ n 1)))
    (let k _ 0)
    (let v _ 0)
    (= i 0)
    (while (<= i (. spec len)) (block
      (if (|| (== i (. spec len)) (== (index spec i) 44)) (block
        (= (index out k) (struct-lit Item (field id v) (field name (call text mem v))))
        (+= k 1)
        (= v 0)) (block
        (= v (+ (* v 10) (as (- (index spec i) 48) int)))))
      (+= i 1)))
    (return out)))
  (fn range (params (mem (ref Arena)) (lo int) (n int)) (slice Item) (block
    (let out _ (call (. mem alloc) (targs Item) n))
    (for i (.. 0 n) (block
      (= (index out i) (struct-lit Item (field id (+ lo i)) (field name (call text mem (+ lo i)))))))
    (return out)))
  (fn two (params (mem (ref Arena)) (a Group) (b Group)) (slice Group) (block
    (let out _ (call (. mem alloc) (targs Group) 2))
    (= (index out 0) a)
    (= (index out 1) b)
    (return out)))
  (fn group (params (id int) (rows (slice Item))) Group (block
    (return (struct-lit Group (field id id) (field rows rows)))))
  (fn (doc "The nth child list of the Screen's wrapper div: root > div > div.rows / .groups / .outer.") list (params (d (ref Dom)) (n int)) int (block
    (let c _ (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) 0) first)) first))
    (for i (.. 0 n) (block
      (= c (. (index (. (. d nodes) items) c) next))))
    (return c)))
  (fn (doc "Append `s` to a comma list (on the frame scratch, so the result outlives these helpers).") join (params (out (ref Text)) (s string)) _ (block
    (if (> (. (. out bytes) len) 0) (block
      (expr (call (. out push) (char 44)))))
    (expr (call (. out fmt) s))))
  (fn (doc "The rows (`<p>`) under `parent`, left to right, as \"id,id,...\" read from their text.") names (params (d (ref Dom)) (parent int)) string (block
    (let out _ (call scratchText))
    (let c _ (. (index (. (. d nodes) items) parent) first))
    (while (>= c 0) (block
      (let sp _ (. (index (. (. d nodes) items) c) last))
      (let s _ (call (. d textOf) (. (index (. (. d nodes) items) sp) first)))
      (expr (call join (& out) s))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (call (. out str)))))
  (fn (doc "`names` that also walks into `<section>`s.") leafNames (params (d (ref Dom)) (parent int)) string (block
    (let out _ (call scratchText))
    (let c _ (. (index (. (. d nodes) items) parent) first))
    (while (>= c 0) (block
      (let s _ "")
      (if (== (. (index (. (. d nodes) items) c) tag) (call (. d tag) "p")) (block
        (= s (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) last)) first)))) (block
        (= s (call leafNames d c))))
      (if (> (. s len) 0) (block
        (expr (call join (& out) s))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (call (. out str)))))
  (fn (doc "The `<p>` rows under `parent` (skipping `<small>` markers), and whether each is the node it was first.") pNames (params (d (ref Dom)) (parent int)) string (block
    (let out _ (call scratchText))
    (let c _ (. (index (. (. d nodes) items) parent) first))
    (while (>= c 0) (block
      (if (== (. (index (. (. d nodes) items) c) tag) (call (. d tag) "p")) (block
        (let s _ (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) last)) first)))
        (expr (call join (& out) s))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (call (. out str)))))
  (fn (doc "\"e\" markers (even ids) sit right before their row, \"t\" (<h2>) markers (multiples of 3) right after.") markersOk (params (d (ref Dom)) (parent int)) bool (block
    (let c _ (. (index (. (. d nodes) items) parent) first))
    (while (>= c 0) (block
      (if (== (. (index (. (. d nodes) items) c) tag) (call (. d tag) "p")) (block
        (let s _ (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) last)) first)))
        (let id _ 0)
        (for i (.. 0 (. s len)) (block
          (= id (+ (* id 10) (as (- (index s i) 48) int)))))
        (let pv _ (. (index (. (. d nodes) items) c) prev))
        (let nx _ (. (index (. (. d nodes) items) c) next))
        (let wantE _ (== (% id 2) 0))
        (let wantT _ (== (% id 3) 0))
        (let hasE _ (&& (>= pv 0) (== (. (index (. (. d nodes) items) pv) tag) (call (. d tag) "small"))))
        (let hasT _ (&& (>= nx 0) (== (. (index (. (. d nodes) items) nx) tag) (call (. d tag) "h2"))))
        (if (|| (!= hasE wantE) (!= hasT wantT)) (block
          (return (bool false))))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (return (bool true))))
  (fn same (params (a string) (b string)) bool (block
    (if (!= (. a len) (. b len)) (block
      (return (bool false))))
    (for i (.. 0 (. a len)) (block
      (if (!= (index a i) (index b i)) (block
        (return (bool false))))))
    (return (bool true))))
  (fn (doc "Every row in list 0 is the DOM node it had when first seen (the node moved, it wasn't rebuilt).") nodesFollow (params (w (ref World))) bool (block
    (let d _ (& (. (. w root) dom)))
    (let ok _ (bool true))
    (let c _ (. (index (. (. d nodes) items) (call list d 0)) first))
    (while (>= c 0) (block
      (let sp _ (. (index (. (. d nodes) items) c) last))
      (let s _ (call (. d textOf) (. (index (. (. d nodes) items) sp) first)))
      (let id _ 0)
      (for i (.. 0 (. s len)) (block
        (= id (+ (* id 10) (as (- (index s i) 48) int)))))
      (if (&& (!= (index (. w node) id) 0) (!= (index (. w node) id) c)) (block
        (= ok (bool false))))
      (= (index (. w node) id) c)
      (= c (. (index (. (. d nodes) items) c) next))))
    (return ok)))
  (fn births (params (w (ref World)) (a int) (b int)) bool (block
    (let s _ (& (. w state)))
    (return (== (index (. s birth) a) b))))
  (fn (doc "10000 keyed rows (with optional marker nodes, so a row is a run of 1-3 nodes) shuffled in one frame:\neach row keeps its DOM node, the order follows, and the frame is fast (linear: was quadratic in the\nkey match and in `keyBegin`'s run search).") shuffle10k (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (let d _ (& (. (. w root) dom)))
    (let n _ 10000)
    (let rows _ (call range (. w mem) 0 n))
    (= (. s mixed) rows)
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (let before _ (call (. (. w mem) alloc) (targs int) n))
    (let c _ (. (index (. (. d nodes) items) (call list d 3)) first))
    (let k _ 0)
    (while (>= c 0) (block
      (if (== (. (index (. (. d nodes) items) c) tag) (call (. d tag) "p")) (block
        (= (index before k) c)
        (+= k 1)))
      (= c (. (index (. (. d nodes) items) c) next))))
    (expr (call check w (== k n) "10000 keyed rows rendered"))
    (let order _ (call (. (. w mem) alloc) (targs Item) n))
    (for i (.. 0 n) (block
      (= (index order i) (index rows i))))
    (let rng _ (call (. Rng new) 777))
    (let i _ (- n 1))
    (while (> i 0) (block
      (let j _ (call (. rng intRange) 0 (+ i 1)))
      (let t _ (index order i))
      (= (index order i) (index order j))
      (= (index order j) t)
      (-= i 1)))
    (= (. s mixed) order)
    (let t0 _ (call micros))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (let us _ (- (call micros) t0))
    (expr (call printLn (interp "10000 keyed rows shuffled in one frame: " us " us")))
    (let ok _ (bool true))
    (= c (. (index (. (. d nodes) items) (call list d 3)) first))
    (= k 0)
    (while (>= c 0) (block
      (if (== (. (index (. (. d nodes) items) c) tag) (call (. d tag) "p")) (block
        (if (|| (>= k n) (!= (index before (. (index order k) id)) c)) (block
          (= ok (bool false))))
        (+= k 1)))
      (= c (. (index (. (. d nodes) items) c) next))))
    (expr (call check w (&& ok (== k n)) "10000 shuffled rows: every row kept its node, in the new order"))
    (expr (call check w (call markersOk d (call list d 3)) "10000 shuffled rows: markers stay with their rows"))
    (expr (call check w (< us 500000) "10000-row shuffle frame is well under half a second"))
    (= (. s mixed) (call (. (. w mem) alloc) (targs Item) 0))))
  (fn (doc "10000 frames of insert-one-remove-one in a keyed list, and of replacing the groups (rows nested in\nrows) so the nested rows die with their parent. Row ids must be reused: the id table stops growing.\nDead rows (struct and component state) are pooled, so the arena stops growing too.") churn (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (let ra _ (call (. (. w mem) alloc) (targs Item) 5))
    (let gs _ (call (. (. w mem) alloc) (targs Group) 2))
    (for g (.. 0 2) (block
      (= (index gs g) (struct-lit Group (field id 0) (field rows (call (. (. w mem) alloc) (targs Item) 3))))))
    (= (. s flag) (bool false))
    (= (. s mixed) (call (. (. w mem) alloc) (targs Item) 0))
    (= (. s extra) (call (. (. w mem) alloc) (targs Item) 0))
    (= (. s cards) (call (. (. w mem) alloc) (targs Item) 0))
    (= (. s outer) (call (. (. w mem) alloc) (targs Group) 0))
    (let fa _ (call (. (. w mem) alloc) (targs Item) 3))
    (= (. s fades) fa)
    (= (. s rows) ra)
    (= (. s groups) gs)
    (let ids0 _ (. (. (. (. w root) dom) gpar) len))
    (for n (.. 0 10000) (block
      (for i (.. 0 5) (block
        (= (index ra i) (struct-lit Item (field id (+ 1000 (% (+ n i) 3000))) (field name "x")))))
      (for i (.. 0 3) (block
        (= (index fa i) (struct-lit Item (field id (+ 2000 (% (+ n i) 500))) (field name "f")))))
      (for g (.. 0 2) (block
        (= (. (index gs g) id) (+ (+ 5000 (* n 2)) g))
        (for i (.. 0 3) (block
          (= (index (. (index gs g) rows) i) (struct-lit Item (field id (+ 100 (% (+ (+ n i) (* g 3)) 800))) (field name "x")))))))
      (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
      (if (== n 200) (block
        (= (. w used) (. (. w mem) used))))))
    (expr (call check w (< (- (. (. w mem) used) (. w used)) 1024) "10000 churned frames: dead rows are pooled, the arena stops growing"))
    (expr (call check w (< (- (. (. (. (. w root) dom) gpar) len) ids0) 64) "10000 churned frames reuse row ids (fade ghosts included)"))))
  (fn draw (params (w (ref World))) _ (block
    (let s _ (& (. w state)))
    (let d _ (& (. (. w root) dom)))
    (let f _ (. w frame))
    (if (== f 0) (block
      (= (. s rows) (call items (. w mem) "1,2,3,4,5"))
      (= (. s groups) (call two (. w mem) (call group 1 (call items (. w mem) "11,12")) (call group 2 (call items (. w mem) "13"))))
      (= (. s outer) (call two (. w mem) (call group 1 (call items (. w mem) "41,42")) (call group 2 (call items (. w mem) "43"))))) (block
      (if (== f 2) (block
        (= (. s rows) (call items (. w mem) "5,4,3,2,1"))
        (= (. s groups) (call two (. w mem) (call group 2 (call items (. w mem) "13")) (call group 1 (call items (. w mem) "12,11"))))) (block
        (if (== f 3) (block
          (= (. s rows) (call items (. w mem) "5,3,1"))) (block
          (if (== f 4) (block
            (= (. s rows) (call items (. w mem) "5,9,3,7,1"))) (block
            (if (== f 5) (block
              (= (. s rows) (call items (. w mem) ""))) (block
              (if (== f 6) (block
                (= (. s rows) (call items (. w mem) "20,21"))) (block
                (if (== f 7) (block
                  (= (. s rows) (call items (. w mem) "30,30,31"))) (block
                  (if (== f 9) (block
                    (= (. s rows) (call range (. w mem) 100 1000))) (block
                    (if (== f 13) (block
                      (= (. s rows) (call items (. w mem) "1"))
                      (= (. s mixed) (call items (. w mem) "1,2,3,4,6"))
                      (= (. s extra) (call items (. w mem) "200,201"))
                      (= (. s cards) (call items (. w mem) "300,301"))
                      (= (. s flag) (bool true))) (block
                      (if (== f 14) (block
                        (= (. s mixed) (call items (. w mem) "6,4,3,2,1"))) (block
                        (if (== f 15) (block
                          (= (. s flag) (bool false))) (block
                          (if (== f 16) (block
                            (= (. s flag) (bool true))) (block
                            (if (== f 17) (block
                              (= (. s cards) (call items (. w mem) "301,300"))) (block
                              (if (== f 18) (block
                                (= (. s fades) (call items (. w mem) "1,2,3"))) (block
                                (if (== f 19) (block
                                  (= (. s fades) (call items (. w mem) "3,2,1"))) (block
                                  (if (== f 20) (block
                                    (= (. s fades) (call items (. w mem) "3,1"))))))))))))))))))))))))))))))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (if (== f 0) (block
      (expr (call check w (&& (== (. s mounts) (+ (+ 5 3) 3)) (== (. s destroys) 0)) "first frame mounts every row once"))
      (expr (call check w (call same (call names d (call list d 0)) "1,2,3,4,5") "rows in order"))
      (expr (call check w (call nodesFollow w) "record row nodes"))
      (= (. w used) (. (. w mem) used))) (block
      (if (== f 1) (block
        (expr (call check w (&& (== (. s mounts) 11) (== (. s destroys) 0)) "idle frame mounts and destroys nothing"))
        (expr (call check w (== (. (. w mem) used) (. w used)) "idle frame allocates nothing"))) (block
        (if (== f 2) (block
          (expr (call check w (call same (call names d (call list d 0)) "5,4,3,2,1") "reversed rows are in the new order"))
          (expr (call check w (&& (== (. s mounts) 11) (== (. s destroys) 0)) "reverse mounts and destroys nothing"))
          (expr (call check w (&& (call births w 1 1) (call births w 5 5)) "instance state follows the key through a reverse"))
          (expr (call check w (call nodesFollow w) "DOM nodes follow the key through a reverse"))
          (expr (call check w (&& (&& (&& (call births w 11 6) (call births w 12 7)) (call births w 13 8)) (call births w 43 11)) "nested keyed lists keep their rows"))
          (expr (call check w (call same (call leafNames d (call list d 1)) "13,12,11") "groups reordered with their rows"))) (block
          (if (== f 3) (block
            (expr (call check w (&& (call same (call names d (call list d 0)) "5,3,1") (== (. s destroys) 2)) "filtering destroys the dropped rows only"))
            (expr (call check w (&& (&& (call births w 5 5) (call births w 3 3)) (call births w 1 1)) "survivors keep their state"))
            (expr (call check w (call nodesFollow w) "DOM nodes follow the key through a filter"))) (block
            (if (== f 4) (block
              (expr (call check w (&& (call same (call names d (call list d 0)) "5,9,3,7,1") (== (. s mounts) 13)) "insert mounts the new rows"))
              (expr (call check w (&& (&& (&& (&& (call births w 5 5) (call births w 3 3)) (call births w 1 1)) (call births w 9 12)) (call births w 7 13)) "old rows keep state, new ones are new"))
              (expr (call check w (call nodesFollow w) "DOM nodes follow the key through an insert"))) (block
              (if (== f 5) (block
                (expr (call check w (&& (call same (call names d (call list d 0)) "") (== (. s destroys) 7)) "removing every row destroys them all"))) (block
                (if (== f 6) (block
                  (expr (call check w (&& (call same (call names d (call list d 0)) "20,21") (== (. s mounts) 15)) "all-new keys mount fresh rows"))) (block
                  (if (== f 7) (block
                    (expr (call check w (&& (call same (call names d (call list d 0)) "30,30,31") (== (. s mounts) 18)) "duplicate keys still render every row"))) (block
                    (if (== f 8) (block
                      (expr (call check w (&& (== (. s mounts) 18) (== (. s destroys) 9)) "duplicates are stable across frames"))
                      (expr (call check w (call same (call leafNames d (call list d 2)) "41,42,43") "unkeyed nested lists render"))
                      (= (. w used) (. (. w mem) used))) (block
                      (if (== f 10) (block
                        (expr (call check w (&& (call nodesFollow w) (== (. (. (. w state) rows) len) 1000)) "1000 keyed rows"))
                        (= (. w used) (. (. w mem) used))) (block
                        (if (== f 12) (block
                          (expr (call check w (== (. (. w mem) used) (. w used)) "1000 keyed rows: idle frames allocate nothing"))) (block
                          (if (== f 13) (block
                            (= (. w mark) (. s mounts))
                            (= (. w b200) (index (. s birth) 200))
                            (expr (call check w (&& (call same (call pNames d (call list d 3)) "1,2,3,4,6") (call markersOk d (call list d 3))) "rows with optional markers before and after"))
                            (expr (call check w (&& (> (. w b200) 0) (> (index (. s birth) 300) 0)) "gated and slotted rows mounted"))) (block
                            (if (== f 14) (block
                              (expr (call check w (&& (call same (call pNames d (call list d 3)) "6,4,3,2,1") (call markersOk d (call list d 3))) "markers stay with their rows through a reverse"))) (block
                              (if (== f 15) (block
                                (expr (call check w (call same (call pNames d (call list d 4)) "") "gated list is gone"))
                                (= (. w destroys0) (. s destroys))) (block
                                (if (== f 16) (block
                                  (expr (call check w (&& (&& (== (. s mounts) (+ (. w mark) 2)) (!= (index (. s birth) 200) (. w b200))) (> (index (. s birth) 200) 0)) "re-entering the {#if} mounts fresh rows"))
                                  (expr (call check w (call same (call names d (call list d 4)) "200,201") "gated rows are back"))
                                  (= (. w b300) (index (. s birth) 300))) (block
                                  (if (== f 17) (block
                                    (expr (call check w (&& (== (index (. s birth) 300) (. w b300)) (== (. s mounts) (+ (. w mark) 2))) "rows in slot content follow the key"))
                                    (expr (call check w (call same (call leafNames d (call list d 5)) "301,300") "slotted cards reversed"))) (block
                                    (if (== f 18) (block
                                      (expr (call check w (== (. d ghosts) 0) "a new keyed row with transition:fade leaves no ghost"))) (block
                                      (if (== f 19) (block
                                        (expr (call check w (&& (call same (call pNames d (call list d 6)) "3,2,1") (== (. d ghosts) 0)) "moving keyed rows leaves no leave ghosts"))) (block
                                        (if (== f 20) (block
                                          (expr (call check w (== (. d ghosts) 1) "removing a keyed row leaves one fade ghost"))) (block
                                          (if (== f 30) (block
                                            (expr (call check w (== (. d ghosts) 0) "the ghost is gone after its fade"))
                                            (expr (call shuffle10k w))
                                            (expr (call churn w))
                                            (if (== (. w fails) 0) (block
                                              (expr (call printLn "all passed"))))
                                            (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))))))))))))))))))))))))))))))))))))))
    (expr (call rewindScratch))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "lists" 320 240 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
