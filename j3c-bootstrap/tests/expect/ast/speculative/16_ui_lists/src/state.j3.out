(file (module lists state)
  (use j3.memory.Arena)
  (struct pub Item
    (field id int)
    (field name string))
  (struct pub Group
    (field id int)
    (field rows (slice Item)))
  (struct pub State
    (field rows (slice Item))
    (field groups (slice Group))
    (field outer (slice Group))
    (field mixed (slice Item))
    (field extra (slice Item))
    (field cards (slice Item))
    (field fades (slice Item))
    (field flag bool (bool false))
    (field mounts int 0)
    (field destroys int 0)
    (field nextBirth int 0)
    (field (doc "birth number of the Row instance showing item `id` (0 = none): equal across frames only if the instance followed its key") birth (slice int))
    (fn new (params (mem (ref Arena))) State (block
      (return (struct-lit State (field rows (call (. mem alloc) (targs Item) 0)) (field groups (call (. mem alloc) (targs Group) 0)) (field outer (call (. mem alloc) (targs Group) 0)) (field mixed (call (. mem alloc) (targs Item) 0)) (field extra (call (. mem alloc) (targs Item) 0)) (field cards (call (. mem alloc) (targs Item) 0)) (field fades (call (. mem alloc) (targs Item) 0)) (field birth (call (. mem alloc) (targs int) 4096))))))))
--- stderr
--- exit 0
