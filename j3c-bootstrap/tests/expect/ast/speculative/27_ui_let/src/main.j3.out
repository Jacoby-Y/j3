(file (module letfx)
  (use letfx.state (names State Item VRow))
  (use letfx.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.ui.dom.Dom)
  (use j3.ui.testkit (names hasText))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int)
    (field laid int)
    (field restyled int)
    (field used int))
  (fn boot (params (mem (ref Arena))) World (block
    (let items _ (call (. mem alloc) (targs Item) 2))
    (= (index items 0) (struct-lit Item (field name "a") (field n 1)))
    (= (index items 1) (struct-lit Item (field name "b") (field n 2)))
    (let vrows _ (call (. mem alloc) (targs VRow) 1000))
    (for i (.. 0 1000) (block
      (= (index vrows i) (struct-lit VRow (field id i) (field n 0)))))
    (return (struct-lit World (field mem mem) (field laid 0) (field restyled 0) (field used 0) (field state (struct-lit State (field items items) (field vrows vrows))) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn button (params (d (ref Dom)) (k int)) int (block
    (let seen _ 0)
    (let t _ (call (. d tag) "button"))
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (== (. (index (. (. d nodes) items) i) tag) t) (block
        (if (== seen k) (block
          (return i)))
        (+= seen 1)))))
    (return (- 1))))
  (fn click (params (w (ref World)) (f0 int) (k int)) _ (block
    (let d _ (& (. (. w root) dom)))
    (let id _ (call button d k))
    (let x _ (+ (call (. d absX) id) (float 0x4008000000000000)))
    (let y _ (+ (call (. d absY) id) (float 0x4008000000000000)))
    (if (== (. w frame) f0) (block
      (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))) (block
      (if (== (. w frame) (+ f0 1)) (block
        (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))) (block
        (if (== (. w frame) (+ f0 2)) (block
          (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))))))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (let d _ (& (. (. w root) dom)))
    (let s _ (& (. w state)))
    (if (== (. w frame) 0) (block
      (expr (call check w (&& (call hasText d "slot=0") (call hasText d "m=100")) "a let in slot content and in a match arm"))
      (expr (call check w (call hasText d "total=2 twice=4") "a let at the top uses an earlier let"))
      (expr (call check w (&& (call hasText d "a:10") (call hasText d "b:21")) "lets in an each see the row and index"))
      (expr (call check w (&& (call hasText d "big=1021") (! (call hasText d "big=1010"))) "a let inside an if arm"))
      (expr (call check w (&& (call hasText d "n=1") (call hasText d "n=2")) "&x reads the element"))))
    (expr (call click w 3 0))
    (expr (call click w 8 2))
    (expr (call click w 13 3))
    (+= (. w frame) 1)
    (if (== (. w frame) 7) (block
      (expr (call check w (== (. s counter) 1) "the plain button ran"))))
    (if (== (. w frame) 13) (block
      (expr (call check w (&& (== (. (index (. s items) 1) n) 3) (== (. (index (. s items) 0) n) 1)) "a handler on &x changes the source element in place"))))
    (if (== (. w frame) 17) (block
      (expr (call check w (&& (== (. (index (. s vrows) 0) n) 1) (== (. (index (. s vrows) 1) n) 0)) "a handler on &x in a virtual list changes the source element"))
      (= (. s mode) 1)))
    (if (== (. w frame) 22) (block
      (expr (call check w (&& (call hasText d "b:31") (call hasText d "n=3")) "the change shows on the next frame"))
      (expr (call check w (call hasText d "slot=2") "a let used in slot content is recomputed when it changes"))
      (expr (call check w (&& (call hasText d "e=201") (! (call hasText d "m=101"))) "a let in a {#match} arm follows the arm and the state"))
      (expr (call check w (call hasText d "=1") "the virtual row shows its element"))
      (= (. w laid) (. d laid))
      (= (. w restyled) (. d restyled))
      (= (. w used) (. (. w mem) used))))
    (if (== (. w frame) 60) (block
      (expr (call check w (&& (&& (== (. d laid) (. w laid)) (== (. d restyled) (. w restyled))) (== (. (. w mem) used) (. w used))) (interp "38 idle frames with lets and &x: " (- (. d laid) (. w laid)) " layouts, " (- (. d restyled) (. w restyled)) " restyles, " (- (. (. w mem) used) (. w used)) " bytes")))
      (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "letfx" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
