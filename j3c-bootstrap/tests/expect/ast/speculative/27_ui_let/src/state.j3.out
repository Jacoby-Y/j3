(file (module letfx state)
  (struct pub Item
    (field name string)
    (field n int))
  (struct pub VRow
    (field id int)
    (field n int))
  (struct pub State
    (field items (slice Item))
    (field vrows (slice VRow))
    (field counter int 0)
    (field mode int 0)))
--- stderr
--- exit 0
