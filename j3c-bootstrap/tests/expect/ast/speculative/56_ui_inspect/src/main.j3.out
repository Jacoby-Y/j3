(file (module uiinspect)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.ui.inspect)
  (use uiinspect.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (expr (call (. (. root dom) setInspector) (bool true)))
    (return (struct-lit World (field root root) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (expr (call (. (. (. w root) dom) simInput) (float 0x406cc00000000000) (float 0x4051800000000000) (bool false) (float 0x0000000000000000)))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 3) (block
      (= (. (. (. w root) dom) inspPin) (call (. inspect find) (& (. (. w root) dom)) "#a"))))
    (if (== (. w frame) 100) (block
      (expr (call printLn "uiinspect ok"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uiinspect" 700 500 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
