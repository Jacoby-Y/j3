(file (module speculative data)
  (use j3.io.printLn)
  (use j3.math.sqrt)
  (struct debug Vec2
    (field x f32)
    (field y f32)
    (fn operator+ (params (this Vec2) (other Vec2)) _ (block
      (return (struct-lit Vec2 (field x (+ (. this x) (. other x))) (field y (+ (. this y) (. other y)))))))
    (fn operator- (params (this Vec2) (other Vec2)) _ (block
      (return (struct-lit Vec2 (field x (- (. this x) (. other x))) (field y (- (. this y) (. other y)))))))
    (fn operator* (params (this Vec2) (s f32)) _ (block
      (return (struct-lit Vec2 (field x (* (. this x) s)) (field y (* (. this y) s))))))
    (fn length (params (this Vec2)) _ (block
      (return (call sqrt (+ (* (. this x) (. this x)) (* (. this y) (. this y)))))))
    (fn scale (params (this (ref Vec2)) (s f32)) _ (block
      (*= (. this x) s)
      (*= (. this y) s))))
  (struct Entity
    (field pos Vec2)
    (field vel Vec2))
  (fn main (params) _ (block
    (let pos _ (struct-lit Vec2 (field x 10) (field y 10)))
    (let vel _ (struct-lit Vec2 (field x 2) (field y (- 1))))
    (let next _ (+ pos vel))
    (let offset _ (- next pos))
    (let doubled _ (* offset 2))
    (let len _ (call (. doubled length)))
    (expr (call (. doubled scale) (float 0x3fe0000000000000)))
    (let player _ (struct-lit Entity (field pos next) (field vel vel)))
    (expr (call printLn (interp "len=" len " player.pos=" (. player pos)))))))
--- stderr
--- exit 0
