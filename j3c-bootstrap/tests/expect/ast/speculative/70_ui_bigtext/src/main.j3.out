(file (module bigtext)
  (use bigtext.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (struct World
    (field big string)
    (field root Screen))
  (fn boot (params (mem (ref Arena))) World (block
    (let t _ (call (. Text new) mem))
    (for i (.. 0 (* 100 1024)) (block
      (expr (call (. t push) (call u8 (+ 97 (% i 26)))))))
    (return (struct-lit World (field big (call (. t str))) (field root (call (. Screen new) mem))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field text (. w big)) (field n (. (. w big) len)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "bigtext" 640 360 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
