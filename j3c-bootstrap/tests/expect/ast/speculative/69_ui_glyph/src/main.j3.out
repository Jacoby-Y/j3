(file (module uiglyph)
  (use j3.app.App)
  (use j3.game (names windowSize clearTo Color env))
  (use j3.text.same)
  (use j3.memory.Arena)
  (use j3.ui.padin)
  (use uiglyph.ui (names Screen ScreenProps))
  (struct World
    (field root Screen)
    (field mode string)
    (field frame int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (let mode _ (call env "GLYPH_MODE"))
    (let font _ (if-expr (call same mode "psplain") "/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf" "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (expr (call (. (. root dom) setFallbackFont) font))
    (if (|| (call same mode "ps") (call same mode "psplain")) (block
      (expr (call (. (. root dom) setGlyphStyle) "playstation"))))
    (return (struct-lit World (field root root) (field mode mode) (field frame 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (if (&& (> (. (. w mode) len) 0) (! (call same (. w mode) "rest"))) (block
      (if (== (. w frame) 3) (block
        (expr (call (. d setPad) (call (. padin parse) "LB")))))
      (if (== (. w frame) 5) (block
        (expr (call (. d setPad) (call (. padin parse) "")))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "uiglyph" 420 230 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
