(file (module emoji)
  (use emoji.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names tryLoadFont windowSize))
  (use j3.io.printLn)
  (use j3.sys)
  (use j3.memory.Arena)
  (struct World
    (field root Screen))
  (fn boot (params (mem (ref Arena))) World (block
    (if (== (. (call tryLoadFont "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf" 16) raw) 0) (block
      (expr (call printLn "FAIL: speculative/30_ui_emoji needs Noto Color Emoji at /usr/share/fonts/truetype/noto/NotoColorEmoji.ttf (not installed; the golden cannot be checked)"))
      (expr (call (. sys exit) 1))))
    (return (struct-lit World (field root (call (. Screen new) mem))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field n 0))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "emoji" 360 180 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
