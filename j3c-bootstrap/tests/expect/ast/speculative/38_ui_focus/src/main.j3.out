(file (module focus_probe)
  (use j3.app.App)
  (use j3.game (names env windowSize clearTo Color))
  (use j3.text.same)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys.panic)
  (use j3.ui.testkit)
  (use focus_probe.ui (names Screen ScreenProps))
  (struct World
    (field mode string)
    (field root Screen)
    (field frame int)
    (field used int)
    (field laid int)
    (field styles int))
  (fn boot (params (mem (ref Arena))) World (block
    (let root _ (call (. Screen new) mem))
    (expr (call (. (. root dom) setFrameMs) (float 0x4030000000000000)))
    (expr (call (. (. root dom) setFallbackFont) "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"))
    (return (struct-lit World (field mode (call env "FOCUS_MODE")) (field root root) (field frame 0) (field used 0) (field laid 0) (field styles 0)))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call clearTo (struct-lit Color (field r 0) (field g 0) (field b 0) (field a 255))))
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) (- (float 0x4014000000000000)) (- (float 0x4014000000000000)) (bool false) (float 0x0000000000000000)))
    (if (call same (. w mode) "key") (block
      (expr (call (. testkit simKeys) d (. w frame) 6 "" "Tab"))
      (expr (call (. testkit simKeys) d (. w frame) 8 "" "Tab"))) (block
      (if (call same (. w mode) "mouse") (block
        (expr (call (. testkit clickTag) d (. w frame) 6 "button" 1))) (block
        (if (call same (. w mode) "text") (block
          (expr (call (. testkit clickTag) d (. w frame) 6 "input" 0))))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps)))
    (if (== (. w frame) 25) (block
      (= (. w used) (. (. d mem) used))
      (= (. w laid) (. d laid))
      (= (. w styles) (. d restyled))))
    (if (&& (> (. w frame) 25) (|| (|| (!= (. (. d mem) used) (. w used)) (!= (. d laid) (. w laid))) (!= (. d restyled) (. w styles)))) (block
      (expr (call panic "focus steady frame changed layout style or allocation"))))
    (if (== (. w frame) 40) (block
      (expr (call printLn "focus_probe ok: focus-visible, focus-within, steady frames"))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "focus probe" 320 220 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
