(file (module rich state)
  (use j3.ui.spans.Span)
  (struct pub State
    (field text string "")
    (field spans (slice Span))
    (field (doc "The completion list: shown while a `@` trigger is active; `tlo..thi` is the typed `@ja`.") open bool (bool false))
    (field q string "")
    (field tlo int 0)
    (field thi int 0)
    (field names (slice string)))
  (fn (doc "Whether `name` starts with the typed `q`, ignoring ASCII case.") pub matches (params (name string) (q string)) bool (block
    (if (> (. q len) (. name len)) (block
      (return (bool false))))
    (for i (.. 0 (. q len)) (block
      (let a _ (call int (index name i)))
      (let b _ (call int (index q i)))
      (if (&& (>= a 65) (<= a 90)) (block
        (+= a 32)))
      (if (&& (>= b 65) (<= b 90)) (block
        (+= b 32)))
      (if (!= a b) (block
        (return (bool false))))))
    (return (bool true)))))
--- stderr
--- exit 0
