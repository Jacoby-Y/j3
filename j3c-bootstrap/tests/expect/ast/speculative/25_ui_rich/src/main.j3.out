(file (module rich)
  (use rich.state.State)
  (use rich.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names env windowSize))
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom.Dom)
  (use j3.ui.spans (names Span SPAN_BOLD SPAN_MENTION))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int)
    (field ta int))
  (fn boot (params (mem (ref Arena))) World (block
    (let nm _ (call (. mem alloc) (targs string) 3))
    (= (index nm 0) "@Jane")
    (= (index nm 1) "@Jack")
    (= (index nm 2) "@Jamal")
    (return (struct-lit World (field mem mem) (field state (struct-lit State (field text "") (field spans (call (. mem alloc) (targs Span) 0)) (field names nm))) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0) (field ta (- 1))))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn draw (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (let s _ (& (. w state)))
    (if (== (. w frame) 2) (block
      (for i (.. 0 (. (. d nodes) len)) (block
        (if (== (. (index (. (. d nodes) items) i) tag) (. d tInput)) (block
          (= (. w ta) i)))))
      (expr (call (. d focusNode) (. w ta)))) (block
      (if (== (. w frame) 4) (block
        (expr (call (. d simKeys) "Hey @ja" ""))) (block
        (if (== (. w frame) 6) (block
          (expr (call (. d simKeys) "" "Down"))) (block
          (if (== (. w frame) 7) (block
            (expr (call (. d simKeys) "" "Up"))) (block
            (if (== (. w frame) 8) (block
              (expr (call (. d simKeys) "" "Enter"))) (block
              (if (== (. w frame) 12) (block
                (expr (call (. d simKeys) " are you there?" ""))) (block
                (if (== (. w frame) 14) (block
                  (let e _ (& (index (. (. d eds) items) (. (index (. (. d nodes) items) (. w ta)) edit))))
                  (= (. e anc) 14)
                  (= (. e cur) 17)
                  (expr (call (. d simKeys) "" "C+b"))) (block
                  (if (== (. w frame) 15) (block
                    (expr (call (. d simKeys) "" "End"))))))))))))))))))
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state s))))
    (if (== (. w frame) 5) (block
      (expr (call check w (&& (&& (&& (. s open) (call same (. s q) "@ja")) (== (. s tlo) 4)) (== (. s thi) 7)) "typing @ja reports the trigger and opens the list"))
      (let pop _ (- 1))
      (for i (.. 0 (. (. d ovs) len)) (block
        (= pop (. (index (. (. d ovs) items) i) v))))
      (let cr _ (call (. d caretRect) (. w ta)))
      (expr (call check w (&& (>= pop 0) (. (index (. (. d nodes) items) pop) ovCaret)) "the list is a caret popover"))
      (expr (call check w (&& (&& (&& (>= pop 0) (>= (call (. d absX) pop) (- (. cr x) (float 0x3ff0000000000000)))) (<= (call (. d absX) pop) (+ (. cr x) (float 0x3ff0000000000000)))) (>= (call (. d absY) pop) (+ (. cr y) (. cr h)))) "the list hangs under the caret"))))
    (if (== (. w frame) 6) (block
      (let pe _ (& (index (. (. d eds) items) (. (index (. (. d nodes) items) (. w ta)) edit))))
      (let cp _ (call (. d caretRect) (. w ta)))
      (expr (call check w (&& (&& (&& (&& (>= (. pe px) (float 0x0000000000000000)) (< (- (- (- (. cp x) (call (. d absX) (. w ta))) (float 0x401c000000000000)) (. pe px)) (float 0x3fe0000000000000))) (< (- (. pe px) (- (- (. cp x) (call (. d absX) (. w ta))) (float 0x401c000000000000))) (float 0x3fe0000000000000))) (< (- (- (- (. cp y) (call (. d absY) (. w ta))) (float 0x401c000000000000)) (. pe py)) (float 0x3fe0000000000000))) (< (- (. pe py) (- (- (. cp y) (call (. d absY) (. w ta))) (float 0x401c000000000000))) (float 0x3fe0000000000000))) "the layout-time caret rect equals what the paint drew"))))
    (if (== (. w frame) 6) (block
      (expr (call check w (&& (>= (. d cpHot) 0) (== (call (. d caret) (. w ta)) 7)) "the first entry is active and the caret is untouched"))))
    (if (== (. w frame) 7) (block
      (expr (call check w (&& (== (call (. d caret) (. w ta)) 7) (call same (. s text) "Hey @ja")) "Down keeps the caret and the text"))))
    (if (== (. w frame) 9) (block
      (expr (call check w (&& (&& (&& (call same (. s text) "Hey @Jane") (== (. (. s spans) len) 1)) (== (. (index (. s spans) 0) kind) SPAN_MENTION)) (call same (. (index (. s spans) 0) data) "@Jane")) "Enter swaps @ja for the @Jane chip"))
      (expr (call check w (&& (! (. s open)) (== (. (. d ovs) len) 0)) "the list closed"))))
    (if (== (. w frame) 16) (block
      (expr (call check w (call same (. s text) "Hey @Jane are you there?") "typed text and the token label are the bound value"))
      (expr (call check w (== (. (. s spans) len) 2) "a mention and a bold run are bound"))
      (expr (call check w (&& (&& (== (. (index (. s spans) 0) kind) SPAN_MENTION) (== (. (index (. s spans) 0) start) 4)) (call same (. (index (. s spans) 0) data) "@Jane")) "the mention is an atomic span with its id"))
      (expr (call check w (&& (&& (== (. (index (. s spans) 1) kind) SPAN_BOLD) (== (. (index (. s spans) 1) start) 14)) (== (. (index (. s spans) 1) len) 3)) "Ctrl+B bolded the selection"))
      (let c _ (call (. d caretRect) (. w ta)))
      (expr (call check w (&& (> (. c x) (float 0x0000000000000000)) (> (. c h) (float 0x0000000000000000))) "the caret rect is known after paint"))
      (if (|| (== (. (call env "J3_CAPTURE") len) 0) (> (. w fails) 0)) (block
        (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))
    (+= (. w frame) 1)))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "rich" 400 200 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
