(file (module speculative arrays)
  (use j3.io.printLn)
  (fn sum (params (xs (slice int))) int (block
    (let total _ 0)
    (for i (.. 0 (. xs len)) (block
      (+= total (index xs i))))
    (return total)))
  (fn main (params) _ (block
    (let xs (array 4 int) (array-lit 10 20 30 40))
    (let all (slice int) (slice-expr xs _ _))
    (let mid (slice int) (slice-expr xs 1 3))
    (= (index xs 0) 11)
    (= (index mid 0) 21)
    (expr (call printLn (interp "sum=" (call sum all) " mid0=" (index mid 0))))
    (for-each i n xs (block
      (expr (call printLn (interp "xs[" i "]=" n)))))
    (let name string "Coby")
    (expr (call printLn (interp "hi " name " bytes=" (. name len)))))))
--- stderr
--- exit 0
