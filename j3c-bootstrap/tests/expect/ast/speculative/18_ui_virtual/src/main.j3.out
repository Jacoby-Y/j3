(file (module virtual)
  (use virtual.state (names Item State))
  (use virtual.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names micros windowSize))
  (use j3.io.printLn)
  (use j3.math.maxi)
  (use j3.memory (names Arena rewindScratch))
  (use j3.sys)
  (use j3.ui.dom (names Dom DP_NONE K_FREE))
  (const H f32 (float 0x403a000000000000))
  (const N int 100000)
  (const BIG f32 (float 0x4197d78400000000))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field fails int)
    (field rows (slice Item)))
  (fn boot (params (mem (ref Arena))) World (block
    (let w _ (struct-lit World (field mem mem) (field state (struct-lit State (field rows (call (. mem alloc) (targs Item) N)))) (field root (call (. Screen new) mem)) (field fails 0) (field rows (call (. mem alloc) (targs Item) 0))))
    (= (. w rows) (. (. w state) rows))
    (for i (.. 0 N) (block
      (= (index (. (. w state) rows) i) (struct-lit Item (field id i) (field name "x")))))
    (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4024000000000000)))
    (return w)))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn frame (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (expr (call rewindScratch))))
  (fn (doc "The scroll box: the first live `<div>`.") box (params (d (ref Dom))) int (block
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (== (. (index (. (. d nodes) items) i) tag) (call (. d tag) "div"))) (block
        (return i)))))
    (return (- 1))))
  (fn live (params (d (ref Dom))) int (block
    (let n _ 0)
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (block
        (+= n 1)))))
    (return n)))
  (fn (doc "The index shown in row `k` (first span of the k-th `<p>`), -1 if there is none.") rowIndex (params (d (ref Dom)) (k int)) int (block
    (let c _ (. (index (. (. d nodes) items) (call box d)) first))
    (for j (.. 0 k) (block
      (if (< c 0) (block
        (return (- 1))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (if (< c 0) (block
      (return (- 1))))
    (let s _ (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) first)) first)))
    (let v _ 0)
    (for i (.. 0 (. s len)) (block
      (= v (+ (* v 10) (as (- (index s i) 48) int)))))
    (return v)))
  (fn (doc "The id shown in row `k` (second span), -1 if there is none.") rowId (params (d (ref Dom)) (k int)) int (block
    (let c _ (. (index (. (. d nodes) items) (call box d)) first))
    (for j (.. 0 k) (block
      (if (< c 0) (block
        (return (- 1))))
      (= c (. (index (. (. d nodes) items) c) next))))
    (if (< c 0) (block
      (return (- 1))))
    (let s _ (call (. d textOf) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) c) first)) next)) first)))
    (let v _ 0)
    (for i (.. 0 (. s len)) (block
      (= v (+ (* v 10) (as (- (index s i) 48) int)))))
    (return v)))
  (fn (doc "Every live row `k` shows index `i` and the id the list holds at `i` (the view may have moved: scroll anchoring follows a key).") idsMatch (params (w (ref World)) (d (ref Dom))) bool (block
    (let ok _ (> (call rowCount d) 0))
    (for k (.. 0 (call rowCount d)) (block
      (if (!= (call rowId d k) (. (index (. w rows) (call rowIndex d k)) id)) (block
        (= ok (bool false))))))
    (return ok)))
  (fn reverse10 (params (w (ref World))) _ (block
    (for q (.. 0 5) (block
      (let t _ (index (. w rows) q))
      (= (index (. w rows) q) (index (. w rows) (- 9 q)))
      (= (index (. w rows) (- 9 q)) t)))))
  (fn rowCount (params (d (ref Dom))) int (block
    (let n _ 0)
    (let c _ (. (index (. (. d nodes) items) (call box d)) first))
    (while (>= c 0) (block
      (+= n 1)
      (= c (. (index (. (. d nodes) items) c) next))))
    (return n)))
  (fn run (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (expr (call frame w))
    (expr (call frame w))
    (let b _ (call box d))
    (expr (call check w (&& (> (call rowCount d) 0) (== (call rowIndex d 0) 0)) "first frame shows the top rows"))
    (expr (call check w (< (call live d) 200) (interp "100000 rows: " (call live d) " live nodes (< 200)")))
    (let box0 _ (& (index (. (. d nodes) items) b)))
    (expr (call check w (&& (> (. box0 scrollMax) (- (* (call f32 N) H) (float 0x4069200000000000))) (< (. box0 scrollMax) (- (* (call f32 N) H) (float 0x4068e00000000000)))) (interp "scrollMax is the true range (" (. box0 scrollMax) ")")))
    (expr (call (. d scrollBy) b (* (float 0x40e86a0000000000) H)))
    (expr (call frame w))
    (let first _ (call rowIndex d 0))
    (expr (call check w (&& (&& (<= first 50000) (>= first (- 50000 5))) (< (call live d) 200)) (interp "scrolled to the middle in one frame: first row " first)))
    (expr (call check w (== (. (index (. (. d nodes) items) b) scrollY) (* (float 0x40e86a0000000000) H)) "scroll offset kept"))
    (let k _ (- 50000 first))
    (expr (call check w (== (call rowIndex d k) 50000) "row 50000 follows the window start"))
    (let top _ (. (index (. (. d nodes) items) b) y))
    (let c _ (. (index (. (. d nodes) items) b) first))
    (for j (.. 0 k) (block
      (= c (. (index (. (. d nodes) items) c) next))))
    (expr (call check w (&& (< (- (. (index (. (. d nodes) items) c) y) (. (index (. (. d nodes) items) b) scrollY)) (float 0x3ff0000000000000)) (> (- (. (index (. (. d nodes) items) c) y) (. (index (. (. d nodes) items) b) scrollY)) (- (float 0x3ff0000000000000)))) "row 50000 is laid out at the viewport top"))
    (expr (call (. d scrollBy) b BIG))
    (expr (call frame w))
    (let n _ (call rowCount d))
    (expr (call check w (== (call rowIndex d (- n 1)) (- N 1)) "scrolled to the end shows the last row"))
    (expr (call check w (> (. (index (. (. d nodes) items) b) scrollY) (- (* (call f32 N) H) (float 0x4069200000000000))) "scrolled to the end"))
    (let trace _ "")
    (for i (.. 0 60) (block
      (let r0 _ (. d restyled))
      (let l0 _ (. d laid))
      (expr (call frame w))
      (if (|| (!= (. d restyled) r0) (!= (. d laid) l0)) (block
        (= trace (interp trace " f" i ":+" (- (. d restyled) r0) "r/+" (- (. d laid) l0) "l"))))))
    (expr (call printLn (interp "after scrolling to the end:" trace)))
    (let laid _ (. d laid))
    (let rs _ (. d restyled))
    (let used _ (. (. w mem) used))
    (for i (.. 0 300) (block
      (expr (call frame w))))
    (expr (call check w (&& (== (. d laid) laid) (== (. d restyled) rs)) (interp "300 idle frames: 0 layouts, 0 restyles (" (- (. d laid) laid) ", " (- (. d restyled) rs) ")")))
    (expr (call check w (== (. (. w mem) used) used) "300 idle frames: 0 arena growth"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call (. d scrollBy) b (* (float 0x40dd4c0000000000) H)))
    (expr (call frame w))
    (let t0 _ (call micros))
    (expr (call (. d scrollBy) b (float 0x4069000000000000)))
    (expr (call frame w))
    (let us _ (- (call micros) t0))
    (expr (call printLn (interp "scroll by one page: " us " us")))
    (expr (call check w (&& (< us 100000) (> (call rowIndex d 0) 29990)) "a one-page scroll frame is bounded"))
    (let l2 _ (. d laid))
    (expr (call (. d scrollBy) b (float 0x403a000000000000)))
    (expr (call frame w))
    (expr (call printLn (interp "one-row scroll laid " (- (. d laid) l2) " boxes")))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (let notches f32 (float 0x4059000000000000))
    (expr (call (. d simInput) (float 0x4059000000000000) (float 0x4059000000000000) (bool false) (- (float 0x0000000000000000) notches)))
    (expr (call frame w))
    (let y _ (. (index (. (. d nodes) items) b) scrollY))
    (expr (call check w (&& (> y (float 0x40af400000000000)) (== (call rowIndex d 0) (call maxi 0 (- (call int (/ y H)) 4)))) (interp "wheel: window follows the same frame (scrollY " y ", first row " (call rowIndex d 0) ")")))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (let ic _ (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) b) first)) last))
    (expr (call (. d focusNode) ic))
    (expr (call frame w))
    (expr (call check w (== (call (. d focused)) ic) "an input in a visible row takes focus"))
    (expr (call (. d scrollBy) b (* (float 0x40e86a0000000000) H)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (== (call (. d focused)) ic) (!= (. (index (. (. d nodes) items) ic) kind) K_FREE)) "focus survives: its row is kept outside the window"))
    (expr (call check w (&& (== (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) ic) parent)) disp) DP_NONE) (< (call live d) 200)) (interp "the kept row is display:none (" (call live d) " live nodes)")))
    (let l3 _ (. d laid))
    (for i (.. 0 30) (block
      (expr (call frame w))))
    (expr (call check w (== (. d laid) l3) "a kept row off screen costs no layout"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (== (call (. d focused)) ic) (!= (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) ic) parent)) disp) DP_NONE)) (== (call rowIndex d 0) 0)) "scrolling back shows the kept row again"))
    (expr (call (. d scrollBy) b (* (float 0x40e86a0000000000) H)))
    (expr (call frame w))
    (expr (call (. d focusNode) (- 1)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (|| (== (. (index (. (. d nodes) items) ic) kind) K_FREE) (< (call rowCount d) 40)) "blurred: the row leaves with the window"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (let seed _ 12345)
    (let u0 _ 0)
    (for it (.. 0 10000) (block
      (= seed (% (+ (* seed 1103515245) 12345) 2147483648))
      (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
      (expr (call (. d scrollBy) b (* (call f32 (% seed 99000)) H)))
      (expr (call frame w))
      (if (== it 500) (block
        (= u0 (. (. w mem) used))))))
    (expr (call check w (< (- (. (. w mem) used) u0) 4096) (interp "10000 jumping frames: arena grew " (- (. (. w mem) used) u0) " bytes after warm-up")))
    (expr (call check w (< (call live d) 300) (interp "live nodes after the jumps: " (call live d))))
    (expr (call (. d scrollBy) b BIG))
    (expr (call frame w))
    (= (. (. w state) rows) (slice-expr (. (. w state) rows) 0 10))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (== (call rowCount d) 10) (== (call rowIndex d 0) 0)) (== (call rowIndex d 9) 9)) "list shrunk under a scrolled-down box: top rows, valid window"))
    (= (. (. w state) rows) (slice-expr (. (. w state) rows) 0 0))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (== (call rowCount d) 0) "empty list: no rows"))
    (= (. (. w state) rows) (. w rows))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (> (call rowCount d) 0) (== (call rowIndex d 0) 0)) (> (. (index (. (. d nodes) items) b) scrollMax) (float 0x414312d000000000))) "growing from empty: rows and range are back"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (== (call rowId d 0) 0) (== (call rowId d 9) 9)) (== (call rowIndex d 0) 0)) "int keys: at the top, ids are in order"))
    (expr (call reverse10 w))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (call idsMatch w d) (== (. (index (. w rows) 0) id) 9)) "int keys: after a reorder every live row shows the list's id at its index"))
    (expr (call (. d scrollBy) b (float 0x40a4500000000000)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (== (call rowId d 8) (call rowIndex d 8)) (>= (call rowIndex d 8) 90)) "int keys: scrolled to rows 100+, ids match their positions"))
    (expr (call (. d scrollBy) b (- (float 0x0000000000000000) BIG)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (call idsMatch w d) (< (call rowIndex d 0) 10)) "int keys: scrolling back shows the reordered ids"))
    (expr (call reverse10 w))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (call idsMatch w d) (== (. (index (. w rows) 0) id) 0)) (== (. (index (. w rows) 9) id) 9)) "int keys: reordering back restores the order"))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call run w))
    (if (== (. w fails) 0) (block
      (expr (call printLn "all passed"))))
    (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "virtual" 320 240 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
