(file (module grid state)
  (use j3.memory.Arena)
  (use j3.text.Text)
  (struct pub Item
    (field id int))
  (struct (doc "One edited cell (the rest of the sheet is `row * 50 + col`).") pub Cell
    (field row int)
    (field col int)
    (field text string))
  (struct pub State
    (field mem (ref Arena))
    (field rows (slice Item))
    (field cells (slice Cell))
    (field n int)
    (field (doc "Scratch for `get` (a string made in a function cannot be returned from scratch memory).") tmp Text)
    (fn (doc "The text of cell (row, col): an edit, else its number.") get (params (this (ref State)) (row int) (col int)) string (block
      (for i (.. 0 (. this n)) (block
        (if (&& (== (. (index (. this cells) i) row) row) (== (. (index (. this cells) i) col) col)) (block
          (return (. (index (. this cells) i) text))))))
      (expr (call (. (. this tmp) clear)))
      (expr (call (. (. this tmp) pushInt) (+ (* row 50) col)))
      (return (call (. (. this tmp) str)))))
    (fn (doc "Store an edit (a copy: `text` is a view of the editor's buffer).") set (params (this (ref State)) (row int) (col int) (text string)) _ (block
      (let b _ (call (. (. this mem) alloc) (targs u8) (. text len)))
      (for i (.. 0 (. text len)) (block
        (= (index b i) (index text i))))
      (let s _ (as b string))
      (for i (.. 0 (. this n)) (block
        (if (&& (== (. (index (. this cells) i) row) row) (== (. (index (. this cells) i) col) col)) (block
          (= (. (index (. this cells) i) text) s)
          (return)))))
      (= (index (. this cells) (. this n)) (struct-lit Cell (field row row) (field col col) (field text s)))
      (+= (. this n) 1)))))
--- stderr
--- exit 0
