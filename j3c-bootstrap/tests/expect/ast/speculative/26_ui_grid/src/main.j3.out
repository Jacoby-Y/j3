(file (module grid)
  (use grid.state (names Cell Item State))
  (use grid.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game (names env windowSize))
  (use j3.io.printLn)
  (use j3.memory (names Arena rewindScratch))
  (use j3.sys)
  (use j3.text (names same Text))
  (use j3.ui.dom (names Dom K_FREE))
  (use j3.ui.gridstate.Grid)
  (const N int 100000)
  (const COLS int 50)
  (mod-let SHEET (ref State) _)
  (fn (doc "The text of a cell for copy (a module function: the grid holds no app state).") cellText (params (row int) (col int)) string (block
    (return (call (. SHEET get) row col))))
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field g Grid)
    (field root Screen)
    (field fails int)
    (field frames int))
  (fn boot (params (mem (ref Arena))) World (block
    (let rows _ (call (. mem alloc) (targs Item) N))
    (for i (.. 0 N) (block
      (= (index rows i) (struct-lit Item (field id i)))))
    (let w _ (struct-lit World (field mem mem) (field state (struct-lit State (field mem mem) (field rows rows) (field cells (call (. mem alloc) (targs Cell) 64)) (field n 0) (field tmp (call (. Text new) mem)))) (field g (call (. Grid new) mem COLS (float 0x4038000000000000) (float 0x4054000000000000))) (field root (call (. Screen new) mem)) (field fails 0) (field frames 0)))
    (expr (call (. (. (. w root) dom) setFrameMs) (float 0x4024000000000000)))
    (expr (call (. (. w g) freeze) 1))
    (return w)))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn frame (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))) (field g (& (. w g))))))
    (expr (call rewindScratch))
    (+= (. w frames) 1)))
  (fn (doc "One key press (names as `keys.parse`, text typed) and two frames to settle.") press (params (w (ref World)) (typed string) (names string)) _ (block
    (expr (call (. (. (. w root) dom) simKeys) typed names))
    (expr (call frame w))
    (expr (call frame w))))
  (fn (doc "Paste `tsv` as the clipboard would deliver it (the stub clipboard is empty headless).") paste (params (w (ref World)) (tsv string)) _ (block
    (expr (call (. (. w g) queuePaste) tsv))
    (expr (call frame w))
    (expr (call frame w))))
  (fn live (params (d (ref Dom))) int (block
    (let n _ 0)
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (block
        (+= n 1)))))
    (return n)))
  (fn at (params (w (ref World)) (r int) (c int)) bool (block
    (return (&& (== (. (. w g) row) r) (== (. (. w g) col) c)))))
  (fn (doc "The editor box (the one `<input>`), or -1.") editor (params (d (ref Dom))) int (block
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (&& (!= (. (index (. (. d nodes) items) i) kind) K_FREE) (== (. (index (. (. d nodes) items) i) tag) (. d tInput))) (block
        (return i)))))
    (return (- 1))))
  (fn (doc "The box's first row's cell `j`, and the header's cell `j` (`Screen`: sheet > head > hrow > hc, sheet > body > row > cell).") nth (params (d (ref Dom)) (n int) (j int)) int (block
    (let c _ (. (index (. (. d nodes) items) n) first))
    (for i (.. 0 j) (block
      (= c (. (index (. (. d nodes) items) c) next))))
    (return c)))
  (fn headRow (params (d (ref Dom)) (b int)) int (block
    (let sheet _ (. (index (. (. d nodes) items) b) parent))
    (return (. (index (. (. d nodes) items) (. (index (. (. d nodes) items) sheet) first)) first))))
  (fn (doc "Press at (x, y), move to x2, release, with a frame between.") dragTo (params (w (ref World)) (x f32) (y f32) (x2 f32)) _ (block
    (let d _ (& (. (. w root) dom)))
    (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call (. d simInput) x2 y (bool true) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call (. d simInput) x2 y (bool false) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call frame w))))
  (fn (doc "Stage 6c: the frozen first column and header cell stay put while the rest scroll under them; a header-edge drag\nresizes a column for the header and the rows in the same frame, to a minimum width.") frozenAndResize (params (w (ref World)) (b int)) _ (block
    (let d _ (& (. (. w root) dom)))
    (let g _ (& (. w g)))
    (expr (call press w "" "C+Home"))
    (expr (call (. d scrollByX) b (- (float 0x0000000000000000) (. (index (. (. d nodes) items) b) scrollX))))
    (expr (call frame w))
    (let hr _ (call headRow d b))
    (let bx _ (call (. d absX) b))
    (let hx _ (call (. d absX) (. (index (. (. d nodes) items) hr) parent)))
    (expr (call check w (&& (== (call (. d absX) (call nth d (call nth d b 0) 0)) bx) (== (call (. d absX) (call nth d hr 0)) hx)) "at the left edge the frozen column and header cell sit at the box edge"))
    (expr (call press w "" "C+Right"))
    (let sx _ (. (index (. (. d nodes) items) b) scrollX))
    (expr (call check w (&& (> sx (float 0x40a7700000000000)) (== (. g sx) sx)) (interp "scrolled right to " sx)))
    (expr (call check w (&& (== (call (. d absX) (call nth d (call nth d b 0) 0)) bx) (== (call (. d absX) (call nth d hr 0)) hx)) "scrolled: the frozen cell and the frozen header cell have not moved"))
    (expr (call check w (== (call (. d absX) (call nth d hr 49)) (+ (- hx sx) (call (. g colX) 49))) "scrolled: the header follows the scroll in the same frame (no lag)"))
    (expr (call check w (== (call (. d absX) (call nth d (call nth d b 0) 49)) (+ (- bx sx) (call (. g colX) 49))) "scrolled: a body cell scrolls under (and past) the frozen one"))
    (let l0 _ (. d laid))
    (let r0 _ (. d restyled))
    (expr (call (. d scrollByX) b (- (float 0x4054000000000000))))
    (expr (call frame w))
    (expr (call check w (&& (&& (== (. (index (. (. d nodes) items) b) scrollX) (- sx (float 0x4054000000000000))) (== (call (. d absX) (call nth d (call nth d b 0) 0)) bx)) (== (call (. d absX) (call nth d hr 0)) hx)) "a 80 px scroll step moves the frozen cells with it, same frame"))
    (expr (call printLn (interp "one scroll step laid " (- (. d laid) l0) " boxes, restyled " (- (. d restyled) r0) " of " (call live d))))
    (expr (call check w (&& (< (- (. d laid) l0) 400) (< (- (. d restyled) r0) 400)) "horizontal scroll costs the visible rows, not 100000"))
    (expr (call press w "" "C+Home"))
    (expr (call (. d scrollByX) b (- (float 0x0000000000000000) (. (index (. (. d nodes) items) b) scrollX))))
    (expr (call frame w))
    (expr (call (. d focusNode) b))
    (expr (call frame w))
    (let hc _ (call nth d hr 2))
    (let grip _ (. (index (. (. d nodes) items) hc) last))
    (let gx _ (+ (call (. d absX) grip) (/ (. (index (. (. d nodes) items) grip) w) (float 0x4000000000000000))))
    (let gy _ (+ (call (. d absY) grip) (float 0x4018000000000000)))
    (let w2 _ (call (. g w) 2))
    (let t0 _ (. g total))
    (let row0 _ (. g row))
    (let col0 _ (. g col))
    (expr (call dragTo w gx gy (+ gx (float 0x403e000000000000))))
    (expr (call check w (&& (== (call (. g w) 2) (+ w2 (float 0x403e000000000000))) (== (. g total) (+ t0 (float 0x403e000000000000)))) (interp "dragging the edge widens the column (" (call (. g w) 2) ", total " (. g total) ")")))
    (expr (call check w (&& (== (. (index (. (. d nodes) items) hc) w) (+ w2 (float 0x403e000000000000))) (== (. (index (. (. d nodes) items) (call nth d (call nth d b 0) 2)) w) (+ w2 (float 0x403e000000000000)))) "header and body cells have the new width"))
    (expr (call check w (&& (&& (== (call (. g colAt) (+ (call (. g colX) 3) (float 0x3ff0000000000000))) 3) (== (call (. g colAt) (- (call (. g colX) 3) (float 0x3ff0000000000000))) 2)) (== (call (. g colX) 3) (+ (+ (+ (call (. g w) 0) (call (. g w) 1)) w2) (float 0x403e000000000000)))) "colAt/colX follow the new widths"))
    (expr (call check w (&& (&& (&& (== (. g row) row0) (== (. g col) col0)) (! (call (. g hasRange)))) (! (. g drag))) "a resize does not touch the selection"))
    (expr (call check w (== (call (. d focused)) b) "a resize leaves focus on the grid"))
    (= gx (+ gx (float 0x403e000000000000)))
    (expr (call dragTo w gx gy (- gx (float 0x407f400000000000))))
    (expr (call check w (== (call (. g w) 2) (float 0x4038000000000000)) (interp "the width stops at the minimum (" (call (. g w) 2) ")")))
    (let laid _ (. d laid))
    (let rs _ (. d restyled))
    (let used _ (. (. w mem) used))
    (for i (.. 0 100) (block
      (expr (call frame w))))
    (expr (call check w (&& (&& (== (. d laid) laid) (== (. d restyled) rs)) (== (. (. w mem) used) used)) (interp "100 idle frames after a resize: " (- (. d laid) laid) " layouts, " (- (. d restyled) rs) " restyles, " (- (. (. w mem) used) used) " bytes")))
    (expr (call (. g setWidth) 2 (float 0x4060400000000000)))
    (expr (call frame w))
    (expr (call frame w))))
  (fn run (params (w (ref World))) _ (block
    (let d _ (& (. (. w root) dom)))
    (let g _ (& (. w g)))
    (= SHEET (& (. w state)))
    (expr (call (. g cells) cellText))
    (expr (call frame w))
    (expr (call frame w))
    (let b _ (. (index (. (. d grids) items) 0) node))
    (expr (call check w (&& (>= b 0) (== (. g rows) N)) (interp "the grid box is bound with " (. g rows) " rows")))
    (expr (call check w (< (call live d) 3000) (interp "100000 x 50 cells: " (call live d) " live nodes")))
    (expr (call (. d focusNode) b))
    (expr (call frame w))
    (expr (call press w "" "Down"))
    (expr (call press w "" "Down"))
    (expr (call press w "" "Right"))
    (expr (call check w (call at w 2 1) "arrows move the active cell"))
    (expr (call press w "" "Up"))
    (expr (call press w "" "Left"))
    (expr (call check w (call at w 1 0) "Up and Left"))
    (expr (call press w "" "Left"))
    (expr (call check w (call at w 1 0) "Left stops at the first column"))
    (expr (call press w "" "C+Down"))
    (expr (call check w (call at w (- N 1) 0) "Ctrl+Down runs to the last row"))
    (expr (call check w (> (. (index (. (. d nodes) items) b) scrollY) (- (* (call f32 N) (float 0x4038000000000000)) (float 0x4069000000000000))) (interp "the box scrolled to the end (" (. (index (. (. d nodes) items) b) scrollY) ")")))
    (expr (call check w (< (call live d) 3000) (interp "still bounded at the end (" (call live d) " live nodes)")))
    (expr (call press w "" "C+Up"))
    (expr (call check w (&& (call at w 0 0) (== (. (index (. (. d nodes) items) b) scrollY) (float 0x0000000000000000))) "Ctrl+Up runs back to the top"))
    (expr (call press w "" "C+Right"))
    (expr (call check w (&& (call at w 0 (- COLS 1)) (> (. (index (. (. d nodes) items) b) scrollX) (float 0x40a7700000000000))) (interp "Ctrl+Right to the last column scrolls sideways (" (. (index (. (. d nodes) items) b) scrollX) ")")))
    (expr (call press w "" "Tab"))
    (expr (call check w (&& (call at w 1 0) (> (. (index (. (. d nodes) items) b) scrollX) (float 0x40a7700000000000))) "Tab at the last column wraps to the next row's first (frozen, always visible) column: the scroll stays"))
    (expr (call press w "" "S+Tab"))
    (expr (call check w (call at w 0 (- COLS 1)) "Shift+Tab wraps back"))
    (expr (call press w "" "Home"))
    (expr (call check w (call at w 0 0) "Home"))
    (expr (call press w "" "End"))
    (expr (call check w (call at w 0 (- COLS 1)) "End"))
    (expr (call press w "" "Home"))
    (expr (call press w "" "PageDown"))
    (let page _ (. g row))
    (expr (call check w (&& (>= page 6) (<= page 9)) (interp "PageDown moves a screenful (" page " rows)")))
    (expr (call press w "" "PageDown"))
    (expr (call press w "" "PageUp"))
    (expr (call check w (== (. g row) page) "PageUp undoes a PageDown"))
    (expr (call press w "" "C+Home"))
    (expr (call check w (call at w 0 0) "Ctrl+Home"))
    (expr (call press w "" "C+End"))
    (expr (call check w (call at w (- N 1) (- COLS 1)) "Ctrl+End"))
    (expr (call press w "" "C+Home"))
    (expr (call press w "" "Down"))
    (expr (call press w "" "Down"))
    (expr (call press w "" "Right"))
    (expr (call press w "" "Enter"))
    (let ed _ (call editor d))
    (expr (call check w (&& (&& (. g editing) (>= ed 0)) (== (call (. d focused)) ed)) "Enter opens the editor on the active cell, focused"))
    (expr (call check w (call same (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) ed) edit)) str)) "101") (interp "the editor starts with the cell text (\"" (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) ed) edit)) str)) "\")")))
    (expr (call press w "x" ""))
    (expr (call check w (call same (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) ed) edit)) str)) "101x") "typing goes into the editor"))
    (expr (call press w "" "C+z"))
    (expr (call check w (call same (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) ed) edit)) str)) "101") "undo works inside the editor"))
    (expr (call press w "" "Escape"))
    (expr (call check w (&& (&& (&& (&& (! (. g editing)) (< (call editor d) 0)) (call same (call (. (. w state) get) 2 1) "101")) (== (call (. d focused)) b)) (call at w 2 1)) "Escape cancels: value kept, focus back on the grid"))
    (expr (call press w "" "Enter"))
    (expr (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) selectAll)))
    (expr (call press w "hello" ""))
    (expr (call press w "" "Enter"))
    (expr (call check w (&& (&& (&& (call same (call (. (. w state) get) 2 1) "hello") (call at w 3 1)) (! (. g editing))) (== (call (. d focused)) b)) "Enter commits, moves down, focus back on the grid"))
    (expr (call press w "7" ""))
    (expr (call check w (&& (. g editing) (call same (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) str)) "7")) "a typed character opens the editor with it replacing the text"))
    (expr (call press w "2" ""))
    (expr (call press w "" "Tab"))
    (expr (call check w (&& (&& (call same (call (. (. w state) get) 3 1) "72") (call at w 3 2)) (! (. g editing))) "Tab commits and moves right"))
    (expr (call press w "" "F2"))
    (expr (call check w (&& (. g editing) (call same (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) str)) "152")) "F2 edits the cell text"))
    (let cy f32 (float 0x4060800000000000))
    (expr (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) selectAll)))
    (expr (call press w "z" ""))
    (expr (call (. d simInput) (float 0x4069000000000000) cy (bool false) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call (. d simInput) (float 0x4069000000000000) cy (bool true) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call (. d simInput) (float 0x4069000000000000) cy (bool false) (float 0x0000000000000000)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (&& (call same (call (. (. w state) get) 3 2) "z") (! (. g editing))) (== (. g row) 4)) (== (. g col) 2)) (interp "a click on another cell commits and selects it (" (. g row) "," (. g col) ", \"" (call (. (. w state) get) 3 2) "\")")))
    (expr (call check w (== (call (. d focused)) b) "the click left focus on the grid"))
    (expr (call press w "" "C+Home"))
    (expr (call press w "" "Enter"))
    (expr (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) selectAll)))
    (expr (call press w "far" ""))
    (expr (call (. d scrollBy) b (float 0x41324f8000000000)))
    (expr (call frame w))
    (expr (call frame w))
    (expr (call check w (&& (&& (&& (. g editing) (>= (call editor d) 0)) (== (call (. d focused)) (call editor d))) (< (call live d) 3200)) (interp "the edit survives its row leaving the window (" (call live d) " live nodes)")))
    (expr (call press w "!" ""))
    (expr (call press w "" "Enter"))
    (expr (call check w (&& (&& (&& (&& (call same (call (. (. w state) get) 0 0) "far!") (== (. g row) 1)) (! (. g editing))) (== (call (. d focused)) b)) (< (. (index (. (. d nodes) items) b) scrollY) (float 0x4059000000000000))) "committed from far away, and the grid scrolled back to the active cell"))
    (expr (call press w "" "C+Home"))
    (expr (call press w "" "S+Down"))
    (expr (call press w "" "S+Down"))
    (expr (call press w "" "S+Right"))
    (expr (call check w (&& (&& (&& (call at w 2 1) (call (. g hasRange))) (call (. g inRange) 1 0)) (! (call (. g inRange) 3 0))) "Shift+arrows select a range"))
    (expr (call check w (call same (call (. g copyText)) "far!\t1\n50\t51\n100\thello") (interp "copy gives the range as TSV (\"" (call (. g copyText)) "\")")))
    (expr (call press w "" "C+S+Right"))
    (expr (call check w (&& (== (. g col) (- COLS 1)) (== (. g ac) 0)) "Ctrl+Shift+Right extends to the last column"))
    (expr (call press w "" "Down"))
    (expr (call check w (! (call (. g hasRange))) "a plain move collapses the range"))
    (expr (call press w "" "C+Home"))
    (expr (call press w "" "Down"))
    (expr (call press w "" "S+Down"))
    (expr (call press w "" "S+Right"))
    (expr (call paste w "a\tb\n\"c\td\"\te\n"))
    (expr (call check w (&& (&& (&& (call same (call (. (. w state) get) 1 0) "a") (call same (call (. (. w state) get) 1 1) "b")) (call same (call (. (. w state) get) 2 0) "c\td")) (call same (call (. (. w state) get) 2 1) "e")) "pasting TSV writes the block (quoted cell with a tab) in one event"))
    (expr (call check w (&& (&& (call (. g hasRange)) (== (. g row) 2)) (== (. g col) 1)) "the pasted block is the new selection"))
    (expr (call press w "" "C+Home"))
    (expr (call press w "" "C+Home"))
    (let l0 _ (. d laid))
    (for i (.. 0 5) (block
      (expr (call press w "" "Down"))))
    (expr (call printLn (interp "5 Down presses laid " (- (. d laid) l0) " boxes of " (call live d))))
    (expr (call check w (< (- (. d laid) l0) 2500) "moving inside the window does not relayout the whole grid"))
    (for i (.. 0 30) (block
      (expr (call frame w))))
    (let laid _ (. d laid))
    (let rs _ (. d restyled))
    (let used _ (. (. w mem) used))
    (for i (.. 0 300) (block
      (expr (call frame w))))
    (expr (call check w (&& (== (. d laid) laid) (== (. d restyled) rs)) (interp "300 idle frames: 0 layouts, 0 restyles (" (- (. d laid) laid) ", " (- (. d restyled) rs) ")")))
    (expr (call check w (== (. (. w mem) used) used) "300 idle frames: 0 arena growth"))
    (expr (call press w "" "Enter"))
    (for i (.. 0 30) (block
      (expr (call frame w))))
    (= laid (. d laid))
    (= rs (. d restyled))
    (= used (. (. w mem) used))
    (for i (.. 0 100) (block
      (expr (call frame w))))
    (expr (call check w (&& (&& (== (. d laid) laid) (== (. d restyled) rs)) (== (. (. w mem) used) used)) (interp "100 idle frames while editing: " (- (. d laid) laid) " layouts, " (- (. d restyled) rs) " restyles, " (- (. (. w mem) used) used) " bytes")))
    (expr (call press w "" "Escape"))
    (expr (call frozenAndResize w b))
    (expr (call press w "" "C+Down"))
    (expr (call press w "" "Up"))
    (expr (call press w "" "Up"))
    (for i (.. 0 6) (block
      (expr (call press w "" "Right"))))
    (expr (call press w "" "Enter"))
    (expr (call (. (index (. (. d eds) items) (. (index (. (. d nodes) items) (call editor d)) edit)) selectAll)))
    (expr (call press w "99.5" ""))
    (expr (call press w "" "Escape"))
    (expr (call press w "" "S+Down"))
    (expr (call press w "" "S+Down"))
    (expr (call press w "" "S+Right"))
    (if (call same (call env "GRID_PIC") "resized") (block
      (expr (call press w "" "C+Home"))
      (expr (call (. d scrollByX) b (- (float 0x4059000000000000) (. (index (. (. d nodes) items) b) scrollX))))
      (expr (call frame w))
      (expr (call frame w))))))
  (fn draw (params (w (ref World))) _ (block
    (if (== (. w frames) 0) (block
      (expr (call run w))
      (if (== (. w fails) 0) (block
        (expr (call printLn "all passed"))))
      (if (|| (== (. (call env "J3_CAPTURE") len) 0) (> (. w fails) 0)) (block
        (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))) (block
      (expr (call frame w))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "grid" 400 220 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
