(file (module emitfn)
  (use emitfn.state.State)
  (use emitfn.ui (names Screen ScreenProps))
  (use j3.app.App)
  (use j3.game.windowSize)
  (use j3.io.printLn)
  (use j3.memory.Arena)
  (use j3.sys)
  (use j3.text.same)
  (use j3.ui.dom.Dom)
  (struct World
    (field mem (ref Arena))
    (field state State)
    (field root Screen)
    (field frame int)
    (field fails int))
  (fn boot (params (mem (ref Arena))) World (block
    (return (struct-lit World (field mem mem) (field state (struct-lit State)) (field root (call (. Screen new) mem)) (field frame 0) (field fails 0)))))
  (fn check (params (w (ref World)) (ok bool) (what string)) _ (block
    (if ok (block
      (expr (call printLn (interp "PASS " what)))) (block
      (expr (call printLn (interp "FAIL " what)))
      (+= (. w fails) 1)))))
  (fn button (params (d (ref Dom)) (k int)) int (block
    (let seen _ 0)
    (let t _ (call (. d tag) "button"))
    (for i (.. 0 (. (. d nodes) len)) (block
      (if (== (. (index (. (. d nodes) items) i) tag) t) (block
        (if (== seen k) (block
          (return i)))
        (+= seen 1)))))
    (return (- 1))))
  (fn click (params (w (ref World)) (f0 int) (k int)) _ (block
    (let d _ (& (. (. w root) dom)))
    (let id _ (call button d k))
    (let x _ (+ (call (. d absX) id) (float 0x4008000000000000)))
    (let y _ (+ (call (. d absY) id) (float 0x4008000000000000)))
    (if (== (. w frame) f0) (block
      (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))) (block
      (if (== (. w frame) (+ f0 1)) (block
        (expr (call (. d simInput) x y (bool true) (float 0x0000000000000000)))) (block
        (if (== (. w frame) (+ f0 2)) (block
          (expr (call (. d simInput) x y (bool false) (float 0x0000000000000000)))))))))))
  (fn draw (params (w (ref World))) _ (block
    (expr (call (. (. w root) render) (call windowSize) (struct-lit ScreenProps (field state (& (. w state))))))
    (let s _ (& (. w state)))
    (expr (call click w 3 0))
    (expr (call click w 8 1))
    (expr (call click w 13 2))
    (+= (. w frame) 1)
    (if (== (. w frame) 3) (block
      (expr (call check w (== (. s mounted) 1) "an emit in onMount reaches the parent once"))))
    (if (== (. w frame) 8) (block
      (expr (call check w (&& (&& (&& (== (. s sum) 7) (== (. s pings) 1)) (== (. s ons) 1)) (call same (. s last) "t")) "a fn emits int, string and bool payloads"))))
    (if (== (. w frame) 13) (block
      (expr (call check w (&& (&& (== (. s sum) 8) (== (. s pings) 2)) (== (. s dones) 1)) "a fn that calls an emitting fn emits both"))))
    (if (== (. w frame) 20) (block
      (expr (call check w (&& (&& (&& (== (. s sum) 17) (== (. s pings) 3)) (== (. s dones) 1)) (== (. s mounted) 1)) "a second handler calling the same fn; nothing repeats"))
      (expr (call (. sys exit) (if-expr (== (. w fails) 0) 0 1)))))))
  (fn main (params) _ (block
    (let app _ (call (. (type-path App World) create) "emitfn" 640 480 boot))
    (expr (call (. app useGl)))
    (expr (call (. app draw) draw))
    (expr (call (. app run))))))
--- stderr
--- exit 0
