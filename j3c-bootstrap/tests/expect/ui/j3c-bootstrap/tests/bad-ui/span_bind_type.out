// ---- ui/Main.j3ui
pub const SCOPE_Main: int = 1;
const CSS_Main: string = "";
const LINE0_Main: int = 0;

pub struct MainProps {
}

pub struct MainEvents {
}

pub struct Main {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &MainProps;
    css: &Css;
    dom: Dom;
    x: int;
    on: bool;
    s: string;
    tag_div: int;
    tag_input: int;
    cls_box: int;

    fn new(mem: &Arena): Main {
        let ps = mem.alloc::<MainProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Main.styles(css);
        return Main {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            x: 0,
            on: false,
            s: "",
            tag_div: 0,
            tag_input: 0,
            cls_box: 0,
        };
    }

    fn j3Reset(this: &Main) {
        let mem = this.mem;
        this.ready = false;
        this.x = 0;
        this.on = false;
        this.s = "";
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Main, "ui/Main.j3ui", SCOPE_Main, LINE0_Main);
    }

    fn init(this: &Main, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_input = d.tag("input");
        this.cls_box = d.css.intern("box");
    }

    fn render(this: &Main, size: Vec2, p: MainProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(MainPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Main) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Main.j3ui", CSS_Main, 678808972, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Main.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Main, d: &Dom, p: MainProps): MainEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = MainEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Main);
        d.clsId(n1, this.cls_box);
        let n2 = d.open(0, this.tag_input, SCOPE_Main);
        d.attrType(n2, "checkbox");
        if d.clicked(n2) {
            this.x = !this.x;
        }
        d.attrChecked(n2, this.x);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Main) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Main, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn MainPaintHook(p: ptr) {
    let r = p as &Main;
    r.paint(&r.dom);
}

