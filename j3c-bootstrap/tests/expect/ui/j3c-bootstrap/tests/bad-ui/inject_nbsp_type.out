// ---- ui/Kid.j3ui
pub const SCOPE_Kid: int = 1;
const CSS_Kid: string = "";
const LINE0_Kid: int = 0;

pub struct KidProps {
    st: List<int>;
}

pub struct KidEvents {
}

pub struct Kid {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &KidProps;
    tag_p: int;

    fn new(mem: &Arena): Kid {
        let ps = mem.alloc::<KidProps>(1);
        return Kid {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_p: 0,
        };
    }

    fn j3Reset(this: &Kid) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Kid, "ui/Kid.j3ui", SCOPE_Kid, LINE0_Kid);
    }

    fn init(this: &Kid, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_p = d.tag("p");
    }

    fn update(this: &Kid, d: &Dom, p: KidProps): KidEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let st = p.st;
        let ev = KidEvents {  };
        let n1 = d.open(0, this.tag_p, SCOPE_Kid);
        d.text(`{st.len}`);
        d.close();
        return ev;
    }

    fn destroy(this: &Kid) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Kid, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 2;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    st: List< int>;
    tag_div: int;
    c1: Kid;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            st: x(),
            tag_div: 0,
            c1: Kid.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.st = x();
        this.c1.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Kid.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Kid.j3ui", CSS_Kid, 501891403, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 185030082, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, KidProps { st: this.st });
        d.leave(s2);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

