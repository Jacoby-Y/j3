// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_h1: int;
    tag_input: int;
    tag_button: int;
    tag_span: int;
    tag_p: int;
    cls_app: int;
    cls_add: int;
    cls_row: int;
    cls_done: int;
    cls_text: int;
    cls_x: int;
    cls_foot: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_h1: 0,
            tag_input: 0,
            tag_button: 0,
            tag_span: 0,
            tag_p: 0,
            cls_app: 0,
            cls_add: 0,
            cls_row: 0,
            cls_done: 0,
            cls_text: 0,
            cls_x: 0,
            cls_foot: 0,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_h1 = d.tag("h1");
        this.tag_input = d.tag("input");
        this.tag_button = d.tag("button");
        this.tag_span = d.tag("span");
        this.tag_p = d.tag("p");
        this.cls_app = d.css.intern("app");
        this.cls_add = d.css.intern("add");
        this.cls_row = d.css.intern("row");
        this.cls_done = d.css.intern("done");
        this.cls_text = d.css.intern("text");
        this.cls_x = d.css.intern("x");
        this.cls_foot = d.css.intern("foot");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 938793671, true) {
            ch = true;
        }
        if hotFile(css, "ui/Stress.j3ui", CSS_Stress, 849199926, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_app);
        let n2 = d.open(0, this.tag_h1, SCOPE_Screen);
        d.text("Todos");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_add);
        let n4 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n4, "text");
        d.attrPlaceholder(n4, "What needs doing?");
        if d.changed(n4) {
            state.draft = d.strValue(n4);
        }
        d.attrText(n4, state.draft);
        d.attrFlag(n4, 2);
        if d.submitted(n4) {
            state.add();
        }
        d.close();
        let n5 = d.open(1, this.tag_button, SCOPE_Screen);
        if d.clicked(n5) {
            state.add();
        }
        d.text("Add");
        d.close();
        d.close();
        let s6 = d.enter(2);
        let x6 = state.items.items[0..state.items.len];
        let m6 = x6.len;
        this.cnt1 = m6;
        this.kd1.begin();
        for kv6 in 0..m6 {
            let ki6 = x6[kv6];
            this.kd1.addInt(ki6.id);
        }
        this.kd1.finish("ui/Screen.j3ui:13");
        if this.kd1.changed {
            for dq6 in 0..this.kd1.dead.len { let dr6 = this.e1.items[this.kd1.dead.items[dq6]]; dr6.destroy(); this.fp1.push(dr6); }
            this.eb1.len = 0;
            for rq6 in 0..m6 {
                let f6 = this.kd1.from.items[rq6];
                if f6 >= 0 { this.eb1.push(this.e1.items[f6]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t6 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t6;
        }
        for i6 in 0..m6 {
            let it = &x6[i6];
            let r1 = this.e1.items[i6];
            d.keyBegin(r1.uid);
            let n7 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n7, this.cls_row);
            d.clsIfId(n7, this.cls_done, it.done);
            let n8 = d.open(0, this.tag_input, SCOPE_Screen);
            d.attrType(n8, "checkbox");
            if d.clicked(n8) {
                it.done = !it.done;
            }
            d.attrChecked(n8, it.done);
            d.close();
            let n9 = d.open(1, this.tag_span, SCOPE_Screen);
            d.clsId(n9, this.cls_text);
            d.text(`{it.text}`);
            d.close();
            let n10 = d.open(2, this.tag_button, SCOPE_Screen);
            d.clsId(n10, this.cls_x);
            if d.clicked(n10) {
                state.removeId = it.id;
            }
            d.text("×");
            d.close();
            d.close();
            d.keyEnd();
        }
        d.leave(s6);
        let n11 = d.open(3, this.tag_p, SCOPE_Screen);
        d.clsId(n11, this.cls_foot);
        d.text(Text.scratch().add(`{state.left()}`).add(" left").str());
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let s6 = d.enter(2);
                let m6 = this.cnt1;
                for i6 in 0..m6 {
                    let r1 = this.e1.items[i6];
                    d.paintGroup(r1.uid);
                    let n7 = d.paintNext(0);
                    if n7 >= 0 {
                        d.paintBox(n7);
                        let pass7 = 0;
                        while d.paintChildren(pass7) {
                            let n8 = d.paintNext(0);
                            if n8 >= 0 {
                                d.paintBox(n8);
                                let pass8 = 0;
                                while d.paintChildren(pass8) {
                                    pass8 += 1;
                                }
                                d.paintEnd(n8);
                            }
                            let n9 = d.paintNext(1);
                            if n9 >= 0 {
                                d.paintBox(n9);
                                let pass9 = 0;
                                while d.paintChildren(pass9) {
                                    pass9 += 1;
                                }
                                d.paintEnd(n9);
                            }
                            let n10 = d.paintNext(2);
                            if n10 >= 0 {
                                d.paintBox(n10);
                                let pass10 = 0;
                                while d.paintChildren(pass10) {
                                    pass10 += 1;
                                }
                                d.paintEnd(n10);
                            }
                            pass7 += 1;
                        }
                        d.paintEnd(n7);
                    }
                    d.paintGroupEnd();
                }
                d.leave(s6);
                let n11 = d.paintNext(3);
                if n11 >= 0 {
                    d.paintBox(n11);
                    let pass11 = 0;
                    while d.paintChildren(pass11) {
                        pass11 += 1;
                    }
                    d.paintEnd(n11);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

