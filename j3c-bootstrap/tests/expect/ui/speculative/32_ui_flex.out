        let s26 = d.enter(0);
        let m26 = 3;
        this.cnt5 = m26;
        for i in 0..m26 {
            let n27 = d.open(i * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n27, this.cls_reverseItem);
            d.clsIfId(n27, this.cls_red, i == 2);
            d.clsIfId(n27, this.cls_green, i == 1);
            d.clsIfId(n27, this.cls_blue, i == 0);
            d.close();
        }
        d.leave(s26);
        d.close();
        let n28 = d.open(6, this.tag_div, SCOPE_Screen);
        d.clsId(n28, this.cls_columns);
        let s29 = d.enter(0);
        let m29 = 5;
        this.cnt6 = m29;
        for i in 0..m29 {
            let n30 = d.open(i * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n30, this.cls_columnItem);
            d.styleNumAt(n30, 0, "order", f32(4 - i), "ui/Screen.j3ui", 43, 50);
