        d.close();
        let n31 = d.open(7, this.tag_div, SCOPE_Screen);
        d.clsId(n31, this.cls_many);
        let s32 = d.enter(0);
        let m32 = 300;
        this.cnt7 = m32;
        for i in 0..m32 {
