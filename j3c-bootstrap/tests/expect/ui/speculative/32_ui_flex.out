            d.clsId(n33, this.cls_tile);
            d.styleNumAt(n33, 0, "order", f32(300 - i), "ui/Screen.j3ui", 47, 31);
            d.close();
        }
        d.leave(s32);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c2.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        for q2 in 0..this.e2.len {
            this.e2.items[q2].destroy();
        }
        for q3 in 0..this.e3.len {
            this.e3.items[q3].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            if d.beginCanvas(n4) {
                                let size4 = d.size(n4);
                                probe.mark(1);
                                d.endCanvas(n4);
                            }
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n6 = d.paintNext(1);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                let s8 = d.enter(0);
                                this.c2.slotOwn = this as int;
                                this.c2.paint(d);
                                d.leave(s8);
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        let s9 = d.enter(2);
                        let m9 = this.cnt1;
                        for i in 0..m9 {
                            let r1 = this.e1.items[i];
                            d.paintGroup(r1.uid);
                            let n10 = d.paintNext(0);
                            if n10 >= 0 {
                                d.paintBox(n10);
                                let pass10 = 0;
                                while d.paintChildren(pass10) {
                                    let n11 = d.paintNext(0);
                                    if n11 >= 0 {
                                        d.paintBox(n11);
                                        if d.beginCanvas(n11) {
                                            let size11 = d.size(n11);
                                            probe.mark(3 + this.logical(i));
                                            d.endCanvas(n11);
                                        }
                                        let pass11 = 0;
                                        while d.paintChildren(pass11) {
                                            pass11 += 1;
                                        }
                                        d.paintEnd(n11);
                                    }
                                    pass10 += 1;
                                }
                                d.paintEnd(n10);
                            }
                            d.paintGroupEnd();
                        }
                        d.leave(s9);
                        let n12 = d.paintNext(3);
                        if n12 >= 0 {
                            d.paintBox(n12);
                            let pass12 = 0;
                            while d.paintChildren(pass12) {
                                let n13 = d.paintNext(0);
                                if n13 >= 0 {
                                    d.paintBox(n13);
                                    let pass13 = 0;
                                    while d.paintChildren(pass13) {
                                        pass13 += 1;
                                    }
                                    d.paintEnd(n13);
                                }
                                pass12 += 1;
                            }
                            d.paintEnd(n12);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n14 = d.paintNext(2);
                if n14 >= 0 {
                    d.paintBox(n14);
                    let pass14 = 0;
                    while d.paintChildren(pass14) {
                        let s15 = d.enter(0);
                        let m15 = this.cnt2;
                        for i in 0..m15 {
                            let r2 = this.e2.items[i];
                            let s17 = d.enter(i * 1 + 0);
                            r2.c3.slotOwn = this as int;
                            r2.c3.paint(d);
                            d.leave(s17);
                        }
                        d.leave(s15);
                        pass14 += 1;
                    }
                    d.paintEnd(n14);
                }
                let n18 = d.paintNext(3);
                if n18 >= 0 {
                    d.paintBox(n18);
                    let pass18 = 0;
                    while d.paintChildren(pass18) {
                        let s19 = d.enter(0);
                        let m19 = this.cnt3;
                        for i in 0..m19 {
                            let r3 = this.e3.items[i];
                            let s21 = d.enter(i * 1 + 0);
                            r3.c4.slotOwn = this as int;
                            r3.c4.paint(d);
                            d.leave(s21);
                        }
                        d.leave(s19);
                        pass18 += 1;
                    }
                    d.paintEnd(n18);
                }
                let n22 = d.paintNext(4);
                if n22 >= 0 {
                    d.paintBox(n22);
                    let pass22 = 0;
                    while d.paintChildren(pass22) {
                        let s23 = d.enter(0);
                        let m23 = this.cnt4;
                        for i in 0..m23 {
                            let n24 = d.paintNext(i * 1 + 0);
                            if n24 >= 0 {
                                d.paintBox(n24);
                                let pass24 = 0;
                                while d.paintChildren(pass24) {
                                    pass24 += 1;
                                }
                                d.paintEnd(n24);
                            }
                        }
                        d.leave(s23);
                        pass22 += 1;
                    }
                    d.paintEnd(n22);
                }
                let n25 = d.paintNext(5);
                if n25 >= 0 {
                    d.paintBox(n25);
                    let pass25 = 0;
                    while d.paintChildren(pass25) {
                        let s26 = d.enter(0);
                        let m26 = this.cnt5;
                        for i in 0..m26 {
                            let n27 = d.paintNext(i * 1 + 0);
                            if n27 >= 0 {
                                d.paintBox(n27);
                                let pass27 = 0;
                                while d.paintChildren(pass27) {
                                    pass27 += 1;
                                }
                                d.paintEnd(n27);
                            }
                        }
                        d.leave(s26);
                        pass25 += 1;
                    }
                    d.paintEnd(n25);
                }
                let n28 = d.paintNext(6);
                if n28 >= 0 {
                    d.paintBox(n28);
                    let pass28 = 0;
                    while d.paintChildren(pass28) {
                        let s29 = d.enter(0);
                        let m29 = this.cnt6;
                        for i in 0..m29 {
                            let n30 = d.paintNext(i * 1 + 0);
                            if n30 >= 0 {
                                d.paintBox(n30);
                                let pass30 = 0;
                                while d.paintChildren(pass30) {
                                    pass30 += 1;
                                }
                                d.paintEnd(n30);
                            }
                        }
                        d.leave(s29);
                        pass28 += 1;
                    }
                    d.paintEnd(n28);
                }
                let n31 = d.paintNext(7);
                if n31 >= 0 {
                    d.paintBox(n31);
                    let pass31 = 0;
                    while d.paintChildren(pass31) {
                        let s32 = d.enter(0);
                        let m32 = this.cnt7;
                        for i in 0..m32 {
                            let n33 = d.paintNext(i * 1 + 0);
                            if n33 >= 0 {
                                d.paintBox(n33);
                                let pass33 = 0;
                                while d.paintChildren(pass33) {
                                    pass33 += 1;
                                }
                                d.paintEnd(n33);
                            }
                        }
                        d.leave(s32);
                        pass31 += 1;
                    }
                    d.paintEnd(n31);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

// ---- ui/TextCSS.j3ui
pub const SCOPE_TextCSS: int = 3;
const CSS_TextCSS: string = "    .textProbe { position: absolute; left: 0; top: 380px; width: 320px; height: 270px; font-size: 16px; line-height: 20px; color: #ffffff; }\n    .pre { width: 120px; height: 40px; white-space: pre; }\n    .wrap { white-space: pre-wrap; }\n    .justify { width: 100px; height: 40px; text-align: justify; }\n    .justifyReference { display: flex; justify-content: space-between; width: 100px; height: 20px; }\n    .clamp { width: 100px; line-clamp: 2; user-select: text; }\n    .hidden { position: absolute; left: 120px; top: 160px; width: 100px; height: 30px; background: #ff0000; visibility: hidden; }\n    .shown { visibility: visible; }\n    .hidden button { width: 80px; height: 30px; }\n    canvas { width: 10px; height: 10px; visibility: hidden; }\n    .visible { position: absolute; left: 20px; top: 5px; width: 40px; height: 20px; background: #00ff00; visibility: visible; }\n    .reference { position: absolute; left: 120px; top: 190px; width: 100px; height: 30px; }";
const LINE0_TextCSS: int = 18;

pub struct TextCSSProps {
    toggle: bool;
}

pub struct TextCSSEvents {
}

pub struct TextCSS {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &TextCSSProps;
    tag_div: int;
    tag_span: int;
    tag_button: int;
    tag_canvas: int;
    cls_textProbe: int;
    cls_pre: int;
    cls_wrap: int;
    cls_justify: int;
    cls_justifyReference: int;
    cls_clamp: int;
    cls_hidden: int;
    cls_shown: int;
    cls_visible: int;
    cls_reference: int;

    fn new(mem: &Arena): TextCSS {
        let ps = mem.alloc::<TextCSSProps>(1);
        return TextCSS {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_span: 0,
            tag_button: 0,
            tag_canvas: 0,
            cls_textProbe: 0,
            cls_pre: 0,
            cls_wrap: 0,
            cls_justify: 0,
            cls_justifyReference: 0,
            cls_clamp: 0,
            cls_hidden: 0,
            cls_shown: 0,
            cls_visible: 0,
            cls_reference: 0,
        };
    }

    fn j3Reset(this: &TextCSS) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_TextCSS, "ui/TextCSS.j3ui", SCOPE_TextCSS, LINE0_TextCSS);
    }

    fn init(this: &TextCSS, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_button = d.tag("button");
        this.tag_canvas = d.tag("canvas");
        this.cls_textProbe = d.css.intern("textProbe");
        this.cls_pre = d.css.intern("pre");
        this.cls_wrap = d.css.intern("wrap");
        this.cls_justify = d.css.intern("justify");
        this.cls_justifyReference = d.css.intern("justifyReference");
        this.cls_clamp = d.css.intern("clamp");
        this.cls_hidden = d.css.intern("hidden");
        this.cls_shown = d.css.intern("shown");
        this.cls_visible = d.css.intern("visible");
        this.cls_reference = d.css.intern("reference");
    }

    fn hiddenDraw(this: &TextCSS) {
 panic("hidden canvas callback ran"); 
    }

    fn update(this: &TextCSS, d: &Dom, p: TextCSSProps): TextCSSEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let toggle = p.toggle;
        let ev = TextCSSEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_TextCSS);
        d.clsId(n1, this.cls_textProbe);
        let n2 = d.open(0, this.tag_div, SCOPE_TextCSS);
        d.clsId(n2, this.cls_pre);
        d.clsIfId(n2, this.cls_wrap, toggle);
        d.text(`{"aa  bb\ncc"}`);
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_TextCSS);
        d.clsId(n3, this.cls_pre);
        d.clsId(n3, this.cls_wrap);
        d.text(`{"aa  bb\ncc"}`);
        d.close();
        let n4 = d.open(2, this.tag_div, SCOPE_TextCSS);
        d.clsId(n4, this.cls_justify);
        d.text(`{"aa bb cccccccc"}`);
        d.close();
        let n5 = d.open(3, this.tag_div, SCOPE_TextCSS);
        d.clsId(n5, this.cls_justifyReference);
        let n6 = d.open(0, this.tag_span, SCOPE_TextCSS);
        d.text("aa");
        d.close();
        let n7 = d.open(1, this.tag_span, SCOPE_TextCSS);
        d.text("bb");
        d.close();
        d.close();
        let n8 = d.open(4, this.tag_div, SCOPE_TextCSS);
        d.clsId(n8, this.cls_clamp);
        d.styleNumAt(n8, 0, "line-clamp", f32(if toggle { 2 } else { 1 }), "ui/TextCSS.j3ui", 11, 24);
        d.text(`{"alpha beta gamma delta epsilon zeta eta theta"}`);
        d.close();
        let n9 = d.open(5, this.tag_div, SCOPE_TextCSS);
        d.clsId(n9, this.cls_hidden);
        d.clsIfId(n9, this.cls_shown, !toggle);
        let n10 = d.open(0, this.tag_button, SCOPE_TextCSS);
        d.text("must hide");
        d.close();
        let n11 = d.open(1, this.tag_canvas, SCOPE_TextCSS);
        d.close();
        let n12 = d.open(2, this.tag_div, SCOPE_TextCSS);
        d.clsId(n12, this.cls_visible);
        d.close();
        d.close();
        let n13 = d.open(6, this.tag_div, SCOPE_TextCSS);
        d.clsId(n13, this.cls_reference);
        let n14 = d.open(0, this.tag_div, SCOPE_TextCSS);
        d.clsId(n14, this.cls_visible);
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &TextCSS) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &TextCSS, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n5 = d.paintNext(3);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        let n6 = d.paintNext(0);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        let n7 = d.paintNext(1);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n8 = d.paintNext(4);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                let n9 = d.paintNext(5);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        let n10 = d.paintNext(0);
                        if n10 >= 0 {
                            d.paintBox(n10);
                            let pass10 = 0;
                            while d.paintChildren(pass10) {
                                pass10 += 1;
                            }
                            d.paintEnd(n10);
                        }
                        let n11 = d.paintNext(1);
                        if n11 >= 0 {
                            d.paintBox(n11);
                            if d.beginCanvas(n11) {
                                let size11 = d.size(n11);
                                this.hiddenDraw();
                                d.endCanvas(n11);
                            }
                            let pass11 = 0;
                            while d.paintChildren(pass11) {
                                pass11 += 1;
                            }
                            d.paintEnd(n11);
                        }
                        let n12 = d.paintNext(2);
                        if n12 >= 0 {
                            d.paintBox(n12);
                            let pass12 = 0;
                            while d.paintChildren(pass12) {
                                pass12 += 1;
                            }
                            d.paintEnd(n12);
                        }
                        pass9 += 1;
                    }
