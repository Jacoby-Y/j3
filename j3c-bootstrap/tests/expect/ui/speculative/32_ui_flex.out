}

// ---- ui/Tile.j3ui
pub const SCOPE_Tile: int = 4;
const CSS_Tile: string = "    .card { width: 50px; height: 40px; margin-right: -20px; flex-shrink: 0; border: 2px solid #eeeeee; border-radius: 5px; }\n    .c0 { background: #cc0000; }\n    .c1 { background: #00cc00; position: relative; z-index: 1; }\n    .c2 { background: #0000cc; }\n    small { color: #ffffff; font-size: 10px; }";
const LINE0_Tile: int = 5;

pub struct TileProps {
    index: int;
    j3pass_scope: int;
    j3pass_cls: string;
    j3pass_k0: int;
    j3pass_n0: string;
    j3pass_f0: f32;
    j3pass_s0: string;
}

pub struct TileEvents {
}

pub struct Tile {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &TileProps;
    tag_div: int;
    tag_small: int;
    cls_card: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow3: bool;
    slotWas3: bool;

    fn new(mem: &Arena): Tile {
        let ps = mem.alloc::<TileProps>(1);
        return Tile {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_small: 0,
            cls_card: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow3: false, slotWas3: false,
        };
    }

    fn j3Reset(this: &Tile) {
        let mem = this.mem;
        this.ready = false;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow3 = false;
        this.slotWas3 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Tile, "ui/Tile.j3ui", SCOPE_Tile, LINE0_Tile);
    }

    fn init(this: &Tile, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_small = d.tag("small");
        this.cls_card = d.css.intern("card");
    }

    fn update(this: &Tile, d: &Dom, p: TileProps): TileEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let index = p.index;
        let ev = TileEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Tile);
        d.clsId(n1, this.cls_card);
        d.clsDyn(n1, Text.scratch().add("c").add(`{index}`).str());
        d.scopePass(n1, p.j3pass_scope);
        d.stylePass(n1, 0, p.j3pass_k0, p.j3pass_n0, p.j3pass_f0, p.j3pass_s0);
        let n2 = d.open(0, this.tag_small, SCOPE_Tile);
        d.text(`{index}`);
        d.close();
        let s3 = d.enter(1);
        this.slotNow3 = true;
        if this.slotSite == 2 {
            ((this.slotOwn as ptr) as &Screen).slot2_default_update(d, this.slotI);
        } else if this.slotSite == 3 {
            ((this.slotOwn as ptr) as &Screen).slot3_default_update(d, this.slotI);
        } else {
        }
        d.leave(s3);
        d.close();
        if this.slotWas3 && !this.slotNow3 {
            if this.slotSite == 2 {
                ((this.slotOwn as ptr) as &Screen).slot2_default_leave(d, this.slotI);
            }             else if this.slotSite == 3 {
                ((this.slotOwn as ptr) as &Screen).slot3_default_leave(d, this.slotI);
            }
        }
        this.slotWas3 = this.slotNow3;
        this.slotNow3 = false;
        return ev;
    }

    fn destroy(this: &Tile) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Tile, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let s3 = d.enter(1);
                if this.slotSite == 2 {
                    ((this.slotOwn as ptr) as &Screen).slot2_default_paint(d, this.slotI);
                } else if this.slotSite == 3 {
                    ((this.slotOwn as ptr) as &Screen).slot3_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s3);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Tile): bool {
        return this.slotSite == 2 || this.slotSite == 3;
    }
}

