// ---- ui/Piece.j3ui
pub const SCOPE_Piece: int = 1;
const CSS_Piece: string = "    div { display: flex; }\n    canvas { flex-shrink: 0; margin-right: -80px; }\n    div, canvas { width: 80px; height: 80px; }\n    canvas { background: #00aa00; }";
const LINE0_Piece: int = 6;

pub struct PieceProps {
    index: int;
}

pub struct PieceEvents {
}

pub struct Piece {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &PieceProps;
    tag_div: int;
    tag_canvas: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow2: bool;
    slotWas2: bool;

    fn new(mem: &Arena): Piece {
        let ps = mem.alloc::<PieceProps>(1);
        return Piece {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_canvas: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow2: false, slotWas2: false,
        };
    }

    fn j3Reset(this: &Piece) {
        let mem = this.mem;
        this.ready = false;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow2 = false;
        this.slotWas2 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Piece, "ui/Piece.j3ui", SCOPE_Piece, LINE0_Piece);
    }

    fn init(this: &Piece, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_canvas = d.tag("canvas");
    }

    fn update(this: &Piece, d: &Dom, p: PieceProps): PieceEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = PieceEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Piece);
        let s2 = d.enter(0);
        this.slotNow2 = true;
        if this.slotSite == 1 {
            ((this.slotOwn as ptr) as &Screen).slot1_default_update(d, this.slotI);
        } else {
        }
        d.leave(s2);
        let n3 = d.open(1, this.tag_canvas, SCOPE_Piece);
        d.styleNumAt(n3, 0, "order", f32(1), "ui/Piece.j3ui", 5, 22);
        d.close();
        d.close();
        if this.slotWas2 && !this.slotNow2 {
            if this.slotSite == 1 {
                ((this.slotOwn as ptr) as &Screen).slot1_default_leave(d, this.slotI);
            }
        }
        this.slotWas2 = this.slotNow2;
        this.slotNow2 = false;
        return ev;
    }

    fn destroy(this: &Piece) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Piece, d: &Dom) {
        let index = this.p.index;
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                if this.slotSite == 1 {
                    ((this.slotOwn as ptr) as &Screen).slot1_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s2);
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    if d.beginCanvas(n3) {
                        let size3 = d.size(n3);
                        probe.mark(index);
                        d.endCanvas(n3);
                    }
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Piece): bool {
        return this.slotSite == 1;
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 2;
const CSS_Screen: string = "    .row { display: flex; width: 200px; height: 100px; }\n    .row.reversed { width: 80px; flex-direction: row-reverse; }\n    .reversed .item { margin-left: -80px; margin-right: 0; }\n    .item { flex-basis: 80px; flex-shrink: 0; margin-right: -80px; height: 80px; }\n    canvas { width: 80px; height: 80px; }\n    .red { background: #cc0000; }\n    .green { background: #00cc00; }\n    .blue { background: #0000cc; }\n    .plain { background: #eeee00; }\n    .paintCheck { display: flex; width: 100px; height: 30px; align-items: center; overflow: hidden; opacity: 0.7; }\n    .reverseCheck { display: flex; flex-direction: row-reverse; width: 100px; height: 30px; overflow: hidden; }\n    .reverseItem { flex-basis: 40px; flex-shrink: 0; margin-right: -30px; height: 30px; }\n    .columns { display: flex; flex-direction: column-reverse; flex-wrap: wrap-reverse; width: 120px; height: 50px; gap: 2px 6px; align-content: space-between; }\n    .columnItem { width: 20px; height: 20px; flex-shrink: 0; background: #00cc00; }\n    .many { display: flex; flex-wrap: wrap; width: 300px; }\n    .tile { flex-basis: 10px; height: 10px; background: #222222; }";
const LINE0_Screen: int = 51;

pub struct ScreenProps {
    flip: bool;
    show: bool;
    rotate: bool;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

struct Screen_R2 {
    uid: int;
    comp: int;
    dom: &Dom;
    c3: Tile;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        let a = mem.alloc::<Screen_R2>(1);
        a[0] = Screen_R2 {
            uid: uid,
            comp: comp,
            dom: d,
            c3: Tile.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R2, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c3.j3Reset();
    }

    fn take(pool: &List<&Screen_R2>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R2.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R2) {
        this.c3.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

struct Screen_R3 {
    uid: int;
    comp: int;
    dom: &Dom;
    c4: Tile;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R3 {
        let a = mem.alloc::<Screen_R3>(1);
        a[0] = Screen_R3 {
