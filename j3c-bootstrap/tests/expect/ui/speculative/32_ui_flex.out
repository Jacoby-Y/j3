    }

    fn reset(this: &Screen_R3, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c4.j3Reset();
    }

    fn take(pool: &List<&Screen_R3>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R3 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R3.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R3) {
        this.c4.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_canvas: int;
    tag_button: int;
    tag_span: int;
    cls_row: int;
    cls_reversed: int;
    cls_item: int;
    cls_red: int;
    cls_blue: int;
    cls_plain: int;
    cls_paintCheck: int;
    cls_reverseCheck: int;
    cls_reverseItem: int;
    cls_green: int;
    cls_columns: int;
    cls_columnItem: int;
    cls_many: int;
    cls_tile: int;
    c1: TextCSS;
    c2: Piece;
    if1: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;
    cnt2: int;
    e2: List<&Screen_R2>;
    fp2: List<&Screen_R2>;
    cnt3: int;
    e3: List<&Screen_R3>;
    fp3: List<&Screen_R3>;
    cnt4: int;
    cnt5: int;
    cnt6: int;
    cnt7: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_canvas: 0,
            tag_button: 0,
            tag_span: 0,
            cls_row: 0,
            cls_reversed: 0,
            cls_item: 0,
            cls_red: 0,
            cls_blue: 0,
            cls_plain: 0,
            cls_paintCheck: 0,
            cls_reverseCheck: 0,
            cls_reverseItem: 0,
            cls_green: 0,
            cls_columns: 0,
            cls_columnItem: 0,
            cls_many: 0,
            cls_tile: 0,
            c1: TextCSS.new(mem),
            c2: Piece.new(mem),
            if1: -1,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
            cnt2: 0,
            e2: List<&Screen_R2>.new(mem),
            fp2: List<&Screen_R2>.new(mem),
            cnt3: 0,
            e3: List<&Screen_R3>.new(mem),
            fp3: List<&Screen_R3>.new(mem),
            cnt4: 0,
            cnt5: 0,
            cnt6: 0,
            cnt7: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.if1 = -1;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
        this.cnt2 = 0;
        for q2 in 0..this.e2.len {
            this.fp2.push(this.e2.items[q2]);
        }
        this.e2.len = 0;
        this.cnt3 = 0;
        for q3 in 0..this.e3.len {
            this.fp3.push(this.e3.items[q3]);
        }
        this.e3.len = 0;
        this.cnt4 = 0;
        this.cnt5 = 0;
        this.cnt6 = 0;
        this.cnt7 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        TextCSS.styles(css);
        Piece.styles(css);
        Tile.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_canvas = d.tag("canvas");
        this.tag_button = d.tag("button");
        this.tag_span = d.tag("span");
        this.cls_row = d.css.intern("row");
        this.cls_reversed = d.css.intern("reversed");
        this.cls_item = d.css.intern("item");
        this.cls_red = d.css.intern("red");
        this.cls_blue = d.css.intern("blue");
        this.cls_plain = d.css.intern("plain");
        this.cls_paintCheck = d.css.intern("paintCheck");
        this.cls_reverseCheck = d.css.intern("reverseCheck");
        this.cls_reverseItem = d.css.intern("reverseItem");
        this.cls_green = d.css.intern("green");
        this.cls_columns = d.css.intern("columns");
        this.cls_columnItem = d.css.intern("columnItem");
        this.cls_many = d.css.intern("many");
        this.cls_tile = d.css.intern("tile");
    }

    fn logical(this: &Screen, i: int): int {
        let rotate = this.p.rotate;
 return if rotate { (i + 1) % 3 } else { i }; 
    }

    fn key(this: &Screen, i: int): string {

        let v = this.logical(i);
        return if v == 0 { "a" } else if v == 1 { "b" } else { "c" };
    
    }

    fn slot1_default_update(this: &Screen, d: &Dom, slotI: int) {
        let n7 = d.open(0, this.tag_canvas, SCOPE_Screen);
        d.styleStrAt(n7, 0, "margin-right", "-80px", "ui/Screen.j3ui", 15, 94);
        d.close();
    }

    fn slot1_default_paint(this: &Screen, d: &Dom, slotI: int) {
        let n7 = d.paintNext(0);
        if n7 >= 0 {
            d.paintBox(n7);
            if d.beginCanvas(n7) {
                let size7 = d.size(n7);
                probe.mark(6);
                d.endCanvas(n7);
            }
            let pass7 = 0;
            while d.paintChildren(pass7) {
                pass7 += 1;
            }
            d.paintEnd(n7);
        }
    }

    fn slot1_default_leave(this: &Screen, d: &Dom, slotI: int) {
    }

    fn slot2_default_update(this: &Screen, d: &Dom, i: int) {
        let r2 = this.e2.items[i];
        let n16 = d.open(0, this.tag_span, SCOPE_Screen);
        d.text("slot");
        d.close();
    }

    fn slot2_default_paint(this: &Screen, d: &Dom, i: int) {
        let r2 = this.e2.items[i];
        let n16 = d.paintNext(0);
        if n16 >= 0 {
            d.paintBox(n16);
            let pass16 = 0;
            while d.paintChildren(pass16) {
                pass16 += 1;
            }
            d.paintEnd(n16);
        }
    }

    fn slot2_default_leave(this: &Screen, d: &Dom, i: int) {
        let r2 = this.e2.items[i];
    }

    fn slot3_default_update(this: &Screen, d: &Dom, i: int) {
        let r3 = this.e3.items[i];
        let n20 = d.open(0, this.tag_span, SCOPE_Screen);
        d.text("slot");
        d.close();
    }

    fn slot3_default_paint(this: &Screen, d: &Dom, i: int) {
        let r3 = this.e3.items[i];
        let n20 = d.paintNext(0);
        if n20 >= 0 {
            d.paintBox(n20);
            let pass20 = 0;
            while d.paintChildren(pass20) {
                pass20 += 1;
            }
            d.paintEnd(n20);
        }
    }

    fn slot3_default_leave(this: &Screen, d: &Dom, i: int) {
        let r3 = this.e3.items[i];
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Piece.j3ui", CSS_Piece, 646107600, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 804639874, true) {
            ch = true;
        }
        if hotFile(css, "ui/TextCSS.j3ui", CSS_TextCSS, 645503536, true) {
            ch = true;
        }
        if hotFile(css, "ui/Tile.j3ui", CSS_Tile, 757157325, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let flip = p.flip;
        let rotate = p.rotate;
        let show = p.show;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, TextCSSProps { toggle: rotate });
        d.leave(s2);
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_row);
        d.clsIfId(n3, this.cls_reversed, flip);
        let n4 = d.open(0, this.tag_canvas, SCOPE_Screen);
        d.clsId(n4, this.cls_item);
        d.clsId(n4, this.cls_red);
        d.styleNumAt(n4, 0, "order", f32(if flip { -3 } else { 2 }), "ui/Screen.j3ui", 13, 34);
        d.close();
        let b5 = -1;
        if show {
            b5 = 0;
        }
        if b5 != this.if1 {
            if this.if1 == 0 {
                this.c2.destroy();
            }
            this.if1 = b5;
            if b5 == 0 {
                this.c2.j3Reset();
            }
        }
        if b5 == 0 {
            let n6 = d.open(1, this.tag_div, SCOPE_Screen);
            d.trans(n6, 1, f32(48), 1, f32(48), -1, 0.0, 20.0, 0.5, 0);
            d.clsId(n6, this.cls_item);
            d.styleNumAt(n6, 0, "order", f32(-1), "ui/Screen.j3ui", 15, 31);
            let s8 = d.enter(0);
            this.c2.slotSite = 1;
            this.c2.slotOwn = this as int;
            this.c2.slotI = 0;
            let e8 = this.c2.update(d, PieceProps { index: 2 });
            d.leave(s8);
            d.close();
        }
        let s9 = d.enter(2);
        let m9 = 3;
        this.cnt1 = m9;
        this.kd1.begin();
        for kv9 in 0..m9 {
            this.kd1.add(`{this.key(kv9)}`);
        }
        this.kd1.finish("ui/Screen.j3ui:17");
        if this.kd1.changed {
            for dq9 in 0..this.kd1.dead.len { let dr9 = this.e1.items[this.kd1.dead.items[dq9]]; dr9.destroy(); this.fp1.push(dr9); }
            this.eb1.len = 0;
            for rq9 in 0..m9 {
                let f9 = this.kd1.from.items[rq9];
                if f9 >= 0 { this.eb1.push(this.e1.items[f9]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t9 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t9;
        }
        for i in 0..m9 {
            let r1 = this.e1.items[i];
            d.keyBegin(r1.uid);
            let n10 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n10, this.cls_item);
            d.styleNumAt(n10, 0, "order", f32(0 - this.logical(i)), "ui/Screen.j3ui", 18, 31);
            let n11 = d.open(0, this.tag_canvas, SCOPE_Screen);
            d.clsId(n11, this.cls_blue);
            d.close();
            d.close();
            d.keyEnd();
        }
        d.leave(s9);
        let n12 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n12, this.cls_item);
        d.clsId(n12, this.cls_plain);
        d.styleNumAt(n12, 0, "order", f32(-2), "ui/Screen.j3ui", 20, 33);
        let n13 = d.open(0, this.tag_button, SCOPE_Screen);
        d.text("plain");
        d.close();
        d.close();
        d.close();
        let n14 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n14, this.cls_paintCheck);
        let s15 = d.enter(0);
        let m15 = 3;
        this.cnt2 = m15;
        while this.e2.len < m15 { this.e2.push(Screen_R2.take(&this.fp2, this.mem, d, -1, this as int)); }
        if this.e2.len > m15 {
            for zq15 in m15..this.e2.len { this.e2.items[zq15].destroy(); this.fp2.push(this.e2.items[zq15]); }
            this.e2.len = m15;
        }
        for i in 0..m15 {
            let r2 = this.e2.items[i];
            let s17 = d.enter(i * 1 + 0);
            r2.c3.slotSite = 2;
            r2.c3.slotOwn = this as int;
            r2.c3.slotI = i;
            let e17 = r2.c3.update(d, TileProps { index: i, j3pass_scope: 0, j3pass_cls: "", j3pass_n0: "order", j3pass_k0: 1, j3pass_f0: f32(2 - i), j3pass_s0: "" });
            d.leave(s17);
        }
        d.leave(s15);
        d.close();
        let n18 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n18, this.cls_paintCheck);
        let s19 = d.enter(0);
        let m19 = 3;
        this.cnt3 = m19;
        while this.e3.len < m19 { this.e3.push(Screen_R3.take(&this.fp3, this.mem, d, -1, this as int)); }
        if this.e3.len > m19 {
            for zq19 in m19..this.e3.len { this.e3.items[zq19].destroy(); this.fp3.push(this.e3.items[zq19]); }
            this.e3.len = m19;
        }
        for i in 0..m19 {
            let r3 = this.e3.items[i];
            let s21 = d.enter(i * 1 + 0);
            r3.c4.slotSite = 3;
            r3.c4.slotOwn = this as int;
            r3.c4.slotI = i;
            let e21 = r3.c4.update(d, TileProps { index: 2 - i, j3pass_scope: 0, j3pass_cls: "", j3pass_k0: 0, j3pass_n0: "", j3pass_f0: 0.0, j3pass_s0: "" });
            d.leave(s21);
        }
        d.leave(s19);
        d.close();
        let n22 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n22, this.cls_reverseCheck);
        let s23 = d.enter(0);
        let m23 = 3;
        this.cnt4 = m23;
        for i in 0..m23 {
            let n24 = d.open(i * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n24, this.cls_reverseItem);
            d.clsIfId(n24, this.cls_red, i == 0);
            d.clsIfId(n24, this.cls_green, i == 1);
            d.clsIfId(n24, this.cls_blue, i == 2);
            d.styleNumAt(n24, 0, "order", f32(2 - i), "ui/Screen.j3ui", 34, 98);
            d.close();
        }
        d.leave(s23);
        d.close();
        let n25 = d.open(5, this.tag_div, SCOPE_Screen);
