// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; gap: 14px; width: 100%; height: 100%; padding: 12px; }\n    .col { display: flex; flex-direction: column; gap: 8px; width: 104px; }\n    .hd { font-size: 11px; color: #707088; }\n    .row { display: flex; align-items: center; gap: 6px; }\n    .out { font-size: 11px; margin-top: 6px; }\n    .styled input { width: 22px; height: 22px; accent-color: #3f9a5a; background: #fdeaea; border-radius: 50%; }\n    .styled input:disabled { opacity: 0.4; }\n    .styled input:focus-visible { outline: 2px solid #d04060; outline-offset: 2px; }\n    .styled input:checked + span { color: #3f9a5a; font-weight: 700; }\n    input:focus-visible { outline: 2px solid #3070c0; outline-offset: 1px; }\n    input:disabled + span { opacity: 0.5; }";
const LINE0_Screen: int = 29;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
