    cls_out: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            size: "m",
            tone: "b",
            level: 2,
            tag_div: 0,
            tag_p: 0,
            tag_label: 0,
            tag_input: 0,
            tag_span: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_col: 0,
            cls_hd: 0,
            cls_row: 0,
            cls_styled: 0,
            cls_out: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.size = "m";
        this.tone = "b";
        this.level = 2;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_label = d.tag("label");
        this.tag_input = d.tag("input");
        this.tag_span = d.tag("span");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_col = d.css.intern("col");
        this.cls_hd = d.css.intern("hd");
        this.cls_row = d.css.intern("row");
        this.cls_styled = d.css.intern("styled");
        this.cls_out = d.css.intern("out");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 410992062, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

