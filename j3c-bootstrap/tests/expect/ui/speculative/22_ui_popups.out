// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .app { width: 640px; height: 480px; background: #11111b; position: relative; }\n    .picker { position: absolute; left: 20px; top: 20px; width: 100px; height: 32px; }\n    .tip { position: absolute; left: 360px; top: 20px; width: 160px; height: 32px; background: #313244; border-radius: 5px; }\n    p { position: absolute; left: 20px; top: 360px; }\n    .themed .j3-tooltip { width: 180px; padding: 12px 16px; border: 2px solid #cba6f7; border-radius: 12px; background: #302341; color: #f5e0dc; box-shadow: 0 8px 20px rgba(203,166,247,0.5); }\n    .themed .j3-color-panel { width: 260px; padding: 18px; border: 2px solid #a6e3a1; border-radius: 14px; background: #18362d; box-shadow: 0 8px 20px rgba(166,227,161,0.4); }\n    .themed .j3-color-sv { height: 150px; }\n    .themed .j3-color-hue { height: 20px; margin-top: 12px; }\n    .themed .j3-color-handle { top: 2px; }\n    .themed .j3-color-value { color: #a6e3a1; }";
const LINE0_Screen: int = 9;

pub struct ScreenProps {
    themed: bool;
    long: bool;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_input: int;
    tag_button: int;
    tag_p: int;
    cls_app: int;
    cls_themed: int;
    cls_picker: int;
    cls_tip: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_input: 0,
            tag_button: 0,
            tag_p: 0,
            cls_app: 0,
            cls_themed: 0,
            cls_picker: 0,
            cls_tip: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_input = d.tag("input");
        this.tag_button = d.tag("button");
        this.tag_p = d.tag("p");
        this.cls_app = d.css.intern("app");
        this.cls_themed = d.css.intern("themed");
        this.cls_picker = d.css.intern("picker");
        this.cls_tip = d.css.intern("tip");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 296370987, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let long = p.long;
        let themed = p.themed;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_app);
        d.clsIfId(n1, this.cls_themed, themed);
        let n2 = d.open(0, this.tag_input, SCOPE_Screen);
        d.clsId(n2, this.cls_picker);
        d.attrType(n2, "color");
        d.attrText(n2, "#89b4fa");
        d.close();
        let n3 = d.open(1, this.tag_button, SCOPE_Screen);
        d.clsId(n3, this.cls_tip);
        d.attrTitle(n3, if long { "A long tooltip wraps ordinary words and preserves explicit\nnewlines. SupercalifragilisticexpialidociousSupercalifragilisticexpialidocious also breaks to fit the box." } else { "Open it" });
        d.text("Hover for title");
        d.close();
        let n4 = d.open(2, this.tag_p, SCOPE_Screen);
        d.text("Real DOM popup boxes and children");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

