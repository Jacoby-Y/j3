        if open {
            let n2 = d.open(0, this.tag_div, SCOPE_Modal);
            d.clsId(n2, this.cls_body);
            let s3 = d.enter(0);
            this.slotNow3 = true;
            if this.slotSite == 9 {
                ((this.slotOwn as ptr) as &Screen).slot9_default_update(d, this.slotI);
            } else if this.slotSite == 10 {
                ((this.slotOwn as ptr) as &Screen).slot10_default_update(d, this.slotI);
            } else {
            }
            d.leave(s3);
            d.close();
        }
        d.close();
        if this.slotWas3 && !this.slotNow3 {
            if this.slotSite == 9 {
                ((this.slotOwn as ptr) as &Screen).slot9_default_leave(d, this.slotI);
            }             else if this.slotSite == 10 {
                ((this.slotOwn as ptr) as &Screen).slot10_default_leave(d, this.slotI);
            }
        }
        this.slotWas3 = this.slotNow3;
        this.slotNow3 = false;
        return ev;
    }

