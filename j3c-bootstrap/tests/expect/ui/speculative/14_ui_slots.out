        let label = p.label;
        let size = p.size;
        let ev = TagEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Tag);
        d.clsId(n1, this.cls_tag);
        let n2 = d.open(0, this.tag_span, SCOPE_Tag);
        d.text(Text.scratch().add(`{label}`).add(" ").add(`{size}`).str());
        d.close();
        if this.slotHas_footer() {
            let n3 = d.open(1, this.tag_small, SCOPE_Tag);
            d.text("has footer");
            d.close();
        }
        if this.slotHas_default() {
            let n4 = d.open(2, this.tag_small, SCOPE_Tag);
            d.text("has body");
            d.close();
        }
        let s5 = d.enter(3);
        this.slotNow5 = true;
        if this.slotSite == 7 {
            ((this.slotOwn as ptr) as &Screen).slot7_default_update(d, this.slotI);
