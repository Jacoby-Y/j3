    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Card.j3ui", CSS_Card, 705842039, true) {
            ch = true;
        }
        if hotFile(css, "ui/Modal.j3ui", CSS_Modal, 142711065, true) {
            ch = true;
        }
        if hotFile(css, "ui/Panel.j3ui", CSS_Panel, 939425868, true) {
            ch = true;
        }
        if hotFile(css, "ui/Probe.j3ui", CSS_Probe, 807784575, true) {
            ch = true;
        }
        if hotFile(css, "ui/Row.j3ui", CSS_Row, 184949733, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 363332981, true) {
            ch = true;
        }
        if hotFile(css, "ui/Tag.j3ui", CSS_Tag, 477574591, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_app);
        let s5 = d.enter(0);
        this.c1.slotSite = 2;
        this.c1.slotOwn = this as int;
        this.c1.slotI = 0;
        let e5 = this.c1.update(d, CardProps { title: "Audio" });
        d.leave(s5);
        if e5.ping {
            state.clicks += 100;
        }
        let s6 = d.enter(1);
        let x6 = this.names;
        let m6 = x6.len;
        this.cnt1 = m6;
        while this.e1.len < m6 { this.e1.push(Screen_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m6 {
            for zq6 in m6..this.e1.len { this.e1.items[zq6].destroy(); this.fp1.push(this.e1.items[zq6]); }
            this.e1.len = m6;
        }
        for i in 0..m6 {
            let nm = x6[i];
            let r1 = this.e1.items[i];
            let s10 = d.enter(i * 1 + 0);
            r1.c2.slotSite = 3;
            r1.c2.slotOwn = this as int;
            r1.c2.slotI = i;
            let e10 = r1.c2.update(d, CardProps { title: nm });
            d.leave(s10);
        }
        d.leave(s6);
        let s13 = d.enter(2);
        this.c4.slotSite = 4;
        this.c4.slotOwn = this as int;
        this.c4.slotI = 0;
        let e13 = this.c4.update(d, CardProps { title: "Outer" });
        d.leave(s13);
        let s14 = d.enter(3);
        let e14 = this.c6.update(d, CardProps { title: "Empty" });
        d.leave(s14);
        let s15 = d.enter(4);
        let e15 = this.c7.update(d, TagProps { label: "dflt", size: 7 });
        d.leave(s15);
        let s17 = d.enter(5);
        this.c8.slotSite = 6;
        this.c8.slotOwn = this as int;
        this.c8.slotI = 0;
        let e17 = this.c8.update(d, TagProps { label: "given", size: 2 });
        d.leave(s17);
        let s19 = d.enter(6);
        this.c9.slotSite = 7;
        this.c9.slotOwn = this as int;
        this.c9.slotI = 0;
        let e19 = this.c9.update(d, TagProps { label: "dflt", size: 7 });
        d.leave(s19);
        let s21 = d.enter(7);
        this.c10.slotSite = 8;
        this.c10.slotOwn = this as int;
        this.c10.slotI = 0;
        let e21 = this.c10.update(d, PanelProps { on: state.clicks > 5 });
        d.leave(s21);
        if e21.done {
            state.clicks += 5000;
        }
        let s23 = d.enter(8);
        this.c11.slotSite = 9;
        this.c11.slotOwn = this as int;
        this.c11.slotI = 0;
        let e23 = this.c11.update(d, ModalProps { open: state.show });
        d.leave(s23);
        let s24 = d.enter(9);
        let x24 = this.names;
        let m24 = x24.len;
        this.cnt2 = m24;
        while this.e2.len < m24 { this.e2.push(Screen_R2.take(&this.fp2, this.mem, d, -1, this as int)); }
        if this.e2.len > m24 {
            for zq24 in m24..this.e2.len { this.e2.items[zq24].destroy(); this.fp2.push(this.e2.items[zq24]); }
            this.e2.len = m24;
        }
        for mi in 0..m24 {
            let mn = x24[mi];
            let r2 = this.e2.items[mi];
            let s26 = d.enter(mi * 1 + 0);
            r2.c13.slotSite = 10;
            r2.c13.slotOwn = this as int;
            r2.c13.slotI = mi;
            let e26 = r2.c13.update(d, ModalProps { open: state.show });
            d.leave(s26);
        }
        d.leave(s24);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c4.destroy();
        this.c5.destroy();
        this.c6.destroy();
        this.c7.destroy();
        this.c8.destroy();
        this.c9.destroy();
