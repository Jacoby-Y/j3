// ---- ui/Panel.j3ui
pub const SCOPE_Panel: int = 3;
const CSS_Panel: string = "";
const LINE0_Panel: int = 0;

pub struct PanelProps {
    on: bool;
}

pub struct PanelEvents {
    done: bool;
}

struct Panel_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c2: Row;
    if1: int;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Panel_R1 {
        let a = mem.alloc::<Panel_R1>(1);
        a[0] = Panel_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c2: Row.new(mem),
            if1: -1,
        };
        return &a[0];
    }

    fn reset(this: &Panel_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c2.j3Reset();
        this.if1 = -1;
    }

    fn take(pool: &List<&Panel_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Panel_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Panel_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Panel_R1) {
        this.c2.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Panel {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &PanelProps;
    tag_div: int;
    tag_button: int;
    c1: Card;
    cnt1: int;
    e1: List<&Panel_R1>;
    fp1: List<&Panel_R1>;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow5: bool;
    slotWas5: bool;
    sev: PanelEvents;

    fn new(mem: &Arena): Panel {
        let ps = mem.alloc::<PanelProps>(1);
        return Panel {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_button: 0,
            c1: Card.new(mem),
            cnt1: 0,
            e1: List<&Panel_R1>.new(mem),
            fp1: List<&Panel_R1>.new(mem),
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow5: false, slotWas5: false,
            sev: PanelEvents { done: false },
        };
    }

    fn j3Reset(this: &Panel) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow5 = false;
        this.slotWas5 = false;
        this.sev = PanelEvents { done: false };
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Panel, "ui/Panel.j3ui", SCOPE_Panel, LINE0_Panel);
        Card.styles(css);
        Row.styles(css);
    }

    fn init(this: &Panel, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_button = d.tag("button");
    }

    fn slot1_default_update(this: &Panel, d: &Dom, slotI: int) {
        let ev = &this.sev;
        let on = this.p.on;
        let s2 = d.enter(0);
        let a2 = 2;
        let m2 = 4 - a2;
        this.cnt1 = m2;
        while this.e1.len < m2 { this.e1.push(Panel_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m2 {
            for zq2 in m2..this.e1.len { this.e1.items[zq2].destroy(); this.fp1.push(this.e1.items[zq2]); }
            this.e1.len = m2;
        }
        for i2 in 0..m2 {
            let q = a2 + i2;
            let r1 = this.e1.items[i2];
            let b3 = -1;
            if on {
                b3 = 0;
            }
            if b3 != r1.if1 {
                if r1.if1 == 0 {
                    r1.c2.destroy();
                }
                r1.if1 = b3;
                if b3 == 0 {
                    r1.c2.j3Reset();
                }
            }
            if b3 == 0 {
                let s4 = d.enter(i2 * 1 + 0);
                let e4 = r1.c2.update(d, RowProps { n: q });
                d.leave(s4);
            }
        }
        d.leave(s2);
        let s5 = d.enter(1);
        this.slotNow5 = true;
        if this.slotSite == 8 {
            ((this.slotOwn as ptr) as &Screen).slot8_default_update(d, this.slotI);
        } else {
        }
        d.leave(s5);
    }

    fn slot1_default_paint(this: &Panel, d: &Dom, slotI: int) {
        let s2 = d.enter(0);
        let m2 = this.cnt1;
        for i2 in 0..m2 {
            let r1 = this.e1.items[i2];
            let s4 = d.enter(i2 * 1 + 0);
            r1.c2.paint(d);
            d.leave(s4);
        }
        d.leave(s2);
        let s5 = d.enter(1);
        if this.slotSite == 8 {
            ((this.slotOwn as ptr) as &Screen).slot8_default_paint(d, this.slotI);
        } else {
        }
        d.leave(s5);
    }

    fn slot1_default_leave(this: &Panel, d: &Dom, slotI: int) {
        for q1 in 0..this.e1.len { this.e1.items[q1].destroy(); }
        for q1 in 0..this.e1.len { this.fp1.push(this.e1.items[q1]); }
        this.e1.len = 0;
    }

    fn slot1_actions_update(this: &Panel, d: &Dom, slotI: int) {
        let ev = &this.sev;
        let n6 = d.open(0, this.tag_button, SCOPE_Panel);
        if d.clicked(n6) {
            ev.done = true;
        }
        d.text("done");
        d.close();
    }

    fn slot1_actions_paint(this: &Panel, d: &Dom, slotI: int) {
        let n6 = d.paintNext(0);
        if n6 >= 0 {
            d.paintBox(n6);
            let pass6 = 0;
            while d.paintChildren(pass6) {
                pass6 += 1;
            }
            d.paintEnd(n6);
        }
    }

    fn slot1_actions_leave(this: &Panel, d: &Dom, slotI: int) {
    }

    fn update(this: &Panel, d: &Dom, p: PanelProps): PanelEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = PanelEvents { done: false };
        let n1 = d.open(0, this.tag_div, SCOPE_Panel);
        let s7 = d.enter(0);
        this.c1.slotSite = 1;
        this.c1.slotOwn = this as int;
        this.c1.slotI = 0;
        let e7 = this.c1.update(d, CardProps { title: "Pnl" });
        d.leave(s7);
        d.close();
        if this.slotWas5 && !this.slotNow5 {
            if this.slotSite == 8 {
                ((this.slotOwn as ptr) as &Screen).slot8_default_leave(d, this.slotI);
            }
        }
        this.slotWas5 = this.slotNow5;
        this.slotNow5 = false;
        if this.sev.done {
            ev.done = true;
            this.sev.done = false;
        }
        return ev;
    }

    fn destroy(this: &Panel) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Panel, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s7 = d.enter(0);
                this.c1.slotOwn = this as int;
                this.c1.paint(d);
                d.leave(s7);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Panel): bool {
        return this.slotSite == 8;
    }
}

// ---- ui/Probe.j3ui
pub const SCOPE_Probe: int = 4;
const CSS_Probe: string = "";
const LINE0_Probe: int = 0;

pub struct ProbeProps {
    state: &State;
}

pub struct ProbeEvents {
}

pub struct Probe {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ProbeProps;
    tag_span: int;

    fn new(mem: &Arena): Probe {
        let ps = mem.alloc::<ProbeProps>(1);
        return Probe {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_span: 0,
        };
    }

    fn j3Reset(this: &Probe) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Probe, "ui/Probe.j3ui", SCOPE_Probe, LINE0_Probe);
    }

    fn init(this: &Probe, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_span = d.tag("span");
    }

    fn onMount(this: &Probe) {
        let state = this.p.state;
 state.mounts += 1; 
    }

    fn onDestroy(this: &Probe) {
        let state = this.p.state;
 state.destroys += 1; 
    }

    fn update(this: &Probe, d: &Dom, p: ProbeProps): ProbeEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ProbeEvents {  };
        let n1 = d.open(0, this.tag_span, SCOPE_Probe);
        d.text("probe");
        d.close();
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Probe) {
        if !this.ready {
            return;
        }
        this.onDestroy();
        this.ready = false;
    }

    fn paint(this: &Probe, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Row.j3ui
pub const SCOPE_Row: int = 5;
const CSS_Row: string = "";
const LINE0_Row: int = 0;

pub struct RowProps {
    n: int;
}

pub struct RowEvents {
}

pub struct Row {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &RowProps;
    hits: int;
    tag_span: int;

    fn new(mem: &Arena): Row {
        let ps = mem.alloc::<RowProps>(1);
        return Row {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            hits: 0,
            tag_span: 0,
        };
    }

    fn j3Reset(this: &Row) {
        let mem = this.mem;
        this.ready = false;
        this.hits = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Row, "ui/Row.j3ui", SCOPE_Row, LINE0_Row);
    }

    fn init(this: &Row, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_span = d.tag("span");
    }

    fn update(this: &Row, d: &Dom, p: RowProps): RowEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let n = p.n;
        let ev = RowEvents {  };
        let n1 = d.open(0, this.tag_span, SCOPE_Row);
        if d.clicked(n1) {
            this.hits += 1;
        }
        d.text(Text.scratch().add("row ").add(`{n}`).add(" h").add(`{this.hits}`).str());
        d.close();
        return ev;
    }

    fn destroy(this: &Row) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Row, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

