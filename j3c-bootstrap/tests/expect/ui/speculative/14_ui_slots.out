// ---- ui/Card.j3ui
pub const SCOPE_Card: int = 1;
const CSS_Card: string = "    .card { padding: 4px; }";
const LINE0_Card: int = 11;

pub struct CardProps {
    title: string;
}

pub struct CardEvents {
    ping: bool;
}

pub struct Card {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &CardProps;
    local: int;
    tag_section: int;
    tag_header: int;
    tag_div: int;
    cls_card: int;
    cls_foot: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow3: bool;
    slotWas3: bool;
    slotNow4: bool;
    slotWas4: bool;
    slotNow6: bool;
    slotWas6: bool;

    fn new(mem: &Arena): Card {
        let ps = mem.alloc::<CardProps>(1);
        return Card {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            local: 0,
            tag_section: 0,
            tag_header: 0,
            tag_div: 0,
            cls_card: 0,
            cls_foot: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow3: false, slotWas3: false,
            slotNow4: false, slotWas4: false,
            slotNow6: false, slotWas6: false,
        };
    }

    fn j3Reset(this: &Card) {
        let mem = this.mem;
        this.ready = false;
        this.local = 0;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow3 = false;
        this.slotWas3 = false;
        this.slotNow4 = false;
        this.slotWas4 = false;
        this.slotNow6 = false;
        this.slotWas6 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Card, "ui/Card.j3ui", SCOPE_Card, LINE0_Card);
    }

    fn init(this: &Card, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_section = d.tag("section");
        this.tag_header = d.tag("header");
        this.tag_div = d.tag("div");
        this.cls_card = d.css.intern("card");
        this.cls_foot = d.css.intern("foot");
    }

    fn update(this: &Card, d: &Dom, p: CardProps): CardEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let title = p.title;
        let ev = CardEvents { ping: false };
        let n1 = d.open(0, this.tag_section, SCOPE_Card);
        d.clsId(n1, this.cls_card);
        let n2 = d.open(0, this.tag_header, SCOPE_Card);
        d.text(Text.scratch().add(`{title}`).add(" #").add(`{this.local}`).str());
        let s3 = d.enter(0);
        this.slotNow3 = true;
        if this.slotSite == 1 {
            ((this.slotOwn as ptr) as &Panel).slot1_actions_update(d, this.slotI);
        } else if this.slotSite == 2 {
            ((this.slotOwn as ptr) as &Screen).slot2_actions_update(d, this.slotI);
        } else if this.slotSite == 3 {
            ((this.slotOwn as ptr) as &Screen).slot3_actions_update(d, this.slotI);
        } else {
        }
        d.leave(s3);
        d.close();
        let s4 = d.enter(1);
        this.slotNow4 = true;
        if this.slotSite == 1 {
            ((this.slotOwn as ptr) as &Panel).slot1_default_update(d, this.slotI);
        } else if this.slotSite == 2 {
            ((this.slotOwn as ptr) as &Screen).slot2_default_update(d, this.slotI);
        } else if this.slotSite == 3 {
            ((this.slotOwn as ptr) as &Screen).slot3_default_update(d, this.slotI);
        } else if this.slotSite == 4 {
            ((this.slotOwn as ptr) as &Screen).slot4_default_update(d, this.slotI);
        } else if this.slotSite == 5 {
            ((this.slotOwn as ptr) as &Screen).slot5_default_update(d, this.slotI);
        } else {
        }
        d.leave(s4);
        let n5 = d.open(2, this.tag_div, SCOPE_Card);
        d.clsId(n5, this.cls_foot);
        let s6 = d.enter(0);
        this.slotNow6 = true;
        if this.slotSite == 2 {
            ((this.slotOwn as ptr) as &Screen).slot2_footer_update(d, this.slotI);
        } else {
            d.text("Default footer");
        }
        d.leave(s6);
        d.close();
        d.close();
        if this.slotWas3 && !this.slotNow3 {
            if this.slotSite == 1 {
                ((this.slotOwn as ptr) as &Panel).slot1_actions_leave(d, this.slotI);
            }             else if this.slotSite == 2 {
                ((this.slotOwn as ptr) as &Screen).slot2_actions_leave(d, this.slotI);
            }             else if this.slotSite == 3 {
                ((this.slotOwn as ptr) as &Screen).slot3_actions_leave(d, this.slotI);
            }
        }
        this.slotWas3 = this.slotNow3;
        this.slotNow3 = false;
        if this.slotWas4 && !this.slotNow4 {
            if this.slotSite == 1 {
                ((this.slotOwn as ptr) as &Panel).slot1_default_leave(d, this.slotI);
            }             else if this.slotSite == 2 {
                ((this.slotOwn as ptr) as &Screen).slot2_default_leave(d, this.slotI);
            }             else if this.slotSite == 3 {
                ((this.slotOwn as ptr) as &Screen).slot3_default_leave(d, this.slotI);
            }             else if this.slotSite == 4 {
                ((this.slotOwn as ptr) as &Screen).slot4_default_leave(d, this.slotI);
            }             else if this.slotSite == 5 {
                ((this.slotOwn as ptr) as &Screen).slot5_default_leave(d, this.slotI);
            }
        }
        this.slotWas4 = this.slotNow4;
        this.slotNow4 = false;
        if this.slotWas6 && !this.slotNow6 {
            if this.slotSite == 2 {
                ((this.slotOwn as ptr) as &Screen).slot2_footer_leave(d, this.slotI);
            }
        }
        this.slotWas6 = this.slotNow6;
        this.slotNow6 = false;
        return ev;
    }

    fn destroy(this: &Card) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Card, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let s3 = d.enter(0);
                        if this.slotSite == 1 {
                            ((this.slotOwn as ptr) as &Panel).slot1_actions_paint(d, this.slotI);
                        } else if this.slotSite == 2 {
                            ((this.slotOwn as ptr) as &Screen).slot2_actions_paint(d, this.slotI);
                        } else if this.slotSite == 3 {
                            ((this.slotOwn as ptr) as &Screen).slot3_actions_paint(d, this.slotI);
                        } else {
                        }
                        d.leave(s3);
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let s4 = d.enter(1);
                if this.slotSite == 1 {
                    ((this.slotOwn as ptr) as &Panel).slot1_default_paint(d, this.slotI);
                } else if this.slotSite == 2 {
                    ((this.slotOwn as ptr) as &Screen).slot2_default_paint(d, this.slotI);
                } else if this.slotSite == 3 {
                    ((this.slotOwn as ptr) as &Screen).slot3_default_paint(d, this.slotI);
                } else if this.slotSite == 4 {
                    ((this.slotOwn as ptr) as &Screen).slot4_default_paint(d, this.slotI);
                } else if this.slotSite == 5 {
                    ((this.slotOwn as ptr) as &Screen).slot5_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s4);
                let n5 = d.paintNext(2);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        let s6 = d.enter(0);
                        if this.slotSite == 2 {
                            ((this.slotOwn as ptr) as &Screen).slot2_footer_paint(d, this.slotI);
                        } else {
                        }
                        d.leave(s6);
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_actions(this: &Card): bool {
        return this.slotSite == 1 || this.slotSite == 2 || this.slotSite == 3;
    }

    fn slotHas_default(this: &Card): bool {
        return this.slotSite == 1 || this.slotSite == 2 || this.slotSite == 3 || this.slotSite == 4 || this.slotSite == 5;
    }

    fn slotHas_footer(this: &Card): bool {
        return this.slotSite == 2;
    }
}

