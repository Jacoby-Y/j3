        parseAt(css, CSS_Tag, "ui/Tag.j3ui", SCOPE_Tag, LINE0_Tag);
    }

    fn init(this: &Tag, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_small = d.tag("small");
        this.cls_tag = d.css.intern("tag");
    }

    fn update(this: &Tag, d: &Dom, p: TagProps): TagEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
