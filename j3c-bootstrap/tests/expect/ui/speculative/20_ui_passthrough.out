// ---- ui/Chip.j3ui
pub const SCOPE_Chip: int = 1;
const CSS_Chip: string = "    .chip { width: 40px; background: #333; }";
const LINE0_Chip: int = 5;

pub struct ChipProps {
    label: string;
    j3pass_scope: int;
    j3pass_cls: string;
    j3pass_k0: int;
    j3pass_n0: string;
    j3pass_f0: f32;
    j3pass_s0: string;
    j3pass_k1: int;
    j3pass_n1: string;
    j3pass_f1: f32;
    j3pass_s1: string;
}

pub struct ChipEvents {
}

pub struct Chip {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ChipProps;
    tag_div: int;
    cls_chip: int;

    fn new(mem: &Arena): Chip {
        let ps = mem.alloc::<ChipProps>(1);
        return Chip {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            cls_chip: 0,
        };
    }

    fn j3Reset(this: &Chip) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Chip, "ui/Chip.j3ui", SCOPE_Chip, LINE0_Chip);
    }

    fn init(this: &Chip, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_chip = d.css.intern("chip");
    }

    fn update(this: &Chip, d: &Dom, p: ChipProps): ChipEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let label = p.label;
        let ev = ChipEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Chip);
        d.clsId(n1, this.cls_chip);
        d.styleNumAt(n1, 0, "height", f32(20), "ui/Chip.j3ui", 4, 19);
        d.scopePass(n1, p.j3pass_scope);
        d.clsPass(n1, p.j3pass_cls);
        d.stylePass(n1, 1, p.j3pass_k0, p.j3pass_n0, p.j3pass_f0, p.j3pass_s0);
        d.stylePass(n1, 2, p.j3pass_k1, p.j3pass_n1, p.j3pass_f1, p.j3pass_s1);
        d.text(`{label}`);
        d.close();
        return ev;
    }

    fn destroy(this: &Chip) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Chip, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Pair.j3ui
pub const SCOPE_Pair: int = 2;
const CSS_Pair: string = "";
const LINE0_Pair: int = 0;

pub struct PairProps {
}

pub struct PairEvents {
}

