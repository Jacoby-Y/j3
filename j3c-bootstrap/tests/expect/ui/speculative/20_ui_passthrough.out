    }

    fn init(this: &Pair, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_span = d.tag("span");
    }

    fn update(this: &Pair, d: &Dom, p: PairProps): PairEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = PairEvents {  };
        let n1 = d.open(0, this.tag_span, SCOPE_Pair);
        d.text("one");
        d.close();
        let n2 = d.open(1, this.tag_span, SCOPE_Pair);
        d.text("two");
        d.close();
        return ev;
    }

    fn destroy(this: &Pair) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Pair, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
        let n2 = d.paintNext(1);
        if n2 >= 0 {
            d.paintBox(n2);
            let pass2 = 0;
            while d.paintChildren(pass2) {
                pass2 += 1;
            }
            d.paintEnd(n2);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 3;
const CSS_Screen: string = "    .wide { width: 120px; }\n    .c1 { width: 60px; }\n    .c2 { width: 70px; }\n    .on { height: 33px; }";
const LINE0_Screen: int = 16;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c7: Chip;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c7: Chip.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c7.j3Reset();
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        this.c7.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_app: int;
    c1: Chip;
    c2: Chip;
    c3: Chip;
    c4: Chip;
    c5: Chip;
    c6: Pair;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_app: 0,
            c1: Chip.new(mem),
            c2: Chip.new(mem),
            c3: Chip.new(mem),
            c4: Chip.new(mem),
            c5: Chip.new(mem),
            c6: Pair.new(mem),
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.c3.j3Reset();
        this.c4.j3Reset();
        this.c5.j3Reset();
        this.c6.j3Reset();
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Chip.styles(css);
        Pair.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_app = d.css.intern("app");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Chip.j3ui", CSS_Chip, 270361549, true) {
            ch = true;
        }
        if hotFile(css, "ui/Pair.j3ui", CSS_Pair, 976158137, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 666634217, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_app);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, ChipProps { label: "plain", j3pass_scope: 0, j3pass_cls: "", j3pass_k0: 0, j3pass_n0: "", j3pass_f0: 0.0, j3pass_s0: "", j3pass_k1: 0, j3pass_n1: "", j3pass_f1: 0.0, j3pass_s1: "" });
        d.leave(s2);
        let s3 = d.enter(1);
        let e3 = this.c2.update(d, ChipProps { label: "wide", j3pass_scope: SCOPE_Screen, j3pass_cls: "wide", j3pass_k0: 0, j3pass_n0: "", j3pass_f0: 0.0, j3pass_s0: "", j3pass_k1: 0, j3pass_n1: "", j3pass_f1: 0.0, j3pass_s1: "" });
        d.leave(s3);
        let s4 = d.enter(2);
        let e4 = this.c3.update(d, ChipProps { label: "hole", j3pass_scope: SCOPE_Screen, j3pass_cls: Text.scratch().add(`c{state.n} x {if state.on { "on" } else { "" }}`).str(), j3pass_k0: 0, j3pass_n0: "", j3pass_f0: 0.0, j3pass_s0: "", j3pass_k1: 0, j3pass_n1: "", j3pass_f1: 0.0, j3pass_s1: "" });
        d.leave(s4);
        let s5 = d.enter(3);
        let e5 = this.c4.update(d, ChipProps { label: "style", j3pass_scope: 0, j3pass_cls: "", j3pass_n0: "width", j3pass_k0: 1, j3pass_f0: f32(state.w), j3pass_s0: "", j3pass_k1: 0, j3pass_n1: "", j3pass_f1: 0.0, j3pass_s1: "" });
        d.leave(s5);
        let s6 = d.enter(4);
        let e6 = this.c5.update(d, ChipProps { label: "both", j3pass_scope: SCOPE_Screen, j3pass_cls: "wide", j3pass_n0: "width", j3pass_k0: 2, j3pass_f0: 0.0, j3pass_s0: Text.scratch().add(`{state.w}`).add("px").str(), j3pass_n1: "height", j3pass_k1: 1, j3pass_f1: f32(state.h), j3pass_s1: "" });
        d.leave(s6);
        let s7 = d.enter(5);
        let e7 = this.c6.update(d, PairProps {  });
        d.leave(s7);
        let s8 = d.enter(6);
        let x8 = state.rows;
        let m8 = x8.len;
        this.cnt1 = m8;
        this.kd1.begin();
        for kv8 in 0..m8 {
            let ki8 = x8[kv8];
            this.kd1.add(`{ki8.id}`);
        }
        this.kd1.finish("ui/Screen.j3ui:12");
        if this.kd1.changed {
            for dq8 in 0..this.kd1.dead.len { let dr8 = this.e1.items[this.kd1.dead.items[dq8]]; dr8.destroy(); this.fp1.push(dr8); }
            this.eb1.len = 0;
            for rq8 in 0..m8 {
                let f8 = this.kd1.from.items[rq8];
                if f8 >= 0 { this.eb1.push(this.e1.items[f8]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t8 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t8;
        }
        for i8 in 0..m8 {
            let it = x8[i8];
            let r1 = this.e1.items[i8];
            d.keyBegin(r1.uid);
            let s9 = d.enter(0);
            let e9 = r1.c7.update(d, ChipProps { label: it.name, j3pass_scope: SCOPE_Screen, j3pass_cls: Text.scratch().add(`wide {if state.on { "on" } else { "" }}`).str(), j3pass_n0: "opacity", j3pass_k0: 1, j3pass_f0: f32(state.alpha), j3pass_s0: "", j3pass_k1: 0, j3pass_n1: "", j3pass_f1: 0.0, j3pass_s1: "" });
            d.leave(s9);
            d.keyEnd();
        }
        d.leave(s8);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c2.destroy();
        this.c3.destroy();
        this.c4.destroy();
        this.c5.destroy();
        this.c6.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                let s3 = d.enter(1);
                this.c2.paint(d);
                d.leave(s3);
                let s4 = d.enter(2);
                this.c3.paint(d);
                d.leave(s4);
                let s5 = d.enter(3);
                this.c4.paint(d);
                d.leave(s5);
                let s6 = d.enter(4);
                this.c5.paint(d);
                d.leave(s6);
                let s7 = d.enter(5);
                this.c6.paint(d);
                d.leave(s7);
                let s8 = d.enter(6);
                let m8 = this.cnt1;
                for i8 in 0..m8 {
                    let r1 = this.e1.items[i8];
                    d.paintGroup(r1.uid);
                    let s9 = d.enter(0);
                    r1.c7.paint(d);
                    d.leave(s9);
                    d.paintGroupEnd();
                }
                d.leave(s8);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

