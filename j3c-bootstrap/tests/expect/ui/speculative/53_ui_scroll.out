// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; }\n    .title { margin: 6px 0; font-size: 14px; }\n    .carousel { display: flex; gap: 10px; width: 240px; height: 90px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding: 0 12px; border: 1px solid #909098; background: #e4e4ee; }\n    .card { flex-shrink: 0; width: 200px; height: 80px; margin: 4px 0; scroll-snap-align: start; scroll-margin: 0; border-radius: 6px; color: #fff; font-size: 16px; padding: 28px 10px; }\n    .c1 { background: #d04060; } .c2 { background: #d08030; } .c3 { background: #40a060; } .c4 { background: #3070c0; } .c5 { background: #8050c0; } .c6 { background: #606070; }\n    .list { width: 240px; height: 140px; overflow-y: auto; border: 1px solid #909098; background: #fff; }\n    .jump { margin-top: 8px; padding: 4px 10px; }\n    .item { height: 28px; padding: 6px 8px; border-bottom: 1px solid #e0e0e8; }";
const LINE0_Screen: int = 21;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    tag_button: int;
    cls_screen: int;
    cls_page: int;
    cls_title: int;
    cls_carousel: int;
    cls_card: int;
    cls_list: int;
    cls_item: int;
    cls_jump: int;
    cnt1: int;
    cnt2: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_button: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_title: 0,
            cls_carousel: 0,
            cls_card: 0,
            cls_list: 0,
            cls_item: 0,
            cls_jump: 0,
            cnt1: 0,
            cnt2: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        this.cnt2 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_button = d.tag("button");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_title = d.css.intern("title");
        this.cls_carousel = d.css.intern("carousel");
        this.cls_card = d.css.intern("card");
        this.cls_list = d.css.intern("list");
        this.cls_item = d.css.intern("item");
        this.cls_jump = d.css.intern("jump");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 173739488, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_p, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Carousel");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.attrId(n3, "carousel");
        d.clsId(n3, this.cls_carousel);
        let s4 = d.enter(0);
        let m4 = 6;
        this.cnt1 = m4;
        for c in 0..m4 {
            let n5 = d.open(c * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n5, this.cls_card);
            d.clsDyn(n5, Text.scratch().add("c").add(`{c + 1}`).str());
            d.text(Text.scratch().add("Card ").add(`{c + 1}`).str());
            d.close();
        }
        d.leave(s4);
        d.close();
        let n6 = d.open(2, this.tag_p, SCOPE_Screen);
        d.clsId(n6, this.cls_title);
        d.text("List");
        d.close();
        let n7 = d.open(3, this.tag_div, SCOPE_Screen);
        d.attrId(n7, "list");
        d.clsId(n7, this.cls_list);
        let s8 = d.enter(0);
        let m8 = 20;
        this.cnt2 = m8;
        for it in 0..m8 {
            let n9 = d.open(it * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n9, this.cls_item);
            d.text(Text.scratch().add("Item ").add(`{it + 1}`).str());
            d.close();
        }
        d.leave(s8);
        let n10 = d.open(1, this.tag_div, SCOPE_Screen);
        d.attrId(n10, "last");
        d.clsId(n10, this.cls_item);
        d.text("Last item (static id)");
        d.close();
        d.close();
        let n11 = d.open(4, this.tag_button, SCOPE_Screen);
        d.clsId(n11, this.cls_jump);
        if d.clicked(n11) {
            d.scrollIntoView(d.byId("last"), SC_CENTER, true);
        }
        d.text("To last");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let s4 = d.enter(0);
                        let m4 = this.cnt1;
                        for c in 0..m4 {
                            let n5 = d.paintNext(c * 1 + 0);
                            if n5 >= 0 {
                                d.paintBox(n5);
                                let pass5 = 0;
                                while d.paintChildren(pass5) {
                                    pass5 += 1;
                                }
                                d.paintEnd(n5);
                            }
                        }
                        d.leave(s4);
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n6 = d.paintNext(2);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n7 = d.paintNext(3);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        let s8 = d.enter(0);
                        let m8 = this.cnt2;
                        for it in 0..m8 {
                            let n9 = d.paintNext(it * 1 + 0);
                            if n9 >= 0 {
                                d.paintBox(n9);
                                let pass9 = 0;
                                while d.paintChildren(pass9) {
                                    pass9 += 1;
                                }
                                d.paintEnd(n9);
                            }
                        }
                        d.leave(s8);
                        let n10 = d.paintNext(1);
                        if n10 >= 0 {
                            d.paintBox(n10);
                            let pass10 = 0;
                            while d.paintChildren(pass10) {
                                pass10 += 1;
                            }
                            d.paintEnd(n10);
                        }
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n11 = d.paintNext(4);
                if n11 >= 0 {
                    d.paintBox(n11);
                    let pass11 = 0;
                    while d.paintChildren(pass11) {
                        pass11 += 1;
                    }
                    d.paintEnd(n11);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

