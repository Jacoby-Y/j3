        if d.clicked(n11) {
            this.c = !this.c;
        }
        d.attrChecked(n11, this.c);
        d.close();
        let n12 = d.open(1, this.tag_label, SCOPE_Screen);
        d.text("Celebrate");
        d.close();
        d.close();
        d.close();
        let n13 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n13, this.cls_card);
        let n14 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n14, this.cls_title);
        d.text("Plain card");
        d.close();
        d.close();
        let n15 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n15, this.cls_card);
        let n16 = d.open(0, this.tag_img, SCOPE_Screen);
        d.clsId(n16, this.cls_pic);
        d.attrMedia(n16, 0, "assets/icon.png");
        d.close();
        let n17 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n17, this.cls_title);
        d.text("Card with image");
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

