            cls_list: 0,
            cls_task: 0,
            cls_card: 0,
            cls_title: 0,
            cls_pic: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.a = true;
        this.b = false;
        this.c = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_h2 = d.tag("h2");
        this.tag_input = d.tag("input");
        this.tag_label = d.tag("label");
        this.tag_img = d.tag("img");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_list = d.css.intern("list");
        this.cls_task = d.css.intern("task");
        this.cls_card = d.css.intern("card");
        this.cls_title = d.css.intern("title");
        this.cls_pic = d.css.intern("pic");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 295022397, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
