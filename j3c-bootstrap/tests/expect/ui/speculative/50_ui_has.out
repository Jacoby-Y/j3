        let n3 = d.open(0, this.tag_h2, SCOPE_Screen);
        d.text("Tasks");
        d.close();
        let n4 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_task);
        let n5 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n5, "checkbox");
        if d.clicked(n5) {
            this.a = !this.a;
        }
        d.attrChecked(n5, this.a);
        d.close();
        let n6 = d.open(1, this.tag_label, SCOPE_Screen);
        d.text("Write the docs");
        d.close();
        d.close();
        let n7 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_task);
        let n8 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n8, "checkbox");
        if d.clicked(n8) {
