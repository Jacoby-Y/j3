// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; }\n    h2 { font-size: 13px; margin-bottom: 4px; }\n    .list { width: 200px; margin-bottom: 12px; }\n    .task { display: flex; height: 22px; align-items: center; padding: 0 6px; }\n    .task label { margin-left: 6px; color: #303040; }\n    .task:has(input:checked) { background: #d8f4e6; }\n    .task:has(input:checked) label { color: #20a070; text-decoration: line-through; }\n    .card { width: 200px; height: 48px; margin-bottom: 8px; padding: 6px; background: #ffffff; display: flex; align-items: center; }\n    .card .pic { width: 32px; height: 32px; margin-right: 8px; }\n    .card:has(> img) { border: 2px solid #8060c0; background: #f0e8ff; }\n    .card:has(> img) .title { font-weight: bold; color: #6040a0; }";
const LINE0_Screen: int = 17;

