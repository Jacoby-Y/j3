                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
