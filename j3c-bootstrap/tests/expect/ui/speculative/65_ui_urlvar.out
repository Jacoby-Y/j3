// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; flex-wrap: wrap; width: 100%; height: 100%; padding: 10px; gap: 10px; align-content: flex-start; }\n    .cell { width: 200px; height: 150px; }\n    .lbl { font-size: 10px; margin-top: 3px; }\n    .frame { width: 150px; height: 90px; border: 16px solid transparent; image-rendering: pixelated; }\n    .a { border-image: var(--box) 8 fill / 16px; border-image-repeat: round; }\n    .b { border-image-source: var(--box); border-image-slice: 8 fill; border-image-width: 16px; border-image-repeat: space; }\n    .layers { width: 190px; height: 120px; border-radius: 12px; image-rendering: pixelated; background: #20304c;\n        background-image: var(--tile), linear-gradient(135deg, rgba(40, 160, 200, 0.55), rgba(220, 60, 120, 0.55)), var(--nope, url(assets/stripes.png));\n        background-size: 32px 32px, auto, 48px 48px; background-repeat: repeat, no-repeat, round; background-position: 0 0, 0 0, center; }\n    .lone { width: 190px; height: 120px; image-rendering: pixelated; background: #20304c; background-image: var(--nope, var(--tile)); background-size: 40px; }\n    .miss { width: 190px; height: 120px; image-rendering: pixelated; background: #20304c; background-image: var(--nothing, url(assets/dots.png)); background-size: 24px; }\n    .short { width: 190px; height: 120px; image-rendering: pixelated; background: var(--tile) 0 0 / 30px 30px repeat, #20304c; }";
const LINE0_Screen: int = 12;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    cls_screen: int;
    cls_page: int;
    cls_cell: int;
    cls_frame: int;
    cls_a: int;
    cls_lbl: int;
    cls_b: int;
    cls_layers: int;
    cls_lone: int;
    cls_miss: int;
    cls_short: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_cell: 0,
            cls_frame: 0,
            cls_a: 0,
            cls_lbl: 0,
            cls_b: 0,
            cls_layers: 0,
            cls_lone: 0,
            cls_miss: 0,
            cls_short: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_cell = d.css.intern("cell");
        this.cls_frame = d.css.intern("frame");
        this.cls_a = d.css.intern("a");
        this.cls_lbl = d.css.intern("lbl");
        this.cls_b = d.css.intern("b");
        this.cls_layers = d.css.intern("layers");
        this.cls_lone = d.css.intern("lone");
        this.cls_miss = d.css.intern("miss");
        this.cls_short = d.css.intern("short");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 622088063, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_cell);
        let n3 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_frame);
        d.clsId(n3, this.cls_a);
        d.close();
        let n4 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n4, this.cls_lbl);
        d.text("border-image: var()");
        d.close();
        d.close();
        let n5 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_cell);
        let n6 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_frame);
        d.clsId(n6, this.cls_b);
        d.close();
        let n7 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n7, this.cls_lbl);
        d.text("border-image-source: var()");
        d.close();
        d.close();
        let n8 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_cell);
        let n9 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n9, this.cls_layers);
        d.close();
        let n10 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n10, this.cls_lbl);
        d.text("var() + gradient + fallback");
        d.close();
        d.close();
        let n11 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n11, this.cls_cell);
        let n12 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n12, this.cls_lone);
        d.close();
        let n13 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n13, this.cls_lbl);
        d.text("lone var(), fallback chain");
        d.close();
        d.close();
        let n14 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n14, this.cls_cell);
        let n15 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n15, this.cls_miss);
        d.close();
        let n16 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n16, this.cls_lbl);
        d.text("missing: fallback url()");
        d.close();
        d.close();
        let n17 = d.open(5, this.tag_div, SCOPE_Screen);
        d.clsId(n17, this.cls_cell);
        let n18 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n18, this.cls_short);
        d.close();
        let n19 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n19, this.cls_lbl);
        d.text("background: var() shorthand");
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
