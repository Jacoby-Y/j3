// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = ".page { width: 400px; height: 300px; background: #181825; color: #ffffff; }\n.owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; }\n.menu, .card { width: 160px; padding: 8px; background: #313244; border-radius: 8px; box-shadow: 0 4px 12px #000000; }\nbutton { display: block; width: 140px; height: 28px; }";
const LINE0_Screen: int = 18;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    menu: bool;
    card: bool;
    tag_div: int;
    tag_button: int;
    tag_span: int;
    cls_page: int;
    cls_owner: int;
    cls_menu: int;
    cls_card: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            menu: false,
            card: false,
            tag_div: 0,
            tag_button: 0,
            tag_span: 0,
            cls_page: 0,
            cls_owner: 0,
            cls_menu: 0,
            cls_card: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.menu = false;
        this.card = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_button = d.tag("button");
        this.tag_span = d.tag("span");
        this.cls_page = d.css.intern("page");
        this.cls_owner = d.css.intern("owner");
        this.cls_menu = d.css.intern("menu");
        this.cls_card = d.css.intern("card");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 649857020, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_owner);
        this.card = d.hoverCard(n2);
        if d.contextAt(n2) {
            let mouse_n2_contextmenu = d.mouseAt();
            this.menu = true;
        }
        d.text("Right click or hover ");
        if this.menu {
            let n3 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n3, this.cls_menu);
            d.attrContext(n3);
            if d.closeRequested(n3) {
                this.menu = false;
            }
            let n4 = d.open(0, this.tag_button, SCOPE_Screen);
            d.text("Apple");
            d.close();
            let n5 = d.open(1, this.tag_button, SCOPE_Screen);
            d.text("Blueberry");
            d.close();
            let n6 = d.open(2, this.tag_button, SCOPE_Screen);
            d.text("Éclair");
            d.close();
            d.close();
        }
        if this.card {
            let n7 = d.open(1, this.tag_div, SCOPE_Screen);
            d.clsId(n7, this.cls_card);
            d.attrOverlay(n7, 2);
            let n8 = d.open(0, this.tag_span, SCOPE_Screen);
            d.text("Custom markup");
            d.close();
            let n9 = d.open(1, this.tag_button, SCOPE_Screen);
            d.text("Details");
            d.close();
            d.close();
        }
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                let n4 = d.paintNext(0);
                                if n4 >= 0 {
                                    d.paintBox(n4);
                                    let pass4 = 0;
                                    while d.paintChildren(pass4) {
                                        pass4 += 1;
                                    }
                                    d.paintEnd(n4);
                                }
                                let n5 = d.paintNext(1);
                                if n5 >= 0 {
                                    d.paintBox(n5);
                                    let pass5 = 0;
                                    while d.paintChildren(pass5) {
                                        pass5 += 1;
                                    }
                                    d.paintEnd(n5);
                                }
                                let n6 = d.paintNext(2);
                                if n6 >= 0 {
                                    d.paintBox(n6);
                                    let pass6 = 0;
                                    while d.paintChildren(pass6) {
                                        pass6 += 1;
                                    }
                                    d.paintEnd(n6);
                                }
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n7 = d.paintNext(1);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                let n8 = d.paintNext(0);
                                if n8 >= 0 {
                                    d.paintBox(n8);
                                    let pass8 = 0;
                                    while d.paintChildren(pass8) {
                                        pass8 += 1;
                                    }
                                    d.paintEnd(n8);
                                }
                                let n9 = d.paintNext(1);
                                if n9 >= 0 {
                                    d.paintBox(n9);
                                    let pass9 = 0;
                                    while d.paintChildren(pass9) {
                                        pass9 += 1;
                                    }
                                    d.paintEnd(n9);
                                }
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

