// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; height: 200px; padding: 10px; background: var(--bg); color: var(--fg); font-size: 14px; }\n    .title { margin-bottom: 8px; }\n    @media (pointer: coarse) and (hover: none) { .title { padding: 6px; background: #d0a030; } }\n    .card { padding: 8px; margin-bottom: 8px; border-radius: 6px; background: var(--card); }\n    .spin { padding: 8px; margin-bottom: 8px; background: #3050a0; color: #ffffff; }\n    @media (prefers-reduced-motion: reduce) { .spin { background: #a05030; } }\n    .box { width: 120px; height: 40px; padding: 8px; box-sizing: border-box; border-radius: 4px; background: #308050; color: #ffffff; }";
const LINE0_Screen: int = 10;

pub struct ScreenProps {
    on: bool;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_title: int;
    cls_card: int;
    cls_spin: int;
    cls_box: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_card: 0,
            cls_spin: 0,
            cls_box: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_card = d.css.intern("card");
        this.cls_spin = d.css.intern("spin");
        this.cls_box = d.css.intern("box");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 281060114, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let on = p.on;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Preferences");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_card);
        d.text("card (scheme)");
        d.close();
        let n4 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_spin);
        d.text("css transition");
        d.close();
        if on {
            let n5 = d.open(3, this.tag_div, SCOPE_Screen);
            d.trans(n5, 1, f32(200), 1, f32(200), 1, 0.0, 20.0, 0.5, 0);
            d.clsId(n5, this.cls_box);
            d.text("fade in");
            d.close();
        }
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n5 = d.paintNext(3);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

