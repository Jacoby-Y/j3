// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 320px; padding: 10px; color: #ffffff; font-size: 14px; user-select: none; }\n    .title { margin-bottom: 8px; color: #a0b0d0; }\n    .grid { display: flex; flex-wrap: wrap; gap: 6px; }\n    .slot { width: 66px; height: 54px; background: #20243a; border: 2px solid #3a4060; border-radius: 6px; }\n    .slot:drop-target { border-color: #ffd040; background: #384060; }\n    .item { width: 62px; height: 50px; background: #3050a0; border-radius: 4px; text-align: center; padding-top: 16px; box-sizing: border-box; cursor: grab; }\n    .item:dragging { opacity: 0.35; }";
const LINE0_Screen: int = 23;

pub struct ScreenProps {
    cells: []int;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_title: int;
    cls_grid: int;
    cls_slot: int;
    cls_item: int;
    cnt1: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_grid: 0,
            cls_slot: 0,
            cls_item: 0,
            cnt1: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_grid = d.css.intern("grid");
        this.cls_slot = d.css.intern("slot");
        this.cls_item = d.css.intern("item");
    }

    fn label(this: &Screen, v: int): string {
 return if v == 1 { "Sword" } else if v == 2 { "Bow" } else if v == 3 { "Potion" } else { "" }; 
    }

    fn move(this: &Screen, from: int, to: int) {
        let cells = this.p.cells;

        if from != to && cells[to] == 0 {
            cells[to] = cells[from];
            cells[from] = 0;
        }
    
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 761276235, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let cells = p.cells;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Inventory");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_grid);
        let s4 = d.enter(0);
        let m4 = 8;
        this.cnt1 = m4;
        for i in 0..m4 {
            let n5 = d.open(i * 1 + 0, this.tag_div, SCOPE_Screen);
            d.clsId(n5, this.cls_slot);
            d.attrDragTarget(n5, 8);
            if d.dropAt(n5) {
                let mouse_n5_drop = d.localMouse(n5);
                let data_n5_drop = d.dragData();
                let dragId_n5_drop = d.dragIdOf();
                this.move(dragId_n5_drop, i);
            }
            if cells[i] != 0 {
                let n6 = d.open(0, this.tag_div, SCOPE_Screen);
                d.clsId(n6, this.cls_item);
                d.attrDraggable(n6, true);
                d.attrDragId(n6, i);
                d.text(`{this.label(cells[i])}`);
                d.close();
            }
            d.close();
        }
        d.leave(s4);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let s4 = d.enter(0);
                        let m4 = this.cnt1;
                        for i in 0..m4 {
                            let n5 = d.paintNext(i * 1 + 0);
                            if n5 >= 0 {
                                d.paintBox(n5);
                                let pass5 = 0;
                                while d.paintChildren(pass5) {
                                    let n6 = d.paintNext(0);
                                    if n6 >= 0 {
                                        d.paintBox(n6);
                                        let pass6 = 0;
                                        while d.paintChildren(pass6) {
                                            pass6 += 1;
                                        }
                                        d.paintEnd(n6);
                                    }
                                    pass5 += 1;
                                }
                                d.paintEnd(n5);
                            }
                        }
                        d.leave(s4);
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

