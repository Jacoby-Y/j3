                            d.paintEnd(n15);
                        }
                        let n16 = d.paintNext(1);
                        if n16 >= 0 {
                            d.paintBox(n16);
                            let pass16 = 0;
                            while d.paintChildren(pass16) {
                                pass16 += 1;
