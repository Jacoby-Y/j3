                            while d.paintChildren(pass12) {
                                pass12 += 1;
                            }
                            d.paintEnd(n12);
                        }
                        let n13 = d.paintNext(1);
                        if n13 >= 0 {
                            d.paintBox(n13);
                            let pass13 = 0;
                            while d.paintChildren(pass13) {
                                pass13 += 1;
                            }
                            d.paintEnd(n13);
                        }
                        pass11 += 1;
                    }
                    d.paintEnd(n11);
                }
                let n14 = d.paintNext(7);
                if n14 >= 0 {
                    d.paintBox(n14);
                    let pass14 = 0;
                    while d.paintChildren(pass14) {
                        let n15 = d.paintNext(0);
                        if n15 >= 0 {
                            d.paintBox(n15);
                            let pass15 = 0;
                            while d.paintChildren(pass15) {
                                pass15 += 1;
