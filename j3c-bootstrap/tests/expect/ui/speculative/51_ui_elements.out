// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; color: #202030; }\n    .txt { margin-bottom: 8px; font-size: 13px; }\n    .nw { white-space: nowrap; }\n    .bar { display: block; width: 200px; height: 10px; margin-bottom: 8px; accent-color: #2080e0; background: #d8d8e4; }\n    .gauge { display: block; width: 200px; height: 10px; margin-bottom: 6px; background: #d8d8e4; }\n    .box { width: 240px; margin-top: 8px; }\n    .box summary { font-size: 13px; font-weight: bold; }\n    .box summary::before { content: \"▸ \"; }\n    .box:open > summary::before { content: \"▾ \"; }\n    .body { padding: 4px 0 0 14px; font-size: 13px; }";
const LINE0_Screen: int = 15;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    open: bool;
    tag_div: int;
    tag_p: int;
    tag_br: int;
    tag_progress: int;
    tag_meter: int;
    tag_details: int;
    tag_summary: int;
    cls_screen: int;
    cls_page: int;
    cls_txt: int;
    cls_nw: int;
    cls_bar: int;
    cls_gauge: int;
    cls_box: int;
    cls_body: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            open: true,
            tag_div: 0,
            tag_p: 0,
            tag_br: 0,
            tag_progress: 0,
            tag_meter: 0,
            tag_details: 0,
            tag_summary: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_txt: 0,
            cls_nw: 0,
            cls_bar: 0,
            cls_gauge: 0,
            cls_box: 0,
            cls_body: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.open = true;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_br = d.tag("br");
        this.tag_progress = d.tag("progress");
        this.tag_meter = d.tag("meter");
        this.tag_details = d.tag("details");
        this.tag_summary = d.tag("summary");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_txt = d.css.intern("txt");
        this.cls_nw = d.css.intern("nw");
        this.cls_bar = d.css.intern("bar");
        this.cls_gauge = d.css.intern("gauge");
        this.cls_box = d.css.intern("box");
        this.cls_body = d.css.intern("body");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 191614552, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_p, SCOPE_Screen);
        d.clsId(n2, this.cls_txt);
        d.text("First line");
        let n3 = d.open(0, this.tag_br, SCOPE_Screen);
        d.close();
        d.text("second line");
        let n4 = d.open(1, this.tag_br, SCOPE_Screen);
        d.close();
        d.text("third");
        d.close();
        let n5 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n5, this.cls_txt);
        d.clsId(n5, this.cls_nw);
        d.text("nowrap line one");
        let n6 = d.open(0, this.tag_br, SCOPE_Screen);
        d.close();
        d.text("nowrap line two");
        d.close();
        let n7 = d.open(2, this.tag_progress, SCOPE_Screen);
        d.clsId(n7, this.cls_bar);
        d.attrValue(n7, f32(0.4));
        d.attrMax(n7, 1.0);
        d.close();
        let n8 = d.open(3, this.tag_meter, SCOPE_Screen);
        d.clsId(n8, this.cls_gauge);
        d.attrValue(n8, f32(9));
        d.attrMin(n8, f32(0));
        d.attrMax(n8, f32(10));
        d.attrMeter(n8, 0, f32(3));
        d.attrMeter(n8, 1, f32(7));
        d.attrMeter(n8, 2, f32(10));
        d.close();
        let n9 = d.open(4, this.tag_meter, SCOPE_Screen);
        d.clsId(n9, this.cls_gauge);
        d.attrValue(n9, f32(5));
        d.attrMin(n9, f32(0));
        d.attrMax(n9, f32(10));
        d.attrMeter(n9, 0, f32(3));
        d.attrMeter(n9, 1, f32(7));
        d.attrMeter(n9, 2, f32(10));
        d.close();
        let n10 = d.open(5, this.tag_meter, SCOPE_Screen);
        d.clsId(n10, this.cls_gauge);
        d.attrValue(n10, f32(1));
        d.attrMin(n10, f32(0));
        d.attrMax(n10, f32(10));
        d.attrMeter(n10, 0, f32(3));
        d.attrMeter(n10, 1, f32(7));
        d.attrMeter(n10, 2, f32(10));
        d.close();
        let n11 = d.open(6, this.tag_details, SCOPE_Screen);
        d.clsId(n11, this.cls_box);
        if d.userToggled(n11) {
            this.open = d.isOpen(n11);
        }
        d.attrOpen(n11, this.open);
        let n12 = d.open(0, this.tag_summary, SCOPE_Screen);
        d.attrTabIndex(n12);
        d.text("Open section");
        d.close();
        let n13 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n13, this.cls_body);
        d.text("Visible body");
        d.close();
        d.close();
        let n14 = d.open(7, this.tag_details, SCOPE_Screen);
        d.clsId(n14, this.cls_box);
        let n15 = d.open(0, this.tag_summary, SCOPE_Screen);
        d.attrTabIndex(n15);
        d.text("Closed section");
        d.close();
        let n16 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n16, this.cls_body);
        d.text("Hidden body");
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
