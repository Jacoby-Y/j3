// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    tag_input: int;
    tag_button: int;
    cls_box: int;
    cls_composer: int;
    cls_complete: int;
    cls_opt: int;
    cls_meta: int;
    cnt1: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_input: 0,
            tag_button: 0,
            cls_box: 0,
            cls_composer: 0,
            cls_complete: 0,
            cls_opt: 0,
            cls_meta: 0,
            cnt1: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_input = d.tag("input");
        this.tag_button = d.tag("button");
        this.cls_box = d.css.intern("box");
        this.cls_composer = d.css.intern("composer");
        this.cls_complete = d.css.intern("complete");
        this.cls_opt = d.css.intern("opt");
        this.cls_meta = d.css.intern("meta");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 714721756, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_box);
        let n2 = d.open(0, this.tag_p, SCOPE_Screen);
        d.text("Chat");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_composer);
        let n4 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n4, "textarea");
        d.attrRich(n4, true);
        d.attrRows(n4, f32(4));
        d.attrPlaceholder(n4, "Message");
        if d.changed(n4) {
            state.text = d.strValue(n4);
        }
        d.attrText(n4, state.text);
        d.attrTriggers(n4, "@");
        if d.triggered(n4) {
            let trigger_n4_trigger = d.triggerText(n4);
            let tlo_n4_trigger = d.trigLo;
            let thi_n4_trigger = d.trigHi;
            state.open = trigger_n4_trigger.len > 0; state.q = trigger_n4_trigger; state.tlo = tlo_n4_trigger; state.thi = thi_n4_trigger;
        }
        if d.changed(n4) {
            state.spans = d.spansValue(n4);
        }
        d.attrSpans(n4, state.spans);
        d.close();
        if state.open {
            let n5 = d.open(1, this.tag_div, SCOPE_Screen);
            d.attrCaret(n5);
            d.clsId(n5, this.cls_complete);
            if d.closeRequested(n5) {
                state.open = false;
            }
            let s6 = d.enter(0);
            let m6 = state.names.len;
            this.cnt1 = m6;
            for i in 0..m6 {
                if matches(state.names[i], state.q) {
                    let n7 = d.open(i * 1 + 0, this.tag_button, SCOPE_Screen);
                    d.clsId(n7, this.cls_opt);
                    if d.clicked(n7) {
                        d.insertToken(d.trigNode, state.tlo, state.thi, state.names[i], SPAN_MENTION, state.names[i]); state.open = false;
                    }
                    d.text(`{state.names[i]}`);
                    d.close();
                }
            }
            d.leave(s6);
            d.close();
        }
        d.close();
        let n8 = d.open(2, this.tag_p, SCOPE_Screen);
        d.clsId(n8, this.cls_meta);
        d.text(Text.scratch().add(`{state.text.len}`).add(" bytes, ").add(`{state.spans.len}`).add(" spans").str());
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                let s6 = d.enter(0);
                                let m6 = this.cnt1;
                                for i in 0..m6 {
                                    let n7 = d.paintNext(i * 1 + 0);
                                    if n7 >= 0 {
                                        d.paintBox(n7);
                                        let pass7 = 0;
                                        while d.paintChildren(pass7) {
                                            pass7 += 1;
                                        }
                                        d.paintEnd(n7);
                                    }
                                }
                                d.leave(s6);
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n8 = d.paintNext(2);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

