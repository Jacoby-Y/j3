// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 8px; background: #181c28; }\n    /* inventory: as many 48px+ slots as fit, sharing the width; the count changes with the window */\n    .inv { display: grid; grid-template-columns: repeat(auto-fill, minmax(48px, 1fr)); grid-auto-rows: 36px; gap: 4px; }\n    .slot { border-radius: 4px; }\n    .a { background: #4060a0; } .b { background: #40a060; } .c { background: #a06040; } .d { background: #a04080; }\n    /* dashboard: header across, a sidebar two rows tall, spans and explicit lines */\n    .dash { display: grid; grid-template-columns: 56px 1fr 1fr; grid-template-rows: 20px minmax(28px, auto) 24px 18px; gap: 4px; margin-top: 10px; }\n    .head { grid-column: 1 / -1; background: #6080c0; }\n    .side { grid-row: 2 / span 2; background: #c08060; }\n    .main { grid-column: 2 / span 2; height: 40px; background: #60c080; }\n    .tile { background: #c0a060; }\n    .t2 { background: #8060c0; }\n    .foot { grid-column: 1 / span 3; grid-row: 4; background: #909090; }";
const LINE0_Screen: int = 18;

