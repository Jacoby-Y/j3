// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { position: relative; width: 380px; height: 280px; background: #f2f2f6; color: #ffffff; font-size: 13px; --accent: #d03080; }\n    .box { position: absolute; left: 20px; top: 20px; width: 110px; height: 50px; padding: 6px; background: #2060d0; animation: spin 2s linear infinite, pulse 600ms ease-in-out infinite alternate; }\n    .d { left: 150px; --accent: #20b080; animation: pulse 600ms linear 2 alternate forwards; }\n    .track { position: absolute; left: 20px; top: 110px; width: 340px; height: 30px; background: #d8d8e0; }\n    .bar { position: absolute; top: 0; left: 0; width: 20%; height: 30px; padding: 6px; background: #8060c0; animation: slide 1s linear infinite alternate; }\n    .cyc { position: absolute; top: 170px; width: 80px; padding: 6px; background: #f0a030; animation-name: fade, grow, fade; animation-duration: 400ms, 800ms; animation-timing-function: linear; animation-iteration-count: infinite; animation-direction: alternate; }\n    .b { left: 20px; }\n    .c { left: 190px; }\n    .pct { position: absolute; left: 20px; top: 230px; width: 120px; padding: 6px; background: #20a0c0; animation: shove 800ms linear infinite alternate; }\n    .finished .box, .finished .bar, .finished .cyc, .finished .pct { animation-iteration-count: 1; animation-fill-mode: forwards; animation-direction: normal; animation-duration: 80ms, 80ms; }\n    .finished .d { animation-iteration-count: 1; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes pulse { to { background: var(--accent); } }\n    @keyframes slide { from { left: 0px; width: 20%; } to { left: 80%; width: 40%; } }\n    @keyframes fade { to { opacity: 0.35; } }\n    @keyframes grow { to { width: 130px; } }\n    @keyframes shove { from { translate: 0px 0px; } to { translate: 100% 0px; } }";
const LINE0_Screen: int = 12;

pub struct ScreenProps {
    finished: bool;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_finished: int;
    cls_box: int;
    cls_a: int;
    cls_track: int;
    cls_bar: int;
    cls_cyc: int;
    cls_b: int;
    cls_c: int;
    cls_d: int;
    cls_pct: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_finished: 0,
            cls_box: 0,
            cls_a: 0,
            cls_track: 0,
            cls_bar: 0,
            cls_cyc: 0,
            cls_b: 0,
            cls_c: 0,
            cls_d: 0,
            cls_pct: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_finished = d.css.intern("finished");
        this.cls_box = d.css.intern("box");
        this.cls_a = d.css.intern("a");
        this.cls_track = d.css.intern("track");
        this.cls_bar = d.css.intern("bar");
        this.cls_cyc = d.css.intern("cyc");
        this.cls_b = d.css.intern("b");
        this.cls_c = d.css.intern("c");
        this.cls_d = d.css.intern("d");
        this.cls_pct = d.css.intern("pct");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 381204531, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let finished = p.finished;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsIfId(n1, this.cls_finished, finished);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_box);
        d.clsId(n2, this.cls_a);
        d.text("spin + pulse");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_track);
        let n4 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_bar);
        d.text("slide");
        d.close();
        d.close();
        let n5 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_cyc);
        d.clsId(n5, this.cls_b);
        d.text("name list");
        d.close();
        let n6 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_cyc);
        d.clsId(n6, this.cls_c);
        d.text("cycles");
        d.close();
        let n7 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_box);
        d.clsId(n7, this.cls_d);
        d.text("two accents");
        d.close();
        let n8 = d.open(5, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_pct);
        d.text("translate %");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n5 = d.paintNext(2);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n6 = d.paintNext(3);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n7 = d.paintNext(4);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n8 = d.paintNext(5);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

