// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 360px; padding: 10px; color: #ffffff; font-size: 12px; display: flex; flex-wrap: wrap; gap: 8px 10px; }\n    .cell { width: 110px; height: 100px; }\n    .cap { margin: 0 0 14px 0; }\n    .box { width: 90px; height: 56px; background: #204878; scrollbar-width: none; margin-left: 8px; }\n    .inner { width: 70px; height: 40px; background: #285a30; margin: 8px; }\n    .kid { width: 130px; height: 90px; box-sizing: border-box; border: 3px solid #ffd040; background: #603020; padding: 6px; }\n    .h { overflow: hidden; }\n    .xc { overflow-x: clip; overflow-y: visible; }\n    .r20 { transform: rotate(20deg); }\n    .r20s { transform: rotate(20deg) scale(0.8); }\n    .sk { transform: skewX(20deg); }\n    .r8 { transform: rotate(4deg); }\n    .n { height: 50px; margin: 1px; }\n    .r-30 { transform: rotate(-30deg); }";
const LINE0_Screen: int = 13;

