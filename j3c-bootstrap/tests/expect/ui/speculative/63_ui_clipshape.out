    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_cell: 0,
            cls_cap: 0,
            cls_box: 0,
            cls_h: 0,
            cls_r20: 0,
            cls_kid: 0,
