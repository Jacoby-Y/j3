// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 320px; padding: 10px; color: #ffffff; font-size: 16px; }\n    .list { width: 200px; background: #202040; }\n    .row { height: 28px; padding-left: 8px; background: #3050a0; }\n    .row + .row { border-top: 3px solid #ffd040; }\n    .row.on { background: #20a050; }\n    .row.on ~ .row { background: #a03030; }\n    .card { position: relative; margin-top: 20px; width: 200px; height: 80px; background: #404040; }\n    .card::before { content: \"TITLE\"; display: block; height: 22px; padding-left: 6px; background: #606080; }\n    .card::after { content: \"*\"; position: absolute; right: 0; top: 0; width: 18px; height: 18px; background: #ff8000; }\n    .card.alt::before { content: \"CHANGED\"; background: #806060; }\n    .body { padding-left: 6px; }\n    #hero { margin-top: 20px; width: 150px; background: #808000; }\n    .vl { position: absolute; left: 220px; top: 10px; width: 90px; height: 100px; overflow-y: auto; background: #303030; }\n    .vrow { height: 20px; }\n    .vrow + .vrow { background: #383838; }\n    .vl::before { content: \"top\"; display: block; height: 20px; background: #206060; }\n    .vl::after { content: \"end\"; display: block; height: 20px; background: #206060; }";
const LINE0_Screen: int = 19;

pub struct ScreenProps {
    later: bool;
    rows: []int;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

struct Screen_R2 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        let a = mem.alloc::<Screen_R2>(1);
        a[0] = Screen_R2 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R2, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R2>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R2.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R2) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_list: int;
    cls_row: int;
    cls_on: int;
    cls_card: int;
    cls_alt: int;
    cls_body: int;
    cls_vl: int;
    cls_vrow: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;
    cnt2: int;
    e2: List<&Screen_R2>;
    fp2: List<&Screen_R2>;
    eb2: List<&Screen_R2>;
    kd2: Keyed;
    vl2: VList;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_list: 0,
            cls_row: 0,
            cls_on: 0,
            cls_card: 0,
            cls_alt: 0,
            cls_body: 0,
            cls_vl: 0,
            cls_vrow: 0,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
            cnt2: 0,
            e2: List<&Screen_R2>.new(mem),
            fp2: List<&Screen_R2>.new(mem),
            eb2: List<&Screen_R2>.new(mem),
            kd2: Keyed.new(mem),
            vl2: VList.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
        this.cnt2 = 0;
        for q2 in 0..this.e2.len {
            this.fp2.push(this.e2.items[q2]);
        }
        this.e2.len = 0;
        this.eb2.len = 0;
        this.kd2.reset();
        this.vl2.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_list = d.css.intern("list");
        this.cls_row = d.css.intern("row");
        this.cls_on = d.css.intern("on");
        this.cls_card = d.css.intern("card");
        this.cls_alt = d.css.intern("alt");
        this.cls_body = d.css.intern("body");
        this.cls_vl = d.css.intern("vl");
        this.cls_vrow = d.css.intern("vrow");
    }

    fn name(this: &Screen, i: int): string {
 return if i == 0 { "A" } else if i == 1 { "B" } else if i == 2 { "C" } else { "D" }; 
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 685787473, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let later = p.later;
        let rows = p.rows;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_list);
        let s3 = d.enter(0);
        let m3 = (if later { 4 } else { 3 });
        this.cnt1 = m3;
        this.kd1.begin();
        for kv3 in 0..m3 {
            this.kd1.add(`{this.name(kv3)}`);
        }
        this.kd1.finish("ui/Screen.j3ui:7");
        if this.kd1.changed {
            for dq3 in 0..this.kd1.dead.len { let dr3 = this.e1.items[this.kd1.dead.items[dq3]]; dr3.destroy(); this.fp1.push(dr3); }
            this.eb1.len = 0;
            for rq3 in 0..m3 {
                let f3 = this.kd1.from.items[rq3];
                if f3 >= 0 { this.eb1.push(this.e1.items[f3]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t3 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t3;
        }
        for i in 0..m3 {
            let r1 = this.e1.items[i];
            d.keyBegin(r1.uid);
            let n4 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n4, this.cls_row);
            d.clsIfId(n4, this.cls_on, later && i == 1);
            d.text(`{this.name(i)}`);
            d.close();
            d.keyEnd();
        }
        d.leave(s3);
        d.close();
        let n5 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_card);
        d.clsIfId(n5, this.cls_alt, later);
        let n6 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_body);
        d.text("card body");
        d.close();
        d.close();
        let n7 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_vl);
        let s8 = d.enter(0);
        let x8 = rows;
        this.vl2.cfg(f32(20), f32(40.0), false, false);
        if this.vl2.stale(x8.len) {
            let ap8 = this.vl2.grew(x8.len);
            if ap8 {
                this.vl2.pk.begin();
                let kr8a = x8[0];
                this.vl2.pk.addInt(kr8a);
                let kr8b = x8[this.vl2.n - 1];
                this.vl2.pk.addInt(kr8b);
                ap8 = this.vl2.probeOk();
            }
            if ap8 {
                for kq8 in this.vl2.n..x8.len {
                    let kr8c = x8[kq8];
                    this.vl2.all.pushInt(kr8c);
                }
                this.vl2.appended(x8.len);
            } else {
                this.vl2.all.begin();
                for kq8 in 0..x8.len {
                    let kr8d = x8[kq8];
                    this.vl2.all.addInt(kr8d);
                }
                this.vl2.all.finish("ui/Screen.j3ui:13");
                this.vl2.rebuilt(x8.len);
            }
        }
        let w8 = vlist.step(d, n7, &this.vl2, x8.len);
        let m8 = this.vl2.cnt;
        this.cnt2 = m8;
        this.kd2.begin();
        for kv8 in 0..m8 {
            let kj8 = this.vl2.at(kv8);
            let ki8 = x8[kj8];
            this.kd2.addInt(ki8);
        }
        this.kd2.finish("ui/Screen.j3ui:13");
        this.vl2.verify(&this.kd2);
        if this.kd2.changed {
            for dq8 in 0..this.kd2.dead.len { let dr8 = this.e2.items[this.kd2.dead.items[dq8]]; dr8.destroy(); this.fp2.push(dr8); }
            this.eb2.len = 0;
            for rq8 in 0..m8 {
                let f8 = this.kd2.from.items[rq8];
                if f8 >= 0 { this.eb2.push(this.e2.items[f8]); } else { this.eb2.push(Screen_R2.take(&this.fp2, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t8 = this.e2;
            this.e2 = this.eb2;
            this.eb2 = t8;
        }
        for i8 in 0..m8 {
            let ax8 = this.vl2.at(i8); let r = x8[ax8];
            let r2 = this.e2.items[i8];
            d.keyBegin(r2.uid);
            let n9 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n9, this.cls_vrow);
            d.text(`{r}`);
            d.close();
            d.keyEnd();
        }
        vlist.finish(d, n7, &this.vl2);
        d.leave(s8);
        d.close();
        let n10 = d.open(3, this.tag_div, SCOPE_Screen);
        d.attrId(n10, "hero");
        d.clsId(n10, this.cls_row);
        d.text("hero");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        for q2 in 0..this.e2.len {
            this.e2.items[q2].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let s3 = d.enter(0);
                        let m3 = this.cnt1;
                        for i in 0..m3 {
                            let r1 = this.e1.items[i];
                            d.paintGroup(r1.uid);
                            let n4 = d.paintNext(0);
                            if n4 >= 0 {
                                d.paintBox(n4);
                                let pass4 = 0;
                                while d.paintChildren(pass4) {
                                    pass4 += 1;
                                }
                                d.paintEnd(n4);
                            }
                            d.paintGroupEnd();
                        }
                        d.leave(s3);
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n5 = d.paintNext(1);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        let n6 = d.paintNext(0);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n7 = d.paintNext(2);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        let s8 = d.enter(0);
                        let m8 = this.cnt2;
                        for i8 in 0..m8 {
                            let r2 = this.e2.items[i8];
                            d.paintGroup(r2.uid);
                            let n9 = d.paintNext(0);
                            if n9 >= 0 {
                                d.paintBox(n9);
                                let pass9 = 0;
                                while d.paintChildren(pass9) {
                                    pass9 += 1;
                                }
                                d.paintEnd(n9);
                            }
                            d.paintGroupEnd();
                        }
                        d.leave(s8);
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n10 = d.paintNext(3);
                if n10 >= 0 {
                    d.paintBox(n10);
                    let pass10 = 0;
                    while d.paintChildren(pass10) {
                        pass10 += 1;
                    }
                    d.paintEnd(n10);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

