// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; color: #202030; font-size: 14px; }\n    .row { display: block; margin-bottom: 8px; }\n    .cb { display: block; width: 16px; height: 16px; margin-bottom: 8px; }";
const LINE0_Screen: int = 15;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    a: bool;
    b: bool;
    c: bool;
    n: int;
    tag_div: int;
    tag_label: int;
    tag_input: int;
    tag_p: int;
    cls_screen: int;
    cls_page: int;
    cls_row: int;
    cls_cb: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            a: false,
            b: false,
            c: false,
            n: 0,
            tag_div: 0,
            tag_label: 0,
            tag_input: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_row: 0,
            cls_cb: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.a = false;
        this.b = false;
        this.c = false;
        this.n = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_label = d.tag("label");
        this.tag_input = d.tag("input");
        this.tag_p = d.tag("p");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_row = d.css.intern("row");
        this.cls_cb = d.css.intern("cb");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 536081719, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_label, SCOPE_Screen);
        d.clsId(n2, this.cls_row);
        let n3 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n3, "checkbox");
        if d.clicked(n3) {
            this.a = !this.a;
        }
        d.attrChecked(n3, this.a);
        d.close();
        d.text("Wrapped label");
        d.close();
        let n4 = d.open(1, this.tag_label, SCOPE_Screen);
        d.clsId(n4, this.cls_row);
        d.attrFor(n4, "two");
        d.text("Label for id");
        d.close();
        let n5 = d.open(2, this.tag_input, SCOPE_Screen);
        d.attrId(n5, "two");
        d.clsId(n5, this.cls_cb);
        d.attrType(n5, "checkbox");
        if d.clicked(n5) {
            this.b = !this.b;
        }
        d.attrChecked(n5, this.b);
        d.close();
        let n6 = d.open(3, this.tag_label, SCOPE_Screen);
        d.clsId(n6, this.cls_row);
        let n7 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n7, "checkbox");
        if d.clicked(n7) {
            this.c = !this.c;
        }
        d.attrChecked(n7, this.c);
        d.close();
        d.text("Third option");
        d.close();
        let n8 = d.open(4, this.tag_p, SCOPE_Screen);
        d.clsId(n8, this.cls_row);
        d.text(Text.scratch().add("a=").add(`{this.a}`).add(" b=").add(`{this.b}`).add(" c=").add(`{this.c}`).str());
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n4 = d.paintNext(1);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n5 = d.paintNext(2);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n6 = d.paintNext(3);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        let n7 = d.paintNext(0);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n8 = d.paintNext(4);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

