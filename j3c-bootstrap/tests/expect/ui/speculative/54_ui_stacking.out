    cls_top: int;
    cls_mid: int;
    cls_iso: int;
    cls_turn: int;
    cls_gray: int;
    cls_clip: int;
    cls_fixed: int;
    cls_pink: int;
    cls_row: int;
    cls_it: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_cell: 0,
            cls_demo: 0,
            cls_box: 0,
            cls_c1: 0,
            cls_red: 0,
            cls_inn: 0,
            cls_blue: 0,
            cls_c2: 0,
            cls_green: 0,
            cls_lbl: 0,
            cls_neg_par: 0,
            cls_yellow: 0,
            cls_neg: 0,
            cls_flow: 0,
            cls_fade: 0,
            cls_top: 0,
            cls_mid: 0,
            cls_iso: 0,
            cls_turn: 0,
            cls_gray: 0,
            cls_clip: 0,
            cls_fixed: 0,
            cls_pink: 0,
            cls_row: 0,
            cls_it: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_cell = d.css.intern("cell");
        this.cls_demo = d.css.intern("demo");
        this.cls_box = d.css.intern("box");
        this.cls_c1 = d.css.intern("c1");
        this.cls_red = d.css.intern("red");
        this.cls_inn = d.css.intern("inn");
        this.cls_blue = d.css.intern("blue");
        this.cls_c2 = d.css.intern("c2");
        this.cls_green = d.css.intern("green");
        this.cls_lbl = d.css.intern("lbl");
        this.cls_neg_par = d.css.intern("neg-par");
        this.cls_yellow = d.css.intern("yellow");
        this.cls_neg = d.css.intern("neg");
        this.cls_flow = d.css.intern("flow");
        this.cls_fade = d.css.intern("fade");
        this.cls_top = d.css.intern("top");
        this.cls_mid = d.css.intern("mid");
        this.cls_iso = d.css.intern("iso");
        this.cls_turn = d.css.intern("turn");
        this.cls_gray = d.css.intern("gray");
        this.cls_clip = d.css.intern("clip");
        this.cls_fixed = d.css.intern("fixed");
        this.cls_pink = d.css.intern("pink");
        this.cls_row = d.css.intern("row");
        this.cls_it = d.css.intern("it");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 928201883, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

