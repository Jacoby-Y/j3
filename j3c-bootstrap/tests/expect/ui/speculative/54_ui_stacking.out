// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; flex-wrap: wrap; width: 100%; height: 100%; padding: 10px; gap: 10px; }\n    .cell { position: relative; width: 140px; height: 135px; }\n    .demo { position: relative; z-index: 0; width: 140px; height: 110px; background: #e0e0ea; }\n    .lbl { font-size: 10px; margin-top: 3px; }\n    .box { position: absolute; }\n    .red { background: #d04060; } .green { background: #40a060; } .blue { background: #3070c0; } .yellow { background: #e0c040; } .pink { background: #e060c0; }\n    .c1 { left: 5px; top: 5px; width: 80px; height: 80px; z-index: 1; }\n    .inn { left: 40px; top: 40px; width: 80px; height: 60px; z-index: 9999; }\n    .c2 { left: 55px; top: 15px; width: 70px; height: 60px; z-index: 2; }\n    .c1:hover, .c2:hover, .inn:hover { outline: 3px solid #101018; }\n    .neg-par { left: 10px; top: 10px; width: 120px; height: 90px; z-index: 0; }\n    .neg { left: 20px; top: 20px; width: 60px; height: 50px; z-index: -1; }\n    .flow { margin: 40px 0 0 40px; width: 50px; height: 40px; }\n    .fade { left: 5px; top: 5px; width: 90px; height: 90px; opacity: 0.7; background: #ffffff; }\n    .iso { left: 5px; top: 5px; width: 90px; height: 90px; isolation: isolate; background: #ffffff; }\n    .turn { left: 15px; top: 5px; width: 90px; height: 90px; transform: rotate(8deg); background: #ffffff; }\n    .top { left: 10px; top: 10px; width: 60px; height: 60px; z-index: 5; }\n    .mid { left: 55px; top: 40px; width: 70px; height: 60px; z-index: 3; }\n    .gray { left: 10px; top: 10px; width: 120px; height: 90px; background: #e0a040; filter: grayscale(1); }\n    .gray .top { left: 30px; top: 20px; width: 60px; height: 50px; z-index: 2; }\n    .clip { left: 10px; top: 10px; width: 60px; height: 50px; overflow: hidden; background: #b0b0c0; }\n    .fixed { position: fixed; left: 345px; top: 238px; width: 70px; height: 30px; }\n    .row { position: absolute; left: 10px; top: 20px; display: flex; width: 130px; height: 60px; }\n    .it { width: 60px; height: 60px; margin-right: -35px; }";
const LINE0_Screen: int = 38;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
