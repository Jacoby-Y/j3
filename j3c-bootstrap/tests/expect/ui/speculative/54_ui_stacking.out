    tag_p: int;
    cls_screen: int;
    cls_page: int;
    cls_cell: int;
    cls_demo: int;
    cls_box: int;
    cls_c1: int;
    cls_red: int;
    cls_inn: int;
    cls_blue: int;
    cls_c2: int;
    cls_green: int;
    cls_lbl: int;
