                if n12 >= 0 {
                    d.paintBox(n12);
                    let pass12 = 0;
                    while d.paintChildren(pass12) {
                        let s13 = d.enter(0);
                        let m13 = this.cnt2;
                        for i13 in 0..m13 {
                            let r2 = this.e2.items[i13];
                            d.paintGroup(r2.uid);
                            let n14 = d.paintNext(0);
                            if n14 >= 0 {
                                d.paintBox(n14);
                                let pass14 = 0;
                                while d.paintChildren(pass14) {
                                    pass14 += 1;
                                }
                                d.paintEnd(n14);
                            }
                            d.paintGroupEnd();
                        }
                        d.leave(s13);
                        pass12 += 1;
                    }
                    d.paintEnd(n12);
                }
                let n16 = d.paintNext(4);
                if n16 >= 0 {
                    d.paintBox(n16);
                    let pass16 = 0;
                    while d.paintChildren(pass16) {
                        pass16 += 1;
                    }
                    d.paintEnd(n16);
                }
                let n18 = d.paintNext(5);
                if n18 >= 0 {
                    d.paintBox(n18);
                    let pass18 = 0;
                    while d.paintChildren(pass18) {
                        pass18 += 1;
                    }
                    d.paintEnd(n18);
                }
                let n19 = d.paintNext(6);
                if n19 >= 0 {
                    d.paintBox(n19);
                    let pass19 = 0;
                    while d.paintChildren(pass19) {
                        pass19 += 1;
                    }
                    d.paintEnd(n19);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

