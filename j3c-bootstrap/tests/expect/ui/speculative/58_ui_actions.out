// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .page { gap: 6px; padding: 8px; }\n    .panel { width: 120px; height: 28px; padding: 4px; background: #313244; }\n    .chip { padding: 2px 8px; background: #45475a; border-radius: 4px; }\n    p { font-size: 13px; }";
const LINE0_Screen: int = 84;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

#[singleton]
let Screen_NAMES: [4]string;

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    bh11: int;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            bh11: -1,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.bh11 = -1;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

struct Screen_R2 {
    uid: int;
    comp: int;
    dom: &Dom;
    ua15: int;
    us15: int;
    up15: int;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        let a = mem.alloc::<Screen_R2>(1);
        a[0] = Screen_R2 {
            uid: uid,
            comp: comp,
            dom: d,
            ua15: -1,
            us15: 0,
            up15: 0,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R2, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.ua15 = -1;
        this.us15 = 0;
    }

    fn take(pool: &List<&Screen_R2>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R2.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R2) {
        if this.ua15 >= 0 && this.us15 == 1 {
            ((this.comp as ptr) as &Screen).rowact_destroy(this.ua15);
        }
        this.ua15 = -1;
        this.us15 = 0;
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    input: int;
    panel: int;
    stale: int;
    rows: [3]int;
    tick: int;
    show: bool;
    param: int;
    w: int;
    h: int;
    mounts: int;
    updates: int;
    destroys: int;
    focused: bool;
    rejected: bool;
    distinct: bool;
    good: bool;
    gone: bool;
    spin: int;
    lupd: int;
    ids: [4]int;
    cnt: int;
    bump: int;
    rm: int;
    ru: int;
    rd: int;
    tag_div: int;
    tag_input: int;
    tag_span: int;
    tag_p: int;
    cls_page: int;
    cls_panel: int;
    cls_row: int;
    cls_chip: int;
    if1: int;
    ua7: int;
    us7: int;
    up7: int;
    ua17: int;
    us17: int;
    up17: []u8;
    ul17: int;
    bh3: int;
    bh6: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    cnt2: int;
    e2: List<&Screen_R2>;
    fp2: List<&Screen_R2>;
    eb2: List<&Screen_R2>;
    kd2: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            input: -1,
            panel: -1,
            stale: -1,
            rows: [-1, -1, -1],
            tick: 0,
            show: true,
            param: 1,
            w: 0,
            h: 0,
            mounts: 0,
            updates: 0,
            destroys: 0,
            focused: false,
            rejected: false,
            distinct: false,
            good: false,
            gone: false,
            spin: 0,
            lupd: 0,
            ids: [1, 2, 3, 4],
            cnt: 4,
            bump: 0,
            rm: 0,
            ru: 0,
            rd: 0,
            tag_div: 0,
            tag_input: 0,
            tag_span: 0,
            tag_p: 0,
            cls_page: 0,
            cls_panel: 0,
            cls_row: 0,
            cls_chip: 0,
            if1: -1,
            ua7: -1,
            us7: 0,
            up7: 0,
            ua17: -1,
            us17: 0,
            up17: mem.alloc::<u8>(0),
            ul17: 0,
            bh3: -1,
            bh6: -1,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            cnt2: 0,
            e2: List<&Screen_R2>.new(mem),
            fp2: List<&Screen_R2>.new(mem),
            eb2: List<&Screen_R2>.new(mem),
            kd2: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.input = -1;
        this.panel = -1;
        this.stale = -1;
        this.rows = [-1, -1, -1];
        this.tick = 0;
        this.show = true;
        this.param = 1;
        this.w = 0;
        this.h = 0;
        this.mounts = 0;
        this.updates = 0;
        this.destroys = 0;
        this.focused = false;
        this.rejected = false;
        this.distinct = false;
        this.good = false;
        this.gone = false;
        this.spin = 0;
        this.lupd = 0;
        this.ids = [1, 2, 3, 4];
        this.cnt = 4;
        this.bump = 0;
        this.rm = 0;
        this.ru = 0;
        this.rd = 0;
        this.if1 = -1;
        this.ua7 = -1;
        this.us7 = 0;
        this.ua17 = -1;
        this.us17 = 0;
        this.ul17 = 0;
        this.bh3 = -1;
        this.bh6 = -1;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.cnt2 = 0;
        for q2 in 0..this.e2.len {
            this.fp2.push(this.e2.items[q2]);
        }
        this.e2.len = 0;
        this.eb2.len = 0;
        this.kd2.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Screen_NAMES = ["a", "bcd", "efghijkl", "m"];
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_input = d.tag("input");
        this.tag_span = d.tag("span");
        this.tag_p = d.tag("p");
        this.cls_page = d.css.intern("page");
        this.cls_panel = d.css.intern("panel");
        this.cls_row = d.css.intern("row");
        this.cls_chip = d.css.intern("chip");
    }

    fn lab(this: &Screen, node: int, s: string) {
 
    }

    fn lab_update(this: &Screen, node: int, s: string) {
 this.lupd += 1; 
    }

    fn rowact(this: &Screen, node: int, v: int) {
 this.rm += 1; 
    }

    fn rowact_update(this: &Screen, node: int, v: int) {
 this.ru += 1; 
    }

    fn rowact_destroy(this: &Screen, node: int) {
 this.rd += 1; 
    }

    fn measure(this: &Screen, node: int, v: int) {
        let d = (this.dm as ptr) as &Dom;

        let s = d.size(node);
        this.w = s.x as int;
        this.h = s.y as int;
        this.mounts += 1;
    
    }

    fn measure_update(this: &Screen, node: int, v: int) {
 this.updates += 1; 
    }

    fn measure_destroy(this: &Screen, node: int) {
 this.destroys += 1; 
    }

    fn onMount(this: &Screen) {
        let d = (this.dm as ptr) as &Dom;

        d.focusNode(this.input);
        this.focused = d.alive(this.input);
    
    }

    fn onFrame(this: &Screen, dt: f32) {
        let d = (this.dm as ptr) as &Dom;

        if this.tick < 50 { this.tick += 1; }
        this.spin += 1;
        if this.tick == 12 { let t = this.ids[0]; this.ids[0] = this.ids[2]; this.ids[2] = t; }
        if this.tick == 14 { this.ids[0] = 3; this.ids[1] = 1; this.ids[2] = 4; this.cnt = 3; }
        if this.tick == 16 { this.bump = 100; }
        if this.tick == 10 { this.param = 2; }
        if this.tick == 19 { this.stale = this.panel; }
        if this.tick == 20 { this.show = false; }
        if this.tick == 25 { this.gone = this.panel == -1; }
        if this.tick == 30 { this.show = true; }
        if this.tick == 35 {
            d.focusNode(this.stale);
            this.rejected = !d.alive(this.stale) && d.alive(this.panel) && this.stale != this.panel && d.node(this.stale) == -1;
            this.distinct = this.rows[0] != this.rows[1] && this.rows[1] != this.rows[2] && d.alive(this.rows[2]);
            this.good = this.gone && this.focused && this.rejected && this.distinct && this.mounts == 2 && this.updates == 1 && this.destroys == 1 && this.rm == 4 && this.ru == 1 && this.rd == 1 && this.lupd > 20 && this.w > 0 && this.h > 0;
        }
    
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 973846793, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        this.onFrame(d.dt());
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_input, SCOPE_Screen);
        d.attrType(n2, "text");
        d.attrPlaceholder(n2, "focused by bind:this");
        this.input = d.handle(n2);
        this.bh3 = d.handle(n2);
        d.close();
        let b4 = -1;
        if this.show {
            b4 = 0;
        }
        if b4 != this.if1 {
            this.if1 = b4;
        }
        if b4 == 0 {
            let n5 = d.open(1, this.tag_div, SCOPE_Screen);
            d.clsId(n5, this.cls_panel);
            this.panel = d.handle(n5);
            this.bh6 = d.handle(n5);
            let uh7 = d.handle(n5);
            let pv7: int = this.param;
            if this.ua7 != uh7 { if this.us7 == 1 { this.measure_destroy(this.ua7); } this.ua7 = uh7; this.us7 = 0; }
            else if this.us7 == 0 { this.us7 = 1; this.up7 = pv7; this.measure(uh7, pv7); }
            else if this.up7 != pv7 { this.up7 = pv7; this.measure_update(uh7, pv7); }
            d.text("panel");
            d.close();
        }
        let n8 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_row);
        let s9 = d.enter(0);
        let m9 = 3;
        this.cnt1 = m9;
        while this.e1.len < m9 { this.e1.push(Screen_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m9 {
            for zq9 in m9..this.e1.len { this.e1.items[zq9].destroy(); this.fp1.push(this.e1.items[zq9]); }
            this.e1.len = m9;
        }
        for i in 0..m9 {
            let r1 = this.e1.items[i];
            let n10 = d.open(i * 1 + 0, this.tag_span, SCOPE_Screen);
            d.clsId(n10, this.cls_chip);
            this.rows[i] = d.handle(n10);
            r1.bh11 = d.handle(n10);
            d.text(Text.scratch().add("r").add(`{i}`).str());
            d.close();
            if r1.bh11 >= 0 && !d.alive(r1.bh11) { if this.rows[i] == r1.bh11 { this.rows[i] = -1; } r1.bh11 = -1; }
        }
        d.leave(s9);
        d.close();
        let n12 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n12, this.cls_row);
        let s13 = d.enter(0);
        let x13 = this.ids[0..this.cnt];
        let m13 = x13.len;
        this.cnt2 = m13;
        this.kd2.begin();
        for kv13 in 0..m13 {
            let ki13 = x13[kv13];
            this.kd2.add(`{ki13}`);
        }
        this.kd2.finish("ui/Screen.j3ui:76");
        if this.kd2.changed {
            for dq13 in 0..this.kd2.dead.len { let dr13 = this.e2.items[this.kd2.dead.items[dq13]]; dr13.destroy(); this.fp2.push(dr13); }
            this.eb2.len = 0;
            for rq13 in 0..m13 {
                let f13 = this.kd2.from.items[rq13];
                if f13 >= 0 { this.eb2.push(this.e2.items[f13]); } else { this.eb2.push(Screen_R2.take(&this.fp2, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t13 = this.e2;
            this.e2 = this.eb2;
            this.eb2 = t13;
        }
        for i13 in 0..m13 {
            let id = x13[i13];
            let r2 = this.e2.items[i13];
            d.keyBegin(r2.uid);
            let n14 = d.open(0, this.tag_span, SCOPE_Screen);
            d.clsId(n14, this.cls_chip);
            let uh15 = d.handle(n14);
            let pv15: int = id + (if id == 3 { this.bump } else { 0 });
            if r2.ua15 != uh15 { if r2.us15 == 1 { this.rowact_destroy(r2.ua15); } r2.ua15 = uh15; r2.us15 = 0; }
            else if r2.us15 == 0 { r2.us15 = 1; r2.up15 = pv15; this.rowact(uh15, pv15); }
            else if r2.up15 != pv15 { r2.up15 = pv15; this.rowact_update(uh15, pv15); }
            d.text(Text.scratch().add("k").add(`{id}`).str());
            d.close();
            if r2.ua15 >= 0 && !d.alive(r2.ua15) { if r2.us15 == 1 { this.rowact_destroy(r2.ua15); } r2.ua15 = -1; r2.us15 = 0; }
            d.keyEnd();
        }
        d.leave(s13);
        d.close();
        let n16 = d.open(4, this.tag_span, SCOPE_Screen);
        let uh17 = d.handle(n16);
        let pv17: string = Screen_NAMES[this.spin % 4];
        if this.ua17 != uh17 { this.ua17 = uh17; this.us17 = 0; }
        else if this.us17 == 0 { this.us17 = 1; this.up17 = d.strPut(this.up17, pv17); this.ul17 = pv17.len; this.lab(uh17, pv17); }
        else if !d.strHas(this.up17, this.ul17, pv17) { this.up17 = d.strPut(this.up17, pv17); this.ul17 = pv17.len; this.lab_update(uh17, pv17); }
        d.close();
        let n18 = d.open(5, this.tag_p, SCOPE_Screen);
        d.text(Text.scratch().add("m").add(`{this.mounts}`).add(" u").add(`{this.updates}`).add(" d").add(`{this.destroys}`).add(" size ").add(`{this.w}`).add("x").add(`{this.h}`).add(" param ").add(`{this.param}`).str());
        d.close();
        let n19 = d.open(6, this.tag_p, SCOPE_Screen);
        d.text(Text.scratch().add("focused ").add(`{this.focused}`).add(" rejected ").add(`{this.rejected}`).add(" rows ").add(`{this.distinct}`).add(" t").add(`{this.tick}`).str());
        d.close();
        d.close();
        if this.ua7 >= 0 && !d.alive(this.ua7) { if this.us7 == 1 { this.measure_destroy(this.ua7); } this.ua7 = -1; this.us7 = 0; }
        if this.ua17 >= 0 && !d.alive(this.ua17) { this.ua17 = -1; this.us17 = 0; }
        if this.bh3 >= 0 && !d.alive(this.bh3) { if this.input == this.bh3 { this.input = -1; } this.bh3 = -1; }
        if this.bh6 >= 0 && !d.alive(this.bh6) { if this.panel == this.bh6 { this.panel = -1; } this.bh6 = -1; }
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        if this.ua7 >= 0 && this.us7 == 1 {
            this.measure_destroy(this.ua7);
        }
        this.ua7 = -1;
        this.us7 = 0;
        this.ua17 = -1;
        this.us17 = 0;
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        for q2 in 0..this.e2.len {
            this.e2.items[q2].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n5 = d.paintNext(1);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n8 = d.paintNext(2);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        let s9 = d.enter(0);
                        let m9 = this.cnt1;
                        for i in 0..m9 {
                            let r1 = this.e1.items[i];
                            let n10 = d.paintNext(i * 1 + 0);
                            if n10 >= 0 {
                                d.paintBox(n10);
                                let pass10 = 0;
                                while d.paintChildren(pass10) {
                                    pass10 += 1;
                                }
                                d.paintEnd(n10);
                            }
                        }
                        d.leave(s9);
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
