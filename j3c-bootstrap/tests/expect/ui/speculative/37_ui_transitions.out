// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }\n    .title { margin-bottom: 8px; color: #a0b0d0; }\n    .grid { display: flex; flex-wrap: wrap; gap: 8px; height: 150px; }\n    .box { width: 90px; height: 60px; padding: 8px; box-sizing: border-box; border-radius: 4px; background: #3050a0; }\n    .b1 { background: #a05030; }\n    .b2 { background: #308050; }\n    .b3 { background: #806030; }\n    .b4 { background: #703080; }";
const LINE0_Screen: int = 14;

pub struct ScreenProps {
    on: bool;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_title: int;
    cls_grid: int;
    cls_box: int;
    cls_b0: int;
    cls_b1: int;
    cls_b2: int;
    cls_b3: int;
    cls_b4: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_grid: 0,
            cls_box: 0,
            cls_b0: 0,
            cls_b1: 0,
            cls_b2: 0,
            cls_b3: 0,
            cls_b4: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_grid = d.css.intern("grid");
        this.cls_box = d.css.intern("box");
        this.cls_b0 = d.css.intern("b0");
        this.cls_b1 = d.css.intern("b1");
        this.cls_b2 = d.css.intern("b2");
        this.cls_b3 = d.css.intern("b3");
        this.cls_b4 = d.css.intern("b4");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 458211032, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let on = p.on;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Transitions");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_grid);
        if on {
            let n4 = d.open(0, this.tag_div, SCOPE_Screen);
            d.trans(n4, 1, f32(200), 1, f32(200), 1, 0.0, 20.0, 0.5, 0);
            d.clsId(n4, this.cls_box);
            d.clsId(n4, this.cls_b0);
            d.text("fade");
            d.close();
        }
        if on {
            let n5 = d.open(1, this.tag_div, SCOPE_Screen);
            d.trans(n5, 2, f32(200), 2, f32(200), 1, f32(60), f32(0), 0.5, 0);
            d.clsId(n5, this.cls_box);
            d.clsId(n5, this.cls_b1);
            d.text("fly");
            d.close();
        }
        if on {
            let n6 = d.open(2, this.tag_div, SCOPE_Screen);
            d.trans(n6, 3, f32(200), 3, f32(200), 1, 0.0, 20.0, 0.5, 0);
            d.clsId(n6, this.cls_box);
            d.clsId(n6, this.cls_b2);
            d.text("slide");
            d.close();
        }
        if on {
            let n7 = d.open(3, this.tag_div, SCOPE_Screen);
            d.trans(n7, 4, f32(200), 4, f32(200), 1, 0.0, 20.0, f32(0.2), 0);
            d.clsId(n7, this.cls_box);
            d.clsId(n7, this.cls_b3);
            d.text("scale");
            d.close();
        }
        if on {
            let n8 = d.open(4, this.tag_div, SCOPE_Screen);
            d.trans(n8, 2, f32(200), 1, f32(200), 1, f32(0), f32(-30), 0.5, 0);
            d.clsId(n8, this.cls_box);
            d.clsId(n8, this.cls_b4);
            d.text("in fly out fade");
            d.close();
        }
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        let n6 = d.paintNext(2);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        let n7 = d.paintNext(3);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        let n8 = d.paintNext(4);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

