// ---- ui/Holder.j3ui
pub const SCOPE_Holder: int = 1;
const CSS_Holder: string = "";
const LINE0_Holder: int = 0;

pub struct HolderProps {
    state: &State;
}

pub struct HolderEvents {
}

pub struct Holder {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &HolderProps;
    tag_div: int;
    c1: Probe;

    fn new(mem: &Arena): Holder {
        let ps = mem.alloc::<HolderProps>(1);
        return Holder {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            c1: Probe.new(mem),
        };
    }

    fn j3Reset(this: &Holder) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Holder, "ui/Holder.j3ui", SCOPE_Holder, LINE0_Holder);
        Probe.styles(css);
    }

    fn init(this: &Holder, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn onMount(this: &Holder) {
        let state = this.p.state;
 state.mounts += 1; 
    }

    fn onDestroy(this: &Holder) {
        let state = this.p.state;
 state.destroys += 1; 
    }

    fn update(this: &Holder, d: &Dom, p: HolderProps): HolderEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = HolderEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Holder);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, ProbeProps { state: state });
        d.leave(s2);
        d.close();
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Holder) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.onDestroy();
        this.ready = false;
    }

    fn paint(this: &Holder, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Probe.j3ui
pub const SCOPE_Probe: int = 2;
const CSS_Probe: string = "";
const LINE0_Probe: int = 0;

pub struct ProbeProps {
    state: &State;
}

pub struct ProbeEvents {
}

pub struct Probe {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ProbeProps;
    seen: int;
    tag_span: int;
    tag_input: int;

    fn new(mem: &Arena): Probe {
        let ps = mem.alloc::<ProbeProps>(1);
        return Probe {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            seen: 0,
            tag_span: 0,
            tag_input: 0,
        };
    }

    fn j3Reset(this: &Probe) {
        let mem = this.mem;
        this.ready = false;
        this.seen = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Probe, "ui/Probe.j3ui", SCOPE_Probe, LINE0_Probe);
    }

    fn init(this: &Probe, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_span = d.tag("span");
        this.tag_input = d.tag("input");
    }

    fn onMount(this: &Probe) {
        let state = this.p.state;
 state.mounts += 1; 
    }

    fn onFrame(this: &Probe, dt: f32) {
        let state = this.p.state;
 state.frames += 1; this.seen += 1; if this.seen == 1 { state.fresh += 1; } state.lastDt = dt; 
    }

    fn onDestroy(this: &Probe) {
        let state = this.p.state;
 state.destroys += 1; 
    }

    fn update(this: &Probe, d: &Dom, p: ProbeProps): ProbeEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ProbeEvents {  };
        this.onFrame(d.dt());
        let n1 = d.open(0, this.tag_span, SCOPE_Probe);
        d.text("probe");
        d.close();
        let n2 = d.open(1, this.tag_input, SCOPE_Probe);
        d.attrType(n2, "text");
        if d.changed(n2) {
            state.txt = d.strValue(n2);
        }
        d.attrText(n2, state.txt);
        d.close();
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Probe) {
        if !this.ready {
            return;
        }
        this.onDestroy();
        this.ready = false;
    }

    fn paint(this: &Probe, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
        let n2 = d.paintNext(1);
        if n2 >= 0 {
            d.paintBox(n2);
            let pass2 = 0;
            while d.paintChildren(pass2) {
                pass2 += 1;
            }
            d.paintEnd(n2);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 3;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

#[singleton]
let Screen_LABELS: [3]string;

const Screen_TWO: int = 2;

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c2: Probe;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c2: Probe.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c2.j3Reset();
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        this.c2.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_span: int;
    c1: Holder;
    c3: Holder;
    c4: Probe;
    if1: int;
    if2: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_span: 0,
            c1: Holder.new(mem),
            c3: Holder.new(mem),
            c4: Probe.new(mem),
            if1: -1,
            if2: -1,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.c3.j3Reset();
        this.c4.j3Reset();
        this.if1 = -1;
        this.if2 = -1;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Screen_LABELS = ["a", "b", "c"];
        Holder.styles(css);
        Probe.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Holder.j3ui", CSS_Holder, 311163973, true) {
            ch = true;
        }
        if hotFile(css, "ui/Probe.j3ui", CSS_Probe, 723083172, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 251650679, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        let b2 = -1;
        if state.show {
            b2 = 0;
        }
        if b2 != this.if1 {
            if this.if1 == 0 {
                this.c1.destroy();
            }
            this.if1 = b2;
            if b2 == 0 {
                this.c1.j3Reset();
            }
        }
        if b2 == 0 {
            let s3 = d.enter(0);
            let e3 = this.c1.update(d, HolderProps { state: state });
            d.leave(s3);
        }
        let s4 = d.enter(1);
        let m4 = state.n;
        this.cnt1 = m4;
        while this.e1.len < m4 { this.e1.push(Screen_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m4 {
            for zq4 in m4..this.e1.len { this.e1.items[zq4].destroy(); this.fp1.push(this.e1.items[zq4]); }
            this.e1.len = m4;
        }
        for i in 0..m4 {
            let r1 = this.e1.items[i];
            let s5 = d.enter(i * 1 + 0);
            let e5 = r1.c2.update(d, ProbeProps { state: state });
            d.leave(s5);
        }
        d.leave(s4);
        let m6 = state.pg;
        let b7 = -1;
        if m6 == 0 {
            b7 = 0;
        } else if m6 == 1 || m6 == Screen_TWO {
            b7 = 1;
        } else {
            b7 = 2;
        }
        if b7 != this.if2 {
            if this.if2 == 0 {
                this.c3.destroy();
            } else if this.if2 == 1 {
                this.c4.destroy();
            }
            this.if2 = b7;
            if b7 == 0 {
                this.c3.j3Reset();
            } else if b7 == 1 {
                this.c4.j3Reset();
            }
        }
        if b7 == 0 {
            let s8 = d.enter(2);
            let e8 = this.c3.update(d, HolderProps { state: state });
            d.leave(s8);
        } else if b7 == 1 {
            let s9 = d.enter(3);
            let e9 = this.c4.update(d, ProbeProps { state: state });
            d.leave(s9);
        } else if b7 == 2 {
            let n10 = d.open(4, this.tag_span, SCOPE_Screen);
            d.text(`{Screen_LABELS[1]}`);
            d.close();
        }
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c3.destroy();
        this.c4.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s3 = d.enter(0);
                this.c1.paint(d);
                d.leave(s3);
                let s4 = d.enter(1);
                let m4 = this.cnt1;
                for i in 0..m4 {
                    let r1 = this.e1.items[i];
                    let s5 = d.enter(i * 1 + 0);
                    r1.c2.paint(d);
                    d.leave(s5);
                }
                d.leave(s4);
                let s8 = d.enter(2);
                this.c3.paint(d);
                d.leave(s8);
                let s9 = d.enter(3);
                this.c4.paint(d);
                d.leave(s9);
                let n10 = d.paintNext(4);
                if n10 >= 0 {
                    d.paintBox(n10);
                    let pass10 = 0;
                    while d.paintChildren(pass10) {
                        pass10 += 1;
                    }
                    d.paintEnd(n10);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

