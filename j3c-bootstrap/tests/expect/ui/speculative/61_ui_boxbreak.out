    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_span: 0,
            cls_screen: 0,
            cls_cols: 0,
            cls_col: 0,
            cls_a: 0,
            cls_c: 0,
            cls_g: 0,
            cls_s: 0,
            cls_u: 0,
            cls_tf: 0,
            cls_top: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_span = d.tag("span");
        this.cls_screen = d.css.intern("screen");
        this.cls_cols = d.css.intern("cols");
        this.cls_col = d.css.intern("col");
        this.cls_a = d.css.intern("a");
        this.cls_c = d.css.intern("c");
