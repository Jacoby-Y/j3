pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 340px; padding: 10px; color: #ffffff; font-size: 13px; }\n    .cols { display: flex; gap: 10px; margin: 0 0 14px 0; }\n    .col { width: 160px; margin: 0; background: #202030; line-height: 26px; }\n    .a { padding: 0 6px; border: 2px solid #ffd040; background: #204878; }\n    .g { padding: 0 8px; border-radius: 9px; background: linear-gradient(90deg, #d03060, #3060d0); }\n    .s { padding: 0 6px; border-radius: 4px; background: #306030; box-shadow: 0 2px 4px #000000; }\n    .u { padding: 0 8px; border-radius: 6px; background: url(assets/dots.png) 0 0 / 16px 16px no-repeat, #204878; }\n    .tf { transform: rotate(-2deg); transform-origin: 0 0; }\n    .top { vertical-align: top; }\n    .c { box-decoration-break: clone; }";
