// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; }\n    .card {\n        width: 220px; height: 74px; padding: 8px; box-sizing: border-box; background: #ffffff; margin-bottom: 8px;\n        .title { font-size: 14px; color: #2040a0; }\n        .body { margin-top: 2px; }\n        & + & { border-top: 3px solid var(--accent); }\n        &:hover {\n            background: #dfe8ff;\n            .title { color: #c02060; }\n        }\n        .btn {\n            margin-top: 4px; height: 20px; width: 60px; background: #4080ff; color: #ffffff; text-align: center;\n            &:active { background: #103080; }\n        }\n        .screen & { border-left: 4px solid #8060c0; }\n        @media (max-width: 400px) {\n            width: 150px; background: #fff0e0;\n            .title { font-size: 11px; }\n        }\n        padding-left: 14px;\n    }";
const LINE0_Screen: int = 9;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_page: int;
    cls_card: int;
    cls_title: int;
    cls_body: int;
    cls_btn: int;
    cls_hint: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_card: 0,
            cls_title: 0,
            cls_body: 0,
            cls_btn: 0,
            cls_hint: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_card = d.css.intern("card");
        this.cls_title = d.css.intern("title");
        this.cls_body = d.css.intern("body");
        this.cls_btn = d.css.intern("btn");
        this.cls_hint = d.css.intern("hint");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 402917763, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_card);
        let n3 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_title);
        d.text("First card");
        d.close();
        let n4 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_body);
        d.text("hover me");
        d.close();
        let n5 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_btn);
        d.text("Go");
        d.close();
        d.close();
        let n6 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_card);
        let n7 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_title);
        d.text("Second card");
        d.close();
        let n8 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_body);
        d.text("next sibling gets a rule");
        d.close();
        let n9 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n9, this.cls_btn);
        d.text("Stop");
        d.close();
        d.close();
        let n10 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n10, this.cls_hint);
        d.text("theme.css nesting");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(2);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n6 = d.paintNext(1);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        let n7 = d.paintNext(0);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        let n8 = d.paintNext(1);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        let n9 = d.paintNext(2);
                        if n9 >= 0 {
                            d.paintBox(n9);
                            let pass9 = 0;
                            while d.paintChildren(pass9) {
                                pass9 += 1;
                            }
                            d.paintEnd(n9);
                        }
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n10 = d.paintNext(2);
                if n10 >= 0 {
                    d.paintBox(n10);
                    let pass10 = 0;
                    while d.paintChildren(pass10) {
                        pass10 += 1;
                    }
                    d.paintEnd(n10);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

