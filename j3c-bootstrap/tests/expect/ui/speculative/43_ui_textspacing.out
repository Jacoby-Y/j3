// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 520px; padding: 10px; color: #ffffff; font-size: 14px; }\n    .title { font-size: 26px; letter-spacing: 6px; color: #80c0ff; margin-bottom: 6px; }\n    .bar { display: flex; gap: 8px; margin-bottom: 8px; }\n    .btn { text-transform: uppercase; letter-spacing: 1px; padding: 4px 8px; background: #303050; color: #ffffff; border: 0; font-size: 12px; }\n    .btn.ls { letter-spacing: -0.5px; word-spacing: 3px; }\n    .para { text-indent: 2em; margin-bottom: 6px; }\n    .just { width: 300px; word-spacing: 4px; text-align: justify; background: #202030; margin-bottom: 6px; }\n    .cap { text-transform: capitalize; margin-bottom: 6px; }\n    @keyframes grow { from { letter-spacing: 0px; word-spacing: 0px; } to { letter-spacing: 12px; word-spacing: 24px; } }\n    .tween { white-space: nowrap; color: #ffd080; margin-bottom: 6px; animation: grow 160ms linear forwards; }\n    .clip { width: 200px; letter-spacing: 3px; white-space: nowrap; overflow-y: hidden; text-overflow: ellipsis; background: #202030; }";
const LINE0_Screen: int = 17;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_h1: int;
    tag_button: int;
    tag_p: int;
    cls_screen: int;
    cls_title: int;
    cls_bar: int;
    cls_btn: int;
    cls_ls: int;
    cls_para: int;
    cls_just: int;
    cls_cap: int;
    cls_tween: int;
    cls_clip: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_h1: 0,
            tag_button: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_bar: 0,
            cls_btn: 0,
            cls_ls: 0,
            cls_para: 0,
            cls_just: 0,
            cls_cap: 0,
            cls_tween: 0,
            cls_clip: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_h1 = d.tag("h1");
        this.tag_button = d.tag("button");
        this.tag_p = d.tag("p");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_bar = d.css.intern("bar");
        this.cls_btn = d.css.intern("btn");
        this.cls_ls = d.css.intern("ls");
        this.cls_para = d.css.intern("para");
        this.cls_just = d.css.intern("just");
        this.cls_cap = d.css.intern("cap");
        this.cls_tween = d.css.intern("tween");
        this.cls_clip = d.css.intern("clip");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 834726173, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_h1, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Spaced Title");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_bar);
        let n4 = d.open(0, this.tag_button, SCOPE_Screen);
        d.clsId(n4, this.cls_btn);
        d.text("save");
        d.close();
        let n5 = d.open(1, this.tag_button, SCOPE_Screen);
        d.clsId(n5, this.cls_btn);
        d.text("cancel");
        d.close();
        let n6 = d.open(2, this.tag_button, SCOPE_Screen);
        d.clsId(n6, this.cls_btn);
        d.clsId(n6, this.cls_ls);
        d.text("open file");
        d.close();
        d.close();
        let n7 = d.open(2, this.tag_p, SCOPE_Screen);
        d.clsId(n7, this.cls_para);
        d.text("The first line of this paragraph starts indented while the lines after it begin at the edge, and the text keeps wrapping.");
        d.close();
        let n8 = d.open(3, this.tag_p, SCOPE_Screen);
        d.clsId(n8, this.cls_just);
        d.text("word spacing widens each gap, then justify stretches the line to the edge of the box");
        d.close();
        let n9 = d.open(4, this.tag_p, SCOPE_Screen);
        d.clsId(n9, this.cls_cap);
        d.text("capitalize turns the first letter of each word up, even in don't and day-off");
        d.close();
        let n10 = d.open(5, this.tag_p, SCOPE_Screen);
        d.clsId(n10, this.cls_tween);
        d.text("tween spacing");
        d.close();
        let n11 = d.open(6, this.tag_p, SCOPE_Screen);
        d.clsId(n11, this.cls_clip);
        d.text("letter spacing narrows how many letters fit before the ellipsis");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        let n6 = d.paintNext(2);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n7 = d.paintNext(2);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n8 = d.paintNext(3);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                let n9 = d.paintNext(4);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                let n10 = d.paintNext(5);
                if n10 >= 0 {
                    d.paintBox(n10);
                    let pass10 = 0;
                    while d.paintChildren(pass10) {
                        pass10 += 1;
                    }
                    d.paintEnd(n10);
                }
                let n11 = d.paintNext(6);
                if n11 >= 0 {
                    d.paintBox(n11);
                    let pass11 = 0;
                    while d.paintChildren(pass11) {
                        pass11 += 1;
                    }
                    d.paintEnd(n11);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

