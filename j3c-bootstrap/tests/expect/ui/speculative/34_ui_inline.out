// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; user-select: text; }\n    .chat { margin: 0 0 14px 0; line-height: 24px; background: #202030; }\n    .who { color: #80c0ff; padding: 1px 4px; background: #203050; }\n    .item { color: #ffd040; }\n    .rare { margin-left: 4px; padding: 1px 6px; border: 1px solid #a070ff; border-radius: 4px; background: #382060; color: #e0c8ff; font-size: 12px; }\n    .hl { background: #806010; padding: 2px 5px; border: 2px solid #ffd040; border-radius: 6px; }\n    .badge { padding: 0 5px; background: #20a050; border-radius: 8px; }\n    .outer { padding: 0 4px; background: #a03030; }\n    .inner { padding: 0 3px; background: #ffb000; color: #000000; }\n    .line { margin: 0; }\n    .tag::before { content: \"[\"; }\n    .tag::after { content: \"]\"; }\n    .tag { padding: 0 2px; background: #2a4a5a; }\n    .epic::before { content: \"*\"; display: inline; padding: 0 4px; margin-right: 3px; background: #c04080; border-radius: 6px; }\n    .epic::after { content: \"\"; }";
const LINE0_Screen: int = 9;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    tag_span: int;
    cls_screen: int;
    cls_chat: int;
    cls_who: int;
    cls_item: int;
    cls_rare: int;
    cls_hl: int;
    cls_badge: int;
    cls_outer: int;
    cls_inner: int;
    cls_line: int;
    cls_tag: int;
    cls_epic: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_span: 0,
            cls_screen: 0,
            cls_chat: 0,
            cls_who: 0,
            cls_item: 0,
            cls_rare: 0,
            cls_hl: 0,
            cls_badge: 0,
            cls_outer: 0,
            cls_inner: 0,
            cls_line: 0,
            cls_tag: 0,
            cls_epic: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_span = d.tag("span");
        this.cls_screen = d.css.intern("screen");
        this.cls_chat = d.css.intern("chat");
        this.cls_who = d.css.intern("who");
        this.cls_item = d.css.intern("item");
        this.cls_rare = d.css.intern("rare");
        this.cls_hl = d.css.intern("hl");
        this.cls_badge = d.css.intern("badge");
        this.cls_outer = d.css.intern("outer");
        this.cls_inner = d.css.intern("inner");
        this.cls_line = d.css.intern("line");
        this.cls_tag = d.css.intern("tag");
        this.cls_epic = d.css.intern("epic");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 3703860, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_p, SCOPE_Screen);
        d.clsId(n2, this.cls_chat);
        let n3 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n3, this.cls_who);
        d.text("Mira");
        d.close();
        d.text(" found a ");
        let n4 = d.open(1, this.tag_span, SCOPE_Screen);
        d.clsId(n4, this.cls_item);
        d.text("Moonblade");
        d.close();
        let n5 = d.open(2, this.tag_span, SCOPE_Screen);
        d.clsId(n5, this.cls_rare);
        d.text("Rare");
        d.close();
        d.text(" in the vault and keeps ");
        let n6 = d.open(3, this.tag_span, SCOPE_Screen);
        d.clsId(n6, this.cls_hl);
        d.text("talking about how it glows in the dark");
        d.close();
        d.text(" all the way home.");
        d.close();
        let n7 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n7, this.cls_chat);
        let n8 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n8, this.cls_who);
        d.text("Tor");
        d.close();
        let n9 = d.open(1, this.tag_span, SCOPE_Screen);
        d.clsId(n9, this.cls_badge);
        d.text("NEW");
        d.close();
        d.text(" nested ");
        let n10 = d.open(2, this.tag_span, SCOPE_Screen);
        d.clsId(n10, this.cls_outer);
        d.text("outer ");
        let n11 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n11, this.cls_inner);
        d.text("inner");
        d.close();
        d.text(" end");
        d.close();
        d.text(" text");
        d.close();
        let n12 = d.open(2, this.tag_p, SCOPE_Screen);
        d.clsId(n12, this.cls_line);
        d.text("Quest ");
        let n13 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n13, this.cls_tag);
        d.text("Dragon Hunt");
        d.close();
        let n14 = d.open(1, this.tag_span, SCOPE_Screen);
        d.clsId(n14, this.cls_tag);
        d.clsId(n14, this.cls_epic);
        d.text("Epic");
        d.close();
        d.text(" ready");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(2);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        let n6 = d.paintNext(3);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n7 = d.paintNext(1);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        let n8 = d.paintNext(0);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        let n9 = d.paintNext(1);
                        if n9 >= 0 {
                            d.paintBox(n9);
                            let pass9 = 0;
                            while d.paintChildren(pass9) {
                                pass9 += 1;
                            }
                            d.paintEnd(n9);
                        }
                        let n10 = d.paintNext(2);
                        if n10 >= 0 {
                            d.paintBox(n10);
                            let pass10 = 0;
                            while d.paintChildren(pass10) {
                                let n11 = d.paintNext(0);
                                if n11 >= 0 {
                                    d.paintBox(n11);
                                    let pass11 = 0;
                                    while d.paintChildren(pass11) {
                                        pass11 += 1;
                                    }
                                    d.paintEnd(n11);
                                }
                                pass10 += 1;
                            }
                            d.paintEnd(n10);
                        }
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n12 = d.paintNext(2);
                if n12 >= 0 {
                    d.paintBox(n12);
                    let pass12 = 0;
                    while d.paintChildren(pass12) {
                        let n13 = d.paintNext(0);
                        if n13 >= 0 {
                            d.paintBox(n13);
                            let pass13 = 0;
                            while d.paintChildren(pass13) {
                                pass13 += 1;
                            }
                            d.paintEnd(n13);
                        }
                        let n14 = d.paintNext(1);
                        if n14 >= 0 {
                            d.paintBox(n14);
                            let pass14 = 0;
                            while d.paintChildren(pass14) {
                                pass14 += 1;
                            }
                            d.paintEnd(n14);
                        }
                        pass12 += 1;
                    }
                    d.paintEnd(n12);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

