// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    tag_span: int;
    cls_chat: int;
    cls_msg: int;
    cls_t: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;
    vl1: VList;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_span: 0,
            cls_chat: 0,
            cls_msg: 0,
            cls_t: 0,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
            vl1: VList.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
        this.vl1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_span = d.tag("span");
        this.cls_chat = d.css.intern("chat");
        this.cls_msg = d.css.intern("msg");
        this.cls_t = d.css.intern("t");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 779835779, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_chat);
        let s2 = d.enter(0);
        let x2 = state.msgs;
        this.vl1.cfg(f32(0.0), f32(40.0), true, true);
        this.vl1.keep = state.keep;
        if state.atEnd && !this.vl1.atEnd { this.vl1.toEnd = true; }
        if this.vl1.stale(x2.len) {
            let ap2 = this.vl1.grew(x2.len);
            if ap2 {
                this.vl1.pk.begin();
                let kr2a = x2[0];
                this.vl1.pk.add(`{kr2a.id}`);
                let kr2b = x2[this.vl1.n - 1];
                this.vl1.pk.add(`{kr2b.id}`);
                ap2 = this.vl1.probeOk();
            }
            if ap2 {
                for kq2 in this.vl1.n..x2.len {
                    let kr2c = x2[kq2];
                    this.vl1.all.push(`{kr2c.id}`);
                }
                this.vl1.appended(x2.len);
            } else {
                this.vl1.all.begin();
                for kq2 in 0..x2.len {
                    let kr2d = x2[kq2];
                    this.vl1.all.add(`{kr2d.id}`);
                }
                this.vl1.all.finish("ui/Screen.j3ui:6");
                this.vl1.rebuilt(x2.len);
            }
        }
        let w2 = vlist.step(d, n1, &this.vl1, x2.len);
        let m2 = this.vl1.cnt;
        state.atEnd = this.vl1.atEnd;
        this.cnt1 = m2;
        this.kd1.begin();
        for kv2 in 0..m2 {
            let kj2 = this.vl1.at(kv2);
            let ki2 = x2[kj2];
            this.kd1.add(`{ki2.id}`);
        }
        this.kd1.finish("ui/Screen.j3ui:6");
        this.vl1.verify(&this.kd1);
        if this.kd1.changed {
            for dq2 in 0..this.kd1.dead.len { let dr2 = this.e1.items[this.kd1.dead.items[dq2]]; dr2.destroy(); this.fp1.push(dr2); }
            this.eb1.len = 0;
            for rq2 in 0..m2 {
                let f2 = this.kd1.from.items[rq2];
                if f2 >= 0 { this.eb1.push(this.e1.items[f2]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t2 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t2;
        }
        for i2 in 0..m2 {
            let ax2 = this.vl1.at(i2); let m = x2[ax2];
            let r1 = this.e1.items[i2];
            d.keyBegin(r1.uid);
            let n3 = d.open(0, this.tag_p, SCOPE_Screen);
            d.clsId(n3, this.cls_msg);
            let n4 = d.open(0, this.tag_span, SCOPE_Screen);
            d.text(`{m.id}`);
            d.close();
            let n5 = d.open(1, this.tag_span, SCOPE_Screen);
            d.clsId(n5, this.cls_t);
            d.text(`{m.text}`);
            d.close();
            d.close();
            d.keyEnd();
        }
        vlist.finish(d, n1, &this.vl1);
        d.leave(s2);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                let m2 = this.cnt1;
                for i2 in 0..m2 {
                    let r1 = this.e1.items[i2];
                    d.paintGroup(r1.uid);
                    let n3 = d.paintNext(0);
                    if n3 >= 0 {
                        d.paintBox(n3);
                        let pass3 = 0;
                        while d.paintChildren(pass3) {
                            let n4 = d.paintNext(0);
                            if n4 >= 0 {
                                d.paintBox(n4);
                                let pass4 = 0;
                                while d.paintChildren(pass4) {
                                    pass4 += 1;
                                }
                                d.paintEnd(n4);
                            }
                            let n5 = d.paintNext(1);
                            if n5 >= 0 {
                                d.paintBox(n5);
                                let pass5 = 0;
                                while d.paintChildren(pass5) {
                                    pass5 += 1;
                                }
                                d.paintEnd(n5);
                            }
                            pass3 += 1;
                        }
                        d.paintEnd(n3);
                    }
                    d.paintGroupEnd();
                }
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

