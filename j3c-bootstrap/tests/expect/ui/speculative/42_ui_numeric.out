pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; gap: 16px; padding: 10px; width: 520px; color: #ffffff; font-size: 16px; }\n    .col { width: 160px; background: #202030; padding: 6px; }\n    .head { font-size: 11px; color: #80c0ff; margin-bottom: 4px; }\n    .row { line-height: 22px; text-align: right; border-bottom: 1px solid #404060; }\n    .tab { font-variant-numeric: tabular-nums; }\n    .norm { font-variant-numeric: normal; }\n    .small .row { font-size: 14px; }\n    .clip { width: 80px; white-space: nowrap; overflow-y: hidden; text-overflow: ellipsis; text-align: left; }\n    .wave { text-wave-amplitude: 0px; }";
const LINE0_Screen: int = 32;

