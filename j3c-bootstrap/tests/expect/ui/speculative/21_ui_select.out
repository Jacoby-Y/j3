                                    while d.paintChildren(pass32) {
                                        let n33 = d.paintNext(0);
                                        if n33 >= 0 {
                                            d.paintBox(n33);
                                            let pass33 = 0;
                                            while d.paintChildren(pass33) {
                                                pass33 += 1;
                                            }
                                            d.paintEnd(n33);
                                        }
                                        pass32 += 1;
                                    }
                                    d.paintEnd(n32);
                                }
                                pass30 += 1;
                            }
                            d.paintEnd(n30);
                        }
                        let n34 = d.paintNext(2);
                        if n34 >= 0 {
                            d.paintBox(n34);
                            let pass34 = 0;
                            while d.paintChildren(pass34) {
                                let n35 = d.paintNext(0);
                                if n35 >= 0 {
                                    d.paintBox(n35);
                                    let pass35 = 0;
                                    while d.paintChildren(pass35) {
                                        pass35 += 1;
                                    }
                                    d.paintEnd(n35);
                                }
                                pass34 += 1;
                            }
                            d.paintEnd(n34);
                        }
                        pass24 += 1;
                    }
                    d.paintEnd(n24);
                }
                let n36 = d.paintNext(5);
                if n36 >= 0 {
                    d.paintBox(n36);
                    let pass36 = 0;
                    while d.paintChildren(pass36) {
                        pass36 += 1;
                    }
                    d.paintEnd(n36);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

