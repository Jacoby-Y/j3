// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .app { width: 640px; height: 480px; background: var(--bg); position: relative; }\n    select { position: absolute; top: 20px; width: 180px; height: 32px; }\n    .a { left: 20px; }\n    .b { left: 230px; }\n    .c { left: 440px; }\n    .d { left: 20px; top: 300px; }\n    .e { left: 20px; top: 100px; width: 260px; }\n    .e .j3-option { height: 34px; }\n    .fruit-icon { width: 20px; height: 20px; margin-right: 10px; }\n    option .fruit-name { color: #a6e3a1; font-weight: bold; }\n    option .detail { color: #f9e2af; }\n    .out { position: absolute; left: 230px; top: 300px; }\n    /* A component's own rules reach its select lists: the popup nodes carry the owner's style scope. */\n    select.fancy .j3-select-list { box-shadow: 0 8px 22px rgba(203, 166, 247, 0.55); max-height: 120px; border-radius: 12px; background: #2a2540; border-color: #cba6f7; padding: 4px 0; }\n    select.fancy .j3-option { height: auto; padding: 7px 10px; border-radius: 8px; margin: 0 4px 2px; }\n    select.fancy .j3-option.selected { background: #45475a; }\n    select.fancy .j3-option:hover { background: #7f5fbf; }\n    select.fancy .j3-check { accent-color: #a6e3a1; width: 14px; height: 12px; margin: 0 8px 0 0; }";
const LINE0_Screen: int = 42;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_select: int;
    tag_option: int;
    tag_svg: int;
    tag_path: int;
    tag_span: int;
    tag_img: int;
    cls_app: int;
    cls_a: int;
    cls_b: int;
    cls_fancy: int;
    cls_c: int;
    cls_d: int;
    cls_e: int;
    cls_fruit_icon: int;
    cls_fruit_name: int;
    cls_detail: int;
    cls_out: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_select: 0,
            tag_option: 0,
            tag_svg: 0,
            tag_path: 0,
            tag_span: 0,
            tag_img: 0,
            cls_app: 0,
            cls_a: 0,
            cls_b: 0,
            cls_fancy: 0,
            cls_c: 0,
            cls_d: 0,
            cls_e: 0,
            cls_fruit_icon: 0,
            cls_fruit_name: 0,
            cls_detail: 0,
            cls_out: 0,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_select = d.tag("select");
        this.tag_option = d.tag("option");
        this.tag_svg = d.tag("svg");
        this.tag_path = d.tag("path");
        this.tag_span = d.tag("span");
        this.tag_img = d.tag("img");
        this.cls_app = d.css.intern("app");
        this.cls_a = d.css.intern("a");
        this.cls_b = d.css.intern("b");
        this.cls_fancy = d.css.intern("fancy");
        this.cls_c = d.css.intern("c");
        this.cls_d = d.css.intern("d");
        this.cls_e = d.css.intern("e");
        this.cls_fruit_icon = d.css.intern("fruit-icon");
        this.cls_fruit_name = d.css.intern("fruit-name");
        this.cls_detail = d.css.intern("detail");
        this.cls_out = d.css.intern("out");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 529581056, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
