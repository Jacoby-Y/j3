        this.kd1.finish("ui/Screen.j3ui:23");
        if this.kd1.changed {
            for dq17 in 0..this.kd1.dead.len { let dr17 = this.e1.items[this.kd1.dead.items[dq17]]; dr17.destroy(); this.fp1.push(dr17); }
            this.eb1.len = 0;
            for rq17 in 0..m17 {
                let f17 = this.kd1.from.items[rq17];
                if f17 >= 0 { this.eb1.push(this.e1.items[f17]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t17 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t17;
        }
