            let n35 = d.open(0, this.tag_span, SCOPE_Screen);
            d.clsId(n35, this.cls_fruit_name);
            d.text("Sold out");
            d.close();
            d.close();
            d.close();
        }
        let n36 = d.open(5, this.tag_span, SCOPE_Screen);
        d.clsId(n36, this.cls_out);
        d.text(Text.scratch().add(`{state.fruit}`).add(" ").add(`{state.changes}`).str());
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

