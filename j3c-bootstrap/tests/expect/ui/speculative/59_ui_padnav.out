// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }\n    .title { margin-bottom: 8px; color: #a0b0d0; font-size: 18px; }\n    .row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }\n    .lab { width: 70px; }\n    .val { color: #a0b0d0; }\n    select { width: 120px; height: 28px; }\n    input[type=\"range\"] { width: 140px; }\n    .buttons { display: flex; gap: 10px; margin-top: 4px; }\n    button { width: 70px; height: 28px; background: #3050a0; color: #ffffff; border: none; border-radius: 4px; }\n    button:focus-visible, input:focus-visible, select:focus-visible { outline: 3px solid #f9e2af; outline-offset: 2px; }\n    summary { margin-top: 6px; width: 70px; height: 20px; }\n    summary:focus-visible { outline: 3px solid #f9e2af; outline-offset: 2px; }\n    .more { font-size: 12px; color: #a0b0d0; }\n    .status { margin-top: 10px; font-size: 12px; color: #a0b0d0; }";
const LINE0_Screen: int = 40;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    music: bool;
    volume: f32;
    quality: string;
    applied: int;
    backs: int;
    more: bool;
    tag_div: int;
    tag_span: int;
    tag_input: int;
    tag_select: int;
    tag_option: int;
    tag_button: int;
    tag_details: int;
    tag_summary: int;
    tag_p: int;
    cls_screen: int;
    cls_title: int;
    cls_row: int;
    cls_lab: int;
    cls_val: int;
    cls_buttons: int;
    cls_more: int;
    cls_status: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            music: false,
            volume: 0.5,
            quality: "Low",
            applied: 0,
            backs: 0,
            more: false,
            tag_div: 0,
            tag_span: 0,
            tag_input: 0,
            tag_select: 0,
            tag_option: 0,
            tag_button: 0,
            tag_details: 0,
            tag_summary: 0,
            tag_p: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_row: 0,
            cls_lab: 0,
            cls_val: 0,
            cls_buttons: 0,
            cls_more: 0,
            cls_status: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.music = false;
        this.volume = 0.5;
        this.quality = "Low";
        this.applied = 0;
        this.backs = 0;
        this.more = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_input = d.tag("input");
        this.tag_select = d.tag("select");
        this.tag_option = d.tag("option");
        this.tag_button = d.tag("button");
        this.tag_details = d.tag("details");
        this.tag_summary = d.tag("summary");
        this.tag_p = d.tag("p");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_row = d.css.intern("row");
        this.cls_lab = d.css.intern("lab");
        this.cls_val = d.css.intern("val");
        this.cls_buttons = d.css.intern("buttons");
        this.cls_more = d.css.intern("more");
        this.cls_status = d.css.intern("status");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 283511520, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Settings");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_row);
        let n4 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n4, this.cls_lab);
        d.text("Music");
        d.close();
        let n5 = d.open(1, this.tag_input, SCOPE_Screen);
        d.attrType(n5, "checkbox");
        d.attrAria(n5, "Music");
        if d.clicked(n5) {
            this.music = !this.music;
        }
        d.attrChecked(n5, this.music);
        d.close();
        let n6 = d.open(2, this.tag_span, SCOPE_Screen);
        d.clsId(n6, this.cls_val);
        d.text(`{if this.music { "on" } else { "off" }}`);
        d.close();
        d.close();
        let n7 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_row);
        let n8 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n8, this.cls_lab);
        d.text("Volume");
        d.close();
        let n9 = d.open(1, this.tag_input, SCOPE_Screen);
        d.attrType(n9, "range");
        d.attrMin(n9, f32(0));
        d.attrMax(n9, f32(1));
        d.attrStep(n9, f32(0.1));
        d.attrAria(n9, "Volume");
        if d.changed(n9) {
            this.volume = d.value(n9);
        }
        d.attrValue(n9, this.volume);
        d.close();
        d.close();
        let n10 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n10, this.cls_row);
        let n11 = d.open(0, this.tag_span, SCOPE_Screen);
        d.clsId(n11, this.cls_lab);
        d.text("Quality");
        d.close();
        let n12 = d.open(1, this.tag_select, SCOPE_Screen);
        d.attrAria(n12, "Quality");
        if d.changed(n12) {
            this.quality = d.strValue(n12);
        }
        d.attrText(n12, this.quality);
        let n13 = d.open(0, this.tag_option, SCOPE_Screen);
        d.attrText(n13, "Low");
        d.text("Low");
        d.close();
        let n14 = d.open(1, this.tag_option, SCOPE_Screen);
        d.attrText(n14, "Medium");
        d.text("Medium");
        d.close();
        let n15 = d.open(2, this.tag_option, SCOPE_Screen);
        d.attrText(n15, "High");
        d.text("High");
        d.close();
        let n16 = d.open(3, this.tag_option, SCOPE_Screen);
        d.attrText(n16, "Ultra");
        d.text("Ultra");
        d.close();
        d.close();
        d.close();
        let n17 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n17, this.cls_buttons);
        d.attrNav(n17, 0, "wrap");
        let n18 = d.open(0, this.tag_button, SCOPE_Screen);
        if d.clicked(n18) {
            this.applied += 1;
        }
        d.text("Apply");
        d.close();
        let n19 = d.open(1, this.tag_button, SCOPE_Screen);
        if d.clicked(n19) {
            this.backs += 1;
        }
        d.text("Back");
        d.close();
        d.close();
        let n20 = d.open(5, this.tag_details, SCOPE_Screen);
        if d.userToggled(n20) {
            this.more = d.isOpen(n20);
        }
        d.attrOpen(n20, this.more);
        let n21 = d.open(0, this.tag_summary, SCOPE_Screen);
        d.attrTabIndex(n21);
        d.text("More");
        d.close();
        let n22 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n22, this.cls_more);
        d.text(Text.scratch().add("extra ").add(`{this.more}`).str());
        d.close();
        d.close();
        let n23 = d.open(6, this.tag_p, SCOPE_Screen);
        d.clsId(n23, this.cls_status);
        d.text(Text.scratch().add("applied ").add(`{this.applied}`).add(" back ").add(`{this.backs}`).add(" quality ").add(`{this.quality}`).str());
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

