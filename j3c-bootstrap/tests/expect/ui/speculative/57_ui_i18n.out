// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    n: int;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_h1: int;
    tag_span: int;
    tag_p: int;
    tag_button: int;
    cls_page: int;
    cls_rtl: int;
    cls_row: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_h1: 0,
            tag_span: 0,
            tag_p: 0,
            tag_button: 0,
            cls_page: 0,
            cls_rtl: 0,
            cls_row: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_h1 = d.tag("h1");
        this.tag_span = d.tag("span");
        this.tag_p = d.tag("p");
        this.tag_button = d.tag("button");
        this.cls_page = d.css.intern("page");
        this.cls_rtl = d.css.intern("rtl");
        this.cls_row = d.css.intern("row");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 121544571, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let n = p.n;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_page);
        d.clsIfId(n1, this.cls_rtl, i18n.rtl());
        let n2 = d.open(0, this.tag_h1, SCOPE_Screen);
        d.text(`{t("app.title")}`);
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_row);
        let n4 = d.open(0, this.tag_span, SCOPE_Screen);
        d.text(`{t("app.stock")}`);
        d.close();
        let n5 = d.open(1, this.tag_span, SCOPE_Screen);
        d.text(`{i18n.fmtNum(1234567)}`);
        d.close();
        d.close();
        let n6 = d.open(2, this.tag_p, SCOPE_Screen);
        d.text(`{tf("shop.items", num(n))}`);
        d.close();
        let n7 = d.open(3, this.tag_p, SCOPE_Screen);
        d.text(`{tf("shop.total", num(n * 100))}`);
        d.close();
        let n8 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_row);
        let n9 = d.open(0, this.tag_button, SCOPE_Screen);
        d.text(`{t("shop.buy")}`);
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n6 = d.paintNext(2);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n7 = d.paintNext(3);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n8 = d.paintNext(4);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        let n9 = d.paintNext(0);
                        if n9 >= 0 {
                            d.paintBox(n9);
                            let pass9 = 0;
                            while d.paintChildren(pass9) {
                                pass9 += 1;
                            }
                            d.paintEnd(n9);
                        }
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

