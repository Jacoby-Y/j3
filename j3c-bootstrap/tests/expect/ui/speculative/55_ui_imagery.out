// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; flex-wrap: wrap; width: 100%; height: 100%; padding: 10px; gap: 10px; align-content: flex-start; }\n    .cell { width: 200px; height: 150px; }\n    .lbl { font-size: 10px; margin-top: 3px; }\n    .frame { border: 16px solid transparent; border-image: url(assets/frame.png) 8 fill / 16px; image-rendering: pixelated; }\n    .big { width: 150px; height: 90px; }\n    .small { width: 109px; height: 70px; }\n    .rep { border-image-repeat: repeat; }\n    .rnd { border-image-repeat: round; }\n    .spc { border-image-repeat: space; }\n    .str { border-image-repeat: stretch; }\n    .out { margin: 8px; border-image: url(assets/frame.png) 33.333% fill / 16px / 8px round; }\n    .layers { width: 190px; height: 120px; border-radius: 12px; image-rendering: pixelated;\n        background: url(assets/dots.png) 0 0 / 32px 32px repeat, linear-gradient(135deg, rgba(40, 160, 200, 0.55), rgba(220, 60, 120, 0.55)), url(assets/stripes.png) center / 48px 48px round, #20304c; }\n    .lists { width: 190px; height: 120px; background: #20304c; image-rendering: pixelated;\n        background-image: url(assets/dots.png), url(assets/stripes.png);\n        background-size: 32px, 40px 40px; background-position: 0 0, 4px 4px;\n        background-repeat: space, round; }";
const LINE0_Screen: int = 15;

