        this.cls_small = d.css.intern("small");
        this.cls_str = d.css.intern("str");
        this.cls_out = d.css.intern("out");
        this.cls_layers = d.css.intern("layers");
        this.cls_lists = d.css.intern("lists");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 957811769, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

