// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }\n    .title { margin-bottom: 8px; color: #a0b0d0; }\n    .card { display: flex; gap: 8px; padding: 8px; margin-bottom: 10px; border: 2px solid #303848; border-radius: 6px; }\n    .card:focus-within { border-color: #4caf50; background: #1a2a1a; }\n    .btn { width: 70px; height: 28px; background: #3050a0; color: #ffffff; border: none; border-radius: 4px; }\n    .btn:focus-visible { outline: 2px solid #89b4fa; outline-offset: 2px; }\n    .field { width: 100px; height: 28px; }\n    .field:focus-visible { outline: 2px solid #f9e2af; outline-offset: 1px; }";
const LINE0_Screen: int = 12;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_button: int;
    tag_input: int;
    cls_screen: int;
    cls_title: int;
    cls_card: int;
    cls_btn: int;
    cls_field: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_button: 0,
            tag_input: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_card: 0,
            cls_btn: 0,
            cls_field: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_button = d.tag("button");
        this.tag_input = d.tag("input");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_card = d.css.intern("card");
        this.cls_btn = d.css.intern("btn");
        this.cls_field = d.css.intern("field");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 261282727, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Focus");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_card);
        let n4 = d.open(0, this.tag_button, SCOPE_Screen);
        d.clsId(n4, this.cls_btn);
        d.text("One");
        d.close();
        let n5 = d.open(1, this.tag_button, SCOPE_Screen);
        d.clsId(n5, this.cls_btn);
        d.text("Two");
        d.close();
        let n6 = d.open(2, this.tag_input, SCOPE_Screen);
        d.attrType(n6, "text");
        d.clsId(n6, this.cls_field);
        d.attrText(n6, "text box");
        d.close();
        d.close();
        let n7 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_card);
        let n8 = d.open(0, this.tag_button, SCOPE_Screen);
        d.clsId(n8, this.cls_btn);
        d.text("Three");
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let n4 = d.paintNext(0);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        let n5 = d.paintNext(1);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        let n6 = d.paintNext(2);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n7 = d.paintNext(2);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        let n8 = d.paintNext(0);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

