        let n16 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n16, this.cls_cell);
        let n17 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n17, this.cls_chip);
        d.clsId(n17, this.cls_end);
        d.close();
        d.close();
        let n18 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n18, this.cls_cell);
        let n19 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n19, this.cls_chip);
        d.clsId(n19, this.cls_auto);
        d.close();
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

