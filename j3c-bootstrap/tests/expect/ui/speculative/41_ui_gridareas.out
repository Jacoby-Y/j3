// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 8px; background: #181c28; }\n    /* header, sidebar, main and footer as named areas; the middle row takes the rest of the height */\n    .page { display: grid; height: 90px; gap: 4px; grid-template-columns: 70px 1fr; grid-template-rows: 20px 1fr 18px; grid-template-areas: \"head head\" \"side main\" \"foot foot\"; }\n    .head { grid-area: head; background: #6080c0; }\n    .side { grid-area: side; background: #c08060; }\n    .main { grid-area: main; background: #60c080; }\n    .foot { grid-area: foot; background: #909090; }\n    /* a menu centered in its box in both directions */\n    .menu { display: grid; height: 76px; margin-top: 8px; gap: 6px; grid-template-columns: 120px; justify-content: center; align-content: center; background: #242a3c; }\n    .btn { height: 18px; border-radius: 4px; }\n    .b1 { background: #4060a0; } .b2 { background: #40a060; } .b3 { background: #a06040; }\n    /* one chip per cell: start, centered, end, and auto margins */\n    .cells { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 44px; gap: 4px; margin-top: 8px; }\n    .cell { display: grid; grid-template-columns: 1fr; grid-template-rows: 1fr; background: #242a3c; }\n    .chip { width: 18px; height: 14px; background: #c0a060; }\n    .start { justify-self: start; align-self: start; }\n    .mid { place-self: center; background: #8060c0; }\n    .end { justify-self: end; align-self: end; background: #60c0c0; }\n    .auto { margin: auto; background: #c06080; }";
const LINE0_Screen: int = 22;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

