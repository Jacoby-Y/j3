        let n12 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n12, this.cls_cell);
        let n13 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n13, this.cls_chip);
        d.clsId(n13, this.cls_start);
        d.close();
        d.close();
        let n14 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n14, this.cls_cell);
        let n15 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n15, this.cls_chip);
        d.clsId(n15, this.cls_mid);
        d.close();
