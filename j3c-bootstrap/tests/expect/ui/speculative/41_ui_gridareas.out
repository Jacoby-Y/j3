            cls_cell: 0,
            cls_chip: 0,
            cls_start: 0,
            cls_mid: 0,
            cls_end: 0,
            cls_auto: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_head = d.css.intern("head");
        this.cls_side = d.css.intern("side");
