// ---- ui/Row.j3ui
pub const SCOPE_Row: int = 1;
const CSS_Row: string = "";
const LINE0_Row: int = 0;

pub struct RowProps {
}

pub struct RowEvents {
    ping: bool;
    ping_n: int;
    ping_tag: string;
    ping_on: bool;
    mounted: bool;
    done: bool;
}

pub struct RowEvent_ping {
    n: int;
    tag: string;
    on: bool;
}

pub struct Row {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &RowProps;
    tag_div: int;
    tag_button: int;
    sev: RowEvents;

    fn new(mem: &Arena): Row {
        let ps = mem.alloc::<RowProps>(1);
        return Row {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_button: 0,
            sev: RowEvents { ping: false, ping_n: 0, ping_tag: "", ping_on: false, mounted: false, done: false },
        };
    }

    fn j3Reset(this: &Row) {
        let mem = this.mem;
        this.ready = false;
        this.sev = RowEvents { ping: false, ping_n: 0, ping_tag: "", ping_on: false, mounted: false, done: false };
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Row, "ui/Row.j3ui", SCOPE_Row, LINE0_Row);
    }

    fn init(this: &Row, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_button = d.tag("button");
    }

    fn send(this: &Row, n: int) {
 this.sev.ping_n = n; this.sev.ping_tag = "t"; this.sev.ping_on = true; this.sev.ping = true; 
    }

    fn finish(this: &Row) {
 this.sev.done = true; 
    }

    fn twice(this: &Row) {
 this.send(1); this.finish(); 
    }

    fn onMount(this: &Row) {
 this.sev.mounted = true; 
    }

    fn update(this: &Row, d: &Dom, p: RowProps): RowEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = RowEvents { ping: false, ping_n: 0, ping_tag: "", ping_on: false, mounted: false, done: false };
        let n1 = d.open(0, this.tag_div, SCOPE_Row);
        let n2 = d.open(0, this.tag_button, SCOPE_Row);
        if d.clicked(n2) {
            this.send(7);
        }
        d.text("a");
        d.close();
        let n3 = d.open(1, this.tag_button, SCOPE_Row);
        if d.clicked(n3) {
            this.twice();
        }
        d.text("b");
        d.close();
        let n4 = d.open(2, this.tag_button, SCOPE_Row);
        if d.clicked(n4) {
            this.send(9);
        }
        d.text("c");
        d.close();
        d.close();
        if mounting {
            this.onMount();
        }
        if this.sev.ping {
            ev.ping = true;
            ev.ping_n = this.sev.ping_n;
            ev.ping_tag = this.sev.ping_tag;
            ev.ping_on = this.sev.ping_on;
            this.sev.ping = false;
        }
        if this.sev.mounted {
            ev.mounted = true;
            this.sev.mounted = false;
        }
        if this.sev.done {
            ev.done = true;
            this.sev.done = false;
        }
        return ev;
    }

    fn destroy(this: &Row) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Row, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 2;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    c1: Row;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            c1: Row.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Row.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Row.j3ui", CSS_Row, 934918104, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 49114625, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, RowProps {  });
        d.leave(s2);
        if e2.ping {
            let evt2_ping = RowEvent_ping { n: e2.ping_n, tag: e2.ping_tag, on: e2.ping_on };
            state.sum += evt2_ping.n; state.pings += 1; if evt2_ping.on { state.ons += 1; } state.last = evt2_ping.tag;
        }
        if e2.done {
            state.dones += 1;
        }
        if e2.mounted {
            state.mounted += 1;
        }
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

