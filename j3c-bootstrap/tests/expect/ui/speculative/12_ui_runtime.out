// ---- ui/BallCard.j3ui
pub const SCOPE_BallCard: int = 1;
const CSS_BallCard: string = "    .card {\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n        padding: 12px;\n        background: var(--raised);\n        border-radius: var(--radius);\n        border: 1px solid transparent;\n        transition: border-color 150ms;\n    }\n    .card:hover { border-color: var(--accent); }\n    .card.locked { opacity: 0.7; }\n    .top { display: flex; justify-content: space-between; }\n    .name { font-weight: bold; }\n    .owned { color: var(--muted); }\n    .stats { display: flex; gap: 12px; font-size: 13px; color: var(--muted); }\n    button { margin-top: 4px; }\n    .price { color: var(--gold); }";
const LINE0_BallCard: int = 36;

pub struct BallCardProps {
    sim: &Sim;
    kind: int;
}

pub struct BallCardEvents {
}

pub struct BallCard {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &BallCardProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_span: int;
    tag_small: int;
    tag_button: int;
    cls_card: int;
    cls_locked: int;
    cls_top: int;
    cls_name: int;
    cls_owned: int;
    cls_stats: int;
    cls_price: int;

    fn new(mem: &Arena): BallCard {
        let ps = mem.alloc::<BallCardProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        BallCard.styles(css);
        return BallCard {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_span: 0,
            tag_small: 0,
            tag_button: 0,
            cls_card: 0,
            cls_locked: 0,
            cls_top: 0,
            cls_name: 0,
            cls_owned: 0,
            cls_stats: 0,
            cls_price: 0,
        };
    }

    fn j3Reset(this: &BallCard) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_BallCard, "ui/BallCard.j3ui", SCOPE_BallCard, LINE0_BallCard);
    }

    fn init(this: &BallCard, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_small = d.tag("small");
        this.tag_button = d.tag("button");
        this.cls_card = d.css.intern("card");
        this.cls_locked = d.css.intern("locked");
        this.cls_top = d.css.intern("top");
        this.cls_name = d.css.intern("name");
        this.cls_owned = d.css.intern("owned");
        this.cls_stats = d.css.intern("stats");
        this.cls_price = d.css.intern("price");
    }

    fn shop(this: &BallCard): &Shop {
        let kind = this.p.kind;
        let sim = this.p.sim;

        return &sim.shop[kind];
    
    }

    fn canBuy(this: &BallCard): bool {
        let sim = this.p.sim;

        return sim.gold >= this.shop().cost && sim.ballCount < MAX_BALLS;
    
    }

    fn render(this: &BallCard, size: Vec2, p: BallCardProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(BallCardPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &BallCard) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/BallCard.j3ui", CSS_BallCard, 25777024, true) {
            ch = true;
        }
        if hotFile(css, "ui/Game.j3ui", CSS_Game, 743613502, true) {
            ch = true;
        }
        if hotFile(css, "ui/Settings.j3ui", CSS_Settings, 648376370, true) {
            ch = true;
        }
        if hotFile(css, "ui/Sidebar.j3ui", CSS_Sidebar, 757831654, true) {
            ch = true;
        }
        if hotFile(css, "ui/UpgradeRow.j3ui", CSS_UpgradeRow, 272393029, true) {
            ch = true;
        }
        if hotFile(css, "ui/Upgrades.j3ui", CSS_Upgrades, 358349126, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            BallCard.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &BallCard, d: &Dom, p: BallCardProps): BallCardEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let kind = p.kind;
        let sim = p.sim;
        let ev = BallCardEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_BallCard);
        d.clsId(n1, this.cls_card);
        d.clsIfId(n1, this.cls_locked, !this.canBuy());
        let n2 = d.open(0, this.tag_div, SCOPE_BallCard);
        d.clsId(n2, this.cls_top);
        let n3 = d.open(0, this.tag_span, SCOPE_BallCard);
        d.clsId(n3, this.cls_name);
        d.text(`{this.shop().name}`);
        d.close();
        let n4 = d.open(1, this.tag_span, SCOPE_BallCard);
        d.clsId(n4, this.cls_owned);
        d.text(Text.scratch().add("x").add(`{this.shop().owned}`).str());
        d.close();
        d.close();
        let n5 = d.open(1, this.tag_small, SCOPE_BallCard);
        d.text(`{this.shop().blurb}`);
        d.close();
        let n6 = d.open(2, this.tag_div, SCOPE_BallCard);
        d.clsId(n6, this.cls_stats);
        let n7 = d.open(0, this.tag_span, SCOPE_BallCard);
        d.text(Text.scratch().add("dmg ").add(`{this.shop().damage}`).str());
        d.close();
        let n8 = d.open(1, this.tag_span, SCOPE_BallCard);
        d.text(Text.scratch().add("spd ").add(`{int(this.shop().speed)}`).str());
        d.close();
        d.close();
        let n9 = d.open(3, this.tag_button, SCOPE_BallCard);
        d.attrDisabled(n9, !this.canBuy());
        if d.clicked(n9) {
            sim.buyBall(kind);
        }
        d.text("Buy · ");
        let n10 = d.open(0, this.tag_span, SCOPE_BallCard);
        d.clsId(n10, this.cls_price);
        d.text(`{this.shop().cost}`);
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &BallCard) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &BallCard, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n5 = d.paintNext(1);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n6 = d.paintNext(2);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        let n7 = d.paintNext(0);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        let n8 = d.paintNext(1);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n9 = d.paintNext(3);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        let n10 = d.paintNext(0);
                        if n10 >= 0 {
                            d.paintBox(n10);
                            let pass10 = 0;
                            while d.paintChildren(pass10) {
                                pass10 += 1;
                            }
                            d.paintEnd(n10);
                        }
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn BallCardPaintHook(p: ptr) {
    let r = p as &BallCard;
    r.paint(&r.dom);
}

// ---- ui/Game.j3ui
pub const SCOPE_Game: int = 2;
const CSS_Game: string = "    .app { display: flex; height: 100%; background: var(--bg); }\n    /* min-width: 0 so content can't push the halves off 50/50. */\n    .field { flex: 1; min-width: 0; position: relative; }\n    .half { flex: 1; min-width: 0; }\n\n    .hud {\n        position: absolute;\n        left: 12px;\n        bottom: 12px;\n        display: flex;\n        gap: 12px;\n        padding: 6px 12px;\n        background: rgba(17, 17, 27, 0.7);\n        border-radius: var(--radius);\n        font-size: 13px;\n        color: var(--muted);\n    }\n    .level { color: var(--text); font-weight: bold; }\n\n    .paused {\n        position: absolute;\n        inset: 0;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        gap: 12px;\n        background: rgba(17, 17, 27, 0.6);\n    }";
const LINE0_Game: int = 42;

pub struct GameProps {
    sim: &Sim;
    font: Font;
}

pub struct GameEvents {
}

pub struct Game {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &GameProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_canvas: int;
    tag_span: int;
    tag_h1: int;
    tag_button: int;
    cls_app: int;
    cls_field: int;
    cls_hud: int;
    cls_level: int;
    cls_paused: int;
    cls_half: int;
    c1: Sidebar;

    fn new(mem: &Arena): Game {
        let ps = mem.alloc::<GameProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Game.styles(css);
        return Game {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_canvas: 0,
            tag_span: 0,
            tag_h1: 0,
            tag_button: 0,
            cls_app: 0,
            cls_field: 0,
            cls_hud: 0,
            cls_level: 0,
            cls_paused: 0,
            cls_half: 0,
            c1: Sidebar.new(mem),
        };
    }

    fn j3Reset(this: &Game) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Game, "ui/Game.j3ui", SCOPE_Game, LINE0_Game);
        Sidebar.styles(css);
    }

    fn init(this: &Game, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_canvas = d.tag("canvas");
        this.tag_span = d.tag("span");
        this.tag_h1 = d.tag("h1");
        this.tag_button = d.tag("button");
        this.cls_app = d.css.intern("app");
        this.cls_field = d.css.intern("field");
        this.cls_hud = d.css.intern("hud");
        this.cls_level = d.css.intern("level");
        this.cls_paused = d.css.intern("paused");
        this.cls_half = d.css.intern("half");
    }

    fn render(this: &Game, size: Vec2, p: GameProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(GamePaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Game) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/BallCard.j3ui", CSS_BallCard, 25777024, true) {
            ch = true;
        }
        if hotFile(css, "ui/Game.j3ui", CSS_Game, 743613502, true) {
            ch = true;
        }
        if hotFile(css, "ui/Settings.j3ui", CSS_Settings, 648376370, true) {
            ch = true;
        }
        if hotFile(css, "ui/Sidebar.j3ui", CSS_Sidebar, 757831654, true) {
            ch = true;
        }
        if hotFile(css, "ui/UpgradeRow.j3ui", CSS_UpgradeRow, 272393029, true) {
            ch = true;
        }
        if hotFile(css, "ui/Upgrades.j3ui", CSS_Upgrades, 358349126, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Game.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Game, d: &Dom, p: GameProps): GameEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let sim = p.sim;
        let ev = GameEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Game);
        d.clsId(n1, this.cls_app);
        let n2 = d.open(0, this.tag_canvas, SCOPE_Game);
        d.clsId(n2, this.cls_field);
        if d.mouseDown(n2) {
            let mouse_n2_mousedown = d.localMouse(n2);
            let button_n2_mousedown = d.downBtn;
            let size_n2_mousedown = d.size(n2);
            sim.click(field.view(size_n2_mousedown).toField(mouse_n2_mousedown));
        }
        let n3 = d.open(0, this.tag_div, SCOPE_Game);
        d.clsId(n3, this.cls_hud);
        d.attrFlag(n3, 8);
        if d.mouseDown(n3) {
            let mouse_n3_mousedown = d.localMouse(n3);
            let button_n3_mousedown = d.downBtn;
        }
        let n4 = d.open(0, this.tag_span, SCOPE_Game);
        d.clsId(n4, this.cls_level);
        d.text(Text.scratch().add("Level ").add(`{sim.level}`).str());
        d.close();
        let n5 = d.open(1, this.tag_span, SCOPE_Game);
        d.text(Text.scratch().add(`{sim.alive}`).add(" bricks").str());
        d.close();
        d.close();
        if sim.paused {
            let n6 = d.open(1, this.tag_div, SCOPE_Game);
            d.trans(n6, 1, f32(150), 1, f32(150), -1, 0.0, 20.0, 0.5, 0);
            d.clsId(n6, this.cls_paused);
            d.attrFlag(n6, 8);
            if d.mouseDown(n6) {
                let mouse_n6_mousedown = d.localMouse(n6);
                let button_n6_mousedown = d.downBtn;
            }
            let n7 = d.open(0, this.tag_h1, SCOPE_Game);
            d.text("Paused");
            d.close();
            let n8 = d.open(1, this.tag_button, SCOPE_Game);
            if d.clicked(n8) {
                sim.paused = false;
            }
            d.text("Resume");
            d.close();
            d.close();
        }
        d.close();
        let n9 = d.open(1, this.tag_div, SCOPE_Game);
        d.clsId(n9, this.cls_half);
        let s10 = d.enter(0);
        let e10 = this.c1.update(d, SidebarProps { sim: sim });
        d.leave(s10);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Game) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
    }

    fn paint(this: &Game, d: &Dom) {
        let font = this.p.font;
        let sim = this.p.sim;
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    if d.beginCanvas(n2) {
                        let size2 = d.size(n2);
                        field.draw(sim, field.view(size2), font);
                        d.endCanvas(n2);
                    }
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                let n4 = d.paintNext(0);
                                if n4 >= 0 {
                                    d.paintBox(n4);
                                    let pass4 = 0;
                                    while d.paintChildren(pass4) {
                                        pass4 += 1;
                                    }
                                    d.paintEnd(n4);
                                }
                                let n5 = d.paintNext(1);
                                if n5 >= 0 {
                                    d.paintBox(n5);
                                    let pass5 = 0;
                                    while d.paintChildren(pass5) {
                                        pass5 += 1;
                                    }
                                    d.paintEnd(n5);
                                }
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n6 = d.paintNext(1);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                let n7 = d.paintNext(0);
                                if n7 >= 0 {
                                    d.paintBox(n7);
                                    let pass7 = 0;
                                    while d.paintChildren(pass7) {
                                        pass7 += 1;
                                    }
                                    d.paintEnd(n7);
                                }
                                let n8 = d.paintNext(1);
                                if n8 >= 0 {
                                    d.paintBox(n8);
                                    let pass8 = 0;
                                    while d.paintChildren(pass8) {
                                        pass8 += 1;
                                    }
                                    d.paintEnd(n8);
                                }
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n9 = d.paintNext(1);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        let s10 = d.enter(0);
                        this.c1.paint(d);
                        d.leave(s10);
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn GamePaintHook(p: ptr) {
    let r = p as &Game;
    r.paint(&r.dom);
}

// ---- ui/Settings.j3ui
pub const SCOPE_Settings: int = 3;
const CSS_Settings: string = "    .list { display: flex; flex-direction: column; gap: var(--gap); }\n    label {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        padding: 10px 14px;\n        background: var(--raised);\n        border-radius: var(--radius);\n    }\n    label:hover { background: var(--hover); }\n    label span:first-child { flex: 1; }\n    input[type=\"range\"] { width: 140px; accent-color: var(--accent); }\n    .val { min-width: 36px; text-align: right; color: var(--muted); }";
const LINE0_Settings: int = 27;

pub struct SettingsProps {
    sim: &Sim;
}

pub struct SettingsEvents {
}

pub struct Settings {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &SettingsProps;
    tag_div: int;
    tag_label: int;
    tag_span: int;
    tag_input: int;
    cls_list: int;
    cls_val: int;

    fn new(mem: &Arena): Settings {
        let ps = mem.alloc::<SettingsProps>(1);
        return Settings {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_label: 0,
            tag_span: 0,
            tag_input: 0,
            cls_list: 0,
            cls_val: 0,
        };
    }

    fn j3Reset(this: &Settings) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Settings, "ui/Settings.j3ui", SCOPE_Settings, LINE0_Settings);
    }

    fn init(this: &Settings, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_label = d.tag("label");
        this.tag_span = d.tag("span");
        this.tag_input = d.tag("input");
        this.cls_list = d.css.intern("list");
        this.cls_val = d.css.intern("val");
    }

    fn update(this: &Settings, d: &Dom, p: SettingsProps): SettingsEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let sim = p.sim;
        let ev = SettingsEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Settings);
        d.clsId(n1, this.cls_list);
        let n2 = d.open(0, this.tag_label, SCOPE_Settings);
        let n3 = d.open(0, this.tag_span, SCOPE_Settings);
        d.text("Paused");
        d.close();
        let n4 = d.open(1, this.tag_input, SCOPE_Settings);
        d.attrType(n4, "checkbox");
        if d.clicked(n4) {
            sim.paused = !sim.paused;
        }
        d.attrChecked(n4, sim.paused);
        d.close();
        d.close();
        let n5 = d.open(1, this.tag_label, SCOPE_Settings);
        let n6 = d.open(0, this.tag_span, SCOPE_Settings);
        d.text("Game speed");
        d.close();
        let n7 = d.open(1, this.tag_input, SCOPE_Settings);
        d.attrType(n7, "range");
        d.attrMin(n7, f32(0.5));
        d.attrMax(n7, f32(4));
        d.attrStep(n7, f32(0.5));
        if d.changed(n7) {
            sim.timeScale = d.value(n7);
        }
        d.attrValue(n7, sim.timeScale);
        d.close();
        let n8 = d.open(2, this.tag_span, SCOPE_Settings);
        d.clsId(n8, this.cls_val);
        d.text(Text.scratch().add(`{sim.timeScale}`).add("x").str());
        d.close();
        d.close();
        let n9 = d.open(2, this.tag_label, SCOPE_Settings);
        let n10 = d.open(0, this.tag_span, SCOPE_Settings);
        d.text("Show brick HP");
        d.close();
        let n11 = d.open(1, this.tag_input, SCOPE_Settings);
        d.attrType(n11, "checkbox");
        if d.clicked(n11) {
            sim.showHp = !sim.showHp;
        }
        d.attrChecked(n11, sim.showHp);
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Settings) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Settings, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n5 = d.paintNext(1);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        let n6 = d.paintNext(0);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        let n7 = d.paintNext(1);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        let n8 = d.paintNext(2);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n9 = d.paintNext(2);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        let n10 = d.paintNext(0);
                        if n10 >= 0 {
                            d.paintBox(n10);
                            let pass10 = 0;
                            while d.paintChildren(pass10) {
                                pass10 += 1;
                            }
                            d.paintEnd(n10);
                        }
                        let n11 = d.paintNext(1);
                        if n11 >= 0 {
                            d.paintBox(n11);
                            let pass11 = 0;
                            while d.paintChildren(pass11) {
                                pass11 += 1;
                            }
                            d.paintEnd(n11);
                        }
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Sidebar.j3ui
pub const SCOPE_Sidebar: int = 4;
const CSS_Sidebar: string = "    .side {\n        display: flex;\n        flex-direction: column;\n        height: 100%;\n        background: var(--panel);\n        border-left: 1px solid var(--line);\n    }\n    header {\n        display: flex;\n        justify-content: space-between;\n        align-items: baseline;\n        padding: 16px 20px;\n    }\n    .wallet { display: flex; gap: 16px; }\n    .gold { font-size: 24px; font-weight: bold; color: var(--gold); }\n    .crystal { font-size: 18px; color: var(--crystal); }\n\n    nav {\n        display: flex;\n        gap: 4px;\n        padding: 0 16px;\n        border-bottom: 1px solid var(--line);\n    }\n    nav button {\n        flex: 1;\n        background: transparent;\n        border-radius: var(--radius) var(--radius) 0 0;\n        color: var(--muted);\n    }\n    nav button:hover { background: transparent; color: var(--text); }\n    nav button.active {\n        background: var(--raised);\n        color: var(--text);\n        border-bottom: 2px solid var(--accent);\n    }\n\n    /* min-height: 0 or a flex child grows to its content and never scrolls. */\n    main {\n        flex: 1;\n        min-height: 0;\n        overflow-y: auto;\n        padding: 16px 20px;\n    }";
const LINE0_Sidebar: int = 49;

pub struct SidebarProps {
    sim: &Sim;
}

pub struct SidebarEvents {
}

pub struct Sidebar {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &SidebarProps;
    tab: int;
    tag_div: int;
    tag_header: int;
    tag_span: int;
    tag_small: int;
    tag_nav: int;
    tag_button: int;
    tag_main: int;
    cls_side: int;
    cls_wallet: int;
    cls_gold: int;
    cls_crystal: int;
    cls_active: int;
    c1: Upgrades;
    c2: Settings;
    if1: int;
    cnt1: int;

    fn new(mem: &Arena): Sidebar {
        let ps = mem.alloc::<SidebarProps>(1);
        return Sidebar {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tab: 0,
            tag_div: 0,
            tag_header: 0,
            tag_span: 0,
            tag_small: 0,
            tag_nav: 0,
            tag_button: 0,
            tag_main: 0,
            cls_side: 0,
            cls_wallet: 0,
            cls_gold: 0,
            cls_crystal: 0,
            cls_active: 0,
            c1: Upgrades.new(mem),
            c2: Settings.new(mem),
            if1: -1,
            cnt1: 0,
        };
    }

    fn j3Reset(this: &Sidebar) {
        let mem = this.mem;
        this.ready = false;
        this.tab = 0;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.if1 = -1;
        this.cnt1 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Sidebar, "ui/Sidebar.j3ui", SCOPE_Sidebar, LINE0_Sidebar);
        Upgrades.styles(css);
        Settings.styles(css);
    }

    fn init(this: &Sidebar, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_header = d.tag("header");
        this.tag_span = d.tag("span");
        this.tag_small = d.tag("small");
        this.tag_nav = d.tag("nav");
        this.tag_button = d.tag("button");
        this.tag_main = d.tag("main");
        this.cls_side = d.css.intern("side");
        this.cls_wallet = d.css.intern("wallet");
        this.cls_gold = d.css.intern("gold");
        this.cls_crystal = d.css.intern("crystal");
        this.cls_active = d.css.intern("active");
    }

    fn tabName(this: &Sidebar, i: int): string {

        let names: [3]string = ["Upgrades", "Settings", "Stats"];
        return names[i];
    
    }

    fn update(this: &Sidebar, d: &Dom, p: SidebarProps): SidebarEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let sim = p.sim;
        let ev = SidebarEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Sidebar);
        d.clsId(n1, this.cls_side);
        let n2 = d.open(0, this.tag_header, SCOPE_Sidebar);
        let n3 = d.open(0, this.tag_div, SCOPE_Sidebar);
        d.clsId(n3, this.cls_wallet);
        let n4 = d.open(0, this.tag_span, SCOPE_Sidebar);
        d.clsId(n4, this.cls_gold);
        d.text(Text.scratch().add(`{sim.gold}`).add(" gold").str());
        d.close();
        if sim.crystals > 0 {
            let n5 = d.open(1, this.tag_span, SCOPE_Sidebar);
            d.clsId(n5, this.cls_crystal);
            d.text(Text.scratch().add(`{sim.crystals}`).add(" crystals").str());
            d.close();
        }
        d.close();
        let n6 = d.open(1, this.tag_small, SCOPE_Sidebar);
        d.text(Text.scratch().add("Level ").add(`{sim.level}`).add(" · ").add(`{sim.dps}`).add(" dmg/s").str());
        d.close();
        d.close();
        let n7 = d.open(1, this.tag_nav, SCOPE_Sidebar);
        let s8 = d.enter(0);
        let m8 = 3;
        this.cnt1 = m8;
        for i in 0..m8 {
            let n9 = d.open(i * 1 + 0, this.tag_button, SCOPE_Sidebar);
            d.clsIfId(n9, this.cls_active, this.tab == i);
            if d.clicked(n9) {
                this.tab = i;
            }
            d.text(`{this.tabName(i)}`);
            d.close();
        }
        d.leave(s8);
        d.close();
        let n10 = d.open(2, this.tag_main, SCOPE_Sidebar);
        let b11 = -1;
        if this.tab == 0 {
            b11 = 0;
        } else if this.tab == 1 {
            b11 = 1;
        } else {
            b11 = 2;
        }
        if b11 != this.if1 {
            if this.if1 == 0 {
                this.c1.destroy();
            } else if this.if1 == 1 {
                this.c2.destroy();
            }
            this.if1 = b11;
            if b11 == 0 {
                this.c1.j3Reset();
            } else if b11 == 1 {
                this.c2.j3Reset();
            }
        }
        if b11 == 0 {
            let s12 = d.enter(0);
            let e12 = this.c1.update(d, UpgradesProps { sim: sim });
            d.leave(s12);
        } else if b11 == 1 {
            let s13 = d.enter(1);
            let e13 = this.c2.update(d, SettingsProps { sim: sim });
            d.leave(s13);
        } else if b11 == 2 {
            let n14 = d.open(2, this.tag_small, SCOPE_Sidebar);
            d.text("Nothing here yet.");
            d.close();
        }
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Sidebar) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c2.destroy();
        this.ready = false;
    }

    fn paint(this: &Sidebar, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                let n4 = d.paintNext(0);
                                if n4 >= 0 {
                                    d.paintBox(n4);
                                    let pass4 = 0;
                                    while d.paintChildren(pass4) {
                                        pass4 += 1;
                                    }
                                    d.paintEnd(n4);
                                }
                                let n5 = d.paintNext(1);
                                if n5 >= 0 {
                                    d.paintBox(n5);
                                    let pass5 = 0;
                                    while d.paintChildren(pass5) {
                                        pass5 += 1;
                                    }
                                    d.paintEnd(n5);
                                }
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n6 = d.paintNext(1);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n7 = d.paintNext(1);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        let s8 = d.enter(0);
                        let m8 = this.cnt1;
                        for i in 0..m8 {
                            let n9 = d.paintNext(i * 1 + 0);
                            if n9 >= 0 {
                                d.paintBox(n9);
                                let pass9 = 0;
                                while d.paintChildren(pass9) {
                                    pass9 += 1;
                                }
                                d.paintEnd(n9);
                            }
                        }
                        d.leave(s8);
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n10 = d.paintNext(2);
                if n10 >= 0 {
                    d.paintBox(n10);
                    let pass10 = 0;
                    while d.paintChildren(pass10) {
                        let s12 = d.enter(0);
                        this.c1.paint(d);
                        d.leave(s12);
                        let s13 = d.enter(1);
                        this.c2.paint(d);
                        d.leave(s13);
                        let n14 = d.paintNext(2);
                        if n14 >= 0 {
                            d.paintBox(n14);
                            let pass14 = 0;
                            while d.paintChildren(pass14) {
                                pass14 += 1;
                            }
                            d.paintEnd(n14);
                        }
                        pass10 += 1;
                    }
                    d.paintEnd(n10);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/UpgradeRow.j3ui
pub const SCOPE_UpgradeRow: int = 5;
const CSS_UpgradeRow: string = "    .row {\n        display: flex;\n        align-items: center;\n        gap: 12px;\n        padding: 8px 12px;\n        background: var(--raised);\n        border-radius: var(--radius);\n    }\n    .label { flex: 1; }\n    .value { color: var(--good); min-width: 48px; text-align: right; }\n    button { min-width: 90px; color: var(--gold); }";
const LINE0_UpgradeRow: int = 24;

pub struct UpgradeRowProps {
    label: string;
    value: int;
    cost: int;
    gold: int;
}

pub struct UpgradeRowEvents {
    buy: bool;
}

pub struct UpgradeRow {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &UpgradeRowProps;
    tag_div: int;
    tag_span: int;
    tag_button: int;
    cls_row: int;
    cls_label: int;
    cls_value: int;

    fn new(mem: &Arena): UpgradeRow {
        let ps = mem.alloc::<UpgradeRowProps>(1);
        return UpgradeRow {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_span: 0,
            tag_button: 0,
            cls_row: 0,
            cls_label: 0,
            cls_value: 0,
        };
    }

    fn j3Reset(this: &UpgradeRow) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_UpgradeRow, "ui/UpgradeRow.j3ui", SCOPE_UpgradeRow, LINE0_UpgradeRow);
    }

    fn init(this: &UpgradeRow, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_button = d.tag("button");
        this.cls_row = d.css.intern("row");
        this.cls_label = d.css.intern("label");
        this.cls_value = d.css.intern("value");
    }

    fn update(this: &UpgradeRow, d: &Dom, p: UpgradeRowProps): UpgradeRowEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let cost = p.cost;
        let gold = p.gold;
        let label = p.label;
        let value = p.value;
        let ev = UpgradeRowEvents { buy: false };
        let n1 = d.open(0, this.tag_div, SCOPE_UpgradeRow);
        d.clsId(n1, this.cls_row);
        let n2 = d.open(0, this.tag_span, SCOPE_UpgradeRow);
        d.clsId(n2, this.cls_label);
        d.text(`{label}`);
        d.close();
        let n3 = d.open(1, this.tag_span, SCOPE_UpgradeRow);
        d.clsId(n3, this.cls_value);
        d.text(`{value}`);
        d.close();
        let n4 = d.open(2, this.tag_button, SCOPE_UpgradeRow);
        d.attrDisabled(n4, gold < cost);
        if d.clicked(n4) {
            ev.buy = true;
        }
        d.text(`{cost}`);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &UpgradeRow) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &UpgradeRow, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Upgrades.j3ui
pub const SCOPE_Upgrades: int = 6;
const CSS_Upgrades: string = "    section {\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n        margin-bottom: 18px;\n    }";
const LINE0_Upgrades: int = 50;

pub struct UpgradesProps {
    sim: &Sim;
}

pub struct UpgradesEvents {
}

struct Upgrades_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c2: UpgradeRow;
    c3: UpgradeRow;
    if1: int;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Upgrades_R1 {
        let a = mem.alloc::<Upgrades_R1>(1);
        a[0] = Upgrades_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c2: UpgradeRow.new(mem),
            c3: UpgradeRow.new(mem),
            if1: -1,
        };
        return &a[0];
    }

    fn reset(this: &Upgrades_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c2.j3Reset();
        this.c3.j3Reset();
        this.if1 = -1;
    }

    fn take(pool: &List<&Upgrades_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Upgrades_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Upgrades_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Upgrades_R1) {
        this.c2.destroy();
        this.c3.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Upgrades {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &UpgradesProps;
    tag_section: int;
    tag_h2: int;
    tag_small: int;
    c1: UpgradeRow;
    cnt1: int;
    e1: List<&Upgrades_R1>;
    fp1: List<&Upgrades_R1>;

    fn new(mem: &Arena): Upgrades {
        let ps = mem.alloc::<UpgradesProps>(1);
        return Upgrades {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_section: 0,
            tag_h2: 0,
            tag_small: 0,
            c1: UpgradeRow.new(mem),
            cnt1: 0,
            e1: List<&Upgrades_R1>.new(mem),
            fp1: List<&Upgrades_R1>.new(mem),
        };
    }

    fn j3Reset(this: &Upgrades) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Upgrades, "ui/Upgrades.j3ui", SCOPE_Upgrades, LINE0_Upgrades);
        UpgradeRow.styles(css);
    }

    fn init(this: &Upgrades, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_section = d.tag("section");
        this.tag_h2 = d.tag("h2");
        this.tag_small = d.tag("small");
    }

    fn anyOwned(this: &Upgrades): bool {
        let sim = this.p.sim;

        return sim.ballCount > 0;
    
    }

    fn update(this: &Upgrades, d: &Dom, p: UpgradesProps): UpgradesEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let sim = p.sim;
        let ev = UpgradesEvents {  };
        let n1 = d.open(0, this.tag_section, SCOPE_Upgrades);
        let n2 = d.open(0, this.tag_h2, SCOPE_Upgrades);
        d.text("Click");
        d.close();
        let s3 = d.enter(1);
        let e3 = this.c1.update(d, UpgradeRowProps { label: "Click damage", value: sim.clickDamage, cost: sim.clickCost, gold: sim.gold });
        d.leave(s3);
        if e3.buy {
            sim.upgradeClick();
        }
        d.close();
        let s4 = d.enter(1);
        let m4 = KINDS;
        this.cnt1 = m4;
        while this.e1.len < m4 { this.e1.push(Upgrades_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m4 {
            for zq4 in m4..this.e1.len { this.e1.items[zq4].destroy(); this.fp1.push(this.e1.items[zq4]); }
            this.e1.len = m4;
        }
        for k in 0..m4 {
            let r1 = this.e1.items[k];
            let b5 = -1;
            if sim.shop[k].owned > 0 {
                b5 = 0;
            }
            if b5 != r1.if1 {
                if r1.if1 == 0 {
                    r1.c2.destroy();
                    r1.c3.destroy();
                }
                r1.if1 = b5;
                if b5 == 0 {
                    r1.c2.j3Reset();
                    r1.c3.j3Reset();
                }
            }
            if b5 == 0 {
                let n6 = d.open(k * 1 + 0, this.tag_section, SCOPE_Upgrades);
                let n7 = d.open(0, this.tag_h2, SCOPE_Upgrades);
                d.text(`{sim.shop[k].name}`);
                d.close();
                let s8 = d.enter(1);
                let e8 = r1.c2.update(d, UpgradeRowProps { label: Text.scratch().add("Damage · lv ").add(`{sim.shop[k].damageLvl}`).str(), value: sim.shop[k].damage, cost: sim.shop[k].damageCost, gold: sim.gold });
                d.leave(s8);
                if e8.buy {
                    sim.upgradeDamage(k);
                }
                let s9 = d.enter(2);
                let e9 = r1.c3.update(d, UpgradeRowProps { label: Text.scratch().add("Speed · lv ").add(`{sim.shop[k].speedLvl}`).str(), value: int(sim.shop[k].speed), cost: sim.shop[k].speedCost, gold: sim.gold });
                d.leave(s9);
                if e9.buy {
                    sim.upgradeSpeed(k);
                }
                d.close();
            }
        }
        d.leave(s4);
        if !this.anyOwned() {
            let n10 = d.open(2, this.tag_small, SCOPE_Upgrades);
            d.text("Buy a ball to unlock its upgrades.");
            d.close();
        }
        return ev;
    }

    fn destroy(this: &Upgrades) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Upgrades, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let s3 = d.enter(1);
                this.c1.paint(d);
                d.leave(s3);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
        let s4 = d.enter(1);
        let m4 = this.cnt1;
        for k in 0..m4 {
            let r1 = this.e1.items[k];
            let n6 = d.paintNext(k * 1 + 0);
            if n6 >= 0 {
                d.paintBox(n6);
                let pass6 = 0;
                while d.paintChildren(pass6) {
                    let n7 = d.paintNext(0);
                    if n7 >= 0 {
                        d.paintBox(n7);
                        let pass7 = 0;
                        while d.paintChildren(pass7) {
                            pass7 += 1;
                        }
                        d.paintEnd(n7);
                    }
                    let s8 = d.enter(1);
                    r1.c2.paint(d);
                    d.leave(s8);
                    let s9 = d.enter(2);
                    r1.c3.paint(d);
                    d.leave(s9);
                    pass6 += 1;
                }
                d.paintEnd(n6);
            }
        }
        d.leave(s4);
        let n10 = d.paintNext(2);
        if n10 >= 0 {
            d.paintBox(n10);
            let pass10 = 0;
            while d.paintChildren(pass10) {
                pass10 += 1;
            }
            d.paintEnd(n10);
        }
    }
}

