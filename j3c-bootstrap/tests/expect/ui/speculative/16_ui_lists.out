pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_section: int;
    tag_small: int;
    tag_p: int;
    tag_span: int;
    tag_h2: int;
    cls_rows: int;
    cls_groups: int;
    cls_outer: int;
    cls_mixed: int;
    cls_row: int;
    cls_gated: int;
    cls_cards: int;
    cls_fades: int;
    if1: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;
    cnt2: int;
    e2: List<&Screen_R2>;
    fp2: List<&Screen_R2>;
    eb2: List<&Screen_R2>;
    kd2: Keyed;
    cnt4: int;
    e4: List<&Screen_R4>;
    fp4: List<&Screen_R4>;
    cnt6: int;
    e6: List<&Screen_R6>;
    fp6: List<&Screen_R6>;
    eb6: List<&Screen_R6>;
    kd6: Keyed;
    cnt7: int;
    e7: List<&Screen_R7>;
    fp7: List<&Screen_R7>;
    eb7: List<&Screen_R7>;
    kd7: Keyed;
    cnt8: int;
    e8: List<&Screen_R8>;
    fp8: List<&Screen_R8>;
    eb8: List<&Screen_R8>;
    kd8: Keyed;
    cnt9: int;
    e9: List<&Screen_R9>;
    fp9: List<&Screen_R9>;
    eb9: List<&Screen_R9>;
    kd9: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_section: 0,
            tag_small: 0,
            tag_p: 0,
            tag_span: 0,
            tag_h2: 0,
            cls_rows: 0,
            cls_groups: 0,
            cls_outer: 0,
            cls_mixed: 0,
            cls_row: 0,
            cls_gated: 0,
            cls_cards: 0,
            cls_fades: 0,
            if1: -1,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
            cnt2: 0,
            e2: List<&Screen_R2>.new(mem),
            fp2: List<&Screen_R2>.new(mem),
            eb2: List<&Screen_R2>.new(mem),
            kd2: Keyed.new(mem),
            cnt4: 0,
            e4: List<&Screen_R4>.new(mem),
            fp4: List<&Screen_R4>.new(mem),
            cnt6: 0,
            e6: List<&Screen_R6>.new(mem),
            fp6: List<&Screen_R6>.new(mem),
            eb6: List<&Screen_R6>.new(mem),
            kd6: Keyed.new(mem),
            cnt7: 0,
            e7: List<&Screen_R7>.new(mem),
            fp7: List<&Screen_R7>.new(mem),
            eb7: List<&Screen_R7>.new(mem),
            kd7: Keyed.new(mem),
            cnt8: 0,
            e8: List<&Screen_R8>.new(mem),
            fp8: List<&Screen_R8>.new(mem),
            eb8: List<&Screen_R8>.new(mem),
            kd8: Keyed.new(mem),
            cnt9: 0,
            e9: List<&Screen_R9>.new(mem),
            fp9: List<&Screen_R9>.new(mem),
            eb9: List<&Screen_R9>.new(mem),
            kd9: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.if1 = -1;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
        this.cnt2 = 0;
        for q2 in 0..this.e2.len {
            this.fp2.push(this.e2.items[q2]);
        }
        this.e2.len = 0;
        this.eb2.len = 0;
        this.kd2.reset();
        this.cnt4 = 0;
        for q4 in 0..this.e4.len {
            this.fp4.push(this.e4.items[q4]);
        }
        this.e4.len = 0;
        this.cnt6 = 0;
        for q6 in 0..this.e6.len {
            this.fp6.push(this.e6.items[q6]);
        }
        this.e6.len = 0;
        this.eb6.len = 0;
        this.kd6.reset();
        this.cnt7 = 0;
        for q7 in 0..this.e7.len {
            this.fp7.push(this.e7.items[q7]);
        }
        this.e7.len = 0;
        this.eb7.len = 0;
        this.kd7.reset();
