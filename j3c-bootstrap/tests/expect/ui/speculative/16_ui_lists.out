// ---- ui/Card.j3ui
pub const SCOPE_Card: int = 1;
const CSS_Card: string = "";
const LINE0_Card: int = 0;

pub struct CardProps {
}

pub struct CardEvents {
}

pub struct Card {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &CardProps;
    tag_div: int;
    cls_card: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow2: bool;
    slotWas2: bool;

    fn new(mem: &Arena): Card {
        let ps = mem.alloc::<CardProps>(1);
        return Card {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            cls_card: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow2: false, slotWas2: false,
        };
    }

    fn j3Reset(this: &Card) {
        let mem = this.mem;
        this.ready = false;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow2 = false;
        this.slotWas2 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Card, "ui/Card.j3ui", SCOPE_Card, LINE0_Card);
    }

    fn init(this: &Card, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_card = d.css.intern("card");
    }

    fn update(this: &Card, d: &Dom, p: CardProps): CardEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = CardEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Card);
        d.clsId(n1, this.cls_card);
        let s2 = d.enter(0);
        this.slotNow2 = true;
        if this.slotSite == 1 {
            ((this.slotOwn as ptr) as &Screen).slot1_default_update(d, this.slotI);
        } else {
        }
        d.leave(s2);
        d.close();
        if this.slotWas2 && !this.slotNow2 {
            if this.slotSite == 1 {
                ((this.slotOwn as ptr) as &Screen).slot1_default_leave(d, this.slotI);
            }
        }
        this.slotWas2 = this.slotNow2;
        this.slotNow2 = false;
        return ev;
    }

    fn destroy(this: &Card) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Card, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                if this.slotSite == 1 {
                    ((this.slotOwn as ptr) as &Screen).slot1_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Card): bool {
        return this.slotSite == 1;
    }
}

// ---- ui/Row.j3ui
pub const SCOPE_Row: int = 2;
const CSS_Row: string = "";
const LINE0_Row: int = 0;

pub struct RowProps {
    state: &State;
    item: Item;
}

pub struct RowEvents {
}

pub struct Row {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &RowProps;
    born: int;
    tag_p: int;
    tag_small: int;
    tag_span: int;
    cls_row: int;

    fn new(mem: &Arena): Row {
        let ps = mem.alloc::<RowProps>(1);
        return Row {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            born: 0,
            tag_p: 0,
            tag_small: 0,
            tag_span: 0,
            cls_row: 0,
        };
    }

    fn j3Reset(this: &Row) {
        let mem = this.mem;
        this.ready = false;
        this.born = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Row, "ui/Row.j3ui", SCOPE_Row, LINE0_Row);
    }

    fn init(this: &Row, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_p = d.tag("p");
        this.tag_small = d.tag("small");
        this.tag_span = d.tag("span");
        this.cls_row = d.css.intern("row");
    }

    fn onMount(this: &Row) {
        let state = this.p.state;
 state.nextBirth += 1; this.born = state.nextBirth; state.mounts += 1; 
    }

    fn onFrame(this: &Row, dt: f32) {
        let item = this.p.item;
        let state = this.p.state;
 state.birth[item.id] = this.born; 
    }

    fn onDestroy(this: &Row) {
        let state = this.p.state;
 state.destroys += 1; 
    }

    fn update(this: &Row, d: &Dom, p: RowProps): RowEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let item = p.item;
        let ev = RowEvents {  };
        this.onFrame(d.dt());
        let n1 = d.open(0, this.tag_p, SCOPE_Row);
        d.clsId(n1, this.cls_row);
        if item.id % 2 == 0 {
            let n2 = d.open(0, this.tag_small, SCOPE_Row);
            d.text("e");
            d.close();
        }
        let n3 = d.open(1, this.tag_span, SCOPE_Row);
        d.text(`{item.name}`);
        d.close();
        d.close();
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Row) {
        if !this.ready {
            return;
        }
        this.onDestroy();
        this.ready = false;
    }

    fn paint(this: &Row, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 3;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c1: Row;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c1: Row.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c1.j3Reset();
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        this.c1.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

struct Screen_R2 {
    uid: int;
    comp: int;
    dom: &Dom;
    cnt3: int;
    e3: List<&Screen_R3>;
    fp3: List<&Screen_R3>;
    eb3: List<&Screen_R3>;
    kd3: Keyed;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        let a = mem.alloc::<Screen_R2>(1);
        a[0] = Screen_R2 {
            uid: uid,
            comp: comp,
            dom: d,
            cnt3: 0,
            e3: List<&Screen_R3>.new(mem),
            fp3: List<&Screen_R3>.new(mem),
            eb3: List<&Screen_R3>.new(mem),
            kd3: Keyed.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R2, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.cnt3 = 0;
        for q3 in 0..this.e3.len {
            this.fp3.push(this.e3.items[q3]);
        }
        this.e3.len = 0;
        this.eb3.len = 0;
        this.kd3.reset();
    }

    fn take(pool: &List<&Screen_R2>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R2 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R2.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R2) {
        for q3 in 0..this.e3.len {
            this.e3.items[q3].destroy();
        }
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

