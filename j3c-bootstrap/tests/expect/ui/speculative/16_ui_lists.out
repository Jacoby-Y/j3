        if hotFile(css, "ui/Card.j3ui", CSS_Card, 670953840, true) {
            ch = true;
        }
        if hotFile(css, "ui/Row.j3ui", CSS_Row, 396456666, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 101276464, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

