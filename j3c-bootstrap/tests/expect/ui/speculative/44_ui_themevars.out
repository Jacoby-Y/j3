// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 360px; height: 260px; padding: 16px; background: var(--bg); color: var(--fg); font-size: 14px; }\n    .card { padding: 12px; margin-bottom: 12px; border-radius: 8px; box-shadow: 0 4px 10px var(--shadow); border: 2px solid var(--edge); }\n    .hero { color: #ffffff; background-image: linear-gradient(90deg, var(--accent), var(--accent2) 80%); }\n    .mixed { background: color-mix(in srgb, var(--accent) 30%, var(--bg)); border: 2px solid color-mix(in srgb, var(--accent) 70%, white); }\n    .row { display: flex; gap: 12px; }\n    .chip { width: 120px; padding: 10px; text-align: center; color: #ffffff; }\n    .chip.a { background-image: linear-gradient(var(--accent2), var(--accent)); }\n    .chip.b { background: var(--accent2); border: 3px dashed var(--accent); }";
const LINE0_Screen: int = 12;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_card: int;
    cls_hero: int;
    cls_mixed: int;
    cls_row: int;
    cls_chip: int;
    cls_a: int;
    cls_b: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_card: 0,
            cls_hero: 0,
            cls_mixed: 0,
            cls_row: 0,
            cls_chip: 0,
            cls_a: 0,
            cls_b: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_card = d.css.intern("card");
        this.cls_hero = d.css.intern("hero");
        this.cls_mixed = d.css.intern("mixed");
        this.cls_row = d.css.intern("row");
        this.cls_chip = d.css.intern("chip");
        this.cls_a = d.css.intern("a");
        this.cls_b = d.css.intern("b");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 700124457, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_card);
        d.clsId(n2, this.cls_hero);
        d.text("gradient from vars");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_card);
        d.clsId(n3, this.cls_mixed);
        d.text("color-mix of the accent");
        d.close();
        let n4 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_row);
        let n5 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_chip);
        d.clsId(n5, this.cls_a);
        d.text("stops");
        d.close();
        let n6 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_chip);
        d.clsId(n6, this.cls_b);
        d.text("border");
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        let n5 = d.paintNext(0);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        let n6 = d.paintNext(1);
                        if n6 >= 0 {
                            d.paintBox(n6);
                            let pass6 = 0;
                            while d.paintChildren(pass6) {
                                pass6 += 1;
                            }
                            d.paintEnd(n6);
                        }
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

