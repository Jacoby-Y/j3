// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 100%; height: 100%; padding: 10px; box-sizing: border-box; }\n    h2 { font-size: 13px; margin-bottom: 4px; }\n    .list { width: 200px; margin-bottom: 8px; }\n    .task { display: flex; height: 20px; align-items: center; }\n    .task label { margin-left: 6px; color: #303040; }\n    .task input:checked + label { color: #20a070; text-decoration: line-through; }\n    .task:last-of-type { border-bottom: 2px solid #8060c0; }\n    .table { width: 200px; margin-bottom: 8px; }\n    .tr { display: flex; justify-content: space-between; height: 18px; padding: 0 6px; }\n    .tr:nth-of-type(even) { background: #dfe8ff; }\n    .tr:last-of-type { font-weight: bold; }\n    .notes { width: 200px; height: 18px; margin-bottom: 4px; padding: 0 6px; background: #ffffff; }\n    .notes:empty { background: #ffe8e0; }\n    .notes:empty::before { content: \"No notes\"; color: #a06040; }\n    .name { width: 200px; margin-top: 4px; }\n    .name:placeholder-shown { background: #fff8d0; }";
const LINE0_Screen: int = 26;

