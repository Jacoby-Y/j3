// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { width: 300px; padding: 10px; color: #ffffff; font-size: 14px; }\n    .title { margin-bottom: 8px; color: #a0b0d0; }\n    .list { display: flex; flex-direction: column; gap: 6px; }\n    .row { height: 26px; padding: 6px 10px; box-sizing: border-box; border-radius: 4px; background: #3050a0; }\n    .r1 { background: #a05030; }\n    .r3 { background: #308050; }";
const LINE0_Screen: int = 13;

pub struct ScreenProps {
    order: []int;
    n: int;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_title: int;
    cls_list: int;
    cls_row: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_title: 0,
            cls_list: 0,
            cls_row: 0,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_title = d.css.intern("title");
        this.cls_list = d.css.intern("list");
        this.cls_row = d.css.intern("row");
    }

    fn name(this: &Screen, v: int): string {
 return if v == 0 { "Apple" } else if v == 1 { "Bread" } else if v == 2 { "Cheese" } else if v == 3 { "Dates" } else { "Eggs" }; 
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 983878285, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let n = p.n;
        let order = p.order;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_title);
        d.text("Pantry");
        d.close();
        let n3 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_list);
        let s4 = d.enter(0);
        let m4 = n;
        this.cnt1 = m4;
        this.kd1.begin();
        for kv4 in 0..m4 {
            this.kd1.add(`{order[kv4]}`);
        }
        this.kd1.finish("ui/Screen.j3ui:8");
        if this.kd1.changed {
            for dq4 in 0..this.kd1.dead.len { let dr4 = this.e1.items[this.kd1.dead.items[dq4]]; dr4.destroy(); this.fp1.push(dr4); }
            this.eb1.len = 0;
            for rq4 in 0..m4 {
                let f4 = this.kd1.from.items[rq4];
                if f4 >= 0 { this.eb1.push(this.e1.items[f4]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
            let t4 = this.e1;
            this.e1 = this.eb1;
            this.eb1 = t4;
        }
        for i in 0..m4 {
            let r1 = this.e1.items[i];
            d.keyBegin(r1.uid);
            let n5 = d.open(0, this.tag_div, SCOPE_Screen);
            d.clsId(n5, this.cls_row);
            d.clsDyn(n5, Text.scratch().add("r").add(`{order[i]}`).str());
            d.flip(n5, f32(300), 1);
            d.text(`{this.name(order[i])}`);
            d.close();
            d.keyEnd();
        }
        d.leave(s4);
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        let s4 = d.enter(0);
                        let m4 = this.cnt1;
                        for i in 0..m4 {
                            let r1 = this.e1.items[i];
                            d.paintGroup(r1.uid);
                            let n5 = d.paintNext(0);
                            if n5 >= 0 {
                                d.paintBox(n5);
                                let pass5 = 0;
                                while d.paintChildren(pass5) {
                                    pass5 += 1;
                                }
                                d.paintEnd(n5);
                            }
                            d.paintGroupEnd();
                        }
                        d.leave(s4);
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

