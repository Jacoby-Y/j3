// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 3;
const CSS_Screen: string = ".wide { width: 123px; }";
const LINE0_Screen: int = 19;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c1: TextMsg;
    c2: ImageMsg;
    c3: Embed;
    if1: int;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c1: TextMsg.new(mem),
            c2: ImageMsg.new(mem),
            c3: Embed.new(mem),
            if1: -1,
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.c3.j3Reset();
        this.if1 = -1;
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        this.c1.destroy();
        this.c2.destroy();
        this.c3.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_span: int;
    c4: TextMsg;
    c5: ImageMsg;
    c6: Embed;
    if2: int;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;
    eb1: List<&Screen_R1>;
    kd1: Keyed;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_span: 0,
            c4: TextMsg.new(mem),
            c5: ImageMsg.new(mem),
            c6: Embed.new(mem),
            if2: -1,
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
            eb1: List<&Screen_R1>.new(mem),
            kd1: Keyed.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c4.j3Reset();
        this.c5.j3Reset();
        this.c6.j3Reset();
        this.if2 = -1;
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
        this.eb1.len = 0;
        this.kd1.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        TextMsg.styles(css);
        ImageMsg.styles(css);
        Embed.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
    }

    fn kind(this: &Screen): Of_TextMsg_ImageMsg_Embed {
        let state = this.p.state;

        state.selects += 1;
        if state.choice == 0 { return Of_TextMsg_ImageMsg_Embed.TextMsg; }
        if state.choice == 1 { return Of_TextMsg_ImageMsg_Embed.ImageMsg; }
        return Of_TextMsg_ImageMsg_Embed.Embed;
    
    }

    fn slot1_default_update(this: &Screen, d: &Dom, i2: int) {
        let state = this.p.state;
        let r1 = this.e1.items[i2];
        let x2 = state.rows;
        let msg = x2[i2];
        let n5 = d.open(0, this.tag_span, SCOPE_Screen);
        d.text("body");
        d.close();
    }

    fn slot1_default_paint(this: &Screen, d: &Dom, i2: int) {
        let r1 = this.e1.items[i2];
        let n5 = d.paintNext(0);
        if n5 >= 0 {
            d.paintBox(n5);
            let pass5 = 0;
            while d.paintChildren(pass5) {
                pass5 += 1;
            }
            d.paintEnd(n5);
        }
    }

    fn slot1_default_leave(this: &Screen, d: &Dom, i2: int) {
        let r1 = this.e1.items[i2];
    }

