// ---- ui/Embed.j3ui
pub const SCOPE_Embed: int = 1;
const CSS_Embed: string = "";
const LINE0_Embed: int = 0;

pub struct EmbedProps {
    msg: Msg;
    state: &State;
    j3pass_scope: int;
    j3pass_cls: string;
    j3pass_k0: int;
    j3pass_n0: string;
    j3pass_f0: f32;
    j3pass_s0: string;
}

pub struct EmbedEvents {
}

pub struct Embed {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &EmbedProps;
    birth: int;
    tag_section: int;
    tag_p: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow3: bool;
    slotWas3: bool;
    slotNow4: bool;
    slotWas4: bool;

    fn new(mem: &Arena): Embed {
        let ps = mem.alloc::<EmbedProps>(1);
        return Embed {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            birth: 0,
            tag_section: 0,
            tag_p: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow3: false, slotWas3: false,
            slotNow4: false, slotWas4: false,
        };
    }

    fn j3Reset(this: &Embed) {
        let mem = this.mem;
        this.ready = false;
        this.birth = 0;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow3 = false;
        this.slotWas3 = false;
        this.slotNow4 = false;
        this.slotWas4 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Embed, "ui/Embed.j3ui", SCOPE_Embed, LINE0_Embed);
    }

    fn init(this: &Embed, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_section = d.tag("section");
        this.tag_p = d.tag("p");
    }

    fn onMount(this: &Embed) {
        let msg = this.p.msg;
        let state = this.p.state;
 state.mounts += 1; state.next += 1; this.birth = state.next; state.birth[msg.id] = this.birth; 
    }

    fn onFrame(this: &Embed, dt: f32) {
        let msg = this.p.msg;
        let state = this.p.state;
 state.birth[msg.id] = this.birth; 
    }

    fn onDestroy(this: &Embed) {
        let state = this.p.state;
 state.destroys += 1; 
    }

    fn update(this: &Embed, d: &Dom, p: EmbedProps): EmbedEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = EmbedEvents {  };
        this.onFrame(d.dt());
        let n1 = d.open(0, this.tag_section, SCOPE_Embed);
        d.scopePass(n1, p.j3pass_scope);
        d.clsPass(n1, p.j3pass_cls);
        d.stylePass(n1, 0, p.j3pass_k0, p.j3pass_n0, p.j3pass_f0, p.j3pass_s0);
        let n2 = d.open(0, this.tag_p, SCOPE_Embed);
        d.text("Embed");
        d.close();
        let s3 = d.enter(1);
        this.slotNow3 = true;
        if this.slotSite == 3 {
            ((this.slotOwn as ptr) as &Screen).slot3_default_update(d, this.slotI);
        } else if this.slotSite == 6 {
            ((this.slotOwn as ptr) as &Screen).slot6_default_update(d, this.slotI);
        } else {
        }
        d.leave(s3);
        let s4 = d.enter(2);
        this.slotNow4 = true;
        if this.slotSite == 3 {
            ((this.slotOwn as ptr) as &Screen).slot3_footer_update(d, this.slotI);
        } else if this.slotSite == 6 {
            ((this.slotOwn as ptr) as &Screen).slot6_footer_update(d, this.slotI);
        } else {
        }
        d.leave(s4);
        d.close();
        if this.slotWas3 && !this.slotNow3 {
            if this.slotSite == 3 {
                ((this.slotOwn as ptr) as &Screen).slot3_default_leave(d, this.slotI);
            }             else if this.slotSite == 6 {
                ((this.slotOwn as ptr) as &Screen).slot6_default_leave(d, this.slotI);
            }
        }
        this.slotWas3 = this.slotNow3;
        this.slotNow3 = false;
        if this.slotWas4 && !this.slotNow4 {
            if this.slotSite == 3 {
                ((this.slotOwn as ptr) as &Screen).slot3_footer_leave(d, this.slotI);
            }             else if this.slotSite == 6 {
                ((this.slotOwn as ptr) as &Screen).slot6_footer_leave(d, this.slotI);
            }
        }
        this.slotWas4 = this.slotNow4;
        this.slotNow4 = false;
        if mounting {
            this.onMount();
        }
        return ev;
    }

    fn destroy(this: &Embed) {
        if !this.ready {
            return;
        }
        this.onDestroy();
        this.ready = false;
    }

    fn paint(this: &Embed, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let s3 = d.enter(1);
                if this.slotSite == 3 {
                    ((this.slotOwn as ptr) as &Screen).slot3_default_paint(d, this.slotI);
                } else if this.slotSite == 6 {
                    ((this.slotOwn as ptr) as &Screen).slot6_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s3);
                let s4 = d.enter(2);
                if this.slotSite == 3 {
                    ((this.slotOwn as ptr) as &Screen).slot3_footer_paint(d, this.slotI);
                } else if this.slotSite == 6 {
                    ((this.slotOwn as ptr) as &Screen).slot6_footer_paint(d, this.slotI);
                } else {
                }
                d.leave(s4);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Embed): bool {
        return this.slotSite == 3 || this.slotSite == 6;
    }

    fn slotHas_footer(this: &Embed): bool {
        return this.slotSite == 3 || this.slotSite == 6;
    }
}

