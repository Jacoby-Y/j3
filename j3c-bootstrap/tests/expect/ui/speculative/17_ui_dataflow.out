        return Mid {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            c1: Deep.new(mem),
        };
    }

    fn j3Reset(this: &Mid) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Mid, "ui/Mid.j3ui", SCOPE_Mid, LINE0_Mid);
        Deep.styles(css);
    }

    fn init(this: &Mid, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn update(this: &Mid, d: &Dom, p: MidProps): MidEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = MidEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Mid);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, DeepProps { state: state });
        d.leave(s2);
        d.close();
        return ev;
    }

    fn destroy(this: &Mid) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
