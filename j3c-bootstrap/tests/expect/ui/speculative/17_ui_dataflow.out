// ---- ui/Deep.j3ui
pub const SCOPE_Deep: int = 1;
const CSS_Deep: string = "";
const LINE0_Deep: int = 0;

pub struct DeepProps {
    state: &State;
}

pub struct DeepEvents {
}

pub struct Deep {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &DeepProps;
    tag_button: int;

    fn new(mem: &Arena): Deep {
        let ps = mem.alloc::<DeepProps>(1);
        return Deep {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_button: 0,
        };
    }

    fn j3Reset(this: &Deep) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Deep, "ui/Deep.j3ui", SCOPE_Deep, LINE0_Deep);
    }

    fn init(this: &Deep, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_button = d.tag("button");
    }

    fn update(this: &Deep, d: &Dom, p: DeepProps): DeepEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = DeepEvents {  };
        let n1 = d.open(0, this.tag_button, SCOPE_Deep);
        if d.clicked(n1) {
            state.sum += 1;
        }
        d.text(Text.scratch().add("d").add(`{state.sum}`).str());
        d.close();
        return ev;
    }

    fn destroy(this: &Deep) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Deep, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Holder.j3ui
pub const SCOPE_Holder: int = 2;
const CSS_Holder: string = "";
const LINE0_Holder: int = 0;

pub struct HolderProps {
}

pub struct HolderEvents {
}

pub struct Holder {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &HolderProps;
    tag_div: int;
    slotSite: int;
    slotOwn: int;
    slotI: int;
    slotNow2: bool;
    slotWas2: bool;

    fn new(mem: &Arena): Holder {
        let ps = mem.alloc::<HolderProps>(1);
        return Holder {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            slotSite: 0, slotOwn: 0, slotI: 0,
            slotNow2: false, slotWas2: false,
        };
    }

    fn j3Reset(this: &Holder) {
        let mem = this.mem;
        this.ready = false;
        this.slotSite = 0;
        this.slotOwn = 0;
        this.slotI = 0;
        this.slotNow2 = false;
        this.slotWas2 = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Holder, "ui/Holder.j3ui", SCOPE_Holder, LINE0_Holder);
    }

    fn init(this: &Holder, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn update(this: &Holder, d: &Dom, p: HolderProps): HolderEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = HolderEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Holder);
        let s2 = d.enter(0);
        this.slotNow2 = true;
        if this.slotSite == 1 {
            ((this.slotOwn as ptr) as &Panel).slot1_default_update(d, this.slotI);
        } else if this.slotSite == 2 {
            ((this.slotOwn as ptr) as &Screen).slot2_default_update(d, this.slotI);
        } else {
        }
        d.leave(s2);
        d.close();
        if this.slotWas2 && !this.slotNow2 {
            if this.slotSite == 1 {
                ((this.slotOwn as ptr) as &Panel).slot1_default_leave(d, this.slotI);
            }             else if this.slotSite == 2 {
                ((this.slotOwn as ptr) as &Screen).slot2_default_leave(d, this.slotI);
            }
        }
        this.slotWas2 = this.slotNow2;
        this.slotNow2 = false;
        return ev;
    }

    fn destroy(this: &Holder) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Holder, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                if this.slotSite == 1 {
                    ((this.slotOwn as ptr) as &Panel).slot1_default_paint(d, this.slotI);
                } else if this.slotSite == 2 {
                    ((this.slotOwn as ptr) as &Screen).slot2_default_paint(d, this.slotI);
                } else {
                }
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slotHas_default(this: &Holder): bool {
        return this.slotSite == 1 || this.slotSite == 2;
    }
}

// ---- ui/Mid.j3ui
