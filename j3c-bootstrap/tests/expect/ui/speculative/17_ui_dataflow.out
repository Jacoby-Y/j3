            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Pad.j3ui
pub const SCOPE_Pad: int = 4;
const CSS_Pad: string = "";
const LINE0_Pad: int = 0;

pub struct PadProps {
}

pub struct PadEvents {
    pick: bool;
    pick_slot: int;
    rename: bool;
    rename_name: string;
    rename_n: int;
    close: bool;
}

pub struct PadEvent_pick {
    slot: int;
}

pub struct PadEvent_rename {
    name: string;
    n: int;
}

pub struct Pad {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &PadProps;
    tag_div: int;
    tag_button: int;
    cnt1: int;

    fn new(mem: &Arena): Pad {
        let ps = mem.alloc::<PadProps>(1);
        return Pad {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            tag_button: 0,
            cnt1: 0,
        };
    }

    fn j3Reset(this: &Pad) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Pad, "ui/Pad.j3ui", SCOPE_Pad, LINE0_Pad);
    }

    fn init(this: &Pad, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_button = d.tag("button");
    }

    fn update(this: &Pad, d: &Dom, p: PadProps): PadEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = PadEvents { pick: false, pick_slot: 0, rename: false, rename_name: "", rename_n: 0, close: false };
        let n1 = d.open(0, this.tag_div, SCOPE_Pad);
        let s2 = d.enter(0);
        let m2 = 3;
        this.cnt1 = m2;
        for i in 0..m2 {
            let n3 = d.open(i * 1 + 0, this.tag_button, SCOPE_Pad);
            if d.clicked(n3) {
                ev.pick_slot = i; ev.pick = true;
            }
            d.text(Text.scratch().add("p").add(`{i}`).str());
            d.close();
        }
        d.leave(s2);
        let n4 = d.open(1, this.tag_button, SCOPE_Pad);
        if d.clicked(n4) {
            ev.rename_name = "bob"; ev.rename_n = 3 + 4; ev.rename = true;
        }
        d.text("r");
        d.close();
        let n5 = d.open(2, this.tag_button, SCOPE_Pad);
        if d.clicked(n5) {
            ev.close = true;
        }
        d.text("c");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Pad) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Pad, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                let m2 = this.cnt1;
                for i in 0..m2 {
                    let n3 = d.paintNext(i * 1 + 0);
                    if n3 >= 0 {
                        d.paintBox(n3);
                        let pass3 = 0;
                        while d.paintChildren(pass3) {
                            pass3 += 1;
                        }
                        d.paintEnd(n3);
                    }
                }
                d.leave(s2);
                let n4 = d.paintNext(1);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n5 = d.paintNext(2);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Panel.j3ui
pub const SCOPE_Panel: int = 5;
const CSS_Panel: string = "";
const LINE0_Panel: int = 0;

pub struct PanelProps {
}

pub struct PanelEvents {
    done: bool;
    done_v: int;
}

pub struct PanelEvent_done {
    v: int;
}

pub struct Panel {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &PanelProps;
    tag_button: int;
    c1: Holder;
    sev: PanelEvents;

    fn new(mem: &Arena): Panel {
        let ps = mem.alloc::<PanelProps>(1);
        return Panel {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_button: 0,
            c1: Holder.new(mem),
            sev: PanelEvents { done: false, done_v: 0 },
        };
    }

    fn j3Reset(this: &Panel) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.sev = PanelEvents { done: false, done_v: 0 };
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Panel, "ui/Panel.j3ui", SCOPE_Panel, LINE0_Panel);
        Holder.styles(css);
    }

    fn init(this: &Panel, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_button = d.tag("button");
    }

    fn slot1_default_update(this: &Panel, d: &Dom, slotI: int) {
        let ev = &this.sev;
        let n1 = d.open(0, this.tag_button, SCOPE_Panel);
        if d.clicked(n1) {
            ev.done_v = 4; ev.done = true;
        }
        d.text("x");
        d.close();
    }

    fn slot1_default_paint(this: &Panel, d: &Dom, slotI: int) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }

    fn slot1_default_leave(this: &Panel, d: &Dom, slotI: int) {
    }

    fn update(this: &Panel, d: &Dom, p: PanelProps): PanelEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = PanelEvents { done: false, done_v: 0 };
        let s2 = d.enter(0);
        this.c1.slotSite = 1;
        this.c1.slotOwn = this as int;
        this.c1.slotI = 0;
        let e2 = this.c1.update(d, HolderProps {  });
        d.leave(s2);
        if this.sev.done {
            ev.done = true;
            ev.done_v = this.sev.done_v;
            this.sev.done = false;
        }
        return ev;
    }

    fn destroy(this: &Panel) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
    }

    fn paint(this: &Panel, d: &Dom) {
        let s2 = d.enter(0);
        this.c1.slotOwn = this as int;
        this.c1.paint(d);
        d.leave(s2);
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 6;
const CSS_Screen: string = "";
const LINE0_Screen: int = 0;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

struct Screen_R1 {
    uid: int;
    comp: int;
    dom: &Dom;
    c5: Mid;

    fn make(mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        let a = mem.alloc::<Screen_R1>(1);
        a[0] = Screen_R1 {
            uid: uid,
            comp: comp,
            dom: d,
            c5: Mid.new(mem),
        };
        return &a[0];
    }

    fn reset(this: &Screen_R1, uid: int, comp: int) {
        this.uid = uid;
        this.comp = comp;
        this.c5.j3Reset();
    }

    fn take(pool: &List<&Screen_R1>, mem: &Arena, d: &Dom, uid: int, comp: int): &Screen_R1 {
        if pool.len > 0 {
            pool.len -= 1;
            let r = pool.items[pool.len];
            r.reset(uid, comp);
            return r;
        }
        return Screen_R1.make(mem, d, uid, comp);
    }

    fn destroy(this: &Screen_R1) {
        this.c5.destroy();
        if this.uid >= 0 {
            this.dom.groupFree(this.uid);
            this.uid = -1;
        }
    }
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    c1: Pad;
    c2: Panel;
    c3: Holder;
    c4: Deep;
    cnt1: int;
    e1: List<&Screen_R1>;
    fp1: List<&Screen_R1>;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            c1: Pad.new(mem),
            c2: Panel.new(mem),
            c3: Holder.new(mem),
            c4: Deep.new(mem),
            cnt1: 0,
            e1: List<&Screen_R1>.new(mem),
            fp1: List<&Screen_R1>.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.c3.j3Reset();
        this.c4.j3Reset();
        this.cnt1 = 0;
        for q1 in 0..this.e1.len {
            this.fp1.push(this.e1.items[q1]);
        }
        this.e1.len = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Pad.styles(css);
        Panel.styles(css);
        Holder.styles(css);
        Deep.styles(css);
        Mid.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
    }

    fn slot2_default_update(this: &Screen, d: &Dom, slotI: int) {
        let state = this.p.state;
        let s4 = d.enter(0);
        let e4 = this.c4.update(d, DeepProps { state: state });
        d.leave(s4);
    }

    fn slot2_default_paint(this: &Screen, d: &Dom, slotI: int) {
        let s4 = d.enter(0);
        this.c4.paint(d);
        d.leave(s4);
    }

    fn slot2_default_leave(this: &Screen, d: &Dom, slotI: int) {
        this.c4.destroy();
        this.c4.j3Reset();
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Deep.j3ui", CSS_Deep, 841772470, true) {
            ch = true;
        }
        if hotFile(css, "ui/Holder.j3ui", CSS_Holder, 254734772, true) {
            ch = true;
        }
        if hotFile(css, "ui/Mid.j3ui", CSS_Mid, 475607879, true) {
            ch = true;
        }
        if hotFile(css, "ui/Pad.j3ui", CSS_Pad, 874935151, true) {
            ch = true;
        }
        if hotFile(css, "ui/Panel.j3ui", CSS_Panel, 774704440, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 670072907, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, PadProps {  });
        d.leave(s2);
        if e2.pick {
            let evt2_pick = PadEvent_pick { slot: e2.pick_slot };
            state.slot = evt2_pick.slot;
        }
        if e2.rename {
            let evt2_rename = PadEvent_rename { name: e2.rename_name, n: e2.rename_n };
            state.name = evt2_rename.name; state.n = evt2_rename.n;
        }
        if e2.close {
            state.n += 100;
        }
        let s3 = d.enter(1);
        let e3 = this.c2.update(d, PanelProps {  });
        d.leave(s3);
        if e3.done {
            let evt3_done = PanelEvent_done { v: e3.done_v };
            state.sum += evt3_done.v * 100;
        }
        let s5 = d.enter(2);
        this.c3.slotSite = 2;
        this.c3.slotOwn = this as int;
        this.c3.slotI = 0;
        let e5 = this.c3.update(d, HolderProps {  });
        d.leave(s5);
        let s6 = d.enter(3);
        let m6 = 2;
        this.cnt1 = m6;
        while this.e1.len < m6 { this.e1.push(Screen_R1.take(&this.fp1, this.mem, d, -1, this as int)); }
        if this.e1.len > m6 {
            for zq6 in m6..this.e1.len { this.e1.items[zq6].destroy(); this.fp1.push(this.e1.items[zq6]); }
            this.e1.len = m6;
        }
        for i in 0..m6 {
            let r1 = this.e1.items[i];
            let s7 = d.enter(i * 1 + 0);
            let e7 = r1.c5.update(d, MidProps { state: state });
            d.leave(s7);
        }
        d.leave(s6);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c2.destroy();
        this.c3.destroy();
        this.c4.destroy();
        for q1 in 0..this.e1.len {
            this.e1.items[q1].destroy();
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                let s3 = d.enter(1);
                this.c2.paint(d);
                d.leave(s3);
                let s5 = d.enter(2);
                this.c3.slotOwn = this as int;
                this.c3.paint(d);
                d.leave(s5);
                let s6 = d.enter(3);
                let m6 = this.cnt1;
                for i in 0..m6 {
                    let r1 = this.e1.items[i];
                    let s7 = d.enter(i * 1 + 0);
                    r1.c5.paint(d);
                    d.leave(s7);
                }
                d.leave(s6);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

