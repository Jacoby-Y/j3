// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    @property --p { syntax: '<percentage>'; inherits: false; initial-value: 0%; }\n    @property --a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }\n    @property --w { syntax: '<length>'; inherits: true; initial-value: 0px; }\n    @property --c { syntax: '<color>'; inherits: false; initial-value: #2060d0; }\n    .screen { position: relative; width: 380px; height: 280px; background: #f2f2f6; color: #303040; font-size: 12px; }\n    .ring { position: absolute; left: 20px; top: 20px; width: 120px; height: 120px; border-radius: 60px; background: conic-gradient(#4080ff var(--p), #dde0ea var(--p)); animation: fill 1s linear forwards; }\n    .spin { position: absolute; left: 160px; top: 20px; width: 120px; height: 120px; border-radius: 60px; background: conic-gradient(from var(--a), #f08040, #ffffff 50%, #f08040); animation: turn 2s linear infinite; }\n    .hole { position: absolute; left: 15px; top: 15px; width: 90px; height: 90px; border-radius: 45px; background: #f2f2f6; text-align: center; padding-top: 38px; box-sizing: border-box; }\n    .card { position: absolute; left: 20px; top: 170px; width: 240px; height: 80px; background: #d8d8e0; animation: widen 1s linear forwards; }\n    .fill { height: 24px; width: var(--w); background: #20b080; color: #ffffff; margin-bottom: 8px; overflow: hidden; }\n    .own { --w: 120px; background: #8060c0; }\n    .swatch { position: absolute; left: 290px; top: 170px; width: 70px; height: 70px; background: var(--c); color: #ffffff; animation: tint 1s linear forwards; }\n    .finished .ring, .finished .card, .finished .swatch { animation-duration: 80ms; }\n    .finished .spin { animation-iteration-count: 1; animation-duration: 80ms; animation-fill-mode: forwards; }\n    @keyframes fill { to { --p: 70%; } }\n    @keyframes turn { to { --a: 360deg; } }\n    @keyframes widen { to { --w: 200px; } }\n    @keyframes tint { to { --c: #d03080; } }";
const LINE0_Screen: int = 13;

pub struct ScreenProps {
    finished: bool;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_screen: int;
    cls_finished: int;
    cls_ring: int;
    cls_hole: int;
    cls_spin: int;
    cls_card: int;
    cls_fill: int;
    cls_own: int;
    cls_swatch: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_screen: 0,
            cls_finished: 0,
            cls_ring: 0,
            cls_hole: 0,
            cls_spin: 0,
            cls_card: 0,
            cls_fill: 0,
            cls_own: 0,
            cls_swatch: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_screen = d.css.intern("screen");
        this.cls_finished = d.css.intern("finished");
        this.cls_ring = d.css.intern("ring");
        this.cls_hole = d.css.intern("hole");
        this.cls_spin = d.css.intern("spin");
        this.cls_card = d.css.intern("card");
        this.cls_fill = d.css.intern("fill");
        this.cls_own = d.css.intern("own");
        this.cls_swatch = d.css.intern("swatch");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 320353461, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let finished = p.finished;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsIfId(n1, this.cls_finished, finished);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_ring);
        let n3 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n3, this.cls_hole);
        d.text("progress");
        d.close();
        d.close();
        let n4 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n4, this.cls_spin);
        let n5 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_hole);
        d.text("spinner");
        d.close();
        d.close();
        let n6 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_card);
        let n7 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_fill);
        d.text("inherits --w");
        d.close();
        let n8 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_fill);
        d.clsId(n8, this.cls_own);
        d.text("own --w");
        d.close();
        d.close();
        let n9 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n9, this.cls_swatch);
        d.text("--c");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n4 = d.paintNext(1);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        let n5 = d.paintNext(0);
                        if n5 >= 0 {
                            d.paintBox(n5);
                            let pass5 = 0;
                            while d.paintChildren(pass5) {
                                pass5 += 1;
                            }
                            d.paintEnd(n5);
                        }
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n6 = d.paintNext(2);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        let n7 = d.paintNext(0);
                        if n7 >= 0 {
                            d.paintBox(n7);
                            let pass7 = 0;
                            while d.paintChildren(pass7) {
                                pass7 += 1;
                            }
                            d.paintEnd(n7);
                        }
                        let n8 = d.paintNext(1);
                        if n8 >= 0 {
                            d.paintBox(n8);
                            let pass8 = 0;
                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n9 = d.paintNext(3);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

