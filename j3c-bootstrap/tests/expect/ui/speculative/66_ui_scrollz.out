// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; flex-wrap: wrap; width: 100%; height: 100%; padding: 10px; gap: 10px; }\n    .cell { position: relative; width: 140px; height: 135px; }\n    .demo { position: relative; z-index: 0; width: 140px; height: 110px; background: #e0e0ea; }\n    .lbl { font-size: 10px; margin-top: 3px; }\n    .box { position: absolute; }\n    .red { background: #d04060; } .green { background: #40a060; } .blue { background: #3070c0; } .yellow { background: #e0c040; } .gray { background: #a0a0b0; }\n    .tall { display: block; width: 40px; height: 300px; }\n    .sb { left: 10px; top: 10px; width: 70px; height: 70px; overflow: auto; }\n    .zc { left: 5px; top: 40px; width: 90px; height: 90px; z-index: 10; }\n    .zs { left: 40px; top: 40px; width: 90px; height: 60px; z-index: 5; }\n    .sbo { left: 5px; top: 5px; width: 110px; height: 100px; overflow: auto; }\n    .sbi { position: relative; display: block; margin: 8px; width: 70px; height: 70px; overflow: auto; }\n    .zc2 { left: 0; top: 0; width: 100px; height: 100px; z-index: 10; }\n    .zs2 { left: 30px; top: 50px; width: 100px; height: 50px; z-index: 5; }\n    .rw { left: 15px; top: 5px; width: 110px; height: 100px; transform: rotate(14deg); background: #ffffff; }\n    .rsb { left: 5px; top: 5px; width: 70px; height: 50px; overflow: auto; }\n    .rzc { left: 10px; top: 20px; width: 80px; height: 60px; z-index: 10; }\n    .rzs { left: 40px; top: 40px; width: 60px; height: 50px; z-index: 5; }";
