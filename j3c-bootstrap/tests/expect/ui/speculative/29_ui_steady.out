            this.eb1.len = 0;
            for rq4 in 0..m4 {
                let f4 = this.kd1.from.items[rq4];
                if f4 >= 0 { this.eb1.push(this.e1.items[f4]); } else { this.eb1.push(Screen_R1.take(&this.fp1, this.mem, d, d.groupNew(-1), this as int)); }
            }
