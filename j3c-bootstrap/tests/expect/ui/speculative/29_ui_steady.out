    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
