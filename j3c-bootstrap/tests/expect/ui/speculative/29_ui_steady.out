        d.styleNumAt(n7, 0, "left", f32(state.pos), "ui/Screen.j3ui", 11, 40);
        d.styleNumAt(n7, 1, "top", f32(state.pos), "ui/Screen.j3ui", 11, 63);
        d.close();
