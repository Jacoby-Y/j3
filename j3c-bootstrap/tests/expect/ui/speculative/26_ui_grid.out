            let text_n7_edit = d.gridOf(n7).evText;
            if kind_n7_edit == 0 {
            g.draft = g.initial(state.get(row_n7_edit, col_n7_edit));
        } else if kind_n7_edit == 1 {
            state.set(row_n7_edit, col_n7_edit, text_n7_edit);
        } else if kind_n7_edit == 2 {
            for i in 0..g.pasteRows {
                for j in 0..g.pasteCols {
                    state.set(row_n7_edit + i, col_n7_edit + j, g.pasteCell(i, j));
                }
            }
        }
        }
        let s8 = d.enter(0);
        let x8 = state.rows;
        this.vl2.cfg(f32(24), f32(40.0), false, false);
        if this.vl2.stale(x8.len) {
            let ap8 = this.vl2.grew(x8.len);
            if ap8 {
                this.vl2.pk.begin();
                let kr8a = x8[0];
                let ks8a = 0;
                this.vl2.pk.add(`{kr8a.id}`);
                let kr8b = x8[this.vl2.n - 1];
                let ks8b = this.vl2.n - 1;
                this.vl2.pk.add(`{kr8b.id}`);
                ap8 = this.vl2.probeOk();
            }
            if ap8 {
                for kq8 in this.vl2.n..x8.len {
                    let kr8c = x8[kq8];
