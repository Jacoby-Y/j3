        d.styleNumAt(n3, 0, "margin-left", f32(0.0 - g.sx), "ui/Screen.j3ui", 8, 27);
        d.styleNumAt(n3, 1, "width", f32(g.total), "ui/Screen.j3ui", 8, 58);
        d.styleNumAt(n3, 2, "padding-left", f32(g.fw()), "ui/Screen.j3ui", 8, 80);
        let s4 = d.enter(0);
