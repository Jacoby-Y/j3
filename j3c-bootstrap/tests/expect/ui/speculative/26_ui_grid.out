    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.cnt1 = 0;
        this.cnt2 = 0;
        for q2 in 0..this.e2.len {
            this.fp2.push(this.e2.items[q2]);
        }
        this.e2.len = 0;
        this.eb2.len = 0;
        this.kd2.reset();
        this.vl2.reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_input = d.tag("input");
        this.cls_sheet = d.css.intern("sheet");
        this.cls_head = d.css.intern("head");
        this.cls_hrow = d.css.intern("hrow");
        this.cls_hc = d.css.intern("hc");
        this.cls_frozen = d.css.intern("frozen");
        this.cls_grip = d.css.intern("grip");
        this.cls_body = d.css.intern("body");
        this.cls_row = d.css.intern("row");
        this.cls_cell = d.css.intern("cell");
        this.cls_active = d.css.intern("active");
        this.cls_sel = d.css.intern("sel");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 632620188, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
