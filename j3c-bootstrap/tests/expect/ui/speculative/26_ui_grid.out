            d.clsId(n5, this.cls_hc);
            d.clsIfId(n5, this.cls_frozen, g.fz(j));
            d.styleNumAt(n5, 0, "left", f32(g.hx(j)), "ui/Screen.j3ui", 10, 56);
            d.styleNumAt(n5, 1, "width", f32(g.w(j)), "ui/Screen.j3ui", 10, 77);
            d.text(Text.scratch().add("C").add(`{j}`).str());
