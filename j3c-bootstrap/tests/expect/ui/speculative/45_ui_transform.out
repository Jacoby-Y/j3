// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { position: relative; width: 380px; height: 280px; background: #f2f2f6; color: #202030; font-size: 14px; }\n    .card { position: absolute; left: 20px; top: 20px; width: 140px; padding: 8px; background: #2060d0; color: #ffffff; border-radius: 8px; border: 2px solid #102050; transform: skewX(-20deg) rotate(4deg); }\n    .pic { width: 32px; height: 32px; }\n    .btn { position: absolute; left: 200px; top: 30px; width: 120px; padding: 8px; background: #20b080; color: #ffffff; border-radius: 6px; transform: scale(1.5, 0.7); }\n    .turn { position: absolute; left: 40px; top: 150px; width: 80px; padding: 6px; background: #d03080; color: #ffffff; transform: rotate(-20deg); transform-origin: 0 0; }\n    .order { position: absolute; top: 160px; width: 60px; padding: 4px; background: #f0a030; }\n    .a1 { left: 180px; transform: translate(40px, 0) rotate(30deg); transform-origin: 0 0; }\n    .a2 { left: 180px; top: 220px; transform: rotate(30deg) translate(40px, 0); transform-origin: 0 0; }\n    .indiv { position: absolute; left: 300px; top: 200px; width: 60px; padding: 4px; background: #8060c0; color: #ffffff; translate: 10px 0; rotate: 15deg; scale: 1.2; }";
const LINE0_Screen: int = 15;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_img: int;
    tag_span: int;
    cls_screen: int;
    cls_card: int;
    cls_skewed: int;
    cls_pic: int;
    cls_btn: int;
    cls_wide: int;
    cls_turn: int;
    cls_order: int;
    cls_a1: int;
    cls_a2: int;
    cls_indiv: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_img: 0,
            tag_span: 0,
            cls_screen: 0,
            cls_card: 0,
            cls_skewed: 0,
            cls_pic: 0,
            cls_btn: 0,
            cls_wide: 0,
            cls_turn: 0,
            cls_order: 0,
            cls_a1: 0,
            cls_a2: 0,
            cls_indiv: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_img = d.tag("img");
        this.tag_span = d.tag("span");
        this.cls_screen = d.css.intern("screen");
        this.cls_card = d.css.intern("card");
        this.cls_skewed = d.css.intern("skewed");
        this.cls_pic = d.css.intern("pic");
        this.cls_btn = d.css.intern("btn");
        this.cls_wide = d.css.intern("wide");
        this.cls_turn = d.css.intern("turn");
        this.cls_order = d.css.intern("order");
        this.cls_a1 = d.css.intern("a1");
        this.cls_a2 = d.css.intern("a2");
        this.cls_indiv = d.css.intern("indiv");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 983432061, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        let n2 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n2, this.cls_card);
        d.clsId(n2, this.cls_skewed);
        let n3 = d.open(0, this.tag_img, SCOPE_Screen);
        d.clsId(n3, this.cls_pic);
        d.attrMedia(n3, 0, "assets/icon.png");
        d.close();
        let n4 = d.open(1, this.tag_span, SCOPE_Screen);
        d.text("skewed card");
        d.close();
        d.close();
        let n5 = d.open(1, this.tag_div, SCOPE_Screen);
        d.clsId(n5, this.cls_btn);
        d.clsId(n5, this.cls_wide);
        d.text("scaled 1.5 x 0.7");
        d.close();
        let n6 = d.open(2, this.tag_div, SCOPE_Screen);
        d.clsId(n6, this.cls_turn);
        d.text("top left");
        d.close();
        let n7 = d.open(3, this.tag_div, SCOPE_Screen);
        d.clsId(n7, this.cls_order);
        d.clsId(n7, this.cls_a1);
        d.text("T R");
        d.close();
        let n8 = d.open(4, this.tag_div, SCOPE_Screen);
        d.clsId(n8, this.cls_order);
        d.clsId(n8, this.cls_a2);
        d.text("R T");
        d.close();
        let n9 = d.open(5, this.tag_div, SCOPE_Screen);
        d.clsId(n9, this.cls_indiv);
        d.text("props");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        let n3 = d.paintNext(0);
                        if n3 >= 0 {
                            d.paintBox(n3);
                            let pass3 = 0;
                            while d.paintChildren(pass3) {
                                pass3 += 1;
                            }
                            d.paintEnd(n3);
                        }
                        let n4 = d.paintNext(1);
                        if n4 >= 0 {
                            d.paintBox(n4);
                            let pass4 = 0;
                            while d.paintChildren(pass4) {
                                pass4 += 1;
                            }
                            d.paintEnd(n4);
                        }
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n5 = d.paintNext(1);
                if n5 >= 0 {
                    d.paintBox(n5);
                    let pass5 = 0;
                    while d.paintChildren(pass5) {
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n6 = d.paintNext(2);
                if n6 >= 0 {
                    d.paintBox(n6);
                    let pass6 = 0;
                    while d.paintChildren(pass6) {
                        pass6 += 1;
                    }
                    d.paintEnd(n6);
                }
                let n7 = d.paintNext(3);
                if n7 >= 0 {
                    d.paintBox(n7);
                    let pass7 = 0;
                    while d.paintChildren(pass7) {
                        pass7 += 1;
                    }
                    d.paintEnd(n7);
                }
                let n8 = d.paintNext(4);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                let n9 = d.paintNext(5);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        pass9 += 1;
                    }
                    d.paintEnd(n9);
                }
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

