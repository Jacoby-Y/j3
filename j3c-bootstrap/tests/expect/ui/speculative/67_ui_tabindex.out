// ---- ui/Item.j3ui
pub const SCOPE_Item: int = 1;
const CSS_Item: string = "";
const LINE0_Item: int = 0;

pub struct ItemProps {
    ti: int;
    label: string;
}

pub struct ItemEvents {
}

pub struct Item {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ItemProps;
    tag_div: int;
    cls_item: int;

    fn new(mem: &Arena): Item {
        let ps = mem.alloc::<ItemProps>(1);
        return Item {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            tag_div: 0,
            cls_item: 0,
        };
    }

    fn j3Reset(this: &Item) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Item, "ui/Item.j3ui", SCOPE_Item, LINE0_Item);
    }

    fn init(this: &Item, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_item = d.css.intern("item");
    }

    fn update(this: &Item, d: &Dom, p: ItemProps): ItemEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let label = p.label;
        let ti = p.ti;
        let ev = ItemEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Item);
        d.clsId(n1, this.cls_item);
d.attrTabIndexN(n1, ti);
        d.text(`{label}`);
        d.close();
        return ev;
    }

    fn destroy(this: &Item) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Item, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 2;
const CSS_Screen: string = "    .item { padding: 4px; }\n    .item:focus-visible { background: #446; }";
const LINE0_Screen: int = 14;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_page: int;
    c1: Item;
    c2: Item;
    c3: Item;
    c4: Item;
    c5: Item;
    c6: Item;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            cls_page: 0,
            c1: Item.new(mem),
            c2: Item.new(mem),
            c3: Item.new(mem),
            c4: Item.new(mem),
            c5: Item.new(mem),
            c6: Item.new(mem),
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.c2.j3Reset();
        this.c3.j3Reset();
        this.c4.j3Reset();
        this.c5.j3Reset();
        this.c6.j3Reset();
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Item.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.cls_page = d.css.intern("page");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Item.j3ui", CSS_Item, 578834665, true) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 355995193, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_page);
        let s2 = d.enter(0);
        let e2 = this.c1.update(d, ItemProps { ti: 3, label: "a" });
        d.leave(s2);
        let s3 = d.enter(1);
        let e3 = this.c2.update(d, ItemProps { ti: 1, label: "b" });
        d.leave(s3);
        let s4 = d.enter(2);
        let e4 = this.c3.update(d, ItemProps { ti: 2, label: "c" });
        d.leave(s4);
        let s5 = d.enter(3);
        let e5 = this.c4.update(d, ItemProps { ti: 0, label: "d" });
        d.leave(s5);
        let s6 = d.enter(4);
        let e6 = this.c5.update(d, ItemProps { ti: 0, label: "e" });
        d.leave(s6);
        let s7 = d.enter(5);
        let e7 = this.c6.update(d, ItemProps { ti: -1, label: "f" });
        d.leave(s7);
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.c2.destroy();
        this.c3.destroy();
        this.c4.destroy();
        this.c5.destroy();
        this.c6.destroy();
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let s2 = d.enter(0);
                this.c1.paint(d);
                d.leave(s2);
                let s3 = d.enter(1);
                this.c2.paint(d);
                d.leave(s3);
                let s4 = d.enter(2);
                this.c3.paint(d);
                d.leave(s4);
                let s5 = d.enter(3);
                this.c4.paint(d);
                d.leave(s5);
                let s6 = d.enter(4);
                this.c5.paint(d);
                d.leave(s6);
                let s7 = d.enter(5);
                this.c6.paint(d);
                d.leave(s7);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

