// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .play { position: relative; width: 100%; height: 100%; }\n    .arena { position: absolute; inset: 0; background: #224; }\n    .fps { position: absolute; top: 4px; left: 4px; }\n    .toasts { position: absolute; top: 30px; left: 4px; display: flex; flex-direction: column; }";
const LINE0_Screen: int = 24;

pub struct ScreenProps {
    state: &State;
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_canvas: int;
    cls_play: int;
    cls_arena: int;
    cls_fps: int;
    cls_toasts: int;
    cls_toast: int;
    c1: Settings;
    if1: int;
    cnt1: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_canvas: 0,
            cls_play: 0,
            cls_arena: 0,
            cls_fps: 0,
            cls_toasts: 0,
            cls_toast: 0,
            c1: Settings.new(mem),
            if1: -1,
            cnt1: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
        this.c1.j3Reset();
        this.if1 = -1;
        this.cnt1 = 0;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
        Settings.styles(css);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_canvas = d.tag("canvas");
        this.cls_play = d.css.intern("play");
        this.cls_arena = d.css.intern("arena");
        this.cls_fps = d.css.intern("fps");
        this.cls_toasts = d.css.intern("toasts");
        this.cls_toast = d.css.intern("toast");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 739170342, true) {
            ch = true;
        }
        if hotFile(css, "ui/Settings.j3ui", CSS_Settings, 576840868, true) {
            ch = true;
        }
        if hotFile(css, "ui/Stats.j3ui", CSS_Stats, 775119448, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let state = p.state;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_play);
        let n2 = d.open(0, this.tag_canvas, SCOPE_Screen);
        d.clsId(n2, this.cls_arena);
        d.close();
        if state.fps {
            let n3 = d.open(1, this.tag_div, SCOPE_Screen);
            d.clsId(n3, this.cls_fps);
            d.text(Text.scratch().add(`{state.frame}`).add(" FPS").str());
            d.close();
        }
        if !state.full {
            let n4 = d.open(2, this.tag_div, SCOPE_Screen);
            d.clsId(n4, this.cls_toasts);
            let s5 = d.enter(0);
            let m5 = state.toasts;
            this.cnt1 = m5;
            for i in 0..m5 {
                let n6 = d.open(i * 1 + 0, this.tag_div, SCOPE_Screen);
                d.clsId(n6, this.cls_toast);
                d.styleNumAt(n6, 0, "opacity", f32(0.5 + f32((state.frame + i) % 5) * 0.1), "ui/Screen.j3ui", 13, 36);
                d.text(Text.scratch().add("toast ").add(`{i}`).str());
                d.close();
            }
            d.leave(s5);
            d.close();
        }
        let b7 = -1;
        if state.frame < 0 {
            b7 = 0;
        } else if state.stats_open {
            b7 = 1;
        }
        if b7 != this.if1 {
            if this.if1 == 1 {
                this.c1.destroy();
            }
            this.if1 = b7;
            if b7 == 1 {
                this.c1.j3Reset();
            }
        }
        if b7 == 0 {
            let n8 = d.open(3, this.tag_div, SCOPE_Screen);
            d.text("never");
            d.close();
        } else if b7 == 1 {
            let s9 = d.enter(4);
            let e9 = this.c1.update(d, SettingsProps { state: state });
            d.leave(s9);
        }
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.c1.destroy();
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
                let n2 = d.paintNext(0);
                if n2 >= 0 {
                    d.paintBox(n2);
                    let pass2 = 0;
                    while d.paintChildren(pass2) {
                        pass2 += 1;
                    }
                    d.paintEnd(n2);
                }
                let n3 = d.paintNext(1);
                if n3 >= 0 {
                    d.paintBox(n3);
                    let pass3 = 0;
                    while d.paintChildren(pass3) {
                        pass3 += 1;
                    }
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(2);
                if n4 >= 0 {
                    d.paintBox(n4);
                    let pass4 = 0;
                    while d.paintChildren(pass4) {
                        let s5 = d.enter(0);
                        let m5 = this.cnt1;
                        for i in 0..m5 {
                            let n6 = d.paintNext(i * 1 + 0);
                            if n6 >= 0 {
                                d.paintBox(n6);
                                let pass6 = 0;
                                while d.paintChildren(pass6) {
                                    pass6 += 1;
                                }
                                d.paintEnd(n6);
                            }
                        }
                        d.leave(s5);
                        pass4 += 1;
                    }
                    d.paintEnd(n4);
                }
                let n8 = d.paintNext(3);
                if n8 >= 0 {
                    d.paintBox(n8);
                    let pass8 = 0;
                    while d.paintChildren(pass8) {
                        pass8 += 1;
                    }
                    d.paintEnd(n8);
                }
                let s9 = d.enter(4);
                this.c1.paint(d);
                d.leave(s9);
                pass1 += 1;
            }
            d.paintEnd(n1);
        }
    }
}

fn ScreenPaintHook(p: ptr) {
    let r = p as &Screen;
    r.paint(&r.dom);
}

