                            while d.paintChildren(pass8) {
                                pass8 += 1;
                            }
                            d.paintEnd(n8);
                        }
                        pass5 += 1;
                    }
                    d.paintEnd(n5);
                }
                let n9 = d.paintNext(2);
                if n9 >= 0 {
                    d.paintBox(n9);
                    let pass9 = 0;
                    while d.paintChildren(pass9) {
                        let n10 = d.paintNext(0);
                        if n10 >= 0 {
