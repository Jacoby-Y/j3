// ---- ui/Screen.j3ui
pub const SCOPE_Screen: int = 1;
const CSS_Screen: string = "    .screen { display: flex; flex-direction: column; gap: 12px; width: 100%; height: 100%; padding: 14px; }\n    .line { font-size: 14px; }\n    .big { font-size: 24px; }\n    .mid { vertical-align: middle; }\n    .warm glyph[type=key] { background: #fff1d6; border-color: #c07a10; color: #6a4300; border-radius: 2px; }\n    .warm glyph[type=pad] { background: #d02020; border-color: #7a0f0f; color: #ffffff; }";
const LINE0_Screen: int = 11;

pub struct ScreenProps {
}

pub struct ScreenEvents {
}

pub struct Screen {
    mem: &Arena;
    ready: bool;
    dm: int;
    p: &ScreenProps;
    css: &Css;
    dom: Dom;
    tag_div: int;
    tag_p: int;
    tag_glyph: int;
    cls_screen: int;
    cls_page: int;
    cls_line: int;
    cls_big: int;
    cls_mid: int;
    cls_warm: int;

    fn new(mem: &Arena): Screen {
        let ps = mem.alloc::<ScreenProps>(1);
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        uastyle.load(css);
        parse(css, THEME, "ui/theme.css", 0);
        Screen.styles(css);
        return Screen {
            mem: mem, ready: false, dm: 0, p: &ps[0],
            css: css, dom: Dom.new(mem, css),
            tag_div: 0,
            tag_p: 0,
            tag_glyph: 0,
            cls_screen: 0,
            cls_page: 0,
            cls_line: 0,
            cls_big: 0,
            cls_mid: 0,
            cls_warm: 0,
        };
    }

    fn j3Reset(this: &Screen) {
        let mem = this.mem;
        this.ready = false;
    }

    fn styles(css: &Css) {
        parseAt(css, CSS_Screen, "ui/Screen.j3ui", SCOPE_Screen, LINE0_Screen);
    }

    fn init(this: &Screen, d: &Dom) {
        this.ready = true;
        this.dm = d as int;
        this.tag_div = d.tag("div");
        this.tag_p = d.tag("p");
        this.tag_glyph = d.tag("glyph");
        this.cls_screen = d.css.intern("screen");
        this.cls_page = d.css.intern("page");
        this.cls_line = d.css.intern("line");
        this.cls_big = d.css.intern("big");
        this.cls_mid = d.css.intern("mid");
        this.cls_warm = d.css.intern("warm");
    }

    fn render(this: &Screen, size: Vec2, p: ScreenProps) {
        let d = &this.dom;
        if hotDue(this.css) {
            this.hot();
        }
        d.beginFrame(size);
        inputs.begin(d);
        let ev = this.update(d, p);
        d.layout();
        d.setPaintHook(ScreenPaintHook, this as ptr);
        d.paintAll();
        inputs.overlay(d);
        d.endFrame();
    }

    fn hot(this: &Screen) {
        let css = this.css;
        let ch = false;
        if hotFile(css, "ui/theme.css", THEME, 0, false) {
            ch = true;
        }
        if hotFile(css, "ui/Screen.j3ui", CSS_Screen, 597547889, true) {
            ch = true;
        }
        if ch {
            css.reset();
            css.hotWarn = 0;
            uastyle.load(css);
            parse(css, THEME, "ui/theme.css", 0);
            Screen.styles(css);
            this.dom.restyle();
            hotWarns(css);
        }
    }

    fn update(this: &Screen, d: &Dom, p: ScreenProps): ScreenEvents {
        let mounting = !this.ready;
        if mounting {
            this.init(d);
        }
        *this.p = p;
        let ev = ScreenEvents {  };
        let n1 = d.open(0, this.tag_div, SCOPE_Screen);
        d.clsId(n1, this.cls_screen);
        d.clsId(n1, this.cls_page);
        let n2 = d.open(0, this.tag_p, SCOPE_Screen);
        d.clsId(n2, this.cls_line);
        d.text("Press ");
        let n3 = d.open(0, this.tag_glyph, SCOPE_Screen);
        d.glyph(n3, "confirm", "", "");
        d.close();
        d.text(" to start, ");
        let n4 = d.open(1, this.tag_glyph, SCOPE_Screen);
        d.glyph(n4, "back", "", "");
        d.close();
        d.text(" to cancel.");
        d.close();
        let n5 = d.open(1, this.tag_p, SCOPE_Screen);
        d.clsId(n5, this.cls_line);
        d.text("Tabs: ");
        let n6 = d.open(0, this.tag_glyph, SCOPE_Screen);
        d.glyph(n6, "prev", "", "");
        d.close();
        d.text(" / ");
        let n7 = d.open(1, this.tag_glyph, SCOPE_Screen);
        d.glyph(n7, "next", "", "");
        d.close();
        d.text(", scroll: ");
        let n8 = d.open(2, this.tag_glyph, SCOPE_Screen);
        d.glyph(n8, "scroll", "", "");
        d.close();
        d.close();
        let n9 = d.open(2, this.tag_p, SCOPE_Screen);
        d.clsId(n9, this.cls_line);
        d.text("Jump ");
        let n10 = d.open(0, this.tag_glyph, SCOPE_Screen);
        d.glyph(n10, "", "Space", "y");
        d.close();
        d.text(", fire ");
        let n11 = d.open(1, this.tag_glyph, SCOPE_Screen);
        d.glyph(n11, "", "F", "rt");
        d.close();
        d.close();
        let n12 = d.open(3, this.tag_p, SCOPE_Screen);
        d.clsId(n12, this.cls_big);
        d.text("Hold ");
        let n13 = d.open(0, this.tag_glyph, SCOPE_Screen);
        d.clsId(n13, this.cls_mid);
        d.glyph(n13, "confirm", "", "");
        d.close();
        d.text(" to charge");
        d.close();
        let n14 = d.open(4, this.tag_p, SCOPE_Screen);
        d.clsId(n14, this.cls_big);
        d.clsId(n14, this.cls_warm);
        d.text("Warm ");
        let n15 = d.open(0, this.tag_glyph, SCOPE_Screen);
        d.clsId(n15, this.cls_mid);
        d.glyph(n15, "back", "", "");
        d.close();
        d.text(" theme");
        d.close();
        d.close();
        return ev;
    }

    fn destroy(this: &Screen) {
        if !this.ready {
            return;
        }
        this.ready = false;
    }

    fn paint(this: &Screen, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let pass1 = 0;
            while d.paintChildren(pass1) {
