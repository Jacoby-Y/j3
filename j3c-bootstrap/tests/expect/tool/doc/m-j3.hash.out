module j3.hash
    Stable content hashes. They never change between runs, builds, or machines: file
    fingerprints, cache keys, lock files. (`j3.cmp.hash` is a table mixer and may change.) Each has a one-shot
    function and an incremental hasher; feeding the same bytes in any pieces gives the same hash.
    let h = hash.xxh3_64(bytes);                 // fast, 64 bits
    let x = hash.Xxh3.new();
    x.update(part1); x.update(part2);
    let same = x.finish() == hash.xxh3_64(whole);
    let d = hash.sha256(bytes);                  // Sha256Sum; d.hex(&t) appends 64 hex digits
    `fnv1a64` is FNV-1a (64-bit), `xxh3_64` is XXH3 64-bit with seed 0 (xxHash 0.8, the same value
    as `XXH3_64bits`), `sha256` is FIPS 180-4 SHA-256. Any thread: hashers hold no shared state.

fn fnv1a64(b: []u8): u64
    FNV-1a 64-bit of `b`: tiny and byte at a time, fine for short keys; prefer `xxh3_64` for files.
struct Fnv1a64
    Incremental FNV-1a 64-bit.
    h: u64
    fn Fnv1a64.new(): Fnv1a64
        A hasher with no input yet.
    fn Fnv1a64.update(this: &Fnv1a64, b: []u8)
        Add `b` to the input.
    fn Fnv1a64.finish(this: &Fnv1a64): u64
        The hash of everything given so far (more `update` calls may follow).

struct Sha256Sum
    A SHA-256 digest.
    b: [32]u8
        The 32 bytes, most significant first as printed.
    fn Sha256Sum.hex(this: &Sha256Sum, t: &Text)
        Append the 64 lowercase hex digits to `t`.

fn sha256(b: []u8): Sha256Sum
    SHA-256 of `b`.
struct Sha256
    Incremental SHA-256.
    h: [8]u32
    buf: [64]u8
        The partial block.
    n: int
        Bytes in `buf`.
    total: int
        Bytes given so far.
    fn Sha256.new(): Sha256
        A hasher with no input yet.
    fn Sha256.update(this: &Sha256, b: []u8)
        Add `b` to the input.
    fn Sha256.finish(this: &Sha256): Sha256Sum
        The digest of everything given so far. The hasher is done after this: start a new one.

fn xxh3_64(b: []u8): u64
    XXH3 64-bit of `b` with seed 0, as `XXH3_64bits(b, len)` gives it.
struct Xxh3
    Incremental XXH3 64-bit (seed 0); `finish` equals `xxh3_64` of all the bytes given.
    acc: [8]u64
    buf: [256]u8
        Input not yet consumed; inputs up to 240 bytes stay here whole.
    buffered: int
    total: int
    stripes: int
        Stripes consumed in the current 16-stripe block.
    fn Xxh3.new(): Xxh3
        A hasher with no input yet.
    fn Xxh3.update(this: &Xxh3, b: []u8)
        Add `b` to the input.
    fn Xxh3.finish(this: &Xxh3): u64
        The hash of everything given so far (more `update` calls may follow).

