module j3.term — Terminal types shared by the ANSI parser and the cell grid: `Color`, `Attr` bits, `Style`, `Cell`.

fn: pushUtf8 decodeUtf8 paletteRgb
const: COLOR_DEFAULT COLOR_PALETTE COLOR_RGB ATTR_BOLD ATTR_DIM ATTR_ITALIC ATTR_UNDERLINE
    ATTR_BLINK ATTR_INVERSE ATTR_HIDDEN ATTR_STRIKE
struct Color: v default() palette() rgb() kind() index() r() g() b() operator==()
struct Style: fg bg attr plain() has() operator==()
struct Cell: cp style width link marks mark() blank()

