module j3.term.input
    Terminal input codec, both directions, pure (no OS calls).
    Decode (a TUI reading a raw tty): `Decoder.feed(bytes, nowMs)` appends bytes, then call `next(nowMs, &ev)` until it
    returns false. `ev` is one reused `Event` (check `ev.kind`): `EV_KEY` (`key`, `mods`, `cp` for `KEY_CHAR`),
    `EV_PASTE` (`text`, a view valid until the next `next` call), `EV_MOUSE` (`x`, `y` 0-based, `button`, `action`,
    `mods`), `EV_FOCUS` (`on`). Resize is not an event here (the screen polls the size).
    An incomplete sequence at the end of the buffer is held; `next` releases it only when `nowMs - lastFeedMs >=
    escTimeoutMs` (default 25): a lone ESC comes out as `KEY_ESC`, a truncated sequence as ESC plus its bytes as keys,
    a truncated UTF-8 character as U+FFFD. ESC followed by a key in the same read is Alt+key. Unknown or malformed
    sequences are consumed and dropped, so the stream never stalls. Bracketed paste is held until its end marker
    (which may be split across feeds) or `pasteTimeoutMs` of silence, then delivered as collected; content is verbatim, capped at `MAX_PASTE` (the excess is dropped).
    Choices: 0x7f is `KEY_BACKSPACE`, 0x08 is Backspace+Ctrl, 0x0d is `KEY_ENTER`, 0x0a is Ctrl+J (`KEY_CHAR` 'j'),
    0x00 is Ctrl+Space. `KEY_*` are plain ints (`KEY_F1 + n - 1` is Fn), `MOD_*` bits are xterm's param-1 bits.
    Allocation: only the buffers inside `Decoder` (reused; they grow with the largest paste).
    Encode (an emulator sending keys to the pty): `encodeKey`, `encodePaste`, `encodeMouse` append to a `Text`
    following the grid's mode bits (`j3.term.grid.MODE_*`: app cursor keys, bracketed paste, mouse, SGR).
    Any thread: a `Decoder` is one value for one stream; nothing is shared.

const KEY_NONE = 0

const KEY_CHAR = 1
    A character: `Event.cp` is its code point.

const KEY_ENTER = 2

const KEY_TAB = 3

const KEY_BACKSPACE = 4

const KEY_ESC = 5

const KEY_UP = 6

const KEY_DOWN = 7

const KEY_LEFT = 8

const KEY_RIGHT = 9

const KEY_HOME = 10

const KEY_END = 11

const KEY_PGUP = 12

const KEY_PGDN = 13

const KEY_INSERT = 14

const KEY_DELETE = 15

const KEY_F1 = 16
    `KEY_F1 + n - 1` is Fn, n in 1..=12.

const KEY_F12 = 27

const MOD_SHIFT = 1

const MOD_ALT = 2

const MOD_CTRL = 4

const EV_KEY = 1

const EV_PASTE = 2

const EV_MOUSE = 3

const EV_FOCUS = 4

const MB_LEFT = 0
    `Event.button` (and `encodeMouse`'s): 0..2 buttons, `MB_NONE` motion with no button, then wheels.

const MB_MIDDLE = 1

const MB_RIGHT = 2

const MB_NONE = 3

const MB_WHEEL_UP = 4

const MB_WHEEL_DOWN = 5

const MB_WHEEL_LEFT = 6

const MB_WHEEL_RIGHT = 7

const MA_PRESS = 0
    `Event.action`.

const MA_RELEASE = 1

const MA_MOVE = 2

const MA_WHEEL = 3

const MAX_PASTE = 8388608
    Longest paste kept, in bytes.

struct Event
    One decoded input event; which fields mean something depends on `kind`.
    kind: int = 0
    key: int = 0
    mods: int = 0
    cp: i32 = 0
    text: string = ""
        `EV_PASTE`: the pasted bytes, valid until the next `Decoder.next` call.
    x: int = 0
    y: int = 0
    button: int = 0
    action: int = 0
    on: bool = false
        `EV_FOCUS`: gained (true) or lost.

struct Decoder
    buf: Text
    pos: int
    paste: Text
    inPaste: bool
    lastFeedMs: int
        `nowMs` of the last `feed`.
    escTimeoutMs: int
        How long an incomplete sequence is held before it is released as keys.
    pasteTimeoutMs: int
        How long an open bracketed paste may go without bytes before it is delivered as is (default 1000).
    fn Decoder.new(arena: &Arena): Decoder
    fn Decoder.feed(this: &Decoder, bytes: []u8, nowMs: int)
        Append input bytes read at time `nowMs` (any monotonic millisecond clock).
    fn Decoder.next(this: &Decoder, nowMs: int, out: &Event): bool
        The next event into `out`; false when more bytes (or the timeout) are needed.
    fn Decoder.pasteStep(this: &Decoder, out: &Event): bool
    fn Decoder.takePaste(this: &Decoder, upto: int)
    fn Decoder.parseAt(this: &Decoder, p: int, out: &Event): int
    fn Decoder.plain(this: &Decoder, p: int, out: &Event): int
    fn Decoder.csi(this: &Decoder, p: int, out: &Event): int

const KEV_PRESS = 1
    `encodeKeyEvent` event types (kitty's numbers).

const KEV_REPEAT = 2

const KEV_RELEASE = 3

fn encodeKey(key: int, mods: int, cp: i32, modes: int, out: &Text)
    Append the bytes a key press sends. `modes` is `Grid.modes`: `MODE_CURSOR_KEYS`, and the kitty keyboard flags
    a program pushed (see `encodeKeyEvent`). `cp` is read for `KEY_CHAR`. Shift on `KEY_CHAR` is ignored by
    the legacy encoding (pass the shifted character).
fn encodeKeyEvent(key: int, mods: int, cp: i32, event: int, modes: int, out: &Text)
    Like `encodeKey` for a press, repeat or release (`KEV_*`). With no kitty flags in `modes` it is xterm's
    encoding (a release sends nothing). With flags (`j3.term.grid.kittyFlags`) it follows the kitty keyboard
    protocol: disambiguate (Esc and Ctrl/Alt combos as `CSI code;mods u`), event types (`mods:event`),
    alternate keys (`code:shifted` for Shift+letter), all keys as escapes, associated text (`;text`, with
    all-as-escapes). `KEY_CHAR`'s key code is `cp` lowercased; Shift+letter may pass either case.
    ponytail: no keypad, modifier-key or base-layout-key reports, and the shifted key is known for letters only.
fn encodePaste(s: string, modes: int, out: &Text)
    Append a paste to the child: wrapped in `ESC[200~ ... ESC[201~` when `MODE_PASTE` is on, raw otherwise.
    Any `ESC[201~` in `s` is removed (also one that removal would join), so pasted text cannot end the paste early.
fn encodeMouse(button: int, action: int, x: int, y: int, mods: int, modes: int, out: &Text)
    Append an SGR (1006) mouse report when the grid asked for one: `button` is `MB_*`, `action` `MA_*`, `x`/`y`
    0-based, `mods` `MOD_*`. Nothing is written when the mode does not want this event (no mouse mode or no SGR,
    motion without drag/any-motion mode, motion with no button without any-motion mode).
    Known limit: only SGR (1006) is encoded; the legacy X10/UTF-8 mouse encodings are not.
