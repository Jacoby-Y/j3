module j3.gfx.noise
    Tileable 2D noise for textures: value, gradient (Perlin), cells (Worley), and stripes,
    summed in octaves and shaped by modifiers, then colored by a ramp. Everything wraps at
    the texture's edge, so baked textures repeat without seams. The hash is a seeded
    permutation table (the code predates bitwise ops).
    Any thread: no module state, so a worker can use a value it owns (`j3c doc threads`).

const VALUE: int = 0
    Base patterns.

const PERLIN: int = 1

const CELLS: int = 2

const STRIPES: int = 3

const KINDS: int = 4

const SINGLE: int = 0
    How octaves combine.

const FBM: int = 1

const RIDGED: int = 2

const BILLOW: int = 3

const FRACTALS: int = 4

const NEAREST: int = 0
    What `CELLS` measures: distance to the nearest point, the second nearest, or the gap
    between them (cracks).

const SECOND: int = 1

const EDGES: int = 2

const CELL_MODES: int = 3

struct Noise
    kind: int
    fractal: int
    octaves: int
        1..8.
    lacunarity: int
        Frequency step between octaves; whole numbers keep the texture tiling.
    gain: f32
        Weight step between octaves.
    scale: f32
        Features across the texture; rounded so it tiles.
    seed: int
    warp: f32
        Domain warp strength, in features.
    cell: int
        `NEAREST`, `SECOND`, or `EDGES` for `CELLS`.
    contrast: f32
    brightness: f32
    invert: bool
    steps: int
        Posterize to this many levels; 0 or 1 is off.
    threshold: f32
        Hard cut: at or above is 1, below is 0. 0 is off.
    perm: []int
        Seeded permutation of 0..255, twice.

struct Ramp
    Color stops, positions ascending in 0..1.
    count: int
    pos: [4]f32
    color: [4]Vec3

fn make(seed: int, arena: &Arena): Noise
    Defaults: 4 octaves of Perlin fbm, 8 features across. The table lives in `arena`.
fn reseed(n: &Noise, seed: int)
    Shuffle the permutation table for `seed`.
fn ramp2(a: Vec3, b: Vec3): Ramp
    A two-stop ramp from `a` to `b`.
fn shade(r: &Ramp, t: f32): Vec3
    The ramp's color at `t` (0..1).
fn sample(n: &Noise, x: f32, y: f32): f32
    Noise at texture coordinates `x`, `y` (0..1 covers the texture once), in 0..1.
fn bake(n: &Noise, r: &Ramp, size: int, arena: &Arena): []u8
    Bake a `size` x `size` RGBA texture of `n` colored by `r`.
