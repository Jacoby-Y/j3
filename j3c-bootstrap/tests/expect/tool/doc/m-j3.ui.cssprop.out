module j3.ui.cssprop
    Property parsers for `j3.ui.css`: `parseVal` (one value for a property), `emit`, the box shorthands
    (`padding` `margin` `border` ...), `transition`, `animation`, text stroke, scrollbar color.

fn calcProp(prop: int): bool
    Properties `dom` resolves a `V_CALC` for (`lenOf`): insets, gap, sizes, margins, padding.
fn hasUrl(k: int, n: int): bool
    A `url()` token in `TOK[k..n)`?
fn parseCustom(p: &P, k: int, n: int, out: &Value): int
    One value of a custom property at `TOK[k]`: a color, length, number, angle (degrees), time (ms), or `var()`.
fn parseVal(p: &P, prop: int, k: int, n: int, out: &Value): int
    One value for `prop` at `TOK[k]`; returns tokens used, 0 on failure.
fn transitions(p: &P, n: int): bool
    `transition: <prop|all> <time> [<ease>] [<delay>], ...` (up to four).
fn hasListComma(p: &P, n: int): bool
    Does `TOK[0..n)` have a comma outside any function?
fn animation(p: &P, n: int): bool
    `animation: <name> <duration> <ease> <delay> <count|infinite> <direction> <fill>` in any order,
    one or several separated by commas (`MAX_ANIM`; later ones win a property they share).
fn animList(p: &P, prop: int, n: int): bool
    A comma list for one `animation-*` longhand (`animation-name: a, b`); the list cycles over the animations.
fn wideKind(p: &P, t: &Token): int
    The `V_*` kind of CSS-wide keyword token (only a whole value: the callers check that nothing else is around it) `t` (`inherit`, `initial`, `unset`, `revert`, `revert-layer`), 0 for any other token.
fn wideShort(p: &P, name: string, v: Value): bool
    `name: <keyword>` for a shorthand: the keyword on each longhand it sets (`all`: one `P_ALL`). False for a longhand or a name that is not one.
fn emit(p: &P, prop: int, v: Value)
fn box4(p: &P, base: int, n: int): bool
    1 to 4 values for the four sides or corners starting at `base`; `cat` is any prop in that group
    (picks the value parser).
fn borderSides(p: &P, first: int, count: int, n: int): bool
fn outline(p: &P, n: int): bool
    `outline: <width> <style> <color>` in any order; `none` turns it off. Width defaults to 3px like `border`, the style to solid.
fn decoration(p: &P, n: int): bool
    `text-decoration: <line>`: only the line keyword is kept (color and style words are accepted and ignored).
fn stroke(p: &P, n: int): bool
    `-webkit-text-stroke: <width> [<color>]` (either order).
fn wave(p: &P, n: int): bool
    `text-wave: <amplitude> <length> <period>` (J3 extension, see `P_WAVE_AMP`): `none` or `0` turns it off.
fn overflow2(p: &P, n: int): bool
    `overflow: x [y]`: one value sets both axes.
fn scrollbarColor(p: &P, n: int): bool
    `scrollbar-color: thumb track` (or `auto`).
