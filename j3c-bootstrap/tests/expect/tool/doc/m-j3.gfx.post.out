module j3.gfx.post
    Private GL post pipeline used by paint. Targets contain premultiplied RGBA8 pixels.
    Main thread only. No feedback: every pass has distinct source and destination textures.

fn beginLayer()
fn endLayer(f: []f32, box: []f32): u32
    Packed canonical effects, followed by screen-space perspective bounds. Returns 0 when the group drew nothing
    (nothing to composite); `OUTRECT` says which part of the surface the returned image covers.
fn target(w: int, h: int): int
fn targetTexture(handle: int): Texture
fn destroyTarget(handle: int)
fn beginTarget(handle: int)
fn endTarget()
fn shader(src: string): int
fn destroyShader(id: int)
fn projectTexture(tex: Texture, box: []f32, rx: f32, ry: f32, distance: f32): u32
fn composite(tex: u32, alpha: f32)
    A paint composite preserves the GL state at the same boundary as the preceding flush.
