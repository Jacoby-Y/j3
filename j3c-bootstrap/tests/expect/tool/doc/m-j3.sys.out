module j3.sys
    Process / OS. Numbers are linux amd64; the Windows and macOS layers take the same `O_*` flags and map them (`openMode`).
    Windows is sys_windows.j3; macOS is sys_macos.j3. The loader picks one for `[emit] target`.
    User game code calls these wrappers, never `@syscall`.

const AT_FDCWD: int = -100
    `statAt` dirfd meaning "relative to the working directory".

const PLATFORM: int = 0
    Which OS layer this is, fixed at compile time by `[emit] target`: compare it with the
    `PLATFORM_*` names (`if sys.PLATFORM == sys.PLATFORM_ANDROID { ... }`); the other branch is dropped.

const PLATFORM_LINUX: int = 0
    `PLATFORM` on Linux (desktop).

const PLATFORM_WINDOWS: int = 1
    `PLATFORM` on Windows.

const PLATFORM_MACOS: int = 2
    `PLATFORM` on macOS.

const PLATFORM_ANDROID: int = 3
    `PLATFORM` on Android.

const PLATFORM_WEB: int = 4
    `PLATFORM` in a browser (Emscripten, `wasm64-unknown-emscripten`).

const PLATFORM_NAME: string = "linux"
    `PLATFORM` as a word for logs and paths: "linux", "windows", "macos", "android", "web".

const ARCH: int = 0
    `ARCH_*` names of the CPU the program is built for (`if sys.ARCH == sys.ARCH_AARCH64 { ... }`); the other branch is dropped.
    The compiler sets it from the target triple (the host when there is no target); the value written here is a placeholder.

const ARCH_X86_64: int = 0
    `ARCH` on x86-64.

const ARCH_AARCH64: int = 1
    `ARCH` on 64-bit ARM (arm64).

const ARCH_X86: int = 2
    `ARCH` on 32-bit x86.

const ARCH_ARM: int = 3
    `ARCH` on 32-bit ARM.

const ARCH_RISCV: int = 4
    `ARCH` on RISC-V.

const ARCH_OTHER: int = 5
    `ARCH` on any other CPU.

const ARCH_NAME: string = "x86_64"
    `ARCH` as a word for logs: "x86_64", "aarch64", "x86", "arm", "riscv", "other".

const O_RDONLY: int = 0
    Open for reading only.

const O_WRONLY: int = 1
    Open for writing only.

const O_CREAT: int = 64
    Create the file if it does not exist.

const O_TRUNC: int = 512
    Truncate to empty when opening.

const SEEK_SET: int = 0
    Seek from the start of the file.

const SEEK_END: int = 2
    Seek from the end of the file.

const O_CLOEXEC: int = 524288
    `pipe` flag: close both ends in a child at `execve`.

const WNOHANG: int = 1
    `waitpid` flag: return 0 at once when the child is still running.

const SIGTERM: int = 15
    `kill` signal: ask to stop.

const SIGKILL: int = 9
    `kill` signal: stop now.

const O_RDWR: int = 2
    `open` flag: read and write.

const O_NOCTTY: int = 256
    `open` flag: a terminal device opened does not become the controlling terminal.

const SIGHUP: int = 1
    `kill` signal: the controlling terminal went away.

const POLLIN: int = 1
    `pollFds` events: readable, writable; results add hang-up and error.

const POLLOUT: int = 4

const POLLERR: int = 8

const POLLHUP: int = 16

fn write(fd: int, buf: ptr, n: int): int
    Write `n` bytes from `buf` to file descriptor `fd`.
fn open(path: ptr, flags: int): int
    Open `path` with `flags` (mode 0).
fn openMode(path: ptr, flags: int, mode: int): int
    Open `path` with `flags` and permission `mode`.
fn read(fd: int, buf: ptr, n: int): int
    Read up to `n` bytes from `fd` into `buf`.
fn close(fd: int): int
    Close file descriptor `fd`.
fn lseek(fd: int, off: int, whence: int): int
    Seek in `fd` by `off` relative to `whence`.
fn mmapAnon(len: int): ptr
    Anonymous private read/write mapping of `len` bytes.
fn munmap(p: ptr, len: int)
    Unmap a region previously returned by `mmapAnon`.
fn onExit(hook: fn())
    Run `hook` just before the process exits, normally or by panic (Linux: a panic runs it before the message is printed).
    One slot: a later call replaces the earlier hook. The hook must be safe to run twice and may run in a forked child
    that calls `exit`, so check `getpid()`. `j3.term.screen` uses it to restore the terminal.
fn monotonicMs(): int
    Milliseconds on a monotonic clock (any fixed origin); 0 where there is none.
fn exit(code: i32)
    Terminate the process with exit code `code`.
fn fork(): int
    Copy this process. 0 in the child, the child's pid in the parent, negative on failure.
    Only the calling thread is copied, so in a program with other threads (SDL, GL, `j3.thread`)
    the child may only make raw calls from this module (`dup2`, `chdir`, `execve`, `exit`)
    before `execve`: no allocation, no locks, no `j3.io`. `j3.proc` does this for you.
fn execve(path: ptr, argv: ptr, envp: ptr): int
    Replace this process with the program at `path` (NUL-terminated). `argv` and `envp` are
    NUL-terminated arrays of C string pointers. Returns only on failure, with `-errno`.
fn environ(): ptr
    The process environment: a NUL-terminated array of `NAME=value` C strings, as `execve` takes.
    libc's `environ` (found once per thread with `dlsym`), so `setenv` changes show; the envp the kernel
    put after argv when libc has none.
fn env(name: string): string
    Environment variable `name`, or "" when unset. Valid for the whole process.
fn setenv(name: string, value: string): bool
    Set environment variable `name` to `value`, replacing it, for this process: `env`, programs started
    afterwards (`j3.proc`) and C libraries loaded in it see the new value. False when `name` is empty or
    has `=` or a NUL, `value` has a NUL, or the OS refuses. Not thread-safe against another thread reading
    the environment at the same moment (like C's `setenv`): call it at startup.
fn pipe(fds: []i32, flags: int): int
    Make a pipe: `fds[0]` reads what `fds[1]` writes (`fds` holds at least 2). `flags` is 0 or
    `O_CLOEXEC`. Negative on failure.
fn dup2(from: int, to: int): int
    Make `to` a copy of `from` (closing `to` first). Negative on failure.
fn chdir(path: ptr): int
    Change the working directory to `path` (NUL-terminated). Negative on failure.
fn ioctl(fd: int, req: int, arg: ptr): int
    Device control `req` on `fd`; `arg` points at its argument. 0 or more on success, `-errno` on failure.
fn setsid(): int
    Start a new session with this process as leader and no controlling terminal. The new id, `-errno` on failure.
fn canExec(path: ptr): bool
    True when the file at `path` (NUL-terminated) exists and may be executed.
fn statAt(dir: int, path: ptr, out: []int): int
    `stat` of `path` (NUL-terminated), relative to directory fd `dir` (or `AT_FDCWD`), following
    symlinks. Fills `out` (3 slots): is-directory 1/0, size in bytes, mtime in unix seconds; a 4th
    slot, if present, gets is-symlink (always 0 here). `lstatAt` stats a final symlink itself.
fn lstatAt(dir: int, path: ptr, out: []int): int
    Like `statAt`, but a final symlink is not followed: the link itself, is-directory 0, size the
    length of its target path, and the optional 4th slot 1. A dangling link succeeds.
fn dirents(fd: int, buf: []u8): int
    Read directory entries of open dir `fd` into `buf` as `linux_dirent64` records
    (d_reclen u16 @16, d_name @19, NUL-terminated). Bytes read, 0 at the end.
fn rename(from: ptr, to: ptr): int
    Rename `from` to `to` (both NUL-terminated), replacing `to`. Same filesystem only.
fn unlink(path: ptr): int
    Delete the file `path` (NUL-terminated).
fn mkdir(path: ptr, mode: int): int
    Make directory `path` (NUL-terminated) with permission bits `mode` (e.g. 493, `0755`).
fn waitpid(pid: int, status: &i32, flags: int): int
    Wait for child `pid` (`flags` 0 blocks, `WNOHANG` polls) and store its raw status in `status`.
    The pid, 0 when `WNOHANG` and it still runs, negative on failure. `exitCode` decodes `status`.
fn exitCode(status: i32): int
    A `waitpid` status as a shell would show it: the exit code, or 128 + the signal that ended it.
fn kill(pid: int, sig: int): int
    Send `sig` to process `pid`. Negative on failure.
fn getpid(): int
    This process's id.
fn pollFds(fds: ptr, n: int, ms: int): int
    Wait up to `ms` (negative waits forever) for events on `n` `struct pollfd`s at `fds`
    (8 bytes each: i32 fd, i16 events, i16 revents). The count ready, 0 on timeout, negative on failure.
fn ignoreSigpipe(on: bool)
    Set `SIGPIPE` to ignored (`on`) or back to the default. Network and process code ignore it,
    so a write to a closed peer fails with an error instead of killing the program.
    `j3.proc` sets it back to the default in a child before `execve`.
fn errno(): int
    The last failed call's error number (`errno`).
fn dlopen(name: string): ptr
    Load the shared library `name` (`libssl.so.3`). 0 when it cannot be loaded.
fn dlsym(handle: ptr, name: string): ptr
    Address of `name` in a library from `dlopen`, also searching its dependencies. 0 when missing.
fn setThreadName(name: string)
    Name the current thread for panic messages. `msg` must outlive the thread.
fn panic(msg: string)
    Print `msg` to stderr and exit with code 101.
fn panicAt(file: string, line: int, msg: string)
    Print `file:line: msg` to stderr and exit with code 101.
fn argCount(): int
    How many arguments the process was given, including the program (`arg(0)`).
fn arg(i: int): string
    Argument `i`, or "" when `i` is out of range. `arg(0)` is the program.
    Slots are 8 bytes (LP64).
fn start()
    Entry from the host: run `main`, then exit 0.
fn exeDir(): string
    Directory of the running executable, no trailing slash (`readlink /proc/self/exe`). Valid until
    the next call; "" when it cannot be read.
const O_EXCL: int = 128
    `open` flag with `O_CREAT`: fail with `EEXIST` when the file is already there.

const LOCK_SH: int = 1
    `flock` operations: shared, exclusive, don't block (or it in), unlock.

const LOCK_EX: int = 2

const LOCK_NB: int = 4

const LOCK_UN: int = 8

const EINTR: int = 4
    `errno` values the io layer tells apart.

const EEXIST: int = 17

const EWOULDBLOCK: int = 11

fn fsync(fd: int): int
    Flush `fd`'s data and metadata to the disk.
fn flock(fd: int, op: int): int
    `flock(2)` on open `fd`: `LOCK_SH` or `LOCK_EX` (plus `LOCK_NB` to fail with `-EWOULDBLOCK`
    instead of waiting), or `LOCK_UN`. Locks belong to the open file, so they are released when
    every fd of it is closed (and conflict between two `open`s of one path in the same process).
fn rmdir(path: ptr): int
    Remove the empty directory `path` (NUL-terminated).
fn cwd(out: []u8): int
    The working directory written to `out`, no NUL: its length, or `-errno` (`-ERANGE` when `out` is too small).
    Linux, Windows (`GetCurrentDirectoryA`), macOS, Android, web.
fn pidfdOpen(pid: int): int
    An fd that becomes readable when process `pid` (a child) exits (Linux 5.3+). Close it after.
fn realpathTo(path: ptr, out: []u8): int
    The canonical absolute path of the existing `path` (NUL-terminated) written to `out`, no NUL:
    its length, or `-errno` (`-ENAMETOOLONG` when `out` is too small). Opens it `O_PATH` and reads
    the `/proc/self/fd` link, so `/proc` must be mounted. Linux and Windows (see `sys_windows/fs.j3`).
--- stderr
--- exit 0
