module j3.ui.toast
    Toast notifications: a few timed messages in stable slots. State only (no tree, no GL): the app
    keeps a `Toasts`, calls `push` when something happens and `tick(now)` each frame, and renders the
    slots in markup, so CSS does the look and motion:
    ```
    <div class="toasts">
    {#each 0..toasts.cap as i}
    {#if toasts.live(i)}
    <div class="toast" class:bad={toasts.kind(i) == 2} transition:fade={200}
    on:click={toasts.dismiss(i)}>{toasts.text(i)}</div>
    {/if}
    {/each}
    </div>
    ```
    with `.toasts { position: fixed; right: 16px; bottom: 16px; z-index: 1100; }` and an `animation`
    (`@keyframes`) on `.toast` for the slide in; `transition:fade` fades a toast out when its slot
    empties. A message keeps its slot until it ends, so one leaving does not move the others. The
    newest takes the first free slot; with none free it replaces the oldest. Text is copied (at most
    127 bytes).

const CAP: int = 6

const INFO: int = 0

const OK: int = 1

const BAD: int = 2

struct Toasts
    cap: int
    buf: []u8
    len: [6]int
    kinds: [6]int
    t0: [6]f32
    life: [6]f32
    on: [6]bool
    pushed: int
        Messages pushed so far (a counter for the app and tests).
    fn Toasts.new(): Toasts
        An empty set; owns its small buffer (kept for the life of the program).
    fn Toasts.push(this: &Toasts, msg: string, kind: int, ms: f32, now: f32): int
        Show `msg` of `kind` (`INFO`, `OK`, `BAD`) for `ms` from `now`. Returns the slot used.
    fn Toasts.tick(this: &Toasts, now: f32)
        Retire the toasts whose time is up.
    fn Toasts.live(this: &Toasts, i: int): bool
        Whether slot `i` shows a toast.
    fn Toasts.text(this: &Toasts, i: int): string
        The message in slot `i` (valid until the slot is reused).
    fn Toasts.kind(this: &Toasts, i: int): int
    fn Toasts.dismiss(this: &Toasts, i: int)
        Close slot `i` now (a click).
    fn Toasts.count(this: &Toasts): int
        Toasts showing.

