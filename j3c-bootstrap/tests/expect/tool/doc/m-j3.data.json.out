module j3.data.json
    JSON (RFC 8259): `parse` bytes into a `Json` tree, read it with `get` / `at` / `path`, build one
    with `obj` / `arr` / `str` / `num` and `set` / `push`, and `write` it back out. The tree and
    its strings live on the arena you pass. Reading never fails: a missing key, an index past the
    end, or the wrong kind gives the shared null node, whose `asStr` is "" and `asNum` is 0.
    let doc = json.parse(body, &arena)?;               // Result<&Json, JsonError>
    let text = doc.path("choices.0.message.content").asStr();
    let msg = json.obj(&arena);
    msg.set("role", json.str("user", &arena));
    let out = json.stringify(msg, &arena);              // {"role":"user"}
    Objects keep their keys in order; `get` is a linear scan. Numbers are `f64`.

enum Kind
    What a `Json` node holds.
    Null
    Bool
    Num
    Str
    Arr
    Obj

struct JsonError
    Why `parse` failed.
    at: int
        Byte offset of the problem in the input.
    msg: string
        What was wrong.

struct Json
    One JSON value. Read the field that matches `kind`, or use the `as*` methods, which never fail.
    kind: Kind
        Which value this is.
    b: bool
        `Bool` value.
    n: f64
        `Num` value.
    s: string
        `Str` value.
    items: List<&Json>
        `Arr` elements, or `Obj` values (in key order).
    keys: List<string>
        `Obj` keys, parallel to `items`.
    fn Json.get(this: &Json, key: string): &Json
        The value under `key` in an object, or null.
    fn Json.has(this: &Json, key: string): bool
        True when an object has `key`.
    fn Json.at(this: &Json, i: int): &Json
        Element `i` of an array (or the `i`th value of an object), or null.
    fn Json.len(this: &Json): int
        Elements of an array, entries of an object, else 0.
    fn Json.path(this: &Json, p: string): &Json
        Walk dot-separated keys and array indexes: `"choices.0.message.content"`. Null when any step is missing.
    fn Json.asStr(this: &Json): string
        The string, or "".
    fn Json.asNum(this: &Json): f64
        The number, or 0.
    fn Json.asInt(this: &Json): int
        The number cut to an `int`, or 0.
    fn Json.asBool(this: &Json): bool
        The bool, or false.
    fn Json.isNull(this: &Json): bool
        True for `null` and for anything missing.
    fn Json.set(this: &Json, key: string, v: &Json)
        Set `key` in an object to `v`, replacing an existing value.
    fn Json.push(this: &Json, v: &Json)
        Append `v` to an array.

fn obj(arena: &Arena): &Json
    A new empty object.
fn arr(arena: &Arena): &Json
    A new empty array.
fn str(s: string, arena: &Arena): &Json
    A string value (`s` is not copied).
fn num(n: f64, arena: &Arena): &Json
    A number value.
fn boolean(b: bool, arena: &Arena): &Json
    A bool value.
fn null(arena: &Arena): &Json
    A null value.
fn parse(src: []u8, arena: &Arena): Result<&Json, JsonError>
    Parse one JSON document (surrounding whitespace allowed, nothing else after it).
fn parseStr(src: string, arena: &Arena): Result<&Json, JsonError>
    `parse` for a string.
fn quote(s: string, t: &Text)
    Append `s` as a JSON string literal (quotes and escapes included) to `t`.
fn writeNum(n: f64, t: &Text)
    Append `n` as a JSON number: integers as integers, others as the shortest digits that read back
    to the same `f64`. NaN and infinities are not JSON; they write `null`.
fn write(j: &Json, t: &Text)
    Append `j` as compact JSON to `t`.
fn stringify(j: &Json, arena: &Arena): string
    `j` as compact JSON, on `arena`.
