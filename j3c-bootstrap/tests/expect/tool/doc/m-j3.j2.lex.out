module j3.j2.lex
    The j2 lexer: source text to tokens with line:col (1-based; col counts bytes). `//` comments,
    numbers (`42`, `0xff`, `1_000`, `2.5`, `1e9`), `"..."` strings (one line) and backtick
    strings (may span lines) with `{expr}` holes. A backtick string with holes becomes
    `TplHead` text, the hole's tokens, then `TplMid` text ... and `TplTail` text, so holes can
    hold anything, braces and other strings included. Errors are values, never panics.

enum Tok
    A token's kind. Operators and punctuation are named for their shape, keywords for their word.
    Eof
    Name
    Int
    Float
    Str
        A string with no holes; `s..e` is the raw text between the quotes.
    TplHead
        Backtick text up to the first `{` of a hole.
    TplMid
        Text between two holes.
    TplTail
        Text after the last hole, up to the closing backtick.
    LParen
    RParen
    LBrace
    RBrace
    LBrack
    RBrack
    Comma
    Semi
    Colon
    Dot
    DotDot
    Assign
    Eq
    Not
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    And
    Or
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    Let
    Const
    Fn
    Return
    If
    Else
    While
    For
    In
    Break
    Continue
    Match
    Pub
    Use
    Nil
    True
    False

struct Token
    kind: Tok
    s: int
        Source byte range: the whole token, or a string's text without its delimiters.
    e: int
    line: int
    col: int
    i: int
        `Tok.Int` value; 1 on a raw `Tok.Str`.
    f: f64
        `Tok.Float` value.

struct SyntaxError
    A lex or parse error. `text` is the full `file:line:col: message` line.
    file: string
    line: int
    col: int
    msg: string
    text: string

fn syntaxError(mem: &Arena, file: string, line: int, col: int, msg: string): SyntaxError
    An error at `line:col` of `file`, text on `mem`.
fn lex(file: string, src: string, mem: &Arena): Result<[]Token, SyntaxError>
    Tokens of `src`, ending with one `Tok.Eof`. `file` names the source in error text.
fn strText(src: string, tok: Token, mem: &Arena): string
    The text of a string token's raw range with escapes applied (a slice of `src` when it has none).
    A `Tok.Str` token's bytes: as written for a raw string (`i == 1`), else `decode`d.
fn decode(src: string, s: int, e: int, mem: &Arena): string
trait Sink
    What `quote` and `fmtFloat` write into: `j3.text.Text`, the VM's `Buf`, any type with these.
    fn push(this: &Self, b: u8)
    fn pushStr(this: &Self, s: string)
    fn pushInt(this: &Self, n: int)
fn quote<W: Sink>(t: &W, s: string)
    `s` in double quotes, escaped so the lexer reads it back as the same bytes. Into a `Text` or
    any other `Sink`.
fn escapeInto(t: &Text, s: string, close: u8)
    Append `s` with `\`, `close` and control bytes escaped; in backtick text (`close` is a
    backtick) `{` is escaped too.
fn escapeFor(c: u8, close: u8): string
    How byte `c` is written inside a string closed by `close`: "" when as itself.
fn fmtFloat<W: Sink>(t: &W, x: f64)
    A float as `str()` writes it: the shortest digits that read back, always with a `.` or an
    exponent (so the lexer reads a float again), `nan`, `inf`, `-inf`.
fn describe(t: &Text, src: string, tok: Token)
    How an error names `tok`: `end of file`, or its source text in backticks (cut at 24 bytes).
--- stderr
--- exit 0
