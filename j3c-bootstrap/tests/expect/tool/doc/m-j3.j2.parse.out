module j3.j2.parse
    The j2 parser: tokens to an AST by recursive descent. Errors are values with the text
    `file:line:col: expected X, found Y`; nothing here panics on any input, and nesting deeper
    than `MAX_DEPTH` is an error rather than a native stack overflow.
    The AST is flat: `Ast.nodes` holds every `Node`, children are node numbers (`a`, `b`, `c`,
    -1 for none) or a run of `Ast.kids` (`first`, `count`; read with `ast.kid(n, i)`). Every node
    has the `line:col` of its token: the first one of a statement or literal, the operator of a
    unary or binary expression, the `.` of a field, the `[` of an index, the `(` of a call.
    `print` writes an AST back as source that parses to the same tree.
    Shapes by `Kind` (fields not named are unused):
    Chunk kids: top-level statements
    Block kids: statements
    Let   s: name, a: value or -1, flags: F_PUB, F_CONST (a const always has a value)
    FnDecl / Fn  s: name ("" for a literal), kids: Name params, b: Block body,
    flags: F_PUB (decl), F_THIS (first param is `this`)
    Use   s: script name
    Assign op: Tok.Assign or Tok.PlusEq.., a: target (Name, Field or Index), b: value
    Expr  a: expression
    If    a: condition, b: Block, c: else (Block, If) or -1
    While a: condition, b: Block
    ForRange  s: variable, a: from, b: to (exclusive), c: Block
    ForIn     kids: one Name (value) or two (key or index, value), a: iterable, c: Block
    Break, Continue
    Return a: value or -1
    Match a: subject, kids: Arm (at least one)
    Arm   a: pattern (Int, Float, Str, True, False, Nil) or -1 for `_`, b: Block
    Nil True False; Int i; Float f; Str s (escapes applied); Name s
    Tpl   kids: Str text, expr, Str text, ..., Str text (odd kids are the holes)
    Unary op: Tok.Minus or Tok.Not, a
    Binary op: Tok.Plus .. Tok.Or (And, Or short-circuit), a, b
    Field a: object, s: name
    Index a: object, b: index
    Call  a: callee (a Field callee is a method call: `this` and the dot fallback), kids: args
    Table kids: Pair (s: key, a: value, flags: F_QUOTED when the key was written as a string)
    Array kids: elements

enum Kind
    What a node is; the shapes above say which fields each kind uses.
    Chunk
    Block
    Let
    FnDecl
    Use
    Assign
    Expr
    If
    While
    ForRange
    ForIn
    Break
    Continue
    Return
    Match
    Arm
    Nil
    True
    False
    Int
    Float
    Str
    Name
    Tpl
    Unary
    Binary
    Field
    Index
    Call
    Table
    Pair
    Array
    Fn

const F_PUB: int = 1

const F_CONST: int = 2

const F_THIS: int = 4

const F_QUOTED: int = 8

const MAX_DEPTH: int = 200
    Statements and expressions nested deeper than this are an error.

struct Node
    kind: Kind
    op: Tok
        The operator of an `Assign`, `Unary` or `Binary`.
    line: int
    col: int
    a: int
    b: int
    c: int
    first: int
    count: int
    flags: int
    i: int
    f: f64
    s: string

struct Ast
    file: string
    nodes: List<Node>
    kids: List<int>
    root: int
        The Chunk.
    fn Ast.node(this: &Ast, n: int): &Node
    fn Ast.kid(this: &Ast, n: int, i: int): int
        Child `i` of node `n`'s kid list.

fn parse(file: string, src: string, mem: &Arena): Result<Ast, SyntaxError>
    Parse `src` (named `file` in errors) into an AST on `mem`.
fn binaryPrec(k: Tok): int
    Binding power of a binary operator token, 0 when `k` is not one.
const PREC_UNARY: int = 6
    Unary operators bind tighter than every binary one.

const PREC_POSTFIX: int = 7
    Postfix operators and primaries.

fn print(ast: &Ast, mem: &Arena): string
    The source text of `ast`, on `mem`.
fn opText(k: Tok): string
    Source text of operator token `k`.
--- stderr
--- exit 0
