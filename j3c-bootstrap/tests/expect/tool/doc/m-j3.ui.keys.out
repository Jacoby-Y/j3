module j3.ui.keys
    Keyboard state for text widgets: which editing keys fired this frame (with key repeat), the
    text typed, and Shift / Ctrl. `poll` reads `j3.game`; `parse` builds the same thing from names
    (`"S+Left C+a Backspace"`) for headless tests. No GL; main thread only.

struct KeyIn
    What the keyboard did in one frame. A held key fires again after N ms, then every N ms.
    typed: string = ""
    context: bool = false
    comp: string = ""
        IME composition in progress (not yet part of the text).
    left: bool = false
    right: bool = false
    up: bool = false
    down: bool = false
    home: bool = false
    end: bool = false
    back: bool = false
    del: bool = false
    enter: bool = false
    esc: bool = false
    tab: bool = false
    space: bool = false
    a: bool = false
    c: bool = false
    v: bool = false
    x: bool = false
    z: bool = false
    y: bool = false
    b: bool = false
    i: bool = false
    pgup: bool = false
    pgdn: bool = false
    f2: bool = false
    f12: bool = false
    shift: bool = false
    ctrl: bool = false

struct Repeat
    Repeat timers for the keys `poll` watches.
    t0: [22]f32
    last: [22]f32
    held: [22]bool

fn newRepeat(): Repeat
fn poll(r: &Repeat, now: f32): KeyIn
    The keyboard this frame; `now` is the UI clock in ms.
fn parse(spec: string, typed: string): KeyIn
    Keys from names separated by spaces: `Left Right Up Down Home End Backspace Delete Enter Escape
    Tab Space PageUp PageDown F2 F12 Shift a c v x z y b i S+F10`, each optionally prefixed `S+` (Shift) and `C+` (Ctrl). Unknown names are ignored.
