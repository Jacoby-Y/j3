module j3.thread
    Threads, locks, a blocking queue, and a worker pool (pthreads on Linux, Win32 threads and SRW locks on Windows; the OS layer is `j3.threadsys`).
    Start with `j3c doc threads` (the rules, which modules are safe on a worker, common
    mistakes) and `j3c doc recipes threads` (a whole program). The idea: hand work over, do not
    share it. `Pool.parallelForEach(n, fn(lo, hi) { .. })` runs a closure over `0..n` and waits. GL, SDL, and `j3.gfx` / `j3.game` / `j3.scene3d` state are main-thread only.

fn cores(): int
    Logical cores, to size a `Pool`.
struct Thread
    A running thread. Fill it with `spawn`, wait for it with `join`.
    tid: int = 0
    f: fn(ptr)
    arg: ptr = 0
    name: string = ""

fn spawn(t: &Thread, name: string, f: fn(ptr), arg: ptr)
    Start `f(arg)` on a new thread named `name` (shown in panics; it must outlive the thread).
fn join(t: &Thread)
    Wait for the thread to finish.
struct Mutex
    Mutual exclusion. A zeroed `Mutex {}` is ready to use.
    w0: int = 0
    w1: int = 0
    w2: int = 0
    w3: int = 0
    w4: int = 0
    fn Mutex.lock(this: &Mutex)
    fn Mutex.unlock(this: &Mutex)
    fn Mutex.tryLock(this: &Mutex): bool
        True when it took the lock.

struct Cond
    Condition variable. A zeroed `Cond {}` is ready to use. Wait in a loop that rechecks the
    condition: a wait can return early.
    w0: int = 0
    w1: int = 0
    w2: int = 0
    w3: int = 0
    w4: int = 0
    w5: int = 0
    fn Cond.wait(this: &Cond, m: &Mutex)
        Release `m`, sleep until signalled, take `m` again. Hold `m` when calling.
    fn Cond.signal(this: &Cond)
    fn Cond.broadcast(this: &Cond)

struct Queue<T>
    Fixed-capacity ring of `T` shared between threads. `push` blocks while full, `pop` blocks
    while empty; `tryPush` and `tryPop` never block (use them on the frame thread). `close`
    wakes every waiter: pops drain what is left and then return `None`, pushes return false.
    m: Mutex
    notEmpty: Cond
    notFull: Cond
    items: []T
    head: int = 0
    len: int = 0
    closed: int = 0
    fn Queue<T>.create(arena: &Arena, cap: int): Queue<T>
        A queue of `cap` slots (at least 1) allocated from `arena`.
    fn Queue<T>.put(this: &Queue<T>, item: T)
    fn Queue<T>.take(this: &Queue<T>): T
    fn Queue<T>.push(this: &Queue<T>, item: T): bool
        Wait for room, then add `item`. False when the queue is closed.
    fn Queue<T>.tryPush(this: &Queue<T>, item: T): bool
        Add `item` if there is room.
    fn Queue<T>.pop(this: &Queue<T>): Option<T>
        Wait for an item. `None` once the queue is closed and empty.
    fn Queue<T>.tryPop(this: &Queue<T>): Option<T>
        The oldest item, or `None` right away.
    fn Queue<T>.count(this: &Queue<T>): int
        Items waiting right now.
    fn Queue<T>.close(this: &Queue<T>)
        No more pushes; wake everyone.

struct Job
    One unit of pool work: `f(arg)` runs on a worker.
    f: fn(ptr)
    arg: ptr

struct Pool
    Worker threads draining one `Queue` of jobs. Make one with `Pool.create` and keep the
    `&Pool`. After each job a worker rewinds its `memory.scratch` arena.
    jobs: Queue<Job>
    threads: []Thread
    ranges: []Range
    pending: int = 0
        Jobs submitted and not yet finished; touched only with atomics.
    m: Mutex
    idle: Cond
    fn Pool.create(arena: &Arena, workers: int, cap: int): &Pool
        Start `workers` threads (at least 1) over a queue of `cap` jobs. Everything lives in
        `arena`, which must outlive the pool.
    fn Pool.submit(this: &Pool, f: fn(ptr), arg: ptr)
        Queue `f(arg)`; blocks while the queue is full (use `trySubmit` on a frame thread). `arg`
        must stay valid until it runs.
    fn Pool.trySubmit(this: &Pool, f: fn(ptr), arg: ptr): bool
        Queue `f(arg)` if there is room and return true; false (nothing queued) when the queue
        is full or the pool is shut down. Never blocks, so a frame thread can call it: on false,
        keep the job and try again next frame. `arg` must stay valid until it runs.
    fn Pool.submitBoxed(this: &Pool, job: boxed closure())
        Queue a boxed closure (`fn[mem]() { .. }`, captures copied into arena `mem`); blocks while the
        queue is full. `mem` must outlive the job (`wait` before rewinding or freeing it), and the job
        runs on a worker, so what it reaches through captured pointers follows the usual thread rules.
    fn Pool.pendingJobs(this: &Pool): int
        Jobs submitted and not yet finished (queued or running). Never blocks.
    fn Pool.finished(this: &Pool)
        One job less pending; wake `wait` when it was the last.
    fn Pool.wait(this: &Pool)
        Block until every submitted job has finished.
    fn Pool.parallelFor(this: &Pool, n: int, f: fn(ptr, int, int), ctx: ptr)
        Run `f(ctx, lo, hi)` over `0..n` split into one range per worker, and wait. Call from
        one thread at a time. Have `f` write `out[i]` and reduce afterwards in index order.
    fn Pool.parallelForEach(this: &Pool, n: int, body: closure(int, int))
        `parallelFor` with a closure: `body(lo, hi)` runs on each worker range and the call
        returns after every range finished. Capture what you need; write `out[i]` and reduce
        afterwards in index order. Safe only because `parallelFor` waits: the closure's captured
        locals and the trampoline below live in this frame, which outlives every worker.
        `body` runs on several workers at once: write `out[i]` or use atomics for anything else you
        capture. Call from one thread at a time, never from inside a pool job (it waits on the shared
        `pending` count, which deadlocks, and the shared `ranges` slots would be overwritten).
        Prefer this over `parallelFor` + a ctx struct. No allocation beyond `parallelFor`'s.
    fn Pool.shutdown(this: &Pool)
        Finish queued jobs, stop the workers, and join them.

