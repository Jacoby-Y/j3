module j3.ui.csslex
    Tokenizer for `j3.ui.css`: `next(&lx)` returns the next `Token` (idents, numbers with units, hashes, strings, urls, functions, punctuation).
    Private to the CSS parser; `j3.ui.cssvalue` and friends are its callers.

const T_EOF: int = 0

const T_IDENT: int = 1

const T_HASH: int = 2

const T_NUM: int = 3

const T_PCT: int = 4

const T_STR: int = 5

const T_URL: int = 6

const T_FUNC: int = 7

const T_DELIM: int = 8

const T_COLON: int = 9

const T_SEMI: int = 10

const T_LBRACE: int = 11

const T_RBRACE: int = 12

const T_LPAREN: int = 13

const T_RPAREN: int = 14

const T_COMMA: int = 15

const T_LBRACK: int = 16

const T_RBRACK: int = 17

const T_AT: int = 18

struct Token
    kind: int
    s: int
        Text range in the source (ident name, hash name without `#`, string or url content).
    e: int
    ch: int
    f: f32
    us: int
        Unit range of a number.
    ue: int
    line: int
    col: int
    sp: bool
        Whitespace or a comment came before this token.

struct Lexer
    src: string
    pos: int
    line: int
    ls: int

fn next(lx: &Lexer): Token
--- stderr
--- exit 0
