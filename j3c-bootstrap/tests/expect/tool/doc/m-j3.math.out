module j3.math
    Gameplay math is f32. `float` (f64) is not used here.
    Any thread: no module state, so a worker can use a value it owns (`j3c doc threads`).

const PI: f32 = 3.1415927
    Ratio of a circle's circumference to its diameter.

const TAU: f32 = 6.2831855
    Full turn in radians (`2 * PI`).

fn sqrt(x: f32): f32
    Square root via `libm.sqrtf`.
fn sin(x: f32): f32
    Sine via `libm.sinf` (radians).
fn cos(x: f32): f32
    Cosine via `libm.cosf` (radians).
fn tan(x: f32): f32
    Tangent via `libm.tanf` (radians).
fn asin(x: f32): f32
    Arcsine via `libm.asinf` (radians).
fn acos(x: f32): f32
    Arccosine via `libm.acosf` (radians).
fn atan(x: f32): f32
    Arctangent via `libm.atanf` (radians).
fn atan2(y: f32, x: f32): f32
    Two-argument arctangent via `libm.atan2f` (radians).
fn floor(x: f32): f32
    Greatest integer not greater than `x`, via `libm.floorf`.
fn ceil(x: f32): f32
    Least integer not less than `x`, via `libm.ceilf`.
fn abs(x: f32): f32
    Absolute value via `libm.fabsf`.
fn exp(x: f32): f32
    e raised to `x`, via `libm.expf`.
fn log10(x: f32): f32
    Base-10 logarithm via `libm.log10f`.
fn absi(x: int): int
    Integer absolute value (`0 - x` when negative).
fn wrapi(x: int, n: int): int
    `x` wrapped into `[0, n)` for `n > 0`. `%` truncates (`-1 % 4 == -1`); this gives 3.
fn min(a: f32, b: f32): f32
    Lesser of two `f32` values.
fn max(a: f32, b: f32): f32
    Greater of two `f32` values.
fn mini(a: int, b: int): int
    Lesser of two integers.
fn maxi(a: int, b: int): int
    Greater of two integers.
fn clamp(x: f32, lo: f32, hi: f32): f32
    Clamp `x` into `[lo, hi]` using `min`/`max`.
fn clampi(x: int, lo: int, hi: int): int
    Clamp integer `x` into `[lo, hi]`.
fn lerp(a: f32, b: f32, t: f32): f32
    Linear interpolate from `a` to `b` by factor `t`.
fn sign(x: f32): f32
    Sign of `x`: `-1`, `0`, or `1`.
struct Mat4
    Column-major 4×4 transform matrix (OpenGL `glLoadMatrixf` layout).
    m: [16]f32
        Sixteen column-major elements.
    fn Mat4.identity(): Mat4
        Identity matrix.
    fn Mat4.mul(this: Mat4, other: Mat4): Mat4
        Matrix product `this * other`.
    fn Mat4.perspective(fov: f32, aspect: f32, near: f32, far: f32): Mat4
        Perspective projection; clamps tiny aspect ratios up to `0.01`.
    fn Mat4.lookAt(eye: Vec3, center: Vec3, up: Vec3): Mat4
        View matrix looking from `eye` toward `center` with world `up`.
    fn Mat4.ortho(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32): Mat4
        Orthographic projection; zero spans are treated as `1` to avoid divide-by-zero.
    fn Mat4.affineInverse(this: Mat4): Mat4
        Inverse of a rotation/scale/translation matrix (no projection). Identity when it
        squashes space flat.
    fn Mat4.inverseAffine(this: Mat4): Mat4
        Inverse of an affine matrix (bottom row 0, 0, 0, 1). A singular one gives identity.
    fn Mat4.transformPoint(this: Mat4, p: Vec3): Vec3
        Transform a point, dividing by `w` when it is neither 0 nor 1.
    fn Mat4.translate(x: f32, y: f32, z: f32): Mat4
        Translation matrix.
    fn Mat4.scale(x: f32, y: f32, z: f32): Mat4
        Non-uniform scale matrix.
    fn Mat4.rotate(axis: Vec3, radians: f32): Mat4
        Rotation about `axis` by `radians`, via quaternion.

struct Quat
    Unit quaternion (`w` real); converts to a pure rotation matrix.
    x: f32
        Imaginary X.
    y: f32
        Imaginary Y.
    z: f32
        Imaginary Z.
    w: f32
        Real part.
    fn Quat.identity(): Quat
        Identity rotation (`w = 1`).
    fn Quat.xyzw(x: f32, y: f32, z: f32, w: f32): Quat
        Construct from four components.
    fn Quat.fromAxisAngle(axis: Vec3, radians: f32): Quat
        Rotation of `radians` about a normalized `axis`.
    fn Quat.mul(this: Quat, other: Quat): Quat
        Quaternion product `this * other`.
    fn Quat.length(this: Quat): f32
        Euclidean length of the four components.
    fn Quat.normalize(this: Quat): Quat
        Unit quaternion, or identity if length is zero.
    fn Quat.rotate(this: Quat, v: Vec3): Vec3
        Rotate vector `v` by this quaternion.
    fn Quat.toMat4(this: Quat): Mat4
        4×4 rotation matrix with no translation (after normalizing).

struct Vec2
    Two-dimensional `f32` vector with operators and common helpers.
    x: f32
        X component.
    y: f32
        Y component.
    fn Vec2.new(x: f32, y: f32): Vec2
        Build from components.
    fn Vec2.operator+(this: Vec2, other: Vec2): Vec2
        Component-wise addition.
    fn Vec2.operator-(this: Vec2, other: Vec2): Vec2
        Component-wise subtraction.
    fn Vec2.operator*(this: Vec2, s: f32): Vec2
        Scale both components by scalar `s`.
    fn Vec2.operator==(this: Vec2, other: Vec2): bool
        Exact component equality.
    fn Vec2.length(this: Vec2): f32
        Euclidean length.
    fn Vec2.scale(this: &Vec2, s: f32)
        Multiply both components in place by `s`.
    fn Vec2.dot(this: Vec2, other: Vec2): f32
        Dot product with `other`.
    fn Vec2.normalize(this: Vec2): Vec2
        Unit vector in this direction, or unchanged if length is zero.
    fn Vec2.rotate(this: Vec2, radians: f32): Vec2
        Rotate by `radians` around the origin.
    fn Vec2.fromAngle(radians: f32): Vec2
        Unit vector at angle `radians` from the +X axis.

fn vec3FromVec4f(v: vec4f): Vec3
    The `x y z` lanes of a `vec4f` as a `Vec3` (the `w` lane is dropped).
struct Vec3
    Three-dimensional `f32` vector with operators and common helpers.
    x: f32
        X component.
    y: f32
        Y component.
    z: f32
        Z component.
    fn Vec3.toVec4f(this: Vec3, w: f32): vec4f
        `x y z w` as a `vec4f`, for SIMD code (`j3c doc lang`).
    fn Vec3.operator+(this: Vec3, other: Vec3): Vec3
        Component-wise addition.
    fn Vec3.operator-(this: Vec3, other: Vec3): Vec3
        Component-wise subtraction.
    fn Vec3.operator*(this: Vec3, s: f32): Vec3
        Scale all components by scalar `s`.
    fn Vec3.length(this: Vec3): f32
        Euclidean length.
    fn Vec3.dot(this: Vec3, other: Vec3): f32
        Dot product with `other`.
    fn Vec3.cross(this: Vec3, other: Vec3): Vec3
        Cross product with `other`.
    fn Vec3.normalize(this: Vec3): Vec3
        Unit vector in this direction, or unchanged if length is zero.
    fn Vec3.xy(this: Vec3): Vec2
        Drop Z and return `(x, y)` as a `Vec2`.
    fn Vec3.xyz(x: f32, y: f32, z: f32): Vec3
        Construct from three components.
    fn Vec3.zero(): Vec3
        The zero vector.
    fn Vec3.up(): Vec3
        Unit vector along +Y.

