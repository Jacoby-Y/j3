module j3.io
    Files and stdio. `io.j3` has whole-file read/write, `listDir`, `stat`, `rename`,
    `remove`, `makeDirs`, `diskSpace`; parts `io/fs.j3` (`writeFileAtomic`/`createAtomic`, `tempFile`/`tempDir`,
    `lockFile`/`tryLockFile`, `copyFile`, `walk`) and `io/stdio.j3` (buffered `Reader`/`Writer`,
    `stdin()`/`stdout()`). Path strings are `j3.io.path`, change watching `j3.io.watch`.
    Linux; other targets return `IoError.Other` where the OS call is missing.

enum IoError
    Why a file call failed.
    NotFound
        The path could not be opened for reading.
    Other
        Open, seek, or a short read/write.

fn printLn(s: string)
    Write `s` and a newline to stdout.
fn readFile(path: string, arena: &Arena): Result<[]u8, IoError>
    Read the whole file into `arena`, to end of file. `NotFound` if it cannot be opened. Files whose size is
    0 or unknown (`/proc/meminfo`, pipes) are read in growing chunks.
struct DiskSpace
    Sizes of the filesystem holding a path, in bytes (`diskSpace`).
    total: int
    free: int
        Unused, including blocks only root may write.
    available: int
        What this user can still write (`df` "Avail").

fn diskSpace(path: string): Result<DiskSpace, IoError>
    Total, free and available bytes of the filesystem holding `path` (`statvfs`; Windows `GetDiskFreeSpaceEx`,
    where `path` is a directory). `NotFound` if `path` does not exist; `Other` on Android, macOS and the web.
fn openPath(path: string, flags: int, mode: int): int
    `sys.openMode` with a string path: a file descriptor, negative on failure. `mode` (e.g. 420,
    `0644`) only matters with `O_CREAT`.
fn canExec(path: string): bool
    True when the file at `path` exists and may be executed (`sys.canExec` with a string path).
fn exists(path: string): bool
    True when `path` can be opened for reading.
fn writeFile(path: string, data: []u8): Result<int, IoError>
    Create or truncate `path` and write `data`. Returns the byte count.
struct DirEntry
    One file or directory, from `listDir` or `stat`.
    name: string
        Base name, no path.
    isDir: bool
    size: int
        Bytes.
    mtime: int
        Last modified, unix seconds.
    isLink: bool
        The entry itself is a symlink (`isDir`/`size`/`mtime` still describe its target, except from `lstat`).
    hidden: bool = false
        Windows `FILE_ATTRIBUTE_HIDDEN` (from `listDir`, `stat`, `lstat`, `walk`). Always false elsewhere: on Linux and
        macOS a hidden file is one whose name starts with `.`.

fn listDir(path: string, mem: &Arena): Result<[]DirEntry, IoError>
    Entries in `path` (no "." / ".."), names allocated in `mem`. Symlinks are followed for
    `isDir`/`size`/`mtime` (`isLink` says the entry is one; a dangling link gets the link's own
    fields); an entry that vanishes while listing is skipped. Not sorted.
fn stat(path: string): Result<DirEntry, IoError>
    `listDir`'s fields for one path, following symlinks (`isLink` false). `name` is `path` itself (not copied).
fn lstat(path: string): Result<DirEntry, IoError>
    Like `stat`, but for a symlink the link itself: `isLink` true, `size` the length of its target
    path, `isDir` false. A dangling link succeeds.
fn rename(from: string, to: string): Result<bool, IoError>
    Rename or move `from` to `to`, replacing `to` (rename(2): atomic, same filesystem only).
fn remove(path: string): Result<bool, IoError>
    Delete the file `path` (unlink(2); not a directory).
fn makeDirs(path: string): Result<bool, IoError>
    Make directory `path` and its missing parents (mkdir -p, mode 0755). Ok when it already is one.
    Splits on `/`, and on Windows on `\` too (`C:\Users\x/Game` works; the drive `C:` is skipped).
struct AtomicFile
    A file being written beside `path` that replaces it in one step on `commit`. Until then (and
    if the process dies first) `path` keeps its old contents; a crash can leave the temp file
    (`.<name>.tmp<pid>-...` in the same directory). `writeFileAtomic` is the one-call form.
    path: string
        The file to replace.
    tmp: string
        The temp file beside it.
    fd: int
        Open fd of `tmp` (-1 after `commit`/`abort`).
    fn AtomicFile.write(this: &AtomicFile, data: []u8): Result<bool, IoError>
        Append `data`. On failure the temp is removed (`abort`) and `path` is untouched.
    fn AtomicFile.commit(this: &AtomicFile): Result<bool, IoError>
        `fsync` the temp, close it, and rename it over `path`. On failure the temp is removed and
        `path` keeps its old contents.
    fn AtomicFile.abort(this: &AtomicFile)
        Drop the temp file; `path` is untouched. Safe to call twice.

fn createAtomic(dest: string, arena: &Arena): Result<AtomicFile, IoError>
    Start replacing `dest`: a new temp file in its directory (same filesystem, so the final
    `rename` is atomic), mode 0644. Names are allocated in `arena`.
fn writeFileAtomic(path: string, data: []u8): Result<int, IoError>
    Replace `path` with `data` atomically: readers see the old file or the new one, never a part.
    Temp file beside it, write, `fsync`, `rename`; on any failure the temp is removed and the old
    file stays. Returns the byte count.
struct TempFile
    A temp file from `tempFile`: its path and open read-write fd (close it with `sys.close`).
    path: string
    fd: int

fn tempRoot(): string
    The directory for temp files: `$TMPDIR`, else `%TEMP%` / `%TMP%` (Windows), else `/tmp`.
fn tempFile(dir: string, prefix: string, arena: &Arena): Result<TempFile, IoError>
    Create a new empty file `<dir>/<prefix><unique>` (mode 0644, never one that exists; `dir` ""
    is `tempRoot()`). Remove it yourself (`remove`).
fn tempDir(dir: string, prefix: string, arena: &Arena): Result<string, IoError>
    Create a new empty directory `<dir>/<prefix><unique>` (mode 0700; `dir` "" is `tempRoot()`)
    and return its path. Remove it yourself (`removeDir` once empty).
fn cwd(arena: &Arena): string
    The working directory as an absolute path copied to `arena` (`/home/me/proj`, `C:\Users\me\proj`), "" when it
    cannot be read. Linux, Windows, macOS, Android, web (`sys.cwd`).
fn removeDir(path: string): Result<bool, IoError>
    Delete the empty directory `path` (rmdir(2); `RemoveDirectoryA` on Windows). `Err` when it is missing or not empty.
struct FileLock
    An exclusive `flock` on a lock file, held until `unlock` (or the process ends). Advisory: it
    only stops others that lock the same path. Two locks on one path conflict even in one process.
    A `fork`ed child shares the lock until it closes `fd` or `execve`s (the fd is `O_CLOEXEC`).
    fd: int
    fn FileLock.unlock(this: &FileLock)
        Release the lock (closes the fd). Safe to call twice.

fn lockFile(path: string): Result<FileLock, IoError>
    Take the exclusive lock on `path`, waiting while another process holds it.
fn tryLockFile(path: string): Result<Option<FileLock>, IoError>
    Take the exclusive lock on `path` if it is free: `None` (without waiting) when someone holds it.
fn copyFile(from: string, to: string): Result<int, IoError>
    Copy the file `from` to `to` (created or truncated, mode 0644: permission bits are not
    copied). Returns the byte count. On a failure `to` may be partly written; copy to a temp and
    `rename`, or use `createAtomic`, when that matters.
fn walk(root: string, pattern: string, mem: &Arena): Result<[]DirEntry, IoError>
    Every file under `root`, recursively, whose path matches `pattern` (`path.glob`: `*` and `?`;
    "" matches all). A pattern without `/` is matched against the file name, one with `/` against
    the path relative to `root`. `name` of each entry is that relative path (`"a/b.j3"`), in
    `mem`. Sorted by name within each directory, a directory's files before its subdirectories'.
    Directories themselves are not returned, and symlinked directories are not entered (no
    cycles). A directory that cannot be listed is an error.
struct Reader
    Reads `fd` through `buf`. `stdin()` is the one for fd 0; `reader` makes others (pipes, files).
    fd: int
    buf: []u8
    at: int
        Unread bytes are `buf[at..end]`.
    end: int
    fn Reader.fill(this: &Reader): Result<int, IoError>
        Read more of the fd into the buffer (after the unread bytes): the count, 0 at the end.
    fn Reader.readLine(this: &Reader, arena: &Arena): Result<Option<string>, IoError>
        The next line without its `\n` (and a `\r` before it), copied to `arena`; any length.
        The last line may lack the `\n`. `None` at the end of input.
    fn Reader.readExact(this: &Reader, n: int, arena: &Arena): Result<[]u8, IoError>
        Exactly `n` bytes, copied to `arena`, from the buffer and then straight from the fd (a body
        split over many reads, or several messages in one read, both work). `Other` when the input
        ends first.

fn reader(fd: int, buf: []u8): Reader
    A `Reader` of `fd` using `buf` (its size bounds one `fill`, not a line).
struct Writer
    Writes to `fd` through `buf`; `flush` sends what is buffered. `stdout()` is the one for fd 1.
    fd: int
    buf: []u8
    len: int
        Buffered bytes are `buf[0..len]`.
    fn Writer.write(this: &Writer, data: []u8): Result<bool, IoError>
        Buffer `data` (written through when it does not fit). `Other` when the fd write fails.
    fn Writer.writeStr(this: &Writer, s: string): Result<bool, IoError>
        `write` of a string.
    fn Writer.flush(this: &Writer): Result<bool, IoError>
        Send every buffered byte to the fd (short writes looped, `EINTR` retried).

fn writer(fd: int, buf: []u8): Writer
    A `Writer` of `fd` using `buf`.
fn stdin(): &Reader
    The process's buffered stdin (fd 0, 64 KiB buffer). Do not mix with raw `sys.read` of fd 0.
fn stdout(): &Writer
    The process's buffered stdout (fd 1, 64 KiB buffer). Call `flush` after each message and
    before exit; `printLn` writes fd 1 directly, so flush before mixing them.
--- stderr
--- exit 0
