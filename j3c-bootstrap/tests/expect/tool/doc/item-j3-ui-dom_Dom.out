module j3.ui.dom

struct Dom
    The tree. Make one with `Dom.new`, keep it in a `let`, pass `&d`.
    at j3/ui/dom.j3:176 (embedded in j3c)
    mem: &Arena
    css: &Css
    nodes: List<Node>
    mnodes: List<MatchNode>
    frags: List<Frag>
    fragFree: List<Idx>
    boxes: List<Frag>
    boxFree: List<Idx>
    ob: List<OBox>
    pseg: List<BSeg>
    free: List<Idx>
    abs: List<Idx>
    relayout: List<Idx>
        Layout boundaries `markDirty` stopped at since the last `layout` (`layoutBounds` lays them out again).
    fonts: List<FontEnt>
    fi: []FItem
    fiTop: int
    gs: []f32
    gTop: int
    occ: []u8
