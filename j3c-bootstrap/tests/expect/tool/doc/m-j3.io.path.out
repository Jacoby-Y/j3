module j3.io.path
    Path strings. `join`, `normalize`, `dirname`, `basename`, `ext`, `isAbs` and `glob` only look at
    the bytes (`/` separated, Linux); `realpath` asks the OS.
    use j3.io.path;
    path.join("src", "main.j3", &arena)          // "src/main.j3"
    path.normalize("./a//b/../c/", &arena)       // "a/c"
    path.dirname("a/b.j3")                      // "a"
    path.ext("a/b.tar.gz")                      // ".gz"

fn isAbs(p: string): bool
    `p` starts with `/`.
fn join(a: string, b: string, arena: &Arena): string
    `a` then `b` with one `/` between. `b` when it is absolute or `a` is empty; `a` when `b` is empty.
    Not normalized (`join("a/", "../b")` is `"a/../b"`); pass the result to `normalize` for that.
fn normalize(p: string, arena: &Arena): string
    `p` without `.` parts, repeated or trailing `/`, and with each `name/..` pair removed, by the
    text alone (a symlink before `..` is not followed: `realpath` does that). A `..` that climbs
    above the start stays in a relative path (`"../a"`) and is dropped at the root (`"/.."` is `"/"`).
    `""` and `"a/.."` give `"."`.
fn dirname(p: string): string
    Everything before the last name: `"a/b"` gives `"a"`, `"a"` gives `"."`, `"/a"` and `"/"` give
    `"/"`, `"a/b/"` gives `"a"`. A view into `p`.
fn basename(p: string): string
    The last name: `"a/b.j3"` gives `"b.j3"`, `"a/b/"` gives `"b"`, `"/"` gives `"/"`, `""` gives `""`.
    A view into `p`.
fn ext(p: string): string
    The extension of `basename(p)` with its dot: `"a/b.tar.gz"` gives `".gz"`; `""` when there is
    none, for a leading-dot name (`".bashrc"`) and for `"."`/`".."`.
fn glob(pattern: string, text: string): bool
    `text` matches `pattern`, where `*` is any run of bytes (including `/`) and `?` any one byte.
    Linear backtracking, no recursion.
fn realpath(p: string, arena: &Arena): Option<string>
    The absolute path of the existing file or directory `p`, with every symlink, `.` and `..`
    resolved, copied to `arena`. `None` when `p` does not exist or cannot be opened; `sys.errno()` then
    says why. Linux and Windows (`GetFullPathNameA`: `.` and `..` folded against the working directory, links not
    resolved); `None` on other targets.
fn exePath(arena: &Arena): Option<string>
    The full path of the running executable, copied to `arena` (`sys.exePathTo`, retried with a bigger buffer for a
    long path). Linux: `/proc/self/exe` resolved like `realpath`, so None once the file was deleted or replaced;
    Windows: `GetModuleFileNameW` as UTF-8; macOS: `_NSGetExecutablePath`. None when it cannot be read.
