module j3.term.grid
    The terminal screen model: an xterm-256color-style cell grid that implements `ansi.Sink`, so
    `parser.feed(bytes, &grid)` (after `use j3.term.ansi.feed;`) is the whole emulator core.
    Model: rows x cols `Cell`s, a cursor with xterm's deferred wrap, a pen `Style`, scroll region, tab stops, modes,
    a primary and an alt buffer, a scrollback ring (primary only), per-row dirty bits, title, OSC 8 link table.
    Replies to DSR/DA queries are appended to `reply`; the host writes `reply.str()` to the pty, then `reply.clear()`.
    Rows are stored through a row-index permutation, so a scroll rotates a few ints and blanks one row: no copying
    the screen and no allocation per line.
    Resize reflows the primary screen and scrollback: rows that wrapped by printing past the last column (`wrapped`) are
    joined and split again at the new width (the alt screen is cut or padded).
    Not implemented on purpose: 132-column mode (?3), DECALN, DECSED/DECSEL, SO/SI and G1-G3
    (only G0 with the DEC line-drawing set), LNM (CSI 20 h), more than 2 combining marks per cell or marks outside the BMP
    (dropped),
    mouse encodings other than SGR, DCS. APC is kitty graphics only (`grid/kitty.j3`).
    Any thread: a `Grid` is one value for one screen; nothing is shared.
    Memory: the screens, the scrollback and reflow scratch live in arenas the grid owns, so `resize` frees what it
    replaces and memory follows the current size, however many resizes there were. The arena given to `new` only holds
    small fixed bookkeeping (about 33 bytes per scrollback line of capacity, link URIs, headers). Each screen cell
    costs 24 bytes (two screens of `maxCols x maxRows`). A scrollback line is stored trimmed of trailing default
    blanks, about 4 bytes per used cell (+12 at each style or link change, +4 per cell with combining marks).
    `destroy` frees the owned storage.
    Coordinates are 0-based and `(x, y)` is column, row. Rows of the visible screen are `0..rows()`; the virtual
    line list for scrollback is `0..lineCount()` with line 0 the oldest scrollback line.

const MODE_WRAP = 1
    `Grid.modes` bits (`Grid.mode(bit)` reads one).

const MODE_ORIGIN = 2

const MODE_INSERT = 4

const MODE_CURSOR_KEYS = 8
    `?1`: the host should send application cursor keys (`ESC O A`).

const MODE_KEYPAD = 16
    `ESC =` / `ESC >`: application keypad.

const MODE_CURSOR = 32
    `?25`.

const MODE_PASTE = 64
    `?2004`.

const MODE_MOUSE_CLICK = 128
    `?1000`, `?1002`, `?1003`: report clicks / drags / all motion. `?1006`: encode as SGR.

const MODE_MOUSE_DRAG = 256

const MODE_MOUSE_MOVE = 512

const MODE_MOUSE_SGR = 1024

const MODE_FOCUS = 2048
    `?1004`.

const MODE_SYNC = 4096
    `?2026` synchronized output: the program is mid-frame, keep showing the last whole one (`syncHeld`).

const SYNC_TIMEOUT_MS = 150
    Longest a `?2026 h` holds the screen before `syncHeld` lets go by itself (ms).

const MODE_MOUSE_ANY = 128 + 256 + 512
    The mouse tracking bits together.

const MODE_KITTY_SHIFT = 16
    Kitty keyboard protocol flags (`CSI > flags u` and friends) live in `modes` bits 16..20: read them with
    `kittyFlags(modes)`. `KITTY_*` are those flag bits.

const MODE_KITTY_MASK = 31 << 16

const KITTY_DISAMBIGUATE = 1

const KITTY_EVENT_TYPES = 2

const KITTY_ALTERNATE_KEYS = 4

const KITTY_ALL_AS_ESCAPES = 8

const KITTY_TEXT = 16

fn kittyFlags(modes: int): int
    The kitty keyboard flags inside a `Grid.modes` value (0 when the program pushed none).
const MAX_LINKS = 1024
    Most distinct OSC 8 URIs kept (link ids `1..=MAX_LINKS`); later new ones print unlinked.

const MAX_URI = 2048
    Longest URI kept in bytes; a longer link prints unlinked.

const MAX_TITLE = 256
    Title bytes kept.

struct Buf
    One buffer's storage: `cells` is `maxRows` physical rows of `maxCols` cells; logical row `y` is physical row
    `ridx[y]`. `dirty` and `wrap` (the row continues on the next: printing wrapped past its end) are per physical row.
    `tmp` is scratch for rotations.
    cells: []Cell
    ridx: []int
    dirty: []u8
    wrap: []u8
    tmp: []int

struct Saved
    DECSC / DECRC state (also what ?1049 keeps).
    x: int
    y: int
    pen: Style
    origin: bool
    pending: bool
    draw: bool

struct Grid
    ncols: int
        Current size. Use `cols()` / `rows()`.
    nrows: int
    maxCols: int
        Storage limits; `resize` within them does not allocate.
    maxRows: int
    pri: Buf
    altb: Buf
    isAlt: bool
    cx: int
        Cursor and the deferred-wrap flag: after a print in the last column the cursor stays there with this set.
    cy: int
    wrapPending: bool
    pen: Style
        The style new cells get (`ansi.sgr` edits it) and the active OSC 8 link id (0 none).
    link: int
    top: int
        Scroll region rows, inclusive.
    bot: int
    tabs: []u8
        `tabs[x]` is 1 at a tab stop.
    modes: int
    saved: Saved
    saved1049: Saved
    drawG0: bool
        G0 is the DEC line-drawing set.
    lastCp: i32
        For REP.
    kbd: []int
        Kitty keyboard flag stacks, 8 entries per screen (`[0..8)` primary, `[8..16)` alt); the top is at
        `kbdPri` / `kbdAlt` and is mirrored into `modes` (see `kittyFlags`).
    kbdPri: int
    kbdAlt: int
    syncAt: int
        `ticks` ms of the first `syncHeld` call after `?2026 h` (-1: not seen yet).
    cursorShape: int
        DECSCUSR value 0..6 (0 and 1 blinking block, 2 steady block, 3/4 underline, 5/6 bar).
    reserves: int
        How many times storage has grown past its limits (see `reserve`).
    bells: int
        BELs seen; the host compares with its last value.
    sbStart: []int
        Scrollback (`grid/sb.j3`): `sbCap` line slots, slot `(sbHead + i) % sbCap` is line `i`, oldest first. Slot
        metadata is fixed: where the line's record starts in `sbRing`, its length in words, the width it had, and
        whether it continues on the next line (see `Buf.wrap`). `sbRing` is a ring of variable-length records in
        `sbMem`: live words are `[sbH, sbT)`, or `[sbH, sbE)` then `[0, sbT)` when `sbWr`.
    sbWords: []int
    sbWidth: []int
    sbWrap: []u8
    sbHead: int
    sbCount: int
    sbCap: int
    sbRing: []u32
    sbMem: &Arena
    sbH: int
    sbT: int
    sbE: int
    sbWr: bool
    own: &Arena
        The screens, tabs and `lnBuf`; replaced whole when storage grows.
    lnBuf: []Cell
        `line` decodes scrollback lines here (`maxCols` cells).
    reply: Text
        Bytes for the host to write to the child (DSR, DA). Drain with `reply.str()` then `reply.clear()`.
    title: Text
        OSC 0 / 2.
    links: List<string>
        OSC 8 URIs; `Cell.link` n is `links.items[n - 1]`.
    arena: &Arena
    kimgs: List<KImage>
        Kitty graphics (`grid/kitty.j3`): images, placements, the chunked transfer in progress, the cell size in
        pixels that sizes placements (the host sets `cellPxW`/`cellPxH`; `View.draw` does).
    kplaces: List<KPlace>
    kSerial: int
    kNextId: int
    kLoading: bool
    kBad: bool
    kPend: KCmd
    kmem: &Arena
    kbuf: []u8
    kn: int
    cellPxW: int
    cellPxH: int
    rfCells: []Cell
        Reflow scratch (`resize/reflow`): logical lines' cells, their starts and lengths, one output row. In an arena
        made for one reflow and freed after it; empty between reflows.
    rfStart: []int
    rfLen: []int
    rfRow: []Cell
    fn Grid.new(arena: &Arena, cols: int, rows: int, scrollback: int): Grid
        A cleared `cols` x `rows` screen with room for `scrollback` lines. Storage limits are
        `max(cols, 200)` x `max(rows, 60)` (24 bytes per cell, two screens; grid-owned, see `destroy`). The scrollback
        costs 33 bytes per line of capacity in `arena` plus about 4 bytes per used cell of each stored line.
    fn Grid.withLimits(arena: &Arena, cols: int, rows: int, scrollback: int, maxCols: int, maxRows: int): Grid
        Like `new` with explicit storage limits for `resize` (`maxCols >= cols`, `maxRows >= rows`). Past them,
        `resize` moves the screens to bigger storage and frees the old.
    fn Grid.destroy(this: &Grid)
        Free the storage the grid owns (screens, scrollback, kitty images). The grid must not be used after; the
        arena given to `new` still holds the bookkeeping and is the caller's to destroy.
    fn Grid.cols(this: &Grid): int
        Columns.
    fn Grid.rows(this: &Grid): int
        Rows of the visible screen.
    fn Grid.mode(this: &Grid, m: int): bool
        Whether mode bit `m` (`MODE_*`) is on.
    fn Grid.cursorX(this: &Grid): int
    fn Grid.cursorY(this: &Grid): int
    fn Grid.cursorVisible(this: &Grid): bool
    fn Grid.syncHeld(this: &Grid, nowMs: int): bool
        Whether a synchronized update (`?2026 h`) is in progress at `nowMs` (any clock in ms, e.g. `game.ticks()`):
        the host should keep showing its last frame. The hold starts at the first call after `?2026 h` and ends at
        `?2026 l` or after `SYNC_TIMEOUT_MS`, which clears the mode so a crashed program cannot freeze the screen.
    fn Grid.altScreen(this: &Grid): bool
        Whether the alt screen is showing.
    fn Grid.cell(this: &Grid, x: int, y: int): Cell
        The cell at column `x`, row `y` of the visible screen (a blank cell when out of range).
    fn Grid.rowCells(this: &Grid, y: int): []Cell
        Row `y` of the visible screen as `cols()` cells, in place (valid until the next scroll, resize or print).
        The cheap path for a renderer; empty when `y` is out of range.
    fn Grid.scrollbackLen(this: &Grid): int
        Scrollback lines held (0 on a grid made with 0 scrollback).
    fn Grid.lineCount(this: &Grid): int
        Scrollback plus screen rows: the size of the virtual line list.
    fn Grid.line(this: &Grid, i: int): []Cell
        Virtual line `i`: `0..scrollbackLen()` is scrollback, oldest first (its length is the width it had when it
        scrolled off or was reflowed, which may differ from `cols()`), then the screen rows. Empty when out of range.
        A scrollback line is decoded into a buffer the grid reuses: valid until the next `line` / `viewLine` call.
    fn Grid.wrapped(this: &Grid, i: int): bool
        Whether virtual line `i` (see `line`) wrapped into line `i + 1` by printing past its end, so a copy should join
        them without a newline. False when out of range.
    fn Grid.viewLine(this: &Grid, off: int, y: int): []Cell
        Row `y` of a viewport scrolled back `off` lines from the live screen (`off` 0 is `rowCells(y)`; `off` is
        clamped to `0..scrollbackLen()`). The primary screen only: on the alt screen there is no scrollback, so
        it is `rowCells(y)`.
    fn Grid.isDirty(this: &Grid, y: int): bool
        Whether logical row `y` changed since `clearDirty`. A scroll marks the whole region.
    fn Grid.anyDirty(this: &Grid): bool
        Whether any row is dirty.
    fn Grid.markAllDirty(this: &Grid)
        Mark every row dirty (a renderer after it lost its target, a switch of view offset).
    fn Grid.clearDirty(this: &Grid)
        Clear the dirty bits (both buffers).
    fn Grid.linkUri(this: &Grid, id: int): string
        The URI of link id `id` (a `Cell.link`), or "" for 0 or an unknown id.
    fn Grid.bufp(this: &Grid): &Buf
        The buffer on screen.
    fn Grid.rowStart(this: &Grid, y: int): int
        Index in `Buf.cells` of the first cell of logical row `y`.
    fn Grid.touch(this: &Grid, y: int)
    fn Grid.erased(this: &Grid): Cell
        What erasing leaves: an empty cell with the pen's background (BCE), nothing else.
    fn Grid.resetTabs(this: &Grid)
    fn Grid.splitAt(this: &Grid, s: int, x: int)
        Make sure no wide character straddles the boundary between columns `x - 1` and `x` of the row at `s`:
        if `x` is a right half, both halves are blanked.
    fn Grid.killHalf(this: &Grid, s: int, x: int)
        Before overwriting column `x` of the row at `s`: blank the other half of a wide character there.
    fn Grid.eraseRow(this: &Grid, y: int, a: int, b: int)
        Erase columns `a..b` of logical row `y` (clamped), repairing wide characters at the edges.
    fn Grid.blankPhys(this: &Grid, p: int)
        Blank physical row `p` (the visible columns) and mark it dirty.
    fn Grid.pushSb(this: &Grid, p: int)
        Copy physical row `p` of the primary buffer into the scrollback ring.
    fn Grid.scrollRegion(this: &Grid, t: int, bt: int, n: int, up: bool, sb: bool)
        Scroll rows `t..=bt` up (`up`) or down by `n` (clamped to the region height); the rows that open up are
        blank. With `sb`, rows that leave the top of a full-screen region on the primary buffer go to scrollback.
        Rotates row indexes; touches only the blanked rows' cells.
    fn Grid.index(this: &Grid)
        IND: down one row, scrolling the region at its bottom margin; nothing below the region's last row.
    fn Grid.reverseIndex(this: &Grid)
        RI: up one row, scrolling the region down at its top margin.
    fn Grid.insertCells(this: &Grid, n0: int)
        Shift the cursor row's cells from `cx` right by `n` (clamped), blanking the gap.
    fn Grid.deleteCells(this: &Grid, n0: int)
        Delete `n` (clamped) cells at `cx`, pulling the rest of the row left.
    fn Grid.rowLo(this: &Grid): int
        Lowest and highest row the cursor may be moved to by absolute addressing (the region under origin mode).
    fn Grid.rowHi(this: &Grid): int
    fn Grid.moveTo(this: &Grid, x: int, y: int)
        CUP with 0-based `x` and `y` (`y` relative to the region under origin mode), clamped. Clears the pending wrap.
    fn Grid.replyCsi(this: &Grid)
        Append `ESC [` to the reply buffer.
    fn Grid.csi(this: &Grid, p: &Params, final: u8)
        Sink: a CSI sequence. Unknown ones are ignored.
    fn Grid.kittyKeyboard(this: &Grid, p: &Params)
        Kitty keyboard protocol: `CSI > f u` push, `CSI < n u` pop, `CSI = f ; m u` set (1 all, 2 or, 3 and-not),
        `CSI ? u` query (replies `CSI ? flags u`). The stack belongs to the screen showing (primary or alt).
    fn Grid.syncKbd(this: &Grid)
        Copy the showing screen's kitty flags into `modes`.
    fn Grid.eraseDisplay(this: &Grid, m: int)
        ED/EL/ECH keep the pending-wrap flag (the cursor does not move); ICH/DCH/IL/DL clear it.
        ED: 0 cursor to end, 1 start to cursor, 2 all, 3 all and the scrollback. The cursor stays.
    fn Grid.eraseLine(this: &Grid, m: int)
        EL: 0 cursor to end, 1 start to cursor, 2 whole line.
    fn Grid.dumpText(this: &Grid, arena: &Arena): string
        The screen as text: rows joined by `\n`, trailing spaces trimmed, no cursor. Allocates on `arena`.
    fn Grid.dumpStyled(this: &Grid, arena: &Arena): string
        Like `dumpText` but marking style changes (see `lineText`).
    fn Grid.dump(this: &Grid, arena: &Arena, styled: bool): string
    fn Grid.lineString(this: &Grid, i: int, arena: &Arena): string
        Virtual line `i` (scrollback then screen, see `line`) as trimmed text.
    fn Grid.apc(this: &Grid, bytes: string)
        Sink: an APC string. Only kitty graphics (`G...`) is read.
    fn Grid.kStart(this: &Grid)
        A fresh load buffer in `kmem` (its old blocks unmapped).
    fn Grid.kAppend(this: &Grid, data: string)
        Base64-decode `data` onto the load buffer.
    fn Grid.kFinish(this: &Grid, c: &KCmd)
        The transfer is complete: read, decode and store (or just check, for `a=q`) the image, then place it for `a=T`.
    fn Grid.kReply(this: &Grid, c: &KCmd, msg: string, err: bool)
        `ESC _ G i=..[,I=..][,p=..];msg ESC \` when the command named an image and `q` allows it.
    fn Grid.kFind(this: &Grid, id: int, num: int): int
        Index in `kimgs` of image `id`, else the newest with number `num` (0 skips that test); -1 when none.
    fn Grid.kDropImage(this: &Grid, k: int)
        Free image `k` and its placements.
    fn Grid.kPlace(this: &Grid, k: int, c: &KCmd)
        Put image `k` at the cursor, then move the cursor past it unless `C=1`.
    fn Grid.kDelete(this: &Grid, c: &KCmd)
        `a=d`: placements by `d` (`a` all on this screen, `i` by id and `p`, `n` by number, `c` at the cursor); the
        uppercase letter also frees images left with no placement.
    fn Grid.kFreeUnplaced(this: &Grid)
        Drop images no placement shows.
    fn Grid.kScroll(this: &Grid, n: int, up: bool)
        A full-screen scroll of `n` rows (`up`) on the showing screen: its placements move with the text; those
        past the scrollback (or off the bottom) go.
    fn Grid.kClear(this: &Grid, all: bool)
        ED 2 (`all` false: placements on the screen) and ED 3 / RIS (`all`: every one of this screen).
    fn Grid.kittyPlacements(this: &Grid): []KPlace
        Every placement (both screens): `View.draw` shows those with `alt == altScreen()`.
    fn Grid.kittyImage(this: &Grid, serial: int): KImage
        The image with `serial`, or null when it was deleted (check `w > 0`).
    fn Grid.newArena(this: &Grid): &Arena
        A fresh arena whose header lives in the grid's arena (an `Arena` is never stored by value).
    fn Grid.kittyHas(this: &Grid, serial: int): bool
        Whether an image with `serial` is still held (a texture cache drops the others).
    fn Grid.kittyFreeAll(this: &Grid)
        Free every image (RIS, or a host closing the grid; the arenas are mmapped, not in the grid's arena).
    fn Grid.snapshot(this: &Grid): Saved
    fn Grid.restore(this: &Grid, s: &Saved)
    fn Grid.saveCursor(this: &Grid)
        DECSC: cursor, pen, origin mode, wrap flag, charset.
    fn Grid.restoreCursor(this: &Grid)
        DECRC (home with a plain pen when nothing was saved).
    fn Grid.clearScreen(this: &Grid)
        Blank every row of the screen in `bufp()` with a plain style.
    fn Grid.enterAlt(this: &Grid, clear: bool)
        Switch to the alt screen (`clear` blanks it first). No-op when already there.
    fn Grid.leaveAlt(this: &Grid, clear: bool)
        Back to the primary screen (`clear` blanks the alt screen first).
    fn Grid.setModes(this: &Grid, p: &Params, on: bool)
        DECSET / DECRST (`CSI ? Pm h|l`), every parameter in turn.
    fn Grid.decMode(this: &Grid, m: int): int
        DECRQM state of DEC private mode `m`: 1 set, 2 reset, 0 not recognized.
    fn Grid.softReset(this: &Grid)
        DECSTR: modes back to default (autowrap on, as xterm does in practice) except mouse, paste and focus
        reporting; pen, region, charset and saved cursor reset. The screen and cursor position stay.
    fn Grid.fullReset(this: &Grid)
        RIS: everything back to power-on except the title: both screens blank, scrollback dropped, tabs default.
    fn Grid.osc(this: &Grid, bytes: string)
        Sink: `0;title`, `2;title`, `8;params;uri` (links); other OSC numbers are ignored.
    fn Grid.linkId(this: &Grid, uri: string): int
        Id for `uri` in the link table (added when new); 0 for "" or when the table or URI is too big.
    fn Grid.print(this: &Grid, cp0: i32)
        Sink: a printable code point (translated through the DEC set when G0 is line drawing).
    fn Grid.put(this: &Grid, cp: i32)
        Write one already translated code point at the cursor: wide characters take two cells (the second has
        width 0) and wrap first when one column is left; width 0 code points (combining marks, stray controls) are
        dropped without moving the cursor; the last column sets the pending wrap instead of wrapping.
    fn Grid.addMark(this: &Grid, cp: i32)
        Attach combining code point `cp` to the character before the cursor (the one just printed): kept when it is
        in the BMP and the cell has fewer than 2 marks; dropped otherwise, or at the start of a row.
    fn Grid.exec(this: &Grid, c0: u8)
        Sink: a C0 control. BEL counts in `bells`; the rest that matter are BS HT LF VT FF CR.
    fn Grid.tabForward(this: &Grid, n: int)
        Move to the `n`th next tab stop (or the last column).
    fn Grid.tabBack(this: &Grid, n: int)
        Move to the `n`th previous tab stop (or column 0).
    fn Grid.esc(this: &Grid, inter: int, final: u8)
        Sink: `ESC 7 8 D E M H c = >` and `ESC ( 0` / `ESC ( B`; others are ignored.
    fn Grid.reserve(this: &Grid, c: int, r: int)
        Make room for `c` x `r`. No-op within the limits. Grows geometrically (each dimension to
        `max(requested, current limit * 2)`), so n one-column resizes cost O(log n) copies. The screens move to a new
        owned arena and the old one is freed; scrollback does not depend on the limits. `reserves` counts the growths.
    fn Grid.resize(this: &Grid, cols: int, rows: int)
        Change the size. A column change reflows the primary screen and scrollback (`reflow`); the alt screen, and
        both screens on a row-only change, are cut or padded blank, with rows added or cut at the bottom, except that
        shrinking the primary screen under a cursor that would fall off pushes the top rows into scrollback so the
        cursor line stays. The cursor and saved cursors are clamped, the scroll region is reset to the whole screen,
        and every row is marked dirty. Past the storage limits the screens move to new storage and the old is freed;
        a reflow's scratch is freed before it returns, so memory does not grow with the number of resizes.
    fn Grid.rfPhys(this: &Grid, i: int, oc: int, wrap: &bool): []Cell
        The primary screen's physical line `i` of scrollback-then-screen (screen rows `oc` wide), and whether it wraps.
    fn Grid.reflow(this: &Grid, c: int, r: int): bool
        Rewrap the primary screen and scrollback to `c` columns and `r` rows (storage already reserved; `ncols` and
        `nrows` still the old size). Wrapped rows join into logical lines (trailing blanks trimmed), which split again
        at `c`; a wide character that does not fit moves to the next row. The row the old screen started on stays the
        top unless the cursor line would fall off the bottom, then rows go to scrollback; rows past the bottom are
        dropped. Sets the primary cursor and returns whether it sits in the deferred-wrap state.
        Scratch is an arena made here and freed at the end, so nothing is left behind.
        ponytail: copies all of scrollback per resize (O(stored cells)); keep a dirty range if window drags get slow.
    fn Grid.layLine(this: &Grid, li: int, c: int, probe: int, pr: &int, pc: &int, base: int, top: int, r: int): int
        Split logical line `li` into rows of `c` cells; returns the row count. The cell at offset `probe` (or the end,
        when `probe` is past it) lands at row `*pr`, column `*pc` (`c` at the end of a full row). With `base >= 0`, row
        `base + k` is written: to scrollback below `top`, to screen row `base + k - top` below `top + r`.
    fn Grid.rfEmit(this: &Grid, base: int, row: int, w: int, wrap: bool, top: int, r: int)
        Write `rfRow[0..w]` (padded blank) as output row `base + row` (see `layLine`); a no-op for `base < 0`.
    fn Grid.sbClear(this: &Grid)
        Drop all scrollback lines (the ring keeps its storage).
    fn Grid.sbPush(this: &Grid, cells: []Cell, wrap: bool)
        Append `cells` as the newest scrollback line (`wrap`: it continues on the next), dropping the oldest when
        all `sbCap` slots are used.
    fn Grid.sbEncode(this: &Grid, cells: []Cell, n: int, at: int): int
        Words the first `n` of `cells` take; with `at >= 0` they are also written to `sbRing[at..]`.
    fn Grid.sbPlace(this: &Grid, n: int): int
        Claim `n` contiguous words for the newest record: its start, or -1 when the ring has no room.
    fn Grid.sbDrop(this: &Grid)
        Forget the oldest line. Records are laid in order, so the oldest non-empty one starts at `sbH`.
    fn Grid.sbGrow(this: &Grid, need: int)
        Move the live records, packed oldest first, into a new ring with room for `need` more words, and free the old.
    fn Grid.sbLine(this: &Grid, i: int, pad: bool): []Cell
        Scrollback line `i` decoded into `lnBuf`: its stored cells, then (with `pad`) plain blanks to the width it had.
    fn Grid.sbStartsWide(this: &Grid, i: int): bool
        Whether scrollback line `i` starts with a wide character (without decoding it).

fn lineText(t: &Text, cells: []Cell, styled: bool)
    `cells` as text: empty cells are spaces, width-0 spacers are skipped, trailing spaces are trimmed. With `styled`,
    a style change is marked `{fg;bg;attr}` (`-` default, `pN` palette, `#r.g.b`), and the row's run to the last
    cell that has a style or a character is kept so a colored blank is visible.
const MAX_IMAGES = 64
    Kitty graphics protocol of `Grid` (the `ansi.Sink` method `apc`): `ESC _ G keys;base64 ESC \`.
    Transmit (`a=t`, `a=T`, `a=q`) direct in chunks (`m=1`), from a file (`t=f`) or a temp file (`t=t`, removed after),
    as RGB (`f=24`), RGBA (`f=32`) or PNG (`f=100`), zlib-compressed RGB/RGBA (`o=z`); put (`a=p`) with a source rect
    (`x y w h`), cell box (`c r`), cell offset (`X Y`), `z`, `C=1` (cursor stays); delete (`a=d`, `d=a A i I n N c C`).
    Replies (`OK`, `ENOENT:...`) go to `reply` when the command named `i` or `I`, quieted by `q`.
    Placements are anchored to cells: `KPlace.row` is the screen row of the top (negative once it scrolled into
    scrollback) and moves with full-screen scrolls; `View.draw` paints them. Images live in their own arenas and are
    freed on delete. The cell size in pixels (`cellPxW`/`cellPxH`, set by the host) sizes placements without `c`/`r`.
    ponytail: no shared memory (`t=s`), animation frames, Unicode placeholders, relative placements; partial scroll
    regions and resize do not move placements; at most `MAX_IMAGES` images (the oldest is dropped).
    Part of `j3.term.grid`.
    Most images kept per grid; a new one past this drops the oldest and its placements.

const MAX_IMAGE_SIDE = 10000
    Largest image side in pixels.

struct KImage
    One transmitted image: RGBA8 pixels in its own arena. `serial` is unique per grid (texture caches key on it).
    id: int
    num: int
    serial: int
    w: int
    h: int
    px: []u8
    mem: &Arena
        Its own arena (the header sits in the grid's arena: 32 bytes per image, never reused).

struct KPlace
    One placement: image `serial`, its cell box (`col`, `row` on the screen it was put on, `cols` x `rows`), the
    source rect in image pixels, the drawn size and offset in pixels, and the z order (below text when negative).
    serial: int
    pid: int
    row: int
    col: int
    cols: int
    rows: int
    sx: int
    sy: int
    sw: int
    sh: int
    ox: int
    oy: int
    dw: int
    dh: int
    z: int
    alt: bool

