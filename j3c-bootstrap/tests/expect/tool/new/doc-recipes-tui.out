recipe tui: a full-screen terminal program: Screen.open, draw a box and text, poll keys, q quits

A full-screen terminal program: `Screen.open` takes the terminal (raw mode, alternate screen), you draw
into a back buffer, `flush` writes only the cells that changed, and `poll` returns keys. `j3c doc term` is the overview.

- Run it from a real terminal: `j3c run <dir>`. Piped, it has no raw mode; tests use `openFds` (see `j3c doc j3.term.screen`).
- `put`, `box`, `fill`, `clear` only edit the back buffer. Nothing shows until `flush`.
- After `EV_RESIZE` the screen is already resized; draw again before `flush`.
- The terminal is restored on `close`, on return from `main`, and on panic. A kill signal skips it (`reset` fixes the tty).
- Style is `Style { fg, bg, attr }`: `Color.default()`, `Color.palette(n)`, `Color.rgb(r, g, b)`, `ATTR_*` bits.

==> j3.toml <==
[package]
name = "tuidemo"
entry = "src/main.j3"

==> src/main.j3 <==
module tuidemo;

use j3.io.printLn;
use j3.memory.Arena;
use j3.memory.List;
use j3.result.Result;
use j3.term.Color;
use j3.term.Style;
use j3.term.input.Event;
use j3.term.input.EV_KEY;
use j3.term.input.KEY_CHAR;
use j3.term.screen;
use j3.term.screen.Screen;
use j3.term.screen.EV_RESIZE;

fn main() {
    let a = Arena.create(1048576);
    let plain = Style { fg: Color.default(), bg: Color.default(), attr: u16(0) };
    let green = Style { fg: Color.palette(2), bg: Color.default(), attr: u16(1) };
    match Screen.open(&a) {
        Result.Ok(s) {
            let ev = List<Event>.new(&a);
            let typed = 0;
            let run = true;
            while run {
                s.clear();
                s.box(2, 1, 30, 5, green);
                s.put(4, 2, "Hello from a TUI", green);
                s.put(4, 3, `keys typed: {typed}`, plain);
                s.put(4, 4, "press q to quit", plain);
                s.flush();
                s.poll(50, &ev);
                for i in 0..ev.len {
                    let e = ev.items[i];
                    // EV_RESIZE: the screen is already resized, the next loop redraws
                    if e.kind == EV_KEY {
                        typed += 1;
                        if e.key == KEY_CHAR && e.cp == 113 { run = false; }
                    }
                }
            }
            s.close();
        }
        Result.Err(msg) { printLn(`no terminal: {msg}`); }
    }
}
--- stderr
--- exit 0
