recipe watch: notice files changed outside the app (a folder and a file)

Notice files changed outside the app (a file explorer's open folders, the file open in an editor)
without polling `io.stat` / `io.listDir`. `j3.io.watch` is inotify; `j3c doc j3.io.watch` has the rules.

- `Watcher.create(mem)`, then `w.add(path)`: `Result<int, IoError>`, the id each `Event` carries. A
  folder reports its direct entries (not recursive: add each open subfolder); a file reports itself.
- `w.poll(&evs)` each frame: appends `Event { id, kind, name }` and returns the count; never blocks,
  allocates nothing once `evs` has grown. Reset `evs.len = 0` after handling them.
- Kinds: folder `Create` / `Delete` / `Modify` / `MoveIn` / `MoveOut` with the entry `name`; the
  folder itself gone is `Delete` with `name` "". A file's `name` is "": an editor's
  "write temp + rename over" save is `Modify`, like an in-place write; delete then recreate is
  `Delete`, `Create` on the same id. `Overflow` (id -1): events were lost, rescan everything.
- `name` points into the watcher's buffer and is only valid until the next `poll`: copy what you keep.
- An idle `.j3ui` app sleeps between frames; a change wakes it like a worker hand-back, so the
  next frame's `poll` sees it. Poll from the draw system (an `always` system keeps the app awake).
- `w.remove(id)` (a gone folder or an unknown id is a no-op), `w.close()` at shutdown (stops the
  helper thread). Use a `Watcher` from the thread that made it. Linux x86-64 (inotify) and Windows
  (`ReadDirectoryChangesW`): elsewhere `add` returns `Err`.

==> j3.toml <==
[package]
name = "watcher"
entry = "src/main.j3"

[link]
libs = ["SDL2"]

==> src/main.j3 <==
module watcher;

use j3.app.App;
use j3.game;
use j3.game.rgb;
use j3.gfx.paint;
use j3.io.printLn;
use j3.io.watch.{ Event, Kind, Watcher };
use j3.math.Vec2;
use j3.memory.{ Arena, List };
use j3.result.Result;

struct World {
    w: Watcher;
    evs: List<Event>;
    dirId: int = -1;
    fileId: int = -1;
    /// Bumped on each change, so the screen shows something happened.
    changes: int = 0;
}

fn boot(mem: &Arena): World {
    return World { w: Watcher.create(mem), evs: List<Event>.new(mem) };
}

fn startup(w: &World) {
    // a folder reports its direct entries; a file reports itself (rename-over saves read as Modify)
    match w.w.add("assets") {
        Result.Ok(id) { w.dirId = id; }
        Result.Err(_) { printLn("no assets/ folder to watch"); }
    }
    match w.w.add("j3.toml") {
        Result.Ok(id) { w.fileId = id; }
        Result.Err(_) { }
    }
}

fn kindName(k: Kind): string {
    match k {
        Kind.Create { return "create"; }
        Kind.Delete { return "delete"; }
        Kind.Modify { return "modify"; }
        Kind.MoveIn { return "move in"; }
        Kind.MoveOut { return "move out"; }
        Kind.Overflow { return "overflow: rescan everything"; }
    }
    return "";
}

fn draw(w: &World) {
    // never blocks; a change also wakes an idle (sleeping) app, so this runs when it matters
    if w.w.poll(&w.evs) > 0 {
        for i in 0..w.evs.len {
            let e = w.evs.items[i];
            // e.name points into the watcher's buffer until the next poll: copy it to keep it
            if e.id == w.fileId { printLn(`j3.toml: {kindName(e.kind)}`); }
            else { printLn(`assets/{e.name}: {kindName(e.kind)}`); }
        }
        w.changes += w.evs.len;
        w.evs.len = 0;
    }
    let c = if w.changes % 2 == 0 { rgb(30, 30, 46) } else { rgb(49, 50, 68) };
    paint.rect(Vec2 { x: 0, y: 0 }, game.windowSize(), c);
}

fn stop(w: &World) {
    w.w.close();
}

fn main() {
    let app = App<World>.create("watcher", 320, 180, boot);
    app.useGl();
    app.startup(startup);
    app.draw(draw);
    app.shutdown(stop);
    app.run();
}
--- stderr
--- exit 0
