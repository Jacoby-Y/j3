recipe dragout: drag a file out of the window into Discord, a browser, or a file manager (dragFiles, Linux X11)

Drag a file out of the window into another app (Discord, a browser, a file manager): press on the
square and pull. `j3c doc j3.game dragFiles` has the rules.

- `game.dragFiles(paths)` starts the drag. Call it while the left button is held, after the
  pointer has moved a few pixels from the press. Paths must be absolute files; to drag data you
  only have in memory (a screenshot, a rendered image), write it to a file first.
- `game.dragState()` is `Dragging` while the pointer carries the files, then `Dropped` or
  `Cancelled` for one frame. Escape cancels. The window sees no mouse motion during the drag;
  the release comes back as `mouseReleased(Mouse.Left)`.
- The files go out as `text/uri-list` (`file:///path`, percent-encoded), which chats, browsers
  and file managers take. The other app reads the file when it is dropped: keep it on disk.
- Linux X11 through its own `libX11.so.6` connection (XDND). Wayland sessions work through
  XWayland, which SDL2 uses by default; SDL on native Wayland, headless, Windows and macOS get
  `false`.
- Test the false path headless; test the drop by hand (drag onto a browser tab or a chat).

==> j3.toml <==
[package]
name = "dragger"
entry = "src/main.j3"

[link]
libs = ["SDL2"]

==> src/main.j3 <==
module dragger;

use j3.app.App;
use j3.game;
use j3.game.{ DragState, Mouse, rgb };
use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode };
use j3.gfx.paint;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;

const FILE: string = "/tmp/j3-drag.png";

struct World {
    pressed: bool = false;
    from: Vec2;
}

fn boot(mem: &Arena): World {
    return World { from: Vec2 { x: 0, y: 0 } };
}

fn startup(w: &World) {
    // what gets dragged must be a file: write the image out first
    let arena = Arena.create(1 << 20);
    let c = Canvas.create(&arena, 64, 64, Mode.Pixel);
    c.clear(canvas.rgb(137, 180, 250));
    c.fillRect(16, 16, 32, 32, canvas.rgb(30, 30, 46));
    match c.savePng(FILE, &arena) {
        Result.Ok(n) {}
        Result.Err(e) { printLn("could not write the PNG"); }
    }
    arena.destroy();
}

fn onBox(p: Vec2): bool {
    return p.x >= 40 && p.x < 140 && p.y >= 40 && p.y < 140;
}

fn input(w: &World, _dt: f32) {
    let p = game.mousePos();
    if game.mousePressed(Mouse.Left) && onBox(p) {
        w.pressed = true;
        w.from = p;
    }
    if !game.mouseDown(Mouse.Left) {
        w.pressed = false;
    }
    // start once the pointer has moved a few pixels, so a click stays a click
    let dx = p.x - w.from.x;
    let dy = p.y - w.from.y;
    if w.pressed && dx * dx + dy * dy > 36 {
        w.pressed = false;
        if !game.dragFiles([FILE]) { printLn("no drag here (headless, Wayland-native, or no X11)"); }
    }
    let s = game.dragState();
    if s == DragState.Dropped { printLn("dropped"); }
    if s == DragState.Cancelled { printLn("cancelled"); }
}

fn draw(w: &World) {
    paint.rect(Vec2 { x: 0, y: 0 }, game.windowSize(), rgb(30, 30, 46));
    let c = if game.dragState() == DragState.Dragging { rgb(166, 227, 161) } else { rgb(137, 180, 250) };
    paint.rect(Vec2 { x: 40, y: 40 }, Vec2 { x: 100, y: 100 }, c);
}

fn main() {
    let app = App<World>.create("dragger", 320, 180, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
