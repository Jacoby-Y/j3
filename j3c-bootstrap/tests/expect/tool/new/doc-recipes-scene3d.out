recipe scene3d: load an editor scene, run its scripts, and draw it lit and shadowed

`j3c editor --new mygame` writes these files and opens the editor; writing them yourself
gives the same project without a window. `j3c new mygame --template fps` is this with a
first-person walker. Needs SDL2 and GL.

- `boot`: `scene3d.load(path, mem)` reads the scene into the app arena, where it lives until
  quit. `scripts.scene()` is the scene the editor's Play picked, else j3.editor.toml's.
- `startup` runs once GL exists (`app.useGl()` asks for it): `gfx.init()`, then
  `scene3d.upload(&scene)` sends meshes and textures to the GPU, then `scripts.start`.
- Every frame: `scripts.update` in an update system. In draw, in this order:
  `environment`, `shadows`, `lights`, `beginEffects`, the camera pass, `scene3d.draw`,
  `endEffects`. Quitting frees GL through `game.destroy()`.
- `j3.scene3d.scripts` is made from the scenes' script lines: `j3c doc j3.scene3d.scripts`
  in the project shows it. Edit scenes with `j3c -e scene` (`j3c doc editor`), and look
  with `j3c -e render`.

==> j3.toml <==
[package]
name = "mygame"
entry = "src/main.j3"

[emit]
backend = "llvm"
opt = 0
debug = true

[link]
libs = ["SDL2", "GL"]

==> j3.editor.toml <==
[editor]
scene = "scenes/main.j3scene"

==> src/main.j3 <==
module mygame;

use j3.scene3d.scripts;
use j3.app.App;
use j3.game;
use j3.gfx;
use j3.gfx.Look;
use j3.math.{ Vec3, asin, atan2 };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Scene, CAMERA };

struct World {
    scene: Scene;
}

fn boot(mem: &Arena): World {
    return World { scene: scene3d.load(scripts.scene(), mem) };
}

fn startup(w: &World) {
    gfx.init();
    scene3d.upload(&w.scene);
    scripts.start(&w.scene);
}

fn update(w: &World, dt: f32) {
    if game.keyPressed(game.Key.Escape) { game.requestQuit(); }
    scripts.update(&w.scene, dt);
}

fn camera(w: &World): Look {
    let i = 0;
    while i < w.scene.len {
        let n = w.scene.nodes[i];
        if n.kind == CAMERA {
            let model = scene3d.world(&w.scene, n.id);
            let eye = model.transformPoint(Vec3.xyz(0, 0, 0));
            let forward = (model.transformPoint(Vec3.xyz(0, 0, -1)) - eye).normalize();
            gfx.setClip(n.near, n.far);
            return Look.create(eye, atan2(forward.x, -forward.z), asin(forward.y));
        }
        i += 1;
    }
    return Look.create(Vec3.xyz(0, 3, 8), 0, -0.2);
}

fn draw(w: &World) {
    let env = scene3d.environment(&w.scene);
    scene3d.shadows(&w.scene, env);
    scene3d.lights(&w.scene);
    let fov: f32 = 60;
    let cam = 0;
    let i = 0;
    while i < w.scene.len {
        if w.scene.nodes[i].kind == CAMERA { fov = w.scene.nodes[i].fov; cam = w.scene.nodes[i].id; break; }
        i += 1;
    }
    // The camera's `.j3fx` effects, as the editor shows them.
    let fx = scene3d.beginEffects(&w.scene, cam);
    gfx.cameraPassLookFov(camera(w), env.sunDir, env.sky, env.sunColor, fov);
    scene3d.draw(&w.scene);
    if fx { scene3d.endEffects(&w.scene, cam); }
}

fn main() {
    let app = App<World>.create("mygame", 960, 540, boot);
    app.useGl();
    app.startup(startup);
    app.always(update);
    app.draw(draw);
    app.run();
}

==> scripts/spin.j3s <==
// Attached to objects in the scene editor. The scene calls `start` once and `update`
// every frame; `node` is the object this copy is attached to.
use j3.scene3d.{ Scene, NodeId };

props {
    node: NodeId;
    /// Turns per second, in radians.
    speed: f32 = 1.0;
}

pub fn start(scene: &Scene) {
}

pub fn update(scene: &Scene, dt: f32) {
    let n = scene.node(node);
    n.rotation.y += speed * dt;
}

==> scenes/main.j3scene <==
j3scene 2 next=3

Camera camera pos=0,2,7 rot=-11.459,0,0 #1
Cube cube script=scripts/spin.j3s #2

==> assets/gen/tree.j3 <==
// A low-poly tree built in code: a tapered trunk and three cones of leaves.
// `j3c -e gen` (and every build, render, and play) runs it when it changes and writes
// assets/gen/tree.j3mesh. `j3c doc j3.gfx.meshgen` lists the shapes.
module gen_tree;

use j3.memory.Arena;
use j3.gfx.meshgen;
use j3.gfx.meshgen.Builder;

fn main() {
    let mem = Arena.create(4 * 1024 * 1024);
    let b = Builder.new(&mem);
    b.color(0.45, 0.3, 0.18);
    b.push();
    b.at(0, 0.6, 0);
    b.frustum(0.16, 0.1, 1.2, 10);
    b.pop();
    b.color(0.2, 0.55, 0.25);
    let tier = 0;
    while tier < 3 {
        b.push();
        b.at(0, 1.3 + f32(tier) * 0.55, 0);
        b.cone(0.8 - f32(tier) * 0.2, 1.0, 12);
        b.pop();
        tier += 1;
    }
    b.save(meshgen.output("assets/gen/tree.j3mesh"));
}
