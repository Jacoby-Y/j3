for
next: j3c check; j3c run --frames 30 --screenshot shot.png --headless
--- stderr
--- exit 0
--- out for/j3.toml 664
[package]
name = "for_"
entry = "src/main.j3"

[emit]
backend = "llvm"
opt = 0
debug = true

[link]
libs = ["SDL2", "SDL2_ttf", "GL"]

[ui]
dir = "ui"
theme = "ui/theme.css"
--- out for/src/main.j3 664
module for_;

use for_.state.State;
use for_.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;

struct World {
    state: State;
    root: Screen;
}

fn boot(mem: &Arena): World {
    return World { state: State {}, root: Screen.new(mem) };
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { state: &w.state });
}

fn main() {
    let app = App<World>.create("for_", 640, 360, boot);
    app.useGl();
    app.hiDpi();
    app.draw(draw);
    app.run();
}
--- out for/src/state.j3 664
module for_.state;

pub struct State {
    clicks: int = 0;
}
