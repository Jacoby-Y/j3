recipe ansi: colored process or build output in a `.j3ui` pane: AnsiLog turns escapes into styled spans

Show colored process or build output in a `.j3ui` app. `j3.ui.ansi.AnsiLog` parses the bytes once, when you
`append` them, into lines of `Seg`s; the component draws the segs with `{#each}` and `style:` slots (`j3c doc j3ui`,
Dynamic style). Nothing is parsed per frame, so a long log costs only its layout.
Needs SDL2, SDL2_ttf, and libGL; the screen is the `components` recipe's (`j3c doc recipes components`).

- `AnsiLog.new(fg, bg, maxLines)`: `fg`/`bg` are the pane's colors (`0xRRGGBB`), used only where a default color has to
  become a real one (inverse, dim, hidden). Everything else leaves `fg`/`bg` empty, and an empty `style:` value
  inherits the pane's CSS.
- `log.append(bytes)` takes chunks split anywhere, mid-escape too. The last line shows before its LF arrives.
  Palette: the 16 ANSI colors, the 256-color cube and gray ramp, and 24-bit color.
- `log.line(i)` is line `i`'s `[]Seg { text, fg, bg, weight, slant, deco }`.
- Kept: SGR (colors, bold, dim as a darker color, italic, underline, strike, inverse, hidden). Dropped without
  a trace: cursor moves, clears, OSC titles, every other escape. A CR followed by text wipes the line, so a
  progress bar shows its last frame; CRLF is a plain line break. Tabs pad to 8 columns.
- Align columns with a monospace font: add an `@font-face { font-family: "Mono"; src: url("../assets/mono.ttf"); }`
  to `ui/theme.css` and put `font-family: "Mono"` on the log.
- `AnsiLog.new(fg, bg, maxLines)` owns its memory. With `maxLines > 0` only the newest lines are kept; once as many
  have been dropped again, the live lines are copied to a fresh arena and the old one freed (CR-wiped text too), so a
  log that runs for days stays bounded. `0` keeps everything. `log.clear()` empties it, `log.destroy()` frees it.
- Read lines with `log.count()` and `log.line(i)`. For a long log use a `virtual` list (`j3c doc j3ui`, Virtual lists):
  `<div class="log" virtual row-height={18}>{#each log.lines.items[log.head..log.lines.len] as ln, i (i)}`
  `<div class="ln">{#each log.segs.items[ln.first..ln.first + ln.count] as s}<span ...>{s.text}</span>{/each}</div>{/each}</div>`.

==> j3.toml <==
[package]
name = "mygame"
entry = "src/main.j3"

[emit]
backend = "llvm"
opt = 0
debug = true

[link]
libs = ["SDL2", "SDL2_ttf", "GL"]

[ui]
dir = "ui"
theme = "ui/theme.css"

==> ui/Screen.j3ui <==
<script>
    use j3.ui.ansi.AnsiLog;

    props { log: &AnsiLog; }
</script>

<div class="app">
    <div class="log">
        {#each 0..log.count() as i}
            <div class="ln">{#each log.line(i) as s}<span style:color="{s.fg}" style:background="{s.bg}" style:font-weight="{s.weight}" style:font-style="{s.slant}" style:text-decoration-line="{s.deco}">{s.text}</span>{/each}</div>
        {/each}
    </div>
</div>

<style>
    .app { padding: 12px; height: 100%; }
    .log { height: 100%; overflow-y: auto; padding: 10px; background: #11111b; border-radius: 10px; font-family: "Mono", "Ui"; font-size: 14px; color: #cdd6f4; }
    .ln { white-space: pre; min-height: 18px; line-height: 18px; }
</style>

==> ui/theme.css <==
@font-face {
  font-family: "Ui";
  src: url("../assets/font.ttf");
}
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #11111b;
  --panel: #1e1e2e;
  --hover: #45475a;
  font-family: "Ui";
  font-size: 15px;
  color: #cdd6f4;
}
button { padding: 8px 14px; border: none; border-radius: 10px; background: var(--hover); color: #cdd6f4; font: inherit; cursor: pointer; }
button:hover { background: #585b70; }
button:focus-visible { outline: 2px solid #89b4fa; outline-offset: 2px; }
button:disabled { cursor: not-allowed; opacity: 0.5; }

==> src/main.j3 <==
module mygame;

use mygame.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;
use j3.text.Text;
use j3.ui.ansi.AnsiLog;

struct World {
    log: AnsiLog;
    root: Screen;
}

/// `~` stands for ESC, since J3 strings have no escape for it.
fn esc(s: string, mem: &Arena): string {
    let t = Text.new(mem);
    for i in 0..s.len {
        t.push(if s[i] == 126 { 27 } else { s[i] });
    }
    return t.str();
}

fn boot(mem: &Arena): World {
    // 0xcdd6f4 and 0x11111b are the pane's text and background (the .log CSS): only inverse and dim need them. 10000 is the line cap.
    let w = World { log: AnsiLog.new(0xcdd6f4, 0x11111b, 10000), root: Screen.new(mem) };
    // Append output as it arrives (a process read, a log tail); chunks may split anywhere, even inside an escape.
    w.log.append(esc("~[1;34mdocs~[0m  ~[32mrun.sh~[0m  ~[1;36mlink~[0m  notes.txt\n", mem));
    w.log.append(esc("~[31merror~[0m: ~[1mcannot find~[0m ~[4mmain.j3~[0m\n~[2mhint: check the entry~[0m\n", mem));
    w.log.append(esc("~[38;5;208morange~[0m ~[38;2;120;200;255mtruecolor~[0m ~[7minverse~[0m\n", mem));
    w.log.append("progress 10%\rprogress 100%\n");
    return w;
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { log: &w.log });
}

fn main() {
    let app = App<World>.create("mygame", 640, 360, boot);
    app.useGl();
    app.hiDpi();
    app.draw(draw);
    app.run();
}
