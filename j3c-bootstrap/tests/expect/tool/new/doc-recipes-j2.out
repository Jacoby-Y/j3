recipe j2: load a j2 mod at runtime: bind a native, call its fn, read a field, show an error

The smallest j2 host: a console program, no window. It makes a VM, binds one native, loads a
mod from `mods/hello.j2`, calls its `pub fn onTick` three times, reads its `pub let speed`, and
shows the error a typo gives. Run it with `j3c run`; it prints `tick 1: slime at x=10.0`,
`onTick gave 1`, ... `speed = 2.5`, then ``broken:1:21: unknown name "spwan"``.

- Order: `openLibs` and every `bind` come before loading. A script's names are checked when
  it loads, so a name bound later is an `unknown name` error.
- `loadFile` / `loadString` run the top level and give the exports table (the `pub` names).
  `keep` it: a `Ref` is a GC root until `release`. Values the host holds in J3 locals across
  calls are not roots.
- `vm.call(f, [j2.num(x)])` returns `Result<Value, Error>`. Use `j2.noArgs()` for none.
- `e.message` reads `chunk:line:col: text` and lasts until the VM's next error. Copy it into a
  `j3.text.Text` to keep it. The VM keeps working after any error.
- A native is `fn(&Vm, Args): Value`. `args.str/num/int/table/func(i)` raise a script error on
  a wrong type; `return vm.raise("...")` raises your own.
- `j3c doc j2` is the host guide, `j3c doc j2 lang` the language page to give modders, and
  `examples/j2_script` a whole game whose content is scripts (reload on save, per-script errors).

==> j3.toml <==
[package]
name = "modhost"
entry = "src/main.j3"

==> mods/hello.j2 <==
// A mod. The top level runs once, when the game loads it; `pub` names are what the game sees.
pub let speed = 2.5;
let ticks = 0;

pub fn onTick(dt) {
    ticks += 1;
    let e = spawn("slime", ticks * 10, 0);
    print(`tick {ticks}: {e.kind} at x={e.x}`);
    return ticks;
}

==> src/main.j3 <==
module modhost;

use j3.io.printLn;
use j3.j2;
use j3.j2.{ Args, Limits, Value, Vm };
use j3.memory.Arena;
use j3.result.Result;

/// `spawn(kind, x, y)`, a native the scripts can call. A wrong argument type is a script error
/// at the script's line; the getters raise it, so the native checks nothing itself.
fn spawn(vm: &Vm, args: Args): Value {
    let e = vm.newTable();
    e.set("kind", j2.str(vm, args.str(0)));
    e.set("x", j2.num(args.num(1)));
    e.set("y", j2.num(args.num(2)));
    return e.value();
}

fn main() {
    let mem = Arena.create(64 << 10);
    let vm = Vm.new(&mem, Limits { heapBytes: 8 << 20 });
    vm.openLibs(j2.LIB_ALL);
    vm.bind("spawn", spawn);

    match vm.loadFile("hello", "mods/hello.j2") {
        Result.Ok(exports) {
            let mod = vm.keep(exports);
            let onTick = vm.get(mod).get("onTick");
            for _ in 0..3 {
                match vm.call(onTick, [j2.num(0.016)]) {
                    Result.Ok(v) {
                        printLn(`onTick gave {v.asNum()}`);
                    }
                    Result.Err(e) {
                        printLn(e.message);
                    }
                }
            }
            printLn(`speed = {vm.get(mod).getNum("speed", 0.0)}`);
            vm.release(mod);
        }
        Result.Err(e) {
            printLn(e.message);
        }
    }

    match vm.loadString("broken", "pub fn onTick(dt) { spwan(1); }") {
        Result.Ok(_) {}
        Result.Err(e) {
            printLn(e.message);
        }
    }
    vm.destroy();
    mem.destroy();
}
--- stderr
--- exit 0
