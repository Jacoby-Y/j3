recipe app2d: a window, a game loop, keys, and 2D drawing

`j3c new mygame --app` writes these files. Needs SDL2. `j3c run` opens a window; agents add
`--frames N --screenshot f.png --headless` (`j3c doc testing`).

- `App<World>.create(title, w, h, boot)` makes the window. `boot` runs once with the app's
  arena and returns the World; allocate from that arena, which lives until quit.
- Register systems before `run()`: `startup` once, `first`/`add`/`last` at a fixed 60 Hz,
  `always` every frame with dt, `draw` last (`j3c doc j3.app`).
- The window can resize; place things from `windowSize()` (`j3c doc j3.game windowSize`), or fix the size with `game.setVirtualSize(1920, 1080)` (letterboxed, `j3c doc j3.game setVirtualSize`).
- Next: `j3c doc j3.game --short` (draw, input, audio), `j3c doc j3ui` (menus and HUDs),
  `j3c doc recipes canvas` (make the art in code).

==> j3.toml <==
# SDL window. Needs SDL2.
# Image, mixer, and font libraries load the first time you use them.
# A missing library leaves the handle empty and does not close the window.
# From this directory: j3c check / j3c run
# Left and Right move the bar. Escape quits.

[package]
name = "mygame"
entry = "src/main.j3"
version = "0.1.0"
description = "mygame, made with j3"

[emit]
backend = "llvm"
opt = 1
debug = true
# Dev loop: opt 1 runs about 6x faster than opt 0, which builds a little faster.
# Ship with `j3c build --release` (opt s, no -g, stripped: about 3x smaller).

[link]
libs = ["SDL2"]

[dist]
# `j3c build --release` also writes these to target/dist/: a zip per target, and a .deb
# (Linux) that installs to /opt with a menu entry. `j3c help manifest` lists every key.
# build_outputs = ["zip", "deb"]
# icon = "assets/icon.png"          # menu and window icon; default the J3 logo

[splash]
# Startup splash (`j3c doc ship`): the J3 logo, then your cards, while startup systems load.
# enabled = true
# cards = ["assets/studio.png"]

==> src/main.j3 <==
module mygame;

use j3.app.App;
use j3.game.{
    Key, clear, drawRect, keyDown, requestQuit, rgb, setColor
};
use j3.math.Vec2;
use j3.memory.Arena;

struct World {
    x: f32;
}

fn boot(_mem: &Arena): World {
    return World {
        x: 280
    };
}

fn input(w: &World, dt: f32) {
    if keyDown(Key.Escape) {
        requestQuit();
    }
    if keyDown(Key.Left) {
        w.x = w.x - f32(200) * dt;
    }
    if keyDown(Key.Right) {
        w.x = w.x + f32(200) * dt;
    }
}

fn draw(w: &World) {
    setColor(rgb(32, 48, 72));
    clear();
    setColor(rgb(240, 200, 64));
    drawRect(Vec2 {
        x: w.x, y: f32(160)
    }
    , Vec2 {
        x: f32(80), y: f32(24)
    }
    );
}

fn main() {
    let app = App<World>.create("mygame", 640, 360, boot);
    app.always(input);
    app.draw(draw);
    app.run();
}
