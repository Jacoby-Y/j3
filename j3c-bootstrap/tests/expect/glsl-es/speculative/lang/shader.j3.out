// ===== speculative.shader.SPRITES (shader.j3:36) =====
// ----- vertex -----
#version 300 es
// speculative.shader.SPRITES (vertex)
precision highp float;precision highp int;struct Corner {
    vec2 at;
};
struct Sprite {
    vec2 pos;
    vec2 size;
    vec4 tint;
};
struct V {
    vec4 position;
    vec2 uv;
    vec4 tint;
};
layout(location=0) in vec2 a_c_at;
layout(location=1) in vec2 a_s_pos;
layout(location=2) in vec2 a_s_size;
layout(location=3) in vec4 a_s_tint;
out vec2 v_uv;
out vec4 v_tint;
uniform vec2 uScreen;
// shader.j3:20
vec4 toNdc(vec2 p) {
    return vec4((((p / uScreen) * 2.0) - 1.0), 0.0, 1.0);
}
// shader.j3:25
V vs(Corner c, Sprite s) {
    return V(toNdc((s.pos + (c.at * s.size))), c.at, s.tint);
}
void main() {
    Corner p_0 = Corner(a_c_at);
    Sprite p_1 = Sprite(a_s_pos, a_s_size, a_s_tint);
    V p_ret = vs(p_0, p_1);
    gl_Position = p_ret.position;
    v_uv = p_ret.uv;
    v_tint = p_ret.tint;
}
// ----- fragment -----
#version 300 es
// speculative.shader.SPRITES (fragment)
precision highp float;precision highp int;precision highp sampler2D;struct V {
    vec4 position;
    vec2 uv;
    vec4 tint;
};
in vec2 v_uv;
in vec4 v_tint;
layout(location=0) out vec4 oColor;
uniform sampler2D uAtlas;
// shader.j3:30
vec4 fs(V v) {
    vec4 t = texture(uAtlas, v.uv) * v.tint;
    if (t.a < 0.01) {
        discard;
    }
    return t;
}
void main() {
    V p_0 = V(gl_FragCoord, v_uv, v_tint);
    oColor = fs(p_0);
}
