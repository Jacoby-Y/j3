// `f().len` and `f().x` on a call that returns a string or a struct by value.
// Port of: compile/tests.rs field_of_a_call_result
// expect-out: 3 7
module a;

use j3.io.printLn;

struct P {
    x: int;
}

fn name(): string {
    return "abc";
}

fn pt(): P {
    return P { x: 7 };
}

fn main() {
    printLn(`{name().len} {pt().x}`);
}
