// `a > b` / `a <= b` on strings through `operator<` with swapped args; `a` is evaluated first.
// expect-out: false true false false
// backends: llvm
module swap_order;
use j3.io;
fn s(i: int): string { if i == 0 { return "a"; } return "b"; }
fn main() {
    let a = s(0) > s(1);
    let b = s(0) <= s(1);
    let c = s(0) >= s(1);
    let d = s(1) < s(0);
    io.printLn(`{a} {b} {c} {d}`);
}
