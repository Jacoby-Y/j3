// `X.len` in rvalue and operand positions (Rust lowers the place `X` once more to look for an array).
// expect-out: 0 3 3 3 9
// backends: llvm
module len_order;
use j3.io;
use j3.memory.{ Arena, List };
struct S { items: List<int>; name: string; arr: [3]int; sl: []int; }
fn mk(s: &S): &S { return s; }
fn main() {
    let mem = Arena.create(4096);
    let a: [3]int;
    let xs = a[0..3];
    let s = S { items: List<int>.new(&mem), name: "hey", arr: a, sl: xs };
    let ys = [xs, xs];
    let i = 1;
    let n = mk(&s).items.len;
    let m = ys[i].len;
    let k = mk(&s).arr.len;
    let q = "abc".len;
    let r = mk(&s).name.len + ys[0].len + mk(&s).sl.len;
    io.printLn(`{n} {m} {k} {q} {r}`);
}
fn more(s: &S, ys: [][]int, i: int): int {
    let z: int = mk(s).items.len;
    z = mk(s).sl.len;
    z += mk(s).items.len;
    if mk(s).items.len > 2 { return mk(s).arr.len; }
    let w = [mk(s).arr.len, ys[i].len];
    take(mk(s).arr.len, mk(s).items.len);
    for k in 0..mk(s).items.len { z += k; }
    while z < ys[i].len { z += 1; }
    return mk(s).items.len;
}
fn take(a: int, b: int) {}
