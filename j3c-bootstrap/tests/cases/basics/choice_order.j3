// `@uiChoice` with an enum selector (`_choiceN`) and an int selector.
// expect-out: b
// expect-out: i
// backends: llvm
module choice_order;
use j3.io;
enum Tab { A, B }
fn pick(): Tab { return Tab.B; }
fn main() {
    let t = Tab.B;
    if @uiChoice(Tab, t, 1) { io.printLn("b"); }
    if @uiChoice(Tab, pick(), 0) { io.printLn("a"); }
    if @uiChoice(Tab, 1, 1) { io.printLn("i"); }
}
