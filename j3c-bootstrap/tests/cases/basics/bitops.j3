// Bit operators on signed, unsigned and untyped ints, and their compound assignments.
// Port of: compile/tests/bitops.rs bit_operators_three_ways
// expect-out: 8 -2 -10 5 -13
// expect-out: 240 15 255 255 15 true
// expect-out: 255 255 -6 0 14 3
// expect-out: true true
// expect-out: -1 226 240
module t;

use j3.io.printLn;

fn main() {
    let a: i32 = -6;
    let b: i32 = 12;
    let u: u8 = 0;
    let w: u8 = 0xf0;
    let n = -1;
    let m = 0b1010;
    printLn(`{a & b} {a | b} {a ^ b} {~a} {~b}`);
    printLn(`{u8(0xff) & w} {w ^ 0xff} {0x0f | w} {~u} {~w} {~u == 255}`);
    printLn(`{n & 0xff} {0xff & n} {n ^ 5} {~n} {m | 4} {1 | 2 ^ 3 & 4}`);
    printLn(`{w & 0x80 == 0x80} {a & b == 8}`);
    let p = &n;
    let q = n & *p;
    let x = n;
    x &= 0xf0;
    x |= 3;
    x ^= 0x11;
    let y: u8 = 0x0f;
    y ^= 0xff;
    printLn(`{q} {x} {y}`);
}
