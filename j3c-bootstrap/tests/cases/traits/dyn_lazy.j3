// A generic struct instance's method reached only through a `dyn` table.
// Port of: compile/tests/dyn_trait.rs generic_struct_instance_lazy_method_reached_only_through_a_table
// expect-out: 12
module t;

use j3.io.printLn;

trait Size { fn size(this: &Self): int; }
struct Box<T> { v: T; n: int; fn size(this: &Box<T>): int { return this.n * 3; } }

fn main() {
    let b = Box<string> { v: "x", n: 4 };
    let s: dyn Size = &b;
    printLn(`{s.size()}`);
}
