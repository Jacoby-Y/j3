// `dyn Trait`: two implementations in one list, a default method, a supertrait, an `#[impl]` fn.
// Port of: compile/tests/dyn_trait.rs two_impls_list_defaults_supertraits_run_on_both_backends
// expect-out: llvm
// expect-out: c
// expect-out: llvm
// expect-out: total=221 k=4 pass=6 pick=llvm named=c
module t;

use j3.io.printLn;
use j3.memory.{ Arena, List };

pub trait Named { fn name(this: &Self): string; }
pub trait Backend: Named {
    fn emit(this: &Self, n: int): int;
    fn lines(this: &Self): int { return this.emit(1) + 100; }
}
struct Llvm { k: int; fn name(this: &Llvm): string { return "llvm"; } fn emit(this: &Llvm, n: int): int { this.k += n; return n * 2; } }
struct C { base: int; fn emit(this: C, n: int): int { return this.base + n; } fn lines(this: &C): int { return 7; } }
#[impl]
fn name(x: &C): string { return "c"; }
struct Pass { out: dyn Backend; }
fn pick(a: dyn Backend, b: dyn Backend, first: bool): dyn Backend { if first { return a; } return b; }

fn main() {
    let l = Llvm { k: 0 };
    let c = C { base: 5 };
    let mem = Arena.create(4096);
    let all = List<dyn Backend>.new(&mem);
    all.push(&l);
    all.push(&c);
    all.push(&l);
    let total = 0;
    for i in 0..all.len { let d = all.items[i]; total += d.emit(i) + d.lines(); printLn(d.name()); }
    let p = Pass { out: &c };
    let r = &p.out;
    let n: dyn Named = &c;
    printLn(`total={total} k={l.k} pass={r.emit(1)} pick={pick(&l, &c, true).name()} named={n.name()}`);
}
