// Tuples: return, destructure, nest, match, `==` and printing.
// Port of: compile/tests/tuples.rs tuples_three_ways
// expect-out: 3 2 2 1 1 true 1 true 7
// expect-out: 5 -1 12
// expect-out: ((1, true), 7) true true
module t;

use j3.io.printLn;

enum Op { Add, Mul }

fn divmod(a: int, b: int): (int, int) { return (a / b, a % b); }

fn pick(p: (Op, int), x: int): int {
    match p {
        (Op.Add, n) { return x + n; }
        (Op.Mul, 0) { return -1; }
        (Op.Mul, n) { return x * n; }
    }
}

fn main() {
    let (q, r) = divmod(17, 5);
    let t = divmod(9, 4);
    let n: ((int, bool), int) = ((1, true), 7);
    let ((a, flag), b) = n;
    printLn(`{q} {r} {t.0} {t.1} {n.0.0} {n.0.1} {a} {flag} {b}`);
    printLn(`{pick((Op.Add, 2), 3)} {pick((Op.Mul, 0), 3)} {pick((Op.Mul, 4), 3)}`);
    printLn(`{n} {n == ((1, true), 7)} {n != ((1, false), 7)}`);
}
