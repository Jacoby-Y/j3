// `match` as a value, `if let` with and without `else`, `let .. else`.
// Port of: compile/tests/match_expr.rs match_values_three_ways
// expect-out: 1 2 9 10 20 30
// expect-out: 8 6 -1 7 0
// expect-out: num 5
// expect-out: not end
// expect-out: w=6
module t;

use j3.io.printLn;

enum Op { Add, Sub, Mul }
enum Tok { Num(int), Pair(int, int), End }

fn cost(op: Op): int {
    return match op { Op.Add { 1 } Op.Sub { 2 } Op.Mul { let k = 3; k * 3 } };
}

fn small(n: int): int {
    let v = match n { 0 { 10 } 1..=3 { 20 } _ { 30 } };
    return v;
}

fn val(t: Tok): int {
    let v = match t { Tok.Num(n) { n } Tok.Pair(a, b) { a + b } Tok.End { return -1; } };
    return v * 2;
}

fn first(t: Tok): int {
    let Tok.Pair(a, _) = t else { return 0; };
    return a;
}

fn main() {
    printLn(`{cost(Op.Add)} {cost(Op.Sub)} {cost(Op.Mul)} {small(0)} {small(2)} {small(9)}`);
    printLn(`{val(Tok.Num(4))} {val(Tok.Pair(1, 2))} {val(Tok.End)} {first(Tok.Pair(7, 1))} {first(Tok.End)}`);
    let t = Tok.Num(5);
    if let Tok.Num(n) = t { printLn(`num {n}`); }
    if let Tok.End = t { printLn("end"); } else { printLn("not end"); }
    let w = if let Tok.Num(n) = t { n + 1 } else if let Tok.Pair(a, b) = t { a * b } else { 0 };
    printLn(`w={w}`);
}
