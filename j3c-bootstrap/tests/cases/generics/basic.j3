// Generic fns: one and two type parameters, a bound, explicit type arguments.
// Port of: compile/tests/generic_fns.rs generic_fns_basic_and_two_params
// expect-out: 4 1.5 9
// expect-out: 2 1 8 7
// expect-out: s 2.5 3
// expect-out: 2 3 3 1.5
module t;

use j3.io.printLn;
use j3.cmp.Ord;

struct P { x: int; }

fn first<T>(xs: []T): T { return xs[0]; }
fn swap<T>(a: &T, b: &T) { let t = *a; *a = *b; *b = t; }
fn pick<A, B>(a: A, b: B): B { return b; }
fn maxOf<T: Ord>(a: T, b: T): T { if a > b { return a; } return b; }

fn main() {
    let xs: [3]int = [4, 5, 6];
    let fs: [2]f32 = [1.5, 2.5];
    let ps: [1]P = [P { x: 9 }];
    printLn(`{first(xs)} {first(fs)} {first(ps).x}`);
    let a = 1; let b = 2;
    swap(&a, &b);
    let p = P { x: 7 }; let q = P { x: 8 };
    swap(&p, &q);
    printLn(`{a} {b} {p.x} {q.x}`);
    printLn(`{pick(1, "s")} {pick("s", 2.5)} {pick::<f32, int>(1.5, 3)}`);
    let f: f32 = 3.0;
    printLn(`{maxOf(1, 2)} {maxOf(f, 2)} {maxOf(2, f)} {maxOf(1.5, 0.5)}`);
}
