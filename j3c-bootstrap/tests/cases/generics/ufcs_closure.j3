// Generic fns called through UFCS and taking closure parameters.
// Port of: compile/tests/generic_fns.rs generic_fns_ufcs_and_closure_param
// expect-out: 8
// expect-out: 15
// expect-out: 36
// expect-out: 3
module t;

use j3.io.printLn;

fn first<T>(xs: []T): T { return xs[0]; }
fn bump<T>(x: &T, by: T) { *x = *x + by; }
fn apply<T>(x: T, f: closure(T): T): T { return f(f(x)); }
fn mapTo<T, U>(x: T, f: closure(T): U): U { return f(x); }
fn go(sl: []int) { printLn(`{sl.first()}`); }

fn main() {
    let xs: [2]int = [8, 9];
    go(xs);
    let n = 5;
    n.bump(10);
    printLn(`{n}`);
    let k = 3;
    printLn(`{apply(4, fn(v: int): int { return v * k; })}`);
    printLn(`{mapTo(2, fn(v: int): f32 { return f32(v) * 1.5; })}`);
}
