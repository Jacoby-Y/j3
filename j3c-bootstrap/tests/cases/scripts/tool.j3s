// A `.j3s` tool entry (`pub fn main`): stage0 builds it ahead of time (llvm), not on the VM.
// Port of: compile/tests/bitops.rs bit_operators_three_ways (the script half; scripts have no shifts)
// expect-out: 8 -2 -10 5 -13
// expect-out: 255 255 -6 0 14 3
use j3.io.printLn;

pub fn main() {
    let a: i32 = -6;
    let b: i32 = 12;
    let n = -1;
    let m = 0b1010;
    printLn(`{a & b} {a | b} {a ^ b} {~a} {~b}`);
    printLn(`{n & 0xff} {0xff & n} {n ^ 5} {~n} {m | 4} {1 | 2 ^ 3 & 4}`);
}
