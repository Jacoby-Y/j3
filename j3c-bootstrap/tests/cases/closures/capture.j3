// Closures capture by address: writes inside are seen after; a loop variable per iteration.
// Port of: compile/tests/closures.rs captures_by_address_both_backends
// expect-out: total=5
// expect-out: hold=33
module t;

use j3.io.printLn;

fn main() {
    let total = 0;
    let c = fn(x: int): int { total += x; return total; };
    c(2);
    c(3);
    printLn(`total={total}`);
    let hold = 0;
    for i in 0..3 {
        let each = fn(): int { return i; };
        hold += each() * 10 + 1;
    }
    printLn(`hold={hold}`);
}
