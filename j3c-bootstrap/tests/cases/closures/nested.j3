// Nested closures, `this` inside a method's closure, and `defer` in a closure.
// Port of: compile/tests/closures.rs nested_this_and_defer_both_backends
// expect-out: 7 t=2
// expect-out: 15
// expect-out: 7 d=101
module t;

use j3.io.printLn;

struct C {
    n: int;
    fn go(this: &C, by: int): int {
        let add = fn(k: int) { this.n += k * by; };
        add(1);
        add(2);
        return this.n;
    }
}

fn main() {
    let t = 0;
    let outer = fn(a: int): int {
        let inner = fn(b: int): int { t += 1; return a + b; };
        return inner(a) + inner(1);
    };
    printLn(`{outer(2)} t={t}`);
    let c = C { n: 0 };
    printLn(`{c.go(5)}`);
    let d = 1;
    let early = fn(): int {
        defer { d += 100; }
        if d == 1 { return 7; }
        return 8;
    };
    printLn(`{early()} d={d}`);
}
