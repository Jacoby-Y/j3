// Each generic struct instance gets its own closure.
// Port of: compile/tests/closures.rs generic_instances_get_distinct_closures
// expect-out: 4 2.5
module t;

use j3.io.printLn;

struct Box<T> {
    v: T;
    fn get(this: &Box<T>): T {
        let g = fn(): T { return this.v; };
        return g();
    }
}

fn main() {
    let a = Box<int> { v: 4 };
    let b = Box<float> { v: 2.5 };
    printLn(`{a.get()} {b.get()}`);
}
