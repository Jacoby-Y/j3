// toolchain.preflight: the two tests of preflight.rs (a plain program has nothing to probe; a missing
// literal font path is an error for both the soft and the fatal loader), with the rendered text.
module preflight_test;

use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, contains };
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.toolchain;

fn write(p: string, text: string) {
    match io.writeFile(p, text as []u8) {
        Result.Ok(_) {}
        Result.Err(_) { panic(p); }
    }
}

/// The preflight report of the program at `entry` ("" = nothing to report).
fn probe(entry: string, mem: &Arena): string {
    let o = driver.defaults();
    o.entry = entry;
    o.entryGiven = true;
    let s = Session.new(o);
    if !driver.run(s, Stage.Passes) { panic(Text.new(mem).add(entry).add(" does not typecheck").str()); }
    let out = "";
    match s.loaded {
        Option.Some(p) {
            match s.program {
                Option.Some(prog) {
                    match toolchain.preflight(prog, p.project, s.arena) {
                        Result.Ok(_) {}
                        Result.Err(e) { out = Text.new(mem).add(e).str(); }
                    }
                }
                Option.None { panic("no program"); }
            }
        }
        Option.None { panic("not loaded"); }
    }
    s.free();
    return out;
}

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-preflight-").fmt(`{sys.getpid()}`).str();
    let src = Text.new(&mem).add(dir).add("/src").str();
    match io.makeDirs(src) { Result.Ok(_) {} Result.Err(_) { panic("make the temp dir"); } }

    // Rust `hello_has_nothing_to_probe`
    let hello = Text.new(&mem).add(dir).add("/hello.j3").str();
    write(hello, "module hello;\nuse j3.io.printLn;\nfn main() { printLn(\"hi\"); }\n");
    let h = probe(hello, &mem);
    if h.len > 0 { panic(h); }

    // Rust `missing_font_paths_are_errors` (a literal through a local counts too; a file that is there does not)
    write(Text.new(&mem).add(dir).add("/j3.toml").str(), "[package]\nname = \"probe\"\nentry = \"src/main.j3\"\n\n[link]\nlibs = [\"SDL2\"]\n");
    write(Text.new(&mem).add(dir).add("/here.ttf").str(), "x");
    write(Text.new(&mem).add(src).add("/main.j3").str(), "module probe;\n\nuse j3.game.{ loadFont, tryLoadFont };\n\nfn main() {\n    let missing = tryLoadFont(\"nope.ttf\", 12);\n    let fatal = loadFont(\"also-nope.ttf\", 12);\n    let there = tryLoadFont(\"here.ttf\", 12);\n    let again = tryLoadFont(\"nope.ttf\", 12);\n    if missing.raw == 0 {\n        return;\n    }\n    if fatal.raw == 0 || there.raw == 0 || again.raw == 0 {\n        return;\n    }\n}\n");
    let e = probe(dir, &mem);
    let main = Text.new(&mem).add(dir).add("/src/main.j3").str();
    let soft = Text.new(&mem).add("error: `tryLoadFont` returns an empty handle because `nope.ttf` is not a file\n  --> ").add(main)
        .add(":6:19\n   |\n  6 |     let missing = tryLoadFont(\"nope.ttf\", 12);\n   |                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n   |\n   = note: the process keeps running, and this load draws nothing\n   = help: paths are relative to the project directory; put the file there or change the path\n").str();
    let hard = Text.new(&mem).add("error: `loadFont` panics because `also-nope.ttf` is not a file\n  --> ").add(main)
        .add(":7:17\n   |\n  7 |     let fatal = loadFont(\"also-nope.ttf\", 12);\n   |                 ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n   |\n   = help: paths are relative to the project directory; put the file there or change the path\n").str();
    if !contains(e, soft) || !contains(e, hard) || contains(e, "here.ttf") || contains(e, ":9:") { panic(e); }

    let argv: [3]string = ["rm", "-rf", dir];
    match proc.run(argv[..], "", &mem) {
        Result.Ok(_) {}
        Result.Err(_) { panic("rm -rf"); }
    }
}
