// ui/gen/rewrite: the token-level rewrite of copied J3. Expected lines are cut from
// the Rust compiler's `dump-ui` of the component in `ui_gen_head_Screen.j3ui` (script fns, text holes) and from
// the messages in `j3c/src/ui/gen/rewrite.rs`.
module ui_rewrite_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.ui.gen.{ ConstName, Names, Payload, Rename, Rw, SlotHas, emptyNames, rewrite };
use j3c.ui.map.Out;

struct T {
    a: &Arena;
    names: Names;
    locals: List<string>;
    rename: List<Rename>;
    used: List<string>;
    emitOk: bool;
    sev: bool;
    calls: bool;
    flat: bool;
    segs: int;
}

fn run(t: &T, src: string): Result<string, string> {
    let rw = Rw { a: t.a, src: src, fi: 0, names: &t.names, locals: &t.locals, rename: &t.rename, emitOk: t.emitOk, sev: t.sev, callsEmit: t.calls };
    let o = Out.new(t.a, 0);
    t.used.len = 0;
    match rewrite(&rw, &o, &t.used, 0, src.len, t.flat) {
        Result.Ok(_) {}
        Result.Err(e) { return Result.Err(Text.new(t.a).add(e.msg).add(" | ").add(e.help).fmt(` | {e.lo}..{e.hi}`).str()); }
    }
    t.segs = o.segs.len;
    return Result.Ok(o.text.str());
}

fn ok(t: &T, src: string, want: string) {
    match run(t, src) {
        Result.Ok(s) { if s != want { printLn(s); panic(src); } }
        Result.Err(e) { printLn(e); panic(src); }
    }
}

fn bad(t: &T, src: string, want: string) {
    match run(t, src) {
        Result.Ok(s) { printLn(s); panic(src); }
        Result.Err(e) { if e != want { printLn(e); panic(src); } }
    }
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;
    let t = T { a: a, names: emptyNames(a), locals: List<string>.new(a), rename: List<Rename>.new(a), used: List<string>.new(a), emitOk: true, sev: true, calls: true, flat: false, segs: 0 };
    t.names.props.push("gold");
    t.names.props.push("title");
    t.names.lets.push("count");
    t.names.lets.push("label");
    t.names.consts.push(ConstName { name: "MAX", j3: "Screen_MAX" });
    t.names.fns.push("bump");
    t.names.fns.push("total");
    t.names.emitting.push("bump");
    t.names.events.push("pick");
    t.names.events.push("close");
    t.names.payload.push(Payload { ev: "pick", name: "slot" });
    t.names.payload.push(Payload { ev: "pick", name: "why" });
    t.names.slotHas.push(SlotHas { name: "", sites: List<int>.new(a) });
    t.names.slotHas.push(SlotHas { name: "footer", sites: List<int>.new(a) });
    t.locals.push("by");

    // a script fn body (`sev`): let, prop (collected, sorted), const, interpolated string, emit with payload
    ok(&t, "count += by + title.len + gold + MAX;", "this.count += by + title.len + gold + Screen_MAX;");
    if t.used.len != 2 || t.used.items[0] != "gold" || t.used.items[1] != "title" { panic("used props, byte order"); }
    if t.segs != 4 { panic("segments: glue `this.`, copy, glue const, copy `;`"); }
    ok(&t, "let s = `n={count + gold} of {MAX}`;", "let s = `n={this.count + gold} of {Screen_MAX}`;");
    ok(&t, "emit pick(count, s);", "this.sev.pick_slot = this.count; this.sev.pick_why = s; this.sev.pick = true;");
    ok(&t, "if count > 3 { emit close; }", "if this.count > 3 { this.sev.close = true; }");
    ok(&t, "bump(1); x.count = p::total; S { count: 1 }", "this.bump(1); x.count = p::total; S { count: 1 }");
    // a handler: the local `ev`
    t.sev = false;
    ok(&t, "emit pick(f(1, 2), [3, 4][0])", "ev.pick_slot = f(1, 2); ev.pick_why = [3, 4][0]; ev.pick = true");
    ok(&t, "emit close", "ev.close = true");
    // rename (`{#let}`, keyed items), locals win, flat
    t.rename.push(Rename { from: "twice", to: "lt1" });
    ok(&t, "twice + by", "lt1 + by");
    t.flat = true;
    ok(&t, "twice +\n  gold", "lt1 +   gold");
    t.flat = false;
    ok(&t, "$slots.default && !$slots.footer", "this.slotHas_default() && !this.slotHas_footer()");

    bad(&t, "emit nope", "`emit nope`: `nope` is not in `events { }` | declared events: pick, close | 5..9");
    bad(&t, "emit pick(1)", "`emit pick` has 1 argument(s), expected 2 | `pick` takes (slot, why) | 5..12");
    bad(&t, "emit close(1)", "`emit close` has 1 argument(s), expected 0 | `close` has no payload: write `emit close` | 5..13");
    bad(&t, "emit pick(1, 2", "this `emit` call is never closed |  | 5..9");
    bad(&t, "let gold = 1;", "`gold` shadows a prop, `let`, `fn`, or name used by the generated code | pick another name for this local | 4..8");
    bad(&t, "for n1 in 0..2 {}", "`n1` shadows a prop, `let`, `fn`, or name used by the generated code | pick another name for this local | 4..6");
    bad(&t, "MAX = 2", "`MAX` is a `const`; it can't be assigned |  | 0..3");
    bad(&t, "$slots", "`$slots` needs a slot name: `$slots.footer` (or `$slots.default`) |  | 0..6");
    bad(&t, "$slots.side", "`$slots.side`: no `<slot name=\"side\">` in this component | slots: default, footer | 0..11");
    bad(&t, "\"open", "unterminated string |  | 0..5");
    t.calls = false;
    bad(&t, "1 + bump(2)", "`bump` emits an event, but there is no event scope here | call it from an event handler or another script `fn`: a markup expression runs on every update, and `on:draw` and `onDestroy` have no event scope | 4..8");
    t.emitOk = false;
    bad(&t, "emit close", "`emit` only works in an event handler or a script `fn`, not in `on:draw` |  | 0..10");
    t.sev = true;
    bad(&t, "emit close", "`emit` doesn't work in `onDestroy`: the component is going away |  | 0..10");
}
