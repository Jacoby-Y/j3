// `pkgtool`: Rust cli/tests.rs `pkg_tool_runs_and_caches` on a scratch copy of `tests/proj/pkg_game`, with
// `J3_PKG_DIR` in the scratch folder (never `~/.cache/j3/tools`): the tool prints its args, env and the
// manifest's greeting and exits 3, a second build reuses the exe, an edit rebuilds (exit 4).
// J3: Last, with no `J3_PKG_DIR`, `XDG_CACHE_HOME` or `HOME`, `build` fails with the cache-dir error.
module pkgtool_test;

use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.proc.Output;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, replace };
use j3c.cmd.pkg.pkgIn;
use j3c.pkgtool;
use j3c.pkgtool.ToolCmd;
use j3c.project.manifest;

fn check(c: bool, what: string) { if !c { panic(what); } }

fn sh(line: string, a: &Arena): Output {
    let argv: [3]string = ["sh", "-c", line];
    match proc.run(argv[..], "", a) {
        Result.Ok(o) { return o; }
        Result.Err(_) { panic("cannot run sh"); }
    }
    return Output { code: 1, out: "" as []u8, err: "" as []u8 };
}

/// `c` run to the end with its output captured (Rust `command(..).output()`).
fn output(c: &ToolCmd, a: &Arena): Output {
    let t = Text.new(a).add("cd '").add(c.cwd).add("' && exec env");
    for i in 0..c.env.len { t.add(" '").add(c.env.items[i]).add("'"); }
    for i in 0..c.argv.len { t.add(" '").add(c.argv.items[i]).add("'"); }
    return sh(t.str(), a);
}

fn mtime(p: string): int {
    match io.stat(p) {
        Result.Ok(e) { return e.mtime; }
        Result.Err(_) { panic(p); }
    }
    return 0;
}

fn main() {
    let a = Arena.create(1 << 20);
    defer a.destroy();
    let dir = match io.tempDir("", "j3boot_pkgtool_", &a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    sh(Text.new(&a).add("cp -r tests/proj/pkg_game '").add(dir).add("/game'").str(), &a);
    sys.setenv("J3_PKG_DIR", path.join(dir, "cache", &a));
    let game = path.join(dir, "game", &a);
    let m = match manifest.load(path.join(game, "j3.toml", &a), &a) { Result.Ok(m) { m } Result.Err(e) { panic(e) } };
    let dep = &m.deps.items[0];
    let tool = &dep.commands.items[0];
    let args: [2]string = ["a", "b"];
    let none = args[0..0];
    match pkgtool.build(&m, dep, tool, &a) {
        Result.Err(e) { panic(e); }
        Result.Ok(_) {}
    }
    let c = match pkgtool.command(&m, dep, tool, args[..], none, &a) { Result.Ok(c) { c } Result.Err(e) { panic(e) } };
    let o = output(&c, &a);
    let root = match path.realpath(game, &a) { Option.Some(r) { r } Option.None { panic(game) } };
    let want = Text.new(&a).add("tool_pkg tool: a b\nroot ").add(root).add("\napi 1\ngreeting hi from the game\n").str();
    if o.outStr() != want { printLn(o.outStr()); printLn(o.errStr()); panic("tool output"); }
    check(o.code == 3, "exit 3");
    let exe = match pkgtool.build(&m, dep, tool, &a) { Result.Ok(x) { x } Result.Err(e) { panic(e) } };
    let first = mtime(exe);
    // the CLI path: same exe, exit code passed through
    let tx: [3]string = ["tool_pkg", "echo", "x"];
    check(pkgIn(game, tx[..]) == 3, "pkg NAME CMD exit code");
    match pkgtool.build(&m, dep, tool, &a) { Result.Ok(x) { check(x == exe, "same exe"); } Result.Err(e) { panic(e); } }
    check(mtime(exe) == first, "second run rebuilt");
    let src = path.join(dep.pkgRoot, "tools/echo.j3", &a);
    let text = match io.readFile(src, &a) { Result.Ok(b) { b as string } Result.Err(_) { panic(src) } };
    let rt = Text.new(&a);
    io.writeFile(src, replace(&rt, text, "sys.exit(3);", "sys.exit(4);") as []u8);
    match pkgtool.build(&m, dep, tool, &a) { Result.Ok(x) { check(x != exe, "edit did not rebuild"); } Result.Err(e) { panic(e); } }
    match pkgtool.run(&m, dep, tool, none, none, &a) { Result.Ok(code) { check(code == 4, "exit 4"); } Result.Err(e) { panic(e); } }
    // no cache dir at all: a clear error, nothing built
    sys.setenv("J3_PKG_DIR", "");
    sys.setenv("XDG_CACHE_HOME", "");
    sys.setenv("HOME", "");
    match pkgtool.build(&m, dep, tool, &a) {
        Result.Err(x) { check(x == "no cache directory for package tools (set HOME or J3_PKG_DIR)", x); }
        Result.Ok(_) { panic("built without a cache dir"); }
    }
    sh(Text.new(&a).add("rm -rf '").add(dir).add("'").str(), &a);
}
