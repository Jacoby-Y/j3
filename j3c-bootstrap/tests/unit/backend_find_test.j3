// backend.find: the table (llvm, bc, Rust's `ll`/`LLVM` aliases), `c` is E0002, anything else E0001.
module backend_find_test;

use j3.option.Option;
use j3.sys.panic;
use j3.text.contains;
use j3.text.Text;
use j3c.backend;
use j3c.backend.{ Backend, Opts };
use j3c.base.span.noSpan;
use j3c.driver;
use j3c.driver.Session;
use j3c.ir.Program;

fn named(s: &Session, name: string, want: string, ext: string) {
    match backend.find(name, noSpan(), &s.diags) {
        Option.Some(b) {
            if b.name() != want || b.objectExt() != ext { panic(name); }
        }
        Option.None { panic("backend not found"); }
    }
}

fn missing(s: &Session, name: string, code: u32) {
    let n = s.diags.count();
    match backend.find(name, noSpan(), &s.diags) {
        Option.Some(b) { panic("found a backend that should not exist"); }
        Option.None {}
    }
    if s.diags.count() != n + 1 || s.diags.at(n).code != code { panic("wrong diagnostic code"); }
}

fn main() {
    let s = Session.new(driver.defaults());
    named(s, "llvm", "llvm", "o");
    named(s, "ll", "llvm", "o");
    named(s, "LLVM", "llvm", "o");
    named(s, "bc", "bc", "j3sb");
    if s.diags.count() != 0 { panic("lookup raised a diagnostic"); }
    missing(s, "c", 2);
    missing(s, "C", 2);
    missing(s, "wasm", 1);
    if !contains(s.diags.at(2).msg, "`wasm`") { panic("E0001 does not name the backend"); }
    match backend.find("llvm", noSpan(), &s.diags) {
        Option.Some(b) {
            let p = Program.new(s.arena, &s.names, &s.sources);
            let o = Opts { target: "", opt: 0, debug: true };
            let t = Text.new(s.arena);
            if b.emit(&p, &o, &t, &s.diags) { panic("unported emit succeeded"); }
            if b.link(s.arena.alloc::<string>(0), &o, s.arena).argv.len != 0 { panic("link plan"); }
        }
        Option.None { panic("llvm"); }
    }
    s.free();
}
