// `base/toml` against the Rust reader: the Rust unit test inputs (`project/tests.rs` `manifest_to_json`) and
// malformed files, each through `toml.json` and compared byte for byte with `tests/unit/expect/base_toml.txt`
// (JSON or error; frozen when the Rust compiler's `manifest --json` printed the same JSON and error text after
// the file name, plan 15), except the inputs in `ours`, where the stdlib reader parts from Rust on purpose.
// Every real `j3.toml` (this package's, `examples/*`) must read without an error.
module base_toml_test;

use j3.io;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, endsWith };
use j3c.base.toml;
use j3c.base.toml.{ Val, isIdent, unescape };
use unitkit;

/// Appends `text` and what `toml.json` makes of it (the JSON, or the error) to `all`.
fn add(text: string, all: &Text, arena: &Arena) {
    all.add("== input\n").add(text);
    if !endsWith(text, "\n") { all.add("\n"); }
    match toml.json(text, arena) {
        Result.Ok(j) { all.add("--- json\n").add(j).add("\n"); }
        Result.Err(e) { all.add("--- error\n").add(e).add("\n"); }
    }
}

/// A real `j3.toml` reads without an error (live files: their JSON is not frozen).
fn reads(p: string, arena: &Arena) {
    match toml.json(file(p, arena), arena) { Result.Ok(_) {} Result.Err(e) { panic(Text.new(arena).add(p).add(": ").add(e).str()); } }
}

fn file(p: string, arena: &Arena): string {
    match io.readFile(p, arena) {
        Result.Ok(b) { return b as string; }
        Result.Err(_) { panic("cannot read a j3.toml"); return ""; }
    }
}

fn main() {
    let arena = Arena.create(1 << 22);
    let all = Text.new(&arena);

    // real files
    reads("j3.toml", &arena);
    let n = 0;
    match io.listDir("../examples", &arena) {
        Result.Ok(ents) {
            for i in 0..ents.len {
                let p = Text.new(&arena).add("../examples/").add(ents[i].name).add("/j3.toml").str();
                match io.stat(p) {
                    Result.Ok(_) { reads(p, &arena); n += 1; }
                    Result.Err(_) {}
                }
            }
        }
        Result.Err(_) { panic("no ../examples"); }
    }
    if n < 5 { panic("too few examples/*/j3.toml"); }

    // Rust's `manifest_to_json` inputs, and its expected strings
    let rich = "\n[package]\nname = \"g\"\nversion = \"1.0.0\"\n\n[steam]\napp_id = 480\nsdk = \"C:\\\\sdk\"\ndesc = \"say \\\"hi\\\"\tünï #not a comment\"\nratio = -1.5e3\nodd = 007\nbeta = true\n\n[dist]\nbuild_outputs = [\"zip\", \"steam\"]\n\n[dist.actions]\nnew = { name = \"New, Island\", exec = \"--new\" }\n\n[tool_pkg]\ngreeting = \"hello\"\ngreeting = \"hi\"\n[ctl]\nbell = \"a";
    let rt = Text.new(&arena);
    rt.add(rich);
    rt.push(7);
    rt.add("b\"\n[empty]\n");
    add(rt.str(), &all, &arena);
    match toml.json("[a.b]\nx = 1\n[a]\ny = \"2\"\n", &arena) {
        Result.Ok(j) { if j != "{\"a\":{\"b\":{\"x\":1},\"y\":\"2\"}}" { panic("sub-table order"); } }
        Result.Err(e) { panic(e); }
    }
    let esc = "[a]\nl = [\"a\\\"b\", \"c\", \"d\\\\\", \"e\"]\nt = { x = \"1\\\", y\", z = \"w\" }\n";
    match toml.json(esc, &arena) {
        Result.Ok(j) { if j != "{\"a\":{\"l\":[\"a\\\"b\",\"c\",\"d\\\\\",\"e\"],\"t\":{\"x\":\"1\\\", y\",\"z\":\"w\"}}}" { panic(j); } }
        Result.Err(e) { panic(e); }
    }
    add(esc, &all, &arena);

    // malformed and edge inputs: the JSON or error Rust gave
    let cases = [
        "x = 1\n",
        "[a]\nb c = 1\n",
        "[a]\nnoeq\n",
        "[a]\n= 1\n",
        "[a]\n1b = 1\n",
        "[a]\nb = [\"x\"\n",
        "[a]\nb = [\"x\", y]\n",
        "[a]\nb = \"x\n",
        "[a]\nb = {x = \"1\"\n",
        "[a]\nb = { x = [\"y\"] }\n",
        "[a]\nb = { x = 1, x = \"2\", y = z }\n",
        "[a]\nb = 1\n[a.b]\nx = 1\n",
        "[a.b]\nx = 1\n[a]\nb = 2\nb = 3\n",
        "[a]\n[a.b]\n[a]\nb = 1\n",
        "[a]\nb = []\nc = [ ]\nd = [\"x\",]\n",
        "  # only a comment\n[s]  # trailing\nk = \"v # not a comment\" # yes\n",
        "[a]\r\nb = \"x\"\r\n",
    ];
    for i in 0..cases.len { add(cases[i], &all, &arena); }

    // Where the stdlib reader (`j3.data.toml`) parts from Rust on purpose (PORT_DEBT.md "base/toml"): full
    // TOML grammar, so stricter on broken headers and clearer errors, and more forms read.
    let ours = [
        ("[a]\nb = x y\n", "j3.toml:2: unexpected `y` after the value"),
        ("[a..b]\nx = 1\n", "j3.toml:1: bad table header"),
        ("[a b]\nx = 1\n", "j3.toml:1: bad table header"),
        ("[]\nx = 1\n", "j3.toml:1: bad table header"),
        ("[[a]]\nx = 1\n", "j3.toml:1: `[[...]]` (an array of tables) is not read in this file"),
        ("[n]\na = 0\nb = -0\nc = 01\nd = 1.\nf = 1E+5\ng = -\nh = .5\nj = 1.2.3\n",
            "{\"n\":{\"a\":0,\"b\":-0,\"c\":\"01\",\"d\":\"1.\",\"f\":1E+5,\"g\":\"-\",\"h\":\".5\",\"j\":\"1.2.3\"}}"),
        ("[a]\nl = [\n  \"x\", # one\n  \"y\",\n]\nm = 'C:\\p'\nn = 1_000\nd.e = \"f\"\n",
            "{\"a\":{\"l\":[\"x\",\"y\"],\"m\":\"C:\\\\p\",\"n\":\"1_000\",\"d\":{\"e\":\"f\"}}}"),
        ("[a]\nx = \"\\u00e9\\ud800\\q\"\n", "{\"a\":{\"x\":\"é\\\\ud800\\\\q\"}}"),
    ];
    for i in 0..ours.len {
        let (src, want) = ours[i];
        let got = match toml.json(src, &arena) { Result.Ok(j) { j } Result.Err(e) { e } };
        if got != want {
            printLn(`{src}: got {got}; want {want}`);
            panic("ours differs");
        }
    }
    // DEL and U+0085 are control characters to Rust's `json_str`
    let ctl = Text.new(&arena);
    ctl.add("[a]\nb = \"");
    ctl.push(0x7f);
    ctl.push(0xc2);
    ctl.push(0x85);
    ctl.add("\"\n");
    add(ctl.str(), &all, &arena);
    unitkit.expect(all.str(), "base_toml.txt", "toml.json differs from tests/unit/expect/base_toml.txt");

    // the helpers on their own
    if !isIdent("a-b_1") || isIdent("1a") || isIdent("") || isIdent("a.b") { panic("isIdent"); }
    if unescape("a\\tb\\u0041\\x", &arena) != "a\tbA\\x" { panic("unescape"); }
    if unescape("\\", &arena) != "\\" || unescape("\\u12", &arena) != "\\u12" { panic("unescape edge"); }
    let cfg = "[editor]\nfont = \"Mono\\tX\"\nsize = 12\nlibs = [\"a\", \"b\"]\n";
    match toml.str(cfg, "editor", "font", &arena) { Option.Some(s) { if s != "Mono\\tX" { panic("str"); } } Option.None { panic("str none"); } }
    match toml.str(cfg, "editor", "size", &arena) { Option.Some(s) { if s != "12" { panic("str bare"); } } Option.None { panic("str bare none"); } }
    match toml.str(cfg, "editor", "libs", &arena) { Option.Some(_) { panic("str of a list"); } Option.None {} }
    match toml.list(cfg, "editor", "libs", &arena) { Option.Some(l) { if l.len != 2 || l.items[1] != "b" { panic("list"); } } Option.None { panic("list none"); } }
    match toml.list("oops", "editor", "libs", &arena) { Option.Some(_) { panic("list of bad toml"); } Option.None {} }
    match toml.parse("[a]\n[b]\nk = 1\n", &arena) {
        Result.Ok(t) {
            if !t.hasSection("a") || t.heads.len != 2 || t.heads.items[1].line != 2 || t.lines.items[0] != 3 { panic("heads/lines"); }
            match t.get("b", "k") { Option.Some(Val.Bare(s)) { if s != "1" { panic("get"); } } _ { panic("get kind"); } }
        }
        Result.Err(e) { panic(e); }
    }

    printLn("base_toml ok");
}
