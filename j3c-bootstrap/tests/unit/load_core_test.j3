// `load` core: the files loaded for corpus programs, a missing module, an import cycle, `@embedDir`
// globbing and a bad `@embed`, path deps and a dep's wrong `module` line. File counts and errors are
// compared with `tests/unit/expect/load_core.txt` (frozen from the Rust compiler's `J3C_TIMINGS` count and
// `check` text, plan 15; the stdlib, temp and repo folders masked). Live projects (this compiler, the
// tools, the editor) only have to load.
module load_core_test;

use j3.cmp.sortBy;
use j3.data.pool.Pool;
use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, endsWith };
use j3c.base.diag;
use j3c.base.diag.Diags;
use j3c.base.intern.Names;
use j3c.base.span.{ Source, isNone };
use j3c.load;
use j3c.load.{ LoadCx, LoadOpts, Parsed };
use unitkit;

fn check(c: bool, what: string) { if !c { panic(what); } }

fn put(dir: string, rel: string, body: string, a: &Arena) {
    let p = path.join(dir, rel, a);
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, body as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a fixture"); } }
}

/// One load: the program (None on errors) and the errors as Rust's `check` prints them.
struct Got {
    prog: Option<Parsed>;
    err: string;
}

fn loadIt(entry: string, a: &Arena): Got {
    let names = Names.new(a);
    let diags = Diags.new(a);
    let sources = Pool<Source>.new(a);
    let cx = LoadCx { arena: a, names: &names, diags: &diags, sources: &sources };
    let prog = load.loadProgram(cx, LoadOpts { entry: entry, given: false, target: "", overlays: Option.None, headless: false, release: false, dev: false, project: Option.None });
    let t = Text.new(a);
    for i in 0..diags.count() {
        let d = diags.at(i);
        if isNone(d.span) && !contains(d.msg, "error:") && !contains(d.msg, "-->") {
            t.add("j3c: ").add(d.msg).add("\n");
        } else {
            diag.render(d, &sources, &t);
        }
    }
    return Got { prog: prog, err: t.str() };
}

/// Appends `entry`'s load to `all`: `N files` when it loads, else its errors as `check` prints them.
fn add(entry: string, all: &Text, a: &Arena) {
    let g = loadIt(entry, a);
    all.add("== ").add(entry).add("\n");
    match g.prog {
        Option.Some(p) { all.pushInt(p.files.len); all.add(" files\n"); }
        Option.None { all.add(g.err); }
    }
}

/// `entry` loads with no error (a live project: its file count changes too often to freeze).
fn loads(entry: string, a: &Arena) {
    let g = loadIt(entry, a);
    match g.prog { Option.Some(_) {} Option.None { printLn(g.err); panic(Text.new(a).add("should load: ").add(entry).str()); } }
}

/// A failing load whose error holds `part`; the error goes to `all`.
fn fails(entry: string, part: string, all: &Text, a: &Arena) {
    let g = loadIt(entry, a);
    match g.prog { Option.Some(_) { panic(Text.new(a).add("should fail: ").add(entry).str()); } Option.None {} }
    if !contains(g.err, part) { printLn(g.err); panic(part); }
    all.add("== ").add(entry).add("\n").add(g.err);
}

/// Every `.j3` directly in `dir` (sorted), as entries.
fn j3Files(dir: string, out: &List<string>, a: &Arena) {
    let ents = match io.listDir(dir, a) { Result.Ok(e) { e } Result.Err(_) { panic(dir) } };
    let from = out.len;
    for i in 0..ents.len {
        if !ents[i].isDir && endsWith(ents[i].name, ".j3") { out.push(path.join(dir, ents[i].name, a)); }
    }
    sortBy(out.items[from..out.len], fn(x: string, y: string): bool { return x < y; });
}

fn main() {
    let arena = Arena.create(1 << 24);
    let a = &arena;
    let tmp = match io.tempDir("", "j3boot_load_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };

    let all = Text.new(a);
    // corpus programs: the file count Rust loaded (frozen in the expected file)
    let ins = List<string>.new(a);
    j3Files("../speculative", &ins, a);
    j3Files("../speculative/lang", &ins, a);
    j3Files("../j3c/stdlib/tests", &ins, a);
    ins.push("../examples/scripted");
    ins.push("../examples/3d-editor-scene");
    ins.push("../examples/editor_village");
    for i in 0..ins.len {
        let one = Arena.create(1 << 22);
        add(ins.items[i], &all, &one);
        one.destroy();
    }
    // live projects (the compiler, tools, the editor) only have to load
    let live = List<string>.new(a);
    live.push(".");
    live.push("../tools/composer");
    live.push("../tools/voxel-editor");
    // the editor (~180 files) as the project the editor build makes
    let ed = path.join(tmp, "editor", a);
    put(ed, "j3.toml", "[package]\nname = \"j3_editor\"\n", a);
    let edSrc = match path.realpath("../j3c/editor/src", a) { Option.Some(p) { p } Option.None { panic("no editor src") } };
    match proc.run(["ln", "-s", edSrc, path.join(ed, "src", a)], "", a) { Result.Ok(_) {} Result.Err(_) { panic("ln -s"); } }
    live.push(ed);
    for i in 0..live.len {
        let one = Arena.create(1 << 22);
        loads(live.items[i], &one);
        one.destroy();
    }

    // a missing module
    put(tmp, "miss/a.j3", "module m;\nuse foo.bar.baz;\nfn main() {}\n", a);
    fails(path.join(tmp, "miss/a.j3", a), "cannot find module `foo.bar` (looked for ", &all, a);
    put(tmp, "miss/b.j3", "module m;\nuse nope;\nfn main() {}\n", a);
    fails(path.join(tmp, "miss/b.j3", a), "cannot resolve `use nope`", &all, a);

    // an import cycle
    let cyc = path.join(tmp, "cyc", a);
    put(cyc, "j3.toml", "[package]\nname = \"cyc\"\n", a);
    put(cyc, "src/main.j3", "module cyc.main;\nuse cyc.a;\nfn main() {}\n", a);
    put(cyc, "src/a.j3", "module cyc.a;\nuse cyc.b;\npub fn f() {}\n", a);
    put(cyc, "src/b.j3", "module cyc.b;\nuse cyc.c.{ g };\npub fn h() {}\n", a);
    put(cyc, "src/c.j3", "module cyc.c;\nuse cyc.a;\npub fn g() {}\n", a);
    fails(cyc, "import cycle: cyc.a -> cyc.b -> cyc.c -> cyc.a", &all, a);

    // @embedDir: glob on the name, subfolders walked, dot entries skipped, sorted by path
    let em = path.join(tmp, "emb", a);
    put(em, "j3.toml", "[package]\nname = \"emb\"\n", a);
    put(em, "data/x.txt", "X", a);
    put(em, "data/sub/y.txt", "YY", a);
    put(em, "data/.h.txt", "H", a);
    put(em, "data/z.md", "Z", a);
    put(em, "src/main.j3", "module emb.main;\nconst T = @embedDir(\"../data\", \"*.txt\");\nconst S = @embedDir(\"data\", \"sub/*\");\nconst B = @embed(\"data/x.txt\");\nfn main() {}\n", a);
    let g = loadIt(em, a);
    match g.prog {
        Option.Some(p) {
            let f = p.files.items[0].ast;
            check(f.embeds.len == 3, "three embeds");
            let d0 = f.embeds.items[0].files;
            check(d0.len == 2 && d0.items[0].name == "sub/y.txt" && d0.items[1].name == "x.txt", "embedDir names");
            check((d0.items[0].data as string) == "YY" && (d0.items[1].data as string) == "X", "embedDir data");
            check(endsWith(d0.items[1].disk, "src/../data/x.txt"), "embed disk path beside the file");
            let d1 = f.embeds.items[1].files;
            check(d1.len == 1 && d1.items[0].name == "sub/y.txt", "glob with / matches the relative path");
            let d2 = f.embeds.items[2].files;
            check(d2.len == 1 && d2.items[0].name == "data/x.txt" && (d2.items[0].data as string) == "X", "embed from the package root");
        }
        Option.None { printLn(g.err); panic("embed project should load"); }
    }
    add(em, &all, a);
    put(em, "src/main.j3", "module emb.main;\nconst T = @embed(\"nope.txt\");\nfn main() {}\n", a);
    fails(em, "`@embed`: no file `nope.txt` (looked beside ", &all, a);
    put(em, "src/main.j3", "module emb.main;\nconst T = @embedDir(\"data\", \"*.png\");\nfn main() {}\n", a);
    fails(em, "`@embedDir`: no `*.png` files under ", &all, a);

    // a path dep: `use mlib;` is its root module, `use mlib.util;` a file below it
    let dp = path.join(tmp, "dep", a);
    put(dp, "mlib/j3.toml", "[package]\nname = \"mlib\"\n[lib]\n", a);
    put(dp, "mlib/src/mlib.j3", "module mlib;\npub fn one(): int { return 1; }\n", a);
    put(dp, "mlib/src/util.j3", "module mlib.util;\npub fn two(): int { return 2; }\n", a);
    put(dp, "mlib/src/bad.j3", "module mlib.wrong;\npub fn three(): int { return 3; }\n", a);
    put(dp, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\nmlib = \"../mlib\"\n", a);
    put(dp, "game/src/main.j3", "module game.main;\nuse mlib;\nuse mlib.util.two;\nfn main() {}\n", a);
    let game = path.join(dp, "game", a);
    let gd = loadIt(game, a);
    match gd.prog {
        Option.Some(p) {
            let seen = 0;
            for i in 0..p.files.len {
                let k = p.files.items[i].ast.moduleKey(p.ast);
                if k == "mlib" || k == "mlib.util" { seen += 1; }
            }
            check(seen == 2, "dep modules loaded");
        }
        Option.None { printLn(gd.err); panic("dep project should load"); }
    }
    add(game, &all, a);
    put(dp, "game/src/main.j3", "module game.main;\nuse mlib.bad;\nfn main() {}\n", a);
    fails(game, "imported as `mlib.bad` but says `module mlib.wrong;`", &all, a);

    // paths that differ per machine: the stdlib, the temp folder, the repo
    let m = unitkit.mask(all.str(), load.stdlibDir(a), "$STDLIB", a);
    m = unitkit.mask(m, tmp, "$TMP", a);
    let root = match path.realpath("..", a) { Option.Some(r) { r } Option.None { panic("no repo root") } };
    m = unitkit.mask(m, root, "$ROOT", a);
    unitkit.expect(m, "load_core.txt", "loads differ from tests/unit/expect/load_core.txt");
    printLn("load core ok");
}
