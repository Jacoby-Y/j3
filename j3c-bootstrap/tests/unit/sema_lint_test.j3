// Lint (`sema/lint*.j3`): a small program through the driver to `Stage.Sema`; its warnings in Rust's order
// (per body: unreachable code outer block first, then unused locals; then the module's unused imports), none from the
// stdlib, an `extend` body left alone, and the autofix edits applied by `applyFixes`.
module sema_lint_test;

use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.diag.Severity;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.sema.applyFixes;

const SRC: [20]string = [
    "module lints;",
    "use j3.io.printLn;",
    "use j3.memory.{ Arena, List };",
    "use j3.text.{ Text, trim };",
    "    use j3.option.Option; // not alone on its line",
    "  use j3.data.map.Map;  ",
    "use j3.result.Result; use j3.sys;",
    "struct S { x: int; }",
    "extend S { fn e(this: S): int { let quiet = 1; return 1; } }",
    "fn f(n: int): int {",
    "    let dead = 1;",
    "    let _kept = 2;",
    "    for i in 0..n {",
    "        break;",
    "        printLn(\"Arena\");",
    "    }",
    "    return n;",
    "    let after = trim(\"x\").len;",
    "}",
    "fn main() { f(1); }",
];

const WANT: [10]string = [
    "unreachable code after `return`",
    "unreachable code after `break`",
    "unused local `dead`",
    "unused local `after`",
    "unused import `List`",
    "unused import `Text`",
    "unused import `Option`",
    "unused import `Map`",
    "unused import `Result`",
    "unused import `sys`",
];

const FIXED: [19]string = [
    "module lints;",
    "use j3.io.printLn;",
    "use j3.memory.Arena;",
    "use j3.text.trim;",
    "    // not alone on its line",
    "",
    "struct S { x: int; }",
    "extend S { fn e(this: S): int { let quiet = 1; return 1; } }",
    "fn f(n: int): int {",
    "    let dead = 1;",
    "    let _kept = 2;",
    "    for i in 0..n {",
    "        break;",
    "        printLn(\"Arena\");",
    "    }",
    "    return n;",
    "    let after = trim(\"x\").len;",
    "}",
    "fn main() { f(1); }",
];

fn join(lines: []string, mem: &Arena): string {
    let text = Text.new(mem);
    for i in 0..lines.len { text.add(lines[i]).add("\n"); }
    return text.str();
}

fn main() {
    let mem = Arena.create(1 << 12);
    let src = join(SRC, &mem);
    // outside this package, whose project would otherwise load
    let d = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-sema-lint").str();
    match io.makeDirs(d) { Result.Ok(_) {} Result.Err(_) { panic("cannot make the case dir"); } }
    let p = Text.new(&mem).add(d).add("/lints.j3").str();
    match io.writeFile(p, src as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the case"); } }
    let o = driver.defaults();
    o.entry = p;
    let s = Session.new(o);
    if !driver.run(s, Stage.Sema) { panic("sema fails on the lint program"); }
    let n = 0;
    for i in 0..s.diags.count() {
        let dg = s.diags.at(i);
        match dg.severity { Severity.Error { panic("an error"); } Severity.Warning {} }
        if n >= WANT.len { panic(`extra warning: {dg.msg}`); }
        if dg.msg != WANT[n] { panic(`warning {n}: got "{dg.msg}", want "{WANT[n]}"`); }
        n += 1;
    }
    if n != WANT.len { panic(`{n} warnings, want {WANT.len}`); }
    if s.diags.at(2).notes.len != 1 || s.diags.at(2).notes.items[0].msg != "remove it, or name it `_dead` to keep it" { panic("unused local: help line"); }
    let c = match s.checked { Option.Some(x) { x } Option.None { panic("no checked program"); return; } };
    if c.fixes.len != 6 { panic(`{c.fixes.len} fixes, want 6`); }
    let got = applyFixes(src, c.fixes.slice(), &mem);
    // an unused `use` alone on its line goes with the line; two on one line leave it empty
    if got != join(FIXED, &mem) { panic(got); }
    s.free();
}
