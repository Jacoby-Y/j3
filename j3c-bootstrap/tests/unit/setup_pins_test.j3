// Plan 08 chunk 4 without the network: the pin table's shape, the streamed sha256 check, `newestLlvmMingw`'s
// numeric order, and `findClangIn`'s order (J3_CLANG, the setup toolchain, PATH) over a scratch folder.
module setup_pins_test;

use j3.io.path;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, endsWith, startsWith };
use j3c.base.fsx;
use j3c.toolchain.{ PIN_COUNT, ClangPick, findClangIn, newestLlvmMingw, pinFile, pins, shaMatches, fileSha256 };

fn expect(got: string, want: string) {
    if got != want {
        printLn(`got  {got}`);
        printLn(`want {want}`);
        panic("mismatch");
    }
}

fn newest(names: []string): string {
    match newestLlvmMingw(names) { Option.Some(n) { return n; } Option.None { return "<none>"; } }
}

fn pick(o: Option<ClangPick>): string {
    match o { Option.Some(p) { return Text.new(&SCRATCH).add(p.source).add(" ").add(p.cmd).str(); } Option.None { return "<none>"; } }
}

#[singleton]
let SCRATCH: Arena;
#[singleton]
let ROOT: string;
#[singleton]
let CLANG_ENV: string;
#[singleton]
let PATH_ENV: string;

fn env(n: string): string {
    if n == "J3_CACHE" { return ROOT; }
    if n == "J3_CLANG" { return CLANG_ENV; }
    if n == "PATH" { return PATH_ENV; }
    return "";
}

fn touch(p: string, a: &Arena) {
    fsx.makeDirs(path.dirname(p), a);
    match fsx.writeFile(p, "x" as []u8, a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
}

fn main() {
    SCRATCH = Arena.create(1 << 20);
    let a = &SCRATCH;

    // the table: https URLs, 64 lowercase hex digits, an archive name, a dated pin
    let ps = pins();
    for i in 0..PIN_COUNT {
        let p = ps[i];
        if !startsWith(p.url, "https://") { panic(p.url); }
        if p.sha256.len != 64 { panic(p.name); }
        for k in 0..64 {
            let c = p.sha256[k];
            if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')) { panic(p.name); }
        }
        let f = pinFile(&p);
        if !(endsWith(f, ".zip") || endsWith(f, ".tar.gz")) { panic(f); }
        if p.date.len != 10 || p.top.len == 0 || p.folder.len == 0 { panic(p.name); }
    }

    let n0: [3]string = ["llvm-mingw-20240101", "llvm-mingw-20250114", "llvm-mingw-9"];
    expect(newest(n0[..]), "llvm-mingw-20250114");
    let n1: [2]string = ["llvm-mingw-99999999", "llvm-mingw-100000000"];
    expect(newest(n1[..]), "llvm-mingw-100000000");
    let n2: [2]string = ["llvm-mingw-0020250114", "llvm-mingw-20240101"];
    expect(newest(n2[..]), "llvm-mingw-0020250114");
    let n3: [3]string = ["other", "llvm-mingw-", "llvm-mingw-x"];
    expect(newest(n3[..]), "<none>");

    let root = Text.new(a).add("target/setup_pins_test-").fmt(`{sys.getpid()}`).str();
    fsx.removeTree(root, a);
    ROOT = root;

    // sha256("abc"), streamed from a file; one flipped byte no longer matches
    let f = path.join(root, "abc.bin", a);
    fsx.makeDirs(root, a);
    fsx.writeFile(f, "abc" as []u8, a);
    let abc = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    match fileSha256(f, a) { Option.Some(h) { expect(h, abc); } Option.None { panic("unreadable"); } }
    fsx.writeFile(f, "abd" as []u8, a);
    if shaMatches(f, abc, a) { panic("flipped byte matched"); }
    if shaMatches(path.join(root, "missing", a), abc, a) { panic("missing file matched"); }

    let exe = if sys.PLATFORM == sys.PLATFORM_WINDOWS { "clang.exe" } else { "clang" };
    let bin = path.join(root, "bin", a);
    touch(path.join(bin, exe, a), a);
    PATH_ENV = Text.new(a).add("/nonexistent").add(if sys.PLATFORM == sys.PLATFORM_WINDOWS { ";" } else { ":" }).add(bin).str();
    CLANG_ENV = "";
    expect(pick(findClangIn(env, a)), "PATH clang");

    let tc = path.join(root, "toolchain", a);
    touch(path.join(path.join(path.join(tc, "llvm-mingw-20240101", a), "bin", a), exe, a), a);
    touch(path.join(path.join(path.join(tc, "llvm-mingw-20250114", a), "bin", a), exe, a), a);
    // a newer folder without a clang (a cut-off copy) is not picked
    fsx.makeDirs(path.join(path.join(tc, "llvm-mingw-20990101", a), "bin", a), a);
    expect(pick(findClangIn(env, a)), Text.new(a).add("j3c setup ").add(path.join(path.join(path.join(tc, "llvm-mingw-20250114", a), "bin", a), exe, a)).str());

    CLANG_ENV = "/opt/my/clang";
    expect(pick(findClangIn(env, a)), "J3_CLANG /opt/my/clang");

    CLANG_ENV = "";
    PATH_ENV = "/nonexistent";
    fsx.removeTree(tc, a);
    expect(pick(findClangIn(env, a)), "<none>");

    fsx.removeTree(root, a);
    printLn("ok");
}
