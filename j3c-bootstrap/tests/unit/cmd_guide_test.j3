// `j3c doc recipes` (Rust `doc/tests.rs` `recipes_check`): every recipe's files make a program `check`
// accepts; the index lists all 22. Texts are byte-compared with stage 0 in `tests/tool/new.txt`.
module cmd_guide_test;

use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, endsWith };
use j3c.base.fsx;
use j3c.cmd.check.checkCmd;
use j3c.cmd.guide;

const FONT = @embedBytes("../../../j3c/editor/font.ttf");

fn main() {
    let mem = Arena.create(1 << 22);
    defer mem.destroy();
    let all = guide.recipes(&mem);
    if all.len != 22 { panic("22 recipes"); }
    let idx = guide.recipeIndex(&mem);
    for i in 0..all.len {
        if !contains(idx, Text.new(&mem).add("    ").add(all.items[i].name).str()) { panic(all.items[i].name); }
    }
    match guide.recipe("bogus", &mem) {
        Result.Ok(_) { panic("bogus"); }
        Result.Err(e) { if !contains(e, "= help: one of app2d, scene3d") { panic(e); } }
    }
    let failed = Text.new(&mem);
    for i in 0..all.len {
        let r = all.items[i];
        if r.files.len == 0 { continue; }
        let dir = match io.tempDir("", Text.new(&mem).add("j3-recipe-").add(r.name).add("-").str(), &mem) {
            Result.Ok(d) { d }
            Result.Err(_) { panic("tempDir"); "" }
        };
        let font = false;
        let targets = List<string>.new(&mem);
        for k in 0..r.files.len {
            let p = path.join(dir, r.files.items[k].path, &mem);
            io.makeDirs(path.dirname(p));
            io.writeFile(p, r.files.items[k].text as []u8);
            if contains(r.files.items[k].text, "\"assets/font.ttf\"") { font = true; }
            if endsWith(p, ".j3") { targets.push(p); }
        }
        // A recipe that draws text expects the font `j3c new --template ui` ships.
        if font {
            io.makeDirs(path.join(dir, "assets", &mem));
            io.writeFile(path.join(dir, "assets/font.ttf", &mem), FONT);
        }
        if fsx.isFile(path.join(dir, "j3.toml", &mem)) {
            targets = List<string>.new(&mem);
            targets.push(dir);
        }
        for k in 0..targets.len {
            let a: [1]string = [targets.items[k]];
            if checkCmd(a[..]) != 0 { failed.add(" ").add(r.name); }
        }
        fsx.removeTree(dir, &mem);
    }
    if failed.len() > 0 { panic(Text.new(&mem).add("recipes that do not check:").add(failed.str()).str()); }
}
