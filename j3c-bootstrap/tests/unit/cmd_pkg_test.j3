// `cmd/pkg.j3`: Rust's `add_dep_line_places_and_replaces` and the listing half of `pkg_tool_runs_and_caches`
// (`tools_text`, `pkg_in` exit codes) on `tests/proj/pkg_game`. Running a tool is `pkgtool_test.j3`.
module cmd_pkg_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.pkg.{ addDepLine, pkgIn, toolsText };
use j3c.project.manifest;
use j3c.project.manifest.Manifest;

fn check(c: bool, what: string) { if !c { panic(what); } }

fn main() {
    let a = Arena.create(1 << 16);
    defer a.destroy();
    let t = "[package]\nname = \"a\"\n\n[dependencies]\nx = \"../x\"\n\n[emit]\nopt = 1\n";
    check(addDepLine(t, "y", "y = { path = \"../y\" }", &a) == "[package]\nname = \"a\"\n\n[dependencies]\nx = \"../x\"\ny = { path = \"../y\" }\n\n[emit]\nopt = 1\n", "placed last in the section");
    check(addDepLine(t, "x", "x = { git = \"u\" }", &a) == "[package]\nname = \"a\"\n\n[dependencies]\nx = { git = \"u\" }\n\n[emit]\nopt = 1\n", "replaced");
    check(addDepLine("[package]\nname = \"a\"\n", "y", "y = \"../y\"", &a) == "[package]\nname = \"a\"\n\n[dependencies]\ny = \"../y\"\n", "new section");
    check(addDepLine("", "y", "y = 1", &a) == "[dependencies]\ny = 1\n", "empty file");
    check(addDepLine("[package]", "y", "y = 1", &a) == "[package]\n\n[dependencies]\ny = 1\n", "no final newline");
    check(addDepLine("a = 1\n\n", "y", "y = 1", &a) == "a = 1\n\n[dependencies]\ny = 1\n", "blank line kept once");
    check(addDepLine("[dependencies]\n", "y", "y = 1", &a) == "[dependencies]\ny = 1\n", "empty section at the end");

    let m = match manifest.load("tests/proj/pkg_game/j3.toml", &a) {
        Result.Ok(m) { m }
        Result.Err(e) { panic(e) }
    };
    check(m.deps.len == 1, "one dep");
    check(toolsText(&m.deps.items[0], &a) == "tool_pkg\n  echo  print args, env and the greeting, exit 3\n  dist: fake\n", "tools_text");
    let none: [1]string = ["x"];
    check(pkgIn("tests/proj/pkg_game", none[0..0]) == 0, "pkg lists");
    let nope: [1]string = ["nope"];
    check(pkgIn("tests/proj/pkg_game/src", nope[..]) == 1, "no such dep");
    let cmd: [2]string = ["tool_pkg", "nope"];
    check(pkgIn("tests/proj/pkg_game", cmd[..]) == 1, "no such command");
    let one: [1]string = ["tool_pkg"];
    check(pkgIn("tests/proj/pkg_game", one[..]) == 0, "pkg NAME lists");
}
