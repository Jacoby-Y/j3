// Fixture of lower_pat_test.j3 (copied to target/ before it is compiled): every pattern shape lower/pat_*
// handles. Guards, `|` with binds, nested variant / struct / literal / range parts, string arms, an int
// `Switch` as a value, `let .. else`, `if let`, destructuring `let`, `?` (same enum, other enum, no payload).
module pat_l1;

use j3.io.printLn;

enum Shape { Circle(int), Rect(int, int), Dot }
struct P { x: int; y: int; }
enum Wrap { One(Shape), Pt(P), No }

#[TryCatch(Ok, Err)]
enum R1 { Ok(int), Err(string) }
#[TryCatch(Fine, Bad)]
enum R2 { Fine(bool), Bad(string) }
#[TryCatch(Yes, Nope)]
enum R3 { Yes, Nope }

const LIMIT: int = 7;

fn half(n: int): R1 {
    if n % 2 != 0 { return R1.Err("odd"); }
    return R1.Ok(n / 2);
}

fn quarter(n: int): R1 {
    let h = half(n)?;
    let q = half(h)?;
    return R1.Ok(q);
}

fn cross(n: int): R2 {
    let h = half(n)?;
    return R2.Fine(h > 2);
}

fn bare(ok: bool): R3 {
    if ok { return R3.Yes; }
    return R3.Nope;
}

fn chain(ok: bool): R3 {
    bare(ok)?;
    return R3.Yes;
}

fn area(s: Shape): int {
    match s {
        Shape.Circle(r) if r > 10 { return 300; }
        Shape.Circle(r) { return 3 * r * r; }
        Shape.Rect(w, h) if w == h { return w * w; }
        Shape.Rect(w, h) { return w * h; }
        Shape.Dot { return 0; }
    }
}

fn side(s: Shape): int {
    match s {
        Shape.Circle(n) | Shape.Rect(n, _) { return n; }
        Shape.Dot { return -1; }
    }
}

fn deep(w: Wrap): int {
    match w {
        Wrap.One(Shape.Rect(3, h)) { return h; }
        Wrap.One(Shape.Circle(1..=4)) { return 1; }
        Wrap.One(_) { return 2; }
        Wrap.Pt(P { x: 0, y }) { return y; }
        Wrap.Pt(P { x, .. }) { return x; }
        Wrap.No { return 0; }
    }
}

fn word(s: string): int {
    match s {
        "one" { return 1; }
        "two" | "deux" { return 2; }
        _ { return 0; }
    }
}

fn flag(b: bool): string {
    match R2.Fine(b) {
        R2.Fine(true) { return "yes"; }
        R2.Fine(false) { return "no"; }
        R2.Bad("x") { return "x"; }
        R2.Bad(_) { return "bad"; }
    }
}

fn bucket(n: int): string {
    let name = match n {
        0 { "zero" }
        LIMIT { "limit" }
        -1 { "neg" }
        _ { "many" }
    };
    return name;
}

fn range(c: u8): int {
    match c {
        'a'..='z' | 'A'..='Z' { return 1; }
        '0'..='9' { return 2; }
        200 if c > 127 { return 3; }
        _ { return 0; }
    }
}

fn first(s: Shape): int {
    let Shape.Circle(r) = s else { return -1; };
    let v = if let Shape.Circle(q) = s { q + r } else { 0 };
    return v;
}

fn sum(p: P): int {
    let P { x, y: why } = p;
    let P { x: _, y } = p;
    return x + why + y;
}

fn loop(xs: []Shape): int {
    let n = 0;
    for i in 0..xs.len {
        let k = match xs[i] {
            Shape.Dot { continue; }
            Shape.Circle(r) { r }
            Shape.Rect(w, h) { w + h }
        };
        n += k;
    }
    return n;
}

fn main() {
    let c0 = Shape.Circle(2);
    let xs = [c0, Shape.Rect(2, 3), Shape.Dot];
    printLn(`{area(xs[0])} {area(xs[1])} {side(xs[1])} {loop(xs[0..3])}`);
    printLn(`{deep(Wrap.One(Shape.Rect(3, 9)))} {deep(Wrap.Pt(P { x: 0, y: 5 }))} {deep(Wrap.No)}`);
    printLn(`{word("deux")} {flag(true)} {bucket(7)} {range('q')} {first(xs[0])} {sum(P { x: 1, y: 2 })}`);
    match quarter(12) { R1.Ok(v) { printLn(`q={v}`); } R1.Err(e) { printLn(e); } }
    match cross(5) { R2.Fine(_) { printLn("fine"); } R2.Bad(e) { printLn(e); } }
    match chain(false) { R3.Yes { printLn("yes"); } R3.Nope { printLn("nope"); } }
}
