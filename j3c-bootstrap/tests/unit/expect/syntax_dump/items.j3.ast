(file (doc "file doc") (module m n) (dyns Show)
  (use j3.memory (names Arena List))
  (use j3.io)
  (use-lib "libc.so.6" c
    (lib-fn puts (params (s (ref u8))) int "puts")
    (lib-fn abort (params) _ _))
  (const (doc "c doc") pub K int 3)
  (const L _ 4)
  (struct pub debug (derives Eq Hash) P (tparams (T Eq Hash) U)
    (field (doc "f doc") x T 0)
    (field embedded y U)
    (fn m (where (T Ord)) (params (this (ref (gen P T U)))) int (block
      (return 1))))
  (struct vertex V
    (field pos vec2)
    (field flat c vec4))
  (enum pub (try-catch Ok Err) R (tparams T)
    (case (doc "ok") Ok T int)
    (case Err))
  (trait Show (supers Eq)
    (trait-fn show (params (this Self)) string _)
    (trait-fn d (params (this Self)) _ (block
      (return))))
  (extend P (tparams T U)
    (fn n (params (this (ref (gen P T U)))) _ (block)))
  (mod-let thread tl int 0)
  (mod-let uniform g (array 4 f32) _)
  (fn shader-vertex vs (params (a (slice u8)) (b (fn-type (int f32) bool)) (c (closure-type (int) _)) (d (closure-type boxed () int)) (e (tuple-type int f32)) (f (dyn Show))) _ (block))
  (fn impl imp (params) _ (block))
  (fn (doc "fd") pub pf (params) int (block
    (return 0)))
  (use j3.cmp (names)))
