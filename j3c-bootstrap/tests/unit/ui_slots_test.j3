// ui/gen slots: `declaredSlots` + `scanSites` on speculative/14_ui_slots (site ids, owners and slot names as
// `stage0/j3c dump-ui speculative/14_ui_slots/ui` shows them in `slot<id>_<name>_update` / `slotSite = <id>`),
// and `lowerChoices` on speculative/24_ui_dynamic (the `Of_*` enum set, fresh uids per branch) with its errors.
module ui_slots_test;

use j3.io.{ printLn, readFile };
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.ui.gen.{ ChoiceSet, Comp, Slots, declaredSlots, emptySlots, joinStr, lowerChoices, scanSites, slotOf };
use j3c.ui.markup;
use j3c.ui.markup.{ Markup, Node, emptyScript };

fn read(p: string, a: &Arena): string {
    return match readFile(p, a) { Result.Ok(b) { b as string } Result.Err(_) { panic(`can't read {p}`); "" } };
}

fn parse(src: string, uid: &int, a: &Arena): Markup {
    match markup.parse(src, a, uid) {
        Result.Ok(m) { return m; }
        Result.Err(e) { printLn(e.msg); panic("parse"); }
    }
    panic("parse");
    return parse(src, uid, a);
}

fn check(ok: bool, what: string) { if !ok { panic(what); } }

fn comp(name: string, dir: string, uid: &int, a: &Arena): Comp {
    let src = read(`{dir}/{name}.j3ui`, a);
    return Comp { name: name, id: name, fi: 0, mk: parse(src, uid, a), sc: emptyScript(a), scope: 0 };
}

/// `lowerChoices` on one `<component>` source; the error text, "" when it passes.
fn lowerErr(src: string, known: &List<string>, a: &Arena): string {
    let uid = 0;
    let m = parse(src, &uid, a);
    let sets = List<ChoiceSet>.new(a);
    match lowerChoices(&m.nodes, src, known, &sets, &uid, a) {
        Result.Ok(_) { return ""; }
        Result.Err(e) { return e.msg; }
    }
    return "";
}

fn main() {
    let arena = Arena.create(1 << 22);
    let a = &arena;
    let uid = 0;

    // ---- sites: components in name order, ids 1-based across the project
    let names: [7]string = ["Card", "Modal", "Panel", "Probe", "Row", "Screen", "Tag"];
    let all = List<Comp>.new(a);
    let decl = List<List<string>>.new(a);
    for i in 0..7 {
        all.push(comp(names[i], "../speculative/14_ui_slots/ui", &uid, a));
        let d = List<string>.new(a);
        match declaredSlots(&all.items[i].mk.nodes, &d) { Result.Ok(_) {} Result.Err(e) { panic(e.msg); } }
        decl.push(d);
    }
    check(joinStr(a, &decl.items[0], ",") == "actions,,footer", "Card declares slots in tree order");
    let s = emptySlots(a);
    for i in 0..7 {
        match scanSites(&all.items[i].mk.nodes, &all, &decl, all.items[i].id, &s) { Result.Ok(_) {} Result.Err(e) { panic(e.msg); } }
    }
    check(s.list.len == 10, "10 sites");
    for i in 0..10 { check(s.list.items[i].id == i + 1, "site ids are 1-based, in order"); }
    check(s.list.items[0].owner == "Panel" && joinStr(a, &s.list.items[0].names, ",") == ",actions", "site 1");
    check(s.list.items[1].owner == "Screen" && joinStr(a, &s.list.items[1].names, ",") == "actions,,footer", "site 2");
    check(joinStr(a, &s.list.items[2].names, ",") == ",actions", "site 3");
    check(joinStr(a, &s.list.items[5].names, ",") == "footer", "site 6");
    for i in 1..10 { check(s.list.items[i].owner == "Screen", "sites 2..10 are Screen's"); }
    check(s.byUid.len == 10, "one uid per site");

    // ---- declaredSlots errors
    let u2 = 0;
    let m = parse("<div><slot /><slot /></div>", &u2, a);
    let d = List<string>.new(a);
    match declaredSlots(&m.nodes, &d) { Result.Ok(_) { panic("two defaults"); } Result.Err(e) { check(e.msg == "a component has one default `<slot />`", e.msg); } }
    m = parse("<div><slot name=\"x\" /><slot name=\"x\" /></div>", &u2, a);
    d = List<string>.new(a);
    match declaredSlots(&m.nodes, &d) { Result.Ok(_) { panic("two x"); } Result.Err(e) { check(e.msg == "two `<slot name=\"x\">` in one component", e.msg); } }
    m = parse("<slot name=\"default\" />", &u2, a);
    d = List<string>.new(a);
    match declaredSlots(&m.nodes, &d) { Result.Ok(_) { panic("default"); } Result.Err(e) { check(e.msg == "`<slot name=\"default\">` is the default slot: use `<slot />`", e.msg); } }

    // ---- lowerChoices: one enum set for the two uses, a `{#match}` with a fresh element per candidate
    let known = List<string>.new(a);
    known.push("Embed");
    known.push("ImageMsg");
    known.push("Screen");
    known.push("TextMsg");
    let src = read("../speculative/24_ui_dynamic/ui/Screen.j3ui", a);
    let u3 = 0;
    let mk = parse(src, &u3, a);
    let before = u3;
    let sets = List<ChoiceSet>.new(a);
    match lowerChoices(&mk.nodes, src, &known, &sets, &u3, a) { Result.Ok(_) {} Result.Err(e) { panic(e.msg); } }
    check(sets.len == 1 && sets.items[0].name == "Of_TextMsg_ImageMsg_Embed", "one set");
    check(joinStr(a, &sets.items[0].candidates, ",") == "TextMsg,ImageMsg,Embed", "candidates in written order");
    check(u3 > before, "clones get fresh uids");
    check(lowerErr("<component this={k} of={TextMsg, Nope} />", &known, a) == "unknown component `Nope` in `of` (expected a comma-separated component list)", "unknown");
    check(lowerErr("<component this={k} of={TextMsg, TextMsg} />", &known, a) == "duplicate component `TextMsg` in `of`", "duplicate");
    check(lowerErr("<component of={TextMsg} />", &known, a) == "`<component>` needs `this={...}`", "this");
    check(lowerErr("<component this={k} />", &known, a) == "`<component>` needs `of={...}`", "of");
    check(lowerErr("<component this={k} of={TextMsg} j3pass_cls=\"x\" />", &known, a) == "reserved attribute `j3pass_cls`", "reserved");

    // a lowered use: 2 branches, each its own element uid; the `slot=` stays on every copy
    let u4 = 0;
    let lm = parse("<div><component this={k} of={TextMsg, Embed} slot=\"footer\" /></div>", &u4, a);
    let ls = List<ChoiceSet>.new(a);
    let two = "<div><component this={k} of={TextMsg, Embed} slot=\"footer\" /></div>";
    match lowerChoices(&lm.nodes, two, &known, &ls, &u4, a) { Result.Ok(_) {} Result.Err(e) { panic(e.msg); } }
    match lm.nodes.items[0] {
        Node.Elem(div) {
            check(slotOf(&div.children.items[0]) == "footer", "a choice carries its `slot=`");
            match div.children.items[0] {
                Node.If(i) {
                    check(i.branches.len == 2, "one branch per candidate");
                    match i.choice { Option.Some(c) { check(c == "Of_TextMsg_Embed", "choice set"); } Option.None { panic("choice"); } }
                    match i.branches.items[0].nodes.items[0] {
                        Node.Elem(x) {
                            check(x.tag == "TextMsg" && x.comp && x.attrs.len == 1, "candidate element");
                            match i.branches.items[1].nodes.items[0] {
                                Node.Elem(y) { check(y.tag == "Embed" && y.uid != x.uid && y.uid != i.uid, "fresh uids"); }
                                Node.Let(_) { panic("branch 2"); } Node.Text(_) { panic("branch 2"); } Node.If(_) { panic("branch 2"); } Node.Each(_) { panic("branch 2"); }
                            }
                        }
                        Node.Let(_) { panic("branch 1"); } Node.Text(_) { panic("branch 1"); } Node.If(_) { panic("branch 1"); } Node.Each(_) { panic("branch 1"); }
                    }
                }
                Node.Let(_) { panic("not lowered"); } Node.Text(_) { panic("not lowered"); } Node.Elem(_) { panic("not lowered"); } Node.Each(_) { panic("not lowered"); }
            }
        }
        Node.Let(_) { panic("div"); } Node.Text(_) { panic("div"); } Node.If(_) { panic("div"); } Node.Each(_) { panic("div"); }
    }
}
