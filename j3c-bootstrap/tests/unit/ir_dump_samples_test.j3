// `ir_samples` printed by `ir.dump` equals `tests/unit/expect/ir_dump_samples.ir` (frozen from the Rust
// printer's `dump-ir samples`, plan 15) byte for byte,
// plus the substrings Rust's own sample test checks.
// J3: Says `module ir_samples;` to get the fixture parts (`ir_dump_samples_test/` is a symlink to
// `ir_samples/`); the fixture's `use`s are in `ir_samples/samples.j3`.
module ir_samples;

use j3.io.printLn;
use j3.sys.panic;
use j3.text.{ Text, contains };
use j3c.driver;
use j3c.driver.Session;
use j3c.ir.dump.dumpModule;
use unitkit;

fn main() {
    let s = Session.new(driver.defaults());
    let p = Program.new(s.arena, &s.names, &s.sources);
    placeSamples(&p);
    let t = Text.new(s.arena);
    dumpModule(&p.cx, &p.modules.items[0], &t);
    let got = t.str();
    let subs = ["(*this).x *= copy s", "xs[copy i] += 1", "&(*(*g).mem)", "(*g).running = false"];
    for i in 0..subs.len { if !contains(got, subs[i]) { printLn(got); panic(subs[i]); } }
    unitkit.expect(got, "ir_dump_samples.ir", "ir dump differs from tests/unit/expect/ir_dump_samples.ir");
    s.free();
}
