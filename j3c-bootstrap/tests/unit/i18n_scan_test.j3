// `cmd/i18n` scanning, locale parsing and lint (Rust i18n.rs tests). cwd = j3c-bootstrap/.
module i18n_scan_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.i18n.{ Use, lint, parseLocale, scanText };

fn keys(src: string, file: string, a: &Arena): string {
    let us = List<Use>.new(a);
    scanText(src, file, &us, a);
    let t = Text.new(a);
    for i in 0..us.len { t.fmt(`{us.items[i].key}@{us.items[i].line}:{us.items[i].col};`); }
    return t.str();
}

fn same(got: string, want: string) {
    if got != want { printLn(got); panic(`want {want}`); }
}

fn main() {
    let a = Arena.create(1 << 16);
    same(keys("let a = t(\"a.b\");\n// t(\"commented\")\nlet s = \"t(\\\"instr\\\")\"; let b = t (\"spaced\");\n", "f.j3", &a), "a.b@1:11;spaced@3:36;");
    let ui = "<script>\n    fn f(): string { return t(\"in.script\"); }\n</script>\n<p title={t(\"attr.key\")}>{tf(\"x.y\", num(2))} {i18n.t( \"z\")} {set(\"no\")} {t(k)}</p>\n";
    same(keys(ui, "A.j3ui", &a), "in.script@2:31;attr.key@4:13;x.y@4:30;z@4:55;");
    same(keys("x = t(\"ü\"); t(\"k\");", "w.j3", &a), "ü@1:7;k@1:15;");
    let ks = parseLocale("# c\n\nhello = Hi\n  items.one = x\n= v\nnoeq\n", &a);
    if ks.len != 2 || ks.items[0].key != "hello" || ks.items[0].line != 3 || ks.items[1].key != "items.one" || ks.items[1].line != 4 {
        panic("parseLocale");
    }
    let w = lint("tests/proj/lint_i18n_nodef", &a);
    if w.len != 1 || w.items[0] != "warning: lang/fr.txt:1:1: default locale file is missing [i18n-missing]" { panic("nodef"); }
    let w2 = lint("tests/proj/lint_i18n", &a);
    if w2.len != 13 || w2.items[12] != "warning: locales/de.txt:3:1: key `extra` is not in the default locale locales/en.txt [i18n-missing]" {
        for i in 0..w2.len { printLn(w2.items[i]); }
        panic("lint_i18n");
    }
    a.destroy();
}
