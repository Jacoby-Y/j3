// ui/gen `generate` on a text-only component (script, text, `{#let}`, style; no elements): the whole module
// text, header included, for a project without and with a theme. The `.expect` files are
// the Rust compiler's `dump-ui PROJECT` of that project (package `txt` / `thm`, theme text as below).
// Also the name checks of `generate` (Rust gen/mod.rs) and their texts.
module ui_gen_head_test;

use j3.io.{ printLn, readFile };
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.ui.gen.{ SrcFile, Theme, generate, noFile };
use j3c.ui.icons.Icon;

fn read(p: string, a: &Arena): string {
    return match readFile(p, a) { Result.Ok(b) { b as string } Result.Err(_) { panic(`can't read {p}`); "" } };
}

fn one(path: string, name: string, text: string, a: &Arena): List<SrcFile> {
    let fs = List<SrcFile>.new(a);
    fs.push(SrcFile { path: path, name: name, text: text, src: noFile() });
    return fs;
}

fn same(got: string, want: string, what: string) {
    if got == want { return; }
    let n = if got.len < want.len { got.len } else { want.len };
    let i = 0;
    while i < n && got[i] == want[i] { i += 1; }
    let lo = if i > 60 { i - 60 } else { 0 };
    printLn(`{what}: differs at byte {i}`);
    printLn(got[lo..if i + 60 < got.len { i + 60 } else { got.len }]);
    printLn("---- want");
    printLn(want[lo..if i + 60 < want.len { i + 60 } else { want.len }]);
    panic(what);
}

fn fails(fs: List<SrcFile>, msg: string, help: string, a: &Arena) {
    let icons = List<Icon>.new(a);
    match generate(&fs, "p", Option.None, &icons, "", a) {
        Result.Ok(_) { panic(msg); }
        Result.Err(e) {
            if e.err.msg != msg { printLn(e.err.msg); panic(msg); }
            if e.err.help != help { printLn(e.err.help); panic(help); }
        }
    }
}

fn main() {
    let arena = Arena.create(1 << 22);
    let a = &arena;
    let icons = List<Icon>.new(a);
    let text = read("tests/unit/ui_gen_head_Screen.j3ui", a);
    let fs = one("ui/Screen.j3ui", "Screen", text, a);
    match generate(&fs, "txt", Option.None, &icons, "", a) {
        Result.Ok(b) {
            same(b.text, read("tests/unit/ui_gen_head_plain.expect", a), "no theme");
            if b.sections.len != 1 || b.sections.items[0].name != "Screen" || b.sections.items[0].hi != b.text.len { panic("sections"); }
            let lo = b.sections.items[0].lo;
            if b.text[lo..lo + 8] != "// ---- " { panic("section start"); }
            // the user `use` lines carry their source range; the last segment ends the text
            if b.segs.items[b.segs.len - 1].hi != b.text.len { panic("segs cover the text"); }
        }
        Result.Err(e) { printLn(e.err.msg); panic("generate (no theme)"); }
    }
    let th = Theme { path: "theme.css", text: "body { color: \"red\"; }\n\t.x\\y {}\n" };
    match generate(&fs, "thm", Option.Some(th), &icons, "", a) {
        Result.Ok(b) { same(b.text, read("tests/unit/ui_gen_head_theme.expect", a), "theme"); }
        Result.Err(e) { printLn(e.err.msg); panic("generate (theme)"); }
    }

    fails(one("ui/row.j3ui", "row", "x", a), "`row` is not a component name", "component files are named like their component: Capitalised letters, digits, `_`, e.g. UpgradeRow.j3ui", a);
    fails(one("ui/2d/Row.j3ui", "2d.Row", "x", a), "folder `2d` in `ui/2d/Row.j3ui` is not a valid name segment", "folders under ui/ become part of the component name: start with a letter, then letters, digits, `_`", a);
    fails(one("ui/List.j3ui", "List", "x", a), "`ui/List.j3ui` generates the J3 name `List`, which the generated module already uses", "rename the component", a);
    let two = one("ui/A/B.j3ui", "A.B", "x", a);
    two.push(SrcFile { path: "ui/A_B.j3ui", name: "A_B", text: "x", src: noFile() });
    fails(two, "`ui/A_B.j3ui` and `ui/A/B.j3ui` both generate the J3 name `A_B`", "rename one of the files or folders", a);
    let ev = one("ui/Row.j3ui", "Row", "x", a);
    ev.push(SrcFile { path: "ui/RowEvents.j3ui", name: "RowEvents", text: "x", src: noFile() });
    fails(ev, "`ui/RowEvents.j3ui` and `ui/Row.j3ui` both generate the J3 name `RowEvents` / `Row`", "rename one of the files or folders", a);
}
