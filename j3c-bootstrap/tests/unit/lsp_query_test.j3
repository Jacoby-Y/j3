// LSP hover and goto (`lsp/query.j3`, `sema/query.j3`): Rust's `lsp/query/tests.rs` ported, then hover and
// definition compared byte for byte with `stage0/j3c lsp` (one Content-Length session per file: open the
// buffer, hover/define at each needle) on single-definition names (B12.5: duplicate names may differ).
module lsp_query_test;

use j3.data.json;
use j3.data.json.Json;
use j3.io;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, endsWith, find, lastIndexOf };
use j3.data.pool.Id;
use j3.io.path;
use j3c.base.span.{ Source, Span };
use j3c.driver.Session;
use j3c.load;
use j3c.load.Overlay;
use j3c.lsp.query;
use j3c.lsp.query.{ Hover, Location };

fn read(p: string, a: &Arena): string {
    match io.readFile(p, a) { Result.Ok(b) { return b as string; } Result.Err(_) { panic(Text.new(a).add("cannot read ").add(p).str()); } }
    return "";
}

/// `p` made absolute, as the LSP passes paths (a relative `../x` would find `j3c-bootstrap/j3.toml` walking up).
fn abs(p: string, a: &Arena): string {
    match path.realpath(p, a) { Option.Some(x) { return x; } Option.None { panic(Text.new(a).add("no such file: ").add(p).str()); } }
    return p;
}

fn at(src: string, needle: string, a: &Arena): u32 {
    let i = find(src, needle);
    if i < 0 { panic(Text.new(a).add("needle not found: ").add(needle).str()); }
    return u32(i);
}

fn session(p: string, overlays: []Overlay): &Session {
    match query.analyze(p, overlays) { Result.Ok(s) { return s; } Result.Err(e) { panic(Text.scratch().add(p).add(": ").add(e).str()); } }
}

fn hoverText(s: &Session, p: string, off: u32, a: &Arena): string {
    match query.hover(s, p, off, a) { Option.Some(h) { return h.text; } Option.None { let m = Text.new(a); m.add("no hover: ").add(p).add(" at ").pushInt(int(off)); panic(m.str()); } }
    return "";
}

fn want(ok: bool, what: string, got: string) {
    if !ok { printLn(what); printLn(got); panic("check failed"); }
}

fn noOverlays(a: &Arena): []Overlay { return List<Overlay>.new(a).slice(); }

/// Rust `script_type_hover_and_path_goto`.
fn scriptHoverAndGoto(a: &Arena) {
    let p = abs("../speculative/11_script/main.j3", a);
    let s = session(p, noOverlays(a));
    let src = read(p, a);
    let h = hoverText(s, p, at(src, "const Door", a) + 6, a);
    want(contains(h, "script Door") && contains(h, "prop hinge") && contains(h, "pub fn toggle"), "script type hover", h);
    match query.definition(s, p, at(src, "scripts/door.j3s", a) + 4, a) {
        Option.Some(d) {
            want(endsWith(d.path, "scripts/door.j3s"), "script path goto", d.path);
            let ss = read(d.path, a);
            let sh = hoverText(s, d.path, at(ss, "if open", a) + 3, a);
            want(contains(sh, "state open: bool"), "state hover", sh);
        }
        Option.None { panic("no script path goto"); }
    }
    s.free();
}

/// Rust `hover_print_ln_on_hello` (hover and goto; the completion half is in `lsp_complete_test`).
fn helloPrintLn(a: &Arena) {
    let p = load.helloPath(a);
    let s = session(p, noOverlays(a));
    let src = read(p, a);
    let off = at(src, "printLn", a);
    let h = hoverText(s, p, off, a);
    want(contains(h, "fn") || contains(h, "printLn"), "printLn hover", h);
    match query.definition(s, p, off, a) {
        Option.Some(d) { want(contains(d.path, "io.j3"), "printLn goto", d.path); }
        Option.None { panic("no printLn goto"); }
    }
    s.free();
}

/// Rust `doc_comment_shows_on_hover_and_completion` (hover half), `const_doc_shows_on_hover`,
/// `array_const_analyzes_hovers_and_completes`, `else_if_expr_and_rvalue_field_analyze_and_hover`,
/// `if_let_and_let_else_bindings_hover_and_complete`: buffers over the hello path.
fn overlayHovers(a: &Arena) {
    let p = load.helloPath(a);
    let ov = List<Overlay>.new(a);
    let src = "module hello;\n\n/// Prints a line.\nfn greet(name: string) {\nlet _ = name;\n}\n\nfn main() {\n/// the player\nlet player = 1;\ngreet(\"a\");\nlet _ = player;\n}\n";
    ov.push(Overlay { path: p, text: src });
    let s = session(p, ov.slice());
    let h = hoverText(s, p, at(src, "greet(\"a\")", a), a);
    want(contains(h, "Prints a line."), "fn doc hover", h);
    h = hoverText(s, p, u32(lastIndexOf(src, "player")), a);
    want(contains(h, "the player"), "let doc hover", h);
    s.free();

    src = "module hello;\n\nuse j3.math.PI;\n\nfn main() {\nlet x = PI;\nlet _ = x;\n}\n";
    ov.items[0].text = src;
    s = session(p, ov.slice());
    h = hoverText(s, p, at(src, "PI;", a), a);
    want(contains(h, "circumference"), "const doc hover", h);
    s.free();

    src = "module hello;\n\n/// Squares.\nconst SQ: [3]int = [1, 4, 9];\n\nfn main() {\nlet x = SQ[1];\nlet _ = x;\n}\n";
    ov.items[0].text = src;
    s = session(p, ov.slice());
    h = hoverText(s, p, u32(lastIndexOf(src, "SQ")), a);
    s.free();

    src = "module hello;\n\nfn main() {\nlet xs: [4]int = [1, 2, 3, 4];\nlet i = 2;\nlet k = if i < 1 { 1 } else if i < 2 { 2 } else { 3 };\nlet n = xs[1..3].len;\nlet _ = k + n;\n}\n";
    ov.items[0].text = src;
    s = session(p, ov.slice());
    let h1 = query.hover(s, p, at(src, "].len", a) + 3, a);
    let h2 = query.hover(s, p, at(src, "else if", a) + 1, a);
    s.free();

    src = "module hello;\n\nenum Tok { Num(int), Word(string), End }\n\nfn f(t: Tok): int {\nif let Tok.Word(word) = t {\nlet _ = word;\n}\nlet Tok.Num(count) = t else { return 0; };\nreturn count;\n}\n\nfn main() {\nlet _ = f(Tok.End);\n}\n";
    ov.items[0].text = src;
    s = session(p, ov.slice());
    h = hoverText(s, p, at(src, "_ = word", a) + 4, a);
    want(contains(h, "string"), "if-let binding hover", h);
    h = hoverText(s, p, at(src, "return count", a) + 7, a);
    want(contains(h, "int"), "let-else binding hover", h);
    s.free();
}

/// Rust `hover_and_goto_on_dyn_and_char_literals`.
fn dynAndChars(a: &Arena) {
    let p = abs("../speculative/lang/dyn.j3", a);
    let s = session(p, noOverlays(a));
    let src = read(p, a);
    let decl = at(src, "pub trait Backend", a) + 10;
    let kw = at(src, "out: dyn Backend", a) + 5;
    let h = hoverText(s, p, kw, a);
    want(contains(h, "trait Backend: Named") && contains(h, "fn emit"), "dyn hover", h);
    let nameAt = kw + 4;
    h = hoverText(s, p, nameAt, a);
    want(contains(h, "trait Backend") && !contains(h, "`dyn` value"), "trait name hover", h);
    let offs: [2]u32 = [kw, nameAt];
    for i in 0..2 {
        match query.definition(s, p, offs[i], a) {
            Option.Some(d) { want(d.span.lo == decl, "trait goto", d.path); }
            Option.None { panic("no trait goto"); }
        }
    }
    s.free();
    p = abs("../speculative/lang/chars.j3", a);
    s = session(p, noOverlays(a));
    src = read(p, a);
    h = hoverText(s, p, at(src, "let a = 'a'", a) + 9, a);
    want(contains(h, "'a': u8") && contains(h, "code point 97 (U+0061)"), "char hover", h);
    s.free();
}

/// Positions, formatting.
fn positions(a: &Arena) {
    let src = "ab\ncd\n\nxyz";
    let r = query.rangeOf(src, Span { file: Id<Source> { i: 1 }, lo: 4, hi: 10 });
    want(r.start.line == 1 && r.start.col == 1 && r.end.line == 3 && r.end.col == 3, "rangeOf", "");
    want(query.offsetAt(src, 0, 1) == 1 && query.offsetAt(src, 0, 99) == 10 && query.offsetAt(src, 2, 0) == 6 && query.offsetAt(src, 3, 2) == 9
        && query.offsetAt(src, 9, 0) == 10, "offsetAt", "");
    match query.formatFile("module m;\nfn main(){ let x=1; }\n", a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
}

// ---- the oracle: stage0 `j3c lsp` on the same buffer ----

/// One LSP request at a needle: `method` (hover / definition), `off` the byte offset.
struct Req {
    method: string;
    off: u32;
}

/// A JSON-RPC frame.
fn frame(t: &Text, body: string) { t.add("Content-Length: ").pushInt(body.len); t.add("\r\n\r\n").add(body); }

/// Line and byte column of `off` in `src`.
fn lineCol(src: string, off: u32, t: &Text) {
    let line = 0;
    let ls = 0;
    for i in 0..int(off) { if src[i] == '\n' { line += 1; ls = i + 1; } }
    t.add("{\"line\":").pushInt(line);
    t.add(",\"character\":").pushInt(int(off) - ls);
    t.add("}");
}

/// `s` as a JSON string, every non-ASCII char as `\\uXXXX` (surrogate pairs past U+FFFF): stage0's LSP reads
/// raw UTF-8 inside JSON strings byte by byte as chars (Rust `lsp/json.rs`; in the wave-26 LSPQ report), so
/// `'é'` would reach it as two chars.
fn quoteAscii(s: string, t: &Text) {
    t.add("\"");
    let i = 0;
    while i < s.len {
        let b = int(s[i]);
        if b == 34 || b == 92 { t.push(92); t.push(s[i]); i += 1; continue; }
        if b == 10 { t.add("\\n"); i += 1; continue; }
        if b == 13 { t.add("\\r"); i += 1; continue; }
        if b == 9 { t.add("\\t"); i += 1; continue; }
        if b < 32 { hex4(t, b); i += 1; continue; }
        if b < 128 { t.push(s[i]); i += 1; continue; }
        let n = 2;
        let cp = b & 31;
        if b >= 240 { n = 4; cp = b & 7; } else if b >= 224 { n = 3; cp = b & 15; }
        for k in 1..n { cp = (cp << 6) | (int(s[i + k]) & 63); }
        i += n;
        if cp >= 65536 {
            hex4(t, 55296 + ((cp - 65536) >> 10));
            hex4(t, 56320 + ((cp - 65536) & 1023));
        } else {
            hex4(t, cp);
        }
    }
    t.add("\"");
}

/// `\\u` and 4 hex digits of `v`.
fn hex4(t: &Text, v: int) {
    let digits = "0123456789abcdef";
    t.add("\\u");
    for k in 0..4 { t.push(digits[(v >> ((3 - k) * 4)) & 15]); }
}

/// stage0's replies to `reqs` on buffer `src` of `p` (absolute), by request order.
fn oracle(p: string, src: string, reqs: []Req, a: &Arena): List<&Json> {
    let uri = Text.new(a).add("file://").add(p).str();
    let t = Text.new(a);
    frame(&t, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}");
    let b = Text.new(a);
    b.add("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":");
    quoteAscii(uri, &b);
    b.add(",\"version\":1,\"languageId\":\"j3\",\"text\":");
    quoteAscii(src, &b);
    b.add("}}}");
    frame(&t, b.str());
    for i in 0..reqs.len {
        let r = Text.new(a);
        r.add("{\"jsonrpc\":\"2.0\",\"id\":").pushInt(i + 10);
        r.add(",\"method\":\"textDocument/").add(reqs[i].method).add("\",\"params\":{\"textDocument\":{\"uri\":");
        quoteAscii(uri, &r);
        r.add("},\"position\":");
        lineCol(src, reqs[i].off, &r);
        r.add("}}");
        frame(&t, r.str());
    }
    frame(&t, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}");
    frame(&t, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
    let out = List<&Json>.new(a);
    for i in 0..reqs.len { out.push(json.null(a)); }
    let o = match proc.run(["timeout", "120", "stage0/j3c", "lsp"], t.str(), a) { Result.Ok(o) { o } Result.Err(_) { panic("cannot run stage0/j3c lsp"); } };
    let s = o.outStr();
    let i = 0;
    while true {
        let h = find(s[i..], "\r\n\r\n");
        if h < 0 { break; }
        let start = i + h + 4;
        let n = 0;
        let k = i + 16;
        while k < s.len && s[k] >= '0' && s[k] <= '9' { n = n * 10 + int(s[k] - '0'); k += 1; }
        match json.parse(s[start..start + n] as []u8, a) {
            Result.Ok(j) {
                let id = j.get("id").asInt();
                if id >= 10 && id - 10 < reqs.len { out.items[id - 10] = j.get("result"); }
            }
            Result.Err(_) { panic("bad JSON from stage0"); }
        }
        i = start + n;
    }
    return out;
}

/// Hover text and range, and the definition span (same-file targets: stdlib paths differ by build) of each
/// request equal stage0's.
/// Hover text and range, and the definition span (same-file targets: stdlib paths differ by build) of each
/// request equal stage0's.
fn sameAsOracle(p: string, needles: []string, a: &Arena): bool {
    let ap = abs(p, a);
    let src = read(ap, a);
    let reqs = List<Req>.new(a);
    if needles.len == 0 {
        // Every identifier's first byte.
        let k = 0;
        while k < src.len {
            if isIdentStart(src[k]) && (k == 0 || !isIdentByte(src[k - 1])) {
                reqs.push(Req { method: "hover", off: u32(k) });
                reqs.push(Req { method: "definition", off: u32(k) });
            }
            k += 1;
        }
    }
    for i in 0..needles.len {
        let n = needles[i];
        let k = find(n, "|");
        let off = at(src, if k < 0 { n } else { n[0..k] }, a);
        if k >= 0 { off += u32(k); }
        reqs.push(Req { method: "hover", off: off });
        reqs.push(Req { method: "definition", off: off });
    }
    let want = oracle(ap, src, reqs.slice(), a);
    let s = session(ap, noOverlays(a));
    let ok = true;
    for i in 0..reqs.len {
        let r = reqs.items[i];
        let w = want.items[i];
        let got = Text.new(a);
        let exp = Text.new(a);
        if r.method == "hover" {
            match query.hover(s, ap, r.off, a) {
                Option.Some(h) {
                    let rg = query.rangeOf(src, h.span);
                    got.add(h.text).add(" @").pushInt(int(rg.start.line));
                    got.add(":").pushInt(int(rg.start.col));
                }
                Option.None { got.add("null"); }
            }
            if w.isNull() { exp.add("null"); } else {
                exp.add(w.path("contents.value").asStr()).add(" @").pushInt(w.path("range.start.line").asInt());
                exp.add(":").pushInt(w.path("range.start.character").asInt());
            }
        } else {
            let wantUri = w.get("uri").asStr();
            let same = !w.isNull() && wantUri == Text.new(a).add("file://").add(ap).str();
            if !same { continue; }
            match query.definition(s, ap, r.off, a) {
                Option.Some(d) {
                    let rg = query.rangeOf(src, d.span);
                    got.add(d.path).add(" @").pushInt(int(rg.start.line));
                    got.add(":").pushInt(int(rg.start.col));
                }
                Option.None { got.add("null"); }
            }
            exp.add(ap).add(" @").pushInt(w.path("range.start.line").asInt());
            exp.add(":").pushInt(w.path("range.start.character").asInt());
        }
        if got.str() != exp.str() {
            let m = Text.new(a);
            m.add("DIFF ").add(p).add(" ").add(r.method).add(" at ").pushInt(int(r.off));
            printLn(m.str());
            printLn("--- stage0");
            printLn(exp.str());
            printLn("--- ours");
            printLn(got.str());
            ok = false;
        }
    }
    s.free();
    return ok;
}

fn isIdentStart(b: u8): bool { return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_'; }
fn isIdentByte(b: u8): bool { return isIdentStart(b) || (b >= '0' && b <= '9'); }

fn main() {
    let a = Arena.create(1 << 16);
    scriptHoverAndGoto(&a);
    helloPrintLn(&a);
    overlayHovers(&a);
    dynAndChars(&a);
    positions(&a);
    // Needles: text to find, `|` marks the cursor inside it (else its start).
    let ok = true;
    let hello: [2]string = ["printLn", "main"];
    ok = sameAsOracle(load.helloPath(&a), hello[0..2], &a) && ok;
    let dyn: [6]string = ["out: |dyn Backend", "out: dyn |Backend", "pub trait |Backend", "|emit(", "fn |describe", "let |x"];
    ok = sameAsOracle("../speculative/lang/dyn.j3", dyn[0..6], &a) && ok;
    let chars: [2]string = ["let a = '|a'", "'|\\n'"];
    ok = sameAsOracle("../speculative/lang/chars.j3", chars[0..2], &a) && ok;
    let script: [3]string = ["const |Door", "scripts/|door.j3s", "|Door {"];
    ok = sameAsOracle("../speculative/11_script/main.j3", script[0..3], &a) && ok;
    if !ok { panic("hover/definition differ from stage0"); }
    a.destroy();
    printLn("lsp_query_test ok");
}
