// The tool table (`scene.tools`) generates what the Rust j3c sent: `mcpSchema` (one tool per line, compact
// JSON) equals `tests/unit/expect/tool_schema.json`, and `cliHelp` equals `tests/unit/expect/tool_schema_cli.txt`,
// byte for byte. Both were checked against the Rust compiler's `-e mcp` `tools/list` result (as a JSON tree)
// and `-e mcp --tools` before they were frozen (plan 15).
module tool_schema_test;

use j3.data.json;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;
use j3c.mcp.schema.{ cliHelp, mcpSchema };
use j3c.scene;
use unitkit;

fn main() {
    let arena = Arena.create(1 << 20);
    let tools = scene.tools(&arena);
    let ours = mcpSchema(tools, &arena).get("tools");
    let t = Text.new(&arena);
    for i in 0..ours.len() {
        json.write(ours.at(i), &t);
        t.add("\n");
    }
    let ok = unitkit.same(t.str(), "tool_schema.json");
    let help = Text.new(&arena);
    cliHelp(tools, &help);
    ok = unitkit.same(help.str(), "tool_schema_cli.txt") && ok;
    if !ok { panic("the tool table differs from tests/unit/expect/tool_schema*"); }
    printLn(`tool_schema ok: {tools.len} tools`);
}
