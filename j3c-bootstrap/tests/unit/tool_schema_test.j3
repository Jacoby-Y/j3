// The tool table (`scene.tools`) generates what the Rust j3c sends: `mcpSchema` equals stage0's `tools/list`
// result as a JSON tree (key order free), and `cliHelp` equals `stage0/j3c -e mcp --tools` byte for byte.
module tool_schema_test;

use j3.data.json;
use j3.data.json.{ Json, Kind };
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, lines };
use j3c.mcp.schema.{ cliHelp, mcpSchema };
use j3c.scene;

fn sub(path: string, key: string, arena: &Arena): string {
    let t = Text.new(arena);
    t.pushStr(path);
    t.pushStr("/");
    t.pushStr(key);
    return t.str();
}

fn kindName(k: Kind): string {
    return match k {
        Kind.Null { "null" }
        Kind.Bool { "bool" }
        Kind.Num { "number" }
        Kind.Str { "string" }
        Kind.Arr { "array" }
        Kind.Obj { "object" }
    };
}

/// Differences between `ours` and `rust` (objects compare by key set, arrays in order); the count.
fn diff(ours: &Json, rust: &Json, path: string, arena: &Arena): int {
    if ours.kind != rust.kind {
        printLn(`{path}: table has {kindName(ours.kind)}, rust has {kindName(rust.kind)}`);
        return 1;
    }
    let n = 0;
    match ours.kind {
        Kind.Null {}
        Kind.Bool { if ours.b != rust.b { printLn(`{path}: bool differs`); n += 1; } }
        Kind.Num { if ours.n != rust.n { printLn(`{path}: {ours.n} vs rust {rust.n}`); n += 1; } }
        Kind.Str {
            if ours.s != rust.s {
                printLn(`{path}: string differs`);
                printLn(ours.s);
                printLn(rust.s);
                n += 1;
            }
        }
        Kind.Arr {
            if ours.len() != rust.len() {
                printLn(`{path}: {ours.len()} elements, rust {rust.len()}`);
                n += 1;
            }
            let m = if ours.len() < rust.len() { ours.len() } else { rust.len() };
            for i in 0..m {
                let t = Text.new(arena);
                t.pushInt(i);
                n += diff(ours.at(i), rust.at(i), sub(path, t.str(), arena), arena);
            }
        }
        Kind.Obj {
            for i in 0..ours.keys.len {
                let k = ours.keys.items[i];
                if !rust.has(k) {
                    printLn(`{path}: key {k} only in the table`);
                    n += 1;
                } else {
                    n += diff(ours.items.items[i], rust.get(k), sub(path, k, arena), arena);
                }
            }
            for k in rust.keys.slice() {
                if !ours.has(k) { printLn(`{path}: key {k} missing from the table`); n += 1; }
            }
        }
    }
    return n;
}

fn main() {
    let arena = Arena.create(1 << 20);
    let tools = scene.tools(&arena);

    let req = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}\n";
    let got = match proc.run(["stage0/j3c", "-e", "mcp"], req, &arena) {
        Result.Ok(o) { o }
        Result.Err(_) { panic("cannot run stage0/j3c -e mcp") }
    };
    let reply = match json.parse(got.out, &arena) {
        Result.Ok(j) { j }
        Result.Err(e) { panic(`stage0 tools/list reply is not JSON: {e.msg}`) }
    };
    let rust = reply.get("result");
    let ours = mcpSchema(tools, &arena);
    if rust.get("tools").len() != tools.len { printLn(`{tools.len} tools in the table, rust has {rust.get("tools").len()}`); }
    for i in 0..rust.get("tools").len() {
        let name = rust.get("tools").at(i).get("name").asStr();
        if i >= tools.len || tools[i].name != name { panic(`tool {i} is {name} in rust`); }
    }
    let bad = diff(ours, rust, "", &arena);
    if bad > 0 { panic(`{bad} schema differences`); }

    let ref = match proc.run(["stage0/j3c", "-e", "mcp", "--tools"], "", &arena) {
        Result.Ok(o) { o }
        Result.Err(_) { panic("cannot run stage0/j3c -e mcp --tools") }
    };
    let help = Text.new(&arena);
    cliHelp(tools, &help);
    let want = ref.outStr();
    if help.str() != want {
        let a = List<string>.new(&arena);
        for l in lines(help.str()) { a.push(l); }
        let b = List<string>.new(&arena);
        for l in lines(want) { b.push(l); }
        for i in 0..a.len + 1 {
            let x = if i < a.len { a.items[i] } else { "<end>" };
            let y = if i < b.len { b.items[i] } else { "<end>" };
            if x != y {
                printLn(`--tools line {i + 1} differs (table, then rust):`);
                printLn(x);
                printLn(y);
                break;
            }
        }
        panic("cliHelp differs from stage0 -e mcp --tools");
    }
    printLn(`tool_schema ok: {tools.len} tools`);
}
