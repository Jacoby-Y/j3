// base/diag renderer against Rust's error goldens (j3c/src/compile/tests/diag): each `.err` here holds one
// diagnostic; its header, `-->` position, `^` run and note/help lines give the Diag, built by hand, and
// `render` must print the `.err` byte for byte.
module base_diag_golden_test;

use j3.data.pool.Pool;
use j3.io.{ printLn, readFile };
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, lines, parseInt, startsWith, lastIndexOf, find };
use j3c.base.diag.{ Diags, Note, NoteKind, Severity, render };
use j3c.base.span.{ Lines, Source, Span };

const DIR = "../j3c/src/compile/tests/diag/";

fn read(path: string, arena: &Arena): string {
    match readFile(path, arena) {
        Result.Ok(b) { return b as string; }
        Result.Err(e) { panic(`cannot read {path}`); }
    }
    return "";
}

fn num(s: string): int {
    match parseInt(s, 10) {
        Option.Some(n) { return n; }
        Option.None { panic(`not a number: {s}`); }
    }
    return 0;
}

fn check(name: string, arena: &Arena) {
    let t = Text.new(arena);
    let path = t.fmt(`{name}.j3`).str();
    let t2 = Text.new(arena);
    let src = read(t2.fmt(`{DIR}{name}.j3`).str(), arena);
    let t3 = Text.new(arena);
    let want = read(t3.fmt(`{DIR}{name}.err`).str(), arena);
    let sources = Pool<Source>.new(arena);
    let file = sources.add(Source { path: path, text: src, lines: Lines.of(src, arena) });
    let ds = Diags.new(arena);
    let sev = Severity.Error;
    let msg = "";
    let line = 0;
    let col = 0;
    let marks = 0;
    let d = ds.make(0, Severity.Error, Span { file: file, lo: 0, hi: 0 }, "");
    let ls = lines(want);
    for l in &ls {
        if startsWith(l, "error: ") { msg = l[7..l.len]; }
        else if startsWith(l, "warning: ") { msg = l[9..l.len]; sev = Severity.Warning; }
        else if startsWith(l, "  --> ") {
            let c = lastIndexOf(l, ":");
            col = num(l[c + 1..l.len]);
            let rest = l[0..c];
            let c2 = lastIndexOf(rest, ":");
            line = num(rest[c2 + 1..rest.len]);
        } else if startsWith(l, "   | ") && find(l, "^") >= 0 {
            marks = l.len - find(l, "^");
        } else if startsWith(l, "   = note: ") {
            d.notes.push(Note { kind: NoteKind.Note, span: d.span, msg: l[11..l.len] });
        } else if startsWith(l, "   = help: ") {
            d.notes.push(Note { kind: NoteKind.Help, span: d.span, msg: l[11..l.len] });
        }
    }
    let lo = sources.get(file).lines.starts.items[line - 1] + u32(col - 1);
    d.severity = sev;
    d.msg = msg;
    d.span = Span { file: file, lo: lo, hi: lo + u32(marks) };
    ds.add(d);
    let out = Text.new(arena);
    render(ds.at(0), &sources, &out);
    if out.str() != want {
        printLn(`--- {name}: got`);
        printLn(out.str());
        printLn(`--- want`);
        printLn(want);
        panic(`{name}: render differs from the Rust golden`);
    }
}

fn main() {
    let arena = Arena.create(1 << 20);
    let names: [6]string = ["arg_count", "float_arg", "missing_semi", "use_typo", "interp_struct", "let_mismatch"];
    for i in 0..6 { check(names[i], &arena); }
    printLn("base_diag_golden ok");
}
