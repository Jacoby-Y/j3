// Script AOT typing (`sema/script.j3`, `sema/script_body.j3`) and `@uiChoice` (`sema/ui_choice.j3`): small
// projects (a `main.j3` beside `scripts/door.j3s`) are written to a temp dir (outside this package, whose
// project would otherwise load) and run through the driver to `Stage.Sema`. The good one's tables are read back (the script struct, its props,
// the `shared` global, the alias); each bad one must fail with the Rust compiler's message, note and help
// (texts from its `check` on the same files). `tests/diff.sh err` copies one file per case, so cases that
// need a script beside them live here, not in `tests/bad/`.
module sema_script_test;

use j3.io;
use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.diag.{ NoteKind, Severity };
use j3c.driver;
use j3c.driver.{ Session, Stage };

const SCRIPT = "props { hinge: int; gain: f32 = 1.0; }\nshared { hits: int = 0; }\nlet open = false;\npub fn toggle() { open = !open; hits += 1; bump(); }\nfn smooth(): int { return 1; }\nfn bump() { hits += smooth(); }\n";
const HEAD = "module demo;\nconst Door = @script(\"scripts/door.j3s\");\nenum Tab { A, B }\n";

fn put(p: string, text: string) {
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case"); } }
}

fn caseDir(name: string, mem: &Arena): string {
    return Text.new(mem).add(io.tempRoot()).add("/j3c-boot-sema-script/").add(name).str();
}

/// `pre` + case `name`'s script path + `post`.
fn withPath(pre: string, name: string, post: string, mem: &Arena): string {
    return Text.new(mem).add(pre).add(caseDir(name, mem)).add("/scripts/door.j3s").add(post).str();
}

/// A session over case `name`: `script` as `scripts/door.j3s`, `HEAD` + `main` as `main.j3`.
fn session(name: string, script: string, main: string, mem: &Arena): &Session {
    let d = caseDir(name, mem);
    put(Text.new(mem).add(d).add("/scripts/door.j3s").str(), script);
    let entry = Text.new(mem).add(d).add("/main.j3").str();
    put(entry, Text.new(mem).add(HEAD).add(main).add("\n").str());
    let o = driver.defaults();
    o.entry = entry;
    return Session.new(o);
}

/// Sema on the case must fail; its first error is `msg` with note `note` and help `help` ("" = none).
fn bad(name: string, script: string, main: string, msg: string, note: string, help: string, mem: &Arena) {
    let s = session(name, script, main, mem);
    if driver.run(s, Stage.Sema) { panic(`{name}: sema should fail`); }
    let at = -1;
    for i in 0..s.diags.count() {
        match s.diags.at(i).severity { Severity.Error { if at < 0 { at = i; } } Severity.Warning {} }
    }
    if at < 0 { panic(`{name}: no error`); }
    let d = s.diags.at(at);
    if d.msg != msg { panic(`{name}: got "{d.msg}", want "{msg}"`); }
    let gotNote = "";
    let gotHelp = "";
    for i in 0..d.notes.len {
        match d.notes.items[i].kind {
            NoteKind.Note { gotNote = d.notes.items[i].msg; }
            NoteKind.Help { gotHelp = d.notes.items[i].msg; }
        }
    }
    if gotNote != note { panic(`{name}: note "{gotNote}", want "{note}"`); }
    if gotHelp != help { panic(`{name}: help "{gotHelp}", want "{help}"`); }
    s.free();
}

fn main() {
    let mem = Arena.create(1 << 14);

    // The script as a struct, its methods, a global and an alias.
    let s = session("ok", SCRIPT, "fn main() { let door = Door { hinge: 1 }; door.toggle(); let e = @script(\"scripts/door.j3s\") { hinge: 2, gain: 2.0 }; e.toggle(); let t = Tab.B; let on = @uiChoice(Tab, t, 1) || @uiChoice(Tab, 0, 0); }", &mem);
    if !driver.run(s, Stage.Sema) { panic("ok: sema fails"); }
    let c = match s.checked { Option.Some(x) { x } Option.None { panic("no checked program"); return; } };
    let found = false;
    let ss = &c.tables.structs;
    for i in 0..ss.len() {
        let sd = ss.get(ss.idAt(i));
        match sd.scriptPath {
            Option.Some(p) {
                found = true;
                if c.tables.str(sd.name) != "Door" { panic("ok: the script struct is `Door`"); }
                if p != withPath("", "ok", "", &mem) { panic(`ok: script path {p}`); }
                if sd.propSpans.len != 2 || sd.fields.len != 3 { panic("ok: two props, then one state field"); }
                if sd.methods.len != 3 || !sd.visPub { panic("ok: three methods on a pub struct"); }
            }
            Option.None {}
        }
    }
    if !found { panic("ok: no script struct"); }
    if c.scriptAliases.len != 1 || c.tables.str(c.scriptAliases.items[0].name) != "Door" { panic("ok: one alias `Door`"); }
    let hits = false;
    let gs = &c.tables.globals;
    for i in 0..gs.len() { if c.tables.str(gs.get(gs.idAt(i)).name) == "hits" { hits = true; } }
    if !hits { panic("ok: `shared` field `hits` is a global"); }
    s.free();

    // Literals of a script type.
    bad("missing", SCRIPT, "fn main() { let door = Door {}; }", "missing required prop `hinge`",
        withPath("prop declared at ", "missing", ":1", &mem), "add `hinge: ...` to the script literal", &mem);
    bad("litmissing", SCRIPT, "fn main() { let d = @script(\"scripts/door.j3s\") { gain: 1.0 }; }", "missing required prop `hinge`",
        withPath("prop declared at ", "litmissing", ":1", &mem), "add `hinge: ...` to the script literal", &mem);
    bad("state", SCRIPT, "fn main() { let door = Door { hinge: 1, open: true }; }", "`open` is script state, not a prop", "",
        "move it into `props` if callers should set it", &mem);
    bad("nofield", SCRIPT, "fn main() { let door = Door { hinge: 1, nope: 2 }; }", "`Door` has no field `nope`", "", "", &mem);
    bad("dup", SCRIPT, "fn main() { let door = Door { hinge: 1, hinge: 2 }; }", "duplicate field `hinge`", "", "", &mem);
    bad("value", SCRIPT, "fn main() { let d = @script(\"scripts/door.j3s\"); }", "a script type is not a value", "", "", &mem);
    bad("inscope", SCRIPT, "struct Door { x: int; }\nfn main() {}", "`Door` already in scope", "", "", &mem);
    // Private fields and fns, no copies.
    bad("private", SCRIPT, "fn main() { let door = Door { hinge: 1 }; let x = door.hinge; }", "script fields are private", "",
        "add a `pub fn` to expose this value", &mem);
    bad("privfn", SCRIPT, "fn main() { let door = Door { hinge: 1 }; door.smooth(); }",
        withPath("`smooth` is private to ", "privfn", "", &mem), "", "add `pub` to expose this function", &mem);
    bad("copy", SCRIPT, "fn take(d: Door) {}\nfn main() { let door = Door { hinge: 1 }; take(door); }", "script instances can't be copied", "",
        "pass `&Door` instead", &mem);
    bad("copy2", SCRIPT, "fn main() { let door = Door { hinge: 1 }; let e = door; }", "script instances can't be copied", "",
        "pass `&Door` instead", &mem);
    // Inside the script.
    let m = "fn main() { let door = Door { hinge: 1 }; door.toggle(); }";
    let ro = "props are read-only in the script; copy it into a `let`";
    bad("readonly", "props { hinge: int; }\npub fn toggle() { hinge = 2; }\n", m, "prop `hinge` is read-only in the script", "", ro, &mem);
    bad("readonly_op", "props { hinge: int; }\npub fn toggle() { this.hinge += 2; }\n", m, "prop `hinge` is read-only in the script", "", ro, &mem);
    bad("this", "props { hinge: int; }\npub fn toggle(this: int) { }\n", m, "`this` is reserved for the script instance", "", "", &mem);
    bad("twoprops", "props { hinge: int; }\nprops { b: int; }\npub fn toggle() { }\n", m, "a script has one `props` block", "", "", &mem);
    bad("twoshared", "props { hinge: int; }\nshared { a: int = 0; }\nshared { b: int = 0; }\npub fn toggle() { }\n", m,
        "a script has one `shared` block", "", "", &mem);
    bad("dupname", "props { hinge: int; }\nlet hinge = 1;\npub fn toggle() { }\n", m, "`hinge` already in script scope", "", "", &mem);
    bad("typename", "props { hinge: int; }\nstruct Door { x: int; }\npub fn toggle() { }\n", m, "`Door` is the script type; pick another name", "", "", &mem);
    let lit = "use a number, bool, or string literal";
    bad("literal", "props { hinge: int = 1 + 2; }\npub fn toggle() { }\n", m, "prop default must be a literal", "", lit, &mem);
    bad("stateinit", "props { hinge: int; }\nlet x = foo();\npub fn toggle() { }\n", m, "state initializer must be a literal", "", lit, &mem);
    bad("sharedinit", "props { hinge: int; }\nshared { n: int = foo(); }\npub fn toggle() { }\n", m, "shared initializer must be a literal", "", lit, &mem);
    // `@uiChoice`.
    bad("choice_set", SCRIPT, "fn main() { let a = @uiChoice(int, 1, 1); }", "`@uiChoice` needs a payloadless candidate-set enum", "", "", &mem);
    bad("choice_index", SCRIPT, "fn main() { let a = @uiChoice(Tab, 1, 2); }", "`@uiChoice` arm index must be a constant within the candidate set", "", "", &mem);
    bad("choice_sel", SCRIPT, "fn main() { let a = @uiChoice(Tab, \"s\", 1); }", "component selector must be `int` or `Tab`", "", "", &mem);
}
