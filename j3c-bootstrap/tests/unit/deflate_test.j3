// `base/deflate` (Rust `png.rs` test `deflate_round_trips`) plus the crc32 / adler32 check values.
module deflate_test;

use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.sys.panic;
use j3c.base.deflate;

fn main() {
    let a = Arena.create(1 << 24);
    let data = List<u8>.new(&a);
    for i in 0..70000 { data.push(u8((((i / 7) % 13) ^ ((i % 251) / 64)) & 255)); }
    for _k in 0..1000 { data.push(9); }
    data.extend("abcabcabcabd" as []u8);
    let d = data.items[0..data.len];
    let z = deflate.deflateFixed(d, &a);
    match deflate.inflate(z.items[0..z.len], d.len, &a) {
        Option.Some(back) {
            if back.len != d.len { panic("round trip: length differs"); }
            for i in 0..d.len { if back.items[i] != d[i] { panic("round trip: byte differs"); } }
        }
        Option.None { panic("round trip: inflate failed"); }
    }
    match deflate.inflate(z.items[0..z.len], d.len - 1, &a) {
        Option.Some(_) { panic("inflate ignored its cap"); }
        Option.None {}
    }
    if z.len >= d.len / 2 { panic("deflate does not compress"); }
    // a truncated stream is None, not a crash
    match deflate.inflate(z.items[0..z.len / 2], d.len, &a) {
        Option.Some(_) { panic("a truncated stream inflated"); }
        Option.None {}
    }
    if deflate.crcEnd(deflate.crcUpdate(0xffffffff, "123456789" as []u8)) != 0xCBF43926 { panic("crc32"); }
    if deflate.crcEnd(deflate.crcUpdate(deflate.crcUpdate(0xffffffff, "1234" as []u8), "56789" as []u8)) != 0xCBF43926 { panic("crc32 in parts"); }
    if deflate.adler32("Wikipedia" as []u8) != 0x11E60398 { panic("adler32"); }
    a.destroy();
}
