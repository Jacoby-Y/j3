// Smoke test of the C1 contracts (`.swarm-opus/11-port/contracts.md`): build a small AST by hand and read it
// back, the keyword table, the parser cursor over hand-made tokens, `parseInt`, `splitInterp` without holes.
module syntax_ast_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.List;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.base.span.{ Source, Span };
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ Ast, BinOp, BinaryExpr, Block, Expr, ExprStmt, Ident, InterpPart, Pat, Stmt, Type, NamedType, irrefutable };
use j3c.syntax.parse.{ Parser, parseInt, splitInterp };
use j3c.syntax.token.{ NameList, Token, TokenKind, isIn, joinNames, keyword, keywordNames, kindOf, names, wordsOf };

fn main() {
    let s = Session.new(driver.defaults());
    let src = "a + 1";
    let file = s.sources.add(Source.of("t.j3", src, s.arena));
    let ast = Ast.new(s.arena, &s.names);

    // `a + 1` as one expression statement in a block
    let a = ast.addExpr(Expr.Name(Ident { name: ast.sym("a"), span: Span { file: file, lo: 0, hi: 1 } }), Span { file: file, lo: 0, hi: 1 });
    let one = ast.addExpr(Expr.Int(1), Span { file: file, lo: 4, hi: 5 });
    let sum = ast.addExpr(Expr.Binary(BinaryExpr { op: BinOp.Add, lhs: a, rhs: one }), Span { file: file, lo: 0, hi: 5 });
    let st = ast.addStmt(Stmt.Expr(ExprStmt { expr: sum }), Span { file: file, lo: 0, hi: 5 });
    let b = Block { span: Span { file: file, lo: 0, hi: 5 }, stmts: List<Id<Stmt>>.new(s.arena) };
    b.stmts.push(st);
    match ast.stmt(b.stmts.items[0]) {
        Stmt.Expr(es) {
            match ast.expr(es.expr) {
                Expr.Binary(bin) {
                    if bin.op != BinOp.Add { panic("op lost"); }
                    match ast.expr(bin.lhs) {
                        Expr.Name(id) { if ast.str(id.name) != "a" { panic("name lost"); } }
                        _ { panic("lhs is not a name"); }
                    }
                    match ast.expr(bin.rhs) { Expr.Int(v) { if v != 1 { panic("int lost"); } } _ { panic("rhs is not an int"); } }
                }
                _ { panic("not a binary"); }
            }
            if ast.exprSpan(es.expr).hi != 5 { panic("expr span lost"); }
        }
        _ { panic("not an expr stmt"); }
    }
    if ast.stmtSpan(st).lo != 0 || ast.exprSpan(one).lo != 4 { panic("side spans wrong"); }
    let t = ast.addType(Type.Named(NamedType { name: ast.sym("int") }), Span { file: file, lo: 0, hi: 3 });
    match ast.ty(t) { Type.Named(n) { if ast.str(n.name) != "int" { panic("type name lost"); } } _ { panic("not named"); } }
    let w = ast.addPat(Pat.Wild, Span { file: file, lo: 0, hi: 1 });
    if !irrefutable(&ast, w) { panic("_ is refutable"); }

    // keywords: every listed keyword lexes to a kind; literals and plain names do not
    let kw = keywordNames(s.arena);
    if kw.len != 22 { panic("keywords.txt keyword count changed"); }
    for i in 0..kw.len {
        match kindOf(kw[i]) { Option.Some(_) {} Option.None { panic("keyword without a TokenKind"); } }
    }
    let tys = wordsOf("type", s.arena);
    for i in 0..tys.len { match kindOf(tys[i]) { Option.Some(_) { panic("a type word has a TokenKind"); } Option.None {} } }
    match keyword("true") { Option.Some(_) { panic("true is a keyword"); } Option.None {} }
    match keyword("fn") { Option.Some(k) { if k != TokenKind.Fn { panic("fn kind"); } } Option.None { panic("fn not a keyword"); } }
    if !isIn("mix", names(NameList.IntrinsicGpu)) || isIn("nope", names(NameList.Derives)) { panic("name lists"); }
    if joinNames(NameList.Derives, ", ", s.arena) != "Eq, Hash, Ord, Debug, Clone" { panic("joinNames"); }

    // cursor over `x ;` + Eof
    let toks = List<Token>.new(s.arena);
    toks.push(Token { kind: TokenKind.Ident, span: Span { file: file, lo: 0, hi: 1 }, text: "x" });
    toks.push(Token { kind: TokenKind.Semi, span: Span { file: file, lo: 2, hi: 3 }, text: ";" });
    toks.push(Token { kind: TokenKind.Eof, span: Span { file: file, lo: 3, hi: 3 }, text: "" });
    let p = Parser.new(toks, &ast);
    match p.ident() { Result.Ok(id) { if ast.str(id.name) != "x" { panic("ident"); } } Result.Err(e) { panic(e.msg); } }
    match p.expect(TokenKind.Comma, "expected `,`") { Result.Ok(_) { panic("expect took the wrong token"); } Result.Err(e) { if e.msg != "expected `,`" { panic("expect msg"); } } }
    if !p.eat(TokenKind.Semi) || !p.at(TokenKind.Eof) { panic("eat"); }
    p.bump();
    if p.i != 2 || p.look(5).kind != TokenKind.Eof { panic("bump past Eof"); }
    // a missing `;` points just past the previous token
    match p.expect(TokenKind.Semi, "expected `;`") { Result.Ok(_) { panic("semi"); } Result.Err(e) { if e.span.lo != 3 || e.span.hi != 4 { panic("semi span"); } } }

    // int literals
    match parseInt("0xFFFFFFFFFFFFFFFF", s.arena) { Result.Ok(Expr.BigInt(v)) {} _ { panic("bigint"); } }
    match parseInt("0b101", s.arena) { Result.Ok(Expr.Int(v)) { if v != 5 { panic("bin"); } } _ { panic("bin lit"); } }
    match parseInt("99999999999999999999", s.arena) { Result.Err(m) { if m != "integer `99999999999999999999` does not fit 64 bits" { panic(m); } } _ { panic("overflow"); } }

    // interpolation without holes is one literal part
    match splitInterp(&ast, "plain", Span { file: file, lo: 0, hi: 7 }) {
        Result.Ok(parts) {
            if parts.len != 1 { panic("interp parts"); }
            match parts.items[0] { InterpPart.Lit(l) { if l != "plain" { panic("interp lit"); } } _ { panic("interp kind"); } }
        }
        Result.Err(e) { panic(e.msg); }
    }
    s.free();
    printLn("syntax ast ok");
}
