// Fixture of lower_dyn_scope_test: `Shape` is a different trait in main, a, b and c; main writes
// `dyn Shape`, b writes `dyn Zed`. `Unused` is a payload enum nothing names.
module main;
use j3.io.printLn;
use a;
use b;
use c;

pub trait Shape { fn area(this: &Self): int; }
struct Sq { s: int; fn area(this: &Sq): int { return this.s * this.s; } }
enum Unused { A, B(int) }

fn main() {
    let q = Sq { s: 3 };
    let d: dyn Shape = &q;
    printLn(`{d.area()} {a.one()} {b.two()} {c.three()}`);
}
