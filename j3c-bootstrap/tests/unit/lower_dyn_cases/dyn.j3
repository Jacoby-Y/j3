// Fixture of lower_dyn_test: conversions, calls, a default body, a by-value method, an `#[impl]` fn, a
// generic struct, a two-level supertrait chain with upcasts (from a value and from a `&`).
module lowerdyn;

use j3.io.printLn;

pub trait Named { fn name(this: &Self): string; }
pub trait Backend: Named {
    fn emit(this: &Self, n: int): int;
    fn lines(this: &Self): int { return this.emit(1) + 100; }
    fn reset(this: &Self) { }
}
pub trait Low: Backend { fn low(this: &Self): int; }

struct Llvm {
    calls: int;
    fn name(this: &Llvm): string { return "llvm"; }
    fn emit(this: &Llvm, n: int): int { this.calls += 1; return n * 2; }
    fn low(this: Llvm): int { return this.calls; }
}

struct C {
    base: int;
    fn emit(this: &C, n: int): int { return this.base + n; }
    fn lines(this: &C): int { return 7; }
}

#[impl]
fn name(x: &C): string { return "c"; }

struct Box<T> {
    v: T;
    fn name(this: &Box<T>): string { return "box"; }
}

struct Pass {
    out: dyn Backend;
    fn run(this: &Pass): int { return this.out.emit(10); }
}

fn pick(a: dyn Backend, b: dyn Backend, first: bool): dyn Backend {
    if first { return a; }
    return b;
}

fn main() {
    let l = Llvm { calls: 0 };
    let c = C { base: 5 };
    let bx = Box<int> { v: 1 };
    let b: dyn Backend = &l;
    let d: dyn Backend = &c;
    let n: dyn Named = &bx;
    let lo: dyn Low = &l;
    let up: dyn Named = b;
    let mid: dyn Backend = lo;
    let top: dyn Named = lo;
    let r = &lo;
    let viaRef: dyn Named = r;
    let p = pick(b, d, false);
    b.reset();
    printLn(`{b.name()} {b.emit(3)} {b.lines()} {d.lines()} {n.name()} {lo.low()} {up.name()} {mid.emit(2)}`);
    printLn(`{top.name()} {viaRef.name()} {p.name()} {r.lines()}`);
}
