// `build`: one output per `[emit] target` entry under target/<triple>/, a second single-target build is
// "up to date" (rc 0), `compilation.log` only when tracking is on, `[dist]` packaging: only under `--release`,
// after a fresh build and after an up-to-date one, per target of a multi-target build.
module cmd_build_test;

use j3.io;
use j3.memory.Arena;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, contains };
use j3c.base.fsx;
use j3c.cmd.build.buildCmd;

fn put(p: string, s: string) {
    match io.writeFile(p, s as []u8) { Result.Ok(_) {} Result.Err(_) { panic(p); } }
}

fn project(dir: string, toml: string, mem: &Arena) {
    io.makeDirs(Text.new(mem).add(dir).add("/src").str());
    put(Text.new(mem).add(dir).add("/j3.toml").str(), toml);
    put(Text.new(mem).add(dir).add("/src/main.j3").str(), "module app;\nfn main(): int { return 0; }\n");
}

fn main() {
    let mem = Arena.create(1 << 14);
    defer mem.destroy();
    // scratch projects under the repo-root target/ (cwd is j3c-bootstrap/), removed at the end
    let t = Text.new(&mem);
    t.add("../target/unit-build-");
    t.pushInt(sys.getpid());
    let base = t.str();
    let rm: [3]string = ["rm", "-rf", base];
    proc.run(rm[..], "", &mem);

    // two host triples, tracking on
    sys.setenv("J3C_COMPILATION_TRACKING", "1");
    let multi = Text.new(&mem).add(base).add("/multi").str();
    project(multi, "[package]\nname = \"app\"\nentry = \"src/main.j3\"\n\n[emit]\ntarget = [\"x86_64-unknown-linux-gnu\", \"x86_64-pc-linux-gnu\"]\n", &mem);
    let a1: [1]string = [multi];
    if buildCmd(a1[..]) != 0 { panic("multi-target build failed"); }
    if !fsx.isFile(Text.new(&mem).add(multi).add("/target/x86_64-unknown-linux-gnu/app").str()) { panic("no first target output"); }
    if !fsx.isFile(Text.new(&mem).add(multi).add("/target/x86_64-pc-linux-gnu/app").str()) { panic("no second target output"); }
    let log = match fsx.readText(Text.new(&mem).add(multi).add("/target/compilation.log").str(), &mem) {
        Result.Ok(x) { x }
        Result.Err(_) { panic("no compilation.log with tracking on"); }
    };
    if !contains(log, "COMPILE: ") || !contains(log, "    backend=llvm opt=") || !contains(log, "    target: x86_64-unknown-linux-gnu\n") { panic(log); }
    if !contains(log, "      target x86_64-pc-linux-gnu\n") || !contains(log, "    result: ok\n") { panic(log); }

    // one target, tracking off: built, then up to date; no log
    sys.setenv("J3C_COMPILATION_TRACKING", "0");
    let one = Text.new(&mem).add(base).add("/one").str();
    project(one, "[package]\nname = \"app\"\nentry = \"src/main.j3\"\n", &mem);
    let a2: [1]string = [one];
    if buildCmd(a2[..]) != 0 { panic("build failed"); }
    let exe = Text.new(&mem).add(one).add("/target/app").str();
    if !fsx.isFile(exe) { panic("no output"); }
    if !fsx.isFile(Text.new(&mem).add(one).add("/target/.j3c/host/app/inputs.build.key").str()) { panic("no inputs.build.key"); }
    if buildCmd(a2[..]) != 0 { panic("second build failed"); }
    if fsx.isFile(Text.new(&mem).add(one).add("/target/compilation.log").str()) { panic("compilation.log with tracking off"); }
    // a failed build is rc 1 and leaves the stamps alone
    put(Text.new(&mem).add(one).add("/src/main.j3").str(), "module app;\nfn main(): int { return nope; }\n");
    if buildCmd(a2[..]) != 1 { panic("a broken source built"); }

    // [dist]: a dev build packages nothing; --release zips (again when up to date, a fresh zip each time)
    let dist = Text.new(&mem).add(base).add("/dist").str();
    project(dist, "[package]\nname = \"app\"\nentry = \"src/main.j3\"\n\n[dist]\nbuild_outputs = [\"zip\"]\n", &mem);
    let zip = Text.new(&mem).add(dist).add("/target/dist/app-linux-x86_64.zip").str();
    let a3: [1]string = [dist];
    if buildCmd(a3[..]) != 0 { panic("dev build with [dist] failed"); }
    if fsx.isFile(zip) { panic("a dev build packaged"); }
    let a4: [2]string = ["--release", dist];
    if buildCmd(a4[..]) != 0 || !fsx.isFile(zip) { panic("release build did not zip"); }
    io.remove(zip);
    if buildCmd(a4[..]) != 0 || !fsx.isFile(zip) { panic("up-to-date release build did not zip"); }
    if fsx.isDir(Text.new(&mem).add(dist).add("/target/.j3c/dist").str()) { panic("stage folder left behind"); }
    // two targets: both are built, then packaging runs once over them; a missing include fails it (rc 1)
    let md = Text.new(&mem).add(base).add("/multidist").str();
    project(md, "[package]\nname = \"app\"\nentry = \"src/main.j3\"\n\n[emit]\ntarget = [\"x86_64-unknown-linux-gnu\", \"x86_64-pc-linux-gnu\"]\n\n[dist]\nbuild_outputs = [\"zip\"]\ninclude = [\"nope\"]\n", &mem);
    let a5: [2]string = ["--release", md];
    if buildCmd(a5[..]) != 1 { panic("missing include did not fail"); }
    if !fsx.isFile(Text.new(&mem).add(md).add("/target/x86_64-pc-linux-gnu/app").str()) { panic("multi-target dist did not build"); }
    proc.run(rm[..], "", &mem);
}
