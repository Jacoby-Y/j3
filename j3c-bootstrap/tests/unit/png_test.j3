// `assets/png` (Rust `png.rs` tests): encode round trip, the `png_check` fixtures, a short IHDR, a stored
// canvas-style PNG through `compact`, base64 RFC 4648 vectors. Run with cwd = j3c-bootstrap/.
module png_test;

use j3.io;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.assets.png;
use j3c.assets.png.Image;
use j3c.base.deflate;

const FIX: string = "../j3c/tests/programs/png_check/";

fn read(name: string, a: &Arena): []u8 {
    match io.readFile(`{FIX}{name}`, a) {
        Result.Ok(b) { return b; }
        Result.Err(_) { panic(`cannot read {name}`); }
    }
    return "" as []u8;
}

fn same(got: Option<Image>, w: int, h: int, px: []u8, what: string) {
    match got {
        Option.Some(im) {
            if im.w != w || im.h != h || im.px.len != px.len {
                printLn(`{what}: {im.w}x{im.h} ({im.px.len} bytes), want {w}x{h} ({px.len})`);
                panic("decode size differs");
            }
            for i in 0..px.len { if im.px.items[i] != px[i] { printLn(`{what}: byte {i}`); panic("decode differs"); } }
        }
        Option.None { printLn(what); panic("decode failed"); }
    }
}

fn be(out: &List<u8>, v: int) {
    out.push(u8((v >> 24) & 255)); out.push(u8((v >> 16) & 255)); out.push(u8((v >> 8) & 255)); out.push(u8(v & 255));
}

fn chunk(out: &List<u8>, kind: string, data: []u8) {
    be(out, data.len);
    out.extend(kind as []u8);
    out.extend(data);
    be(out, deflate.crcEnd(deflate.crcUpdate(deflate.crcUpdate(0xffffffff, kind as []u8), data)));
}

fn main() {
    let a = Arena.create(1 << 24);
    // encode_rgba_round_trips
    let px = List<u8>.new(&a);
    for i in 0..5 * 3 * 4 { px.push(u8((i * 37) % 256)); }
    let enc = png.encodeRgba(5, 3, px.items[0..px.len], &a);
    if enc.items[0] != 137 || enc.items[1] != 'P' { panic("no PNG signature"); }
    same(png.decode(enc.items[0..enc.len], &a), 5, 3, px.items[0..px.len], "encode round trip");
    // decode_matches_fixtures
    let names: [5]string = ["rgb", "pal", "tiles", "filt", "dist32"];
    let ws: [5]int = [37, 19, 64, 9, 1];
    let hs: [5]int = [23, 17, 16, 10, 1];
    for k in 0..5 {
        same(png.decode(read(`{names[k]}.png`, &a), &a), ws[k], hs[k], read(`{names[k]}.rgba`, &a), names[k]);
    }
    // an IHDR claiming fewer rows than the data holds: inflate stops at the cap
    let short = read("rgb.png", &a);
    let s2 = List<u8>.new(&a);
    s2.extend(short);
    s2.items[20] = 0; s2.items[21] = 0; s2.items[22] = 0; s2.items[23] = 1;
    match png.decode(s2.items[0..s2.len], &a) { Option.Some(_) { panic("short IHDR decoded"); } Option.None {} }
    // a stored RGBA PNG like canvas writes, then compacted
    let p6 = List<u8>.new(&a);
    for i in 0..3 * 2 * 4 { p6.push(u8((i * 37) % 256)); }
    let raw = List<u8>.new(&a);
    for r in 0..2 { raw.push(0); raw.extend(p6.items[r * 12..r * 12 + 12]); }
    let z = List<u8>.new(&a);
    z.push(0x78); z.push(0x01); z.push(1);
    z.push(u8(raw.len & 255)); z.push(u8(raw.len >> 8));
    z.push(u8((raw.len & 255) ^ 255)); z.push(u8((raw.len >> 8) ^ 255));
    z.extend(raw.items[0..raw.len]);
    be(&z, deflate.adler32(raw.items[0..raw.len]));
    let p = List<u8>.new(&a);
    let sig: [8]u8 = [137, 80, 78, 71, 13, 10, 26, 10];
    p.extend(sig[..]);
    let ih: [13]u8 = [0, 0, 0, 3, 0, 0, 0, 2, 8, 6, 0, 0, 0];
    chunk(&p, "IHDR", ih[..]);
    chunk(&p, "IDAT", z.items[0..z.len]);
    chunk(&p, "IEND", ih[0..0]);
    same(png.decode(p.items[0..p.len], &a), 3, 2, p6.items[0..p6.len], "stored");
    match png.compact(p.items[0..p.len], &a) {
        Option.Some(c) { same(png.decode(c.items[0..c.len], &a), 3, 2, p6.items[0..p6.len], "compacted"); }
        Option.None { panic("compact failed"); }
    }
    // base64_matches_rfc
    if png.base64("foobar" as []u8, &a) != "Zm9vYmFy" { panic("base64 foobar"); }
    if png.base64("fooba" as []u8, &a) != "Zm9vYmE=" { panic("base64 fooba"); }
    if png.base64("f" as []u8, &a) != "Zg==" { panic("base64 f"); }
    if png.base64("" as []u8, &a) != "" { panic("base64 empty"); }
    a.destroy();
}
