// LSP completion, signature help and outline (`lsp/complete.j3` and its parts): Rust's
// `lsp/complete/tests.rs` (the non-`.j3ui`, non-scanner ones) and the completion halves of `query/tests.rs`.
// Skipped, printing why, while `isIdentName` is still the LSPU stub (wave 27 fills the scanners).
module lsp_complete_test;

use j3.io;
use j3.io.printLn;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, find, startsWith };
use j3c.driver.Session;
use j3c.load;
use j3c.load.Overlay;
use j3c.lsp.complete;
use j3c.lsp.complete.{ Completion, Signature };
use j3c.lsp.query;

fn read(p: string, a: &Arena): string {
    match io.readFile(p, a) { Result.Ok(b) { return b as string; } Result.Err(_) { panic(Text.new(a).add("cannot read ").add(p).str()); } }
    return "";
}

fn abs(p: string, a: &Arena): string {
    match path.realpath(p, a) { Option.Some(x) { return x; } Option.None { panic(Text.new(a).add("no such file: ").add(p).str()); } }
    return p;
}

fn at(src: string, needle: string, a: &Arena): u32 {
    let i = find(src, needle);
    if i < 0 { panic(Text.new(a).add("needle not found: ").add(needle).str()); }
    return u32(i);
}

fn session(p: string, overlays: []Overlay): &Session {
    match query.analyze(p, overlays) { Result.Ok(s) { return s; } Result.Err(e) { panic(Text.scratch().add(p).add(": ").add(e).str()); } }
}

fn has(items: &List<Completion>, label: string): bool {
    for i in 0..items.len { if items.items[i].label == label { return true; } }
    return false;
}

fn labels(items: &List<Completion>, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..items.len { t.add(items.items[i].label).add(" "); }
    return t.str();
}

fn want(ok: bool, what: string, got: string) {
    if !ok { printLn(what); printLn(got); panic("check failed"); }
}

fn none(a: &Arena): []Overlay { return List<Overlay>.new(a).slice(); }

/// Rust `bare_completion_is_in_scope` and the completion half of `hover_print_ln_on_hello`.
fn bareInScope(a: &Arena) {
    let p = abs(load.helloPath(a), a);
    let src = read(p, a);
    let s = session(p, none(a));
    let off = at(src, "printLn(\"", a);
    let items = complete.completeAt(s, p, src, off + 2, a);
    want(has(&items, "printLn") && !has(&items, "exit") && !has(&items, "readFile"), "bare pr", labels(&items, a));
    items = complete.completeAt(s, p, src, off, a);
    want(has(&items, "let") && has(&items, "printLn") && !has(&items, "exit"), "bare", labels(&items, a));
    s.free();
}

/// Rust `signature_of_print_ln` and `outline_lists_main`.
fn helloSignatureOutline(a: &Arena) {
    let p = abs(load.helloPath(a), a);
    let src = read(p, a);
    let s = session(p, none(a));
    let off = at(src, "printLn(\"", a) + 8;
    match complete.signature(s, p, src, off, a) {
        Option.Some(sig) {
            let s0 = sig.signatures.items[0];
            want(contains(s0.label, "string") && s0.params.len == 1 && contains(s0.params.items[0], "s") && sig.active == 0, "sig", s0.label);
        }
        Option.None { panic("no signature for printLn"); }
    }
    let syms = complete.symbols(s, p, a);
    let found = false;
    for i in 0..syms.len { if syms.items[i].name == "main" && syms.items[i].kind == 12 { found = true; } }
    want(found, "outline main", "");
    s.free();
}

/// Rust `signature_of_method_skips_this`.
fn methodSkipsThis(a: &Arena) {
    let p = abs("../j3c/tests/programs/mesh.j3", a);
    let src = read(p, a);
    let s = session(p, none(a));
    let off = at(src, "q.rotate(", a) + 9;
    let ok = false;
    match complete.signature(s, p, src, off, a) {
        Option.Some(sig) {
            for i in 0..sig.signatures.len {
                let g = sig.signatures.items[i];
                let noThis = true;
                for k in 0..g.params.len { if startsWith(g.params.items[k], "this:") { noThis = false; } }
                if contains(g.label, "Vec3") && noThis { ok = true; }
            }
        }
        Option.None {}
    }
    want(ok, "q.rotate signature", "");
    s.free();
}

/// Rust `module_dot_lists_exported_type`.
fn moduleDot(a: &Arena) {
    let p = abs(load.helloPath(a), a);
    let src = "module hello;\n\nuse j3.math;\nuse j3.io.printLn;\n\nfn main() {\n    math.sqrt(f32(4));\n    printLn(\"ok\");\n}\n";
    let ov = List<Overlay>.new(a);
    ov.push(Overlay { path: p, text: src });
    let s = session(p, ov.slice());
    let items = complete.completeAt(s, p, src, at(src, "math.sqrt", a) + 5, a);
    want(has(&items, "sqrt") && has(&items, "Quat") && has(&items, "Vec2"), "math.", labels(&items, a));
    s.free();
}

/// Rust `incomplete_app_dot_lists_methods`: the heal path.
fn incompleteAppDot(a: &Arena) {
    let p = abs("../examples/3d-editor-scene/src/main.j3", a);
    let disk = read(p, a);
    let r = at(disk, "    app.run();\n", a);
    let src = Text.new(a).add(disk[0..int(r)]).add("    app.\n").add(disk[int(r)..]).str();
    let ov = List<Overlay>.new(a);
    ov.push(Overlay { path: p, text: src });
    let items = complete.completeBuffer(p, ov.slice(), src, r + 8, a);
    want(has(&items, "useGl") && has(&items, "run") && has(&items, "startup") && !has(&items, "App"), "app.", labels(&items, a));
}

/// Rust `tuple_members_and_derive_attribute_complete` (the file under WT-root `target/c1/`).
fn tupleAndDerive(a: &Arena) {
    let p = Text.new(a).add(abs("..", a)).add("/target/c1/tuple_main.j3").str();
    let src = "module main;\n#[derive(Eq)]\nstruct K { a: int; }\nfn main() {\n    let t = (1, \"x\");\n    let n = t.0;\n}\n";
    match io.writeFile(p, src as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write tuple_main.j3"); } }
    let items = complete.completeBuffer(p, none(a), src, at(src, "t.0", a) + 2, a);
    want(has(&items, "0") && has(&items, "1"), "t.", labels(&items, a));
    items = complete.completeBuffer(p, none(a), src, at(src, "derive", a) + 3, a);
    want(has(&items, "derive"), "#[der", labels(&items, a));
}

fn main() {
    if !complete.isIdentName("a") {
        printLn("lsp_complete_test skipped: the LSPU scanners are stubs");
        return;
    }
    let arena = Arena.create(1 << 20);
    let a = &arena;
    bareInScope(a);
    helloSignatureOutline(a);
    methodSkipsThis(a);
    moduleDot(a);
    incompleteAppDot(a);
    tupleAndDerive(a);
    printLn("lsp_complete_test ok");
}
