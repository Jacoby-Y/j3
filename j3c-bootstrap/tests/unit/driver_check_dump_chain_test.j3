// `dumpAst` on a left-deep binary chain of 20000 terms (generated code has them; the recursive dump
// overflowed the stack near 3000). Parsed here, dumped, and compared byte for byte with
// `stage0/j3c dump-ast` on the same file.
module driver_check_dump_chain_test;

use j3.io;
use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.intern.own;
use j3c.base.span.Source;
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.Ast;
use j3c.syntax.dump.dumpAst;
use j3c.syntax.parse;

const PATH = "target/unit/driver_check_dump_chain/chain.j3";
const TERMS = 20000;

fn main() {
    let s = Session.new(driver.defaults());
    defer s.free();
    // `x0 + x1 - x2 * 3 + ...`: a `+`/`-` spine with a `*` group every third term.
    let src = Text.new(s.arena);
    src.add("module chain;\nfn f(): int {\n    return x0");
    for i in 1..TERMS {
        if i % 2 == 0 { src.add(" - x"); } else { src.add(" + x"); }
        src.pushInt(i);
        if i % 3 == 0 { src.add(" * 3"); }
    }
    src.add(";\n}\n");
    let text = src.str();
    match io.writeFile(PATH, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the chain file"); } }

    let ast = Ast.new(s.arena, &s.names);
    let id = s.sources.add(Source.of(own(s.arena, PATH), text, s.arena));
    let ours = Text.new(s.arena);
    match parse.parseFile(text, id, &ast) {
        Result.Ok(f) { dumpAst(&ast, &f, &ours); }
        Result.Err(_) { panic("the chain does not parse"); }
    }
    match proc.run(["stage0/j3c", "dump-ast", PATH], "", s.arena) {
        Result.Ok(o) {
            if o.code != 0 { printLn(o.errStr()); panic("stage0 dump-ast failed"); }
            if o.outStr() != ours.str() { panic("dump of the 20000-term chain differs from stage0"); }
        }
        Result.Err(_) { panic("cannot run stage0/j3c"); }
    }
    printLn("dump chain ok: 20000 terms");
}
