// `syntax/extend.merge` on hand-built items: methods move into their struct (file order kept, `extend`
// items dropped), and each Rust error (enum, other module, no struct, type parameters, duplicate method)
// with Rust's message and help text.
module syntax_extend_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.text.split;
use j3.memory.List;
use j3.option.Option;
use j3.sys.panic;
use j3c.base.intern.Sym;
use j3c.base.span.{ Lines, Source, Span };
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ Ast, Block, EnumItem, ExtendItem, FnItem, GpuStruct, Ident, Item, StructItem, VariantItem, WhereBound, Param, FieldItem, Stmt };
use j3c.syntax.extend.{ ExtendErr, merge };

struct B {
    ast: &Ast;
    sp: Span;

    fn ident(this: &B, s: string, lo: int): Ident { return Ident { name: this.ast.sym(s), span: Span { file: this.sp.file, lo: u32(lo), hi: u32(lo + s.len) } }; }
    /// `"K,V"` as idents; "" is none.
    fn idents(this: &B, xs: string): List<Ident> {
        let l = List<Ident>.new(this.ast.arena);
        if xs.len == 0 { return l; }
        for x in split(xs, ",") { l.push(this.ident(x, 0)); }
        return l;
    }
    fn method(this: &B, name: string, lo: int): FnItem {
        return FnItem { span: this.sp, doc: "", visPub: false, name: this.ident(name, lo), typeParams: List<Ident>.new(this.ast.arena),
            bounds: List<List<Ident>>.new(this.ast.arena), whereBounds: List<WhereBound>.new(this.ast.arena), derived: false, isImpl: false,
            shader: Option.None, params: List<Param>.new(this.ast.arena), ret: Option.None,
            body: Block { span: this.sp, stmts: List<Id<Stmt>>.new(this.ast.arena) } };
    }
    fn methods(this: &B, xs: string, lo: int): List<FnItem> {
        let l = List<FnItem>.new(this.ast.arena);
        if xs.len == 0 { return l; }
        for x in split(xs, ",") { l.push(this.method(x, lo)); }
        return l;
    }
    fn strukt(this: &B, name: string, params: string, ms: string): Item {
        return Item.Struct(StructItem { span: this.sp, doc: "", visPub: false, debug: false, packed: false, gpu: GpuStruct.None,
            derives: List<Ident>.new(this.ast.arena), name: this.ident(name, 0), typeParams: this.idents(params),
            bounds: List<List<Ident>>.new(this.ast.arena), fields: List<FieldItem>.new(this.ast.arena), methods: this.methods(ms, 0) });
    }
    fn enm(this: &B, name: string): Item {
        return Item.Enum(EnumItem { span: this.sp, doc: "", visPub: false, debug: false, tryCatch: Option.None,
            derives: List<Ident>.new(this.ast.arena), name: this.ident(name, 0), typeParams: List<Ident>.new(this.ast.arena),
            bounds: List<List<Ident>>.new(this.ast.arena), variants: List<VariantItem>.new(this.ast.arena) });
    }
    /// `extend name<params> { ms }`; the name is at byte `lo`, each method name at `lo + 100`.
    fn ext(this: &B, name: string, params: string, ms: string, lo: int): Item {
        return Item.Extend(ExtendItem { span: this.sp, name: this.ident(name, lo), typeParams: this.idents(params), methods: this.methods(ms, lo + 100) });
    }
    fn items(this: &B, xs: []Item): List<Item> {
        let l = List<Item>.new(this.ast.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
}

fn nowhere(n: Sym): Option<string> { return Option.None; }

/// `merge` must fail with exactly this text at byte `lo`.
fn fails(r: Option<ExtendErr>, lo: int, message: string, help: string) {
    match r {
        Option.Some(e) {
            if e.message != message || e.help != help || e.span.lo != u32(lo) {
                printLn(e.message);
                printLn(e.help);
                panic("extend error text");
            }
        }
        Option.None { panic("merge should have failed"); }
    }
}

fn main() {
    let s = Session.new(driver.defaults());
    let file = s.sources.add(Source { path: "t.j3", text: "", lines: Lines.of("", s.arena) });
    let ast = Ast.new(s.arena, &s.names);
    let b = B { ast: &ast, sp: Span { file: file, lo: 0, hi: 0 } };

    // the happy path: two blocks into one struct, another item kept in place
    let items = b.items([b.ext("Box", "T", "b", 10), b.strukt("Box", "T", "a"), b.enm("E"), b.ext("Box", "T", "c,d", 20)]);
    match merge(&ast, &items, "m", fn(n: Sym): Option<string> { return Option.None; }) { Option.Some(e) { panic(e.message); } Option.None {} }
    if items.len != 2 { panic("extend items not dropped"); }
    match items.items[0] {
        Item.Struct(st) {
            if st.methods.len != 4 { panic("methods not merged"); }
            let want = ["a", "b", "c", "d"];
            for i in 0..4 { if ast.str(st.methods.items[i].name.name) != want[i] { panic("method order"); } }
        }
        _ { panic("struct moved"); }
    }
    match items.items[1] { Item.Enum(_) {} _ { panic("enum moved"); } }

    // no extend: untouched
    let plain = b.items([b.enm("E")]);
    match merge(&ast, &plain, "m", nowhere) { Option.Some(_) { panic("plain failed"); } Option.None {} }

    let onEnum = b.items([b.enm("E"), b.ext("E", "", "f", 5)]);
    fails(merge(&ast, &onEnum, "m", nowhere), 5,
        "cannot `extend` the enum `E`; only structs take methods", "write a free fn `fn m(this: E)`; it calls as `x.m()`");
    let other = b.items([b.ext("Far", "", "f", 6)]);
    fails(merge(&ast, &other, "game.ui", fn(n: Sym): Option<string> { return Option.Some("game.core"); }), 6,
        "`Far` is declared in module game.core, not in game.ui", "methods of `Far` go in module game.core: its file or a part file");
    let lost = b.items([b.ext("Nope", "", "f", 7)]);
    fails(merge(&ast, &lost, "game", nowhere), 7,
        "`extend Nope`: no struct `Nope` in module game", "declare `struct Nope` in module game (its file or a part file), or fix the name");
    let params = b.items([b.strukt("Map", "K,V", ""), b.ext("Map", "K", "f", 8)]);
    fails(merge(&ast, &params, "m", nowhere), 8,
        "`extend Map<K>` does not match `struct Map<K, V>`", "write `extend Map<K, V>`; the parameters are named as in the struct");
    let bare = b.items([b.strukt("P", "", ""), b.ext("P", "T", "f", 9)]);
    fails(merge(&ast, &bare, "m", nowhere), 9, "`extend P<T>` does not match `struct P`", "write `extend P`; the parameters are named as in the struct");
    let dup = b.items([b.strukt("S", "", "len"), b.ext("S", "", "push,len", 3)]);
    fails(merge(&ast, &dup, "m", nowhere), 103, "`S` already has a method `len`",
        "a method is written once, in the struct body or in one `extend` block; rename one");
    s.free();
    printLn("syntax_extend ok");
}
