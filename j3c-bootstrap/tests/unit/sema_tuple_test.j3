// Tuple typing (`sema/tuple_expr.j3`): a small program through the driver to `Stage.Sema`, then its typed
// tree read back: a literal's `Ty.Tuple`, `==` as a `TExpr.LetIn` over two hidden locals named `tup` (the
// hint `lower` names `_tupN` with), `hash()` as two nested `LetIn`s; and the error texts.
module sema_tuple_test;

use j3.data.pool.Id;
use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.sema.{ Checked, TBody, TExpr, TLetIn, TStmt, Ty };

const SRC: [10]string = [
    "module tup;",
    "use j3.io.printLn; // loads `j3.cmp`, whose `#[impl]` fns give `int` and `string` their `hash`",
    "fn pair(): (int, string) { return (1, \"a\"); }",
    "fn main() {",
    "    let t = pair();",
    "    let e = t == (1, \"a\");",
    "    let h = t.hash();",
    "    let n = (t, 2.5);",
    "    printLn(\"x\");",
    "}",
];

const BAD_FIELD: [2]string = ["module bad1;", "fn main() { let t = (1, 2); let x = t.5; }"];
const BAD_VOID: [3]string = ["module bad2;", "fn v() {}", "fn main() { let t = (1, v()); }"];
const BAD_CMP: [2]string = ["module bad3;", "fn main() { let t = (1, 2); let u = (1, \"a\"); let x = t == u; }"];

/// Write `lines` as `NAME.j3` in a temp dir (outside this package, whose project would otherwise load).
fn put(name: string, lines: []string, mem: &Arena): string {
    let text = Text.new(mem);
    for i in 0..lines.len { text.add(lines[i]).add("\n"); }
    let d = Text.new(mem).add(io.tempRoot()).add("/j3c-boot-sema-tuple").str();
    match io.makeDirs(d) { Result.Ok(_) {} Result.Err(_) { panic("cannot make the case dir"); } }
    let p = Text.new(mem).add(d).add("/").add(name).add(".j3").str();
    match io.writeFile(p, text.str() as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case"); } }
    return p;
}

fn body(c: &Checked, name: string): TBody {
    let fns = &c.tables.fns;
    for i in 0..fns.len() {
        let d = fns.get(fns.idAt(i));
        if c.tables.str(d.name) != name { continue; }
        match d.body {
            Option.Some(b) { return c.typed.body(b); }
            Option.None {}
        }
    }
    panic(`no typed body for {name}`);
    return c.typed.body(Id<TBody> { i: 0 });
}

/// The initializer of `let` statement `k` of `b`.
fn initOf(c: &Checked, b: &TBody, k: int): Id<TExpr> {
    match c.typed.stmt(b.body.stmts.items[k]) {
        TStmt.Let(l) { match l.init { Option.Some(e) { return e; } Option.None {} } }
        _ {}
    }
    panic("not a let with a value");
    return Id<TExpr> { i: 0 };
}

fn letIn(c: &Checked, e: Id<TExpr>, what: string): TLetIn {
    match c.typed.expr(e) {
        TExpr.LetIn(l) { return l; }
        _ {}
    }
    panic(what);
    return letIn(c, e, what);
}

fn elems(c: &Checked, t: Id<Ty>): int {
    match c.tables.ty(t) {
        Ty.Tuple(tt) { return c.tables.items(tt.elems).len; }
        _ {}
    }
    return -1;
}

/// Sema on `lines` must fail with an error whose message is `msg`.
fn expectErr(name: string, lines: []string, msg: string, mem: &Arena) {
    let o = driver.defaults();
    o.entry = put(name, lines, mem);
    let s = Session.new(o);
    if driver.run(s, Stage.Sema) { panic(`{name}: sema should fail`); }
    for i in 0..s.diags.count() { if s.diags.at(i).msg == msg { s.free(); return; } }
    panic(`{name}: no error "{msg}"`);
}

fn main() {
    let mem = Arena.create(1 << 12);
    let o = driver.defaults();
    o.entry = put("tup", SRC, &mem);
    let s = Session.new(o);
    if !driver.run(s, Stage.Sema) { panic("sema fails on the tuple program"); }
    let c = match s.checked { Option.Some(x) { x } Option.None { panic("no checked program"); return; } };
    let m = body(c, "main");

    // a call's tuple result and a nested literal: one interned `Ty.Tuple` per element list
    let tt = c.typed.exprTy(initOf(c, &m, 0));
    if elems(c, tt) != 2 { panic("t: a 2-tuple"); }
    let nt = c.typed.exprTy(initOf(c, &m, 3));
    match c.tables.ty(nt) {
        Ty.Tuple(x) { if c.tables.items(x.elems)[0] != tt { panic("n: first element is t's type"); } }
        _ { panic("n: a tuple"); }
    }
    match c.typed.expr(initOf(c, &m, 3)) { TExpr.Tuple(x) { if x.items.len != 2 { panic("n: two items"); } } _ { panic("n: a Tuple node"); } }

    // `==`: both sides bound to hidden locals named `tup`, then the element-wise expression
    let eq = letIn(c, initOf(c, &m, 1), "e: `==` is a LetIn");
    if eq.locals.len != 2 || eq.values.len != 2 { panic("e: two hidden locals"); }
    for i in 0..2 {
        let l = c.typed.local(eq.locals.items[i]);
        if c.tables.str(l.name) != "tup" || l.ty != tt { panic("e: hidden local is `tup` of the tuple type"); }
    }
    if c.typed.exprTy(eq.body) != c.tables.common.bool { panic("e: body is a bool"); }

    // `hash()`: the tuple bound once, the folded hash bound once inside
    let h = letIn(c, initOf(c, &m, 2), "h: `hash()` is a LetIn");
    if h.locals.len != 1 { panic("h: one hidden local outside"); }
    let inner = letIn(c, h.body, "h: the mix is a nested LetIn");
    if inner.locals.len != 1 || c.typed.local(inner.locals.items[0]).ty != c.tables.common.u64 { panic("h: the folded hash is a u64 local"); }
    s.free();

    expectErr("bad1", BAD_FIELD, "no field `5` on `(int, int)`", &mem);
    expectErr("bad2", BAD_VOID, "a tuple element needs a value", &mem);
    expectErr("bad3", BAD_CMP, "type mismatch: expected `(int, int)`, found `(int, string)`", &mem);
}
