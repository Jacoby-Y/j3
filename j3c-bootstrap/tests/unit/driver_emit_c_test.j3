// `--emit c` is an error in j3c-boot (B8a), raised by the first stage so no up-to-date shortcut hides it;
// `--emit` words map like Rust `emit_code` (an unknown word is ignored).
module driver_emit_c_test;

use j3.sys.panic;
use j3.text.startsWith;
use j3c.cmd.check.failText;
use j3c.cmd.run.emitName;
use j3c.driver;
use j3c.driver.{ Session, Stage };

fn main() {
    if emitName("C") != "c" || emitName("ll") != "llvm" || emitName("LLVM") != "llvm" || emitName("cranelift") != "" { panic("emitName"); }
    let o = driver.defaults();
    o.entry = "tests/proj/merged_names";
    o.emit = emitName("c");
    let s = Session.new(o);
    if driver.run(s, Stage.Load) { panic("--emit c loaded"); }
    if !startsWith(failText(s), "error: the C backend was removed: use `llvm` (native builds) or `bc` (scripts)") { panic(failText(s)); }
    s.free();
    let k = driver.defaults();
    k.entry = "tests/proj/merged_names";
    k.emit = emitName("llvm");
    let s2 = Session.new(k);
    if !driver.run(s2, Stage.Load) { panic(failText(s2)); }
    s2.free();
}
