// `dump-syntax` grammars equal the shipped editor grammars byte for byte (Rust `syntax.rs` tests
// `shipped_grammar_is_dump_syntax`, `shipped_ui_grammar_is_dump_syntax`), and the grammar holds every
// compiler name (Rust `grammar_contains_compiler_names`, `grammar_uses_dark_plus_scopes`).
module textmate_grammar_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.sys.panic;
use j3.text.{ Text, contains };
use j3c.syntax.token.{ ITEM_EXTEND, ITEM_TRAIT, NameList, TYPE_CLOSURE, TYPE_DYN, keywordNames, names, scopeOf, wordsOf };
use j3c.textmate.{ jsonString, reEscape, tmGrammar, uiTmGrammar };

const SHIPPED = @embed("../../../editors/vscode/syntaxes/j3.tmLanguage.json");
const SHIPPED_UI = @embed("../../../editors/vscode/syntaxes/j3ui.tmLanguage.json");

fn has(g: string, xs: []string, what: string) {
    for i in 0..xs.len { if !contains(g, xs[i]) { panic(Text.scratch().add("missing ").add(what).add(" ").add(xs[i]).str()); } }
}

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let g = tmGrammar(&mem);
    if g != SHIPPED { panic("dump-syntax differs from editors/vscode/syntaxes/j3.tmLanguage.json"); }
    if uiTmGrammar(&mem) != SHIPPED_UI { panic("dump-syntax --ui differs from editors/vscode/syntaxes/j3ui.tmLanguage.json"); }

    let kws = keywordNames(&mem);
    for i in 0..kws.len { if scopeOf(kws[i]).len == 0 { panic("keyword without a scope"); } }
    has(g, kws, "keyword");
    has(g, wordsOf("literal", &mem), "bool lit");
    if wordsOf("type", &mem).len != 20 { panic("keywords.txt type count changed"); }
    has(g, wordsOf("type", &mem), "type");
    has(g, names(NameList.Attributes), "attribute");
    has(g, names(NameList.Intrinsics), "intrinsic");
    has(g, [TYPE_CLOSURE, TYPE_DYN, ITEM_TRAIT, ITEM_EXTEND], "contextual word");
    let ops = names(NameList.Overloadable);
    for i in 0..ops.len {
        let q = Text.new(&mem);
        jsonString(&q, reEscape(ops[i], &mem));
        let s = q.str();
        has(g, [s[1..s.len - 1]], "operator");
    }
    has(g, ["entity.name.function.j3", "entity.name.type.j3", "entity.name.namespace.j3", "support.type.builtin.j3",
        "support.function.intrinsic.j3", "variable.other.constant.j3", "variable.other.property.j3",
        "variable.other.enummember.j3", "variable.parameter.j3", "keyword.control.j3"], "scope");
}
