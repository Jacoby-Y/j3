// `load` scripts and scene scripts: small projects are written to `target/unit/load_scripts_cases/` (never
// in the tree, where a compile of j3c-bootstrap would scan their scenes), then the scene scan, the script
// list and the `j3.scene3d.scripts` source (or its errors) are printed and compared byte for byte with
// `tests/unit/load_scripts_cases/NAME.txt`: what Rust printed for the same files (a scratch crate on the
// `j3c` lib calling `scene_scripts::scan`/`registry` and `script_paths`, same line format). Then
// `scriptModuleParts` messages and `find`/`embeds` on a parsed file.
module load_scripts_test;

use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.fsx;
use j3c.base.intern.Names;
use j3c.base.span.Source;
use j3c.base.text_fmt.{ debugF64, debugStr };
use j3c.load.scene_registry;
use j3c.load.scene_scan;
use j3c.load.scripts_deps;
use j3c.syntax.ast.{ Ast, File };
use j3c.syntax.parse;
use j3.data.pool.Id;

// Beside the test package, not inside it: a build of that package scans its own folder for scenes.
const DIR = "target/unit/load_scripts_cases";

fn put(dir: string, rel: string, text: string, arena: &Arena) {
    let p = path.join(dir, rel, arena);
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a fixture"); } }
}

/// What the Rust oracle prints for project `root`.
fn report(root: string, ast: &Ast, arena: &Arena): string {
    let t = Text.new(arena);
    let scan = scene_scan.scan(root, arena);
    t.add("== main_scene ");
    debugStr(&t, scan.mainScene);
    t.add("\n");
    for i in 0..scan.attachments.len {
        let a = scan.attachments.items[i];
        t.add("== attach ").add(a.scene).add(" ");
        t.pushInt(a.line);
        t.add(" ");
        t.pushInt(a.id);
        t.add(" ").add(a.script).add("\n");
    }
    // Rust prints its BTreeMap in (scene, id) order
    let order = List<int>.new(arena);
    for i in 0..scan.params.len {
        let at = order.len;
        let pi = scan.params.items[i];
        while at > 0 {
            let q = scan.params.items[order.items[at - 1]];
            if q.scene < pi.scene || (q.scene == pi.scene && q.id < pi.id) { break; }
            at -= 1;
        }
        order.push(0);
        let k = order.len - 1;
        while k > at { order.items[k] = order.items[k - 1]; k -= 1; }
        order.items[at] = i;
    }
    for i in 0..order.len {
        let ps = scan.params.items[order.items[i]];
        for k in 0..ps.params.len {
            let p = ps.params.items[k];
            t.add("== param ").add(ps.scene).add(" ");
            t.pushInt(ps.id);
            t.add(" ").add(p.field).add(" '");
            t.push(p.kind);
            t.add("' ");
            debugStr(&t, p.value);
            t.add(" ");
            t.pushInt(p.line);
            t.add("\n");
        }
    }
    let scripts = scripts_deps.scriptPaths(root, arena);
    for i in 0..scripts.len { t.add("== script ").add(scripts.items[i]).add("\n"); }
    match scene_registry.registry(root, &scan, ast) {
        Result.Ok(src) { t.add("== OK\n").add(src); }
        Result.Err(e) { t.add("== ERR\n").add(e); }
    }
    return t.str();
}

fn case(name: string, files: []string, ast: &Ast, arena: &Arena): bool {
    let root = path.join(DIR, name, arena);
    for i in 0..files.len / 2 { put(root, files[2 * i], files[2 * i + 1], arena); }
    let got = report(root, ast, arena);
    let want = match fsx.readText(Text.new(arena).add("tests/unit/load_scripts_cases/").add(name).add(".txt").str(), arena) {
        Result.Ok(t) { t }
        Result.Err(e) { printLn(e); "" }
    };
    if got == want { return true; }
    let out = path.join(DIR, Text.new(arena).add(name).add(".got").str(), arena);
    match io.writeFile(out, got as []u8) { Result.Ok(_) {} Result.Err(_) {} }
    printLn(Text.new(arena).add("DIFF ").add(name).add(": see ").add(out).str());
    return false;
}

const DOOR = "// door\nuse j3.scene3d.{ Scene, NodeId };\nuse j3.math.Vec3;\n\nprops {\n    node: NodeId;\n    target: NodeId;\n    speed: f32 = 1.0;\n    neg: f32 = -0.5;\n    big: f64 = 100000000000000000000.0;\n    tiny: float = 0.00001;\n    whole: f64 = 3.0;\n    count: int = -3;\n    small: u8 = 'a';\n    on: bool = true;\n    label: string = \"a \\\"b\\\"\\tc\";\n    dir: Vec3 = 0;\n    plain: f32;\n    other: List<int> = 0;\n}\n\npub fn start(scene: &Scene) {}\n\npub fn update(scene: &Scene, dt: f32) {}\n";
const LAMP = "use j3.scene3d.Scene;\n\nprops {\n    glow: f32 = 2.5;\n}\n\npub fn update(scene: &Scene, dt: f32) {}\n";
const MAIN = "j3scene 2 next=4\nenv sun=1,2,3\nparam.7.speed f=9\n\n// a door\nDoor cube script=scripts/door.j3s param.target=#3 param.speed=0.5 param.plain=2 param.dir.x=1 param.fx.blur.r=1 #2\n  Knob group #3\n  Lamp light script=scripts/sub/lamp.j3s param.glow=4\nPlain sphere #9\n";
const OLD = "scene.version=1\nnode.0.id=5\nnode.0.kind=1\nnode.0.name s=Old\nnode.0.script s=scripts/door.j3s\nnode.1.id=6\nparam.5.plain f=1.5\nparam.5.target r=6\nparam.9.speed f=1\n";
const BADHOOK = "use j3.scene3d.Scene;\n\nprops {\n    flag: bool;\n    n: i32;\n    words: string;\n}\n\nfn start(scene: &Scene) {}\n\npub fn update(scene: Scene): int { return 0; }\n";
const BADSCENE = "j3scene 2\nA group script=scripts/bad.j3s param.flag=2 param.n=1.5 param.words=7 param.ghost.x=1 #1\nB group script=scripts/missing.j3s #2\nC group script=scripts/sub/lamp.j3s param.nope=1 #12\nD group script=scripts/bad.j3s param.flag=1 param.n=2 param.words=\"w\" #3\n";

fn scenes(ast: &Ast, arena: &Arena): bool {
    let ok = true;
    ok = case("ok", ["j3.editor.toml", "[editor]\nscene = \"scenes/main.j3scene\"\n", "scripts/door.j3s", DOOR,
        "scripts/sub/lamp.j3s", LAMP, "scenes/main.j3scene", MAIN, "scenes/more/old.j3scene", OLD,
        "target/skip.j3scene", "j3scene 2\nX group script=scripts/x.j3s #1\n"], ast, arena) && ok;
    ok = case("errors", ["scripts/bad.j3s", BADHOOK, "scripts/sub/lamp.j3s", LAMP, "scripts/misssing.j3s", LAMP,
        "scenes/s.j3scene", BADSCENE], ast, arena) && ok;
    ok = case("parse", ["scripts/p.j3s", "props {\n    a: f32 = ;\n}\n", "a.j3scene", "j3scene 2\nA group script=scripts/p.j3s #1\n"], ast, arena) && ok;
    ok = case("badpath", ["scripts/a-b.j3s", LAMP, "a.j3scene", "j3scene 2\nA group script=scripts/a-b.j3s #1\n"], ast, arena) && ok;
    ok = case("empty", ["src/main.j3", "module main;\n"], ast, arena) && ok;
    return ok;
}

fn eq(got: string, want: string) {
    if got != want { printLn(got); panic(want); }
}

fn parts(rel: string, arena: &Arena): string {
    match scripts_deps.scriptModuleParts(rel, arena) {
        Result.Ok(ps) {
            let t = Text.new(arena);
            for i in 0..ps.len { if i > 0 { t.add("."); } t.add(ps.items[i]); }
            return t.str();
        }
        Result.Err(e) { return e; }
    }
}

fn floats(arena: &Arena) {
    let xs: [9]f64 = [1.0, -0.5, 1e20, 0.00001, 0.0001, 1e15, 1e16, 123.456, 1.5e-7];
    let want: [9]string = ["1.0", "-0.5", "1e20", "1e-5", "0.0001", "1000000000000000.0", "1e16", "123.456", "1.5e-7"];
    for i in 0..xs.len {
        let t = Text.new(arena);
        debugF64(&t, xs[i], arena);
        eq(t.str(), want[i]);
    }
}

fn deps(ast: &Ast, arena: &Arena) {
    let src = "module m;\nconst A = @script(\"a.j3s\");\nfn f() {\n    let x = @embed(\"t.txt\");\n    if true { g(@script(\"b.j3s\") { v: @embedDir(\"d\", \"*.png\") }); }\n}\n";
    let f = match parse.parseFile(src, Id<Source> { i: 0 }, ast) { Result.Ok(f) { f } Result.Err(e) { panic(e.msg) } };
    let ss = scripts_deps.find(ast, &f);
    if ss.len != 2 { panic("find"); }
    eq(ss.items[0].path, "a.j3s");
    eq(ss.items[1].path, "b.j3s");
    let es = scripts_deps.embeds(ast, &f);
    if es.len != 2 { panic("embeds"); }
    eq(es.items[0].path, "t.txt");
    eq(es.items[1].glob, "*.png");
}

fn main() {
    let a = Arena.create(1 << 20);
    let arena = &a;
    let names = Names.new(arena);
    let ast = Ast.new(arena, &names);
    eq(parts("scripts/door.j3s", arena), "script.scripts.door");
    eq(parts("/x.j3s", arena), "script path must be relative to the project root: /x.j3s");
    eq(parts("./x.j3s", arena), "script path must be relative to the project root: ./x.j3s");
    eq(parts("a/../x.j3s", arena), "script path must be relative to the project root: a/../x.j3s");
    eq(parts("a/./x.j3s", arena), "script path has an invalid module component: a/./x.j3s");
    eq(parts("a//x.j3s", arena), "script path has an invalid module component: a//x.j3s");
    eq(parts("x.j3", arena), "script path must end in `.j3s`: x.j3");
    eq(parts("a/1x.j3s", arena), "script path has an invalid module component: a/1x.j3s");
    eq(parts("_a/x1.j3s", arena), "script._a.x1");
    eq(scene_registry.ident("scripts/sub/door.j3s.j3s", arena), "scripts__sub__door");
    floats(arena);
    deps(&ast, arena);
    if !scenes(&ast, arena) { panic("scene cases differ"); }
    printLn("ok");
}
