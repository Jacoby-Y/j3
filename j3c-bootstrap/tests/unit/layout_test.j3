// Stage-0 hazard (a) (PORT_DEBT.md "Stage-0 bugs"): stage 0 sizes a struct with its payload enums 8-aligned,
// LLVM lays them out 4-aligned, so a struct can be smaller in LLVM than `@sizeof` says and a by-value copy
// (`List.push`) then writes past its slot. Every struct here has a small field (bool, int enum, u32) right
// before an `Option` / payload enum; the test fails when the two sizes differ. Fix: bools last (AGENTS.md).
// The list comes from a scan of `src/` (wave 18); add a struct here when you write that field pattern.
module layout_test;

use j3.memory.Arena;
use j3.sys.panic;
use j3c.backend.bc.{ Addr, BcField, BcFunction, BcGlobal, BcModule, BcNative, BcParam, CallArg, CallSite, Codegen, Instr, LastCompare, LoopFixups,
    PlaceWalk, Shared };
use j3c.backend.llvm.{ LlvmFn };
use j3c.cmd.devrun.{ Built, ScriptLayout };
use j3c.pkgtool.{ ToolCmd };
use j3c.base.toml.{ Entry };
use j3c.ir.{ ConstField, FieldDef, Func, VariantDef };
use j3c.load.{ Loader, UiCfg };
use j3c.mcp.schema.{ ToolArg };
use j3c.project.manifest.{ Android, Dist, Ui };
use j3c.sema.{ ConstDecl, EnumDecl, FieldDecl, FnDecl, StructDecl, TAssignOp, TBinary, TForEach };
use j3c.shader.{ ArithOut, ConstDone, GField, GLocal, Val };
use j3c.syntax.ast.{ EnumItem, FieldItem, FnItem };
use j3c.syntax.parse.{ ItemAttrs };
use j3c.ui.gen.{ ActDef, EachCx, EachHead, G, Virt };
// C5 contracts (wave 25): the new by-value structs and the ones that gained a field.
use j3c.driver.Options;
use j3c.load.LoadOpts;
use j3c.sema.TLocal;
use j3c.assets.png.Image;
use j3c.cmd.gen.GenReport;
use j3c.cmd.guide.Recipe;
use j3c.editor.assets.ScriptProp;
use j3c.lsp.complete.{ Completion, ImportEdit, PrefixAt, Signature, SignatureHelp, Symbol, UseAt };
use j3c.lsp.docs.{ Cursor, Doc };
use j3c.lsp.query.{ Hover, Location, LspRange };
use j3c.mcp.schema.Answer;
use j3c.scene.reply.Reply;

fn chk<T>(a: &Arena, name: string) {
    let s = a.alloc::<T>(2);
    let stride = int(&s[1] as ptr) - int(&s[0] as ptr);
    if stride != @sizeof(T) { panic(`{name}: @sizeof {@sizeof(T)}, LLVM stride {stride}: reorder its fields (bools last)`); }
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;
    chk::<Addr>(a, "j3c.backend.bc.Addr");
    chk::<BcField>(a, "j3c.backend.bc.BcField");
    chk::<BcFunction>(a, "j3c.backend.bc.BcFunction");
    chk::<BcGlobal>(a, "j3c.backend.bc.BcGlobal");
    chk::<BcModule>(a, "j3c.backend.bc.BcModule");
    chk::<BcNative>(a, "j3c.backend.bc.BcNative");
    chk::<BcParam>(a, "j3c.backend.bc.BcParam");
    chk::<CallArg>(a, "j3c.backend.bc.CallArg");
    chk::<CallSite>(a, "j3c.backend.bc.CallSite");
    chk::<Instr>(a, "j3c.backend.bc.Instr");
    chk::<LastCompare>(a, "j3c.backend.bc.LastCompare");
    chk::<LoopFixups>(a, "j3c.backend.bc.LoopFixups");
    chk::<Codegen>(a, "j3c.backend.bc.Codegen");
    chk::<PlaceWalk>(a, "j3c.backend.bc.PlaceWalk");
    chk::<Shared>(a, "j3c.backend.bc.Shared");
    chk::<Built>(a, "j3c.cmd.devrun.Built");
    chk::<ScriptLayout>(a, "j3c.cmd.devrun.ScriptLayout");
    chk::<ToolCmd>(a, "j3c.pkgtool.ToolCmd");
    chk::<LlvmFn>(a, "j3c.backend.llvm.LlvmFn");
    chk::<Entry>(a, "j3c.base.toml.Entry");
    chk::<ConstField>(a, "j3c.ir.ConstField");
    chk::<FieldDef>(a, "j3c.ir.FieldDef");
    chk::<Func>(a, "j3c.ir.Func");
    chk::<VariantDef>(a, "j3c.ir.VariantDef");
    chk::<Loader>(a, "j3c.load.Loader");
    chk::<UiCfg>(a, "j3c.load.UiCfg");
    chk::<ToolArg>(a, "j3c.mcp.schema.ToolArg");
    chk::<Android>(a, "j3c.project.manifest.Android");
    chk::<Dist>(a, "j3c.project.manifest.Dist");
    chk::<Ui>(a, "j3c.project.manifest.Ui");
    chk::<ConstDecl>(a, "j3c.sema.ConstDecl");
    chk::<EnumDecl>(a, "j3c.sema.EnumDecl");
    chk::<FieldDecl>(a, "j3c.sema.FieldDecl");
    chk::<FnDecl>(a, "j3c.sema.FnDecl");
    chk::<StructDecl>(a, "j3c.sema.StructDecl");
    chk::<TAssignOp>(a, "j3c.sema.TAssignOp");
    chk::<TBinary>(a, "j3c.sema.TBinary");
    chk::<TForEach>(a, "j3c.sema.TForEach");
    chk::<ArithOut>(a, "j3c.shader.ArithOut");
    chk::<ConstDone>(a, "j3c.shader.ConstDone");
    chk::<GField>(a, "j3c.shader.GField");
    chk::<GLocal>(a, "j3c.shader.GLocal");
    chk::<Val>(a, "j3c.shader.Val");
    chk::<EnumItem>(a, "j3c.syntax.ast.EnumItem");
    chk::<FieldItem>(a, "j3c.syntax.ast.FieldItem");
    chk::<FnItem>(a, "j3c.syntax.ast.FnItem");
    chk::<ItemAttrs>(a, "j3c.syntax.parse.ItemAttrs");
    chk::<ActDef>(a, "j3c.ui.gen.ActDef");
    chk::<EachCx>(a, "j3c.ui.gen.EachCx");
    chk::<EachHead>(a, "j3c.ui.gen.EachHead");
    chk::<G>(a, "j3c.ui.gen.G");
    chk::<Virt>(a, "j3c.ui.gen.Virt");
    chk::<Options>(a, "j3c.driver.Options");
    chk::<LoadOpts>(a, "j3c.load.LoadOpts");
    chk::<TLocal>(a, "j3c.sema.TLocal");
    chk::<Image>(a, "j3c.assets.png.Image");
    chk::<GenReport>(a, "j3c.cmd.gen.GenReport");
    chk::<Recipe>(a, "j3c.cmd.guide.Recipe");
    chk::<ScriptProp>(a, "j3c.editor.assets.ScriptProp");
    chk::<Completion>(a, "j3c.lsp.complete.Completion");
    chk::<ImportEdit>(a, "j3c.lsp.complete.ImportEdit");
    chk::<PrefixAt>(a, "j3c.lsp.complete.PrefixAt");
    chk::<Signature>(a, "j3c.lsp.complete.Signature");
    chk::<SignatureHelp>(a, "j3c.lsp.complete.SignatureHelp");
    chk::<Symbol>(a, "j3c.lsp.complete.Symbol");
    chk::<UseAt>(a, "j3c.lsp.complete.UseAt");
    chk::<Cursor>(a, "j3c.lsp.docs.Cursor");
    chk::<Doc>(a, "j3c.lsp.docs.Doc");
    chk::<Hover>(a, "j3c.lsp.query.Hover");
    chk::<Location>(a, "j3c.lsp.query.Location");
    chk::<LspRange>(a, "j3c.lsp.query.LspRange");
    chk::<Answer>(a, "j3c.mcp.schema.Answer");
    chk::<Reply>(a, "j3c.scene.reply.Reply");
}
