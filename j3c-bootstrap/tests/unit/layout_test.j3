    chk::<Options>(a, "j3c.driver.Options");
    chk::<LoadOpts>(a, "j3c.load.LoadOpts");
    chk::<TLocal>(a, "j3c.sema.TLocal");
    chk::<Image>(a, "j3c.assets.png.Image");
    chk::<GenReport>(a, "j3c.cmd.gen.GenReport");
    chk::<Recipe>(a, "j3c.cmd.guide.Recipe");
    chk::<ScriptProp>(a, "j3c.editor.assets.ScriptProp");
    chk::<Completion>(a, "j3c.lsp.complete.Completion");
    chk::<ImportEdit>(a, "j3c.lsp.complete.ImportEdit");
