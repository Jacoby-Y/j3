// Shader leaf typing and GLSL text (`shader/{ty,ops,builtins,glsl}.j3`): type words, swizzles, operator
// result types, builtin rules, float text, name mangling, `bare`, the stage layout and `prepEs`. Expected
// texts are stage0's: `stage0/j3c dump-glsl [--es]` on a program with these literals and names
// (`0.1 + 100000.0 + 1e16 ..`, params `out`, `v_x`, `a__b`, local `main`, fn `sample`).
module shader_leaf_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.shader.{ BUILTINS, Base, GArray, GStruct, GTy, GVec, StageText, arithRes, bare, baseWord, builtinLookup, builtinTable, builtinType,
    elem, floatText, gBool, gF32, gI32, gU32, glsl, gtyEq, isFloat, isInt, isIntText, isReserved, isScalar, lanes, mangle, name, opSym, prepEs,
    remRes, settle, swizzleLen, swizzleRepeats };
use j3c.syntax.ast.BinOp;

fn same(got: string, want: string) {
    if got != want { printLn(got); panic(want); }
}

fn yes(b: bool, what: string) {
    if !b { panic(what); }
}

fn vec(b: Base, n: int): GTy { return GTy.Vec(GVec { base: b, n: n }); }

/// The GLSL word of type name `w`.
fn word(a: &Arena, w: string): string {
    match builtinType(w) {
        Option.Some(t) { return t.glsl(a); }
        Option.None { return "?"; }
    }
}

/// The J3 name of `op` on `l` and `r`, "bad" when the operator refuses them.
fn bin(a: &Arena, op: BinOp, l: GTy, r: GTy): string {
    let res = if op == BinOp.Rem { remRes(l, r) } else { arithRes(op, l, r) };
    match res {
        Option.Some(t) { return t.name(a); }
        Option.None { return "bad"; }
    }
}

/// The result of `@n(args)`, or the "it takes .." text.
fn rule(a: &Arena, n: string, args: [3]GTy, count: int): string {
    let l = List<GTy>.new(a);
    for i in 0..count { l.push(args[i]); }
    match builtinLookup(n) {
        Option.Some(b) {
            match b.result(&l) {
                Result.Ok(t) { return t.name(a); }
                Result.Err(w) { return w; }
            }
        }
        Option.None { return "?"; }
    }
}

fn types(a: &Arena) {
    same(word(a, "f32"), "float");
    same(word(a, "i32"), "int");
    same(word(a, "u32"), "uint");
    same(word(a, "bool"), "bool");
    same(word(a, "vec3"), "vec3");
    same(word(a, "ivec2"), "ivec2");
    same(word(a, "uvec4"), "uvec4");
    same(word(a, "bvec2"), "bvec2");
    same(word(a, "mat4"), "mat4");
    same(word(a, "sampler2D"), "sampler2D");
    same(word(a, "sampler2DShadow"), "sampler2DShadow");
    same(word(a, "vec5"), "?");
    same(word(a, "vec"), "?");
    same(word(a, "vec22"), "?");
    same(word(a, "dvec2"), "?");
    same(word(a, "int"), "?");
    same(word(a, "mat5"), "?");
    same(baseWord(Base.U), "u32");

    let f = gF32();
    let arr = GTy.Array(GArray { elem: &f, len: 4 });
    same(arr.glsl(a), "float[4]");
    same(arr.name(a), "[4]f32");
    let st = GTy.Struct(GStruct { key: "a.b::Light", glsl: "j3_Light" });
    same(st.glsl(a), "j3_Light");
    same(st.name(a), "Light");
    same(GTy.LitInt.name(a), "an integer literal");
    same(GTy.LitFloat.glsl(a), "float");
    same(vec(Base.F, 3).name(a), "vec3");
    same(GTy.Void.name(a), "void");

    yes(gtyEq(arr, GTy.Array(GArray { elem: &f, len: 4 })), "array ==");
    yes(!gtyEq(arr, GTy.Array(GArray { elem: &f, len: 3 })), "array len !=");
    yes(!gtyEq(vec(Base.F, 3), vec(Base.I, 3)), "vec base !=");
    yes(!gtyEq(GTy.LitInt, gI32()), "literal != i32");
    yes(gtyEq(GTy.LitInt.settle(), gI32()) && gtyEq(GTy.LitFloat.settle(), gF32()), "settle");
    yes(GTy.LitInt.isScalar() && !vec(Base.F, 2).isScalar(), "isScalar");
    yes(GTy.Mat(3).isFloat() && !gI32().isFloat() && vec(Base.F, 2).isFloat(), "isFloat");
    yes(vec(Base.U, 2).isInt() && gU32().isInt() && !gBool().isInt(), "isInt");
    match vec(Base.I, 3).elem() { Option.Some(t) { yes(gtyEq(t, gI32()), "elem"); } Option.None { panic("elem"); } }
    match GTy.Mat(2).elem() { Option.Some(t) { panic("mat elem"); } Option.None {} }
    match vec(Base.F, 4).lanes() { Option.Some(n) { yes(n == 4, "lanes"); } Option.None { panic("lanes"); } }
    match GTy.Sampler(false).lanes() { Option.Some(n) { panic("sampler lanes"); } Option.None {} }

    match swizzleLen("xyz", 3) { Option.Some(n) { yes(n == 3, "xyz"); } Option.None { panic("xyz"); } }
    match swizzleLen("rg", 2) { Option.Some(n) { yes(n == 2, "rg"); } Option.None { panic("rg"); } }
    match swizzleLen("q", 4) { Option.Some(n) { yes(n == 1, "q"); } Option.None { panic("q"); } }
    match swizzleLen("xyz", 2) { Option.Some(n) { panic("z of a vec2"); } Option.None {} }
    match swizzleLen("xg", 4) { Option.Some(n) { panic("mixed sets"); } Option.None {} }
    match swizzleLen("xyzwx", 4) { Option.Some(n) { panic("five letters"); } Option.None {} }
    match swizzleLen("", 4) { Option.Some(n) { panic("empty"); } Option.None {} }
    yes(swizzleRepeats("xx") && swizzleRepeats("xyx") && !swizzleRepeats("xyzw"), "repeats");
}

fn operators(a: &Arena) {
    let f = gF32();
    let i = gI32();
    let u = gU32();
    let v3 = vec(Base.F, 3);
    let v4 = vec(Base.F, 4);
    let iv3 = vec(Base.I, 3);
    same(opSym(BinOp.Shl), "<<");
    same(opSym(BinOp.Ne), "!=");
    same(opSym(BinOp.Or), "||");
    same(bin(a, BinOp.Add, f, f), "f32");
    same(bin(a, BinOp.Add, f, i), "bad");
    same(bin(a, BinOp.Mul, v3, f), "vec3");
    same(bin(a, BinOp.Sub, f, v3), "vec3");
    same(bin(a, BinOp.Div, iv3, i), "ivec3");
    same(bin(a, BinOp.Mul, iv3, f), "bad");
    same(bin(a, BinOp.Add, v3, v4), "bad");
    same(bin(a, BinOp.Add, v3, iv3), "bad");
    same(bin(a, BinOp.Mul, GTy.Mat(4), v4), "vec4");
    same(bin(a, BinOp.Mul, v4, GTy.Mat(4)), "vec4");
    same(bin(a, BinOp.Mul, GTy.Mat(3), v4), "bad");
    same(bin(a, BinOp.Add, GTy.Mat(4), v4), "bad");
    same(bin(a, BinOp.Mul, GTy.Mat(4), GTy.Mat(4)), "mat4");
    same(bin(a, BinOp.Mul, GTy.Mat(4), f), "mat4");
    same(bin(a, BinOp.Div, f, GTy.Mat(2)), "mat2");
    same(bin(a, BinOp.Mul, GTy.Mat(4), i), "bad");
    same(bin(a, BinOp.Add, gBool(), gBool()), "bad");
    same(bin(a, BinOp.Add, vec(Base.B, 2), gBool()), "bad");
    same(bin(a, BinOp.Add, GTy.LitInt, GTy.LitInt), "an integer literal");
    same(bin(a, BinOp.Rem, i, i), "i32");
    same(bin(a, BinOp.Rem, vec(Base.U, 2), u), "uvec2");
    same(bin(a, BinOp.Rem, f, f), "bad");
    same(bin(a, BinOp.Rem, v3, f), "bad");
    same(bin(a, BinOp.Rem, i, u), "bad");

    same(rule(a, "sin", [v3, f, f], 1), "vec3");
    same(rule(a, "sin", [i, f, f], 1), "an f32 or a float vector");
    same(rule(a, "abs", [iv3, f, f], 1), "ivec3");
    same(rule(a, "abs", [u, f, f], 1), "an f32/i32 or a vector of them");
    same(rule(a, "pow", [v3, f, f], 2), "two floats of one type");
    same(rule(a, "mod", [v3, f, f], 2), "vec3");
    same(rule(a, "atan", [f, f, f], 1), "f32");
    same(rule(a, "max", [u, u, f], 2), "u32");
    same(rule(a, "mix", [v3, v3, f], 3), "vec3");
    same(rule(a, "mix", [v3, f, f], 3), "(x, y, t): x and y one float type, t the same or an f32");
    same(rule(a, "clamp", [iv3, i, i], 3), "ivec3");
    same(rule(a, "step", [f, v3, f], 2), "vec3");
    same(rule(a, "smoothstep", [f, f, v3], 3), "vec3");
    same(rule(a, "dot", [v3, v3, f], 2), "f32");
    same(rule(a, "cross", [v4, v4, f], 2), "two vec3");
    same(rule(a, "refract", [v3, v3, f], 3), "vec3");
    same(rule(a, "inverse", [GTy.Mat(3), f, f], 1), "mat3");
    same(rule(a, "texture", [GTy.Sampler(false), vec(Base.F, 2), f], 2), "vec4");
    same(rule(a, "texture", [GTy.Sampler(true), v3, f], 2), "f32");
    same(rule(a, "texture", [GTy.Sampler(true), vec(Base.F, 2), f], 2), "(sampler2D, vec2) or (sampler2DShadow, vec3)");
    same(rule(a, "texelFetch", [GTy.Sampler(false), vec(Base.I, 2), i], 3), "vec4");
    same(rule(a, "textureSize", [GTy.Sampler(true), i, f], 2), "ivec2");
    same(rule(a, "fragCoord", [f, f, f], 0), "vec4");
    same(rule(a, "vertexId", [f, f, f], 0), "i32");
    same(rule(a, "discard", [f, f, f], 0), "void");
    same(rule(a, "nope", [f, f, f], 0), "?");
    // Rust `names_match_the_parser_list`: one row per `INTRINSIC_GPU` name but `shader` (40 names there).
    let t = builtinTable();
    yes(BUILTINS == 39 && t[38].name == "fragCoord" && t[38].glsl == "gl_FragCoord", "table rows");
}

fn text(a: &Arena) {
    let zero: f64 = 0.0;
    same(floatText(0.1, a), "0.1");
    same(floatText(100000.0, a), "100000.0");
    same(floatText(1e16, a), "1e16");
    same(floatText(1.5e-7, a), "1.5e-7");
    same(floatText(0.0001, a), "0.0001");
    same(floatText(0.00001, a), "1e-5");
    same(floatText(16777216.0, a), "16777216.0");
    same(floatText(3.4e38, a), "3.4e38");
    same(floatText(123456789.0, a), "123456790.0");
    same(floatText(0.5, a), "0.5");
    same(floatText(1e15, a), "1000000000000000.0");
    same(floatText(2.5e20, a), "2.5e20");
    same(floatText(7.25, a), "7.25");
    same(floatText(1.0, a), "1.0");
    same(floatText(0.0, a), "0.0");
    same(floatText(-2.5, a), "-2.5");
    same(floatText(-zero, a), "-0.0");
    same(floatText(1e40, a), "inf");
    same(floatText(-1.0 / zero, a), "-inf");
    same(floatText(zero / zero, a), "NaN");
    same(floatText(0.012, a), "0.012");
    // exact ties: Rust rounds up, Ryu to even (more in base_text_fmt_test)
    same(floatText(3061734.25, a), "3061734.3");
    same(floatText(0.251953125, a), "0.25195313");
    same(floatText(3061734.75, a), "3061734.8");

    yes(isIntText("3") && isIntText("-12") && !isIntText("-") && !isIntText("") && !isIntText("1.0") && !isIntText("(1)"), "isIntText");
    same(bare("(a + b)"), "a + b");
    same(bare("(a) + (b)"), "(a) + (b)");
    same(bare("f(a)"), "f(a)");
    same(bare("((a) * (b))"), "(a) * (b)");
    same(bare("x"), "x");

    same(mangle("sample", a), "j3_sample");
    same(mangle("out", a), "j3_out");
    same(mangle("v_x", a), "j3_v_x");
    same(mangle("a__b", a), "j3_a__b");
    same(mangle("main", a), "j3_main");
    same(mangle("x", a), "x");
    same(mangle("position", a), "position");
    same(mangle("gl_x", a), "j3_gl_x");
    same(mangle("j3_x", a), "j3_j3_x");
    same(mangle("a_pos", a), "j3_a_pos");
    same(mangle("oColor", a), "j3_oColor");
    same(mangle("Light", a), "Light");
    yes(isReserved("texture") && isReserved("attribute") && !isReserved("tex") && !isReserved("av_"), "isReserved");

    let st = StageText { title: "f.P (vertex)", structs: List<string>.new(a), io: List<string>.new(a), uniforms: List<string>.new(a),
        consts: List<string>.new(a), fns: List<string>.new(a), main: "void main() {\n}\n" };
    st.structs.push("struct V {\n    vec2 pos;\n};\n");
    st.io.push("layout(location=0) in vec2 a_v_pos;");
    st.uniforms.push("uniform sampler2D tex;");
    st.fns.push("// f.j3:22\nVy vs(V v) {\n}\n");
    let src = st.render(a);
    same(src, "#version 330 core\n// f.P (vertex)\nstruct V {\n    vec2 pos;\n};\nlayout(location=0) in vec2 a_v_pos;\nuniform sampler2D tex;\n// f.j3:22\nVy vs(V v) {\n}\nvoid main() {\n}\n");
    same(prepEs(src, a), "#version 300 es\n// f.P (vertex)\nprecision highp float;precision highp int;precision highp sampler2D;struct V {\n    vec2 pos;\n};\nlayout(location=0) in vec2 a_v_pos;\nuniform sampler2D tex;\n// f.j3:22\nVy vs(V v) {\n}\nvoid main() {\n}\n");
    same(prepEs("void main() {}", a), "#version 300 es\nprecision highp float;precision highp int;void main() {}");
    same(prepEs("// c\n\n/* d */\n#define X 1\n#if X\nuniform sampler2DShadow s;uniform usampler3D t;\n#endif\n", a),
        "#version 300 es\n// c\n\n/* d */\n#define X 1\nprecision highp float;precision highp int;precision highp sampler2D;precision highp sampler3D;precision highp sampler2DShadow;precision highp usampler3D;#if X\nuniform sampler2DShadow s;uniform usampler3D t;\n#endif\n");
    same(prepEs("  #version 330\n/* a */ int x;\n", a), "#version 300 es\nprecision highp float;precision highp int;/* a */ int x;\n");
    same(prepEs("// only a comment", a), "#version 300 es\n// only a commentprecision highp float;precision highp int;");
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;
    types(a);
    operators(a);
    text(a);
}
