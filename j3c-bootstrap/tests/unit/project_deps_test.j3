// `project/deps`: Rust's `dep_tools` / `dep_tool_errors` cases, path deps (transitive, `src/` roots, clashes,
// cycles, names), `j3.lock` reading, and a git dep served from the lock and the cache (no network: `git`
// never runs). Every error is also compared with `stage0/j3c check` on the same tree, byte for byte.
module project_deps_test;

use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, contains };
use j3c.project.deps;
use j3c.project.deps.distProvider;
use j3c.project.manifest;
use j3c.project.manifest.{ Input, Manifest };

fn put(dir: string, rel: string, text: string, arena: &Arena) {
    let p = path.join(dir, rel, arena);
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a fixture"); } }
}

fn check(c: bool, what: string) { if !c { panic(what); } }

fn real(p: string, arena: &Arena): string {
    return match path.realpath(p, arena) { Option.Some(r) { r } Option.None { panic(p) } };
}

/// A game at `<d>/game` depending on the package `<d>/tp` (whose `j3.toml` ends with `tables`) and the
/// plain folder `<d>/plain` (Rust `tool_fixture`).
fn fixture(root: string, tag: string, tables: string, files: []string, arena: &Arena): string {
    let d = path.join(root, tag, arena);
    put(d, "game/src/main.j3", "", arena);
    put(d, "tp/src/tp.j3", "", arena);
    for i in 0..files.len { if files[i].len > 0 { put(d, files[i], "", arena); } }
    put(d, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\nplain = \"../plain\"\n", arena);
    io.makeDirs(path.join(d, "plain", arena));
    put(d, "tp/j3.toml", Text.new(arena).add("[package]\nname = \"tp\"\n").add(tables).str(), arena);
    return d;
}

fn load(game: string, arena: &Arena): Result<Manifest, string> {
    match manifest.resolve(game, arena)? {
        Input.Project(m) { return Result.Ok(m); }
        _ { panic("not a project"); return Result.Err(""); }
    }
}

/// `game` fails to load with an error containing `part`, and with exactly what `stage0/j3c check` says.
fn fails(game: string, part: string, arena: &Arena): string {
    let e = match load(game, arena) { Result.Ok(_) { panic(Text.new(arena).add("should fail: ").add(game).str()) } Result.Err(e) { e } };
    if !contains(e, part) {
        printLn(e);
        panic(part);
    }
    let rust = match proc.run(["stage0/j3c", "check", game], "", arena) { Result.Ok(o) { o } Result.Err(_) { panic("cannot run stage0/j3c") } };
    let want = Text.new(arena).add("j3c: ").add(e).add("\n").str();
    if rust.code != 1 || rust.errStr() != want {
        printLn(`ours: {e}`);
        printLn(Text.new(arena).add("rust: ").add(rust.errStr()).str());
        panic("error differs from stage 0");
    }
    return e;
}

fn main() {
    let arena = Arena.create(1 << 22);
    let a = &arena;
    let tmp = real(match io.tempDir("", "j3boot_deps_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } }, a);

    // dep_tools
    let d = fixture(tmp, "ok", "[commands]\ncheck = \"tools/check.j3\"\nup-load_2 = { file = \"tools/up.j3\", help = \"build, then print\" }\n[dist_outputs]\nfake = \"tools/dist.j3\"\n", ["tp/tools/check.j3", "tp/tools/up.j3", "tp/tools/dist.j3"], a);
    let m = match load(path.join(d, "game", a), a) { Result.Ok(m) { m } Result.Err(e) { panic(e) } };
    check(m.deps.len == 2 && m.deps.items[0].name == "tp" && m.deps.items[1].name == "plain", "deps order");
    let tp = m.deps.items[0];
    let pkg = path.join(d, "tp", a);
    check(tp.pkgRoot == pkg && tp.root == path.join(pkg, "src", a), "tp roots");
    check(tp.commands.len == 2, "commands");
    let c0 = tp.commands.items[0];
    let c1 = tp.commands.items[1];
    check(c0.name == "check" && c0.file == path.join(pkg, "tools/check.j3", a) && !c0.hasHelp, "command 0");
    check(c1.name == "up-load_2" && c1.file == path.join(pkg, "tools/up.j3", a) && c1.hasHelp && c1.help == "build, then print", "command 1");
    check(tp.distOutputs.len == 1, "dist outputs");
    let (who, tool) = distProvider(&m.deps, "fake");
    check(who == 0 && m.deps.items[who].distOutputs.items[tool].file == path.join(pkg, "tools/dist.j3", a), "distProvider");
    let (none, _) = distProvider(&m.deps, "nope");
    check(none < 0, "distProvider none");
    let plain = m.deps.items[1];
    check(plain.commands.len == 0 && plain.distOutputs.len == 0 && plain.pkgRoot == plain.root, "plain dep");
    // `build_outputs` naming a dep's dist output is fine
    put(d, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\n[dist]\nbuild_outputs = [\"fake\"]\n", a);
    match load(path.join(d, "game", a), a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }

    // dep_tool_errors
    fails(path.join(fixture(tmp, "missing", "[commands]\ncheck = \"tools/check.j3\"\n", [""], a), "game", a), "tp/j3.toml:4: package `tp` [commands] check: no file `tools/check.j3`", a);
    fails(path.join(fixture(tmp, "list", "[dist_outputs]\nx = [\"a.j3\"]\n", [""], a), "game", a), "package `tp` [dist_outputs] x: must be a string", a);
    fails(path.join(fixture(tmp, "nofile", "[commands]\nx = { help = \"h\" }\n", [""], a), "game", a), "[commands] x: no `file`", a);
    fails(path.join(fixture(tmp, "badkey", "[commands]\nx = { file = \"a.j3\", run = \"y\" }\n", ["tp/a.j3"], a), "game", a), "[commands] x: unknown key `run`", a);
    fails(path.join(fixture(tmp, "subtable", "[commands.check]\nfile = \"a.j3\"\n", ["tp/a.j3"], a), "game", a), "tp/j3.toml:3: package `tp` [commands.check]: sub-tables are not read; under [commands] write `check = {", a);
    fails(path.join(fixture(tmp, "twice", "[commands]\nx = \"a.j3\"\nx = \"a.j3\"\n", ["tp/a.j3"], a), "game", a), "[commands] x: listed twice", a);
    let dup = fixture(tmp, "dup", "[dist_outputs]\nfake = \"a.j3\"\n", ["tp/a.j3", "tq/a.j3", "tq/src/tq.j3"], a);
    put(dup, "tq/j3.toml", "[package]\nname = \"tq\"\n[dist_outputs]\nfake = { file = \"a.j3\" }\n", a);
    put(dup, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\ntq = \"../tq\"\n", a);
    let de = fails(path.join(dup, "game", a), "[dist_outputs] fake: provided by both `tp`", a);
    check(contains(de, "and `tq`"), "dup tq");

    // path deps: shapes, names, clashes, cycles, one name one path, [package] name and j3 bounds
    let p = fixture(tmp, "paths", "", [""], a);
    let game = path.join(p, "game", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\nnope = \"../nope\"\n", a);
    fails(game, "game/j3.toml:4: [dependencies] nope: path `../nope` is not a directory (looked for ", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = [\"x\"]\n", a);
    fails(game, "[dependencies] tp: write `tp = { path = \"path/to/dir\" }` or `tp = { git = \"URL\", tag = \"v1.0\" }`", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = { dir = \"../tp\" }\n", a);
    fails(game, "write `tp = { path", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\nj3 = \"../tp\"\n", a);
    fails(game, "[dependencies] j3: `j3` is not a usable module name (letters, digits, `_`; not `j3`)", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\nt-p = \"../tp\"\n", a);
    fails(game, "`t-p` is not a usable module name", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\ntp = { path = \"../tp\" }\n", a);
    fails(game, "game/j3.toml:5: [dependencies] tp: listed twice", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ngame = \"../tp\"\n", a);
    fails(game, "[dependencies] game: clashes with a module of this project (`use game...`); rename the dep", a);
    put(p, "game/src/tp.j3", "", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\n", a);
    fails(game, "[dependencies] tp: clashes with a module of this project", a);
    io.remove(path.join(p, "game/src/tp.j3", a));
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\nother = \"../tp\"\n", a);
    fails(game, "says [package] name = \"tp\"; the key here must match it (or drop the name)", a);
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\nj3 = \"0.4\"\n", a);
    put(p, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = \"../tp\"\n", a);
    fails(game, "[dependencies] tp: `j3 = \"0.4\"`: write `>=X.Y` (the oldest j3c it needs)", a);
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\nj3 = \">=0.x\"\n", a);
    fails(game, "`j3 = \">=0.x\"`: not a version", a);
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\nj3 = \">=99.0\"\n", a);
    fails(game, "needs j3c >=99.0, this is 0.1.0; update j3c", a);
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\nj3 = \">= +0.1\"\n", a);
    match load(game, a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    // a cycle: tp -> tq -> tp
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\n[dependencies]\ntq = \"../tq\"\n", a);
    put(p, "tq/j3.toml", "[package]\nname = \"tq\"\n[dependencies]\ntp = \"../tp\"\n", a);
    put(p, "tq/src/tq.j3", "", a);
    fails(game, "tq/j3.toml:4: [dependencies] tp: dependency cycle tp -> tq -> tp", a);
    // one name, two paths
    put(p, "tq/j3.toml", "[package]\nname = \"tq\"\n[dependencies]\nplain = \"../plain\"\n", a);
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\n[dependencies]\ntq = \"../tq\"\nplain = \"src\"\n", a);
    fails(game, "; one name needs one path", a);
    // transitive and flat, each name once
    put(p, "tp/j3.toml", "[package]\nname = \"tp\"\n[dependencies]\ntq = \"../tq\"\nplain = \"../plain\"\n", a);
    match load(game, a) {
        Result.Ok(mm) { check(mm.deps.len == 3 && mm.deps.items[1].name == "tq" && mm.deps.items[2].name == "plain", "transitive"); }
        Result.Err(e) { panic(e); }
    }

    // j3.lock: a bad entry, then a git dep served from the lock and the cache (git never runs)
    let g = fixture(tmp, "git", "", [""], a);
    let ggame = path.join(g, "game", a);
    let commit = "0123456789abcdef0123456789abcdef01234567";
    sys.setenv("J3_PKG_DIR", path.join(g, "cache", a));
    put(g, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = { git = \"../tp\", tag = \"v1\" }\n", a);
    put(g, "game/j3.lock", "[tp]\ngit = \"x\"\nref = \"tag:v1\"\ncommit = \"abc\"\n", a);
    fails(ggame, "game/j3.lock: [tp] has no commit; delete the file or run `j3c update`", a);
    put(g, "game/j3.lock", "[tp]\ngit = x\n  = 1\n", a);
    fails(ggame, "game/j3.lock:3: ", a);
    let lock = Text.new(a).add("# Written by j3c: the commit each git dependency builds from. Commit this file.\n# `j3c update [name]` moves deps to the newest commit of their tag/branch.\n\n[tp]\ngit = \"").add(path.join(g, "tp", a)).add("\"\nref = \"tag:v1\"\ncommit = \"").add(commit).add("\"\n").str();
    put(g, "game/j3.lock", lock, a);
    put(g, "cache/tp-0123456789ab/src/tp.j3", "", a);
    put(g, "cache/tp-0123456789ab/j3.toml", "[package]\nname = \"tp\"\n", a);
    match load(ggame, a) {
        Result.Ok(mg) { check(mg.deps.len == 1 && mg.deps.items[0].root == path.join(g, "cache/tp-0123456789ab/src", a), "git dep from cache"); }
        Result.Err(e) { panic(e); }
    }
    match io.readFile(path.join(ggame, "j3.lock", a), a) { Result.Ok(b) { check(b as string == lock, "lock kept"); } Result.Err(_) { panic("lock"); } }
    // the URL must exist (a local one is made absolute); NO_FETCH stops before cloning
    put(g, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = { git = \"../nope\" }\n", a);
    fails(ggame, "[dependencies] tp: git `../nope`: No such file or directory (os error 2)", a);
    put(g, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = { git = \"../tp\", tag = \"v1\", rev = \"x\" }\n", a);
    fails(ggame, "(one of tag, rev, branch; or none for the default branch)", a);
    put(g, "game/j3.toml", "[package]\nname = \"game\"\n[dependencies]\ntp = { git = \"../tp\", branch = \"main\" }\n", a);
    deps.setNoFetch(true);
    match load(ggame, a) { Result.Ok(_) { panic("no fetch"); } Result.Err(e) { check(contains(e, "[dependencies] tp: `tp` is not downloaded yet; run `j3c fetch`"), e); } }
    deps.setNoFetch(false);
    // `unlock`
    match deps.unlock(ggame, Option.Some("zz"), a) { Result.Ok(_) { panic("unlock zz"); } Result.Err(e) { check(e == "j3.lock has no `zz` (only git deps are locked)", e); } }
    match deps.unlock(ggame, Option.Some("tp"), a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    check(!io.exists(path.join(ggame, "j3.lock", a)), "unlock removes the lock");
    printLn("project_deps: ok");
}
