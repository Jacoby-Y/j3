// The toolchain compiles and runs `target/j3c dump-llvm FILE` (held to the Rust compiler's text by
// `diff.sh llvm`) for every C2a corpus file (`toolchain_corpus.txt`), and the program prints what
// `tests/expect/run/FILE.out` (`diff.sh run`'s expected `run --headless --frames 3` output) holds: stdout,
// then `--- exit N`. Everything runs from the repo root (as `diff.sh` does): inside j3c-bootstrap/ j3c would
// build the j3c-bootstrap project instead of the file.
module toolchain_run_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, lines, startsWith, trim };
use j3c.base.fsx;
use j3c.toolchain;
use j3c.toolchain.{ defaultEmitOpts, discard };

fn main() {
    let mem = Arena.create(1 << 20);
    defer mem.destroy();
    let list = "";
    match fsx.readText("tests/unit/toolchain_corpus.txt", &mem) {
        Result.Ok(t) { list = t; }
        Result.Err(e) { panic(e); }
    }
    let up: [3]u8 = ['.', '.', 0];
    if sys.chdir(&up[0] as ptr) < 0 { panic("chdir .."); }
    let n = 0;
    let it = lines(list);
    while true {
        match it.next() {
            Option.Some(l) {
                let f = trim(l);
                if f.len == 0 || startsWith(f, "#") { continue; }
                one(f, &mem);
                n += 1;
            }
            Option.None { break; }
        }
    }
    if n == 0 { panic("empty corpus"); }
}

/// Compare one file; panics with the file and both outputs on a difference.
fn one(file: string, mem: &Arena) {
    let dump: [3]string = ["j3c-bootstrap/target/j3c", "dump-llvm", file];
    let ll = "";
    match proc.run(dump[..], "", mem) {
        Result.Ok(o) {
            if o.code != 0 { panic(Text.new(mem).add(file).add(": dump-llvm failed\n").add(o.errStr()).str()); }
            ll = o.outStr();
        }
        Result.Err(_) { panic("cannot run j3c-bootstrap/target/j3c"); }
    }
    sys.setenv("SDL_VIDEODRIVER", "offscreen");
    sys.setenv("SDL_AUDIODRIVER", "dummy");
    let want = match fsx.readText(Text.new(mem).add("j3c-bootstrap/tests/expect/run/").add(file).add(".out").str(), mem) {
        Result.Ok(t) { t }
        Result.Err(x) { panic(x) }
    };
    let e = defaultEmitOpts(mem);
    let exe = "";
    match toolchain.compileText(ll, &e, mem) {
        Result.Ok(p) { exe = p; }
        Result.Err(x) { panic(Text.new(mem).add(file).add(": ").add(x).str()); }
    }
    let none = dump[0..0];
    sys.setenv("J3_FRAMES", "3");
    match toolchain.runExe(exe, "", none[..], mem) {
        Result.Ok(r) {
            discard(exe);
            let got = Text.new(mem).add(r.stdout).add("--- exit ");
            got.pushInt(r.status);
            got.add("\n");
            if got.str() != want {
                let t = Text.new(mem);
                t.add(file).add(": stdout/exit differ\n--- expected\n").add(want).add("--- toolchain\n").add(got.str()).add(r.stderr);
                panic(t.str());
            }
        }
        Result.Err(x) { panic(Text.new(mem).add(file).add(": ").add(x).str()); }
    }
}
