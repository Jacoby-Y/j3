// `lower` on `dyn` names shared by modules: the project `tests/unit/lower_dyn_cases/scope` (four modules
// each declaring a trait `Shape`, two a trait `Zed`; `dyn Shape` and `dyn Zed` each written once) gets one
// fat-pointer struct per module scope name bound to a written trait, as Rust `dyn_types` makes them: the
// `struct dyn ..` lines of the IR dump equal `tests/unit/expect/lower_dyn_scope.ir` (frozen from the Rust
// compiler's `dump-ir`, plan 15), in order. The fixture also
// declares a payload enum nothing names: the LLVM printer needs its type interned at the declaration.
module lower_dyn_scope_test;

use j3.io.printLn;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use unitkit;

const PROJECT = "j3c-bootstrap/tests/unit/lower_dyn_cases/scope";

/// The `struct dyn ..` lines of an IR dump, in order.
fn dynStructs(s: string, out: &Text): int {
    let n = 0;
    let at = 0;
    for i in 0..s.len + 1 {
        if i < s.len && s[i] != 10 { continue; }
        let line = s[at..i];
        at = i + 1;
        if line.len >= 11 && line[0..11] == "struct dyn " {
            out.add(line).add("\n");
            n += 1;
        }
    }
    return n;
}

fn main() {
    let up: [3]u8;
    up[0] = 46;
    up[1] = 46;
    if sys.chdir(&up[0] as ptr) != 0 { panic("cannot cd to the repo root"); }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = PROJECT;
    let s = Session.new(opts);
    defer s.free();
    if !driver.run(s, Stage.Passes) {
        printLn(failText(s));
        panic("lower or validate failed");
    }
    let ours = Text.new(s.arena);
    if !driver.dumpIr(s, &ours) { panic("dump-ir failed"); }
    let ll = Text.new(s.arena);
    if !driver.emitLlvm(s, &ll) {
        printLn(failText(s));
        panic("emit LLVM failed (an unused payload enum's type must be interned)");
    }
    let got = Text.new(s.arena);
    if dynStructs(ours.str(), &got) != 6 { printLn(got.str()); panic("the fixture should make 6 `dyn` structs"); }
    unitkit.expect(got.str(), "lower_dyn_scope.ir", "`dyn` structs differ from tests/unit/expect/lower_dyn_scope.ir");
    printLn("lower dyn scope ok");
}
