// `ir.halfFromF64` (f64 to IEEE binary16 bits): Rust's `ir/half.rs` unit test values plus the edges
// (subnormals, ties to even, overflow, infinities, NaN payload, negatives).
module ir_half_test;

use j3.sys.panic;
use j3c.ir.halfFromF64;

fn f64From(bits: u64): f64 {
    let b = bits;
    let v: []f64 = @slice(&b as ptr, 1);
    return v[0];
}

fn pow2(e: int): f64 {
    let v = 1.0;
    let n = e;
    while n > 0 { v = v * 2.0; n -= 1; }
    while n < 0 { v = v / 2.0; n += 1; }
    return v;
}

fn eq(d: f64, want: int, what: string) {
    let got = int(halfFromF64(d));
    if got != want { panic(`{what}: got {got}, want {want}`); }
}

fn main() {
    eq(0.0, 0, "0");
    eq(-0.0, 0x8000, "-0");
    eq(1.0, 0x3c00, "1");
    eq(-2.0, 0xc000, "-2");
    eq(65504.0, 0x7bff, "max");
    eq(65520.0, 0x7c00, "overflow tie");
    eq(65519.9, 0x7bff, "just under overflow");
    eq(1e30, 0x7c00, "big");
    eq(-1e30, 0xfc00, "-big");
    eq(1e-8, 0, "tiny");
    eq(pow2(-24), 1, "smallest subnormal");
    eq(pow2(-25), 0, "half of smallest: tie to even 0");
    eq(pow2(-25) * 1.0000001, 1, "just over half of smallest");
    eq(pow2(-24) * 1.5, 2, "subnormal tie to even up");
    eq(pow2(-24) * 2.5, 2, "subnormal tie to even down");
    eq(pow2(-14) - pow2(-24), 0x03ff, "largest subnormal");
    eq(pow2(-14) - pow2(-25), 0x0400, "subnormal rounds up to normal");
    eq(pow2(-14), 0x0400, "smallest normal");
    eq(1.0 + pow2(-11), 0x3c00, "tie to even down");
    eq(1.0 + 3.0 * pow2(-11), 0x3c02, "tie to even up");
    eq(0.1, 0x2e66, "0.1");
    eq(-1.5, 0xbe00, "-1.5");
    eq(f64From(0x7ff0000000000000), 0x7c00, "inf");
    eq(f64From(0xfff0000000000000), 0xfc00, "-inf");
    eq(f64From(0x7ff8000000000000), 0x7e00, "nan");
    eq(f64From(0xfff8000000000000), 0xfe00, "-nan");
    eq(f64From(0x7ff4000000000000), 0x7f00, "nan payload top bits kept, quiet bit set");
    eq(f64From(0x0000000000000001), 0, "f64 subnormal");
    eq(f64From(0x8000000000000001), 0x8000, "negative f64 subnormal");
}
