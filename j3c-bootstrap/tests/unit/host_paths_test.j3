// Plan 08 chunks 1-3 on every host: the host triple per OS/arch, `cacheRoot`'s variable order (a Windows-only
// environment gives `...\j3`), `exeName`, and a backslashed stdlib path finding its embedded file.
module host_paths_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.sys;
use j3.sys.panic;
use j3c.base.fsx;
use j3c.base.triple.{ hostTriple, isHost, resolveTriple, tripleFor };
use j3c.load;
use j3c.project.config.cacheRootIn;
use j3c.project.manifest.exeName;

fn expect(got: string, want: string) {
    if got != want {
        printLn(`got  {got}`);
        printLn(`want {want}`);
        panic("mismatch");
    }
}

fn root(o: Option<string>): string {
    match o { Option.Some(s) { return s; } Option.None { return "<none>"; } }
}

fn main() {
    let a = Arena.create(1 << 16);

    expect(tripleFor(sys.PLATFORM_LINUX, sys.ARCH_X86_64), "x86_64-pc-linux-gnu");
    expect(tripleFor(sys.PLATFORM_LINUX, sys.ARCH_AARCH64), "aarch64-unknown-linux-gnu");
    expect(tripleFor(sys.PLATFORM_WINDOWS, sys.ARCH_X86_64), "x86_64-pc-windows-gnu");
    expect(tripleFor(sys.PLATFORM_MACOS, sys.ARCH_AARCH64), "arm64-apple-macosx11.0.0");
    expect(resolveTriple(""), hostTriple());
    expect(resolveTriple("x86_64-pc-windows-gnu"), "x86_64-pc-windows-gnu");
    if !isHost("") || !isHost(hostTriple()) { panic("isHost"); }

    expect(root(cacheRootIn(fn(n: string): string { if n == "LOCALAPPDATA" { return "C:\\Users\\jo\\AppData\\Local"; } return ""; }, &a)),
        "C:\\Users\\jo\\AppData\\Local\\j3");
    expect(root(cacheRootIn(fn(n: string): string { if n == "USERPROFILE" { return "C:\\Users\\jo"; } return ""; }, &a)),
        "C:\\Users\\jo\\AppData\\Local\\j3");
    expect(root(cacheRootIn(fn(n: string): string {
        if n == "HOME" { return "/home/jo"; }
        if n == "LOCALAPPDATA" { return "C:\\L"; }
        return "";
    }, &a)), "/home/jo/.cache/j3");
    expect(root(cacheRootIn(fn(n: string): string {
        if n == "XDG_CACHE_HOME" { return "/x"; }
        if n == "HOME" { return "/home/jo"; }
        return "";
    }, &a)), "/x/j3");
    expect(root(cacheRootIn(fn(n: string): string {
        if n == "J3_CACHE" { return "/c"; }
        if n == "XDG_CACHE_HOME" { return "/x"; }
        return "";
    }, &a)), "/c");
    expect(root(cacheRootIn(fn(n: string): string { return ""; }, &a)), "<none>");

    expect(exeName("game", "x86_64-pc-windows-gnu", &a), "game.exe");
    expect(exeName("game", "x86_64-pc-linux-gnu", &a), "game");

    expect(fsx.slashed("C:\\a\\b/c", &a), "C:/a/b/c");
    let p = "C:\\j3\\stdlib\\j3\\gfx\\canvas.j3";
    let name = root(load.embeddedName(p, "C:\\j3\\stdlib", &a));
    expect(name, "gfx/canvas.j3");
    match load.stdlibFile(name) { Option.Some(_) {} Option.None { panic("gfx/canvas.j3 is not embedded"); } }
    expect(root(load.embeddedName("C:\\elsewhere\\j3\\x.j3", "C:\\j3\\stdlib", &a)), "<none>");
    printLn("host_paths ok");
}
