// `base/text_fmt`: Rust `{:?}` of f64, str and char (expected text printed by rustc 1.97.1), the
// string-literal escaper and the ASCII helpers.
module base_text_fmt_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.base.text_fmt.{ debugChar, debugF32, debugF64, debugStr, hasLower, hexVal, pushEscaped };

fn f64Is(a: &Arena, x: f64, want: string) {
    let t = Text.new(a);
    debugF64(&t, x, a);
    if t.str() != want { printLn(t.str()); panic(want); }
}

fn f32Is(a: &Arena, x: f32, want: string) {
    let t = Text.new(a);
    debugF32(&t, x, a);
    if t.str() != want { printLn(t.str()); panic(want); }
}

/// Expected text printed by rustc (`{:?}` of `from_bits`): exact ties (Rust rounds up, Ryu to even),
/// subnormals, powers of two, the `1e-5` / `1e16` layout switches, the largest values.
fn floats(ap: &Arena) {
    f32Is(ap, text.f32FromBits(0x4a3adf99), "3061734.3");
    f32Is(ap, text.f32FromBits(0x4a3adf9b), "3061734.8");
    f32Is(ap, text.f32FromBits(0x4a000001), "2097152.3");
    f32Is(ap, text.f32FromBits(0x4a7fffff), "4194303.8");
    f32Is(ap, text.f32FromBits(0x3e810000), "0.25195313");
    f32Is(ap, text.f32FromBits(0x3e830000), "0.25585938");
    f32Is(ap, text.f32FromBits(0x3ec10000), "0.37695313");
    f32Is(ap, text.f32FromBits(0x43010080), "129.00195");
    f32Is(ap, text.f32FromBits(0x3f800001), "1.0000001");
    f32Is(ap, text.f32FromBits(0x49000002), "524288.1");
    f32Is(ap, text.f32FromBits(0x49000006), "524288.4");
    f32Is(ap, text.f32FromBits(0x49800001), "1048576.1");
    f32Is(ap, text.f32FromBits(0x49800007), "1048576.9");
    f32Is(ap, text.f32FromBits(0x48800002), "262144.06");
    f32Is(ap, text.f32FromBits(0x3e010000), "0.12597656");
    f32Is(ap, text.f32FromBits(0x5ad98c9f), "3.0617342e16");
    f32Is(ap, text.f32FromBits(0x39a085e7), "0.00030617343");
    f32Is(ap, text.f32FromBits(0x1), "1e-45");
    f32Is(ap, text.f32FromBits(0x7fffff), "1.1754942e-38");
    f32Is(ap, text.f32FromBits(0x800000), "1.1754944e-38");
    f32Is(ap, text.f32FromBits(0x33d6bf95), "1e-7");
    f32Is(ap, text.f32FromBits(0x5a0e1bca), "1e16");
    f32Is(ap, text.f32FromBits(0x4b18967f), "9999999.0");
    f32Is(ap, text.f32FromBits(0x4b800000), "16777216.0");
    f32Is(ap, text.f32FromBits(0x4b800001), "16777218.0");
    f32Is(ap, text.f32FromBits(0x7f7fffff), "3.4028235e38");
    f32Is(ap, text.f32FromBits(0x3e99999a), "0.3");
    f32Is(ap, text.f32FromBits(0x4b000000), "8388608.0");
    f32Is(ap, text.f32FromBits(0x4b000002), "8388610.0");
    f32Is(ap, text.f32FromBits(0x4a800001), "4194304.5");
    f32Is(ap, text.f32FromBits(0x4a800003), "4194305.5");
    f32Is(ap, text.f32FromBits(0x1), "1e-45");
    f32Is(ap, text.f32FromBits(0x5), "7e-45");
    f32Is(ap, text.f32FromBits(0x4c000000), "33554432.0");
    f32Is(ap, text.f32FromBits(0x3727c5ac), "1e-5");
    f32Is(ap, text.f32FromBits(0x38d1b717), "0.0001");
    f32Is(ap, text.f32FromBits(0x58635fa9), "1000000000000000.0");
    f32Is(ap, text.f32FromBits(0x501502f9), "10000000000.0");
    f32Is(ap, text.f32FromBits(0x0), "0.0");
    f32Is(ap, text.f32FromBits(0x2f800000), "2.3283064e-10");
    f32Is(ap, text.f32FromBits(0x2d800000), "1.4551915e-11");
    f32Is(ap, text.f32FromBits(0x38800000), "6.1035156e-5");
    f32Is(ap, text.f32FromBits(0x65a96816), "1e23");
    f32Is(ap, text.f32FromBits(0x5a0e1bc9), "9999999000000000.0");
    f32Is(ap, text.f32FromBits(0x3dcccccd), "0.1");
    f32Is(ap, text.f32FromBits(0x4f000000), "2147483600.0");
    f32Is(ap, text.f32FromBits(0x4f800000), "4294967300.0");
    f64Is(ap, text.f64FromBits(0x4310000000000001), "1125899906842624.3");
    f64Is(ap, text.f64FromBits(0x4310000000000003), "1125899906842624.8");
    f64Is(ap, text.f64FromBits(0x4320000000000001), "2251799813685248.5");
    f64Is(ap, text.f64FromBits(0x4320000000000003), "2251799813685249.5");
    f64Is(ap, text.f64FromBits(0x4330000000000002), "4503599627370498.0");
    f64Is(ap, text.f64FromBits(0x4300000000000001), "562949953421312.1");
    f64Is(ap, text.f64FromBits(0x4300000000000003), "562949953421312.4");
    f64Is(ap, text.f64FromBits(0x1), "5e-324");
    f64Is(ap, text.f64FromBits(0x7fefffffffffffff), "1.7976931348623157e308");
    f64Is(ap, text.f64FromBits(0x10000000000000), "2.2250738585072014e-308");
    f64Is(ap, text.f64FromBits(0x44b52d02c7e14af6), "1e23");
    f64Is(ap, text.f64FromBits(0x4340000000000000), "9007199254740992.0");
    f64Is(ap, text.f64FromBits(0x3fd3333333333333), "0.3");
    f64Is(ap, text.f64FromBits(0x3e7ad7f29abcaf48), "1e-7");
    f64Is(ap, text.f64FromBits(0x4480f0cf064dd592), "1e22");
    f64Is(ap, text.f64FromBits(0x42f0000000000000), "281474976710656.0");
    f64Is(ap, text.f64FromBits(0x42d0000000000001), "70368744177664.02");
}

fn main() {
    let a = Arena.create(1 << 16);
    let ap = &a;
    let zero: f64 = 0.0;
    f64Is(ap, 0.35, "0.35");
    f64Is(ap, 1.0, "1.0");
    f64Is(ap, 0.05, "0.05");
    f64Is(ap, zero / zero, "NaN");
    f64Is(ap, 1e16, "1e16");
    f64Is(ap, 1.5e-7, "1.5e-7");
    f64Is(ap, 123.0, "123.0");
    f64Is(ap, -zero, "-0.0");
    f64Is(ap, 1e-4, "0.0001");
    f64Is(ap, 0.1 + 0.2, "0.30000000000000004");
    f64Is(ap, 1.0 / zero, "inf");
    f64Is(ap, -1.0 / zero, "-inf");
    f64Is(ap, 9999999999999998.0, "9999999999999998.0");
    f64Is(ap, 1e-5, "1e-5");
    floats(ap);

    let src = Text.new(ap);
    src.add("a\"b'");
    src.pushChar(0xfe0f);
    src.add("\n");
    src.pushChar(0x7f);
    src.add("é");
    let s = Text.new(ap);
    debugStr(&s, src.str());
    if s.str() != "\"a\\\"b'\\u{fe0f}\\n\\u{7f}é\"" { printLn(s.str()); panic("debugStr"); }
    let c = Text.new(ap);
    debugChar(&c, '"');
    debugChar(&c, '\'');
    debugChar(&c, 0xf42c);
    debugChar(&c, 0x378);
    debugChar(&c, 0xe9);
    if c.str() != "'\"''\\'''\\u{f42c}''\\u{378}''é'" { printLn(c.str()); panic("debugChar"); }

    let e = Text.new(ap);
    pushEscaped(&e, "a\\\"\n", false);
    pushEscaped(&e, "\n", true);
    if e.str() != "a\\\\\\\"\n\\n" { printLn(e.str()); panic("pushEscaped"); }

    if !hasLower("x86_64-PC-Windows-gnu", "windows") || hasLower("linux", "windows") || !hasLower("ab", "") { panic("hasLower"); }
    if hexVal('f') != 15 || hexVal('A') != 10 || hexVal('7') != 7 || hexVal('g') != -1 { panic("hexVal"); }
    printLn("base_text_fmt ok");
}
