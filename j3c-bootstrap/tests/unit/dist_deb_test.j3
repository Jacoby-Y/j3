// dist/deb (Rust deb.rs tests): package names, title case, Debian arches, library stems and packages, the
// `ar` layout, the PNG header reader; the desktop entry and launcher text (byte-equal with Rust's format).
module dist_deb_test;

use j3.io;
use j3.memory.{ Arena, List };
use j3.proc;
use j3.sys;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, endsWith, startsWith };
use j3c.dist.deb;
use j3c.dist.fs;
use j3c.project.manifest.parseManifest;

fn eq(got: string, want: string) {
    if got != want {
        let a = Arena.create(1 << 10);
        panic(Text.new(&a).add("got `").add(got).add("`, want `").add(want).add("`").str());
    }
}

fn main() {
    let arena = Arena.create(1 << 16);
    defer arena.destroy();
    eq(deb.packageName("Blocks_Adventure!", &arena), "blocks-adventure");
    eq(deb.titleCase("blocks-adventure_2", &arena), "Blocks Adventure 2");
    eq(deb.titleCase("--a__b-", &arena), "A B");
    eq(deb.debArch("x86_64-pc-linux-gnu"), "amd64");
    eq(deb.debArch("aarch64-unknown-linux-gnu"), "arm64");
    eq(deb.debArch("i686-pc-linux-gnu"), "i386");
    eq(deb.debArch("mips-x"), "mips");
    eq(deb.debArch(""), "amd64");
    eq(deb.libStem("libSDL2_ttf-2.0.so.0"), "SDL2_ttf");
    eq(deb.libStem("libGL.so.1"), "GL");
    eq(deb.libPackage(deb.libStem("libSDL2-2.0.so.0")), "libsdl2-2.0-0");
    eq(deb.libPackage(deb.libStem("ld-linux-x86-64.so.2")), "libc6");
    eq(deb.libPackage("nope"), "");

    // ar layout
    let b = List<u8>.new(&arena);
    let names: [2]string = ["debian-binary", "x"];
    let datas: [2][]u8 = ["2.0\n" as []u8, "abc" as []u8];
    deb.ar(&b, names[..], datas[..], 1700000000, &arena);
    let s = b.items[0..b.len] as string;
    if !startsWith(s, "!<arch>\ndebian-binary   1700000000  0     0     100644  4         `\n") { panic(s); }
    if s[8 + 58..8 + 60] != "`\n" || s[8 + 48..8 + 58] != "4         " { panic("ar header fields"); }
    // second member starts after header + 4 bytes; its 3 bytes get one pad byte
    if b.len != 8 + 60 + 4 + 60 + 3 + 1 { panic("ar length"); }

    // png header
    match deb.pngSize(fs.logoPng()) {
        Option.Some(wh) { if wh.0 != 256 || wh.1 != 256 { panic("logo size"); } }
        Option.None { panic("logo is not a PNG"); }
    }
    let hdr: [24]u8 = [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 'I', 'H', 'D', 'R', 0, 0, 0, 2, 0, 0, 1, 3];
    match deb.pngSize(hdr[..]) {
        Option.Some(wh) { if wh.0 != 2 || wh.1 != 259 { panic("png size"); } }
        Option.None { panic("hand-made header refused"); }
    }
    match deb.pngSize("nope" as []u8) {
        Option.Some(_) { panic("nope is a PNG"); }
        Option.None {}
    }

    // desktop entry and launcher
    let toml = "[package]\nname = \"my_game\"\ndescription = \"Fun\"\n\n[dist]\ncategories = \"Game;Arcade;\"\n\n[dist.actions]\nnew = { name = \"New\", exec = \"--new\" }\nplain = { name = \"Plain\" }\n";
    let root = Text.new(&arena).add("../target/unit-dist-deb-").fmt(`{sys.getpid()}`).str();
    io.makeDirs(Text.new(&arena).add(root).add("/src").str());
    io.writeFile(Text.new(&arena).add(root).add("/src/main.j3").str(), "" as []u8);
    let m = match parseManifest(toml, root, &arena) {
        Result.Ok(x) { x }
        Result.Err(e) { panic(e); }
    };
    eq(deb.desktop(&m, "icon", &arena), "[Desktop Entry]\nType=Application\nName=My Game\nComment=Fun\nExec=/usr/bin/my_game\nIcon=icon\nTerminal=false\nCategories=Game;Arcade;\nStartupWMClass=my_game\nActions=new;plain;\n\n[Desktop Action new]\nName=New\nExec=/usr/bin/my_game --new\n\n[Desktop Action plain]\nName=Plain\nExec=/usr/bin/my_game\n");
    let l = deb.launcher("g", "g.bin", &arena);
    if !startsWith(l, "#!/bin/sh\n# g reads data") { panic(l); }
    if !endsWith(l, "\nexport SDL_VIDEO_X11_WMCLASS=g SDL_VIDEO_WAYLAND_WMCLASS=g\nexec \"$app/g.bin\" \"$@\"\n") { panic(l); }
    let rm: [3]string = ["rm", "-rf", root];
    proc.run(rm[..], "", &arena);
}
