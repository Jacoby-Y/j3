// The dev-mode IR pass on a scratch copy of `speculative/11_script` (Rust `compile/tests/script_dev.rs` dev
// lowering): `Mode.Dev` through the passes leaves no diagnostics, the rewritten program validates, `j3s_dev` is
// the last module with `register` and at least one thunk, `main` calls `register` first, the script struct is
// one `handle: ptr` field with no props, `pub` script fns are `devCall` stubs, and two runs dump the same IR
// (the `dev.key` text). Then every other dev project of the `bc` corpus lowers and validates (Rust never
// validates dev IR; the port does, so a bad rewrite shows here, not as a VM crash).
module devmode_lower_test;

use j3.io;
use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.devmode;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use j3c.ir.{ FuncKind, Program, StmtKind };
use j3c.ir.validate.validateProgram;

/// Copy `speculative/11_script/REL` into `dir`.
fn copy(dir: string, rel: string, mem: &Arena) {
    let from = Text.new(mem).add("../speculative/11_script/").add(rel).str();
    let to = Text.new(mem).add(dir).add("/").add(rel).str();
    match io.makeDirs(path.dirname(to)) { Result.Ok(_) {} Result.Err(_) { panic("make a case dir"); } }
    match io.readFile(from, mem) {
        Result.Ok(b) { match io.writeFile(to, b) { Result.Ok(_) {} Result.Err(_) { panic("write a case file"); } } }
        Result.Err(_) { panic(Text.new(mem).add("read ").add(from).str()); }
    }
}

/// Checks the lowered program of `dir`; returns its `nativeKey` text (a copy in `out`).
fn lowered(dir: string, out: &Arena): string {
    let o = driver.defaults();
    o.entry = dir;
    o.mode = Mode.Dev;
    o.headless = true;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) || s.diags.hasErrors() { panic("11_script does not lower in dev mode"); }
    match s.program { Option.Some(prog) { return check(prog, s, out); } Option.None { panic("no program"); } }
    return "";
}

fn check(p: &Program, s: &Session, out: &Arena): string {
    match validateProgram(p) { Result.Ok(_) {} Result.Err(e) { panic(e.message); } }
    if s.bytecode.len != 1 { panic("expected one script module of bytecode"); }

    let cx = &p.cx;
    let last = p.modules.items[p.modules.len - 1];
    if last.name.len != 1 || cx.nameStr(last.name.items[0]) != devmode.DEV_MODULE { panic("j3s_dev is not the last module"); }
    let thunks = 0;
    let register = false;
    for i in 0..last.funcs.len {
        let n = cx.nameStr(cx.func(last.funcs.items[i]).name);
        if text.startsWith(n, "thunk_") { thunks += 1; }
        if n == "register" { register = true; }
    }
    if thunks == 0 || !register { panic("j3s_dev lacks thunks or register"); }

    let scripts = 0;
    let ss = cx.allStructs();
    for i in 0..ss.len {
        match ss[i].script {
            Option.Some(meta) {
                scripts += 1;
                if ss[i].fields.len != 1 || cx.nameStr(ss[i].fields.items[0].name) != "handle" || meta.propSpans.len != 0 {
                    panic("a script struct is not { handle: ptr }");
                }
            }
            Option.None {}
        }
    }
    if scripts != 1 { panic("expected one script struct"); }

    let key = devmode.nativeKey(p, s.arena);
    if !text.contains(key, "    devCall(") || !text.contains(key, "devNew(\"scripts/door.j3s\"") || !text.contains(key, "    devRegister(") {
        panic("the dev IR does not call the VM");
    }
    // Only the props a literal names reach `devNew` (`front` names `hinge` alone; `vault` all three).
    if !text.contains(key, "[1]Prop {") || !text.contains(key, "[3]Prop {") { panic("devNew gets the wrong props"); }
    // `main` starts with `register()`.
    let first = p.modules.items[0];
    for i in 0..first.funcs.len {
        let f = cx.func(first.funcs.items[i]);
        if cx.nameStr(f.name) == "main" {
            match f.kind {
                FuncKind.J3(j) {
                    match j.body.block.stmts.items[0].kind { StmtKind.Expr(_) {} _ { panic("main does not start with a call"); } }
                    if !text.contains(key, "\n    register();\n") { panic("main does not call register"); }
                }
                FuncKind.Lib(_) { panic("main is a lib fn"); }
                FuncKind.Decl { panic("main has no body"); }
            }
        }
    }
    return Text.new(out).add(key).str();
}

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-devmode-lower").str();
    copy(dir, "j3.toml", &mem);
    copy(dir, "main.j3", &mem);
    copy(dir, "src/scene.j3", &mem);
    copy(dir, "scripts/door.j3s", &mem);
    let a = lowered(dir, &mem);
    let b = lowered(dir, &mem);
    if a != b { panic("two dev lowerings dump different IR"); }
    // Stage.Passes writes nothing, so these check in place.
    let others = ["../examples/scripted", "../examples/3d-editor-scene", "../j3c/bench/script", "tests/proj/bc_flow", "tests/proj/bc_scalars"];
    for i in 0..others.len { validated(others[i]); }
}

/// `dir` lowers in dev mode (scripts found, `j3s_dev` added) and the result validates.
fn validated(dir: string) {
    let o = driver.defaults();
    o.entry = dir;
    o.mode = Mode.Dev;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) { panic(Text.new(s.arena).add(dir).add(": does not lower in dev mode: ").add(driver.failText(s)).str()); }
    match s.program {
        Option.Some(p) {
            match validateProgram(p) { Result.Ok(_) {} Result.Err(e) { panic(Text.new(s.arena).add(dir).add(": ").add(e.message).str()); } }
            let last = p.modules.items[p.modules.len - 1];
            if s.bytecode.len == 0 || p.cx.nameStr(last.name.items[0]) != devmode.DEV_MODULE { panic(Text.new(s.arena).add(dir).add(": no dev lowering").str()); }
        }
        Option.None { panic("no program"); }
    }
}
