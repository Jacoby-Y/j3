// ui/scan: the fixture tree `tests/unit/ui_scan_tree/ui` in stage 0's order (the `// ---- ui/..` headers of
// `stage0/j3c dump-ui` on a copy of the tree with a `j3.toml`), and the two error texts on a temp tree.
// The tree has hidden names, a dotted folder, a folder named `x.j3ui`, a symlinked folder (not followed), a
// symlinked file (kept), a dangling link and non-`.j3ui` files (skipped).
module ui_scan_test;

use j3.io;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.ui.scan.{ Found, scan };

fn same(what: string, got: string, want: string) {
    if got == want { return; }
    io.printLn(got);
    io.printLn(want);
    panic(what);
}

fn write(p: string) {
    match io.writeFile(p, "<div></div>\n" as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a temp file"); } }
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;
    let none = List<string>.new(a);

    let t = Text.new(a);
    match scan("tests/unit/ui_scan_tree/ui", "ui", &none, a) {
        Result.Ok(v) {
            for i in 0..v.len { t.add(v.items[i].shown).add(" ").add(v.items[i].name).add(" ").add(v.items[i].path).add("\n"); }
        }
        Result.Err(e) { panic(e); }
    }
    same("scan order", t.str(), "ui/B.j3ui B tests/unit/ui_scan_tree/ui/B.j3ui\nui/Link.j3ui Link tests/unit/ui_scan_tree/ui/Link.j3ui\nui/Top.j3ui Top tests/unit/ui_scan_tree/ui/Top.j3ui\nui/Zed/Q.j3ui Zed.Q tests/unit/ui_scan_tree/ui/Zed/Q.j3ui\nui/a.d/Dot.j3ui a.d.Dot tests/unit/ui_scan_tree/ui/a.d/Dot.j3ui\nui/a/Inner.j3ui a.Inner tests/unit/ui_scan_tree/ui/a/Inner.j3ui\nui/a/Zz.j3ui a.Zz tests/unit/ui_scan_tree/ui/a/Zz.j3ui\nui/a/b/Deep.j3ui a.b.Deep tests/unit/ui_scan_tree/ui/a/b/Deep.j3ui\nui/x.j3ui/In.j3ui x.j3ui.In tests/unit/ui_scan_tree/ui/x.j3ui/In.j3ui\n");

    // a missing folder is no files (the loader says `no .j3ui files`)
    match scan("tests/unit/ui_scan_tree/none", "ui", &none, a) { Result.Ok(v) { if v.len != 0 { panic("missing folder"); } } Result.Err(e) { panic(e); } }

    let dir = match io.tempDir("", "j3boot_scan_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    // a dotted file name
    let dotted = Text.new(a).add(dir).add("/A.b.j3ui").str();
    write(dotted);
    match scan(dir, "ui", &none, a) {
        Result.Ok(_) { panic("a dotted name was taken"); }
        Result.Err(e) { same("dotted", e, "ui/A.b.j3ui: a component file name cannot contain `.` (dots are folder separators in component names)"); }
    }
    io.remove(dotted);
    // 17 folders deep
    let p = Text.new(a).add(dir);
    let dirs = List<string>.new(a);
    for i in 1..18 {
        p.add("/d");
        p.pushInt(i);
        dirs.push(Text.new(a).add(p.str()).str());
    }
    io.makeDirs(p.str());
    let deep = Text.new(a).add(p.str()).add("/X.j3ui").str();
    write(deep);
    match scan(dir, "ui", &none, a) {
        Result.Ok(_) { panic("17 folders deep was taken"); }
        Result.Err(e) { same("deep", e, Text.new(a).add(p.str()).add(" is nested deeper than 16 folders").str()); }
    }
    io.remove(deep);
    let k = dirs.len;
    while k > 0 {
        k -= 1;
        io.removeDir(dirs.items[k]);
    }
    io.removeDir(dir);
}
