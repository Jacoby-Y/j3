// `project/manifest` on real projects: this package and every `examples/*` load, and each `Manifest` field
// agrees with what `base/toml.json` says the file holds (or with Rust's default when the key is absent;
// `base_toml_test` holds that reader to the Rust one). Then manifest errors on small projects, compared byte
// for byte with `tests/unit/expect/project_examples.txt` (frozen from the Rust compiler's `check`, plan 15).
module project_examples_test;

use j3.data.json;
use j3.data.json.{ Json, Kind };
use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, parseF64 };
use j3c.base.toml;
use j3c.project.manifest;
use j3c.project.manifest.Input;
use unitkit;

fn fail(what: string, dir: string, arena: &Arena) {
    panic(Text.new(arena).add(dir).add(": ").add(what).str());
}

/// A JSON scalar as the TOML text it came from (`json` types bare `2`, `true`).
fn scalar(j: &Json, arena: &Arena): string {
    match j.kind {
        Kind.Str { return j.s; }
        Kind.Bool { return if j.b { "true" } else { "false" }; }
        _ { return ""; }
    }
}

/// `field` equals `[section] key` of the JSON, or `dflt` when the key is absent.
fn same(doc: &Json, section: string, key: string, field: string, dflt: string, dir: string, arena: &Arena) {
    let j = doc.get(section).get(key);
    if j.isNull() {
        if field != dflt { fail(Text.new(arena).add(section).add(".").add(key).add(" default").str(), dir, arena); }
        return;
    }
    if j.kind == Kind.Num {
        match parseF64(field) {
            Option.Some(f) { if f == j.n { return; } }
            Option.None {}
        }
    } else if scalar(j, arena) == field {
        return;
    }
    fail(Text.new(arena).add(section).add(".").add(key).add(" = ").add(field).str(), dir, arena);
}

fn sameList(doc: &Json, section: string, key: string, xs: &List<string>, dir: string, arena: &Arena) {
    let j = doc.get(section).get(key);
    let n = if j.isNull() { 0 } else if j.kind == Kind.Str { 1 } else { j.len() };
    let ok = n == xs.len;
    if ok && j.kind == Kind.Str { ok = xs.items[0] == j.s; }
    if ok && j.kind == Kind.Arr { for i in 0..n { if j.at(i).s != xs.items[i] { ok = false; } } }
    if !ok { fail(Text.new(arena).add(section).add(".").add(key).str(), dir, arena); }
}

fn project(dir: string, arena: &Arena) {
    let m = match manifest.resolve(dir, arena) {
        Result.Ok(Input.Project(m)) { m }
        Result.Ok(_) { panic(dir) }
        Result.Err(e) { panic(e) }
    };
    let text = match io.readFile(path.join(dir, "j3.toml", arena), arena) { Result.Ok(b) { b as string } Result.Err(_) { panic(dir) } };
    let j = match toml.json(text, arena) { Result.Ok(j) { j } Result.Err(e) { panic(Text.new(arena).add(dir).add(": ").add(e).str()) } };
    let doc = match json.parseStr(j, arena) { Result.Ok(d) { d } Result.Err(_) { panic("json") } };
    same(doc, "package", "name", m.name, "", dir, arena);
    same(doc, "package", "bin", m.bin, m.name, dir, arena);
    same(doc, "package", "version", m.version, "0.1.0", dir, arena);
    same(doc, "package", "description", m.description, Text.new(arena).add(m.name).add(", made with j3").str(), dir, arena);
    let entry = doc.get("package").get("entry");
    let rel = if entry.isNull() { "src/main.j3" } else { entry.s };
    if m.entry != path.join(dir, rel, arena) { fail("entry", dir, arena); }
    same(doc, "cc", "std", m.cc.std, "c11", dir, arena);
    same(doc, "cc", "opt", m.cc.opt, "1", dir, arena);
    let backendSet = !doc.get("emit").get("backend").isNull();
    same(doc, "emit", "backend", m.emit.backend, "llvm", dir, arena);
    same(doc, "emit", "opt", m.emit.opt, if backendSet { "2" } else { m.cc.opt }, dir, arena);
    same(doc, "emit", "debug", if m.emit.debug { "true" } else { "false" }, "true", dir, arena);
    same(doc, "emit", "cpu", m.emit.cpu, "", dir, arena);
    same(doc, "emit", "clang", m.emit.clang, "clang", dir, arena);
    sameList(doc, "emit", "target", &m.emit.targets, dir, arena);
    sameList(doc, "emit", "flags", &m.emit.flags, dir, arena);
    sameList(doc, "link", "libs", &m.link.libs, dir, arena);
    sameList(doc, "link", "files", &m.link.files, dir, arena);
    sameList(doc, "link", "flags", &m.link.flags, dir, arena);
    sameList(doc, "dist", "include", &m.dist.include, dir, arena);
    match m.ui {
        Option.Some(u) {
            same(doc, "ui", "dir", u.dir, "ui", dir, arena);
            match u.theme { Option.Some(t) { same(doc, "ui", "theme", t, "", dir, arena); } Option.None {} }
        }
        Option.None { if !doc.get("ui").isNull() && (!doc.get("ui").get("dir").isNull() || !doc.get("ui").get("theme").isNull()) { fail("ui", dir, arena); } }
    }
    if m.deps.len != doc.get("dependencies").len() { fail("dependencies", dir, arena); }
    if !doc.get("lib").isNull() != m.isLib { fail("lib", dir, arena); }
}

fn put(dir: string, rel: string, text: string, arena: &Arena) {
    let p = path.join(dir, rel, arena);
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a fixture"); } }
}

/// `toml` as `dir/j3.toml` fails to load; `check dir` would print the error as `j3c: ERROR`, appended to `all`.
fn bad(dir: string, toml: string, all: &Text, arena: &Arena) {
    put(dir, "j3.toml", toml, arena);
    let e = match manifest.resolve(dir, arena) { Result.Ok(_) { panic(toml) } Result.Err(e) { e } };
    all.add("== j3.toml\n").add(toml).add("--- check\nj3c: ").add(e).add("\n");
}

fn main() {
    let arena = Arena.create(1 << 23);
    let a = &arena;
    project(".", a);
    let n = 1;
    match io.listDir("../examples", a) {
        Result.Ok(ents) {
            for i in 0..ents.len {
                let d = path.join("../examples", ents[i].name, a);
                if io.exists(path.join(d, "j3.toml", a)) {
                    project(d, a);
                    n += 1;
                }
            }
        }
        Result.Err(_) { panic("no ../examples"); }
    }
    if n < 6 { panic("too few projects"); }

    let tmp = match io.tempDir("", "j3boot_mexamples_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    put(tmp, "src/main.j3", "", a);
    let cases = [
        "[link]\nlibs = [\"x\"]\n",
        "[package]\nname = \"\"\n",
        "[package]\nname = \"g\"\nbin = \".x\"\n",
        "[package]\nname = \"g\"\nbin = \"a\\\\b\"\n",
        "[package]\nname = \"g\"\nentry = \"nope.j3\"\n",
        "[package]\nname = \"g\"\n[lib]\n",
        "[package]\nname = \"g\"\n[emit]\ntarget = { a = \"b\" }\n",
        "[package]\nname = \"g\"\n[emit]\ntarget = [\"a\", \"\"]\n",
        "[package]\nname = \"g\"\n[emit]\nflags = \"-O\"\n",
        "[package]\nname = \"g\"\n[link]\nsearch = \"x\"\n",
        "[package]\nname = \"g\"\n[dist]\nbuild_outputs = \"zip\"\n",
        "[package]\nname = \"g\"\n[dist]\nbuild_outputs = [\"zip\", \"steam\"]\n",
        "[package]\nname = \"g\"\n[dist]\ninclude = 1\n",
        "[package]\nname = \"g\"\n[dist.actions]\nx = \"y\"\n",
        "[package]\nname = \"g\"\n[dist.actions]\na_b = { name = \"n\" }\n",
        "[package]\nname = \"g\"\n[dist.actions]\nab = { exec = \"n\" }\n",
        "[package]\nname = \"g\"\n[android]\npackage = \"com\"\n",
        "[package]\nname = \"g\"\n[android]\npackage = \"com.new.x\"\n",
        "[package]\nname = \"g\"\n[android]\norientation = \"up\"\n",
        "[package]\nname = \"g\"\n[android]\nforeground_service = \"location\"\n",
        "[package]\nname = \"g\"\n[ui]\ndir = \"ui\"\nlint-off = \"x\"\n",
        "[package]\nname = \"g\"\n[dependencies]\nx = \"../nope\"\n",
        "[package]\nname = \"g\"\nkey\n"
    ];
    let all = Text.new(a);
    for i in 0..cases.len { bad(tmp, cases[i], &all, a); }
    unitkit.expect(unitkit.mask(all.str(), tmp, "$TMP", a), "project_examples.txt", "manifest errors differ from tests/unit/expect/project_examples.txt");
    printLn(`project_examples: {n} projects ok`);
}
