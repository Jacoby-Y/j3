// `cmd/gen` and `cmd/doctor` compile and run: a project without `assets/gen` has no scripts (no host lookup,
// nothing written); `beforeBuild` under `J3_GEN_RUNNING` does nothing (checked on a copy of
// `examples/editor_village` without `target/`, in `target/unit/gen/village`, removed after). The generator runs
// themselves are `tests/tool/img.txt` cases (scratch copies of `examples/editor_village`).
module gen_test;

use j3.io;
use j3.memory.Arena;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3c.cmd.doctor;
use j3c.cmd.gen;

const DIR = "target/unit/gen/village";

fn sh(line: string, arena: &Arena) {
    match proc.run(["sh", "-c", line], "", arena) {
        Result.Ok(o) { if o.code != 0 { panic(line); } }
        Result.Err(_) { panic(line); }
    }
}

fn main() {
    let a = Arena.create(1 << 16);
    let r = gen.runAll("tests/unit", false, &a);
    if r.scripts != 0 || r.made.len != 0 || r.failed.len != 0 { panic("a folder without assets/gen has scripts"); }
    if io.exists("tests/unit/target/j3-editor") { panic("runAll wrote stamps without scripts"); }
    sh("rm -rf target/unit/gen/village && mkdir -p target/unit/gen/village && cd ../examples/editor_village && cp -r assets j3.editor.toml j3.toml scenes src ../../j3c-bootstrap/target/unit/gen/village/", &a);
    if !io.exists("target/unit/gen/village/assets/gen/tree.j3") { panic("the scratch copy has no assets/gen"); }
    sys.setenv("J3_GEN_RUNNING", "1");
    gen.beforeBuild(DIR);
    if io.exists("target/unit/gen/village/target") { panic("beforeBuild ran under J3_GEN_RUNNING"); }
    sh("rm -rf target/unit/gen/village", &a);
    a.destroy();
}
