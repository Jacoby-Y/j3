// `base/fsx` on a temp dir: `listJ3` order (Rust sorts `PathBuf`s by component, so `a/z.j3` comes before
// `a-b.j3`) and filter, Rust's `io::Error` texts, `readText` errors, `samePath`.
module base_fsx_test;

use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.fsx;

fn put(dir: string, name: string, arena: &Arena): string {
    let p = Text.new(arena).add(dir).add("/").add(name).str();
    match io.writeFile(p, "x" as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a temp file"); } }
    return p;
}

fn at(dir: string, name: string, arena: &Arena): string { return Text.new(arena).add(dir).add("/").add(name).str(); }

fn main() {
    let arena = Arena.create(1 << 20);
    let dir = match io.tempDir("", "j3boot_fsx_", &arena) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    io.makeDirs(at(dir, "a", &arena));
    let made = ["a.j3", "a-b.j3", "a/z.j3", "b.j3s", ".j3", "c.txt", "d.j3x"];
    for i in 0..made.len { put(dir, made[i], &arena); }

    match fsx.listJ3(dir, &arena) {
        Result.Ok(l) {
            let want = ["a/z.j3", "a-b.j3", "a.j3", "b.j3s"];
            if l.len != want.len { printLn(`{l.len} files`); panic("listJ3 count"); }
            for i in 0..want.len {
                if l.items[i] != at(dir, want[i], &arena) { printLn(`{i}: {l.items[i]}`); panic("listJ3 order"); }
            }
        }
        Result.Err(e) { panic(e); }
    }
    let nope = at(dir, "nope", &arena);
    match fsx.listJ3(nope, &arena) {
        Result.Ok(_) { panic("listJ3 of a missing dir"); }
        Result.Err(e) { if e != Text.new(&arena).add("read ").add(nope).add(": No such file or directory (os error 2)").str() { panic(e); } }
    }

    if fsx.osError(2, &arena) != "No such file or directory (os error 2)" { panic("osError 2"); }
    if fsx.osError(13, &arena) != "Permission denied (os error 13)" { panic("osError 13"); }
    if fsx.osError(41, &arena) != "Unknown error 41 (os error 41)" { panic("osError 41"); }
    if fsx.osError(500, &arena) != "Unknown error 500 (os error 500)" { panic("osError 500"); }

    match fsx.readText(at(dir, "a.j3", &arena), &arena) { Result.Ok(s) { if s != "x" { panic("readText"); } } Result.Err(e) { panic(e); } }
    match fsx.readText(nope, &arena) {
        Result.Ok(_) { panic("readText of a missing file"); }
        Result.Err(e) { if e != Text.new(&arena).add("read ").add(nope).add(": No such file or directory (os error 2)").str() { panic(e); } }
    }
    match fsx.readText(at(dir, "a", &arena), &arena) {
        Result.Ok(_) { panic("readText of a dir"); }
        Result.Err(e) { if e != Text.new(&arena).add("read ").add(at(dir, "a", &arena)).add(": Is a directory (os error 21)").str() { panic(e); } }
    }
    let bad = at(dir, "bad.txt", &arena);
    let raw: [2]u8 = [0xff, 0x41];
    io.writeFile(bad, raw[:]);
    match fsx.readText(bad, &arena) {
        Result.Ok(_) { panic("readText of bad UTF-8"); }
        Result.Err(e) { if e != Text.new(&arena).add("read ").add(bad).add(": stream did not contain valid UTF-8").str() { panic(e); } }
    }

    if !fsx.samePath("x/y", "x//y/", &arena) || !fsx.samePath("x/./y", "x/y", &arena) { panic("samePath components"); }
    if fsx.samePath("q/../r", "r", &arena) || fsx.samePath("./x", "x", &arena) { panic("samePath missing files"); }
    if !fsx.samePath(at(dir, "a/../a.j3", &arena), at(dir, "a.j3", &arena), &arena) { panic("samePath canonical"); }
    if fsx.samePath(at(dir, "a.j3", &arena), at(dir, "b.j3s", &arena), &arena) { panic("samePath different"); }

    for i in 0..made.len { io.remove(at(dir, made[i], &arena)); }
    io.remove(bad);
    io.removeDir(at(dir, "a", &arena));
    io.removeDir(dir);
    printLn("base_fsx ok");
}
