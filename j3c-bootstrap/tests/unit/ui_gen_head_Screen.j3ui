<script>
    use j3.math.{ Vec2, clamp };
    use j3.text;
    props { gold: int; title: string = "hi"; }
    events { pick(slot: int, why: string); close; }
    const MAX: int = 9;
    const TABLE: [3]int = [1, 2, 3];
    let count: int = 0;
    let label = "x";
    fn bump(by: int) {
        count += by + gold + MAX;
        let s = `n={count + gold} of {MAX}`;
        emit pick(count, s);
        if count > 3 { emit close; }
    }
    fn total(): int { return count + TABLE[0] + d.width(); }
    fn onMount() { bump(1); }
    fn onFrame(dt: f32) { count += 1; }
    fn onDestroy() { count = 0; }
</script>
Gold {gold} of {total()} and {label}
{#let twice = gold * 2}
Twice {twice}
<style>

.a { color: red; }

</style>
