// The items side of the parser (items, attrs, shader attrs, generics, traits, types, scripts, `@j3ui`)
// against the oracle: each snippet is written to `target/unit/syntax_parse_items/cases/`, parsed here
// (`parseFile`/`parseScript`, then `dumpAst` or the rendered parse error, as `cmd/dump` does) and
// compared byte for byte with `tests/unit/expect/syntax_parse_items.txt` (frozen from the Rust compiler's
// `dump-ast` on the same file, plan 15): stdout, stderr and exit code.
// Mostly parse errors (message and position); a few valid files cover the success paths.
module syntax_parse_items_test;

use j3.data.pool.Id;
use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.diag;
use j3c.base.intern.own;
use j3c.base.span.Source;
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ Ast, File };
use j3c.syntax.dump.dumpAst;
use j3c.syntax.parse;
use j3c.syntax.token.ParseError;
use unitkit;

const DIR = "target/unit/syntax_parse_items/cases";

/// What `dump-ast PATH` would print, in-process: (code, stdout, stderr).
fn ours(s: &Session, path: string, src: string, script: bool): (int, string, string) {
    let ast = Ast.new(s.arena, &s.names);
    let id = s.sources.add(Source.of(own(s.arena, path), src, s.arena));
    let r: Result<File, ParseError> = parse.parseFile(src, id, &ast);
    if script {
        let m: [1]string = ["script"];
        r = parse.parseScript(src, id, m, &ast);
    }
    match r {
        Result.Ok(f) {
            let t = Text.new(s.arena);
            dumpAst(&ast, &f, &t);
            return (0, t.str(), "");
        }
        Result.Err(e) {
            parse.report(e, &s.diags);
            let t = Text.new(s.arena);
            diag.render(s.diags.at(s.diags.count() - 1), &s.sources, &t);
            return (1, "", t.str());
        }
    }
}

/// Writes case `n` (`src`) and appends what `dump-ast` of it prints (stdout, stderr, exit code) to `all`.
fn add(s: &Session, n: int, ext: string, src: string, all: &Text) {
    let pt = Text.new(s.arena);
    pt.add(DIR).add("/c").pushInt(n);
    let path = pt.add(ext).str();
    match io.writeFile(path, src as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case file"); } }
    let (code, out, err) = ours(s, path, src, ext == ".j3s");
    all.add("== ").add(path).add("\n").add(src).add("--- stdout\n").add(out).add("--- stderr\n").add(err).add("--- exit ").pushInt(code);
    all.add("\n");
}

fn main() {
    match io.makeDirs(DIR) { Result.Ok(_) {} Result.Err(_) { panic("cannot make the case dir"); } }
    let s = Session.new(driver.defaults());
    let j3: []string = [
        // attrs.rs
        "module m;\n#[Debug(x)] struct S {}\n",
        "module m;\n#[derive(Foo)] struct S {}\n",
        "module m;\n#[derive(Eq, Eq)] struct S {}\n",
        "module m;\n#[Debug]\n#[derive(Hash, Debug)] struct S {}\n",
        "module m;\n#[bogus] fn f() {}\n",
        "module m;\n#[singleton(1)] let x: int;\n",
        "module m;\n#[thread(1)] let x: int;\n",
        "module m;\n#[impl(1)] fn f() {}\n",
        "module m;\n#[TryCatch(A B)] enum E { A, B }\n",
        "module m;\n#[TryCatch(A, B) struct S {}\n",
        "module m;\n#[derive(Eq) struct S {}\n",
        "module m;\n#[Debug] fn f() {}\n",
        "module m;\n#[TryCatch(A, B)] const X = 1;\n",
        "module m;\n#[derive(Eq)] use a;\n",
        "module m;\n#[singleton] fn f() {}\n",
        "module m;\n#[thread] fn f() {}\n",
        "module m;\n#[impl] const X = 1;\n",
        "module m;\n#[impl] struct S {}\n",
        "module m;\n#[impl] enum E { A }\n",
        "module m;\n#[TryCatch(A, B)] struct S {}\n",
        "module m;\n/// doc\nuse a;\n",
        "module m;\n/// doc\n42\n",
        // shader_attrs.rs
        "module m;\n#[shader(geometry)] fn f() {}\n",
        "module m;\n#[shader(vertex] fn f() {}\n",
        "module m;\n#[vertex(x)] struct V { a: f32; }\n",
        "module m;\n#[varying(x)] struct V {}\n",
        "module m;\n#[uniform] fn f() {}\n",
        "module m;\n#[flat] struct S {}\n",
        "module m;\n#[vertex] fn f() {}\n",
        "module m;\n#[shader(vertex)] struct S {}\n",
        "module m;\n#[shader] const X = 1;\n",
        "module m;\nstruct S { #[smooth] a: f32; }\n",
        "module m;\nstruct S { #[flat a: f32; }\n",
        "module m;\n#[uniform] let u: vec2 = 1;\n",
        // items.rs
        "fn f() {}\n",
        "module m\nfn f() {}\n",
        "module m;\nlet x: int = 1;\n",
        "module m;\n#[singleton] #[Debug] let x: int = 1;\n",
        "module m;\n#[singleton] pub let x: int = 1;\n",
        "module m;\n#[singleton] let x int = 1;\n",
        "module m;\n#[singleton] let x: int = 1\n",
        "module m;\npub use a.b;\n",
        "module m;\npub use lib \"c\" as c {}\n",
        "module m;\nif x {}\n",
        "module m;\nuse lib c as c {}\n",
        "module m;\nuse lib \"c\" c {}\n",
        "module m;\nuse lib \"c\" as c fn f(); }\n",
        "module m;\nuse lib \"c\" as c { f(); }\n",
        "module m;\nuse lib \"c\" as c { fn f() = 3; }\n",
        "module m;\nuse lib \"c\" as c { fn f() }\n",
        "module m;\nuse lib \"c\" as c { fn f()",
        "module m;\nuse a.{};\n",
        "module m;\nuse a.{ b c };\n",
        "module m;\nuse a\n",
        "module m;\nconst X: int 1;\n",
        "module m;\nconst X = 1\n",
        "module m;\nstruct { }\n",
        "module m;\nstruct S [ ]\n",
        "module m;\nstruct S { a int; }\n",
        "module m;\nstruct S { a: int }\n",
        "module m;\nstruct S { a: int;\n",
        "module m;\nstruct S {\n    a: int;\n    /// orphan\n}\n",
        "module m;\nenum E [ A ]\n",
        "module m;\nenum E { A(int, }\n",
        "module m;\nenum E { A(int B }\n",
        "module m;\nenum E { A B }\n",
        "module m;\nenum E {\n    A,\n    /// orphan\n}\n",
        "module m;\nfn f() int {}\n",
        // extend.rs
        "module m;\nstruct S<T> {}\nextend S<T: A> {}\n",
        "module m;\nextend S { pub fn f() {} }\n",
        "module m;\nextend S { let x = 1; }\n",
        "module m;\npub extend S {}\n",
        "module m;\nextend S fn f() {} }\n",
        "module m;\nextend S { fn f() {}\n",
        // generics.rs, traits.rs
        "module m;\nfn operator%%() {}\n",
        "module m;\nfn operator() {}\n",
        "module m;\nfn T.name() {}\n",
        "module m;\nfn f {}\n",
        "module m;\nfn f(a int) {}\n",
        "module m;\nfn f(a: int {}\n",
        "module m;\nfn f<T: A + A>() {}\n",
        "module m;\nfn f<T, U>() where T: A, T: B {}\n",
        "module m;\nfn f<T() {}\n",
        "module m;\nstruct S { x: List<int; }\n",
        "module m;\ntrait T<X> {}\n",
        "module m;\ntrait T { fn m<X>(); }\n",
        "module m;\ntrait T { fn m() }\n",
        "module m;\ntrait T { let x; }\n",
        "module m;\ntrait T fn m(); }\n",
        "module m;\ntrait T { fn m();\n",
        // types.rs
        "module m;\nconst X: [99999999999999999999]int = 1;\n",
        "module m;\nconst X: [18446744073709551615]int = 1;\n",
        "module m;\nconst X: [x]int = 1;\n",
        "module m;\nconst X: [3 int = 1;\n",
        "module m;\nconst X: (int) = 1;\n",
        "module m;\nconst X: (int, int = 1;\n",
        "module m;\nconst X: fn int = 1;\n",
        "module m;\nconst X: fn(int = 1;\n",
        "module m;\nconst X: List<int = 1;\n",
        "module m;\nconst X: & = 1;\n",
        // script_ui.rs (@j3ui)
        "module m;\n@foo fn f(ui: Ui) {}\n",
        "module m;\n@j3ui fn f() {}\n",
        "module m;\n#[Debug] @j3ui fn f(ui: Ui) {}\n",
        "module m;\n@j3ui fn f(ui: Ui) {\n    label(\"x\") { }\n}\n",
        "module m;\n@j3ui fn f(ui: Ui) {\n    label(\"x\")\n}\n",
        // valid: every item kind and type form
        "/// file doc\nmodule m.n;\nuse a.b;\nuse a.{ C, D, };\nuse lib \"c\" as c { fn f(a: int, b: &u8): int = \"f2\"; fn g(); }\n/// d\npub const X: [4]u8 = 1;\nconst Y = 2;\n#[singleton] #[thread] let s: int = 0;\n#[uniform] let u: vec2;\n",
        "module m;\n/// S\n#[derive(Eq, Hash, Debug)]\npub struct S<K: Hash + Eq, V> {\n    /// a\n    a: []int = 1;\n    use b: &K;\n    c: (int, f32,);\n    fn m(this: &S<K, V>,) where V: Ord + Eq { }\n}\nstruct Unit;\n#[derive(Ord)] enum E<T> { /// v\n A, B(T, int,), C, }\n#[TryCatch(Ok, Err)] enum R { Ok(int), Err }\nextend S<K, V> { /// m\n fn n(this: &S<K, V>) {} }\n",
        "module m;\ntrait Ord: Eq + Hash {\n    /// m\n    fn cmp(this: Self, o: Self): int;\n    fn ne(this: Self) { }\n    fn operator==(a: Self, b: Self): bool;\n}\nfn operator+(a: V, b: V): V { }\nfn operator<=(a: V, i: int): bool { }\n#[impl] fn hash(x: int): u64 { }\nfn d(a: dyn Draw, b: dyn Draw, c: dyn Show, f: fn(int, int,): bool, g: fn(), h: closure(int): int, k: boxed closure(), m: Map<int, List<u8>,>) {}\n",
        "module m;\n#[vertex] struct V { a: vec3; }\n#[vertex(instance)] struct I { a: vec3; }\n#[varying] struct Y { #[flat] k: int; p: vec4; }\n#[shader] struct P { a: f32; }\n#[shader] fn h() {}\n#[shader(vertex)] fn vs() {}\n#[shader(fragment)] fn fs() {}\n",
        "module m;\npub @j3ui panelUi(ui: &Ui, n: int) {\n    panel(\"a\") { label(\"x\"); }\n    pushId(1) { gap(); }\n    button(\"b\") { label(\"y\"); }\n}\n",
        "module j3.cmp;\n#[derive(Hash)] struct S {}\n",
        "module m;\nstruct S {}\n#[derive(Eq)] struct T {}\n#[derive(Eq, Ord)] enum E { A }\n#[derive(Hash)] struct U {}\n"
    ];
    let j3s: []string = [
        "module x;\n",
        "use lib \"c\" as c {}\n",
        "pub use a;\n",
        "pub const X = 1;\n",
        "extend S { fn f() {} }\n",
        "trait T {}\n",
        "/// d\nprops { a: int; }\n",
        "/// d\nshared { a: int; }\n",
        "/// d\nlet x = 1;\n",
        "/// d\nuse a;\n",
        "props { a int; }\n",
        "props a: int; }\n",
        "props { a: int }\n",
        "props { a: int;\n",
        "pub props { }\n",
        "pub let x = 1;\n",
        "let x;\n",
        "let x = 1\n",
        "#[Debug] struct S {}\n",
        "while true {}\n",
        "/// file\nuse a.b;\nconst K: int = 1;\nprops { /// p\n speed: f32 = 2; name: string; }\nshared { hits: int; }\nlet n: int = 0;\nlet m = 1;\n/// f\npub fn f() {}\npub struct S { a: int; }\npub enum E { A, B(int) }\n"
    ];
    let all = Text.new(s.arena);
    let n = 0;
    for i in 0..j3.len { add(s, n, ".j3", j3[i], &all); n += 1; }
    for i in 0..j3s.len { add(s, n, ".j3s", j3s[i], &all); n += 1; }
    unitkit.expect(all.str(), "syntax_parse_items.txt", "parser (items side) differs from tests/unit/expect/syntax_parse_items.txt");
    let t = Text.new(s.arena);
    t.add("syntax parse items ok: ").pushInt(n);
    printLn(t.add(" cases").str());
    s.free();
}
