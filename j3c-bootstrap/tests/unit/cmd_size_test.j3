// `j3c size` names a fn by its module even when both have underscores (Rust test
// `size_names_a_function_by_its_module_even_when_both_have_underscores`), and a method as `Struct.name`.
module cmd_size_test;

use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, startsWith };
use j3c.cmd.size.symbolOwners;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };

fn main() {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-size-owners").str();
    let file = Text.new(&mem).add(dir).add("/main.j3").str();
    io.makeDirs(dir);
    let src = "module closure_trace;\n\nstruct Big_one { x: int; fn get_x(this: &Big_one): int { return this.x; } }\n\nfn more_value(x: int): int {\n    return x * 2;\n}\n\nfn main() {\n    let b = Big_one { x: 1 };\n    more_value(b.get_x());\n}\n";
    match io.writeFile(file, src as []u8) { Result.Ok(_) {} Result.Err(_) { panic("write main.j3"); } }
    let o = driver.defaults();
    o.entry = file;
    o.mode = Mode.Build;
    let s = Session.new(o);
    if !driver.run(s, Stage.Passes) { panic("check"); }
    let prog = match s.program { Option.Some(p) { p } Option.None { panic("no program"); } };
    let owners = symbolOwners(prog, s.arena);
    let fns = 0;
    let methods = 0;
    for i in 0..owners.len {
        let w = owners.items[i];
        if startsWith(w.sym, "j3_closure_trace_more_value_") {
            fns += 1;
            if w.owner != "closure_trace" || w.label != "more_value" { panic(w.label); }
        }
        if w.label == "Big_one.get_x" {
            methods += 1;
            if w.owner != "closure_trace" || !startsWith(w.sym, "j3_closure_trace_") { panic(w.sym); }
        }
    }
    if fns != 1 { panic("no symbol for more_value"); }
    if methods != 1 { panic("no owner for the method"); }
    s.free();
    io.remove(file);
    io.removeDir(dir);
}
