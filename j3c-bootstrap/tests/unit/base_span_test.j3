// base/span line table, base/ids `Spans<T>` side table, base/intern `Names` and `own`.
module base_span_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.ids.Spans;
use j3c.base.intern.{ Names, own };
use j3c.base.span.{ fileSpan, isNone, isWholeFile, Lines, noSpan, Source, Span };

fn at(l: &Lines, off: u32, line: int, col: int) {
    let p = l.at(off);
    if p.line != line || p.col != col { panic(`at {off}: got {p.line}:{p.col}, want {line}:{col}`); }
}

fn main() {
    let arena = Arena.create(1 << 16);
    let src = "ab\n\ncd\r\nlast";
    let l = Lines.of(src, &arena);
    if l.starts.len != 4 { panic("line starts"); }
    at(&l, 0, 1, 1);
    at(&l, 2, 1, 3);
    at(&l, 3, 2, 1);
    at(&l, 4, 3, 1);
    at(&l, 6, 3, 3);
    at(&l, 8, 4, 1);
    at(&l, 12, 4, 5);
    if l.text(src, 1) != "ab" || l.text(src, 2) != "" || l.text(src, 3) != "cd" || l.text(src, 4) != "last" { panic("line text"); }
    if l.text(src, 5) != "" || l.text(src, 0) != "" { panic("line text out of range"); }
    let cr = "x\r";
    if Lines.of(cr, &arena).text(cr, 1) != "x\r" { panic("a final `\\r` without `\\n` stays, as in Rust"); }

    let sp = Spans<Source>.new(&arena);
    let f = Id<Source> { i: 0 };
    let s5 = Span { file: f, lo: 5, hi: 9 };
    sp.set(Id<Source> { i: 5 }, s5);
    if sp.get(Id<Source> { i: 5 }) != s5 { panic("span not stored"); }
    if !isNone(sp.get(Id<Source> { i: 2 })) || !isNone(sp.get(Id<Source> { i: 50 })) { panic("unset span is not noSpan"); }
    sp.set(Id<Source> { i: 2 }, s5);
    if sp.get(Id<Source> { i: 5 }) != s5 || sp.get(Id<Source> { i: 2 }) != s5 { panic("overwrite"); }
    if !isWholeFile(fileSpan(f)) || isNone(fileSpan(f)) || isWholeFile(noSpan()) || isWholeFile(s5) { panic("fileSpan"); }

    let names = Names.new(&arena);
    let t = Text.new(&arena);
    t.pushStr("main");
    let a = names.intern(t.str());
    t.clear();
    t.pushStr("other");
    let b = names.intern(t.str());
    if a == b || names.intern("main") != a || names.str(a) != "main" || names.len() != 2 { panic("Names"); }
    let o = own(&arena, t.str());
    t.clear();
    t.pushStr("XXXXX");
    if o != "other" || own(&arena, "") != "" { panic("own did not copy"); }
    printLn("base_span ok");
}
