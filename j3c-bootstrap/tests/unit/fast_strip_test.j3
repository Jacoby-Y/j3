// `--fast` on built IR (Rust `compile/tests.rs` fast cases): the pass drops every bounds-check `abort;` and
// the `if` that only aborts, keeps `abort div0;`, and the stripped program still validates (the pass list
// runs validate first; a second run of the driver's passes validates the stripped IR).
module fast_strip_test;

use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.ir.validate.validateProgram;

const SRC = "module fastprog;\nfn pick(xs: []int, i: int, d: int): int {\n    let n = 0;\n    for k in 0..i { if k > 2 { n += xs[k]; } else { n += xs[i..][0]; } }\n    while n > 100 { n = n / d; }\n    return xs[i] / d + n;\n}\nfn main() { let a: [4]int; a[1] = 6; if pick(a[..], 1, 2) != 3 { a[0] = 1; } }\n";

/// The dump-ir text of `entry`, built through the pass list with `fast` set.
fn irText(entry: string, fast: bool, out: &Arena): string {
    let o = driver.defaults();
    o.entry = entry;
    o.fast = fast;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) { panic("fastprog.j3 does not check"); }
    match s.program {
        Option.Some(p) {
            match validateProgram(p) { Result.Ok(_) {} Result.Err(e) { panic(e.message); } }
        }
        Option.None { panic("no program"); }
    }
    let t = Text.new(s.arena);
    if !driver.dumpIr(s, &t) { panic("no IR"); }
    return Text.new(out).add(t.str()).str();
}

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-fast-strip").str();
    let entry = Text.new(&mem).add(dir).add("/fastprog.j3").str();
    match io.makeDirs(dir) { Result.Ok(_) {} Result.Err(_) { panic("make the temp dir"); } }
    match io.writeFile(entry, SRC as []u8) { Result.Ok(_) {} Result.Err(_) { panic("write fastprog.j3"); } }

    let plain = irText(entry, false, &mem);
    if !text.contains(plain, "abort;\n") || !text.contains(plain, "abort div0;\n") { panic("the plain build has no aborts to strip"); }
    let fast = irText(entry, true, &mem);
    if text.contains(fast, "abort;\n") { panic("--fast left a bounds-check abort"); }
    if !text.contains(fast, "abort div0;\n") { panic("--fast dropped the divide-by-zero check"); }
    if fast.len >= plain.len { panic("--fast removed nothing"); }
}
