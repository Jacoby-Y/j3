// Fixture of lower_derive_test: every derive on a struct, a generic struct, a payload enum, a one-variant
// enum, a C-like enum and a struct without fields.
module lowerderive;

use j3.io.printLn;

#[derive(Eq, Hash, Ord, Debug, Clone)]
struct Key {
    name: string;
    n: int;
}

#[derive(Eq, Hash, Ord, Debug)]
enum Shape { Dot, Circle(int), Rect(int, int) }

#[derive(Eq, Hash)]
struct Pair<A, B> {
    a: A;
    b: B;
}

#[derive(Eq, Hash, Ord, Clone)]
enum One { A(int) }

#[derive(Eq, Hash, Ord, Clone)]
enum Flag { Off, On }

#[derive(Eq, Hash, Ord, Clone)]
struct Empty {}

fn main() {
    let a = Key { name: "x", n: 1 };
    let b = Key { name: "x", n: 2 };
    printLn(`{a == a.clone()} {a == b} {a < b} {a >= b} {a.hash() == b.hash()} {a}`);
    let r = Shape.Rect(1, 2);
    printLn(`{r == Shape.Rect(1, 2)} {r < Shape.Rect(1, 3)} {Shape.Dot < r} {r != Shape.Dot} {r.hash()} {r}`);
    let p = Pair<int, string> { a: 7, b: "q" };
    printLn(`{p == p} {p.hash()}`);
    let o = One.A(1);
    let f = Flag.On;
    let e = Empty {};
    printLn(`{o == o.clone()} {o < One.A(2)} {o.hash()} {f == Flag.On} {f < Flag.Off} {f.clone().hash()} {e == e.clone()} {e < e} {e.hash()}`);
}
