// Terse constructors for hand-built ASTs (tests of dump, walk, and anything else that needs a tree before
// the parser runs). Every node gets `noSpan()`: dump and walk ignore spans.
// Reuse: a test entry `tests/unit/X_test.j3` sees this part when `tests/unit/X_test` is a symlink to this
// folder and the entry says `module syntax_dump_test;` (parts are found by entry file name, and must
// share its module). `syntax_walk_test` does that.
module syntax_dump_test;

struct Bld {
    ast: &Ast;
    arena: &Arena;
    sp: Span;

    fn new(ast: &Ast, arena: &Arena): Bld { return Bld { ast: ast, arena: arena, sp: noSpan() }; }

    fn id(this: &Bld, s: string): Ident { return Ident { name: this.ast.sym(s), span: this.sp }; }
    fn ids(this: &Bld, xs: []string): List<Ident> {
        let l = List<Ident>.new(this.arena);
        for i in 0..xs.len { l.push(this.id(xs[i])); }
        return l;
    }
    fn noIds(this: &Bld): List<Ident> { return List<Ident>.new(this.arena); }
    /// `a.b.c` as a path of idents.
    fn path(this: &Bld, s: string): List<Ident> {
        let l = List<Ident>.new(this.arena);
        let at = 0;
        for i in 0..s.len + 1 {
            if i == s.len || s[i] == '.' {
                l.push(this.id(s[at..i]));
                at = i + 1;
            }
        }
        return l;
    }

    // expressions
    fn e(this: &Bld, x: Expr): Id<Expr> { return this.ast.addExpr(x, this.sp); }
    fn n(this: &Bld, s: string): Id<Expr> { return this.e(Expr.Name(this.id(s))); }
    fn int(this: &Bld, v: i64): Id<Expr> { return this.e(Expr.Int(v)); }
    fn es(this: &Bld, xs: []Id<Expr>): List<Id<Expr>> {
        let l = List<Id<Expr>>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    fn noEs(this: &Bld): List<Id<Expr>> { return List<Id<Expr>>.new(this.arena); }
    fn bin(this: &Bld, op: BinOp, l: Id<Expr>, r: Id<Expr>): Id<Expr> {
        return this.e(Expr.Binary(BinaryExpr { op: op, lhs: l, rhs: r }));
    }
    /// `xs[0] op xs[1] op ...`, left-nested as the parser builds it.
    fn chain(this: &Bld, op: BinOp, xs: []Id<Expr>): Id<Expr> {
        let acc = xs[0];
        for i in 1..xs.len { acc = this.bin(op, acc, xs[i]); }
        return acc;
    }
    fn un(this: &Bld, op: UnaryOp, x: Id<Expr>): Id<Expr> { return this.e(Expr.Unary(UnaryExpr { op: op, expr: x })); }
    fn call(this: &Bld, f: Id<Expr>, args: List<Id<Expr>>): Id<Expr> {
        return this.e(Expr.Call(CallExpr { func: f, typeArgs: this.noTs(), args: args }));
    }
    /// `name(args)` with no type arguments.
    fn calln(this: &Bld, name: string, args: List<Id<Expr>>): Id<Expr> { return this.call(this.n(name), args); }
    fn field(this: &Bld, base: Id<Expr>, name: string): Id<Expr> {
        return this.e(Expr.Field(FieldExpr { base: base, field: this.id(name) }));
    }
    fn inits(this: &Bld, names: []string, vals: []Id<Expr>): List<FieldInit> {
        let l = List<FieldInit>.new(this.arena);
        for i in 0..names.len { l.push(FieldInit { name: this.id(names[i]), value: vals[i] }); }
        return l;
    }

    // types
    fn t(this: &Bld, x: Type): Id<Type> { return this.ast.addType(x, this.sp); }
    fn tn(this: &Bld, s: string): Id<Type> { return this.t(Type.Named(NamedType { name: this.ast.sym(s) })); }
    fn ts(this: &Bld, xs: []Id<Type>): List<Id<Type>> {
        let l = List<Id<Type>>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    fn noTs(this: &Bld): List<Id<Type>> { return List<Id<Type>>.new(this.arena); }
    fn tgen(this: &Bld, name: string, args: List<Id<Type>>): Id<Type> {
        return this.t(Type.Generic(GenericType { name: this.ast.sym(name), args: args }));
    }
    fn tref(this: &Bld, x: Id<Type>): Id<Type> { return this.t(Type.Ref(RefType { ty: x })); }

    // patterns
    fn p(this: &Bld, x: Pat): Id<Pat> { return this.ast.addPat(x, this.sp); }
    fn ps(this: &Bld, xs: []Id<Pat>): List<Id<Pat>> {
        let l = List<Id<Pat>>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    fn bind(this: &Bld, s: string): Id<Pat> { return this.p(Pat.Bind(this.id(s))); }
    fn lit(this: &Bld, x: Id<Expr>): Id<Pat> { return this.p(Pat.Lit(LitPat { expr: x })); }
    fn pfields(this: &Bld, names: []string, pats: []Id<Pat>): List<PatField> {
        let l = List<PatField>.new(this.arena);
        for i in 0..names.len { l.push(PatField { name: this.id(names[i]), pat: pats[i] }); }
        return l;
    }

    // statements
    fn s(this: &Bld, x: Stmt): Id<Stmt> { return this.ast.addStmt(x, this.sp); }
    fn blk(this: &Bld, xs: []Id<Stmt>): Block {
        let l = List<Id<Stmt>>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return Block { span: this.sp, stmts: l };
    }
    fn noBlk(this: &Bld): Block { return Block { span: this.sp, stmts: List<Id<Stmt>>.new(this.arena) }; }
    fn ret(this: &Bld, v: Option<Id<Expr>>): Id<Stmt> { return this.s(Stmt.Return(ReturnStmt { span: this.sp, value: v })); }
    fn exprS(this: &Bld, x: Id<Expr>): Id<Stmt> { return this.s(Stmt.Expr(ExprStmt { expr: x })); }
    fn letS(this: &Bld, name: string, ty: Option<Id<Type>>, v: Id<Expr>): Id<Stmt> {
        return this.s(Stmt.Let(LetStmt { span: this.sp, doc: "", name: this.id(name), ty: ty, value: v }));
    }

    // items
    fn param(this: &Bld, name: string, ty: Id<Type>): Param { return Param { name: this.id(name), ty: ty }; }
    fn params(this: &Bld, xs: []Param): List<Param> {
        let l = List<Param>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    fn noParams(this: &Bld): List<Param> { return List<Param>.new(this.arena); }
    /// A plain fn: no doc, attributes, type parameters or `where`.
    fn fnItem(this: &Bld, name: string, params: List<Param>, ret: Option<Id<Type>>, body: Block): FnItem {
        return FnItem { span: this.sp, doc: "", visPub: false, name: this.id(name), typeParams: this.noIds(),
            bounds: List<List<Ident>>.new(this.arena), whereBounds: List<WhereBound>.new(this.arena), derived: false, isImpl: false,
            shader: Option.None, params: params, ret: ret, body: body };
    }
    fn fns(this: &Bld, xs: []FnItem): List<FnItem> {
        let l = List<FnItem>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    fn fieldItem(this: &Bld, name: string, ty: Id<Type>, def: Option<Id<Expr>>): FieldItem {
        return FieldItem { span: this.sp, doc: "", name: this.id(name), ty: ty, embedded: false, flat: false, default: def };
    }
    fn fieldItems(this: &Bld, xs: []FieldItem): List<FieldItem> {
        let l = List<FieldItem>.new(this.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return l;
    }
    /// A plain struct: no doc, attributes, derives or type parameters.
    fn structItem(this: &Bld, name: string, fields: List<FieldItem>): StructItem {
        return StructItem { span: this.sp, doc: "", visPub: false, debug: false, packed: false, gpu: GpuStruct.None,
            derives: this.noIds(), name: this.id(name), typeParams: this.noIds(), bounds: List<List<Ident>>.new(this.arena),
            fields: fields, methods: List<FnItem>.new(this.arena) };
    }
    fn file(this: &Bld, moduleName: string, items: []Item): File {
        let l = List<Item>.new(this.arena);
        for i in 0..items.len { l.push(items[i]); }
        return File { span: this.sp, doc: "", moduleName: this.path(moduleName), isScript: false, items: l,
            embeds: List<EmbedRead>.new(this.arena), dyns: List<Sym>.new(this.arena) };
    }
}
