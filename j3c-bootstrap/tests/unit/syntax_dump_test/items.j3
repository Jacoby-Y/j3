// Hand-built trees of `tests/unit/syntax_dump_cases/{items,gpu}.j3` and `script.j3s`: every `Item`,
// `Type`, `GpuStruct` and `GpuStage` variant, as the Rust parser builds them.
module syntax_dump_test;

/// `items.j3`.
fn itemsCase(b: &Bld): File {
    let thisP = b.param("this", b.tref(b.tgen("P", b.ts([b.tn("T"), b.tn("U")]))));
    let decls = List<LibFnDecl>.new(b.arena);
    decls.push(LibFnDecl { span: b.sp, name: b.id("puts"), params: b.params([b.param("s", b.tref(b.tn("u8")))]),
        ret: Option.Some(b.tn("int")), symbol: Option.Some("puts") });
    decls.push(LibFnDecl { span: b.sp, name: b.id("abort"), params: b.noParams(), ret: Option.None, symbol: Option.None });

    // struct P
    let x = b.fieldItem("x", b.tn("T"), Option.Some(b.int(0)));
    x.doc = "f doc";
    let y = b.fieldItem("y", b.tn("U"), Option.None);
    y.embedded = true;
    let m = b.fnItem("m", b.params([thisP]), Option.Some(b.tn("int")), b.blk([b.ret(Option.Some(b.int(1)))]));
    m.whereBounds.push(WhereBound { name: b.id("T"), bounds: b.ids(["Ord"]) });
    let p = b.structItem("P", b.fieldItems([x, y]));
    p.visPub = true;
    p.debug = true;
    p.derives = b.ids(["Eq", "Hash"]);
    p.typeParams = b.ids(["T", "U"]);
    p.bounds.push(b.ids(["Eq", "Hash"]));
    p.bounds.push(b.noIds());
    p.methods.push(m);

    // struct V
    let c = b.fieldItem("c", b.tn("vec4"), Option.None);
    c.flat = true;
    let v = b.structItem("V", b.fieldItems([b.fieldItem("pos", b.tn("vec2"), Option.None), c]));
    v.gpu = GpuStruct.Vertex;

    // enum R
    let variants = List<VariantItem>.new(b.arena);
    variants.push(VariantItem { span: b.sp, doc: "ok", name: b.id("Ok"), fields: b.ts([b.tn("T"), b.tn("int")]) });
    variants.push(VariantItem { span: b.sp, doc: "", name: b.id("Err"), fields: b.noTs() });
    let bounds = List<List<Ident>>.new(b.arena);
    bounds.push(b.noIds());
    let r = EnumItem { span: b.sp, doc: "", visPub: true, debug: false,
        tryCatch: Option.Some(TryCatch { ok: b.id("Ok"), err: b.id("Err") }), derives: b.noIds(), name: b.id("R"),
        typeParams: b.ids(["T"]), bounds: bounds, variants: variants };

    // trait Show
    let thisSelf = b.params([b.param("this", b.tn("Self"))]);
    let tms = List<TraitMethod>.new(b.arena);
    tms.push(TraitMethod { span: b.sp, name: b.id("show"), params: thisSelf, ret: Option.Some(b.tn("string")), body: Option.None });
    tms.push(TraitMethod { span: b.sp, name: b.id("d"), params: b.params([b.param("this", b.tn("Self"))]), ret: Option.None,
        body: Option.Some(b.blk([b.ret(Option.None)])) });
    let show = TraitItem { span: b.sp, doc: "", visPub: false, name: b.id("Show"), supers: b.ids(["Eq"]), methods: tms };

    let ext = ExtendItem { span: b.sp, name: b.id("P"), typeParams: b.ids(["T", "U"]),
        methods: b.fns([b.fnItem("n", b.params([thisP]), Option.None, b.noBlk())]) };
    let tl = ModLetItem { span: b.sp, doc: "", name: b.id("tl"), ty: b.tn("int"), value: Option.Some(b.int(0)), thread: true, uniform: false };
    let g = ModLetItem { span: b.sp, doc: "", name: b.id("g"), ty: b.t(Type.Array(ArrayType { len: 4, elem: b.tn("f32") })),
        value: Option.None, thread: false, uniform: true };

    // fn vs: every other type
    let vs = b.fnItem("vs", b.params([
        b.param("a", b.t(Type.Slice(SliceType { elem: b.tn("u8") }))),
        b.param("b", b.t(Type.Fn(FnType { params: b.ts([b.tn("int"), b.tn("f32")]), ret: Option.Some(b.tn("bool")) }))),
        b.param("c", b.t(Type.Closure(ClosureType { params: b.ts([b.tn("int")]), ret: Option.None, boxed: false }))),
        b.param("d", b.t(Type.Closure(ClosureType { params: b.noTs(), ret: Option.Some(b.tn("int")), boxed: true }))),
        b.param("e", b.t(Type.Tuple(TupleType { elems: b.ts([b.tn("int"), b.tn("f32")]) }))),
        b.param("f", b.t(Type.Dyn(b.id("Show"))))]), Option.None, b.noBlk());
    vs.shader = Option.Some(GpuStage.Vertex);
    let imp = b.fnItem("imp", b.noParams(), Option.None, b.noBlk());
    imp.isImpl = true;
    let pf = b.fnItem("pf", b.noParams(), Option.Some(b.tn("int")), b.blk([b.ret(Option.Some(b.int(0)))]));
    pf.doc = "fd";
    pf.visPub = true;

    let k = ConstItem { span: b.sp, doc: "c doc", visPub: true, name: b.id("K"), ty: Option.Some(b.tn("int")), value: b.int(3) };
    let l = ConstItem { span: b.sp, doc: "", visPub: false, name: b.id("L"), ty: Option.None, value: b.int(4) };
    let f = b.file("m.n", [
        Item.Use(UseItem { span: b.sp, path: b.path("j3.memory"), names: Option.Some(b.ids(["Arena", "List"])) }),
        Item.Use(UseItem { span: b.sp, path: b.path("j3.io"), names: Option.None }),
        Item.UseLib(UseLibItem { span: b.sp, libName: "libc.so.6", alias: b.id("c"), decls: decls }),
        Item.Const(k), Item.Const(l), Item.Struct(p), Item.Struct(v), Item.Enum(r), Item.Trait(show), Item.Extend(ext),
        Item.Let(tl), Item.Let(g), Item.Fn(vs), Item.Fn(imp), Item.Fn(pf),
        Item.Use(UseItem { span: b.sp, path: b.path("j3.cmp"), names: Option.Some(b.noIds()) })]);
    f.doc = "file doc";
    f.dyns.push(b.ast.sym("Show"));
    return f;
}

/// `gpu.j3`.
fn gpuCase(b: &Bld): File {
    let a = b.structItem("A", b.fieldItems([b.fieldItem("x", b.tn("vec4"), Option.None)]));
    a.gpu = GpuStruct.Varying;
    let bb = b.structItem("B", b.fieldItems([b.fieldItem("x", b.tn("vec4"), Option.None)]));
    bb.gpu = GpuStruct.VertexInstance;
    let c = b.structItem("C", b.fieldItems([b.fieldItem("x", b.tn("vec4"), Option.None)]));
    c.gpu = GpuStruct.Plain;
    let h = b.fnItem("h", b.params([b.param("x", b.tn("f32"))]), Option.Some(b.tn("f32")), b.blk([b.ret(Option.Some(b.n("x")))]));
    h.shader = Option.Some(GpuStage.Helper);
    let fs = b.fnItem("fs", b.noParams(), Option.None, b.noBlk());
    fs.shader = Option.Some(GpuStage.Fragment);
    return b.file("g", [Item.Struct(a), Item.Struct(bb), Item.Struct(c), Item.Fn(h), Item.Fn(fs)]);
}

/// `script.j3s`.
fn scriptCase(b: &Bld): File {
    let hp = b.fieldItem("hp", b.tn("int"), Option.Some(b.int(3)));
    hp.doc = "hp doc";
    let props = ScriptBlockItem { span: b.sp, fields: b.fieldItems([hp, b.fieldItem("name", b.tn("string"), Option.None)]) };
    let shared = ScriptBlockItem { span: b.sp, fields: b.fieldItems([b.fieldItem("count", b.tn("int"), Option.Some(b.int(0)))]) };
    let tick = b.fnItem("tick", b.noParams(), Option.None,
        b.blk([b.s(Stmt.AssignOp(AssignOpStmt { span: b.sp, place: b.n("hp"), op: BinOp.Sub, value: b.int(1) }))]));
    let f = b.file("script", [Item.Props(props), Item.Shared(shared),
        Item.State(ScriptLetItem { span: b.sp, name: b.id("st"), ty: Option.Some(b.tn("int")), value: b.int(0) }),
        Item.State(ScriptLetItem { span: b.sp, name: b.id("st2"), ty: Option.None, value: b.int(1) }),
        Item.Fn(tick)]);
    f.isScript = true;
    return f;
}
