// Hand-built trees of `tests/unit/syntax_dump_cases/{stmts,exprs}.j3`: every `Stmt`, `Pat`, `Expr`,
// `BinOp` and `UnaryOp` variant, as the Rust parser builds them.
module syntax_dump_test;

/// `a <op> b` with names.
fn nn(b: &Bld, op: BinOp, l: string, r: string): Id<Expr> { return b.bin(op, b.n(l), b.n(r)); }

/// The body of `fn f` in `stmts.j3`.
fn stmtsBody(b: &Bld): Block {
    let none: Option<Id<Expr>> = Option.None;
    let aGt0 = b.bin(BinOp.Gt, b.n("a"), b.int(0));
    let letA = b.s(Stmt.Let(LetStmt { span: b.sp, doc: "let doc", name: b.id("a"), ty: Option.Some(b.tn("int")), value: b.int(1) }));
    let letBuf = b.letS("buf", Option.Some(b.t(Type.Array(ArrayType { len: 64, elem: b.tn("u8") }))), b.e(Expr.Zeroed));
    let assign = b.s(Stmt.Assign(AssignStmt { span: b.sp, place: b.n("a"), value: b.int(2) }));
    let addA = b.s(Stmt.AssignOp(AssignOpStmt { span: b.sp, place: b.n("a"), op: BinOp.Add, value: b.int(1) }));
    let shlA = b.s(Stmt.AssignOp(AssignOpStmt { span: b.sp, place: b.n("a"), op: BinOp.Shl, value: b.int(1) }));
    let if1 = b.s(Stmt.If(IfStmt { span: b.sp, cond: b.bin(BinOp.Gt, b.n("a"), b.int(1)), thenBlock: b.blk([b.ret(none)]),
        elseBlock: Option.Some(b.blk([b.ret(Option.Some(b.int(3)))])) }));
    let if2 = b.s(Stmt.If(IfStmt { span: b.sp, cond: aGt0, thenBlock: b.noBlk(), elseBlock: Option.None }));
    let wh = b.s(Stmt.While(WhileStmt { span: b.sp, cond: b.e(Expr.Bool(true)), body: b.blk([b.s(Stmt.Break(JumpStmt { label: Option.None }))]) }));
    let for1 = b.s(Stmt.For(ForStmt { span: b.sp, name: b.id("i"), start: b.int(0), end: b.int(3), inclusive: true,
        body: b.blk([b.s(Stmt.Continue(JumpStmt { label: Option.None }))]) }));
    let for2 = b.s(Stmt.For(ForStmt { span: b.sp, name: b.id("i"), start: b.int(0), end: b.int(3), inclusive: false, body: b.noBlk() }));
    let each1 = b.s(Stmt.ForEach(ForEachStmt { span: b.sp, index: Option.Some(b.id("i")), name: b.id("v"), iter: b.calln("xs", b.noEs()), body: b.noBlk() }));
    let each2 = b.s(Stmt.ForEach(ForEachStmt { span: b.sp, index: Option.None, name: b.id("v"), iter: b.calln("xs", b.noEs()), body: b.noBlk() }));
    let useA = b.s(Stmt.UseLocal(UseLocalStmt { span: b.sp, name: b.id("a") }));

    let arms = List<MatchArm>.new(b.arena);
    arms.push(MatchArm { span: b.sp, pats: b.ps([b.lit(b.int(1)), b.lit(b.int(2))]), guard: Option.Some(b.bin(BinOp.Gt, b.n("a"), b.int(0))),
        body: b.noBlk(), tail: Option.Some(b.int(3)) });
    let arm = MatchArm { span: b.sp, pats: b.ps([b.p(Pat.Variant(VariantPat { span: b.sp, path: b.path("X.Y"), payload: b.ps([b.bind("b"), b.p(Pat.Wild)]) }))]),
        guard: none, body: b.noBlk(), tail: none };
    arms.push(arm);
    arm.pats = b.ps([b.p(Pat.Struct(StructPat { span: b.sp, path: b.path("P"), fields: b.pfields(["x", "y"], [b.bind("x"), b.lit(b.int(3))]), rest: true }))]);
    arms.push(arm);
    arm.pats = b.ps([b.p(Pat.Tuple(TuplePat { span: b.sp, elems: b.ps([b.bind("a"), b.bind("b")]) }))]);
    arms.push(arm);
    arm.pats = b.ps([b.p(Pat.Range(RangePat { lo: b.int(1), hi: b.int(5) }))]);
    arms.push(arm);
    arm.pats = b.ps([b.lit(b.e(Expr.Char(99)))]);
    arms.push(arm);
    arm.pats = b.ps([b.lit(b.un(UnaryOp.Neg, b.int(1)))]);
    arms.push(arm);
    let mt = b.s(Stmt.Match(MatchStmt { span: b.sp, expr: b.n("a"), arms: arms }));

    let lp1 = b.s(Stmt.LetPat(LetPatStmt { span: b.sp, pat: b.p(Pat.Struct(StructPat { span: b.sp, path: b.path("P"),
        fields: b.pfields(["x", "y"], [b.bind("x"), b.bind("y")]), rest: false })), value: b.n("p"), elseBlock: Option.None }));
    let lp2 = b.s(Stmt.LetPat(LetPatStmt { span: b.sp, pat: b.p(Pat.Variant(VariantPat { span: b.sp, path: b.path("R.Ok"), payload: b.ps([b.bind("v")]) })),
        value: b.n("r"), elseBlock: Option.Some(b.blk([b.ret(none)])) }));
    let df = b.s(Stmt.Defer(DeferStmt { span: b.sp, body: b.blk([b.exprS(b.calln("f", b.noEs()))]) }));
    let outer: Option<Ident> = Option.Some(b.id("outer"));
    let loop = b.s(Stmt.While(WhileStmt { span: b.sp, cond: b.bin(BinOp.Gt, b.n("a"), b.int(0)),
        body: b.blk([b.s(Stmt.Break(JumpStmt { label: outer })), b.s(Stmt.Continue(JumpStmt { label: outer }))]) }));
    let lab = b.s(Stmt.Labeled(LabeledStmt { span: b.sp, label: b.id("outer"), body: loop }));
    let blk = b.s(Stmt.Block(b.blk([b.letS("z", Option.None, b.int(1))])));
    return b.blk([letA, letBuf, assign, addA, shlA, b.exprS(b.calln("f", b.noEs())), if1, if2, wh, for1, for2, each1, each2, useA,
        mt, lp1, lp2, df, lab, blk]);
}

/// The body of `fn f` in `exprs.j3`.
fn exprsBody(b: &Bld): Block {
    let none: Option<Id<Expr>> = Option.None;
    let add = BinOp.Add;
    let e = b.chain(add, [b.e(Expr.BigInt(18446744073709551615)), b.e(Expr.Float(0.5)), b.e(Expr.Char(120)), b.e(Expr.Bool(true)),
        b.e(Expr.String("s\n\"\t\\\r\0é")),
        b.e(Expr.StructLit(StructLitExpr { name: b.id("P"), typeArgs: b.ts([b.tn("int")]), fields: b.inits(["x"], [b.int(1)]) })),
        b.call(b.field(b.e(Expr.TypePath(TypePathExpr { name: b.id("List"), args: b.ts([b.tn("int")]) })), "new"), b.noEs()),
        b.e(Expr.ArrayLit(ArrayLitExpr { elems: b.es([b.int(1), b.int(2)]) })),
        b.e(Expr.SliceLit(SliceLitExpr { elem: b.tn("u8"), fields: b.inits(["ptr", "len"], [b.n("p"), b.int(0)]) }))]);
    let e2 = b.chain(add, [b.e(Expr.Index(IndexExpr { base: b.n("a"), index: b.int(1) })),
        b.e(Expr.Slice(SliceExpr { base: b.n("a"), start: Option.Some(b.int(1)), end: none })),
        b.e(Expr.Slice(SliceExpr { base: b.n("a"), start: none, end: Option.Some(b.int(2)) })), b.field(b.n("a"), "b"),
        b.e(Expr.Call(CallExpr { func: b.n("id"), typeArgs: b.ts([b.tn("int")]), args: b.es([b.int(1)]) })),
        b.e(Expr.Syscall(SyscallExpr { args: b.es([b.int(1), b.int(2)]) })),
        b.e(Expr.Atomic(AtomicExpr { op: AtomicOp.Add, order: AtomicOrder.Acquire, args: b.es([b.n("p"), b.int(1)]) })),
        b.e(Expr.Atomic(AtomicExpr { op: AtomicOp.Load, order: AtomicOrder.SeqCst, args: b.es([b.n("p")]) }))]);
    let e3 = b.chain(add, [b.e(Expr.Embed(EmbedExpr { kind: EmbedKind.Text, path: "x.txt", glob: "" })),
        b.e(Expr.Embed(EmbedExpr { kind: EmbedKind.Bytes, path: "b", glob: "" })),
        b.e(Expr.Embed(EmbedExpr { kind: EmbedKind.Dir, path: "d", glob: "*.png" })),
        b.e(Expr.SizeOf(SizeOfExpr { ty: b.tn("int") })),
        b.e(Expr.UiChoice(UiChoiceExpr { set: b.tn("T"), value: b.n("a"), index: b.int(1) })),
        b.e(Expr.ScriptType("s.j3s")), b.e(Expr.ScriptLit(ScriptLitExpr { path: "t.j3s", fields: b.inits(["hp"], [b.int(3)]) })),
        b.e(Expr.SliceFrom(SliceFromExpr { ptr: b.n("p"), len: b.int(3) }))]);
    let parts = List<InterpPart>.new(b.arena);
    parts.push(InterpPart.Lit("x "));
    parts.push(InterpPart.Expr(InterpHole { expr: b.n("a") }));
    parts.push(InterpPart.Lit(" y"));
    let e4 = b.chain(add, [b.e(Expr.Cast(CastExpr { expr: b.n("a"), ty: b.tn("f32") })), b.un(UnaryOp.Neg, b.n("a")),
        b.un(UnaryOp.BitNot, b.n("a")), b.un(UnaryOp.Ref, b.n("a")), b.un(UnaryOp.Deref, b.n("a")), b.un(UnaryOp.Not, b.n("a")),
        b.e(Expr.Interpolate(InterpolateExpr { parts: parts })), b.e(Expr.Tuple(TupleExpr { elems: b.es([b.n("a"), b.n("b")]) })),
        b.e(Expr.If(IfExpr { cond: b.bin(BinOp.Gt, b.n("a"), b.int(0)), thenExpr: b.int(1), elseExpr: b.int(2) })),
        b.e(Expr.Question(QuestionExpr { expr: b.calln("f", b.noEs()) }))]);
    let arms = List<MatchArm>.new(b.arena);
    arms.push(MatchArm { span: b.sp, pats: b.ps([b.p(Pat.Wild)]), guard: none, body: b.noBlk(), tail: Option.Some(b.int(1)) });
    let cps = List<ClosureParam>.new(b.arena);
    cps.push(ClosureParam { name: b.id("x"), ty: Option.Some(b.tn("int")) });
    cps.push(ClosureParam { name: b.id("y"), ty: Option.None });
    let e5 = b.chain(add, [b.e(Expr.Match(MatchStmt { span: b.sp, expr: b.n("a"), arms: arms })),
        b.e(Expr.Closure(ClosureLit { arena: Option.Some(b.n("mem")), params: cps, ret: Option.Some(b.tn("int")),
            body: b.blk([b.ret(Option.Some(b.n("x")))]) })),
        b.e(Expr.Closure(ClosureLit { arena: none, params: List<ClosureParam>.new(b.arena), ret: Option.None, body: b.noBlk() }))]);
    // a - b * c / d % e | f & g ^ h >> i << j == k != l < m <= n > o >= p && q || r
    let arith = b.bin(BinOp.Sub, b.n("a"), b.bin(BinOp.Rem, b.bin(BinOp.Div, nn(b, BinOp.Mul, "b", "c"), b.n("d")), b.n("e")));
    let bits = b.bin(BinOp.BitOr, arith, b.bin(BinOp.BitXor, nn(b, BinOp.BitAnd, "f", "g"), b.bin(BinOp.Shl, nn(b, BinOp.Shr, "h", "i"), b.n("j"))));
    let eq = b.bin(BinOp.Ne, b.bin(BinOp.Eq, bits, b.n("k")),
        b.bin(BinOp.Ge, b.bin(BinOp.Gt, b.bin(BinOp.Le, nn(b, BinOp.Lt, "l", "m"), b.n("n")), b.n("o")), b.n("p")));
    let e6 = b.bin(BinOp.Or, b.bin(BinOp.And, eq, b.n("q")), b.n("r"));
    return b.blk([b.letS("e", Option.None, e), b.letS("e2", Option.None, e2), b.letS("e3", Option.None, e3),
        b.letS("e4", Option.None, e4), b.letS("e5", Option.None, e5), b.letS("e6", Option.None, e6)]);
}

fn stmtsCase(b: &Bld): File { return b.file("st", [Item.Fn(b.fnItem("f", b.noParams(), Option.None, stmtsBody(b)))]); }
fn exprsCase(b: &Bld): File { return b.file("ex", [Item.Fn(b.fnItem("f", b.noParams(), Option.None, exprsBody(b)))]); }
