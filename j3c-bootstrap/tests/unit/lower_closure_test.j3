// `lower` on closures: `tests/unit/lower_closure_cases/closures.j3` (captures, a nested closure, a plain-fn
// literal, a thunk, a closure in a generic struct's method, boxed closures, a boxed global) through
// `Stage.Passes` (so the IR validates), its user module dumped and compared byte for byte with
// `tests/unit/expect/lower_closure.ir` (frozen from the Rust compiler's `dump-ir`, plan 15):
// the `LABEL$closureN` fns, their `$ctx` structs and every temporary in Rust's order.
module lower_closure_test;

use j3.io;
use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use unitkit;

// Run from the repo root (as `diff.sh` does): with cwd = j3c-bootstrap/ the loader reads that `j3.toml`.
const DIR = "target/lower_closure";
const PATH = "target/lower_closure/p.j3";
const FIXTURE = "j3c-bootstrap/tests/unit/lower_closure_cases/closures.j3";

/// The text up to the second `module ` line (the program's own module; the stdlib follows).
fn userModule(s: string): string {
    let n = 0;
    for i in 0..s.len {
        if (i == 0 || s[i - 1] == 10) && i + 7 <= s.len && s[i..i + 7] == "module " {
            n += 1;
            if n == 2 { return s[0..i]; }
        }
    }
    return s;
}

fn main() {
    let up: [3]u8;
    up[0] = 46;
    up[1] = 46;
    if sys.chdir(&up[0] as ptr) != 0 { panic("cannot cd to the repo root"); }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = PATH;
    let s = Session.new(opts);
    defer s.free();
    match proc.run(["mkdir", "-p", DIR], "", s.arena) { Result.Ok(_) {} Result.Err(_) { panic("cannot run mkdir"); } }
    match io.readFile(FIXTURE, s.arena) {
        Result.Ok(src) { match io.writeFile(PATH, src) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the program"); } } }
        Result.Err(_) { panic("cannot read the fixture"); }
    }
    if !driver.run(s, Stage.Passes) {
        printLn(failText(s));
        panic("lower or validate failed");
    }
    let ours = Text.new(s.arena);
    if !driver.dumpIr(s, &ours) { panic("dump-ir failed"); }
    unitkit.expect(userModule(ours.str()), "lower_closure.ir", "lowered IR differs from tests/unit/expect/lower_closure.ir");
    printLn("lower closure ok");
}
