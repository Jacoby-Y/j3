// `namesInBlock` and `patBinds` over the hand-built bodies of `syntax_dump_test` (every `Stmt`, `Expr`
// and `Pat` arm): the names in Rust's visit order.
// J3: Says `module syntax_dump_test;` so it gets that test's parts (`syntax_walk_test/` is a symlink to
// `syntax_dump_test/`; parts are found by entry file name and must share its module).
module syntax_dump_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.base.span.{ Span, noSpan };
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ ArrayLitExpr, ArrayType, AssignOpStmt, AssignStmt, Ast, AtomicExpr, AtomicOp, AtomicOrder, BinOp, BinaryExpr,
    Block, CallExpr, CastExpr, ClosureLit, ClosureParam, ClosureType, ConstItem, DeferStmt, EmbedExpr, EmbedKind, EmbedRead, EnumItem,
    Expr, ExprStmt, ExtendItem, FieldExpr, FieldInit, FieldItem, File, FnItem, FnType, ForEachStmt, ForStmt, GenericType, GpuStage,
    GpuStruct, Ident, IfExpr, IfStmt, IndexExpr, InterpHole, InterpPart, InterpolateExpr, Item, JumpStmt, LabeledStmt, LetPatStmt,
    LetStmt, LibFnDecl, LitPat, MatchArm, MatchStmt, ModLetItem, NamedType, Param, Pat, PatField, QuestionExpr, RangePat, RefType,
    ReturnStmt, ScriptBlockItem, ScriptLetItem, ScriptLitExpr, SizeOfExpr, SliceExpr, SliceFromExpr, SliceLitExpr, SliceType, Stmt,
    StructItem, StructLitExpr, StructPat, SyscallExpr, TraitItem, TraitMethod, TryCatch, TupleExpr, TuplePat, TupleType, Type,
    TypePathExpr, UiChoiceExpr, UnaryExpr, UnaryOp, UseItem, UseLibItem, UseLocalStmt, VariantItem, VariantPat, WhereBound, WhileStmt };
use j3c.syntax.walk.{ namesInBlock, patBinds };

/// The names `namesInBlock` reports in `body`, space-separated.
fn names(ast: &Ast, arena: &Arena, body: &Block): string {
    let t = Text.new(arena);
    namesInBlock(ast, body, fn(n: Ident) { t.add(" ").add(ast.str(n.name)); });
    return t.str();
}

fn check(got: string, want: string, what: string) {
    if got != want {
        printLn(got);
        panic(what);
    }
}

fn main() {
    let s = Session.new(driver.defaults());
    let ast = Ast.new(s.arena, &s.names);
    let b = Bld.new(&ast, s.arena);
    let st = stmtsBody(&b);
    check(names(&ast, s.arena, &st), " a a a f a a xs xs a a a p r f a", "stmts names");
    let ex = exprsBody(&b);
    check(names(&ast, s.arena, &ex),
        " p a a a a id p p a p a a a a a a a a b a f a mem x a b c d e f g h i j k l m n o p q r", "exprs names");

    // the patterns of the `match` in `stmts.j3`
    let binds = Text.new(s.arena);
    match ast.stmt(st.stmts.items[14]) {
        Stmt.Match(m) {
            for i in 0..m.arms.len {
                for j in 0..m.arms.items[i].pats.len {
                    patBinds(&ast, m.arms.items[i].pats.items[j], fn(n: Ident) { binds.add(" ").add(ast.str(n.name)); });
                }
            }
        }
        _ { panic("stmt 14 is not the match"); }
    }
    check(binds.str(), " b x a b", "patBinds");
    s.free();
    printLn("syntax walk ok");
}
