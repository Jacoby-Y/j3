// The driver's dev-mode build settings: `Mode.Dev` with a `.j3s` loaded builds `<bin>-dev` in its own
// `target/.j3c` folder (Rust `devrun::dev_out`); without scripts, or in `Mode.Build`, the output is the
// manifest's. `applyFlags` is the flag half of `emitOpts`.
module driver_dev_test;

use j3.io;
use j3.memory.Arena;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use j3c.toolchain;

fn write(p: string, s: string) {
    match io.writeFile(p, s as []u8) { Result.Ok(_) {} Result.Err(_) { panic(p); } }
}

/// The output path `emitOpts` gives `dir` loaded in `mode`.
fn outOf(dir: string, mode: Mode, arena: &Arena): string {
    let o = driver.defaults();
    o.entry = dir;
    o.mode = mode;
    o.run = true;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Load) { panic("load"); }
    match driver.emitOpts(s) {
        Result.Ok(e) { return Text.new(arena).add(e.cc.out).str(); }
        Result.Err(x) { panic(x); }
    }
    return "";
}

fn main() {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-driver-dev").str();
    let rm: [3]string = ["rm", "-rf", dir];
    proc.run(rm[..], "", &mem);
    match io.makeDirs(Text.new(&mem).add(dir).add("/scripts").str()) { Result.Ok(_) {} Result.Err(_) { panic("mkdir"); } }
    write(Text.new(&mem).add(dir).add("/j3.toml").str(), "[package]\nname = \"devt\"\nentry = \"main.j3\"\n");
    write(Text.new(&mem).add(dir).add("/main.j3").str(), "module devt;\nfn main() {}\n");
    let plain = outOf(dir, Mode.Dev, &mem);
    if !text.endsWith(plain, "/target/devt") || text.contains(plain, "devt-dev") { panic(plain); }

    write(Text.new(&mem).add(dir).add("/scripts/s.j3s").str(), "pub fn f() {}\n");
    write(Text.new(&mem).add(dir).add("/main.j3").str(), "module devt;\nconst S = @script(\"scripts/s.j3s\");\nfn main() { let s = S {}; s.f(); }\n");
    let dev = outOf(dir, Mode.Dev, &mem);
    if !text.endsWith(dev, "/target/.j3c/host/devt-dev/devt-dev") { panic(dev); }
    let build = outOf(dir, Mode.Build, &mem);
    if build != plain { panic(build); }

    // `--opt`, `--fast`, `--release` and `build`'s default output.
    let o = driver.defaults();
    o.release = true;
    let e = toolchain.defaultEmitOpts(&mem);
    driver.applyFlags(&o, &e);
    if !e.cc.release || e.cc.debug || e.incremental || e.cc.opt != "s" || e.cc.out != "target/a.out" { panic("release flags"); }
    let o2 = driver.defaults();
    o2.opt = "2";
    o2.fast = true;
    o2.run = true;
    let e2 = toolchain.defaultEmitOpts(&mem);
    driver.applyFlags(&o2, &e2);
    if e2.cc.opt != "2" || e2.cc.debug || e2.cc.out.len != 0 { panic("opt/fast flags"); }
    proc.run(rm[..], "", &mem);
}
