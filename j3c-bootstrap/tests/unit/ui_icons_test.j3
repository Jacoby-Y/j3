// ui/icons: Rust's tests (`shapes_become_path_data`, `bootstrap_lookup_and_suggestions`), strings cut from
// stage 0 (the icon data in `dump-ir` of a scratch project, the `did you mean` list of `dump-ui`), and
// `loadDir` on a temp folder.
module ui_icons_test;

use j3.io;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, startsWith };
use j3c.ui.icons.{ Icon, find, fromSvg, loadDir, suggest };

fn svg(a: &Arena, s: string): string {
    match fromSvg(s, a) {
        Result.Ok(d) { return d; }
        Result.Err(e) { panic(`fromSvg failed: {e}`); }
    }
    return "";
}

fn svgErr(a: &Arena, s: string): string {
    match fromSvg(s, a) {
        Result.Ok(_) { panic(`fromSvg took: {s}`); }
        Result.Err(e) { return e; }
    }
    return "";
}

fn same(what: string, got: string, want: string) {
    if got == want { return; }
    io.printLn(got);
    io.printLn(want);
    panic(what);
}

fn sug(a: &Arena, name: string, project: &List<Icon>): string {
    let v = suggest(name, project, a);
    let t = Text.new(a);
    for i in 0..v.len { t.add(if i > 0 { "," } else { "" }).add(v.items[i]); }
    return t.str();
}

fn write(p: string, s: string) {
    match io.writeFile(p, s as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a temp file"); } }
}

fn main() {
    let arena = Arena.create(1 << 22);
    let a = &arena;
    let none = List<Icon>.new(a);

    // Rust `shapes_become_path_data`
    same("circle", svg(a, "<svg viewBox=\"0 0 16 16\"><circle cx=\"8\" cy=\"8\" r=\"8\"/></svg>"), "0 0 16 16|NM0 8 A8 8 0 1 0 16 8 A8 8 0 1 0 0 8 Z");
    let r = svg(a, "<svg viewBox=\"0 0 16 16\"><rect width=\"4\" height=\"12\" rx=\"1\" transform=\"matrix(1 0 0 -1 6 15)\"/></svg>");
    if !startsWith(r, "0 0 16 16|NM7 3 H9 A1 1 0 0 1 10 4 V14") { panic(r); }
    same("evenodd", svg(a, "<svg viewBox=\"0 0 16 16\"><path fill-rule=\"evenodd\" d=\"M0 0h16v16H0z M4 4h8v8H4z\"/><path d=\"M1 1h1v1z\"/></svg>"),
        "0 0 16 16|EM0 0h16v16H0z M4 4h8v8H4z|NM1 1h1v1z");
    same("rotate", svgErr(a, "<svg viewBox=\"0 0 1 1\"><path transform=\"rotate(4)\" d=\"M0 0\"/></svg>"), "`transform` on `<path>` is not supported; flatten it in the editor first");
    same("line", svgErr(a, "<svg viewBox=\"0 0 1 1\"><line x1=\"0\"/></svg>"), "`<line>` is not supported (path, circle, ellipse, rect, polygon, polyline)");

    // stage 0 (`dump-ir` of a project with this file as icons/shapes.svg): no viewBox, `px`, a flipped
    // rounded rect, a scaled ellipse, a polygon, numbers printed as Rust `{}`
    let shapes = "<svg width=\"10px\" height=\"2.5\"><rect x=\"1\" y=\"1\" width=\"4\" height=\"12\" rx=\"1\" transform=\"matrix(1 0 0 -1 6 15)\"/><ellipse cx=\"0.1\" cy=\"1e-7\" rx=\"2\" ry=\"3\" transform=\"scale(1.5)\"/><polygon points=\"0,0  1,1\n 2,0\"/></svg>";
    same("shapes", svg(a, shapes),
        "0 0 10 2.5|NM8 2 H10 A1 1 0 0 1 11 3 V13 A1 1 0 0 1 10 14 H8 A1 1 0 0 1 7 13 V3 A1 1 0 0 1 8 2 Z|NM-2.85 0.00000015 A3 4.5 0 1 0 3.15 0.00000015 A3 4.5 0 1 0 -2.85 0.00000015 Z|NM0,0 1,1 2,0Z");
    same("big", svg(a, "<svg viewBox=\" 0  0 9 9 \"><rect width=\"1e21\" height=\"3\"/></svg>"), "0 0 9 9|NM0 0 H1000000000000000000000 V3 H0 Z");
    // Rust `f64::min`/`max` skip a NaN operand
    same("nan", svg(a, "<svg viewBox=\"0 0 9 9\"><rect x=\"1\" y=\"inf\" width=\"nan\" height=\"2\" rx=\"nan\" ry=\"1\"/></svg>"), "0 0 9 9|NM1 inf H1 Vinf H1 Z");
    same("no svg", svgErr(a, "<path d=\"M0 0\"/>"), "no `<svg>` element");
    same("empty", svgErr(a, "<svg viewBox=\"0 0 1 1\"><path fill=\"none\" d=\"M0 0\"/></svg>"), "no filled shapes");
    same("unclosed", svgErr(a, "<svg viewBox=\"0 0 1 1\""), "unclosed tag");
    same("g", svgErr(a, "<svg viewBox=\"0 0 1 1\"><g transform=\"scale(2)\"><path d=\"M0 0\"/></g></svg>"), "a `<g transform>` is not supported; flatten it in the editor first");
    same("skew", svgErr(a, "<svg viewBox=\"0 0 1 1\"><rect transform=\"matrix(1 2 0 1 0 0)\"/></svg>"), "`transform=\"matrix(1 2 0 1 0 0)\"` on `<rect>`: only matrix(a 0 0 d e f), translate and scale are supported");

    // Rust `bootstrap_lookup_and_suggestions`
    match find("trash", &none) { Option.Some(d) { if !startsWith(d, "0 0 16 16|") { panic("trash data"); } } Option.None { panic("no trash"); } }
    match find("trash-can", &none) { Option.Some(_) { panic("trash-can"); } Option.None {} }
    let own = List<Icon>.new(a);
    own.push(Icon { name: "trash", data: "0 0 1 1|NM0 0" });
    match find("trash", &own) { Option.Some(d) { same("own first", d, "0 0 1 1|NM0 0"); } Option.None { panic("no own trash"); } }
    // the last line of the table is found
    match find("zoom-out", &none) { Option.Some(_) {} Option.None { panic("no zoom-out"); } }

    // stage 0 `dump-ui`: `did you mean ..` of an unknown icon
    same("trash-can", sug(a, "trash-can", &none), "trash,trash-fill,cash-coin");
    same("zzzz", sug(a, "zzzz", &none), "123,alt,amd");
    same("arow-left", sug(a, "arow-left", &none), "arrow-left,caret-left,arrow-up-left");
    same("empty name", sug(a, "", &none), "x,at,hr");
    same("x-circle-fil", sug(a, "x-circle-fil", &none), "x-circle-fill,x-circle,0-circle-fill");
    let mine = List<Icon>.new(a);
    mine.push(Icon { name: "trash-cab", data: "" });
    same("project names too", sug(a, "trash-can", &mine), "trash-cab,trash,trash-fill");

    // loadDir: `*.svg` by name order, the stem is the name; a missing folder is no icons; errors name the file
    let dir = match io.tempDir("", "j3boot_icons_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    let pb = Text.new(a).add(dir).add("/b.svg").str();
    let pa = Text.new(a).add(dir).add("/a.x.svg").str();
    let pt = Text.new(a).add(dir).add("/note.txt").str();
    let ph = Text.new(a).add(dir).add("/.svg").str();
    write(pb, "<svg viewBox=\"0 0 2 2\"><path d=\"M0 0h1\"/></svg>");
    write(pa, "<svg viewBox=\"0 0 1 1\"><path d=\"M1 1\"/></svg>");
    write(pt, "not an icon");
    write(ph, "not an icon");
    match loadDir(dir, a) {
        Result.Ok(v) {
            if v.len != 2 || v.items[0].name != "a.x" || v.items[1].name != "b" { panic("loadDir names"); }
            same("loadDir data", v.items[1].data, "0 0 2 2|NM0 0h1");
        }
        Result.Err(e) { panic(e); }
    }
    write(pb, "<svg viewBox=\"0 0 2 2\"></svg>");
    match loadDir(dir, a) {
        Result.Ok(_) { panic("a bad icon loaded"); }
        Result.Err(e) { same("loadDir error", e, Text.new(a).add(pb).add(": no filled shapes").str()); }
    }
    io.remove(pa);
    io.remove(pb);
    io.remove(pt);
    io.remove(ph);
    io.removeDir(dir);
    match loadDir(dir, a) { Result.Ok(v) { if v.len != 0 { panic("missing folder"); } } Result.Err(e) { panic(e); } }
}
