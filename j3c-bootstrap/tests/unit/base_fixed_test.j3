// `base/fixed.pushFixed` against Rust `{:.0}` / `{:.2}` / `{:.6}` (printed by rustc 2026-11, ties to even).
module base_fixed_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ Text, f64FromBits };
use j3c.base.fixed.pushFixed;

fn check(x: f64, want0: string, want2: string, want6: string, a: &Arena) {
    let ws: [3]string = [want0, want2, want6];
    let ds: [3]int = [0, 2, 6];
    for i in 0..3 {
        let t = Text.new(a);
        pushFixed(&t, x, ds[i]);
        if t.str() != ws[i] {
            printLn(`{x} at {ds[i]}: got {t.str()}, want {ws[i]}`);
            panic("pushFixed differs from Rust");
        }
    }
}

fn main() {
    let a = Arena.create(1 << 16);
    check(0.0, "0", "0.00", "0.000000", &a);
    check(-0.0, "-0", "-0.00", "-0.000000", &a);
    check(0.125, "0", "0.12", "0.125000", &a);
    check(0.135, "0", "0.14", "0.135000", &a);
    check(0.005, "0", "0.01", "0.005000", &a);
    check(0.015, "0", "0.01", "0.015000", &a);
    check(0.025, "0", "0.03", "0.025000", &a);
    check(1.5, "2", "1.50", "1.500000", &a);
    check(2.5, "2", "2.50", "2.500000", &a);
    check(-0.001, "-0", "-0.00", "-0.001000", &a);
    check(123456.789, "123457", "123456.79", "123456.789000", &a);
    check(0.0000001, "0", "0.00", "0.000000", &a);
    check(0.5, "0", "0.50", "0.500000", &a);
    check(3.14159265358979, "3", "3.14", "3.141593", &a);
    check(1e21, "1000000000000000000000", "1000000000000000000000.00", "1000000000000000000000.000000", &a);
    check(1180591620717411303424.0, "1180591620717411303424", "1180591620717411303424.00", "1180591620717411303424.000000", &a);
    check(-2.675, "-3", "-2.67", "-2.675000", &a);
    check(1.0 / 3.0, "0", "0.33", "0.333333", &a);
    check(0.0000005, "0", "0.00", "0.000000", &a);
    check(0.0000015, "0", "0.00", "0.000002", &a);
    check(999.9999996, "1000", "1000.00", "1000.000000", &a);
    check(f64FromBits(0x0010000000000000), "0", "0.00", "0.000000", &a);
    let t = Text.new(&a);
    pushFixed(&t, f64FromBits(0x7ff8000000000000), 2); t.add(" ");
    pushFixed(&t, f64FromBits(0x7ff0000000000000), 2); t.add(" ");
    pushFixed(&t, f64FromBits(0xfff0000000000000), 2);
    if t.str() != "NaN inf -inf" { printLn(t.str()); panic("pushFixed specials"); }
}
