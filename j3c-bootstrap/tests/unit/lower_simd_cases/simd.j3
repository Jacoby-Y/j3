module p;
use j3.io.printLn;

struct P { v: vec4i; f: vec4f; }

fn two(): f32 { return 2.0; }
fn mk(): vec4i { return vec4i(8, -9, 10, 11); }
/// A negative float literal given where an `f16` operand is wanted (Rust: an rvalue, held in `_tN`).
fn halfBack(h: f16): f32 { return f32(h); }

fn peekIt(xs: []f32): f32 { let s = @vsum(@vload(xs, 0)); return s; }

fn main() {
    let a = vec4i(1, 2, 3, 4);
    let b = vec4i(7);
    let c = a / b;
    let d = mk() / a;
    let p = P { v: a, f: vec4f(1.5) };
    p.v /= b;
    p.v /= 2;
    p.v += 1;
    p.v <<= 2;
    p.v = p.v / a;
    p.v.x = 5;
    p.v[3] = p.v.y + 1;
    let e = 3 * a;
    let e2 = a * 3 - 1;
    let k: i32 = 5;
    let e3 = k + a;
    let e4 = a ^ k;
    let e5 = (a & b) | (a >> 1);
    let f = two() * p.f;
    let f2 = p.f * two() + 1.0;
    let f3 = 2.0 * p.f;
    let f4 = 1.0 - p.f / 4.0;
    f4 *= f3;
    f4 -= 0.5;
    f4.w = f4.x * 2.0;
    let m = @vmin(f, f2);
    let m2 = @vmax(a, b);
    let q = @vsqrt(f2);
    let ab = @vabs(mk());
    let s = @vsum(ab);
    let sf = @vsum(f4);
    let sh = @vshuffle(a, 3, 2, 1, 0);
    let fi = @vfloat(sh);
    let it = @vint(f4);
    let arr: [8]f32;
    for i in 0..8 { arr[i] = f32(i); }
    let sl: []f32 = arr[0..8];
    let ld = @vload(sl, 2);
    let ld2 = @vload(arr, 4);
    @vstore(sl, 1, ld + ld2);
    let ia: [6]i32;
    @vstore(ia, 2, a);
    let li = @vload(ia, 1);
    let ps = &sl;
    let l3 = @vload(ps, 0);
    let n = 4;
    @vstore(arr, n, l3 * 2.0);
    printLn(`{c.x} {c.y} {d.z} {d.w} {p.v.x} {p.v.y} {p.v.z} {p.v.w}`);
    printLn(`{e.x} {e2.y} {e3.z} {e4.w} {e5.x} {f.x} {f2.y} {f3.z} {f4.w}`);
    printLn(`{m.x} {m2.y} {q.z} {ab.y} {s} {sf} {sh.x} {fi.y} {it.z} {ld.x} {ld2.w} {li.y} {l3.z}`);
    printLn(`{arr[1]} {arr[4]} {arr[7]} {ia[5]} {peekIt(sl)} {@sizeof(vec4f)} {@sizeof(f16)}`);
    let h: f16 = 1.5;
    let h2 = f16(0.1);
    let h3: f16;
    let hs: [3]f16;
    hs[1] = f16(65520.0);
    hs[2] = -2.5;
    printLn(`{f32(h)} {f64(h2)} {f32(h3)} {f32(hs[1])} {f32(hs[2])} {f32(f16(k))}`);
    printLn(`{halfBack(-1.5)} {halfBack(0.25)}`);
}
