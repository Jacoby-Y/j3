// Sample builders: struct allocation and the small hand-built fn bodies.
//
// Part of module ir_samples.
// Port of: j3c/src/ir/samples/bodies.rs
module ir_samples;

fn allocStruct(cx: &IrCx, path: List<Sym>, name: string, debug: bool): Id<StructDef> {
    return cx.allocStruct(StructDef { moduleName: path, name: cx.internName(name), doc: "", fields: List<FieldDef>.new(cx.arena),
        packed: false, debug: debug, span: noSpan(), tyArgs: List<TyArg>.new(cx.arena), script: Option.None });
}

fn scaleBody(cx: &IrCx, vec2Ref: Id<TyKind>, f32: Id<TyKind>, xField: FieldId, yField: FieldId, span: Span): Body {
    let b = BodyBuilder.new(cx.arena, cx.common.void);
    let thisL = b.param(cx.internName("this"), vec2Ref, span);
    let s = b.param(cx.internName("s"), f32, span);
    let thisP = b.localPlace(thisL, span);
    let sP = b.localPlace(s, span);
    let hdr = b.deref(cx, thisP, span);
    let x = b.field(cx, clonePlace(cx.arena, hdr), xField, span);
    let y = b.field(cx, hdr, yField, span);
    b.assignOp(span, x, BinOp.Mul, Operand.Copy(clonePlace(cx.arena, sP)));
    b.assignOp(span, y, BinOp.Mul, Operand.Copy(sP));
    return b.finish();
}

fn bumpBody(cx: &IrCx, sliceInt: Id<TyKind>, intTy: Id<TyKind>, span: Span): Body {
    let b = BodyBuilder.new(cx.arena, cx.common.void);
    let xs = b.param(cx.internName("xs"), sliceInt, span);
    let i = b.param(cx.internName("i"), intTy, span);
    let elem = b.index(cx, b.localPlace(xs, span), Operand.Copy(b.localPlace(i, span)), span);
    b.assignOp(span, elem, BinOp.Add, opInt(span, intTy, 1));
    return b.finish();
}

fn tickBody(cx: &IrCx, gameRef: Id<TyKind>, memField: FieldId, runningField: FieldId, checkpointId: Id<Func>, checkpointTy: Id<TyKind>,
    span: Span): Body {
    let c = cx.common;
    let b = BodyBuilder.new(cx.arena, c.void);
    let g = b.param(cx.internName("g"), gameRef, span);
    let game = b.deref(cx, b.localPlace(g, span), span);
    let memPtr = b.field(cx, clonePlace(cx.arena, game), memField, span);
    // `g.mem` is `&Arena`. Deref to the header, then take `&` for the method.
    let header = b.deref(cx, memPtr, span);
    let thisArg = b.refTmp(cx, cx.internName("arena_ref"), header, span);
    let call = Rvalue.call(span, c.int, opFnAddr(span, checkpointTy, checkpointId), ops(cx, [thisArg]));
    let frame = b.tmp(cx.internName("frame"), c.int, span);
    b.assign(span, b.localPlace(frame, span), call);
    let running = b.field(cx, game, runningField, span);
    b.assign(span, running, Rvalue.useOp(span, opBool(span, c.bool, false)));
    return b.finish();
}

fn checkpointBody(cx: &IrCx, arenaRef: Id<TyKind>, usedField: FieldId, span: Span): Body {
    let b = BodyBuilder.new(cx.arena, cx.common.void);
    let thisL = b.param(cx.internName("this"), arenaRef, span);
    let header = b.deref(cx, b.localPlace(thisL, span), span);
    let used = b.field(cx, header, usedField, span);
    b.returnOp(span, Option.Some(Operand.Copy(used)));
    return b.finish();
}

/// `@syscall(60, code);` (exit) as a one-statement block.
pub fn exitBlock(cx: &IrCx, span: Span, code: u64): Block {
    let c = cx.common;
    let call = Rvalue.syscall(span, c.int, opInt(span, c.int, 60), ops(cx, [opInt(span, c.int, code)]));
    let stmts = List<Stmt>.new(cx.arena);
    stmts.push(Stmt.expr(span, c.void, call));
    return Block { stmts: stmts };
}

fn failIfNe(b: &BodyBuilder, cx: &IrCx, span: Span, lhs: Operand, rhs: Operand, tmpName: string) {
    let c = cx.common;
    let tmp = b.letLocal(cx.internName(tmpName), c.bool, span);
    b.assign(span, b.localPlace(tmp, span), Rvalue.binary(span, c.bool, BinOp.Ne, lhs, rhs));
    b.ifThen(span, Operand.Copy(b.localPlace(tmp, span)), exitBlock(cx, span, 1));
}
