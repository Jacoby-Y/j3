// `backend/bc/op.j3` against the VM's table: every `const NAME: u16 = N` of `$J3_STDLIB/j3/script/opcodes.j3`
// (else `../j3c/stdlib/...`, cwd j3c-bootstrap) must be the op whose `opName` upper-cased (`.` -> `_`) is NAME,
// and `ALL_OPS` must list every op once in code order. Also the call kinds and the register-class tables.
module bc_op_test;

use j3.io;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, lines, parseInt, startsWith, trim, find };
use j3.option.Option;
use j3c.backend.bc.{ CallKind, Class, OP_COUNT, Op, opAt, canonical, extOp, isJump, loadOp, opCode, opName, storeOp };

struct Const { name: string; value: int; }

fn stdlibName(op: Op, arena: &Arena): string {
    let n = opName(op);
    let t = Text.new(arena);
    for i in 0..n.len {
        let c = n[i];
        if c == u8('.') { t.push(u8('_')); }
        else if c >= u8('a') && c <= u8('z') { t.push(c - 32); }
        else { t.push(c); }
    }
    return t.str();
}

fn lookup(cs: &List<Const>, name: string): int {
    for i in 0..cs.len { if cs.items[i].name == name { return cs.items[i].value; } }
    panic(`opcodes.j3 has no const {name}`);
    return -1;
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;
    let root = sys.env("J3_STDLIB");
    if root.len == 0 { root = "../j3c/stdlib"; }
    let p = Text.new(a).add(root).add("/j3/script/opcodes.j3").str();
    let src = match io.readFile(p, a) { Result.Ok(b) { b as string } Result.Err(_) { panic(`cannot read {p}`) } };
    // `const NAME: u16 = N;` (ops) and `const NAME: u32 = N;` (call kinds)
    let ops = List<Const>.new(a);
    let kinds = List<Const>.new(a);
    for raw in lines(src) {
        let l = trim(raw);
        if !startsWith(l, "const ") { continue; }
        let colon = find(l, ":");
        let eq = find(l, "= ");
        let semi = find(l, ";");
        if colon < 0 || eq < 0 || semi < eq { panic(`odd const line: {l}`); }
        let v = match parseInt(l[eq + 2..semi], 10) { Option.Some(n) { n } Option.None { panic(`odd value: {l}`) } };
        let c = Const { name: l[6..colon], value: v };
        if find(l, ": u16 ") >= 0 { ops.push(c); } else { kinds.push(c); }
    }
    if ops.len != OP_COUNT { panic(`opcodes.j3 has {ops.len} u16 consts, op.j3 {OP_COUNT} ops`); }
    let jumps = 0;
    for i in 0..OP_COUNT {
        let op = opAt(i);
        if int(opCode(op)) != i + 1 { panic(`opAt({i}) ({opName(op)}) has code {opCode(op)}`); }
        let want = lookup(&ops, stdlibName(op, a));
        if want != int(opCode(op)) { panic(`{opName(op)}: op.j3 {opCode(op)}, opcodes.j3 {want}`); }
        if isJump(op) { jumps += 1; }
    }
    if jumps != 13 { panic(`isJump covers {jumps} ops, Rust 13`); }
    if lookup(&kinds, "CALL_LOCAL") != int(CallKind.Local) || lookup(&kinds, "CALL_SCRIPT") != int(CallKind.Script)
        || lookup(&kinds, "CALL_NATIVE") != int(CallKind.Native) { panic("call kinds differ from opcodes.j3"); }
    // register classes (Rust `canonical`, `load_op`, `store_op`, `ext_op`)
    if canonical(Class.I8, 0xff) != 0xffffffffffffffff { panic("canonical i8 -1"); }
    if canonical(Class.U8, 0x1ff) != 0xff { panic("canonical u8"); }
    if canonical(Class.I32, 0x80000000) != 0xffffffff80000000 { panic("canonical i32 min"); }
    if canonical(Class.U32, 0xffffffffffffffff) != 0xffffffff { panic("canonical u32"); }
    if canonical(Class.Bool, 5) != 1 || canonical(Class.F32, 0x100000001) != 1 || canonical(Class.I64, 7) != 7 { panic("canonical bool/f32/i64"); }
    if loadOp(Class.Bool) != Op.Ld8u || loadOp(Class.F32) != Op.Ld32u || loadOp(Class.Ptr) != Op.Ld64 || loadOp(Class.I16) != Op.Ld16s { panic("loadOp"); }
    if storeOp(1) != Op.St8 || storeOp(4) != Op.St32 || storeOp(16) != Op.St64 { panic("storeOp"); }
    match extOp(Class.U16) { Option.Some(o) { if o != Op.Zext16 { panic("extOp u16"); } } Option.None { panic("extOp u16 none"); } }
    match extOp(Class.I64) { Option.Some(_) { panic("extOp i64"); } Option.None {} }
    arena.destroy();
}
