// `j3c doc` (Rust `doc/tests.rs`): a script's doc, the index, guide sections covering their page, item and bare
// name lookups, ambiguous names, --short, search, page contents, the docs id. Runs with cwd = j3c-bootstrap/.
// The scripts-module and recipe tests are tool cases (`tests/tool/doc.txt`: they need a project cwd / NEW).
module doc_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, startsWith };
use j3c.doc.{ docText, docsId, guideText, sections };

fn ok(args: []string, short: bool, a: &Arena): string {
    match docText(args, short, a) {
        Result.Ok(s) { return s; }
        Result.Err(e) { panic(e); }
    }
    return "";
}

fn isErr(args: []string, a: &Arena): bool {
    match docText(args, false, a) { Result.Ok(_) { return false; } Result.Err(_) { return true; } }
}

fn has(text: string, part: string) {
    if !contains(text, part) { panic(Text.scratch().add("missing `").add(part).add("` in:\n").add(text).str()); }
}

/// Guide page `name`, or a panic.
fn page(name: string, a: &Arena): string {
    match guideText(name, a) { Option.Some(t) { return t; } Option.None { panic(name); } }
    return "";
}

fn main() {
    let mem = Arena.create(1 << 22);
    defer mem.destroy();
    let a = &mem;

    // script_doc_lists_props_shared_state_and_calls
    let door: [1]string = ["../speculative/11_script/scripts/door.j3s"];
    let s = ok(door[..], false, a);
    has(s, "hinge: Node (required)");
    has(s, "openAngle: f32 = 90.0");
    has(s, "shared: one value for every instance");
    has(s, "doorsOpened: int = 0");
    has(s, "state: each instance's own; private");
    has(s, "open = false");
    has(s, "fn toggle()");
    if contains(s, "fn smooth(") { panic("private fn shown"); }

    // index_lists_tasks_modules_and_provenance
    let idx = ok(door[0..0], false, a);
    has(idx, "stdlib embedded, docs ");
    has(idx, "j3c doc search <word>");
    has(idx, "    j3.app ");
    has(idx, "    j3.gfx.mesh ");
    has(idx, "internal (not for games): ");
    has(idx, " j3.scene3d.editor.paste ");
    has(idx, "j3c doc threads");
    has(idx, "j3.thread ");
    if contains(idx, "Main thread only") || idx.len >= 18000 { panic("index too long"); }

    // guide_pages_split_into_sections_that_cover_them
    let pages: [16]string = ["lang", "j3ui", "j3ui-immediate", "css", "testing", "editor", "urp", "threads", "term", "i18n",
        "ship", "packages", "android", "steam", "j2", "shaders"];
    for p in 0..pages.len {
        let txt = page(pages[p], a);
        let all = sections(txt, a);
        let joined = Text.new(a);
        for i in 0..all.len {
            if all.items[i].name.len == 0 || all.items[i].hi <= all.items[i].lo { panic(pages[p]); }
            joined.add(txt[all.items[i].lo..all.items[i].hi]);
        }
        if joined.str() != txt { panic(Text.new(a).add(pages[p]).add(" lost text").str()); }
    }
    let css = page("css", a);
    if sections(css, a).len < 10 { panic("css sections"); }
    let lay: [2]string = ["css", "layout"];
    let layout = ok(lay[..], false, a);
    if !startsWith(layout, "Layout") || layout.len >= css.len / 4 { panic(layout); }
    let miss: [2]string = ["css", "nosuch"];
    if !isErr(miss[..], a) { panic("css nosuch"); }

    // app_create_is_documented_with_its_source
    let q1: [2]string = ["j3.app", "App.create"];
    let t1 = ok(q1[..], false, a);
    has(t1, "fn App<W>.create(");
    has(t1, "at j3/app.j3:");
    has(t1, "(embedded in j3c)");
    if contains(t1, "fn App<W>.run(") { panic(t1); }
    let q2: [1]string = ["j3.app.App.create"];
    if ok(q2[..], false, a) != t1 { panic("dotted"); }

    // ambiguous_names_list_qualified_choices
    let q3: [2]string = ["j3.math", "length"];
    let t3 = ok(q3[..], false, a);
    has(t3, "names more than one item");
    has(t3, "j3c doc j3.math Vec3.length");
    has(t3, "j3c doc j3.math Quat.length");
    let q4: [2]string = ["j3.math", "Vec3.length"];
    let t4 = ok(q4[..], false, a);
    has(t4, "fn Vec3.length(");
    if contains(t4, "Quat") { panic(t4); }

    // a_bare_name_finds_its_module, defaults_and_constant_values_show, short_view_fits_a_screen
    let q5: [1]string = ["textureFromCanvas"];
    let t5 = ok(q5[..], false, a);
    has(t5, "module j3.game");
    has(t5, "fn textureFromCanvas(");
    let q6: [1]string = ["noSuchNameAnywhere"];
    if !isErr(q6[..], a) { panic("noSuchNameAnywhere"); }
    let q7: [2]string = ["j3.math", "PI"];
    has(ok(q7[..], false, a), "const PI: f32 = 3.14159");
    let q8: [1]string = ["j3.game"];
    let t8 = ok(q8[..], true, a);
    has(t8, "fn: ");
    has(t8, "textureFromCanvas");
    has(t8, "signatures and comments: `j3c doc j3.game`");

    // missing_item_errors
    let q9: [2]string = ["j3.app", "App.nope"];
    match docText(q9[..], false, a) { Result.Ok(got) { panic(got); } Result.Err(e) { has(e, "App.nope"); } }

    // search_finds_names_then_comments, testing_and_css_pages_are_found
    let q10: [2]string = ["search", "textureFromCanvas"];
    has(ok(q10[..], false, a), "j3c doc j3.game textureFromCanvas");
    let q11: [2]string = ["search", "zzqqxx"];
    if !isErr(q11[..], a) { panic("zzqqxx"); }
    let q12: [2]string = ["search", "imgdiff"];
    has(ok(q12[..], false, a), "j3c doc testing");
    let q13: [2]string = ["search", "HÉLLO"];
    has(ok(q13[..], false, a), "j3c doc ");

    // lang_page_lists_shipped_forms, j3ui_page_lists_the_contract
    let lang = page("lang", a);
    has(lang, "TryCatch");
    has(lang, "`j3ui`");
    has(lang, "`vec4i`");
    has(lang, "`this`");
    let imm = page("@j3ui", a);
    has(imm, "@j3ui shopRow");
    has(imm, "`worldLabel3`");
    if contains(lang, "@TYPES@") || contains(imm, "@CALL@") { panic("placeholder left"); }

    // the docs id: 8 lower-case hex digits
    let id = docsId(a);
    if id.len != 8 { panic(id); }
    for i in 0..id.len { if !((id[i] >= '0' && id[i] <= '9') || (id[i] >= 'a' && id[i] <= 'f')) { panic(id); } }
}
