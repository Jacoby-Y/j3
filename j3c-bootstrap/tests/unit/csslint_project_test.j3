// `cmd/csslint.lintProject` on the tests/proj/lint_* fixtures (Rust csslint.rs tests: exact lines, config
// silences, no false positives, nothing to lint). cwd = j3c-bootstrap/.
module csslint_project_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.fsx;
use j3c.cmd.csslint.lintProject;
use j3c.project.manifest.parseManifest;

fn lint(dir: string, a: &Arena): List<string> {
    let root = Text.new(a).add("tests/proj/").add(dir).str();
    let text = match fsx.readText(Text.new(a).add(root).add("/j3.toml").str(), a) { Result.Ok(t) { t } Result.Err(e) { panic(e); } };
    let m = match parseManifest(text, root, a) { Result.Ok(m) { m } Result.Err(e) { panic(e); } };
    match lintProject(&m, a) {
        Result.Ok(w) { return w; }
        Result.Err(e) { panic(e); }
    }
}

fn expect(dir: string, want: []string, a: &Arena) {
    let got = lint(dir, a);
    let bad = got.len != want.len;
    for i in 0..got.len { if !bad && got.items[i] != want[i] { bad = true; } }
    if bad {
        for i in 0..got.len { printLn(got.items[i]); }
        panic(`{dir}: lines differ from Rust`);
    }
}

fn main() {
    let a = Arena.create(1 << 20);
    let css: [10]string = [
        "warning: ui/theme.css:3:9: `var(--missing)` has no fallback and `--missing` is not declared in any stylesheet [undefined-var]",
        "warning: ui/App.j3ui:2:26: `style:width=\"revert\"` acts as `unset` (inline styles have no tag defaults to roll back to) [style-revert]",
        "warning: ui/App.j3ui:7:20: `color` is declared twice in this rule; the earlier one (line 7) is overridden [duplicate-decl]",
        "warning: ui/App.j3ui:8:11: `top` does nothing on an element that is not positioned: add `position: relative`, `absolute`, `fixed` or `sticky` [offset-without-position]",
        "warning: ui/App.j3ui:9:1: selector `.hit.q9` matches no element of this component: nothing has the class `.q9` [never-matches]",
        "warning: ui/App.j3ui:11:13: `text-overflow` does nothing without `overflow` (hidden, clip, auto or scroll) on the same element [ellipsis-without-overflow]",
        "warning: ui/App.j3ui:14:1: selector `.gone2` matches no element of this component: nothing has the class `.gone2` [never-matches]",
        "warning: ui/App.j3ui:15:1: selector `div.box.nope` matches no element of this component: nothing has the class `.nope` [never-matches]",
        "warning: ui/App.j3ui:17:1: selector `#other` matches no element of this component [never-matches]",
        "warning: ui/App.j3ui:18:1: selector `section` matches no element of this component: it has no `<section>` [never-matches]",
    ];
    expect("lint_css", css[0..10], &a);
    let off: [4]string = [css[0], css[1], css[3], css[5]];
    expect("lint_off", off[0..4], &a);
    let none: [1]string = [""];
    expect("lint_disabled", none[0..0], &a);
    expect("lint_none", none[0..0], &a);
    let fp: [1]string = ["warning: ui/App.j3ui:24:1: selector `.typo` matches no element of this component: nothing has the class `.typo` [never-matches]"];
    expect("lint_fp", fp[0..1], &a);
    a.destroy();
}
