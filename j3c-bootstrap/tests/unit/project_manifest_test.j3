// `project/manifest` and `project/appconfig`: Rust's `project/tests.rs` manifest cases (fields, defaults,
// `bin`, targets, `[dist]`, `[android]`, `[steam]` ignored), `resolve` of a project and a script, and the
// `j3.appconfig` source.
module project_manifest_test;

use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, contains, endsWith };
use j3c.base.triple.hostTriple;
use j3c.project.appconfig;
use j3c.project.config;
use j3c.project.config.Compile;
use j3c.project.manifest;
use j3c.project.manifest.{ Input, Manifest, Output, checkJavaPackage, defaultJavaPackage, parseManifest };

fn put(dir: string, rel: string, text: string, arena: &Arena) {
    let p = path.join(dir, rel, arena);
    io.makeDirs(path.dirname(p));
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a fixture"); } }
}

fn ok(text: string, root: string, arena: &Arena): Manifest {
    return match parseManifest(text, root, arena) { Result.Ok(m) { m } Result.Err(e) { printLn(text); panic(e) } };
}

fn err(text: string, root: string, arena: &Arena): string {
    match parseManifest(text, root, arena) {
        Result.Ok(_) { printLn(text); panic("parseManifest should fail"); return ""; }
        Result.Err(e) { return e; }
    }
}

fn check(c: bool, what: string) { if !c { panic(what); } }

fn has(e: string, part: string) {
    if !contains(e, part) {
        printLn(`{e}`);
        panic(part);
    }
}

/// The outputs as `zip,deb`.
fn outs(m: Manifest, arena: &Arena): string {
    let t = Text.new(arena);
    for i in 0..m.dist.outputs.len {
        if i > 0 { t.add(","); }
        match m.dist.outputs.items[i] {
            Output.Zip { t.add("zip"); }
            Output.Deb { t.add("deb"); }
            Output.Apk { t.add("apk"); }
            Output.Pkg(n) { t.add("pkg:").add(n); }
        }
    }
    return t.str();
}

fn withG(x: string, arena: &Arena): string { return Text.new(arena).add("[package]\nname = \"g\"\n").add(x).str(); }

fn main() {
    let arena = Arena.create(1 << 22);
    let a = &arena;
    let tmp = match io.tempDir("", "j3boot_manifest_", a) { Result.Ok(d) { d } Result.Err(_) { panic("no temp dir") } };
    put(tmp, "src/main.j3", "module t;\nfn main() {}\n", a);

    // parse_bounce_shaped_toml
    let m = ok("\n# comment\n[package]\nname = \"bounce\"\nentry = \"src/main.j3\"\n\n[cc]\nstd = \"c11\"\nopt = \"0\"\n\n[link]\nlibs = [\"SDL2\"]\nsearch = []\nfiles = []\nflags = [\"-lm\"]\n", tmp, a);
    check(m.name == "bounce" && m.entry == path.join(tmp, "src/main.j3", a), "bounce name/entry");
    check(m.cc.std == "c11" && m.cc.opt == "0", "bounce cc");
    check(m.link.libs.len == 1 && m.link.libs.items[0] == "SDL2" && m.link.search.len == 0, "bounce libs");
    check(m.link.flags.len == 1 && m.link.flags.items[0] == "-lm", "bounce flags");
    check(m.emit.backend == "llvm" && m.emit.opt == "0", "bounce emit (opt from cc)");
    check(m.bin == "bounce" && m.version == "0.1.0" && m.description == "bounce, made with j3" && !m.isLib, "bounce defaults");
    check(m.emit.debug && m.emit.incremental && !m.emit.incrementalAll && m.emit.clang == "clang", "emit defaults");
    match m.emit.chunks { Option.Some(_) { panic("chunks default"); } Option.None {} }
    match m.ui { Option.Some(_) { panic("ui default"); } Option.None {} }

    // parse_emit_section_bare_tokens
    m = ok("\n[package]\nname = \"emitme\"\nentry = \"src/main.j3\"\n\n[emit]\nbackend = llvm\nopt = 2\ndebug = true\nfast = false\ncpu = native\nflags = [\"-mavx2\"]\n", tmp, a);
    check(m.emit.backend == "llvm" && m.emit.opt == "2" && m.emit.debug && !m.emit.fast, "emit bare");
    check(m.emit.cpu == "native" && m.emit.flags.len == 1 && m.emit.flags.items[0] == "-mavx2" && m.emit.targets.len == 1 && m.emit.targets.items[0] == hostTriple(), "emit bare 2");
    // [emit] backend without opt keeps 2; [cc] fast turns debug off; incremental = all; chunks
    m = ok("[package]\nname = \"e\"\n[cc]\nopt = \"3\"\nfast = true\n[emit]\nbackend = c\nincremental = all\nchunks = \"+4\"\n", tmp, a);
    check(m.emit.opt == "2" && !m.emit.debug && m.emit.incremental && m.emit.incrementalAll, "emit backend keeps opt");
    match m.emit.chunks { Option.Some(n) { check(n == 4, "chunks 4"); } Option.None { panic("chunks"); } }
    m = ok("[package]\nname = \"e\"\n[emit]\nincremental = 0\nchunks = -1\n", tmp, a);
    check(!m.emit.incremental, "incremental 0");
    match m.emit.chunks { Option.Some(_) { panic("chunks -1"); } Option.None {} }

    // parse_target_array_and_string
    m = ok("\n[package]\nname = \"multi\"\nentry = \"src/main.j3\"\n[emit]\ntarget = [\"x86_64-pc-linux-gnu\", \"x86_64-pc-windows-gnu\", \"arm64-apple-darwin\"]\n", tmp, a);
    check(m.emit.targets.len == 3 && m.emit.targets.items[2] == "arm64-apple-darwin", "targets");
    check(m.emit.primary() == "x86_64-pc-linux-gnu", "primary");
    check(m.outPathFor("x86_64-pc-windows-gnu", a) == path.join(tmp, "target/x86_64-pc-windows-gnu/multi.exe", a), "outPathFor");
    check(m.outPathFor("arm64-apple-darwin", a) == path.join(tmp, "target/arm64-apple-darwin/multi", a), "outPathFor mac");
    m = ok("\n[package]\nname = \"multi\"\nentry = \"src/main.j3\"\n[emit]\ntarget = \"x86_64-pc-windows-gnu\"\n", tmp, a);
    check(m.emit.targets.len == 1 && m.emit.primary() == "x86_64-pc-windows-gnu" && endsWith(m.outPath(a), "/multi.exe"), "one target");
    m = ok("[package]\nname = \"g\"\n[emit]\ntarget = [\"aarch64-linux-android\", \"x86_64-linux-android\"]\n", tmp, a);
    check(m.outPath(a) == path.join(tmp, "target/aarch64-linux-android/libg.so", a), "android out path");
    has(err("[package]\nname = \"g\"\n[emit]\ntarget = { a = \"b\" }\n", tmp, a), "j3.toml: emit.target must be a string or an array");
    has(err("[package]\nname = \"g\"\n[emit]\ntarget = [\"\"]\n", tmp, a), "j3.toml: emit.target has an empty triple");
    has(err("[package]\nname = \"g\"\n[emit]\nflags = \"-O\"\n", tmp, a), "j3.toml: `emit.flags` must be an array");

    // package_bin_names_the_program
    m = ok("[package]\nname = \"j3c\"\nbin = \"j3c-boot\"\n", tmp, a);
    check(m.name == "j3c" && m.bin == "j3c-boot" && m.outPath(a) == path.join(tmp, "target/j3c-boot", a), "bin");
    check(ok("[package]\nname = \"j3c\"\n", tmp, a).outPath(a) == path.join(tmp, "target/j3c", a), "bin default");
    has(err("[package]\nname = \"j3c\"\nbin = \"\"\n", tmp, a), "package.bin");
    has(err("[package]\nname = \"j3c\"\nbin = \"a/b\"\n", tmp, a), "j3.toml: package.bin `a/b` must be a plain file name");
    has(err("[package]\nname = \"j3c\"\nbin = \"../x\"\n", tmp, a), "package.bin");

    // entries and [lib]
    has(err("[package]\nname = \"g\"\nentry = \"src/nope.j3\"\n", tmp, a), "j3.toml: entry ");
    has(err("[package]\nname = \"libby\"\n[lib]\n", tmp, a), "j3.toml: [lib] needs ");
    put(tmp, "src/libby.j3", "module libby;\n", a);
    m = ok("[package]\nname = \"libby\"\n[lib]\n", tmp, a);
    check(m.isLib && m.entry == path.join(tmp, "src/libby.j3", a), "lib entry");

    // script_path_is_the_file_not_the_project
    match manifest.resolve("../examples/3d-editor-scene", a) {
        Result.Ok(Input.Project(p)) { check(endsWith(p.entry, "src/main.j3"), "project entry"); }
        _ { panic("expected the game project"); }
    }
    match manifest.resolve("../examples/3d-editor-scene/scripts/spin.j3s", a) {
        Result.Ok(Input.File(p)) { check(p == "../examples/3d-editor-scene/scripts/spin.j3s", "script path"); }
        _ { panic("expected the script file"); }
    }
    match manifest.resolve("../examples/3d-editor-scene/src/main.j3", a) {
        Result.Ok(Input.Project(p)) { check(p.name == "g3d_editor_scene", "walk up"); }
        _ { panic("expected the project above"); }
    }

    // J3_PACKAGE_VERSION replaces [package] version at load (tools/release/package.sh stamps j3c.exe with it)
    put(tmp, "j3.toml", "[package]\nname = \"g\"\nversion = \"1.0.0\"\n", a);
    sys.setenv("J3_PACKAGE_VERSION", "2.3.4-5-gabc");
    match manifest.load(path.join(tmp, "j3.toml", a), a) { Result.Ok(lm) { check(lm.version == "2.3.4-5-gabc", "J3_PACKAGE_VERSION"); } Result.Err(e) { panic(e); } }
    sys.setenv("J3_PACKAGE_VERSION", "");
    match manifest.load(path.join(tmp, "j3.toml", a), a) { Result.Ok(lm) { check(lm.version == "1.0.0", "toml version"); } Result.Err(e) { panic(e); } }

    // dist_build_outputs
    let d = ok(withG("[dist]\nbuild_outputs = [\"deb\", \"zip\", \"deb\"]\nicon = \"i.png\"\n", a), tmp, a);
    check(outs(d, a) == "deb,zip", "outputs dedup");
    let act = ok(withG("[dist.actions]\nnew-island = { name = \"New Island\", exec = \"--new-island\" }\nplain = { name = \"A, b\" }\n", a), tmp, a);
    check(act.dist.actions.len == 2, "actions");
    let a0 = act.dist.actions.items[0];
    let a1 = act.dist.actions.items[1];
    check(a0.id == "new-island" && a0.name == "New Island" && a0.exec == "--new-island", "action 0");
    check(a1.name == "A, b" && a1.exec == "", "action 1");
    has(err(withG("[dist.actions]\nx = \"y\"\n", a), tmp, a), "must be");
    has(err(withG("[dist.actions]\nx = { exec = \"y\" }\n", a), tmp, a), "needs `name`");
    has(err(withG("[dist.actions]\nx_y = { name = \"n\" }\n", a), tmp, a), "j3.toml: dist.actions.x_y: an action id is letters, digits and `-`");
    match d.dist.icon { Option.Some(i) { check(i == "i.png", "icon"); } Option.None { panic("icon"); } }
    check(d.dist.categories == "Game;" && d.dist.section == "games", "dist defaults");
    match d.dist.postinst { Option.Some(_) { panic("postinst default"); } Option.None {} }
    let b = ok(withG("[dist]\nsection = \"x11\"\npostinst = \"p/postinst\"\nprerm = \"p/prerm\"\n", a), tmp, a);
    check(b.dist.section == "x11", "section");
    match b.dist.prerm { Option.Some(p) { check(p == "p/prerm", "prerm"); } Option.None { panic("prerm"); } }
    check(d.version == "0.1.0" && d.description == "g, made with j3", "version/description");
    check(outs(ok(withG("[dist]\nzip = true\n", a), tmp, a), a) == "zip", "zip = true");
    check(outs(ok(withG("[dist]\nbuild_outputs = [\"deb\"]\nzip = true\n", a), tmp, a), a) == "zip,deb", "zip first");
    has(err(withG("[dist]\nbuild_outputs = [\"msi\"]\n", a), tmp, a), "zip, deb");
    check(outs(ok(withG("[dist]\nbuild_outputs = [\"apk\"]\n", a), tmp, a), a) == "apk", "apk");
    let an = ok(withG("[emit]\ntarget = [\"aarch64-linux-android\"]\n[dist]\nbuild_outputs = [\"apk\"]\n", a), tmp, a);
    check(an.android.package == "com.j3.g" && an.android.orientation == "landscape", "android defaults");
    match an.android.nativeLibs { Option.Some(_) { panic("native_libs default"); } Option.None {} }
    an = ok(withG("[android]\norientation = \"sensorPortrait\"\npackage = \"org.me.game\"\nforeground_service = \"dataSync\"\n", a), tmp, a);
    check(an.android.package == "org.me.game" && an.android.orientation == "sensorPortrait", "android set");
    match ok(withG("[android]\nnative_libs = \"android/libs\"\n", a), tmp, a).android.nativeLibs {
        Option.Some(n) { check(n == "android/libs", "native_libs"); }
        Option.None { panic("native_libs"); }
    }
    has(err(withG("[android]\norientation = \"flip\"\n", a), tmp, a), "j3.toml: android.orientation: unknown `flip` (have landscape, portrait, sensorLandscape, sensorPortrait, fullSensor, unspecified)");
    has(err(withG("[android]\npackage = \"1bad.x\"\n", a), tmp, a), "android.package");
    has(err(withG("[android]\nforeground_service = \"x\"\n", a), tmp, a), "j3.toml: android.foreground_service: unknown `x` (have connectedDevice, dataSync)");

    // java_package_defaults_are_valid
    check(defaultJavaPackage("My-Game", a) == "com.j3.my_game", "java My-Game");
    check(defaultJavaPackage("3d-demo", a) == "com.j3.app3d_demo", "java 3d-demo");
    check(defaultJavaPackage("_x", a) == "com.j3.app_x", "java _x");
    check(defaultJavaPackage("new", a) == "com.j3.new_", "java new");
    check(defaultJavaPackage("é", a) == "com.j3.app", "java é");
    check(checkJavaPackage(defaultJavaPackage("desk-app", a)) && !checkJavaPackage("single"), "checkJavaPackage");

    // missing_name_is_error
    check(err("[link]\nlibs = [\"x\"]\n", "/", a) == "j3.toml: missing [package] name", "missing name");
    check(err("[package]\nname = \"\"\n", tmp, a) == "j3.toml: package.name is empty", "empty name");

    // steam_is_a_package_output
    ok(withG("[steam]\napp_id = abc\nbogus = 1\nglibc_max = \"x\"\n", a), tmp, a);
    let e = err(withG("[dist]\nbuild_outputs = [\"steam\"]\n", a), tmp, a);
    has(e, "no package provides \"steam\"");
    check(endsWith(e, "built in: zip, deb, apk"), "steam built-ins");

    // [ui]
    let u = ok(withG("[ui]\ntheme = \"t.css\"\nlint = false\nlint-off = [\"a\"]\n", a), tmp, a);
    match u.ui {
        Option.Some(x) { check(x.dir == "ui" && x.lintOff.len == 2 && x.lintOff.items[1] == "*", "ui"); }
        Option.None { panic("ui"); }
    }

    // `--host` makes the targets this machine's; `load` reads the file
    put(tmp, "j3.toml", "[package]\nname = \"h\"\n[emit]\ntarget = [\"x86_64-pc-windows-gnu\", \"x86_64-pc-linux-gnu\"]\n", a);
    manifest.setHost(true);
    match manifest.load(path.join(tmp, "j3.toml", a), a) {
        Result.Ok(h) { check(h.emit.targets.len == 1 && h.emit.targets.items[0] == hostTriple(), "host"); }
        Result.Err(le) { panic(le); }
    }
    manifest.setHost(false);
    // `--target T`: in `[emit] target` keeps the list (build picks T); not in it replaces the list
    let sub: [1]string = ["x86_64-pc-linux-gnu"];
    manifest.setTargets(sub[..]);
    match manifest.load(path.join(tmp, "j3.toml", a), a) { Result.Ok(h) { check(h.emit.targets.len == 2, "target subset"); } Result.Err(le) { panic(le); } }
    let other: [2]string = ["aarch64-linux-android", "aarch64-linux-android"];
    manifest.setTargets(other[..]);
    match manifest.load(path.join(tmp, "j3.toml", a), a) {
        Result.Ok(h) { check(h.emit.targets.len == 1 && h.emit.targets.items[0] == "aarch64-linux-android", "target replaces"); }
        Result.Err(le) { panic(le); }
    }
    manifest.setTargets(other[0..0]);

    // j3.appconfig
    check(appconfig.MODULE == "j3.appconfig" && appconfig.LABEL == "<j3.appconfig>", "appconfig names");
    put(tmp, "j3.toml", "[package]\nname = \"h\"\n[splash]\nenabled = true\ntheme = light\ncard_size = 2\ncard_time = 0.25\ncards = [\"a.png\", \"b\\\"c\"]\n[dist]\nicon = \"Icon.PNG\"\n", a);
    let src = appconfig.configModule(tmp, a);
    let want = "/// `[splash]` and `[dist] icon` of j3.toml, baked in at build time.\nmodule j3.appconfig;\npub const SPLASH: bool = true;\npub const LOGO: bool = true;\npub const LIGHT: bool = true;\npub const SKIPPABLE: bool = true;\npub const CARD_MS: int = 250;\npub const CARD_SIZE: f32 = 1.0;\npub const CARDS: string = \"a.png\\nb\\\\\\\"c\";\npub const ICON: string = \"Icon.PNG\";\n";
    if src != want {
        printLn(src);
        panic("configModule");
    }
    let none = appconfig.configModule(path.join(tmp, "nope", a), a);
    check(contains(none, "SPLASH: bool = false;") && contains(none, "CARD_MS: int = 1800;") && contains(none, "CARD_SIZE: f32 = 0.35;") && contains(none, "ICON: string = \"\";"), "configModule defaults");

    // config: the compilation log (Rust `log_compile`), and `[compiler]` from `J3_CONFIG`
    let c = Compile { root: tmp, opt: "0", backend: "llvm", target: "", modules: 3, secs: 1.26, phases: "", ok: false, lastErr: "j3c: [1/6] parse\nerror: bad\n" };
    config.logCompile(&c, a);
    let log = match io.readFile(path.join(tmp, "target/compilation.log", a), a) { Result.Ok(lb) { lb as string } Result.Err(_) { panic("no log") } };
    check(log.len > 30 && log[0..9] == "COMPILE: " && log[13] == '-' && log[16] == '-' && log[22] == ':' && log[25..30] == " UTC\n", "log date");
    check(contains(log, "    j3c version: 0.1.0\n    backend=llvm opt=0\n    3 modules\n    time: 1.3s\n    result: FAILED\n    error: bad\n\n"), "log body");
    put(tmp, "cfg.toml", "[compiler]\ncompilation_tracking = on\n", a);
    sys.setenv("J3_CONFIG", path.join(tmp, "cfg.toml", a));
    sys.setenv("J3C_COMPILATION_TRACKING", ""); // the env var beats the file; gate runs set it to 0
    check(config.compilationTracking(a), "compilation_tracking");
    printLn("project_manifest: ok");
}
