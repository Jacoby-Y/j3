// B6: 1000 Sessions created, used (interned names, Diags) and freed; resident memory must level off.
// Fails if a Session leaks its arena (a leak of the 64 KiB first chunk alone is ~50 MB over 800 sessions).
module driver_rss_test;

use j3.io.{ openPath, printLn };
use j3.sys.{ O_RDONLY, close, panic, read };
use j3.text.Text;
use j3c.base.diag.Severity;
use j3c.base.span.noSpan;
use j3c.driver;
use j3c.driver.Session;

/// Resident pages: second field of /proc/self/statm (`io.readFile` sizes by lseek, which procfs reports as 0).
fn residentPages(): int {
    let buf: [128]u8;
    let fd = openPath("/proc/self/statm", O_RDONLY, 0);
    if fd < 0 { panic("cannot open /proc/self/statm"); }
    let got = read(fd, &buf[0] as ptr, 128);
    close(fd);
    let i = 0;
    while i < got && buf[i] != 32 { i += 1; }
    i += 1;
    let n = 0;
    while i < got && buf[i] >= 48 && buf[i] <= 57 { n = n * 10 + int(buf[i] - 48); i += 1; }
    if n == 0 { panic("cannot parse /proc/self/statm"); }
    return n;
}

fn useSession(k: int) {
    let s = Session.new(driver.defaults());
    let t = Text.new(s.arena);
    for i in 0..200 {
        t.clear();
        t.add("name_").pushInt(k * 1000 + i);
        s.names.intern(t.str());
    }
    for i in 0..100 {
        s.diags.add(s.diags.make(0, Severity.Error, noSpan(), "boom"));
    }
    if s.names.len() != 200 || s.diags.count() != 100 { panic("session lost data"); }
    s.free();
}

fn main() {
    for k in 0..200 { useSession(k); }
    let warm = residentPages();
    for k in 200..1000 { useSession(k); }
    let end = residentPages();
    // 1024 pages = 4 MiB of slack for allocator noise.
    if end - warm > 1024 {
        printLn(`resident pages after 200 sessions: {warm}, after 1000: {end}`);
        panic("Session memory does not level off (leak)");
    }
}
