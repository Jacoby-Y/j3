// Bytecode refusals against stage 0: each `tests/proj/bc_refuse_*` project checks, and `bc.emitScript` of its
// script fails with stage 0's text (the `j3c: ./` prefix of stage 0's `run` stderr dropped; the script path
// in front depends on the project root, so the text must end the error). The byte-exact `.j3sb` of the
// passing `bc_*` projects is `bc_codegen_test.j3`'s (`bc_codegen_cases/j3sb.txt`).
module bc_stmt_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, endsWith };
use j3c.backend.bc;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };

/// The `emitScript` error of the one script module of project `dir`, "" when it emits.
fn refusal(dir: string, mem: &Arena): string {
    let o = driver.defaults();
    o.entry = dir;
    o.mode = Mode.Check;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) || s.diags.hasErrors() {
        panic(Text.new(mem).add(dir).add(": does not check: ").add(failText(s)).str());
    }
    match s.program {
        Option.Some(prog) {
            for mi in 0..prog.modules.len {
                let m = &prog.modules.items[mi];
                if !bc.isScriptModule(&prog.cx, m.name.slice()) { continue; }
                match bc.emitScript(&prog.cx, m, mem) {
                    Result.Ok(_) {}
                    Result.Err(e) { return Text.new(mem).add(e).str(); }
                }
            }
        }
        Option.None { panic("no program"); }
    }
    return "";
}

fn case(name: string, want: string, mem: &Arena): bool {
    let got = refusal(Text.new(mem).add("tests/proj/").add(name).str(), mem);
    if got.len > 0 && endsWith(got, want) { return true; }
    printLn(Text.new(mem).add("DIFF ").add(name).add("\n  want ...").add(want).add("\n  got  ").add(got).str());
    return false;
}

fn main() {
    let mem = Arena.create(1 << 20);
    defer mem.destroy();
    let bad = 0;
    if !case("bc_refuse_frem", "scripts/s.j3s: fn go: `Rem` on a float isn't supported in scripts", &mem) { bad += 1; }
    if !case("bc_refuse_shift", "scripts/s.j3s: fn go: shifts aren't supported in scripts", &mem) { bad += 1; }
    if !case("bc_refuse_table", "scripts/s.j3s: `NAMES` is a table holding strings (`@embedDir`, `[N]string`), which a `.j3s` script cannot hold yet; declare it in a `.j3` module and `use` it", &mem) { bad += 1; }
    if !case("bc_refuse_vec", "scripts/s.j3s: fn go: vec4f is not supported in scripts yet", &mem) { bad += 1; }
    if bad != 0 { panic(Text.new(&mem).add("bc refusals differ from stage 0: ").add(`{bad}`).str()); }
}
