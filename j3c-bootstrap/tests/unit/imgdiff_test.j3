// `cmd/imgdiff`: `parseUint` (Rust `str::parse` for unsigned numbers) and `diff` on the `png_check` fixtures
// (same image: 0 differ; other size: rc 1; missing: rc 2). Run with cwd = j3c-bootstrap/.
module imgdiff_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.cmd.imgdiff;

fn main() {
    let a = Arena.create(1 << 20);
    if imgdiff.parseUint("0", 10) != 0 || imgdiff.parseUint("+7", 10) != 7 || imgdiff.parseUint("10", 10) != 10 { panic("parseUint ok values"); }
    if imgdiff.parseUint("11", 10) != -1 || imgdiff.parseUint("", 10) != -1 || imgdiff.parseUint("+", 10) != -1 { panic("parseUint bad values"); }
    if imgdiff.parseUint("-1", 10) != -1 || imgdiff.parseUint(" 1", 10) != -1 || imgdiff.parseUint("1x", 10) != -1 { panic("parseUint junk"); }
    if imgdiff.parseUint("4294967295", 4294967295) != 4294967295 || imgdiff.parseUint("4294967296", 4294967295) != -1 { panic("parseUint u32 range"); }
    let f = "../j3c/tests/programs/png_check/";
    match imgdiff.diff(`{f}rgb.png`, `{f}rgb.png`, 0, Option.None, &a) {
        Result.Ok(c) { if c.count != 0 || c.total != 37 * 23 { panic("same image differs"); } }
        Result.Err(_) { panic("same image failed"); }
    }
    match imgdiff.diff(`{f}rgb.png`, `{f}pal.png`, 0, Option.None, &a) {
        Result.Ok(_) { panic("sizes differ but Ok"); }
        Result.Err(e) { if e.rc != 1 || e.msg != "size differs: 37x23 vs 19x17" { panic("size message"); } }
    }
    match imgdiff.diff(`{f}nope.png`, `{f}pal.png`, 0, Option.None, &a) {
        Result.Ok(_) { panic("missing file but Ok"); }
        Result.Err(e) { if e.rc != 2 { panic("missing file rc"); } }
    }
    a.destroy();
}
