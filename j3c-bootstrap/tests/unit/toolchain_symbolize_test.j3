// `symbolize` rewrites crash-handler lines like Rust emit/host/symbolize.rs (addresses stay hex when there
// is no `j3 base:` to resolve names from); ordinary stderr is left alone.
module toolchain_symbolize_test;

use j3.memory.Arena;
use j3.option.Option;
use j3.sys.panic;
use j3.text.Text;
use j3c.toolchain;

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    match toolchain.symbolize("/nonexistent", "plain stderr\n", &mem) { Option.Some(_) { panic("plain stderr rewritten"); } Option.None {} }
    expect(toolchain.symbolize("/nonexistent", "msg\nj3 at: 0x10\nj3 at: 0x20\nj3 at: 0x20\n", &mem),
        "msg\ncalled from:\n  0x10\n  0x20  (x2)\n");
    expect(toolchain.symbolize("/nonexistent", "j3 crash: signal 8\nj3 pc: 0xab\n", &mem), "crash: SIGFPE (8)\n  0xab\n");
    let t = Text.new(&mem);
    t.add("j3 crash: signal 11\n");
    for _ in 0..20 { t.add("j3 at: 0x5\n"); }
    expect(toolchain.symbolize("/nonexistent", t.str(), &mem), "crash: stack overflow (SIGSEGV): endless recursion in `0x5`?\n  0x5  (x20)\n");
}

fn expect(got: Option<string>, want: string) {
    match got {
        Option.Some(s) { if s != want { panic(s); } }
        Option.None { panic("not rewritten"); }
    }
}
