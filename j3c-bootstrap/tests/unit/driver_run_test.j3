// driver.run goes through every stage a plain program needs; the pass list and its context follow Options.
module driver_run_test;

use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage, passCx, passes };
use j3c.ir.{ PassCx, Program };

fn noDump(cx: &PassCx, prog: &Program) {}

fn main() {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    // A plain entry (the default hello needs GPU prepare, not ported) builds through link with no diags.
    let dir = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-driver-run").str();
    let entry = Text.new(&mem).add(dir).add("/plain.j3").str();
    let src = "module plain;\nfn main() {}\n";
    match io.makeDirs(dir) { Result.Ok(_) {} Result.Err(_) { panic("make the temp dir"); } }
    match io.writeFile(entry, src as []u8) { Result.Ok(_) {} Result.Err(_) { panic("write plain.j3"); } }
    let eo = driver.defaults();
    eo.entry = entry;
    let s = Session.new(eo);
    if !driver.run(s, Stage.Link) || s.diags.count() != 0 { panic("plain.j3 does not build cleanly"); }
    s.free();

    // A program reaching the tuple-typed `j3.text` fns (`writeF64`) builds: tuples are typed (C2c).
    let live = Text.new(&mem).add(dir).add("/live.j3").str();
    match io.writeFile(live, "module live;\nuse j3.text;\nfn main() { let b: [32]u8; text.writeF64(b[..], 1.5); }\n" as []u8) { Result.Ok(_) {} Result.Err(_) { panic("write live.j3"); } }
    let ol = driver.defaults();
    ol.entry = live;
    let sl = Session.new(ol);
    if !driver.run(sl, Stage.Link) || sl.diags.count() != 0 { panic("live.j3 (tuple-typed j3.text fns) does not build cleanly"); }
    sl.free();

    // Stages report under Rust's outer phase names (`phase.rs` OUTER): load is `parse`.
    let po = driver.defaults();
    po.timePasses = true;
    let sp = Session.new(po);
    driver.run(sp, Stage.Link);
    let rep = Text.new(sp.arena);
    sp.phases.report(&rep);
    if !text.contains(rep.str(), "parse") || text.contains(rep.str(), "load") { panic(rep.str()); }
    sp.free();

    let o = driver.defaults();
    o.mode = Mode.Dev;
    o.fast = true;
    o.release = true;
    o.dumpAfter = "fast";
    let s2 = Session.new(o);
    let ps = passes(s2.arena);
    if ps.len != 3 || ps[0].name != "validate" || ps[1].name != "fast" || ps[2].name != "devmode" { panic("pass order"); }
    let cx = passCx(s2, noDump);
    if !cx.dev || !cx.fast || !cx.validate || cx.scripts || cx.dumpAfter != "fast" { panic("pass context flags"); }
    let c0 = ps[0].cond;
    let c1 = ps[1].cond;
    let c2 = ps[2].cond;
    if !c0(&cx) || !c1(&cx) || c2(&cx) { panic("pass conditions (validate even in release)"); }
    cx.scripts = true;
    if !c2(&cx) { panic("devmode runs on dev builds with scripts"); }
    s2.free();
}
