// `j3c new` (Rust `scaffold/tests.rs`): every template checks, names the project after its folder (never
// `mygame`), the lib's demo uses it, the scene section is added once; `createProject` / `addEditorFiles`.
// Output texts and trees are byte-compared with stage 0 in `tests/tool/new.txt`.
module cmd_new_test;

use j3.io;
use j3.io.path;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, startsWith };
use j3c.base.fsx;
use j3c.cmd.check.checkCmd;
use j3c.cmd.new;

fn read(p: string, arena: &Arena): string {
    match fsx.readText(p, arena) {
        Result.Ok(t) { return t; }
        Result.Err(e) { panic(e); }
    }
    return "";
}

fn run(args: []string) {
    if new.newCmd(args) != 0 { panic(args[0]); }
}

fn check(p: string) {
    let a: [1]string = [p];
    if checkCmd(a[..]) != 0 { panic(p); }
}

/// Every file under `dir` but `.ttf` and `AGENTS.md` lacks `mygame`; each `j3.toml` names `name`.
fn noPlaceholder(dir: string, name: string, arena: &Arena) {
    match io.listDir(dir, arena) {
        Result.Ok(ents) {
            for i in 0..ents.len {
                let p = path.join(dir, ents[i].name, arena);
                if ents[i].isDir { noPlaceholder(p, name, arena); continue; }
                if path.ext(p) == ".ttf" { continue; }
                let t = read(p, arena);
                if ents[i].name != "AGENTS.md" && contains(t, "mygame") { panic(p); }
                if ents[i].name == "j3.toml" && (!contains(t, Text.new(arena).add("name = \"").add(name).add("\"").str()) || !contains(t, "backend = \"llvm\"")) {
                    panic(p);
                }
            }
        }
        Result.Err(_) { panic(dir); }
    }
}

fn main() {
    let mem = Arena.create(1 << 22);
    defer mem.destroy();
    let dir = match io.tempDir("", "j3-new-", &mem) {
        Result.Ok(d) { d }
        Result.Err(_) { panic("tempDir"); "" }
    };

    let a1: [1]string = [path.join(dir, "todo", &mem)];
    run(a1[..]);
    let a2: [2]string = [path.join(dir, "todoapp", &mem), "--app"];
    run(a2[..]);
    let a3: [3]string = [path.join(dir, "todofps", &mem), "--template", "fps"];
    run(a3[..]);
    let a4: [3]string = [path.join(dir, "todoui", &mem), "--template", "ui"];
    run(a4[..]);
    let a5: [1]string = [path.join(dir, "my-game", &mem)];
    run(a5[..]);
    noPlaceholder(path.join(dir, "todo", &mem), "todo", &mem);
    noPlaceholder(path.join(dir, "todoapp", &mem), "todoapp", &mem);
    noPlaceholder(path.join(dir, "todofps", &mem), "todofps", &mem);
    noPlaceholder(path.join(dir, "todoui", &mem), "todoui", &mem);
    noPlaceholder(path.join(dir, "my-game", &mem), "my_game", &mem);
    if !contains(read(path.join(dir, "my-game/src/main.j3", &mem), &mem), "module my_game;") { panic("my_game"); }
    let hello = read(path.join(dir, "todo/AGENTS.md", &mem), &mem);
    if !contains(hello, "Learn J3 from `j3c` only") || contains(hello, "## 3D scenes and the editor") { panic("AGENTS.md"); }
    if read(path.join(dir, "todo/CLAUDE.md", &mem), &mem) != "@AGENTS.md\n" { panic("CLAUDE.md"); }
    if !contains(read(path.join(dir, "todoapp/j3.toml", &mem), &mem), "libs = [\"SDL2\"]") { panic("app toml"); }
    if !contains(read(path.join(dir, "todoui/assets/LICENSE-DejaVu.txt", &mem), &mem), "Bitstream") { panic("license"); }
    match io.stat(path.join(dir, "todoui/assets/font.ttf", &mem)) {
        Result.Ok(st) { if st.size < 10000 { panic("font"); } }
        Result.Err(_) { panic("font"); }
    }
    let ui = read(path.join(dir, "todoui/AGENTS.md", &mem), &mem);
    if !contains(ui, "j3c doc css") || !contains(ui, "--headless") { panic("ui AGENTS.md"); }
    let fps = read(path.join(dir, "todofps/AGENTS.md", &mem), &mem);
    if !contains(fps, "## 3D scenes and the editor") || !contains(fps, "claude mcp add") { panic("fps AGENTS.md"); }
    if !contains(read(path.join(dir, "todofps/src/main.j3", &mem), &mem), "drawFrame") { panic("fps main"); }
    // again into the same folder: refused
    if new.newCmd(a1[..]) != 1 { panic("again"); }

    // An older AGENTS.md gets the scene section once.
    io.writeFile(path.join(dir, "todofps/AGENTS.md", &mem), "# old\n" as []u8);
    new.addScenesSection(path.join(dir, "todofps", &mem), &mem);
    new.addScenesSection(path.join(dir, "todofps", &mem), &mem);
    let old = read(path.join(dir, "todofps/AGENTS.md", &mem), &mem);
    if !startsWith(old, "# old\n\n## 3D scenes and the editor") || contains(old[10..old.len], "## 3D scenes and the editor") { panic(old); }

    check(path.join(dir, "todo", &mem));
    check(path.join(dir, "todoapp", &mem));
    check(path.join(dir, "todofps", &mem));
    check(path.join(dir, "todoui", &mem));
    check(path.join(dir, "my-game", &mem));

    // A package and its demo check; a second run adds nothing.
    let l: [2]string = [path.join(dir, "hello", &mem), "--lib"];
    run(l[..]);
    check(path.join(dir, "hello", &mem));
    check(path.join(dir, "hello/examples/demo", &mem));
    let before = read(path.join(dir, "hello/src/hello.j3", &mem), &mem);
    run(l[..]);
    if read(path.join(dir, "hello/src/hello.j3", &mem), &mem) != before { panic("lib again"); }

    // The editor's project files (editor --new) and the scene an existing project lacks.
    match new.createProject(path.join(dir, "edproj", &mem), false, &mem) {
        Result.Ok(_) {}
        Result.Err(e) { panic(e); }
    }
    if !contains(read(path.join(dir, "edproj/j3.toml", &mem), &mem), "name = \"edproj\"") { panic("edproj"); }
    match new.createProject(path.join(dir, "edproj", &mem), false, &mem) {
        Result.Ok(_) { panic("edproj twice"); }
        Result.Err(e) { if !contains(e, "already exists") { panic(e); } }
    }
    check(path.join(dir, "edproj", &mem));
    match new.addEditorFiles(path.join(dir, "nothere", &mem), &mem) {
        Result.Ok(_) { panic("no j3.toml"); }
        Result.Err(e) { if e != Text.new(&mem).add("no j3.toml in ").add(path.join(dir, "nothere", &mem)).str() { panic(e); } }
    }
    fsx.removeTree(dir, &mem);
}
