// `fmt` / `dump-ast` with no path or `.` in a project dir (`cmd.check.collectJ3`, Rust `list_project_sources`):
// `target/j3c` prints the stdout, stderr and exit code in `tests/unit/expect/cmd_fmt_project.txt` (frozen from
// the Rust compiler's, plan 15; this package's folder is `$BOOT` there). The project has
// unformatted and clean files in `src/` and `src/sub/`, a `.j3s` in `src/` (listed twice by Rust's two
// walks, kept once), one in `scripts/`, one in `target/` (skipped). Also a plain folder (no `src/`).
// Needs `target/j3c` built (`tests/unit.sh` builds it); runs in `target/unit/cmd_fmt_project/`.
module cmd_fmt_project_test;

use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.proc.Output;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use unitkit;

const MAKE = "rm -rf w && mkdir -p w/src/sub w/scripts w/target w/plain/deep && cd w && printf 'fn main(){let x=1;}\\n' >src/main.j3 && printf 'pub fn f(): int {\\n    return 1;\\n}\\n' >src/sub/b.j3 && printf 'fn g( ) { }\\n' >src/s.j3s && printf 'fn h() {}\\n' >scripts/door.j3s && printf 'fn bad(' >target/t.j3s && printf 'fn p(){}\\n' >plain/deep/p.j3 && printf 'fn q() {}\\n' >plain/q.j3s && printf '[package]\\nname = \"w\"\\n' >j3.toml";

fn sh(line: string, arena: &Arena): Output {
    match proc.run(["sh", "-c", line], "", arena) {
        Result.Ok(o) { return o; }
        Result.Err(_) { panic(line); }
    }
    return Output { code: 0, out: "" as []u8, err: "" as []u8 };
}

/// A fresh project in `target/unit/cmd_fmt_project/w`, then `BIN ARGS` run inside it.
fn runIn(bin: string, args: string, arena: &Arena): Output {
    return sh(Text.new(arena).add("mkdir -p target/unit/cmd_fmt_project && cd target/unit/cmd_fmt_project && ").add(MAKE).add(" && ").add(bin).add(" ").add(args).str(), arena);
}

fn main() {
    let arena = Arena.create(1 << 16);
    defer arena.destroy();
    let boot = match path.realpath("target/j3c", &arena) { Option.Some(p) { p } Option.None { panic("no target/j3c") } };
    let cases: [8]string = ["fmt --check", "fmt", "fmt --check .", "fmt .", "dump-ast .", "fmt --write >/dev/null; cat src/main.j3 src/s.j3s scripts/door.j3s", "fmt --check plain", "fmt --check src/main.j3"];
    let all = Text.new(&arena);
    for i in 0..cases.len {
        let o = runIn(boot, cases[i], &arena);
        all.add("== ").add(cases[i]).add("\n").add(o.outStr()).add("--- stderr\n").add(o.errStr()).add("--- exit ").pushInt(o.code);
        all.add("\n");
    }
    let here = match path.realpath(".", &arena) { Option.Some(p) { p } Option.None { panic("no cwd") } };
    unitkit.expect(unitkit.mask(all.str(), here, "$BOOT", &arena), "cmd_fmt_project.txt", "fmt project output differs from tests/unit/expect/cmd_fmt_project.txt");
}
