// Traits in bodies (`sema/trait_*`): an `#[impl]` method call is a plain call of the renamed fn, a trait
// default method an instance of its `Trait.m` template, `<` on strings `j3.cmp`'s `#[impl] operator<`,
// and `==` on a generic struct instance its method's instance; `speculative/lang/traits.j3` types too. Then the bound errors' text: a default whose trait (via a supertrait) is not met, a queued
// `Map<K: Hash, V>` mention, two defaults (ambiguous), a wrong signature.
module sema_trait_test;

use j3.data.pool.Id;
use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, startsWith };
use j3c.base.diag.Severity;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.sema.{ Callee, Checked, TBody, TExpr, TStmt };

const SRC: [24]string = [
    "module trs;",
    "use j3.cmp.Eq;",
    "pub trait Weigh { fn weigh(this: Self): int; }",
    "pub trait Named { fn name(this: Self): string; }",
    "pub trait Labeled: Named + Weigh {",
    "    fn tag(this: Self): int { return this.name().len * 100 + this.weigh(); }",
    "}",
    "struct Pt {",
    "    x: int;",
    "    fn weigh(this: &Pt): int { return this.x; }",
    "    fn name(this: &Pt): string { return \"pt\"; }",
    "}",
    "struct Box<T> { v: T; fn operator==(this: Box<T>, o: Box<T>): bool { return true; } }",
    "#[impl]",
    "fn weigh(x: int): int { return x * 10; }",
    "fn main() {",
    "    let n = 7;",
    "    let a = n.weigh();",
    "    let p = Pt { x: 1 };",
    "    let b = p.tag();",
    "    let c = \"a\" < \"b\";",
    "    let d = Box<int> { v: 1 } == Box<int> { v: 2 };",
    "    let e = \"a\" > \"b\";",
    "}",
];

const STD: [22]string = [
    "module stdcmp;",
    "use j3.memory.{ Arena, List };",
    "use j3.cmp.{ minOf, maxOf, contains, hashOf };",
    "use j3.data.map.Map;",
    "struct P { x: int; fn operator==(this: P, o: P): bool { return this.x == o.x; } fn operator<(this: P, o: P): bool { return this.x < o.x; } }",
    "fn main() {",
    "    let mem = Arena.create(4096);",
    "    let xs = List<int>.new(&mem);",
    "    xs.push(3);",
    "    let a = xs.indexOf(1);",
    "    let b = xs.contains(5);",
    "    let ss = List<string>.new(&mem);",
    "    ss.push(\"b\");",
    "    let g = contains(ss.slice(), \"a\");",
    "    let c = minOf(\"x\", \"y\");",
    "    let d = maxOf(2, 3) + int(hashOf(7));",
    "    let ps = List<P>.new(&mem);",
    "    let e = ps.indexOf(P { x: 2 }) + maxOf(P { x: 1 }, P { x: 2 }).x;",
    "    let f = contains(ps.slice(), P { x: 1 });",
    "    let m = Map<string, int>.new(&mem, 8);",
    "    m.put(\"a\", 1);",
    "}",
];

/// Sema passes on `lines` (every body it loads types, the stdlib's included).
fn typesFully(name: string, lines: []string, mem: &Arena) {
    let o = driver.defaults();
    o.entry = put(name, lines, mem);
    let s = Session.new(o);
    if !driver.run(s, Stage.Sema) { panic(`sema fails on {name}`); }
    match s.checked { Option.Some(_) {} Option.None { panic(`no checked program for {name}`); } }
}

/// Write `text` as `NAME.j3` in a temp dir (outside this package, whose project would otherwise load).
fn put(name: string, lines: []string, mem: &Arena): string {
    let text = Text.new(mem);
    for i in 0..lines.len { text.add(lines[i]).add("\n"); }
    let d = Text.new(mem).add(io.tempRoot()).add("/j3c-boot-sema-trait").str();
    match io.makeDirs(d) { Result.Ok(_) {} Result.Err(_) { panic("cannot make the case dir"); } }
    let p = Text.new(mem).add(d).add("/").add(name).add(".j3").str();
    match io.writeFile(p, text.str() as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case"); } }
    return p;
}

fn body(c: &Checked, name: string): TBody {
    let fns = &c.tables.fns;
    for i in 0..fns.len() {
        let d = fns.get(fns.idAt(i));
        if c.tables.str(d.name) != name { continue; }
        match d.body { Option.Some(b) { return c.typed.body(b); } Option.None {} }
    }
    panic(`no typed body for {name}`);
    return c.typed.body(Id<TBody> { i: 0 });
}

/// The callee of `let x = CALL;` statement `k` of `b` (through a `!` fallback).
fn calleeOf(c: &Checked, b: &TBody, k: int): Callee {
    match c.typed.stmt(b.body.stmts.items[k]) {
        TStmt.Let(l) {
            match l.init {
                Option.Some(e) {
                    let x = c.typed.expr(e);
                    match x { TExpr.Unary(u) { x = c.typed.expr(u.operand); } _ {} }
                    match x { TExpr.Call(call) { return call.callee; } _ {} }
                }
                Option.None {}
            }
        }
        _ {}
    }
    panic(`statement {k} is no let of a call`);
    return calleeOf(c, b, k);
}

fn fnName(c: &Checked, cl: Callee): string {
    match cl {
        Callee.Fn(f) { return c.tables.str(c.tables.fnAt(f.decl).name); }
        Callee.Inst(i) { return c.tables.str(c.tables.fnAt(c.tables.instanceAt(i.inst).key.item.asFn()).name); }
        _ {}
    }
    return "?";
}

fn isInst(cl: Callee): bool { match cl { Callee.Inst(_) { return true; } _ { return false; } } return false; }

/// The first error of checking `lines` (it must fail sema): its message and notes, `|`-joined; a
/// "bound declared at" note keeps only its line number.
fn firstError(name: string, lines: []string, mem: &Arena): string {
    let o = driver.defaults();
    o.entry = put(name, lines, mem);
    let s = Session.new(o);
    if driver.run(s, Stage.Sema) { panic(`{name}: sema passes`); }
    if s.diags.items.len == 0 { panic(`{name}: no diag`); }
    // The first error: lint warnings (`unused local`) come before it.
    let k = 0;
    while k < s.diags.items.len - 1 && s.diags.items.items[k].severity != Severity.Error { k += 1; }
    let d = s.diags.items.items[k];
    let t = Text.new(mem).add(d.msg);
    for i in 0..d.notes.len {
        let n = d.notes.items[i].msg;
        t.add("|");
        if n.len > o.entry.len && n[0..17] == "bound declared at" {
            t.add("bound declared at :").add(n[n.len - 1..n.len]);
        } else {
            t.add(n);
        }
    }
    return t.str();
}

/// `name<implN>` -> `name` (the N depends on the stdlib's `#[impl]` count).
fn implBase(s: string): string {
    let i = s.len;
    while i > 0 && s[i - 1] != '<' { i -= 1; }
    if i == 0 || s[i..s.len] == "" { return s; }
    return s[0..i - 1];
}

fn expect(name: string, got: string, want: string) {
    if got != want { panic(`{name}:\n got {got}\nwant {want}`); }
}

fn main() {
    let mem = Arena.create(1 << 12);
    let o = driver.defaults();
    o.entry = put("trs", SRC, &mem);
    let s = Session.new(o);
    if !driver.run(s, Stage.Sema) { panic("sema fails on the trait program"); }
    let c = match s.checked { Option.Some(x) { x } Option.None { panic("no checked program"); return; } };
    let m = body(c, "main");
    expect("impl call", fnName(c, calleeOf(c, &m, 1)), "weigh<impl0>");
    let tag = calleeOf(c, &m, 3);
    if !isInst(tag) { panic("p.tag() is an instance call"); }
    expect("default call", fnName(c, tag), "Labeled.tag");
    expect("string <", implBase(fnName(c, calleeOf(c, &m, 4))), "operator<");
    let eq = calleeOf(c, &m, 5);
    if !isInst(eq) { panic("== on Box<int> is an instance call"); }
    expect("instance ==", fnName(c, eq), "operator==");
    expect("string > (fallback)", implBase(fnName(c, calleeOf(c, &m, 6))), "operator<");

    // The language sample and a `where T: Eq` / `T: Ord` / `Map<K: Hash + Eq, V>` user type
    // pass sema.
    let spec = match io.readFile("../speculative/lang/traits.j3", &mem) { Result.Ok(b) { b } Result.Err(_) { panic("no traits.j3"); return; } };
    let one: [1]string = [spec as string];
    typesFully("traits", one, &mem);
    typesFully("stdcmp", STD, &mem);

    let unmet: [8]string = ["module e1;", "pub trait Named { fn name(this: Self): string; }", "pub trait Labeled: Named {",
        "    fn tag(this: Self): int { return this.name().len; }", "}", "struct Pt { x: int; }", "fn main() { let p = Pt { x: 1 }; let t = p.tag(); }", ""];
    expect("unmet default", firstError("e1", unmet, &mem), "`Pt` does not satisfy `Labeled` (needed by `Self` of the default `tag`)|bound declared at :3|`Labeled` requires `Named` (a supertrait), which `Pt` does not meet|missing: fn name(this: Self): string|add `fn name(this: &Pt): string` to `struct Pt`, or `#[impl] fn name(x: Pt): string` in a module that declares `Named` or defines `Pt`");
    let queued: [7]string = ["module e2;", "pub trait Hash { fn hash(this: Self): u64; }", "struct Map<K: Hash, V> { k: K; v: V; }", "struct P { x: int; }",
        "fn f(m: Map<P, int>) {}", "fn main() {}", ""];
    expect("queued bound", firstError("e2", queued, &mem), "`P` does not satisfy `Hash` (needed by `K` of `Map`)|bound declared at :3|missing: fn hash(this: Self): u64|add `fn hash(this: &P): u64` to `struct P`, or `#[impl] fn hash(x: P): u64` in a module that declares `Hash` or defines `P`");
    let two: [6]string = ["module e3;", "pub trait A { fn go(this: Self): int { return 1; } }", "pub trait B { fn go(this: Self): int { return 2; } }",
        "struct P { x: int; }", "fn main() { let p = P { x: 1 }; let g = p.go(); }", ""];
    expect("ambiguous", firstError("e3", two, &mem), "`go` is ambiguous: `A`, `B` all give `P` a default `go`|define `go` on the type to choose");
    let wrong: [6]string = ["module e4;", "pub trait Hash { fn hash(this: Self): u64; }", "struct P { x: int; fn hash(this: &P): int { return 1; } }",
        "struct Map<K: Hash, V> { k: K; v: V; }", "fn main() { let m: Map<P, int> = Map<P, int> { k: P { x: 1 }, v: 2 }; }", ""];
    expect("wrong signature", firstError("e4", wrong, &mem), "`P` does not satisfy `Hash` (needed by `K` of `Map`)|bound declared at :4|`hash` has the wrong signature: found `fn hash(&P): int`, the bound wants `fn hash(this: Self): u64`|add `fn hash(this: &P): u64` to `struct P`, or `#[impl] fn hash(x: P): u64` in a module that declares `Hash` or defines `P`");
    // Review C2b-1 must-fixes: a bound checked in an instance body and in a template's placeholder pass,
    // a field / default / generic UFCS on a type parameter, a default body that instantiates itself.
    let inInst: [7]string = ["module e5;", "pub trait Hash { fn hash(this: Self): u64; }", "struct Tbl<K: Hash> { k: K; }", "struct Foo { a: int; }",
        "fn mk2<T>(x: T) { let t = Tbl<T> { k: x }; }", "fn main() { mk2(Foo { a: 1 }); }", ""];
    expect("bound in an instance body", firstError("e5", inInst, &mem), "`Foo` does not satisfy `Hash` (needed by `K` of `Tbl`)|bound declared at :3|missing: fn hash(this: Self): u64|add `fn hash(this: &Foo): u64` to `struct Foo`, or `#[impl] fn hash(x: Foo): u64` in a module that declares `Hash` or defines `Foo`");
    let inTemp: [6]string = ["module e6;", "pub trait Hash { fn hash(this: Self): u64; }", "struct Tbl<K: Hash> { k: K; }",
        "fn mk<T>(x: T) { let t = Tbl<T> { k: x }; }", "fn main() {}", ""];
    expect("bound in a template", firstError("e6", inTemp, &mem), "type parameter `T` does not satisfy `Hash` (needed by `K` of `Tbl`)|`T` is declared `T`; a generic body may use only what its bounds give|add the bound: `T: Hash`");
    let fld: [4]string = ["module e7;", "fn fld<T>(a: T): int { return a.x; }", "fn main() {}", ""];
    expect("field of a type parameter", firstError("e7", fld, &mem), "type parameter `T` has no field `x`: it has no bounds|a bound gives a type parameter methods only, never fields|call a trait method instead, or take a concrete type");
    let deep: [4]string = ["module e8;", "trait Tr { fn d(this: Self): int { let a = [this]; return a.d(); } }", "fn main() { let x = 1.d(); }", ""];
    let dm = firstError("e8", deep, &mem);
    if dm.len < 52 || dm[0..52] != "`Tr.d` instantiates itself with ever-deeper types|32" { panic(`runaway default: {dm}`); }
    let ufcs: [6]string = ["module e9;", "fn show<U>(u: U): int { return 1; }", "fn pick<T>(x: int): int { return x; }",
        "fn dbg<T>(x: T): int { return x.show(); }", "fn main() { let a = dbg(3); let b = a.pick::<f32>(); }", ""];
    typesFully("generic ufcs", ufcs, &mem);
}
