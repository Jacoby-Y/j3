// `run`/`build` flags split like Rust `take_run_flags` + `peel_run` / `peel_args`, and the build settings follow them.
module cmd_run_flags_test;

use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3c.cmd.run.{ noFlags, peelRun, takeRunFlags };
use j3c.driver;
use j3c.driver.Session;

fn main() {
    let mem = Arena.create(1 << 14);
    defer mem.destroy();
    let argv: [12]string = ["--headless", "--fast", "--frames", "+7", "--opt=2", "game.j3", "--emit", "llvm", "x", "--host", "-v", "y"];
    let f = noFlags(&mem);
    let left = List<string>.new(&mem);
    match takeRunFlags(argv[..], &f, &mem) {
        Result.Ok(v) { left = v; }
        Result.Err(e) { panic(e); }
    }
    if sys.env("J3_FRAMES") != "+7" || sys.env("SDL_VIDEODRIVER") != "offscreen" || !f.host { panic("run flags"); }
    peelRun(left.items[0..left.len], &f, true);
    // `--emit` after the path still sets the backend (Rust checks the flags before the path).
    if f.path != "game.j3" || !f.fast || f.opt != "2" || f.emit != "llvm" { panic("peel"); }
    if f.args.len != 3 || f.args.items[0] != "x" || f.args.items[1] != "-v" || f.args.items[2] != "y" { panic("program args"); }

    let b = noFlags(&mem);
    peelRun(argv[5..9], &b, false);
    if b.path != "game.j3" || b.args.len != 0 { panic("build takes no program args"); }

    let bad: [2]string = ["--frames", "0"];
    match takeRunFlags(bad[..], &f, &mem) {
        Result.Ok(_) { panic("--frames 0 accepted"); }
        Result.Err(e) { if e != "--frames wants a positive whole number, not `0`" { panic(e); } }
    }
    let none: [1]string = ["--screenshot"];
    match takeRunFlags(none[..], &f, &mem) {
        Result.Ok(_) { panic("--screenshot without a file"); }
        Result.Err(e) { if e != "--screenshot needs a file" { panic(e); } }
    }

    // Build settings (Rust `emit_opts`): a single file is opt 0 with debug info; `--release` is opt s, no -g,
    // stripped; `build` writes `target/a.out`, `run` a temp file.
    let o = driver.defaults();
    o.run = true;
    let s = Session.new(o);
    match driver.emitOpts(s) {
        Result.Ok(e) { if e.cc.opt != "0" || !e.cc.debug || e.cc.release || e.cc.out != "" { panic("dev settings"); } }
        Result.Err(x) { panic(x); }
    }
    s.free();
    let r = driver.defaults();
    r.release = true;
    let s2 = Session.new(r);
    match driver.emitOpts(s2) {
        Result.Ok(e) { if e.cc.opt != "s" || e.cc.debug || !e.cc.release || e.cc.out != "target/a.out" { panic("release settings"); } }
        Result.Err(x) { panic(x); }
    }
    s2.free();
}
