// ui/pass: `singleRoot`'s reasons, `scan`'s record and its two errors, and the generated text of `fields`,
// `apply`, `unused` (the formats of `j3c/src/ui/pass.rs`).
module ui_pass_test;

use j3.data.map.Map;
use j3.io;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.ui.markup.{ Markup, Node, parse };
use j3c.ui.pass;
use j3c.ui.pass.Pass;

fn same(what: string, got: string, want: string) {
    if got == want { return; }
    io.printLn(got);
    io.printLn(want);
    panic(what);
}

fn nodes(a: &Arena, src: string, uid: &int): List<Node> {
    match parse(src, a, uid) {
        Result.Ok(m) { return m.nodes; }
        Result.Err(e) { panic(e.msg); }
    }
    return List<Node>.new(a);
}

fn why(a: &Arena, src: string): string {
    let uid = 0;
    let n = nodes(a, src, &uid);
    match pass.singleRoot(&n) {
        Result.Ok(e) { return e.tag; }
        Result.Err(w) { return w; }
    }
    return "";
}

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;

    same("elem", why(a, "{#let k = 1}\n<div style:top={1}>x</div>\n"), "div");
    same("empty", why(a, "<script></script>\n"), "its markup is empty");
    same("comp", why(a, "<kit.Card />"), "its root is the component `<kit.Card>`");
    same("slot", why(a, "<slot />"), "its root is a `<slot />`");
    same("if", why(a, "{#if a}x{/if}"), "its root is an `{#if}`");
    same("match", why(a, "{#match a}{:case 1}x{/match}"), "its root is a `{#match}`");
    same("each", why(a, "{#each xs as x}x{/each}"), "its root is an `{#each}`");
    same("text", why(a, "hi {x}"), "its root is text");
    same("two", why(a, "<a></a> <b></b>{x}"), "it has 3 root nodes");

    let uid = 0;
    let card = nodes(a, "<div style:top={1} style:left={2}>x</div>", &uid);
    let bare = nodes(a, "a<b></b>", &uid);
    let roots = Map<string, List<Node>>.new(a, 16);
    roots.put("Card", card);
    roots.put("Bare", bare);
    let out = Map<string, Pass>.new(a, 16);
    let uses = "<div class=\"x\"><Card style:width={w} />{#if a}<Card class:on={b} style:width={w} style:height={h} />{:else}<Card title=\"t\" /><Other class=\"y\" />{/if}</div>";
    let app = nodes(a, uses, &uid);
    match pass.scan(&app, &roots, &out) { Result.Ok(_) {} Result.Err(e) { panic(e.msg); } }
    if out.len != 1 { panic("only Card takes passthrough"); }
    let p = match out.get("Card") { Option.Some(p) { p } Option.None { panic("no Card") } };
    if !p.cls || p.styles != 2 || p.own != 2 { panic("Card pass"); }
    match pass.singleRoot(&card) { Result.Ok(e) { if pass.ownStyles(&e) != 2 { panic("ownStyles"); } } Result.Err(e) { panic(e); } }

    let src = "<p><Bare class=\"x\" /></p>";
    let badUse = nodes(a, src, &uid);
    match pass.scan(&badUse, &roots, &out) {
        Result.Ok(_) { panic("Bare has no root"); }
        Result.Err(e) {
            same("no root", e.msg, "`class` on `<Bare>` has no element to go to: it has 2 root nodes");
            same("no root help", e.help, "`class` and `style:` land on the root element of `Bare`, so its markup must be exactly one element (not a component, `<slot />`, `{#if}`, `{#each}` or text); pass a prop instead");
            if e.lo != 9 || e.hi != 18 { panic("no root range"); }
        }
    }
    let many = nodes(a, "<Card class=\"k\" style:a={1} style:b={1} style:c={1} style:d={1} style:e={1} style:f={1} style:g={1} />", &uid);
    match pass.scan(&many, &roots, &out) {
        Result.Ok(_) { panic("9 styles"); }
        Result.Err(e) {
            same("too many", e.msg, "`<Card>` passes 7 `style:` and its root has 2 of its own: at most 8 together");
            if e.lo != 16 || e.hi != 27 { panic("too many range"); }
        }
    }

    let q = Pass { cls: true, styles: 2, own: 1 };
    same("fields", pass.fields(q, a), "    j3pass_scope: int;\n    j3pass_cls: string;\n    j3pass_k0: int;\n    j3pass_n0: string;\n    j3pass_f0: f32;\n    j3pass_s0: string;\n    j3pass_k1: int;\n    j3pass_n1: string;\n    j3pass_f1: f32;\n    j3pass_s1: string;\n");
    let v = pass.apply(q, "n3", a);
    let t = Text.new(a);
    for i in 0..v.len { t.add(v.items[i]).add("\n"); }
    same("apply", t.str(), "d.scopePass(n3, p.j3pass_scope);\nd.clsPass(n3, p.j3pass_cls);\nd.stylePass(n3, 1, p.j3pass_k0, p.j3pass_n0, p.j3pass_f0, p.j3pass_s0);\nd.stylePass(n3, 2, p.j3pass_k1, p.j3pass_n1, p.j3pass_f1, p.j3pass_s1);\n");
    let w = pass.apply(Pass { cls: false, styles: 0, own: 0 }, "n1", a);
    if w.len != 1 { panic("apply without class"); }
    same("unused", pass.unused(3, a), "j3pass_k3: 0, j3pass_n3: \"\", j3pass_f3: 0.0, j3pass_s3: \"\"");
}
