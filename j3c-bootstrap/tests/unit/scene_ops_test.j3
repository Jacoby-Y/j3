// scene ops: part scenes (check args), undo round trip and cap, diff by path, apply args, reply JSON.
// Port of: j3c/src/scene/tests.rs
module scene_ops_test;

use j3.data.json;
use j3.io;
use j3.io.path;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.contains;
use j3c.base.fsx;
use j3c.scene.diff;
use j3c.scene.history;
use j3c.scene.ops;
use j3c.scene.reply;

fn put(root: string, rel: string, text: string, a: &Arena) {
    let p = path.join(root, rel, a);
    match io.makeDirs(path.dirname(p)) { Result.Ok(_) {} Result.Err(_) { panic("mkdir"); } }
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic(p); } }
}

fn read(root: string, rel: string, a: &Arena): string {
    match fsx.readText(path.join(root, rel, a), a) { Result.Ok(t) { return t; } Result.Err(e) { panic(e); } }
    return "";
}

fn fresh(name: string, a: &Arena): string {
    let r = path.join("target/unit/scene_ops", name, a);
    fsx.removeTree(r, a);
    return r;
}

fn partScenes(a: &Arena) {
    let root = fresh("part", a);
    put(root, "j3.editor.toml", "[editor]\nscene = \"scenes/main.j3scene\"\n", a);
    put(root, "scenes/main.j3scene", "j3scene 2 next=3\n\nH place scenes/house.j3scene #1\nS place ./scenes/shed.j3scene #2\n", a);
    put(root, "scenes/shed.j3scene", "", a);
    put(root, "scenes/house.j3scene", "", a);
    put(root, "scenes/lonely.j3scene", "", a);
    let placed = ops.placedScenes(root, a);
    if ops.checkArgs(root, "scenes/house.j3scene", placed.slice(), a).len != 2 { panic("house is a part"); }
    if ops.checkArgs(root, "scenes/main.j3scene", placed.slice(), a).len == 2 { panic("main is not a part"); }
    if ops.checkArgs(root, "scenes/lonely.j3scene", placed.slice(), a).len == 2 { panic("lonely is not a part"); }
    if ops.checkArgs(root, "scenes/shed.j3scene", placed.slice(), a).len != 2 { panic("shed is a part"); }
    fsx.removeTree(root, a);
}

fn undoCap(a: &Arena) {
    let root = fresh("undo", a);
    let rel = "scenes/main.j3scene";
    put(root, rel, "v0", a);
    history.backup(root, rel, a);
    put(root, rel, "v1", a);
    match history.undo(root, rel, a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    if read(root, rel, a) != "v0" { panic("undo did not restore v0"); }
    match history.undo(root, rel, a) { Result.Ok(_) { panic("second undo"); } Result.Err(_) {} }
    for i in 0..25 {
        history.backup(root, rel, a);
        put(root, rel, `v{i}`, a);
    }
    let base = "";
    if history.history(root, rel, &base, a).len != history.KEEP { panic("history not capped"); }
    match history.undo(root, rel, a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    if read(root, rel, a) != "v23" { panic("undo did not restore v23"); }
    fsx.removeTree(root, a);
}

fn diffByPath(a: &Arena) {
    let root = fresh("diff", a);
    put(root, "scenes/a.j3scene", "j3scene 2 next=4\n\nHouse cube #1\n  Door cube pos=1,0,0 #2\nOld cube #3\n", a);
    // Ids shift (as after a split); matching is by path.
    put(root, "scenes/b.j3scene", "j3scene 2 next=10\n\nHouse cube tint=0.5,1,1 #7\n  Door cube pos=3,0,0 #8\nNew cube #9\n", a);
    let d = match diff.diff(root, "scenes/b.j3scene", Option.Some("scenes/a.j3scene"), a) { Result.Ok(d) { d } Result.Err(e) { panic(e); return; } };
    if d.added.len != 1 || d.added.items[0] != "New at 0.00,0.00,0.00" { panic("added"); }
    if d.removed.len != 1 || d.removed.items[0] != "Old at 0.00,0.00,0.00" { panic("removed"); }
    if d.moved.len != 1 || !contains(d.moved.items[0], "House/Door ") { panic("moved"); }
    if d.changed.len != 1 || d.changed.items[0] != "House: tint (default) -> 0.5,1,1" { panic(if d.changed.len > 0 { d.changed.items[0] } else { "no change" }); }
    fsx.removeTree(root, a);
}

fn lineOk(s: string): bool { return s.len == 27 && s[0..15] == "lines=A cube #1" && s[15] == 0x1f && s[16..27] == "  B cube #2"; }

fn applyArgs(a: &Arena) {
    let args = match ops.applyArgs("A cube #1\n  B cube #2\n", Option.Some("Hub"), a) { Result.Ok(v) { v } Result.Err(e) { panic(e); return; } };
    if args.len != 3 || args.items[0] != "apply" || !lineOk(args.items[1]) || args.items[2] != "parent=Hub" { panic("apply args"); }
    match ops.requestText(args.slice(), a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    match ops.applyArgs("a\tb", Option.None, a) { Result.Ok(_) { panic("tab accepted"); } Result.Err(_) {} }
}

fn replyJson(a: &Arena) {
    let r = reply.parse("node\t3\tHouse/Door\tmesh\t2\tbuiltin:cube\t1,2,3\t0,90,0\t1,1,1\t\t\t\n", true, a);
    let j = json.stringify(reply.toJson("list", "scenes/main.j3scene", &r, a), a);
    if !contains(j, "\"path\":\"House/Door\"") || !contains(j, "\"worldPosition\":[1,2,3]") { panic(j); }
    let bad = reply.parse("err\tno object named Dor; did you mean House/Door\n", false, a);
    if bad.ok { panic("err reply ok"); }
    let j2 = json.stringify(reply.toJson("get", "s.j3scene", &bad, a), a);
    if !contains(j2, "did you mean House/Door") { panic(j2); }
}

fn main() {
    let a = Arena.create(1 << 22);
    partScenes(&a);
    undoCap(&a);
    diffByPath(&a);
    applyArgs(&a);
    replyJson(&a);
}
