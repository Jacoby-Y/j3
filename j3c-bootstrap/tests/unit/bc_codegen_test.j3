// Bytecode codegen against stage 0: every script of the corpus projects (`bc_codegen_cases/j3sb.txt`) is checked
// (`Mode.Check` through the passes, nothing written), emitted with `bc.emitScript`, encoded, and its SHA-256
// must equal the `.j3sb` stage 0 writes on `run`. A mismatch prints the `dump-bc` text of the module (compare
// with `stage0/j3c dump-bc` on a scratch copy). The six scripts cover arithmetic and loops, struct fields,
// string interpolation, `shared` globals, native calls and a script-to-script call (`duel` -> `fighter`).
module bc_codegen_test;

use j3.data.pool.Id;
use j3.hash.{ Sha256Sum, sha256 };
use j3.io;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text;
use j3.text.Text;
use j3c.backend.bc;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use j3c.ir.Program;

/// The `dump-bc` text and SHA-256 of the script `rel` of project `dir`; "" when no script module has that path.
fn emitted(prog: &Program, rel: string, dump: &Text, mem: &Arena): string {
    for mi in 0..prog.modules.len {
        let m = &prog.modules.items[mi];
        if !bc.isScriptModule(&prog.cx, m.name.slice()) { continue; }
        match bc.emitScript(&prog.cx, m, mem) {
            Result.Ok(b) {
                if b.path != rel { continue; }
                bc.dump(&b, dump);
                let bytes = bc.encode(&b, mem);
                let h = Text.new(mem);
                let sum = sha256(bytes.slice());
                sum.hex(&h);
                return h.str();
            }
            Result.Err(e) { panic(Text.new(mem).add(rel).add(": ").add(e).str()); }
        }
    }
    return "";
}

/// One `j3sb.txt` line; true when it matches.
fn case(dir: string, rel: string, want: string, mem: &Arena): bool {
    let o = driver.defaults();
    o.entry = dir;
    o.mode = Mode.Check;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) || s.diags.hasErrors() {
        panic(Text.new(mem).add(dir).add(": does not check: ").add(failText(s)).str());
    }
    let dump = Text.new(mem);
    let got = "";
    match s.program {
        Option.Some(prog) { got = emitted(prog, rel, &dump, mem); }
        Option.None { panic("no program"); }
    }
    if got == want { return true; }
    let t = Text.new(mem);
    t.add("DIFF ").add(dir).add(" ").add(rel).add(": got ").add(got).add("\n").add(dump.str());
    io.printLn(t.str());
    return false;
}

fn corpus(mem: &Arena): int {
    let bad = 0;
    match io.readFile("tests/unit/bc_codegen_cases/j3sb.txt", mem) {
        Result.Ok(b) {
            let ls = text.lines(b as string);
            while true {
                match ls.next() {
                    Option.Some(line) {
                        if line.len == 0 || line[0] == '#' { continue; }
                        let parts = List<string>.new(mem);
                        let sp = text.split(line, " ");
                        while true {
                            match sp.next() { Option.Some(p) { parts.push(p); } Option.None { break; } }
                        }
                        if parts.len != 3 { panic(Text.new(mem).add("bad j3sb.txt line: ").add(line).str()); }
                        if !case(parts.items[0], parts.items[1], parts.items[2], mem) { bad += 1; }
                    }
                    Option.None { break; }
                }
            }
        }
        Result.Err(_) { panic("read bc_codegen_cases/j3sb.txt"); }
    }
    return bad;
}

fn main() {
    let mem = Arena.create(1 << 20);
    defer mem.destroy();
    let bad = corpus(&mem);
    if bad != 0 { panic(Text.new(&mem).add("bc codegen differs from stage 0 on ").add(`{bad}`).add(" scripts").str()); }
}
