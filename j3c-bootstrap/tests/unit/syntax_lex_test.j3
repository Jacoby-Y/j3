// Lexer and `fmt`: every lex error message and span checked against stage 0 (spans read from
// `stage0/j3c check` on the same one-line files), a few token texts, and `fmt` cases (CRLF, tabs, no
// final newline, comments, Unicode) checked against `stage0/j3c fmt`.
module syntax_lex_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.span.Source;
use j3c.syntax.fmt;
use j3c.syntax.lex.lex;
use j3c.syntax.token.{ Token, TokenKind };

fn file(): Id<Source> { return Id<Source> { i: 3 }; }

fn bad(m: &Arena, src: string, lo: int, hi: int, msg: string) {
    match lex(src, file(), m) {
        Result.Ok(_) { printLn(`lexed: {src}`); panic("expected a lex error"); }
        Result.Err(e) {
            if e.msg != msg || int(e.span.lo) != lo || int(e.span.hi) != hi || e.span.file != file() {
                printLn(`{src}: got {e.span.lo}..{e.span.hi} {e.msg}`);
                printLn(`want {lo}..{hi} {msg}`);
                panic("lex error differs from stage 0");
            }
        }
    }
}

fn toks(m: &Arena, src: string): List<Token> {
    match lex(src, file(), m) {
        Result.Ok(t) { return t; }
        Result.Err(e) { printLn(e.msg); panic("lex failed"); }
    }
}

fn tok(ts: &List<Token>, i: int, kind: TokenKind, text: string) {
    let t = ts.items[i];
    if t.kind != kind || t.text != text { printLn(`token {i}: {t.text}`); panic("token differs"); }
}

fn fmtIs(m: &Arena, src: string, want: string) {
    match fmt.format(src, m) {
        Result.Ok(got) { if got != want { printLn(`got:\n{got}`); printLn(`want:\n{want}`); panic("fmt differs"); } }
        Result.Err(e) { printLn(e); panic("fmt failed"); }
    }
}

fn main() {
    let m = Arena.create(1 << 16);
    defer m.destroy();
    let t = Text.new(&m);
    t.pushChar(0xFEFF);
    t.add("module a;");
    bad(&m, t.str(), 0, 3, "unexpected character '\\u{feff}'");
    let c = Text.new(&m);
    c.add("fn f(){ ");
    c.push(1);
    c.add(" }");
    bad(&m, c.str(), 8, 9, "unexpected character '\\u{1}'");
    bad(&m, "let x = 0b2;", 8, 10, "invalid binary literal");
    bad(&m, "fn f(){ \\ }", 8, 9, "unexpected character '\\\\'");
    bad(&m, "module a;\nfn f(){ let $x = 1; }", 22, 23, "unexpected character '$'");
    bad(&m, "let c = '';", 8, 10, "empty char literal");
    bad(&m, "let s = \"a\\qb\";", 10, 12, "unknown string escape \\q");
    bad(&m, "let c = '\\nx';", 8, 13, "a char literal holds one character (a string is `\"..\"`)");
    bad(&m, "let c = '\\", 8, 10, "unterminated char literal");
    bad(&m, "let c = '\\q';", 8, 11, "unknown char escape \\q");
    bad(&m, "let s = \"a\\éb\";", 11, 13, "unknown string escape \\é");
    bad(&m, "let c = '\\u41';", 8, 11, "`\\u` takes `{hex}`");
    bad(&m, "let c = '\\u{}';", 8, 11, "`\\u{..}` takes 1 to 6 hex digits");
    bad(&m, "let c = '\\u{1234567}';", 8, 11, "`\\u{..}` takes 1 to 6 hex digits");
    bad(&m, "let c = '\\u{D800}';", 8, 11, "`\\u{D800}` is not a Unicode scalar value");
    bad(&m, "let c = '\\u{zz}';", 8, 11, "`\\u{..}` takes hex digits");
    bad(&m, "let c = '\\x8f';", 8, 11, "`\\x` is ASCII (up to `\\x7f`); write `\\u{..}` for a code point");
    bad(&m, "let c = '\\xg1';", 8, 11, "`\\x` takes two hex digits");
    bad(&m, "let c = '\\é';", 8, 12, "unknown char escape \\é");
    bad(&m, "let x = €;", 8, 11, "unexpected character '€'");
    bad(&m, "let x = 1e+;", 8, 11, "malformed float exponent: expected digits after the sign");
    bad(&m, "let x = 1.5E-x;", 8, 13, "malformed float exponent: expected digits after the sign");
    bad(&m, "let x = 0xg;", 8, 10, "invalid hex literal");
    bad(&m, "let s = `ab", 8, 11, "unterminated interpolate");
    bad(&m, "let s = `a\nb`;", 8, 10, "newline in interpolate");
    bad(&m, "x 'abc' y", 2, 7, "a char literal holds one character (a string is `\"..\"`)");
    bad(&m, "let c = 'ab';", 8, 12, "a char literal holds one character (a string is `\"..\"`)");
    bad(&m, "let c = '+-';", 8, 12, "a char literal holds one character (a string is `\"..\"`)");
    bad(&m, "let c = '9", 8, 9, "unexpected character '\\''");
    bad(&m, "let c = '", 8, 9, "unexpected character '\\''");
    bad(&m, "let c = ' x;", 8, 9, "unexpected character '\\''");
    bad(&m, "let s = \"abc", 8, 12, "unterminated string");
    bad(&m, "let s = \"ab\nc\";", 8, 11, "newline in string");

    let ts = toks(&m, "/// doc  \r\nlet s = \"a\\tb\" 'x' '\\u{1F600}' 'outer café t.0.1 1.5e3 0xff >>= <<");
    tok(&ts, 0, TokenKind.Doc, "doc");
    tok(&ts, 3, TokenKind.Eq, "");
    tok(&ts, 4, TokenKind.String, "a\tb");
    tok(&ts, 5, TokenKind.Char, "120");
    tok(&ts, 6, TokenKind.Char, "128512");
    tok(&ts, 7, TokenKind.Label, "'outer");
    tok(&ts, 8, TokenKind.Ident, "café");
    tok(&ts, 11, TokenKind.Int, "0");
    tok(&ts, 13, TokenKind.Int, "1");
    tok(&ts, 14, TokenKind.Float, "1.5e3");
    tok(&ts, 15, TokenKind.Int, "0xff");
    tok(&ts, 16, TokenKind.ShrEq, "");
    tok(&ts, 17, TokenKind.Lt, "");
    tok(&ts, 18, TokenKind.Lt, "");
    tok(&ts, 19, TokenKind.Eof, "");

    fmtIs(&m, "", "\n");
    fmtIs(&m, "module a;\r\nfn main() {\r\n    // hi\r\n    /// doc  \r\n    let x = 1;\r\n}\r\n",
        "module a;\nfn main() {\n    // hi\n    /// doc  \r\n    let x = 1;\n}\n");
    fmtIs(&m, "module a;\n\tfn main(){\tlet x=1;\t// c\t\n\n\n\tlet y=2;}",
        "module a;\nfn main() {\n    let x = 1; // c\n\n    let y = 2;\n}\n");
    fmtIs(&m, "// just\n\n\n// two", "// just\n\n// two\n");
    fmtIs(&m, "fn main(){match p{P{x,y:1,..}=>{}} let S{a,b}=s;}",
        "fn main() {\n    match p {\n        P { x, y: 1, .. } =>{\n        }\n    }\n    let S { a, b } = s;\n}\n");
    printLn("syntax_lex: ok");
}
