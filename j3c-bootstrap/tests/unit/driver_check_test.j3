// `check` failures against the oracle: each case is written under `$TMPDIR` (no `j3.toml` above it), loaded
// in-process with `driver.run(Stage.Load)`, and what `check` / `check --json` would print is compared byte
// for byte with `tests/unit/expect/driver_check.txt` (stdout, stderr; frozen from the Rust compiler's
// `check [--json] PATH`, plan 15; the case folder is `$TMP` there). A program that loads must
// stop at sema (C2) with the load stage clean.
module driver_check_test;

use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use unitkit;

/// Write `text` to `dir/name` (dirs made).
fn put(dir: string, name: string, text: string) {
    let mem = Arena.create(1 << 12);
    defer mem.destroy();
    match io.makeDirs(dir) { Result.Ok(_) {} Result.Err(_) { panic("cannot make a case dir"); } }
    let t = Text.new(&mem);
    match io.writeFile(t.add(dir).add("/").add(name).str(), text as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case"); } }
}

/// Load `path` in-process and append what `check` and `check --json` print to `all`.
fn add(path: string, all: &Text) {
    let flags: [2]string = ["", " --json"];
    for k in 0..2 {
        let o = driver.defaults();
        o.entry = path;
        let s = Session.new(o);
        if driver.run(s, Stage.Load) { panic(Text.new(s.arena).add("loads, expected an error: ").add(path).str()); }
        let (out, err) = check.failOutput(check.failText(s), k == 1, s.arena);
        all.add("== check").add(flags[k]).add(" ").add(path).add("\n").add(out).add("--- stderr\n").add(err);
        s.free();
    }
}

fn main() {
    let mem = Arena.create(1 << 12);
    let root = Text.new(&mem).add(io.tempRoot()).add("/j3c-boot-driver-check").str();
    let d = Text.new(&mem).add(root).add("/").str();
    put(root, "parse.j3", "module parse;\nfn main() {\n    let x = 3\n}\n");
    put(root, "nomod.j3", "fn main() {}\n");
    put(root, "badimport.j3", "module badimport;\nuse helper;\nfn main() {}\n");
    put(root, "good.j3", "module good;\nfn main() {}\n");
    put(Text.new(&mem).add(d).add("empty").str(), "x.txt", "");
    put(Text.new(&mem).add(d).add("proj/src").str(), "main.j3", "module main;\nfn main( {}\n");
    put(Text.new(&mem).add(d).add("proj").str(), "j3.toml", "[package]\nname = \"proj\"\nentry = \"src/main.j3\"\n");
    put(Text.new(&mem).add(d).add("badtoml").str(), "j3.toml", "name = 1\n[package]\n");

    let cases: [7]string = ["parse.j3", "nomod.j3", "badimport.j3", "missing.j3", "empty", "proj", "badtoml"];
    let all = Text.new(&mem);
    for i in 0..cases.len { add(Text.new(&mem).add(d).add(cases[i]).str(), &all); }
    unitkit.expect(unitkit.mask(all.str(), root, "$TMP", &mem), "driver_check.txt", "check output differs from tests/unit/expect/driver_check.txt");

    // A plain program loads, checks and lowers with no diagnostics.
    let o = driver.defaults();
    o.entry = Text.new(&mem).add(d).add("good.j3").str();
    let s = Session.new(o);
    if !driver.run(s, Stage.Load) || s.diags.count() != 0 { panic("good.j3 does not load cleanly"); }
    s.free();
    let s2 = Session.new(o);
    if !driver.run(s2, Stage.Sema) || s2.diags.count() != 0 { panic("good.j3 does not check cleanly"); }
    s2.free();
    let s3 = Session.new(o);
    if !driver.run(s3, Stage.Lower) || s3.diags.count() != 0 { panic("good.j3 does not lower cleanly"); }
    s3.free();

    printLn("driver check ok: 7 cases, text and --json");
}
