// ui/map: `Out` segments and `SpanMap` both ways (Rust `ui/map.rs` `maps_both_ways`), `copyFlat`, `append`,
// and `base/span.locate` over the pieces of a generated source.
module ui_map_test;

use j3.data.pool.{ Id, Pool };
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.sys.panic;
use j3c.base.span.{ GenPiece, Source, Span, locate, noSpan };
use j3c.ui.map.{ Out, SpanMap, SrcSpan };

fn src(m: &SpanMap, lo: int, hi: int): SrcSpan {
    match m.toSrc(lo, hi) {
        Option.Some(s) { return s; }
        Option.None { panic(`toSrc({lo}, {hi}) is None`); }
    }
    return SrcSpan { file: 0, lo: 0, hi: 0, hint: "" };
}

fn main() {
    let arena = Arena.create(1 << 16);
    let text = "a.b(c)";
    let o = Out.new(&arena, 0);
    o.set(0, 0, 6);
    o.s("x = ");
    o.copy(0, text, 0, 6);
    o.s(";");
    if o.text.str() != "x = a.b(c);" { panic("text"); }
    let m = SpanMap { segs: o.segs };
    let s = src(&m, 4 + 2, 4 + 3);
    if s.lo != 2 || s.hi != 3 { panic("copy maps byte for byte"); }
    if m.toGen(0, 2) != 6 { panic("toGen"); }
    if m.toGen(1, 2) != -1 { panic("toGen of another file"); }
    let g = src(&m, 0, 2);
    if g.lo != 0 || g.hi != 6 { panic("glue maps to the whole construct"); }
    match m.toSrc(11, 12) { Option.Some(_) { panic("past the map"); } Option.None {} }

    // glue calls with one context merge; a hint or `at` starts a new segment
    let p = Out.new(&arena, 1);
    p.ind = 2;
    p.line("a");
    if p.text.str() != "        a\n" || p.segs.len != 1 { panic("line + merge"); }
    p.at(1, 7, "b");
    p.hint = "try this";
    p.s("c");
    if p.segs.len != 3 || p.segs.items[1].slo != 7 || p.segs.items[2].hint != "try this" || p.file != 1 || p.slo != 0 { panic("at / hint"); }
    // a cross-segment copy span ends in the last copy of the same file
    let two = "ab cd";
    let q = Out.new(&arena, 0);
    q.copy(0, two, 0, 2);
    q.s("this.");
    q.copy(0, two, 3, 5);
    let qm = SpanMap { segs: q.segs };
    let x = src(&qm, 1, 9);
    if x.lo != 1 || x.hi != 5 { panic("cross-segment span"); }

    // copyFlat: `\n` to a space, `\r` dropped, only when there is a newline
    let f = Out.new(&arena, 0);
    f.copyFlat(0, "a\r\nb", 0, 4);
    f.copyFlat(0, "c\rd", 0, 3);
    if f.text.str() != "a bc\rd" { panic("copyFlat"); }

    // append shifts segments
    let h = Out.new(&arena, 0);
    h.s("head\n");
    h.append(&o);
    if h.text.str() != "head\nx = a.b(c);" || h.segs.len != 4 || h.segs.items[2].lo != 9 || !h.segs.items[2].copy { panic("append"); }

    // base/span.locate: generated bytes report the `.j3ui` position
    let sources = Pool<Source>.new(&arena);
    let ui = sources.add(Source.of("ui/A.j3ui", "<p>\n{a.b(c)}\n</p>", &arena));
    let gsrc = Source.of("app.ui.generated", "x = a.b(c);", &arena);
    gsrc.gen.push(GenPiece { lo: 0, hi: 4, file: ui, at: 4, copy: false });
    gsrc.gen.push(GenPiece { lo: 4, hi: 10, file: ui, at: 5, copy: true });
    let gid = sources.add(gsrc);
    let l = locate(&sources, Span { file: gid, lo: 6, hi: 9 });
    if l.file != ui || l.lo != 7 || l.hi != 8 { panic("locate copy"); }
    let l2 = locate(&sources, Span { file: gid, lo: 1, hi: 2 });
    if l2.file != ui || l2.lo != 4 { panic("locate glue"); }
    let out = Span { file: gid, lo: 10, hi: 11 };
    if locate(&sources, out) != out { panic("a byte no piece covers stays"); }
    let real = Span { file: ui, lo: 3, hi: 4 };
    if locate(&sources, real) != real || locate(&sources, noSpan()) != noSpan() { panic("a real file stays"); }
}
