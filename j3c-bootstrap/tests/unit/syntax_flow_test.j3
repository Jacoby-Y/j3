// `syntax/flow` on hand-built bodies: Rust's `parse/flow.rs` `shapes` cases, plus `leaves` (jumps count)
// and `exprDiverges` on a match whose arms all panic.
module syntax_flow_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.sys.panic;
use j3c.base.span.{ Lines, Source, Span };
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ Ast, Block, CallExpr, Expr, ExprStmt, ForStmt, Ident, IfStmt, JumpStmt, LabeledStmt, MatchArm, MatchStmt, Pat, ReturnStmt, Stmt, Type, WhileStmt };
use j3c.syntax.flow.{ diverges, exprDiverges, leaves };

/// Node builder: every node gets the same span (flow never reads spans).
struct B {
    ast: &Ast;
    sp: Span;

    fn block(this: &B, xs: []Id<Stmt>): Block {
        let l = List<Id<Stmt>>.new(this.ast.arena);
        for i in 0..xs.len { l.push(xs[i]); }
        return Block { span: this.sp, stmts: l };
    }
    fn none(this: &B): Block { return Block { span: this.sp, stmts: List<Id<Stmt>>.new(this.ast.arena) }; }
    fn ident(this: &B, s: string): Ident { return Ident { name: this.ast.sym(s), span: this.sp }; }
    fn st(this: &B, s: Stmt): Id<Stmt> { return this.ast.addStmt(s, this.sp); }
    fn ex(this: &B, e: Expr): Id<Expr> { return this.ast.addExpr(e, this.sp); }
    fn ret(this: &B): Id<Stmt> { return this.st(Stmt.Return(ReturnStmt { span: this.sp, value: Option.Some(this.ex(Expr.Int(1))) })); }
    fn plain(this: &B): Id<Stmt> { return this.st(Stmt.Expr(ExprStmt { expr: this.ex(Expr.Int(1)) })); }
    fn brk(this: &B, label: string): Id<Stmt> {
        if label.len == 0 { return this.st(Stmt.Break(JumpStmt { label: Option.None })); }
        return this.st(Stmt.Break(JumpStmt { label: Option.Some(this.ident(label)) }));
    }
    fn ifs(this: &B, t: Block, e: Option<Block>): Id<Stmt> {
        return this.st(Stmt.If(IfStmt { span: this.sp, cond: this.ex(Expr.Bool(true)), thenBlock: t, elseBlock: e }));
    }
    fn loop(this: &B, cond: bool, body: Block): Id<Stmt> {
        return this.st(Stmt.While(WhileStmt { span: this.sp, cond: this.ex(Expr.Bool(cond)), body: body }));
    }
    fn forRange(this: &B, body: Block): Id<Stmt> {
        return this.st(Stmt.For(ForStmt { span: this.sp, name: this.ident("i"), start: this.ex(Expr.Int(0)), end: this.ex(Expr.Int(3)), inclusive: false, body: body }));
    }
    fn labeled(this: &B, label: string, s: Id<Stmt>): Id<Stmt> {
        return this.st(Stmt.Labeled(LabeledStmt { span: this.sp, label: this.ident(label), body: s }));
    }
    /// `f(..)` with `f` a plain name.
    fn call(this: &B, f: string): Id<Expr> {
        let func = this.ex(Expr.Name(this.ident(f)));
        return this.ex(Expr.Call(CallExpr { func: func, typeArgs: List<Id<Type>>.new(this.ast.arena), args: List<Id<Expr>>.new(this.ast.arena) }));
    }
    fn exprSt(this: &B, e: Id<Expr>): Id<Stmt> { return this.st(Stmt.Expr(ExprStmt { expr: e })); }
    /// `match 1 { _ { body } tail? }` with one arm per (body, tail) pair.
    fn matchOf(this: &B, bodies: []Block, tails: []Option<Id<Expr>>): MatchStmt {
        let arms = List<MatchArm>.new(this.ast.arena);
        for i in 0..bodies.len {
            let pats = List<Id<Pat>>.new(this.ast.arena);
            pats.push(this.ast.addPat(Pat.Wild, this.sp));
            arms.push(MatchArm { span: this.sp, pats: pats, guard: Option.None, body: bodies[i], tail: tails[i] });
        }
        return MatchStmt { span: this.sp, expr: this.ex(Expr.Int(1)), arms: arms };
    }
}

fn div(ast: &Ast, b: Block): bool { return diverges(ast, &b); }
fn lv(ast: &Ast, b: Block): bool { return leaves(ast, &b); }

fn check(got: bool, want: bool, what: string) {
    if got != want { printLn(what); panic("flow shape wrong"); }
}

fn main() {
    let s = Session.new(driver.defaults());
    let file = s.sources.add(Source { path: "t.j3", text: "", lines: Lines.of("", s.arena) });
    let ast = Ast.new(s.arena, &s.names);
    let b = B { ast: &ast, sp: Span { file: file, lo: 0, hi: 0 } };

    // Rust `shapes`
    check(div(&ast, b.block([b.ret()])), true, "return 1;");
    check(div(&ast, b.block([b.plain()])), false, "let x = 1;");
    check(div(&ast, b.block([b.ifs(b.block([b.ret()]), Option.Some(b.block([b.ret()])))])), true, "if/else both return");
    check(div(&ast, b.block([b.ifs(b.block([b.ret()]), Option.None)])), false, "if without else");
    check(div(&ast, b.block([b.loop(true, b.none())])), true, "while true {}");
    check(div(&ast, b.block([b.loop(true, b.block([b.brk("")]))])), false, "while true { break; }");
    check(div(&ast, b.block([b.loop(true, b.block([b.forRange(b.block([b.brk("")]))]))])), true, "inner break");
    check(div(&ast, b.block([b.labeled("a", b.loop(true, b.block([b.forRange(b.block([b.brk("a")]))])))])), false, "break 'a");
    check(div(&ast, b.block([b.exprSt(b.call("panic"))])), true, "panic(\"x\");");
    check(div(&ast, b.block([b.forRange(b.block([b.ret()]))])), false, "for { return }");
    check(div(&ast, b.block([b.loop(false, b.none())])), false, "while false {}");

    // jumps leave a block but do not end a function
    check(lv(&ast, b.block([b.brk("")])), true, "leaves: break");
    check(div(&ast, b.block([b.brk("")])), false, "diverges: break");

    // a match whose arms all leave: by statements or by a tail
    let allPanic = b.matchOf([b.none(), b.block([b.ret()])], [Option.Some(b.call("exit")), Option.None]);
    let me = b.ex(Expr.Match(allPanic));
    check(exprDiverges(&ast, me), true, "match: every arm leaves");
    check(div(&ast, b.block([b.exprSt(me)])), true, "match statement expr");
    let oneFalls = b.matchOf([b.none(), b.none()], [Option.Some(b.call("panicAt")), Option.Some(b.call("print"))]);
    check(exprDiverges(&ast, b.ex(Expr.Match(oneFalls))), false, "match: one arm falls through");
    let empty = MatchStmt { span: b.sp, expr: b.ex(Expr.Int(1)), arms: List<MatchArm>.new(s.arena) };
    check(div(&ast, b.block([b.st(Stmt.Match(empty))])), false, "empty match");
    // a break inside a match arm leaves the endless loop
    let brkArm = b.matchOf([b.block([b.brk("")])], [Option.None]);
    check(div(&ast, b.block([b.loop(true, b.block([b.st(Stmt.Match(brkArm))]))])), false, "break in match arm");
    s.free();
    printLn("syntax_flow ok");
}
