// `layout_test.j3`'s check for structs whose names clash with one it imports (J3 `use` has no alias and a
// turbofish takes no module path).
module layout_more_test;

use j3.memory.Arena;
use j3.sys.panic;
use j3c.dist.pkg.Built;

fn chk<T>(a: &Arena, name: string) {
    let s = a.alloc::<T>(2);
    let stride = int(&s[1] as ptr) - int(&s[0] as ptr);
    if stride != @sizeof(T) { panic(`{name}: @sizeof {@sizeof(T)}, LLVM stride {stride}: reorder its fields (bools last)`); }
}

fn main() {
    let arena = Arena.create(1 << 16);
    chk::<Built>(&arena, "j3c.dist.pkg.Built");
}
