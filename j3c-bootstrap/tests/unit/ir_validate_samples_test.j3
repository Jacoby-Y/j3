// `ir.validate` passes the `ir_samples` fixture (Rust `place_samples_validate`) and rejects hand-broken
// copies of it with Rust's messages.
// J3: Says `module ir_samples;` to get the fixture parts (`ir_validate_samples_test/` is a symlink to
// `ir_samples/`); the fixture's `use`s are in `ir_samples/samples.j3`.
module ir_samples;

use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.driver;
use j3c.driver.Session;
use j3c.ir.{ LocalDecl, LocalRoot, PlaceRoot, RvalueKind, StmtKind, SwitchCase, SwitchStmt, constBinding };
use j3c.ir.validate.validateProgram;

/// The fixture's fns in module order: checkpoint, scale, bump, tick, main.
fn fnId(p: &Program, i: int): Id<Func> { return p.modules.items[0].funcs.items[i]; }

/// The top-level statements of fn `i` (shares its items, so `items[k] = ..` edits the fixture).
fn stmts(p: &Program, i: int): List<Stmt> {
    match p.cx.func(fnId(p, i)).kind {
        FuncKind.J3(j) { return j.body.block.stmts; }
        _ { panic("fixture fn has no body"); }
    }
}

fn fresh(s: &Session): &Program {
    let p = s.arena.new::<Program>(Program.new(s.arena, &s.names, &s.sources));
    placeSamples(p);
    return p;
}

/// Validation of `p` fails with exactly `want`.
fn rejects(p: &Program, want: string) {
    match validateProgram(p) {
        Result.Ok(_) { panic(Text.new(p.cx.arena).add("accepted; want: ").add(want).str()); }
        Result.Err(e) { if e.message != want { panic(Text.new(p.cx.arena).add("got: ").add(e.message).add("\nwant: ").add(want).str()); } }
    }
}

/// Breaks the place of `main`'s first statement, `arena = Arena { null, 7, 9 }`: 0 its type, 1 its
/// access, 2 its local (id 99).
// J3: edits inside the arm; returning the `AssignStmt` payload out of the match crashed stage 0.
fn breakFirstPlace(p: &Program, how: int) {
    let st = stmts(p, 4);
    let k = st.items[0].kind;
    match k {
        StmtKind.Assign(a) {
            if how == 0 { a.place.ty = p.cx.common.bool; }
            if how == 1 { a.place.access = constBinding(); }
            if how == 2 { a.place.root = PlaceRoot.Local(LocalRoot { id: Id<LocalDecl> { i: 99 } }); }
            st.items[0].kind = StmtKind.Assign(a);
        }
        _ { panic("main stmt 0"); }
    }
}

fn main() {
    let s = Session.new(driver.defaults());
    let p = fresh(s);
    match validateProgram(p) { Result.Ok(_) {} Result.Err(e) { panic(e.message); } }
    let sp = noSpan();

    p = fresh(s);
    stmts(p, 4).items[0].ty = p.cx.common.int;
    rejects(p, "statement type must be void");

    p = fresh(s);
    breakFirstPlace(p, 0);
    rejects(p, "place.ty does not match projections");

    p = fresh(s);
    breakFirstPlace(p, 1);
    rejects(p, "place.access does not match projections");

    p = fresh(s);
    breakFirstPlace(p, 2);
    rejects(p, "unknown local 99");

    p = fresh(s);
    stmts(p, 4).items[0].kind = StmtKind.Break(0);
    rejects(p, "break/continue outside a loop");

    p = fresh(s);
    let cases = List<SwitchCase>.new(s.arena);
    cases.push(SwitchCase { value: 1, block: Block.empty(s.arena) });
    cases.push(SwitchCase { value: 1, block: Block.empty(s.arena) });
    stmts(p, 4).items[0].kind = StmtKind.Switch(SwitchStmt { scrut: opInt(sp, p.cx.common.int, 3), cases: cases, default: Block.empty(s.arena) });
    rejects(p, "duplicate switch case 1");

    // `scale(copy v_p, 2)`: an int where the fn takes f32.
    p = fresh(s);
    match stmts(p, 4).items[8].kind {
        StmtKind.Expr(rv) {
            match rv.kind {
                RvalueKind.Call(c) {
                    let args = ops(&p.cx, [c.args.items[0], opInt(sp, p.cx.common.int, 2)]);
                    stmts(p, 4).items[8].kind = StmtKind.Expr(Rvalue.call(sp, rv.ty, c.func, args));
                }
                _ { panic("main stmt 8 is not a call"); }
            }
        }
        _ { panic("main stmt 8"); }
    }
    rejects(p, "internal: call argument 2 type mismatch (the checker should have caught this; please report it)");

    p = fresh(s);
    p.cx.funcMut(fnId(p, 2)).ty = p.cx.tyFn(tys(&p.cx, [p.cx.tySlice(p.cx.common.int)]), p.cx.common.void);
    rejects(p, "param count 2 != fn type 1");

    p = fresh(s);
    stmts(p, 0).items[0] = Stmt.returnValue(sp, p.cx.common.void, Option.Some(opBool(sp, p.cx.common.bool, true)));
    rejects(p, "return value type != function return type");

    s.free();
}
