// editor assets: the catalog's script props, create script, rename and delete, scene rename (v2 lines).
// Port of: j3c/src/editor/tests.rs (catalog_lists_script_props, rename_and_delete_assets)
module editor_assets_test;

use j3.io;
use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.contains;
use j3c.base.fsx;
use j3c.editor.assets;
use j3c.scene.rename.renameV2;

fn put(root: string, rel: string, text: string, a: &Arena) {
    let p = path.join(root, rel, a);
    match io.makeDirs(path.dirname(p)) { Result.Ok(_) {} Result.Err(_) { panic("mkdir"); } }
    match io.writeFile(p, text as []u8) { Result.Ok(_) {} Result.Err(_) { panic(p); } }
}

fn read(root: string, rel: string, a: &Arena): string {
    match fsx.readText(path.join(root, rel, a), a) { Result.Ok(t) { return t; } Result.Err(e) { panic(e); } }
    return "";
}

fn fresh(name: string, a: &Arena): string {
    let r = path.join("target/unit/editor_assets", name, a);
    fsx.removeTree(r, a);
    return r;
}

fn catalog(a: &Arena) {
    let root = fresh("catalog", a);
    put(root, "j3.editor.toml", "[editor]\nscene=\"scenes/demo.j3scene\"\n", a);
    put(root, "scripts/doors/door.j3s", "use j3.scene3d.NodeId;\nprops {\n    node: NodeId;\n    hinge: NodeId;\n    text: string = \"hi, there\";\n    speed: f32 = 2.5;\n    hp: int = -3;\n    open: bool = true;\n}\n", a);
    match assets.mainScene(root, a) { Result.Ok(p) { if p != path.join(root, "scenes/demo.j3scene", a) { panic(p); } } Result.Err(e) { panic(e); } }
    match assets.generateCatalog(root, a) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    let c = read(root, "target/j3-editor/catalog", a);
    let want: [9]string = ["catalog.0.name s=scripts/doors/door.j3s", "catalog.0.count=6", "catalog.0.0.required=0",
        "catalog.0.1.type s=object", "catalog.0.1.required=1", "catalog.0.2.default s=hi, there", "catalog.0.3.value f=2.5",
        "catalog.0.4.value=-3", "catalog.0.5.value=1"];
    for i in 0..9 { if !contains(c, want[i]) { panic(want[i]); } }
    match assets.scriptProps(root, "scripts/doors/door.j3s", a) {
        Result.Ok(ps) { if ps.len != 6 || ps.items[1].name != "hinge" || !ps.items[1].required || ps.items[1].default != "" { panic("hinge"); } }
        Result.Err(e) { panic(e); }
    }
    match assets.createScript(root, "lamp", a) { Result.Ok(r) { if r != "scripts/lamp.j3s" { panic(r); } } Result.Err(e) { panic(e); } }
    match assets.createScript(root, "lamp", a) { Result.Ok(_) { panic("lamp twice"); } Result.Err(_) {} }
    match assets.createScript(root, "2lamp", a) { Result.Ok(_) { panic("2lamp"); } Result.Err(_) {} }
    match assets.createScript(root, "fn", a) { Result.Ok(_) { panic("keyword"); } Result.Err(_) {} }
    if !contains(read(root, "target/j3-editor/catalog", a), "catalog.1.name s=scripts/lamp.j3s") { panic("lamp not in catalog"); }
    fsx.removeTree(root, a);
}

fn renameDelete(a: &Arena) {
    let root = fresh("rename", a);
    put(root, "j3.editor.toml", "[editor]\nscene = \"scenes/main.j3scene\"\n", a);
    put(root, "assets/a.j3mesh", "x", a);
    put(root, "scenes/main.j3scene", "node.0.asset s=assets/a.j3mesh\nnode.0.name s=assets/a.j3mesh.bak\nparam.1.skin s=assets/a.j3mesh\n", a);
    match assets.renameAsset(root, "assets/a.j3mesh", "assets/sub/b.j3mesh", a) { Result.Ok(n) { if n != 1 { panic("one scene changes"); } } Result.Err(e) { panic(e); } }
    if !fsx.isFile(path.join(root, "assets/sub/b.j3mesh", a)) { panic("not moved"); }
    if read(root, "scenes/main.j3scene", a) != "node.0.asset s=assets/sub/b.j3mesh\nnode.0.name s=assets/a.j3mesh.bak\nparam.1.skin s=assets/sub/b.j3mesh\n" { panic("scene text"); }
    match assets.renameAsset(root, "assets/sub/b.j3mesh", "assets/../../x.j3mesh", a) { Result.Ok(_) { panic("escape"); } Result.Err(_) {} }
    match assets.renameAsset(root, "assets/sub/b.j3mesh", "assets/b.png", a) { Result.Ok(_) { panic("ext"); } Result.Err(_) {} }
    match assets.renameAsset(root, "scenes/main.j3scene", "scenes/other.j3scene", a) { Result.Ok(_) { panic("main rename"); } Result.Err(_) {} }
    match assets.deleteAsset(root, "scenes/main.j3scene", a) { Result.Ok(_) { panic("main delete"); } Result.Err(_) {} }
    match assets.deleteAsset(root, "assets/sub/b.j3mesh", a) { Result.Ok(p) { if p != "target/j3-editor/trash/b.j3mesh" { panic(p); } } Result.Err(e) { panic(e); } }
    if io.exists(path.join(root, "assets/sub/b.j3mesh", a)) { panic("not deleted"); }
    fsx.removeTree(root, a);
}

fn renameLines(a: &Arena) {
    let t = "j3scene 2 next=4\n\nA mesh asset=assets/m.j3mesh material=wood #1\n  B mesh asset=\"assets/m.j3mesh\" fx=a|glow #2\nC instance scene=scenes/x.j3scene #3\n";
    match renameV2(t, "assets/materials/wood.j3mat", "assets/materials/oak.j3mat", a) {
        Option.Some(o) { if !contains(o, "material=oak #1") { panic(o); } }
        Option.None { panic("material short form"); }
    }
    match renameV2(t, "assets/m.j3mesh", "assets/my m.j3mesh", a) {
        Option.Some(o) { if !contains(o, "A mesh asset=\"assets/my m.j3mesh\"") || !contains(o, "  B mesh asset=\"assets/my m.j3mesh\" fx=a|glow #2") { panic(o); } }
        Option.None { panic("mesh path"); }
    }
    match renameV2(t, "assets/fx/glow.j3fx", "assets/fx/shine.j3fx", a) {
        Option.Some(o) { if !contains(o, "fx=a|shine #2") { panic(o); } }
        Option.None { panic("fx short form"); }
    }
    match renameV2(t, "assets/none.png", "assets/x.png", a) { Option.Some(_) { panic("no match"); } Option.None {} }
}

fn main() {
    let a = Arena.create(1 << 22);
    catalog(&a);
    renameDelete(&a);
    renameLines(&a);
    if assets.importName("dir/My Model.v2.glb", &a) != "My_Model_v2" { panic(assets.importName("dir/My Model.v2.glb", &a)); }
}
