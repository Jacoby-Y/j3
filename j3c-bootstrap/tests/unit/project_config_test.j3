// `config.J3C_VERSION` is hand-copied from `j3c/Cargo.toml`; it must match what stage 0 reports.
module project_config_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, trim };
use j3c.project.config;

fn main() {
    let a = Arena.create(1 << 16);
    match proc.run(["stage0/j3c", "version"], "", &a) {
        Result.Ok(p) {
            let want = Text.new(&a).add("j3c ").add(config.J3C_VERSION).str();
            if p.code != 0 || trim(p.outStr()) != want {
                printLn(p.outStr());
                panic("config.J3C_VERSION differs from `stage0/j3c version`");
            }
        }
        Result.Err(_) { panic("cannot run stage0/j3c"); }
    }
    printLn("project_config ok");
}
