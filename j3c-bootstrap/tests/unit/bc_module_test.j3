// `backend/bc.j3` module level on real scripts: the `examples/scripted` project checked (no build, no writes)
// gives stage 0's bytecode for both scripts. Values are from the `target/j3s/scripts/*.j3sb` files a stage 0
// `run --headless --frames 3` writes: names, `scriptPath`, `fnLabel` / `fnKey`, the layout and signature hashes,
// and the FNV-1a 64 of the whole encoded file (so `emitScript` with B's codegen and `encode` are byte-exact).
// Run from j3c-bootstrap/ (unit.sh): it reads ../examples/scripted.
module bc_module_test;

use j3.hash.fnv1a64;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.backend.bc.{ BcModule, emitScript, encode, fnKey, fnLabel, isScriptModule, scriptPath };
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.ir.{ IrCx, Module, Program };

fn hex(v: u64, a: &Arena): string {
    let t = Text.new(a);
    t.pushHex(v);
    return t.str();
}

/// The script module whose path is `want` (`scripts/NAME.j3s`).
fn script(prog: &Program, want: string, a: &Arena): &Module {
    for i in 0..prog.modules.len {
        let m = &prog.modules.items[i];
        if isScriptModule(&prog.cx, m.name.slice()) && scriptPath(&prog.cx, m.name.slice(), a) == want { return m; }
    }
    panic(`no script module {want}`);
    return &prog.modules.items[0];
}

fn emit(prog: &Program, m: &Module, a: &Arena): BcModule {
    match emitScript(&prog.cx, m, a) {
        Result.Ok(bc) { return bc; }
        Result.Err(e) { panic(e); }
    }
    panic("unreachable");
    return emit(prog, m, a);
}

fn check(prog: &Program, a: &Arena) {
    let cx = &prog.cx;
    let f = script(prog, "scripts/fighter.j3s", a);
    let seen = false;
    for i in 0..f.funcs.len {
        let id = f.funcs.items[i];
        if fnLabel(cx, id, a) == "script.scripts.fighter.strike:fn(&Fighter, int): int" {
            seen = true;
            if fnKey(cx, id, a) != 0x5363a1597c3c6b5b { panic(`strike key {hex(fnKey(cx, id, a), a)}`); }
        }
    }
    if !seen { panic("no strike label"); }
    let fb = emit(prog, f, a);
    if fb.name != "script.scripts.fighter" { panic(fb.name); }
    if fb.layoutHash != 0xa5846078fa0e0236 { panic(`fighter layout {hex(fb.layoutHash, a)}`); }
    if fb.signatureHash != 0x46d7a5e5ace32cd1 { panic(`fighter signatures {hex(fb.signatureHash, a)}`); }
    if fb.globals.len != 1 || fb.globals.items[0].key != 0xb63e7ba95b40d70b { panic("fighter globals"); }
    let fbytes = encode(&fb, a);
    if fbytes.len != 2960 || fnv1a64(fbytes.slice()) != 0x36abfabcf0766aa1 { panic(`fighter.j3sb differs ({fbytes.len} bytes)`); }
    let d = emit(prog, script(prog, "scripts/duel.j3s", a), a);
    if d.layoutHash != 0xfa26f09432a5e08a || d.signatureHash != 0x43bd150cf85ba329 { panic("duel hashes"); }
    if d.scripts.len != 1 || d.scripts.items[0] != "scripts/fighter.j3s" { panic("duel scripts"); }
    let dbytes = encode(&d, a);
    if dbytes.len != 2360 || fnv1a64(dbytes.slice()) != 0xddbb72c6eee5f97b { panic(`duel.j3sb differs ({dbytes.len} bytes)`); }
}

fn main() {
    let o = driver.defaults();
    o.entry = "../examples/scripted";
    o.headless = true;
    let s = Session.new(o);
    defer s.free();
    if !driver.run(s, Stage.Passes) { panic("examples/scripted does not check"); }
    match s.program {
        Option.Some(p) { check(p, s.arena); }
        Option.None { panic("no program"); }
    }
}
