// ui/gen `parseEachHead`: every `{#each}` head form and the error texts (Rust ui/gen/control.rs
// `parse_each_head`; texts as asserted by ui/tests/control.rs `each_key_errors`).
module ui_each_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3c.ui.gen.{ EachHead, parseEachHead };
use j3c.ui.markup.Range;

fn head(src: string, a: &Arena): EachHead {
    match parseEachHead(src, Range { lo: 0, hi: src.len }, a) {
        Result.Ok(h) { return h; }
        Result.Err(e) { printLn(e.msg); panic(src); }
    }
    panic(src);
    return head(src, a);
}

fn fails(src: string, msg: string, lo: int, hi: int, a: &Arena) {
    match parseEachHead(src, Range { lo: 0, hi: src.len }, a) {
        Result.Ok(_) { panic(src); }
        Result.Err(e) {
            if e.msg != msg { printLn(e.msg); panic(src); }
            if e.lo != lo || e.hi != hi { printLn(`{e.lo}..{e.hi}`); panic(src); }
        }
    }
}

fn check(ok: bool, what: string) { if !ok { panic(what); } }

fn main() {
    let arena = Arena.create(1 << 20);
    let a = &arena;

    let s = "items as item";
    let h = head(s, a);
    check(s[h.expr.lo..h.expr.hi] == "items" && h.item.name == "item" && h.item.r.lo == 9 && h.item.r.hi == 13 && !h.byRef && !h.keyInt, "plain");
    match h.index { Option.Some(_) { panic("plain index"); } Option.None {} }
    match h.key { Option.Some(_) { panic("plain key"); } Option.None {} }
    match h.range { Option.Some(_) { panic("plain range"); } Option.None {} }

    h = head("items as &item", a);
    check(h.byRef && h.item.name == "item" && h.item.r.lo == 10, "by ref");

    h = head("st.items as item, i", a);
    check(h.expr.hi == 8 && h.item.name == "item", "index item");
    match h.index { Option.Some(x) { check(x.name == "i" && x.r.lo == 18 && x.r.hi == 19, "index"); } Option.None { panic("index"); } }

    s = "items as item (item.id)";
    h = head(s, a);
    match h.key { Option.Some(k) { check(s[k.lo..k.hi] == "item.id" && !h.keyInt, "key"); } Option.None { panic("key"); } }

    s = "xs as g, n ( f(g.id) : int )";
    h = head(s, a);
    match h.key { Option.Some(k) { check(s[k.lo..k.hi] == "f(g.id)" && h.keyInt, "int key"); } Option.None { panic("int key"); } }

    // the last top-level `as` splits; one inside brackets does not
    s = "f(x as int) as v";
    h = head(s, a);
    check(s[h.expr.lo..h.expr.hi] == "f(x as int)" && h.item.name == "v", "nested as");

    s = " lo + 1 .. hi as i";
    h = head(s, a);
    match h.range { Option.Some(p) { check(s[p.a.lo..p.a.hi] == "lo + 1" && s[p.b.lo..p.b.hi] == "hi", "range"); } Option.None { panic("range"); } }
    check(s[h.expr.lo..h.expr.hi] == "lo + 1 .. hi", "range expr");
    h = head("0..3 as i (i * 2)", a);
    match h.range { Option.Some(p) { check(p.a.lo == 0 && p.a.hi == 1 && p.b.lo == 3 && p.b.hi == 4, "0..3"); } Option.None { panic("0..3"); } }
    // a `..` inside brackets is not the loop's range
    h = head("xs[0..2] as x", a);
    match h.range { Option.Some(_) { panic("slice range"); } Option.None {} }

    fails("items", "`{#each}` needs `as`", 0, 5, a);
    fails("items as", "expected `as item` or `as item, index` at the end of `{#each}`", 0, 8, a);
    fails("items as 3", "expected `as item` or `as item, index` at the end of `{#each}`", 0, 10, a);
    fails("xs as g ()", "the `(key)` is empty", 0, 10, a);
    fails("xs as g (g.id) (g.n)", "unbalanced `)` in the `(key)`", 0, 20, a);
    fails("xs as g (g.id", "expected `as item`, `as item, index` or `as item (key)` (`(key : int)` for an int key) at the end of `{#each}`", 0, 13, a);
    fails("xs as g, i j", "expected `as item`, `as item, index` or `as item (key)` (`(key : int)` for an int key) at the end of `{#each}`", 0, 12, a);
    fails(" as g", "`{#each}` has nothing before `as`", 0, 5, a);
    fails("0..=3 as i", "use `a..b` (b excluded); `..=` isn't supported in `{#each}`", 1, 4, a);
    match parseEachHead("items", Range { lo: 0, hi: 5 }, a) {
        Result.Ok(_) {}
        Result.Err(e) { check(e.help == "`{#each items as item}`, `{#each items as &item}`, `{#each items as item, i}`, `{#each items as item (item.id)}`, or `{#each 0..n as i}`", "help"); }
    }
    // ranges are absolute: the head sits at an offset in the file
    s = "{#each rows as r (r.id)}";
    match parseEachHead(s, Range { lo: 7, hi: 23 }, a) {
        Result.Ok(x) {
            check(s[x.expr.lo..x.expr.hi] == "rows" && x.item.r.lo == 15, "offset");
            match x.key { Option.Some(k) { check(s[k.lo..k.hi] == "r.id", "offset key"); } Option.None { panic("offset key"); } }
        }
        Result.Err(e) { panic(e.msg); }
    }
}
