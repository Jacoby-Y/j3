// Closures for `lower_closure_test`: captures by address (a local, a `use` alias, a method's `this`), a
// nested closure, a literal as a plain fn, a named fn as a closure (thunk), a closure in a generic struct's
// method, boxed closures (a `&Arena` and a value `Arena`), a boxed global called by name.
// Every closure type is written in a signature before a literal makes it, no boxed closure is passed where
// a stack one is wanted, and no literal is a generic fn's argument: those three need the frozen-file
// edits of wave 11 chunk 2's Ownership requests (add them here when the requests land).
module closures_case;

use j3.io.printLn;
use j3.memory.{ Arena };

struct P { x: int; y: int; }

struct Box<T> {
    v: T;
    n: int;

    fn each(this: &Box<T>, f: closure(T): T): T {
        let g = fn(x: T): T { this.n += 1; return f(x); };
        return g(g(this.v));
    }
}

struct Counter {
    n: int;

    fn bump(this: &Counter, by: int): int {
        let add = fn(k: int) { this.n += k * by; };
        add(1);
        add(2);
        return this.n;
    }
}

fn apply(f: closure(int): int, x: int): int { return f(x); }
fn each(f: closure(int)) { f(1); f(2); }
fn get(f: closure(): int): int { return f(); }
fn plain(f: fn(int): int, x: int): int { return f(x); }
fn triple(x: int): int { return x * 3; }
fn adder(mem: &Arena, k: int): boxed closure(int): int { return fn[mem](x: int): int { return x + k; }; }

#[singleton]
let HOOK: boxed closure(int): int;

fn main() {
    let total = 0;
    let base = 10;
    let c = fn(x: int): int { total += x; return base + x; };
    printLn(`{c(1)} {c(2)} total={total} {apply(fn(x) { return x * base; }, 4)} {apply(triple, 5)} {apply(triple, 6)}`);
    each(fn(i) { total += i * 100; });
    let outer = fn(a: int): int {
        let inner = fn(b: int): int { total += 1; return a + b + base; };
        return inner(a) + inner(1);
    };
    let p = P { x: 1, y: 2 };
    use p;
    printLn(`{outer(2)} {get(fn(): int { y += 10; return x + y; })} {p.y} {plain(fn(q: int): int { return q - 1; }, 1)}`);
    let ctr = Counter { n: 0 };
    let bx = Box<int> { v: 2, n: 0 };
    printLn(`{ctr.bump(5)} {bx.each(fn(v: int): int { return v + base; })} {bx.n}`);
    let mem = Arena.create(4096);
    let add5 = adder(&mem, 5);
    let snap = fn[mem](z: int): int { return base + z; };
    HOOK = add5;
    printLn(`{add5(1)} {snap(1)} {HOOK(2)}`);
}
