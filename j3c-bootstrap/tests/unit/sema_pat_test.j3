// Pattern typing (`sema/pat_*`): a small program through the driver to `Stage.Sema`, then its typed tree
// read back: arms in source order, an or-pattern's names one local (sorted by name), int arms folded
// (`3..=3` is a `Lit`, a range keeps both ends), `let .. else`, `?` and its re-wrap index; and the
// exhaustiveness error's text.
module sema_pat_test;

use j3.data.pool.Id;
use j3.io;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.driver;
use j3c.driver.{ Session, Stage };
use j3c.sema.{ Checked, FnDecl, TArm, TBody, TExpr, TLetPat, TMatch, TPat, TStmt };

const SRC: [24]string = [
    "module pats;",
    "#[TryCatch(Ok, Err)]",
    "enum R { Ok(int), Err(string) }",
    "#[TryCatch(Ok, Err)]",
    "enum R2 { Ok(bool), Err(string) }",
    "enum Sh { Dot(int), Pair(int, int), None }",
    "fn size(s: Sh): int {",
    "    match s {",
    "        Sh.Pair(b, a) | Sh.Pair(a, b) { return a + b; }",
    "        Sh.Dot(n) if n > 0 { return n; }",
    "        _ { return 0; }",
    "    }",
    "}",
    "fn kind(c: u8): int {",
    "    let v = match c { 3..=3 { 1 } 'a'..='z' { 2 } _ { 3 } };",
    "    return v;",
    "}",
    "fn first(s: Sh): int {",
    "    let Sh.Dot(n) = s else { return 0; };",
    "    return n;",
    "}",
    "fn same(r: R): R { let x = r?; return R.Ok(x); }",
    "fn other(r: R): R2 { let x = r?; return R2.Ok(x > 0); }",
    "fn main() { }",
];

const BAD: [10]string = [
    "module bad;",
    "enum Dir { Up, Down, Left, Right }",
    "fn f(d: Dir): int {",
    "    match d {",
    "        Dir.Up { return 1; }",
    "        Dir.Down { return 2; }",
    "    }",
    "    return 0;",
    "}",
    "fn main() { }",
];

/// Write `text` as `NAME.j3` in a temp dir (outside this package, whose project would otherwise load).
fn put(name: string, lines: []string, mem: &Arena): string {
    let text = Text.new(mem);
    for i in 0..lines.len { text.add(lines[i]).add("\n"); }
    let d = Text.new(mem).add(io.tempRoot()).add("/j3c-boot-sema-pat").str();
    match io.makeDirs(d) { Result.Ok(_) {} Result.Err(_) { panic("cannot make the case dir"); } }
    let p = Text.new(mem).add(d).add("/").add(name).add(".j3").str();
    match io.writeFile(p, text.str() as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write a case"); } }
    return p;
}

fn body(c: &Checked, name: string): TBody {
    let fns = &c.tables.fns;
    for i in 0..fns.len() {
        let d = fns.get(fns.idAt(i));
        if c.tables.str(d.name) != name { continue; }
        match d.body {
            Option.Some(b) { return c.typed.body(b); }
            Option.None {}
        }
    }
    panic(`no typed body for {name}`);
    return c.typed.body(Id<TBody> { i: 0 });
}

/// The `match` of statement `k` of `b` (a statement match, or `let v = match ..`).
fn matchOf(c: &Checked, b: &TBody, k: int): TMatch {
    match c.typed.stmt(b.body.stmts.items[k]) {
        TStmt.Match(m) { return m.m; }
        TStmt.Let(l) {
            match l.init {
                Option.Some(e) { match c.typed.expr(e) { TExpr.Match(m) { return m; } _ {} } }
                Option.None {}
            }
        }
        _ {}
    }
    panic("not a match");
    return matchOf(c, b, k);
}

fn localName(c: &Checked, p: Id<TPat>): string {
    match c.typed.pat(p) {
        TPat.Bind(b) { return c.tables.str(c.typed.local(b.local).name); }
        _ {}
    }
    return "";
}

fn main() {
    let mem = Arena.create(1 << 12);
    let o = driver.defaults();
    o.entry = put("pats", SRC, &mem);
    let s = Session.new(o);
    if !driver.run(s, Stage.Sema) { panic("sema fails on the pattern program"); }
    let c = match s.checked { Option.Some(x) { x } Option.None { panic("no checked program"); return; } };

    // or-pattern: one arm, `TPat.Or`, both alternatives bind the same locals; locals sorted by name
    let sz = body(c, "size");
    let m = matchOf(c, &sz, 0);
    if m.arms.len != 3 { panic("size: 3 arms"); }
    let a0 = m.arms.items[0];
    match c.typed.pat(a0.pat) {
        TPat.Or(alts) {
            if alts.items.len != 2 { panic("size: two alternatives"); }
            match c.typed.pat(alts.items.items[0]) {
                TPat.Variant(v) {
                    if v.variant != 1 { panic("size: Sh.Pair is variant 1"); }
                    if localName(c, v.fields.items[0]) != "b" { panic("size: first field binds b"); }
                }
                _ { panic("size: a variant pattern"); }
            }
        }
        _ { panic("size: arm 0 is an or-pattern"); }
    }
    // params first (`s`), then the arm's names sorted: a, b; then the guarded arm's n
    if c.tables.str(c.typed.local(sz.locals.items[1]).name) != "a" { panic("size: first binding local is a"); }
    if c.tables.str(c.typed.local(sz.locals.items[2]).name) != "b" { panic("size: second binding local is b"); }
    match m.arms.items[1].guard { Option.Some(_) {} Option.None { panic("size: arm 1 is guarded"); } }
    match c.typed.pat(m.arms.items[2].pat) { TPat.Wild {} _ { panic("size: last arm is _"); } }

    // int arms: `3..=3` is a Lit (Rust's Switch case), `'a'..='z'` a Range; values in arms
    let kd = body(c, "kind");
    let km = matchOf(c, &kd, 0);
    match c.typed.pat(km.arms.items[0].pat) { TPat.Lit(_) {} _ { panic("kind: 3..=3 is a Lit"); } }
    match c.typed.pat(km.arms.items[1].pat) {
        TPat.Range(r) {
            match c.typed.expr(r.lo) { TExpr.Int(v) { if v != 97 { panic("kind: range starts at 'a'"); } } _ { panic("kind: int end"); } }
        }
        _ { panic("kind: 'a'..='z' is a Range"); }
    }
    match km.arms.items[0].value { Option.Some(_) {} Option.None { panic("kind: arm value"); } }

    // `let .. else`
    let fs = body(c, "first");
    match c.typed.stmt(fs.body.stmts.items[0]) {
        TStmt.LetPat(l) { match l.elseBlock { Option.Some(_) {} Option.None { panic("first: has an else"); } } }
        _ { panic("first: a LetPat"); }
    }

    // `?`: same enum returns the operand (-1); another enum re-wraps into its failure variant (1)
    for k in 0..2 {
        let name = "same";
        let want = -1;
        if k == 1 { name = "other"; want = 1; }
        let qb = body(c, name);
        match c.typed.stmt(qb.body.stmts.items[0]) {
            TStmt.Let(l) {
                match l.init {
                    Option.Some(e) {
                        match c.typed.expr(e) {
                            TExpr.Question(q) { if q.retErr != want || q.ok != 0 || q.err != 1 { panic(`{name}: question indexes`); } }
                            _ { panic(`{name}: a Question`); }
                        }
                    }
                    Option.None { panic(`{name}: init`); }
                }
            }
            _ { panic(`{name}: a let`); }
        }
    }

    // exhaustiveness error text
    let o2 = driver.defaults();
    o2.entry = put("bad", BAD, &mem);
    let s2 = Session.new(o2);
    if driver.run(s2, Stage.Sema) { panic("bad: sema should fail"); }
    let found = false;
    for i in 0..s2.diags.count() {
        if s2.diags.at(i).msg == "match is not exhaustive: missing `Dir.Left`, `Dir.Right`" { found = true; }
    }
    if !found { panic("bad: no exhaustiveness error"); }
}
