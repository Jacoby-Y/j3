// ir.runPasses: list order, `cond` skips, `--dump-after` at the named slot (even when skipped), unknown
// `--dump-after` is an error, and an error stops the remaining passes. Fake passes log one module per run
// into `Program.modules` (its name is the pass digit); `trail` reads the digits back.
module passes_runner_test;

use j3.sys.panic;
use j3c.base.diag.Severity;
use j3c.base.span.noSpan;
use j3c.driver;
use j3c.driver.Session;
use j3.memory.List;
use j3c.base.intern.Sym;
use j3c.ir.{ Module, Pass, PassCx, Program, runPasses };

fn yes(cx: &PassCx): bool { return true; }
fn ifFast(cx: &PassCx): bool { return cx.fast; }
fn log(cx: &PassCx, p: &Program, digit: string) {
    let name = List<Sym>.new(cx.arena);
    name.push(p.cx.internName(digit));
    p.modules.push(Module.new(cx.arena, name));
}

/// The digits logged so far, as one number.
fn trail(p: &Program): int {
    let n = 0;
    for i in 0..p.modules.len { n = n * 10 + int(p.cx.nameStr(p.modules.items[i].name.items[0])[0] - '0'); }
    return n;
}

fn one(cx: &PassCx, p: &Program) { log(cx, p, "1"); }
fn two(cx: &PassCx, p: &Program) { log(cx, p, "2"); }
fn three(cx: &PassCx, p: &Program) { log(cx, p, "3"); }
fn fail(cx: &PassCx, p: &Program) { cx.diags.add(cx.diags.make(0, Severity.Error, noSpan(), "pass failed")); }
fn dump(cx: &PassCx, p: &Program) { log(cx, p, "9"); }

fn cx(s: &Session, fast: bool, dumpAfter: string): PassCx {
    return PassCx { dev: false, fast: fast, validate: true, scripts: false, dumpAfter: dumpAfter, timePasses: true,
        arena: s.arena, diags: &s.diags, phases: &s.phases, dump: dump };
}

fn main() {
    let s = Session.new(driver.defaults());
    let ps = s.arena.alloc::<Pass>(3);
    ps[0] = Pass { name: "one", cond: yes, run: one };
    ps[1] = Pass { name: "two", cond: ifFast, run: two };
    ps[2] = Pass { name: "three", cond: yes, run: three };

    let p = Program.new(s.arena, &s.names, &s.sources);
    let c = cx(s, true, "");
    if !runPasses(ps, &c, &p) || trail(&p) != 123 { panic("order with all passes on"); }

    p.modules.clear();
    c = cx(s, false, "two");
    if !runPasses(ps, &c, &p) || trail(&p) != 193 { panic("cond skip or dump-after slot"); }

    p.modules.clear();
    c = cx(s, true, "nope");
    if runPasses(ps, &c, &p) || trail(&p) != 0 || s.diags.count() != 1 { panic("unknown --dump-after is not an error"); }

    let s2 = Session.new(driver.defaults());
    s2.diags.add(s2.diags.make(0, Severity.Warning, noSpan(), "old warning"));
    ps[1] = Pass { name: "two", cond: yes, run: fail };
    p.modules.clear();
    c = cx(s2, true, "");
    if runPasses(ps, &c, &p) || trail(&p) != 1 { panic("an error does not stop the passes"); }
    s2.free();
    s.free();
}
