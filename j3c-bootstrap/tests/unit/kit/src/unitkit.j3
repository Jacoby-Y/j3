// Expected-output files for `tests/unit/*_test.j3` (plan 15): a test compares a text it made with
// `tests/unit/expect/NAME`; `J3_UNIT_BLESS=1` writes the file instead (review the change in git, like
// `diff.sh --bless`). Every unit test package depends on this one (`tests/unit.sh` writes the line).
// J3: cwd is j3c-bootstrap/ (unit.sh) or the repo root (tests that run corpus files from there); both work.
module unitkit;

use j3.hash;
use j3.io;
use j3.io.path;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.{ Text, lines, replace };

/// Path of expected file `name` from the cwd (arena copy).
fn file(name: string, a: &Arena): string {
    let dir = if io.exists("tests/unit") { "tests/unit/expect/" } else { "j3c-bootstrap/tests/unit/expect/" };
    return Text.new(a).add(dir).add(name).str();
}

/// Stands for "no more lines" in the difference report (when only a final line break or a `\r` differs, both sides show the same line).
const END = "<end of text>";

fn line(o: Option<string>): string {
    match o { Option.Some(l) { return l; } Option.None { return END; } }
    return END;
}

/// `got` equals expected file `name` (or, with J3_UNIT_BLESS=1, is written to it). On a difference prints
/// the file, the first differing line of each side and how to accept it, and returns false.
pub fn same(got: string, name: string): bool {
    let a = Arena.create(1 << 16);
    defer a.destroy();
    let f = file(name, &a);
    if sys.env("J3_UNIT_BLESS") == "1" {
        match io.makeDirs(path.dirname(f)) { Result.Ok(_) {} Result.Err(_) { panic(Text.new(&a).add("cannot make the folder of ").add(f).str()); } }
        match io.writeFile(f, got as []u8) { Result.Ok(_) {} Result.Err(_) { panic(Text.new(&a).add("cannot write ").add(f).str()); } }
        printLn(Text.new(&a).add("blessed ").add(f).str());
        return true;
    }
    let want = match io.readFile(f, &a) {
        Result.Ok(b) { b as string }
        Result.Err(_) {
            printLn(Text.new(&a).add("no expected file ").add(f).add(" (J3_UNIT_BLESS=1 writes it)").str());
            return false;
        }
    };
    if want == got { return true; }
    let w = lines(want);
    let g = lines(got);
    let n = 1;
    let wl = line(w.next());
    let gl = line(g.next());
    while wl == gl && wl != END { wl = line(w.next()); gl = line(g.next()); n += 1; }
    let t = Text.new(&a).add("DIFF ").add(f).add(" at line ");
    t.pushInt(n);
    t.add("\n--- want\n");
    t.add(wl).add("\n--- got\n").add(gl);
    printLn(t.add("\n(J3_UNIT_BLESS=1 accepts the new text)").str());
    return false;
}

/// `same`, or panic with `what`.
pub fn expect(got: string, name: string, what: string) {
    if !same(got, name) { panic(what); }
}

/// `sha256 HEX, N bytes` and a line break: what a test stores for a text too big to keep (an arena copy).
pub fn digest(s: string, a: &Arena): string {
    let t = Text.new(a).add("sha256 ");
    hash.sha256(s as []u8).hex(t);
    t.add(", ").pushInt(s.len);
    return t.add(" bytes\n").str();
}

/// `s` with every `from` replaced by `to` (a path that differs per machine, e.g. a temp folder, as `$TMP`).
pub fn mask(s: string, from: string, to: string, a: &Arena): string {
    let t = Text.new(a);
    return replace(&t, s, from, to);
}
