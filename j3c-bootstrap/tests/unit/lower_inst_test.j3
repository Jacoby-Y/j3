// `lower` on generic instances: generic fns (nested, UFCS-free and trait default bodies, named
// `name<stable_ty,..>`), generic methods (written and inferred type args), methods of generic struct
// instances (made with the struct, lowered on first use, unused ones dropped), generic enums, `for` over
// an iterator (plain and generic `next`), stdlib `List<T>` / `Arena.alloc::<T>`; through `Stage.Passes` (so
// the IR validates), the user module dumped and compared byte for byte with
// `tests/unit/expect/lower_inst.ir` (frozen from the Rust compiler's `dump-ir`, plan 15):
// the fn
// list order is Rust's allocation order, the temporaries Rust's lowering order.
module lower_inst_test;

use j3.io;
use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use unitkit;

// Run from the repo root (as `diff.sh` does): with cwd = j3c-bootstrap/ the loader reads that `j3.toml`.
const DIR = "target/lower_inst";
const PATH = "target/lower_inst/p.j3";

/// The text up to the second `module ` line (the program's own module; the stdlib follows).
fn userModule(s: string): string {
    let n = 0;
    for i in 0..s.len {
        if (i == 0 || s[i - 1] == 10) && i + 7 <= s.len && s[i..i + 7] == "module " {
            n += 1;
            if n == 2 { return s[0..i]; }
        }
    }
    return s;
}

fn main() {
    let up: [3]u8;
    up[0] = 46;
    up[1] = 46;
    if sys.chdir(&up[0] as ptr) != 0 { panic("cannot cd to the repo root"); }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = PATH;
    let s = Session.new(opts);
    defer s.free();
    let src = Text.new(s.arena);
    src.add("module lowerinst;\n");
    src.add("use j3.io.printLn;\n");
    src.add("use j3.memory.{ Arena, List };\n");
    src.add("use j3.option.Option;\n");
    src.add("\n");
    src.add("struct Counter {\n");
    src.add("    n: int;\n");
    src.add("    max: int;\n");
    src.add("    fn next(this: &Counter): Option<int> {\n");
    src.add("        if this.n >= this.max { return Option.None; }\n");
    src.add("        this.n += 1;\n");
    src.add("        return Option.Some(this.n);\n");
    src.add("    }\n");
    src.add("}\n");
    src.add("\n");
    src.add("struct Iter<T> {\n");
    src.add("    xs: []T;\n");
    src.add("    i: int;\n");
    src.add("    fn next(this: &Iter<T>): Option<T> {\n");
    src.add("        if this.i >= this.xs.len { return Option.None; }\n");
    src.add("        this.i += 1;\n");
    src.add("        return Option.Some(this.xs[this.i - 1]);\n");
    src.add("    }\n");
    src.add("    fn rest(this: &Iter<T>): int { return this.xs.len - this.i; }\n");
    src.add("    fn rest2(k: int): int { return k; }\n");
    src.add("    fn zip<U>(this: &Iter<T>, u: U, k: int): U { return u; }\n");
    src.add("}\n");
    src.add("\n");
    src.add("struct Pair<A, B> {\n");
    src.add("    a: A;\n");
    src.add("    b: B;\n");
    src.add("    fn first(this: &Pair<A, B>): A { return this.a; }\n");
    src.add("    fn swap(this: &Pair<A, B>): Pair<B, A> { return Pair<B, A> { a: this.b, b: this.a }; }\n");
    src.add("}\n");
    src.add("\n");
    src.add("trait Shape {\n");
    src.add("    fn area(this: &Self): int;\n");
    src.add("    fn double(this: &Self): int { return this.area() * 2; }\n");
    src.add("}\n");
    src.add("struct Sq { s: int; fn area(this: &Sq): int { return this.s * this.s; } }\n");
    src.add("\n");
    src.add("struct Plain {\n");
    src.add("    n: int;\n");
    src.add("    fn pick<T>(this: &Plain, a: T): T { return a; }\n");
    src.add("}\n");
    src.add("fn id<T>(x: T): T { return x; }\n");
    src.add("fn pair<A, B>(a: A, b: B): A { let z = id(b); return a; }\n");
    src.add("fn wrap<T>(x: T): Pair<T, T> { return Pair<T, T> { a: x, b: x }; }\n");
    src.add("fn count<T>(it: &Iter<T>): int { let n = 0; for v in it { n += 1; } return n; }\n");
    src.add("fn firstOf<T>(xs: []T): T { return xs[0]; }\n");
    src.add("fn mk(n: int): Counter { return Counter { n: 0, max: n }; }\n");
    src.add("fn apply(f: fn(int): int, v: int): int { return f(v); }\n");
    src.add("\n");
    src.add("fn main() {\n");
    src.add("    let c = Counter { n: 0, max: 3 };\n");
    src.add("    let sum = 0;\n");
    src.add("    for v in c { sum += v; }\n");
    src.add("    for w in mk(2) { sum += w; }\n");
    src.add("    let arr = [1, 2, 3];\n");
    src.add("    let it = Iter<int> { xs: arr[0..3], i: 0 };\n");
    src.add("    for x in it { sum += x; }\n");
    src.add("    let it2 = Iter<int> { xs: arr[0..3], i: 0 };\n");
    src.add("    let n = count(&it2) + it2.rest();\n");
    src.add("    let a = id(id(wrap(sum + 1)).first());\n");
    src.add("    let p = wrap(\"s\").swap();\n");
    src.add("    let z = it2.zip(id(2.5), id(sum * 2));\n");
    src.add("    let f = firstOf(arr[1..3]);\n");
    src.add("    let g = Iter<int>.rest2(n + 1);\n");
    src.add("    let sq = Sq { s: 3 };\n");
    src.add("    let d = sq.double() + id(sq.area());\n");
    src.add("    let pl = Plain { n: 1 };\n");
    src.add("    let q = pl.pick::<int>(7) + pl.pick(d);\n");
    src.add("    let s2 = pair(\"a\", 2.5);\n");
    src.add("    let arena = Arena.create(1024);\n");
    src.add("    let xs = List<int>.new(&arena);\n");
    src.add("    xs.push(q + xs.len);\n");
    src.add("    let buf = arena.alloc::<u8>(4);\n");
    src.add("    for e in xs.items { printLn(s2); }\n");
    src.add("    arena.destroy();\n");
    src.add("    let o: Option<Pair<int, int>> = Option.Some(wrap(d));\n");
    src.add("    match o {\n");
    src.add("        Option.Some(pp) { printLn(p.a); }\n");
    src.add("        Option.None {}\n");
    src.add("    }\n");
    src.add("}\n");
    match proc.run(["mkdir", "-p", DIR], "", s.arena) { Result.Ok(_) {} Result.Err(_) { panic("cannot run mkdir"); } }
    match io.writeFile(PATH, src.str() as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the program"); } }
    if !driver.run(s, Stage.Passes) {
        printLn(failText(s));
        panic("lower or validate failed");
    }
    let ours = Text.new(s.arena);
    if !driver.dumpIr(s, &ours) { panic("dump-ir failed"); }
    unitkit.expect(userModule(ours.str()), "lower_inst.ir", "lowered IR differs from tests/unit/expect/lower_inst.ir");
    printLn("lower inst ok");
}
