// base/phase: off records nothing; steps and notes nest under their phase; `report` matches Rust's
// format byte for byte (name padded to column 44, time `{:>7.2}s`).
module base_phase_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ Text, endsWith, lines, startsWith };

use j3c.base.phase.Phases;

fn main() {
    let arena = Arena.create(1 << 16);
    let off = Phases.new(&arena);
    off.begin("check");
    off.step("x", 1.0);
    let t0 = Text.new(&arena);
    off.report(&t0);
    if t0.len() != 0 || off.elapsedMs() != 0 { panic("an off Phases recorded"); }

    let p = Phases.new(&arena);
    p.step("before any phase", 1.0);
    p.enable();
    p.begin("check");
    p.step("  collect", 0.5);
    p.step("slow: j3.game (emit 1.25s, clang 0.10s)", 12.345);
    p.note("3 of 9 modules cached");
    p.step("tie", 0.125);
    p.begin("check");
    p.begin("running");
    p.step("big", 1234.5);
    let t = Text.new(&arena);
    p.report(&t);
    let ls = lines(t.str());
    let want: [7]string = [
        "      check",
        "        collect                                0.50s",
        "        slow: j3.game (emit 1.25s, clang 0.10s)  12.35s",
        "        3 of 9 modules cached",
        "        tie                                    0.12s",
        "      running",
        "        big                                 1234.50s",
    ];
    let i = 0;
    for l in &ls {
        if i >= 7 { panic(`extra line: {l}`); }
        // Outer phases took ~0 s here: check the name, the column and the unit, not the digits.
        if i == 0 || i == 5 {
            if !startsWith(l, want[i]) || !endsWith(l, "s") || l.len != 44 + 8 { panic(`outer line: [{l}]`); }
        } else if l != want[i] {
            panic(`line {i}: [{l}] want [{want[i]}]`);
        }
        i += 1;
    }
    if i != 7 { panic("missing lines"); }

    // Rust `target`: a depth 0 line with no time between the targets' phases; off records nothing
    off.target("x86_64-pc-linux-gnu");
    let t1 = Text.new(&arena);
    off.report(&t1);
    if t1.len() != 0 { panic("an off Phases recorded a target"); }
    let q = Phases.new(&arena);
    q.enable();
    q.setTag("x86_64-pc-linux-gnu");
    q.target("x86_64-pc-linux-gnu");
    q.note("not under a phase");
    q.begin("link");
    q.target("aarch64-linux-gnu");
    let t2 = Text.new(&arena);
    q.report(&t2);
    let l2 = lines(t2.str());
    let n = 0;
    for l in &l2 {
        if n == 0 && l != "      target x86_64-pc-linux-gnu" { panic(`target line: [{l}]`); }
        if n == 1 && (!startsWith(l, "      link") || l.len != 44 + 8) { panic(`link line: [{l}]`); }
        if n == 2 && l != "      target aarch64-linux-gnu" { panic(`second target: [{l}]`); }
        n += 1;
    }
    if n != 3 { panic(t2.str()); }
    printLn("base_phase ok");
}
