// `ir_samples` printed by `backend.llvm.emitLlvm` (default options: debug on, opt 0, host target) equals
// `stage0/j3c dump-llvm samples` (the Rust printer) byte for byte. Also checks the fn-name hash
// (Rust `DefaultHasher`, SipHash-1-3) on a known input.
// J3: Says `module ir_samples;` to get the fixture parts (`llvm_samples_test/` is a symlink to
// `ir_samples/`); the fixture's `use`s are in `ir_samples/samples.j3`.
module ir_samples;

use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.backend.llvm.{ LlOpts, emitLlvm, sip13 };
use j3c.driver;
use j3c.driver.Session;

fn main() {
    // Rust: `let mut h = DefaultHasher::new(); "ab".hash(&mut h); h.finish()` (bytes `a b 0xff`)
    let ab = [97 as u8, 98, 255];
    if sip13(ab[0..3]) != 0x66930d61a0cb581b { panic("sip13 differs from Rust DefaultHasher"); }
    let s = Session.new(driver.defaults());
    let p = Program.new(s.arena, &s.names, &s.sources);
    placeSamples(&p);
    let t = Text.new(s.arena);
    let o = LlOpts { target: "", opt: 0, debug: true, release: false };
    match emitLlvm(&p.cx, p.modules.slice(), &o, &t) {
        Result.Ok(_) {}
        Result.Err(e) { panic(e); }
    }
    let got = t.str();
    match proc.run(["stage0/j3c", "dump-llvm", "samples"], "", s.arena) {
        Result.Ok(r) {
            if r.code != 0 { panic(r.errStr()); }
            if r.outStr() != got {
                printLn("--- stage0");
                printLn(r.outStr());
                printLn("--- j3c-boot");
                printLn(got);
                panic("llvm text differs from stage0 dump-llvm samples");
            }
        }
        Result.Err(_) { panic("cannot run stage0/j3c"); }
    }
    s.free();
}
