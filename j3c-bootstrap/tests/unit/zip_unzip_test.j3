// base/zip (Rust online/pack.rs `unzip`, online.rs `safe_rel`): stored and deflated entries from the `zip` CLI
// unpack byte for byte with folders made; a name leaving the folder, absolute, with `\` or `:` is refused;
// not a zip is refused.
module zip_unzip_test;

use j3.io;
use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.fsx;
use j3c.base.zip;

fn sh(cmd: string, mem: &Arena) {
    let argv: [3]string = ["sh", "-c", cmd];
    match proc.run(argv[..], "", mem) {
        Result.Ok(o) { if o.code != 0 { panic(o.errStr()); } }
        Result.Err(_) { panic("sh"); }
    }
}

fn read(p: string, mem: &Arena): []u8 {
    match io.readFile(p, mem) { Result.Ok(b) { return b; } Result.Err(_) { panic(p); } }
}

fn main() {
    let mem = Arena.create(1 << 16);
    defer mem.destroy();
    let base = Text.new(&mem).add("../target/unit-zip-").fmt(`{sys.getpid()}`).str();
    // a 40 KB compressible file (deflated), a stored one, a nested one, an empty one
    sh(Text.new(&mem).add("rm -rf ").add(base).add(" && mkdir -p ").add(base).add("/src/d/e && cd ").add(base)
        .add("/src && seq 1 8000 >big.txt && printf 'abc' >d/e/small.txt && : >empty && printf 'xy' >xx_evil")
        .add(" && zip -qr ../a.zip big.txt d empty && zip -q0 ../a.zip d/e/small.txt && zip -q ../bad.zip xx_evil").str(), &mem);
    let z = read(Text.new(&mem).add(base).add("/a.zip").str(), &mem);
    let out = Text.new(&mem).add(base).add("/out").str();
    match zip.unzip(z, out, &mem) {
        Result.Ok(n) { if n != 3 { panic("file count"); } }
        Result.Err(e) { panic(e); }
    }
    let names: [3]string = ["big.txt", "d/e/small.txt", "empty"];
    for i in 0..3 {
        let a = read(path.join(Text.new(&mem).add(base).add("/src").str(), names[i], &mem), &mem);
        let b = read(path.join(out, names[i], &mem), &mem);
        if (a as string) != (b as string) { panic(names[i]); }
    }

    // an entry named `../evil` (the bytes of `xx_evil` patched in both headers)
    let bad = read(Text.new(&mem).add(base).add("/bad.zip").str(), &mem);
    let patched = 0;
    for i in 0..bad.len - 7 {
        if (bad[i..i + 7] as string) == "xx_evil" {
            bad[i] = '.';
            bad[i + 1] = '.';
            bad[i + 2] = '/';
            patched += 1;
        }
    }
    if patched != 2 { panic("patch"); }
    match zip.unzip(bad, out, &mem) {
        Result.Ok(_) { panic("escape unpacked"); }
        Result.Err(e) { if e != "unsafe path `../evil` in download" { panic(e); } }
    }
    if fsx.isFile(Text.new(&mem).add(base).add("/evil").str()) { panic("escape written"); }
    match zip.unzip("not a zip at all, just some text bytes" as []u8, out, &mem) {
        Result.Ok(_) { panic("text unpacked"); }
        Result.Err(e) { if e != "not a zip file (zip64 isn't supported)" { panic(e); } }
    }
    let rels: [5]string = ["/abs", "a\\b", "c:d", "", "a/../b"];
    for i in 0..5 {
        match zip.safeRel(rels[i], &mem) { Result.Ok(_) { panic(rels[i]); } Result.Err(_) {} }
    }
    match zip.safeRel("a/b..c/.d", &mem) { Result.Ok(_) {} Result.Err(e) { panic(e); } }
    sh(Text.new(&mem).add("rm -rf ").add(base).str(), &mem);
}
