// test-compiler: the case header parser, the stderr diagnostic reader, and the verdicts (no compiler runs).
module testcompiler_header_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.sys.panic;
use j3c.cmd.testcompiler.{ Want, isCount, judge, matches, parseCase, parseDiags, parseWant };

const SRC = "// prose: ignored\n//\n// expect-out: a b\n// expect-out:\n// expect-exit: 3\n// expect-warn: at 2:1 unused\n// backends: llvm\n// args: x  y\nmodule m;\n// expect-out: not header\n";

const ERR = "j3c: [1/6] parse\nerror: let type does not match: expected `int`\n  --> /a:b/e.j3:3:18\n   |\nerror[E0042]: second\n  --> e.j3:7:2\n  --> e.j3:9:9\nwarning: unused import\n  --> e.j3:2:1\nerror: 2 errors\n";

fn want(s: string): Want {
    match parseWant(s) { Option.Some(w) { return w; } Option.None { panic(s); } }
    return Want { code: "", line: 0, col: 0, msg: "" };
}

fn main() {
    let mem = Arena.create(4096);
    let c = parseCase("m.j3", "/m.j3", SRC, &mem);
    if c.bad != "" { panic(c.bad); }
    if c.out.len != 2 || c.out.items[0] != "a b" || c.out.items[1] != "" { panic("expect-out"); }
    if !c.hasOut || c.exit != 3 { panic("expect-exit"); }
    if c.warns.len != 1 || c.warns.items[0].line != 2 || c.warns.items[0].msg != "unused" { panic("expect-warn"); }
    if c.args.len != 2 || c.args.items[1] != "y" { panic("args"); }

    if parseCase("c", "c", "// backends: llvm c\n", &mem).bad == "" { panic("backend c accepted"); }
    if parseCase("c", "c", "// backends: wasm\n", &mem).bad == "" { panic("unknown backend accepted"); }
    if parseCase("c", "c", "// expect-ouf: 1\n", &mem).bad == "" { panic("typo key accepted"); }
    if parseCase("c", "c", "// expect-err: 3:4\n", &mem).bad == "" { panic("err without at accepted"); }

    match parseWant("E0042 at 4:5") {
        Option.Some(w) { if w.code != "E0042" || w.line != 4 || w.col != 5 || w.msg != "" { panic("want code"); } }
        Option.None { panic("want code: none"); }
    }
    match parseWant("at 3:18 let type does not match") {
        Option.Some(w) { if w.code != "" || w.line != 3 || w.col != 18 || w.msg != "let type does not match" { panic("want msg"); } }
        Option.None { panic("want msg: none"); }
    }
    match parseWant("at x:1") { Option.Some(x) { panic("bad pos accepted"); } Option.None {} }

    let ds = parseDiags(ERR, &mem);
    if ds.len != 3 { panic("diag count"); }
    let a = &ds.items[0];
    if a.warn || a.code != "" || a.line != 3 || a.col != 18 || a.msg != "let type does not match: expected `int`" { panic("diag 1"); }
    let b = &ds.items[1];
    if b.code != "E0042" || b.line != 7 || b.col != 2 || b.msg != "second" { panic("diag 2 (first --> wins)"); }
    if !ds.items[2].warn || ds.items[2].line != 2 { panic("diag 3"); }

    // A code is checked when printed; with none printed, the message has to carry it.
    let w = want("E0042 at 7:2");
    if !matches(&w, b) { panic("code match"); }
    if matches(&w, a) { panic("position mismatch matched"); }
    let w0 = want("E0001 at 7:2");
    if matches(&w0, b) { panic("wrong code matched"); }
    let w1 = want("E0042 at 3:18");
    if matches(&w1, a) { panic("code-only want matched a codeless error"); }
    let w2 = want("E0042 at 3:18 let type");
    if !matches(&w2, a) { panic("code + msg want vs codeless error"); }

    // Verdicts.
    let ok = parseCase("o", "o", "// expect-out: 5\n", &mem);
    if judge(&ok, 0, "5\n", "", &mem) != "" { panic("ok case failed"); }
    if judge(&ok, 0, "6\n", "", &mem) == "" { panic("wrong stdout passed"); }
    if judge(&ok, 0, "5\n6\n", "", &mem) == "" { panic("extra stdout passed"); }
    if judge(&ok, 1, "5\n", "", &mem) == "" { panic("wrong exit passed"); }
    if judge(&ok, 124, "", "", &mem) == "" { panic("timeout passed"); }
    if judge(&ok, 1, "", ERR, &mem) == "" { panic("compile error passed"); }
    let e = parseCase("e", "e", "// expect-err: at 3:18 let type\n// expect-err: E0042 at 7:2\n", &mem);
    if judge(&e, 1, "", ERR, &mem) != "" { panic(judge(&e, 1, "", ERR, &mem)); }
    if judge(&e, 0, "", "", &mem) == "" { panic("clean compile passed an err case"); }
    let e1 = parseCase("e", "e", "// expect-err: at 3:18\n", &mem);
    if judge(&e1, 1, "", ERR, &mem) == "" { panic("error count not checked"); }
    // Rust's capped summary is a count line too, not one more error.
    if !isCount("12 errors (and 2 more not shown)") || !isCount("2 errors") { panic("count line"); }
    if isCount("2 errors in total") || isCount("x errors") { panic("not a count line"); }
    let capped = "error: a\n  --> e.j3:1:1\nerror: 12 errors (and 11 more not shown)\n";
    if parseDiags(capped, &mem).len != 1 { panic("capped count read as an error"); }
    // Exit 125 is an ordinary expected exit, not "could not start sh".
    let x = parseCase("x", "x", "// expect-exit: 125\n", &mem);
    if judge(&x, 125, "", "", &mem) != "" { panic("expect-exit 125"); }
    printLn("testcompiler_header ok");
}
