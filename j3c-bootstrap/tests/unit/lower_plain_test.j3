// `lower` on plain code: a program with every C2a construct (temps, bounds checks, `/` zero checks,
// `&&`/`||`, string `==`, struct defaults in written order, auto-ref receivers, enum payloads, `for` over
// ranges and arrays, slices, interpolation with `#[Debug]`, `defer`) through `Stage.Passes` (so the IR
// validates), its user module dumped and compared byte for byte with
// `tests/unit/expect/lower_plain.ir` (frozen from the Rust compiler's `dump-ir`, plan 15).
module lower_plain_test;

use j3.io;
use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };
use unitkit;

// Run from the repo root (as `diff.sh` does): with cwd = j3c-bootstrap/ the loader reads that `j3.toml`.
const DIR = "target/lower_plain";
const PATH = "target/lower_plain/p.j3";

/// The text up to the second `module ` line (the program's own module; the stdlib follows).
fn userModule(s: string): string {
    let n = 0;
    for i in 0..s.len {
        if (i == 0 || s[i - 1] == 10) && i + 7 <= s.len && s[i..i + 7] == "module " {
            n += 1;
            if n == 2 { return s[0..i]; }
        }
    }
    return s;
}

fn main() {
    let up: [3]u8;
    up[0] = 46;
    up[1] = 46;
    if sys.chdir(&up[0] as ptr) != 0 { panic("cannot cd to the repo root"); }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = PATH;
    let s = Session.new(opts);
    defer s.free();
    let src = Text.new(s.arena);
    src.add("module lowerplain;\n");
    src.add("\n");
    src.add("use j3.io.printLn;\n");
    src.add("\n");
    src.add("const N = 4;\n");
    src.add("\n");
    src.add("struct Pt {\n");
    src.add("    x: int;\n");
    src.add("    y: int = 7;\n");
    src.add("    on: bool = true;\n");
    src.add("\n");
    src.add("    fn sum(this: &Pt): int { return this.x + this.y; }\n");
    src.add("    fn bump(this: &Pt) { this.x += 1; }\n");
    src.add("}\n");
    src.add("\n");
    src.add("enum Shape {\n");
    src.add("    Dot,\n");
    src.add("    Circle(int),\n");
    src.add("    Rect(int, int),\n");
    src.add("}\n");
    src.add("\n");
    src.add("#[Debug]\n");
    src.add("struct Tag { id: int; name: string; }\n");
    src.add("\n");
    src.add("enum Color { Red, Green }\n");
    src.add("\n");
    src.add("fn area(s: Shape, c: Color): int {\n");
    src.add("    if c == Color.Red { return 0; }\n");
    src.add("    return 1;\n");
    src.add("}\n");
    src.add("\n");
    src.add("fn pick(xs: []int, i: int): int { return xs[i]; }\n");
    src.add("\n");
    src.add("fn main() {\n");
    src.add("    let p = Pt { y: 2, x: 1 };\n");
    src.add("    p.bump();\n");
    src.add("    let total = p.sum();\n");
    src.add("    let arr: [4]int;\n");
    src.add("    for i in 0..N { arr[i] = i * 2; }\n");
    src.add("    for i in 0..=2 { total += arr[i]; }\n");
    src.add("    for v in arr { total += v; }\n");
    src.add("    let k = 0;\n");
    src.add("    while k < 3 && total > 0 {\n");
    src.add("        k += 1;\n");
    src.add("        if k == 2 { continue; }\n");
    src.add("        total = total / (k + 1) % 9;\n");
    src.add("    }\n");
    src.add("    let s = \"abc\";\n");
    src.add("    if s == \"abc\" || s != \"x\" { printLn(`total {total} k {k}`); }\n");
    src.add("    let sh = Shape.Rect(2, 3);\n");
    src.add("    let c = Shape.Circle(5);\n");
    src.add("    total += area(sh, Color.Green) + area(c, Color.Red);\n");
    src.add("    let t = Tag { id: 1, name: \"t\" };\n");
    src.add("    printLn(`{t} {p.on} {total}`);\n");
    src.add("    let sl = arr[1..3];\n");
    src.add("    total += pick(sl, 1) + pick(arr, 0) - sl.len;\n");
    src.add("    defer printLn(\"bye\");\n");
    src.add("    printLn(`{total}`);\n");
    src.add("}\n");
    src.add("\n");
    match proc.run(["mkdir", "-p", DIR], "", s.arena) { Result.Ok(_) {} Result.Err(_) { panic("cannot run mkdir"); } }
    match io.writeFile(PATH, src.str() as []u8) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the program"); } }
    if !driver.run(s, Stage.Passes) {
        printLn(failText(s));
        panic("lower or validate failed");
    }
    let ours = Text.new(s.arena);
    if !driver.dumpIr(s, &ours) { panic("dump-ir failed"); }
    unitkit.expect(userModule(ours.str()), "lower_plain.ir", "lowered IR differs from tests/unit/expect/lower_plain.ir");
    printLn("lower plain ok");
}
