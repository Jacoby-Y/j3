// Fixture of lower_interp_test: every interpolation shape, into the frame buffer and into a `Text`.
module interp;

use j3.io.printLn;
use j3.memory.Arena;
use j3.text.Text;

#[Debug]
struct V { x: int; y: f32; name: string; }
#[Debug]
struct Deep { v: V; ok: bool; at: &V; xs: [3]int; raw: ptr; }
#[Debug]
enum Sh { Dot, Circle(f32), Rect(int, int), Named(string) }

const LIMIT = 8;

fn frame(n: int, s: string): int {
    let v = V { x: n, y: 1.5, name: s };
    let d = Deep { v: v, ok: true, at: &v, xs: [1, 2, n], raw: &v as ptr };
    let t = (n, s, true);
    printLn(`plain {n} {s} {n > 1} {LIMIT} {1.25}`);
    printLn(`{v} {d}`);
    printLn(`{Sh.Dot} {Sh.Circle(2.0)} {Sh.Rect(n, 2)} {Sh.Named(s)}`);
    printLn(`{t} {(n, (s, 2.5))}`);
    printLn(`{(d, n)}`);
    let one = `{s}`;
    let fixed = `no holes {LIMIT}`;
    return one.len + fixed.len;
}

fn text(t: &Text, n: int, s: string): string {
    let v = V { x: n, y: 1.5, name: s };
    let u: u8 = 7;
    t.fmt(`plain {n} {s} {n > 1} {u} {2.5}`);
    t.fmt(`{v}`).fmt(`{Sh.Rect(n, 2)} {Sh.Named(s)}`);
    let d = Deep { v: v, ok: false, at: &v, xs: [n, 2, 1], raw: &v as ptr };
    t.fmt(`{(n, s)} {d}`).add("!");
    t.fmt(`lit only`);
    return t.str();
}

fn main() {
    let mem = Arena.create(4096);
    let t = Text.new(&mem);
    printLn(`{frame(3, "abc")}`);
    printLn(text(&t, 3, "abc"));
}
