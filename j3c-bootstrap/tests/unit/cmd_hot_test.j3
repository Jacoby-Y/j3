// `cmd/hot.j3`: what `run --hot` watches and the `<style>`-blind change test (Rust hot/tests.rs
// `style_edits_do_not_count_but_markup_does`, on the text). The watch loop itself is never run in tests.
module cmd_hot_test;

use j3.memory.Arena;
use j3.sys.panic;
use j3c.cmd.hot.{ watched, withoutStyles };

fn check(c: bool, what: string) { if !c { panic(what); } }

fn main() {
    let a = Arena.create(1 << 16);
    defer a.destroy();
    check(watched("src/main.j3"), "j3");
    check(watched("/p/ui/Screen.j3ui"), "j3ui");
    check(watched("scripts/door.j3s"), "j3s");
    check(watched("/p/j3.toml"), "j3.toml");
    check(!watched("ui/theme.css"), "css");
    check(!watched("/p/.j3"), "a hidden `.j3` has no extension");
    check(!watched("j3.toml.bak"), "bak");
    check(!watched("README.md"), "md");

    let red = "<p>hi</p><style>p { color: red }</style><script>let a = 1;</script>";
    let blue = "<p>hi</p><style>p { color: blue }</style><script>let a = 1;</script>";
    let markup = "<p>hi!</p><style>p { color: blue }</style><script>let a = 1;</script>";
    check(withoutStyles(red, &a) == "<p>hi</p><script>let a = 1;</script>", "style block dropped");
    check(withoutStyles(red, &a) == withoutStyles(blue, &a), "a style edit is no change");
    check(withoutStyles(markup, &a) != withoutStyles(blue, &a), "a markup edit is a change");
    // a `<style>` inside a script is code; `<styles>` is a component; `<style\n` is a tag
    let code = "<script>let s = \"<style>x</style>\";</script><style>a{}</style>";
    check(withoutStyles(code, &a) == "<script>let s = \"<style>x</style>\";</script>", "script kept whole");
    check(withoutStyles("<styles>x</styles>", &a) == "<styles>x</styles>", "component kept");
    check(withoutStyles("a<style\n>b</style>c", &a) == "ac", "whitespace after the tag");
    check(withoutStyles("a<style>b", &a) == "a", "unclosed style drops the rest");
    check(withoutStyles("a<script>b", &a) == "a<script>b", "unclosed script kept");
    check(withoutStyles("x<style", &a) == "x<style", "`<style` at the end is no tag");
}
