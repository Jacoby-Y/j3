// `lower` on `dyn`: `tests/unit/lower_dyn_cases/dyn.j3` (conversions, table calls, a default body, a
// by-value method, an `#[impl]` fn, a generic struct, upcasts along `Low: Backend: Named`) through
// `Stage.Passes` (so the IR validates), its user module dumped and compared byte for byte with
// `stage0/j3c dump-ir`: thunk and table order, `_dynN` temps, the default-body instance before its thunk.
// The fixture converts only where an rvalue is taken (`let`, `return`): a conversion in operand position
// (an argument, a struct literal field) is named `_dynN` by `FnLower.operand` (lower/expr.j3).
module lower_dyn_test;

use j3.io;
use j3.io.printLn;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.text.Text;
use j3c.cmd.check.failText;
use j3c.driver;
use j3c.driver.{ Mode, Session, Stage };

// Run from the repo root (as `diff.sh` does): with cwd = j3c-bootstrap/ the loader reads that `j3.toml`.
const DIR = "target/lower_dyn";
const PATH = "target/lower_dyn/p.j3";
const FIXTURE = "j3c-bootstrap/tests/unit/lower_dyn_cases/dyn.j3";

/// The text up to the second `module ` line (the program's own module; the stdlib follows).
fn userModule(s: string): string {
    let n = 0;
    for i in 0..s.len {
        if (i == 0 || s[i - 1] == 10) && i + 7 <= s.len && s[i..i + 7] == "module " {
            n += 1;
            if n == 2 { return s[0..i]; }
        }
    }
    return s;
}

fn main() {
    let up: [3]u8;
    up[0] = 46;
    up[1] = 46;
    if sys.chdir(&up[0] as ptr) != 0 { panic("cannot cd to the repo root"); }
    let opts = driver.defaults();
    opts.mode = Mode.Check;
    opts.entry = PATH;
    let s = Session.new(opts);
    defer s.free();
    match proc.run(["mkdir", "-p", DIR], "", s.arena) { Result.Ok(_) {} Result.Err(_) { panic("cannot run mkdir"); } }
    match io.readFile(FIXTURE, s.arena) {
        Result.Ok(src) { match io.writeFile(PATH, src) { Result.Ok(_) {} Result.Err(_) { panic("cannot write the program"); } } }
        Result.Err(_) { panic("cannot read the fixture"); }
    }
    if !driver.run(s, Stage.Passes) {
        printLn(failText(s));
        panic("lower or validate failed");
    }
    let ours = Text.new(s.arena);
    if !driver.dumpIr(s, &ours) { panic("dump-ir failed"); }
    match proc.run(["j3c-bootstrap/stage0/j3c", "dump-ir", PATH], "", s.arena) {
        Result.Ok(o) {
            if o.code != 0 { printLn(o.errStr()); panic("stage0 dump-ir failed"); }
            let want = userModule(o.outStr());
            let got = userModule(ours.str());
            if want != got {
                printLn("--- stage0");
                printLn(want);
                printLn("--- j3c-boot");
                printLn(got);
                panic("lowered IR differs from stage0");
            }
        }
        Result.Err(_) { panic("cannot run stage0/j3c"); }
    }
    printLn("lower dyn ok");
}
