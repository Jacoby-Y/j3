// `dumpAst` against the oracle: each file in `tests/unit/syntax_dump_cases/` is built by hand (parts in
// `syntax_dump_test/`, every AST variant at least once) and printed; `stage0/j3c dump-ast` on the same
// file must print the same bytes. The parser isn't ported yet, so the trees are hand-made.
// The `use` list is shared with the parts (and with `syntax_walk_test`, which reuses them).
module syntax_dump_test;

use j3.data.pool.Id;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3c.base.intern.Sym;
use j3c.base.span.{ Span, noSpan };
use j3c.driver;
use j3c.driver.Session;
use j3c.syntax.ast.{ ArrayLitExpr, ArrayType, AssignOpStmt, AssignStmt, Ast, AtomicExpr, AtomicOp, AtomicOrder, BinOp, BinaryExpr,
    Block, CallExpr, CastExpr, ClosureLit, ClosureParam, ClosureType, ConstItem, DeferStmt, EmbedExpr, EmbedKind, EmbedRead, EnumItem,
    Expr, ExprStmt, ExtendItem, FieldExpr, FieldInit, FieldItem, File, FnItem, FnType, ForEachStmt, ForStmt, GenericType, GpuStage,
    GpuStruct, Ident, IfExpr, IfStmt, IndexExpr, InterpHole, InterpPart, InterpolateExpr, Item, JumpStmt, LabeledStmt, LetPatStmt,
    LetStmt, LibFnDecl, LitPat, MatchArm, MatchStmt, ModLetItem, NamedType, Param, Pat, PatField, QuestionExpr, RangePat, RefType,
    ReturnStmt, ScriptBlockItem, ScriptLetItem, ScriptLitExpr, SizeOfExpr, SliceExpr, SliceFromExpr, SliceLitExpr, SliceType, Stmt,
    StructItem, StructLitExpr, StructPat, SyscallExpr, TraitItem, TraitMethod, TryCatch, TupleExpr, TuplePat, TupleType, Type,
    TypePathExpr, UiChoiceExpr, UnaryExpr, UnaryOp, UseItem, UseLibItem, UseLocalStmt, VariantItem, VariantPat, WhereBound, WhileStmt };
use j3c.syntax.dump.dumpAst;

/// Prints `file` and compares it with stage 0's `dump-ast` of `syntax_dump_cases/NAME`; false on a difference.
fn same(ast: &Ast, arena: &Arena, name: string, file: File): bool {
    let got = Text.new(arena);
    dumpAst(ast, &file, &got);
    let path = Text.new(arena).add("tests/unit/syntax_dump_cases/").add(name).str();
    match proc.run(["stage0/j3c", "dump-ast", path], "", arena) {
        Result.Ok(o) {
            if o.code != 0 { panic(o.errStr()); }
            if o.outStr() == got.str() { return true; }
            printLn(Text.new(arena).add("DIFF ").add(name).str());
            printLn("--- stage0");
            printLn(o.outStr());
            printLn("--- j3c-boot");
            printLn(got.str());
            return false;
        }
        Result.Err(_) { panic("cannot run stage0/j3c"); }
    }
}

fn main() {
    let s = Session.new(driver.defaults());
    let ast = Ast.new(s.arena, &s.names);
    let b = Bld.new(&ast, s.arena);
    let ok = same(&ast, s.arena, "items.j3", itemsCase(&b));
    ok = same(&ast, s.arena, "stmts.j3", stmtsCase(&b)) && ok;
    ok = same(&ast, s.arena, "exprs.j3", exprsCase(&b)) && ok;
    ok = same(&ast, s.arena, "gpu.j3", gpuCase(&b)) && ok;
    ok = same(&ast, s.arena, "script.j3s", scriptCase(&b)) && ok;

    // `packed` is never set by the parser (no source spelling), so it is checked by hand
    let p = b.structItem("Q", b.fieldItems([b.fieldItem("x", b.tn("u8"), Option.None)]));
    p.packed = true;
    let t = Text.new(s.arena);
    let q = b.file("q", [Item.Struct(p)]);
    dumpAst(&ast, &q, &t);
    if t.str() != "(file (module q)\n  (struct packed Q\n    (field x u8)))\n" { printLn(t.str()); ok = false; }
    if !ok { panic("dumpAst differs from stage0 dump-ast"); }
    s.free();
    printLn("syntax dump ok");
}
