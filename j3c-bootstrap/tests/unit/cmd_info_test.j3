// `version [--verbose]` text and `manifest --json` (Rust `manifest_cmd`): the project's `j3.toml` as JSON, found
// from a folder, a file inside it or the `j3.toml` itself; Rust's error texts.
module cmd_info_test;

use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, contains, endsWith, startsWith };
use j3c.cmd.info.{ manifestJson, versionText };

const WANT: string = "{\"package\":{\"name\":\"j3c\",\"bin\":\"j3c\",\"version\":\"0.1.0\",\"description\":\"J3 compiler\",\"entry\":\"src/main.j3\"},\"emit\":{\"backend\":\"llvm\",\"opt\":0,\"debug\":true},\"dist\":{\"icon\":\"assets/j3c.png\"}}";

fn json(p: string, arena: &Arena): string {
    match manifestJson(p, arena) {
        Result.Ok(j) { return j; }
        Result.Err(e) { panic(e); }
    }
    return "";
}

fn main() {
    let mem = Arena.create(1 << 14);
    defer mem.destroy();
    let v: [1]string = ["-v"];
    let t = Text.new(&mem);
    versionText(v[0..0], &t, &mem);
    if t.str() != "j3c 0.1.0\n" { panic(t.str()); }
    let t2 = Text.new(&mem);
    versionText(v[..], &t2, &mem);
    if !startsWith(t2.str(), "j3c 0.1.0\ndocs     ") || !contains(t2.str(), "\nstdlib   ") || !contains(t2.str(), "\neditor   ") || !contains(t2.str(), "\nbinary   /") {
        panic(t2.str());
    }

    // cwd = j3c-bootstrap (tests/unit.sh).
    if json(".", &mem) != WANT { panic(json(".", &mem)); }
    if json("src/main.j3", &mem) != WANT { panic("from a file"); }
    if json("j3.toml", &mem) != WANT { panic("from j3.toml"); }
    match manifestJson("/proc/nope/x", &mem) {
        Result.Ok(_) { panic("found a j3.toml under /proc"); }
        Result.Err(e) { if e != "no j3.toml at or above /proc/nope/x" { panic(e); } }
    }
    match manifestJson("nope/j3.toml", &mem) {
        Result.Ok(_) { panic("read a missing j3.toml"); }
        Result.Err(e) { if !startsWith(e, "no j3.toml at or above /") || !endsWith(e, "/nope/j3.toml") { panic(e); } }
    }
}
