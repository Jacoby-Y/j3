// Smoke test for the unit-test pattern (tests/unit.sh): a test reaches `j3c.*` modules and fails by panic.
module smoke_test;

use j3.io.printLn;
use j3.sys.panic;
use j3.data.pool.Id;
use j3c.base.diag.Severity;
use j3c.base.ids.Spans;
use j3c.base.span.{ isNone, noSpan };
use j3c.driver;
use j3c.driver.Session;

fn main() {
    let s = Session.new(driver.defaults());
    let a = s.names.intern("main");
    if s.names.intern("main") != a { panic("intern is not stable"); }
    if s.names.str(a) != "main" { panic("intern lost the string"); }
    if s.diags.hasErrors() { panic("new session has errors"); }
    s.diags.add(s.diags.make(1, Severity.Error, noSpan(), "boom"));
    if s.diags.count() != 1 || !s.diags.hasErrors() { panic("diag not recorded"); }
    let sp = Spans<int>.new(s.arena);
    if !isNone(sp.get(Id<int> { i: 0 })) { panic("unset span is not noSpan"); }
    s.free();
    printLn("smoke ok");
}
