// Tuples through `lower`: literals, `.0` places and writes, destructuring, tuple arms, `==` / `!=` / `hash()`
// (the `_tupN` temporaries), a tuple holding a struct with its own operators, through a `&`.
module c1.t1;

use j3.io.printLn;
fn printInt(x: int) { printLn(`{x}`); }
use j3.option.Option;

enum Op { Add, Mul }

struct P { x: int; y: int;
    fn operator==(this: P, o: P): bool { return this.x == o.x && this.y == o.y; }
    fn hash(this: P): u64 { return u64(this.x * 31 + this.y); }
}

fn divmod(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

fn find(xs: []int, x: int): Option<(int, int)> {
    for i in 0..xs.len {
        if xs[i] == x { return Option.Some((i, xs[i] * 10)); }
    }
    return Option.None;
}

fn apply(p: (Op, int), x: int): int {
    match p {
        (Op.Add, n) { return x + n; }
        (Op.Mul, 0) { return 0; }
        (Op.Mul, n) { return x * n; }
    }
}

fn main() {
    let (q, r) = divmod(17, 5);
    let t = divmod(9, 4);
    printInt(q + r + t.0 + t.1);
    let nest: ((int, f32), string) = ((1, 2.5), "hi");
    let ((a, b), s) = nest;
    printInt(nest.0.0 + a + s.len);
    let xs = [3, 5, 7];
    match find(xs, 5) {
        Option.Some((i, v)) { printInt(i + v); }
        Option.None { printInt(-1); }
    }
    printInt(apply((Op.Add, 2), 3) + apply((Op.Mul, 0), 3));
    if (1, "x") == (1, "x") { printInt(1); }
    if (1, "x") != (2, "x") { printInt(2); }
    if (1, "x").hash() == (1, "x").hash() { printInt(3); }
    let pp = (P { x: 1, y: 2 }, (3, true));
    let rp = &pp;
    if pp == (P { x: 1, y: 2 }, (3, true)) { printInt(4); }
    printInt(int(rp.hash() & 255));
    t.0 = 5;
    printInt(t.0);
}
