module bc_refuse_dev_takes;

// diff.sh bc refusal (devmode, not bytecode): a script calls a native fn that takes a script instance
// (`... which takes or returns a script instance; dev builds can't pass those to native code yet`).
use j3.io.printLn;
const Thing = @script("scripts/thing.j3s");
const Other = @script("scripts/other.j3s");
fn main() {
    let a = Other { k: 1 };
    let t = Thing { n: 2, other: &a };
    printLn(`{t.go()}`);
}
