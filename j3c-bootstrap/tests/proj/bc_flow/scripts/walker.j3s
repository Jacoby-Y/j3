// Walks the shared grid: calls into another script and into native code.
use j3.io.printLn;
use boxes.{ Box, wrap };

const Grid = @script("scripts/grid.j3s");

props {
    grid: &Grid;
    name: string;
    stride: int = 1;
}

let x = 0;
let total = 0;

pub fn step(roll: int) {
    let b = wrap(roll);
    x += stride;
    let got = grid.visit(x, b.get() % 4);
    if got > 3 {
        total += got * 2;
    } else {
        total += got;
    }
    defer { total -= 1; }
    if b.get() == 0 { return; }
    total += b.hits;
}

pub fn report() {
    printLn(`{name}: x {x} total {total}`);
}
