// A grid every walker shares: a table global, `shared` counters, nested loops.
use j3.io.printLn;
use boxes.clampTo;

props {
    w: int;
    h: int;
}

shared {
    visits: int = 0;
    resets: u8 = 0;
}

const WEIGHTS: [6]int = [3, 1, 4, 1, 5, 9];

let low: i16 = 0;

pub fn visit(x: int, y: int): int {
    visits += 1;
    let cx = clampTo(x, w - 1);
    let cy = clampTo(y, h - 1);
    let cell = cy * w + cx;
    if cell < 8 { low += 1; }
    return WEIGHTS[cell % 6];
}

/// Nested loops: `continue` the inner, `continue 'rows`, `break 'rows`, defers on the way out.
pub fn scan(limit: int): int {
    let found = 0;
    let steps = 0;
    'rows: for y in 0..h {
        defer { steps += 1; }
        let x = 0;
        while x < w {
            x += 1;
            if x == 2 { continue; }
            if WEIGHTS[(x + y) % 6] == 1 { continue 'rows; }
            found += 1;
            if found >= limit * 3 { break 'rows; }
        }
    }
    if found > 100 {
        resets += 1;
        return -1;
    }
    printLn(`scan steps {steps} visits {visits} low {low} resets {resets}`);
    return found;
}

/// A match on plain ints is a switch: a compare chain in the VM.
pub fn kind(v: int): int {
    match v {
        0 { return 10; }
        1 | 2 { return 20; }
        5 { return 50; }
        _ { return -1; }
    }
}
