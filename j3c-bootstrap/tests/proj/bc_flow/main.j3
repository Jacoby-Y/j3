module bc_flow;

// diff.sh bc: loops (nested, labeled break/continue, defers), int switches, a `shared` global,
// an array table global, a script calling a script, and native calls (a generic struct method).
use j3.io.printLn;

const Grid = @script("scripts/grid.j3s");
const Walker = @script("scripts/walker.j3s");

fn main() {
    let g = Grid { w: 5, h: 4 };
    let a = Walker { grid: &g, name: "a" };
    let b = Walker { grid: &g, name: "b", stride: 3 };
    for i in 0..6 {
        a.step(i);
        b.step(i * 2);
    }
    a.report();
    b.report();
    printLn(`scan {g.scan(3)} kind {g.kind(0)} {g.kind(2)} {g.kind(9)}`);
}
