/// Native code the scripts call: a generic struct (its methods are instantiated for the script) and a plain fn.
module boxes;

pub struct Box<T> {
    value: T;
    hits: int = 0;

    fn get(this: &Box<T>): T {
        this.hits += 1;
        return this.value;
    }
}

pub fn wrap(v: int): Box<int> { return Box<int> { value: v }; }

pub fn clampTo(v: int, hi: int): int {
    if v > hi { return hi; }
    return v;
}
