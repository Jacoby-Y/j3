module merged_names;
use j3.io.printLn;
use merged_names.gen.{ Holder, twice };
use merged_names.box;

const n = 40;
const scale = 10;
fn boot(a: int): int { return a + 1000; }
fn inc(a: int): int { return a + 1; }

fn main(): int {
    let h = Holder<int> { x: 1 };
    printLn(`{h.run()} {twice::<int>(5, inc)} {box.get()}`);
    return 0;
}
