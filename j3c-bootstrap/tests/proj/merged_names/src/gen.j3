module merged_names.gen;
use j3.io.printLn;

pub struct Cell { v: int; fn get(this: &Cell): int { return this.v; } }

pub struct Holder<T> {
    x: T;
    fn run(this: &Holder<T>): int {
        let box = Cell { v: 7 };
        let n = 3;
        return box.get() + n;
    }
}
pub fn twice<T>(x: T, boot: fn(int): int): int {
    let scale = 2;
    return boot(1) * scale;
}
