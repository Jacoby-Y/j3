module bc_scalars;

// diff.sh bc: one script that touches every scalar width, casts, unary and binary ops,
// C-like enums and #[Debug] struct interpolation (tests/proj/README.md).
use j3.io.printLn;

const Widths = @script("scripts/widths.j3s");

fn main() {
    let w = Widths { seed: 7 };
    w.ints();
    w.floats();
    w.logic(true);
    w.shapes();
    printLn(`sum {w.sum(250)}`);
}
