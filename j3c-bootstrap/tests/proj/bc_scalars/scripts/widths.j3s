// Every scalar width and the ops on it: the VM re-extends narrow results after math.
use j3.io.printLn;
use shapes.Pair;

props {
    seed: int = 1;
}

enum Dir { North, East, South, West }


let calls: u16 = 0;

pub fn ints() {
    calls += 1;
    let a: i8 = 120;
    a += 10;
    let b: u8 = 250;
    b += 10;
    let c: i16 = -30000;
    c -= 5000;
    let d: u16 = 65535;
    d += 2;
    let e: i32 = 2147483647;
    e += 1;
    let f: u32 = 3;
    f -= 4;
    let g: i64 = -9;
    let h: u64 = 18446744073709551615;
    printLn(`i8 {a} u8 {b} i16 {c} u16 {d} i32 {e} u32 {f}`);
    printLn(`i64 {g / 2} {g % 4} u64 {h / 3} {h % 10}`);
    printLn(`neg {-a} bnot {~b} {~f} and {b & 15} or {b | 64} xor {b ^ 255}`);
    printLn(`cmp {a < 0} {b >= 4} {f > 7} {g <= -9} {h != 0} {c == -30000}`);
}

pub fn floats() {
    let x: f32 = 1.5;
    let y: f64 = -2.25;
    x *= 3.0;
    y = y / 0.5 + 1.0;
    let i = i32(x);
    let u = u64(y * -1.0);
    let back = f32(i) + f32(u);
    let wide = f64(x) - y;
    let s = u8(seed * 40);
    printLn(`f32 {x} f64 {y} i {i} u {u} back {back} wide {wide} s {s} {f32(s)} {-x} {-y}`);
    printLn(`fcmp {x > 4.0} {y <= -3.5} {x == 4.5} {y != 0.0} {i as bool} {seed as bool}`);
}

pub fn logic(on: bool) {
    let n = 0;
    if on && seed > 3 { n += 1; }
    if !on || seed == 7 { n += 2; }
    let d = Dir.South;
    if seed > 5 { d = Dir.West; }
    let code = 0;
    match d {
        Dir.North { code = 1; }
        Dir.East { code = 2; }
        Dir.South { code = 3; }
        Dir.West { code = 4; }
    }
    printLn(`logic {n} dir {code} calls {calls}`);
}

pub fn shapes() {
    let p = Pair { a: -5, b: 200, ok: true };
    p.b += 100;
    printLn(`pair {p}`);
}

pub fn sum(n: int): int {
    let total = 0;
    for i in 0..n {
        if i % 3 == 0 { continue; }
        total += i;
    }
    return total;
}
