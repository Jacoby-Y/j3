module bc_refuse_dev_ret;

// diff.sh bc refusal (devmode, not bytecode): a `pub` script fn returns a script instance to native code
// (`... returns a script instance; dev builds can't return those to native code yet`).
use j3.io.printLn;
const Grid = @script("scripts/grid.j3s");
const Walker = @script("scripts/walker.j3s");
fn main() {
    let g = Grid { w: 2 };
    let a = Walker { grid: &g };
    let h = a.home();
    printLn(`{h.width()}`);
}
