<div class="box" id="main">
  <span class="hit r{n}" style:width="revert">x</span>
  <Kid class="passed" />
  {#if true}<p>hi</p>{/if}
</div>
<style>
.box { color: red; color: blue; }
.hit.r2 { top: 1px; }
.hit.q9 { color: red; }
.passed { color: red; }
.box span { text-overflow: ellipsis; }
/* j3-lint-ignore never-matches */
.gone { color: red; }
.gone2 { color: red; }
div.box.nope { color: red; }
#main { color: red; }
#other { color: red; }
section { color: red; }
.box:has(.x) { color: red; }
.j3-select-list { color: red; }
</style>
