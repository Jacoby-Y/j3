# SDL window. Needs SDL2.
# Image, mixer, and font libraries load the first time you use them.
# A missing library leaves the handle empty and does not close the window.
# From this directory: j3c check / j3c run
# Left and Right move the bar. Escape quits.

[package]
name = "@NAME@"
entry = "src/main.j3"
version = "0.1.0"
description = "@NAME@, made with j3"

[emit]
backend = "llvm"
opt = 1
debug = true
# Dev loop: opt 1 runs about 6x faster than opt 0, which builds a little faster.
# Ship with `j3c build --release` (opt s, no -g, stripped: about 3x smaller).

[link]
libs = ["SDL2"]

[dist]
# `j3c build --release` also writes these to target/dist/: a zip per target, and a .deb
# (Linux) that installs to /opt with a menu entry. `j3c help manifest` lists every key.
# build_outputs = ["zip", "deb"]
# icon = "assets/icon.png"          # menu and window icon; default the J3 logo

[splash]
# Startup splash (`j3c doc ship`): the J3 logo, then your cards, while startup systems load.
# enabled = true
# cards = ["assets/studio.png"]
