# Hello. From this directory: j3c check / j3c run
# A window instead: j3c new --app  (see j3c guide)

[package]
name = "@NAME@"
entry = "src/main.j3"

[emit]
backend = "llvm"
opt = 1
debug = true
# Dev loop: opt 1 runs about 6x faster than opt 0, which builds a little faster.
# Ship with `j3c build --release` (opt s, no -g, stripped: about 3x smaller).
