module settings;

use j3.data.json;
use j3.data.toml;
use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;

const DEFAULTS: string = "[window]\nwidth = 1280\nheight = 720\nvsync = true\n\n[audio]\nmusic = 0.8\n\n[[keys]]\naction = \"jump\"\nkey = \"space\"\n";

fn main() {
    let arena = Arena.create(1024 * 1024);
    let a = &arena;
    // the saved file if there is one, else the defaults
    let text = match io.readFile("settings.toml", a) {
        Result.Ok(b) { b as string }
        Result.Err(_) { DEFAULTS }
    };
    let cfg = match toml.parse(text, a) {
        Result.Ok(d) { d }
        Result.Err(e) {
            printLn(`settings.toml:{e.line}: {e.msg}`);
            panic("bad settings.toml");
        }
    };
    // a missing key reads as 0 / "" / false; pick your own default
    let w = cfg.path("window.width").asInt();
    if w == 0 { w = 1280; }
    printLn(`window {w}x{cfg.path("window.height").asInt()}, jump on {cfg.path("keys.0.key").asStr()}`);

    // change a value and save: atomic, so a crash never leaves half a file
    cfg.get("audio").set("music", json.num(0.5, a));
    match io.writeFileAtomic("settings.toml", toml.stringify(cfg, a) as []u8) {
        Result.Ok(_) {}
        Result.Err(_) { panic("could not write settings.toml"); }
    }
    printLn("saved settings.toml");
    arena.destroy();
}
