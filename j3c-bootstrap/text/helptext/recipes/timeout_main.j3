module runner;

use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.proc.{ Child, StartOpts };
use j3.result.Result;
use j3.sys;
use j3.sys.{ O_APPEND, O_CREAT, O_WRONLY };

/// Wait up to `ms` for `c` to end. On timeout: SIGTERM to its whole group, a short grace, then SIGKILL.
/// The exit code (128 + signal when killed).
fn waitOrKill(c: &Child, ms: int): int {
    let deadline = sys.monotonicMs() + ms;
    while sys.monotonicMs() < deadline {
        match c.tryWait() {
            Option.Some(code) { return code; }
            Option.None { sys.sleepMs(20); }
        }
    }
    printLn("timed out: stopping the whole group");
    c.killTree(sys.SIGTERM);
    sys.sleepMs(200);
    c.killTree(sys.SIGKILL);
    return c.wait();
}

fn main() {
    let a = Arena.create(1 << 20);
    // stdout and stderr both appended to run.log (`>>run.log 2>&1`)
    let log = io.openPath("run.log", O_WRONLY + O_CREAT + O_APPEND, 420);
    // `sleep 30 &` is a grandchild: Child.kill would leave it running, killTree does not
    let argv: [3]string = ["sh", "-c", "echo started; sleep 30 & sleep 30"];
    let opts = StartOpts { group: true, stdoutFd: log, stderrFd: log, cpuSecs: 60, memBytes: 1 << 32 };
    match proc.startWith(argv[:], argv[0..0], opts, &a) {
        Result.Ok(c) {
            sys.close(log);
            let code = waitOrKill(&c, 2000);
            printLn(`exit code {code}`);
        }
        Result.Err(_) { printLn("could not start sh"); }
    }
    match io.readFile("run.log", &a) {
        Result.Ok(b) { printLn(b as string); }
        Result.Err(_) {}
    }
}
