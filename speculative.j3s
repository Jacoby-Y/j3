// Speculative J3s code.
// J3s is a simple, J3 subset, general-purpose scripting language (think Lua): game logic,
// editor tools, build steps, generators, config, mods. The language knows nothing about
// scenes or games; whatever embeds it (the host) decides what a script can see.
//
// This file shows several scripts, each under a `==== <file> ====` banner. It isn't one
// runnable script.
//
// Rules:
// - Every J3s file is J3 after one desugar (below). Release builds can compile it as J3;
//   an interpreter runs it for hot reload and embedding. Same checker for both.
// - One file is one script. No `module` line, no `pub`: the host names the module.
// - Banned: `use lib`, casts, pointer math, building slices from pointers, `Arena.create`,
//   and taking `&` of anything the host didn't hand you.
// - Stdlib imports are allowed when every type in the signature crosses the interpreter
//   boundary: numbers, bool, string, enums, value structs (Vec2/Vec3/Quat/Mat4/Color), and
//   host handles. The host can narrow this to a list of modules. Anything else is a load
//   error:  door.j3s:3: `j3.memory.scratch` isn't available in scripts
//
// The whole language surface on top of J3:
//   top-level statements      run in order when the script loads (become `fn main()`)
//   `use host.{ ... }`        whatever this host offers; each host defines its own `host`
//   `@props { ... }`          per-instance values the host sets (read-only in the script)
//   `@state { ... }`          per-instance values the script owns
// A script the host never instantiates just doesn't use `@props`/`@state`.


// ==== sum.j3s ==================================================================
// The bare host: `j3c script sum.j3s`, like `lua sum.lua`. It offers only `memory`.

use host.memory;
use j3.io.printLn;
use j3.text.Text;

let total = 0;
let i = 1;
while i <= 10 {
    total += i;
    i += 1;
}
let out = Text.new(memory());
out.pushStr("sum: ");
out.pushInt(total);
printLn(out.str());

// `memory()` (the script's arena) is the one host fn every host has, so `Text` works
// without `Arena.create`. String `+` would go into J3 too, if we want it.


// ==== build.j3s ================================================================
// A build tool host: args in, commands out. No props, no scene.

use host.{ args, run, exit };
use j3.text.same;

let release = args().len > 0 && same(args()[0], "--release");
let flags = if release { "build --release" } else { "build" };
if !run("j3c", flags) { exit(1); }
if release { run("strip", "target/game"); }


// ==== terrain.j3s ==============================================================
// The generator host (`j3c -e gen`, whose mesh scripts are J3 today).

use host.{ mesh, seed };
use j3.gfx.noise;
use j3.math.Vec3;

@props {
    size: int = 64;
    height: f32 = 8.0;
}

let x = 0;
while x < size {
    let z = 0;
    while z < size {
        let y = noise.fbm(f32(x) * 0.05, f32(z) * 0.05, seed()) * height;
        mesh().quad(Vec3.xyz(f32(x), y, f32(z)), 1.0);
        z += 1;
    }
    x += 1;
}


// ==== door.j3s =================================================================
// The scene host: one instance per node that has this script attached.

use host.{ scene, self, say };
use j3.math.{ Vec2, clamp, lerp };
use j3.scene3d;

// Per-instance values, set in the editor or from J3 code. The block is only for grouping:
// the script says `openAngle`, not `props.openAngle`. Writing one is an error (use
// `@state`). Types: f32, int, bool, string, Vec2, Vec3, Color, and whatever handle types
// the host adds (the scene host adds `Node`, an object picker).
@props {
    openAngle: f32 = 90.0;
    seconds: f32 = 0.6;
    locked: bool = false;
    key: string = "key";
    offset: Vec2 = Vec2 { x: 0, y: 0 };
}

// Per-instance values the script owns. Same format and bare names as `@props`, but the
// host doesn't show or save them. Reset to their defaults on each new instance.
@state {
    open: bool = false;
    t: f32 = 0.0;
    hinge: int = 0;
}

// A plain top-level `let` keeps its J3 meaning: one value shared by every instance.
let doorsOpened: int = 0;

// Names in `@props`, `@state`, top-level `let`s, and fns share one namespace; a clash is a
// load error. J3 already rejects shadowing, so a local `let t` in a fn is an error too.
//
// Desugar: the blocks become `struct Props`/`struct State`, each fn gets a hidden
// `this: &Instance` param, and bare names rewrite to `this.props.x`/`this.state.x`.
// `host.self` is per instance the same way.

// The scene host calls these by name, all optional. Other hosts pick their own names.
//   start()               once, after the scene loads
//   update(dt)            every frame
//   on<Event>(...)        sent by other scripts or the host (`scene3d.send`)

fn start() {
    // ponytail: findPath is plan 009's; any name lookup works here.
    hinge = scene3d.findPath(scene(), self(), "Hinge");
}

fn update(dt: f32) {
    let goal = if open { 1.0 } else { 0.0 };
    let step = dt / seconds;
    t = clamp(t + clamp(goal - t, 0 - step, step), 0, 1);

    let at = scene3d.index(scene(), hinge);
    if at < 0 { return; }
    scene().nodes[at].rotation.y = lerp(0, openAngle, smooth(t)) * 3.14159 / 180;
}

// `scene3d.send(scene, doorId, "use", playerId)` calls this.
fn onUse(who: int) {
    if locked && !scene3d.flag(scene(), who, key, false) {
        say("It's locked.");
        return;
    }
    open = !open;
    if open { doorsOpened += 1; }
}

// Plain helpers are fine; they're just J3 functions.
fn smooth(x: f32): f32 {
    return x * x * (3 - 2 * x);
}


// ==== The embedding side (J3, not J3s) ==========================================
// Any J3 program can host scripts through `j3.script`. The scene host is just this plus
// a loop that calls `update` on each instance.
//
//   use j3.script.{ Script, Host };
//
//   let h = Host.new(arena);
//   h.allow("j3.math");                      // stdlib modules scripts may `use`
//   h.bind("say", say);                      // J3 fns become `host.say`
//   let door = Script.load("scripts/door.j3s", &h, arena);
//   if !door.ok { printLn(door.error); }     // file:line: message, never a panic
//   let a = door.instance();                  // fresh @state, default @props
//   a.set("openAngle", 120.0);                // a @props value
//   a.call("update", 0.016);


// Rejected at load, with the J3s rule that broke:
//   use lib "c" as libc { ... }        // J3s: no `use lib`
//   let m = Arena.create(1024);        // J3s: scripts use the host's memory
//   let p = (x as &u8);                // J3s: no casts

// Open:
// - Lists/maps: a stdlib `List<T>`/`Map<K, V>` J3 also gets, or none for v1?
// - `for x in xs` / `for i in 0..n`: add to J3 itself so J3s stays a subset.
// - String `+` (J3 too, or scripts stick to `Text`).
// - `self()` is a node id; a real `Node` handle (`self.find("Hinge")`) is nicer but new.
// - Plan 011's editor extensions become an editor host (`use host.{ menu, inspect }`)
//   instead of compiled `ext_*.j3`.
// - `j3.script`, `j3c script`, `noise.fbm`, `scene3d.send`/`findPath` don't exist yet.
