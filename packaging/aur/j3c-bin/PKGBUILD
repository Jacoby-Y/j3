# Prebuilt j3c from GitHub Releases. Per release: bump pkgver, run updpkgsums, then
# makepkg --printsrcinfo > .SRCINFO (see packaging/README.md).
pkgname=j3c-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="J3 compiler: an ahead-of-time compiled game language"
arch=('x86_64' 'aarch64')
url="https://github.com/Jacoby-Y/j3"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc-libs' 'clang')
optdepends=('sdl2: windowed programs, input, audio'
            'libglvnd: OpenGL for 3D, .j3ui, paint'
            'sdl2_ttf: text'
            'sdl2_image: image loading'
            'sdl2_mixer: sounds and music'
            'ttf-dejavu: default UI font'
            'noto-fonts-emoji: emoji in text')
provides=('j3c')
conflicts=('j3c')
options=('!strip')
source_x86_64=("$url/releases/download/v$pkgver/j3c-$pkgver-x86_64-linux.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/j3c-$pkgver-aarch64-linux.tar.gz")
# Filled by updpkgsums from the published release; makepkg fails until then.
sha256sums_x86_64=('REPLACE_WITH_RELEASE_SHA256')
sha256sums_aarch64=('REPLACE_WITH_RELEASE_SHA256')

package() {
  install -Dm755 j3c/bin/j3c "$pkgdir/usr/bin/j3c"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    j3c/LICENSE-MIT j3c/LICENSE-APACHE j3c/LICENSE-DejaVu.txt j3c/LICENSE-BootstrapIcons.txt
  install -Dm644 j3c/THIRD_PARTY.md "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY.md"
}
