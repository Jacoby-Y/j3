// Tile grid + room generator. Letters in parse() still work; play uses generate().

module dungeon.map;

use j3.io;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.rand.Rng;
use j3.result.Result;
use j3.sys.panic;
use j3.game.tile;
use j3.game.tile.{ MARK_ENEMY, MARK_KEY, MARK_PLAYER, MARK_STAIR, TileMap };

pub const TILE: int = 16;
pub const FLOORS: int = 10;

pub const FLOOR: u8 = 0;
pub const WALL: u8 = 1;
pub const DOOR: u8 = 2;
pub const OPEN: u8 = 3;

pub enum Actor {
    Player,
    Enemy,
    Key,
    Stair,
}

pub struct Map {
    tiles: []u8;
    w: int;
    h: int;
}

pub struct Spawn {
    pos: Vec2;
    who: Actor;
}

pub struct Loaded {
    map: Map;
    spawns: []Spawn;
    n: int;
}

pub fn at(m: &Map, tx: int, ty: int): u8 {
    if tx < 0 || ty < 0 || tx >= m.w || ty >= m.h {
        return WALL;
    }
    return m.tiles[ty * m.w + tx];
}

pub fn set(m: &Map, tx: int, ty: int, t: u8) {
    if tx < 0 || ty < 0 || tx >= m.w || ty >= m.h {
        return;
    }
    m.tiles[ty * m.w + tx] = t;
}

pub fn tileAt(m: &Map, x: f32, y: f32): u8 {
    return at(m, int(x / f32(TILE)), int(y / f32(TILE)));
}

pub fn solid(m: &Map, x: f32, y: f32): bool {
    let t = tileAt(m, x, y);
    return t == WALL || t == DOOR;
}

pub fn blocked(m: &Map, x: f32, y: f32, s: f32): bool {
    let e = s - 1;
    return solid(m, x, y) || solid(m, x + e, y) || solid(m, x, y + e) || solid(m, x + e, y + e);
}

pub fn unlockDoors(m: &Map) {
    let i = 0;
    while i < m.tiles.len {
        if m.tiles[i] == DOOR {
            m.tiles[i] = OPEN;
        }
        i += 1;
    }
}

fn carve(m: &Map, x0: int, y0: int, x1: int, y1: int) {
    let y = y0;
    while y <= y1 {
        let x = x0;
        while x <= x1 {
            set(m, x, y, FLOOR);
            x += 1;
        }
        y += 1;
    }
}

fn hall(m: &Map, x0: int, y0: int, x1: int, y1: int) {
    let x = x0;
    let dx = 1;
    if x1 < x0 {
        dx = 0 - 1;
    }
    while x != x1 {
        set(m, x, y0, FLOOR);
        x += dx;
    }
    set(m, x1, y0, FLOOR);
    let y = y0;
    let dy = 1;
    if y1 < y0 {
        dy = 0 - 1;
    }
    while y != y1 {
        set(m, x1, y, FLOOR);
        y += dy;
    }
    set(m, x1, y1, FLOOR);
}

fn atPos(tx: int, ty: int): Vec2 {
    return Vec2 {
        x: f32(tx * TILE + 2),
        y: f32(ty * TILE + 2),
    };
}

fn pushSpawn(spawns: []Spawn, n: int, who: Actor, tx: int, ty: int): int {
    if n >= spawns.len {
        return n;
    }
    spawns[n] = Spawn { pos: atPos(tx, ty), who: who };
    return n + 1;
}

pub fn generate(arena: &Arena, rng: &Rng, floor: int): Loaded {
    let w = 52;
    let h = 36;
    let tiles = arena.alloc::<u8>(w * h);
    let i = 0;
    while i < tiles.len {
        tiles[i] = WALL;
        i += 1;
    }
    let m = Map { tiles: tiles, w: w, h: h };

    let rooms = 6 + floor;
    if rooms > 12 {
        rooms = 12;
    }
    let cx = arena.alloc::<int>(rooms);
    let cy = arena.alloc::<int>(rooms);
    let nroom = 0;
    let tries = 0;
    while nroom < rooms && tries < 80 {
        tries += 1;
        let rw = rng.intRange(5, 11);
        let rh = rng.intRange(4, 8);
        let rx = rng.intRange(1, w - rw - 1);
        let ry = rng.intRange(1, h - rh - 1);
        let hit = false;
        let k = 0;
        while k < nroom {
            if rx < cx[k] + 6 && rx + rw > cx[k] - 6 && ry < cy[k] + 5 && ry + rh > cy[k] - 5 {
                hit = true;
            }
            k += 1;
        }
        if hit {
            continue;
        }
        carve(&m, rx, ry, rx + rw - 1, ry + rh - 1);
        cx[nroom] = rx + rw / 2;
        cy[nroom] = ry + rh / 2;
        nroom += 1;
    }
    if nroom < 2 {
        panic("generate rooms");
    }

    i = 1;
    while i < nroom {
        hall(&m, cx[i - 1], cy[i - 1], cx[i], cy[i]);
        i += 1;
    }

    let door_x = (cx[nroom - 2] + cx[nroom - 1]) / 2;
    let door_y = (cy[nroom - 2] + cy[nroom - 1]) / 2;
    if at(&m, door_x, door_y) == FLOOR {
        set(&m, door_x, door_y, DOOR);
    }

    let cap = 96;
    let spawns = arena.alloc::<Spawn>(cap);
    let n = 0;
    n = pushSpawn(spawns, n, Actor.Player, cx[0], cy[0]);
    n = pushSpawn(spawns, n, Actor.Stair, cx[nroom - 1], cy[nroom - 1]);
    n = pushSpawn(spawns, n, Actor.Key, cx[nroom - 2], cy[nroom - 2]);

    let enemies = 5 + floor * 2;
    if enemies > 28 {
        enemies = 28;
    }
    i = 0;
    while i < enemies {
        let r = rng.intRange(1, nroom);
        let ox = rng.intRange(0 - 2, 3);
        let oy = rng.intRange(0 - 2, 3);
        let tx = cx[r] + ox;
        let ty = cy[r] + oy;
        if at(&m, tx, ty) == FLOOR {
            n = pushSpawn(spawns, n, Actor.Enemy, tx, ty);
        }
        i += 1;
    }

    return Loaded {
        map: m,
        spawns: spawns,
        n: n,
    };
}

fn fromTile(arena: &Arena, tm: TileMap): Loaded {
    let m = Map { tiles: tm.layer.cells, w: tm.layer.w, h: tm.layer.h };
    let cap = 32;
    if tm.n_mark > cap {
        cap = tm.n_mark;
    }
    let spawns = arena.alloc::<Spawn>(cap);
    let n = 0;
    let i = 0;
    while i < tm.n_mark {
        let mk = tm.marks[i];
        let who = Actor.Enemy;
        if mk.tag == MARK_PLAYER {
            who = Actor.Player;
        }
        if mk.tag == MARK_KEY {
            who = Actor.Key;
        }
        if mk.tag == MARK_STAIR {
            who = Actor.Stair;
        }
        if mk.tag == MARK_ENEMY {
            who = Actor.Enemy;
        }
        n = pushSpawn(spawns, n, who, mk.x, mk.y);
        i += 1;
    }
    return Loaded { map: m, spawns: spawns, n: n };
}

fn tryRead(arena: &Arena, path: string): []u8 {
    match io.readFile(path, arena) {
        Result.Ok(b) {
            return b;
        }
        Result.Err(_) {
            return arena.alloc::<u8>(0);
        }
    }
}

pub fn tryAuthored(arena: &Arena): Loaded {
    let none = Loaded {
        map: Map { tiles: arena.alloc::<u8>(0), w: 0, h: 0 },
        spawns: arena.alloc::<Spawn>(0),
        n: 0,
    };
    let b = tryRead(arena, "assets/room.tile");
    if b.len == 0 {
        b = tryRead(arena, "examples/dungeon/assets/room.tile");
    }
    if b.len == 0 {
        b = tryRead(arena, "../examples/dungeon/assets/room.tile");
    }
    if b.len == 0 {
        return none;
    }
    return fromTile(arena, tile.parse(arena, b));
}

pub fn parse(arena: &Arena, bytes: []u8): Loaded {
    let w = 0;
    let h = 0;
    let col = 0;
    let i = 0;
    let ch: u8 = 0;
    while i < bytes.len {
        ch = bytes[i];
        if ch == 10 {
            if col > w {
                w = col;
            }
            if col > 0 {
                h += 1;
            }
            col = 0;
        } else if ch != 13 {
            col += 1;
        }
        i += 1;
    }
    if col > 0 {
        if col > w {
            w = col;
        }
        h += 1;
    }
    if w < 1 || h < 1 {
        panic("empty map");
    }

    let tiles = arena.alloc::<u8>(w * h);
    i = 0;
    while i < tiles.len {
        tiles[i] = FLOOR;
        i += 1;
    }

    let cap = 32;
    let spawns = arena.alloc::<Spawn>(cap);
    let n = 0;
    let x = 0;
    let y = 0;
    i = 0;
    while i < bytes.len {
        ch = bytes[i];
        if ch == 10 {
            if x > 0 {
                y += 1;
            }
            x = 0;
        } else if ch != 13 {
            if y < h && x < w {
                let t: u8 = FLOOR;
                if ch == 35 {
                    t = WALL;
                }
                if ch == 68 {
                    t = DOOR;
                }
                let pos = Vec2 {
                    x: f32(x * TILE + 2),
                    y: f32(y * TILE + 2),
                };
                if ch == 64 && n < cap {
                    spawns[n] = Spawn { pos: pos, who: Actor.Player };
                    n += 1;
                }
                if ch == 69 && n < cap {
                    spawns[n] = Spawn { pos: pos, who: Actor.Enemy };
                    n += 1;
                }
                if ch == 75 && n < cap {
                    spawns[n] = Spawn { pos: pos, who: Actor.Key };
                    n += 1;
                }
                if ch == 62 && n < cap {
                    spawns[n] = Spawn { pos: pos, who: Actor.Stair };
                    n += 1;
                }
                tiles[y * w + x] = t;
            }
            x += 1;
        }
        i += 1;
    }

    return Loaded {
        map: Map { tiles: tiles, w: w, h: h },
        spawns: spawns,
        n: n,
    };
}
