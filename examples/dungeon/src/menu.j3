// Title / pause / win / die. Runs once per painted frame so edge input is safe.

module dungeon.menu;

use dungeon.world.{ SC_DEAD, SC_PAUSE, SC_PLAY, SC_TITLE, SC_WIN, World, continueRun, enterFloor, newRun };
use j3.game;
use j3.math.clamp;
use j3.rand.Rng;

fn goPlay(w: &World) {
    game.play(w.art.ui);
    if w.scenes.is(SC_PAUSE) {
        w.scenes.pop();
        return;
    }
    if w.saved > 0 {
        continueRun(w);
        return;
    }
    newRun(w);
}

pub fn menu(w: &World, dt: f32) {
    w.time = w.time + dt;
    let wheel = game.mouseWheel();
    if wheel != 0 {
        w.cam.zoom = clamp(w.cam.zoom + wheel * 0.15, 1, 3.5);
    }
    if game.keyPressed(game.Key.F3) {
        w.stats.shown = !w.stats.shown;
    }

    if w.scenes.is(SC_TITLE) {
        if game.keyPressed(game.Key.Enter) || game.keyPressed(game.Key.Space) || game.padPressed(0, game.Pad.Start) {
            goPlay(w);
        }
        if w.saved > 0 && game.keyPressed(game.Key.N) {
            game.play(w.art.ui);
            newRun(w);
        }
        if game.keyPressed(game.Key.Escape) || game.keyPressed(game.Key.Q) {
            game.requestQuit();
        }
        return;
    }

    if w.scenes.is(SC_PLAY) {
        if game.keyPressed(game.Key.Escape) || game.keyPressed(game.Key.P) || game.padPressed(0, game.Pad.Start) {
            game.play(w.art.ui);
            w.scenes.push(SC_PAUSE);
        }
        return;
    }

    if w.scenes.is(SC_PAUSE) {
        if game.keyPressed(game.Key.Escape) || game.keyPressed(game.Key.P) || game.keyPressed(game.Key.Enter) {
            goPlay(w);
        }
        if game.keyPressed(game.Key.Q) {
            game.requestQuit();
        }
        return;
    }

    if w.scenes.is(SC_WIN) {
        if game.keyPressed(game.Key.Enter) || game.keyPressed(game.Key.Space) {
            game.play(w.art.ui);
            w.rng = Rng.new(int(w.time * 1000) + 1);
            w.saved = 0;
            enterFloor(w, 0);
            w.scenes.replace(SC_PLAY);
        }
        if game.keyPressed(game.Key.Escape) || game.keyPressed(game.Key.Q) {
            game.requestQuit();
        }
        return;
    }

    if w.scenes.is(SC_DEAD) {
        if game.keyPressed(game.Key.Enter) || game.keyPressed(game.Key.Space) {
            game.play(w.art.ui);
            enterFloor(w, w.floor);
            w.scenes.replace(SC_PLAY);
        }
        if game.keyPressed(game.Key.Escape) {
            w.scenes.replace(SC_TITLE);
        }
        if game.keyPressed(game.Key.Q) {
            game.requestQuit();
        }
    }
}
