// Systems are functions. Filter with `column.has(e)`. Flush Commands last.

module dungeon.sys;

use dungeon.map.{ FLOORS, TILE, WALL, DOOR, unlockDoors };
use dungeon.world.{ Note, SC_DEAD, SC_PLAY, SC_WIN, World, close, damage, enterFloor, remember };
use j3.collide.{ overlapRad, slide };
use j3.game;
use j3.math.{ Vec2, abs, sign };

const WALK: f32 = 96;
const CHASE: f32 = 42;
const THINK: f32 = 0.7;

pub fn begin(w: &World, dt: f32) {
    if w.scenes.is(SC_PLAY) {
        w.game_time = w.game_time + dt;
    }
}

pub fn after(w: &World, dt: f32) {
    w.fx.tick(dt);
    w.stats.sample(w.ecs.len());
}

pub fn tick(w: &World, dt: f32) {
    if !w.scenes.is(SC_PLAY) {
        return;
    }
    cooldown(w, dt);
    walk(w, dt);
    think(w, dt);
    roam(w, dt);
    bump(w);
    grab(w);
    camera(w);
    w.cmds.flush(&w.ecs);
}

fn cooldown(w: &World, dt: f32) {
    if !w.hero.has(w.player) {
        return;
    }
    let h = w.hero.at(w.player);
    if h.hurt > 0 {
        h.hurt = h.hurt - dt;
    }
    if h.swing > 0 {
        h.swing = h.swing - dt;
    }
}

fn stick(): Vec2 {
    let x: f32 = 0;
    let y: f32 = 0;
    if game.keyDown(game.Key.Left) || game.keyDown(game.Key.A) || game.padDown(0, game.Pad.Left) {
        x = x - 1;
    }
    if game.keyDown(game.Key.Right) || game.keyDown(game.Key.D) || game.padDown(0, game.Pad.Right) {
        x = x + 1;
    }
    if game.keyDown(game.Key.Up) || game.keyDown(game.Key.W) || game.padDown(0, game.Pad.Up) {
        y = y - 1;
    }
    if game.keyDown(game.Key.Down) || game.keyDown(game.Key.S) || game.padDown(0, game.Pad.Down) {
        y = y + 1;
    }
    x = x + game.padAxis(0, game.Axis.LeftX);
    y = y + game.padAxis(0, game.Axis.LeftY);
    if x != 0 && y != 0 {
        x = x * 0.7071;
        y = y * 0.7071;
    }
    return Vec2 { x: x, y: y };
}

fn walk(w: &World, dt: f32) {
    if !w.ecs.isAlive(w.player) || !w.hero.has(w.player) {
        return;
    }
    let spr = w.sprite.at(w.player);
    let dir = stick();
    let p = slide(
        w.pos.get(w.player),
        dir,
        WALK,
        spr.size,
        dt,
        w.map.tiles,
        w.map.w,
        w.map.h,
        TILE,
        WALL,
        DOOR,
    );
    w.pos.insert(w.player, p);
    if dir.x != 0 || dir.y != 0 {
        spr.timer = spr.timer + dt;
        spr.frame = int(spr.timer * 8);
        if spr.frame >= spr.frames {
            spr.frame = spr.frame - (spr.frame / spr.frames) * spr.frames;
        }
    }
    let h = w.hero.at(w.player);
    if h.swing <= 0 && (game.keyDown(game.Key.Space) || game.padDown(0, game.Pad.A)) {
        h.swing = 0.28;
        spr.frame = 3;
        game.play(w.art.swing);
        w.fx.burst(p, 8, 90);
        swing(w, p);
    }
}

fn swing(w: &World, at: Vec2) {
    let hits = w.enemy.matching2(&w.ecs, w.pos.mask, w.pos.gen);
    for i in 0..hits.len {
        let e = hits[i];
        if overlapRad(w.pos.get(e), 8, at, 14) {
            if damage(w, e, 1) {
                game.play(w.art.hit);
                w.cmds.despawn(e);
            } else {
                game.play(w.art.hit);
            }
        }
    }
}

fn think(w: &World, dt: f32) {
    if !w.ecs.isAlive(w.player) {
        return;
    }
    let pp = w.pos.get(w.player);
    let see = f32(7 * TILE);
    let hits = w.enemy.matching2(&w.ecs, w.hunt.mask, w.hunt.gen);
    for i in 0..hits.len {
        let e = hits[i];
        let ai = w.hunt.at(e);
        ai.wait = ai.wait - dt;
        let p = w.pos.get(e);
        let dx = pp.x - p.x;
        let dy = pp.y - p.y;
        let d = Vec2 { x: 0, y: 0 };
        if abs(dx) < see && abs(dy) < see {
            d.x = sign(dx);
            d.y = sign(dy);
            if abs(dx) < 4 {
                d.x = 0;
            }
            if abs(dy) < 4 {
                d.y = 0;
            }
        } else if ai.wait <= 0 {
            ai.wait = THINK;
            let r = w.rng.intRange(0, 5);
            if r == 1 {
                d.x = -1;
            }
            if r == 2 {
                d.x = 1;
            }
            if r == 3 {
                d.y = -1;
            }
            if r == 4 {
                d.y = 1;
            }
        } else if w.vel.has(e) {
            d = w.vel.get(e);
        }
        w.vel.insert(e, d);
    }
}

fn roam(w: &World, dt: f32) {
    let hits = w.enemy.matching2(&w.ecs, w.vel.mask, w.vel.gen);
    for i in 0..hits.len {
        let e = hits[i];
        let spr = w.sprite.at(e);
        let d = w.vel.get(e);
        let p = slide(w.pos.get(e), d, CHASE, spr.size, dt, w.map.tiles, w.map.w, w.map.h, TILE, WALL, DOOR);
        w.pos.insert(e, p);
        if d.x != 0 || d.y != 0 {
            spr.timer = spr.timer + dt;
            spr.frame = int(spr.timer * 6);
            if spr.frame >= spr.frames {
                spr.frame = spr.frame - (spr.frame / spr.frames) * spr.frames;
            }
        }
    }
}

fn bump(w: &World) {
    if !w.ecs.isAlive(w.player) || !w.hero.has(w.player) {
        return;
    }
    let h = w.hero.at(w.player);
    if h.hurt > 0 {
        return;
    }
    let pp = w.pos.get(w.player);
    let hits = w.enemy.matching(&w.ecs);
    for i in 0..hits.len {
        let e = hits[i];
        if close(w.pos.get(e), pp, 14) {
            h.hurt = 0.65;
            game.play(w.art.hurt);
            if damage(w, w.player, 1) {
                w.scenes.replace(SC_DEAD);
                w.notes.send(Note.Die);
            }
            return;
        }
    }
}

fn grab(w: &World) {
    if !w.ecs.isAlive(w.player) || !w.hero.has(w.player) {
        return;
    }
    let pp = w.pos.get(w.player);
    let hits = w.pos.matching(&w.ecs);
    for i in 0..hits.len {
        let e = hits[i];
        if e == w.player {
            continue;
        }
        if w.key.has(e) && close(w.pos.get(e), pp, 14) {
            let h = w.hero.at(w.player);
            h.keys = h.keys + 1;
            unlockDoors(&w.map);
            game.play(w.art.pickup);
            w.cmds.despawn(e);
        }
        if w.stair.has(e) && close(w.pos.get(e), pp, 14) {
            if w.scenes.is(SC_PLAY) {
                if w.floor + 1 >= FLOORS {
                    w.scenes.replace(SC_WIN);
                    remember(w);
                    w.notes.send(Note.Win);
                    game.play(w.art.win);
                } else {
                    enterFloor(w, w.floor + 1);
                    game.play(w.art.pickup);
                    return;
                }
            }
        }
    }
}

fn camera(w: &World) {
    if !w.ecs.isAlive(w.player) {
        return;
    }
    let p = w.pos.get(w.player);
    let spr = w.sprite.get(w.player);
    let mid = spr.size / f32(2);
    w.cam.follow(
        Vec2 { x: p.x + mid, y: p.y + mid },
        game.windowSize(),
        f32(w.map.w * TILE),
        f32(w.map.h * TILE),
    );
}
