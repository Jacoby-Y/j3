// Shared `j3.data.assets` cache. Prefixes cover run-from-pkg and run-from-repo.

module dungeon.assets;

use dungeon.world.World;
use j3.game;
use j3.data.save;

pub fn start(w: &World) {
    w.bag.addRoot("assets/");
    w.bag.addRoot("examples/dungeon/assets/");
    w.bag.addRoot("../examples/dungeon/assets/");
    w.art.tiles = w.bag.texture("tiles.png");
    w.art.actors = w.bag.texture("actors.png");
    w.art.font = w.bag.font("font.ttf", 18);
    w.art.swing = w.bag.sound("swing.wav");
    w.art.hit = w.bag.sound("hit.wav");
    w.art.pickup = w.bag.sound("pickup.wav");
    w.art.hurt = w.bag.sound("hurt.wav");
    w.art.win = w.bag.sound("win.wav");
    w.art.ui = w.bag.sound("ui.wav");
    w.art.theme = w.bag.music("theme.wav");
    game.setVolume(96);
    game.setMusicVolume(40);
    game.playMusic(w.art.theme);
    w.art.ready = true;
    let s = save.load("dungeon.save", w.mem);
    w.best.put(save.getInt(&s, "best", 0));
    w.saved = save.getInt(&s, "floor", 0);
    let played = save.getFloat(&s, "time", 0);
    let tag = save.getStr(&s, "tag", "");
    let mark = save.getBlob(&s, "mark");
    if played < 0 || tag.len > 64 || mark.len > 8 {
        w.saved = 0;
    }
}
