// Tiles and actors from a sheet; HUD / menus via TTF.

module dungeon.draw;

use dungeon.map.{ TILE, at };
use dungeon.world.{
    SC_DEAD, SC_PAUSE, SC_PLAY, SC_TITLE, SC_WIN, World, continueRun, enterFloor, newRun,
};
use j3.game;
use j3.math.{ Vec2, clampi };
use j3.rand.Rng;
use j3.ui.Ui;

pub fn frame(w: &World) {
    game.clearTo(game.rgb(12, 10, 16));
    tiles(w);
    sprites(w);
    w.fx.drawCam(w.cam);
    hud(w);
    overlay(w);
    w.stats.overlay(w.art.font);
}

fn tiles(w: &World) {
    let view = game.windowSize();
    let z = w.cam.zoom;
    if z < 0.01 {
        z = 0.01;
    }
    let tw = TILE;
    let x0 = clampi(int(w.cam.pos.x / f32(tw)) - 1, 0, w.map.w);
    let y0 = clampi(int(w.cam.pos.y / f32(tw)) - 1, 0, w.map.h);
    let visx = int(view.x / z / f32(tw)) + 3;
    let visy = int(view.y / z / f32(tw)) + 3;
    let x1 = clampi(x0 + visx, 0, w.map.w);
    let y1 = clampi(y0 + visy, 0, w.map.h);
    let sheet = w.art.tiles;
    let ty = y0;
    while ty < y1 {
        let tx = x0;
        while tx < x1 {
            let t = at(&w.map, tx, ty);
            let dest = Vec2 { x: f32(tx * tw), y: f32(ty * tw) };
            if sheet.raw != 0 {
                game.drawTextureSrcCam(
                    w.cam,
                    sheet,
                    Vec2 { x: f32(int(t) * 16), y: 0 },
                    Vec2 { x: 16, y: 16 },
                    dest,
                    Vec2 { x: f32(tw), y: f32(tw) },
                );
            } else {
                if t == 0 {
                    game.setColor(game.rgb(36, 32, 44));
                }
                if t == 1 {
                    game.setColor(game.rgb(70, 78, 98));
                }
                if t == 2 {
                    game.setColor(game.rgb(120, 70, 40));
                }
                if t == 3 {
                    game.setColor(game.rgb(48, 42, 56));
                }
                game.drawRectCam(w.cam, dest, Vec2 { x: f32(tw) - 1, y: f32(tw) - 1 });
            }
            tx += 1;
        }
        ty += 1;
    }
}

fn sprites(w: &World) {
    let sheet = w.art.actors;
    let hits = w.sprite.matching2(&w.ecs, w.pos.mask, w.pos.gen);
    for i in 0..hits.len {
        let e = hits[i];
        let s = w.sprite.get(e);
        let p = w.pos.get(e);
        if w.hero.has(e) {
            let h = w.hero.get(e);
            if h.hurt > 0 && int(h.hurt * 10) - (int(h.hurt * 10) / 2) * 2 != 0 {
                continue;
            }
        }
        let fr = s.frame;
        if fr < 0 {
            fr = 0;
        }
        if fr > 3 {
            fr = 3;
        }
        if sheet.raw != 0 {
            game.drawTextureSrcCam(
                w.cam,
                sheet,
                Vec2 { x: f32(fr * 16), y: f32(s.row * 16) },
                Vec2 { x: 16, y: 16 },
                p,
                Vec2 { x: s.size, y: s.size },
            );
        } else {
            game.setColor(game.rgb(240, 220, 90));
            game.drawRectCam(w.cam, p, Vec2 { x: s.size, y: s.size });
        }
    }
}

fn hud(w: &World) {
    if w.scenes.is(SC_TITLE) {
        return;
    }
    let hp = 0;
    let max = 0;
    if w.hp.has(w.player) {
        let h = w.hp.get(w.player);
        hp = h.n;
        max = h.max;
    }
    let i = 0;
    while i < max {
        if i < hp {
            game.setColor(game.rgb(200, 50, 60));
        } else {
            game.setColor(game.rgb(50, 24, 28));
        }
        game.drawRect(Vec2 { x: f32(12 + i * 18), y: 8 }, Vec2 { x: 14, y: 10 });
        i += 1;
    }
    if w.hero.has(w.player) {
        let hero = w.hero.get(w.player);
        if hero.keys > 0 {
            game.setColor(game.rgb(230, 190, 60));
            game.drawRect(Vec2 { x: 12, y: 24 }, Vec2 { x: 10, y: 10 });
        }
    }
    if w.art.font.raw != 0 {
        game.setColor(game.rgb(200, 200, 210));
        game.drawText(w.art.font, Vec2 { x: 12, y: 36 }, "floor");
    }
}

fn overlay(w: &World) {
    if w.scenes.is(SC_PLAY) {
        return;
    }
    let ui = Ui.begin(w.art.font, 200, 110);
    if w.scenes.is(SC_TITLE) {
        game.setColor(game.rgba(8, 6, 12, 180));
        game.drawRect(Vec2 { x: 0, y: 0 }, game.windowSize());
        ui.label("DUNGEON");
        if w.saved > 0 {
            if ui.button(`continue floor {w.saved}`) {
                game.play(w.art.ui);
                continueRun(w);
            }
            if ui.button("n new run") {
                game.play(w.art.ui);
                newRun(w);
            }
        } else {
            if ui.button("enter to descend") {
                game.play(w.art.ui);
                newRun(w);
            }
        }
        ui.label("wasd  space swing");
        ui.label("esc pause   q quit");
        return;
    }
    if w.scenes.is(SC_PAUSE) {
        game.setColor(game.rgba(8, 6, 12, 160));
        game.drawRect(Vec2 { x: 0, y: 0 }, game.windowSize());
        ui.y = 130;
        ui.label("paused");
        if ui.button("resume") {
            w.scenes.pop();
            game.play(w.art.ui);
        }
        ui.label("q quit");
        return;
    }
    if w.scenes.is(SC_WIN) {
        game.setColor(game.rgba(10, 30, 20, 180));
        game.drawRect(Vec2 { x: 0, y: 0 }, game.windowSize());
        ui.y = 130;
        ui.label("you escaped");
        if ui.button("play again") {
            game.play(w.art.ui);
            w.rng = Rng.new(int(w.time * 1000) + 1);
            w.saved = 0;
            enterFloor(w, 0);
            w.scenes.replace(SC_PLAY);
        }
        ui.label("esc quit");
        return;
    }
    if w.scenes.is(SC_DEAD) {
        game.setColor(game.rgba(40, 8, 10, 180));
        game.drawRect(Vec2 { x: 0, y: 0 }, game.windowSize());
        ui.y = 130;
        ui.label("you died");
        if ui.button("retry") {
            game.play(w.art.ui);
            enterFloor(w, w.floor);
            w.scenes.replace(SC_PLAY);
        }
        ui.label("esc title");
    }
}
