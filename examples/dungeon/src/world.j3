// Data model. An entity is whatever columns you insert.
// Markers (`enemy`, `key`, `stair`) are just `has(e)`.

module dungeon.world;

use dungeon.map.{ Actor, Map, Spawn, generate, tryAuthored };
use j3.assets.Assets;
use j3.collide.overlapRad;
use j3.debug.Stats;
use j3.ecs.{ Column, Commands, Ecs, Entity, Events };
use j3.fx.Particles;
use j3.game.{ Camera, Font, Music, Sound, Texture };
use j3.math.Vec2;
use j3.memory.Arena;
use j3.rand.Rng;
use j3.res.Slot;
use j3.save;
use j3.scene.Scenes;

pub enum Note {
    Win,
    Die,
    Floor,
}

pub const SC_TITLE: int = 1;
pub const SC_PLAY: int = 2;
pub const SC_PAUSE: int = 3;
pub const SC_WIN: int = 4;
pub const SC_DEAD: int = 5;

pub struct Hp {
    n: int;
    max: int;
}

pub struct Sprite {
    row: int;
    frame: int;
    frames: int;
    timer: f32;
    size: f32;
}

pub struct Hero {
    hurt: f32;
    swing: f32;
    keys: int;
}

pub struct Hunt {
    wait: f32;
}

pub struct Art {
    tiles: Texture;
    actors: Texture;
    font: Font;
    swing: Sound;
    hit: Sound;
    pickup: Sound;
    hurt: Sound;
    win: Sound;
    ui: Sound;
    theme: Music;
    ready: bool;
}

pub struct World {
    mem: &Arena;
    ecs: Ecs;
    pos: Column<Vec2>;
    vel: Column<Vec2>;
    hp: Column<Hp>;
    sprite: Column<Sprite>;
    hero: Column<Hero>;
    hunt: Column<Hunt>;
    enemy: Column<u8>;
    key: Column<u8>;
    stair: Column<u8>;
    cmds: Commands;
    notes: Events<Note>;
    map: Map;
    player: Entity;
    cam: Camera;
    scenes: Scenes;
    rng: Rng;
    art: Art;
    bag: Assets;
    fx: Particles;
    stats: Stats;
    best: Slot<int>;
    saved: int;
    floor: int;
    time: f32;
    game_time: f32;
}

fn emptyTex(): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

fn emptySnd(): Sound {
    return Sound { raw: 0 };
}

fn emptyMus(): Music {
    return Music { raw: 0 };
}

pub fn close(a: Vec2, b: Vec2, r: f32): bool {
    return overlapRad(a, r / 2, b, r / 2);
}

pub fn damage(w: &World, e: Entity, n: int): bool {
    if !w.hp.has(e) {
        return false;
    }
    let h = w.hp.at(e);
    h.n = h.n - n;
    if h.n < 0 {
        h.n = 0;
    }
    return h.n <= 0;
}

fn spr(row: int, size: f32): Sprite {
    return Sprite {
        row: row,
        frame: 0,
        frames: 4,
        timer: 0,
        size: size,
    };
}

pub fn spawnPlayer(w: &World, p: Vec2): Entity {
    let e = w.cmds.spawn(&w.ecs);
    w.pos.insert(e, p);
    w.hp.insert(e, Hp { n: 6, max: 6 });
    w.sprite.insert(e, spr(0, 12));
    w.hero.insert(e, Hero { hurt: 0, swing: 0, keys: 0 });
    w.player = e;
    return e;
}

pub fn spawnEnemy(w: &World, p: Vec2): Entity {
    let e = w.cmds.spawn(&w.ecs);
    let hp = 2 + w.floor / 3;
    w.pos.insert(e, p);
    w.vel.insert(e, Vec2 { x: 0, y: 0 });
    w.hp.insert(e, Hp { n: hp, max: hp });
    w.sprite.insert(e, spr(1, 12));
    w.hunt.insert(e, Hunt { wait: 0 });
    w.enemy.insert(e, 1);
    return e;
}

pub fn spawnKey(w: &World, p: Vec2): Entity {
    let e = w.cmds.spawn(&w.ecs);
    w.pos.insert(e, p);
    w.sprite.insert(e, spr(2, 10));
    w.key.insert(e, 1);
    return e;
}

pub fn spawnStair(w: &World, p: Vec2): Entity {
    let e = w.cmds.spawn(&w.ecs);
    w.pos.insert(e, p);
    w.sprite.insert(e, spr(3, 12));
    w.stair.insert(e, 1);
    return e;
}

fn apply(w: &World, n: int, spawns: []Spawn) {
    let i = 0;
    while i < n {
        let s = spawns[i];
        match s.who {
            Actor.Player { spawnPlayer(w, s.pos); }
            Actor.Enemy { spawnEnemy(w, s.pos); }
            Actor.Key { spawnKey(w, s.pos); }
            Actor.Stair { spawnStair(w, s.pos); }
        }
        i += 1;
    }
}

pub fn wipe(w: &World) {
    let n = w.ecs.len();
    let i = 0;
    while i < n {
        w.cmds.despawn(w.ecs.entity(i));
        i += 1;
    }
    w.cmds.flush(&w.ecs);
    w.player = Entity.none();
}

pub fn remember(w: &World) {
    if w.floor > w.best.get() {
        w.best.put(w.floor);
    }
    let s = save.empty(w.mem);
    save.putInt(&s, "best", w.best.get());
    save.putInt(&s, "floor", w.floor);
    save.store(&s, "dungeon.save");
}

pub fn continueRun(w: &World) {
    if w.saved > 0 && w.floor != w.saved {
        enterFloor(w, w.saved);
    }
    w.scenes.replace(SC_PLAY);
}

pub fn newRun(w: &World) {
    w.saved = 0;
    if w.floor != 0 {
        enterFloor(w, 0);
    }
    w.scenes.replace(SC_PLAY);
}

pub fn enterFloor(w: &World, floor: int) {
    wipe(w);
    w.floor = floor;
    remember(w);
    if floor == 0 {
        let authored = tryAuthored(w.mem);
        if authored.n > 0 && authored.map.w > 0 {
            w.map = authored.map;
            apply(w, authored.n, authored.spawns);
            w.notes.send(Note.Floor);
            return;
        }
    }
    let loaded = generate(w.mem, &w.rng, floor);
    w.map = loaded.map;
    apply(w, loaded.n, loaded.spawns);
    w.notes.send(Note.Floor);
}

pub fn boot(arena: &Arena): World {
    let rng = Rng.new(3);
    let loaded = generate(arena, &rng, 0);
    let w = World {
        mem: arena,
        ecs: Ecs.create(arena, 64),
        pos: Column<Vec2>.new(arena),
        vel: Column<Vec2>.new(arena),
        hp: Column<Hp>.new(arena),
        sprite: Column<Sprite>.new(arena),
        hero: Column<Hero>.new(arena),
        hunt: Column<Hunt>.new(arena),
        enemy: Column<u8>.new(arena),
        key: Column<u8>.new(arena),
        stair: Column<u8>.new(arena),
        cmds: Commands.new(arena),
        notes: Events<Note>.new(arena),
        map: loaded.map,
        player: Entity.none(),
        cam: Camera.create(2),
        scenes: Scenes.new(arena),
        rng: rng,
        bag: Assets.new(arena),
        fx: Particles.new(arena, 64),
        stats: Stats.fresh(),
        best: Slot<int>.none(0),
        saved: 0,
        art: Art {
            tiles: emptyTex(),
            actors: emptyTex(),
            font: Font { raw: 0 },
            swing: emptySnd(),
            hit: emptySnd(),
            pickup: emptySnd(),
            hurt: emptySnd(),
            win: emptySnd(),
            ui: emptySnd(),
            theme: emptyMus(),
            ready: false,
        },
        floor: 0,
        time: 0,
        game_time: 0,
    };
    apply(&w, loaded.n, loaded.spawns);
    w.scenes.push(SC_TITLE);
    return w;
}
