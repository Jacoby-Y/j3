// WASD / arrows / pad to walk. Space or A to swing. Esc pauses. Q quits.

module dungeon;

use dungeon.assets.start;
use dungeon.draw.frame;
use dungeon.menu.menu;
use dungeon.sys.{ after, begin, tick };
use dungeon.world.{ World, boot };
use j3.app.App;

fn main() {
    let app = App<World>.create("dungeon", 640, 360, boot);
    app.startup(start);
    app.first(begin);
    app.add(tick);
    app.last(after);
    app.always(menu);
    app.draw(frame);
    app.run();
}
