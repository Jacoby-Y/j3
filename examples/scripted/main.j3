module scripted;

// A tiny text battle: fighters and duels are scripts (scripts/*.j3s), created and driven
// from J3. `j3c run` runs the scripts on the VM and re-runs instantly after a script edit;
// `j3c build` compiles them into the binary. Both print the same thing.

use j3.io.printLn;
use j3.rand.Rng;

const Fighter = @script("scripts/fighter.j3s");
const Duel = @script("scripts/duel.j3s");

fn main() {
    let rng = Rng.new(42);
    let ada = Fighter { name: "Ada" };
    let bo = Fighter { name: "Bo", hp: 26, attack: 3 };
    let cy = Fighter { name: "Cy", attack: 6 };
    let dee = Fighter { name: "Dee", hp: 14 };
    let first = Duel { left: &ada, right: &bo, label: "north" };
    let second = Duel { left: &cy, right: &dee, label: "south" };
    let going = true;
    while going {
        let north = first.round(rng.intRange(0, 12));
        let south = second.round(rng.intRange(0, 12));
        going = north || south;
    }
    ada.report();
    bo.report();
    cy.report();
    dee.report();
}
