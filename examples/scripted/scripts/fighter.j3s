// One fighter. Each `Fighter { ... }` in main.j3 is its own copy with its own hp.
use j3.io.printLn;

props {
    name: string;
    hp: int = 20;
    attack: int = 4;
}

shared {
    // Every fighter reads and writes this one count.
    knockouts: int = 0;
}

let down = false;
let dealt = 0;
// Props are read-only, so damage goes in state.
let taken = 0;

/// Damage for one swing: the fighter's attack plus the dice roll.
pub fn strike(roll: int): int {
    if down { return 0; }
    let damage = attack + roll % 4;
    dealt += damage;
    return damage;
}

/// True when this hit knocked the fighter out.
pub fn take(damage: int): bool {
    if down { return false; }
    taken += damage;
    if taken >= hp {
        down = true;
        knockouts += 1;
        printLn(`  {name} is down ({knockouts} so far)`);
        return true;
    }
    return false;
}

pub fn standing(): bool {
    return !down;
}

pub fn report() {
    printLn(`{name}: took {taken} of {hp}, dealt {dealt}, standing {!down}`);
}
