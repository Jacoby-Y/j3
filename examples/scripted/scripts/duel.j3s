// A duel between two fighters. Scripts can use other scripts: this one holds two.
use j3.io.printLn;

const Fighter = @script("scripts/fighter.j3s");

props {
    left: &Fighter;
    right: &Fighter;
    label: string = "duel";
}

let rounds = 0;

/// One exchange of blows. Returns false once someone is down.
pub fn round(roll: int): bool {
    if !left.standing() || !right.standing() { return false; }
    rounds += 1;
    let a = left.strike(roll);
    right.take(a);
    let b = right.strike(roll / 3);
    left.take(b);
    printLn(`{label} round {rounds}: {a} and {b}`);
    return left.standing() && right.standing();
}
