// Every native function a script can call. Nothing else is reachable from j2: no files,
// no processes, no network. A native gets the VM and its arguments; `args.num(0)` and
// friends raise a script error (with the script's file:line) on a wrong type, so natives
// never check types by hand. SCRIPTING.md lists these for script writers; keep the two in step.

module j2_arena.api;

use j2_arena.world.{ World, Bullet, Enemy, Weapon, ARENA_H, ARENA_W, color };
use j3.j2;
use j3.j2.{ Args, Value, Vm };
use j3.math.Vec2;
use j3.gfx.paint;
use j3.text.{ Text, same };

pub fn bind(vm: &Vm, w: &World) {
    vm.openLibs(j2.LIB_BASE | j2.LIB_MATH | j2.LIB_STRING | j2.LIB_ARRAY);
    vm.host = w as ptr;

    vm.bind("print", print);               // (...) -> on-screen log and terminal
    vm.bind("defineEnemy", defineEnemy);   // (name, kind)
    vm.bind("defineWeapon", defineWeapon); // (name, def)
    vm.bind("spawn", spawn);               // (kind, x, y [, fields]) -> enemy, or nil when full
    vm.bind("shoot", shoot);               // (x, y, vx, vy [, dmg])
    vm.bind("enemies", enemies);           // () -> array of enemies
    vm.bind("player", player);             // () -> {x, y, hp, weapon}
    vm.bind("score", score);               // () -> int
    vm.bind("arena", arena);               // () -> {w, h}
    vm.bind("rgb", rgb);                   // (r, g, b) -> color, an int 0xRRGGBB
    vm.bind("drawText", drawText);         // (x, y, text [, color])
    vm.bind("drawCircle", drawCircle);     // (x, y, r, color)
    vm.bind("drawRect", drawRect);         // (x, y, w, h, color)
}

fn world(vm: &Vm): &World {
    return vm.host as &World;
}

fn print(vm: &Vm, args: Args): Value {
    world(vm).scripts.say(args.joined(" ")); // each argument as str() would write it
    return j2.nil();
}

fn defineEnemy(vm: &Vm, args: Args): Value {
    let kind = args.table(1);
    if vm.raised { return j2.nil(); } // a wrong argument: change nothing
    // Fields a kind may leave out.
    kind.setDefault("hp", j2.int(10));
    kind.setDefault("r", j2.int(14));
    kind.setDefault("speed", j2.int(60));
    kind.setDefault("touch", j2.int(10));
    kind.setDefault("score", j2.int(1));
    kind.setDefault("color", j2.int(0xdc5050));
    vm.get(world(vm).kinds).set(args.str(0), kind.value()); // same name again replaces it
    return j2.nil();
}

fn defineWeapon(vm: &Vm, args: Args): Value {
    let w = world(vm);
    let name = args.str(0);
    let def = args.table(1);
    def.setDefault("cooldown", j2.num(0.2));
    if def.get("onFire").isNil() {
        return vm.raise(Text.scratch().add("weapon \"").add(name).add("\" has no onFire function").str());
    }
    for i in 0..w.nWeapons {
        if same(w.weapons[i].name, name) { // same name again replaces it, key stays
            vm.release(w.weapons[i].def);
            w.weapons[i].def = vm.keep(def.value());
            return j2.nil();
        }
    }
    if w.nWeapons == w.weapons.len {
        return vm.raise(Text.scratch().add("too many weapons: keys 1-9 are taken, \"").add(name).add("\" has none").str());
    }
    w.weapons[w.nWeapons] = Weapon { name: vm.intern(name), def: vm.keep(def.value()) };
    w.nWeapons += 1;
    return j2.nil();
}

fn spawn(vm: &Vm, args: Args): Value {
    let w = world(vm);
    let name = args.str(0);
    let kind = vm.get(w.kinds).get(name);
    if kind.isNil() {
        return vm.raise(Text.scratch().add("spawn: no enemy kind \"").add(name).add("\" (defineEnemy it first)").str());
    }
    if w.nEnemies == w.enemies.len {
        return j2.nil();
    }
    // Read every argument before any side effect: a wrong one raises and must change nothing.
    let x = args.num(1);
    let y = args.num(2);
    let fields = if args.count() > 3 { args.table(3) } else { kind.asTable() };
    if vm.raised { return j2.nil(); }
    // The enemy's own table: the kind's numbers, then x/y, then the caller's fields.
    let self = vm.newTable();
    self.copyFields(kind.asTable(), ["hp", "r", "speed", "touch", "score", "color"]);
    self.set("kind", j2.str(vm, name));
    self.set("x", j2.num(x));
    self.set("y", j2.num(y));
    if args.count() > 3 {
        self.merge(fields);
    }
    w.enemies[w.nEnemies] = Enemy { kind: vm.intern(name), self: vm.keep(self.value()), alive: true };
    w.nEnemies += 1;
    w.scripts.callMethod(kind, "onSpawn", self.value(), j2.noArgs());
    return self.value();
}

fn shoot(vm: &Vm, args: Args): Value {
    let w = world(vm);
    if w.nBullets < w.bullets.len {
        w.bullets[w.nBullets] = Bullet {
            pos: Vec2 { x: f32(args.num(0)), y: f32(args.num(1)) },
            vel: Vec2 { x: f32(args.num(2)), y: f32(args.num(3)) },
            dmg: f32(args.numOr(4, 1)),
            life: 2,
        };
        w.nBullets += 1;
    }
    return j2.nil();
}

fn enemies(vm: &Vm, _args: Args): Value {
    let w = world(vm);
    let out = vm.newArray(w.nEnemies);
    for i in 0..w.nEnemies {
        if w.enemies[i].alive {
            out.push(vm.value(w.enemies[i].self));
        }
    }
    return out.value();
}

fn player(vm: &Vm, _args: Args): Value {
    let w = world(vm);
    let t = vm.newTable();
    t.set("x", j2.num(f64(w.player.x)));
    t.set("y", j2.num(f64(w.player.y)));
    t.set("hp", j2.num(f64(w.hp)));
    if w.nWeapons > 0 {
        t.set("weapon", j2.str(vm, w.weapons[w.current].name));
    }
    return t.value();
}

fn score(vm: &Vm, _args: Args): Value {
    return j2.int(world(vm).score);
}

fn arena(vm: &Vm, _args: Args): Value {
    let t = vm.newTable();
    t.set("w", j2.int(ARENA_W));
    t.set("h", j2.int(ARENA_H));
    return t.value();
}

fn rgb(_vm: &Vm, args: Args): Value {
    return j2.int((byte(args.int(0)) << 16) | (byte(args.int(1)) << 8) | byte(args.int(2)));
}

fn byte(v: int): int {
    if v < 0 { return 0; }
    if v > 255 { return 255; }
    return v;
}

fn drawText(vm: &Vm, args: Args): Value {
    let c = args.intOr(3, 0xe6e6e6);
    paint.text(world(vm).font, Vec2 { x: f32(args.num(0)), y: f32(args.num(1)) }, args.str(2), color(c));
    return j2.nil();
}

fn drawCircle(_vm: &Vm, args: Args): Value {
    paint.circle(Vec2 { x: f32(args.num(0)), y: f32(args.num(1)) }, f32(args.num(2)), color(args.int(3)));
    return j2.nil();
}

fn drawRect(_vm: &Vm, args: Args): Value {
    paint.rect(Vec2 { x: f32(args.num(0)), y: f32(args.num(1)) }, Vec2 { x: f32(args.num(2)), y: f32(args.num(3)) },
        color(args.int(4)));
    return j2.nil();
}
