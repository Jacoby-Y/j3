// J2 Arena: the host. It owns the window, the player, bullets, and collision.
// Everything else (enemy kinds, weapons, waves, HUD) comes from j2-scripts/*/main.j2,
// loaded as source at runtime: no j3c, no build step for script writers.
//
// Controls: WASD move, hold the left mouse button to shoot, 1-9 switch weapon,
// F5 reloads every script, R restarts after game over, Escape quits.
//
// ARENA_TEST=1 plays itself with a fixed seed and checks the run (arenatest.j3); exit 0 = pass.

module j2_arena;

use j2_arena.api;
use j2_arena.arenatest;
use j2_arena.arenatest.Test;
use j2_arena.world.{ World, ARENA_H, ARENA_W, color };
use j3.j2;
use j3.app.App;
use j3.game.{ Key, env, keyPressed, requestQuit, tryLoadFont };
use j3.gfx.paint;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys;
use j3.text.same;

// The app's state: the game, and the self-test's notes (unused outside ARENA_TEST).
struct Game {
    w: World;
    test: Test;
}

fn boot(mem: &Arena): Game {
    return Game { w: World.new(mem, same(env("ARENA_TEST"), "1")), test: arenatest.new() };
}

// Runs once the Game sits at its final address, so the VM can keep a pointer to it.
fn start(g: &Game) {
    let w = &g.w;
    w.font = tryLoadFont("assets/font.ttf", 15); // empty when missing: no text, no crash
    w.scripts.attach();
    api.bind(&w.scripts.vm, w);
    if w.auto {
        arenatest.start(w); // fixed seed, the broken script's root
    } else {
        w.scripts.vm.seed(sys.monotonicMs()); // different waves every run
    }
    w.reloadScripts();
}

fn input(g: &Game, _dt: f32) {
    let w = &g.w;
    if keyPressed(Key.Escape) {
        requestQuit();
    }
    if keyPressed(Key.F5) {
        w.reloadScripts();
    }
    if w.hp <= 0 && keyPressed(Key.R) {
        w.restart();
    }
}

// Fixed 60 Hz, so a run with the same seed and input plays the same.
fn update(g: &Game, dt: f32) {
    let w = &g.w;
    w.tick += 1;
    if w.scripts.changed() {
        w.reloadScripts(); // a saved .j2 reloads the scripts between ticks
        if w.auto { arenatest.reloaded(w, &g.test); }
    }
    if w.hp > 0 { // else game over: the HUD says so, R restarts
        w.movePlayer(dt);
        w.fireWeapon(dt);
        w.scripts.callAll("onTick", [j2.num(f64(dt))]);
        w.tickEnemies(dt);
        if w.auto { arenatest.ticked(w, &g.test); }
        w.moveBullets(dt);
        w.collide();
        w.reapDead();
    }
    if w.auto { arenatest.step(w, &g.test); }
}

fn draw(g: &Game) {
    let w = &g.w;
    paint.rect(Vec2 { x: 0, y: 0 }, Vec2 { x: f32(ARENA_W), y: f32(ARENA_H) }, color(0x12141c));
    w.drawEnemies();
    w.drawBullets();
    w.drawPlayer();
    w.scripts.callAll("onDraw", j2.noArgs()); // HUD and effects from scripts
    w.scripts.drawLog(w.font);                // print() output and script errors, bottom left
}

fn main() {
    let app = App<Game>.create("j2 arena", ARENA_W, ARENA_H, boot);
    app.useGl();
    app.startup(start);
    app.always(input);
    app.add(update);
    app.draw(draw);
    app.run();
}
