// turrets: drones that orbit the player and shoot the nearest enemy.
// They level up every 15 kills and you get a second one at wave 3.
// Shows: a "class" as a function returning a table with methods, closures that keep
// state, arrays of tables, match, and the array helpers map and join.

use base;

const ORBIT = 48;

// A constructor: each call makes a new table; its methods take `this`.
fn Turret(angle) {
    return {
        angle: angle,
        cool: 0.0,
        level: 1,

        pos: fn(this) {
            let p = player();
            return {
                x: p.x + math.cos(this.angle) * ORBIT,
                y: p.y + math.sin(this.angle) * ORBIT,
            };
        },

        update: fn(this, dt) {
            this.angle += dt * 1.5;
            this.cool -= dt;
            if this.cool > 0 {
                return;
            }
            let p = this.pos();          // `this` binds: p is this turret's position
            let target = nearest(p);
            if target == nil {
                return;
            }
            let d = base.aim(p.x, p.y, target.x, target.y);
            shoot(p.x, p.y, d.x * 500, d.y * 500, 1 + this.level);
            match this.level {
                1 { this.cool = 0.8; }
                2 { this.cool = 0.5; }
                _ { this.cool = 0.3; }
            }
        },

        draw: fn(this) {
            let p = this.pos();
            drawCircle(p.x, p.y, 5 + this.level, rgb(180, 140, 255));
        },
    };
}

fn nearest(from) {
    let best = nil;
    let bestD = 1e9;
    for e in enemies() {
        let dx = e.x - from.x;
        let dy = e.y - from.y;
        let d = dx * dx + dy * dy;
        if d < bestD {
            best = e;
            bestD = d;
        }
    }
    return best;
}

// A closure with its own counter: each call to `every(n)` makes an independent one.
fn every(n) {
    let count = 0;
    return fn() {
        count += 1;
        return count % n == 0;
    };
}

let levelUpCheck = every(15);
let turrets = [Turret(0)];

pub fn onTick(dt) {
    if len(turrets) == 1 && base.currentWave() >= 3 {
        turrets.push(Turret(math.pi));
        print("turrets: a second drone joins");
    }
    for t in turrets {
        t.update(dt);
    }
}

pub fn onKill(enemy) {
    if levelUpCheck() {
        for t in turrets {
            t.level = math.min(t.level + 1, 3);
        }
        let levels = turrets.map(fn(t) { return t.level; }).join(", ");
        print(`turrets: level up ({levels})`);
    }
}

pub fn onDraw() {
    for t in turrets {
        t.draw();
    }
}
