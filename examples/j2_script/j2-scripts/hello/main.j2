// The smallest script. Copy this folder, rename it, save: the game picks it up.
//
// A top-level `let` is this script's own. A `pub fn` is a hook the game calls
// (onStart, onTick, onDraw, onKill) and what other scripts see with `use hello;`.

let kills = 0;

pub fn onStart() {
    print("hello script loaded");
}

pub fn onKill(enemy) {
    kills += 1;
    if kills % 10 == 0 {
        print(`{kills} kills! the last was a {enemy.kind}`);
    }
}
