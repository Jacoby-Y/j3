// slimes: an enemy that hops and splits in two when it dies.
// Shows: `use` of another script, per-enemy fields, enemy hooks, spawn overrides, nil fields.

use base;

const GREEN = rgb(90, 210, 120);
const FLASH = rgb(220, 255, 220);
const MIN_R = 8;

defineEnemy("slime", {
    hp: 12,
    r: 20,
    speed: 45,
    score: 2,
    color: GREEN,

    // Runs once per new enemy, after overrides. Fields can be added freely.
    onSpawn: fn(this) {
        this.t = rand(0, 6.28);
    },

    onTick: fn(this, dt) {
        // Hop: move in pulses by scaling the time step with a sine.
        this.t += dt * 6;
        base.chase(this, dt * (0.3 + math.abs(math.sin(this.t))));

        if this.flash != nil {
            this.flash -= dt;
            if this.flash <= 0 {
                this.flash = nil;   // setting a field to nil removes it
                this.color = GREEN;
            }
        }
    },

    // The game already took the damage off hp; this is for effects.
    onHit: fn(this, dmg) {
        this.color = FLASH;
        this.flash = 0.08;
    },

    onDeath: fn(this) {
        let r = this.r * 0.6;
        if r < MIN_R {
            return;
        }
        for i in 0..2 {
            // The 4th argument overrides the kind's defaults for this one enemy.
            spawn("slime", this.x + rand(-10, 10), this.y + rand(-10, 10), {
                r: r,
                hp: 5,
                speed: this.speed * 1.3,
                score: 1,
            });
        }
    },
});

base.addSpawner({
    name: "slime",
    cost: 3,
    minWave: 2,
    make: fn(x, y) { spawn("slime", x, y); },
});
