// base: the game's own content, written as a script like any other.
// Weapons, the grunt, waves, and the HUD. Other scripts build on it with `use base;`.

const SPEED = 600;

// ---- helpers other scripts use ----

// Unit vector from (x, y) toward (ax, ay).
pub fn aim(x, y, ax, ay) {
    let dx = ax - x;
    let dy = ay - y;
    let d = math.sqrt(dx * dx + dy * dy);
    if d < 0.001 {
        return { x: 1, y: 0 };
    }
    return { x: dx / d, y: dy / d };
}

// Walk an enemy toward the player at its own speed.
pub fn chase(e, dt) {
    let p = player();
    let d = aim(e.x, e.y, p.x, p.y);
    e.x += d.x * e.speed * dt;
    e.y += d.y * e.speed * dt;
}

// ---- weapons (keys 1, 2, ... in the order they're defined) ----

defineWeapon("pistol", {
    cooldown: 0.18,
    // No `this` parameter: called as a plain function.
    onFire: fn(x, y, ax, ay) {
        let d = aim(x, y, ax, ay);
        shoot(x, y, d.x * SPEED, d.y * SPEED, 4);
    },
});

defineWeapon("shotgun", {
    cooldown: 0.7,
    pellets: 7,
    spread: 0.5,
    // First parameter named `this`: it is the weapon table, so the numbers above are tunable.
    onFire: fn(this, x, y, ax, ay) {
        let center = math.atan2(ay - y, ax - x);
        for i in 0..this.pellets {
            // int / int drops the fraction; float() keeps it, so t runs 0.0 .. 1.0.
            let t = float(i) / (this.pellets - 1);
            let a = center + (t - 0.5) * this.spread;
            shoot(x, y, math.cos(a) * SPEED, math.sin(a) * SPEED, 2);
        }
    },
});

// ---- enemies ----

defineEnemy("grunt", {
    hp: 8,
    r: 13,
    speed: 90,
    color: rgb(220, 90, 90),
    onTick: fn(this, dt) {
        chase(this, dt);
    },
});

// ---- waves ----

let spawners = [];   // { name, cost, minWave, make: fn(x, y) }
let wave = 0;
let pause = 1.0;    // seconds until the next wave

// Other scripts add their enemies to the wave pool through this.
pub fn addSpawner(s) {
    spawners.push(s);   // same as push(spawners, s)
}

pub fn currentWave() {
    return wave;
}

addSpawner({
    name: "grunt",
    cost: 1,
    minWave: 1,
    make: fn(x, y) { spawn("grunt", x, y); },
});

// A random point just outside one edge of the arena.
fn edgePoint() {
    let a = arena();
    match int(rand(0, 4)) {
        0 { return { x: rand(0, a.w), y: -20 }; }
        1 { return { x: rand(0, a.w), y: a.h + 20 }; }
        2 { return { x: -20, y: rand(0, a.h) }; }
        _ { return { x: a.w + 20, y: rand(0, a.h) }; }
    }
}

pub fn onTick(dt) {
    if len(enemies()) > 0 {
        return;
    }
    pause -= dt;
    if pause > 0 {
        return;
    }
    wave += 1;
    pause = 1.0;
    let budget = 1 + wave * 2;
    let pool = spawners.filter(fn(s) { return s.minWave <= wave; });
    while budget > 0 {
        let s = pool.pick();   // a random element
        let at = edgePoint();
        s.make(at.x, at.y);    // a field holding a fn with no `this`: a plain call
        budget -= s.cost;
    }
}

// ---- HUD ----

pub fn onDraw() {
    let p = player();
    drawRect(12, 12, 200, 10, rgb(60, 20, 20));
    drawRect(12, 12, 2 * math.clamp(p.hp, 0, 100), 10, rgb(220, 60, 60));
    drawText(12, 30, `wave {wave}   score {score()}   {p.weapon}`);
    if p.hp <= 0 {
        drawText(470, 330, "game over  (R restarts)", rgb(255, 120, 120));
        return;
    }
    if len(enemies()) == 0 && pause > 0 {
        drawText(480, 330, `wave {wave + 1} in {math.ceil(pause)}`, rgb(255, 220, 120));
    }
}
