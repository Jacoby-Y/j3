# Plants bending in the wind. The bend grows with the square of the height above `base`,
# so the ground end stays put and the tips move most. It only depends on the world
# position, so separate meshes at the same height (corn leaves on a stalk) move together.
kind=material
# World height of the ground the plants stand on.
param.base=float:0
# Height that bends by `strength` (world units); higher bends more.
param.height=float:1
# How far that height leans, in world units.
param.strength=float:0.08
# Wind direction in degrees around y (0 blows toward +x).
param.angle=float:30
param.speed=float:1
---
#ifdef J3_VERTEX
vec3 displace(vec3 pos, vec3 normal) {
  float h = max(pos.y - uFx_base, 0.0) / max(uFx_height, 0.01);
  float bend = h * h * uFx_strength;
  float a = radians(uFx_angle);
  vec2 dir = vec2(cos(a), sin(a));
  float t = uTime * uFx_speed;
  float along = dot(pos.xz, dir);
  // Gusts roll across the field along the wind; between them the plants settle.
  float gust = 0.55 + 0.45 * sin(along * 0.3 - t * 1.1);
  // Two waves at unrelated rates and a phase from position, so it never visibly repeats
  // and neighbours move a little apart.
  float sway = 0.7 * sin(t * 1.9 - along * 0.9 + pos.z * 0.37) + 0.3 * sin(t * 3.1 + pos.x * 0.53);
  float push = bend * gust * (0.6 + sway);
  float side = bend * 0.3 * sin(t * 2.3 + pos.x * 0.71 + pos.z * 0.29);
  pos.xz += dir * push + vec2(-dir.y, dir.x) * side;
  // Leaning shortens the plant a little, so tips don't stretch.
  pos.y -= (push * push + side * side) * 0.5 / max(pos.y - uFx_base, 0.05);
  return pos;
}
#else
vec3 effect(Surface s, vec3 lit) {
  return lit;
}
#endif
