// In-game settings: render quality (URP on/off, bounces, samples, traced shadows),
// shadow and view distance, the sun's height and direction, and walking feel.
// The panel shows on Tab or Esc and frees the mouse while it's open.

module editor_village.settings;

use j3.game;
use j3.game.{ Font, rgb };
use j3.math.{ Vec2, Vec3, clamp, cos, sin, lerp };
use j3.memory.scratch;
use j3.scene3d;
use j3.scene3d.{ Env, Scene };
use j3.text.{ Text, cstr, same };

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}
use j3.ui.Ui;

pub struct Settings {
    urp: bool;
    bounces: int;
    samples: int;
    tracedShadows: bool;
    /// Traced shadows stop this far away; the shadow map covers the rest (0: no limit).
    traceNear: f32;
    shadows: bool;
    /// Half size of the sun's shadow box around the player; smaller is sharper.
    shadowRange: f32;
    viewDistance: f32;
    /// Degrees above the horizon, and around from +z.
    sunHeight: f32;
    sunTurn: f32;
    fov: f32;
    sensitivity: f32;
    walkSpeed: f32;
    open: bool;
    quit: bool;
    /// Smoothed frames per second.
    fps: f32;
}

pub fn defaults(): Settings {
    let s = Settings {
        urp: true, bounces: 2, samples: 1, tracedShadows: false, traceNear: 40, shadows: true, shadowRange: 45,
        viewDistance: 260, sunHeight: 33, sunTurn: 57, fov: 70, sensitivity: 1, walkSpeed: 4.5,
        open: false, quit: false, fps: 60,
    };
    preset(&s);
    return s;
}

/// Quality presets.
fn low(s: &Settings) {
    s.urp = false;
    s.shadows = true;
    s.shadowRange = 35;
    s.viewDistance = 160;
}

fn medium(s: &Settings) {
    s.urp = true;
    s.bounces = 1;
    s.samples = 1;
    s.tracedShadows = false;
    s.shadows = true;
    s.shadowRange = 45;
    s.viewDistance = 220;
}

fn high(s: &Settings) {
    s.urp = true;
    s.bounces = 2;
    s.samples = 2;
    s.tracedShadows = false;
    s.shadows = true;
    s.shadowRange = 55;
    s.viewDistance = 300;
}

fn ultra(s: &Settings) {
    s.urp = true;
    s.bounces = 4;
    s.samples = 4;
    s.tracedShadows = true;
    s.traceNear = 100;
    s.shadows = true;
    s.shadowRange = 70;
    s.viewDistance = 400;
}

/// `VILLAGE_PRESET` (low, medium, high, ultra, traced) for headless benchmarks.
fn preset(s: &Settings) {
    let raw = libc.getenv(cstr("VILLAGE_PRESET"));
    if raw == 0 { return; }
    let name = []u8 { ptr: raw as &u8, len: libc.strlen(raw) } as string;
    if same(name, "low") { low(s); }
    if same(name, "medium") { medium(s); }
    if same(name, "high") { high(s); }
    if same(name, "ultra") { ultra(s); }
    if same(name, "traced") { s.tracedShadows = true; }
}

/// `VILLAGE_POND` is set: start at the pond (reflection benchmark).
pub fn pondView(): bool { return libc.getenv(cstr("VILLAGE_POND")) != 0; }

/// Direction toward the sun.
pub fn sunDir(s: &Settings): Vec3 {
    let up = s.sunHeight * 0.017453292;
    let around = s.sunTurn * 0.017453292;
    return Vec3.xyz(cos(up) * sin(around), sin(up), cos(up) * cos(around));
}

fn mix(a: Vec3, b: Vec3, t: f32): Vec3 {
    return Vec3.xyz(lerp(a.x, b.x, t), lerp(a.y, b.y, t), lerp(a.z, b.z, t));
}

/// The scene lighting these settings give: a low sun is orange and dims the sky.
pub fn environment(s: &Settings, scene: &Scene): Env {
    let env = scene3d.environment(scene);
    let day = clamp(s.sunHeight / 45, 0, 1);
    let dusk = clamp((s.sunHeight + 4) / 12, 0, 1);
    env.sunDir = sunDir(s);
    env.sunColor = mix(Vec3.xyz(1.0, 0.45, 0.22), Vec3.xyz(1.0, 0.93, 0.84), day) * dusk;
    env.sky = mix(mix(Vec3.xyz(0.1, 0.1, 0.18), Vec3.xyz(0.78, 0.55, 0.5), dusk), Vec3.xyz(0.62, 0.74, 0.88), day);
    env.fogEnd = s.viewDistance;
    env.fogStart = s.viewDistance * 0.3;
    env.shadows = s.shadows;
    env.shadowSize = s.shadowRange;
    env.urp = s.urp;
    env.bounces = s.bounces;
    env.samples = s.samples;
    env.tracedShadows = s.tracedShadows;
    env.traceNear = s.traceNear;
    return env;
}

/// Tab or Esc opens and closes the panel; the mouse is captured while it's closed.
pub fn input(s: &Settings, dt: f32) {
    if dt > 0 { s.fps = lerp(s.fps, 1 / dt, 0.05); }
    if game.keyPressed(game.Key.Tab) || game.keyPressed(game.Key.Escape) {
        s.open = !s.open;
    }
    let want = !s.open;
    if game.mouseCaptured() != want { game.captureMouse(want); }
}

fn line(ui: &Ui, head: string, n: f32) {
    let t = Text.new(scratch(0));
    t.pushStr(head);
    t.pushInt(int(n + 0.5));
    ui.label(t.str());
}

pub fn panel(s: &Settings, font: Font) {
    if font.raw == 0 { return; }
    let win = game.windowSize();
    if !s.open {
        game.setColor(rgb(255, 255, 255));
        game.drawText(font, Vec2 { x: 14, y: win.y - 30 }, "WASD walk  Shift run  Space jump  Tab settings");
        return;
    }
    let ui = Ui.begin(font, 16, 16);
    ui.panel(330, win.y - 32);
    ui.labelBold("Village settings");
    line(&ui, "FPS ", s.fps);
    let st = game.frameStats();
    let t = Text.new(scratch(0));
    t.pushStr("draws ");
    t.pushInt(st.draws);
    t.pushStr("  tris ");
    t.pushInt(st.tris);
    t.pushStr("  cpu ");
    t.pushInt(int(st.cpuMs + 0.5));
    t.pushStr(" ms  (F3: profiler)");
    ui.label(t.str());
    ui.scroll(1, win.y - 120);
    ui.labelBold("Quality");
    ui.row();
    if ui.button("Low") { low(s); }
    if ui.button("Medium") { medium(s); }
    if ui.button("High") { high(s); }
    if ui.button("Ultra") { ultra(s); }
    ui.end();
    ui.toggle("URP ray tracing", &s.urp);
    ui.stepper("Ray bounces", &s.bounces, 1, 6);
    ui.stepper("Samples per pixel", &s.samples, 1, 8);
    ui.toggle("Traced sun shadows", &s.tracedShadows);
    ui.slider("Traced shadow distance", &s.traceNear, 0, 200);
    ui.toggle("Shadow map", &s.shadows);
    ui.slider("Shadow range", &s.shadowRange, 15, 120);
    ui.slider("View distance", &s.viewDistance, 80, 500);
    ui.rule();
    ui.labelBold("Sun");
    ui.slider("Height", &s.sunHeight, -6, 85);
    ui.slider("Direction", &s.sunTurn, 0, 360);
    ui.row();
    if ui.button("Morning") { s.sunHeight = 12; s.sunTurn = 95; }
    if ui.button("Noon") { s.sunHeight = 68; s.sunTurn = 170; }
    if ui.button("Sunset") { s.sunHeight = 5; s.sunTurn = 265; }
    ui.end();
    ui.rule();
    ui.labelBold("Camera");
    ui.slider("Field of view", &s.fov, 50, 100);
    ui.slider("Mouse speed", &s.sensitivity, 0.2, 3);
    ui.slider("Walk speed", &s.walkSpeed, 2, 12);
    ui.rule();
    if ui.button("Back to the village") { s.open = false; }
    if ui.button("Quit") { s.quit = true; }
    ui.end();
    ui.end();
}
