module editor_village;

use editor_village.behaviors;
use editor_village.settings;
use editor_village.settings.Settings;
use j3.app.App;
use j3.scene3d.fpwalk;
use j3.scene3d.fpwalk.Walker;
use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.Scene;

struct World {
    scene: Scene;
    walker: Walker;
    settings: Settings;
    font: Font;
    mem: &Arena;
}

fn boot(mem: &Arena): World {
    let scene = scene3d.load(behaviors.scene(), mem);
    return World { scene: scene, walker: fpwalk.spawn(&scene, mem), settings: settings.defaults(),
        font: Font { raw: 0 }, mem: mem };
}

fn startup(w: &World) {
    gfx.init();
    scene3d.upload(&w.scene);
    // Colliders need the meshes' bounds, which upload fills in.
    w.walker = fpwalk.spawn(&w.scene, w.mem);
    // Small plants and crops are walked through; trees keep only a trunk.
    fpwalk.walkThrough(&w.walker, "grass");
    fpwalk.walkThrough(&w.walker, "flower");
    fpwalk.walkThrough(&w.walker, "crops_");
    fpwalk.walkThrough(&w.walker, "plant_bush");
    fpwalk.walkThrough(&w.walker, "campfire");
    fpwalk.walkThrough(&w.walker, "mushroom");
    // The pond is a flattened cylinder; walk into it rather than along a wall.
    fpwalk.walkThrough(&w.walker, "builtin:cylinder");
    fpwalk.trunks(&w.walker, "tree", 0.2);
    // `VILLAGE_POND=1` starts looking at the pond, a benchmark for traced reflections.
    if settings.pondView() { w.walker.pos = Vec3.xyz(60, 0, 67); w.walker.yaw = 0; w.walker.pitch = -0.6; }
    w.font = game.loadFont("assets/font.ttf", 16);
    game.captureMouse(true);
    let i = 0;
    while i < w.scene.len {
        behaviors.start(&w.scene, w.scene.nodes[i].id);
        i += 1;
    }
}

fn update(w: &World, dt: f32) {
    settings.input(&w.settings, dt);
    if w.settings.quit { game.requestQuit(); }
    fpwalk.update(&w.walker, dt, !w.settings.open, w.settings.sensitivity, w.settings.walkSpeed);
    let i = 0;
    while i < w.scene.len {
        behaviors.update(&w.scene, w.scene.nodes[i].id, dt);
        i += 1;
    }
}

fn draw(w: &World) {
    let s = &w.settings;
    let env = settings.environment(s, &w.scene);
    // ponytail: rewrites the scene's lighting lines every frame; only on change if it shows up in a profile.
    scene3d.setEnvironment(&w.scene, env);
    scene3d.drawFrame(&w.scene, fpwalk.look(&w.walker), env, s.fov);
    settings.panel(s, w.font);
}

fn main() {
    let app = App<World>.create("Village", 1280, 720, boot);
    app.useGl();
    app.startup(startup);
    app.always(update);
    app.draw(draw);
    app.run();
}
