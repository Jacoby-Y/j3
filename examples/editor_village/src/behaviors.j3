// Generated by j3c editor. Edit behavior modules instead.
module editor_village.behaviors;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}

use j3.scene3d;
use j3.scene3d.Scene;
use j3.text.{ cstr, same };
use editor_village.behaviors.spin;

/// The scene set in j3.editor.toml.
pub const MAIN_SCENE: string = "scenes/village.j3scene";

/// The scene to run: the one the editor's Play picked (`J3_SCENE`), else `MAIN_SCENE`.
pub fn scene(): string {
    let raw = libc.getenv(cstr("J3_SCENE"));
    if raw == 0 { return MAIN_SCENE; }
    let len = libc.strlen(raw);
    if len < 1 { return MAIN_SCENE; }
    return []u8 { ptr: raw as &u8, len: len } as string;
}

pub fn start(scene: &Scene, id: int) {
    let at = scene3d.index(scene, id);
    if at < 0 { return; }
    let name = scene.nodes[at].behavior;
    if same(name, "spin") { spin.start(scene, id); return; }
}

pub fn update(scene: &Scene, id: int, dt: f32) {
    let at = scene3d.index(scene, id);
    if at < 0 { return; }
    let name = scene.nodes[at].behavior;
    if same(name, "spin") { spin.update(scene, id, dt); return; }
}
