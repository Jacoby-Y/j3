// Spill store for chunks the player changed. The world regenerates from the seed, so only chunks
// that differ are kept: an open-addressing table from chunk key to a copy of its cells.
// data/save.j3 will persist this table.

module mini_voxel.world.edits;

use j3.memory.Arena;
use mini_voxel.config.{ CHUNK, CSZ, EDIT_SLOTS, TOP_SLOTS };
use mini_voxel.util.grid.{ fdiv, fmod };

pub struct Edits {
    keys: []int; // -1 = empty
    blobs: []u8; // EDIT_SLOTS * CSZ
    topKeys: []int; // -1 = empty; per edited column
    tops: []u8; // TOP_SLOTS * CHUNK * CHUNK surface heights, in voxels
}

pub fn create(mem: &Arena): Edits {
    let e = Edits {
        keys: mem.alloc::<int>(EDIT_SLOTS),
        blobs: mem.alloc::<u8>(EDIT_SLOTS * CSZ),
        topKeys: mem.alloc::<int>(TOP_SLOTS),
        tops: mem.alloc::<u8>(TOP_SLOTS * CHUNK * CHUNK),
    };
    let i = 0;
    while i < EDIT_SLOTS { e.keys[i] = -1; i += 1; }
    i = 0;
    while i < TOP_SLOTS { e.topKeys[i] = -1; i += 1; }
    return e;
}

/// Key of a chunk. Coordinates must stay within +-1,000,000 chunks.
pub fn key(cx: int, cy: int, cz: int): int {
    return ((cx + 1048576) * 2097152 + (cz + 1048576)) * 8 + cy;
}

// Slot holding `k`, or the empty slot where it would go; -1 when the table is full.
fn find(e: &Edits, k: int): int {
    let i = k % EDIT_SLOTS;
    let n = 0;
    while n < EDIT_SLOTS {
        if e.keys[i] == k || e.keys[i] == -1 { return i; }
        i = (i + 1) % EDIT_SLOTS;
        n += 1;
    }
    return -1;
}

/// Remember the CSZ cells at `cells[base..]` under `k`.
pub fn store(e: &Edits, k: int, cells: []u8, base: int) {
    let i = find(e, k);
    if i < 0 { return; } // ponytail: full table drops the edit; grow EDIT_SLOTS or spill to disk
    e.keys[i] = k;
    let j = 0;
    while j < CSZ { e.blobs[i * CSZ + j] = cells[base + j]; j += 1; }
}

/// Copy the cells stored under `k` into `cells[base..]`. False when there are none.
pub fn load(e: &Edits, k: int, cells: []u8, base: int): bool {
    let i = find(e, k);
    if i < 0 || e.keys[i] != k { return false; }
    let j = 0;
    while j < CSZ { cells[base + j] = e.blobs[i * CSZ + j]; j += 1; }
    return true;
}

fn colKey(cx: int, cz: int): int {
    return (cx + 1048576) * 2097152 + (cz + 1048576);
}

// Slot of column `k` in the tops table, or the empty slot where it would go; -1 when full.
fn findTop(e: &Edits, k: int): int {
    let i = k % TOP_SLOTS;
    let n = 0;
    while n < TOP_SLOTS {
        if e.topKeys[i] == k || e.topKeys[i] == -1 { return i; }
        i = (i + 1) % TOP_SLOTS;
        n += 1;
    }
    return -1;
}

/// Remember the surface heights (CHUNK * CHUNK, row = z) of column (cx, cz).
pub fn setTops(e: &Edits, cx: int, cz: int, heights: []u8) {
    let k = colKey(cx, cz);
    let i = findTop(e, k);
    if i < 0 { return; } // ponytail: full table keeps the generated far view for later columns
    e.topKeys[i] = k;
    let j = 0;
    while j < CHUNK * CHUNK { e.tops[i * CHUNK * CHUNK + j] = heights[j]; j += 1; }
}

/// Surface height in voxels at world column (x, z) if its column was edited, else -1.
pub fn topAt(e: &Edits, x: int, z: int): int {
    let i = findTop(e, colKey(fdiv(x, CHUNK), fdiv(z, CHUNK)));
    if i < 0 || e.topKeys[i] != colKey(fdiv(x, CHUNK), fdiv(z, CHUNK)) { return -1; }
    return int(e.tops[i * CHUNK * CHUNK + fmod(z, CHUNK) * CHUNK + fmod(x, CHUNK)]);
}
