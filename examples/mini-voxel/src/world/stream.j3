// Schedulers for the full-resolution ring: which columns to generate and which chunks to mesh,
// nearest first, within a time budget. The ring is at most NEAR columns, so a scan is cheap.

module mini_voxel.world.stream;

use j3.gfx;
use j3.math.absi;
use mini_voxel.config.{ CY, D };
use mini_voxel.gen.column;
use mini_voxel.render.lod;
use mini_voxel.render.lod.Lod;
use mini_voxel.render.mesher;
use mini_voxel.render.mesher.Mesher;
use mini_voxel.util.spiral.Spiral;
use mini_voxel.util.time;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

/// Write the surface table of every edited column and mark the LOD tiles over it stale, so the far
/// view shows the change. Cheap when nothing was edited.
pub fn syncEdits(c: &Chunks, l: &Lod) {
    let s = 0;
    while s < D * D {
        if c.colOk[s] && c.colEdit[s] {
            c.colEdit[s] = false;
            chunks.recomputeTops(c, c.colX[s], c.colZ[s]);
            lod.invalidate(l, c.colX[s], c.colZ[s]);
        }
        s += 1;
    }
}

/// What the schedulers last did, so a frame where nothing changed costs nothing: a stage that found
/// no work stays done until the player's column, the view, or the world (chunk or LOD version)
/// changes.
pub struct Sched {
    x: int;
    z: int;
    view: int;
    ver: int;
    lodVer: int;
    genDone: bool;
    meshDone: bool;
    lodDone: bool;
}

pub fn sched(): Sched {
    return Sched { x: 0, z: 0, view: 0, ver: -1, lodVer: -1, genDone: false, meshDone: false, lodDone: false };
}

/// Clear the done flags when anything the stages depend on changed since the last frame.
pub fn watch(s: &Sched, pcx: int, pcz: int, view: int, ver: int, lodVer: int) {
    if s.x != pcx || s.z != pcz || s.view != view || s.ver != ver || s.lodVer != lodVer {
        s.x = pcx; s.z = pcz; s.view = view; s.ver = ver; s.lodVer = lodVer;
        s.genDone = false; s.meshDone = false; s.lodDone = false;
    }
}

/// Generate unloaded columns within `radius` (a square) of (pcx, pcz), nearest first, until
/// `deadline` (0: all). At least one if any is missing. `order` is a `util/spiral.j3` list at least
/// that large. Returns true when nothing is left to generate.
pub fn generate(c: &Chunks, order: &Spiral, pcx: int, pcz: int, radius: int, deadline: int): bool {
    let n = 0;
    while n == 0 || time.within(deadline) {
        let bx = 0; let bz = 0; let found = false;
        let i = 0;
        while i < order.n {
            let dx = order.dx[i]; let dz = order.dz[i];
            if absi(dx) <= radius && absi(dz) <= radius && !chunks.colLoaded(c, pcx + dx, pcz + dz) {
                bx = pcx + dx; bz = pcz + dz; found = true;
                break;
            }
            i += 1;
        }
        if !found { return true; }
        column.gen(c, bx, bz);
        n += 1;
    }
    return false;
}

/// A chunk can be meshed once its four side neighbours are loaded; before that its border faces
/// would be wrong. Meshes dirty chunks within `near` columns (a square), nearest first, until
/// `deadline` (0: all). Returns true when nothing is left to mesh. GL work.
pub fn remesh(c: &Chunks, m: &Mesher, order: &Spiral, pcx: int, pcz: int, near: int, deadline: int): bool {
    let n = 0;
    while n == 0 || time.within(deadline) {
        let bx = 0; let by = 0; let bz = 0; let found = false;
        let i = 0;
        while i < order.n && !found {
            let dx = order.dx[i]; let dz = order.dz[i];
            let cx = pcx + dx; let cz = pcz + dz;
            if absi(dx) <= near && absi(dz) <= near && chunks.colLoaded(c, cx, cz) && chunks.colLoaded(c, cx - 1, cz)
                && chunks.colLoaded(c, cx + 1, cz) && chunks.colLoaded(c, cx, cz - 1) && chunks.colLoaded(c, cx, cz + 1) {
                let cy = 0;
                while cy < CY {
                    if c.dirty[chunks.slotOf(cx, cz) * CY + cy] { bx = cx; by = cy; bz = cz; found = true; }
                    cy += 1;
                }
            }
            i += 1;
        }
        if !found { return true; }
        let ci = chunks.slotOf(bx, bz) * CY + by;
        c.dirty[ci] = false;
        c.built[ci] = true;
        if c.meshes[ci].vao != 0 { gfx.free(&c.meshes[ci]); }
        c.meshes[ci] = mesher.meshChunk(m, c, bx, by, bz);
        n += 1;
    }
    return false;
}
