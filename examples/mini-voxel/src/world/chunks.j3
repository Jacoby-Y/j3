// Chunk storage: a ring of column slots, each CY chunks of CSZ cells. A slot holds one column at
// a time and is overwritten when a new column needs it. Cells are indexed like `voxel.index`
// with sx = sz = CHUNK.

module mini_voxel.world.chunks;

use j3.gfx;
use j3.gfx.Mesh;
use j3.gfx.voxel;
use j3.memory.Arena;
use mini_voxel.config.{ CHUNK, CSZ, CY, D, SY };
use mini_voxel.util.grid.{ fdiv, fmod };
use mini_voxel.world.edits;
use mini_voxel.world.edits.Edits;

pub struct Chunks {
    cells: []u8; // D * D * CY chunks of CSZ cells
    meshes: []Mesh; // per chunk
    dirty: []bool; // per chunk
    solid: []int; // per chunk: nonzero cell count, 0 skips meshing
    colX: []int; // per slot: which column it holds
    colZ: []int;
    colOk: []bool;
    built: []bool; // per chunk: has been meshed at least once (a dirty chunk keeps drawing its old mesh)
    edited: []bool; // per chunk: differs from the generator
    edits: Edits;
    colEdit: []bool; // per slot: edited since its surface table was last written
    topsBuf: []u8; // CHUNK * CHUNK scratch for recomputeTops
    version: int; // bumped by anything the schedulers react to
}

pub fn create(mem: &Arena): Chunks {
    let nchunks = D * D * CY;
    let c = Chunks {
        cells: mem.alloc::<u8>(nchunks * CSZ),
        meshes: mem.alloc::<Mesh>(nchunks),
        dirty: mem.alloc::<bool>(nchunks),
        solid: mem.alloc::<int>(nchunks),
        colX: mem.alloc::<int>(D * D),
        colZ: mem.alloc::<int>(D * D),
        colOk: mem.alloc::<bool>(D * D),
        built: mem.alloc::<bool>(nchunks),
        edited: mem.alloc::<bool>(nchunks),
        edits: edits.create(mem),
        colEdit: mem.alloc::<bool>(D * D),
        topsBuf: mem.alloc::<u8>(CHUNK * CHUNK),
        version: 0,
    };
    let i = 0;
    while i < nchunks { c.meshes[i] = Mesh {}; c.dirty[i] = false; c.solid[i] = 0; c.built[i] = false; c.edited[i] = false; i += 1; }
    i = 0;
    while i < D * D { c.colOk[i] = false; c.colEdit[i] = false; i += 1; }
    return c;
}

pub fn slotOf(cx: int, cz: int): int {
    return fmod(cz, D) * D + fmod(cx, D);
}

pub fn colLoaded(c: &Chunks, cx: int, cz: int): bool {
    let s = slotOf(cx, cz);
    return c.colOk[s] && c.colX[s] == cx && c.colZ[s] == cz;
}

/// First cell of a chunk in `cells`.
pub fn chunkBase(slot: int, cy: int): int {
    return (slot * CY + cy) * CSZ;
}

/// World cell; 0 (air) above, below and outside the loaded columns.
pub fn cellAt(c: &Chunks, x: int, y: int, z: int): u8 {
    if y < 0 || y >= SY { return 0; }
    let cx = fdiv(x, CHUNK);
    let cz = fdiv(z, CHUNK);
    if !colLoaded(c, cx, cz) { return 0; }
    let at = chunkBase(slotOf(cx, cz), y / CHUNK) + voxel.index(fmod(x, CHUNK), y % CHUNK, fmod(z, CHUNK), CHUNK, CHUNK);
    return c.cells[at];
}

pub fn markChunk(c: &Chunks, cx: int, cy: int, cz: int) {
    if cy < 0 || cy >= CY || !colLoaded(c, cx, cz) { return; }
    c.dirty[slotOf(cx, cz) * CY + cy] = true;
}

/// Write one cell, keep the chunk's solid count, and flag the chunk (and a neighbour when the
/// cell is on the shared face, since that neighbour's faces change too).
pub fn setCell(c: &Chunks, x: int, y: int, z: int, id: u8) {
    if y < 0 || y >= SY { return; }
    let cx = fdiv(x, CHUNK);
    let cz = fdiv(z, CHUNK);
    if !colLoaded(c, cx, cz) { return; }
    let s = slotOf(cx, cz);
    let cy = y / CHUNK;
    let lx = fmod(x, CHUNK); let ly = y % CHUNK; let lz = fmod(z, CHUNK);
    let at = chunkBase(s, cy) + voxel.index(lx, ly, lz, CHUNK, CHUNK);
    let old = c.cells[at];
    if old == id { return; }
    if old != 0 { c.solid[s * CY + cy] -= 1; }
    if id != 0 { c.solid[s * CY + cy] += 1; }
    c.cells[at] = id;
    c.dirty[s * CY + cy] = true;
    c.edited[s * CY + cy] = true;
    c.colEdit[s] = true;
    c.version += 1;
    if lx == 0 { markChunk(c, cx - 1, cy, cz); }
    if lx == CHUNK - 1 { markChunk(c, cx + 1, cy, cz); }
    if ly == 0 { markChunk(c, cx, cy - 1, cz); }
    if ly == CHUNK - 1 { markChunk(c, cx, cy + 1, cz); }
    if lz == 0 { markChunk(c, cx, cy, cz - 1); }
    if lz == CHUNK - 1 { markChunk(c, cx, cy, cz + 1); }
}

/// Take the slot for column (cx, cz): free whatever it held, clear its cells, flag its chunks.
/// Returns the slot. Fill it with `put`, then call `finish`. Needs GL (frees meshes).
pub fn claim(c: &Chunks, cx: int, cz: int): int {
    let s = slotOf(cx, cz);
    let cy = 0;
    while cy < CY {
        let ci = s * CY + cy;
        let base = chunkBase(s, cy);
        if c.edited[ci] && c.colOk[s] { edits.store(&c.edits, edits.key(c.colX[s], cy, c.colZ[s]), c.cells, base); }
        c.edited[ci] = false;
        c.built[ci] = false;
        if c.meshes[ci].vao != 0 { gfx.free(&c.meshes[ci]); }
        c.meshes[ci] = Mesh {};
        c.solid[ci] = 0;
        c.dirty[ci] = true;
        let i = 0;
        while i < CSZ { c.cells[base + i] = 0; i += 1; }
        cy += 1;
    }
    c.colOk[s] = false;
    c.version += 1;
    return s;
}

/// Write a cell of a claimed slot (column-local x, z; y over the whole column).
pub fn put(c: &Chunks, slot: int, lx: int, y: int, lz: int, id: u8) {
    c.cells[chunkBase(slot, y / CHUNK) + voxel.index(lx, y % CHUNK, lz, CHUNK, CHUNK)] = id;
    c.solid[slot * CY + y / CHUNK] += 1;
}

/// Like `put`, but leaves an occupied cell alone (trees overlap each other and the ground).
pub fn putIfAir(c: &Chunks, slot: int, lx: int, y: int, lz: int, id: u8) {
    if c.cells[chunkBase(slot, y / CHUNK) + voxel.index(lx, y % CHUNK, lz, CHUNK, CHUNK)] == 0 { put(c, slot, lx, y, lz, id); }
}

/// Mark the slot's column loaded, then put back any edits the player made to it earlier.
pub fn finish(c: &Chunks, cx: int, cz: int) {
    let s = slotOf(cx, cz);
    c.colX[s] = cx; c.colZ[s] = cz; c.colOk[s] = true;
    c.version += 1;
    let cy = 0;
    while cy < CY {
        let base = chunkBase(s, cy);
        if edits.load(&c.edits, edits.key(cx, cy, cz), c.cells, base) {
            let n = 0;
            let i = 0;
            while i < CSZ { if c.cells[base + i] != 0 { n += 1; } i += 1; }
            c.solid[s * CY + cy] = n;
            c.edited[s * CY + cy] = true;
        }
        cy += 1;
    }
}

/// True when the column is loaded and every chunk of it has a mesh (possibly empty).
pub fn columnMeshed(c: &Chunks, cx: int, cz: int): bool {
    if !colLoaded(c, cx, cz) { return false; }
    let s = slotOf(cx, cz);
    let cy = 0;
    while cy < CY {
        if !c.built[s * CY + cy] { return false; }
        cy += 1;
    }
    return true;
}

pub fn loadedColumns(c: &Chunks): int {
    let n = 0;
    let i = 0;
    while i < D * D { if c.colOk[i] { n += 1; } i += 1; }
    return n;
}

pub fn meshVerts(c: &Chunks): int {
    let n = 0;
    let i = 0;
    while i < D * D * CY { n += c.meshes[i].count; i += 1; }
    return n;
}

/// Bytes of cell storage in the ring.
pub fn cellBytes(): int {
    return D * D * CY * CSZ;
}

/// Rewrite the surface-height table of a loaded column from its cells: the highest solid voxel + 1,
/// 0 for an empty column. This is what LOD tiles show of the player's edits.
pub fn recomputeTops(c: &Chunks, cx: int, cz: int) {
    let s = slotOf(cx, cz);
    let lz = 0;
    while lz < CHUNK {
        let lx = 0;
        while lx < CHUNK {
            let y = SY - 1;
            while y >= 0 && c.cells[chunkBase(s, y / CHUNK) + voxel.index(lx, y % CHUNK, lz, CHUNK, CHUNK)] == 0 { y -= 1; }
            c.topsBuf[lz * CHUNK + lx] = u8(y + 1);
            lx += 1;
        }
        lz += 1;
    }
    edits.setTops(&c.edits, cx, cz, c.topsBuf);
}
