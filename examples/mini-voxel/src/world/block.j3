// Block ids and how they look. New blocks go here.

module mini_voxel.world.block;

use j3.math.Vec3;
use mini_voxel.gen.noise;

pub const AIR: u8 = 0;
pub const DIRT: u8 = 1;
pub const GRASS: u8 = 2;
pub const SAND: u8 = 3;
pub const SNOW: u8 = 4;
pub const TAIGA: u8 = 5;
pub const FOREST: u8 = 6;
pub const SAVANNA: u8 = 7;
pub const JUNGLE: u8 = 8;
pub const LOG: u8 = 9;
pub const LEAVES: u8 = 10;
pub const ROCK: u8 = 11;
pub const WATER: u8 = 12;

/// Block under a surface block: sand stays sand, everything else is dirt.
pub fn under(id: u8): u8 {
    if id == SAND { return SAND; }
    if id == ROCK { return ROCK; }
    return DIRT;
}

// Base colour of a block (the far-view colour).
fn base(id: u8, out: &Vec3) {
    out.x = 0.48; out.y = 0.33; out.z = 0.18; // dirt
    if id == GRASS { out.x = 0.28; out.y = 0.61; out.z = 0.16; }
    if id == SAND { out.x = 0.85; out.y = 0.78; out.z = 0.52; }
    if id == SNOW { out.x = 0.93; out.y = 0.95; out.z = 0.98; }
    if id == TAIGA { out.x = 0.20; out.y = 0.46; out.z = 0.30; }
    if id == FOREST { out.x = 0.17; out.y = 0.45; out.z = 0.12; }
    if id == SAVANNA { out.x = 0.62; out.y = 0.60; out.z = 0.22; }
    if id == JUNGLE { out.x = 0.10; out.y = 0.55; out.z = 0.10; }
    if id == LOG { out.x = 0.36; out.y = 0.24; out.z = 0.12; }
    if id == LEAVES { out.x = 0.14; out.y = 0.42; out.z = 0.10; }
    if id == ROCK { out.x = 0.40; out.y = 0.43; out.z = 0.45; }
    if id == WATER { out.x = 0.12; out.y = 0.38; out.z = 0.66; }
}

/// Flat colour of a block, no per-voxel variation. Far terrain uses this.
pub fn flat(id: u8, out: &Vec3) {
    base(id, out);
}

/// Colour of the voxel at a world cell: the flat colour plus a small per-voxel variation.
pub fn tint(id: u8, x: int, y: int, z: int, out: &Vec3) {
    base(id, out);
    let v = (noise.rnd(x, z, 5 + y) - 0.5) * 0.12;
    out.x += v;
    out.y += v;
    out.z += v * 0.5;
}
