// Ground cover follows elevation: submerged sand, beach, grass, then exposed stone.

module mini_voxel.gen.biome;

use mini_voxel.gen.terrain;
use mini_voxel.world.block;

/// Ground surface at a column. The height bands create a continuous beach and a broad grassy
/// transition before the mountain turns rocky.
pub fn surfaceAt(x: int, z: int): u8 {
    let h = terrain.heightAt(x, z);
    if h <= terrain.SEA + 5 { return block.SAND; }
    if h >= 92 { return block.ROCK; }
    return block.GRASS;
}
