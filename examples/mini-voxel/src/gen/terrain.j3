// One island in an ocean. Every height depends only on world coordinates, so columns can be
// generated in any order and distant LOD tiles see the same coastline as nearby chunks.

module mini_voxel.gen.terrain;

use j3.math.sqrt;
use mini_voxel.gen.noise;
use mini_voxel.world.edits;
use mini_voxel.world.edits.Edits;

pub const SEA: int = 32;

/// Ground height in cells. Low frequency noise bends the shore; finer noise roughens the inland
/// hills and summit. Beyond the island, the seabed stays below sea level.
pub fn heightAt(x: int, z: int): int {
    let fx = f32(x); let fz = f32(z);
    let r = sqrt(fx * fx + fz * fz);
    let shore = (noise.fbm(fx + 3100.0, fz - 1700.0, 0.0018, 3) - 0.5) * 260.0;
    let d = (r + shore) / 1250.0;
    if d < 0.0 { d = 0.0; }
    let land = 1.0 - d;
    if land < 0.0 { land = 0.0; }
    let peak = 1.0 - d / 0.48;
    if peak < 0.0 { peak = 0.0; }
    let detail = noise.fbm(fx, fz, 0.013, 4) - 0.47;
    let h = 12.0 + land * 100.0 + peak * peak * 70.0 + detail * (4.0 + land * 24.0);
    if h < 5.0 { h = 5.0; }
    if h > 180.0 { h = 180.0; }
    return int(h);
}

/// Surface height at a column as the far view should show it: the player's edits if that column
/// was edited (`world/edits.j3`), else the generated height.
pub fn surfaceAt(e: &Edits, x: int, z: int): int {
    let t = edits.topAt(e, x, z);
    if t >= 0 { return t; }
    return heightAt(x, z);
}
