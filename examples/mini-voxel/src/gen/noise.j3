// Deterministic hash and value noise. No state: any coordinate can be sampled alone.

module mini_voxel.gen.noise;

use j3.math.floor;

pub fn hash(x: int, z: int, seed: int): int {
    let h = (x * 374761393 + z * 668265263 + seed * 1274126177) % 2147483647;
    if h < 0 { h = -h; }
    h = (h * 48271 + 11) % 2147483647;
    h = (h * 48271 + 11) % 2147483647;
    return h % 65536;
}

pub fn rnd(x: int, z: int, seed: int): f32 {
    return f32(hash(x, z, seed)) / 65536.0;
}

fn smooth(t: f32): f32 {
    return t * t * (3.0 - 2.0 * t);
}

pub fn valueNoise(x: f32, z: f32, seed: int): f32 {
    let ix = int(floor(x));
    let iz = int(floor(z));
    let fx = smooth(x - f32(ix));
    let fz = smooth(z - f32(iz));
    let a = rnd(ix, iz, seed);
    let b = rnd(ix + 1, iz, seed);
    let c = rnd(ix, iz + 1, seed);
    let d = rnd(ix + 1, iz + 1, seed);
    let top = a + (b - a) * fx;
    let bot = c + (d - c) * fx;
    return top + (bot - top) * fz;
}

/// `octaves` layers of value noise, each at twice the frequency and half the weight; 0..1.
pub fn fbm(x: f32, z: f32, freq: f32, octaves: int): f32 {
    let n: f32 = 0;
    let amp: f32 = 0.5;
    let f = freq;
    let o = 0;
    while o < octaves {
        n += valueNoise(x * f + 100.0, z * f + 100.0, o) * amp;
        amp *= 0.5;
        f *= 2.0;
        o += 1;
    }
    return n;
}
