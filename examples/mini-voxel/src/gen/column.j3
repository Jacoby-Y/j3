// Fills a column with ground, then stamps structures (trees) over it.

module mini_voxel.gen.column;

use mini_voxel.config.{ CHUNK, SY };
use mini_voxel.gen.biome;
use mini_voxel.gen.structure;
use mini_voxel.gen.terrain;
use mini_voxel.world.block;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

/// Generate a column into its slot, dropping whatever column held it. Needs GL.
pub fn gen(c: &Chunks, cx: int, cz: int) {
    let s = chunks.claim(c, cx, cz);
    let lz = 0;
    while lz < CHUNK {
        let lx = 0;
        while lx < CHUNK {
            let h = terrain.heightAt(cx * CHUNK + lx, cz * CHUNK + lz);
            let top = biome.surfaceAt(cx * CHUNK + lx, cz * CHUNK + lz);
            let sub = block.under(top);
            if h > SY { h = SY; }
            let y = 0;
            while y < h {
                let id: u8 = sub;
                if y == h - 1 { id = top; }
                chunks.put(c, s, lx, y, lz, id);
                y += 1;
            }
            while y < terrain.SEA {
                chunks.put(c, s, lx, y, lz, block.WATER);
                y += 1;
            }
            lx += 1;
        }
        lz += 1;
    }
    structure.trees(c, s, cx, cz);
    chunks.finish(c, cx, cz);
}
