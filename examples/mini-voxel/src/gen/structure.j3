// Structures stamped into a column after terrain by gen/terrain.j3. Placement comes from a hash of
// world coordinates, so a column generates the same structures however it is reached: it scans
// the origins that could reach into it (own and neighbours') and writes only its own voxels.
//
// Trees: one candidate origin per GRID x GRID cell, jittered inside it, planted with a chance that
// follows a low-frequency forest map. A tree is built from two primitives, `limb` (a tapered
// capsule of wood) and `ball` (a ragged blob of leaves); `grow` strings them into a bending trunk,
// roots, spiralling limbs with forks, and a crown. To change the look, edit `grow`; to move
// forests around, edit `density`.

module mini_voxel.gen.structure;

use j3.math.{ absi, ceil, cos, floor, maxi, mini, sin, sqrt };
use mini_voxel.config.{ CHUNK, SY };
use mini_voxel.gen.biome;
use mini_voxel.gen.noise;
use mini_voxel.gen.terrain;
use mini_voxel.util.grid;
use mini_voxel.world.block;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

const GRID: int = 44; // voxels between candidate origins
const MAXR: int = 50; // furthest a tree reaches sideways; origins this far outside a column still touch it
const TRUNK_BELOW: f32 = 3.0; // trunk starts this deep so it meets the ground on a slope

/// Tree chance 0..1 at a world column: forest patches of ~100 m with a few loose trees between.
pub fn density(x: int, z: int): f32 {
    let d = (noise.fbm(f32(x), f32(z), 0.006, 2) - 0.5) * 3.0;
    if d < 0.0 { return 0.03; }
    if d > 0.55 { return 0.55; }
    return d;
}

// Fill a blob around (bx, by, bz) with `id`, clipped to the column at (x0, z0). `vk` squashes it
// vertically; `leafy` thins its outer shell so light shows through.
fn ball(c: &Chunks, s: int, x0: int, z0: int, bx: f32, by: f32, bz: f32, r: f32, vk: f32, leafy: bool, id: u8) {
    let xa = maxi(x0, int(floor(bx - r)));
    let xb = mini(x0 + CHUNK - 1, int(ceil(bx + r)));
    let za = maxi(z0, int(floor(bz - r)));
    let zb = mini(z0 + CHUNK - 1, int(ceil(bz + r)));
    if xa > xb || za > zb { return; }
    let ya = maxi(0, int(floor(by - r * vk)));
    let yb = mini(SY - 1, int(ceil(by + r * vk)));
    let r2 = r * r;
    let y = ya;
    while y <= yb {
        let dy = (f32(y) - by) / vk;
        let z = za;
        while z <= zb {
            let dz = f32(z) - bz;
            let x = xa;
            while x <= xb {
                let dx = f32(x) - bx;
                let d2 = dx * dx + dy * dy + dz * dz;
                let keep = d2 <= r2;
                if keep && leafy && d2 > r2 * 0.55 && noise.hash(x, z, y) % 3 == 0 { keep = false; }
                if keep { chunks.putIfAir(c, s, x - x0, y, z - z0, id); }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
}

// A wooden capsule from a to b, radius r0 at a tapering to r1 at b.
fn limb(c: &Chunks, s: int, x0: int, z0: int, ax: f32, ay: f32, az: f32, bx: f32, by: f32, bz: f32, r0: f32, r1: f32) {
    let dx = bx - ax;
    let dy = by - ay;
    let dz = bz - az;
    let n = int(sqrt(dx * dx + dy * dy + dz * dz) * 1.5) + 1;
    let i = 0;
    while i <= n {
        let t = f32(i) / f32(n);
        ball(c, s, x0, z0, ax + dx * t, ay + dy * t, az + dz * t, r0 + (r1 - r0) * t, 1.0, false, block.LOG);
        i += 1;
    }
}

// Sideways wander of the trunk at height y: zero at the base, a few voxels at the top.
fn bend(h: f32, y: f32, phase: f32, k: f32): f32 {
    let t = y / h;
    return sin(t * k + phase) * h * 0.05 * t;
}

// Grow one tree of trunk height `h` rooted at world column (px, pz) on ground height `gy`, writing
// only the voxels inside the column at (x0, z0).
fn grow(c: &Chunks, s: int, x0: int, z0: int, px: int, pz: int, gy: int, seed: int, h: int) {
    let th = f32(h);
    let ox = f32(px) + 0.5;
    let oz = f32(pz) + 0.5;
    let oy = f32(gy) - TRUNK_BELOW;
    let p1 = f32(seed % 100) * 0.1;
    let p2 = f32(seed / 100 % 100) * 0.1;
    let rb = 2.0 + th / 60.0; // trunk radius at the base
    let leaf = th / 9.0; // leaf blob radius

    // trunk, in segments that follow the bend
    let seg = 8;
    let i = 0;
    while i < seg {
        let ya = th * f32(i) / f32(seg);
        let yb = th * f32(i + 1) / f32(seg);
        let ra = rb + (1.0 - rb) * ya / th;
        let rt = rb + (1.0 - rb) * yb / th;
        limb(c, s, x0, z0, ox + bend(th, ya, p1, 3.0), oy + ya, oz + bend(th, ya, p2, 2.4), ox + bend(th, yb, p1, 3.0), oy + yb, oz + bend(th, yb, p2, 2.4), ra, rt);
        i += 1;
    }

    // roots flaring out of the base
    let k = 0;
    while k < 4 {
        let ang = f32(k) * 1.57 + noise.rnd(seed, k, 5);
        limb(c, s, x0, z0, ox, oy + 7.0, oz, ox + cos(ang) * 8.0, oy + 2.0, oz + sin(ang) * 8.0, rb, 1.0);
        k += 1;
    }

    // limbs spiral up the upper trunk, each bending upward with a fork and a leaf blob per tip
    let nl = 5 + seed / 40 % 3;
    k = 0;
    while k < nl {
        let f = 0.42 + 0.5 * f32(k) / f32(nl) + (noise.rnd(seed, k, 1) - 0.5) * 0.06;
        let y = th * f;
        let a = f32(k) * 2.4 + noise.rnd(seed, k, 2) * 0.8;
        let e = 0.3 + 0.4 * f; // limbs rise more near the top
        let len = th * (0.40 - 0.22 * f) * (0.8 + 0.4 * noise.rnd(seed, k, 3));
        let bx = ox + bend(th, y, p1, 3.0);
        let by = oy + y;
        let bz = oz + bend(th, y, p2, 2.4);
        let mx = bx + cos(a) * cos(e) * len * 0.55;
        let my = by + sin(e) * len * 0.55;
        let mz = bz + sin(a) * cos(e) * len * 0.55;
        let e2 = e + 0.4;
        let ex = mx + cos(a + 0.2) * cos(e2) * len * 0.45;
        let ey = my + sin(e2) * len * 0.45;
        let ez = mz + sin(a + 0.2) * cos(e2) * len * 0.45;
        limb(c, s, x0, z0, bx, by, bz, mx, my, mz, 1.5, 1.1);
        limb(c, s, x0, z0, mx, my, mz, ex, ey, ez, 1.1, 0.8);
        let a3 = a + 1.1 - 2.2 * f32(k % 2);
        let e3 = e + 0.25;
        let fx = mx + cos(a3) * cos(e3) * len * 0.4;
        let fy = my + sin(e3) * len * 0.4;
        let fz = mz + sin(a3) * cos(e3) * len * 0.4;
        limb(c, s, x0, z0, mx, my, mz, fx, fy, fz, 0.9, 0.8);
        ball(c, s, x0, z0, ex, ey, ez, leaf, 0.7, true, block.LEAVES);
        ball(c, s, x0, z0, fx, fy, fz, leaf * 0.7, 0.7, true, block.LEAVES);
        k += 1;
    }

    // crown on top of the trunk
    ball(c, s, x0, z0, ox + bend(th, th, p1, 3.0), oy + th + 3.0, oz + bend(th, th, p2, 2.4), leaf * 1.1, 0.75, true, block.LEAVES);
}

/// Plant every tree that reaches column (cx, cz) into its claimed slot `s`.
pub fn trees(c: &Chunks, s: int, cx: int, cz: int) {
    let gz = grid.fdiv(cz * CHUNK - MAXR, GRID);
    let gzEnd = grid.fdiv(cz * CHUNK + CHUNK + MAXR, GRID);
    let gxStart = grid.fdiv(cx * CHUNK - MAXR, GRID);
    let gxEnd = grid.fdiv(cx * CHUNK + CHUNK + MAXR, GRID);
    while gz <= gzEnd {
        let gx = gxStart;
        while gx <= gxEnd {
            let seed = noise.hash(gx, gz, 77);
            let px = gx * GRID + 6 + noise.hash(gx, gz, 78) % (GRID - 12);
            let pz = gz * GRID + 6 + noise.hash(gx, gz, 79) % (GRID - 12);
            if noise.rnd(gx, gz, 80) < density(px, pz) && biome.surfaceAt(px, pz) == block.GRASS && (absi(px) > 14 || absi(pz) > 14) { // none on the spawn
                let gy = terrain.heightAt(px, pz);
                let h = mini(60 + seed % 40, SY - gy - 16); // 6-10 m, trimmed to fit under the world ceiling
                if h >= 30 { grow(c, s, cx * CHUNK, cz * CHUNK, px, pz, gy, seed, h); }
            }
            gx += 1;
        }
        gz += 1;
    }
}
