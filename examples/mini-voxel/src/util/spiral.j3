// Offsets (dx, dz) of a square, sorted by distance from the middle. Schedulers walk this list and
// stop at the first match, which is the nearest one, instead of scanning the whole square.

module mini_voxel.util.spiral;

use j3.memory.Arena;

pub struct Spiral {
    dx: []int;
    dz: []int;
    n: int;
}

/// Every (dx, dz) with |dx|, |dz| <= radius, nearest first; ties keep row-major order.
pub fn create(mem: &Arena, radius: int): Spiral {
    let side = 2 * radius + 1;
    let sp = Spiral { dx: mem.alloc::<int>(side * side), dz: mem.alloc::<int>(side * side), n: side * side };
    let d2 = mem.alloc::<int>(side * side);
    let i = 0;
    let z = -radius;
    while z <= radius {
        let x = -radius;
        while x <= radius {
            // insertion sort: shift larger entries up, drop this one into the gap
            let d = x * x + z * z;
            let j = i;
            while j > 0 && d2[j - 1] > d {
                d2[j] = d2[j - 1]; sp.dx[j] = sp.dx[j - 1]; sp.dz[j] = sp.dz[j - 1];
                j -= 1;
            }
            d2[j] = d; sp.dx[j] = x; sp.dz[j] = z;
            i += 1;
            x += 1;
        }
        z += 1;
    }
    return sp;
}
