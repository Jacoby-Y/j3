// Frame time budgets.

module mini_voxel.util.time;

use j3.game;

/// A deadline `us` microseconds from now.
pub fn after(us: int): int {
    return game.micros() + us;
}

/// True while `deadline` has not passed; 0 means no deadline.
pub fn within(deadline: int): bool {
    return deadline == 0 || game.micros() < deadline;
}
