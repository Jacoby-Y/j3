// Integer helpers that stay correct for negative coordinates.

module mini_voxel.util.grid;

pub const NONE: int = 1000000000; // "no candidate yet" and "no budget limit"

/// Division that rounds toward negative infinity.
pub fn fdiv(a: int, b: int): int {
    if a >= 0 { return a / b; }
    return -((-a + b - 1) / b);
}

/// Modulo that is always in 0..b.
pub fn fmod(a: int, b: int): int {
    return a - fdiv(a, b) * b;
}
