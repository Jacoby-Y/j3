// Collision and picking against the chunked world. `voxel.*` and `Body3` want a flat grid, so
// physics runs on a window of cells copied around the player; the raycast walks the chunks.

module mini_voxel.physics.collide;

use j3.game.physics.Body3;
use j3.gfx.voxel;
use j3.math.{ Vec3, abs, floor };
use j3.memory.Arena;
use mini_voxel.config.{ CHUNK, SY, WIN };
use mini_voxel.world.block;
use mini_voxel.util.grid.{ fdiv, fmod };
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

pub struct Collider {
    win: []u8;
}

pub fn create(mem: &Arena): Collider {
    return Collider { win: mem.alloc::<u8>(WIN * SY * WIN) };
}

/// Copy the cells around (ox, oz) into the window. Unloaded columns read as solid so you never
/// fall into the void.
pub fn fillWindow(col: &Collider, c: &Chunks, ox: int, oz: int) {
    let z = 0;
    while z < WIN {
        let x = 0;
        while x < WIN {
            let wx = ox + x; let wz = oz + z;
            let cx = fdiv(wx, CHUNK); let cz = fdiv(wz, CHUNK);
            let ok = chunks.colLoaded(c, cx, cz);
            let s = chunks.slotOf(cx, cz);
            let lx = fmod(wx, CHUNK); let lz = fmod(wz, CHUNK);
            let y = 0;
            while y < SY {
                let v: u8 = 1;
                if ok { v = c.cells[chunks.chunkBase(s, y / CHUNK) + voxel.index(lx, y % CHUNK, lz, CHUNK, CHUNK)]; }
                if v == block.WATER { v = 0; }
                col.win[voxel.index(x, y, z, WIN, WIN)] = v;
                y += 1;
            }
            x += 1;
        }
        z += 1;
    }
}

/// Solid just under the feet (window coordinates).
pub fn grounded(col: &Collider, b: &Body3): bool {
    let p = b.pos;
    return voxel.overlaps(col.win, WIN, SY, WIN,
        Vec3.xyz(p.x - 2.9, p.y - 8.6, p.z - 2.9), Vec3.xyz(p.x + 2.9, p.y - 8.01, p.z + 2.9));
}

/// Move on the XZ plane; if a wall blocks and you stand on ground, raise by the smallest of
/// 1..3 cells that clears it.
pub fn walk(col: &Collider, b: &Body3, onGround: bool, dx: f32, dz: f32) {
    let sx = b.pos.x; let sz = b.pos.z;
    b.tryAxis(col.win, WIN, SY, WIN, dx, 0, 0);
    b.tryAxis(col.win, WIN, SY, WIN, 0, 0, dz);
    let blocked = b.pos.x != sx + dx || b.pos.z != sz + dz;
    if !blocked || !onGround { return; }
    let up = 1;
    while up <= 3 {
        let t = Body3.make(Vec3.xyz(sx, b.pos.y, sz), Vec3.xyz(0, 0, 0), b.half, 1);
        t.tryAxis(col.win, WIN, SY, WIN, 0, f32(up), 0);
        t.tryAxis(col.win, WIN, SY, WIN, dx, 0, 0);
        t.tryAxis(col.win, WIN, SY, WIN, 0, 0, dz);
        if t.pos.y > b.pos.y && t.pos.x == sx + dx && t.pos.z == sz + dz {
            b.pos = t.pos;
            return;
        }
        up += 1;
    }
}

pub struct Pick {
    ok: bool;
    x: int;
    y: int;
    z: int;
}

/// DDA through the chunked world: the first solid cell within `reach` cells.
pub fn raycast(c: &Chunks, o: Vec3, d: Vec3, reach: f32): Pick {
    let x = int(floor(o.x)); let y = int(floor(o.y)); let z = int(floor(o.z));
    let big: f32 = 1000000000.0;
    let stx = 1; let sty = 1; let stz = 1;
    let tdx = big; let tdy = big; let tdz = big;
    let tx = big; let ty = big; let tz = big;
    if d.x != 0 { tdx = abs(1.0 / d.x); if d.x > 0 { tx = (f32(x + 1) - o.x) * tdx; } else { stx = -1; tx = (o.x - f32(x)) * tdx; } }
    if d.y != 0 { tdy = abs(1.0 / d.y); if d.y > 0 { ty = (f32(y + 1) - o.y) * tdy; } else { sty = -1; ty = (o.y - f32(y)) * tdy; } }
    if d.z != 0 { tdz = abs(1.0 / d.z); if d.z > 0 { tz = (f32(z + 1) - o.z) * tdz; } else { stz = -1; tz = (o.z - f32(z)) * tdz; } }
    let t: f32 = 0;
    while t <= reach {
        let id = chunks.cellAt(c, x, y, z);
        if id != 0 && id != block.WATER { return Pick { ok: true, x: x, y: y, z: z }; }
        if tx <= ty && tx <= tz { x += stx; t = tx; tx += tdx; }
        else if ty <= tz { y += sty; t = ty; ty += tdy; }
        else { z += stz; t = tz; tz += tdz; }
    }
    return Pick { ok: false, x: 0, y: 0, z: 0 };
}
