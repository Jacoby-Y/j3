// Tuning constants. One voxel is VOXEL meters; grid and physics math is in cells, meters only at
// draw and camera.

module mini_voxel.config;

pub const VOXEL: f32 = 0.1;

// The ocean continues in x/z around the finite island; SY bounds the height. It is cut into CHUNK-cube chunks that own their
// cells. Chunks live in columns (CY chunks stacked); a D x D ring of column slots holds the
// columns around the player, so memory is fixed whatever the world size.
pub const CHUNK: int = 16;
pub const CY: int = 12; // SY = 192: room for 10 m trees on top of the hills (edited-height tables are bytes, so SY stays under 256)
pub const SY: int = CHUNK * CY;
pub const CSZ: int = CHUNK * CHUNK * CHUNK;
// Full-resolution (LOD 0) radius in columns. Only these columns keep cells; everything further
// is meshed straight from the generator by the LOD rings.
pub const NEAR: int = 10;
// Columns are drawn out to NEAR, meshed out to NEAR + 1 and generated out to NEAR + 2 (meshing
// needs side neighbours), so a column is ready before it reaches the drawn square.
pub const D: int = 2 * (NEAR + 2) + 2; // column slots per side
pub const VIEW_MAX: int = 160; // largest render distance, in columns (the pause slider's top)
pub const VIEW_MIN: int = 3;
pub const VIEW_START: int = 10;
pub const BENCH_AWAY: int = 0; // nonzero: dig a trench at the origin, start this many columns away looking back (far-edit test)
pub const BENCH_VIEW: int = 0; // nonzero: start at this render distance (for `j3c run --frames N`)
pub const FRAME_US: int = 5000; // per-frame time for generating and meshing (each stage gets at least one item)
pub const PAD: int = CHUNK + 2;
pub const SCRATCH_FACES: int = 13000; // a 16^3 checkerboard is the worst case
pub const WIN: int = 24; // collision window side, cells
pub const DIG_R: int = 4;
pub const REACH: f32 = 100; // cells, always inside NEAR

// LOD rings. A level-L cell is 2^L voxels wide; a level-L tile is TILE x TILE cells wide, so it
// spans 2^L columns and every tile costs about the same to mesh and draw. Each level keeps the
// tiles within K tiles of the player; K = NEAR makes each ring twice as far as the one inside it.
pub const LMAX: int = 4;
pub const K: int = NEAR;
pub const TILE: int = 16;
pub const LOD_R: int = 2 * K + 3; // tile slots per side per level
// Tiles deeper than this many finer-level tiles inside a finer ring are not meshed (they are
// hidden); the margin is how far the finer ring can move before they are needed.
pub const COVER_MARGIN: int = 3;
pub const SKIRT: int = 2; // cells a tile's border walls reach down, hiding cracks between levels

// Chunks the player edited are copied here when their column leaves the ring, and restored when it
// returns, so holes survive walking away. Full table: later edits are lost on eviction.
pub const EDIT_SLOTS: int = 2048;
// Edited columns also keep a 16x16 table of surface heights, which is all LOD tiles can show of an
// edit. Full table: that column's far view keeps the generated terrain.
pub const TOP_SLOTS: int = 1024;
