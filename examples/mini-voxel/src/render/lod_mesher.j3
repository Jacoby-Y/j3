// Meshes a LOD tile straight from the generator: no cells are stored. A level-L cell is 2^L
// voxels wide and is solid when its centre is under the terrain height sampled at its column
// centre. Heights give everything needed, so only the faces that can show are emitted: the top
// of each column and the side walls where a neighbour is lower. Tiles are flat-coloured, so
// coplanar neighbours merge: tops into rectangles, walls into runs along the wall.

module mini_voxel.render.lod_mesher;

use j3.gfx;
use j3.gfx.Mesh;
use j3.math.Vec3;
use mini_voxel.config.{ SCRATCH_FACES, SKIRT, SY, TILE };
use mini_voxel.gen.biome;
use mini_voxel.gen.terrain;
use mini_voxel.render.mesher.Mesher;
use mini_voxel.render.quad;
use mini_voxel.world.block;
use mini_voxel.world.edits.Edits;

const HW: int = 18; // TILE + 2: the tile plus a one-column border

/// Voxels per cell side at level `l`.
pub fn pow2(l: int): int {
    let s = 1;
    let i = 0;
    while i < l { s *= 2; i += 1; }
    return s;
}

// Solid cells in a column of height `h` voxels, cells `s` voxels tall.
fn cellCount(h: int, s: int): int {
    if h <= s / 2 { return 0; }
    let n = (h - s / 2 + s - 1) / s;
    if n > SY / s { n = SY / s; }
    return n;
}

// Append a quad of block `id`, unless the scratch buffer is full.
fn put(m: &Mesher, at: int, x: int, y: int, z: int, w: int, h: int, d: int, face: int, id: u8): int {
    if at + 60 > SCRATCH_FACES * 60 { return at; }
    let col = Vec3.xyz(0, 0, 0);
    block.flat(id, &col);
    return quad.pushQuad(m.scratch, at, f32(x), f32(y), f32(z), f32(w), f32(h), f32(d), face, col.x, col.y, col.z);
}

// First wall cell of a column of `n` cells beside a neighbour of `nb`: the part above the
// neighbour, plus a skirt on tile borders.
fn wallLo(n: int, nb: int, border: bool): int {
    let lo = nb;
    if border {
        let sk = n - SKIRT;
        if sk < 0 { sk = 0; }
        if sk < lo { lo = sk; }
    }
    return lo;
}

// Emit one run of identical wall columns: `run` columns starting at tangent position `q0` on
// plane `p`, cells lo..n-1 (dirt below, a grass cell on top).
fn wallRun(m: &Mesher, at: int, face: int, xwall: bool, p: int, q0: int, run: int, lo: int, n: int, sid: u8): int {
    let i = 0;
    while i < 2 {
        let y0 = lo;
        let y1 = n - 1;
        let id: u8 = block.under(sid);
        if i == 1 { y0 = n - 1; y1 = n; id = sid; }
        if y1 > y0 {
            if xwall { at = put(m, at, p, y0, q0, 1, y1 - y0, run, face, id); }
            else { at = put(m, at, q0, y0, p, run, y1 - y0, 1, face, id); }
        }
        i += 1;
    }
    return at;
}

// All walls facing `face` (NX/PX walls run along z, NZ/PZ along x): merge neighbouring columns
// whose wall spans the same cells.
fn walls(m: &Mesher, at: int, face: int, xwall: bool, step: int, far: bool): int {
    let p = 0;
    while p < TILE {
        let runLo = 0; let runN = 0; let runStart = 0; let runS = 0;
        let q = 0;
        while q <= TILE {
            let lo = 0; let n = 0; let sid = 0;
            if q < TILE {
                let lx = p; let lz = q;
                if !xwall { lx = q; lz = p; }
                let i = (lz + 1) * HW + lx + 1;
                n = m.cellsN[i];
                sid = m.heights[i];
                if n > 0 { lo = wallLo(n, m.cellsN[i + step], if far { p == TILE - 1 } else { p == 0 }); }
                if lo >= n { n = 0; lo = 0; }
            }
            if q > runStart && (q == TILE || n != runN || lo != runLo || sid != runS) {
                if runN > 0 { at = wallRun(m, at, face, xwall, p, runStart, q - runStart, runLo, runN, u8(runS)); }
                runStart = q;
            }
            if q == runStart { runN = n; runLo = lo; runS = sid; }
            q += 1;
        }
        p += 1;
    }
    return at;
}

/// Mesh tile (tx, tz) of level `l` in tile-local cell units. Uploads to GL.
pub fn meshTile(m: &Mesher, ed: &Edits, l: int, tx: int, tz: int): Mesh {
    let s = pow2(l);
    let z = 0;
    while z < HW {
        let x = 0;
        while x < HW {
            // sampled at the cell column centre, the border one column outside; `heights` holds the surface block id
            let wx = (tx * TILE + x - 1) * s + s / 2;
            let wz = (tz * TILE + z - 1) * s + s / 2;
            let h = terrain.surfaceAt(ed, wx, wz);
            let surfaceId = biome.surfaceAt(wx, wz);
            if h < terrain.SEA { h = terrain.SEA; surfaceId = block.WATER; }
            m.heights[z * HW + x] = int(surfaceId);
            m.cellsN[z * HW + x] = cellCount(h, s);
            x += 1;
        }
        z += 1;
    }
    let at = 0;
    // tops: grow a rectangle of equal-height columns from each unused column
    let i = 0;
    while i < TILE * TILE { m.used[i] = false; i += 1; }
    let lz = 0;
    while lz < TILE {
        let lx = 0;
        while lx < TILE {
            let n = m.cellsN[(lz + 1) * HW + lx + 1];
            let sid = m.heights[(lz + 1) * HW + lx + 1];
            if n > 0 && !m.used[lz * TILE + lx] {
                let w = 1;
                while lx + w < TILE && !m.used[lz * TILE + lx + w] && m.cellsN[(lz + 1) * HW + lx + w + 1] == n && m.heights[(lz + 1) * HW + lx + w + 1] == sid { w += 1; }
                let d = 1;
                let more = true;
                while more && lz + d < TILE {
                    let k = 0;
                    while k < w && more {
                        if m.used[(lz + d) * TILE + lx + k] || m.cellsN[(lz + d + 1) * HW + lx + k + 1] != n || m.heights[(lz + d + 1) * HW + lx + k + 1] != sid { more = false; }
                        k += 1;
                    }
                    if more { d += 1; }
                }
                let dz = 0;
                while dz < d {
                    let dx = 0;
                    while dx < w { m.used[(lz + dz) * TILE + lx + dx] = true; dx += 1; }
                    dz += 1;
                }
                at = put(m, at, lx, n - 1, lz, w, 1, d, gfx.FACE_PY, u8(sid));
                lx += w;
            } else {
                lx += 1;
            }
        }
        lz += 1;
    }
    at = walls(m, at, gfx.FACE_NX, true, -1, false);
    at = walls(m, at, gfx.FACE_PX, true, 1, true);
    at = walls(m, at, gfx.FACE_NZ, false, -HW, false);
    at = walls(m, at, gfx.FACE_PZ, false, HW, true);
    if at == 0 { return Mesh {}; }
    return gfx.upload(m.scratch[0..at]);
}
