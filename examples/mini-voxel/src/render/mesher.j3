// Turns a chunk into a mesh. The chunk and its one-cell border are copied into `pad` first, so
// the face test is plain array reads. Only faces that touch air are emitted; the world floor
// (y < 0) counts as solid.

module mini_voxel.render.mesher;

use j3.gfx;
use j3.gfx.Mesh;
use j3.gfx.voxel;
use j3.math.Vec3;
use j3.memory.Arena;
use mini_voxel.config.{ CHUNK, CY, PAD, SCRATCH_FACES, TILE };
use mini_voxel.world.block;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

pub struct Mesher {
    scratch: []f32;
    pad: []u8;
    heights: []int; // surface block id per column of a LOD tile and its one-column border (render/lod_mesher.j3)
    cellsN: []int; // solid cells per column, same layout
    used: []bool; // TILE x TILE: columns already merged into a top quad
}

pub fn create(mem: &Arena): Mesher {
    return Mesher {
        scratch: mem.alloc::<f32>(SCRATCH_FACES * 60),
        pad: mem.alloc::<u8>(PAD * PAD * PAD),
        heights: mem.alloc::<int>((TILE + 2) * (TILE + 2)),
        cellsN: mem.alloc::<int>((TILE + 2) * (TILE + 2)),
        used: mem.alloc::<bool>(TILE * TILE),
    };
}

/// Mesh one chunk in chunk-local cell units. Uploads to GL.
pub fn meshChunk(m: &Mesher, c: &Chunks, cx: int, cy: int, cz: int): Mesh {
    let s = chunks.slotOf(cx, cz);
    if c.solid[s * CY + cy] == 0 { return Mesh {}; }
    let base = chunks.chunkBase(s, cy);
    let x0 = cx * CHUNK; let y0 = cy * CHUNK; let z0 = cz * CHUNK;
    let py = 0;
    while py < PAD {
        let pz = 0;
        while pz < PAD {
            let px = 0;
            while px < PAD {
                let v: u8 = 0;
                if px == 0 || px == PAD - 1 || py == 0 || py == PAD - 1 || pz == 0 || pz == PAD - 1 {
                    if y0 + py - 1 < 0 { v = 1; } else { v = chunks.cellAt(c, x0 + px - 1, y0 + py - 1, z0 + pz - 1); }
                } else {
                    v = c.cells[base + voxel.index(px - 1, py - 1, pz - 1, CHUNK, CHUNK)];
                }
                m.pad[voxel.index(px, py, pz, PAD, PAD)] = v;
                px += 1;
            }
            pz += 1;
        }
        py += 1;
    }
    let at = 0;
    let col = Vec3.xyz(0, 0, 0);
    let y = 1;
    while y <= CHUNK {
        let z = 1;
        while z <= CHUNK {
            let x = 1;
            while x <= CHUNK {
                let id = m.pad[voxel.index(x, y, z, PAD, PAD)];
                if id != 0 {
                    let face = 0;
                    while face < 6 {
                        let nx = x; let ny = y; let nz = z;
                        if face == gfx.FACE_NX { nx -= 1; }
                        if face == gfx.FACE_PX { nx += 1; }
                        if face == gfx.FACE_NY { ny -= 1; }
                        if face == gfx.FACE_PY { ny += 1; }
                        if face == gfx.FACE_NZ { nz -= 1; }
                        if face == gfx.FACE_PZ { nz += 1; }
                        let beside = m.pad[voxel.index(nx, ny, nz, PAD, PAD)];
                        if (beside == 0 || (beside == block.WATER && id != block.WATER)) && at + 60 <= SCRATCH_FACES * 60 {
                            block.tint(id, x0 + x - 1, y0 + y - 1, z0 + z - 1, &col);
                            at = gfx.emitFace(m.scratch, at, f32(x - 1), f32(y - 1), f32(z - 1), face,
                                col.x, col.y, col.z, 0);
                        }
                        face += 1;
                    }
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    if at == 0 { return Mesh {}; }
    return gfx.upload(m.scratch[0..at]);
}
