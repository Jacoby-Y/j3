// A stretched version of `gfx.emitFace`: one axis-aligned quad covering w x h x d cells, so a run
// of coplanar faces costs two triangles. Vertex order and normals match `emitFace` exactly (same
// winding), the cube's `+ 1` extents are `+ w`, `+ h`, `+ d`.

module mini_voxel.render.quad;

use j3.gfx;

fn vert(out: []f32, at: int, x: f32, y: f32, z: f32, nx: f32, ny: f32, nz: f32, r: f32, g: f32, b: f32): int {
    out[at] = x;
    out[at + 1] = y;
    out[at + 2] = z;
    out[at + 3] = nx;
    out[at + 4] = ny;
    out[at + 5] = nz;
    out[at + 6] = r;
    out[at + 7] = g;
    out[at + 8] = b;
    out[at + 9] = 0;
    return at + 10;
}

/// Append 6 verts for the `dir` (gfx.FACE_*) side of the box at (x, y, z) of size (w, h, d).
/// Only the two axes the face spans matter; the face sits on the box's `dir` side.
pub fn pushQuad(out: []f32, at: int, x: f32, y: f32, z: f32, w: f32, h: f32, d: f32, dir: int, r: f32, g: f32, b: f32): int {
    let x1 = x + w;
    let y1 = y + h;
    let z1 = z + d;
    let o: f32 = 0;
    let p: f32 = 1;
    let m: f32 = o - 1;
    if dir == gfx.FACE_PY {
        at = vert(out, at, x, y1, z, o, p, o, r, g, b);
        at = vert(out, at, x, y1, z1, o, p, o, r, g, b);
        at = vert(out, at, x1, y1, z1, o, p, o, r, g, b);
        at = vert(out, at, x, y1, z, o, p, o, r, g, b);
        at = vert(out, at, x1, y1, z1, o, p, o, r, g, b);
        return vert(out, at, x1, y1, z, o, p, o, r, g, b);
    }
    if dir == gfx.FACE_NY {
        at = vert(out, at, x, y, z, o, m, o, r, g, b);
        at = vert(out, at, x1, y, z, o, m, o, r, g, b);
        at = vert(out, at, x1, y, z1, o, m, o, r, g, b);
        at = vert(out, at, x, y, z, o, m, o, r, g, b);
        at = vert(out, at, x1, y, z1, o, m, o, r, g, b);
        return vert(out, at, x, y, z1, o, m, o, r, g, b);
    }
    if dir == gfx.FACE_PZ {
        at = vert(out, at, x, y, z1, o, o, p, r, g, b);
        at = vert(out, at, x1, y, z1, o, o, p, r, g, b);
        at = vert(out, at, x1, y1, z1, o, o, p, r, g, b);
        at = vert(out, at, x, y, z1, o, o, p, r, g, b);
        at = vert(out, at, x1, y1, z1, o, o, p, r, g, b);
        return vert(out, at, x, y1, z1, o, o, p, r, g, b);
    }
    if dir == gfx.FACE_NZ {
        at = vert(out, at, x1, y, z, o, o, m, r, g, b);
        at = vert(out, at, x, y, z, o, o, m, r, g, b);
        at = vert(out, at, x, y1, z, o, o, m, r, g, b);
        at = vert(out, at, x1, y, z, o, o, m, r, g, b);
        at = vert(out, at, x, y1, z, o, o, m, r, g, b);
        return vert(out, at, x1, y1, z, o, o, m, r, g, b);
    }
    if dir == gfx.FACE_PX {
        at = vert(out, at, x1, y, z, p, o, o, r, g, b);
        at = vert(out, at, x1, y1, z, p, o, o, r, g, b);
        at = vert(out, at, x1, y1, z1, p, o, o, r, g, b);
        at = vert(out, at, x1, y, z, p, o, o, r, g, b);
        at = vert(out, at, x1, y1, z1, p, o, o, r, g, b);
        return vert(out, at, x1, y, z1, p, o, o, r, g, b);
    }
    at = vert(out, at, x, y, z1, m, o, o, r, g, b);
    at = vert(out, at, x, y1, z1, m, o, o, r, g, b);
    at = vert(out, at, x, y1, z, m, o, o, r, g, b);
    at = vert(out, at, x, y, z1, m, o, o, r, g, b);
    at = vert(out, at, x, y1, z, m, o, o, r, g, b);
    return vert(out, at, x, y, z, m, o, o, r, g, b);
}
