// Draws the world as a quadtree of tiles. Each top-level (level LMAX) tile is drawn as one coarse
// mesh, or split into its four children when all of them are ready; this repeats down to level 0,
// the full-resolution columns. A tile is therefore drawn at exactly one level (no overlap) and
// falls back to the coarser level while finer meshes are still being built (no holes).

module mini_voxel.render.world_draw;

use j3.gfx;
use j3.gfx.Mesh;
use j3.math.{ Mat4, Vec3 };
use mini_voxel.config.{ CHUNK, CY, K, LMAX, SY, TILE, VOXEL };
use mini_voxel.render.lod;
use mini_voxel.render.lod.{ Focus, Lod };
use mini_voxel.util.grid.fdiv;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

pub struct DrawStats {
    meshes: int;
    verts: int;
}

struct Frame {
    c: &Chunks;
    lod: &Lod;
    f: Focus;
    stats: DrawStats;
}

fn inNear(f: &Focus, cx: int, cz: int): bool {
    return cx >= f.pcx - f.near && cx <= f.pcx + f.near && cz >= f.pcz - f.near && cz <= f.pcz + f.near;
}

// Level-`l` tile (tx, tz) can stand in for its area: a ready mesh, a tile hidden deep under finer
// ones (`lod.covered`, no mesh of its own), or at level 0 a meshed column inside the near square. Every level keeps its own tiles, so a missing mesh falls back to the
// next coarser mesh of just that spot, never to a whole coarse tile.
fn avail(fr: &Frame, l: int, tx: int, tz: int): bool {
    if l == 0 { return inNear(&fr.f, tx, tz) && chunks.columnMeshed(fr.c, tx, tz); }
    if lod.covered(&fr.f, l, tx, tz) { return true; }
    return lod.inRegion(&fr.f, l, tx, tz) && lod.ready(fr.lod, l, tx, tz);
}

fn canSplit(fr: &Frame, l: int, tx: int, tz: int): bool {
    return avail(fr, l - 1, tx * 2, tz * 2) && avail(fr, l - 1, tx * 2 + 1, tz * 2)
        && avail(fr, l - 1, tx * 2, tz * 2 + 1) && avail(fr, l - 1, tx * 2 + 1, tz * 2 + 1);
}

fn model(l: int, tx: int, tz: int, y: int): Mat4 {
    let s = f32(lod.pow2(l)) * VOXEL;
    let w = f32(TILE) * s;
    return Mat4.translate(f32(tx) * w, f32(y) * s, f32(tz) * w).mul(Mat4.scale(s, s, s));
}

fn drawMesh(fr: &Frame, m: Mesh, md: Mat4, hi: Vec3) {
    if m.count > 0 && gfx.visible(md, Vec3.xyz(0, 0, 0), hi) {
        gfx.draw(m, md);
        fr.stats.meshes += 1;
        fr.stats.verts += m.count;
    }
}

fn drawColumn(fr: &Frame, cx: int, cz: int) {
    if !inNear(&fr.f, cx, cz) || !chunks.colLoaded(fr.c, cx, cz) { return; }
    let hi = Vec3.xyz(f32(CHUNK), f32(CHUNK), f32(CHUNK));
    let cy = 0;
    while cy < CY {
        drawMesh(fr, fr.c.meshes[chunks.slotOf(cx, cz) * CY + cy], model(0, cx, cz, cy * CHUNK), hi);
        cy += 1;
    }
}

fn drawTile(fr: &Frame, l: int, tx: int, tz: int) {
    if l == 0 {
        drawColumn(fr, tx, tz);
        return;
    }
    let s = lod.pow2(l);
    let md = model(l, tx, tz, 0);
    if !gfx.visible(md, Vec3.xyz(0, 0, 0), Vec3.xyz(f32(TILE), f32(SY / s), f32(TILE))) { return; }
    if canSplit(fr, l, tx, tz) {
        drawTile(fr, l - 1, tx * 2, tz * 2);
        drawTile(fr, l - 1, tx * 2 + 1, tz * 2);
        drawTile(fr, l - 1, tx * 2, tz * 2 + 1);
        drawTile(fr, l - 1, tx * 2 + 1, tz * 2 + 1);
        return;
    }
    if lod.ready(fr.lod, l, tx, tz) {
        drawMesh(fr, lod.mesh(fr.lod, l, tx, tz), md, Vec3.xyz(f32(TILE), f32(SY / s), f32(TILE)));
    }
}

/// Draw inside the current camera pass. Returns what was drawn.
pub fn drawWorld(c: &Chunks, l: &Lod, f: Focus): DrawStats {
    let fr = Frame { c: c, lod: l, f: f, stats: DrawStats { meshes: 0, verts: 0 } };
    let s = lod.pow2(LMAX);
    let cx = fdiv(f.pcx, s);
    let cz = fdiv(f.pcz, s);
    let dz = -K;
    while dz <= K {
        let dx = -K;
        while dx <= K {
            if lod.inRegion(&fr.f, LMAX, cx + dx, cz + dz) { drawTile(&fr, LMAX, cx + dx, cz + dz); }
            dx += 1;
        }
        dz += 1;
    }
    return fr.stats;
}
