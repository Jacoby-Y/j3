// Small immediate-mode widgets: hit test and button. Screens position them themselves.

module mini_voxel.ui.widgets;

use j3.game;
use j3.game.Font;
use j3.math.Vec2;

pub fn inRect(m: Vec2, x: f32, y: f32, rw: f32, rh: f32): bool {
    return m.x >= x && m.x <= x + rw && m.y >= y && m.y <= y + rh;
}

pub fn button(font: Font, x: f32, y: f32, bw: f32, bh: f32, text: string) {
    let hot = inRect(game.mousePos(), x, y, bw, bh);
    if hot { game.setColor(game.rgb(70, 110, 170)); } else { game.setColor(game.rgb(48, 56, 72)); }
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: bw, y: bh });
    game.setColor(game.rgb(235, 240, 250));
    let sz = game.textSize(font, text);
    game.drawText(font, Vec2 { x: x + (bw - sz.x) * 0.5, y: y + (bh - sz.y) * 0.5 }, text);
}
