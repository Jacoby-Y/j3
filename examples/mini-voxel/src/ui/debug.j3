// F3 panel (top-left; the engine's frame-time graph is top-right).

module mini_voxel.ui.debug;

use j3.game;
use j3.math.{ Vec2, floor };
use j3.text.Text;
use mini_voxel.perf.Perf;
use mini_voxel.player.player.Player;
use mini_voxel.render.lod;
use mini_voxel.render.lod.{ Focus, Lod };
use mini_voxel.render.world_draw.DrawStats;
use mini_voxel.ui.state.Ui;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

fn line(ui: &Ui, row: int, t: &Text) {
    game.setColor(game.rgb(235, 240, 200));
    game.drawText(ui.font, Vec2 { x: 12, y: 10 + f32(row) * 20 }, t.str());
}

fn ms(t: &Text, label: string, v: f32) {
    t.pushStr(label);
    t.pushFloat(v);
}

pub fn draw(ui: &Ui, p: &Player, c: &Chunks, l: &Lod, drawn: DrawStats, perf: &Perf, f: &Focus) {
    let cp = ui.mem.checkpoint();
    let st = game.frameStats();
    let t = Text.new(ui.mem);
    game.setColor(game.rgba(8, 8, 12, 190));
    game.drawRect(Vec2 { x: 6, y: 6 }, Vec2 { x: 400, y: 134 });
    t.pushStr("fps ");
    t.pushInt(if st.frameMs > 0 { int(1000.0 / st.frameMs + 0.5) } else { 0 });
    t.pushStr("  (");
    t.pushFloat(st.frameMs);
    t.pushStr(" ms)");
    line(ui, 0, &t);
    t.clear();
    t.pushStr("xyz ");
    t.pushInt(int(floor(p.body.pos.x)));
    t.pushStr(" ");
    t.pushInt(int(floor(p.body.pos.y)));
    t.pushStr(" ");
    t.pushInt(int(floor(p.body.pos.z)));
    t.pushStr("  chunk ");
    t.pushInt(f.pcx);
    t.pushStr(" ");
    t.pushInt(f.pcz);
    line(ui, 1, &t);
    t.clear();
    t.pushStr("view ");
    t.pushInt(f.view);
    t.pushStr("  columns ");
    t.pushInt(chunks.loadedColumns(c));
    t.pushStr("  lod tiles ");
    t.pushInt(lod.builtTiles(l));
    line(ui, 2, &t);
    t.clear();
    t.pushStr("drawn ");
    t.pushInt(drawn.meshes);
    t.pushStr(" meshes, ");
    t.pushInt(drawn.verts);
    t.pushStr(" verts");
    line(ui, 3, &t);
    t.clear();
    ms(&t, "ms gen ", perf.gen);
    ms(&t, "  mesh ", perf.mesh);
    ms(&t, "  lod ", perf.lod);
    ms(&t, "  draw ", perf.draw);
    line(ui, 4, &t);
    t.clear();
    t.pushStr("mesh memory ");
    t.pushInt((chunks.meshVerts(c) + lod.meshVerts(l)) * 40 / 1000000);
    t.pushStr(" MB (cpu cells ");
    t.pushInt(chunks.cellBytes() / 1000000);
    t.pushStr(" MB)");
    line(ui, 5, &t);
    ui.mem.rewind(cp);
}
