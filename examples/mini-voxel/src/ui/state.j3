// State shared by the UI screens.

module mini_voxel.ui.state;

use j3.game;
use j3.game.Font;
use j3.memory.Arena;

pub struct Ui {
    font: Font;
    mem: &Arena; // the app arena; UI text is allocated and rewound within a frame
    paused: bool;
    dragging: bool; // slider grabbed
    debug: bool; // our F3 panel; the engine's overlay toggles on the same key
}

pub fn create(mem: &Arena): Ui {
    return Ui {
        font: game.loadFont("assets/font.ttf", 16),
        mem: mem,
        paused: false,
        dragging: false,
        debug: false,
    };
}
