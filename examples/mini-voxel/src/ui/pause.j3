// Pause menu: render-distance slider, Resume, Quit.

module mini_voxel.ui.pause;

use j3.game;
use j3.math.{ Vec2, clamp, sqrt };
use j3.text.Text;
use mini_voxel.config.{ CHUNK, VIEW_MAX, VIEW_MIN };
use mini_voxel.settings.Settings;
use mini_voxel.ui.state.Ui;
use mini_voxel.ui.widgets;

const PANEL_W: f32 = 380;
const PANEL_H: f32 = 250;
// y offsets from the panel top
const TRACK_Y: f32 = 112;
const RESUME_Y: f32 = 150;
const QUIT_Y: f32 = 196;
const BTN_H: f32 = 36;

pub fn pause(ui: &Ui) {
    ui.paused = true;
    ui.dragging = false;
    game.captureMouse(false);
}

pub fn resume(ui: &Ui) {
    ui.paused = false;
    game.captureMouse(true);
}

// The panel follows the window, so input and drawing agree.
fn panelX(): f32 {
    let sz = game.windowSize();
    return (sz.x - PANEL_W) * 0.5;
}

fn panelY(): f32 {
    let sz = game.windowSize();
    return (sz.y - PANEL_H) * 0.5;
}

pub fn input(ui: &Ui, s: &Settings) {
    let m = game.mousePos();
    let px = panelX(); let py = panelY();
    let bw = PANEL_W - 60;
    if game.mousePressed(game.Mouse.Left) {
        if widgets.inRect(m, px + 24, py + TRACK_Y - 14, PANEL_W - 48, 36) { ui.dragging = true; }
        else if widgets.inRect(m, px + 30, py + RESUME_Y, bw, BTN_H) { resume(ui); return; }
        else if widgets.inRect(m, px + 30, py + QUIT_Y, bw, BTN_H) { game.requestQuit(); }
    }
    if !game.mouseDown(game.Mouse.Left) { ui.dragging = false; }
    if ui.dragging {
        let t = clamp((m.x - (px + 30)) / bw, 0, 1);
        s.view = VIEW_MIN + int(t * t * f32(VIEW_MAX - VIEW_MIN) + 0.5); // squared: fine steps when near
    }
}

pub fn draw(ui: &Ui, s: &Settings) {
    let sz = game.windowSize();
    let px = panelX(); let py = panelY();
    let bw = PANEL_W - 60;
    game.setColor(game.rgba(0, 0, 0, 140));
    game.drawRect(Vec2 { x: 0, y: 0 }, sz);
    game.setColor(game.rgba(20, 24, 32, 235));
    game.drawRect(Vec2 { x: px, y: py }, Vec2 { x: PANEL_W, y: PANEL_H });
    game.setColor(game.rgb(235, 240, 250));
    game.drawText(ui.font, Vec2 { x: px + 30, y: py + 22 }, "Paused");
    let cp = ui.mem.checkpoint();
    let t = Text.new(ui.mem);
    t.pushStr("Render distance: ");
    t.pushInt(s.view);
    t.pushStr(" chunks (");
    t.pushInt(s.view * CHUNK / 10);
    t.pushStr(" m)");
    game.setColor(game.rgb(190, 200, 215));
    game.drawText(ui.font, Vec2 { x: px + 30, y: py + 70 }, t.str());
    ui.mem.rewind(cp);
    // track, filled part, knob
    let frac = sqrt(f32(s.view - VIEW_MIN) / f32(VIEW_MAX - VIEW_MIN));
    game.setColor(game.rgb(60, 68, 86));
    game.drawRect(Vec2 { x: px + 30, y: py + TRACK_Y }, Vec2 { x: bw, y: 8 });
    game.setColor(game.rgb(90, 160, 235));
    game.drawRect(Vec2 { x: px + 30, y: py + TRACK_Y }, Vec2 { x: bw * frac, y: 8 });
    if ui.dragging { game.setColor(game.rgb(255, 255, 255)); } else { game.setColor(game.rgb(220, 230, 245)); }
    game.drawRect(Vec2 { x: px + 30 + bw * frac - 6, y: py + TRACK_Y - 8 }, Vec2 { x: 12, y: 24 });
    widgets.button(ui.font, px + 30, py + RESUME_Y, bw, BTN_H, "Resume");
    widgets.button(ui.font, px + 30, py + QUIT_Y, bw, BTN_H, "Quit");
}
