// In-game overlay: crosshair. Hotbar and vitals will draw here.

module mini_voxel.ui.hud;

use j3.game;
use j3.math.Vec2;

pub fn crosshair() {
    let sz = game.windowSize();
    let x = sz.x * 0.5; let y = sz.y * 0.5;
    game.setColor(game.rgba(0, 0, 0, 170));
    game.drawRect(Vec2 { x: x - 11, y: y - 2 }, Vec2 { x: 22, y: 4 });
    game.drawRect(Vec2 { x: x - 2, y: y - 11 }, Vec2 { x: 4, y: 22 });
    game.setColor(game.rgb(255, 255, 255));
    game.drawRect(Vec2 { x: x - 10, y: y - 1 }, Vec2 { x: 20, y: 2 });
    game.drawRect(Vec2 { x: x - 1, y: y - 10 }, Vec2 { x: 2, y: 20 });
}
