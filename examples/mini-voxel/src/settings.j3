// Player settings that other systems read.

module mini_voxel.settings;

use mini_voxel.config.{ BENCH_VIEW, VIEW_START };

pub struct Settings {
    view: int; // render distance in columns, VIEW_MIN..VIEW_MAX
}

pub fn create(): Settings {
    return Settings { view: if BENCH_VIEW > 0 { BENCH_VIEW } else { VIEW_START } };
}
