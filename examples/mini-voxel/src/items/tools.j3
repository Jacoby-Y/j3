// What the primary click does. Today: dig a sphere where you aim. Placing, other tools and the
// held item (items/inventory.j3) will pick the action here.

module mini_voxel.items.tools;

use mini_voxel.config.{ DIG_R, REACH };
use mini_voxel.physics.collide;
use mini_voxel.player.player;
use mini_voxel.player.player.Player;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;

/// Carve a DIG_R-cell-radius sphere around the cell; setCell flags the chunks that change.
pub fn dig(c: &Chunks, cx: int, cy: int, cz: int) {
    let r = DIG_R;
    let z = cz - r;
    while z <= cz + r {
        let y = cy - r;
        while y <= cy + r {
            let x = cx - r;
            while x <= cx + r {
                let dx = x - cx; let dy = y - cy; let dz = z - cz;
                if dx * dx + dy * dy + dz * dz <= r * r { chunks.setCell(c, x, y, z, 0); }
                x += 1;
            }
            y += 1;
        }
        z += 1;
    }
}

/// Primary click: dig what the player looks at.
pub fn primary(c: &Chunks, p: &Player) {
    let look = player.look(p);
    let hit = collide.raycast(c, look.eye, look.forward(), REACH);
    if hit.ok { dig(c, hit.x, hit.y, hit.z); }
}
