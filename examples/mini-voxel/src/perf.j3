// Per-stage frame timings for the F3 panel, smoothed over ~16 frames. Milliseconds.

module mini_voxel.perf;

pub struct Perf {
    gen: f32;
    mesh: f32;
    lod: f32;
    draw: f32;
}

pub fn create(): Perf {
    return Perf { gen: 0, mesh: 0, lod: 0, draw: 0 };
}

fn ease(a: f32, us: int): f32 {
    return a + (f32(us) / 1000.0 - a) / 16.0;
}

/// Fold one frame's stage times (microseconds) into the averages.
pub fn record(p: &Perf, gen: int, mesh: int, lod: int, draw: int) {
    p.gen = ease(p.gen, gen);
    p.mesh = ease(p.mesh, mesh);
    p.lod = ease(p.lod, lod);
    p.draw = ease(p.draw, draw);
}
