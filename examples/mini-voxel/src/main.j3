// mini-voxel: an open-world voxel sandbox, 0.1 m voxels, one island in an ocean.
//
// Layout (one folder per system; every file is a module `mini_voxel.<folder>.<file>`):
//   config.j3, settings.j3   tuning constants, player settings (render distance)
//   perf.j3                  per-stage frame timings for the F3 panel
//   util/                    integer helpers
//   gen/                     noise, terrain, biome, structure (trees)
//   world/                   blocks, chunk storage, generation and meshing schedulers
//   render/                  chunk mesher, LOD tiles (lod, lod_mesher), world draw; sky stub
//   physics/                 collision window, raycast
//   player/                  body and movement; vitals stub
//   items/                   tools; inventory and crafting stubs
//   entities/, data/         stubs: mobs, saving
//   ui/                      pause menu, HUD, F3 panel, widgets

module mini_voxel;

use j3.app.App;
use j3.game;
use j3.gfx;
use j3.gfx.Look;
use j3.io.printLn;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.text.Text;
use mini_voxel.config.{ BENCH_AWAY, CHUNK, FRAME_US, K, NEAR, VIEW_MAX, VOXEL };
use mini_voxel.gen.terrain;
use mini_voxel.items.tools;
use mini_voxel.perf;
use mini_voxel.perf.Perf;
use mini_voxel.player.player;
use mini_voxel.player.player.Player;
use mini_voxel.render.lod;
use mini_voxel.render.lod.Lod;
use mini_voxel.render.mesher;
use mini_voxel.render.mesher.Mesher;
use mini_voxel.render.world_draw;
use mini_voxel.render.world_draw.DrawStats;
use mini_voxel.settings;
use mini_voxel.settings.Settings;
use mini_voxel.ui.debug;
use mini_voxel.ui.hud;
use mini_voxel.ui.pause;
use mini_voxel.ui.state;
use mini_voxel.ui.state.Ui;
use mini_voxel.util.spiral;
use mini_voxel.util.spiral.Spiral;
use mini_voxel.util.time;
use mini_voxel.world.chunks;
use mini_voxel.world.chunks.Chunks;
use mini_voxel.world.stream;
use mini_voxel.world.stream.Sched;

struct World {
    chunks: Chunks;
    mesher: Mesher;
    lod: Lod;
    perf: Perf;
    player: Player;
    settings: Settings;
    ui: Ui;
    drawn: DrawStats;
    sched: Sched;
    genOrder: Spiral; // columns by distance, out to the generate radius
    lodOrder: Spiral; // tiles by distance, out to K
}

fn boot(mem: &Arena): World {
    return World {
        chunks: chunks.create(mem),
        mesher: mesher.create(mem),
        lod: lod.create(mem),
        perf: perf.create(),
        player: player.create(mem, 0, f32(terrain.heightAt(0, 0) + 20), 0),
        settings: settings.create(),
        ui: state.create(mem),
        drawn: DrawStats { meshes: 0, verts: 0 },
        sched: stream.sched(),
        genOrder: spiral.create(mem, NEAR + 2),
        lodOrder: spiral.create(mem, K),
    };
}

// Bench hook (BENCH_AWAY): carve a trench at the origin, then stand BENCH_AWAY columns off looking back.
fn benchAway(w: &World) {
    let dz = -12;
    while dz <= 12 {
        let x = -48;
        while x <= 48 {
            let d = 2;
            while d <= 14 {
                tools.dig(&w.chunks, x, terrain.heightAt(x, dz) - d, dz);
                d += 6;
            }
            x += 6;
        }
        dz += 6;
    }
    stream.syncEdits(&w.chunks, &w.lod);
    let z = BENCH_AWAY * CHUNK;
    w.player.body.pos.z = f32(z);
    w.player.body.pos.y = f32(terrain.heightAt(0, z) + 20);
    w.player.pitch = -0.2;
    let g = lod.focus(0, BENCH_AWAY, w.settings.view);
    stream.generate(&w.chunks, &w.genOrder, 0, BENCH_AWAY, g.gen, 0);
    stream.remesh(&w.chunks, &w.mesher, &w.genOrder, 0, BENCH_AWAY, g.mesh, 0);
    lod.build(&w.lod, &w.mesher, &w.chunks.edits, &g, &w.lodOrder, 0);
}

fn startup(w: &World) {
    gfx.init();
    gfx.setClip(0.05, f32(VIEW_MAX + 20) * f32(CHUNK) * VOXEL);
    let f = lod.focus(0, 0, w.settings.view);
    stream.generate(&w.chunks, &w.genOrder, 0, 0, f.gen, 0);
    stream.remesh(&w.chunks, &w.mesher, &w.genOrder, 0, 0, f.mesh, 0);
    lod.build(&w.lod, &w.mesher, &w.chunks.edits, &f, &w.lodOrder, 0);
    if BENCH_AWAY > 0 { benchAway(w); }
    let mem = Arena.create(256);
    let t = Text.new(&mem);
    t.pushStr("mini-voxel start vertices: ");
    t.pushInt(chunks.meshVerts(&w.chunks) + lod.meshVerts(&w.lod));
    printLn(t.str());
    mem.destroy();
}

fn update(w: &World, dt: f32) {
    if game.keyPressed(game.Key.F3) { w.ui.debug = !w.ui.debug; }
    if game.keyPressed(game.Key.Escape) {
        if w.ui.paused { pause.resume(&w.ui); } else { pause.pause(&w.ui); }
    }
    if w.ui.paused {
        pause.input(&w.ui, &w.settings);
        return;
    }
    if game.mousePressed(game.Mouse.Left) {
        if !game.mouseCaptured() { game.captureMouse(true); } else { tools.primary(&w.chunks, &w.player); }
    }
    player.update(&w.player, &w.chunks, dt);
}

fn draw(w: &World) {
    let f = lod.focus(player.columnX(&w.player), player.columnZ(&w.player), w.settings.view);
    stream.syncEdits(&w.chunks, &w.lod);
    stream.watch(&w.sched, f.pcx, f.pcz, f.view, w.chunks.version, w.lod.version);
    let t0 = game.micros();
    let deadline = time.after(FRAME_US);
    if !w.sched.genDone { w.sched.genDone = stream.generate(&w.chunks, &w.genOrder, f.pcx, f.pcz, f.gen, deadline); }
    let t1 = game.micros();
    if !w.sched.meshDone { w.sched.meshDone = stream.remesh(&w.chunks, &w.mesher, &w.genOrder, f.pcx, f.pcz, f.mesh, deadline); }
    let t2 = game.micros();
    if !w.sched.lodDone { w.sched.lodDone = lod.build(&w.lod, &w.mesher, &w.chunks.edits, &f, &w.lodOrder, deadline); }
    let t3 = game.micros();

    gfx.setFog(f32(f.view - 3) * f32(CHUNK) * VOXEL, f32(f.view - 1) * f32(CHUNK) * VOXEL);
    let eye = player.look(&w.player);
    let cam = Look.create(eye.eye * VOXEL, eye.yaw, eye.pitch);
    gfx.cameraPassLook(cam, Vec3.xyz(-0.4, 1, 0.5), Vec3.xyz(0.5, 0.7, 0.95), Vec3.xyz(1, 1, 1));
    w.drawn = world_draw.drawWorld(&w.chunks, &w.lod, f);
    perf.record(&w.perf, t1 - t0, t2 - t1, t3 - t2, game.micros() - t3);

    if w.ui.paused { pause.draw(&w.ui, &w.settings); return; }
    if w.ui.debug { debug.draw(&w.ui, &w.player, &w.chunks, &w.lod, w.drawn, &w.perf, &f); }
    hud.crosshair();
}

fn main() {
    let app = App<World>.create("mini-voxel", 1280, 720, boot);
    app.useGl();
    app.startup(startup);
    app.always(update);
    app.draw(draw);
    app.run();
}
