// The player: body, mouse look, walking, jumping, and the smoothed eye.

module mini_voxel.player.player;

use j3.game;
use j3.game.physics.Body3;
use j3.gfx.Look;
use j3.math.{ Vec3, cos, exp, floor, sin };
use j3.memory.Arena;
use mini_voxel.config.{ CHUNK, SY, WIN };
use mini_voxel.physics.collide;
use mini_voxel.physics.collide.Collider;
use mini_voxel.util.grid.fdiv;
use mini_voxel.world.chunks.Chunks;

pub struct Player {
    body: Body3;
    yaw: f32;
    pitch: f32;
    onGround: bool;
    eyeY: f32;
    col: Collider;
}

pub fn create(mem: &Arena, x: f32, y: f32, z: f32): Player {
    return Player {
        body: Body3.make(Vec3.xyz(x, y, z), Vec3.xyz(0, 0, 0), Vec3.xyz(3, 8, 3), 1),
        yaw: 0,
        pitch: 0,
        onGround: false,
        eyeY: 0,
        col: collide.create(mem),
    };
}

/// Column the player stands in.
pub fn columnX(p: &Player): int {
    return fdiv(int(floor(p.body.pos.x)), CHUNK);
}

pub fn columnZ(p: &Player): int {
    return fdiv(int(floor(p.body.pos.z)), CHUNK);
}

/// Eye camera, in cells.
pub fn look(p: &Player): Look {
    return Look.create(Vec3.xyz(p.body.pos.x, p.eyeY, p.body.pos.z), p.yaw, p.pitch);
}

/// One frame: mouse look (when captured), walk, jump, gravity, eye smoothing.
pub fn update(p: &Player, c: &Chunks, dt: f32) {
    if game.mouseCaptured() {
        let d = game.mouseDelta();
        p.yaw += d.x * 0.003;
        p.pitch -= d.y * 0.003;
        if p.pitch > 1.5 { p.pitch = 1.5; }
        if p.pitch < -1.5 { p.pitch = -1.5; }
    }
    let fwd: f32 = 0;
    let side: f32 = 0;
    if game.keyDown(game.Key.W) { fwd += 1; }
    if game.keyDown(game.Key.S) { fwd -= 1; }
    if game.keyDown(game.Key.D) { side += 1; }
    if game.keyDown(game.Key.A) { side -= 1; }
    let speed: f32 = 45; // cells/s = 4.5 m/s
    if game.keyDown(game.Key.Shift) { speed = 90; }
    let fx = sin(p.yaw); let fz = -cos(p.yaw);
    let rx = cos(p.yaw); let rz = sin(p.yaw);

    // physics runs in window-local coordinates, then the body is shifted back to the world
    let ox = int(floor(p.body.pos.x)) - WIN / 2;
    let oz = int(floor(p.body.pos.z)) - WIN / 2;
    collide.fillWindow(&p.col, c, ox, oz);
    p.body.pos.x -= f32(ox);
    p.body.pos.z -= f32(oz);
    p.onGround = collide.grounded(&p.col, &p.body);
    collide.walk(&p.col, &p.body, p.onGround, (fx * fwd + rx * side) * speed * dt, (fz * fwd + rz * side) * speed * dt);
    p.body.vel.x = 0; p.body.vel.z = 0;
    if p.onGround && game.keyPressed(game.Key.Space) { p.body.vel.y = 40; }
    p.body.stepGrid(dt, Vec3.xyz(0, -98, 0), p.col.win, WIN, SY, WIN);
    p.onGround = collide.grounded(&p.col, &p.body);
    p.body.pos.x += f32(ox);
    p.body.pos.z += f32(oz);

    // eye eases toward the body so 1-voxel steps glide instead of snapping
    let target = p.body.pos.y + 6;
    if p.eyeY == 0 { p.eyeY = target; }
    let k: f32 = 1.0 - exp(-18.0 * dt);
    p.eyeY += (target - p.eyeY) * k;
}
