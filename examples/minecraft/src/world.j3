// Explorable textured voxel valley with a glass/metal material showcase.

module minecraft.world;

use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.gfx.{
    FACE_NX, FACE_NY, FACE_NZ, FACE_PX, FACE_PY, FACE_PZ, Look, Mesh, Tex,
};
use j3.io;
use j3.math.{ Mat4, Vec2, Vec3, clamp, floor, lerp, sin };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.ui.Ui;
use j3.gfx.voxel;
use j3.gfx.voxel.Hit;
use minecraft.post;

pub const SX: int = 48;
pub const SY: int = 32;
pub const SZ: int = 48;
const MAX_SPECIAL: int = 64;

const AIR: u8 = 0;
const GRASS: u8 = 1;
const DIRT: u8 = 2;
const STONE: u8 = 3;
const SAND: u8 = 4;
const WOOD: u8 = 5;
const LEAF: u8 = 6;
const PLANK: u8 = 7;
const GLASS: u8 = 8;
const METAL: u8 = 9;
const GRAVEL: u8 = 10;
const COPPER: u8 = 11;

const REACH: f32 = 6;
const EYE: f32 = 1.62;
const BODY: f32 = 1.7;
const RADIUS: f32 = 0.28;
const WALK: f32 = 4.6;
const GRAV: f32 = 22;
const JUMP: f32 = 7.4;

#[singleton]
let FACE: [60]f32;

pub struct World {
    cells: []u8;
    mesh: Mesh;
    metalShadow: Mesh;
    atlas: Tex;
    font: Font;
    special: []f32;
    specialCount: int;
    pos: Vec3;
    vel: Vec3;
    yaw: f32;
    pitch: f32;
    slot: int;
    onGround: bool;
    dirty: bool;
    ao: bool;
    hud: bool;
    menu: bool;
    shafts: f32;
    exposure: f32;
    ior: f32;
    roughness: f32;
    hit: Hit;
}

fn emptyMesh(): Mesh {
    return Mesh { vao: 0, vbo: 0, count: 0 };
}

fn modp(a: int, m: int): int {
    let q = a;
    if q < 0 {
        q = 0 - q;
    }
    return q - (q / m) * m;
}

fn hash(x: int, z: int): f32 {
    let n = modp(x * x * 17 + z * z * 31 + x * z * 19 + x * 127 + z * 311, 1021);
    return f32(n) / 1021;
}

fn noise(x: f32, z: f32): f32 {
    let ix = int(floor(x));
    let iz = int(floor(z));
    let fx = x - f32(ix);
    let fz = z - f32(iz);
    let sx = fx * fx * (3 - 2 * fx);
    let sz = fz * fz * (3 - 2 * fz);
    return lerp(lerp(hash(ix, iz), hash(ix + 1, iz), sx),
                lerp(hash(ix, iz + 1), hash(ix + 1, iz + 1), sx), sz);
}

fn heightAt(x: int, z: int): int {
    let xf = f32(x);
    let zf = f32(z);
    let wide = noise(xf / 18, zf / 18) * 10;
    let detail = noise(xf / 6, zf / 6) * 3.3;
    let ridge = 2.2 * sin(xf * 0.15 + zf * 0.09);
    let h = 5 + int(wide + detail + ridge);
    if h < 4 { h = 4; }
    if h > 18 { h = 18; }
    return h;
}

fn column(cells: []u8, x: int, z: int) {
    let h = heightAt(x, z);
    let y = 0;
    while y <= h {
        let id: u8 = STONE;
        if y == h {
            id = GRASS;
            if h <= 6 { id = SAND; }
            if h >= 16 { id = GRAVEL; }
        } else if y >= h - 3 {
            id = DIRT;
            if h <= 6 { id = SAND; }
        } else if hash(x + y * 9, z + y * 13) > 0.965 {
            id = COPPER;
        }
        voxel.set(cells, SX, SY, SZ, x, y, z, id);
        y += 1;
    }
}

fn tree(cells: []u8, x: int, z: int) {
    let h = heightAt(x, z);
    if h <= 6 || h >= 16 {
        return;
    }
    let tall = 4 + int(hash(x + 11, z + 17) * 3);
    let t = 0;
    while t < tall {
        voxel.set(cells, SX, SY, SZ, x, h + 1 + t, z, WOOD);
        t += 1;
    }
    let y = h + tall - 2;
    while y <= h + tall + 1 {
        let dz = 0 - 2;
        while dz <= 2 {
            let dx = 0 - 2;
            while dx <= 2 {
                let skip = dx == 0 && dz == 0 && y < h + tall;
                let crown = dx * dx + dz * dz <= 5;
                if y == h + tall + 1 { crown = dx * dx + dz * dz <= 2; }
                if !skip && crown {
                    if voxel.get(cells, SX, SY, SZ, x + dx, y, z + dz) == AIR {
                        voxel.set(cells, SX, SY, SZ, x + dx, y, z + dz, LEAF);
                    }
                }
                dx += 1;
            }
            dz += 1;
        }
        y += 1;
    }
}

fn showcase(cells: []u8) {
    let x0 = SX / 2 + 3;
    let z0 = SZ / 2 - 10;
    let h = heightAt(x0 + 3, z0 + 3) + 1;
    let x = x0;
    while x <= x0 + 6 {
        let z = z0;
        while z <= z0 + 6 {
            let y = 0;
            while y <= h + 5 {
                if y <= h {
                    voxel.set(cells, SX, SY, SZ, x, y, z, STONE);
                } else {
                    voxel.set(cells, SX, SY, SZ, x, y, z, AIR);
                }
                y += 1;
            }
            voxel.set(cells, SX, SY, SZ, x, h, z, PLANK);
            z += 1;
        }
        x += 1;
    }
    let pillarY = h + 1;
    while pillarY <= h + 3 {
        voxel.set(cells, SX, SY, SZ, x0, pillarY, z0, METAL);
        voxel.set(cells, SX, SY, SZ, x0 + 6, pillarY, z0, METAL);
        voxel.set(cells, SX, SY, SZ, x0, pillarY, z0 + 6, METAL);
        voxel.set(cells, SX, SY, SZ, x0 + 6, pillarY, z0 + 6, METAL);
        let gx = x0 + 1;
        while gx < x0 + 6 {
            voxel.set(cells, SX, SY, SZ, gx, pillarY, z0, GLASS);
            gx += 1;
        }
        pillarY += 1;
    }
    voxel.set(cells, SX, SY, SZ, x0 + 3, h + 1, z0 + 3, METAL);
    voxel.set(cells, SX, SY, SZ, x0 + 3, h + 2, z0 + 3, GLASS);
    voxel.set(cells, SX, SY, SZ, x0 + 2, h + 2, z0 + 3, GLASS);
    voxel.set(cells, SX, SY, SZ, x0 + 4, h + 2, z0 + 3, GLASS);
}

fn generate(cells: []u8) {
    let z = 0;
    while z < SZ {
        let x = 0;
        while x < SX {
            column(cells, x, z);
            x += 1;
        }
        z += 1;
    }
    let cx = SX / 2;
    let cz = SZ / 2;
    z = 2;
    while z < SZ - 2 {
        x = 2;
        while x < SX - 2 {
            let near = x > cx - 5 && x < cx + 12 && z > cz - 13 && z < cz + 6;
            if !near && hash(x + 29, z + 57) > 0.94 {
                tree(cells, x, z);
            }
            x += 1;
        }
        z += 1;
    }
    showcase(cells);
}

pub fn boot(mem: &Arena): World {
    let cells = mem.alloc::<u8>(SX * SY * SZ);
    let i = 0;
    while i < cells.len {
        cells[i] = AIR;
        i += 1;
    }
    generate(cells);
    let x = SX / 2 - 2;
    let z = SZ / 2 + 5;
    let h = heightAt(x, z);
    let special = mem.alloc::<f32>(MAX_SPECIAL * 4);
    return World {
        cells: cells,
        mesh: emptyMesh(),
        metalShadow: emptyMesh(),
        atlas: Tex { id: 0, w: 0, h: 0 },
        font: Font { raw: 0 },
        special: special,
        specialCount: 0,
        pos: Vec3.xyz(f32(x) + 0.5, f32(h + 1), f32(z) + 0.5),
        vel: Vec3.xyz(0, 0, 0),
        yaw: 0.55,
        pitch: -0.09,
        slot: 8,
        onGround: false,
        dirty: true,
        ao: true,
        hud: true,
        menu: false,
        shafts: 0.75,
        exposure: 1.08,
        ior: 1.52,
        roughness: 0.14,
        hit: Hit { ok: false, x: 0, y: 0, z: 0, px: 0, py: 0, pz: 0, face: 0 },
    };
}

fn tint(id: u8): Vec3 {
    if id == GRASS {
        return Vec3.xyz(0.34, 0.62, 0.28);
    }
    if id == DIRT {
        return Vec3.xyz(0.45, 0.3, 0.18);
    }
    if id == STONE {
        return Vec3.xyz(0.55, 0.56, 0.58);
    }
    if id == SAND {
        return Vec3.xyz(0.86, 0.8, 0.52);
    }
    if id == WOOD {
        return Vec3.xyz(0.42, 0.28, 0.14);
    }
    if id == LEAF {
        return Vec3.xyz(0.22, 0.5, 0.2);
    }
    if id == PLANK { return Vec3.xyz(0.72, 0.55, 0.32); }
    if id == GLASS { return Vec3.xyz(0.27, 0.72, 0.79); }
    if id == METAL { return Vec3.xyz(0.70, 0.76, 0.79); }
    if id == GRAVEL { return Vec3.xyz(0.51, 0.53, 0.50); }
    return Vec3.xyz(0.63, 0.39, 0.22);
}

fn tile(id: u8, dir: int): int {
    if id == GRASS {
        if dir == FACE_PY { return 0; }
        if dir == FACE_NY { return 2; }
        return 1;
    }
    if id == DIRT { return 2; }
    if id == STONE { return 3; }
    if id == SAND { return 4; }
    if id == WOOD {
        if dir == FACE_PY || dir == FACE_NY { return 6; }
        return 5;
    }
    if id == LEAF { return 7; }
    if id == PLANK { return 8; }
    if id == GRAVEL { return 9; }
    return 10;
}

fn emitSide(cells: []u8, out: []f32, at: int, x: int, y: int, z: int, dir: int, id: u8, ao: bool): int {
    let c = Vec3.xyz(1, 1, 1);
    let used = 0;
    if ao {
        let k = voxel.corners(cells, SX, SY, SZ, x, y, z, dir);
        used = gfx.emitFaceAo(FACE, 0, f32(x), f32(y), f32(z), dir, c.x, c.y, c.z, 0,
                              voxel.shade(k.a), voxel.shade(k.b), voxel.shade(k.c), voxel.shade(k.d));
    } else {
        used = gfx.emitFace(FACE, 0, f32(x), f32(y), f32(z), dir, 1, 1, 1, 0);
    }
    let tex = tile(id, dir);
    let tx = tex - (tex / 8) * 8;
    let ty = tex / 8;
    let i = 0;
    while i < used / 10 {
        let src = i * 10;
        let dst = at + i * 12;
        let j = 0;
        while j < 10 {
            out[dst + j] = FACE[src + j];
            j += 1;
        }
        let u = FACE[src] - f32(x);
        let v = FACE[src + 1] - f32(y);
        if dir == FACE_PY || dir == FACE_NY {
            v = FACE[src + 2] - f32(z);
        } else if dir == FACE_PX || dir == FACE_NX {
            u = FACE[src + 2] - f32(z);
        }
        // Keep UVs two texels inside each 32px tile to avoid mip bleed.
        out[dst + 10] = (f32(tx) * 32 + 2 + u * 28) / 256;
        out[dst + 11] = (f32(ty) * 32 + 2 + v * 28) / 64;
        i += 1;
    }
    return at + (used / 10) * 12;
}

fn openFace(id: u8): bool { return id == AIR || id == GLASS || id == METAL; }

fn emitExposed(cells: []u8, out: []f32, at: int, x: int, y: int, z: int, id: u8, ao: bool): int {
    if openFace(voxel.get(cells, SX, SY, SZ, x - 1, y, z)) {
        at = emitSide(cells, out, at, x, y, z, FACE_NX, id, ao);
    }
    if openFace(voxel.get(cells, SX, SY, SZ, x + 1, y, z)) {
        at = emitSide(cells, out, at, x, y, z, FACE_PX, id, ao);
    }
    if openFace(voxel.get(cells, SX, SY, SZ, x, y - 1, z)) {
        at = emitSide(cells, out, at, x, y, z, FACE_NY, id, ao);
    }
    if openFace(voxel.get(cells, SX, SY, SZ, x, y + 1, z)) {
        at = emitSide(cells, out, at, x, y, z, FACE_PY, id, ao);
    }
    if openFace(voxel.get(cells, SX, SY, SZ, x, y, z - 1)) {
        at = emitSide(cells, out, at, x, y, z, FACE_NZ, id, ao);
    }
    if openFace(voxel.get(cells, SX, SY, SZ, x, y, z + 1)) {
        at = emitSide(cells, out, at, x, y, z, FACE_PZ, id, ao);
    }
    return at;
}

fn bakeWorld(w: &World, out: []f32): int {
    let at = 0;
    let y = 0;
    while y < SY {
        let z = 0;
        while z < SZ {
            let x = 0;
            while x < SX {
                let id = voxel.get(w.cells, SX, SY, SZ, x, y, z);
                if id != AIR && id != GLASS && id != METAL {
                    at = emitExposed(w.cells, out, at, x, y, z, id, w.ao);
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return at;
}

fn bakeCube(out: []f32, r: f32, g: f32, b: f32, emi: f32): int {
    let o: f32 = f32(0) - 0.5;
    let at = 0;
    at = gfx.emitFace(out, at, o, o, o, FACE_NX, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PX, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_NY, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PY, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_NZ, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PZ, r, g, b, emi);
    return at;
}

fn remesh(w: &World) {
    let n = (voxel.countFaces(w.cells, SX, SY, SZ) + MAX_SPECIAL * 6) * 72;
    if n < 72 { n = 72; }
    let scratch = Arena.create(n * 4 + 64);
    let verts = scratch.alloc::<f32>(n);
    let used = bakeWorld(w, verts);
    let slice = []f32 { ptr: verts.ptr, len: used };
    if w.mesh.vao == 0 {
        w.mesh = gfx.uploadUv(slice);
    } else {
        gfx.updateUv(&w.mesh, slice);
    }
    scratch.destroy();
    post.updateCells(w.cells, SX, SY, SZ);
    w.specialCount = 0;
    let y = 0;
    while y < SY {
        let z = 0;
        while z < SZ {
            let x = 0;
            while x < SX {
                let id = voxel.get(w.cells, SX, SY, SZ, x, y, z);
                if (id == GLASS || id == METAL) && w.specialCount < MAX_SPECIAL {
                    let at = w.specialCount * 4;
                    w.special[at] = f32(x);
                    w.special[at + 1] = f32(y);
                    w.special[at + 2] = f32(z);
                    if id == GLASS { w.special[at + 3] = 1; }
                    else { w.special[at + 3] = 2; }
                    w.specialCount += 1;
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    w.dirty = false;
}

fn cubeMesh(r: f32, g: f32, b: f32, emi: f32): Mesh {
    let scratch = Arena.create(360 * 4 + 64);
    let verts = scratch.alloc::<f32>(360);
    let used = bakeCube(verts, r, g, b, emi);
    let mesh = gfx.upload([]f32 { ptr: verts.ptr, len: used });
    scratch.destroy();
    return mesh;
}

pub fn startup(w: &World) {
    gfx.init();
    gfx.setFog(34, 78);
    game.captureMouse(true);
    remesh(w);
    w.metalShadow = cubeMesh(1, 1, 1, 0);
    let scratch = Arena.create(2 * 1024 * 1024);
    let rgba = game.loadRgba("assets/blocks.png", &scratch);
    if rgba.pixels.len == 0 { panic("assets/blocks.png"); }
    w.atlas = gfx.tex(rgba.pixels, rgba.w, rgba.h);
    match io.readFile("assets/blocks.frag", &scratch) {
        Result.Ok(bytes) { post.init(bytes as string); }
        Result.Err(_) { panic("assets/blocks.frag"); }
    }
    scratch.destroy();
    w.font = game.loadFont("../dungeon/assets/font.ttf", 16);
}

fn eyeOf(w: &World): Look {
    return Look.create(Vec3.xyz(w.pos.x, w.pos.y + EYE, w.pos.z), w.yaw, w.pitch);
}

fn held(slot: int): u8 {
    if slot == 1 {
        return GRASS;
    }
    if slot == 2 {
        return DIRT;
    }
    if slot == 3 {
        return STONE;
    }
    if slot == 4 {
        return SAND;
    }
    if slot == 5 {
        return WOOD;
    }
    if slot == 6 {
        return LEAF;
    }
    if slot == 7 { return PLANK; }
    if slot == 8 { return GLASS; }
    return METAL;
}

fn pick(w: &World) {
    if game.keyPressed(game.Key.Num1) {
        w.slot = 1;
    }
    if game.keyPressed(game.Key.Num2) {
        w.slot = 2;
    }
    if game.keyPressed(game.Key.Num3) {
        w.slot = 3;
    }
    if game.keyPressed(game.Key.Num4) {
        w.slot = 4;
    }
    if game.keyPressed(game.Key.Num5) {
        w.slot = 5;
    }
    if game.keyPressed(game.Key.Num6) {
        w.slot = 6;
    }
    if game.keyPressed(game.Key.Num7) {
        w.slot = 7;
    }
    if game.keyPressed(game.Key.Num8) { w.slot = 8; }
    if game.keyPressed(game.Key.Num9) { w.slot = 9; }
}

fn aim(w: &World) {
    let cam = eyeOf(w);
    w.hit = voxel.ray(w.cells, SX, SY, SZ, cam.eye, cam.forward(), REACH);
}

fn blocksBody(w: &World, x: int, y: int, z: int): bool {
    let minx = w.pos.x - RADIUS;
    let maxx = w.pos.x + RADIUS;
    let miny = w.pos.y;
    let maxy = w.pos.y + BODY;
    let minz = w.pos.z - RADIUS;
    let maxz = w.pos.z + RADIUS;
    if maxx <= f32(x) || minx >= f32(x + 1) {
        return false;
    }
    if maxy <= f32(y) || miny >= f32(y + 1) {
        return false;
    }
    if maxz <= f32(z) || minz >= f32(z + 1) {
        return false;
    }
    return true;
}

fn edit(w: &World) {
    if !w.hit.ok {
        return;
    }
    if game.mousePressed(game.Mouse.Left) && w.hit.y > 0 {
        voxel.set(w.cells, SX, SY, SZ, w.hit.x, w.hit.y, w.hit.z, AIR);
        w.dirty = true;
    }
    if game.mousePressed(game.Mouse.Right) {
        let same = w.hit.px == w.hit.x && w.hit.py == w.hit.y && w.hit.pz == w.hit.z;
        if !same && voxel.inside(w.hit.px, w.hit.py, w.hit.pz, SX, SY, SZ) {
            if voxel.get(w.cells, SX, SY, SZ, w.hit.px, w.hit.py, w.hit.pz) == AIR {
                if !blocksBody(w, w.hit.px, w.hit.py, w.hit.pz) {
                    let id = held(w.slot);
                    if (id != GLASS && id != METAL) || w.specialCount < MAX_SPECIAL {
                        voxel.set(w.cells, SX, SY, SZ, w.hit.px, w.hit.py, w.hit.pz, id);
                        w.dirty = true;
                    }
                }
            }
        }
    }
}

pub fn input(w: &World, dt: f32) {
    if game.keyPressed(game.Key.Q) {
        game.requestQuit();
    }
    if game.keyPressed(game.Key.H) { w.hud = !w.hud; }
    // F3 is the built-in profiler overlay.
    if game.keyPressed(game.Key.O) {
        w.ao = !w.ao;
        w.dirty = true;
    }
    let looking = game.mouseCaptured();
    if game.keyPressed(game.Key.Escape) {
        game.captureMouse(!looking);
        looking = game.mouseCaptured();
        w.menu = !looking;
    }
    if !looking && game.mousePressed(game.Mouse.Left) && !w.menu {
        game.captureMouse(true);
        return;
    }
    pick(w);
    if looking {
        let wheel = game.mouseWheel();
        if wheel > 0 { w.slot -= 1; }
        if wheel < 0 { w.slot += 1; }
        if w.slot < 1 { w.slot = 9; }
        if w.slot > 9 { w.slot = 1; }
    }
    if looking {
        let d = game.mouseDelta();
        w.yaw = w.yaw + d.x * 0.003;
        w.pitch = clamp(w.pitch - d.y * 0.003, -1.4, 1.4);
        aim(w);
        edit(w);
    } else {
        w.hit.ok = false;
    }
}

fn bodyHits(w: &World, dx: f32, dy: f32, dz: f32): bool {
    let p = w.pos;
    return voxel.overlaps(
        w.cells,
        SX,
        SY,
        SZ,
        Vec3.xyz(p.x - RADIUS + dx, p.y + dy, p.z - RADIUS + dz),
        Vec3.xyz(p.x + RADIUS + dx, p.y + BODY + dy, p.z + RADIUS + dz),
    );
}

fn nudge(w: &World, dx: f32, dy: f32, dz: f32): bool {
    if bodyHits(w, dx, dy, dz) {
        return false;
    }
    w.pos.x = w.pos.x + dx;
    w.pos.y = w.pos.y + dy;
    w.pos.z = w.pos.z + dz;
    return true;
}

fn stepAxis(w: &World, dx: f32, dz: f32) {
    if dx == 0 && dz == 0 {
        return;
    }
    if nudge(w, dx, 0, dz) {
        return;
    }
    if w.onGround && nudge(w, 0, 1, 0) {
        if !nudge(w, dx, 0, dz) {
            nudge(w, 0, -1, 0);
        }
    }
}

fn wish(w: &World): Vec3 {
    let cam = eyeOf(w);
    let fwd = cam.forward();
    fwd.y = 0;
    let fl = fwd.length();
    if fl > 0.001 {
        fwd = fwd * (f32(1) / fl);
    }
    let x: f32 = 0;
    let z: f32 = 0;
    if game.keyDown(game.Key.W) {
        x = x + fwd.x;
        z = z + fwd.z;
    }
    if game.keyDown(game.Key.S) {
        x = x - fwd.x;
        z = z - fwd.z;
    }
    let side = cam.right();
    if game.keyDown(game.Key.D) {
        x = x + side.x;
        z = z + side.z;
    }
    if game.keyDown(game.Key.A) {
        x = x - side.x;
        z = z - side.z;
    }
    let len = sqrt2(x, z);
    if len > 1 {
        x = x / len;
        z = z / len;
    }
    return Vec3.xyz(x * WALK, 0, z * WALK);
}

fn sqrt2(x: f32, z: f32): f32 {
    return Vec3.xyz(x, 0, z).length();
}

fn fall(w: &World, dy: f32) {
    if dy == 0 {
        return;
    }
    if dy > 0 {
        if !nudge(w, 0, dy, 0) {
            w.vel.y = 0;
        }
        return;
    }
    let left = dy;
    while left < 0 {
        let s: f32 = 0.05;
        if f32(0) - left < s {
            s = f32(0) - left;
        }
        if !nudge(w, 0, f32(0) - s, 0) {
            w.onGround = true;
            w.vel.y = 0;
            return;
        }
        left = left + s;
        w.onGround = false;
    }
}

pub fn tick(w: &World, dt: f32) {
    if w.onGround && !bodyHits(w, 0, -0.08, 0) {
        w.onGround = false;
    }
    if !w.onGround {
        w.vel.y = w.vel.y - GRAV * dt;
        if w.vel.y < -30 {
            w.vel.y = -30;
        }
    } else if w.vel.y < 0 {
        w.vel.y = 0;
    }
    if w.onGround && game.keyDown(game.Key.Space) {
        w.vel.y = JUMP;
        w.onGround = false;
    }
    let move = wish(w);
    stepAxis(w, move.x * dt, 0);
    stepAxis(w, 0, move.z * dt);
    fall(w, w.vel.y * dt);
}

fn name(id: u8): string {
    if id == GRASS { return "Grass"; }
    if id == DIRT { return "Dirt"; }
    if id == STONE { return "Stone"; }
    if id == SAND { return "Sand"; }
    if id == WOOD { return "Log"; }
    if id == LEAF { return "Leaves"; }
    if id == PLANK { return "Planks"; }
    if id == GLASS { return "Glass"; }
    return "Metal";
}

fn drawSelection(w: &World) {
    if !w.hit.ok { return; }
    let x = f32(w.hit.x) - 0.004;
    let y = f32(w.hit.y) - 0.004;
    let z = f32(w.hit.z) - 0.004;
    let x1 = x + 1.008;
    let y1 = y + 1.008;
    let z1 = z + 1.008;
    let c = Vec3.xyz(1.0, 0.85, 0.44);
    gfx.drawLine(Vec3.xyz(x,y,z), Vec3.xyz(x1,y,z), c);
    gfx.drawLine(Vec3.xyz(x,y,z1), Vec3.xyz(x1,y,z1), c);
    gfx.drawLine(Vec3.xyz(x,y1,z), Vec3.xyz(x1,y1,z), c);
    gfx.drawLine(Vec3.xyz(x,y1,z1), Vec3.xyz(x1,y1,z1), c);
    gfx.drawLine(Vec3.xyz(x,y,z), Vec3.xyz(x,y,z1), c);
    gfx.drawLine(Vec3.xyz(x1,y,z), Vec3.xyz(x1,y,z1), c);
    gfx.drawLine(Vec3.xyz(x,y1,z), Vec3.xyz(x,y1,z1), c);
    gfx.drawLine(Vec3.xyz(x1,y1,z), Vec3.xyz(x1,y1,z1), c);
    gfx.drawLine(Vec3.xyz(x,y,z), Vec3.xyz(x,y1,z), c);
    gfx.drawLine(Vec3.xyz(x1,y,z), Vec3.xyz(x1,y1,z), c);
    gfx.drawLine(Vec3.xyz(x,y,z1), Vec3.xyz(x,y1,z1), c);
    gfx.drawLine(Vec3.xyz(x1,y,z1), Vec3.xyz(x1,y1,z1), c);
}

fn hotbar(w: &World) {
    let size = game.windowSize();
    let left = (size.x - 594) * 0.5;
    let top = size.y - 76;
    game.setColor(game.rgba(10, 19, 25, 211));
    game.drawRect(Vec2 { x: left - 10, y: top - 10 }, Vec2 { x: 614, y: 70 });
    let slot = 1;
    while slot <= 9 {
        let x = left + f32(slot - 1) * 66;
        let active = slot == w.slot;
        if active { game.setColor(game.rgb(236, 191, 105)); }
        else { game.setColor(game.rgb(78, 94, 98)); }
        game.drawRect(Vec2 { x: x, y: top }, Vec2 { x: 58, y: 54 });
        game.setColor(game.rgba(16, 29, 35, 244));
        game.drawRect(Vec2 { x: x + 3, y: top + 3 }, Vec2 { x: 52, y: 48 });
        let c = tint(held(slot));
        game.setColor(game.rgb(u8(c.x * 255), u8(c.y * 255), u8(c.z * 255)));
        game.drawRect(Vec2 { x: x + 8, y: top + 10 }, Vec2 { x: 22, y: 22 });
        game.setColor(game.rgb(239, 235, 219));
        game.drawText(w.font, Vec2 { x: x + 36, y: top + 6 }, `{slot}`);
        slot += 1;
    }
    game.setColor(game.rgb(244, 232, 209));
    game.drawText(w.font, Vec2 { x: left + 7, y: top - 30 }, name(held(w.slot)));
}

fn overlay(w: &World) {
    if (!w.hud && !w.menu) { return; }
    if w.hud {
        let ui = Ui.begin(w.font, 14, 14);
        ui.panel(340, 150);
        ui.labelBold("J3 / voxel materials");
        ui.label("WASD move   Space jump   Mouse look");
        ui.label("Left break   Right place");
        ui.label("1-9 / wheel select   Esc settings");
        ui.label("O shadows   F3 profiler   H HUD   Q quit");
        ui.end();
        hotbar(w);
        if game.mouseCaptured() {
            let size = game.windowSize();
            let cx = size.x * 0.5;
            let cy = size.y * 0.5;
            game.setColor(game.rgba(18, 30, 35, 215));
            game.drawRect(Vec2 { x: cx - 9, y: cy - 1 }, Vec2 { x: 18, y: 2 });
            game.drawRect(Vec2 { x: cx - 1, y: cy - 9 }, Vec2 { x: 2, y: 18 });
            game.setColor(game.rgb(250, 244, 219));
            game.drawRect(Vec2 { x: cx - 7, y: cy }, Vec2 { x: 14, y: 1 });
            game.drawRect(Vec2 { x: cx, y: cy - 7 }, Vec2 { x: 1, y: 14 });
        }
    }
    if w.menu {
        let settingsUi = Ui.begin(w.font, 18, 164);
        settingsUi.panel(318, 340);
        settingsUi.labelBold("Render settings");
        settingsUi.label("Click Resume or press Esc to look around");
        if settingsUi.button("Resume") {
            w.menu = false;
            game.captureMouse(true);
        }
        if settingsUi.toggle("Corner shadows", &w.ao) { w.dirty = true; }
        settingsUi.slider("Godrays", &w.shafts, 0, 2.5);
        settingsUi.slider("Exposure", &w.exposure, 0.5, 1.8);
        settingsUi.slider("Glass IOR", &w.ior, 1.01, 2.1);
        settingsUi.slider("Metal roughness", &w.roughness, 0, 0.8);
        settingsUi.end();
    }
}

pub fn draw(w: &World) {
    if w.dirty { remesh(w); }
    let cam = eyeOf(w);
    let sun = Vec3.xyz(-0.48, 0.74, 0.35).normalize();
    let sky = Vec3.xyz(0.41, 0.61, 0.78);
    let warm = Vec3.xyz(1.0, 0.91, 0.72);
    gfx.shadowPass(sun, Vec3.xyz(0, 0, 0), Vec3.xyz(f32(SX), f32(SY), f32(SZ)));
    gfx.albedo(w.atlas);
    gfx.draw(w.mesh, Mat4.identity());
    let i = 0;
    while i < w.specialCount {
        let at = i * 4;
        if w.special[at + 3] > 1.5 {
            let model = Mat4.translate(w.special[at] + 0.5, w.special[at + 1] + 0.5, w.special[at + 2] + 0.5);
            gfx.draw(w.metalShadow, model);
        }
        i += 1;
    }
    post.begin();
    gfx.cameraPassLook(cam, sun, sky, warm);
    gfx.albedo(w.atlas);
    gfx.draw(w.mesh, Mat4.identity());
    drawSelection(w);
    post.present(cam, sun, w.special, w.specialCount, w.atlas, w.ior, w.roughness,
                 w.shafts, w.exposure);
    overlay(w);
}
