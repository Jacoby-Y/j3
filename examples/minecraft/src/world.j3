// Heightmap, a hut, trees. One mesh, rebuilt when a block changes.
// F3 toggles corner shadows.

module minecraft.world;

use j3.game;
use j3.gfx;
use j3.gfx.{
    FACE_NX, FACE_NY, FACE_NZ, FACE_PX, FACE_PY, FACE_PZ, Look, Mesh,
};
use j3.math.{ Mat4, Vec3, clamp, cos, sin };
use j3.memory.Arena;
use j3.physics.Body3;
use j3.voxel;
use j3.voxel.Hit;

pub const SX: int = 32;
pub const SY: int = 24;
pub const SZ: int = 32;

const AIR: u8 = 0;
const GRASS: u8 = 1;
const DIRT: u8 = 2;
const STONE: u8 = 3;
const SAND: u8 = 4;
const WOOD: u8 = 5;
const LEAF: u8 = 6;
const PLANK: u8 = 7;

const REACH: f32 = 6;
const EYE: f32 = 1.62;
const BODY: f32 = 1.7;
const RADIUS: f32 = 0.28;
const WALK: f32 = 4.6;
const GRAV: f32 = 22;
const JUMP: f32 = 7.4;

pub struct World {
    cells: []u8;
    mesh: Mesh;
    cursor: Mesh;
    hand: []Mesh;
    pos: Vec3;
    vel: Vec3;
    yaw: f32;
    pitch: f32;
    slot: int;
    onGround: bool;
    dirty: bool;
    ao: bool;
    hit: Hit;
}

fn emptyMesh(): Mesh {
    return Mesh { vao: 0, vbo: 0, count: 0 };
}

fn modp(a: int, m: int): int {
    let q = a;
    if q < 0 {
        q = 0 - q;
    }
    return q - (q / m) * m;
}

fn heightAt(x: int, z: int): int {
    let n = sin(f32(x) * 0.31) * 2.4 + cos(f32(z) * 0.27) * 2.1 + sin(f32(x + z) * 0.17) * 1.3;
    let h = 7 + int(n);
    if h < 4 {
        h = 4;
    }
    if h > 14 {
        h = 14;
    }
    return h;
}

fn column(cells: []u8, x: int, z: int) {
    let h = heightAt(x, z);
    let y = 0;
    while y <= h {
        let id: u8 = STONE;
        if y == h {
            id = GRASS;
            if h <= 5 {
                id = SAND;
            }
        } else if y >= h - 3 {
            id = DIRT;
            if h <= 5 {
                id = SAND;
            }
        }
        voxel.set(cells, SX, SY, SZ, x, y, z, id);
        y += 1;
    }
}

fn tree(cells: []u8, x: int, z: int) {
    let h = heightAt(x, z);
    if h <= 5 {
        return;
    }
    let t = 0;
    while t < 4 {
        voxel.set(cells, SX, SY, SZ, x, h + 1 + t, z, WOOD);
        t += 1;
    }
    let y = h + 3;
    while y <= h + 5 {
        let dz = 0 - 2;
        while dz <= 2 {
            let dx = 0 - 2;
            while dx <= 2 {
                let skip = dx == 0 && dz == 0 && y < h + 5;
                if !skip && dx * dx + dz * dz <= 5 {
                    if voxel.get(cells, SX, SY, SZ, x + dx, y, z + dz) == AIR {
                        voxel.set(cells, SX, SY, SZ, x + dx, y, z + dz, LEAF);
                    }
                }
                dx += 1;
            }
            dz += 1;
        }
        y += 1;
    }
}

fn hut(cells: []u8) {
    let x0 = SX / 2 + 6;
    let z0 = SZ / 2 - 2;
    let h = heightAt(x0 + 2, z0 + 2);
    let y = h;
    while y <= h + 3 {
        let z = z0;
        while z <= z0 + 4 {
            let x = x0;
            while x <= x0 + 4 {
                let edge = x == x0 || x == x0 + 4 || z == z0 || z == z0 + 4 || y == h || y == h + 3;
                let door = y > h && y < h + 3 && x == x0 + 2 && z == z0;
                if edge && !door {
                    let id: u8 = PLANK;
                    if y == h {
                        id = WOOD;
                    }
                    voxel.set(cells, SX, SY, SZ, x, y, z, id);
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
}

fn generate(cells: []u8) {
    let z = 0;
    while z < SZ {
        let x = 0;
        while x < SX {
            column(cells, x, z);
            x += 1;
        }
        z += 1;
    }
    let cx = SX / 2;
    let cz = SZ / 2;
    z = 2;
    while z < SZ - 2 {
        x = 2;
        while x < SX - 2 {
            let near = x > cx - 4 && x < cx + 4 && z > cz - 4 && z < cz + 4;
            if !near && modp(x * 3 + z * 5, 11) == 0 {
                tree(cells, x, z);
            }
            x += 1;
        }
        z += 1;
    }
    hut(cells);
}

pub fn boot(mem: &Arena): World {
    let cells = mem.alloc::<u8>(SX * SY * SZ);
    let i = 0;
    while i < cells.len {
        cells[i] = AIR;
        i += 1;
    }
    generate(cells);
    let x = SX / 2;
    let z = SZ / 2;
    let h = heightAt(x, z);
    let hand = mem.alloc::<Mesh>(7);
    i = 0;
    while i < 7 {
        hand[i] = emptyMesh();
        i += 1;
    }
    return World {
        cells: cells,
        mesh: emptyMesh(),
        cursor: emptyMesh(),
        hand: hand,
        pos: Vec3.xyz(f32(x) + 0.5, f32(h + 1), f32(z) + 0.5),
        vel: Vec3.xyz(0, 0, 0),
        yaw: 0.6,
        pitch: -0.15,
        slot: 3,
        onGround: false,
        dirty: true,
        ao: true,
        hit: Hit { ok: false, x: 0, y: 0, z: 0, px: 0, py: 0, pz: 0, face: 0 },
    };
}

fn tint(id: u8): Vec3 {
    if id == GRASS {
        return Vec3.xyz(0.34, 0.62, 0.28);
    }
    if id == DIRT {
        return Vec3.xyz(0.45, 0.3, 0.18);
    }
    if id == STONE {
        return Vec3.xyz(0.55, 0.56, 0.58);
    }
    if id == SAND {
        return Vec3.xyz(0.86, 0.8, 0.52);
    }
    if id == WOOD {
        return Vec3.xyz(0.42, 0.28, 0.14);
    }
    if id == LEAF {
        return Vec3.xyz(0.22, 0.5, 0.2);
    }
    return Vec3.xyz(0.72, 0.55, 0.32);
}

fn emitSide(cells: []u8, out: []f32, at: int, x: int, y: int, z: int, dir: int, r: f32, g: f32, b: f32, ao: bool): int {
    if !ao {
        return gfx.emitFace(out, at, f32(x), f32(y), f32(z), dir, r, g, b, 0);
    }
    let k = voxel.corners(cells, SX, SY, SZ, x, y, z, dir);
    return gfx.emitFaceAo(
        out,
        at,
        f32(x),
        f32(y),
        f32(z),
        dir,
        r,
        g,
        b,
        0,
        voxel.shade(k.a),
        voxel.shade(k.b),
        voxel.shade(k.c),
        voxel.shade(k.d),
    );
}

fn emitExposed(cells: []u8, out: []f32, at: int, x: int, y: int, z: int, id: u8, ao: bool): int {
    let c = tint(id);
    if voxel.get(cells, SX, SY, SZ, x - 1, y, z) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_NX, c.x, c.y, c.z, ao);
    }
    if voxel.get(cells, SX, SY, SZ, x + 1, y, z) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_PX, c.x, c.y, c.z, ao);
    }
    if voxel.get(cells, SX, SY, SZ, x, y - 1, z) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_NY, c.x, c.y, c.z, ao);
    }
    if voxel.get(cells, SX, SY, SZ, x, y + 1, z) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_PY, c.x, c.y, c.z, ao);
    }
    if voxel.get(cells, SX, SY, SZ, x, y, z - 1) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_NZ, c.x, c.y, c.z, ao);
    }
    if voxel.get(cells, SX, SY, SZ, x, y, z + 1) == AIR {
        at = emitSide(cells, out, at, x, y, z, FACE_PZ, c.x, c.y, c.z, ao);
    }
    return at;
}

fn bakeWorld(w: &World, out: []f32): int {
    let at = 0;
    let y = 0;
    while y < SY {
        let z = 0;
        while z < SZ {
            let x = 0;
            while x < SX {
                let id = voxel.get(w.cells, SX, SY, SZ, x, y, z);
                if id != AIR {
                    at = emitExposed(w.cells, out, at, x, y, z, id, w.ao);
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return at;
}

fn bakeCube(out: []f32, r: f32, g: f32, b: f32, emi: f32): int {
    let o: f32 = f32(0) - 0.5;
    let at = 0;
    at = gfx.emitFace(out, at, o, o, o, FACE_NX, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PX, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_NY, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PY, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_NZ, r, g, b, emi);
    at = gfx.emitFace(out, at, o, o, o, FACE_PZ, r, g, b, emi);
    return at;
}

fn uploadNew(verts: []f32): Mesh {
    return gfx.upload(verts);
}

fn remesh(w: &World) {
    let n = voxel.countFaces(w.cells, SX, SY, SZ) * 60;
    if n < 60 {
        n = 60;
    }
    let scratch = Arena.create(n * 4 + 64);
    let verts = scratch.alloc::<f32>(n);
    let used = bakeWorld(w, verts);
    let slice = []f32 { ptr: verts.ptr, len: used };
    if w.mesh.vao == 0 {
        w.mesh = uploadNew(slice);
    } else {
        gfx.update(&w.mesh, slice);
    }
    scratch.destroy();
    w.dirty = false;
}

fn cubeMesh(r: f32, g: f32, b: f32, emi: f32): Mesh {
    let scratch = Arena.create(360 * 4 + 64);
    let verts = scratch.alloc::<f32>(360);
    let used = bakeCube(verts, r, g, b, emi);
    let mesh = gfx.upload([]f32 { ptr: verts.ptr, len: used });
    scratch.destroy();
    return mesh;
}

pub fn startup(w: &World) {
    gfx.init();
    game.captureMouse(true);
    remesh(w);
    w.cursor = cubeMesh(1, 0.9, 0.35, 1);
    let i = 1;
    while i <= 7 {
        let c = tint(held(i));
        w.hand[i - 1] = cubeMesh(c.x, c.y, c.z, 0);
        i += 1;
    }
}

fn eyeOf(w: &World): Look {
    return Look.create(Vec3.xyz(w.pos.x, w.pos.y + EYE, w.pos.z), w.yaw, w.pitch);
}

fn held(slot: int): u8 {
    if slot == 1 {
        return GRASS;
    }
    if slot == 2 {
        return DIRT;
    }
    if slot == 3 {
        return STONE;
    }
    if slot == 4 {
        return SAND;
    }
    if slot == 5 {
        return WOOD;
    }
    if slot == 6 {
        return LEAF;
    }
    return PLANK;
}

fn pick(w: &World) {
    if game.keyPressed(game.Key.Num1) {
        w.slot = 1;
    }
    if game.keyPressed(game.Key.Num2) {
        w.slot = 2;
    }
    if game.keyPressed(game.Key.Num3) {
        w.slot = 3;
    }
    if game.keyPressed(game.Key.Num4) {
        w.slot = 4;
    }
    if game.keyPressed(game.Key.Num5) {
        w.slot = 5;
    }
    if game.keyPressed(game.Key.Num6) {
        w.slot = 6;
    }
    if game.keyPressed(game.Key.Num7) {
        w.slot = 7;
    }
}

fn aim(w: &World) {
    let cam = eyeOf(w);
    w.hit = voxel.ray(w.cells, SX, SY, SZ, cam.eye, cam.forward(), REACH);
}

fn blocksBody(w: &World, x: int, y: int, z: int): bool {
    let minx = w.pos.x - RADIUS;
    let maxx = w.pos.x + RADIUS;
    let miny = w.pos.y;
    let maxy = w.pos.y + BODY;
    let minz = w.pos.z - RADIUS;
    let maxz = w.pos.z + RADIUS;
    if maxx <= f32(x) || minx >= f32(x + 1) {
        return false;
    }
    if maxy <= f32(y) || miny >= f32(y + 1) {
        return false;
    }
    if maxz <= f32(z) || minz >= f32(z + 1) {
        return false;
    }
    return true;
}

fn edit(w: &World) {
    if !w.hit.ok {
        return;
    }
    if game.mousePressed(game.Mouse.Left) && w.hit.y > 0 {
        voxel.set(w.cells, SX, SY, SZ, w.hit.x, w.hit.y, w.hit.z, AIR);
        w.dirty = true;
    }
    if game.mousePressed(game.Mouse.Right) {
        let same = w.hit.px == w.hit.x && w.hit.py == w.hit.y && w.hit.pz == w.hit.z;
        if !same && voxel.inside(w.hit.px, w.hit.py, w.hit.pz, SX, SY, SZ) {
            if voxel.get(w.cells, SX, SY, SZ, w.hit.px, w.hit.py, w.hit.pz) == AIR {
                if !blocksBody(w, w.hit.px, w.hit.py, w.hit.pz) {
                    voxel.set(w.cells, SX, SY, SZ, w.hit.px, w.hit.py, w.hit.pz, held(w.slot));
                    w.dirty = true;
                }
            }
        }
    }
}

pub fn input(w: &World, dt: f32) {
    if game.keyPressed(game.Key.Q) {
        game.requestQuit();
    }
    if game.keyPressed(game.Key.F3) {
        w.ao = !w.ao;
        w.dirty = true;
    }
    let looking = game.mouseCaptured();
    if game.keyPressed(game.Key.Escape) {
        game.captureMouse(!looking);
        looking = game.mouseCaptured();
    }
    if !looking && game.mousePressed(game.Mouse.Left) {
        game.captureMouse(true);
        return;
    }
    pick(w);
    if looking {
        let d = game.mouseDelta();
        w.yaw = w.yaw + d.x * 0.003;
        w.pitch = clamp(w.pitch - d.y * 0.003, -1.4, 1.4);
        aim(w);
        edit(w);
    } else {
        w.hit.ok = false;
    }
}

fn bodyHits(w: &World, dx: f32, dy: f32, dz: f32): bool {
    let p = w.pos;
    return voxel.overlaps(
        w.cells,
        SX,
        SY,
        SZ,
        Vec3.xyz(p.x - RADIUS + dx, p.y + dy, p.z - RADIUS + dz),
        Vec3.xyz(p.x + RADIUS + dx, p.y + BODY + dy, p.z + RADIUS + dz),
    );
}

fn nudge(w: &World, dx: f32, dy: f32, dz: f32): bool {
    if bodyHits(w, dx, dy, dz) {
        return false;
    }
    w.pos.x = w.pos.x + dx;
    w.pos.y = w.pos.y + dy;
    w.pos.z = w.pos.z + dz;
    return true;
}

fn stepAxis(w: &World, dx: f32, dz: f32) {
    if dx == 0 && dz == 0 {
        return;
    }
    if nudge(w, dx, 0, dz) {
        return;
    }
    if w.onGround && nudge(w, 0, 1, 0) {
        if !nudge(w, dx, 0, dz) {
            nudge(w, 0, -1, 0);
        }
    }
}

fn wish(w: &World): Vec3 {
    let cam = eyeOf(w);
    let fwd = cam.forward();
    fwd.y = 0;
    let fl = fwd.length();
    if fl > 0.001 {
        fwd = fwd * (f32(1) / fl);
    }
    let x: f32 = 0;
    let z: f32 = 0;
    if game.keyDown(game.Key.W) {
        x = x + fwd.x;
        z = z + fwd.z;
    }
    if game.keyDown(game.Key.S) {
        x = x - fwd.x;
        z = z - fwd.z;
    }
    let side = cam.right();
    if game.keyDown(game.Key.D) {
        x = x + side.x;
        z = z + side.z;
    }
    if game.keyDown(game.Key.A) {
        x = x - side.x;
        z = z - side.z;
    }
    let len = sqrt2(x, z);
    if len > 1 {
        x = x / len;
        z = z / len;
    }
    return Vec3.xyz(x * WALK, 0, z * WALK);
}

fn sqrt2(x: f32, z: f32): f32 {
    return Vec3.xyz(x, 0, z).length();
}

fn fall(w: &World, dy: f32) {
    if dy == 0 {
        return;
    }
    if dy > 0 {
        if !nudge(w, 0, dy, 0) {
            w.vel.y = 0;
        }
        return;
    }
    let left = dy;
    while left < 0 {
        let s: f32 = 0.05;
        if f32(0) - left < s {
            s = f32(0) - left;
        }
        if !nudge(w, 0, f32(0) - s, 0) {
            w.onGround = true;
            w.vel.y = 0;
            return;
        }
        left = left + s;
        w.onGround = false;
    }
}

pub fn tick(w: &World, dt: f32) {
    if w.onGround && !bodyHits(w, 0, -0.08, 0) {
        w.onGround = false;
    }
    if !w.onGround {
        w.vel.y = w.vel.y - GRAV * dt;
        if w.vel.y < -30 {
            w.vel.y = -30;
        }
    } else if w.vel.y < 0 {
        w.vel.y = 0;
    }
    if w.onGround && game.keyDown(game.Key.Space) {
        w.vel.y = JUMP;
        w.onGround = false;
    }
    let probe = Body3.make(w.pos, w.vel, Vec3.xyz(0.3, 0.9, 0.3), 1);
    probe.stepGrid(dt, Vec3.xyz(0, f32(0) - 28, 0), w.cells, SX, SY, SZ);
    if probe.pos.y < f32(0) - 10000 {
        w.pos.y = probe.pos.y;
    }
    let move = wish(w);
    stepAxis(w, move.x * dt, 0);
    stepAxis(w, 0, move.z * dt);
    fall(w, w.vel.y * dt);
}

pub fn draw(w: &World) {
    if w.dirty {
        remesh(w);
    }
    let cam = eyeOf(w);
    let sun = Vec3.xyz(0.45, 0.82, 0.28).normalize();
    let sky = Vec3.xyz(0.53, 0.74, 0.92);
    let warm = Vec3.xyz(1, 0.97, 0.9);
    gfx.shadowPass(sun, Vec3.xyz(0, 0, 0), Vec3.xyz(f32(SX), f32(SY), f32(SZ)));
    gfx.draw(w.mesh, Mat4.identity());
    gfx.cameraPassLook(cam, sun, sky, warm);
    gfx.draw(w.mesh, Mat4.identity());
    if w.hit.ok {
        let mark = Mat4.translate(f32(w.hit.x) + 0.5, f32(w.hit.y) + 0.5, f32(w.hit.z) + 0.5).mul(Mat4.scale(1.04, 1.04, 1.04));
        gfx.draw(w.cursor, mark);
    }
    let hand = cam.eye + cam.forward() * 0.85 + cam.right() * 0.32 + Vec3.xyz(0, -0.28, 0);
    let heldMesh = w.hand[w.slot - 1];
    let item = Mat4.translate(hand.x, hand.y, hand.z).mul(Mat4.scale(0.16, 0.16, 0.16));
    gfx.draw(heldMesh, item);
}
