// Walk a block world. Break and place. Esc frees the mouse. Q quits.

module minecraft;

use j3.app.App;
use minecraft.world.{ World, boot, draw, input, startup, tick };

fn main() {
    let app = App<World>.create("minecraft", 960, 540, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.add(tick);
    app.draw(draw);
    app.run();
}
