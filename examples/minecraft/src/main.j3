// Explore a textured block valley and place raytraced glass and metal.

module minecraft;

use j3.app.App;
use minecraft.world.{ World, boot, draw, input, startup, tick };

fn main() {
    let app = App<World>.create("J3 / voxel materials", 1100, 680, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.add(tick);
    app.draw(draw);
    app.run();
}
