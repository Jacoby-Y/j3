<!-- The stress scene: N cards, every one changes text, bar width and (staggered) class each frame. -->
<script>
    use todo.state.{ StressRun, N };

    props { s: &StressRun; }

    fn val(i: int): int { return (i * 7 + s.frame) % 1000; }
    fn pct(i: int): int { return (i + s.frame) % 100; }
    fn kind(i: int): int { return ((i + s.frame) / 8) % 4; }
</script>

<div class="grid">
    {#each 0..N as i}
        <div class="card c{kind(i)}">
            <span>{val(i)}</span>
            <div class="bar"><div class="fill" style:width="{pct(i)}%"></div></div>
        </div>
    {/each}
</div>

<style>
    .grid { display: flex; flex-wrap: wrap; gap: 2px; padding: 4px; }
    .card { width: 28px; height: 24px; padding: 2px; border-radius: 4px; border: 1px solid #313244; font-size: 10px; }
    .c0 { background: #1e1e2e; }
    .c1 { background: #24273a; }
    .c2 { background: #2a2b3c; }
    .c3 { background: #303446; }
    .bar { height: 4px; margin-top: 2px; background: #313244; border-radius: 2px; }
    .fill { height: 4px; background: #89b4fa; border-radius: 2px; }
</style>
