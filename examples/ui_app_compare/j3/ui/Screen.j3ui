<script>
    use todo.state.State;

    props { state: &State; }
</script>

<div class="app">
    <h1>Todos</h1>
    <div class="add">
        <input type="text" placeholder="What needs doing?" bind:value={state.draft} on:submit={state.add()} />
        <button on:click={state.add()}>Add</button>
    </div>
    {#each state.items.items[0..state.items.len] as &it (it.id : int)}
        <div class="row" class:done={it.done}>
            <input type="checkbox" bind:checked={it.done} />
            <span class="text">{it.text}</span>
            <button class="x" on:click={state.removeId = it.id}>×</button>
        </div>
    {/each}
    <p class="foot">{state.left()} left</p>
</div>
