module todo.state;

use j3.memory.{ Arena, List };
use j3.text.Text;

pub struct Item {
    id: int;
    text: string;
    done: bool;
}

pub struct State {
    mem: &Arena;
    items: List<Item>;
    draft: string = "";
    nextId: int = 1;
    removeId: int = 0;

    fn new(mem: &Arena): State {
        let s = State { mem: mem, items: List<Item>.new(mem) };
        s.push("Write the app");
        s.push("Measure the build");
        return s;
    }

    fn push(this: &State, s: string) {
        // the input's bound string is a view of its buffer, so keep a copy
        let t = Text.new(this.mem);
        t.pushStr(s);
        this.items.push(Item { id: this.nextId, text: t.str(), done: false });
        this.nextId += 1;
    }

    fn add(this: &State) {
        if this.draft.len > 0 {
            this.push(this.draft);
            this.draft = "";
        }
    }

    /// Rows only queue a removal; it is applied here, outside the list loop.
    fn flush(this: &State) {
        for i in 0..this.items.len {
            if this.items.items[i].id == this.removeId {
                this.items.remove(i);
                break;
            }
        }
        this.removeId = 0;
    }

    fn left(this: &State): int {
        let n = 0;
        for i in 0..this.items.len {
            if !this.items.items[i].done { n += 1; }
        }
        return n;
    }
}

/// Cards in the stress scene (the same in every stack).
pub const N: int = 1200;

/// Stress run: warm up for 2 s, then count frames for 8 s, printing `mark` and `done` lines for ../stress.py.
pub struct StressRun {
    frame: int = 0;
    t0: int = 0;
    marked: int = 0;
    phase: int = 0;
}
