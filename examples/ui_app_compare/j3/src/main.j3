module todo;

use todo.state.State;
use todo.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;

struct World {
    state: State;
    root: Screen;
}

fn boot(mem: &Arena): World {
    return World { state: State.new(mem), root: Screen.new(mem) };
}

fn draw(w: &World) {
    w.state.flush();
    w.root.render(windowSize(), ScreenProps { state: &w.state });
}

fn main() {
    let app = App<World>.create("Todos", 480, 520, boot);
    app.useGl();
    app.hiDpi();
    app.draw(draw);
    app.run();
}
