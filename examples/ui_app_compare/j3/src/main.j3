module todo;

use todo.state.{ State, StressRun };
use todo.ui.{ Screen, ScreenProps, Stress, StressProps };
use j3.app.App;
use j3.game.{ env, setVsync, windowSize };
use j3.io.printLn;
use j3.sys.monotonicMs;
use j3.memory.Arena;

struct World {
    state: State;
    root: Screen;
    stress: bool;
    s: StressRun;
    sroot: Stress;
}

fn boot(mem: &Arena): World {
    let stress = env("STRESS").len > 0;
    if stress { setVsync(false); }
    return World {
        state: State.new(mem), root: Screen.new(mem),
        stress: stress, s: StressRun { t0: monotonicMs() }, sroot: Stress.new(mem)
    };
}

fn draw(w: &World) {
    if w.stress {
        w.sroot.render(windowSize(), StressProps { s: &w.s });
        return;
    }
    w.state.flush();
    w.root.render(windowSize(), ScreenProps { state: &w.state });
}

/// Runs every frame (`app.always`), which also tells `App` the UI is animating, so it never idles.
fn stressFrame(w: &World, _dt: f32) {
    if !w.stress { return; }
    let s = &w.s;
    s.frame += 1;
    let t = monotonicMs() - s.t0;
    if s.phase == 0 && t >= 2000 {
        s.phase = 1;
        s.marked = s.frame;
        printLn("mark");
    } else if s.phase == 1 && t >= 10000 {
        s.phase = 2;
        printLn(`done frames={s.frame - s.marked}`);   // keeps running: ../stress.py reads its CPU time, then stops it
    }
}

fn main() {
    let w = 480;
    let h = 520;
    if env("STRESS").len > 0 { w = 1280; h = 800; }   // the stress scene's size in every stack
    let app = App<World>.create("Todos", w, h, boot);
    app.useGl();
    app.hiDpi();
    app.always(stressFrame);
    app.draw(draw);
    app.run();
}
