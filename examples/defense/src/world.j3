// Path, towers, and waves. The field is a grid. The path is blocked.

module defense.world;

use j3.game.fx.Particles;
use j3.game.path;
use j3.game.{
    Camera, Font, Key, Mouse, Texture, bakeTextBold, keyPressed, mouseDown, mousePos, mousePressed,
    mouseReleased, mouseWheel, requestQuit, rgb, setColor, tryLoadFont, windowSize,
};
use j3.math.{ Vec2, clamp };
use j3.memory.Arena;

pub const CELL: int = 40;
pub const COLS: int = 20;
pub const ROWS: int = 14;
pub const TOWERS: int = 32;
pub const FOES: int = 24;
pub const LIVES: int = 20;
pub const BOLTS: int = 40;

pub struct Tower {
    live: bool;
    cell: int;
    kind: int;
    level: int;
    cool: f32;
}

pub struct Foe {
    live: bool;
    x: f32;
    y: f32;
    hp: f32;
    max: f32;
    wp: int;
}

pub struct Bolt {
    live: bool;
    x: f32;
    y: f32;
    tx: f32;
    ty: f32;
    t: f32;
    kind: int;
}

pub struct World {
    cam: Camera;
    ground: []u8;
    towers: []Tower;
    foes: []Foe;
    bolts: []Bolt;
    sparks: Particles;
    wpx: [6]f32;
    wpy: [6]f32;
    nwp: int;
    gold: int;
    lives: int;
    wave: int;
    spawnLeft: int;
    spawnCool: f32;
    between: bool;
    selected: int;
    hover: int;
    placeKind: int;
    pressing: bool;
    pressMap: bool;
    dragging: bool;
    moved: f32;
    px: f32;
    py: f32;
    font: Font;
    arrowMark: Texture;
    cannonMark: Texture;
}

pub fn boot(mem: &Arena): World {
    let ground = mem.alloc::<u8>(COLS * ROWS);
    let gi = 0;
    while gi < COLS * ROWS {
        ground[gi] = 0;
        gi += 1;
    }
    let towers = mem.alloc::<Tower>(TOWERS);
    let ti = 0;
    while ti < TOWERS {
        towers[ti] = Tower { live: false, cell: 0, kind: 0, level: 1, cool: 0 };
        ti += 1;
    }
    let bolts = mem.alloc::<Bolt>(BOLTS);
    let bi = 0;
    while bi < BOLTS {
        bolts[bi] = Bolt { live: false, x: 0, y: 0, tx: 0, ty: 0, t: 0, kind: 0 };
        bi += 1;
    }
    let foes = mem.alloc::<Foe>(FOES);
    let fi = 0;
    while fi < FOES {
        foes[fi] = Foe { live: false, x: 0, y: 0, hp: 0, max: 0, wp: 0 };
        fi += 1;
    }
    let w = World {
        cam: Camera.create(1),
        ground: ground,
        towers: towers,
        foes: foes,
        bolts: bolts,
        sparks: Particles.new(mem, 96),
        wpx: [0, 0, 0, 0, 0, 0],
        wpy: [0, 0, 0, 0, 0, 0],
        nwp: 6,
        gold: 80,
        lives: LIVES,
        wave: 1,
        spawnLeft: 0,
        spawnCool: 0,
        between: true,
        selected: -1,
        hover: -1,
        placeKind: -1,
        pressing: false,
        pressMap: false,
        dragging: false,
        moved: 0,
        px: 0,
        py: 0,
        font: Font { raw: 0 },
        arrowMark: Texture { raw: 0, w: 0, h: 0 },
        cannonMark: Texture { raw: 0, w: 0, h: 0 },
    };
    layPath(&w);
    return w;
}

pub fn load(w: &World) {
    w.font = tryLoadFont("../dungeon/assets/font.ttf", 18);
    if w.font.raw != 0 {
        setColor(rgb(150, 190, 230));
        w.arrowMark = bakeTextBold(w.font, "A");
        setColor(rgb(230, 150, 80));
        w.cannonMark = bakeTextBold(w.font, "C");
    }
}

pub fn input(w: &World, dt: f32) {
    if dt < 0 {
        return;
    }
    if keyPressed(Key.Escape) {
        requestQuit();
    }
    zoom(w);
    drag(w);
    w.hover = -1;
    if !w.dragging {
        let mp = mousePos();
        if !onHud(w, mp.x, mp.y) {
            let world = w.cam.toWorld(mp);
            w.hover = towerAt(w, world.x, world.y);
        }
    }
    if w.selected >= 0 {
        w.hover = -1;
    }
}

pub fn step(w: &World, dt: f32) {
    if w.lives <= 0 {
        return;
    }
    if !w.between {
        w.spawnCool = w.spawnCool - dt;
        if w.spawnLeft > 0 && w.spawnCool <= 0 {
            spawn(w);
            w.spawnLeft = w.spawnLeft - 1;
            w.spawnCool = 0.65;
        }
    }
    march(w, dt);
    shoot(w, dt);
    tickBolts(w, dt);
    w.sparks.tick(dt);
    if !w.between && w.spawnLeft <= 0 && alive(w) == 0 {
        w.between = true;
        w.wave = w.wave + 1;
    }
}

pub fn sendWave(w: &World) {
    if !w.between || w.lives <= 0 {
        return;
    }
    w.between = false;
    w.spawnLeft = 4 + w.wave;
    w.spawnCool = 0;
}

pub fn pickPlace(w: &World, kind: int) {
    if w.placeKind == kind {
        w.placeKind = -1;
        return;
    }
    w.placeKind = kind;
    w.selected = -1;
}

pub fn upgrade(w: &World) {
    let i = w.selected;
    if i < 0 || i >= TOWERS || !w.towers[i].live {
        return;
    }
    if w.towers[i].level >= 3 {
        return;
    }
    let cost = upgradeCost(w.towers[i].level);
    if w.gold < cost {
        return;
    }
    w.gold = w.gold - cost;
    w.towers[i].level = w.towers[i].level + 1;
}

pub fn placeCost(kind: int): int {
    if kind == 0 {
        return 25;
    }
    return 50;
}

pub fn upgradeCost(level: int): int {
    return 20 * level;
}

pub fn towerDamage(kind: int, level: int): int {
    if kind == 0 {
        return 6 + level * 5;
    }
    return 16 + level * 12;
}

pub fn towerRange(kind: int): f32 {
    if kind == 0 {
        return 90;
    }
    return 130;
}

pub fn towerName(kind: int): string {
    if kind == 0 {
        return "arrow";
    }
    return "cannon";
}

fn layPath(w: &World) {
    w.wpx[0] = centerX(0);
    w.wpy[0] = centerY(3);
    w.wpx[1] = centerX(8);
    w.wpy[1] = centerY(3);
    w.wpx[2] = centerX(8);
    w.wpy[2] = centerY(8);
    w.wpx[3] = centerX(16);
    w.wpy[3] = centerY(8);
    w.wpx[4] = centerX(16);
    w.wpy[4] = centerY(3);
    w.wpx[5] = centerX(19);
    w.wpy[5] = centerY(3);
    paint(w, 0, 3, 8, 3);
    paint(w, 8, 3, 8, 8);
    paint(w, 8, 8, 16, 8);
    paint(w, 16, 8, 16, 3);
    paint(w, 16, 3, 19, 3);
    let route = path.search(w.ground, COLS, ROWS, 0, 3, 19, 3, 1, 1);
    if route.len == 0 {
        w.nwp = 6;
    }
}

fn paint(w: &World, c0: int, r0: int, c1: int, r1: int) {
    let c = c0;
    let r = r0;
    let dc = 0;
    let dr = 0;
    if c1 > c0 {
        dc = 1;
    }
    if c1 < c0 {
        dc = -1;
    }
    if r1 > r0 {
        dr = 1;
    }
    if r1 < r0 {
        dr = -1;
    }
    while true {
        w.ground[r * COLS + c] = 1;
        if c == c1 && r == r1 {
            return;
        }
        c = c + dc;
        r = r + dr;
    }
}

fn centerX(c: int): f32 {
    return f32(c * CELL) + f32(CELL) / f32(2);
}

fn centerY(r: int): f32 {
    return f32(r * CELL) + f32(CELL) / f32(2);
}

fn zoom(w: &World) {
    let wheel = mouseWheel();
    if wheel == 0 {
        return;
    }
    let mp = mousePos();
    let before = w.cam.toWorld(mp);
    w.cam.zoom = clamp(w.cam.zoom + wheel * 0.12, 0.55, 2.2);
    let after = w.cam.toWorld(mp);
    w.cam.pos.x = w.cam.pos.x + (before.x - after.x);
    w.cam.pos.y = w.cam.pos.y + (before.y - after.y);
}

fn drag(w: &World) {
    let mp = mousePos();
    if mousePressed(Mouse.Left) {
        w.pressing = true;
        w.dragging = false;
        w.moved = 0;
        w.px = mp.x;
        w.py = mp.y;
        w.pressMap = !onHud(w, mp.x, mp.y);
    }
    if w.pressing && mouseDown(Mouse.Left) {
        let dx = mp.x - w.px;
        let dy = mp.y - w.py;
        let step = dx;
        if step < 0 {
            step = 0 - step;
        }
        let dyAbs = dy;
        if dyAbs < 0 {
            dyAbs = 0 - dyAbs;
        }
        w.moved = w.moved + step + dyAbs;
        if w.pressMap && w.moved > 8 {
            w.dragging = true;
            w.cam.pos.x = w.cam.pos.x - dx / w.cam.zoom;
            w.cam.pos.y = w.cam.pos.y - dy / w.cam.zoom;
        }
        w.px = mp.x;
        w.py = mp.y;
    }
    if mouseReleased(Mouse.Left) && w.pressing {
        if w.pressMap && !w.dragging {
            let world = w.cam.toWorld(mp);
            clickMap(w, world.x, world.y);
        }
        w.pressing = false;
        w.dragging = false;
    }
}

fn onHud(w: &World, x: f32, y: f32): bool {
    let view = windowSize();
    if y < 220 {
        return true;
    }
    if y > view.y - 120 {
        return true;
    }
    if w.selected >= 0 && x > view.x - 270 && y < 420 {
        return true;
    }
    return false;
}

fn clickMap(w: &World, wx: f32, wy: f32) {
    let hit = towerAt(w, wx, wy);
    if hit >= 0 {
        if w.selected == hit {
            w.selected = -1;
        } else {
            w.selected = hit;
        }
        w.placeKind = -1;
        return;
    }
    w.selected = -1;
    tryPlace(w, wx, wy);
}

fn tryPlace(w: &World, wx: f32, wy: f32) {
    if w.placeKind < 0 {
        return;
    }
    let idx = cellOf(wx, wy);
    if idx < 0 || w.ground[idx] != 0 {
        return;
    }
    if towerOn(w, idx) >= 0 {
        return;
    }
    let cost = placeCost(w.placeKind);
    if w.gold < cost {
        return;
    }
    let slot = freeTower(w);
    if slot < 0 {
        return;
    }
    w.gold = w.gold - cost;
    w.towers[slot].live = true;
    w.towers[slot].cell = idx;
    w.towers[slot].kind = w.placeKind;
    w.towers[slot].level = 1;
    w.towers[slot].cool = 0;
}

fn cellOf(wx: f32, wy: f32): int {
    if wx < 0 || wy < 0 {
        return -1;
    }
    let cx = int(wx / f32(CELL));
    let cy = int(wy / f32(CELL));
    if cx < 0 || cy < 0 || cx >= COLS || cy >= ROWS {
        return -1;
    }
    return cy * COLS + cx;
}

fn towerAt(w: &World, wx: f32, wy: f32): int {
    let idx = cellOf(wx, wy);
    if idx < 0 {
        return -1;
    }
    return towerOn(w, idx);
}

fn towerOn(w: &World, cell: int): int {
    let i = 0;
    while i < TOWERS {
        if w.towers[i].live && w.towers[i].cell == cell {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn freeTower(w: &World): int {
    let i = 0;
    while i < TOWERS {
        if !w.towers[i].live {
            return i;
        }
        i += 1;
    }
    return -1;
}

fn spawn(w: &World) {
    let slot = 0;
    while slot < FOES {
        if !w.foes[slot].live {
            w.foes[slot].live = true;
            w.foes[slot].x = w.wpx[0];
            w.foes[slot].y = w.wpy[0];
            w.foes[slot].hp = f32(18 + w.wave * 10);
            w.foes[slot].max = w.foes[slot].hp;
            w.foes[slot].wp = 1;
            return;
        }
        slot += 1;
    }
}

fn march(w: &World, dt: f32) {
    let i = 0;
    while i < FOES {
        if w.foes[i].live {
            let wp = w.foes[i].wp;
            if wp >= w.nwp {
                leak(w, i);
            } else {
                let dx = w.wpx[wp] - w.foes[i].x;
                let dy = w.wpy[wp] - w.foes[i].y;
                let dist = Vec2 { x: dx, y: dy }.length();
                let step = f32(46) * dt;
                if dist <= step || dist < 0.5 {
                    w.foes[i].x = w.wpx[wp];
                    w.foes[i].y = w.wpy[wp];
                    w.foes[i].wp = wp + 1;
                    if w.foes[i].wp >= w.nwp {
                        leak(w, i);
                    }
                } else {
                    w.foes[i].x = w.foes[i].x + dx / dist * step;
                    w.foes[i].y = w.foes[i].y + dy / dist * step;
                }
            }
        }
        i += 1;
    }
}

fn leak(w: &World, i: int) {
    w.sparks.burst(Vec2 { x: w.foes[i].x, y: w.foes[i].y }, 6, 70);
    w.foes[i].live = false;
    w.lives = w.lives - 1;
    if w.lives < 0 {
        w.lives = 0;
    }
}

fn shoot(w: &World, dt: f32) {
    let i = 0;
    while i < TOWERS {
        if w.towers[i].live {
            w.towers[i].cool = w.towers[i].cool - dt;
            if w.towers[i].cool <= 0 {
                let xy = cellCenter(w.towers[i].cell);
                let range = towerRange(w.towers[i].kind);
                let foe = nearest(w, xy.x, xy.y, range);
                if foe >= 0 {
                    let dmg = towerDamage(w.towers[i].kind, w.towers[i].level);
                    fire(w, xy.x, xy.y, w.foes[foe].x, w.foes[foe].y, w.towers[i].kind);
                    w.foes[foe].hp = w.foes[foe].hp - f32(dmg);
                    if w.towers[i].kind == 0 {
                        w.towers[i].cool = 0.42;
                    } else {
                        w.towers[i].cool = 1.05;
                    }
                    if w.foes[foe].hp <= 0 {
                        w.sparks.burst(Vec2 { x: w.foes[foe].x, y: w.foes[foe].y }, 10, 110);
                        w.foes[foe].live = false;
                        w.gold = w.gold + 6;
                    }
                }
            }
        }
        i += 1;
    }
}

fn nearest(w: &World, x: f32, y: f32, range: f32): int {
    let best = -1;
    let bestD = range * range;
    let i = 0;
    while i < FOES {
        if w.foes[i].live {
            let dx = w.foes[i].x - x;
            let dy = w.foes[i].y - y;
            let d = dx * dx + dy * dy;
            if d <= bestD {
                bestD = d;
                best = i;
            }
        }
        i += 1;
    }
    return best;
}

fn alive(w: &World): int {
    let n = 0;
    let i = 0;
    while i < FOES {
        if w.foes[i].live {
            n += 1;
        }
        i += 1;
    }
    return n;
}

fn fire(w: &World, x: f32, y: f32, tx: f32, ty: f32, kind: int) {
    let i = 0;
    while i < BOLTS {
        if !w.bolts[i].live {
            w.bolts[i].live = true;
            w.bolts[i].x = x;
            w.bolts[i].y = y;
            w.bolts[i].tx = tx;
            w.bolts[i].ty = ty;
            w.bolts[i].t = 0;
            w.bolts[i].kind = kind;
            return;
        }
        i += 1;
    }
}

fn tickBolts(w: &World, dt: f32) {
    let i = 0;
    while i < BOLTS {
        if w.bolts[i].live {
            w.bolts[i].t = w.bolts[i].t + dt * 8;
            if w.bolts[i].t >= 1 {
                w.bolts[i].live = false;
            }
        }
        i += 1;
    }
}

pub fn cellCenter(cell: int): Vec2 {
    let cx = cell - (cell / COLS) * COLS;
    let cy = cell / COLS;
    return Vec2 { x: centerX(cx), y: centerY(cy) };
}
