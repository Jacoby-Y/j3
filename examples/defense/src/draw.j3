// Grass, the path, creeps, and towers. HUD is screen-space.

module defense.draw;

use defense.hud.hud;
use defense.world.{
    BOLTS, CELL, COLS, FOES, ROWS, TOWERS, World, cellCenter, towerRange,
};
use j3.game;
use j3.math.Vec2;

pub fn draw(w: &World) {
    game.clearTo(game.rgb(18, 22, 18));
    field(w);
    foes(w);
    towers(w);
    bolts(w);
    w.sparks.drawCam(w.cam);
    hud(w);
}

fn field(w: &World) {
    let r = 0;
    while r < ROWS {
        let c = 0;
        while c < COLS {
            let idx = r * COLS + c;
            if w.ground[idx] == 0 {
                game.setColor(game.rgb(48, 92, 52));
            } else {
                game.setColor(game.rgb(92, 78, 58));
            }
            let pos = Vec2 { x: f32(c * CELL), y: f32(r * CELL) };
            game.drawRectCam(w.cam, pos, Vec2 { x: f32(CELL - 2), y: f32(CELL - 2) });
            c += 1;
        }
        r += 1;
    }
}

fn foes(w: &World) {
    let i = 0;
    while i < FOES {
        if w.foes[i].live {
            game.setColor(game.rgb(186, 64, 58));
            game.drawRectCam(
                w.cam,
                Vec2 { x: w.foes[i].x - 8, y: w.foes[i].y - 8 },
                Vec2 { x: 16, y: 16 },
            );
            let wide = f32(18);
            if w.foes[i].max > 0 {
                wide = f32(18) * w.foes[i].hp / w.foes[i].max;
            }
            if wide < 0 {
                wide = 0;
            }
            game.setColor(game.rgb(40, 16, 16));
            game.drawRectCam(w.cam, Vec2 { x: w.foes[i].x - 9, y: w.foes[i].y - 14 }, Vec2 { x: 18, y: 3 });
            game.setColor(game.rgb(220, 80, 70));
            game.drawRectCam(w.cam, Vec2 { x: w.foes[i].x - 9, y: w.foes[i].y - 14 }, Vec2 { x: wide, y: 3 });
        }
        i += 1;
    }
}

fn towers(w: &World) {
    let i = 0;
    while i < TOWERS {
        if w.towers[i].live {
            let at = cellCenter(w.towers[i].cell);
            if i == w.selected || i == w.hover {
                let reach = towerRange(w.towers[i].kind);
                game.setColor(game.rgba(210, 200, 140, 48));
                game.drawRectCam(
                    w.cam,
                    Vec2 { x: at.x - reach, y: at.y - reach },
                    Vec2 { x: reach * 2, y: reach * 2 },
                );
            }
            if w.towers[i].kind == 0 {
                game.setColor(game.rgb(70, 110, 170));
            } else {
                game.setColor(game.rgb(176, 98, 48));
            }
            game.drawRectCam(
                w.cam,
                Vec2 { x: at.x - 12, y: at.y - 12 },
                Vec2 { x: 24, y: 24 },
            );
        }
        i += 1;
    }
}

fn bolts(w: &World) {
    let i = 0;
    while i < BOLTS {
        if w.bolts[i].live {
            let t = w.bolts[i].t;
            let x = w.bolts[i].x + (w.bolts[i].tx - w.bolts[i].x) * t;
            let y = w.bolts[i].y + (w.bolts[i].ty - w.bolts[i].y) * t;
            if w.bolts[i].kind == 0 {
                game.setColor(game.rgb(236, 236, 210));
            } else {
                game.setColor(game.rgb(255, 170, 70));
            }
            game.drawRectCam(w.cam, Vec2 { x: x - 3, y: y - 3 }, Vec2 { x: 6, y: 6 });
        }
        i += 1;
    }
}
