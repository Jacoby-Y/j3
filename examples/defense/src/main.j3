// Drag the map, scroll to zoom. Escape quits.

module defense;

use defense.draw.draw;
use defense.world.{ World, boot, input, load, step };
use j3.app.App;

fn main() {
    let app = App<World>.create("defense", 960, 640, boot);
    app.startup(load);
    app.always(input);
    app.add(step);
    app.draw(draw);
    app.run();
}
