// Wave panel, centered hotbar, hover tip, and the upgrade card.

module defense.hud;

use defense.world.{
    World, pickPlace, placeCost, sendWave, towerDamage, towerName, towerRange, upgrade, upgradeCost,
};
use j3.game.{ mousePos, windowSize };
use j3.ui.{ Theme, Ui };

pub fn hud(w: &World) {
    let ui = Ui.begin(w.font, 16, 12);
    ui.theme = Theme.dusk();
    topBar(&ui, w);
    let view = windowSize();
    ui.x = view.x * 0.5 - 190;
    ui.y = view.y - 108;
    hotbar(&ui, w);
    if w.selected >= 0 {
        ui.x = view.x - 268;
        ui.y = 12;
        info(&ui, w);
    } else if w.hover >= 0 {
        let mp = mousePos();
        ui.x = mp.x + 18;
        ui.y = mp.y + 18;
        tip(&ui, w);
    }
}

@j3ui heading(ui: &Ui, w: &World, msg: string) {
    labelBold(msg);
}

@j3ui topBar(ui: &Ui, w: &World) {
    panel(280, 196) {
        heading(ui, w, `wave {w.wave}`);
        row() {
            label(`gold {w.gold}`);
            gap(18);
            label(`lives {w.lives}`);
        }
        bar(f32(w.lives) / f32(20));
        if w.lives <= 0 {
            label("the path broke");
        } else if w.between {
            button("send wave") {
                sendWave(w);
            }
        } else {
            label("wave on the path");
        }
    }
}

@j3ui hotbar(ui: &Ui, w: &World) {
    panel(380, 96) {
        heading(ui, w, "build");
        row() {
            slot(ui, w, 0, "arrow");
            gap(18);
            slot(ui, w, 1, "cannon");
        }
    }
}

@j3ui slot(ui: &Ui, w: &World, kind: int, name: string) {
    if kind == 0 && w.arrowMark.raw != 0 {
        image(w.arrowMark);
    }
    if kind == 1 && w.cannonMark.raw != 0 {
        image(w.cannonMark);
    }
    pick(ui, w, kind, name);
}

@j3ui pick(ui: &Ui, w: &World, kind: int, name: string) {
    let cost = placeCost(kind);
    pushId(kind) {
        if w.placeKind == kind {
            button(`[{name} {cost}]`) {
                pickPlace(w, kind);
            }
        } else {
            button(`{name} {cost}`) {
                pickPlace(w, kind);
            }
        }
    }
}

@j3ui tip(ui: &Ui, w: &World) {
    let i = w.hover;
    if i < 0 {
        return;
    }
    let t = w.towers[i];
    panel(210, 132) {
        heading(ui, w, towerName(t.kind));
        label(`level {t.level}`);
        label(`damage {towerDamage(t.kind, t.level)}`);
    }
}

@j3ui info(ui: &Ui, w: &World) {
    let i = w.selected;
    if i < 0 {
        return;
    }
    let t = w.towers[i];
    panel(248, 248) {
        heading(ui, w, towerName(t.kind));
        label(`level {t.level}`);
        label(`damage {towerDamage(t.kind, t.level)}`);
        label(`range {int(towerRange(t.kind))}`);
        if t.level >= 3 {
            label("fully upgraded");
        } else {
            label(`cost {upgradeCost(t.level)} gold`);
            button("upgrade") {
                upgrade(w);
            }
        }
    }
}
