/// Shared procedural assets for headless export and live preview.
module art;

use j3.gfx.canvas.{
    Canvas, Mode, rgb, rgba
};
use j3.memory.Arena;

pub fn lantern(arena : &Arena) : Canvas {
    let lamp = Canvas.create(arena, 96, 96, Mode.Smooth);
    lamp.fillCircle(48, 48, 41, rgba(238, 160, 61, 55));
    lamp.fillCircle(48, 48, 33, rgba(255, 189, 71, 45));
    lamp.fillTriangle(25, 24, 48, 9, 71, 24, rgb(35, 43, 58));
    lamp.line(27, 25, 69, 25, 6, rgb(21, 32, 47));
    lamp.fillRect(36, 27, 24, 43, rgb(241, 178, 83));
    lamp.gradientRect(37, 28, 22, 41, rgb(255, 231, 142), rgb(202, 104, 52), true);
    lamp.fillTriangle(39, 66, 48, 30, 56, 66, rgba(255, 247, 201, 90));
    lamp.line(34, 27, 34, 69, 5, rgb(38, 43, 58));
    lamp.line(62, 27, 62, 69, 5, rgb(38, 43, 58));
    lamp.line(30, 72, 66, 72, 9, rgb(23, 33, 48));
    lamp.line(40, 77, 56, 77, 2, rgba(245, 200, 106, 180));
    lamp.fillCircle(48, 14, 3, rgb(202, 157, 82));
    return lamp;
}

pub fn stone(arena : &Arena) : Canvas {
    let tile = Canvas.create(arena, 64, 64, Mode.Pixel);
    tile.clear(rgb(49, 64, 75));
    tile.noiseRect(0, 0, 64, 64, u32(71), 2, rgba(45, 55, 64, 32), rgba(153, 163, 155, 40));
    tile.fillRect(3, 4, 58, 21, rgba(127, 143, 148, 110));
    tile.line(0, 32, 63, 32, 2, rgb(24, 38, 50));
    tile.strokeRect(0, 0, 64, 64, 2, rgb(27, 40, 53));
    return tile;
}
