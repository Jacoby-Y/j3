/// Generate a layered lantern sprite and a repeatable stone tile.
module canvas_art;

use art.{
    lantern, stone
};
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;

fn main() {
    let arena = Arena.create(256000);
    let lamp = lantern(&arena);
    match lamp.savePng("lantern.png", &arena) {
        Result.Ok(_) {
        }
        Result.Err(_) {
            panic("could not write lantern.png");
        }
    }

    let tile = stone(&arena);
    match tile.savePng("stone.png", &arena) {
        Result.Ok(_) {
        }
        Result.Err(_) {
            panic("could not write stone.png");
        }
    }
    printLn("wrote lantern.png and stone.png");
    arena.destroy();
}
