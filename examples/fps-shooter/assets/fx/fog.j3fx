# Ground mist: blocky wisps of fog that drift and thin out, with the puff's corners swaying.
kind=material
# Wisp cell size in metres, and how fast they drift.
param.cell=float:1.5
param.speed=float:1.0
# Noise above this keeps a cell: higher is thinner mist.
param.thin=float:0.5
---
#ifdef J3_VERTEX
vec3 displace(vec3 pos, vec3 normal) {
  float t = uTime * 0.45;
  pos.x += sin(t + pos.z * 0.13 + pos.y * 0.5) * 1.4;
  pos.z += cos(t * 0.8 + pos.x * 0.11) * 1.4;
  pos.y += sin(t * 1.1 + pos.x * 0.17 + pos.z * 0.09) * 0.2;
  return pos;
}
#else
float fogHash(vec3 p) {
  return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}
float fogNoise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(fogHash(i), fogHash(i + vec3(1, 0, 0)), f.x),
                 mix(fogHash(i + vec3(0, 1, 0)), fogHash(i + vec3(1, 1, 0)), f.x), f.y),
             mix(mix(fogHash(i + vec3(0, 0, 1)), fogHash(i + vec3(1, 0, 1)), f.x),
                 mix(fogHash(i + vec3(0, 1, 1)), fogHash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
vec3 effect(Surface s, vec3 lit) {
  vec3 cell = floor(s.pos / uFx_cell) + 0.5;
  float t = uTime * uFx_speed;
  vec3 q = cell * 0.22 + vec3(t * 0.12, t * 0.04, t * 0.09);
  float n = fogNoise(q) * 0.65 + fogNoise(q * 2.3 + 9.0) * 0.35;
  if (n < uFx_thin) discard;
  return lit * (0.9 + (n - uFx_thin) * 0.4);
}
#endif
