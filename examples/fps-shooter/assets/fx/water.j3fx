# Sea surface: blocky pixel ripples. The surface is cut into square cells that each get their
# own drifting shade, with the odd bright glint cell.
kind=material
# Cell size in metres, and how fast the pattern drifts.
param.cell=float:1.0
param.speed=float:0.5
# How far cells push brightness, and how bright the glints are.
param.ripple=float:0.2
param.sparkle=float:1.0
---
#ifdef J3_VERTEX
vec3 displace(vec3 pos, vec3 normal) {
  return pos;
}
#else
float waterHash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
vec3 effect(Surface s, vec3 lit) {
  vec2 cell = floor(s.pos.xz / uFx_cell);
  float t = uTime * uFx_speed;
  // Each cell breathes on its own phase, blended with a slow travelling wave: smooth in time,
  // square in space.
  float phase = waterHash(cell) * 6.2831853;
  float w = sin(t * 1.3 + phase) * 0.5 + sin(cell.x * 0.5 + cell.y * 0.35 + t) * 0.5;
  vec3 c = lit * (1.0 + w * uFx_ripple);
  float gl = waterHash(cell * 1.7 + 3.0);
  float pulse = smoothstep(0.75, 1.0, sin(t * 1.1 + gl * 6.2831853)) * step(0.85, gl);
  return c + vec3(0.9, 0.97, 1.0) * pulse * uFx_sparkle;
}
#endif
