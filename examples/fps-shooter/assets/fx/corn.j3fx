# Corn: a thin plane of stalks. Gaps between stalks are cut out, so a plane reads as a row of
# plants with leaves, cobs and tassels, and the tops sway in the wind.
kind=material
# Metres between stalks, and how tall the shortest stalk is.
param.pitch=float:1.0
param.height=float:3.4
---
#ifdef J3_VERTEX
vec3 displace(vec3 pos, vec3 normal) {
  float k = clamp(pos.y / 5.0, 0.0, 1.0);
  k = k * k;
  pos.x += sin(uTime * 1.3 + pos.x * 0.35 + pos.z * 0.2) * 0.4 * k;
  pos.z += cos(uTime * 1.1 + pos.z * 0.3 + pos.x * 0.15) * 0.3 * k;
  return pos;
}
#else
float cornHash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}
vec3 effect(Surface s, vec3 lit) {
  vec3 n = s.normal;
  if (abs(n.y) > 0.5) discard;
  vec3 t = normalize(vec3(-n.z, 0.0, n.x));
  float plane = floor(dot(s.pos, vec3(abs(n.x), 0.0, abs(n.z))) * 3.0);
  float u = dot(s.pos, t) + cornHash(vec2(plane, 1.0)) * uFx_pitch;
  float cell = floor(u / uFx_pitch);
  float r = cornHash(vec2(cell, plane));
  float du = u - (cell + 0.5) * uFx_pitch + (r - 0.5) * 0.2;
  float ad = abs(du);
  float h = s.pos.y;
  float top = uFx_height + r * 0.7;
  if (h > top + 0.5) discard;
  vec3 col = vec3(0.0);
  bool keep = false;
  if (ad < 0.06 && h < top) {
    keep = true;
    col = vec3(0.5, 0.66, 0.22);
  }
  if (!keep && h < top) {
    float ph = r * 0.85;
    float j = floor((h - 0.5 - ph) / 0.85);
    float yy = h - (0.5 + ph + j * 0.85);
    float curve = 0.9 * ad - 1.6 * ad * ad;
    float w = 0.11 * (1.0 - ad / 0.55);
    if (j >= 0.0 && ad < 0.5 && abs(yy - curve) < w) {
      keep = true;
      col = mix(vec3(0.22, 0.5, 0.15), vec3(0.34, 0.62, 0.2), fract(r * 7.0));
    }
  }
  if (!keep && r > 0.35 && h > 1.4 && h < 2.15) {
    float side = r > 0.7 ? 1.0 : -1.0;
    float c = du * side;
    if (c > 0.05 && c < 0.22) {
      keep = true;
      col = h < 1.75 ? vec3(0.4, 0.62, 0.2) : vec3(0.95, 0.78, 0.22);
    }
  }
  if (!keep && h >= top) {
    float k = (h - top) / 0.5;
    if (ad < 0.035 || abs(ad - 0.3 * k) < 0.035) {
      keep = true;
      col = vec3(0.92, 0.8, 0.35);
    }
  }
  if (!keep) discard;
  col *= 0.7 + 0.3 * clamp(h / 3.0, 0.0, 1.0);
  return lit * col;
}
#endif
