# Takes the flat look off plain shapes: soft blotches in world space (so a long wall and a
# small crate get the same size of grain), plus faint tile lines that fade with distance.
kind=material
# Blotches per metre; the fine layer is 4x this.
param.scale=float:0.35
# How far blotches push brightness up or down (0.07 is 7%).
param.mottle=float:0.09
# Tile size in metres, and how dark and wide the lines are.
param.grid=float:2
param.lines=float:0.1
param.width=float:0.025
# Lines are gone by this distance, before they can shimmer.
param.fade=float:35
---
#ifdef J3_VERTEX
vec3 displace(vec3 pos, vec3 normal) {
  return pos;
}
#else
float grainHash(vec3 p) {
  return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}
float grainNoise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  return mix(mix(mix(grainHash(i), grainHash(i + vec3(1, 0, 0)), f.x),
                 mix(grainHash(i + vec3(0, 1, 0)), grainHash(i + vec3(1, 1, 0)), f.x), f.y),
             mix(mix(grainHash(i + vec3(0, 0, 1)), grainHash(i + vec3(1, 0, 1)), f.x),
                 mix(grainHash(i + vec3(0, 1, 1)), grainHash(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}
vec3 effect(Surface s, vec3 lit) {
  vec3 p = s.pos * uFx_scale;
  float n = grainNoise(p) * 0.65 + grainNoise(p * 4.0 + 17.0) * 0.35;
  float shade = 1.0 + (n - 0.5) * 2.0 * uFx_mottle;
  // Lines on the two axes running along the face.
  vec3 g = abs(fract(s.pos / uFx_grid + 0.5) - 0.5) * uFx_grid;
  vec3 an = abs(s.normal);
  float d = 1e9;
  if (an.x < 0.9) d = min(d, g.x);
  if (an.y < 0.9) d = min(d, g.y);
  if (an.z < 0.9) d = min(d, g.z);
  float line = 1.0 - smoothstep(uFx_width * 0.5, uFx_width * 1.5, d);
  float near = 1.0 - clamp(length(s.pos - uEye) / uFx_fade, 0.0, 1.0);
  shade *= 1.0 - line * uFx_lines * near;
  return lit * shade;
}
#endif
