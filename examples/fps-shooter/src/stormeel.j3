// Stormeel flies over the beach in wide circles round the player at a moderate speed, snaking
// as it goes. Up high it calls thunder down around the player; on low passes, skimming the
// ground and the waves, it bites what it catches and its glowing segments are open to fire.
module fps_shooter.stormeel;

use j3.math.{ Vec3, Mat4, atan2, clamp, cos, max, min, sin };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, SHOCK_BALL, SHOCK, addPart, bit, box, burst, clearParts, fire, flat, flatDist,
    frame, forward, glowRay, groundTop, hurt, paint, patch, puff, ring, turn, wave, yawTo };
use fps_shooter.level;
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const HIGH: int = 0;
const LOW: int = 1;
const SEGMENTS: int = 10;
const LINK: f32 = 2.3;
/// It stays this far from the middle of its tile, and circles at this radius and speed.
const BOUND: f32 = 66;
const ORBIT: f32 = 30;
const SPEED: f32 = 16;
const HIGH_UP: f32 = 17;
const LOW_UP: f32 = 2.6;

fn volt(): Vec3 { return Vec3.xyz(0.5, 2.2, 3.0); }
fn to(b: &Boss, state: int, len: f32) { b.state = state; b.t = 0; b.len = len; }
fn segment(bs: &Bosses, i: int): Vec3 { return bs.worm[bs.active * SEGMENTS + i]; }
fn surface(b: &Boss): f32 { return b.home.y - 0.6; }

fn bodyFrame(bs: &Bosses, i: int): Mat4 {
    let at = segment(bs, i);
    let dir = bs.b.vel;
    if i > 0 { dir = segment(bs, i - 1) - at; }
    let pitch = atan2(dir.y, max(flat(dir).length(), 0.01));
    return frame(at, if flat(dir).length() > 0.01 { yawTo(at, at + dir) } else { bs.b.yaw })
        .mul(Mat4.rotate(Vec3.xyz(1, 0, 0), pitch));
}

fn follow(bs: &Bosses) {
    let offset = bs.active * SEGMENTS;
    bs.worm[offset] = bs.b.pos;
    let i = 1;
    while i < SEGMENTS {
        let prev = bs.worm[offset + i - 1];
        let off = bs.worm[offset + i] - prev;
        if off.length() < 0.001 { off = Vec3.xyz(0, 0, 1); }
        bs.worm[offset + i] = prev + off.normalize() * LINK;
        i += 1;
    }
}

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.intro = 1.4;
    b.pos = b.home + Vec3.xyz(0, HIGH_UP, 0);
    b.from = b.pos;
    b.aim = b.pos;
    b.cd = 1.5;
    b.cd2 = 0;
    b.heat = 1;
    let i = 0;
    while i < SEGMENTS { bs.worm[bs.active * SEGMENTS + i] = b.pos - forward(b.yaw) * f32(i) * LINK; i += 1; }
    to(b, HIGH, 7);
}

/// Thunder: warning rings around `at`, bolts from the sky landing as they fill.
fn thunder(bs: &Bosses, at: Vec3, spots: int, spread: f32, wait: f32) {
    let b = &bs.b;
    let i = 0;
    while i < spots {
        let a = bs.rng.unit() * 6.2831853;
        let r: f32 = 0;
        if i > 0 { r = 2.5 + bs.rng.unit() * spread; }
        let spot = Vec3.xyz(at.x + cos(a) * r, b.home.y - 0.6, at.z + sin(a) * r);
        let m = paint(bs, spot, 3.0, wait, volt());
        if m >= 0 { fire(bs, SHOCK_BALL, spot + Vec3.xyz(0, 34, 0), m, 0, 16); }
        i += 1;
    }
    sfx.at(sfx.WARN, at);
}

fn pose(bs: &Bosses) {
    clearParts(bs);
    let b = &bs.b;
    let i = 1;
    while i < SEGMENTS {
        let at = (segment(bs, i - 1) + segment(bs, i)) * 0.5;
        addPart(bs, at + Vec3.xyz(0, 0.3, 0), 0.7, if b.open > 0 { 2.8 } else { 1.2 }, WEAK);
        i += 1;
    }
    i = 0;
    while i < SEGMENTS {
        addPart(bs, segment(bs, i), max(0.45, 1.25 - f32(i) * 0.09), 1, BODY);
        i += 1;
    }
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.anim += dt;
    b.open = 0;
    b.cd2 = max(b.cd2 - dt, 0);
    let was = b.pos;
    b.t += dt;
    let mid = level.slotCenter(b.tile);
    // The circle's middle drifts after the player (or the arena, before the fight).
    let focus = b.home;
    if b.engaged { focus = p.pos; }
    b.aim = b.aim + (focus - b.aim) * min(dt * 0.6, 1);
    let radius = ORBIT;
    let speed = SPEED;
    if b.phase2 { radius = ORBIT * 0.8; speed = SPEED * 1.25; }
    // Steer for a point ahead on the circle, and fly at the speed set.
    let rel = flat(b.pos - b.aim);
    let ang = atan2(rel.z, rel.x);
    let lead = ang + 0.7;
    let goal = Vec3.xyz(b.aim.x + cos(lead) * radius, 0, b.aim.z + sin(lead) * radius);
    b.yaw = turn(b.yaw, yawTo(b.pos, goal) + sin(b.anim * 1.7) * 0.12, dt * 1.8);
    let next = b.pos + forward(b.yaw) * speed * dt;
    next.x = clamp(next.x, mid.x - BOUND, mid.x + BOUND);
    next.z = clamp(next.z, mid.z - BOUND, mid.z + BOUND);
    // Height: high, or skimming what is below.
    let floor = groundTop(lvl, next.x, next.z, 1.5, b.pos.y + 3);
    if floor < -50 { floor = b.home.y; }
    floor = max(floor, surface(b));
    let up = HIGH_UP;
    if b.state == LOW { up = LOW_UP; }
    let goalY = floor + up;
    let climb = clamp(goalY - b.pos.y, 0 - 7 * dt, 7 * dt);
    b.pos = Vec3.xyz(next.x, b.pos.y + climb, next.z);
    // Never into the ground or a wall it can't clear.
    if b.pos.y < floor + 1.4 { b.pos.y = floor + 1.4; }
    if b.state == HIGH {
        b.cue = false;
        b.cd -= dt;
        if b.cd <= 0 && b.engaged && b.intro <= 0 {
            thunder(bs, p.pos + flat(p.vel) * 0.35, 4, 7, 1.0);
            b.cd = 1.7;
            if b.phase2 { b.cd = 1.25; }
        }
        if b.t >= b.len { to(b, LOW, 6); }
    } else {
        b.open = 1;
        b.cue = true;
        if b.t >= b.len { to(b, HIGH, 8); b.cd = 0.8; }
    }
    // Bites: the head at close quarters.
    let mouth = b.pos + forward(b.yaw) * 1.4;
    let gap = p.pos + Vec3.xyz(0, 0.9, 0) - mouth;
    if b.engaged && b.intro <= 0 && b.cd2 <= 0 && gap.length() < 3.0 {
        b.cd2 = 1.3;
        hurt(p, 22, flat(gap).normalize() * 10 + Vec3.xyz(0, 5, 0));
        burst(bs, mouth, 8, 5, Vec3.xyz(0.8, 0.95, 1), volt() * 0.2);
        sfx.at(sfx.SLAM, mouth);
    }
    // A spray where it skims the water.
    if b.pos.y < surface(b) + 4 && level.waterSurface(lvl, b.pos.x, b.pos.z) > -900 && bs.fxRng.unit() < dt * 40 {
        puff(bs, Vec3.xyz(b.pos.x, surface(b) + 0.1, b.pos.z), Vec3.xyz(0, 3, 0), 0.6, 0.4, 1.5, 1, Vec3.xyz(0.8, 0.95, 1), Vec3.zero());
    }
    b.vel = (b.pos - was) * (1 / max(dt, 0.001));
    follow(bs);
    pose(bs);
    bs.glowAt = b.pos;
    bs.glowColor = volt() * 0.16;
    bs.glowR = if b.open > 0 { 8 } else { 4 };
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let skin = Vec3.xyz(0.12, 0.3, 0.42);
    let skin2 = Vec3.xyz(0.17, 0.4, 0.5);
    let belly = Vec3.xyz(0.9, 0.85, 0.5);
    let hot = b.open;
    let i = 0;
    while i < SEGMENTS {
        let r = max(0.5, 1.25 - f32(i) * 0.09);
        let t = bodyFrame(bs, i);
        box(bs, t, Vec3.zero(), Vec3.xyz(r * 1.7, r * 1.4, LINK * 1.05), if i % 2 == 0 { skin } else { skin2 }, Vec3.zero());
        bit(bs, t, Vec3.xyz(0, 0 - r * 0.62, 0), Vec3.xyz(r * 1.1, 0.25, LINK * 0.95), belly, Vec3.zero());
        bit(bs, t, Vec3.xyz(0, r * 0.85, 0), Vec3.xyz(0.16, r * 0.7, LINK * 0.9), skin, volt() * (0.1 + hot * 1.2));
        if i > 0 { bit(bs, t, Vec3.xyz(0, r * 0.1, LINK * 0.5), Vec3.xyz(r * 1.75, r * 1.45, 0.18), volt(), volt() * (0.2 + hot * 1.8)); }
        i += 1;
    }
    let head = bodyFrame(bs, 0);
    box(bs, head, Vec3.xyz(0, 0.1, -1.6), Vec3.xyz(1.9, 1.1, 2.4), skin, Vec3.zero());
    box(bs, head, Vec3.xyz(0, -0.45, -1.5), Vec3.xyz(1.6, 0.35, 2.0), skin2, Vec3.zero());
    bit(bs, head, Vec3.xyz(0, -0.27, -2.55), Vec3.xyz(1.3, 0.1, 0.1), Vec3.xyz(1, 1, 0.9), Vec3.zero());
    let side: f32 = -1;
    while side < 2 {
        bit(bs, head, Vec3.xyz(side * 0.7, 0.55, -1.9), Vec3.xyz(0.3, 0.3, 0.3), Vec3.xyz(1, 0.9, 0.2), Vec3.xyz(3, 2.4, 0.4));
        bit(bs, head, Vec3.xyz(side * 1.0, 0.0, -0.4), Vec3.xyz(0.1, 0.9, 0.9), skin2, volt() * (0.1 + hot));
        side += 2;
    }
    // Arcs crawling over it while it is open or charged.
    if hot > 0 {
        let k = 0;
        while k < 4 {
            let s = segment(bs, (k * 3) % SEGMENTS);
            let a = bs.fxRng.unit() * 6.2831853;
            let tip = s + Vec3.xyz(cos(a) * 2.6, 0.4 + bs.fxRng.unit() * 2.4, sin(a) * 2.6);
            glowRay(bs, s, tip, 0.12, Vec3.zero(), volt() * 2);
            k += 1;
        }
    }
}
