// Top-down map: small in the top left following you, or the whole arena in the middle while
// M has the game paused. Boxes from the level tinted by biome, enemies as dots, shrines as
// white diamonds, you as an arrow.

module fps_shooter.minimap;

use j3.game;
use j3.game.Font;
use j3.math.{ Vec2, Vec3, clamp, cos, max, min, sin };
use fps_shooter.biome;
use fps_shooter.bosskit;
use fps_shooter.bosskit.Bosses;
use fps_shooter.enemies.{ Enemies, MAX_ENEMIES };
use fps_shooter.level;
use fps_shooter.level.{ Level, BARRIER, EDGES, ICE, LAVA };
use fps_shooter.player.Player;
use fps_shooter.shrine.{ Shrines, MAX_SHRINES };

const SMALL: f32 = 180;
/// Meters across the small map.
const NEAR: f32 = 120;
/// Meters across the big map: the 330 m arena plus a margin.
const WHOLE: f32 = 345;

/// A window `size` pixels square at `x0`/`y0` showing `span` meters around `mid` (x/z).
struct View {
    x0: f32;
    y0: f32;
    size: f32;
    mid: Vec3;
    scale: f32;
}

fn toScreen(v: &View, x: f32, z: f32): Vec2 {
    return Vec2 { x: v.x0 + v.size * 0.5 + (x - v.mid.x) * v.scale, y: v.y0 + v.size * 0.5 + (z - v.mid.z) * v.scale };
}

fn inside(v: &View, at: Vec2): bool {
    return at.x >= v.x0 && at.y >= v.y0 && at.x <= v.x0 + v.size && at.y <= v.y0 + v.size;
}

/// A rect cut to the window.
fn rect(v: &View, x: f32, y: f32, w: f32, h: f32) {
    let ax = max(x, v.x0);
    let ay = max(y, v.y0);
    let bx = min(x + w, v.x0 + v.size);
    let by = min(y + h, v.y0 + v.size);
    if bx <= ax || by <= ay { return; }
    game.drawRect(Vec2 { x: ax, y: ay }, Vec2 { x: bx - ax, y: by - ay });
}

fn dot(v: &View, at: Vec2, r: f32) {
    rect(v, at.x - r, at.y - r, r * 2, r * 2);
}

/// Ground color of each biome tile, same order as `biome.at`.
fn tint(i: int): Vec3 {
    if i == 0 { return Vec3.xyz(215, 225, 238); }
    if i == 1 { return Vec3.xyz(110, 165, 90); }
    if i == 2 { return Vec3.xyz(85, 68, 64); }
    if i == 3 { return Vec3.xyz(205, 165, 105); }
    if i == 5 { return Vec3.xyz(185, 165, 220); }
    if i == 6 { return Vec3.xyz(205, 200, 180); }
    if i == 7 { return Vec3.xyz(62, 122, 72); }
    if i == 8 { return Vec3.xyz(125, 145, 225); }
    return Vec3.xyz(135, 175, 125);
}

fn shade(c: Vec3) {
    game.setColor(game.rgb(u8(clamp(c.x, 0, 255)), u8(clamp(c.y, 0, 255)), u8(clamp(c.z, 0, 255))));
}

/// Ground first (tops near zero), then everything standing on it, lighter the taller.
fn boxes(v: &View, lvl: &Level, tall: bool) {
    let i = 0;
    while i < lvl.count {
        let b = lvl.boxes[i];
        i += 1;
        if (b.hi.y > 1) != tall || b.hi.y < -20 || b.kind == BARRIER { continue; }
        if b.kind == LAVA {
            game.setColor(game.rgb(255, 90, 20));
        } else if b.kind == ICE {
            game.setColor(game.rgb(175, 225, 255));
        } else {
            shade(tint(biome.at((b.lo.x + b.hi.x) * 0.5, (b.lo.z + b.hi.z) * 0.5)) * clamp(0.7 + b.hi.y * 0.02, 0.7, 1.25));
        }
        let a = toScreen(v, b.lo.x, b.lo.z);
        rect(v, a.x, a.y, (b.hi.x - b.lo.x) * v.scale, (b.hi.z - b.lo.z) * v.scale);
    }
}

/// Filled diamond, `r` pixels out from `at`.
fn diamond(v: &View, at: Vec2, r: int) {
    let k = 0 - r;
    while k <= r {
        let w = f32((r - abs(k)) * 2 + 1);
        rect(v, at.x - w * 0.5, at.y + f32(k) - 0.5, w, 1);
        k += 1;
    }
}

fn abs(k: int): int {
    if k < 0 { return 0 - k; }
    return k;
}

/// A line of squares from `a` to `b`: the renderer only does rects under GL.
fn stroke(v: &View, a: Vec2, b: Vec2, r: f32) {
    let n = 12;
    let k = 0;
    while k <= n {
        let t = f32(k) / f32(n);
        dot(v, Vec2 { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }, r);
        k += 1;
    }
}

fn arrow(v: &View, p: &Player, len: f32) {
    let at = toScreen(v, p.pos.x, p.pos.z);
    // Forward on the map: -z is up.
    let fx = sin(p.yaw);
    let fy = 0 - cos(p.yaw);
    let tip = Vec2 { x: at.x + fx * len, y: at.y + fy * len };
    let back = Vec2 { x: at.x - fx * len * 0.6, y: at.y - fy * len * 0.6 };
    let left = Vec2 { x: back.x - fy * len * 0.7, y: back.y + fx * len * 0.7 };
    let right = Vec2 { x: back.x + fy * len * 0.7, y: back.y - fx * len * 0.7 };
    game.setColor(game.rgb(20, 20, 30));
    stroke(v, tip, left, 2.5);
    stroke(v, tip, right, 2.5);
    stroke(v, tip, at, 2.5);
    game.setColor(game.rgb(255, 225, 60));
    stroke(v, tip, left, 1.2);
    stroke(v, tip, right, 1.2);
    stroke(v, tip, at, 1.2);
}

/// The boss: a big pulsing diamond in its colour, pinned to the edge when it's off the map.
fn bossMark(v: &View, bs: &Bosses) {
    let b = bs.b;
    if b.kind == 0 { return; }
    let raw = toScreen(v, b.pos.x, b.pos.z);
    let pin = Vec2 { x: clamp(raw.x, v.x0 + 9, v.x0 + v.size - 9), y: clamp(raw.y, v.y0 + 9, v.y0 + v.size - 9) };
    let c = bosskit.accent(b.kind);
    let pulse = 0.75 + 0.25 * sin(bs.clock * 6);
    game.setColor(game.rgb(20, 20, 30));
    diamond(v, pin, 10);
    game.setColor(game.rgb(u8(255 * c.x * pulse), u8(255 * c.y * pulse), u8(255 * c.z * pulse)));
    diamond(v, pin, 8);
    game.setColor(game.rgb(20, 20, 30));
    diamond(v, pin, 3);
}

fn map(v: &View, lvl: &Level, p: &Player, e: &Enemies, sh: &Shrines, bs: &Bosses, big: bool) {
    game.setColor(game.rgba(12, 14, 26, 220));
    game.drawRect(Vec2 { x: v.x0 - 3, y: v.y0 - 3 }, Vec2 { x: v.size + 6, y: v.size + 6 });
    boxes(v, lvl, false);
    boxes(v, lvl, true);
    // Locked biomes darkened, and a gold mark on each lock that's up.
    let t = 0;
    while t < 9 {
        if !level.isOpen(lvl, t) {
            let a = toScreen(v, f32(t % 3) * 110 - 165, f32(t / 3) * 110 - 165);
            game.setColor(game.rgba(0, 0, 0, 170));
            rect(v, a.x, a.y, 110 * v.scale, 110 * v.scale);
        }
        t += 1;
    }
    let g = 0;
    while g < EDGES {
        if sh.list[MAX_SHRINES + g].live {
            let m = level.edgeMid(g);
            let lk = toScreen(v, m.x, m.z);
            game.setColor(game.rgb(20, 20, 30));
            dot(v, lk, 5);
            game.setColor(game.rgb(255, 200, 60));
            dot(v, lk, 3.5);
        }
        g += 1;
    }
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        i += 1;
        if en.kind == 0 { continue; }
        let at = toScreen(v, en.pos.x, en.pos.z);
        game.setColor(game.rgb(20, 20, 30));
        dot(v, at, 3);
        if en.gold { game.setColor(game.rgb(255, 200, 40)); } else { game.setColor(game.rgb(255, 50, 50)); }
        dot(v, at, 2);
    }
    let s = 0;
    while s < MAX_SHRINES {
        let sr = sh.list[s];
        s += 1;
        if !sr.live { continue; }
        // Off the small map: pinned to its edge so you know which way.
        let raw = toScreen(v, sr.pos.x, sr.pos.z);
        let pin = Vec2 { x: clamp(raw.x, v.x0 + 6, v.x0 + v.size - 6), y: clamp(raw.y, v.y0 + 6, v.y0 + v.size - 6) };
        game.setColor(game.rgb(20, 20, 30));
        diamond(v, pin, 7);
        game.setColor(game.rgb(255, 255, 255));
        diamond(v, pin, 5);
    }
    bossMark(v, bs);
    if big { arrow(v, p, 11); } else { arrow(v, p, 8); }
}

pub fn draw(lvl: &Level, p: &Player, e: &Enemies, sh: &Shrines, bs: &Bosses, open: bool, font: Font, bigFont: Font) {
    if !open {
        let small = View { x0: 15, y0: 17, size: SMALL, mid: p.pos, scale: SMALL / NEAR };
        map(&small, lvl, p, e, sh, bs, false);
        return;
    }
    let sz = game.windowSize();
    game.setColor(game.rgba(8, 10, 20, 190));
    game.drawRect(Vec2 { x: 0, y: 0 }, sz);
    let size = min(sz.x, sz.y) - 110;
    let whole = View { x0: (sz.x - size) * 0.5, y0: (sz.y - size) * 0.5 + 20, size: size, mid: Vec3.zero(), scale: size / WHOLE };
    map(&whole, lvl, p, e, sh, bs, true);
    // Each biome's name at its tile's middle.
    let t = 0;
    while t < 9 {
        let c = toScreen(&whole, f32(t % 3 - 1) * 110, f32(t / 3 - 1) * 110);
        let ts = game.textSize(font, biome.name(t));
        game.setColor(game.rgba(10, 10, 20, 200));
        game.drawText(font, Vec2 { x: c.x - ts.x * 0.5 + 1, y: c.y - ts.y * 0.5 + 1 }, biome.name(t));
        game.setColor(game.rgb(245, 245, 255));
        game.drawText(font, Vec2 { x: c.x - ts.x * 0.5, y: c.y - ts.y * 0.5 }, biome.name(t));
        t += 1;
    }
    let title = "MAP";
    let tt = game.textSize(bigFont, title);
    game.setColor(game.rgb(255, 220, 90));
    game.drawText(bigFont, Vec2 { x: (sz.x - tt.x) * 0.5, y: whole.y0 - tt.y - 8 }, title);
    let hint = "M TO CLOSE";
    let hs = game.textSize(font, hint);
    game.setColor(game.rgb(200, 205, 220));
    game.drawText(font, Vec2 { x: whole.x0 + size - hs.x, y: whole.y0 - hs.y - 8 }, hint);
}
