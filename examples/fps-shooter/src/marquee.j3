// Marquee: a neon showman striding over Toy City on stilt legs. Each show it paints impact
// rings and fires a staggered volley from its head: walk off the rings. After a few shows it
// overheats, folds its legs and lowers its head to the ground, steaming: easy to hit. Its knee
// lights glow while it performs; shoot both out and it overheats at once. Phase two fires a
// bigger volley.

module fps_shooter.marquee;

use j3.math.{ Mat4, Vec3, TAU, abs, clamp, cos, max, min, sin, sqrt };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, SUB, MISSILE, addPart, armed, bit, blastPlayer, box, burst, clearHazards,
    clearParts, fire, flat, flatDist, footing, forward, frame, groundTop, limb, mark, paint, projsLive, right, smoke, turn, walk, wave, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const DROP: int = 0;
const STRIDE: int = 1;
const SHOW: int = 2;
const OVERHEAT: int = 3;
const STAND: int = 4;
const IDLE: int = 5;

const DROP_T: f32 = 2.0;
/// Hips this high when standing, this high when folded down.
const HIPS: f32 = 11;
const LOW_HIPS: f32 = 2.4;
/// Each leg's two halves.
const BONE: f32 = 6.2;
const STRIDE_T: f32 = 2.5;
const STRIDE_T2: f32 = 2.0;
const SPEED: f32 = 5;
const KEEP: f32 = 16;
/// Head volley: spots, seconds between them, how long a ring shows, and how soon the shot leaves.
const SPOTS: int = 6;
const SPOTS2: int = 9;
const SPOT_GAP: f32 = 0.22;
const SPOT_T: f32 = 1.4;
const FLIGHT: f32 = 0.85;
const SPOT_R: f32 = 2.2;
const VOLLEY_DMG: f32 = 16;
/// Shows before it overheats.
const SHOWS: int = 3;
const SHOWS2: int = 2;
const OVERHEAT_T: f32 = 4.5;
const OVERHEAT_T2: f32 = 3.8;
/// Shooting both knees out adds this to the overheat.
const JAMMED: f32 = 1.0;
const STAND_T: f32 = 1.0;
const KNEE_HP: f32 = 0.035;
const HEAD: f32 = 3;
const LEASH: f32 = 45;

fn pink(): Vec3 {
    return Vec3.xyz(3, 0.5, 2.2);
}

fn cyan(): Vec3 {
    return Vec3.xyz(0.4, 2.6, 3);
}

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.aim = b.pos;
    b.from = b.pos + Vec3.xyz(0, 40, 0);
    b.pos = b.from;
    b.state = DROP;
    b.t = 0;
    b.len = DROP_T;
    b.intro = DROP_T;
    b.heat = HIPS;
    b.cycle = 0;
    mark(bs, b.aim, 4.5, DROP_T, pink());
}

fn to(b: &Boss, state: int, len: f32) {
    b.state = state;
    b.t = 0;
    b.len = len;
    b.step = 0;
}

/// Light the knees for a show.
fn lightKnees(bs: &Bosses) {
    let i = 0;
    while i < 2 {
        bs.sub[i] = bs.b.maxHp * KNEE_HP;
        bs.subOn[i] = true;
        i += 1;
    }
}

fn kneesOut(bs: &Bosses): bool {
    return !bs.subOn[0] && !bs.subOn[1];
}

/// A spot on ground at the player's height, or false over a drop.
fn spotAt(lvl: &Level, x: f32, z: f32, floor: f32, out: &Vec3): bool {
    let g = groundTop(lvl, x, z, 0.6, floor + 1.5);
    if g < floor - 1.5 { return false; }
    out.x = x;
    out.y = g;
    out.z = z;
    return true;
}

/// The next ring of a volley: the first on the player, the rest around them.
fn spot(bs: &Bosses, p: &Player, lvl: &Level) {
    let floor = footing(lvl, p);
    let at = Vec3.zero();
    let tries = 0;
    while tries < 6 {
        let x = p.pos.x + p.vel.x * 0.3;
        let z = p.pos.z + p.vel.z * 0.3;
        if bs.b.step > 0 || tries > 0 {
            let a = bs.rng.unit() * TAU;
            let r = 2 + bs.rng.unit() * 5;
            x = p.pos.x + cos(a) * r;
            z = p.pos.z + sin(a) * r;
        }
        if spotAt(lvl, x, z, floor, &at) {
            let hot = pink();
            if bs.b.step % 2 == 1 { hot = cyan(); }
            paint(bs, at, SPOT_R, SPOT_T, hot);
            return;
        }
        tries += 1;
    }
}

/// Fire any painted ring whose shot is due, from the head.
fn launch(bs: &Bosses) {
    let i = 0;
    while i < bs.marks.len {
        let m = bs.marks[i];
        if m.live && m.armed && m.len - m.t <= FLIGHT {
            fire(bs, MISSILE, head(&bs.b), i, 6, VOLLEY_DMG);
            sfx.at(sfx.BEAM, bs.b.pos);
        }
        i += 1;
    }
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    b.open = b.open + (b.openTo - b.open) * min(dt * 3, 1);
    b.openTo = 0;
    if b.state == DROP {
        let k = clamp(b.t / b.len, 0, 1);
        b.pos = b.from + (b.aim - b.from) * (k * k);
        b.anim += dt;
        if k >= 1 {
            b.pos = b.aim;
            sfx.at(sfx.SLAM, b.pos);
            blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), 4.5, 25, 12);
            wave(bs, b.pos, 15, 16, 0.9, 15, pink());
            smoke(bs, b.pos, 10, 5, Vec3.xyz(0.5, 0.45, 0.55), Vec3.zero());
            to(b, STRIDE, STRIDE_T);
        }
    } else if b.state == STRIDE || b.state == IDLE {
        let goal = flat(p.pos);
        if !b.engaged { goal = flat(b.home); }
        let off = goal - flat(b.pos);
        let far = off.length();
        let want = Vec3.zero();
        let keep: f32 = if b.engaged { KEEP } else { 2 };
        if far > keep + 2 { want = off * (SPEED / far); }
        if far < keep - 4 && b.engaged { want = off * (0 - SPEED * 0.6 / max(far, 0.1)); }
        if flatDist(b.pos + want, b.home) > LEASH { want = flat(b.home - b.pos).normalize() * SPEED; }
        b.vel = b.vel + (want - b.vel) * min(dt * 2, 1);
        // Stilts step over the rooftops: only the world's edge and the gates stop it.
        walk(bs, lvl, b.vel, 0.6, 40, dt);
        b.pos.y = b.home.y;
        b.anim += b.vel.length() * dt * 0.35;
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 1.5);
        if !b.engaged { b.state = IDLE; }
        else if b.state == IDLE { to(b, STRIDE, STRIDE_T); }
        else if b.t >= (if b.phase2 { STRIDE_T2 } else { STRIDE_T }) {
            b.vel = Vec3.zero();
            to(b, SHOW, 0);
            lightKnees(bs);
            sfx.at(sfx.WARN, b.pos);
        }
    } else if b.state == SHOW {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt);
        launch(bs);
        let n = if b.phase2 { SPOTS2 } else { SPOTS };
        if b.step < n && b.t >= f32(b.step) * SPOT_GAP {
            spot(bs, p, lvl);
            b.step += 1;
        }
        if kneesOut(bs) {
            // Both knees shot out mid-show: it seizes up at once.
            clearHazards(bs);
            b.cycle = 0;
            to(b, OVERHEAT, (if b.phase2 { OVERHEAT_T2 } else { OVERHEAT_T }) + JAMMED);
            sfx.at(sfx.SLAM, b.pos);
        } else if b.step >= n && armed(bs) == 0 && projsLive(bs) == 0 {
            bs.subOn[0] = false;
            bs.subOn[1] = false;
            b.cycle += 1;
            if b.cycle >= (if b.phase2 { SHOWS2 } else { SHOWS }) {
                b.cycle = 0;
                to(b, OVERHEAT, if b.phase2 { OVERHEAT_T2 } else { OVERHEAT_T });
                sfx.at(sfx.SLAM, b.pos);
            } else {
                to(b, STRIDE, STRIDE_T * 0.6);
            }
        }
    } else if b.state == OVERHEAT {
        b.openTo = 1;
        if b.open > 0.6 { b.cue = true; }
        if bs.fxRng.unit() < dt * 20 {
            smoke(bs, head(b), 1, 3, Vec3.xyz(0.85, 0.85, 0.9), Vec3.xyz(0.2, 0.05, 0.15));
        }
        if b.t >= b.len {
            to(b, STAND, STAND_T);
            sfx.at(sfx.BEAM, b.pos);
        }
    } else if b.state == STAND {
        if b.t >= b.len { to(b, STRIDE, STRIDE_T); }
    }
    // Folding down for the overheat, and back up.
    b.heat = HIPS + (LOW_HIPS - HIPS) * b.open;
    // The legs push the player: knees and shins as spheres.
    pose(bs);
    bs.glowAt = head(b) + forward(b.yaw) * 3;
    bs.glowColor = Vec3.xyz(1.5, 0.3, 1.1) * (0.3 + b.open * 0.4);
    bs.glowR = 10;
}

/// Where the hips are: over its feet, lower as it folds.
fn hips(b: &Boss): Vec3 {
    let bob = abs(sin(b.anim * 2)) * 0.4;
    return b.pos + Vec3.xyz(0, b.heat + bob, 0) + forward(b.yaw) * (b.open * 2.5);
}

/// The head: over the hips standing, forward and down near the ground when overheated.
fn head(b: &Boss): Vec3 {
    return hips(b) + Vec3.xyz(0, 2.3 - b.open * 0.6, 0) + forward(b.yaw) * (b.open * 1.5);
}

/// Foot `side` (-1 left, 1 right): stepping while it walks.
fn foot(b: &Boss, side: f32): Vec3 {
    let phase = b.anim * 2 + (if side > 0 { 3.1416 } else { 0 });
    let fwd = forward(b.yaw);
    let lift = max(sin(phase), 0) * 1.2;
    return b.pos + right(b.yaw) * (side * 2.3) + fwd * (cos(phase) * 1.8) + Vec3.xyz(0, lift, 0);
}

/// Its knee: bent backwards, far enough out that each half stays `BONE` long.
fn knee(b: &Boss, side: f32): Vec3 {
    let hip = hips(b) + right(b.yaw) * (side * 1.1);
    let f = foot(b, side);
    let mid = (hip + f) * 0.5;
    let d = (f - hip).length();
    let bend = sqrt(max(BONE * BONE - d * d * 0.25, 0.25));
    let leg = (f - hip).normalize();
    let back = forward(b.yaw) * -1;
    let out = back - leg * back.dot(leg);
    if out.length() < 0.01 { out = back; }
    return mid + out.normalize() * bend;
}

fn pose(bs: &Bosses) {
    let b = &bs.b;
    clearParts(bs);
    let mult: f32 = if b.open > 0.6 { HEAD } else { 1 };
    addPart(bs, head(b), 2.0, mult, WEAK);
    addPart(bs, head(b) + Vec3.xyz(0, 2.3, 0), 1.2, 1, BODY);
    let side: f32 = -1;
    let i = 0;
    while i < 2 {
        let hip = hips(b) + right(b.yaw) * (side * 1.1);
        let k = knee(b, side);
        let f = foot(b, side);
        if bs.subOn[i] { addPart(bs, k, 0.6, 1, SUB + i); }
        addPart(bs, (hip + k) * 0.5, 0.5, 0.8, BODY);
        addPart(bs, (k + f) * 0.5, 0.5, 0.8, BODY);
        addPart(bs, f + Vec3.xyz(0, 0.5, 0), 0.6, 0.8, BODY);
        side += 2;
        i += 1;
    }
}

/// The chasing bulbs round the sign's face.
fn bulbs(bs: &Bosses, face: Mat4, chase: int) {
    let k = 0;
    while k < 12 {
        let x = -2.3 + f32(k) * 4.6 / 11;
        let c = if (k + chase) % 3 == 0 { Vec3.xyz(3, 2.8, 1.2) } else { Vec3.xyz(0.6, 0.3, 0.4) };
        bit(bs, face, Vec3.xyz(x, 1.4, -1.12), Vec3.xyz(0.22, 0.22, 0.1), Vec3.zero(), c);
        bit(bs, face, Vec3.xyz(0 - x, -1.4, -1.12), Vec3.xyz(0.22, 0.22, 0.1), Vec3.zero(), c);
        k += 1;
    }
    k = 0;
    while k < 5 {
        let y = -1.0 + f32(k) * 0.5;
        let lit = if (k + chase) % 3 == 0 { Vec3.xyz(3, 2.8, 1.2) } else { Vec3.xyz(0.6, 0.3, 0.4) };
        bit(bs, face, Vec3.xyz(-2.4, y, -1.12), Vec3.xyz(0.22, 0.22, 0.1), Vec3.zero(), lit);
        bit(bs, face, Vec3.xyz(2.4, 0 - y, -1.12), Vec3.xyz(0.22, 0.22, 0.1), Vec3.zero(), lit);
        k += 1;
    }
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let chrome = Vec3.xyz(0.7, 0.72, 0.8);
    let plum = Vec3.xyz(0.22, 0.12, 0.3);
    let black = Vec3.xyz(0.04, 0.03, 0.05);
    let h = head(b);
    // The face tips forward as it folds, to look up the player it's slumped toward.
    let face = frame(h, b.yaw).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), b.open * 0.35));
    // Legs from the hips, knees lit while it performs.
    let side: f32 = -1;
    let i = 0;
    while i < 2 {
        let hip = hips(b) + right(b.yaw) * (side * 1.1);
        let kn = knee(b, side);
        let f = foot(b, side);
        limb(bs, hip, kn, 0.5, 0.5, chrome, Vec3.zero());
        limb(bs, kn, f, 0.42, 0.42, chrome, Vec3.zero());
        box(bs, frame(f, b.yaw), Vec3.xyz(0, 0.2, -0.3), Vec3.xyz(1.2, 0.4, 1.9), plum, Vec3.zero());
        let lit = bs.subOn[i];
        let bulb = if lit { Vec3.xyz(3, 2.6, 0.6) * (0.8 + 0.3 * sin(b.t * 12 + side)) } else { Vec3.xyz(0.1, 0.05, 0.1) };
        box(bs, frame(kn, b.yaw), Vec3.zero(), Vec3.xyz(0.8, 0.8, 0.8), black, bulb);
        side += 2;
        i += 1;
    }
    let hp = frame(hips(b), b.yaw);
    box(bs, hp, Vec3.zero(), Vec3.xyz(2.8, 0.8, 1.2), chrome, Vec3.zero());
    limb(bs, hips(b), h - Vec3.xyz(0, 1.2, 0), 0.6, 0.6, chrome, Vec3.zero());
    // The marquee: a sign-box head framed in chasing bulbs, a screen face, a top hat.
    box(bs, face, Vec3.zero(), Vec3.xyz(5.0, 3.0, 2.2), plum, Vec3.zero());
    bit(bs, face, Vec3.xyz(0, 0, -1.11), Vec3.xyz(4.0, 2.1, 0.05), black, Vec3.zero());
    let hotEye = if b.open > 0.5 { Vec3.xyz(3, 0.3, 0.2) } else { pink() };
    let droop = b.open * 0.25;
    bit(bs, face, Vec3.xyz(-1.0, 0.35 - droop, -1.15), Vec3.xyz(0.7, 0.5 - droop, 0.05), black, hotEye);
    bit(bs, face, Vec3.xyz(1.0, 0.35 - droop, -1.15), Vec3.xyz(0.7, 0.5 - droop, 0.05), black, hotEye);
    let k = 0;
    while k < 5 {
        let x = -1.0 + f32(k) * 0.5;
        let curve = (x * x) * 0.25 * (1 - b.open * 2);
        bit(bs, face, Vec3.xyz(x, -0.5 + curve, -1.15), Vec3.xyz(0.4, 0.14, 0.05), black, cyan());
        k += 1;
    }
    bulbs(bs, face, int(b.t * 12));
    box(bs, face, Vec3.xyz(0, 1.62, 0), Vec3.xyz(3.6, 0.22, 2.8), black, Vec3.zero());
    box(bs, face, Vec3.xyz(0, 2.6, 0), Vec3.xyz(2.4, 1.8, 2.0), black, Vec3.zero());
    bit(bs, face, Vec3.xyz(0, 1.95, 0), Vec3.xyz(2.46, 0.3, 2.06), Vec3.zero(), pink());
}
