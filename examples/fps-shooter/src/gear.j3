// Shrine helpers that fight on their own: the battle drone hovering at your shoulder, and the
// turret you drop with G. Both go for the boss too when it's the nearest thing.

module fps_shooter.gear;

use j3.game;
use j3.game.Key;
use j3.gfx;
use j3.gfx.{ Look, Mesh, Ray };
use j3.math.{ Mat4, Vec3, atan2, clamp, cos, max, min, sin };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.Scene;
use fps_shooter.boss;
use fps_shooter.bosskit.Bosses;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.level.{ Level, shoot };
use fps_shooter.player.{ Player, has, look, DRONE, TURRET };
use fps_shooter.sfx;

/// Battle drone: how far it sees, its fire rate and damage, how snappily it follows, and how far
/// it may fall behind before it catches up at once. Follow is a loose spring (pull and drag), so it
/// swings out behind when you run and drifts back when you stop.
const DRONE_RANGE: f32 = 28;
const DRONE_RATE: f32 = 0.22;
const DRONE_DAMAGE: f32 = 12;
const DRONE_FOLLOW: f32 = 9;
const DRONE_DRAG: f32 = 3.2;
const DRONE_SCALE: f32 = 1;
/// The distance it keeps from you, measured from this height above your feet.
const DRONE_DIST: f32 = 6;
const DRONE_HEIGHT: f32 = 1.7;
const DRONE_LEASH: f32 = 25;
const TURRET_RANGE: f32 = 30;
const TURRET_RATE: f32 = 0.15;
const TURRET_DAMAGE: f32 = 8;
/// G drops the turret where you look, up to this far, or at your feet.
const PLACE_REACH: f32 = 6;
/// A target that is the boss rather than an enemy slot.
const AT_BOSS: int = -2;

pub struct Gear {
    dronePos: Vec3;
    droneDir: Vec3;
    target: int;
    /// Time left swooping away after a hit.
    droneCd: f32;
    seekT: f32;
    /// The drone's last shot, for a tracer.
    droneEnd: Vec3;
    droneVel: Vec3;
    droneShot: f32;
    turret: bool;
    turretAt: Vec3;
    aim: Vec3;
    turretCd: f32;
    /// The last turret shot, for a tracer.
    shotEnd: Vec3;
    shotT: f32;
    cube: Mesh;
}

pub fn create(): Gear {
    return Gear {
        dronePos: Vec3.zero(), droneDir: Vec3.xyz(0, 0, -1), target: -1, droneCd: 0, seekT: 0, droneEnd: Vec3.zero(), droneVel: Vec3.zero(), droneShot: 0,
        turret: false, turretAt: Vec3.zero(), aim: Vec3.xyz(0, 0, -1), turretCd: 0, shotEnd: Vec3.zero(), shotT: 0,
        cube: Mesh { vao: 0, vbo: 0, count: 0 },
    };
}

pub fn upload(gr: &Gear, mem: &Arena) {
    gr.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

/// Where the drone hovers: over your right shoulder.
fn shoulder(p: &Player): Vec3 {
    let l = Look.create(p.pos, p.yaw, 0);
    return p.pos + l.right() * 1.6 - l.forward() * 0.3 + Vec3.xyz(0, 1.7 + sin(f32(game.ticks()) * 0.003) * 0.08, 0);
}

/// The nearest enemy within `range` of `at`, or the boss when it's nearer: an enemy index,
/// AT_BOSS, or -1.
fn pick(e: &Enemies, bs: &Bosses, at: Vec3, range: f32): int {
    let t = enemies.nearest(e, at, range);
    if !boss.targetable(bs) { return t; }
    let bossFar = (boss.aimPoint(bs) - at).length();
    if bossFar > range { return t; }
    if t < 0 || bossFar < (e.list[t].pos - at).length() { return AT_BOSS; }
    return t;
}

/// Hovers at your shoulder, turns to face the nearest thing it can see and shoots it.
fn drone(gr: &Gear, p: &Player, lvl: &Level, scene: &Scene, e: &Enemies, bs: &Bosses, dt: f32) {
    gr.droneCd = gr.droneCd - dt;
    gr.droneShot = gr.droneShot - dt;
    gr.seekT = gr.seekT - dt;
    if gr.seekT <= 0 {
        gr.target = pick(e, bs, gr.dronePos, DRONE_RANGE);
        gr.seekT = 0.2;
    }
    let goal = gr.dronePos;
    let live = false;
    if gr.target == AT_BOSS && boss.targetable(bs) {
        goal = boss.aimPoint(bs);
        live = true;
    } else if gr.target >= 0 && e.list[gr.target].kind != 0 {
        goal = e.list[gr.target].pos;
        live = true;
    }
    // Follow: ease to the shoulder, or snap back when left far behind.
    // No fixed side: it just keeps DRONE_DIST from you, wherever it already is around you.
    let center = p.pos + Vec3.xyz(0, DRONE_HEIGHT, 0);
    let off = gr.dronePos - center;
    if off.length() < 0.2 { off = Vec3.xyz(1, 0, 0); }
    off.y = clamp(off.y, -0.5, 0.5);
    let home = center + off.normalize() * DRONE_DIST;
    if (home - gr.dronePos).length() > DRONE_LEASH { gr.dronePos = center + Look.create(p.pos, p.yaw, 0).right() * DRONE_DIST; gr.droneVel = Vec3.zero(); }
    gr.droneVel = gr.droneVel + ((home - gr.dronePos) * DRONE_FOLLOW - gr.droneVel * DRONE_DRAG) * dt;
    gr.dronePos = gr.dronePos + gr.droneVel * dt;
    let face = look(p).forward();
    if live { face = (goal - gr.dronePos).normalize(); }
    gr.droneDir = (gr.droneDir + (face - gr.droneDir) * min(dt * 10, 1)).normalize();
    if !live || gr.droneCd > 0 { return; }
    gr.droneCd = DRONE_RATE;
    // Only with a clear line.
    let to = goal - gr.dronePos;
    let far = to.length();
    let dir = to.normalize();
    let sight = shoot(lvl, scene, Ray { origin: gr.dronePos, dir: dir }, far);
    if sight.hit { gr.seekT = 0; return; }
    // Its hits are half as loud as yours.
    sfx.hush(true);
    if gr.target == AT_BOSS {
        let struck = boss.ray(bs, Ray { origin: gr.dronePos, dir: dir }, far + 3);
        if struck.part >= 0 {
            gr.droneEnd = gr.dronePos + dir * struck.t;
            boss.damage(bs, e, struck.part, DRONE_DAMAGE, gr.droneEnd);
        }
    } else {
        enemies.damage(e, gr.target, DRONE_DAMAGE, dir * 1.5, goal);
        gr.droneEnd = goal;
    }
    sfx.hush(false);
    gr.droneShot = 0.06;
}

fn turret(gr: &Gear, p: &Player, lvl: &Level, scene: &Scene, e: &Enemies, bs: &Bosses, dt: f32) {
    if game.keyPressed(Key.G) {
        let l = look(p);
        let hit = shoot(lvl, scene, Ray { origin: l.eye, dir: l.forward() }, PLACE_REACH);
        let at = p.pos;
        if hit.hit {
            // Back off the surface, then down onto whatever is below.
            let off = hit.point - l.forward() * 0.4;
            let down = shoot(lvl, scene, Ray { origin: off, dir: Vec3.xyz(0, -1, 0) }, 30);
            if down.hit { at = down.point; }
        }
        gr.turret = true;
        gr.turretAt = at;
        gr.turretCd = 0.5;
    }
    if !gr.turret { return; }
    gr.shotT = gr.shotT - dt;
    gr.turretCd = gr.turretCd - dt;
    let head = gr.turretAt + Vec3.xyz(0, 1.1, 0);
    let target = pick(e, bs, head, TURRET_RANGE);
    if target == -1 { return; }
    let goal = boss.aimPoint(bs);
    if target >= 0 { goal = e.list[target].pos; }
    let to = goal - head;
    let far = to.length();
    gr.aim = to.normalize();
    if gr.turretCd > 0 { return; }
    gr.turretCd = TURRET_RATE;
    // Only with a clear line.
    let sight = shoot(lvl, scene, Ray { origin: head, dir: gr.aim }, far);
    if sight.hit { return; }
    if target == AT_BOSS {
        let struck = boss.ray(bs, Ray { origin: head, dir: gr.aim }, far + 3);
        if struck.part < 0 { return; }
        gr.shotEnd = head + gr.aim * struck.t;
        boss.damage(bs, e, struck.part, TURRET_DAMAGE, gr.shotEnd);
    } else {
        enemies.damage(e, target, TURRET_DAMAGE, gr.aim * 1.5, goal);
        gr.shotEnd = goal;
    }
    gr.shotT = 0.05;
}

pub fn update(gr: &Gear, p: &Player, lvl: &Level, scene: &Scene, e: &Enemies, bs: &Bosses, dt: f32) {
    // Lost on going down, with the rest of the gifts.
    if !has(p, TURRET) { gr.turret = false; }
    if has(p, DRONE) {
        drone(gr, p, lvl, scene, e, bs, dt);
    } else {
        gr.dronePos = shoulder(p);
        gr.droneVel = Vec3.zero();
        gr.droneCd = 0;
    }
    if has(p, TURRET) { turret(gr, p, lvl, scene, e, bs, dt); }
}

fn box(gr: &Gear, m: Mat4, tint: Vec3, glow: Vec3) {
    gfx.material(tint, glow);
    gfx.drawDoubleSided(gr.cube, m);
}

/// A frame looking along `dir` from `at`: -z points down `dir`.
fn facing(at: Vec3, dir: Vec3): Mat4 {
    let yaw = atan2(0 - dir.x, 0 - dir.z);
    let pitch = atan2(dir.y, max(Vec3.xyz(dir.x, 0, dir.z).length(), 0.0001));
    return Mat4.translate(at.x, at.y, at.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), yaw)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), pitch));
}

/// `lit`: the camera pass (the tracer only draws there).
pub fn draw(gr: &Gear, p: &Player, lit: bool) {
    if has(p, DRONE) {
        let m = facing(gr.dronePos, gr.droneDir).mul(Mat4.scale(DRONE_SCALE, DRONE_SCALE, DRONE_SCALE));
        let steel = Vec3.xyz(0.3, 0.31, 0.33);
        let dark = Vec3.xyz(0.14, 0.15, 0.17);
        // Chunky dark-gray hull with a red eye, a gun barrel, and
        // four arms carrying hubs and spinning blades.
        box(gr, m.mul(Mat4.scale(0.34, 0.16, 0.4)), steel, Vec3.zero());
        box(gr, m.mul(Mat4.translate(0, 0.1, 0)).mul(Mat4.scale(0.16, 0.05, 0.2)), dark, Vec3.zero());
        box(gr, m.mul(Mat4.translate(0, -0.1, 0)).mul(Mat4.scale(0.16, 0.05, 0.2)), dark, Vec3.zero());
        box(gr, m.mul(Mat4.translate(0, 0.01, -0.21)).mul(Mat4.scale(0.14, 0.08, 0.04)), Vec3.zero(), Vec3.xyz(2.6, 0.4, 0.3));
        box(gr, m.mul(Mat4.translate(0, -0.06, -0.3)).mul(Mat4.scale(0.05, 0.05, 0.26)), dark, Vec3.zero());
        let spin = f32(game.ticks()) * 0.06;
        let k = 0;
        while k < 4 {
            let sx: f32 = 1;
            if k % 2 == 0 { sx = 0 - 1; }
            let sz: f32 = 1;
            if k < 2 { sz = 0 - 1; }
            let at = Vec3.xyz(sx * 0.3, 0.08, sz * 0.28);
            box(gr, m.mul(Mat4.translate(at.x * 0.5, 0.04, at.z * 0.5)).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), sx * sz * 0.785)).mul(Mat4.scale(0.06, 0.06, 0.42)), steel, Vec3.zero());
            box(gr, m.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(0.1, 0.1, 0.1)), dark, Vec3.zero());
            box(gr, m.mul(Mat4.translate(at.x, at.y + 0.08, at.z)).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), spin + f32(k))).mul(Mat4.scale(0.5, 0.03, 0.07)), Vec3.xyz(0.2, 0.21, 0.23), Vec3.zero());
            k += 1;
        }
        if lit && gr.droneShot > 0 { gfx.drawLine(gr.dronePos + gr.droneDir * 0.3, gr.droneEnd, Vec3.xyz(1, 0.4, 0.3)); }
    }
    if gr.turret {
        let t = gr.turretAt;
        box(gr, Mat4.translate(t.x, t.y + 0.15, t.z).mul(Mat4.scale(0.8, 0.3, 0.8)), Vec3.xyz(0.3, 0.32, 0.4), Vec3.zero());
        box(gr, Mat4.translate(t.x, t.y + 0.6, t.z).mul(Mat4.scale(0.2, 0.7, 0.2)), Vec3.xyz(0.3, 0.32, 0.4), Vec3.zero());
        let head = facing(t + Vec3.xyz(0, 1.1, 0), gr.aim);
        box(gr, head.mul(Mat4.scale(0.5, 0.35, 0.55)), Vec3.xyz(0.35, 0.85, 0.6), Vec3.zero());
        box(gr, head.mul(Mat4.translate(0, 0, -0.45)).mul(Mat4.scale(0.1, 0.1, 0.5)), Vec3.xyz(0.15, 0.15, 0.2), Vec3.zero());
        box(gr, head.mul(Mat4.translate(0, 0.05, -0.28)).mul(Mat4.scale(0.3, 0.08, 0.02)), Vec3.zero(), Vec3.xyz(0.3, 2, 1.2));
        if lit && gr.shotT > 0 { gfx.drawLine(t + Vec3.xyz(0, 1.1, 0) + gr.aim * 0.7, gr.shotEnd, Vec3.xyz(0.4, 1, 0.7)); }
    }
}
