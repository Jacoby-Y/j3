// Faultjaw chases underground, breaches in a tall arc, then snakes across the surface
// firing sandy spike-ball barrages. Each body segment follows the previous one in 3D.
module fps_shooter.faultjaw;

use j3.math.{ Vec3, Mat4, atan2, clamp, cos, max, min, sin };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, SAND_BALL, addPart, bit, box, burst, clearParts,
    flat, flatDist, frame, forward, groundTop, mark, puff, lobRock, turn, walled, yawTo };
use fps_shooter.level;
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const BURIED: int = 0;
const WARNING: int = 1;
const BREACH: int = 2;
const SURFACE: int = 3;
const DIVE: int = 4;
const SEGMENTS: int = 10;

fn amber(): Vec3 { return Vec3.xyz(2.4, 1.1, 0.12); }
fn to(b: &Boss, state: int, len: f32) { b.state = state; b.t = 0; b.len = len; }
// Let the trailing links finish entering the ground after the head has dived.
fn visible(b: &Boss): bool { return b.state >= BREACH || (b.state == BURIED && b.cycle > 0 && b.t < 0.55); }
fn segment(bs: &Bosses, i: int): Vec3 { return bs.worm[bs.active * SEGMENTS + i]; }

fn bodyFrame(bs: &Bosses, i: int): Mat4 {
    let at = segment(bs, i);
    let dir = bs.b.vel;
    if i > 0 { dir = segment(bs, i - 1) - at; }
    let pitch = atan2(dir.y, max(flat(dir).length(), 0.01));
    return frame(at, if flat(dir).length() > 0.01 { yawTo(at, at + dir) } else { bs.b.yaw })
        .mul(Mat4.rotate(Vec3.xyz(1, 0, 0), pitch));
}

fn follow(bs: &Bosses, dt: f32) {
    let offset = bs.active * SEGMENTS;
    bs.worm[offset] = bs.b.pos;
    let i = 1;
    while i < SEGMENTS {
        let prev = bs.worm[offset + i - 1];
        let at = bs.worm[offset + i];
        let off = at - prev;
        if off.length() < 0.001 { off = Vec3.xyz(0, 0, 1); }
        // Fixed link length preserves a flowing curve through takeoff and re-entry.
        bs.worm[offset + i] = prev + off.normalize() * 1.65;
        i += 1;
    }
}

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.intro = 0.9;
    b.pos.y -= 4;
    b.from = b.pos;
    b.aim = b.pos;
    b.cd = 0.35;
    b.step = 0;
    let i = 0;
    while i < SEGMENTS { bs.worm[bs.active * SEGMENTS + i] = b.pos - forward(b.yaw) * f32(i) * 1.65; i += 1; }
    to(b, BURIED, 1.1);
}

/// Keep the chase inside this biome, even when its arena is off-center.
fn bounded(b: &Boss, at: Vec3): Vec3 {
    let goal = at;
    let cx = f32(b.tile % 3 - 1) * level.TILE;
    let cz = f32(b.tile / 3 - 1) * level.TILE;
    goal.x = clamp(goal.x, cx - 65, cx + 65);
    goal.z = clamp(goal.z, cz - 65, cz + 65);
    return goal;
}

fn volley(bs: &Bosses, p: &Player, lvl: &Level) {
    let b = &bs.b;
    let from = b.pos + Vec3.xyz(0, 1.0, 0);
    let aim = p.pos + flat(p.vel) * 0.25;
    let dir = flat(aim - from).normalize();
    let side = Vec3.xyz(0 - dir.z, 0, dir.x);
    // Two separated landing circles leave space to dodge between them.
    lobRock(bs, lvl, SAND_BALL, from, aim - side * 3.6, 10, amber() * 0.45);
    lobRock(bs, lvl, SAND_BALL, from, aim + side * 3.6, 10, amber() * 0.45);
    burst(bs, from, 4, 3, Vec3.xyz(0.8, 0.58, 0.3), amber() * 0.2);
    sfx.at(sfx.BOW, from);
}

fn pose(bs: &Bosses) {
    clearParts(bs);
    let b = &bs.b;
    if !visible(b) { return; }
    let i = 1;
    while i < SEGMENTS {
        let at = (segment(bs, i - 1) + segment(bs, i)) * 0.5;
        addPart(bs, at + Vec3.xyz(0, 0.35, 0), 0.65, if b.open > 0 { 2.8 } else { 1.2 }, WEAK);
        i += 1;
    }
    i = 0;
    while i < SEGMENTS {
        addPart(bs, segment(bs, i), max(0.5, 1.5 - f32(i) * 0.11), 1, BODY);
        i += 1;
    }
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.anim += dt;
    b.open = 0;
    let was = b.pos;
    b.t += dt;
    if b.state == BURIED {
        let goal = bounded(b, p.pos + flat(p.vel) * 0.4 + Vec3.xyz(cos(b.anim * 1.3) * 14, 0, sin(b.anim * 1.3) * 14));
        if !b.engaged { goal = bounded(b, b.home + Vec3.xyz(cos(b.anim) * 12, 0, sin(b.anim) * 12)); }
        let dir = flat(goal - b.pos);
        if dir.length() > 1 {
            b.yaw = turn(b.yaw, yawTo(b.pos, goal), dt * 3.5);
            b.pos = bounded(b, b.pos + forward(b.yaw) * (if b.phase2 { 29 } else { 24 }) * dt);
        }
        let floor = groundTop(lvl, b.pos.x, b.pos.z, 0.5, b.home.y + 2);
        b.pos.y = max(floor, -30) - 4;
        if bs.fxRng.unit() < dt * 35 { puff(bs, Vec3.xyz(b.pos.x, floor + 0.2, b.pos.z), Vec3.xyz(0, 3, 0), 0.35, 0.55, 1, 0, Vec3.xyz(0.7, 0.5, 0.3), Vec3.zero()); }
        if b.t >= b.len && b.engaged {
            mark(bs, Vec3.xyz(b.pos.x, floor, b.pos.z), 3, 0.4, amber() * 0.45);
            to(b, WARNING, 0.4);
        }
    } else if b.state == WARNING && b.t >= b.len {
        if b.cycle % 2 == 0 {
            b.from = b.pos;
            let intercept = p.pos + flat(p.vel) * 0.65;
            let across = flat(intercept - b.pos);
            if across.length() < 1 { across = forward(b.yaw); }
            b.aim = bounded(b, b.pos + across.normalize() * clamp(across.length() + 30, 52, 82));
            // At a biome edge, turn the breach inward rather than clipping it to a tiny hop.
            if flatDist(b.from, b.aim) < 42 {
                let center = Vec3.xyz(f32(b.tile % 3 - 1) * level.TILE, 0, f32(b.tile / 3 - 1) * level.TILE);
                b.aim = bounded(b, b.pos + flat(center - b.pos).normalize() * 72);
            }
            let landingFloor = groundTop(lvl, b.aim.x, b.aim.z, 1, b.home.y + 3);
            b.aim.y = max(landingFloor, -30) - 4;
            b.heat = clamp(p.pos.y + 22 - (b.from.y + b.aim.y) * 0.5, 32, 68);
            b.cd = 0.35;
            to(b, BREACH, clamp(flatDist(b.from, b.aim) / 25, 2.4, 3.4));
        } else {
            b.pos.y += 5.8;
            b.cd = 0.45;
            b.step = 0;
            b.cd2 = 0;
            to(b, SURFACE, if b.phase2 { 4.5 } else { 5.2 });
        }
        sfx.at(sfx.SLAM, b.pos);
        burst(bs, b.pos + Vec3.xyz(0, 4, 0), 20, 10, Vec3.xyz(0.7, 0.5, 0.3), Vec3.zero());
    } else if b.state == BREACH {
        let k = clamp(b.t / b.len, 0, 1);
        b.pos = b.from + (b.aim - b.from) * k + Vec3.xyz(0, b.heat * 4 * k * (1 - k), 0);
        b.open = 1;
        b.cue = true;
        b.cd -= dt;
        if k > 0.15 && k < 0.8 && b.cd <= 0 { volley(bs, p, lvl); b.cd = if b.phase2 { 0.85 } else { 1.0 }; }
        if k >= 1 { b.cycle += 1; to(b, BURIED, 0.9); }
    } else if b.state == SURFACE {
        let chaseGoal = bounded(b, p.pos + flat(p.vel) * 0.3);
        let far = flatDist(b.pos, chaseGoal);
        // A close pass curves round the player instead of stopping in front of them.
        let heading = yawTo(b.pos, chaseGoal) + (if far < 15 { 1.0 } else { 0.15 * sin(b.anim * 2) });
        b.yaw = turn(b.yaw, heading, dt * 2.8);
        let moved = false;
        let attempt = 0;
        while attempt < 7 && !moved {
            let offset: f32 = 0;
            if attempt > 0 { offset = f32((attempt + 1) / 2) * 0.7 * (if attempt % 2 == 0 { -1 } else { 1 }); }
            let headingTry = b.yaw + offset;
            let surfaceAt = bounded(b, b.pos + forward(headingTry) * (if b.phase2 { 23 } else { 19 }) * dt);
            let surfaceFloor = groundTop(lvl, surfaceAt.x, surfaceAt.z, 0.7, b.pos.y + 0.7);
            if flatDist(surfaceAt, b.pos) > dt && surfaceFloor > b.pos.y - 5 && !walled(lvl, surfaceAt.x, surfaceAt.z, 1.1, b.pos.y - 1.8, 1.3, 3) {
                b.pos = Vec3.xyz(surfaceAt.x, surfaceFloor + 1.8, surfaceAt.z);
                b.yaw = headingTry;
                moved = true;
            }
            attempt += 1;
        }
        if moved { b.cd2 = 0; } else { b.cd2 += dt; }
        if b.cd2 > 0.4 { b.t = b.len; }
        b.cd -= dt;
        b.open = 1;
        b.cue = true;
        if b.cd <= 0 {
            volley(bs, p, lvl);
            b.step += 1;
            b.cd = if b.step % 3 == 0 { 1.25 } else { if b.phase2 { 0.6 } else { 0.75 } };
        }
        if b.t >= b.len { b.from = b.pos; to(b, DIVE, 0.5); }
    } else if b.state == DIVE {
        let diveK = clamp(b.t / b.len, 0, 1);
        b.pos = bounded(b, b.from + forward(b.yaw) * diveK * 7 - Vec3.xyz(0, diveK * 6, 0));
        if diveK >= 1 { b.cycle += 1; to(b, BURIED, 0.8); }
    }
    if b.state == BURIED && flatDist(was, b.pos) < dt {
        b.yaw = yawTo(b.pos, Vec3.xyz(f32(b.tile % 3 - 1) * level.TILE, 0, f32(b.tile / 3 - 1) * level.TILE));
    }
    b.vel = (b.pos - was) * (1 / max(dt, 0.001));
    follow(bs, dt);
    pose(bs);
    bs.glowAt = b.pos;
    bs.glowColor = amber() * 0.12;
    bs.glowR = if visible(b) && b.pos.y > b.home.y { 5 } else { 0 };
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    if !visible(b) { return; }
    let sand = Vec3.xyz(0.66, 0.4, 0.2);
    let light = Vec3.xyz(0.84, 0.61, 0.32);
    let i = 0;
    while i < SEGMENTS {
        let at = segment(bs, i);
        let r = max(0.55, 1.5 - f32(i) * 0.11);
        let t = bodyFrame(bs, i);
        box(bs, t, Vec3.zero(), Vec3.xyz(r * 2, r * 1.6, 1.35), if i % 2 == 0 { sand } else { light }, Vec3.zero());
        box(bs, t, Vec3.xyz(0, r, 0), Vec3.xyz(r * 0.7, 0.65, 0.8), light, Vec3.zero());
        if i > 0 {
            let joint = (at + segment(bs, i - 1)) * 0.5;
            bit(bs, frame(joint, b.yaw), Vec3.xyz(0, 0.55, 0), Vec3.xyz(r * 1.4, 0.85, 0.45), Vec3.xyz(0.95, 0.65, 0.2), amber() * (if b.open > 0 { 1.5 } else { 0.12 }));
        }
        i += 1;
    }
    let head = bodyFrame(bs, 0);
    box(bs, head, Vec3.xyz(0, -0.2, -0.9), Vec3.xyz(2.5, 0.8, 1.0), sand, Vec3.zero());
    bit(bs, head, Vec3.xyz(0, 0.25, -0.73), Vec3.xyz(2.2, 0.6, 0.1), Vec3.xyz(0.08, 0.04, 0.02), Vec3.zero());
    let side: f32 = -1;
    while side < 2 {
        bit(bs, head, Vec3.xyz(side * 0.9, 0.75, -0.7), Vec3.xyz(0.45, 0.22, 0.2), Vec3.zero(), amber());
        box(bs, head, Vec3.xyz(side * 1.05, 0.15, -1.2), Vec3.xyz(0.3, 1.1, 0.3), Vec3.xyz(0.95, 0.85, 0.6), Vec3.zero());
        side += 2;
    }
}
