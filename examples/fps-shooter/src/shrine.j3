// Secret shrines. Every third level one appears on a hidden spot (empty `ShrineSpot...` objects
// in the scene) and stays until it's broken. Breaking one lets out ten gold enemies; kill them
// all for a shrine gift, which you can take or reject for good.

module fps_shooter.shrine;

use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx;
use j3.gfx.{ Mesh, Ray };
use j3.math.{ Mat4, Vec2, Vec3, TAU, abs, clamp, cos, max, min, sin };
use j3.memory.Arena;
use j3.sys.panic;
use fps_shooter.player;
use j3.rand.Rng;
use j3.scene3d;
use j3.scene3d.{ Scene, GROUP };
use j3.text;
use fps_shooter.challenge;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.level;
use fps_shooter.sfx;
use fps_shooter.level.Level;
use fps_shooter.biome;
use fps_shooter.player.{ Player, has, GIFTS, JETPACK, BOW, RPG, SHOTGUN, WAND };

const MAX_SPOTS: int = 128;
const SECRET_SLOTS: int = 4;
/// Four secret shrines plus a reserved slot for every biome (Hub slot unused).
pub const MAX_SHRINES: int = 14;
/// Border locks (see gates.j3) ride in the list after the shrines, slot MAX_SHRINES + border,
/// so everything that hits a shrine hits them too. 14 shrine slots + 12 borders + the horizontal volcano seal.
const SLOTS: int = 27;
const EVERY: int = 3;
const HP: f32 = 300;
const GOLDS: int = 10;
/// Half width and height of what bullets hit.
const HALF: f32 = 0.8;
const TALL: f32 = 2.6;
const ARM: f32 = 0.45;
const CARD_W: f32 = 380;
const CARD_H: f32 = 300;

pub struct Shrine {
    pos: Vec3;
    hp: f32;
    flash: f32;
    live: bool;
    /// Placed when a biome unlocks: breaking it deals an epic hand, not gold enemies.
    area: bool = false;
}

pub struct Shrines {
    spots: []Vec3;
    nspots: int;
    list: []Shrine;
    /// The level a shrine last came up on.
    lastLevel: int;
    /// A gold batch is out.
    batch: bool;
    /// The take-or-reject card is up, for `gift`.
    offering: bool;
    gift: int;
    t: f32;
    /// Gifts rejected this session: never offered again.
    banned: int;
    /// Every gift is owned or banned: deal a normal card instead. The caller clears it.
    bonus: bool;
    /// An area shrine broke: deal a free epic hand. The caller clears it.
    epic: bool = false;
    /// Area shrines destroyed this frame, drained one reward at a time.
    areaPending: int = 0;
    /// Biome named on the banner, or -1 for a secret shrine.
    bannerTile: int = -1;
    bannerT: f32;
    /// The border whose lock was just broken, or -1. gates.j3 clears it.
    broke: int;
    cube: Mesh;
    rng: Rng;
}

/// Clock seed, shifted so it doesn't match the level-up generator read in the same instant.
fn clockSeed(): int {
    let t = game.micros() * 2 + game.ticks() * 1000003 + 1;
    if t < 0 { t = 0 - t; }
    if t == 0 { t = 1; }
    return t;
}

/// A new shrine sequence: where they appear, and which gift they offer.
pub fn reseed(sh: &Shrines) {
    sh.rng = Rng.new(clockSeed());
}

pub fn create(mem: &Arena): Shrines {
    return Shrines {
        spots: mem.alloc::<Vec3>(MAX_SPOTS), nspots: 0, list: mem.alloc::<Shrine>(SLOTS), lastLevel: 0, broke: -1,
        batch: false, offering: false, gift: 0, t: 0, banned: 0, bonus: false, bannerT: 0,
        cube: Mesh { vao: 0, vbo: 0, count: 0 }, rng: Rng.new(4242),
    };
}

/// Spots from the scene's `ShrineSpot...` groups, and the cube mesh. After `level.build`.
pub fn load(sh: &Shrines, scene: &Scene, lvl: &Level, mem: &Arena) {
    sh.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
    sh.nspots = 0;
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if n.kind == GROUP && text.find(n.name, "ShrineSpot") == 0 && sh.nspots < MAX_SPOTS {
            sh.spots[sh.nspots] = lvl.mats[i].transformPoint(Vec3.zero());
            sh.nspots += 1;
        }
        i += 1;
    }
}

/// Bit `k` of the gifts (0 is AIR_DMG).
/// The gift in pool slot `k`: bits 0..9, then the magnet (the bits between are starting weapons).
fn giftAt(k: int): int {
    if k >= 10 { return player.MAGNET; }
    return bit(k);
}

fn bit(k: int): int {
    let b = 1;
    let i = 0;
    while i < k {
        b = b * 2;
        i += 1;
    }
    return b;
}

fn banned(sh: &Shrines, gift: int): bool {
    return (sh.banned / gift) % 2 == 1;
}

/// Whether a new shrine could go on spot `k`: its biome is unlocked and no live shrine is on it.
fn usable(sh: &Shrines, lvl: &Level, k: int): bool {
    let at = sh.spots[k];
    if !level.openAt(lvl, at.x, at.z) { return false; }
    let i = 0;
    while i < MAX_SHRINES {
        if sh.list[i].live && (sh.list[i].pos - at).length() < 1 { return false; }
        i += 1;
    }
    return true;
}

fn appear(sh: &Shrines, lvl: &Level) {
    let slot = 0;
    while slot < SECRET_SLOTS && sh.list[slot].live { slot += 1; }
    if slot == SECRET_SLOTS { return; }
    let n = 0;
    let k = 0;
    while k < sh.nspots {
        if usable(sh, lvl, k) { n += 1; }
        k += 1;
    }
    if n == 0 { return; }
    let pick = sh.rng.intRange(0, n);
    k = 0;
    while k < sh.nspots {
        if usable(sh, lvl, k) {
            if pick == 0 {
                sh.list[slot] = Shrine { pos: sh.spots[k], hp: HP, flash: 0, live: true };
                sh.bannerT = 3;
                sh.bannerTile = -1;
                return;
            }
            pick -= 1;
        }
        k += 1;
    }
}

/// Ten gold ground enemies burst out of a broken shrine.
fn release(sh: &Shrines, e: &Enemies, at: Vec3) {
    let i = 0;
    while i < GOLDS {
        let a = f32(i) / f32(GOLDS) * TAU;
        let out = 5 + sh.rng.unit() * 5;
        let vel = Vec3.xyz(cos(a) * out, 8 + sh.rng.unit() * 5, sin(a) * out);
        enemies.spawnAt(e, enemies.groundKind(e), at + Vec3.xyz(cos(a) * 0.6, 1.6, sin(a) * 0.6), vel, true);
        i += 1;
    }
    enemies.sparks(e, at + Vec3.xyz(0, 1.5, 0), Vec3.xyz(1, 0.8, 0.2), 40, 12);
    sh.batch = true;
}

/// A gift a shrine may deal: melee only runs never get a gun.
fn dealt(sh: &Shrines, p: &Player, gift: int): bool {
    if has(p, gift) || banned(sh, gift) { return false; }
    let gun = gift == RPG || gift == BOW || gift == WAND || gift == SHOTGUN;
    return !(gun && challenge.on(challenge.MELEE));
}

/// Roll a gift that isn't owned or banned; none left means a normal card. Boss rush deals it too.
pub fn reward(sh: &Shrines, p: &Player) {
    let n = 0;
    let k = 0;
    while k < GIFTS {
        if dealt(sh, p, giftAt(k)) { n += 1; }
        k += 1;
    }
    if n == 0 {
        sh.bonus = true;
        return;
    }
    let pick = sh.rng.intRange(0, n);
    k = 0;
    while k < GIFTS {
        if dealt(sh, p, giftAt(k)) {
            if pick == 0 { sh.gift = giftAt(k); }
            pick -= 1;
        }
        k += 1;
    }
    sh.offering = true;
    sh.t = 0;
}

/// Every unlocked biome has a dedicated slot, independent of secret shrines.
pub fn placeArea(sh: &Shrines, tile: int) {
    if tile < 0 || tile > 9 || tile == 4 { return; }
    let slot = SECRET_SLOTS + tile;
    if tile == level.HOLLOWS {
        sh.list[slot] = Shrine { pos: Vec3.xyz(168, -60, -141), hp: HP, flash: 0, live: true, area: true };
        sh.bannerT = 4; sh.bannerTile = tile; return;
    }
    let k = 0;
    while k < sh.nspots {
        let at = sh.spots[k];
        if level.tileAt(at.x, at.z) == tile {
            sh.list[slot] = Shrine { pos: at, hp: HP, flash: 0, live: true, area: true };
            sh.bannerT = 4;
            sh.bannerTile = tile;
            return;
        }
        k += 1;
    }
}

pub fn update(sh: &Shrines, p: &Player, e: &Enemies, lvl: &Level, lv: int, dt: f32): bool {
    sh.bannerT = sh.bannerT - dt;
    let i = 0;
    while i < SLOTS {
        sh.list[i].flash = sh.list[i].flash - dt;
        i += 1;
    }
    // Going down loses the batch (the enemies get wiped); the shrines stay.
    if p.hp <= 0 {
        sh.batch = false;
        sh.epic = false;
        sh.lastLevel = 0;
        return false;
    }
    sh.epic = sh.areaPending != 0;
    if sh.epic { return true; }
    if lv % EVERY == 0 && lv != sh.lastLevel && !challenge.on(challenge.RUSH) {
        sh.lastLevel = lv;
        appear(sh, lvl);
    }
    if sh.batch && enemies.golds(e) == 0 {
        sh.batch = false;
        reward(sh, p);
        return true;
    }
    return false;
}

/// How far along `r` it hits the shrine's box, or -1.
fn boxHit(s: Shrine, r: Ray): f32 {
    let lo = s.pos - Vec3.xyz(HALF, 0, HALF);
    let hi = s.pos + Vec3.xyz(HALF, TALL, HALF);
    let t0: f32 = 0;
    let t1: f32 = 1000000;
    let ax = 0;
    while ax < 3 {
        let o = r.origin.x;
        let d = r.dir.x;
        let a = lo.x;
        let b = hi.x;
        if ax == 1 {
            o = r.origin.y;
            d = r.dir.y;
            a = lo.y;
            b = hi.y;
        }
        if ax == 2 {
            o = r.origin.z;
            d = r.dir.z;
            a = lo.z;
            b = hi.z;
        }
        if abs(d) < 0.000001 {
            if o < a || o > b { return -1; }
        } else {
            let ta = (a - o) / d;
            let tb = (b - o) / d;
            t0 = max(t0, min(ta, tb));
            t1 = min(t1, max(ta, tb));
        }
        ax += 1;
    }
    if t1 < t0 { return -1; }
    return t0;
}

/// A shrine a ray hit (or -1), and how far along.
pub struct Hit {
    index: int;
    t: f32;
}

/// The first live shrine along `r` within `reach`.
pub fn ray(sh: &Shrines, r: Ray, reach: f32): Hit {
    let best = Hit { index: -1, t: reach };
    let i = 0;
    while i < SLOTS {
        if sh.list[i].live {
            let t = boxHit(sh.list[i], r);
            if t >= 0 && t < best.t {
                best.index = i;
                best.t = t;
            }
        }
        i += 1;
    }
    return best;
}

pub fn damage(sh: &Shrines, e: &Enemies, index: int, dmg: f32, at: Vec3) {
    let s = &sh.list[index];
    if !s.live { return; }
    s.hp = s.hp - dmg;
    s.flash = 0.08;
    enemies.sparks(e, at, Vec3.xyz(1, 0.85, 0.3), 4, 5);
    if s.hp <= 0 {
        s.live = false;
        sfx.at(sfx.UNLOCK, s.pos);
        if index >= MAX_SHRINES {
            sh.broke = index - MAX_SHRINES;
            enemies.sparks(e, s.pos + Vec3.xyz(0, 1.5, 0), Vec3.xyz(1, 0.8, 0.2), 40, 12);
        } else if s.area {
            enemies.sparks(e, s.pos + Vec3.xyz(0, 1.5, 0), Vec3.xyz(0.7, 0.4, 1), 40, 12);
            sh.epic = true;
            let tileBit = level.bit(index - SECRET_SLOTS);
            if (sh.areaPending / tileBit) % 2 == 0 { sh.areaPending += tileBit; }
        } else {
            release(sh, e, s.pos);
        }
    }
}

/// An explosion at `at`: shrines within `radius` take `dmg`, less toward the edge.
pub fn blast(sh: &Shrines, e: &Enemies, at: Vec3, radius: f32, dmg: f32) {
    let i = 0;
    while i < SLOTS {
        if sh.list[i].live {
            let far = (sh.list[i].pos + Vec3.xyz(0, 1.2, 0) - at).length();
            if far < radius { damage(sh, e, i, dmg * (1 - far / radius * 0.6), at); }
        }
        i += 1;
    }
}

/// Anything live within `reach` of `at` in front of `dir` (a knife swing): its index, or -1.
pub fn near(sh: &Shrines, at: Vec3, dir: Vec3, reach: f32): int {
    let i = 0;
    while i < SLOTS {
        if sh.list[i].live {
            let to = sh.list[i].pos + Vec3.xyz(0, 1.2, 0) - at;
            if to.length() < reach + HALF && to.normalize().dot(dir) > 0.5 { return i; }
        }
        i += 1;
    }
    return -1;
}

fn cube(sh: &Shrines, m: Mat4, tint: Vec3, glow: Vec3) {
    gfx.material(tint, glow);
    gfx.draw(sh.cube, m);
}

/// A stone plinth with a spinning gold gem over it. Fine in the shadow pass too.
pub fn draw(sh: &Shrines) {
    let time = f32(game.ticks()) * 0.001;
    let i = 0;
    while i < MAX_SHRINES {
        let s = sh.list[i];
        if s.live {
            let p = s.pos;
            let stone = Vec3.xyz(0.9, 0.84, 0.72);
            let gold = Vec3.xyz(1, 0.8, 0.25);
            let glow = Vec3.xyz(1.6, 1.1, 0.25) * (0.7 + 0.3 * sin(time * 3));
            if s.area {
                gold = Vec3.xyz(0.72, 0.4, 1);
                glow = Vec3.xyz(1.4, 0.5, 2.4) * (0.7 + 0.3 * sin(time * 3));
            }
            if s.flash > 0 {
                stone = Vec3.xyz(1, 1, 1);
                glow = Vec3.xyz(3, 3, 3);
            }
            cube(sh, Mat4.translate(p.x, p.y + 0.3, p.z).mul(Mat4.scale(1.6, 0.6, 1.6)), stone, Vec3.zero());
            cube(sh, Mat4.translate(p.x, p.y + 0.9, p.z).mul(Mat4.scale(1.1, 0.6, 1.1)), stone, Vec3.zero());
            cube(sh, Mat4.translate(p.x, p.y + 1.25, p.z).mul(Mat4.scale(1.3, 0.12, 1.3)), gold, glow * 0.3);
            // The gem: spins and bobs, smaller as it takes damage.
            let size = 0.35 + 0.35 * clamp(s.hp / HP, 0, 1);
            let gem = Mat4.translate(p.x, p.y + 2 + sin(time * 2) * 0.12, p.z)
                .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), time * 1.5))
                .mul(Mat4.rotate(Vec3.xyz(1, 0, 1).normalize(), 0.6155))
                .mul(Mat4.scale(size, size, size));
            cube(sh, gem, gold, glow);
        }
        i += 1;
    }
}

pub fn giftName(g: int): string {
    if g == 1 { return "SKY STRIKE"; }
    if g == 2 { return "BATTLE DRONE"; }
    if g == 4 { return "JETPACK"; }
    if g == 8 { return "RPG"; }
    if g == 16 { return "BOW"; }
    if g == 32 { return "KNIFE"; }
    if g == 64 { return "TURRET"; }
    if g == 128 { return "WAND"; }
    if g == 512 { return "SHOTGUN"; }
    if g == player.MAGNET { return "MAGNET"; }
    return "SKATEBOARD";
}

fn giftLine1(g: int): string {
    if g == 1 { return "+30% damage"; }
    if g == 2 { return "A drone follows and shoots"; }
    if g == 4 { return "Replaces double jump."; }
    if g == 8 { return "Explosive rockets. Blast the"; }
    if g == 16 { return "Hold LMB to draw; release to fire."; }
    if g == 32 { return "New weapon. Melee slashes."; }
    if g == 64 { return "Press G to place a turret"; }
    if g == 128 { return "New weapon. Fires bolts"; }
    if g == 512 { return "New weapon. Ten pellets; blast"; }
    if g == player.MAGNET { return "Double pickup range. Half of all"; }
    return "New weapon. Ride it fast;";
}

fn giftLine2(g: int): string {
    if g == 1 { return "while you're in the air"; }
    if g == 2 { return "and darts at nearby enemies"; }
    if g == 4 { return "Hold SPACE to fly, glide when dry"; }
    if g == 8 { return "ground under you to rocket jump"; }
    if g == 16 { return "Full draw: faster, stronger arrows."; }
    if g == 32 { return "+15% speed, -20% damage taken"; }
    if g == 64 { return "that shoots nearby enemies"; }
    if g == 128 { return "that home in on enemies"; }
    if g == 512 { return "the floor to jump"; }
    if g == player.MAGNET { return "XP drops fly to you from anywhere."; }
    return "click to ollie. No damage.";
}

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

fn centered(font: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(font, msg);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

fn over(m: Vec2, x: f32, y: f32, w: f32, h: f32): bool {
    return m.x >= x && m.x < x + w && m.y >= y && m.y < y + h;
}

/// Where the two buttons sit on the card.
fn buttonAt(i: int, sz: Vec2): Vec2 {
    let x = (sz.x - CARD_W) * 0.5 + 24 + f32(i) * (CARD_W * 0.5 - 12);
    return Vec2 { x: x, y: (sz.y - CARD_H) * 0.5 + CARD_H - 70 };
}

/// While offering: 1 or click TAKE, 2 or click REJECT. True on the frame it closes.
pub fn choose(sh: &Shrines, p: &Player, dt: f32): bool {
    sh.t = sh.t + dt;
    if sh.t < ARM { return false; }
    let sz = game.windowSize();
    let bw = CARD_W * 0.5 - 36;
    let m = game.mousePos();
    let click = game.mousePressed(Mouse.Left);
    let b0 = buttonAt(0, sz);
    let b1 = buttonAt(1, sz);
    let yes = game.keyPressed(Key.Num1) || (click && over(m, b0.x, b0.y, bw, 46));
    let no = game.keyPressed(Key.Num2) || (click && over(m, b1.x, b1.y, bw, 46));
    if yes {
        p.stats.gifts += sh.gift;
        if sh.gift == JETPACK { p.fuel = 1; }
    } else if no {
        sh.banned += sh.gift;
    } else {
        return false;
    }
    sh.offering = false;
    return true;
}

/// The "something stirs" banner, and the gift card while offering.
pub fn hud(sh: &Shrines, font: Font, big: Font) {
    let sz = game.windowSize();
    if sh.bannerT > 0 && !sh.offering {
        let a = u8(clamp(sh.bannerT, 0, 1) * 220);
        if sh.bannerTile >= 0 {
            game.setColor(game.rgba(190, 140, 255, a));
            centered(font, sz.x * 0.5, sz.y * 0.3, `a shrine appeared in {biome.name(sh.bannerTile)}`);
        } else {
            game.setColor(game.rgba(255, 215, 90, a));
            centered(font, sz.x * 0.5, sz.y * 0.3, "a shrine has appeared somewhere...");
        }
    }
    if !sh.offering { return; }
    game.setColor(game.rgba(10, 12, 24, 170));
    rect(0, 0, sz.x, sz.y);
    let k = clamp(sh.t / 0.25, 0, 1);
    let ease = 1 - (1 - k) * (1 - k);
    let x = (sz.x - CARD_W) * 0.5;
    let y = (sz.y - CARD_H) * 0.5 + (1 - ease) * 60;
    let alpha = u8(255 * ease);
    let cx = sz.x * 0.5;
    game.setColor(game.rgb(255, 220, 90));
    centered(big, cx, y - 70, "SHRINE GIFT");
    let pulse = 0.5 + 0.5 * sin(sh.t * 4);
    game.setColor(game.rgba(255, 190, 50, u8((50 + 60 * pulse) * ease)));
    rect(x - 10, y - 10, CARD_W + 20, CARD_H + 20);
    game.setColor(game.rgba(255, 200, 60, alpha));
    rect(x - 3, y - 3, CARD_W + 6, CARD_H + 6);
    game.setColor(game.rgba(26, 24, 40, alpha));
    rect(x, y, CARD_W, CARD_H);
    game.setColor(game.rgba(255, 215, 90, alpha));
    centered(big, cx, y + 40, giftName(sh.gift));
    game.setColor(game.rgba(225, 225, 240, alpha));
    centered(font, cx, y + 118, giftLine1(sh.gift));
    centered(font, cx, y + 142, giftLine2(sh.gift));
    let bw = CARD_W * 0.5 - 36;
    let m = game.mousePos();
    let i = 0;
    while i < 2 {
        let b = buttonAt(i, sz);
        b.y = b.y - (1 - ease) * 60;
        let hot = over(m, b.x, b.y, bw, 46);
        if i == 0 {
            if hot { game.setColor(game.rgba(120, 240, 110, alpha)); } else { game.setColor(game.rgba(80, 190, 80, alpha)); }
        } else {
            if hot { game.setColor(game.rgba(255, 100, 90, alpha)); } else { game.setColor(game.rgba(190, 70, 70, alpha)); }
        }
        rect(b.x, b.y, bw, 46);
        game.setColor(game.rgba(20, 20, 30, alpha));
        if i == 0 { centered(font, b.x + bw * 0.5, b.y + 14, "[1] TAKE"); } else { centered(font, b.x + bw * 0.5, b.y + 14, "[2] REJECT"); }
        i += 1;
    }
    game.setColor(game.rgba(150, 155, 180, alpha));
    centered(font, cx, y + CARD_H + 16, "rejected gifts never come back");
}

/// Consume one area reward without losing simultaneous shrine breaks.
pub fn takeArea(sh: &Shrines): int {
    let tile = 0;
    while tile < 10 {
        let mask = level.bit(tile);
        if (sh.areaPending / mask) % 2 == 1 {
            sh.areaPending -= mask;
            sh.epic = sh.areaPending != 0;
            return tile;
        }
        tile += 1;
    }
    sh.epic = false;
    return -1;
}

/// Death starts a fresh progression run, including its area shrines and locks.
pub fn reset(sh: &Shrines) {
    let i = 0;
    while i < SLOTS { sh.list[i].live = false; i += 1; }
    sh.areaPending = 0;
    sh.epic = false;
    sh.batch = false;
    sh.offering = false;
    sh.bonus = false;
    sh.broke = -1;
    sh.lastLevel = 0;
    sh.bannerT = 0;
    reseed(sh);
}

/// Every biome must retain a shrine spot and a slot even when all secret slots are occupied.
pub fn selfCheck(mem: &Arena, loaded: &Shrines, lvl: &Level) {
    let sh = create(mem);
    sh.spots = loaded.spots;
    sh.nspots = loaded.nspots;
    let e = enemies.create(mem);
    let p = player.create(lvl);
    let i = 0;
    while i < SECRET_SLOTS { sh.list[i].live = true; i += 1; }
    let tile = 0;
    while tile < 10 {
        if tile != 4 {
            placeArea(&sh, tile);
            let s = sh.list[SECRET_SLOTS + tile];
            if !s.live || !s.area || (if level.inHollows(s.pos) { level.HOLLOWS } else { level.tileAt(s.pos.x, s.pos.z) }) != tile {
                panic(`shrine check: missing area shrine in biome {tile}`);
            }
            damage(&sh, &e, SECRET_SLOTS + tile, HP + 1, s.pos);
            damage(&sh, &e, SECRET_SLOTS + tile, HP + 1, s.pos);
        }
        tile += 1;
    }
    // All nine destroyed before a single update: nine distinct epic reward events.
    let count = 0;
    while update(&sh, &p, &e, lvl, 1, 0.016) {
        if !sh.epic { panic("shrine check: lost epic reward"); }
        let area = takeArea(&sh);
        if area == 4 || area < 0 { panic("shrine check: wrong area event"); }
        count += 1;
        if count > 9 { panic("shrine check: duplicate event"); }
    }
    if count != 9 { panic("shrine check: dropped simultaneous rewards"); }
    reset(&sh);
    if sh.areaPending != 0 || sh.epic || sh.list[0].live { panic("shrine check: reset"); }
}
