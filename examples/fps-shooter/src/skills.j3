// Skills: one active on Q, won from bosses. Boss rewards come in a fixed order (`rewardOf`):
// Slingshot, Shuriken, Detonate, a legendary level up, Missile Pack, a legendary level up, Storm,
// a legendary level up, Orbital Strike. A skill is a card to take or refuse; refusing skips it for
// good. Taking replaces the skill held and starts it ready. Going down loses the skill and starts
// the order over.
//
// tools/debug.j3s `skill` (or J3_FPS_SKILL) starts holding that skill. `skill_auto` 1 uses it
// whenever it's ready (not Orbital Strike, which needs aiming).

module fps_shooter.skills;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}
use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx;
use j3.gfx.{ Instance, Mesh, Ray };
use j3.math.{ Mat4, Vec2, Vec3, TAU, abs, clamp, cos, max, min, sin, sqrt };
use j3.memory.Arena;
use j3.rand.Rng;
use j3.sys.panic;
use j3.text.cstr;
use j3.scene3d;
use fps_shooter.boss;
use fps_shooter.debug;
use fps_shooter.bosskit;
use fps_shooter.bosskit.Bosses;
use fps_shooter.enemies;
use fps_shooter.enemies.{ Enemies, MAX_ENEMIES };
use fps_shooter.guns.Guns;
use fps_shooter.level;
use fps_shooter.level.{ Box, Level, solid, SOLID };
use fps_shooter.player;
use fps_shooter.player.{ Player, fits, look };
use fps_shooter.sfx;
use fps_shooter.shrine;
use fps_shooter.shrine.Shrines;

pub const SLINGSHOT: int = 1;
pub const SHURIKEN: int = 2;
pub const DETONATE: int = 3;
pub const MISSILES: int = 4;
pub const STORM: int = 5;
pub const ORBITAL: int = 6;

/// Slingshot: launch speed along the view (the air speed cap is 30).
const SLING_SPEED: f32 = 42;
/// Shuriken: flight speed, reach for aim assist and the cone (cosine) it locks within, hit
/// damage (a sniper round), hits before it's spent, and how far it looks for the next foe.
const STAR_SPEED: f32 = 48;
const STAR_RANGE: f32 = 70;
const STAR_CONE: f32 = 0.94;
const STAR_DMG: f32 = 120;
const STAR_HITS: int = 3;
const STAR_HOP: f32 = 30;
/// Orbital Strike: aim time before it cancels, delay from the second press to the beam, blast
/// radius, damage, and how far the view is traced for ground.
const ORBIT_AIM: f32 = 5;
const ORBIT_DELAY: f32 = 1;
const ORBIT_R: f32 = 10.8;
/// The beam stays and burns for this long, ticking every ORBIT_TICK.
const ORBIT_BURN: f32 = 2;
const ORBIT_TICK: f32 = 0.25;
const ORBIT_DMG: f32 = 700;
const ORBIT_REACH: f32 = 150;
const MISSILE_EVERY: f32 = 0.16;
const MISSILE_SPEED: f32 = 28;
const MISSILE_TURN: f32 = 9;
const MISSILE_RANGE: f32 = 45;
const MISSILE_DMG: f32 = 60;
const MISSILE_BLAST: f32 = 2.8;
const MAX_MISSILES: int = 48;
const DETONATE_R: f32 = 16;
const DETONATE_DMG: f32 = 220;
const DETONATE_LIFT: f32 = 26;
const STORM_EVERY: f32 = 0.225;
const STORM_RANGE: f32 = 22;
const STORM_DMG: f32 = 55;
const STORM_UP: f32 = 9;
/// Each strike explodes: this blast radius, so packed enemies go together.
const STORM_BLAST: f32 = 4.5;
const MAX_BOLTS: int = 8;
const BOLT_LIFE: f32 = 0.16;
const TRAIL: int = 12;
const CARD_W: f32 = 400;
const CARD_H: f32 = 320;
/// Clicks are ignored this long after the card comes up.
const ARM: f32 = 0.45;

struct Missile {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    /// An enemy index, -2 for the boss, -1 for nothing yet; and time until it looks again.
    target: int;
    seekT: f32;
}

/// The shuriken in flight. `target`: an enemy index, -2 the boss, -1 none (flies straight).
struct Star {
    pos: Vec3;
    dir: Vec3;
    t: f32;
    target: int;
    /// What it hit last (not hit again at once), and how many hits so far.
    last: int;
    hits: int;
}

/// A lightning bolt from the cloud, drawn for a moment.
struct Bolt {
    from: Vec3;
    to: Vec3;
    t: f32;
    seed: f32;
}

pub struct Skills {
    /// The skill held (0 for none) and the one the next boss offers.
    skill: int = 0;
    next: int = 0;
    /// Cooldown left, and time left on a skill that lasts.
    cd: f32 = 0;
    active: f32 = 0;
    /// Hud flashes: ready again, just used, refused (nothing happened).
    readyT: f32 = 0;
    usedT: f32 = 0;
    denyT: f32 = 0;
    offering: bool = false;
    t: f32 = 0;
    missiles: []Missile;
    nextMissile: int = 0;
    fireT: f32 = 0;
    side: f32 = 1;
    cloud: Vec3;
    strikeT: f32 = 0;
    strikes: int = 0;
    bolts: []Bolt;
    nextBolt: int = 0;
    flashAt: Vec3;
    flashT: f32 = 0;
    /// Blink afterimages along the path, fading.
    trail: []Vec3;
    trailT: f32 = 0;
    /// Detonate's shock: where, and how long ago.
    boomAt: Vec3;
    boomT: f32 = 10;
    star: Star;
    /// Orbital Strike: aim time left, where the view meets ground (if it does), seconds until the
    /// beam lands, where it will, and the beam's afterglow.
    aim: f32 = 0;
    mark: Vec3;
    markOk: bool = false;
    fall: f32 = 0;
    /// Orbital Strike burning: seconds left, and until the next damage tick.
    burnT: f32 = 0;
    tickT: f32 = 0;
    strikeAt: Vec3;
    glowT: f32 = 0;
    parts: []Instance;
    nparts: int = 0;
    cube: Mesh;
    rng: Rng;
    /// J3_FPS_SKILL_AUTO: use it whenever it's ready.
    auto: bool = false;
}

pub fn create(mem: &Arena): Skills {
    return Skills {
        missiles: mem.alloc::<Missile>(MAX_MISSILES), cloud: Vec3.zero(), bolts: mem.alloc::<Bolt>(MAX_BOLTS),
        flashAt: Vec3.zero(), trail: mem.alloc::<Vec3>(TRAIL), boomAt: Vec3.zero(),
        star: Star { pos: Vec3.zero(), dir: Vec3.zero(), t: 0, target: -1, last: -1, hits: 0 },
        mark: Vec3.zero(), strikeAt: Vec3.zero(),
        parts: mem.alloc::<Instance>(1024), cube: Mesh { vao: 0, vbo: 0, count: 0 }, rng: Rng.new(606),
    };
}

pub fn upload(s: &Skills, mem: &Arena) {
    s.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

pub fn name(k: int): string {
    if k == SLINGSHOT { return "SLINGSHOT"; }
    if k == SHURIKEN { return "SHURIKEN"; }
    if k == MISSILES { return "MISSILE PACK"; }
    if k == DETONATE { return "DETONATE"; }
    if k == ORBITAL { return "ORBITAL STRIKE"; }
    return "STORM";
}

fn line1(k: int): string {
    if k == SLINGSHOT { return "Launch yourself where you look."; }
    if k == SHURIKEN { return "Throw a locking shuriken: a sniper"; }
    if k == MISSILES { return "For 5 seconds, seeking missiles"; }
    if k == DETONATE { return "Explode where you stand: huge"; }
    if k == ORBITAL { return "Q to aim, Q again to call it in."; }
    return "For 15 seconds, a thunder cloud";
}

fn line2(k: int): string {
    if k == SLINGSHOT { return "You keep the momentum."; }
    if k == SHURIKEN { return "hit that bounces on to 2 more foes."; }
    if k == MISSILES { return "stream off your back."; }
    if k == DETONATE { return "damage, and it throws you up."; }
    if k == ORBITAL { return "A beam lands 1 s later and burns 2 s."; }
    return "follows you, striking enemies.";
}

pub fn cooldown(k: int): f32 {
    if k == SLINGSHOT { return 6; }
    if k == SHURIKEN { return 5; }
    if k == DETONATE { return 20; }
    if k == MISSILES { return 30; }
    return 60;
}

/// How long it lasts once used; 0 for instant ones.
fn lasts(k: int): f32 {
    if k == MISSILES { return 5; }
    if k == STORM { return 15; }
    return 0;
}

fn tint(k: int): Vec3 {
    if k == SLINGSHOT { return Vec3.xyz(0.55, 0.8, 1); }
    if k == SHURIKEN { return Vec3.xyz(0.75, 0.9, 1); }
    if k == MISSILES { return Vec3.xyz(1, 0.55, 0.25); }
    if k == DETONATE { return Vec3.xyz(1, 0.35, 0.2); }
    if k == ORBITAL { return Vec3.xyz(1, 0.3, 0.3); }
    return Vec3.xyz(0.6, 0.85, 1);
}

/// The skill boss number `n` (bosses down, counting it) rewards; 0 is a legendary level up.
fn rewardOf(n: int): int {
    if n == 1 { return SLINGSHOT; }
    if n == 2 { return SHURIKEN; }
    if n == 3 { return DETONATE; }
    if n == 5 { return MISSILES; }
    if n == 7 { return STORM; }
    if n == 9 { return ORBITAL; }
    return 0;
}

/// A fresh run: no skill, and the order starts over.
pub fn reset(s: &Skills, p: &Player) {
    s.skill = 0;
    s.next = 0;
    s.cd = 0;
    s.active = 0;
    s.aim = 0;
    s.fall = 0;
    s.burnT = 0;
    s.star.t = 0;
    s.offering = false;
    let i = 0;
    while i < MAX_MISSILES { s.missiles[i].t = 0; i += 1; }
    p.haste = 1;
}

fn env(key: string): string {
    let raw = libc.getenv(cstr(key));
    if raw == 0 { return ""; }
    return []u8 { ptr: raw as &u8, len: libc.strlen(raw) } as string;
}

fn same(a: string, b: string): bool {
    if a.len != b.len { return false; }
    let i = 0;
    while i < a.len { if a[i] != b[i] { return false; } i += 1; }
    return true;
}

fn named(v: string): int {
    if same(v, "slingshot") || same(v, "1") { return SLINGSHOT; }
    if same(v, "shuriken") || same(v, "2") { return SHURIKEN; }
    if same(v, "detonate") || same(v, "3") { return DETONATE; }
    if same(v, "missiles") || same(v, "4") { return MISSILES; }
    if same(v, "storm") || same(v, "5") { return STORM; }
    if same(v, "orbital") || same(v, "6") { return ORBITAL; }
    return 0;
}

/// Start holding `skill` (or `J3_FPS_SKILL` when that string is empty). `auto` "1" fires it when ready.
pub fn preview(s: &Skills, p: &Player, skill: string, auto: string) {
    let k = named(debug.pick(skill, env("J3_FPS_SKILL")));
    if k == 0 { return; }
    s.next = k;
    take(s, p);
    s.auto = same(debug.pick(auto, env("J3_FPS_SKILL_AUTO")), "1");
}

/// Boss number `n` fell. True when its reward is a skill card (now up); false when it's a
/// legendary level up, which the caller deals.
pub fn offer(s: &Skills, n: int): bool {
    let k = rewardOf(n);
    if k == 0 { return false; }
    s.next = k;
    s.offering = true;
    s.t = 0;
    sfx.play(sfx.LEVEL);
    return true;
}

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

fn centered(font: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(font, msg);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

fn over(m: Vec2, x: f32, y: f32, w: f32, h: f32): bool {
    return m.x >= x && m.x < x + w && m.y >= y && m.y < y + h;
}

fn buttonAt(i: int, sz: Vec2): Vec2 {
    let x = (sz.x - CARD_W) * 0.5 + 24 + f32(i) * (CARD_W * 0.5 - 12);
    return Vec2 { x: x, y: (sz.y - CARD_H) * 0.5 + CARD_H - 70 };
}

/// While offering: 1 or click TAKE, 2 or click REFUSE. True on the frame it closes.
pub fn choose(s: &Skills, p: &Player, dt: f32): bool {
    s.t += dt;
    if s.t < ARM { return false; }
    let sz = game.windowSize();
    let bw = CARD_W * 0.5 - 36;
    let m = game.mousePos();
    let click = game.mousePressed(Mouse.Left);
    let b0 = buttonAt(0, sz);
    let b1 = buttonAt(1, sz);
    let yes = game.keyPressed(Key.Num1) || (click && over(m, b0.x, b0.y, bw, 46));
    let no = game.keyPressed(Key.Num2) || (click && over(m, b1.x, b1.y, bw, 46));
    if !yes && !no { return false; }
    // Refusing skips the skill for good.
    if yes {
        take(s, p);
        sfx.play(sfx.READY);
    }
    s.offering = false;
    return true;
}

/// Take the offered skill, ready to use.
fn take(s: &Skills, p: &Player) {
    s.skill = s.next;
    s.cd = 0;
    s.active = 0;
    s.aim = 0;
    s.fall = 0;
    s.burnT = 0;
    s.readyT = 1;
    p.haste = 1;
}

fn dmgScale(p: &Player): f32 {
    return 1 + p.stats.damage;
}

/// Slingshot: fired along the view, all of it (up and down too); the speed stays.
fn sling(s: &Skills, p: &Player, e: &Enemies) {
    let dir = look(p).forward();
    p.vel = dir * SLING_SPEED;
    p.onGround = false;
    p.slung = 3;
    p.dashT = 0.25;
    sfx.play(sfx.BLINK);
}

/// The foe nearest `at` within `range` other than `skip` (an enemy index, or -2 for the boss):
/// an enemy index, -2 the boss, -1 none.
fn nextFoe(e: &Enemies, bs: &Bosses, at: Vec3, range: f32, skip: int): int {
    let best = -1;
    let bestD = range * range;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 && i != skip {
            let d = e.list[i].pos - at;
            if d.dot(d) < bestD { best = i; bestD = d.dot(d); }
        }
        i += 1;
    }
    if skip != -2 && boss.targetable(bs) {
        let far = boss.aimPoint(bs) - at;
        if far.dot(far) < bestD { best = -2; }
    }
    return best;
}

/// Shuriken: locks the foe nearest the crosshair inside the cone (no lock: flies straight).
fn hurl(s: &Skills, p: &Player, e: &Enemies, bs: &Bosses) {
    let l = look(p);
    let fwd = l.forward();
    let pick = -1;
    let bestDot = STAR_CONE;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 {
            let off = e.list[i].pos - l.eye;
            let far = off.length();
            if far > 1 && far < STAR_RANGE && off.dot(fwd) / far > bestDot { pick = i; bestDot = off.dot(fwd) / far; }
        }
        i += 1;
    }
    if boss.targetable(bs) {
        let offBoss = boss.aimPoint(bs) - l.eye;
        let farBoss = offBoss.length();
        if farBoss > 1 && farBoss < STAR_RANGE && offBoss.dot(fwd) / farBoss > bestDot { pick = -2; }
    }
    s.star = Star { pos: l.eye + fwd * 0.6 - Vec3.xyz(0, 0.2, 0), dir: fwd, t: 3, target: pick, last: -1, hits: 0 };
    sfx.play(sfx.SHOT);
}

/// Fly the shuriken: steer to its target, hit what's in the way, then hop to the nearest other
/// foe or vanish.
fn starFly(s: &Skills, p: &Player, lvl: &Level, e: &Enemies, bs: &Bosses, dt: f32) {
    let st = &s.star;
    if st.t <= 0 { return; }
    st.t -= dt;
    if live(e, bs, st.target) {
        let to = (goalOf(e, bs, st.target) - st.pos).normalize();
        st.dir = (st.dir + (to - st.dir) * min(14 * dt, 1)).normalize();
    } else if st.hits > 0 || st.target != -1 {
        st.t = 0;
        return;
    }
    let step = STAR_SPEED * dt;
    let r = Ray { origin: st.pos, dir: st.dir };
    let foe = enemies.ray(e, r, step);
    let big = boss.ray(bs, r, step);
    if foe.index == st.last { foe.index = -1; }
    if st.last == -2 { big.part = -1; }
    let end = st.pos + st.dir * step;
    let dmg = STAR_DMG * dmgScale(p);
    let struck = -1;
    let at = end;
    if foe.index >= 0 && (big.part < 0 || foe.t < big.t) {
        at = st.pos + st.dir * foe.t;
        enemies.damage(e, foe.index, dmg, st.dir * 6, at);
        struck = foe.index;
    } else if big.part >= 0 {
        at = st.pos + st.dir * big.t;
        boss.damage(bs, e, big.part, dmg, at);
        struck = -2;
    } else if solid(lvl, end, 0.1) >= 0 {
        st.t = 0;
        return;
    }
    if struck != -1 {
        enemies.sparks(e, at, Vec3.xyz(0.75, 0.9, 1), 10, 8);
        sfx.at(sfx.HIT, at);
        st.hits += 1;
        st.last = struck;
        st.target = nextFoe(e, bs, at, STAR_HOP, struck);
        if st.hits >= STAR_HITS || st.target == -1 { st.t = 0; }
    }
    st.pos = end;
}

/// Detonate: a huge blast round the player, who's thrown up by it.
fn detonate(s: &Skills, p: &Player, e: &Enemies, bs: &Bosses, sh: &Shrines, g: &Guns) {
    let at = p.pos + Vec3.xyz(0, 1, 0);
    let dmg = DETONATE_DMG * dmgScale(p);
    enemies.blast(e, at, DETONATE_R, dmg, Vec3.xyz(1, 0.5, 0.2), 18);
    shrine.blast(sh, e, at, DETONATE_R, dmg);
    boss.blast(bs, e, at, DETONATE_R, dmg);
    enemies.sparks(e, at, Vec3.xyz(1, 0.55, 0.15), 48, 18);
    enemies.sparks(e, at, Vec3.xyz(1, 0.9, 0.4), 24, 10);
    p.vel.y = max(p.vel.y, DETONATE_LIFT);
    p.onGround = false;
    g.shake = max(g.shake, 0.08);
    s.boomAt = at;
    s.boomT = 0;
    s.flashAt = at;
    s.flashT = 0.3;
    sfx.play(sfx.BOOM);
}

/// Use the held skill (not Orbital Strike, which `orbital` runs).
fn trigger(s: &Skills, p: &Player, e: &Enemies, bs: &Bosses, sh: &Shrines, g: &Guns) {
    let k = s.skill;
    if k == SLINGSHOT { sling(s, p, e); return; }
    if k == SHURIKEN { hurl(s, p, e, bs); return; }
    if k == DETONATE { detonate(s, p, e, bs, sh, g); }
    if k == STORM { s.cloud = p.pos + Vec3.xyz(0, STORM_UP + 3, 0); s.strikeT = 0.3; s.strikes = 0; }
    s.active = lasts(k);
    sfx.play(sfx.SKILL);
}

/// Where the view meets the ground (or a wall) within reach.
fn aimSpot(s: &Skills, p: &Player, lvl: &Level) {
    let l = look(p);
    let fwd = l.forward();
    s.markOk = false;
    let d: f32 = 1;
    while d < ORBIT_REACH {
        let q = l.eye + fwd * d;
        if solid(lvl, q, 0.05) >= 0 {
            s.mark = l.eye + fwd * (d - 0.5);
            s.markOk = true;
            return;
        }
        d += 0.5;
    }
}

/// Orbital Strike. Q starts aiming (a marker where you look; it cancels after ORBIT_AIM with no
/// cooldown spent). Q again calls it in: ORBIT_DELAY later the beam lands and the cooldown starts.
fn orbital(s: &Skills, p: &Player, lvl: &Level, e: &Enemies, bs: &Bosses, sh: &Shrines, g: &Guns, dt: f32) {
    let press = game.keyPressed(Key.Q);
    s.glowT -= dt;
    if s.aim > 0 {
        s.aim -= dt;
        aimSpot(s, p, lvl);
        if press && s.markOk {
            s.aim = 0;
            s.strikeAt = s.mark;
            s.fall = ORBIT_DELAY;
            s.cd = cooldown(ORBITAL);
            s.usedT = 0.4;
            sfx.play(sfx.SKILL);
        } else if press || s.aim <= 0 {
            // No ground to hit, or the aim timed out: nothing spent.
            s.aim = 0;
            s.denyT = 0.3;
            sfx.play(sfx.DENY);
        }
    } else if press {
        if s.cd <= 0 && s.fall <= 0 {
            s.aim = ORBIT_AIM;
            sfx.play(sfx.READY);
        } else {
            s.denyT = 0.3;
            sfx.play(sfx.DENY);
        }
    }
    if s.fall > 0 {
        s.fall -= dt;
        if s.fall <= 0 {
            s.burnT = ORBIT_BURN;
            s.tickT = 0;
            g.shake = max(g.shake, 0.1);
            s.flashAt = s.strikeAt + Vec3.xyz(0, 3, 0);
            s.flashT = 0.5;
            sfx.at(sfx.BOOM, s.strikeAt);
        }
    }
    if s.burnT > 0 {
        s.burnT -= dt;
        s.glowT = 0.6;
        s.tickT -= dt;
        if s.tickT <= 0 {
            s.tickT = ORBIT_TICK;
            let dmg = ORBIT_DMG * ORBIT_TICK * dmgScale(p);
            enemies.blast(e, s.strikeAt, ORBIT_R, dmg, Vec3.xyz(1, 0.4, 0.3), 22);
            shrine.blast(sh, e, s.strikeAt, ORBIT_R, dmg);
            boss.blast(bs, e, s.strikeAt, ORBIT_R, dmg);
            enemies.sparks(e, s.strikeAt + Vec3.xyz(0, 1, 0), Vec3.xyz(1, 0.45, 0.35), 40, 20);
            enemies.sparks(e, s.strikeAt + Vec3.xyz(0, 1, 0), Vec3.xyz(1, 0.9, 0.8), 20, 10);
        }
    }
}

pub fn update(s: &Skills, p: &Player, lvl: &Level, e: &Enemies, bs: &Bosses, sh: &Shrines, g: &Guns, dt: f32) {
    s.readyT -= dt;
    s.usedT -= dt;
    s.denyT -= dt;
    s.trailT -= dt;
    s.flashT -= dt;
    s.boomT += dt;
    let wasCooling = s.cd > 0;
    s.cd = max(s.cd - dt, 0);
    if wasCooling && s.cd <= 0 && s.skill != 0 {
        s.readyT = 0.6;
        sfx.play(sfx.READY);
    }
    if s.skill == ORBITAL {
        orbital(s, p, lvl, e, bs, sh, g, dt);
    } else if s.skill != 0 && (game.keyPressed(Key.Q) || (s.auto && s.cd <= 0 && s.active <= 0)) {
        if s.cd <= 0 && s.active <= 0 {
            trigger(s, p, e, bs, sh, g);
            s.cd = cooldown(s.skill);
            s.usedT = 0.4;
        } else {
            s.denyT = 0.3;
            sfx.play(sfx.DENY);
        }
    }
    let k = s.skill;
    if s.active > 0 {
        s.active = max(s.active - dt, 0);
        if k == MISSILES { launch(s, p, dt); }
        if k == STORM { storm(s, p, e, bs, dt); }
        if s.active <= 0 && k != 0 { sfx.play(sfx.DASH); }
    }
    p.haste = 1;
    g.hot = 0;
    // The cloud drifts after the player and fades away after.
    if k == STORM {
        let goal = p.pos + Vec3.xyz(0, STORM_UP, 0);
        s.cloud = s.cloud + (goal - s.cloud) * min(dt * 3, 1);
    }
    starFly(s, p, lvl, e, bs, dt);
    fly(s, p, lvl, e, bs, sh, dt);
    let i = 0;
    while i < MAX_BOLTS { s.bolts[i].t -= dt; i += 1; }
}

/// Missile Pack: one off the back every MISSILE_EVERY, alternating shoulders.
fn launch(s: &Skills, p: &Player, dt: f32) {
    s.fireT -= dt;
    if s.fireT > 0 { return; }
    s.fireT = MISSILE_EVERY;
    let l = look(p);
    let fwd = l.forward();
    let right = l.right();
    s.side = 0 - s.side;
    let from = l.eye - fwd * 0.5 + Vec3.xyz(0, 0.3, 0) + right * (s.side * 0.45);
    let up = Vec3.xyz(0, 1, 0) + right * (s.side * 0.6) - fwd * 0.2 + fwd * (s.rng.unit() * 0.4);
    s.missiles[s.nextMissile] = Missile { pos: from, vel: up.normalize() * 14, t: 3, target: -1, seekT: 0.15 };
    s.nextMissile = (s.nextMissile + 1) % MAX_MISSILES;
    if s.nextMissile % 3 == 0 { sfx.play(sfx.ROCKET); }
}

/// The nearest enemy to `at` within reach, or the boss (-2) when it's nearer, or -1.
fn nearestFoe(e: &Enemies, bs: &Bosses, at: Vec3, range: f32): int {
    let t = enemies.nearest(e, at, range);
    if !boss.targetable(bs) { return t; }
    let bossFar = (boss.aimPoint(bs) - at).length();
    if bossFar > range { return t; }
    if t < 0 || bossFar < (e.list[t].pos - at).length() + 6 { return -2; }
    return t;
}

fn goalOf(e: &Enemies, bs: &Bosses, target: int): Vec3 {
    if target == -2 { return boss.aimPoint(bs); }
    return e.list[target].pos;
}

fn live(e: &Enemies, bs: &Bosses, target: int): bool {
    if target == -2 { return boss.targetable(bs); }
    return target >= 0 && e.list[target].kind != 0;
}

/// Missiles climb off the back, then home and burst on what they hit.
fn fly(s: &Skills, p: &Player, lvl: &Level, e: &Enemies, bs: &Bosses, sh: &Shrines, dt: f32) {
    let i = 0;
    while i < MAX_MISSILES {
        let m = &s.missiles[i];
        if m.t > 0 {
            m.t -= dt;
            m.seekT -= dt;
            if m.seekT <= 0 && !live(e, bs, m.target) {
                m.target = nearestFoe(e, bs, m.pos, MISSILE_RANGE);
                m.seekT = 0.2;
            }
            let dir = m.vel.normalize();
            let speed = min(m.vel.length() + dt * 40, MISSILE_SPEED);
            if live(e, bs, m.target) && m.t < 2.8 {
                let to = (goalOf(e, bs, m.target) - m.pos).normalize();
                dir = (dir + (to - dir) * min(MISSILE_TURN * dt, 1)).normalize();
            }
            m.vel = dir * speed;
            let step = speed * dt;
            let r = Ray { origin: m.pos, dir: dir };
            let foe = enemies.ray(e, r, step);
            let big = boss.ray(bs, r, step);
            let end = m.pos + m.vel * dt;
            if foe.index >= 0 || big.part >= 0 || solid(lvl, end, 0.1) >= 0 || m.t <= 0 {
                let at = end;
                if foe.index >= 0 { at = m.pos + dir * foe.t; }
                if big.part >= 0 && (foe.index < 0 || big.t < foe.t) { at = m.pos + dir * big.t; }
                let dmg = MISSILE_DMG * dmgScale(p);
                enemies.blast(e, at, MISSILE_BLAST, dmg, Vec3.xyz(1, 0.55, 0.2), 5);
                shrine.blast(sh, e, at, MISSILE_BLAST, dmg);
                boss.blast(bs, e, at, MISSILE_BLAST, dmg);
                sfx.at(sfx.BOOM, at);
                m.t = 0;
            } else {
                m.pos = end;
            }
        }
        i += 1;
    }
}

/// Storm: a strike on the nearest enemy every STORM_EVERY; every other strike goes to the boss
/// instead when it's in reach.
fn storm(s: &Skills, p: &Player, e: &Enemies, bs: &Bosses, dt: f32) {
    s.strikeT -= dt;
    if s.strikeT > 0 { return; }
    s.strikeT = STORM_EVERY;
    let target = enemies.nearest(e, p.pos, STORM_RANGE);
    let bossNear = boss.targetable(bs) && bosskit.flatDist(boss.middle(bs), p.pos) < STORM_RANGE + 6;
    let at = Vec3.zero();
    let dmg = STORM_DMG * dmgScale(p);
    if bossNear && s.strikes % 2 == 0 {
        at = boss.aimPoint(bs);
        boss.blast(bs, e, at, STORM_BLAST, dmg);
    } else if target >= 0 {
        at = e.list[target].pos;
        enemies.blast(e, at, STORM_BLAST, dmg, Vec3.xyz(0.6, 0.85, 1), 6);
    } else {
        // Nothing to hit this time; the next strike may still find the boss.
        s.strikes += 1;
        return;
    }
    s.strikes += 1;
    s.bolts[s.nextBolt] = Bolt { from: s.cloud - Vec3.xyz(0, 0.8, 0), to: at, t: BOLT_LIFE, seed: s.rng.unit() * 100 };
    s.nextBolt = (s.nextBolt + 1) % MAX_BOLTS;
    s.flashAt = at + Vec3.xyz(0, 1, 0);
    s.flashT = 0.12;
    sfx.at(sfx.THUNDER, at);
}

// ---- Drawing ----

fn put(s: &Skills, m: Mat4, tint: Vec3, glow: Vec3) {
    if s.nparts >= s.parts.len { return; }
    s.parts[s.nparts] = Instance { model: m, tint: tint, emission: glow };
    s.nparts += 1;
}

fn cubeAt(s: &Skills, at: Vec3, size: f32, tint: Vec3, glow: Vec3) {
    put(s, Mat4.translate(at.x, at.y, at.z).mul(Mat4.scale(size, size, size)), tint, glow);
}

/// A thin glowing box from `a` to `b`.
fn beam(s: &Skills, a: Vec3, b: Vec3, w: f32, glow: Vec3) {
    let y = b - a;
    let len = y.length();
    if len < 0.001 { return; }
    let up = y * (1 / len);
    let ref = Vec3.xyz(1, 0, 0);
    if abs(up.x) > 0.9 { ref = Vec3.xyz(0, 0, 1); }
    let x = up.cross(ref).normalize() * w;
    let z = up.cross(x).normalize() * w;
    put(s, bosskit.basis((a + b) * 0.5, x, y, z), Vec3.zero(), glow);
}

/// A jagged bolt: the same zigzag for its whole short life.
fn bolt(s: &Skills, bt: Bolt) {
    let k = bt.t / BOLT_LIFE;
    let prev = bt.from;
    let n = 7;
    let i = 1;
    while i <= n {
        let f = f32(i) / f32(n);
        let at = bt.from + (bt.to - bt.from) * f;
        if i < n {
            let j = bt.seed + f32(i) * 12.9;
            at = at + Vec3.xyz(sin(j) * 0.9, 0, cos(j * 1.3) * 0.9);
        }
        beam(s, prev, at, 0.22 * k + 0.05, Vec3.xyz(1.5, 2.2, 3) * (1 + k * 2));
        beam(s, prev, at, 0.07, Vec3.xyz(3, 3, 3));
        prev = at;
        i += 1;
    }
    cubeAt(s, bt.to, 0.8 * k, Vec3.zero(), Vec3.xyz(2, 2.6, 3));
}

fn drawMissiles(s: &Skills) {
    let i = 0;
    while i < MAX_MISSILES {
        let m = s.missiles[i];
        if m.t > 0 {
            let d = m.vel.normalize();
            beam(s, m.pos - d * 0.35, m.pos + d * 0.35, 0.14, Vec3.xyz(0.6, 0.6, 0.65));
            cubeAt(s, m.pos + d * 0.35, 0.16, Vec3.zero(), Vec3.xyz(3, 0.5, 0.3));
            cubeAt(s, m.pos - d * 0.45, 0.2, Vec3.zero(), Vec3.xyz(3, 1.6, 0.4));
        }
        i += 1;
    }
}

/// The thunder cloud: dark lumps flickering with lightning inside.
fn drawCloud(s: &Skills) {
    if s.skill != STORM || s.active <= 0 { return; }
    let fade = min(s.active, 1);
    let k = 0;
    while k < 11 {
        let a = f32(k) * 2.4;
        let r = 1.2 + f32(k % 4) * 0.9;
        let flick: f32 = if sin(f32(game.ticks()) * 0.02 + f32(k) * 3) > 0.8 { 1.6 } else { 0.08 };
        let at = s.cloud + Vec3.xyz(cos(a) * r, sin(a * 1.7) * 0.4, sin(a) * r);
        cubeAt(s, at, (1.6 + f32(k % 3) * 0.5) * fade, Vec3.xyz(0.22, 0.24, 0.3), Vec3.xyz(0.5, 0.7, 1) * flick);
        k += 1;
    }
}

/// Blink afterimages: tall slivers along the path, fading.
fn drawTrail(s: &Skills) {
    if s.trailT <= 0 { return; }
    let k = s.trailT / 0.35;
    let i = 0;
    while i < TRAIL - 1 {
        let at = s.trail[i] + Vec3.xyz(0, 0.9, 0);
        let size = 0.5 * k * (0.4 + 0.6 * f32(i) / f32(TRAIL));
        put(s, Mat4.translate(at.x, at.y, at.z).mul(Mat4.scale(size * 0.8, size * 2.6, size * 0.8)), Vec3.zero(), Vec3.xyz(0.6, 1.2, 2.4) * k);
        i += 1;
    }
}

/// The shuriken: two crossed flat blades, spinning, with a streak behind.
fn drawStar(s: &Skills) {
    if s.star.t <= 0 { return; }
    let at = s.star.pos;
    let spin = f32(game.ticks()) * 0.03;
    let up = Vec3.xyz(0, 1, 0);
    let glow = Vec3.xyz(1.5, 2, 2.6);
    put(s, Mat4.translate(at.x, at.y, at.z).mul(Mat4.rotate(up, spin)).mul(Mat4.scale(0.5, 0.05, 0.5)), Vec3.zero(), glow);
    put(s, Mat4.translate(at.x, at.y, at.z).mul(Mat4.rotate(up, spin + 0.785)).mul(Mat4.scale(0.5, 0.05, 0.5)), Vec3.zero(), glow);
    beam(s, at - s.star.dir * 1.6, at, 0.05, Vec3.xyz(0.8, 1.2, 1.6));
}

/// Orbital Strike: a ring on the ground while aiming, a blinking red one once called, and the beam
/// after it lands.
fn drawOrbital(s: &Skills) {
    let spot = s.mark;
    let ring = false;
    let glow = Vec3.xyz(0.4, 1.6, 1.8);
    if s.aim > 0 && s.markOk { ring = true; }
    if s.fall > 0 {
        spot = s.strikeAt;
        ring = true;
        glow = Vec3.xyz(3, 0.4, 0.3) * (0.5 + 0.5 * sin(s.fall * 30));
    }
    if ring {
        let n = 64;
        let j = 0;
        while j < n {
            let a = f32(j) * TAU / f32(n);
            cubeAt(s, spot + Vec3.xyz(cos(a) * ORBIT_R, 0.2, sin(a) * ORBIT_R), 0.6, Vec3.zero(), glow);
            j += 1;
        }
        cubeAt(s, spot + Vec3.xyz(0, 0.2, 0), 0.6, Vec3.zero(), glow);
    }
    if s.glowT > 0 {
        let k = min(s.glowT / 0.6, 1);
        let t = f32(game.ticks()) * 0.001;
        let top = s.strikeAt + Vec3.xyz(0, 160, 0);
        let pulse = 0.88 + 0.12 * sin(t * 50);
        beam(s, s.strikeAt, top, ORBIT_R * 2 * k * pulse, Vec3.xyz(3, 1.2, 0.8) * k);
        beam(s, s.strikeAt, top, ORBIT_R * 0.8 * k * (1.05 - 0.1 * sin(t * 37)), Vec3.xyz(3, 3, 3) * k);
        // Three bright streaks spiralling round the column.
        let bj = 0;
        while bj < 3 {
            let ba = t * 5 + f32(bj) * TAU / 3;
            let at = s.strikeAt + Vec3.xyz(cos(ba) * ORBIT_R * 0.8, 0, sin(ba) * ORBIT_R * 0.8);
            beam(s, at, at + Vec3.xyz(0, 160, 0), ORBIT_R * 0.12 * k, Vec3.xyz(4, 2.2, 1.2) * k);
            bj += 1;
        }
        // Rings climbing the beam, and ba shockwave pulsing out along the ground.
        bj = 0;
        while bj < 4 {
            let bh = ((t * 40 + f32(bj) * 12) % 48);
            let br = ORBIT_R * (1 + 0.15 * sin(t * 20 + f32(bj)));
            let bn = 24;
            let bq = 0;
            while bq < bn {
                let bc = f32(bq) * TAU / f32(bn) + t * 2;
                cubeAt(s, s.strikeAt + Vec3.xyz(cos(bc) * br, bh, sin(bc) * br), 0.5, Vec3.zero(), Vec3.xyz(3, 1.4, 0.8) * k);
                bq += 1;
            }
            bj += 1;
        }
        let wave = (t * 2) % 1;
        let bw = 40;
        bj = 0;
        while bj < bw {
            let bd = f32(bj) * TAU / f32(bw);
            cubeAt(s, s.strikeAt + Vec3.xyz(cos(bd) * ORBIT_R * wave, 0.3, sin(bd) * ORBIT_R * wave), 0.7, Vec3.zero(), Vec3.xyz(3, 2, 1.2) * k * (1 - wave));
            bj += 1;
        }
    }
}

/// Detonate: a ring of fire racing out and a fading core.
fn drawBoom(s: &Skills) {
    if s.boomT >= 0.45 { return; }
    let k = s.boomT / 0.45;
    let r = DETONATE_R * sqrt(k);
    let n = 40;
    let j = 0;
    while j < n {
        let a = f32(j) * TAU / f32(n);
        let at = s.boomAt + Vec3.xyz(cos(a) * r, -0.6 + sin(f32(j) * 1.7) * 0.3, sin(a) * r);
        cubeAt(s, at, 0.9 * (1 - k) + 0.1, Vec3.zero(), Vec3.xyz(3, 1.3, 0.3) * (1 - k));
        j += 1;
    }
    cubeAt(s, s.boomAt, r * 0.9 * (1 - k), Vec3.zero(), Vec3.xyz(3, 2, 0.8) * (1 - k));
}

/// Missiles, the storm cloud and its bolts, blink afterimages, detonate's shock. Camera pass.
pub fn draw(s: &Skills) {
    s.nparts = 0;
    drawMissiles(s);
    drawCloud(s);
    let i = 0;
    while i < MAX_BOLTS {
        if s.bolts[i].t > 0 { bolt(s, s.bolts[i]); }
        i += 1;
    }
    drawTrail(s);
    drawBoom(s);
    drawStar(s);
    drawOrbital(s);
    if s.nparts == 0 { return; }
    gfx.surface(gfx.plainSurface());
    gfx.drawInstances(s.cube, []Instance { ptr: s.parts.ptr, len: s.nparts });
}

/// The strike and detonate flash (light slot 5), before the camera pass.
pub fn lights(s: &Skills) {
    if s.flashT > 0 {
        gfx.light(5, s.flashAt, Vec3.xyz(1.5, 2, 3) * (s.flashT * 8), 16);
    } else {
        gfx.light(5, Vec3.zero(), Vec3.zero(), 0);
    }
}

// ---- Hud ----

fn paint(c: Vec3, a: f32) {
    game.setColor(game.rgba(u8(clamp(c.x, 0, 1) * 255), u8(clamp(c.y, 0, 1) * 255), u8(clamp(c.z, 0, 1) * 255), u8(clamp(a, 0, 1) * 255)));
}

/// The skill's box, bottom left above the health: a ring that fills as it cools down (and
/// empties as a lasting skill runs out), its name, and the Q prompt. Overclock and Ram tint
/// the screen's edges while they run.
pub fn hud(s: &Skills, font: Font, big: Font) {
    let sz = game.windowSize();
    if s.skill != 0 { widget(s, font, sz); }
    if s.offering { card(s, font, big, sz); }
}

fn widget(s: &Skills, font: Font, sz: Vec2) {
    let x: f32 = 12;
    let y = sz.y - 172;
    let c = tint(s.skill);
    paint(Vec3.xyz(0.08, 0.09, 0.16), 0.6);
    rect(x, y, 190, 62);
    let cx = x + 31;
    let cy = y + 31;
    let ready = s.cd <= 0 && s.active <= 0;
    // The ring: cooled share lit, or while it lasts, the time left.
    let fill: f32 = 1;
    if s.active > 0 { fill = s.active / max(lasts(s.skill), 0.01); }
    else if s.cd > 0 { fill = 1 - s.cd / cooldown(s.skill); }
    let n = 32;
    let k = 0;
    while k < n {
        let a = f32(k) / f32(n) * TAU;
        let lit = f32(k) + 0.5 < fill * f32(n);
        if lit {
            if s.active > 0 { paint(Vec3.xyz(1, 1, 1), 0.95); } else { paint(c, if ready { 1 } else { 0.7 }); }
        } else {
            paint(Vec3.xyz(0.25, 0.27, 0.35), 0.8);
        }
        rect(cx + sin(a) * 24 - 2.5, cy - cos(a) * 24 - 2.5, 5, 5);
        k += 1;
    }
    // The key in the middle: bright when ready, flashing when it comes back.
    let flash = max(s.readyT, 0) / 0.6;
    if ready { paint(c + (Vec3.xyz(1, 1, 1) - c) * flash, 1); } else { paint(Vec3.xyz(0.3, 0.32, 0.42), 1); }
    rect(cx - 13, cy - 13, 26, 26);
    if s.denyT > 0 { paint(Vec3.xyz(1, 0.25, 0.2), 0.9); rect(cx - 13, cy - 13, 26, 26); }
    paint(Vec3.xyz(0.06, 0.06, 0.1), 1);
    centered(font, cx, cy - 9, "Q");
    paint(c, 1);
    game.drawText(font, Vec2 { x: x + 64, y: y + 10 }, name(s.skill));
    if s.aim > 0 {
        paint(Vec3.xyz(1, 1, 1), 0.9);
        game.drawText(font, Vec2 { x: x + 64, y: y + 34 }, `AIM  Q to fire  {int(s.aim + 0.99)}s`);
    } else if s.fall > 0 || s.burnT > 0 {
        paint(Vec3.xyz(1, 0.35, 0.3), 0.9);
        game.drawText(font, Vec2 { x: x + 64, y: y + 34 }, "INBOUND");
    } else if s.active > 0 {
        paint(Vec3.xyz(1, 1, 1), 0.9);
        game.drawText(font, Vec2 { x: x + 64, y: y + 34 }, `ACTIVE  {int(s.active + 0.99)}s`);
    } else if s.cd > 0 {
        paint(Vec3.xyz(0.7, 0.72, 0.8), 0.9);
        game.drawText(font, Vec2 { x: x + 64, y: y + 34 }, `{int(s.cd + 0.99)}s`);
    } else {
        paint(Vec3.xyz(0.55, 1, 0.5), 0.9 + 0.1 * sin(f32(game.ticks()) * 0.01));
        game.drawText(font, Vec2 { x: x + 64, y: y + 34 }, "READY");
    }
}

/// The reward card: take or refuse the offered skill.
fn card(s: &Skills, font: Font, big: Font, sz: Vec2) {
    game.setColor(game.rgba(10, 12, 24, 170));
    rect(0, 0, sz.x, sz.y);
    let k = clamp(s.t / 0.25, 0, 1);
    let ease = 1 - (1 - k) * (1 - k);
    let x = (sz.x - CARD_W) * 0.5;
    let y = (sz.y - CARD_H) * 0.5 + (1 - ease) * 60;
    let alpha = ease;
    let cx = sz.x * 0.5;
    let c = tint(s.next);
    paint(Vec3.xyz(1, 0.5, 0.35), 1);
    centered(big, cx, y - 70, "BOSS REWARD");
    let pulse = 0.5 + 0.5 * sin(s.t * 4);
    paint(c, (0.2 + 0.25 * pulse) * ease);
    rect(x - 10, y - 10, CARD_W + 20, CARD_H + 20);
    paint(c, alpha);
    rect(x - 3, y - 3, CARD_W + 6, CARD_H + 6);
    paint(Vec3.xyz(0.1, 0.1, 0.17), alpha);
    rect(x, y, CARD_W, CARD_H);
    paint(Vec3.xyz(0.75, 0.78, 0.88), alpha);
    centered(font, cx, y + 16, "NEW SKILL  -  Q");
    paint(c, alpha);
    centered(big, cx, y + 44, name(s.next));
    paint(Vec3.xyz(0.9, 0.9, 0.95), alpha);
    centered(font, cx, y + 114, line1(s.next));
    centered(font, cx, y + 138, line2(s.next));
    paint(Vec3.xyz(0.65, 0.68, 0.78), alpha);
    centered(font, cx, y + 170, `cooldown {int(cooldown(s.next))} s`);
    if s.skill != 0 {
        paint(Vec3.xyz(1, 0.75, 0.4), alpha);
        centered(font, cx, y + 196, `replaces {name(s.skill)}`);
    }
    let bw = CARD_W * 0.5 - 36;
    let m = game.mousePos();
    let i = 0;
    while i < 2 {
        let b = buttonAt(i, sz);
        b.y = b.y - (1 - ease) * 60;
        let hot = over(m, b.x, b.y, bw, 46);
        if i == 0 {
            if hot { game.setColor(game.rgba(120, 240, 110, u8(255 * alpha))); } else { game.setColor(game.rgba(80, 190, 80, u8(255 * alpha))); }
        } else {
            if hot { game.setColor(game.rgba(255, 100, 90, u8(255 * alpha))); } else { game.setColor(game.rgba(190, 70, 70, u8(255 * alpha))); }
        }
        rect(b.x, b.y, bw, 46);
        game.setColor(game.rgba(20, 20, 30, u8(255 * alpha)));
        if i == 0 { centered(font, b.x + bw * 0.5, b.y + 14, "[1] TAKE"); } else { centered(font, b.x + bw * 0.5, b.y + 14, "[2] REFUSE"); }
        i += 1;
    }
    paint(Vec3.xyz(0.6, 0.62, 0.72), alpha);
    centered(font, cx, y + CARD_H + 16, "refusing skips this skill for good");
}

// ---- Checks ----

/// The reward order (skills, with legendary level ups between); take and refuse; the shuriken
/// hits three foes and stops; going down starts over.
pub fn selfCheck(mem: &Arena) {
    let lvl = level.empty(mem, 1, 0);
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(-50, -1, -50), hi: Vec3.xyz(50, 0, 50), launch: 0, kind: SOLID };
    level.index(&lvl, mem);
    let p = player.create(&lvl);
    let s = create(mem);
    let foes = enemies.create(mem);
    let bs = boss.create(mem);
    if rewardOf(1) != SLINGSHOT || rewardOf(4) != 0 || rewardOf(6) != 0 || rewardOf(8) != 0 || rewardOf(9) != ORBITAL { panic("skills check: reward order"); }
    if offer(&s, 4) || s.offering { panic("skills check: legendary slot dealt a skill"); }
    if !offer(&s, 2) || s.next != SHURIKEN { panic("skills check: offer"); }
    take(&s, &p);
    if s.skill != SHURIKEN || s.cd > 0 { panic("skills check: take"); }
    // Slingshot keeps its speed along the view.
    p.yaw = 0;
    p.pitch = 0;
    sling(&s, &p, &foes);
    if p.vel.length() < SLING_SPEED - 1 || p.onGround { panic("skills check: slingshot"); }
    // Three foes in a row along -z: the star locks the first and hops to the rest, then stops.
    let k = 0;
    while k < 4 {
        let at = Vec3.xyz(0, 1.5, -8 - f32(k) * 6);
        enemies.spawnAt(&foes, enemies.HOPPER, at, Vec3.zero(), false);
        foes.list[k].hp = 1000;
        foes.list[k].mod = 0;
        foes.list[k].wakeT = 0;
        k += 1;
    }
    p.pos = Vec3.xyz(0, 0, 0);
    hurl(&s, &p, &foes, &bs);
    if s.star.target < 0 { panic("skills check: shuriken lock"); }
    k = 0;
    while k < 120 && s.star.t > 0 { starFly(&s, &p, &lvl, &foes, &bs, 0.016); k += 1; }
    let hurt = 0;
    k = 0;
    while k < 4 { if foes.list[k].hp < 1000 { hurt += 1; } k += 1; }
    if hurt != STAR_HITS || s.star.t > 0 { panic("skills check: shuriken hits"); }
    reset(&s, &p);
    if s.skill != 0 || s.next != 0 { panic("skills check: reset"); }
}
