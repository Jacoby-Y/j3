// Sound effects from assets/sfx (made by tools/sfx.j3s). Silent when SDL_mixer or a file is
// missing. Sounds with a position pan and fade by where they are from the listener, which main
// moves to the camera every frame.

module fps_shooter.sfx;

use j3.game;
use j3.game.Sound;
use j3.math.{ Vec3, atan2, clamp };

pub const SHOT: int = 0;
pub const SHOTGUN: int = 1;
pub const SNIPER: int = 2;
pub const ROCKET: int = 3;
pub const BOOM: int = 4;
pub const BOW: int = 5;
pub const WAND: int = 6;
pub const SWISH: int = 7;
pub const RELOAD: int = 8;
pub const HIT: int = 9;
pub const KILL: int = 10;
pub const ZAP: int = 11;
pub const HURT: int = 12;
pub const JUMP: int = 13;
pub const DASH: int = 14;
pub const GEM: int = 15;
pub const LEVEL: int = 16;
pub const UNLOCK: int = 17;
pub const ROAR: int = 18;
pub const SLAM: int = 19;
pub const HORN: int = 20;
pub const CRIT: int = 21;
pub const WARN: int = 22;
pub const BLINK: int = 23;
pub const THUNDER: int = 24;
pub const READY: int = 25;
pub const FLAME: int = 26;
pub const BEAM: int = 27;
pub const SHATTER: int = 28;
pub const SKILL: int = 29;
pub const DENY: int = 30;
pub const BOW_READY: int = 31;

/// Past this many metres a sound is gone.
const HEAR: f32 = 70;
/// Starting volume, 0..100.
pub const DEFAULT_VOLUME: f32 = 70;

/// Every sound by id; empty handles until `load`.
#[singleton]
let bank: [32]Sound;

// The listener, from `listen`.
#[singleton]
let ear: Vec3;
#[singleton]
let front: Vec3;
#[singleton]
let side: Vec3;

fn one(name: string): Sound {
    return game.tryLoadSound(`assets/sfx/{name}.wav`);
}

pub fn load() {
    bank[SHOT] = one("shot");
    bank[SHOTGUN] = one("shotgun");
    bank[SNIPER] = one("sniper");
    bank[ROCKET] = one("rocket");
    bank[BOOM] = one("boom");
    bank[BOW] = one("bow");
    bank[WAND] = one("wand");
    bank[SWISH] = one("swish");
    bank[RELOAD] = one("reload");
    bank[HIT] = one("hit");
    bank[KILL] = one("kill");
    bank[ZAP] = one("zap");
    bank[HURT] = one("hurt");
    bank[JUMP] = one("jump");
    bank[DASH] = one("dash");
    bank[GEM] = one("gem");
    bank[LEVEL] = one("level");
    bank[UNLOCK] = one("unlock");
    bank[ROAR] = one("roar");
    bank[SLAM] = one("slam");
    bank[HORN] = one("horn");
    bank[CRIT] = one("crit");
    bank[WARN] = one("warn");
    bank[BLINK] = one("blink");
    bank[THUNDER] = one("thunder");
    bank[READY] = one("ready");
    bank[FLAME] = one("flame");
    bank[BEAM] = one("beam");
    bank[SHATTER] = one("shatter");
    bank[SKILL] = one("skill");
    bank[DENY] = one("deny");
    bank[BOW_READY] = one("bow_ready");
    volume(DEFAULT_VOLUME);
}

/// Sound effects volume, 0..100 (SDL_mixer's 0..128 underneath).
pub fn volume(percent: f32) {
    game.setGroupVolume(0, int(clamp(percent, 0, 100) * 1.28 + 0.5));
}

/// Where the listener is and which way it faces.
pub fn listen(at: Vec3, fwd: Vec3, right: Vec3) {
    ear = at;
    front = fwd;
    side = right;
}

pub fn play(id: int) {
    let ch = game.play(bank[id]);
    // Channels are shared: undo the last positional sound's pan.
    if ch >= 0 { game.setPosition(ch, 0, 0); }
}

/// Sound `id` from `from`: panned toward it, quieter with distance, skipped out of earshot.
pub fn at(id: int, from: Vec3) {
    let off = from - ear;
    let far = off.length();
    if far > HEAR { return; }
    let ch = game.play(bank[id]);
    if ch < 0 { return; }
    let deg = atan2(off.dot(side), off.dot(front)) * 57.3;
    game.setPosition(ch, int(deg), int(far / HEAR * 255));
}
