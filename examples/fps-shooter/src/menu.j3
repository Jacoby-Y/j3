// The main menu, the pause menu and the death screen. Each draws itself and returns what was
// picked (NONE, GO, RESTART or TITLE); main.j3 acts on it next frame.

module fps_shooter.menu;

use j3.game;
use j3.game.{ Font, Mouse };
use j3.math.{ Vec2, Vec3, clamp, sin };
use fps_shooter.player;
use fps_shooter.skills;
use fps_shooter.skills.Skills;
use j3.ui.{ Theme, Ui };
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.pal;
use fps_shooter.perks.Perks;
use fps_shooter.player.Player;
use fps_shooter.score;
use fps_shooter.score.Score;
use fps_shooter.sfx;

pub const NONE: int = 0;
/// Play (title), resume (pause) or try again (death).
pub const GO: int = 1;
/// Start the run over from the pause menu.
pub const RESTART: int = 2;
/// Back to the main menu.
pub const TITLE: int = 3;

const MAIN: int = 0;
const SETTINGS: int = 1;
const CONTROLS: int = 2;
const STATS: int = 3;

/// Which page of the title or pause menu is up.
#[singleton]
let page: int;

const BTN_W: f32 = 320;
const BTN_H: f32 = 44;
const BTN_GAP: f32 = 10;

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

fn centered(font: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(font, msg);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

// ponytail: minutes and seconds instead of a returned string: an interpolated string lives in its function's stack frame.
fn pad(t: f32): string {
    if int(t) % 60 < 10 { return "0"; }
    return "";
}

/// Escape on a sub page goes back to the main page. True when it did.
pub fn back(): bool {
    if page != MAIN {
        page = MAIN;
        return true;
    }
    return false;
}

/// The menu is not up: the next one opens on its main page.
pub fn close() {
    page = MAIN;
}

/// The button the pointer is on (its x + y), so the tick sounds once as it lands on one.
#[singleton]
let hoverKey: f32;

fn button(font: Font, x: f32, y: f32, w: f32, msg: string): bool {
    let m = game.mousePos();
    let over = m.x >= x && m.x < x + w && m.y >= y && m.y < y + BTN_H;
    if over && hoverKey != x + y { hoverKey = x + y; sfx.play(sfx.TICK); }
    if !over && hoverKey == x + y { hoverKey = 0; }
    if over { pal.hot(); } else { pal.raised(); }
    rect(x, y, w, BTN_H);
    if over { pal.aqua(); } else { pal.text(); }
    let t = game.textSize(font, msg);
    game.drawText(font, Vec2 { x: x + 20, y: y + (BTN_H - t.y) * 0.5 }, msg);
    let hit = over && game.mousePressed(Mouse.Left);
    if hit { sfx.play(sfx.CLICK); }
    return hit;
}

/// Dark wash over the game.
fn dim(sz: Vec2, alpha: u8) {
    pal.deep(alpha);
    rect(0, 0, sz.x, sz.y);
}

/// A settings row group: sensitivities and volume, with a back button.
fn settings(font: Font, big: Font, p: &Player, sz: Vec2) {
    dim(sz, 190);
    let pw: f32 = 420;
    let ph: f32 = 300;
    let x = (sz.x - pw) * 0.5;
    let y = (sz.y - ph) * 0.5 + 24;
    pal.aqua();
    centered(big, sz.x * 0.5, y - 44 - 26, "SETTINGS");
    let ui = Ui.begin(font, x, y);
    ui.theme = Theme {
        text: game.rgb(222, 229, 236), button: game.rgb(52, 60, 70), buttonHot: game.rgb(76, 88, 101),
        buttonDown: game.rgb(40, 47, 56), panel: game.rgba(30, 36, 43, 245), edge: game.rgb(30, 36, 43),
        accent: game.rgb(126, 232, 226),
    };
    ui.h = 32;
    ui.panel(pw, ph);
    ui.label(`Look sensitivity   {int(p.sens * 100 + 0.5)}%`);
    ui.pushId(1);
    ui.slider("", &p.sens, 0.2, 3);
    ui.popId();
    ui.gap(4);
    ui.label(`Aim sensitivity   {int(p.adsSens * 100 + 0.5)}%`);
    ui.pushId(2);
    ui.slider("", &p.adsSens, 0.2, 2);
    ui.popId();
    ui.gap(4);
    ui.label(`Volume   {int(p.volume + 0.5)}%`);
    ui.pushId(3);
    if ui.slider("", &p.volume, 0, 100) { sfx.volume(p.volume); }
    ui.popId();
    ui.gap(14);
    if ui.button("Back") { page = MAIN; }
    ui.end();
}

/// One key and what it does.
fn bind(font: Font, x: f32, y: f32, key: string, what: string) {
    pal.aqua();
    game.drawText(font, Vec2 { x: x, y: y }, key);
    pal.text();
    game.drawText(font, Vec2 { x: x + 128, y: y }, what);
}

fn controls(font: Font, big: Font, sz: Vec2) {
    dim(sz, 190);
    let pw: f32 = 640;
    let ph: f32 = 372;
    let x = (sz.x - pw) * 0.5;
    let y = (sz.y - ph) * 0.5 + 24;
    pal.aqua();
    centered(big, sz.x * 0.5, y - 44 - 26, "CONTROLS");
    pal.card(245);
    rect(x, y, pw, ph);
    let row: f32 = 30;
    let top = y + 26;
    let lx = x + 24;
    let rx = x + pw * 0.5 + 8;
    bind(font, lx, top, "WASD", "move");
    bind(font, lx, top + row, "SPACE", "jump, again in the air");
    bind(font, lx, top + row * 2, "SHIFT", "sprint");
    bind(font, lx, top + row * 3, "CTRL", "slide");
    bind(font, lx, top + row * 4, "E", "dash");
    bind(font, lx, top + row * 5, "LMB", "shoot");
    bind(font, lx, top + row * 6, "RMB", "aim down sights");
    bind(font, rx, top, "R", "reload");
    bind(font, rx, top + row, "1-8 / WHEEL", "switch guns");
    bind(font, rx, top + row * 2, "Q", "boss skill");
    bind(font, rx, top + row * 3, "G", "turret (with the perk)");
    bind(font, rx, top + row * 4, "M", "big map");
    bind(font, rx, top + row * 5, "ESC", "pause");
    if button(font, x + (pw - BTN_W) * 0.5, y + ph - BTN_H - 20, BTN_W, "BACK") { page = MAIN; }
}

/// The main menu: title on the left over the slowly turning arena, buttons under it.
pub fn title(font: Font, big: Font, huge: Font, p: &Player, sz: Vec2, best: f32): int {
    let pg = page;
    // A dark wash fading out to the right, so the text reads and the arena still shows.
    let k = 0;
    while k < 12 {
        let a = 215 - k * 17;
        pal.deep(u8(a));
        rect(sz.x * 0.06 * f32(k), 0, sz.x * 0.06 + 1, sz.y);
        k += 1;
    }
    let x = sz.x * 0.07;
    let now = f32(game.ticks()) * 0.001;
    pal.aqua();
    game.drawText(huge, Vec2 { x: x, y: sz.y * 0.12 }, "FPS");
    pal.text();
    game.drawText(huge, Vec2 { x: x, y: sz.y * 0.12 + 74 }, "SHOOTER");
    // Logo mark: a crosshair with a breathing gap, to the right of the name.
    let nameW = game.textSize(huge, "SHOOTER");
    let mx = x + nameW.x + 48;
    let my = sz.y * 0.12 + 62;
    let gap = 10 + sin(now * 2) * 3;
    pal.aqua();
    rect(mx - 4, my - 4, 8, 8);
    rect(mx - 2, my - 48, 4, 48 - gap);
    rect(mx - 2, my + gap, 4, 48 - gap);
    rect(mx - 48, my - 2, 48 - gap, 4);
    rect(mx + gap, my - 2, 48 - gap, 4);
    pal.text();
    rect(mx - 56, my - 56, 24, 4); rect(mx - 56, my - 56, 4, 24);
    rect(mx + 32, my - 56, 24, 4); rect(mx + 52, my - 56, 4, 24);
    rect(mx - 56, my + 52, 24, 4); rect(mx - 56, my + 32, 4, 24);
    rect(mx + 32, my + 52, 24, 4); rect(mx + 52, my + 32, 4, 24);
    // A bar that breathes under the name.
    pal.aqua();
    rect(x, sz.y * 0.12 + 160, 120 + sin(now * 2) * 24, 4);
    pal.mute();
    game.drawText(font, Vec2 { x: x, y: sz.y * 0.12 + 176 }, "run fast. shoot everything. don't stop.");
    let by = sz.y * 0.55;
    let pick = NONE;
    if pg == MAIN {
        if button(font, x, by, BTN_W, "PLAY") { pick = GO; }
        let top = enemies.hardOpen();
        let d = enemies.difficulty();
        if button(font, x, by + (BTN_H + BTN_GAP), BTN_W, `DIFFICULTY  {enemies.diffName(d)}`) {
            d += 1;
            if d > enemies.DEATH || (d > enemies.MEDIUM && !top) { d = enemies.EASY; }
            enemies.setDifficulty(d);
        }
        if !top {
            pal.faint();
            game.drawText(font, Vec2 { x: x + BTN_W + 14, y: by + (BTN_H + BTN_GAP) + 12 }, "harder: beat the game");
        }
        if button(font, x, by + (BTN_H + BTN_GAP) * 2, BTN_W, "SETTINGS") { page = SETTINGS; }
        if button(font, x, by + (BTN_H + BTN_GAP) * 3, BTN_W, "CONTROLS") { page = CONTROLS; }
        if button(font, x, by + (BTN_H + BTN_GAP) * 4, BTN_W, "QUIT") { game.requestQuit(); }
        if best > 0 {
            pal.aqua();
            game.drawText(font, Vec2 { x: x, y: by + (BTN_H + BTN_GAP) * 5 + 12 }, `BEST  {int(best)}`);
        }
        pal.faint();
        game.drawText(font, Vec2 { x: x, y: sz.y - 34 }, "ENTER  play");
    } else if pg == SETTINGS {
        settings(font, big, p, sz);
    } else {
        controls(font, big, sz);
    }
    return pick;
}

/// The pause menu: run so far, then resume, settings, controls, restart, main menu and quit.
pub fn pause(font: Font, big: Font, p: &Player, e: &Enemies, ps: &Perks, sk: &Skills, sz: Vec2): int {
    let pg = page;
    if pg == SETTINGS { settings(font, big, p, sz); return NONE; }
    if pg == CONTROLS { controls(font, big, sz); return NONE; }
    if pg == STATS { stats(font, big, p, sk, sz); return NONE; }
    dim(sz, 165);
    let cx = sz.x * 0.5;
    let total = (BTN_H + BTN_GAP) * 7 + 96;
    let top = (sz.y - total) * 0.5;
    pal.aqua();
    centered(big, cx, top, "PAUSED");
    pal.mute();
    centered(font, cx, top + 60, `LV {ps.level}     {int(e.time) / 60}:{pad(e.time)}{int(e.time) % 60}     {e.kills} KILLS`);
    let x = cx - BTN_W * 0.5;
    let y = top + 96;
    let pick = NONE;
    if button(font, x, y, BTN_W, "RESUME") { pick = GO; }
    if button(font, x, y + (BTN_H + BTN_GAP), BTN_W, "STATS") { page = STATS; }
    if button(font, x, y + (BTN_H + BTN_GAP) * 2, BTN_W, "SETTINGS") { page = SETTINGS; }
    if button(font, x, y + (BTN_H + BTN_GAP) * 3, BTN_W, "CONTROLS") { page = CONTROLS; }
    if button(font, x, y + (BTN_H + BTN_GAP) * 4, BTN_W, "RESTART RUN") { pick = RESTART; }
    if button(font, x, y + (BTN_H + BTN_GAP) * 5, BTN_W, "MAIN MENU") { pick = TITLE; }
    if button(font, x, y + (BTN_H + BTN_GAP) * 6, BTN_W, "QUIT") { game.requestQuit(); }
    pal.faint();
    centered(font, cx, sz.y - 34, "ESC  resume");
    return pick;
}

/// A percent row from a fraction (0.075 is +7.5%), dim while it is still zero.
fn pctRow(font: Font, x: f32, y: f32, w: f32, name: string, v: f32) {
    let t = int(v * 1000 + 0.5);
    let whole = t / 10;
    let tenth = t % 10;
    if t == 0 {
        stat(font, x, y, w, name, "-");
    } else if tenth == 0 {
        stat(font, x, y, w, name, `+{whole}%`);
    } else {
        stat(font, x, y, w, name, `+{whole}.{tenth}%`);
    }
}

/// A count row: "+2", or a dash at zero.
fn countRow(font: Font, x: f32, y: f32, w: f32, name: string, n: int) {
    if n == 0 { stat(font, x, y, w, name, "-"); } else { stat(font, x, y, w, name, `+{n}`); }
}

/// One shrine gift line, only while it is owned. Returns the next row's y.
fn gift(font: Font, p: &Player, x: f32, y: f32, bit: int, name: string): f32 {
    if !player.has(p, bit) { return y; }
    pal.aqua();
    game.drawText(font, Vec2 { x: x, y: y }, name);
    return y + 26;
}

/// Everything the cards, shrines and bosses have given you this run.
fn stats(font: Font, big: Font, p: &Player, sk: &Skills, sz: Vec2) {
    dim(sz, 190);
    let pw: f32 = 660;
    let ph: f32 = 392;
    let x = (sz.x - pw) * 0.5;
    let y = (sz.y - ph) * 0.5 + 24;
    pal.aqua();
    centered(big, sz.x * 0.5, y - 44 - 26, "STATS");
    pal.card(245);
    rect(x, y, pw, ph);
    let cw = pw * 0.5 - 40;
    let lx = x + 24;
    let rx = x + pw * 0.5 + 16;
    let row: f32 = 26;
    let top = y + 44;
    let s = &p.stats;
    pal.mute();
    game.drawText(font, Vec2 { x: lx, y: y + 14 }, "CARD BONUSES");
    pctRow(font, lx, top, cw, "FIRE RATE", s.fireRate);
    pctRow(font, lx, top + row, cw, "DAMAGE", s.damage);
    pctRow(font, lx, top + row * 2, cw, "MOVE SPEED", s.speed);
    pctRow(font, lx, top + row * 3, cw, "AMMO CAPACITY", s.mag);
    pctRow(font, lx, top + row * 4, cw, "RELOAD SPEED", s.reload);
    pctRow(font, lx, top + row * 5, cw, "HP REGEN", s.regen);
    pctRow(font, lx, top + row * 6, cw, "MAX HP", s.maxHp);
    pctRow(font, lx, top + row * 7, cw, "LUCK", s.luck);
    countRow(font, lx, top + row * 8, cw, "AIR JUMPS", s.airJumps);
    countRow(font, lx, top + row * 9, cw, "AIR DASHES", s.airDashes);

    pal.mute();
    game.drawText(font, Vec2 { x: rx, y: y + 14 }, "BOSS SKILL");
    pal.text();
    if sk.skill == 0 { game.drawText(font, Vec2 { x: rx, y: top }, "none"); } else { game.drawText(font, Vec2 { x: rx, y: top }, skills.name(sk.skill)); }
    pal.mute();
    game.drawText(font, Vec2 { x: rx, y: top + 44 }, "SHRINE GIFTS");
    let gy = top + 44 + 30;
    let start = gy;
    gy = gift(font, p, rx, gy, player.AIR_DMG, "AIR DAMAGE");
    gy = gift(font, p, rx, gy, player.DRONE, "DRONE");
    gy = gift(font, p, rx, gy, player.JETPACK, "JETPACK");
    gy = gift(font, p, rx, gy, player.TURRET, "TURRET");
    gy = gift(font, p, rx, gy, player.RPG, "ROCKET LAUNCHER");
    gy = gift(font, p, rx, gy, player.BOW, "BOW");
    gy = gift(font, p, rx, gy, player.KNIFE, "KNIFE");
    gy = gift(font, p, rx, gy, player.WAND, "WAND");
    gy = gift(font, p, rx, gy, player.BOARD, "BOARD");
    gy = gift(font, p, rx, gy, player.SHOTGUN, "SHOTGUN");
    gy = gift(font, p, rx, gy, player.MAGNET, "MAGNET");
    if gy == start {
        pal.faint();
        game.drawText(font, Vec2 { x: rx, y: gy }, "none yet");
    }
    if button(font, x + (pw - BTN_W) * 0.5, y + ph - BTN_H - 20, BTN_W, "BACK") { page = MAIN; }
}

/// One stat line: name on the left, value on the right.
fn stat(font: Font, x: f32, y: f32, w: f32, name: string, value: string) {
    pal.mute();
    game.drawText(font, Vec2 { x: x, y: y }, name);
    let t = game.textSize(font, value);
    pal.text();
    game.drawText(font, Vec2 { x: x + w - t.x, y: y }, value);
}

/// After you go down: a red fade, the run's numbers, then the buttons once the fade is in.
pub fn death(font: Font, big: Font, huge: Font, e: &Enemies, s: &Score, ps: &Perks, sz: Vec2): int {
    let fade = clamp(e.downT * 2, 0, 1);
    game.setColor(game.rgba(34, 4, 8, u8(205 * fade)));
    rect(0, 0, sz.x, sz.y);
    // Red creeping in from the edges.
    let k = 0;
    while k < 8 {
        game.setColor(game.rgba(150, 10, 20, u8((34 - f32(k) * 4) * fade)));
        let m = f32(k) * 14;
        rect(0, m, sz.x, 14);
        rect(0, sz.y - m - 14, sz.x, 14);
        rect(m, 0, 14, sz.y);
        rect(sz.x - m - 14, 0, 14, sz.y);
        k += 1;
    }
    let cx = sz.x * 0.5;
    game.setColor(game.rgba(255, 80, 72, u8(255 * fade)));
    centered(huge, cx, sz.y * 0.12, "YOU DIED");

    let cw: f32 = 420;
    let ch: f32 = 232;
    let x = cx - cw * 0.5;
    let y = sz.y * 0.12 + 96;
    pal.card(u8(240 * fade));
    rect(x, y, cw, ch);
    // The score, big, with the rank it ended on.
    pal.text();
    game.drawText(big, Vec2 { x: x + 24, y: y + 16 }, `{int(s.last)}`);
    let rank = score.rankName(s.lastRank);
    let rc = score.rankColor(s.lastRank);
    game.setColor(game.rgb(u8(rc.x * 255), u8(rc.y * 255), u8(rc.z * 255)));
    let rt = game.textSize(big, rank);
    game.drawText(big, Vec2 { x: x + cw - 24 - rt.x, y: y + 16 }, rank);
    if s.newBest {
        pal.aqua();
        game.drawText(font, Vec2 { x: x + 24, y: y + 68 }, "NEW BEST");
    } else {
        pal.mute();
        game.drawText(font, Vec2 { x: x + 24, y: y + 68 }, `BEST  {int(s.best)}`);
    }
    let w = cw - 48;
    stat(font, x + 24, y + 108, w, "SURVIVED", `{int(e.downTime) / 60}:{pad(e.downTime)}{int(e.downTime) % 60}`);
    stat(font, x + 24, y + 138, w, "KILLS", `{e.kills}`);
    stat(font, x + 24, y + 168, w, "LEVEL", `{ps.level}`);
    stat(font, x + 24, y + 198, w, "TIER", `{e.tier}`);

    let pick = NONE;
    if e.downT > 0.45 {
        let bx = cx - BTN_W * 0.5;
        let by = y + ch + 24;
        if button(font, bx, by, BTN_W, "TRY AGAIN") { pick = GO; }
        if button(font, bx, by + (BTN_H + BTN_GAP), BTN_W, "MAIN MENU") { pick = TITLE; }
        pal.faint();
        centered(font, cx, by + (BTN_H + BTN_GAP) * 2 + 8, "SPACE  try again");
    }
    return pick;
}
