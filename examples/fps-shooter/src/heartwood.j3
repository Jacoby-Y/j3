// Heartwood: a hungry treant in the forest. It stalks toward the player, then plants itself:
// root lines snake along the ground toward them, glowing brighter until they burst up as
// spikes (jump them or step aside), and it fires fans of wooden spikes. Four glowing growths
// sit on the bark over its chest; shooting one off breaks that bark plate away, and the heart
// behind takes more damage for every plate gone. In phase two it roots and fires at once.

module fps_shooter.heartwood;

use j3.math.{ Mat4, Vec3, TAU, clamp, cos, max, min, sin };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, SUB, addPart, box, bit, bulk, burst, clearParts, flat, flatDist, forward,
    frame, limb, root, rootsLive, smoke, spike, tilt, turn, walk, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const RISE: int = 0;
const ADVANCE: int = 1;
const PLANT: int = 2;
const ROOTED: int = 3;
const UPROOT: int = 4;
const FLINCH: int = 5;
const IDLE: int = 6;

const RISE_T: f32 = 2.2;
const ADVANCE_T: f32 = 2.5;
const ADVANCE_T2: f32 = 2.0;
const SPEED: f32 = 4.5;
const SPEED2: f32 = 5.5;
/// It stops walking this close.
const STOP: f32 = 9;
const PLANT_T: f32 = 0.7;
const UPROOT_T: f32 = 0.6;
const FLINCH_T: f32 = 1.0;
const ROOTS: int = 3;
const ROOTS2: int = 5;
const ROOT_SPREAD: f32 = 0.35;
const ROOT_SPEED: f32 = 18;
const ROOT_WIGGLE: f32 = 1.6;
const ROOT_DMG: f32 = 22;
/// Spike volleys while planted: how many, spikes in each, the fan's half-angle, the wind-up.
const VOLLEYS: int = 3;
const VOLLEYS2: int = 4;
const FAN: int = 5;
const FAN_HALF: f32 = 0.32;
const VOLLEY_GAP: f32 = 0.75;
const VOLLEY_TELL: f32 = 0.35;
const SPIKE_SPEED: f32 = 26;
const SPIKE_DMG: f32 = 11;
/// Growths: health as a share of the boss's, and the heart's damage per plate gone.
const GROWTH_HP: f32 = 0.045;
const HEART_BASE: f32 = 1.5;
const HEART_PER: f32 = 0.75;
const PLATES: int = 4;
const LEASH: f32 = 45;

fn sap(): Vec3 {
    return Vec3.xyz(0.9, 2.4, 0.35);
}

/// Where plate `i` sits on its chest, in the trunk's frame.
fn plateAt(i: int): Vec3 {
    let x: f32 = if i % 2 == 0 { -0.55 } else { 0.55 };
    let y: f32 = if i < 2 { 4.8 } else { 3.9 };
    return Vec3.xyz(x, y, -1.22);
}

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.aim = b.pos;
    b.pos = b.aim - Vec3.xyz(0, 8, 0);
    b.state = RISE;
    b.t = 0;
    b.len = RISE_T;
    b.intro = RISE_T;
    b.armor = PLATES;
    b.cycle = 0;
    let i = 0;
    while i < PLATES {
        bs.sub[i] = b.maxHp * GROWTH_HP;
        bs.subOn[i] = true;
        i += 1;
    }
}

fn to(b: &Boss, state: int, len: f32) {
    b.state = state;
    b.t = 0;
    b.len = len;
    b.step = 0;
}

/// Its trunk's frame: sunk a little while planted, swaying as it walks.
fn trunk(b: &Boss): Mat4 {
    let sink: f32 = 0;
    if b.state == ROOTED { sink = 0.3; }
    if b.state == PLANT { sink = 0.3 * clamp(b.t / b.len, 0, 1); }
    if b.state == UPROOT { sink = 0.3 * (1 - clamp(b.t / b.len, 0, 1)); }
    let sway = sin(b.anim * 2) * 0.05;
    let flinch: f32 = if b.state == FLINCH { 0.25 * sin(b.t * 3.1416 / b.len) } else { 0 };
    return frame(b.pos - Vec3.xyz(0, sink, 0), b.yaw).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), sway)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), flinch));
}

fn broken(bs: &Bosses): int {
    let n = 0;
    let i = 0;
    while i < PLATES { if !bs.subOn[i] { n += 1; } i += 1; }
    return n;
}

/// A growth shot off: its plate breaks away and the tree reels.
fn pops(bs: &Bosses) {
    let b = &bs.b;
    let i = 0;
    while i < PLATES {
        if bs.subOn[i] && bs.sub[i] <= 0 {
            bs.subOn[i] = false;
            b.armor -= 1;
            let at = trunk(b).transformPoint(plateAt(i));
            burst(bs, at, 20, 9, Vec3.xyz(0.4, 0.27, 0.16), Vec3.zero());
            burst(bs, at, 10, 6, Vec3.xyz(0.8, 1, 0.4), sap());
            sfx.at(sfx.SHATTER, at);
            sfx.at(sfx.ROAR, b.pos);
            if b.state != ROOTED { to(b, FLINCH, FLINCH_T); }
        }
        i += 1;
    }
}

/// Root lines out toward the player, fanned.
fn roots(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    let n = if b.phase2 { ROOTS2 } else { ROOTS };
    let off = flat(p.pos - b.pos);
    let far = off.length();
    let len = clamp(far + 8, 14, 38);
    let base = yawTo(b.pos, p.pos);
    let k = 0;
    while k < n {
        let a = base + (f32(k) - f32(n - 1) * 0.5) * ROOT_SPREAD;
        let d = forward(a);
        root(bs, flat(b.pos) + d * 1.8 + Vec3.xyz(0, b.pos.y, 0), d, len, ROOT_SPEED, ROOT_WIGGLE, ROOT_DMG);
        k += 1;
    }
    sfx.at(sfx.SLAM, b.pos);
}

/// A fan of spikes from its raised branches at the player.
fn volley(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    let from = trunk(b).transformPoint(Vec3.xyz(0, 6.6, -1.4));
    let aim = p.pos + Vec3.xyz(0, 0.9, 0) + p.vel * 0.25;
    let d = (aim - from).normalize();
    let side = Vec3.xyz(0 - d.z, 0, d.x).normalize();
    let k = 0;
    while k < FAN {
        let a = (f32(k) - f32(FAN - 1) * 0.5) / f32(FAN - 1) * 2 * FAN_HALF;
        let dir = (d * cos(a) + side * sin(a)).normalize();
        spike(bs, from + side * (f32(k) - 2) * 0.4, dir * SPIKE_SPEED + Vec3.xyz(0, 1.2, 0), SPIKE_DMG);
        k += 1;
    }
    sfx.at(sfx.BOW, from);
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    pops(bs);
    let heart = broken(bs);
    if b.state == RISE {
        let k = clamp(b.t / b.len, 0, 1);
        b.pos = b.aim - Vec3.xyz(0, 8 * (1 - k) * (1 - k), 0);
        if bs.fxRng.unit() < dt * 30 {
            burst(bs, b.aim + Vec3.xyz(0, 0.3, 0), 2, 7, Vec3.xyz(0.4, 0.3, 0.18), Vec3.zero());
        }
        if k >= 1 {
            b.pos = b.aim;
            sfx.at(sfx.ROAR, b.pos);
            to(b, ADVANCE, ADVANCE_T);
        }
    } else if b.state == ADVANCE || b.state == IDLE {
        let goal = flat(p.pos);
        if !b.engaged { goal = flat(b.home); }
        let off = goal - flat(b.pos);
        let far = off.length();
        let speed = if b.phase2 { SPEED2 } else { SPEED };
        let want = Vec3.zero();
        let stop: f32 = if b.engaged { STOP } else { 2 };
        if far > stop { want = off * (speed / far); }
        if flatDist(b.pos + want, b.home) > LEASH { want = flat(b.home - b.pos).normalize() * speed; }
        b.vel = b.vel + (want - b.vel) * min(dt * 3, 1);
        walk(bs, lvl, b.vel, 1.5, 1.4, dt);
        b.anim += b.vel.length() * dt * 0.6;
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2);
        if !b.engaged { b.state = IDLE; }
        else if b.state == IDLE { to(b, ADVANCE, ADVANCE_T); }
        else if b.t >= (if b.phase2 { ADVANCE_T2 } else { ADVANCE_T }) {
            b.vel = Vec3.zero();
            to(b, PLANT, PLANT_T);
            smoke(bs, b.pos, 8, 4, Vec3.xyz(0.45, 0.35, 0.25), Vec3.zero());
        }
    } else if b.state == PLANT {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2);
        if b.t >= b.len {
            to(b, ROOTED, 0);
            roots(bs, p);
            // Phase two fires straight away; phase one waits for the roots.
            b.cd = if b.phase2 { VOLLEY_TELL } else { 1.6 };
        }
    } else if b.state == ROOTED {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 1.2);
        b.cue = heart > 0;
        b.cd -= dt;
        let volleys = if b.phase2 { VOLLEYS2 } else { VOLLEYS };
        if b.step < volleys && b.cd <= 0 {
            volley(bs, p);
            b.step += 1;
            b.cd = VOLLEY_GAP;
        }
        if b.step >= volleys && b.cd <= 0.2 && rootsLive(bs) == 0 {
            b.cycle += 1;
            to(b, UPROOT, UPROOT_T);
            smoke(bs, b.pos, 6, 4, Vec3.xyz(0.45, 0.35, 0.25), Vec3.zero());
        }
    } else if b.state == UPROOT {
        if b.t >= b.len { to(b, ADVANCE, ADVANCE_T); }
    } else if b.state == FLINCH {
        if b.t >= b.len { to(b, ADVANCE, ADVANCE_T * 0.6); }
    }
    pose(bs, heart);
    bs.glowAt = trunk(b).transformPoint(Vec3.xyz(0, 4.3, -3));
    bs.glowColor = Vec3.xyz(1.5, 0.2, 0.25) * (0.1 + f32(heart) * 0.15);
    bs.glowR = 5 + f32(heart) * 1.5;
}

fn raised(b: &Boss): bool {
    return b.state == ROOTED && b.cd < VOLLEY_TELL && b.step < (if b.phase2 { VOLLEYS2 } else { VOLLEYS });
}

fn pose(bs: &Bosses, heart: int) {
    let b = &bs.b;
    clearParts(bs);
    let t = trunk(b);
    let i = 0;
    while i < PLATES {
        if bs.subOn[i] { addPart(bs, t.transformPoint(plateAt(i) + Vec3.xyz(0, 0, -0.3)), 0.45, 1, SUB + i); }
        i += 1;
    }
    let mult: f32 = if heart == 0 { 1 } else { HEART_BASE + HEART_PER * f32(heart) };
    addPart(bs, t.transformPoint(Vec3.xyz(0, 4.35, -1.0)), 0.75, mult, WEAK);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 4.3, 0)), 1.5, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 2.0, 0)), 1.3, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 7.4, 0.1)), 2.2, 1, BODY);
    bulk(bs, 1.6, b.pos.y, b.pos.y + 7);
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let bark = Vec3.xyz(0.42, 0.28, 0.17);
    let darkBark = Vec3.xyz(0.3, 0.2, 0.12);
    let leaf = Vec3.xyz(0.3, 0.6, 0.25);
    let leaf2 = Vec3.xyz(0.42, 0.72, 0.3);
    let black = Vec3.xyz(0.04, 0.03, 0.02);
    let t = trunk(b);
    let f = frame(b.pos, b.yaw);
    // Root legs stepping, or spread into the ground while planted.
    let planted = b.state == ROOTED || b.state == PLANT;
    let side: f32 = -1;
    while side < 2 {
        let step = sin(b.anim * 2 + side * 1.5708) * 0.7;
        let lift = max(sin(b.anim * 2 + side * 1.5708 + 1.5708), 0) * 0.5;
        if planted { step = 0; lift = 0; }
        let hip = t.transformPoint(Vec3.xyz(side * 0.8, 2.2, 0));
        let foot = f.transformPoint(Vec3.xyz(side * 1.1, lift, step));
        limb(bs, hip, foot, 1.0, 1.0, darkBark, Vec3.zero());
        side += 2;
    }
    if planted {
        let k = 0;
        while k < 6 {
            let a = f32(k) * TAU / 6 + 0.3;
            let out = f.transformPoint(Vec3.xyz(cos(a) * 3, 0.1, sin(a) * 3));
            limb(bs, f.transformPoint(Vec3.xyz(cos(a) * 0.8, 0.9, sin(a) * 0.8)), out, 0.45, 0.45, darkBark, Vec3.zero());
            k += 1;
        }
    }
    // Trunk, grooves, eyes and mouth.
    box(bs, t, Vec3.xyz(0, 4.3, 0), Vec3.xyz(2.6, 5.0, 2.2), bark, Vec3.zero());
    bit(bs, t, Vec3.xyz(-1.31, 4.0, 0.3), Vec3.xyz(0.06, 3.6, 0.25), darkBark, Vec3.zero());
    bit(bs, t, Vec3.xyz(1.31, 4.6, -0.3), Vec3.xyz(0.06, 3.0, 0.25), darkBark, Vec3.zero());
    bit(bs, t, Vec3.xyz(0.4, 4.3, 1.11), Vec3.xyz(0.25, 4.0, 0.06), darkBark, Vec3.zero());
    let eye = sap() * (1 + (if raised(b) { 1 } else { 0 }));
    bit(bs, t, Vec3.xyz(-0.5, 6.1, -1.12), Vec3.xyz(0.5, 0.18, 0.06), black, eye);
    bit(bs, t, Vec3.xyz(0.5, 6.1, -1.12), Vec3.xyz(0.5, 0.18, 0.06), black, eye);
    bit(bs, t, Vec3.xyz(0, 5.55, -1.12), Vec3.xyz(1.2, 0.3, 0.06), black, sap() * 0.5);
    // The heart, pulsing behind its plates; each plate carries a glowing growth.
    let beat = 0.6 + 0.4 * max(sin(b.t * 7), 0);
    bit(bs, t, Vec3.xyz(0, 4.35, -1.02), Vec3.xyz(0.95, 1.4, 0.3), Vec3.xyz(0.6, 0.1, 0.12), Vec3.xyz(2.6, 0.25, 0.3) * beat);
    let i = 0;
    while i < PLATES {
        if bs.subOn[i] {
            let at = plateAt(i);
            box(bs, t, at, Vec3.xyz(1.1, 0.95, 0.3), darkBark, Vec3.zero());
            let pulse = 0.8 + 0.3 * sin(b.t * 5 + f32(i));
            tilt(bs, t, at + Vec3.xyz(0, 0, -0.3), Vec3.xyz(0.5, 0.5, 0.5), 0.6, 0.6, Vec3.xyz(0.8, 1, 0.4), sap() * pulse);
        }
        i += 1;
    }
    // Branch arms: down at its sides walking, up and forward to fire.
    side = -1;
    while side < 2 {
        let shoulder = t.transformPoint(Vec3.xyz(side * 1.35, 6.0, 0));
        let hand = t.transformPoint(Vec3.xyz(side * 3.0, 3.8 + sin(b.anim * 2 + side) * 0.2, -0.8));
        if raised(b) || b.state == PLANT { hand = t.transformPoint(Vec3.xyz(side * 2.4, 7.4, -1.6)); }
        limb(bs, shoulder, hand, 0.6, 0.6, bark, Vec3.zero());
        let twig = 0;
        while twig < 3 {
            let tw = hand + t.transformPoint(Vec3.xyz(side * (0.3 + f32(twig) * 0.3), 0.6 - f32(twig) * 0.5, -0.4)) - t.transformPoint(Vec3.zero());
            limb(bs, hand, tw, 0.2, 0.2, darkBark, Vec3.zero());
            twig += 1;
        }
        side += 2;
    }
    // The crown.
    box(bs, t, Vec3.xyz(0, 7.5, 0.2), Vec3.xyz(5.0, 1.9, 4.6), leaf, Vec3.zero());
    box(bs, t, Vec3.xyz(0.3, 8.9, 0.1), Vec3.xyz(3.6, 1.4, 3.4), leaf2, Vec3.zero());
    box(bs, t, Vec3.xyz(-1.9, 7.9, -1.2), Vec3.xyz(1.8, 1.5, 1.8), leaf2, Vec3.zero());
    box(bs, t, Vec3.xyz(2.0, 7.2, 1.1), Vec3.xyz(1.6, 1.3, 1.6), leaf2, Vec3.zero());
    bit(bs, t, Vec3.xyz(-1.2, 8.5, -2.3), Vec3.xyz(0.35, 0.35, 0.35), Vec3.zero(), sap());
    bit(bs, t, Vec3.xyz(1.5, 7.6, -2.35), Vec3.xyz(0.3, 0.3, 0.3), Vec3.zero(), sap());
}
