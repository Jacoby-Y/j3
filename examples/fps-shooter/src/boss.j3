// Purple area shrines awaken each biome boss once per run. Defeat all nine to win.
// Awakened bosses stay in their own arenas; leaving a fight does not reset their health.

module fps_shooter.boss;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}
use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.gfx.{ Look, Ray };
use j3.math.{ Vec2, Vec3, TAU, atan2, clamp, cos, max, min, sin };
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.cstr;
use fps_shooter.biome;
use fps_shooter.challenge;
use fps_shooter.debug;
use fps_shooter.bosskit;
use fps_shooter.bosskit.{ Boss, Bosses, Hit, COLOSSUS, SAUCER, RIME, CINDER, HEARTWOOD, MARQUEE, FAULTJAW, RELIC, GEODE, STORMEEL, BULLFROG, BONEGOLEM, SCARECROW, KINDS, accent, flat, flatDist, groundTop, yawTo };
use fps_shooter.cinder;
use fps_shooter.faultjaw;
use fps_shooter.stormeel;
use fps_shooter.bullfrog;
use fps_shooter.bonegolem;
use fps_shooter.scarecrow;
use fps_shooter.relic;
use fps_shooter.geode;
use fps_shooter.colossus;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.heartwood;
use fps_shooter.level;
use fps_shooter.marquee;
use fps_shooter.level.{ Box, Level, next, scan, isOpen, tileAt, LAVA };
use fps_shooter.player;
use fps_shooter.player.Player;
use fps_shooter.rime;
use fps_shooter.saucer;
use fps_shooter.sfx;

/// A boss stays engaged throughout its own biome; distance hysteresis applies outside it.
const ENGAGE: f32 = 70;
const DISENGAGE: f32 = 95;
const DEATH_T: f32 = 2.4;
const BANNER_T: f32 = 4.5;
/// Health grows with the run's tier and with each boss already fought.
const TIER_HP: f32 = 0.08;
const FIGHT_HP: f32 = 0.14;
/// XP in the hoard.
const HOARD: int = 60;
const HUB: int = 4;
/// Boss Rush: seconds between bosses, and how many come (all nine, the Geode last).
const RUSH_GAP: f32 = 10;
const RUSH_BOSSES: int = 9;

pub fn create(mem: &Arena): Bosses {
    let bs = bosskit.create(mem);
    let i = 0;
    while i < KINDS {
        bs.squad[i].kind = 0;
        i += 1;
    }
    return bs;
}

pub fn upload(bs: &Bosses, mem: &Arena) {
    bosskit.upload(bs, mem);
}

/// A boss is up (alive or going down).
pub fn up(bs: &Bosses): bool {
    return bs.b.kind != 0;
}

/// The player is in a fight with it.
pub fn fighting(bs: &Bosses): bool {
    return bs.b.kind != 0 && bs.b.engaged && bs.b.dying <= 0;
}

/// A fresh run: no awakened bosses or completion bits.
pub fn reset(bs: &Bosses) {
    bs.b.kind = 0;
    bs.squadN = 0;
    bs.keepParts = false;
    bosskit.clearHazards(bs);
    bs.nparts = 0;
    bs.awakened = 0;
    bs.rewards = 0;
    bs.preview = 0;
    bs.debugPack = false;
    bs.beaten = 0;
    bs.fights = 0;
    bs.rushT = RUSH_GAP;
    bs.rushN = 0;
    bs.bannerT = 0;
    bs.enrageT = 0;
    bs.glowR = 0;
}

fn baseHp(kind: int): f32 {
    if kind == COLOSSUS { return 3600; }
    if kind == SAUCER { return 3000; }
    if kind == RIME { return 3800; }
    if kind == CINDER { return 4200; }
    if kind == HEARTWOOD { return 4000; }
    if kind == FAULTJAW { return 3900; }
    if kind == RELIC { return 3800; }
    if kind == GEODE { return 4000; }
    if kind == STORMEEL { return 4000; }
    if kind == BULLFROG { return 3900; }
    if kind == BONEGOLEM { return 4200; }
    if kind == SCARECROW { return 4400; }
    return 3600;
}

/// The boss a biome has; the Hub has none.
fn bossOf(biome: int): int {
    if biome == 1 { return COLOSSUS; }
    if biome == 8 { return SAUCER; }
    if biome == 0 { return RIME; }
    if biome == 2 { return CINDER; }
    if biome == 7 { return HEARTWOOD; }
    if biome == 5 { return MARQUEE; }
    if biome == 3 { return FAULTJAW; }
    if biome == 6 { return RELIC; }
    if biome == level.HOLLOWS { return GEODE; }
    if biome == 11 { return STORMEEL; }
    if biome == 12 { return BULLFROG; }
    if biome == 13 { return BONEGOLEM; }
    if biome == 14 { return SCARECROW; }
    return 0;
}

/// The biome this boss belongs to.
fn biomeOf(kind: int): int {
    if kind == COLOSSUS { return 1; }
    if kind == SAUCER { return 8; }
    if kind == RIME { return 0; }
    if kind == CINDER { return 2; }
    if kind == HEARTWOOD { return 7; }
    if kind == FAULTJAW { return 3; }
    if kind == RELIC { return 6; }
    if kind == GEODE { return level.HOLLOWS; }
    if kind == STORMEEL { return 11; }
    if kind == BULLFROG { return 12; }
    if kind == BONEGOLEM { return 13; }
    if kind == SCARECROW { return 14; }
    return 5;
}

/// The boss of the biome on slot `tile`.
pub fn kindAt(tile: int): int {
    return bossOf(level.biomeAt(tile));
}

/// The slot this boss's biome stands on this run; the Hub when the run leaves the biome out
/// (Boss Rush and the debug flags still fight it there).
fn tileOf(kind: int): int {
    let s = level.slotOf(biomeOf(kind));
    if s < 0 { return HUB; }
    return s;
}

/// Its biome is on this run's map.
fn inWorld(kind: int): bool {
    return level.slotOf(biomeOf(kind)) >= 0;
}

fn beaten(bs: &Bosses, kind: int): bool {
    return (bs.beaten / bitOf(kind)) % 2 == 1;
}

/// How many bosses this run's map has.
fn worldKinds(): int {
    let n = 0;
    let k = 1;
    while k <= KINDS {
        if inWorld(k) { n += 1; }
        k += 1;
    }
    return n;
}

fn bitOf(kind: int): int {
    return level.bit(kind);
}

pub fn defeated(bs: &Bosses): int {
    let n = 0;
    let k = 1;
    while k <= KINDS {
        if (bs.beaten / bitOf(k)) % 2 == 1 { n += 1; }
        k += 1;
    }
    return n;
}

/// The eight surface bosses (everything but the Geode) are down.
pub fn surfaceWon(bs: &Bosses): bool {
    let k = 1;
    while k <= KINDS {
        if k != GEODE && inWorld(k) && !beaten(bs, k) { return false; }
        k += 1;
    }
    return true;
}

/// Every boss on the map is down.
pub fn won(bs: &Bosses): bool { return surfaceWon(bs) && beaten(bs, GEODE); }

/// A destroyed area shrine summons its own boss exactly once, even during another fight.
pub fn awaken(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, tile: int) {
    let kind = kindAt(tile);
    if kind == 0 || !isOpen(lvl, tile) || (bs.awakened / bitOf(kind)) % 2 == 1 { return; }
    if bs.squadN >= KINDS { return; }
    if bs.squadN > 0 { stash(bs, bs.active); }
    bs.awakened += bitOf(kind);
    let slot = bs.squadN;
    bs.active = slot;
    spawn(bs, p, lvl, e, kind, tile);
    stash(bs, slot);
    bs.squadN += 1;
}

/// Endless mode: a Colossus lands beside the player, even mid-fight. It gives no reward.
pub fn endlessColossus(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies) {
    if bs.squadN >= KINDS { return; }
    // A lone boss (not yet in the squad) joins it first.
    if bs.squadN == 0 && bs.b.kind != 0 { bs.active = 0; stash(bs, 0); bs.squadN = 1; }
    else if bs.squadN > 0 { stash(bs, bs.active); }
    let slot = bs.squadN;
    bs.active = slot;
    spawn(bs, p, lvl, e, COLOSSUS, hereTile(p, lvl));
    let ang = e.rng.unit() * TAU;
    let home = Vec3.xyz(p.pos.x + cos(ang) * 16, 0, p.pos.z + sin(ang) * 16);
    let y = groundTop(lvl, home.x, home.z, 1.6, 40);
    if y < -50 { y = p.pos.y; }
    home.y = y;
    bs.b.home = home;
    bs.b.pos = home;
    bs.b.aim = home;
    bs.b.yaw = yawTo(home, p.pos);
    bs.b.engaged = true;
    bs.b.spare = true;
    beginKind(bs);
    stash(bs, slot);
    bs.squadN += 1;
}

/// The `n`th Boss Rush boss: the bosses of the biomes this run dealt, slot by slot, then the Geode.
fn rushKind(n: int): int {
    let seen = 0;
    let slot = 0;
    while slot < level.SLOTS {
        let k = kindAt(slot);
        if k != 0 {
            if seen == n { return k; }
            seen += 1;
        }
        slot += 1;
    }
    return GEODE;
}

/// Boss Rush: while no boss is up the intermission counts down, then the next comes down in its
/// own biome. The ninth, the Geode, fights in the Hollows; once it falls the run counts as won.
pub fn rush(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, dt: f32) {
    if bs.b.kind != 0 || bs.squadN > 0 { bs.rushT = RUSH_GAP; return; }
    bs.rushT -= dt;
    if bs.rushT > 0 { return; }
    if bs.rushN >= RUSH_BOSSES {
        let k = 1;
        while k <= KINDS {
            if inWorld(k) && (bs.beaten / bitOf(k)) % 2 == 0 { bs.beaten += bitOf(k); }
            k += 1;
        }
        return;
    }
    bs.rushT = RUSH_GAP;
    bs.active = 0;
    let kind = rushKind(bs.rushN);
    if kind == GEODE {
        // It sits in the Hollows: the player is set down at its arena.
        let at = Vec3.xyz(168, -60, -141);
        p.pos = at;
        p.vel = Vec3.zero();
        p.spawn = at;
        p.safe = at;
        spawn(bs, p, lvl, e, kind, level.HOLLOWS);
        bs.b.engaged = true;
    } else {
        // Every border open, and the player set down at that boss's own biome.
        lvl.open = 1023;
        level.setGates(lvl);
        standFor(p, lvl, kind);
        spawn(bs, p, lvl, e, kind, tileOf(kind));
    }
    bs.rushN += 1;
}

/// Where the next boss stands: the player's open tile, or the hub when that tile is locked.
fn hereTile(p: &Player, lvl: &Level): int {
    let t = if level.inHollows(p.pos) { level.HOLLOWS } else { tileAt(p.pos.x, p.pos.z) };
    if isOpen(lvl, t) { return t; }
    return HUB;
}

/// Standing room at x/z: a floor near y 0 that isn't lava, and nothing in the way above it.
fn roomAt(lvl: &Level, x: f32, z: f32): bool {
    let floor = false;
    let s = scan(lvl, Vec3.xyz(x - 0.8, 0, z - 0.8), Vec3.xyz(x + 0.8, 0, z + 0.8));
    let i = next(lvl, &s);
    while i >= 0 {
        let b = lvl.boxes[i];
        if x + 0.8 > b.lo.x && x - 0.8 < b.hi.x && z + 0.8 > b.lo.z && z - 0.8 < b.hi.z {
            if b.hi.y > 0.7 && b.lo.y < 5 { return false; }
            if b.hi.y > -0.4 && b.hi.y <= 0.7 {
                if b.kind == LAVA { return false; }
                floor = true;
            }
        }
        i = next(lvl, &s);
    }
    return floor;
}

/// How much standing room is within 16 m of x/z, on a 4 m lattice.
fn room(lvl: &Level, x: f32, z: f32): int {
    let n = 0;
    let i = -4;
    while i <= 4 {
        let j = -4;
        while j <= 4 {
            if i * i + j * j <= 16 && roomAt(lvl, x + f32(i) * 4, z + f32(j) * 4) { n += 1; }
            j += 1;
        }
        i += 1;
    }
    return n;
}

/// The arena for a boss in `tile`: the roomiest spot on a 12 m grid over the tile. The sky
/// isles have no ground, so the saucer's is the crown island.
fn arena(lvl: &Level, tile: int): Vec3 {
    if tile == level.HOLLOWS { return geode.home(lvl); }
    let mid = level.slotCenter(tile);
    let cx = mid.x;
    let cz = mid.z;
    if level.biomeAt(tile) == 8 { return Vec3.xyz(cx + 8, 21.5, cz + 26); }
    // The beach's boss lives in the middle of its sea.
    if level.biomeAt(tile) == 11 { return Vec3.xyz(cx, 0, cz + 25); }
    // The swamp's is the dry clearing in the middle.
    if level.biomeAt(tile) == 12 { return Vec3.xyz(cx, 0, cz); }
    // The graveyard's is the open ground before the tomb.
    if level.biomeAt(tile) == 13 { return Vec3.xyz(cx, 0, cz + 25); }
    // The farm's is the open yard between the barn and the silo.
    if level.biomeAt(tile) == 14 { return Vec3.xyz(cx, 0, cz); }
    let best = Vec3.xyz(cx, 0, cz);
    let bestN = -1;
    let i = -3;
    while i <= 3 {
        let j = -3;
        while j <= 3 {
            let x = cx + f32(i) * 12;
            let z = cz + f32(j) * 12;
            // Nearer the middle wins a tie.
            let n = room(lvl, x, z) * 10 - (if i < 0 { 0 - i } else { i }) - (if j < 0 { 0 - j } else { j });
            if n > bestN {
                bestN = n;
                best = Vec3.xyz(x, 0, z);
            }
            j += 1;
        }
        i += 1;
    }
    best.y = max(groundTop(lvl, best.x, best.z, 0.8, 1.2), 0);
    return best;
}

/// Where it first stands: 22 m from the player toward home when the player is at the arena,
/// else at home.
fn entry(lvl: &Level, home: Vec3, p: &Player, kind: int): Vec3 {
    if kind == GEODE { return home; }
    if kind == SAUCER { return home + Vec3.xyz(0, 14, 0); }
    if kind == STORMEEL { return home + Vec3.xyz(0, 14, 0); }
    if flatDist(p.pos, home) < 45 {
        let d = flat(home - p.pos);
        if d.length() < 1 { d = Vec3.xyz(0, 0, -1); }
        let at = flat(p.pos) + d.normalize() * 22;
        if roomAt(lvl, at.x, at.z) { return Vec3.xyz(at.x, max(groundTop(lvl, at.x, at.z, 0.8, 1.2), 0), at.z); }
    }
    return home;
}

fn beginKind(bs: &Bosses) {
    let k = bs.b.kind;
    if k == COLOSSUS { colossus.begin(bs); }
    if k == SAUCER { saucer.begin(bs); }
    if k == RIME { rime.begin(bs); }
    if k == CINDER { cinder.begin(bs); }
    if k == HEARTWOOD { heartwood.begin(bs); }
    if k == MARQUEE { marquee.begin(bs); }
    if k == FAULTJAW { faultjaw.begin(bs); }
    if k == RELIC { relic.begin(bs); }
    if k == GEODE { geode.begin(bs); }
    if k == STORMEEL { stormeel.begin(bs); }
    if k == BULLFROG { bullfrog.begin(bs); }
    if k == BONEGOLEM { bonegolem.begin(bs); }
    if k == SCARECROW { scarecrow.begin(bs); }
}

fn updateKind(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let k = bs.b.kind;
    if k == COLOSSUS { colossus.update(bs, p, lvl, dt); }
    if k == SAUCER { saucer.update(bs, p, lvl, dt); }
    if k == RIME { rime.update(bs, p, lvl, dt); }
    if k == CINDER { cinder.update(bs, p, lvl, dt); }
    if k == HEARTWOOD { heartwood.update(bs, p, lvl, dt); }
    if k == MARQUEE { marquee.update(bs, p, lvl, dt); }
    if k == FAULTJAW { faultjaw.update(bs, p, lvl, dt); }
    if k == RELIC { relic.update(bs, p, lvl, dt); }
    if k == GEODE { geode.update(bs, p, lvl, dt); }
    if k == STORMEEL { stormeel.update(bs, p, lvl, dt); }
    if k == BULLFROG { bullfrog.update(bs, p, lvl, dt); }
    if k == BONEGOLEM { bonegolem.update(bs, p, lvl, dt); }
    if k == SCARECROW { scarecrow.update(bs, p, lvl, dt); }
    bosskit.punish(bs, p, dt);
}

fn drawKind(bs: &Bosses) {
    let k = bs.b.kind;
    if k == COLOSSUS { colossus.draw(bs); }
    if k == SAUCER { saucer.draw(bs); }
    if k == RIME { rime.draw(bs); }
    if k == CINDER { cinder.draw(bs); }
    if k == HEARTWOOD { heartwood.draw(bs); }
    if k == MARQUEE { marquee.draw(bs); }
    if k == FAULTJAW { faultjaw.draw(bs); }
    if k == RELIC { relic.draw(bs); }
    if k == GEODE { geode.draw(bs); }
    if k == STORMEEL { stormeel.draw(bs); }
    if k == BULLFROG { bullfrog.draw(bs); }
    if k == BONEGOLEM { bonegolem.draw(bs); }
    if k == SCARECROW { scarecrow.draw(bs); }
}

/// Bring a boss of `kind` in `tile`.
fn spawn(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, kind: int, tile: int) {
    let home = arena(lvl, tile);
    let hp = baseHp(kind) * enemies.foeMul() * 0.72 * (1 + TIER_HP * f32(e.tier - 1) + FIGHT_HP * f32(bs.fights));
    let at = entry(lvl, home, p, kind);
    bs.b = Boss { kind: kind, tile: tile, home: home, pos: at, vel: Vec3.zero(), yaw: yawTo(at, p.pos), hp: hp, maxHp: hp,
        from: at, aim: at, dir: Vec3.xyz(0, 0, -1), engaged: flatDist(p.pos, home) < ENGAGE };
    let i = 0;
    while i < bosskit.MAX_SUBS {
        bs.sub[i] = 0;
        bs.subOn[i] = false;
        i += 1;
    }
    bs.fights += 1;
    bs.chip = 1;
    bs.bannerT = BANNER_T;
    beginKind(bs);
    sfx.play(sfx.HORN);
}

fn stash(bs: &Bosses, slot: int) {
    bs.squad[slot] = bs.b;
    let s = 0;
    while s < bosskit.MAX_SUBS {
        bs.subSave[slot * bosskit.MAX_SUBS + s] = bs.sub[s];
        bs.subOnSave[slot * bosskit.MAX_SUBS + s] = bs.subOn[s];
        s += 1;
    }
}

fn recall(bs: &Bosses, slot: int) {
    bs.b = bs.squad[slot];
    bs.active = slot;
    let s = 0;
    while s < bosskit.MAX_SUBS {
        bs.sub[s] = bs.subSave[slot * bosskit.MAX_SUBS + s];
        bs.subOn[s] = bs.subOnSave[slot * bosskit.MAX_SUBS + s];
        s += 1;
    }
}

/// `kinds` bosses in a ring around the player. Debug only.
fn spawnPack(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, kinds: []int, n: int) {
    lvl.open = 1023;
    level.setGates(lvl);
    let tile = hereTile(p, lvl);
    let i = 0;
    while i < n {
        bs.active = i;
        spawn(bs, p, lvl, e, kinds[i], tile);
        let ang = f32(i) * TAU / f32(n);
        let home = Vec3.xyz(p.pos.x + cos(ang) * 22, 0, p.pos.z + sin(ang) * 22);
        let y = groundTop(lvl, home.x, home.z, 1.6, 40);
        if y < -50 { y = p.pos.y; }
        home.y = y;
        bs.b.home = home;
        bs.b.pos = home;
        bs.b.aim = home;
        bs.b.yaw = yawTo(home, p.pos);
        bs.b.engaged = true;
        beginKind(bs);
        stash(bs, i);
        i += 1;
    }
    bs.squadN = n;
    bs.debugPack = true;
    bs.preview = 0;
    recall(bs, 0);
}

fn engage(b: &Boss, p: &Player) {
    if b.kind == GEODE || level.inHollows(p.pos) { b.engaged = b.kind == GEODE && level.inHollows(p.pos); return; }
    let away = min(flatDist(p.pos, b.home), flatDist(p.pos, b.pos));
    if tileAt(p.pos.x, p.pos.z) == b.tile || away < ENGAGE { b.engaged = true; }
    else if away > DISENGAGE { b.engaged = false; }
}

fn updatePack(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, dt: f32): bool {
    bs.keepParts = false;
    bs.nparts = 0;
    bs.bulkR = 0;
    let i = 0;
    let living = 0;
    let first = -1;
    let closest: f32 = 1000000;
    let calm = false;
    stash(bs, bs.active);
    while i < bs.squadN {
        if bs.squad[i].kind == 0 { i += 1; continue; }
        recall(bs, i);
        let b = &bs.b;
        b.flash -= dt;
        b.cue = false;
        engage(b, p);
        if bs.debugPack { b.engaged = true; }
        if b.engaged { calm = true; }
        b.intro = max(b.intro - dt, 0);
        if b.kind == GEODE { geode.shed(bs, e); }
        if b.dying > 0 {
            b.dying -= dt;
            if b.dying <= 0 {
                finale(bs, p, e);
                if !b.spare { bs.rewards += 1; }
            } else { dyingFx(bs); }
        } else if b.hp <= 0 {
            b.hp = 0;
            b.dying = DEATH_T;
            b.open = 0;
            sfx.at(sfx.ROAR, b.pos);
        } else {
            if !b.phase2 && b.hp < b.maxHp * 0.5 {
                b.phase2 = true;
                sfx.at(sfx.ROAR, b.pos);
            }
            updateKind(bs, p, lvl, dt);
            if b.pos.y < (if b.kind == GEODE { -68 } else { -40 }) { b.pos = b.home; }
        }
        if b.kind != 0 {
            living += 1;
            let far = (p.pos - b.pos).length();
            if far < closest { first = i; closest = far; }
        }
        stash(bs, i);
        bs.keepParts = true;
        i += 1;
    }
    if first >= 0 { recall(bs, first); }
    bs.bulkR = 0;
    bosskit.hazards(bs, p, lvl, dt);
    e.calm = calm;
    if living == 0 {
        bs.squadN = 0;
        bs.keepParts = false;
        bosskit.clearHazards(bs);
        bs.b.kind = 0;
        bs.nparts = 0;
        return takeReward(bs);
    }
    recall(bs, first);
    let frac = bs.b.hp / bs.b.maxHp;
    bs.chipT -= dt;
    if bs.chip < frac { bs.chip = frac; }
    if bs.chipT <= 0 { bs.chip = max(frac, bs.chip - dt * 0.5); }
    if bs.watch { watch(bs, p); }
    return takeReward(bs);
}

fn takeReward(bs: &Bosses): bool {
    if bs.rewards == 0 { return false; }
    bs.rewards -= 1;
    return true;
}

/// The fight's frame: the boss's own update and its hazards. True once a boss has
/// fallen and its reward should be offered.
pub fn update(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, dt: f32): bool {
    bs.bannerT -= dt;
    bs.enrageT -= dt;
    if bs.squadN > 0 { return updatePack(bs, p, lvl, e, dt); }
    let b = &bs.b;
    if b.kind == 0 {
        if bs.preview > 0 && bs.fights == 0 {
            spawn(bs, p, lvl, e, bs.preview, tileOf(bs.preview));
        }
        bosskit.hazards(bs, p, lvl, dt);
        e.calm = false;
        return takeReward(bs);
    }
    engage(b, p);
    e.calm = fighting(bs);
    b.intro = max(b.intro - dt, 0);
    b.flash -= dt;
    b.cue = false;
    if b.kind == GEODE { geode.shed(bs, e); }
    if b.dying > 0 {
        b.dying -= dt;
        dyingFx(bs);
        bosskit.hazards(bs, p, lvl, dt);
        if b.dying <= 0 {
            finale(bs, p, e);
            return true;
        }
        return false;
    }
    if b.hp <= 0 {
        b.hp = 0;
        b.dying = DEATH_T;
        b.open = 0;
        bosskit.clearHazards(bs);
        sfx.at(sfx.ROAR, b.pos);
        return false;
    }
    if !b.phase2 && b.hp < b.maxHp * 0.5 {
        b.phase2 = true;
        bs.enrageT = 2.5;
        sfx.at(sfx.ROAR, b.pos);
    }
    updateKind(bs, p, lvl, dt);
    bosskit.hazards(bs, p, lvl, dt);
    let frac = b.hp / b.maxHp;
    bs.chipT -= dt;
    if bs.chip < frac { bs.chip = frac; }
    if bs.chipT <= 0 { bs.chip = max(frac, bs.chip - dt * 0.5); }
    // Lost in a pit: back home.
    if b.pos.y < (if b.kind == GEODE { -68 } else { -40 }) { b.pos = b.home; }
    if bs.watch { watch(bs, p); }
    return false;
}

/// Screenshot mode: look at the boss, and don't die.
fn watch(bs: &Bosses, p: &Player) {
    let eye = p.pos + Vec3.xyz(0, 1.6, 0);
    let d = middle(bs) - eye;
    p.yaw = atan2(d.x, 0 - d.z);
    p.pitch = atan2(d.y, flat(d).length());
    p.hp = 100;
}

/// Going down: shaking, smoking, bursting.
fn dyingFx(bs: &Bosses) {
    let b = &bs.b;
    b.flash = if sin(b.dying * 30) > 0.3 { 0.05 } else { 0 };
    if bs.fxRng.unit() < 0.35 && bs.nparts > 0 {
        let q = bs.parts[bs.fxRng.intRange(0, bs.nparts)];
        let at = q.at + Vec3.xyz(bs.fxRng.unit() - 0.5, bs.fxRng.unit() - 0.5, bs.fxRng.unit() - 0.5) * (q.r * 1.5);
        bosskit.burst(bs, at, 8, 7, accent(b.kind), accent(b.kind) * 1.5);
        bosskit.smoke(bs, at, 2, 1, Vec3.xyz(0.3, 0.3, 0.32), Vec3.zero());
        if bs.fxRng.unit() < 0.4 { sfx.at(sfx.BOOM, at); }
    }
    bs.shake = max(bs.shake, 0.012);
}

/// The last blast, the hoard, and the run's record of it.
fn finale(bs: &Bosses, p: &Player, e: &Enemies) {
    let b = &bs.b;
    let mid = b.pos + Vec3.xyz(0, 2.5, 0);
    if b.kind == SAUCER { mid = b.pos; }
    bosskit.burst(bs, mid, 60, 16, accent(b.kind), accent(b.kind) * 2);
    bosskit.burst(bs, mid, 30, 10, Vec3.xyz(1, 1, 0.8), Vec3.xyz(2, 2, 1.5));
    bosskit.smoke(bs, mid, 14, 5, Vec3.xyz(0.35, 0.35, 0.38), Vec3.zero());
    sfx.at(sfx.BOOM, mid);
    sfx.play(sfx.UNLOCK);
    bs.shake = max(bs.shake, 0.06);
    // The saucer's over the void as often as not: its hoard rains down on the player instead.
    let drop = mid;
    if b.kind == MARQUEE { drop = Vec3.xyz(b.pos.x, b.home.y + 2, b.pos.z); }
    if b.kind == SAUCER { drop = p.pos + Vec3.xyz(0, 3, 0); }
    if !challenge.on(challenge.RUSH) { enemies.reward(e, drop, HOARD); }
    if (bs.beaten / bitOf(b.kind)) % 2 == 0 { bs.beaten += bitOf(b.kind); }
    b.kind = 0;
    if bs.squadN == 0 { bs.nparts = 0; }
    bs.glowR = 0;
}

// ---- What the weapons use ----

/// The boss part along `r` closer than `reach`, if any.
pub fn ray(bs: &Bosses, r: Ray, reach: f32): Hit {
    return bosskit.ray(bs, r, reach);
}

/// Part `part` takes `dmg` at `at`. Counts as a hit for the combo.
pub fn damage(bs: &Bosses, e: &Enemies, part: int, dmg: f32, at: Vec3) {
    if bs.squadN > 0 && part >= 0 && part < bs.nparts {
        let who = bs.partBoss[part];
        let back = bs.active;
        if who != back && who >= 0 && who < bs.squadN {
            stash(bs, back);
            recall(bs, who);
            let struck = bosskit.wound(bs, part, dmg, at);
            stash(bs, who);
            recall(bs, back);
            if struck > 0 {
                e.hits += 1;
                e.hitT = 0.12;
                enemies.number(e, 1000 + part, at, struck, false);
            }
            return;
        }
    }
    let dealt = bosskit.wound(bs, part, dmg, at);
    if dealt > 0 {
        e.hits += 1;
        e.hitT = 0.12;
        enemies.number(e, 1000 + part, at, dealt, false);
    }
}

/// An explosion at `at`: the part nearest it takes `dmg`, less toward the edge of `radius`.
pub fn blast(bs: &Bosses, e: &Enemies, at: Vec3, radius: f32, dmg: f32) {
    let i = bosskit.nearest(bs, at, radius);
    if i < 0 { return; }
    let q = bs.parts[i];
    let far = max((q.at - at).length() - q.r, 0);
    damage(bs, e, i, dmg * (1 - far / radius * 0.6), q.at + (at - q.at).normalize() * q.r);
}

/// A part within `reach` of `at` in front of `dir` (a knife swing), or -1.
pub fn near(bs: &Bosses, at: Vec3, dir: Vec3, reach: f32): int {
    let i = bosskit.nearest(bs, at, reach);
    if i < 0 { return -1; }
    let to = bs.parts[i].at - at;
    if to.length() > bs.parts[i].r && to.normalize().dot(dir) < 0.2 { return -1; }
    return i;
}

/// Whether homing shots and helpers can go for it, and where to.
pub fn targetable(bs: &Bosses): bool {
    return bs.b.kind != 0 && bs.b.dying <= 0 && bs.nparts > 0;
}

pub fn aimPoint(bs: &Bosses): Vec3 {
    return bosskit.aimPoint(bs);
}

/// The middle of the boss, for distance checks.
pub fn middle(bs: &Bosses): Vec3 {
    if bs.nparts > 0 { return bs.parts[0].at; }
    return bs.b.pos;
}

// ---- Drawing ----

/// Before either pass: the boss's boxes and every hazard.
fn drawOne(bs: &Bosses) {
    if bs.b.kind == 0 { return; }
    bosskit.refreshEdge(bs);
    let b = &bs.b;
    let sink: f32 = 0;
    if b.dying > 0 && b.kind != SAUCER { sink = (1 - b.dying / DEATH_T) * 1.2; }
    b.pos.y -= sink;
    drawKind(bs);
    b.pos.y += sink;
}

pub fn prepare(bs: &Bosses) {
    bosskit.begin(bs);
    if bs.squadN > 0 {
        stash(bs, bs.active);
        let focus = bs.active;
        bs.keepParts = false;
        let i = 0;
        while i < bs.squadN {
            recall(bs, i);
            drawOne(bs);
            stash(bs, i);
            bs.keepParts = true;
            i += 1;
        }
        recall(bs, focus);
    } else { drawOne(bs); }
    bosskit.drawHazards(bs);
}

pub fn draw(bs: &Bosses) {
    bosskit.draw(bs);
}

pub fn drawBlended(bs: &Bosses) {
    bosskit.drawBlended(bs);
}

/// Its light (slot 6), before the camera pass.
pub fn lights(bs: &Bosses) {
    if bs.b.kind == 0 || bs.glowR <= 0 {
        gfx.light(6, Vec3.zero(), Vec3.zero(), 0);
        return;
    }
    gfx.light(6, bs.glowAt, bs.glowColor, bs.glowR);
}

// ---- Hud ----

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

fn tone(c: Vec3, a: f32) {
    game.setColor(game.rgba(u8(clamp(c.x, 0, 1) * 255), u8(clamp(c.y, 0, 1) * 255), u8(clamp(c.z, 0, 1) * 255), u8(clamp(a, 0, 1) * 255)));
}

fn centered(font: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(font, msg);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

/// Shadowed text centred on `cx`.
fn shout(font: Font, cx: f32, y: f32, msg: string, c: Vec3, a: f32) {
    let t = game.textSize(font, msg);
    tone(Vec3.xyz(0.04, 0.04, 0.08), a * 0.7);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5 + 2, y: y + 2 }, msg);
    tone(c, a);
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

fn weakHint(kind: int): string {
    if kind == COLOSSUS { return "SHOOT THE FURNACE MOUTH"; }
    if kind == SAUCER { return "REACTOR EXPOSED"; }
    if kind == RIME { return "CORE EXPOSED"; }
    if kind == CINDER { return "VENTS OPEN"; }
    if kind == HEARTWOOD { return "HEART EXPOSED"; }
    if kind == FAULTJAW { return "SHOOT THE GLOWING SEGMENTS"; }
    if kind == RELIC { return "CORE EXPOSED"; }
    if kind == GEODE { return "CRYSTAL CORE EXPOSED"; }
    if kind == STORMEEL { return "SHOOT THE GLOWING SEGMENTS"; }
    if kind == BULLFROG { return "SHOOT THE THROAT"; }
    if kind == BONEGOLEM { return "SOUL CORE EXPOSED"; }
    if kind == SCARECROW { return "CORN HEART EXPOSED"; }
    return "HEAD LOWERED";
}

/// The boss bar across the top, its entrance and phase banners, a weak-point marker at the
/// crosshair, and a pointer to it when it's away.
pub fn hud(bs: &Bosses, p: &Player, font: Font, big: Font) {
    let b = bs.b;
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    tone(Vec3.xyz(0.85, 0.9, 1), 0.95);
    let total = worldKinds();
    game.drawText(font, Vec2 { x: 22, y: 280 }, `BOSSES  {defeated(bs)} / {total}`);
    if b.kind == 0 { return; }
    let c = accent(b.kind);
    if bs.bannerT > 0 {
        let a = clamp(bs.bannerT / 0.8, 0, 1) * clamp((BANNER_T - bs.bannerT) / 0.3, 0, 1);
        let y = sz.y * 0.3;
        shout(font, cx, y - 26, "A BOSS APPROACHES", Vec3.xyz(0.9, 0.9, 0.95), a);
        shout(big, cx, y, bosskit.name(b.kind), c, a);
        shout(font, cx, y + 50, bosskit.title(b.kind), Vec3.xyz(0.85, 0.85, 0.9), a);
        if !b.engaged { shout(font, cx, y + 74, `IN {biome.name(b.tile)}`, Vec3.xyz(1, 0.85, 0.4), a); }
    }
    if bs.enrageT > 0 && b.dying <= 0 {
        let fade = clamp(bs.enrageT / 0.6, 0, 1);
        shout(big, cx, sz.y * 0.36, "ENRAGED", Vec3.xyz(1, 0.25, 0.2), fade);
    }
    // The bar, with a notch at the phase-two half and the recent damage trailing in white.
    let w = min(sz.x * 0.5, 640);
    let x = cx - w * 0.5;
    let top: f32 = 88;
    let frac = clamp(b.hp / b.maxHp, 0, 1);
    tone(Vec3.xyz(0.08, 0.09, 0.14), 0.75);
    rect(x - 4, top - 4, w + 8, 22);
    tone(Vec3.xyz(1, 1, 1), 0.85);
    rect(x, top, w * bs.chip, 14);
    let fill = c;
    if b.phase2 { fill = Vec3.xyz(1, 0.25 + 0.1 * sin(bs.clock * 6), 0.2); }
    tone(fill, 1);
    rect(x, top, w * frac, 14);
    tone(Vec3.xyz(0.05, 0.05, 0.08), 0.9);
    rect(x + w * 0.5 - 1, top - 2, 2, 18);
    shout(font, cx, top - 26, bosskit.name(b.kind), c, 1);
    if b.cue {
        let pulse = 0.65 + 0.35 * sin(bs.clock * 10);
        shout(font, cx, top + 22, weakHint(b.kind), Vec3.xyz(1, 0.85, 0.3), pulse);
    }
    // Away from it: a pointer on a ring round the crosshair, and how far.
    let far = (p.pos - b.pos).length();
    if far > 30 {
        let view = Look.create(p.pos, p.yaw, 0);
        let d = b.pos - p.pos;
        let fwd = view.forward();
        let side = view.right();
        let ang = atan2(d.x * side.x + d.z * side.z, d.x * fwd.x + d.z * fwd.z);
        let ring: f32 = 118;
        let px = cx + sin(ang) * ring;
        let py = sz.y * 0.5 - cos(ang) * ring;
        let k = 0;
        while k < 4 {
            let rr = ring + f32(k) * 6;
            let half = 7 - f32(k) * 1.5;
            tone(Vec3.xyz(0.04, 0.04, 0.08), 0.6);
            rect(cx + sin(ang) * rr - half - 1.5, sz.y * 0.5 - cos(ang) * rr - half - 1.5, half * 2 + 3, half * 2 + 3);
            tone(c, 0.95);
            rect(cx + sin(ang) * rr - half, sz.y * 0.5 - cos(ang) * rr - half, half * 2, half * 2);
            k += 1;
        }
        tone(c, 0.95);
        centered(font, px, py + 14, `{int(far)} m`);
        shout(font, cx + w * 0.5 + 60, top - 3, `{int(far)} m`, c, 0.9);
    }
    // A weak-point hit: a bigger gold marker.
    if bs.critT > 0 {
        tone(Vec3.xyz(1, 0.7, 0.15), clamp(bs.critT / 0.15, 0, 1));
        let n = 0;
        while n < 5 {
            let dd = 10 + f32(n) * 2.5;
            let my = sz.y * 0.5;
            rect(cx - dd - 2, my - dd - 2, 4, 4);
            rect(cx + dd - 2, my - dd - 2, 4, 4);
            rect(cx - dd - 2, my + dd - 2, 4, 4);
            rect(cx + dd - 2, my + dd - 2, 4, 4);
            n += 1;
        }
    }
}

/// The performance harness: the boss of the tile the route is in (Colossus where there's none),
/// fighting the player there. A new tile brings its own, entrance and all.
pub fn benchmark(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, dt: f32) {
    let tile = tileAt(p.pos.x, p.pos.z);
    let kind = kindAt(tile);
    if kind == 0 { kind = COLOSSUS; }
    if bs.b.kind != kind || bs.b.tile != tile {
        bosskit.clearHazards(bs);
        bs.b.kind = 0;
        spawn(bs, p, lvl, e, kind, tile);
    }
    // Health never runs out, and it never waits at home.
    bs.b.hp = bs.b.maxHp * 0.6;
    bs.b.engaged = true;
    updateKind(bs, p, lvl, dt);
    bosskit.hazards(bs, p, lvl, dt);
    if bs.b.phase2 == false { bs.b.phase2 = true; }
}

// ---- Preview ----

fn env(name: string): string {
    let raw = libc.getenv(cstr(name));
    if raw == 0 { return ""; }
    return []u8 { ptr: raw as &u8, len: libc.strlen(raw) } as string;
}

fn same(a: string, b: string): bool {
    if a.len != b.len { return false; }
    let i = 0;
    while i < a.len { if a[i] != b[i] { return false; } i += 1; }
    return true;
}

/// A boss kind named by `s` (its name in lower case, or 1-9), or 0.
pub fn kindNamed(s: string): int {
    if same(s, "colossus") || same(s, "1") { return COLOSSUS; }
    if same(s, "saucer") || same(s, "2") { return SAUCER; }
    if same(s, "rime") || same(s, "3") { return RIME; }
    if same(s, "cinder") || same(s, "4") { return CINDER; }
    if same(s, "heartwood") || same(s, "5") { return HEARTWOOD; }
    if same(s, "marquee") || same(s, "6") { return MARQUEE; }
    if same(s, "faultjaw") || same(s, "7") { return FAULTJAW; }
    if same(s, "relic") || same(s, "8") { return RELIC; }
    if same(s, "geode") || same(s, "9") { return GEODE; }
    if same(s, "stormeel") || same(s, "eel") || same(s, "10") { return STORMEEL; }
    if same(s, "bullfrog") || same(s, "frog") || same(s, "11") { return BULLFROG; }
    if same(s, "bonegolem") || same(s, "golem") || same(s, "12") { return BONEGOLEM; }
    if same(s, "scarecrow") || same(s, "13") { return SCARECROW; }
    return 0;
}

fn placeSingle(bs: &Bosses, p: &Player, lvl: &Level, kind: int) {
    bs.preview = kind;
    lvl.open = 1023;
    level.setGates(lvl);
    standFor(p, lvl, kind);
}

/// Stand the player at `kind`'s arena, facing it.
fn standFor(p: &Player, lvl: &Level, kind: int) {
    let home = arena(lvl, tileOf(kind));
    let at = home + Vec3.xyz(3, 0, 3);
    if kind != SAUCER && kind != GEODE && kind != STORMEEL {
        // The roomiest of eight spots 22 m out.
        let bestN = -1;
        let k = 0;
        while k < 8 {
            let a = f32(k) * 0.785;
            let x = home.x + sin(a) * 22;
            let z = home.z + cos(a) * 22;
            let n = room(lvl, x, z);
            if roomAt(lvl, x, z) && n > bestN {
                bestN = n;
                at = Vec3.xyz(x, max(groundTop(lvl, x, z, 0.3, 1.2), 0), z);
            }
            k += 1;
        }
    }
    if kind == GEODE { at = Vec3.xyz(168, -60, -141); }
    // On the sand north of its sea.
    if kind == STORMEEL { at = Vec3.xyz(home.x, 0, home.z - 49); }
    p.pos = at;
    p.spawn = at;
    p.safe = at;
    p.yaw = atan2(home.x - at.x, 0 - (home.z - at.z));
    p.spawnYaw = p.yaw;
}

/// `bosses` (several names) spawns that pack around the player. One name, or `boss`, stands
/// the player at that arena the way `J3_FPS_BOSS` does. A set string wins over the env var.
pub fn preview(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies, mem: &Arena, bosses: string, bossName: string, watch: string) {
    bs.watch = same(debug.pick(watch, env("J3_FPS_BOSS_WATCH")), "1");
    if bosses.len > 0 {
        let kinds = mem.alloc::<int>(KINDS);
        let n = 0;
        let at = 0;
        while n < KINDS && at < bosses.len {
            let bit = debug.piece(mem, bosses, at);
            at = bit.next;
            if bit.name.len == 0 { break; }
            let k = kindNamed(bit.name);
            if k != 0 {
                kinds[n] = k;
                n += 1;
            }
        }
        if n > 1 {
            spawnPack(bs, p, lvl, e, kinds, n);
            return;
        }
        if n == 1 {
            placeSingle(bs, p, lvl, kinds[0]);
            return;
        }
    }
    let kind = kindNamed(debug.pick(bossName, env("J3_FPS_BOSS")));
    if kind == 0 { return; }
    placeSingle(bs, p, lvl, kind);
}

// ---- Checks ----

/// A flat test floor: time never summons a boss; a preview landing marks and hurts, its wave can be
/// jumped, its mouth is the weak point only while open, and its death clears the hazards and
/// asks for the reward.
pub fn selfCheck(mem: &Arena) {
    offenseCheck(mem, FAULTJAW);
    offenseCheck(mem, RELIC);
    rockCheck(mem);
    wormRangeCheck(mem);
    let lvl = level.empty(mem, 1, 0);
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(0 - level.HALF, -1, 0 - level.HALF), hi: Vec3.xyz(level.HALF, 0, level.HALF), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    let p = player.create(&lvl);
    p.pos = Vec3.xyz(0, 0, 20);
    p.onGround = true;
    let e = enemies.create(mem);
    let bs = create(mem);
    e.time = 100000;
    e.restT = 0;
    update(&bs, &p, &lvl, &e, 0.016);
    if up(&bs) { panic("boss check: timed spawn still active"); }
    bs.preview = COLOSSUS;
    update(&bs, &p, &lvl, &e, 0.016);
    if bs.b.kind != COLOSSUS { panic("boss check: no preview colossus"); }
    if bs.b.tile != 1 || kindAt(HUB) != 0 { panic("boss check: hub assigned a boss"); }
    let marked = false;
    let m = 0;
    while m < bs.marks.len { if bs.marks[m].live { marked = true; } m += 1; }
    if !marked { panic("boss check: entrance landing unmarked"); }
    // Stand on the landing spot: the drop hurts.
    p.pos = bs.b.aim;
    p.hp = 100;
    p.hurtT = 10;
    let t = 0;
    while t < 200 && bs.b.intro > 0 {
        update(&bs, &p, &lvl, &e, 0.016);
        p.pos = bs.b.aim;
        t += 1;
    }
    update(&bs, &p, &lvl, &e, 0.016);
    if p.hp >= 100 { panic("boss check: landing didn't hurt"); }
    // The wave: jumping over it is safe, standing in it is not.
    let w = 0;
    while w < bs.waves.len && !bs.waves[w].live { w += 1; }
    if w == bs.waves.len { panic("boss check: no shockwave"); }
    let mid = bs.waves[w].at;
    p.pos = mid + Vec3.xyz(0, 1.5, 12);
    p.hp = 100;
    p.hurtT = 10;
    t = 0;
    while t < 80 { bosskit.hazards(&bs, &p, &lvl, 0.016); p.pos = mid + Vec3.xyz(0, 1.5, 12); t += 1; }
    if p.hp < 100 { panic("boss check: jumped wave still hit"); }
    bosskit.wave(&bs, mid, 17, 38, 0.9, 22, Vec3.xyz(1, 0, 0));
    p.pos = mid + Vec3.xyz(0, 0, 12);
    t = 0;
    while t < 80 { bosskit.hazards(&bs, &p, &lvl, 0.016); p.pos = mid + Vec3.xyz(0, 0, 12); t += 1; }
    if p.hp >= 100 { panic("boss check: standing in the wave was safe"); }
    // The mouth: plain while shut, heavy while open.
    bs.b.intro = 0;
    bs.b.open = 0;
    bs.b.openTo = 0;
    colossus.update(&bs, &p, &lvl, 0.001);
    if bs.parts[0].mult > 1.01 { panic("boss check: closed mouth is weak"); }
    bs.b.openTo = 1;
    bs.b.open = 1;
    colossus.update(&bs, &p, &lvl, 0.001);
    let before = bs.b.hp;
    damage(&bs, &e, 0, 10, bs.parts[0].at);
    if before - bs.b.hp < 30 { panic("boss check: open mouth isn't weak"); }
    // Standing on it: the next hop goes sideways, not straight up and down.
    bs.b.engaged = true;
    bs.b.state = colossus.CROUCH;
    bs.b.len = 0.01;
    bs.b.t = 0.02;
    bs.b.step = 0;
    p.pos = bs.b.pos + Vec3.xyz(1, 0, 0);
    let feet = bs.b.pos;
    colossus.update(&bs, &p, &lvl, 0.02);
    if flatDist(bs.b.aim, feet) < 2 { panic("boss check: hop in place"); }
    // Shots at it from in front hit it.
    let front = bs.parts[1].at + bosskit.forward(bs.b.yaw) * 20;
    let hit = ray(&bs, Ray { origin: front, dir: (bs.parts[1].at - front).normalize() }, 100);
    if hit.part < 0 { panic("boss check: ray missed"); }
    // Death: hazards gone, reward asked for once the fall is over.
    bosskit.wave(&bs, mid, 17, 38, 0.9, 22, Vec3.xyz(1, 0, 0));
    bs.b.hp = 1;
    damage(&bs, &e, 1, 1000, bs.parts[1].at);
    update(&bs, &p, &lvl, &e, 0.016);
    let any = false;
    w = 0;
    while w < bs.waves.len { if bs.waves[w].live { any = true; } w += 1; }
    if any || bs.b.dying <= 0 { panic("boss check: death didn't clear hazards"); }
    let rewarded = false;
    t = 0;
    while t < 400 && !rewarded { rewarded = update(&bs, &p, &lvl, &e, 0.016); t += 1; }
    if !rewarded || up(&bs) { panic("boss check: no reward"); }
    if (bs.beaten / bitOf(COLOSSUS)) % 2 != 1 { panic("boss check: not marked beaten"); }
    let kind = COLOSSUS;
    while kind < GEODE {
        soak(mem, &lvl, kind);
        kind += 1;
    }
}

/// Rime leaps and the landing opens its core: a shard goes, and it's down.
fn bait(bs: &Bosses, p: &Player, lvl: &Level, e: &Enemies) {
    let b = &bs.b;
    if b.armor < 1 { b.armor = 1; }
    let shards = b.armor;
    p.pos = Vec3.xyz(b.pos.x + 20, b.pos.y, b.pos.z);
    p.vel = Vec3.zero();
    bosskit.clearHazards(bs);
    bosskit.chunk(bs, Vec3.xyz(b.pos.x + 10, b.pos.y, b.pos.z), 1.1, 2.4, 11);
    // Skating, then a short leap whose landing opens the core.
    b.state = rime.LEAPING;
    b.from = b.pos;
    b.aim = b.pos;
    b.t = 0;
    b.len = 0.05;
    let down = false;
    let t = 0;
    while t < 400 && !down {
        p.hp = 100;
        update(bs, p, lvl, e, 0.016);
        p.pos = Vec3.xyz(b.pos.x + 20, b.pos.y, b.pos.z);
        if b.cue { down = true; }
        t += 1;
    }
    if !down { panic("boss check: rime baited into its ice didn't fall"); }
    if b.armor != shards - 1 { panic("boss check: rime's shard didn't break"); }
}

/// A minute against each boss with the player circling its arena, then the same at half
/// health: it must attack, open its weak point, stay by its arena, and fall to enough damage.
fn soak(mem: &Arena, lvl: &Level, kind: int) {
    let p = player.create(lvl);
    let e = enemies.create(mem);
    let bs = create(mem);
    lvl.open = 1023;
    bs.preview = kind;
    e.restT = 0;
    update(&bs, &p, lvl, &e, 0.016);
    if bs.b.kind != kind { panic("boss check: preview kind"); }
    let home = bs.b.home;
    let hazards = 0;
    let cues = 0;
    let t = 0;
    while t < 7200 {
        let a = f32(t) * 0.016 * 0.55;
        p.pos = Vec3.xyz(home.x + cos(a) * 14, 0, home.z + sin(a) * 14);
        p.vel = Vec3.xyz(0 - sin(a), 0, cos(a)) * 7.7;
        p.onGround = true;
        p.hp = 100;
        p.hurtT += 0.016;
        if t == 3600 { bs.b.hp = bs.b.maxHp * 0.45; }
        // Chip at a random part now and then, as a player shooting would: growths and knee
        // lights break, which some weak points need.
        if t % 20 == 0 && bs.nparts > 0 && bs.b.intro <= 0 {
            let q = bs.rng.intRange(0, bs.nparts);
            damage(&bs, &e, q, 5, bs.parts[q].at);
        }
        // Keep the endurance phase alive even after destructible armor is gone.
        bs.b.hp = max(bs.b.hp, bs.b.maxHp * 0.25);
        update(&bs, &p, lvl, &e, 0.016);
        if bs.b.cue { cues += 1; }
        let i = 0;
        while i < bs.marks.len { if bs.marks[i].live { hazards += 1; } i += 1; }
        i = 0;
        while i < bs.waves.len { if bs.waves[i].live { hazards += 1; } i += 1; }
        i = 0;
        while i < bs.projs.len { if bs.projs[i].live { hazards += 1; } i += 1; }
        i = 0;
        while i < bs.beams.len { if bs.beams[i].live { hazards += 1; } i += 1; }
        i = 0;
        while i < bs.roots.len { if bs.roots[i].live { hazards += 1; } i += 1; }
        let at = bs.b.pos;
        if !(at.x == at.x) || !(at.y == at.y) || (kind != FAULTJAW && flatDist(at, home) > 70) || (kind == FAULTJAW && tileAt(at.x, at.z) != bs.b.tile) || at.y < -45 || at.y > 80 {
            panic(`boss check: {bosskit.name(kind)} wandered off`);
        }
        t += 1;
    }
    if hazards == 0 { panic(`boss check: {bosskit.name(kind)} never attacked`); }
    if kind == RIME { bait(&bs, &p, lvl, &e); }
    else if cues == 0 { panic(`boss check: {bosskit.name(kind)} never opened up`); }
    if !bs.b.phase2 { panic(`boss check: {bosskit.name(kind)} no phase two`); }
    let done = false;
    t = 0;
    while t < 600 && !done {
        if bs.nparts > 0 { damage(&bs, &e, 0, 500, bs.parts[0].at); }
        done = update(&bs, &p, lvl, &e, 0.016);
        t += 1;
    }
    if !done { panic(`boss check: {bosskit.name(kind)} wouldn't fall`); }
}

/// A completed run pauses on a clear victory screen; Enter permits a victory lap.
pub fn victory(font: Font, big: Font) {
    let sz = game.windowSize();
    tone(Vec3.xyz(0.025, 0.04, 0.07), 0.9);
    rect(0, 0, sz.x, sz.y);
    shout(big, sz.x * 0.5, sz.y * 0.34, "ALL BIOMES CONQUERED", Vec3.xyz(1, 0.83, 0.35), 1);
    shout(font, sz.x * 0.5, sz.y * 0.34 + 70, "9 / 9 BOSSES DEFEATED  -  YOU WIN", Vec3.xyz(0.85, 1, 0.92), 1);
    let ran = challenge.mode();
    if ran != 0 { shout(font, sz.x * 0.5, sz.y * 0.34 + 100, `CHALLENGE COMPLETE: {challenge.name(ran)}`, Vec3.xyz(1, 0.55, 0.35), 1); }
    let enter = if ran != 0 { "ENTER FOR THE MAIN MENU" } else { "ENTER TO KEEP EXPLORING" };
    shout(font, sz.x * 0.5, sz.y * 0.34 + 140, enter, Vec3.xyz(0.7, 0.78, 0.85), 1);
}

/// A challenge run's badge, and the Boss Rush countdown to the next boss.
pub fn challengeHud(bs: &Bosses, font: Font, big: Font) {
    let m = challenge.mode();
    if m == 0 { return; }
    let sz = game.windowSize();
    shout(font, sz.x * 0.5, sz.y - 34, challenge.name(m), Vec3.xyz(1, 0.55, 0.35), 0.8);
    if m != challenge.RUSH || bs.b.kind != 0 || bs.squadN > 0 { return; }
    let left = int(bs.rushT) + 1;
    if bs.rushN >= RUSH_BOSSES { shout(big, sz.x * 0.5, sz.y * 0.2, `RUN COMPLETE IN {left}`, Vec3.xyz(1, 0.83, 0.35), 1); return; }
    shout(big, sz.x * 0.5, sz.y * 0.2, `BOSS {bs.rushN + 1} / {RUSH_BOSSES} IN {left}`, Vec3.xyz(1, 0.55, 0.35), 1);
}

/// Exercise the real shrine route, several live arenas, duplicate triggers, rewards and victory.
pub fn progressionCheck(mem: &Arena, lvl: &Level) {
    geode.check(mem, lvl);
    let p = player.create(lvl);
    let e = enemies.create(mem);
    let bs = create(mem);
    let savedOpen = lvl.open;
    lvl.open = 16;
    awaken(&bs, &p, lvl, &e, 1);
    awaken(&bs, &p, lvl, &e, HUB);
    if up(&bs) { panic("boss progression: locked biome or Hub spawned"); }
    lvl.open = 1023;
    let tile = 0;
    while tile < 10 {
        if tile != HUB {
            awaken(&bs, &p, lvl, &e, tile);
            if bs.b.kind != kindAt(tile) || bs.b.tile != tile { panic("boss progression: wrong biome boss"); }
            let fights = bs.fights;
            awaken(&bs, &p, lvl, &e, tile);
            if bs.fights != fights { panic("boss progression: duplicate summon"); }
        }
        tile += 1;
    }
    if bs.squadN != worldKinds() || won(&bs) { panic("boss progression: roster"); }
    // Leave them all alone: every boss persists with its own home and health.
    p.pos = Vec3.zero();
    let t = 0;
    while t < 250 { update(&bs, &p, lvl, &e, 0.016); p.hp = 100; t += 1; }
    let i = 0;
    while i < bs.squadN {
        let saved = bs.squad[i];
        if saved.kind == 0 || saved.tile != tileOf(saved.kind) || saved.hp != saved.maxHp {
            panic("boss progression: lost a waiting boss");
        }
        i += 1;
    }
    // A weapon hitting a non-focused arena must damage that boss, not the HUD's boss.
    let part = 0;
    while part < bs.nparts && bs.partBoss[part] == bs.active { part += 1; }
    if part == bs.nparts { panic("boss progression: missing other arena hitboxes"); }
    let victim = bs.partBoss[part];
    let oldHp = bs.squad[victim].hp;
    damage(&bs, &e, part, 10, bs.parts[part].at);
    update(&bs, &p, lvl, &e, 0.016);
    if bs.squad[victim].hp >= oldHp { panic("boss progression: damage went to wrong boss"); }
    // Each death earns exactly one reward and one completion bit, even with other bosses up.
    i = 0;
    let rewards = 0;
    let total = bs.squadN;
    while i < total {
        recall(&bs, i);
        bs.b.hp = 0;
        stash(&bs, i);
        t = 0;
        let got = false;
        while t < 200 && !got { got = update(&bs, &p, lvl, &e, 0.016); p.hp = 100; t += 1; }
        if !got { panic("boss progression: missing death reward"); }
        rewards += 1;
        if defeated(&bs) != rewards || won(&bs) != (rewards == total) {
            panic("boss progression: incorrect victory count");
        }
        i += 1;
    }
    if update(&bs, &p, lvl, &e, 0.016) { panic("boss progression: repeated reward"); }
    awaken(&bs, &p, lvl, &e, 0);
    if up(&bs) { panic("boss progression: respawned defeated boss"); }
    reset(&bs);
    if won(&bs) || bs.awakened != 0 || bs.rewards != 0 || up(&bs) { panic("boss progression: reset"); }
    awaken(&bs, &p, lvl, &e, 0);
    if bs.b.kind != RIME { panic("boss progression: cannot summon after reset"); }
    lvl.open = savedOpen;
}

/// Both new bosses pursue a fast airborne target and repeatedly fire actual 3D projectiles.
fn offenseCheck(mem: &Arena, kind: int) {
    let lvl = level.empty(mem, 1, 0);
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(-240, -1, -240), hi: Vec3.xyz(240, 0, 240), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    lvl.open = 1023;
    let p = player.create(&lvl);
    let e = enemies.create(mem);
    let bs = create(mem);
    bs.preview = kind;
    update(&bs, &p, &lvl, &e, 0.016);
    let home = bs.b.home;
    let traveled: f32 = 0;
    let highest: f32 = 0;
    let shots = 0;
    let upShots = 0;
    let surfaceShots = 0;
    let t = 0;
    while t < 2000 {
        let a = f32(t) * 0.016 * 0.75;
        p.pos = home + Vec3.xyz(cos(a) * 28, 22 + sin(a) * 7, sin(a) * 28);
        p.vel = Vec3.xyz(-sin(a) * 21, cos(a) * 5.25, cos(a) * 21);
        p.hp = 100;
        if t == 1000 { bs.b.hp = bs.b.maxHp * 0.45; }
        let was = bs.b.pos;
        update(&bs, &p, &lvl, &e, 0.016);
        traveled += flatDist(was, bs.b.pos);
        highest = max(highest, bs.b.pos.y);
        let i = 0;
        while i < bs.projs.len {
            let q = bs.projs[i];
            if q.live && q.t <= 0.017 && (q.kind == bosskit.SAND_BALL || q.kind == bosskit.RUNE_ROCK) {
                if q.arc < 10 || q.len < 1.4 || q.mark < 0 || !bs.marks[q.mark].live { panic("boss lob: missing arc or warning"); }
                shots += 1;
                if q.vel.y > 3 { upShots += 1; }
                if kind == FAULTJAW && bs.b.pos.y < 4 { surfaceShots += 1; }
            }
            i += 1;
        }
        t += 1;
    }
    if traveled < 100 || highest < 18 || shots < 15 { panic(`boss offense: {bosskit.name(kind)} too passive`); }
    if kind == FAULTJAW && (upShots < 5 || surfaceShots < 5) { panic("boss offense: worm failed airborne barrage"); }
}

/// Lobbed rocks retain their warning until impact, stop on cover, and damage on landing.
fn rockCheck(mem: &Arena) {
    let lvl = level.empty(mem, 2, 0);
    lvl.count = 2;
    lvl.boxes[0] = Box { lo: Vec3.xyz(-50, -1, -50), hi: Vec3.xyz(50, 0, 50), launch: 0, kind: level.SOLID };
    lvl.boxes[1] = Box { lo: Vec3.xyz(4, 0, -5), hi: Vec3.xyz(4.1, 30, 5), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    let p = player.create(&lvl);
    p.pos = Vec3.xyz(8, 0, 0);
    p.hp = 100;
    let bs = create(mem);
    bosskit.lobRock(&bs, &lvl, bosskit.RUNE_ROCK, Vec3.xyz(0, 2, 0), p.pos, 10, Vec3.xyz(0, 1, 1));
    let shot = bs.projs[0];
    let apex = bosskit.arcAt(shot, 0.5);
    if shot.mark < 0 || shot.len < 1.4 || apex.y < 10 { panic("boss lob: no readable arc"); }
    let t = 0;
    while t < 150 { bosskit.hazards(&bs, &p, &lvl, 0.02); t += 1; }
    if p.hp != 100 || bs.projs[0].live || bs.marks[shot.mark].live { panic("boss lob: cover or warning cleanup"); }
    bosskit.lobRock(&bs, &lvl, bosskit.SAND_BALL, Vec3.xyz(6, 3, 0), p.pos, 10, Vec3.xyz(1, 0.5, 0));
    t = 0;
    while t < 50 { bosskit.hazards(&bs, &p, &lvl, 0.02); t += 1; }
    if p.hp != 100 || !bs.projs[0].live || !bs.marks[bs.projs[0].mark].live { panic("boss lob: hit before dodge window"); }
    t = 0;
    while t < 100 { bosskit.hazards(&bs, &p, &lvl, 0.02); t += 1; }
    if p.hp >= 100 || bs.projs[0].live { panic("boss lob: landing missed player"); }
    // Both Geode phases cross the same wall that stops Relic, and retain timed warnings.
    let geodeKind = bosskit.GEODE_ROCK;
    while geodeKind <= bosskit.CRYSTAL_BALL {
        bosskit.clearHazards(&bs);
        p.hp = 100; p.hurtT = 10;
        bosskit.lobRock(&bs, &lvl, geodeKind, Vec3.xyz(0, 2, 0), p.pos, 10, Vec3.up());
        let geodeShot = bs.projs[0];
        if geodeShot.len < 0.85 || geodeShot.len > 1.5 || geodeShot.mark < 0 { panic("geode lob: speed or warning"); }
        t = 0;
        while t < 80 { bosskit.hazards(&bs, &p, &lvl, 0.02); t += 1; }
        if p.hp >= 100 || bs.projs[0].live || bs.marks[geodeShot.mark].live { panic("geode lob: wall blocked shot or warning stayed"); }
        geodeKind += 1;
    }
    // Full warning capacity must suppress the shot, never produce invisible targeting.
    bosskit.clearHazards(&bs);
    let i = 0;
    while i < bs.marks.len { bosskit.mark(&bs, Vec3.zero(), 2, 3, Vec3.up()); i += 1; }
    bosskit.lobRock(&bs, &lvl, bosskit.RUNE_ROCK, Vec3.xyz(6, 3, 0), p.pos, 10, Vec3.up());
    if bosskit.projsLive(&bs) != 0 { panic("boss lob: unmarked shot"); }
}

/// A player at the far corner of the Canyon must not put Faultjaw to sleep.
fn wormRangeCheck(mem: &Arena) {
    let lvl = level.empty(mem, 1, 0);
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(-240, -1, -240), hi: Vec3.xyz(240, 0, 240), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    lvl.open = 1023;
    let p = player.create(&lvl);
    p.pos = Vec3.xyz(-232, 0, 72);
    let e = enemies.create(mem);
    let bs = create(mem);
    awaken(&bs, &p, &lvl, &e, 3);
    if flatDist(p.pos, bs.b.home) < DISENGAGE { panic("worm range check: not at far corner"); }
    let travel: f32 = 0;
    let longest: f32 = 0;
    let highest: f32 = 0;
    let t = 0;
    while t < 1600 {
        let was = bs.b.pos;
        update(&bs, &p, &lvl, &e, 0.02);
        p.hp = 100;
        if !bs.b.engaged { panic("worm range check: disengaged inside Canyon"); }
        travel += flatDist(was, bs.b.pos);
        highest = max(highest, bs.b.pos.y);
        if bs.b.state == 2 { longest = max(longest, flatDist(bs.b.from, bs.b.aim)); }
        t += 1;
    }
    if travel < 150 || bs.b.cycle < 4 || longest < 45 || highest < 27 { panic("worm range check: stuck or short breach"); }
}
