// Biomes start locked behind dark walls; only the hub is open. Every third level earns a key:
// a lock shows up in the middle of each border you can reach; break it (like a shrine) to open
// the biome on its far side. Going down locks everything again.

module fps_shooter.gates;

use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.gfx.Mesh;
use j3.math.{ Mat4, Vec2, Vec3, clamp, sin };
use j3.memory.Arena;
use j3.scene3d;
use fps_shooter.biome;
use fps_shooter.level;
use fps_shooter.level.{ Level, EDGES };
use fps_shooter.shrine;
use fps_shooter.shrine.{ Shrines, MAX_SHRINES };

const EVERY: int = 3;
const LOCK_HP: f32 = 250;

pub struct Gates {
    /// Keys spent this run.
    used: int;
    /// "... UNLOCKED" banner, for `opened`.
    msgT: f32;
    opened: int;
    cube: Mesh;
}

pub fn create(): Gates {
    return Gates { used: 0, msgT: 0, opened: 0, cube: Mesh { vao: 0, vbo: 0, count: 0 } };
}

pub fn upload(g: &Gates, mem: &Arena) {
    g.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

/// A fresh run: back to just the hub.
pub fn reset(g: &Gates, lvl: &Level) {
    g.used = 0;
    lvl.open = 16;
    level.setGates(lvl);
}

pub fn keys(g: &Gates, lv: int): int {
    return lv / EVERY - g.used;
}

/// A locked border with one side open: its lock can be reached.
fn frontier(lvl: &Level, e: int): bool {
    return level.isOpen(lvl, level.edgeA(e)) != level.isOpen(lvl, level.edgeB(e));
}

/// The locked side of border `e`.
fn beyond(lvl: &Level, e: int): int {
    if level.isOpen(lvl, level.edgeA(e)) { return level.edgeB(e); }
    return level.edgeA(e);
}

/// Locks are up on reachable borders while you hold a key; breaking one opens the far side.
pub fn update(g: &Gates, lvl: &Level, sh: &Shrines, lv: int, dt: f32) {
    g.msgT = g.msgT - dt;
    if sh.broke >= 0 {
        g.opened = beyond(lvl, sh.broke);
        sh.broke = -1;
        lvl.open += level.bit(g.opened);
        g.used += 1;
        g.msgT = 3;
        level.setGates(lvl);
        shrine.placeArea(sh, g.opened);
    }
    let e = 0;
    while e < EDGES {
        let s = &sh.list[MAX_SHRINES + e];
        let up = frontier(lvl, e) && keys(g, lv) > 0;
        if up && !s.live {
            s.pos = level.edgeMid(e) + Vec3.xyz(0, 1, 0);
            s.hp = LOCK_HP;
            s.flash = 0;
        }
        s.live = up;
        e += 1;
    }
}

fn cube(g: &Gates, m: Mat4, tint: Vec3, glow: Vec3) {
    gfx.material(tint, glow);
    gfx.draw(g.cube, m);
}

/// A padlock through the middle of each border you can open now, flashing white when hit.
/// Fine in the shadow pass.
pub fn drawLocks(g: &Gates, sh: &Shrines) {
    let time = f32(game.ticks()) * 0.001;
    let e = 0;
    while e < EDGES {
        let s = sh.list[MAX_SHRINES + e];
        if s.live {
            let glow = Vec3.xyz(1.6, 1.1, 0.2) * (0.75 + 0.25 * sin(time * 5));
            let gold = Vec3.xyz(1, 0.78, 0.25);
            if s.flash > 0 {
                gold = Vec3.xyz(1, 1, 1);
                glow = Vec3.xyz(3, 3, 3);
            }
            let m = level.edgeMid(e);
            // Thick enough through the wall to show on both sides.
            let d: f32 = 0.9;
            let across = Vec3.xyz(1, 0, 0);
            if e >= 6 { across = Vec3.xyz(0, 0, 1); }
            let sx = 1.4 * across.z + d * across.x;
            let sz = 1.4 * across.x + d * across.z;
            let bob = m.y + 1.6 + sin(time * 2) * 0.08;
            cube(g, Mat4.translate(m.x, bob, m.z).mul(Mat4.scale(sx, 1.1, sz)), gold, glow);
            // The shackle: two posts and a bar.
            let px = 0.5 * across.z;
            let pz = 0.5 * across.x;
            let tx = 0.2 * across.z + d * 0.6 * across.x;
            let tz = 0.2 * across.x + d * 0.6 * across.z;
            cube(g, Mat4.translate(m.x - px, bob + 0.85, m.z - pz).mul(Mat4.scale(tx, 0.7, tz)), gold, glow * 0.6);
            cube(g, Mat4.translate(m.x + px, bob + 0.85, m.z + pz).mul(Mat4.scale(tx, 0.7, tz)), gold, glow * 0.6);
            cube(g, Mat4.translate(m.x, bob + 1.2, m.z).mul(Mat4.scale(sx * 0.85, 0.2, sz * 0.6)), gold, glow * 0.6);
            // Keyhole.
            cube(g, Mat4.translate(m.x, bob - 0.05, m.z).mul(Mat4.scale(0.2 * across.z + d * 1.05 * across.x, 0.45, 0.2 * across.x + d * 1.05 * across.z)),
                Vec3.xyz(0.1, 0.08, 0.05), Vec3.zero());
        }
        e += 1;
    }
}

/// The dark walls on reachable borders. Camera pass only, after everything opaque.
pub fn drawWalls(g: &Gates, lvl: &Level) {
    let e = 0;
    while e < EDGES {
        if frontier(lvl, e) {
            let b = level.gateBox(e);
            let c = (b.lo + b.hi) * 0.5;
            let s = b.hi - b.lo;
            gfx.material(Vec3.zero(), Vec3.zero());
            gfx.drawBlended(g.cube, Mat4.translate(c.x, c.y, c.z).mul(Mat4.scale(s.x, s.y, s.z)), 0.6);
        }
        e += 1;
    }
}

/// Gold text with a drop shadow, centred on `cx`.
fn centered(font: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(font, msg);
    game.setColor(game.rgba(10, 10, 20, 200));
    game.drawText(font, Vec2 { x: cx - t.x * 0.5 + 2, y: y + 2 }, msg);
    game.setColor(game.rgb(255, 215, 90));
    game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

/// A key-ready note, and the unlocked banner.
pub fn hud(g: &Gates, lv: int, font: Font, big: Font) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    if keys(g, lv) > 0 { centered(font, cx, sz.y - 110, "KEY READY  -  BREAK A LOCK ON A BORDER"); }
    if g.msgT > 0 {
        let a = u8(clamp(g.msgT, 0, 1) * 255);
        let title = `{biome.name(g.opened)} UNLOCKED`;
        let t = game.textSize(big, title);
        game.setColor(game.rgba(10, 10, 20, u8(f32(a) * 0.6)));
        game.drawText(big, Vec2 { x: cx - t.x * 0.5 + 2, y: sz.y * 0.36 + 2 }, title);
        game.setColor(game.rgba(255, 220, 90, a));
        game.drawText(big, Vec2 { x: cx - t.x * 0.5, y: sz.y * 0.36 }, title);
    }
}
