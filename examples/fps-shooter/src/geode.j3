// Living Geode: committed rolling lines, obstacle ricochets and physical jumps.
module fps_shooter.geode;
use j3.math.{ Vec3, Mat4, TAU, abs, clamp, cos, sin, min, max, sqrt };
use j3.memory.Arena;
use j3.sys.panic;
use fps_shooter.bosskit;
use fps_shooter.player;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.level;
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.bosskit.{ Bosses, BODY, WEAK, GEODE_ROCK, CRYSTAL_BALL, flat, flatDist, groundTop, walled, clearParts, addPart, frame, box, bit, burst, lobRock, yawTo };
use fps_shooter.sfx;

const R: f32 = 2.8;
fn blocked(lvl: &Level, at: Vec3): bool {
    return at.x < level.CAVE_X0 + R || at.x > level.CAVE_X1 - R || at.z < level.CAVE_Z0 + R || at.z > level.CAVE_Z1 - R || walled(lvl, at.x, at.z, R, at.y + 0.03, 0, R * 2 - 0.06);
}

pub fn home(lvl: &Level): Vec3 {
    let x: f32 = 148;
    while x > level.CAVE_X0 + 10 {
        let z: f32 = -140;
        while z < level.CAVE_Z1 - 10 {
            let at = Vec3.xyz(x, groundTop(lvl, x, z, R, -58), z);
            if at.y >= -63 && !blocked(lvl, at) { return at; }
            z += 12;
        }
        x -= 12;
    }
    return Vec3.xyz(168, -60, -141);
}

// Pick a clear rolling corridor when recommitting. A wall must not cause an endless
// head-on bounce back to the same approach; side corridors win over short dead ends.
fn heading(lvl: &Level, at: Vec3, target: Vec3): Vec3 {
    let toward = flat(target - at).normalize();
    let best = toward;
    let score: f32 = -100000;
    let option = 0;
    while option < 12 {
        let a = f32(option) * TAU / 12;
        let dir = Vec3.xyz(toward.x * cos(a) - toward.z * sin(a), 0, toward.x * sin(a) + toward.z * cos(a));
        let reach: f32 = 1;
        while reach < 22 && !blocked(lvl, at + dir * reach) { reach += 1; }
        let value = reach * 1.4 - flatDist(at + dir * reach, target);
        if value > score { score = value; best = dir; }
        option += 1;
    }
    return best;
}

pub fn begin(bs: &Bosses) {
    bs.b.intro = 1;
    bs.b.armor = 18;
    bs.b.cd = 1.5;
    bs.b.cd2 = 1.8;
    bs.b.dir = Vec3.xyz(0, 0, -1);
}

/// One living fragment per lost plate, including several plates broken by one hit.
pub fn shed(bs: &Bosses, e: &Enemies) {
    let b = &bs.b;
    let remaining = int(clamp(b.hp / b.maxHp, 0, 1) * 18);
    let chipped = b.armor > remaining;
    while b.armor > remaining {
        b.armor -= 1;
        let slab = 0;
        while slab < 18 && (slab * 7) % 18 != b.armor { slab += 1; }
        let y = 1 - 2 * (f32(slab) + 0.5) / 18;
        let r = sqrt(1 - y * y);
        let angle = f32(slab) * 2.4;
        let t = frame(b.pos + Vec3.xyz(0, R, 0), b.yaw).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), b.anim));
        let at = t.transformPoint(Vec3.xyz(cos(angle) * r, y, sin(angle) * r) * 1.8);
        let dir = flat(at - b.pos).normalize();
        enemies.spawnGeode(e, at, dir * 7 + Vec3.xyz(0, 6, 0));
        burst(bs, at, 4, 4, Vec3.xyz(0.52, 0.55, 0.6), Vec3.xyz(0.1, 0.6, 0.7));
    }
    if chipped { sfx.at(sfx.SHATTER, b.pos); }
}

fn lead(from: Vec3, p: &Player, crystal: bool): Vec3 {
    let velocity = flat(p.vel);
    if velocity.length() > 32 { velocity = velocity.normalize() * 32; }
    let target = p.pos;
    let iteration = 0;
    while iteration < 3 {
        let flight = bosskit.rockFlight(if crystal { CRYSTAL_BALL } else { GEODE_ROCK }, from, target);
        target = p.pos + velocity * (flight * 0.85);
        target.x = clamp(target.x, level.CAVE_X0 + 2, level.CAVE_X1 - 2);
        target.z = clamp(target.z, level.CAVE_Z0 + 2, level.CAVE_Z1 - 2);
        iteration += 1;
    }
    return target;
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    let speed: f32 = if b.phase2 { 25 } else { 20 };
    if b.engaged && b.intro <= 0 {
        b.t -= dt;
        b.cd2 -= dt;
        let floor = groundTop(lvl, b.pos.x, b.pos.z, R, b.pos.y + 0.15);
        let grounded = b.pos.y <= floor + 0.18 && b.vel.y <= 0;
        if b.t <= 0 {
            let aim = flat(p.pos + flat(p.vel) * 0.3 - b.pos);
            if aim.length() > 0.1 { b.dir = heading(lvl, b.pos, p.pos + flat(p.vel) * 0.3); }
            b.t = if b.phase2 { 1.15 } else { 1.6 };
        }
        if grounded && b.cd2 <= 0 && (p.pos.y > b.pos.y + 3 || b.heat > 0.3 || flatDist(p.pos, b.pos) > 32) {
            b.vel.y = min(38, sqrt(84.0 * max(8.0, p.pos.y - b.pos.y + 4)));
            b.cd2 = 2.5;
            b.state = 1;
            burst(bs, b.pos, 14, 6, Vec3.xyz(0.5, 0.55, 0.6), Vec3.zero());
        }
        let steps = int(dt * speed / 0.3) + 1;
        let step = dt / f32(steps);
        let i = 0;
        let moved: f32 = 0;
        while i < steps {
            let was = b.pos;
            let at = b.pos;
            at.x += b.dir.x * speed * step;
            if blocked(lvl, at) { b.dir.x = 0 - b.dir.x; b.t = max(b.t, 0.65); b.cycle += 1; } else { b.pos.x = at.x; }
            at = b.pos;
            at.z += b.dir.z * speed * step;
            if blocked(lvl, at) { b.dir.z = 0 - b.dir.z; b.t = max(b.t, 0.65); b.cycle += 1; } else { b.pos.z = at.z; }
            moved += flatDist(b.pos, was);
            b.vel.y -= 42 * step;
            let down = groundTop(lvl, b.pos.x, b.pos.z, R, b.pos.y + 0.1);
            at = b.pos;
            at.y += b.vel.y * step;
            if b.vel.y <= 0 && at.y <= down {
                b.pos.y = down; b.vel.y = 0; b.state = 0;
            } else if blocked(lvl, at) || at.y > -20 {
                b.vel.y = min(0, b.vel.y);
            } else { b.pos.y = at.y; }
            i += 1;
        }
        b.anim += moved / R;
        if moved < speed * dt * 0.15 { b.heat += dt; } else { b.heat = max(0, b.heat - dt); }
        // A corner cannot trap a nearly axis-aligned trajectory: choose a clear escape heading.
        if b.heat > 0.18 {
            let probe = 0;
            while probe < 12 {
                let angle = f32(probe) * TAU / 12 + f32(b.cycle) * 0.7;
                let dir = Vec3.xyz(cos(angle), 0, sin(angle));
                if !blocked(lvl, b.pos + dir * 1.2) { b.dir = dir; b.t = 1; break; }
                probe += 1;
            }
        }
        b.yaw = yawTo(Vec3.zero(), b.dir);
        b.len -= dt;
        if b.len <= 0 && (p.pos + Vec3.xyz(0, 0.9, 0) - b.pos - Vec3.xyz(0, R, 0)).length() < R + 1 {
            bosskit.hurt(p, 16, b.dir * 10 + Vec3.xyz(0, 6, 0)); b.len = 0.8;
        }
        b.cd -= dt;
        if b.cd <= 0 {
            let spread = Vec3.xyz(cos(f32(b.step) * 2.4), 0, sin(f32(b.step) * 2.4)) * 2.5;
            lobRock(bs, lvl, if b.phase2 { CRYSTAL_BALL } else { GEODE_ROCK }, b.pos + Vec3.xyz(0, R * 2 + 0.6, 0), lead(b.pos + Vec3.xyz(0, R * 2 + 0.6, 0), p, b.phase2) + spread, if b.phase2 { 15 } else { 12 }, Vec3.xyz(0.3, 1, 1));
            b.step += 1;
            let count = if b.phase2 { 5 } else { 3 };
            b.cd = if b.step % count == 0 { 1.55 } else { if b.phase2 { 0.3 } else { 0.44 } };
        }
    }
    b.open = 1 - b.hp / b.maxHp;
    b.cue = b.phase2;
    clearParts(bs);
    addPart(bs, b.pos + Vec3.xyz(0, R, 0), R, if b.phase2 { 1.25 } else { 1 }, BODY);
    bs.glowAt = b.pos + Vec3.xyz(0, R, 0);
    bs.glowColor = Vec3.xyz(0.2, 1.5, 1.8);
    bs.glowR = 8 + b.open * 8;
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let t = frame(b.pos + Vec3.xyz(0, R, 0), b.yaw).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), b.anim));
    let glow = Vec3.xyz(0.15, 1.7, 2.1);
    let crystal = 0;
    while crystal < 7 {
        let a = f32(crystal) * TAU / 7;
        let ct = t.mul(Mat4.rotate(Vec3.xyz(cos(a), sin(a), 0.5).normalize(), a));
        box(bs, ct, Vec3.zero(), Vec3.xyz(1.8, 3.9, 1.6), Vec3.xyz(0.32, 0.82, 0.92), glow * (0.25 + b.open * 0.7));
        crystal += 1;
    }
    let slab = 0;
    while slab < 18 {
        // Interleaved loss opens cracks on every side instead of removing one hemisphere.
        if (slab * 7) % 18 < b.armor {
            let y = 1 - 2 * (f32(slab) + 0.5) / 18;
            let r = sqrt(1 - y * y);
            let shellAngle = f32(slab) * 2.4;
            let at = Vec3.xyz(cos(shellAngle) * r, y, sin(shellAngle) * r) * 2.05;
            let shell = t.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.rotate(Vec3.xyz(1, 0.3, 0.5).normalize(), shellAngle));
            box(bs, shell, Vec3.zero(), Vec3.xyz(1.65, 1.55, 1.5), Vec3.xyz(0.48 + y * 0.08, 0.5 + y * 0.08, 0.55 + y * 0.08), Vec3.zero());
        }
        slab += 1;
    }
}

/// Real cave geometry: pursuit through columns, ricochets, elevated targets, and both volleys.
pub fn check(mem: &Arena, lvl: &Level) {
    let bs = bosskit.create(mem);
    let e = enemies.create(mem);
    let p = player.create(lvl);
    let at = home(lvl);
    bs.b.kind = bosskit.GEODE;
    bs.b.pos = at; bs.b.home = at; bs.b.hp = 100; bs.b.maxHp = 100;
    bs.b.engaged = true;
    begin(&bs); bs.b.intro = 0;
    let pursuit = 0;
    let closest: f32 = 1000;
    while pursuit < 1500 {
        p.pos = Vec3.xyz(168, -60, -141);
        p.hp = 100;
        shed(&bs, &e);
        update(&bs, &p, lvl, 0.02);
        bosskit.hazards(&bs, &p, lvl, 0.02);
        closest = min(closest, flatDist(bs.b.pos, p.pos));
        pursuit += 1;
    }
    if closest > 12 { panic("geode check: cannot pursue around entrance column"); }
    let traveled: f32 = 0;
    let highest = at.y;
    let rocks = 0;
    let crystals = 0;
    let stalled: f32 = 0;
    let t = 0;
    while t < 3000 {
        let a = f32(t) * 0.02;
        p.pos = Vec3.xyz(88 + cos(a * 0.4) * 100, if t % 500 < 250 { -60 } else { -35 }, -88 + sin(a * 0.4) * 100);
        p.hp = 100;
        if t == 1500 { bs.b.phase2 = true; bs.b.hp = 40; }
        let was = bs.b.pos;
        shed(&bs, &e);
        update(&bs, &p, lvl, 0.02);
        let distance = (bs.b.pos - was).length();
        traveled += distance;
        highest = max(highest, bs.b.pos.y);
        if distance < 0.01 { stalled += 0.02; } else { stalled = 0; }
        if stalled > 2 || blocked(lvl, bs.b.pos) || bs.b.pos.y < -64 { panic("geode check: stuck or outside cave geometry"); }
        let i = 0;
        while i < bs.projs.len {
            let q = bs.projs[i];
            if q.live && q.t == 0 {
                if q.mark < 0 || q.aim.y > -20 || q.arc < 1 { panic("geode check: cave volley not marked or lobbed"); }
                if q.kind == GEODE_ROCK { rocks += 1; } else { crystals += 1; }
            }
            i += 1;
        }
        bosskit.hazards(&bs, &p, lvl, 0.02);
        t += 1;
    }
    if traveled < 300 || highest < -45 || rocks < 8 || crystals < 12 || bs.b.cycle < 2 || bs.b.armor > 8 { panic("geode check: missing pursuit, bounce, jump, shell or phase attack"); }
    if enemies.alive(&e) != 11 { panic("geode chips: lost multi-plate damage"); }
    shed(&bs, &e);
    if enemies.alive(&e) != 11 { panic("geode chips: duplicate fragments"); }
    bs.b.hp = 0;
    shed(&bs, &e);
    if enemies.alive(&e) != 18 { panic("geode chips: lethal hit lost remaining fragments"); }
    p.pos = Vec3.xyz(100, -60, -100);
    p.vel = Vec3.xyz(18, 0, 0);
    let launch = Vec3.xyz(80, -54, -100);
    let predicted = lead(launch, &p, false);
    if predicted.x < p.pos.x + 15 || predicted.z != p.pos.z { panic("geode aim: does not lead lateral motion"); }
    p.vel = Vec3.zero();
    if (lead(launch, &p, true) - p.pos).length() > 0.01 { panic("geode aim: stationary target drifts"); }
    enemies.geodeCheck(mem, lvl);
    // Body separation next to a wall must not push the player into its collider.
    bosskit.clearHazards(&bs);
    p.pos = Vec3.xyz(level.CAVE_X1 - 0.36, -60, -200);
    if !player.fits(lvl, p.pos) { panic("geode check: invalid wall fixture"); }
    let wallSpot = p.pos;
    clearParts(&bs);
    addPart(&bs, p.pos + Vec3.xyz(-2, 1, 0), R, 1, BODY);
    bosskit.hazards(&bs, &p, lvl, 0.02);
    if !player.fits(lvl, p.pos) || (p.pos - wallSpot).length() > 0.01 { panic("geode check: pushed player through cave wall"); }

}
