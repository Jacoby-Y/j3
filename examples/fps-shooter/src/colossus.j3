// Colossus: a giant stone hopper with a furnace in its chest. It bounds after you in short
// hops, then crouches, glows and leaps high onto a big marked ring; the landing sends out a
// shockwave to jump. After the big landing it plants its fists and roars with its mouth wide
// open: shots into the furnace do heavy damage. In phase two it hops less between leaps, its
// small landings throw a small wave, and every big leap is followed by a quick second one.

module fps_shooter.colossus;

use j3.math.{ Mat4, Vec3, clamp, cos, max, min, sin, sqrt };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, addPart, box, bit, blastPlayer, bulk, clearParts, flat, flatDist, forward, frame,
    groundTop, limb, mark, puff, smoke, tilt, turn, wave, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const FALL: int = 0;
pub const CROUCH: int = 1;
const HOP: int = 2;
const WINDUP: int = 3;
const LEAP: int = 4;
const SETTLE: int = 5;
const ROAR: int = 6;
const IDLE: int = 7;

/// Hops between big leaps.
const HOPS: int = 3;
const HOPS2: int = 2;
const CROUCH_T: f32 = 0.5;
const CROUCH_T2: f32 = 0.38;
const HOP_T: f32 = 0.85;
const HOP_H: f32 = 3.5;
const HOP_REACH: f32 = 11;
/// Hops land this far short of the player; the landing blast still reaches.
const HOP_SHORT: f32 = 3;
const WINDUP_T: f32 = 1.0;
const WINDUP_T2: f32 = 0.8;
const LEAP_T: f32 = 2.0;
const LEAP_H: f32 = 16;
/// Phase two's quick follow-up leap.
const QUICK_T: f32 = 1.25;
const QUICK_H: f32 = 8;
const FALL_T: f32 = 2.2;
const SETTLE_T: f32 = 0.5;
const ROAR_T: f32 = 3.6;
const ROAR_T2: f32 = 3.0;
/// Landing blasts: the big one's ring, and a hop's.
const IMPACT_R: f32 = 6.5;
const IMPACT_DMG: f32 = 35;
const HOP_R: f32 = 3.4;
const HOP_DMG: f32 = 18;
const WAVE_SPEED: f32 = 17;
const WAVE_REACH: f32 = 38;
const WAVE_H: f32 = 0.9;
const WAVE_DMG: f32 = 22;
/// Phase two's second big wave comes this long after the first.
const WAVE_GAP: f32 = 0.45;
/// It never lands further than this from its arena's middle.
const LEASH: f32 = 42;
/// The furnace takes this many times the damage while the mouth is open.
const MOUTH: f32 = 3.5;

fn hot(): Vec3 {
    return Vec3.xyz(3, 0.7, 0.15);
}

/// Start the entrance: it drops out of the sky onto `b.pos`.
pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.state = FALL;
    b.t = 0;
    b.aim = b.pos;
    b.from = b.pos + Vec3.xyz(0, 45, 0);
    b.len = FALL_T;
    b.pos = b.from;
    b.intro = FALL_T;
    b.step = 0;
    mark(bs, b.aim, IMPACT_R, FALL_T, hot());
}

fn to(b: &Boss, state: int, len: f32) {
    b.state = state;
    b.t = 0;
    b.len = len;
}

/// Where a jump from here toward the player lands: at most `reach` away and `short` of them,
/// inside the leash, on top of whatever is there. `lead` seconds of their motion are added.
fn target(b: &Boss, p: &Player, lvl: &Level, reach: f32, short: f32, lead: f32): Vec3 {
    let want = flat(p.pos + p.vel * lead);
    let off = want - flat(b.pos);
    let far = off.length();
    // Already that close: a stomp on the spot.
    if short > 0 && far <= short { want = flat(b.pos); far = 0; }
    if far > short && short > 0 { want = want - off * (short / far); far = far - short; }
    if far > reach { want = flat(b.pos) + off * (reach / off.length()); }
    let fromHome = want - flat(b.home);
    if fromHome.length() > LEASH { want = flat(b.home) + fromHome.normalize() * LEASH; }
    let y = groundTop(lvl, want.x, want.z, 1.6, 80);
    if y < -50 { y = b.home.y; }
    // A hop that would land on its own feet goes sideways instead of stomping in place.
    if short > 0 && flatDist(Vec3.xyz(want.x, b.pos.y, want.z), b.pos) < 2 {
        let toPlayer = flat(p.pos - b.pos);
        let side = Vec3.xyz(0 - toPlayer.z, 0, toPlayer.x);
        if side.length() < 0.01 { side = Vec3.xyz(1, 0, 0); }
        side = side.normalize() * 8;
        let hop = flat(b.pos) + side;
        let away = hop - flat(b.home);
        if away.length() > LEASH { hop = flat(b.pos) - side; }
        away = hop - flat(b.home);
        if away.length() > LEASH { hop = flat(b.home) + away.normalize() * LEASH; }
        want = hop;
        y = groundTop(lvl, want.x, want.z, 1.6, 80);
        if y < -50 { y = b.home.y; }
    }
    return Vec3.xyz(want.x, y, want.z);
}

fn jump(b: &Boss, state: int, aim: Vec3, len: f32) {
    b.from = b.pos;
    b.aim = aim;
    to(b, state, len);
    b.squash = 1.3;
    sfx.at(sfx.JUMP, b.pos);
}

/// A big landing: the blast under it and a shockwave (two in phase two).
fn slam(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    sfx.at(sfx.SLAM, b.pos);
    blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), IMPACT_R, IMPACT_DMG, 14);
    wave(bs, b.pos, WAVE_SPEED, WAVE_REACH, WAVE_H, WAVE_DMG, hot());
    if b.phase2 { b.cd2 = WAVE_GAP; }
    bs.shake = max(bs.shake, 0.06 * clamp(1 - flatDist(p.pos, b.pos) / 40, 0.2, 1));
    let k = 0;
    while k < 16 {
        let a = f32(k) * 0.3927;
        puff(bs, b.pos + Vec3.xyz(cos(a) * 3, 0.3, sin(a) * 3), Vec3.xyz(cos(a) * 9, 2, sin(a) * 9), 0.9, 0.7, 1.5, 0,
            Vec3.xyz(0.55, 0.5, 0.45), Vec3.zero());
        k += 1;
    }
    b.squash = 0.6;
}

/// A hop's landing: a smaller blast, and a small wave in phase two.
fn thud(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    sfx.at(sfx.SLAM, b.pos);
    blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), HOP_R, HOP_DMG, 10);
    if b.phase2 { wave(bs, b.pos, 14, 12, WAVE_H, 12, hot()); }
    smoke(bs, b.pos, 6, 4, Vec3.xyz(0.55, 0.5, 0.45), Vec3.zero());
    bs.shake = max(bs.shake, 0.025 * clamp(1 - flatDist(p.pos, b.pos) / 30, 0, 1));
    b.squash = 0.72;
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    b.anim += dt;
    b.squash = b.squash + (1 - b.squash) * min(dt * 7, 1);
    b.open = b.open + (b.openTo - b.open) * min(dt * 6, 1);
    b.heat = max(b.heat - dt * 1.5, 0);
    if b.cd2 > 0 {
        b.cd2 -= dt;
        if b.cd2 <= 0 { wave(bs, b.pos, WAVE_SPEED, WAVE_REACH, WAVE_H, WAVE_DMG, hot()); }
    }
    let k = clamp(b.t / b.len, 0, 1);
    if b.state == FALL {
        b.pos = b.from + (b.aim - b.from) * (k * k);
        if k >= 1 {
            b.pos = b.aim;
            slam(bs, p);
            b.cycle = 0;
            to(b, ROAR, ROAR_T * 0.6);
            sfx.at(sfx.ROAR, b.pos);
        }
    } else if b.state == HOP || b.state == LEAP {
        let h = HOP_H;
        if b.state == LEAP { h = if b.step < 0 { QUICK_H } else { LEAP_H }; }
        b.pos = b.from + (b.aim - b.from) * k + Vec3.xyz(0, h * 4 * k * (1 - k), 0);
        b.yaw = turn(b.yaw, yawTo(b.from, b.aim), dt * 6);
        if k >= 1 {
            b.pos = b.aim;
            if b.state == HOP {
                thud(bs, p);
                b.step += 1;
                let hops = if b.phase2 { HOPS2 } else { HOPS };
                if b.step >= hops { to(b, WINDUP, if b.phase2 { WINDUP_T2 } else { WINDUP_T }); sfx.at(sfx.WARN, b.pos); }
                else { to(b, CROUCH, if b.phase2 { CROUCH_T2 } else { CROUCH_T }); }
            } else {
                slam(bs, p);
                to(b, SETTLE, SETTLE_T);
            }
        }
    } else if b.state == SETTLE {
        if b.t >= b.len {
            // Phase two: a quick second leap before the roar. `step` < 0 marks it.
            if b.phase2 && b.step >= 0 {
                b.step = -1;
                let quick = target(b, p, lvl, 60, 0, 0.2);
                jump(b, LEAP, quick, QUICK_T);
                mark(bs, quick, IMPACT_R, QUICK_T, hot());
            } else {
                to(b, ROAR, if b.phase2 { ROAR_T2 } else { ROAR_T });
                sfx.at(sfx.ROAR, b.pos);
            }
        }
    } else if b.state == ROAR {
        b.openTo = if b.t < b.len - 0.4 { 1 } else { 0 };
        if b.open > 0.55 { b.cue = true; }
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 0.9);
        if bs.fxRng.unit() < dt * 14 {
            let mouth = mouthAt(b);
            let out = forward(b.yaw) * 3 + Vec3.xyz(0, 1.5, 0);
            puff(bs, mouth, out, 0.7, 0.35, 0.8, 0, Vec3.xyz(0.2, 0.15, 0.12), Vec3.xyz(2.4, 0.8, 0.15));
        }
        if b.t >= b.len {
            b.openTo = 0;
            b.step = 0;
            b.cycle += 1;
            if b.engaged { to(b, CROUCH, CROUCH_T); } else { to(b, IDLE, 1); }
        }
    } else if b.state == CROUCH {
        b.squash = min(b.squash, 1 - 0.25 * k);
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 3);
        if b.t >= b.len {
            if !b.engaged { to(b, IDLE, 1); }
            else { jump(b, HOP, target(b, p, lvl, HOP_REACH, HOP_SHORT, 0), HOP_T); }
        }
    } else if b.state == WINDUP {
        // Crouches deep, cracks glowing, shaking: the tell for the big leap.
        b.squash = min(b.squash, 1 - 0.4 * k);
        b.heat = k * 2;
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 3);
        if bs.fxRng.unit() < dt * 20 {
            smoke(bs, b.pos, 1, 5, Vec3.xyz(0.55, 0.5, 0.45), Vec3.zero());
        }
        if b.t >= b.len {
            let big = target(b, p, lvl, 60, 0, 0.3);
            b.step = 0;
            jump(b, LEAP, big, LEAP_T);
            mark(bs, big, IMPACT_R, LEAP_T, hot());
        }
    } else {
        // Waiting for the player to come back: hop home if it's away.
        b.yaw = b.yaw + dt * 0.2;
        if b.t >= b.len {
            if b.engaged { to(b, CROUCH, CROUCH_T); }
            else if flatDist(b.pos, b.home) > 8 {
                let off = flat(b.home - b.pos);
                let aim = flat(b.pos) + off.normalize() * min(off.length(), HOP_REACH);
                jump(b, HOP, Vec3.xyz(aim.x, groundTop(lvl, aim.x, aim.z, 1.6, 80), aim.z), HOP_T);
            } else { b.t = 0; }
        }
    }
    pose(bs);
    bs.glowAt = mouthAt(b) + forward(b.yaw) * 3;
    bs.glowColor = Vec3.xyz(1.6, 0.6, 0.1) * (0.1 + b.open * 0.5 + b.heat * 0.15);
    bs.glowR = 7 + b.open * 4;
}

/// Planted-fists-and-roar amount, 0..1.
fn roaring(b: &Boss): f32 {
    return b.open;
}

/// The frame the body hangs from: squashed, and leaning back as it roars.
fn root(b: &Boss): Mat4 {
    let sq = b.squash;
    let w = 1 / sqrt(sq);
    return frame(b.pos, b.yaw).mul(Mat4.scale(w, sq, w));
}

fn torso(b: &Boss): Mat4 {
    let lean = 0 - 0.32 * roaring(b);
    return root(b).mul(Mat4.translate(0, 1.6, 0)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), lean)).mul(Mat4.translate(0, -1.6, 0));
}

fn mouthAt(b: &Boss): Vec3 {
    return torso(b).transformPoint(Vec3.xyz(0, 3.0, -1.95));
}

/// Where a fist is, in the world: hanging, raised in the air, or planted in front to roar.
fn fist(b: &Boss, side: f32): Vec3 {
    let air: f32 = 0;
    if b.state == HOP || b.state == LEAP || b.state == FALL { air = sin(clamp(b.t / b.len, 0, 1) * 3.1416); }
    let swing = sin(b.anim * 2.2 + side) * 0.2;
    let hang = Vec3.xyz(side * 3.0, 1.5 + swing, -0.4);
    let up = Vec3.xyz(side * 3.2, 4.6, 0.2);
    let plant = Vec3.xyz(side * 2.3, 0.7, -2.7);
    let r = roaring(b);
    let local = hang + (up - hang) * air;
    local = local + (plant - local) * r;
    return frame(b.pos, b.yaw).transformPoint(local);
}

/// Hit spheres for this frame.
fn pose(bs: &Bosses) {
    let b = &bs.b;
    clearParts(bs);
    let t = torso(b);
    let mouth: f32 = if b.open > 0.55 { MOUTH } else { 1 };
    // The mouth first, so a shot into it counts even where the body sphere overlaps.
    addPart(bs, t.transformPoint(Vec3.xyz(0, 3.0, -1.95)), 0.95, mouth, WEAK);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 3.3, 0)), 2.5, 1, BODY);
    addPart(bs, root(b).transformPoint(Vec3.xyz(0, 1.2, 0)), 1.9, 1, BODY);
    addPart(bs, fist(b, -1), 1.0, 1, BODY);
    addPart(bs, fist(b, 1), 1.0, 1, BODY);
    bulk(bs, 2.7, b.pos.y, b.pos.y + 5.5 * b.squash);
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let stone = Vec3.xyz(0.66, 0.6, 0.54);
    let armor = Vec3.xyz(0.47, 0.43, 0.42);
    let dark = Vec3.xyz(0.3, 0.27, 0.27);
    let black = Vec3.xyz(0.04, 0.03, 0.03);
    let crack = Vec3.xyz(2.4, 0.7, 0.1) * (0.5 + b.heat + b.open * 0.6 + 0.15 * sin(b.anim * 5));
    let base = root(b);
    let t = torso(b);
    // Legs.
    box(bs, base, Vec3.xyz(-1.35, 0.75, 0.2), Vec3.xyz(1.5, 1.5, 1.8), dark, Vec3.zero());
    box(bs, base, Vec3.xyz(1.35, 0.75, 0.2), Vec3.xyz(1.5, 1.5, 1.8), dark, Vec3.zero());
    // Body, belly plate, chest armor, shoulders, the hump and its chimney.
    box(bs, t, Vec3.xyz(0, 3.0, 0), Vec3.xyz(4.6, 3.2, 3.6), stone, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 1.95, -1.62), Vec3.xyz(3.4, 0.9, 0.45), armor, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 4.1, -1.7), Vec3.xyz(3.8, 1.1, 0.5), armor, Vec3.zero());
    box(bs, t, Vec3.xyz(-2.3, 4.3, 0), Vec3.xyz(1.8, 1.4, 2.2), armor, Vec3.zero());
    box(bs, t, Vec3.xyz(2.3, 4.3, 0), Vec3.xyz(1.8, 1.4, 2.2), armor, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 4.95, 0.2), Vec3.xyz(2.6, 1.0, 2.4), stone, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 5.9, 0.7), Vec3.xyz(0.9, 1.3, 0.9), dark, Vec3.zero());
    bit(bs, t, Vec3.xyz(0, 6.58, 0.7), Vec3.xyz(0.7, 0.1, 0.7), black, crack * 1.2);
    // Eyes under the brow.
    bit(bs, t, Vec3.xyz(-0.75, 4.35, -1.98), Vec3.xyz(0.6, 0.22, 0.1), black, Vec3.xyz(3, 1.8, 0.3));
    bit(bs, t, Vec3.xyz(0.75, 4.35, -1.98), Vec3.xyz(0.6, 0.22, 0.1), black, Vec3.xyz(3, 1.8, 0.3));
    // The furnace mouth: a glowing slot that gapes as the jaw drops.
    let o = b.open;
    let gape = 0.25 + o * 1.1;
    let fire = Vec3.xyz(3, 1.1, 0.15) * (0.5 + o * 2);
    bit(bs, t, Vec3.xyz(0, 3.5 - gape * 0.5, -1.86), Vec3.xyz(2.2, gape, 0.08), black, fire);
    bit(bs, t, Vec3.xyz(0, 3.0, -1.5), Vec3.xyz(1.8, 1.0, 0.6), black, fire * (0.4 + o));
    tilt(bs, t, Vec3.xyz(0, 2.6 - o * 0.5, -1.72), Vec3.xyz(2.6, 0.55, 1.0), 0 - o * 0.5, 0, armor, Vec3.zero());
    let k = 0;
    while k < 4 {
        let x = -0.81 + f32(k) * 0.54;
        bit(bs, t, Vec3.xyz(x, 3.42, -1.92), Vec3.xyz(0.22, 0.26, 0.12), Vec3.xyz(0.85, 0.8, 0.7), Vec3.zero());
        bit(bs, t, Vec3.xyz(x + 0.27, 2.95 - o * 0.95, -1.95 + o * 0.25), Vec3.xyz(0.2, 0.24, 0.12), Vec3.xyz(0.85, 0.8, 0.7), Vec3.zero());
        k += 1;
    }
    // Cracks in the armor, glowing with its heat.
    bit(bs, t, Vec3.xyz(-1.2, 3.0, -1.81), Vec3.xyz(0.1, 1.3, 0.06), black, crack);
    bit(bs, t, Vec3.xyz(1.35, 2.7, -1.81), Vec3.xyz(0.1, 0.9, 0.06), black, crack);
    bit(bs, t, Vec3.xyz(-2.31, 2.8, 0.5), Vec3.xyz(0.06, 1.4, 0.1), black, crack);
    bit(bs, t, Vec3.xyz(2.31, 3.2, -0.6), Vec3.xyz(0.06, 1.1, 0.1), black, crack);
    bit(bs, t, Vec3.xyz(-0.6, 4.5, -1.96), Vec3.xyz(0.8, 0.08, 0.06), black, crack);
    bit(bs, t, Vec3.xyz(0.9, 3.3, 1.81), Vec3.xyz(0.1, 1.5, 0.06), black, crack);
    // Arms from the shoulders to the fists.
    let side: f32 = -1;
    while side < 2 {
        let shoulder = t.transformPoint(Vec3.xyz(side * 2.6, 4.1, 0));
        let f = fist(b, side);
        limb(bs, shoulder, f + Vec3.xyz(0, 0.5, 0), 1.1, 1.1, stone, Vec3.zero());
        box(bs, frame(f, b.yaw), Vec3.zero(), Vec3.xyz(1.6, 1.4, 1.6), armor, Vec3.zero());
        bit(bs, frame(f, b.yaw), Vec3.xyz(0, 0.2, -0.81), Vec3.xyz(1.0, 0.08, 0.06), black, crack * 0.8);
        side += 2;
    }
}
