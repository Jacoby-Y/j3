// What every boss shares: its state, the hazards its attacks leave (ground warnings, shockwaves,
// lobbed and homing shots, burning and icy patches, ice blocks, root lines, lane beams), puffs of
// smoke and debris, the spheres bullets hit, and the boxes it is drawn from. Each boss's
// behaviour is its own module (colossus.j3 ...); boss.j3 runs the fight around them.

module fps_shooter.bosskit;

use j3.gfx;
use j3.gfx.{ Instance, Mesh, Ray };
use j3.math.{ Mat4, Vec3, PI, TAU, abs, atan2, clamp, cos, max, min, mini, sin, sqrt };
use j3.memory.Arena;
use j3.rand.Rng;
use j3.scene3d;
use fps_shooter.level.{ Level, next, scan, BARRIER, ICE };
use fps_shooter.player.{ Player, hurt };
use fps_shooter.sfx;

pub const COLOSSUS: int = 1;
pub const SAUCER: int = 2;
pub const RIME: int = 3;
pub const CINDER: int = 4;
pub const HEARTWOOD: int = 5;
pub const MARQUEE: int = 6;
pub const KINDS: int = 6;

/// Projectiles: a homing arc that blows up on its mark, a lobbed firebomb, a lobbed ice block,
/// and a straight wooden spike.
pub const MISSILE: int = 1;
pub const BOMB: int = 2;
pub const CHUNK: int = 3;
pub const SPIKE: int = 4;
/// Patches: burning ground, and ice that keeps the player's momentum.
pub const FIRE: int = 1;
pub const FROST: int = 2;
/// Beams: a low neon bar to jump, or a strafing run to step out of.
pub const BAR: int = 0;
pub const STRAFE: int = 1;
/// Part ids: plain body, the weak point, then parts with their own health from SUB.
pub const BODY: int = 0;
pub const WEAK: int = 1;
pub const SUB: int = 2;

pub const MAX_PARTS: int = 96;
pub const MAX_SUBS: int = 8;
const MAX_MARKS: int = 24;
const MAX_WAVES: int = 6;
const MAX_PROJS: int = 40;
const MAX_PATCHES: int = 48;
/// Burning patches up at once; the oldest goes out first, so safe ground always remains.
const MAX_FIRES: int = 6;
const MAX_CHUNKS: int = 8;
const MAX_ROOTS: int = 6;
const MAX_BEAMS: int = 12;
const MAX_PUFFS: int = 320;
const MAX_SOLID: int = 512;
const MAX_FX: int = 4096;
const MAX_BLEND: int = 16;
/// Player capsule, as in player.j3.
const BODY_R: f32 = 0.35;
const BODY_H: f32 = 1.8;
/// Root lines: seconds after the head stops before they burst, and how long they stay up.
pub const ROOT_WAIT: f32 = 0.45;
pub const ROOT_UP: f32 = 0.7;
/// Burning ground hurts this much this often.
const BURN: f32 = 10;
const BURN_EVERY: f32 = 0.5;

/// A sphere bullets hit and the player can't walk through. `mult` scales damage.
pub struct Part {
    at: Vec3;
    r: f32;
    mult: f32;
    id: int;
}

pub struct Boss {
    /// 0 when there is no boss.
    kind: int = 0;
    tile: int = 4;
    /// Arena middle, on the ground; walkers stay near it.
    home: Vec3;
    /// Feet for walkers, the middle for the saucer.
    pos: Vec3;
    vel: Vec3;
    /// Facing: local -z points along `forward(yaw)`.
    yaw: f32 = 0;
    hp: f32 = 1;
    maxHp: f32 = 1;
    /// The state the boss module runs, time in it, and counters it can use.
    state: int = 0;
    t: f32 = 0;
    step: int = 0;
    cycle: int = 0;
    /// Launch point, target, direction and length of a hop, charge or attack.
    from: Vec3;
    aim: Vec3;
    dir: Vec3;
    len: f32 = 1;
    /// How far its weak point is open, 0..1, easing toward `openTo`.
    open: f32 = 0;
    openTo: f32 = 0;
    /// Walk or bob clock, squash, and forward lean in radians.
    anim: f32 = 0;
    squash: f32 = 1;
    lean: f32 = 0;
    /// Armor pieces left (Rime's shards, Heartwood's bark).
    armor: int = 0;
    /// Timers and a gauge the modules use as they like.
    cd: f32 = 0;
    cd2: f32 = 0;
    heat: f32 = 0;
    flash: f32 = 0;
    phase2: bool = false;
    /// Seconds of entrance left (it can't be hurt), and of death once its health is gone.
    intro: f32 = 0;
    dying: f32 = 0;
    /// Fighting the player, as opposed to waiting at home for them.
    engaged: bool = false;
    /// Set by the boss module while its weak point is open, for the hud's hint.
    cue: bool = false;
}

/// A ground warning: a ring that fills in as `t` reaches `len`.
pub struct Mark {
    at: Vec3;
    r: f32;
    t: f32;
    len: f32;
    hot: Vec3;
    live: bool;
    /// Painted ahead of its shot: `fire` launches one at it.
    armed: bool = false;
}

/// A ring along the ground from `at`, `h` tall: jump it.
pub struct Wave {
    at: Vec3;
    r: f32;
    speed: f32;
    reach: f32;
    h: f32;
    dmg: f32;
    hot: Vec3;
    hit: bool;
    live: bool;
}

/// Arcs (missiles, bombs, chunks) fly `from` to `aim` in `len` seconds, `arc` metres high at
/// the middle. Spikes fly straight at `vel`.
pub struct Proj {
    kind: int;
    from: Vec3;
    aim: Vec3;
    pos: Vec3;
    vel: Vec3;
    t: f32;
    len: f32;
    arc: f32;
    dmg: f32;
    r: f32;
    mark: int;
    live: bool;
}

pub struct Patch {
    kind: int;
    at: Vec3;
    r: f32;
    t: f32;
    life: f32;
    spin: f32;
    live: bool;
}

/// An ice block standing on the ground: `half` wide each way, `h` tall.
pub struct Chunk {
    at: Vec3;
    half: f32;
    h: f32;
    t: f32;
    life: f32;
    live: bool;
}

/// A root line snaking `len` metres along `dir` (wiggling along `side`). `head` is how far the
/// crack has run; `t` counts from when it stopped.
pub struct Root {
    from: Vec3;
    dir: Vec3;
    side: Vec3;
    len: f32;
    head: f32;
    t: f32;
    speed: f32;
    wiggle: f32;
    seed: f32;
    dmg: f32;
    hit: bool;
    live: bool;
}

/// A lane `half` wide each side, `len` long from `from` along `dir`. It shows for `delay`
/// seconds, then something sweeps down it at `speed`, hurting below `tall`.
pub struct Beam {
    kind: int;
    from: Vec3;
    dir: Vec3;
    side: Vec3;
    len: f32;
    half: f32;
    delay: f32;
    t: f32;
    speed: f32;
    tall: f32;
    dmg: f32;
    hot: Vec3;
    hit: bool;
    live: bool;
}

/// Smoke, flame, steam or debris. `fall` scales gravity; with no gravity it drags to a stop.
pub struct Puff {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    life: f32;
    size: f32;
    grow: f32;
    fall: f32;
    tint: Vec3;
    glow: Vec3;
}

/// A part a ray hit (index into `parts`, or -1) and how far along.
pub struct Hit {
    part: int;
    t: f32;
}

pub struct Bosses {
    b: Boss;
    parts: []Part;
    nparts: int = 0;
    /// Health of the SUB parts (growths, knee lights), and whether each is still there.
    sub: []f32;
    subOn: []bool;
    marks: []Mark;
    waves: []Wave;
    projs: []Proj;
    patches: []Patch;
    chunks: []Chunk;
    roots: []Root;
    beams: []Beam;
    puffs: []Puff;
    nextPuff: int = 0;
    nextPatch: int = 0;
    nextChunk: int = 0;
    /// Drawn this frame: shadow-casting boxes, their outlines, and camera-only effects.
    solid: []Instance;
    nsolid: int = 0;
    hulls: []Instance;
    nhull: int = 0;
    fx: []Instance;
    nfx: int = 0;
    blend: []Mat4;
    blendTint: []Vec3;
    blendA: []f32;
    nblend: int = 0;
    cube: Mesh;
    /// The fight's rolls, and cosmetic ones that never shift them.
    rng: Rng;
    fxRng: Rng;
    edge: Vec3;
    edgeW: f32 = 0.06;
    clock: f32 = 0;
    /// For the guns to take as camera shake, and the hud's hit and weak-point markers.
    shake: f32 = 0;
    hitT: f32 = 0;
    critT: f32 = 0;
    burnT: f32 = 0;
    /// The boss's own light: where, what colour, how far.
    glowAt: Vec3;
    glowColor: Vec3;
    glowR: f32 = 0;
    /// A cylinder round the boss the player is pushed out of, beyond its spheres: radius, and
    /// bottom and top. 0 radius for none. Set each frame by the boss module.
    bulkR: f32 = 0;
    bulkLo: f32 = 0;
    bulkHi: f32 = 0;
    /// Run time the next boss is due at, kinds beaten this run (a bit each), bosses so far.
    nextAt: f32 = 240;
    beaten: int = 0;
    fights: int = 0;
    /// Hud: the entrance banner, the phase-two banner, and the trailing damage on the bar.
    bannerT: f32 = 0;
    enrageT: f32 = 0;
    chip: f32 = 1;
    chipT: f32 = 0;
    /// J3_FPS_BOSS: this kind comes at once, in its own biome; J3_FPS_BOSS_WATCH: look at it.
    preview: int = 0;
    watch: bool = false;
    /// Debug pack: up to 6 bosses updated together. 0 or 1 means the normal single fight.
    squad: []Boss;
    squadN: int = 0;
    /// Which squad slot `bs.b` currently is, and which slot each hit sphere belongs to.
    active: int = 0;
    partBoss: []int;
    /// Per-slot copies of the weak-point gauges, packed `slot * MAX_SUBS + i`.
    subSave: []f32;
    subOnSave: []bool;
    /// Later bosses in a pack append hit spheres instead of clearing the first's.
    keepParts: bool = false;
}

pub fn create(mem: &Arena): Bosses {
    return Bosses {
        b: Boss { home: Vec3.zero(), pos: Vec3.zero(), vel: Vec3.zero(), from: Vec3.zero(), aim: Vec3.zero(), dir: Vec3.xyz(0, 0, -1) },
        parts: mem.alloc::<Part>(MAX_PARTS), sub: mem.alloc::<f32>(MAX_SUBS), subOn: mem.alloc::<bool>(MAX_SUBS),
        marks: mem.alloc::<Mark>(MAX_MARKS), waves: mem.alloc::<Wave>(MAX_WAVES), projs: mem.alloc::<Proj>(MAX_PROJS),
        patches: mem.alloc::<Patch>(MAX_PATCHES), chunks: mem.alloc::<Chunk>(MAX_CHUNKS), roots: mem.alloc::<Root>(MAX_ROOTS),
        beams: mem.alloc::<Beam>(MAX_BEAMS), puffs: mem.alloc::<Puff>(MAX_PUFFS),
        solid: mem.alloc::<Instance>(MAX_SOLID), hulls: mem.alloc::<Instance>(MAX_SOLID), fx: mem.alloc::<Instance>(MAX_FX),
        blend: mem.alloc::<Mat4>(MAX_BLEND), blendTint: mem.alloc::<Vec3>(MAX_BLEND), blendA: mem.alloc::<f32>(MAX_BLEND),
        cube: Mesh { vao: 0, vbo: 0, count: 0 }, rng: Rng.new(31337), fxRng: Rng.new(8080), edge: Vec3.zero(),
        glowAt: Vec3.zero(), glowColor: Vec3.zero(),
        squad: mem.alloc::<Boss>(6), partBoss: mem.alloc::<int>(MAX_PARTS),
        subSave: mem.alloc::<f32>(6 * MAX_SUBS), subOnSave: mem.alloc::<bool>(6 * MAX_SUBS),
    };
}

pub fn upload(bs: &Bosses, mem: &Arena) {
    bs.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

pub fn name(kind: int): string {
    if kind == COLOSSUS { return "COLOSSUS"; }
    if kind == SAUCER { return "SAUCER"; }
    if kind == RIME { return "RIME"; }
    if kind == CINDER { return "CINDER"; }
    if kind == HEARTWOOD { return "HEARTWOOD"; }
    return "MARQUEE";
}

pub fn title(kind: int): string {
    if kind == COLOSSUS { return "THE FURNACE GIANT"; }
    if kind == SAUCER { return "THE SKY RAIDER"; }
    if kind == RIME { return "THE FROZEN BRUTE"; }
    if kind == CINDER { return "THE WALKING FURNACE"; }
    if kind == HEARTWOOD { return "THE HUNGRY GROVE"; }
    return "THE NEON SHOWMAN";
}

/// The boss's colour on the health bar, minimap and outline.
pub fn accent(kind: int): Vec3 {
    if kind == COLOSSUS { return Vec3.xyz(1, 0.55, 0.15); }
    if kind == SAUCER { return Vec3.xyz(0.3, 0.95, 1); }
    if kind == RIME { return Vec3.xyz(0.6, 0.85, 1); }
    if kind == CINDER { return Vec3.xyz(1, 0.3, 0.1); }
    if kind == HEARTWOOD { return Vec3.xyz(0.55, 1, 0.3); }
    return Vec3.xyz(1, 0.35, 0.85);
}

/// Every hazard gone: the boss died, or the run ended.
pub fn clearHazards(bs: &Bosses) {
    let i = 0;
    while i < MAX_MARKS { bs.marks[i].live = false; i += 1; }
    i = 0;
    while i < MAX_WAVES { bs.waves[i].live = false; i += 1; }
    i = 0;
    while i < MAX_PROJS { bs.projs[i].live = false; i += 1; }
    i = 0;
    while i < MAX_PATCHES { bs.patches[i].live = false; i += 1; }
    i = 0;
    while i < MAX_CHUNKS { bs.chunks[i].live = false; i += 1; }
    i = 0;
    while i < MAX_ROOTS { bs.roots[i].live = false; i += 1; }
    i = 0;
    while i < MAX_BEAMS { bs.beams[i].live = false; i += 1; }
}

// ---- Directions and ground ----

pub fn forward(yaw: f32): Vec3 {
    return Vec3.xyz(0 - sin(yaw), 0, 0 - cos(yaw));
}

pub fn right(yaw: f32): Vec3 {
    return Vec3.xyz(cos(yaw), 0, 0 - sin(yaw));
}

/// The yaw that faces from `a` toward `b`.
pub fn yawTo(a: Vec3, b: Vec3): f32 {
    return atan2(0 - (b.x - a.x), 0 - (b.z - a.z));
}

/// `from` turned toward `to` by at most `step` radians, the short way round.
pub fn turn(from: f32, to: f32, step: f32): f32 {
    let d = to - from;
    while d > PI { d -= TAU; }
    while d < 0 - PI { d += TAU; }
    return from + clamp(d, 0 - step, step);
}

pub fn flat(v: Vec3): Vec3 {
    return Vec3.xyz(v.x, 0, v.z);
}

pub fn flatDist(a: Vec3, b: Vec3): f32 {
    let dx = a.x - b.x;
    let dz = a.z - b.z;
    return sqrt(dx * dx + dz * dz);
}

/// The boss's frame: at `pos`, local -z along `forward(yaw)`.
pub fn frame(pos: Vec3, yaw: f32): Mat4 {
    return Mat4.translate(pos.x, pos.y, pos.z).mul(Mat4.rotate(Vec3.up(), yaw));
}

/// A box frame from three axes whose lengths are the box's size, centred on `at`.
pub fn basis(at: Vec3, x: Vec3, y: Vec3, z: Vec3): Mat4 {
    let m = Mat4.identity();
    m.m[0] = x.x; m.m[1] = x.y; m.m[2] = x.z;
    m.m[4] = y.x; m.m[5] = y.y; m.m[6] = y.z;
    m.m[8] = z.x; m.m[9] = z.y; m.m[10] = z.z;
    m.m[12] = at.x; m.m[13] = at.y; m.m[14] = at.z;
    return m;
}

/// The highest top of anything within `r` of x/z that isn't above `below`, or -100 over a pit.
pub fn groundTop(lvl: &Level, x: f32, z: f32, r: f32, below: f32): f32 {
    let best: f32 = -100;
    let s = scan(lvl, Vec3.xyz(x - r, 0, z - r), Vec3.xyz(x + r, 0, z + r));
    let i = next(lvl, &s);
    while i >= 0 {
        let b = lvl.boxes[i];
        if b.kind != BARRIER && b.hi.y <= below && b.hi.y > best
            && x + r > b.lo.x && x - r < b.hi.x && z + r > b.lo.z && z - r < b.hi.z {
            best = b.hi.y;
        }
        i = next(lvl, &s);
    }
    return best;
}

/// Whether something within `r` of x/z rises more than `climb` above `from` (a wall, a gate,
/// the world's edge) where a body `tall` high would be.
pub fn walled(lvl: &Level, x: f32, z: f32, r: f32, from: f32, climb: f32, tall: f32): bool {
    let s = scan(lvl, Vec3.xyz(x - r, 0, z - r), Vec3.xyz(x + r, 0, z + r));
    let i = next(lvl, &s);
    while i >= 0 {
        let b = lvl.boxes[i];
        if b.hi.y > from + climb && b.lo.y < from + tall
            && x + r > b.lo.x && x - r < b.hi.x && z + r > b.lo.z && z - r < b.hi.z {
            return true;
        }
        i = next(lvl, &s);
    }
    return false;
}

/// Walk the boss along the ground at flat `vel`. Each axis stops at anything rising more than
/// `climb` above its feet, or at a drop of more than 3 m; the feet follow the ground. True
/// when something stopped it.
pub fn walk(bs: &Bosses, lvl: &Level, vel: Vec3, r: f32, climb: f32, dt: f32): bool {
    let b = &bs.b;
    let stopped = false;
    let nx = b.pos.x + vel.x * dt;
    if walled(lvl, nx, b.pos.z, r, b.pos.y, climb, 4) || groundTop(lvl, nx, b.pos.z, r * 0.5, b.pos.y + climb) < b.pos.y - 3 {
        stopped = true;
    } else {
        b.pos.x = nx;
    }
    let nz = b.pos.z + vel.z * dt;
    if walled(lvl, b.pos.x, nz, r, b.pos.y, climb, 4) || groundTop(lvl, b.pos.x, nz, r * 0.5, b.pos.y + climb) < b.pos.y - 3 {
        stopped = true;
    } else {
        b.pos.z = nz;
    }
    let g = groundTop(lvl, b.pos.x, b.pos.z, r * 0.5, b.pos.y + climb);
    if g > -50 { b.pos.y = b.pos.y + (g - b.pos.y) * min(dt * 12, 1); }
    return stopped;
}

/// Where the ground is under the player: a box top within a step of their feet, else their feet.
pub fn footing(lvl: &Level, p: &Player): f32 {
    let g = groundTop(lvl, p.pos.x, p.pos.z, 0.3, p.pos.y + 0.3);
    if g < p.pos.y - 6 { return p.pos.y; }
    return g;
}

// ---- Spawning hazards ----

/// A warning ring at `at` filling in over `len` seconds. Its slot, or -1 when all are up.
pub fn mark(bs: &Bosses, at: Vec3, r: f32, len: f32, hot: Vec3): int {
    let i = 0;
    while i < MAX_MARKS && bs.marks[i].live { i += 1; }
    if i == MAX_MARKS { return -1; }
    bs.marks[i] = Mark { at: at, r: r, t: 0, len: len, hot: hot, live: true };
    return i;
}

pub fn wave(bs: &Bosses, at: Vec3, speed: f32, reach: f32, h: f32, dmg: f32, hot: Vec3) {
    let i = 0;
    while i < MAX_WAVES && bs.waves[i].live { i += 1; }
    if i == MAX_WAVES { return; }
    bs.waves[i] = Wave { at: at, r: 0.5, speed: speed, reach: reach, h: h, dmg: dmg, hot: hot, hit: false, live: true };
}

/// A warning painted `len` seconds ahead of its impact, waiting for `fire`.
pub fn paint(bs: &Bosses, at: Vec3, r: f32, len: f32, hot: Vec3): int {
    let m = mark(bs, at, r, len, hot);
    if m >= 0 { bs.marks[m].armed = true; }
    return m;
}

/// Launch a `kind` arc from `from` at painted mark `m`, landing as its ring fills.
pub fn fire(bs: &Bosses, kind: int, from: Vec3, m: int, arc: f32, dmg: f32) {
    let mk = bs.marks[m];
    if !mk.live { return; }
    bs.marks[m].armed = false;
    let i = 0;
    while i < MAX_PROJS && bs.projs[i].live { i += 1; }
    if i == MAX_PROJS { return; }
    bs.projs[i] = Proj { kind: kind, from: from, aim: mk.at, pos: from, vel: Vec3.zero(), t: 0, len: max(mk.len - mk.t, 0.2), arc: arc,
        dmg: dmg, r: mk.r, mark: m, live: true };
}

/// Painted marks not fired at yet.
pub fn armed(bs: &Bosses): int {
    let n = 0;
    let i = 0;
    while i < MAX_MARKS { if bs.marks[i].live && bs.marks[i].armed { n += 1; } i += 1; }
    return n;
}

/// An arc from `from` to `aim` in `len` seconds, peaking `arc` above the straight line, with a
/// warning ring of `r` at `aim` when `warn` is set.
pub fn lob(bs: &Bosses, kind: int, from: Vec3, aim: Vec3, len: f32, arc: f32, dmg: f32, r: f32, warn: bool, hot: Vec3) {
    let i = 0;
    while i < MAX_PROJS && bs.projs[i].live { i += 1; }
    if i == MAX_PROJS { return; }
    let m = -1;
    if warn { m = mark(bs, aim, r, len, hot); }
    bs.projs[i] = Proj { kind: kind, from: from, aim: aim, pos: from, vel: Vec3.zero(), t: 0, len: len, arc: arc, dmg: dmg, r: r, mark: m, live: true };
}

pub fn spike(bs: &Bosses, from: Vec3, vel: Vec3, dmg: f32) {
    let i = 0;
    while i < MAX_PROJS && bs.projs[i].live { i += 1; }
    if i == MAX_PROJS { return; }
    bs.projs[i] = Proj { kind: SPIKE, from: from, aim: from, pos: from, vel: vel, t: 0, len: 3, arc: 0, dmg: dmg, r: 0.8, mark: -1, live: true };
}

/// A burning or icy patch. Fire keeps to MAX_FIRES by putting out the oldest.
pub fn patch(bs: &Bosses, kind: int, at: Vec3, r: f32, life: f32) {
    if kind == FIRE {
        let fires = 0;
        let oldest = -1;
        let i = 0;
        while i < MAX_PATCHES {
            let q = bs.patches[i];
            if q.live && q.kind == FIRE {
                fires += 1;
                if oldest < 0 || q.t > bs.patches[oldest].t { oldest = i; }
            }
            i += 1;
        }
        if fires >= MAX_FIRES { bs.patches[oldest].live = false; }
    }
    let slot = 0;
    while slot < MAX_PATCHES && bs.patches[slot].live { slot += 1; }
    if slot == MAX_PATCHES {
        slot = bs.nextPatch;
        bs.nextPatch = (bs.nextPatch + 1) % MAX_PATCHES;
    }
    bs.patches[slot] = Patch { kind: kind, at: at, r: r, t: 0, life: life, spin: bs.fxRng.unit() * TAU, live: true };
}

pub fn chunk(bs: &Bosses, at: Vec3, half: f32, h: f32, life: f32) {
    let slot = 0;
    while slot < MAX_CHUNKS && bs.chunks[slot].live { slot += 1; }
    if slot == MAX_CHUNKS {
        slot = bs.nextChunk;
        bs.nextChunk = (bs.nextChunk + 1) % MAX_CHUNKS;
        shatter(bs, slot);
    }
    bs.chunks[slot] = Chunk { at: at, half: half, h: h, t: 0, life: life, live: true };
}

/// Break ice block `i` into bits.
pub fn shatter(bs: &Bosses, i: int) {
    let c = bs.chunks[i];
    if !c.live { return; }
    bs.chunks[i].live = false;
    burst(bs, c.at + Vec3.xyz(0, c.h * 0.5, 0), 18, 8, Vec3.xyz(0.75, 0.9, 1), Vec3.xyz(0.3, 0.6, 1));
    sfx.at(sfx.SHATTER, c.at);
}

pub fn root(bs: &Bosses, from: Vec3, dir: Vec3, len: f32, speed: f32, wiggle: f32, dmg: f32) {
    let i = 0;
    while i < MAX_ROOTS && bs.roots[i].live { i += 1; }
    if i == MAX_ROOTS { return; }
    let d = flat(dir).normalize();
    bs.roots[i] = Root { from: from, dir: d, side: Vec3.xyz(0 - d.z, 0, d.x), len: len, head: 0, t: 0, speed: speed,
        wiggle: wiggle, seed: bs.rng.unit() * TAU, dmg: dmg, hit: false, live: true };
}

/// A lane; its slot, or -1 when all are up. With no `dmg` it's only a warning.
pub fn beam(bs: &Bosses, kind: int, from: Vec3, dir: Vec3, len: f32, half: f32, delay: f32, speed: f32, tall: f32, dmg: f32, hot: Vec3): int {
    let i = 0;
    while i < MAX_BEAMS && bs.beams[i].live { i += 1; }
    if i == MAX_BEAMS { return -1; }
    let d = flat(dir).normalize();
    bs.beams[i] = Beam { kind: kind, from: from, dir: d, side: Vec3.xyz(0 - d.z, 0, d.x), len: len, half: half, delay: delay,
        t: 0, speed: speed, tall: tall, dmg: dmg, hot: hot, hit: false, live: true };
    return i;
}

pub fn clearBeams(bs: &Bosses) {
    let i = 0;
    while i < MAX_BEAMS { bs.beams[i].live = false; i += 1; }
}

/// Beams still showing or sweeping.
pub fn beamsLive(bs: &Bosses): int {
    let n = 0;
    let i = 0;
    while i < MAX_BEAMS { if bs.beams[i].live { n += 1; } i += 1; }
    return n;
}

pub fn projsLive(bs: &Bosses): int {
    let n = 0;
    let i = 0;
    while i < MAX_PROJS { if bs.projs[i].live { n += 1; } i += 1; }
    return n;
}

pub fn rootsLive(bs: &Bosses): int {
    let n = 0;
    let i = 0;
    while i < MAX_ROOTS { if bs.roots[i].live { n += 1; } i += 1; }
    return n;
}

pub fn puff(bs: &Bosses, pos: Vec3, vel: Vec3, life: f32, size: f32, grow: f32, fall: f32, tint: Vec3, glow: Vec3) {
    bs.puffs[bs.nextPuff] = Puff { pos: pos, vel: vel, t: life, life: life, size: size, grow: grow, fall: fall, tint: tint, glow: glow };
    bs.nextPuff = (bs.nextPuff + 1) % MAX_PUFFS;
}

/// `n` bits of debris flying out of `at`.
pub fn burst(bs: &Bosses, at: Vec3, n: int, speed: f32, tint: Vec3, glow: Vec3) {
    let i = 0;
    while i < n {
        let d = Vec3.xyz(bs.fxRng.unit() - 0.5, bs.fxRng.unit() * 0.9 + 0.1, bs.fxRng.unit() - 0.5).normalize();
        puff(bs, at, d * (speed * (0.4 + bs.fxRng.unit())), 0.5 + bs.fxRng.unit() * 0.5, 0.12 + bs.fxRng.unit() * 0.22, -0.1, 1, tint, glow);
        i += 1;
    }
}

/// A rising cloud of `n` smoke or steam puffs around `at`.
pub fn smoke(bs: &Bosses, at: Vec3, n: int, spread: f32, tint: Vec3, glow: Vec3) {
    let i = 0;
    while i < n {
        let off = Vec3.xyz(bs.fxRng.unit() - 0.5, 0, bs.fxRng.unit() - 0.5) * spread;
        let up = Vec3.xyz(off.x * 0.6, 1.5 + bs.fxRng.unit() * 2, off.z * 0.6);
        puff(bs, at + off, up, 0.8 + bs.fxRng.unit() * 0.6, 0.25 + bs.fxRng.unit() * 0.25, 0.6, 0, tint, glow);
        i += 1;
    }
}

// ---- Running hazards against the player ----

/// A blast at `at`: the player within `r` (and not far above or below) takes `dmg`.
pub fn blastPlayer(bs: &Bosses, p: &Player, at: Vec3, r: f32, dmg: f32, shove: f32) {
    let mid = p.pos + Vec3.xyz(0, 0.9, 0);
    let off = mid - at;
    if flatDist(mid, at) < r + BODY_R && off.y > -1.5 && off.y < r + 1 {
        let away = flat(off).normalize();
        hurt(p, dmg, away * shove + Vec3.xyz(0, shove * 0.6, 0));
    }
    let far = off.length();
    if far < r * 4 { bs.shake = max(bs.shake, 0.03 * (1 - far / (r * 4))); }
}

/// Along a root line `s` metres from its start.
pub fn rootAt(r: Root, s: f32): Vec3 {
    let w = sin(s * 0.3 + r.seed) * r.wiggle * min(s / 6, 1);
    return r.from + r.dir * s + r.side * w;
}

/// Where along an arc projectile `q` is at `k` (0..1).
pub fn arcAt(q: Proj, k: f32): Vec3 {
    return q.from + (q.aim - q.from) * k + Vec3.xyz(0, q.arc * 4 * k * (1 - k), 0);
}

/// Move the player out of the ice blocks and the boss's body.
fn shove(bs: &Bosses, p: &Player) {
    pushChunks(bs, p);
    if bs.b.kind == 0 || bs.b.dying > 0 { return; }
    pushBulk(bs, p);
    pushParts(bs, p);
}

fn pushChunks(bs: &Bosses, p: &Player) {
    let i = 0;
    while i < MAX_CHUNKS {
        let c = bs.chunks[i];
        i += 1;
        if !c.live || p.pos.y > c.at.y + c.h - 0.05 || p.pos.y + BODY_H < c.at.y { continue; }
        let dx = p.pos.x - c.at.x;
        let dz = p.pos.z - c.at.z;
        let reach = c.half + BODY_R;
        if abs(dx) >= reach || abs(dz) >= reach { continue; }
        if reach - abs(dx) < reach - abs(dz) {
            p.pos.x = c.at.x + (if dx < 0 { 0 - reach } else { reach });
            if p.vel.x * dx < 0 { p.vel.x = 0; }
        } else {
            p.pos.z = c.at.z + (if dz < 0 { 0 - reach } else { reach });
            if p.vel.z * dz < 0 { p.vel.z = 0; }
        }
    }
}

/// Out along `dir` (flat, unit) to `reach` from `centre`, losing speed into it.
fn pushOut(p: &Player, centre: Vec3, dir: Vec3, reach: f32) {
    p.pos.x = centre.x + dir.x * reach;
    p.pos.z = centre.z + dir.z * reach;
    let into = p.vel.x * dir.x + p.vel.z * dir.z;
    if into < 0 {
        p.vel.x = p.vel.x - dir.x * into;
        p.vel.z = p.vel.z - dir.z * into;
    }
}

fn pushBulk(bs: &Bosses, p: &Player) {
    let b = bs.b;
    if bs.bulkR <= 0 || p.pos.y >= bs.bulkHi || p.pos.y + BODY_H <= bs.bulkLo { return; }
    let off = flat(p.pos - b.pos);
    let h = off.length();
    let reach = bs.bulkR + BODY_R;
    if h >= reach { return; }
    let dir = if h > 0.001 { off * (1 / h) } else { forward(b.yaw) * -1 };
    pushOut(p, b.pos, dir, reach);
}

fn pushParts(bs: &Bosses, p: &Player) {
    let i = 0;
    while i < bs.nparts {
        let q = bs.parts[i];
        i += 1;
        // Nearest point of the player's upright segment to the sphere's centre.
        let y = clamp(q.at.y, p.pos.y + BODY_R, p.pos.y + BODY_H - BODY_R);
        let off = Vec3.xyz(p.pos.x - q.at.x, y - q.at.y, p.pos.z - q.at.z);
        let touch = q.r + BODY_R;
        let far = off.length();
        if far >= touch || far < 0.0001 { continue; }
        let side = flat(off);
        let h = side.length();
        if h < 0.001 { side = forward(bs.b.yaw) * -1; h = 1; }
        // Out sideways far enough that the segment clears the sphere.
        let need = sqrt(max(touch * touch - off.y * off.y, 0));
        pushOut(p, q.at, side * (1 / h), need);
    }
}

/// Hazards move, go off and hurt the player. Ice patches under the player's feet make the next
/// frame's footing ice.
pub fn hazards(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    bs.clock += dt;
    bs.shake = bs.shake * max(1 - dt * 6, 0);
    bs.hitT -= dt;
    bs.critT -= dt;
    bs.burnT -= dt;
    stepMarks(bs, dt);
    stepWaves(bs, p, dt);
    stepProjs(bs, p, lvl, dt);
    stepPatches(bs, p, dt);
    stepChunks(bs, dt);
    stepRoots(bs, p, dt);
    stepBeams(bs, p, dt);
    stepPuffs(bs, dt);
    shove(bs, p);
}

fn stepMarks(bs: &Bosses, dt: f32) {
    let i = 0;
    while i < MAX_MARKS {
        let m = &bs.marks[i];
        if m.live {
            m.t += dt;
            if m.t > m.len + 0.15 { m.live = false; }
        }
        i += 1;
    }
}

fn stepWaves(bs: &Bosses, p: &Player, dt: f32) {
    let feet = p.pos;
    let i = 0;
    while i < MAX_WAVES {
        let w = &bs.waves[i];
        if w.live {
            let prev = w.r;
            w.r += w.speed * dt;
            let d = flatDist(feet, w.at);
            let up = feet.y - w.at.y;
            if !w.hit && d > prev - 0.8 && d < w.r + 0.8 && up > -0.6 && up < w.h {
                let away = flat(feet - w.at).normalize();
                if hurt(p, w.dmg, away * 9 + Vec3.xyz(0, 7, 0)) { bs.shake = max(bs.shake, 0.05); }
                w.hit = true;
            }
            // Dust kicked up along the front.
            if bs.fxRng.unit() < dt * 30 {
                let a = bs.fxRng.unit() * TAU;
                puff(bs, w.at + Vec3.xyz(cos(a) * w.r, 0.2, sin(a) * w.r), Vec3.xyz(cos(a) * 3, 2.5, sin(a) * 3), 0.6, 0.45, 1.2, 0,
                    Vec3.xyz(0.55, 0.5, 0.45), w.hot * 0.3);
            }
            if w.r >= w.reach { w.live = false; }
        }
        i += 1;
    }
}

/// A spike's flight this frame: into the player's chest, or the ground.
fn stepSpike(bs: &Bosses, i: int, p: &Player, lvl: &Level, dt: f32) {
    let q = &bs.projs[i];
    let mid = p.pos + Vec3.xyz(0, 0.9, 0);
    q.vel.y -= 4 * dt;
    let was = q.pos;
    q.pos = q.pos + q.vel * dt;
    let seg = q.pos - was;
    let segLen = seg.length();
    let k = clamp((mid - was).dot(seg) / max(segLen * segLen, 0.0001), 0, 1);
    let near = was + seg * k;
    if (mid - near).length() < q.r {
        hurt(p, q.dmg, q.vel.normalize() * 6 + Vec3.xyz(0, 2, 0));
        burst(bs, near, 6, 4, Vec3.xyz(0.55, 0.38, 0.2), Vec3.zero());
        q.live = false;
    } else if q.t > q.len || groundTop(lvl, q.pos.x, q.pos.z, 0.1, q.pos.y + 0.05) >= q.pos.y - 0.05 {
        burst(bs, q.pos, 5, 3, Vec3.xyz(0.55, 0.38, 0.2), Vec3.zero());
        q.live = false;
    }
}

/// An arc's flight this frame, trailing smoke or embers, landing at its end.
fn stepArc(bs: &Bosses, i: int, p: &Player, dt: f32) {
    let q = &bs.projs[i];
    let k = min(q.t / q.len, 1);
    let was = q.pos;
    q.pos = arcAt(bs.projs[i], k);
    q.vel = (q.pos - was) * (1 / max(dt, 0.0001));
    if q.kind == MISSILE && bs.fxRng.unit() < dt * 40 {
        puff(bs, q.pos, Vec3.xyz(0, 0.5, 0), 0.45, 0.16, 0.45, 0, Vec3.xyz(0.8, 0.8, 0.85), Vec3.xyz(0.1, 0.1, 0.1));
    }
    if q.kind == BOMB && bs.fxRng.unit() < dt * 25 {
        puff(bs, q.pos, Vec3.xyz(0, 1, 0), 0.4, 0.3, 0.6, 0, Vec3.zero(), Vec3.xyz(2.4, 0.8, 0.1));
    }
    if k >= 1 {
        land(bs, bs.projs[i], p);
        if q.mark >= 0 { bs.marks[q.mark].live = false; }
        q.live = false;
    }
}

fn stepProjs(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let i = 0;
    while i < MAX_PROJS {
        if bs.projs[i].live {
            bs.projs[i].t += dt;
            if bs.projs[i].kind == SPIKE { stepSpike(bs, i, p, lvl, dt); } else { stepArc(bs, i, p, dt); }
        }
        i += 1;
    }
}

fn stepPatches(bs: &Bosses, p: &Player, dt: f32) {
    let feet = p.pos;
    let onIce = false;
    let i = 0;
    while i < MAX_PATCHES {
        let f = &bs.patches[i];
        if f.live {
            f.t += dt;
            if f.t >= f.life { f.live = false; }
            let d = flatDist(feet, f.at);
            let up = feet.y - f.at.y;
            if f.kind == FIRE && d < f.r && up > -0.4 && up < 1.2 && bs.burnT <= 0 {
                if hurt(p, BURN, Vec3.xyz(0, 3, 0)) { bs.burnT = BURN_EVERY; }
            }
            if f.kind == FIRE && bs.fxRng.unit() < dt * 10 {
                let a = bs.fxRng.unit() * TAU;
                let rr = sqrt(bs.fxRng.unit()) * f.r;
                puff(bs, f.at + Vec3.xyz(cos(a) * rr, 0.2, sin(a) * rr), Vec3.xyz(0, 2.5, 0), 0.5, 0.35, 0.4, 0, Vec3.zero(), Vec3.xyz(2.6, 0.9, 0.15));
            }
            if f.kind == FROST && p.onGround && d < f.r && abs(up) < 0.4 { onIce = true; }
        }
        i += 1;
    }
    if onIce { p.surface = ICE; }
}

fn stepChunks(bs: &Bosses, dt: f32) {
    let i = 0;
    while i < MAX_CHUNKS {
        let c = &bs.chunks[i];
        if c.live {
            c.t += dt;
            if c.t >= c.life { shatter(bs, i); }
        }
        i += 1;
    }
}

/// Whether the player's feet are on root line `r` right now.
fn onRoot(r: Root, feet: Vec3): bool {
    let s: f32 = 0;
    while s <= r.len {
        let at = rootAt(r, s);
        let up = feet.y - at.y;
        if flatDist(feet, at) < 1.3 && up > -0.5 && up < 1.1 { return true; }
        s += 0.8;
    }
    return false;
}

fn stepRoots(bs: &Bosses, p: &Player, dt: f32) {
    let i = 0;
    while i < MAX_ROOTS {
        let r = &bs.roots[i];
        if r.live {
            if r.head < r.len {
                r.head = min(r.head + r.speed * dt, r.len);
                // Dirt thrown up where the crack is running.
                if bs.fxRng.unit() < dt * 30 {
                    puff(bs, rootAt(bs.roots[i], r.head), Vec3.xyz(0, 3, 0), 0.4, 0.25, 0.2, 1, Vec3.xyz(0.4, 0.3, 0.18), Vec3.zero());
                }
            } else {
                let before = r.t;
                r.t += dt;
                if before < ROOT_WAIT && r.t >= ROOT_WAIT { sfx.at(sfx.SLAM, rootAt(bs.roots[i], r.len * 0.5)); }
                if r.t >= ROOT_WAIT && r.t < ROOT_WAIT + ROOT_UP && !r.hit && onRoot(bs.roots[i], p.pos) {
                    hurt(p, r.dmg, Vec3.xyz(0, 9, 0) + r.side * 2);
                    r.hit = true;
                }
                if r.t >= ROOT_WAIT + ROOT_UP + 0.5 { r.live = false; }
            }
        }
        i += 1;
    }
}

fn stepBeams(bs: &Bosses, p: &Player, dt: f32) {
    let i = 0;
    while i < MAX_BEAMS {
        let bm = &bs.beams[i];
        if bm.live {
            bm.t += dt;
            let s = (bm.t - bm.delay) * bm.speed;
            if s > 0 && !bm.hit && bm.dmg > 0 {
                let rel = p.pos - bm.from;
                let along = rel.dot(bm.dir);
                let across = rel.dot(bm.side);
                if abs(across) < bm.half + BODY_R && along > s - bm.speed * dt - 0.7 && along < s + 0.7 && rel.y > -1.5 && rel.y < bm.tall {
                    hurt(p, bm.dmg, bm.dir * 10 + Vec3.xyz(0, 5, 0));
                    bm.hit = true;
                }
            }
            if s > 0 && s < bm.len && bm.kind == STRAFE && bs.fxRng.unit() < dt * 45 {
                let at = bm.from + bm.dir * s + bm.side * ((bs.fxRng.unit() - 0.5) * bm.half * 2);
                puff(bs, at + Vec3.xyz(0, 0.2, 0), Vec3.xyz(0, 3, 0), 0.4, 0.4, 1.2, 0, Vec3.zero(), bm.hot * 2);
            }
            if s > bm.len + 1 { bm.live = false; }
        }
        i += 1;
    }
}

fn stepPuffs(bs: &Bosses, dt: f32) {
    let i = 0;
    while i < MAX_PUFFS {
        let f = &bs.puffs[i];
        if f.t > 0 {
            f.t -= dt;
            if f.fall > 0 {
                f.vel.y -= 22 * f.fall * dt;
            } else {
                f.vel = f.vel * max(1 - dt * 1.8, 0);
            }
            f.pos = f.pos + f.vel * dt;
            f.size = max(f.size + f.grow * dt, 0.02);
        }
        i += 1;
    }
}

/// An arc projectile reached its mark.
fn land(bs: &Bosses, q: Proj, p: &Player) {
    if q.kind == MISSILE {
        sfx.at(sfx.BOOM, q.aim);
        blastPlayer(bs, p, q.aim, q.r, q.dmg, 9);
        burst(bs, q.aim + Vec3.xyz(0, 0.3, 0), 14, 8, Vec3.xyz(1, 0.6, 0.2), Vec3.xyz(2.5, 0.9, 0.2));
        smoke(bs, q.aim, 5, 1.5, Vec3.xyz(0.4, 0.4, 0.45), Vec3.zero());
    } else if q.kind == BOMB {
        sfx.at(sfx.BOOM, q.aim);
        blastPlayer(bs, p, q.aim, q.r, q.dmg, 8);
        burst(bs, q.aim + Vec3.xyz(0, 0.3, 0), 16, 9, Vec3.xyz(1, 0.45, 0.1), Vec3.xyz(3, 1, 0.1));
        patch(bs, FIRE, q.aim, q.r * 0.85, 7);
    } else if q.kind == CHUNK {
        sfx.at(sfx.SLAM, q.aim);
        blastPlayer(bs, p, q.aim, q.r, q.dmg, 10);
        burst(bs, q.aim + Vec3.xyz(0, 0.5, 0), 10, 6, Vec3.xyz(0.8, 0.92, 1), Vec3.xyz(0.2, 0.4, 0.7));
        chunk(bs, q.aim, 1.1, 2.4, 11);
    }
}

// ---- Parts: hit spheres ----

pub fn clearParts(bs: &Bosses) {
    if bs.keepParts { return; }
    bs.nparts = 0;
    bs.bulkR = 0;
}

/// The cylinder the player can't stand inside: `r` round the boss's feet, `lo` to `hi` high.
pub fn bulk(bs: &Bosses, r: f32, lo: f32, hi: f32) {
    bs.bulkR = r;
    bs.bulkLo = lo;
    bs.bulkHi = hi;
}

pub fn addPart(bs: &Bosses, at: Vec3, r: f32, mult: f32, id: int) {
    if bs.nparts >= MAX_PARTS { return; }
    bs.partBoss[bs.nparts] = bs.active;
    bs.parts[bs.nparts] = Part { at: at, r: r, mult: mult, id: id };
    bs.nparts += 1;
}

fn partLive(bs: &Bosses, i: int): bool {
    if bs.squadN <= 1 { return bs.b.kind != 0 && bs.b.dying <= 0; }
    let who = bs.partBoss[i];
    if who < 0 || who >= bs.squadN { return false; }
    return bs.squad[who].kind != 0 && bs.squad[who].dying <= 0;
}

/// The nearest part along `r` closer than `reach`.
pub fn ray(bs: &Bosses, r: Ray, reach: f32): Hit {
    let best = Hit { part: -1, t: reach };
    if bs.squadN <= 1 && (bs.b.kind == 0 || bs.b.dying > 0) { return best; }
    let i = 0;
    while i < bs.nparts {
        if !partLive(bs, i) { i += 1; continue; }
        let q = bs.parts[i];
        let to = q.at - r.origin;
        let along = to.dot(r.dir);
        let miss = to.dot(to) - along * along;
        if along > 0 - q.r && miss < q.r * q.r {
            let t = max(along - sqrt(q.r * q.r - miss), 0);
            if t < best.t {
                best.part = i;
                best.t = t;
            }
        }
        i += 1;
    }
    return best;
}

/// The part whose surface is nearest `at`, if within `reach` of it; -1 for none.
pub fn nearest(bs: &Bosses, at: Vec3, reach: f32): int {
    if bs.squadN <= 1 && (bs.b.kind == 0 || bs.b.dying > 0) { return -1; }
    let best = -1;
    let bestD = reach;
    let i = 0;
    while i < bs.nparts {
        if !partLive(bs, i) { i += 1; continue; }
        let q = bs.parts[i];
        let d = (q.at - at).length() - q.r;
        if d < bestD {
            best = i;
            bestD = d;
        }
        i += 1;
    }
    return best;
}

/// Part `i` takes `dmg` at `at`, times its multiplier. Returns what it did to the boss.
pub fn wound(bs: &Bosses, i: int, dmg: f32, at: Vec3): f32 {
    let b = &bs.b;
    if i < 0 || i >= bs.nparts || b.kind == 0 || b.dying > 0 { return 0; }
    let q = bs.parts[i];
    if b.intro > 0 {
        burst(bs, at, 2, 4, Vec3.xyz(0.6, 0.6, 0.65), Vec3.zero());
        return 0;
    }
    let dealt = dmg * q.mult;
    b.hp -= dealt;
    b.flash = 0.06;
    if q.id >= SUB && q.id - SUB < MAX_SUBS { bs.sub[q.id - SUB] -= dmg; }
    if q.mult > 1.5 {
        if bs.critT < 0.1 { sfx.play(sfx.CRIT); }
        bs.critT = 0.25;
        burst(bs, at, 5, 7, Vec3.xyz(1, 0.85, 0.3), Vec3.xyz(2.5, 1.8, 0.4));
    } else {
        if bs.hitT < 0.06 { sfx.play(sfx.HIT); }
        burst(bs, at, 2, 5, accent(b.kind), accent(b.kind) * 0.5);
    }
    bs.hitT = 0.12;
    return dealt;
}

/// Where a homing shot should go: the weak point while it's worth it, else the middle.
pub fn aimPoint(bs: &Bosses): Vec3 {
    let best = 0;
    let i = 0;
    while i < bs.nparts {
        if bs.parts[i].mult > bs.parts[best].mult { best = i; }
        i += 1;
    }
    if bs.nparts == 0 { return bs.b.pos; }
    return bs.parts[best].at;
}

// ---- Drawing ----

/// Start a frame's boxes. The outline takes the boss's accent, red and pulsing in phase two.
/// Outline colour for whichever boss is in `bs.b`, without clearing the boxes already queued.
pub fn refreshEdge(bs: &Bosses) {
    let c = accent(bs.b.kind);
    if bs.b.phase2 { c = Vec3.xyz(1.6, 0.2, 0.15) * (0.8 + 0.4 * sin(bs.clock * 6)); }
    bs.edge = c * 1.4;
    bs.edgeW = 0.07;
}

pub fn begin(bs: &Bosses) {
    bs.nsolid = 0;
    bs.nhull = 0;
    bs.nfx = 0;
    bs.nblend = 0;
    refreshEdge(bs);
}

fn put(bs: &Bosses, m: Mat4, tint: Vec3, glow: Vec3) {
    if bs.nsolid >= MAX_SOLID { return; }
    bs.solid[bs.nsolid] = Instance { model: m, tint: tint, emission: glow };
    bs.nsolid += 1;
}

fn shell(bs: &Bosses, m: Mat4) {
    if bs.nhull >= MAX_SOLID { return; }
    bs.hulls[bs.nhull] = Instance { model: m, tint: Vec3.zero(), emission: bs.edge };
    bs.nhull += 1;
}

/// The boss's own box: white while hit.
fn body(bs: &Bosses, m: Mat4, tint: Vec3, glow: Vec3) {
    if bs.b.flash > 0 {
        put(bs, m, Vec3.xyz(1, 1, 1), Vec3.xyz(1.5, 1.5, 1.5));
    } else {
        put(bs, m, tint, glow);
    }
}

/// A box of the boss in its frame `base`, with an outline.
pub fn box(bs: &Bosses, base: Mat4, at: Vec3, size: Vec3, tint: Vec3, glow: Vec3) {
    let at0 = base.mul(Mat4.translate(at.x, at.y, at.z));
    body(bs, at0.mul(Mat4.scale(size.x, size.y, size.z)), tint, glow);
    let w = bs.edgeW * 2;
    shell(bs, at0.mul(Mat4.scale(size.x + w, size.y + w, size.z + w)));
}

/// A small detail box, no outline.
pub fn bit(bs: &Bosses, base: Mat4, at: Vec3, size: Vec3, tint: Vec3, glow: Vec3) {
    body(bs, base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(size.x, size.y, size.z)), tint, glow);
}

/// A box pitched about x (positive tips its top back) and rolled about z, with an outline.
pub fn tilt(bs: &Bosses, base: Mat4, at: Vec3, size: Vec3, pitch: f32, roll: f32, tint: Vec3, glow: Vec3) {
    let at0 = base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), pitch)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), roll));
    body(bs, at0.mul(Mat4.scale(size.x, size.y, size.z)), tint, glow);
    let w = bs.edgeW * 2;
    shell(bs, at0.mul(Mat4.scale(size.x + w, size.y + w, size.z + w)));
}

/// A beam of the boss from world `a` to `b`, `w` by `d` thick, with an outline.
pub fn limb(bs: &Bosses, a: Vec3, b: Vec3, w: f32, d: f32, tint: Vec3, glow: Vec3) {
    let y = b - a;
    let len = y.length();
    if len < 0.001 { return; }
    let up = y * (1 / len);
    let ref = Vec3.xyz(1, 0, 0);
    if abs(up.x) > 0.9 { ref = Vec3.xyz(0, 0, 1); }
    let x = up.cross(ref).normalize();
    let z = x.cross(up).normalize();
    let mid = (a + b) * 0.5;
    body(bs, basis(mid, x * w, y, z * d), tint, glow);
    let e = bs.edgeW * 2;
    shell(bs, basis(mid, x * (w + e), up * (len + e), z * (d + e)));
}

/// A camera-only glowing box: warnings, flames, puffs.
pub fn glow(bs: &Bosses, m: Mat4, tint: Vec3, glowC: Vec3) {
    if bs.nfx >= MAX_FX { return; }
    bs.fx[bs.nfx] = Instance { model: m, tint: tint, emission: glowC };
    bs.nfx += 1;
}

pub fn glowBox(bs: &Bosses, at: Vec3, size: Vec3, tint: Vec3, glowC: Vec3) {
    glow(bs, Mat4.translate(at.x, at.y, at.z).mul(Mat4.scale(size.x, size.y, size.z)), tint, glowC);
}

/// A glowing ring on the ground: `thick` wide, `h` tall.
pub fn ring(bs: &Bosses, at: Vec3, r: f32, thick: f32, h: f32, glowC: Vec3) {
    let n = mini(96, 12 + int(r * 2.2));
    let seg = TAU * r / f32(n) * 1.08;
    let k = 0;
    while k < n {
        let a = f32(k) * TAU / f32(n);
        let m = Mat4.translate(at.x + cos(a) * r, at.y + h * 0.5, at.z + sin(a) * r).mul(Mat4.rotate(Vec3.up(), 0 - a))
            .mul(Mat4.scale(thick, h, seg));
        glow(bs, m, Vec3.zero(), glowC);
        k += 1;
    }
}

/// A see-through strip on the ground from `a` to `b`, `half` wide each side.
pub fn stripe(bs: &Bosses, a: Vec3, b: Vec3, half: f32, tint: Vec3, alpha: f32) {
    if bs.nblend >= MAX_BLEND { return; }
    let along = flat(b - a);
    let len = along.length();
    if len < 0.01 { return; }
    let d = along * (1 / len);
    let side = Vec3.xyz(0 - d.z, 0, d.x);
    let mid = (a + b) * 0.5 + Vec3.xyz(0, 0.05, 0);
    bs.blend[bs.nblend] = basis(mid, side * (half * 2), Vec3.xyz(0, 0.04, 0), d * len);
    bs.blendTint[bs.nblend] = tint;
    bs.blendA[bs.nblend] = alpha;
    bs.nblend += 1;
}

/// A thin glowing line of boxes along the ground from `a` to `b`.
pub fn line(bs: &Bosses, a: Vec3, b: Vec3, w: f32, glowC: Vec3) {
    let along = flat(b - a);
    let len = along.length();
    if len < 0.01 { return; }
    let d = along * (1 / len);
    let side = Vec3.xyz(0 - d.z, 0, d.x);
    glow(bs, basis((a + b) * 0.5 + Vec3.xyz(0, 0.07, 0), side * w, Vec3.xyz(0, 0.06, 0), d * len), Vec3.zero(), glowC);
}

/// A glowing beam of light between two points: a laser, a bolt of lightning.
pub fn glowRay(bs: &Bosses, a: Vec3, b: Vec3, w: f32, tint: Vec3, glowC: Vec3) {
    let y = b - a;
    let len = y.length();
    if len < 0.001 { return; }
    let up = y * (1 / len);
    let ref = Vec3.xyz(1, 0, 0);
    if abs(up.x) > 0.9 { ref = Vec3.xyz(0, 0, 1); }
    let x = up.cross(ref).normalize();
    let z = x.cross(up).normalize();
    glow(bs, basis((a + b) * 0.5, x * w, y, z * w), tint, glowC);
}

/// Every hazard and puff, as camera-only boxes and strips.
pub fn drawHazards(bs: &Bosses) {
    drawMarks(bs);
    drawWaves(bs);
    drawProjs(bs);
    drawPatches(bs);
    drawChunks(bs);
    drawRoots(bs);
    drawBeams(bs);
    drawPuffs(bs);
}

fn drawMarks(bs: &Bosses) {
    let up = Vec3.xyz(0, 1, 0);
    let i = 0;
    while i < MAX_MARKS {
        let m = bs.marks[i];
        if m.live {
            let k = clamp(m.t / m.len, 0, 1);
            let pulse = 0.7 + 0.3 * sin(bs.clock * (8 + k * 16));
            ring(bs, m.at + up * 0.02, m.r, 0.22, 0.1, m.hot * (1.3 * pulse));
            ring(bs, m.at + up * 0.02, max(m.r * k, 0.25), 0.14, 0.07, m.hot * (0.5 + k));
            glowBox(bs, m.at + up * 0.06, Vec3.xyz(m.r * 0.35, 0.04, 0.14), Vec3.zero(), m.hot);
            glowBox(bs, m.at + up * 0.06, Vec3.xyz(0.14, 0.04, m.r * 0.35), Vec3.zero(), m.hot);
        }
        i += 1;
    }
}

fn drawWaves(bs: &Bosses) {
    let i = 0;
    while i < MAX_WAVES {
        let w = bs.waves[i];
        if w.live {
            let fade = clamp((w.reach - w.r) / 6, 0.2, 1);
            ring(bs, w.at, w.r, 0.5, w.h, w.hot * (2.2 * fade));
            ring(bs, w.at, max(w.r - 0.9, 0.3), 0.35, w.h * 0.45, w.hot * (0.8 * fade));
        }
        i += 1;
    }
}

fn drawProj(bs: &Bosses, q: Proj) {
    let dir = q.vel.normalize();
    if dir.length() < 0.5 { dir = Vec3.xyz(0, -1, 0); }
    let ref = Vec3.xyz(0, 1, 0);
    if abs(dir.y) > 0.9 { ref = Vec3.xyz(1, 0, 0); }
    let x = dir.cross(ref).normalize();
    let y = x.cross(dir).normalize();
    if q.kind == MISSILE {
        glow(bs, basis(q.pos, x * 0.28, y * 0.28, dir * 0.9), Vec3.xyz(0.9, 0.9, 0.95), Vec3.xyz(0.4, 0.4, 0.45));
        glow(bs, basis(q.pos + dir * 0.5, x * 0.2, y * 0.2, dir * 0.2), Vec3.zero(), Vec3.xyz(3, 0.4, 0.3));
        glow(bs, basis(q.pos - dir * 0.55, x * 0.22, y * 0.22, dir * 0.3), Vec3.zero(), Vec3.xyz(3, 1.8, 0.5));
    } else if q.kind == BOMB {
        let s = Mat4.translate(q.pos.x, q.pos.y, q.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 1, 0).normalize(), q.t * 7));
        glow(bs, s.mul(Mat4.scale(0.8, 0.8, 0.8)), Vec3.xyz(0.15, 0.1, 0.1), Vec3.xyz(1.6, 0.5, 0.05));
        glow(bs, s.mul(Mat4.scale(0.95, 0.3, 0.3)), Vec3.zero(), Vec3.xyz(3, 1.2, 0.2));
    } else if q.kind == CHUNK {
        let spin = Mat4.translate(q.pos.x, q.pos.y, q.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 0.3, 0.5).normalize(), q.t * 5));
        glow(bs, spin.mul(Mat4.scale(1.3, 1.3, 1.3)), Vec3.xyz(0.75, 0.9, 1), Vec3.xyz(0.25, 0.5, 0.9));
    } else {
        glow(bs, basis(q.pos, x * 0.16, y * 0.16, dir * 1.4), Vec3.xyz(0.55, 0.38, 0.2), Vec3.xyz(0.1, 0.06, 0.02));
        glow(bs, basis(q.pos + dir * 0.75, x * 0.1, y * 0.1, dir * 0.25), Vec3.zero(), Vec3.xyz(1, 2.6, 0.4));
    }
}

fn drawProjs(bs: &Bosses) {
    let i = 0;
    while i < MAX_PROJS {
        if bs.projs[i].live { drawProj(bs, bs.projs[i]); }
        i += 1;
    }
}

fn drawPatch(bs: &Bosses, f: Patch) {
    let fade = clamp((f.life - f.t) / 1.5, 0, 1);
    let rot = Mat4.translate(f.at.x, f.at.y + 0.03, f.at.z).mul(Mat4.rotate(Vec3.up(), f.spin));
    if f.kind == FROST {
        glow(bs, rot.mul(Mat4.scale(f.r * 1.6, 0.04, f.r * 1.6)), Vec3.xyz(0.45, 0.72, 1) * fade, Vec3.xyz(0.15, 0.45, 0.9) * fade);
        return;
    }
    glow(bs, rot.mul(Mat4.scale(f.r * 1.6, 0.05, f.r * 1.6)), Vec3.xyz(0.08, 0.05, 0.04), Vec3.xyz(1.2, 0.3, 0.05) * fade);
    let k = 0;
    while k < 7 {
        let a = f.spin + f32(k) * 0.9;
        let rr = f.r * (0.25 + 0.1 * f32(k % 4));
        let h = (0.5 + 0.5 * sin(bs.clock * 9 + f32(k) * 1.7)) * 1.1 * fade + 0.2;
        glowBox(bs, f.at + Vec3.xyz(cos(a) * rr, h * 0.5, sin(a) * rr), Vec3.xyz(0.35, h, 0.35), Vec3.zero(),
            Vec3.xyz(3, 1 + 0.6 * f32(k % 2), 0.15) * fade);
        k += 1;
    }
}

fn drawPatches(bs: &Bosses) {
    let i = 0;
    while i < MAX_PATCHES {
        if bs.patches[i].live { drawPatch(bs, bs.patches[i]); }
        i += 1;
    }
}

fn drawChunks(bs: &Bosses) {
    let i = 0;
    while i < MAX_CHUNKS {
        let c = bs.chunks[i];
        if c.live {
            // Blinks in its last second and a half.
            let blink = c.life - c.t > 1.5 || sin(c.t * 25) > 0;
            let g = Vec3.xyz(0.15, 0.35, 0.6);
            if !blink { g = Vec3.xyz(0.8, 1.2, 1.6); }
            let m = Mat4.translate(c.at.x, c.at.y + c.h * 0.5, c.at.z);
            put(bs, m.mul(Mat4.scale(c.half * 2, c.h, c.half * 2)), Vec3.xyz(0.72, 0.88, 1), g);
            glow(bs, m.mul(Mat4.translate(0, c.h * 0.5, 0)).mul(Mat4.rotate(Vec3.up(), 0.785)).mul(Mat4.scale(c.half * 1.2, 0.5, c.half * 1.2)),
                Vec3.xyz(0.85, 0.95, 1), Vec3.xyz(0.3, 0.6, 1));
        }
        i += 1;
    }
}

/// A crack running along the ground that brightens as it's about to burst, then spikes.
fn drawRoot(bs: &Bosses, r: Root) {
    let rise: f32 = 0;
    if r.head >= r.len && r.t >= ROOT_WAIT {
        rise = clamp((r.t - ROOT_WAIT) / 0.12, 0, 1);
        if r.t > ROOT_WAIT + ROOT_UP { rise = clamp(1 - (r.t - ROOT_WAIT - ROOT_UP) / 0.5, 0, 1); }
    }
    let hotter: f32 = 1;
    if r.head >= r.len { hotter = 1 + clamp(r.t / ROOT_WAIT, 0, 1) * 2; }
    let s: f32 = 0;
    let k = 0;
    while s < r.head {
        let a = rootAt(r, s);
        let b = rootAt(r, min(s + 0.9, r.head));
        line(bs, a, b, 0.4, Vec3.xyz(0.8, 1.6, 0.3) * hotter);
        if rise > 0 && k % 2 == 0 {
            let h = 1.9 * rise * (0.75 + 0.25 * sin(f32(k) * 2.3 + r.seed));
            let lean = sin(f32(k) * 1.7 + r.seed) * 0.3;
            glow(bs, Mat4.translate(a.x, a.y + h * 0.5, a.z).mul(Mat4.rotate(r.dir, lean)).mul(Mat4.scale(0.45, h, 0.45)),
                Vec3.xyz(0.45, 0.3, 0.18), Vec3.xyz(0.05, 0.03, 0.01));
            glowBox(bs, Vec3.xyz(a.x, a.y + h, a.z), Vec3.xyz(0.25, 0.3, 0.25), Vec3.zero(), Vec3.xyz(0.8, 2.2, 0.3));
        }
        s += 0.9;
        k += 1;
    }
}

fn drawRoots(bs: &Bosses) {
    let i = 0;
    while i < MAX_ROOTS {
        if bs.roots[i].live { drawRoot(bs, bs.roots[i]); }
        i += 1;
    }
}

/// A lane: a see-through strip with glowing edges and chevrons, then whatever sweeps it.
fn drawBeam(bs: &Bosses, bm: Beam, i: int) {
    let s = (bm.t - bm.delay) * bm.speed;
    let end = bm.from + bm.dir * bm.len;
    let warm = clamp(bm.t / max(bm.delay, 0.01), 0, 1);
    let a = 0.14 + 0.16 * warm;
    if s > bm.len { a = a * clamp(1 - (s - bm.len), 0, 1); }
    stripe(bs, bm.from, end, bm.half, bm.hot, a);
    let pulse = 0.7 + 0.3 * sin(bs.clock * 10 + f32(i));
    line(bs, bm.from + bm.side * bm.half, end + bm.side * bm.half, 0.12, bm.hot * (1.5 * pulse));
    line(bs, bm.from - bm.side * bm.half, end - bm.side * bm.half, 0.12, bm.hot * (1.5 * pulse));
    // Chevrons pointing the way it will sweep, gone behind the sweep.
    let c: f32 = 2;
    while c < bm.len {
        if s < c {
            let tip = bm.from + bm.dir * c;
            line(bs, tip + bm.side * (bm.half * 0.6), tip + bm.dir * 0.9, 0.12, bm.hot * (0.6 + warm));
            line(bs, tip - bm.side * (bm.half * 0.6), tip + bm.dir * 0.9, 0.12, bm.hot * (0.6 + warm));
        }
        c += 4;
    }
    if s > 0 && s < bm.len && bm.kind == BAR {
        let at = bm.from + bm.dir * s + Vec3.xyz(0, bm.tall * 0.55, 0);
        glow(bs, basis(at, bm.side * (bm.half * 2 + 0.4), Vec3.xyz(0, 0.32, 0), bm.dir * 0.32), Vec3.zero(), bm.hot * 4);
        glow(bs, basis(at, bm.side * (bm.half * 2 + 0.2), Vec3.xyz(0, 0.12, 0), bm.dir * 0.12), Vec3.xyz(1, 1, 1), Vec3.xyz(3, 3, 3));
        glowBox(bs, at + bm.side * (bm.half + 0.2), Vec3.xyz(0.4, 0.9, 0.4), Vec3.zero(), bm.hot * 3);
        glowBox(bs, at - bm.side * (bm.half + 0.2), Vec3.xyz(0.4, 0.9, 0.4), Vec3.zero(), bm.hot * 3);
    }
}

fn drawBeams(bs: &Bosses) {
    let i = 0;
    while i < MAX_BEAMS {
        if bs.beams[i].live { drawBeam(bs, bs.beams[i], i); }
        i += 1;
    }
}

fn drawPuffs(bs: &Bosses) {
    let i = 0;
    while i < MAX_PUFFS {
        let f = bs.puffs[i];
        if f.t > 0 {
            let k = f.t / f.life;
            let s = f.size * (if f.fall > 0 { min(k * 3, 1) } else { 0.35 + 0.65 * k });
            glow(bs, Mat4.translate(f.pos.x, f.pos.y, f.pos.z).mul(Mat4.rotate(Vec3.xyz(0.3, 1, 0.2).normalize(), f.t * 3 + f32(i)))
                .mul(Mat4.scale(s, s, s)), f.tint, f.glow * k);
        }
        i += 1;
    }
}

/// Both passes: the boss's boxes (and ice blocks); the camera pass adds outlines and effects.
pub fn draw(bs: &Bosses) {
    if bs.nsolid + bs.nfx == 0 { return; }
    gfx.surface(gfx.plainSurface());
    if bs.nsolid > 0 { gfx.drawInstances(bs.cube, []Instance { ptr: bs.solid.ptr, len: bs.nsolid }); }
    if !gfx.inCameraPass() { return; }
    if bs.nhull > 0 { gfx.drawHullInstances(bs.cube, []Instance { ptr: bs.hulls.ptr, len: bs.nhull }); }
    if bs.nfx > 0 { gfx.drawInstances(bs.cube, []Instance { ptr: bs.fx.ptr, len: bs.nfx }); }
}

/// The see-through lane strips, after everything opaque.
pub fn drawBlended(bs: &Bosses) {
    let i = 0;
    while i < bs.nblend {
        gfx.material(bs.blendTint[i], bs.blendTint[i] * 0.8);
        gfx.drawBlended(bs.cube, bs.blend[i], bs.blendA[i]);
        i += 1;
    }
    gfx.surface(gfx.plainSurface());
}
