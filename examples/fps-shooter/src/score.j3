// Score and combo: hits, kills and air time pay points times a combo multiplier that grows with
// each one and drops after a few quiet seconds (staying airborne keeps it alive). Small popups
// by the crosshair say what paid; long air time gets its own callout that grows with each tier.

module fps_shooter.score;

use j3.game;
use j3.game.Font;
use j3.math.{ Vec2, Vec3, clamp, max, min, sin };
use j3.memory.Arena;
use fps_shooter.enemies.Enemies;
use fps_shooter.player.Player;

const HIT_PTS: f32 = 10;
const HIT_HEAT: f32 = 0.03;
const KILL_PTS: f32 = 100;
const KILL_HEAT: f32 = 0.4;
/// A kill while you're off the ground pays this many times over.
const AIR_KILL: f32 = 2;
/// Kills this close together chain into DOUBLE, TRIPLE...
const STREAK_TIME: f32 = 1.5;
const STREAK_PTS: f32 = 75;
/// Points a second in the air, times the air tier.
const AIR_PTS: f32 = 30;
/// Each air tier reached adds this times the tier to the combo.
const TIER_HEAT: f32 = 0.25;
const TIERS: int = 8;
/// Quiet seconds before the combo drops a rank.
const COMBO_TIME: f32 = 4;
/// Above Z's 64, so Z is the top letter rather than the moment the multiplier stops.
const MAX_MULT: f32 = 70;
const RANKS: int = 11;
const POPS: int = 6;
const POP_LIFE: f32 = 1.4;
const SHOUT_LIFE: f32 = 1.8;

struct Pop {
    msg: string;
    pts: int;
    /// Air seconds to show, or 0.
    secs: f32;
    t: f32;
    tint: Vec3;
}

pub struct Score {
    total: f32;
    /// The counter rolls up toward `total`.
    shown: f32;
    /// Multiplier is 1 + heat.
    heat: f32;
    comboT: f32;
    /// Flash on a gain.
    bump: f32;
    /// Seconds off the ground, and what they've paid so far.
    air: f32;
    airPts: f32;
    tier: int;
    /// The air callout: which tier, and how long it's been up.
    shout: int;
    shoutT: f32;
    /// Last seen from the enemies, to spot new ones.
    hits: int;
    kills: int;
    streak: int;
    streakT: f32;
    /// Combo rank, 0 = F up to 10 = Z, and time since it last went up.
    rank: int;
    rankT: f32;
    /// The run that just ended: its score and top rank, and the best score this session.
    last: f32 = 0;
    lastRank: int = 0;
    best: f32 = 0;
    newBest: bool = false;
    pops: []Pop;
    next: int;
    small: Font;
    mid: Font;
    big: Font;
    huge: Font;
}

pub fn create(mem: &Arena): Score {
    let none = Font { raw: 0 };
    return Score {
        total: 0, shown: 0, heat: 0, comboT: 0, bump: 0, air: 0, airPts: 0, tier: 0, shout: 0, shoutT: 10,
        hits: 0, kills: 0, streak: 0, streakT: 0, rank: 0, rankT: 10, pops: mem.alloc::<Pop>(POPS), next: 0,
        small: none, mid: none, big: none, huge: none,
    };
}

pub fn load(s: &Score) {
    s.small = game.loadFont("assets/font.ttf", 18);
    s.mid = game.loadFont("assets/font.ttf", 26);
    s.big = game.loadFont("assets/font.ttf", 40);
    s.huge = game.loadFont("assets/font.ttf", 64);
    let i = 0;
    while i < POPS {
        s.pops[i].t = POP_LIFE;
        i += 1;
    }
}

pub fn mult(s: &Score): f32 {
    return min(1 + s.heat, MAX_MULT);
}

/// Seconds in the air to reach tier `i + 1`.
fn tierAt(i: int): f32 {
    if i == 0 { return 1.5; }
    if i == 1 { return 3; }
    if i == 2 { return 5; }
    if i == 3 { return 7.5; }
    if i == 4 { return 10; }
    if i == 5 { return 14; }
    if i == 6 { return 20; }
    return 30;
}

fn tierName(tier: int): string {
    if tier == 1 { return "AIRBORNE"; }
    if tier == 2 { return "HANG TIME"; }
    if tier == 3 { return "FREQUENT FLYER"; }
    if tier == 4 { return "SKYWALKER"; }
    if tier == 5 { return "STRATOSPHERE"; }
    if tier == 6 { return "ORBITAL"; }
    if tier == 7 { return "ZERO GRAVITY"; }
    return "ASCENDED";
}

/// White, then cooler to hotter; the top tier cycles.
fn tierColor(tier: int): Vec3 {
    if tier <= 1 { return Vec3.xyz(0.85, 0.9, 1); }
    if tier == 2 { return Vec3.xyz(0.4, 0.9, 1); }
    if tier == 3 { return Vec3.xyz(0.45, 1, 0.5); }
    if tier == 4 { return Vec3.xyz(1, 0.9, 0.3); }
    if tier == 5 { return Vec3.xyz(1, 0.55, 0.2); }
    if tier == 6 { return Vec3.xyz(1, 0.3, 0.5); }
    if tier == 7 { return Vec3.xyz(0.8, 0.4, 1); }
    let t = f32(game.ticks()) * 0.006;
    return Vec3.xyz(0.6 + 0.4 * sin(t), 0.6 + 0.4 * sin(t + 2.1), 0.6 + 0.4 * sin(t + 4.2));
}

/// The multiplier each rank needs: F E D C B A S S+ SS SSS Z.
fn rankAt(r: int): f32 {
    if r == 1 { return 2; }
    if r == 2 { return 3.5; }
    if r == 3 { return 5; }
    if r == 4 { return 7; }
    if r == 5 { return 10; }
    if r == 6 { return 15; }
    if r == 7 { return 22; }
    if r == 8 { return 32; }
    if r == 9 { return 46; }
    if r == 10 { return 64; }
    return 1;
}

pub fn rankName(r: int): string {
    if r == 1 { return "E"; }
    if r == 2 { return "D"; }
    if r == 3 { return "C"; }
    if r == 4 { return "B"; }
    if r == 5 { return "A"; }
    if r == 6 { return "S"; }
    if r == 7 { return "S+"; }
    if r == 8 { return "SS"; }
    if r == 9 { return "SSS"; }
    if r == 10 { return "Z"; }
    return "F";
}

pub fn rankColor(r: int): Vec3 {
    if r == 1 { return Vec3.xyz(0.7, 0.75, 0.85); }
    if r == 2 { return Vec3.xyz(0.45, 0.9, 1); }
    if r == 3 { return Vec3.xyz(0.45, 1, 0.5); }
    if r == 4 { return Vec3.xyz(1, 0.9, 0.3); }
    if r == 5 { return Vec3.xyz(1, 0.5, 0.2); }
    if r == 6 { return Vec3.xyz(1, 0.85, 0.2); }
    if r == 7 { return Vec3.xyz(1, 0.65, 0.1); }
    if r == 8 { return Vec3.xyz(1, 0.3, 0.4); }
    if r == 9 { return Vec3.xyz(0.85, 0.4, 1); }
    if r == 10 { return tierColor(TIERS); }
    return Vec3.xyz(0.55, 0.55, 0.62);
}

fn streakName(n: int): string {
    if n == 2 { return "DOUBLE KILL"; }
    if n == 3 { return "TRIPLE KILL"; }
    if n == 4 { return "QUAD KILL"; }
    return "RAMPAGE";
}

/// Pays `pts` times the combo and keeps the combo going. Returns what it paid.
fn gain(s: &Score, pts: f32): f32 {
    let paid = pts * mult(s);
    s.total = s.total + paid;
    s.bump = 1;
    s.comboT = COMBO_TIME;
    return paid;
}

fn pop(s: &Score, msg: string, pts: f32, secs: f32, tint: Vec3) {
    s.pops[s.next] = Pop { msg: msg, pts: int(pts + 0.5), secs: secs, t: 0, tint: tint };
    s.next = (s.next + 1) % POPS;
}

/// A big one-off payout (a boss down): its own popup, and a jump in the combo.
pub fn bonus(s: &Score, msg: string, pts: f32) {
    s.heat = s.heat + 2;
    let paid = gain(s, pts);
    pop(s, msg, paid, 0, Vec3.xyz(1, 0.45, 0.3));
}

fn kill(s: &Score, p: &Player) {
    if s.streakT > 0 { s.streak += 1; } else { s.streak = 1; }
    s.streakT = STREAK_TIME;
    s.heat = s.heat + KILL_HEAT;
    let pts = KILL_PTS;
    if !p.onGround { pts = pts * AIR_KILL; }
    if s.streak >= 2 { pts = pts + STREAK_PTS * f32(s.streak - 1); }
    let paid = gain(s, pts);
    if s.streak >= 2 {
        pop(s, streakName(s.streak), paid, 0, Vec3.xyz(1, 0.75, 0.25));
    } else if !p.onGround {
        pop(s, "AIR KILL", paid, 0, Vec3.xyz(0.4, 0.9, 1));
    } else {
        pop(s, "KILL", paid, 0, Vec3.xyz(1, 1, 1));
    }
}

/// A fresh run: no score, no combo.
pub fn clear(s: &Score) {
    s.total = 0;
    s.shown = 0;
    s.heat = 0;
    s.air = 0;
    s.tier = 0;
    s.streak = 0;
}

/// Call after the guns and before the enemies, so a death is seen before they respawn you.
pub fn update(s: &Score, p: &Player, e: &Enemies, dt: f32) {
    if p.hp <= 0 {
        // Down: the run's score goes with it, after the death screen gets to keep it.
        s.last = s.total;
        s.lastRank = s.rank;
        s.newBest = s.total > s.best;
        if s.newBest { s.best = s.total; }
        clear(s);
    }
    s.bump = max(s.bump - dt * 4, 0);
    s.streakT = s.streakT - dt;
    s.shoutT = s.shoutT + dt;
    s.shown = min(s.shown + max((s.total - s.shown) * dt * 8, dt * 60), s.total);
    let i = 0;
    while i < POPS {
        s.pops[i].t = s.pops[i].t + dt;
        i += 1;
    }

    if e.hits > s.hits {
        let n = f32(e.hits - s.hits);
        s.heat = s.heat + HIT_HEAT * n;
        gain(s, HIT_PTS * n);
    }
    s.hits = e.hits;
    let k = s.kills;
    while k < e.kills {
        kill(s, p);
        k += 1;
    }
    s.kills = e.kills;

    if p.onGround || p.touched || p.wet > 0 {
        if s.tier > 0 { pop(s, "LANDED", s.airPts, s.air, tierColor(s.tier)); }
        s.air = 0;
        s.airPts = 0;
        s.tier = 0;
    } else {
        s.air = s.air + dt;
        if s.tier < TIERS && s.air >= tierAt(s.tier) {
            s.tier += 1;
            s.shout = s.tier;
            s.shoutT = 0;
            s.heat = s.heat + TIER_HEAT * f32(s.tier);
            s.bump = 1;
        }
        if s.tier > 0 {
            // Airborne keeps the combo alive, and pays more the longer it goes.
            let rate = AIR_PTS * f32(s.tier) * dt * mult(s);
            s.total = s.total + rate;
            s.airPts = s.airPts + rate;
            s.comboT = COMBO_TIME;
        }
    }
    s.comboT = s.comboT - dt;
    if s.comboT <= 0 {
        // Out of time: drop to the bottom of the rank below and start the clock again. F just ends.
        if s.rank > 0 {
            s.heat = max(rankAt(s.rank - 1) - 1, 0.01);
            s.comboT = COMBO_TIME;
        } else {
            s.heat = 0;
        }
    }
    s.rankT = s.rankT + dt;
    let r = 0;
    while r < RANKS - 1 && mult(s) >= rankAt(r + 1) { r += 1; }
    if r > s.rank { s.rankT = 0; }
    s.rank = r;
}

fn paint(c: Vec3, a: f32) {
    let k = clamp(a, 0, 1) * 255;
    game.setColor(game.rgba(u8(c.x * 255), u8(c.y * 255), u8(c.z * 255), u8(k)));
}

/// Text with a drop shadow.
fn say(font: Font, x: f32, y: f32, msg: string, c: Vec3, a: f32, bold: bool) {
    paint(Vec3.xyz(0.04, 0.04, 0.08), a * 0.7);
    if bold { game.drawTextBold(font, Vec2 { x: x + 2, y: y + 2 }, msg); } else { game.drawText(font, Vec2 { x: x + 2, y: y + 2 }, msg); }
    paint(c, a);
    if bold { game.drawTextBold(font, Vec2 { x: x, y: y }, msg); } else { game.drawText(font, Vec2 { x: x, y: y }, msg); }
}

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

/// The first decimal of `v`, for "1.5" style readouts.
// ponytail: callers interpolate it themselves: an interpolated string lives in its function's stack frame.
fn tenths(v: f32): int {
    return int(v * 10) - int(v) * 10;
}

pub fn draw(s: &Score) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;

    // The counter, top right: flashes gold and hops on a gain.
    let right = sz.x - 20;
    let num = `{int(s.shown)}`;
    let nw = game.textSize(s.big, num);
    let gold = Vec3.xyz(1, 1 - s.bump * 0.2, 1 - s.bump * 0.7);
    say(s.big, right - nw.x, 14 - s.bump * 4, num, gold, 0.95, false);
    let m = mult(s);
    if s.heat > 0 && s.comboT > 0 {
        // Hotter colors as the multiplier climbs, and a bar for the time left.
        let h = clamp((m - 1) / 4, 0, 1);
        let hot = Vec3.xyz(1, 1 - h * 0.6, 1 - h);
        let tag = `x{int(m)}.{tenths(m)}`;
        let tw = game.textSize(s.mid, tag);
        say(s.mid, right - tw.x, 58, tag, hot, 0.95, m >= 3);
        paint(Vec3.xyz(0.08, 0.09, 0.16), 0.6);
        rect(right - 120, 92, 120, 4);
        paint(hot, 0.9);
        let left = clamp(s.comboT / COMBO_TIME, 0, 1);
        rect(right - 120 * left, 92, 120 * left, 4);
        // The rank letter left of it all: pops white and big when it goes up.
        let up = max(1 - s.rankT / 0.25, 0);
        let rc = rankColor(s.rank);
        let letter = rankName(s.rank);
        let rs = game.textSizeBold(s.huge, letter);
        say(s.huge, right - 140 - rs.x, 40 - up * 8, letter, rc + (Vec3.xyz(1, 1, 1) - rc) * up, 0.95, true);
    }
    if s.tier > 0 {
        let ac = tierColor(s.tier);
        let at = `AIR {int(s.air)}.{tenths(s.air)}s`;
        let aw = game.textSize(s.small, at);
        say(s.small, right - aw.x, 102, at, ac, 0.9, false);
    }

    // Small popups under the counter, right-aligned, newest on top, sliding in from the edge.
    let slot = 0;
    let j = 0;
    while j < POPS {
        let pp = s.pops[(s.next - 1 - j + POPS * 2) % POPS];
        if pp.t < POP_LIFE {
            let a = 1 - max(pp.t - POP_LIFE * 0.6, 0) / (POP_LIFE * 0.4);
            let x = right + (1 - min(pp.t / 0.1, 1)) * 30;
            let y = 130 + f32(slot) * 22;
            let dim = Vec3.xyz(1, 0.85, 0.45);
            let pts = `+{pp.pts}`;
            if pp.secs > 0 { pts = `{int(pp.secs)}.{tenths(pp.secs)}s  +{pp.pts}`; }
            let pw = game.textSize(s.small, pts);
            say(s.small, x - pw.x, y, pts, dim, a * 0.75, false);
            let label = game.textSizeBold(s.small, pp.msg);
            say(s.small, x - pw.x - 10 - label.x, y, pp.msg, pp.tint, a * 0.9, true);
            slot += 1;
        }
        j += 1;
    }

    // The air callout above the crosshair: bigger, louder and shakier each tier.
    if s.shout > 0 && s.shoutT < SHOUT_LIFE {
        let tier = s.shout;
        let font = s.mid;
        if tier >= 3 { font = s.big; }
        if tier >= 6 { font = s.huge; }
        let bold = tier >= 4;
        let msg = tierName(tier);
        let ts = game.textSize(font, msg);
        let fade = 1 - max(s.shoutT - SHOUT_LIFE + 0.4, 0) / 0.4;
        let drop = (1 - min(s.shoutT / 0.12, 1)) * 30;
        let now = f32(game.ticks()) * 0.001;
        let shake = max(f32(tier - 2), 0) * 1.5 * (1 - s.shoutT / SHOUT_LIFE);
        let sx = cx - ts.x * 0.5 + sin(now * 71) * shake;
        let sy = cy - 190 - drop + sin(now * 53) * shake;
        let c = tierColor(tier);
        if tier >= 3 {
            paint(Vec3.xyz(0.05, 0.05, 0.1), 0.45 * fade);
            rect(sx - 24, sy - 6, ts.x + 48, ts.y + 12);
        }
        if tier >= 5 {
            // A pulsing glow band behind it.
            paint(c, (0.18 + 0.12 * sin(now * 12)) * fade);
            rect(sx - 40, sy - 12, ts.x + 80, ts.y + 24);
        }
        // White flash as it lands, settling into its color.
        let flash = max(1 - s.shoutT / 0.2, 0);
        say(font, sx, sy, msg, c + (Vec3.xyz(1, 1, 1) - c) * flash, fade, bold);
    }
}
