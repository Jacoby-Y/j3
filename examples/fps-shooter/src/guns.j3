// Machine gun and sniper, plus the shrine weapons: shotgun, RPG, bow, wand, knife and
// skateboard. Scroll or 1-8 (in strip order) to switch, right mouse to aim. Every shot shoves the
// player back along the aim, so a shotgun blast at the floor is a jump; an RPG blast under your
// feet throws you from the ground.

module fps_shooter.guns;

use j3.game;
use j3.game.{ Key, Mouse };
use j3.gfx;
use j3.gfx.{ Look, Mesh, Ray };
use j3.math.{ Mat4, Vec3, PI, TAU, abs, clamp, cos, lerp, max, min, sin, sqrt, tan };
use j3.memory.Arena;
use j3.rand.Rng;
use j3.scene3d;
use j3.scene3d.Scene;
use j3.sys.panic;
use fps_shooter.challenge;
use fps_shooter.debug;
use fps_shooter.level;
use fps_shooter.player;
use fps_shooter.boss;
use fps_shooter.bosskit.Bosses;
use fps_shooter.enemies;
use fps_shooter.enemies.{ Enemies, MAX_ENEMIES };
use fps_shooter.level.{ Box, Level, clear, shoot, solid, sweep };
use fps_shooter.player.{ Player, has, look, push, AIR_DMG, BOARD, BOW, KATANA, KNIFE, LANCE, MACHINE, PISTOL, RPG, SCORCHER, SHOTGUN, SNIPER, WAND };
use fps_shooter.sfx;
use fps_shooter.shrine;
use fps_shooter.shrine.Shrines;

pub const HIP_FOV: f32 = 75;
const SWITCH_TIME: f32 = 0.22;
const ADS_TIME: f32 = 0.12;
const REACH: f32 = 400;
const TRACER_LIFE: f32 = 0.18;
const MARK_LIFE: f32 = 4;
const FLASH_LIFE: f32 = 0.05;
pub const GUNS: int = 12;
/// Strip order: the six starting-hand guns first, then the shrine ones.
const G_MACHINE: int = 0;
const G_PISTOL: int = 1;
const G_SCORCHER: int = 2;
const G_SNIPER: int = 3;
const G_KATANA: int = 4;
const G_LANCE: int = 5;
const G_SHOTGUN: int = 6;
const G_RPG: int = 7;
const G_BOW: int = 8;
const G_WAND: int = 9;
const G_KNIFE: int = 10;
const G_BOARD: int = 11;
/// What a pull of the trigger does.
const HITSCAN: int = 0;
const ROCKET: int = 1;
const MELEE: int = 2;
const BOLT: int = 3;
const RIDE: int = 4;
const ARROW: int = 5;
/// Scorcher: a short, wide gout of flame that hurts everything in it.
const FLAMER: int = 6;
/// Lance: held out in front, it hits what you ram; the harder you're moving, the more it does.
const JOUST: int = 7;
const JOUST_PER_SPEED: f32 = 4.6;
const JOUST_WIDTH: f32 = 1.1;
/// Slowdown from a hit, and the seconds before the next.
const JOUST_DRAG: f32 = 0.9;
/// A target the lance just hit can't be hit again for this long; the rest of the line still can.
const JOUST_REHIT: f32 = 0.35;
/// Couched this long (s) and the lance is forced down for LANCE_REST.
const LANCE_HOLD: f32 = 3;
const LANCE_REST: f32 = 1;
const PARRY_TIME: f32 = 0.5;
const PARRY_COOLDOWN: f32 = 1.1;
const BOW_DRAW: f32 = 1;
const ARROW_GRAVITY: f32 = 24;
const BOW_SPARK: f32 = 0.45;
const ARROW_HITS: int = 5;
const TRAIL_LIFE: f32 = 0.16;
const MAX_TRAIL: int = 512;
const MAX_SHOTS: int = 32;
const ROCKET_SPEED: f32 = 35;
const BLAST: f32 = 5;
/// Wand bolt burst radius.
const WAND_BLAST: f32 = 2.5;
/// Most a rocket blast throws you, standing right on it.
const ROCKET_JUMP: f32 = 34;
const BOLT_SPEED: f32 = 26;
/// Bolts hunt: every `BOLT_SEEK` seconds they pick the best enemy in any direction that they can
/// see, dive at it, and swoop off again after a hit (BOLT_HITS times); with nothing to hunt they
/// circle you. Turning is this fast, harder with ground just ahead, and they weave as they fly.
const BOLT_CONE: f32 = -1;
const BOLT_HITS: int = 2;
const BOLT_LIFE: f32 = 7;
const BOLT_RECOVER: f32 = 0.55;
const BOLT_WEAVE: f32 = 5;
const BOLT_BOUNCE: f32 = -0.4;
const BOLT_TURN: f32 = 11;
const BOLT_RANGE: f32 = 40;
const BOLT_SEEK: f32 = 0.1;
const BOLT_PULL_UP: f32 = 2.5;
/// A bolt's target when it's homing on the boss.
const AT_BOSS: int = -2;
const KNIFE_REACH: f32 = 4.5;
/// Knife swing: cosine of the half-angle it hits within (60 degrees).
const KNIFE_CONE: f32 = 0.5;
const OLLIE: f32 = 9;
/// Air damage gift.
const AIR_BONUS: f32 = 1.3;
const MAX_PARTS: int = 48;
/// Super ammo: damage and player knockback, reach and blast size, and how many uses a gun with
/// no magazine gets (melee strikes, lance hits, arrows).
const SUPER_DAMAGE: f32 = 2;
const SUPER_KNOCK: f32 = 2;
const SUPER_REACH: f32 = 1.5;
const SUPER_USES: int = 10;

/// One box of a viewmodel, in the gun's space (x right, y up, -z forward).
struct Part {
    at: Vec3;
    size: Vec3;
    color: Vec3;
    /// Radians about x.
    tilt: f32;
    glow: Vec3;
}

pub struct Gun {
    name: string;
    /// Seconds between shots.
    interval: f32;
    pellets: int;
    /// Cone half-angle in degrees.
    hipSpread: f32;
    adsSpread: f32;
    adsFov: f32;
    /// Speed the shot takes off the player, along the aim.
    knock: f32;
    /// Per pellet: health off an enemy, and how hard it shoves one.
    damage: f32;
    shove: f32;
    /// Shots per magazine, shots left in it, and seconds to refill it.
    mag: int;
    ammo: int;
    reload: f32;
    /// View kick (radians) and screen shake.
    kick: f32;
    shake: f32;
    tracer: Vec3;
    /// Sniper: aiming shows a scope and hides the gun.
    scope: bool;
    muzzle: Vec3;
    parts: []Part;
    count: int;
    kind: int;
    /// The shrine gift that unlocks it; 0 for the starting two.
    gift: int;
    /// Hitscan: enemies a shot goes on through after the first.
    pierce: int;
    /// Melee, flames and lance: how far they reach; 0 for the default.
    reach: f32 = 0;
    /// Super ammo: 1 while a magazine is super, uses left for a gun with no magazine; 0 when off.
    boost: int = 0;
}

/// A rocket, wand bolt, or physical arrow. An arrow's position is its tip.
struct Shot {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    kind: int;
    damage: f32;
    /// Bolts: the enemy it's homing on (-1 none, `AT_BOSS` the boss), and time until it looks again.
    target: int;
    seekT: f32;
    stuck: bool = false;
    /// Blast radius scale (super ammo).
    power: f32 = 1;
    hitCount: int = 0;
    /// Bolts: seconds left swooping away after a hit.
    recover: f32 = 0;
    hits: [5]int;
}

struct Trail {
    a: Vec3;
    b: Vec3;
    t: f32;
    color: Vec3;
}

struct Tracer {
    a: Vec3;
    b: Vec3;
    t: f32;
    color: Vec3;
    /// A bullet streak that travels from `a` to `b`. A knife swipe is the whole segment at once.
    bullet: bool;
}

struct Mark {
    p: Vec3;
    t: f32;
    color: Vec3;
}

pub struct Guns {
    list: []Gun;
    cur: int;
    cd: f32;
    /// Length of the last shot's cooldown, for the HUD bar.
    cdLen: f32;
    switchT: f32;
    /// Counts down while reloading the current gun; 0 when not. `reloadLen` is where it started.
    reloadT: f32;
    reloadLen: f32;
    /// 0 at the hip, 1 aimed.
    ads: f32;
    flash: f32;
    /// Viewmodel kick back, 1 right after a shot.
    recoil: f32;
    sway: Vec3;
    shake: f32;
    tracers: []Tracer;
    nextTracer: int;
    marks: []Mark;
    nextMark: int;
    shots: []Shot;
    nextShot: int;
    trail: []Trail;
    nextTrail: int = 0;
    cube: Mesh;
    arrowhead: Mesh;
    rng: Rng;
    /// Set while a menu has the mouse; the trigger stays dead until left is let go, so the
    /// click that picks a card or presses Resume doesn't also shoot.
    locked: bool;
    /// Overclock running: the gun glows hot.
    hot: f32 = 0;
    bowDrawing: bool = false;
    bowCharge: f32 = 0;
    bowSpark: f32 = 0;
    /// Katana raised to parry, and lance couched, both eased 0..1 for the viewmodel.
    parry: f32 = 0;
    couch: f32 = 0;
    /// Lance held couched this long, and the cooldown after 3 s of it.
    couchT: f32 = 0;
    couchCd: f32 = 0;
    /// When the scorcher last made a sound (ms), so its bursts don't stack.
    flameSfx: int = 0;
    /// Per enemy (and one for shrines/bosses at the end): lance re-hit timers.
    stab: []f32;
}

fn add(g: &Gun, at: Vec3, size: Vec3, color: Vec3, tilt: f32, glow: Vec3) {
    g.parts[g.count] = Part { at: at, size: size, color: color, tilt: tilt, glow: glow };
    g.count += 1;
}

fn part(g: &Gun, at: Vec3, size: Vec3, color: Vec3) {
    add(g, at, size, color, 0, Vec3.zero());
}

/// Tipped about x: positive leans the top back toward you (and the front end up).
fn bent(g: &Gun, at: Vec3, size: Vec3, color: Vec3, tilt: f32) {
    add(g, at, size, color, tilt, Vec3.zero());
}

/// Lit from inside: lenses, gems, sight dots.
fn shine(g: &Gun, at: Vec3, size: Vec3, color: Vec3) {
    add(g, at, size, color, 0, color * 1.6);
}

fn machineGun(mem: &Arena): Gun {
    let g = Gun {
        name: "MACHINE GUN", interval: 0.0833, pellets: 1, hipSpread: 2.5,
        adsSpread: 0.6, adsFov: 55, knock: 0.6, damage: 14, shove: 1, mag: 30, ammo: 30, reload: 1.4, kick: 0.012, shake: 0.004,
        tracer: Vec3.xyz(1, 0.85, 0.3), scope: false, muzzle: Vec3.xyz(0, 0.015, -0.52), count: 0, parts: mem.alloc::<Part>(MAX_PARTS),
        kind: HITSCAN, gift: MACHINE, pierce: 0,
    };
    let body = Vec3.xyz(0.2, 0.75, 0.85);
    let dark = Vec3.xyz(0.18, 0.2, 0.28);
    let pop = Vec3.xyz(1, 0.6, 0.15);
    // Receiver, rail, handguard, barrel and brake.
    part(&g, Vec3.xyz(0, 0, -0.05), Vec3.xyz(0.07, 0.09, 0.3), body);
    part(&g, Vec3.xyz(0, 0.05, -0.08), Vec3.xyz(0.04, 0.014, 0.4), dark);
    part(&g, Vec3.xyz(0, 0.008, -0.27), Vec3.xyz(0.075, 0.075, 0.16), dark);
    part(&g, Vec3.xyz(0.039, 0.008, -0.27), Vec3.xyz(0.004, 0.02, 0.12), pop);
    part(&g, Vec3.xyz(-0.039, 0.008, -0.27), Vec3.xyz(0.004, 0.02, 0.12), pop);
    part(&g, Vec3.xyz(0, 0.015, -0.41), Vec3.xyz(0.028, 0.028, 0.14), dark);
    part(&g, Vec3.xyz(0, 0.015, -0.49), Vec3.xyz(0.045, 0.045, 0.045), dark);
    // Ejection port, charging handle, side stripe.
    part(&g, Vec3.xyz(0.036, 0.02, 0.0), Vec3.xyz(0.004, 0.025, 0.06), dark);
    part(&g, Vec3.xyz(0.045, 0.028, 0.07), Vec3.xyz(0.025, 0.012, 0.012), dark);
    part(&g, Vec3.xyz(-0.036, -0.02, -0.06), Vec3.xyz(0.004, 0.012, 0.22), pop);
    // Sights: rear notch and a lit front post.
    part(&g, Vec3.xyz(0, 0.068, 0.06), Vec3.xyz(0.03, 0.022, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.062, -0.26), Vec3.xyz(0.012, 0.012, 0.012), dark);
    shine(&g, Vec3.xyz(0, 0.075, -0.26), Vec3.xyz(0.006, 0.014, 0.006), pop);
    // Magazine leaning forward, grip leaning back, guard and trigger.
    bent(&g, Vec3.xyz(0, -0.1, -0.13), Vec3.xyz(0.045, 0.14, 0.07), pop, 0.22);
    bent(&g, Vec3.xyz(0, -0.085, 0.07), Vec3.xyz(0.05, 0.12, 0.055), dark, -0.3);
    part(&g, Vec3.xyz(0, -0.075, -0.005), Vec3.xyz(0.014, 0.012, 0.075), dark);
    part(&g, Vec3.xyz(0, -0.057, 0.0), Vec3.xyz(0.008, 0.03, 0.008), dark);
    // Stock and butt plate.
    part(&g, Vec3.xyz(0, -0.005, 0.18), Vec3.xyz(0.045, 0.06, 0.12), body);
    part(&g, Vec3.xyz(0, -0.02, 0.25), Vec3.xyz(0.05, 0.1, 0.03), dark);
    return g;
}

fn sniper(mem: &Arena): Gun {
    let g = Gun {
        name: "SNIPER", interval: 1.1, pellets: 1, hipSpread: 4, adsSpread: 0,
        adsFov: 20, knock: 6, damage: 120, shove: 10, mag: 5, ammo: 5, reload: 2, kick: 0.07, shake: 0.02, tracer: Vec3.xyz(0.6, 0.4, 1),
        scope: true, muzzle: Vec3.xyz(0, 0.01, -0.78), count: 0, parts: mem.alloc::<Part>(MAX_PARTS),
        kind: HITSCAN, gift: SNIPER, pierce: 3,
    };
    let body = Vec3.xyz(0.6, 0.35, 0.9);
    let dark = Vec3.xyz(0.15, 0.14, 0.22);
    let glass = Vec3.xyz(0.5, 1, 0.9);
    // Receiver, forend, long barrel and brake.
    part(&g, Vec3.xyz(0, 0, -0.02), Vec3.xyz(0.058, 0.07, 0.3), dark);
    part(&g, Vec3.xyz(0, -0.01, -0.28), Vec3.xyz(0.065, 0.065, 0.24), body);
    part(&g, Vec3.xyz(0, 0.01, -0.57), Vec3.xyz(0.026, 0.026, 0.4), dark);
    part(&g, Vec3.xyz(0, 0.01, -0.76), Vec3.xyz(0.048, 0.036, 0.055), dark);
    // Folded bipod under the forend.
    part(&g, Vec3.xyz(0.02, -0.05, -0.32), Vec3.xyz(0.01, 0.01, 0.16), dark);
    part(&g, Vec3.xyz(-0.02, -0.05, -0.32), Vec3.xyz(0.01, 0.01, 0.16), dark);
    // Scope: rings, tube, bell, eyepiece, knobs, lens.
    part(&g, Vec3.xyz(0, 0.052, -0.1), Vec3.xyz(0.03, 0.035, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.052, 0.05), Vec3.xyz(0.03, 0.035, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.085, -0.02), Vec3.xyz(0.045, 0.045, 0.24), dark);
    part(&g, Vec3.xyz(0, 0.085, -0.18), Vec3.xyz(0.064, 0.064, 0.08), dark);
    part(&g, Vec3.xyz(0, 0.085, 0.12), Vec3.xyz(0.054, 0.054, 0.05), dark);
    part(&g, Vec3.xyz(0, 0.115, -0.03), Vec3.xyz(0.022, 0.025, 0.022), body);
    part(&g, Vec3.xyz(0.03, 0.085, -0.03), Vec3.xyz(0.025, 0.022, 0.022), body);
    shine(&g, Vec3.xyz(0, 0.085, -0.222), Vec3.xyz(0.052, 0.052, 0.006), glass);
    // Bolt handle and knob, magazine, guard, grip.
    part(&g, Vec3.xyz(0.045, 0.012, 0.07), Vec3.xyz(0.05, 0.014, 0.014), dark);
    part(&g, Vec3.xyz(0.072, 0.012, 0.07), Vec3.xyz(0.024, 0.024, 0.024), body);
    part(&g, Vec3.xyz(0, -0.06, -0.03), Vec3.xyz(0.04, 0.06, 0.07), dark);
    part(&g, Vec3.xyz(0, -0.06, 0.06), Vec3.xyz(0.012, 0.012, 0.06), dark);
    bent(&g, Vec3.xyz(0, -0.08, 0.14), Vec3.xyz(0.05, 0.11, 0.05), body, -0.35);
    // Stock, cheek rest, butt pad.
    part(&g, Vec3.xyz(0, -0.02, 0.3), Vec3.xyz(0.055, 0.09, 0.22), body);
    part(&g, Vec3.xyz(0, 0.035, 0.28), Vec3.xyz(0.05, 0.022, 0.13), body);
    part(&g, Vec3.xyz(0, -0.025, 0.42), Vec3.xyz(0.06, 0.11, 0.025), dark);
    return g;
}

fn shotgun(mem: &Arena): Gun {
    let g = Gun {
        name: "SHOTGUN", interval: 0.75, pellets: 10, hipSpread: 7, adsSpread: 5,
        adsFov: 62, knock: 13, damage: 11, shove: 2.5, mag: 4, ammo: 4, reload: 1.6, kick: 0.09, shake: 0.03, tracer: Vec3.xyz(1, 0.45, 0.3),
        scope: false, muzzle: Vec3.xyz(0, 0.02, -0.5), count: 0, parts: mem.alloc::<Part>(MAX_PARTS),
        kind: HITSCAN, gift: SHOTGUN, pierce: 0,
    };
    let body = Vec3.xyz(0.95, 0.25, 0.3);
    let dark = Vec3.xyz(0.2, 0.16, 0.16);
    let wood = Vec3.xyz(1, 0.75, 0.35);
    let gold = Vec3.xyz(1, 0.8, 0.3);
    // Receiver with gold side plates.
    part(&g, Vec3.xyz(0, 0, 0), Vec3.xyz(0.1, 0.09, 0.2), body);
    part(&g, Vec3.xyz(0.051, 0, 0), Vec3.xyz(0.004, 0.05, 0.13), gold);
    part(&g, Vec3.xyz(-0.051, 0, 0), Vec3.xyz(0.004, 0.05, 0.13), gold);
    part(&g, Vec3.xyz(0, -0.01, -0.11), Vec3.xyz(0.106, 0.022, 0.022), dark);
    // Twin barrels, top rib, muzzle rings, bead.
    part(&g, Vec3.xyz(-0.025, 0.02, -0.29), Vec3.xyz(0.045, 0.045, 0.4), dark);
    part(&g, Vec3.xyz(0.025, 0.02, -0.29), Vec3.xyz(0.045, 0.045, 0.4), dark);
    part(&g, Vec3.xyz(0, 0.045, -0.29), Vec3.xyz(0.016, 0.01, 0.4), dark);
    part(&g, Vec3.xyz(-0.025, 0.02, -0.48), Vec3.xyz(0.053, 0.053, 0.022), body);
    part(&g, Vec3.xyz(0.025, 0.02, -0.48), Vec3.xyz(0.053, 0.053, 0.022), body);
    shine(&g, Vec3.xyz(0, 0.056, -0.47), Vec3.xyz(0.012, 0.012, 0.012), gold);
    // Wood forend with grooves.
    part(&g, Vec3.xyz(0, -0.03, -0.24), Vec3.xyz(0.09, 0.045, 0.2), wood);
    part(&g, Vec3.xyz(0, -0.03, -0.2), Vec3.xyz(0.094, 0.04, 0.008), dark);
    part(&g, Vec3.xyz(0, -0.03, -0.28), Vec3.xyz(0.094, 0.04, 0.008), dark);
    // Top lever, guard, trigger.
    part(&g, Vec3.xyz(0, 0.05, 0.07), Vec3.xyz(0.02, 0.012, 0.05), dark);
    part(&g, Vec3.xyz(0, -0.065, 0.06), Vec3.xyz(0.014, 0.012, 0.07), dark);
    part(&g, Vec3.xyz(0, -0.052, 0.05), Vec3.xyz(0.008, 0.028, 0.008), dark);
    // Grip, short stock, butt, spare shells on the side.
    bent(&g, Vec3.xyz(0, -0.07, 0.14), Vec3.xyz(0.06, 0.11, 0.06), wood, -0.5);
    bent(&g, Vec3.xyz(0, -0.06, 0.25), Vec3.xyz(0.06, 0.09, 0.16), wood, -0.15);
    bent(&g, Vec3.xyz(0, -0.075, 0.33), Vec3.xyz(0.065, 0.12, 0.022), dark, -0.15);
    let s = 0;
    while s < 3 {
        let z = 0.2 + f32(s) * 0.035;
        part(&g, Vec3.xyz(0.035, -0.055, z), Vec3.xyz(0.012, 0.045, 0.024), body);
        part(&g, Vec3.xyz(0.035, -0.083, z), Vec3.xyz(0.014, 0.012, 0.026), gold);
        s += 1;
    }
    return g;
}

/// A gun with no parts yet: everything but the feel knobs zeroed.
fn blank(mem: &Arena, name: string, kind: int, gift: int, interval: f32, mag: int, reload: f32, tracer: Vec3): Gun {
    return Gun {
        name: name, interval: interval, pellets: 1, hipSpread: 0, adsSpread: 0, adsFov: HIP_FOV, knock: 0, damage: 0,
        shove: 0, mag: mag, ammo: mag, reload: reload, kick: 0.03, shake: 0.01, tracer: tracer, scope: false,
        muzzle: Vec3.xyz(0, 0.02, -0.5), count: 0, parts: mem.alloc::<Part>(MAX_PARTS), kind: kind, gift: gift, pierce: 0,
    };
}

fn rpg(mem: &Arena): Gun {
    let g = blank(mem, "RPG", ROCKET, RPG, 0.9, 1, 1.1, Vec3.xyz(1, 0.5, 0.2));
    g.damage = 90;
    g.adsFov = 60;
    g.kick = 0.08;
    g.shake = 0.03;
    g.muzzle = Vec3.xyz(0, 0.03, -0.62);
    let tube = Vec3.xyz(0.35, 0.6, 0.3);
    let dark = Vec3.xyz(0.16, 0.18, 0.16);
    let tip = Vec3.xyz(1, 0.35, 0.25);
    let warn = Vec3.xyz(1, 0.85, 0.2);
    // Tube, bands, warning stripe, flared back end.
    part(&g, Vec3.xyz(0, 0.03, -0.12), Vec3.xyz(0.1, 0.1, 0.66), tube);
    part(&g, Vec3.xyz(0, 0.03, -0.42), Vec3.xyz(0.112, 0.112, 0.025), dark);
    part(&g, Vec3.xyz(0, 0.03, 0.1), Vec3.xyz(0.112, 0.112, 0.025), dark);
    part(&g, Vec3.xyz(0, 0.03, -0.3), Vec3.xyz(0.105, 0.105, 0.03), warn);
    part(&g, Vec3.xyz(0, 0.03, 0.23), Vec3.xyz(0.14, 0.14, 0.05), dark);
    part(&g, Vec3.xyz(0, 0.03, 0.26), Vec3.xyz(0.1, 0.1, 0.01), Vec3.xyz(0.05, 0.05, 0.05));
    // Loaded warhead poking out the front, stepped to a point.
    part(&g, Vec3.xyz(0, 0.03, -0.49), Vec3.xyz(0.06, 0.06, 0.06), dark);
    part(&g, Vec3.xyz(0, 0.03, -0.55), Vec3.xyz(0.13, 0.13, 0.08), tip);
    part(&g, Vec3.xyz(0, 0.03, -0.61), Vec3.xyz(0.09, 0.09, 0.05), tip);
    part(&g, Vec3.xyz(0, 0.03, -0.65), Vec3.xyz(0.045, 0.045, 0.04), tip);
    // Grips, guard, shoulder pad.
    bent(&g, Vec3.xyz(0, -0.07, -0.22), Vec3.xyz(0.045, 0.1, 0.05), dark, 0.15);
    bent(&g, Vec3.xyz(0, -0.08, 0), Vec3.xyz(0.05, 0.12, 0.055), dark, -0.3);
    part(&g, Vec3.xyz(0, -0.035, -0.07), Vec3.xyz(0.012, 0.012, 0.07), dark);
    part(&g, Vec3.xyz(0, -0.025, 0.14), Vec3.xyz(0.06, 0.03, 0.12), dark);
    // Sight on the left with a green dot.
    part(&g, Vec3.xyz(-0.06, 0.1, -0.15), Vec3.xyz(0.02, 0.06, 0.07), dark);
    shine(&g, Vec3.xyz(-0.06, 0.12, -0.18), Vec3.xyz(0.022, 0.012, 0.004), Vec3.xyz(0.3, 1, 0.4));
    return g;
}

fn bow(mem: &Arena): Gun {
    let g = blank(mem, "BOW", ARROW, BOW, 0.22, 0, 0, Vec3.xyz(0.6, 1, 0.5));
    g.damage = 120;
    g.shove = 8;
    g.hipSpread = 0.4;
    g.adsFov = 45;
    g.knock = 1;
    g.kick = 0.04;
    let wood = Vec3.xyz(0.8, 0.5, 0.25);
    let leaf = Vec3.xyz(0.5, 1, 0.45);
    let wrap = Vec3.xyz(0.35, 0.2, 0.12);
    // Grip with a leather wrap, then each limb in three pieces curving back to the tips.
    part(&g, Vec3.xyz(0, 0, -0.1), Vec3.xyz(0.04, 0.16, 0.05), wood);
    part(&g, Vec3.xyz(0, 0, -0.1), Vec3.xyz(0.046, 0.07, 0.056), wrap);
    let up = 1;
    while up >= -1 {
        let k = f32(up);
        bent(&g, Vec3.xyz(0, 0.13 * k, -0.1), Vec3.xyz(0.032, 0.14, 0.036), wood, 0.05 * k);
        bent(&g, Vec3.xyz(0, 0.235 * k, -0.085), Vec3.xyz(0.028, 0.1, 0.03), wood, 0.25 * k);
        bent(&g, Vec3.xyz(0, 0.31 * k, -0.052), Vec3.xyz(0.024, 0.08, 0.026), leaf, 0.6 * k);
        up -= 2;
    }
    // The string and nocked arrow are animated separately in drawBow.
    return g;
}

fn wand(mem: &Arena): Gun {
    let g = blank(mem, "WAND", BOLT, WAND, 0.22, 15, 1.2, Vec3.xyz(0.7, 0.5, 1));
    g.damage = 22;
    g.hipSpread = 1;
    g.adsFov = 60;
    g.kick = 0.01;
    g.shake = 0.003;
    g.muzzle = Vec3.xyz(0, 0, -0.5);
    let shaft = Vec3.xyz(0.35, 0.22, 0.5);
    let gold = Vec3.xyz(0.95, 0.8, 0.3);
    let gem = Vec3.xyz(0.8, 0.6, 1);
    // Handle, pommel, bands up the shaft.
    part(&g, Vec3.xyz(0, 0, 0.06), Vec3.xyz(0.042, 0.042, 0.16), Vec3.xyz(0.25, 0.15, 0.3));
    part(&g, Vec3.xyz(0, 0, 0.15), Vec3.xyz(0.056, 0.056, 0.03), gold);
    part(&g, Vec3.xyz(0, 0, -0.22), Vec3.xyz(0.028, 0.028, 0.36), shaft);
    let b = 0;
    while b < 4 {
        part(&g, Vec3.xyz(0, 0, -0.03 - f32(b) * 0.1), Vec3.xyz(0.036, 0.036, 0.014), gold);
        b += 1;
    }
    // Four prongs holding a gem, turned a bit so it reads as a crystal.
    part(&g, Vec3.xyz(0.028, 0, -0.43), Vec3.xyz(0.01, 0.01, 0.08), gold);
    part(&g, Vec3.xyz(-0.028, 0, -0.43), Vec3.xyz(0.01, 0.01, 0.08), gold);
    part(&g, Vec3.xyz(0, 0.028, -0.43), Vec3.xyz(0.01, 0.01, 0.08), gold);
    part(&g, Vec3.xyz(0, -0.028, -0.43), Vec3.xyz(0.01, 0.01, 0.08), gold);
    shine(&g, Vec3.xyz(0, 0, -0.47), Vec3.xyz(0.055, 0.055, 0.055), gem);
    add(&g, Vec3.xyz(0, 0, -0.47), Vec3.xyz(0.04, 0.04, 0.085), gem, 0.785, gem * 2.4);
    return g;
}

/// A karambit: finger ring, short handle, and a claw that hooks back toward you.
fn knife(mem: &Arena): Gun {
    let g = blank(mem, "KNIFE", MELEE, KNIFE, 0.35, 0, 0, Vec3.xyz(1, 1, 1));
    g.damage = 55;
    g.shove = 6;
    g.kick = 0.02;
    let grip = Vec3.xyz(0.14, 0.11, 0.13);
    let wrap = Vec3.xyz(0.07, 0.06, 0.07);
    let steel = Vec3.xyz(0.8, 0.84, 0.9);
    let edge = Vec3.xyz(0.97, 0.98, 1);
    // Handle with grooved wraps.
    part(&g, Vec3.xyz(0, -0.005, 0.07), Vec3.xyz(0.034, 0.05, 0.14), grip);
    let w = 0;
    while w < 3 {
        part(&g, Vec3.xyz(0, -0.005, 0.03 + f32(w) * 0.04), Vec3.xyz(0.038, 0.054, 0.014), wrap);
        w += 1;
    }
    // Finger ring behind the handle: a circle of short bars in the side plane.
    let i = 0;
    while i < 10 {
        let a = f32(i) * 0.6283;
        bent(&g, Vec3.xyz(0, -0.005 + cos(a) * 0.045, 0.19 - sin(a) * 0.045), Vec3.xyz(0.014, 0.012, 0.036), steel, 0 - a);
        i += 1;
    }
    // Blade: the spine follows an arc that sweeps forward then hooks down to a point; the edge is the inside curve.
    let n = 10;
    i = 0;
    while i < n {
        let t = f32(i) / f32(n - 1);
        let phi = t * 1.9;
        let width = 0.05 * (1 - t) + 0.008;
        let inY = 0 - cos(phi);
        let inZ = sin(phi);
        let y = 0.02 - 0.18 * (1 - cos(phi));
        let z = 0 - 0.18 * sin(phi);
        bent(&g, Vec3.xyz(0, y + inY * width * 0.5, z + inZ * width * 0.5), Vec3.xyz(0.01, width, 0.048), steel, 0 - phi);
        bent(&g, Vec3.xyz(0, y + inY * (width - 0.003), z + inZ * (width - 0.003)), Vec3.xyz(0.014, 0.006, 0.048), edge, 0 - phi);
        i += 1;
    }
    return g;
}

fn pistol(mem: &Arena): Gun {
    let g = blank(mem, "PISTOL", HITSCAN, PISTOL, 0.1667, 15, 1, Vec3.xyz(1, 0.85, 0.3));
    g.damage = 28;
    g.pierce = 1;
    g.shove = 2;
    g.hipSpread = 1.8;
    g.adsSpread = 0.3;
    g.adsFov = 60;
    g.knock = 0.9;
    g.kick = 0.02;
    g.shake = 0.006;
    g.muzzle = Vec3.xyz(0, 0.025, -0.32);
    let steel = Vec3.xyz(0.78, 0.8, 0.88);
    let dark = Vec3.xyz(0.14, 0.15, 0.2);
    let gold = Vec3.xyz(1, 0.72, 0.22);
    // Slide with serrations, barrel tip, sights.
    part(&g, Vec3.xyz(0, 0.02, -0.1), Vec3.xyz(0.05, 0.06, 0.3), steel);
    part(&g, Vec3.xyz(0, 0.02, -0.28), Vec3.xyz(0.028, 0.028, 0.05), dark);
    part(&g, Vec3.xyz(0, 0.052, -0.1), Vec3.xyz(0.016, 0.006, 0.28), gold);
    let s = 0;
    while s < 4 {
        part(&g, Vec3.xyz(0, 0.022, 0.03 + f32(s) * 0.022), Vec3.xyz(0.054, 0.052, 0.008), dark);
        s += 1;
    }
    part(&g, Vec3.xyz(0, 0.062, 0.05), Vec3.xyz(0.036, 0.018, 0.02), dark);
    shine(&g, Vec3.xyz(0, 0.058, -0.24), Vec3.xyz(0.012, 0.014, 0.012), Vec3.xyz(1, 0.8, 0.3));
    // Frame, guard, trigger, raked grip with a gold inlay, magazine base.
    part(&g, Vec3.xyz(0, -0.022, -0.08), Vec3.xyz(0.046, 0.032, 0.25), dark);
    part(&g, Vec3.xyz(0, -0.05, -0.02), Vec3.xyz(0.012, 0.012, 0.08), dark);
    part(&g, Vec3.xyz(0, -0.045, -0.09), Vec3.xyz(0.012, 0.03, 0.012), dark);
    part(&g, Vec3.xyz(0, -0.04, -0.06), Vec3.xyz(0.008, 0.026, 0.008), gold);
    bent(&g, Vec3.xyz(0, -0.09, 0.06), Vec3.xyz(0.05, 0.12, 0.06), dark, -0.32);
    bent(&g, Vec3.xyz(0.026, -0.09, 0.06), Vec3.xyz(0.004, 0.06, 0.03), gold, -0.32);
    bent(&g, Vec3.xyz(-0.026, -0.09, 0.06), Vec3.xyz(0.004, 0.06, 0.03), gold, -0.32);
    bent(&g, Vec3.xyz(0, -0.15, 0.085), Vec3.xyz(0.054, 0.014, 0.066), steel, -0.32);
    return g;
}

fn scorcher(mem: &Arena): Gun {
    let g = blank(mem, "SCORCHER", FLAMER, SCORCHER, 0.05, 100, 1.8, Vec3.xyz(1, 0.5, 0.1));
    g.damage = 8;
    g.shove = 0.5;
    g.reach = 12;
    g.hipSpread = 8;
    g.adsSpread = 5;
    g.adsFov = 65;
    g.knock = 0.15;
    g.kick = 0.004;
    g.shake = 0.003;
    g.muzzle = Vec3.xyz(0, 0, -0.52);
    let tank = Vec3.xyz(0.85, 0.3, 0.1);
    let dark = Vec3.xyz(0.16, 0.14, 0.14);
    let metal = Vec3.xyz(0.55, 0.55, 0.6);
    let fire = Vec3.xyz(1, 0.55, 0.1);
    // Barrel, a ribbed shroud, and the nozzle with a live pilot flame.
    part(&g, Vec3.xyz(0, 0, -0.18), Vec3.xyz(0.05, 0.05, 0.5), dark);
    part(&g, Vec3.xyz(0, 0, -0.3), Vec3.xyz(0.075, 0.075, 0.18), metal);
    let r = 0;
    while r < 4 {
        part(&g, Vec3.xyz(0, 0, -0.24 - f32(r) * 0.04), Vec3.xyz(0.082, 0.082, 0.012), dark);
        r += 1;
    }
    part(&g, Vec3.xyz(0, 0, -0.46), Vec3.xyz(0.1, 0.1, 0.08), metal);
    part(&g, Vec3.xyz(0, 0, -0.5), Vec3.xyz(0.115, 0.115, 0.02), dark);
    shine(&g, Vec3.xyz(0, 0, -0.512), Vec3.xyz(0.055, 0.055, 0.008), fire);
    shine(&g, Vec3.xyz(0, 0.065, -0.5), Vec3.xyz(0.016, 0.016, 0.03), fire);
    // Fuel tank on the back with bands, cap, and a hose to the handle.
    part(&g, Vec3.xyz(0, 0.1, 0.05), Vec3.xyz(0.12, 0.11, 0.36), tank);
    part(&g, Vec3.xyz(0, 0.1, -0.06), Vec3.xyz(0.126, 0.116, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.1, 0.05), Vec3.xyz(0.126, 0.116, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.1, 0.16), Vec3.xyz(0.126, 0.116, 0.02), dark);
    part(&g, Vec3.xyz(0, 0.165, 0.05), Vec3.xyz(0.04, 0.03, 0.04), metal);
    shine(&g, Vec3.xyz(0.062, 0.1, 0.05), Vec3.xyz(0.006, 0.05, 0.14), fire);
    part(&g, Vec3.xyz(0, 0.03, -0.08), Vec3.xyz(0.02, 0.06, 0.02), dark);
    // Grips.
    bent(&g, Vec3.xyz(0, -0.06, -0.02), Vec3.xyz(0.05, 0.1, 0.05), dark, 0.15);
    bent(&g, Vec3.xyz(0, -0.05, -0.2), Vec3.xyz(0.04, 0.08, 0.04), dark, 0.05);
    return g;
}

/// A katana: long, slightly curved blade with a bright edge, gold guard, wrapped grip.
fn katana(mem: &Arena): Gun {
    let g = blank(mem, "KATANA", MELEE, KATANA, 0.42, 0, 0, Vec3.xyz(0.8, 0.9, 1));
    g.damage = 85;
    g.shove = 8;
    g.kick = 0.02;
    g.reach = 5.6;
    let steel = Vec3.xyz(0.84, 0.88, 0.95);
    let edge = Vec3.xyz(0.98, 0.99, 1);
    let gold = Vec3.xyz(0.95, 0.75, 0.25);
    let dark = Vec3.xyz(0.1, 0.09, 0.12);
    let cord = Vec3.xyz(0.45, 0.06, 0.1);
    // Blade in three segments curving up toward the tip, with an edge line under it.
    bent(&g, Vec3.xyz(0, 0.03, -0.24), Vec3.xyz(0.012, 0.045, 0.34), steel, 0);
    bent(&g, Vec3.xyz(0, 0.034, -0.55), Vec3.xyz(0.012, 0.042, 0.3), steel, 0.05);
    bent(&g, Vec3.xyz(0, 0.05, -0.79), Vec3.xyz(0.012, 0.038, 0.2), steel, 0.14);
    bent(&g, Vec3.xyz(0, 0.072, -0.92), Vec3.xyz(0.01, 0.03, 0.09), steel, 0.32);
    part(&g, Vec3.xyz(0, 0.009, -0.24), Vec3.xyz(0.006, 0.008, 0.34), edge);
    bent(&g, Vec3.xyz(0, 0.013, -0.55), Vec3.xyz(0.006, 0.008, 0.3), edge, 0.05);
    bent(&g, Vec3.xyz(0, 0.028, -0.79), Vec3.xyz(0.006, 0.008, 0.2), edge, 0.14);
    // Hamon: a soft glint along the spine of the blade.
    shine(&g, Vec3.xyz(0, 0.05, -0.4), Vec3.xyz(0.014, 0.004, 0.5), Vec3.xyz(0.5, 0.7, 1));
    // Collar, guard, grip with wraps, pommel.
    part(&g, Vec3.xyz(0, 0.03, -0.055), Vec3.xyz(0.02, 0.06, 0.04), gold);
    part(&g, Vec3.xyz(0, 0.03, -0.03), Vec3.xyz(0.1, 0.1, 0.012), dark);
    part(&g, Vec3.xyz(0, 0.03, -0.03), Vec3.xyz(0.108, 0.02, 0.014), gold);
    part(&g, Vec3.xyz(0, 0.03, -0.03), Vec3.xyz(0.02, 0.108, 0.014), gold);
    part(&g, Vec3.xyz(0, 0.03, 0.09), Vec3.xyz(0.032, 0.04, 0.22), dark);
    let w = 0;
    while w < 5 {
        part(&g, Vec3.xyz(0, 0.03, 0.0 + f32(w) * 0.04), Vec3.xyz(0.036, 0.044, 0.014), cord);
        w += 1;
    }
    part(&g, Vec3.xyz(0, 0.03, 0.21), Vec3.xyz(0.04, 0.048, 0.03), gold);
    return g;
}

/// A jousting lance: a long shaft, a steel point, a red pennant and a flared vamplate.
fn lance(mem: &Arena): Gun {
    let g = blank(mem, "LANCE", JOUST, LANCE, 0.12, 0, 0, Vec3.xyz(1, 1, 1));
    g.damage = 3;
    g.shove = 6;
    g.reach = 6.5;
    g.kick = 0.01;
    let wood = Vec3.xyz(0.85, 0.7, 0.45);
    let steel = Vec3.xyz(0.82, 0.86, 0.94);
    let red = Vec3.xyz(0.9, 0.12, 0.15);
    let gold = Vec3.xyz(0.95, 0.75, 0.25);
    let dark = Vec3.xyz(0.16, 0.12, 0.1);
    // Shaft in two turned halves, with painted bands.
    part(&g, Vec3.xyz(0, 0, -0.42), Vec3.xyz(0.034, 0.034, 0.9), wood);
    part(&g, Vec3.xyz(0, 0, 0.2), Vec3.xyz(0.04, 0.04, 0.3), wood);
    let b = 0;
    while b < 5 {
        part(&g, Vec3.xyz(0, 0, -0.2 - f32(b) * 0.16), Vec3.xyz(0.04, 0.04, 0.03), if b % 2 == 0 { red } else { gold });
        b += 1;
    }
    // Stepped steel head to a point.
    part(&g, Vec3.xyz(0, 0, -0.9), Vec3.xyz(0.056, 0.056, 0.1), steel);
    part(&g, Vec3.xyz(0, 0, -0.99), Vec3.xyz(0.042, 0.042, 0.09), steel);
    part(&g, Vec3.xyz(0, 0, -1.06), Vec3.xyz(0.026, 0.026, 0.07), steel);
    part(&g, Vec3.xyz(0, 0, -1.12), Vec3.xyz(0.012, 0.012, 0.06), Vec3.xyz(1, 1, 1));
    // Pennant streaming off the shaft.
    part(&g, Vec3.xyz(0.0, 0.03, -0.78), Vec3.xyz(0.008, 0.05, 0.16), red);
    part(&g, Vec3.xyz(0.0, 0.03, -0.66), Vec3.xyz(0.006, 0.036, 0.1), red);
    // Vamplate: the flared hand guard, then the rest and butt.
    part(&g, Vec3.xyz(0, 0, -0.05), Vec3.xyz(0.15, 0.15, 0.03), gold);
    part(&g, Vec3.xyz(0, 0, -0.09), Vec3.xyz(0.1, 0.1, 0.05), gold);
    part(&g, Vec3.xyz(0, 0, 0.0), Vec3.xyz(0.1, 0.1, 0.02), dark);
    part(&g, Vec3.xyz(0, 0, 0.36), Vec3.xyz(0.05, 0.05, 0.04), gold);
    return g;
}

fn skateboard(mem: &Arena): Gun {
    let g = blank(mem, "SKATEBOARD", RIDE, BOARD, 0.5, 0, 0, Vec3.xyz(1, 1, 1));
    g.kick = 0;
    g.shake = 0;
    let deck = Vec3.xyz(1, 0.4, 0.55);
    let wheel = Vec3.xyz(0.95, 0.95, 0.8);
    let metal = Vec3.xyz(0.6, 0.62, 0.68);
    // Deck with grip tape and kicked-up nose and tail.
    part(&g, Vec3.xyz(0, -0.1, -0.15), Vec3.xyz(0.2, 0.025, 0.6), deck);
    part(&g, Vec3.xyz(0, -0.086, -0.15), Vec3.xyz(0.19, 0.004, 0.58), Vec3.xyz(0.15, 0.15, 0.18));
    bent(&g, Vec3.xyz(0, -0.083, -0.49), Vec3.xyz(0.2, 0.025, 0.1), deck, 0.4);
    bent(&g, Vec3.xyz(0, -0.083, 0.19), Vec3.xyz(0.2, 0.025, 0.1), deck, -0.4);
    part(&g, Vec3.xyz(0, -0.113, -0.15), Vec3.xyz(0.12, 0.003, 0.3), Vec3.xyz(1, 0.85, 0.3));
    // Trucks and wheels.
    let t = 0;
    while t < 2 {
        let z = 0.03 - f32(t) * 0.36;
        part(&g, Vec3.xyz(0, -0.125, z), Vec3.xyz(0.14, 0.02, 0.04), metal);
        part(&g, Vec3.xyz(0.085, -0.145, z), Vec3.xyz(0.035, 0.045, 0.045), wheel);
        part(&g, Vec3.xyz(-0.085, -0.145, z), Vec3.xyz(0.035, 0.045, 0.045), wheel);
        t += 1;
    }
    return g;
}

/// No GL yet: `upload` gives the guns their mesh once the window is up.
pub fn create(mem: &Arena): Guns {
    let g = Guns {
        list: mem.alloc::<Gun>(GUNS), cur: 0, cd: 0, cdLen: 1, switchT: 0, reloadT: 0, reloadLen: 1, ads: 0, flash: 0, recoil: 0,
        sway: Vec3.zero(), shake: 0, tracers: mem.alloc::<Tracer>(48), nextTracer: 0,
        marks: mem.alloc::<Mark>(128), nextMark: 0, shots: mem.alloc::<Shot>(MAX_SHOTS), nextShot: 0, cube: Mesh { vao: 0, vbo: 0, count: 0 },
        trail: mem.alloc::<Trail>(MAX_TRAIL), rng: Rng.new(7), locked: false, stab: mem.alloc::<f32>(MAX_ENEMIES + 1), arrowhead: Mesh { vao: 0, vbo: 0, count: 0 },
    };
    g.list[G_MACHINE] = machineGun(mem);
    g.list[G_PISTOL] = pistol(mem);
    g.list[G_SCORCHER] = scorcher(mem);
    g.list[G_SNIPER] = sniper(mem);
    g.list[G_KATANA] = katana(mem);
    g.list[G_LANCE] = lance(mem);
    g.list[G_SHOTGUN] = shotgun(mem);
    g.list[G_RPG] = rpg(mem);
    g.list[G_BOW] = bow(mem);
    g.list[G_WAND] = wand(mem);
    g.list[G_KNIFE] = knife(mem);
    g.list[G_BOARD] = skateboard(mem);
    return g;
}

pub fn upload(g: &Guns, mem: &Arena) {
    g.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
    g.arrowhead = gfx.uploadUv(scene3d.assetVerts("builtin:cone", mem));
}

pub fn current(g: &Guns): Gun {
    return g.list[g.cur];
}

/// The gun in hand with super ammo applied: double damage and knockback, longer reach.
fn powered(g: &Guns): Gun {
    let gun = g.list[g.cur];
    if gun.boost <= 0 { return gun; }
    gun.damage = gun.damage * SUPER_DAMAGE;
    gun.knock = gun.knock * SUPER_KNOCK;
    gun.shove = gun.shove * SUPER_DAMAGE;
    if gun.kind == MELEE || gun.kind == JOUST || gun.kind == FLAMER {
        let reach = gun.reach;
        if reach == 0 { reach = KNIFE_REACH; }
        gun.reach = reach * SUPER_REACH;
    }
    return gun;
}

/// A super ammo orb: the held gun's magazine fills up and goes super, or a gun with no magazine
/// gets its next few uses super.
fn charge(g: &Guns, p: &Player) {
    let gun = &g.list[g.cur];
    if gun.mag > 0 {
        gun.ammo = mag(g.list[g.cur], p);
        gun.boost = 1;
        g.reloadT = 0;
    } else {
        gun.boost = SUPER_USES;
    }
}

/// Vertical fov right now: eased between hip and aimed.
pub fn fov(g: &Guns): f32 {
    return lerp(HIP_FOV, g.list[g.cur].adsFov, g.ads * g.ads * (3 - 2 * g.ads));
}

/// Cone half-angle in degrees right now, for shots and the crosshair.
pub fn spread(g: &Guns): f32 {
    let gun = current(g);
    return lerp(gun.hipSpread, gun.adsSpread, g.ads);
}

/// How far through the reload, 0..1, or 0 when not reloading.
/// Fraction of the shot cooldown still to go: 1 just after a shot, 0 ready.
pub fn cooldown(g: &Guns): f32 {
    return clamp(g.cd / g.cdLen, 0, 1);
}

pub fn reloading(g: &Guns): f32 {
    if g.reloadT <= 0 { return 0; }
    return 1 - g.reloadT / g.reloadLen;
}

fn same(a: string, b: string): bool {
    if a.len != b.len { return false; }
    let i = 0;
    while i < a.len { if a[i] != b[i] { return false; } i += 1; }
    return true;
}

fn gunIndex(name: string): int {
    if same(name, "machine") || same(name, "1") { return G_MACHINE; }
    if same(name, "sniper") || same(name, "2") { return G_SNIPER; }
    if same(name, "shotgun") || same(name, "3") { return G_SHOTGUN; }
    if same(name, "rpg") || same(name, "4") { return G_RPG; }
    if same(name, "bow") || same(name, "5") { return G_BOW; }
    if same(name, "wand") || same(name, "6") { return G_WAND; }
    if same(name, "knife") || same(name, "7") { return G_KNIFE; }
    if same(name, "skateboard") || same(name, "board") || same(name, "8") { return G_BOARD; }
    if same(name, "pistol") { return G_PISTOL; }
    if same(name, "scorcher") || same(name, "flame") { return G_SCORCHER; }
    if same(name, "katana") { return G_KATANA; }
    if same(name, "lance") { return G_LANCE; }
    return -1;
}

/// Grant every gun named in `list` (comma-separated) and hold the first. Empty does nothing.
pub fn preview(g: &Guns, p: &Player, mem: &Arena, list: string) {
    if list.len == 0 { return; }
    let first = -1;
    let at = 0;
    while at < list.len {
        let bit = debug.piece(mem, list, at);
        at = bit.next;
        if bit.name.len == 0 { break; }
        let i = gunIndex(bit.name);
        if i < 0 { continue; }
        let gift = g.list[i].gift;
        if gift != 0 && !has(p, gift) { p.stats.gifts += gift; }
        if first < 0 { first = i; }
    }
    if first >= 0 { g.cur = first; }
}

fn clockSeed(): int {
    let t = game.micros() + game.ticks() * 1000003;
    if t < 0 { t = 0 - t; }
    if t == 0 { t = 1; }
    return t;
}

/// A run's starting hands: one primary (machine gun, pistol or scorcher) and one secondary
/// (sniper, katana or lance), each picked at random. Drops any starting guns already held.
pub fn loadout(g: &Guns, p: &Player) {
    g.rng = Rng.new(clockSeed());
    let all = [MACHINE, PISTOL, SCORCHER, SNIPER, KATANA, LANCE];
    let k = 0;
    while k < 6 {
        if has(p, all[k]) { p.stats.gifts -= all[k]; }
        k += 1;
    }
    let primary = g.rng.intRange(0, 3);
    let secondary = 3 + g.rng.intRange(0, 3);
    // Melee only: katana and lance, no gun in hand.
    if challenge.on(challenge.MELEE) { primary = G_KATANA; secondary = G_LANCE; }
    p.stats.gifts += all[primary] + all[secondary];
    cancelDraw(g);
    g.cur = primary;
}

/// Whether gun `i` is in hand: the starting three, or one a shrine gave.
pub fn owned(g: &Guns, p: &Player, i: int): bool {
    return g.list[i].gift == 0 || has(p, g.list[i].gift);
}

/// The `n`th owned gun (0-based, strip order), or -1.
pub fn nth(g: &Guns, p: &Player, n: int): int {
    let left = n;
    let i = 0;
    while i < GUNS {
        if owned(g, p, i) {
            if left == 0 { return i; }
            left -= 1;
        }
        i += 1;
    }
    return -1;
}

/// Damage scale from cards, and the air gift while airborne.
fn dmgScale(p: &Player): f32 {
    let s = 1 + p.stats.damage;
    if challenge.on(challenge.GLASS) { s = s * 3; }
    if !p.onGround && has(p, AIR_DMG) { s = s * AIR_BONUS; }
    return s;
}

/// Magazine size with the card bonus; any bonus at all rounds up to a shot more. 0 for no magazine.
pub fn mag(gun: Gun, p: &Player): int {
    if gun.mag == 0 { return 0; }
    let m = f32(gun.mag) * (1 + p.stats.mag);
    let n = int(m);
    if f32(n) < m - 0.001 { n += 1; }
    return n;
}

/// After a death: every gun with a magazine full at its current size, no reload running.
pub fn refill(g: &Guns, p: &Player) {
    cancelDraw(g);
    let i = 0;
    while i < GUNS {
        if g.list[i].mag > 0 { g.list[i].ammo = mag(g.list[i], p); }
        g.list[i].boost = 0;
        i += 1;
    }
    g.reloadT = 0;
}

/// Menus, switching and death discard the draw; releasing afterwards cannot fire.
pub fn cancelDraw(g: &Guns) {
    g.bowDrawing = false;
    g.bowCharge = 0;
    g.bowSpark = 0;
    g.locked = true;
}

fn arrowSpeed(charge: f32): f32 { return lerp(20, 85, clamp(charge, 0, 1)); }
fn arrowPower(charge: f32): f32 { return lerp(0.2, 1, clamp(charge, 0, 1)); }

/// Returns the released draw, or -1 while idle/held. Full draw cues only once.
fn drawTrigger(g: &Guns, down: bool, dt: f32, rate: f32): f32 {
    if down {
        g.bowDrawing = true;
        let before = g.bowCharge;
        g.bowCharge = min(1, g.bowCharge + dt * rate / BOW_DRAW);
        if before < 1 && g.bowCharge >= 1 {
            g.bowSpark = BOW_SPARK;
            sfx.play(sfx.BOW_READY);
        }
        return -1;
    }
    if !g.bowDrawing { return -1; }
    let charge = g.bowCharge;
    g.bowDrawing = false;
    // Keep charge until fire has positioned the released arrow at the nock.
    return charge;
}

fn startReload(g: &Guns, p: &Player) {
    let gun = g.list[g.cur];
    if gun.mag == 0 || g.reloadT > 0 || gun.ammo >= mag(gun, p) || g.switchT > 0 { return; }
    g.reloadLen = gun.reload / (1 + p.stats.reload);
    g.list[g.cur].boost = 0;
    g.reloadT = g.reloadLen;
    sfx.play(sfx.RELOAD);
}

/// The sniper's scope covers the screen.
pub fn scoped(g: &Guns): bool {
    return g.list[g.cur].scope && g.ads > 0.9;
}

pub fn update(g: &Guns, p: &Player, lvl: &Level, scene: &Scene, e: &Enemies, sh: &Shrines, bs: &Bosses, dt: f32) {
    g.cd = g.cd - dt;
    g.switchT = max(g.switchT - dt, 0);
    g.flash = g.flash - dt;
    g.recoil = g.recoil * max(1 - dt * 12, 0);
    g.shake = g.shake * max(1 - dt * 14, 0);

    // Gone (a death took the shrine weapons): back to the first gun.
    if !owned(g, p, g.cur) {
        cancelDraw(g);
        g.cur = nth(g, p, 0);
        if g.cur < 0 { g.cur = 0; }
    }
    let want = g.cur;
    let wheel = game.mouseWheel();
    if wheel != 0 {
        let step = 1;
        if wheel > 0 { step = GUNS - 1; }
        want = (g.cur + step) % GUNS;
        while !owned(g, p, want) { want = (want + step) % GUNS; }
    }
    let k = 0;
    while k < GUNS {
        if game.keyPressed(numKey(k)) && nth(g, p, k) >= 0 { want = nth(g, p, k); }
        k += 1;
    }
    if want != g.cur {
        if g.list[g.cur].kind == ARROW || g.list[want].kind == ARROW { cancelDraw(g); }
        g.cur = want;
        g.reloadT = 0;
        g.switchT = SWITCH_TIME;
        g.ads = 0;
        g.cd = max(g.cd, SWITCH_TIME);
        g.cdLen = max(g.cd, 0.01);
    }

    if g.reloadT > 0 {
        g.reloadT = g.reloadT - dt * p.haste;
        if g.reloadT <= 0 {
            g.reloadT = 0;
            g.list[g.cur].ammo = mag(g.list[g.cur], p);
        }
    }
    if game.keyPressed(Key.R) { startReload(g, p); }

    let held = g.list[g.cur].kind;
    // Super ammo orbs fly in unless the skateboard is out.
    e.superOk = held != RIDE;
    if e.superGot {
        e.superGot = false;
        charge(g, p);
    }
    let aiming = game.mouseDown(Mouse.Right) && g.switchT <= 0 && g.reloadT <= 0 && game.mouseCaptured()
        && held != MELEE && held != RIDE && held != JOUST && held != FLAMER;
    if aiming { g.ads = min(g.ads + dt / ADS_TIME, 1); } else { g.ads = max(g.ads - dt / ADS_TIME, 0); }
    p.speedScale = lerp(1, 0.7, g.ads);
    // Knife out: quicker and tougher. Skateboard out: riding.
    p.guard = 1;
    let gun0 = g.list[g.cur];
    if held == MELEE && gun0.gift == KNIFE {
        p.speedScale = p.speedScale * 1.15;
        p.guard = 0.8;
    }
    // Katana: right click raises it to parry. Lance: hold click to couch it forward.
    p.parryT = max(0, p.parryT - dt);
    p.parryCd = max(0, p.parryCd - dt);
    if gun0.gift == KATANA && game.mouseCaptured() && !g.locked && g.switchT <= 0 && p.parryCd <= 0 && game.mousePressed(Mouse.Right) {
        p.parryT = PARRY_TIME;
        p.parryCd = PARRY_COOLDOWN;
        sfx.play(sfx.BLINK);
    }
    if gun0.gift != KATANA { p.parryT = 0; }
    if p.parried {
        // Something got turned away: a clang and a jolt.
        p.parried = false;
        sfx.play(sfx.SHATTER);
        g.shake = max(g.shake, 0.02);
        g.flash = FLASH_LIFE;
    }
    let raised: f32 = 0;
    if p.parryT > 0 { raised = 1; }
    g.parry = g.parry + (raised - g.parry) * min(dt * 18, 1);
    let couched: f32 = 0;
    g.couchCd -= dt;
    if held == JOUST && g.couchCd <= 0 && game.mouseDown(Mouse.Left) && !g.locked && game.mouseCaptured() { couched = 1; }
    if couched > 0 { g.couchT += dt; } else { g.couchT = 0; }
    if g.couchT >= LANCE_HOLD { g.couchCd = LANCE_REST; g.couchT = 0; couched = 0; }
    if couched > 0 { p.guard = 0.5; }
    g.couch = g.couch + (couched - g.couch) * min(dt * 12, 1);
    p.board = held == RIDE;
    p.lookScale = fov(g) / HIP_FOV * lerp(1, p.adsSens, g.ads);

    // The gun lags a little behind the view.
    let m = game.mouseDelta();
    let swayTo = Vec3.xyz(clamp(0 - m.x * 0.0005, -0.03, 0.03), clamp(m.y * 0.0005, -0.03, 0.03), 0);
    g.sway = g.sway + (swayTo - g.sway) * min(dt * 10, 1);

    g.bowSpark = max(0, g.bowSpark - dt);
    if g.locked || !game.mouseCaptured() { cancelDraw(g); }
    if g.locked && !game.mouseDown(Mouse.Left) { g.locked = false; }
    let s = 0;
    while s <= MAX_ENEMIES {
        g.stab[s] = max(0, g.stab[s] - dt);
        s += 1;
    }
    if held == ARROW {
        if game.mouseCaptured() && !g.locked && g.cd <= 0 && g.switchT <= 0 && g.reloadT <= 0 {
            let released = drawTrigger(g, game.mouseDown(Mouse.Left), dt, (1 + p.stats.fireRate) * p.haste);
            if released >= 0 {
                fire(g, p, lvl, scene, e, sh, bs);
                if g.list[g.cur].boost > 0 { g.list[g.cur].boost -= 1; }
                g.cd = g.list[g.cur].interval / ((1 + p.stats.fireRate) * p.haste);
                g.cdLen = g.cd;
                g.bowCharge = 0;
                g.bowSpark = 0;
            }
        }
    } else if game.mouseCaptured() && g.cd <= 0 && g.reloadT <= 0 {
        let gun = current(g);
        // Other weapons fire while the button is held.
        let pull = game.mouseDown(Mouse.Left) && !g.locked;
        // The board only ollies off the ground; holding click isn't a reason to wait.
        if gun.kind == RIDE && !p.onGround { pull = false; }
        // No swinging mid-parry.
        if gun.gift == KATANA && p.parryT > 0 { pull = false; }
        if pull && gun.kind == JOUST {
            if g.couch > 0.6 && g.couchCd <= 0 && joust(g, p, e, sh, bs, powered(g)) && g.list[g.cur].boost > 0 { g.list[g.cur].boost -= 1; }
        } else if pull && gun.mag > 0 && gun.ammo <= 0 {
            startReload(g, p);
        } else if pull {
            fire(g, p, lvl, scene, e, sh, bs);
            g.cd = gun.interval / ((1 + p.stats.fireRate) * p.haste);
            g.cdLen = g.cd;
            if gun.mag > 0 {
                g.list[g.cur].ammo -= 1;
                // Empty: straight into the reload, and the super charge is spent.
                if g.list[g.cur].ammo == 0 {
                    g.list[g.cur].boost = 0;
                    startReload(g, p);
                }
            } else if gun.boost > 0 {
                g.list[g.cur].boost -= 1;
            }
        }
    }

    flight(g, p, lvl, e, sh, bs, dt);
    let i = 0;
    while i < 48 {
        g.tracers[i].t = g.tracers[i].t - dt;
        i += 1;
    }
    i = 0;
    while i < 128 {
        g.marks[i].t = g.marks[i].t - dt;
        i += 1;
    }
}

fn numKey(k: int): Key {
    if k == 0 { return Key.Num1; }
    if k == 1 { return Key.Num2; }
    if k == 2 { return Key.Num3; }
    if k == 3 { return Key.Num4; }
    if k == 4 { return Key.Num5; }
    if k == 5 { return Key.Num6; }
    if k == 6 { return Key.Num7; }
    return Key.Num8;
}

fn mark(g: &Guns, at: Vec3, color: Vec3) {
    g.marks[g.nextMark] = Mark { p: at, t: MARK_LIFE, color: color };
    g.nextMark = (g.nextMark + 1) % 128;
}

/// A bolt's target: the enemy in its cone scoring best on distance and angle, among the two
/// best, that the level's boxes don't hide; the boss when it beats them. -1 for none.
fn seek(e: &Enemies, bs: &Bosses, lvl: &Level, at: Vec3, dir: Vec3): int {
    let best = -1;
    let second = -1;
    let bestS: f32 = 1000000;
    let secondS: f32 = 1000000;
    if boss.targetable(bs) {
        let off = boss.aimPoint(bs) - at;
        let away = off.length();
        if away < BOLT_RANGE && away > 0.01 && off.dot(dir) / away > BOLT_CONE && clear(lvl, at, boss.aimPoint(bs)) {
            // A little keener on the boss than on a crowd around it.
            bestS = away * (2 - off.dot(dir) / away) * 0.8;
            best = AT_BOSS;
        }
    }
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 {
            let d = e.list[i].pos - at;
            let far = d.length();
            if far < BOLT_RANGE && far > 0.01 {
                let c = d.dot(dir) / far;
                if c > BOLT_CONE {
                    let score = far * (2 - c);
                    if score < bestS {
                        second = best;
                        secondS = bestS;
                        best = i;
                        bestS = score;
                    } else if score < secondS {
                        second = i;
                        secondS = score;
                    }
                }
            }
        }
        i += 1;
    }
    if best == AT_BOSS { return best; }
    if best >= 0 && clear(lvl, at, e.list[best].pos) { return best; }
    if second == AT_BOSS { return second; }
    if second >= 0 && clear(lvl, at, e.list[second].pos) { return second; }
    return -1;
}

/// Ballistic tip sweep: at most five distinct enemies, stopped by world/shrines/bosses.
fn arrowFlight(s: &Shot, lvl: &Level, e: &Enemies, sh: &Shrines, bs: &Bosses, dt: f32) {
    if s.stuck { return; }
    let left = dt;
    while left > 0 && s.t > 0 && !s.stuck {
        let tick = min(left, 0.016666667);
        left -= tick;
        let motion = s.vel * tick + Vec3.xyz(0, -0.5 * ARROW_GRAVITY * tick * tick, 0);
        s.vel.y -= ARROW_GRAVITY * tick;
        let distance = motion.length();
        if distance < 0.00001 { continue; }
        let dir = motion * (1 / distance);
        let r = Ray { origin: s.pos, dir: dir };
        let wall = sweep(lvl, r, distance);
        let near = distance;
        if wall.hit { near = (wall.point - s.pos).length(); }
        let who = 0;
        let index = -1;
        let stone = shrine.ray(sh, r, near);
        if stone.index >= 0 && max(0, stone.t) < near {
            near = max(0, stone.t); who = 2; index = stone.index;
        }
        let big = boss.ray(bs, r, near);
        if big.part >= 0 && max(0, big.t) < near {
            near = max(0, big.t); who = 3; index = big.part;
        }
        // Resolve every enemy before the nearest blocker, including overlapping
        // bodies in a single step. Remember hits across steps and frames.
        while s.hitCount < ARROW_HITS {
            let foe = enemies.rayExcept(e, r, near, s.hits[:]);
            if foe.index < 0 || max(0, foe.t) >= near { break; }
            let at = r.origin + dir * max(0, foe.t);
            s.hits[s.hitCount] = foe.index;
            s.hitCount += 1;
            enemies.damage(e, foe.index, s.damage, dir * 8, at);
            if s.hitCount == ARROW_HITS {
                s.pos = at;
                s.t = 0;
                return;
            }
        }
        s.pos = s.pos + dir * near;
        if who == 2 { shrine.damage(sh, e, index, s.damage, s.pos); }
        if who == 3 { boss.damage(bs, e, index, s.damage, s.pos); }
        if who != 0 {
            s.t = 0;
        } else if wall.hit {
            // Leave the shaft and feathers visible, with the head embedded.
            s.pos = s.pos + dir * 0.025;
            s.vel = dir;
            s.stuck = true;
            s.t = 8;
        }
    }
}

/// A short, fading wake follows the arrow's feathers and survives an impact.
fn arrowTrail(g: &Guns, a: Vec3, b: Vec3, color: Vec3) {
    if (b - a).length() < 0.001 { return; }
    g.trail[g.nextTrail] = Trail { a: a, b: b, t: TRAIL_LIFE, color: color };
    g.nextTrail = (g.nextTrail + 1) % MAX_TRAIL;
}

/// A glowing ribbon between two points. Wide haze, then a thin hot core.
fn ribbon(g: &Guns, a: Vec3, b: Vec3, color: Vec3, width: f32, alpha: f32) {
    let delta = b - a;
    let len = delta.length();
    if len < 0.02 || alpha <= 0 { return; }
    let mid = (a + b) * 0.5;
    let dir = delta * (1 / len);
    let m = along(mid, dir);
    gfx.material(color, color * 2.5);
    gfx.drawAlpha(g.cube, m.mul(Mat4.scale(width, width, len)), alpha * 0.45);
    gfx.material(Vec3.xyz(1, 1, 1), color * 5);
    gfx.drawAlpha(g.cube, m.mul(Mat4.scale(width * 0.28, width * 0.28, len)), alpha);
}

/// Rockets, bolts and arrows in flight.
fn flight(g: &Guns, p: &Player, lvl: &Level, e: &Enemies, sh: &Shrines, bs: &Bosses, dt: f32) {
    let fade = 0;
    while fade < MAX_TRAIL {
        g.trail[fade].t = max(0, g.trail[fade].t - dt);
        fade += 1;
    }
    let i = 0;
    while i < MAX_SHOTS {
        let s = &g.shots[i];
        if s.t > 0 {
            s.t = s.t - dt;
            if s.kind == ARROW {
                let start = s.pos - s.vel.normalize() * 0.8;
                let moving = !s.stuck && s.t > 0;
                arrowFlight(s, lvl, e, sh, bs, dt);
                if moving { arrowTrail(g, start, s.pos - s.vel.normalize() * 0.8, Vec3.xyz(0.55, 0.95, 0.7)); }
                i += 1;
                continue;
            }
            let dir = s.vel.normalize();
            if s.kind == BOLT {
                s.seekT = s.seekT - dt;
                if s.seekT <= 0 {
                    s.target = seek(e, bs, lvl, s.pos, dir);
                    s.seekT = BOLT_SEEK;
                }
                let homing = s.target >= 0 && e.list[s.target].kind != 0;
                let goal = s.pos;
                if homing { goal = e.list[s.target].pos; }
                if s.target == AT_BOSS && boss.targetable(bs) {
                    homing = true;
                    goal = boss.aimPoint(bs);
                }
                s.recover = max(0, s.recover - dt);
                let want = dir;
                let close = false;
                if s.recover > 0 {
                    // Swoop off: climb and curve away before the next dive.
                    want = (dir + Vec3.xyz(0, 0.9, 0)).normalize();
                } else if homing {
                    want = (goal - s.pos).normalize();
                    close = (goal - s.pos).length() < 4;
                } else {
                    // Nothing to hunt: circle overhead.
                    let ring = s.t * 2.5 + f32(i) * 1.3;
                    let orbit = p.pos + Vec3.xyz(cos(ring) * 7, 2.5 + sin(ring * 0.7) * 1.5, sin(ring) * 7);
                    want = (orbit - s.pos).normalize();
                }
                // Ground or a wall right ahead: pull up instead of hugging it.
                let turn = BOLT_TURN;
                if solid(lvl, s.pos + dir * 2.5, 0.1) >= 0 { turn = turn * BOLT_PULL_UP; }
                dir = (dir + (want - dir) * min(turn * dt, 1)).normalize();
                if !close {
                    let side = Vec3.xyz(0, 1, 0).cross(dir).normalize();
                    dir = (dir + side * (sin(s.t * 11 + f32(i) * 1.7) * BOLT_WEAVE * dt)).normalize();
                }
                s.vel = dir * BOLT_SPEED;
            }
            let step = s.vel.length() * dt;
            let r = Ray { origin: s.pos, dir: dir };
            let foe = enemies.ray(e, r, step);
            let stone = shrine.ray(sh, r, step);
            let big = boss.ray(bs, r, step);
            let end = s.pos + s.vel * dt;
            let wall = solid(lvl, end, 0.1) >= 0;
            let struck = foe.index >= 0 || stone.index >= 0 || big.part >= 0;
            if s.kind == BOLT && s.t > 0 && (struck || wall) && s.hitCount < BOLT_HITS {
                // A bolt that connects bursts and swoops away to dive again; a wall just turns it.
                if struck {
                    let hitAt = end;
                    let nearT = step;
                    if foe.index >= 0 { hitAt = s.pos + dir * foe.t; nearT = foe.t; }
                    if stone.index >= 0 && stone.t < nearT { hitAt = s.pos + dir * stone.t; nearT = stone.t; }
                    if big.part >= 0 && big.t < nearT { hitAt = s.pos + dir * big.t; }
                    enemies.blast(e, hitAt, WAND_BLAST * s.power, s.damage, Vec3.xyz(0.7, 0.5, 1), 3);
                    shrine.blast(sh, e, hitAt, WAND_BLAST * s.power, s.damage);
                    boss.blast(bs, e, hitAt, WAND_BLAST * s.power, s.damage);
                    mark(g, hitAt, Vec3.xyz(0.7, 0.5, 1));
                    s.hitCount += 1;
                    s.target = -1;
                    s.recover = BOLT_RECOVER;
                    s.pos = hitAt - dir * 0.3;
                } else {
                    s.recover = 0.3;
                }
                s.vel = (dir * BOLT_BOUNCE + Vec3.xyz(0, 1, 0)).normalize() * BOLT_SPEED;
                i += 1;
                continue;
            }
            if foe.index >= 0 || stone.index >= 0 || big.part >= 0 || wall || s.t <= 0 {
                let at = end;
                let near = step;
                if foe.index >= 0 { at = s.pos + dir * foe.t; near = foe.t; }
                if stone.index >= 0 && stone.t < near { at = s.pos + dir * stone.t; near = stone.t; }
                if big.part >= 0 && big.t < near { at = s.pos + dir * big.t; }
                if s.kind == ROCKET {
                    explode(g, p, e, sh, bs, at, s.damage, s.power);
                } else {
                    // A small magic burst: no rocket jump, a light shove.
                    enemies.blast(e, at, WAND_BLAST * s.power, s.damage, Vec3.xyz(0.7, 0.5, 1), 3);
                    shrine.blast(sh, e, at, WAND_BLAST * s.power, s.damage);
                    boss.blast(bs, e, at, WAND_BLAST * s.power, s.damage);
                    mark(g, at, Vec3.xyz(0.7, 0.5, 1));
                }
                s.t = 0;
            } else {
                let prev = s.pos;
                s.pos = end;
                let wake = Vec3.xyz(1, 0.45, 0.12);
                if s.kind == BOLT { wake = Vec3.xyz(0.7, 0.45, 1); }
                arrowTrail(g, prev, s.pos, wake);
            }
        }
        i += 1;
    }
}

/// A rocket going off: enemies and shrines around take the blast, and so does the player's
/// footing: standing in it throws you (a rocket jump), on the ground or in the air.
fn explode(g: &Guns, p: &Player, e: &Enemies, sh: &Shrines, bs: &Bosses, at: Vec3, dmg: f32, power: f32) {
    sfx.at(sfx.BOOM, at);
    let radius = BLAST * power;
    enemies.blast(e, at, radius, dmg, Vec3.xyz(1, 0.6, 0.2), 18);
    shrine.blast(sh, e, at, radius, dmg);
    boss.blast(bs, e, at, radius, dmg);
    mark(g, at, Vec3.xyz(1, 0.5, 0.2));
    let mid = p.pos + Vec3.xyz(0, 0.9, 0);
    let far = (mid - at).length();
    if far < radius {
        g.shake = max(g.shake, 0.04 * (1 - far / radius));
        let away = (mid - at).normalize();
        let jump = ROCKET_JUMP;
        if power > 1 { jump = jump * SUPER_KNOCK; }
        push(p, away * (jump * (1 - far / radius * 0.5)));
    }
}

/// Knife: everything close in front takes the slash.
fn slash(g: &Guns, p: &Player, e: &Enemies, sh: &Shrines, bs: &Bosses, gun: Gun) {
    let l = look(p);
    let fwd = l.forward();
    let reach = KNIFE_REACH;
    if gun.reach > 0 { reach = gun.reach; }
    let hit = false;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 {
            let to = en.pos - l.eye;
            if to.length() < reach && to.normalize().dot(fwd) > KNIFE_CONE {
                enemies.damage(e, i, gun.damage * dmgScale(p), fwd * gun.shove + Vec3.xyz(0, 3, 0), en.pos);
                hit = true;
            }
        }
        i += 1;
    }
    let stone = shrine.near(sh, l.eye, fwd, reach);
    if stone >= 0 { shrine.damage(sh, e, stone, gun.damage * dmgScale(p), l.eye + fwd * reach * 0.7); }
    let part = boss.near(bs, l.eye, fwd, reach);
    if part >= 0 {
        boss.damage(bs, e, part, gun.damage * dmgScale(p), l.eye + fwd * reach * 0.7);
        hit = true;
    }
    // A swipe streak across the view.
    let right = l.right();
    let mid = l.eye + fwd * 1.2;
    g.tracers[g.nextTracer] = Tracer { a: mid + right * 0.5 + Vec3.xyz(0, 0.25, 0), b: mid - right * 0.5 - Vec3.xyz(0, 0.2, 0),
        t: TRACER_LIFE * 2, color: Vec3.xyz(1, 1, 1), bullet: false };
    g.nextTracer = (g.nextTracer + 1) % 48;
    if hit { g.shake = max(g.shake, 0.01); }
}

/// The gun's own space in view space: hip or aimed, lowered while switching, kicked back.
fn gunInView(g: &Guns): Mat4 {
    let t = g.ads * g.ads * (3 - 2 * g.ads);
    // Where the gun sits in view space, at the hip and aimed.
    let hip = Vec3.xyz(0.19, -0.18, -0.5);
    let aimed = Vec3.xyz(0, -0.068, -0.4);
    let size: f32 = 0.55;
    if g.list[g.cur].kind == ARROW {
        hip = Vec3.xyz(0.24, -0.14, -0.48);
        aimed = Vec3.xyz(0.07, -0.035, -0.43);
        size = 0.85;
    }
    let at = hip + (aimed - hip) * t + g.sway * (1 - t * 0.7);
    at.y = at.y - g.switchT / SWITCH_TIME * 0.35;
    at.z = at.z + g.recoil * 0.05;
    // The knife stabs forward instead of kicking back.
    if g.list[g.cur].kind == MELEE { at = at + Vec3.xyz(-0.08, 0.03, -0.3) * g.recoil; }
    // Reload: tip down and roll in, then come back up.
    let r = reloading(g);
    let dip = sin(r * PI);
    at.y = at.y - dip * 0.12;
    let tilt = Mat4.rotate(Vec3.xyz(1, 0, 0), g.recoil * 0.12 - dip * 0.6).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), dip * 0.5));
    let held = g.list[g.cur];
    // Katana raised across the view to parry; lance up at rest, levelled when couched.
    if held.gift == KATANA {
        at = at + Vec3.xyz(-0.12, 0.1, -0.02) * g.parry;
        tilt = Mat4.rotate(Vec3.xyz(1, 0, 0), g.parry * 1.05).mul(tilt);
    }
    if held.kind == JOUST {
        at = at + Vec3.xyz(-0.08, 0.07, -0.02) * g.couch + Vec3.xyz(0.03, 0, 0.05) * (1 - g.couch);
        tilt = Mat4.rotate(Vec3.xyz(1, 0, 0), (1 - g.couch) * 0.85).mul(tilt);
        // Forced down while it rests.
        if g.couchCd > 0 { at = at + Vec3.xyz(0.02, -0.16, 0.06); tilt = Mat4.rotate(Vec3.xyz(1, 0, 0), -0.5).mul(tilt); }
    }
    // The knife turns to show its side, so the curve of the blade reads.
    if g.list[g.cur].kind == MELEE { tilt = Mat4.rotate(Vec3.xyz(0, 1, 0), 0.6).mul(tilt); }
    return Mat4.translate(at.x, at.y, at.z).mul(tilt).mul(Mat4.scale(size, size, size));
}

fn bowTip(g: &Guns): Vec3 { return Vec3.xyz(0, 0, -0.78 + g.bowCharge * 0.28); }

/// Local -Z follows the arrow's travel, even for nearly vertical shots.
fn along(tip: Vec3, dir: Vec3): Mat4 {
    let up = Vec3.up();
    if abs(dir.y) > 0.98 { up = Vec3.xyz(1, 0, 0); }
    return Mat4.lookAt(tip, tip + dir, up).affineInverse();
}

fn arrowBox(g: &Guns, base: Mat4, at: Vec3, size: Vec3, tint: Vec3) {
    gfx.material(tint, tint * 0.08);
    gfx.draw(g.cube, base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(size.x, size.y, size.z)));
}

/// The same shaft, pointed steel head and crossed feathers in hand and in flight.
fn drawArrow(g: &Guns, base: Mat4, glow: f32) {
    arrowBox(g, base, Vec3.xyz(0, 0, 0.435), Vec3.xyz(0.018, 0.018, 0.69), Vec3.xyz(0.65, 0.39, 0.18));
    gfx.material(Vec3.xyz(0.7, 0.8, 0.85), Vec3.xyz(0.45, 0.85, 0.65) * glow);
    gfx.draw(g.arrowhead, base.mul(Mat4.translate(0, 0, 0.06)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), -PI / 2)).mul(Mat4.scale(0.014, 0.12, 0.08)));
    arrowBox(g, base, Vec3.xyz(0, 0, 0.71), Vec3.xyz(0.006, 0.08, 0.13), Vec3.xyz(0.9, 0.3, 0.22));
    arrowBox(g, base, Vec3.xyz(0, 0, 0.71), Vec3.xyz(0.08, 0.006, 0.13), Vec3.xyz(0.95, 0.85, 0.6));
    arrowBox(g, base, Vec3.xyz(0, 0, 0.79), Vec3.xyz(0.023, 0.023, 0.025), Vec3.xyz(0.85, 0.8, 0.65));
}

fn drawBow(g: &Guns, base: Mat4) {
    let tip = bowTip(g);
    let nock = tip + Vec3.xyz(0, 0, 0.8);
    let sign: f32 = -1;
    while sign <= 1 {
        let end = Vec3.xyz(0, sign * 0.345 * (1 - g.bowCharge * 0.08), -0.028 + g.bowCharge * 0.08);
        let delta = end - nock;
        let stringBase = base.mul(along(nock, delta.normalize()));
        arrowBox(g, stringBase, Vec3.xyz(0, 0, -delta.length() * 0.5), Vec3.xyz(0.004, 0.004, delta.length()), Vec3.xyz(0.95, 0.9, 0.75));
        sign += 2;
    }
    if g.cd > 0 { return; }
    let ready: f32 = 0;
    if g.bowCharge >= 1 { ready = 0.35; }
    drawArrow(g, base.mul(Mat4.translate(tip.x, tip.y, tip.z)), ready);
    if g.bowSpark > 0 {
        let age = 1 - g.bowSpark / BOW_SPARK;
        let i = 0;
        while i < 8 {
            let angle = f32(i) * TAU / 8;
            let radius = 0.02 + age * 0.13;
            let at = tip + Vec3.xyz(cos(angle) * radius, sin(angle) * radius + age * 0.05, -0.02 - age * 0.03);
            let size = 0.012 * (1 - age);
            gfx.material(Vec3.zero(), Vec3.xyz(0.7, 1, 0.8) * ((1 - age) * 1.5));
            gfx.draw(g.cube, base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(size, size, size)));
            i += 1;
        }
    }
}

/// The sound of gun `i` going off, in `create`'s order.
fn bang(i: int) {
    let s = sfx.SHOT;
    if i == G_SNIPER { s = sfx.SNIPER; }
    if i == G_SHOTGUN { s = sfx.SHOTGUN; }
    if i == G_RPG { s = sfx.ROCKET; }
    if i == G_BOW { s = sfx.BOW; }
    if i == G_WAND { s = sfx.WAND; }
    if i == G_KNIFE || i == G_KATANA { s = sfx.SWISH; }
    if i == G_BOARD { s = sfx.JUMP; }
    sfx.play(s);
}

/// Scorcher: everything in a short, wide cone ahead burns, walls and the rest of the world stop it.
fn flame(g: &Guns, p: &Player, lvl: &Level, e: &Enemies, sh: &Shrines, bs: &Bosses, gun: Gun) {
    let l = look(p);
    let fwd = l.forward();
    let right = l.right();
    let up = right.cross(fwd);
    let wall = sweep(lvl, Ray { origin: l.eye, dir: fwd }, gun.reach);
    let far = gun.reach;
    if wall.hit { far = (wall.point - l.eye).length(); }
    let cone = tan(spread(g) * PI / 180);
    let dmg = gun.damage * dmgScale(p);
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 {
            let to = en.pos - l.eye;
            let along = to.dot(fwd);
            if along > 0.2 && along < far + 0.6 {
                let miss2 = to.dot(to) - along * along;
                let width = along * cone + 0.7;
                if miss2 < width * width { enemies.damage(e, i, dmg, fwd * gun.shove, en.pos); }
            }
        }
        i += 1;
    }
    let stone = shrine.near(sh, l.eye, fwd, far);
    if stone >= 0 { shrine.damage(sh, e, stone, dmg, l.eye + fwd * far); }
    let part = boss.near(bs, l.eye, fwd, far);
    if part >= 0 { boss.damage(bs, e, part, dmg, l.eye + fwd * far); }
    // Fat puffs of fire leave the nozzle, fly out along the cone, swell, cool and float up.
    let muzzle = l.eye + fwd * 0.8 + right * 0.2 - up * 0.16;
    let n = 0;
    while n < 5 {
        let speed = (far * 1.7 + 2) * (0.7 + g.rng.unit() * 0.4);
        let side = right * ((g.rng.unit() - 0.5) * 2 * cone * speed) + up * ((g.rng.unit() - 0.5) * 2 * cone * speed);
        let hue = Vec3.xyz(1, 0.5, 0.08);
        if n % 3 == 1 { hue = Vec3.xyz(1, 0.85, 0.3); }
        if n % 3 == 2 { hue = Vec3.xyz(0.9, 0.2, 0.05); }
        enemies.flameBit(e, muzzle, fwd * speed + side + p.vel * 0.5, hue, 0.4 + g.rng.unit() * 0.2, 0.16 + g.rng.unit() * 0.14);
        n += 1;
    }
    if game.ticks() - g.flameSfx > 450 {
        g.flameSfx = game.ticks();
        sfx.play(sfx.FLAME);
    }
    push(p, fwd * (0 - gun.knock));
    p.kick = p.kick + gun.kick;
    g.recoil = max(g.recoil, 0.25);
    g.flash = FLASH_LIFE;
    g.shake = max(g.shake, gun.shake);
}

/// Lance: what's in the narrow line ahead takes a hit scaled by how fast you are going that way.
/// True on a hit, which also costs you some of that speed.
fn joust(g: &Guns, p: &Player, e: &Enemies, sh: &Shrines, bs: &Bosses, gun: Gun): bool {
    let l = look(p);
    let fwd = l.forward();
    let speed = max(0, p.vel.dot(fwd));
    let dmg = (gun.damage + speed * JOUST_PER_SPEED) * dmgScale(p);
    let hit = false;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 && g.stab[i] <= 0 {
            let to = en.pos - l.eye;
            let along = to.dot(fwd);
            if along > 0.4 && along < gun.reach {
                let miss2 = to.dot(to) - along * along;
                if miss2 < JOUST_WIDTH * JOUST_WIDTH {
                    enemies.damage(e, i, dmg, fwd * (gun.shove + speed * 0.5) + Vec3.xyz(0, 4, 0), en.pos);
                    g.stab[i] = JOUST_REHIT;
                    hit = true;
                    // Each skewer costs a little speed.
                    p.vel.x = p.vel.x * JOUST_DRAG;
                    p.vel.z = p.vel.z * JOUST_DRAG;
                }
            }
        }
        i += 1;
    }
    // Shrines and bosses share one timer.
    if g.stab[MAX_ENEMIES] <= 0 {
        let world = false;
        let stone = shrine.near(sh, l.eye, fwd, gun.reach);
        if stone >= 0 {
            shrine.damage(sh, e, stone, dmg, l.eye + fwd * gun.reach * 0.8);
            world = true;
        }
        let part = boss.near(bs, l.eye, fwd, gun.reach);
        if part >= 0 {
            boss.damage(bs, e, part, dmg, l.eye + fwd * gun.reach * 0.8);
            world = true;
        }
        if world {
            g.stab[MAX_ENEMIES] = JOUST_REHIT;
            hit = true;
            p.vel.x = p.vel.x * JOUST_DRAG;
            p.vel.z = p.vel.z * JOUST_DRAG;
        }
    }
    if hit {
        g.recoil = 1;
        g.shake = max(g.shake, min(0.006 + speed * 0.001, 0.03));
        if speed > 14 { sfx.at(sfx.SLAM, l.eye + fwd * 3); }
    }
    return hit;
}

fn fire(g: &Guns, p: &Player, lvl: &Level, scene: &Scene, e: &Enemies, sh: &Shrines, bs: &Bosses) {
    let gun = powered(g);
    if gun.kind == FLAMER {
        flame(g, p, lvl, e, sh, bs, gun);
        return;
    }
    g.recoil = 1;
    bang(g.cur);
    if gun.kind == RIDE {
        p.vel.y = OLLIE;
        p.onGround = false;
        return;
    }
    if gun.kind == MELEE {
        slash(g, p, e, sh, bs, gun);
        return;
    }
    let l = look(p);
    let fwd = l.forward();
    let right = l.right();
    let up = right.cross(fwd);
    let cone = tan(spread(g) * PI / 180);
    let muzzle = l.view().affineInverse().mul(gunInView(g)).transformPoint(gun.muzzle);
    if gun.kind == ARROW {
        let tip = l.view().affineInverse().mul(gunInView(g)).transformPoint(bowTip(g));
        // Aim the physical arrow toward the crosshair, with gravity taking over in flight.
        let eyeRay = Ray { origin: l.eye, dir: fwd };
        let aimWall = sweep(lvl, eyeRay, 60);
        let aimFar = (aimWall.point - l.eye).length();
        let aimFoe = enemies.ray(e, eyeRay, aimFar);
        if aimFoe.index >= 0 { aimFar = max(1, aimFoe.t); }
        let aimBoss = boss.ray(bs, eyeRay, aimFar);
        if aimBoss.part >= 0 { aimFar = max(1, aimBoss.t); }
        let aimShrine = shrine.ray(sh, eyeRay, aimFar);
        if aimShrine.index >= 0 { aimFar = max(1, aimShrine.t); }
        // A viewmodel can overlap a wall. Start at the eye in that case so the
        // first sweep hits the wall instead of creating an arrow behind it.
        let toTip = tip - l.eye;
        let muzzleWall = sweep(lvl, Ray { origin: l.eye, dir: toTip.normalize() }, toTip.length());
        if muzzleWall.hit { tip = l.eye; }
        let arrowAim = (l.eye + fwd * max(1, aimFar) - tip).normalize();
        g.shots[g.nextShot] = Shot { hits: [-1, -1, -1, -1, -1], pos: tip, vel: arrowAim * arrowSpeed(g.bowCharge), t: 6, kind: ARROW,
            damage: gun.damage * arrowPower(g.bowCharge) * dmgScale(p), target: -1, seekT: 0 };
        g.nextShot = (g.nextShot + 1) % MAX_SHOTS;
        push(p, fwd * (0 - gun.knock * arrowPower(g.bowCharge)));
        p.kick += gun.kick * arrowPower(g.bowCharge);
        return;
    }
    if gun.kind == ROCKET || gun.kind == BOLT {
        let speed = ROCKET_SPEED;
        if gun.kind == BOLT { speed = BOLT_SPEED; }
        let aim = (fwd + right * ((g.rng.unit() - 0.5) * cone) + up * ((g.rng.unit() - 0.5) * cone)).normalize();
        // From the eye, so a shot at your feet can't start inside the floor.
        g.shots[g.nextShot] = Shot { hits: [-1, -1, -1, -1, -1], pos: l.eye + aim * 0.4, vel: aim * speed, t: if gun.kind == BOLT { BOLT_LIFE } else { 4 }, kind: gun.kind, damage: gun.damage * dmgScale(p), target: -1, seekT: 0, power: if gun.boost > 0 { SUPER_REACH } else { 1 } };
        g.nextShot = (g.nextShot + 1) % MAX_SHOTS;
    }
    let i = 0;
    if gun.kind != HITSCAN { i = gun.pellets; }
    while i < gun.pellets {
        let a = g.rng.unit() * TAU;
        let r = sqrt(g.rng.unit()) * cone;
        let dir = (fwd + right * (cos(a) * r) + up * (sin(a) * r)).normalize();
        let ray = Ray { origin: l.eye, dir: dir };
        let shot = shoot(lvl, scene, ray, REACH);
        let far = (shot.point - l.eye).length();
        let stone = shrine.ray(sh, ray, far);
        if stone.index >= 0 { far = stone.t; }
        // Nothing pierces a boss.
        let big = boss.ray(bs, ray, far);
        if big.part >= 0 {
            far = big.t;
            stone.index = -1;
        }
        let end = l.eye + dir * far;
        // Through the first enemy and `pierce` more, stopped by a wall, a shrine or the boss.
        let past = f32(0);
        let left = gun.pierce + 1;
        while left > 0 {
            let hit = enemies.ray(e, Ray { origin: l.eye + dir * past, dir: dir }, far - past);
            if hit.index < 0 { break; }
            let at = l.eye + dir * (past + hit.t);
            enemies.damage(e, hit.index, gun.damage * dmgScale(p), dir * gun.shove, at);
            past = past + hit.exit + 0.01;
            left -= 1;
            if left == 0 { end = at; }
        }
        if stone.index >= 0 && left > 0 { shrine.damage(sh, e, stone.index, gun.damage * dmgScale(p), end); }
        if big.part >= 0 && left > 0 { boss.damage(bs, e, big.part, gun.damage * dmgScale(p), end); }
        g.tracers[g.nextTracer] = Tracer { a: muzzle, b: end, t: TRACER_LIFE, color: gun.tracer, bullet: true };
        g.nextTracer = (g.nextTracer + 1) % 48;
        if shot.hit && left == gun.pierce + 1 && stone.index < 0 && big.part < 0 { mark(g, shot.point - dir * 0.03, gun.tracer); }
        i += 1;
    }
    push(p, fwd * (0 - gun.knock));
    p.kick = p.kick + gun.kick;
    g.flash = FLASH_LIFE;
    g.shake = max(g.shake, gun.shake);
}

/// Before the camera pass: the muzzle flash light (slot 7, after the scene's own).
pub fn lights(g: &Guns, l: Look) {
    if g.flash > 0 {
        gfx.light(7, l.eye + l.forward() * 0.8, Vec3.xyz(4, 2.6, 1.2), 7);
    } else {
        gfx.light(7, l.eye, Vec3.zero(), 0);
    }
}

/// The view the camera pass uses: the player's, shaken after a big shot.
pub fn view(g: &Guns, l: Look): Look {
    if g.shake <= 0.0005 { return l; }
    let s = l;
    s.yaw = s.yaw + (g.rng.unit() - 0.5) * g.shake;
    s.pitch = s.pitch + (g.rng.unit() - 0.5) * g.shake;
    return s;
}

/// In the camera pass, after the scene: tracers, impact marks, then the gun on top.
pub fn draw(g: &Guns, l: Look) {
    let wake = 0;
    while wake < MAX_TRAIL {
        let trail = g.trail[wake];
        if trail.t > 0 {
            let fade = trail.t / TRAIL_LIFE;
            ribbon(g, trail.a, trail.b, trail.color, 0.035 + fade * 0.03, fade);
        }
        wake += 1;
    }
    let i = 0;
    while i < 48 {
        let tr = g.tracers[i];
        if tr.t > 0 {
            let from = tr.a;
            let to = tr.b;
            let glow = tr.t / TRACER_LIFE;
            if tr.bullet {
                // The head crosses first; a short bright body follows, then catches up.
                let u = 1 - tr.t / TRACER_LIFE;
                let span = tr.b - tr.a;
                let dist = max(span.length(), 0.01);
                let headU = min(1, u / 0.42);
                // A short body, never a slice of the whole ray. A long mesh from the muzzle
                // fills the screen and the frame time collapses, which slows every gun.
                let reach = dist * 0.12;
                if reach < 1.4 { reach = 1.4; }
                if reach > 6 { reach = 6; }
                if reach > dist { reach = dist; }
                let gap = reach / dist;
                let tailU = max(0, headU - gap);
                if u > 0.42 {
                    let catchUp = (u - 0.42) / 0.58;
                    tailU = tailU + (1 - tailU) * catchUp;
                }
                from = tr.a + span * tailU;
                to = tr.a + span * headU;
                glow = 1;
                if u > 0.42 { glow = 1 - (u - 0.42) / 0.58; }
            } else {
                glow = tr.t / (TRACER_LIFE * 2);
            }
            // Width grows with how far the streak is, so a sniper round stays visible
            // without a brick sitting on the camera.
            let away = ((from + to) * 0.5 - l.eye).length();
            let width = 0.04 + away * 0.0035;
            if width > 0.45 { width = 0.45; }
            ribbon(g, from, to, tr.color, width, glow);
            // A screen-width core, so the same streak still reads through a scope.
            gfx.drawLine(from, to, tr.color + Vec3.xyz(0.7, 0.7, 0.7));
        }
        i += 1;
    }
    i = 0;
    while i < 128 {
        let mk = g.marks[i];
        if mk.t > 0 {
            let s = 0.12 * min(mk.t, 1);
            gfx.material(Vec3.xyz(0.2, 0.2, 0.2), mk.color * min(mk.t, 1.5));
            gfx.draw(g.cube, Mat4.translate(mk.p.x, mk.p.y, mk.p.z).mul(Mat4.scale(s, s, s)));
        }
        i += 1;
    }

    i = 0;
    while i < MAX_SHOTS {
        let pr = g.shots[i];
        if pr.t > 0 {
            let spin = Mat4.translate(pr.pos.x, pr.pos.y, pr.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 1, 0).normalize(), pr.t * 12));
            if pr.kind == ARROW {
                drawArrow(g, along(pr.pos, pr.vel.normalize()), 0);
            } else if pr.kind == ROCKET {
                gfx.material(Vec3.xyz(0.9, 0.9, 0.85), Vec3.xyz(0.3, 0.1, 0.05));
                gfx.draw(g.cube, spin.mul(Mat4.scale(0.22, 0.22, 0.22)));
                let tail = pr.pos - pr.vel.normalize() * 0.25;
                gfx.material(Vec3.zero(), Vec3.xyz(3, 1.4, 0.3));
                gfx.draw(g.cube, Mat4.translate(tail.x, tail.y, tail.z).mul(Mat4.scale(0.16, 0.16, 0.16)));
            } else {
                gfx.material(Vec3.xyz(0.8, 0.6, 1), Vec3.xyz(1.6, 1, 3));
                gfx.draw(g.cube, spin.mul(Mat4.scale(0.16, 0.16, 0.16)));
            }
        }
        i += 1;
    }
    if scoped(g) {
        gfx.surface(gfx.plainSurface());
        return;
    }
    gfx.clearDepth();
    let gun = current(g);
    let toWorld = l.view().affineInverse().mul(gunInView(g));
    i = 0;
    while i < gun.count {
        let pt = gun.parts[i];
        if gun.kind == ARROW && i >= 2 {
            // Limbs flex toward the drawing hand, strongest at their tips.
            let bend = g.bowCharge * min(1, abs(pt.at.y) / 0.35);
            pt.at.z += bend * 0.08;
            pt.at.y *= 1 - g.bowCharge * 0.08;
            if pt.at.y > 0 { pt.tilt -= g.bowCharge * 0.12; } else { pt.tilt += g.bowCharge * 0.12; }
        }
        let heat = Vec3.xyz(0.55, 0.2, 0.03) * (g.hot * (0.6 + 0.4 * sin(f32(game.ticks()) * 0.015)));
        if gun.gift == KATANA { heat = heat + Vec3.xyz(0.1, 0.45, 0.9) * (g.parry * 1.2); }
        if gun.boost > 0 { heat = heat + Vec3.xyz(0.32, 0.22, 0.04) * (0.8 + 0.2 * sin(f32(game.ticks()) * 0.006)); }
        gfx.material(pt.color, pt.color * 0.08 + pt.glow + heat);
        gfx.draw(g.cube, toWorld.mul(Mat4.translate(pt.at.x, pt.at.y, pt.at.z)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), pt.tilt)).mul(Mat4.scale(pt.size.x, pt.size.y, pt.size.z)));
        i += 1;
    }
    if gun.kind == ARROW { drawBow(g, toWorld); }
    if g.flash > 0 {
        let f = g.flash / FLASH_LIFE;
        let size = 0.09 + 0.05 * f;
        gfx.material(Vec3.zero(), Vec3.xyz(3, 2.2, 0.9));
        let at = gun.muzzle;
        gfx.draw(g.cube, toWorld.mul(Mat4.translate(at.x, at.y, at.z - 0.04)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), f * 2)).mul(Mat4.scale(size, size, size * 1.6)));
    }
    gfx.surface(gfx.plainSurface());
}


/// Bow input, ballistic motion and occlusion checks, using the real weapon code.
pub fn selfCheck(mem: &Arena, scene: &Scene) {
    let g = create(mem);
    g.cur = G_BOW;
    if drawTrigger(&g, false, 0.1, 1) >= 0 { panic("bow check: idle release fired"); }
    if drawTrigger(&g, true, 0.25, 1) >= 0 { panic("bow check: fired while drawing"); }
    let weak = drawTrigger(&g, false, 0, 1);
    if abs(weak - 0.25) > 0.001 { panic("bow check: early release charge"); }
    cancelDraw(&g);
    drawTrigger(&g, true, 1, 1);
    if g.bowCharge != 1 || g.bowSpark <= 0 { panic("bow check: missing full draw cue"); }
    g.bowSpark = 0;
    drawTrigger(&g, true, 2, 1);
    if g.bowSpark > 0 || g.bowCharge != 1 { panic("bow check: full draw cue repeated"); }
    let full = drawTrigger(&g, false, 0, 1);
    if full != 1 || drawTrigger(&g, false, 0, 1) >= 0 { panic("bow check: release repeated"); }
    if arrowSpeed(weak) >= arrowSpeed(full) || arrowPower(weak) >= arrowPower(full) { panic("bow check: charge did not scale shot"); }
    drawTrigger(&g, true, 0.5, 1);
    cancelDraw(&g);
    if drawTrigger(&g, false, 0, 1) >= 0 || g.bowSpark > 0 { panic("bow check: cancelled draw fired"); }
    drawTrigger(&g, true, 0.5, 2);
    if g.bowCharge != 1 { panic("bow check: fire rate did not speed draw"); }
    cancelDraw(&g);

    let lvl = level.empty(mem, 1, 0);
    // Floor well below the test flight, and room in the grid for every shot.
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(-20, -21, -30), hi: Vec3.xyz(20, -20, 20), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    let e = enemies.create(mem);
    let sh = shrine.create(mem);
    let bs = boss.create(mem);
    let p = player.create(&lvl);
    p.pos = Vec3.zero();
    p.onGround = true;
    let slow = Shot { hits: [-1, -1, -1, -1, -1], pos: Vec3.xyz(0, 5, 0), vel: Vec3.xyz(0, 0, -arrowSpeed(weak)), t: 6,
        kind: ARROW, damage: 120 * arrowPower(weak), target: -1, seekT: 0 };
    let fast = Shot { hits: [-1, -1, -1, -1, -1], pos: Vec3.xyz(0, 5, 0), vel: Vec3.xyz(0, 0, -arrowSpeed(full)), t: 6,
        kind: ARROW, damage: 120 * arrowPower(full), target: -1, seekT: 0 };
    arrowFlight(&slow, &lvl, &e, &sh, &bs, 0.1);
    arrowFlight(&fast, &lvl, &e, &sh, &bs, 0.1);
    if fast.pos.z >= slow.pos.z || abs(fast.pos.y - 4.88) > 0.002 || fast.vel.y >= 0 { panic("bow check: ballistic motion"); }
    // Both early and full releases produce projectiles, not instant damage.
    enemies.spawnAt(&e, 1, Vec3.xyz(0, 1.6, -5), Vec3.zero(), false);
    e.list[0].hp = 1000;
    e.list[0].mod = 0;
    let k = 0;
    while k < 2 {
        let charge = weak;
        if k == 1 { charge = full; }
        g.bowCharge = charge;
        let before = e.list[0].hp;
        let slot = g.nextShot;
        fire(&g, &p, &lvl, scene, &e, &sh, &bs);
        if e.list[0].hp != before || g.shots[slot].kind != ARROW { panic("bow check: release was hitscan"); }
        if abs(g.shots[slot].vel.length() - arrowSpeed(charge)) > 0.01 { panic("bow check: release speed"); }
        arrowFlight(&g.shots[slot], &lvl, &e, &sh, &bs, 0.4);
        if abs(before - e.list[0].hp - 120 * arrowPower(charge)) > 0.01 { panic("bow check: release damage"); }
        arrowFlight(&g.shots[slot], &lvl, &e, &sh, &bs, 0.4);
        if abs(before - e.list[0].hp - 120 * arrowPower(charge)) > 0.01 { panic("bow check: arrow hit twice"); }
        p.kick = 0;
        p.vel = Vec3.zero();
        k += 1;
    }
    // A thin wall beats the enemy behind it, even across a whole low-FPS step.
    lvl.boxes[0] = Box { lo: Vec3.xyz(-10, -10, -2.02), hi: Vec3.xyz(10, 10, -2), launch: 0, kind: level.BARRIER };
    level.index(&lvl, mem);
    let blocked = Shot { hits: [-1, -1, -1, -1, -1], pos: Vec3.xyz(0, 1.6, 0), vel: Vec3.xyz(0, 0, -85), t: 6,
        kind: ARROW, damage: 120, target: -1, seekT: 0 };
    let health = e.list[0].hp;
    arrowFlight(&blocked, &lvl, &e, &sh, &bs, 0.2);
    if !blocked.stuck || abs(blocked.pos.z + 2.025) > 0.01 || e.list[0].hp != health { panic("bow check: shot through thin wall"); }
    let lodged = blocked.pos;
    arrowFlight(&blocked, &lvl, &e, &sh, &bs, 1);
    if (blocked.pos - lodged).length() > 0.001 { panic("bow check: embedded arrow moved"); }
    // Fire with the bowtip on the far side of a nearby wall: it must still hit it.
    lvl.boxes[0].lo.z = -0.11;
    lvl.boxes[0].hi.z = -0.1;
    level.index(&lvl, mem);
    g.bowCharge = 1;
    let closeSlot = g.nextShot;
    fire(&g, &p, &lvl, scene, &e, &sh, &bs);
    arrowFlight(&g.shots[closeSlot], &lvl, &e, &sh, &bs, 0.05);
    if !g.shots[closeSlot].stuck || g.shots[closeSlot].pos.z < -0.14 { panic("bow check: muzzle bypassed wall"); }
    // A dense line: five distinct enemies take full damage, the sixth is untouched.
    lvl.boxes[0] = Box { lo: Vec3.xyz(-20, -21, -30), hi: Vec3.xyz(20, -20, 20), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    let row = 0;
    while row < 6 {
        if row > 0 { enemies.spawnAt(&e, 1, Vec3.zero(), Vec3.zero(), false); }
        e.list[row].pos = Vec3.xyz(0, 1.6, -1 - f32(row) * 0.2);
        e.list[row].hp = 1000;
        e.list[row].mod = 0;
        row += 1;
    }
    let clearShot = 0;
    while clearShot < MAX_SHOTS { g.shots[clearShot].t = 0; clearShot += 1; }
    g.shots[0] = Shot { hits: [-1, -1, -1, -1, -1], pos: Vec3.xyz(0, 1.6, 0), vel: Vec3.xyz(0, 0, -85),
        t: 6, kind: ARROW, damage: 120, target: -1, seekT: 0 };
    flight(&g, &p, &lvl, &e, &sh, &bs, 0.05);
    if g.shots[0].hitCount != 5 || g.shots[0].t > 0 { panic("bow check: five-enemy limit"); }
    row = 0;
    while row < 6 {
        let expected: f32 = 880;
        if row == 5 { expected = 1000; }
        if e.list[row].hp != expected { panic("bow check: piercing damage or duplicate hit"); }
        row += 1;
    }
    if g.nextTrail != 1 || g.trail[0].t <= 0 || (g.trail[0].b - g.trail[0].a).length() < 0.1 { panic("bow check: missing arrow trail"); }
    flight(&g, &p, &lvl, &e, &sh, &bs, TRAIL_LIFE + 0.01);
    if g.trail[0].t > 0 || g.nextTrail != 1 { panic("bow check: trail did not expire"); }
    // Piercing must not carry damage through a wall after the first enemy.
    row = 2;
    while row < 6 { e.list[row].kind = 0; row += 1; }
    e.list[0].pos = Vec3.xyz(0, 1.6, -1);
    e.list[1].pos = Vec3.xyz(0, 1.6, -3);
    lvl.boxes[0] = Box { lo: Vec3.xyz(-10, -10, -2.02), hi: Vec3.xyz(10, 10, -2), launch: 0, kind: level.BARRIER };
    level.index(&lvl, mem);
    let piercingWall = Shot { hits: [-1, -1, -1, -1, -1], pos: Vec3.xyz(0, 1.6, 0), vel: Vec3.xyz(0, 0, -85),
        t: 6, kind: ARROW, damage: 120, target: -1, seekT: 0 };
    arrowFlight(&piercingWall, &lvl, &e, &sh, &bs, 0.1);
    if !piercingWall.stuck || piercingWall.hitCount != 1 || e.list[0].hp != 760 || e.list[1].hp != 880 { panic("bow check: pierced through wall"); }

}
