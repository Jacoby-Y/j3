// Rime: a skating ice brute on Frostpeak. It glides round the player leaving slick ice (the
// player keeps their momentum on it), hurls blocks of ice that stand as cover for a while, then
// marks a lane and charges down it. Bait the charge into one of its own blocks: the block
// shatters, a shard of its armor breaks, and it's knocked flat with its core exposed. A wall
// only stuns it. In phase two it skates faster and charges straight after every throw, so the
// blocks are fresh when it comes.

module fps_shooter.rime;

use j3.math.{ Mat4, Vec3, TAU, clamp, cos, max, min, sin };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, CHUNK, FROST, STRAFE, addPart, beam, box, bit, bulk, burst, clearParts,
    flat, flatDist, forward, frame, groundTop, limb, lob, patch, shatter, smoke, tilt, turn, walk, walled, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.{ Player, hurt };
use fps_shooter.sfx;

const RISE: int = 0;
const SKATE: int = 1;
pub const SKATING: int = SKATE;
const WINDUP: int = 2;
const THROW: int = 3;
const TELL: int = 4;
const CHARGE: int = 5;
const SKID: int = 6;
const BONK: int = 7;
const DOWN: int = 8;
const IDLE: int = 9;

const RISE_T: f32 = 1.8;
const SKATE_T: f32 = 2.2;
const SKATE_T2: f32 = 1.6;
const SKATE_SPEED: f32 = 12;
const SKATE_SPEED2: f32 = 14;
/// It circles the player this far out while skating.
const CIRCLE: f32 = 14;
const WINDUP_T: f32 = 0.8;
const WINDUP_T2: f32 = 0.6;
const CHUNKS: int = 2;
const CHUNKS2: int = 3;
const THROW_GAP: f32 = 0.3;
const THROW_T: f32 = 1.1;
const CHUNK_DMG: f32 = 18;
const TELL_T: f32 = 1.0;
const TELL_T2: f32 = 0.8;
const CHARGE_SPEED: f32 = 26;
const CHARGE_LEN: f32 = 46;
const CHARGE_DMG: f32 = 30;
const SKID_T: f32 = 0.6;
const BONK_T: f32 = 1.1;
const DOWN_T: f32 = 3.5;
const DOWN_T2: f32 = 3.0;
/// Its own ice under it: a patch this often, this big, for this long.
const TRAIL_EVERY: f32 = 1.4;
const TRAIL_R: f32 = 2.1;
const TRAIL_LIFE: f32 = 14;
/// Armor shards, and the health a shattered one takes with it.
const SHARDS: int = 4;
const SHATTER_HP: f32 = 0.05;
const CORE: f32 = 3;
const LEASH: f32 = 48;

fn ice(): Vec3 {
    return Vec3.xyz(0.4, 1.4, 3);
}

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.aim = b.pos;
    b.pos = b.aim - Vec3.xyz(0, 5, 0);
    b.state = RISE;
    b.t = 0;
    b.len = RISE_T;
    b.intro = RISE_T;
    b.armor = SHARDS;
    b.step = 0;
    b.cycle = 0;
}

fn to(b: &Boss, state: int, len: f32) {
    b.state = state;
    b.t = 0;
    b.len = len;
}

/// Lay ice where it's skated.
fn trail(bs: &Bosses, moved: f32) {
    let b = &bs.b;
    b.heat += moved;
    if b.heat >= TRAIL_EVERY {
        b.heat = 0;
        patch(bs, FROST, b.pos, TRAIL_R, TRAIL_LIFE);
    }
}

/// Glide toward the circle round the player, turning to face where it goes.
fn skate(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    let a = b.anim * 0.5 + f32(b.cycle) * 1.3;
    let goal = flat(p.pos) + Vec3.xyz(cos(a) * CIRCLE, 0, sin(a) * CIRCLE);
    let fromHome = goal - flat(b.home);
    if fromHome.length() > LEASH { goal = flat(b.home) + fromHome.normalize() * LEASH; }
    let speed = if b.phase2 { SKATE_SPEED2 } else { SKATE_SPEED };
    let want = flat(goal - b.pos);
    if want.length() > speed { want = want.normalize() * speed; }
    b.vel = b.vel + (want - b.vel) * min(dt * 2, 1);
    let was = b.pos;
    walk(bs, lvl, b.vel, 1.3, 1.2, dt);
    if b.vel.length() > 1 { b.yaw = turn(b.yaw, yawTo(Vec3.zero(), b.vel), dt * 4); }
    trail(bs, flatDist(was, b.pos));
}

fn throwAt(bs: &Bosses, p: &Player, lvl: &Level) {
    let b = &bs.b;
    let aim = flat(p.pos + p.vel * 0.4);
    if b.step > 0 {
        let ahead = forward(b.yaw);
        let side = Vec3.xyz(0 - ahead.z, 0, ahead.x);
        let k = if b.step % 2 == 1 { 1 } else { -1 };
        aim = aim + side * (f32(k) * (3.5 + f32(b.step / 2) * 3)) + forward(b.yaw) * (bs.rng.unit() * 4 - 2);
    }
    let y = groundTop(lvl, aim.x, aim.z, 1.0, p.pos.y + 2);
    if y < -50 { return; }
    let hand = frame(b.pos, b.yaw).transformPoint(Vec3.xyz(1.2, 4.6, 0.3));
    lob(bs, CHUNK, hand, Vec3.xyz(aim.x, y, aim.z), THROW_T, 5, CHUNK_DMG, 1.6, true, ice());
    sfx.at(sfx.SWISH, b.pos);
}

/// Mark the lane and set off down it.
fn tell(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    b.dir = flat(p.pos - b.pos).normalize();
    if b.dir.length() < 0.5 { b.dir = forward(b.yaw); }
    b.yaw = yawTo(Vec3.zero(), b.dir);
    b.from = b.pos;
    let t = if b.phase2 { TELL_T2 } else { TELL_T };
    to(b, TELL, t);
    b.cd = f32(beam(bs, STRAFE, b.pos, b.dir, CHARGE_LEN, 1.6, t, CHARGE_SPEED, 3, 0, ice()));
    b.cd2 = 0;
    sfx.at(sfx.WARN, b.pos);
}

fn endLane(bs: &Bosses) {
    let i = int(bs.b.cd);
    if i >= 0 && i < bs.beams.len { bs.beams[i].live = false; }
}

/// Knocked flat into its own ice: a shard breaks, and its core is open for a while.
fn fall(bs: &Bosses, chunk: int) {
    let b = &bs.b;
    shatter(bs, chunk);
    endLane(bs);
    if b.armor > 0 { b.armor -= 1; }
    b.hp -= b.maxHp * SHATTER_HP;
    b.flash = 0.1;
    burst(bs, b.pos + Vec3.xyz(0, 3.2, 0), 24, 10, Vec3.xyz(0.8, 0.92, 1), Vec3.xyz(0.3, 0.7, 1.4));
    sfx.at(sfx.ROAR, b.pos);
    bs.shake = max(bs.shake, 0.03);
    b.vel = b.dir * 4;
    to(b, DOWN, if b.phase2 { DOWN_T2 } else { DOWN_T });
}

fn charge(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    let step = b.dir * CHARGE_SPEED;
    // Its own ice in the way.
    let i = 0;
    while i < bs.chunks.len {
        let c = bs.chunks[i];
        if c.live && flatDist(b.pos + b.dir * 1.2, c.at) < c.half + 1.6 {
            fall(bs, i);
            return;
        }
        i += 1;
    }
    let was = b.pos;
    let stopped = walk(bs, lvl, step, 1.3, 1.2, dt);
    trail(bs, flatDist(was, b.pos));
    if bs.fxRng.unit() < dt * 40 {
        smoke(bs, b.pos, 1, 2, Vec3.xyz(0.85, 0.92, 1), Vec3.xyz(0.1, 0.2, 0.3));
    }
    // Running the player down: once per charge.
    let off = p.pos - b.pos;
    if b.cd2 == 0 && flatDist(p.pos, b.pos) < 2.3 && off.y > -1 && off.y < 3.5 {
        if hurt(p, CHARGE_DMG, b.dir * 16 + Vec3.xyz(0, 8, 0)) { bs.shake = max(bs.shake, 0.05); }
        b.cd2 = 1;
    }
    if stopped || flatDist(b.pos, b.home) > LEASH + 8 {
        endLane(bs);
        sfx.at(sfx.SLAM, b.pos);
        burst(bs, b.pos + b.dir * 1.5 + Vec3.xyz(0, 2, 0), 10, 6, Vec3.xyz(0.8, 0.9, 1), Vec3.zero());
        bs.shake = max(bs.shake, 0.02);
        to(b, BONK, BONK_T);
    } else if flatDist(b.pos, b.from) >= CHARGE_LEN {
        endLane(bs);
        b.vel = b.dir * CHARGE_SPEED;
        to(b, SKID, SKID_T);
    }
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    b.anim += dt;
    b.open = b.open + (b.openTo - b.open) * min(dt * 5, 1);
    b.openTo = 0;
    if b.state == RISE {
        let k = clamp(b.t / b.len, 0, 1);
        b.pos = b.aim - Vec3.xyz(0, 5 * (1 - k) * (1 - k), 0);
        if bs.fxRng.unit() < dt * 30 {
            burst(bs, b.aim + Vec3.xyz(0, 0.3, 0), 2, 7, Vec3.xyz(0.8, 0.92, 1), Vec3.xyz(0.2, 0.4, 0.8));
        }
        if k >= 1 {
            b.pos = b.aim;
            sfx.at(sfx.ROAR, b.pos);
            to(b, SKATE, SKATE_T);
        }
    } else if b.state == SKATE || b.state == IDLE {
        if b.engaged {
            skate(bs, p, lvl, dt);
            if b.state == IDLE { to(b, SKATE, SKATE_T); }
        } else {
            b.vel = b.vel * max(1 - dt * 2, 0);
            walk(bs, lvl, flat(b.home - b.pos) * 0.5, 1.3, 1.2, dt);
            b.state = IDLE;
        }
        if b.state == SKATE && b.t >= (if b.phase2 { SKATE_T2 } else { SKATE_T }) {
            b.vel = b.vel * 0.3;
            b.step = 0;
            if b.cycle % 2 == 0 {
                to(b, WINDUP, if b.phase2 { WINDUP_T2 } else { WINDUP_T });
            } else {
                tell(bs, p);
            }
        }
    } else if b.state == WINDUP {
        b.vel = b.vel * max(1 - dt * 4, 0);
        walk(bs, lvl, b.vel, 1.3, 1.2, dt);
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 5);
        if b.t >= b.len { to(b, THROW, 0); }
    } else if b.state == THROW {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 5);
        let n = if b.phase2 { CHUNKS2 } else { CHUNKS };
        if b.step < n && b.t >= f32(b.step) * THROW_GAP {
            throwAt(bs, p, lvl);
            b.step += 1;
        }
        if b.step >= n && b.t >= f32(n) * THROW_GAP + 0.2 {
            b.cycle += 1;
            // Phase two: straight into a charge while the blocks are fresh.
            if b.phase2 { b.cycle += 1; tell(bs, p); } else { to(b, SKATE, SKATE_T); }
        }
    } else if b.state == TELL {
        // Stamping in place, turning to track the player until it goes.
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2);
        let d = forward(b.yaw);
        b.dir = d;
        let i = int(b.cd);
        if i >= 0 && i < bs.beams.len && bs.beams[i].live {
            bs.beams[i].dir = d;
            bs.beams[i].side = Vec3.xyz(0 - d.z, 0, d.x);
            bs.beams[i].from = b.pos;
        }
        if bs.fxRng.unit() < dt * 12 { smoke(bs, b.pos, 1, 2.5, Vec3.xyz(0.85, 0.92, 1), Vec3.zero()); }
        if b.t >= b.len {
            b.from = b.pos;
            to(b, CHARGE, 3);
            sfx.at(sfx.DASH, b.pos);
        }
    } else if b.state == CHARGE {
        charge(bs, p, lvl, dt);
    } else if b.state == SKID {
        b.vel = b.vel * max(1 - dt * 5, 0);
        let was = b.pos;
        walk(bs, lvl, b.vel, 1.3, 1.2, dt);
        trail(bs, flatDist(was, b.pos));
        if b.t >= b.len { b.cycle += 1; to(b, SKATE, SKATE_T); }
    } else if b.state == BONK {
        if b.t >= b.len { b.cycle += 1; to(b, SKATE, SKATE_T); }
    } else if b.state == DOWN {
        b.openTo = 1;
        b.cue = true;
        b.vel = b.vel * max(1 - dt * 3, 0);
        walk(bs, lvl, b.vel, 1.3, 1.2, dt);
        if bs.fxRng.unit() < dt * 8 {
            burst(bs, b.pos + Vec3.xyz(0, 2, 0), 1, 3, Vec3.xyz(0.8, 0.92, 1), Vec3.xyz(0.3, 0.7, 1.4));
        }
        if b.t >= b.len {
            b.cycle += 1;
            sfx.at(sfx.ROAR, b.pos);
            to(b, SKATE, SKATE_T);
        }
    }
    pose(bs);
    bs.glowAt = torso(b).transformPoint(Vec3.xyz(0, 2.3, -2.5));
    bs.glowColor = Vec3.xyz(0.3, 0.8, 1.6) * (0.1 + b.open * 0.6);
    bs.glowR = 6 + b.open * 5;
}

/// Hunched forward skating; flat on its back when down; reared up to throw.
fn torso(b: &Boss): Mat4 {
    let lean: f32 = 0.3;
    if b.state == CHARGE || b.state == TELL { lean = 0.55; }
    if b.state == WINDUP || b.state == THROW { lean = -0.1; }
    lean = lean + (-1.2 - lean) * b.open;
    return frame(b.pos, b.yaw).mul(Mat4.translate(0, 1.0, 0)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), 0 - lean)).mul(Mat4.translate(0, -1.0, 0));
}

fn pose(bs: &Bosses) {
    let b = &bs.b;
    clearParts(bs);
    let t = torso(b);
    let core: f32 = if b.state == DOWN { CORE } else { 1.2 };
    addPart(bs, t.transformPoint(Vec3.xyz(0, 2.3, -1.15)), 0.6, core, WEAK);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 2.4, 0)), 1.8, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 3.2, -1.3)), 0.7, 1, BODY);
    addPart(bs, frame(b.pos, b.yaw).transformPoint(Vec3.xyz(0, 0.9, 0)), 1.2, 1, BODY);
    bulk(bs, 1.5, b.pos.y, b.pos.y + 3.5);
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let frost = Vec3.xyz(0.78, 0.86, 0.95);
    let pale = Vec3.xyz(0.9, 0.95, 1);
    let dark = Vec3.xyz(0.33, 0.4, 0.55);
    let shard = Vec3.xyz(0.7, 0.9, 1);
    let base = frame(b.pos, b.yaw);
    let t = torso(b);
    // Skates and stubby legs.
    bit(bs, base, Vec3.xyz(-0.6, 0.08, 0), Vec3.xyz(0.2, 0.15, 1.7), Vec3.zero(), ice());
    bit(bs, base, Vec3.xyz(0.6, 0.08, 0), Vec3.xyz(0.2, 0.15, 1.7), Vec3.zero(), ice());
    box(bs, base, Vec3.xyz(-0.6, 0.6, 0.1), Vec3.xyz(0.85, 0.9, 1.0), dark, Vec3.zero());
    box(bs, base, Vec3.xyz(0.6, 0.6, 0.1), Vec3.xyz(0.85, 0.9, 1.0), dark, Vec3.zero());
    // Body, belly, head, tusks, eyes.
    box(bs, t, Vec3.xyz(0, 2.35, 0), Vec3.xyz(3.0, 2.2, 2.0), frost, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 1.7, -0.95), Vec3.xyz(2.2, 1.0, 0.3), pale, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 3.15, -1.35), Vec3.xyz(1.3, 0.95, 1.1), frost, Vec3.zero());
    bit(bs, t, Vec3.xyz(-0.35, 2.6, -1.85), Vec3.xyz(0.14, 0.45, 0.14), pale, Vec3.zero());
    bit(bs, t, Vec3.xyz(0.35, 2.6, -1.85), Vec3.xyz(0.14, 0.45, 0.14), pale, Vec3.zero());
    bit(bs, t, Vec3.xyz(-0.3, 3.25, -1.91), Vec3.xyz(0.28, 0.14, 0.05), Vec3.zero(), ice() * 1.2);
    bit(bs, t, Vec3.xyz(0.3, 3.25, -1.91), Vec3.xyz(0.28, 0.14, 0.05), Vec3.zero(), ice() * 1.2);
    // The core in its chest, bright when it's down.
    let coreGlow = ice() * (0.5 + b.open * 1.5 + 0.2 * sin(b.anim * 6));
    tilt(bs, t, Vec3.xyz(0, 2.3, -1.05), Vec3.xyz(0.7, 0.7, 0.7), 0.785, 0.785, Vec3.xyz(0.8, 0.95, 1), coreGlow);
    // Armor shards on its back and shoulders, one fewer for each shattering.
    if b.armor > 0 { tilt(bs, t, Vec3.xyz(-1.2, 3.6, 0.3), Vec3.xyz(0.5, 1.5, 0.5), -0.4, 0.35, shard, Vec3.xyz(0.3, 0.7, 1.2)); }
    if b.armor > 1 { tilt(bs, t, Vec3.xyz(1.2, 3.6, 0.3), Vec3.xyz(0.5, 1.5, 0.5), -0.4, -0.35, shard, Vec3.xyz(0.3, 0.7, 1.2)); }
    if b.armor > 2 { tilt(bs, t, Vec3.xyz(-0.45, 3.9, 0.8), Vec3.xyz(0.45, 1.7, 0.45), -0.6, 0.15, shard, Vec3.xyz(0.3, 0.7, 1.2)); }
    if b.armor > 3 { tilt(bs, t, Vec3.xyz(0.45, 3.95, 0.8), Vec3.xyz(0.45, 1.8, 0.45), -0.6, -0.15, shard, Vec3.xyz(0.3, 0.7, 1.2)); }
    // Long arms down to knuckles on the ice; the right one up with a block to throw.
    let side: f32 = -1;
    while side < 2 {
        let shoulder = t.transformPoint(Vec3.xyz(side * 1.7, 2.9, -0.1));
        let swing = sin(b.anim * 5 + side) * 0.5;
        let hand = base.transformPoint(Vec3.xyz(side * 2.0, 0.7, -0.8 + swing));
        if side > 0 && (b.state == WINDUP || b.state == THROW) {
            hand = base.transformPoint(Vec3.xyz(1.3, 4.3, 0.4));
        }
        if b.state == DOWN { hand = base.transformPoint(Vec3.xyz(side * 2.4, 0.5, 0.6)); }
        limb(bs, shoulder, hand, 0.8, 0.8, frost, Vec3.zero());
        box(bs, frame(hand, b.yaw), Vec3.zero(), Vec3.xyz(1.1, 1.0, 1.1), pale, Vec3.zero());
        side += 2;
    }
    if b.state == WINDUP || (b.state == THROW && b.step < (if b.phase2 { CHUNKS2 } else { CHUNKS })) {
        let grow = clamp(b.t / 0.5, 0.3, 1);
        let h = base.transformPoint(Vec3.xyz(1.3, 5.1, 0.4));
        bit(bs, Mat4.translate(h.x, h.y, h.z).mul(Mat4.rotate(Vec3.xyz(1, 1, 0).normalize(), b.anim * 4)), Vec3.zero(),
            Vec3.xyz(1.2, 1.2, 1.2) * grow, shard, Vec3.xyz(0.3, 0.6, 1.1));
    }
}
