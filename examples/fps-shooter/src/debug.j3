// Reads tools/debug.j3s. Each `const name: string = "value";` is a flag.
// Missing file or missing key means off, and the J3_FPS_* environment variables still apply.

module fps_shooter.debug;

use j3.io.readFile;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.{ Text, find };

pub struct Flags {
    area: string;
    boss: string;
    bosses: string;
    skill: string;
    skillAuto: string;
    gun: string;
    guns: string;
    /// One special enemy to drop in 3 seconds after the start: shield, flag or meteor.
    spawn: string;
    /// Stars (1-3) of one elite charger to drop in 3 seconds after the start; 0 for none.
    spawnElite: int;
    /// Modifier (1-4) for that elite, or for a plain charger when spawn_elite is 0.
    spawnMod: int;
    /// Shrine perks switched on at the start: air, drone, jetpack, turret.
    perks: string;
    watch: string;
    bench: string;
    /// Every biome open from the start.
    unlock: bool;
    /// Start in the game instead of on the main menu.
    skipMenu: bool;
    endless: bool;
    /// Starting difficulty, 0 easy to 4 death.
    difficulty: int;
    /// Challenge run from the start: 1 melee only, 2 glass cannon, 3 the horde, 4 boss rush; 0 for none.
    challenge: int;
    /// Starting level. 1 is a normal run; higher earns the keys that level would.
    level: int;
    /// World shuffle seed; 0 is a fresh one each launch.
    seed: int;
    /// Keep the map the way tools/arena.j3s drew it.
    fixedMap: bool;
    /// Which hub: 0 is a coin flip per seed, 1 the classic one, 2 the Spires.
    hub: int;
    /// A biome id to put straight behind the spawn (the slot south of the Hub), or -1 for the dealt map.
    biome: int;
}

pub fn none(): Flags {
    return Flags { area: "", boss: "", bosses: "", skill: "", skillAuto: "", gun: "", guns: "", spawn: "", spawnElite: 0, spawnMod: 0, perks: "", watch: "", bench: "", unlock: false, skipMenu: false, endless: false, difficulty: 1, challenge: 0, level: 1, seed: 0, fixedMap: false, hub: 0, biome: -1 };
}

fn copy(mem: &Arena, s: string, from: int, to: int): string {
    let n = to - from;
    if n <= 0 { return ""; }
    let buf = mem.alloc::<u8>(n);
    let i = 0;
    while i < n {
        buf[i] = s[from + i];
        i += 1;
    }
    return buf as string;
}

/// The quoted value of `const key: string = "..."`, or empty.
fn grab(mem: &Arena, text: string, key: string): string {
    let t = Text.new(mem);
    t.pushStr("const ");
    t.pushStr(key);
    t.pushStr(": string = \"");
    let needle = t.str();
    let at = find(text, needle);
    if at < 0 { return ""; }
    let i = at + needle.len;
    let start = i;
    while i < text.len && text[i] != 34 { i += 1; }
    return copy(mem, text, start, i);
}

/// `const key: int = 12`, or 0 when the key is missing.
fn grabInt(mem: &Arena, text: string, key: string): int {
    let t = Text.new(mem);
    t.pushStr("const ");
    t.pushStr(key);
    t.pushStr(": int = ");
    let needle = t.str();
    let at = find(text, needle);
    if at < 0 { return 0; }
    let i = at + needle.len;
    while i < text.len && text[i] == 32 { i += 1; }
    let n = 0;
    let any = false;
    while i < text.len && text[i] >= 48 && text[i] <= 57 {
        n = n * 10 + int(text[i]) - 48;
        any = true;
        i += 1;
    }
    if !any { return 0; }
    return n;
}

/// `const key: bool = true`, or false when the key is missing.
fn grabBool(mem: &Arena, text: string, key: string): bool {
    let t = Text.new(mem);
    t.pushStr("const ");
    t.pushStr(key);
    t.pushStr(": bool = ");
    let needle = t.str();
    let at = find(text, needle);
    if at < 0 { return false; }
    let i = at + needle.len;
    while i < text.len && text[i] == 32 { i += 1; }
    return i < text.len && text[i] == 116;
}

pub fn load(mem: &Arena): Flags {
    let text = "";
    match readFile("tools/debug.j3s", mem) {
        Result.Ok(bytes) { text = bytes as string; }
        Result.Err(_) { return none(); }
    }
    return Flags {
        area: grab(mem, text, "area"),
        boss: grab(mem, text, "boss"),
        bosses: grab(mem, text, "bosses"),
        skill: grab(mem, text, "skill"),
        skillAuto: grab(mem, text, "skill_auto"),
        gun: grab(mem, text, "gun"),
        guns: grab(mem, text, "guns"),
        spawn: grab(mem, text, "spawn"),
        spawnElite: grabInt(mem, text, "spawn_elite"),
        spawnMod: grabInt(mem, text, "spawn_mod"),
        perks: grab(mem, text, "perks"),
        watch: grab(mem, text, "watch"),
        bench: grab(mem, text, "bench"),
        unlock: grabBool(mem, text, "unlock"),
        skipMenu: grabBool(mem, text, "skip_menu"),
        endless: grabBool(mem, text, "endless"),
        difficulty: grabInt(mem, text, "difficulty"),
        challenge: grabInt(mem, text, "challenge"),
        level: grabInt(mem, text, "level"),
        seed: grabInt(mem, text, "seed"),
        fixedMap: grabBool(mem, text, "fixed_map"),
        hub: grabInt(mem, text, "hub"),
        biome: if grabBool(mem, text, "biome_on") { grabInt(mem, text, "biome") } else { -1 },
    };
}

pub struct Piece {
    name: string;
    next: int;
}

/// The next comma-separated name in `s` at `from`. Spaces around it are dropped.
pub fn piece(mem: &Arena, s: string, from: int): Piece {
    while from < s.len && (s[from] == 32 || s[from] == 44) { from += 1; }
    if from >= s.len { return Piece { name: "", next: s.len }; }
    let start = from;
    while from < s.len && s[from] != 44 { from += 1; }
    let end = from;
    while end > start && s[end - 1] == 32 { end -= 1; }
    return Piece { name: copy(mem, s, start, end), next: from };
}

/// File value when it is set, otherwise the environment value.
pub fn pick(file: string, env: string): string {
    if file.len > 0 { return file; }
    return env;
}
