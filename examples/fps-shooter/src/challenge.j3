// Challenge runs: a rule set picked on the victory screen (or by the `challenge` debug flag) that
// bends a whole run. Global module state, like the difficulty, since every system peeks at it.

module fps_shooter.challenge;

pub const NONE: int = 0;
pub const MELEE: int = 1;
pub const GLASS: int = 2;
pub const HORDE: int = 3;
pub const RUSH: int = 4;
pub const MODES: int = 4;

#[singleton]
let picked: int;

pub fn mode(): int { return picked; }
pub fn set(m: int) { picked = m; }
pub fn on(m: int): bool { return picked == m; }

pub fn name(m: int): string {
    if m == MELEE { return "MELEE ONLY"; }
    if m == GLASS { return "GLASS CANNON"; }
    if m == HORDE { return "THE HORDE"; }
    if m == RUSH { return "BOSS RUSH"; }
    return "";
}

pub fn blurb(m: int): string {
    if m == MELEE { return "katana and lance, melee weapons only"; }
    if m == GLASS { return "10 hp, no health cards, x3 damage"; }
    if m == HORDE { return "x2 enemies, most right on top of you"; }
    if m == RUSH { return "a boss from each biome of the run"; }
    return "";
}
