// The UI palette: steel grays with a light aqua accent. Flat fills, no borders.
// Each call sets the draw color; the ones that take `a` are for translucent fills.

module fps_shooter.pal;

use j3.game;

/// Deepest steel: screen washes.
pub fn deep(a: u8) { game.setColor(game.rgba(12, 16, 20, a)); }

/// Card fill.
pub fn card(a: u8) { game.setColor(game.rgba(30, 36, 43, a)); }

/// A step lighter than a card: bar troughs, idle buttons, unlit pips.
pub fn raised() { game.setColor(game.rgb(52, 60, 70)); }

/// Hovered button.
pub fn hot() { game.setColor(game.rgb(76, 88, 101)); }

/// Main text.
pub fn text() { game.setColor(game.rgb(222, 229, 236)); }

/// Secondary text.
pub fn mute() { game.setColor(game.rgb(146, 158, 170)); }

/// Hints and disabled text.
pub fn faint() { game.setColor(game.rgb(102, 113, 125)); }

/// Light aqua accent.
pub fn aqua() { game.setColor(game.rgb(126, 232, 226)); }

pub fn aquaA(a: u8) { game.setColor(game.rgba(126, 232, 226, a)); }

/// Text on top of an aqua fill.
pub fn onAqua() { game.setColor(game.rgb(14, 30, 34)); }
