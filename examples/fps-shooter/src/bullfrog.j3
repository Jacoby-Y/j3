// Bullfrog: the swamp's king. It crouches and leaps at you onto a marked ring (the landing hits
// and shoves), and after a couple of leaps it stops and croaks, its throat swelling: that is the
// weak spot, and it spits slow bubbles while it does. Get too close and it headbutts. Phase two
// leaps more often, croaks faster, and every landing sends out a wave.

module fps_shooter.bullfrog;

use j3.math.{ Mat4, Vec3, abs, clamp, cos, max, min, sin, sqrt };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, BUBBLE, addPart, box, bit, blastPlayer, bulk, clearParts, flat, flatDist, forward, frame,
    groundTop, lobRock, mark, puff, smoke, turn, wave, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const FALL: int = 0;
const CROUCH: int = 1;
const LEAP: int = 2;
const LAND: int = 3;
const CROAK: int = 4;
const WIND: int = 5;
const IDLE: int = 6;

const CROUCH_T: f32 = 0.55;
const CROUCH_T2: f32 = 0.4;
const LEAP_T: f32 = 1.1;
const LEAP_H: f32 = 9;
const LEAP_REACH: f32 = 34;
const IMPACT_R: f32 = 5.5;
const IMPACT_DMG: f32 = 30;
const LAND_T: f32 = 0.8;
const LAND_T2: f32 = 0.45;
const FALL_T: f32 = 2.0;
/// Leaps between croaks.
const LEAPS: int = 2;
const CROAK_T: f32 = 3.8;
const CROAK_T2: f32 = 3.2;
/// Headbutt: it triggers this close, winds up, then strikes a point this far ahead.
const BUTT_NEAR: f32 = 9;
const BUTT_WIND: f32 = 0.6;
const BUTT_AHEAD: f32 = 4;
const BUTT_R: f32 = 4.6;
const BUTT_DMG: f32 = 34;
const BUTT_CD: f32 = 3.5;
const LEASH: f32 = 40;
/// The throat takes this many times the damage while it is swollen.
const THROAT: f32 = 3.5;

fn bog(): Vec3 { return Vec3.xyz(0.5, 2.2, 0.5); }
fn to(b: &Boss, state: int, len: f32) { b.state = state; b.t = 0; b.len = len; }

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.state = FALL;
    b.t = 0;
    b.aim = b.pos;
    b.from = b.pos + Vec3.xyz(0, 45, 0);
    b.len = FALL_T;
    b.pos = b.from;
    b.intro = FALL_T;
    b.step = 0;
    b.cd2 = 0;
    mark(bs, b.aim, IMPACT_R, FALL_T, bog());
}

/// Where a leap toward the player lands: at most LEAP_REACH away, inside the leash, on the ground there.
fn target(b: &Boss, p: &Player, lvl: &Level, lead: f32): Vec3 {
    let want = flat(p.pos + p.vel * lead);
    let off = want - flat(b.pos);
    if off.length() > LEAP_REACH { want = flat(b.pos) + off.normalize() * LEAP_REACH; }
    let fromHome = want - flat(b.home);
    if fromHome.length() > LEASH { want = flat(b.home) + fromHome.normalize() * LEASH; }
    let y = groundTop(lvl, want.x, want.z, 1.6, 80);
    if y < -50 { y = b.home.y; }
    return Vec3.xyz(want.x, y, want.z);
}

fn slam(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    sfx.at(sfx.SLAM, b.pos);
    blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), IMPACT_R, IMPACT_DMG, 14);
    if b.phase2 { wave(bs, b.pos, 15, 22, 0.8, 16, bog()); }
    bs.shake = max(bs.shake, 0.05 * clamp(1 - flatDist(p.pos, b.pos) / 40, 0.2, 1));
    let k = 0;
    while k < 14 {
        let a = f32(k) * 0.4488;
        puff(bs, b.pos + Vec3.xyz(cos(a) * 2.5, 0.3, sin(a) * 2.5), Vec3.xyz(cos(a) * 8, 2, sin(a) * 8), 0.8, 0.7, 1.4, 0,
            Vec3.xyz(0.4, 0.5, 0.3), Vec3.zero());
        k += 1;
    }
    b.squash = 0.6;
}

fn mouthAt(b: &Boss): Vec3 {
    return frame(b.pos, b.yaw).transformPoint(Vec3.xyz(0, 2.6, -4.4));
}

/// Three bubbles at the player, one on them and one to each side.
fn spit(bs: &Bosses, p: &Player, lvl: &Level) {
    let b = &bs.b;
    let from = mouthAt(b);
    let aim = p.pos + flat(p.vel) * 0.5;
    let dir = flat(aim - from).normalize();
    let side = Vec3.xyz(0 - dir.z, 0, dir.x);
    lobRock(bs, lvl, BUBBLE, from, aim, 12, bog() * 0.4);
    lobRock(bs, lvl, BUBBLE, from, aim - side * 5, 12, bog() * 0.4);
    lobRock(bs, lvl, BUBBLE, from, aim + side * 5, 12, bog() * 0.4);
    sfx.at(sfx.BOW, from);
    puff(bs, from, dir * 4 + Vec3.xyz(0, 1, 0), 0.5, 0.4, 0.8, 0, Vec3.xyz(0.6, 0.95, 0.5), bog() * 0.2);
}

/// Where the headbutt lands.
fn buttAt(b: &Boss): Vec3 {
    return b.pos + forward(b.yaw) * BUTT_AHEAD;
}

/// What it does after a landing or a pause: butt what's close, croak after enough leaps, else leap on.
fn decide(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    if !b.engaged { to(b, IDLE, 1); return; }
    if b.cd2 <= 0 && flatDist(p.pos, b.pos) < BUTT_NEAR && abs(p.pos.y - b.pos.y) < 5 {
        to(b, WIND, BUTT_WIND);
        mark(bs, buttAt(b), BUTT_R, BUTT_WIND, bog());
        sfx.at(sfx.WARN, b.pos);
        return;
    }
    if b.step >= LEAPS {
        b.step = 0;
        to(b, CROAK, if b.phase2 { CROAK_T2 } else { CROAK_T });
        b.cd = 0.5;
        sfx.at(sfx.ROAR, b.pos);
        return;
    }
    to(b, CROUCH, if b.phase2 { CROUCH_T2 } else { CROUCH_T });
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    b.anim += dt;
    b.squash = b.squash + (1 - b.squash) * min(dt * 7, 1);
    b.open = b.open + (b.openTo - b.open) * min(dt * 6, 1);
    b.cd2 = max(b.cd2 - dt, 0);
    b.cue = false;
    let k = clamp(b.t / b.len, 0, 1);
    if b.state == FALL {
        b.pos = b.from + (b.aim - b.from) * (k * k);
        if k >= 1 {
            b.pos = b.aim;
            slam(bs, p);
            to(b, LAND, LAND_T);
            sfx.at(sfx.ROAR, b.pos);
        }
    } else if b.state == LEAP {
        b.pos = b.from + (b.aim - b.from) * k + Vec3.xyz(0, LEAP_H * 4 * k * (1 - k), 0);
        b.yaw = turn(b.yaw, yawTo(b.from, b.aim), dt * 6);
        if k >= 1 {
            b.pos = b.aim;
            slam(bs, p);
            b.step += 1;
            to(b, LAND, if b.phase2 { LAND_T2 } else { LAND_T });
        }
    } else if b.state == LAND {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 3);
        if b.t >= b.len { decide(bs, p); }
    } else if b.state == CROUCH {
        b.squash = min(b.squash, 1 - 0.3 * k);
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 4);
        if b.t >= b.len {
            if b.cd2 <= 0 && flatDist(p.pos, b.pos) < BUTT_NEAR { decide(bs, p); }
            else {
                let aim = target(b, p, lvl, 0.35);
                b.from = b.pos;
                b.aim = aim;
                to(b, LEAP, LEAP_T);
                b.squash = 1.35;
                mark(bs, aim, IMPACT_R, LEAP_T, bog());
                sfx.at(sfx.JUMP, b.pos);
            }
        }
    } else if b.state == CROAK {
        b.openTo = if b.t < b.len - 0.5 { 1 } else { 0 };
        if b.open > 0.55 { b.cue = true; }
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 1.2);
        b.cd -= dt;
        if b.cd <= 0 && b.t < b.len - 0.5 {
            spit(bs, p, lvl);
            b.cd = if b.phase2 { 0.6 } else { 0.9 };
        }
        if b.t >= b.len {
            b.openTo = 0;
            to(b, LAND, LAND_T);
        }
    } else if b.state == WIND {
        // Rears back, then the head snaps forward onto the marked spot.
        b.squash = min(b.squash, 1 - 0.2 * k);
        b.lean = 0 - 0.35 * k;
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2.5);
        if b.t >= b.len {
            let at = buttAt(b);
            b.lean = 0.5;
            blastPlayer(bs, p, at + Vec3.xyz(0, 0.5, 0), BUTT_R, BUTT_DMG, 18);
            smoke(bs, at, 8, 3, Vec3.xyz(0.4, 0.5, 0.3), Vec3.zero());
            bs.shake = max(bs.shake, 0.06);
            sfx.at(sfx.SLAM, at);
            b.cd2 = BUTT_CD;
            to(b, LAND, 0.9);
        }
    } else {
        b.yaw = b.yaw + dt * 0.2;
        if b.engaged { to(b, CROUCH, CROUCH_T); }
        else if b.t >= b.len { b.t = 0; }
    }
    b.lean = b.lean * max(1 - dt * 6, 0);
    pose(bs);
    bs.glowAt = b.pos + Vec3.xyz(0, 2, 0) + forward(b.yaw) * -3;
    bs.glowColor = bog() * (0.05 + b.open * 0.12);
    bs.glowR = 6 + b.open * 4;
}

fn root(b: &Boss): Mat4 {
    let sq = b.squash;
    let w = 1 / sqrt(sq);
    return frame(b.pos, b.yaw).mul(Mat4.scale(w, sq, w));
}

/// Body frame, leaning forward or back at the shoulders.
fn front(b: &Boss): Mat4 {
    return root(b).mul(Mat4.translate(0, 2, 0)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), b.lean)).mul(Mat4.translate(0, -2, 0));
}

/// The throat sac's middle, swelling with the croak.
fn throatAt(b: &Boss): Vec3 {
    return front(b).transformPoint(Vec3.xyz(0, 1.5, -3.7));
}

fn pose(bs: &Bosses) {
    let b = &bs.b;
    clearParts(bs);
    let t = front(b);
    // The throat first, so a shot into it counts where it overlaps the head.
    addPart(bs, throatAt(b), 0.9 + b.open * 0.7, if b.open > 0.55 { THROAT } else { 1 }, WEAK);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 3.0, -2.8)), 1.9, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 2.4, 0.6)), 2.7, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(-3, 1.6, 1.9)), 1.5, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(3, 1.6, 1.9)), 1.5, 1, BODY);
    bulk(bs, 3.2, b.pos.y, b.pos.y + 4.5 * b.squash);
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let skin = Vec3.xyz(0.25, 0.5, 0.2);
    let skin2 = Vec3.xyz(0.32, 0.62, 0.24);
    let belly = Vec3.xyz(0.88, 0.86, 0.55);
    let dark = Vec3.xyz(0.16, 0.34, 0.15);
    let black = Vec3.xyz(0.04, 0.04, 0.03);
    let eye = Vec3.xyz(1, 0.85, 0.2);
    let o = b.open;
    let base = root(b);
    let t = front(b);
    let air: f32 = 0;
    if b.state == LEAP || b.state == FALL { air = sin(clamp(b.t / b.len, 0, 1) * 3.1416); }
    // Body, back warts, head.
    box(bs, t, Vec3.xyz(0, 2.4, 0.6), Vec3.xyz(5.0, 3.2, 6.0), skin, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 1.5, 0.3), Vec3.xyz(4.4, 1.2, 5.4), belly, Vec3.zero());
    bit(bs, t, Vec3.xyz(-1.2, 4.05, 1.4), Vec3.xyz(1.0, 0.3, 1.0), dark, Vec3.zero());
    bit(bs, t, Vec3.xyz(1.3, 4.05, 0.3), Vec3.xyz(1.2, 0.3, 0.8), dark, Vec3.zero());
    bit(bs, t, Vec3.xyz(0.2, 4.05, 2.4), Vec3.xyz(0.9, 0.3, 1.3), dark, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 2.9, -2.7), Vec3.xyz(4.2, 1.9, 3.2), skin2, Vec3.zero());
    // The mouth: a dark line, a lower jaw that drops as the throat swells.
    box(bs, t, Vec3.xyz(0, 1.85 - o * 0.35, -2.6), Vec3.xyz(4.0, 0.5, 3.0), skin2, Vec3.zero());
    bit(bs, t, Vec3.xyz(0, 2.2 - o * 0.15, -4.32), Vec3.xyz(3.7, 0.16 + o * 0.5, 0.1), black, bog() * o * 0.3);
    // The throat sac.
    let sac = 1.4 + o * 1.2;
    box(bs, t, Vec3.xyz(0, 1.35 - o * 0.3, -3.5), Vec3.xyz(sac * 1.2, sac * 0.9, sac * 1.2), belly, Vec3.xyz(0.9, 2.0, 0.6) * (0.15 + o * 1.0));
    // Big bulging eyes with slit pupils.
    let side: f32 = -1;
    while side < 2 {
        box(bs, t, Vec3.xyz(side * 1.5, 4.25, -2.3), Vec3.xyz(1.3, 1.3, 1.3), skin2, Vec3.zero());
        bit(bs, t, Vec3.xyz(side * 1.5, 4.3, -2.95), Vec3.xyz(1.0, 1.0, 0.1), eye, Vec3.xyz(1.6, 1.3, 0.2));
        bit(bs, t, Vec3.xyz(side * 1.5, 4.3, -3.02), Vec3.xyz(0.2, 0.85, 0.08), black, Vec3.zero());
        // Haunches and hind feet. They stretch out behind it in the air.
        box(bs, t, Vec3.xyz(side * 3.0, 1.7, 1.9 + air * 1.5), Vec3.xyz(1.7, 2.6, 3.4), skin, Vec3.zero());
        box(bs, base, Vec3.xyz(side * 3.2, 0.2, 0.2 + air * 3.5), Vec3.xyz(1.5, 0.4, 3.2), dark, Vec3.zero());
        // Arms and front feet.
        box(bs, t, Vec3.xyz(side * 2.3, 1.3, -2.1 - air * 0.8), Vec3.xyz(1.0, 2.6, 1.0), skin, Vec3.zero());
        box(bs, base, Vec3.xyz(side * 2.3, 0.2, -2.7 - air * 1.6), Vec3.xyz(1.5, 0.4, 1.8), dark, Vec3.zero());
        side += 2;
    }
}
