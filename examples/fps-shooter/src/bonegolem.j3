// Bonegolem: a chunky skeleton golem that stalks the graveyard. It lobs volleys of flaming
// skulls, then raises its arms and calls bone pillars up out of the ground around you (warning
// rings first). Get too close and it roars, a blast and a wave. The soul core in its ribs is
// the weak spot, open while its arms are raised or it roars. Phase two is faster with bigger
// volleys.

module fps_shooter.bonegolem;

use j3.math.{ Mat4, Vec3, clamp, cos, max, min, sin };
use fps_shooter.bosskit.{ Boss, Bosses, BODY, WEAK, FLAME_SKULL, addPart, bit, blastPlayer, bonePillar, box, bulk, clearParts, flat, flatDist,
    forward, frame, groundTop, limb, lobRock, mark, puff, smoke, turn, walk, wave, yawTo };
use fps_shooter.level.Level;
use fps_shooter.player.Player;
use fps_shooter.sfx;

const FALL: int = 0;
const STALK: int = 1;
const SKULLS: int = 2;
const BONES: int = 3;
const ROAR: int = 4;
const IDLE: int = 5;

const FALL_T: f32 = 2.0;
const STALK_T: f32 = 4.5;
const STALK_T2: f32 = 3.2;
const SPEED: f32 = 5.5;
const SPEED2: f32 = 7;
const SKULLS_T: f32 = 3.2;
const BONES_T: f32 = 3.0;
const ROAR_T: f32 = 1.5;
/// Roar: it triggers this close, winds up for ROAR_WIND, then blasts this far.
const ROAR_NEAR: f32 = 7;
const ROAR_WIND: f32 = 0.7;
const ROAR_R: f32 = 9;
const ROAR_DMG: f32 = 24;
const ROAR_CD: f32 = 7;
/// Bone pillars: the warning time, their size, and the blast under each.
const BONE_WARN: f32 = 1.3;
const BONE_R: f32 = 2.2;
const BONE_DMG: f32 = 20;
const LEASH: f32 = 42;
/// The soul core takes this many times the damage while it is open.
const CORE: f32 = 3.5;

#[singleton]
let boneMarks: [10]int;

fn ember(): Vec3 { return Vec3.xyz(2.4, 1.1, 0.25); }
fn to(b: &Boss, state: int, len: f32) { b.state = state; b.t = 0; b.len = len; b.step = 0; }

pub fn begin(bs: &Bosses) {
    let b = &bs.b;
    b.state = FALL;
    b.t = 0;
    b.aim = b.pos;
    b.from = b.pos + Vec3.xyz(0, 45, 0);
    b.len = FALL_T;
    b.pos = b.from;
    b.intro = FALL_T;
    b.step = 0;
    b.cd = 0;
    b.cd2 = 2;
    b.cycle = 0;
    b.heat = 0;
    mark(bs, b.aim, 6, FALL_T, ember());
}

/// Where a raised hand is (the skulls leave from here).
fn handAt(b: &Boss, side: f32): Vec3 {
    let up = b.heat;
    let local = Vec3.xyz(side * 3.2, 3.0 + up * 5.5, -0.4 - up * 0.4);
    return frame(b.pos, b.yaw).transformPoint(local);
}

fn volley(bs: &Bosses, p: &Player, lvl: &Level) {
    let b = &bs.b;
    let from = handAt(b, 1);
    let aim = p.pos + flat(p.vel) * 0.5;
    let dir = flat(aim - from).normalize();
    let side = Vec3.xyz(0 - dir.z, 0, dir.x);
    lobRock(bs, lvl, FLAME_SKULL, from, aim, 14, ember() * 0.4);
    lobRock(bs, lvl, FLAME_SKULL, handAt(b, -1), aim + side * 5, 14, ember() * 0.4);
    if b.phase2 { lobRock(bs, lvl, FLAME_SKULL, from, aim - side * 5, 14, ember() * 0.4); }
    sfx.at(sfx.BOW, from);
    puff(bs, from, Vec3.xyz(0, 3, 0), 0.5, 0.5, 0.8, 0, Vec3.xyz(1, 0.6, 0.2), ember() * 0.3);
}

/// Warning rings for the bone pillars: one on the player, the rest around them.
fn summon(bs: &Bosses, p: &Player) {
    let b = &bs.b;
    let n = if b.phase2 { 9 } else { 6 };
    let i = 0;
    while i < 10 { boneMarks[i] = -1; i += 1; }
    i = 0;
    while i < n {
        let at = p.pos + flat(p.vel) * 0.6;
        if i > 0 {
            let a = bs.rng.unit() * 6.2831853;
            let r = 3.5 + bs.rng.unit() * 8;
            at = p.pos + Vec3.xyz(cos(a) * r, 0, sin(a) * r);
        }
        let fromHome = flat(at - b.home);
        if fromHome.length() > LEASH + 10 { at = flat(b.home) + fromHome.normalize() * (LEASH + 10); }
        boneMarks[i] = mark(bs, Vec3.xyz(at.x, p.pos.y, at.z), BONE_R, BONE_WARN, ember());
        i += 1;
    }
    sfx.at(sfx.WARN, b.pos);
}

/// The rings fill in: pillars burst up on each spot.
fn erupt(bs: &Bosses, p: &Player, lvl: &Level) {
    let i = 0;
    while i < 10 {
        let m = boneMarks[i];
        if m >= 0 {
            let at = bs.marks[m].at;
            let y = groundTop(lvl, at.x, at.z, 0.8, at.y + 2);
            if y < -50 { y = at.y; }
            let spot = Vec3.xyz(at.x, y, at.z);
            blastPlayer(bs, p, spot + Vec3.xyz(0, 0.5, 0), BONE_R, BONE_DMG, 12);
            bonePillar(bs, spot, 0.9, 5.5, 6);
            smoke(bs, spot, 4, 2, Vec3.xyz(0.5, 0.45, 0.4), Vec3.zero());
        }
        i += 1;
    }
    sfx.at(sfx.SLAM, p.pos);
    bs.shake = max(bs.shake, 0.05);
}

pub fn update(bs: &Bosses, p: &Player, lvl: &Level, dt: f32) {
    let b = &bs.b;
    b.t += dt;
    b.anim += dt;
    b.open = b.open + (b.openTo - b.open) * min(dt * 6, 1);
    b.cd2 = max(b.cd2 - dt, 0);
    b.cue = false;
    let armsUp: f32 = 0;
    if b.state == SKULLS || b.state == BONES || b.state == ROAR { armsUp = 1; }
    b.heat = b.heat + (armsUp - b.heat) * min(dt * 6, 1);
    let k = clamp(b.t / b.len, 0, 1);
    if b.state == FALL {
        b.pos = b.from + (b.aim - b.from) * (k * k);
        if k >= 1 {
            b.pos = b.aim;
            sfx.at(sfx.SLAM, b.pos);
            blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), 6, 30, 14);
            wave(bs, b.pos, 16, 26, 0.8, 16, ember());
            bs.shake = max(bs.shake, 0.06);
            to(b, ROAR, ROAR_T);
            b.step = 1;
            b.openTo = 1;
            sfx.at(sfx.ROAR, b.pos);
        }
    } else if b.state == STALK {
        b.openTo = 0;
        let dir = flat(p.pos - b.pos);
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2.2);
        let speed = if b.phase2 { SPEED2 } else { SPEED };
        let go = dir.normalize() * speed;
        let away = flat(b.pos - b.home);
        // Past the leash, it walks back toward home instead.
        if away.length() > LEASH { go = flat(b.home - b.pos).normalize() * speed; }
        if dir.length() > 6 || away.length() > LEASH { walk(bs, lvl, go, 2.2, 0.7, dt); }
        if b.engaged && b.intro <= 0 && b.cd2 <= 0 && dir.length() < ROAR_NEAR {
            to(b, ROAR, ROAR_T);
        } else if b.t >= (if b.phase2 { STALK_T2 } else { STALK_T }) {
            if !b.engaged { b.t = 0; }
            else {
                b.cycle += 1;
                if b.cycle % 2 == 1 { to(b, SKULLS, SKULLS_T); b.cd = 0.5; }
                else { to(b, BONES, BONES_T); }
            }
        }
    } else if b.state == SKULLS {
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 2.5);
        b.cd -= dt;
        if b.cd <= 0 && b.t < b.len - 0.6 {
            volley(bs, p, lvl);
            b.cd = if b.phase2 { 0.6 } else { 0.85 };
        }
        if b.t >= b.len { to(b, STALK, 1); }
    } else if b.state == BONES {
        b.openTo = 1;
        if b.open > 0.55 { b.cue = true; }
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 1.5);
        if b.step == 0 && b.t > 0.4 {
            summon(bs, p);
            b.step = 1;
            b.cd = BONE_WARN;
        }
        if b.step == 1 {
            b.cd -= dt;
            if b.cd <= 0 { erupt(bs, p, lvl); b.step = 2; }
        }
        if b.t >= b.len {
            b.openTo = 0;
            to(b, STALK, 1);
        }
    } else if b.state == ROAR {
        // Winds up (a ring where the blast will reach), then roars: blast, wave, core open.
        b.openTo = if b.step == 1 || b.t >= ROAR_WIND { 1 } else { 0 };
        if b.open > 0.55 { b.cue = true; }
        b.yaw = turn(b.yaw, yawTo(b.pos, p.pos), dt * 1.5);
        if b.step == 0 { mark(bs, b.pos, ROAR_R, ROAR_WIND, ember()); sfx.at(sfx.WARN, b.pos); b.step = 2; }
        if b.step == 2 && b.t >= ROAR_WIND {
            blastPlayer(bs, p, b.pos + Vec3.xyz(0, 0.5, 0), ROAR_R, ROAR_DMG, 22);
            wave(bs, b.pos, 16, 30, 0.8, 14, ember());
            smoke(bs, b.pos, 10, 5, Vec3.xyz(0.5, 0.45, 0.4), Vec3.zero());
            bs.shake = max(bs.shake, 0.07);
            sfx.at(sfx.ROAR, b.pos);
            b.step = 3;
        }
        if b.t >= b.len {
            b.openTo = 0;
            b.cd2 = ROAR_CD;
            to(b, STALK, 1);
        }
    } else {
        b.yaw = b.yaw + dt * 0.2;
        if b.engaged { to(b, STALK, 1); }
    }
    pose(bs);
    bs.glowAt = b.pos + Vec3.xyz(0, 4.8, 0) + forward(b.yaw) * -1.5;
    bs.glowColor = ember() * (0.05 + b.open * 0.12);
    bs.glowR = 6 + b.open * 4;
}

/// Leg swing while it walks.
fn stride(b: &Boss): f32 {
    if b.state == STALK { return sin(b.anim * 4) * 0.7; }
    return 0;
}

fn pose(bs: &Bosses) {
    let b = &bs.b;
    clearParts(bs);
    let t = frame(b.pos, b.yaw);
    // The core first, so a shot into it counts where it overlaps the ribs.
    addPart(bs, t.transformPoint(Vec3.xyz(0, 4.8, -1.1)), 1.0, if b.open > 0.55 { CORE } else { 1 }, WEAK);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 4.8, 0)), 2.6, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 7.0, -0.4)), 1.5, 1, BODY);
    addPart(bs, t.transformPoint(Vec3.xyz(0, 2.0, 0)), 1.9, 1, BODY);
    addPart(bs, handAt(b, -1), 1.0, 1, BODY);
    addPart(bs, handAt(b, 1), 1.0, 1, BODY);
    bulk(bs, 2.8, b.pos.y, b.pos.y + 7.5);
}

pub fn draw(bs: &Bosses) {
    let b = &bs.b;
    let bone = Vec3.xyz(0.9, 0.87, 0.75);
    let bone2 = Vec3.xyz(0.78, 0.75, 0.65);
    let dark = Vec3.xyz(0.2, 0.18, 0.18);
    let black = Vec3.xyz(0.04, 0.03, 0.03);
    let o = b.open;
    let t = frame(b.pos, b.yaw);
    let sw = stride(b);
    let soul = Vec3.xyz(1.8, 2.4, 0.7) * (0.35 + o * 2 + 0.15 * sin(b.anim * 5));
    // Legs and pelvis.
    box(bs, t, Vec3.xyz(-1.3, 1.6, sw), Vec3.xyz(1.4, 3.2, 1.4), bone, Vec3.zero());
    box(bs, t, Vec3.xyz(1.3, 1.6, 0.0 - sw), Vec3.xyz(1.4, 3.2, 1.4), bone, Vec3.zero());
    box(bs, t, Vec3.xyz(-1.3, 0.25, sw - 0.5), Vec3.xyz(1.7, 0.5, 2.4), bone2, Vec3.zero());
    box(bs, t, Vec3.xyz(1.3, 0.25, 0.0 - sw - 0.5), Vec3.xyz(1.7, 0.5, 2.4), bone2, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 3.6, 0), Vec3.xyz(3.6, 1.0, 2.0), bone2, Vec3.zero());
    // Spine and ribs, with the glowing core between the ribs.
    box(bs, t, Vec3.xyz(0, 4.9, 0.6), Vec3.xyz(0.9, 2.6, 0.9), bone2, Vec3.zero());
    let rib = 0;
    while rib < 4 {
        let ry = 4.0 + f32(rib) * 0.6;
        box(bs, t, Vec3.xyz(0, ry, -0.2), Vec3.xyz(4.4 - f32(rib) * 0.3, 0.35, 2.8), bone, Vec3.zero());
        rib += 1;
    }
    box(bs, t, Vec3.xyz(0, 4.8, -0.2), Vec3.xyz(3.6, 0.9, 2.4), dark, Vec3.zero());
    bit(bs, t, Vec3.xyz(0, 4.8, -1.1), Vec3.xyz(1.2, 1.2, 0.9), black, soul);
    // Shoulders and arms, raised when it summons, shoots or roars.
    let side: f32 = -1;
    while side < 2 {
        box(bs, t, Vec3.xyz(side * 2.8, 6.1, 0), Vec3.xyz(1.9, 1.2, 2.3), bone, Vec3.zero());
        let hand = handAt(b, side);
        limb(bs, t.transformPoint(Vec3.xyz(side * 2.8, 6.0, 0)), hand, 1.0, 1.0, bone2, Vec3.zero());
        box(bs, frame(hand, b.yaw), Vec3.zero(), Vec3.xyz(1.6, 1.6, 1.6), bone, if b.state == SKULLS { ember() * 0.3 } else { Vec3.zero() });
        side += 2;
    }
    // The skull: brow, glowing sockets, a jaw that drops as it roars, a small flame crown.
    box(bs, t, Vec3.xyz(0, 7.0, -0.4), Vec3.xyz(2.5, 2.0, 2.3), bone, Vec3.zero());
    box(bs, t, Vec3.xyz(0, 6.0 - o * 0.6, -0.3), Vec3.xyz(2.0, 0.7, 1.9), bone2, Vec3.zero());
    bit(bs, t, Vec3.xyz(-0.6, 7.2, -1.56), Vec3.xyz(0.6, 0.55, 0.1), black, Vec3.xyz(2.6, 1.3, 0.2));
    bit(bs, t, Vec3.xyz(0.6, 7.2, -1.56), Vec3.xyz(0.6, 0.55, 0.1), black, Vec3.xyz(2.6, 1.3, 0.2));
    bit(bs, t, Vec3.xyz(0, 6.65, -1.56), Vec3.xyz(0.3, 0.4, 0.1), black, Vec3.zero());
    bit(bs, t, Vec3.xyz(0, 6.4 - o * 0.3, -1.3), Vec3.xyz(1.8, 0.14 + o * 0.5, 0.1), black, ember() * o * 0.3);
    bit(bs, t, Vec3.xyz(0, 8.3, -0.3), Vec3.xyz(0.7, 0.9 + 0.2 * sin(b.anim * 9), 0.7), Vec3.xyz(1, 0.55, 0.15), ember());
}
