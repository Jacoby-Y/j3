// The map is a 3 by 3 grid of biomes (see tools/arena.j3s). Walking into one eases the sky, sun
// and fog toward its look and puts its name up.

module fps_shooter.biome;

use j3.game;
use j3.game.Font;
use j3.math.{ Vec2, Vec3, clamp, min };
use fps_shooter.level;
use fps_shooter.player.Player;

const EASE: f32 = 1.5;
const TITLE: f32 = 2.5;

pub struct Biomes {
    /// Slot (row * 3 + column, row 0 north, column 0 west), -1 before the first update.
    cur: int;
    /// The look right now, easing toward the tile's.
    sky: Vec3;
    sun: Vec3;
    fogStart: f32;
    fogEnd: f32;
    titleT: f32;
    /// The eye is under water: close blue fog and a tinted screen.
    under: bool;
}

pub fn create(): Biomes {
    return Biomes { cur: -1, sky: sky(4), sun: sun(4), fogStart: fogStart(4), fogEnd: fogEnd(4), titleT: 0, under: false };
}

/// The name of the biome on slot `i`.
pub fn name(slot: int): string {
    let i = level.biomeAt(slot);
    if i == 9 { return "CRYSTAL HOLLOWS"; }
    if i == 0 { return "FROSTPEAK"; }
    if i == 1 { return "THE HIGHLANDS"; }
    if i == 2 { return "THE VOLCANO"; }
    if i == 3 { return "THE CANYON"; }
    if i == 5 { return "TOY CITY"; }
    if i == 6 { return "THE RUINS"; }
    if i == 7 { return "THE FOREST"; }
    if i == 8 { return "SKY ISLES"; }
    if i == 10 { return "THE SPIRES"; }
    if i == 11 { return "THE BEACH"; }
    if i == 12 { return "THE SWAMP"; }
    if i == 13 { return "THE GRAVEYARD"; }
    if i == 14 { return "THE FARM"; }
    return "THE HUB";
}

/// The sky (and fog, and ambient light) for biome `i`, never brighter than the Hub's.
fn sky(i: int): Vec3 {
    let c = rawSky(i);
    let cap = glare(rawSky(4));
    let g = glare(c);
    if g > cap { c = c * (cap / g); }
    return c;
}

fn rawSky(i: int): Vec3 {
    if i == 9 { return Vec3.xyz(0.48, 0.57, 0.64); }
    if i == 0 { return Vec3.xyz(0.78, 0.88, 1); }
    if i == 1 { return Vec3.xyz(0.55, 0.78, 1); }
    if i == 2 { return Vec3.xyz(0.85, 0.45, 0.32); }
    if i == 3 { return Vec3.xyz(0.95, 0.78, 0.55); }
    if i == 5 { return Vec3.xyz(0.75, 0.65, 1); }
    if i == 6 { return Vec3.xyz(0.7, 0.86, 0.8); }
    if i == 7 { return Vec3.xyz(0.55, 0.8, 0.62); }
    if i == 8 { return Vec3.xyz(0.38, 0.48, 0.95); }
    if i == 11 { return Vec3.xyz(0.5, 0.82, 1); }
    if i == 12 { return Vec3.xyz(0.5, 0.6, 0.42); }
    if i == 13 { return Vec3.xyz(0.3, 0.28, 0.42); }
    if i == 14 { return Vec3.xyz(0.62, 0.82, 1); }
    return Vec3.xyz(0.55, 0.75, 1);
}

/// How bright a sun colour is (weighted like the eye).
fn glare(c: Vec3): f32 { return c.x * 0.2126 + c.y * 0.7152 + c.z * 0.0722; }

/// The sun for biome `i`, never brighter than the Hub's: a hotter one washes out the textures.
fn sun(i: int): Vec3 {
    let c = rawSun(i);
    let cap = glare(rawSun(4));
    let g = glare(c);
    if g > cap { c = c * (cap / g); }
    return c;
}

fn rawSun(i: int): Vec3 {
    if i == 9 { return Vec3.xyz(0.65, 0.76, 0.85); }
    if i == 0 { return Vec3.xyz(1.1, 1.1, 1.18); }
    if i == 2 { return Vec3.xyz(1.3, 0.8, 0.55); }
    if i == 3 { return Vec3.xyz(1.3, 1.05, 0.8); }
    if i == 5 { return Vec3.xyz(1.15, 1, 1.12); }
    if i == 7 { return Vec3.xyz(1.05, 1.1, 0.85); }
    if i == 8 { return Vec3.xyz(1.1, 1, 1.25); }
    if i == 11 { return Vec3.xyz(1.25, 1.12, 0.9); }
    if i == 12 { return Vec3.xyz(0.95, 1.05, 0.78); }
    if i == 13 { return Vec3.xyz(0.72, 0.78, 1.05); }
    if i == 14 { return Vec3.xyz(1.3, 1.15, 0.85); }
    return Vec3.xyz(1.2, 1.05, 0.92);
}

fn fogStart(i: int): f32 {
    if i == 9 { return 85; }
    if i == 0 || i == 7 { return 45; }
    if i == 2 { return 35; }
    if i == 8 { return 80; }
    if i == 11 { return 90; }
    if i == 12 { return 22; }
    if i == 13 { return 18; }
    if i == 14 { return 55; }
    return 65;
}

fn fogEnd(i: int): f32 {
    if i == 9 { return 310; }
    if i == 0 || i == 7 { return 240; }
    if i == 2 { return 210; }
    if i == 8 { return 260; }
    if i == 11 { return 300; }
    if i == 12 { return 170; }
    if i == 13 { return 150; }
    if i == 14 { return 260; }
    return 230;
}

/// The tile under x/z.
pub fn at(x: f32, z: f32): int {
    return level.tileAt(x, z);
}

pub fn update(b: &Biomes, p: &Player, dt: f32) {
    let i = at(p.pos.x, p.pos.z);
    if level.inHollows(p.pos) { i = 9; }
    if i != b.cur {
        b.cur = i;
        b.titleT = TITLE;
    }
    b.titleT = b.titleT - dt;
    i = level.biomeAt(i);
    b.under = p.wet > p.eyeH;
    if b.under {
        b.sky = Vec3.xyz(0.2, 0.6, 0.75);
        b.sun = Vec3.xyz(0.9, 1.1, 1.2);
        b.fogStart = 4;
        b.fogEnd = 60;
        return;
    }
    let k = min(dt * EASE, 1);
    b.sky = b.sky + (sky(i) - b.sky) * k;
    b.sun = b.sun + (sun(i) - b.sun) * k;
    b.fogStart = b.fogStart + (fogStart(i) - b.fogStart) * k;
    b.fogEnd = b.fogEnd + (fogEnd(i) - b.fogEnd) * k;
}

/// Under water: a light blue wash.
pub fn overlay(b: &Biomes) {
    if !b.under { return; }
    game.setColor(game.rgba(60, 170, 210, 55));
    game.drawRect(Vec2 { x: 0, y: 0 }, game.windowSize());
}

/// "ENTERING" and the biome's name, top middle, fading out.
pub fn hud(b: &Biomes, font: Font, big: Font) {
    if b.titleT <= 0 || b.cur < 0 { return; }
    let a = u8(clamp(b.titleT / 0.6, 0, 1) * clamp((TITLE - b.titleT) / 0.3, 0, 1) * 255);
    let sz = game.windowSize();
    let small = "ENTERING";
    let st = game.textSize(font, small);
    let nt = game.textSize(big, name(b.cur));
    game.setColor(game.rgba(20, 24, 40, u8(f32(a) * 0.6)));
    game.drawText(big, Vec2 { x: (sz.x - nt.x) * 0.5 + 2, y: 92 }, name(b.cur));
    game.setColor(game.rgba(235, 240, 255, a));
    game.drawText(font, Vec2 { x: (sz.x - st.x) * 0.5, y: 68 }, small);
    game.drawText(big, Vec2 { x: (sz.x - nt.x) * 0.5, y: 90 }, name(b.cur));
}
