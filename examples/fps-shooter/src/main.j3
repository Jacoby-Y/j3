// Arcade FPS: run, double jump, slide, dash, and rocket-jump around a toy
// arena while enemies keep coming at you; their XP gems level you up for cards. The level is scenes/main.j3scene; its camera is
// the spawn point.

module fps_shooter;

use j3.app.App;
use j3.game;
use j3.game.{ Font, Key };
use j3.gfx;
use j3.math.{ Vec3, max };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.Scene;
use fps_shooter.biome;
use fps_shooter.debug;
use fps_shooter.debug.Flags;
use fps_shooter.biome.Biomes;
use fps_shooter.boss;
use fps_shooter.bosskit.Bosses;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.gates;
use fps_shooter.gates.Gates;
use fps_shooter.gear;
use fps_shooter.gear.Gear;
use fps_shooter.guns;
use fps_shooter.guns.Guns;
use fps_shooter.hud;
use fps_shooter.level;
use fps_shooter.level.Level;
use fps_shooter.minimap;
use fps_shooter.perks;
use fps_shooter.perf;
use fps_shooter.perf.Perf;
use fps_shooter.perks.Perks;
use fps_shooter.player;
use fps_shooter.player.Player;
use fps_shooter.score;
use fps_shooter.score.Score;
use fps_shooter.sfx;
use fps_shooter.shrine;
use fps_shooter.shrine.Shrines;
use fps_shooter.skills;
use fps_shooter.skills.Skills;

/// Points for felling a boss, times the combo.
const BOSS_PTS: f32 = 2500;

struct World {
    mem: &Arena;
    flags: Flags;
    perf: Perf;
    scene: Scene;
    level: Level;
    player: Player;
    guns: Guns;
    enemies: Enemies;
    perks: Perks;
    score: Score;
    shrines: Shrines;
    gear: Gear;
    gates: Gates;
    biomes: Biomes;
    bosses: Bosses;
    skills: Skills;
    /// M: the whole map up, game paused.
    mapOpen: bool;
    font: Font;
    big: Font;
}

fn boot(mem: &Arena): World {
    let flags = debug.load(mem);
    let scene = scene3d.load("scenes/main.j3scene", mem);
    let lvl = level.build(&scene, mem);
    return World { mem: mem, flags: flags, perf: perf.create(mem, flags.bench), scene: scene, level: lvl, player: player.create(&lvl), guns: guns.create(mem),
        enemies: enemies.create(mem), perks: perks.create(mem), score: score.create(mem),
        shrines: shrine.create(mem), gear: gear.create(), gates: gates.create(), biomes: biome.create(), bosses: boss.create(mem), skills: skills.create(mem), mapOpen: false, font: Font { raw: 0 }, big: Font { raw: 0 } };
}

fn startup(w: &World) {
    gfx.init();
    scene3d.upload(&w.scene);
    player.selfCheck(w.mem);
    perks.selfCheck(w.mem);
    // Boxes need the meshes' bounds, which upload fills in.
    w.level = level.build(&w.scene, w.mem);
    w.player = player.create(&w.level);
    guns.upload(&w.guns, w.mem);
    enemies.upload(&w.enemies, w.mem);
    gear.upload(&w.gear, w.mem);
    gates.upload(&w.gates, w.mem);
    boss.upload(&w.bosses, w.mem);
    skills.upload(&w.skills, w.mem);
    shrine.load(&w.shrines, &w.scene, &w.level, w.mem);
    w.font = game.loadFont("assets/font.ttf", 16);
    w.big = game.loadFont("assets/font.ttf", 44);
    score.load(&w.score);
    enemies.selfCheck(w.mem, &w.scene);
    guns.selfCheck(w.mem, &w.scene);
    boss.selfCheck(w.mem);
    skills.selfCheck(w.mem);
    // After the checks, which build their own generators. A launch gets its own card and shrine deal.
    perks.reseed(&w.perks);
    shrine.reseed(&w.shrines);
    let held = w.flags.guns;
    if held.len == 0 { held = w.flags.gun; }
    guns.preview(&w.guns, &w.player, w.mem, held);
    boss.preview(&w.bosses, &w.player, &w.level, &w.enemies, w.mem, w.flags.bosses, w.flags.boss, w.flags.watch);
    skills.preview(&w.skills, &w.player, w.flags.skill, w.flags.skillAuto);
    sfx.load();
    game.captureMouse(true);
    perf.start(&w.perf, &w.enemies, &w.player, &w.level);
}

fn update(w: &World, dt: f32) {
    if w.perf.mode > 0 {
        perf.capture(&w.perf, &w.enemies);
        enemies.beginUpdate(&w.enemies, &w.player, 0.01);
        perf.update(&w.perf, &w.enemies, &w.player, &w.level);
        biome.update(&w.biomes, &w.player, 0.01);
        enemies.update(&w.enemies, &w.player, &w.level, &w.scene, 0.01);
        if w.perf.mode > 1 { boss.benchmark(&w.bosses, &w.player, &w.level, &w.enemies, 0.01); }
        return;
    }
    if !game.mouseCaptured() { guns.cancelDraw(&w.guns); }
    // A boss's skill, a shrine gift or a level-up hand up: frozen until it's picked.
    if w.skills.offering {
        if skills.choose(&w.skills, &w.player, dt) { game.captureMouse(true); }
        return;
    }
    if w.shrines.offering {
        if shrine.choose(&w.shrines, &w.player, dt) { game.captureMouse(true); }
        return;
    }
    if w.perks.offering {
        // Several level ups at once: one hand after another.
        if perks.update(&w.perks, &w.player, dt) {
            if w.perks.pending > 0 { perks.offer(&w.perks, &w.player); } else { game.captureMouse(true); }
        }
        return;
    }
    // Escape pauses (the mouse comes free for the menu) and resumes. Paused, nothing moves.
    if game.keyPressed(Key.Escape) { game.captureMouse(!game.mouseCaptured()); }
    if !game.mouseCaptured() { guns.cancelDraw(&w.guns); return; }
    if game.keyPressed(Key.M) { w.mapOpen = !w.mapOpen; }
    if w.mapOpen { guns.cancelDraw(&w.guns); return; }
    let ear = player.look(&w.player);
    sfx.listen(ear.eye, ear.forward(), ear.right());
    let step = dt;
    if step > 0.05 { step = 0.05; }
    enemies.beginUpdate(&w.enemies, &w.player, step);
    player.update(&w.player, &w.level, step);
    biome.update(&w.biomes, &w.player, step);
    gates.update(&w.gates, &w.level, &w.shrines, w.perks.level, step);
    guns.update(&w.guns, &w.player, &w.level, &w.scene, &w.enemies, &w.shrines, &w.bosses, step);
    gear.update(&w.gear, &w.player, &w.level, &w.scene, &w.enemies, &w.bosses, step);
    skills.update(&w.skills, &w.player, &w.level, &w.enemies, &w.bosses, &w.shrines, &w.guns, step);
    if shrine.update(&w.shrines, &w.player, &w.enemies, &w.level, w.perks.level, step) {
        // Every gift owned or rejected: a normal card instead.
        if w.shrines.epic {
            w.shrines.epic = false;
            perks.offerEpic(&w.perks);
        } else if w.shrines.bonus {
            w.shrines.bonus = false;
            perks.offer(&w.perks, &w.player);
        }
        game.captureMouse(false);
    }
    if boss.update(&w.bosses, &w.player, &w.level, &w.enemies, step) {
        score.bonus(&w.score, "BOSS DOWN", BOSS_PTS);
        skills.offer(&w.skills);
        game.captureMouse(false);
    }
    w.guns.shake = max(w.guns.shake, w.bosses.shake);
    score.update(&w.score, &w.player, &w.enemies, step);
    enemies.update(&w.enemies, &w.player, &w.level, &w.scene, step);
    if w.enemies.died {
        w.enemies.died = false;
        perks.reset(&w.perks);
        shrine.reseed(&w.shrines);
        gates.reset(&w.gates, &w.level);
        guns.refill(&w.guns, &w.player);
        boss.reset(&w.bosses);
        skills.reset(&w.skills, &w.player);
    }
    // 100 of a biome's own enemies down: a free legendary hand.
    if w.enemies.cleared >= 0 && !w.perks.offering {
        w.enemies.cleared = -1;
        perks.offerLegendary(&w.perks);
        game.captureMouse(false);
        return;
    }
    if perks.earn(&w.perks, &w.enemies) {
        perks.offer(&w.perks, &w.player);
        game.captureMouse(false);
    }
}

fn draw(w: &World) {
    let env = scene3d.environment(&w.scene);
    let look = guns.view(&w.guns, player.look(&w.player));
    // The biome you're in sets the sky, sun and fog; the scene's sun direction stays.
    let b = w.biomes;
    gfx.setFog(b.fogStart, b.fogEnd);
    gfx.setClip(0.05, b.fogEnd + 20);
    let prepareAt = game.micros();
    enemies.prepare(&w.enemies, &w.player);
    boss.prepare(&w.bosses);
    w.perf.prepareMs = f32(game.micros() - prepareAt) / 1000;
    w.perf.sceneMs = 0;
    let r = env.shadowSize;
    let e = look.eye;
    gfx.shadowPass(env.sunDir, e - Vec3.xyz(r, r, r), e + Vec3.xyz(r, r, r));
    // Nothing in the arena moves: draw with the world matrices the level worked out once,
    // instead of `scene3d.draw` redoing them for every object each pass.
    if env.shadows {
        let shadowSceneAt = game.micros();
        scene3d.drawWith(&w.scene, w.level.mats);
        w.perf.sceneMs += f32(game.micros() - shadowSceneAt) / 1000;
        perf.draw(&w.perf, &w.enemies);
        enemies.draw(&w.enemies, &w.player);
        boss.draw(&w.bosses);
        shrine.draw(&w.shrines);
        gear.draw(&w.gear, &w.player, false);
        gates.drawLocks(&w.gates, &w.shrines);
    }
    scene3d.lights(&w.scene);
    guns.lights(&w.guns, look);
    boss.lights(&w.bosses);
    skills.lights(&w.skills);
    gfx.cameraPassLookFov(look, env.sunDir, b.sky, b.sun, guns.fov(&w.guns) + w.player.fovBoost);
    scene3d.drawSky(&w.scene);
    let cameraSceneAt = game.micros();
    scene3d.drawWith(&w.scene, w.level.mats);
    w.perf.sceneMs += f32(game.micros() - cameraSceneAt) / 1000;
    perf.draw(&w.perf, &w.enemies);
    enemies.draw(&w.enemies, &w.player);
    boss.draw(&w.bosses);
    shrine.draw(&w.shrines);
    gear.draw(&w.gear, &w.player, true);
    skills.draw(&w.skills);
    gates.drawLocks(&w.gates, &w.shrines);
    gates.drawWalls(&w.gates, &w.level);
    boss.drawBlended(&w.bosses);
    guns.draw(&w.guns, look);
    score.draw(&w.score);
    hud.draw(w.font, w.big, &w.guns, &w.player, &w.enemies, &w.perks, w.perks.offering || w.shrines.offering || w.skills.offering);
    boss.hud(&w.bosses, &w.player, w.font, w.big);
    minimap.draw(&w.level, &w.player, &w.enemies, &w.shrines, &w.bosses, w.mapOpen, w.font, w.big);
    if w.perks.offering { perks.draw(&w.perks, w.font, w.big); }
    biome.hud(&w.biomes, w.font, w.big);
    gates.hud(&w.gates, w.perks.level, w.font, w.big);
    shrine.hud(&w.shrines, w.font, w.big);
    skills.hud(&w.skills, w.font, w.big);
}

fn main() {
    let app = App<World>.create("fps_shooter", 1280, 720, boot);
    app.useGl();
    app.startup(startup);
    app.always(update);
    app.draw(draw);
    app.run();
}
