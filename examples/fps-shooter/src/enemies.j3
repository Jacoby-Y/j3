/// Difficulty: 0 easy, 1 medium, 2 hard, 3 extreme, 4 death. Set from the main menu.
pub const EASY: int = 0;
pub const MEDIUM: int = 1;
pub const DEATH: int = 4;
#[singleton]
let level_diff: int;
/// Set when the game is beaten on medium or better: opens the harder ones (this session).
#[singleton]
let opened: bool;

pub fn difficulty(): int { return level_diff; }
pub fn setDifficulty(d: int) { level_diff = d; }
pub fn hardOpen(): bool { return opened; }
pub fn openHard() { opened = true; }
pub fn diffName(d: int): string {
    if d == 0 { return "EASY"; }
    if d == 1 { return "MEDIUM"; }
    if d == 2 { return "HARD"; }
    if d == 3 { return "EXTREME"; }
    return "DEATH";
}
/// Enemy hp and damage.
pub fn foeMul(): f32 {
    if level_diff == 0 { return 0.8; }
    if level_diff == 2 { return 1.3; }
    if level_diff == 3 { return 1.6; }
    if level_diff == 4 { return 2; }
    return 1;
}
fn foeSpeed(): f32 {
    if level_diff == 2 { return 1.1; }
    if level_diff == 3 { return 1.2; }
    if level_diff == 4 { return 1.4; }
    return 1;
}
/// More elites and modifiers: scales their chance.
fn foeOdds(): f32 {
    if level_diff == 2 { return 1.1; }
    if level_diff == 3 { return 1.25; }
    if level_diff == 4 { return 1.6; }
    return 1;
}
const MOD_ELITE_CHANCE: f32 = 0.5;
const ELECTRIC_SPEED: f32 = 1.35;
/// Shocked by a dying electric enemy: this many neighbours within this range, and a lesser speedup.
const SHOCK_RANGE: f32 = 14;
const SHOCKED_SPEED: f32 = 1.2;
const FIRE_EVERY: f32 = 3.5;
const FIRE_RANGE: f32 = 40;
const FIRE_HIT: f32 = 16;
const FIRE_RING: int = 8;
/// Fireballs are lobbed: horizontal speed, and how hard gravity pulls them.
const FIRE_SPEED: f32 = 15;
const FIRE_GRAVITY: f32 = 16;
/// Flight time of a lob: this many seconds plus this much per metre, so it always climbs high.
const FIRE_LOB: f32 = 0.9;
const FIRE_LOB_PER_M: f32 = 0.035;
const ARMORED_SPEED: f32 = 0.85;
const ARMORED_TAKEN: f32 = 0.5;
/// Elites: each star adds this much size, and this much extra health and XP.
const STAR_SIZE: f32 = 0.18;
const STAR_HP: f32 = 1.5;
/// Elite spawns start at this tier; the chance of one, and of 2 and 3 stars, grows with it.
const ELITE_TIER: int = 3;
/// Super ammo orbs: room for this many, how long they wait, and how close before they fly to you.
const MAX_CELLS: int = 8;
const CELL_LIFE: f32 = 45;
const CELL_MAGNET: f32 = 6;
const CELL_FLY: f32 = 16;

pub struct Enemy {
    /// 0 for a free slot.
    kind: int;
    /// Centre.
    pos: Vec3;
    vel: Vec3;
    hp: f32;
    /// Hoppers: until the next hop. Drones: until the next shot. Chargers: until the next
    /// rush. Bombers: until the dive.
    t: f32;
    /// White flash after a hit.
    flash: f32;
    /// Drones and bombers: where on the circle around you. Zippers: zig-zag clock. Chargers:
    /// rush time left.
    phase: f32;
    grounded: bool;
    squash: f32;
    /// From a shrine: a gold outline and more health.
    gold: bool;
    /// A biome's own enemy: that biome's tile, else -1.
    zone: int;
    /// Cave roster: crystal slime, stone spider or echo bat, using the matching movement family.
    cave: bool = false;
    /// A living shell fragment from the cave boss; never splits again.
    miniGeode: bool = false;
    hopT: f32 = 0;
    active: bool = false;
    wakeT: f32 = 0;
    detailed: bool = true;
    /// Shrine ones: seconds alive, for the stuck check.
    age: f32 = 0;
    /// Standing on another enemy (set by `separate`, read by `moveBody`), and how squeezed it is.
    perch: bool = false;
    crowd: f32 = 0;
    climbT: f32 = 0;
    /// Shield: which way the shield faces (yaw, like the body's).
    aim: f32 = 0;
    /// Within a flag bearer's aura this frame.
    buff: bool = false;
    /// Meteor: the ground it lands on.
    groundY: f32 = 0;
    /// Parried: seconds until the katana's counter-cut lands, and its damage.
    riposte: f32 = 0;
    /// Seconds before this enemy can be parried again.
    parryCd: f32 = 0;
    riposteDmg: f32 = 0;
    /// Elite rank: stars over its head, 0 for an ordinary one.
    stars: int = 0;
    /// Modifier (`MOD_*`, 0 none). `lent`: got it from a dying electric one, so it can't pass it on.
    mod: int = 0;
    lent: bool = false;
    modT: f32 = 0;
}

/// A super ammo orb an elite dropped.
/// A floating damage figure: where it started, what it adds up to, and how long it has been up.
/// Hits with the same `key` inside `NUM_JOIN` seconds add into one (a shotgun volley is one number).
pub struct Num {
    pos: Vec3;
    key: int;
    val: f32;
    t: f32;
    kill: bool;
}

pub const MAX_NUMS: int = 24;
pub const NUM_LIFE: f32 = 0.9;
const NUM_JOIN: f32 = 0.15;

struct Cell {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    pulled: bool = false;
    settled: bool = false;
}

struct Orb {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    /// A fireball: orange, hits harder.
    fire: bool = false;
}

/// A bit of debris from a hit or a death.
struct Bit {
    pos: Vec3;
    vel: Vec3;
    t: f32;
    size: f32;
    color: Vec3;
    /// Flame: 1 floats up instead of falling, and `life` is its full life so it can swell and cool.
    lift: f32 = 0;
    life: f32 = 0;
}

/// XP gem with a simulation-clock expiry; `t` caches remaining lifetime for drawing.
struct Gem {
    pos: Vec3;
    vel: Vec3;
    value: int;
    t: f32;
    pulled: bool;
    expires: f32 = 0;
    settled: bool = false;
    pending: f32 = 0;
    nextTick: f32 = 0;
    /// Magnet gift: 0 not rolled yet, 1 normal, 2 flies to you from anywhere.
    roll: int = 0;
}

/// What a ray hit: an enemy index (or -1) and how far along.
pub struct Hit {
    index: int;
    t: f32;
    /// Where the ray leaves that enemy.
    exit: f32;
}

pub struct Enemies {
    list: []Enemy;
    orbs: []Orb;
    nextOrb: int;
    bits: []Bit;
    nextBit: int;
    gems: []Gem;
    nextGem: int;
    /// Seconds survived this run, and the difficulty it sets (1 up).
    time: f32;
    tier: int;
    spawnT: f32;
    /// Player level, set by main; past LATE_LEVEL spawns come a bit faster and mostly next to you.
    lvl: int;
    /// Quiet time before spawning starts.
    restT: f32;
    kills: int;
    /// Bullets that landed, for the score.
    hits: int;
    /// XP picked up and not yet spent on levels (the caller takes it).
    xp: int;
    /// HUD: hit marker, kill marker, gem pickup flash, "down" banner.
    hitT: f32;
    killT: f32;
    /// Damage figures for the hud, ringed.
    nums: []Num;
    nextNum: int;
    gemT: f32;
    downT: f32;
    /// How long the last run lasted, for the "down" banner.
    downTime: f32;
    /// Set the moment the player goes down; the caller clears it.
    died: bool;
    /// Area enemies killed per biome tile (kept across runs), and the tile that just hit
    /// `ZONE_GOAL`, or -1; the caller clears it.
    zoneKills: []int;
    cleared: int;
    cube: Mesh;
    rng: Rng;
    /// The outline being drawn: glow and thickness, set per enemy.
    edge: Vec3;
    edgeW: f32;
    cosmetic: Rng;
    clock: f32 = 0;
    hordeT: f32 = 105;
    /// Endless mode on, and seconds until the next Colossus lands on you.
    endless: bool = false;
    /// Challenge progression aid: meteors still owed to each tile, and seconds to the next one.
    aid: []int;
    aidT: f32 = 0;
    emberT: f32 = 0;
    colossusT: f32 = 120;
    specialT: f32 = 80;
    debugT: f32 = 0;
    debugDone: bool = false;
    /// Camera shake asked for by an impact (decays).
    shake: f32 = 0;
    effectsLeft: int = 48;
    tokens: f32 = 48;
    listener: Vec3;
    aiMs: f32 = 0;
    gemMs: f32 = 0;
    effectsMs: f32 = 0;
    parts: []Instance;
    owners: []int;
    casts: []bool;
    shells: []bool;
    batch: []Instance;
    visible: []bool;
    partCount: int = 0;
    owner: int = -1;
    cast: bool = true;
    detail: bool = true;
    /// A boss fight is on: half the population, topped up half as fast.
    calm: bool = false;
    cells: []Cell;
    nextCell: int = 0;
    /// The guns say whether the held one can take super ammo now; orbs only fly in when it can.
    /// `superGot` is set the moment one is taken, and the guns clear it.
    superOk: bool = false;
    superGot: bool = false;
    eliteT: f32 = 0;
    eliteDone: bool = false;
}

pub fn create(mem: &Arena): Enemies {
    let made = Enemies {
        list: mem.alloc::<Enemy>(MAX_ENEMIES), orbs: mem.alloc::<Orb>(MAX_ORBS), nextOrb: 0,
        bits: mem.alloc::<Bit>(MAX_BITS), nextBit: 0, gems: mem.alloc::<Gem>(MAX_GEMS), nextGem: 0,
        time: 0, tier: 1, spawnT: 0, lvl: 1, restT: START_REST, kills: 0, hits: 0, xp: 0,
        hitT: 0, killT: 0, nums: mem.alloc::<Num>(MAX_NUMS), nextNum: 0, gemT: 0, downT: 0, downTime: 0, died: false, zoneKills: mem.alloc::<int>(10), aid: mem.alloc::<int>(10), cleared: -1,
        cube: Mesh { vao: 0, vbo: 0, count: 0 }, rng: Rng.new(99),
        edge: Vec3.zero(), edgeW: OUTLINE, cosmetic: Rng.new(701), listener: Vec3.zero(),
        parts: mem.alloc::<Instance>(4096), owners: mem.alloc::<int>(4096), casts: mem.alloc::<bool>(4096),
        shells: mem.alloc::<bool>(4096), batch: mem.alloc::<Instance>(4096), visible: mem.alloc::<bool>(MAX_ENEMIES), cells: mem.alloc::<Cell>(MAX_CELLS),
    };
    let ni = 0;
    while ni < MAX_NUMS {
        made.nums[ni].t = NUM_LIFE;
        ni += 1;
    }
    return made;
}

pub fn upload(e: &Enemies, mem: &Arena) {
    e.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

/// Enemies alive, not counting shrine ones.
pub fn alive(e: &Enemies): int {
    let n = 0;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 && !e.list[i].gold { n += 1; }
        i += 1;
    }
    return n;
}

/// How many to keep around at this tier, and how fast to top them up.
fn target(e: &Enemies, lvl: &Level): int {
    let count = 0;
    let i = 0;
    while i < 9 { if isOpen(lvl, i) { count += 1; } i += 1; }
    let n = mini(6 + e.tier * 3, 20) * count;
    if e.lvl > LATE_LEVEL { n = n + n / 5; }
    if e.endless { n = int(f32(n) * ENDLESS_MORE); }
    if challenge.on(challenge.HORDE) { n = n * HORDE_MORE; }
    if e.calm && !e.endless { n = n / 2; }
    return n;
}

/// Reset before weapons, gear, or enemies can emit effects this update.
pub fn beginUpdate(e: &Enemies, p: &Player, dt: f32) {
    e.clock += dt;
    e.listener = p.pos;
    e.tokens = min(48, e.tokens + dt * 480);
    e.effectsLeft = 48;
}

fn spawnEvery(e: &Enemies): f32 {
    let every = max(1 - f32(e.tier) * 0.07, 0.25);
    if e.lvl > LATE_LEVEL { every = every * LATE_RATE; }
    if e.endless { every = every * ENDLESS_RATE; }
    if challenge.on(challenge.HORDE) { every = every * HORDE_RATE; }
    return every;
}

/// XP a kill of `kind` drops.
fn worth(kind: int): int {
    if kind == SHIELD { return 40; }
    if kind == METEOR { return 30; }
    if kind == FLAG { return 12; }
    if kind == CHARGER { return 5; }
    if kind == DRONE || kind == BOMBER || kind == CRAB || kind == CHICKEN { return 2; }
    if kind == PUFFER || kind == FROG || kind == SKULL { return 3; }
    return 1;
}

fn drop(e: &Enemies, at: Vec3, value: int) {
    let a = e.cosmetic.unit() * TAU;
    e.gems[e.nextGem] = Gem { pos: at, vel: Vec3.xyz(cos(a) * 2.5, 5, sin(a) * 2.5), value: value, t: GEM_LIFE, pulled: false, expires: e.clock + GEM_LIFE, pending: 0, settled: false, nextTick: e.clock + f32(e.nextGem % 10) * 0.01 };
    e.nextGem = (e.nextGem + 1) % MAX_GEMS;
}

fn dropCell(e: &Enemies, at: Vec3) {
    let a = e.cosmetic.unit() * TAU;
    e.cells[e.nextCell] = Cell { pos: at, vel: Vec3.xyz(cos(a) * 2, 6, sin(a) * 2), t: CELL_LIFE };
    e.nextCell = (e.nextCell + 1) % MAX_CELLS;
}

/// Super ammo orbs fall and settle; when the held gun can use one, a near orb flies to you.
fn cells(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    let chest = p.pos + Vec3.xyz(0, 0.9, 0);
    let i = 0;
    while i < MAX_CELLS {
        let c = &e.cells[i];
        if c.t > 0 {
            c.t -= dt;
            let to = chest - c.pos;
            let far = to.length();
            c.pulled = e.superOk && (c.pulled || far < CELL_MAGNET);
            if c.pulled {
                if far < PICKUP {
                    e.superGot = true;
                    sfx.play(sfx.READY);
                    c.t = 0;
                } else {
                    c.pos = c.pos + to * (CELL_FLY * dt / far);
                }
            } else if !c.settled {
                c.vel.y -= GRAVITY * dt;
                let next = c.pos + c.vel * dt;
                if solid(lvl, next, 0.25) >= 0 {
                    c.vel = Vec3.zero();
                    c.settled = true;
                } else { c.pos = next; }
                if c.pos.y < level.rescueY(lvl, c.pos) { c.t = 0; }
            }
        }
        i += 1;
    }
}

/// A fallen boss's hoard: `xp` in red gems, scattered from `at`.
pub fn reward(e: &Enemies, at: Vec3, xp: int) {
    let left = xp;
    while left > 0 {
        let v = mini(left, 5);
        drop(e, at, v);
        e.gems[(e.nextGem + MAX_GEMS - 1) % MAX_GEMS].vel = e.gems[(e.nextGem + MAX_GEMS - 1) % MAX_GEMS].vel * 2.2;
        left -= v;
    }
}

/// Gem colour by value: blue, green, red.
fn gemColor(value: int): Vec3 {
    if value >= 5 { return Vec3.xyz(1, 0.25, 0.3); }
    if value >= 2 { return Vec3.xyz(0.3, 1, 0.4); }
    return Vec3.xyz(0.3, 0.6, 1);
}

/// Gems fall and settle; near the player they fly in and are picked up.
fn gems(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    let chest = p.pos + Vec3.xyz(0, 0.9, 0);
    let magnet = player.has(p, player.MAGNET);
    let i = 0;
    while i < MAX_GEMS {
        let g = &e.gems[i];
        if g.t > 0 {
            g.t = max(0, g.expires - e.clock);
            let to = chest - g.pos;
            let dist2 = to.dot(to);
            let reach = MAGNET;
            if magnet {
                reach = MAGNET * 2;
                if g.roll == 0 {
                    g.roll = 1;
                    if e.rng.unit() < 0.5 { g.roll = 2; }
                }
                if g.roll == 2 { g.pulled = true; }
            }
            if g.t > 0 && dist2 < reach * reach { g.pulled = true; }
            if g.t > 0 && g.pulled {
                let far = sqrt(dist2);
                g.vel = to.normalize() * (12 + (GEM_LIFE - g.t) * 0.5 + max(reach - far, 0) * 5);
                g.pos = g.pos + g.vel * dt;
                if far < PICKUP {
                    e.xp += g.value;
                    if e.gemT <= 0.1 { sfx.play(sfx.GEM); }
                    e.gemT = 0.15;
                    g.t = 0;
                }
            } else if g.t > 0 && !g.settled {
                g.pending += dt;
                // Stagger distant falling gems into ten time buckets.
                let due = e.clock >= g.nextTick;
                if dist2 < 400 || due || g.pending >= 0.12 {
                    g.nextTick = e.clock + 0.1;
                    let remaining = g.pending;
                    g.pending = 0;
                    while remaining > 0 && !g.settled {
                        let step = min(remaining, 0.02);
                        remaining -= step;
                        g.vel.y -= GRAVITY * step;
                        let next = g.pos + g.vel * step;
                        if solid(lvl, next, 0.15) >= 0 {
                            g.vel = Vec3.zero();
                            g.settled = true;
                        } else { g.pos = next; }
                    }
                    if g.pos.y < level.rescueY(lvl, g.pos) { g.t = 0; }
                }
            }
        }
        i += 1;
    }
}

fn size(kind: int): f32 {
    if kind == HOPPER { return HOPPER_SIZE; }
    if kind == ZIPPER { return ZIPPER_SIZE; }
    if kind == CHARGER { return CHARGER_SIZE; }
    if kind == BOMBER { return BOMBER_SIZE; }
    if kind == SHIELD { return SHIELD_SIZE; }
    if kind == FLAG { return FLAG_SIZE; }
    if kind == METEOR { return METEOR_SIZE; }
    if kind == GHOST { return GHOST_SIZE; }
    if kind == CRAB { return CRAB_SIZE; }
    if kind == PUFFER { return PUFFER_SIZE; }
    if kind == FROG { return FROG_SIZE; }
    if kind == SKULL { return SKULL_SIZE; }
    if kind == CHICKEN { return CHICKEN_SIZE; }
    return DRONE_SIZE;
}

/// Body scale: elites grow a little per star.
fn bulk(en: Enemy): f32 {
    return 1 + f32(en.stars) * STAR_SIZE;
}

/// Overhead badges: a row of small symbols over the head, turned to face you. What one wears comes
/// from `badgeCount` and `badgeAt` (the modifier first, then a star per rank); a new source of symbols
/// only needs a line in each and a shape in `drawBadge`. The row centres itself on however many there are.
const BADGE_STAR: int = 100;
const BADGE_GAP: f32 = 0.55;

fn badgeCount(en: Enemy): int {
    let n = en.stars;
    if en.mod != 0 { n += 1; }
    return n;
}

fn badgeAt(en: Enemy, i: int): int {
    if en.mod != 0 && i == 0 { return en.mod; }
    return BADGE_STAR;
}

/// One bar of a symbol: `x`/`y` from the badge middle, `w` by `h`, turned `ang` radians.
fn badgePiece(e: &Enemies, at: Mat4, x: f32, y: f32, w: f32, h: f32, ang: f32, col: Vec3) {
    let m = at.mul(Mat4.translate(x, y, 0)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), ang));
    cube(e, m, Vec3.zero(), Vec3.xyz(w, h, 0.07), col, col * 3);
}

/// The symbol for `code` (`BADGE_STAR` or a `MOD_*`) with its middle at `at`, about 0.46 wide.
fn drawBadge(e: &Enemies, at: Mat4, code: int) {
    if code == BADGE_STAR {
        let ray = 0;
        while ray < 4 {
            badgePiece(e, at, 0, 0, 0.46, 0.07, f32(ray) * PI * 0.25, Vec3.xyz(1, 0.8, 0.2));
            ray += 1;
        }
        return;
    }
    let glow = modGlow(code);
    let col = glow * (1 / max(glow.x, max(glow.y, glow.z)));
    if code == MOD_ELECTRIC {
        // A bolt: two steep bars joined by a short flat one.
        badgePiece(e, at, 0.07, 0.13, 0.3, 0.09, 1.1, col);
        badgePiece(e, at, 0, 0, 0.22, 0.09, 0, col);
        badgePiece(e, at, -0.07, -0.13, 0.3, 0.09, 1.1, col);
    } else if code == MOD_FIRE {
        // A flame: a big diamond with a small one licking up from it.
        badgePiece(e, at, 0, -0.06, 0.22, 0.22, PI * 0.25, col);
        badgePiece(e, at, 0, 0.13, 0.13, 0.13, PI * 0.25, col);
    } else if code == MOD_ARMORED {
        // A shield: a plate over a point, with a dark boss on it.
        badgePiece(e, at, 0, 0.05, 0.3, 0.26, 0, col);
        badgePiece(e, at, 0, -0.11, 0.21, 0.21, PI * 0.25, col);
        badgePiece(e, at, 0, 0.02, 0.1, 0.1, PI * 0.25, Vec3.xyz(0.04, 0.05, 0.08));
    } else {
        // Split: one square above two.
        badgePiece(e, at, 0, 0.12, 0.17, 0.17, 0, col);
        badgePiece(e, at, -0.13, -0.08, 0.17, 0.17, 0, col);
        badgePiece(e, at, 0.13, -0.08, 0.17, 0.17, 0, col);
    }
}

/// The badge row for `en`, `crown` high, facing `yaw`.
fn drawBadges(e: &Enemies, en: Enemy, crown: f32, yaw: f32) {
    let count = badgeCount(en);
    let row = Mat4.translate(en.pos.x, crown + sin(e.clock * 3 + en.phase) * 0.06, en.pos.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), yaw));
    e.cast = false;
    let slot = 0;
    while slot < count {
        drawBadge(e, row.mul(Mat4.translate((f32(slot) - f32(count - 1) * 0.5) * BADGE_GAP, 0, 0)), badgeAt(en, slot));
        slot += 1;
    }
    e.cast = true;
}

/// Promote a fresh enemy to `stars` stars: more health, and the rest follows from `stars`.
fn promote(e: &Enemies, en: &Enemy, stars: int) {
    en.stars = stars;
    en.hp = en.hp * (1 + f32(stars) * STAR_HP);
    if en.mod == 0 && e.rng.unit() < MOD_ELITE_CHANCE { en.mod = 1 + e.rng.intRange(0, MODS); }
    if en.kind == ZIPPER && en.mod == MOD_SPLIT { en.mod = 0; }
}

/// Speed multiplier from the modifier.
fn modSpeed(en: &Enemy): f32 {
    if en.mod == MOD_ELECTRIC {
        if en.lent { return SHOCKED_SPEED; }
        return ELECTRIC_SPEED;
    }
    if en.mod == MOD_ARMORED { return ARMORED_SPEED; }
    return 1;
}

/// Outline glow: how a modifier reads at a glance.
fn modGlow(mod: int): Vec3 {
    if mod == MOD_ELECTRIC { return Vec3.xyz(0.6, 2.4, 2.8); }
    if mod == MOD_FIRE { return Vec3.xyz(3, 1, 0.15); }
    if mod == MOD_ARMORED { return Vec3.xyz(1.1, 1.2, 1.4); }
    return Vec3.xyz(1.6, 3, 0.5);
}

fn fireball(e: &Enemies, from: Vec3, vel: Vec3) {
    e.orbs[e.nextOrb] = Orb { pos: from + vel.normalize() * 0.6, vel: vel, t: ORB_LIFE, fire: true };
    e.nextOrb = (e.nextOrb + 1) % MAX_ORBS;
}

/// Each update while awake: fire ones lob a fireball at you now and then; electric ones crackle.
fn modTick(e: &Enemies, en: &Enemy, p: &Player, dt: f32) {
    if en.mod == MOD_FIRE {
        en.modT -= dt;
        if en.modT <= 0 {
            en.modT = FIRE_EVERY * (0.7 + e.rng.unit() * 0.6);
            let to = p.pos + Vec3.xyz(0, 1.2, 0) - en.pos;
            if to.length() < FIRE_RANGE && to.length() > 1 {
                // Arc it: flight time from the flat distance, then the climb that lands it on you.
                let flat = Vec3.xyz(to.x, 0, to.z).length();
                let fly = FIRE_LOB + flat * FIRE_LOB_PER_M;
                let up = (to.y + 0.5 * FIRE_GRAVITY * fly * fly) / fly;
                let side = Vec3.zero();
                if flat > 0.1 { side = Vec3.xyz(to.x, 0, to.z).normalize() * (flat / fly); }
                fireball(e, en.pos, Vec3.xyz(side.x, up, side.z));
                sfx.at(sfx.FLAME, en.pos);
            }
        }
    }
    if en.mod == MOD_ELECTRIC && e.cosmetic.unit() < dt * 6 {
        burst(e, en.pos + Vec3.xyz(e.cosmetic.unit() - 0.5, e.cosmetic.unit() - 0.5, e.cosmetic.unit() - 0.5) * size(en.kind), modGlow(MOD_ELECTRIC) * 0.4, 2, 5);
    }
}

/// Damage actually taken, before buffs and shields.
fn modHurt(en: &Enemy, dmg: f32): f32 {
    if en.mod == MOD_ARMORED { return dmg * ARMORED_TAKEN; }
    return dmg;
}

/// On death: electric shocks the nearest plain enemies (once, never chained), fire blows out a ring
/// of fireballs, split ones break into 5 zippers.
fn modDeath(e: &Enemies, en: &Enemy) {
    if en.mod == MOD_ELECTRIC && !en.lent {
        let n = 3 + e.rng.intRange(0, 3);
        while n > 0 {
            let best = -1;
            let bestD: f32 = SHOCK_RANGE * SHOCK_RANGE;
            let i = 0;
            while i < MAX_ENEMIES {
                let o = e.list[i];
                if o.kind != 0 && o.kind != METEOR && o.mod == 0 {
                    let d = o.pos - en.pos;
                    if d.dot(d) < bestD { best = i; bestD = d.dot(d); }
                }
                i += 1;
            }
            if best < 0 { break; }
            e.list[best].mod = MOD_ELECTRIC;
            e.list[best].lent = true;
            burst(e, e.list[best].pos, modGlow(MOD_ELECTRIC), 8, 7);
            n -= 1;
        }
        sfx.at(sfx.ZAP, en.pos);
        burst(e, en.pos, modGlow(MOD_ELECTRIC), 12, 10);
    }
    if en.mod == MOD_FIRE {
        let ring = 0;
        let turn = e.rng.unit() * TAU;
        while ring < FIRE_RING {
            let a = turn + f32(ring) * TAU / f32(FIRE_RING);
            fireball(e, en.pos, Vec3.xyz(cos(a) * FIRE_SPEED * 0.6, 12, sin(a) * FIRE_SPEED * 0.6));
            ring += 1;
        }
        burst(e, en.pos, Vec3.xyz(1, 0.45, 0.1), 16, 10);
    }
    if en.mod == MOD_SPLIT {
        let pair = 0;
        while pair < 5 {
            let dir = e.rng.unit() * TAU;
            spawnAt(e, ZIPPER, en.pos + Vec3.xyz(cos(dir) * 0.6, 0.3, sin(dir) * 0.6), Vec3.xyz(cos(dir) * 6, 5, sin(dir) * 6), false);
            pair += 1;
        }
    }
}

fn health(kind: int): f32 {
    if kind == HOPPER { return HOPPER_HP; }
    if kind == ZIPPER { return ZIPPER_HP; }
    if kind == CHARGER { return CHARGER_HP; }
    if kind == BOMBER { return BOMBER_HP; }
    if kind == SHIELD { return SHIELD_HP; }
    if kind == FLAG { return FLAG_HP; }
    if kind == METEOR { return METEOR_HP; }
    if kind == GHOST { return GHOST_HP; }
    if kind == CRAB { return CRAB_HP; }
    if kind == PUFFER { return PUFFER_HP; }
    if kind == FROG { return FROG_HP; }
    if kind == SKULL { return SKULL_HP; }
    if kind == CHICKEN { return CHICKEN_HP; }
    return DRONE_HP;
}

pub fn color(kind: int): Vec3 {
    if kind == HOPPER { return Vec3.xyz(1, 0.35, 0.6); }
    if kind == ZIPPER { return Vec3.xyz(0.2, 0.9, 1); }
    if kind == CHARGER { return Vec3.xyz(1, 0.3, 0.15); }
    if kind == BOMBER { return Vec3.xyz(0.65, 0.35, 1); }
    if kind == SHIELD { return Vec3.xyz(0.4, 0.75, 1); }
    if kind == FLAG { return Vec3.xyz(1, 0.15, 0.25); }
    if kind == METEOR { return Vec3.xyz(1, 0.5, 0.15); }
    if kind == GHOST { return Vec3.xyz(0.75, 0.9, 1); }
    if kind == CRAB { return Vec3.xyz(1, 0.4, 0.3); }
    if kind == PUFFER { return Vec3.xyz(0.95, 0.85, 0.35); }
    if kind == FROG { return Vec3.xyz(0.4, 0.85, 0.3); }
    if kind == SKULL { return Vec3.xyz(0.92, 0.9, 0.8); }
    if kind == CHICKEN { return Vec3.xyz(1, 0.97, 0.9); }
    return Vec3.xyz(1, 0.75, 0.15);
}

/// Which kind to spawn: new kinds join as the waves go on.
fn pickKind(e: &Enemies): int {
    let u = e.rng.unit();
    if e.tier >= 5 && u < 0.05 { return BOMBER; }
    if e.tier >= 4 && u >= 0.1 && u < 0.22 { return CHARGER; }
    if e.tier >= 3 && u >= 0.22 && u < 0.42 { return ZIPPER; }
    if e.tier >= 2 && u >= 0.88 { return DRONE; }
    return HOPPER;
}

fn burst(e: &Enemies, at: Vec3, tint: Vec3, n: int, speed: f32) {
    let off = at - e.listener;
    if off.dot(off) > 3600 { return; }
    let count = mini(n, mini(e.effectsLeft, int(e.tokens)));
    e.effectsLeft -= count;
    e.tokens -= f32(count);
    let i = 0;
    while i < count {
        let d = Vec3.xyz(e.cosmetic.unit() - 0.5, e.cosmetic.unit() * 0.8, e.cosmetic.unit() - 0.5).normalize();
        e.bits[e.nextBit] = Bit {
            pos: at, vel: d * (speed * (0.4 + e.cosmetic.unit())), t: 0.5 + e.cosmetic.unit() * 0.4,
            size: 0.08 + e.cosmetic.unit() * 0.12, color: tint,
        };
        e.nextBit = (e.nextBit + 1) % MAX_BITS;
        i += 1;
    }
}

/// The run ended. Clears the field and puts the player back at the spawn.
pub fn revive(e: &Enemies, p: &Player) {
    wipe(e);
    e.time = 0;
    e.tier = 1;
    e.xp = 0;
    e.kills = 0;
    e.restT = DOWN_REST;
    e.died = false;
    e.downT = 0;
    respawn(p);
    p.stats = noStats();
    p.hp = maxHp(p);
}

/// Clear everything: the player went down.
fn wipe(e: &Enemies) {
    e.hordeT = HORDE_EVERY;
    e.specialT = SPECIAL_EVERY;
    e.colossusT = COLOSSUS_EVERY;
    e.aidT = 0;
    let a = 0;
    while a < 10 { e.aid[a] = 0; a += 1; }
    let bit = 0;
    while bit < MAX_BITS { e.bits[bit].t = 0; bit += 1; }
    let g = 0;
    while g < MAX_GEMS {
        e.gems[g].t = 0;
        g += 1;
    }
    g = 0;
    while g < MAX_CELLS {
        e.cells[g].t = 0;
        g += 1;
    }
    let i = 0;
    while i < MAX_ENEMIES {
        e.list[i].kind = 0;
        i += 1;
    }
    i = 0;
    while i < MAX_ORBS {
        e.orbs[i].t = 0;
        i += 1;
    }
}

/// From ELITE_TIER on, an ordinary spawn may come up as an elite: 1 star, and 2 or 3 as the tier climbs.
fn rollElite(e: &Enemies, en: &Enemy) {
    if e.tier < ELITE_TIER { return; }
    if e.rng.unit() >= min(0.04 + f32(e.tier) * 0.01, 0.15) * foeOdds() { return; }
    let stars = 1;
    if e.tier >= 6 && e.rng.unit() < 0.35 { stars = 2; }
    if e.tier >= 10 && e.rng.unit() < 0.25 { stars = 3; }
    promote(e, en, stars);
}

/// The farthest ordinary enemy at least 45 m away, or -1. Gold ones stay.
fn farthest(e: &Enemies, p: &Player): int {
    let best = -1;
    let bestD: f32 = 2025;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 && !en.gold {
            let d = en.pos - p.pos;
            let dd = d.x * d.x + d.z * d.z;
            if dd > bestD {
                best = i;
                bestD = dd;
            }
        }
        i += 1;
    }
    return best;
}

/// One enemy somewhere clear, away from the player: hoppers drop in from above, drones fly in.
/// At the ordinary cap, the farthest enemy beyond 45 m is removed and the new one appears
/// 12–22 m from the player.
fn spawn(e: &Enemies, p: &Player, lvl: &Level) {
    let replacing = false;
    if alive(e) >= MAX_ENEMIES - GOLD_ROOM {
        let gone = farthest(e, p);
        if gone < 0 { return; }
        e.list[gone].kind = 0;
        replacing = true;
    }
    let slot = 0;
    while slot < MAX_ENEMIES && e.list[slot].kind != 0 { slot += 1; }
    if slot == MAX_ENEMIES { return; }
    let kind = pickKind(e);
    let counts: [9]int = [0, 0, 0, 0, 0, 0, 0, 0, 0];
    let near = 0;
    let j = 0;
    while j < MAX_ENEMIES {
        let en = e.list[j];
        if en.kind != 0 && !en.gold && !en.cave {
            let inhabitantTile = tileAt(en.pos.x, en.pos.z);
            if inhabitantTile >= 0 && inhabitantTile < 9 { counts[inhabitantTile] += 1; }
            let d = en.pos - p.pos;
            if d.x * d.x + d.z * d.z < 3600 { near += 1; }
        }
        j += 1;
    }
    let tileChoice = -1;
    let start = e.rng.intRange(0, 9);
    j = 0;
    while j < 9 {
        let candidate = (start + j) % 9;
        if isOpen(lvl, candidate) && counts[candidate] < mini(6 + e.tier * 3, 20) {
            if tileChoice < 0 { tileChoice = candidate; }
            else if counts[candidate] < counts[tileChoice] { tileChoice = candidate; }
        }
        j += 1;
    }
    if replacing {
        tileChoice = tileAt(p.pos.x, p.pos.z);
        if !isOpen(lvl, tileChoice) { tileChoice = HUB; }
    }
    let underground = level.inHollows(p.pos) && level.isOpen(lvl, level.HOLLOWS);
    if underground { tileChoice = 2; }
    let ghostly = e.endless && !underground && e.rng.unit() < ENDLESS_GHOSTS;
    if tileChoice < 0 { return; }
    let tries = 0;
    let limit = 12;
    if replacing { limit = 24; }
    let hug = false;
    while tries < limit {
        hug = replacing || (!underground && (e.endless || (challenge.on(challenge.HORDE) && e.rng.unit() < HORDE_NEAR) || (e.lvl > LATE_LEVEL && e.rng.unit() < LATE_NEAR)));
        let at = Vec3.xyz(0 - level.HALF + f32(tileChoice % 3) * level.TILE + 3 + e.rng.unit() * (level.TILE - 6), 14,
            0 - level.HALF + f32(tileChoice / 3) * level.TILE + 3 + e.rng.unit() * (level.TILE - 6));
        if hug {
            let a = e.rng.unit() * TAU;
            let r = 12 + e.rng.unit() * 10;
            at = Vec3.xyz(p.pos.x + cos(a) * r, 14, p.pos.z + sin(a) * r);
        }
        let k = kind;
        let zone = -1;
        let tile = tileAt(at.x, at.z);
        if tile != HUB && e.rng.unit() < ZONE_CHANCE {
            zone = tile;
            k = zoneKind(tile);
        }
        if ghostly { k = GHOST; zone = -1; }
        // The beach: some of its own are puffers, which spawn under the water.
        if zone >= 0 && !underground && level.biomeAt(zone) == 11 && e.rng.unit() < 0.4 { k = PUFFER; }
        if k == PUFFER {
            let surf = level.waterSurface(lvl, at.x, at.z);
            if surf > -900 { at.y = surf - 1.5 - e.rng.unit() * 2; } else { k = zoneKind(zone); }
        }
        if k == DRONE || k == BOMBER || k == GHOST || k == SKULL { at.y = 6 + e.rng.unit() * 5; }
        if underground {
            let caveRoll = int(e.rng.unit() * 4);
            k = DRONE;
            if caveRoll == 2 { k = ZIPPER; }
            if caveRoll == 3 { k = HOPPER; }
            zone = level.HOLLOWS;
            let caveAngle = e.rng.unit() * TAU;
            let caveRange = 22 + e.rng.unit() * 40;
            at.x = clamp(p.pos.x + cos(caveAngle) * caveRange, level.CAVE_X0 + 10, level.CAVE_X1 - 10);
            at.z = clamp(p.pos.z + sin(caveAngle) * caveRange, level.CAVE_Z0 + 10, level.CAVE_Z1 - 10);
            at.y = -54;
            if k == DRONE { at.y = -47; }
        }
        let dx = at.x - p.pos.x;
        let dz = at.z - p.pos.z;
        let d2 = dx * dx + dz * dz;
        let farEnough = d2 > 400 && (near < 48 || d2 >= 3600);
        if hug { farEnough = d2 > 144 && d2 < 484; }
        // Sea creatures start in water, everything else on dry ground.
        let wet = level.waterSurface(lvl, at.x, at.z) > -900;
        let footing = false;
        if k == PUFFER { footing = wet; } else { footing = !wet && floorUnder(lvl, at.x, at.z, at.y); }
        if farEnough && (underground || openAt(lvl, at.x, at.z)) && solid(lvl, at, size(k)) < 0 && footing {
            // spawnAt takes the first free slot too: `slot`.
            if spawnAt(e, k, at, Vec3.zero(), false) {
                if zone >= 0 {
                    e.list[slot].zone = zone;
                    e.list[slot].hp = health(k) * ZONE_HP * foeMul();
                }
                if !e.list[slot].cave && k <= BOMBER { rollElite(e, &e.list[slot]); }
            }
            return;
        }
        tries += 1;
    }
}

/// The farthest ordinary enemy at any distance, or -1. Shrine and shell ones stay.
fn evict(e: &Enemies, p: &Player): int {
    let best = -1;
    let bestD: f32 = -1;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 && !en.gold && !en.miniGeode {
            let d = en.pos - p.pos;
            let dd = d.x * d.x + d.z * d.z;
            if dd > bestD { best = i; bestD = dd; }
        }
        i += 1;
    }
    return best;
}

/// Endgame: every HORDE_EVERY seconds (call only while the horde is due and no boss is up), a
/// scatter of enemies drops in around you, most of them this biome's own kind.
pub fn horde(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    if challenge.on(challenge.RUSH) { return; }
    e.hordeT -= dt;
    if e.hordeT > 0 { return; }
    e.hordeT = HORDE_EVERY;
    // Underground has its own roster: skip this one.
    if level.inHollows(p.pos) { return; }
    let home = tileAt(p.pos.x, p.pos.z);
    let n = e.rng.intRange(HORDE_MIN, HORDE_MAX + 1);
    let placed = 0;
    let tries = 0;
    while placed < n && tries < n * 6 {
        tries += 1;
        let a = e.rng.unit() * TAU;
        let r = 12 + e.rng.unit() * 22;
        let at = Vec3.xyz(p.pos.x + cos(a) * r, 14, p.pos.z + sin(a) * r);
        let k = pickKind(e);
        let zone = -1;
        if home != HUB && home >= 0 && e.rng.unit() < HORDE_SPECIAL {
            zone = home;
            k = zoneKind(home);
        }
        // Every horde carries one flag bearer.
        if placed == 0 { k = FLAG; zone = -1; }
        if k == DRONE || k == BOMBER || k == SKULL { at.y = 6 + e.rng.unit() * 5; }
        if openAt(lvl, at.x, at.z) && solid(lvl, at, size(k)) < 0 && floorUnder(lvl, at.x, at.z, at.y) && level.waterSurface(lvl, at.x, at.z) < -900 {
            let slot = room(e, p);
            if slot < 0 { return; }
            if !spawnAt(e, k, at, Vec3.zero(), false) { return; }
            // Woken at once: they were dropped to come for you.
            e.list[slot].wakeT = 3;
            if zone >= 0 {
                e.list[slot].zone = zone;
                e.list[slot].hp = health(k) * ZONE_HP * foeMul();
            }
            placed += 1;
        }
    }
}

/// One enemy of `kind` at `at` moving at `vel`; `gold` ones come from shrines. False when full.
pub fn spawnAt(e: &Enemies, kind: int, at: Vec3, vel: Vec3, gold: bool): bool {
    if !gold && alive(e) >= MAX_ENEMIES - GOLD_ROOM { return false; }
    let slot = 0;
    while slot < MAX_ENEMIES && e.list[slot].kind != 0 { slot += 1; }
    if slot == MAX_ENEMIES { return false; }
    let hp = health(kind) * foeMul();
    if gold { hp = hp * GOLD_HP; }
    e.list[slot] = Enemy {
        kind: kind, pos: at, vel: vel, hp: hp, t: 1 + e.rng.unit(), flash: 0,
        phase: e.rng.unit() * TAU, grounded: false, squash: 1, gold: gold, zone: -1,
    };
    if level.inHollows(at) && kind <= BOMBER {
        let caveEnemy = &e.list[slot];
        caveEnemy.cave = true;
        caveEnemy.zone = level.HOLLOWS;
        if kind == BOMBER { caveEnemy.kind = DRONE; }
        if kind == CHARGER { caveEnemy.kind = ZIPPER; }
    }
    // Bombers get to circle a while before the first dive.
    if kind == BOMBER { e.list[slot].t = 3 + e.rng.unit() * 2; }
    if !gold && kind != METEOR && (level_diff == DEATH || e.rng.unit() < MOD_CHANCE * foeOdds()) { e.list[slot].mod = 1 + e.rng.intRange(0, MODS); }
    // Zippers are what split spawns, so they never split themselves.
    if kind == ZIPPER && e.list[slot].mod == MOD_SPLIT { e.list[slot].mod = 0; }
    burst(e, at, Vec3.xyz(1, 1, 1), 10, 5);
    return true;
}

/// Shell fragments take priority over an ordinary ambient spawn when the pool is full.
pub fn spawnGeode(e: &Enemies, at: Vec3, velocity: Vec3) {
    let slot = 0;
    while slot < MAX_ENEMIES && e.list[slot].kind != 0 { slot += 1; }
    if slot == MAX_ENEMIES {
        let farthest: f32 = -1;
        let i = 0;
        while i < MAX_ENEMIES {
            if !e.list[i].gold && !e.list[i].miniGeode {
                let distance = (e.list[i].pos - at).length();
                if distance > farthest { slot = i; farthest = distance; }
            }
            i += 1;
        }
    }
    if slot == MAX_ENEMIES { return; }
    e.list[slot] = Enemy { kind: ZIPPER, pos: at, vel: velocity, hp: 30,
        t: 0.45, flash: 0, phase: 0, grounded: false, squash: 1,
        gold: false, zone: level.HOLLOWS, cave: true, miniGeode: true, hopT: 0.8 + e.rng.unit() * 1.4, active: true, wakeT: 3 };
}

fn miniGeode(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    let was = en.pos;
    en.vel.y -= GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    en.phase += (en.pos - was).length() / 0.45;
    en.hopT -= dt;
    en.t -= dt;
    let dir = toward(en, p);
    // Preserve the initial chip-out impulse before rolling after the player.
    if en.t <= 0 {
        en.vel.x += (dir.x * 12 - en.vel.x) * min(dt * 5, 1);
        en.vel.z += (dir.z * 12 - en.vel.z) * min(dt * 5, 1);
        if en.grounded && (en.hopT <= 0 || p.pos.y > en.pos.y + 1.5) {
            en.vel.y = 8 + e.rng.unit() * 4 + clamp(p.pos.y - en.pos.y, 0, 12);
            en.grounded = false;
            en.hopT = 1.2 + e.rng.unit() * 2;
        }
    }
    touch(en, p, 0.95, 7, 4);
}

/// Shield mini-boss: an armoured walker behind a small energy shield that lags as you circle it.
fn shieldBody(e: &Enemies, en: Enemy, base: Mat4, yaw: f32, tint: Vec3, glow: Vec3) {
    let hit = en.flash > 0;
    let armor = Vec3.xyz(0.36, 0.42, 0.58);
    let dark = Vec3.xyz(0.14, 0.16, 0.24);
    let plate = Vec3.xyz(0.24, 0.3, 0.46);
    let gold = Vec3.xyz(0.95, 0.75, 0.25);
    if hit { armor = tint; dark = tint; plate = tint; gold = tint; }
    let cyan = Vec3.xyz(0.35, 1.2, 2.0);
    let stride = sin(en.phase * 3) * 0.22;
    let bob = abs(sin(en.phase * 3)) * 0.05;
    base = base.mul(Mat4.translate(0, bob, 0)).mul(Mat4.scale(SHIELD_SCALE, SHIELD_SCALE, SHIELD_SCALE));
    // Legs and boots, hips.
    let side = -1;
    while side <= 1 {
        let sx = f32(side);
        hull(e, base, Vec3.xyz(sx * 0.34, -0.5, stride * sx), Vec3.xyz(0.4, 0.72, 0.46));
        cube(e, base, Vec3.xyz(sx * 0.34, -0.5, stride * sx), Vec3.xyz(0.4, 0.72, 0.46), dark, glow);
        cube(e, base, Vec3.xyz(sx * 0.34, -0.8, stride * sx - 0.05), Vec3.xyz(0.44, 0.2, 0.58), armor, glow);
        side += 2;
    }
    cube(e, base, Vec3.xyz(0, -0.12, 0), Vec3.xyz(0.92, 0.22, 0.6), dark, glow);
    // Torso, belt, chest gem.
    hull(e, base, Vec3.xyz(0, 0.26, 0), Vec3.xyz(1.15, 0.8, 0.78));
    cube(e, base, Vec3.xyz(0, 0.26, 0), Vec3.xyz(1.15, 0.8, 0.78), armor, glow);
    cube(e, base, Vec3.xyz(0, 0.0, 0), Vec3.xyz(1.18, 0.08, 0.8), gold, glow);
    cube(e, base, Vec3.xyz(0, 0.34, -0.4), Vec3.xyz(0.26, 0.26, 0.04), dark, cyan * 1.2);
    // Head with a glowing visor, and spiked pauldrons.
    hull(e, base, Vec3.xyz(0, 0.88, 0), Vec3.xyz(0.52, 0.46, 0.5));
    cube(e, base, Vec3.xyz(0, 0.88, 0), Vec3.xyz(0.52, 0.46, 0.5), armor, glow);
    cube(e, base, Vec3.xyz(0, 0.9, -0.26), Vec3.xyz(0.4, 0.09, 0.04), dark, cyan * 1.6);
    cube(e, base, Vec3.xyz(0, 1.18, 0.02), Vec3.xyz(0.1, 0.16, 0.34), gold, glow);
    side = -1;
    while side <= 1 {
        let px = f32(side);
        cube(e, base, Vec3.xyz(px * 0.72, 0.6, 0), Vec3.xyz(0.42, 0.3, 0.6), armor, glow);
        cube(e, base, Vec3.xyz(px * 0.72, 0.82, 0), Vec3.xyz(0.1, 0.3, 0.1), gold, glow);
        side += 2;
    }
    // The free arm hangs with a fist.
    cube(e, base, Vec3.xyz(0.72, 0.16, -0.05), Vec3.xyz(0.3, 0.7, 0.3), dark, glow);
    cube(e, base, Vec3.xyz(0.72, -0.24, -0.16), Vec3.xyz(0.36, 0.34, 0.36), armor, glow);
    // The shield turns on its own, apart from the body, which always faces you.
    let sb = base.mul(Mat4.rotate(Vec3.xyz(0, 1, 0), en.aim - yaw));
    cube(e, sb, Vec3.xyz(0, 0.18, -0.72), Vec3.xyz(0.24, 0.24, 0.7), dark, glow);
    // Energy lattice, open between the bars so you can see through it.
    cube(e, sb, Vec3.xyz(0, 0.98, -1.1), Vec3.xyz(1.62, 0.1, 0.2), gold, glow);
    cube(e, sb, Vec3.xyz(0, -0.62, -1.1), Vec3.xyz(1.62, 0.1, 0.2), gold, glow);
    cube(e, sb, Vec3.xyz(-0.8, 0.18, -1.1), Vec3.xyz(0.1, 1.6, 0.2), gold, glow);
    cube(e, sb, Vec3.xyz(0.8, 0.18, -1.1), Vec3.xyz(0.1, 1.6, 0.2), gold, glow);
    let pulse = 0.75 + 0.25 * sin(e.clock * 4 + en.phase);
    let saved = e.cast;
    e.cast = false;
    let bar = -1;
    while bar <= 1 {
        let off = f32(bar) * 0.4;
        cube(e, sb, Vec3.xyz(off, 0.18, -1.2), Vec3.xyz(0.05, 1.5, 0.03), Vec3.xyz(0.3, 0.6, 0.9), cyan * (0.6 * pulse));
        cube(e, sb, Vec3.xyz(0, 0.18 + off * 1.3, -1.2), Vec3.xyz(1.5, 0.05, 0.03), Vec3.xyz(0.3, 0.6, 0.9), cyan * (0.6 * pulse));
        bar += 1;
    }
    e.cast = saved;
    let emblem = sb.mul(Mat4.translate(0, 0.18, -1.23)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), 0.785));
    cube(e, emblem, Vec3.zero(), Vec3.xyz(0.42, 0.42, 0.05), gold, Vec3.xyz(2.4, 1.6, 0.4) * pulse);
    cube(e, emblem, Vec3.xyz(0, 0, -0.02), Vec3.xyz(0.2, 0.2, 0.05), dark, cyan * 1.5);
}

/// Flag bearer: a hooded runner with a white banner on a pole that flaps as it moves.
fn bearerBody(e: &Enemies, en: Enemy, base: Mat4, tint: Vec3, glow: Vec3) {
    let hit = en.flash > 0;
    let cloth = Vec3.xyz(0.42, 0.14, 0.5);
    let dark = Vec3.xyz(0.12, 0.08, 0.16);
    let white = Vec3.xyz(1, 1, 1);
    let wood = Vec3.xyz(0.4, 0.28, 0.18);
    let gold = Vec3.xyz(1, 0.8, 0.3);
    let red = Vec3.xyz(0.95, 0.1, 0.18);
    if hit { cloth = tint; dark = tint; wood = tint; gold = tint; red = tint; white = tint; }
    let stride = sin(en.phase * 4) * 0.16;
    let bob = abs(sin(en.phase * 4)) * 0.05;
    base = base.mul(Mat4.translate(0, bob, 0));
    let side = -1;
    while side <= 1 {
        let sx = f32(side);
        cube(e, base, Vec3.xyz(sx * 0.15, -0.25, stride * sx), Vec3.xyz(0.17, 0.42, 0.2), dark, glow);
        side += 2;
    }
    hull(e, base, Vec3.xyz(0, 0.2, 0), Vec3.xyz(0.52, 0.5, 0.34));
    cube(e, base, Vec3.xyz(0, 0.2, 0), Vec3.xyz(0.52, 0.5, 0.34), cloth, glow);
    cube(e, base, Vec3.xyz(0, 0.08, 0.2), Vec3.xyz(0.46, 0.6, 0.05), dark, glow);
    hull(e, base, Vec3.xyz(0, 0.6, 0), Vec3.xyz(0.34, 0.3, 0.3));
    cube(e, base, Vec3.xyz(0, 0.6, 0), Vec3.xyz(0.34, 0.3, 0.3), cloth, glow);
    cube(e, base, Vec3.xyz(0, 0.8, 0.04), Vec3.xyz(0.2, 0.16, 0.2), dark, glow);
    cube(e, base, Vec3.xyz(-0.08, 0.62, -0.16), Vec3.xyz(0.07, 0.06, 0.03), dark, red * 3);
    cube(e, base, Vec3.xyz(0.08, 0.62, -0.16), Vec3.xyz(0.07, 0.06, 0.03), dark, red * 3);
    // A tall pole on the back with a plain white banner streaming off it in a wave.
    cube(e, base, Vec3.xyz(0.24, 1.5, 0.18), Vec3.xyz(0.05, 3.2, 0.05), wood, glow);
    let j = 0;
    while j < 5 {
        let f = f32(j);
        let wave = sin(e.clock * 7 - f * 1.0 + en.phase) * 0.06 * (f + 1) * 0.6;
        cube(e, base, Vec3.xyz(0.34 + f * 0.17, 2.7 - f * 0.03, 0.18 + wave), Vec3.xyz(0.19, 0.7 - f * 0.07, 0.03), white, white * 0.6 + glow);
        j += 1;
    }
}

/// Meteor: a tumbling fireball on its way down with a marker on the ground, then a lodged
/// half-buried rock, cracked with glowing seams, in a scorched patch.
fn meteorBody(e: &Enemies, en: Enemy, tint: Vec3) {
    let rock = Vec3.xyz(0.2, 0.14, 0.12);
    if en.flash > 0 { rock = tint; }
    let ember = Vec3.xyz(2.4, 0.8, 0.12);
    if !en.grounded {
        // Marker: an outer ring, a ring shrinking to the impact, and a cross, all on the ground.
        let late = 1 - clamp(en.t / METEOR_WARN, 0, 1);
        let glowMark = Vec3.xyz(2.4, 0.25, 0.1) * (0.8 + late);
        let red = Vec3.xyz(0.9, 0.12, 0.08);
        let at = Mat4.translate(en.pos.x, en.groundY + 0.08, en.pos.z);
        let saved = e.owner;
        e.owner = -1;
        e.cast = false;
        let n = 24;
        let k = 0;
        while k < n {
            let a = f32(k) * TAU / f32(n);
            let seg = at.mul(Mat4.translate(cos(a) * METEOR_BLAST, 0, sin(a) * METEOR_BLAST)).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0 - (a + PI * 0.5)));
            cube(e, seg, Vec3.zero(), Vec3.xyz(1.65, 0.05, 0.24), red, glowMark);
            k += 1;
        }
        let inner = METEOR_BLAST * clamp(en.t / METEOR_WARN, 0.05, 1);
        k = 0;
        while k < 16 {
            let b = f32(k) * TAU / 16;
            let seg2 = at.mul(Mat4.translate(cos(b) * inner, 0, sin(b) * inner)).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0 - (b + PI * 0.5)));
            cube(e, seg2, Vec3.zero(), Vec3.xyz(inner * 0.4, 0.05, 0.16), red, glowMark);
            k += 1;
        }
        cube(e, at, Vec3.zero(), Vec3.xyz(METEOR_BLAST * 1.7, 0.05, 0.14), red, glowMark);
        cube(e, at.mul(Mat4.rotate(Vec3.xyz(0, 1, 0), PI * 0.5)), Vec3.zero(), Vec3.xyz(METEOR_BLAST * 1.7, 0.05, 0.14), red, glowMark);
        e.owner = saved;
        e.cast = true;
        // The rock: a spinning core with chunks, trailing flames straight up behind it.
        let spin = Mat4.translate(en.pos.x, en.pos.y, en.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 0.6, 0.3).normalize(), e.clock * 3 + en.phase));
        hull(e, spin, Vec3.zero(), Vec3.xyz(1.6, 1.6, 1.6));
        cube(e, spin, Vec3.zero(), Vec3.xyz(1.6, 1.6, 1.6), rock, ember * 0.6);
        cube(e, spin, Vec3.xyz(0.7, 0.3, 0.2), Vec3.xyz(0.8, 0.9, 0.8), rock, ember * 0.9);
        cube(e, spin, Vec3.xyz(-0.6, -0.4, 0.3), Vec3.xyz(0.9, 0.7, 0.8), rock, ember * 0.8);
        cube(e, spin, Vec3.xyz(0.1, 0.7, -0.6), Vec3.xyz(0.7, 0.7, 0.7), rock, ember);
        k = 0;
        e.cast = false;
        while k < 6 {
            let f = f32(k);
            let w = 1.3 - f * 0.2;
            let lick = sin(e.clock * 20 + f * 2) * 0.12;
            let flame = Mat4.translate(en.pos.x + lick, en.pos.y + 1.1 + f * 0.85, en.pos.z - lick);
            let hot = Vec3.xyz(2.6, 1.6 - f * 0.22, 0.2);
            cube(e, flame, Vec3.zero(), Vec3.xyz(w, 0.9, w), Vec3.xyz(1, 0.5, 0.1), hot);
            k += 1;
        }
        e.cast = true;
        return;
    }
    // Lodged: tilted rock in a scorched patch, seams pulsing.
    let wave = en.hopT / METEOR_WAVE;
    if wave > 0 {
        // Shockwave: a ring racing outward on the ground and a column of light, both fading.
        let spread = 1 - wave;
        let radius = METEOR_BLAST * (0.25 + 1.15 * spread);
        let fade = Vec3.xyz(3, 1.5, 0.3) * wave;
        let ground = Mat4.translate(en.pos.x, en.groundY + 0.12, en.pos.z);
        e.cast = false;
        let r = 0;
        while r < 32 {
            let q = f32(r) * TAU / 32;
            let part = ground.mul(Mat4.translate(cos(q) * radius, 0, sin(q) * radius)).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0 - (q + PI * 0.5)));
            cube(e, part, Vec3.zero(), Vec3.xyz(radius * 0.22, 0.1 + wave * 0.5, 0.3 + wave * 0.5), Vec3.xyz(1, 0.6, 0.2), fade);
            r += 1;
        }
        let column = 0.4 + wave * 1.6;
        cube(e, ground, Vec3.xyz(0, wave * 7, 0), Vec3.xyz(column, wave * 14, column), Vec3.xyz(1, 0.8, 0.4), Vec3.xyz(3.5, 2.4, 0.8) * wave);
        e.cast = true;
    }
    let seam = ember * (0.55 + 0.25 * sin(e.clock * 2.5 + en.phase) + wave * 3);
    if en.flash > 0 { seam = tint; }
    let lodge = Mat4.translate(en.pos.x, en.pos.y, en.pos.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), en.phase))
        .mul(Mat4.rotate(Vec3.xyz(1, 0, 0.4).normalize(), 0.4));
    hull(e, lodge, Vec3.zero(), Vec3.xyz(1.8, 1.5, 1.8));
    cube(e, lodge, Vec3.zero(), Vec3.xyz(1.8, 1.5, 1.8), rock, seam * 0.25);
    cube(e, lodge, Vec3.xyz(0.5, 0.55, -0.2), Vec3.xyz(1, 1, 1), rock, seam * 0.3);
    cube(e, lodge, Vec3.xyz(-0.55, 0.3, 0.35), Vec3.xyz(0.8, 1.1, 0.8), rock, seam * 0.3);
    cube(e, lodge, Vec3.xyz(0.05, 0.9, 0.1), Vec3.xyz(0.7, 0.6, 0.7), rock, seam * 0.3);
    // Glowing cracks over the faces.
    cube(e, lodge, Vec3.xyz(0, 0.2, -0.91), Vec3.xyz(0.12, 1.1, 0.03), Vec3.zero(), seam);
    cube(e, lodge, Vec3.xyz(0.3, 0.45, -0.92), Vec3.xyz(0.5, 0.1, 0.03), Vec3.zero(), seam);
    cube(e, lodge, Vec3.xyz(0.91, 0.1, 0.1), Vec3.xyz(0.03, 0.9, 0.12), Vec3.zero(), seam);
    cube(e, lodge, Vec3.xyz(-0.9, 0.2, -0.2), Vec3.xyz(0.03, 0.12, 0.8), Vec3.zero(), seam);
    cube(e, lodge, Vec3.xyz(0.1, 1.2, 0.1), Vec3.xyz(0.5, 0.05, 0.12), Vec3.zero(), seam);
    e.cast = false;
    let m = 0;
    while m < 8 {
        let c = f32(m) * TAU / 8 + en.phase;
        let patch = Mat4.translate(en.pos.x + cos(c) * 2.1, en.groundY + 0.04, en.pos.z + sin(c) * 2.1).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0 - c));
        cube(e, patch, Vec3.zero(), Vec3.xyz(1.2, 0.04, 1.7), Vec3.xyz(0.05, 0.04, 0.04), Vec3.zero());
        m += 1;
    }
    e.cast = true;
}

fn miniGeodeBody(e: &Enemies, en: Enemy, base: Mat4, tint: Vec3, glow: Vec3) {
    let spin = base.mul(Mat4.rotate(Vec3.xyz(1, 0, 0), en.phase));
    cube(e, spin, Vec3.zero(), Vec3.xyz(0.52, 0.7, 0.52), Vec3.xyz(0.3, 0.85, 1), Vec3.xyz(0.15, 1.4, 1.8) + glow);
    let slab = 0;
    while slab < 6 {
        let a = f32(slab) * TAU / 6;
        let ring = spin.mul(Mat4.rotate(Vec3.xyz(0.4, 1, 0.3).normalize(), a));
        cube(e, ring, Vec3.xyz(0.3, 0, 0), Vec3.xyz(0.38, 0.48, 0.42), if en.flash > 0 { tint } else { Vec3.xyz(0.48, 0.5, 0.55) }, glow);
        slab += 1;
    }
}

/// Each biome's own enemy: the body it borrows.
fn zoneKind(slot: int): int {
    let t = level.biomeAt(slot);
    if t == 11 { return CRAB; }
    if t == 12 { return FROG; }
    if t == 13 { return SKULL; }
    if t == 14 { return CHICKEN; }
    if t == 0 || t == 3 { return ZIPPER; }
    if t == 1 || t == 6 { return CHARGER; }
    if t == 5 { return DRONE; }
    if t == 8 { return BOMBER; }
    return HOPPER;
}

/// Its body colour and the glow of its outline and crystal.
fn zoneTint(slot: int): Vec3 {
    let t = level.biomeAt(slot);
    if t == 11 { return Vec3.xyz(1, 0.45, 0.35); }
    if t == 12 { return Vec3.xyz(0.4, 0.85, 0.3); }
    if t == 13 { return Vec3.xyz(0.92, 0.9, 0.8); }
    if t == 14 { return Vec3.xyz(1, 0.97, 0.9); }
    if t == 0 { return Vec3.xyz(0.85, 0.95, 1); }
    if t == 1 { return Vec3.xyz(0.35, 0.7, 0.3); }
    if t == 2 { return Vec3.xyz(0.25, 0.2, 0.22); }
    if t == 3 { return Vec3.xyz(0.95, 0.7, 0.4); }
    if t == 5 { return Vec3.xyz(1, 0.4, 0.85); }
    if t == 6 { return Vec3.xyz(0.9, 0.87, 0.78); }
    if t == 7 { return Vec3.xyz(0.3, 0.5, 0.25); }
    return Vec3.xyz(0.95, 0.97, 1);
}

fn zoneGlow(slot: int): Vec3 {
    let t = level.biomeAt(slot);
    if t == 11 { return Vec3.xyz(2.6, 1.0, 0.6); }
    if t == 12 { return Vec3.xyz(0.7, 2.4, 0.5); }
    if t == 13 { return Vec3.xyz(2.4, 1.3, 0.4); }
    if t == 14 { return Vec3.xyz(2.6, 1.0, 0.3); }
    if t == 0 { return Vec3.xyz(0.6, 1.6, 2.6); }
    if t == 1 { return Vec3.xyz(0.8, 2.2, 0.5); }
    if t == 2 { return Vec3.xyz(2.8, 0.9, 0.1); }
    if t == 3 { return Vec3.xyz(2.4, 1.2, 0.4); }
    if t == 5 { return Vec3.xyz(2.6, 0.5, 2.4); }
    if t == 6 { return Vec3.xyz(1.8, 1.7, 1.2); }
    if t == 7 { return Vec3.xyz(1.2, 2.4, 0.4); }
    return Vec3.xyz(0.8, 1.2, 2.8);
}

/// A ground kind for a shrine's gold batch.
pub fn groundKind(e: &Enemies): int {
    let u = e.rng.unit();
    if u < 0.15 { return CHARGER; }
    if u < 0.5 { return ZIPPER; }
    return HOPPER;
}

/// Gold enemies still alive.
pub fn golds(e: &Enemies): int {
    let n = 0;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 && e.list[i].gold { n += 1; }
        i += 1;
    }
    return n;
}

/// The nearest enemy within `range` of `at`, or -1.
pub fn nearest(e: &Enemies, at: Vec3, range: f32): int {
    let best = -1;
    let bestD = range * range;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 {
            let d = e.list[i].pos - at;
            let dd = d.dot(d);
            if dd < bestD {
                best = i;
                bestD = dd;
            }
        }
        i += 1;
    }
    return best;
}

/// An explosion: every enemy within `radius` takes `dmg`, less toward the edge, and is thrown
/// out by up to `shove`.
pub fn blast(e: &Enemies, at: Vec3, radius: f32, dmg: f32, tint: Vec3, shove: f32) {
    burst(e, at, tint, int(radius * 6), radius * 2.6);
    burst(e, at, Vec3.xyz(1, 1, 0.8), int(radius * 3), radius * 1.6);
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 {
            let d = en.pos - at;
            let far = d.length();
            if far < radius {
                let k = 1 - far / radius * 0.6;
                damage(e, i, dmg * k, d.normalize() * (shove * k) + Vec3.xyz(0, shove * 0.4 * k, 0), en.pos);
            }
        }
        i += 1;
    }
}

/// Debris for a hit on something that isn't an enemy (a shrine).
/// One flame puff flying out along `vel`, floating up as it goes.
pub fn flameBit(e: &Enemies, at: Vec3, vel: Vec3, tint: Vec3, life: f32, size: f32) {
    let off = at - e.listener;
    if off.dot(off) > 3600 || e.effectsLeft < 1 || e.tokens < 1 { return; }
    e.effectsLeft -= 1;
    e.tokens -= 1;
    e.bits[e.nextBit] = Bit { pos: at, vel: vel, t: life, size: size, color: tint, lift: 1.25, life: life };
    e.nextBit = (e.nextBit + 1) % MAX_BITS;
}

pub fn sparks(e: &Enemies, at: Vec3, tint: Vec3, n: int, speed: f32) {
    burst(e, at, tint, n, speed);
}

/// Move with the level's boxes in the way. Returns true on landing on something. Walkers
/// that run into a wall climb it instead of bouncing off.
fn moveBody(en: &Enemy, lvl: &Level, dt: f32): bool {
    let half = size(en.kind) * 0.5;
    let d = en.vel * dt;
    d.x = d.x * foeSpeed();
    d.z = d.z * foeSpeed();
    if en.gold {
        d.x = d.x * GOLD_SPEED;
        d.z = d.z * GOLD_SPEED;
    }
    if en.buff {
        d.x = d.x * BUFF_SPEED;
        d.z = d.z * BUFF_SPEED;
    }
    if en.mod != 0 {
        d.x = d.x * modSpeed(en);
        d.z = d.z * modSpeed(en);
    }
    let walker = en.kind != DRONE && en.kind != BOMBER && en.kind != PUFFER && en.kind != SKULL;
    let perched = en.perch;
    en.perch = false;
    let steps = 1 + int(d.length() / 0.25);
    let part = d * (1 / f32(steps));
    let landed = false;
    let climb = false;
    let s = 0;
    while s < steps {
        en.pos.x = en.pos.x + part.x;
        if solid(lvl, en.pos, half) >= 0 {
            en.pos.x = en.pos.x - part.x;
            if walker { climb = true; } else { en.vel.x = en.vel.x * -0.3; }
        }
        en.pos.z = en.pos.z + part.z;
        if solid(lvl, en.pos, half) >= 0 {
            en.pos.z = en.pos.z - part.z;
            if walker { climb = true; } else { en.vel.z = en.vel.z * -0.3; }
        }
        en.pos.y = en.pos.y + part.y;
        let b = solid(lvl, en.pos, half);
        if b >= 0 {
            if part.y < 0 {
                en.pos.y = lvl.boxes[b].hi.y + half;
                landed = true;
            } else {
                en.pos.y = en.pos.y - part.y;
            }
            en.vel.y = 0;
        }
        s += 1;
    }
    if climb { en.vel.y = max(en.vel.y, CLIMB); }
    return landed || perched;
}

fn hopper(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    let was = en.grounded;
    en.grounded = moveBody(en, lvl, dt);
    if en.grounded && !was { en.squash = 0.6; }
    if en.grounded {
        en.vel.x = en.vel.x * max(1 - dt * 10, 0);
        en.vel.z = en.vel.z * max(1 - dt * 10, 0);
        en.t = en.t - dt;
        if en.t <= 0 {
            // Leap at the player, higher when they're up on something.
            let to = Vec3.xyz(p.pos.x - en.pos.x, 0, p.pos.z - en.pos.z);
            let far = to.length();
            let dir = to.normalize();
            let reach = min(far * 0.9, HOPPER_HOP + f32(mini(e.tier, 10)) * 0.4);
            en.vel.x = dir.x * reach;
            en.vel.z = dir.z * reach;
            en.vel.y = 7 + clamp(p.pos.y - en.pos.y, 0, 9) * 0.9;
            en.grounded = false;
            en.squash = 1.35;
            en.t = 0.5 + e.rng.unit() * 0.5;
        }
    }
    en.squash = en.squash + (1 - en.squash) * min(dt * 10, 1);
    touch(en, p, 1.2, HOPPER_HIT, 10);
}

/// Contact within `reach` of the player's middle: a hit and a shove away. True on a hit.
fn touch(en: &Enemy, p: &Player, reach: f32, dmg: f32, shove: f32): bool {
    let off = p.pos + Vec3.xyz(0, 0.9, 0) - en.pos;
    if off.length() >= reach { return false; }
    let away = Vec3.xyz(off.x, 0, off.z).normalize();
    // Parried: it bounces off instead.
    if p.parryT > 0 {
        if en.parryCd > 0 { return false; }
        en.parryCd = PARRY_AGAIN;
        en.vel = Vec3.xyz(0 - away.x * 18, 7, 0 - away.z * 18);
        en.flash = 0.22;
        en.wakeT = 3;
        en.riposte = RIPOSTE_DELAY;
        en.riposteDmg = RIPOSTE_DAMAGE * (1 + p.stats.damage);
        p.parried = true;
        return false;
    }
    let attack = dmg;
    if en.buff { attack = dmg * BUFF_ATTACK; }
    return hurt(p, attack * foeMul(), away * shove + Vec3.xyz(0, shove * 0.5, 0));
}

/// Flat direction from `en` to the player.
fn toward(en: &Enemy, p: &Player): Vec3 {
    return Vec3.xyz(p.pos.x - en.pos.x, 0, p.pos.z - en.pos.z).normalize();
}

/// Runs straight at you, weaving, and hops anything that stops it.
fn zipper(en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    en.phase = en.phase + dt * 7;
    let dir = toward(en, p);
    let side = Vec3.xyz(0 - dir.z, 0, dir.x) * (sin(en.phase) * 0.6);
    let goal = (dir + side) * ZIPPER_RUN;
    let k = min(dt * 6, 1);
    en.vel.x = en.vel.x + (goal.x - en.vel.x) * k;
    en.vel.z = en.vel.z + (goal.z - en.vel.z) * k;
    // Stuck on something, or you're above it: hop.
    let flat = Vec3.xyz(en.vel.x, 0, en.vel.z).length();
    if en.grounded && (flat < ZIPPER_RUN * 0.4 || p.pos.y > en.pos.y + 2) {
        en.vel.y = 8 + clamp(p.pos.y - en.pos.y, 0, 8);
        en.grounded = false;
    }
    touch(en, p, 0.9, ZIPPER_HIT, 6);
}

/// Plods toward you, winds up (glows) and rushes in a straight line.
fn charger(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    if en.phase > 0 {
        en.phase = en.phase - dt;
        // Stopped dead by a wall: the rush is over.
        if Vec3.xyz(en.vel.x, 0, en.vel.z).length() < CHARGER_RUSH * 0.3 { en.phase = 0; }
    } else {
        let dir = toward(en, p);
        let walk = CHARGER_WALK;
        if en.t < 0.6 { walk = 0; }
        let k = min(dt * 4, 1);
        en.vel.x = en.vel.x + (dir.x * walk - en.vel.x) * k;
        en.vel.z = en.vel.z + (dir.z * walk - en.vel.z) * k;
        if en.grounded { en.t = en.t - dt; }
        if en.t <= 0 {
            en.vel.x = dir.x * CHARGER_RUSH;
            en.vel.z = dir.z * CHARGER_RUSH;
            en.phase = 1.1;
            en.t = 2.2 + e.rng.unit() * 1.5;
        }
    }
    touch(en, p, 1.7, CHARGER_HIT, 16);
}

/// Hovers high above you, then dives and blows up on whatever it hits.
/// Ease a flyer's velocity toward `goal`, no faster than `speed` across and `climb` up or down.
fn hover(en: &Enemy, goal: Vec3, speed: f32, climb: f32, dt: f32) {
    let d = goal - en.pos;
    let flat = Vec3.xyz(d.x, 0, d.z);
    let want = flat.normalize() * min(flat.length() * 0.6, speed);
    want.y = clamp(d.y * 0.6, 0 - climb, climb);
    en.vel = en.vel + (want - en.vel) * min(dt * 2, 1);
}

/// Endless mode: floats straight at you at chest height, faster than you'd like, and rams.
fn ghost(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    hover(en, p.pos + Vec3.xyz(0, 1.2, 0), GHOST_SPEED, GHOST_CLIMB, dt);
    moveBody(en, lvl, dt);
    en.phase += dt;
    // Ectoplasm: green wisps shed off the body and drift up.
    if e.cosmetic.unit() < dt * 20 {
        let off = Vec3.xyz(e.cosmetic.unit() - 0.5, e.cosmetic.unit() - 0.4, e.cosmetic.unit() - 0.5) * GHOST_SIZE * 1.3;
        flameBit(e, en.pos + off, en.vel * 0.2 + Vec3.xyz(0, 0.6, 0), Vec3.xyz(0.25, 1, 0.55), 0.7, 0.16);
    }
    touch(en, p, 1.3, GHOST_HIT, 12);
}

/// Scuttles sideways at you and snips, lunging when close. It never steps into the sea.
fn crab(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    en.phase = en.phase + dt * 9;
    en.t = en.t - dt;
    let dir = toward(en, p);
    let near = Vec3.xyz(p.pos.x - en.pos.x, 0, p.pos.z - en.pos.z).length();
    let side = Vec3.xyz(0 - dir.z, 0, dir.x) * (sin(en.phase * 0.35) * 1.1);
    let goal = (dir + side).normalize() * CRAB_SPEED;
    let feet = Vec3.xyz(en.pos.x + goal.x * 0.3, en.pos.y - CRAB_SIZE * 0.5, en.pos.z + goal.z * 0.3);
    let wetNow = level.waterAt(lvl, Vec3.xyz(en.pos.x, en.pos.y - CRAB_SIZE * 0.5, en.pos.z)) > 0.05;
    if !wetNow && level.waterAt(lvl, feet) > 0.05 { goal = Vec3.zero(); }
    let k = min(dt * 8, 1);
    en.vel.x = en.vel.x + (goal.x - en.vel.x) * k;
    en.vel.z = en.vel.z + (goal.z - en.vel.z) * k;
    if en.grounded && en.t <= 0 && near < 6 && near > 1.5 {
        let land = Vec3.xyz(en.pos.x + dir.x * 6, en.pos.y - CRAB_SIZE * 0.5, en.pos.z + dir.z * 6);
        if level.waterAt(lvl, land) < 0.05 {
            en.vel.x = dir.x * 12;
            en.vel.z = dir.z * 12;
            en.vel.y = 5;
            en.grounded = false;
        }
        en.t = 1.3 + e.rng.unit() * 0.8;
    }
    touch(en, p, 1.3, CRAB_HIT, 9);
}

/// Sprints straight at you in short zig-zags, flapping over anything in the way. `phase` runs the legs.
fn chicken(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    en.phase = en.phase + dt * 16;
    let dir = toward(en, p);
    let side = Vec3.xyz(0 - dir.z, 0, dir.x) * (sin(en.phase * 0.15 + f32(en.zone)) * 0.35);
    let goal = (dir + side).normalize() * (CHICKEN_RUN + f32(mini(e.tier, 10)) * 0.25);
    let k = min(dt * 7, 1);
    en.vel.x = en.vel.x + (goal.x - en.vel.x) * k;
    en.vel.z = en.vel.z + (goal.z - en.vel.z) * k;
    // Stuck on something, or you're above it: flap up.
    let run = Vec3.xyz(en.vel.x, 0, en.vel.z).length();
    if en.grounded && (run < CHICKEN_RUN * 0.4 || p.pos.y > en.pos.y + 2) {
        en.vel.y = 7 + clamp(p.pos.y - en.pos.y, 0, 8);
        en.grounded = false;
    }
    touch(en, p, 0.9, CHICKEN_HIT, 6);
}

/// Circles you at head height, chattering, then dives at you in a fast dash. `hopT` is the dash time left.
fn skull(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.phase = en.phase + dt * 3;
    let goal = p.pos + Vec3.xyz(cos(en.phase * 0.6) * 5, 2.6 + sin(en.phase) * 0.6, sin(en.phase * 0.6) * 5);
    let mid = p.pos + Vec3.xyz(0, 0.9, 0);
    if en.hopT > 0 {
        en.hopT = en.hopT - dt;
    } else {
        hover(en, goal, SKULL_SPEED, 4, dt);
        en.t = en.t - dt;
        let gap = (mid - en.pos).length();
        if en.t <= 0 && gap > 4 && gap < 15 {
            en.vel = (mid - en.pos).normalize() * SKULL_DASH;
            en.hopT = 0.7;
            en.t = 2.2 + e.rng.unit() * 1.5;
        }
    }
    moveBody(en, lvl, dt);
    if e.cosmetic.unit() < dt * 10 {
        flameBit(e, en.pos + Vec3.xyz(0, 0.5, 0), Vec3.xyz(0, 1.2, 0), Vec3.xyz(1, 0.55, 0.15), 0.5, 0.14);
    }
    touch(en, p, 1.2, SKULL_HIT, 11);
}

/// Sits, then leaps at you in a long high arc, squashing on landing. Cute, but it hits hard.
fn frog(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    let was = en.grounded;
    en.grounded = moveBody(en, lvl, dt);
    if en.grounded && !was { en.squash = 0.6; }
    en.phase = en.phase + dt * 3;
    if en.grounded {
        en.vel.x = en.vel.x * max(1 - dt * 10, 0);
        en.vel.z = en.vel.z * max(1 - dt * 10, 0);
        en.t = en.t - dt;
        if en.t <= 0 {
            let to = Vec3.xyz(p.pos.x - en.pos.x, 0, p.pos.z - en.pos.z);
            let dir = to.normalize();
            let reach = min(to.length() * 0.9, FROG_LEAP + f32(mini(e.tier, 10)) * 0.4);
            en.vel.x = dir.x * reach;
            en.vel.z = dir.z * reach;
            en.vel.y = 10 + clamp(p.pos.y - en.pos.y, 0, 9) * 0.9;
            en.grounded = false;
            en.squash = 1.4;
            en.t = 1.0 + e.rng.unit() * 0.9;
        }
    }
    en.squash = en.squash + (1 - en.squash) * min(dt * 9, 1);
    touch(en, p, 1.4, FROG_HIT, 11);
}

/// Drifts around under the water and swells up when you come near, then fires a fan of spines.
/// It never leaves the sea. `hopT` is how puffed up it is, 0 to 1.
fn puffer(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.phase = en.phase + dt;
    let over = level.waterSurface(lvl, p.pos.x, p.pos.z) > -900;
    let goal = en.pos + Vec3.xyz(cos(en.phase * 0.7) * 4, 0, sin(en.phase * 0.7) * 4);
    if over { goal = p.pos + Vec3.xyz(cos(en.phase * 0.4) * 6, 0.6, sin(en.phase * 0.4) * 6); }
    let top = level.waterSurface(lvl, en.pos.x, en.pos.z);
    if top > -900 { goal.y = min(goal.y, top - 0.9); }
    hover(en, goal, PUFFER_SPEED, 3, dt);
    let was = en.pos;
    moveBody(en, lvl, dt);
    let now = level.waterSurface(lvl, en.pos.x, en.pos.z);
    if now < -900 {
        en.pos = was;
        en.vel = Vec3.zero();
    } else if en.pos.y > now - 0.5 {
        en.pos.y = now - 0.5;
        en.vel.y = min(en.vel.y, 0);
    }
    let eye = p.pos + Vec3.xyz(0, 1.2, 0);
    let to = eye - en.pos;
    let far = to.length();
    let want: f32 = 0;
    if far < 13 { want = 1; }
    en.hopT = en.hopT + (want - en.hopT) * min(dt * 3, 1);
    en.t = en.t - dt;
    if en.hopT > 0.85 && en.t <= 0 && far < 22 {
        en.t = 2.4 + e.rng.unit() * 1.2;
        let dir = to.normalize();
        let side = Vec3.xyz(0 - dir.z, 0, dir.x);
        let n = -2;
        while n <= 2 {
            let d = (dir + side * (f32(n) * 0.14)).normalize();
            e.orbs[e.nextOrb] = Orb { pos: en.pos + d * 0.8, vel: d * ORB_SPEED, t: ORB_LIFE };
            e.nextOrb = (e.nextOrb + 1) % MAX_ORBS;
            n += 1;
        }
        sfx.at(sfx.ZAP, en.pos);
    }
    if en.hopT > 0.6 { touch(en, p, 1.9, PUFFER_HIT, 10); }
}

/// Drifts to a spot high over you, then dives at where you were and blows up.
fn bomber(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.t = en.t - dt;
    if en.t > 0 {
        hover(en, p.pos + Vec3.xyz(cos(en.phase) * 6, 9, sin(en.phase) * 6), BOMBER_SPEED, BOMBER_CLIMB, dt);
        if en.t < 0.9 { en.vel = en.vel * max(1 - dt * 6, 0); }
    } else if en.t > -dt {
        // Lock on once, then commit.
        en.vel = (p.pos + Vec3.xyz(0, 0.9, 0) - en.pos).normalize() * BOMBER_DIVE;
    }
    let hitGround = moveBody(en, lvl, dt);
    let blocked = en.t <= 0 && en.vel.length() < BOMBER_DIVE * 0.5;
    let near = (p.pos + Vec3.xyz(0, 0.9, 0) - en.pos).length() < BOMBER_BLAST * 0.4;
    if en.t < 0 && (hitGround || blocked || near || en.t < -3) { explode(e, en, p); }
}

fn explode(e: &Enemies, en: &Enemy, p: &Player) {
    touch(en, p, BOMBER_BLAST, BOMBER_HIT, 14);
    sfx.at(sfx.BOOM, en.pos);
    burst(e, en.pos, color(BOMBER), 26, 12);
    burst(e, en.pos, Vec3.xyz(1, 0.8, 0.4), 14, 9);
    en.kind = 0;
}

/// Drifts slowly around a wide ring at a set height over you and lobs an orb now and then.
fn drone(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, scene: &Scene, dt: f32) {
    en.phase = en.phase + dt * 0.15;
    hover(en, p.pos + Vec3.xyz(cos(en.phase) * DRONE_ORBIT, DRONE_HEIGHT, sin(en.phase) * DRONE_ORBIT), DRONE_SPEED, DRONE_CLIMB, dt);
    moveBody(en, lvl, dt);
    en.t = en.t - dt;
    if en.t <= 0 {
        en.t = 2.5 + e.rng.unit() * 1.5;
        let eye = p.pos + Vec3.xyz(0, 1.4, 0);
        let to = eye - en.pos;
        let far = to.length();
        let dir = to.normalize();
        // Only with a clear line to you.
        let sight = shoot(lvl, scene, Ray { origin: en.pos, dir: dir }, far);
        if far < 50 && !sight.hit {
            e.orbs[e.nextOrb] = Orb { pos: en.pos + dir * 0.6, vel: dir * ORB_SPEED, t: ORB_LIFE };
            e.nextOrb = (e.nextOrb + 1) % MAX_ORBS;
            sfx.at(sfx.ZAP, en.pos);
        }
    }
}

/// Soft crowd spacing: overlapping pairs ease apart sideways, so a pack fans out around you
/// instead of stacking. Positions only (no velocity), and a push into a wall is dropped.
/// Walkers can stand on each other, and one squeezed hard enough hops up onto the pack.
/// ponytail: every pair of active enemies (~18k cheap checks at the cap), a grid if MAX_ENEMIES grows a lot.
fn separate(e: &Enemies, lvl: &Level, dt: f32) {
    let k = min(dt * 10, 1) * 0.5;
    let i = 0;
    while i < MAX_ENEMIES {
        e.list[i].crowd = 0;
        i += 1;
    }
    i = 0;
    while i < MAX_ENEMIES {
        let a = &e.list[i];
        if a.kind != 0 && a.kind != METEOR && a.active {
            let j = i + 1;
            while j < MAX_ENEMIES {
                let b = &e.list[j];
                if b.kind != 0 && b.kind != METEOR && b.active {
                    let ra = size(a.kind) * 0.5;
                    let rb = size(b.kind) * 0.5;
                    let sum = ra + rb;
                    let want = sum * 0.9;
                    let dx = b.pos.x - a.pos.x;
                    let dz = b.pos.z - a.pos.z;
                    let d2 = dx * dx + dz * dz;
                    if d2 < want * want {
                        let dy = b.pos.y - a.pos.y;
                        let gap = abs(dy);
                        let flyer = a.kind == DRONE || a.kind == BOMBER || b.kind == DRONE || b.kind == BOMBER || a.kind == GHOST || b.kind == GHOST || a.kind == PUFFER || b.kind == PUFFER || a.kind == SKULL || b.kind == SKULL;
                        if !flyer && gap >= sum * 0.7 && gap < sum * 1.1 {
                            // One is right above the other: it stands there.
                            let top = a;
                            let low = b;
                            if dy > 0 { top = b; low = a; }
                            let at = Vec3.xyz(top.pos.x, low.pos.y + sum, top.pos.z);
                            if top.vel.y <= 0.5 && solid(lvl, at, size(top.kind) * 0.5) < 0 {
                                top.pos = at;
                                top.vel.y = max(top.vel.y, 0);
                                top.perch = true;
                            }
                        } else if gap < sum * 0.7 {
                            let d = sqrt(d2);
                            let nx: f32 = 1;
                            let nz: f32 = 0;
                            if d > 0.001 { nx = dx / d; nz = dz / d; } else { nx = cos(f32(i)); nz = sin(f32(i)); }
                            // The lighter one gives way more.
                            let share = rb / sum;
                            let push = min((want - d) * k, 0.25);
                            nudge(a, lvl, 0 - nx * push * share * 2, 0 - nz * push * share * 2);
                            nudge(b, lvl, nx * push * (1 - share) * 2, nz * push * (1 - share) * 2);
                            a.crowd += want - d;
                            b.crowd += want - d;
                        }
                    }
                }
                j += 1;
            }
        }
        i += 1;
    }
    // Too packed: hop up onto the others, now and then.
    i = 0;
    while i < MAX_ENEMIES {
        let c = &e.list[i];
        c.climbT = c.climbT - dt;
        if c.kind != 0 && c.active && c.crowd > CROWD_CLIMB && c.climbT <= 0 && (c.grounded || c.perch)
            && c.kind <= CHARGER {
            c.vel.y = max(c.vel.y, CLIMB);
            c.perch = false;
            c.climbT = 0.5 + e.rng.unit() * 0.6;
        }
        i += 1;
    }
}

/// Shift sideways unless that lands in a wall.
fn nudge(en: &Enemy, lvl: &Level, dx: f32, dz: f32) {
    let half = size(en.kind) * 0.5;
    en.pos.x += dx;
    if solid(lvl, en.pos, half) >= 0 { en.pos.x -= dx; }
    en.pos.z += dz;
    if solid(lvl, en.pos, half) >= 0 { en.pos.z -= dz; }
}

/// Big-effect debris that ignores the per-frame effect budget: `n` bits from `at`, flung out
/// `speed` with `lift` up, living about `life` seconds. For rare, showy moments.
fn spray(e: &Enemies, at: Vec3, tint: Vec3, n: int, speed: f32, lift: f32, life: f32, size: f32) {
    let i = 0;
    while i < n {
        let d = Vec3.xyz(e.cosmetic.unit() - 0.5, 0, e.cosmetic.unit() - 0.5).normalize();
        e.bits[e.nextBit] = Bit {
            pos: at, vel: d * (speed * (0.3 + e.cosmetic.unit() * 0.9)) + Vec3.xyz(0, lift * (0.3 + e.cosmetic.unit()), 0),
            t: life * (0.6 + e.cosmetic.unit() * 0.6), size: size * (0.5 + e.cosmetic.unit()), color: tint,
        };
        e.nextBit = (e.nextBit + 1) % MAX_BITS;
        i += 1;
    }
}

/// Smoke: like `spray` but the puffs weigh nothing, so they coast outward instead of falling.
fn puff(e: &Enemies, at: Vec3, tint: Vec3, n: int, speed: f32, rise: f32, life: f32, size: f32) {
    let i = 0;
    while i < n {
        let d = Vec3.xyz(e.cosmetic.unit() - 0.5, 0, e.cosmetic.unit() - 0.5).normalize();
        e.bits[e.nextBit] = Bit {
            pos: at + d * (e.cosmetic.unit() * 1.5), vel: d * (speed * (0.3 + e.cosmetic.unit())) + Vec3.xyz(0, rise * (0.4 + e.cosmetic.unit()), 0),
            t: life * (0.7 + e.cosmetic.unit() * 0.6), size: size * (0.6 + e.cosmetic.unit() * 0.8), color: tint, lift: 1,
        };
        e.nextBit = (e.nextBit + 1) % MAX_BITS;
        i += 1;
    }
}

/// A free slot for a forced spawn: when the pool is full, the farthest ordinary enemy makes room.
/// This is the slot `spawnAt` fills next. -1 when nothing can be removed.
fn room(e: &Enemies, p: &Player): int {
    let slot = 0;
    while slot < MAX_ENEMIES && e.list[slot].kind != 0 { slot += 1; }
    if alive(e) >= MAX_ENEMIES - GOLD_ROOM || slot == MAX_ENEMIES {
        let gone = evict(e, p);
        if gone < 0 { return -1; }
        e.list[gone].kind = 0;
        slot = 0;
        while slot < MAX_ENEMIES && e.list[slot].kind != 0 { slot += 1; }
    }
    return slot;
}

/// Hidden from the minimap and edge pointers: a meteor still on its way down.
pub fn hidden(en: Enemy): bool {
    return en.kind == METEOR && !en.grounded;
}

/// Endgame: every SPECIAL_EVERY seconds (call only while due and no boss is up), a shield or a
/// meteor arrives beside you.
pub fn special(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    if challenge.on(challenge.RUSH) { return; }
    e.specialT -= dt;
    if e.specialT > 0 { return; }
    e.specialT = SPECIAL_EVERY;
    if level.inHollows(p.pos) { return; }
    let lodged = 0;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind == METEOR { lodged += 1; }
        i += 1;
    }
    let roll = int(e.rng.unit() * 2);
    if roll == 1 && lodged >= METEOR_MAX { roll = 0; }
    if roll == 1 { strike(e, p, lvl); return; }
    summon(e, p, lvl, SHIELD, true);
}

/// Endless mode: every COLOSSUS_EVERY seconds. True when the caller should land a Colossus on the
/// player; underground it drops CAVE_GEODES shell fragments instead.
pub fn colossusDue(e: &Enemies, p: &Player, dt: f32): bool {
    e.colossusT -= dt;
    if e.colossusT > 0 { return false; }
    e.colossusT = COLOSSUS_EVERY;
    if !level.inHollows(p.pos) { return true; }
    let n = 0;
    while n < CAVE_GEODES {
        let a = e.rng.unit() * TAU;
        let r = 6 + e.rng.unit() * 8;
        spawnGeode(e, p.pos + Vec3.xyz(cos(a) * r, 2 + e.rng.unit() * 2, sin(a) * r), Vec3.xyz(cos(a) * 3, 4, sin(a) * 3));
        n += 1;
    }
    return false;
}

/// Debug: after `delay` seconds of calling this, one `kind` (SHIELD, FLAG or METEOR) arrives, once.
pub fn debugSpawn(e: &Enemies, p: &Player, lvl: &Level, kind: int, delay: f32, dt: f32) {
    if kind == 0 || e.debugDone { return; }
    e.debugT += dt;
    if e.debugT < delay { return; }
    e.debugDone = true;
    summon(e, p, lvl, kind, true);
}

/// One shield or flag bearer beside you, or a meteor called down on you.
fn summon(e: &Enemies, p: &Player, lvl: &Level, k: int, loud: bool): int {
    if k == METEOR { strike(e, p, lvl); return -1; }
    let tries = 0;
    while tries < 24 {
        tries += 1;
        let a = e.rng.unit() * TAU;
        let r = 9 + e.rng.unit() * 6;
        let at = Vec3.xyz(p.pos.x + cos(a) * r, p.pos.y + 3, p.pos.z + sin(a) * r);
        if openAt(lvl, at.x, at.z) && solid(lvl, at, size(k)) < 0 && floorUnder(lvl, at.x, at.z, at.y) {
            let slot = room(e, p);
            if slot < 0 || !spawnAt(e, k, at, Vec3.zero(), false) { return -1; }
            let en = &e.list[slot];
            en.wakeT = 3;
            en.aim = atan2(0 - (p.pos.x - at.x), 0 - (p.pos.z - at.z));
            if k == SHIELD { en.hp = en.hp * (1 + f32(mini(e.tier, 30)) * 0.03); }
            if loud { sfx.at(sfx.HORN, at); }
            return slot;
        }
    }
    return -1;
}

/// Debug: after `delay` seconds of calling this, one charger with `stars` stars and modifier `mod` arrives beside you, once.
pub fn debugElite(e: &Enemies, p: &Player, lvl: &Level, stars: int, mod: int, delay: f32, dt: f32) {
    if (stars <= 0 && mod <= 0) || e.eliteDone { return; }
    e.eliteT += dt;
    if e.eliteT < delay { return; }
    e.eliteDone = true;
    let slot = summon(e, p, lvl, CHARGER, false);
    if slot >= 0 {
        if stars > 0 { promote(e, &e.list[slot], mini(stars, 3)); }
        if mod > 0 { e.list[slot].mod = mini(mod, MODS); }
    }
}

/// A meteor is called down on you: a marker first, then the rock.
fn strike(e: &Enemies, p: &Player, lvl: &Level) {
    if strikeAt(e, p, lvl, p.pos.x, p.pos.z, p.pos.y + 1, 60) { sfx.play(sfx.WARN); }
}

/// A meteor over x/z: the ground is whatever a ray from `top` finds within `reach`, else the player's height.
fn strikeAt(e: &Enemies, p: &Player, lvl: &Level, x: f32, z: f32, top: f32, reach: f32): bool {
    let slot = room(e, p);
    if slot < 0 { return false; }
    if !spawnAt(e, METEOR, Vec3.xyz(x, p.pos.y + METEOR_HEIGHT, z), Vec3.zero(), false) { return false; }
    let m = &e.list[slot];
    m.t = METEOR_WARN;
    let down = sweep(lvl, Ray { origin: Vec3.xyz(x, top, z), dir: Vec3.xyz(0, -1, 0) }, reach);
    m.groundY = if down.hit { down.point.y } else { p.pos.y };
    m.wakeT = METEOR_WARN + 2;
    m.active = true;
    m.grounded = false;
    m.hopT = 0;
    return true;
}

/// Challenge runs: `n` more meteors are owed to surface `tile`. The Hollows get none.
pub fn owe(e: &Enemies, tile: int, n: int) {
    if tile >= 0 && tile < 9 { e.aid[tile] += n; }
}

/// Lava embers: every 0.1 s each lava slab within 45 m of you (that's the cull) lets go of a glowing
/// bit that drifts up off a random spot of its top. Cosmetic, so it rides the effect budget.
pub fn emberTick(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    e.emberT -= dt;
    if e.emberT > 0 { return; }
    e.emberT = 0.1;
    let i = 0;
    while i < lvl.count {
        let b = lvl.boxes[i];
        if b.kind == LAVA {
            let dx = (b.lo.x + b.hi.x) * 0.5 - p.pos.x;
            let dz = (b.lo.z + b.hi.z) * 0.5 - p.pos.z;
            // Big slabs reach further than their centre does.
            let reach = 45 + max(b.hi.x - b.lo.x, b.hi.z - b.lo.z) * 0.5;
            if dx * dx + dz * dz < reach * reach {
                let x = b.lo.x + (b.hi.x - b.lo.x) * e.cosmetic.unit();
                let z = b.lo.z + (b.hi.z - b.lo.z) * e.cosmetic.unit();
                // lift 1 means no gravity; flameBit's 1.25 would accelerate it upward.
                let life = 0.7 + e.cosmetic.unit() * 0.5;
                let vel = Vec3.xyz((e.cosmetic.unit() - 0.5) * 0.2, 0.25 + e.cosmetic.unit() * 0.25, (e.cosmetic.unit() - 0.5) * 0.2);
                e.bits[e.nextBit] = Bit { pos: Vec3.xyz(x, b.hi.y + 0.1, z), vel: vel, t: life, size: 0.08 + e.cosmetic.unit() * 0.08, color: Vec3.xyz(1, 0.35, 0.06), lift: 1, life: life };
                e.nextBit = (e.nextBit + 1) % MAX_BITS;
            }
        }
        i += 1;
    }
}

/// Pays the owed meteors, one a second, each at a random spot of its tile at least 20 m from you.
pub fn aidTick(e: &Enemies, p: &Player, lvl: &Level, dt: f32) {
    e.aidT -= dt;
    if e.aidT > 0 { return; }
    let t = 0;
    while t < 9 && e.aid[t] == 0 { t += 1; }
    if t == 9 { return; }
    e.aidT = 1;
    if level.inHollows(p.pos) { return; }
    let tries = 0;
    while tries < 16 {
        tries += 1;
        let x = 0 - level.HALF + f32(t % 3) * level.TILE + 8 + e.rng.unit() * (level.TILE - 16);
        let z = 0 - level.HALF + f32(t / 3) * level.TILE + 8 + e.rng.unit() * (level.TILE - 16);
        let dx = x - p.pos.x;
        let dz = z - p.pos.z;
        if dx * dx + dz * dz < 400 { continue; }
        if strikeAt(e, p, lvl, x, z, 60, 120) { e.aid[t] -= 1; return; }
    }
}

/// Falls where you stood when it was called (the marker never moves), blasts, and stays lodged there.
fn meteor(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    if en.grounded {
        en.hopT = max(0, en.hopT - dt);
        // The crater keeps smoking while the shockwave spreads.
        if en.hopT > 0 && e.cosmetic.unit() < 0.7 {
            puff(e, Vec3.xyz(en.pos.x, en.groundY + 0.5, en.pos.z), Vec3.xyz(0.2, 0.18, 0.16), 2, 10, 1.5, 1.2, 1.6);
        }
        return;
    }
    en.t -= dt;
    // Free fall: the distance covered grows with the square of the time, so it starts slow and
    // hits at full speed.
    let fell = 1 - max(en.t, 0) / METEOR_WARN;
    en.pos.y = en.groundY + METEOR_SIZE * 0.25 + METEOR_HEIGHT * (1 - fell * fell);
    // Trail: embers and sparks all the way down, thicker smoke now and then.
    let tail = en.pos + Vec3.xyz(0, 1.2, 0);
    spray(e, tail, Vec3.xyz(1, 0.55, 0.12), 2, 3, 1, 0.7, 0.3);
    spray(e, tail, Vec3.xyz(1, 0.9, 0.4), 1, 6, 0, 0.4, 0.14);
    if e.cosmetic.unit() < 0.5 { spray(e, tail + Vec3.xyz(0, 1.2, 0), Vec3.xyz(0.12, 0.1, 0.09), 1, 1.5, 0.5, 1.4, 0.7); }
    if en.t > 0 { return; }
    // Impact.
    en.grounded = true;
    en.hopT = METEOR_WAVE;
    en.vel = Vec3.zero();
    en.pos.y = en.groundY + METEOR_SIZE * 0.25;
    let off = p.pos - en.pos;
    let flat = sqrt(off.x * off.x + off.z * off.z);
    if flat < METEOR_BLAST && p.pos.y < en.groundY + 4 {
        let away = Vec3.xyz(off.x, 0, off.z).normalize();
        hurt(p, foeMul() * METEOR_HIT * (1 - flat / METEOR_BLAST * 0.5), away * 16 + Vec3.xyz(0, 8, 0));
    }
    blast(e, Vec3.xyz(en.pos.x, en.groundY + 0.6, en.pos.z), METEOR_BLAST, 60, Vec3.xyz(1, 0.5, 0.1), 12);
    sfx.at(sfx.BOOM, en.pos);
    // Fireball, dust ring, flung rock and a spray of sparks.
    let hit = Vec3.xyz(en.pos.x, en.groundY + 0.4, en.pos.z);
    spray(e, hit, Vec3.xyz(1, 0.5, 0.1), 40, 16, 9, 0.9, 0.34);
    spray(e, hit, Vec3.xyz(1, 0.95, 0.5), 24, 24, 12, 0.6, 0.16);
    spray(e, hit, Vec3.xyz(0.2, 0.15, 0.12), 20, 12, 10, 1.2, 0.45);
    spray(e, hit, Vec3.xyz(0.3, 0.26, 0.22), 30, 18, 1.5, 1.3, 0.5);
    // Smoke: a fat billowing cloud at the crater, and a column that climbs from it.
    puff(e, hit, Vec3.xyz(0.16, 0.14, 0.13), 26, 18, 1.5, 1.3, 1.5);
    puff(e, hit, Vec3.xyz(0.3, 0.27, 0.24), 16, 12, 2, 1.6, 1.9);
    puff(e, hit + Vec3.xyz(0, 1, 0), Vec3.xyz(0.09, 0.08, 0.08), 14, 8, 3, 1.8, 2.2);
    e.shake = max(e.shake, 0.16);
}

/// Slow and armoured. The shield turns toward you at a limited rate, so get around it.
fn shielder(en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    let want = atan2(0 - (p.pos.x - en.pos.x), 0 - (p.pos.z - en.pos.z));
    let diff = want - en.aim;
    while diff > PI { diff -= TAU; }
    while diff < 0 - PI { diff += TAU; }
    en.aim += clamp(diff, 0 - SHIELD_TURN * dt, SHIELD_TURN * dt);
    let dir = toward(en, p);
    let k = min(dt * 3, 1);
    en.vel.x = en.vel.x + (dir.x * SHIELD_WALK - en.vel.x) * k;
    en.vel.z = en.vel.z + (dir.z * SHIELD_WALK - en.vel.z) * k;
    let flat = Vec3.xyz(en.vel.x, 0, en.vel.z).length();
    en.phase += flat * dt * 1.6;
    if en.grounded && (flat < SHIELD_WALK * 0.4 || p.pos.y > en.pos.y + 2) {
        en.vel.y = 9 + clamp(p.pos.y - en.pos.y, 0, 8);
        en.grounded = false;
    }
    touch(en, p, 2.8, SHIELD_HIT, 14);
}

/// Keeps away from you and drifts to the nearest other enemy, so the buff stays where the fight is.
fn bearer(e: &Enemies, en: &Enemy, p: &Player, lvl: &Level, dt: f32) {
    en.vel.y = en.vel.y - GRAVITY * dt;
    en.grounded = moveBody(en, lvl, dt);
    let goal = Vec3.zero();
    let best = -1;
    let bestD: f32 = 1000000;
    let i = 0;
    while i < MAX_ENEMIES {
        let o = &e.list[i];
        if o.kind != 0 && o.kind != FLAG && o.kind != METEOR && level.inHollows(o.pos) == level.inHollows(en.pos) {
            let d2 = (o.pos.x - en.pos.x) * (o.pos.x - en.pos.x) + (o.pos.z - en.pos.z) * (o.pos.z - en.pos.z);
            if d2 < bestD { best = i; bestD = d2; }
        }
        i += 1;
    }
    if best >= 0 && bestD > 36 {
        goal = goal + Vec3.xyz(e.list[best].pos.x - en.pos.x, 0, e.list[best].pos.z - en.pos.z).normalize();
    }
    let gap = sqrt((p.pos.x - en.pos.x) * (p.pos.x - en.pos.x) + (p.pos.z - en.pos.z) * (p.pos.z - en.pos.z));
    if gap < FLAG_SHY {
        goal = goal + toward(en, p) * (0 - (0.6 + 2.4 * (1 - gap / FLAG_SHY)));
    }
    let want = Vec3.zero();
    if goal.length() > 0.05 { want = goal.normalize() * FLAG_RUN; }
    let k = min(dt * 5, 1);
    en.vel.x = en.vel.x + (want.x - en.vel.x) * k;
    en.vel.z = en.vel.z + (want.z - en.vel.z) * k;
    let flat = Vec3.xyz(en.vel.x, 0, en.vel.z).length();
    en.phase += flat * dt * 1.2;
    if en.grounded && want.length() > 0 && flat < FLAG_RUN * 0.3 {
        en.vel.y = 8;
        en.grounded = false;
    }
    touch(en, p, 0.9, 8, 6);
}

/// Everything within a bearer's aura this frame: stronger, faster, tougher.
fn buffs(e: &Enemies) {
    let i = 0;
    while i < MAX_ENEMIES {
        e.list[i].buff = false;
        i += 1;
    }
    i = 0;
    while i < MAX_ENEMIES {
        let f = &e.list[i];
        if f.kind == FLAG {
            let j = 0;
            while j < MAX_ENEMIES {
                let o = &e.list[j];
                if o.kind != 0 && o.kind != FLAG && o.kind != METEOR {
                    let d = o.pos - f.pos;
                    if d.dot(d) < FLAG_AURA * FLAG_AURA { o.buff = true; }
                }
                j += 1;
            }
        }
        i += 1;
    }
}

/// Put a shrine enemy back near you, on ground you stood on.
fn recall(en: &Enemy, p: &Player, lvl: &Level) {
    let back = p.safe + toward(en, p) * -4 + Vec3.xyz(0, 3, 0);
    if solid(lvl, back, size(en.kind) * 0.5) >= 0 || !floorUnder(lvl, back.x, back.z, back.y) {
        back = p.safe + Vec3.xyz(0, 4, 0);
    }
    en.pos = back;
    en.vel = Vec3.zero();
}

pub fn update(e: &Enemies, p: &Player, lvl: &Level, scene: &Scene, dt: f32) {
    e.hitT = e.hitT - dt;
    e.killT = e.killT - dt;
    e.gemT = e.gemT - dt;
    e.downT = e.downT - dt;
    let numI = 0;
    while numI < MAX_NUMS {
        e.nums[numI].t = e.nums[numI].t + dt;
        numI += 1;
    }

    if p.hp <= 0 {
        if !e.died {
            sfx.play(sfx.DEATH);
            e.downTime = e.time;
            e.downT = 0;
            e.died = true;
        }
        return;
    }

    // Spawn all the time, topping up to the tier's count.
    if e.restT > 0 {
        e.restT = e.restT - dt;
    } else {
        e.time = e.time + dt;
        e.tier = 1 + int(e.time / TIER_TIME);
        e.spawnT = e.spawnT - dt;
        if e.spawnT <= 0 {
            if !challenge.on(challenge.RUSH) && (alive(e) < target(e, lvl) || (level.inHollows(p.pos) && caveAlive(e) < mini(18 + e.tier * 3, 48))) { spawn(e, p, lvl); }
            e.spawnT = spawnEvery(e);
            if e.calm && !e.endless { e.spawnT = e.spawnT * 2; }
        }
    }
    let gemStart = game.micros();
    gems(e, p, lvl, dt);
    cells(e, p, lvl, dt);
    e.gemMs = f32(game.micros() - gemStart) / 1000;
    let aiStart = game.micros();
    buffs(e);
    e.shake = max(0, e.shake - dt * 0.5);

    let i = 0;
    while i < MAX_ENEMIES {
        let en = &e.list[i];
        if en.kind != 0 {
            // Surface creatures cannot populate the underground roster by falling down the shaft.
            if level.inHollows(en.pos) && !en.cave && en.kind <= BOMBER {
                en.cave = true;
                en.zone = level.HOLLOWS;
                if en.kind == BOMBER { en.kind = DRONE; }
                if en.kind == CHARGER { en.kind = ZIPPER; }
            }
            en.flash = en.flash - dt;
            en.parryCd = max(0, en.parryCd - dt);
            if en.riposte > 0 {
                en.riposte -= dt;
                if en.riposte <= 0 { damage(e, i, en.riposteDmg, en.vel * 0.3, en.pos); }
            }
            en.wakeT = max(0, en.wakeT - dt);
            let delta = en.pos - p.pos;
            let range2 = delta.dot(delta);
            if (en.miniGeode && level.inHollows(p.pos)) || en.gold || en.wakeT > 0 || range2 < WAKE * WAKE { en.active = true; }
            else if range2 > SLEEP * SLEEP { en.active = false; }
            if en.active {
                if en.kind == HOPPER { hopper(e, en, p, lvl, dt); }
                if en.kind == DRONE { drone(e, en, p, lvl, scene, dt); }
                if en.kind == ZIPPER {
                    if en.miniGeode { miniGeode(e, en, p, lvl, dt); } else { zipper(en, p, lvl, dt); }
                }
                if en.kind == CHARGER { charger(e, en, p, lvl, dt); }
                if en.kind == BOMBER { bomber(e, en, p, lvl, dt); }
                if en.kind == SHIELD { shielder(en, p, lvl, dt); }
                if en.kind == FLAG { bearer(e, en, p, lvl, dt); }
                if en.kind == METEOR { meteor(e, en, p, lvl, dt); }
                if en.kind == GHOST { ghost(e, en, p, lvl, dt); }
                if en.kind == CRAB { crab(e, en, p, lvl, dt); }
                if en.kind == PUFFER { puffer(e, en, p, lvl, dt); }
                if en.kind == FROG { frog(e, en, p, lvl, dt); }
                if en.kind == SKULL { skull(e, en, p, lvl, dt); }
                if en.kind == CHICKEN { chicken(e, en, p, lvl, dt); }
                if en.mod != 0 { modTick(e, en, p, dt); }
            } else if en.kind != DRONE && en.kind != BOMBER && en.kind != GHOST && en.kind != PUFFER && en.kind != SKULL {
                if !en.grounded || en.vel.dot(en.vel) > 0.01 {
                    en.vel.y -= GRAVITY * dt;
                    en.grounded = moveBody(en, lvl, dt);
                    if en.grounded { en.vel = Vec3.zero(); }
                }
            } else { en.vel = Vec3.zero(); }
            // Distance never removes an inhabitant.
            // Shrine ones stuck out of reach (or far off for too long) come back, or the reward never fires.
            if en.gold {
                en.age += dt;
                if range2 > 70 * 70 || level.inHollows(en.pos) != level.inHollows(p.pos) || (en.age > 30 && range2 > 20 * 20) { recall(en, p, lvl); en.age = 0; }
            }
            if en.pos.y < level.rescueY(lvl, en.pos) {
                // Shrine ones come back near you, on ground you stood on.
                if en.gold {
                    recall(en, p, lvl);
                } else {
                    en.kind = 0;
                }
            }

        }
        i += 1;
    }

    separate(e, lvl, dt);
    e.aiMs = f32(game.micros() - aiStart) / 1000;
    let effectsStart = game.micros();
    i = 0;
    while i < MAX_ORBS {
        let o = &e.orbs[i];
        if o.t > 0 {
            o.t = o.t - dt;
            if o.fire { o.vel.y -= FIRE_GRAVITY * dt; }
            o.pos = o.pos + o.vel * dt;
            let off = o.pos - p.pos;
            if off.y > -0.2 && off.y < 2 && off.x * off.x + off.z * off.z < 0.5 {
                let hit = ORB_HIT;
                let spark = Vec3.xyz(0.6, 1, 0.3);
                if o.fire { hit = FIRE_HIT; spark = Vec3.xyz(1, 0.5, 0.1); }
                hurt(p, hit * foeMul(), o.vel.normalize() * 6 + Vec3.xyz(0, 2, 0));
                burst(e, o.pos, spark, 8, 4);
                o.t = 0;
            } else if solid(lvl, o.pos, 0.1) >= 0 {
                if o.fire { burst(e, o.pos, Vec3.xyz(1, 0.5, 0.1), 8, 4); } else { burst(e, o.pos, Vec3.xyz(0.6, 1, 0.3), 8, 4); }
                o.t = 0;
            }
        }
        i += 1;
    }

    i = 0;
    while i < MAX_BITS {
        let b = &e.bits[i];
        if b.t > 0 {
            b.t = b.t - dt;
            b.vel.y = b.vel.y - GRAVITY * 0.7 * dt * (1 - b.lift);
            b.pos = b.pos + b.vel * dt;
        }
        i += 1;
    }
    e.effectsMs = f32(game.micros() - effectsStart) / 1000;
}

/// The nearest enemy along `ray` closer than `reach`: a sphere test per enemy.
pub fn ray(e: &Enemies, r: Ray, reach: f32): Hit {
    let ignored: [1]int = [-1];
    return rayExcept(e, r, reach, ignored[:]);
}

/// Piercing projectiles skip enemies they have already damaged on this flight.
pub fn rayExcept(e: &Enemies, r: Ray, reach: f32, ignored: []int): Hit {
    let best = Hit { index: -1, t: reach, exit: reach };
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        let skip = false;
        let j = 0;
        while j < ignored.len {
            if ignored[j] == i { skip = true; }
            j += 1;
        }
        if en.kind != 0 && !skip {
            let rad = size(en.kind) * bulk(en) * 0.65;
            let to = en.pos - r.origin;
            let along = to.dot(r.dir);
            let miss = to.dot(to) - along * along;
            if along > 0 && miss < rad * rad {
                let t = along - sqrt(rad * rad - miss);
                if t < best.t {
                    best.index = i;
                    best.t = t;
                    best.exit = along + sqrt(rad * rad - miss);
                }
            }
        }
        i += 1;
    }
    return best;
}

/// Show `dmg` at `at` for the hud. `key` names what was hit, so one volley adds into one figure.
pub fn number(e: &Enemies, key: int, at: Vec3, dmg: f32, kill: bool) {
    let i = 0;
    while i < MAX_NUMS {
        let q = &e.nums[i];
        if q.key == key && q.t < NUM_JOIN {
            q.val = q.val + dmg;
            q.kill = q.kill || kill;
            return;
        }
        i += 1;
    }
    e.nums[e.nextNum] = Num { pos: at, key: key, val: dmg, t: 0, kill: kill };
    e.nextNum = (e.nextNum + 1) % MAX_NUMS;
}

/// A bullet landed: flash, knock back, and pop it when it's out of health.
pub fn damage(e: &Enemies, index: int, dmg: f32, shove: Vec3, at: Vec3) {
    let en = &e.list[index];
    if en.kind == 0 { return; }
    // A meteor is only breakable once it has settled.
    if en.kind == METEOR && (!en.grounded || en.hopT > 0) { return; }
    en.wakeT = 3;
    en.active = true;
    let taken = modHurt(en, dmg);
    if en.buff { taken = taken * BUFF_GUARD; }
    if en.kind == SHIELD {
        // Hits landing on the shielded side are halved.
        let side = Vec3.xyz(at.x - en.pos.x, 0, at.z - en.pos.z);
        let facing = Vec3.xyz(0 - sin(en.aim), 0, 0 - cos(en.aim));
        if side.length() > 0.1 && side.normalize().dot(facing) > SHIELD_COVER {
            taken = taken * SHIELD_LET;
            burst(e, at, Vec3.xyz(0.4, 0.9, 1), 4, 9);
        }
    }
    number(e, index + 1, en.pos + Vec3.xyz(0, size(en.kind) * 0.6, 0), min(taken, max(en.hp, 0) + 1), en.hp - taken <= 0);
    en.hp = en.hp - taken;
    en.flash = 0.22;
    en.vel = en.vel + shove * (1 / (1 + f32(en.stars)));
    let fast = en.vel.length();
    if fast > MAX_SPEED { en.vel = en.vel * (MAX_SPEED / fast); }
    // One tick per burst, not one per shotgun pellet.
    if e.hitT < 0.08 {
        sfx.play(sfx.HIT);
        // One bright burst per volley, so a shotgun doesn't hide the hit in a cloud of pellets.
        burst(e, at, Vec3.xyz(1, 0.96, 0.75), 10, 14);
        burst(e, at, Vec3.xyz(1, 0.35, 0.08), 5, 8);
    }
    e.hitT = 0.12;
    e.hits += 1;
    if en.hp <= 0 {
        let xp = worth(en.kind);
        if en.gold { xp = xp * 3; }
        xp = xp * (1 + en.stars);
        if en.stars > 0 { dropCell(e, en.pos + Vec3.xyz(0, 0.5, 0)); }
        if en.mod != 0 { modDeath(e, en); }
        if en.zone >= 0 {
            xp += ZONE_XP;
            e.zoneKills[en.zone] += 1;
            if e.zoneKills[en.zone] == ZONE_GOAL { e.cleared = en.zone; }
        }
        if xp > 5 { reward(e, en.pos, xp); } else { drop(e, en.pos, xp); }
        burst(e, en.pos, color(en.kind), 8, 9);
        if en.kind == SHIELD || en.kind == METEOR { burst(e, en.pos, color(en.kind), 16, 12); }
        burst(e, en.pos, Vec3.xyz(1, 1, 1), 2, 6);
        en.kind = 0;
        e.kills += 1;
        e.killT = 0.3;
        sfx.at(sfx.KILL, en.pos);
    }
}

fn append(e: &Enemies, model: Mat4, tint: Vec3, glow: Vec3, shell: bool, cast: bool) {
    if e.partCount >= e.parts.len { panic("enemy render capacity"); }
    let i = e.partCount;
    e.parts[i] = Instance { model: model, tint: tint, emission: glow };
    e.owners[i] = e.owner;
    e.shells[i] = shell;
    e.casts[i] = cast;
    e.partCount += 1;
}

fn cube(e: &Enemies, base: Mat4, at: Vec3, sz: Vec3, tint: Vec3, glow: Vec3) {
    let tiny = sz.x < 0.35 && sz.y < 0.35 && sz.z < 0.1;
    if !e.detail && tiny { return; }
    append(e, base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(sz.x, sz.y, sz.z)), tint, glow, false, e.cast && !tiny);
}

fn hull(e: &Enemies, base: Mat4, at: Vec3, sz: Vec3) {
    if !e.detail { return; }
    let w = e.edgeW * 2;
    append(e, base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(sz.x + w, sz.y + w, sz.z + w)), Vec3.zero(), e.edge, true, false);
}

/// Submit the prepared geometry using independent camera/light visibility.
pub fn draw(e: &Enemies, p: &Player) {
    let camera = gfx.inCameraPass();
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        e.visible[i] = en.kind != 0 && gfx.visible(Mat4.translate(en.pos.x, en.pos.y, en.pos.z), Vec3.xyz(-3, -3, -3), Vec3.xyz(3, 4.5, 3));
        i += 1;
    }
    let pass = 0;
    while pass < (if camera { 2 } else { 1 }) {
        let count = 0;
        i = 0;
        while i < e.partCount {
            let owner = e.owners[i];
            let visible = false;
            if owner >= 0 { visible = e.visible[owner]; }
            else if camera { visible = gfx.visible(e.parts[i].model, Vec3.xyz(-0.5, -0.5, -0.5), Vec3.xyz(0.5, 0.5, 0.5)); }
            if visible && e.shells[i] == (pass == 1) && (camera || e.casts[i]) {
                e.batch[count] = e.parts[i]; count += 1;
            }
            i += 1;
        }
        let batch = []Instance { ptr: e.batch.ptr, len: count };
        if pass == 1 { gfx.drawHullInstances(e.cube, batch); }
        else { gfx.drawInstances(e.cube, batch); }
        pass += 1;
    }
}

/// Prepare once before either render pass. No GL calls or per-frame allocations.
pub fn prepare(e: &Enemies, p: &Player) {
    e.partCount = 0;
    e.cast = true;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 {
            e.owner = i;
            let distance = en.pos - p.pos;
            let far2 = distance.dot(distance);
            if far2 > 2500 { e.list[i].detailed = false; }
            if far2 < 2025 { e.list[i].detailed = true; }
            e.detail = e.list[i].detailed;
            // Face the player: local -z points at them.
            let yaw = atan2(0 - (p.pos.x - en.pos.x), 0 - (p.pos.z - en.pos.z));
            let base = Mat4.translate(en.pos.x, en.pos.y, en.pos.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), yaw));
            let tint = color(en.kind);
            let glow = Vec3.zero();
            e.edge = Vec3.xyz(OUTLINE_GLOW, OUTLINE_GLOW, OUTLINE_GLOW);
            e.edgeW = OUTLINE;
            if en.gold {
                e.edge = Vec3.xyz(2.6, 1.8, 0.3);
                e.edgeW = GOLD_OUTLINE;
                if !e.detail { tint = Vec3.xyz(1, 0.7, 0.15); }
            }
            if en.zone >= 0 && !en.cave {
                tint = zoneTint(en.zone);
                e.edge = zoneGlow(en.zone);
                e.edgeW = GOLD_OUTLINE;
                // A spinning crystal over its head, in the biome's glow.
                let twirl = e.clock * 4 + en.phase;
                let top = Mat4.translate(en.pos.x, en.pos.y + size(en.kind) * 0.5 + 0.6 + sin(twirl * 2) * 0.1, en.pos.z)
                    .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), twirl)).mul(Mat4.rotate(Vec3.xyz(1, 0, 1).normalize(), 0.6155));
                e.cast = false;
                cube(e, top, Vec3.zero(), Vec3.xyz(0.3, 0.3, 0.3), zoneTint(en.zone), zoneGlow(en.zone));
                e.cast = true;
            }
            if en.cave {
                tint = caveTint(en.kind);
                glow = tint * 0.22;
                e.edge = Vec3.xyz(0.25, 0.65, 0.7);
            }
            if en.stars > 0 { e.edge = Vec3.xyz(2.4, 0.5, 1.8); e.edgeW = GOLD_OUTLINE; }
            if en.mod != 0 { e.edge = modGlow(en.mod); e.edgeW = GOLD_OUTLINE; glow = glow + modGlow(en.mod) * 0.08; }
            if en.kind == SHIELD { e.edge = Vec3.xyz(0.5, 1.6, 2.4); e.edgeW = GOLD_OUTLINE; }
            if en.kind == FLAG { e.edge = Vec3.xyz(2.4, 0.3, 0.4); e.edgeW = OUTLINE * 1.6; }
            if en.kind == METEOR { e.edge = Vec3.xyz(2.6, 1.1, 0.2); e.edgeW = OUTLINE * 1.5; }
            if en.buff {
                // In a flag bearer's aura: a red glow and chevrons turning over the head.
                glow = glow + Vec3.xyz(0.35, 0.04, 0.03);
                e.edge = Vec3.xyz(2.2, 0.3, 0.25);
                let red = Vec3.xyz(1, 0.15, 0.1);
                let chev = Mat4.translate(en.pos.x, en.pos.y + size(en.kind) * 0.5 + 0.55 + sin(e.clock * 5 + en.phase) * 0.08, en.pos.z)
                    .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), e.clock * 3 + en.phase));
                e.cast = false;
                let rung = 0;
                while rung < 2 {
                    let arm = -1;
                    while arm <= 1 {
                        let sx = f32(arm);
                        let cm = chev.mul(Mat4.translate(sx * 0.11, f32(rung) * 0.17, 0)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), 0 - sx * 0.7));
                        cube(e, cm, Vec3.zero(), Vec3.xyz(0.3, 0.08, 0.08), red, red * 3);
                        arm += 2;
                    }
                    rung += 1;
                }
                e.cast = true;
            }
            if badgeCount(en) > 0 {
                let crown = en.pos.y + size(en.kind) * bulk(en) * 0.5 + 0.8;
                if (en.zone >= 0 && !en.cave) || en.buff { crown += 0.5; }
                drawBadges(e, en, crown, yaw);
            }
            if en.stars > 0 {
                // Bigger body.
                let k = bulk(en);
                base = base.mul(Mat4.translate(0, size(en.kind) * (k - 1) * 0.5, 0)).mul(Mat4.scale(k, k, k));
            }
            if en.flash > 0 {
                let punch = en.flash / 0.22;
                tint = Vec3.xyz(1, 1, 1);
                glow = Vec3.xyz(10, 7, 2.5) * (0.55 + punch);
                e.edge = Vec3.xyz(8, 5, 1.4);
                e.edgeW = 0.07 + punch * 0.08;
            }
            if en.miniGeode {
                miniGeodeBody(e, en, base, tint, glow);
                i += 1; continue;
            }
            if en.cave {
                caveBody(e, en, base, tint, glow);
                i += 1;
                continue;
            }
            if en.kind == SHIELD { shieldBody(e, en, base, yaw, tint, glow); i += 1; continue; }
            if en.kind == FLAG { bearerBody(e, en, base, tint, glow); i += 1; continue; }
            if en.kind == METEOR { meteorBody(e, en, tint); i += 1; continue; }
            let white = Vec3.xyz(1, 1, 1);
            let black = Vec3.xyz(0.05, 0.05, 0.08);
            if en.kind == HOPPER {
                let sq = en.squash;
                let wide = 1 / sqrt(sq);
                let h = HOPPER_SIZE * sq;
                base = base.mul(Mat4.translate(0, (h - HOPPER_SIZE) * 0.5, 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(wide, sq * 0.9, wide));
                cube(e, base, Vec3.zero(), Vec3.xyz(wide, sq * 0.9, wide), tint, glow);
                cube(e, base, Vec3.xyz(-0.22, 0.12 * sq, -0.5 * wide), Vec3.xyz(0.22, 0.26 * sq, 0.04), white, glow);
                cube(e, base, Vec3.xyz(0.22, 0.12 * sq, -0.5 * wide), Vec3.xyz(0.22, 0.26 * sq, 0.04), white, glow);
                cube(e, base, Vec3.xyz(-0.22, 0.08 * sq, -0.52 * wide), Vec3.xyz(0.1, 0.12 * sq, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.22, 0.08 * sq, -0.52 * wide), Vec3.xyz(0.1, 0.12 * sq, 0.04), black, Vec3.zero());
            } else if en.kind == ZIPPER {
                let zs = ZIPPER_SIZE;
                let skip = abs(sin(en.phase * 2)) * 0.08;
                base = base.mul(Mat4.translate(0, skip, 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(zs, zs * 0.7, zs * 1.2));
                cube(e, base, Vec3.zero(), Vec3.xyz(zs, zs * 0.7, zs * 1.2), tint, glow);
                cube(e, base, Vec3.xyz(-0.13, 0.08, -0.6 * zs * 1.2), Vec3.xyz(0.12, 0.14, 0.04), white, glow);
                cube(e, base, Vec3.xyz(0.13, 0.08, -0.6 * zs * 1.2), Vec3.xyz(0.12, 0.14, 0.04), white, glow);
                cube(e, base, Vec3.xyz(0, 0.3, 0.1), Vec3.xyz(0.05, 0.25, 0.05), black, Vec3.xyz(0.2, 0.9, 1));
            } else if en.kind == CHARGER {
                let cs = CHARGER_SIZE;
                // Glows hot while winding up and rushing.
                let hot = 1 - clamp(en.t / 0.6, 0, 1);
                if en.phase > 0 { hot = 1; }
                if en.flash <= 0 { glow = Vec3.xyz(1.5, 0.2, 0.05) * hot; }
                hull(e, base, Vec3.zero(), Vec3.xyz(cs, cs * 0.8, cs));
                cube(e, base, Vec3.zero(), Vec3.xyz(cs, cs * 0.8, cs), tint, glow);
                hull(e, base, Vec3.xyz(-0.55, 0.75, -0.55), Vec3.xyz(0.2, 0.5, 0.2));
                hull(e, base, Vec3.xyz(0.55, 0.75, -0.55), Vec3.xyz(0.2, 0.5, 0.2));
                cube(e, base, Vec3.xyz(-0.55, 0.75, -0.55), Vec3.xyz(0.2, 0.5, 0.2), white, glow);
                cube(e, base, Vec3.xyz(0.55, 0.75, -0.55), Vec3.xyz(0.2, 0.5, 0.2), white, glow);
                cube(e, base, Vec3.xyz(-0.35, 0.2, -0.81), Vec3.xyz(0.3, 0.14, 0.04), black, Vec3.xyz(1, 0.1, 0.05) * (1 + hot * 3));
                cube(e, base, Vec3.xyz(0.35, 0.2, -0.81), Vec3.xyz(0.3, 0.14, 0.04), black, Vec3.xyz(1, 0.1, 0.05) * (1 + hot * 3));
            } else if en.kind == GHOST {
                let ghostSize = GHOST_SIZE;
                base = base.mul(Mat4.translate(0, sin(en.phase * 3) * 0.15, 0));
                if en.flash <= 0 { glow = Vec3.xyz(0.35, 0.55, 0.8); }
                hull(e, base, Vec3.zero(), Vec3.xyz(ghostSize, ghostSize, ghostSize));
                cube(e, base, Vec3.zero(), Vec3.xyz(ghostSize, ghostSize, ghostSize), tint, glow);
                cube(e, base, Vec3.xyz(-0.22, 0.12, -ghostSize * 0.51), Vec3.xyz(0.16, 0.24, 0.04), black, Vec3.xyz(0.5, 1.6, 3));
                cube(e, base, Vec3.xyz(0.22, 0.12, -ghostSize * 0.51), Vec3.xyz(0.16, 0.24, 0.04), black, Vec3.xyz(0.5, 1.6, 3));
                cube(e, base, Vec3.xyz(0, -0.2, -ghostSize * 0.51), Vec3.xyz(0.24, 0.16, 0.04), black, Vec3.zero());
            } else if en.kind == BOMBER {
                let bs = BOMBER_SIZE;
                // The core blinks faster as the dive nears, and burns during it.
                let rate = 4 + 14 * (1 - clamp(en.t / 2, 0, 1));
                let blink = 0.5 + 0.5 * sin(en.phase * 10 + (2 - en.t) * rate);
                if en.t <= 0 { blink = 1; }
                hull(e, base, Vec3.zero(), Vec3.xyz(bs, bs, bs));
                hull(e, base, Vec3.xyz(-0.55, 0.1, 0), Vec3.xyz(0.4, 0.05, 0.3));
                hull(e, base, Vec3.xyz(0.55, 0.1, 0), Vec3.xyz(0.4, 0.05, 0.3));
                cube(e, base, Vec3.zero(), Vec3.xyz(bs, bs, bs), tint, glow);
                cube(e, base, Vec3.xyz(-0.55, 0.1, 0), Vec3.xyz(0.4, 0.05, 0.3), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.55, 0.1, 0), Vec3.xyz(0.4, 0.05, 0.3), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0, 0, -0.36), Vec3.xyz(0.34, 0.34, 0.04), black, Vec3.xyz(1.5, 0.6, 3) * (0.3 + blink * 2));
            } else if en.kind == SKULL {
                // A chunky flying skull: sockets that glow, a chattering jaw, a little flame on top.
                let ks = SKULL_SIZE;
                let chat = abs(sin(en.phase * 2)) * 0.1;
                base = base.mul(Mat4.translate(0, sin(en.phase) * 0.08, 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(ks, ks * 0.9, ks));
                cube(e, base, Vec3.zero(), Vec3.xyz(ks, ks * 0.9, ks), tint, glow);
                cube(e, base, Vec3.xyz(0, -0.55 * ks - chat, -0.05), Vec3.xyz(0.7 * ks, 0.24 * ks, 0.7 * ks), tint, glow);
                cube(e, base, Vec3.xyz(0, -0.4 * ks - chat * 0.5, -0.38 * ks), Vec3.xyz(0.55 * ks, 0.08, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.26 * ks, 0.08 * ks, -0.5 * ks), Vec3.xyz(0.32 * ks, 0.32 * ks, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.26 * ks, 0.08 * ks, -0.5 * ks), Vec3.xyz(0.32 * ks, 0.32 * ks, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.26 * ks, 0.08 * ks, -0.54 * ks), Vec3.xyz(0.14 * ks, 0.14 * ks, 0.04), Vec3.xyz(1, 0.6, 0.1), Vec3.xyz(2.5, 1.2, 0.2));
                cube(e, base, Vec3.xyz(0.26 * ks, 0.08 * ks, -0.54 * ks), Vec3.xyz(0.14 * ks, 0.14 * ks, 0.04), Vec3.xyz(1, 0.6, 0.1), Vec3.xyz(2.5, 1.2, 0.2));
                cube(e, base, Vec3.xyz(0, -0.12 * ks, -0.51 * ks), Vec3.xyz(0.1, 0.16, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0, 0.55 * ks, 0), Vec3.xyz(0.2, 0.25 + chat, 0.2), Vec3.xyz(1, 0.55, 0.15), Vec3.xyz(2.4, 1.1, 0.2));
            } else if en.kind == CHICKEN {
                // A round white chick: one fat body, a little orange beak, a red comb, dot eyes,
                // pink cheeks, stubby wings and feet that patter.
                let chs = CHICKEN_SIZE;
                let comb = Vec3.xyz(0.95, 0.2, 0.2);
                let beak = Vec3.xyz(1, 0.65, 0.15);
                let hop = abs(sin(en.phase * 0.5)) * 0.12;
                let wing = sin(en.phase * 1.3) * 0.15;
                base = base.mul(Mat4.translate(0, hop, 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(chs * 1.3, chs * 1.2, chs * 1.3));
                cube(e, base, Vec3.zero(), Vec3.xyz(chs * 1.3, chs * 1.2, chs * 1.3), tint, glow);
                cube(e, base, Vec3.xyz(0, 0.68 * chs, -0.1), Vec3.xyz(0.2, 0.22, 0.4), comb, comb * 0.3);
                cube(e, base, Vec3.xyz(0, -0.02, -0.68 * chs), Vec3.xyz(0.24, 0.14, 0.2), beak, beak * 0.3);
                cube(e, base, Vec3.xyz(-0.24, 0.16, -0.66 * chs), Vec3.xyz(0.13, 0.13, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.24, 0.16, -0.66 * chs), Vec3.xyz(0.13, 0.13, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.36, -0.08, -0.6 * chs), Vec3.xyz(0.14, 0.09, 0.04), Vec3.xyz(1, 0.6, 0.65), Vec3.xyz(0.3, 0.1, 0.1));
                cube(e, base, Vec3.xyz(0.36, -0.08, -0.6 * chs), Vec3.xyz(0.14, 0.09, 0.04), Vec3.xyz(1, 0.6, 0.65), Vec3.xyz(0.3, 0.1, 0.1));
                cube(e, base, Vec3.xyz(-0.68 * chs, 0.0 + wing, 0.05), Vec3.xyz(0.1, 0.36, 0.4), tint, glow);
                cube(e, base, Vec3.xyz(0.68 * chs, 0.0 - wing, 0.05), Vec3.xyz(0.1, 0.36, 0.4), tint, glow);
                let pat = sin(en.phase) * 0.12;
                cube(e, base, Vec3.xyz(-0.2, -0.64 * chs, pat), Vec3.xyz(0.14, 0.14, 0.26), beak, Vec3.zero());
                cube(e, base, Vec3.xyz(0.2, -0.64 * chs, 0.0 - pat), Vec3.xyz(0.14, 0.14, 0.26), beak, Vec3.zero());
            } else if en.kind == FROG {
                // A round chubby frog: big shiny eyes, pink cheeks, a little smile, tucked feet.
                let fs = FROG_SIZE;
                let fq = en.squash;
                let fw = 1 / sqrt(fq);
                let pink = Vec3.xyz(1, 0.6, 0.65);
                base = base.mul(Mat4.translate(0, (fq - 1) * fs * 0.4, 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(fs * 1.1 * fw, fs * 0.85 * fq, fs * 1.0 * fw));
                cube(e, base, Vec3.zero(), Vec3.xyz(fs * 1.1 * fw, fs * 0.85 * fq, fs * 1.0 * fw), tint, glow);
                cube(e, base, Vec3.xyz(0, -0.22 * fq, -0.05), Vec3.xyz(0.75 * fs * fw, 0.35 * fq, 0.9 * fs * fw), Vec3.xyz(1, 0.97, 0.7), Vec3.zero());
                cube(e, base, Vec3.xyz(-0.32, 0.5 * fq, -0.3), Vec3.xyz(0.42, 0.42, 0.42), tint, glow);
                cube(e, base, Vec3.xyz(0.32, 0.5 * fq, -0.3), Vec3.xyz(0.42, 0.42, 0.42), tint, glow);
                cube(e, base, Vec3.xyz(-0.32, 0.52 * fq, -0.52), Vec3.xyz(0.3, 0.3, 0.05), white, glow);
                cube(e, base, Vec3.xyz(0.32, 0.52 * fq, -0.52), Vec3.xyz(0.3, 0.3, 0.05), white, glow);
                cube(e, base, Vec3.xyz(-0.32, 0.52 * fq, -0.56), Vec3.xyz(0.18, 0.18, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.32, 0.52 * fq, -0.56), Vec3.xyz(0.18, 0.18, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.28, 0.58 * fq, -0.59), Vec3.xyz(0.07, 0.07, 0.03), white, white);
                cube(e, base, Vec3.xyz(0.36, 0.58 * fq, -0.59), Vec3.xyz(0.07, 0.07, 0.03), white, white);
                cube(e, base, Vec3.xyz(-0.5 * fs * fw, 0.0, -0.5 * fs * fw), Vec3.xyz(0.2, 0.12, 0.04), pink, pink * 0.3);
                cube(e, base, Vec3.xyz(0.5 * fs * fw, 0.0, -0.5 * fs * fw), Vec3.xyz(0.2, 0.12, 0.04), pink, pink * 0.3);
                cube(e, base, Vec3.xyz(0, -0.05, -0.52 * fs * fw), Vec3.xyz(0.3, 0.05, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.17, -0.02, -0.52 * fs * fw), Vec3.xyz(0.05, 0.05, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.17, -0.02, -0.52 * fs * fw), Vec3.xyz(0.05, 0.05, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.35 * fs, -0.36 * fq, -0.3), Vec3.xyz(0.3, 0.14, 0.4), tint, glow);
                cube(e, base, Vec3.xyz(0.35 * fs, -0.36 * fq, -0.3), Vec3.xyz(0.3, 0.14, 0.4), tint, glow);
            } else if en.kind == CRAB {
                // A chubby crab: a wide body, big eyes, two round claws, a little wiggle.
                let crabS = CRAB_SIZE;
                let wiggle = sin(en.phase) * 0.06;
                base = base.mul(Mat4.translate(0, abs(wiggle), 0));
                hull(e, base, Vec3.zero(), Vec3.xyz(crabS, crabS * 0.6, crabS * 0.8));
                cube(e, base, Vec3.zero(), Vec3.xyz(crabS, crabS * 0.6, crabS * 0.8), tint, glow);
                cube(e, base, Vec3.xyz(-0.2, 0.36, -0.22), Vec3.xyz(0.24, 0.24, 0.24), white, glow);
                cube(e, base, Vec3.xyz(0.2, 0.36, -0.22), Vec3.xyz(0.24, 0.24, 0.24), white, glow);
                cube(e, base, Vec3.xyz(-0.2, 0.36, -0.35), Vec3.xyz(0.12, 0.12, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.2, 0.36, -0.35), Vec3.xyz(0.12, 0.12, 0.05), black, Vec3.zero());
                cube(e, base, Vec3.xyz(-0.62, 0.1 + wiggle, -0.4), Vec3.xyz(0.3, 0.3, 0.3), tint, glow);
                cube(e, base, Vec3.xyz(0.62, 0.1 - wiggle, -0.4), Vec3.xyz(0.3, 0.3, 0.3), tint, glow);
            } else if en.kind == PUFFER {
                // A round little fish: big eyes, a tiny mouth and fins. It swells when it gets angry.
                let fishP = en.hopT;
                let fishS = 1 + fishP * 0.6;
                if en.flash <= 0 { tint = Vec3.xyz(1, 0.88, 0.45); glow = Vec3.xyz(0.1, 0.08, 0.02) * fishP; }
                hull(e, base, Vec3.zero(), Vec3.xyz(PUFFER_SIZE * fishS, PUFFER_SIZE * 0.9 * fishS, PUFFER_SIZE * fishS));
                cube(e, base, Vec3.zero(), Vec3.xyz(PUFFER_SIZE * fishS, PUFFER_SIZE * 0.9 * fishS, PUFFER_SIZE * fishS), tint, glow);
                cube(e, base, Vec3.xyz(-0.28 * fishS, 0.15 * fishS, -0.5 * fishS), Vec3.xyz(0.28, 0.28, 0.05), white, glow);
                cube(e, base, Vec3.xyz(0.28 * fishS, 0.15 * fishS, -0.5 * fishS), Vec3.xyz(0.28, 0.28, 0.05), white, glow);
                cube(e, base, Vec3.xyz(-0.28 * fishS, 0.15 * fishS, -0.54 * fishS), Vec3.xyz(0.13, 0.13, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.28 * fishS, 0.15 * fishS, -0.54 * fishS), Vec3.xyz(0.13, 0.13, 0.04), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0, -0.15 * fishS, -0.54 * fishS), Vec3.xyz(0.14, 0.08, 0.04), Vec3.xyz(1, 0.5, 0.4), Vec3.zero());
                let fishFlap = sin(en.phase * 9) * 0.1;
                cube(e, base, Vec3.xyz(-0.6 * fishS, -0.05, -0.05), Vec3.xyz(0.16, 0.22 + fishFlap, 0.22), tint, glow);
                cube(e, base, Vec3.xyz(0.6 * fishS, -0.05, -0.05), Vec3.xyz(0.16, 0.22 - fishFlap, 0.22), tint, glow);
                // A few short spikes pop out when it swells.
                if fishP > 0.4 {
                    cube(e, base, Vec3.xyz(0, 0.5 * fishS, 0), Vec3.xyz(0.14, 0.2 * fishP, 0.14), Vec3.xyz(1, 0.5, 0.4), Vec3.zero());
                    cube(e, base, Vec3.xyz(0, -0.5 * fishS, 0), Vec3.xyz(0.14, 0.2 * fishP, 0.14), Vec3.xyz(1, 0.5, 0.4), Vec3.zero());
                    cube(e, base, Vec3.xyz(-0.5 * fishS, 0, 0.2), Vec3.xyz(0.2 * fishP, 0.14, 0.14), Vec3.xyz(1, 0.5, 0.4), Vec3.zero());
                    cube(e, base, Vec3.xyz(0.5 * fishS, 0, 0.2), Vec3.xyz(0.2 * fishP, 0.14, 0.14), Vec3.xyz(1, 0.5, 0.4), Vec3.zero());
                }
            } else {
                let bob = sin(en.phase * 6) * 0.08;
                base = base.mul(Mat4.translate(0, bob, 0));
                // The eye glows hotter just before a shot.
                let charge = 1 - clamp(en.t / 0.5, 0, 1);
                hull(e, base, Vec3.zero(), Vec3.xyz(0.8, 0.5, 0.8));
                hull(e, base, Vec3.xyz(-0.6, 0.05, 0), Vec3.xyz(0.45, 0.06, 0.35));
                hull(e, base, Vec3.xyz(0.6, 0.05, 0), Vec3.xyz(0.45, 0.06, 0.35));
                cube(e, base, Vec3.zero(), Vec3.xyz(0.8, 0.5, 0.8), tint, glow);
                cube(e, base, Vec3.xyz(-0.6, 0.05, 0), Vec3.xyz(0.45, 0.06, 0.35), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0.6, 0.05, 0), Vec3.xyz(0.45, 0.06, 0.35), black, Vec3.zero());
                cube(e, base, Vec3.xyz(0, 0, -0.41), Vec3.xyz(0.3, 0.2, 0.04), black, Vec3.xyz(1, 0.1, 0.05) * (1 + charge * 4));
            }
        }
        i += 1;
    }
    e.owner = -1;
    e.cast = false;
    e.detail = true;
    i = 0;
    while i < MAX_ORBS {
        let o = e.orbs[i];
        if o.t > 0 {
            let spin = Mat4.translate(o.pos.x, o.pos.y, o.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 1, 0).normalize(), o.t * 9));
            if o.fire { cube(e, spin, Vec3.zero(), Vec3.xyz(0.5, 0.5, 0.5), Vec3.xyz(1, 0.45, 0.1), Vec3.xyz(3.5, 1.4, 0.2)); }
            else { cube(e, spin, Vec3.zero(), Vec3.xyz(0.35, 0.35, 0.35), Vec3.xyz(0.4, 1, 0.3), Vec3.xyz(1.2, 3, 0.8)); }
        }
        i += 1;
    }
    i = 0;
    while i < MAX_CELLS {
        let c = e.cells[i];
        if c.t > 0 {
            // Blinks for the last few seconds.
            let show = c.t > 5 || sin(c.t * 14) > 0;
            if show {
                // Three slim gold bullets side by side, turning as one.
                let roll = Mat4.translate(c.pos.x, c.pos.y + 0.6 + sin(e.clock * 3 + f32(i)) * 0.12, c.pos.z)
                    .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), e.clock * 2.5 + f32(i)));
                let gold = Vec3.xyz(0.85, 0.55, 0.05);
                cube(e, roll, Vec3.xyz(-0.22, 0, 0), Vec3.xyz(0.14, 0.6, 0.14), gold, gold * 0.6);
                cube(e, roll, Vec3.zero(), Vec3.xyz(0.14, 0.6, 0.14), gold, gold * 0.6);
                cube(e, roll, Vec3.xyz(0.22, 0, 0), Vec3.xyz(0.14, 0.6, 0.14), gold, gold * 0.6);
                // A white shell around them, drawn inside out (back faces only), standing on a corner.
                let shell = roll.mul(Mat4.rotate(Vec3.xyz(1, 0, 1).normalize(), 0.955)).mul(Mat4.scale(1.05, 1.05, 1.05));
                if e.detail { append(e, shell, Vec3.zero(), Vec3.xyz(2.5, 2.5, 2.5), true, false); }
            }
        }
        i += 1;
    }
    i = 0;
    while i < MAX_BITS {
        let b = e.bits[i];
        if b.t > 0 {
            let s = b.size * min(b.t * 3, 1);
            let heat: f32 = 3.5;
            if b.life > 0 {
                // Flame: swells as it drifts out, then cools.
                let age = 1 - b.t / b.life;
                s = b.size * (0.6 + age * 1.1) * min(b.t * 5, 1);
                heat = 4.5 - age * 3;
            }
            cube(e, Mat4.translate(b.pos.x, b.pos.y, b.pos.z), Vec3.zero(), Vec3.xyz(s, s, s), b.color, b.color * heat);
        }
        i += 1;
    }
    // Gems: spinning diamonds, bigger for more XP, blinking before they fade.
    let turn = e.clock * 3;
    e.edge = Vec3.xyz(0.7, 2.4, 0.2);
    e.edgeW = 0.04;
    i = 0;
    while i < MAX_GEMS {
        let g = e.gems[i];
        if g.t > 0 && (g.t > 5 || sin(g.t * 20) > 0) {
            let gs = min(0.2 + f32(g.value) * 0.04, 0.45);
            let lift = sin(turn * 2 + f32(i)) * 0.08;
            let m = Mat4.translate(g.pos.x, g.pos.y + 0.25 + lift, g.pos.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), turn + f32(i)))
                .mul(Mat4.rotate(Vec3.xyz(1, 0, 1).normalize(), 0.6155));
            let gc = gemColor(g.value);
            hull(e, m, Vec3.zero(), Vec3.xyz(gs, gs, gs));
            cube(e, m, Vec3.zero(), Vec3.xyz(gs, gs, gs), gc, gc * 1.6);
        }
        i += 1;
    }
}

/// Deterministic stress fixtures, called only by the opt-in performance harness.
pub fn benchmarkFill(e: &Enemies, p: &Player, lvl: &Level, pack: bool) {
    e.rng = Rng.new(99);
    e.cosmetic = Rng.new(701);
    let i = 0;
    while i < MAX_ENEMIES {
        // 48 locals; remaining inhabitants distributed over all nine tiles.
        let tile = i % 9;
        let at = Vec3.xyz(0 - level.TILE + f32(tile % 3) * level.TILE + e.rng.floatRange(-35, 35), 14,
            0 - level.TILE + f32(tile / 3) * level.TILE + e.rng.floatRange(-35, 35));
        if i < 48 {
            let angle = f32(i) * TAU / 48;
            let radius: f32 = if pack && i < 24 { 10 } else { 24 + f32(i % 4) * 5 };
            at = p.pos + Vec3.xyz(cos(angle) * radius, 3, sin(angle) * radius);
        }
        // Walk down to a supported, clear position. Retry an unsupported point later.
        let y: f32 = 50;
        let found = false;
        while y > -2 && !found {
            let box = solid(lvl, Vec3.xyz(at.x, y, at.z), 0.1);
            if box >= 0 { at.y = lvl.boxes[box].hi.y + 2; found = true; }
            y -= 1;
        }
        let kind = 1 + i % 5;
        // Flyers keep the synthetic population stable over pits too.
        if !found { kind = DRONE; at.y = 10; }
        e.list[i] = Enemy { kind: kind, pos: at, vel: Vec3.zero(), hp: health(kind),
            t: 1 + f32(i % 7) * 0.2, flash: 0, phase: f32(i), grounded: false,
            squash: 1, gold: i >= MAX_ENEMIES - GOLD_ROOM, zone: if i % 4 == 0 { tile } else { -1 } };
        i += 1;
    }
    i = 0;
    while i < MAX_GEMS {
        let a = f32(i) * 0.71;
        let gemRadius = 7 + f32(i % 50);
        let gemAt = p.pos + Vec3.xyz(cos(a) * gemRadius, 2, sin(a) * gemRadius);
        e.gems[i] = Gem { pos: gemAt, vel: Vec3.zero(), value: 1 + i % 5,
            t: GEM_LIFE, pulled: false, expires: e.clock + GEM_LIFE, nextTick: e.clock + f32(i % 10) * 0.01 };
        i += 1;
    }
    e.time = 800;
    e.tier = 21;
}

pub fn benchmarkOrbs(e: &Enemies, p: &Player) {
    let i = 0;
    while i < MAX_ORBS {
        if e.orbs[i].t <= 0 {
            let a = f32(i) * TAU / f32(MAX_ORBS);
            e.orbs[i] = Orb { pos: p.pos + Vec3.xyz(cos(a) * 22, 3 + f32(i % 8), sin(a) * 22),
                vel: Vec3.xyz(-cos(a) * 11, 0, -sin(a) * 11), t: 5 };
        }
        i += 1;
    }
}

/// Pack kills use the real damage, reward, sound and debris paths.
pub fn benchmarkKill(e: &Enemies) {
    let i = 0;
    while i < 24 {
        if e.list[i].kind != 0 { damage(e, i, 10000, Vec3.zero(), e.list[i].pos); }
        i += 1;
    }
}

/// Behavioral regression checks on a simple floor, without a render context dependency.
pub fn selfCheck(mem: &Arena, scene: &Scene) {
    let lvl = level.empty(mem, 1, 0);
    lvl.count = 1;
    lvl.boxes[0] = Box { lo: Vec3.xyz(0 - level.HALF, -1, 0 - level.HALF), hi: Vec3.xyz(level.HALF, 0, level.HALF), launch: 0, kind: level.SOLID };
    level.index(&lvl, mem);
    let p = player.create(&lvl);
    p.pos = Vec3.zero();
    let e = create(mem);
    let i = 0;
    while i < 100 { spawn(&e, &p, &lvl); i += 1; }
    if alive(&e) != 9 { panic("enemy check: hub target"); }
    i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 {
            let at = e.list[i].pos;
            if tileAt(at.x, at.z) != HUB || at.x * at.x + at.z * at.z <= 400 { panic("enemy check: spawn exclusion"); }
        }
        i += 1;
    }
    lvl.open = 511;
    e.tier = 100;
    i = 0;
    while i < 2000 { spawn(&e, &p, &lvl); i += 1; }
    if alive(&e) != 180 { panic("enemy check: world population"); }
    if spawnAt(&e, HOPPER, Vec3.zero(), Vec3.zero(), false) { panic("enemy check: shrine reserve"); }
    i = 0;
    while i < 12 {
        if !spawnAt(&e, HOPPER, Vec3.zero(), Vec3.zero(), true) { panic("enemy check: shrine capacity"); }
        i += 1;
    }
    if spawnAt(&e, HOPPER, Vec3.zero(), Vec3.zero(), true) { panic("enemy check: full capacity"); }
    wipe(&e);
    e.restT = 10000;
    spawnAt(&e, HOPPER, Vec3.xyz(54, 0.5, 0), Vec3.zero(), false);
    e.list[0].grounded = true;
    e.list[0].mod = 0;
    e.list[0].t = 10;
    update(&e, &p, &lvl, scene, 0.01);
    if !e.list[0].active { panic("enemy check: wake"); }
    e.list[0].pos.x = 60;
    update(&e, &p, &lvl, scene, 0.01);
    if !e.list[0].active { panic("enemy check: hysteresis"); }
    e.list[0].pos.x = 100;
    update(&e, &p, &lvl, scene, 0.01);
    if e.list[0].active || e.list[0].kind == 0 { panic("enemy check: persistence"); }
    let timer = e.list[0].t;
    update(&e, &p, &lvl, scene, 0.01);
    if e.list[0].t != timer { panic("enemy check: sleeping attack clock"); }
    damage(&e, 0, 1, Vec3.zero(), e.list[0].pos);
    update(&e, &p, &lvl, scene, 0.01);
    if !e.list[0].active || e.list[0].wakeT < 2.9 { panic("enemy check: damage wakes"); }
    wipe(&e);
    beginUpdate(&e, &p, 0.1);
    e.nextBit = 0;
    let seed = e.rng.state;
    burst(&e, p.pos, Vec3.xyz(1, 0, 0), 500, 9);
    burst(&e, p.pos, Vec3.xyz(1, 0, 0), 500, 9);
    if e.nextBit != 48 || e.effectsLeft != 0 || e.rng.state != seed { panic("enemy check: effect budget/RNG"); }
    beginUpdate(&e, &p, 0.01);
    if e.tokens > 4.81 { panic("enemy check: effect rate"); }
    let before = e.nextBit;
    burst(&e, Vec3.xyz(100, 0, 0), Vec3.xyz(1, 0, 0), 5, 9);
    if e.nextBit != before { panic("enemy check: far effects"); }
    e.nextGem = 0;
    drop(&e, Vec3.xyz(100, 0.2, 0), 3);
    e.gems[0].settled = true;
    let gemPos = e.gems[0].pos;
    beginUpdate(&e, &p, 0.1);
    gems(&e, &p, &lvl, 0.1);
    if (e.gems[0].pos - gemPos).length() > 0 { panic("enemy check: settled gem moved"); }
    e.gems[0].pos = Vec3.xyz(0, 0.9, 0);
    gems(&e, &p, &lvl, 0.01);
    if e.xp != 3 || e.gems[0].t != 0 { panic("enemy check: pickup"); }
    drop(&e, Vec3.xyz(100, 0.2, 0), 2);
    e.clock += 91;
    gems(&e, &p, &lvl, 0.01);
    if e.gems[1].t != 0 { panic("enemy check: expiry"); }
    p.hp = 0;
    let left = alive(&e);
    let xp = e.xp;
    update(&e, &p, &lvl, scene, 0.01);
    if alive(&e) != left || !e.died || e.xp != xp { panic("enemy check: death froze"); }
    revive(&e, &p);
    if alive(&e) != 0 || e.died || e.xp != 0 || p.hp != MAX_HP { panic("enemy check: revive"); }
}

/// Fixed opening population, independent of capture duration or rendering speed.
pub fn benchmarkOpening(e: &Enemies, p: &Player, lvl: &Level) {
    let i = 0;
    while i < 100 && alive(e) < 9 { spawn(e, p, lvl); i += 1; }
    e.restT = 100000;
}

/// Real cave floor queries and enemy depth rules must agree with the player route.
pub fn cavernCheck(mem: &Arena, lvl: &Level, scene: &Scene) {
    let saved = lvl.open;
    lvl.open = 564; // Hub, Toy City, Volcano and cave only; the cave crosses locked surface tiles.
    level.setGates(lvl);
    let e = create(mem);
    let p = player.create(lvl);
    p.pos = Vec3.xyz(192, -60, -109);
    p.safe = p.pos;
    let attempt = 0;
    while attempt < 30 { spawn(&e, &p, lvl); attempt += 1; }
    if alive(&e) < 8 { panic("cavern: no underground enemy population"); }
    let roster = 0;
    let k = 0;
    while k < MAX_ENEMIES {
        if e.list[k].kind != 0 && (!level.inHollows(e.list[k].pos) || !e.list[k].cave || e.list[k].zone != level.HOLLOWS || (e.list[k].kind != HOPPER && e.list[k].kind != ZIPPER && e.list[k].kind != DRONE)) { panic("cavern: enemy spawned on surface"); }
        if e.list[k].kind != 0 {
            let mask = level.bit(e.list[k].kind - 1);
            if (roster / mask) % 2 == 0 { roster += mask; }
        }
        k += 1;
    }
    if roster != 7 { panic(`cavern: incomplete cave roster {roster}`); }
    let tick = 0;
    while tick < 100 {
        p.hp = MAX_HP;
        beginUpdate(&e, &p, 0.02);
        update(&e, &p, lvl, scene, 0.02);
        tick += 1;
    }
    if alive(&e) < 5 { panic("cavern: enemies removed at underground depth"); }
    wipe(&e);
    p.pos = Vec3.xyz(-20, -60, -185);
    attempt = 0;
    while attempt < 30 { spawn(&e, &p, lvl); attempt += 1; }
    if caveAlive(&e) < 8 { panic("cavern: locked surface tile blocked underground spawns"); }
    lvl.open = saved;
    level.setGates(lvl);
}

fn caveAlive(e: &Enemies): int {
    let total = 0;
    let i = 0;
    while i < MAX_ENEMIES {
        if e.list[i].kind != 0 && e.list[i].cave { total += 1; }
        i += 1;
    }
    return total;
}

fn caveTint(kind: int): Vec3 {
    if kind == DRONE { return Vec3.xyz(0.48, 0.4, 0.65); }
    if kind == ZIPPER { return Vec3.xyz(0.45, 0.57, 0.58); }
    return Vec3.xyz(0.3, 0.8, 0.7);
}

/// Echo bats flap broad wings, spiders scuttle on eight legs, slimes carry crystal crowns.
fn caveBody(e: &Enemies, en: Enemy, base: Mat4, tint: Vec3, glow: Vec3) {
    let eyes = Vec3.xyz(0.7, 1, 0.65);
    let shine = Vec3.xyz(0.6, 1.4, 1.1);
    if en.kind == DRONE {
        hull(e, base, Vec3.zero(), Vec3.xyz(0.8, 0.65, 0.7));
        cube(e, base, Vec3.zero(), Vec3.xyz(0.8, 0.65, 0.7), tint, glow);
        let wing = 0;
        while wing < 2 {
            let sign: f32 = -1;
            if wing == 1 { sign = 1; }
            let flap = sin(e.clock * 13 + en.phase) * 0.45;
            let bone = base.mul(Mat4.translate(sign * 0.35, 0.1, 0)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), sign * flap));
            cube(e, bone, Vec3.xyz(sign * 0.65, 0, 0.1), Vec3.xyz(1.3, 0.12, 0.8), tint * 0.75, glow);
            cube(e, bone, Vec3.xyz(sign * 1.25, 0, -0.12), Vec3.xyz(0.3, 0.1, 0.4), tint, glow);
            cube(e, base, Vec3.xyz(sign * 0.25, 0.47, -0.1), Vec3.xyz(0.17, 0.38, 0.2), tint, glow);
            cube(e, base, Vec3.xyz(sign * 0.19, 0.08, -0.37), Vec3.xyz(0.14, 0.12, 0.07), eyes, shine);
            wing += 1;
        }
        return;
    }
    if en.kind == ZIPPER {
        hull(e, base, Vec3.xyz(0, 0, 0.25), Vec3.xyz(0.9, 0.5, 1));
        cube(e, base, Vec3.xyz(0, 0, 0.25), Vec3.xyz(0.9, 0.5, 1), tint, glow);
        cube(e, base, Vec3.xyz(0, -0.02, -0.45), Vec3.xyz(0.55, 0.4, 0.5), tint * 0.8, glow);
        let leg = 0;
        while leg < 8 {
            let legSide: f32 = -1;
            if leg >= 4 { legSide = 1; }
            let along = -0.5 + f32(leg % 4) * 0.32;
            let stride = sin(e.clock * 14 + f32(leg) * 2) * 0.16;
            let limb = base.mul(Mat4.translate(legSide * 0.35, -0.12, along))
                .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), stride));
            cube(e, limb, Vec3.xyz(legSide * 0.4, 0, 0), Vec3.xyz(0.8, 0.12, 0.12), tint * 0.7, glow);
            cube(e, limb, Vec3.xyz(legSide * 0.8, -0.2, 0), Vec3.xyz(0.13, 0.5, 0.13), tint * 0.7, glow);
            leg += 1;
        }
        cube(e, base, Vec3.xyz(-0.15, 0.06, -0.72), Vec3.xyz(0.1, 0.1, 0.06), eyes, shine);
        cube(e, base, Vec3.xyz(0.15, 0.06, -0.72), Vec3.xyz(0.1, 0.1, 0.06), eyes, shine);
        return;
    }
    let slime = base.mul(Mat4.scale(1 / sqrt(en.squash), en.squash, 1 / sqrt(en.squash)));
    hull(e, slime, Vec3.zero(), Vec3.xyz(1.1, 0.85, 1.1));
    cube(e, slime, Vec3.zero(), Vec3.xyz(1.1, 0.85, 1.1), tint, glow);
    let shard = 0;
    while shard < 3 {
        let crystal = slime.mul(Mat4.translate(-0.35 + f32(shard) * 0.35, 0.5, 0))
            .mul(Mat4.rotate(Vec3.xyz(0, 0, 1), f32(shard - 1) * -0.3));
        cube(e, crystal, Vec3.zero(), Vec3.xyz(0.22, 0.65, 0.22), Vec3.xyz(0.7, 0.95, 1), shine * 0.45);
        shard += 1;
    }
    cube(e, slime, Vec3.xyz(-0.23, 0.08, -0.57), Vec3.xyz(0.15, 0.16, 0.05), eyes, shine);
    cube(e, slime, Vec3.xyz(0.23, 0.08, -0.57), Vec3.xyz(0.15, 0.16, 0.05), eyes, shine);
}

/// Fragments pursue, stay inside cave solids, and die to an ordinary weapon hit.
pub fn geodeCheck(mem: &Arena, lvl: &Level) {
    let e = create(mem);
    let p = player.create(lvl);
    p.pos = Vec3.xyz(168, -60, -141);
    spawnGeode(&e, Vec3.xyz(168, -59.5, -151), Vec3.xyz(0, 6, -5));
    let en = &e.list[0];
    let nearest: f32 = 100;
    let hops = 0;
    let i = 0;
    while i < 250 {
        let previousHop = en.hopT;
        miniGeode(&e, en, &p, lvl, 0.02);
        if en.hopT > previousHop { hops += 1; }
        nearest = min(nearest, (en.pos - p.pos).length());
        if solid(lvl, en.pos, size(en.kind) * 0.5 - 0.01) >= 0 { panic("mini geode: inside cave solid"); }
        i += 1;
    }
    if hops < 1 { panic("mini geode: no spontaneous hops on level ground"); }
    if nearest > 2 || en.hp != 30 || !en.miniGeode { panic("mini geode: no pursuit or wrong health"); }
    damage(&e, 0, 30, Vec3.zero(), en.pos);
    if alive(&e) != 0 { panic("mini geode: survived lethal hit or split again"); }
}
