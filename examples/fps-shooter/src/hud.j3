// Crosshair, hit markers, sniper scope, gun strip, ammo, health, XP bar and level, speed and dash readouts,
// and edge vignettes. Drawn after the 3D pass. The menus are in menu.j3.

module fps_shooter.hud;

use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.gfx.Look;
use j3.math.{ PI, TAU, Vec2, Vec3, abs, atan2, clamp, cos, floor, max, min, sin, sqrt, tan };
use fps_shooter.biome;
use fps_shooter.level;
use fps_shooter.pal;
use fps_shooter.bosskit;
use fps_shooter.bosskit.{ Boss, Bosses };
use fps_shooter.enemies.{ Enemies, MAX_NUMS, NUM_LIFE, ZONE_GOAL };
use fps_shooter.perks.{ Perks, need };
use fps_shooter.guns.{ Guns, GUNS, cooldown, current, fov, mag, owned, reloading, scoped, spread };
use fps_shooter.player.{ Player, has, hspeed, maxHp, JETPACK, TURRET };
use fps_shooter.shrine.{ Shrines, MAX_SHRINES };

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

/// A flat steel card.
fn panel(x: f32, y: f32, w: f32, h: f32) {
    pal.card(200);
    rect(x, y, w, h);
}

/// Color creeping in from the screen edges: `strength` 0..1 is how far in and how strong.
fn vignette(sz: Vec2, strength: f32, r: u8, g: u8, b: u8) {
    let k = 0;
    while k < 8 {
        let a = strength * 46 * (1 - f32(k) / 8);
        game.setColor(game.rgba(r, g, b, u8(a)));
        let m = f32(k) * 16;
        rect(0, m, sz.x, 16);
        rect(0, sz.y - m - 16, sz.x, 16);
        rect(m, 16, 16, sz.y - 32);
        rect(sz.x - m - 16, 16, 16, sz.y - 32);
        k += 1;
    }
}

/// Four arms around the middle, `gap` pixels out, with a dark outline.
fn crosshair(x: f32, y: f32, gap: f32) {
    let len: f32 = 8;
    game.setColor(game.rgba(10, 10, 20, 170));
    rect(x - gap - len - 1, y - 2, len + 2, 4);
    rect(x + gap - 1, y - 2, len + 2, 4);
    rect(x - 2, y - gap - len - 1, 4, len + 2);
    rect(x - 2, y + gap - 1, 4, len + 2);
    game.setColor(game.rgb(255, 255, 255));
    rect(x - gap - len, y - 1, len, 2);
    rect(x + gap, y - 1, len, 2);
    rect(x - 1, y - gap - len, 2, len);
    rect(x - 1, y + gap, 2, len);
    rect(x - 1, y - 1, 2, 2);
}

/// Black around a square window, with a thin reticle.
fn scope(sz: Vec2) {
    let s = min(sz.x, sz.y) * 0.92;
    let x0 = (sz.x - s) * 0.5;
    let y0 = (sz.y - s) * 0.5;
    game.setColor(game.rgb(0, 0, 0));
    rect(0, 0, x0, sz.y);
    rect(x0 + s, 0, sz.x - x0 - s, sz.y);
    rect(x0, 0, s, y0);
    rect(x0, y0 + s, s, sz.y - y0 - s);
    // Rounded-ish corners: step the black in.
    let k = 0;
    while k < 6 {
        let c = s * 0.22 * (1 - f32(k) / 6);
        let h = s * 0.035;
        rect(x0, y0 + f32(k) * h, c, h);
        rect(x0 + s - c, y0 + f32(k) * h, c, h);
        rect(x0, y0 + s - f32(k + 1) * h, c, h);
        rect(x0 + s - c, y0 + s - f32(k + 1) * h, c, h);
        k += 1;
    }
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    rect(x0, cy - 1, s, 2);
    rect(cx - 1, y0, 2, s);
    game.setColor(game.rgb(255, 60, 90));
    rect(cx - 2, cy - 2, 4, 4);
}

/// Four dots out on the diagonals: a hit, or a kill in red.
fn hitMarker(x: f32, y: f32, kill: bool) {
    if kill { game.setColor(game.rgb(255, 60, 60)); } else { game.setColor(game.rgb(255, 255, 255)); }
    let k = 0;
    while k < 4 {
        let d = 7 + f32(k) * 2;
        rect(x - d - 1.5, y - d - 1.5, 3, 3);
        rect(x + d - 1.5, y - d - 1.5, 3, 3);
        rect(x - d - 1.5, y + d - 1.5, 3, 3);
        rect(x + d - 1.5, y + d - 1.5, 3, 3);
        k += 1;
    }
}

/// Speed lines start just above sprint (13 m/s) and are full at 28.
const STREAK_FROM: f32 = 14;
const STREAK_FULL: f32 = 28;
const STREAKS: int = 14;

/// Fixed pseudo-random 0..1 per `n`.
fn hash(n: f32): f32 {
    let x = sin(n * 12.9898) * 43758.547;
    return x - floor(x);
}

/// Slipstream: streaks rushing out from the middle toward the edges. The GL hud has no lines, so
/// each is a run of overlapping squares that widens as it goes. Each streak picks a new angle
/// every pass, and none start inside the middle third so the crosshair stays clear.
fn speedLines(p: &Player, sz: Vec2) {
    let s = clamp((hspeed(p) - STREAK_FROM) / (STREAK_FULL - STREAK_FROM), 0, 1);
    if s <= 0 { return; }
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    let reach = sqrt(cx * cx + cy * cy);
    let now = f32(game.ticks()) * 0.001;
    let i = 0;
    while i < STREAKS {
        let seed = f32(i) * 7.31;
        let t = now * (1.6 + hash(seed) * 1.2) + hash(seed + 1);
        let pass = floor(t);
        let phase = t - pass;
        let a = hash(seed + pass * 3.7) * 2 * PI;
        let dx = cos(a);
        let dy = sin(a);
        let r0 = reach * (0.3 + phase * 0.7);
        let len = 50 + 120 * s;
        let alpha = u8(200 * (0.35 + 0.65 * s) * sin(phase * PI));
        game.setColor(game.rgba(235, 245, 255, alpha));
        let n = int(len / 4);
        let k = 0;
        while k < n {
            let f = f32(k) / f32(n);
            let r = r0 + len * f;
            let half = 1 + f * 1.6;
            rect(cx + dx * r - half, cy + dy * r - half, half * 2, half * 2);
            k += 1;
        }
        i += 1;
    }
}

fn banner(big: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(big, msg);
    pal.card(200);
    rect(cx - t.x * 0.5 - 20, y - 8, t.x + 40, t.y + 16);
    pal.aqua();
    game.drawText(big, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

/// The health bar's damage trail: how far it reaches, the pause before it drains, and last frame's
/// health and time.
#[singleton]
let trail: f32;
#[singleton]
let trailHold: f32;
#[singleton]
let lastFrac: f32;
#[singleton]
let trailAt: f32;

const COMPASS_W: f32 = 460;
/// Radians either side of straight ahead that the strip shows.
const COMPASS_SPAN: f32 = 1.3;
const COMPASS_Y: f32 = 10;

/// Angle `a` (radians) taken into -PI..PI.
fn wrapAngle(a: f32): f32 {
    let r = a;
    while r > PI { r = r - TAU; }
    while r < -PI { r = r + TAU; }
    return r;
}

/// Where on the strip a heading `rel` radians off ahead lands, or -1 when it is off the ends.
fn compassX(cx: f32, rel: f32): f32 {
    if abs(rel) > COMPASS_SPAN { return -1; }
    return cx + rel / COMPASS_SPAN * COMPASS_W * 0.5;
}

/// A marker for a spot `d` away from the player: fades toward the ends of the strip.
fn compassMark(cx: f32, heading: f32, d: Vec3, r: u8, g: u8, b: u8, size: f32) {
    let rel = wrapAngle(atan2(d.x, 0 - d.z) - heading);
    let x = compassX(cx, rel);
    if x < 0 { return; }
    let fade = 1 - (abs(rel) / COMPASS_SPAN) * (abs(rel) / COMPASS_SPAN);
    game.setColor(game.rgba(10, 10, 20, u8(220 * fade)));
    rect(x - size - 1.5, COMPASS_Y + 13 - size - 1.5, size * 2 + 3, size * 2 + 3);
    game.setColor(game.rgba(r, g, b, u8(255 * fade)));
    rect(x - size, COMPASS_Y + 13 - size, size * 2, size * 2);
}

/// A heading strip along the top: N, E, S, W and ticks every 15 degrees, with the bosses and
/// unbroken shrines as marks on it. North is toward -z, the top of the minimap.
fn compass(font: Font, p: &Player, bs: &Bosses, sh: &Shrines, sz: Vec2) {
    let cx = sz.x * 0.5;
    let fwd = Look.create(p.pos, p.yaw, 0).forward();
    let heading = atan2(fwd.x, 0 - fwd.z);
    pal.card(150);
    rect(cx - COMPASS_W * 0.5, COMPASS_Y, COMPASS_W, 26);
    let k = 0;
    while k < 24 {
        let rel = wrapAngle(f32(k) * PI / 12 - heading);
        let x = compassX(cx, rel);
        if x >= 0 {
            let fade = 1 - (abs(rel) / COMPASS_SPAN) * (abs(rel) / COMPASS_SPAN);
            if k % 6 == 0 {
                game.setColor(game.rgba(222, 229, 236, u8(255 * fade)));
                let letter = "N";
                if k == 6 { letter = "E"; }
                if k == 12 { letter = "S"; }
                if k == 18 { letter = "W"; }
                let t = game.textSize(font, letter);
                game.drawText(font, Vec2 { x: x - t.x * 0.5, y: COMPASS_Y + (26 - t.y) * 0.5 }, letter);
            } else {
                game.setColor(game.rgba(126, 232, 226, u8(160 * fade)));
                rect(x - 1, COMPASS_Y + 8, 2, 10);
            }
        }
        k += 1;
    }
    let here = level.inHollows(p.pos);
    let s = 0;
    while s < MAX_SHRINES {
        let sr = sh.list[s];
        s += 1;
        if sr.live && level.inHollows(sr.pos) == here { compassMark(cx, heading, sr.pos - p.pos, 255, 255, 255, 3); }
    }
    if bs.squadN > 0 {
        let q = 0;
        while q < bs.squadN {
            let sq = bs.squad[q];
            if sq.kind != 0 && level.inHollows(sq.pos) == here {
                let c = bosskit.accent(sq.kind);
                compassMark(cx, heading, sq.pos - p.pos, u8(255 * c.x), u8(255 * c.y), u8(255 * c.z), 5);
            }
            q += 1;
        }
    } else if bs.b.kind != 0 && level.inHollows(bs.b.pos) == here {
        let lone = bosskit.accent(bs.b.kind);
        compassMark(cx, heading, bs.b.pos - p.pos, u8(255 * lone.x), u8(255 * lone.y), u8(255 * lone.z), 5);
    }
    // Where you are facing: a notch on the middle.
    pal.aqua();
    rect(cx - 1.5, COMPASS_Y + 26, 3, 5);
}

/// Damage figures floating up off what was hit: white, gold for a big one, orange for the one
/// that killed. They shrink away as they fade.
fn numbers(font: Font, mid: Font, e: &Enemies) {
    let i = 0;
    while i < MAX_NUMS {
        let q = e.nums[i];
        i += 1;
        if q.t >= NUM_LIFE { continue; }
        let at = q.pos + Vec3.xyz(0, 0.3 + q.t * 1.8, 0);
        let s = gfx.toScreen(at);
        if s.z <= 0 { continue; }
        let a = u8(255 * clamp((1 - q.t / NUM_LIFE) * 2.5, 0, 1));
        let f = font;
        if q.val >= 30 { f = mid; }
        let msg = `{int(q.val + 0.5)}`;
        let t = game.textSize(f, msg);
        game.setColor(game.rgba(10, 10, 20, a));
        game.drawText(f, Vec2 { x: s.x - t.x * 0.5 + 1.5, y: s.y - t.y * 0.5 + 1.5 }, msg);
        if q.kill { game.setColor(game.rgba(255, 130, 60, a)); }
        else if q.val >= 100 { game.setColor(game.rgba(255, 220, 90, a)); }
        else { game.setColor(game.rgba(245, 248, 255, a)); }
        game.drawText(f, Vec2 { x: s.x - t.x * 0.5, y: s.y - t.y * 0.5 }, msg);
    }
}

pub fn draw(font: Font, mid: Font, big: Font, g: &Guns, p: &Player, e: &Enemies, ps: &Perks, bs: &Bosses, sh: &Shrines) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    // Red edges: a flash when hit, and a slow throb while low.
    let hurt = max(1 - p.hurtT * 3, 0);
    let low = max(1 - p.hp / 40, 0) * (0.7 + 0.3 * sin(f32(game.ticks()) * 0.008));
    let edge = max(hurt, low);
    if edge > 0.02 { vignette(sz, edge, 255, 20, 30); }
    if hurt > 0.02 {
        game.setColor(game.rgba(255, 20, 30, u8(min(hurt, 1) * 60)));
        rect(0, 0, sz.x, sz.y);
    }
    if scoped(g) {
        scope(sz);
    } else {
        speedLines(p, sz);
        // The spread cone's edge on screen.
        let gap = tan(spread(g) * PI / 180) / tan(fov(g) * 0.5 * PI / 180) * sz.y * 0.5;
        crosshair(cx, cy, max(gap, 4));
    }
    // Shot cooldown: a thin bar under the crosshair, only for guns slow enough to notice.
    let cool = cooldown(g);
    if cool > 0 && g.cdLen > 0.2 && reloading(g) <= 0 {
        game.setColor(game.rgba(10, 10, 20, 90));
        rect(cx - 17, cy + 21, 34, 4);
        game.setColor(game.rgba(235, 240, 255, 170));
        rect(cx - 16, cy + 22, 32 * (1 - cool), 2);
    }
    if g.bowDrawing {
        game.setColor(game.rgba(10, 10, 20, 100));
        rect(cx - 21, cy + 21, 42, 4);
        game.setColor(game.rgba(180, 230, 195, 190));
        rect(cx - 20, cy + 22, 40 * g.bowCharge, 2);
    }
    if e.killT > 0 { hitMarker(cx, cy, true); } else if e.hitT > 0 { hitMarker(cx, cy, false); }

    xpBar(font, e, ps, sz);
    compass(font, p, bs, sh, sz);
    numbers(font, mid, e);
    // Level, time and kills, top left under the minimap.
    let mins = int(e.time) / 60;
    let secs = int(e.time) % 60;
    panel(12, 208, 250, 34);
    pal.text();
    if secs < 10 {
        game.drawText(font, Vec2 { x: 22, y: 215 }, `LV {ps.level}    {mins}:0{secs}    {e.kills} KILLS`);
    } else {
        game.drawText(font, Vec2 { x: 22, y: 215 }, `LV {ps.level}    {mins}:{secs}    {e.kills} KILLS`);
    }
    // The biome you're in: its own enemies killed toward completing it.
    let tile = biome.at(p.pos.x, p.pos.z);
    if level.inHollows(p.pos) { tile = level.HOLLOWS; }
    if tile != 4 {
        let got = e.zoneKills[tile];
        let areaName = biome.name(tile);
        if level.inHollows(p.pos) { areaName = biome.name(level.HOLLOWS); }
        panel(12, 244, 250, 30);
        pal.aqua();
        if got >= ZONE_GOAL {
            game.drawText(font, Vec2 { x: 22, y: 250 }, `{areaName}  COMPLETE`);
        } else {
            game.drawText(font, Vec2 { x: 22, y: 250 }, `{areaName}  {got} / {ZONE_GOAL}`);
        }
    }
    if e.downT > 0 && !e.died {
        let dm = int(e.downTime) / 60;
        let ds = int(e.downTime) % 60;
        if ds < 10 { banner(big, cx, sz.y * 0.22, `DOWN AFTER {dm}:0{ds}`); } else { banner(big, cx, sz.y * 0.22, `DOWN AFTER {dm}:{ds}`); }
    }

    // Health, speed, dash and jump in one card, bottom left.
    let hx: f32 = 12;
    let hy = sz.y - 96;
    panel(hx, hy, 236, 82);
    let hw: f32 = 210;
    let frac = clamp(max(p.hp, 0) / maxHp(p), 0, 1);
    pal.raised();
    rect(hx + 16, hy + 12, hw, 20);
    // Recent damage: a pale strip that holds a moment, then drains down to the health.
    let now = f32(game.ticks()) * 0.001;
    let step = clamp(now - trailAt, 0, 0.1);
    trailAt = now;
    if frac < lastFrac - 0.001 { trailHold = 0.45; }
    lastFrac = frac;
    if trail < frac {
        trail = frac;
    } else if trailHold > 0 {
        trailHold = trailHold - step;
    } else {
        trail = max(trail - step * 0.5, frac);
    }
    if trail > frac {
        game.setColor(game.rgb(255, 214, 206));
        rect(hx + 16, hy + 12, hw * trail, 20);
    }
    if frac > 0.4 {
        pal.aqua();
    } else if sin(f32(game.ticks()) * 0.014) > 0 {
        game.setColor(game.rgb(255, 80, 70));
    } else {
        game.setColor(game.rgb(200, 50, 50));
    }
    rect(hx + 16, hy + 12, hw * frac, 20);
    // A tick at each quarter.
    pal.card(170);
    rect(hx + 16 + hw * 0.25 - 1, hy + 12, 2, 20);
    rect(hx + 16 + hw * 0.5 - 1, hy + 12, 2, 20);
    rect(hx + 16 + hw * 0.75 - 1, hy + 12, 2, 20);
    let hpText = `{int(max(p.hp, 0) + 0.5)} / {int(maxHp(p) + 0.5)}`;
    let hpSize = game.textSize(font, hpText);
    game.setColor(game.rgb(255, 255, 255));
    game.drawText(font, Vec2 { x: hx + 16 + (hw - hpSize.x) * 0.5, y: hy + 12 + (20 - hpSize.y) * 0.5 }, hpText);

    pal.text();
    game.drawText(font, Vec2 { x: hx + 16, y: hy + 48 }, `{int(hspeed(p) + 0.5)} m/s`);
    let ready = p.dashCd <= 0 && (p.onGround || p.airDashes > 0);
    pip(font, hx + 136, hy + 46, "E", ready, 0);
    if has(p, JETPACK) {
        // Fuel: a bar filling up from the bottom in the jump pip's place.
        pal.raised();
        rect(hx + 178, hy + 46, 24, 26);
        if p.fuel > 0.05 { pal.aqua(); } else { game.setColor(game.rgb(255, 80, 70)); }
        rect(hx + 178, hy + 72 - 26 * p.fuel, 24, 26 * p.fuel);
    } else {
        pip(font, hx + 178, hy + 46, "J", p.onGround || p.airJumps > 0, 1);
    }
    if has(p, TURRET) {
        panel(hx, hy - 30, 130, 24);
        pal.aqua();
        game.drawText(font, Vec2 { x: hx + 10, y: hy - 27 }, "G  TURRET");
    }

    // Gun strip, bottom right: the guns in hand, numbered in order, each as wide as its name.
    let x = sz.x - 8;
    let slot = 0;
    let i = GUNS - 1;
    while i >= 0 {
        if owned(g, p, i) { slot += 1; }
        i -= 1;
    }
    i = GUNS - 1;
    while i >= 0 {
        if owned(g, p, i) {
            let label = `{slot}  {g.list[i].name}`;
            let tw = game.textSize(font, label);
            let w = tw.x + 20 + ICON_W + 6;
            x = x - w - 8;
            let y = sz.y - 48;
            if i == g.cur { accent(g.list[i].boost > 0); } else { pal.card(190); }
            rect(x, y, w, 36);
            if i == g.cur { pal.onAqua(); } else { pal.text(); }
            game.drawText(font, Vec2 { x: x + 10 + ICON_W + 6, y: y + 8 }, label);
            icon(i, x + 10, y + 11);
            slot -= 1;
        }
        i -= 1;
    }

    ammo(font, big, g, p, sz);
}

/// A small key square: lit when the move is ready, dim while it recharges. `tone` is unused now.
fn pip(font: Font, x: f32, y: f32, key: string, ready: bool, tone: int) {
    if ready { pal.aqua(); } else { pal.raised(); }
    rect(x, y, 24, 26);
    let t = game.textSize(font, key);
    if ready { pal.onAqua(); } else { pal.faint(); }
    game.drawText(font, Vec2 { x: x + (24 - t.x) * 0.5, y: y + (26 - t.y) * 0.5 }, key);
}

/// XP bar along the very bottom, flashing on a pickup, with the level and progress on a tab
/// in the middle.
fn xpBar(font: Font, e: &Enemies, ps: &Perks, sz: Vec2) {
    let h: f32 = 10;
    let y = sz.y - h;
    let fill = clamp(f32(ps.xp) / f32(need(ps.level)), 0, 1);
    pal.card(200);
    rect(0, y, sz.x, h);
    if e.gemT > 0 { game.setColor(game.rgb(214, 255, 250)); } else { pal.aqua(); }
    rect(0, y + 2, sz.x * fill, h - 4);
    let label = `LV {ps.level}   {ps.xp} / {need(ps.level)}`;
    let t = game.textSize(font, label);
    let tx = (sz.x - t.x) * 0.5;
    pal.card(200);
    rect(tx - 12, y - t.y - 4, t.x + 24, t.y + 4);
    pal.aqua();
    game.drawText(font, Vec2 { x: tx, y: y - t.y - 2 }, label);
}

const ICON_W: f32 = 18;

fn bar(x: f32, y: f32, dx: f32, dy: f32, w: f32, h: f32) { rect(x + dx * 0.7, y + dy, max(w * 0.7, 2), h); }

/// An 18 x 14 silhouette (drawn on a 26-wide grid, squeezed) of gun `i` in the current colour, built from rectangles.
fn icon(i: int, x: f32, y: f32) {
    if i == 0 {
        bar(x, y, 0, 5, 18, 4); bar(x, y, 18, 6, 8, 2); bar(x, y, 6, 9, 4, 5); bar(x, y, 0, 3, 5, 8);
    } else if i == 1 {
        bar(x, y, 2, 3, 14, 4); bar(x, y, 16, 4, 6, 2); bar(x, y, 3, 7, 4, 7);
    } else if i == 2 {
        bar(x, y, 0, 4, 14, 6); bar(x, y, 14, 2, 4, 10); bar(x, y, 20, 5, 6, 4); bar(x, y, 4, 10, 3, 4);
    } else if i == 3 {
        bar(x, y, 0, 6, 26, 2); bar(x, y, 8, 3, 8, 3); bar(x, y, 0, 8, 6, 4);
    } else if i == 4 {
        bar(x, y, 7, 6, 19, 2); bar(x, y, 5, 3, 2, 8); bar(x, y, 0, 5, 5, 4);
    } else if i == 5 {
        bar(x, y, 0, 6, 20, 2); bar(x, y, 20, 5, 3, 4); bar(x, y, 23, 6, 3, 2);
    } else if i == 6 {
        bar(x, y, 8, 4, 18, 3); bar(x, y, 8, 8, 18, 3); bar(x, y, 0, 6, 10, 6);
    } else if i == 7 {
        bar(x, y, 2, 4, 20, 6); bar(x, y, 22, 3, 4, 8); bar(x, y, 8, 10, 3, 4);
    } else if i == 8 {
        bar(x, y, 8, 0, 2, 14); bar(x, y, 10, 0, 3, 2); bar(x, y, 10, 12, 3, 2); bar(x, y, 0, 6, 24, 2);
    } else if i == 9 {
        bar(x, y, 0, 7, 18, 2); bar(x, y, 21, 3, 2, 10); bar(x, y, 18, 7, 8, 2);
    } else if i == 10 {
        bar(x, y, 0, 5, 8, 4); bar(x, y, 8, 3, 2, 8); bar(x, y, 10, 5, 16, 4);
    } else {
        bar(x, y, 0, 8, 26, 3); bar(x, y, 4, 11, 4, 3); bar(x, y, 18, 11, 4, 3);
    }
}

/// Super ammo colours the ammo readout gold instead of aqua.
fn accent(super: bool) { if super { game.setColor(game.rgb(255, 196, 56)); } else { pal.aqua(); } }

/// Shots left above the gun strip, a pip per shot, and reload prompts under the crosshair.
fn ammo(font: Font, big: Font, g: &Guns, p: &Player, sz: Vec2) {
    let gun = current(g);
    let full = mag(gun, p);
    // Super ammo: a tag over the readout, with the uses left for a gun that has no magazine.
    if gun.boost > 0 {
        let tag = "SUPER";
        if full == 0 { tag = `SUPER x{gun.boost}`; }
        let tw = game.textSize(font, tag);
        panel(sz.x - 216, sz.y - 138, tw.x + 20, 24);
        accent(true);
        game.drawText(font, Vec2 { x: sz.x - 206, y: sz.y - 135 }, tag);
    }
    // No magazine (bow, knife, board): nothing to count.
    if full == 0 { return; }
    let r = reloading(g);
    let x = sz.x - 216;
    let y = sz.y - 112;
    panel(x, y, 208, 56);
    let low = gun.ammo * 4 <= full;
    if r > 0 {
        pal.mute();
    } else if low {
        game.setColor(game.rgb(255, 92, 84));
    } else {
        pal.text();
    }
    let count = `{gun.ammo}`;
    game.drawText(big, Vec2 { x: x + 10, y: y + 2 }, count);
    let cw = game.textSize(big, count);
    pal.mute();
    game.drawText(font, Vec2 { x: x + 16 + cw.x, y: y + 26 }, `/ {full}`);
    // Pips: full ones are shots left; while reloading they fill back up left to right.
    let pw = min(120 / f32(full), 18);
    let i = 0;
    while i < full {
        let lit = i < gun.ammo;
        if r > 0 { lit = f32(i) < r * f32(full); }
        if lit { accent(gun.boost > 0); } else { pal.raised(); }
        rect(x + 80 + f32(i) * pw, y + 10, max(pw - 2, 1), 10);
        i += 1;
    }

    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    if r > 0 {
        let bw: f32 = 140;
        pal.card(190);
        rect(cx - bw * 0.5, cy + 38, bw, 10);
        accent(gun.boost > 0);
        rect(cx - bw * 0.5, cy + 40, bw * r, 6);
        let msg = "RELOADING";
        let t = game.textSize(font, msg);
        pal.text();
        game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: cy + 52 }, msg);
    } else if low {
        // Blinks when empty, steady when just low.
        let warn = "LOW AMMO  [R]";
        if gun.ammo == 0 { warn = "RELOAD  [R]"; }
        let on = gun.ammo > 0 || sin(f32(game.ticks()) * 0.012) > 0;
        if on {
            let wt = game.textSize(font, warn);
            game.setColor(game.rgb(255, 90, 80));
            game.drawText(font, Vec2 { x: cx - wt.x * 0.5, y: cy + 40 }, warn);
        }
    }
}
