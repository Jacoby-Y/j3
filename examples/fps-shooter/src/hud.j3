// Crosshair, hit markers, sniper scope, gun strip, ammo, health, XP bar and level, speed and dash readouts,
// and the pause menu. Drawn after the 3D pass.

module fps_shooter.hud;

use j3.game;
use j3.game.Font;
use j3.gfx.Look;
use j3.math.{ PI, Vec2, abs, atan2, clamp, cos, floor, max, min, sin, sqrt, tan };
use j3.ui.{ Theme, Ui };
use fps_shooter.biome;
use fps_shooter.enemies.{ Enemies, MAX_ENEMIES, ZONE_GOAL, color };
use fps_shooter.perks.{ Perks, need };
use fps_shooter.guns.{ Guns, GUNS, cooldown, current, fov, mag, owned, reloading, scoped, spread };
use fps_shooter.player.{ Player, has, hspeed, maxHp, JETPACK, TURRET };
use fps_shooter.sfx;

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

/// Four arms around the middle, `gap` pixels out, with a dark outline.
fn crosshair(x: f32, y: f32, gap: f32) {
    let len: f32 = 8;
    game.setColor(game.rgba(10, 10, 20, 170));
    rect(x - gap - len - 1, y - 2, len + 2, 4);
    rect(x + gap - 1, y - 2, len + 2, 4);
    rect(x - 2, y - gap - len - 1, 4, len + 2);
    rect(x - 2, y + gap - 1, 4, len + 2);
    game.setColor(game.rgb(255, 255, 255));
    rect(x - gap - len, y - 1, len, 2);
    rect(x + gap, y - 1, len, 2);
    rect(x - 1, y - gap - len, 2, len);
    rect(x - 1, y + gap, 2, len);
    rect(x - 1, y - 1, 2, 2);
}

/// Black around a square window, with a thin reticle.
fn scope(sz: Vec2) {
    let s = min(sz.x, sz.y) * 0.92;
    let x0 = (sz.x - s) * 0.5;
    let y0 = (sz.y - s) * 0.5;
    game.setColor(game.rgb(0, 0, 0));
    rect(0, 0, x0, sz.y);
    rect(x0 + s, 0, sz.x - x0 - s, sz.y);
    rect(x0, 0, s, y0);
    rect(x0, y0 + s, s, sz.y - y0 - s);
    // Rounded-ish corners: step the black in.
    let k = 0;
    while k < 6 {
        let c = s * 0.22 * (1 - f32(k) / 6);
        let h = s * 0.035;
        rect(x0, y0 + f32(k) * h, c, h);
        rect(x0 + s - c, y0 + f32(k) * h, c, h);
        rect(x0, y0 + s - f32(k + 1) * h, c, h);
        rect(x0 + s - c, y0 + s - f32(k + 1) * h, c, h);
        k += 1;
    }
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    rect(x0, cy - 1, s, 2);
    rect(cx - 1, y0, 2, s);
    game.setColor(game.rgb(255, 60, 90));
    rect(cx - 2, cy - 2, 4, 4);
}

/// Four dots out on the diagonals: a hit, or a kill in red.
fn hitMarker(x: f32, y: f32, kill: bool) {
    if kill { game.setColor(game.rgb(255, 60, 60)); } else { game.setColor(game.rgb(255, 255, 255)); }
    let k = 0;
    while k < 4 {
        let d = 7 + f32(k) * 2;
        rect(x - d - 1.5, y - d - 1.5, 3, 3);
        rect(x + d - 1.5, y - d - 1.5, 3, 3);
        rect(x - d - 1.5, y + d - 1.5, 3, 3);
        rect(x + d - 1.5, y + d - 1.5, 3, 3);
        k += 1;
    }
}

/// Speed lines start above sprint (about 13 m/s) and are full at the 30 m/s air cap.
const STREAK_FROM: f32 = 15;
const STREAK_FULL: f32 = 30;
const STREAKS: int = 28;

/// Fixed pseudo-random 0..1 per `n`.
fn hash(n: f32): f32 {
    let x = sin(n * 12.9898) * 43758.547;
    return x - floor(x);
}

/// Slipstream: streaks rushing out from the middle toward the edges, made of shrinking
/// squares (the GL hud has no lines). Each streak picks a new angle every pass.
fn speedLines(p: &Player, sz: Vec2) {
    let s = clamp((hspeed(p) - STREAK_FROM) / (STREAK_FULL - STREAK_FROM), 0, 1);
    if s <= 0 { return; }
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    let reach = sqrt(cx * cx + cy * cy);
    let now = f32(game.ticks()) * 0.001;
    let i = 0;
    while i < STREAKS {
        let seed = f32(i) * 7.31;
        let t = now * (1.6 + hash(seed) * 1.2) + hash(seed + 1);
        let pass = floor(t);
        let phase = t - pass;
        let a = hash(seed + pass * 3.7) * 2 * PI;
        let dx = cos(a);
        let dy = sin(a);
        // Out from 35% of the way to the corner; longer and brighter the faster you go.
        let r0 = reach * (0.35 + phase * 0.65);
        let len = reach * (0.06 + 0.14 * s);
        let alpha = u8(150 * s * sin(phase * PI));
        game.setColor(game.rgba(235, 245, 255, alpha));
        let k = 0;
        while k < 6 {
            let r = r0 + len * f32(k) / 6;
            let half = 0.6 + f32(k) * 0.25;
            rect(cx + dx * r - half, cy + dy * r - half, half * 2, half * 2);
            k += 1;
        }
        i += 1;
    }
}

fn banner(big: Font, cx: f32, y: f32, msg: string) {
    let t = game.textSize(big, msg);
    game.setColor(game.rgba(20, 24, 40, 170));
    rect(cx - t.x * 0.5 - 20, y - 8, t.x + 40, t.y + 16);
    game.setColor(game.rgb(255, 220, 90));
    game.drawText(big, Vec2 { x: cx - t.x * 0.5, y: y }, msg);
}

/// `cards`: a card pick is up, so no pause menu.
pub fn draw(font: Font, big: Font, g: &Guns, p: &Player, e: &Enemies, ps: &Perks, cards: bool) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    // Red flash when hit, and a red edge while low.
    let hurt = max(1 - p.hurtT * 3, 0) * 90 + max(1 - p.hp / 40, 0) * 50;
    if hurt > 1 {
        game.setColor(game.rgba(255, 20, 30, u8(min(hurt, 200))));
        rect(0, 0, sz.x, sz.y);
    }
    if scoped(g) {
        scope(sz);
    } else {
        speedLines(p, sz);
        // The spread cone's edge on screen.
        let gap = tan(spread(g) * PI / 180) / tan(fov(g) * 0.5 * PI / 180) * sz.y * 0.5;
        crosshair(cx, cy, max(gap, 4));
    }
    // Shot cooldown: a thin bar under the crosshair, only for guns slow enough to notice.
    let cool = cooldown(g);
    if cool > 0 && g.cdLen > 0.2 && reloading(g) <= 0 {
        game.setColor(game.rgba(10, 10, 20, 90));
        rect(cx - 17, cy + 21, 34, 4);
        game.setColor(game.rgba(235, 240, 255, 170));
        rect(cx - 16, cy + 22, 32 * (1 - cool), 2);
    }
    if g.bowDrawing {
        game.setColor(game.rgba(10, 10, 20, 100));
        rect(cx - 21, cy + 21, 42, 4);
        game.setColor(game.rgba(180, 230, 195, 190));
        rect(cx - 20, cy + 22, 40 * g.bowCharge, 2);
    }
    if e.killT > 0 { hitMarker(cx, cy, true); } else if e.hitT > 0 { hitMarker(cx, cy, false); }

    xpBar(font, e, ps, sz);
    // Level, time and kills, top left under the minimap.
    let mins = int(e.time) / 60;
    let secs = int(e.time) % 60;
    game.setColor(game.rgba(20, 24, 40, 150));
    rect(12, 208, 250, 34);
    game.setColor(game.rgb(230, 230, 240));
    if secs < 10 {
        game.drawText(font, Vec2 { x: 22, y: 215 }, `LV {ps.level}    {mins}:0{secs}    {e.kills} KILLS`);
    } else {
        game.drawText(font, Vec2 { x: 22, y: 215 }, `LV {ps.level}    {mins}:{secs}    {e.kills} KILLS`);
    }
    // The biome you're in: its own enemies killed toward completing it.
    let tile = biome.at(p.pos.x, p.pos.z);
    if tile != 4 {
        let got = e.zoneKills[tile];
        game.setColor(game.rgba(20, 24, 40, 150));
        rect(12, 244, 250, 30);
        game.setColor(game.rgb(255, 215, 90));
        if got >= ZONE_GOAL {
            game.drawText(font, Vec2 { x: 22, y: 250 }, `{biome.name(tile)}  COMPLETE`);
        } else {
            game.drawText(font, Vec2 { x: 22, y: 250 }, `{biome.name(tile)}  {got} / {ZONE_GOAL}`);
        }
    }
    if e.downT > 0 {
        let dm = int(e.downTime) / 60;
        let ds = int(e.downTime) % 60;
        if ds < 10 { banner(big, cx, sz.y * 0.22, `DOWN AFTER {dm}:0{ds}`); } else { banner(big, cx, sz.y * 0.22, `DOWN AFTER {dm}:{ds}`); }
    }

    // Health, above the speed panel.
    let hw: f32 = 150;
    game.setColor(game.rgba(20, 24, 40, 150));
    rect(12, sz.y - 74, hw, 20);
    let frac = max(p.hp, 0) / maxHp(p);
    if frac > 0.4 { game.setColor(game.rgb(120, 240, 110)); } else { game.setColor(game.rgb(255, 80, 70)); }
    rect(14, sz.y - 72, (hw - 4) * frac, 16);
    game.setColor(game.rgb(20, 24, 40));
    game.drawText(font, Vec2 { x: 20, y: sz.y - 73 }, `{int(max(p.hp, 0) + 0.5)}`);

    // Gun strip, bottom right: the guns in hand, numbered in order, each as wide as its name.
    let x = sz.x - 8;
    let slot = 0;
    let i = GUNS - 1;
    while i >= 0 {
        if owned(g, p, i) { slot += 1; }
        i -= 1;
    }
    i = GUNS - 1;
    while i >= 0 {
        if owned(g, p, i) {
            let label = `{slot}  {g.list[i].name}`;
            let tw = game.textSize(font, label);
            let w = tw.x + 20;
            x = x - w - 8;
            let y = sz.y - 48;
            if i == g.cur {
                game.setColor(game.rgba(255, 200, 60, 230));
            } else {
                game.setColor(game.rgba(20, 24, 40, 150));
            }
            rect(x, y, w, 36);
            if i == g.cur { game.setColor(game.rgb(30, 20, 10)); } else { game.setColor(game.rgb(230, 230, 240)); }
            game.drawText(font, Vec2 { x: x + 10, y: y + 8 }, label);
            slot -= 1;
        }
        i -= 1;
    }

    // Speed and dash, bottom left.
    game.setColor(game.rgba(20, 24, 40, 150));
    rect(12, sz.y - 48, 150, 36);
    game.setColor(game.rgb(230, 230, 240));
    game.drawText(font, Vec2 { x: 22, y: sz.y - 40 }, `{int(hspeed(p) + 0.5)} m/s`);
    let ready = p.dashCd <= 0 && (p.onGround || p.airDashes > 0);
    if ready { game.setColor(game.rgb(80, 230, 255)); } else { game.setColor(game.rgb(70, 70, 90)); }
    rect(110, sz.y - 38, 16, 16);
    if has(p, JETPACK) {
        // Fuel: a bar filling up from the bottom in the jump pip's place.
        game.setColor(game.rgb(70, 70, 90));
        rect(134, sz.y - 44, 16, 28);
        if p.fuel > 0.05 { game.setColor(game.rgb(255, 170, 60)); } else { game.setColor(game.rgb(255, 80, 70)); }
        rect(134, sz.y - 16 - 28 * p.fuel, 16, 28 * p.fuel);
    } else {
        if p.onGround || p.airJumps > 0 { game.setColor(game.rgb(140, 255, 120)); } else { game.setColor(game.rgb(70, 70, 90)); }
        rect(134, sz.y - 38, 16, 16);
    }
    if has(p, TURRET) {
        game.setColor(game.rgba(20, 24, 40, 150));
        rect(12, sz.y - 102, 110, 24);
        game.setColor(game.rgb(130, 240, 190));
        game.drawText(font, Vec2 { x: 20, y: sz.y - 99 }, "G  TURRET");
    }

    ammo(font, big, g, p, sz);
    if !game.mouseCaptured() && !cards { pause(font, big, p, sz); }
}

/// XP bar along the very bottom, flashing on a pickup, with the level and progress on a tab
/// in the middle.
fn xpBar(font: Font, e: &Enemies, ps: &Perks, sz: Vec2) {
    let h: f32 = 10;
    let y = sz.y - h;
    let fill = clamp(f32(ps.xp) / f32(need(ps.level)), 0, 1);
    game.setColor(game.rgba(10, 12, 24, 190));
    rect(0, y, sz.x, h);
    if e.gemT > 0 { game.setColor(game.rgb(200, 255, 170)); } else { game.setColor(game.rgb(130, 230, 60)); }
    rect(0, y + 2, sz.x * fill, h - 4);
    let label = `LV {ps.level}   {ps.xp} / {need(ps.level)}`;
    let t = game.textSize(font, label);
    let tx = (sz.x - t.x) * 0.5;
    game.setColor(game.rgba(10, 12, 24, 190));
    rect(tx - 12, y - t.y - 4, t.x + 24, t.y + 4);
    game.setColor(game.rgb(170, 245, 110));
    game.drawText(font, Vec2 { x: tx, y: y - t.y - 2 }, label);
}

/// Enemies closer than this get no pointer.
const NEAR: f32 = 10;

/// A small tick on a ring around the crosshair for each enemy that isn't right next to you,
/// pointing its way (up is ahead). Nearer ones are stronger. Not drawn right now.
fn pointers(e: &Enemies, p: &Player, sz: Vec2) {
    let view = Look.create(p.pos, p.yaw, 0);
    let fwd = view.forward();
    let right = view.right();
    let ring: f32 = 70;
    let i = 0;
    while i < MAX_ENEMIES {
        let en = e.list[i];
        if en.kind != 0 {
            let d = en.pos - p.pos;
            let ahead = d.x * fwd.x + d.z * fwd.z;
            let side = d.x * right.x + d.z * right.z;
            let far = d.length();
            // Always on, except for enemies right on top of you.
            if far > NEAR {
                let a = atan2(side, ahead);
                let strength = clamp(1 - far / 60, 0.45, 1);
                let alpha = u8(235 * strength);
                // Three shrinking squares outward read as a point: a dark backing, then the color.
                let k = 0;
                while k < 6 {
                    let rr = ring + f32(k % 3) * 5;
                    let half = 4 - f32(k % 3) * 1.2;
                    if k < 3 {
                        half = half + 1.5;
                        game.setColor(game.rgba(10, 10, 20, u8(140 * strength)));
                    } else {
                        let c = color(en.kind);
                        game.setColor(game.rgba(u8(80 + 175 * c.x), u8(80 + 175 * c.y), u8(80 + 175 * c.z), alpha));
                    }
                    rect(sz.x * 0.5 + sin(a) * rr - half, sz.y * 0.5 - cos(a) * rr - half, half * 2, half * 2);
                    k += 1;
                }
            }
        }
        i += 1;
    }
}

/// Shots left above the gun strip, a pip per shot, and reload prompts under the crosshair.
fn ammo(font: Font, big: Font, g: &Guns, p: &Player, sz: Vec2) {
    let gun = current(g);
    let full = mag(gun, p);
    // No magazine (bow, knife, board): nothing to count.
    if full == 0 { return; }
    let r = reloading(g);
    let x = sz.x - 216;
    let y = sz.y - 112;
    game.setColor(game.rgba(20, 24, 40, 150));
    rect(x, y, 208, 56);
    let low = gun.ammo * 4 <= full;
    if r > 0 {
        game.setColor(game.rgb(140, 150, 170));
    } else if low {
        game.setColor(game.rgb(255, 80, 70));
    } else {
        game.setColor(game.rgb(255, 255, 255));
    }
    let count = `{gun.ammo}`;
    game.drawText(big, Vec2 { x: x + 10, y: y + 2 }, count);
    let cw = game.textSize(big, count);
    game.setColor(game.rgb(150, 155, 175));
    game.drawText(font, Vec2 { x: x + 16 + cw.x, y: y + 26 }, `/ {full}`);
    // Pips: full ones are shots left; while reloading they fill back up left to right.
    let pw = min(120 / f32(full), 18);
    let i = 0;
    while i < full {
        let lit = i < gun.ammo;
        if r > 0 { lit = f32(i) < r * f32(full); }
        if lit { game.setColor(game.rgb(255, 200, 60)); } else { game.setColor(game.rgba(80, 85, 105, 200)); }
        rect(x + 80 + f32(i) * pw, y + 10, max(pw - 2, 1), 10);
        i += 1;
    }

    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    if r > 0 {
        let bw: f32 = 140;
        game.setColor(game.rgba(20, 24, 40, 170));
        rect(cx - bw * 0.5 - 2, cy + 38, bw + 4, 10);
        game.setColor(game.rgb(255, 200, 60));
        rect(cx - bw * 0.5, cy + 40, bw * r, 6);
        let msg = "RELOADING";
        let t = game.textSize(font, msg);
        game.setColor(game.rgb(255, 255, 255));
        game.drawText(font, Vec2 { x: cx - t.x * 0.5, y: cy + 52 }, msg);
    } else if low {
        // Blinks when empty, steady when just low.
        let warn = "LOW AMMO  [R]";
        if gun.ammo == 0 { warn = "RELOAD  [R]"; }
        let on = gun.ammo > 0 || sin(f32(game.ticks()) * 0.012) > 0;
        if on {
            let wt = game.textSize(font, warn);
            game.setColor(game.rgb(255, 90, 80));
            game.drawText(font, Vec2 { x: cx - wt.x * 0.5, y: cy + 40 }, warn);
        }
    }
}

/// Dim the game and show a panel with sensitivity sliders, resume and quit.
fn pause(font: Font, big: Font, p: &Player, sz: Vec2) {
    game.setColor(game.rgba(10, 12, 24, 150));
    rect(0, 0, sz.x, sz.y);
    let pw: f32 = 380;
    let ph: f32 = 330;
    let x = (sz.x - pw) * 0.5;
    let y = (sz.y - ph) * 0.5 + 24;
    let title = "PAUSED";
    let t = game.textSize(big, title);
    game.setColor(game.rgb(255, 220, 90));
    game.drawText(big, Vec2 { x: (sz.x - t.x) * 0.5, y: y - t.y - 14 }, title);

    let ui = Ui.begin(font, x, y);
    ui.theme = Theme {
        text: game.rgb(240, 240, 250), button: game.rgb(38, 44, 70), buttonHot: game.rgb(62, 72, 110),
        buttonDown: game.rgb(28, 32, 52), panel: game.rgba(20, 24, 40, 235), edge: game.rgb(255, 200, 60),
        accent: game.rgb(255, 200, 60),
    };
    ui.h = 32;
    ui.panel(pw, ph);
    ui.label(`Look sensitivity   {int(p.sens * 100 + 0.5)}%`);
    ui.pushId(1);
    ui.slider("", &p.sens, 0.2, 3);
    ui.popId();
    ui.gap(4);
    ui.label(`Aim sensitivity   {int(p.adsSens * 100 + 0.5)}%`);
    ui.pushId(2);
    ui.slider("", &p.adsSens, 0.2, 2);
    ui.popId();
    ui.gap(4);
    ui.label(`Volume   {int(p.volume + 0.5)}%`);
    ui.pushId(3);
    if ui.slider("", &p.volume, 0, 100) { sfx.volume(p.volume); }
    ui.popId();
    ui.gap(14);
    if ui.button("Resume") { game.captureMouse(true); }
    if ui.button("Quit") { game.requestQuit(); }
    ui.end();

    let hint = "ESC resume   WASD move  SPACE jump x2  SHIFT sprint  E dash  CTRL slide  RMB aim  R reload  wheel/1-8 guns  Q skill  G turret";
    let ht = game.textSize(font, hint);
    game.setColor(game.rgb(200, 205, 225));
    game.drawText(font, Vec2 { x: (sz.x - ht.x) * 0.5, y: y + ph + 20 }, hint);
}
