/// Opt-in deterministic workloads. J3_FPS_BENCH=opening|populated|pack.
/// Capture normal presentation without J3_FRAMES, which forces glFinish.
module fps_shooter.perf;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}
use j3.game;
use j3.game.FrameStats;
use j3.gfx;
use j3.gfx.Instance;
use j3.math.{ Mat4, Vec3, sin, cos, TAU };
use j3.memory.Arena;
use j3.text.{ Text, cstr };
use j3.io.printLn;
use j3.sys.panic;
use fps_shooter.enemies;
use fps_shooter.enemies.Enemies;
use fps_shooter.player.Player;
use fps_shooter.player;
use fps_shooter.sfx;
use fps_shooter.level;
use fps_shooter.level.Level;

struct Sample {
    frame: FrameStats;
    ai: f32;
    gems: f32;
    effects: f32;
    prepare: f32;
    scene: f32;
    event: bool;
    living: int;
    active: int;
}

pub struct Perf {
    mode: int = 0;
    started: int = 0;
    count: int = 0;
    frame: int = 0;
    event: bool = false;
    lastEvent: bool = false;
    prepareMs: f32 = 0;
    sceneMs: f32 = 0;
    samples: []Sample;
    shots: []Instance;
    velocities: []Vec3;
    ages: []f32;
    quick: bool = false;
}

fn env(name: string): string {
    let raw = libc.getenv(cstr(name));
    if raw == 0 { return ""; }
    return []u8 { ptr: raw as &u8, len: libc.strlen(raw) } as string;
}

fn same(a: string, b: string): bool {
    if a.len != b.len { return false; }
    let i = 0;
    while i < a.len { if a[i] != b[i] { return false; } i += 1; }
    return true;
}

pub fn create(mem: &Arena, bench: string): Perf {
    let setting = bench;
    if setting.len == 0 { setting = env("J3_FPS_BENCH"); }
    let mode = 0;
    if same(setting, "opening") { mode = 1; }
    if same(setting, "populated") { mode = 2; }
    if same(setting, "pack") { mode = 3; }
    return Perf { mode: mode, samples: mem.alloc::<Sample>(if mode > 0 { 300000 } else { 0 }),
        shots: mem.alloc::<Instance>(64),
        velocities: mem.alloc::<Vec3>(64), ages: mem.alloc::<f32>(64), quick: same(env("J3_FPS_QUICK"), "1") };
}

pub fn start(b: &Perf, e: &Enemies, p: &Player, lvl: &Level) {
    if b.mode == 0 { return; }
    if b.mode == 1 { enemies.benchmarkOpening(e, p, lvl); }
    if b.mode > 1 {
        lvl.open = 511;
        level.setGates(lvl);
        enemies.benchmarkFill(e, p, lvl, b.mode == 3);
    }
    b.started = game.micros();
    game.captureMouse(true);
}

/// Samples the preceding completed frame before modifying simulation state.
pub fn capture(b: &Perf, e: &Enemies) {
    if b.mode == 0 { return; }
    let elapsed = game.micros() - b.started;
    let warm = if b.quick { 1000000 } else { 10000000 };
    let duration = if b.quick { 3000000 } else { 60000000 };
    if elapsed >= warm && elapsed < warm + duration {
        if b.count >= b.samples.len { panic("performance sample buffer full"); }
        let active = 0;
        let living = 0;
        let i = 0;
        while i < e.list.len {
            if e.list[i].kind != 0 {
                living += 1;
                if e.list[i].active { active += 1; }
            }
            i += 1;
        }
        b.samples[b.count] = Sample { frame: game.lastFrameStats(), ai: e.aiMs, gems: e.gemMs,
            effects: e.effectsMs, prepare: b.prepareMs, scene: b.sceneMs, event: b.lastEvent,
            living: living, active: active };
        b.count += 1;
    }
    if elapsed >= warm + duration {
        report(b);
        game.requestQuit();
    }
}

/// Fixed 100 Hz simulation per rendered frame; route repeats every 60 simulation seconds.
pub fn update(b: &Perf, e: &Enemies, p: &Player, lvl: &Level) {
    if b.mode == 0 { return; }
    b.frame += 1;
    b.event = false;
    let t = f32(b.frame % 6000) * 0.01;
    if b.mode > 1 {
        let tile = (b.frame % 6000) * 9 / 6000;
        let center = Vec3.xyz(-110 + f32(tile % 3) * 110, 8, -110 + f32(tile / 3) * 110);
        p.pos = center + Vec3.xyz(cos(t * 0.6) * 15, sin(t * 0.4) * 3, sin(t * 0.6) * 15);
        p.yaw = t * 0.6;
        p.pitch = -0.12;
        let ear = player.look(p);
        sfx.listen(ear.eye, ear.forward(), ear.right());
        if b.frame % 200 == 1 { enemies.benchmarkFill(e, p, lvl, b.mode == 3); }
        enemies.benchmarkOrbs(e, p);
        if b.mode == 3 && b.frame % 200 == 100 {
            enemies.benchmarkKill(e);
            b.event = true;
        }
        let i = 0;
        while i < 64 {
            b.ages[i] -= 0.01;
            let m = b.shots[i].model;
            let at = Vec3.xyz(m.m[12], m.m[13], m.m[14]);
            if b.ages[i] <= 0 || level.solid(lvl, at, 0.2) >= 0 {
                let a = f32(i) * TAU / 64;
                at = p.pos + Vec3.xyz(cos(a) * 18, 4 + f32(i % 4), sin(a) * 18);
                b.velocities[i] = Vec3.xyz(-cos(a) * 12, -1, -sin(a) * 12);
                b.ages[i] = 3;
            }
            at = at + b.velocities[i] * 0.01;
            b.shots[i] = Instance { model: Mat4.translate(at.x, at.y, at.z).mul(Mat4.scale(0.4, 0.4, 0.4)),
                tint: Vec3.xyz(1, 0.2, 0.05), emission: Vec3.xyz(2, 0.4, 0.1) };
            i += 1;
        }
    }
    p.hp = 10000;
    p.hurtT = 100;
    b.lastEvent = b.event;
}

pub fn draw(b: &Perf, e: &Enemies) {
    if b.mode < 2 { return; }
    if gfx.inCameraPass() { gfx.drawInstances(e.cube, b.shots); }
}

fn number(t: &Text, v: f32) { t.pushInt(int(v * 1000)); t.push(44); }

fn report(b: &Perf) {
    printLn("FPSPERF frame_us,cpu_us,shadow_us,camera_us,ui_us,ai_us,gems_us,effects_us,prepare_us,scene_us,draws,tris,event,living,active");
    let mem = Arena.create(4096);
    let i = 0;
    while i < b.count {
        let row = b.samples[i];
        let t = Text.new(&mem);
        number(&t, row.frame.frameMs); number(&t, row.frame.cpuMs);
        number(&t, row.frame.shadowMs); number(&t, row.frame.cameraMs); number(&t, row.frame.uiMs);
        number(&t, row.ai); number(&t, row.gems); number(&t, row.effects);
        number(&t, row.prepare); number(&t, row.scene);
        t.pushInt(row.frame.draws); t.push(44); t.pushInt(row.frame.tris); t.push(44);
        t.pushInt(if row.event { 1 } else { 0 }); t.push(44);
        t.pushInt(row.living); t.push(44); t.pushInt(row.active);
        printLn(t.str());
        mem.rewind(0);
        i += 1;
    }
}
