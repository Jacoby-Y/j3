// Synthesizes assets/sfx/*.wav (16-bit mono, 44.1 kHz) from noise, sines, and envelopes.
// Run from the project directory: j3c run tools/sfx.j3s

use j3.io.{ printLn, writeFile };
use j3.math.{ abs, exp, sin, TAU };
use j3.memory.Arena;
use j3.rand.Rng;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

const RATE: int = 44100;
const SINE: int = 0;
const SQUARE: int = 1;
const SAW: int = 2;

fn nsec(sec: f32): int {
    let n = int(sec * f32(RATE));
    if n < 1 { return 1; }
    return n;
}

fn noise(mem: &Arena, rng: &Rng, sec: f32): []f32 {
    let count = nsec(sec);
    let out = mem.alloc::<f32>(count);
    let i = 0;
    while i < count {
        out[i] = rng.floatRange(-1.0, 1.0);
        i += 1;
    }
    return out;
}

fn tone(mem: &Arena, sec: f32, f0: f32, f1: f32, shape: int): []f32 {
    let count = nsec(sec);
    let out = mem.alloc::<f32>(count);
    let ph: f32 = 0.0;
    let i = 0;
    while i < count {
        let denom = count;
        if denom < 1 { denom = 1; }
        let f = f0 + (f1 - f0) * f32(i) / f32(denom);
        ph += f / f32(RATE);
        let x = ph - f32(int(ph));
        if shape == SQUARE {
            if x < 0.5 { out[i] = 1.0; } else { out[i] = -1.0; }
        } else if shape == SAW {
            out[i] = 2.0 * x - 1.0;
        } else {
            out[i] = sin(x * TAU);
        }
        i += 1;
    }
    return out;
}

fn env(mem: &Arena, xs: []f32, attack: f32, decay: f32): []f32 {
    let out = mem.alloc::<f32>(xs.len);
    let a = nsec(attack);
    let i = 0;
    while i < xs.len {
        let g: f32 = 0.0;
        if i < a {
            g = f32(i) / f32(a);
        } else {
            g = exp(0.0 - f32(i - a) / (decay * f32(RATE)));
        }
        out[i] = xs[i] * g;
        i += 1;
    }
    return out;
}

fn lowpass(mem: &Arena, xs: []f32, k: f32): []f32 {
    let out = mem.alloc::<f32>(xs.len);
    let y: f32 = 0.0;
    let i = 0;
    while i < xs.len {
        y += k * (xs[i] - y);
        out[i] = y;
        i += 1;
    }
    return out;
}

fn mix(mem: &Arena, tracks: [][]f32): []f32 {
    let size = 0;
    let i = 0;
    while i < tracks.len {
        if tracks[i].len > size { size = tracks[i].len; }
        i += 1;
    }
    let out = mem.alloc::<f32>(size);
    i = 0;
    while i < size {
        let sum: f32 = 0.0;
        let t = 0;
        while t < tracks.len {
            if i < tracks[t].len { sum += tracks[t][i]; }
            t += 1;
        }
        out[i] = sum;
        i += 1;
    }
    return out;
}

fn gain(mem: &Arena, xs: []f32, g: f32): []f32 {
    let out = mem.alloc::<f32>(xs.len);
    let i = 0;
    while i < xs.len {
        out[i] = xs[i] * g;
        i += 1;
    }
    return out;
}

fn pad(mem: &Arena, xs: []f32, sec: f32): []f32 {
    let lead = 0;
    if sec > 0.0 { lead = int(sec * f32(RATE)); }
    let out = mem.alloc::<f32>(lead + xs.len);
    let i = 0;
    while i < lead {
        out[i] = 0.0;
        i += 1;
    }
    i = 0;
    while i < xs.len {
        out[lead + i] = xs[i];
        i += 1;
    }
    return out;
}

fn pushU16(t: &Text, n: int) {
    let v = n;
    if v < 0 { v = 0; }
    t.push((v % 256) as u8);
    t.push((v / 256 % 256) as u8);
}

fn pushU32(t: &Text, n: int) {
    let v = n;
    if v < 0 { v = 0; }
    t.push((v % 256) as u8);
    t.push((v / 256 % 256) as u8);
    t.push((v / 65536 % 256) as u8);
    t.push((v / 16777216) as u8);
}

fn pushI16(t: &Text, sample: int) {
    let n = sample;
    if n > 32767 { n = 32767; }
    if n < 0 - 32768 { n = 0 - 32768; }
    if n < 0 { n = n + 65536; }
    t.push((n % 256) as u8);
    t.push((n / 256) as u8);
}

fn writeWav(mem: &Arena, name: string, xs: []f32, vol: f32) {
    let peak: f32 = 0.000001;
    let i = 0;
    while i < xs.len {
        let a = abs(xs[i]);
        if a > peak { peak = a; }
        i += 1;
    }
    let t = Text.new(mem);
    let data = xs.len * 2;
    t.pushStr("RIFF");
    pushU32(&t, 36 + data);
    t.pushStr("WAVE");
    t.pushStr("fmt ");
    pushU32(&t, 16);
    pushU16(&t, 1);
    pushU16(&t, 1);
    pushU32(&t, RATE);
    pushU32(&t, RATE * 2);
    pushU16(&t, 2);
    pushU16(&t, 16);
    t.pushStr("data");
    pushU32(&t, data);
    i = 0;
    while i < xs.len {
        let s = xs[i] / peak * vol;
        if s > 1.0 { s = 1.0; }
        if s < -1.0 { s = -1.0; }
        pushI16(&t, int(s * 32767.0));
        i += 1;
    }
    let path = Text.new(mem);
    path.pushStr("assets/sfx/");
    path.pushStr(name);
    path.pushStr(".wav");
    match writeFile(path.str(), t.bytes) {
        Result.Ok(_) { }
        Result.Err(_) { panic(`could not write {path.str()}`); }
    }
}

fn click(mem: &Arena, rng: &Rng, sec: f32, k: f32): []f32 {
    return env(mem, lowpass(mem, noise(mem, rng, sec), k), 0.001, 0.006);
}

fn pair(mem: &Arena, a: []f32, b: []f32): []f32 {
    let tracks: [2][]f32 = [a, b];
    return mix(mem, tracks[:]);
}

fn trio(mem: &Arena, a: []f32, b: []f32, c: []f32): []f32 {
    let tracks: [3][]f32 = [a, b, c];
    return mix(mem, tracks[:]);
}

fn quad(mem: &Arena, a: []f32, b: []f32, c: []f32, d: []f32): []f32 {
    let tracks: [4][]f32 = [a, b, c, d];
    return mix(mem, tracks[:]);
}

pub fn main() {
    let mem = Arena.create(8 * 1024 * 1024);
    let rng = Rng.new(3);

    let mark = mem.checkpoint();
    writeWav(&mem, "shot", pair(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.18), 0.35), 0.001, 0.03),
        env(&mem, tone(&mem, 0.15, 180.0, 60.0, SINE), 0.001, 0.04)), 0.55);
    mem.rewind(mark);

    writeWav(&mem, "shotgun", pair(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.5), 0.25), 0.002, 0.09),
        env(&mem, tone(&mem, 0.35, 110.0, 40.0, SINE), 0.002, 0.08)), 0.8);
    mem.rewind(mark);

    writeWav(&mem, "sniper", trio(&mem,
        env(&mem, noise(&mem, &rng, 0.08), 0.0005, 0.012),
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.9), 0.12), 0.002, 0.25),
        env(&mem, tone(&mem, 0.3, 140.0, 50.0, SINE), 0.001, 0.06)), 0.85);
    mem.rewind(mark);

    writeWav(&mem, "rocket", env(&mem, lowpass(&mem, pair(&mem,
        noise(&mem, &rng, 0.6),
        gain(&mem, tone(&mem, 0.6, 90.0, 160.0, SAW), 0.4)), 0.15), 0.03, 0.2), 0.7);
    mem.rewind(mark);

    writeWav(&mem, "boom", pair(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 1.2), 0.08), 0.004, 0.3),
        env(&mem, tone(&mem, 0.8, 70.0, 30.0, SINE), 0.004, 0.2)), 0.9);
    mem.rewind(mark);

    // A soft, damped string thump instead of the bright sawtooth twang.
    writeWav(&mem, "bow", lowpass(&mem, pair(&mem,
        env(&mem, tone(&mem, 0.24, 155.0, 100.0, SINE), 0.006, 0.05),
        gain(&mem, env(&mem, lowpass(&mem, noise(&mem, &rng, 0.06), 0.08), 0.004, 0.018), 0.3)), 0.055), 0.28);
    mem.rewind(mark);

    // Quiet, short glass chime: a single cue when the bow reaches full draw.
    writeWav(&mem, "bow_ready", pair(&mem,
        env(&mem, tone(&mem, 0.32, 1174.66, 1174.66, SINE), 0.004, 0.085),
        gain(&mem, env(&mem, tone(&mem, 0.32, 1760.0, 1760.0, SINE), 0.006, 0.065), 0.35)), 0.12);
    mem.rewind(mark);

    writeWav(&mem, "wand", env(&mem, pair(&mem,
        tone(&mem, 0.3, 450.0, 1000.0, SQUARE),
        gain(&mem, tone(&mem, 0.3, 910.0, 2010.0, SINE), 0.5)), 0.005, 0.08), 0.3);
    mem.rewind(mark);

    writeWav(&mem, "swish", env(&mem, lowpass(&mem, noise(&mem, &rng, 0.2), 0.3), 0.06, 0.04), 0.45);
    mem.rewind(mark);

    writeWav(&mem, "reload", trio(&mem,
        click(&mem, &rng, 0.03, 0.5),
        pad(&mem, click(&mem, &rng, 0.04, 0.3), 0.18),
        pad(&mem, env(&mem, tone(&mem, 0.05, 900.0, 700.0, SQUARE), 0.001, 0.01), 0.36)), 0.5);
    mem.rewind(mark);

    writeWav(&mem, "hit", env(&mem, lowpass(&mem, tone(&mem, 0.06, 1300.0, 900.0, SQUARE), 0.4), 0.001, 0.015), 0.2);
    mem.rewind(mark);

    writeWav(&mem, "kill", pair(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.3), 0.3), 0.001, 0.06),
        env(&mem, lowpass(&mem, tone(&mem, 0.25, 380.0, 80.0, SQUARE), 0.4), 0.001, 0.07)), 0.45);
    mem.rewind(mark);

    writeWav(&mem, "zap", env(&mem, tone(&mem, 0.25, 250.0, 700.0, SAW), 0.01, 0.07), 0.3);
    mem.rewind(mark);

    writeWav(&mem, "hurt", pair(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.25), 0.15), 0.002, 0.05),
        env(&mem, tone(&mem, 0.25, 160.0, 70.0, SQUARE), 0.002, 0.06)), 0.7);
    mem.rewind(mark);

    writeWav(&mem, "jump", env(&mem, lowpass(&mem, noise(&mem, &rng, 0.12), 0.08), 0.02, 0.03), 0.22);
    mem.rewind(mark);

    writeWav(&mem, "dash", env(&mem, lowpass(&mem, noise(&mem, &rng, 0.3), 0.25), 0.03, 0.08), 0.45);
    mem.rewind(mark);

    writeWav(&mem, "gem", env(&mem, tone(&mem, 0.08, 1000.0, 1400.0, SINE), 0.002, 0.03), 0.22);
    mem.rewind(mark);

    let levelFreq: [4]f32 = [523.0, 659.0, 784.0, 1047.0];
    writeWav(&mem, "level", quad(&mem,
        pad(&mem, env(&mem, tone(&mem, 0.3, levelFreq[0], levelFreq[0], SINE), 0.003, 0.12), 0.0),
        pad(&mem, env(&mem, tone(&mem, 0.3, levelFreq[1], levelFreq[1], SINE), 0.003, 0.12), 0.08),
        pad(&mem, env(&mem, tone(&mem, 0.3, levelFreq[2], levelFreq[2], SINE), 0.003, 0.12), 0.16),
        pad(&mem, env(&mem, tone(&mem, 0.3, levelFreq[3], levelFreq[3], SINE), 0.003, 0.12), 0.24)), 0.5);
    mem.rewind(mark);

    let unlockFreq: [3]f32 = [392.0, 523.0, 784.0];
    writeWav(&mem, "unlock", quad(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.4), 0.2), 0.001, 0.08),
        pad(&mem, env(&mem, tone(&mem, 0.6, unlockFreq[0], unlockFreq[0], SINE), 0.003, 0.25), 0.05),
        pad(&mem, env(&mem, tone(&mem, 0.6, unlockFreq[1], unlockFreq[1], SINE), 0.003, 0.25), 0.15),
        pad(&mem, env(&mem, tone(&mem, 0.6, unlockFreq[2], unlockFreq[2], SINE), 0.003, 0.25), 0.25)), 0.6);
    mem.rewind(mark);

    // Bosses and skills. New sounds go last: the shared noise stream keeps the ones above the same.
    writeWav(&mem, "roar", env(&mem, lowpass(&mem, trio(&mem,
        tone(&mem, 1.5, 84.0, 52.0, SAW),
        tone(&mem, 1.5, 88.0, 55.0, SAW),
        gain(&mem, noise(&mem, &rng, 1.5), 0.8)), 0.09), 0.18, 0.55), 0.9);
    mem.rewind(mark);

    writeWav(&mem, "slam", trio(&mem,
        env(&mem, tone(&mem, 1.0, 60.0, 24.0, SINE), 0.002, 0.3),
        env(&mem, lowpass(&mem, noise(&mem, &rng, 1.0), 0.05), 0.002, 0.25),
        click(&mem, &rng, 0.03, 0.6)), 0.95);
    mem.rewind(mark);

    writeWav(&mem, "horn", env(&mem, lowpass(&mem, trio(&mem,
        tone(&mem, 1.8, 110.0, 104.0, SAW),
        tone(&mem, 1.8, 165.0, 156.0, SAW),
        gain(&mem, tone(&mem, 1.8, 55.0, 52.0, SQUARE), 0.5)), 0.12), 0.25, 0.9), 0.75);
    mem.rewind(mark);

    writeWav(&mem, "crit", pair(&mem,
        env(&mem, tone(&mem, 0.09, 1900.0, 2400.0, SINE), 0.001, 0.03),
        env(&mem, lowpass(&mem, tone(&mem, 0.05, 950.0, 1200.0, SQUARE), 0.5), 0.001, 0.012)), 0.28);
    mem.rewind(mark);

    writeWav(&mem, "warn", pair(&mem,
        env(&mem, tone(&mem, 0.12, 680.0, 680.0, SQUARE), 0.002, 0.05),
        pad(&mem, env(&mem, tone(&mem, 0.12, 680.0, 680.0, SQUARE), 0.002, 0.05), 0.16)), 0.3);
    mem.rewind(mark);

    writeWav(&mem, "blink", pair(&mem,
        env(&mem, tone(&mem, 0.28, 280.0, 1700.0, SINE), 0.01, 0.09),
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.28), 0.45), 0.01, 0.07)), 0.45);
    mem.rewind(mark);

    writeWav(&mem, "thunder", trio(&mem,
        env(&mem, noise(&mem, &rng, 0.08), 0.0005, 0.015),
        env(&mem, lowpass(&mem, noise(&mem, &rng, 1.6), 0.06), 0.01, 0.5),
        env(&mem, tone(&mem, 1.0, 55.0, 30.0, SINE), 0.01, 0.35)), 0.85);
    mem.rewind(mark);

    writeWav(&mem, "ready", pair(&mem,
        env(&mem, tone(&mem, 0.3, 880.0, 880.0, SINE), 0.002, 0.12),
        pad(&mem, env(&mem, tone(&mem, 0.3, 1320.0, 1320.0, SINE), 0.002, 0.14), 0.07)), 0.35);
    mem.rewind(mark);

    writeWav(&mem, "flame", env(&mem, lowpass(&mem, noise(&mem, &rng, 0.6), 0.28), 0.06, 0.3), 0.55);
    mem.rewind(mark);

    writeWav(&mem, "beam", env(&mem, pair(&mem,
        lowpass(&mem, tone(&mem, 0.55, 220.0, 460.0, SAW), 0.3),
        gain(&mem, tone(&mem, 0.55, 880.0, 1840.0, SINE), 0.35)), 0.02, 0.22), 0.4);
    mem.rewind(mark);

    writeWav(&mem, "shatter", trio(&mem,
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.45), 0.7), 0.001, 0.09),
        pad(&mem, env(&mem, tone(&mem, 0.1, 2400.0, 2300.0, SINE), 0.001, 0.04), 0.03),
        pad(&mem, env(&mem, tone(&mem, 0.1, 3150.0, 3000.0, SINE), 0.001, 0.04), 0.09)), 0.55);
    mem.rewind(mark);

    writeWav(&mem, "skill", env(&mem, pair(&mem,
        lowpass(&mem, tone(&mem, 0.4, 200.0, 820.0, SAW), 0.35),
        gain(&mem, tone(&mem, 0.4, 400.0, 1250.0, SINE), 0.6)), 0.01, 0.14), 0.5);
    mem.rewind(mark);

    writeWav(&mem, "deny", pair(&mem,
        env(&mem, lowpass(&mem, tone(&mem, 0.1, 170.0, 150.0, SQUARE), 0.3), 0.002, 0.04),
        pad(&mem, env(&mem, lowpass(&mem, tone(&mem, 0.1, 150.0, 130.0, SQUARE), 0.3), 0.002, 0.04), 0.12)), 0.4);
    mem.rewind(mark);

    writeWav(&mem, "tick", env(&mem, tone(&mem, 0.05, 1900.0, 1700.0, SINE), 0.001, 0.012), 0.22);
    mem.rewind(mark);

    writeWav(&mem, "click", pair(&mem,
        env(&mem, lowpass(&mem, tone(&mem, 0.09, 620.0, 420.0, SQUARE), 0.35), 0.001, 0.03),
        pad(&mem, env(&mem, tone(&mem, 0.09, 1240.0, 1240.0, SINE), 0.001, 0.03), 0.015)), 0.38);
    mem.rewind(mark);

    writeWav(&mem, "death", trio(&mem,
        env(&mem, lowpass(&mem, tone(&mem, 1.1, 300.0, 55.0, SAW), 0.2), 0.01, 0.45),
        env(&mem, tone(&mem, 1.1, 150.0, 40.0, SINE), 0.01, 0.5),
        env(&mem, lowpass(&mem, noise(&mem, &rng, 0.5), 0.08), 0.005, 0.18)), 0.6);
    mem.rewind(mark);

    printLn("wrote assets/sfx");
}
