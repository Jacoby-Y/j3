// Render regression: scalar/instanced images must agree, including >64 copies,
// per-copy emission, outlines, and ordinary draws after restoring instance state.
module instances_check;
use lib "c" as libc { fn getenv(name: cstr): cstr; }
use j3.app.App;
use j3.gfx;
use j3.gfx.{ Instance, Mesh, Look, FxParam };
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use j3.scene3d;
use j3.text.{ Text, cstr };
use j3.sys.panic;

struct World { mesh: Mesh; copies: []Instance; hulls: []Instance; matrices: []Mat4; scalar: bool; effect: int = 0; custom: []Instance; }
fn boot(mem: &Arena): World {
    return World { mesh: Mesh {}, copies: mem.alloc::<Instance>(130), hulls: mem.alloc::<Instance>(130),
        matrices: mem.alloc::<Mat4>(2), custom: mem.alloc::<Instance>(2), scalar: libc.getenv(cstr("J3_INSTANCE_SCALAR")) != 0 };
}
fn start(w: &World) {
    gfx.init();
    let mem = Arena.create(65536);
    w.mesh = gfx.uploadUv(scene3d.assetVerts("builtin:cube", &mem));
    let i = 0;
    while i < 130 {
        let x = f32(i % 13) - 6;
        let y = f32(i / 13) - 4.5;
        let tint = Vec3.xyz(f32(i % 3) * 0.4, f32(i % 5) * 0.2, f32(i % 7) * 0.14);
        w.copies[i] = Instance { model: Mat4.translate(x, y, 0).mul(Mat4.scale(0.65, 0.65, 0.65)),
            tint: tint, emission: tint * 0.2 };
        w.hulls[i] = Instance { model: Mat4.translate(x, y, 0).mul(Mat4.scale(0.7, 0.7, 0.7)),
            tint: Vec3.zero(), emission: Vec3.xyz(0.8, 0.5, 0.1) };
        i += 1;
    }
    let log = Text.new(&mem);
    let vlog = Text.new(&mem);
    let first = 0;
    let vfirst = 0;
    w.effect = gfx.effectProgram("vec3 effect(Surface s, vec3 lit) { return lit * vec3(0.5, 1.0, 0.7); }", mem.alloc::<FxParam>(0), &log, &first, &vlog, &vfirst);
    if w.effect == 0 { panic(log.str()); }
    w.custom[0] = Instance { model: Mat4.translate(-3, 6, 0), tint: Vec3.xyz(1, 0.2, 0.1), emission: Vec3.xyz(0.2, 0.1, 0) };
    w.custom[1] = Instance { model: Mat4.translate(3, 6, 0), tint: Vec3.xyz(0.1, 0.3, 1), emission: Vec3.xyz(0, 0.2, 0.1) };
    w.matrices[0] = Mat4.translate(-3, -6, 0);
    w.matrices[1] = Mat4.translate(3, -6, 0);
}
fn copies(w: &World) {
    if w.scalar {
        let i = 0;
        while i < w.copies.len {
            gfx.material(w.copies[i].tint, w.copies[i].emission);
            gfx.draw(w.mesh, w.copies[i].model);
            i += 1;
        }
    } else { gfx.drawInstances(w.mesh, w.copies); }
}
fn draw(w: &World) {
    gfx.surface(gfx.plainSurface());
    let sun = Vec3.xyz(1, 2, 3);
    gfx.shadowPass(sun, Vec3.xyz(-50, -50, -50), Vec3.xyz(50, 50, 50));
    let distant = Mat4.translate(35, 0, 0);
    let lo = Vec3.xyz(-0.5, -0.5, -0.5);
    let hi = Vec3.xyz(0.5, 0.5, 0.5);
    if !gfx.visible(distant, lo, hi) { panic("shadow caster culled by camera"); }
    copies(w);
    gfx.cameraPassLook(Look.create(Vec3.xyz(0, 0, 19), 0, 0), sun, Vec3.xyz(0.2, 0.25, 0.3), Vec3.xyz(0.7, 0.7, 0.7));
    if gfx.visible(distant, lo, hi) { panic("offscreen geometry not culled"); }
    copies(w);
    if w.scalar {
        let i = 0;
        while i < w.hulls.len {
            gfx.material(w.hulls[i].tint, w.hulls[i].emission);
            gfx.drawHull(w.mesh, w.hulls[i].model);
            i += 1;
        }
    } else { gfx.drawHullInstances(w.mesh, w.hulls); }
    gfx.material(Vec3.xyz(0.2, 1, 0.3), Vec3.zero());
    gfx.drawInstanced(w.mesh, w.matrices);
    gfx.draw(w.mesh, Mat4.translate(0, -6, 0));
    let surface = gfx.plainSurface();
    surface.fx = w.effect;
    surface.tint = Vec3.xyz(0.5, 0.8, 0.7);
    surface.spec = 0.7;
    gfx.surface(surface);
    if w.scalar {
        let j = 0;
        while j < 2 {
            let each = surface;
            each.tint = w.custom[j].tint;
            each.glow = w.custom[j].emission;
            gfx.surface(each);
            gfx.draw(w.mesh, w.custom[j].model);
            j += 1;
        }
        gfx.surface(surface);
    } else { gfx.drawInstances(w.mesh, w.custom); }
    gfx.draw(w.mesh, Mat4.translate(0, 6, 0));
}
fn main() {
    let app = App<World>.create("Instance regression", 640, 480, boot);
    app.useGl(); app.startup(start); app.draw(draw); app.run();
}
