// Debug flags for the fps shooter. Edit a string, save, and run the game.
// The game reads this file when it starts. You do not need to run this script.
// An empty string turns that flag off. A set flag here wins over the matching
// J3_FPS_* environment variable. unlock is true or false. level is a whole number.
//
// area         hollows or volcano-seal: preview the cave or its locked entrance
// boss         one of: colossus saucer rime cinder heartwood marquee faultjaw relic geode stormeel bullfrog bonegolem scarecrow (or 1-13)
// bosses       several of those, comma-separated, spawned together around you
// skill        one of: slingshot shuriken detonate missiles storm orbital (or 1-6)
// skill_auto   1 fires the skill whenever it is ready
// gun          one of: machine sniper shotgun rpg bow wand knife skateboard
// guns         several of those, comma-separated. The first is in your hands.
// spawn        shield, flag or meteor: one drops in 3 seconds after the start
// spawn_elite  1-3: an elite charger with that many stars drops in 3 seconds after the start (0 is off)
// spawn_mod    1-4: modifier for that charger (1 electric, 2 fire, 3 armored, 4 split). Alone, it spawns a plain charger
// perks        shrine perks on from the start, comma-separated: air drone jetpack turret
// watch        1 keeps the camera on the boss and keeps you alive
// bench        one of: opening populated pack
// unlock       true opens every biome at the start, and again after you die
// skip_menu    true starts in the game instead of on the main menu
// endless      true starts in endless mode (the post-game: ghosts, faster spawns, a Colossus every 2 minutes)
// challenge    challenge run from the start: 1 melee only, 2 glass cannon, 3 the horde, 4 boss rush (0 = none)
// difficulty   default difficulty: 0 easy, 1 medium, 2 hard, 3 extreme, 4 death (2+ also unlocks the menu picker)
// level        starting level (1 is a normal run). Every third level is a key.
// seed         world shuffle seed: the same seed deals the same map (0 = a fresh one each launch)
// fixed_map    true keeps the map the way tools/arena.j3s drew it (no shuffle)
// biome_on     true puts the biome `biome` (an id: 0-8 original, 11+ new; 14 is the farm) right behind the spawn, south of the Hub
// biome        the id for biome_on. Needs `unlock = true` to walk there
// hub          0 = either hub by seed, 1 = the classic Hub, 2 = the Spires

use j3.io.printLn;

const area: string = "";
const boss: string = "";
const bosses: string = "";
const skill: string = "";
const skill_auto: string = "";
const gun: string = "";
const guns: string = "";
const spawn: string = "";
const spawn_elite: int = 0;
const spawn_mod: int = 0;
const perks: string = "";
const watch: string = "";
const bench: string = "";
const unlock: bool = true;
const skip_menu: bool = true;
const endless: bool = false;
const challenge: int = 0;
const difficulty: int = 0;
const level: int = 1;
const seed: int = 0;
const fixed_map: bool = false;
const hub: int = 0;
const biome_on: bool = false;
const biome: int = 0;

pub fn main() {
    printLn("The game reads tools/debug.j3s. Run the game, not this script.");
    printLn(`boss={boss}`);
    printLn(`bosses={bosses}`);
    printLn(`skill={skill}`);
    printLn(`skill_auto={skill_auto}`);
    printLn(`gun={gun}`);
    printLn(`guns={guns}`);
    printLn(`spawn={spawn}`);
    printLn(`spawn_elite={spawn_elite}`);
    printLn(`spawn_mod={spawn_mod}`);
    printLn(`perks={perks}`);
    printLn(`watch={watch}`);
    printLn(`bench={bench}`);
    printLn(`unlock={unlock}`);
    printLn(`skip_menu={skip_menu}`);
    printLn(`challenge={challenge}`);
    printLn(`difficulty={difficulty}`);
    printLn(`endless={endless}`);
    printLn(`level={level}`);
    printLn(`seed={seed}`);
    printLn(`fixed_map={fixed_map}`);
    printLn(`hub={hub}`);
    printLn(`biome_on={biome_on}`);
    printLn(`biome={biome}`);
}
