// Project checks for `j3c -e scene check` (and the MCP check tool): j3.editor.toml's `check`
// runs this with a scene path; each `error: ` or `warning: ` line becomes an issue.
// Run by hand: j3c run tools/check.j3s scenes/biomes/farm.j3scene
// Rules the game relies on but can't see until it runs:
//   jump pads sit on a floor with 1.3 m to spare, and nothing solid crowds them;
//   ShrineSpot groups rest on a surface;
//   a biome file's objects stay inside its 160 m tile (+-80 around its origin).

use j3.io.printLn;
use j3.math.{ abs, cos, sin };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Node, Scene, GROUP, INSTANCE, MESH };
use j3.sys.{ arg, argCount };
use j3.text.{ Text, same };

const HALF_TILE: f32 = 80.0;

fn starts(s: string, prefix: string): bool {
    if s.len < prefix.len { return false; }
    let i = 0;
    while i < prefix.len {
        if s[i] != prefix[i] { return false; }
        i += 1;
    }
    return true;
}

fn contains(s: string, part: string): bool {
    let i = 0;
    while i + part.len <= s.len {
        let j = 0;
        while j < part.len && s[i + j] == part[j] { j += 1; }
        if j == part.len { return true; }
        i += 1;
    }
    return false;
}

/// A top-level builtin cube the player can stand on.
fn solidBox(n: Node): bool {
    return n.parent == 0 && n.kind == MESH && same(n.asset, "builtin:cube")
        && !starts(n.name, "Deco") && !starts(n.name, "Lava");
}

/// Half extents on x and z of a cube turned by its yaw.
fn halfX(n: Node): f32 { return (abs(cos(n.rotation.y)) * n.scale.x + abs(sin(n.rotation.y)) * n.scale.z) / 2.0; }
fn halfZ(n: Node): f32 { return (abs(sin(n.rotation.y)) * n.scale.x + abs(cos(n.rotation.y)) * n.scale.z) / 2.0; }

/// Some solid top within `tolerance` of `y` covers (x, z) with `margin` to spare.
// ponytail: only top-level cubes count, by their turned box; imported meshes never support.
fn supported(scene: &Scene, x: f32, y: f32, z: f32, margin: f32, tolerance: f32): bool {
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        i += 1;
        if !solidBox(n) { continue; }
        let top = n.position.y + n.scale.y / 2.0;
        if abs(top - y) > tolerance { continue; }
        if abs(n.position.x - x) + margin <= halfX(n) && abs(n.position.z - z) + margin <= halfZ(n) { return true; }
    }
    return false;
}

/// A solid box rising above `y` within `reach` of (x, z); its name, or "".
fn crowding(scene: &Scene, x: f32, y: f32, z: f32, reach: f32): string {
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        i += 1;
        if !solidBox(n) || n.position.y + n.scale.y / 2.0 <= y + 0.15 { continue; }
        if n.position.y - n.scale.y / 2.0 > y + 3.0 { continue; }
        if abs(n.position.x - x) < halfX(n) + reach && abs(n.position.z - z) < halfZ(n) + reach { return n.name; }
    }
    return "";
}

fn report(kind: string, n: Node, message: string, mem: &Arena) {
    let t = Text.new(mem);
    t.pushStr(kind);
    t.pushStr(": ");
    t.pushStr(n.name);
    t.pushStr(" at ");
    t.pushFloat(n.position.x);
    t.pushStr(",");
    t.pushFloat(n.position.y);
    t.pushStr(",");
    t.pushFloat(n.position.z);
    t.pushStr(": ");
    t.pushStr(message);
    printLn(t.str());
}

pub fn main() {
    if argCount() < 2 {
        printLn("usage: j3c run tools/check.j3s <scene file>");
        return;
    }
    let path = arg(1);
    let mem = Arena.create(32 * 1024 * 1024);
    let scene = scene3d.read(path, &mem);
    let biome = contains(path, "biomes/");
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        i += 1;
        if n.parent != 0 { continue; }
        if starts(n.name, "JumpPad") && n.kind == INSTANCE {
            if !supported(&scene, n.position.x, n.position.y, n.position.z, 1.3, 0.15) {
                report("error", n, "no floor at its height with 1.3 m to spare around it", &mem);
            } else {
                let by = crowding(&scene, n.position.x, n.position.y, n.position.z, 2.0);
                if by.len > 0 {
                    let t = Text.new(&mem);
                    t.pushStr("crowded by ");
                    t.pushStr(by);
                    t.pushStr(" (within 2 m); the launch may hit it");
                    report("warning", n, t.str(), &mem);
                }
            }
        }
        if starts(n.name, "ShrineSpot") && n.kind == GROUP
            && !supported(&scene, n.position.x, n.position.y, n.position.z, 0.0, 0.3) {
            report("error", n, "rests on nothing: no solid top within 0.3 m below it", &mem);
        }
        if biome && (abs(n.position.x) > HALF_TILE || abs(n.position.z) > HALF_TILE) {
            report("warning", n, "outside the biome's tile (+-80 around its origin)", &mem);
        }
    }
}
