// Preferences on disk (`j3.data.save`, `key=value` lines). A missing, empty, truncated or garbage file
// gives the defaults; every value is clamped, so no file can put the app in a state the UI cannot show.

module desk_app.prefs;

use desk_app.state.{ NAME_MAX, State };
use j3.data.save;
use j3.memory.Arena;

pub const MIN_SIDE: f32 = 160.0;
pub const MAX_SIDE: f32 = 320.0;

fn clampInt(v: int, lo: int, hi: int, fallback: int): int {
    return if v < lo || v > hi { fallback } else { v };
}

/// Read `path` into `s`. `mem` must outlive `s` (the owner name stays a view of the file bytes).
pub fn load(s: &State, path: string, mem: &Arena) {
    let sv = save.load(path, mem);
    s.density = clampInt(save.getInt(&sv, "density", 0), 0, 1, 0);
    s.units = clampInt(save.getInt(&sv, "units", 0), 0, 1, 0);
    s.showHidden = save.getInt(&sv, "hidden", 0) == 1;
    s.sortKey = clampInt(save.getInt(&sv, "sortKey", 0), 0, 2, 0);
    s.sortAsc = save.getInt(&sv, "sortAsc", 1) != 0;
    let w = save.getFloat(&sv, "sideW", 220.0);
    // `!(w >= ..)` also catches NaN
    s.sideW = if !(w >= MIN_SIDE) || !(w <= MAX_SIDE) { 220.0 } else { w };
    let o = save.getStr(&sv, "owner", "You");
    s.owner = if o.len == 0 || o.len > NAME_MAX { "You" } else { o };
}

/// A number that changes whenever a saved value does.
pub fn signature(s: &State): int {
    let h = s.density * 3 + s.units * 5 + (if s.showHidden { 7 } else { 0 }) + s.sortKey * 11 + (if s.sortAsc { 13 } else { 0 });
    h = h * 31 + int(s.sideW * 4.0);
    for i in 0..s.owner.len {
        h = (h * 31 + int(s.owner[i])) % 1000000007;
    }
    return h;
}

/// Write the preferences to `path` (write errors are ignored, like `save.store`).
pub fn store(s: &State, path: string) {
    let arena = Arena.create(4096);
    let mem = &arena;
    let sv = save.empty(mem);
    save.putInt(&sv, "density", s.density);
    save.putInt(&sv, "units", s.units);
    save.putInt(&sv, "hidden", if s.showHidden { 1 } else { 0 });
    save.putInt(&sv, "sortKey", s.sortKey);
    save.putInt(&sv, "sortAsc", if s.sortAsc { 1 } else { 0 });
    save.putFloat(&sv, "sideW", s.sideW);
    save.putStr(&sv, "owner", s.owner);
    save.store(&sv, path);
    arena.destroy();
}
