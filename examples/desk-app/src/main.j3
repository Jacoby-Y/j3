// Desk app: a file browser and a settings page (see AGENTS.md). `desk_app.ui.Shell` is ui/Shell.j3ui.
//
// Test hooks (env): DESK_GOLDEN=<browser|filter|rename|settings|toast> starts in a fixed state and does not
// touch the preferences file (tools/golden.sh); DESK_PREFS=<path> moves the preferences file (default
// `desk-app.save`); DESK_TEST=1 drives the UI with fake input and prints PASS/FAIL lines; DESK_SNAPSHOT=N writes the HTML snapshot and the accessibility tree (target/ui-a11y.txt)
// snapshot to target/ui-snapshot.html on frame N.

module desk_app;

use desk_app.prefs;
use desk_app.selftest;
use desk_app.selftest.Test;
use desk_app.state.{ BY_SIZE, PAGE_SETTINGS, State };
use desk_app.ui.{ Shell, ShellProps };
use j3.app.App;
use j3.game.{ env, requestQuit, windowSize };
use j3.io.printLn;
use j3.memory.Arena;
use j3.text.same;
use j3.ui.domhtml.{ dumpA11y, dumpHtml };

/// The preferences are written when they have not changed for this many frames.
const SETTLE = 20;

struct World {
    state: State;
    root: Shell;
    mem: &Arena;
    path: string;
    golden: bool;
    frame: int;
    sig: int;
    saved: int;
    quiet: int;
    // DESK_TEST
    tester: bool;
    test: Test;
    snapshotAt: int;
}

fn toInt(s: string): int {
    let n = 0;
    for i in 0..s.len {
        n = n * 10 + int(s[i]) - 48;
    }
    return n;
}

/// A fixed state for a golden capture.
fn golden(s: &State, name: string) {
    s.sortKey = BY_SIZE;
    s.sortAsc = false;
    s.sel = 3;
    if same(name, "filter") {
        s.sortKey = 0;
        s.sortAsc = true;
        s.filter = "o";
        s.sel = -1;
    } else if same(name, "rename") {
        s.sortKey = 0;
        s.sortAsc = true;
        s.sel = 4;
        s.openRename();
    } else if same(name, "settings") {
        s.page = PAGE_SETTINGS;
        s.density = 1;
        s.showHidden = true;
    } else if same(name, "toast") {
        s.toast("Renamed to notes.png", 1);
    }
}

fn boot(mem: &Arena): World {
    let w = World {
        state: State.new(mem), root: Shell.new(mem), mem: mem,
        path: "desk-app.save",
        golden: false,
        frame: 0, sig: 0, saved: 0, quiet: 0,
        tester: same(env("DESK_TEST"), "1"), test: Test {}, snapshotAt: toInt(env("DESK_SNAPSHOT")),
    };
    let pf = env("DESK_PREFS");
    if pf.len > 0 {
        w.path = pf;
    }
    let g = env("DESK_GOLDEN");
    w.golden = g.len > 0;
    if w.golden {
        // a fixed UI clock, so fades and transitions land the same on every run
        w.root.dom.setFrameMs(16.0);
        golden(&w.state, g);
    } else {
        prefs.load(&w.state, w.path, mem);
    }
    w.sig = prefs.signature(&w.state);
    w.saved = w.sig;
    return w;
}

/// Save a moment after the last change, not on every step of a slider drag.
fn persist(w: &World) {
    let sig = prefs.signature(&w.state);
    if sig != w.sig {
        w.sig = sig;
        w.quiet = 0;
    } else if w.quiet < SETTLE {
        w.quiet += 1;
        w.root.dom.requestFrame(); // counts frames; the idle loop must come back until it saves
        if w.quiet == SETTLE && sig != w.saved && !w.golden && !w.tester {
            prefs.store(&w.state, w.path);
            w.saved = sig;
        }
    }
}

fn draw(w: &World) {
    // toasts run on the UI clock (fixed under goldens), as of the last frame
    w.state.now = w.root.dom.timeMs();
    w.root.render(windowSize(), ShellProps { state: &w.state });
    w.frame += 1;
    persist(w);
    let d = &w.root.dom;
    if w.snapshotAt == w.frame {
        if dumpHtml(d, "target/ui-snapshot.html") {
            printLn("wrote target/ui-snapshot.html");
        }
        if dumpA11y(d, "target/ui-a11y.txt") {
            printLn("wrote target/ui-a11y.txt");
        }
    }
    if w.tester {
        selftest.step(&w.test, d, &w.state, w.frame);
    }
}

fn main() {
    let app = App<World>.create("desk app", 1100, 680, boot);
    app.useGl();
    app.hiDpi();
    app.draw(draw);
    app.run();
}
