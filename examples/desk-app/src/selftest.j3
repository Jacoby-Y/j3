// DESK_TEST=1: drive the UI with fake input and check the state it should reach. Prints PASS/FAIL lines.
// Each step is a few frames: a click is three (move, press, release), then a check frame.

module desk_app.selftest;

use desk_app.prefs;
use desk_app.state.State;
use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys;
use j3.text.{ contains, same };
use j3.ui.a11y;
use j3.ui.dom.{ Dom, K_ELEM };
use j3.ui.testkit;

pub struct Test {
    fails: int = 0;
    /// The file whose name the rename steps use.
    pick: int = 0;
    /// The keyboard walk: how many controls offer focus, and the first one Tab reached.
    want: int = 0;
    first: int = -1;
}

fn check(t: &Test, ok: bool, what: string) {
    if ok {
        printLn(`PASS {what}`);
    } else {
        printLn(`FAIL {what}`);
        t.fails += 1;
    }
}

/// Every neighbour pair is in order and ties keep id order (a stable sort), whichever way it runs.
fn ordered(s: &State): bool {
    let o = s.view();
    for i in 1..o.len {
        if s.before(o[i], o[i - 1]) {
            return false;
        }
        if !s.before(o[i - 1], o[i]) && o[i - 1] > o[i] {
            return false;
        }
    }
    return true;
}

/// Keyboard only, from frame 62: Tab goes round exactly the controls that offer focus (each press lands on
/// one, the cycle is as long as there are controls, so none is skipped or trapped), then Enter on a focused
/// row selects it.
fn keyboardWalk(t: &Test, d: &Dom, s: &State, f: int) {
    if f == 62 {
        for i in 0..d.nodes.len {
            if d.nodes.items[i].kind == K_ELEM && a11y.actions(d, i) % 2 == 1 {
                t.want += 1;
            }
        }
    }
    if f >= 62 && f <= 62 + t.want {
        d.simKeys("", "Tab");
    }
    let k = f - 62;
    if k >= 1 && k <= t.want + 1 {
        let at = d.focused();
        if k == 1 {
            t.first = at;
        }
        if k > 1 && k <= t.want && at == t.first {
            check(t, false, "Tab cycle is shorter than the controls: one is skipped or trapped");
        }
        if a11y.actions(d, at) == 0 {
            check(t, false, "Tab landed on a node that is not operable");
        }
        if k == t.want + 1 {
            check(t, at == t.first && t.want > 10, "Tab wraps after reaching every control");
        }
    }
    if f == 70 + t.want {
        s.sel = -1;
        for i in 0..d.nodes.len {
            if d.nodes.items[i].kind == K_ELEM && same(a11y.role(d, i), "option") {
                d.focusNode(i);
                break;
            }
        }
        d.simKeys("", "Enter");
    }
    if f == 73 + t.want {
        check(t, s.sel >= 0, "Enter on a focused row selects it");
    }
    // the dialog's other way to rename: its Rename button (same `ok()` as Enter); the fade-in takes ~8 frames to accept clicks
    if f == 74 + t.want {
        s.openRename();
    }
    testkit.clickTextIn(d, f, 82 + t.want, "dialog", "Rename");
    if f == 85 + t.want {
        check(t, !s.renaming, "the Rename button applies the (unchanged, valid) name and closes the modal");
    }
}

/// Frame `f` (1-based). Exits the program after the last step.
pub fn step(t: &Test, d: &Dom, s: &State, f: int) {
    // 3..6: click the Size header, twice
    testkit.clickText(d, f, 3, "Size");
    if f == 7 {
        check(t, s.sortKey == 1 && s.sortAsc && ordered(s), "Size header sorts ascending, ties keep id order");
    }
    testkit.clickText(d, f, 8, "Size");
    if f == 12 {
        check(t, s.sortKey == 1 && !s.sortAsc && ordered(s), "second click sorts descending, ties still keep id order");
    }
    testkit.clickText(d, f, 13, "Modified");
    if f == 17 {
        check(t, s.sortKey == 2 && s.sortAsc && ordered(s), "another header starts ascending");
    }
    // the filter box: click it, type, then check the rows
    testkit.typeInto(d, f, 18, "input", 0, "ro");
    if f == 24 {
        let all = true;
        let o = s.view();
        for i in 0..o.len {
            if !contains(s.files[o[i]].name, "ro") && !contains(s.files[o[i]].name, "RO") {
                all = false;
            }
        }
        check(t, same(s.filter, "ro") && o.len > 0 && o.len < 29 && all, "typing filters the rows");
        t.pick = o[0];
    }
    // select a row, then change the filter: the selection follows the file (the key), not the row position
    testkit.clickText(d, f, 25, s.files[t.pick].name);
    if f == 29 {
        check(t, s.sel == t.pick, "clicking a row selects its file");
    }
    // clicking a row moved focus off the box, so click it again before editing
    testkit.clickTag(d, f, 30, "input", 0);
    testkit.simKeys(d, f, 33, "", "End");
    testkit.simKeys(d, f, 34, "", "Backspace");
    if f == 36 {
        check(t, s.sel == t.pick && same(s.filter, "r") && s.view().len > 0, "selection survives a filter change");
    }
    // rename: open, a taken name is refused, a free one is applied
    testkit.clickText(d, f, 38, "Rename");
    if f == 42 {
        check(t, s.renaming && same(s.draft, s.files[t.pick].name), "Rename opens the modal with the current name");
        d.simKeys("", "C+a");
    }
    testkit.simKeys(d, f, 43, s.files[(t.pick + 1) % s.n].name, "");
    if f == 45 {
        check(t, s.problem().len > 0, "a name another file has is refused");
        d.simKeys("", "Enter");
    }
    if f == 48 {
        check(t, s.renaming && s.files[t.pick].name.len > 0 && !same(s.files[t.pick].name, s.draft), "Enter with a bad name keeps the modal open and the file unchanged");
        d.simKeys("", "C+a");
    }
    testkit.simKeys(d, f, 49, "zebra.txt", "");
    testkit.simKeys(d, f, 51, "", "Enter");
    if f == 54 {
        check(t, !s.renaming && same(s.files[t.pick].name, "zebra.txt") && s.toasts.live(0), "Enter renames, closes the modal and shows a toast");
    }
    // Escape closes the modal and leaves the name alone
    if f == 55 {
        s.openRename();
    }
    testkit.simKeys(d, f, 58, "", "Escape");
    if f == 61 {
        check(t, !s.renaming && same(s.files[t.pick].name, "zebra.txt"), "Escape closes the modal without renaming");
    }
    keyboardWalk(t, d, s, f);
    if f == 90 + t.want {
        t.fails += testkit.misses();
        prefsTests(t);
        if t.fails == 0 {
            printLn("all passed");
        }
        sys.exit(if t.fails == 0 { 0 } else { 1 });
    }
}

fn writeAll(path: string, data: []u8): bool {
    match io.writeFile(path, data) {
        Result.Ok(_) {
            return true;
        }
        Result.Err(_) {
            return false;
        }
    }
}

/// Preferences: a round trip, a missing file, garbage, and out-of-range values.
fn prefsTests(t: &Test) {
    let arena = Arena.create(65536);
    let mem = &arena;
    let a = State.new(mem);
    a.density = 1;
    a.units = 1;
    a.showHidden = true;
    a.sortKey = 2;
    a.sortAsc = false;
    a.sideW = 260.0;
    a.owner = "Ada";
    prefs.store(&a, "target/test-a.save");
    let b = State.new(mem);
    prefs.load(&b, "target/test-a.save", mem);
    check(t, prefs.signature(&a) == prefs.signature(&b) && b.sideW == 260.0 && same(b.owner, "Ada"), "preferences round trip");
    let c = State.new(mem);
    prefs.load(&c, "target/does-not-exist.save", mem);
    check(t, c.density == 0 && c.sideW == 220.0 && same(c.owner, "You"), "a missing preferences file gives the defaults");
    let g = State.new(mem);
    let junk = Arena.create(4096);
    let blob = junk.alloc::<u8>(300);
    for i in 0..300 {
        blob[i] = u8((i * 37 + 11) % 256);
    }
    let io = writeAll("target/test-junk.save", blob);
    prefs.load(&g, "target/test-junk.save", mem);
    check(t, io && g.density == 0 && g.sortKey == 0 && g.sideW == 220.0 && same(g.owner, "You"), "a garbage preferences file gives the defaults");
    let h = State.new(mem);
    let bad = "density=7\nunits=-3\nsortKey=99\nsideW f=9999.0\nowner s=\n";
    let io2 = writeAll("target/test-range.save", bad as []u8);
    prefs.load(&h, "target/test-range.save", mem);
    check(t, io2 && h.density == 0 && h.units == 0 && h.sortKey == 0 && h.sideW == 220.0 && same(h.owner, "You"), "out-of-range values fall back to the defaults");
    junk.destroy();
    arena.destroy();
}
