<!-- Settings. Controls bind straight to State; main.j3 saves them a moment after they stop changing. -->

<script>
    use desk_app.state.State;
    inject state: &State;

    fn reset() {
        state.density = 0;
        state.units = 0;
        state.showHidden = false;
        state.sideW = 220.0;
        state.owner = "You";
        state.toast("Settings reset", 0);
    }
    fn setDensity(v: int) { state.density = v; }
    fn setUnits(v: int) { state.units = v; }
</script>

<div class="page">
    <kit.Toolbar>
        <h1>Settings</h1>
        <button slot="end" on:click={reset()}>Reset all</button>
    </kit.Toolbar>
    <kit.Card title="Appearance">
        <kit.Section label="LAYOUT">
            <kit.Field label="Row density">
                <span slot="hint">Compact fits more rows</span>
                <button class:on={state.density == 0} on:click={setDensity(0)}>Comfortable</button>
                <button class:on={state.density == 1} on:click={setDensity(1)}>Compact</button>
            </kit.Field>
            <kit.Field label="Sidebar width">
                <span slot="hint">{int(state.sideW)} px</span>
                <input type="range" min={160} max={320} step={10} bind:value={state.sideW} />
            </kit.Field>
        </kit.Section>
    </kit.Card>
    <kit.Card title="Files">
        <button slot="actions" on:click={state.toast("Preferences are saved automatically", 0)}>Where?</button>
        <kit.Section label="LISTING">
            <kit.Field label="Show hidden files"><input type="checkbox" bind:checked={state.showHidden} /></kit.Field>
            <kit.Field label="Sizes">
                <span slot="hint">KB and MB, or exact bytes</span>
                <button class:on={state.units == 0} on:click={setUnits(0)}>Human</button>
                <button class:on={state.units == 1} on:click={setUnits(1)}>Bytes</button>
            </kit.Field>
            <kit.Field label="Owner name"><input type="text" bind:value={state.owner} /></kit.Field>
        </kit.Section>
    </kit.Card>
</div>

<style>
    .page { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; }
    button.on { background: var(--accent); color: #11111b; }
</style>
