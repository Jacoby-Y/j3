<!-- The file list (a keyed, sortable, filterable table) beside the details pane. Pages "All files" and "Starred" both. -->

<script>
    use desk_app.state.{ BY_DATE, BY_NAME, BY_SIZE, State };
    inject state: &State;

    /// Width of the size bar in px: 0 for folders, else a share of the biggest file.
    fn bar(bytes: int): f32 {
        return 56.0 * f32(bytes) / f32(state.maxBytes);
    }
    fn heading(): string {
        return if state.page == 1 { "Starred" } else { "All files" };
    }
</script>

<div class="page">
    <kit.Toolbar>
        <h1>{heading()}</h1>
        <input type="search" placeholder="Filter by name" bind:value={state.filter} />
        <div slot="end" class="endgrp">
            <small>{state.view().len} of {state.n}</small>
            <button disabled={state.sel < 0} on:click={state.openRename()}>Rename</button>
        </div>
    </kit.Toolbar>

    <div class="split">
        <kit.Table count={state.view().len}>
            <div slot="head" class="hrow">
                <kit.Th class="c0" label="Name" dir={state.dir(BY_NAME)} on:sort={state.sortBy(BY_NAME)} />
                <kit.Th class="c1" label="Size" dir={state.dir(BY_SIZE)} on:sort={state.sortBy(BY_SIZE)} />
                <kit.Th class="c2" label="Modified" dir={state.dir(BY_DATE)} on:sort={state.sortBy(BY_DATE)} />
            </div>
            <span slot="empty">No file matches "{state.filter}".</span>
            {#each state.view() as id (id)}
                {#let f = &state.files[id]}
                <div class="row d{state.density}" class:sel={state.sel == id} role="option" tabindex="0" on:click={state.pick(id)}>
                    <div class="c0 name">
                        <span class="ico k{f.kind}"></span>
                        <span>{f.name}</span>
                        {#if f.starred}<span class="star">*</span>{/if}
                    </div>
                    <div class="c1 size">
                        <span>{f.sizeText}</span>
                        <div class="track"><div class="fill" style:width={bar(f.bytes)}></div></div>
                    </div>
                    <div class="c2 muted">{f.dayText}</div>
                </div>
            {/each}
        </kit.Table>
        <Details />
    </div>
</div>

<style>
    .page { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; }
    .split { display: flex; gap: 12px; flex: 1; min-height: 0; }
    .hrow, .row { display: flex; align-items: center; width: 100%; }
    .c0 { flex: 1; min-width: 0; }
    .c1 { width: 140px; }
    .c2 { width: 100px; }
    .endgrp { display: flex; align-items: center; gap: 12px; }
    .row { padding: 0 8px; border-radius: 6px; }
    .row.d0 { height: 34px; }
    .row.d1 { height: 26px; }
    .row:hover, .row:focus { background: var(--raised); }
    .row.sel { background: #33405e; }
    .name { display: flex; align-items: center; gap: 8px; }
    .star { color: #f9e2af; }
    .ico { width: 12px; height: 12px; border-radius: 3px; background: var(--muted); }
    .ico.k0 { background: #f9e2af; }
    .ico.k1 { background: #89b4fa; }
    .ico.k2 { background: #a6e3a1; }
    .ico.k3 { background: #cba6f7; }
    .ico.k4 { background: #fab387; }
    .size { display: flex; align-items: center; gap: 8px; }
    .size span { width: 64px; white-space: nowrap; }
    .track { width: 56px; height: 4px; border-radius: 2px; background: var(--raised); }
    .fill { height: 4px; border-radius: 2px; background: var(--accent); transition: width 150ms; }
    .muted { color: var(--muted); }
</style>
