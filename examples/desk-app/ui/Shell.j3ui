<!-- The window: sidebar nav, the page, the rename modal and the toasts. Root component; it provides the State. -->

<script>
    use desk_app.state.State;
    props { state: &State; }
    provide state;

    const NAMES: [3]string = ["All files", "Starred", "Settings"];

    fn onFrame(dt: f32) {
        state.toasts.tick(state.now);
    }
    fn rename(name: string) {
        state.commitRename(name);
    }
</script>

<div class="app">
    <nav style:width={state.sideW}>
        <h1>Desk</h1>
        {#each 0..3 as i (i)}
            <button class="item" class:active={state.page == i} on:click={state.page = i}>{NAMES[i]}</button>
        {/each}
        <small class="foot">{state.n} files, {state.owner}</small>
    </nav>
    <main>
        {#match state.page}
            {:case 0, 1}<pages.Browser />
            {:else}<pages.Settings />
        {/match}
    </main>

    {#if state.renaming}
        <RenameModal on:rename={rename(event.name)} on:close={state.renaming = false} />
    {/if}
    <div class="toasts">
        {#each 0..6 as i (i)}
            {#if state.toasts.live(i)}
                <div class="toast" class:ok={state.toasts.kind(i) == 1} transition:fade={200}>{state.toasts.text(i)}</div>
            {/if}
        {/each}
    </div>
</div>

<style>
    .app { display: flex; width: 100%; height: 100%; background: var(--bg); }
    nav { display: flex; flex-direction: column; gap: 4px; padding: 16px 12px; background: var(--panel); border-right: 1px solid var(--line); transition: width 150ms; }
    nav h1 { padding: 0 8px 12px 8px; }
    .item { display: flex; justify-content: flex-start; background: transparent; }
    .item:hover { background: var(--raised); }
    .item.active { background: var(--raised); color: var(--accent); }
    .foot { margin-top: auto; padding: 0 8px; }
    main { display: flex; flex: 1; min-width: 0; padding: 16px 20px; }
    .toasts { position: fixed; right: 16px; bottom: 16px; display: flex; flex-direction: column; gap: 6px; z-index: 1100; }
    .toast { padding: 10px 14px; background: var(--raised); border: 1px solid var(--line); border-radius: var(--radius); }
    .toast.ok { border-color: var(--good); }
</style>
