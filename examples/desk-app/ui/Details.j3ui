<!-- The selected file: facts, then star and rename. -->

<script>
    use desk_app.state.State;
    inject state: &State;

    const KINDS: [5]string = ["Folder", "Document", "Image", "Source code", "Audio"];
</script>

<kit.Card title="Details" class="det">
    {#if state.sel < 0}
        <small>Select a file to see its details.</small>
    {:else}
        <kit.Section label="FILE">
            <div class="big">{state.cur().name}</div>
            <div class="facts">
                <small>Kind</small><span>{KINDS[state.cur().kind]}</span>
                <small>Size</small><span>{state.cur().sizeText}</span>
                <small>Modified</small><span>{state.cur().dayText}</span>
                <small>Owner</small><span>{state.owner}</span>
            </div>
        </kit.Section>
        <kit.Section label="ABOUT">
            {#match state.cur().kind}
                {:case 0}<span class="note">Folders have no size of their own.</span>
                {:case 1, 3}<span class="note">Plain text, safe to open anywhere.</span>
                {:case 2}<span class="note">A picture; thumbnails are not made here.</span>
                {:else}<span class="note">Sound clip.</span>
            {/match}
        </kit.Section>
    {/if}
    <div slot="footer" class="btns">
        <button disabled={state.sel < 0} on:click={state.toggleStar()}>{#if state.sel >= 0 && state.cur().starred}Unstar{:else}Star{/if}</button>
        <button class="primary" disabled={state.sel < 0} on:click={state.openRename()}>Rename</button>
    </div>
</kit.Card>

<style>
    .det { width: 260px; align-self: flex-start; }
    .big { font-size: 16px; font-weight: bold; }
    .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px; }
    .note { color: var(--muted); }
    .btns { padding: 0 14px 12px 14px; }
</style>
