<!-- Rename dialog. Escape or a press outside closes it; Enter (the primary button) or OK renames when the name is valid. -->

<script>
    use desk_app.state.State;
    inject state: &State;
    events { rename(name: string); close; }

    fn ok() {
        if state.problem().len == 0 {
            emit rename(state.draft);
        }
    }
</script>

<dialog modal autoselect closedby="any" on:close={emit close} transition:fade={120}>
    <h2>Rename file</h2>
    <input type="text" aria-label="New name" bind:value={state.draft} />
    <small class="err">{state.problem()}</small>
    <div class="row">
        <button on:click={emit close}>Cancel</button>
        <button class="primary" disabled={state.problem().len > 0} on:click={ok()}>Rename</button>
    </div>
</dialog>

<style>
    dialog { display: flex; flex-direction: column; gap: 10px; width: calc(100% - 32px); max-width: 340px; padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; backdrop-color: rgba(0, 0, 0, 0.55); }
    .err { color: var(--bad); height: 16px; }
    .row { display: flex; justify-content: flex-end; gap: 8px; }
</style>
