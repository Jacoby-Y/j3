<!-- A sortable column header. dir: 0 not sorted, 1 ascending, 2 descending. -->

<script>
    props { label: string; dir: int; }
    events { sort; }

    fn deg(): string {
        return if dir == 2 { "180deg" } else { "0deg" };
    }
</script>

<button class="th" class:on={dir > 0} on:click={emit sort}>
    <span>{label}</span>
    <svg viewBox="0 0 10 10" style:opacity={if dir > 0 { 1.0 } else { 0.0 }} style:transform="rotate({deg()})"><path d="M1 7 L5 2 L9 7 Z" fill="currentColor" /></svg>
</button>

<style>
    .th { display: flex; align-items: center; gap: 6px; padding: 4px 0; background: transparent; color: var(--muted); font-weight: bold; }
    .th:hover { background: transparent; color: var(--text); }
    .th.on { color: var(--accent); }
    svg { width: 10px; height: 10px; transition: opacity 120ms, transform 160ms; }
</style>
