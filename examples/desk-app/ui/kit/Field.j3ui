<!-- A settings row: label (and an optional `hint` slot) on the left, the control (default slot) on the right. -->

<script>
    props { label: string; }
</script>

<label class="field">
    <div class="text">
        <span>{label}</span>
        {#if $slots.hint}<small><slot name="hint" /></small>{/if}
    </div>
    <div class="control"><slot /></div>
</label>

<style>
    .field { display: flex; align-items: center; gap: 16px; padding: 8px 12px; background: var(--raised); border-radius: var(--radius); }
    .text { display: flex; flex-direction: column; flex: 1; }
    .control { display: flex; align-items: center; gap: 8px; }
</style>
