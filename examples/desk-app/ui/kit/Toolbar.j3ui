<!-- A row of controls: default slot on the left, `end` slot pushed right. -->

<div class="bar">
    <div class="start"><slot /></div>
    <div class="end"><slot name="end" /></div>
</div>

<style>
    .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .start { display: flex; align-items: center; gap: 10px; flex: 1; }
    .end { display: flex; align-items: center; gap: 10px; }
</style>
