<!-- A scrolling table frame. Slots: `head` (column headers), default (rows), `empty` (shown when count is 0). The
     user styles the columns: head and rows are the user's markup, so a width class goes on both. -->

<script>
    props { count: int; }
</script>

<div class="table">
    <div class="head"><slot name="head" /></div>
    <div class="rows" role="listbox" aria-label="Rows">
        {#if count == 0}
            <div class="empty"><slot name="empty">Nothing here</slot></div>
        {:else}
            <slot />
        {/if}
    </div>
</div>

<style>
    .table { display: flex; flex-direction: column; flex: 1; min-height: 0; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
    .head { display: flex; align-items: center; padding: 4px 12px; border-bottom: 1px solid var(--line); }
    .rows { flex: 1; min-height: 0; overflow-x: hidden; overflow-y: auto; padding: 4px; }
    .empty { padding: 24px; color: var(--muted); }
</style>
