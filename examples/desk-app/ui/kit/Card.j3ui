<!-- A bordered box with a title row. Slots: default (body), `actions` (right of the title), `footer`. -->

<script>
    props { title: string; }
</script>

<section class="card">
    <header>
        <h2>{title}</h2>
        <div class="actions"><slot name="actions" /></div>
    </header>
    <div class="body"><slot /></div>
    <div class="foot"><slot name="footer" /></div>
</section>

<style>
    .card { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; }
    header { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid var(--line); }
    .actions { display: flex; gap: 6px; }
    .body { display: flex; flex-direction: column; gap: 10px; padding: 12px 14px; }
    .foot { display: flex; gap: 6px; }
</style>
