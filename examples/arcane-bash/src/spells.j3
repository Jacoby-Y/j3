// Casting and flying spells. A primary spell that ends anywhere (it fades, or hits an enemy, a
// shrine, or the ground) casts the wand's secondary spell from that spot.

module arcane_bash.spells;

use j3.math.{ Mat4, Vec3, min };
use j3.memory.Arena;
use j3.rand.Rng;
use arcane_bash.art;
use arcane_bash.art.Parts;
use arcane_bash.bits;
use arcane_bash.bits.Bits;
use arcane_bash.enemies;
use arcane_bash.enemies.Enemies;
use arcane_bash.player;
use arcane_bash.player.Player;
use arcane_bash.shrines;
use arcane_bash.shrines.Shrines;
use arcane_bash.wand;
use arcane_bash.wand.{ Spell, Wand };

const MAX: int = 300;

pub struct Proj {
    alive: bool;
    pos: Vec3;
    vel: Vec3;
    spell: int;
    life: f32;
    /// 0 for a cast, 1 for a secondary: those do not chain further.
    depth: int;
    dmg: f32;
    scale: f32;
    age: f32;
}

pub struct Spells {
    list: []Proj;
    next: int;
    rng: Rng;
}

pub fn create(mem: &Arena): Spells {
    return Spells { list: mem.alloc::<Proj>(MAX), next: 0, rng: Rng.new(21) };
}

pub fn reset(s: &Spells) {
    for i in 0..MAX { s.list[i].alive = false; }
}

/// The wand's pose: in front of the eye, low and to the right, pointing where you look.
fn wandBase(p: &Player): Mat4 {
    let l = player.look(p);
    let at = l.eye + l.forward() * 0.75 + l.right() * 0.3 + Vec3.xyz(0, -0.25, 0);
    return Mat4.translate(at.x, at.y, at.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0 - p.yaw)).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), p.pitch));
}

fn tip(p: &Player): Vec3 {
    return wandBase(p).transformPoint(Vec3.xyz(0, 0, -0.3));
}

fn spawn(s: &Spells, w: &Wand, p: &Player, spell: int, at: Vec3, dir: Vec3, depth: int) {
    let d = w.defs[spell];
    let dmg = d.dmg * p.stats.damage * p.stats.elem[d.elem];
    for k in 0..d.count {
        let v = dir;
        if d.count > 1 && depth > 0 { v = bits.spray(&s.rng); }
        else if d.spread > 0 { v = (dir + bits.spray(&s.rng) * d.spread).normalize(); }
        s.list[s.next] = Proj { alive: true, pos: at, vel: v * d.speed, spell: spell, life: d.life, depth: depth, dmg: dmg, scale: p.stats.size, age: 0 };
        s.next = (s.next + 1) % MAX;
    }
}

/// Fire the primary spell if the wand is ready and there is mana.
pub fn cast(s: &Spells, w: &Wand, p: &Player) {
    let id = wand.slot(w, 0);
    if id < 0 || w.cd > 0 { return; }
    let d = w.defs[id];
    if p.mana < d.cost { return; }
    p.mana -= d.cost;
    w.cd = d.cooldown;
    let l = player.look(p);
    let origin = tip(p);
    let aim = (l.eye + l.forward() * 40 - origin).normalize();
    spawn(s, w, p, id, origin, aim, 0);
}

/// Damage everything within `r` of `at`.
fn blast(s: &Spells, w: &Wand, p: &Player, e: &Enemies, sh: &Shrines, b: &Bits, pr: Proj, at: Vec3, r: f32) {
    let d = w.defs[pr.spell];
    for i in 0..enemies.MAX {
        if e.list[i].kind != 0 {
            let o = e.list[i].pos + Vec3.xyz(0, 0.6, 0) - at;
            if o.length() < r + enemies.radius(e.list[i].kind) {
                enemies.hit(e, b, p, i, pr.dmg * 0.8, d.elem, o.normalize());
            }
        }
    }
    for i in 0..shrines.MAX {
        if sh.list[i].alive {
            let so = sh.list[i].pos + Vec3.xyz(0, 1, 0) - at;
            if so.length() < r + shrines.radius() { shrines.hit(sh, b, w, i, pr.dmg * 0.8); }
        }
    }
}

/// Lightning jumps from the enemy at `from` to the nearest others.
fn chain(w: &Wand, p: &Player, e: &Enemies, b: &Bits, pr: Proj, from: int) {
    let d = w.defs[pr.spell];
    let last = from;
    let dmg = pr.dmg;
    let c = wand.color(d.elem);
    for k in 0..d.chain {
        if last < 0 { return; }
        let here = e.list[last].pos + Vec3.xyz(0, 0.6, 0);
        let next = enemies.nearest(e, here, 9, last);
        if next < 0 { return; }
        let there = e.list[next].pos + Vec3.xyz(0, 0.6, 0);
        for t in 0..6 { bits.burst(b, here + (there - here) * (f32(t) / 5), c, 1, 1, 0.22); }
        dmg = dmg * 0.75;
        enemies.hit(e, b, p, next, dmg, d.elem, (there - here).normalize());
        last = next;
    }
}

fn finish(s: &Spells, w: &Wand, p: &Player, e: &Enemies, sh: &Shrines, b: &Bits, i: int) {
    let pr = s.list[i];
    s.list[i].alive = false;
    let d = w.defs[pr.spell];
    let c = wand.color(d.elem);
    if d.aoe > 0 {
        let r = d.aoe * pr.scale;
        blast(s, w, p, e, sh, b, pr, pr.pos, r);
        bits.burst(b, pr.pos, c, 18 + int(r * 3), 6 + r * 2, 0.4);
    } else {
        bits.burst(b, pr.pos, c, 6, 5, 0.22);
    }
    if pr.depth == 0 {
        let sec = wand.slot(w, 1);
        if sec >= 0 {
            let dir = Vec3.up();
            if pr.vel.length() > 0.1 { dir = pr.vel.normalize(); }
            spawn(s, w, p, sec, pr.pos, dir, 1);
        }
    }
}

pub fn update(s: &Spells, w: &Wand, p: &Player, e: &Enemies, sh: &Shrines, b: &Bits, dt: f32) {
    w.cd -= dt;
    for i in 0..MAX {
        if s.list[i].alive {
            let pr = s.list[i];
            let d = w.defs[pr.spell];
            let r = d.radius * pr.scale;
            s.list[i].age += dt;
            s.list[i].life -= dt;
            s.list[i].vel.y -= d.gravity * dt;
            if pr.age > 0.1 && s.rng.unit() < 0.5 { bits.burst(b, pr.pos, wand.color(d.elem), 1, 1.5, 0.16); }
            let ended = s.list[i].life <= 0;
            let steps = 2;
            for step in 0..steps {
                if !ended {
                    s.list[i].pos = s.list[i].pos + s.list[i].vel * (dt / f32(steps));
                    let at = s.list[i].pos;
                    if at.y <= r * 0.5 || at.x < -50 || at.x > 50 || at.z < -50 || at.z > 50 { ended = true; }
                    for k in 0..enemies.MAX {
                        if !ended && e.list[k].kind != 0 {
                            let o = e.list[k].pos + Vec3.xyz(0, enemies.height(e.list[k].kind) * 0.5, 0) - at;
                            let reach = r + enemies.radius(e.list[k].kind);
                            if o.dot(o) < reach * reach {
                                let dir = s.list[i].vel.normalize();
                                enemies.hit(e, b, p, k, pr.dmg, d.elem, dir);
                                if d.chain > 0 && pr.depth == 0 { chain(w, p, e, b, pr, k); }
                                ended = true;
                            }
                        }
                    }
                    for k in 0..shrines.MAX {
                        if !ended && sh.list[k].alive {
                            let so = sh.list[k].pos + Vec3.xyz(0, 1, 0) - at;
                            let sreach = r + shrines.radius();
                            if so.dot(so) < sreach * sreach {
                                shrines.hit(sh, b, w, k, pr.dmg);
                                ended = true;
                            }
                        }
                    }
                }
            }
            if ended { finish(s, w, p, e, sh, b, i); }
        }
    }
}

pub fn prepare(s: &Spells, w: &Wand, p: &Player, a: &Parts) {
    // The wand in hand: a stick with a glowing tip in the primary spell's color.
    let id = wand.slot(w, 0);
    let c = wand.color(w.defs[id].elem);
    let base = wandBase(p);
    let kick = min(w.cd * 2, 0.15);
    art.cube(a, base, Vec3.xyz(0, 0, 0.05 + kick), Vec3.xyz(0.05, 0.05, 0.5), Vec3.xyz(0.6, 0.4, 0.22), Vec3.xyz(0.3, 0.2, 0.1));
    art.cube(a, base, Vec3.xyz(0, 0, -0.24 + kick), Vec3.xyz(0.1, 0.1, 0.1), c, c * 1.4);
    for i in 0..MAX {
        let pr = s.list[i];
        if pr.alive {
            let d = w.defs[pr.spell];
            let col = wand.color(d.elem);
            let size = d.radius * pr.scale * 1.4;
            let spin = Mat4.translate(pr.pos.x, pr.pos.y, pr.pos.z).mul(Mat4.rotate(Vec3.xyz(1, 1, 0), pr.age * 9));
            art.cube(a, spin, Vec3.zero(), Vec3.xyz(size, size, size), col, col * 1.0);
        }
    }
}
