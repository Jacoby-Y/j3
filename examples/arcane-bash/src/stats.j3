// Level-up bonuses. Every stat is a multiplier or an add on a base the other modules own.

module arcane_bash.stats;

use j3.memory.Arena;

pub const ARCANE: int = 0;
pub const FIRE: int = 1;
pub const ICE: int = 2;
pub const EARTH: int = 3;
pub const SPARK: int = 4;
pub const ELEMENTS: int = 5;

pub struct Stats {
    speed: f32 = 1;
    jump: f32 = 1;
    damage: f32 = 1;
    size: f32 = 1;
    maxMana: f32 = 0;
    regen: f32 = 0;
    maxHp: f32 = 0;
    /// Extra damage per element, as a multiplier.
    elem: [5]f32;
}

pub fn none(): Stats {
    return Stats { elem: [1, 1, 1, 1, 1] };
}

pub struct Bonus {
    name: string;
    text: string;
    /// Element this bonus boosts, or -1.
    elem: int;
}

const BONUSES: int = 12;

pub fn bonuses(mem: &Arena): []Bonus {
    let b = mem.alloc::<Bonus>(BONUSES);
    b[0] = Bonus { name: "Swift Feet", text: "+10% move speed", elem: -1 };
    b[1] = Bonus { name: "Spring Legs", text: "+15% jump height", elem: -1 };
    b[2] = Bonus { name: "Power", text: "+15% spell damage", elem: -1 };
    b[3] = Bonus { name: "Wide Magic", text: "+15% spell size and area", elem: -1 };
    b[4] = Bonus { name: "Deep Mana", text: "+20 max mana", elem: -1 };
    b[5] = Bonus { name: "Mana Flow", text: "+2 mana per second", elem: -1 };
    b[6] = Bonus { name: "Vitality", text: "+20 max health", elem: -1 };
    b[7] = Bonus { name: "Arcane Focus", text: "+25% arcane damage", elem: ARCANE };
    b[8] = Bonus { name: "Fire Focus", text: "+25% fire damage", elem: FIRE };
    b[9] = Bonus { name: "Ice Focus", text: "+25% ice damage", elem: ICE };
    b[10] = Bonus { name: "Earth Focus", text: "+25% earth damage", elem: EARTH };
    b[11] = Bonus { name: "Spark Focus", text: "+25% spark damage", elem: SPARK };
    return b;
}

pub fn count(): int { return BONUSES; }

pub fn apply(s: &Stats, id: int) {
    if id == 0 { s.speed += 0.1; }
    else if id == 1 { s.jump += 0.15; }
    else if id == 2 { s.damage += 0.15; }
    else if id == 3 { s.size += 0.15; }
    else if id == 4 { s.maxMana += 20; }
    else if id == 5 { s.regen += 2; }
    else if id == 6 { s.maxHp += 20; }
    else { s.elem[id - 7] += 0.25; }
}
