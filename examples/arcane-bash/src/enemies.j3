// Cute cube critters that swarm the player, and the XP gems they drop.

module arcane_bash.enemies;

use j3.math.{ Mat4, Vec3, abs, atan2, clamp, max, min, mini, sin, sqrt, PI };
use j3.memory.Arena;
use j3.rand.Rng;
use arcane_bash.art;
use arcane_bash.art.Parts;
use arcane_bash.bits;
use arcane_bash.bits.Bits;
use arcane_bash.player;
use arcane_bash.player.Player;
use arcane_bash.stats;

pub const SLIME: int = 1;
pub const BAT: int = 2;
pub const BRUTE: int = 3;
pub const MAX: int = 200;
const GEMS: int = 400;
const BURN_DPS: f32 = 6;
const PICKUP: f32 = 5;

pub struct Enemy {
    /// 0 for a free slot.
    kind: int;
    pos: Vec3;
    /// Knockback, fading out.
    knock: Vec3;
    hp: f32;
    flash: f32;
    burnT: f32;
    slowT: f32;
    phase: f32;
}

pub struct Gem {
    pos: Vec3;
    value: int;
    alive: bool;
    pulled: bool;
    phase: f32;
}

pub struct Enemies {
    list: []Enemy;
    gems: []Gem;
    nextGem: int;
    spawnT: f32;
    rng: Rng;
}

pub fn create(mem: &Arena): Enemies {
    return Enemies { list: mem.alloc::<Enemy>(MAX), gems: mem.alloc::<Gem>(GEMS), nextGem: 0, spawnT: 1, rng: Rng.new(77) };
}

pub fn reset(e: &Enemies) {
    for i in 0..MAX { e.list[i].kind = 0; }
    for i in 0..GEMS { e.gems[i].alive = false; }
    e.spawnT = 1;
}

pub fn radius(kind: int): f32 {
    if kind == BRUTE { return 1.0; }
    if kind == BAT { return 0.5; }
    return 0.6;
}

pub fn height(kind: int): f32 {
    if kind == BRUTE { return 2.7; }
    if kind == BAT { return 0.8; }
    return 1.2;
}

fn baseHp(kind: int): f32 {
    if kind == BRUTE { return 90; }
    if kind == BAT { return 12; }
    return 22;
}

fn baseSpeed(kind: int): f32 {
    if kind == BRUTE { return 2.6; }
    if kind == BAT { return 5.5; }
    return 3.4;
}

fn touchDamage(kind: int): f32 {
    if kind == BRUTE { return 16; }
    if kind == BAT { return 5; }
    return 8;
}

fn xpValue(kind: int): int {
    if kind == BRUTE { return 5; }
    return 1;
}

pub fn tint(kind: int): Vec3 {
    if kind == BRUTE { return Vec3.xyz(0.95, 0.4, 0.3); }
    if kind == BAT { return Vec3.xyz(0.6, 0.4, 0.9); }
    return Vec3.xyz(0.45, 0.9, 0.35);
}

pub fn alive(e: &Enemies): int {
    let n = 0;
    for i in 0..MAX { if e.list[i].kind != 0 { n += 1; } }
    return n;
}

/// Where a spawn goes: a ring around the player, kept on the baseplate.
fn ringPoint(e: &Enemies, around: Vec3): Vec3 {
    let a = e.rng.unit() * 2 * PI;
    let d = 26 + e.rng.unit() * 6;
    let x = clamp(around.x + sin(a) * d, -49, 49);
    let z = clamp(around.z + sin(a + PI * 0.5) * d, -49, 49);
    return Vec3.xyz(x, 0, z);
}

fn spawn(e: &Enemies, p: &Player, slot: int) {
    let t = p.time;
    let r = e.rng.unit();
    let kind = SLIME;
    if t > 70 && r < min((t - 70) / 300, 0.2) { kind = BRUTE; }
    else if t > 25 && r < 0.2 + min((t - 25) / 120, 0.3) { kind = BAT; }
    let hp = baseHp(kind) * (1 + t / 90);
    e.list[slot] = Enemy { kind: kind, pos: ringPoint(e, p.pos), knock: Vec3.zero(), hp: hp, flash: 0, burnT: 0, slowT: 0, phase: e.rng.unit() * 6 };
}

fn dropGem(e: &Enemies, at: Vec3, value: int) {
    e.gems[e.nextGem] = Gem { pos: Vec3.xyz(at.x, 0.4, at.z), value: value, alive: true, pulled: false, phase: e.rng.unit() * 6 };
    e.nextGem = (e.nextGem + 1) % GEMS;
}

fn kill(e: &Enemies, b: &Bits, p: &Player, i: int) {
    let en = e.list[i];
    bits.burst(b, en.pos + Vec3.xyz(0, height(en.kind) * 0.5, 0), tint(en.kind), 10, 7, 0.3);
    dropGem(e, en.pos, xpValue(en.kind));
    e.list[i].kind = 0;
    p.kills += 1;
}

/// Damage enemy `i`. `dir` is the way a hit shoves it (earth shoves harder). True if it died.
pub fn hit(e: &Enemies, b: &Bits, p: &Player, i: int, dmg: f32, elem: int, dir: Vec3): bool {
    e.list[i].hp -= dmg;
    e.list[i].flash = 0.12;
    if elem == stats.FIRE { e.list[i].burnT = 3; }
    if elem == stats.ICE { e.list[i].slowT = 2.5; }
    let shove: f32 = 2;
    if elem == stats.EARTH { shove = 9; }
    if e.list[i].kind != BRUTE || elem == stats.EARTH { e.list[i].knock = e.list[i].knock + dir * shove; }
    if e.list[i].hp <= 0 {
        kill(e, b, p, i);
        return true;
    }
    return false;
}

/// The nearest live enemy to `at` within `range`, other than `skip`, or -1.
pub fn nearest(e: &Enemies, at: Vec3, range: f32, skip: int): int {
    let best = -1;
    let bestD = range * range;
    for i in 0..MAX {
        if e.list[i].kind != 0 && i != skip {
            let d = e.list[i].pos + Vec3.xyz(0, 0.5, 0) - at;
            let d2 = d.dot(d);
            if d2 < bestD { bestD = d2; best = i; }
        }
    }
    return best;
}

fn move(e: &Enemies, p: &Player, i: int, dt: f32) {
    let en = e.list[i];
    let d = p.pos - en.pos;
    let flat = Vec3.xyz(d.x, 0, d.z);
    let len = flat.length();
    let dir = Vec3.zero();
    if len > 0.01 { dir = flat * (1 / len); }
    let rate = 1 + min(p.time / 400, 0.4);
    let speed = baseSpeed(en.kind) * rate;
    if en.slowT > 0 { speed = speed * 0.45; }
    en.phase += dt * (if en.kind == BAT { 6 } else { 4 });
    if en.kind == SLIME { speed = speed * (0.25 + 0.75 * abs(sin(en.phase))); }
    en.pos = en.pos + dir * (speed * dt) + en.knock * dt;
    en.knock = en.knock * max(1 - 6 * dt, 0);
    if en.kind == BAT { en.pos.y = 1.5 + sin(en.phase * 0.5) * 0.4; }
    else if en.kind == SLIME { en.pos.y = abs(sin(en.phase)) * 0.35; }
    en.pos.x = clamp(en.pos.x, -49.5, 49.5);
    en.pos.z = clamp(en.pos.z, -49.5, 49.5);
    en.flash = max(en.flash - dt, 0);
    if en.burnT > 0 {
        en.burnT -= dt;
        en.hp -= BURN_DPS * dt;
    }
    en.slowT = max(en.slowT - dt, 0);
    e.list[i] = en;
    // Come back into the ring when left far behind.
    if len > 60 { e.list[i].pos = ringPoint(e, p.pos); }
}

fn separate(e: &Enemies) {
    for i in 0..MAX {
        if e.list[i].kind != 0 {
            for j in (i + 1)..MAX {
                if e.list[j].kind != 0 {
                    let dx = e.list[j].pos.x - e.list[i].pos.x;
                    let dz = e.list[j].pos.z - e.list[i].pos.z;
                    let want = (radius(e.list[i].kind) + radius(e.list[j].kind)) * 0.85;
                    let d2 = dx * dx + dz * dz;
                    if d2 < want * want && d2 > 0.0001 {
                        let d = sqrt(d2);
                        let push = (want - d) * 0.5 / d;
                        e.list[i].pos.x -= dx * push;
                        e.list[i].pos.z -= dz * push;
                        e.list[j].pos.x += dx * push;
                        e.list[j].pos.z += dz * push;
                    }
                }
            }
        }
    }
}

pub fn update(e: &Enemies, b: &Bits, p: &Player, dt: f32): bool {
    let levelUp = false;
    e.spawnT -= dt;
    if e.spawnT <= 0 {
        e.spawnT = 0.3;
        let want = mini(6 + int(p.time / 5), MAX - 10);
        let have = alive(e);
        let k = 0;
        while have < want && k < MAX {
            if e.list[k].kind == 0 {
                spawn(e, p, k);
                have += 1;
                if have % 3 == 0 { k = MAX; }
            }
            k += 1;
        }
    }
    for i in 0..MAX {
        if e.list[i].kind != 0 {
            move(e, p, i, dt);
            if e.list[i].hp <= 0 {
                kill(e, b, p, i);
            } else {
                let en = e.list[i];
                let dx = p.pos.x - en.pos.x;
                let dz = p.pos.z - en.pos.z;
                let near = radius(en.kind) + player.RADIUS;
                if dx * dx + dz * dz < near * near && p.pos.y < en.pos.y + height(en.kind) && p.pos.y + 1.8 > en.pos.y {
                    player.hurt(p, touchDamage(en.kind));
                }
            }
        }
    }
    separate(e);
    for i in 0..GEMS {
        if e.gems[i].alive {
            e.gems[i].phase += dt * 3;
            let d = p.pos + Vec3.xyz(0, 1, 0) - e.gems[i].pos;
            let len = d.length();
            if len < PICKUP { e.gems[i].pulled = true; }
            if e.gems[i].pulled && len > 0.01 {
                e.gems[i].pos = e.gems[i].pos + d * (1 / len) * ((9 + (PICKUP - min(len, PICKUP)) * 5) * dt);
            }
            if len < 0.9 {
                e.gems[i].alive = false;
                bits.burst(b, e.gems[i].pos, Vec3.xyz(0.4, 1, 0.9), 4, 3, 0.15);
                if player.gain(p, e.gems[i].value) { levelUp = true; }
            }
        }
    }
    return levelUp;
}

fn drawSlime(a: &Parts, base: Mat4, en: Enemy, tn: Vec3, glow: Vec3) {
    let sq = 1 + 0.2 * sin(en.phase * 2);
    let white = Vec3.xyz(1, 1, 1);
    let dark = Vec3.xyz(0.1, 0.12, 0.15);
    art.cube(a, base, Vec3.xyz(0, 0.45, 0), Vec3.xyz(1.1, 0.9 * sq, 1.1), tn, glow);
    art.cube(a, base, Vec3.xyz(0, 0.98 * sq, 0), Vec3.xyz(0.6, 0.25, 0.6), tn * 1.15, glow);
    art.cube(a, base, Vec3.xyz(-0.25, 0.6, -0.56), Vec3.xyz(0.2, 0.28, 0.06), white, glow);
    art.cube(a, base, Vec3.xyz(0.25, 0.6, -0.56), Vec3.xyz(0.2, 0.28, 0.06), white, glow);
    art.cube(a, base, Vec3.xyz(-0.25, 0.57, -0.6), Vec3.xyz(0.1, 0.14, 0.04), dark, glow);
    art.cube(a, base, Vec3.xyz(0.25, 0.57, -0.6), Vec3.xyz(0.1, 0.14, 0.04), dark, glow);
    art.cube(a, base, Vec3.xyz(-0.42, 0.4, -0.56), Vec3.xyz(0.14, 0.08, 0.04), Vec3.xyz(1, 0.55, 0.65), glow);
    art.cube(a, base, Vec3.xyz(0.42, 0.4, -0.56), Vec3.xyz(0.14, 0.08, 0.04), Vec3.xyz(1, 0.55, 0.65), glow);
}

fn drawBat(a: &Parts, base: Mat4, en: Enemy, tn: Vec3, glow: Vec3) {
    let flap = sin(en.phase * 2) * 0.6;
    let z = Vec3.xyz(0, 0, 1);
    art.cube(a, base, Vec3.zero(), Vec3.xyz(0.55, 0.5, 0.55), tn, glow);
    art.cube(a, base, Vec3.xyz(-0.18, 0.33, 0), Vec3.xyz(0.12, 0.2, 0.12), tn * 0.8, glow);
    art.cube(a, base, Vec3.xyz(0.18, 0.33, 0), Vec3.xyz(0.12, 0.2, 0.12), tn * 0.8, glow);
    art.cube(a, base, Vec3.xyz(-0.14, 0.05, -0.28), Vec3.xyz(0.12, 0.14, 0.04), Vec3.xyz(1, 0.9, 0.3), Vec3.xyz(1, 0.9, 0.3));
    art.cube(a, base, Vec3.xyz(0.14, 0.05, -0.28), Vec3.xyz(0.12, 0.14, 0.04), Vec3.xyz(1, 0.9, 0.3), Vec3.xyz(1, 0.9, 0.3));
    art.cube(a, base, Vec3.xyz(-0.08, -0.17, -0.28), Vec3.xyz(0.06, 0.1, 0.04), Vec3.xyz(1, 1, 1), glow);
    art.cube(a, base, Vec3.xyz(0.08, -0.17, -0.28), Vec3.xyz(0.06, 0.1, 0.04), Vec3.xyz(1, 1, 1), glow);
    art.cube(a, base.mul(Mat4.rotate(z, flap)), Vec3.xyz(0.6, 0, 0), Vec3.xyz(0.75, 0.08, 0.45), tn * 0.7, glow);
    art.cube(a, base.mul(Mat4.rotate(z, 0 - flap)), Vec3.xyz(-0.6, 0, 0), Vec3.xyz(0.75, 0.08, 0.45), tn * 0.7, glow);
}

fn drawBrute(a: &Parts, base: Mat4, en: Enemy, tn: Vec3, glow: Vec3) {
    let swing = sin(en.phase) * 0.25;
    let white = Vec3.xyz(1, 1, 1);
    let dark = Vec3.xyz(0.12, 0.1, 0.12);
    art.cube(a, base, Vec3.xyz(-0.38, 0.4, swing), Vec3.xyz(0.55, 0.8, 0.6), tn * 0.6, glow);
    art.cube(a, base, Vec3.xyz(0.38, 0.4, 0 - swing), Vec3.xyz(0.55, 0.8, 0.6), tn * 0.6, glow);
    art.cube(a, base, Vec3.xyz(0, 1.3, 0), Vec3.xyz(1.4, 1.0, 0.95), tn, glow);
    art.cube(a, base, Vec3.xyz(0, 1.2, -0.45), Vec3.xyz(0.8, 0.6, 0.08), tn * 1.2, glow);
    art.cube(a, base, Vec3.xyz(-0.95, 1.25, 0 - swing), Vec3.xyz(0.45, 1.0, 0.5), tn * 0.85, glow);
    art.cube(a, base, Vec3.xyz(0.95, 1.25, swing), Vec3.xyz(0.45, 1.0, 0.5), tn * 0.85, glow);
    art.cube(a, base, Vec3.xyz(0, 2.1, -0.05), Vec3.xyz(0.9, 0.75, 0.8), tn * 1.1, glow);
    art.cube(a, base, Vec3.xyz(-0.35, 2.6, 0), Vec3.xyz(0.16, 0.3, 0.16), Vec3.xyz(1, 0.95, 0.8), glow);
    art.cube(a, base, Vec3.xyz(0.35, 2.6, 0), Vec3.xyz(0.16, 0.3, 0.16), Vec3.xyz(1, 0.95, 0.8), glow);
    art.cube(a, base, Vec3.xyz(-0.22, 2.2, -0.42), Vec3.xyz(0.2, 0.16, 0.05), white, glow);
    art.cube(a, base, Vec3.xyz(0.22, 2.2, -0.42), Vec3.xyz(0.2, 0.16, 0.05), white, glow);
    art.cube(a, base, Vec3.xyz(-0.22, 2.19, -0.46), Vec3.xyz(0.09, 0.1, 0.04), dark, glow);
    art.cube(a, base, Vec3.xyz(0.22, 2.19, -0.46), Vec3.xyz(0.09, 0.1, 0.04), dark, glow);
    art.cube(a, base, Vec3.xyz(0, 1.95, -0.42), Vec3.xyz(0.42, 0.08, 0.05), dark, glow);
}

pub fn prepare(e: &Enemies, a: &Parts, p: &Player) {
    for i in 0..MAX {
        let en = e.list[i];
        if en.kind != 0 {
            let yaw = atan2(0 - (p.pos.x - en.pos.x), 0 - (p.pos.z - en.pos.z));
            let base = Mat4.translate(en.pos.x, en.pos.y, en.pos.z).mul(Mat4.rotate(Vec3.xyz(0, 1, 0), yaw));
            let tn = tint(en.kind);
            let glow = tn * 0.22;
            if en.slowT > 0 { tn = tn * 0.5 + Vec3.xyz(0.25, 0.45, 0.55); }
            if en.burnT > 0 { glow = Vec3.xyz(0.5, 0.18, 0.02); }
            if en.flash > 0 { glow = Vec3.xyz(1.2, 1.2, 1.2); }
            if en.kind == SLIME { drawSlime(a, base, en, tn, glow); }
            else if en.kind == BAT { drawBat(a, base, en, tn, glow); }
            else { drawBrute(a, base, en, tn, glow); }
        }
    }
    let id = Mat4.identity();
    for i in 0..GEMS {
        let g = e.gems[i];
        if g.alive {
            let c = Vec3.xyz(0.3, 0.95, 0.85);
            let s: f32 = 0.3;
            if g.value >= 5 { c = Vec3.xyz(1, 0.8, 0.25); s = 0.42; }
            let spin = Mat4.rotate(Vec3.xyz(0, 1, 0), g.phase);
            art.cube(a, Mat4.translate(g.pos.x, g.pos.y + sin(g.phase) * 0.08, g.pos.z).mul(spin), Vec3.zero(), Vec3.xyz(s, s, s), c, c * 0.9);
        }
    }
}
