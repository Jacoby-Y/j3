// Small flying cubes for bursts, trails and sparkles.

module arcane_bash.bits;

use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use j3.rand.Rng;
use arcane_bash.art;
use arcane_bash.art.Parts;

const CAP: int = 600;

pub struct Bit {
    pos: Vec3;
    vel: Vec3;
    life: f32;
    max: f32;
    tint: Vec3;
    size: f32;
}

pub struct Bits {
    list: []Bit;
    next: int;
    rng: Rng;
}

pub fn create(mem: &Arena): Bits {
    return Bits { list: mem.alloc::<Bit>(CAP), next: 0, rng: Rng.new(5) };
}

pub fn reset(b: &Bits) {
    for i in 0..CAP { b.list[i].life = 0; }
}

/// A random unit vector.
pub fn spray(r: &Rng): Vec3 {
    let v = Vec3.xyz(r.unit() * 2 - 1, r.unit() * 2 - 1, r.unit() * 2 - 1);
    if v.length() < 0.01 { return Vec3.up(); }
    return v.normalize();
}

/// `n` cubes thrown out of `at`.
pub fn burst(b: &Bits, at: Vec3, tint: Vec3, n: int, speed: f32, size: f32) {
    for k in 0..n {
        let d = spray(&b.rng);
        let s = speed * (0.4 + b.rng.unit() * 0.6);
        let life = 0.35 + b.rng.unit() * 0.4;
        b.list[b.next] = Bit { pos: at, vel: d * s, life: life, max: life, tint: tint, size: size * (0.6 + b.rng.unit() * 0.6) };
        b.next = (b.next + 1) % CAP;
    }
}

pub fn update(b: &Bits, dt: f32) {
    for i in 0..CAP {
        if b.list[i].life > 0 {
            b.list[i].life -= dt;
            b.list[i].vel.y -= 9 * dt;
            b.list[i].pos = b.list[i].pos + b.list[i].vel * dt;
        }
    }
}

pub fn prepare(b: &Bits, parts: &Parts) {
    let id = Mat4.identity();
    for i in 0..CAP {
        let bit = b.list[i];
        if bit.life > 0 {
            let s = bit.size * (bit.life / bit.max);
            art.cube(parts, id, bit.pos, Vec3.xyz(s, s, s), bit.tint, bit.tint * 1.2);
        }
    }
}
