// The mage: first-person movement on the flat baseplate, health, mana, and XP.

module arcane_bash.player;

use j3.game;
use j3.game.Key;
use j3.gfx.Look;
use j3.math.{ Vec3, clamp, cos, max, min, sin, sqrt };
use arcane_bash.stats;
use arcane_bash.stats.Stats;

pub const EYE: f32 = 1.7;
pub const RADIUS: f32 = 0.45;
/// Half the baseplate, less a margin.
pub const ARENA: f32 = 48;
const WALK: f32 = 7.5;
const ACCEL: f32 = 14;
const GRAVITY: f32 = 24;
const JUMP: f32 = 8.2;
const SENSITIVITY: f32 = 0.0022;
const BASE_HP: f32 = 100;
const BASE_MANA: f32 = 100;
const BASE_REGEN: f32 = 6;
const INVULN: f32 = 0.6;

pub struct Player {
    pos: Vec3;
    vel: Vec3;
    yaw: f32;
    pitch: f32;
    onGround: bool;
    hp: f32;
    mana: f32;
    xp: int;
    level: int;
    /// Level-ups not yet spent on a bonus.
    pending: int;
    stats: Stats;
    /// Seconds since the last hit, for the red flash and the brief invulnerability.
    hurtT: f32;
    kills: int;
    time: f32;
    /// Bob phase for the wand sway.
    bob: f32;
}

pub fn create(): Player {
    return Player {
        pos: Vec3.zero(), vel: Vec3.zero(), yaw: 0, pitch: 0, onGround: true,
        hp: BASE_HP, mana: BASE_MANA, xp: 0, level: 1, pending: 0, stats: stats.none(),
        hurtT: 10, kills: 0, time: 0, bob: 0,
    };
}

pub fn maxHp(p: &Player): f32 { return BASE_HP + p.stats.maxHp; }
pub fn maxMana(p: &Player): f32 { return BASE_MANA + p.stats.maxMana; }

/// XP from `level` to the next.
pub fn need(level: int): int {
    return 5 + (level - 1) * 4 + ((level - 1) * (level - 1)) / 4;
}

/// Take XP. Returns true when it carried the player up a level.
pub fn gain(p: &Player, amount: int): bool {
    p.xp += amount;
    let up = false;
    while p.xp >= need(p.level) {
        p.xp -= need(p.level);
        p.level += 1;
        p.pending += 1;
        up = true;
    }
    return up;
}

/// A hit. False while the last one still protects.
pub fn hurt(p: &Player, dmg: f32): bool {
    if p.hurtT < INVULN { return false; }
    p.hp -= dmg;
    p.hurtT = 0;
    return true;
}

pub fn dead(p: &Player): bool { return p.hp <= 0; }

pub fn look(p: &Player): Look {
    let bob = sin(p.bob) * 0.03;
    return Look.create(p.pos + Vec3.xyz(0, EYE + bob, 0), p.yaw, p.pitch);
}

/// Mouse look, WASD, jump, and mana regeneration. `looking` is false while a menu is open.
pub fn update(p: &Player, dt: f32, looking: bool) {
    p.time += dt;
    p.hurtT += dt;
    p.mana = min(p.mana + (BASE_REGEN + p.stats.regen) * dt, maxMana(p));
    if !looking { return; }
    let m = game.mouseDelta();
    p.yaw += m.x * SENSITIVITY;
    p.pitch = clamp(p.pitch - m.y * SENSITIVITY, -1.5, 1.5);

    let flat = Look.create(p.pos, p.yaw, 0);
    let wish = Vec3.zero();
    if game.keyDown(Key.W) { wish = wish + flat.forward(); }
    if game.keyDown(Key.S) { wish = wish - flat.forward(); }
    if game.keyDown(Key.D) { wish = wish + flat.right(); }
    if game.keyDown(Key.A) { wish = wish - flat.right(); }
    wish = wish.normalize() * (WALK * p.stats.speed);
    let k = min(ACCEL * dt, 1);
    p.vel.x += (wish.x - p.vel.x) * k;
    p.vel.z += (wish.z - p.vel.z) * k;
    if p.onGround && game.keyDown(Key.Space) {
        p.vel.y = JUMP * sqrt(p.stats.jump);
        p.onGround = false;
    }
    p.vel.y -= GRAVITY * dt;
    p.pos = p.pos + p.vel * dt;
    if p.pos.y <= 0 {
        p.pos.y = 0;
        p.vel.y = 0;
        p.onGround = true;
    }
    p.pos.x = clamp(p.pos.x, 0 - ARENA, ARENA);
    p.pos.z = clamp(p.pos.z, 0 - ARENA, ARENA);
    if wish.length() > 0.1 && p.onGround { p.bob += dt * 11; }
}
