// Everything drawn on top of the 3D view: bars, crosshair, and the inventory, level-up and
// death screens.

module arcane_bash.hud;

use j3.game;
use j3.game.{ Color, Font, Mouse };
use j3.math.{ Vec2, Vec3, clamp, max, min };
use arcane_bash.player;
use arcane_bash.player.{ Player, need };
use arcane_bash.shrines.Shrines;
use arcane_bash.stats.Bonus;
use arcane_bash.wand;
use arcane_bash.wand.{ Spell, Wand };

fn rect(x: f32, y: f32, w: f32, h: f32) {
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

fn text(font: Font, x: f32, y: f32, s: string) {
    game.drawText(font, Vec2 { x: x, y: y }, s);
}

fn centered(font: Font, cx: f32, y: f32, s: string) {
    let t = game.textSize(font, s);
    text(font, cx - t.x * 0.5, y, s);
}

fn tone(c: Vec3, a: u8): Color {
    return game.rgba(u8(c.x * 255), u8(c.y * 255), u8(c.z * 255), a);
}

fn bar(x: f32, y: f32, w: f32, h: f32, frac: f32, c: Color) {
    game.setColor(game.rgba(10, 12, 24, 170));
    rect(x - 2, y - 2, w + 4, h + 4);
    game.setColor(c);
    rect(x, y, w * clamp(frac, 0, 1), h);
}

fn slot(font: Font, x: f32, y: f32, label: string, w: &Wand, which: int) {
    let id = wand.slot(w, which);
    game.setColor(game.rgba(10, 12, 24, 170));
    rect(x, y, 150, 44);
    if id >= 0 {
        let d = w.defs[id];
        game.setColor(tone(wand.color(d.elem), 255));
        rect(x + 6, y + 6, 6, 32);
        game.setColor(game.rgb(255, 255, 255));
        text(font, x + 20, y + 4, d.name);
    } else {
        game.setColor(game.rgb(130, 135, 160));
        text(font, x + 20, y + 4, "empty");
    }
    game.setColor(game.rgb(150, 155, 185));
    text(font, x + 20, y + 24, label);
}

pub fn play(font: Font, big: Font, p: &Player, w: &Wand, sh: &Shrines) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    let cy = sz.y * 0.5;
    let flash = max(1 - p.hurtT * 2.5, 0);
    if flash > 0 {
        game.setColor(game.rgba(255, 30, 40, u8(flash * 90)));
        rect(0, 0, sz.x, sz.y);
    }
    game.setColor(game.rgba(10, 10, 20, 170));
    rect(cx - 6, cy - 2, 12, 4);
    rect(cx - 2, cy - 6, 4, 12);
    game.setColor(game.rgb(255, 255, 255));
    rect(cx - 5, cy - 1, 10, 2);
    rect(cx - 1, cy - 5, 2, 10);

    bar(0, 0, sz.x, 8, f32(p.xp) / f32(need(p.level)), game.rgb(90, 240, 220));
    game.setColor(game.rgb(255, 255, 255));
    text(font, 12, 14, `LV {p.level}`);
    let mins = int(p.time) / 60;
    let secs = int(p.time) % 60;
    let clock = `{mins}:{secs}`;
    if secs < 10 { clock = `{mins}:0{secs}`; }
    let right = game.textSize(font, `{clock}   {p.kills} kills`);
    text(font, sz.x - right.x - 14, 14, `{clock}   {p.kills} kills`);

    bar(20, sz.y - 62, 260, 20, p.hp / player.maxHp(p), game.rgb(235, 70, 80));
    bar(20, sz.y - 34, 260, 14, p.mana / player.maxMana(p), game.rgb(80, 130, 255));
    game.setColor(game.rgb(255, 255, 255));
    text(font, 26, sz.y - 62, `{int(p.hp)} / {int(player.maxHp(p))}`);
    slot(font, cx - 160, sz.y - 60, "left click", w, 0);
    slot(font, cx + 10, sz.y - 60, "on end", w, 1);
    game.setColor(game.rgb(150, 155, 185));
    text(font, sz.x - 150, sz.y - 30, "Tab: spells");

    if sh.found >= 0 && sh.foundT < 3.5 {
        let d = w.defs[sh.found];
        game.setColor(tone(wand.color(d.elem), 255));
        centered(big, cx, 70, `Learned {d.name}`);
    }
}

/// The spell list. Left click sets the primary spell, right click the secondary.
pub fn inventory(font: Font, big: Font, w: &Wand) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    game.setColor(game.rgba(8, 8, 20, 200));
    rect(0, 0, sz.x, sz.y);
    game.setColor(game.rgb(255, 255, 255));
    centered(big, cx, 20, "Spells");
    game.setColor(game.rgb(150, 155, 185));
    centered(font, cx, 72, "left click: primary    right click: secondary (again clears it)    Tab: back");
    let m = game.mousePos();
    let left = cx - 280;
    for i in 0..w.n {
        let d = w.defs[w.items[i]];
        let y = 110 + f32(i) * 24;
        let over = m.x >= left && m.x <= left + 560 && m.y >= y && m.y < y + 23;
        if over {
            game.setColor(game.rgba(255, 255, 255, 40));
            rect(left, y, 560, 23);
            if game.mousePressed(Mouse.Left) { wand.equip(w, 0, i); }
            if game.mousePressed(Mouse.Right) { wand.equip(w, 1, i); }
        }
        game.setColor(tone(wand.color(d.elem), 255));
        rect(left + 4, y + 4, 12, 14);
        game.setColor(game.rgb(255, 255, 255));
        text(font, left + 26, y + 2, d.name);
        game.setColor(game.rgb(150, 155, 185));
        text(font, left + 190, y + 2, `{wand.elementName(d.elem)}   dmg {int(d.dmg)}   mana {int(d.cost)}`);
        if i == w.primary {
            game.setColor(game.rgb(120, 255, 160));
            text(font, left + 500, y + 2, "PRIMARY");
        } else if i == w.secondary {
            game.setColor(game.rgb(255, 210, 110));
            text(font, left + 480, y + 2, "SECONDARY");
        }
    }
}

/// Three bonus cards. Returns the card picked (0..2), or -1.
pub fn levelUp(font: Font, big: Font, bonuses: []Bonus, choices: []int, level: int): int {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    game.setColor(game.rgba(8, 8, 20, 190));
    rect(0, 0, sz.x, sz.y);
    game.setColor(game.rgb(255, 235, 120));
    centered(big, cx, 50, `Level {level}!`);
    game.setColor(game.rgb(200, 205, 230));
    centered(font, cx, 100, "Pick a bonus: click, or press 1 2 3");
    let m = game.mousePos();
    let picked = -1;
    for i in 0..3 {
        let b = bonuses[choices[i]];
        let x = cx - 330 + f32(i) * 230;
        let y = sz.y * 0.5 - 70;
        let over = m.x >= x && m.x <= x + 210 && m.y >= y && m.y <= y + 150;
        game.setColor(game.rgba(40, 44, 90, 235));
        if over { game.setColor(game.rgba(70, 76, 150, 245)); }
        rect(x, y, 210, 150);
        game.setColor(game.rgb(255, 255, 255));
        centered(font, x + 105, y + 20, b.name);
        game.setColor(game.rgb(170, 175, 210));
        centered(font, x + 105, y + 70, b.text);
        centered(font, x + 105, y + 120, `[{i + 1}]`);
        if over && game.mousePressed(Mouse.Left) { picked = i; }
    }
    return picked;
}

pub fn dead(font: Font, big: Font, p: &Player) {
    let sz = game.windowSize();
    let cx = sz.x * 0.5;
    game.setColor(game.rgba(30, 0, 10, 200));
    rect(0, 0, sz.x, sz.y);
    game.setColor(game.rgb(255, 120, 130));
    centered(big, cx, sz.y * 0.3, "The horde got you");
    game.setColor(game.rgb(255, 255, 255));
    let mins = int(p.time) / 60;
    let secs = int(p.time) % 60;
    centered(font, cx, sz.y * 0.3 + 70, `Survived {mins} min {secs} s   level {p.level}   {p.kills} kills`);
    centered(font, cx, sz.y * 0.3 + 110, "R: try again");
}
