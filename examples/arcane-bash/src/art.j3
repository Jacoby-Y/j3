// Everything that is not the baseplate is a pile of unit cubes. Systems add cubes while the
// frame is prepared, then `draw` submits the whole pile once per pass (shadow and camera).

module arcane_bash.art;

use j3.gfx;
use j3.gfx.{ Instance, Mesh, Tex };
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use j3.scene3d;

const CAP: int = 6000;

pub struct Parts {
    list: []Instance;
    n: int;
    cube: Mesh;
}

pub fn create(mem: &Arena): Parts {
    return Parts { list: mem.alloc::<Instance>(CAP), n: 0, cube: Mesh { vao: 0, vbo: 0, count: 0 } };
}

pub fn upload(p: &Parts, mem: &Arena) {
    p.cube = gfx.uploadUv(scene3d.assetVerts("builtin:cube", mem));
}

pub fn begin(p: &Parts) {
    p.n = 0;
}

/// A cube centered `at` (in `base`'s space), `sz` across, with a color and a glow. Dropped when full.
pub fn cube(p: &Parts, base: Mat4, at: Vec3, sz: Vec3, tint: Vec3, glow: Vec3) {
    if p.n >= CAP { return; }
    p.list[p.n] = Instance { model: base.mul(Mat4.translate(at.x, at.y, at.z)).mul(Mat4.scale(sz.x, sz.y, sz.z)), tint: tint, emission: glow };
    p.n += 1;
}

pub fn draw(p: &Parts) {
    gfx.surface(gfx.plainSurface());
    // The scene leaves its last texture bound; the cubes are plain colors.
    gfx.albedo(Tex { id: 0, w: 1, h: 1 });
    gfx.drawInstances(p.cube, p.list[0..p.n]);
}
