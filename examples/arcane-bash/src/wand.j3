// The wand and its inventory. `primary` is what left click casts. `secondary` is cast for free
// from wherever the primary spell ends (it fades, or hits an enemy, a shrine, or the ground).
// Both are slots holding an inventory index, or -1.

module arcane_bash.wand;

use j3.math.Vec3;
use j3.memory.Arena;
use j3.rand.Rng;
use arcane_bash.stats;

pub struct Spell {
    name: string;
    elem: int;
    dmg: f32;
    speed: f32;
    life: f32;
    radius: f32;
    cost: f32;
    cooldown: f32;
    /// Projectiles per cast.
    count: int;
    spread: f32;
    /// Explosion radius where it ends, or 0.
    aoe: f32;
    gravity: f32;
    /// Extra enemies a hit jumps to.
    chain: int;
}

pub const SPELLS: int = 10;
pub const INVENTORY: int = 16;

pub struct Wand {
    defs: []Spell;
    /// Spell ids held.
    items: []int;
    n: int;
    primary: int;
    secondary: int;
    cd: f32;
    rng: Rng;
}

fn def(d: []Spell, i: int, name: string, elem: int, dmg: f32, speed: f32, life: f32, radius: f32, cost: f32, cooldown: f32) {
    d[i] = Spell { name: name, elem: elem, dmg: dmg, speed: speed, life: life, radius: radius, cost: cost, cooldown: cooldown, count: 1, spread: 0, aoe: 0, gravity: 0, chain: 0 };
}

pub fn create(mem: &Arena): Wand {
    let d = mem.alloc::<Spell>(SPELLS);
    def(d, 0, "Arcane Bolt", stats.ARCANE, 12, 30, 1.2, 0.3, 5, 0.3);
    def(d, 1, "Fireball", stats.FIRE, 18, 20, 1.4, 0.45, 12, 0.5);
    d[1].aoe = 3;
    def(d, 2, "Frost Shards", stats.ICE, 8, 34, 1.0, 0.25, 8, 0.3);
    d[2].count = 3;
    d[2].spread = 0.12;
    def(d, 3, "Stone Lob", stats.EARTH, 24, 17, 1.3, 0.5, 14, 0.7);
    d[3].gravity = 14;
    d[3].aoe = 3.5;
    def(d, 4, "Spark", stats.SPARK, 10, 46, 0.7, 0.3, 7, 0.2);
    d[4].chain = 2;
    def(d, 5, "Ember Burst", stats.FIRE, 7, 15, 0.55, 0.3, 14, 0.6);
    d[5].count = 7;
    d[5].spread = 0.45;
    d[5].aoe = 1.5;
    def(d, 6, "Frost Nova", stats.ICE, 14, 0, 0.12, 0.3, 18, 0.9);
    d[6].aoe = 6;
    def(d, 7, "Boulder", stats.EARTH, 40, 10, 2.0, 0.8, 22, 1.1);
    d[7].aoe = 4;
    def(d, 8, "Chain Lightning", stats.SPARK, 14, 40, 0.8, 0.3, 12, 0.45);
    d[8].chain = 4;
    def(d, 9, "Comet", stats.ARCANE, 22, 26, 1.0, 0.4, 15, 0.55);
    d[9].aoe = 2.5;
    let w = Wand { defs: d, items: mem.alloc::<int>(INVENTORY), n: 0, primary: 0, secondary: -1, cd: 0, rng: Rng.new(31) };
    reset(&w);
    return w;
}

pub fn reset(w: &Wand) {
    w.items[0] = 0;
    w.n = 1;
    w.primary = 0;
    w.secondary = -1;
    w.cd = 0;
}

/// The spell id in a slot (0 primary, 1 secondary), or -1.
pub fn slot(w: &Wand, which: int): int {
    let i = w.primary;
    if which == 1 { i = w.secondary; }
    if i < 0 || i >= w.n { return -1; }
    return w.items[i];
}

/// Add a spell. A full inventory drops its last spell that is not equipped.
pub fn pickup(w: &Wand, spell: int) {
    if w.n < INVENTORY {
        w.items[w.n] = spell;
        w.n += 1;
        return;
    }
    let i = INVENTORY - 1;
    while i > 0 && (i == w.primary || i == w.secondary) { i -= 1; }
    w.items[i] = spell;
}

/// Put inventory entry `i` in a slot. Picking what the other slot holds swaps them; picking the
/// secondary again clears it.
pub fn equip(w: &Wand, which: int, i: int) {
    if which == 0 {
        if w.secondary == i { w.secondary = w.primary; }
        w.primary = i;
    } else if w.secondary == i {
        w.secondary = -1;
    } else if w.primary == i {
        w.primary = w.secondary;
        w.secondary = i;
        if w.primary < 0 { w.primary = i; w.secondary = -1; }
    } else {
        w.secondary = i;
    }
}

pub fn color(elem: int): Vec3 {
    if elem == stats.FIRE { return Vec3.xyz(1, 0.45, 0.15); }
    if elem == stats.ICE { return Vec3.xyz(0.45, 0.85, 1); }
    if elem == stats.EARTH { return Vec3.xyz(0.7, 0.5, 0.25); }
    if elem == stats.SPARK { return Vec3.xyz(1, 0.95, 0.3); }
    return Vec3.xyz(0.75, 0.4, 1);
}

pub fn elementName(elem: int): string {
    if elem == stats.FIRE { return "Fire"; }
    if elem == stats.ICE { return "Ice"; }
    if elem == stats.EARTH { return "Earth"; }
    if elem == stats.SPARK { return "Spark"; }
    return "Arcane";
}
