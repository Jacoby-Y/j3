// Shrines appear more often the longer you live. Break one to learn a random spell.

module arcane_bash.shrines;

use j3.math.{ Mat4, Vec3, PI, clamp, min, mini, sin, sqrt };
use j3.memory.Arena;
use j3.rand.Rng;
use arcane_bash.art;
use arcane_bash.art.Parts;
use arcane_bash.bits;
use arcane_bash.bits.Bits;
use arcane_bash.player;
use arcane_bash.player.Player;
use arcane_bash.wand;
use arcane_bash.wand.Wand;

pub const MAX: int = 10;
const RADIUS: f32 = 1.1;
const FIRST: f32 = 8;

pub struct Shrine {
    alive: bool;
    pos: Vec3;
    hp: f32;
    flash: f32;
    /// The spell inside.
    spell: int;
    phase: f32;
}

pub struct Shrines {
    list: []Shrine;
    rng: Rng;
    spawnT: f32;
    /// The last spell found and how long ago, for the banner.
    found: int;
    foundT: f32;
}

pub fn create(mem: &Arena): Shrines {
    return Shrines { list: mem.alloc::<Shrine>(MAX), rng: Rng.new(13), spawnT: FIRST, found: -1, foundT: 99 };
}

pub fn reset(s: &Shrines) {
    for i in 0..MAX { s.list[i].alive = false; }
    s.spawnT = FIRST;
    s.found = -1;
    s.foundT = 99;
}

pub fn radius(): f32 { return RADIUS; }

/// A random spell that is not the starter.
fn roll(s: &Shrines): int {
    return 1 + int(s.rng.unit() * f32(wand.SPELLS - 1)) % (wand.SPELLS - 1);
}

fn place(s: &Shrines, p: &Player, slot: int) {
    for attempt in 0..8 {
        let a = s.rng.unit() * 2 * PI;
        let d = 12 + s.rng.unit() * 24;
        let at = Vec3.xyz(clamp(p.pos.x + sin(a) * d, -45, 45), 0, clamp(p.pos.z + sin(a + PI * 0.5) * d, -45, 45));
        let clear = true;
        for j in 0..MAX {
            if s.list[j].alive {
                let o = s.list[j].pos - at;
                if o.length() < 8 { clear = false; }
            }
        }
        if clear || attempt == 7 {
            s.list[slot] = Shrine { alive: true, pos: at, hp: 40 + p.time / 6, flash: 0, spell: roll(s), phase: s.rng.unit() * 6 };
            return;
        }
    }
}

pub fn update(s: &Shrines, p: &Player, dt: f32) {
    s.foundT += dt;
    s.spawnT -= dt;
    if s.spawnT <= 0 {
        s.spawnT = clamp(40 - p.time / 10, 10, 40);
        let cap = mini(3 + int(p.time / 40), MAX);
        let have = 0;
        let free = -1;
        for i in 0..MAX {
            if s.list[i].alive { have += 1; } else { free = i; }
        }
        if have < cap && free >= 0 { place(s, p, free); }
    }
    for i in 0..MAX {
        if s.list[i].alive {
            s.list[i].phase += dt * 2;
            s.list[i].flash = min(s.list[i].flash, 0.2) - dt;
            // Solid: push the player out.
            let dx = p.pos.x - s.list[i].pos.x;
            let dz = p.pos.z - s.list[i].pos.z;
            let want = RADIUS + player.RADIUS;
            let d2 = dx * dx + dz * dz;
            if d2 < want * want && d2 > 0.0001 && p.pos.y < 1.6 {
                let k = want / sqrt(d2);
                p.pos.x = s.list[i].pos.x + dx * k;
                p.pos.z = s.list[i].pos.z + dz * k;
            }
        }
    }
}

/// Damage shrine `i`. Breaking it adds its spell to the wand's inventory.
pub fn hit(s: &Shrines, b: &Bits, w: &Wand, i: int, dmg: f32) {
    s.list[i].hp -= dmg;
    s.list[i].flash = 0.12;
    if s.list[i].hp > 0 { return; }
    let sh = s.list[i];
    let c = wand.color(w.defs[sh.spell].elem);
    bits.burst(b, sh.pos + Vec3.xyz(0, 2, 0), c, 26, 9, 0.35);
    wand.pickup(w, sh.spell);
    s.found = sh.spell;
    s.foundT = 0;
    s.list[i].alive = false;
}

pub fn prepare(s: &Shrines, a: &Parts, w: &Wand) {
    let stone = Vec3.xyz(0.62, 0.64, 0.72);
    let moss = Vec3.xyz(0.45, 0.55, 0.5);
    for i in 0..MAX {
        let sh = s.list[i];
        if sh.alive {
            let base = Mat4.translate(sh.pos.x, 0, sh.pos.z);
            let c = wand.color(w.defs[sh.spell].elem);
            let glow = Vec3.xyz(0.2, 0.2, 0.22);
            if sh.flash > 0 { glow = Vec3.xyz(0.9, 0.9, 0.9); }
            art.cube(a, base, Vec3.xyz(0, 0.2, 0), Vec3.xyz(2.2, 0.4, 2.2), moss, glow);
            art.cube(a, base, Vec3.xyz(0, 0.85, 0), Vec3.xyz(1.0, 0.9, 1.0), stone, glow);
            art.cube(a, base, Vec3.xyz(0, 1.4, 0), Vec3.xyz(1.3, 0.2, 1.3), stone * 1.1, glow);
            art.cube(a, base, Vec3.xyz(-0.9, 0.55, -0.9), Vec3.xyz(0.35, 0.3, 0.35), stone * 0.9, glow);
            art.cube(a, base, Vec3.xyz(0.9, 0.55, -0.9), Vec3.xyz(0.35, 0.3, 0.35), stone * 0.9, glow);
            art.cube(a, base, Vec3.xyz(-0.9, 0.55, 0.9), Vec3.xyz(0.35, 0.3, 0.35), stone * 0.9, glow);
            art.cube(a, base, Vec3.xyz(0.9, 0.55, 0.9), Vec3.xyz(0.35, 0.3, 0.35), stone * 0.9, glow);
            let spin = Mat4.rotate(Vec3.xyz(0, 1, 0), sh.phase).mul(Mat4.rotate(Vec3.xyz(1, 0, 1), 0.7));
            let crystal = base.mul(Mat4.translate(0, 2.3 + sin(sh.phase) * 0.15, 0)).mul(spin);
            art.cube(a, crystal, Vec3.zero(), Vec3.xyz(0.6, 0.6, 0.6), c, c * (1.1 + glow.x));
        }
    }
}
