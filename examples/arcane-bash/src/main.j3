module arcane_bash;

use j3.app.App;
use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.rand.Rng;
use j3.scene3d;
use j3.scene3d.Scene;
use arcane_bash.art;
use arcane_bash.art.Parts;
use arcane_bash.bits;
use arcane_bash.bits.Bits;
use arcane_bash.enemies;
use arcane_bash.enemies.Enemies;
use arcane_bash.hud;
use arcane_bash.player;
use arcane_bash.player.Player;
use arcane_bash.shrines;
use arcane_bash.shrines.Shrines;
use arcane_bash.spells;
use arcane_bash.spells.Spells;
use arcane_bash.stats;
use arcane_bash.stats.Bonus;
use arcane_bash.wand;
use arcane_bash.wand.Wand;

const FOV: f32 = 70;
const PLAY: int = 0;
const SPELLS: int = 1;
const LEVEL: int = 2;
const DEAD: int = 3;

struct World {
    scene: Scene;
    mem: &Arena;
    parts: Parts;
    player: Player;
    bits: Bits;
    enemies: Enemies;
    shrines: Shrines;
    spells: Spells;
    wand: Wand;
    bonuses: []Bonus;
    rng: Rng;
    state: int;
    /// The three bonus ids on offer at a level-up.
    choices: [3]int;
    font: Font;
    big: Font;
}

fn boot(mem: &Arena): World {
    return World {
        scene: scene3d.load("scenes/main.j3scene", mem), mem: mem, parts: art.create(mem), player: player.create(),
        bits: bits.create(mem), enemies: enemies.create(mem), shrines: shrines.create(mem), spells: spells.create(mem),
        wand: wand.create(mem), bonuses: stats.bonuses(mem), rng: Rng.new(3), state: PLAY, choices: [0, 1, 2],
        font: Font { raw: 0 }, big: Font { raw: 0 },
    };
}

fn startup(w: &World) {
    gfx.init();
    scene3d.upload(&w.scene);
    art.upload(&w.parts, w.mem);
    w.font = game.loadFont("assets/font.ttf", 18);
    w.big = game.loadFont("assets/font.ttf", 44);
    game.captureMouse(true);
}

fn restart(w: &World) {
    w.player = player.create();
    bits.reset(&w.bits);
    enemies.reset(&w.enemies);
    shrines.reset(&w.shrines);
    spells.reset(&w.spells);
    wand.reset(&w.wand);
    w.state = PLAY;
    game.captureMouse(true);
}

/// Three different bonuses to pick from.
fn offer(w: &World) {
    let n = stats.count();
    w.choices[0] = w.rng.intRange(0, n);
    let second = w.rng.intRange(0, n);
    while second == w.choices[0] { second = (second + 1) % n; }
    w.choices[1] = second;
    let third = w.rng.intRange(0, n);
    while third == w.choices[0] || third == w.choices[1] { third = (third + 1) % n; }
    w.choices[2] = third;
}

fn pick(w: &World, i: int) {
    let id = w.choices[i];
    stats.apply(&w.player.stats, id);
    if id == 6 { w.player.hp += 20; }
    w.player.pending -= 1;
    if w.player.pending > 0 {
        offer(w);
    } else {
        w.state = PLAY;
        game.captureMouse(true);
    }
}

fn update(w: &World, dt: f32) {
    if game.keyPressed(Key.Escape) { game.requestQuit(); }
    if w.state == PLAY {
        player.update(&w.player, dt, true);
        if game.mouseDown(Mouse.Left) { spells.cast(&w.spells, &w.wand, &w.player); }
        enemies.update(&w.enemies, &w.bits, &w.player, dt);
        spells.update(&w.spells, &w.wand, &w.player, &w.enemies, &w.shrines, &w.bits, dt);
        shrines.update(&w.shrines, &w.player, dt);
        bits.update(&w.bits, dt);
        if player.dead(&w.player) {
            w.state = DEAD;
            game.captureMouse(false);
        } else if w.player.pending > 0 {
            offer(w);
            w.state = LEVEL;
            game.captureMouse(false);
        } else if game.keyPressed(Key.Tab) {
            w.state = SPELLS;
            game.captureMouse(false);
        }
    } else if w.state == SPELLS {
        if game.keyPressed(Key.Tab) {
            w.state = PLAY;
            game.captureMouse(true);
        }
    } else if w.state == LEVEL {
        if game.keyPressed(Key.Num1) { pick(w, 0); }
        else if game.keyPressed(Key.Num2) { pick(w, 1); }
        else if game.keyPressed(Key.Num3) { pick(w, 2); }
    } else if game.keyPressed(Key.R) {
        restart(w);
    }
}

/// Same order as `scene3d.drawFrame`, with the cube pile drawn in both passes.
fn drawWorld(w: &World) {
    let env = scene3d.environment(&w.scene);
    let look = player.look(&w.player);
    gfx.setFog(env.fogStart, env.fogEnd);
    gfx.setClip(0.1, env.fogEnd + 20);
    art.begin(&w.parts);
    enemies.prepare(&w.enemies, &w.parts, &w.player);
    shrines.prepare(&w.shrines, &w.parts, &w.wand);
    spells.prepare(&w.spells, &w.wand, &w.player, &w.parts);
    bits.prepare(&w.bits, &w.parts);
    let r = env.shadowSize;
    let e = look.eye;
    gfx.shadowPass(env.sunDir, Vec3.xyz(e.x - r, 0 - r, e.z - r), Vec3.xyz(e.x + r, r, e.z + r));
    if env.shadows {
        scene3d.draw(&w.scene);
        art.draw(&w.parts);
    }
    scene3d.lights(&w.scene);
    gfx.cameraPassLookFov(look, env.sunDir, env.sky, env.sunColor, FOV);
    scene3d.drawSky(&w.scene);
    scene3d.draw(&w.scene);
    art.draw(&w.parts);
}

fn draw(w: &World) {
    drawWorld(w);
    if w.state == PLAY {
        hud.play(w.font, w.big, &w.player, &w.wand, &w.shrines);
    } else if w.state == SPELLS {
        hud.play(w.font, w.big, &w.player, &w.wand, &w.shrines);
        hud.inventory(w.font, w.big, &w.wand);
    } else if w.state == LEVEL {
        hud.play(w.font, w.big, &w.player, &w.wand, &w.shrines);
        let picked = hud.levelUp(w.font, w.big, w.bonuses, w.choices[:], w.player.level);
        if picked >= 0 { pick(w, picked); }
    } else {
        hud.dead(w.font, w.big, &w.player);
    }
}

fn main() {
    let app = App<World>.create("Arcane Bash", 960, 540, boot);
    app.useGl();
    app.startup(startup);
    app.always(update);
    app.draw(draw);
    app.run();
}
