// Writes the voxel-style textures in assets/tex/. Run from the project root: j3c run tools/art.j3
module art;

use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Color, Mode };
use j3.memory.Arena;
use j3.rand.Rng;

fn rgb(r: int, g: int, b: int): Color {
    return canvas.rgb(r as u8, g as u8, b as u8);
}

fn box(c: &Canvas, x: int, y: int, w: int, h: int, col: Color) {
    c.fillRect(x as i32, y as i32, w as i32, h as i32, col);
}

// 16x16 flat blocks of 8 px (0.5 m) with slight green variation, no borders.
fn grass(mem: &Arena) {
    let c = Canvas.create(mem, 128 as i32, 128 as i32, Mode.Pixel);
    let rng = Rng.new(7);
    for by in 0..16 {
        for bx in 0..16 {
            let v = (rng.unit() * 4.0) as int;
            box(&c, bx * 8, by * 8, 8, 8, rgb(84 + v * 4, 184 + v * 6, 64 + v * 3));
        }
    }
    c.savePng("assets/tex/grass.png", mem);
}

// Equirect: clear solid zenith (no pinching overhead), stepped bands and blocky clouds low, pale below the horizon (row 128).
fn sky(mem: &Arena) {
    let c = Canvas.create(mem, 512 as i32, 256 as i32, Mode.Pixel);
    box(&c, 0, 0, 512, 64, rgb(60, 140, 235));
    for i in 0..8 {
        let t = i * 255 / 7;
        box(&c, 0, 64 + i * 8, 512, 8, rgb(60 + t * 100 / 255, 140 + t * 80 / 255, 235 + t * 15 / 255));
    }
    box(&c, 0, 128, 512, 128, rgb(205, 235, 255));
    let rng = Rng.new(11);
    for i in 0..14 {
        let x = rng.intRange(0, 440);
        let y = rng.intRange(84, 104);
        let w = rng.intRange(3, 7) * 8;
        box(&c, x, y + 8, w, 8, rgb(255, 255, 255));
        box(&c, x + 8, y, w - 16, 8, rgb(255, 255, 255));
        box(&c, x, y + 16, w, 4, rgb(215, 228, 245));
    }
    c.savePng("assets/tex/sky.png", mem);
}

fn main() {
    let mem = Arena.create(16 * 1024 * 1024);
    grass(&mem);
    sky(&mem);
}
