// Walk the yard in first person. Click leaves, spend them on a faster, wider grab.

module leaves;

use j3.app.App;
use leaves.draw.draw;
use leaves.world.{ World, boot, input, startup };

fn main() {
    let app = App<World>.create("leaves", 1280, 720, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
