fn blankMesh(): Mesh {
    return Mesh { vao: 0, vbo: 0, count: 0 };
}

fn blankTex(): Tex {
    return Tex { id: 0, w: 0, h: 0 };
}

fn dist2(x: f32, z: f32, ox: f32, oz: f32): f32 {
    let dx = x - ox;
    let dz = z - oz;
    return dx * dx + dz * dz;
}

fn inside(x: f32, z: f32, x0: f32, x1: f32, z0: f32, z1: f32): bool {
    return x >= x0 && x <= x1 && z >= z0 && z <= z1;
}

// Grass around the house, out to the fence and the sidewalk. Not the house, porch, steps, or driveway.
fn yardOk(x: f32, z: f32): bool {
    if !inside(x, z, -11.15, 11.15, -12.95, 10.8) {
        return false;
    }
    if inside(x, z, -4.35, 4.35, -3.5, 3.5) {
        return false;
    }
    if inside(x, z, -3, 3, 3.1, 5.6) {
        return false;
    }
    if inside(x, z, -1.8, 1.8, 5.45, 6.7) {
        return false;
    }
    if inside(x, z, -1.55, 1.55, 5.4, 11.2) {
        return false;
    }
    if dist2(x, z, -7.4, 7.4) < 0.45 {
        return false;
    }
    if dist2(x, z, 7.8, 6.6) < 0.45 {
        return false;
    }
    if dist2(x, z, -8.4, -8.8) < 0.45 {
        return false;
    }
    if dist2(x, z, 8.2, -8) < 0.45 {
        return false;
    }
    if dist2(x, z, 2.45, 8.7) < 0.35 {
        return false;
    }
    return true;
}

fn scatter(w: &World) {
    let clear = 0;
    while clear < w.n {
        w.alive[clear] = 0;
        clear = clear + 1;
    }
    let rng = Rng.new(11);
    let i = 0;
    let guard = 0;
    while i < w.n && guard < 40000 {
        guard = guard + 1;
        let x = rng.floatRange(-11.15, 11.15);
        let z = rng.floatRange(-12.95, 10.8);
        if yardOk(x, z) {
            w.lx[i] = x;
            w.lz[i] = z;
            w.lyaw[i] = rng.floatRange(0, 6.2);
            w.lsc[i] = rng.floatRange(0.95, 1.3);
            w.lkind[i] = 0;
            if rng.unit() > 0.5 {
                w.lkind[i] = 1;
            }
            w.alive[i] = 1;
            i = i + 1;
        }
    }
    w.left = i;
    w.batchDirty = true;
    if w.left < 1 {
        panic("no leaves");
    }
}

pub fn restart(w: &World) {
    w.bank = 0;
    w.speed = 0;
    w.reach = 0;
    w.cool = 0;
    w.time = 0;
    w.won = false;
    w.menu = false;
    stand(w);
    let i = 0;
    while i < w.n {
        w.alive[i] = 0;
        i = i + 1;
    }
    scatter(w);
}

pub fn boot(mem: &Arena): World {
    let w = World {
        pos: Vec3.xyz(0, 0, 8.2),
        velX: 0,
        velY: 0,
        velZ: 0,
        yaw: 0,
        pitch: -0.22,
        onGround: true,
        aimOk: false,
        boxes: mem.alloc::<Aabb>(BOXES),
        nbox: 0,
        lx: mem.alloc::<f32>(N),
        lz: mem.alloc::<f32>(N),
        lyaw: mem.alloc::<f32>(N),
        lsc: mem.alloc::<f32>(N),
        lkind: mem.alloc::<u8>(N),
        alive: mem.alloc::<u8>(N),
        n: N,
        left: 0,
        bank: 0,
        speed: 0,
        reach: 0,
        cool: 0,
        time: 0,
        won: false,
        menu: false,
        groundM: blankMesh(),
        streetM: blankMesh(),
        walkM: blankMesh(),
        driveM: blankMesh(),
        stripeM: blankMesh(),
        baseM: blankMesh(),
        wallM: blankMesh(),
        roofM: blankMesh(),
        porchM: blankMesh(),
        stepsM: blankMesh(),
        doorM: blankMesh(),
        glassM: blankMesh(),
        chimneyM: blankMesh(),
        fenceM: blankMesh(),
        trunkM: blankMesh(),
        canopyM: blankMesh(),
        bushM: blankMesh(),
        leafM: blankMesh(),
        leafV: mem.alloc::<f32>(LEAF_V),
        leafN: 0,
        batchA: blankMesh(),
        batchB: blankMesh(),
        nA: 0,
        nB: 0,
        batchDirty: true,
        mark: mem.alloc::<int>(8),
        postM: blankMesh(),
        boxM: blankMesh(),
        grass: blankTex(),
        asphalt: blankTex(),
        concrete: blankTex(),
        siding: blankTex(),
        roof: blankTex(),
        wood: blankTex(),
        door: blankTex(),
        glass: blankTex(),
        brick: blankTex(),
        bark: blankTex(),
        leafA: blankTex(),
        leafB: blankTex(),
        foliage: blankTex(),
        mail: blankTex(),
        font: Font { raw: 0 },
        pickup: Sound { raw: 0 },
        buy: Sound { raw: 0 },
        winSnd: Sound { raw: 0 },
        theme: Music { raw: 0 },
    };
    scatter(&w);
    buildCols(&w);
    return w;
}

fn takeMesh(mem: &Arena, path: string): []f32 {
    let v = mesh.load(path, mem);
    if v.len < 12 {
        panic(path);
    }
    return v;
}

fn takeTex(mem: &Arena, path: string): Tex {
    let img = game.loadRgba(path, mem);
    if img.pixels.len < 4 {
        panic(path);
    }
    return gfx.tex(img.pixels, img.w, img.h);
}

pub fn startup(w: &World) {
    gfx.init();
    gfx.setFog(30, 74);
    gfx.setClip(0.2, 160);
    let mem = Arena.create(8 * 1024 * 1024);
    w.groundM = gfx.uploadUv(takeMesh(&mem, "assets/ground.j3mesh"));
    w.streetM = gfx.uploadUv(takeMesh(&mem, "assets/street.j3mesh"));
    w.walkM = gfx.uploadUv(takeMesh(&mem, "assets/walk.j3mesh"));
    w.driveM = gfx.uploadUv(takeMesh(&mem, "assets/drive.j3mesh"));
    w.stripeM = gfx.uploadUv(takeMesh(&mem, "assets/stripe.j3mesh"));
    w.baseM = gfx.uploadUv(takeMesh(&mem, "assets/base.j3mesh"));
    w.wallM = gfx.uploadUv(takeMesh(&mem, "assets/wall.j3mesh"));
    w.roofM = gfx.uploadUv(takeMesh(&mem, "assets/roof.j3mesh"));
    w.porchM = gfx.uploadUv(takeMesh(&mem, "assets/porch.j3mesh"));
    w.stepsM = gfx.uploadUv(takeMesh(&mem, "assets/steps.j3mesh"));
    w.doorM = gfx.uploadUv(takeMesh(&mem, "assets/door.j3mesh"));
    w.glassM = gfx.uploadUv(takeMesh(&mem, "assets/glass.j3mesh"));
    w.chimneyM = gfx.uploadUv(takeMesh(&mem, "assets/chimney.j3mesh"));
    w.fenceM = gfx.uploadUv(takeMesh(&mem, "assets/fence.j3mesh"));
    w.trunkM = gfx.uploadUv(takeMesh(&mem, "assets/trunk.j3mesh"));
    w.canopyM = gfx.uploadUv(takeMesh(&mem, "assets/canopy.j3mesh"));
    w.bushM = gfx.uploadUv(takeMesh(&mem, "assets/bush.j3mesh"));
    let leafSrc = takeMesh(&mem, "assets/leaf.j3mesh");
    if leafSrc.len != LEAF_V {
        panic("leaf mesh");
    }
    let lv = 0;
    while lv < LEAF_V {
        w.leafV[lv] = leafSrc[lv];
        lv = lv + 1;
    }
    w.leafN = LEAF_V;
    w.leafM = gfx.uploadUv(leafSrc);
    w.postM = gfx.uploadUv(takeMesh(&mem, "assets/post.j3mesh"));
    w.boxM = gfx.uploadUv(takeMesh(&mem, "assets/box.j3mesh"));
    w.grass = takeTex(&mem, "assets/grass.png");
    w.asphalt = takeTex(&mem, "assets/asphalt.png");
    w.concrete = takeTex(&mem, "assets/concrete.png");
    w.siding = takeTex(&mem, "assets/siding.png");
    w.roof = takeTex(&mem, "assets/roof.png");
    w.wood = takeTex(&mem, "assets/wood.png");
    w.door = takeTex(&mem, "assets/door.png");
    w.glass = takeTex(&mem, "assets/glass.png");
    w.brick = takeTex(&mem, "assets/brick.png");
    w.bark = takeTex(&mem, "assets/bark.png");
    w.leafA = takeTex(&mem, "assets/leaf_a.png");
    w.leafB = takeTex(&mem, "assets/leaf_b.png");
    w.foliage = takeTex(&mem, "assets/foliage.png");
    w.mail = takeTex(&mem, "assets/mail.png");
    mem.destroy();
    w.font = game.tryLoadFont("assets/font.ttf", 22);
    w.pickup = game.tryLoadSound("assets/pickup.wav");
    w.buy = game.tryLoadSound("assets/buy.wav");
    w.winSnd = game.tryLoadSound("assets/win.wav");
    w.theme = game.tryLoadMusic("assets/theme.wav");
    game.setVolume(88);
    game.setMusicVolume(36);
    game.playMusic(w.theme);
    game.captureMouse(true);
}

pub fn costSpeed(level: int): int {
    if level <= 0 {
        return 4;
    }
    if level == 1 {
        return 8;
    }
    if level == 2 {
        return 14;
    }
    if level == 3 {
        return 22;
    }
    if level == 4 {
        return 32;
    }
    return 0;
}

pub fn costReach(level: int): int {
    if level <= 0 {
        return 6;
    }
    if level == 1 {
        return 12;
    }
    if level == 2 {
        return 20;
    }
    if level == 3 {
        return 30;
    }
    return 0;
}

pub fn grabCool(level: int): f32 {
    if level <= 0 {
        return 0.7;
    }
    if level == 1 {
        return 0.48;
    }
    if level == 2 {
        return 0.32;
    }
    if level == 3 {
        return 0.2;
    }
    if level == 4 {
        return 0.12;
    }
    return 0.06;
}

pub fn grabCount(level: int): int {
    if level <= 0 {
        return 1;
    }
    if level == 1 {
        return 2;
    }
    if level == 2 {
        return 3;
    }
    if level == 3 {
        return 5;
    }
    return 8;
}

pub fn grabRadius(level: int): f32 {
    if level <= 0 {
        return 0.2;
    }
    if level == 1 {
        return 1.25;
    }
    if level == 2 {
        return 1.9;
    }
    if level == 3 {
        return 2.7;
    }
    return 3.6;
}

pub fn buySpeed(w: &World) {
    if w.won || w.speed >= 5 {
        return;
    }
    let cost = costSpeed(w.speed);
    if w.bank < cost {
        return;
    }
    w.bank = w.bank - cost;
    w.speed = w.speed + 1;
    game.play(w.buy);
}

pub fn buyReach(w: &World) {
    if w.won || w.reach >= 4 {
        return;
    }
    let cost = costReach(w.reach);
    if w.bank < cost {
        return;
    }
    w.bank = w.bank - cost;
    w.reach = w.reach + 1;
    game.play(w.buy);
}

fn takeLeaf(w: &World, i: int) {
    if w.alive[i] == 0 {
        return;
    }
    w.alive[i] = 0;
    w.left = w.left - 1;
    w.bank = w.bank + 1;
    w.batchDirty = true;
}

fn stand(w: &World) {
    w.pos = Vec3.xyz(0, 0, 8.2);
    w.velX = 0;
    w.velY = 0;
    w.velZ = 0;
    w.yaw = 0;
    w.pitch = -0.22;
    w.onGround = true;
}

pub fn eye(w: &World): Look {
    return Look.create(Vec3.xyz(w.pos.x, w.pos.y + EYE, w.pos.z), w.yaw, w.pitch);
}

/// Shallow tilt. The lift tracks scale so the lowest point of the blade rests on the grass.
pub fn leafXform(x: f32, z: f32, yaw: f32, sc: f32): Mat4 {
    let tilt = Mat4.rotate(Vec3.xyz(1, 0, 0), 0.2);
    let spin = Mat4.rotate(Vec3.up(), yaw);
    let size = Mat4.scale(sc, sc, sc);
    let dip: f32 = 0.07;
    return Mat4.translate(x, 0.06 + dip * sc, z).mul(spin).mul(tilt).mul(size);
}

fn pushBox(w: &World, x0: f32, y0: f32, z0: f32, x1: f32, y1: f32, z1: f32) {
    if w.nbox >= w.boxes.len {
        return;
    }
    let loX = x0;
    let hiX = x1;
    let loY = y0;
    let hiY = y1;
    let loZ = z0;
    let hiZ = z1;
    if x1 < x0 {
        loX = x1;
        hiX = x0;
    }
    if y1 < y0 {
        loY = y1;
        hiY = y0;
    }
    if z1 < z0 {
        loZ = z1;
        hiZ = z0;
    }
    w.boxes[w.nbox] = Aabb {
        x0: loX,
        y0: loY,
        z0: loZ,
        x1: hiX,
        y1: hiY,
        z1: hiZ,
    };
    w.nbox = w.nbox + 1;
}

fn pushYaw(
    w: &World,
    ox: f32,
    oz: f32,
    yaw: f32,
    s: f32,
    x0: f32,
    y0: f32,
    z0: f32,
    x1: f32,
    y1: f32,
    z1: f32,
) {
    let q = Quat.fromAxisAngle(Vec3.up(), yaw);
    let minx = f32(1000);
    let maxx = f32(0) - 1000;
    let minz = f32(1000);
    let maxz = f32(0) - 1000;
    let n = 0;
    while n < 4 {
        let x = x0;
        let z = z0;
        if n == 1 || n == 2 {
            x = x1;
        }
        if n == 2 || n == 3 {
            z = z1;
        }
        let p = q.rotate(Vec3.xyz(x * s, 0, z * s));
        if p.x < minx {
            minx = p.x;
        }
        if p.x > maxx {
            maxx = p.x;
        }
        if p.z < minz {
            minz = p.z;
        }
        if p.z > maxz {
            maxz = p.z;
        }
        n = n + 1;
    }
    pushBox(w, ox + minx, y0 * s, oz + minz, ox + maxx, y1 * s, oz + maxz);
}

fn addHouse(w: &World, ox: f32, oz: f32, yaw: f32, s: f32) {
    pushYaw(w, ox, oz, yaw, s, -4.25, 0, -3.45, 4.25, 6.3, 3.45);
    pushYaw(w, ox, oz, yaw, s, -2.9, 0.2, 3.15, 2.9, 0.46, 5.55);
    pushYaw(w, ox, oz, yaw, s, -1.7, 0, 5.5, 1.7, 0.16, 6.55);
    pushYaw(w, ox, oz, yaw, s, -1.55, 0.16, 5.5, 1.55, 0.32, 6.15);
    pushYaw(w, ox, oz, yaw, s, -1.4, 0.32, 5.5, 1.4, 0.46, 5.8);
    pushYaw(w, ox, oz, yaw, s, -2.57, 0.46, 5.25, -2.33, 3.02, 5.49);
    pushYaw(w, ox, oz, yaw, s, 2.33, 0.46, 5.25, 2.57, 3.02, 5.49);
}

fn addTrunk(w: &World, x: f32, z: f32, s: f32) {
    let r = 0.26 * s;
    pushBox(w, x - r, 0, z - r, x + r, 2.6 * s, z + r);
}

fn buildCols(w: &World) {
    w.nbox = 0;
    pushBox(w, -40, -2, -40, 40, 0, 40);
    addHouse(w, 0, 0, 0, 1);
    addHouse(w, -20, -0.4, 0.08, 1);
    addHouse(w, 20.5, 0.6, -0.1, 0.94);
    addHouse(w, 1.5, -19, 3.1, 0.82);
    pushBox(w, -11.55, 0, -13.4, 11.55, 1.25, -13.02);
    pushBox(w, -11.58, 0, -13.4, -11.22, 1.25, -3.4);
    pushBox(w, 11.22, 0, -13.4, 11.58, 1.25, -3.4);
    pushBox(w, -28, 0, 12.45, 28, 0.12, 12.75);
    pushBox(w, -28.2, 0, -22.2, -27.4, 2.4, 22.2);
    pushBox(w, 27.4, 0, -22.2, 28.2, 2.4, 22.2);
    pushBox(w, -28.2, 0, -22.2, 28.2, 2.4, -21.4);
    pushBox(w, -28.2, 0, 21.4, 28.2, 2.4, 22.2);
    addTrunk(w, -7.4, 7.4, 1.05);
    addTrunk(w, 7.8, 6.6, 0.92);
    addTrunk(w, -8.4, -8.8, 1.1);
    addTrunk(w, 8.2, -8, 0.96);
    addTrunk(w, -16, 4, 0.8);
    addTrunk(w, 16.5, -2, 0.75);
    addTrunk(w, -6, -17, 0.7);
    pushBox(w, 2.15, 0, 8.35, 2.85, 1.15, 9.05);
    pushBox(w, -11.7, 0, 7.7, -10.8, 0.8, 8.7);
    pushBox(w, 10.6, 0, 6.9, 11.6, 0.75, 7.9);
    pushBox(w, -12.1, 0, -6.7, -11.1, 0.8, -5.7);
    pushBox(w, 11, 0, -7.6, 12, 0.85, -6.6);
}

fn blocked(w: &World, origin: Vec3, dir: Vec3): f32 {
    let best = REACH;
    let i = 0;
    while i < w.nbox {
        if w.boxes[i].y1 > 0.02 {
            let hit = gfx.rayAabb(
                origin,
                dir,
                Vec3.xyz(w.boxes[i].x0, w.boxes[i].y0, w.boxes[i].z0),
                Vec3.xyz(w.boxes[i].x1, w.boxes[i].y1, w.boxes[i].z1),
                REACH,
            );
            if hit.ok && hit.t < best {
                best = hit.t;
            }
        }
        i = i + 1;
    }
    return best;
}

fn writeLeaf(w: &World, model: Mat4, dst: []f32, at: int): int {
    let v = 0;
    let cursor = at;
    while v < w.leafN {
        let px = w.leafV[v];
        let py = w.leafV[v + 1];
        let pz = w.leafV[v + 2];
        let p = model.transformPoint(Vec3.xyz(px, py, pz));
        let nx = w.leafV[v + 3];
        let ny = w.leafV[v + 4];
        let nz = w.leafV[v + 5];
        let tip = model.transformPoint(Vec3.xyz(px + nx, py + ny, pz + nz));
        let raw = Vec3.xyz(tip.x - p.x, tip.y - p.y, tip.z - p.z);
        let nrm = raw.normalize();
        dst[cursor] = p.x;
        dst[cursor + 1] = p.y;
        dst[cursor + 2] = p.z;
        dst[cursor + 3] = nrm.x;
        dst[cursor + 4] = nrm.y;
        dst[cursor + 5] = nrm.z;
        dst[cursor + 6] = w.leafV[v + 6];
        dst[cursor + 7] = w.leafV[v + 7];
        dst[cursor + 8] = w.leafV[v + 8];
        dst[cursor + 9] = w.leafV[v + 9];
        dst[cursor + 10] = w.leafV[v + 10];
        dst[cursor + 11] = w.leafV[v + 11];
        cursor = cursor + 12;
        v = v + 12;
    }
    return cursor;
}

fn kindMatch(kind: int, v: u8): bool {
    if kind == 0 {
        return v == 0;
    }
    return v != 0;
}

fn bakeKind(w: &World, kind: int, dst: []f32): int {
    let at = 0;
    let i = 0;
    while i < w.n {
        if w.alive[i] != 0 && kindMatch(kind, w.lkind[i]) {
            let model = leafXform(w.lx[i], w.lz[i], w.lyaw[i], w.lsc[i]);
            at = writeLeaf(w, model, dst, at);
        }
        i = i + 1;
    }
    return at;
}

fn storeKind(w: &World, kind: int, buf: []f32, mesh: &Mesh): int {
    let n = bakeKind(w, kind, buf);
    if n < 12 {
        return 0;
    }
    let verts = buf[0..n];
    if mesh.vbo == 0 {
        let uploaded = gfx.uploadUv(verts);
        mesh.vao = uploaded.vao;
        mesh.vbo = uploaded.vbo;
        mesh.count = uploaded.count;
    } else {
        gfx.updateUv(mesh, verts);
    }
    return mesh.count;
}

/// Pack living leaves into two meshes, one per texture. Runs after a grab, not every frame.
pub fn rebuildLeaves(w: &World) {
    if !w.batchDirty || w.leafN < 12 {
        return;
    }
    let mem = Arena.create(2 * 1024 * 1024);
    let saved = mem.checkpoint();
    let buf = mem.alloc::<f32>(w.n * w.leafN);
    w.nA = storeKind(w, 0, buf, &w.batchA);
    mem.rewind(saved);
    let again = mem.alloc::<f32>(w.n * w.leafN);
    w.nB = storeKind(w, 1, again, &w.batchB);
    mem.destroy();
    w.batchDirty = false;
}

fn chosen(w: &World, n: int, leaf: int): bool {
    let k = 0;
    while k < n {
        if w.mark[k] == leaf {
            return true;
        }
        k = k + 1;
    }
    return false;
}

/// Two-sided triangle hit. Writes barycentric `bu`/`bv` for vertices b and c. Returns distance, or -1.
fn rayTri(o: Vec3, d: Vec3, a: Vec3, b: Vec3, c: Vec3, reach: f32, bu: &f32, bv: &f32): f32 {
    let miss = f32(0) - 1;
    let e1 = b - a;
    let e2 = c - a;
    let pvec = d.cross(e2);
    let det = e1.dot(pvec);
    let ad = det;
    if ad < 0 {
        ad = f32(0) - ad;
    }
    if ad < 0.00001 {
        return miss;
    }
    let inv = f32(1) / det;
    let tvec = o - a;
    let u = tvec.dot(pvec) * inv;
    if u < -0.001 || u > 1.001 {
        return miss;
    }
    let qvec = tvec.cross(e1);
    let v = d.dot(qvec) * inv;
    if v < -0.001 || u + v > 1.001 {
        return miss;
    }
    let dist = e2.dot(qvec) * inv;
    if dist < 0 || dist > reach {
        return miss;
    }
    *bu = u;
    *bv = v;
    return dist;
}

/// True when texture coordinates land on the opaque leaf, not the empty corners of the card.
fn onLeaf(tu: f32, tv: f32): bool {
    let us = (tu - 0.5) / 0.36;
    let vs = (tv - 0.02) * 1.7917;
    if us < 0 {
        us = f32(0) - us;
    }
    if vs < 0.12 && us < 0.1 {
        return true;
    }
    if vs < 0 || vs > 1.72 {
        return false;
    }
    let t = vs / 1.7;
    if t > 1 {
        t = 1;
    }
    let half = sin(t * 3.1415927) * 0.62;
    return us <= half;
}

/// Distance to the visible blade, or -1. The card's transparent corners do not count.
fn leafT(w: &World, i: int, origin: Vec3, dir: Vec3, reach: f32): f32 {
    let model = leafXform(w.lx[i], w.lz[i], w.lyaw[i], w.lsc[i]);
    let stem = model.transformPoint(Vec3.xyz(0, 0, -0.04));
    let left = model.transformPoint(Vec3.xyz(-0.28, 0.04, 0.22));
    let tip = model.transformPoint(Vec3.xyz(0, 0.09, 0.78));
    let right = model.transformPoint(Vec3.xyz(0.28, 0.04, 0.22));
    let miss = f32(0) - 1;
    let bu: f32 = 0;
    let bv: f32 = 0;
    let best = miss;
    let tr = rayTri(origin, dir, stem, right, tip, reach, &bu, &bv);
    if tr >= 0 {
        let w0 = 1 - bu - bv;
        let tu = 0.5 * w0 + 0.88 * bu + 0.5 * bv;
        let tv = 0.02 * w0 + 0.38 * bu + 0.98 * bv;
        if onLeaf(tu, tv) {
            best = tr;
        }
    }
    let bl = rayTri(origin, dir, stem, left, tip, reach, &bu, &bv);
    if bl >= 0 && (best < 0 || bl < best) {
        let w1 = 1 - bu - bv;
        let lu = 0.5 * w1 + 0.12 * bu + 0.5 * bv;
        let lv = 0.02 * w1 + 0.38 * bu + 0.98 * bv;
        if onLeaf(lu, lv) {
            best = bl;
        }
    }
    return best;
}

/// The leaf under the crosshair, then the closest others inside the grab radius.
/// Empty when a click would not pick anything up.
pub fn aimLeaves(w: &World): int {
    if w.won || w.menu || w.cool > 0 || !game.mouseCaptured() {
        return 0;
    }
    let cam = eye(w);
    let origin = cam.eye;
    let dir = cam.forward();
    let wall = blocked(w, origin, dir);
    let best = -1;
    let bestT = REACH;
    let i = 0;
    while i < w.n {
        if w.alive[i] != 0 {
            let hit = leafT(w, i, origin, dir, bestT);
            if hit >= 0 && hit < wall {
                best = i;
                bestT = hit;
            }
        }
        i = i + 1;
    }
    if best < 0 {
        return 0;
    }
    w.mark[0] = best;
    let got = 1;
    let need = grabCount(w.reach);
    if need > w.mark.len {
        need = w.mark.len;
    }
    let lim = grabRadius(w.reach) * grabRadius(w.reach);
    let cx = w.lx[best];
    let cz = w.lz[best];
    while got < need {
        let pick = -1;
        let pickD = lim;
        i = 0;
        while i < w.n {
            if w.alive[i] != 0 && !chosen(w, got, i) {
                let dx = w.lx[i] - cx;
                let dz = w.lz[i] - cz;
                let d = dx * dx + dz * dz;
                if d <= pickD {
                    pick = i;
                    pickD = d;
                }
            }
            i = i + 1;
        }
        if pick < 0 {
            break;
        }
        w.mark[got] = pick;
        got = got + 1;
    }
    return got;
}

fn grab(w: &World) {
    let n = aimLeaves(w);
    if n < 1 {
        return;
    }
    let k = 0;
    while k < n {
        takeLeaf(w, w.mark[k]);
        k = k + 1;
    }
    w.cool = grabCool(w.speed);
    if w.left <= 0 {
        w.won = true;
        w.menu = false;
        game.captureMouse(false);
        game.play(w.winSnd);
        return;
    }
    game.play(w.pickup);
}

fn hits(w: &World, x: f32, y: f32, z: f32): bool {
    let x0 = x - RADIUS;
    let x1 = x + RADIUS;
    let y0 = y;
    let y1 = y + BODY;
    let z0 = z - RADIUS;
    let z1 = z + RADIUS;
    let i = 0;
    while i < w.nbox {
        let sep = x1 <= w.boxes[i].x0 || x0 >= w.boxes[i].x1;
        if !sep && (y1 <= w.boxes[i].y0 || y0 >= w.boxes[i].y1) {
            sep = true;
        }
        if !sep && (z1 <= w.boxes[i].z0 || z0 >= w.boxes[i].z1) {
            sep = true;
        }
        if !sep {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn tryMove(w: &World, dx: f32, dy: f32, dz: f32): bool {
    if hits(w, w.pos.x + dx, w.pos.y + dy, w.pos.z + dz) {
        return false;
    }
    w.pos.x = w.pos.x + dx;
    w.pos.y = w.pos.y + dy;
    w.pos.z = w.pos.z + dz;
    return true;
}

fn climb(w: &World, dx: f32, dz: f32): bool {
    let h: f32 = 0.05;
    while h <= STEP {
        if !tryMove(w, 0, h, 0) {
            return false;
        }
        if tryMove(w, dx, 0, dz) {
            let back = h;
            while back > 0.001 {
                let drop: f32 = 0.04;
                if back < drop {
                    drop = back;
                }
                if !tryMove(w, 0, f32(0) - drop, 0) {
                    w.onGround = true;
                    return true;
                }
                back = back - drop;
            }
            w.onGround = true;
            return true;
        }
        tryMove(w, 0, f32(0) - h, 0);
        h = h + 0.05;
    }
    return false;
}

fn moveAxis(w: &World, dx: f32, dz: f32) {
    if dx == 0 && dz == 0 {
        return;
    }
    if tryMove(w, dx, 0, dz) {
        return;
    }
    if w.onGround && climb(w, dx, dz) {
        return;
    }
    if dx != 0 && !tryMove(w, dx, 0, 0) && w.onGround {
        climb(w, dx, 0);
    }
    if dz != 0 && !tryMove(w, 0, 0, dz) && w.onGround {
        climb(w, 0, dz);
    }
}

fn wish(w: &World): Vec3 {
    let cam = eye(w);
    let fwd = cam.forward();
    fwd.y = 0;
    let fl = fwd.length();
    if fl > 0.001 {
        fwd = fwd * (f32(1) / fl);
    }
    let side = cam.right();
    let x: f32 = 0;
    let z: f32 = 0;
    if game.keyDown(game.Key.W) {
        x = x + fwd.x;
        z = z + fwd.z;
    }
    if game.keyDown(game.Key.S) {
        x = x - fwd.x;
        z = z - fwd.z;
    }
    if game.keyDown(game.Key.D) {
        x = x + side.x;
        z = z + side.z;
    }
    if game.keyDown(game.Key.A) {
        x = x - side.x;
        z = z - side.z;
    }
    let len = Vec3.xyz(x, 0, z).length();
    if len > 1 {
        x = x / len;
        z = z / len;
    }
    return Vec3.xyz(x * WALK, 0, z * WALK);
}

fn fall(w: &World, dy: f32) {
    if dy > 0 {
        if !tryMove(w, 0, dy, 0) {
            w.velY = 0;
        }
        return;
    }
    if dy == 0 {
        return;
    }
    let left = f32(0) - dy;
    while left > 0 {
        let s: f32 = 0.04;
        if left < s {
            s = left;
        }
        if !tryMove(w, 0, f32(0) - s, 0) {
            w.onGround = true;
            w.velY = 0;
            return;
        }
        left = left - s;
        w.onGround = false;
    }
}

fn stepBody(w: &World, dt: f32) {
    if w.onGround && !hits(w, w.pos.x, w.pos.y - 0.05, w.pos.z) {
        w.onGround = false;
    }
    if w.onGround && game.keyDown(game.Key.Space) {
        w.velY = JUMP;
        w.onGround = false;
    }
    let move = wish(w);
    let gain: f32 = 8;
    if !w.onGround {
        gain = 5;
    }
    if move.x == 0 && move.z == 0 {
        gain = 6;
    }
    let blend = gain * dt;
    if blend > 1 {
        blend = 1;
    }
    w.velX = w.velX + (move.x - w.velX) * blend;
    w.velZ = w.velZ + (move.z - w.velZ) * blend;
    moveAxis(w, w.velX * dt, 0);
    moveAxis(w, 0, w.velZ * dt);
    if !w.onGround {
        w.velY = w.velY - GRAV * dt;
        if w.velY < -14 {
            w.velY = -14;
        }
    } else if w.velY < 0 {
        w.velY = 0;
    }
    fall(w, w.velY * dt);
}

fn simulate(w: &World, dt: f32) {
    if w.menu || w.won || !game.mouseCaptured() {
        return;
    }
    let left = dt;
    while left > 0 {
        let s: f32 = 0.016666668;
        if left < s {
            s = left;
        }
        stepBody(w, s);
        left = left - s;
    }
}

fn setShop(w: &World, open: bool) {
    w.menu = open;
    if open {
        game.captureMouse(false);
    } else {
        game.captureMouse(true);
    }
}

pub fn input(w: &World, dt: f32) {
    if w.cool > 0 {
        w.cool = w.cool - dt;
        if w.cool < 0 {
            w.cool = 0;
        }
    }
    if !w.menu && !w.won {
        w.time = w.time + dt;
    }
    if game.keyPressed(game.Key.Q) {
        game.requestQuit();
    }
    if game.keyPressed(game.Key.Escape) {
        if w.menu {
            setShop(w, false);
        } else if game.mouseCaptured() {
            game.captureMouse(false);
        } else {
            game.requestQuit();
        }
    }
    if game.keyPressed(game.Key.R) {
        restart(w);
        game.captureMouse(true);
    }
    if w.won && game.keyPressed(game.Key.Enter) {
        restart(w);
        game.captureMouse(true);
    }
    if !w.won && game.keyPressed(game.Key.E) {
        setShop(w, !w.menu);
    }
    if game.mouseCaptured() && !w.menu && !w.won {
        let d = game.mouseDelta();
        if w.aimOk {
            if d.x < 140 && d.x > -140 {
                w.yaw = w.yaw + d.x * 0.0022;
            }
            if d.y < 140 && d.y > -140 {
                w.pitch = clamp(w.pitch - d.y * 0.0022, -1.2, 1.15);
            }
        }
        w.aimOk = true;
    } else {
        w.aimOk = false;
    }
    if !w.menu && !w.won && game.mouseDown(game.Mouse.Left) {
        if !game.mouseCaptured() {
            if game.mousePressed(game.Mouse.Left) {
                game.captureMouse(true);
            }
        } else {
            grab(w);
        }
    }
    simulate(w, dt);
}
