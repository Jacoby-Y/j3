// Yard state, leaf scatter, grabbing, and the two upgrades.

module leaves.world;

use j3.game;
use j3.game.{ Font, Music, Sound };
use j3.gfx;
use j3.gfx.{ Look, Mesh, Tex };
use j3.math.{ Mat4, Quat, Vec3, clamp, sin };
use j3.memory.Arena;
use j3.gfx.mesh;
use j3.rand.Rng;
use j3.sys.panic;

const N: int = 1920;
const LEAF_V: int = 144;
const BOXES: int = 64;
const BODY: f32 = 1.72;
const RADIUS: f32 = 0.32;
const EYE: f32 = 1.58;
const WALK: f32 = 4.3;
const GRAV: f32 = 20;
const JUMP: f32 = 5.1;
const STEP: f32 = 0.28;
const REACH: f32 = 3.1;

pub struct Aabb {
    x0: f32;
    y0: f32;
    z0: f32;
    x1: f32;
    y1: f32;
    z1: f32;
}

pub struct World {
    pos: Vec3;
    velX: f32;
    velY: f32;
    velZ: f32;
    yaw: f32;
    pitch: f32;
    onGround: bool;
    aimOk: bool;
    boxes: []Aabb;
    nbox: int;
    lx: []f32;
    lz: []f32;
    lyaw: []f32;
    lsc: []f32;
    lkind: []u8;
    alive: []u8;
    n: int;
    left: int;
    bank: int;
    speed: int;
    reach: int;
    cool: f32;
    time: f32;
    won: bool;
    menu: bool;
    groundM: Mesh;
    streetM: Mesh;
    walkM: Mesh;
    driveM: Mesh;
    stripeM: Mesh;
    baseM: Mesh;
    wallM: Mesh;
    roofM: Mesh;
    porchM: Mesh;
    stepsM: Mesh;
    doorM: Mesh;
    glassM: Mesh;
    chimneyM: Mesh;
    fenceM: Mesh;
    trunkM: Mesh;
    canopyM: Mesh;
    bushM: Mesh;
    leafM: Mesh;
    leafV: []f32;
    leafN: int;
    batchA: Mesh;
    batchB: Mesh;
    nA: int;
    nB: int;
    batchDirty: bool;
    mark: []int;
    postM: Mesh;
    boxM: Mesh;
    grass: Tex;
    asphalt: Tex;
    concrete: Tex;
    siding: Tex;
    roof: Tex;
    wood: Tex;
    door: Tex;
    glass: Tex;
    brick: Tex;
    bark: Tex;
    leafA: Tex;
    leafB: Tex;
    foliage: Tex;
    mail: Tex;
    font: Font;
    pickup: Sound;
    buy: Sound;
    winSnd: Sound;
    theme: Music;
