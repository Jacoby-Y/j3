// House, neighborhood, leaves, and the shop HUD.

module leaves.draw;

use j3.game;
use j3.gfx;
use j3.gfx.{ Mesh, Tex };
use j3.math.{ Mat4, Vec2, Vec3 };
use j3.ui.{ Theme, Ui };
use leaves.world.{
    World, aimLeaves, buyReach, buySpeed, costReach, costSpeed, eye, grabCool, leafXform,
    rebuildLeaves,
};

fn paint(image: Tex, mesh: Mesh, model: Mat4) {
    gfx.albedo(image);
    gfx.draw(mesh, model);
}

fn paintCut(image: Tex, mesh: Mesh, model: Mat4) {
    gfx.albedo(image);
    gfx.drawCutout(mesh, model);
}

fn place(x: f32, y: f32, z: f32, yaw: f32, s: f32): Mat4 {
    let spin = Mat4.rotate(Vec3.up(), yaw);
    let size = Mat4.scale(s, s, s);
    return Mat4.translate(x, y, z).mul(spin).mul(size);
}

fn drawHouse(w: &World, model: Mat4) {
    paint(w.concrete, w.baseM, model);
    paint(w.siding, w.wallM, model);
    paint(w.roof, w.roofM, model);
    paint(w.wood, w.porchM, model);
    paint(w.concrete, w.stepsM, model);
    paint(w.door, w.doorM, model);
    paint(w.glass, w.glassM, model);
    paint(w.brick, w.chimneyM, model);
}

fn drawTree(w: &World, x: f32, z: f32, s: f32) {
    let model = place(x, 0, z, 0, s);
    paint(w.bark, w.trunkM, model);
    paintCut(w.foliage, w.canopyM, model);
}

fn drawBush(w: &World, x: f32, z: f32, yaw: f32, s: f32) {
    paintCut(w.foliage, w.bushM, place(x, 0, z, yaw, s));
}

fn drawLeaves(w: &World) {
    rebuildLeaves(w);
    let here = Mat4.identity();
    if w.nA > 0 {
        paintCut(w.leafA, w.batchA, here);
    }
    if w.nB > 0 {
        paintCut(w.leafB, w.batchB, here);
    }
}

fn drawMarks(w: &World) {
    let n = aimLeaves(w);
    let glow = Vec3.xyz(0.95, 0.98, 1);
    let k = 0;
    while k < n {
        let i = w.mark[k];
        let model = leafXform(w.lx[i], w.lz[i], w.lyaw[i], w.lsc[i]);
        if w.lkind[i] == 0 {
            gfx.albedo(w.leafA);
        } else {
            gfx.albedo(w.leafB);
        }
        gfx.drawMark(w.leafM, model, glow);
        k = k + 1;
    }
}

fn scene(w: &World) {
    let here = Mat4.identity();
    paint(w.grass, w.groundM, here);
    paint(w.asphalt, w.streetM, here);
    paint(w.concrete, w.walkM, here);
    paint(w.concrete, w.driveM, here);
    paint(Tex { id: 0, w: 0, h: 0 }, w.stripeM, here);
    drawHouse(w, here);
    paint(w.wood, w.fenceM, here);
    let mail = place(2.45, 0, 8.7, 0.4, 1);
    paint(w.wood, w.postM, mail);
    paint(w.mail, w.boxM, mail);
    drawTree(w, -7.4, 7.4, 1.05);
    drawTree(w, 7.8, 6.6, 0.92);
    drawTree(w, -8.4, -8.8, 1.1);
    drawTree(w, 8.2, -8, 0.96);
    drawBush(w, -11.3, 8.2, 0.2, 1.1);
    drawBush(w, 11.1, 7.4, 0.8, 0.9);
    drawBush(w, -11.6, -6.2, 0.4, 1);
    drawBush(w, 11.5, -7.1, 1.1, 1.05);
    drawBush(w, -4.2, -13.4, 0.3, 0.85);
    drawBush(w, 5.6, -13.5, 1.4, 0.95);
    drawHouse(w, place(-20, 0, -0.4, 0.08, 1));
    drawHouse(w, place(20.5, 0, 0.6, -0.1, 0.94));
    drawHouse(w, place(1.5, 0, -19, 3.1, 0.82));
    drawTree(w, -16, 4, 0.8);
    drawTree(w, 16.5, -2, 0.75);
    drawTree(w, -6, -17, 0.7);
}

fn clockLine(ui: &Ui, w: &World) {
    let total = w.time as int;
    if total < 0 {
        total = 0;
    }
    let mins = total / 60;
    let secs = total - mins * 60;
    if secs < 10 {
        ui.label(`time  {mins}:0{secs}`);
    } else {
        ui.label(`time  {mins}:{secs}`);
    }
}

fn hud(w: &World) {
    let ui = Ui.begin(w.font, 16, 16);
    ui.theme = Theme.yard();
    ui.panel(280, 156);
    ui.label(`leaves    {w.left}`);
    ui.label(`pocket    {w.bank}`);
    if w.menu {
        ui.label("E    close shop");
    } else {
        ui.label("hold to grab     E shop");
    }
    clockLine(&ui, w);
    let full = grabCool(w.speed);
    let ready = f32(1);
    if full > 0 {
        ready = f32(1) - w.cool / full;
    }
    ui.bar(ready);
    ui.end();
    if w.menu {
        shop(&ui, w);
    }
    if w.won {
        winBanner(&ui, w);
    } else if !w.menu && game.mouseCaptured() {
        crosshair();
    }
}

fn crosshair() {
    let sz = game.windowSize();
    let x = sz.x * 0.5;
    let y = sz.y * 0.5;
    game.setColor(game.rgb(20, 16, 12));
    game.drawRect(Vec2 { x: x - 9, y: y - 2 }, Vec2 { x: 6, y: 4 });
    game.drawRect(Vec2 { x: x + 3, y: y - 2 }, Vec2 { x: 6, y: 4 });
    game.drawRect(Vec2 { x: x - 2, y: y - 9 }, Vec2 { x: 4, y: 6 });
    game.drawRect(Vec2 { x: x - 2, y: y + 3 }, Vec2 { x: 4, y: 6 });
    game.setColor(game.rgb(255, 246, 224));
    game.drawRect(Vec2 { x: x - 8, y: y - 1 }, Vec2 { x: 5, y: 2 });
    game.drawRect(Vec2 { x: x + 3, y: y - 1 }, Vec2 { x: 5, y: 2 });
    game.drawRect(Vec2 { x: x - 1, y: y - 8 }, Vec2 { x: 2, y: 5 });
    game.drawRect(Vec2 { x: x - 1, y: y + 3 }, Vec2 { x: 2, y: 5 });
}

fn shop(ui: &Ui, w: &World) {
    ui.x = 16;
    ui.y = 188;
    ui.panel(280, 248);
    let speedCost = costSpeed(w.speed);
    let reachCost = costReach(w.reach);
    ui.label("shop");
    if w.speed >= 5 {
        ui.label("grab speed is maxed");
    } else {
        ui.label(`faster grab   {speedCost} leaves`);
        if ui.button("buy speed") {
            buySpeed(w);
        }
    }
    ui.gap(6);
    if w.reach >= 4 {
        ui.label("grab size is maxed");
    } else {
        ui.label(`wider grab   {reachCost} leaves`);
        if ui.button("buy reach") {
            buyReach(w);
        }
    }
    ui.gap(8);
    ui.label(`speed {w.speed}    reach {w.reach}`);
    ui.end();
}

fn winBanner(ui: &Ui, w: &World) {
    let sz = game.windowSize();
    ui.x = sz.x * 0.5 - 190;
    ui.y = sz.y * 0.5 - 78;
    ui.panel(380, 156);
    ui.label("yard clear");
    clockLine(ui, w);
    ui.label("enter  to rake it again");
    ui.end();
}

pub fn draw(w: &World) {
    let sun = Vec3.xyz(-0.38, 0.84, 0.36).normalize();
    let sky = Vec3.xyz(0.62, 0.74, 0.88);
    let warm = Vec3.xyz(1, 0.94, 0.82);
    gfx.setFog(30, 74);
    gfx.setClip(0.2, 160);
    gfx.shadowPass(sun, Vec3.xyz(-24, -1, -22), Vec3.xyz(24, 12, 22));
    scene(w);
    drawLeaves(w);
    gfx.cameraPassLook(eye(w), sun, sky, warm);
    scene(w);
    drawLeaves(w);
    drawMarks(w);
    hud(w);
}
