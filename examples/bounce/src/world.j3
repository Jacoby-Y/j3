// Paddle + ball. Left/Right move; ball bounces; miss resets.

module bounce.world;

use j3.data.assets.Assets;
use j3.data.debug;
use j3.data.debug.Stats;
use j3.game.fx.{ Particles, Rig, Timer };
use j3.game.{ Camera, Font, Key, Mouse, Pad, clear, drawRect, frameAlpha, keyDown, keyPressed, mouseDown, mousePos, requestQuit, rgb, setColor };
use j3.game.input.Actions;
use j3.math.{ Vec2, clamp };
use j3.memory.Arena;
use j3.game.physics.{ Body, Sim };
use j3.data.res.Slot;
use j3.data.save;
use j3.ui.Ui;

const WIDTH: int = 640;
const HEIGHT: int = 360;
const PADDLE_Y: int = 330;
const PADDLE_W: int = 80;
const PADDLE_H: int = 12;
const BALL: int = 12;

pub struct World {
    paddle_x: f32;
    ball: Vec2;
    ball_prev: Vec2;
    vel: Vec2;
    score: int;
    best: Slot<int>;
    bag: Assets;
    fx: Particles;
    hit: Timer;
    stats: Stats;
    font: Font;
    sim: Sim;
    acts: Actions;
    rig: Rig;
}

pub fn boot(mem: &Arena): World {
    let sim = Sim.new(mem, 4, 64);
    sim.add(Body.make(Vec2 { x: 320, y: 80 }, Vec2 { x: 180, y: 160 }, Vec2 { x: f32(BALL), y: f32(BALL) }, 0));
    sim.add(Body.fixedAt(Vec2 { x: 280, y: f32(PADDLE_Y) }, Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) }));
    return World {
        paddle_x: 280,
        ball: Vec2 { x: 320, y: 80 },
        ball_prev: Vec2 { x: 320, y: 80 },
        vel: Vec2 { x: 180, y: 160 },
        score: 0,
        best: Slot<int>.none(0),
        bag: Assets.new(mem),
        fx: Particles.new(mem, 48),
        hit: Timer.of(0),
        stats: Stats.fresh(),
        font: Font { raw: 0 },
        sim: sim,
        acts: Actions.new(mem, 8),
        rig: Rig.create(1),
    };
}

pub fn load(w: &World) {
    w.bag.addRoot("assets/");
    w.bag.addRoot("examples/dungeon/assets/");
    w.bag.addRoot("../dungeon/assets/");
    w.bag.addRoot("../examples/dungeon/assets/");
    w.font = w.bag.font("font.ttf", 16);
    let s = save.load("bounce.save", w.bag.arena);
    w.best.put(save.getInt(&s, "best", 0));
    w.acts.bind(0, Key.Left, Pad.Left, 0);
    w.acts.bind(1, Key.Right, Pad.Right, 0);
    w.acts.bind(2, Key.A, Pad.Left, 0);
    w.acts.bind(3, Key.D, Pad.Right, 0);
}

pub fn input(w: &World, _dt: f32) {
    if keyDown(Key.Escape) {
        requestQuit();
    }
    if keyPressed(Key.F3) {
        w.stats.shown = !w.stats.shown;
    }
}

pub fn begin(w: &World, _dt: f32) {
    w.stats.sample(2);
}

pub fn after(w: &World, dt: f32) {
    w.fx.tick(dt);
    w.hit.tick(dt);
    w.rig.tick(dt);
}

fn persist(w: &World) {
    if w.score > w.best.get() {
        w.best.put(w.score);
        let s = save.empty(w.bag.arena);
        save.putInt(&s, "best", w.best.get());
        save.store(&s, "bounce.save");
    }
}

pub fn step(w: &World, dt: f32) {
    if w.acts.down(0) || w.acts.down(2) {
        w.paddle_x = w.paddle_x - f32(320) * dt;
    }
    if w.acts.down(1) || w.acts.down(3) {
        w.paddle_x = w.paddle_x + f32(320) * dt;
    }
    if mouseDown(Mouse.Left) {
        let mp = mousePos();
        w.paddle_x = mp.x - 40;
    }
    let max_x = f32(WIDTH - PADDLE_W);
    w.paddle_x = clamp(w.paddle_x, 0, max_x);

    let pad = w.sim.get(1);
    pad.pos = Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) };
    let ball = w.sim.get(0);
    w.ball_prev = ball.pos;
    let before = ball.vel.y;
    w.sim.step(dt);

    if ball.pos.x < 0 {
        ball.pos.x = 0;
        ball.vel.x = f32(0) - ball.vel.x;
    }
    let right = f32(WIDTH - BALL);
    if ball.pos.x > right {
        ball.pos.x = right;
        ball.vel.x = f32(0) - ball.vel.x;
    }
    if ball.pos.y < 0 {
        ball.pos.y = 0;
        ball.vel.y = f32(0) - ball.vel.y;
    }

    if before > 0 && ball.vel.y < 0 {
        w.score = w.score + 1;
        persist(w);
        w.fx.burst(ball.pos, 10, 120);
        w.hit.reset(0.12);
        w.rig.shake(8);
    }

    if ball.pos.y > f32(HEIGHT) {
        persist(w);
        w.score = 0;
        ball.pos = Vec2 { x: 320, y: 80 };
        ball.vel = Vec2 { x: 180, y: 160 };
        w.ball_prev = ball.pos;
    }
    w.ball = ball.pos;
    w.vel = ball.vel;
}

pub fn draw(w: &World) {
    clear();
    if !w.hit.done() {
        setColor(rgb(255, 255, 255));
    } else {
        setColor(rgb(220, 220, 220));
    }
    drawRect(Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) }, Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) });
    setColor(rgb(80, 220, 120));
    debug.drawRect(Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) }, Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) });
    let cam = Camera.create(1);
    debug.drawAabb(cam, Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) }, Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) });
    setColor(rgb(240, 200, 80));
    let a = frameAlpha();
    let shake = w.rig.offset();
    let shown = Vec2 {
        x: w.ball_prev.x + (w.ball.x - w.ball_prev.x) * a + shake.x,
        y: w.ball_prev.y + (w.ball.y - w.ball_prev.y) * a + shake.y,
    };
    drawRect(shown, Vec2 { x: f32(BALL), y: f32(BALL) });
    w.fx.draw();
    if w.font.raw != 0 {
        let ui = Ui.begin(w.font, 12, 8);
        ui.label(`score {w.score}`);
        ui.gap(4);
        ui.label(`best {w.best.get()}`);
    }
    w.stats.overlay(w.font);
}
