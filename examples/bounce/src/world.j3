// Paddle + ball. Left/Right move; ball bounces; miss resets.

module bounce.world;

use j3.assets.Assets;
use j3.collide.overlapBox;
use j3.debug.Stats;
use j3.fx.{ Particles, Timer };
use j3.game.{ Font, Key, Mouse, Pad, Axis, clear, drawRect, keyDown, keyPressed, mouseDown, mousePos, padAxis, padDown, requestQuit, rgb, setColor };
use j3.math.{ Vec2, clamp };
use j3.memory.Arena;
use j3.res.Slot;
use j3.save;
use j3.ui.Ui;

const WIDTH: int = 640;
const HEIGHT: int = 360;
const PADDLE_Y: int = 330;
const PADDLE_W: int = 80;
const PADDLE_H: int = 12;
const BALL: int = 12;

pub struct World {
    paddle_x: f32;
    ball: Vec2;
    vel: Vec2;
    score: int;
    best: Slot<int>;
    bag: Assets;
    fx: Particles;
    hit: Timer;
    stats: Stats;
    font: Font;
}

pub fn boot(mem: &Arena): World {
    return World {
        paddle_x: 280,
        ball: Vec2 { x: 320, y: 80 },
        vel: Vec2 { x: 180, y: 160 },
        score: 0,
        best: Slot<int>.none(0),
        bag: Assets.new(mem),
        fx: Particles.new(mem, 48),
        hit: Timer.of(0),
        stats: Stats.fresh(),
        font: Font { raw: 0 },
    };
}

pub fn load(w: &World) {
    w.bag.addRoot("assets/");
    w.bag.addRoot("examples/dungeon/assets/");
    w.bag.addRoot("../dungeon/assets/");
    w.bag.addRoot("../examples/dungeon/assets/");
    w.font = w.bag.font("font.ttf", 16);
    let s = save.load("bounce.save", w.bag.arena);
    w.best.put(save.getInt(&s, "best", 0));
}

pub fn input(w: &World, _dt: f32) {
    if keyDown(Key.Escape) {
        requestQuit();
    }
    if keyPressed(Key.F3) {
        w.stats.shown = !w.stats.shown;
    }
}

pub fn begin(w: &World, _dt: f32) {
    w.stats.sample(2);
}

pub fn after(w: &World, dt: f32) {
    w.fx.tick(dt);
    w.hit.tick(dt);
}

fn persist(w: &World) {
    if w.score > w.best.get() {
        w.best.put(w.score);
        let s = save.empty(w.bag.arena);
        save.putInt(&s, "best", w.best.get());
        save.store(&s, "bounce.save");
    }
}

pub fn step(w: &World, dt: f32) {
    if keyDown(Key.Left) || keyDown(Key.A) || padDown(0, Pad.Left) {
        w.paddle_x = w.paddle_x - f32(320) * dt;
    }
    if keyDown(Key.Right) || keyDown(Key.D) || padDown(0, Pad.Right) {
        w.paddle_x = w.paddle_x + f32(320) * dt;
    }
    let stick = padAxis(0, Axis.LeftX);
    if stick != 0 {
        w.paddle_x = w.paddle_x + stick * f32(320) * dt;
    }
    if mouseDown(Mouse.Left) {
        let mp = mousePos();
        w.paddle_x = mp.x - 40;
    }
    let max_x = f32(WIDTH - PADDLE_W);
    w.paddle_x = clamp(w.paddle_x, 0, max_x);

    w.ball = w.ball + w.vel * dt;

    if w.ball.x < 0 {
        w.ball.x = 0;
        w.vel.x = -w.vel.x;
    }
    let right = f32(WIDTH - BALL);
    if w.ball.x > right {
        w.ball.x = right;
        w.vel.x = -w.vel.x;
    }
    if w.ball.y < 0 {
        w.ball.y = 0;
        w.vel.y = -w.vel.y;
    }

    let paddle = Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) };
    let pad_sz = Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) };
    let ball_sz = Vec2 { x: f32(BALL), y: f32(BALL) };
    if w.vel.y > 0 && overlapBox(w.ball, ball_sz, paddle, pad_sz) {
        w.ball.y = f32(PADDLE_Y) - f32(BALL);
        w.vel.y = -w.vel.y;
        w.score = w.score + 1;
        persist(w);
        w.fx.burst(w.ball, 10, 120);
        w.hit.reset(0.12);
    }

    if w.ball.y > f32(HEIGHT) {
        persist(w);
        w.score = 0;
        w.ball = Vec2 { x: 320, y: 80 };
        w.vel = Vec2 { x: 180, y: 160 };
    }
}

pub fn draw(w: &World) {
    clear();
    if !w.hit.done() {
        setColor(rgb(255, 255, 255));
    } else {
        setColor(rgb(220, 220, 220));
    }
    drawRect(Vec2 { x: w.paddle_x, y: f32(PADDLE_Y) }, Vec2 { x: f32(PADDLE_W), y: f32(PADDLE_H) });
    setColor(rgb(240, 200, 80));
    drawRect(w.ball, Vec2 { x: f32(BALL), y: f32(BALL) });
    w.fx.draw();
    if w.font.raw != 0 {
        let ui = Ui.begin(w.font, 12, 8);
        ui.label(`score {w.score}`);
        ui.gap(4);
        ui.label(`best {w.best.get()}`);
    }
    w.stats.overlay(w.font);
}
