// Playable SDL window. Escape quits. Tests init / poll / keys / draw / destroy.

module bounce;

use bounce.world.{ World, after, begin, boot, draw, input, load, step };
use j3.app.App;

fn main() {
    let app = App<World>.create("bounce", 640, 360, boot);
    app.startup(load);
    app.first(begin);
    app.add(step);
    app.last(after);
    app.always(input);
    app.draw(draw);
    app.run();
}
