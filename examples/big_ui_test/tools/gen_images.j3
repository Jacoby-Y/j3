// Generates the demo images in assets/img (deterministic; no window, no downloads).
// Run from the project dir:  timeout 60 j3c run --file tools/gen_images.j3
// photo.jpg is photo.png converted once with ImageMagick: convert assets/img/photo.png -quality 88 assets/img/photo.jpg

module gen_images;

use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode };
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;

fn save(c: Canvas, name: string, arena: &Arena) {
    match c.savePng(name, arena) {
        Result.Ok(_) {
        }
        Result.Err(_) {
            panic(name);
        }
    }
    printLn(name);
}

/// A 192x128 "photo": sky gradient, a sun, two hills, noise.
fn photo(arena: &Arena) {
    let c = Canvas.create(arena, 192, 128, Mode.Smooth);
    c.gradientRect(0, 0, 192, 128, canvas.rgb(70, 120, 200), canvas.rgb(250, 190, 140), true);
    c.fillCircle(140, 40, 18, canvas.rgb(255, 238, 170));
    c.fillCircle(140, 40, 12, canvas.rgb(255, 250, 220));
    c.fillTriangle(0.0, 128.0, 70.0, 56.0, 150.0, 128.0, canvas.rgb(60, 110, 80));
    c.fillTriangle(60.0, 128.0, 140.0, 70.0, 192.0, 128.0, canvas.rgb(40, 85, 70));
    c.noiseRect(0, 100, 192, 28, 7, 2, canvas.rgba(20, 50, 40, 90), canvas.rgba(90, 150, 100, 90));
    // a corner mark so crops and flips are visible
    c.fillRect(0, 0, 16, 16, canvas.rgb(230, 60, 60));
    c.strokeRect(0, 0, 192, 128, 2, canvas.rgb(255, 255, 255));
    save(c, "assets/img/photo.png", arena);
}

/// A 48x48 frame for nine-slice: 12 px corners with a stud, gradient edges, plain center.
fn frame(arena: &Arena) {
    let c = Canvas.create(arena, 48, 48, Mode.Pixel);
    c.clear(canvas.rgba(0, 0, 0, 0));
    c.fillRect(0, 0, 48, 48, canvas.rgb(60, 52, 90));
    c.fillRect(3, 3, 42, 42, canvas.rgb(232, 196, 110));
    c.fillRect(6, 6, 36, 36, canvas.rgb(38, 34, 62));
    c.fillRect(12, 12, 24, 24, canvas.rgb(52, 48, 84));
    // corner studs
    c.fillRect(3, 3, 6, 6, canvas.rgb(250, 120, 90));
    c.fillRect(39, 3, 6, 6, canvas.rgb(250, 120, 90));
    c.fillRect(3, 39, 6, 6, canvas.rgb(250, 120, 90));
    c.fillRect(39, 39, 6, 6, canvas.rgb(250, 120, 90));
    // dashes on the edges so stretching shows
    for i in 0..4 {
        c.fillRect(16 + i32(i) * 6, 3, 3, 3, canvas.rgb(60, 52, 90));
        c.fillRect(16 + i32(i) * 6, 42, 3, 3, canvas.rgb(60, 52, 90));
    }
    save(c, "assets/img/frame.png", arena);
}

/// A 4x2 sprite sheet of 32x32 frames: a pulsing ring with a marker that walks around it.
fn sheet(arena: &Arena) {
    let c = Canvas.create(arena, 128, 64, Mode.Smooth);
    c.clear(canvas.rgba(0, 0, 0, 0));
    let rad: [8]f32 = [8.0, 10.0, 12.0, 14.0, 14.0, 12.0, 10.0, 8.0];
    let mdx: [8]f32 = [12.0, 9.0, 0.0, -9.0, -12.0, -9.0, 0.0, 9.0];
    let mdy: [8]f32 = [0.0, 9.0, 12.0, 9.0, 0.0, -9.0, -12.0, -9.0];
    for f in 0..8 {
        let ox = f32((f % 4) * 32);
        let oy = f32((f / 4) * 32);
        c.fillCircle(ox + 16.0, oy + 16.0, rad[f], canvas.rgb(90, 170, 250));
        c.fillCircle(ox + 16.0, oy + 16.0, rad[f] - 3.0, canvas.rgb(30, 50, 90));
        c.fillCircle(ox + 16.0 + mdx[f], oy + 16.0 + mdy[f], 3.0, canvas.rgb(250, 220, 90));
        // frame number as pips so the order is readable
        for p in 0..(f + 1) {
            c.fillRect(i32(ox) + 2 + i32(p) * 3, i32(oy) + 28, 2, 2, canvas.rgb(255, 255, 255));
        }
    }
    save(c, "assets/img/sheet.png", arena);
}

/// A 16x16 pattern tile for repeating backgrounds.
fn tile(arena: &Arena) {
    let c = Canvas.create(arena, 16, 16, Mode.Pixel);
    c.fillRect(0, 0, 16, 16, canvas.rgb(40, 44, 70));
    c.fillRect(0, 0, 8, 8, canvas.rgb(52, 58, 92));
    c.fillRect(8, 8, 8, 8, canvas.rgb(52, 58, 92));
    c.fillCircle(4, 4, 2, canvas.rgb(140, 170, 255));
    c.fillCircle(12, 12, 2, canvas.rgb(255, 170, 140));
    save(c, "assets/img/tile.png", arena);
}

/// A white 32x32 gear-ish icon on transparent: tint it with `image-tint`.
fn icon(arena: &Arena) {
    let c = Canvas.create(arena, 32, 32, Mode.Smooth);
    c.clear(canvas.rgba(0, 0, 0, 0));
    c.fillCircle(16, 16, 11, canvas.rgb(255, 255, 255));
    c.fillCircle(16, 16, 5, canvas.rgba(0, 0, 0, 0));
    c.fillRect(14, 1, 4, 6, canvas.rgb(255, 255, 255));
    c.fillRect(14, 25, 4, 6, canvas.rgb(255, 255, 255));
    c.fillRect(1, 14, 6, 4, canvas.rgb(255, 255, 255));
    c.fillRect(25, 14, 6, 4, canvas.rgb(255, 255, 255));
    save(c, "assets/img/icon.png", arena);
}

fn main() {
    let arena = Arena.create(4 * 1024 * 1024);
    photo(&arena);
    frame(&arena);
    sheet(&arena);
    tile(&arena);
    icon(&arena);
    arena.destroy();
}
