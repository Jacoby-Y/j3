<!-- A progress bar: the fill is slid by `left` inside a clipped track and shimmers (animated gradient
     stops); `busy` swaps it for a chunk that runs back and forth when the length is unknown. -->

<script>
    props {
        value: f32;     // 0 to 1
        busy: bool;
    }

    fn slide(): f32 {
        return (value - 1.0) * 260.0;
    }
</script>

<div class="track">
    {#if busy}
        <div class="chunk"></div>
    {:else}
        <div class="fill" left={slide()}></div>
    {/if}
</div>

<style>
    .track { position: relative; width: 260px; height: 10px; overflow: hidden; border-radius: 5px; clip-path: inset(0px round 5px); background: #2a2b3d; }
    .fill { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(100deg, #5b8de8 0%, #b4d0ff 10%, #5b8de8 20%); animation: glide 1400ms linear infinite; }
    .chunk { position: absolute; top: 0; left: 0; width: 90px; height: 100%; border-radius: 5px; background: linear-gradient(90deg, #5b8de8, #b4d0ff); animation: run 1100ms ease-in-out infinite alternate; }
    @keyframes glide {
        from { background-image: linear-gradient(100deg, #5b8de8 0%, #b4d0ff 10%, #5b8de8 20%); }
        to { background-image: linear-gradient(100deg, #5b8de8 80%, #b4d0ff 90%, #5b8de8 100%); }
    }
    @keyframes run { from { transform: translateX(0px); } to { transform: translateX(170px); } }
</style>
