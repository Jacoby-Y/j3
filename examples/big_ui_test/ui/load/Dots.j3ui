<!-- Three dots that hop in turn (anim-delay staggers one keyframes). -->

<script>
    props {
        tone: int;      // 0 blue, 1 pink, 2 green
    }
</script>

<div class="dots">
    {#each 0..3 as i}
        <div class="dot" class:t0={tone == 0} class:t1={tone == 1} class:t2={tone == 2} anim-delay={i * 160}></div>
    {/each}
</div>

<style>
    .dots { display: flex; gap: 6px; align-items: center; height: 28px; }
    .dot { width: 9px; height: 9px; border-radius: 5px; animation: hop 960ms ease-in-out infinite; }
    .t0 { background: #89b4fa; }
    .t1 { background: #f38ba8; }
    .t2 { background: #a6e3a1; }
    @keyframes hop { 0% { transform: translateY(0px); opacity: 0.4; } 30% { transform: translateY(-8px); opacity: 1; } 60% { transform: translateY(0px); opacity: 0.4; } 100% { transform: translateY(0px); opacity: 0.4; } }
</style>
