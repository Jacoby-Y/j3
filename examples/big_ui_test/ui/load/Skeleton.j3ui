<!-- A loading placeholder: grey bars with a sheen sweeping across (the gradient's stop positions are
     animated, so the sheen needs no image and no extra element). -->

<script>
    props {
        lines: int;         // text bars
        avatar: bool;       // a round picture on the left
    }
</script>

<div class="sk">
    {#if avatar}
        <div class="ph pic"></div>
    {/if}
    <div class="lines">
        {#each 0..lines as i}
            <div class="ph line" class:last={i == lines - 1} anim-delay={i * 120}></div>
        {/each}
    </div>
</div>

<style>
    .sk { display: flex; gap: 12px; align-items: center; width: 260px; }
    .lines { display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .ph { background: linear-gradient(100deg, #2a2b3d 0%, #44465f 10%, #2a2b3d 20%); animation: sheen 1500ms ease-in-out infinite; }
    .pic { width: 44px; height: 44px; border-radius: 22px; }
    .line { height: 12px; border-radius: 6px; }
    .last { width: 60%; }
    @keyframes sheen {
        from { background-image: linear-gradient(100deg, #2a2b3d 0%, #44465f 10%, #2a2b3d 20%); }
        to { background-image: linear-gradient(100deg, #2a2b3d 80%, #44465f 90%, #2a2b3d 100%); }
    }
</style>
