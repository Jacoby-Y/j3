<!-- A ring spinner: a rounded box whose border is a conic gradient fading from clear to the tone color,
     turned by a transform animation (the ramp is baked once, so many spinners cost almost nothing). -->

<script>
    props {
        tone: int;      // 0 blue, 1 pink, 2 green
        big: bool;      // 56 px instead of 28 px
    }
</script>

<div class="ring" class:big={big} class:t0={tone == 0} class:t1={tone == 1} class:t2={tone == 2}></div>

<style>
    .ring { width: 28px; height: 28px; border: 4px solid #000; border-radius: 14px; animation: turn 800ms linear infinite; }
    .ring.big { width: 56px; height: 56px; border-width: 6px; border-radius: 28px; animation-duration: 1100ms; }
    .t0 { border-image: conic-gradient(from 0deg, rgba(137, 180, 250, 0), #89b4fa) 1; }
    .t1 { border-image: conic-gradient(from 0deg, rgba(243, 139, 168, 0), #f38ba8) 1; }
    .t2 { border-image: conic-gradient(from 0deg, rgba(166, 227, 161, 0), #a6e3a1) 1; }
    @keyframes turn { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>
