<script>
    let shown = true;
    let wide = false;
    let items: int = 4;
</script>

<div class="col">
    <kit.Section note="Hover color, scale, rotation, glow, shadow">
        <div class="row">
            <div class="card fade-bg">color</div>
            <div class="card fade-text">text</div>
            <button class="grow">scale</button>
            <div class="card spin">rotate</div>
            <div class="card glow">glow</div>
            <div class="card lift">shadow</div>
        </div>
    </kit.Section>
    <kit.Section note="Click ripple, focus ring (click a button), press">
        <div class="row">
            <button class="ripple">ripple</button>
            <button class="focus-ring">focus</button>
            <button class="press">press me</button>
        </div>
    </kit.Section>
    <kit.Section note="Keyframes: slide, scale, rotate, bounce, spring, custom easing">
        <div class="row tall">
            <div class="dot slide">slide</div>
            <div class="dot pulse">scale</div>
            <div class="dot rot">spin</div>
            <div class="dot bounce">bounce</div>
            <div class="dot spring">spring</div>
            <div class="dot bezier">bezier</div>
        </div>
    </kit.Section>
    <kit.Section note="Staggered keyframes (anim-delay)">
        <div class="row">
            {#each 0..6 as i}
                <div class="bar" anim-delay={i * 120}></div>
            {/each}
        </div>
    </kit.Section>
    <kit.Section note="Animated layout (width, height, flex) and fade">
        <div class="row">
            <button on:click={wide = !wide}>Toggle size</button>
            <button on:click={shown = !shown}>Toggle fade</button>
        </div>
        <div class="row">
            <div class="box" class:wide={wide}>width + height</div>
            <div class="box flexy" class:wide={wide}>flex</div>
        </div>
        {#if shown}
            <div class="card note" transition:fade={300}>Now you see me</div>
        {/if}
    </kit.Section>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 10px; }
    .row { align-items: center; }
    .tall { height: 64px; }
    .card { padding: 14px 18px; background: var(--raised); border-radius: 8px; }
    .fade-bg { transition: background 200ms; }
    .fade-bg:hover { background: #89b4fa; }
    .fade-text { transition: color 200ms; }
    .fade-text:hover { color: #f9e2af; }
    .grow { padding: 14px 18px; border-radius: 8px; transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .grow:hover { transform: scale(1.2); }
    .spin { transition: transform 400ms ease-out; }
    .spin:hover { transform: rotate(20deg) scale(1.1); }
    .glow { transition: box-shadow 250ms; }
    .glow:hover { box-shadow: 0 0 18px 4px rgba(137, 180, 250, 0.8); }
    .lift { transition: box-shadow 250ms, transform 250ms; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4); }
    .lift:hover { box-shadow: 0 10px 18px rgba(0, 0, 0, 0.6); transform: translateY(-4px); }
    .press { transition: transform 80ms; }
    .press:active { transform: scale(0.9); }
    .ripple { ripple: rgba(255, 255, 255, 0.45) 700ms; }
    .focus-ring { transition: box-shadow 200ms; }
    .focus-ring:focus { box-shadow: 0 0 0 3px #89b4fa; animation: ring 1s ease-in-out infinite alternate; }
    @keyframes ring { from { box-shadow: 0 0 0 2px rgba(137, 180, 250, 0.9); } to { box-shadow: 0 0 0 6px rgba(137, 180, 250, 0.2); } }
    .dot { width: 48px; height: 48px; border-radius: 24px; background: #a6e3a1; color: var(--bg); font-size: 11px; display: flex; align-items: center; justify-content: center; }
    .slide { animation: slide 1.2s ease-in-out infinite alternate; }
    @keyframes slide { from { transform: translateX(0px); } to { transform: translateX(40px); } }
    .pulse { animation: pulse 1s ease-in-out infinite alternate; background: #f9e2af; }
    @keyframes pulse { from { transform: scale(0.6); } to { transform: scale(1.1); } }
    .rot { animation: rot 2s linear infinite; background: #f38ba8; border-radius: 8px; }
    @keyframes rot { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .bounce { animation: drop 1.2s bounce infinite; background: #89dceb; }
    .spring { animation: drop 1.2s spring infinite; background: #cba6f7; }
    .bezier { animation: drop 1.2s cubic-bezier(0.8, 0, 0.2, 1) infinite alternate; background: #fab387; }
    @keyframes drop { from { transform: translateY(-14px); } to { transform: translateY(14px); } }
    .bar { width: 14px; height: 40px; border-radius: 4px; background: #89b4fa; animation: grow-bar 700ms ease-in-out infinite alternate; }
    @keyframes grow-bar { 0% { transform: scale(0.3); opacity: 0.3; } 100% { transform: scale(1); opacity: 1; } }
    .box { width: 140px; height: 40px; background: #74c7ec; color: var(--bg); padding: 10px; border-radius: 8px; transition: width 400ms ease-in-out, height 400ms ease-in-out, background 400ms; }
    .box.wide { width: 320px; height: 70px; background: #a6e3a1; }
    .flexy { flex: 1; transition: flex 400ms; }
    .note { background: #a6e3a1; color: var(--bg); }
</style>
