<script>
    let clicks = 0;
    let on = true;
    let sound = false;
    let volume: f32 = 0.5;
    let low: f32 = 20.0;
    let high: f32 = 70.0;
    let name = "";
    let query = "";
    let submits = 0;
    let fruit = "apple";
    let toppings = "cheese,olives";
    let color = "#89b4fa";
</script>

<div class="cols">
    <div class="col">
        <kit.Section note="Buttons">
            <div class="row">
                <button on:click={clicks += 1}>Standard</button>
                <button class="outline" on:click={clicks += 1}>Outlined</button>
                <button class="pill" on:click={clicks += 1}>Pill</button>
                <button disabled>Disabled</button>
            </div>
            <div class="row">
                <button class="grad" on:click={clicks += 1}>Gradient</button>
                <button class="arrow" on:click={clicks += 1}>Arrow</button>
            </div>
            <p>Clicked {clicks} times</p>
        </kit.Section>
        <kit.Section note="Checkboxes">
            <label><input type="checkbox" bind:checked={on} /><span>Enabled: {on}</span></label>
            <label><input type="checkbox" bind:checked={sound} /><span>Sound: {sound}</span></label>
        </kit.Section>
        <kit.Section note="Text boxes: drag or Shift+arrows select, Ctrl+A/C/X/V, Tab">
            <label><span class="lab">Name</span><input type="text" placeholder="Your name" bind:value={name} on:submit={submits += 1} /></label>
            <label><span class="lab">Search</span><input type="search" placeholder="Search..." bind:value={query} /></label>
            <p>name "{name}", search "{query}", Enter pressed {submits} times</p>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="Sliders (arrow keys, Shift for big steps) and a two-thumb range">
            <label><span class="lab">Volume</span><input type="range" min={0} max={1} step={0.05} bind:value={volume} /><span>{volume}</span></label>
            <label><span class="lab">Range</span><input type="range" min={0} max={100} step={5} bind:value={low} bind:high={high} /><span>{low} to {high}</span></label>
        </kit.Section>
        <kit.Section note="Dropdown and multi-select">
            <label>
                <span class="lab">Fruit</span>
                <select bind:value={fruit}>
                    <option value="apple">Apple</option>
                    <option value="banana">Banana</option>
                    <option value="cherry">Cherry</option>
                    <option value="durian" disabled>Durian (sold out)</option>
                    <option value="elderberry">Elderberry</option>
                </select>
                <span>{fruit}</span>
            </label>
            <label>
                <span class="lab">Toppings</span>
                <select multiple placeholder="Pick some" bind:value={toppings}>
                    <option value="cheese">Cheese</option>
                    <option value="olives">Olives</option>
                    <option value="peppers">Peppers</option>
                    <option value="onions">Onions</option>
                </select>
                <span>{toppings}</span>
            </label>
        </kit.Section>
        <kit.Section note="Color picker">
            <label><span class="lab">Accent</span><input type="color" bind:value={color} /><span>{color}</span></label>
        </kit.Section>
    </div>
</div>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; display: flex; flex-direction: column; gap: 12px; }
    .row { gap: 8px; }
    .outline { background: transparent; border: 2px solid var(--accent); color: var(--accent); }
    .outline:hover { background: var(--raised); }
    .pill { border-radius: 999px; background: var(--accent); color: var(--bg); }
    .pill:hover { background: #b4befe; }
    .grad { background: linear-gradient(135deg, #89b4fa, #cba6f7); color: var(--bg); transition: background-image 250ms; }
    .grad:hover { background-image: linear-gradient(315deg, #89b4fa, #cba6f7); }
    .arrow { padding: 8px 26px 8px 14px; border-radius: 0; background: #f9e2af; color: var(--bg); clip-path: polygon(0% 0%, 85% 0%, 100% 50%, 85% 100%, 0% 100%); }
    .arrow:hover { background: #fab387; }
    button:disabled { opacity: 0.4; }
    label { display: flex; align-items: center; gap: 10px; }
    .lab { width: 64px; color: var(--muted); font-size: 13px; }
    input[type="range"] { width: 160px; accent-color: var(--accent); }
    input[type="text"], input[type="search"], select { width: 190px; padding: 6px 10px; background: var(--raised); border: 1px solid var(--hover); border-radius: 8px; color: var(--text); transition: border-color 150ms; }
    input[type="text"]:focus, input[type="search"]:focus, select:focus { border-color: var(--accent); }
    input[type="color"] { width: 44px; height: 26px; padding: 3px; background: var(--raised); border: 1px solid var(--hover); border-radius: 8px; }
    input[type="color"]:focus { border-color: var(--accent); }
</style>
