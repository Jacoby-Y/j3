<div class="cols">
    <div class="col">
        <kit.Section note="Sizes">
            <div class="row base">
                <span class="s12">12px</span><span class="s16">16px</span><span class="s24">24px</span><span class="s32">32px</span>
            </div>
        </kit.Section>
        <kit.Section note="Weight and color">
            <div class="row"><span>Regular</span><span class="bold">bold</span><span class="accent">accent</span><span class="warn">warning</span><span class="dim">muted</span></div>
        </kit.Section>
        <kit.Section note="Alignment">
            <p class="left">left</p>
            <p class="center">center</p>
            <p class="right">right</p>
            <p class="center narrow">Centered text that wraps onto a second line inside a narrow box.</p>
        </kit.Section>
        <kit.Section note="visibility: hidden keeps the box (gap below) but paints and hit-tests nothing; a visible child still shows">
            <div class="row vis">
                <span>before</span>
                <div class="ghost"><button>hidden button</button><span class="back">visible child</span></div>
                <span>after</span>
            </div>
        </kit.Section>
        <kit.Section note="Static selection: user-select: text (drag, double-click a word, Ctrl+A, Ctrl+C)">
            <p class="sel">Select this sentence: double-click picks a word, triple-click the block, Ctrl+A everything.</p>
        </kit.Section>
        <kit.Section note="em / rem / calc(): em follows the parent size (16px here), rem the root (15px)">
            <div class="units">
                <div class="u1"><span class="e">1.5em</span> <span class="r">1.5rem</span> <span class="c">calc()</span></div>
            </div>
        </kit.Section>
        <kit.Section note="max-width: 220px and min-width: 160px (the box grows with its text, then stops)">
            <div class="mm"><span class="mmbox">short</span></div>
            <div class="mm"><span class="mmbox">a much longer line that is capped by max-width</span></div>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="Wrapping (width 260px, line-height 20px)">
            <p class="wrap">This is a long paragraph that should wrap inside its fixed-width box instead of running off the edge of the panel.</p>
        </kit.Section>
        <kit.Section note="text-align: justify (soft-wrapped lines only; the last line stays left)">
            <p class="wrap just">This is a long paragraph that should wrap inside its fixed-width box and spread each full line to both edges of the panel.</p>
        </kit.Section>
        <kit.Section note="line-clamp: 2 (whole block, ellipsis on the last line)">
            <p class="wrap clamp">This is a long paragraph that should wrap inside its fixed-width box but only the first two lines show, the rest is cut with an ellipsis.</p>
        </kit.Section>
        <kit.Section note="Truncation: nowrap + text-overflow">
            <p class="cut ellipsis">A very long single line that is cut with an ellipsis when it reaches the edge</p>
            <p class="cut clip">A very long single line that is simply clipped at the edge of its box</p>
            <p class="cut ellipsis"><span>Spans&nbsp;</span><span class="accent">cut&nbsp;</span><span class="warn">too,&nbsp;mid-run&nbsp;</span>and keep going to the edge</p>
        </kit.Section>
        <kit.Section note="overflow-wrap: break-word (left: normal, right: break-word)">
            <div class="row">
                <p class="word clip">Supercalifragilisticexpialidocious_and_more</p>
                <p class="word brk">Supercalifragilisticexpialidocious_and_more</p>
            </div>
        </kit.Section>
        <kit.Section note="white-space: pre-line (newlines break lines)">
            <p class="pre">{lines()}</p>
        </kit.Section>
        <kit.Section note="white-space: pre (no wrapping, spaces kept) and pre-wrap (spaces kept, wraps at 220px)">
            <p class="keep nowrap">{spaced()}</p>
            <p class="keep wrapped">{spaced()}</p>
        </kit.Section>
    </div>
</div>

<script>
    fn lines(): string {
        return "First line\nSecond line, still\ncollapsing   extra   spaces\n\nafter a blank line";
    }
    fn spaced(): string {
        return "a   b     c\n\tTabbed (8 columns) and a very long line that runs on past the edge";
    }
</script>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .s12 { font-size: 12px; }
    .s16 { font-size: 16px; }
    .s24 { font-size: 24px; }
    .s32 { font-size: 32px; }
    .row { gap: 8px; }
    .base { align-items: baseline; }
    .bold { font-weight: bold; }
    .accent { color: var(--accent); }
    .warn { color: #fab387; }
    .dim { color: var(--muted); }
    .left { text-align: left; }
    .center { text-align: center; }
    .right { text-align: right; }
    .narrow { width: 200px; }
    .wrap { width: 260px; line-height: 20px; }
    .cut { width: 280px; white-space: nowrap; background: var(--raised); padding: 3px 6px; overflow: hidden; }
    .ellipsis { text-overflow: ellipsis; }
    .clip { text-overflow: clip; }
    .word { width: 120px; background: var(--raised); padding: 3px 6px; line-height: 18px; overflow-y: hidden; }
    .brk { overflow-wrap: break-word; }
    .pre { white-space: pre-line; }
        .keep { width: 220px; background: var(--raised); padding: 3px 6px; overflow-x: hidden; }
    .nowrap { white-space: pre; }
    .wrapped { white-space: pre-wrap; }
    .just { text-align: justify; }
    .clamp { line-clamp: 2; }
    .vis { align-items: flex-start; gap: 8px; }
    .ghost { visibility: hidden; display: flex; flex-direction: column; width: 150px; height: 56px; background: #f38ba8; }
    .back { visibility: visible; color: var(--bg); background: #a6e3a1; padding: 4px 8px; }
    .sel { user-select: text; width: 300px; line-height: 20px; }
    .units { font-size: 16px; }
    .u1 { display: flex; gap: 10px; align-items: baseline; white-space: nowrap; }
    .e { font-size: 1.5em; color: var(--accent); }
    .r { font-size: 2rem; color: #a6e3a1; }
    .c { font-size: calc(10px + 1.2em); color: #fab387; }
    .mm { margin-bottom: 6px; }
    .mmbox { display: block; min-width: 160px; max-width: 220px; padding: 4px 8px; background: var(--raised); border-radius: 6px; }
</style>
