<!-- Markup and CSS added by plan 023 that have no older page: selectors, inline boxes, {#let}, &x each, int keys,
     emit from a fn, an autoselect dialog with a default button, and display: contents table rows. -->

<script>
    use big_ui_test.fresh.Row;

    let rows: [4]Row = [Row { id: 11, name: "Ada", n: 1 }, Row { id: 7, name: "Grace", n: 2 }, Row { id: 23, name: "Linus", n: 3 }, Row { id: 5, name: "Alan", n: 4 }];
    let later: bool = false;
    let pings: int = 0;
    let sum: int = 0;
    let last: string = "-";
    let dones: int = 0;
    let dlg: bool = false;
    let name: string = "Untitled";
    let saved: string = "Untitled";

    fn ok() {
        if name.len > 0 {
            saved = name;
            dlg = false;
        }
    }
</script>

<div class="cols">
    <div class="col">
        <kit.Section note="Selectors: .row + .row (gold top border), .on ~ .row (red after the green one), #hero">
            <div class="list">
                {#each 0..4 as i}
                    <div class="r" class:on={i == 1}>row {i}</div>
                {/each}
            </div>
            <div id="hero">#hero (id selector)</div>
        </kit.Section>
        <kit.Section note="::before / ::after with content (a click swaps the content: class .alt)">
            <div class="card" class:alt={later} on:click={later = !later}>card body</div>
            <p class="tags">Quest <span class="tag">Dragon Hunt</span> <span class="tag epic">Epic</span> ready</p>
        </kit.Section>
        <kit.Section note="Inline boxes: padded, bordered, rounded span pills; one highlight wraps across lines">
            <p class="chat"><span class="who">Mira</span> found a <span class="item">Moonblade</span><span class="rare">Rare</span> in the vault and keeps <span class="hl">talking about how it glows in the dark</span> all the way home.</p>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="#let and #each rows as &r keyed (r.id : int): the buttons change the rows in place; int keys">
            {#let total = rows.len}
            {#each rows as &r (r.id : int)}
                {#let score = r.n * 10}
                <div class="line"><button on:click={r.n += 1}>{r.name} +1</button><span>id {r.id}: n={r.n}, score={score}</span></div>
            {/each}
            <small>{total} rows</small>
        </kit.Section>
        <kit.Section note="emit from a script fn (kit.Pinger: send() and both() emit)">
            <kit.Pinger on:ping={sum += event.n; pings += 1; last = event.tag} on:done={dones += 1} />
            <small>pings={pings} sum={sum} last={last} done={dones}</small>
        </kit.Section>
        <kit.Section note="dialog modal autoselect: the text is selected on open; Enter presses the primary button">
            <div class="row"><button on:click={dlg = true}>Rename...</button><span>{saved}</span></div>
            {#if dlg}
                <dialog modal autoselect closedby="any" on:close={dlg = false} transition:fade={120}>
                    <h2>Rename</h2>
                    <input type="text" aria-label="Name" bind:value={name} />
                    <div class="row end">
                        <button on:click={dlg = false}>Cancel</button>
                        <button class="primary" disabled={name.len == 0} on:click={ok()}>OK</button>
                    </div>
                </dialog>
            {/if}
        </kit.Section>
        <kit.Section note="display: contents rows share the grid's columns (1fr 90px 70px)">
            <div class="table">
                <div class="tr head"><span>Name</span><span>Id</span><span>N</span></div>
                {#each rows as &r (r.id : int)}
                    <div class="tr"><span>{r.name}</span><span>{r.id}</span><span>{r.n}</span></div>
                {/each}
            </div>
        </kit.Section>
    </div>
</div>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .list { width: 220px; background: var(--bg); }
    .r { height: 26px; padding-left: 8px; background: #3050a0; display: flex; align-items: center; }
    .r + .r { border-top: 3px solid #ffd040; }
    .r.on { background: #20a050; }
    .r.on ~ .r { background: #a03030; }
    #hero { margin-top: 4px; width: 220px; padding: 4px 8px; background: #808000; color: #fff; }
    .card { position: relative; width: 220px; height: 70px; background: #313244; }
    .card::before { content: "TITLE"; display: block; height: 22px; padding-left: 6px; background: #606080; }
    .card::after { content: "*"; position: absolute; right: 0; top: 0; width: 18px; height: 18px; background: #ff8000; color: #000; text-align: center; }
    .card.alt::before { content: "CHANGED"; background: #806060; }
    .tag::before { content: "["; }
    .tag::after { content: "]"; }
    .tag { padding: 0 2px; background: #2a4a5a; }
    .epic::before { content: "*"; display: inline; padding: 0 4px; margin-right: 3px; background: #c04080; border-radius: 6px; }
    .chat { line-height: 26px; }
    .who { color: #80c0ff; padding: 1px 4px; background: #203050; }
    .item { color: #ffd040; }
    .rare { margin-left: 4px; padding: 1px 6px; border: 1px solid #a070ff; border-radius: 4px; background: #382060; color: #e0c8ff; font-size: 12px; }
    .hl { background: #806010; padding: 2px 5px; border: 2px solid #ffd040; border-radius: 6px; }
    .line { display: flex; gap: 10px; align-items: center; }
    dialog { display: flex; flex-direction: column; gap: 10px; width: 320px; padding: 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; backdrop-color: rgba(0, 0, 0, 0.55); }
    .end { justify-content: flex-end; }
    dialog input { padding: 6px 8px; background: var(--raised); border: 1px solid var(--line); border-radius: 6px; }
    button.primary { background: var(--accent); color: var(--bg); }
    .table { display: grid; grid-template-columns: 1fr 90px 70px; }
    .tr { display: contents; }
    .table span { padding: 4px 8px; border-bottom: 1px solid var(--line); }
    .head span { color: var(--muted); }
</style>
