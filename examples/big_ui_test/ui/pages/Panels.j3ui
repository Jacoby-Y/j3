<!-- F: floating and dockable panels, a collapsible side panel, sticky headers. -->

<script>
    let openA: bool = true;
    let sideOpen: bool = true;
    const GROUPS: [4]string = ["Weapons", "Armor", "Potions", "Keys"];
</script>

<div class="col">
    <kit.Section note="Panels: drag a header, resize with the corner grip, drop near the left, right or bottom edge to dock. The button in a header does not drag.">
        <div class="space">
            <div class="win a" panel="dock">
                <div class="bar" panel-handle>
                    <span class="title">Inspector</span>
                    <button class="mini" on:click={openA = !openA}>{if openA { "-" } else { "+" }}</button>
                </div>
                {#if openA}
                    <div class="body">
                        <p>Drag me by the header.</p>
                        <p>I stay inside the workspace and dock to its edges.</p>
                    </div>
                {/if}
                <div class="grip" panel-resize></div>
            </div>
            <div class="win b" panel="dock">
                <div class="bar" panel-handle><span class="title">Palette</span></div>
                <div class="body">
                    <div class="swatches">
                        {#each 0..3 as i}
                            <div class="sw s0"></div><div class="sw s1"></div><div class="sw s2"></div><div class="sw s3"></div>
                        {/each}
                    </div>
                </div>
                <div class="grip" panel-resize></div>
            </div>
            <div class="win c" panel>
                <div class="bar" panel-handle><span class="title">Floating only</span></div>
                <div class="body"><p>No dock zones for this one.</p></div>
                <div class="grip" panel-resize></div>
            </div>
        </div>
    </kit.Section>
    <kit.Section note="Collapsible side panel (a width transition) and sticky group headers inside its scroll box">
        <div class="split">
            <div class="side" class:shut={!sideOpen}>
                <button class="mini" on:click={sideOpen = !sideOpen}>{if sideOpen { "<" } else { ">" }}</button>
                <p class="note">Inventory filters</p>
            </div>
            <div class="list">
                {#each 0..4 as g}
                    <div class="group">
                        <div class="shead">{GROUPS[g]}</div>
                        {#each 0..7 as r}
                            <div class="line">{GROUPS[g]} item {r + 1}</div>
                        {/each}
                    </div>
                {/each}
            </div>
        </div>
    </kit.Section>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; }
    .space { position: relative; height: 330px; background: var(--bg); border-radius: 6px; overflow: hidden; }
    .win { position: absolute; display: flex; flex-direction: column; width: 230px; background: var(--panel); border: 1px solid var(--accent); border-radius: 8px; overflow: hidden; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45); min-width: 120px; min-height: 60px; }
    .a { left: 14px; top: 14px; height: 130px; }
    .b { left: 300px; top: 40px; width: 200px; height: 170px; }
    .c { left: 540px; top: 150px; width: 220px; height: 110px; }
    .bar { display: flex; justify-content: space-between; align-items: center; padding: 4px 6px 4px 10px; background: var(--raised); }
    .title { color: var(--text); }
    .mini { padding: 0 8px; border-radius: 6px; }
    .body { flex: 1; min-height: 0; overflow-x: hidden; overflow-y: auto; padding: 8px 10px; color: var(--muted); }
    .grip { position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; background: var(--accent); opacity: 0.55; border-radius: 8px 0 0 0; }
    .swatches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .sw { height: 28px; border-radius: 4px; }
    .s0 { background: #f38ba8; }
    .s1 { background: #a6e3a1; }
    .s2 { background: #89b4fa; }
    .s3 { background: #f9e2af; }
    .split { display: flex; gap: 8px; height: 220px; }
    .side { width: 200px; padding: 8px; overflow: hidden; white-space: nowrap; background: var(--bg); border-radius: 6px; transition: width 180ms ease; }
    .side.shut { width: 44px; }
    .note { color: var(--muted); margin-top: 8px; }
    .list { flex: 1; min-width: 0; overflow-x: hidden; overflow-y: auto; background: var(--bg); border-radius: 6px; }
    .shead { position: sticky; top: 0; z-index: 2; padding: 6px 12px; background: var(--raised); color: var(--accent); }
    .line { padding: 6px 12px; border-bottom: 1px solid var(--line); }
</style>
