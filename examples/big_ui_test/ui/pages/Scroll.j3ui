<!-- Scrolling: both axes, scrollbars (overlay, draggable, styled), wheel inertia, nesting. -->

<script>
    let rows: int = 3000;
</script>

<div class="col">
    <div class="pair">
        <kit.Section note="overflow-y: auto, {rows} rows, scroll-behavior: smooth (wheel inertia), drag the thumb">
            <div class="list smooth">
                {#each 0..rows as i}
                    <div class="item">Row {i}</div>
                {/each}
            </div>
        </kit.Section>
        <kit.Section note="overflow-x: auto (Shift + wheel), scrollbar-width: thin">
            <div class="strip">
                {#each 0..14 as i}
                    <div class="card">Card {i}</div>
                {/each}
            </div>
            <small>overflow: auto both axes, styled: scrollbar-color</small>
            <div class="both">
                <div class="canvas">
                    <div class="tl">top left</div>
                    <div class="br">bottom right</div>
                </div>
            </div>
        </kit.Section>
    </div>
    <kit.Section note="Nested boxes: the wheel scrolls the inner list until its end, then the outer one. The right one has overscroll-behavior: contain.">
        <div class="pair">
            <div class="outer">
                <div class="head">outer</div>
                <div class="inner">
                    {#each 0..24 as i}
                        <div class="item">inner {i}</div>
                    {/each}
                </div>
                {#each 0..12 as j}
                    <div class="item dim">outer {j}</div>
                {/each}
            </div>
            <div class="outer">
                <div class="head">outer</div>
                <div class="inner contain">
                    {#each 0..24 as i}
                        <div class="item">inner {i}</div>
                    {/each}
                </div>
                {#each 0..12 as j}
                    <div class="item dim">outer {j}</div>
                {/each}
            </div>
        </div>
    </kit.Section>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; }
    .pair { display: flex; gap: 12px; }
    .pair > * { flex: 1; min-width: 0; }
    .list { height: 260px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
    .smooth { scroll-behavior: smooth; }
    .item { padding: 8px 12px; background: var(--raised); border-radius: 6px; }
    .dim { background: #2a2b3c; margin-top: 4px; }
    .strip { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: thin; padding-bottom: 10px; }
    .card { min-width: 130px; padding: 18px 12px; background: var(--raised); border-radius: 8px; }
    .both { height: 130px; overflow: auto; scrollbar-color: #f9e2af #2b2b3c; border-radius: 8px; background: #181825; }
    .canvas { position: relative; width: 640px; height: 320px; background: linear-gradient(135deg, #313244, #45475a); }
    .tl { position: absolute; left: 10px; top: 10px; }
    .br { position: absolute; right: 10px; bottom: 10px; }
    .outer { height: 200px; overflow-y: auto; background: #181825; border-radius: 8px; padding: 6px; }
    .head { color: var(--accent); padding: 4px 8px; }
    .inner { height: 110px; overflow-y: auto; background: var(--panel); border-radius: 6px; padding: 4px; }
    .contain { overscroll-behavior: contain; }
</style>
