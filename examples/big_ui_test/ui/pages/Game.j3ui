<!-- Game components: bars, cooldowns, inventory with tooltips, damage numbers, quest toasts, dialogue, minimap, nameplates.
     All of them are compositions of the CSS/markup features on the earlier pages, over plain state in src/gamedemo.j3. -->

<script>
    use big_ui_test.gamedemo.{ Demo, shared };

    let demo: &Demo = shared();
    provide demo;

    fn onFrame(dt: f32) {
        demo.step();
    }
</script>

<div class="page">
    <kit.Section note="Scene: HUD bars (ghost trail on damage, pulse under 25%), cooldown sweeps, minimap, world-space nameplates with off-screen culling, floating damage numbers (pool of 24)">
        <div class="row">
            <div class="arena">
                <game.World />
                <game.Hud />
                <div class="mini"><game.Minimap /></div>
            </div>
            <game.Controls />
        </div>
    </kit.Section>
    <kit.Section note="Inventory: 100 cells, rarity borders, hover cards; click a cell then another to swap">
        <div class="inv"><game.Inventory /></div>
    </kit.Section>
    <kit.Section note="Dialogue: typewriter, whisper and shout effects, click to skip, answers on the last line">
        <game.Dialogue />
    </kit.Section>
    <game.QuestToast />
</div>

<style>
    .page { display: flex; flex-direction: column; gap: 12px; }
    .row { gap: 14px; }
    .arena { position: relative; width: 560px; height: 330px; overflow: hidden; border-radius: 10px; border: 1px solid #45475a; }
    .mini { position: absolute; right: 12px; top: 12px; }
    .inv { height: 240px; overflow-x: hidden; overflow-y: auto; border-radius: 10px; }
</style>
