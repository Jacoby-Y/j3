<!-- Overlays: modal dialog, popover, tooltips, hover card, drawer, toasts, context menu, nested menus. -->

<script>
    use j3.game.frameCount;
    use j3.ui.toast.Toasts;

    let modal: bool = false;
    let pop: bool = false;
    let drawer: bool = false;
    let ctx: bool = false;
    let ctxX: f32 = 0.0;
    let ctxY: f32 = 0.0;
    let file: bool = false;
    let toasts: Toasts = Toasts.new();
    let name: string = "";
    let last: string = "";

    fn now(): f32 {
        return f32(frameCount()) * 16.6667;
    }

    fn toast(msg: string, kind: int) {
        toasts.push(msg, kind, 4000.0, now());
    }

    fn onFrame(dt: f32) {
        toasts.tick(now());
    }
</script>

<div class="col">
    <kit.Section note="Modal dialog (Escape or the dim closes it, Tab stays inside), popover (light dismiss), tooltips (rest the pointer on a button)">
        <div class="row">
            <button on:click={modal = true} title="Open a modal dialog">Open modal</button>
            <div class="anchor">
                <button on:click={pop = !pop} title="A popover opens below its button">Popover</button>
                {#if pop}
                    <div class="menu" popover on:close={pop = false} transition:fade={120}>
                        <div class="entry" menuitem on:click={pop = false}>Profile</div>
                        <div class="entry" menuitem on:click={pop = false}>Settings</div>
                        <div class="entry" menuitem on:click={pop = false}>Sign out</div>
                    </div>
                {/if}
            </div>
            <button title="Tooltips wait half a second">Hover me</button>
            <div class="user">
                hover card
                <div class="hcard">
                    <div class="avatar"></div>
                    <div>Ada Lovelace</div>
                    <small>First programmer. Pure CSS: .user:hover &gt; .hcard</small>
                </div>
            </div>
        </div>
    </kit.Section>
    <kit.Section note="Drawer (position: fixed, left transition) and toasts (j3.ui.toast, CSS keyframes)">
        <div class="row">
            <button on:click={drawer = true}>Open drawer</button>
            <button on:click={toast("Saved your game", 1)}>Success toast</button>
            <button on:click={toast("Something happened", 0)}>Info toast</button>
            <button on:click={toast("Could not connect", 2)}>Error toast</button>
        </div>
    </kit.Section>
    <kit.Section note="Context menu (right click the box) and a nested dropdown (flips at the window edge)">
        <div class="row">
            <!-- before the handler, so a right click while it is open moves it: the press closes it, then the request reopens it -->
            {#if ctx}
                <div class="menu ctx" popover left={ctxX} top={ctxY} on:close={ctx = false}>
                    <div class="entry" menuitem on:click={ctx = false; last = "Cut"}>Cut</div>
                    <div class="entry" menuitem on:click={ctx = false; last = "Copy"}>Copy</div>
                    <div class="entry" menuitem on:click={ctx = false; last = "Paste"}>Paste</div>
                </div>
            {/if}

            <div class="pad" on:contextmenu={ctx = true; ctxX = mouse.x; ctxY = mouse.y}>right click here</div>
            <div class="anchor">
                <button on:click={file = !file}>File</button>
                {#if file}
                    <div class="menu" popover on:close={file = false}>
                        <div class="entry" menuitem>New</div>
                        <div class="entry sub-host" menuitem>
                            Open recent &gt;
                            <div class="menu sub">
                                <div class="entry" menuitem on:click={file = false}>level1.j3scene</div>
                                <div class="entry" menuitem on:click={file = false}>level2.j3scene</div>
                                <div class="entry sub-host" menuitem>
                                    More &gt;
                                    <div class="menu sub">
                                        <div class="entry" menuitem on:click={file = false}>old.j3scene</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="entry" menuitem on:click={file = false}>Quit</div>
                    </div>
                {/if}
            </div>
            <small>{last}</small>
        </div>
    </kit.Section>

    {#if modal}
        <dialog modal on:close={modal = false} transition:fade={150}>
            <h2>Rename the hero</h2>
            <input type="text" bind:value={name} placeholder="name" />
            <div class="row end">
                <button on:click={modal = false}>Cancel</button>
                <button class="primary" on:click={modal = false; last = name}>OK</button>
            </div>
        </dialog>
    {/if}

    <div class="scrim" class:on={drawer} on:click={drawer = false}></div>
    <aside class="drawer" class:open={drawer}>
        <h2>Drawer</h2>
        <small>Slides in with a transition on left.</small>
        <button on:click={drawer = false}>Close</button>
    </aside>

    <div class="toasts">
        {#each 0..6 as i}
            {#if toasts.live(i)}
                <div class="toast" class:ok={toasts.kind(i) == 1} class:bad={toasts.kind(i) == 2} transition:fade={250} on:click={toasts.dismiss(i)}>{toasts.text(i)}</div>
            {/if}
        {/each}
    </div>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; }
    .row { align-items: center; }
    .end { justify-content: flex-end; }
    .anchor { position: relative; }
    .menu { position: absolute; left: 0; top: 100%; z-index: 50; min-width: 160px; padding: 4px; background: #252636; border: 1px solid #45475a; border-radius: 8px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5); }
    .entry { position: relative; padding: 7px 12px; border-radius: 5px; }
    .entry:hover, .entry:focus { background: var(--hover); }
    .ctx { position: fixed; position-try-fallbacks: flip-both; }
    .sub { display: none; left: 100%; top: 0; position-try-fallbacks: flip-inline; }
    .sub-host:hover > .sub { display: block; }
    .pad { flex: 1; padding: 28px 24px; background: #181825; border: 1px dashed #585b70; border-radius: 8px; color: var(--muted); }
    .user { position: relative; padding: 8px 12px; background: var(--raised); border-radius: 8px; }
    .hcard { display: none; position: absolute; left: 0; top: 100%; z-index: 40; width: 220px; padding: 12px; background: #252636; border: 1px solid #45475a; border-radius: 10px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5); animation: rise 160ms ease-out; }
    .user:hover > .hcard { display: block; }
    .avatar { width: 36px; height: 36px; border-radius: 18px; background: linear-gradient(135deg, #89b4fa, #cba6f7); margin-bottom: 8px; }
    @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    dialog { width: 340px; padding: 20px; display: flex; flex-direction: column; gap: 14px; background: var(--panel); border: 1px solid #45475a; border-radius: 12px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6); backdrop-color: rgba(8, 8, 14, 0.62); }
    dialog input { padding: 8px 10px; background: #11111b; border: 1px solid #45475a; border-radius: 6px; color: #cdd6f4; }
    .primary { background: #89b4fa; color: #11111b; }

    .scrim { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 60; background: rgba(0, 0, 0, 0.5); opacity: 0; pointer-events: none; transition: opacity 220ms; }
    .scrim.on { opacity: 1; pointer-events: auto; }
    .drawer { position: fixed; top: 0; bottom: 0; left: -340px; width: 320px; z-index: 61; padding: 24px 20px; display: flex; flex-direction: column; gap: 12px; background: var(--panel); border-right: 1px solid #45475a; transition: left 260ms ease-out; }
    .drawer.open { left: 0; }

    .toasts { position: fixed; right: 18px; bottom: 18px; z-index: 1100; display: flex; flex-direction: column; gap: 8px; width: 260px; }
    .toast { padding: 10px 14px; background: #252636; border-left: 4px solid var(--accent); border-radius: 8px; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5); animation: slide 240ms ease-out; }
    .toast.ok { border-left-color: #a6e3a1; }
    .toast.bad { border-left-color: #f38ba8; }
    @keyframes slide { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
</style>
