<script>
    use j3.game.micros;
    use j3.gfx.paint;
    use j3.game.rgb;

    let sel = 0;
    let sw = false;
    let tab = 0;
    let menu = false;
    let picked = 0;
    let modal = false;
    let toast = false;
    let fold = true;

    const OPTS: [3]string = ["Easy", "Normal", "Hard"];

    fn bar(size: Vec2) {
        let t = f32(micros() % 3000000) / 3000000.0;
        paint.roundRect(Vec2 { x: 0.0, y: 0.0 }, size, 6.0, rgb(49, 50, 68));
        paint.roundRect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: size.x * t, y: size.y }, 6.0, rgb(166, 227, 161));
    }
</script>

<div class="col">
    <kit.Section note="Radio + toggle switch">
        <div class="row">
            {#each 0..3 as i}
                <div class="radio" on:click={sel = i}>
                    <div class="dot" class:on={sel == i}></div><span>{OPTS[i]}</span>
                </div>
            {/each}
        </div>
        <div class="row">
            <div class="track" class:on={sw} on:click={sw = !sw}><div class="knob" class:on={sw}></div></div>
            <span>{sw}</span>
        </div>
    </kit.Section>
    <kit.Section note="Dropdown, modal, toast, accordion">
        <div class="row">
            <div class="drop">
                <button on:click={menu = !menu}>{OPTS[picked]} v</button>
                {#if menu}
                    <div class="menu" transition:fade={120}>
                        {#each 0..3 as i}
                            <div class="mi" on:click={picked = i; menu = false}>{OPTS[i]}</div>
                        {/each}
                    </div>
                {/if}
            </div>
            <button on:click={modal = true}>Open modal</button>
            <button on:click={toast = !toast}>Toast</button>
            <button on:click={fold = !fold}>Fold</button>
        </div>
        {#if fold}<p class="fold">Accordion body</p>{/if}
        <div class="host">hover for tooltip<div class="tip">Tooltip text</div></div>
    </kit.Section>
    <kit.Section note="Progress">
        <canvas class="bar" on:draw={bar(size)}></canvas>
    </kit.Section>
    <kit.Section note="Tabs + breadcrumb">
        <div class="row crumbs"><span class="dim">Home</span><span>›</span><span class="dim">Settings</span><span>›</span><span>Audio</span></div>
        <div class="row">
            {#each 0..3 as i}
                <div class="tab" class:on={tab == i} on:click={tab = i}>Tab {i}</div>
            {/each}
        </div>
        <p>Content of tab {tab}</p>
    </kit.Section>
    {#if modal}
        <div class="scrim" transition:fade={150} on:click={modal = false}>
            <div class="dialog">Modal. Click anywhere to close.</div>
        </div>
    {/if}
    {#if toast}
        <div class="toast" transition:fade={200} on:click={toast = false}>Saved!</div>
    {/if}
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; position: relative; }
    .row { gap: 10px; align-items: center; }
    .dim { color: var(--muted); }
    .radio { display: flex; gap: 6px; align-items: center; }
    .dot { width: 16px; height: 16px; border-radius: 999px; border: 2px solid var(--accent); }
    .dot.on { background: var(--accent); }
    .track { width: 44px; height: 24px; border-radius: 999px; background: var(--raised); transition: background 150ms; }
    .track.on { background: var(--accent); }
    .knob { width: 20px; height: 20px; margin: 2px; border-radius: 999px; background: var(--text); }
    .knob.on { margin-left: 22px; }
    .bar { width: 300px; height: 14px; }
    .tab { padding: 6px 14px; border-radius: 6px; color: var(--muted); }
    .tab.on { background: var(--raised); color: var(--text); border-bottom: 2px solid var(--accent); }
    .drop { position: relative; }
    .menu { position: absolute; z-index: 10; left: 0; top: 36px; width: 120px; background: var(--raised); border-radius: 8px; padding: 4px; }
    .mi { padding: 6px 10px; border-radius: 6px; }
    .mi:hover { background: var(--hover); }
    .fold { padding: 8px; background: var(--raised); border-radius: 6px; }
    .host { position: relative; width: 140px; padding: 6px 0; color: var(--muted); }
    .tip { display: none; position: absolute; left: 0; top: 30px; padding: 6px 10px; background: var(--accent); color: var(--bg); border-radius: 6px; }
    .host:hover .tip { display: block; }
    .scrim { position: absolute; z-index: 20; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.6); display: flex; justify-content: center; align-items: center; }
    .dialog { padding: 24px 32px; background: var(--panel); border-radius: 12px; border: 1px solid var(--accent); }
    .toast { position: absolute; z-index: 20; right: 10px; top: 10px; padding: 10px 16px; background: #a6e3a1; color: var(--bg); border-radius: 8px; }
</style>
