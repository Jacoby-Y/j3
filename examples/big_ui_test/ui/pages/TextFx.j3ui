<!-- Text shadows, glow, outline, gradient fill, and animated text. -->

<script>
    use j3.game.frameCount;
    use j3.ui.textanim;

    fn msg(): string {
        return "The quick brown fox jumps over the lazy dog.";
    }

    fn sentence(): string {
        return "Words appear one after another until the whole sentence is there.";
    }

    fn clock(): f32 {
        return f32(frameCount()) / 60.0;
    }

    fn typed(): string {
        return textanim.typewriter(msg(), textanim.cycle(clock(), 2.6, 1.5), 18.0);
    }

    fn caret(): string {
        if textanim.blink(clock(), 2.0) {
            return "|";
        }
        return " ";
    }

    fn revealed(): string {
        return textanim.words(sentence(), textanim.cycle(clock(), 4.0, 1.5), 3.0);
    }
</script>

<div class="cols">
    <div class="col">
        <kit.Section note="text-shadow: hard, soft, layered">
            <div class="row">
                <span class="big hard">Hard</span>
                <span class="big soft">Soft</span>
                <span class="big layered">Layered</span>
            </div>
        </kit.Section>
        <kit.Section note="Glow (zero-offset shadow with blur)">
            <div class="row">
                <span class="big neon">NEON</span>
                <span class="big fire">Fire</span>
            </div>
        </kit.Section>
        <kit.Section note="Outline: -webkit-text-stroke">
            <div class="row">
                <span class="big outline">Outlined</span>
                <span class="big outline2">Thick</span>
            </div>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="Gradient text: background-clip: text">
            <p class="big rainbow">Rainbow gradient</p>
            <p class="big sunset">Sunset, top to bottom</p>
            <p class="big glowgrad">Gradient + glow</p>
        </kit.Section>
        <kit.Section note="Animated text: typewriter and word reveal">
            <p class="line">{typed()}<span class="accent">{caret()}</span></p>
            <p class="line dim">{revealed()}</p>
        </kit.Section>
    </div>
</div>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .row { gap: 22px; align-items: baseline; }
    .big { font-size: 30px; font-weight: bold; }
    .hard { color: #f9e2af; text-shadow: 3px 3px 0 #f38ba8; }
    .soft { color: #cdd6f4; text-shadow: 0 3px 5px rgba(0, 0, 0, 0.9); }
    .layered { color: #a6e3a1; text-shadow: 1px 1px 0 #40a02b, 2px 2px 0 #40a02b, 3px 3px 0 #40a02b, 4px 4px 0 #1e6620; }
    .neon { color: #e0f0ff; text-shadow: 0 0 6px #89b4fa, 0 0 14px #89b4fa; }
    .fire { color: #fff4cc; text-shadow: 0 0 5px #f9e2af, 0 0 12px #fab387, 0 0 22px #f38ba8; }
    .outline { color: #ffffff; -webkit-text-stroke: 2px #1e66f5; }
    .outline2 { color: #f9e2af; -webkit-text-stroke: 4px #cba6f7; }
    .rainbow { background: linear-gradient(90deg, #f38ba8, #f9e2af, #a6e3a1, #89b4fa, #cba6f7); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .sunset { background: linear-gradient(180deg, #f9e2af, #fab387 50%, #f38ba8); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .glowgrad { background: linear-gradient(90deg, #89b4fa, #cba6f7); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 10px #89b4fa; }
    .line { font-size: 16px; line-height: 22px; }
    .dim { color: var(--muted); }
    .accent { color: var(--accent); }
</style>
