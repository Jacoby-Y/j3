<!-- Immediate drawing inside a layout box: 0,0 is the canvas corner. -->

<script>
    use j3.game.{ micros, rgb };
    use j3.gfx.paint;

    fn draw(size: Vec2) {
        let t = f32(micros() % 4000000) / 4000000.0;
        paint.rect(Vec2 { x: 0.0, y: 0.0 }, size, rgb(49, 50, 68));
        paint.line(Vec2 { x: 0.0, y: size.y }, Vec2 { x: size.x * t, y: 0.0 }, 3.0, rgb(250, 179, 135));
        paint.roundRect(Vec2 { x: (size.x - 40.0) * t, y: size.y * 0.5 - 20.0 }, Vec2 { x: 40.0, y: 40.0 }, 8.0, rgb(137, 180, 250));
        paint.circle(Vec2 { x: size.x * 0.5, y: size.y * 0.75 }, 24.0 + 12.0 * t, rgb(166, 227, 161));
    }
</script>

<div class="wrap">
    <canvas class="view" on:draw={draw(size)}>
        <div class="hud">HUD over the canvas</div>
    </canvas>
</div>

<style>
    .wrap { display: flex; height: 300px; }
    .view { flex: 1; position: relative; }
    .hud { position: absolute; left: 10px; top: 10px; padding: 4px 8px; background: rgba(17, 17, 27, 0.7); border-radius: 6px; }
</style>
