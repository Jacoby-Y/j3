<!-- Images and shapes: <img>, background-image, nine-slice border-image, sprite sheets, clip-path, mask-image, <svg>. -->

<script>
    let frame: int = 0;
</script>

<div class="col">
    <kit.Section note="PNG and JPEG: natural size, scaled by width (height follows), fixed box with object-fit">
        <div class="row">
            <div class="cell"><img src="assets/img/photo.png" /><div class="cap">png, natural 192x128</div></div>
            <div class="cell"><img class="w120" src="assets/img/photo.jpg" /><div class="cap">jpg, width: 120px</div></div>
            <div class="cell"><img class="box fill" src="assets/img/photo.png" /><div class="cap">fill</div></div>
            <div class="cell"><img class="box contain" src="assets/img/photo.png" /><div class="cap">contain</div></div>
            <div class="cell"><img class="box cover" src="assets/img/photo.png" /><div class="cap">cover</div></div>
            <div class="cell"><img class="box none" src="assets/img/photo.png" /><div class="cap">none</div></div>
        </div>
    </kit.Section>
    <kit.Section note="Cropping: object-position on a cover image, background-position and size on a div, rounded corners">
        <div class="row">
            <div class="cell"><img class="box cover left" src="assets/img/photo.png" /><div class="cap">cover, left</div></div>
            <div class="cell"><img class="box cover right" src="assets/img/photo.png" /><div class="cap">cover, right</div></div>
            <div class="cell"><div class="crop"></div><div class="cap">bg crop: 2x, -150px -90px</div></div>
            <div class="cell"><img class="box cover round" src="assets/img/photo.png" /><div class="cap">border-radius 20px</div></div>
            <div class="cell"><img class="avatar" src="assets/img/photo.png" /><div class="cap">circle avatar</div></div>
            <div class="cell"><img class="box cover turn" src="assets/img/photo.png" /><div class="cap">rotate + opacity</div></div>
        </div>
    </kit.Section>
    <kit.Section note="Tint: image-tint multiplies a white icon (hover the last one; the tint transitions)">
        <div class="row">
            <div class="cell"><img class="icon" src="assets/img/icon.png" /><div class="cap">none</div></div>
            <div class="cell"><img class="icon t1" src="assets/img/icon.png" /><div class="cap">#f38ba8</div></div>
            <div class="cell"><img class="icon t2" src="assets/img/icon.png" /><div class="cap">#a6e3a1</div></div>
            <div class="cell"><img class="icon t3" src="assets/img/icon.png" /><div class="cap">#89b4fa</div></div>
            <div class="cell"><img class="box cover t4" src="assets/img/photo.png" /><div class="cap">tinted photo</div></div>
            <div class="cell hov"><img class="icon t5" src="assets/img/icon.png" /><div class="cap">hover me</div></div>
        </div>
    </kit.Section>
    <kit.Section note="Nine-slice: one 48x48 frame (12 px corners) stretched to three sizes; sprite sheet 4x2 frames">
        <div class="row">
            <div class="nine n1">small</div>
            <div class="nine n2">A wide panel with text. Corners keep their size, the edges stretch.</div>
            <div class="nine n3">tall</div>
            <div class="cell"><img class="sprite" src="assets/img/sheet.png" sprite="4,2" fps="8" /><div class="cap">8 fps</div></div>
            <div class="cell"><img class="sprite" src="assets/img/sheet.png" sprite="4,2" fps="2" /><div class="cap">2 fps</div></div>
            <div class="cell"><img class="sprite" src="assets/img/sheet.png" sprite="4,2" frame={frame} /><div class="cap">frame {frame}</div></div>
            <button on:click={frame = (frame + 1) % 8}>next</button>
        </div>
        <div class="row">
            {#each 0..8 as i}
                <img class="mini" src="assets/img/sheet.png" sprite="4,2" frame={i} />
            {/each}
            <div class="sheetbg"></div>
        </div>
    </kit.Section>
    <kit.Section note="background-image: url(): repeat, repeat-x, no-repeat centered, cover (a tinted overlay on the last)">
        <div class="row">
            <div class="bg b-rep"></div><div class="bg b-x"></div><div class="bg b-one"></div><div class="bg b-cover"></div><div class="bg b-round"></div>
        </div>
    </kit.Section>
    <kit.Section note="clip-path: circle, ellipse, inset round, polygon (star, triangle, even-odd pentagram), and mask-image fades">
        <div class="row">
            <div class="clip c-circle"></div><div class="clip c-ellipse"></div><div class="clip c-inset"></div>
            <div class="clip c-star"></div><div class="clip c-tri"></div><div class="clip c-eo"></div>
            <div class="clip m-lin"></div><div class="clip m-rad"></div>
        </div>
    </kit.Section>
    <kit.Section note="SVG: path data M L H V Q T C S Z (and relative), fill and stroke, currentColor, a hole by winding, scaled by CSS">
        <div class="row svgs">
            <svg class="s48 red" viewBox="0 0 24 24"><path d="M12 21 C4 14 2 9 2 6 C2 3 5 2 7 2 C9 2 11 3 12 5 C13 3 15 2 17 2 C19 2 22 3 22 6 C22 9 20 14 12 21 Z" fill="currentColor" /></svg>
            <svg class="s48 gold" viewBox="0 0 24 24"><path d="M12 2 L15 9 L22 9.5 L16.5 14 L18.5 21 L12 17 L5.5 21 L7.5 14 L2 9.5 L9 9 Z" fill="#f9e2af" stroke="#fab387" stroke-width="1.2" /></svg>
            <svg class="s48 green" viewBox="0 0 24 24"><path d="M4 12 L10 18 L20 6" fill="none" stroke="currentColor" stroke-width="3" /></svg>
            <svg class="s48 blue" viewBox="0 0 24 24"><path d="M12 2 C18 2 22 6 22 12 C22 18 18 22 12 22 C6 22 2 18 2 12 C2 6 6 2 12 2 Z M12 7 C9 7 7 9 7 12 C7 15 9 17 12 17 C15 17 17 15 17 12 C17 9 15 7 12 7 Z" fill="currentColor" /></svg>
            <svg class="s48 mauve" viewBox="0 0 24 24"><path d="M3 11 L12 3 L21 11 V21 H15 V14 H9 V21 H3 Z" fill="#cba6f7" /></svg>
            <svg class="s48 peach" viewBox="0 0 24 24"><path d="M2 12 Q 7 2 12 12 T 22 12" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <svg class="s48 teal" viewBox="0 0 24 24"><path d="m4 4 h16 v16 h-16 z M8 8 l8 8 m0 -8 l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            <svg class="s96 red" viewBox="0 0 24 24"><path d="M12 21 C4 14 2 9 2 6 C2 3 5 2 7 2 C9 2 11 3 12 5 C13 3 15 2 17 2 C19 2 22 3 22 6 C22 9 20 14 12 21 Z" fill="currentColor" stroke="#f9e2af" stroke-width="1" /></svg>
            <svg class="wide" viewBox="0 0 100 24"><path d="M0 12 C15 0 25 24 40 12 S 65 0 80 12 S 95 20 100 12" fill="none" stroke="#89dceb" stroke-width="2" /></svg>
        </div>
        <svg class="complex-svg" viewBox="0 0 512 512"><path d="M62.522 17.166c-.412-.005-.826 0-1.243.012l-.003-.002c-9.747.288-20.823 5.23-29.843 14.25C16.242 46.62 12.596 67.62 23.31 78.334c7.99 7.988 21.715 8.026 34.47 1.22 16.166 30.05 42.153 57.687 71.437 76.374-18.77 24.156-29.97 54.48-29.97 87.375h18.69c0-28.9 9.826-55.474 26.342-76.53l2.156 39.405c2.91 2.622 5.82 5.224 8.732 7.832 4.356-12.66 10.49-24.082 18.785-33.344l13.057-14.578 2.568 19.4c3.6 27.192 6.476 50.554 9.908 67.99 15.483 13.69 30.924 27.27 46.223 40.555 5.405-2.125 11.38-3.683 17.63-5.1 18.31-4.148 40.412-6.538 60.058-9.835-37.685-43.742-77.43-88.55-117.246-132.668l-38.968-2.125c20.764-15.68 46.636-24.966 74.718-24.97v-18.69c-32.2.003-61.944 10.726-85.843 28.78-18.697-29.382-46.39-55.48-76.53-71.685 6.794-12.748 6.796-26.422-1.188-34.406-4.08-4.08-9.646-6.094-15.82-6.168zm319.773 2.682-51.34 54.99 27.06 85.992L419.642 176l16.407-49.58-45.104-23.934-8.447 23.213 15.62 9.597 2.673-11.535 14.618 7.54-5.765 27.046-49.16-27.498L384 78l43.107 24.766 17.795-57.682-62.607-25.236zM203.79 32.305c-23.41 22.86-38.652 47.65-46.438 71.302.95 1.23 1.894 2.47 2.818 3.72 19.074-11.54 40.616-18.787 62.72-21.53-8.528-18.76-16.008-37.234-19.1-53.492zm139.29 3.027c-2.256.45-43.49 8.084-53.945 9.863l-13.783 97.078 75.595 85.483 116.612-14.272 24.63-100.953-44.635-18.63-4.655 15.092 12.768 8.856-26.49 79.732-85.477-21.86-31.407-99.814 30.787-40.574zm-99.756 99.93c-8.035.007-15.983.746-23.94 2.43a9462.44 9462.44 0 0 1 40.825 45.27c-.502-13.06-6.45-29.622-14.358-47.657-.843-.015-1.687-.044-2.528-.043zm49.067 53.3a233.982 233.982 0 0 0-15.814 12.737 6065.473 6065.473 0 0 1 40.684 46.173c13-2.56 26.228-6.366 38.982-11.928-21.436-4.717-51.77-8.685-60.724-26.168a234.736 234.736 0 0 1 9.285-6.922c-2.27-2.522-2.445-2.703-4.967-5.52-2.645-2.954-4.985-5.603-7.445-8.374zm-117.267 24.686c-7.373 17.72-11.074 40.45-10.783 63.322.422 33.24 5.29 63.63 16.855 79.524-18.443 39.608-40.69 81.563-69.343 102.687h-.004c-26.502 18.904-51.61 14.405-63.866.624-6.127-6.89-9.442-16.274-7.98-28.258 1.45-11.88 7.926-26.43 22.246-42.21 11.966-10.248 21.69-14.276 28.156-14.954 6.552-.687 9.854 1.214 12.336 4.327 4.963 6.226 5.048 20.812-7.48 31.327l12.013 14.316c19.1-16.03 22.676-41.487 10.082-57.29-6.297-7.9-17.036-12.51-28.9-11.268-11.865 1.245-24.787 7.553-38.885 19.76l-.41.357-.365.4c-16.57 18.11-25.296 36.22-27.34 52.973-2.045 16.753 2.874 32.043 12.564 42.94 19.38 21.79 56.224 25.322 88.68 2.175l.003-.002a160.698 160.698 0 0 0 16.992-13.967c29.887-7.726 58.962-10.74 92.3-37.436-21.193.977-40.373-1.7-53.542-15.13 13.405-25.285 23.347-52.815 34.78-79.87 4.153-9.833 8.482-19.624 13.212-29.285a8956.346 8956.346 0 0 1-13.22-11.605 47.82 47.82 0 0 1-1.582-.322l-5.325 15.978c-7.244-2.413-12.01-8.344-15.4-15.106-3.39-6.763-5.785-14.94-7.92-24.63-2.96-13.43-5.385-30.65-7.875-49.376zm192.2 78.113a169.12 169.12 0 0 1-3.15 10.75 3912.925 3912.925 0 0 1 38.073 45.722c15.284-8.49 29.937-19.356 42.938-32.674-23-3.926-50.907-14.148-77.862-23.797zm-19.044 1.066c-26.425 7.104-58.293 8.925-80.964 14.062-13.756 3.117-23.042 7.92-25.418 11.51-1.187 1.795-1.65 3.264-.867 6.848.784 3.583 3.327 9.055 8.585 16.04l.004.005.003.007c15.597 20.782 35.098 23.19 55.207 12.3 17.34-9.387 34.29-30.29 43.45-60.77zm9.195 26.633c-8.447 18.075-19.744 32.47-32.63 42.465 62.56 52.325 120.89 98.433 169.995 133.31-34.996-50.882-83.143-111.51-137.365-175.776z" fill="white" /></svg>
    </kit.Section>
    <kit.Section note="<icon name>: Bootstrap Icons ids, 1em and currentColor by default; fill-rule evenodd holes (circle-half, record-circle, bullseye); a computed name">
        <div class="row svgs icons">
            <icon name="trash" />
            <icon name="gear-fill" class="blue" />
            <icon name="heart-fill" class="red" />
            <icon name="circle-half" class="gold" />
            <icon name="record-circle" class="green" />
            <icon name="bullseye" class="mauve" />
            <icon name="align-top" />
            <icon name={if frame % 2 == 0 { "volume-up-fill" } else { "volume-mute-fill" }} class="s48 peach" />
            <button><icon name="floppy" /> Save</button>
            <svg class="s48 teal" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M2 2 H22 V22 H2 Z M7 7 H17 V17 H7 Z" fill="currentColor" /></svg>
        </div>
    </kit.Section>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; }
    .row { align-items: flex-start; }
    .cell { display: flex; flex-direction: column; gap: 4px; align-items: center; }
    .cap { color: var(--muted); font-size: 11px; }
    .w120 { width: 120px; }
    .box { width: 100px; height: 80px; background: #181825; }
    .fill { object-fit: fill; }
    .contain { object-fit: contain; }
    .cover { object-fit: cover; }
    .none { object-fit: none; }
    .left { object-position: left; }
    .right { object-position: right; }
    .crop { width: 100px; height: 80px; background-image: url("assets/img/photo.png"); background-size: 384px 256px; background-position: -150px -90px; background-repeat: no-repeat; }
    .round { border-radius: 20px; }
    .avatar { width: 80px; height: 80px; border-radius: 40px; object-fit: cover; }
    .turn { transform: rotate(-8deg); opacity: 0.8; }
    .icon { width: 48px; height: 48px; }
    .t1 { image-tint: #f38ba8; }
    .t2 { image-tint: #a6e3a1; }
    .t3 { image-tint: #89b4fa; }
    .t4 { image-tint: #cba6f7; }
    .t5 { image-tint: #7f849c; transition: image-tint 250ms ease; }
    .hov:hover > .t5 { image-tint: #f9e2af; }
    .nine { border: 12px solid transparent; border-image: url("assets/img/frame.png") 12 fill / 12px; padding: 4px; color: var(--text); font-size: 12px; }
    .n1 { width: 72px; height: 48px; }
    .n2 { width: 190px; height: 70px; }
    .n3 { width: 56px; height: 110px; }
    .sprite { width: 64px; height: 64px; }
    .mini { width: 32px; height: 32px; }
    .sheetbg { width: 128px; height: 64px; background-image: url("assets/img/sheet.png"); background-repeat: no-repeat; }
    .bg { width: 110px; height: 80px; background: #181825; border-radius: 6px; }
    .b-rep { background-image: url("assets/img/tile.png"); }
    .b-x { background-image: url("assets/img/tile.png"); background-repeat: repeat-x; background-position: 0 10px; }
    .b-one { background-image: url("assets/img/icon.png"); background-repeat: no-repeat; background-position: center; image-tint: #f9e2af; }
    .b-cover { background-image: url("assets/img/photo.jpg"); background-size: cover; background-repeat: no-repeat; }
    .b-round { background-image: url("assets/img/tile.png"); border-radius: 30px; border: 3px solid #89b4fa; }
    .clip { width: 96px; height: 80px; background-image: url("assets/img/photo.png"); background-size: cover; background-position: center; background-repeat: no-repeat; }
    .c-circle { clip-path: circle(40px at 50% 50%); }
    .c-ellipse { clip-path: ellipse(48px 32px at 50% 50%); }
    .c-inset { clip-path: inset(6px 10px round 18px); }
    .c-star { clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .c-tri { clip-path: polygon(50% 0%, 100% 100%, 0% 100%); }
    .c-eo { clip-path: polygon(evenodd, 50% 0%, 79% 100%, 2% 38%, 98% 38%, 21% 100%); }
    .m-lin { mask-image: linear-gradient(to right, #000, rgba(0, 0, 0, 0)); }
    .m-rad { mask-image: radial-gradient(circle, #000 40%, rgba(0, 0, 0, 0) 75%); }
    .svgs { align-items: center; }
    .icons { gap: 10px; font-size: 32px; }
    .icons button { font-size: 14px; }
    .s48 { width: 48px; height: 48px; }
    .s96 { width: 96px; height: 96px; }
    .wide { width: 200px; height: 48px; background: #181825; border-radius: 6px; }
    .red { color: #f38ba8; }
    .gold { color: #f9e2af; }
    .green { color: #a6e3a1; }
    .blue { color: #89b4fa; }
    .mauve { color: #cba6f7; }
    .peach { color: #fab387; }
    .teal { color: #94e2d5; }
</style>
