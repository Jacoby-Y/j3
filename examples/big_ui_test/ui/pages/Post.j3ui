<script>
    use big_ui_test.postconfig.digit;
    let tab: int = digit("UI_POST_TAB", 0, 3);
</script>

<div class="post">
    <div class="tabs">
        <button class:chosen={tab == 0} on:click={tab = 0}>Glass + Blur</button>
        <button class:chosen={tab == 1} on:click={tab = 1}>Effects + Color</button>
        <button class:chosen={tab == 2} on:click={tab = 2}>Shader + Texture</button>
        <button class:chosen={tab == 3} on:click={tab = 3}>Small glows</button>
    </div>
    {#if tab == 0}
        <post.Glass />
    {:else if tab == 1}
        <post.Filters />
    {:else if tab == 2}
        <post.Shader />
    {:else}
        <post.SmallFx />
    {/if}
</div>

<style>
    .post { display: flex; flex-direction: column; gap: 18px; }
    .tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    button { padding: 10px 8px; font-size: 13px; }
    button.chosen { background: var(--accent); color: #11111b; }
</style>
