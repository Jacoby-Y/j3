<!-- ANSI-colored log: j3.ui.ansi.AnsiLog parses once, spans are drawn with style: slots. -->

<script>
    use big_ui_test.ansidemo.demoLog;
    use j3.ui.ansi.AnsiLog;

    let log: &AnsiLog = demoLog();
</script>

<div class="log">
    {#each 0..log.count() as i}
        <div class="ln">{#each log.line(i) as s}<span style:color="{s.fg}" style:background="{s.bg}" style:font-weight="{s.weight}" style:font-style="{s.slant}" style:text-decoration-line="{s.deco}">{s.text}</span>{/each}</div>
    {/each}
</div>

<style>
    .log { height: 480px; overflow-y: auto; padding: 10px; background: #11111b; border-radius: 10px; font-family: "Mono", "Ui"; font-size: 14px; color: #cdd6f4; }
    .ln { white-space: pre; min-height: 18px; line-height: 18px; }
</style>
