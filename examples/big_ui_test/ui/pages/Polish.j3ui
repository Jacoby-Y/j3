<!-- Motion polish: wave text, animated gradients, animated borders and shadows, loading components. -->

<script>
    let progress: f32 = 0.0;

    fn pct(): int {
        return int(progress * 100.0);
    }

    fn more() {
        progress += 0.2;
        if progress > 1.0 {
            progress = 0.0;
        }
    }
</script>

<div class="cols">
    <div class="col">
        <kit.Section note="Wave text: text-wave: amplitude length period (J3 extension), per-glyph lift, effects follow each glyph">
            <div class="wave w1">Waves of text roll by</div>
            <div class="wave w2">Gradient wave</div>
            <div class="wave w3">GLOW</div>
            <div class="wave w4">small and quick, pulled along the line</div>
        </kit.Section>
        <kit.Section note="Animated gradients: keyframed angle, stops and colors; transition on hover">
            <div class="row">
                <div class="gw spin-lin">angle</div>
                <div class="gw spin-con">conic</div>
                <div class="gw pulse-rad">radial</div>
                <div class="gw hue">hover</div>
                <div class="gw grow">2 to 3 stops</div>
            </div>
            <div class="sweep">Moving sheen across a background</div>
            <div class="shine-text">Gradient text sliding</div>
            <div class="reveal">Animated mask wipe</div>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="Animated borders and shadows: color pulse, glow pulse, rotating conic border">
            <div class="row">
                <div class="bx pulse-border">border</div>
                <div class="bx pulse-glow">glow</div>
                <div class="bx neon">neon</div>
                <div class="bx rot-border">conic</div>
            </div>
        </kit.Section>
        <kit.Section note="Loading animations: spinners, dots, progress, skeleton">
            <div class="row">
                <load.Spinner tone={0} big={false} />
                <load.Spinner tone={1} big={false} />
                <load.Spinner tone={2} big={false} />
                <load.Spinner tone={0} big={true} />
                <load.Dots tone={0} />
                <load.Dots tone={1} />
                <load.Dots tone={2} />
            </div>
            <div class="row">
                <button on:click={more()}>More: {pct()}%</button>
                <load.Progress value={progress} busy={false} />
            </div>
            <load.Progress value={0.0} busy={true} />
            <div class="row">
                <load.Skeleton lines={3} avatar={true} />
                <load.Skeleton lines={2} avatar={false} />
            </div>
        </kit.Section>
    </div>
</div>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .row { align-items: center; }

    .wave { height: 44px; padding-top: 10px; }
    .w1 { font-size: 24px; text-wave: 6px 110px 1.6s; }
    .w2 { font-size: 24px; font-weight: bold; text-wave: 5px 70px 1.2s; background: linear-gradient(90deg, #f38ba8, #f9e2af, #89b4fa); background-clip: text; }
    .w3 { font-size: 26px; font-weight: bold; color: #a6e3a1; text-shadow: 0 0 10px #a6e3a1; text-wave: 8px 60px 1.0s; }
    .w4 { font-size: 15px; color: #f9e2af; text-wave: 3px 40px 700ms; }

    .gw { width: 96px; height: 64px; border-radius: 10px; color: #11111b; font-size: 12px; display: flex; align-items: center; justify-content: center; }
    .spin-lin { background: linear-gradient(0deg, #f38ba8, #89b4fa); animation: a-lin 3s linear infinite; }
    @keyframes a-lin { from { background-image: linear-gradient(0deg, #f38ba8, #89b4fa); } to { background-image: linear-gradient(360deg, #f38ba8, #89b4fa); } }
    .spin-con { background: conic-gradient(from 0deg, #f9e2af, #f38ba8, #cba6f7, #f9e2af); border-radius: 32px; animation: a-con 4s linear infinite; }
    @keyframes a-con { from { background-image: conic-gradient(from 0deg, #f9e2af, #f38ba8, #cba6f7, #f9e2af); } to { background-image: conic-gradient(from 360deg, #f9e2af, #f38ba8, #cba6f7, #f9e2af); } }
    .pulse-rad { background: radial-gradient(circle, #f9e2af 0%, #fab387 30%, #1e1e2e 100%); animation: a-rad 1.6s ease-in-out infinite alternate; }
    @keyframes a-rad { from { background-image: radial-gradient(circle, #f9e2af 0%, #fab387 20%, #1e1e2e 60%); } to { background-image: radial-gradient(circle, #f9e2af 0%, #fab387 60%, #1e1e2e 100%); } }
    .hue { background: linear-gradient(135deg, #89b4fa, #cba6f7); transition: background-image 700ms ease; }
    .hue:hover { background-image: linear-gradient(315deg, #a6e3a1, #f9e2af); }
    .grow { background: linear-gradient(90deg, #89b4fa, #cba6f7); animation: a-grow 2s ease-in-out infinite alternate; }
    @keyframes a-grow { from { background-image: linear-gradient(90deg, #89b4fa, #cba6f7); } to { background-image: linear-gradient(90deg, #f38ba8, #f9e2af 50%, #a6e3a1); } }

    .sweep { height: 44px; border-radius: 10px; display: flex; align-items: center; padding-left: 16px; font-size: 14px; color: #cdd6f4; background: linear-gradient(110deg, #26273a 0%, #3a3d5c 12%, #26273a 24%); animation: a-sweep 2.4s ease-in-out infinite; }
    @keyframes a-sweep { from { background-image: linear-gradient(110deg, #26273a 0%, #3a3d5c 12%, #26273a 24%); } to { background-image: linear-gradient(110deg, #26273a 76%, #3a3d5c 88%, #26273a 100%); } }
    .shine-text { font-size: 26px; font-weight: bold; background: linear-gradient(90deg, #7f849c 0%, #ffffff 10%, #7f849c 20%); background-clip: text; animation: a-shine 2s linear infinite; }
    @keyframes a-shine { from { background-image: linear-gradient(90deg, #7f849c 0%, #ffffff 10%, #7f849c 20%); } to { background-image: linear-gradient(90deg, #7f849c 80%, #ffffff 90%, #7f849c 100%); } }

    .reveal { height: 40px; border-radius: 10px; display: flex; align-items: center; padding-left: 16px; font-size: 14px; color: #11111b; background: linear-gradient(90deg, #f38ba8, #f9e2af, #a6e3a1); mask-image: linear-gradient(90deg, #000 0%, #000 40%, rgba(0, 0, 0, 0) 60%); animation: m-wipe 2.6s ease-in-out infinite alternate; }
    @keyframes m-wipe { from { mask-image: linear-gradient(90deg, #000 0%, #000 0%, rgba(0, 0, 0, 0) 20%); } to { mask-image: linear-gradient(90deg, #000 0%, #000 80%, rgba(0, 0, 0, 0) 100%); } }

    .bx { width: 84px; height: 64px; border-radius: 12px; background: var(--raised); display: flex; align-items: center; justify-content: center; font-size: 12px; }
    .pulse-border { border: 3px solid #89b4fa; animation: b-pulse 1.1s ease-in-out infinite alternate; }
    @keyframes b-pulse { from { border-color: #89b4fa; } to { border-color: #f38ba8; } }
    .pulse-glow { box-shadow: 0 0 4px rgba(166, 227, 161, 0.4); animation: g-pulse 1.2s ease-in-out infinite alternate; }
    @keyframes g-pulse { from { box-shadow: 0 0 4px 0 rgba(166, 227, 161, 0.3); } to { box-shadow: 0 0 22px 5px rgba(166, 227, 161, 0.9); } }
    .neon { background: #11111b; border: 2px solid #cba6f7; animation: n-pulse 1.8s ease-in-out infinite; }
    @keyframes n-pulse {
        0% { border-color: #cba6f7; box-shadow: 0 0 6px #cba6f7, inset 0 0 6px rgba(203, 166, 247, 0.4); }
        50% { border-color: #f5c2e7; box-shadow: 0 0 18px #cba6f7, 0 0 36px rgba(203, 166, 247, 0.6), inset 0 0 14px rgba(203, 166, 247, 0.7); }
        100% { border-color: #cba6f7; box-shadow: 0 0 6px #cba6f7, inset 0 0 6px rgba(203, 166, 247, 0.4); }
    }
    .rot-border { border: 3px solid #000; border-image: conic-gradient(from 0deg, #f38ba8, #f9e2af, #a6e3a1, #89b4fa, #f38ba8) 1; animation: b-rot 3s linear infinite; }
    @keyframes b-rot {
        from { border-image: conic-gradient(from 0deg, #f38ba8, #f9e2af, #a6e3a1, #89b4fa, #f38ba8) 1; }
        to { border-image: conic-gradient(from 360deg, #f38ba8, #f9e2af, #a6e3a1, #89b4fa, #f38ba8) 1; }
    }
</style>
