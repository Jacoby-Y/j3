<div class="col">
    <kit.Section class="roomy" note="Flex: justify-content start / center / space-between (--section-gap: 20px from this page)">
        <div class="flex start"><div class="box">1</div><div class="box">2</div><div class="box">3</div></div>
        <div class="flex center"><div class="box">1</div><div class="box">2</div><div class="box">3</div></div>
        <div class="flex between"><div class="box">1</div><div class="box">2</div><div class="box">3</div></div>
    </kit.Section>
    <kit.Section note="Flex grow: 1 / 2 / 1">
        <div class="flex"><div class="box g1">1</div><div class="box g2">2</div><div class="box g1">1</div></div>
    </kit.Section>
    <kit.Section note="Flex: flex-basis 120px + flex-shrink (inside 300px: the 2nd does not shrink), align-self, order">
        <div class="flex tall">
            <div class="box bas">basis</div>
            <div class="box bas keep">no shrink</div>
            <div class="box stretchless self-end">end</div>
            <div class="box stretchless self-center">center</div>
        </div>
        <div class="flex"><div class="box" style:order={3}>1 (order 3)</div><div class="box" style:order={1}>2 (order 1)</div><div class="box" style:order={2}>3 (order 2)</div></div>
    </kit.Section>
    <kit.Section note="Flex: row-reverse, column-reverse, wrap-reverse, and column wrap (definite height)">
        <div class="demos">
            <div class="flex rev"><div class="box">1</div><div class="box">2</div><div class="box">3</div></div>
            <div class="flex colrev"><div class="box">1</div><div class="box">2</div><div class="box">3</div></div>
            <div class="flex wrapr">{#each 0..5 as i}<div class="box">{i}</div>{/each}</div>
            <div class="flex colwrap">{#each 0..5 as i}<div class="box">{i}</div>{/each}</div>
        </div>
    </kit.Section>
    <kit.Section note="Grid: repeat(4, 1fr)">
        <div class="grid">
            {#each 0..8 as i}
                <div class="box">{i}</div>
            {/each}
        </div>
    </kit.Section>
    <kit.Section note="Absolute positioning">
        <div class="stage">
            <div class="box abs tl">top-left</div>
            <div class="box abs br">bottom-right</div>
            <div class="box abs mid">overlap</div>
        </div>
    </kit.Section>
    <kit.Section>
        <small slot="title">Responsive: <span class="wide">wide layout (4 columns)</span><span class="narrow">narrow layout (window under 900 px: 2 columns; under 640 px: 1)</span></small>
        <div class="resp">
            {#each 0..8 as i}
                <div class="box">{i}</div>
            {/each}
        </div>
        <div class="fluid">
            <div class="box side">25%</div>
            <div class="box main">flex 1, min 120 px</div>
        </div>
    </kit.Section>
</div>

<style>
    .roomy { --section-gap: 20px; }
    .col { display: flex; flex-direction: column; gap: 12px; }
    .flex { display: flex; gap: 8px; padding: 6px; background: var(--bg); border-radius: 6px; }
    .start { justify-content: flex-start; }
    .center { justify-content: center; }
    .between { justify-content: space-between; }
    .g1 { flex: 1; }
    .g2 { flex: 2; }
    .box { display: flex; justify-content: center; align-items: center; min-width: 48px; height: 36px; padding: 0 10px; background: var(--raised); border-radius: 6px; }
    .tall { height: 80px; width: 300px; }
    .bas { flex-basis: 120px; }
    .keep { flex-shrink: 0; }
    .stretchless { height: 24px; }
    .self-end { align-self: flex-end; }
    .self-center { align-self: center; }
    .demos { display: flex; gap: 12px; align-items: flex-start; }
    .rev { flex-direction: row-reverse; }
    .colrev { flex-direction: column-reverse; }
    .wrapr { flex-wrap: wrap-reverse; width: 130px; }
    .colwrap { flex-direction: column; flex-wrap: wrap; height: 100px; width: 130px; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .stage { position: relative; height: 140px; background: var(--bg); border-radius: 6px; }
    .abs { position: absolute; }
    .tl { left: 10px; top: 10px; background: #f38ba8; color: var(--bg); }
    .br { right: 10px; bottom: 10px; background: #a6e3a1; color: var(--bg); }
    .mid { left: 70px; top: 30px; width: 140px; height: 60px; background: rgba(137, 180, 250, 0.6); }
    .resp { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .fluid { display: flex; gap: 8px; }
    .side { width: 25%; }
    .main { flex: 1; min-width: 120px; }
    .narrow { display: none; }
    @media (max-width: 900px) {
        .resp { grid-template-columns: repeat(2, 1fr); }
        .wide { display: none; }
        .narrow { display: inline; }
    }
    @media (max-width: 640px) {
        .resp { grid-template-columns: repeat(1, 1fr); }
        .fluid { flex-direction: column; }
        .side { width: auto; }
    }
</style>
