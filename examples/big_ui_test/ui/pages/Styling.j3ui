<!-- margin: auto, aspect-ratio, outline, text-decoration, font-style, cursor, :not, :nth-child, :last-child. -->

<script>
    let picked: int = 1;
</script>

<div class="cols">
    <div class="col">
        <kit.Section note="margin: 0 auto centers a block; margin-left: auto pushes a flex item to the end; margin: auto centers in a flex box and in an absolute box">
            <div class="frame"><div class="blk">0 auto</div></div>
            <div class="bar"><span>a</span><span>b</span><span class="end">margin-left: auto</span></div>
            <div class="center"><div class="dot">flex</div></div>
            <div class="rel"><div class="abs">abs</div></div>
        </kit.Section>
        <kit.Section note="aspect-ratio: 16 / 9 (width 240) and 1 (height 60); outline with offset, dashed, none">
            <div class="ratio wide">16 / 9</div>
            <div class="row"><div class="ratio sq">1</div><div class="ring a">solid</div><div class="ring b">dashed</div><div class="ring c">offset 4px, radius</div></div>
        </kit.Section>
    </div>
    <div class="col">
        <kit.Section note="text-decoration, font-style (faux italic), and inheritance into a span">
            <p class="ul">Underlined <span>and a span inside</span> text</p>
            <p class="lt">Struck through</p>
            <p class="ol">Overlined</p>
            <p class="it">Italic <span class="bd">bold italic</span> and <span class="up">underlined italic</span></p>
        </kit.Section>
        <kit.Section note="cursor: pointer on hover (real window only), :not(.active) hover, :nth-child zebra, :last-child, :nth-child(3n+1)">
            <div class="row">
                {#each 0..4 as i}
                    <div class="tab" class:active={picked == i} on:click={picked = i}>tab {i}</div>
                {/each}
            </div>
            <div class="list">
                {#each 0..7 as i}
                    <div class="li"><span>item {i}</span></div>
                {/each}
            </div>
        </kit.Section>
    </div>
</div>

<style>
    .cols { display: flex; gap: 12px; align-items: flex-start; }
    .col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
    .row { display: flex; gap: 14px; align-items: center; padding: 6px; }
    .frame { width: 300px; background: #1e1e2e; padding: 6px 0; }
    .blk { width: 120px; height: 26px; margin: 0 auto; background: #3050a0; text-align: center; line-height: 26px; }
    .bar { display: flex; width: 300px; height: 30px; background: #1e1e2e; gap: 4px; }
    .bar span { width: 30px; background: #a03030; }
    .bar .end { width: 130px; margin-left: auto; background: #20a050; }
    .center { display: flex; width: 300px; height: 70px; background: #1e1e2e; }
    .dot { width: 60px; height: 30px; margin: auto; background: #806010; text-align: center; line-height: 30px; }
    .rel { position: relative; width: 300px; height: 70px; background: #1e1e2e; }
    .abs { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 60px; height: 30px; margin: auto; background: #602080; text-align: center; line-height: 30px; }
    .ratio { background: #3050a0; display: flex; align-items: center; justify-content: center; }
    .wide { width: 240px; aspect-ratio: 16 / 9; }
    .sq { height: 60px; aspect-ratio: 1; }
    .ring { width: 80px; height: 40px; background: #313244; display: flex; align-items: center; justify-content: center; font-size: 12px; margin: 6px; }
    .a { outline: 3px solid #f9e2af; }
    .b { outline: 2px dashed #f38ba8; outline-offset: 3px; }
    .c { outline: 2px solid #89b4fa; outline-offset: 4px; border-radius: 10px; }
    .ul { text-decoration: underline; }
    .lt { text-decoration: line-through; color: #f38ba8; }
    .ol { text-decoration: overline; }
    .it { font-style: italic; }
    .up { text-decoration: underline; }
    .bd { font-weight: bold; }
    .tab { padding: 6px 12px; background: #313244; border-radius: 6px; cursor: pointer; }
    .tab:not(.active):hover { background: #45475a; }
    .tab.active { background: #3050a0; cursor: default; outline: 2px solid #89b4fa; }
    .list { width: 220px; }
    .li { padding: 4px 8px; background: #1e1e2e; cursor: grab; }
    .li:nth-child(even) { background: #2a2b3c; }
    .li:nth-child(3n+1) span { color: #f9e2af; }
    .li:last-child { border-bottom: 2px solid #a6e3a1; }
</style>
