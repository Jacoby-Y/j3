<!-- Unicode text, symbols, emoji and icons. Emoji and pictographs come from a second font. -->

<script>
    let rtl1: string = "abc שלום עולם def";
    let rtl2: string = "مرحبا بالعالم hello\nשלום 123 world";
</script>

<div class="col">
    <kit.Section note="Latin, Greek, Cyrillic (the main font)">
        <p>Héllo Wörld — façade, ñandú, Ærø, straße, naïve café</p>
        <p>Ελληνικά: αβγδε ΩΨΧ &nbsp; Кириллица: Привет, мир!</p>
    </kit.Section>
    <kit.Section note="Symbols and arrows (the main font)">
        <p class="big">★ ☆ ♥ ♦ ♣ ♠ ✓ ✗ ➜ ← ↑ → ↓ ⚠ ☀ ☂ ♪ ⚙ ∞ ≈ ≠ ±</p>
    </kit.Section>
    <kit.Section note={"Emoji and pictographs: font-family \"Symbols\" (monochrome)"}>
        <p class="sym big">🎮 🛡 🏆 ❤ ⭐ 🗝 🗡 ⚡ ☠ 🪙 💣 💰 👍</p>
    </kit.Section>
    <kit.Section note={"Fallback chain: font-family \"Ui\", \"Symbols\" draws each glyph from the first font that has it; the text is selectable"}>
        <p class="mix">Press 🎮 to play, collect the 🪙 and the ★, then 🛡 up.</p>
    </kit.Section>
    <kit.Section note={"Color emoji (Noto Color Emoji, font-family \"Ui\", \"Emoji\"): scaled to the font size, 16px and 32px"}>
        <p class="color">Small 🥳 and 🦀 and 🍕 inline</p>
        <p class="color big2">Large 🥳 and 🦀 and 🍕</p>
    </kit.Section>
    <kit.Section note="RTL and mixed text in an input and a textarea (shaped, caret and selection follow visual runs)">
        <input type="text" bind:value={rtl1} />
        <textarea rows="2" bind:value={rtl2}></textarea>
    </kit.Section>
    <kit.Section note="Icons beside text: inline mixed fonts, sizes, and colors">
        <div class="row">
            <div class="chip"><span class="sym ic gold">🪙</span><span>240 coins</span></div>
            <div class="chip"><span class="sym ic red">❤</span><span>Health 82</span></div>
            <div class="chip"><span class="sym ic blue">🛡</span><span>Armor 14</span></div>
            <div class="chip"><span class="sym ic green">🗡</span><span>Attack 9</span></div>
        </div>
        <p class="inline">Mixed in a sentence: press <span class="sym key">⏎</span> to confirm or <span class="sym key">✕</span> to cancel, then collect the <span class="sym gold">★</span>.</p>
    </kit.Section>
    <kit.Section note="Wrapping and truncation keep code points whole">
        <p class="box">Ünïcödé wörds wräp nörmälly, and a verylongwordwithaccents_éèêëàâäôöûü_ÿçñ breaks only between letters.</p>
        <p class="box cut">Truncated with the ellipsis: ñandú, façade, Привет мир, αβγδε — and then a long tail of text</p>
    </kit.Section>
</div>

<style>
    .col { display: flex; flex-direction: column; gap: 12px; }
    .row { gap: 10px; }
    .big { font-size: 24px; }
    .color { font-family: "Ui", "Emoji"; }
    .big2 { font-size: 32px; }
    .sym { font-family: "Symbols"; }
    .mix { font-family: "Ui", "Symbols"; user-select: text; }
    .chip { display: flex; gap: 8px; align-items: center; padding: 6px 12px; background: var(--raised); border-radius: 999px; }
    .ic { font-size: 20px; }
    .gold { color: #f9e2af; }
    .red { color: #f38ba8; }
    .blue { color: #89b4fa; }
    .green { color: #a6e3a1; }
    .key { color: var(--accent); }
    .inline { line-height: 22px; }
    .box { width: 330px; line-height: 20px; overflow-wrap: break-word; background: var(--raised); padding: 4px 8px; }
    .cut { white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }
</style>
