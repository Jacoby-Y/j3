<!-- Two buttons whose handlers call script fns that `emit` events (emit from a fn, not only from markup). -->

<script>
    events { ping(n: int, tag: string); done; }

    fn send(n: int, tag: string) { emit ping(n, tag); }
    fn both() { send(10, "both"); emit done; }
</script>

<div class="row">
    <button on:click={send(1, "one")}>ping 1</button>
    <button on:click={both()}>ping 10 + done</button>
</div>
