<!-- A titled panel: a muted caption (or the `title` slot), then whatever the page puts inside (the default slot).
     `note` is an optional prop. A page tunes the space between the children from outside with the custom
     property `--section-gap` (default 8px), set on a class it puts on the Section: `.roomy { --section-gap: 20px; }`. -->

<script>
    props { note: string = ""; }
</script>

<section>
    <slot name="title"><small>{note}</small></slot>
    <slot />
</section>

<style>
    section { display: flex; flex-direction: column; gap: var(--section-gap, 8px); padding: 12px 14px; background: var(--panel); border-radius: 10px; }
</style>
