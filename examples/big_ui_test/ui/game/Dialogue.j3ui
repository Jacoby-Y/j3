<!-- A dialogue box: portrait, speaker, a typewriter line with per-line effects (plain, whisper, shout),
     a blinking "next" arrow, and answers on the last line. Click the box to finish a line or advance. -->

<script>
    use big_ui_test.dialogue;
    use big_ui_test.gamedemo.Demo;
    use j3.ui.textanim;

    inject demo: &Demo;

    fn shown(): string {
        return textanim.typewriter(dialogue.text(demo.dlgLine), demo.typed(), 34.0);
    }

    fn last(): bool {
        return demo.dlgLine == dialogue.LINES - 1;
    }

    fn arrow(): bool {
        return textanim.blink(demo.t, 1.6);
    }
</script>

<div class="box" on:click={demo.advance()}>
    <div class="portrait" class:elder={demo.dlgLine != 3}><span>{if demo.dlgLine == 3 { "🗡" } else { "☠" }}</span></div>
    <div class="body">
        <div class="who">{dialogue.speaker(demo.dlgLine)}</div>
        <div class="stack">
            <div class="ghost">{dialogue.text(demo.dlgLine)}</div>
            <div class="line" class:whisper={dialogue.effect(demo.dlgLine) == 1} class:shout={dialogue.effect(demo.dlgLine) == 2}>{shown()}</div>
        </div>
        <div class="foot">
            {#if demo.lineDone() && last()}
                <button class="yes" on:click={demo.answer(true)}>I will help</button>
                <button on:click={demo.answer(false)}>Not now</button>
            {:else if demo.lineDone()}
                <span class="next" class:on={arrow()}>▼</span>
            {:else}
                <span class="skip">click to skip</span>
            {/if}
        </div>
    </div>
</div>

<style>
    .box { display: flex; gap: 14px; padding: 14px; background: linear-gradient(180deg, #1e1e2e, #181825); border: 2px solid #585b70; border-radius: 12px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.05); }
    .portrait { width: 64px; height: 64px; border-radius: 32px; border: 3px solid #f9e2af; background: linear-gradient(135deg, #45475a, #1e1e2e); display: flex; justify-content: center; align-items: center; }
    .portrait span { font-family: "Symbols"; font-size: 32px; color: #f9e2af; }
    .portrait.elder { border-color: #cba6f7; }
    .body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
    .who { font-weight: bold; font-size: 14px; color: transparent; background: linear-gradient(90deg, #f9e2af, #fab387); background-clip: text; width: 140px; }
    .stack { position: relative; min-height: 54px; }
    .ghost, .line { font-size: 15px; line-height: 20px; white-space: normal; }
    .ghost { color: transparent; }
    .line { position: absolute; left: 0; top: 0; width: 100%; color: #cdd6f4; }
    .line.whisper { color: #9399b2; text-shadow: 0 0 6px rgba(147, 153, 178, 0.7); }
    .line.shout { color: #f38ba8; font-weight: bold; -webkit-text-stroke: 0.6px #ff6688; text-shadow: 0 0 10px rgba(243, 139, 168, 0.9); animation: shake 90ms linear infinite alternate; }
    .foot { display: flex; gap: 8px; justify-content: flex-end; align-items: center; height: 30px; }
    .skip { font-size: 11px; color: #6c7086; }
    .next { color: #f9e2af; opacity: 0; }
    .next.on { opacity: 1; }
    .yes { background: #a6e3a1; color: #11111b; }
    button { padding: 5px 12px; font-size: 13px; }
    @keyframes shake { from { transform: translate(-1px, 0); } to { transform: translate(1px, 1px); } }
</style>
