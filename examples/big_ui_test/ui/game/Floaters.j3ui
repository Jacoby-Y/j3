<!-- Floating combat numbers over a bounded pool of slots: each rises from its mob (or the player) and fades. -->

<script>
    use big_ui_test.gamedemo.{ Demo, Floater };
    use big_ui_test.gameworld.{ VIEW_H, VIEW_W };

    inject demo: &Demo;

    fn visible(f: Floater): bool {
        return f.live && (f.mob < 0 || demo.mobs[f.mob].shown);
    }

    /// Eased rise in px: fast at first, slowing.
    fn rise(f: Floater): f32 {
        let a = f.age / 1.3;
        return 70.0 * (1.0 - (1.0 - a) * (1.0 - a));
    }

    fn x(f: Floater): f32 {
        let m = f.mob;
        return (if m < 0 { VIEW_W * 0.5 } else { demo.mobs[m].sx }) + f.jit * 1.5 - 40.0;
    }

    fn y(f: Floater): f32 {
        let m = f.mob;
        return (if m < 0 { VIEW_H - 90.0 } else { demo.mobs[m].sy - 20.0 }) - rise(f);
    }
</script>

<div class="floaters">
    {#each demo.floats as f (f.id)}
        {#if visible(f)}
            <div class="num" class:hurt={f.kind == 0} class:crit={f.kind == 1} class:heal={f.kind == 2} class:fade={f.age > 0.85} left={x(f)} top={y(f)}>{#if f.kind == 2}+{/if}{f.amt}{#if f.kind == 1}!{/if}</div>
        {/if}
    {/each}
</div>

<style>
    .floaters { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
    .num { position: absolute; width: 80px; text-align: center; font-size: 17px; font-weight: bold; color: #fff; text-shadow: 0 2px 3px #000; -webkit-text-stroke: 1px #000; opacity: 1; transition: opacity 380ms; animation: pop 160ms ease-out; }
    .num.hurt { color: #f38ba8; }
    .num.heal { color: #a6e3a1; }
    .num.crit { color: #f9e2af; font-size: 26px; text-shadow: 0 0 10px #fab387, 0 2px 3px #000; }
    .num.fade { opacity: 0; }
    @keyframes pop { from { transform: scale(0.4); } 60% { transform: scale(1.3); } to { transform: scale(1); } }
</style>
