<!-- A name tag over a world entity: name, level and a small health bar. `tier` is its distance (0 near .. 2 far). -->

<script>
    props {
        name: string;
        level: int;
        hp: int;
        max: int;
        tier: int;
    }
</script>

<div class="plate" class:mid={tier == 1} class:far={tier == 2}>
    <div class="line"><span class="lv">{level}</span><span class="who">{name}</span></div>
    {#if tier < 2}
        <game.Bar value={hp} max={max} kind={0} label="" compact={true} />
    {/if}
</div>

<style>
    .plate { display: flex; flex-direction: column; align-items: center; gap: 2px; width: 110px; }
    .line { display: flex; gap: 5px; align-items: center; font-size: 13px; color: #fff; text-shadow: 0 1px 2px #000, 0 0 4px #000; }
    .lv { padding: 0 4px; border-radius: 4px; background: #f38ba8; color: #11111b; font-size: 11px; font-weight: bold; }
    .mid .line { font-size: 11px; }
    .far .line { font-size: 10px; opacity: 0.6; }
    .far .lv { display: none; }
</style>
