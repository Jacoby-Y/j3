<!-- Buttons that poke the demo state, so every component can be seen reacting. -->

<script>
    use big_ui_test.gamedemo.Demo;

    inject demo: &Demo;

    fn burst() {
        for k in 0..30 {
            demo.hitMob(k % 10, 5 + k, k % 6 == 0);
        }
    }
</script>

<div class="controls">
    <button class:on={demo.auto} on:click={demo.auto = !demo.auto}>Auto fight {if demo.auto { "on" } else { "off" }}</button>
    <button on:click={demo.hurt(18)}>Take 18</button>
    <button on:click={demo.hurt(400)}>Take 400</button>
    <button on:click={demo.heal(30)}>Heal 30</button>
    <button on:click={demo.spend(30, 40)}>Spend 30 MP / 40 SP</button>
    <button on:click={burst()}>Burst x30</button>
    <button on:click={demo.acceptQuest()}>Quest toast</button>
</div>

<style>
    .controls { display: flex; flex-direction: column; gap: 6px; width: 180px; }
    button { font-size: 12px; padding: 6px 10px; }
    button.on { background: #89b4fa; color: #11111b; }
</style>
