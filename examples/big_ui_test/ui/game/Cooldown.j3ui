<!-- A skill button with a clock-wipe cooldown, the seconds left, and a flash when it is ready again. -->

<script>
    use big_ui_test.gameart.pie;
    use j3.game.rgba;

    props {
        glyph: string;
        key: string;
        left: f32;      // seconds left (0 = ready)
        total: f32;     // full cooldown
        cost: int;
        mana: int;      // what the player has, to grey out an unaffordable skill
    }
    events { cast; }

    fn isReady(): bool {
        return left <= 0.0;
    }

    fn broke(): bool {
        return isReady() && mana < cost;
    }

    /// "3" while above 10 s, "1.4" below.
    fn whole(): int {
        return int(left + 0.99);
    }

    fn tenths(): int {
        return int(left * 10.0) % 10;
    }
</script>

<div class="skill" class:ready={isReady()} class:broke={broke()} on:click={emit cast}>
    <span class="glyph">{glyph}</span>
    <canvas class="sweep" on:draw={pie(Vec2 { x: size.x * 0.5, y: size.y * 0.5 }, size.x * 0.5, if total > 0.0 { left / total } else { 0.0 }, rgba(8, 8, 14, 190))}></canvas>
    {#if left >= 10.0}
        <span class="secs">{whole()}</span>
    {:else if left > 0.0}
        <span class="secs">{int(left)}.{tenths()}</span>
    {/if}
    <span class="key">{key}</span>
</div>

<style>
    .skill { position: relative; width: 52px; height: 52px; border-radius: 26px; background: #313244; border: 2px solid #585b70; display: flex; justify-content: center; align-items: center; overflow: hidden; transition: border-color 120ms; }
    .skill:hover { border-color: #89b4fa; }
    .skill.ready { border-color: #a6e3a1; animation: ready 420ms ease-out; }
    .skill.broke { border-color: #f38ba8; }
    .glyph { font-family: "Symbols"; font-size: 24px; color: #cdd6f4; }
    .broke .glyph { color: #6c7086; }
    .sweep { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
    .secs { position: absolute; left: 0; top: 16px; width: 100%; text-align: center; font-size: 15px; font-weight: bold; color: #fff; text-shadow: 0 1px 3px #000; }
    .key { position: absolute; right: 4px; bottom: 1px; font-size: 10px; color: #bac2de; }
    @keyframes ready { from { box-shadow: 0 0 0 0 rgba(166, 227, 161, 0.9); } 50% { box-shadow: 0 0 14px 6px rgba(166, 227, 161, 0.7); } to { box-shadow: 0 0 0 0 rgba(166, 227, 161, 0); } }
</style>
