<!-- The scene: a canvas backdrop, then DOM nameplates placed from each entity's projected position, then damage numbers.
     Entities that are behind the camera or off screen are not rendered at all. -->

<script>
    use big_ui_test.gameart.backdrop;
    use big_ui_test.gamedemo.Demo;
    use big_ui_test.gameworld.tier;

    inject demo: &Demo;

    const NAMES: [4]string = ["Wolf", "Dire Wolf", "Boar", "Bandit"];
</script>

<div class="world">
    <canvas class="view" on:draw={backdrop(size, demo)}></canvas>
    {#each demo.mobs as m (m.id)}
        {#if m.shown}
            <div class="at" left={m.sx - 55.0} top={m.sy - 26.0}>
                <game.Nameplate name={NAMES[m.id % 4]} level={m.lvl} hp={m.hp} max={m.maxHp} tier={tier(m.depth)} />
            </div>
        {/if}
    {/each}
    <game.Floaters />
</div>

<style>
    .world { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
    .view { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
    .at { position: absolute; width: 110px; }
</style>
