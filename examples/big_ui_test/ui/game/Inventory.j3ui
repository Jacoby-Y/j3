<!-- A scrolling grid of ItemSlot cells over the Demo's inventory. Click a cell, then another, to swap them. -->

<script>
    use big_ui_test.gamedemo.{ Demo, SLOTS };

    inject demo: &Demo;
</script>

<div class="grid">
    {#each 0..SLOTS as i}
        <game.ItemSlot kind={demo.kind[i]} rarity={demo.rarity[i]} count={demo.count[i]} selected={demo.sel == i} on:pick={demo.clickSlot(i)} />
    {/each}
</div>

<style>
    .grid { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; padding: 8px; background: #11111b; border-radius: 10px; border: 1px solid #313244; }
</style>
