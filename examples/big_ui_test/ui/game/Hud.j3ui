<!-- The on-screen HUD over the scene: resource bars top left, skill bar bottom centre. -->

<script>
    use big_ui_test.gamedemo.{ Demo, SKILLS };

    inject demo: &Demo;

    const GLYPHS: [4]string = ["🗡", "⚡", "🛡", "💣"];
    const KEYS: [4]string = ["1", "2", "3", "4"];
</script>

<div class="hud">
    <div class="bars">
        <game.Bar value={demo.hp} max={demo.hpMax} kind={0} label="HP" compact={false} />
        <game.Bar value={demo.mana} max={demo.manaMax} kind={1} label="MP" compact={false} />
        <game.Bar value={demo.stam} max={demo.stamMax} kind={2} label="SP" compact={false} />
    </div>
    <div class="skills">
        {#each 0..SKILLS as s}
            <game.Cooldown glyph={GLYPHS[s]} key={KEYS[s]} left={demo.cd[s]} total={demo.cdTotal[s]} cost={demo.cost[s]} mana={demo.mana} on:cast={demo.cast(s)} />
        {/each}
    </div>
    {#if demo.hp <= 0}
        <div class="dead" transition:fade={300}>DEFEATED</div>
    {/if}
</div>

<style>
    .hud { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
    .bars { position: absolute; left: 12px; top: 12px; display: flex; flex-direction: column; gap: 5px; }
    .skills { position: absolute; left: 0; bottom: 12px; width: 100%; display: flex; justify-content: center; gap: 10px; pointer-events: auto; }
    .dead { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; background: rgba(60, 0, 10, 0.55); color: #f38ba8; font-size: 40px; font-weight: bold; }
</style>
