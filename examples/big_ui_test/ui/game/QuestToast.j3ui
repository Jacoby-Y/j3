<!-- Quest notices: the j3.ui.toast slots, each showing the quest, what happened, and its progress. -->

<script>
    use big_ui_test.dialogue;
    use big_ui_test.gamedemo.Demo;

    inject demo: &Demo;

    /// The toast `kind` is `quest * 3 + status` (0 started, 1 progress, 2 complete).
    fn status(i: int): int {
        return demo.toasts.kind(i) % 3;
    }

    fn quest(i: int): int {
        return demo.toasts.kind(i) / 3;
    }

    const HEADLINES: [3]string = ["New quest", "Quest updated", "Quest complete"];

    fn progress(i: int): int {
        return if status(i) == 2 { dialogue.questGoal(quest(i)) } else { demo.kills };
    }
</script>

<div class="toasts">
    {#each 0..6 as i}
        {#if demo.toasts.live(i)}
            <div class="qt" class:done={status(i) == 2} transition:fade={250} on:click={demo.toasts.dismiss(i)}>
                <div class="badge">{if status(i) == 2 { "★" } else { "!" }}</div>
                <div class="info">
                    <div class="head">{HEADLINES[status(i)]}</div>
                    <div class="name">{demo.toasts.text(i)}</div>
                    <div class="what">{dialogue.questWhat(quest(i))}</div>
                    {#if quest(i) == 0}
                        <div class="prog">
                            <game.Bar value={progress(i)} max={dialogue.questGoal(0)} kind={2} label="" compact={true} />
                            <span>{progress(i)}/{dialogue.questGoal(0)}</span>
                        </div>
                    {/if}
                </div>
            </div>
        {/if}
    {/each}
</div>

<style>
    .toasts { position: fixed; right: 16px; top: 16px; z-index: 1100; display: flex; flex-direction: column; gap: 8px; width: 250px; }
    .qt { display: flex; gap: 10px; padding: 10px 12px; background: #1e1e2e; border: 1px solid #585b70; border-left: 4px solid #89b4fa; border-radius: 8px; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.55); animation: slidein 260ms ease-out; }
    .qt.done { border-left-color: #f9e2af; box-shadow: 0 0 14px rgba(249, 226, 175, 0.5), 0 8px 22px rgba(0, 0, 0, 0.55); }
    .badge { width: 28px; height: 28px; border-radius: 14px; display: flex; justify-content: center; align-items: center; background: #89b4fa; color: #11111b; font-weight: bold; font-size: 16px; }
    .done .badge { background: #f9e2af; }
    .info { flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .head { font-size: 11px; color: #89b4fa; }
    .done .head { color: #f9e2af; }
    .name { font-weight: bold; }
    .prog { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #f9e2af; }
    .what { font-size: 12px; color: #a6adc8; }
    @keyframes slidein { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: translateX(0); } }
</style>
