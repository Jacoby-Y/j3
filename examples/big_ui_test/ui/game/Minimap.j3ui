<!-- A round minimap that rotates with the player; a compass "N" rides the rim. -->

<script>
    use big_ui_test.gameart.minimap;
    use big_ui_test.gamedemo.Demo;
    use big_ui_test.gameworld.mapPoint;

    inject demo: &Demo;

    /// North is world +z; on the map it sits at the rim, rotated by the player's heading.
    fn northX(): f32 {
        let np = mapPoint(0.0, 0.0, demo.yaw, 0.0, 1.0);
        return 56.0 + np.x * 46.0 - 6.0;
    }

    fn northY(): f32 {
        let np = mapPoint(0.0, 0.0, demo.yaw, 0.0, 1.0);
        return 56.0 + np.y * 46.0 - 8.0;
    }
</script>

<div class="map">
    <canvas class="view" on:draw={minimap(size, demo)}></canvas>
    <span class="n" left={northX()} top={northY()}>N</span>
</div>

<style>
    .map { position: relative; width: 112px; height: 112px; border-radius: 56px; border: 3px solid #cdd6f4; overflow: hidden; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.6); }
    .view { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
    .n { position: absolute; width: 12px; font-size: 12px; font-weight: bold; color: #f38ba8; text-shadow: 0 1px 2px #000; }
</style>
