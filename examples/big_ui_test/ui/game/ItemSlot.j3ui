<!-- One inventory cell: rarity border and glow, glyph, stack count, and a hover card with the item's details. -->

<script>
    use big_ui_test.items;

    props {
        kind: int;      // item kind, -1 for an empty cell
        rarity: int;    // 0 common .. 4 legendary
        count: int;
        selected: bool;
    }
    events { pick; }
</script>

<div class="slot r{rarity}" class:empty={kind < 0} class:sel={selected} on:click={emit pick}>
    {#if kind >= 0}
        <span class="glyph">{items.glyph(kind)}</span>
        {#if count > 1}
            <span class="count">{count}</span>
        {/if}
        <div class="tip">
            <div class="title">{items.name(kind)}</div>
            <div class="rar">{items.rarityName(rarity)}</div>
            <div class="desc">{items.desc(kind)}</div>
        </div>
    {/if}
</div>

<style>
    .slot { position: relative; width: 40px; height: 40px; display: flex; justify-content: center; align-items: center; background: #181825; border: 2px solid #45475a; border-radius: 6px; transition: border-color 120ms, background 120ms; }
    .slot.empty { background: #11111b; border-color: #313244; }
    .slot:hover { background: #313244; }
    .slot.r1 { border-color: #a6e3a1; }
    .slot.r2 { border-color: #89b4fa; box-shadow: 0 0 6px rgba(137, 180, 250, 0.45); }
    .slot.r3 { border-color: #cba6f7; box-shadow: 0 0 9px rgba(203, 166, 247, 0.6); }
    .slot.r4 { border-color: #f9e2af; box-shadow: 0 0 12px rgba(249, 226, 175, 0.75); }
    .slot.sel { border-color: #fff; transform: scale(1.08); }
    .glyph { font-family: "Symbols"; font-size: 20px; color: #cdd6f4; }
    .count { position: absolute; right: 2px; bottom: 0; font-size: 10px; font-weight: bold; color: #fff; text-shadow: 0 1px 2px #000; }
    .tip { display: none; position: absolute; left: 100%; top: 0; z-index: 90; width: 150px; padding: 8px 10px; background: #1e1e2e; border: 1px solid #585b70; border-radius: 8px; box-shadow: 0 10px 24px rgba(0, 0, 0, 0.6); position-try-fallbacks: flip-both; animation: tipin 120ms ease-out; }
    .slot:hover > .tip { display: block; }
    .title { font-weight: bold; font-size: 13px; color: #f5e0dc; }
    .rar { font-size: 11px; color: #89b4fa; margin: 2px 0 4px 0; }
    .r1 .rar { color: #a6e3a1; }
    .r3 .rar { color: #cba6f7; }
    .r4 .rar { color: #f9e2af; }
    .desc { font-size: 11px; color: #a6adc8; white-space: normal; }
    @keyframes tipin { from { opacity: 0; } to { opacity: 1; } }
</style>
