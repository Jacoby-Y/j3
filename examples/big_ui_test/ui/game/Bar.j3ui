<!-- One resource bar (health, mana, stamina...): a fill that eases to the value and a pale "ghost" that
     shows what was just lost and catches up after a short hold. Both are absolute boxes whose `width` is
     bound with `style:width`; the easing and the hold are CSS transitions (`transition: width 150ms` and
     `width 400ms ease 450ms`), so the script holds no animation state. -->

<script>
    use j3.math.clampi;

    props {
        value: int;
        max: int;
        kind: int;          // 0 health, 1 mana, 2 stamina
        label: string;
        compact: bool;      // 80 px wide instead of 180
    }

    fn shown(): int {
        return clampi(value, 0, max);
    }

    fn pct(): f32 {
        return if max <= 0 { 0.0 } else { f32(shown()) / f32(max) };
    }
</script>

<div class="bar" class:compact={compact}>
    <div class="track" class:hp={kind == 0} class:mp={kind == 1} class:sp={kind == 2} class:low={kind == 0 && pct() < 0.25}>
        <div class="ghost" style:width="{pct() * 100.0}%"></div>
        <div class="fill" style:width="{pct() * 100.0}%"></div>
        <div class="sheen"></div>
        {#if !compact}
            <div class="text"><span class="name">{label}</span><span>{shown()} / {max}</span></div>
        {/if}
    </div>
</div>

<style>
    .bar { width: 180px; height: 18px; }
    .bar.compact { width: 80px; height: 8px; }
    .track { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 9px; clip-path: inset(0px round 9px); background: #0b0b12; border: 1px solid rgba(255, 255, 255, 0.14); }
    .compact .track { border-radius: 4px; clip-path: inset(0px round 4px); }
    .fill, .ghost { position: absolute; top: 0; left: 0; width: 0; height: 100%; }
    .fill { transition: width 150ms ease-out; }
    .ghost { background: rgba(255, 255, 255, 0.55); transition: width 400ms ease-out 450ms; }
    .hp .fill { background: linear-gradient(90deg, #a6283f, #f38ba8); }
    .mp .fill { background: linear-gradient(90deg, #2a58c4, #89b4fa); }
    .sp .fill { background: linear-gradient(90deg, #d97a1c, #f9e2af); }
    .low .fill { animation: danger 520ms ease-in-out infinite alternate; }
    @keyframes danger { from { opacity: 1; } to { opacity: 0.55; } }
    .sheen { position: absolute; left: 0; top: 0; width: 100%; height: 45%; background: rgba(255, 255, 255, 0.16); }
    .text { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; justify-content: space-between; align-items: center; padding: 0 8px; font-size: 11px; color: #fff; text-shadow: 0 1px 2px #000; }
    .name { font-weight: bold; }
</style>
