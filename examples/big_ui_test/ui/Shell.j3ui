<!-- Root: nav stack on the left, the open page on the right. -->

<script>
    use big_ui_test.page.startPage;

    let page: int = startPage();
    let navOpen: bool = true;

    const NAMES: [19]string = ["Text", "Text Effects", "Unicode & Icons", "Buttons & Inputs", "Layout", "Colors & Borders", "Hover & Motion", "Canvas", "Scrolling", "Widgets", "Overlays", "Panels", "Images & Shapes", "Post Effects", "Game UI", "Motion Polish", "New in 023", "Box Styling", "ANSI Log"];
</script>

<div class="app">
    <nav class:collapsed={!navOpen}>
        <div class="top">
            <h2>UI Test</h2>
            <div class="burger" on:click={navOpen = !navOpen}>{if navOpen { "<" } else { ">" }}</div>
        </div>
        {#each 0..19 as i}
            <div class="item" class:active={page == i} on:click={page = i}><span class="num">{i + 1}</span><span class="name">{NAMES[i]}</span></div>
        {/each}
    </nav>
    <main>
        <h1>{NAMES[page]}</h1>
        {#match page}
            {:case 0}
                <pages.Text />
            {:case 1}
                <pages.TextFx />
            {:case 2}
                <pages.Unicode />
            {:case 3}
                <pages.Inputs />
            {:case 4}
                <pages.Layout />
            {:case 5}
                <pages.Colors />
            {:case 6}
                <pages.Motion />
            {:case 7}
                <pages.Canvas />
            {:case 8}
                <pages.Scroll />
            {:case 9}
                <pages.Widgets />
            {:case 10}
                <pages.Overlays />
            {:case 11}
                <pages.Panels />
            {:case 12}
                <pages.Images />
            {:case 13}
                <pages.Post />
            {:case 14}
                <pages.Game />
            {:case 15}
                <pages.Polish />
            {:case 16}
                <pages.Fresh />
            {:case 17}
                <pages.Styling />
            {:else}
                <pages.Ansi />
        {/match}
    </main>
</div>

<style>
    .app { display: flex; height: 100%; background: var(--bg); }
    nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: 200px;
        padding: 16px 12px;
        overflow-x: hidden;
        overflow-y: auto;
        white-space: nowrap;
        background: var(--panel);
        border-right: 1px solid var(--line);
        transition: width 180ms ease, padding 180ms ease;
    }
    nav.collapsed { width: 60px; padding: 16px 8px; }
    /* narrow windows start compact */
    @media (max-width: 820px) {
        nav { width: 60px; padding: 16px 8px; }
    }
    .top { display: flex; justify-content: space-between; align-items: center; padding: 4px 4px 12px 8px; }
    nav h2 { font-size: 18px; color: var(--accent); }
    .burger { padding: 2px 8px; border-radius: 6px; color: var(--muted); }
    .burger:hover { background: var(--hover); color: var(--text); }
    .item { display: flex; gap: 24px; padding: 8px 12px; border-radius: 8px; color: var(--muted); transition: background 120ms; }
    .num { width: 24px; text-align: center; color: var(--accent); }
    .item:hover { background: var(--hover); color: var(--text); }
    .item.active { background: var(--raised); color: var(--text); border-left: 3px solid var(--accent); }
    main { flex: 1; min-width: 0; min-height: 0; overflow-x: hidden; overflow-y: auto; padding: 20px 24px; }
    main h1 { font-size: 24px; margin-bottom: 16px; }
</style>
