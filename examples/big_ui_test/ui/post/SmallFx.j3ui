<!-- Many small `filter` groups (the cost of an effect group should follow its area), plus the
     dynamic-ancestor-class leak case: `class:glow` on the root, a filter set by a descendant rule in
     another component on an animated box. `UI_POST_TAB=3` opens it; goldens in ../../golden.toml. -->
<script>
    let glow: bool = true;
</script>

<div class="small" class:glow={glow}>
    <div class="row">
        {#each 0..4 as i}<div class="nav-bar"></div>{/each}
    </div>
    <div class="row">
        {#each 0..4 as i}<div class="hud"><div class="fill" style:width={`{30 + i * 20}%`}></div></div>{/each}
    </div>
    <div class="row">
        {#each 0..4 as i}<div class="icon">{i + 1}</div>{/each}
    </div>
    <div class="row">
        <div class="clipper"><div class="icon clipped">C</div></div>
        <div class="icon blurred">B</div>
        <div class="icon blended">S</div>
        <div class="icon outer"><div class="inner">N</div></div>
    </div>
    <post.SmallTitle />
</div>

<style>
    .small { display: flex; flex-direction: column; gap: 28px; padding: 24px; background: #101018; }
    .row { display: flex; gap: 40px; align-items: center; }
    .nav-bar { width: 140px; height: 4px; background: #7cf; filter: bloom(1.2); }
    .hud { width: 160px; height: 10px; background: #222a; border-radius: 5px; }
    .fill { height: 10px; border-radius: 5px; background: #f84; filter: bloom(1); }
    .icon { width: 72px; height: 72px; border-radius: 14px; background: #c6f; color: #fff; font-size: 28px;
        display: flex; align-items: center; justify-content: center; filter: bloom(0.8); }
    .clipper { width: 72px; height: 72px; overflow: hidden; }
    .clipped { background: #6f9; }
    .blurred { background: #fc5; filter: blur(6px); }
    .blended { background: #f55; mix-blend-mode: screen; filter: none; }
    .outer { background: #59f; }
    .inner { width: 36px; height: 36px; border-radius: 8px; background: #fff; color: #000; font-size: 18px;
        display: flex; align-items: center; justify-content: center; filter: bloom(1.5); }
</style>
