<script>
    use big_ui_test.postconfig.{ digit, option };
    use j3.text.same;
    let effect: int = digit("UI_POST_FX", 1, 5);
    let color: string = option("UI_POST_COLOR", "sepia");
    let blend: string = option("UI_POST_BLEND", "screen");
</script>

<div class="postfx">
    <div class="intro">An offscreen group includes its shapes and text. Compare the original with one effect or a combined chain.</div>
    <div class="presets">
        <button class:chosen={effect == 0} on:click={effect = 0}>Clean</button>
        <button class:chosen={effect == 1} on:click={effect = 1}>Bloom</button>
        <button class:chosen={effect == 2} on:click={effect = 2}>Grain</button>
        <button class:chosen={effect == 3} on:click={effect = 3}>Scanlines</button>
        <button class:chosen={effect == 4} on:click={effect = 4}>CRT</button>
        <button class:chosen={effect == 5} on:click={effect = 5}>Combined</button>
    </div>
    <div class="compare">
        {#each 0..2 as side}
            <div class="example">
                <div class="caption">{if side == 0 { "Original" } else { "Filtered group" }}</div>
                <div class="neon" class:bloom={side == 1 && effect == 1} class:grain={side == 1 && effect == 2} class:scan={side == 1 && effect == 3} class:crt={side == 1 && effect == 4} class:combined={side == 1 && effect == 5}>
                    <div class="neon-grid">
                        {#each 0..30 as cell}<div></div>{/each}
                    </div>
                    <div class="ring"></div>
                    <div class="beam"></div>
                    <div class="neon-title">AFTER HOURS</div>
                    <div class="neon-copy">Light / texture / signal</div>
                    <div class="neon-bars"><div></div><div></div><div></div><div></div></div>
                </div>
            </div>
        {/each}
    </div>
    <div class="recipe">{if effect == 0 { "filter: none" } else { if effect == 1 { "filter: bloom(1.4)" } else { if effect == 2 { "filter: grain(0.35)" } else { if effect == 3 { "filter: scanlines(0.65)" } else { if effect == 4 { "filter: crt(0.65)" } else { "filter: bloom(0.8) grain(0.12) scanlines(0.35) crt(0.4)" } } } } }}</div>
    <div class="compare lower">
        <section>
            <div class="subhead">Color filters</div>
            <select bind:value={color}>
                <option value="none">Original</option><option value="gray">Grayscale</option><option value="sepia">Sepia</option><option value="invert">Invert</option><option value="hue">Hue rotate</option><option value="bright">Brightness</option><option value="contrast">Contrast</option><option value="saturate">Saturation</option>
            </select>
            <div class="photo-row">
                <img src="assets/img/photo.jpg" />
                <div class="photo-group" class:gray={same(color, "gray")} class:sepia={same(color, "sepia")} class:invert={same(color, "invert")} class:hue={same(color, "hue")} class:bright={same(color, "bright")} class:contrast={same(color, "contrast")} class:saturate={same(color, "saturate")}>
                    <img src="assets/img/photo.jpg" /><div class="chips"><div></div><div></div><div class="gold"></div></div>
                </div>
            </div>
            <div class="caption">Original at left / selected filter at right</div>
        </section>
        <section>
            <div class="subhead">Blend with the backdrop</div>
            <select bind:value={blend}><option value="normal">Normal</option><option value="multiply">Multiply</option><option value="screen">Screen</option><option value="overlay">Overlay</option><option value="add">Add</option></select>
            <div class="blend-stage">
                <div class="blend-back"><div></div><div></div><div></div><div class="warm"></div></div>
                <div class="blend-ink" class:multiply={same(blend, "multiply")} class:screen={same(blend, "screen")} class:overlay={same(blend, "overlay")} class:add={same(blend, "add")}><div class="blend-dot"></div><div class="blend-label">COLOR MIX</div></div>
            </div>
            <div class="caption">mix-blend-mode: {blend}</div>
        </section>
    </div>
    <div class="note">Grain is deterministic for a fixed frame time. Bloom uses an LDR brightness threshold. CRT bends the image and adds a vignette; scanlines and grain can be combined with it.</div>
</div>

<style>
    .postfx { display: flex; flex-direction: column; gap: 14px; }
    .intro { font-size: 14px; }
    .presets { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
    button { font-size: 12px; padding: 8px 6px; }
    button.chosen { background: var(--accent); color: #11111b; }
    .compare { display: flex; gap: 18px; }
    .example { display: flex; flex-direction: column; gap: 8px; min-width: 0; flex: 1; }
    .caption { font-size: 12px; color: var(--muted); }
    .neon { position: relative; height: 220px; background: #080e20; overflow: hidden; }
    .neon-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px; }
    .neon-grid div { height: 43px; border: 1px solid #182e48; }
    .ring { position: absolute; right: 16px; top: 24px; width: 112px; height: 112px; border-radius: 56px; border: 5px solid #eaffff; }
    .beam { position: absolute; top: 146px; left: 0; width: 100%; height: 4px; background: #ff82b1; }
    .neon-title { position: absolute; left: 18px; top: 58px; font-size: 27px; font-weight: 700; color: #fcffff; }
    .neon-copy { position: absolute; left: 18px; top: 100px; font-size: 13px; color: #8ef1e7; }
    .neon-bars { position: absolute; left: 18px; bottom: 20px; display: flex; gap: 9px; }
    .neon-bars div { width: 36px; height: 10px; background: #eaffff; }
    .bloom { filter: bloom(1.4); }
    .grain { filter: grain(0.35); }
    .scan { filter: scanlines(0.65); }
    .crt { filter: crt(0.65); }
    .combined { filter: bloom(0.8) grain(0.12) scanlines(0.35) crt(0.4); }
    .recipe { font-size: 12px; color: #89dceb; }
    section { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; padding: 12px; background: var(--panel); border-radius: 12px; }
    .subhead { font-size: 14px; color: var(--text); }
    select { width: 100%; height: 30px; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; background: var(--raised); color: var(--text); }
    .photo-row { display: flex; gap: 8px; }
    .photo-row > img { width: 48%; height: 110px; object-fit: cover; }
    .photo-group { width: 48%; position: relative; }
    .photo-group img { width: 100%; height: 110px; object-fit: cover; }
    .chips { position: absolute; left: 8px; bottom: 8px; display: flex; gap: 4px; }
    .chips div { width: 16px; height: 16px; background: #ff6b8b; }
    .chips div:first-child { background: #55d9f6; }
    .chips div.gold { background: #ffd96d; }
    .gray { filter: grayscale(1); }
    .sepia { filter: sepia(1); }
    .invert { filter: invert(1); }
    .hue { filter: hue-rotate(120deg); }
    .bright { filter: brightness(1.7); }
    .contrast { filter: contrast(1.8); }
    .saturate { filter: saturate(2.5); }
    .blend-stage { position: relative; height: 110px; overflow: hidden; background: #143f66; }
    .blend-back { display: grid; grid-template-columns: repeat(4, 1fr); }
    .blend-back div { height: 110px; background: #944d82; }
    .blend-back div:first-child { background: #28628e; }
    .blend-back div.warm { background: #ba713c; }
    .blend-ink { position: absolute; left: 16px; top: 16px; width: 86%; height: 78px; background: #4aa5b3; }
    .blend-dot { position: absolute; right: 16px; top: 8px; width: 62px; height: 62px; border-radius: 31px; background: #ffd886; }
    .blend-label { position: absolute; left: 12px; top: 28px; font-size: 20px; font-weight: 700; color: #e4c5f9; }
    .multiply { mix-blend-mode: multiply; }
    .screen { mix-blend-mode: screen; }
    .overlay { mix-blend-mode: overlay; }
    .add { mix-blend-mode: add; }
    .note { font-size: 12px; color: var(--muted); line-height: 1.5; }
    @media (max-width: 760px) {
        .compare { flex-direction: column; }
        .example { flex: 0; }
        .presets { grid-template-columns: repeat(3, 1fr); }
    }
</style>
