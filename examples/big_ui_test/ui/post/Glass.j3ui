<!-- Backdrop blur keeps foreground sharp; content blur filters the whole group. -->
<script>
    let enabled = true;
    let radius: int = 8;
    let contentBlur = true;
</script>

<div class="post">
    <div class="intro">Backdrop blur samples the scene already painted behind a panel. Its own text and border stay sharp.</div>
    <div class="controls">
        <button class:chosen={enabled} on:click={enabled = !enabled}>{if enabled { "Blur on" } else { "Blur off" }}</button>
        <button class:chosen={radius == 4} on:click={radius = 4}>4 px</button>
        <button class:chosen={radius == 8} on:click={radius = 8}>8 px</button>
        <button class:chosen={radius == 16} on:click={radius = 16}>16 px</button>
    </div>
    <div class="compare">
        {#each 0..2 as side}
            <div class="example">
                <div class="caption">{if side == 0 { "Reference / translucent only" } else { "Frosted glass / backdrop blur" }}</div>
                <div class="scene">
                    <div class="pattern">
                        {#each 0..96 as tile}
                            <div class="tile" class:light={(tile + tile / 12) % 2 == 0}></div>
                        {/each}
                    </div>
                    <div class="orb"></div>
                    <div class="stripe"></div>
                    <div class="backtype"><div>BACKDROP</div><div>0123456789</div><div>SHARP LINES</div></div>
                    <div class="glass" class:frost={side == 1} class:soft={radius == 4} class:strong={radius == 16} class:off={!enabled}>
                        <div class="eyebrow">{if side == 0 { "NO FILTER" } else { if enabled { "BLUR ENABLED" } else { "BLUR DISABLED" } }}</div>
                        <h2>Clear foreground.</h2>
                        <div class="copy">The same tint and rounded border. Compare the checks, letters and gold edge behind this card.</div>
                        {#if side == 1 && enabled}
                            <div class="status">backdrop-filter: blur({radius}px)</div>
                        {:else}
                            <div class="status">backdrop-filter: none</div>
                        {/if}
                    </div>
                    <div class="foot">Detail outside the card stays sharp</div>
                </div>
            </div>
        {/each}
    </div>
    <div class="controls"><button class:chosen={contentBlur} on:click={contentBlur = !contentBlur}>Content blur {if contentBlur { "on" } else { "off" }}</button></div>
    <div class="compare">
        <div class="content"><h2>Original content</h2><div>Shapes, text and background stay sharp.</div><div class="swatches"><div></div><div></div><div></div></div></div>
        <div class="content" class:blurred={contentBlur}><h2>Gaussian content</h2><div>The complete subtree can be blurred together.</div><div class="swatches"><div></div><div></div><div></div></div></div>
    </div>
    <div class="note">Toggle content blur to apply filter: blur(3px). Backdrop uses Gaussian sigma in logical pixels and samples only what has already been painted behind the card.</div>
</div>

<style>
    .post { display: flex; flex-direction: column; gap: 16px; }
    .intro { color: var(--text); font-size: 14px; }
    .controls { display: flex; gap: 8px; }
    button { padding: 8px 14px; font-size: 13px; }
    button.chosen { background: var(--accent); color: #11111b; }
    .compare { display: flex; gap: 18px; }
    .example { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
    .caption { font-size: 13px; color: var(--muted); }
    .scene { position: relative; height: 340px; overflow: hidden; border-radius: 16px; background: #142334; }
    .pattern { display: grid; grid-template-columns: repeat(12, 1fr); gap: 3px; height: 100%; }
    .tile { height: 40px; background: #13576a; }
    .tile.light { background: #62c8c6; }
    .orb { position: absolute; top: 20px; right: 8px; width: 150px; height: 150px; border-radius: 75px; background: #ffc568; }
    .stripe { position: absolute; top: 202px; left: 0; width: 100%; height: 18px; background: #ff7698; }
    .backtype { position: absolute; top: 80px; left: 14px; font-size: 32px; font-weight: 700; line-height: 1.5; color: #091522; }
    .glass { position: absolute; top: 62px; left: 18px; right: 18px; height: 228px; display: flex; flex-direction: column; gap: 12px; padding: 20px; border: 1px solid rgba(255, 255, 255, 0.65); border-radius: 24px; background: rgba(15, 24, 42, 0.58); color: #ffffff; }
    .glass.frost { backdrop-filter: blur(8px); }
    .glass.frost.soft { backdrop-filter: blur(4px); }
    .glass.frost.strong { backdrop-filter: blur(16px); }
    .glass.frost.off { backdrop-filter: none; }
    .eyebrow { font-size: 11px; color: #d1f7ff; }
    h2 { font-size: 22px; font-weight: 700; }
    .copy { font-size: 14px; line-height: 1.4; }
    .status { font-size: 12px; color: #d1f7ff; }
    .foot { position: absolute; left: 18px; bottom: 16px; font-size: 11px; color: #ffffff; background: #142334; padding: 4px 8px; border-radius: 4px; }
    .note { color: var(--muted); font-size: 12px; line-height: 1.5; }
    .content { flex: 1; min-width: 0; padding: 18px; display: flex; flex-direction: column; gap: 10px; background: var(--panel); border-radius: 14px; }
    .content.blurred { filter: blur(3px); }
    .swatches { display: flex; gap: 8px; }
    .swatches div { width: 32px; height: 20px; background: #ffc568; }
    .swatches div:first-child { background: #62c8c6; }
    @media (max-width: 760px) {
        .compare { flex-direction: column; }
        .example { flex: 0; }
    }
</style>
