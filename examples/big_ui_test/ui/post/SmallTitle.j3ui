<!-- Filter from a rule that depends on an ancestor's dynamic class (`.glow` on SmallFx), on an animated box. -->
<div class="title"><h1>GLOW TITLE</h1></div>

<style>
    .title { animation: bob 1.2s ease-in-out infinite alternate; }
    @keyframes bob { from { transform: translateY(0px); } to { transform: translateY(6px); } }
    h1 { color: #ffd76a; font-size: 32px; }
    .glow .title h1 { filter: bloom(0.6); }
</style>
