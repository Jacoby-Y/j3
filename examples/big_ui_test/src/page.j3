module big_ui_test.page;

use j3.game.env;
use j3.math.Vec2;

/// The page to open first: `UI_PAGE=<number>` (0-based; headless screenshots of one page), else 0.
pub fn startPage(): int {
    let e = env("UI_PAGE");
    let v = 0;
    for i in 0..e.len {
        if int(e[i]) >= 48 && int(e[i]) < 58 {
            v = v * 10 + int(e[i]) - 48;
        }
    }
    // ponytail: 18 is the last page in ui/Shell.j3ui; bump with NAMES
    if v > 18 {
        return 18;
    }
    return v;
}

/// The window size: `UI_SIZE=<w>x<h>` (headless screenshots at another size, to see `@media`), else 1100 by 700.
pub fn startSize(): Vec2 {
    let e = env("UI_SIZE");
    let v = [0, 0];
    let k = 0;
    for i in 0..e.len {
        if int(e[i]) >= 48 && int(e[i]) < 58 {
            v[k] = v[k] * 10 + int(e[i]) - 48;
        } else if k == 0 {
            k = 1;
        }
    }
    if v[0] < 200 || v[1] < 200 {
        return Vec2 { x: 1100.0, y: 700.0 };
    }
    return Vec2 { x: f32(v[0]), y: f32(v[1]) };
}

/// `UI_VIRTUAL=<w>x<h>` draws at that virtual size, letterboxed in the window (`game.setVirtualSize`); else off.
pub fn startVirtual(): Vec2 {
    let e = env("UI_VIRTUAL");
    let v = [0, 0];
    let k = 0;
    for i in 0..e.len {
        if int(e[i]) >= 48 && int(e[i]) < 58 {
            v[k] = v[k] * 10 + int(e[i]) - 48;
        } else if k == 0 {
            k = 1;
        }
    }
    return Vec2 { x: f32(v[0]), y: f32(v[1]) };
}
