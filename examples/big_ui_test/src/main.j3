module big_ui_test;

use big_ui_test.page.{ startSize, startVirtual };
use big_ui_test.sim;
use big_ui_test.ui.{ Shell, ShellProps };
use j3.app.App;
use j3.game.{ setVirtualSize, windowSize };
use j3.memory.Arena;

struct World {
    root: Shell;
}

fn boot(mem: &Arena): World {
    return World { root: Shell.new(mem) };
}

fn draw(w: &World) {
    sim.apply(&w.root.dom);
    w.root.render(windowSize(), ShellProps {});
}

fn main() {
    let size = startSize();
    let app = App<World>.create("big_ui_test", int(size.x), int(size.y), boot);
    let virt = startVirtual();
    setVirtualSize(int(virt.x), int(virt.y));
    app.useGl();
    app.draw(draw);
    app.run();
}
