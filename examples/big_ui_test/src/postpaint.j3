module big_ui_test.postpaint;

use j3.game.{ frameCount, rgb };
use j3.gfx.paint;
use j3.gfx.paint.Effects;
use j3.math.Vec2;

#[singleton]
let BOARD: int;
#[singleton]
let SHADER: int;

fn prepare() {
    if BOARD != 0 { return; }
    BOARD = paint.target(320, 200);
    SHADER = paint.shader("vec4 effect(vec2 uv, vec4 color) { float bands = 0.8 + 0.2 * sin(uv.x * 70.0 + uTime); return vec4(mix(color.rgb, color.bgr, 0.7) * bands, color.a); }");
    paint.beginTarget(BOARD);
    paint.rect(Vec2 { x: 0, y: 0 }, Vec2 { x: 320, y: 200 }, rgb(20, 35, 58));
    for i in 0..8 {
        paint.rect(Vec2 { x: f32(i) * 40, y: 0 }, Vec2 { x: 18, y: 200 }, rgb(35, 93, 115));
    }
    paint.circle(Vec2 { x: 246, y: 56 }, 46, rgb(255, 197, 104));
    paint.roundRect(Vec2 { x: 30, y: 38 }, Vec2 { x: 180, y: 124 }, 18, rgb(98, 200, 198));
    paint.roundRect(Vec2 { x: 42, y: 50 }, Vec2 { x: 156, y: 100 }, 10, rgb(20, 35, 58));
    for i in 0..4 {
        paint.line(Vec2 { x: 54, y: 68 + f32(i) * 22 }, Vec2 { x: 172, y: 68 + f32(i) * 22 }, 5, rgb(238, 246, 255));
    }
    paint.rect(Vec2 { x: 0, y: 174 }, Vec2 { x: 320, y: 8 }, rgb(255, 118, 152));
    paint.endTarget();
}

/// The texture and shader are cached; the renderer releases both when the GL context closes.
pub fn draw(size: Vec2, custom: bool, tilt: bool) {
    prepare();
    paint.rect(Vec2 { x: 0, y: 0 }, size, rgb(15, 22, 36));
    let width = (size.x - 60) * 0.5;
    let height = width * 0.625;
    if height > size.y - 60 { height = size.y - 60; width = height * 1.6; }
    let imageSize = Vec2 { x: width, y: height };
    let left = Vec2 { x: 20, y: (size.y - height) * 0.5 };
    let right = Vec2 { x: size.x * 0.5 + 10, y: left.y };
    let tex = paint.targetTexture(BOARD);
    paint.projectTexture(tex, left, imageSize, 0, 0, 0);
    paint.beginLayer();
    paint.projectTexture(tex, right, imageSize, if tilt { 12.0 } else { 0.0 }, if tilt { -28.0 } else { 0.0 }, 600);
    let fx = Effects {};
    if custom { fx.shader = SHADER; }
    fx.time = f32(frameCount()) / 60;
    paint.endLayer(right, imageSize, fx);
}
