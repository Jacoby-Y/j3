module big_ui_test.dialogue;

// The dialogue script and quest names for the game-components demo.

pub const LINES: int = 5;

pub fn speaker(i: int): string {
    let t: [5]string = ["Elder Maren", "Elder Maren", "Elder Maren", "Traveler", "Elder Maren"];
    return t[i];
}

pub fn text(i: int): string {
    let t: [5]string = [
        "Welcome, traveler. The village has not seen a new face since the first snow fell.",
        "Listen closely. The wolves came down from the ridge last night... and they are not alone.",
        "THEY TOOK THE BELL! Without it we cannot warn the valley!",
        "How many wolves are we talking about?",
        "Five, maybe more. Hunt them, and bring back what you find. Will you help us?",
    ];
    return t[i];
}

pub fn effect(i: int): int {
    let t: [5]int = [0, 1, 2, 0, 0];
    return t[i];
}

pub fn quest(q: int): string {
    let t: [2]string = ["Wolf Hunt", "The Missing Bell"];
    return t[q];
}

pub fn questWhat(q: int): string {
    let t: [2]string = ["Defeat wolves", "Find the village bell"];
    return t[q];
}

pub fn questGoal(q: int): int {
    let t: [2]int = [5, 1];
    return t[q];
}
