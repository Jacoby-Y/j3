module big_ui_test.gameworld;

use j3.math.{ cos, sin };

// A tiny fake-3D camera: ground-plane points to view pixels. Pure math, no state.

pub const VIEW_W: f32 = 560.0;
pub const VIEW_H: f32 = 330.0;
const EYE: f32 = 1.6;
const NEAR: f32 = 0.6;
const FAR: f32 = 34.0;

pub struct Proj {
    x: f32;
    y: f32;
    depth: f32;
    shown: bool;
}

pub fn horizon(): f32 {
    return VIEW_H * 0.42;
}

/// Where world point (`wx`, `h` up, `wz`) lands for a camera at (`px`, `pz`) looking along `yaw`
/// (90 degree field of view). `shown` is false behind the camera, past the far plane or off screen.
pub fn project(px: f32, pz: f32, yaw: f32, wx: f32, wz: f32, h: f32): Proj {
    let dx = wx - px;
    let dz = wz - pz;
    let depth = dx * sin(yaw) + dz * cos(yaw);
    let side = dx * cos(yaw) - dz * sin(yaw);
    if depth < NEAR || depth > FAR {
        return Proj { x: 0.0, y: 0.0, depth: depth, shown: false };
    }
    let focal = VIEW_W * 0.5;
    let x = VIEW_W * 0.5 + side / depth * focal;
    let y = horizon() + (EYE - h) / depth * focal;
    let on = x > -30.0 && x < VIEW_W + 30.0 && y > -30.0 && y < VIEW_H + 30.0;
    return Proj { x: x, y: y, depth: depth, shown: on };
}

/// 0 near, 1 middle, 2 far: which nameplate size to use.
pub fn tier(depth: f32): int {
    if depth < 9.0 {
        return 0;
    }
    if depth < 18.0 {
        return 1;
    }
    return 2;
}

/// A point of the minimap: world (`wx`, `wz`) relative to the player, rotated so the view points up.
pub fn mapPoint(px: f32, pz: f32, yaw: f32, wx: f32, wz: f32): Proj {
    let dx = wx - px;
    let dz = wz - pz;
    let depth = dx * sin(yaw) + dz * cos(yaw);
    let side = dx * cos(yaw) - dz * sin(yaw);
    return Proj { x: side, y: 0.0 - depth, depth: depth, shown: true };
}
