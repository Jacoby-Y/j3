module big_ui_test.postconfig;

use j3.game.env;

/// Deterministic initial state for headless Post Effects captures.
pub fn digit(key: string, fallback: int, max: int): int {
    let e = env(key);
    if e.len > 0 && e[0] >= 48 && int(e[0]) <= 48 + max { return int(e[0]) - 48; }
    return fallback;
}

pub fn option(key: string, fallback: string): string {
    let e = env(key);
    return if e.len > 0 { e } else { fallback };
}
