module big_ui_test.ansidemo;

use j3.memory.Arena;
use j3.text.Text;
use j3.ui.ansi.AnsiLog;

#[singleton]
let LOG: AnsiLog;
#[singleton]
let ARENA: Arena;
#[singleton]
let STARTED: bool;

/// `~` stands for ESC, since J3 strings have no escape for it.
fn esc(s: string, mem: &Arena): string {
    let t = Text.new(mem);
    for i in 0..s.len {
        t.push(if s[i] == 126 { 27 } else { s[i] });
    }
    return t.str();
}

/// The one demo log, filled once: captured `ls --color`, a compiler error, SGR attributes, a progress bar, a
/// 256-color ramp. 0xcdd6f4 and 0x11111b are the page's text and pane colors (the page CSS), for inverse and dim.
pub fn demoLog(): &AnsiLog {
    if !STARTED {
        ARENA = Arena.create(4194304);
        LOG = AnsiLog.new(0xcdd6f4, 0x11111b, 1000);
        let a = &ARENA;
        LOG.append(esc("$ ls --color\n~[1;34msrc~[0m  ~[1;34mui~[0m  ~[0;32mrun.sh~[0m  ~[1;36mlatest~[0m  ~[0;31marchive.tar.gz~[0m  notes.txt\n", a));
        LOG.append(esc("$ j3c build\n~[1m~[31merror~[0m~[1m: no method `new`~[0m\n  ~[34m-->~[0m src/main.j3:34:19\n   ~[34m|~[0m\n~[34m34 |~[0m     let a = Arena.~[1;31m^^^~[0m\n", a));
        LOG.append(esc("~[1mbold~[0m ~[2mdim~[0m ~[3mitalic~[0m ~[4munderline~[0m ~[9mstrike~[0m ~[7minverse~[0m ~[8mhidden~[0m ~[1;3;4mall three~[0m\n", a));
        LOG.append(esc("~[31mred~[0m ~[32mgreen~[0m ~[33myellow~[0m ~[34mblue~[0m ~[35mmagenta~[0m ~[36mcyan~[0m ~[91mbright red~[0m ~[42;30m on green ~[0m\n", a));
        let t = Text.new(a);
        for i in 16..232 {
            t.pushStr("~[48;5;");
            t.pushInt(i);
            t.pushStr("m ~[0m");
            if (i - 15) % 36 == 0 {
                t.push(10);
            }
        }
        LOG.append(esc(t.str(), a));
        LOG.append(esc("~[38;2;255;160;40mtruecolor~[0m ~[2K~[1;1H(cursor escapes are dropped)\n", a));
        LOG.append("downloading 10%\rdownloading 55%\rdownloading 100%\n");
        STARTED = true;
    }
    return &LOG;
}
