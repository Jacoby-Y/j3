module big_ui_test.gameart;

use big_ui_test.gamedemo.{ Demo, MOBS };
use big_ui_test.gameworld;
use j3.game.{ Color, rgb, rgba };
use j3.gfx.paint;
use j3.math.{ cos, min, sin, PI, TAU, Vec2 };

// Canvas painting for the game components: a cooldown sweep, the minimap, the world backdrop.

#[singleton]
let PTS: [160]f32;

fn put(k: int, x: f32, y: f32) {
    PTS[2 * k] = x;
    PTS[2 * k + 1] = y;
}

/// A pie slice of `frac` (0..1) of a circle, clockwise from the top: the cooldown "clock wipe".
pub fn pie(c: Vec2, r: f32, frac: f32, color: Color) {
    if frac <= 0.0 {
        return;
    }
    let f = min(frac, 1.0);
    let steps = 48;
    put(0, c.x, c.y);
    for k in 0..=steps {
        let a = 0.0 - PI * 0.5 + TAU * f * f32(k) / f32(steps);
        put(k + 1, c.x + r * cos(a), c.y + r * sin(a));
    }
    put(steps + 2, c.x, c.y);
    paint.fillShape(PTS[0..160], steps + 3, false, color);
}

fn poly4(a: Vec2, b: Vec2, c: Vec2, d: Vec2, color: Color) {
    put(0, a.x, a.y);
    put(1, b.x, b.y);
    put(2, c.x, c.y);
    put(3, d.x, d.y);
    put(4, a.x, a.y);
    paint.fillShape(PTS[0..160], 5, false, color);
}

/// Where a minimap point lands: `c` is the center, `scale` px per world unit.
fn mapAt(d: &Demo, c: Vec2, scale: f32, wx: f32, wz: f32): Vec2 {
    let p = gameworld.mapPoint(d.px, d.pz, d.yaw, wx, wz);
    return Vec2 { x: c.x + p.x * scale, y: c.y + p.y * scale };
}

/// The minimap: a rotating map around the player, buildings, mobs (pinned to the rim when far), a view wedge.
pub fn minimap(size: Vec2, d: &Demo) {
    let c = Vec2 { x: size.x * 0.5, y: size.y * 0.5 };
    let r = size.x * 0.5 - 2.0;
    let scale = r / 16.0;
    paint.circle(c, r, rgb(24, 36, 30));
    paint.ring(c, r * 0.5, 1.0, rgba(255, 255, 255, 26));
    paint.ring(c, r * 0.97, 1.0, rgba(255, 255, 255, 40));
    // three fixed buildings
    for b in 0..3 {
        let bx = f32(b - 1) * 12.0;
        let bz = f32((b * 5) % 3 - 1) * 9.0 + 4.0;
        let h: f32 = 2.0;
        poly4(mapAt(d, c, scale, bx - h, bz - h), mapAt(d, c, scale, bx + h, bz - h), mapAt(d, c, scale, bx + h, bz + h), mapAt(d, c, scale, bx - h, bz + h), rgb(73, 80, 102));
    }
    // the camera's field of view
    put(0, c.x, c.y);
    put(1, c.x - r * 0.9, c.y - r * 0.9);
    put(2, c.x + r * 0.9, c.y - r * 0.9);
    put(3, c.x, c.y);
    paint.fillShape(PTS[0..160], 4, false, rgba(137, 180, 250, 40));
    for i in 0..MOBS {
        if d.mobs[i].hp <= 0 {
            continue;
        }
        let p = mapAt(d, c, scale, d.mobs[i].x, d.mobs[i].z);
        let off = Vec2 { x: p.x - c.x, y: p.y - c.y };
        let len = off.length();
        let far = len > r - 5.0;
        let q = if far { Vec2 { x: c.x + off.x / len * (r - 5.0), y: c.y + off.y / len * (r - 5.0) } } else { p };
        paint.circle(q, if far { 2.0 } else { 3.0 }, if far { rgba(243, 139, 168, 140) } else { rgb(243, 139, 168) });
    }
    // the player: an arrow
    put(0, c.x, c.y - 6.0);
    put(1, c.x + 4.5, c.y + 5.0);
    put(2, c.x, c.y + 2.5);
    put(3, c.x - 4.5, c.y + 5.0);
    put(4, c.x, c.y - 6.0);
    paint.fillShape(PTS[0..160], 5, false, rgb(249, 226, 175));
}

/// The 3D-ish backdrop: sky, ground, stripes sliding past, and the mobs as blobs (far to near).
pub fn backdrop(size: Vec2, d: &Demo) {
    let hz = gameworld.horizon();
    paint.rect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: size.x, y: hz }, rgb(30, 34, 60));
    paint.rect(Vec2 { x: 0.0, y: hz * 0.6 }, Vec2 { x: size.x, y: hz * 0.4 }, rgb(48, 52, 86));
    paint.rect(Vec2 { x: 0.0, y: hz }, Vec2 { x: size.x, y: size.y - hz }, rgb(30, 46, 40));
    let focal = size.x * 0.5;
    let travel = d.t * 3.5;
    for k in 0..9 {
        let depth = 1.2 + f32(k) * 3.5 - (travel % 3.5);
        if depth > 0.8 {
            let y = hz + 1.6 / depth * focal;
            if y < size.y {
                paint.rect(Vec2 { x: 0.0, y: y }, Vec2 { x: size.x, y: 1.0 }, rgba(255, 255, 255, 18));
            }
        }
    }
    for t in 0..3 {
        let tierNow = 2 - t;
        for i in 0..MOBS {
            if d.mobs[i].shown && gameworld.tier(d.mobs[i].depth) == tierNow {
                blob(d, i, focal, hz);
            }
        }
    }
}

fn blob(d: &Demo, i: int, focal: f32, hz: f32) {
    let z = d.mobs[i].depth;
    let foot = hz + 1.6 / z * focal;
    let top = hz - 0.2 / z * focal;
    let w = 0.9 / z * focal;
    let x = d.mobs[i].sx;
    paint.roundRect(Vec2 { x: x - w * 0.7, y: foot - w * 0.12 }, Vec2 { x: w * 1.4, y: w * 0.24 }, w * 0.12, rgba(0, 0, 0, 90));
    paint.roundRect(Vec2 { x: x - w * 0.5, y: top }, Vec2 { x: w, y: foot - top }, w * 0.4, rgb(90 + u8(d.mobs[i].lvl * 20), 70, 90));
    paint.circle(Vec2 { x: x - w * 0.18, y: top + (foot - top) * 0.3 }, w * 0.07, rgb(250, 240, 200));
    paint.circle(Vec2 { x: x + w * 0.18, y: top + (foot - top) * 0.3 }, w * 0.07, rgb(250, 240, 200));
}
