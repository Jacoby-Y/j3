module big_ui_test.items;

// Item catalog for the game-components demo: plain tables, no UI.

pub const KINDS: int = 12;
pub const RARITIES: int = 5;


pub fn glyph(kind: int): string {
    let t: [12]string = ["🗡", "🛡", "❤", "⚡", "🪙", "💣", "🗝", "⭐", "☠", "🏆", "💰", "👍"];
    return t[kind];
}

pub fn name(kind: int): string {
    let t: [12]string = ["Iron Sword", "Oak Shield", "Healing Draught", "Storm Charm", "Gold Coins", "Bomb", "Rusty Key", "Star Shard", "Cursed Skull", "Champion Cup", "Treasure Bag", "Lucky Glove"];
    return t[kind];
}

pub fn desc(kind: int): string {
    let t: [12]string = ["A plain blade. Reliable.", "Blocks the first hit.", "Restores 40 health.", "Crackles when you run.", "Spend them wisely.", "Handle with care.", "Opens something old.", "Hums with light.", "Whispers at night.", "Proof of victory.", "Heavy and clinking.", "Better odds, maybe."];
    return t[kind];
}

pub fn rarityName(r: int): string {
    let t: [5]string = ["Common", "Uncommon", "Rare", "Epic", "Legendary"];
    return t[r];
}

/// A cheap deterministic hash, so the demo inventory is the same every run.
pub fn hash(i: int): int {
    let h = (i * 2654435761 + 12345) % 1000003;
    if h < 0 {
        h = 0 - h;
    }
    return h;
}

/// Kind stored in slot `i`, or -1 for an empty slot.
pub fn kindAt(i: int): int {
    let h = hash(i);
    if h % 4 == 0 {
        return -1;
    }
    return h / 7 % KINDS;
}

/// Rarity (0..4) of slot `i`: mostly common, legendary is rare.
pub fn rarityAt(i: int): int {
    let r = hash(i + 91) % 20;
    if r < 9 {
        return 0;
    }
    if r < 14 {
        return 1;
    }
    if r < 17 {
        return 2;
    }
    if r < 19 {
        return 3;
    }
    return 4;
}

pub fn countAt(i: int): int {
    let k = kindAt(i);
    if k == 4 || k == 5 {
        return 1 + hash(i + 5) % 40;
    }
    return 1;
}
