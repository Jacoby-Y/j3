module big_ui_test.sim;

use j3.game.{ env, setWindowSize };
use j3.ui.dom.Dom;

#[singleton]
let MX: f32;
#[singleton]
let MY: f32;
#[singleton]
let MDOWN: bool;
#[singleton]
let MRIGHT: bool;
#[singleton]
let STARTED: bool;

fn digit(c: u8): bool {
    return c >= 48 && c < 58;
}

/// The unsigned number at `s[i..]` (0 when there is none); `at` is set past it.
fn number(s: string, i: int, at: &int): int {
    let v = 0;
    let k = i;
    while k < s.len && digit(s[k]) {
        v = v * 10 + int(s[k]) - 48;
        k += 1;
    }
    *at = k;
    return v;
}

/// Headless input for screenshots. `UI_MOUSE=x,y[,1]` hovers there, `1` also holds the button from
/// frame 6 to 8 (a click). `UI_SIM="6:m=300,200,0;8:m=300,200,1;10:m=300,200,0;14:t=hello;16:k=S+Left C+a"`
/// is a script: at frame N, `m=x,y,down` moves the mouse (it stays; `down` is 0 up, 1 left button,
/// 2 right button), `w=n` turns the wheel `n` notches down once (negative: up; `Shift` with `k=` for
/// sideways), `s=w,h` resizes the window, `t=text` types, `k=names` presses keys (`j3.ui.keys.parse`) once. Entries are
/// separated by `;`.
pub fn apply(d: &Dom) {
    if !STARTED {
        STARTED = true;
        MX = -5.0;
        MY = -5.0;
    }
    let m = env("UI_MOUSE");
    if m.len > 0 {
        let at = 0;
        MX = f32(number(m, 0, &at));
        MY = f32(number(m, at + 1, &at));
        MDOWN = at < m.len && number(m, at + 1, &at) == 1 && d.frame >= 6 && d.frame < 9;
        d.simInput(MX, MY, MDOWN, 0.0);
        return;
    }
    let e = env("UI_SIM");
    if e.len == 0 {
        return;
    }
    let typed = "";
    let names = "";
    let wheel: f32 = 0.0;
    let i = 0;
    while i < e.len {
        let q = 0;
        let n = number(e, i, &q);
        let kind = e[q + 1];
        let start = q + 3;
        i = start;
        while i < e.len && e[i] != 59 {
            i += 1;
        }
        let val = e[start..i];
        i += 1;
        if n == d.frame + 1 {
            if kind == 109 {
                let p = 0;
                MX = f32(number(val, 0, &p));
                MY = f32(number(val, p + 1, &p));
                let btn = number(val, p + 1, &p);
                MDOWN = btn == 1;
                MRIGHT = btn == 2;
            } else if kind == 119 {
                let neg = val.len > 0 && val[0] == 45;
                let wat = 0;
                let notches = f32(number(val, if neg { 1 } else { 0 }, &wat));
                wheel = if neg { notches } else { 0.0 - notches };
            } else if kind == 115 {
                let sp = 0;
                let sw = number(val, 0, &sp);
                setWindowSize(sw, number(val, sp + 1, &sp));
            } else if kind == 116 {
                typed = val;
            } else if kind == 107 {
                names = val;
            }
        }
    }
    d.simRight(MRIGHT);
    d.simInput(MX, MY, MDOWN, wheel);
    if typed.len > 0 || names.len > 0 {
        d.simKeys(typed, names);
    }
}
