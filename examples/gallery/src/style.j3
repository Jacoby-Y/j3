// Gradient card, drop shadows, corner radius, and a nested wash.

module gallery.style;

use gallery.world.World;
use j3.game.rgb;
use j3.ui.Ui;

pub @j3ui stylePage(ui: &Ui, w: &World) {
    card(520, 560, rgb(22, 18, 42), rgb(u8(int(w.red)), u8(int(w.green)), u8(int(w.blue))), w.radius) {
        label("style");
        label("sliders tint this card");
        range("red", &w.red, 0, 255);
        label(`red {int(w.red)}`);
        range("green", &w.green, 0, 255);
        label(`green {int(w.green)}`);
        range("blue", &w.blue, 0, 255);
        label(`blue {int(w.blue)}`);
        range("radius", &w.radius, 0, 28);
        label(`radius {int(w.radius)}`);
        rule();
        label("shadow");
        row() {
            drop(120, 72, 0);
            drop(120, 72, w.radius);
        }
        gap(16);
        wash(400, 48, rgb(255, 214, 150), rgb(168, 52, 36), 18);
        row() {
            chip("round");
            chip("shadow");
            chip("wash");
        }
    }
}
