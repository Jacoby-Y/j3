// A panel inside a panel, and a list that scrolls.

module gallery.layout;

use gallery.world.World;
use j3.ui.Ui;

pub @j3ui layoutPage(ui: &Ui, w: &World) {
    panel(440, 360) {
        label("layout");
        panel(380, 100) {
            label("inner panel");
            label("nested chrome");
        }
        gap(8);
        scroll(1, 160) {
            for i in 0..20 {
                pushId(i) {
                    label(`row {i}`);
                }
            }
        }
    }
}
