// One column. The tab picks the page.

module gallery.draw;

use gallery.controls.controlsPage;
use gallery.layout.layoutPage;
use gallery.tabs.tabBar;
use gallery.widgets.widgetsPage;
use gallery.world.World;
use j3.game.{ clearTo, rgb };
use j3.ui.{ Theme, Ui };

@j3ui frame(ui: &Ui, w: &World) {
    tabBar(ui, w);
    gap(12);
    if w.tab == 0 {
        widgetsPage(ui, w);
    }
    if w.tab == 1 {
        controlsPage(ui, w);
    }
    if w.tab == 2 {
        layoutPage(ui, w);
    }
}

pub fn draw(w: &World) {
    clearTo(rgb(12, 10, 16));
    let ui = Ui.begin(w.font, 24, 24);
    ui.theme = Theme.dusk();
    frame(&ui, w);
}
