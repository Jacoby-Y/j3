// One column. The tab picks the page.

module gallery.draw;

use gallery.controls.controlsPage;
use gallery.layout.layoutPage;
use gallery.pack.show;
use gallery.style.stylePage;
use gallery.tabs.tabBar;
use gallery.widgets.widgetsPage;
use gallery.world.World;
use j3.game.{ Camera, clearTo, drawRect, rgb, rgba, setColor, windowSize };
use j3.math.{ Mat4, Vec2, Vec3 };
use j3.ui.{ Theme, Ui };

@j3ui frame(ui: &Ui, w: &World) {
    tabBar(ui, w);
    gap(12);
    if w.tab == 0 {
        widgetsPage(ui, w);
    }
    if w.tab == 1 {
        controlsPage(ui, w);
    }
    if w.tab == 2 {
        layoutPage(ui, w);
    }
    if w.tab == 3 {
        stylePage(ui, w);
    }
}

pub fn draw(w: &World) {
    clearTo(rgb(22, 18, 32));
    if w.tab == 4 {
        setColor(rgba(0, 0, 0, 150));
        drawRect(Vec2 { x: 0, y: 0 }, windowSize());
    }
    let ui = Ui.begin(w.font, 24, 24);
    ui.theme = Theme.dusk();
    frame(&ui, w);
    let cam = Camera.create(1);
    ui.worldLabel(cam, Vec2 { x: 40, y: 700 }, "here");
    ui.worldLabel3(Mat4.identity(), Vec3.xyz(0, 0, 0), "world");
    if w.tab == 4 {
        show(w.font, w.small);
    }
}
