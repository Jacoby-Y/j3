// Labels, a click counter, a bar, and a baked image.

module gallery.widgets;

use gallery.world.{ World, addClick };
use j3.ui.Ui;

pub @j3ui widgetsPage(ui: &Ui, w: &World) {
    panel(420, 240) {
        label("widgets");
        label("hover a button, then click it");
        label(`clicks {w.clicks}`);
        button("count") {
            addClick(w);
        }
        bar(f32(w.clicks) / f32(10));
        if w.mark.raw != 0 {
            image(w.mark);
        }
    }
}
