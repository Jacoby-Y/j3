// Labels, a click counter, a bar, and a baked image.

module gallery.widgets;

use gallery.world.{ World, addClick };
use j3.game.{ drawTextureEx, rgb };
use j3.math.Vec2;
use j3.ui.{ Ui, dragDelta };

pub @j3ui widgetsPage(ui: &Ui, w: &World) {
    panel(420, 240) {
        label("widgets");
        label("Tab/Shift-Tab focus, Enter/Space click");
        label(`clicks {w.clicks}`);
        button("count") {
            addClick(w);
        }
        field("name", &w.name);
        label(w.name.str());
        drag("drag");
        let d = dragDelta();
        if d.x != 0 || d.y != 0 {
            label(`drag {d.x}`);
        }
        bar(f32(w.clicks) / f32(10));
        if w.mark.raw != 0 {
            let i = w.player.frame(&w.clip);
            let fr = w.clip.frames[i];
            drawTextureEx(w.mark, fr.src, fr.size, Vec2 { x: 48, y: 520 }, fr.size, w.player.time * 40, 0, rgb(255, 255, 255));
        }
        if w.mark.raw != 0 {
            image(w.mark);
        }
    }
}
