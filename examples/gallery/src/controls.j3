// Toggles are buttons that flip a bool. Sliders write f32 fields.

module gallery.controls;

use gallery.world.{ World, setFlag };
use j3.ui.Ui;

@j3ui toggle(ui: &Ui, w: &World, which: int, on: bool) {
    pushId(which) {
        if on {
            button("on") {
                setFlag(w, which, false);
            }
        } else {
            button("off") {
                setFlag(w, which, true);
            }
        }
    }
}

pub @j3ui controlsPage(ui: &Ui, w: &World) {
    panel(420, 280) {
        label("controls");
        toggle(ui, w, 0, w.music);
        toggle(ui, w, 1, w.shake);
        slider("low", &w.low, 0, 100);
        label(`low {int(w.low)}`);
        slider("high", &w.high, 0, 100);
        label(`high {int(w.high)}`);
    }
}
