// Switches, a checkbox, thin sliders, a stepper, and a dead button.

module gallery.controls;

use gallery.world.World;
use j3.ui.Ui;

pub @j3ui controlsPage(ui: &Ui, w: &World) {
    panel(440, 460) {
        label("controls");
        toggle("music", &w.music);
        toggle("shake", &w.shake);
        check("hints", &w.hints);
        if w.hints {
            label("escape quits");
        }
        rule();
        range("low", &w.low, 0, 100);
        label(`low {int(w.low)}`);
        range("high", &w.high, 0, 100);
        label(`high {int(w.high)}`);
        rule();
        stepper("volume", &w.volume, 0, 10);
        buttonOff("locked");
    }
}
