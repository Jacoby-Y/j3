// Tab, clicks, toggles, and slider values. No drawing.

module gallery.world;

use j3.game.{ Font, Texture, bakeText, keyPressed, requestQuit, rgb, setColor, tryLoadFont, Key };
use j3.memory.Arena;

pub struct World {
    tab: int;
    clicks: int;
    music: bool;
    shake: bool;
    low: f32;
    high: f32;
    font: Font;
    mark: Texture;
}

pub fn boot(mem: &Arena): World {
    return World {
        tab: 0,
        clicks: 0,
        music: true,
        shake: false,
        low: 25,
        high: 70,
        font: Font { raw: 0 },
        mark: Texture { raw: 0, w: 0, h: 0 },
    };
}

pub fn load(w: &World) {
    w.font = tryLoadFont("../dungeon/assets/font.ttf", 18);
    if w.font.raw != 0 {
        setColor(rgb(240, 230, 210));
        w.mark = bakeText(w.font, "mark");
    }
}

pub fn input(w: &World, dt: f32) {
    if dt < 0 {
        return;
    }
    if keyPressed(Key.Escape) {
        requestQuit();
    }
}

pub fn pickTab(w: &World, tab: int) {
    w.tab = tab;
}

pub fn addClick(w: &World) {
    w.clicks = w.clicks + 1;
}

pub fn setFlag(w: &World, which: int, on: bool) {
    if which == 0 {
        w.music = on;
        return;
    }
    w.shake = on;
}
