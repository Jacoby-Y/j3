// Tab, clicks, toggles, sliders, and the style-page colors. No drawing.

module gallery.world;

use j3.game.anim.{ Clip, Frame, Player };
use j3.game.{ Font, Texture, bakeText, keyPressed, requestQuit, rgb, setColor, tryLoadFont, Key };
use j3.math.Vec2;
use j3.memory.Arena;
use j3.text.Text;

pub struct World {
    tab: int;
    clicks: int;
    music: bool;
    shake: bool;
    hints: bool;
    volume: int;
    low: f32;
    high: f32;
    /// Bottom red of the style card, 0..255.
    red: f32;
    /// Bottom green of the style card, 0..255.
    green: f32;
    /// Bottom blue of the style card, 0..255.
    blue: f32;
    /// Corner radius of the style card and the round sample.
    radius: f32;
    font: Font;
    /// Smaller face for the inventory counts and tooltips.
    small: Font;
    mark: Texture;
    /// Text edited by the widgets-page field.
    name: Text;
    /// One-frame clip covering `mark`.
    clip: Clip;
    /// Playback cursor for `clip`.
    player: Player;
}

pub fn boot(mem: &Arena): World {
    let frames = mem.alloc::<Frame>(1);
    frames[0] = Frame {
        src: Vec2 { x: 0, y: 0 },
        size: Vec2 { x: 64, y: 32 },
    };
    return World {
        tab: 0,
        clicks: 0,
        music: true,
        shake: false,
        hints: true,
        volume: 4,
        low: 25,
        high: 70,
        red: 120,
        green: 64,
        blue: 96,
        radius: 16,
        font: Font { raw: 0 },
        small: Font { raw: 0 },
        mark: Texture { raw: 0, w: 0, h: 0 },
        name: Text.new(mem),
        clip: Clip { frames: frames, fps: 8 },
        player: Player.fresh(),
    };
}

pub fn load(w: &World) {
    w.font = tryLoadFont("../dungeon/assets/font.ttf", 18);
    w.small = tryLoadFont("../dungeon/assets/font.ttf", 12);
    if w.font.raw != 0 {
        setColor(rgb(240, 230, 210));
        w.mark = bakeText(w.font, "mark");
    }
}

pub fn input(w: &World, dt: f32) {
    w.player.tick(dt, &w.clip);
    if dt < 0 {
        return;
    }
    if keyPressed(Key.Escape) {
        requestQuit();
    }
}

pub fn pickTab(w: &World, tab: int) {
    w.tab = tab;
}

pub fn addClick(w: &World) {
    w.clicks = w.clicks + 1;
}
