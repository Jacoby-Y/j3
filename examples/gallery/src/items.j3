// Item icons and the inventory player, drawn as scaled texels.

module gallery.items;

use j3.game.{ drawRect, rgb, setColor };
use j3.math.Vec2;

pub const COBBLE: int = 1;
pub const PLANK: int = 2;
pub const DIRT: int = 3;
pub const GRASS: int = 4;
pub const LOG: int = 5;
pub const COAL: int = 6;
pub const IRON: int = 7;
pub const GOLD: int = 8;
pub const DIAMOND: int = 9;
pub const STICK: int = 10;
pub const APPLE: int = 11;
pub const BREAD: int = 12;
pub const TORCH: int = 13;
pub const PICK: int = 14;
pub const CHEST: int = 15;
pub const TABLE: int = 16;

pub fn itemName(kind: int): string {
    if kind == COBBLE {
        return "Cobblestone";
    }
    if kind == PLANK {
        return "Oak Planks";
    }
    if kind == DIRT {
        return "Dirt";
    }
    if kind == GRASS {
        return "Grass Block";
    }
    if kind == LOG {
        return "Oak Log";
    }
    if kind == COAL {
        return "Coal";
    }
    if kind == IRON {
        return "Iron Ingot";
    }
    if kind == GOLD {
        return "Gold Ingot";
    }
    if kind == DIAMOND {
        return "Diamond";
    }
    if kind == STICK {
        return "Stick";
    }
    if kind == APPLE {
        return "Apple";
    }
    if kind == BREAD {
        return "Bread";
    }
    if kind == TORCH {
        return "Torch";
    }
    if kind == PICK {
        return "Wooden Pickaxe";
    }
    if kind == CHEST {
        return "Chest";
    }
    if kind == TABLE {
        return "Crafting Table";
    }
    return "";
}

/// Tools stack to one. Everything else stacks to 64.
pub fn stackCap(kind: int): int {
    if kind == PICK {
        return 1;
    }
    return 64;
}

fn blot(x: f32, y: f32, s: int, tx: int, ty: int, tw: int, th: int) {
    drawRect(
        Vec2 {
            x: x + f32(tx * s),
            y: y + f32(ty * s),
        },
        Vec2 {
            x: f32(tw * s),
            y: f32(th * s),
        },
    );
}

fn paintCobble(x: f32, y: f32, s: int) {
    setColor(rgb(128, 128, 128));
    blot(x, y, s, 1, 1, 14, 14);
    setColor(rgb(86, 86, 86));
    blot(x, y, s, 2, 2, 3, 2);
    blot(x, y, s, 8, 3, 4, 3);
    blot(x, y, s, 3, 8, 4, 3);
    blot(x, y, s, 10, 10, 3, 3);
    setColor(rgb(168, 168, 168));
    blot(x, y, s, 6, 2, 2, 2);
    blot(x, y, s, 2, 6, 2, 2);
    blot(x, y, s, 9, 7, 3, 2);
    blot(x, y, s, 5, 12, 3, 2);
}

fn paintPlank(x: f32, y: f32, s: int) {
    setColor(rgb(186, 149, 86));
    blot(x, y, s, 1, 1, 14, 14);
    setColor(rgb(148, 114, 64));
    blot(x, y, s, 1, 4, 14, 1);
    blot(x, y, s, 1, 8, 14, 1);
    blot(x, y, s, 1, 12, 14, 1);
    setColor(rgb(210, 176, 112));
    blot(x, y, s, 2, 2, 8, 1);
}

fn paintDirt(x: f32, y: f32, s: int) {
    setColor(rgb(134, 96, 67));
    blot(x, y, s, 1, 1, 14, 14);
    setColor(rgb(108, 74, 50));
    blot(x, y, s, 3, 3, 2, 2);
    blot(x, y, s, 9, 4, 3, 2);
    blot(x, y, s, 5, 8, 2, 2);
    blot(x, y, s, 11, 10, 2, 2);
    setColor(rgb(156, 116, 82));
    blot(x, y, s, 6, 5, 2, 2);
    blot(x, y, s, 2, 11, 2, 2);
}

fn paintGrass(x: f32, y: f32, s: int) {
    setColor(rgb(134, 96, 67));
    blot(x, y, s, 1, 1, 14, 14);
    setColor(rgb(96, 168, 58));
    blot(x, y, s, 1, 1, 14, 5);
    setColor(rgb(72, 140, 42));
    blot(x, y, s, 1, 5, 14, 1);
    blot(x, y, s, 2, 6, 2, 2);
    blot(x, y, s, 7, 6, 2, 2);
    blot(x, y, s, 12, 6, 2, 1);
    setColor(rgb(128, 196, 72));
    blot(x, y, s, 3, 2, 4, 1);
}

fn paintLog(x: f32, y: f32, s: int) {
    setColor(rgb(102, 81, 51));
    blot(x, y, s, 1, 1, 14, 14);
    setColor(rgb(168, 140, 96));
    blot(x, y, s, 4, 2, 8, 12);
    setColor(rgb(120, 92, 58));
    blot(x, y, s, 7, 3, 2, 10);
    setColor(rgb(86, 64, 38));
    blot(x, y, s, 1, 1, 3, 14);
}

fn paintCoal(x: f32, y: f32, s: int) {
    setColor(rgb(28, 28, 28));
    blot(x, y, s, 3, 4, 10, 8);
    blot(x, y, s, 4, 3, 7, 2);
    blot(x, y, s, 5, 12, 6, 2);
    setColor(rgb(58, 58, 58));
    blot(x, y, s, 5, 5, 3, 2);
    setColor(rgb(16, 16, 16));
    blot(x, y, s, 8, 8, 3, 3);
}

fn paintIngot(x: f32, y: f32, s: int, body: int, edge: int) {
    if body == 0 {
        setColor(rgb(220, 220, 220));
    } else {
        setColor(rgb(236, 196, 58));
    }
    blot(x, y, s, 2, 5, 12, 6);
    blot(x, y, s, 3, 4, 10, 1);
    blot(x, y, s, 3, 11, 10, 1);
    if edge == 0 {
        setColor(rgb(160, 160, 160));
    } else {
        setColor(rgb(176, 128, 28));
    }
    blot(x, y, s, 2, 9, 12, 2);
    if body == 0 {
        setColor(rgb(255, 255, 255));
    } else {
        setColor(rgb(255, 230, 140));
    }
    blot(x, y, s, 4, 6, 6, 1);
}

fn paintDiamond(x: f32, y: f32, s: int) {
    setColor(rgb(72, 214, 208));
    blot(x, y, s, 6, 1, 4, 2);
    blot(x, y, s, 4, 3, 8, 2);
    blot(x, y, s, 2, 5, 12, 4);
    blot(x, y, s, 4, 9, 8, 3);
    blot(x, y, s, 6, 12, 4, 2);
    setColor(rgb(180, 255, 250));
    blot(x, y, s, 6, 3, 2, 3);
    setColor(rgb(36, 140, 150));
    blot(x, y, s, 9, 8, 3, 3);
}

fn paintStick(x: f32, y: f32, s: int) {
    setColor(rgb(146, 110, 62));
    blot(x, y, s, 7, 1, 2, 14);
    setColor(rgb(96, 70, 38));
    blot(x, y, s, 8, 1, 1, 14);
}

fn paintApple(x: f32, y: f32, s: int) {
    setColor(rgb(188, 36, 36));
    blot(x, y, s, 4, 4, 8, 9);
    blot(x, y, s, 3, 6, 10, 6);
    setColor(rgb(140, 20, 20));
    blot(x, y, s, 5, 11, 6, 2);
    setColor(rgb(92, 58, 28));
    blot(x, y, s, 7, 2, 2, 3);
    setColor(rgb(64, 150, 40));
    blot(x, y, s, 9, 3, 3, 2);
    setColor(rgb(255, 180, 180));
    blot(x, y, s, 5, 6, 2, 2);
}

fn paintBread(x: f32, y: f32, s: int) {
    setColor(rgb(196, 148, 78));
    blot(x, y, s, 2, 5, 12, 7);
    blot(x, y, s, 3, 4, 10, 1);
    blot(x, y, s, 3, 12, 10, 1);
    setColor(rgb(150, 100, 48));
    blot(x, y, s, 3, 7, 10, 1);
    blot(x, y, s, 3, 10, 10, 1);
    setColor(rgb(220, 180, 110));
    blot(x, y, s, 4, 5, 6, 1);
}

fn paintTorch(x: f32, y: f32, s: int) {
    setColor(rgb(124, 92, 48));
    blot(x, y, s, 7, 7, 2, 8);
    setColor(rgb(240, 160, 32));
    blot(x, y, s, 5, 3, 6, 4);
    blot(x, y, s, 6, 2, 4, 2);
    setColor(rgb(255, 236, 140));
    blot(x, y, s, 7, 4, 2, 2);
}

fn paintPick(x: f32, y: f32, s: int) {
    setColor(rgb(146, 110, 62));
    blot(x, y, s, 3, 11, 2, 2);
    blot(x, y, s, 4, 9, 2, 2);
    blot(x, y, s, 5, 7, 2, 2);
    blot(x, y, s, 6, 5, 2, 2);
    blot(x, y, s, 7, 4, 2, 2);
    setColor(rgb(168, 128, 72));
    blot(x, y, s, 6, 2, 3, 2);
    blot(x, y, s, 8, 3, 3, 2);
    blot(x, y, s, 10, 4, 3, 2);
    setColor(rgb(110, 78, 40));
    blot(x, y, s, 7, 3, 2, 1);
    blot(x, y, s, 9, 4, 2, 1);
}

fn paintChest(x: f32, y: f32, s: int) {
    setColor(rgb(158, 104, 40));
    blot(x, y, s, 2, 4, 12, 9);
    setColor(rgb(196, 140, 64));
    blot(x, y, s, 2, 4, 12, 3);
    setColor(rgb(110, 70, 28));
    blot(x, y, s, 2, 7, 12, 1);
    setColor(rgb(212, 186, 64));
    blot(x, y, s, 7, 8, 2, 3);
}

fn paintTable(x: f32, y: f32, s: int) {
    setColor(rgb(176, 140, 80));
    blot(x, y, s, 1, 1, 14, 9);
    setColor(rgb(120, 90, 50));
    blot(x, y, s, 1, 4, 14, 1);
    blot(x, y, s, 1, 8, 14, 1);
    blot(x, y, s, 5, 1, 1, 9);
    blot(x, y, s, 10, 1, 1, 9);
    setColor(rgb(140, 100, 56));
    blot(x, y, s, 2, 10, 5, 4);
    blot(x, y, s, 9, 10, 5, 4);
    setColor(rgb(96, 68, 36));
    blot(x, y, s, 7, 10, 2, 4);
}

pub fn paintItem(kind: int, x: f32, y: f32, s: int) {
    if kind == COBBLE {
        paintCobble(x, y, s);
        return;
    }
    if kind == PLANK {
        paintPlank(x, y, s);
        return;
    }
    if kind == DIRT {
        paintDirt(x, y, s);
        return;
    }
    if kind == GRASS {
        paintGrass(x, y, s);
        return;
    }
    if kind == LOG {
        paintLog(x, y, s);
        return;
    }
    if kind == COAL {
        paintCoal(x, y, s);
        return;
    }
    if kind == IRON {
        paintIngot(x, y, s, 0, 0);
        return;
    }
    if kind == GOLD {
        paintIngot(x, y, s, 1, 1);
        return;
    }
    if kind == DIAMOND {
        paintDiamond(x, y, s);
        return;
    }
    if kind == STICK {
        paintStick(x, y, s);
        return;
    }
    if kind == APPLE {
        paintApple(x, y, s);
        return;
    }
    if kind == BREAD {
        paintBread(x, y, s);
        return;
    }
    if kind == TORCH {
        paintTorch(x, y, s);
        return;
    }
    if kind == PICK {
        paintPick(x, y, s);
        return;
    }
    if kind == CHEST {
        paintChest(x, y, s);
        return;
    }
    if kind == TABLE {
        paintTable(x, y, s);
    }
}

/// Faint armor or offhand mark in an empty slot. `part` is 0..3 armor, 4 offhand.
pub fn paintGhost(part: int, x: f32, y: f32, s: int) {
    setColor(rgb(64, 64, 64));
    if part == 0 {
        blot(x, y, s, 4, 3, 8, 3);
        blot(x, y, s, 3, 6, 10, 6);
        blot(x, y, s, 6, 6, 4, 2);
        return;
    }
    if part == 1 {
        blot(x, y, s, 4, 2, 8, 4);
        blot(x, y, s, 3, 6, 10, 8);
        blot(x, y, s, 1, 6, 2, 5);
        blot(x, y, s, 13, 6, 2, 5);
        return;
    }
    if part == 2 {
        blot(x, y, s, 4, 2, 8, 3);
        blot(x, y, s, 4, 5, 3, 9);
        blot(x, y, s, 9, 5, 3, 9);
        return;
    }
    if part == 3 {
        blot(x, y, s, 2, 8, 5, 4);
        blot(x, y, s, 9, 8, 5, 4);
        blot(x, y, s, 2, 11, 5, 2);
        blot(x, y, s, 9, 11, 5, 2);
        return;
    }
    blot(x, y, s, 4, 3, 8, 10);
    blot(x, y, s, 3, 4, 2, 6);
    blot(x, y, s, 11, 4, 2, 6);
    setColor(rgb(90, 90, 90));
    blot(x, y, s, 7, 5, 2, 4);
}

/// Steve, standing in the inventory portrait. `look` is -1, 0, or 1.
pub fn paintSteve(ox: f32, oy: f32, s: int, look: int) {
    let hx = 47 + look;
    setColor(rgb(198, 158, 118));
    blot(ox, oy, s, hx, 16, 8, 8);
    blot(ox, oy, s, 43, 25, 4, 10);
    blot(ox, oy, s, 55, 25, 4, 10);
    blot(ox, oy, s, 47, 37, 4, 10);
    blot(ox, oy, s, 51, 37, 4, 10);
    setColor(rgb(56, 36, 22));
    blot(ox, oy, s, hx, 16, 8, 3);
    blot(ox, oy, s, hx, 16, 1, 6);
    blot(ox, oy, s, hx + 7, 16, 1, 6);
    setColor(rgb(40, 60, 90));
    blot(ox, oy, s, hx + 2 + look, 20, 1, 1);
    blot(ox, oy, s, hx + 5 + look, 20, 1, 1);
    setColor(rgb(72, 166, 186));
    blot(ox, oy, s, 47, 24, 8, 12);
    blot(ox, oy, s, 43, 24, 4, 4);
    blot(ox, oy, s, 55, 24, 4, 4);
    setColor(rgb(48, 52, 140));
    blot(ox, oy, s, 47, 36, 8, 8);
    setColor(rgb(64, 64, 68));
    blot(ox, oy, s, 47, 44, 4, 3);
    blot(ox, oy, s, 51, 44, 4, 3);
}
