// Three pages. The open one wears brackets.

module gallery.tabs;

use gallery.world.{ World, pickTab };
use j3.ui.Ui;

@j3ui tabButton(ui: &Ui, w: &World, id: int, name: string) {
    pushId(id) {
        if w.tab == id {
            button(`[{name}]`) {
                pickTab(w, id);
            }
        } else {
            button(name) {
                pickTab(w, id);
            }
        }
    }
}

pub @j3ui tabBar(ui: &Ui, w: &World) {
    row() {
        tabButton(ui, w, 0, "widgets");
        tabButton(ui, w, 1, "controls");
        tabButton(ui, w, 2, "layout");
    }
}
