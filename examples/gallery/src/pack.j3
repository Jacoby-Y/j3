// Survival inventory. Same slots as the crafting screen: armor, 2x2, output, storage, hotbar, offhand.

module gallery.pack;

use gallery.items.{
    APPLE, BREAD, CHEST, COAL, COBBLE, DIAMOND, DIRT, GOLD, GRASS, IRON, LOG, PICK, PLANK, STICK,
    TABLE, TORCH, itemName, paintGhost, paintItem, paintSteve, stackCap,
};
use j3.game.{
    Font, Key, Mouse, drawRect, drawText, keyDown, mousePos, mousePressed, rgb, rgba, setColor, textSize,
    windowSize,
};
use j3.math.Vec2;

const SCALE: int = 3;
const GUI_W: int = 176;
const GUI_H: int = 166;
const SLOTS: int = 46;

struct Stack {
    kind: int;
    n: int;
}

#[singleton]
let slot: [46]Stack;

#[singleton]
let held: Stack;

#[singleton]
let ready: bool;

fn put(i: int, kind: int, n: int) {
    slot[i].kind = kind;
    slot[i].n = n;
}

fn seed() {
    if ready {
        return;
    }
    ready = true;
    put(1, LOG, 4);
    put(9, COAL, 32);
    put(10, STICK, 12);
    put(11, APPLE, 5);
    put(12, BREAD, 3);
    put(13, TORCH, 24);
    put(14, CHEST, 1);
    put(15, COBBLE, 13);
    put(16, TABLE, 1);
    put(18, DIRT, 64);
    put(19, GRASS, 8);
    put(21, IRON, 3);
    put(27, APPLE, 1);
    put(36, COBBLE, 64);
    put(37, PLANK, 48);
    put(38, DIRT, 64);
    put(39, GRASS, 32);
    put(40, LOG, 16);
    put(41, IRON, 11);
    put(42, GOLD, 6);
    put(43, DIAMOND, 4);
    put(44, PICK, 1);
}

fn slotX(i: int): int {
    if i == 0 {
        return 154;
    }
    if i == 1 || i == 3 {
        return 98;
    }
    if i == 2 || i == 4 {
        return 116;
    }
    if i >= 5 && i <= 8 {
        return 8;
    }
    if i >= 9 && i <= 35 {
        let n = i - 9;
        while n >= 9 {
            n = n - 9;
        }
        return 8 + n * 18;
    }
    if i >= 36 && i <= 44 {
        return 8 + (i - 36) * 18;
    }
    if i == 45 {
        return 77;
    }
    return 0;
}

fn slotY(i: int): int {
    if i == 0 {
        return 28;
    }
    if i == 1 || i == 2 {
        return 18;
    }
    if i == 3 || i == 4 {
        return 36;
    }
    if i >= 5 && i <= 8 {
        return 8 + (i - 5) * 18;
    }
    if i >= 9 && i <= 35 {
        let n = i - 9;
        let row = 0;
        while n >= 9 {
            n = n - 9;
            row = row + 1;
        }
        return 84 + row * 18;
    }
    if i >= 36 && i <= 44 {
        return 142;
    }
    if i == 45 {
        return 62;
    }
    return 0;
}

fn kindAt(i: int): int {
    if slot[i].n <= 0 {
        return 0;
    }
    return slot[i].kind;
}

/// 2x2 recipes: one log, two planks in a column, or four planks.
fn fillResult() {
    let a = kindAt(1);
    let b = kindAt(2);
    let c = kindAt(3);
    let d = kindAt(4);
    slot[0].kind = 0;
    slot[0].n = 0;
    let logs = 0;
    let other = 0;
    if a == LOG {
        logs = logs + 1;
    } else if a != 0 {
        other = other + 1;
    }
    if b == LOG {
        logs = logs + 1;
    } else if b != 0 {
        other = other + 1;
    }
    if c == LOG {
        logs = logs + 1;
    } else if c != 0 {
        other = other + 1;
    }
    if d == LOG {
        logs = logs + 1;
    } else if d != 0 {
        other = other + 1;
    }
    if logs == 1 && other == 0 {
        slot[0].kind = PLANK;
        slot[0].n = 4;
        return;
    }
    if a == PLANK && c == PLANK && b == 0 && d == 0 {
        slot[0].kind = STICK;
        slot[0].n = 4;
        return;
    }
    if b == PLANK && d == PLANK && a == 0 && c == 0 {
        slot[0].kind = STICK;
        slot[0].n = 4;
        return;
    }
    if a == PLANK && b == PLANK && c == PLANK && d == PLANK {
        slot[0].kind = TABLE;
        slot[0].n = 1;
    }
}

fn consumeCraft() {
    let i = 1;
    while i <= 4 {
        if slot[i].n > 0 {
            slot[i].n = slot[i].n - 1;
            if slot[i].n <= 0 {
                slot[i].kind = 0;
                slot[i].n = 0;
            }
        }
        i = i + 1;
    }
}

fn mergeInto(i: int, kind: int, n: int): int {
    if n <= 0 {
        return 0;
    }
    let take = n;
    if slot[i].kind == 0 {
        let limit = stackCap(kind);
        if take > limit {
            take = limit;
        }
        slot[i].kind = kind;
        slot[i].n = take;
        return n - take;
    }
    if slot[i].kind != kind {
        return n;
    }
    let room = stackCap(kind) - slot[i].n;
    if room < 0 {
        room = 0;
    }
    if take > room {
        take = room;
    }
    slot[i].n = slot[i].n + take;
    return n - take;
}

fn pour(lo: int, hi: int, kind: int, n: int): int {
    let i = lo;
    while i <= hi && n > 0 {
        if slot[i].kind == kind {
            n = mergeInto(i, kind, n);
        }
        i = i + 1;
    }
    i = lo;
    while i <= hi && n > 0 {
        if slot[i].kind == 0 {
            n = mergeInto(i, kind, n);
        }
        i = i + 1;
    }
    return n;
}

fn roomFor(kind: int): int {
    let space = 0;
    let i = 9;
    while i <= 44 {
        if slot[i].kind == 0 {
            space = space + stackCap(kind);
        } else if slot[i].kind == kind {
            space = space + stackCap(kind) - slot[i].n;
        }
        i = i + 1;
    }
    return space;
}

fn clearHeld() {
    held.kind = 0;
    held.n = 0;
}

fn takeResult(shift: bool) {
    let k = slot[0].kind;
    let n = slot[0].n;
    if k == 0 || n <= 0 {
        return;
    }
    if shift {
        if held.kind != 0 {
            return;
        }
        if roomFor(k) < n {
            return;
        }
        let left = pour(9, 35, k, n);
        left = pour(36, 44, k, left);
        if left != 0 {
            return;
        }
        consumeCraft();
        return;
    }
    if held.kind == 0 {
        held.kind = k;
        held.n = n;
        consumeCraft();
        return;
    }
    if held.kind == k && held.n + n <= stackCap(k) {
        held.n = held.n + n;
        consumeCraft();
    }
}

fn shiftMove(from: int) {
    let kind = slot[from].kind;
    let n = slot[from].n;
    if kind == 0 || n <= 0 {
        return;
    }
    if from >= 9 && from <= 35 {
        n = pour(36, 44, kind, n);
    } else if from >= 36 && from <= 44 {
        n = pour(9, 35, kind, n);
    } else {
        n = pour(9, 35, kind, n);
        n = pour(36, 44, kind, n);
    }
    if n <= 0 {
        slot[from].kind = 0;
        slot[from].n = 0;
    } else {
        slot[from].n = n;
    }
}

fn placeOne(i: int) {
    if held.kind == 0 || held.n <= 0 {
        return;
    }
    if slot[i].kind == 0 {
        slot[i].kind = held.kind;
        slot[i].n = 1;
        held.n = held.n - 1;
    } else if slot[i].kind == held.kind && slot[i].n < stackCap(held.kind) {
        slot[i].n = slot[i].n + 1;
        held.n = held.n - 1;
    }
    if held.n <= 0 {
        clearHeld();
    }
}

fn split(i: int) {
    if slot[i].kind == 0 || slot[i].n <= 0 {
        return;
    }
    let n = slot[i].n;
    let take = (n + 1) / 2;
    held.kind = slot[i].kind;
    held.n = take;
    slot[i].n = n - take;
    if slot[i].n <= 0 {
        slot[i].kind = 0;
        slot[i].n = 0;
    }
}

fn onClick(i: int, right: bool, shift: bool) {
    if i == 0 {
        takeResult(shift);
        return;
    }
    if shift && held.kind == 0 {
        shiftMove(i);
        return;
    }
    if right {
        if held.kind == 0 {
            split(i);
        } else {
            placeOne(i);
        }
        return;
    }
    if held.kind == 0 {
        held.kind = slot[i].kind;
        held.n = slot[i].n;
        slot[i].kind = 0;
        slot[i].n = 0;
        return;
    }
    if slot[i].kind == 0 {
        slot[i].kind = held.kind;
        slot[i].n = held.n;
        clearHeld();
        return;
    }
    if slot[i].kind == held.kind {
        let room = stackCap(held.kind) - slot[i].n;
        if room < 0 {
            room = 0;
        }
        let take = held.n;
        if take > room {
            take = room;
        }
        slot[i].n = slot[i].n + take;
        held.n = held.n - take;
        if held.n <= 0 {
            clearHeld();
        }
        return;
    }
    let k = slot[i].kind;
    let n = slot[i].n;
    slot[i].kind = held.kind;
    slot[i].n = held.n;
    held.kind = k;
    held.n = n;
}

fn hit(ox: f32, oy: f32, mx: f32, my: f32): int {
    let side = f32(18 * SCALE);
    let i = 0;
    while i < SLOTS {
        let x = ox + f32(slotX(i) * SCALE);
        let y = oy + f32(slotY(i) * SCALE);
        if mx >= x && mx < x + side && my >= y && my < y + side {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn guiRect(ox: f32, oy: f32, gx: int, gy: int, gw: int, gh: int) {
    drawRect(
        Vec2 {
            x: ox + f32(gx * SCALE),
            y: oy + f32(gy * SCALE),
        },
        Vec2 {
            x: f32(gw * SCALE),
            y: f32(gh * SCALE),
        },
    );
}

fn panel(ox: f32, oy: f32) {
    setColor(rgb(55, 55, 55));
    guiRect(ox, oy, -1, -1, GUI_W + 2, GUI_H + 2);
    setColor(rgb(198, 198, 198));
    guiRect(ox, oy, 0, 0, GUI_W, GUI_H);
    setColor(rgb(255, 255, 255));
    guiRect(ox, oy, 0, 0, GUI_W, 1);
    guiRect(ox, oy, 0, 0, 1, GUI_H);
    setColor(rgb(85, 85, 85));
    guiRect(ox, oy, 0, GUI_H - 1, GUI_W, 1);
    guiRect(ox, oy, GUI_W - 1, 0, 1, GUI_H);
}

fn bevel(x: f32, y: f32) {
    let side = f32(18 * SCALE);
    let t = f32(SCALE);
    setColor(rgb(55, 55, 55));
    drawRect(Vec2 { x: x, y: y }, Vec2 { x: side, y: t });
    drawRect(Vec2 { x: x, y: y }, Vec2 { x: t, y: side });
    setColor(rgb(255, 255, 255));
    drawRect(Vec2 { x: x, y: y + side - t }, Vec2 { x: side, y: t });
    drawRect(Vec2 { x: x + side - t, y: y }, Vec2 { x: t, y: side });
    setColor(rgb(139, 139, 139));
    drawRect(Vec2 { x: x + t, y: y + t }, Vec2 { x: side - t * 2, y: side - t * 2 });
}

fn arrow(ox: f32, oy: f32) {
    setColor(rgb(128, 128, 128));
    guiRect(ox, oy, 136, 33, 10, 2);
    guiRect(ox, oy, 144, 31, 2, 6);
    guiRect(ox, oy, 146, 32, 2, 4);
    guiRect(ox, oy, 148, 33, 2, 2);
}

fn paintCount(font: Font, n: int, ix: f32, iy: f32) {
    if n < 2 || font.raw == 0 {
        return;
    }
    let msg = `{n}`;
    let sz = textSize(font, msg);
    let tx = ix + f32(16 * SCALE) - sz.x - 1;
    let ty = iy + f32(15 * SCALE) - sz.y;
    setColor(rgb(20, 20, 20));
    drawText(font, Vec2 { x: tx + 1, y: ty + 1 }, msg);
    setColor(rgb(255, 255, 255));
    drawText(font, Vec2 { x: tx, y: ty }, msg);
}

fn tooltip(font: Font, kind: int, mx: f32, my: f32) {
    if kind == 0 || font.raw == 0 {
        return;
    }
    let name = itemName(kind);
    let sz = textSize(font, name);
    let w = sz.x + 10;
    let h = sz.y + 8;
    let x = mx + 14;
    let y = my + 14;
    let win = windowSize();
    if x + w > win.x {
        x = mx - w - 6;
    }
    if y + h > win.y {
        y = my - h - 6;
    }
    setColor(rgba(80, 0, 200, 200));
    drawRect(Vec2 { x: x - 2, y: y - 2 }, Vec2 { x: w + 4, y: h + 4 });
    setColor(rgba(40, 0, 120, 200));
    drawRect(Vec2 { x: x - 2, y: y + h - 1 }, Vec2 { x: w + 4, y: 3 });
    setColor(rgba(16, 0, 16, 235));
    drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
    setColor(rgb(255, 255, 255));
    drawText(font, Vec2 { x: x + 5, y: y + 3 }, name);
}

pub fn show(font: Font, small: Font) {
    seed();
    fillResult();
    let face = small;
    if face.raw == 0 {
        face = font;
    }
    let win = windowSize();
    let gw = f32(GUI_W * SCALE);
    let ox = (win.x - gw) * 0.5;
    let oy = f32(76);
    let mp = mousePos();
    let over = hit(ox, oy, mp.x, mp.y);
    if mp.y >= oy && over >= 0 && (mousePressed(Mouse.Left) || mousePressed(Mouse.Right)) {
        onClick(over, mousePressed(Mouse.Right), keyDown(Key.Shift));
        fillResult();
    }
    panel(ox, oy);
    let mid = ox + f32(51 * SCALE);
    let look = 0;
    if mp.x > mid + f32(12 * SCALE) {
        look = 1;
    }
    if mp.x < mid - f32(12 * SCALE) {
        look = -1;
    }
    paintSteve(ox, oy, SCALE, look);
    arrow(ox, oy);
    let i = 0;
    while i < SLOTS {
        let x = ox + f32(slotX(i) * SCALE);
        let y = oy + f32(slotY(i) * SCALE);
        bevel(x, y);
        if i == over {
            setColor(rgba(255, 255, 255, 90));
            let t = f32(SCALE);
            drawRect(
                Vec2 { x: x + t, y: y + t },
                Vec2 { x: f32(16 * SCALE), y: f32(16 * SCALE) },
            );
        }
        let ix = x + f32(SCALE);
        let iy = y + f32(SCALE);
        if slot[i].kind != 0 && slot[i].n > 0 {
            paintItem(slot[i].kind, ix, iy, SCALE);
            paintCount(face, slot[i].n, ix, iy);
        } else if i >= 5 && i <= 8 {
            paintGhost(i - 5, ix, iy, SCALE);
        } else if i == 45 {
            paintGhost(4, ix, iy, SCALE);
        }
        i = i + 1;
    }
    if face.raw != 0 {
        setColor(rgb(64, 64, 64));
        drawText(face, Vec2 { x: ox + f32(8 * SCALE), y: oy + 4 }, "Crafting");
        drawText(face, Vec2 { x: ox + f32(28 * SCALE), y: oy + f32(73 * SCALE) }, "Inventory");
    }
    if held.kind != 0 && held.n > 0 {
        let hx = mp.x - f32(8 * SCALE);
        let hy = mp.y - f32(8 * SCALE);
        paintItem(held.kind, hx, hy, SCALE);
        paintCount(face, held.n, hx, hy);
    } else if over >= 0 {
        tooltip(face, slot[over].kind, mp.x, mp.y);
    }
}
