// Warm directional sunlight, cool sky fill, and a shadow map for the whole world.
module industry.lighting;

use j3.gfx;
use j3.gfx.Look;
use j3.math.{ Mat4, Vec3 };
use industry.models;
use industry.models.Models;
use industry.world;
use industry.render;
use industry.world.World;

fn sun(): Vec3 { return Vec3.xyz(-0.65, 1.0, 0.45); }

pub fn begin(w: &World, eye: Look, assets: &Models, seconds: f32) {
    let light = sun();
    gfx.shadowPass(light, Vec3.xyz(0, 0, 0),
        Vec3.xyz(f32(world.SX) * world.VOXEL, f32(world.SY) * world.VOXEL,
            f32(world.SZ) * world.VOXEL));
    render.drawTerrain(w, eye.eye);
    models.drawWorld(w, assets, seconds);
    gfx.cameraPassLook(eye, light,
        Vec3.xyz(0.43, 0.55, 0.69), Vec3.xyz(0.89, 0.83, 0.72));
}
