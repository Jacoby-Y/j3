// Exact greedy rectangles preserve the colors, emission, and outline of voxel assets.
module industry.model_mesh;
use j3.gfx;
use j3.math.Vec3;
use j3.sys;
use industry.subvoxels;
use industry.subvoxels.Grid;

fn cell(face: int, plane: int, u: int, v: int): Vec3 {
    let x = u; let y = v; let z = plane;
    if face == gfx.FACE_NX || face == gfx.FACE_PX { x = plane; z = u; }
    if face == gfx.FACE_NY || face == gfx.FACE_PY { y = plane; z = v; }
    return Vec3.xyz(f32(x), f32(y), f32(z));
}

fn material(g: &Grid, p: Vec3, face: int): u8 {
    let x = int(p.x); let y = int(p.y); let z = int(p.z);
    let id = subvoxels.get(g, x, y, z); if id == 0 { return 0; }
    if face == gfx.FACE_NX { x -= 1; } if face == gfx.FACE_PX { x += 1; }
    if face == gfx.FACE_NY { y -= 1; } if face == gfx.FACE_PY { y += 1; }
    if face == gfx.FACE_NZ { z -= 1; } if face == gfx.FACE_PZ { z += 1; }
    if subvoxels.get(g, x, y, z) != 0 { return 0; }
    return id;
}

fn rectangle(g: &Grid, at: int, p: Vec3, face: int, width: int, height: int, id: u8): int {
    if at + 60 > g.scratch.len { sys.panic("merged model mesh full"); }
    let color = g.colors[int(id) - 1]; let emission: f32 = 0; if g.glow { emission = 1; }
    let origin = p - Vec3.xyz(12, 0, 12);
    let next = gfx.emitFace(g.scratch, at, origin.x, origin.y, origin.z, face, color.x, color.y, color.z, emission);
    for vertex in 0..6 {
        let v = at + vertex * 10;
        if face == gfx.FACE_NX || face == gfx.FACE_PX {
            g.scratch[v + 2] = origin.z + (g.scratch[v + 2] - origin.z) * f32(width);
            g.scratch[v + 1] = origin.y + (g.scratch[v + 1] - origin.y) * f32(height);
        } else if face == gfx.FACE_NY || face == gfx.FACE_PY {
            g.scratch[v] = origin.x + (g.scratch[v] - origin.x) * f32(width);
            g.scratch[v + 2] = origin.z + (g.scratch[v + 2] - origin.z) * f32(height);
        } else {
            g.scratch[v] = origin.x + (g.scratch[v] - origin.x) * f32(width);
            g.scratch[v + 1] = origin.y + (g.scratch[v + 1] - origin.y) * f32(height);
        }
        g.scratch[v] *= 0.125; g.scratch[v + 1] *= 0.125; g.scratch[v + 2] *= 0.125;
    }
    return next;
}

pub fn vertices(g: &Grid): []f32 {
    let at = 0;
    for face in 0..6 {
        let planes = 24; let rows = 32;
        if face == gfx.FACE_NY || face == gfx.FACE_PY { planes = 32; rows = 24; }
        for plane in 0..planes {
            for v in 0..rows { for u in 0..24 { g.mask[u + v * 24] = material(g, cell(face, plane, u, v), face); } }
            for v in 0..rows { for u in 0..24 {
                let id = g.mask[u + v * 24]; if id == 0 { continue; }
                let width = 1;
                while u + width < 24 && g.mask[u + width + v * 24] == id { width += 1; }
                let height = 1; let fits = true;
                while v + height < rows && fits {
                    for span in 0..width { if g.mask[u + span + (v + height) * 24] != id { fits = false; } }
                    if fits { height += 1; }
                }
                at = rectangle(g, at, cell(face, plane, u, v), face, width, height, id);
                for dy in 0..height { for dx in 0..width { g.mask[u + dx + (v + dy) * 24] = 0; } }
            } }
        }
    }
    return g.scratch[0..at];
}
