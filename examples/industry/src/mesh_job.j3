// One terrain meshing job: a private copy of a region of the world (plus a one-voxel border) and the
// buffers its meshes are written to. A worker owns a job from `snapshot` until its result is collected,
// so it never reads the live grid or any shared buffer (`j3c doc threads`).
module industry.mesh_job;

use j3.math.Vec3;
use j3.sys;
use industry.world;
use industry.world.World;

pub struct Job {
    x0: int; y0: int; z0: int;  // world corner of the region
    w: int; h: int; d: int;     // region size; `cells` is (w + 2) x (h + 2) x (d + 2)
    cells: []u8;
    mask: []u8;                 // greedy-merge plane
    out: []f32;                 // detailed mesh
    lod: []f32;                 // merged mesh
    count: int;
    lodCount: int;
    lo: Vec3;
    hi: Vec3;
    version: int;               // section version the snapshot was taken at
    section: int;
    slot: int;                  // index in the mesher's job table, -1 for a job run inline
    done: ptr;                  // the `Queue<int>` a worker reports `slot` to
    cellsAt: ptr; maskAt: ptr; outAt: ptr; lodAt: ptr;
}

// Floats: a face is 60, and a region has fewer exposed faces than four per cell.
fn faceFloats(cells: int): int { return cells * 4 * 60; }

// Buffers are anonymous mappings, so only the pages a mesh really fills are ever committed.
pub fn create(x0: int, y0: int, z0: int, w: int, h: int, d: int): Job {
    let cellBytes = (w + 2) * (h + 2) * (d + 2);
    let maskBytes = w * d;
    if d * h > maskBytes { maskBytes = d * h; }
    if w * h > maskBytes { maskBytes = w * h; }
    let floats = faceFloats(w * h * d);
    let cellsAt = sys.mmapAnon(cellBytes); let maskAt = sys.mmapAnon(maskBytes);
    let outAt = sys.mmapAnon(floats * 4); let lodAt = sys.mmapAnon(floats * 4);
    let cells: []u8 = @slice(cellsAt, cellBytes); let mask: []u8 = @slice(maskAt, maskBytes);
    let out: []f32 = @slice(outAt, floats); let lod: []f32 = @slice(lodAt, floats);
    return Job {
        x0: x0, y0: y0, z0: z0, w: w, h: h, d: d,
        cells: cells, mask: mask, out: out, lod: lod,
        count: 0, lodCount: 0, lo: Vec3.xyz(0, 0, 0), hi: Vec3.xyz(0, 0, 0),
        version: 0, section: -1, slot: -1, done: cellsAt,
        cellsAt: cellsAt, maskAt: maskAt, outAt: outAt, lodAt: lodAt,
    };
}

pub fn destroy(j: &Job) {
    sys.munmap(j.cellsAt, j.cells.len); sys.munmap(j.maskAt, j.mask.len);
    sys.munmap(j.outAt, j.out.len * 4); sys.munmap(j.lodAt, j.lod.len * 4);
}

// Copies the region and its border out of the world. Cells outside the world read as air.
pub fn snapshot(j: &Job, w: &World) {
    let lw = j.w + 2; let ld = j.d + 2;
    for ly in 0..j.h + 2 { for lz in 0..ld { for lx in 0..lw {
        j.cells[lx + lw * (lz + ld * ly)] = world.get(w, j.x0 + lx - 1, j.y0 + ly - 1, j.z0 + lz - 1);
    } } }
}
