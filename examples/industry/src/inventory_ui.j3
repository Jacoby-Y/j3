// Inventory positions, storage transfers, and one-copper structure recipes.
module industry.inventory_ui;
use j3.game;
use j3.game.{ Font, Texture, Color };
use j3.math.Vec2;
use j3.ui.Ui;
use industry.bitmap;
use industry.item_icons;
use industry.data.item;
use industry.crafting;
use industry.crafting.Queue;
use industry.inventory;
use industry.inventory.Bag;
use industry.data.block;
use industry.machine.furnace;
use industry.machine.market;
use industry.machine.state.FurnaceState;
use industry.world;
use industry.world.World;

const TILE: f32 = 56;
const STEP: f32 = 60;
const BTILE: f32 = 64;
const BSTEP: f32 = 68;
const PANEL: f32 = 570;
const HEIGHT: f32 = 570;
const CRAFT_PANEL: f32 = HEIGHT;
const PANEL_GAP: f32 = 12;
// Every screen is the player's inventory on the left and, to its right, a panel of the same size:
// the build menu, or the UI of the structure you opened.
const MODE_BAG: int = 0;
const MODE_STORE: int = 1;
const MODE_MARKET: int = 2;
const MODE_KILN: int = 3;
// The cursor holds `heldCount` of `held` (taken out of its bag) until it is put down or thrown.
// `drop` is a click outside the screen: 1 throws everything held, 2 one. `give` is an item to put into
// the furnace, from the cursor or the bag; `take` a furnace part (furnace.PART_*) to bring out into the
// bag. The screen applies those after drawing.
pub struct Selection {
    queue: Queue;
    buildTab: int = 0;
    held: u8 = 0; heldCount: int = 0; drop: int = 0;
    give: u8 = 0; giveAmount: int = 0; giveHeld: bool = false; take: int = -1; takeAmount: int = 0;
}

fn text(x: f32, y: f32, message: string, scale: f32) { bitmap.drawScaled(x, y, message, scale * 2); }
fn rect(x: f32, y: f32, w: f32, h: f32, color: Color) {
    game.setColor(color); game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}
fn frame(x: f32, y: f32, width: f32, height: f32, scale: f32) {
    rect(x, y, width * scale, height * scale, game.rgb(40, 43, 45));
    rect(x + 3 * scale, y + 3 * scale, (width - 6) * scale, (height - 6) * scale, game.rgb(93, 92, 84));
}
fn inside(x: f32, y: f32, size: f32): bool {
    let p = game.mousePos(); return p.x >= x && p.y >= y && p.x < x + size && p.y < y + size;
}
fn sideX(): f32 { return PANEL + PANEL_GAP; }
fn totalWidth(): f32 { return PANEL + PANEL_GAP + CRAFT_PANEL; }
fn fitScale(): f32 {
    let sz = game.windowSize(); let scale: f32 = 1;
    if sz.x < totalWidth() + 32 { scale = sz.x / (totalWidth() + 32); }
    if sz.y < HEIGHT + 32 && sz.y / (HEIGHT + 32) < scale { scale = sz.y / (HEIGHT + 32); }
    return scale;
}
fn open(scale: f32): Ui {
    let sz = game.windowSize();
    return Ui.begin(Font { raw: 0 }, (sz.x - totalWidth() * scale) * 0.5, (sz.y - HEIGHT * scale) * 0.5);
}
pub fn draw(stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection): bool {
    return drawScreen(stored, carried, icons, selection, MODE_STORE, 0);
}
pub fn drawInventory(carried: &Bag, icons: Texture, selection: &Selection): bool {
    return drawScreen(carried, carried, icons, selection, MODE_BAG, 0);
}
pub fn drawMarket(stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection, coins: int): bool {
    return drawScreen(stored, carried, icons, selection, MODE_MARKET, coins);
}
fn drawScreen(stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection, mode: int, coins: int): bool {
    let scale = fitScale(); let ui = open(scale);
    screen(&ui, stored, carried, icons, selection, scale, mode, coins);
    inventoryTooltip(&ui, stored, carried, selection, scale, mode);
    finish(&ui, icons, selection, scale);
    return false;
}
// The furnace or electric smelter anchored at `at`: its ore, coal and ingot stores.
pub fn drawFurnace(w: &World, at: int, carried: &Bag, icons: Texture, selection: &Selection): bool {
    let scale = fitScale(); let ui = open(scale);
    let k = w.kilns[world.slotOf(w, at)];
    let title = "ELECTRIC SMELTER"; let fueled = w.cells[at] == block.FURNACE;
    if fueled { title = "FURNACE"; }
    kilnScreen(&ui, carried, icons, selection, scale, &k, fueled, title);
    inventoryTooltip(&ui, carried, carried, selection, scale, MODE_KILN);
    finish(&ui, icons, selection, scale);
    if selection.give != 0 {
        if selection.giveHeld {
            selection.heldCount -= furnace.put(w, at, selection.give, selection.giveAmount);
            if selection.heldCount <= 0 { selection.held = 0; selection.heldCount = 0; }
        } else { furnace.deposit(w, at, carried, selection.give, selection.giveAmount); }
        selection.give = 0; selection.giveHeld = false;
    }
    if selection.take >= 0 { furnace.withdraw(w, at, carried, selection.take, selection.takeAmount); selection.take = -1; }
    return false;
}
// Last of a screen: a click outside it throws the held stack; the held stack follows the mouse.
fn finish(ui: &Ui, icons: Texture, selection: &Selection, scale: f32) {
    if selection.held == 0 { return; }
    let m = game.mousePos();
    if !(m.x >= ui.x && m.y >= ui.y && m.x < ui.x + totalWidth() * scale && m.y < ui.y + HEIGHT * scale) {
        if game.mousePressed(game.Mouse.Left) { selection.drop = 1; }
        if game.mousePressed(game.Mouse.Right) { selection.drop = 2; }
    }
    let size = f32(item_icons.SIZE) * scale;
    icon(icons, selection.held, m.x - size * 0.5, m.y - size * 0.5, size);
    let count = selection.heldCount;
    text(m.x + size * 0.1, m.y + size * 0.1, `{count}`, scale);
}
@j3ui screen(ui: &Ui, stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection, scale: f32, mode: int, coins: int) {
    let x = ui.x; let y = ui.y; let sz = game.windowSize();
    rect(0, 0, sz.x, sz.y, game.rgba(9, 12, 15, 180));
    frame(x, y, PANEL, HEIGHT, scale);
    frame(x + sideX() * scale, y, CRAFT_PANEL, HEIGHT, scale);
    inventoryGrid(ui, carried, stored, icons, selection, "", 0, scale, mode);
    if mode == MODE_BAG {
        buildMenu(ui, carried, icons, selection, scale);
    } else {
        let title = "STORAGE"; if mode == MODE_MARKET { title = "TO SELL"; }
        inventoryGrid(ui, stored, carried, icons, selection, title, 1, scale, mode);
    }
    if mode == MODE_MARKET {
        let sale = market.value(stored);
        text(x + (sideX() + 16) * scale, y + 526 * scale, `SALE {sale}   WALLET {coins}`, scale);
    }
}
@j3ui kilnScreen(ui: &Ui, carried: &Bag, icons: Texture, selection: &Selection, scale: f32, k: &FurnaceState, fueled: bool, title: string) {
    let x = ui.x; let y = ui.y; let sz = game.windowSize();
    rect(0, 0, sz.x, sz.y, game.rgba(9, 12, 15, 180));
    frame(x, y, PANEL, HEIGHT, scale);
    frame(x + sideX() * scale, y, CRAFT_PANEL, HEIGHT, scale);
    inventoryGrid(ui, carried, carried, icons, selection, "", 0, scale, MODE_KILN);
    let px = x + (sideX() + 16) * scale;
    text(px, y + 50 * scale, title, scale);
    let row: f32 = 100;
    kilnSlot(ui, icons, selection, px, y + row * scale, furnace.PART_ORE, "ORE", k.stockKind, k.stock, scale);
    row += 90;
    if fueled {
        kilnSlot(ui, icons, selection, px, y + row * scale, furnace.PART_COAL, "COAL", item.COAL, k.fuel, scale);
        row += 90;
    }
    kilnSlot(ui, icons, selection, px, y + row * scale, furnace.PART_INGOT, "INGOTS", k.outKind, k.out, scale);
    text(px, y + 490 * scale, "CLICK A SLOT: PICK UP", scale);
    text(px, y + 514 * scale, "SHIFT CLICK: SEND OVER", scale);
}
@j3ui kilnSlot(ui: &Ui, icons: Texture, selection: &Selection, x: f32, y: f32, part: int, label: string, id: u8, count: int, scale: f32) {
    let size = BTILE * scale; let hovered = inside(x, y, size);
    let tile = Ui.begin(Font { raw: 0 }, x, y); tile.w = size; tile.h = size; tile.pushId(700 + part);
    let clicked = tile.button(""); tile.popId();
    let edge = game.rgb(167, 161, 141);
    if hovered { edge = game.rgb(234, 202, 127); }
    rect(x, y, size, size, edge);
    rect(x + 2 * scale, y + 2 * scale, size - 4 * scale, size - 4 * scale, game.rgb(93, 92, 84));
    text(x + 80 * scale, y + 8 * scale, label, scale);
    text(x + 80 * scale, y + 34 * scale, `{count} OF {furnace.LIMIT}`, scale);
    if count > 0 { icon(icons, id, x + 4 * scale, y + 4 * scale, f32(item_icons.SIZE) * scale * 1.15); }
    let right = hovered && game.mousePressed(game.Mouse.Right);
    if !clicked && !right { return; }
    let held = selection.held;
    if held == 0 {
        // Empty hand: click or shift-click takes all into the bag, right click half.
        let amount = count; if right { amount = (count + 1) / 2; }
        selection.take = part; selection.takeAmount = amount;
        return;
    }
    // Holding something: ore and coal stores take what suits them; left click all, right click one.
    let fits = (part == furnace.PART_ORE && !item.isFuel(held) && item.ingotFor(held) != 0) || (part == furnace.PART_COAL && item.isFuel(held));
    if !fits { return; }
    selection.give = held; selection.giveHeld = true;
    selection.giveAmount = selection.heldCount; if right { selection.giveAmount = 1; }
}
// Side 0 is the player's inventory (large tiles, always on the left); side 1 is a structure's store.
fn gridScale(side: int, scale: f32): f32 { if side == 0 { return scale * 1.5; } return scale; }
fn gridX(ui: &Ui, side: int, scale: f32): f32 { return ui.x + (16 + f32(side) * sideX()) * scale; }
fn gridY(ui: &Ui, side: int, scale: f32): f32 { if side == 0 { return ui.y + 16 * scale; } return ui.y + 100 * scale; }
fn gridGap(side: int, slot: int, scale: f32): f32 { if side == 0 && slot >= item.HOTBAR { return 4 * scale; } return 0; }
@j3ui inventoryGrid(ui: &Ui, source: &Bag, dest: &Bag, icons: Texture, selection: &Selection, title: string, side: int, scale: f32, mode: int) {
    let x = gridX(ui, side, scale); let y = gridY(ui, side, scale); let gs = gridScale(side, scale);
    if side == 1 {
        text(x, ui.y + 50 * scale, title, scale);
    }
    for slot in 0..inventory.size(source) {
        stackSlot(ui, source, dest, icons, selection, x + f32(slot % 6) * STEP * gs,
            y + f32(slot / 6) * STEP * gs + gridGap(side, slot, scale), slot, side, gs, mode);
    }
}
fn icon(icons: Texture, id: u8, x: f32, y: f32, size: f32) {
    item_icons.draw(icons, id, x, y, size);
}
// What a click does to stack `slot` of `source`. Empty hand: pick the stack up (right click: half), or with
// shift send it to the other side (hotbar and grid, inventory and structure, inventory and furnace).
// Holding: put it down (right click: one), swapping with a different item.
fn slotClick(source: &Bag, dest: &Bag, sel: &Selection, slot: int, id: u8, side: int, mode: int, right: bool) {
    let selling = mode == MODE_MARKET;
    if sel.held == 0 {
        if id == 0 { return; }
        let count = source.amounts[slot];
        if game.keyDown(game.Key.Shift) {
            if mode == MODE_BAG { inventory.shiftHotbar(source, slot); }
            else if mode == MODE_KILN { sel.give = id; sel.giveAmount = count; sel.giveHeld = false; }
            else if !selling || side == 1 || market.price(id) > 0 { inventory.moveStack(source, slot, dest); }
            return;
        }
        if right { count = (count + 1) / 2; }
        sel.heldCount = inventory.takeAt(source, slot, count);
        sel.held = id;
        return;
    }
    let h = sel.held; let n = sel.heldCount;
    if selling && side == 1 && market.price(h) <= 0 { return; }
    if id == 0 || id == h {
        let amount = n; if right { amount = 1; }
        sel.heldCount -= inventory.putAt(source, slot, h, amount);
    } else if !right {
        let taken = inventory.takeAt(source, slot, source.amounts[slot]);
        if inventory.room(source, h) >= n && inventory.putAt(source, slot, h, n) == n {
            sel.held = id; sel.heldCount = taken;
        } else { inventory.putAt(source, slot, id, taken); }
    }
    if sel.heldCount <= 0 { sel.held = 0; sel.heldCount = 0; }
}
@j3ui stackSlot(ui: &Ui, source: &Bag, dest: &Bag, icons: Texture, selection: &Selection, x: f32, y: f32, slot: int, side: int, scale: f32, mode: int) {
    let id = inventory.slotItem(source, slot); let hovered = inside(x, y, TILE * scale);
    let tile = Ui.begin(Font { raw: 0 }, x, y); tile.w = TILE * scale; tile.h = TILE * scale; tile.pushId(1 + side * 100 + slot);
    let clicked = tile.button(""); tile.popId();
    let edge = game.rgb(167, 161, 141);
    if hovered { edge = game.rgb(234, 202, 127); }
    rect(x, y, TILE * scale, TILE * scale, edge);
    rect(x + 2 * scale, y + 2 * scale, (TILE - 4) * scale, (TILE - 4) * scale, game.rgb(93, 92, 84));
    if hovered && id == 0 && selection.held != 0 { rect(x + 2 * scale, y + 2 * scale, (TILE - 4) * scale, (TILE - 4) * scale, game.rgba(234, 202, 127, 60)); }
    if id != 0 {
        icon(icons, id, x + 4 * scale, y + 2 * scale, f32(item_icons.SIZE) * scale);
        let count = source.amounts[slot]; text(x + 3 * scale, y + 40 * scale, `{count}`, scale);
    }
    let right = hovered && game.mousePressed(game.Mouse.Right);
    if clicked || right { slotClick(source, dest, selection, slot, id, side, mode, right); }
}
fn buildTooltip(name: string, id: u8, scale: f32) {
    // "COST: 1 COPPER ORE 3 COPPER INGOT 2 IRON INGOT". Built here: an interpolated string dies with its function.
    let cost = "";
    if id != 0 {
        let ore = item.recipeCost(id); let ingots = item.recipeIngots(id); let iron = item.recipeIron(id);
        let stone = item.recipeStone(id); let wire = item.recipeWire(id);
        cost = "COST:";
        if ore > 0 { cost = `{cost} {ore} {item.name(item.rawFor(id))}`; }
        if ingots > 0 { cost = `{cost} {ingots} COPPER INGOT`; }
        if iron > 0 { cost = `{cost} {iron} IRON INGOT`; }
        if stone > 0 { cost = `{cost} {stone} STONE`; }
        if wire > 0 { cost = `{cost} {wire} COPPER WIRE`; }
    }
    let mouse = game.mousePos(); let sz = game.windowSize();
    let length = name.len; if cost.len > length { length = cost.len; }
    let width = f32(length * 12 + 20) * scale;
    let height: f32 = 36; if cost.len > 0 { height = 62; }
    let x = mouse.x + 16 * scale; let y = mouse.y + 16 * scale;
    if x + width > sz.x - 8 { x = sz.x - width - 8; }
    if y + height * scale > sz.y - 8 { y = mouse.y - (height + 8) * scale; }
    rect(x, y, width, height * scale, game.rgb(234, 202, 127));
    rect(x + 2 * scale, y + 2 * scale, width - 4 * scale, (height - 4) * scale, game.rgb(26, 28, 31));
    text(x + 10 * scale, y + 10 * scale, name, scale);
    if cost.len > 0 { text(x + 10 * scale, y + 36 * scale, cost, scale); }
}

@j3ui buildMenu(ui: &Ui, carried: &Bag, icons: Texture, selection: &Selection, scale: f32) {
    let x = ui.x + (PANEL + PANEL_GAP + 16) * scale;
    text(x, ui.y + 50 * scale, "BUILD", scale);
    let tabNames: [4]string = ["LOGISTICS", "PRODUCTION", "TRADE", "POWER"];
    let hoveredName: string = ""; let hoveredId: u8 = 0;
    for tab in 0..4 {
        let tx = x + f32(tab) * 132 * scale; let ty = ui.y + 80 * scale;
        let header = Ui.begin(Font { raw: 0 }, tx, ty);
        header.w = 124 * scale; header.h = 36 * scale; header.pushId(600 + tab);
        let tabClicked = header.button(""); header.popId();
        if tabClicked { selection.buildTab = tab; }
        if selection.buildTab == tab {
            rect(tx - 2 * scale, ty - 2 * scale, 128 * scale, 40 * scale, game.rgb(234, 202, 127));
        }
        rect(tx, ty, 124 * scale, 36 * scale, game.rgb(41, 43, 41));
        let label = tabNames[tab];
        text(tx + (124 - f32(label.len) * 12) * 0.5 * scale, ty + 10 * scale, label, scale);
    }
    for recipe in 0..item.recipeCount() {
        let id = item.recipe(recipe);
        if item.tab(id) != selection.buildTab { continue; }
        let rx = x + f32(item.col(id)) * BSTEP * scale;
        let ry = ui.y + (136 + f32(item.tier(id)) * BSTEP) * scale;
        let button = Ui.begin(Font { raw: 0 }, rx, ry);
        button.w = BTILE * scale; button.h = BTILE * scale; button.pushId(500 + recipe);
        let clicked = button.button(""); let right = inside(rx, ry, BTILE * scale) && game.mousePressed(game.Mouse.Right);
        button.popId();
        let edge = game.rgb(167, 161, 141);
        if inside(rx, ry, BTILE * scale) { edge = game.rgb(234, 202, 127); }
        rect(rx, ry, BTILE * scale, BTILE * scale, edge);
        rect(rx + 2 * scale, ry + 2 * scale, (BTILE - 4) * scale, (BTILE - 4) * scale, game.rgb(93, 92, 84));
        icon(icons, id, rx + 4 * scale, ry + 4 * scale, f32(item_icons.SIZE) * scale * 1.15);
        if !inventory.canCraft(carried, id) { rect(rx + 2 * scale, ry + 2 * scale, (BTILE - 4) * scale, (BTILE - 4) * scale, game.rgba(20, 22, 24, 120)); }
        let done = crafting.fraction(&selection.queue, id); let waiting = crafting.queued(&selection.queue, id);
        if done > 0 {
            let fill = (BTILE - 4) * scale * done;
            rect(rx + 2 * scale, ry + (BTILE - 2) * scale - fill, (BTILE - 4) * scale, fill, game.rgba(234, 202, 127, 110));
        }
        if waiting > 0 { text(rx + 6 * scale, ry + 40 * scale, `{waiting}`, scale); }
        if inside(rx, ry, BTILE * scale) { hoveredName = item.name(id); hoveredId = id; }
        if clicked {
            let amount = 1; if game.keyDown(game.Key.Shift) { amount = 5; }
            if game.keyDown(game.Key.Ctrl) { amount = inventory.times(carried, id); }
            crafting.push(&selection.queue, carried, id, amount);
        }
        if right { crafting.cancel(&selection.queue, carried, id); }
    }
    if hoveredName.len > 0 { buildTooltip(hoveredName, hoveredId, scale); }
}

// Draw inventory names above all slots and panels, without permanent inventory labels.
fn inventoryTooltip(ui: &Ui, stored: &Bag, carried: &Bag, selection: &Selection, scale: f32, mode: int) {
    if selection.held != 0 { return; }
    let sides = 2; if mode == MODE_BAG || mode == MODE_KILN { sides = 1; }
    for side in 0..sides {
        let bag = carried; if side == 1 { bag = stored; }
        let x = gridX(ui, side, scale); let y = gridY(ui, side, scale); let gs = gridScale(side, scale);
        for slot in 0..inventory.size(bag) {
            if !inside(x + f32(slot % 6) * STEP * gs, y + f32(slot / 6) * STEP * gs + gridGap(side, slot, scale), TILE * gs) { continue; }
            let id = inventory.slotItem(bag, slot);
            if id != 0 { buildTooltip(item.name(id), 0, scale); }
        }
    }
}
