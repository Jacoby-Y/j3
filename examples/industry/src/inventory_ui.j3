// Inventory positions, storage transfers, and one-copper structure recipes.
module industry.inventory_ui;
use j3.game;
use j3.game.{ Font, Texture, Color };
use j3.math.Vec2;
use j3.ui.Ui;
use industry.bitmap;
use industry.item_icons;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.market;

const TILE: f32 = 56;
const STEP: f32 = 60;
const PANEL: f32 = 570;
const HEIGHT: f32 = 570;
const CRAFT_PANEL: f32 = HEIGHT;
const PANEL_GAP: f32 = 12;
pub struct Selection { slot: int = -1; buildTab: int = 0; }

fn text(x: f32, y: f32, message: string, scale: f32) { bitmap.drawScaled(x, y, message, scale * 2); }
fn rect(x: f32, y: f32, w: f32, h: f32, color: Color) {
    game.setColor(color); game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}
fn frame(x: f32, y: f32, width: f32, height: f32, scale: f32) {
    rect(x, y, width * scale, height * scale, game.rgb(40, 43, 45));
    rect(x + 3 * scale, y + 3 * scale, (width - 6) * scale, (height - 6) * scale, game.rgb(93, 92, 84));
}
fn inside(x: f32, y: f32, size: f32): bool {
    let p = game.mousePos(); return p.x >= x && p.y >= y && p.x < x + size && p.y < y + size;
}
pub fn draw(stored: &Bag, carried: &Bag, icons: Texture): bool {
    let selection = Selection {}; return drawScreen(stored, carried, icons, &selection, true, false, 0);
}
pub fn drawInventory(carried: &Bag, icons: Texture, selection: &Selection): bool {
    return drawScreen(carried, carried, icons, selection, false, false, 0);
}
pub fn drawMarket(stored: &Bag, carried: &Bag, icons: Texture, coins: int): bool {
    let selection = Selection {}; return drawScreen(stored, carried, icons, &selection, true, true, coins);
}
fn drawScreen(stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection, transfer: bool, selling: bool, coins: int): bool {
    let sz = game.windowSize(); let width = PANEL + PANEL_GAP + CRAFT_PANEL;
    if transfer { width = PANEL * 2; }
    let scale: f32 = 1;
    if sz.x < width + 32 { scale = sz.x / (width + 32); }
    if sz.y < HEIGHT + 32 && sz.y / (HEIGHT + 32) < scale { scale = sz.y / (HEIGHT + 32); }
    let ui = Ui.begin(Font { raw: 0 }, (sz.x - width * scale) * 0.5, (sz.y - HEIGHT * scale) * 0.5);
    screen(&ui, stored, carried, icons, selection, scale, width, transfer, selling, coins);
    let close = Ui.begin(Font { raw: 0 }, ui.x + (width - 86) * scale, ui.y + 12 * scale);
    close.w = 72 * scale; close.h = 28 * scale; close.pushId(900);
    let clicked = close.button(""); close.popId();
    text(ui.x + (width - 80) * scale, ui.y + 19 * scale, "CLOSE", scale);
    inventoryTooltip(&ui, stored, carried, scale, transfer);
    return clicked;
}
@j3ui screen(ui: &Ui, stored: &Bag, carried: &Bag, icons: Texture, selection: &Selection, scale: f32, width: f32, transfer: bool, selling: bool, coins: int) {
    let x = ui.x; let y = ui.y; let sz = game.windowSize();
    rect(0, 0, sz.x, sz.y, game.rgba(9, 12, 15, 180));
    if transfer {
        frame(x, y, width, HEIGHT, scale);
    } else {
        frame(x, y, PANEL, HEIGHT, scale);
        frame(x + (PANEL + PANEL_GAP) * scale, y, CRAFT_PANEL, HEIGHT, scale);
    }
    if transfer {
        let title = "STORAGE"; if selling { title = "TO SELL"; }
        inventoryGrid(ui, stored, carried, icons, selection, title, 0, scale, true, selling, false);
        inventoryGrid(ui, carried, stored, icons, selection, "INVENTORY / HOTBAR", 1, scale, true, selling, true);
    } else {
        inventoryGrid(ui, carried, carried, icons, selection, "INVENTORY / HOTBAR", 0, scale, false, false, true);
        buildMenu(ui, carried, icons, selection, scale);
    }
    if selling {
        let sale = market.value(stored);
        text(x + 16 * scale, y + 526 * scale, `SALE {sale}   WALLET {coins}`, scale);
    }
}
@j3ui inventoryGrid(ui: &Ui, source: &Bag, dest: &Bag, icons: Texture, selection: &Selection, title: string, side: int, scale: f32, transfer: bool, selling: bool, hotbar: bool) {
    let x = ui.x + (16 + f32(side) * PANEL) * scale;
    let y = ui.y + 16 * scale; let gridScale = scale;
    if transfer {
        y = ui.y + 100 * scale;
        if !hotbar {
            let count = inventory.total(source);
            text(x, ui.y + 50 * scale, title, scale);
            text(x, ui.y + 72 * scale, `{count} OF 256`, scale);
        }
    } else { gridScale = scale * 1.5; }
    for slot in 0..inventory.SLOTS {
        let gap: f32 = 0; if hotbar && slot >= item.HOTBAR { gap = 4 * scale; }
        stackSlot(ui, source, dest, icons, selection, x + f32(slot % 6) * STEP * gridScale,
            y + f32(slot / 6) * STEP * gridScale + gap, slot, side, gridScale, transfer, selling);
    }
}
fn icon(icons: Texture, id: u8, x: f32, y: f32, size: f32) {
    item_icons.draw(icons, id, x, y, size);
}
@j3ui stackSlot(ui: &Ui, source: &Bag, dest: &Bag, icons: Texture, selection: &Selection, x: f32, y: f32, slot: int, side: int, scale: f32, transfer: bool, selling: bool) {
    let id = inventory.slotItem(source, slot); let hovered = inside(x, y, TILE * scale);
    let tile = Ui.begin(Font { raw: 0 }, x, y); tile.w = TILE * scale; tile.h = TILE * scale; tile.pushId(1 + side * 100 + slot);
    let clicked = tile.button(""); tile.popId();
    let edge = game.rgb(167, 161, 141);
    if hovered || (!transfer && selection.slot == slot) { edge = game.rgb(234, 202, 127); }
    rect(x, y, TILE * scale, TILE * scale, edge);
    rect(x + 2 * scale, y + 2 * scale, (TILE - 4) * scale, (TILE - 4) * scale, game.rgb(93, 92, 84));
    if id != 0 {
        icon(icons, id, x + 4 * scale, y + 2 * scale, f32(item_icons.SIZE) * scale);
        let count = source.counts[int(id)]; text(x + 3 * scale, y + 40 * scale, `{count}`, scale);
        if transfer && (clicked || (hovered && game.mousePressed(game.Mouse.Right))) {
            if !selling || side == 0 || market.price(id) > 0 {
                let amount = 1; if game.keyDown(game.Key.Shift) || game.mousePressed(game.Mouse.Right) { amount = count; }
                inventory.move(source, dest, id, amount);
            }
        }
    }
    if !transfer && clicked {
        if selection.slot < 0 { if id != 0 { selection.slot = slot; } }
        else { inventory.swap(source, selection.slot, slot); selection.slot = -1; }
    }
}
fn buildTooltip(name: string, id: u8, scale: f32) {
    // "COST: 1 COPPER ORE 3 COPPER INGOT 2 IRON INGOT". Built here: an interpolated string dies with its function.
    let cost = "";
    if id != 0 {
        let ore = item.recipeCost(id); let ingots = item.recipeIngots(id); let iron = item.recipeIron(id);
        cost = "COST:";
        if ore > 0 { cost = `{cost} {ore} COPPER ORE`; }
        if ingots > 0 { cost = `{cost} {ingots} COPPER INGOT`; }
        if iron > 0 { cost = `{cost} {iron} IRON INGOT`; }
    }
    let mouse = game.mousePos(); let sz = game.windowSize();
    let length = name.len; if cost.len > length { length = cost.len; }
    let width = f32(length * 12 + 20) * scale;
    let height: f32 = 36; if cost.len > 0 { height = 62; }
    let x = mouse.x + 16 * scale; let y = mouse.y + 16 * scale;
    if x + width > sz.x - 8 { x = sz.x - width - 8; }
    if y + height * scale > sz.y - 8 { y = mouse.y - (height + 8) * scale; }
    rect(x, y, width, height * scale, game.rgb(234, 202, 127));
    rect(x + 2 * scale, y + 2 * scale, width - 4 * scale, (height - 4) * scale, game.rgb(26, 28, 31));
    text(x + 10 * scale, y + 10 * scale, name, scale);
    if cost.len > 0 { text(x + 10 * scale, y + 36 * scale, cost, scale); }
}

@j3ui buildMenu(ui: &Ui, carried: &Bag, icons: Texture, selection: &Selection, scale: f32) {
    let x = ui.x + (PANEL + PANEL_GAP + 16) * scale;
    text(x, ui.y + 50 * scale, "BUILD", scale);
    let tabNames: [4]string = ["LOGISTICS", "PRODUCTION", "TRADE", "POWER"];
    let hoveredName: string = ""; let hoveredId: u8 = 0;
    for tab in 0..4 {
        let tx = x + f32(tab) * 132 * scale; let ty = ui.y + 80 * scale;
        let header = Ui.begin(Font { raw: 0 }, tx, ty);
        header.w = 124 * scale; header.h = 36 * scale; header.pushId(600 + tab);
        let tabClicked = header.button(""); header.popId();
        if tabClicked { selection.buildTab = tab; }
        if selection.buildTab == tab {
            rect(tx - 2 * scale, ty - 2 * scale, 128 * scale, 40 * scale, game.rgb(234, 202, 127));
        }
        rect(tx, ty, 124 * scale, 36 * scale, game.rgb(41, 43, 41));
        let label = tabNames[tab];
        text(tx + (124 - f32(label.len) * 12) * 0.5 * scale, ty + 10 * scale, label, scale);
    }
    let shown = 0;
    for recipe in 0..item.recipeCount() {
        let id = item.recipe(recipe);
        if item.tab(id) != selection.buildTab { continue; }
        let rx = x + f32(shown % 8) * STEP * scale;
        let ry = ui.y + (136 + f32(shown / 8) * STEP) * scale;
        shown += 1;
        let button = Ui.begin(Font { raw: 0 }, rx, ry);
        button.w = TILE * scale; button.h = TILE * scale; button.pushId(500 + recipe);
        let clicked = false;
        if inventory.canCraft(carried, id) { clicked = button.button(""); } else { button.buttonOff(""); }
        button.popId();
        let edge = game.rgb(167, 161, 141);
        if inside(rx, ry, TILE * scale) { edge = game.rgb(234, 202, 127); }
        rect(rx, ry, TILE * scale, TILE * scale, edge);
        rect(rx + 2 * scale, ry + 2 * scale, (TILE - 4) * scale, (TILE - 4) * scale, game.rgb(93, 92, 84));
        icon(icons, id, rx + 4 * scale, ry + 4 * scale, f32(item_icons.SIZE) * scale);
        if inside(rx, ry, TILE * scale) { hoveredName = item.name(id); hoveredId = id; }
        if clicked { inventory.craft(carried, id); }
    }
    if hoveredName.len > 0 { buildTooltip(hoveredName, hoveredId, scale); }
}

// Draw inventory names above all slots and panels, without permanent inventory labels.
fn inventoryTooltip(ui: &Ui, stored: &Bag, carried: &Bag, scale: f32, transfer: bool) {
    let sides = 1; if transfer { sides = 2; }
    let gridScale = scale; if !transfer { gridScale = scale * 1.5; }
    for side in 0..sides {
        let bag = stored; if side == 1 { bag = carried; }
        let x = ui.x + (16 + f32(side) * PANEL) * scale;
        let y = ui.y + 16 * scale; if transfer { y = ui.y + 100 * scale; }
        for slot in 0..inventory.SLOTS {
            let gap: f32 = 0;
            if (!transfer || side == 1) && slot >= item.HOTBAR { gap = 4 * scale; }
            if !inside(x + f32(slot % 6) * STEP * gridScale, y + f32(slot / 6) * STEP * gridScale + gap, TILE * gridScale) { continue; }
            let id = inventory.slotItem(bag, slot);
            if id != 0 { buildTooltip(item.name(id), 0, scale); }
        }
    }
}
