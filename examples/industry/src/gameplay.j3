// Industry: a small, editable voxel world. Research and automation grow from here.
// `update` and `draw` only sequence the frame; rules live in the modules they call.
module industry.gameplay;

use j3.game;
use j3.math.Vec3;
use industry.chunks;
use industry.console;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.drops;
use industry.fx.cubes;
use industry.fx.effects;
use industry.fx.emitters;
use industry.fx.pool;
use industry.crafting;
use industry.inventory;
use industry.inventory_ui;
use industry.interact;
use industry.lighting;
use industry.machine.belts;
use industry.machine.container;
use industry.machine.furnace;
use industry.machine.market;
use industry.mining;
use industry.models;
use industry.placement;
use industry.player;
use j3.gfx.Look;
use industry.render;
use industry.session;
use industry.session.Game;
use industry.ui;
use industry.wire_draw;
use industry.wiring;
use industry.world;
use industry.world.World;

// Machines run at this fixed rate whatever the frame time, so a slow frame cannot
// lose production. At most MAX_SIM_STEPS catch up after a hitch; older time is dropped.
pub const SIM_STEP: f32 = 0.016666668;
pub const MAX_SIM_STEPS: int = 120;
const STAGE_POWER: int = 0;
const STAGE_FURNACE: int = 1;
const STAGE_BELTS: int = 2;
const STAGE_DRILL: int = 3;
const STAGES: int = 4;

// One machine stage of a step. With `g.profile` set, its time accumulates in `g.stageUs`.
fn runStage(g: &Game, stage: int) {
    let begin = 0;
    if g.profile { begin = game.micros(); }
    if stage == STAGE_POWER { g.power.update(&g.world, SIM_STEP); }
    if stage == STAGE_FURNACE { g.furnace.update(&g.world, SIM_STEP); }
    if stage == STAGE_BELTS { belts.update(&g.world, SIM_STEP); }
    if stage == STAGE_DRILL { g.drill.update(&g.world, SIM_STEP); }
    if g.profile { g.stageUs[stage] += game.micros() - begin; }
}

pub fn simulate(g: &Game, dt: f32) {
    g.clock += dt;
    let steps = 0;
    while g.clock >= SIM_STEP - 0.00001 && steps < MAX_SIM_STEPS {
        // Power first, so machines read this step's supply; then existing batches before belts deliver new input.
        for stage in 0..STAGES { runStage(g, stage); }
        g.clock -= SIM_STEP;
        steps += 1;
    }
    if steps == MAX_SIM_STEPS { g.clock = 0; }
}

// What the player points at, and what placing would do there. Read by update and draw.
fn aim(g: &Game) {
    let eye = player.lookCells(&g.player);
    g.hit = world.pick(&g.world, eye.eye, eye.forward());
    g.looked = 0;
    if g.hit.ok { g.looked = world.get(&g.world, g.hit.x, g.hit.y, g.hit.z); }
    g.plan = placement.resolveInventory(&g.world, &g.player, &g.carried, g.hit, g.rotation, game.keyDown(game.Key.Shift));
}

pub fn update(g: &Game, dt: f32) {
    simulate(g, dt);
    drops.update(&g.drops, &g.world, &g.player, &g.carried, dt);
    crafting.update(&g.selectedInventory.queue, &g.carried, dt);
    let look = player.lookCells(&g.player);
    emitters.tick(&g.fx, &g.world, look.eye, dt);
    pool.update(&g.fx, &g.world, dt);
    mining.pause(&g.mining, dt);
    if g.noteTime > 0 { g.noteTime -= dt; }
    wiring.tidy(g);
    if g.inventoryOpen {
        if (g.openStore >= 0 && !session.storeValid(&g.world, g.openStore)) ||
            game.keyPressed(game.Key.Tab) || game.keyPressed(game.Key.E) || game.keyPressed(game.Key.Escape) {
            session.closeInventory(g);
        }
        return;
    }
    let consoleOpen = console.update(&g.console, &g.world, &g.carried);
    if g.console.fire >= 0 { effects.test(&g.fx, g.console.fire, g.hit); g.console.fire = -1; }
    if consoleOpen { return; }
    if game.keyPressed(game.Key.Tab) {
        g.inventoryOpen = true;
        game.captureMouse(false);
        return;
    }
    player.selectSlot(&g.player);
    if game.keyPressed(game.Key.R) {
        // A held lifter has no direction: R flips it between lifting (0) and lowering (4).
        let held = item.blockFor(inventory.slotItem(&g.carried, g.player.slot));
        if block.lowerer(held) != held { g.rotation = (g.rotation + 4) % 8; }
        else { g.rotation = conveyor.rotate(g.rotation % 4); }
    }
    if game.keyPressed(game.Key.Q) {
        // Q throws one of the held hotbar item, Ctrl+Q the whole stack.
        let id = inventory.slotItem(&g.carried, g.player.slot);
        let n = 1; if game.keyDown(game.Key.Ctrl) { n = g.carried.counts[int(id)]; }
        session.throwItem(g, id, inventory.takeAt(&g.carried, g.player.slot, n));
    }
    if game.keyPressed(game.Key.Escape) { game.captureMouse(false); return; }
    let wasCaptured = game.mouseCaptured();
    // Avoid pre-capture cursor movement on the focus click.
    if wasCaptured { player.update(&g.player, &g.world, dt); }
    aim(g);
    if interact.keys(g) { return; }
    if !wasCaptured {
        if !game.mousePressed(game.Mouse.Left) && !game.mousePressed(game.Mouse.Right) { return; }
        game.captureMouse(true);
    }
    interact.mouse(g, dt);
    chunks.tick(&g.world, dt);
}

pub fn draw(g: &Game) {
    let eye = player.lookCells(&g.player);
    if g.world.dirty { render.rebuild(&g.world, eye.eye); }
    let seconds = f32(game.ticks()) * 0.001;
    lighting.begin(&g.world, player.camera(&g.player), &g.assets, seconds);
    render.drawTerrain(&g.world, eye.eye * world.VOXEL);
    models.drawWorld(&g.world, &g.assets, seconds);
    cubes.draw(&g.fx, eye.eye);
    drops.draw(&g.drops, g.fx.cube, seconds);
    render.boundaries(&g.world, &g.assets, g.barrier);
    render.miningFeedback(&g.world, &g.assets, &g.miningShade, &g.mining, seconds);
    render.hover(&g.world, g.hit);
    wire_draw.draw(&g.world, g.wireFrom, g.hit, eye.eye, eye.forward());
    if g.inventoryOpen { drawInventory(g); return; }
    if g.plan.visible {
        render.footprint(g.plan);
        if world.machine(g.plan.id) {
            models.ghost(&g.assets, g.plan.id, models.transform(g.plan.x, g.plan.y, g.plan.z, g.plan.dir), g.plan.ok);
        }
    }
    ui.draw(&g.player, &g.carried, g.inventoryIcons, g.world.coins, mining.fraction(&g.mining),
        unlockCost(&g.world, player.lookCells(&g.player)));
    ui.context(&g.world, g.hit, inventory.slotItem(&g.carried, g.player.slot), &g.hoverText);
    ui.note(wireHint(g));
    if g.console.open { console.draw(&g.console); }
}

fn drawInventory(g: &Game) {
    let closed = false;
    if g.openStore >= 0 && furnace.valid(&g.world, g.openStore) {
        closed = inventory_ui.drawFurnace(&g.world, g.openStore, &g.carried, g.inventoryIcons, &g.selectedInventory);
    } else if g.openStore >= 0 && container.valid(&g.world, g.openStore) {
        let stored = container.contents(&g.world, g.openStore);
        if market.valid(&g.world, g.openStore) {
            closed = inventory_ui.drawMarket(&stored, &g.carried, g.inventoryIcons, &g.selectedInventory, g.world.coins);
        } else {
            closed = inventory_ui.draw(&stored, &g.carried, g.inventoryIcons, &g.selectedInventory);
        }
    } else {
        closed = inventory_ui.drawInventory(&g.carried, g.inventoryIcons, &g.selectedInventory);
    }
    // A click outside the screen throws what the cursor holds.
    if g.selectedInventory.drop != 0 {
        session.dropHeld(g, g.selectedInventory.drop == 1);
        g.selectedInventory.drop = 0;
    }
    if closed { session.closeInventory(g); }
}

// Price of the chunk whose lock you are looking at, or -1.
fn unlockCost(w: &World, look: Look): int {
    let target = chunks.lockAt(w, look.eye, look.forward());
    if target < 0 { return -1; }
    return chunks.cost(w, target % world.CHUNKS, target / world.CHUNKS);
}

// Short line above the hotbar: the last wiring result, else what the wire in hand does next.
fn wireHint(g: &Game): string {
    if g.noteTime > 0 { return g.note; }
    if !wiring.holding(g) { return ""; }
    if g.wireFrom < 0 { return "[RMB] POST OR MACHINE: START WIRE"; }
    return "[RMB] OTHER END: CONNECT";
}
