// The file-backed silhouette drives the held tool and its front-view icon.
module industry.pickaxe;
use industry.subvoxels;
use industry.subvoxels.Grid;
use j3.memory.Arena;
use j3.gfx.canvas;
use j3.gfx.canvas.Canvas;

pub fn model(mem: &Arena): Grid {
    return subvoxels.load("assets/models/pickaxe.j3voxel", mem);
}

pub fn sprite(c: &Canvas) {
    let mem = Arena.create(1024);
    let g = model(&mem);
    for y in 0..16 { for x in 0..16 {
        let id = g.cells[x + 4 + 24 * (12 + 24 * y)];
        if id == 0 { continue; }
        let tint = g.colors[int(id) - 1];
        c.fillRect(i32(x * 4), i32((15 - y) * 4), 4, 4,
            canvas.rgb(u8(tint.x * 255 + 0.5), u8(tint.y * 255 + 0.5), u8(tint.z * 255 + 0.5)));
    } }
    mem.destroy();
}
