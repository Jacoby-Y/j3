// Integer authoring coordinates: one cell is exactly 1/8 of a world voxel.
module industry.subvoxels;
use j3.gfx;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.sys;
use industry.j3voxel;
use industry.j3voxel.Voxels;

pub const SX: int = 24;
pub const SY: int = 36;
pub const SZ: int = 24;
const ORIGIN: int = 12;
const MAX_FACES: int = 12000;

pub struct Grid {
    height: int = 36;
    cells: []u8;
    colors: []Vec3;
    colorCount: int;
    scratch: []f32;
    mask: []u8;
    glow: bool = false;
}

pub fn create(mem: &Arena): Grid {
    return Grid { cells: mem.alloc::<u8>(SX * SY * SZ), colors: mem.alloc::<Vec3>(255),
        colorCount: 0, mask: mem.alloc::<u8>(SZ * SY), scratch: mem.alloc::<f32>(MAX_FACES * 60) };
}

// X/Z and the bottom origin stay fixed; tall poles may extend the canvas upward.
pub fn usable(v: &Voxels): bool {
    if v.sx != SX || (v.sy != SY && v.sy != 60) || v.sz != SZ { return false; }
    for cell in v.cells { if cell != 0 { return true; } }
    return false;
}

pub fn load(path: string, mem: &Arena): Grid {
    let v = j3voxel.load(path, mem);
    if !usable(&v) { sys.panic(`invalid voxel model {path}: expected a nonempty 24x36x24 or 24x60x24 grid with valid colors`); }
    let g = create(mem);
    g.height = v.sy;
    if g.height > SY { g.mask = mem.alloc::<u8>(SZ * g.height); }
    g.cells = v.cells;
    for i in 1..256 {
        g.colors[i - 1] = Vec3.xyz(f32(v.pal[i * 3]) / 255,
            f32(v.pal[i * 3 + 1]) / 255, f32(v.pal[i * 3 + 2]) / 255);
    }
    for cell in g.cells { if int(cell) > g.colorCount { g.colorCount = int(cell); } }
    return g;
}

fn material(g: &Grid, color: Vec3): u8 {
    for i in 0..g.colorCount {
        let c = g.colors[i];
        if c.x == color.x && c.y == color.y && c.z == color.z { return u8(i + 1); }
    }
    if g.colorCount >= g.colors.len { sys.panic("subvoxel palette full"); }
    g.colors[g.colorCount] = color;
    g.colorCount += 1;
    return u8(g.colorCount);
}

// Boxes paint occupied cells; later details replace earlier materials instead of overlapping faces.
pub fn box(g: &Grid, color: Vec3, x: int, y: int, z: int, w: int, h: int, d: int) {
    if w <= 0 || h <= 0 || d <= 0 || x < -ORIGIN || z < -ORIGIN || y < 0 ||
        x + w > SX - ORIGIN || z + d > SZ - ORIGIN || y + h > g.height {
        sys.panic("subvoxel box outside model grid");
    }
    let id = material(g, color);
    for py in y..y + h { for pz in z..z + d { for px in x..x + w {
        g.cells[px + ORIGIN + SX * (pz + ORIGIN + SZ * py)] = id;
    } } }
}

pub fn get(g: &Grid, x: int, y: int, z: int): u8 {
    if x < 0 || y < 0 || z < 0 || x >= SX || y >= g.height || z >= SZ { return 0; }
    return g.cells[x + SX * (z + SZ * y)];
}

// Local integer coordinates, also useful for checking moving parts against the shell.
pub fn occupied(g: &Grid, x: int, y: int, z: int): bool {
    return get(g, x + ORIGIN, y, z + ORIGIN) != 0;
}

pub fn vertices(g: &Grid): []f32 {
    let at = 0;
    let emission: f32 = 0;
    if g.glow { emission = 1; }
    for y in 0..g.height { for z in 0..SZ { for x in 0..SX {
        let id = get(g, x, y, z);
        if id == 0 { continue; }
        let color = g.colors[int(id) - 1];
        for face in 0..6 {
            let nx = x; let ny = y; let nz = z;
            if face == gfx.FACE_NX { nx -= 1; }
            if face == gfx.FACE_PX { nx += 1; }
            if face == gfx.FACE_NY { ny -= 1; }
            if face == gfx.FACE_PY { ny += 1; }
            if face == gfx.FACE_NZ { nz -= 1; }
            if face == gfx.FACE_PZ { nz += 1; }
            if get(g, nx, ny, nz) != 0 { continue; }
            if at + 60 > g.scratch.len { sys.panic("subvoxel mesh full"); }
            at = gfx.emitFace(g.scratch, at, f32(x - ORIGIN), f32(y), f32(z - ORIGIN), face,
                color.x, color.y, color.z, emission);
        }
    } } }
    // Positions are integral until this exact power-of-two scale. Normals stay axis-aligned.
    let vertex = 0;
    while vertex < at {
        g.scratch[vertex] *= 0.125;
        g.scratch[vertex + 1] *= 0.125;
        g.scratch[vertex + 2] *= 0.125;
        vertex += 10;
    }
    return g.scratch[0..at];
}
