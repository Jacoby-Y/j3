// Distance is measured to the chunk footprint, not its center, in meters.
module industry.terrain_lod;
use j3.math;
use j3.math.Vec3;
use industry.world;

pub const DETAIL_ENTER: f32 = 24;
pub const DETAIL_EXIT: f32 = 32;

pub fn level(cx: int, cz: int, eye: Vec3, previous: u8): u8 {
    let x = f32(cx * world.CHUNK) * world.VOXEL;
    let z = f32(cz * world.CHUNK) * world.VOXEL;
    let size = f32(world.CHUNK) * world.VOXEL;
    let dx = math.max(0, math.max(x - eye.x, eye.x - (x + size)));
    let dz = math.max(0, math.max(z - eye.z, eye.z - (z + size)));
    let distance = dx * dx + dz * dz;
    if previous == 0 && distance <= DETAIL_EXIT * DETAIL_EXIT { return 0; }
    if previous != 0 && distance < DETAIL_ENTER * DETAIL_ENTER { return 0; }
    return 1;
}
