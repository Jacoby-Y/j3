fn ores() {
    defs.ore(OreDef { node: block.COPPER_NODE, vein: block.COPPER_ORE, item: item.COPPER, nodeModel: M_COPPER_NODE, offset: 24, chance: 60 });
    defs.ore(OreDef { node: block.COAL_NODE, vein: block.COAL_ORE, item: item.COAL, nodeModel: M_COAL_NODE, offset: 30, chance: 50 });
    defs.ore(OreDef { node: block.IRON_NODE, vein: block.IRON_ORE, item: item.IRON, nodeModel: M_IRON_NODE, offset: 36, minRing: 2, chance: 40 });
}

// Particle effects. Size classes: 0 = 1/16 voxel, 1 = 1/8, 2 = 1/4, 3 = 1/2, 4 = 1.
fn effects() {
    // Chips off the face being mined: small, quick, and the block's own color.
    defs.effect(FX_DUST, EffectDef { name: "dust", rate: 9, size: 1, sizeSpread: 1, speed: 3, spread: 1.2, gravity: 14, life: 0.55,
        fromSource: true, collide: true });
    // A broken block: a handful of chunks that fall, bounce and rest before they vanish.
    defs.effect(FX_DEBRIS, EffectDef { name: "debris", count: 14, size: 0, sizeSpread: 2, speed: 5, spread: 0.9, gravity: 16, life: 1.4,
        scatter: 0.35, fromSource: true, collide: true, bounce: true, shrink: true });
    // Furnace and generator smoke: dark, slow, rising, shrinking to nothing.
    defs.effect(FX_SMOKE, EffectDef { name: "smoke", rate: 2, size: 2, sizeSpread: 1, speed: 0.9, spread: 0.35, gravity: -0.8, drag: 0.4, life: 2.4,
        lifeSpread: 0.4, colorA: defs.pack(70, 70, 74), colorB: defs.pack(120, 120, 126), shrink: true, alpha: 0.7, fade: true });
    // Hot sparks: fast, glowing, bouncing off the ground.
    defs.effect(FX_SPARK, EffectDef { name: "spark", rate: 3, size: 0, sizeSpread: 1, speed: 4.5, spread: 0.8, gravity: 13, life: 0.8,
        colorA: defs.pack(255, 190, 70), colorB: defs.pack(255, 120, 40), glow: 1, collide: true, bounce: true });
    // Embers: tiny glowing flecks drifting up and out.
    defs.effect(FX_EMBER, EffectDef { name: "ember", rate: 1.7, size: 0, speed: 1.2, spread: 0.7, gravity: -1.4, drag: 0.5, life: 1.6,
        colorA: defs.pack(255, 150, 50), colorB: defs.pack(255, 90, 30), glow: 1, shrink: true });
    // Steam: pale and light, a bigger puff than smoke.
    defs.effect(FX_STEAM, EffectDef { name: "steam", rate: 2.7, size: 2, sizeSpread: 1, speed: 1.2, spread: 0.3, gravity: -1.2, drag: 0.6, life: 1.8,
        colorA: defs.pack(200, 205, 210), colorB: defs.pack(235, 238, 240), shrink: true });
    // A thin, slow grey thread drifting up off a working drill.
    defs.effect(FX_WISP, EffectDef { name: "wisp", rate: 3, size: 1, sizeSpread: 1, speed: 0.5, spread: 0.25, gravity: -0.5, drag: 0.3, life: 2.2,
        lifeSpread: 0.4, scatter: 0.12, colorA: defs.pack(95, 95, 100), colorB: defs.pack(150, 150, 156), shrink: true, alpha: 0.55, fade: true });
}

// Structure effects: while the block runs, the effect sprays from the point (model units, 1/8 voxel
// from the bottom centre of the footprint) along the direction. Rows of one block go together.
fn emitters() {
    emit(block.FURNACE, FX_SMOKE, 0, 32, 0, 0, 1, 0);
    emit(block.FURNACE, FX_EMBER, 0, 30, 0, 0, 1, 0);
    emit(block.GENERATOR, FX_SMOKE, 0, 32, 0, 0, 1, 0);
    emit(block.ELECTRIC_SMELTER, FX_SPARK, 0, 30, 0, 0, 1, 0);
    // The ore is right in front of the bit, so the dust leaves up and out to the sides.
    emit(block.DRILL, FX_DUST, 0, 16, -11, 0, 1, 0.2);
    emit(block.DRILL, FX_DUST, -9, 8, -11, -1, 0.4, 0);
    emit(block.DRILL, FX_DUST, 9, 8, -11, 1, 0.4, 0);
    emit(block.DRILL, FX_WISP, 0, 17, 2, 0, 1, 0);
    emit(block.ELECTRIC_DRILL, FX_DUST, 0, 16, -11, 0, 1, 0.2);
    emit(block.ELECTRIC_DRILL, FX_DUST, -9, 8, -11, -1, 0.4, 0);
    emit(block.ELECTRIC_DRILL, FX_DUST, 9, 8, -11, 1, 0.4, 0);
    emit(block.ELECTRIC_DRILL, FX_WISP, 0, 17, 2, 0, 1, 0);
}

fn emit(id: u8, effect: int, x: int, y: int, z: int, dx: f32, dy: f32, dz: f32) {
    defs.emitter(EmitterDef { block: id, effect: effect, x: x, y: y, z: z, dx: dx, dy: dy, dz: dz });
}

pub fn load() {
    if defs.loaded() { return; }
    models();
    blocks();
    items();
    ores();
    effects();
    emitters();
    defs.markLoaded();
}
