fn terrain(id: u8, r: f32, g: f32, b: f32) { defs.block(id, BlockDef { r: r, g: g, b: b }); }

fn machine(id: u8, r: f32, g: f32, b: f32, height: int, storage: bool, mesh: int, overlay: int, mode: int) {
    defs.block(id, BlockDef { r: r, g: g, b: b, machine: true, storage: storage, height: height,
        model: mesh, overlay: overlay, overlayMode: mode });
}

// Belt family: one voxel tall, cargo moves `speed` cells per second.
fn belt(id: u8, r: f32, g: f32, b: f32, mesh: int, speed: f32, route: int) {
    defs.block(id, BlockDef { r: r, g: g, b: b, machine: true, height: 1, model: mesh, overlay: -1,
        overlayMode: defs.OVERLAY_NONE, speed: speed, route: route });
}

// A storage block holding `stacks` stacks.
fn store(id: u8, r: f32, g: f32, b: f32, mesh: int, stacks: int) {
    defs.block(id, BlockDef { r: r, g: g, b: b, machine: true, storage: true, height: 3, model: mesh, overlay: -1,
        overlayMode: defs.OVERLAY_NONE, stacks: stacks });
}

fn blocks() {
    defs.block(block.AIR, BlockDef {});
    terrain(block.STONE, 0.45, 0.49, 0.53);
    terrain(block.DIRT, 0.47, 0.33, 0.22);
    terrain(block.GRASS, 0.35, 0.62, 0.35);
    terrain(block.COPPER_NODE, 0.77, 0.42, 0.22);
    terrain(block.FOUNDATION, 0.68, 0.72, 0.69);
    belt(block.CONVEYOR, 0.29, 0.37, 0.42, M_BELT, BELT_SPEED, defs.ROUTE_LINE);
    machine(block.DRILL, 0.33, 0.36, 0.38, 2, false, M_DRILL, M_BIT, defs.OVERLAY_SPIN);
    machine(block.FURNACE, 0.43, 0.35, 0.3, 4, false, M_FURNACE, M_FIRE, defs.OVERLAY_LIT);
    store(block.CONTAINER, 0.24, 0.38, 0.35, M_CONTAINER, 3);
    terrain(block.COAL_NODE, 0.1, 0.1, 0.11);
    machine(block.MARKET, 0.3, 0.4, 0.46, 3, true, M_MARKET, -1, defs.OVERLAY_NONE);
    terrain(block.COPPER_ORE, 0.77, 0.42, 0.22);
    terrain(block.COAL_ORE, 0.1, 0.1, 0.11);
    machine(block.POST, 0.36, 0.4, 0.43, 7, false, M_POST, -1, defs.OVERLAY_NONE);
    machine(block.GENERATOR, 0.24, 0.28, 0.31, 4, false, M_GENERATOR, M_GENERATOR_FIRE, defs.OVERLAY_LIT);
    machine(block.ELECTRIC_DRILL, 0.17, 0.48, 0.88, 2, false, M_ELECTRIC_DRILL, M_ELECTRIC_BIT, defs.OVERLAY_SPIN);
    machine(block.ELECTRIC_SMELTER, 0.23, 0.29, 0.42, 4, false, M_ELECTRIC_SMELTER, M_ARC, defs.OVERLAY_LIT);
    terrain(block.IRON_NODE, 0.55, 0.58, 0.62);
    terrain(block.IRON_ORE, 0.55, 0.58, 0.62);
    belt(block.CONVEYOR_MK2, 0.25, 0.4, 0.55, M_BELT2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_LINE);
    belt(block.SPLITTER, 0.29, 0.37, 0.42, M_SPLITTER, BELT_SPEED, defs.ROUTE_SPLIT);
    belt(block.SPLITTER_MK2, 0.25, 0.4, 0.55, M_SPLITTER2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_SPLIT);
    belt(block.LIFTER, 0.29, 0.37, 0.42, M_LIFTER, BELT_SPEED, defs.ROUTE_LIFT);
    belt(block.LIFTER_MK2, 0.25, 0.4, 0.55, M_LIFTER2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_LIFT);
    belt(block.LOWERER, 0.29, 0.37, 0.42, M_LOWERER, BELT_SPEED, defs.ROUTE_LOWER);
    belt(block.LOWERER_MK2, 0.25, 0.4, 0.55, M_LOWERER2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_LOWER);
    store(block.CONTAINER_MK2, 0.25, 0.4, 0.55, M_CONTAINER2, 6);
    defs.pair(block.CONVEYOR, block.CONVEYOR_MK2); defs.pair(block.SPLITTER, block.SPLITTER_MK2);
    defs.pair(block.LIFTER, block.LIFTER_MK2); defs.pair(block.LOWERER, block.LOWERER_MK2);
    defs.pair(block.CONTAINER, block.CONTAINER_MK2); defs.pair(block.DRILL, block.ELECTRIC_DRILL);
    defs.pair(block.FURNACE, block.ELECTRIC_SMELTER);
}



