// The one place that says what exists: models, blocks, items and ores. To add an ore, add its
// block, item and model ids, then one row each here and a `.j3voxel` file; nothing else
// needs a list edit. A structure also needs a behavior module and an arm in `machine.dispatch`.
module industry.data.content;

use industry.data.block;
use industry.data.defs;
use industry.data.defs.{ ItemDef, BlockDef, OreDef, ModelDef, EffectDef, EmitterDef };
use industry.data.item;

