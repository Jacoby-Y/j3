// The one place that says what exists: models, blocks, items and ores. To add an ore, add its
// block, item and model ids, then one row each here and a `.j3voxel` file; nothing else
// needs a list edit. A structure also needs a behavior module and an arm in `machine.dispatch`.
module industry.data.content;

use industry.data.block;
use industry.data.defs;
use industry.data.defs.{ ItemDef, BlockDef, OreDef, ModelDef };
use industry.data.item;

pub const M_PICKAXE: int = 0;
pub const M_DRILL: int = 1;
pub const M_BIT: int = 2;
pub const M_BELT: int = 3;
pub const M_FURNACE: int = 4;
pub const M_CONTAINER: int = 5;
pub const M_MARKET: int = 6;
pub const M_FIRE: int = 7;
pub const M_COPPER_NODE: int = 8;
pub const M_COAL_NODE: int = 9;
pub const M_COPPER_CARGO: int = 10;
pub const M_COAL_CARGO: int = 11;
pub const M_INGOT: int = 12;
pub const M_POST: int = 13;
pub const M_GENERATOR: int = 14;
pub const M_GENERATOR_FIRE: int = 15;
pub const M_ELECTRIC_DRILL: int = 16;
pub const M_ELECTRIC_BIT: int = 17;
pub const M_ELECTRIC_SMELTER: int = 18;
pub const M_ARC: int = 19;
pub const M_IRON_NODE: int = 20;
pub const M_IRON_CARGO: int = 21;
pub const M_IRON_INGOT: int = 22;
pub const M_BELT2: int = 23;
pub const M_SPLITTER: int = 24;
pub const M_SPLITTER2: int = 25;
pub const M_LIFTER: int = 26;
pub const M_LIFTER2: int = 27;

// Cells per second on a basic belt; Mk.2 is three times that.
const BELT_SPEED: f32 = 1;
const MK2_FACTOR: f32 = 3;

fn model(id: int, path: string, batch: int) {
    defs.model(id, ModelDef { path: path, glow: false, batch: batch });
}

fn models() {
    model(M_PICKAXE, "assets/models/pickaxe.j3voxel", defs.BATCH_NONE);
    model(M_DRILL, "assets/models/drill.j3voxel", defs.BATCH_MACHINE);
    model(M_BIT, "assets/models/drill-bit.j3voxel", defs.BATCH_MACHINE);
    model(M_BELT, "assets/models/conveyor.j3voxel", defs.BATCH_MACHINE);
    model(M_FURNACE, "assets/models/furnace.j3voxel", defs.BATCH_MACHINE);
    model(M_CONTAINER, "assets/models/container.j3voxel", defs.BATCH_MACHINE);
    model(M_MARKET, "assets/models/market.j3voxel", defs.BATCH_MACHINE);
    defs.model(M_FIRE, ModelDef { path: "assets/models/furnace-fire.j3voxel", glow: true, batch: defs.BATCH_MACHINE });
    model(M_COPPER_NODE, "assets/models/copper-node.j3voxel", defs.BATCH_NODE);
    model(M_COAL_NODE, "assets/models/coal-node.j3voxel", defs.BATCH_NODE);
    model(M_COPPER_CARGO, "assets/models/copper-cargo.j3voxel", defs.BATCH_CARGO);
    model(M_COAL_CARGO, "assets/models/coal-cargo.j3voxel", defs.BATCH_CARGO);
    model(M_INGOT, "assets/models/copper-ingot.j3voxel", defs.BATCH_CARGO);
    model(M_POST, "assets/models/power-post.j3voxel", defs.BATCH_MACHINE);
    model(M_GENERATOR, "assets/models/generator.j3voxel", defs.BATCH_MACHINE);
    defs.model(M_GENERATOR_FIRE, ModelDef { path: "assets/models/generator-fire.j3voxel", glow: true, batch: defs.BATCH_MACHINE });
    model(M_ELECTRIC_DRILL, "assets/models/electric-drill.j3voxel", defs.BATCH_MACHINE);
    model(M_ELECTRIC_BIT, "assets/models/electric-drill-bit.j3voxel", defs.BATCH_MACHINE);
    model(M_ELECTRIC_SMELTER, "assets/models/electric-smelter.j3voxel", defs.BATCH_MACHINE);
    defs.model(M_ARC, ModelDef { path: "assets/models/electric-smelter-fire.j3voxel", glow: true, batch: defs.BATCH_MACHINE });
    model(M_IRON_NODE, "assets/models/iron-node.j3voxel", defs.BATCH_NODE);
    model(M_IRON_CARGO, "assets/models/iron-cargo.j3voxel", defs.BATCH_CARGO);
    model(M_IRON_INGOT, "assets/models/iron-ingot.j3voxel", defs.BATCH_CARGO);
    model(M_BELT2, "assets/models/conveyor-mk2.j3voxel", defs.BATCH_MACHINE);
    model(M_SPLITTER, "assets/models/splitter.j3voxel", defs.BATCH_MACHINE);
    model(M_SPLITTER2, "assets/models/splitter-mk2.j3voxel", defs.BATCH_MACHINE);
    model(M_LIFTER, "assets/models/lifter.j3voxel", defs.BATCH_MACHINE);
    model(M_LIFTER2, "assets/models/lifter-mk2.j3voxel", defs.BATCH_MACHINE);
}

fn terrain(id: u8, r: f32, g: f32, b: f32) { defs.block(id, BlockDef { r: r, g: g, b: b }); }

fn machine(id: u8, r: f32, g: f32, b: f32, height: int, storage: bool, mesh: int, overlay: int, mode: int) {
    defs.block(id, BlockDef { r: r, g: g, b: b, machine: true, storage: storage, height: height,
        model: mesh, overlay: overlay, overlayMode: mode });
}

// Belt family: one voxel tall, cargo moves `speed` cells per second.
fn belt(id: u8, r: f32, g: f32, b: f32, mesh: int, speed: f32, route: int) {
    defs.block(id, BlockDef { r: r, g: g, b: b, machine: true, height: 1, model: mesh, overlay: -1,
        overlayMode: defs.OVERLAY_NONE, speed: speed, route: route });
}

fn blocks() {
    defs.block(block.AIR, BlockDef {});
    terrain(block.STONE, 0.45, 0.49, 0.53);
    terrain(block.DIRT, 0.47, 0.33, 0.22);
    terrain(block.GRASS, 0.35, 0.62, 0.35);
    terrain(block.COPPER_NODE, 0.77, 0.42, 0.22);
    terrain(block.FOUNDATION, 0.68, 0.72, 0.69);
    belt(block.CONVEYOR, 0.29, 0.37, 0.42, M_BELT, BELT_SPEED, defs.ROUTE_LINE);
    machine(block.DRILL, 0.33, 0.36, 0.38, 2, false, M_DRILL, M_BIT, defs.OVERLAY_SPIN);
    machine(block.FURNACE, 0.43, 0.35, 0.3, 4, false, M_FURNACE, M_FIRE, defs.OVERLAY_LIT);
    machine(block.CONTAINER, 0.24, 0.38, 0.35, 3, true, M_CONTAINER, -1, defs.OVERLAY_NONE);
    terrain(block.COAL_NODE, 0.1, 0.1, 0.11);
    machine(block.MARKET, 0.3, 0.4, 0.46, 3, true, M_MARKET, -1, defs.OVERLAY_NONE);
    terrain(block.COPPER_ORE, 0.77, 0.42, 0.22);
    terrain(block.COAL_ORE, 0.1, 0.1, 0.11);
    machine(block.POST, 0.36, 0.4, 0.43, 4, false, M_POST, -1, defs.OVERLAY_NONE);
    machine(block.GENERATOR, 0.24, 0.28, 0.31, 4, false, M_GENERATOR, M_GENERATOR_FIRE, defs.OVERLAY_LIT);
    machine(block.ELECTRIC_DRILL, 0.17, 0.48, 0.88, 2, false, M_ELECTRIC_DRILL, M_ELECTRIC_BIT, defs.OVERLAY_SPIN);
    machine(block.ELECTRIC_SMELTER, 0.23, 0.29, 0.42, 4, false, M_ELECTRIC_SMELTER, M_ARC, defs.OVERLAY_LIT);
    terrain(block.IRON_NODE, 0.55, 0.58, 0.62);
    terrain(block.IRON_ORE, 0.55, 0.58, 0.62);
    belt(block.CONVEYOR_MK2, 0.25, 0.4, 0.55, M_BELT2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_LINE);
    belt(block.SPLITTER, 0.29, 0.37, 0.42, M_SPLITTER, BELT_SPEED, defs.ROUTE_SPLIT);
    belt(block.SPLITTER_MK2, 0.25, 0.4, 0.55, M_SPLITTER2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_SPLIT);
    belt(block.LIFTER, 0.29, 0.37, 0.42, M_LIFTER, BELT_SPEED, defs.ROUTE_LIFT);
    belt(block.LIFTER_MK2, 0.25, 0.4, 0.55, M_LIFTER2, BELT_SPEED * MK2_FACTOR, defs.ROUTE_LIFT);
}



fn items() {
    defs.item(0, ItemDef { name: "EMPTY" });
    defs.item(item.STONE, ItemDef { name: "STONE", price: 1, block: block.STONE,
        top: defs.pack(151, 162, 164), left: defs.pack(105, 116, 123), right: defs.pack(75, 88, 96) });
    defs.item(item.DIRT, ItemDef { name: "DIRT", price: 1, block: block.DIRT,
        top: defs.pack(164, 125, 81), left: defs.pack(126, 87, 52), right: defs.pack(95, 63, 40) });
    defs.item(item.FOUNDATION, ItemDef { name: "FOUNDATION", block: block.FOUNDATION,
        top: defs.pack(214, 217, 200), left: defs.pack(163, 176, 169), right: defs.pack(131, 148, 146) });
    defs.item(item.CONVEYOR, ItemDef { name: "CONVEYOR", block: block.CONVEYOR, cost: 1, hotbar: 1, tab: 0,
        icon: "assets/models/conveyor.j3voxel" });
    defs.item(item.DRILL, ItemDef { name: "DRILL", block: block.DRILL, cost: 1, hotbar: 2, tab: 1,
        icon: "assets/models/drill.j3voxel", iconTip: "assets/models/drill-bit.j3voxel" });
    defs.item(item.COPPER, ItemDef { name: "RAW COPPER", price: 1, cargo: M_COPPER_CARGO, smelts: item.COPPER_INGOT,
        icon: "assets/models/copper-cargo.j3voxel" });
    defs.item(item.FURNACE, ItemDef { name: "FURNACE", block: block.FURNACE, cost: 1, hotbar: 3, tab: 1,
        icon: "assets/models/furnace.j3voxel" });
    defs.item(item.COPPER_INGOT, ItemDef { name: "COPPER INGOT", price: 3, cargo: M_INGOT,
        icon: "assets/models/copper-ingot.j3voxel" });
    defs.item(item.CONTAINER, ItemDef { name: "CONTAINER", block: block.CONTAINER, cost: 1, hotbar: 4, tab: 0,
        icon: "assets/models/container.j3voxel" });
    defs.item(item.COAL, ItemDef { name: "COAL", price: 1, cargo: M_COAL_CARGO, fuel: true,
        icon: "assets/models/coal-cargo.j3voxel" });
    defs.item(item.MARKET, ItemDef { name: "MARKET CONSOLE", block: block.MARKET, cost: 1, hotbar: 5, tab: 2,
        icon: "assets/models/market.j3voxel" });
    defs.item(item.PICKAXE, ItemDef { name: "PICKAXE", hotbar: 0, icon: "assets/models/pickaxe.j3voxel" });
    defs.item(item.GRASS, ItemDef { name: "GRASS", price: 1, block: block.GRASS,
        top: defs.pack(96, 163, 88), left: defs.pack(126, 87, 52), right: defs.pack(95, 63, 40) });
    defs.item(item.COPPER_WIRE, ItemDef { name: "COPPER WIRE", ingots: 1, tab: 3,
        top: defs.pack(224, 140, 80), left: defs.pack(170, 94, 52), right: defs.pack(122, 64, 34) });
    defs.item(item.POST, ItemDef { name: "ELECTRIC POST", block: block.POST, ingots: 1, tab: 3,
        icon: "assets/models/power-post.j3voxel" });
    defs.item(item.GENERATOR, ItemDef { name: "COAL GENERATOR", block: block.GENERATOR, ingots: 3, tab: 3,
        icon: "assets/models/generator.j3voxel" });
    defs.item(item.ELECTRIC_DRILL, ItemDef { name: "ELECTRIC DRILL", block: block.ELECTRIC_DRILL, ingots: 4, tab: 3,
        icon: "assets/models/electric-drill.j3voxel", iconTip: "assets/models/electric-drill-bit.j3voxel" });
    defs.item(item.ELECTRIC_SMELTER, ItemDef { name: "ELECTRIC SMELTER", block: block.ELECTRIC_SMELTER, ingots: 4, tab: 3,
        icon: "assets/models/electric-smelter.j3voxel" });
    defs.item(item.IRON, ItemDef { name: "RAW IRON", price: 2, cargo: M_IRON_CARGO, smelts: item.IRON_INGOT,
        icon: "assets/models/iron-cargo.j3voxel" });
    defs.item(item.IRON_INGOT, ItemDef { name: "IRON INGOT", price: 6, cargo: M_IRON_INGOT,
        icon: "assets/models/iron-ingot.j3voxel" });
    defs.item(item.CONVEYOR_MK2, ItemDef { name: "CONVEYOR MK2", block: block.CONVEYOR_MK2, iron: 1, tab: 0,
        icon: "assets/models/conveyor-mk2.j3voxel" });
    defs.item(item.SPLITTER, ItemDef { name: "SPLITTER", block: block.SPLITTER, cost: 3, tab: 0,
        icon: "assets/models/splitter.j3voxel" });
    defs.item(item.SPLITTER_MK2, ItemDef { name: "SPLITTER MK2", block: block.SPLITTER_MK2, iron: 3, tab: 0,
        icon: "assets/models/splitter-mk2.j3voxel" });
    defs.item(item.LIFTER, ItemDef { name: "LIFTER", block: block.LIFTER, cost: 3, tab: 0,
        icon: "assets/models/lifter.j3voxel" });
    defs.item(item.LIFTER_MK2, ItemDef { name: "LIFTER MK2", block: block.LIFTER_MK2, iron: 3, tab: 0,
        icon: "assets/models/lifter-mk2.j3voxel" });
}

fn ores() {
    defs.ore(OreDef { node: block.COPPER_NODE, vein: block.COPPER_ORE, item: item.COPPER, nodeModel: M_COPPER_NODE, offset: 24 });
    defs.ore(OreDef { node: block.COAL_NODE, vein: block.COAL_ORE, item: item.COAL, nodeModel: M_COAL_NODE, offset: 30 });
    defs.ore(OreDef { node: block.IRON_NODE, vein: block.IRON_ORE, item: item.IRON, nodeModel: M_IRON_NODE, offset: 36, minRing: 2 });
}

pub fn load() {
    if defs.loaded() { return; }
    models();
    blocks();
    items();
    ores();
    defs.markLoaded();
}
