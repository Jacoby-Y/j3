// Item ids. What each one is lives in `industry.data.content`; this module reads the table.
module industry.data.item;

use industry.data.block;
use industry.data.defs;

pub const STONE: u8 = 1;
pub const DIRT: u8 = 2;
pub const FOUNDATION: u8 = 3;
pub const CONVEYOR: u8 = 4;
pub const DRILL: u8 = 5;
pub const COPPER: u8 = 6;
pub const FURNACE: u8 = 7;
pub const COPPER_INGOT: u8 = 8;
pub const CONTAINER: u8 = 9;
pub const COAL: u8 = 10;
pub const MARKET: u8 = 11;
// Tools share the inventory with resources and structures.
pub const PICKAXE: u8 = 12;
pub const GRASS: u8 = 13;
pub const COPPER_WIRE: u8 = 14;
pub const POST: u8 = 15;
pub const GENERATOR: u8 = 16;
pub const ELECTRIC_DRILL: u8 = 17;
pub const ELECTRIC_SMELTER: u8 = 18;
pub const IRON: u8 = 19;
pub const IRON_INGOT: u8 = 20;
pub const CONVEYOR_MK2: u8 = 21;
pub const SPLITTER: u8 = 22;
pub const SPLITTER_MK2: u8 = 23;
pub const LIFTER: u8 = 24;
pub const LIFTER_MK2: u8 = 25;
pub const CONTAINER_MK2: u8 = 26;

// Number of ids, including zero.
pub fn kinds(): int { return defs.itemCount(); }

pub const HOTBAR: int = 6;

// Item id held in a hotbar slot; zero is an empty slot.
pub fn hotbarItem(slot: int): u8 { return defs.hotbarItem(slot); }

// The item an ore block yields; zero for anything that is not ore.
pub fn fromOre(id: u8): u8 {
    let node = defs.oreOfNode(id);
    if node >= 0 { let def = defs.oreInfo(node); return def.item; }
    let vein = defs.oreOfVein(id);
    if vein >= 0 { let found = defs.oreInfo(vein); return found.item; }
    return 0;
}

pub fn blockFor(id: u8): u8 { let def = defs.itemInfo(id); return def.block; }
pub fn ingotFor(id: u8): u8 { let def = defs.itemInfo(id); return def.smelts; }
pub fn isFuel(id: u8): bool { let def = defs.itemInfo(id); return def.fuel; }
pub fn name(id: u8): string { let def = defs.itemInfo(id); return def.name; }
pub fn price(id: u8): int { let def = defs.itemInfo(id); return def.price; }

// Recover one item from a removed terrain cell or whole structure.
pub fn fromBlock(id: u8): u8 {
    if id == block.AIR { return 0; }
    id = block.lifter(id);
    for candidate in 1..kinds() {
        if blockFor(u8(candidate)) == id { return u8(candidate); }
    }
    return 0;
}

// Build menu entry `index`, in hotbar order.
pub fn recipe(index: int): u8 { return defs.recipe(index); }
pub fn recipeCount(): int { return defs.recipeCount(); }
pub fn recipeCost(id: u8): int { let def = defs.itemInfo(id); return def.cost; }
pub fn recipeIngots(id: u8): int { let def = defs.itemInfo(id); return def.ingots; }
pub fn recipeIron(id: u8): int { let def = defs.itemInfo(id); return def.iron; }
pub fn recipeStone(id: u8): int { let def = defs.itemInfo(id); return def.stone; }
pub fn recipeWire(id: u8): int { let def = defs.itemInfo(id); return def.wire; }
pub fn craftTime(id: u8): f32 { let def = defs.itemInfo(id); return def.time; }
// The raw item that smelts into `id`; zero when `id` is no ingot.
pub fn rawFor(id: u8): u8 {
    for candidate in 1..kinds() { if ingotFor(u8(candidate)) == id { return u8(candidate); } }
    return 0;
}
pub fn tab(id: u8): int { let def = defs.itemInfo(id); return def.tab; }
pub fn col(id: u8): int { let def = defs.itemInfo(id); return def.col; }
pub fn tier(id: u8): int { let def = defs.itemInfo(id); return def.tier; }
