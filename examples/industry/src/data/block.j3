// Block ids. What each one is lives in `industry.data.content`. Zero is always air.
module industry.data.block;

use j3.math.Vec3;
use industry.data.defs;

pub const AIR: u8 = 0;
pub const STONE: u8 = 1;
pub const DIRT: u8 = 2;
pub const GRASS: u8 = 3;
pub const COPPER_NODE: u8 = 4;
pub const FOUNDATION: u8 = 5;
pub const CONVEYOR: u8 = 6;
pub const DRILL: u8 = 7;
pub const FURNACE: u8 = 8;
pub const CONTAINER: u8 = 9;
pub const COAL_NODE: u8 = 10;
pub const MARKET: u8 = 11;
pub const COPPER_ORE: u8 = 12;
pub const COAL_ORE: u8 = 13;
pub const POST: u8 = 14;
pub const GENERATOR: u8 = 15;
pub const ELECTRIC_DRILL: u8 = 16;
pub const ELECTRIC_SMELTER: u8 = 17;
pub const IRON_NODE: u8 = 18;
pub const IRON_ORE: u8 = 19;
pub const CONVEYOR_MK2: u8 = 20;
pub const SPLITTER: u8 = 21;
pub const SPLITTER_MK2: u8 = 22;
pub const LIFTER: u8 = 23;
pub const LIFTER_MK2: u8 = 24;

pub fn color(id: u8): Vec3 { return defs.blockColor(id); }

// Surface resource node (2 x 2 x 2) and finite underground vein cube.
pub fn isNode(id: u8): bool { return defs.blockIsNode(id); }
// Conveyors, splitters and lifters: everything that carries cargo in a queue.
pub fn isBelt(id: u8): bool { return defs.blockSpeed(id) > 0; }
pub fn isVein(id: u8): bool { return defs.blockIsVein(id); }

// A low-contrast checker plus a stable per-cell tint keeps broad surfaces readable.
pub fn tint(id: u8, x: int, y: int, z: int): Vec3 {
    let c = color(id);
    if id == CONVEYOR { return c; }
    let checker: f32 = 0.99;
    if (x + z) % 2 == 0 { checker = 1.01; }
    let variation = f32((x * 37 + y * 11 + z * 53 + int(id) * 17) % 7 - 3) * 0.004;
    let shade = checker + variation;
    return Vec3.xyz(c.x * shade, c.y * shade, c.z * shade);
}
