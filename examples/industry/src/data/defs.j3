// Definition tables for items, blocks, ores and models. Rows are registered once by
// `industry.data.content`; every other module asks through the accessors here, which
// panic on an unknown id instead of guessing.
module industry.data.defs;

use j3.math.Vec3;
use j3.sys;

pub const MAX_ITEMS: int = 32;
pub const MAX_BLOCKS: int = 32;
pub const MAX_ORES: int = 8;
pub const MAX_MODELS: int = 40;
pub const MAX_EFFECTS: int = 16;
pub const MAX_EMITTERS: int = 32;
const MAX_RECIPES: int = 24;
const HOTBAR_SLOTS: int = 9;

// Instance buffer sizing of a model: one per machine, one per belt queue place, one per chunk.
pub const BATCH_NONE: int = 0;
pub const BATCH_MACHINE: int = 1;
pub const BATCH_CARGO: int = 2;
pub const BATCH_NODE: int = 3;

// A second mesh drawn with a machine: spins while it runs, or shows only while it runs.
pub const OVERLAY_NONE: int = 0;
pub const OVERLAY_SPIN: int = 1;
pub const OVERLAY_LIT: int = 2;

// What a belt-family block does with what reaches its end: pass it on, split it, or lift it.
pub const ROUTE_LINE: int = 0;
pub const ROUTE_SPLIT: int = 1;
pub const ROUTE_LIFT: int = 2;
pub const ROUTE_LOWER: int = 3;

pub struct ItemDef {
    name: string = "";
    price: int = 0;          // coins when sold; 0 = cannot be sold
    block: u8 = 0;           // block placed from this item; 0 = none
    cost: int = 0;           // raw ore (the item that smelts into this one) to craft one
    ingots: int = 0;         // copper ingots to craft one (with `cost`, both are paid)
    iron: int = 0;           // iron ingots to craft one
    stone: int = 0;          // stone to craft one
    wire: int = 0;           // copper wire to craft one
    time: f32 = 2;           // seconds to craft one
    hotbar: int = -1;        // default hotbar slot, -1 = none
    tab: int = 0;            // build menu tab
    col: int = 0;            // build menu column
    tier: int = 0;           // build menu row
    cargo: int = -1;         // model drawn on a belt; -1 = never on belts
    smelts: u8 = 0;          // item produced in a furnace; 0 = does not smelt
    fuel: bool = false;      // burns in a furnace
    icon: string = "";       // model file for the inventory icon; empty draws a cube
    iconTip: string = "";    // second model file joined into the icon
    top: int = 0;            // cube icon colors, packed 0xRRGGBB (`defs.pack`)
    left: int = 0;
    right: int = 0;
}

pub struct BlockDef {
    r: f32 = 1;              // terrain color; magenta marks a missing one
    g: f32 = 0;
    b: f32 = 1;
    machine: bool = false;   // multi-cell structure with state, placed through placeMachine
    storage: bool = false;   // owns an inventory
    height: int = 1;         // footprint height in voxels
    model: int = -1;         // main mesh; -1 for terrain
    overlay: int = -1;       // second mesh; -1 for none
    overlayMode: int = 0;
    twin: u8 = 0;            // the other tier of this structure; clicking one with the other swaps them in place
    stacks: int = 0;         // storage: capacity in stacks of `inventory.STACK`; 0 = a full bag
    speed: f32 = 0;          // belt family: cargo speed in cells per second; 0 = not a belt
    route: int = 0;          // belt family: ROUTE_*
    node: bool = false;      // set by `ore`: surface resource node
    vein: bool = false;      // set by `ore`: finite underground vein
    terrain: bool = false;   // set at load: ordinary terrain, meshed with the world
}

pub struct OreDef {
    node: u8 = 0;            // surface block
    vein: u8 = 0;            // finite underground block
    item: u8 = 0;            // what mining it yields
    nodeModel: int = -1;
    offset: int = 0;         // x offset of the surface node inside its chunk
    chance: int = 100;       // percent of chunks (beyond the start) that get a surface node
    minRing: int = 0;        // chunk rings closer to the start than this have none
}

pub struct ModelDef { path: string = ""; glow: bool = false; batch: int = 0; }

// A particle effect: how many cubes, how big, how they move, how they look. Sizes are classes
// 0..4 = 1/16, 1/8, 1/4, 1/2, 1 voxel. Colors are packed 0xRRGGBB (`defs.pack`); each cube
// takes a random blend of the two, or of the source color when `fromSource` is set.
pub struct EffectDef {
    name: string = "";       // what the `fx` console command calls it
    count: int = 8;          // cubes per burst
    rate: f32 = 0;           // cubes per second when sprayed
    size: int = 1;           // base size class
    sizeSpread: int = 0;     // a cube may roll up to this many classes bigger
    speed: f32 = 4;          // initial speed, cells per second
    spread: f32 = 0.5;       // 0 = straight along the direction, 1 = about 45 degrees, 3+ = all around
    gravity: f32 = 0;        // cells per second squared, downward; negative rises
    drag: f32 = 0;           // fraction of speed lost per second
    scatter: f32 = 0.1;      // each cube starts up to this many cells off the spawn point, per axis
    life: f32 = 1;           // seconds
    lifeSpread: f32 = 0.3;   // fraction of life a cube may lose
    colorA: int = 16777215;
    colorB: int = 16777215;
    fromSource: bool = false;
    glow: f32 = 0;           // emission 0..1
    collide: bool = false;   // stops at solid cells
    bounce: bool = false;    // with collide: rebounds instead of resting
    shrink: bool = false;    // steps down a size class as it ages
    alpha: f32 = 1;          // opacity at birth, 0..1; below 1 draws blended
    fade: bool = false;      // opacity ramps from `alpha` to 0 over the life
}

// A structure's effect: while the machine of `block` runs, `effect` sprays from a point on it.
// The point is in model units (1/8 voxel) from the model origin (bottom centre of the footprint)
// and turns with the machine; `dx dy dz` is the spray direction in the same frame.
pub struct EmitterDef {
    block: u8 = 0;
    effect: int = 0;
    x: int = 0;
    y: int = 0;
    z: int = 0;
    dx: f32 = 0;
    dy: f32 = 1;
    dz: f32 = 0;
}

#[singleton]
let EFFECTS: [16]EffectDef;
#[singleton]
let EFFECT_COUNT: int = 0;
#[singleton]
let EMITTERS: [32]EmitterDef;
#[singleton]
let EMITTER_COUNT: int = 0;
#[singleton]
let EMIT_FIRST: [32]int;
#[singleton]
let EMIT_COUNT: [32]int;
#[singleton]
let ITEMS: [32]ItemDef;
#[singleton]
let BLOCKS: [32]BlockDef;
#[singleton]
let ORES: [8]OreDef;
#[singleton]
let MODELS: [40]ModelDef;
#[singleton]
let HOTBAR: [9]u8;
#[singleton]
let RECIPES: [24]u8;
#[singleton]
let ITEM_COUNT: int = 0;
#[singleton]
let BLOCK_COUNT: int = 0;
#[singleton]
let ORE_COUNT: int = 0;
#[singleton]
let MODEL_COUNT: int = 0;
#[singleton]
let RECIPE_COUNT: int = 0;
#[singleton]
let LOADED: bool = false;

pub fn pack(r: int, g: int, b: int): int { return r * 65536 + g * 256 + b; }

// Packed 0xRRGGBB back to 0..1 components.
pub fn unpack(color: int): Vec3 {
    return Vec3.xyz(f32(color / 65536) / 255, f32(color / 256 % 256) / 255, f32(color % 256) / 255);
}

pub fn loaded(): bool { return LOADED; }

fn craftable(id: int): bool { return ITEMS[id].cost > 0 || ITEMS[id].ingots > 0 || ITEMS[id].iron > 0 || ITEMS[id].stone > 0 || ITEMS[id].wire > 0; }

pub fn markLoaded() {
    for slot in 0..HOTBAR_SLOTS { HOTBAR[slot] = 0; }
    for id in 1..ITEM_COUNT {
        let slot = ITEMS[id].hotbar;
        if slot >= 0 { HOTBAR[slot] = u8(id); }
    }
    RECIPE_COUNT = 0;
    for position in 0..HOTBAR_SLOTS {
        let id = int(HOTBAR[position]);
        if id == 0 || !craftable(id) { continue; }
        if RECIPE_COUNT >= MAX_RECIPES { sys.panic("too many recipes"); }
        RECIPES[RECIPE_COUNT] = u8(id); RECIPE_COUNT += 1;
    }
    for extra in 1..ITEM_COUNT {
        if ITEMS[extra].hotbar >= 0 || !craftable(extra) { continue; }
        if RECIPE_COUNT >= MAX_RECIPES { sys.panic("too many recipes"); }
        RECIPES[RECIPE_COUNT] = u8(extra); RECIPE_COUNT += 1;
    }
    for kind in 1..BLOCK_COUNT {
        BLOCKS[kind].terrain = !BLOCKS[kind].machine && !BLOCKS[kind].node;
    }
    LOADED = true;
}

// Rows register in id order, so ids stay contiguous.
pub fn item(id: u8, def: ItemDef) {
    if int(id) != ITEM_COUNT { sys.panic(`item {id} registered out of order`); }
    if ITEM_COUNT >= MAX_ITEMS { sys.panic("too many items"); }
    ITEMS[int(id)] = def;
    ITEM_COUNT += 1;
}

pub fn block(id: u8, def: BlockDef) {
    if int(id) != BLOCK_COUNT { sys.panic(`block {id} registered out of order`); }
    if BLOCK_COUNT >= MAX_BLOCKS { sys.panic("too many blocks"); }
    BLOCKS[int(id)] = def;
    BLOCK_COUNT += 1;
}

pub fn ore(def: OreDef) {
    if ORE_COUNT >= MAX_ORES { sys.panic("too many ores"); }
    ORES[ORE_COUNT] = def; ORE_COUNT += 1;
    BLOCKS[int(def.node)].node = true;
    BLOCKS[int(def.vein)].vein = true;
}

pub fn effect(id: int, def: EffectDef) {
    if id != EFFECT_COUNT { sys.panic(`effect {id} registered out of order`); }
    if EFFECT_COUNT >= MAX_EFFECTS { sys.panic("too many effects"); }
    EFFECTS[id] = def; EFFECT_COUNT += 1;
}

// Rows of one block sit together, so `emittersOf` is a first index and a count.
pub fn emitter(def: EmitterDef) {
    if EMITTER_COUNT >= MAX_EMITTERS { sys.panic("too many emitters"); }
    if def.effect < 0 || def.effect >= EFFECT_COUNT { sys.panic(`emitter names unknown effect {def.effect}`); }
    let kind = int(def.block);
    if EMIT_COUNT[kind] == 0 { EMIT_FIRST[kind] = EMITTER_COUNT; }
    else if EMIT_FIRST[kind] + EMIT_COUNT[kind] != EMITTER_COUNT { sys.panic(`emitter rows of block {kind} must be together`); }
    EMITTERS[EMITTER_COUNT] = def; EMITTER_COUNT += 1; EMIT_COUNT[kind] += 1;
}

pub fn model(id: int, def: ModelDef) {
    if id != MODEL_COUNT { sys.panic(`model {id} registered out of order`); }
    if MODEL_COUNT >= MAX_MODELS { sys.panic("too many models"); }
    MODELS[id] = def; MODEL_COUNT += 1;
}

fn itemAt(id: u8): ItemDef {
    if int(id) >= ITEM_COUNT { sys.panic(`unknown item {id}`); }
    return ITEMS[int(id)];
}

fn blockAt(id: u8): BlockDef {
    if int(id) >= BLOCK_COUNT { sys.panic(`unknown block {id}`); }
    return BLOCKS[int(id)];
}

pub fn itemCount(): int { return ITEM_COUNT; }
pub fn itemInfo(id: u8): ItemDef { return itemAt(id); }
pub fn blockInfo(id: u8): BlockDef { return blockAt(id); }
pub fn blockCount(): int { return BLOCK_COUNT; }

// Single-field reads for per-voxel loops.
pub fn blockColor(id: u8): Vec3 {
    if int(id) >= BLOCK_COUNT { sys.panic(`unknown block {id}`); }
    let def = BLOCKS[int(id)];
    return Vec3.xyz(def.r, def.g, def.b);
}
pub fn blockIsMachine(id: u8): bool { return BLOCKS[int(id)].machine; }
pub fn pair(a: u8, b: u8) { BLOCKS[int(a)].twin = b; BLOCKS[int(b)].twin = a; }
pub fn blockTwin(id: u8): u8 { return BLOCKS[int(id)].twin; }
pub fn blockStacks(id: u8): int { return BLOCKS[int(id)].stacks; }
pub fn blockIsStorage(id: u8): bool { return BLOCKS[int(id)].storage; }
pub fn blockIsNode(id: u8): bool { return BLOCKS[int(id)].node; }
pub fn blockIsVein(id: u8): bool { return BLOCKS[int(id)].vein; }
pub fn blockIsTerrain(id: u8): bool { return BLOCKS[int(id)].terrain; }
pub fn blockHeight(id: u8): int { return BLOCKS[int(id)].height; }
pub fn blockSpeed(id: u8): f32 { return BLOCKS[int(id)].speed; }
pub fn blockRoute(id: u8): int { return BLOCKS[int(id)].route; }
pub fn oreCount(): int { return ORE_COUNT; }
pub fn oreInfo(index: int): OreDef {
    if index < 0 || index >= ORE_COUNT { sys.panic(`unknown ore {index}`); }
    return ORES[index];
}
pub fn effectCount(): int { return EFFECT_COUNT; }
pub fn effectInfo(id: int): EffectDef {
    if id < 0 || id >= EFFECT_COUNT { sys.panic(`unknown effect {id}`); }
    return EFFECTS[id];
}
pub fn effectName(id: int): string {
    if id < 0 || id >= EFFECT_COUNT { sys.panic(`unknown effect {id}`); }
    return EFFECTS[id].name;
}
pub fn emitterCount(): int { return EMITTER_COUNT; }
pub fn emitterInfo(index: int): EmitterDef { return EMITTERS[index]; }
// Index of the first emitter row of block `id` and how many it has; none is a count of 0.
pub fn emitterFirst(id: u8): int { return EMIT_FIRST[int(id)]; }
pub fn emitterRows(id: u8): int { return EMIT_COUNT[int(id)]; }
pub fn modelCount(): int { return MODEL_COUNT; }
pub fn modelInfo(id: int): ModelDef {
    if id < 0 || id >= MODEL_COUNT { sys.panic(`unknown model {id}`); }
    return MODELS[id];
}

pub fn hotbarItem(slot: int): u8 {
    if slot < 0 || slot >= HOTBAR_SLOTS { return 0; }
    return HOTBAR[slot];
}

pub fn recipeCount(): int { return RECIPE_COUNT; }
pub fn recipe(index: int): u8 {
    if index < 0 || index >= RECIPE_COUNT { return 0; }
    return RECIPES[index];
}

// Index of the ore whose surface node is `id`, or -1.
pub fn oreOfNode(id: u8): int {
    for index in 0..ORE_COUNT { if ORES[index].node == id { return index; } }
    return -1;
}

pub fn oreOfVein(id: u8): int {
    for index in 0..ORE_COUNT { if ORES[index].vein == id { return index; } }
    return -1;
}

pub fn oreOfItem(id: u8): int {
    for index in 0..ORE_COUNT { if ORES[index].item == id { return index; } }
    return -1;
}
