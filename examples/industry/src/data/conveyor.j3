// Cardinal belt directions, clockwise from north (-Z).
module industry.data.conveyor;

pub const NORTH: u8 = 0;
pub const EAST: u8 = 1;
pub const SOUTH: u8 = 2;
pub const WEST: u8 = 3;

pub fn rotate(dir: u8): u8 { return (dir + 1) % 4; }

pub fn dx(dir: u8): f32 {
    if dir == EAST { return 1; }
    if dir == WEST { return -1; }
    return 0;
}

pub fn dz(dir: u8): f32 {
    if dir == SOUTH { return 1; }
    if dir == NORTH { return -1; }
    return 0;
}
