// Structure placement resolves whole footprints and connections, never arbitrary parts.
module industry.placement;
use j3.gfx.voxel.Hit;
use j3.gfx.voxel;
use industry.data.block;
use industry.data.conveyor;
use industry.data.defs;
use industry.machine.drills;
use industry.machine.belts;
use industry.player;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.player.Player;
use industry.world;
use industry.world.World;

pub struct Plan {
    visible: bool = false;
    ok: bool = false;
    x: int = 0;
    y: int = 0;
    z: int = 0;
    dir: u8 = 0;
    id: u8 = 0;
    message: string = "AIM AT GROUND OR A STRUCTURE";
}

pub fn floorHeight(w: &World, x: int, z: int): int {
    let height = 0;
    for sideZ in 0..2 { for sideX in 0..2 {
        let y = world.SY - 1;
        while y >= 0 {
            let id = world.get(w, x + sideX, y, z + sideZ);
            if id != block.AIR && !world.machine(id) && !block.isNode(id) {
                if y + 1 > height { height = y + 1; }
                break;
            }
            y -= 1;
        }
    } }
    return height;
}

pub fn resolve(w: &World, p: &Player, hit: Hit, rotation: u8): Plan {
    return resolveWithShift(w, p, hit, rotation, false);
}

// Follow the same directed connections as cargo, up a lifter and down a lowerer; a splitter ends
// the chain. A bounded walk rejects closed loops.
fn lineEnd(w: &World, start: int): int {
    let at = start;
    for step in 0..w.machineCount {
        let route = defs.blockRoute(w.cells[at]);
        if route == defs.ROUTE_SPLIT { return at; }
        let next = belts.neighbor(w, at, w.facing[at]);
        if route == defs.ROUTE_LIFT || route == defs.ROUTE_LOWER {
            let rise = 1; if route == defs.ROUTE_LOWER { rise = -1; }
            next = world.anchorAt(w, world.anchorX(at), world.anchorY(at) + rise, world.anchorZ(at));
            if next >= 0 && !block.isBelt(w.cells[next]) { next = -1; }
        }
        if next < 0 { return at; }
        at = next;
    }
    return -1;
}

// Where a new belt piece goes at the end of a chain: ahead of a belt, above a lifter, below a lowerer.
fn extend(w: &World, p: &Player, plan: &Plan, end: int) {
    let route = defs.blockRoute(w.cells[end]);
    let want = defs.blockRoute(plan.id);
    plan.x = world.anchorX(end); plan.y = world.anchorY(end); plan.z = world.anchorZ(end);
    if route == defs.ROUTE_SPLIT { plan.message = "A SPLITTER ENDS THE CHAIN"; return; }
    if route == defs.ROUTE_LIFT || route == defs.ROUTE_LOWER {
        if route == defs.ROUTE_LIFT && want == defs.ROUTE_LOWER { plan.message = "A LOWERER CANNOT GO ON A LIFTER"; return; }
        if route == defs.ROUTE_LOWER && want == defs.ROUTE_LIFT { plan.message = "A LIFTER CANNOT GO UNDER A LOWERER"; return; }
        if route == defs.ROUTE_LIFT { plan.y += 1; } else { plan.y -= 1; }
        validate(w, p, plan);
        return;
    }
    let dir = world.direction(w, plan.x, plan.y, plan.z);
    if want == defs.ROUTE_LINE && plan.dir == (dir + 2) % 4 { plan.message = "WOULD FACE THE BELT BEHIND IT"; return; }
    plan.x += int(conveyor.dx(dir)) * world.FOOTPRINT;
    plan.z += int(conveyor.dz(dir)) * world.FOOTPRINT;
    validate(w, p, plan);
}

pub fn resolveWithShift(w: &World, p: &Player, hit: Hit, rotation: u8, shift: bool): Plan {
    return resolveBlock(w, p, hit, rotation, shift, player.heldBlock(p));
}

pub fn resolveInventory(w: &World, p: &Player, bag: &Bag, hit: Hit, rotation: u8, shift: bool): Plan {
    return resolveBlock(w, p, hit, rotation, shift, item.blockFor(inventory.slotItem(bag, p.slot)));
}

fn resolveBlock(w: &World, p: &Player, hit: Hit, rotation: u8, shift: bool, id: u8): Plan {
    if rotation >= 4 { id = block.lowerer(id); }
    let plan = Plan { id: id };
    if hit.ok && id != block.AIR && !world.machine(id) {
        plan.visible = true; plan.x = hit.px; plan.y = hit.py; plan.z = hit.pz;
        if world.editable(w, plan.x, plan.y, plan.z) && world.get(w, plan.x, plan.y, plan.z) == block.AIR && player.canPlace(p, plan.x, plan.y, plan.z) { plan.ok = true; }
        return plan;
    }
    if !hit.ok || !world.machine(plan.id) { return plan; }
    plan.visible = true;
    plan.x = hit.x;
    plan.z = hit.z;
    plan.dir = rotation % 4;
    let target = world.get(w, hit.x, hit.y, hit.z);
    if block.isNode(target) {
        // Resource nodes retain their two-cell footprint and mining ports.
        plan.x = hit.x / world.FOOTPRINT * world.FOOTPRINT;
        plan.z = hit.z / world.FOOTPRINT * world.FOOTPRINT;
        plan.x -= int(conveyor.dx(plan.dir)) * world.FOOTPRINT;
        plan.z -= int(conveyor.dz(plan.dir)) * world.FOOTPRINT;
        if !drills.isDrill(plan.id) { plan.visible = false; plan.message = "SELECT A DRILL TO MINE ORE"; return plan; }
    }
    plan.y = floorHeight(w, plan.x, plan.z);
    if drills.isDrill(plan.id) && !block.isNode(target) { faceNode(w, &plan); }
    if block.isBelt(target) && block.isBelt(plan.id) && shift {
        let below = world.anchorAt(w, hit.x, hit.y, hit.z);
        plan.x = world.anchorX(below); plan.z = world.anchorZ(below); plan.y = world.anchorY(below) + 1;
        validate(w, p, &plan);
        return plan;
    }
    if world.machine(target) {
        let targetAnchor = world.anchorAt(w, hit.x, hit.y, hit.z);
        if block.isBelt(target) && block.isBelt(plan.id) {
            targetAnchor = lineEnd(w, targetAnchor);
            if targetAnchor < 0 { plan.message = "CONVEYOR LOOP HAS NO END"; return plan; }
            extend(w, p, &plan, targetAnchor);
            return plan;
        }
        plan.x = world.anchorX(targetAnchor);
        plan.z = world.anchorZ(targetAnchor);
        plan.y = world.anchorY(targetAnchor);
        let dir = world.direction(w, plan.x, plan.y, plan.z);
        if drills.isDrill(target) {
            let anchor = voxel.index(plan.x, plan.y, plan.z, world.SX, world.SZ);
            if block.isBelt(plan.id) && drills.rear(w, anchor) >= 0 {
                plan.visible = false;
                plan.message = "AIM AT THE BELT TO EXTEND THE LINE";
                return plan;
            }
            dir = (dir + 2) % 4;
        }
        plan.x += int(conveyor.dx(dir)) * world.FOOTPRINT;
        plan.z += int(conveyor.dz(dir)) * world.FOOTPRINT;
    }
    validate(w, p, &plan);
    return plan;
}

// A drill set down beside a node turns to face it; the rotation you chose stays if it already does.
fn faceNode(w: &World, plan: &Plan) {
    for turn in 0..4 {
        let d = u8((int(plan.dir) + turn) % 4);
        if drills.ore(w, plan.x, plan.y, plan.z, d) != 0 { plan.dir = d; return; }
    }
}

pub fn validate(w: &World, p: &Player, plan: &Plan) {
    if plan.y + world.height(plan.id) > world.SY { plan.message = "NOT ENOUGH HEADROOM"; return; }
    for dy in 0..world.height(plan.id) { for dz in 0..world.FOOTPRINT { for dx in 0..world.FOOTPRINT {
        let x = plan.x + dx; let z = plan.z + dz;
        if !world.editable(w, x, plan.y + dy, z) { plan.message = "UNLOCK THIS CHUNK FIRST"; return; }
        if world.get(w, x, plan.y + dy, z) != block.AIR { plan.message = "SPACE OCCUPIED"; return; }
        if !player.canPlace(p, x, plan.y + dy, z) { plan.message = "STEP BACK TO MAKE ROOM"; return; }
    } } }
    if plan.y <= 0 { plan.message = "NEEDS GROUND SUPPORT"; return; }
    if world.machine(plan.id) && !world.canPlaceMachine(w, plan.x, plan.y, plan.z, plan.id) {
        plan.message = "MACHINE LIMIT REACHED";
        if world.storage(plan.id) && w.storeCount >= world.MAX_STORES { plan.message = "STORAGE LIMIT REACHED"; }
        return;
    }
    plan.ok = true;
    plan.message = "RIGHT CLICK TO PLACE  R TO ROTATE";
    if drills.isDrill(plan.id) { plan.message = "PLACE DRILL  THEN AIM AT IT WITH BELT"; }
    if plan.id == block.POST { plan.message = "PLACE POST  THEN CONNECT WIRE"; }
}

pub fn place(w: &World, plan: Plan): bool {
    if !plan.ok { return false; }
    if world.machine(plan.id) { return world.placeMachine(w, plan.x, plan.y, plan.z, plan.dir, plan.id); }
    if !world.editable(w, plan.x, plan.y, plan.z) || world.get(w, plan.x, plan.y, plan.z) != block.AIR { return false; }
    world.set(w, plan.x, plan.y, plan.z, plan.id);
    return world.get(w, plan.x, plan.y, plan.z) == plan.id;
}

pub fn placeInventory(w: &World, bag: &Bag, slot: int, plan: Plan): bool {
    let id = inventory.slotItem(bag, slot);
    if id == 0 || item.blockFor(id) != block.lifter(plan.id) || !place(w, plan) { return false; }
    bag.counts[int(id)] -= 1;
    inventory.sync(bag);
    return true;
}
