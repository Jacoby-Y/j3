// Pixel isometric sprites rasterized from the same subvoxel geometry as the machines.
module industry.model_icons;
use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode };
use j3.game;
use j3.game.Texture;
use j3.memory.Arena;
use industry.data.defs;
use industry.data.item;
use industry.subvoxels;

// Projection and visibility share the camera direction (1, 1, -1).
fn depth(verts: []f32, face: int): f32 {
    let value: f32 = 0;
    for i in 0..6 {
        let at = face * 60 + i * 10;
        value += verts[at] - verts[at + 2] + verts[at + 1];
    }
    return value;
}

pub fn paint(c: &Canvas, x: int, verts: []f32, mem: &Arena) {
    let minX: f32 = 1000; let maxX: f32 = -1000;
    let minY: f32 = 1000; let maxY: f32 = -1000;
    let vertex = 0;
    while vertex < verts.len {
        let px = verts[vertex] + verts[vertex + 2];
        let py = (verts[vertex] - verts[vertex + 2]) * 0.5 - verts[vertex + 1];
        if px < minX { minX = px; } if px > maxX { maxX = px; }
        if py < minY { minY = py; } if py > maxY { maxY = py; }
        vertex += 10;
    }
    let scale = 36 / (maxX - minX);
    let heightScale = 36 / (maxY - minY);
    if heightScale < scale { scale = heightScale; }
    let centerX = f32(x + 24) - (minX + maxX) * 0.5 * scale;
    let centerY = 24 - (minY + maxY) * 0.5 * scale;
    let order = mem.alloc::<int>(verts.len / 60);
    let count = 0;
    for face in 0..order.len {
        let at = face * 60;
        if verts[at + 3] - verts[at + 5] + verts[at + 4] <= 0 { continue; }
        let insert = count;
        let d = depth(verts, face);
        while insert > 0 && depth(verts, order[insert - 1]) > d {
            order[insert] = order[insert - 1];
            insert -= 1;
        }
        order[insert] = face;
        count += 1;
    }
    for index in 0..count {
        let offset = order[index] * 60;
        let shade: f32 = 0.86;
        if verts[offset + 4] > 0 { shade = 1; }
        if verts[offset + 3] > 0 { shade = 0.68; }
        let tint = canvas.rgb(u8(verts[offset + 6] * shade * 255),
            u8(verts[offset + 7] * shade * 255), u8(verts[offset + 8] * shade * 255));
        for tri in 0..2 {
            let a = offset + tri * 30; let b = a + 10; let end = a + 20;
            c.fillTriangle(
                centerX + (verts[a] + verts[a + 2]) * scale,
                centerY + (verts[a] - verts[a + 2]) * 0.5 * scale - verts[a + 1] * scale,
                centerX + (verts[b] + verts[b + 2]) * scale,
                centerY + (verts[b] - verts[b + 2]) * 0.5 * scale - verts[b + 1] * scale,
                centerX + (verts[end] + verts[end + 2]) * scale,
                centerY + (verts[end] - verts[end + 2]) * 0.5 * scale - verts[end + 1] * scale, tint);
        }
    }
}

// The model files named by the item's definition; items without one have a cube icon.
pub fn sprite(c: &Canvas, x: int, id: u8, mem: &Arena) {
    let def = defs.itemInfo(id);
    if def.icon.len == 0 { return; }
    let g = subvoxels.load(def.icon, mem);
    let verts = subvoxels.vertices(&g);
    if def.iconTip.len == 0 { paint(c, x, verts, mem); return; }
    let tipGrid = subvoxels.load(def.iconTip, mem);
    let tip = subvoxels.vertices(&tipGrid);
    let joined = mem.alloc::<f32>(verts.len + tip.len);
    for i in 0..verts.len { joined[i] = verts[i]; }
    for j in 0..tip.len { joined[verts.len + j] = tip[j]; }
    paint(c, x, joined, mem);
}

pub fn create(id: u8): Texture {
    let mem = Arena.create(1024);
    let c = Canvas.create(&mem, 48, 48, Mode.Pixel);
    c.clear(canvas.rgba(0, 0, 0, 0));
    sprite(&c, 0, id, &mem);
    let tex = game.textureFromCanvas(c);
    mem.destroy();
    return tex;
}
