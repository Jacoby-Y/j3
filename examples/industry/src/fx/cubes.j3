// Draws every live particle as one instanced cube draw. Camera pass only.
module industry.fx.cubes;

use j3.gfx;
use j3.gfx.{ Instance, Mesh };
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use industry.fx.pool;
use industry.fx.pool.Particles;
use industry.visibility;
use industry.world;

// Past these distances (cells) the smallest classes are too small to see and are skipped.
const FAR_TINY: f32 = 24;
const FAR_SMALL: f32 = 48;

// A white unit cube; each instance tints it.
pub fn makeCube(): Mesh {
    let mem = Arena.create(4096);
    let verts = mem.alloc::<f32>(360);
    let at = 0;
    for face in 0..6 { at = gfx.emitFace(verts, at, 0, 0, 0, face, 1, 1, 1, 0); }
    let cube = gfx.upload(verts[0..at]);
    mem.destroy();
    return cube;
}

// Draw buckets: 0..3 are translucent (alpha (b + 0.5) / 4), 4 is opaque and goes first.
const BUCKETS: int = 5;
const OPAQUE: int = 4;
const SKIP: u8 = 255;

// Which bucket opacity `a` draws in; SKIP when too faint to see.
pub fn bucketOf(a: f32): int {
    if a >= 0.98 { return OPAQUE; }
    if a < 0.03 { return int(SKIP); }
    return int(a * 4);
}

// `eye` is in cells. Cubes are counted into buckets by opacity, laid out bucket by bucket in the one
// instance buffer, and each bucket is a single draw. // ponytail: cubes of a bucket are not depth
// sorted; add a per-instance alpha in gfx to drop the buckets.
pub fn draw(p: &Particles, eye: Vec3) {
    if p.count == 0 || !gfx.inCameraPass() { return; }
    let frustum = visibility.current(Mat4.identity());
    let counts: [5]int = [0, 0, 0, 0, 0];
    for i in 0..p.count {
        p.level[i] = SKIP;
        let size = pool.sizeNow(p, i);
        let dx = p.px[i] - eye.x; let dy = p.py[i] - eye.y; let dz = p.pz[i] - eye.z;
        let far = dx * dx + dy * dy + dz * dz;
        if (size == 0 && far > FAR_TINY * FAR_TINY) || (size == 1 && far > FAR_SMALL * FAR_SMALL) { continue; }
        let half = pool.edge(size) * 0.5 * world.VOXEL;
        let cx = p.px[i] * world.VOXEL; let cy = p.py[i] * world.VOXEL; let cz = p.pz[i] * world.VOXEL;
        if !visibility.visible(&frustum, Vec3.xyz(cx - half, cy - half, cz - half), Vec3.xyz(cx + half, cy + half, cz + half)) { continue; }
        let bucket = bucketOf(pool.alphaNow(p, i));
        if bucket == int(SKIP) { continue; }
        p.level[i] = u8(bucket);
        counts[bucket] += 1;
    }
    let starts: [5]int = [0, 0, 0, 0, 0];
    let next: [5]int = [0, 0, 0, 0, 0];
    // Opaque first, then the translucent buckets from faint to solid.
    let at = counts[OPAQUE]; starts[OPAQUE] = 0; next[OPAQUE] = 0;
    for b in 0..OPAQUE { starts[b] = at; next[b] = at; at += counts[b]; }
    for i in 0..p.count {
        if p.level[i] == SKIP { continue; }
        let edge = pool.edge(pool.sizeNow(p, i));
        let lift = edge * 0.5 * world.VOXEL;
        let m = Mat4.identity();
        let s = edge * world.VOXEL;
        m.m[0] = s; m.m[5] = s; m.m[10] = s;
        m.m[12] = p.px[i] * world.VOXEL - lift; m.m[13] = p.py[i] * world.VOXEL - lift; m.m[14] = p.pz[i] * world.VOXEL - lift;
        let color = Vec3.xyz(p.r[i], p.g[i], p.b[i]);
        let slot = int(p.level[i]);
        p.instances[next[slot]] = Instance { model: m, tint: color, emission: color * p.glow[int(p.effect[i])] };
        next[slot] += 1;
    }
    if counts[OPAQUE] > 0 { gfx.drawInstances(p.cube, p.instances[0..counts[OPAQUE]]); }
    for b in 0..OPAQUE {
        if counts[b] == 0 { continue; }
        gfx.drawInstancesAlpha(p.cube, p.instances[starts[b]..starts[b] + counts[b]], (f32(b) + 0.5) / 4);
    }
}
