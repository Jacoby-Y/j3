// The calls the game makes to start particles: a burst, a spray, or the debris of a broken block.
// An effect is a row in `data/content.j3`; nothing here knows which effects exist.
module industry.fx.effects;

use j3.gfx.voxel.Hit;
use j3.math.Vec3;
use industry.data.block;
use industry.data.content;
use industry.data.defs;
use industry.data.defs.EffectDef;
use industry.fx.pool;
use industry.fx.pool.Particles;
use industry.world;
use industry.world.World;

// One cube of `def` near `at` (cells), thrown around `dir`; `source` is the color of what made it.
fn emit(p: &Particles, effect: int, def: EffectDef, at: Vec3, dir: Vec3, source: Vec3) {
    let rng = p.rng;
    let jitter = Vec3.xyz(rng.floatRange(-1, 1), rng.floatRange(-1, 1), rng.floatRange(-1, 1));
    let heading = (dir.normalize() + jitter * def.spread).normalize();
    let speed = def.speed * rng.floatRange(0.6, 1);
    let size = def.size + rng.intRange(0, def.sizeSpread + 1);
    if size >= pool.SIZES { size = pool.SIZES - 1; }
    let life = def.life * (1 - def.lifeSpread * rng.unit());
    let color = source * rng.floatRange(0.75, 1.1);
    if !def.fromSource {
        let a = defs.unpack(def.colorA); let b = defs.unpack(def.colorB);
        let t = rng.unit();
        color = a + (b - a) * t;
    }
    let x = at.x + rng.floatRange(-def.scatter, def.scatter);
    let y = at.y + rng.floatRange(-def.scatter, def.scatter);
    let z = at.z + rng.floatRange(-def.scatter, def.scatter);
    p.rng = rng;
    pool.spawn(p, effect, x, y, z, heading.x * speed, heading.y * speed, heading.z * speed, life, size, color.x, color.y, color.z);
}

// `count` cubes at once.
pub fn burst(p: &Particles, effect: int, at: Vec3, dir: Vec3, source: Vec3) {
    let def = defs.effectInfo(effect);
    for n in 0..def.count { emit(p, effect, def, at, dir, source); }
}

// `rate` cubes per second over `dt`; the fraction left over is rolled, so slow rates still flow.
pub fn spray(p: &Particles, effect: int, at: Vec3, dir: Vec3, source: Vec3, dt: f32) {
    let def = defs.effectInfo(effect);
    let want = def.rate * dt;
    let whole = int(want);
    let rng = p.rng;
    if rng.unit() < want - f32(whole) { whole += 1; }
    p.rng = rng;
    for n in 0..whole { emit(p, effect, def, at, dir, source); }
}

// A block about to break at cell (x, y, z): chips in its own color, thrown up and out.
// Call before `world.breakAt`, while the cell still holds `kind`. // ponytail: machines use the table color, not the model palette
pub fn debris(p: &Particles, x: int, y: int, z: int, kind: u8) {
    let color = defs.blockColor(kind);
    if !world.machine(kind) { color = block.tint(kind, x, y, z); }
    burst(p, content.FX_DEBRIS, Vec3.xyz(f32(x) + 0.5, f32(y) + 0.5, f32(z) + 0.5), Vec3.up(), color);
}

// Chips off the face of the block being mined, a little each frame.
pub fn dust(p: &Particles, hit: Hit, kind: u8, dt: f32) {
    if !hit.ok { return; }
    let color = defs.blockColor(kind);
    if !world.machine(kind) { color = block.tint(kind, hit.x, hit.y, hit.z); }
    // Halfway between the hit cell and the one in front of it is the shared face.
    let at = Vec3.xyz(f32(hit.x + hit.px + 1) * 0.5, f32(hit.y + hit.py + 1) * 0.5, f32(hit.z + hit.pz + 1) * 0.5);
    let out = Vec3.xyz(f32(hit.px - hit.x), f32(hit.py - hit.y), f32(hit.pz - hit.z));
    spray(p, content.FX_DUST, at, out, color, dt);
}

// The console's `fx`: one burst on the face the player last aimed at.
pub fn test(p: &Particles, effect: int, hit: Hit) {
    if !hit.ok { return; }
    let at = Vec3.xyz(f32(hit.px) + 0.5, f32(hit.py) + 0.5, f32(hit.pz) + 0.5);
    burst(p, effect, at, Vec3.xyz(f32(hit.px - hit.x), f32(hit.py - hit.y), f32(hit.pz - hit.z)), Vec3.xyz(0.6, 0.6, 0.6));
}
