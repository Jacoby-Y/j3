// Voxel particles: a fixed pool of cubes in flat columns. Motion and collision only; what a
// particle looks like and when it spawns is `fx.effects`, `fx.emitters` and `fx.draw`.
// Sizes are classes 0..4 = 1/16, 1/8, 1/4, 1/2, 1 voxel. Positions are free (cells, not snapped).
module industry.fx.pool;

use j3.gfx.Instance;
use j3.gfx.Mesh;
use j3.memory.Arena;
use j3.rand.Rng;
use industry.data.content;
use industry.data.defs;
use industry.world;
use industry.world.World;

pub const MAX_PARTICLES: int = 16384;
pub const SIZES: int = 5;

// Rebound speed kept when a bouncing cube hits the floor or a wall.
const FLOOR_REST: f32 = 0.45;
const WALL_REST: f32 = 0.4;

pub struct Particles {
    count: int;
    px: []f32;
    py: []f32;
    pz: []f32;
    vx: []f32;
    vy: []f32;
    vz: []f32;
    life: []f32;
    age: []f32;
    r: []f32;
    g: []f32;
    b: []f32;
    size: []u8;          // class at birth
    effect: []u8;
    // Per effect, copied from the defs once so the loops never touch a table row.
    gravity: []f32;
    drag: []f32;
    glow: []f32;
    collide: []u8;
    bounce: []u8;
    shrink: []u8;
    alpha: []f32;
    fade: []u8;
    level: []u8;         // draw bucket of each live cube, filled by `fx.cubes`
    rng: Rng;
    instances: []Instance;
    cube: Mesh;          // unit cube, set by `fx.draw.makeCube` once GL is up
}

pub fn create(mem: &Arena): Particles {
    content.load();
    let p = Particles {
        count: 0,
        px: mem.alloc::<f32>(MAX_PARTICLES), py: mem.alloc::<f32>(MAX_PARTICLES), pz: mem.alloc::<f32>(MAX_PARTICLES),
        vx: mem.alloc::<f32>(MAX_PARTICLES), vy: mem.alloc::<f32>(MAX_PARTICLES), vz: mem.alloc::<f32>(MAX_PARTICLES),
        life: mem.alloc::<f32>(MAX_PARTICLES), age: mem.alloc::<f32>(MAX_PARTICLES),
        r: mem.alloc::<f32>(MAX_PARTICLES), g: mem.alloc::<f32>(MAX_PARTICLES), b: mem.alloc::<f32>(MAX_PARTICLES),
        size: mem.alloc::<u8>(MAX_PARTICLES), effect: mem.alloc::<u8>(MAX_PARTICLES),
        gravity: mem.alloc::<f32>(defs.MAX_EFFECTS), drag: mem.alloc::<f32>(defs.MAX_EFFECTS),
        glow: mem.alloc::<f32>(defs.MAX_EFFECTS), collide: mem.alloc::<u8>(defs.MAX_EFFECTS),
        bounce: mem.alloc::<u8>(defs.MAX_EFFECTS), shrink: mem.alloc::<u8>(defs.MAX_EFFECTS),
        alpha: mem.alloc::<f32>(defs.MAX_EFFECTS), fade: mem.alloc::<u8>(defs.MAX_EFFECTS),
        level: mem.alloc::<u8>(MAX_PARTICLES),
        rng: Rng.new(7),
        instances: mem.alloc::<Instance>(MAX_PARTICLES),
        cube: Mesh {},
    };
    for e in 0..defs.effectCount() {
        let def = defs.effectInfo(e);
        p.gravity[e] = def.gravity; p.drag[e] = def.drag; p.glow[e] = def.glow;
        p.collide[e] = 0; if def.collide { p.collide[e] = 1; }
        p.bounce[e] = 0; if def.bounce { p.bounce[e] = 1; }
        p.shrink[e] = 0; if def.shrink { p.shrink[e] = 1; }
        p.alpha[e] = def.alpha;
        p.fade[e] = 0; if def.fade { p.fade[e] = 1; }
    }
    return p;
}

// Edge length of a size class, in cells.
pub fn edge(size: int): f32 {
    let e: f32 = 0.0625;
    for step in 0..size { e *= 2; }
    return e;
}

// The class particle `i` is drawn at: shrinking ones step down as they age, to 0 and then die.
pub fn sizeNow(p: &Particles, i: int): int {
    let base = int(p.size[i]);
    if p.shrink[int(p.effect[i])] == 0 { return base; }
    let now = base - int(p.age[i] / p.life[i] * f32(base + 1));
    if now < 0 { return 0; }
    return now;
}

// Opacity of particle `i`: its effect's `alpha`, ramping to 0 over the life when the effect fades.
pub fn alphaNow(p: &Particles, i: int): f32 {
    let e = int(p.effect[i]);
    if p.fade[e] == 0 { return p.alpha[e]; }
    return p.alpha[e] * (1 - p.age[i] / p.life[i]);
}

// False when the pool is full; the cube is dropped. // ponytail: recycle the oldest if drops show
pub fn spawn(p: &Particles, effect: int, x: f32, y: f32, z: f32, vx: f32, vy: f32, vz: f32,
    life: f32, size: int, r: f32, g: f32, b: f32): bool {
    if p.count >= MAX_PARTICLES { return false; }
    let i = p.count; p.count += 1;
    p.px[i] = x; p.py[i] = y; p.pz[i] = z;
    p.vx[i] = vx; p.vy[i] = vy; p.vz[i] = vz;
    p.life[i] = life; p.age[i] = 0;
    p.r[i] = r; p.g[i] = g; p.b[i] = b;
    p.size[i] = u8(size); p.effect[i] = u8(effect);
    return true;
}

pub fn clear(p: &Particles) { p.count = 0; }

fn kill(p: &Particles, i: int) {
    let last = p.count - 1;
    p.px[i] = p.px[last]; p.py[i] = p.py[last]; p.pz[i] = p.pz[last];
    p.vx[i] = p.vx[last]; p.vy[i] = p.vy[last]; p.vz[i] = p.vz[last];
    p.life[i] = p.life[last]; p.age[i] = p.age[last];
    p.r[i] = p.r[last]; p.g[i] = p.g[last]; p.b[i] = p.b[last];
    p.size[i] = p.size[last]; p.effect[i] = p.effect[last];
    p.count = last;
}

fn cell(f: f32): int {
    if f < 0 { return -1; }
    return int(f);
}

// Solid at a point; `drop` lowers it to the cube's underside so a big cube rests on the floor, not in it.
fn solid(w: &World, x: f32, y: f32, z: f32, drop: f32): bool {
    return world.get(w, cell(x), cell(y - drop), cell(z)) != 0;
}

// Ages, moves and collides every cube; the dead are swapped out. Collision is one cell lookup per
// cube in free flight, and per-axis lookups only on the frame it touches something.
pub fn update(p: &Particles, w: &World, dt: f32) {
    let i = 0;
    while i < p.count {
        let e = int(p.effect[i]);
        p.age[i] += dt;
        if p.age[i] >= p.life[i] { kill(p, i); continue; }
        let keep = 1 - p.drag[e] * dt;
        if keep < 0 { keep = 0; }
        let vx = p.vx[i] * keep; let vz = p.vz[i] * keep;
        let vy = (p.vy[i] - p.gravity[e] * dt) * keep;
        let x = p.px[i]; let y = p.py[i]; let z = p.pz[i];
        let nx = x + vx * dt; let ny = y + vy * dt; let nz = z + vz * dt;
        // A cube born inside a solid cell (dust off a face being mined) flies free until it is out.
        if p.collide[e] != 0 && !solid(w, x, y, z, 0) {
            let drop = edge(sizeNow(p, i)) * 0.5;
            if solid(w, nx, ny, nz, drop) {
                let bounce = p.bounce[e] != 0;
                if solid(w, x, ny, z, drop) {
                    if vy < 0 && bounce { vy = -vy * FLOOR_REST; }
                    else { vy = 0; }
                    if vy == 0 { vx *= 0.5; vz *= 0.5; }
                    ny = y;
                }
                if solid(w, nx, ny, z, drop) {
                    vx = 0; if bounce { vx = -p.vx[i] * WALL_REST; }
                    nx = x;
                }
                if solid(w, nx, ny, nz, drop) {
                    vz = 0; if bounce { vz = -p.vz[i] * WALL_REST; }
                    nz = z;
                }
            }
        }
        if ny < 0 { kill(p, i); continue; }
        p.px[i] = nx; p.py[i] = ny; p.pz[i] = nz;
        p.vx[i] = vx; p.vy[i] = vy; p.vz[i] = vz;
        i += 1;
    }
}
