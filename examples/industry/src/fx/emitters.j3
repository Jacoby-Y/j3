// Structures that make particles while they run. Which block makes what is the `emitter` rows in
// `data/content.j3`; this walks the machines and sprays each running one's rows.
module industry.fx.emitters;

use j3.math.{ Mat4, Vec3 };
use industry.data.defs;
use industry.fx.effects;
use industry.fx.pool.Particles;
use industry.machine.dispatch;
use industry.models;
use industry.world;
use industry.world.World;

// Machines farther than this from the eye (cells) make nothing, so a big factory cannot fill the pool.
const RANGE: f32 = 64;
// Model units per cell: authoring cells are 1/8 voxel.
const UNIT: f32 = 0.125;

pub fn tick(p: &Particles, w: &World, eye: Vec3, dt: f32) {
    for slot in 1..w.slotHigh + 1 {
        let kind = w.slotKind[slot];
        let rows = defs.emitterRows(kind);
        if rows == 0 { continue; }
        let at = world.slotAnchor(w, slot);
        let ox = f32(world.anchorX(at)) + 1; let oy = f32(world.anchorY(at)); let oz = f32(world.anchorZ(at)) + 1;
        let near = Vec3.xyz(ox - eye.x, oy - eye.y, oz - eye.z);
        if near.dot(near) > RANGE * RANGE || !dispatch.running(w, at) { continue; }
        let turn = models.quarter(w.facing[at]);
        let color = dispatch.effectColor(w, at);
        let first = defs.emitterFirst(kind);
        for row in first..first + rows {
            let e = defs.emitterInfo(row);
            let local = turn.transformPoint(Vec3.xyz(f32(e.x) * UNIT, f32(e.y) * UNIT, f32(e.z) * UNIT));
            let dir = turn.transformPoint(Vec3.xyz(e.dx, e.dy, e.dz));
            effects.spray(p, e.effect, Vec3.xyz(ox + local.x, oy + local.y, oz + local.z), dir, color, dt);
        }
    }
}
