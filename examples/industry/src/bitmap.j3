// Small 5x7 HUD alphabet, keeping the game free of font and SDL_ttf dependencies.
module industry.bitmap;
use j3.game;
use j3.math.Vec2;

const LETTERS: string = "";
const DIGITS: string = "";

pub fn draw(x: f32, y: f32, message: string) {
    drawScaled(x, y, message, 2);
}

pub fn drawScaled(x: f32, y: f32, message: string, scale: f32) {
    let letters = LETTERS;
    let digits = DIGITS;
    game.setColor(game.rgb(246, 238, 215));
    for letter in 0..message.len {
        let code = int(message[letter]);
        if code >= 97 && code <= 122 { code -= 32; }
        let pattern: string = "";
        if code >= 65 && code <= 90 { pattern = letters[(code - 65) * 35..(code - 64) * 35]; }
        if code >= 48 && code <= 57 { pattern = digits[(code - 48) * 35..(code - 47) * 35]; }
        if code == 58 { pattern = "00000001000010000000001000010000000"; }
        if code == 45 { pattern = "00000000000000011111000000000000000"; }
        if code == 46 { pattern = "00000000000000000000000000000000100"; }
        if code == 62 { pattern = "10000010000010000010001000100010000"; }
        if code == 91 { pattern = "01100010000100001000010000100001100"; }
        if code == 93 { pattern = "00110000100001000010000100001000110"; }
        for pixel in 0..pattern.len {
            if pattern[pixel] == 49 {
                game.drawRect(Vec2 { x: x + f32(letter * 6 + pixel % 5) * scale,
                    y: y + f32(pixel / 5) * scale }, Vec2 { x: scale, y: scale });
            }
        }
    }
}
