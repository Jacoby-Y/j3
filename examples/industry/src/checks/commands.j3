module industry.checks.commands;

use j3.memory.Arena;
use j3.text;
use j3.text.Text;
use industry.checks.report;
use industry.checks.report.{ expect };
use industry.chunks;
use industry.commands;
use industry.data.item;
use industry.inventory;
use industry.world;
use industry.world.World;

fn open(w: &World): int {
    let count = 0;
    for each in 0..w.unlocked.len { if w.unlocked[each] != 0 { count += 1; } }
    return count;
}

fn same(out: &Text, want: string): bool { return text.same(out.str(), want); }

pub fn run() {
    report.suite("console commands");
    let mem = Arena.create(1024);
    let w = world.createSeed(&mem, 3);
    chunks.unlock(&w, world.CENTER, world.CENTER);
    let bag = inventory.create(&mem);
    let out = Text.new(&mem);

    commands.run(&w, &bag, "add coin 100", &out);
    expect(w.coins == 100 && same(&out, "added coins: 100"), "add coin gives coins");
    out.clear(); commands.run(&w, &bag, "add raw copper 7", &out);
    expect(bag.counts[int(item.COPPER)] == 7, "an item name with a space takes the trailing number");
    out.clear(); commands.run(&w, &bag, "add coal", &out);
    expect(bag.counts[int(item.COAL)] == 1, "no number adds one");
    out.clear(); commands.run(&w, &bag, "add nothing 3", &out);
    expect(same(&out, "no item named nothing"), "an unknown item is named in the reply");
    out.clear(); commands.run(&w, &bag, "bogus", &out);
    expect(out.len() > 0 && w.coins == 100, "an unknown command only replies");
    out.clear(); commands.run(&w, &bag, "help", &out);
    expect(text.contains(out.str(), "unlock chunk-ring") && text.contains(out.str(), "\n"), "help lists every command");

    out.clear(); commands.run(&w, &bag, "unlock chunk-ring", &out);
    expect(open(&w) == 1, "the command only queues the ring");
    let ticks = 0;
    chunks.tick(&w, 0.0);
    expect(w.genActive, "the first chunk starts generating");
    while (w.ringTarget != 0 || w.genActive) && ticks < 2000000000 { chunks.tick(&w, 0.02); ticks += 1; }
    expect(open(&w) == 9, "the whole first ring opens, one chunk at a time");
    commands.run(&w, &bag, "unlock chunk-ring", &out);
    while (w.ringTarget != 0 || w.genActive) && ticks < 2000000000 { chunks.tick(&w, 0.02); ticks += 1; }
    expect(open(&w) == 25, "the next call opens the next ring");

    expect(text.same(commands.suggestion("a", 0), "add"), "command words complete");
    expect(text.same(commands.suggestion("", 2), "unlock"), "every command is offered");
    expect(text.same(commands.suggestion("add co", 0), "COIN"), "add completes coin first");
    expect(text.same(commands.suggestion("add raw c", 0), "RAW COPPER"), "item names complete across a space");
    expect(text.same(commands.suggestion("add coin 1", 0), ""), "a typed number ends the suggestions");
    expect(text.same(commands.suggestion("unlock ", 0), "CHUNK-RING"), "unlock completes chunk-ring");
    mem.destroy();
}
