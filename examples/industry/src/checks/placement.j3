module industry.checks.placement;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use j3.gfx;
use j3.gfx.voxel;
use industry.mining;
use industry.machine.drills;
use industry.machine.furnace;
use industry.checks.fixture;
use industry.placement;
use industry.player;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.machine.belts;
use industry.world;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
const Drill = @script("scripts/drill.j3s");

fn placementChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = fixture.playerAtStart();
    p.slot = 2;
    let copperHit = Hit { ok: true, x: 73, y: 5, z: 67, px: 73, py: 6, pz: 67 };
    let snapped = placement.resolve(&w, &p, copperHit, 0);
    expect(snapped.ok && snapped.x == 72 && snapped.z == 68 && snapped.y == 5,
        "aiming at either ore part snaps drill onto neighboring ground at correct height");
    expect(snapped.dir == conveyor.NORTH, "snapped drill automatically faces copper");
    expect(placement.place(&w, snapped), "place drill through actual player placement");
    let source = cell(snapped.x, snapped.y, snapped.z);
    expect(drills.rear(&w, source) == -1, "new drill reports missing output");
    p.slot = 1;
    let drillHit = Hit { ok: true, x: 73, y: 5, z: 69, px: 74, py: 5, pz: 69 };
    let blocked = placement.resolve(&w, &p, drillHit, 0);
    expect(blocked.visible && !blocked.ok, "preview explains player overlapping output footprint");
    p.body.pos.z = 76;
    let output = placement.resolve(&w, &p, drillHit, conveyor.SOUTH);
    expect(output.ok && output.x == 72 && output.y == 5 && output.z == 70 && output.dir == conveyor.SOUTH,
        "output location snaps while selected direction stays fixed");
    expect(placement.place(&w, output), "place snapped output belt");
    expect(drills.running(&w, source), "player-placed drill and belt are operational");
    let drill = Drill {};
    drill.update(&w, 3.9);
    expect(w.belts[world.slotOf(&w, cell(72, 5, 70))].count == 0, "player setup waits four seconds");
    drill.update(&w, 0.1);
    expect(w.belts[world.slotOf(&w, cell(72, 5, 70))].count == 1, "player setup actually mines copper");
    let beltHit = Hit { ok: true, x: 73, y: 5, z: 71, px: 73, py: 6, pz: 71 };
    let extension = placement.resolve(&w, &p, beltHit, conveyor.WEST);
    expect(extension.ok && extension.x == 72 && extension.y == 5 && extension.z == 72 &&
        extension.dir == conveyor.WEST, "belt extension uses selected absolute direction");
    expect(placement.place(&w, extension), "place connected corner");
    belts.update(&w, 2);
    expect(w.belts[world.slotOf(&w, cell(72, 5, 72))].count == 1, "snapped extension accepts mined item");
    p.slot = 2;
    let ground = Hit { ok: true, x: 82, y: 3, z: 82, px: 82, py: 4, pz: 82 };
    let anywhere = placement.resolve(&w, &p, ground, 0);
    expect(anywhere.ok, "drills can be placed away from ore");
    p.slot = 1;
    let top = Hit { ok: true, x: 73, y: 5, z: 71, px: 73, py: 6, pz: 71, face: gfx.FACE_PY };
    let stacked = placement.resolveWithShift(&w, &p, top, conveyor.EAST, true);
    expect(stacked.ok && stacked.y == 6 && stacked.x == 72 && stacked.z == 70 && placement.place(&w, stacked),
        "conveyors stack on top of each other");
    p.slot = 2;
    world.breakAt(&w, 72, 5, 68);
    let rotated = placement.resolve(&w, &p, copperHit, 1);
    expect(rotated.ok && rotated.dir == conveyor.EAST && rotated.x == 70 && rotated.z == 66,
        "R moves ore-snapped drill to another side while preserving mining direction");
    mem.destroy();
}

fn placementGridAndLineChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = fixture.playerAtStart();
    p.body.pos = Vec3.xyz(88, 8, 88);
    let ground = Hit { ok: true, x: 85, y: 3, z: 61, face: gfx.FACE_PY };
    for slot in 1..6 {
        p.slot = slot;
        let free = placement.resolve(&w, &p, ground, conveyor.EAST);
        expect(free.ok && free.x == 85 && free.z == 61 && free.y == 4,
            "every structure snaps to odd half-meter voxel coordinates");
        expect(placement.place(&w, free), "place structure on half-meter grid");
        expect(world.anchorAt(&w, 86, 4, 62) == cell(85, 4, 61), "odd footprint retains correct anchor");
        world.breakAt(&w, 86, 4, 62);
    }
    p.slot = 1;
    expect(world.placeConveyor(&w, 61, 8, 79, conveyor.EAST), "chain start on odd grid");
    expect(world.placeConveyor(&w, 63, 8, 79, conveyor.SOUTH), "first chain turn");
    expect(world.placeConveyor(&w, 63, 8, 81, conveyor.WEST), "second chain turn");
    expect(world.placeConveyor(&w, 61, 8, 81, conveyor.SOUTH), "chain tail");
    let startHit = Hit { ok: true, x: 62, y: 8, z: 80, face: gfx.FACE_PY };
    let middleHit = Hit { ok: true, x: 64, y: 8, z: 82 };
    let tailHit = Hit { ok: true, x: 61, y: 8, z: 81 };
    for facing in 0..4 {
        let fromStart = placement.resolve(&w, &p, startHit, u8(facing));
        let fromMiddle = placement.resolve(&w, &p, middleHit, u8(facing));
        let fromTail = placement.resolve(&w, &p, tailHit, u8(facing));
        expect(fromStart.visible && fromStart.ok && fromStart.x == 61 && fromStart.y == 8 && fromStart.z == 83 && fromStart.dir == u8(facing),
            "top-face preview follows turns to line end and preserves selected rotation");
        expect(fromMiddle.ok && fromMiddle.x == fromStart.x && fromMiddle.z == fromStart.z && fromMiddle.dir == fromStart.dir &&
            fromTail.ok && fromTail.x == fromStart.x && fromTail.z == fromStart.z,
            "start middle and tail resolve the same chain endpoint");
    }
    let stack = placement.resolveWithShift(&w, &p, middleHit, conveyor.EAST, true);
    expect(stack.ok && stack.x == 63 && stack.y == 9 && stack.z == 81 && stack.dir == conveyor.EAST && placement.place(&w, stack),
        "Shift stacks above the aimed conveyor rather than chain tail");
    world.set(&w, 61, 8, 83, block.STONE);
    let blockedEnd = placement.resolve(&w, &p, startHit, conveyor.EAST);
    expect(blockedEnd.visible && !blockedEnd.ok && blockedEnd.x == 61 && blockedEnd.z == 83 && !placement.place(&w, blockedEnd),
        "blocked endpoint keeps invalid ghost at end and rejects placement");
    world.breakAt(&w, 61, 8, 83);
    let extension = placement.resolve(&w, &p, startHit, conveyor.EAST);
    expect(placement.place(&w, extension) && world.direction(&w, 61, 8, 83) == conveyor.EAST,
        "clicking start places selected corner at chain end");
    let newEnd = placement.resolve(&w, &p, startHit, conveyor.NORTH);
    expect(newEnd.ok && newEnd.x == 63 && newEnd.z == 83, "ghost advances along newly extended chain");
    expect(world.placeConveyor(&w, 70, 8, 80, conveyor.EAST), "loop first belt");
    expect(world.placeConveyor(&w, 72, 8, 80, conveyor.SOUTH), "loop second belt");
    expect(world.placeConveyor(&w, 72, 8, 82, conveyor.WEST), "loop third belt");
    expect(world.placeConveyor(&w, 70, 8, 82, conveyor.NORTH), "loop fourth belt");
    let loopHit = Hit { ok: true, x: 71, y: 8, z: 81, face: gfx.FACE_PY };
    let loopPlan = placement.resolve(&w, &p, loopHit, conveyor.NORTH);
    expect(loopPlan.visible && !loopPlan.ok && !placement.place(&w, loopPlan), "closed chain terminates with invalid preview");
    let loopStack = placement.resolveWithShift(&w, &p, loopHit, conveyor.NORTH, true);
    expect(loopStack.ok && loopStack.x == 70 && loopStack.y == 9 && loopStack.z == 80, "Shift can stack on a closed loop");
    mem.destroy();
}

fn facingChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = fixture.playerAtStart();
    p.body.pos = Vec3.xyz(88, 8, 84);
    let ground = Hit { ok: true, x: 80, y: 3, z: 80 };
    for slot in 1..4 {
        p.slot = slot;
        for facing in 0..4 {
            for view in 0..4 {
                p.yaw = f32(view) * 1.5707963;
                let plan = placement.resolve(&w, &p, ground, u8(facing));
                expect(plan.dir == u8(facing), "camera yaw cannot rotate any structure");
            }
        }
    }
    p.slot = 2;
    let copper = Hit { ok: true, x: 73, y: 5, z: 67 };
    for side in 0..4 {
        p.body.pos = Vec3.xyz(60 + f32(side) * 8, 8, 60 + f32(side) * 4);
        let drill = placement.resolve(&w, &p, copper, conveyor.NORTH);
        expect(drill.dir == conveyor.NORTH && drill.x == 72 && drill.z == 68,
            "moving around copper cannot rotate or reposition fixed-facing drill");
    }
    p.slot = 3; p.body.pos = Vec3.xyz(88, 8, 84);
    let kiln = placement.resolve(&w, &p, ground, conveyor.SOUTH);
    expect(kiln.ok && kiln.id == block.FURNACE && kiln.dir == conveyor.SOUTH, "place furnace with selected facing");
    expect(placement.place(&w, kiln), "actual furnace placement");
    let at = cell(kiln.x, kiln.y, kiln.z);
    expect(world.get(&w, kiln.x + 1, kiln.y + 3, kiln.z + 1) == block.FURNACE, "furnace occupies all four voxel layers");
    let top = Hit { ok: true, x: kiln.x + 1, y: kiln.y + 3, z: kiln.z + 1 };
    p.slot = 1;
    let out = placement.resolve(&w, &p, top, conveyor.WEST);
    expect(out.y == kiln.y && out.dir == conveyor.WEST && out.z == kiln.z + 2,
        "aiming at tall furnace normalizes anchor without overriding fixed direction");
    expect(world.anchorAt(&w, top.x, top.y, top.z) == at, "upper furnace part resolves to base anchor");
    world.breakAt(&w, top.x, top.y, top.z);
    expect(world.get(&w, kiln.x, kiln.y, kiln.z) == block.AIR && w.machineCount == 0,
        "breaking any tall furnace part removes whole machine");
    world.set(&w, 80, 6, 80, block.STONE);
    expect(!world.placeMachine(&w, 80, 4, 80, conveyor.NORTH, block.FURNACE), "furnace upper obstruction prevents placement");
    expect(!world.placeMachine(&w, 80, world.SY - 3, 80, conveyor.NORTH, block.FURNACE), "furnace must fit world height");
    mem.destroy();
}


pub fn run() {
    report.suite("placement"); placementChecks();
    report.suite("placement grid and lines"); placementGridAndLineChecks();
    report.suite("placement facing"); facingChecks();
}
