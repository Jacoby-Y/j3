// The definition tables must describe a complete, consistent game: nothing registered half-way.
module industry.checks.table;

use industry.checks.report.{ expect };
use industry.data.block;
use industry.data.defs;
use industry.data.item;
use industry.world;

fn itemChecks() {
    expect(item.kinds() == defs.itemCount() && item.kinds() > 1, "item ids are contiguous from zero");
    for id in 1..item.kinds() {
        let def = defs.itemInfo(u8(id));
        expect(def.name.len > 0, "every item has a name");
        expect(def.price >= 0, "prices are not negative");
        if def.block != 0 { expect(int(def.block) < defs.blockCount(), "placed block exists"); }
        if def.cargo >= 0 {
            let cargoModel = defs.modelInfo(def.cargo);
            expect(cargoModel.batch == defs.BATCH_CARGO, "belt cargo models are cargo batches");
        }
        if def.smelts != 0 { expect(int(def.smelts) < item.kinds() && item.price(def.smelts) > 0, "smelting yields a real item"); }
        expect(def.icon.len > 0 || def.top + def.left + def.right > 0, "every item has an icon source");
    }
    for slot in 0..item.HOTBAR {
        let id = item.hotbarItem(slot);
        expect(id != 0 && item.blockFor(id) != block.AIR || id == item.PICKAXE, "each default hotbar slot holds a tool or a placeable item");
    }
}

fn recipeChecks() {
    expect(item.recipeCount() > 0 && item.recipeCount() <= 24, "recipes fit the table");
    for index in 0..item.recipeCount() {
        let id = item.recipe(index);
        expect(item.recipeCost(id) > 0 || item.recipeIngots(id) > 0 || item.recipeIron(id) > 0, "a recipe has a cost");
        expect(item.blockFor(id) != block.AIR || id == item.COPPER_WIRE, "a recipe makes a placeable item, or wire");
        expect(item.tab(id) >= 0 && item.tab(id) < 4, "recipes belong to a build menu tab");
    }
}

fn blockChecks() {
    expect(defs.blockCount() > 1, "blocks are registered");
    for id in 1..defs.blockCount() {
        let def = defs.blockInfo(u8(id));
        expect(def.height >= 1, "a block is at least one voxel tall");
        if def.machine {
            expect(def.model >= 0 && def.model < defs.modelCount(), "machines have a model");
            let mesh = defs.modelInfo(def.model);
            expect(mesh.batch == defs.BATCH_MACHINE, "machine models are machine batches");
            expect(world.height(u8(id)) == def.height, "world height reads the table");
            if def.overlayMode != defs.OVERLAY_NONE {
                expect(def.overlay >= 0 && def.overlay < defs.modelCount(), "an overlay mode names an overlay model");
            }
        } else {
            expect(def.model < 0 && !def.storage, "terrain has no machine model and no storage");
        }
        expect(def.r != 1 || def.g != 0 || def.b != 1, "no block keeps the missing-color magenta");
    }
}

fn oreChecks() {
    expect(defs.oreCount() > 0, "ores are registered");
    for index in 0..defs.oreCount() {
        let ore = defs.oreInfo(index);
        expect(block.isNode(ore.node) && block.isVein(ore.vein) && ore.node != ore.vein, "an ore has a node block and a vein block");
        expect(item.fromOre(ore.node) == ore.item && item.fromOre(ore.vein) == ore.item, "node and vein yield the ore item");
        let nodeMesh = defs.modelInfo(ore.nodeModel);
        expect(nodeMesh.batch == defs.BATCH_NODE, "node models are node batches");
        expect(ore.offset >= 0 && ore.offset + world.FOOTPRINT <= world.CHUNK, "a node fits inside its chunk");
        for other in 0..index {
            let b = defs.oreInfo(other);
            let gap = ore.offset - b.offset;
            if gap < 0 { gap = -gap; }
            expect(gap >= world.FOOTPRINT, "nodes of different ores do not overlap");
        }
    }
}

pub fn run() {
    itemChecks();
    recipeChecks();
    blockChecks();
    oreChecks();
}
