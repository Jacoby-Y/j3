module industry.checks.chunk;

use j3.math.{ Vec3, Vec2, Mat4 };
use industry.chunks;
use industry.checks.fixture;
use industry.player;
use industry.data.block;
use industry.data.conveyor;
use industry.world;
use industry.world.World;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn chunkChecks(w: &World) {
    expect(fixture.unlock(w, 1, 1), "initial unlock");
    expect(!fixture.unlock(w, 0, 0), "diagonal is not adjacent");
    expect(!fixture.unlock(w, -1, 1), "negative chunk bounds");
    expect(!fixture.unlock(w, world.CHUNKS, 1), "upper chunk bounds");
    expect(world.get(w, 24, 3, 72) == block.AIR, "locked chunk remains ungenerated");
    world.set(w, 24, 3, 72, block.FOUNDATION);
    expect(world.get(w, 24, 3, 72) == block.AIR, "locked cells cannot be edited");
    expect(!world.placeConveyor(w, 47, 8, 72, conveyor.EAST), "footprint cannot cross locked edge");
    let half = Vec3.xyz(0.6, 1.7, 0.6);
    expect(chunks.fits(w, Vec3.xyz(48.7, 8, 72), half), "player inside active chunk");
    expect(!chunks.fits(w, Vec3.xyz(48.5, 8, 72), half), "whole player stays inside active bounds");
    expect(chunks.nearby(w, Vec3.xyz(49, 8, 72)) == world.CHUNKS, "nearest unlock prompt");
    expect(chunks.nearby(w, Vec3.xyz(72, 8, 72)) == -1, "no distant prompt");
    let copper = 0;
    for z in 48..96 { for y in 0..16 { for x in 48..96 {
        if world.get(w, x, y, z) == block.COPPER_NODE { copper += 1; }
    } } }
    expect(copper == 8, "one 2x2x2 copper node");
    world.breakAt(w, 72, 5, 66);
    expect(world.get(w, 72, 5, 66) == block.COPPER_NODE, "resource node persists");
    world.set(w, 60, 8, 60, block.STONE);
    expect(!fixture.unlock(w, 1, 1), "duplicate unlock is a no-op");
    expect(world.get(w, 60, 8, 60) == block.STONE, "unlock preserves edits");
    expect(fixture.unlock(w, 0, 1), "adjacent unlock");
    expect(world.get(w, 24, 5, 66) == block.COPPER_NODE, "new chunk gets copper node");
    expect(chunks.fits(w, Vec3.xyz(48, 8, 72), half), "cross unlocked seam");
    expect(!chunks.fits(w, Vec3.xyz(0.5, 8, 72), half), "world outer bounds");
    expect(!chunks.fits(w, Vec3.xyz(48, 8, 48), half), "cannot cut across a locked corner");
}


pub fn run(w: &World) { report.suite("chunks"); chunkChecks(w); }
