// Market transactions, close settlement, and conveyor intake through the real game paths.
module industry.checks.market;
use industry.checks.report.{ expect, cell };
use j3.memory.Arena;
use j3.gfx.voxel.Hit;
use industry.session;
use industry.checks.fixture;
use industry.machine.container;
use industry.inventory;
use industry.machine.market;
use industry.placement;
use industry.machine.belts;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.world;


pub fn run() {
    let mem = Arena.create(1024);
    let g = session.boot(&mem);
    g.world = fixture.create(&mem);
    fixture.unlock(&g.world, 1, 1);
    g.player = fixture.playerAtStart();
    let w = &g.world;
    expect(item.hotbarItem(5) == item.MARKET && item.blockFor(item.MARKET) == block.MARKET,
        "slot six selects Market Console");
    g.player.slot = 5;
    let floor = Hit { ok: true, x: 80, y: 3, z: 60, face: 3 };
    let plan = placement.resolve(w, &g.player, floor, conveyor.NORTH);
    expect(plan.ok && plan.id == block.MARKET && placement.place(w, plan), "player can place Market Console");
    let at = cell(80, 4, 60);
    expect(market.valid(w, at) && world.height(block.MARKET) == 3, "market owns a storage slot");
    for y in 4..7 { for z in 60..62 { for x in 80..82 {
        expect(world.get(w, x, y, z) == block.MARKET && world.anchorAt(w, x, y, z) == at,
            "every market part occupies and resolves the 2x2x3 footprint");
    } } }
    let bag = container.contents(w, at);
    inventory.add(&g.carried, item.COPPER, 4);
    inventory.add(&g.carried, item.COPPER_INGOT, 2);
    let hit = Hit { ok: true, x: 81, y: 6, z: 61 };
    expect(session.openContainer(&g, hit), "interacting with upper market part opens its sale queue");
    inventory.move(&g.carried, &bag, item.COPPER, 4);
    inventory.move(&g.carried, &bag, item.COPPER_INGOT, 2);
    expect(w.coins == 0 && market.value(&bag) == 10, "manual deposits wait until close");
    inventory.move(&bag, &g.carried, item.COPPER, 1);
    expect(market.value(&bag) == 9 && w.coins == 0, "withdrawals cancel unsold items");
    world.breakAt(w, 81, 6, 61);
    expect(market.valid(w, at), "nonempty market cannot be removed and lose pending items");
    session.closeInventory(&g);
    expect(w.coins == 9 && inventory.total(&bag) == 0 && g.carried.counts[int(item.COPPER)] == 1,
        "close consumes only deposited items and credits exact mixed-stack prices");
    session.closeInventory(&g);
    expect(w.coins == 9 && !g.inventoryOpen && g.openStore == -1, "repeated close cannot sell twice");
    session.openContainer(&g, hit);
    session.closeInventory(&g);
    expect(w.coins == 9, "empty close does not create coins");
    world.breakAt(w, 81, 6, 61);
    expect(!market.valid(w, at) && market.sell(w, at) == 0, "removed market has no sellable storage");

    for rotation in 0..4 {
        expect(world.placeMachine(w, 80, 4, 60, u8(rotation), block.MARKET), "rotated market placement");
        let queued = container.contents(w, at);
        inventory.add(&queued, item.COAL, 256);
        let before = w.coins;
        for direction in 0..4 {
            let dir = u8(direction);
            let x = 80 - int(conveyor.dx(dir)) * 2;
            let z = 60 - int(conveyor.dz(dir)) * 2;
            expect(world.placeConveyor(w, x, 4, z, dir), "market intake belt on each side");
            let belt = cell(x, 4, z);
            expect(belts.insert(w, belt, item.COPPER_INGOT), "ingot queued for automatic sale");
            belts.update(w, 2);
            expect(w.belts[world.slotOf(w, belt)].count == 0 && w.coins == before + (direction + 1) * 3,
                "belt arrival sells once from every side and rotation, even with full manual queue");
            belts.update(w, 2);
            expect(w.coins == before + (direction + 1) * 3, "empty belt cannot credit twice");
            expect(!market.take(w, belt, 0) && !market.take(w, belt, 255) && !market.take(w, belt, item.PICKAXE),
                "market rejects invalid and hotbar-only item ids");
            world.breakAt(w, x, 4, z);
        }
        expect(inventory.total(&queued) == 256, "automatic sales preserve pending manual deposits");
        expect(world.placeConveyor(w, 80, 5, 62, conveyor.NORTH), "raised intake belt");
        let raised = cell(80, 5, 62);
        belts.insert(w, raised, item.COAL);
        belts.update(w, 2);
        expect(w.belts[world.slotOf(w, raised)].count == 1 && w.coins == before + 12, "wrong-height belt keeps cargo unsold");
        world.breakAt(w, 80, 5, 62);
        expect(market.sell(w, at) == 256 && w.coins == before + 268, "full manual queue settles after automatic sales");
        world.breakAt(w, 80, 4, 60);
    }
    expect(world.placeMachine(w, 80, 4, 60, 0, block.MARKET), "replacement market");
    let fresh = container.contents(w, at);
    expect(inventory.total(&fresh) == 0, "replacement starts empty");
    world.breakAt(w, 80, 4, 60);
    expect(world.placeMachine(w, 80, 4, 60, 0, block.CONTAINER), "ordinary container after market");
    let stored = container.contents(w, at);
    inventory.add(&stored, item.COPPER, 3);
    let wallet = w.coins;
    session.openContainer(&g, hit);
    session.closeInventory(&g);
    expect(w.coins == wallet && inventory.total(&stored) == 3, "closing a container preserves items without selling");
    expect(market.price(item.COAL) == 1 && market.price(item.COPPER) == 1 && market.price(item.COPPER_INGOT) == 3,
        "starter prices give ingots three coins and other items one");
    mem.destroy();
}
