module industry.checks.belt;

use industry.data.conveyor;
use industry.data.item;
use industry.machine.belts;
use industry.world;
use industry.world.World;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn beltChecks(w: &World) {
    expect(world.placeConveyor(w, 60, 8, 70, conveyor.EAST), "source belt");
    expect(world.placeConveyor(w, 62, 8, 70, conveyor.EAST), "receiver belt");
    let a = cell(60, 8, 70); let b = cell(62, 8, 70);
    expect(belts.insert(w, a, item.COPPER), "empty belt accepts");
    expect(!belts.insert(w, a, item.COPPER), "input spacing");
    belts.update(w, 0.5);
    expect(close(w.belts[world.slotOf(w, a)].progress[0], 0.5), "steady belt movement");
    expect(!belts.accepts(w, a), "cannot insert inside spacing");
    belts.update(w, 0.2);
    expect(belts.insert(w, a, item.COPPER), "input opens at minimum spacing");
    belts.update(w, 1.3);
    expect(w.belts[world.slotOf(w, a)].count == 1 && w.belts[world.slotOf(w, b)].count == 1, "handoff conserves items");
    expect(close(w.belts[world.slotOf(w, b)].progress[0], 0), "handoff item moves only once per tick");
    belts.update(w, 10);
    expect(w.belts[world.slotOf(w, a)].count == 0 && w.belts[world.slotOf(w, b)].count == 2, "second handoff");
    for n in 0..20 { belts.update(w, 0.1); }
    expect(close(w.belts[world.slotOf(w, b)].progress[0], 2), "blocked front stops at belt end");
    expect(w.belts[world.slotOf(w, b)].progress[0] - w.belts[world.slotOf(w, b)].progress[1] >= belts.SPACING - 0.0001, "blocked queue spacing");
    expect(belts.insert(w, a, item.COPPER), "queue another item");
    belts.update(w, 10);
    expect(belts.insert(w, a, item.COPPER), "queue fourth item");
    belts.update(w, 10);
    expect(belts.insert(w, a, item.COPPER), "queue fifth item");
    belts.update(w, 10);
    expect(w.belts[world.slotOf(w, a)].count == 1 && w.belts[world.slotOf(w, b)].count == 4, "receiver blocks when rear has no room");
    expect(close(w.belts[world.slotOf(w, a)].progress[0], 2), "back-pressure propagates upstream");
    expect(!belts.insert(w, b + 1, item.COPPER), "only belt anchors accept");
    world.breakAt(w, 62, 8, 70);
    expect(world.placeConveyor(w, 62, 8, 70, conveyor.WEST), "opposing belt");
    belts.update(w, 1);
    expect(w.belts[world.slotOf(w, a)].count == 1 && w.belts[world.slotOf(w, b)].count == 0, "opposing directions cannot hand off");
    world.breakAt(w, 62, 8, 70);
    expect(world.placeConveyor(w, 62, 8, 70, conveyor.EAST), "reconnect receiver");
    belts.update(w, 0);
    expect(w.belts[world.slotOf(w, a)].count == 0 && w.belts[world.slotOf(w, b)].count == 1, "blocked item resumes after reconnection");
    world.breakAt(w, 62, 8, 70);
    expect(world.placeConveyor(w, 62, 8, 70, conveyor.SOUTH), "corner receiver");
    expect(belts.insert(w, a, item.COPPER), "corner source item");
    belts.update(w, 2);
    expect(w.belts[world.slotOf(w, a)].count == 0 && w.belts[world.slotOf(w, b)].count == 1, "perpendicular belt handoff");
    expect(w.belts[world.slotOf(w, b)].entry[0] == conveyor.EAST, "corner remembers entry edge");
    belts.update(w, 1);
    expect(close(w.belts[world.slotOf(w, b)].progress[0], 1), "corner reaches center at steady speed");
}


pub fn run(w: &World) { report.suite("belts"); beltChecks(w); }
