// Limits are refused at placement with a reason; nothing panics when a player reaches one.
module industry.checks.capacity;

use j3.gfx;
use j3.gfx.voxel.Hit;
use j3.memory.Arena;
use j3.text;
use industry.checks.fixture;
use industry.checks.report.{ expect, cell };
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.inventory;
use industry.placement;
use industry.world;

pub fn run() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    // 24 x 24 belts per layer fill the chunk; stack layers until the table is full.
    let placed = 0; let y = 8;
    while placed < world.MAX_MACHINES {
        for z in 0..24 { for x in 0..24 {
            if placed < world.MAX_MACHINES && world.placeConveyor(&w, 48 + x * 2, y, 48 + z * 2, conveyor.EAST) { placed += 1; }
        } }
        y += 1;
    }
    expect(w.machineCount == world.MAX_MACHINES, "machine table fills to its capacity");
    expect(!world.placeConveyor(&w, 48, y, 48, conveyor.EAST), "a full machine table refuses another machine");
    expect(!world.placeMachine(&w, 48, y, 50, conveyor.NORTH, block.DRILL), "a full machine table refuses every kind");
    let p = fixture.playerAtStart(); p.body.pos.x = 90; p.body.pos.z = 40;
    let bag = inventory.create(&mem);
    inventory.add(&bag, item.CONVEYOR, 1); inventory.swap(&bag, 0, 1); p.slot = 1;
    let plan = placement.resolveInventory(&w, &p, &bag, Hit { ok: true, x: 60, y: 3, z: 60, face: gfx.FACE_PY }, conveyor.EAST, false);
    expect(plan.visible && !plan.ok && text.same(plan.message, "MACHINE LIMIT REACHED"), "the preview names the machine limit");
    world.breakAt(&w, 48, 8, 48);
    expect(w.machineCount == world.MAX_MACHINES - 1 && world.placeConveyor(&w, 48, 8, 48, conveyor.EAST), "removing one machine frees its slot");
    mem.destroy();
}
