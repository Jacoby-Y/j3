// Machines advance in fixed steps: the result must not depend on how frames were sliced.
module industry.checks.simulation;

use j3.memory.Arena;
use industry.checks.fixture;
use industry.checks.report.{ expect, close, cell };
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.gameplay;
use industry.machine.belts;
use industry.session;
use industry.session.Game;
use industry.world;

// A belt with one item and a drill beside copper, in a fresh game.
fn setup(mem: &Arena): Game {
    let g = session.bootSeed(mem, 5);
    g.world = fixture.create(mem);
    fixture.unlock(&g.world, 1, 1);
    expect(world.placeConveyor(&g.world, 60, 8, 70, conveyor.EAST), "simulation belt");
    expect(world.placeConveyor(&g.world, 62, 8, 70, conveyor.EAST), "simulation receiver");
    expect(belts.insert(&g.world, cell(60, 8, 70), item.COPPER), "simulation cargo");
    expect(world.placeMachine(&g.world, 72, 5, 68, conveyor.NORTH, block.DRILL), "simulation drill");
    return g;
}

pub fn run() {
    let mem = Arena.create(1024);
    let sliced = setup(&mem); let hitch = setup(&mem);
    let frame: f32 = 0.016666668;
    for i in 0..90 { gameplay.simulate(&sliced, frame); }
    gameplay.simulate(&hitch, 1.5);
    let a = world.slotOf(&sliced.world, cell(60, 8, 70)); let b = world.slotOf(&hitch.world, cell(60, 8, 70));
    let c = world.slotOf(&sliced.world, cell(62, 8, 70)); let d = world.slotOf(&hitch.world, cell(62, 8, 70));
    expect(sliced.world.belts[a].count == hitch.world.belts[b].count && sliced.world.belts[c].count == hitch.world.belts[d].count,
        "one long frame moves items exactly like many short ones");
    expect(close(sliced.world.belts[c].progress[0], hitch.world.belts[d].progress[0]), "belt positions match");
    let drillA = world.slotOf(&sliced.world, cell(72, 5, 68)); let drillB = world.slotOf(&hitch.world, cell(72, 5, 68));
    expect(close(sliced.world.drills[drillA].clock, hitch.world.drills[drillB].clock) && close(hitch.world.drills[drillB].clock, 1.5),
        "drill clocks match after a hitch");
    // Time beyond the catch-up limit is dropped, not queued.
    let longHitch = setup(&mem);
    gameplay.simulate(&longHitch, 100);
    let drillC = world.slotOf(&longHitch.world, cell(72, 5, 68));
    expect(longHitch.world.drills[drillC].clock < 3 && longHitch.clock == 0, "a hitch longer than the catch-up limit does not run the world ahead");
    // A frame shorter than a step waits for the next one.
    let slow = setup(&mem);
    gameplay.simulate(&slow, 0.01);
    expect(close(slow.world.drills[world.slotOf(&slow.world, cell(72, 5, 68))].clock, 0), "less than one step does not advance machines");
    gameplay.simulate(&slow, 0.01);
    expect(slow.world.drills[world.slotOf(&slow.world, cell(72, 5, 68))].clock > 0.016, "leftover time carries into the next frame");
    mem.destroy();
}
