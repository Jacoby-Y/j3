module industry.checks.inventory;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use j3.gfx.voxel;
use industry.pickaxe;
use industry.mining;
use industry.machine.furnace;
use industry.machine.container;
use industry.interact;
use industry.session;
use industry.checks.fixture;
use industry.machine.market;
use industry.inventory;
use industry.placement;
use industry.player;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.data.item;
use industry.world;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn inventoryGridChecks() {
    let mem = Arena.create(1024);
    let bag = inventory.create(&mem); let carried = inventory.create(&mem);
    expect(inventory.slotItem(&bag,0) == 0 && inventory.slotItem(&bag,-1) == 0,
        "empty inventory has empty grid slots");
    inventory.add(&bag,item.COPPER,3); inventory.add(&bag,item.COPPER_INGOT,2);
    expect(inventory.slotItem(&bag,0) == item.COPPER && inventory.slotItem(&bag,1) == item.COPPER_INGOT &&
        inventory.slotItem(&bag,2) == 0,"grid shows occupied stacks and remaining empty slots");
    let selected = inventory.slotItem(&bag,0);
    expect(inventory.move(&bag,&carried,selected,1) == 1 && bag.counts[int(selected)] == 2,
        "single grid transfer keeps remaining stack");
    expect(inventory.move(&bag,&carried,selected,256) == 2,"whole-stack transfer clamps to remaining items");
    expect(inventory.slotItem(&bag,0) == 0 && inventory.slotItem(&bag,1) == item.COPPER_INGOT,
        "removed stack leaves an empty slot without moving other stacks");
    expect(inventory.total(&bag) + inventory.total(&carried) == 5,"grid transfers conserve inventory counts");
    mem.destroy();
}


fn buildMenuChecks() {
    let mem = Arena.create(1024);
    let g = session.boot(&mem);
    g.world = fixture.create(&mem);
    fixture.unlock(&g.world, 1, 1);
    g.player = fixture.playerAtStart(); let bag = &g.carried;
    g.player.body.pos = Vec3.xyz(90, 8, 88);
    expect(inventory.slotItem(bag, 0) == item.PICKAXE && inventory.total(bag) == 1, "new game starts with an inventory pickaxe");
    expect(!inventory.craft(bag, item.DRILL), "crafting requires copper ore");
    inventory.add(bag, item.COPPER, 5);
    for recipe in 0..5 { expect(inventory.craft(bag, item.recipe(recipe)), "each structure costs one copper ore"); }
    expect(bag.counts[int(item.COPPER)] == 0 && inventory.total(bag) == 6, "crafting conserves its one-item cost");
    expect(!inventory.craft(bag, item.PICKAXE) && !inventory.craft(bag, item.STONE), "only structure recipes are craftable");
    let furnaceSlot = -1;
    for slot in 0..inventory.SLOTS { if inventory.slotItem(bag, slot) == item.FURNACE { furnaceSlot = slot; } }
    inventory.swap(bag, furnaceSlot, 2); g.player.slot = 2;
    expect(inventory.slotItem(bag, 2) == item.FURNACE, "moving a structure to slot three selects it on the hotbar");
    let hit = Hit { ok: true, x: 85, y: 3, z: 61 };
    let plan = placement.resolveInventory(&g.world, &g.player, bag, hit, 0, false);
    let blocked = plan; blocked.ok = false;
    expect(!placement.placeInventory(&g.world, bag, 2, blocked) && bag.counts[int(item.FURNACE)] == 1, "failed placement keeps the structure");
    expect(plan.ok && placement.placeInventory(&g.world, bag, 2, plan), "crafted furnace places through inventory path");
    expect(bag.counts[int(item.FURNACE)] == 0 && !placement.placeInventory(&g.world, bag, 2, plan), "placement consumes one and cannot reuse the preview");
    expect(interact.collectBlock(&g, Hit { ok: true, x: 86, y: 6, z: 62 }) && bag.counts[int(item.FURNACE)] == 1, "breaking a machine part recovers one complete structure");
    inventory.swap(bag, 0, 35);
    expect(inventory.slotItem(bag, 35) == item.PICKAXE && inventory.slotItem(bag, 0) != item.PICKAXE, "pickaxe moves into the last inventory slot");
    for terrain in 0..3 {
        let id: u8 = block.STONE; if terrain == 1 { id = block.DIRT; } if terrain == 2 { id = block.GRASS; }
        world.set(&g.world, 85, 8, 70, id);
        expect(interact.collectBlock(&g, Hit { ok: true, x: 85, y: 8, z: 70 }), "terrain mining recovers a block");
        let recovered = item.fromBlock(id); let at = -1;
        for slot in 0..inventory.SLOTS { if inventory.slotItem(bag, slot) == recovered { at = slot; } }
        inventory.swap(bag, at, 2); g.player.slot = 2;
        let voxelPlan = placement.resolveInventory(&g.world, &g.player, bag, Hit { ok: true, x: 85, y: 3, z: 70, px: 85, py: 8, pz: 70 }, 0, false);
        expect(voxelPlan.ok && placement.placeInventory(&g.world, bag, 2, voxelPlan) && world.get(&g.world, 85, 8, 70) == id, "recovered terrain places as one voxel");
        world.breakAt(&g.world, 85, 8, 70);
    }
    expect(world.placeMachine(&g.world, 80, 4, 60, 0, block.MARKET), "sale restriction fixture");
    let queue = container.contents(&g.world, cell(80, 4, 60));
    inventory.add(&queue, item.COPPER, 2); inventory.add(&queue, item.DRILL, 1); inventory.add(&queue, item.PICKAXE, 1);
    expect(market.sell(&g.world, cell(80, 4, 60)) == 2 && queue.counts[int(item.DRILL)] == 1 && queue.counts[int(item.PICKAXE)] == 1, "market sells resources and preserves tools and structures");
    inventory.add(bag, item.STONE, inventory.CAPACITY);
    world.set(&g.world, 85, 8, 70, block.GRASS);
    expect(!interact.collectBlock(&g, Hit { ok: true, x: 85, y: 8, z: 70 }) && world.get(&g.world, 85, 8, 70) == block.GRASS, "full inventory prevents destructive mining");
    mem.destroy();
}


pub fn run() {
    report.suite("inventory grid"); inventoryGridChecks();
    report.suite("build menu"); buildMenuChecks();
}
