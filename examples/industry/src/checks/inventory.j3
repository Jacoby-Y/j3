module industry.checks.inventory;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use j3.gfx.voxel;
use industry.crafting;
use industry.drops;
use industry.pickaxe;
use industry.mining;
use industry.machine.furnace;
use industry.machine.container;
use industry.interact;
use industry.session.Game;
use industry.session;
use industry.checks.fixture;
use industry.machine.market;
use industry.inventory;
use industry.placement;
use industry.player;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.data.item;
use industry.world;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn inventoryGridChecks() {
    let mem = Arena.create(1024);
    let bag = inventory.create(&mem); let carried = inventory.create(&mem);
    expect(inventory.slotItem(&bag,0) == 0 && inventory.slotItem(&bag,-1) == 0,
        "empty inventory has empty grid slots");
    inventory.add(&bag,item.COPPER,3); inventory.add(&bag,item.COPPER_INGOT,2);
    expect(inventory.slotItem(&bag,0) == item.COPPER && inventory.slotItem(&bag,1) == item.COPPER_INGOT &&
        inventory.slotItem(&bag,2) == 0,"grid shows occupied stacks and remaining empty slots");
    let selected = inventory.slotItem(&bag,0);
    expect(inventory.move(&bag,&carried,selected,1) == 1 && bag.counts[int(selected)] == 2,
        "single grid transfer keeps remaining stack");
    expect(inventory.move(&bag,&carried,selected,256) == 2,"whole-stack transfer clamps to remaining items");
    expect(inventory.slotItem(&bag,0) == 0 && inventory.slotItem(&bag,1) == item.COPPER_INGOT,
        "removed stack leaves an empty slot without moving other stacks");
    expect(inventory.total(&bag) + inventory.total(&carried) == 5,"grid transfers conserve inventory counts");
    mem.destroy();
}

fn cursorChecks() {
    let mem = Arena.create(4096);
    let bag = inventory.create(&mem);
    inventory.add(&bag, item.COPPER, 5);
    expect(inventory.takeAt(&bag, 0, 3) == 3 && bag.counts[int(item.COPPER)] == 2 && inventory.slotItem(&bag, 0) == item.COPPER, "taking part of a stack keeps the rest in its slot");
    expect(inventory.putAt(&bag, 4, item.COPPER, 3) == 3 && bag.amounts[0] == 2 && bag.amounts[4] == 3 && bag.counts[int(item.COPPER)] == 5, "the same item can fill a second slot, splitting a stack");
    inventory.add(&bag, item.COPPER, 1);
    expect(bag.amounts[0] == 3 && bag.amounts[4] == 3, "new items join the first stack");
    expect(inventory.takeAt(&bag, 0, 9) == 3 && inventory.slotItem(&bag, 0) == 0 && inventory.slotItem(&bag, 4) == item.COPPER, "taking a whole stack frees its slot only");
    bag.counts[int(item.COPPER)] -= 1;
    expect(inventory.slotItem(&bag, 4) == item.COPPER && bag.amounts[4] == 2, "slots follow a direct change to the counts");
    inventory.add(&bag, item.COAL, 1);
    expect(inventory.putAt(&bag, 4, item.COAL, 1) == 0, "a different item cannot land on an occupied slot");
    expect(inventory.shiftHotbar(&bag, 4) && inventory.slotItem(&bag, 4) == 0, "shift-click sends a hotbar stack to the grid");
    let at = -1;
    for s in item.HOTBAR..inventory.SLOTS { if inventory.slotItem(&bag, s) == item.COPPER { at = s; } }
    expect(at >= 0 && inventory.shiftHotbar(&bag, at), "shift-click sends a grid stack back to the hotbar");
    let big = inventory.create(&mem);
    inventory.add(&big, item.STONE, 250);
    expect(big.amounts[0] == 99 && big.amounts[1] == 99 && big.amounts[2] == 52 && inventory.total(&big) == 250, "stacks hold 99 and spill into the next slot");
    expect(inventory.add(&big, item.STONE, 99999) == inventory.CAPACITY - 250, "only slot space limits the inventory");
    let other = inventory.create(&mem);
    expect(inventory.moveStack(&bag, inventory.SLOTS - 1, &other) == 0, "an empty slot moves nothing");
    mem.destroy();
}

fn dropChecks() {
    let mem = Arena.create(1024 * 64);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = fixture.playerAtStart(); p.body.pos = Vec3.xyz(100, 8, 100);
    let bag = inventory.create(&mem);
    let d = drops.create(&mem);
    drops.spawn(&d, Vec3.xyz(90.5, 12, 90.5), Vec3.xyz(0, 0, 0), item.COPPER, 3, 1);
    drops.spawn(&d, Vec3.xyz(90.6, 12, 90.5), Vec3.xyz(0, 0, 0), item.COPPER, 2, 1);
    expect(d.count == 1 && d.n[0] == 5, "drops of one kind close together merge");
    for i in 0..120 { drops.update(&d, &w, &p, &bag, 0.05); }
    expect(d.count == 1 && d.y[0] > 4 && d.y[0] < 6, "a drop falls and rests on the ground");
    p.body.pos = Vec3.xyz(90.5, 6, 90.5);
    let got = drops.update(&d, &w, &p, &bag, 0.05);
    expect(got == 5 && d.count == 0 && bag.counts[int(item.COPPER)] == 5, "walking over a drop picks it up");
    mem.destroy();
}


// Walk onto every drop, as the player would, and let the bag take what it has room for.
fn pickUp(g: &Game) {
    let keep = g.player.body.pos;
    while g.drops.count > 0 {
        g.player.body.pos = Vec3.xyz(g.drops.x[0], g.drops.y[0], g.drops.z[0]);
        g.drops.age[0] = 5;
        if drops.update(&g.drops, &g.world, &g.player, &g.carried, 0) == 0 { break; }
    }
    g.player.body.pos = keep;
}

fn craftQueueChecks() {
    let mem = Arena.create(1024);
    let bag = inventory.create(&mem); let q = crafting.create(&mem);
    inventory.add(&bag, item.COPPER, 3); inventory.add(&bag, item.COPPER_INGOT, 1);
    expect(inventory.times(&bag, item.COPPER_INGOT) == 3 && inventory.times(&bag, item.CONVEYOR) == 1, "times counts what the bag can pay");
    crafting.push(&q, &bag, item.CONVEYOR, 2);
    expect(crafting.queued(&q, item.CONVEYOR) == 1 && bag.counts[int(item.COPPER_INGOT)] == 0, "queueing pays at once and skips what can't be afforded");
    crafting.push(&q, &bag, item.COPPER_INGOT, 5);
    expect(crafting.queued(&q, item.COPPER_INGOT) == 3 && bag.counts[int(item.COPPER)] == 0, "ingots queue from raw ore");
    crafting.update(&q, &bag, 0.25);
    expect(crafting.fraction(&q, item.CONVEYOR) == 0.5, "the head shows progress");
    crafting.update(&q, &bag, 0.25);
    expect(bag.counts[int(item.CONVEYOR)] == 1 && q.count == 1, "a conveyor takes half a second");
    crafting.cancel(&q, &bag, item.COPPER_INGOT);
    expect(crafting.queued(&q, item.COPPER_INGOT) == 2 && bag.counts[int(item.COPPER)] == 1, "cancel refunds the ingredients");
    crafting.update(&q, &bag, 2); crafting.update(&q, &bag, 2);
    expect(bag.counts[int(item.COPPER_INGOT)] == 2 && q.count == 0, "ingots take two seconds each");
}

fn buildMenuChecks() {
    let mem = Arena.create(1024);
    let g = session.boot(&mem);
    g.world = fixture.create(&mem);
    fixture.unlock(&g.world, 1, 1);
    g.player = fixture.playerAtStart(); let bag = &g.carried;
    g.player.body.pos = Vec3.xyz(90, 8, 88);
    expect(inventory.slotItem(bag, 0) == item.PICKAXE && inventory.total(bag) == 1, "new game starts with an inventory pickaxe");
    expect(!inventory.craft(bag, item.DRILL), "crafting requires its ingredients");
    inventory.add(bag, item.STONE, 5); inventory.add(bag, item.COPPER_INGOT, 26);
    for recipe in 0..5 { expect(inventory.craft(bag, item.recipe(recipe)), "each starter structure can be crafted from its listed cost"); }
    expect(inventory.total(bag) == 6, "crafting spends exactly its listed cost");
    expect(!inventory.craft(bag, item.PICKAXE) && !inventory.craft(bag, item.STONE), "only structure recipes are craftable");
    let furnaceSlot = -1;
    for slot in 0..inventory.SLOTS { if inventory.slotItem(bag, slot) == item.FURNACE { furnaceSlot = slot; } }
    inventory.swap(bag, furnaceSlot, 2); g.player.slot = 2;
    expect(inventory.slotItem(bag, 2) == item.FURNACE, "moving a structure to slot three selects it on the hotbar");
    let hit = Hit { ok: true, x: 85, y: 3, z: 61 };
    let plan = placement.resolveInventory(&g.world, &g.player, bag, hit, 0, false);
    let blocked = plan; blocked.ok = false;
    expect(!placement.placeInventory(&g.world, bag, 2, blocked) && bag.counts[int(item.FURNACE)] == 1, "failed placement keeps the structure");
    expect(plan.ok && placement.placeInventory(&g.world, bag, 2, plan), "crafted furnace places through inventory path");
    expect(bag.counts[int(item.FURNACE)] == 0 && !placement.placeInventory(&g.world, bag, 2, plan), "placement consumes one and cannot reuse the preview");
    expect(interact.collectBlock(&g, Hit { ok: true, x: 86, y: 6, z: 62 }) && bag.counts[int(item.FURNACE)] == 0 && g.drops.count == 1, "breaking a machine part drops one complete structure");
    pickUp(&g);
    expect(bag.counts[int(item.FURNACE)] == 1 && g.drops.count == 0, "picking the drop up puts it in the inventory");
    inventory.swap(bag, 0, 35);
    expect(inventory.slotItem(bag, 35) == item.PICKAXE && inventory.slotItem(bag, 0) != item.PICKAXE, "pickaxe moves into the last inventory slot");
    for terrain in 0..3 {
        let id: u8 = block.STONE; if terrain == 1 { id = block.DIRT; } if terrain == 2 { id = block.GRASS; }
        world.set(&g.world, 85, 8, 70, id);
        expect(interact.collectBlock(&g, Hit { ok: true, x: 85, y: 8, z: 70 }), "terrain mining recovers a block");
        pickUp(&g);
        let recovered = item.fromBlock(id); let at = -1;
        for slot in 0..inventory.SLOTS { if inventory.slotItem(bag, slot) == recovered { at = slot; } }
        inventory.swap(bag, at, 2); g.player.slot = 2;
        let voxelPlan = placement.resolveInventory(&g.world, &g.player, bag, Hit { ok: true, x: 85, y: 3, z: 70, px: 85, py: 8, pz: 70 }, 0, false);
        expect(voxelPlan.ok && placement.placeInventory(&g.world, bag, 2, voxelPlan) && world.get(&g.world, 85, 8, 70) == id, "recovered terrain places as one voxel");
        world.breakAt(&g.world, 85, 8, 70);
    }
    expect(world.placeMachine(&g.world, 80, 4, 60, 0, block.MARKET), "sale restriction fixture");
    let queue = container.contents(&g.world, cell(80, 4, 60));
    inventory.add(&queue, item.COPPER, 2); inventory.add(&queue, item.DRILL, 1); inventory.add(&queue, item.PICKAXE, 1);
    expect(market.sell(&g.world, cell(80, 4, 60)) == 2 && queue.counts[int(item.DRILL)] == 1 && queue.counts[int(item.PICKAXE)] == 1, "market sells resources and preserves tools and structures");
    inventory.add(bag, item.STONE, inventory.CAPACITY);
    world.set(&g.world, 85, 8, 70, block.GRASS);
    expect(interact.collectBlock(&g, Hit { ok: true, x: 85, y: 8, z: 70 }) && world.get(&g.world, 85, 8, 70) == block.AIR, "a full inventory still breaks the block");
    pickUp(&g);
    expect(g.drops.count == 1, "with no room the drop stays on the ground");
    mem.destroy();
}


pub fn run() {
    report.suite("inventory grid"); inventoryGridChecks(); cursorChecks(); dropChecks();
    report.suite("build menu"); buildMenuChecks(); craftQueueChecks();
}
