module industry.checks.furnace;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use industry.machine.drills;
use industry.machine.furnace;
use industry.machine.container;
use industry.checks.fixture;
use industry.inventory;
use industry.placement;
use industry.player;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.machine.belts;
use industry.world;
use industry.world.World;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
const Furnace = @script("scripts/furnace.j3s");
const Drill = @script("scripts/drill.j3s");

fn furnaceChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let kiln = Furnace {};
    expect(world.placeMachine(&w, 80, 4, 60, conveyor.NORTH, block.FURNACE), "place test furnace");
    let at = cell(80, 4, 60);
    let incoming = cell(80, 4, 62);
    let outgoing = cell(80, 4, 58);
    expect(world.placeConveyor(&w, 80, 4, 62, conveyor.NORTH), "ground-level intake belt");
    expect(world.placeConveyor(&w, 80, 4, 58, conveyor.NORTH), "ground-level outlet belt");
    expect(belts.insert(&w, incoming, item.COPPER), "feed copper ore");
    belts.update(&w, 2);
    expect(w.belts[world.slotOf(&w, incoming)].count == 0 && w.kilns[world.slotOf(&w, at)].stock == 1, "ore queues at the intake port");
    kiln.update(&w, 5);
    expect(w.kilns[world.slotOf(&w, at)].item == 0 && w.belts[world.slotOf(&w, outgoing)].count == 0, "no coal, no smelting");
    expect(furnace.addCoal(&w, at), "coal can be added");
    kiln.update(&w, 0);
    expect(w.kilns[world.slotOf(&w, at)].item == item.COPPER && w.kilns[world.slotOf(&w, at)].fuel == 0 && w.kilns[world.slotOf(&w, at)].burn == 4 && w.kilns[world.slotOf(&w, at)].stock == 0,
        "a coal lights and covers five smelts");
    kiln.update(&w, 1.9);
    expect(w.belts[world.slotOf(&w, outgoing)].count == 0, "no ingot before two seconds");
    kiln.update(&w, 0.1);
    expect(w.belts[world.slotOf(&w, outgoing)].count == 1 && w.belts[world.slotOf(&w, outgoing)].cargo[0] == item.COPPER_INGOT && w.kilns[world.slotOf(&w, at)].item == 0,
        "exactly one copper ingot at two seconds");
    for i in 0..12 { furnace.addCoal(&w, at); furnace.addOre(&w, at, item.COPPER); }
    expect(w.kilns[world.slotOf(&w, at)].fuel == 10 && w.kilns[world.slotOf(&w, at)].stock == 10, "coal and ore stores each hold ten");
    expect(!furnace.addOre(&w, at, item.COPPER_INGOT) && !furnace.addOre(&w, at, item.COAL), "only smeltable ore queues");
    w.kilns[world.slotOf(&w, at)].stock = 5; w.kilns[world.slotOf(&w, at)].fuel = 1; w.kilns[world.slotOf(&w, at)].burn = 0;
    for i in 0..5 { furnace.start(&w, at); w.kilns[world.slotOf(&w, at)].item = 0; }
    expect(w.kilns[world.slotOf(&w, at)].stock == 0 && w.kilns[world.slotOf(&w, at)].fuel == 0 && w.kilns[world.slotOf(&w, at)].burn == 0, "one coal smelts exactly five items");
    w.kilns[world.slotOf(&w, at)].stock = 1;
    furnace.start(&w, at);
    expect(w.kilns[world.slotOf(&w, at)].item == 0 && w.kilns[world.slotOf(&w, at)].stock == 1, "out of coal the batch waits");
    let bagMem = Arena.create(1024);
    let bag = inventory.create(&bagMem);
    inventory.add(&bag, item.COAL, 2); inventory.add(&bag, item.COPPER, 2);
    w.kilns[world.slotOf(&w, at)].fuel = 0; w.kilns[world.slotOf(&w, at)].stock = 0;
    expect(furnace.deposit(&w, at, &bag, item.COAL, 1) == 1 && w.kilns[world.slotOf(&w, at)].fuel == 1 && bag.counts[int(item.COAL)] == 1, "the screen drops one coal in");
    expect(furnace.deposit(&w, at, &bag, item.COPPER, 5) == 2 && w.kilns[world.slotOf(&w, at)].stock == 2 && bag.counts[int(item.COPPER)] == 0, "it drops in all the ore the bag has");
    expect(furnace.withdraw(&w, at, &bag, furnace.PART_ORE, 1) == 1 && w.kilns[world.slotOf(&w, at)].stock == 1 && bag.counts[int(item.COPPER)] == 1, "ore comes back out");
    expect(furnace.withdraw(&w, at, &bag, furnace.PART_COAL, 9) == 1 && w.kilns[world.slotOf(&w, at)].fuel == 0, "coal comes back out");
    furnace.addCoal(&w, at);
    expect(furnace.take(&w, incoming, block.FURNACE, item.COAL) && w.kilns[world.slotOf(&w, at)].fuel == 2, "belts can deliver coal");
    w.kilns[world.slotOf(&w, at)].fuel = 0; w.kilns[world.slotOf(&w, at)].stock = 0; w.kilns[world.slotOf(&w, at)].burn = 0;
    world.breakAt(&w, 80, 4, 62);
    expect(world.placeConveyor(&w, 80, 5, 62, conveyor.NORTH), "raised input belt");
    let raised = cell(80, 5, 62);
    expect(belts.insert(&w, raised, item.COPPER), "raised belt cargo");
    belts.update(&w, 10);
    expect(w.belts[world.slotOf(&w, raised)].count == 1 && w.kilns[world.slotOf(&w, at)].stock == 0, "wrong-height input cannot enter furnace");
    world.breakAt(&w, 80, 5, 62);
    expect(world.placeConveyor(&w, 82, 4, 60, conveyor.WEST), "side input belt");
    let side = cell(82, 4, 60);
    expect(belts.insert(&w, side, item.COPPER), "side belt cargo");
    belts.update(&w, 10);
    expect(w.belts[world.slotOf(&w, side)].count == 1 && w.kilns[world.slotOf(&w, at)].stock == 0, "non-port side cannot enter furnace");
    world.breakAt(&w, 82, 4, 60);
    expect(world.placeConveyor(&w, 80, 4, 62, conveyor.SOUTH), "reversed intake belt");
    expect(!furnace.take(&w, incoming, block.FURNACE, item.COPPER), "reversed intake cannot feed furnace");
    world.breakAt(&w, 80, 4, 62);
    expect(world.placeConveyor(&w, 80, 4, 62, conveyor.NORTH), "restore intake");
    expect(!furnace.take(&w, incoming, block.FURNACE, item.COPPER_INGOT), "ingots are not smelted again");
    expect(furnace.take(&w, incoming, block.FURNACE, item.COPPER), "accept raw ore again");
    world.breakAt(&w, 80, 4, 58);
    expect(world.placeConveyor(&w, 80, 5, 58, conveyor.NORTH), "raised outlet belt");
    w.kilns[world.slotOf(&w, at)].fuel = 1;
    kiln.update(&w, 2);
    expect(w.kilns[world.slotOf(&w, at)].out == 1 && w.belts[world.slotOf(&w, cell(80, 5, 58))].count == 0, "wrong-height outlet cannot receive ingot, it waits in the output store");
    world.breakAt(&w, 80, 5, 58);
    expect(world.placeConveyor(&w, 80, 4, 58, conveyor.SOUTH), "reversed outlet belt");
    kiln.update(&w, 0);
    expect(w.kilns[world.slotOf(&w, at)].out == 1 && w.belts[world.slotOf(&w, outgoing)].count == 0, "outlet must face away from furnace");
    expect(furnace.withdraw(&w, at, &bag, furnace.PART_INGOT, 9) == 1 && bag.counts[int(item.COPPER_INGOT)] == 1 && w.kilns[world.slotOf(&w, at)].out == 0, "F collects the stored ingots");
    world.breakAt(&w, 81, 7, 61);
    expect(w.kilns[world.slotOf(&w, at)].item == 0 && w.kilns[world.slotOf(&w, at)].burn == 0 && w.kilns[world.slotOf(&w, at)].fuel == 0 && close(w.kilns[world.slotOf(&w, at)].clock, 0),
        "removal clears furnace batch, fuel and timer");
    mem.destroy();
}

fn furnaceDirections() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let kiln = Furnace {};
    for direction in 0..4 {
        let dir = u8(direction);
        let dx = int(conveyor.dx(dir)); let dz = int(conveyor.dz(dir));
        expect(world.placeMachine(&w, 80, 4, 60, dir, block.FURNACE), "rotated furnace");
        w.kilns[world.slotOf(&w, cell(80, 4, 60))].fuel = 1;
        expect(world.placeConveyor(&w, 80 - dx * 2, 4, 60 - dz * 2, dir), "rotated intake");
        expect(world.placeConveyor(&w, 80 + dx * 2, 4, 60 + dz * 2, dir), "rotated outlet");
        let input = cell(80 - dx * 2, 4, 60 - dz * 2);
        let output = cell(80 + dx * 2, 4, 60 + dz * 2);
        expect(belts.insert(&w, input, item.COPPER), "rotated intake cargo");
        belts.update(&w, 2);
        kiln.update(&w, 2);
        expect(w.belts[world.slotOf(&w, output)].count == 1 && w.belts[world.slotOf(&w, output)].cargo[0] == item.COPPER_INGOT,
            "ports and smelting work in each cardinal direction");
        world.breakAt(&w, 81, 7, 61);
        world.breakAt(&w, 80 - dx * 2, 4, 60 - dz * 2);
        world.breakAt(&w, 80 + dx * 2, 4, 60 + dz * 2);
    }
    mem.destroy();
}

// Items held anywhere in machine state: belt queues, drill buffers, furnace stock and batches.
fn units(w: &World): int {
    let total = 0;
    for slot in 1..w.slotHigh + 1 {
        total += w.belts[slot].count + w.drills[slot].count + w.kilns[slot].stock;
        if w.kilns[slot].item != 0 { total += 1; }
    }
    return total;
}

fn pipelineChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = fixture.playerAtStart();
    p.body.pos = Vec3.xyz(80, 8, 80);
    p.slot = 2;
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 5, z: 67 }, conveyor.NORTH)),
        "pipeline drill placement");
    p.slot = 1;
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 5, z: 69 }, conveyor.SOUTH)),
        "pipeline drill outlet belt");
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 5, z: 71 }, conveyor.SOUTH)),
        "pipeline furnace intake belt");
    p.slot = 3;
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 5, z: 73 }, conveyor.SOUTH)),
        "pipeline furnace placement at belt exit");
    p.slot = 1;
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 8, z: 75 }, conveyor.SOUTH)),
        "pipeline outgoing belt placement from upper furnace part");
    w.kilns[world.slotOf(&w, cell(72, 5, 74))].fuel = 10;
    let drill = Drill {}; let kiln = Furnace {};
    let step: f32 = 0.016666667;
    for tick in 0..740 {
        kiln.update(&w, step);
        belts.update(&w, step);
        drill.update(&w, step);
    }
    let output = cell(72, 5, 76);
    expect(w.belts[world.slotOf(&w, output)].count > 0 && w.belts[world.slotOf(&w, output)].cargo[0] == item.COPPER_INGOT,
        "player-built drill to conveyor to furnace pipeline produces copper ingot");
    expect(units(&w) == 3, "three mined units remain conserved across belts and furnace");
    p.slot = 4;
    expect(placement.place(&w, placement.resolve(&w, &p, Hit { ok: true, x: 73, y: 5, z: 77 }, conveyor.SOUTH)),
        "container snaps to outgoing belt");
    for tick in 0..180 { kiln.update(&w, step); belts.update(&w, step); }
    let stored = container.contents(&w, cell(72, 5, 78));
    expect(stored.counts[int(item.COPPER_INGOT)] > 0, "live drill-furnace pipeline stores ingots");
    expect(inventory.total(&stored) + units(&w) == 3, "storage preserves all three mined units");

    mem.destroy();
}


pub fn run() {
    report.suite("furnace"); furnaceChecks();
    report.suite("furnace directions"); furnaceDirections();
    report.suite("pipeline"); pipelineChecks();
}
