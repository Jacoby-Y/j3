module industry.checks.container;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use industry.machine.container;
use industry.checks.fixture;
use industry.inventory;
use industry.placement;
use industry.player;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.machine.belts;
use industry.world;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn containerChecks() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let carried = inventory.create(&mem);
    for direction in 0..4 {
        let dir = u8(direction);
        let dx = int(conveyor.dx(dir)); let dz = int(conveyor.dz(dir));
        expect(world.placeMachine(&w, 80, 4, 60, dir, block.CONTAINER), "place rotated container");
        let at = cell(80, 4, 60);
        let bag = container.contents(&w, at);
        let occupied = 0;
        for y in 4..7 { for z in 60..62 { for x in 80..82 {
            if world.get(&w, x, y, z) == block.CONTAINER { occupied += 1; }
            expect(world.anchorAt(&w, x, y, z) == at, "every container part resolves its storage anchor");
        } } }
        expect(occupied == 12 && world.height(block.CONTAINER) == 3, "container occupies 2x2x3");
        let x = 80 - dx * 2; let z = 60 - dz * 2;
        expect(world.placeConveyor(&w, x, 4, z, dir), "container intake belt");
        let belt = cell(x, 4, z);
        expect(belts.insert(&w, belt, item.COPPER_INGOT), "container incoming ingot");
        belts.update(&w, 2);
        expect(w.belts[world.slotOf(&w, belt)].count == 0 && bag.counts[int(item.COPPER_INGOT)] == 1,
            "conveyor deposits one unchanged ingot in each container orientation");
        expect(!container.take(&w, belt, 0) && !container.take(&w, belt, 255), "storage rejects invalid item ids");
        expect(inventory.move(&bag, &carried, item.COPPER_INGOT, 10) == 1, "take-all clamps to available stock");
        expect(inventory.move(&carried, &bag, item.COPPER_INGOT, 1) == 1, "put item back into container");
        world.breakAt(&w, 81, 6, 61);
        world.set(&w, 81, 6, 61, block.STONE);
        expect(container.valid(&w, at) && bag.counts[int(item.COPPER_INGOT)] == 1,
            "nonempty storage cannot be removed or overwritten");
        expect(inventory.add(&bag, item.COPPER, 999) == 255, "container total capacity shared by item types");
        expect(belts.insert(&w, belt, item.COPPER), "full storage input");
        belts.update(&w, 2);
        expect(w.belts[world.slotOf(&w, belt)].count == 1 && inventory.total(&bag) == 256, "full container keeps incoming cargo on belt");
        expect(inventory.add(&carried, item.STONE, 254) == 254, "fill player inventory nearly full");
        expect(inventory.move(&bag, &carried, item.COPPER, 255) == 2,
            "partial withdrawal preserves leftover stock when player inventory fills");
        expect(inventory.move(&bag, &carried, item.COPPER_INGOT, 1) == 0, "full player inventory refuses withdrawal");
        belts.update(&w, 0);
        expect(w.belts[world.slotOf(&w, belt)].count == 0 && bag.counts[int(item.COPPER)] == 254,
            "taking items frees space and resumes conveyor intake");
        carried.counts[int(item.STONE)] = 0;
        expect(inventory.move(&bag, &carried, item.COPPER, 999) == 254, "take remaining copper without loss");
        expect(inventory.move(&bag, &carried, item.COPPER_INGOT, 1) == 0, "combined player inventory remains bounded");
        carried.counts[int(item.COPPER)] = 0;
        expect(inventory.move(&bag, &carried, item.COPPER_INGOT, 1) == 1, "empty container completely");
        carried.counts[int(item.COPPER_INGOT)] = 0;
        world.breakAt(&w, x, 4, z);
        expect(world.placeConveyor(&w, x, 5, z, dir), "raised storage intake");
        let raised = cell(x, 5, z);
        expect(belts.insert(&w, raised, item.COPPER), "raised intake cargo");
        belts.update(&w, 2);
        expect(w.belts[world.slotOf(&w, raised)].count == 1 && inventory.total(&bag) == 0, "wrong-height belt cannot feed storage");
        world.breakAt(&w, x, 5, z);
        let sideX = 80 + dz * 2; let sideZ = 60 - dx * 2;
        expect(world.placeConveyor(&w, sideX, 4, sideZ, u8((direction + 1) % 4)), "side storage belt");
        expect(container.take(&w, cell(sideX, 4, sideZ), item.COPPER), "side intake works regardless of container rotation");
        expect(inventory.move(&bag, &carried, item.COPPER, 1) == 1, "take side-delivered cargo");
        carried.counts[int(item.COPPER)] = 0;
        world.breakAt(&w, sideX, 4, sideZ);
        for feed in 0..4 {
            let feedDir = u8(feed);
            let feedX = 80 - int(conveyor.dx(feedDir)) * 2;
            let feedZ = 60 - int(conveyor.dz(feedDir)) * 2;
            expect(world.placeConveyor(&w, feedX, 4, feedZ, feedDir), "feed container from each side");
            expect(belts.insert(&w, cell(feedX, 4, feedZ), item.COPPER), "four-side incoming cargo");
        }
        belts.update(&w, 2);
        expect(bag.counts[int(item.COPPER)] == 4, "all four simultaneous feeds deposit without loss in every rotation");
        for removeSide in 0..4 {
            let removeDir = u8(removeSide);
            world.breakAt(&w,80 - int(conveyor.dx(removeDir)) * 2,4,60 - int(conveyor.dz(removeDir)) * 2);
        }
        inventory.move(&bag,&carried,item.COPPER,4);
        carried.counts[int(item.COPPER)] = 0;

        world.breakAt(&w, 81, 6, 61);
        expect(world.get(&w, 80, 4, 60) == block.AIR && !container.valid(&w, at),
            "empty container removes all parts and releases storage");
    }
    expect(world.placeMachine(&w, 80, 4, 60, 0, block.CONTAINER), "fresh replacement container");
    let fresh = container.contents(&w, cell(80, 4, 60));
    expect(inventory.total(&fresh) == 0, "replacement starts with empty storage");
    expect(world.placeMachine(&w, 84, 4, 60, 0, block.CONTAINER), "second independent container");
    let other = container.contents(&w, cell(84, 4, 60));
    inventory.add(&fresh, item.COPPER, 3);
    expect(inventory.total(&other) == 0, "containers keep independent inventories");
    let p = fixture.playerAtStart(); p.body.pos = Vec3.xyz(90, 8, 80); p.slot = 4;
    inventory.add(&carried, item.CONTAINER, 1); inventory.swap(&carried, 0, 4);
    let plan = placement.resolveInventory(&w, &p, &carried, Hit { ok: true, x: 88, y: 3, z: 70 }, conveyor.WEST, false);
    expect(plan.ok && plan.id == block.CONTAINER && placement.placeInventory(&w, &carried, 4, plan), "inventory slot places storage");
    expect(inventory.total(&carried) == 0, "placing storage consumes one structure");
    mem.destroy();
}


pub fn run() { report.suite("containers"); containerChecks(); }
