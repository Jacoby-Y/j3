// File loading and icon checks; no OpenGL context is needed.
module industry.checks.model_asset;
use industry.checks.report.{ expect };
use j3.memory.Arena;
use j3.math.Vec3;
use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode };
use industry.j3voxel;
use industry.subvoxels;
use industry.model_icons;
use industry.pickaxe;
use industry.data.defs;
use industry.data.item;


fn invalidRecord(src: string, mem: &Arena) {
    let v = j3voxel.parse(src as []u8, mem);
    expect(v.sx == 0, "malformed voxel records are rejected");
}

fn parserChecks(mem: &Arena) {
    let src = "# j3voxel 1\nname sample\nsize 3 1 1\np 1 334047\np 2 ff0000 red\np 255 00FF00 longname\nv 0 0 0 1\nv 1 0 0 2\nv 2 0 0 255\n";
    let v = j3voxel.parse(src as []u8, mem);
    expect(v.sx == 3 && v.cells[0] == 1 && v.cells[1] == 2 && v.cells[2] == 255,
        "unnamed and named palette entries load, including index 255");
    expect(v.pal[3] == 51 && v.pal[4] == 64 && v.pal[5] == 71 && v.pal[6] == 255 && v.pal[766] == 255,
        "palette RGB bytes survive optional names and uppercase hex");
    expect(!subvoxels.usable(&v), "cropped canvas cannot shift an industry model origin");
    let runSrc = "size 24 32 24\nv 4 0 4 1 16\np 1 000000\n";
    let run = j3voxel.parse(runSrc as []u8, mem);
    expect(subvoxels.usable(&run) && j3voxel.at(&run, 4, 0, 4) == 1 && j3voxel.at(&run, 19, 0, 4) == 1 &&
        j3voxel.at(&run, 20, 0, 4) == 0, "runs and a later black palette entry load correctly");
    let emptySrc = "size 24 32 24\n";
    let empty = j3voxel.parse(emptySrc as []u8, mem);
    expect(!subvoxels.usable(&empty), "empty assets cannot silently create invisible models");
    let missing = j3voxel.load("assets/models/__missing_model__.j3voxel", mem);
    expect(missing.sx == 0 && !subvoxels.usable(&missing), "missing asset fails validation");
    invalidRecord("size 65 1 1\n", mem);
    invalidRecord("size 1 0 1\n", mem);
    invalidRecord("size 1 1 1\np 1 ff00zz red\nv 0 0 0 1\n", mem);
    invalidRecord("size 1 1 1\np 1 fffff\nv 0 0 0 1\n", mem);
    invalidRecord("size 1 1 1\nv 0 0 0 1\n", mem);
    invalidRecord("size 1 1 1\np 1 ffffff\nv -1 0 0 1\n", mem);
    invalidRecord("size 1 1 1\np 1 ffffff\nv 0 0 0 256\n", mem);
    invalidRecord("size 1 1 1\np 1 ffffff\nv 0 0 0 1 2\n", mem);
    invalidRecord("size 1 1 1\np 1 ffffff\nv 0 0 0 1 0\n", mem);
}

fn iconChecks() {
    for id in 1..item.kinds() {
        let def = defs.itemInfo(u8(id));
        if def.icon.len == 0 { continue; }
        let mem = Arena.create(1024);
        let c = Canvas.create(&mem, 48, 48, Mode.Pixel);
        c.clear(canvas.rgba(0, 0, 0, 0));
        model_icons.sprite(&c, 0, u8(id), &mem);
        let painted = 0;
        for y in 0..48 { for x in 0..48 {
            let alpha = c.pixels[(x + y * 48) * 4 + 3];
            if alpha != 0 {
                painted += 1;
                expect(x >= 5 && x < 43 && y >= 5 && y < 43,
                    "model icons fit their atlas cell without clipping or bleeding");
            }
        } }
        expect(painted > 100, "each model-backed item has a readable icon");
        mem.destroy();
    }
}

fn pickaxeChecks() {
    let mem = Arena.create(1024);
    let c = Canvas.create(&mem, 64, 64, Mode.Pixel);
    c.clear(canvas.rgba(0, 0, 0, 0));
    pickaxe.sprite(&c);
    let g = pickaxe.model(&mem);
    for y in 0..16 { for x in 0..16 {
        expect((c.pixels[(x * 4 + (15 - y) * 4 * 64) * 4 + 3] != 0) ==
            subvoxels.occupied(&g, x - 8, y, 0), "pickaxe icon uses the loaded silhouette");
    } }
    mem.destroy();
}

fn projectionChecks() {
    let mem = Arena.create(1024);
    let c = Canvas.create(&mem, 48, 48, Mode.Pixel);
    c.clear(canvas.rgba(0, 0, 0, 0));
    let cube = subvoxels.create(&mem);
    subvoxels.box(&cube, Vec3.xyz(1, 1, 1), 0, 0, 0, 8, 8, 8);
    model_icons.paint(&c, 0, subvoxels.vertices(&cube), &mem);
    expect(c.pixels[(24 + 15 * 48) * 4] == 255, "isometric cube has a fully lit top");
    expect(c.pixels[(16 + 28 * 48) * 4] == 219 && c.pixels[(32 + 28 * 48) * 4] == 173,
        "visible side faces match the projection without back faces painting over them");
    mem.destroy();
}

pub fn run() {
    let mem = Arena.create(1024);
    parserChecks(&mem);
    mem.destroy();
    iconChecks();
    projectionChecks();
    pickaxeChecks();
}
