module industry.checks.logistics;

use j3.memory.Arena;
use industry.checks.fixture;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
use industry.chunks;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.inventory;
use industry.machine.belts;
use industry.world;
use industry.world.World;

fn speed(w: &World) {
    expect(world.placeMachine(w, 60, 8, 70, conveyor.EAST, block.CONVEYOR), "basic belt");
    expect(world.placeMachine(w, 60, 8, 74, conveyor.EAST, block.CONVEYOR_MK2), "mk2 belt");
    belts.insert(w, cell(60, 8, 70), item.COPPER); belts.insert(w, cell(60, 8, 74), item.COPPER);
    belts.update(w, 0.1);
    let basic = w.belts[world.slotOf(w, cell(60, 8, 70))].progress[0];
    expect(close(w.belts[world.slotOf(w, cell(60, 8, 74))].progress[0], basic * 3), "mk2 belt carries three times as fast");
}

fn tick(w: &World, steps: int) { for step in 0..steps { belts.update(w, 0.05); } }

fn count(w: &World, x: int, y: int, z: int): int { return w.belts[world.slotOf(w, cell(x, y, z))].count; }

fn splitter(w: &World) {
    expect(world.placeMachine(w, 70, 8, 70, conveyor.EAST, block.CONVEYOR), "splitter input");
    expect(world.placeMachine(w, 72, 8, 70, conveyor.EAST, block.SPLITTER), "splitter");
    expect(world.placeMachine(w, 74, 8, 70, conveyor.EAST, block.CONVEYOR), "front output");
    expect(world.placeMachine(w, 72, 8, 68, conveyor.NORTH, block.CONVEYOR), "left output");
    expect(world.placeMachine(w, 72, 8, 72, conveyor.SOUTH, block.CONVEYOR), "right output");
    for round in 0..3 {
        expect(belts.insert(w, cell(70, 8, 70), item.COPPER), "feed splitter");
        tick(w, 120);
    }
    expect(count(w, 74, 8, 70) == 1 && count(w, 72, 8, 68) == 1 && count(w, 72, 8, 72) == 1, "splitter shares across its three exits");
    expect(count(w, 70, 8, 70) == 0, "nothing goes back out the input");
    expect(belts.insert(w, cell(70, 8, 70), item.COPPER), "feed a fourth item");
    tick(w, 120);
    expect(count(w, 72, 8, 68) == 2 && count(w, 74, 8, 70) == 1 && count(w, 72, 8, 72) == 1, "the rotation comes back round to the first exit");
}

fn lifter(w: &World) {
    expect(world.placeMachine(w, 80, 8, 70, conveyor.EAST, block.LIFTER_MK2), "lifter");
    expect(world.placeMachine(w, 80, 9, 70, conveyor.EAST, block.CONVEYOR), "belt on top of the lifter");
    belts.insert(w, cell(80, 8, 70), item.IRON);
    tick(w, 40);
    expect(count(w, 80, 8, 70) == 0 && count(w, 80, 9, 70) == 1, "lifter hands cargo to the belt above");
}

fn merging(w: &World) {
    expect(world.placeMachine(w, 80, 8, 74, conveyor.EAST, block.LIFTER), "lifter to merge from");
    expect(world.placeMachine(w, 80, 9, 74, conveyor.EAST, block.CONVEYOR), "belt above it");
    belts.insert(w, cell(80, 8, 74), item.COAL);
    tick(w, 60);
    let top = world.slotOf(w, cell(80, 9, 74));
    expect(w.belts[top].count == 1 && w.belts[top].progress[0] >= 1, "lifted cargo enters the belt above at its centre");

    expect(world.placeMachine(w, 90, 8, 70, conveyor.EAST, block.CONVEYOR), "belt to merge into");
    let slot = world.slotOf(w, cell(90, 8, 70));
    belts.insert(w, cell(90, 8, 70), item.COPPER);
    belts.update(w, 0.7);
    expect(!belts.insertFrom(w, cell(90, 8, 70), item.COPPER, conveyor.SOUTH), "side entry keeps a wider gap than the rear lane");
    belts.update(w, 0.3);
    expect(belts.insertFrom(w, cell(90, 8, 70), item.COPPER, conveyor.SOUTH) && w.belts[slot].count == 2, "side entry joins once there is room");
}

fn lowerer(w: &World) {
    expect(world.placeMachine(w, 110, 8, 70, conveyor.EAST, block.CONVEYOR), "belt under the lowerer");
    expect(world.placeMachine(w, 110, 9, 70, conveyor.EAST, block.LOWERER_MK2), "lowerer");
    belts.insert(w, cell(110, 9, 70), item.IRON);
    tick(w, 40);
    expect(count(w, 110, 9, 70) == 0 && count(w, 110, 8, 70) == 1, "lowerer hands cargo to the belt below");
}

fn skipsRefusal(w: &World) {
    expect(world.placeMachine(w, 100, 8, 70, conveyor.EAST, block.CONVEYOR), "feed belt");
    expect(world.placeMachine(w, 102, 8, 70, conveyor.EAST, block.SPLITTER), "splitter");
    expect(world.placeMachine(w, 104, 8, 70, conveyor.EAST, block.CONVEYOR), "front exit");
    expect(world.placeMachine(w, 102, 8, 68, conveyor.NORTH, block.CONVEYOR), "left exit");
    expect(world.placeMachine(w, 102, 8, 72, conveyor.SOUTH, block.CONVEYOR), "right exit");
    for fill in 0..4 { belts.insert(w, cell(104, 8, 70), item.COPPER); tick(w, 20); }
    for round in 0..3 { belts.insert(w, cell(100, 8, 70), item.COPPER); tick(w, 120); }
    expect(count(w, 104, 8, 70) == 4 && count(w, 102, 8, 68) + count(w, 102, 8, 72) == 3, "a full exit is skipped, not waited on");
}

fn offsetBelt(w: &World) {
    expect(world.placeMachine(w, 130, 8, 70, conveyor.EAST, block.CONVEYOR), "belt feeding an offset belt");
    expect(world.placeMachine(w, 132, 8, 71, conveyor.EAST, block.CONVEYOR), "belt half a width to the side");
    belts.insert(w, cell(130, 8, 70), item.COPPER); tick(w, 80);
    expect(count(w, 132, 8, 71) == 1, "an item crosses onto a belt offset by one voxel");
}

fn tierSwap(w: &World) {
    expect(world.placeMachine(w, 150, 8, 70, conveyor.EAST, block.CONVEYOR), "belt to upgrade");
    belts.insert(w, cell(150, 8, 70), item.COPPER);
    expect(world.swapMachine(w, cell(150, 8, 70), block.CONVEYOR_MK2) && w.cells[cell(151, 8, 71)] == block.CONVEYOR_MK2 &&
        count(w, 150, 8, 70) == 1, "swapping a belt tier keeps its cargo");
    expect(!world.swapMachine(w, cell(150, 8, 70), block.SPLITTER_MK2), "only the twin tier swaps in");
}

fn retargets(w: &World) {
    expect(world.placeMachine(w, 140, 8, 70, conveyor.EAST, block.CONVEYOR), "feed belt");
    expect(world.placeMachine(w, 142, 8, 70, conveyor.EAST, block.SPLITTER), "splitter");
    expect(world.placeMachine(w, 144, 8, 70, conveyor.EAST, block.CONVEYOR), "front exit");
    for fill in 0..3 { belts.insert(w, cell(144, 8, 70), item.COPPER); tick(w, 20); }
    belts.insert(w, cell(140, 8, 70), item.COPPER);
    let slot = world.slotOf(w, cell(142, 8, 70));
    let guard = 0;
    while w.belts[slot].count == 0 || w.belts[slot].leave[0] == belts.UNDECIDED { tick(w, 1); guard += 1; if guard > 400 { break; } }
    belts.insert(w, cell(144, 8, 70), item.COPPER);
    expect(world.placeMachine(w, 142, 8, 72, conveyor.SOUTH, block.CONVEYOR), "side exit added later");
    tick(w, 120);
    expect(count(w, 142, 8, 72) == 1, "a splitter whose chosen exit filled up picks another");
}

fn iron() {
    let mem = Arena.create(1024);
    let w = world.createSeed(&mem, 3);
    chunks.unlock(&w, world.CENTER, world.CENTER);
    chunks.unlock(&w, world.CENTER + 1, world.CENTER);
    chunks.unlock(&w, world.CENTER + 2, world.CENTER);
    let near = 0; let far = 0;
    for ring in 1..3 {
        let base = (world.CENTER + ring) * world.CHUNK;
        for y in 0..world.SY { for z in 0..world.CHUNK { for x in 0..world.CHUNK {
            let id = world.get(&w, base + x, y, z + world.CENTER * world.CHUNK);
            if id == block.IRON_NODE || id == block.IRON_ORE {
                if ring == 1 { near += 1; } else { far += 1; }
            }
        } } }
    }
    expect(near == 0, "no iron in the first ring");
    expect(far > 0, "iron nodes and veins in the second ring");
    mem.destroy();
}

fn recipes() {
    let mem = Arena.create(1024);
    let bag = inventory.create(&mem);
    inventory.add(&bag, item.COPPER_INGOT, 5);
    expect(!inventory.canCraft(&bag, item.CONVEYOR_MK2), "mk2 belt needs iron ingots");
    inventory.add(&bag, item.IRON_INGOT, 1);
    expect(inventory.craft(&bag, item.CONVEYOR_MK2) && bag.counts[int(item.IRON_INGOT)] == 0, "mk2 belt costs an iron ingot");
    mem.destroy();
}

pub fn run() {
    report.suite("logistics");
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    for cz in 0..world.CHUNKS { for cx in 0..world.CHUNKS { fixture.unlock(&w, cx, cz); } }
    speed(&w); splitter(&w); lifter(&w); merging(&w); lowerer(&w); skipsRefusal(&w); offsetBelt(&w); retargets(&w); tierSwap(&w);
    mem.destroy();
    iron(); recipes();
}
