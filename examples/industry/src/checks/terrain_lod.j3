// Compare rectangle coverage against detailed voxel faces, including holes and seams.
module industry.checks.terrain_lod;
use industry.checks.report.{ expect };
use j3.memory.Arena;
use j3.math;
use j3.math.Vec3;
use j3.gfx;
use industry.terrain_mesh;
use industry.terrain_lod;
use industry.render;
use industry.mesher;
use industry.data.block;
use industry.data.defs;
use industry.world;
use industry.world.World;


fn selectChecks() {
    let size = f32(world.CHUNK) * world.VOXEL;
    expect(terrain_lod.level(0, 0, Vec3.xyz(12, 50, 12), 1) == 0, "near camera uses detail");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 28, 0, 12), 0) == 0, "detail retained in hysteresis band");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 28, 0, 12), 1) == 1, "merged retained in hysteresis band");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 32, 0, 12), 0) == 0, "detail exit threshold inclusive");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 32.01, 0, 12), 0) == 1, "far camera uses merged mesh");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 24, 0, 12), 1) == 1, "merged entry threshold exclusive");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 23.99, 0, 12), 1) == 0, "approaching camera restores detail");
    expect(terrain_lod.level(0, 0, Vec3.xyz(size + 23, -20, size + 23), 0) == 1, "diagonal distance includes both axes");
    expect(terrain_lod.level(0, 0, Vec3.xyz(12, -20, 12), 1) == 0, "underground camera keeps its chunk detailed");
}

fn mark(w: &World, out: []u8, x0: int, z0: int, x: int, y: int, z: int, face: int, color: Vec3, checkColor: bool) {
    expect(x >= x0 && x < x0 + world.CHUNK && z >= z0 && z < z0 + world.CHUNK && y >= 0 && y < world.SY,
        "merged face stays within its source chunk");
    let index = ((face * world.SY + y) * world.CHUNK + z - z0) * world.CHUNK + x - x0;
    expect(out[index] == 0, "rectangle faces never overlap"); out[index] = 1;
    if checkColor {
        let expected = block.color(world.get(w, x, y, z));
        expect(color.x == expected.x && color.y == expected.y && color.z == expected.z, "rectangles preserve material boundaries");
    }
}

fn coverage(w: &World, count: int, out: []u8, cx: int, cz: int, checkColor: bool) {
    let x0 = cx * world.CHUNK; let z0 = cz * world.CHUNK;
    let at = 0;
    while at < count {
        let lo = Vec3.xyz(w.scratch[at], w.scratch[at + 1], w.scratch[at + 2]); let hi = lo;
        let normal = Vec3.xyz(w.scratch[at + 3], w.scratch[at + 4], w.scratch[at + 5]);
        let color = Vec3.xyz(w.scratch[at + 6], w.scratch[at + 7], w.scratch[at + 8]);
        for vertex in 0..6 {
            let p = at + vertex * 10;
            lo.x = math.min(lo.x, w.scratch[p]); hi.x = math.max(hi.x, w.scratch[p]);
            lo.y = math.min(lo.y, w.scratch[p + 1]); hi.y = math.max(hi.y, w.scratch[p + 1]);
            lo.z = math.min(lo.z, w.scratch[p + 2]); hi.z = math.max(hi.z, w.scratch[p + 2]);
        }
        for triangle in 0..2 {
            let offset = at + triangle * 30;
            let a = Vec3.xyz(w.scratch[offset], w.scratch[offset + 1], w.scratch[offset + 2]);
            let b = Vec3.xyz(w.scratch[offset + 10], w.scratch[offset + 11], w.scratch[offset + 12]);
            let c = Vec3.xyz(w.scratch[offset + 20], w.scratch[offset + 21], w.scratch[offset + 22]);
            expect((b - a).cross(c - a).dot(normal) > 0, "face winding and normals retained");
        }
        if normal.x != 0 {
            let face = gfx.FACE_NX; let x = int(lo.x); if normal.x > 0 { face = gfx.FACE_PX; x -= 1; }
            for y in int(lo.y)..int(hi.y) { for z in int(lo.z)..int(hi.z) { mark(w, out, x0, z0, x, y, z, face, color, checkColor); } }
        } else if normal.y != 0 {
            let yface = gfx.FACE_NY; let by = int(lo.y); if normal.y > 0 { yface = gfx.FACE_PY; by -= 1; }
            for bx in int(lo.x)..int(hi.x) { for bz in int(lo.z)..int(hi.z) { mark(w, out, x0, z0, bx, by, bz, yface, color, checkColor); } }
        } else {
            let zface = gfx.FACE_NZ; let az = int(lo.z); if normal.z > 0 { zface = gfx.FACE_PZ; az -= 1; }
            for ax in int(lo.x)..int(hi.x) { for ay in int(lo.y)..int(hi.y) { mark(w, out, x0, z0, ax, ay, az, zface, color, checkColor); } }
        }
        at += 60;
    }
}

fn clearDirty(w: &World) {
    for i in 0..w.sectionDirty.len { w.sectionDirty[i] = 0; }
    for c in 0..w.chunkDirty.len { w.chunkDirty[c] = 0; }
}

fn dirtyCount(w: &World): int {
    let count = 0; for i in 0..w.sectionDirty.len { if w.sectionDirty[i] != 0 { count += 1; } }
    return count;
}

fn sectionChecks(w: &World, cx: int, cz: int, mem: &Arena) {
    let x = cx * world.CHUNK; let z = cz * world.CHUNK;
    clearDirty(w); world.set(w, x + 12, 30, z + 12, block.STONE);
    expect(dirtyCount(w) == 1, "interior voxel edit dirties one section");
    clearDirty(w); world.set(w, x + 23, 31, z + 23, block.STONE);
    expect(dirtyCount(w) == 8, "section corner dirties eight face and AO neighbors");
    clearDirty(w);
    expect(world.placeMachine(w, x + 23, 15, z + 23, 0, block.FURNACE), "machine across three section boundaries");
    expect(dirtyCount(w) == 8, "complete machine footprint invalidates all affected vertical sections");
    clearDirty(w); world.breakAt(w, x + 24, 18, z + 24);
    expect(dirtyCount(w) == 8, "upper machine removal invalidates its complete footprint");
    clearDirty(w); world.set(w, x + 12, world.SY - 1, z + 12, block.COAL_ORE);
    expect(dirtyCount(w) == 1, "short top section remains bounded");
    clearDirty(w); world.dirtyChunk(w, cx, cz);
    expect(dirtyCount(w) == world.SECTIONS_Y * 4, "unlock invalidates every section of a chunk");
    clearDirty(w); world.dirtyGeneratedChunk(w, cx, cz);
    expect(dirtyCount(w) == world.SECTIONS_Y * 16, "unlock invalidates adjoining sections but not entire neighboring chunks");
    expect(w.sectionDirty[world.sectionIndex(cx * 2 + 3, 0, cz * 2)] == 0, "far side of neighboring chunk keeps cached mesh");
    render.trackSection(w, 1, true); render.trackSection(w, 2, true); render.trackSection(w, 1, true);
    expect(w.sectionCount == 2, "nonempty sections enter draw list once");
    render.trackSection(w, 1, false);
    expect(w.sectionCount == 1 && w.activeSections[0] == 2 && w.sectionSlots[2] == 1, "empty rebuild removes section and repairs moved slot");
    render.trackSection(w, 2, false); render.trackSection(w, 1, true);
    expect(w.sectionCount == 1 && w.activeSections[0] == 1, "edited empty sections can reenter draw list");
    render.trackSection(w, 1, false);
    for yy in 15..18 { for zz in z + 23..z + 26 { for xx in x + 23..x + 26 {
        world.set(w, xx, yy, zz, block.STONE);
    } } }
    world.set(w, x + 24, 16, z + 24, block.AIR);
    let entries = 6 * world.CHUNK * world.SY * world.CHUNK;
    let reference = mem.alloc::<u8>(entries); let detail = mem.alloc::<u8>(entries); let merged = mem.alloc::<u8>(entries);
    let count = terrain_mesh.detailed(w, cx, cz);
    let original = mem.alloc::<f32>(count); for value in 0..count { original[value] = w.scratch[value]; }
    coverage(w, count, reference, cx, cz, false);
    for sy in 0..world.SECTIONS_Y { for dz in 0..2 { for dx in 0..2 {
        let section = world.sectionIndex(cx * 2 + dx, sy, cz * 2 + dz); let region = mesher.sectionRegion(section);
        expect(region.y1 <= world.SY, "top section clips to world height");
        let detailedCount = terrain_mesh.detailedRegion(w, region); coverage(w, detailedCount, detail, cx, cz, false);
        for face in 0..detailedCount / 60 {
            let at = face * 60; let found = false;
            for oldFace in 0..count / 60 {
                let old = oldFace * 60;
                if original[old] != w.scratch[at] || original[old + 1] != w.scratch[at + 1] || original[old + 2] != w.scratch[at + 2] ||
                    original[old + 3] != w.scratch[at + 3] || original[old + 4] != w.scratch[at + 4] || original[old + 5] != w.scratch[at + 5] { continue; }
                let matches = true;
                for component in 0..60 { if original[old + component] != w.scratch[at + component] { matches = false; } }
                if matches { found = true; break; }
            }
            expect(found, "section faces preserve exact detailed color, winding, and AO");
        }
        let mergedCount = terrain_mesh.mergedRegion(w, region); coverage(w, mergedCount, merged, cx, cz, true);
        render.storeSection(w, section, w.scratch, mergedCount);
    } } }
    for i in 0..entries { expect(reference[i] == detail[i] && reference[i] == merged[i], "sections preserve holes, seams, and exposed faces"); }
    let batched = mem.alloc::<u8>(entries);
    let batchedCount = render.shadowVertices(w, cx, cz); coverage(w, batchedCount, batched, cx, cz, true);
    for batchCell in 0..entries { expect(reference[batchCell] == batched[batchCell], "batched shadows retain every section face and hole"); }
    // Patch just one section, then combine the unchanged cached neighbors again.
    world.set(w, x + 25, 17, z + 25, block.AIR);
    let edited = world.sectionIndex(cx * 2 + 1, 1, cz * 2 + 1);
    let editedCount = terrain_mesh.mergedRegion(w, mesher.sectionRegion(edited)); render.storeSection(w, edited, w.scratch, editedCount);
    for clear in 0..entries { reference[clear] = 0; batched[clear] = 0; }
    let freshCount = terrain_mesh.detailed(w, cx, cz); coverage(w, freshCount, reference, cx, cz, false);
    let patched = render.shadowVertices(w, cx, cz); coverage(w, patched, batched, cx, cz, true);
    for patchedCell in 0..entries { expect(reference[patchedCell] == batched[patchedCell], "edited shadow batch replaces only changed section geometry"); }
    for releaseY in 0..world.SECTIONS_Y { for releaseZ in 0..2 { for releaseX in 0..2 {
        render.storeSection(w, world.sectionIndex(cx * 2 + releaseX, releaseY, cz * 2 + releaseZ), w.scratch, 0);
    } } }
    expect(render.shadowVertices(w, cx, cz) == 0, "empty cache releases all batched geometry");
    let chunk = cx + cz * world.CHUNKS; w.chunkSectionCount[chunk] = 4; w.chunkVisibleCount[chunk] = 4; w.chunkDirty[chunk] = 0;
    expect(render.shadowBatch(w, chunk), "fully visible shadow sections may batch");
    w.chunkVisibleCount[chunk] = 3; expect(!render.shadowBatch(w, chunk), "partly visible chunks retain individual section culling");
    w.chunkVisibleCount[chunk] = 0; expect(!render.shadowBatch(w, chunk), "hidden chunks submit no shadow batch");
    expect(w.batchStart[defs.modelCount()] == w.drawMatrices.len, "instance buffer bounds cover maximum machine and cargo batches");
}

fn waitFor(): int {
    let slot = -1; let spins = 0;
    while slot < 0 && spins < 200000000 { slot = mesher.collect(); spins += 1; }
    expect(slot >= 0, "a worker reports every mesh job");
    return slot;
}

// A worker builds the same mesh as inline meshing, and an edit made while it runs marks its result stale.
fn workerChecks(w: &World, cx: int, cz: int) {
    mesher.start();
    let section = world.sectionIndex(cx * 2, 0, cz * 2);
    let inline = terrain_mesh.detailedRegion(w, mesher.sectionRegion(section));
    expect(mesher.dispatch(w, section) && w.sectionBusy[section] == 1, "a dirty section is handed to a worker");
    let slot = waitFor(); let job = mesher.job(slot);
    expect(job.section == section && job.count == inline && job.version == w.sectionVersion[section], "worker mesh matches inline mesh");
    mesher.release(slot); w.sectionBusy[section] = 0;
    expect(mesher.dispatch(w, section), "released slot takes the next job");
    world.set(w, cx * world.CHUNK + 5, 5, cz * world.CHUNK + 5, block.STONE);
    slot = waitFor(); job = mesher.job(slot);
    expect(job.version != w.sectionVersion[section], "edit during a job makes its result stale");
    mesher.release(slot); w.sectionBusy[section] = 0;
}

pub fn run() {
    selectChecks();
    let mem = Arena.create(1024); let w = world.create(&mem);
    let cx = world.CENTER; let cz = world.CENTER;
    w.unlocked[cx + cz * world.CHUNKS] = 1; w.unlocked[cx + 1 + cz * world.CHUNKS] = 1;
    let x0 = cx * world.CHUNK; let z0 = cz * world.CHUNK;
    for y in 12..16 { for z in z0 + 8..z0 + 14 { for x in x0 + 8..x0 + 16 { world.set(&w, x, y, z, block.STONE); } } }
    let detailed = terrain_mesh.detailed(&w, cx, cz);
    let merged = terrain_mesh.merged(&w, cx, cz);
    expect(detailed == 208 * 60 && merged == 6 * 60, "solid box reduces 208 voxel faces to six rectangles");
    // Tunnel, mined notch, different material, finite ore, excluded surface node,
    // and a solid neighbor across the boundary must all match detailed coverage.
    for caveY in 13..15 { for caveZ in z0 + 8..z0 + 14 { world.set(&w, x0 + 11, caveY, caveZ, block.AIR); } }
    world.set(&w, x0 + 8, 15, z0 + 8, block.AIR);
    world.set(&w, x0 + 12, 15, z0 + 8, block.GRASS);
    world.set(&w, x0 + 12, 14, z0 + 8, block.COPPER_ORE);
    world.set(&w, x0 + 15, 14, z0 + 9, block.COAL_NODE);
    for seamY in 20..23 { for seamZ in z0 + 20..z0 + 24 {
        world.set(&w, x0 + world.CHUNK - 1, seamY, seamZ, block.DIRT);
        world.set(&w, x0 + world.CHUNK, seamY, seamZ, block.STONE);
    } }
    let entries = 6 * world.CHUNK * world.SY * world.CHUNK;
    let reference = mem.alloc::<u8>(entries); let result = mem.alloc::<u8>(entries);
    let fine = terrain_mesh.detailed(&w, cx, cz); coverage(&w, fine, reference, cx, cz, false);
    let coarse = terrain_mesh.merged(&w, cx, cz); coverage(&w, coarse, result, cx, cz, true);
    expect(coarse < fine, "complex terrain still reduces geometry");
    for i in 0..entries { expect(reference[i] == result[i], "merged faces preserve every exposed voxel and hole"); }
    // Rebuilding after an edit must not keep a stale merged hole.
    world.set(&w, x0 + 8, 15, z0 + 8, block.STONE);
    for clear in 0..entries { reference[clear] = 0; result[clear] = 0; }
    let editedFine = terrain_mesh.detailed(&w, cx, cz); coverage(&w, editedFine, reference, cx, cz, false);
    let editedCoarse = terrain_mesh.merged(&w, cx, cz); coverage(&w, editedCoarse, result, cx, cz, true);
    for index in 0..entries { expect(reference[index] == result[index], "edited LOD matches rebuilt detail"); }
    sectionChecks(&w, cx, cz, &mem);
    workerChecks(&w, cx, cz);
    mem.destroy();
}
