module industry.checks.power;

use j3.gfx.voxel.Hit;
use j3.memory.Arena;
use industry.checks.fixture;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.inventory;
use industry.machine.furnace;
use industry.machine.dispatch;
use industry.machine.generator;
use industry.machine.belts;
use industry.machine.power;
use industry.session;
use industry.wiring;
use industry.world;
use industry.world.World;

const Power = @script("scripts/power.j3s");
const Drill = @script("scripts/drill.j3s");
const Furnace = @script("scripts/furnace.j3s");

fn slot(w: &World, x: int, y: int, z: int): int { return world.slotOf(w, cell(x, y, z)); }

fn can(w: &World, a: int, b: int): bool { let link = power.check(w, a, b); return link.ok; }

fn wire(w: &World, a: int, b: int) { power.connect(w, a, b); }

fn rules() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    expect(world.placeMachine(&w, 76, 5, 66, 0, block.POST), "place post");
    expect(world.height(block.POST) == 7 && w.cells[cell(76, 11, 66)] == block.POST &&
        w.cells[cell(76, 12, 66)] == block.AIR, "taller post occupies seven blocks");
    expect(world.anchorAt(&w, 76, 11, 66) == cell(76, 5, 66), "taller post top resolves to its anchor");
    expect(world.placeMachine(&w, 66, 5, 66, 0, block.POST), "place second post");
    expect(world.placeMachine(&w, 56, 5, 66, 0, block.POST), "place far post");
    expect(world.placeMachine(&w, 80, 5, 66, 0, block.GENERATOR), "place generator");
    expect(world.placeMachine(&w, 72, 5, 68, conveyor.NORTH, block.ELECTRIC_DRILL), "place electric drill");
    let post = cell(76, 5, 66); let other = cell(66, 5, 66); let far = cell(56, 5, 66);
    let gen = cell(80, 5, 66); let drill = cell(72, 5, 68);
    expect(can(&w, post, other), "post to post");
    expect(can(&w, post, gen) && can(&w, drill, post), "post to machine");
    expect(!can(&w, gen, drill), "machine to machine needs a post");
    expect(!can(&w, post, post), "a machine cannot wire to itself");
    expect(!can(&w, post, far) && can(&w, other, far), "wires have a longest reach");
    wire(&w, post, gen); wire(&w, post, drill);
    expect(power.wireBetween(&w, slot(&w, 76, 5, 66), slot(&w, 80, 5, 66)) >= 0, "wire found by its ends");
    expect(power.wiresAt(&w, slot(&w, 76, 5, 66)) == 2, "post counts its wires");
    world.breakAt(&w, 66, 5, 66);
    expect(w.wireCount == 2, "removing an unwired post keeps other wires");
    world.breakAt(&w, 76, 5, 66);
    expect(w.wireCount == 0, "removing a post drops its wires");
    mem.destroy();
}

fn supply() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let grid = Power {}; let drill = Drill {};
    world.placeMachine(&w, 76, 5, 66, 0, block.POST);
    world.placeMachine(&w, 80, 5, 66, 0, block.GENERATOR);
    world.placeMachine(&w, 72, 5, 68, conveyor.NORTH, block.ELECTRIC_DRILL);
    let post = cell(76, 5, 66); let gen = cell(80, 5, 66); let machine = cell(72, 5, 68);
    let g = slot(&w, 80, 5, 66); let d = slot(&w, 72, 5, 68);
    drill.update(&w, 8);
    expect(w.drills[d].count == 0, "an unwired electric drill does not mine");
    wire(&w, post, gen); wire(&w, post, machine);
    grid.update(&w, 0.016666668);
    expect(close(w.powered[d], 0), "no coal, no power");
    expect(generator.addCoal(&w, gen), "coal goes into the generator");
    let hand = inventory.create(&mem);
    inventory.add(&hand, item.COAL, 20); inventory.add(&hand, item.COPPER, 3);
    expect(dispatch.insert(&w, gen, &hand, item.COAL, 1) == 1 && hand.counts[int(item.COAL)] == 19, "clicking a generator with coal loads one");
    expect(dispatch.insert(&w, gen, &hand, item.COAL, 99) == generator.LIMIT - 2 && w.gens[g].fuel == generator.LIMIT, "shift loads as much as fits");
    expect(dispatch.insert(&w, gen, &hand, item.COPPER, 1) == 0, "a generator refuses what it cannot burn");
    w.gens[g].fuel = 1;
    grid.update(&w, 0.016666668);
    expect(w.gens[g].fuel == 0 && w.gens[g].burn > 19.9, "generator lights a coal when the network asks");
    expect(close(w.powered[d], 1), "full power with a coal burning");
    drill.update(&w, 2);
    expect(w.drills[d].count == 1, "electric drill mines twice as fast");
    for i in 0..60 { grid.update(&w, 0.5); }
    expect(w.gens[g].burn <= 0, "a coal burns out");
    drill.update(&w, 8);
    expect(w.drills[d].count == 1, "no power, no mining");
    // An idle network burns nothing.
    generator.addCoal(&w, gen); generator.addCoal(&w, gen);
    world.breakAt(&w, 72, 5, 68);
    grid.update(&w, 5);
    expect(w.gens[g].fuel == 2 && w.gens[g].burn <= 0, "a generator with no demand keeps its coal");
    mem.destroy();
}

fn brownout() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let grid = Power {}; let kiln = Furnace {};
    world.placeMachine(&w, 76, 5, 66, 0, block.POST);
    world.placeMachine(&w, 80, 5, 66, 0, block.GENERATOR);
    world.placeMachine(&w, 72, 5, 68, conveyor.NORTH, block.ELECTRIC_DRILL);
    world.placeMachine(&w, 80, 5, 72, 0, block.ELECTRIC_SMELTER);
    world.placeMachine(&w, 86, 5, 72, 0, block.ELECTRIC_SMELTER);
    let post = cell(76, 5, 66);
    for target in 0..4 {
        let at = cell(80, 5, 66);
        if target == 1 { at = cell(72, 5, 68); }
        if target == 2 { at = cell(80, 5, 72); }
        if target == 3 { at = cell(86, 5, 72); }
        wire(&w, post, at);
    }
    generator.addCoal(&w, cell(80, 5, 66));
    let a = slot(&w, 80, 5, 72); let b = slot(&w, 86, 5, 72);
    w.kilns[a].stock = 1; w.kilns[a].stockKind = item.COPPER;
    w.kilns[b].stock = 1; w.kilns[b].stockKind = item.COPPER;
    grid.update(&w, 0.016666668);
    expect(close(w.powered[a], 100 / f32(130)), "demand above supply slows every machine on the network");
    expect(!furnace.take(&w, cell(80, 5, 70), block.ELECTRIC_SMELTER, item.COAL), "the electric smelter refuses coal");
    kiln.update(&w, 0.9);
    expect(w.kilns[a].item == item.COPPER && w.kilns[a].clock > 1.3 && w.kilns[a].clock < 1.4, "smelting at two times the share of power");
    mem.destroy();
}

fn recipes() {
    let mem = Arena.create(1024);
    let bag = inventory.create(&mem);
    expect(!inventory.canCraft(&bag, item.COPPER_WIRE), "no wire without an ingot");
    inventory.add(&bag, item.COPPER_INGOT, 3);
    expect(inventory.craft(&bag, item.COPPER_WIRE) && bag.counts[int(item.COPPER_WIRE)] == 1, "an ingot makes wire");
    expect(bag.counts[int(item.COPPER_INGOT)] == 2 && !inventory.canCraft(&bag, item.GENERATOR), "recipes spend ingots");
    inventory.add(&bag, item.IRON_INGOT, 5); inventory.add(&bag, item.COPPER_WIRE, 4);
    expect(inventory.craft(&bag, item.GENERATOR) && bag.counts[int(item.IRON_INGOT)] == 0 && bag.counts[int(item.COPPER_WIRE)] == 0,
        "generator costs five iron ingots and five wire");
    mem.destroy();
}

fn wiringTool() {
    let mem = Arena.create(1024);
    let g = session.bootSeed(&mem, 5);
    world.placeMachine(&g.world, 200, 110, 200, 0, block.POST);
    world.placeMachine(&g.world, 210, 110, 200, 0, block.POST);
    inventory.add(&g.carried, item.COPPER_WIRE, 2);
    g.player.slot = 1;
    expect(wiring.holding(&g), "wire in hand");
    let a = cell(200, 110, 200); let b = cell(210, 110, 200);
    g.looked = block.POST;
    g.hit = Hit { ok: true, x: 200, y: 110, z: 200 }; wiring.click(&g);
    expect(g.wireFrom == a, "first click picks an end");
    g.hit = Hit { ok: true, x: 210, y: 110, z: 200 }; wiring.click(&g);
    expect(g.world.wireCount == 1 && g.carried.counts[int(item.COPPER_WIRE)] == 1, "second click wires and spends one wire");
    expect(g.wireFrom == b, "wiring from a post continues from the post reached");
    wiring.click(&g);
    expect(g.wireFrom == -1, "clicking the same machine cancels");
    g.hit = Hit { ok: true, x: 200, y: 110, z: 200 }; wiring.click(&g);
    g.hit = Hit { ok: true, x: 210, y: 110, z: 200 }; wiring.click(&g);
    expect(g.world.wireCount == 0 && g.carried.counts[int(item.COPPER_WIRE)] == 2, "clicking a wired pair takes the wire back");
    g.player.slot = 0;
    g.wireFrom = a; wiring.tidy(&g);
    expect(g.wireFrom == -1, "putting the wire away drops a half-run wire");
    mem.destroy();
}

fn generatorIntake() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    for dir in 0..4 {
        expect(world.placeMachine(&w, 80, 6, 80, u8(dir), block.GENERATOR), "place rotated generator");
        let at = cell(80, 6, 80);
        for side in 0..4 {
            let x = 80 - int(conveyor.dx(u8(side))) * 2;
            let z = 80 - int(conveyor.dz(u8(side))) * 2;
            let source = cell(x, 6, z);
            expect(world.placeConveyor(&w, x, 6, z, u8(side)), "place generator input belt");
            let fuel = w.gens[world.slotOf(&w, at)].fuel;
            expect(generator.canTake(&w, source, item.COAL) == (side == dir), "only rear intake advertises coal acceptance");
            expect(generator.take(&w, source, item.COAL) == (side == dir), "only rear intake receives coal in every rotation");
            if side == dir {
                expect(!generator.take(&w, source, item.COPPER), "generator refuses ore at its intake");
                expect(belts.insert(&w, source, item.COAL), "coal loads onto rear belt");
                belts.update(&w, 2);
                expect(w.belts[world.slotOf(&w, source)].count == 0 &&
                    w.gens[world.slotOf(&w, at)].fuel == fuel + 2, "rear conveyor delivers coal into generator");
            } else {
                expect(w.gens[world.slotOf(&w, at)].fuel == fuel, "wrong-side delivery leaves fuel unchanged");
            }
            world.breakAt(&w, x, 6, z);
        }
        let raisedX = 80 - int(conveyor.dx(u8(dir))) * 2;
        let raisedZ = 80 - int(conveyor.dz(u8(dir))) * 2;
        expect(world.placeConveyor(&w, raisedX, 7, raisedZ, u8(dir)), "place raised rear belt");
        expect(!generator.canTake(&w, cell(raisedX, 7, raisedZ), item.COAL) &&
            !generator.take(&w, cell(raisedX, 7, raisedZ), item.COAL), "raised belt cannot feed generator");
        world.breakAt(&w, raisedX, 7, raisedZ);
        world.breakAt(&w, 80, 6, 80);
    }
    mem.destroy();
}

pub fn run() {
    report.suite("generator intake"); generatorIntake();
    report.suite("power wiring"); rules();
    report.suite("power supply"); supply();
    report.suite("power brownout"); brownout();
    report.suite("power recipes"); recipes();
    report.suite("wire tool"); wiringTool();
}
