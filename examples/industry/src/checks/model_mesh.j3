module industry.checks.model_mesh;
use industry.checks.report.{ expect };
use j3.memory.Arena;
use j3.math;
use j3.math.{ Vec3, Mat4 };
use j3.gfx;
use j3.gfx.Look;
use industry.subvoxels;
use industry.subvoxels.Grid;
use industry.model_mesh;
use industry.models;
use industry.visibility;


fn mark(g: &Grid, out: []u8, x: int, y: int, z: int, face: int, color: Vec3) {
    expect(x >= 0 && x < 24 && y >= 0 && y < g.height && z >= 0 && z < 24, "model rectangle stays in authoring canvas");
    let index = ((face * g.height + y) * 24 + z) * 24 + x;
    expect(out[index] == 0, "merged model has no duplicate faces"); out[index] = 1;
    let id = subvoxels.get(g, x, y, z); expect(id != 0, "merged model face belongs to a voxel");
    let expected = g.colors[int(id) - 1];
    expect(color.x == expected.x && color.y == expected.y && color.z == expected.z, "model rectangles preserve exact colors");
}

fn coverage(g: &Grid, verts: []f32, out: []u8, bit: bool) {
    for faceAt in 0..verts.len / 60 {
        let at = faceAt * 60;
        let normal = Vec3.xyz(verts[at + 3], verts[at + 4], verts[at + 5]);
        let color = Vec3.xyz(verts[at + 6], verts[at + 7], verts[at + 8]);
        let lo = Vec3.xyz(24, f32(g.height), 24); let hi = Vec3.xyz(0, 0, 0);
        for vertex in 0..6 {
            let p = at + vertex * 10;
            let position = Vec3.xyz(verts[p], verts[p + 1], verts[p + 2]);
            let grid = position * 8 + Vec3.xyz(12, 0, 12);
            expect(grid.x == f32(int(grid.x)) && grid.y == f32(int(grid.y)) && grid.z == f32(int(grid.z)), "merged vertices remain on exact subvoxel grid");
            lo = Vec3.xyz(math.min(lo.x, grid.x), math.min(lo.y, grid.y), math.min(lo.z, grid.z));
            hi = Vec3.xyz(math.max(hi.x, grid.x), math.max(hi.y, grid.y), math.max(hi.z, grid.z));
            let glow: f32 = 0; if g.glow { glow = 1; }
            expect(verts[p + 9] == glow, "model emission survives merging");
            for dir in 0..4 { for pose in 0..4 {
                let turn = models.quarter(u8(dir));
                if bit { turn = models.bitTransform(turn, u8(pose)); }
                let rotated = turn.transformPoint(position);
                expect(rotated.x >= -1.5 && rotated.x <= 1.5 && rotated.y >= 0 && rotated.y <= math.max(4, f32(g.height) / 8) && rotated.z >= -1.5 && rotated.z <= 1.5,
                    "render bounds include all cardinal rotations and drill poses");
            } }
        }
        for triangle in 0..2 {
            let offset = at + triangle * 30;
            let a = Vec3.xyz(verts[offset], verts[offset + 1], verts[offset + 2]);
            let b = Vec3.xyz(verts[offset + 10], verts[offset + 11], verts[offset + 12]);
            let c = Vec3.xyz(verts[offset + 20], verts[offset + 21], verts[offset + 22]);
            expect((b - a).cross(c - a).dot(normal) > 0, "merged models retain winding and normals");
        }
        if normal.x != 0 {
            let face = 0; let x = int(lo.x); if normal.x > 0 { face = 1; x -= 1; }
            for y in int(lo.y)..int(hi.y) { for z in int(lo.z)..int(hi.z) { mark(g, out, x, y, z, face, color); } }
        } else if normal.y != 0 {
            let faceY = 2; let yy = int(lo.y); if normal.y > 0 { faceY = 3; yy -= 1; }
            for xx in int(lo.x)..int(hi.x) { for zz in int(lo.z)..int(hi.z) { mark(g, out, xx, yy, zz, faceY, color); } }
        } else {
            let faceZ = 4; let zzz = int(lo.z); if normal.z > 0 { faceZ = 5; zzz -= 1; }
            for xxx in int(lo.x)..int(hi.x) { for yyy in int(lo.y)..int(hi.y) { mark(g, out, xxx, yyy, zzz, faceZ, color); } }
        }
    }
}

fn check(name: string, bit: bool, glow: bool) {
    let mem = Arena.create(1024); let g = subvoxels.load(`assets/models/{name}.j3voxel`, &mem); g.glow = glow;
    let entries = 6 * 24 * g.height * 24; let reference = mem.alloc::<u8>(entries); let result = mem.alloc::<u8>(entries);
    let detailed = subvoxels.vertices(&g); let count = detailed.len; coverage(&g, detailed, reference, bit);
    let merged = model_mesh.vertices(&g); coverage(&g, merged, result, bit);
    expect(merged.len <= count, "exact model merging never increases geometry");
    for i in 0..entries { expect(reference[i] == result[i], "merged model preserves every face and opening"); }
    mem.destroy();
}

fn cullingChecks() {
    let eye = Look.create(Vec3.xyz(108, 56, 108), 0, 0);
    let clip = Mat4.perspective(1.22, f32(1280) / 720, 0.05, 100).mul(eye.view());
    let lo = Vec3.xyz(-1.5, 0, -1.5); let hi = Vec3.xyz(1.5, 7.5, 1.5);
    let behind = Mat4.translate(108, 56, 115).mul(Mat4.scale(0.5, 0.5, 0.5));
    expect(!gfx.boxInClip(clip.mul(behind), lo, hi), "machine behind camera is culled");
    let light = Mat4.ortho(0, 216, 0, 66, -216, 216);
    expect(gfx.boxInClip(light.mul(behind), lo, hi), "camera-culled machine remains eligible for shadow pass");
    let belt = Mat4.translate(108, 56, 108.85).mul(Mat4.scale(0.5, 0.5, 0.5));
    let cargo = Mat4.translate(108, 56, 108.35).mul(Mat4.scale(0.5, 0.5, 0.5));
    expect(!gfx.boxInClip(clip.mul(belt), lo, hi) && gfx.boxInClip(clip.mul(cargo), lo, hi), "turning cargo is culled independently of its belt");
    for pass in 0..2 {
        let matrix = clip; if pass == 1 { matrix = light; }
        let frustum = visibility.create(matrix);
        for x in -12..13 { for y in -8..9 { for z in -12..13 {
            let minimum = Vec3.xyz(108 + f32(x) * 10, 56 + f32(y) * 10, 108 + f32(z) * 10);
            let maximum = minimum + Vec3.xyz(12, 8, 12);
            expect(visibility.visible(&frustum, minimum, maximum) == gfx.boxInClip(matrix, minimum, maximum),
                "cached planes match reference camera and shadow clipping across faces, edges and corners");
            for direction in 0..4 {
                let instance = Mat4.translate(minimum.x, minimum.y, minimum.z).mul(models.quarter(u8(direction))).mul(Mat4.scale(0.5, 0.5, 0.5));
                expect(models.visible(&frustum, instance) == gfx.boxInClip(matrix.mul(instance), lo, hi),
                    "world model bounds match reference clipping in every cardinal rotation");
            }
        } } }
    }
}

pub fn run() {
    cullingChecks();
    check("drill", false, false); check("drill-bit", true, false); check("conveyor", false, false);
    check("copper-node", false, false); check("coal-node", false, false);
    check("copper-cargo", false, false); check("coal-cargo", false, false);
    check("generator", false, false); check("generator-fire", false, true); check("power-post", false, false);
    check("furnace", false, false); check("container", false, false); check("market", false, false);
    check("copper-ingot", false, false); check("furnace-fire", false, true); check("pickaxe", false, false);
}
