module industry.checks.mining;

use industry.mining;
use industry.mining.Progress;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn miningChecks() {
    let progress = Progress {};
    let hit = Hit { ok: true, x: 72, y: 4, z: 72 };
    expect(!mining.advance(&progress, hit, block.STONE, 0.35, 0.15), "partial mining does not break block");
    mining.pause(&progress, 0.6);
    expect(close(progress.elapsed, 0.15), "pulling away preserves breaking progress without advancing it");
    expect(mining.advance(&progress, hit, block.STONE, 0.35, 0.2), "returning within a second resumes the same block");
    expect(mining.fraction(&progress) == 0, "completed breaking clears feedback");
    mining.advance(&progress, hit, block.STONE, 0.35, 0.1);
    mining.pause(&progress, 0.99);
    expect(progress.elapsed > 0, "feedback lasts through almost one second away");
    mining.pause(&progress, 0.02);
    expect(mining.fraction(&progress) == 0, "breaking progress expires after one second away");
    mining.advance(&progress, hit, block.STONE, 0.35, 0.2);
    let other = Hit { ok: true, x: 73, y: 4, z: 72 };
    expect(!mining.advance(&progress, other, block.STONE, 0.35, 0.15) && close(progress.elapsed, 0.15),
        "starting another block cannot inherit the old block's progress");
    expect(!mining.advance(&progress, other, block.COPPER_NODE, 2, 0.5) && close(mining.fraction(&progress), 0.25),
        "replaced target resets progress and ore keeps its own mining duration");
}


pub fn run() { report.suite("mining"); miningChecks(); }
