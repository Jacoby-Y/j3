// Every check, run in order against fresh or shared worlds. `j3c run tests` runs this.
module industry.checks.main;

use j3.memory.Arena;
use industry.checks.report;
use industry.checks.simulation;
use industry.checks.table;
use industry.checks.belt;
use industry.checks.capacity;
use industry.checks.chunk;
use industry.checks.commands;
use industry.checks.container;
use industry.checks.drill;
use industry.checks.fixture;
use industry.checks.furnace;
use industry.checks.logistics;
use industry.checks.inventory;
use industry.checks.lifecycle;
use industry.checks.market;
use industry.checks.mining;
use industry.checks.model;
use industry.checks.model_asset;
use industry.checks.model_mesh;
use industry.checks.placement;
use industry.checks.power;
use industry.checks.unlock_cost;
use industry.checks.terrain_lod;
use industry.checks.world_generation;

fn main() {
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    report.suite("definition tables"); table.run();
    report.suite("terrain lod"); terrain_lod.run();
    report.suite("world generation"); world_generation.run();
    mining.run();
    model.run();
    report.suite("model assets"); model_asset.run();
    report.suite("model meshes"); model_mesh.run();
    container.run();
    report.suite("simulation steps"); simulation.run();
    report.suite("capacity"); capacity.run();
    report.suite("market"); market.run();
    inventory.run();
    placement.run();
    furnace.run();
    power.run();
    unlock_cost.run();
    logistics.run();
    commands.run();
    // These four share one world and depend on each other's leftovers, so their order matters.
    chunk.run(&w);
    drill.run(&w);
    belt.run(&w);
    lifecycle.run(&w);
    mem.destroy();
    report.finish();
}
