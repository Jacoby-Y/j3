module industry.checks.model;

use j3.memory.Arena;
use j3.math.{ Vec3, Vec2, Mat4 };
use j3.gfx.voxel;
use industry.models;
use industry.pickaxe;
use industry.mining;
use industry.held_item;
use j3.gfx.Look;
use industry.subvoxels;
use industry.subvoxels.Grid;
use industry.machine.furnace;
use industry.machine.container;
use industry.data.content;
use industry.data.defs;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };

fn gridPoint(p: Vec3): bool {
    return p.x * 8 == f32(int(p.x * 8)) && p.y * 8 == f32(int(p.y * 8)) && p.z * 8 == f32(int(p.z * 8));
}

fn modelGrid(g: &Grid, isBit: bool): int {
    let verts = subvoxels.vertices(g);
    expect(verts.len > 0 && verts.len % 60 == 0, "subvoxel model consists of complete cube faces");
    let at = 0;
    while at < verts.len {
        let p = Vec3.xyz(verts[at], verts[at + 1], verts[at + 2]);
        expect(gridPoint(p), "every model vertex is on the exact one-eighth voxel grid");
        let nx = verts[at + 3]; let ny = verts[at + 4]; let nz = verts[at + 5];
        expect(nx * nx + ny * ny + nz * nz == 1 && nx == f32(int(nx)) &&
            ny == f32(int(ny)) && nz == f32(int(nz)), "model faces have axis-aligned normals");
        for dir in 0..4 {
            let cardinal = models.quarter(u8(dir));
            expect(gridPoint(cardinal.transformPoint(p)), "cardinal orientation preserves exact subvoxel grid");
            if isBit {
                for pose in 0..4 {
                    let animated = models.bitTransform(cardinal, u8(pose));
                    expect(gridPoint(animated.transformPoint(p)), "each animated drill pose remains grid-aligned");
                }
            }
        }
        at += 10;
    }
    return verts.len;
}

fn modelChecks() {
    let mem = Arena.create(1024);
    let d = models.load(content.M_DRILL, &mem); let bit = models.load(content.M_BIT, &mem);
    let storage = models.load(content.M_CONTAINER, &mem);
    for id in 0..defs.modelCount() { let grid = models.load(id, &mem); modelGrid(&grid, id == content.M_BIT); }
    let tool = pickaxe.model(&mem);
    modelGrid(&tool, false);
    for row in 0..16 { for column in 0..16 {
        expect(subvoxels.occupied(&tool, column - 8, 15 - row, 0) ==
            subvoxels.occupied(&tool, row - 8, 15 - column, 0),
            "pickaxe silhouette mirrors across its diagonal handle");
    } }

    for y in 0..16 { for z in -8..8 { for x in -8..8 {
        if !subvoxels.occupied(&bit, x, y, z) { continue; }
        for pose in 0..4 {
            let p = models.bitTransform(Mat4.identity(), u8(pose)).transformPoint(
                Vec3.xyz((f32(x) + 0.5) / 8, (f32(y) + 0.5) / 8, (f32(z) + 0.5) / 8));
            expect(!subvoxels.occupied(&d, int(p.x * 8 + 12) - 12, int(p.y * 8), int(p.z * 8 + 12) - 12),
                "every cutter pose clears the drill housing");
            expect(p.x > -1 && p.x < 1 && p.y > 0 && p.y < 2 && p.z > -1 && p.z < 1,
                "animated cutter stays inside drill footprint");
        }
    } } }
    for edge in 0..2 {
        let side = edge * 15 - 8;
        expect(!subvoxels.occupied(&storage, 0, 8, side) && !subvoxels.occupied(&storage, side, 8, 0),
            "all four container intakes are recessed rather than painted solid faces");
    }
    expect(subvoxels.occupied(&storage, 0, 8, -5), "container intake has an inset back");
    let gen = models.load(content.M_GENERATOR, &mem);
    let smelter = models.load(content.M_ELECTRIC_SMELTER, &mem);
    for y in 3..13 { for z in 18..20 { for x in 6..18 {
        expect((subvoxels.get(&gen, x, y, z) != 0) == (subvoxels.get(&smelter, x, y, z) != 0),
            "generator rear intake matches smelter frame and aperture at conveyor height");
    } } }
    expect(!subvoxels.occupied(&gen, 0, 8, 7) && subvoxels.occupied(&gen, 0, 8, 4),
        "generator rear intake is recessed at belt cargo height");
    let cam = Look.create(Vec3.xyz(4, 3, 2), 1.2, -0.5);
    let projection = Mat4.perspective(1.22, f32(1280) / 720, 0.05, 100);
    let extent = Vec2 { x: 1280, y: 720 };
    let rest = held_item.transform(Look.create(Vec3.xyz(0, 0, 0), 0, 0), 0, projection, extent);
    let held = cam.view().mul(held_item.transform(cam, 0, projection, extent));
    let local = Vec3.xyz(0, 1, 0);
    let restingPoint = rest.transformPoint(local); let heldPoint = held.transformPoint(local);
    expect((restingPoint - heldPoint).length() < 0.0001, "held pickaxe follows camera yaw, pitch, and position");
    for width in 0..3 {
        let screen = Vec2 { x: 1280 + f32(width) * 1280, y: 720 + f32(width) * 360 };
        let proj = Mat4.perspective(1.22, screen.x / screen.y, 0.05, 100);
        let pinned = proj.mul(cam.view()).mul(held_item.transform(cam, 0, proj, screen))
            .transformPoint(Vec3.xyz(0.7, 0.3, 0));
        let rightGap = (1 - pinned.x) * screen.x * 0.5;
        let bottomGap = (1 + pinned.y) * screen.y * 0.5;
        expect(rightGap > 143.99 && rightGap < 144.01 && bottomGap > 15.99 && bottomGap < 16.01,
            "pickaxe grip stays pinned to bottom right at large viewport sizes");
    }
    expect(held_item.update(0.9, false, 0.1) == 0, "released mining swing settles at rest");
    let flame = models.load(content.M_FIRE, &mem);
    let flameVerts = subvoxels.vertices(&flame);
    let flameAt = 0;
    while flameAt < flameVerts.len {
        expect(flameVerts[flameAt + 9] == 1, "file-backed furnace fire stays emissive");
        flameAt += 10;
    }
    let joined = subvoxels.create(&mem);
    subvoxels.box(&joined, Vec3.xyz(1, 0, 0), 0, 0, 0, 2, 1, 1);
    expect(modelGrid(&joined, false) == 600, "adjacent subvoxels omit shared internal faces");
    mem.destroy();
}


pub fn run() { report.suite("models"); modelChecks(); }
