// Check bookkeeping. A failed check prints its suite and message and the run goes on, so one
// run lists every failure; `finish` sets the exit status.
module industry.checks.report;

use j3.gfx.voxel;
use j3.io.printLn;
use j3.sys;
use industry.world;

#[singleton]
let FAILURES: int = 0;
#[singleton]
let PASSED: int = 0;
#[singleton]
let SUITE: string;

pub fn suite(name: string) { SUITE = name; }

pub fn expect(ok: bool, message: string) {
    if ok { PASSED += 1; return; }
    FAILURES += 1;
    printLn(`FAIL {SUITE}: {message}`);
}

pub fn close(a: f32, b: f32): bool { return a > b - 0.0001 && a < b + 0.0001; }

pub fn cell(x: int, y: int, z: int): int { return voxel.index(x, y, z, world.SX, world.SZ); }

pub fn finish() {
    printLn(`{PASSED} checks passed, {FAILURES} failed`);
    if FAILURES > 0 { sys.exit(1); }
}
