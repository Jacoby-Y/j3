// Generation invariants and finite ore transactions through the gameplay path.
module industry.checks.world_generation;
use industry.checks.report.{ expect };
use j3.memory.Arena;
use j3.math;
use j3.gfx.voxel;
use j3.gfx.voxel.Hit;
use industry.world;
use industry.world.World;
use industry.chunks;
use industry.gen.elevation;
use industry.gen.terrain;
use industry.gen.caves;
use industry.gen.veins;
use industry.data.block;
use industry.data.defs;
use industry.data.item;
use industry.gameplay;
use industry.interact;
use industry.session;
use industry.inventory;
use industry.machine.drills;
use industry.models;


fn elevationChecks() {
    expect(world.GROUND == 103 && world.SY > world.GROUND + 15 + 12, "100 extra blocks and hill headroom");
    for seed in 1..5 { for z in 0..world.SZ { for x in 0..world.SX {
        let ring = elevation.ring(x / world.CHUNK, z / world.CHUNK);
        let cap = 0; if ring == 2 { cap = 3; } if ring == 3 { cap = 6; } if ring == 4 { cap = 15; }
        let h = elevation.height(seed, x, z);
        expect(h >= world.GROUND && h <= world.GROUND + cap, "ring elevation cap");
        if ring <= 1 { expect(h == world.GROUND, "flat starting square"); }
        if x > 0 { expect(math.absi(h - elevation.height(seed, x - 1, z)) <= 1, "no abrupt horizontal hill seams"); }
        if z > 0 { expect(math.absi(h - elevation.height(seed, x, z - 1)) <= 1, "no abrupt vertical hill seams"); }
    } } }
    let entrances = 0;
    for caveSeed in 1..101 { for cz in 0..world.CHUNKS { for cx in 0..world.CHUNKS {
        if caves.entrance(caveSeed, cx, cz) { entrances += 1; expect(elevation.ring(cx, cz) == 4, "surface caves confined to outer ring"); }
    } } }
    expect(entrances >= 240 && entrances <= 400, "rare entrances approximate ten percent");
}

fn compareChunk(a: &World, b: &World, cx: int, cz: int): bool {
    for y in 0..world.SY { for z in cz * world.CHUNK..(cz + 1) * world.CHUNK {
        for x in cx * world.CHUNK..(cx + 1) * world.CHUNK {
            if world.get(a, x, y, z) != world.get(b, x, y, z) { return false; }
        }
    } }
    return true;
}

fn veinChecks(w: &World, cx: int, cz: int) {
    let count = 0; let perOre: [8]int = [0, 0, 0, 0, 0, 0, 0, 0];
    // Count each straight vein only at its lowest coordinate. Neighbor buffer prevents merging.
    for y in 1..world.GROUND { for z in cz * world.CHUNK..(cz + 1) * world.CHUNK {
        for x in cx * world.CHUNK..(cx + 1) * world.CHUNK {
            let id = world.get(w, x, y, z); if !block.isVein(id) { continue; }
            expect(y < world.GROUND - 2, "veins below soil");
            if block.isVein(world.get(w, x - 1, y, z)) || block.isVein(world.get(w, x, y - 1, z)) || block.isVein(world.get(w, x, y, z - 1)) { continue; }
            count += 1; perOre[defs.oreOfVein(id)] += 1;
            let size = 1;
            for distance in 1..4 {
                if world.get(w, x + distance, y, z) == id { size += 1; }
                if world.get(w, x, y + distance, z) == id { size += 1; }
                if world.get(w, x, y, z + distance) == id { size += 1; }
            }
            expect(size <= 3, "vein contains one to three individual cubes");
        }
    } }
    // Veins cycle through the ores; an ore starts only at its `minRing`.
    let wanted: [8]int = [0, 0, 0, 0, 0, 0, 0, 0]; let total = 0;
    for vein in 0..48 {
        let ore = vein % defs.oreCount(); let kind = defs.oreInfo(ore);
        if world.ring(cx, cz) >= kind.minRing { wanted[ore] += 1; total += 1; }
    }
    expect(count == total, "48 separate veins, fewer where an ore is not there yet");
    for each in 0..defs.oreCount() { expect(perOre[each] == wanted[each], "veins split evenly between the ores that exist here"); }
}

// Share of underground voxels that are cave air, sampled on a coarse lattice inside one chunk.
fn caveShare(seed: int, cx: int, cz: int): f32 {
    let hollow = 0; let total = 0;
    for z in cz * world.CHUNK..(cz + 1) * world.CHUNK { for x in cx * world.CHUNK..(cx + 1) * world.CHUNK {
        if (x + z) % 3 != 0 { continue; }
        let roof = elevation.height(seed, x, z) - 6;
        for y in 3..roof + 1 { total += 1; if caves.open(seed, x, y, z, roof) { hollow += 1; } }
    } }
    return f32(hollow) / f32(total);
}

fn caveShapeChecks() {
    for seed in 1..4 {
        let inner = caveShare(seed, world.CENTER, world.CENTER);
        let rim = caveShare(seed, 0, 0);
        expect(inner > 0.02 && inner < 0.3, "start chunk cave share is moderate");
        expect(rim > 0.04 && rim < 0.4 && rim > inner, "rim chunks are hollower than the start");
    }
}

fn generationChecks() {
    let mem = Arena.create(1024);
    let a = world.createSeed(&mem, 42); let b = world.createSeed(&mem, 42);
    expect(chunks.unlock(&a, world.CENTER, world.CENTER), "starting chunk unlock");
    expect(!chunks.unlock(&a, world.CENTER + 1, world.CENTER + 1), "diagonal chunk stays locked");
    expect(world.get(&a, world.CENTER * world.CHUNK + 17, world.GROUND + 3, world.CENTER * world.CHUNK + 35) == block.STONE, "the starting chunk has a stone boulder");
    expect(chunks.unlock(&a, world.CENTER + 1, world.CENTER), "east unlock");
    expect(chunks.unlock(&a, world.CENTER, world.CENTER + 1), "south unlock");
    chunks.unlock(&b, world.CENTER, world.CENTER); chunks.unlock(&b, world.CENTER, world.CENTER + 1);
    chunks.unlock(&b, world.CENTER + 1, world.CENTER);
    expect(compareChunk(&a, &b, world.CENTER, world.CENTER) && compareChunk(&a, &b, world.CENTER + 1, world.CENTER), "seed and unlock order reproduce every cell");
    for nodeChunk in 0..a.unlocked.len {
        if a.unlocked[nodeChunk] == 0 { continue; }
        let ncx = nodeChunk % world.CHUNKS; let ncz = nodeChunk / world.CHUNKS;
        for kind in 0..2 {
            if !elevation.hasNode(a.seed, ncx, ncz, kind) { continue; }
            let nx = elevation.nodeX(a.seed, ncx, ncz, kind);
            let expected = models.transform(nx, elevation.nodeY(a.seed, ncx, ncz, kind), elevation.nodeZ(a.seed, ncx, ncz, kind), 0);
            for component in 0..16 {
                expect(a.nodeModels[nodeChunk * defs.oreCount() + kind].m[component] == expected.m[component], "unlock caches exact surface-node transforms");
                expect(a.nodeModels[nodeChunk * defs.oreCount() + kind].m[component] == b.nodeModels[nodeChunk * defs.oreCount() + kind].m[component], "node cache is independent of unlock order");
            }
        }
    }
    veinChecks(&a, world.CENTER, world.CENTER);
    for z in world.CENTER * world.CHUNK..(world.CENTER + 1) * world.CHUNK {
        for x in world.CENTER * world.CHUNK..(world.CENTER + 1) * world.CHUNK {
            expect(world.get(&a, x, 0, z) == block.STONE && !world.editable(&a, x, 0, z), "solid protected bottom");
            for y in world.GROUND - 5..world.GROUND {
                expect(world.get(&a, x, y, z) != block.AIR, "inner caves retain solid roof");
            }
        }
    }
    // Every underground voxel of two neighboring chunks is exactly what the noise field says, so seams cannot differ.
    let seam = (world.CENTER + 1) * world.CHUNK;
    let hollow = 0;
    for z in world.CENTER * world.CHUNK..(world.CENTER + 1) * world.CHUNK {
        for x in seam - world.CHUNK..seam + world.CHUNK {
            let roof = elevation.height(a.seed, x, z) - 6;
            for y in 3..roof + 1 {
                let air = world.get(&a, x, y, z) == block.AIR;
                expect(air == caves.open(a.seed, x, y, z, roof), "carved cells match the cave field across the seam");
                if air { hollow += 1; }
            }
        }
    }
    expect(hollow > 2000, "start chunks have caves");
    caveShapeChecks();
    let z = world.CENTER * world.CHUNK + 24;
    for chunk in 0..a.chunkDirty.len { a.chunkDirty[chunk] = 0; }
    world.set(&a, seam - 1, world.GROUND + 5, z, block.STONE);
    expect(a.chunkDirty[world.CENTER + world.CENTER * world.CHUNKS] == 1 && a.chunkDirty[world.CENTER + 1 + world.CENTER * world.CHUNKS] == 1,
        "boundary edit dirties both meshes");
    expect(a.chunkDirty[world.CENTER + (world.CENTER + 1) * world.CHUNKS] == 0, "unrelated mesh stays cached");
    // Re-generate a distant chunk with a different seed without changing a neighbor.
    b.seed = 43; b.unlocked[0] = 1;
    terrain.generate(&b, 0, 0);
    a.unlocked[0] = 1; terrain.generate(&a, 0, 0);
    expect(!compareChunk(&a, &b, 0, 0), "different seeds produce different terrain");
    let foundSeed = 1;
    while !caves.entrance(foundSeed, 0, 0) { foundSeed += 1; }
    b.seed = foundSeed;
    // Clearing before regeneration is a test-only operation, never used when unlocking.
    for clearY in 0..world.SY { for clearZ in 0..world.CHUNK { for clearX in 0..world.CHUNK {
        b.cells[voxel.index(clearX, clearY, clearZ, world.SX, world.SZ)] = block.AIR;
    } } }
    terrain.generate(&b, 0, 0);
    let mouth = caves.entranceAt(foundSeed, 0, 0);
    let mouthOpen = false; let footOpen = 0;
    for dz in -5..6 { for dx in -5..6 {
        if world.get(&b, int(mouth.x) + dx, int(mouth.y) - 1, int(mouth.z) + dz) == block.AIR { mouthOpen = true; }
        if world.get(&b, int(mouth.x) + dx, 50, int(mouth.z) + dz) == block.AIR { footOpen += 1; }
    } }
    expect(mouthOpen, "outer entrance opens surface");
    expect(footOpen > 20, "entrance shaft reaches the cave layer");
    mem.destroy();
}

fn miningChecks() {
    let mem = Arena.create(1024); let g = session.bootSeed(&mem, 731);
    let x = world.CENTER * world.CHUNK + 8; let z = x;
    let seen: [7]bool = [false, false, false, false, false, false, false];
    for y in 10..100 {
        let sampleYield = veins.yieldAt(g.world.seed, x, y, z);
        expect(sampleYield >= 1 && sampleYield <= 6, "finite ore yields in range"); seen[sampleYield] = true;
    }
    for amountId in 1..7 { expect(seen[amountId], "all six yields reachable"); }
    let hit = Hit { ok: true, x: x, y: 60, z: z };
    world.set(&g.world, x, 60, z, block.COPPER_ORE);
    let amount = veins.yieldAt(g.world.seed, x, 60, z);
    g.player.slot = 1;
    expect(!interact.collectOre(&g, hit), "ore requires selected pickaxe"); g.player.slot = 0;
    inventory.add(&g.carried, item.STONE, inventory.CAPACITY - 1);
    expect(!interact.collectOre(&g, hit) && world.get(&g.world, x, 60, z) == block.COPPER_ORE, "full bag preserves ore");
    g.carried.counts[int(item.STONE)] = inventory.CAPACITY - amount;
    expect(!interact.collectOre(&g, hit), "partial yield capacity preserves ore");
    g.carried.counts[int(item.STONE)] = 0;
    expect(interact.collectOre(&g, hit) && g.carried.counts[int(item.COPPER)] == amount && world.get(&g.world, x, 60, z) == block.AIR, "finite copper atomically drops and disappears");
    expect(!interact.collectOre(&g, hit), "finite ore cannot be mined twice");
    world.set(&g.world, x, 60, z, block.COAL_ORE);
    expect(interact.collectOre(&g, hit) && g.carried.counts[int(item.COAL)] == amount, "finite coal maps to existing resource");
    world.set(&g.world, x, 60, z, block.COPPER_ORE);
    expect(drills.ore(&g.world, x - 2, 60, z, 1) == 0, "drills ignore finite ore");
    let surface = Hit { ok: true, x: elevation.nodeX(g.world.seed, world.CENTER, world.CENTER, 0), y: elevation.nodeY(g.world.seed, world.CENTER, world.CENTER, 0), z: elevation.nodeZ(g.world.seed, world.CENTER, world.CENTER, 0) };
    let before = g.carried.counts[int(item.COPPER)];
    expect(interact.collectOre(&g, surface) && interact.collectOre(&g, surface), "surface ore remains inexhaustible");
    expect(g.carried.counts[int(item.COPPER)] == before + 2 && block.isNode(world.get(&g.world, surface.x, surface.y, surface.z)), "surface node yields one per action");
    let anchor = voxel.index(x, world.GROUND + 2, z, world.SX, world.SZ);
    expect(world.placeConveyor(&g.world, x, world.GROUND + 2, z, 1), "compact queue allocation");
    let slot = world.slotOf(&g.world, anchor); expect(slot > 0 && slot <= world.MAX_MACHINES, "bounded compact state");
    g.world.belts[slot].count = 2;
    world.breakAt(&g.world, x, world.GROUND + 2, z);
    expect(world.slotOf(&g.world, anchor) == 0, "removal releases queue");
    expect(world.placeConveyor(&g.world, x, world.GROUND + 2, z, 1), "queue slot reused");
    expect(g.world.belts[world.slotOf(&g.world, anchor)].count == 0, "reused state is empty");
    // Same hash bucket: lookup must continue across a deleted earlier entry.
    chunks.unlock(&g.world, world.CENTER - 1, world.CENTER);
    let collision = anchor + 16384;
    let bx = world.anchorX(collision); let by = world.anchorY(collision); let bz = world.anchorZ(collision);
    expect(world.placeConveyor(&g.world, bx, by, bz, 1), "colliding state allocation");
    let otherSlot = world.slotOf(&g.world, collision);
    expect(otherSlot > 0 && otherSlot != world.slotOf(&g.world, anchor), "colliding anchors have separate queues");
    g.world.belts[otherSlot].count = 3;
    world.breakAt(&g.world, x, world.GROUND + 2, z);
    expect(world.slotOf(&g.world, collision) == otherSlot && g.world.belts[otherSlot].count == 3, "hash deletion preserves the other queue");
    expect(world.placeConveyor(&g.world, x, world.GROUND + 2, z, 1), "hash tombstone reused");
    expect(world.slotOf(&g.world, collision) == otherSlot, "replacement preserves colliding lookup");
    mem.destroy();
}

pub fn run() { elevationChecks(); generationChecks(); miningChecks(); }
