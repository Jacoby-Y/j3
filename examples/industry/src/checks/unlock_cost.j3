module industry.checks.unlock_cost;

use j3.memory.Arena;
use industry.checks.report;
use industry.checks.report.{ expect };
use industry.chunks;
use industry.world;

pub fn run() {
    report.suite("chunk unlock cost");
    let mem = Arena.create(1024);
    let w = world.createSeed(&mem, 3);
    chunks.unlock(&w, world.CENTER, world.CENTER);
    expect(chunks.cost(&w, world.CENTER + 1, world.CENTER) == 60, "first ring: base plus one chunk open");
    expect(chunks.cost(&w, world.CENTER + 2, world.CENTER) == 90, "each ring out adds half again");
    expect(chunks.cost(&w, world.CENTER + 2, world.CENTER - 2) == 90, "the ring is the larger axis distance");
    w.coins = 59;
    expect(!chunks.buy(&w, world.CENTER + 1, world.CENTER) && w.coins == 59, "too few coins buys nothing");
    w.coins = 70;
    expect(chunks.buy(&w, world.CENTER + 1, world.CENTER) && w.coins == 10, "buying spends the price");
    w.coins = 1000;
    expect(!chunks.buy(&w, world.CENTER, world.CENTER + 1) && w.coins == 1000, "a second chunk waits while one is generating");
    while w.genActive { chunks.tick(&w, 0.02); }
    expect(chunks.cost(&w, world.CENTER, world.CENTER + 1) == 80, "price grows with every chunk opened");
    w.coins = 1000;
    expect(!chunks.buy(&w, world.CENTER + 2, world.CENTER + 2) && w.coins == 1000, "a refused unlock is not charged");
    mem.destroy();
}
