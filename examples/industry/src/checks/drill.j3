module industry.checks.drill;

use j3.memory.Arena;
use industry.mining;
use industry.machine.drills;
use industry.inventory;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.machine.belts;
use industry.world;
use industry.world.World;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
const Drill = @script("scripts/drill.j3s");

fn drillChecks(w: &World) {
    let drill = Drill {};
    expect(world.placeMachine(w, 72, 5, 68, conveyor.NORTH, block.DRILL), "place crude drill");
    let machine = cell(72, 5, 68);
    let belt = cell(72, 5, 70);
    drill.update(w, 4);
    expect(w.drills[world.slotOf(w, machine)].count == 1 && w.drills[world.slotOf(w, machine)].item == item.COPPER, "unconnected drill holds what it mined");
    for i in 0..12 { drill.update(w, 4); }
    expect(w.drills[world.slotOf(w, machine)].count == 10 && drills.full(w, machine), "drill stores at most ten items");
    expect(world.placeConveyor(w, 72, 5, 70, conveyor.NORTH), "belt facing along the drill's own direction");
    drill.update(w, 0);
    expect(w.belts[world.slotOf(w, belt)].count == 1 && w.drills[world.slotOf(w, machine)].count == 9, "any belt facing accepts drill output");
    world.breakAt(w, 73, 5, 71);
    expect(world.get(w, 72, 5, 70) == block.AIR, "break any machine part removes footprint");
    let bagMem = Arena.create(1024);
    let bag = inventory.create(&bagMem);
    expect(drills.collect(w, machine, &bag) == 9 && bag.counts[int(item.COPPER)] == 9, "E takes everything from a drill");
    expect(w.drills[world.slotOf(w, machine)].count == 0 && w.drills[world.slotOf(w, machine)].item == 0, "taken drill is empty");
    expect(world.placeConveyor(w, 72, 5, 70, conveyor.SOUTH), "connect output");
    drill.update(w, 3.9);
    expect(w.belts[world.slotOf(w, belt)].count == 0, "drill cannot output before four seconds");
    drill.update(w, 0.1);
    expect(w.belts[world.slotOf(w, belt)].count == 1, "one item at four seconds");
    world.breakAt(w, 72, 5, 68);
    expect(world.placeMachine(w, 72, 5, 68, conveyor.EAST, block.DRILL), "drill can face away from ore");
    drill.update(w, 5);
    expect(close(w.drills[world.slotOf(w, machine)].clock, 0) && w.drills[world.slotOf(w, machine)].count == 0, "no mining without neighboring ore");
    world.breakAt(w, 72, 5, 68);
    expect(world.placeMachine(w, 78, 5, 68, conveyor.NORTH, block.DRILL), "drill beside the coal node");
    let coal = cell(78, 5, 68);
    drill.update(w, 4);
    expect(w.drills[world.slotOf(w, coal)].item == item.COAL && w.drills[world.slotOf(w, coal)].count == 1, "drill mines coal");
    world.breakAt(w, 78, 5, 68);
}


pub fn run(w: &World) { report.suite("drills"); drillChecks(w); }
