module industry.checks.particles;

use j3.math.Vec3;
use j3.memory.Arena;
use industry.checks.fixture;
use industry.checks.report;
use industry.checks.report.{ expect, close };
use industry.data.block;
use industry.data.conveyor;
use industry.data.content;
use industry.data.defs;
use industry.fx.cubes;
use industry.fx.effects;
use industry.fx.emitters;
use industry.fx.pool;
use industry.fx.pool.Particles;
use industry.world;

fn poolChecks() {
    let mem = Arena.create(1024);
    let p = pool.create(&mem);
    for n in 0..pool.MAX_PARTICLES {
        pool.spawn(&p, content.FX_DUST, 10, 10, 10, 0, 0, 0, 1, 0, 1, 1, 1);
    }
    expect(p.count == pool.MAX_PARTICLES, "the pool fills to its capacity");
    expect(!pool.spawn(&p, content.FX_DUST, 10, 10, 10, 0, 0, 0, 1, 0, 1, 1, 1), "a full pool refuses a spawn");
    let w = fixture.create(&mem);
    pool.update(&p, &w, 0.5);
    expect(p.count == pool.MAX_PARTICLES, "cubes within their life stay");
    pool.update(&p, &w, 0.6);
    expect(p.count == 0, "every cube past its life is removed");
    mem.destroy();
}

fn sizeChecks() {
    expect(close(pool.edge(0), 0.0625) && close(pool.edge(1), 0.125) && close(pool.edge(2), 0.25) &&
        close(pool.edge(3), 0.5) && close(pool.edge(4), 1), "size classes are 1/16, 1/8, 1/4, 1/2 and 1 voxel");
    let mem = Arena.create(1024);
    let p = pool.create(&mem);
    pool.spawn(&p, content.FX_DEBRIS, 10, 10, 10, 0, 0, 0, 1, 4, 1, 1, 1);
    expect(pool.sizeNow(&p, 0) == 4, "a new shrinking cube starts at its class");
    p.age[0] = 0.5;
    expect(pool.sizeNow(&p, 0) == 2, "half its life it has stepped down two classes");
    p.age[0] = 0.95;
    expect(pool.sizeNow(&p, 0) == 0, "near its end it is the smallest class");
    pool.spawn(&p, content.FX_DUST, 10, 10, 10, 0, 0, 0, 1, 3, 1, 1, 1);
    p.age[1] = 0.9;
    expect(pool.sizeNow(&p, 1) == 3, "a non-shrinking cube keeps its class");
    mem.destroy();
}

fn alphaChecks() {
    let mem = Arena.create(1024);
    let p = pool.create(&mem);
    pool.spawn(&p, content.FX_DUST, 10, 10, 10, 0, 0, 0, 1, 1, 1, 1, 1);
    expect(close(pool.alphaNow(&p, 0), 1) && cubes.bucketOf(pool.alphaNow(&p, 0)) == 4, "a default effect is opaque");
    p.alpha[content.FX_DUST] = 0.5;
    expect(close(pool.alphaNow(&p, 0), 0.5), "a row alpha is the opacity");
    p.fade[content.FX_DUST] = 1;
    p.age[0] = 0.5;
    expect(close(pool.alphaNow(&p, 0), 0.25), "a fading cube loses opacity with age");
    p.age[0] = 0.99;
    expect(cubes.bucketOf(pool.alphaNow(&p, 0)) == int(255), "a nearly gone cube is skipped");
    expect(cubes.bucketOf(0.1) == 0 && cubes.bucketOf(0.3) == 1 && cubes.bucketOf(0.6) == 2 && cubes.bucketOf(0.9) == 3,
        "translucent cubes fall in four buckets");
    expect(cubes.bucketOf(0.99) == 4, "near-full opacity draws opaque");
    mem.destroy();
}

fn collisionChecks() {
    let mem = Arena.create(1024);
    let p = pool.create(&mem);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    world.set(&w, 80, 8, 80, block.STONE);
    // Free positions: not on the grid, falling onto the top of the stone cell (y = 9).
    pool.spawn(&p, content.FX_DUST, 80.37, 12, 80.61, 0, 0, 0, 5, 0, 1, 1, 1);
    for step in 0..90 { pool.update(&p, &w, f32(1) / 60); }
    expect(p.py[0] > 9 && p.py[0] < 9.2, "a colliding cube comes to rest on the floor");
    expect(p.vy[0] == 0 && close(p.px[0], 80.37), "a resting cube is still and keeps its free position");
    // Born inside a solid cell: not frozen, it flies out.
    pool.clear(&p);
    pool.spawn(&p, content.FX_DUST, 80.5, 8.5, 80.5, 0, 8, 0, 5, 0, 1, 1, 1);
    for step in 0..30 { pool.update(&p, &w, f32(1) / 60); }
    expect(p.py[0] > 9, "a cube born inside a block moves out of it");
    // No collide flag: passes through.
    pool.clear(&p);
    pool.spawn(&p, content.FX_SMOKE, 80.5, 8.5, 80.5, 0, 0, 0, 5, 2, 1, 1, 1);
    pool.update(&p, &w, 0.1);
    expect(p.py[0] > 8.5, "smoke rises through solid cells");
    // Bounce keeps it moving up after impact.
    pool.clear(&p);
    pool.spawn(&p, content.FX_SPARK, 80.5, 9.6, 80.5, 0, -6, 0, 5, 0, 1, 1, 1);
    let up = false;
    for step in 0..20 { pool.update(&p, &w, f32(1) / 60); if p.vy[0] > 0 { up = true; } }
    expect(up, "a bouncing cube rebounds off the floor");
    mem.destroy();
}

fn effectChecks() {
    let mem = Arena.create(1024);
    let p = pool.create(&mem);
    effects.burst(&p, content.FX_DEBRIS, Vec3.xyz(20, 20, 20), Vec3.up(), Vec3.xyz(0.5, 0.4, 0.3));
    let debris = defs.effectInfo(content.FX_DEBRIS);
    expect(p.count == debris.count, "a burst spawns its count");
    let ok = true;
    for i in 0..p.count { if p.size[i] > 4 || p.life[i] <= 0 { ok = false; } }
    expect(ok, "burst cubes get a valid size class and life");
    pool.clear(&p);
    for step in 0..600 { effects.spray(&p, content.FX_SPARK, Vec3.xyz(20, 20, 20), Vec3.up(), Vec3.xyz(1, 1, 1), f32(1) / 60); }
    let spark = defs.effectInfo(content.FX_SPARK); let rate = spark.rate;
    expect(f32(p.count) > rate * 10 * 0.6 && f32(p.count) < rate * 10 * 1.4, "a spray makes about its rate per second");
    mem.destroy();
}

fn emitterChecks() {
    for row in 0..defs.emitterCount() {
        let e = defs.emitterInfo(row);
        expect(world.machine(e.block) && e.effect >= 0 && e.effect < defs.effectCount(), "every emitter row names a machine and an effect");
        expect(defs.emitterRows(e.block) > 0 && defs.emitterFirst(e.block) <= row, "emitter rows are found by block");
    }
    let mem = Arena.create(1024);
    let w = fixture.create(&mem);
    fixture.unlock(&w, 1, 1);
    let p = pool.create(&mem);
    expect(world.placeMachine(&w, 80, 4, 60, conveyor.NORTH, block.FURNACE), "place furnace");
    let eye = Vec3.xyz(80, 6, 70);
    emitters.tick(&p, &w, eye, 1);
    expect(p.count == 0, "an idle furnace makes nothing");
    w.kilns[world.slotOf(&w, world.anchorAt(&w, 80, 4, 60))].item = 1;
    emitters.tick(&p, &w, eye, 1);
    expect(p.count > 0, "a running furnace makes smoke");
    let high = true;
    for i in 0..p.count { if p.py[i] < 4 + 3 { high = false; } }
    expect(high, "furnace smoke starts at the chimney, above the furnace body");
    pool.clear(&p);
    emitters.tick(&p, &w, Vec3.xyz(80, 6, 300), 1);
    expect(p.count == 0, "a machine far from the eye makes nothing");
    mem.destroy();
}

pub fn run() {
    report.suite("particles");
    poolChecks(); sizeChecks(); alphaChecks(); collisionChecks(); effectChecks(); emitterChecks();
}
