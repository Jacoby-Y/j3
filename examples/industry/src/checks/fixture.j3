// Small synthetic surface for automation tests, independent of procedural terrain.
module industry.checks.fixture;
use j3.memory.Arena;
use j3.math.Vec3;
use industry.data.block;
use industry.world;
use industry.world.World;
use industry.player;
use industry.player.Player;

pub fn create(mem: &Arena): World { return world.create(mem); }
pub fn playerAtStart(): Player {
    let p = player.create(); p.body.pos = Vec3.xyz(72.5, 6.75, 72.5); return p;
}

pub fn unlock(w: &World, cx: int, cz: int): bool {
    if cx < 0 || cz < 0 || cx >= world.CHUNKS || cz >= world.CHUNKS { return false; }
    let at = cx + cz * world.CHUNKS;
    if w.unlocked[at] != 0 { return false; }
    let any = false;
    for i in 0..w.unlocked.len { if w.unlocked[i] != 0 { any = true; } }
    if any && !world.active(w, cx * world.CHUNK - 1, cz * world.CHUNK) &&
        !world.active(w, (cx + 1) * world.CHUNK, cz * world.CHUNK) &&
        !world.active(w, cx * world.CHUNK, cz * world.CHUNK - 1) &&
        !world.active(w, cx * world.CHUNK, (cz + 1) * world.CHUNK) { return false; }
    w.unlocked[at] = 1;
    for z in cz * world.CHUNK..(cz + 1) * world.CHUNK {
        for x in cx * world.CHUNK..(cx + 1) * world.CHUNK {
            let h = 3;
            let hx = x - cx * world.CHUNK - 12; let hz = z - cz * world.CHUNK - 12;
            let d = hx * hx + hz * hz;
            if d < 100 { h = 4; } if d < 36 { h = 5; }
            hx = x - cx * world.CHUNK - 36; hz = z - cz * world.CHUNK - 34;
            d = hx * hx + hz * hz;
            if d < 81 { h = 4; } if d < 25 { h = 5; }
            for y in 1..h + 1 {
                let id: u8 = block.DIRT; if y == h { id = block.GRASS; }
                world.set(w, x, y, z, id);
            }
        }
    }
    for dz in 0..2 { for dx in 0..2 { for y in 4..6 {
        world.set(w, cx * world.CHUNK + 24 + dx, y, cz * world.CHUNK + 18 + dz, block.COPPER_NODE);
        world.set(w, cx * world.CHUNK + 30 + dx, y, cz * world.CHUNK + 18 + dz, block.COAL_NODE);
    } } }
    if cx == 1 && cz == 1 {
        for pz in 69..76 { for px in 69..76 { world.set(w, px, 4, pz, block.FOUNDATION); } }
    }
    return true;
}
