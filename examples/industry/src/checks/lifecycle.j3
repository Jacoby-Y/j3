module industry.checks.lifecycle;

use industry.chunks;
use industry.checks.fixture;
use industry.data.block;
use industry.data.conveyor;
use industry.machine.belts;
use industry.world;
use industry.world.World;
use industry.checks.report;
use industry.checks.report.{ expect, close, cell };
const Drill = @script("scripts/drill.j3s");

fn lifecycleChecks(w: &World) {
    world.breakAt(w, 72, 5, 68);
    world.breakAt(w, 72, 5, 70);
    for direction in 0..4 {
        let dir = u8(direction);
        let x = 72 - int(conveyor.dx(dir)) * 2;
        let z = 66 - int(conveyor.dz(dir)) * 2;
        let bx = x - int(conveyor.dx(dir)) * 2;
        let bz = z - int(conveyor.dz(dir)) * 2;
        let drill = Drill {};
        expect(world.placeMachine(w, x, 5, z, dir, block.DRILL), "place cardinal drill");
        expect(world.placeConveyor(w, bx, 5, bz, (dir + 2) % 4), "place cardinal output");
        drill.update(w, 4);
        expect(w.belts[world.slotOf(w, cell(bx, 5, bz))].count == 1, "each drill direction finds ore and outputs behind");
        world.breakAt(w, x + 1, 5, z + 1);
        world.breakAt(w, bx + 1, 5, bz + 1);
    }
    let before = w.machineCount;
    expect(world.placeConveyor(w, 80, 8, 80, conveyor.EAST), "place removable belt");
    world.breakAt(w, 81, 8, 81);
    expect(w.machineCount == before, "removal unregisters machine");
    expect(world.placeConveyor(w, 79, 8, 79, conveyor.EAST), "shift footprint onto old anchor");
    expect(w.machineCount == before + 1, "shifted replacement has only one anchor");
    for cz in 0..world.CHUNKS { for cx in 0..world.CHUNKS {
        fixture.unlock(w, cx, cz);
        expect(w.unlocked[cx + cz * world.CHUNKS] == 1, "all reachable chunks unlock");
        expect(world.get(w, cx * world.CHUNK + 24, 5, cz * world.CHUNK + 18) == block.COPPER_NODE,
            "each unlocked chunk has its node");
    } }
}


pub fn run(w: &World) { report.suite("machine lifecycle"); lifecycleChecks(w); }
