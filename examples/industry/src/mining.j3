// Several targets can be partly mined at once; each keeps its progress for a second after the last hit.
module industry.mining;
use j3.gfx.voxel.Hit;

pub const SLOTS: int = 8;

pub struct Target {
    elapsed: f32 = 0;
    remaining: f32 = 0;
    duration: f32 = 0.35;
    x: int = -1;
    y: int = -1;
    z: int = -1;
    kind: u8 = 0;
}

pub struct Progress {
    targets: [8]Target;
    current: int = 0;        // slot last advanced, for the crosshair
}

pub fn pause(p: &Progress, dt: f32) {
    for i in 0..SLOTS {
        if p.targets[i].elapsed <= 0 { continue; }
        p.targets[i].remaining -= dt;
        if p.targets[i].remaining <= 0 { p.targets[i].elapsed = 0; p.targets[i].remaining = 0; }
    }
}

// The slot already on this block, else an idle one, else the one closest to expiring.
fn slotFor(p: &Progress, hit: Hit, kind: u8): int {
    let free = -1; let oldest = 0;
    for i in 0..SLOTS {
        let t = p.targets[i];
        if t.elapsed > 0 && t.x == hit.x && t.y == hit.y && t.z == hit.z && t.kind == kind { return i; }
        if t.elapsed <= 0 && free < 0 { free = i; }
        if t.remaining < p.targets[oldest].remaining { oldest = i; }
    }
    if free >= 0 { return free; }
    return oldest;
}

pub fn advance(p: &Progress, hit: Hit, kind: u8, duration: f32, dt: f32): bool {
    let i = slotFor(p, hit, kind);
    p.current = i;
    let t = p.targets[i];
    // A reused slot must not carry the evicted block's progress.
    if t.x != hit.x || t.y != hit.y || t.z != hit.z || t.kind != kind { p.targets[i].elapsed = 0; }
    p.targets[i].x = hit.x; p.targets[i].y = hit.y; p.targets[i].z = hit.z; p.targets[i].kind = kind;
    p.targets[i].duration = duration;
    p.targets[i].remaining = 1;
    p.targets[i].elapsed += dt;
    if p.targets[i].elapsed < duration { return false; }
    p.targets[i].elapsed = 0;
    p.targets[i].remaining = 0;
    return true;
}

pub fn fraction(p: &Progress): f32 { return p.targets[p.current].elapsed / p.targets[p.current].duration; }

pub fn fractionOf(t: &Target): f32 { return t.elapsed / t.duration; }

pub fn create(): Progress {
    return Progress { targets: [Target {}, Target {}, Target {}, Target {}, Target {}, Target {}, Target {}, Target {}] };
}
