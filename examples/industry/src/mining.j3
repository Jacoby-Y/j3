// A single in-progress target survives a short interruption, without advancing off-target.
module industry.mining;
use j3.gfx.voxel.Hit;

pub struct Progress {
    elapsed: f32 = 0;
    remaining: f32 = 0;
    duration: f32 = 0.35;
    x: int = -1;
    y: int = -1;
    z: int = -1;
    kind: u8 = 0;
}

pub fn pause(p: &Progress, dt: f32) {
    if p.elapsed <= 0 { return; }
    p.remaining -= dt;
    if p.remaining <= 0 {
        p.elapsed = 0;
        p.remaining = 0;
    }
}

pub fn advance(p: &Progress, hit: Hit, kind: u8, duration: f32, dt: f32): bool {
    if hit.x != p.x || hit.y != p.y || hit.z != p.z || kind != p.kind {
        p.elapsed = 0;
    }
    p.x = hit.x; p.y = hit.y; p.z = hit.z; p.kind = kind;
    p.duration = duration;
    p.remaining = 1;
    p.elapsed += dt;
    if p.elapsed < duration { return false; }
    p.elapsed = 0;
    p.remaining = 0;
    return true;
}

pub fn fraction(p: &Progress): f32 { return p.elapsed / p.duration; }
