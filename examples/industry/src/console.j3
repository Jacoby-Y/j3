// The F3 debug console: a typed line, suggestions Tab can complete, and the last reply.
// What a command does lives in `industry.commands`; this module only edits the line and draws.
module industry.console;

use j3.game;
use j3.game.Color;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.text.Text;
use industry.bitmap;
use industry.commands;
use industry.inventory.Bag;
use industry.world.World;

const MAX_LINE: int = 60;
const SHOWN: int = 6;
const SCALE: f32 = 2;
const ROW: f32 = 20;

pub struct Console {
    open: bool;
    line: Text;
    reply: Text;        // lines split by '\n', replaced by each command
    pick: int;          // which suggestion Tab writes
}

pub fn create(mem: &Arena): Console {
    return Console { open: false, line: Text.new(mem), reply: Text.new(mem), pick: 0 };
}

fn setOpen(c: &Console, on: bool) {
    c.open = on;
    game.textInput(on);
    game.captureMouse(!on);
}

// Handles the frame's keys; true while open, so the game ignores its own input.
pub fn update(c: &Console, w: &World, bag: &Bag): bool {
    if game.keyPressed(game.Key.F3) { setOpen(c, !c.open); return c.open; }
    if !c.open { return false; }
    if game.keyPressed(game.Key.Escape) { setOpen(c, false); return false; }
    let typed = game.textTyped();
    for at in 0..typed.len {
        if typed[at] >= 32 && typed[at] < 127 && c.line.len() < MAX_LINE { c.line.push(typed[at]); c.pick = 0; }
    }
    if game.keyPressed(game.Key.Backspace) { c.line.pop(); c.pick = 0; }
    if game.keyPressed(game.Key.Down) { c.pick += 1; }
    if game.keyPressed(game.Key.Up) { c.pick -= 1; }
    c.pick = wrap(c, c.pick);
    if game.keyPressed(game.Key.Tab) { complete(c); }
    if game.keyPressed(game.Key.Enter) {
        c.reply.clear();
        commands.run(w, bag, c.line.str(), &c.reply);
        c.line.clear();
        c.pick = 0;
    }
    return true;
}

fn suggestions(c: &Console): int {
    let line = c.line.str();
    let count = 0;
    while count < SHOWN {
        let found = commands.suggestion(line, count);
        if found.len == 0 { break; }
        count += 1;
    }
    return count;
}

fn wrap(c: &Console, pick: int): int {
    let count = suggestions(c);
    if count == 0 { return 0; }
    return ((pick % count) + count) % count;
}

// Replace the word being typed with the picked suggestion. A command gets a space, so its arguments follow.
fn complete(c: &Console) {
    let line = c.line.str();
    let choice = commands.suggestion(line, c.pick);
    if choice.len == 0 { return; }
    let start = commands.wordStart(line);
    c.line.remove(start, c.line.len() - start);
    commands.pushLower(&c.line, choice);
    if start == 0 { c.line.push(32); }
    c.pick = 0;
}

fn rect(x: f32, y: f32, w: f32, h: f32, color: Color) {
    game.setColor(color); game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

pub fn draw(c: &Console) {
    let x: f32 = 16; let y: f32 = 56; let width: f32 = 12 * f32(MAX_LINE + 4);
    let line = c.line.str();
    let count = suggestions(c);
    let rows = 1 + count;
    let reply = c.reply.str();
    let lines = 0; if reply.len > 0 { lines = 1; }
    for at in 0..reply.len { if reply[at] == 10 { lines += 1; } }
    rows += lines;
    rect(x, y, width, f32(rows) * ROW + 12, game.rgb(234, 202, 127));
    rect(x + 2, y + 2, width - 4, f32(rows) * ROW + 8, game.rgb(26, 28, 31));
    bitmap.drawScaled(x + 8, y + 8, "> ", SCALE);
    bitmap.drawScaled(x + 32, y + 8, line, SCALE);
    if (game.ticks() / 400) % 2 == 0 { rect(x + 32 + f32(line.len) * 12, y + 8, 10, 14, game.rgb(246, 238, 215)); }
    for shown in 0..count {
        let name = commands.suggestion(line, shown);
        let row = y + 8 + f32(shown + 1) * ROW;
        if shown == c.pick { rect(x + 6, row - 3, width - 12, ROW, game.rgb(70, 62, 40)); }
        bitmap.drawScaled(x + 32, row, name, SCALE);
    }
    let top = y + 8 + f32(count + 1) * ROW;
    let begin = 0;
    for at in 0..=reply.len {
        if at < reply.len && reply[at] != 10 { continue; }
        bitmap.drawScaled(x + 8, top, reply[begin..at], SCALE);
        top += ROW; begin = at + 1;
    }
}
