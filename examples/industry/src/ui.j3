// Crosshair and a six-slot inventory hotbar with icons from the shared model assets.
module industry.ui;

use j3.game;
use j3.game.Texture;
use j3.game.Font;
use j3.gfx.voxel.Hit;
use industry.data.block;
use industry.machine.dispatch;
use industry.inventory;
use industry.inventory.Bag;
use industry.world;
use industry.world.World;
use j3.ui.Ui;
use j3.math.Vec2;
use industry.bitmap;
use industry.item_icons;
use industry.data.item;
use industry.player.Player;

const SLOT: f32 = 44;
const GAP: f32 = 6;

fn crosshair(sz: Vec2) {
    let x = sz.x * 0.5;
    let y = sz.y * 0.5;
    game.setColor(game.rgb(22, 31, 35));
    game.drawRect(Vec2 { x: x - 11, y: y - 2 }, Vec2 { x: 22, y: 4 });
    game.drawRect(Vec2 { x: x - 2, y: y - 11 }, Vec2 { x: 4, y: 22 });
    game.setColor(game.rgb(245, 247, 237));
    game.drawRect(Vec2 { x: x - 9, y: y - 1 }, Vec2 { x: 18, y: 2 });
    game.drawRect(Vec2 { x: x - 1, y: y - 9 }, Vec2 { x: 2, y: 18 });
}

fn hotbar(sz: Vec2, p: &Player, bag: &Bag, icons: Texture) {
    let n = f32(item.HOTBAR);
    let left = sz.x * 0.5 - (n * SLOT + (n - 1) * GAP) * 0.5;
    let y = sz.y - SLOT - 16;
    for i in 0..item.HOTBAR {
        let x = left + f32(i) * (SLOT + GAP);
        if i == p.slot {
            game.setColor(game.rgb(240, 190, 93));
            game.drawRect(Vec2 { x: x - 3, y: y - 3 }, Vec2 { x: SLOT + 6, y: SLOT + 6 });
        }
        game.setColor(game.rgb(30, 39, 45));
        game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: SLOT, y: SLOT });
        let id = inventory.slotItem(bag, i);
        if id != 0 {
            item_icons.draw(icons, id, x + 2, y + 2, SLOT - 4);
            let count = bag.counts[int(id)];
            bitmap.drawScaled(x + 2, y + 32, `{count}`, 1);
        }
        bitmap.drawScaled(x + 2, y - 12, `{i + 1}`, 1);
    }
}

pub fn draw(p: &Player, bag: &Bag, icons: Texture, coins: int, mineTime: f32, unlockCost: int) {
    let sz = game.windowSize();
    crosshair(sz);
    bitmap.drawScaled(16, 16, `COINS {coins}`, 2);
    if mineTime > 0 {
        game.setColor(game.rgb(242, 180, 82));
        game.drawRect(Vec2 { x: sz.x * 0.5 - 25, y: sz.y * 0.5 + 17 },
            Vec2 { x: mineTime * 50, y: 3 });
    }
    hotbar(sz, p, bag, icons);
    if unlockCost >= 0 {
        let prompt = Ui.begin(Font { raw: 0 }, sz.x * 0.5 - 66, sz.y * 0.5 + 45);
        unlockPrompt(&prompt, unlockCost, coins);
    }
}

@j3ui unlockPrompt(ui: &Ui, cost: int, coins: int) {
    if coins >= cost { bitmap.draw(ui.x, ui.y, `[E]: UNLOCK {cost} COINS`); }
    else { bitmap.draw(ui.x, ui.y, `NEED {cost} COINS`); }
}

// One centered line above the hotbar; empty draws nothing.
pub fn note(message: string) {
    if message.len == 0 { return; }
    let sz = game.windowSize();
    bitmap.drawScaled((sz.x - f32(message.len * 12)) * 0.5, sz.y - 108, message, 2);
}

pub fn context(w: &World, hit: Hit, selected: u8) {
    if !hit.ok { return; }
    let id = world.get(w, hit.x, hit.y, hit.z);
    let detail: string = "";
    let action: string = "";
    if block.isNode(id) || block.isVein(id) {
        detail = item.name(item.fromOre(id));
        action = "SELECT PICKAXE";
        if selected == item.PICKAXE { action = "[LMB]: Mine"; }
    }
    if world.machine(id) {
        let info = dispatch.describe(w, world.anchorAt(w, hit.x, hit.y, hit.z));
        detail = info.detail; action = info.action;
    }
    if detail.len == 0 { return; }
    let sz = game.windowSize();
    let length = detail.len;
    if action.len > length { length = action.len; }
    let width = f32(length * 12 + 24);
    let scale: f32 = 1;
    if width > sz.x - 32 { scale = (sz.x - 32) / width; }
    let panel = Ui.begin(Font { raw: 0 }, (sz.x - width * scale) * 0.5, sz.y - 72 - 56 * scale);
    contextPanel(&panel, detail, action, width, scale);
}

@j3ui contextPanel(ui: &Ui, detail: string, action: string, width: f32, scale: f32) {
    game.setColor(game.rgba(18, 26, 30, 220));
    game.drawRect(Vec2 { x: ui.x, y: ui.y }, Vec2 { x: width * scale, y: 56 * scale });
    bitmap.drawScaled(ui.x + 12 * scale, ui.y + 10 * scale, detail, 2 * scale);
    bitmap.drawScaled(ui.x + 12 * scale, ui.y + 32 * scale, action, 2 * scale);
}
