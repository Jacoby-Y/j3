// Everything the renderer keeps for the world: section meshes, LOD, culling lists, instance
// buffers. Gameplay code never reads these; edits only mark sections dirty.
module industry.render_cache;

use j3.gfx.Mesh;
use j3.math.{ Vec3, Mat4 };
use j3.memory.Arena;

pub struct TerrainCache { vertices: []f32; address: ptr; }

pub struct RenderCache {
    sectionCpu: []TerrainCache;
    chunkShadowMeshes: []Mesh;
    chunkSectionCount: []int;
    chunkVisibleCount: []int;
    sectionVisible: []u8;
    sectionMeshes: []Mesh;
    sectionLodMeshes: []Mesh;
    sectionMin: []Vec3;
    sectionMax: []Vec3;
    sectionDirty: []u8;
    sectionVersion: []int;  // bumped on every edit, so a mesh built from older cells is dropped
    sectionBusy: []u8;      // a mesh job for this section is running
    activeSections: []int;
    sectionSlots: []int;
    sectionCount: int;
    nodeModels: []Mat4;
    drawMatrices: []Mat4;
    batchStart: []int;
    drawCounts: []int;
    chunkLod: []u8;
    lodMask: []u8;
    chunkDirty: []u8;
    scratch: []f32;
    dirty: bool;
}

pub fn create(mem: &Arena, sections: int, chunks: int, lodMask: int, nodeModels: int, scratch: int, starts: []int): RenderCache {
    let models = starts.len - 1;
    return RenderCache {
        sectionCpu: mem.alloc::<TerrainCache>(sections),
        chunkShadowMeshes: mem.alloc::<Mesh>(chunks),
        chunkSectionCount: mem.alloc::<int>(chunks),
        chunkVisibleCount: mem.alloc::<int>(chunks),
        sectionVisible: mem.alloc::<u8>(sections),
        sectionMeshes: mem.alloc::<Mesh>(sections),
        sectionLodMeshes: mem.alloc::<Mesh>(sections),
        sectionMin: mem.alloc::<Vec3>(sections),
        sectionMax: mem.alloc::<Vec3>(sections),
        sectionDirty: mem.alloc::<u8>(sections),
        sectionVersion: mem.alloc::<int>(sections),
        sectionBusy: mem.alloc::<u8>(sections),
        activeSections: mem.alloc::<int>(sections),
        sectionSlots: mem.alloc::<int>(sections),
        sectionCount: 0,
        nodeModels: mem.alloc::<Mat4>(nodeModels),
        drawMatrices: mem.alloc::<Mat4>(starts[models]),
        batchStart: starts,
        drawCounts: mem.alloc::<int>(models),
        chunkLod: mem.alloc::<u8>(chunks),
        lodMask: mem.alloc::<u8>(lodMask),
        chunkDirty: mem.alloc::<u8>(chunks),
        scratch: mem.alloc::<f32>(scratch),
        dirty: true,
    };
}
