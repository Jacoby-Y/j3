// Bounded chunk backing grid; only unlocked chunks are generated or editable. Machine state and
// render caches are separate structs embedded here, so `w.belts` and `w.sectionMeshes` still work.
module industry.world;

use j3.gfx.voxel;
use j3.gfx.voxel.Hit;
use j3.math.Vec3;
use j3.memory.Arena;
use industry.data.block;
use industry.data.content;
use industry.data.defs;
use industry.data.item;
use industry.inventory;
use industry.machine.state;
use industry.machine.state.Machines;
use industry.render_cache;
use industry.render_cache.RenderCache;

pub const CHUNK: int = 48;
pub const CHUNKS: int = 9;
pub const SX: int = CHUNK * CHUNKS;
pub const SY: int = 132;
pub const SZ: int = SX;
pub const VOXEL: f32 = 0.5;
// Machines and resource nodes are this many voxels wide and deep.
pub const FOOTPRINT: int = 2;
pub const CENTER: int = 4;
pub const GROUND: int = 103;
pub const MAX_MACHINES: int = 8192;
pub const SECTION_X: int = 24;
pub const SECTION_Y: int = 16;
pub const SECTIONS_X: int = SX / SECTION_X;
pub const SECTIONS_Y: int = (SY + SECTION_Y - 1) / SECTION_Y;
pub const SECTION_Z: int = SECTION_X;
pub const SECTIONS_PER_CHUNK: int = CHUNK / SECTION_X;
pub const SECTION_COUNT: int = SECTIONS_X * SECTIONS_X * SECTIONS_Y;
const STATE_HASH: int = 16384;
pub const MAX_STORES: int = 128;
// 6 noise fields x (SY / 4 + 3) lattice rows x 13 x 13 points; `gen.caves` fills it per chunk.
pub const CAVE_TABLE: int = 6 * 36 * 13 * 13;
pub const MAX_FACES: int = 160000;

pub struct World {
    seed: int;
    coins: int;
    unlocked: []u8;
    ringTarget: int;      // ring being opened chunk by chunk (0 = none)
    ringWait: f32;        // seconds until the next chunk of that ring
    genActive: bool;      // a chunk is being generated on a worker (`mesher.generate`)
    genX: int;
    genZ: int;
    caveNy: int;          // lattice rows of the chunk being carved
    caveTable: []f32;     // its cave noise lattice (kept apart from `scratch`, which meshing uses every frame)
    cells: []u8;          // block id of every voxel
    facing: []u8;         // machine direction, per machine cell
    part: []u8;           // machine part offset from its anchor, per machine cell
    use machines: Machines;
    use cache: RenderCache;
}

pub fn create(mem: &Arena): World { return createSeed(mem, 1); }

// Instance buffer room for one model's batch.
fn batchCapacity(model: int): int {
    let def = defs.modelInfo(model); let batch = def.batch;
    if batch == defs.BATCH_MACHINE { return MAX_MACHINES; }
    if batch == defs.BATCH_CARGO { return MAX_MACHINES * state.QUEUE; }
    if batch == defs.BATCH_NODE { return CHUNKS * CHUNKS; }
    return 0;
}

pub fn createSeed(mem: &Arena, seed: int): World {
    content.load();
    let models = defs.modelCount();
    let starts = mem.alloc::<int>(models + 1);
    for model in 0..models { starts[model + 1] = starts[model] + batchCapacity(model); }
    return World {
        seed: seed,
        coins: 0,
        ringTarget: 0,
        ringWait: 0,
        genActive: false,
        genX: 0,
        genZ: 0,
        caveNy: 0,
        caveTable: mem.alloc::<f32>(CAVE_TABLE),
        unlocked: mem.alloc::<u8>(CHUNKS * CHUNKS),
        cells: mem.alloc::<u8>(SX * SY * SZ),
        facing: mem.alloc::<u8>(SX * SY * SZ),
        part: mem.alloc::<u8>(SX * SY * SZ),
        machines: state.create(mem, MAX_MACHINES, STATE_HASH, item.kinds()),
        cache: render_cache.create(mem, SECTION_COUNT, CHUNKS * CHUNKS, CHUNK * SY,
            CHUNKS * CHUNKS * defs.oreCount(), MAX_FACES * 60, starts),
    };
}

pub fn get(w: &World, x: int, y: int, z: int): u8 {
    return voxel.get(w.cells, SX, SY, SZ, x, y, z);
}

pub fn set(w: &World, x: int, y: int, z: int, id: u8) {
    // Multi-cell machines must go through placeMachine.
    if machine(id) { return; }
    if !editable(w, x, y, z) { return; }
    if machine(get(w, x, y, z)) {
        breakAt(w, x, y, z);
        if machine(get(w, x, y, z)) { return; }
    }
    let at = voxel.index(x, y, z, SX, SZ);
    if w.cells[at] == id { return; }
    w.cells[at] = id;
    w.facing[at] = 0;
    w.part[at] = 0;
    markDirty(w, x, y, z);
}

pub fn canPlaceConveyor(w: &World, x: int, y: int, z: int): bool {
    return canPlaceMachine(w, x, y, z, block.CONVEYOR);
}

pub fn height(id: u8): int { return defs.blockHeight(id); }

pub fn canPlaceMachine(w: &World, x: int, y: int, z: int, id: u8): bool {
    if !machine(id) || w.machineCount >= MAX_MACHINES { return false; }
    if storage(id) && w.storeCount >= MAX_STORES { return false; }
    for dy in 0..height(id) { for dz in 0..FOOTPRINT { for dx in 0..FOOTPRINT {
        if !editable(w, x + dx, y + dy, z + dz) ||
            get(w, x + dx, y + dy, z + dz) != block.AIR { return false; }
    } } }
    return true;
}

// The anchor is the low-X, low-Z cell. Each part remembers its offset from it.
pub fn placeConveyor(w: &World, x: int, y: int, z: int, dir: u8): bool {
    return placeMachine(w, x, y, z, dir, block.CONVEYOR);
}

pub fn placeMachine(w: &World, x: int, y: int, z: int, dir: u8, id: u8): bool {
    if !canPlaceMachine(w, x, y, z, id) { return false; }
    let anchor = voxel.index(x, y, z, SX, SZ);
    allocateSlot(w, anchor, id);
    if storage(id) { w.storeCount += 1; }
    for dy in 0..height(id) { for dz in 0..FOOTPRINT { for dx in 0..FOOTPRINT {
        let at = voxel.index(x + dx, y + dy, z + dz, SX, SZ);
        w.cells[at] = id;
        w.facing[at] = dir % 4;
        w.part[at] = partCode(dx, dy, dz);
    } } }
    markFootprint(w, x, y, z, height(id));
    return true;
}

// Swap a structure for its other tier in place, keeping its state. False when a smaller store would lose items.
// Wires are dropped, since only one tier of a pair is electric.
pub fn swapMachine(w: &World, anchor: int, id: u8): bool {
    let slot = slotOf(w, anchor);
    if slot <= 0 || block.twin(w.cells[anchor]) != id { return false; }
    if storage(id) { for i in defs.blockStacks(id)..inventory.SLOTS {
        if w.storedSlots[slot * inventory.SLOTS + i] != 0 { return false; }
    } }
    dropWires(w, slot);
    w.slotKind[slot] = id;
    let x = anchorX(anchor); let y = anchorY(anchor); let z = anchorZ(anchor);
    for dy in 0..height(id) { for dz in 0..FOOTPRINT { for dx in 0..FOOTPRINT {
        w.cells[voxel.index(x + dx, y + dy, z + dz, SX, SZ)] = id;
    } } }
    markFootprint(w, x, y, z, height(id));
    return true;
}

// A bag whose items remain keeps its machine, so nothing is destroyed with a full inventory.
fn storageEmpty(w: &World, slot: int): bool {
    for id in 1..item.kinds() { if w.stored[slot * item.kinds() + id] > 0 { return false; } }
    return true;
}

pub fn breakAt(w: &World, x: int, y: int, z: int) {
    if !editable(w, x, y, z) { return; }
    let at = voxel.index(x, y, z, SX, SZ);
    if block.isNode(w.cells[at]) { return; }
    if !machine(w.cells[at]) {
        set(w, x, y, z, block.AIR);
        return;
    }
    let part = int(w.part[at]);
    let ax = x - partDx(part); let az = z - partDz(part); let ay = y - partDy(part);
    let tall = height(w.cells[at]);
    let anchor = voxel.index(ax, ay, az, SX, SZ);
    let slot = slotOf(w, anchor);
    if storage(w.cells[anchor]) {
        if slot <= 0 || !storageEmpty(w, slot) { return; }
        w.storeCount -= 1;
    }
    releaseSlot(w, anchor);
    for dy in 0..tall { for dz in 0..FOOTPRINT { for dx in 0..FOOTPRINT {
        let i = voxel.index(ax + dx, ay + dy, az + dz, SX, SZ);
        w.cells[i] = block.AIR;
        w.facing[i] = 0;
        w.part[i] = 0;
    } } }
    markFootprint(w, ax, ay, az, tall);
}

// Footprint cells are 2 x 2 wide; both corners bound the sections that change.
fn markFootprint(w: &World, x: int, y: int, z: int, tall: int) {
    for dy in 0..tall {
        markDirty(w, x, y + dy, z);
        markDirty(w, x + FOOTPRINT - 1, y + dy, z + FOOTPRINT - 1);
    }
}

// Part offsets: low bit is X, next bit Z, the rest the layer above the anchor.
pub fn partCode(dx: int, dy: int, dz: int): u8 { return u8(dx + dz * FOOTPRINT + dy * FOOTPRINT * FOOTPRINT); }
pub fn partDx(part: int): int { return part % FOOTPRINT; }
pub fn partDz(part: int): int { return (part / FOOTPRINT) % FOOTPRINT; }
pub fn partDy(part: int): int { return part / (FOOTPRINT * FOOTPRINT); }

// Chebyshev distance of a chunk from the start chunk.
pub fn ring(cx: int, cz: int): int {
    let rx = cx - CENTER; if rx < 0 { rx = -rx; }
    let rz = cz - CENTER; if rz < 0 { rz = -rz; }
    if rz > rx { return rz; }
    return rx;
}

pub fn isConveyorAnchor(w: &World, x: int, y: int, z: int): bool {
    if !block.isBelt(get(w, x, y, z)) { return false; }
    return w.part[voxel.index(x, y, z, SX, SZ)] == 0;
}

pub fn conveyorPart(w: &World, x: int, y: int, z: int): u8 {
    if !machine(get(w, x, y, z)) { return 0; }
    return w.part[voxel.index(x, y, z, SX, SZ)];
}

pub fn direction(w: &World, x: int, y: int, z: int): u8 {
    if !voxel.inside(x, y, z, SX, SY, SZ) { return 0; }
    return w.facing[voxel.index(x, y, z, SX, SZ)];
}

pub fn pick(w: &World, eye: Vec3, dir: Vec3): Hit {
    return voxel.ray(w.cells, SX, SY, SZ, eye, dir, 5.0 / VOXEL);
}

pub fn storage(id: u8): bool { return defs.blockIsStorage(id); }

pub fn machine(id: u8): bool { return defs.blockIsMachine(id); }

pub fn active(w: &World, x: int, z: int): bool {
    if x < 0 || z < 0 || x >= SX || z >= SZ { return false; }
    return w.unlocked[x / CHUNK + (z / CHUNK) * CHUNKS] != 0;
}

pub fn editable(w: &World, x: int, y: int, z: int): bool {
    return y > 0 && y < SY && active(w, x, z);
}

pub fn anchorX(at: int): int { return at % SX; }
pub fn anchorY(at: int): int { return at / (SX * SZ); }
pub fn anchorZ(at: int): int { return (at / SX) % SZ; }

pub fn anchorAt(w: &World, x: int, y: int, z: int): int {
    if !machine(get(w, x, y, z)) { return -1; }
    let part = int(w.part[voxel.index(x, y, z, SX, SZ)]);
    return voxel.index(x - partDx(part), y - partDy(part), z - partDz(part), SX, SZ);
}

// Machine slots: every placed machine owns one slot, found from its anchor cell by hash.
fn bucket(anchor: int): int { return (anchor * 2654435761) % STATE_HASH; }

// Slot of the machine anchored at `anchor`; 0 when there is none.
pub fn slotOf(w: &World, anchor: int): int {
    if anchor < 0 { return 0; }
    let key = anchor + 1; let at = bucket(anchor);
    for probe in 0..STATE_HASH {
        if w.hashKeys[at] == 0 { return 0; }
        if w.hashKeys[at] == key { return int(w.hashSlots[at]); }
        at = (at + 1) % STATE_HASH;
    }
    return 0;
}

// Anchor cell of a slot, or -1 when the slot is free.
pub fn slotAnchor(w: &World, slot: int): int { return w.slotOwner[slot] - 1; }

// A slot starts and ends clean: nothing of the previous machine survives into the next.
fn resetSlot(w: &World, slot: int) {
    w.belts[slot].count = 0;
    w.drills[slot].count = 0; w.drills[slot].item = 0; w.drills[slot].clock = 0;
    w.kilns[slot].stock = 0; w.kilns[slot].stockKind = 0; w.kilns[slot].fuel = 0;
    w.kilns[slot].burn = 0; w.kilns[slot].item = 0; w.kilns[slot].clock = 0;
    w.kilns[slot].out = 0; w.kilns[slot].outKind = 0;
    w.gens[slot].fuel = 0; w.gens[slot].burn = 0;
    w.powered[slot] = 0; w.powerRoot[slot] = slot;
    dropWires(w, slot);
    for id in 0..item.kinds() { w.stored[slot * item.kinds() + id] = 0; }
    for position in 0..inventory.SLOTS { w.storedSlots[slot * inventory.SLOTS + position] = 0; w.storedAmounts[slot * inventory.SLOTS + position] = 0; }
}

// Remove every wire that ends at `slot`.
fn dropWires(w: &World, slot: int) {
    let i = 0;
    while i < w.wireCount {
        if int(w.wireA[i]) == slot || int(w.wireB[i]) == slot {
            w.wireCount -= 1;
            w.wireA[i] = w.wireA[w.wireCount]; w.wireB[i] = w.wireB[w.wireCount];
            w.netDirty = true;
        } else { i += 1; }
    }
}

fn allocateSlot(w: &World, anchor: int, id: u8) {
    let slot = 1;
    while slot <= MAX_MACHINES && w.slotOwner[slot] != 0 { slot += 1; }
    let at = bucket(anchor);
    while w.hashKeys[at] > 0 { at = (at + 1) % STATE_HASH; }
    w.hashKeys[at] = anchor + 1; w.hashSlots[at] = u16(slot);
    w.slotOwner[slot] = anchor + 1;
    w.slotKind[slot] = id;
    if slot > w.slotHigh { w.slotHigh = slot; }
    w.machineCount += 1;
    resetSlot(w, slot);
}

fn releaseSlot(w: &World, anchor: int) {
    let at = bucket(anchor);
    for probe in 0..STATE_HASH {
        if w.hashKeys[at] == anchor + 1 {
            let slot = int(w.hashSlots[at]);
            resetSlot(w, slot);
            w.slotOwner[slot] = 0;
            w.slotKind[slot] = 0;
            w.hashKeys[at] = -1; w.hashSlots[at] = 0;
            w.machineCount -= 1;
            while w.slotHigh > 0 && w.slotOwner[w.slotHigh] == 0 { w.slotHigh -= 1; }
            return;
        }
        at = (at + 1) % STATE_HASH;
    }
}

pub fn sectionIndex(sx: int, sy: int, sz: int): int {
    return sx + sz * SECTIONS_X + sy * SECTIONS_X * SECTIONS_X;
}

pub fn sectionChunk(section: int): int {
    let sx = section % SECTIONS_X;
    let sz = (section / SECTIONS_X) % SECTIONS_X;
    return sx / SECTIONS_PER_CHUNK + sz / SECTIONS_PER_CHUNK * CHUNKS;
}

fn markSection(w: &World, section: int) {
    w.sectionDirty[section] = 1;
    w.sectionVersion[section] += 1;
}

fn dirtySection(w: &World, sx: int, sy: int, sz: int) {
    if sx < 0 || sx >= SECTIONS_X || sy < 0 || sy >= SECTIONS_Y || sz < 0 || sz >= SECTIONS_X { return; }
    markSection(w, sectionIndex(sx, sy, sz));
    w.chunkDirty[sx / SECTIONS_PER_CHUNK + sz / SECTIONS_PER_CHUNK * CHUNKS] = 1; w.dirty = true;
}

// Newly generated cells affect only the bordering sections of existing chunks.
pub fn dirtyGeneratedChunk(w: &World, cx: int, cz: int) {
    for sy in 0..SECTIONS_Y { for sz in cz * SECTIONS_PER_CHUNK - 1..(cz + 1) * SECTIONS_PER_CHUNK + 1 { for sx in cx * SECTIONS_PER_CHUNK - 1..(cx + 1) * SECTIONS_PER_CHUNK + 1 {
        dirtySection(w, sx, sy, sz);
    } } }
}

pub fn dirtyChunk(w: &World, cx: int, cz: int) {
    if cx < 0 || cz < 0 || cx >= CHUNKS || cz >= CHUNKS { return; }
    w.chunkDirty[cx + cz * CHUNKS] = 1; w.dirty = true;
    for sy in 0..SECTIONS_Y { for dz in 0..SECTIONS_PER_CHUNK { for dx in 0..SECTIONS_PER_CHUNK {
        markSection(w, sectionIndex(cx * SECTIONS_PER_CHUNK + dx, sy, cz * SECTIONS_PER_CHUNK + dz));
    } } }
}

// Faces and AO can change only within one voxel of an edited cell.
pub fn markDirty(w: &World, x: int, y: int, z: int) {
    let x0 = x - 1; let x1 = x + 1; let y0 = y - 1; let y1 = y + 1; let z0 = z - 1; let z1 = z + 1;
    if x0 < 0 { x0 = 0; } if x1 >= SX { x1 = SX - 1; }
    if y0 < 0 { y0 = 0; } if y1 >= SY { y1 = SY - 1; }
    if z0 < 0 { z0 = 0; } if z1 >= SZ { z1 = SZ - 1; }
    for sy in y0 / SECTION_Y..y1 / SECTION_Y + 1 {
        for sz in z0 / SECTION_Z..z1 / SECTION_Z + 1 {
            for sx in x0 / SECTION_X..x1 / SECTION_X + 1 {
                dirtySection(w, sx, sy, sz);
            }
        }
    }
    w.dirty = true;
}
