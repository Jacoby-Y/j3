// Fixed-seed scenes run the production update and draw paths with identical settings.
module industry.bench.benchmark;
use j3.app.App;
use j3.memory.Arena;
use j3.game;
use j3.sys;
use j3.text;
use j3.io.printLn;
use j3.io;
use j3.result.Result;
use j3.math.Vec3;
use j3.gfx.voxel;
use industry.gameplay;
use industry.session;
use industry.session.Game;
use industry.chunks;
use industry.world;
use industry.render;
use industry.gen.caves;
use industry.gen.elevation;
use industry.data.block;
use industry.data.item;

struct Benchmark { game: Game; profile: bool; frames: int; updates: int; updateUs: int; drawUs: int; scene: string; limit: int; }

fn sceneName(mem: &Arena): string {
    match io.readFile("target/benchmark-case.txt", mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) {}
    }
    for i in 1..sys.argCount() {
        let arg = sys.arg(i);
        if text.same(arg, "start") || text.same(arg, "surface") || text.same(arg, "cave") || text.same(arg, "entrance") || text.same(arg, "factory") { return arg; }
    }
    return "start";
}

fn machine(g: &Game, x: int, z: int, id: u8, dir: u8): int {
    let y = world.GROUND + 4;
    if !world.placeMachine(&g.world, x, y, z, dir, id) { sys.panic("benchmark machine placement failed"); }
    return voxel.index(x, y, z, world.SX, world.SZ);
}

fn factory(g: &Game) {
    // Thirty-two parallel lines: a fed furnace, 32 loaded belts, and a running drill.
    // Resources float above the flat ground so existing surface nodes stay untouched.
    for line in 0..32 {
        let z = 148 + line * 4; let x = 154;
        let furnace = machine(g, x, z, block.FURNACE, 1);
        let fs = world.slotOf(&g.world, furnace);
        g.world.kilns[fs].stock = 10; g.world.kilns[fs].stockKind = item.COPPER; g.world.kilns[fs].fuel = 10;
        for belt in 0..32 {
            let at = machine(g, x + 2 + belt * 2, z, block.CONVEYOR, 1);
            let slot = world.slotOf(&g.world, at); g.world.belts[slot].count = 3;
            for q in 0..3 {
                g.world.belts[slot].cargo[q] = item.COPPER;
                g.world.belts[slot].entry[q] = 1;
                g.world.belts[slot].progress[q] = 1.8 - f32(q) * 0.65;
            }
        }
        if line < 16 { machine(g, x + 66, z, block.CONTAINER, 0); }
        if line >= 16 && line < 24 { machine(g, x + 66, z, block.MARKET, 0); }
        let drill = machine(g, x - 4, z, block.DRILL, 3);
        for dy in 0..2 { for dz in 0..2 { for dx in 0..2 {
            world.set(&g.world, x - 6 + dx, world.GROUND + 4 + dy, z + dz, block.COPPER_NODE);
        } } }
    }
}

fn boot(mem: &Arena): Benchmark {
    let name = sceneName(mem); let g = session.bootSeed(mem, 42);
    if !text.same(name, "start") {
        for pass in 0..9 { for cz in 0..world.CHUNKS { for cx in 0..world.CHUNKS { chunks.unlock(&g.world, cx, cz); } } }
        g.player.body.pos = Vec3.xyz(216, f32(world.GROUND) + 46, 254); g.player.pitch = -0.65;
    }
    if text.same(name, "cave") {
        let spot = caves.find(&g.world, world.CENTER, world.CENTER);
        g.player.body.pos = spot + Vec3.xyz(0, 1, 0); g.player.pitch = -0.1; g.player.yaw = -0.7;
    }
    if text.same(name, "entrance") {
        let cx = 0; let cz = 0;
        while !caves.entrance(42, cx, cz) { cx += 1; if cx == world.CHUNKS { cx = 0; cz += 1; } }
        let mouth = caves.entranceAt(42, cx, cz);
        g.player.body.pos = mouth + Vec3.xyz(-6, 8, 6);
        g.player.pitch = -0.45; g.player.yaw = 0.75;
    }
    if text.same(name, "factory") { factory(&g); g.player.body.pos = Vec3.xyz(188, 132, 295); g.player.pitch = -0.45; }
    // A file named target/benchmark-profile.txt turns on per-stage machine timing.
    let profile = io.exists("target/benchmark-profile.txt");
    g.profile = profile;
    let limit = 600; if text.same(name, "factory") { limit = 180; }
    return Benchmark { game: g, profile: profile, frames: 0, updates: 0, updateUs: 0, drawUs: 0, scene: name, limit: limit };
}

fn startup(b: &Benchmark) {
    let begin = game.micros(); session.startup(&b.game);
    let startupMs = f32(game.micros() - begin) / 1000;
    let edit = game.micros();
    world.set(&b.game.world, 216, world.GROUND, 216, block.STONE); render.rebuild(&b.game.world, 0);
    let editMs = f32(game.micros() - edit) / 1000;
    printLn(`BENCH scene={b.scene} seed=42 startup_ms={startupMs} edit_ms={editMs} machines={b.game.world.machineCount}`);
}

fn update(b: &Benchmark, dt: f32) {
    // Fixed simulation ticks keep factory occupancy comparable at different FPS.
    let begin = game.micros(); gameplay.update(&b.game, f32(1) / 60);
    if b.frames == 60 { for stage in 0..4 { b.game.stageUs[stage] = 0; } }
    if b.frames >= 60 { b.updateUs += game.micros() - begin; b.updates += 1; }
}
fn draw(b: &Benchmark) {
    let begin = game.micros(); gameplay.draw(&b.game);
    if b.frames >= 60 { b.drawUs += game.micros() - begin; }
    b.frames += 1;
    if b.frames == b.limit {
        let updateMs = f32(b.updateUs) / f32(b.updates) / 1000;
        let drawMs = f32(b.drawUs) / f32(b.limit - 60) / 1000;
        printLn(`BENCH update_ms={updateMs} draw_submit_ms={drawMs}`);
        if b.profile {
            let powerMs = f32(b.game.stageUs[0]) / f32(b.updates) / 1000;
            let furnaceMs = f32(b.game.stageUs[1]) / f32(b.updates) / 1000;
            let beltMs = f32(b.game.stageUs[2]) / f32(b.updates) / 1000;
            let drillMs = f32(b.game.stageUs[3]) / f32(b.updates) / 1000;
            printLn(`BENCH power_ms={powerMs} furnace_ms={furnaceMs} transport_ms={beltMs} drill_ms={drillMs}`);
        }
    }
}
fn main() {
    let app = App<Benchmark>.create("industry FPS benchmark", 1280, 720, boot);
    app.useGl(); app.startup(startup); app.always(update); app.draw(draw); app.run();
}
