// Counted stacks with persistent positions; the first six positions are the hotbar. `counts` is the total
// per item, `slots` and `amounts` say where and how many: an item may fill several slots. Code may change
// `counts` directly; `sync` then settles the slots to match.
module industry.inventory;
use j3.memory.Arena;
use industry.data.item;

pub const SLOTS: int = 36;
pub const STACK: int = 99;
// What a full bag can hold; a bag is limited by its slots alone.
pub const CAPACITY: int = 36 * 99;
pub struct Bag { counts: []int; slots: []u8; amounts: []int; stacks: int = 0; }   // stacks 0 = all SLOTS

// How many stack slots the bag has.
pub fn size(bag: &Bag): int { if bag.stacks > 0 { return bag.stacks; } return SLOTS; }
pub fn limit(bag: &Bag): int { return size(bag) * STACK; }

pub fn create(mem: &Arena): Bag { return Bag { counts: mem.alloc::<int>(item.kinds()), slots: mem.alloc::<u8>(SLOTS), amounts: mem.alloc::<int>(SLOTS) }; }

pub fn total(bag: &Bag): int {
    let sum = 0;
    for id in 1..item.kinds() { sum += bag.counts[id]; }
    return sum;
}

// How many more of `id` the bag takes: room in its stacks and free slots, within `limit`.
pub fn room(bag: &Bag, id: u8): int {
    sync(bag);
    let space = 0;
    for slot in 0..size(bag) {
        if bag.slots[slot] == 0 { space += STACK; }
        else if bag.slots[slot] == id { space += STACK - bag.amounts[slot]; }
    }
    let left = limit(bag) - total(bag);
    if space > left { return left; }
    return space;
}

pub fn add(bag: &Bag, id: u8, amount: int): int {
    if id == 0 || int(id) >= item.kinds() || amount <= 0 { return 0; }
    let moved = amount;
    let free = room(bag, id);
    if moved > free { moved = free; }
    bag.counts[int(id)] += moved;
    sync(bag);
    return moved;
}

pub fn move(source: &Bag, dest: &Bag, id: u8, amount: int): int {
    if id == 0 || int(id) >= item.kinds() || amount <= 0 { return 0; }
    let moved = amount;
    if moved > source.counts[int(id)] { moved = source.counts[int(id)]; }
    moved = add(dest, id, moved);
    source.counts[int(id)] -= moved;
    sync(source);
    return moved;
}

// Settle slots with `counts`: surplus goes to the item's first slot (or a free one), a shortfall comes
// off its last slots.
pub fn sync(bag: &Bag) {
    for slot in 0..size(bag) { if bag.slots[slot] == 0 { bag.amounts[slot] = 0; } }
    for id in 1..item.kinds() {
        let held = 0;
        for slot in 0..size(bag) { if int(bag.slots[slot]) == id { held += bag.amounts[slot]; } }
        let diff = bag.counts[id] - held;
        if diff == 0 { continue; }
        if diff > 0 {
            // Top up this item's stacks, then open new ones.
            for slot in 0..size(bag) {
                if int(bag.slots[slot]) != id || bag.amounts[slot] >= STACK { continue; }
                let fill = STACK - bag.amounts[slot]; if fill > diff { fill = diff; }
                bag.amounts[slot] += fill; diff -= fill;
            }
            for slot in 0..size(bag) {
                if diff == 0 { break; }
                if bag.slots[slot] != 0 { continue; }
                let open = STACK; if open > diff { open = diff; }
                bag.slots[slot] = u8(id); bag.amounts[slot] = open; diff -= open;
            }
            continue;
        }
        let slot = size(bag) - 1;
        while slot >= 0 && diff < 0 {
            if int(bag.slots[slot]) == id {
                let cut = -diff; if cut > bag.amounts[slot] { cut = bag.amounts[slot]; }
                bag.amounts[slot] -= cut; diff += cut;
                if bag.amounts[slot] == 0 { bag.slots[slot] = 0; }
            }
            slot -= 1;
        }
    }
}

pub fn slotItem(bag: &Bag, slot: int): u8 {
    if slot < 0 || slot >= size(bag) { return 0; }
    sync(bag);
    return bag.slots[slot];
}

pub fn swap(bag: &Bag, source: int, dest: int) {
    if source < 0 || source >= size(bag) || dest < 0 || dest >= size(bag) { return; }
    sync(bag);
    let id = bag.slots[source]; let n = bag.amounts[source];
    bag.slots[source] = bag.slots[dest]; bag.amounts[source] = bag.amounts[dest];
    bag.slots[dest] = id; bag.amounts[dest] = n;
}

// What a recipe takes: ingredient `part` of `id` and how many.
fn ingredient(id: u8, part: int): u8 {
    let items: [5]u8 = [item.rawFor(id), item.COPPER_INGOT, item.IRON_INGOT, item.STONE, item.COPPER_WIRE];
    return items[part];
}
fn needed(id: u8, part: int): int {
    let amounts: [5]int = [item.recipeCost(id), item.recipeIngots(id), item.recipeIron(id), item.recipeStone(id), item.recipeWire(id)];
    return amounts[part];
}

// How many of recipe `id` the bag can pay right now; 0 for anything that is no recipe.
pub fn times(bag: &Bag, id: u8): int {
    let most = 0; let found = false;
    for part in 0..5 {
        let need = needed(id, part);
        if need <= 0 { continue; }
        let have = bag.counts[int(ingredient(id, part))] / need;
        if !found || have < most { most = have; }
        found = true;
    }
    return most;
}

pub fn canCraft(bag: &Bag, id: u8): bool { return times(bag, id) > 0; }

// Take the ingredients of one `id` out of the bag.
pub fn pay(bag: &Bag, id: u8) {
    for part in 0..5 { bag.counts[int(ingredient(id, part))] -= needed(id, part); }
    sync(bag);
}

// Give back the ingredients of one `id`.
pub fn refund(bag: &Bag, id: u8) {
    for part in 0..5 { bag.counts[int(ingredient(id, part))] += needed(id, part); }
    sync(bag);
}

pub fn craft(bag: &Bag, id: u8): bool {
    if !canCraft(bag, id) { return false; }
    pay(bag, id);
    add(bag, id, 1);
    sync(bag);
    return true;
}

// Take up to `amount` out of the stack at `slot`; returns how many came out.
pub fn takeAt(bag: &Bag, slot: int, amount: int): int {
    let id = slotItem(bag, slot);
    if id == 0 || amount <= 0 { return 0; }
    if amount > bag.amounts[slot] { amount = bag.amounts[slot]; }
    bag.counts[int(id)] -= amount;
    bag.amounts[slot] -= amount;
    if bag.amounts[slot] == 0 { bag.slots[slot] = 0; }
    return amount;
}

// Put up to `amount` of `id` at `slot`, which must be free or already hold `id`; returns how many fit.
pub fn putAt(bag: &Bag, slot: int, id: u8, amount: int): int {
    if slot < 0 || slot >= size(bag) || id == 0 || amount <= 0 { return 0; }
    let there = slotItem(bag, slot);
    if there != 0 && there != id { return 0; }
    let free = room(bag, id);
    if amount > free { amount = free; }
    if amount > STACK - bag.amounts[slot] { amount = STACK - bag.amounts[slot]; }
    if amount <= 0 { return 0; }
    bag.slots[slot] = id;
    bag.amounts[slot] += amount;
    bag.counts[int(id)] += amount;
    return amount;
}

// Shift-click on a stack of the bag itself: send it from the hotbar to the main grid or back, joining
// a stack of the same item there if there is one, else the first free slot.
pub fn shiftHotbar(bag: &Bag, slot: int): bool {
    let id = slotItem(bag, slot);
    if id == 0 { return false; }
    let lo = 0; let hi = item.HOTBAR;
    if slot < item.HOTBAR { lo = item.HOTBAR; hi = size(bag); }
    let target = -1;
    for s in lo..hi { if bag.slots[s] == id { target = s; break; } }
    if target < 0 { for s in lo..hi { if bag.slots[s] == 0 { target = s; break; } } }
    if target < 0 { return false; }
    bag.slots[target] = id;
    bag.amounts[target] += bag.amounts[slot];
    bag.slots[slot] = 0; bag.amounts[slot] = 0;
    return true;
}

// Shift-click on a stack: move the stack at `slot` into `dest`; returns how many moved. What does not fit stays.
pub fn moveStack(source: &Bag, slot: int, dest: &Bag): int {
    let id = slotItem(source, slot);
    let n = takeAt(source, slot, source.amounts[slot]);
    let moved = add(dest, id, n);
    putAt(source, slot, id, n - moved);
    return moved;
}
