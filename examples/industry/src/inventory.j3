// Counted stacks with persistent positions; the first six positions are the hotbar.
module industry.inventory;
use j3.memory.Arena;
use industry.data.item;

pub const CAPACITY: int = 256;
pub const SLOTS: int = 36;
pub struct Bag { counts: []int; slots: []u8; }

pub fn create(mem: &Arena): Bag { return Bag { counts: mem.alloc::<int>(item.kinds()), slots: mem.alloc::<u8>(SLOTS) }; }

pub fn total(bag: &Bag): int {
    let sum = 0;
    for id in 1..item.kinds() { sum += bag.counts[id]; }
    return sum;
}

pub fn add(bag: &Bag, id: u8, amount: int): int {
    if id == 0 || int(id) >= item.kinds() || amount <= 0 { return 0; }
    let moved = amount;
    let room = CAPACITY - total(bag);
    if moved > room { moved = room; }
    bag.counts[int(id)] += moved;
    sync(bag);
    return moved;
}

pub fn move(source: &Bag, dest: &Bag, id: u8, amount: int): int {
    if id == 0 || int(id) >= item.kinds() || amount <= 0 { return 0; }
    let moved = amount;
    if moved > source.counts[int(id)] { moved = source.counts[int(id)]; }
    moved = add(dest, id, moved);
    source.counts[int(id)] -= moved;
    sync(source);
    return moved;
}

// Reconcile callers that consume counts directly without rearranging other stacks.
pub fn sync(bag: &Bag) {
    for slot in 0..SLOTS {
        let stackId = bag.slots[slot];
        if stackId != 0 && bag.counts[int(stackId)] <= 0 { bag.slots[slot] = 0; }
    }
    for id in 1..item.kinds() {
        if bag.counts[id] <= 0 { continue; }
        let found = false;
        for slot in 0..SLOTS { if int(bag.slots[slot]) == id { found = true; } }
        if found { continue; }
        for slot in 0..SLOTS { if bag.slots[slot] == 0 { bag.slots[slot] = u8(id); break; } }
    }
}

pub fn slotItem(bag: &Bag, slot: int): u8 {
    if slot < 0 || slot >= SLOTS { return 0; }
    sync(bag);
    return bag.slots[slot];
}

pub fn swap(bag: &Bag, source: int, dest: int) {
    if source < 0 || source >= SLOTS || dest < 0 || dest >= SLOTS { return; }
    sync(bag);
    let id = bag.slots[source];
    bag.slots[source] = bag.slots[dest]; bag.slots[dest] = id;
}

// Whether `id` is a recipe the bag can pay: copper ore, copper ingots and/or iron ingots.
pub fn canCraft(bag: &Bag, id: u8): bool {
    for entry in 0..item.recipeCount() {
        if item.recipe(entry) == id {
            return bag.counts[int(item.COPPER)] >= item.recipeCost(id) &&
                bag.counts[int(item.COPPER_INGOT)] >= item.recipeIngots(id) &&
                bag.counts[int(item.IRON_INGOT)] >= item.recipeIron(id);
        }
    }
    return false;
}

pub fn craft(bag: &Bag, id: u8): bool {
    if !canCraft(bag, id) { return false; }
    bag.counts[int(item.COPPER)] -= item.recipeCost(id);
    bag.counts[int(item.COPPER_INGOT)] -= item.recipeIngots(id);
    bag.counts[int(item.IRON_INGOT)] -= item.recipeIron(id);
    add(bag, id, 1);
    sync(bag);
    return true;
}
