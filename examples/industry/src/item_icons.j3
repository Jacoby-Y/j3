// A shared pixel-art atlas for generic inventory grids, generated once at startup.
module industry.item_icons;
use j3.game;
use j3.game.Texture;
use j3.math.Vec2;
use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode, Color };
use j3.memory.Arena;
use industry.data.defs;
use industry.data.item;
use industry.model_icons;

pub const SIZE: int = 48;

fn cube(c: &Canvas, x: f32, top: Color, left: Color, right: Color) {
    c.fillTriangle(x + 24, 7, x + 42, 17, x + 24, 27, top);
    c.fillTriangle(x + 24, 7, x + 24, 27, x + 6, 17, top);
    c.fillTriangle(x + 6, 17, x + 24, 27, x + 24, 43, left);
    c.fillTriangle(x + 6, 17, x + 24, 43, x + 6, 33, left);
    c.fillTriangle(x + 42, 17, x + 24, 27, x + 24, 43, right);
    c.fillTriangle(x + 42, 17, x + 24, 43, x + 42, 33, right);
}

fn rgb(packed: int): Color { return canvas.rgb(u8(packed / 65536), u8(packed / 256 % 256), u8(packed % 256)); }

pub fn create(): Texture {
    let mem = Arena.create(131072);
    let c = Canvas.create(&mem, i32((item.kinds() - 1) * SIZE), SIZE, Mode.Pixel);
    c.clear(canvas.rgba(0, 0, 0, 0));
    for id in 1..item.kinds() {
        let def = defs.itemInfo(u8(id));
        let x = (id - 1) * SIZE;
        if def.icon.len > 0 { model_icons.sprite(&c, x, u8(id), &mem); }
        else { cube(&c, f32(x), rgb(def.top), rgb(def.left), rgb(def.right)); }
    }
    let tex = game.textureFromCanvas(c);
    mem.destroy();
    return tex;
}

// Draw one item's icon, scaled to `size` pixels square.
pub fn draw(atlas: Texture, id: u8, x: f32, y: f32, size: f32) {
    let cell = f32(SIZE);
    game.drawTextureSrc(atlas, Vec2 { x: f32(int(id) - 1) * cell, y: 0 }, Vec2 { x: cell, y: cell },
        Vec2 { x: x, y: y }, Vec2 { x: size, y: size });
}
