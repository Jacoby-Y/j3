// Coal generator: holds coal, burns it while its network wants power (rules in scripts/power.j3s).
module industry.machine.generator;
use industry.data.block;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.ports;
use industry.world;
use industry.world.World;

pub const LIMIT: int = 10;

pub fn addCoal(w: &World, at: int): bool {
    let slot = world.slotOf(w, at);
    if w.gens[slot].fuel >= LIMIT { return false; }
    w.gens[slot].fuel += 1;
    return true;
}

// A belt at the rear intake must face through the generator on its base plane.
pub fn take(w: &World, source: int, id: u8): bool {
    if !item.isFuel(id) { return false; }
    let at = ports.receiver(w, source, block.GENERATOR, true);
    if at < 0 { return false; }
    return addCoal(w, at);
}

// E from the player's bag: one coal per press.
pub fn feed(w: &World, at: int, bag: &Bag): bool {
    for id in 1..item.kinds() {
        if bag.counts[id] > 0 && item.isFuel(u8(id)) && addCoal(w, at) { bag.counts[id] -= 1; return true; }
    }
    return false;
}

// Click with fuel in hand: up to `amount` coal from the bag, as many as fit.
pub fn deposit(w: &World, at: int, bag: &Bag, id: u8, amount: int): int {
    if !item.isFuel(id) { return 0; }
    let moved = 0;
    while moved < amount && bag.counts[int(id)] > 0 && addCoal(w, at) { bag.counts[int(id)] -= 1; moved += 1; }
    inventory.sync(bag);
    return moved;
}

// Burning and carrying load, not just holding a lit coal.
pub fn lit(w: &World, at: int): bool {
    let slot = world.slotOf(w, at);
    return w.gens[slot].burn > 0 && w.powered[slot] > 0;
}

pub fn canTake(w: &World, source: int, id: u8): bool {
    let at = ports.receiver(w, source, block.GENERATOR, true);
    return at >= 0 && item.isFuel(id) && w.gens[world.slotOf(w, at)].fuel < LIMIT;
}
