// Shared inventories for storage structures, plus container conveyor intake.
module industry.machine.container;
use industry.data.block;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.ports;
use industry.world;
use industry.world.World;

pub fn valid(w: &World, at: int): bool {
    return at >= 0 && at < w.cells.len && world.storage(w.cells[at]) &&
        w.part[at] == 0 && world.slotOf(w, at) > 0;
}

// The inventory of the storage machine anchored at `at`: views into the shared tables.
pub fn contents(w: &World, at: int): Bag {
    let slot = world.slotOf(w, at); let kinds = item.kinds();
    return Bag { counts: w.stored[slot * kinds..(slot + 1) * kinds],
        slots: w.storedSlots[slot * inventory.SLOTS..(slot + 1) * inventory.SLOTS] };
}

pub fn take(w: &World, source: int, id: u8): bool {
    let at = ports.receiver(w, source, block.CONTAINER, false);
    if !valid(w, at) { return false; }
    let bag = contents(w, at);
    return inventory.add(&bag, id, 1) == 1;
}
