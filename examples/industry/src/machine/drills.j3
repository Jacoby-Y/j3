// The same connection rules drive mining, placement feedback, and status.
module industry.machine.drills;
use industry.data.block;
use industry.data.conveyor;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.ports;
use industry.world;
use industry.world.World;

pub const CAPACITY: int = 10;

pub fn isDrill(kind: u8): bool { return kind == block.DRILL || kind == block.ELECTRIC_DRILL; }

// The drill reads its two layers and the two cells of its front column; the first surface node
// found sets the item. Underground veins are ignored.
pub fn ore(w: &World, x: int, y: int, z: int, dir: u8): u8 {
    let dx = int(conveyor.dx(dir)); let dz = int(conveyor.dz(dir));
    for side in 0..2 { for layer in 0..2 {
        let frontX = x + side; let frontZ = z + side;
        if dx > 0 { frontX = x + world.FOOTPRINT; } if dx < 0 { frontX = x - 1; }
        if dz > 0 { frontZ = z + world.FOOTPRINT; } if dz < 0 { frontZ = z - 1; }
        let id = world.get(w, frontX, y + layer, frontZ);
        if block.isNode(id) { return item.fromOre(id); }
    } }
    return 0;
}

// The belt behind the drill, facing any way; -1 when it has no output.
pub fn rear(w: &World, at: int): int { return ports.beltAhead(w, at, (w.facing[at] + 2) % 4, world.FOOTPRINT); }

pub fn full(w: &World, at: int): bool { return w.drills[world.slotOf(w, at)].count >= CAPACITY; }

// E on a drill: everything it holds goes to the bag; what does not fit stays.
pub fn collect(w: &World, at: int, bag: &Bag): int {
    let slot = world.slotOf(w, at);
    let moved = inventory.add(bag, w.drills[slot].item, w.drills[slot].count);
    w.drills[slot].count -= moved;
    if w.drills[slot].count == 0 { w.drills[slot].item = 0; }
    return moved;
}

pub fn running(w: &World, at: int): bool {
    return ore(w, world.anchorX(at), world.anchorY(at), world.anchorZ(at), w.facing[at]) != 0 && !full(w, at);
}
