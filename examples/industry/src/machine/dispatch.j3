// The only place that picks behavior by machine kind. A new structure adds one arm to each
// function below (and its own module under `industry.machine`); nothing else switches on kind.
module industry.machine.dispatch;

use industry.data.block;
use industry.data.defs;
use industry.data.item;
use j3.math.Vec3;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.container;
use industry.machine.drills;
use industry.machine.furnace;
use industry.machine.generator;
use industry.machine.power;
use industry.machine.market;
use industry.machine.ports;
use j3.text.Text;
use industry.world;
use industry.world.World;

// A belt end hands one item to the machine it faces; false when that machine refuses it.
pub fn deliver(w: &World, source: int, id: u8): bool {
    let kind = ports.targetKind(w, source);
    if furnace.isSmelter(kind) { return furnace.take(w, source, kind, id); }
    if kind == block.GENERATOR { return generator.take(w, source, id); }
    if container.isContainer(kind) { return container.take(w, source, id); }
    if kind == block.MARKET { return market.take(w, source, id); }
    return false;
}

// Whether `deliver` would succeed right now, changing nothing.
pub fn accepts(w: &World, source: int, id: u8): bool {
    let kind = ports.targetKind(w, source);
    if furnace.isSmelter(kind) { return furnace.canTake(w, source, kind, id); }
    if kind == block.GENERATOR { return generator.canTake(w, source, id); }
    if container.isContainer(kind) { return container.canTake(w, source); }
    if kind == block.MARKET { return market.canTake(w, source, id); }
    return false;
}

// Whether the machine at `at` is doing work: drives its animation and overlay.
pub fn running(w: &World, at: int): bool {
    let kind = w.cells[at];
    if kind == block.DRILL { return drills.running(w, at); }
    if kind == block.ELECTRIC_DRILL { return drills.running(w, at) && power.share(w, at) > 0; }
    if kind == block.FURNACE { return w.kilns[world.slotOf(w, at)].item != 0; }
    if kind == block.ELECTRIC_SMELTER { return w.kilns[world.slotOf(w, at)].item != 0 && power.share(w, at) > 0; }
    if kind == block.GENERATOR { return generator.lit(w, at); }
    return false;
}

// The color of what the running machine at `at` throws off: a drill's chips are the ore it digs.
pub fn effectColor(w: &World, at: int): Vec3 {
    let kind = w.cells[at];
    if kind == block.DRILL || kind == block.ELECTRIC_DRILL {
        let ore = defs.oreOfItem(drills.ore(w, world.anchorX(at), world.anchorY(at), world.anchorZ(at), w.facing[at]));
        if ore >= 0 { let def = defs.oreInfo(ore); return defs.blockColor(def.node); }
    }
    return defs.blockColor(kind);
}

// What E and F do to the aimed machine; true when this machine kind takes that press,
// whether or not anything moved, so the press does not fall through to other actions.
pub fn interact(w: &World, at: int, bag: &Bag, e: bool, f: bool): bool {
    let kind = w.cells[at];
    if furnace.isSmelter(kind) && f { furnace.withdraw(w, at, bag, furnace.PART_INGOT, furnace.LIMIT); return true; }
    if kind == block.GENERATOR && e { generator.feed(w, at, bag); return true; }
    if drills.isDrill(kind) && e { drills.collect(w, at, bag); return true; }
    return false;
}

// The player clicked a machine holding `id`: put up to `amount` into the slot it has for it. Returns how many went in.
pub fn insert(w: &World, at: int, bag: &Bag, id: u8, amount: int): int {
    let kind = w.cells[at];
    if furnace.isSmelter(kind) { return furnace.deposit(w, at, bag, id, amount); }
    if kind == block.GENERATOR { return generator.deposit(w, at, bag, id, amount); }
    return 0;
}

pub struct Info { detail: string; action: string; }

// Power line of an electric machine's panel.
fn powerText(w: &World, slot: int, t: &Text) {
    if power.wiresAt(w, slot) == 0 { t.pushStr("NOT WIRED"); return; }
    if w.slotKind[slot] == block.GENERATOR {
        t.pushStr("LOAD "); t.pushInt(int(w.netDemand[w.powerRoot[slot]])); t.pushStr("W");
        return;
    }
    t.pushStr("POWER "); t.pushInt(int(w.powered[slot] * 100));
}

// "Label: n", with the number written into `t`.
fn count(t: &Text, label: string, n: int) { t.pushStr(label); t.pushStr(": "); t.pushInt(n); }

// Text for the HUD panel about the aimed machine. The detail line lives in `t`, not on this stack frame.
pub fn describe(w: &World, at: int, t: &Text): Info {
    t.clear();
    let kind = w.cells[at];
    let slot = world.slotOf(w, at);
    if drills.isDrill(kind) {
        let resource = w.drills[slot].item;
        if resource == 0 { resource = drills.ore(w, world.anchorX(at), world.anchorY(at), world.anchorZ(at), w.facing[at]); }
        let name: string = "Items";
        if resource != 0 { name = item.name(resource); }
        count(t, name, w.drills[slot].count);
        if kind == block.ELECTRIC_DRILL { t.pushStr("  "); powerText(w, slot, t); }
        return Info { detail: t.str(), action: "[E]: Collect" };
    }
    if container.isContainer(kind) {
        let stored = container.contents(w, at);
        count(t, "Items", inventory.total(&stored));
        return Info { detail: t.str(), action: "[E]: Open" };
    }
    if kind == block.MARKET {
        let queued = container.contents(w, at);
        t.pushStr("Market Console: "); t.pushInt(market.value(&queued)); t.pushStr(" coins");
        return Info { detail: t.str(), action: "[E]: Sell items" };
    }
    if kind == block.FURNACE {
        count(t, "Coal", w.kilns[slot].fuel); t.pushStr("  "); count(t, "Ore", w.kilns[slot].stock);
        t.pushStr("  "); count(t, "Ingots", w.kilns[slot].out);
        return Info { detail: t.str(), action: "[E]: Open  [F]: Take ingots" };
    }
    if kind == block.ELECTRIC_SMELTER {
        count(t, "Ore", w.kilns[slot].stock); t.pushStr("  "); count(t, "Ingots", w.kilns[slot].out);
        t.pushStr("  "); powerText(w, slot, t);
        return Info { detail: t.str(), action: "[E]: Open  [F]: Take ingots" };
    }
    if kind == block.GENERATOR {
        count(t, "Coal", w.gens[slot].fuel); t.pushStr("  "); powerText(w, slot, t);
        return Info { detail: t.str(), action: "[E]: Add coal" };
    }
    if kind == block.POST {
        t.pushStr("Post: "); t.pushInt(power.wiresAt(w, slot)); t.pushStr(" wires");
        return Info { detail: t.str(), action: "HOLD WIRE: [RMB] CONNECT" };
    }
    if block.isBelt(kind) { return Info { detail: item.name(item.fromBlock(kind)), action: "[LMB]: Remove" }; }
    return Info { detail: "", action: "" };
}
