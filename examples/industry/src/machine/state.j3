// Per-machine state, one typed table per kind. A machine owns one slot in every table; only
// the table of its own kind means anything, so no column is shared between kinds.
module industry.machine.state;

use j3.memory.Arena;
use industry.inventory;

// Cargo places on one belt.
pub const QUEUE: int = 4;

// Wires one world can hold.
pub const MAX_WIRES: int = 4096;

// `entry` is the side an item came in from; `leave` the side a splitter sends it out of (belts.UNDECIDED until it picks).
pub struct BeltState { count: int; turn: int; cargo: [4]u8; entry: [4]u8; leave: [4]u8; progress: [4]f32; }
pub struct DrillState { count: int; item: u8; clock: f32; }
pub struct GeneratorState { fuel: int; burn: f32; }
pub struct FurnaceState { stock: int; stockKind: u8; fuel: int; burn: int; item: u8; clock: f32; out: int; outKind: u8; }

pub struct Machines {
    hashKeys: []int;      // anchor cell + 1 -> slot, open addressing; -1 marks a removed key
    hashSlots: []u16;
    slotOwner: []int;     // slot -> anchor cell + 1, 0 = free; slot 0 is a scratch slot
    slotKind: []u8;       // slot -> block id of the machine
    slotHigh: int;        // highest slot in use; update loops stop here
    machineCount: int;
    belts: []BeltState;
    drills: []DrillState;
    kilns: []FurnaceState;
    gens: []GeneratorState;
    powered: []f32;       // slot -> share of its demand its network met this step
    powerRoot: []int;     // slot -> representative slot of its wired network
    netSupply: []f32;     // by root slot, this step
    netDemand: []f32;
    wireA: []u16;         // wire i joins slots wireA[i] and wireB[i]
    wireB: []u16;
    wireCount: int;
    netDirty: bool;       // wires changed since `powerRoot` was built
    stored: []int;        // item counts of every storage machine, `kinds` per slot
    storedAmounts: []int; // how many in each of those positions
    storedSlots: []u8;    // inventory positions of every storage machine, SLOTS per slot
    storeCount: int;
}

pub fn create(mem: &Arena, capacity: int, hash: int, kinds: int): Machines {
    return Machines {
        hashKeys: mem.alloc::<int>(hash),
        hashSlots: mem.alloc::<u16>(hash),
        slotOwner: mem.alloc::<int>(capacity + 1),
        slotKind: mem.alloc::<u8>(capacity + 1),
        slotHigh: 0,
        machineCount: 0,
        belts: mem.alloc::<BeltState>(capacity + 1),
        drills: mem.alloc::<DrillState>(capacity + 1),
        kilns: mem.alloc::<FurnaceState>(capacity + 1),
        gens: mem.alloc::<GeneratorState>(capacity + 1),
        powered: mem.alloc::<f32>(capacity + 1),
        powerRoot: mem.alloc::<int>(capacity + 1),
        netSupply: mem.alloc::<f32>(capacity + 1),
        netDemand: mem.alloc::<f32>(capacity + 1),
        wireA: mem.alloc::<u16>(MAX_WIRES),
        wireB: mem.alloc::<u16>(MAX_WIRES),
        wireCount: 0,
        netDirty: true,
        stored: mem.alloc::<int>((capacity + 1) * kinds),
        storedAmounts: mem.alloc::<int>((capacity + 1) * inventory.SLOTS),
        storedSlots: mem.alloc::<u8>((capacity + 1) * inventory.SLOTS),
        storeCount: 0,
    };
}
