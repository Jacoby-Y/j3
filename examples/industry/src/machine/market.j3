// Sales share one wallet; manual deposits settle on close, belts sell immediately.
module industry.machine.market;
use industry.machine.container;
use industry.data.block;
use industry.data.item;
use industry.inventory.Bag;
use industry.machine.ports;
use industry.world.World;

pub fn price(id: u8): int {
    if id == 0 || int(id) >= item.kinds() { return 0; }
    return item.price(id);
}

pub fn valid(w: &World, at: int): bool {
    return container.valid(w, at) && w.cells[at] == block.MARKET;
}

pub fn value(bag: &Bag): int {
    let coins = 0;
    for id in 1..item.kinds() { coins += bag.counts[id] * price(u8(id)); }
    return coins;
}

pub fn sell(w: &World, at: int): int {
    if !valid(w, at) { return 0; }
    let bag = container.contents(w, at);
    let coins = value(&bag);
    for id in 1..item.kinds() { if price(u8(id)) > 0 { bag.counts[id] = 0; } }
    w.coins += coins;
    return coins;
}

pub fn take(w: &World, source: int, id: u8): bool {
    let at = ports.receiver(w, source, block.MARKET, false);
    let coins = price(id);
    if !valid(w, at) || coins == 0 { return false; }
    w.coins += coins;
    return true;
}

pub fn canTake(w: &World, source: int, id: u8): bool {
    return price(id) > 0 && valid(w, ports.receiver(w, source, block.MARKET, false));
}
