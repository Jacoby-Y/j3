// Wires and networks. Wires join a post to a post, or a post to one machine; a network is every
// machine connected through wires. The per-step supply and demand rules are in scripts/power.j3s.
module industry.machine.power;
use industry.data.block;
use industry.machine.drills;
use industry.machine.state;
use industry.world;
use industry.world.World;

// Longest wire, in voxels between machine centers (a voxel is 0.5 m).
pub const REACH: int = 24;

pub fn isPost(kind: u8): bool { return kind == block.POST; }
// Anything a wire can end at.
pub fn isElectric(kind: u8): bool {
    return kind == block.POST || kind == block.GENERATOR || kind == block.ELECTRIC_DRILL || kind == block.ELECTRIC_SMELTER;
}

// Wire index joining the two slots, or -1.
pub fn wireBetween(w: &World, a: int, b: int): int {
    for i in 0..w.wireCount {
        let x = int(w.wireA[i]); let y = int(w.wireB[i]);
        if (x == a && y == b) || (x == b && y == a) { return i; }
    }
    return -1;
}

// Wires at one machine.
pub fn wiresAt(w: &World, slot: int): int {
    let n = 0;
    for i in 0..w.wireCount { if int(w.wireA[i]) == slot || int(w.wireB[i]) == slot { n += 1; } }
    return n;
}

pub struct Link { ok: bool; message: string; }

// Why `a` and `b` can or cannot be wired together.
pub fn check(w: &World, a: int, b: int): Link {
    if a == b { return Link { ok: false, message: "PICK A DIFFERENT MACHINE" }; }
    if !isPost(w.cells[a]) && !isPost(w.cells[b]) { return Link { ok: false, message: "WIRE GOES TO A POST" }; }
    let dx = world.anchorX(a) - world.anchorX(b); let dy = world.anchorY(a) - world.anchorY(b);
    let dz = world.anchorZ(a) - world.anchorZ(b);
    if dx * dx + dy * dy + dz * dz > REACH * REACH { return Link { ok: false, message: "TOO FAR FOR ONE WIRE" }; }
    if w.wireCount >= state.MAX_WIRES { return Link { ok: false, message: "WIRE LIMIT REACHED" }; }
    return Link { ok: true, message: "" };
}

pub fn connect(w: &World, a: int, b: int) {
    w.wireA[w.wireCount] = u16(world.slotOf(w, a)); w.wireB[w.wireCount] = u16(world.slotOf(w, b));
    w.wireCount += 1;
    w.netDirty = true;
}

pub fn disconnect(w: &World, index: int) {
    w.wireCount -= 1;
    w.wireA[index] = w.wireA[w.wireCount]; w.wireB[index] = w.wireB[w.wireCount];
    w.netDirty = true;
}

fn find(w: &World, slot: int): int {
    let at = slot;
    while w.powerRoot[at] != at {
        w.powerRoot[at] = w.powerRoot[w.powerRoot[at]];
        at = w.powerRoot[at];
    }
    return at;
}

// Label every slot with its network's root; a no-op until the wires change.
pub fn rebuild(w: &World) {
    if !w.netDirty { return; }
    for slot in 1..w.slotHigh + 1 { w.powerRoot[slot] = slot; }
    for i in 0..w.wireCount {
        let a = find(w, int(w.wireA[i])); let b = find(w, int(w.wireB[i]));
        if a != b { w.powerRoot[a] = b; }
    }
    for slot in 1..w.slotHigh + 1 { w.powerRoot[slot] = find(w, slot); }
    w.netDirty = false;
}

// A powered machine's share of its demand, 0..1.
pub fn share(w: &World, at: int): f32 { return w.powered[world.slotOf(w, at)]; }

// Whether an electric machine has work and is asking its network for power.
pub fn wantsPower(w: &World, slot: int): bool {
    let kind = w.slotKind[slot];
    let at = world.slotAnchor(w, slot);
    if kind == block.ELECTRIC_DRILL { return drills.running(w, at); }
    if kind == block.ELECTRIC_SMELTER {
        let k = w.kilns[slot];
        return k.item != 0 || k.stock > 0;
    }
    return false;
}
