// Where machines meet: the voxel two cells ahead of a belt end, and rules for what may connect.
module industry.machine.ports;
use j3.gfx.voxel;
use industry.data.block;
use industry.data.conveyor;
use industry.world;
use industry.world.World;

// Anchor of the belt `cells` voxels ahead of `at` along `dir` on the same level, or -1.
pub fn beltAhead(w: &World, at: int, dir: u8, cells: int): int {
    let x = world.anchorX(at) + int(conveyor.dx(dir)) * cells;
    let z = world.anchorZ(at) + int(conveyor.dz(dir)) * cells;
    let y = world.anchorY(at);
    if !world.isConveyorAnchor(w, x, y, z) { return -1; }
    return voxel.index(x, y, z, world.SX, world.SZ);
}

// The belt a belt end hands to: straight ahead, else one voxel off to either side (half a belt).
pub fn beltNear(w: &World, at: int, dir: u8): int {
    let ahead = beltAhead(w, at, dir, world.FOOTPRINT);
    if ahead >= 0 { return ahead; }
    let side = (dir + 1) % 4;
    for sign in 0..2 {
        let s = 1 - 2 * sign;
        let x = world.anchorX(at) + int(conveyor.dx(dir)) * world.FOOTPRINT + int(conveyor.dx(side)) * s;
        let z = world.anchorZ(at) + int(conveyor.dz(dir)) * world.FOOTPRINT + int(conveyor.dz(side)) * s;
        let y = world.anchorY(at);
        if world.isConveyorAnchor(w, x, y, z) { return voxel.index(x, y, z, world.SX, world.SZ); }
    }
    return -1;
}

// Block id at the cell a belt end faces, 0 when there is nothing.
pub fn targetKind(w: &World, source: int): u8 {
    let dir = w.facing[source];
    return world.get(w, world.anchorX(source) + int(conveyor.dx(dir)) * world.FOOTPRINT, world.anchorY(source),
        world.anchorZ(source) + int(conveyor.dz(dir)) * world.FOOTPRINT);
}

// Belt ends meet a machine face at its base height; directional intakes also match facing.
pub fn receiver(w: &World, source: int, id: u8, directional: bool): int {
    if source < 0 || source >= w.cells.len || !block.isBelt(w.cells[source]) || w.part[source] != 0 { return -1; }
    let dir = w.facing[source];
    let x = world.anchorX(source) + int(conveyor.dx(dir)) * world.FOOTPRINT;
    let y = world.anchorY(source);
    let z = world.anchorZ(source) + int(conveyor.dz(dir)) * world.FOOTPRINT;
    if world.get(w, x, y, z) != id { return -1; }
    let at = world.anchorAt(w, x, y, z);
    if at < 0 || (directional && w.facing[at] != dir) || y != world.anchorY(at) { return -1; }
    if world.anchorX(source) != world.anchorX(at) - int(conveyor.dx(dir)) * world.FOOTPRINT ||
        world.anchorZ(source) != world.anchorZ(at) - int(conveyor.dz(dir)) * world.FOOTPRINT { return -1; }
    return at;
}
