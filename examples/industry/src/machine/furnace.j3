// Furnace ports share the belt's item height: one voxel above the machine base.
module industry.machine.furnace;
use j3.gfx.voxel;
use industry.data.block;
use industry.data.defs;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.machine.ports;
use industry.world;
use industry.world.World;

pub const PORT_HEIGHT: int = 1;

// A belt must finish at the rear intake, face through the furnace, and sit on its base plane.
pub fn receiver(w: &World, source: int, kind: u8): int { return ports.receiver(w, source, kind, true); }

pub fn isSmelter(kind: u8): bool { return kind == block.FURNACE || kind == block.ELECTRIC_SMELTER; }

pub const LIMIT: int = 10;
pub const SMELTS_PER_COAL: int = 5;

// Belts and hands share these: ore queues up, fuel feeds the fuel store.
pub fn addOre(w: &World, at: int, ore: u8): bool {
    let slot = world.slotOf(w, at);
    if item.ingotFor(ore) == 0 || w.kilns[slot].stock >= LIMIT { return false; }
    if w.kilns[slot].stock > 0 && w.kilns[slot].stockKind != ore { return false; }
    w.kilns[slot].stock += 1;
    w.kilns[slot].stockKind = ore;
    return true;
}

pub fn addCoal(w: &World, at: int): bool {
    let slot = world.slotOf(w, at);
    if w.kilns[slot].fuel >= LIMIT { return false; }
    w.kilns[slot].fuel += 1;
    return true;
}

// The electric smelter has no fuel store: coal is refused.
pub fn take(w: &World, source: int, kind: u8, id: u8): bool {
    let at = receiver(w, source, kind);
    if at < 0 { return false; }
    if item.isFuel(id) { return kind == block.FURNACE && addCoal(w, at); }
    return addOre(w, at, id);
}

// `take` without the side effects, so a splitter can skip an exit that would refuse the item.
pub fn canTake(w: &World, source: int, kind: u8, id: u8): bool {
    let at = receiver(w, source, kind);
    if at < 0 { return false; }
    let k = w.kilns[world.slotOf(w, at)];
    if item.isFuel(id) { return kind == block.FURNACE && k.fuel < LIMIT; }
    return item.ingotFor(id) != 0 && k.stock < LIMIT && (k.stock == 0 || k.stockKind == id);
}

pub const PART_ORE: int = 0;
pub const PART_COAL: int = 1;
pub const PART_INGOT: int = 2;

pub fn valid(w: &World, at: int): bool {
    return at >= 0 && at < w.cells.len && isSmelter(w.cells[at]) && w.part[at] == 0 && world.slotOf(w, at) > 0;
}

// A finished ingot with no free belt waits in the output store, one kind at a time.
pub fn store(w: &World, at: int, ingot: u8): bool {
    let slot = world.slotOf(w, at);
    if w.kilns[slot].out >= LIMIT || (w.kilns[slot].out > 0 && w.kilns[slot].outKind != ingot) { return false; }
    w.kilns[slot].out += 1;
    w.kilns[slot].outKind = ingot;
    return true;
}

// Hands: put up to `amount` of `id` into the matching store; returns how many went in.
pub fn put(w: &World, at: int, id: u8, amount: int): int {
    let moved = 0;
    while moved < amount {
        let ok = false;
        if item.isFuel(id) { ok = w.cells[at] == block.FURNACE && addCoal(w, at); }
        else { ok = addOre(w, at, id); }
        if !ok { break; }
        moved += 1;
    }
    return moved;
}

// `put` from the bag.
pub fn deposit(w: &World, at: int, bag: &Bag, id: u8, amount: int): int {
    if amount > bag.counts[int(id)] { amount = bag.counts[int(id)]; }
    let moved = put(w, at, id, amount);
    bag.counts[int(id)] -= moved;
    inventory.sync(bag);
    return moved;
}

// Take up to `amount` from one store (PART_*) into the bag; returns how many came out.
pub fn withdraw(w: &World, at: int, bag: &Bag, part: int, amount: int): int {
    let slot = world.slotOf(w, at);
    let id: u8 = item.COAL; let held = w.kilns[slot].fuel;
    if part == PART_ORE { id = w.kilns[slot].stockKind; held = w.kilns[slot].stock; }
    if part == PART_INGOT { id = w.kilns[slot].outKind; held = w.kilns[slot].out; }
    if amount > held { amount = held; }
    let moved = inventory.add(bag, id, amount);
    if part == PART_ORE { w.kilns[slot].stock -= moved; }
    else if part == PART_COAL { w.kilns[slot].fuel -= moved; }
    else { w.kilns[slot].out -= moved; }
    return moved;
}

// Begin a smelt when idle: needs queued ore and, for a furnace, a lit coal (lighting a new one
// when spent). The electric smelter needs power instead.
pub fn start(w: &World, at: int) {
    let slot = world.slotOf(w, at);
    if w.kilns[slot].item != 0 || w.kilns[slot].stock == 0 { return; }
    if w.cells[at] == block.ELECTRIC_SMELTER && w.powered[slot] <= 0 { return; }
    if w.cells[at] == block.FURNACE && w.kilns[slot].burn == 0 {
        if w.kilns[slot].fuel == 0 { return; }
        w.kilns[slot].fuel -= 1;
        w.kilns[slot].burn = SMELTS_PER_COAL;
    }
    if w.cells[at] == block.FURNACE { w.kilns[slot].burn -= 1; }
    w.kilns[slot].stock -= 1;
    w.kilns[slot].item = w.kilns[slot].stockKind;
    w.kilns[slot].clock = 0;
}

// The belt `offset` cells from the furnace along its own direction, if it faces the same way.
fn port(w: &World, at: int, offset: int): int {
    let dir = w.facing[at];
    let belt = ports.beltAhead(w, at, dir, offset);
    if belt < 0 || (w.facing[belt] != dir && defs.blockRoute(w.cells[belt]) == defs.ROUTE_LINE) { return -1; }
    return belt;
}

pub fn inlet(w: &World, at: int): int { return port(w, at, -world.FOOTPRINT); }
pub fn outlet(w: &World, at: int): int { return port(w, at, world.FOOTPRINT); }
