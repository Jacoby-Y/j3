// Four queue places per belt; positions are distance along its two-cell length.
module industry.machine.belts;

use industry.data.block;
use industry.data.defs;
use industry.machine.dispatch;
use industry.machine.ports;
use industry.machine.state;
use industry.world;
use industry.world.World;

pub const LENGTH: f32 = 2;
pub const SPACING: f32 = 0.65;
// A side entry meets the rear lane at a right angle, so it needs more path between items to
// keep them apart on screen (SPACING * sqrt 2, rounded up).
pub const SIDE_GAP: f32 = 0.95;
pub const UNDECIDED: u8 = 255;

fn beltSlot(w: &World, at: int): int {
    if at < 0 || at >= w.cells.len || !block.isBelt(w.cells[at]) || w.part[at] != 0 { return 0; }
    return world.slotOf(w, at);
}

// Path distance an item needs to the one ahead of it. Only a straight belt entered from its rear
// keeps items in one lane.
fn gap(w: &World, at: int, entry: u8): f32 {
    if defs.blockRoute(w.cells[at]) == defs.ROUTE_LINE && entry == w.facing[at] { return SPACING; }
    return SIDE_GAP;
}

// Queue index an item entering at `start` would take, or -1 when it would crowd a neighbour or
// the queue is full. Queues stay sorted by progress, so a lifter can merge into the middle.
fn spot(w: &World, at: int, entry: u8, start: f32): int {
    let slot = beltSlot(w, at);
    if slot == 0 { return -1; }
    let n = w.belts[slot].count;
    if n >= state.QUEUE { return -1; }
    let k = 0;
    while k < n && w.belts[slot].progress[k] >= start { k += 1; }
    let need = SPACING; if start == 0 { need = gap(w, at, entry); }
    if k > 0 && w.belts[slot].progress[k - 1] < start + need { return -1; }
    if k < n && w.belts[slot].progress[k] > start - SPACING { return -1; }
    return k;
}

pub fn accepts(w: &World, at: int): bool {
    if at < 0 || at >= w.cells.len { return false; }
    return spot(w, at, w.facing[at], 0) >= 0;
}

pub fn insert(w: &World, at: int, ore: u8): bool {
    if at < 0 || at >= w.cells.len { return false; }
    return insertFrom(w, at, ore, w.facing[at]);
}

pub fn insertFrom(w: &World, at: int, ore: u8, entry: u8): bool { return put(w, at, ore, entry, 0); }

fn put(w: &World, at: int, ore: u8, entry: u8, start: f32): bool {
    let k = spot(w, at, entry, start);
    if k < 0 { return false; }
    let slot = beltSlot(w, at);
    let i = w.belts[slot].count;
    while i > k {
        w.belts[slot].cargo[i] = w.belts[slot].cargo[i - 1];
        w.belts[slot].entry[i] = w.belts[slot].entry[i - 1];
        w.belts[slot].leave[i] = w.belts[slot].leave[i - 1];
        w.belts[slot].progress[i] = w.belts[slot].progress[i - 1];
        i -= 1;
    }
    w.belts[slot].cargo[k] = ore;
    w.belts[slot].entry[k] = entry;
    w.belts[slot].leave[k] = UNDECIDED;
    w.belts[slot].progress[k] = start;
    w.belts[slot].count += 1;
    return true;
}

// Belts accept at the rear or either side, and reject opposing outputs. Splitters and lifters
// take cargo from any side.
fn exit(w: &World, at: int, dir: u8): int {
    let next = ports.beltNear(w, at, dir);
    if next < 0 { return -1; }
    if defs.blockRoute(w.cells[next]) == defs.ROUTE_LINE && w.facing[next] == (dir + 2) % 4 { return -1; }
    return next;
}

fn vertical(route: int): bool { return route == defs.ROUTE_LIFT || route == defs.ROUTE_LOWER; }

// The belt a line continues into; a lifter's output is above it, not ahead.
pub fn neighbor(w: &World, at: int, dir: u8): int {
    if vertical(defs.blockRoute(w.cells[at])) { return -1; }
    return exit(w, at, dir);
}

// A lifter (or lowerer) hands cargo to whatever belt covers the cell above (below) it, entering at that belt's centre
// (the lifter's top is already there).
fn lift(w: &World, source: int, cargo: u8, rise: int): bool {
    let next = world.anchorAt(w, world.anchorX(source), world.anchorY(source) + rise, world.anchorZ(source));
    return put(w, next, cargo, w.facing[source], 1);
}

// Whether a splitter can send `cargo` out of side `dir` right now. Turns the splitter to face it,
// which is what `dispatch.accepts` reads.
fn open(w: &World, source: int, dir: u8, cargo: u8): bool {
    w.facing[source] = dir;
    let next = exit(w, source, dir);
    if next >= 0 && spot(w, next, dir, 0) >= 0 { return true; }
    return dispatch.accepts(w, source, cargo);
}

// A splitter item picks its exit once, at the centre: round-robin over the three sides it did not
// come from, skipping any that would refuse it. It waits at the centre until one is open.
fn decide(w: &World, source: int, slot: int, place: int): bool {
    let heading = w.belts[slot].entry[place];
    for tries in 0..3 {
        let pick = (w.belts[slot].turn + tries) % 3;
        let dir = u8((int(heading) + 3 + pick) % 4);
        if open(w, source, dir, w.belts[slot].cargo[place]) {
            w.belts[slot].leave[place] = dir;
            w.belts[slot].turn = (pick + 1) % 3;
            return true;
        }
    }
    return false;
}

fn forward(w: &World, source: int, cargo: u8): bool {
    let dir = w.facing[source];
    if insertFrom(w, exit(w, source, dir), cargo, dir) { return true; }
    return dispatch.deliver(w, source, cargo);
}

// Hand the head of a belt's queue on: straight, out of the side it chose, or up.
fn send(w: &World, source: int, slot: int): bool {
    let cargo = w.belts[slot].cargo[0];
    let route = defs.blockRoute(w.slotKind[slot]);
    if route == defs.ROUTE_LIFT { return lift(w, source, cargo, 1); }
    if route == defs.ROUTE_LOWER { return lift(w, source, cargo, -1); }
    if route == defs.ROUTE_SPLIT { w.facing[source] = w.belts[slot].leave[0]; }
    return forward(w, source, cargo);
}

fn advance(w: &World, slot: int, dt: f32) {
    let speed = defs.blockSpeed(w.slotKind[slot]);
    let split = defs.blockRoute(w.slotKind[slot]) == defs.ROUTE_SPLIT;
    let limit = LENGTH;
    for place in 0..w.belts[slot].count {
        let p = w.belts[slot].progress[place] + speed * dt;
        let cap = limit;
        if split && w.belts[slot].leave[place] == UNDECIDED && cap > 1 { cap = 1; }
        if p > cap { p = cap; }
        w.belts[slot].progress[place] = p;
        limit = p - SPACING;
    }
}

fn popFront(w: &World, slot: int) {
    w.belts[slot].count -= 1;
    for place in 0..w.belts[slot].count {
        w.belts[slot].cargo[place] = w.belts[slot].cargo[place + 1];
        w.belts[slot].entry[place] = w.belts[slot].entry[place + 1];
        w.belts[slot].leave[place] = w.belts[slot].leave[place + 1];
        w.belts[slot].progress[place] = w.belts[slot].progress[place + 1];
    }
}

pub fn update(w: &World, dt: f32) {
    // Move every queue before transferring, so an item moves only once per tick.
    for slot in 1..w.slotHigh + 1 {
        if block.isBelt(w.slotKind[slot]) { advance(w, slot, dt); }
    }
    for slot in 1..w.slotHigh + 1 {
        if !block.isBelt(w.slotKind[slot]) || w.belts[slot].count == 0 { continue; }
        let source = world.slotAnchor(w, slot);
        if defs.blockRoute(w.slotKind[slot]) == defs.ROUTE_SPLIT {
            for place in 0..w.belts[slot].count {
                if w.belts[slot].leave[place] != UNDECIDED { continue; }
                if w.belts[slot].progress[place] >= 1 { decide(w, source, slot, place); }
                break;
            }
        }
        if w.belts[slot].progress[0] < LENGTH { continue; }
        if send(w, source, slot) { popFront(w, slot); }
        else if defs.blockRoute(w.slotKind[slot]) == defs.ROUTE_SPLIT { w.belts[slot].leave[0] = UNDECIDED; }
    }
}
