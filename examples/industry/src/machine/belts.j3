// Four queue places per belt; positions are distance along its two-cell length.
module industry.machine.belts;

use industry.data.block;
use industry.data.defs;
use industry.machine.dispatch;
use industry.machine.ports;
use industry.machine.state;
use industry.world;
use industry.world.World;

pub const LENGTH: f32 = 2;
pub const SPACING: f32 = 0.65;

fn beltSlot(w: &World, at: int): int {
    if at < 0 || at >= w.cells.len || !block.isBelt(w.cells[at]) || w.part[at] != 0 { return 0; }
    return world.slotOf(w, at);
}

fn available(w: &World, slot: int): bool {
    if slot == 0 { return false; }
    let n = w.belts[slot].count;
    return n < state.QUEUE && (n == 0 || w.belts[slot].progress[n - 1] >= SPACING);
}

pub fn accepts(w: &World, at: int): bool { return available(w, beltSlot(w, at)); }

pub fn insert(w: &World, at: int, ore: u8): bool {
    if at < 0 || at >= w.cells.len { return false; }
    return insertFrom(w, at, ore, w.facing[at]);
}

pub fn insertFrom(w: &World, at: int, ore: u8, entry: u8): bool {
    let slot = beltSlot(w, at);
    if !available(w, slot) { return false; }
    let place = w.belts[slot].count;
    w.belts[slot].cargo[place] = ore;
    w.belts[slot].entry[place] = entry;
    w.belts[slot].progress[place] = 0;
    w.belts[slot].count = place + 1;
    return true;
}

// Belts accept at the rear or either side, and reject opposing outputs. Splitters and lifters
// take cargo from any side.
fn exit(w: &World, at: int, dir: u8): int {
    let next = ports.beltAhead(w, at, dir, world.FOOTPRINT);
    if next < 0 { return -1; }
    if defs.blockRoute(w.cells[next]) == defs.ROUTE_LINE && w.facing[next] == (dir + 2) % 4 { return -1; }
    return next;
}

// The belt a line continues into; a lifter's output is above it, not ahead.
pub fn neighbor(w: &World, at: int, dir: u8): int {
    if defs.blockRoute(w.cells[at]) == defs.ROUTE_LIFT { return -1; }
    return exit(w, at, dir);
}

// A lifter hands cargo to whatever belt covers the cell above it.
fn lift(w: &World, source: int, cargo: u8): bool {
    let above = world.anchorAt(w, world.anchorX(source), world.anchorY(source) + 1, world.anchorZ(source));
    return insertFrom(w, above, cargo, w.facing[source]);
}

// Hand the head of a belt's queue on: straight, round-robin over the three sides that are not
// where it came from (a splitter turns to face the exit it tries), or up.
fn send(w: &World, source: int, slot: int): bool {
    let cargo = w.belts[slot].cargo[0];
    let route = defs.blockRoute(w.slotKind[slot]);
    if route == defs.ROUTE_LIFT { return lift(w, source, cargo); }
    if route == defs.ROUTE_LINE { return forward(w, source, cargo); }
    let heading = w.belts[slot].entry[0];
    for tries in 0..3 {
        let pick = (w.belts[slot].turn + tries) % 3;
        w.facing[source] = u8((int(heading) + 3 + pick) % 4);
        if forward(w, source, cargo) { w.belts[slot].turn = (pick + 1) % 3; return true; }
    }
    return false;
}

fn forward(w: &World, source: int, cargo: u8): bool {
    let dir = w.facing[source];
    if insertFrom(w, exit(w, source, dir), cargo, dir) { return true; }
    return dispatch.deliver(w, source, cargo);
}

fn advance(w: &World, slot: int, dt: f32) {
    let speed = defs.blockSpeed(w.slotKind[slot]);
    let limit = LENGTH;
    for place in 0..w.belts[slot].count {
        let p = w.belts[slot].progress[place] + speed * dt;
        if p > limit { p = limit; }
        w.belts[slot].progress[place] = p;
        limit = p - SPACING;
    }
}

fn popFront(w: &World, slot: int) {
    w.belts[slot].count -= 1;
    for place in 0..w.belts[slot].count {
        w.belts[slot].cargo[place] = w.belts[slot].cargo[place + 1];
        w.belts[slot].entry[place] = w.belts[slot].entry[place + 1];
        w.belts[slot].progress[place] = w.belts[slot].progress[place + 1];
    }
}

pub fn update(w: &World, dt: f32) {
    // Move every queue before transferring, so an item moves only once per tick.
    for slot in 1..w.slotHigh + 1 {
        if block.isBelt(w.slotKind[slot]) { advance(w, slot, dt); }
    }
    for slot in 1..w.slotHigh + 1 {
        if !block.isBelt(w.slotKind[slot]) || w.belts[slot].count == 0 || w.belts[slot].progress[0] < LENGTH { continue; }
        if send(w, world.slotAnchor(w, slot), slot) { popFront(w, slot); }
    }
}
