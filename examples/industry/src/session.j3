// A running game: everything one session owns, and how it starts and opens or closes screens.
module industry.session;

use j3.game;
use j3.game.Texture;
use j3.gfx;
use j3.gfx.Mesh;
use j3.gfx.voxel.Hit;
use j3.io.printLn;
use j3.memory.Arena;
use j3.text.Text;
use j3.rand.Rng;
use j3.math.Vec3;
use industry.chunks;
use industry.console;
use industry.fx.cubes;
use industry.fx.pool;
use industry.fx.pool.Particles;
use industry.console.Console;
use industry.data.item;
use industry.drops;
use industry.drops.Drops;
use industry.inventory;
use industry.inventory.Bag;
use industry.crafting;
use industry.inventory_ui.Selection;
use industry.item_icons;
use industry.mesher;
use industry.machine.container;
use industry.machine.furnace;
use industry.machine.market;
use industry.models;
use industry.models.Models;
use industry.mining;
use industry.mining.Progress;
use industry.placement.Plan;
use industry.player;
use industry.player.Player;
use industry.render;
use industry.world;
use industry.world.World;

const Furnace = @script("scripts/furnace.j3s");
const Drill = @script("scripts/drill.j3s");
const Power = @script("scripts/power.j3s");

pub struct Game {
    carried: Bag;
    console: Console;
    openStore: int;
    inventoryOpen: bool;
    selectedInventory: Selection;
    inventoryIcons: Texture;
    drops: Drops;
    drill: Drill;
    furnace: Furnace;
    power: Power;
    wireFrom: int;       // anchor of the first machine of a wire being run, -1 for none
    hoverText: Text;     // backing bytes for the aimed-machine panel
    note: string;        // short message above the hotbar
    noteTime: f32;       // seconds left to show it
    assets: Models;
    barrier: Mesh;
    world: World;
    fx: Particles;
    player: Player;
    rotation: u8;
    mining: Progress;
    miningShade: Mesh;
    clock: f32;          // simulation time not yet consumed by fixed steps
    profile: bool;       // time each machine stage (benchmarks only)
    stageUs: [4]int;     // microseconds per stage while profiling
    hit: Hit;            // what the player aims at, set once per update
    looked: u8;          // block id under the aim
    plan: Plan;          // what placing would do, set once per update
}

pub fn boot(mem: &Arena): Game {
    let rng = Rng.new(game.micros());
    let seed = rng.next();
    printLn(`world seed: {seed}`);
    return bootSeed(mem, seed);
}

pub fn bootSeed(mem: &Arena, seed: int): Game {
    let w = world.createSeed(mem, seed);
    chunks.unlock(&w, world.CENTER, world.CENTER);
    let carried = inventory.create(mem);
    inventory.add(&carried, item.PICKAXE, 1);
    return Game {
        carried: carried,
        console: console.create(mem),
        openStore: -1,
        inventoryOpen: false,
        selectedInventory: Selection { queue: crafting.create(mem) },
        inventoryIcons: Texture { raw: 0, w: 0, h: 0 },
        drops: drops.create(mem),
        drill: Drill {},
        furnace: Furnace {},
        power: Power {},
        wireFrom: -1,
        note: "",
        hoverText: Text.new(mem),
        noteTime: 0,
        assets: Models { mesh: mem.alloc::<Mesh>(0) },
        barrier: Mesh {},
        world: w,
        fx: pool.create(mem),
        player: player.create(),
        rotation: 0,
        mining: mining.create(),
        miningShade: Mesh {},
        clock: 0,
        profile: false,
        stageUs: [0, 0, 0, 0],
        hit: Hit {},
        looked: 0,
        plan: Plan {},
    };
}

pub fn startup(g: &Game) {
    gfx.init();
    gfx.setClip(0.05, 100);
    mesher.start();
    render.rebuildNow(&g.world);
    g.assets = models.create();
    g.barrier = render.makeBarrier(&g.world);
    g.miningShade = render.makeMiningShade(&g.world);
    g.fx.cube = cubes.makeCube();
    g.inventoryIcons = item_icons.create();
}

// A screen can open on a storage machine or a smelter.
pub fn storeValid(w: &World, at: int): bool { return container.valid(w, at) || furnace.valid(w, at); }

pub fn openContainer(g: &Game, hit: Hit): bool {
    if !hit.ok { return false; }
    let kind = world.get(&g.world, hit.x, hit.y, hit.z);
    if !world.storage(kind) && !furnace.isSmelter(kind) { return false; }
    let at = world.anchorAt(&g.world, hit.x, hit.y, hit.z);
    if !storeValid(&g.world, at) { return false; }
    g.openStore = at;
    g.inventoryOpen = true;
    game.captureMouse(false);
    return true;
}

// Throw `n` of `id` out in front of the player.
pub fn throwItem(g: &Game, id: u8, n: int) {
    let look = player.lookCells(&g.player);
    let ahead = look.forward();
    drops.spawn(&g.drops, look.eye + ahead * 1.2, ahead * 8 + Vec3.xyz(0, 4, 0), id, n, 1);
}

// Throw what the cursor holds: all of it, or one.
pub fn dropHeld(g: &Game, all: bool) {
    let held = &g.selectedInventory;
    if held.held == 0 { return; }
    let n = 1; if all { n = held.heldCount; }
    throwItem(g, held.held, n);
    held.heldCount -= n;
    if held.heldCount <= 0 { held.held = 0; held.heldCount = 0; }
}

pub fn closeInventory(g: &Game) {
    market.sell(&g.world, g.openStore);
    dropHeld(g, true);
    g.inventoryOpen = false;
    g.openStore = -1;
    game.captureMouse(true);
}
