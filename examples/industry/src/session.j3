// A running game: everything one session owns, and how it starts and opens or closes screens.
module industry.session;

use j3.game;
use j3.game.Texture;
use j3.gfx;
use j3.gfx.Mesh;
use j3.gfx.voxel.Hit;
use j3.io.printLn;
use j3.memory.Arena;
use j3.rand.Rng;
use industry.chunks;
use industry.console;
use industry.console.Console;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.inventory_ui.Selection;
use industry.item_icons;
use industry.machine.container;
use industry.machine.market;
use industry.models;
use industry.models.Models;
use industry.mining.Progress;
use industry.placement.Plan;
use industry.player;
use industry.player.Player;
use industry.render;
use industry.world;
use industry.world.World;

const Furnace = @script("scripts/furnace.j3s");
const Drill = @script("scripts/drill.j3s");
const Power = @script("scripts/power.j3s");

pub struct Game {
    carried: Bag;
    console: Console;
    openStore: int;
    inventoryOpen: bool;
    selectedInventory: Selection;
    inventoryIcons: Texture;
    drill: Drill;
    furnace: Furnace;
    power: Power;
    wireFrom: int;       // anchor of the first machine of a wire being run, -1 for none
    note: string;        // short message above the hotbar
    noteTime: f32;       // seconds left to show it
    assets: Models;
    barrier: Mesh;
    world: World;
    player: Player;
    rotation: u8;
    mining: Progress;
    miningShade: Mesh;
    clock: f32;          // simulation time not yet consumed by fixed steps
    profile: bool;       // time each machine stage (benchmarks only)
    stageUs: [4]int;     // microseconds per stage while profiling
    hit: Hit;            // what the player aims at, set once per update
    looked: u8;          // block id under the aim
    plan: Plan;          // what placing would do, set once per update
}

pub fn boot(mem: &Arena): Game {
    let rng = Rng.new(game.micros());
    let seed = rng.next();
    printLn(`world seed: {seed}`);
    return bootSeed(mem, seed);
}

pub fn bootSeed(mem: &Arena, seed: int): Game {
    let w = world.createSeed(mem, seed);
    chunks.unlock(&w, world.CENTER, world.CENTER);
    let carried = inventory.create(mem);
    inventory.add(&carried, item.PICKAXE, 1);
    return Game {
        carried: carried,
        console: console.create(mem),
        openStore: -1,
        inventoryOpen: false,
        selectedInventory: Selection {},
        inventoryIcons: Texture { raw: 0, w: 0, h: 0 },
        drill: Drill {},
        furnace: Furnace {},
        power: Power {},
        wireFrom: -1,
        note: "",
        noteTime: 0,
        assets: Models { mesh: mem.alloc::<Mesh>(0) },
        barrier: Mesh {},
        world: w,
        player: player.create(),
        rotation: 0,
        mining: Progress {},
        miningShade: Mesh {},
        clock: 0,
        profile: false,
        stageUs: [0, 0, 0, 0],
        hit: Hit {},
        looked: 0,
        plan: Plan {},
    };
}

pub fn startup(g: &Game) {
    gfx.init();
    gfx.setClip(0.05, 100);
    render.rebuild(&g.world, 0);
    g.assets = models.create();
    g.barrier = render.makeBarrier(&g.world);
    g.miningShade = render.makeMiningShade(&g.world);
    g.inventoryIcons = item_icons.create();
}

pub fn openContainer(g: &Game, hit: Hit): bool {
    if !hit.ok || !world.storage(world.get(&g.world, hit.x, hit.y, hit.z)) { return false; }
    let at = world.anchorAt(&g.world, hit.x, hit.y, hit.z);
    if !container.valid(&g.world, at) { return false; }
    g.openStore = at;
    g.inventoryOpen = true;
    game.captureMouse(false);
    return true;
}

pub fn closeInventory(g: &Game) {
    market.sell(&g.world, g.openStore);
    g.selectedInventory.slot = -1;
    g.inventoryOpen = false;
    g.openStore = -1;
    game.captureMouse(true);
}
