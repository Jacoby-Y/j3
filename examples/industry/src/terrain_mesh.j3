// Detailed and merged terrain meshes share exactly the same exposed voxel faces.
module industry.terrain_mesh;
use j3.gfx;
use j3.gfx.voxel;
use j3.math.Vec3;
use j3.sys;
use industry.data.block;
use industry.data.defs;
use j3.math;
use industry.mesh_job;
use industry.mesh_job.Job;
use industry.world;
use industry.world.World;

pub fn terrain(id: u8): bool { return defs.blockIsTerrain(id); }

pub struct Region { x0: int; y0: int; z0: int; x1: int; y1: int; z1: int; }

fn chunk(cx: int, cz: int): Region {
    return Region { x0: cx * world.CHUNK, y0: 0, z0: cz * world.CHUNK,
        x1: (cx + 1) * world.CHUNK, y1: world.SY, z1: (cz + 1) * world.CHUNK };
}

// Flat-index step to the neighbour across `face` in a job's padded grid.
fn faceStep(face: int, lw: int, ld: int): int {
    if face == gfx.FACE_NX { return -1; }
    if face == gfx.FACE_PX { return 1; }
    if face == gfx.FACE_NY { return -lw * ld; }
    if face == gfx.FACE_PY { return lw * ld; }
    if face == gfx.FACE_NZ { return -lw; }
    return lw;
}

// Both meshes and the bounds of the detailed one. Runs on a worker: it touches only `j`.
pub fn build(j: &Job) {
    j.count = detailedJob(j);
    j.lodCount = 0;
    if j.count == 0 { return; }
    let lx = j.out[0]; let ly = j.out[1]; let lz = j.out[2];
    let hx = lx; let hy = ly; let hz = lz;
    for vertex in 0..j.count / 10 {
        let at = vertex * 10;
        lx = math.min(lx, j.out[at]); hx = math.max(hx, j.out[at]);
        ly = math.min(ly, j.out[at + 1]); hy = math.max(hy, j.out[at + 1]);
        lz = math.min(lz, j.out[at + 2]); hz = math.max(hz, j.out[at + 2]);
    }
    j.lo = Vec3.xyz(lx, ly, lz); j.hi = Vec3.xyz(hx, hy, hz);
    j.lodCount = mergedJob(j);
}

pub fn detailedJob(j: &Job): int {
    let at = 0;
    let lw = j.w + 2; let lh = j.h + 2; let ld = j.d + 2;
    for ly in 1..j.h + 1 { for lz in 1..j.d + 1 { for lx in 1..j.w + 1 {
        let i = voxel.index(lx, ly, lz, lw, ld);
        let id = j.cells[i];
        if !terrain(id) { continue; }
        let c = Vec3.xyz(0, 0, 0);
        let tinted = false;
        for face in 0..6 {
            if terrain(j.cells[i + faceStep(face, lw, ld)]) { continue; }
            let x = j.x0 + lx - 1; let y = j.y0 + ly - 1; let z = j.z0 + lz - 1;
            if !tinted { c = block.tint(id, x, y, z); tinted = true; }
            if at + 60 > j.out.len { sys.panic("section terrain mesh capacity exhausted"); }
            let corners = voxel.corners(j.cells, lw, lh, ld, lx, ly, lz, face);
            at = gfx.emitFaceAo(j.out, at, f32(x), f32(y), f32(z), face,
                c.x, c.y, c.z, 0,
                voxel.shade(corners.a), voxel.shade(corners.b),
                voxel.shade(corners.c), voxel.shade(corners.d));
        }
    } } }
    return at;
}

// World position of a mask cell: `plane` along the face normal, `u` and `v` across it.
fn cell(j: &Job, face: int, plane: int, u: int, v: int): Vec3 {
    let x = u; let y = v; let z = plane;
    if face == gfx.FACE_NX || face == gfx.FACE_PX { x = plane; z = u; }
    if face == gfx.FACE_NY || face == gfx.FACE_PY { y = plane; z = v; }
    return Vec3.xyz(f32(j.x0 + x), f32(j.y0 + y), f32(j.z0 + z));
}

// Expand the unit face only along its tangent axes; winding and normals stay intact.
fn rectangle(j: &Job, at: int, p: Vec3, face: int, width: int, height: int, id: u8): int {
    if at + 60 > j.lod.len { sys.panic("merged terrain mesh capacity exhausted"); }
    let color = block.color(id);
    let next = gfx.emitFace(j.lod, at, p.x, p.y, p.z, face, color.x, color.y, color.z, 0);
    for vertex in 0..6 {
        let pos = at + vertex * 10;
        if face == gfx.FACE_NX || face == gfx.FACE_PX {
            j.lod[pos + 2] = p.z + (j.lod[pos + 2] - p.z) * f32(width);
            j.lod[pos + 1] = p.y + (j.lod[pos + 1] - p.y) * f32(height);
        } else if face == gfx.FACE_NY || face == gfx.FACE_PY {
            j.lod[pos] = p.x + (j.lod[pos] - p.x) * f32(width);
            j.lod[pos + 2] = p.z + (j.lod[pos + 2] - p.z) * f32(height);
        } else {
            j.lod[pos] = p.x + (j.lod[pos] - p.x) * f32(width);
            j.lod[pos + 1] = p.y + (j.lod[pos + 1] - p.y) * f32(height);
        }
    }
    return next;
}

fn planeMesh(j: &Job, face: int, plane: int, rows: int, stride: int, at: int): int {
    // Int walk of the plane in the padded grid (region cell 0 is grid cell 1) with the face normal as an offset.
    let lw = j.w + 2; let ld = j.d + 2;
    let ox = 1; let oy = 1; let oz = 1;
    let ux = 1; let uy = 0; let uz = 0; let vx = 0; let vy = 1; let vz = 0;
    let step = faceStep(face, lw, ld);
    if face == gfx.FACE_NX || face == gfx.FACE_PX { ox += plane; ux = 0; uz = 1; }
    else if face == gfx.FACE_NY || face == gfx.FACE_PY { oy += plane; vy = 0; vz = 1; }
    else { oz += plane; }
    for v in 0..rows { for u in 0..stride {
        let i = voxel.index(ox + u * ux + v * vx, oy + u * uy + v * vy, oz + u * uz + v * vz, lw, ld);
        let id = j.cells[i];
        j.mask[u + v * stride] = 0;
        if terrain(id) && !terrain(j.cells[i + step]) { j.mask[u + v * stride] = id; }
    } }
    let count = at;
    for row in 0..rows { for column in 0..stride {
        let material = j.mask[column + row * stride];
        if material == 0 { continue; }
        let width = 1;
        while column + width < stride && j.mask[column + width + row * stride] == material { width += 1; }
        let height = 1; let fits = true;
        while row + height < rows && fits {
            for span in 0..width {
                if j.mask[column + span + (row + height) * stride] != material { fits = false; }
            }
            if fits { height += 1; }
        }
        let origin = cell(j, face, plane, column, row);
        count = rectangle(j, count, origin, face, width, height, material);
        for dy in 0..height { for dx in 0..width { j.mask[column + dx + (row + dy) * stride] = 0; } }
    } }
    return count;
}

// Greedy rectangles remove internal triangulation and per-voxel shading detail,
// while retaining every exposed cell, material boundary, and cave opening.
pub fn mergedJob(j: &Job): int {
    let at = 0;
    for face in 0..6 {
        let planes = j.d; let rows = j.h; let stride = j.w;
        if face == gfx.FACE_NX || face == gfx.FACE_PX { planes = j.w; stride = j.d; }
        if face == gfx.FACE_NY || face == gfx.FACE_PY { planes = j.h; rows = j.d; }
        for plane in 0..planes { at = planeMesh(j, face, plane, rows, stride, at); }
    }
    return at;
}

// Whole-region meshes into `w.scratch`, run inline: for tests and tools that read the mesh back.
fn inline(w: &World, region: Region, merged: bool): int {
    let j = mesh_job.create(region.x0, region.y0, region.z0, region.x1 - region.x0, region.y1 - region.y0,
        region.z1 - region.z0);
    mesh_job.snapshot(&j, w);
    let count = 0;
    if merged { count = mergedJob(&j); for at in 0..count { w.scratch[at] = j.lod[at]; } }
    else { count = detailedJob(&j); for at in 0..count { w.scratch[at] = j.out[at]; } }
    mesh_job.destroy(&j);
    return count;
}

pub fn detailed(w: &World, cx: int, cz: int): int { return detailedRegion(w, chunk(cx, cz)); }
pub fn merged(w: &World, cx: int, cz: int): int { return mergedRegion(w, chunk(cx, cz)); }
pub fn detailedRegion(w: &World, region: Region): int { return inline(w, region, false); }
pub fn mergedRegion(w: &World, region: Region): int { return inline(w, region, true); }
