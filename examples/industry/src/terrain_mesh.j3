// Detailed and merged terrain meshes share exactly the same exposed voxel faces.
module industry.terrain_mesh;
use j3.gfx;
use j3.gfx.voxel;
use j3.math.Vec3;
use j3.sys;
use industry.data.block;
use industry.data.defs;
use industry.world;
use industry.world.World;

pub fn terrain(id: u8): bool { return defs.blockIsTerrain(id); }

pub fn exposed(w: &World, x: int, y: int, z: int, face: int): bool {
    let nx = x; let ny = y; let nz = z;
    if face == gfx.FACE_NX { nx -= 1; }
    if face == gfx.FACE_PX { nx += 1; }
    if face == gfx.FACE_NY { ny -= 1; }
    if face == gfx.FACE_PY { ny += 1; }
    if face == gfx.FACE_NZ { nz -= 1; }
    if face == gfx.FACE_PZ { nz += 1; }
    return !terrain(world.get(w, nx, ny, nz));
}

pub struct Region { x0: int; y0: int; z0: int; x1: int; y1: int; z1: int; }

fn chunk(cx: int, cz: int): Region {
    return Region { x0: cx * world.CHUNK, y0: 0, z0: cz * world.CHUNK,
        x1: (cx + 1) * world.CHUNK, y1: world.SY, z1: (cz + 1) * world.CHUNK };
}

pub fn detailed(w: &World, cx: int, cz: int): int { return detailedRegion(w, chunk(cx, cz)); }

// Flat-index step to the neighbour across `face`; valid away from the world border.
fn faceStep(face: int): int {
    if face == gfx.FACE_NX { return -1; }
    if face == gfx.FACE_PX { return 1; }
    if face == gfx.FACE_NY { return -world.SX * world.SZ; }
    if face == gfx.FACE_PY { return world.SX * world.SZ; }
    if face == gfx.FACE_NZ { return -world.SX; }
    return world.SX;
}

pub fn detailedRegion(w: &World, region: Region): int {
    let at = 0;
    let y = region.y0;
    while y < region.y1 {
        let z = region.z0;
        while z < region.z1 {
            let x = region.x0;
            let inner = y > 0 && y < world.SY - 1 && z > 0 && z < world.SZ - 1;
            while x < region.x1 {
                let i = voxel.index(x, y, z, world.SX, world.SZ);
                let id = w.cells[i];
                if terrain(id) {
                    let interior = inner && x > 0 && x < world.SX - 1;
                    let c = Vec3.xyz(0, 0, 0);
                    let tinted = false;
                    let face = 0;
                    while face < 6 {
                        let open = false;
                        if interior { open = !terrain(w.cells[i + faceStep(face)]); }
                        else { open = exposed(w, x, y, z, face); }
                        if open {
                            if !tinted { c = block.tint(id, x, y, z); tinted = true; }
                            if at + 60 > w.scratch.len { sys.panic("chunk terrain mesh capacity exhausted"); }
                            let corners = voxel.corners(w.cells, world.SX, world.SY, world.SZ,
                                x, y, z, face);
                            at = gfx.emitFaceAo(w.scratch, at, f32(x), f32(y), f32(z), face,
                                c.x, c.y, c.z, 0,
                                voxel.shade(corners.a), voxel.shade(corners.b),
                                voxel.shade(corners.c), voxel.shade(corners.d));
                        }
                        face += 1;
                    }
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return at;
}

// Map a face plane to world cells; its two tangent axes form a 2D mask.
fn cell(region: Region, face: int, plane: int, u: int, v: int): Vec3 {
    let x = u; let y = v; let z = plane;
    if face == gfx.FACE_NX || face == gfx.FACE_PX { x = plane; z = u; }
    if face == gfx.FACE_NY || face == gfx.FACE_PY { y = plane; z = v; }
    return Vec3.xyz(f32(region.x0 + x), f32(region.y0 + y), f32(region.z0 + z));
}

// Expand the unit face only along its tangent axes; winding and normals stay intact.
fn rectangle(w: &World, at: int, p: Vec3, face: int, width: int, height: int, id: u8): int {
    if at + 60 > w.scratch.len { sys.panic("merged terrain mesh capacity exhausted"); }
    let color = block.color(id);
    let next = gfx.emitFace(w.scratch, at, p.x, p.y, p.z, face, color.x, color.y, color.z, 0);
    for vertex in 0..6 {
        let pos = at + vertex * 10;
        if face == gfx.FACE_NX || face == gfx.FACE_PX {
            w.scratch[pos + 2] = p.z + (w.scratch[pos + 2] - p.z) * f32(width);
            w.scratch[pos + 1] = p.y + (w.scratch[pos + 1] - p.y) * f32(height);
        } else if face == gfx.FACE_NY || face == gfx.FACE_PY {
            w.scratch[pos] = p.x + (w.scratch[pos] - p.x) * f32(width);
            w.scratch[pos + 2] = p.z + (w.scratch[pos + 2] - p.z) * f32(height);
        } else {
            w.scratch[pos] = p.x + (w.scratch[pos] - p.x) * f32(width);
            w.scratch[pos + 1] = p.y + (w.scratch[pos + 1] - p.y) * f32(height);
        }
    }
    return next;
}

fn planeMesh(w: &World, region: Region, face: int, plane: int, rows: int, stride: int, at: int): int {
    // Int walk of the plane (same mapping as `cell`) with the face normal as a fixed offset.
    let ox = region.x0; let oy = region.y0; let oz = region.z0;
    let ux = 1; let uy = 0; let uz = 0; let vx = 0; let vy = 1; let vz = 0;
    let nx = 0; let ny = 0; let nz = 0;
    if face == gfx.FACE_NX || face == gfx.FACE_PX { ox += plane; ux = 0; uz = 1; }
    else if face == gfx.FACE_NY || face == gfx.FACE_PY { oy += plane; vy = 0; vz = 1; }
    else { oz += plane; }
    if face == gfx.FACE_NX { nx = -1; } if face == gfx.FACE_PX { nx = 1; }
    if face == gfx.FACE_NY { ny = -1; } if face == gfx.FACE_PY { ny = 1; }
    if face == gfx.FACE_NZ { nz = -1; } if face == gfx.FACE_PZ { nz = 1; }
    for v in 0..rows { for u in 0..stride {
        let x = ox + u * ux + v * vx; let y = oy + u * uy + v * vy; let z = oz + u * uz + v * vz;
        let id = world.get(w, x, y, z);
        w.lodMask[u + v * stride] = 0;
        if terrain(id) && !terrain(world.get(w, x + nx, y + ny, z + nz)) { w.lodMask[u + v * stride] = id; }
    } }
    let count = at;
    for row in 0..rows { for column in 0..stride {
        let material = w.lodMask[column + row * stride];
        if material == 0 { continue; }
        let width = 1;
        while column + width < stride && w.lodMask[column + width + row * stride] == material { width += 1; }
        let height = 1; let fits = true;
        while row + height < rows && fits {
            for span in 0..width {
                if w.lodMask[column + span + (row + height) * stride] != material { fits = false; }
            }
            if fits { height += 1; }
        }
        let origin = cell(region, face, plane, column, row);
        count = rectangle(w, count, origin, face, width, height, material);
        for dy in 0..height { for dx in 0..width { w.lodMask[column + dx + (row + dy) * stride] = 0; } }
    } }
    return count;
}

// Greedy rectangles remove internal triangulation and per-voxel shading detail,
// while retaining every exposed cell, material boundary, and cave opening.
pub fn merged(w: &World, cx: int, cz: int): int { return mergedRegion(w, chunk(cx, cz)); }

pub fn mergedRegion(w: &World, region: Region): int {
    let at = 0;
    for face in 0..6 {
        let planes = region.z1 - region.z0; let rows = region.y1 - region.y0; let stride = region.x1 - region.x0;
        if face == gfx.FACE_NX || face == gfx.FACE_PX { planes = region.x1 - region.x0; stride = region.z1 - region.z0; }
        if face == gfx.FACE_NY || face == gfx.FACE_PY { planes = region.y1 - region.y0; rows = region.z1 - region.z0; }
        for plane in 0..planes { at = planeMesh(w, region, face, plane, rows, stride, at); }
    }
    return at;
}
