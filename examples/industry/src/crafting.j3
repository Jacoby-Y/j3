// The player's craft queue: runs of (item, count) made one at a time. Queueing a craft takes its
// ingredients at once; cancelling one gives them back.
module industry.crafting;
use j3.memory.Arena;
use industry.inventory;
use industry.inventory.Bag;
use industry.data.item;

pub const ENTRIES: int = 16;
pub struct Queue { ids: []u8; left: []int; count: int = 0; progress: f32 = 0; }

pub fn create(mem: &Arena): Queue { return Queue { ids: mem.alloc::<u8>(ENTRIES), left: mem.alloc::<int>(ENTRIES) }; }

// How many of `id` are waiting, including the one being made.
pub fn queued(q: &Queue, id: u8): int {
    let sum = 0;
    for entry in 0..q.count { if q.ids[entry] == id { sum += q.left[entry]; } }
    return sum;
}

// Fraction of the craft in progress when `id` is the one being made, else 0.
pub fn fraction(q: &Queue, id: u8): f32 {
    if q.count == 0 || q.ids[0] != id { return 0; }
    return q.progress / item.craftTime(id);
}

// Queue up to `n` of `id`, paying for each now; whatever the bag can't afford is left out.
pub fn push(q: &Queue, bag: &Bag, id: u8, n: int) {
    let fits = q.count < ENTRIES || (q.count > 0 && q.ids[q.count - 1] == id);
    let afford = inventory.times(bag, id);
    if n > afford { n = afford; }
    if n <= 0 || !fits { return; }
    for i in 0..n { inventory.pay(bag, id); }
    if q.count > 0 && q.ids[q.count - 1] == id { q.left[q.count - 1] += n; return; }
    q.ids[q.count] = id; q.left[q.count] = n; q.count += 1;
}

fn drop(q: &Queue, entry: int) {
    for i in entry..q.count - 1 { q.ids[i] = q.ids[i + 1]; q.left[i] = q.left[i + 1]; }
    q.count -= 1;
}

// Remove the latest queued `id` and refund it (a craft already under way restarts from nothing).
pub fn cancel(q: &Queue, bag: &Bag, id: u8) {
    let entry = q.count - 1;
    while entry >= 0 && q.ids[entry] != id { entry -= 1; }
    if entry < 0 { return; }
    inventory.refund(bag, id);
    if entry == 0 { q.progress = 0; }
    q.left[entry] -= 1;
    if q.left[entry] == 0 { drop(q, entry); }
}

pub fn update(q: &Queue, bag: &Bag, dt: f32) {
    if q.count == 0 { return; }
    let id = q.ids[0];
    q.progress += dt;
    if q.progress < item.craftTime(id) { return; }
    if inventory.room(bag, id) < 1 { q.progress = item.craftTime(id); return; }
    inventory.add(bag, id, 1); inventory.sync(bag);
    q.progress = 0; q.left[0] -= 1;
    if q.left[0] == 0 { drop(q, 0); }
}
