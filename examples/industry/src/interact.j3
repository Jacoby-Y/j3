// What the player's keys and mouse do to the aimed block or machine.
module industry.interact;

use j3.game;
use j3.math.Vec3;
use industry.drops;
use j3.gfx.voxel.Hit;
use industry.chunks;
use industry.data.block;
use industry.data.item;
use industry.fx.effects;
use industry.gen.veins;
use industry.inventory;
use industry.machine.dispatch;
use industry.mining;
use industry.player;
use industry.placement;
use industry.session;
use industry.session.Game;
use industry.wiring;
use industry.world;

// Hand-collecting ore: one item per this many seconds.
const ORE_TIME: f32 = 2;
// Time to remove an ordinary block or structure.
const BREAK_TIME: f32 = 0.35;

// E and F: machines take their own presses; otherwise E opens storage or unlocks a chunk.
// Returns true when a screen opened, so the frame ends.
pub fn keys(g: &Game): bool {
    let pressedE = game.keyPressed(game.Key.E);
    let used = false;
    if world.machine(g.looked) {
        used = dispatch.interact(&g.world, world.anchorAt(&g.world, g.hit.x, g.hit.y, g.hit.z), &g.carried,
            pressedE, game.keyPressed(game.Key.F));
    }
    if used || !pressedE { return false; }
    if session.openContainer(g, g.hit) { return true; }
    let look = player.lookCells(&g.player);
    let target = chunks.lockAt(&g.world, look.eye, look.forward());
    if target >= 0 { chunks.buy(&g.world, target % world.CHUNKS, target / world.CHUNKS); }
    return false;
}

// Hold left with the pickaxe to mine or break, right click to place; click a machine with its input in hand to load it.
pub fn mouse(g: &Game, dt: f32) {
    if wiring.holding(g) {
        if game.mousePressed(game.Mouse.Left) { wiring.click(g); }
        return;
    }
    let held = inventory.slotItem(&g.carried, g.player.slot);
    if world.machine(g.looked) && held != item.PICKAXE && held != 0 &&
        (game.mousePressed(game.Mouse.Right) || game.mousePressed(game.Mouse.Left)) {
        let amount = 1; if game.keyDown(game.Key.Shift) { amount = g.carried.counts[int(held)]; }
        let at = world.anchorAt(&g.world, g.hit.x, g.hit.y, g.hit.z);
        if dispatch.insert(&g.world, at, &g.carried, held, amount) > 0 { return; }
    }
    if swapTier(g, held) { return; }
    let oreItem = item.fromOre(g.looked);
    let picking = oreItem != 0 && held == item.PICKAXE;
    if game.mouseDown(game.Mouse.Left) && g.hit.ok && held == item.PICKAXE {
        let duration = BREAK_TIME;
        if picking { duration = ORE_TIME; }
        effects.dust(&g.fx, g.hit, g.looked, dt);
        if mining.advance(&g.mining, g.hit, g.looked, duration, dt) {
            if picking { collectOre(g, g.hit); }
            else { collectBlock(g, g.hit); }
        }
    }
    if game.mousePressed(game.Mouse.Right) {
        placement.placeInventory(&g.world, &g.carried, g.player.slot, g.plan);
    }
}

// Click a structure with the other tier of it in hand to swap it in place; the old one goes to the bag.
fn swapTier(g: &Game, held: u8): bool {
    if held == 0 || !world.machine(g.looked) || !(game.mousePressed(game.Mouse.Right) || game.mousePressed(game.Mouse.Left)) { return false; }
    let id = item.blockFor(held);
    let at = world.anchorAt(&g.world, g.hit.x, g.hit.y, g.hit.z);
    let old = g.world.cells[at];
    if id == 0 || old == id { return false; }
    if block.lifter(old) != old { id = block.lowerer(id); }
    if !world.swapMachine(&g.world, at, id) { return false; }
    g.carried.counts[int(held)] -= 1;
    inventory.sync(&g.carried);
    inventory.add(&g.carried, item.fromBlock(old), 1);
    return true;
}

// Break a block or structure; what it was made of drops at its centre to be picked up.
pub fn collectBlock(g: &Game, hit: Hit): bool {
    if !hit.ok || !world.editable(&g.world, hit.x, hit.y, hit.z) { return false; }
    let id = item.fromBlock(world.get(&g.world, hit.x, hit.y, hit.z));
    if id == 0 { return false; }
    let kind = world.get(&g.world, hit.x, hit.y, hit.z);
    world.breakAt(&g.world, hit.x, hit.y, hit.z);
    if world.get(&g.world, hit.x, hit.y, hit.z) != block.AIR { return false; }
    effects.debris(&g.fx, hit.x, hit.y, hit.z, kind);
    // A small fixed scatter by position, so neighbours do not stack on one line.
    let kick = f32((hit.x * 7 + hit.z * 13) % 5 - 2);
    drops.spawn(&g.drops, Vec3.xyz(f32(hit.x) + 0.5, f32(hit.y) + 0.5, f32(hit.z) + 0.5), Vec3.xyz(kick, 5, -kick * 0.5), id, 1, 0.3);
    return true;
}

// Award a whole finite block yield atomically; a full bag cannot destroy ore.
pub fn collectOre(g: &Game, hit: Hit): bool {
    if !hit.ok || !world.editable(&g.world, hit.x, hit.y, hit.z) ||
        inventory.slotItem(&g.carried, g.player.slot) != item.PICKAXE { return false; }
    let id = world.get(&g.world, hit.x, hit.y, hit.z); let resource = item.fromOre(id);
    if resource == 0 { return false; }
    let amount = 1;
    if block.isVein(id) { amount = veins.yieldAt(g.world.seed, hit.x, hit.y, hit.z); }
    if inventory.room(&g.carried, resource) < amount { return false; }
    if block.isVein(id) {
        world.breakAt(&g.world, hit.x, hit.y, hit.z);
        effects.debris(&g.fx, hit.x, hit.y, hit.z, id);
    }
    inventory.add(&g.carried, resource, amount);
    return true;
}
