// What the player's keys and mouse do to the aimed block or machine.
module industry.interact;

use j3.game;
use j3.gfx.voxel.Hit;
use industry.chunks;
use industry.data.block;
use industry.data.item;
use industry.gen.veins;
use industry.inventory;
use industry.machine.dispatch;
use industry.mining;
use industry.placement;
use industry.session;
use industry.session.Game;
use industry.wiring;
use industry.world;

// Hand-collecting ore: one item per this many seconds.
const ORE_TIME: f32 = 2;
// Time to remove an ordinary block or structure.
const BREAK_TIME: f32 = 0.35;

// E and F: machines take their own presses; otherwise E opens storage or unlocks a chunk.
// Returns true when a screen opened, so the frame ends.
pub fn keys(g: &Game): bool {
    let pressedE = game.keyPressed(game.Key.E);
    let used = false;
    if world.machine(g.looked) {
        used = dispatch.interact(&g.world, world.anchorAt(&g.world, g.hit.x, g.hit.y, g.hit.z), &g.carried,
            pressedE, game.keyPressed(game.Key.F));
    }
    if used || !pressedE { return false; }
    if session.openContainer(g, g.hit) { return true; }
    let target = chunks.nearby(&g.world, g.player.body.pos);
    if target >= 0 { chunks.buy(&g.world, target % world.CHUNKS, target / world.CHUNKS); }
    return false;
}

// Hold left to mine or break, right click to place.
pub fn mouse(g: &Game, dt: f32) {
    if wiring.holding(g) {
        if game.mousePressed(game.Mouse.Right) { wiring.click(g); }
        return;
    }
    let oreItem = item.fromOre(g.looked);
    let picking = oreItem != 0 && inventory.slotItem(&g.carried, g.player.slot) == item.PICKAXE;
    if game.mouseDown(game.Mouse.Left) && g.hit.ok && (oreItem == 0 || picking) {
        let duration = BREAK_TIME;
        if picking { duration = ORE_TIME; }
        if mining.advance(&g.mining, g.hit, g.looked, duration, dt) {
            if picking { collectOre(g, g.hit); }
            else { collectBlock(g, g.hit); }
        }
    }
    if game.mousePressed(game.Mouse.Right) {
        placement.placeInventory(&g.world, &g.carried, g.player.slot, g.plan);
    }
}

// Do not destroy a block when its recovered item cannot fit or removal is refused.
pub fn collectBlock(g: &Game, hit: Hit): bool {
    if !hit.ok || !world.editable(&g.world, hit.x, hit.y, hit.z) || inventory.total(&g.carried) >= inventory.CAPACITY { return false; }
    let id = item.fromBlock(world.get(&g.world, hit.x, hit.y, hit.z));
    if id == 0 { return false; }
    world.breakAt(&g.world, hit.x, hit.y, hit.z);
    if world.get(&g.world, hit.x, hit.y, hit.z) != block.AIR { return false; }
    inventory.add(&g.carried, id, 1);
    return true;
}

// Award a whole finite block yield atomically; a full bag cannot destroy ore.
pub fn collectOre(g: &Game, hit: Hit): bool {
    if !hit.ok || !world.editable(&g.world, hit.x, hit.y, hit.z) ||
        inventory.slotItem(&g.carried, g.player.slot) != item.PICKAXE { return false; }
    let id = world.get(&g.world, hit.x, hit.y, hit.z); let resource = item.fromOre(id);
    if resource == 0 { return false; }
    let amount = 1;
    if block.isVein(id) { amount = veins.yieldAt(g.world.seed, hit.x, hit.y, hit.z); }
    if inventory.CAPACITY - inventory.total(&g.carried) < amount { return false; }
    if block.isVein(id) { world.breakAt(&g.world, hit.x, hit.y, hit.z); }
    inventory.add(&g.carried, resource, amount);
    return true;
}
