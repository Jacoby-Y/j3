// Section meshing on worker threads. Main loads a snapshot of a dirty section into a free job slot and
// submits it; a worker builds both meshes into the slot's own buffers and reports the slot on `done`;
// main uploads it (`render.rebuild`). Only main touches the world, GL, and the slot table.
module industry.mesher;

use j3.math;
use j3.memory.Arena;
use j3.option.Option;
use j3.sys;
use j3.thread.{ Pool, Queue, cores };
use industry.gen.terrain;
use industry.mesh_job;
use industry.mesh_job.Job;
use industry.terrain_mesh;
use industry.terrain_mesh.Region;
use industry.world;
use industry.world.World;

// Jobs in flight at once; each owns about 18 MB of mostly untouched address space.
const SLOTS: int = 3;

pub struct Mesher {
    ready: bool;
    pool: &Pool;
    done: &Queue<int>;
    jobs: []Job;
    taken: []u8;     // slot is loaded or running or waiting to be collected
}

#[singleton]
let STATE: Mesher;
#[singleton]
let ARENA: Arena;

// The chunk being generated: main fills it in and submits, the worker sets `done` last.
struct GenJob { w: &World; cx: int; cz: int; done: int; }
#[singleton]
let GEN: GenJob;

pub fn ready(): bool { return STATE.ready; }

// Starts the workers; they live as long as the process.
pub fn start() {
    if STATE.ready { return; }
    ARENA = Arena.create(65536);
    let workers = cores() - 1;
    if workers < 1 { workers = 1; }
    if workers > SLOTS { workers = SLOTS; }
    let results = ARENA.alloc::<Queue<int>>(1);
    results[0] = Queue<int>.create(&ARENA, SLOTS);
    STATE.done = &results[0];
    STATE.pool = Pool.create(&ARENA, workers, SLOTS + 1);  // room for the generation job beside the mesh jobs
    STATE.jobs = ARENA.alloc::<Job>(SLOTS);
    STATE.taken = ARENA.alloc::<u8>(SLOTS);
    for slot in 0..SLOTS {
        let j = mesh_job.create(0, 0, 0, world.SECTION_X, world.SECTION_Y, world.SECTION_X);
        j.slot = slot; j.done = STATE.done as ptr;
        STATE.jobs[slot] = j;
    }
    STATE.ready = true;
}

pub fn sectionRegion(section: int): Region {
    let x = section % world.SECTIONS_X * world.SECTION_X;
    let y = section / (world.SECTIONS_X * world.SECTIONS_X) * world.SECTION_Y;
    let z = (section / world.SECTIONS_X) % world.SECTIONS_X * world.SECTION_X;
    return Region { x0: x, y0: y, z0: z, x1: x + world.SECTION_X,
        y1: math.mini(y + world.SECTION_Y, world.SY), z1: z + world.SECTION_X };
}

// Points `j` at `section` and copies its cells; stamps the version they belong to.
pub fn load(j: &Job, w: &World, section: int) {
    let r = sectionRegion(section);
    j.x0 = r.x0; j.y0 = r.y0; j.z0 = r.z0;
    j.h = world.SECTION_Y;
    if r.y0 + j.h > world.SY { j.h = world.SY - r.y0; }
    j.section = section;
    j.version = w.sectionVersion[section];
    mesh_job.snapshot(j, w);
}

fn run(arg: ptr) {
    let j = arg as &Job;
    terrain_mesh.build(j);
    let done = j.done as &Queue<int>;
    done.push(j.slot);
}

// Builds `section` on a worker. False when every slot is busy: try again next frame.
pub fn dispatch(w: &World, section: int): bool {
    for slot in 0..SLOTS {
        if STATE.taken[slot] != 0 { continue; }
        let j = &STATE.jobs[slot];
        load(j, w, section);
        if !STATE.pool.trySubmit(run, j as ptr) { return false; }
        STATE.taken[slot] = 1; w.sectionBusy[section] = 1;
        return true;
    }
    return false;
}

// The slot of a finished job, or -1 when none is ready. Hand it back with `release`.
pub fn collect(): int {
    match STATE.done.tryPop() {
        Option.None { return -1; }
        Option.Some(slot) { return slot; }
    }
}

pub fn job(slot: int): &Job { return &STATE.jobs[slot]; }

pub fn release(slot: int) { STATE.taken[slot] = 0; }

fn generateChunk(arg: ptr) {
    let g = arg as &GenJob;
    terrain.build(g.w, g.cx, g.cz);
    @atomicStore(&g.done, 1);
}

// Builds a chunk's terrain on a worker (inline until `start`); `generated` turns true when it is done.
// One chunk at a time, and main must leave the chunk alone until `terrain.finish`.
pub fn generate(w: &World, cx: int, cz: int) {
    GEN.w = w; GEN.cx = cx; GEN.cz = cz;
    if !STATE.ready { terrain.build(w, cx, cz); GEN.done = 1; return; }
    GEN.done = 0;
    if !STATE.pool.trySubmit(generateChunk, &GEN as ptr) { sys.panic("generation job does not fit the worker queue"); }
}

pub fn generated(): bool { return @atomicLoad(&GEN.done) == 1; }
