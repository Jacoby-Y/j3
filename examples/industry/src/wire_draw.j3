// Wires as lines between machine tops: copper when idle, yellow when carrying power.
module industry.wire_draw;

use j3.gfx;
use j3.gfx.voxel.Hit;
use j3.math.Vec3;
use industry.data.block;
use industry.machine.power;
use industry.world;
use industry.world.World;

// Where a wire meets a machine, in voxel units.
fn endpoint(w: &World, anchor: int): Vec3 {
    let drop: f32 = 0.4;
    if w.cells[anchor] == block.POST { drop = 0.1; } // the taller post's insulators sit higher
    return Vec3.xyz(f32(world.anchorX(anchor)) + 1, f32(world.anchorY(anchor) + world.height(w.cells[anchor])) - drop,
        f32(world.anchorZ(anchor)) + 1);
}

fn line(a: Vec3, b: Vec3, color: Vec3) {
    // GL lines are one pixel wide, so a thick wire is a small bundle of offset lines.
    let spread: f32 = 0.07;
    let offsets: [5]Vec3 = [Vec3.zero(), Vec3.xyz(0, spread, 0), Vec3.xyz(0, -spread, 0), Vec3.xyz(spread, 0, 0), Vec3.xyz(0, 0, spread)];
    for i in 0..5 { gfx.drawLine((a + offsets[i]) * world.VOXEL, (b + offsets[i]) * world.VOXEL, color); }
}

// Every wire, plus the one being run from `from` to what the player aims at, or to a point ahead of
// them, never longer than a wire can reach.
pub fn draw(w: &World, from: int, hit: Hit, eye: Vec3, forward: Vec3) {
    for i in 0..w.wireCount {
        let a = int(w.wireA[i]); let b = int(w.wireB[i]);
        let color = Vec3.xyz(0.9, 0.5, 0.22);
        if w.powered[a] > 0 { color = Vec3.xyz(1, 0.9, 0.3); }
        line(endpoint(w, world.slotAnchor(w, a)), endpoint(w, world.slotAnchor(w, b)), color);
    }
    if from >= 0 {
        let start = endpoint(w, from);
        let aim = eye + forward * f32(power.REACH);
        if hit.ok { aim = Vec3.xyz(f32(hit.x) + 0.5, f32(hit.y) + 0.5, f32(hit.z) + 0.5); }
        let span = aim - start;
        if span.length() > f32(power.REACH) { aim = start + span.normalize() * f32(power.REACH); }
        line(start, aim, Vec3.xyz(1, 1, 1));
    }
}
