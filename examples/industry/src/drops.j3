// Items lying in the world: thrown out of the inventory or the hand, walked over to pick up.
// Positions are in cells; each drop is a small spinning cube in its item's color.
module industry.drops;

use j3.gfx;
use j3.gfx.{ Instance, Mesh };
use j3.gfx.voxel;
use j3.math.{ Mat4, Vec3, sin };
use j3.memory.Arena;
use industry.data.defs;
use industry.inventory;
use industry.inventory.Bag;
use industry.player.Player;
use industry.world;
use industry.world.World;

pub const MAX: int = 256;
const GRAVITY: f32 = 36;
const HALF: f32 = 0.2;
// Cells from the player's centre within which a drop is picked up, and seconds before it may be.
const PICKUP: f32 = 3;
const DELAY: f32 = 1;
const LIFE: f32 = 300;
// Same kind of drop closer than this (cells) merges into one.
const MERGE: f32 = 1;

pub struct Drops {
    count: int;
    x: []f32; y: []f32; z: []f32;
    vx: []f32; vy: []f32; vz: []f32;
    age: []f32;
    id: []u8;
    n: []int;
    instances: []Instance;
}

pub fn create(mem: &Arena): Drops {
    return Drops {
        count: 0,
        x: mem.alloc::<f32>(MAX), y: mem.alloc::<f32>(MAX), z: mem.alloc::<f32>(MAX),
        vx: mem.alloc::<f32>(MAX), vy: mem.alloc::<f32>(MAX), vz: mem.alloc::<f32>(MAX),
        age: mem.alloc::<f32>(MAX), id: mem.alloc::<u8>(MAX), n: mem.alloc::<int>(MAX),
        instances: mem.alloc::<Instance>(MAX),
    };
}

fn remove(d: &Drops, i: int) {
    let last = d.count - 1;
    d.x[i] = d.x[last]; d.y[i] = d.y[last]; d.z[i] = d.z[last];
    d.vx[i] = d.vx[last]; d.vy[i] = d.vy[last]; d.vz[i] = d.vz[last];
    d.age[i] = d.age[last]; d.id[i] = d.id[last]; d.n[i] = d.n[last];
    d.count = last;
}

// Drop `n` of `id` at `at` moving at `vel` (cells per second), pickable after `wait` seconds. A full
// world recycles the oldest drop.
pub fn spawn(d: &Drops, at: Vec3, vel: Vec3, id: u8, n: int, wait: f32) {
    if id == 0 || n <= 0 { return; }
    for i in 0..d.count {
        let dx = d.x[i] - at.x; let dy = d.y[i] - at.y; let dz = d.z[i] - at.z;
        if d.id[i] == id && dx * dx + dy * dy + dz * dz < MERGE * MERGE { d.n[i] += n; return; }
    }
    let i = d.count;
    if i == MAX {
        i = 0;
        for k in 0..d.count { if d.age[k] > d.age[i] { i = k; } }
    } else { d.count += 1; }
    d.x[i] = at.x; d.y[i] = at.y; d.z[i] = at.z;
    d.vx[i] = vel.x; d.vy[i] = vel.y; d.vz[i] = vel.z;
    d.age[i] = DELAY - wait; d.id[i] = id; d.n[i] = n;
}

fn blocked(w: &World, x: f32, y: f32, z: f32): bool {
    return voxel.overlaps(w.cells, world.SX, world.SY, world.SZ,
        Vec3.xyz(x - HALF, y - HALF, z - HALF), Vec3.xyz(x + HALF, y + HALF, z + HALF));
}

// Fall, slide, and pick up into `bag` what the player walks over. Returns how many items were picked up.
pub fn update(d: &Drops, w: &World, p: &Player, bag: &Bag, dt: f32): int {
    let picked = 0;
    let i = d.count - 1;
    while i >= 0 {
        d.age[i] += dt;
        d.vy[i] -= GRAVITY * dt;
        if d.vy[i] < -60 { d.vy[i] = -60; }
        let grounded = false;
        let ny = d.y[i] + d.vy[i] * dt;
        if blocked(w, d.x[i], ny, d.z[i]) { grounded = d.vy[i] < 0; d.vy[i] = 0; } else { d.y[i] = ny; }
        let nx = d.x[i] + d.vx[i] * dt;
        if blocked(w, nx, d.y[i], d.z[i]) { d.vx[i] = 0; } else { d.x[i] = nx; }
        let nz = d.z[i] + d.vz[i] * dt;
        if blocked(w, d.x[i], d.y[i], nz) { d.vz[i] = 0; } else { d.z[i] = nz; }
        if grounded {
            let keep = 1 - 10 * dt; if keep < 0 { keep = 0; }
            d.vx[i] *= keep; d.vz[i] *= keep;
        }
        let dx = d.x[i] - p.body.pos.x; let dy = d.y[i] - p.body.pos.y; let dz = d.z[i] - p.body.pos.z;
        if d.age[i] >= DELAY && dx * dx + dy * dy + dz * dz <= PICKUP * PICKUP {
            let moved = inventory.add(bag, d.id[i], d.n[i]);
            d.n[i] -= moved; picked += moved;
        }
        if d.n[i] <= 0 || d.age[i] > LIFE || d.y[i] < -10 { remove(d, i); }
        i -= 1;
    }
    return picked;
}

// The item's cube color: its icon colors, else the block it places, else a neutral tan.
fn color(id: u8): Vec3 {
    let def = defs.itemInfo(id);
    if def.top != 0 {
        return Vec3.xyz(f32(def.top / 65536) / 255, f32(def.top / 256 % 256) / 255, f32(def.top % 256) / 255);
    }
    if def.block != 0 { return defs.blockColor(def.block); }
    return Vec3.xyz(0.8, 0.7, 0.5);
}

// `cube` is the unit cube from `fx.cubes.makeCube`. Bobs and spins; camera pass only.
pub fn draw(d: &Drops, cube: Mesh, seconds: f32) {
    if d.count == 0 || !gfx.inCameraPass() { return; }
    let edge = HALF * 2 * world.VOXEL;
    for i in 0..d.count {
        let phase = f32(i) * 1.7;
        let lift = (0.25 + 0.1 * sin(seconds * 2.5 + phase)) * world.VOXEL;
        let m = Mat4.translate(d.x[i] * world.VOXEL, d.y[i] * world.VOXEL - HALF * world.VOXEL + lift, d.z[i] * world.VOXEL)
            .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), seconds * 1.6 + phase))
            .mul(Mat4.scale(edge, edge, edge))
            .mul(Mat4.translate(-0.5, -0.5, -0.5));
        d.instances[i] = Instance { model: m, tint: color(d.id[i]), emission: Vec3.xyz(0, 0, 0) };
    }
    gfx.drawInstances(cube, d.instances[0..d.count]);
}
