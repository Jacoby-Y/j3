// Running wire with the copper wire item: left click a post or electric machine, then a second
// one to connect them; left click a connected pair again to take the wire back.
module industry.wiring;

use industry.data.item;
use industry.inventory;
use industry.machine.power;
use industry.session.Game;
use industry.world;

const NOTE_SECONDS: f32 = 2.5;

fn say(g: &Game, message: string) { g.note = message; g.noteTime = NOTE_SECONDS; }

// A wire in hand needs a first end that still exists.
pub fn holding(g: &Game): bool {
    return inventory.slotItem(&g.carried, g.player.slot) == item.COPPER_WIRE;
}

// Forget a half-run wire when its machine is gone or the wire is put away.
pub fn tidy(g: &Game) {
    if g.wireFrom < 0 { return; }
    if !holding(g) || !power.isElectric(g.world.cells[g.wireFrom]) { g.wireFrom = -1; }
}

pub fn click(g: &Game) {
    if !g.hit.ok || !power.isElectric(g.looked) {
        if g.wireFrom >= 0 { g.wireFrom = -1; say(g, "WIRE CANCELED"); }
        else { say(g, "AIM AT A POST OR ELECTRIC MACHINE"); }
        return;
    }
    let at = world.anchorAt(&g.world, g.hit.x, g.hit.y, g.hit.z);
    if g.wireFrom < 0 { g.wireFrom = at; say(g, "NOW CLICK THE OTHER END"); return; }
    if at == g.wireFrom { g.wireFrom = -1; say(g, "WIRE CANCELED"); return; }
    let first = g.wireFrom;
    let existing = power.wireBetween(&g.world, world.slotOf(&g.world, first), world.slotOf(&g.world, at));
    if existing >= 0 {
        power.disconnect(&g.world, existing);
        inventory.add(&g.carried, item.COPPER_WIRE, 1);
        g.wireFrom = -1;
        say(g, "WIRE REMOVED");
        return;
    }
    let link = power.check(&g.world, first, at);
    if !link.ok { say(g, link.message); return; }
    if g.carried.counts[int(item.COPPER_WIRE)] <= 0 { say(g, "OUT OF WIRE"); return; }
    g.carried.counts[int(item.COPPER_WIRE)] -= 1;
    inventory.sync(&g.carried);
    power.connect(&g.world, first, at);
    // Posts chain: keep running wire from the post just reached.
    g.wireFrom = -1;
    if power.isPost(g.looked) { g.wireFrom = at; }
    say(g, "WIRED");
}
