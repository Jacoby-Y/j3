// Debug console commands: what exists, how a line runs, and what Tab can complete.
// A command is a row in the tables below; `run` is the only switch on which one.
module industry.commands;

use j3.text.Text;
use industry.chunks;
use industry.data.defs;
use industry.data.item;
use industry.inventory;
use industry.inventory.Bag;
use industry.world;
use industry.world.World;

const HELP: int = 0;
const ADD: int = 1;
const UNLOCK: int = 2;
const FX: int = 3;
const COUNT: int = 4;

fn name(i: int): string { let table: [4]string = ["help", "add", "unlock", "fx"]; return table[i]; }
fn usage(i: int): string { let table: [4]string = ["help", "add [item or coin] [amount]", "unlock chunk-ring", "fx [effect]"]; return table[i]; }
fn summary(i: int): string {
    let table: [4]string = ["list the commands", "give yourself items or coins", "unlock the next full ring of chunks", "burst a particle effect where you aim"];
    return table[i];
}

// What follows a command: 0 nothing, 1 coin or an item name, 2 the word chunk-ring, 3 an effect name.
fn argument(i: int): int { let table: [4]int = [0, 1, 2, 3]; return table[i]; }

// Completion context: 0 is the command word, otherwise the command index plus one.
pub fn context(line: string): int {
    let space = find(line, 32);
    if space < 0 { return 0; }
    for each in 0..COUNT { if equal(name(each), line[0..space]) { return each + 1; } }
    return -1;
}

// Where the word being completed starts.
pub fn wordStart(line: string): int {
    let space = find(line, 32);
    if space < 0 { return 0; }
    return space + 1;
}

fn optionCount(ctx: int): int {
    if ctx == 0 { return COUNT; }
    let kind = argument(ctx - 1);
    if kind == 1 { return item.kinds(); }
    if kind == 2 { return 1; }
    if kind == 3 { return defs.effectCount(); }
    return 0;
}

fn option(ctx: int, n: int): string {
    if ctx == 0 { return name(n); }
    let kind = argument(ctx - 1);
    if kind == 1 { if n == 0 { return "COIN"; } return item.name(u8(n)); }
    if kind == 3 { return defs.effectName(n); }
    return "CHUNK-RING";
}

// The nth completion of the word being typed, or "" when there are fewer. Typing a number ends the suggestions.
pub fn suggestion(line: string, n: int): string {
    let ctx = context(line);
    if ctx < 0 { return ""; }
    let word = line[wordStart(line)..line.len];
    for at in 0..word.len { if word[at] >= 48 && word[at] <= 57 { return ""; } }
    let seen = 0;
    for each in 0..optionCount(ctx) {
        let candidate = option(ctx, each);
        if candidate.len == 0 || !startsWith(candidate, word) { continue; }
        if seen == n { return candidate; }
        seen += 1;
    }
    return "";
}

fn find(text: string, byte: u8): int {
    for at in 0..text.len { if text[at] == byte { return at; } }
    return -1;
}

fn lower(byte: u8): u8 {
    if byte >= 65 && byte <= 90 { return byte + 32; }
    return byte;
}

fn startsWith(text: string, prefix: string): bool {
    if prefix.len > text.len { return false; }
    for at in 0..prefix.len { if lower(text[at]) != lower(prefix[at]) { return false; } }
    return true;
}

fn equal(a: string, b: string): bool { return a.len == b.len && startsWith(a, b); }

// Lowercase copy of a candidate onto the end of `out`, the way Tab writes it.
pub fn pushLower(out: &Text, s: string) { for at in 0..s.len { out.push(lower(s[at])); } }

fn isDigit(byte: u8): bool { return byte >= 48 && byte <= 57; }

// Runs one line and writes the reply to `out`, one line per '\n'. Returns the effect id an `fx`
// line asks the game to burst, else -1.
pub fn run(w: &World, bag: &Bag, line: string, out: &Text): int {
    let space = find(line, 32);
    let word = line; if space >= 0 { word = line[0..space]; }
    if word.len == 0 { return -1; }
    let command = -1;
    for each in 0..COUNT { if equal(name(each), word) { command = each; } }
    let rest = ""; if space >= 0 { rest = line[space + 1..line.len]; }
    if command == HELP { help(out); return -1; }
    if command == ADD { add(w, bag, rest, out); return -1; }
    if command == UNLOCK { unlock(w, rest, out); return -1; }
    if command == FX { return effect(rest, out); }
    out.pushStr("unknown command: ");
    out.pushStr(word);
    out.pushStr("\ntype help");
    return -1;
}

fn effect(rest: string, out: &Text): int {
    for id in 0..defs.effectCount() {
        if equal(rest, defs.effectName(id)) { out.pushStr("burst "); out.pushStr(rest); return id; }
    }
    out.pushStr("usage: "); out.pushStr(usage(FX));
    return -1;
}

fn help(out: &Text) {
    for each in 0..COUNT {
        out.pushStr(usage(each));
        out.pushStr(": ");
        out.pushStr(summary(each));
        if each + 1 < COUNT { out.push(10); }
    }
}

// "add raw copper 10": the name is everything before a trailing number, and the amount is 1 without one.
fn add(w: &World, bag: &Bag, rest: string, out: &Text) {
    let amount = 1;
    let name = rest;
    let split = rest.len;
    while split > 0 && isDigit(rest[split - 1]) { split -= 1; }
    if split < rest.len {
        amount = 0;
        for at in split..rest.len { amount = amount * 10 + int(rest[at] - 48); if amount > 1000000000 { amount = 1000000000; } }
        name = rest[0..split];
        if name.len > 0 && name[name.len - 1] == 32 { name = name[0..name.len - 1]; }
    }
    if name.len == 0 { out.pushStr("usage: "); out.pushStr(usage(ADD)); return; }
    if equal(name, "coin") {
        w.coins += amount;
        out.pushStr("added coins: "); out.pushInt(amount);
        return;
    }
    for id in 1..item.kinds() {
        if !equal(name, item.name(u8(id))) { continue; }
        let moved = inventory.add(bag, u8(id), amount);
        out.pushStr("added "); out.pushInt(moved); out.push(32); out.pushStr(item.name(u8(id)));
        if moved < amount { out.pushStr(" (bag full)"); }
        return;
    }
    out.pushStr("no item named ");
    out.pushStr(name);
}

fn unlock(w: &World, rest: string, out: &Text) {
    if !equal(rest, "chunk-ring") { out.pushStr("usage: "); out.pushStr(usage(UNLOCK)); return; }
    // The next ring is the nearest one that still has a locked chunk.
    let target = 0;
    for r in 1..world.CHUNKS {
        if target != 0 { break; }
        for cz in 0..world.CHUNKS {
            for cx in 0..world.CHUNKS {
                if world.ring(cx, cz) == r && w.unlocked[cx + cz * world.CHUNKS] == 0 { target = r; }
            }
        }
    }
    if target == 0 { out.pushStr("every chunk is unlocked"); return; }
    // The game loop opens the ring one chunk at a time (`chunks.tick`), so it never meshes in one stall.
    let locked = 0;
    for cz in 0..world.CHUNKS {
        for cx in 0..world.CHUNKS {
            if world.ring(cx, cz) == target && w.unlocked[cx + cz * world.CHUNKS] == 0 { locked += 1; }
        }
    }
    w.ringTarget = target; w.ringWait = 0;
    out.pushStr("unlocking ring "); out.pushInt(target);
    out.pushStr(": "); out.pushInt(locked); out.pushStr(" chunks, one at a time");
}
