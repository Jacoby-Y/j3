// Unlock generation and player bounds share the same active-cell predicate.
module industry.chunks;

use j3.math.Vec3;
use j3.game;
use industry.gen.terrain;
use industry.world;
use industry.world.World;

// A locked chunk can open when it is the first one or touches an open chunk.
fn allowed(w: &World, cx: int, cz: int): bool {
    if cx < 0 || cz < 0 || cx >= world.CHUNKS || cz >= world.CHUNKS { return false; }
    if w.unlocked[cx + cz * world.CHUNKS] != 0 { return false; }
    let any = false;
    for i in 0..w.unlocked.len { if w.unlocked[i] != 0 { any = true; } }
    return !any || world.active(w, cx * world.CHUNK - 1, cz * world.CHUNK) ||
        world.active(w, (cx + 1) * world.CHUNK, cz * world.CHUNK) ||
        world.active(w, cx * world.CHUNK, cz * world.CHUNK - 1) ||
        world.active(w, cx * world.CHUNK, (cz + 1) * world.CHUNK);
}

// Opens a chunk now, in one go: for startup, tests, and tools.
pub fn unlock(w: &World, cx: int, cz: int): bool {
    if w.genActive || !allowed(w, cx, cz) { return false; }
    w.unlocked[cx + cz * world.CHUNKS] = 1;
    terrain.generate(w, cx, cz);
    return true;
}

// Starts opening a chunk a slice per frame (`tick`); it unlocks when its last slice runs. One at a time.
pub fn begin(w: &World, cx: int, cz: int): bool {
    if w.genActive || !allowed(w, cx, cz) { return false; }
    terrain.start(w, cx, cz);
    return true;
}

// Per frame: runs the chunk being generated for up to GEN_BUDGET_US, then, while a ring is queued,
// starts its next chunk RING_GAP seconds after the last one.
const GEN_BUDGET_US: int = 3000;
const RING_GAP: f32 = 0.01;

pub fn tick(w: &World, dt: f32) {
    if w.genActive {
        let started = game.micros();
        while w.genActive && game.micros() - started < GEN_BUDGET_US { terrain.step(w); }
        return;
    }
    if w.ringTarget == 0 { return; }
    w.ringWait -= dt;
    if w.ringWait > 0 { return; }
    // A corner only touches the ring through its neighbors, so the first locked chunk allowed to open goes next.
    for cz in 0..world.CHUNKS {
        for cx in 0..world.CHUNKS {
            if world.ring(cx, cz) == w.ringTarget && begin(w, cx, cz) { w.ringWait = RING_GAP; return; }
        }
    }
    w.ringTarget = 0;
}

// Coins to unlock: grows with chunks already open, then scales up per ring away from the start.
const BASE_COST: int = 40;
const STEP_COST: int = 20;
const RING_PERCENT: int = 50;

pub fn cost(w: &World, cx: int, cz: int): int {
    let open = 0;
    for i in 0..w.unlocked.len { if w.unlocked[i] != 0 { open += 1; } }
    let ring = world.ring(cx, cz);
    if ring < 1 { ring = 1; }
    return (BASE_COST + STEP_COST * open) * (100 + RING_PERCENT * (ring - 1)) / 100;
}

// Unlock for coins; false when locked out or too poor.
pub fn buy(w: &World, cx: int, cz: int): bool {
    let price = cost(w, cx, cz);
    if w.coins < price { return false; }
    if !begin(w, cx, cz) { return false; }
    w.coins -= price;
    return true;
}

pub fn fits(w: &World, pos: Vec3, half: Vec3): bool {
    return world.active(w, int(pos.x - half.x), int(pos.z - half.z)) &&
        world.active(w, int(pos.x + half.x), int(pos.z - half.z)) &&
        world.active(w, int(pos.x - half.x), int(pos.z + half.z)) &&
        world.active(w, int(pos.x + half.x), int(pos.z + half.z)) &&
        pos.x - half.x >= 0 && pos.z - half.z >= 0;
}

// Nearest locked cardinal neighbor within two meters. -1 means no prompt.
pub fn nearby(w: &World, pos: Vec3): int {
    let cx = int(pos.x) / world.CHUNK;
    let cz = int(pos.z) / world.CHUNK;
    let best: f32 = 4;
    let target = -1;
    for dir in 0..4 {
        let nx = cx; let nz = cz;
        let distance = pos.x - f32(cx * world.CHUNK);
        if dir == 0 { nx -= 1; }
        if dir == 1 { nx += 1; distance = f32((cx + 1) * world.CHUNK) - pos.x; }
        if dir == 2 { nz -= 1; distance = pos.z - f32(cz * world.CHUNK); }
        if dir == 3 { nz += 1; distance = f32((cz + 1) * world.CHUNK) - pos.z; }
        if nx >= 0 && nz >= 0 && nx < world.CHUNKS && nz < world.CHUNKS &&
            w.unlocked[nx + nz * world.CHUNKS] == 0 && distance < best {
            target = nx + nz * world.CHUNKS;
            best = distance;
        }
    }
    return target;
}
