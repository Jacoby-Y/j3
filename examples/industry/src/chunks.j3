// Unlock generation and player bounds share the same active-cell predicate.
module industry.chunks;

use j3.math;
use j3.math.Vec3;
use industry.gen.elevation;
use industry.gen.terrain;
use industry.mesher;
use industry.world;
use industry.world.World;

// A locked chunk can open when it is the first one or touches an open chunk.
pub fn allowed(w: &World, cx: int, cz: int): bool {
    if cx < 0 || cz < 0 || cx >= world.CHUNKS || cz >= world.CHUNKS { return false; }
    if w.unlocked[cx + cz * world.CHUNKS] != 0 { return false; }
    let any = false;
    for i in 0..w.unlocked.len { if w.unlocked[i] != 0 { any = true; } }
    return !any || world.active(w, cx * world.CHUNK - 1, cz * world.CHUNK) ||
        world.active(w, (cx + 1) * world.CHUNK, cz * world.CHUNK) ||
        world.active(w, cx * world.CHUNK, cz * world.CHUNK - 1) ||
        world.active(w, cx * world.CHUNK, (cz + 1) * world.CHUNK);
}

// Opens a chunk now, in one go: for startup, tests, and tools.
pub fn unlock(w: &World, cx: int, cz: int): bool {
    if w.genActive || !allowed(w, cx, cz) { return false; }
    w.unlocked[cx + cz * world.CHUNKS] = 1;
    terrain.generate(w, cx, cz);
    return true;
}

// Starts opening a chunk on a worker thread (`tick` finishes it). One at a time.
pub fn begin(w: &World, cx: int, cz: int): bool {
    if w.genActive || !allowed(w, cx, cz) { return false; }
    w.genActive = true; w.genX = cx; w.genZ = cz;
    mesher.generate(w, cx, cz);
    return true;
}

// Per frame: finishes the chunk being generated once its worker is done, then, while a ring is queued,
// starts its next chunk RING_GAP seconds after the last one.
const RING_GAP: f32 = 0.01;

pub fn tick(w: &World, dt: f32) {
    if w.genActive {
        if !mesher.generated() { return; }
        terrain.finish(w, w.genX, w.genZ);
        w.genActive = false;
        return;
    }
    if w.ringTarget == 0 { return; }
    w.ringWait -= dt;
    if w.ringWait > 0 { return; }
    // A corner only touches the ring through its neighbors, so the first locked chunk allowed to open goes next.
    for cz in 0..world.CHUNKS {
        for cx in 0..world.CHUNKS {
            if world.ring(cx, cz) == w.ringTarget && begin(w, cx, cz) { w.ringWait = RING_GAP; return; }
        }
    }
    w.ringTarget = 0;
}

// Coins to unlock: grows with chunks already open, then scales up per ring away from the start.
const BASE_COST: int = 40;
const STEP_COST: int = 20;
const RING_PERCENT: int = 50;

pub fn cost(w: &World, cx: int, cz: int): int {
    let open = 0;
    for i in 0..w.unlocked.len { if w.unlocked[i] != 0 { open += 1; } }
    let ring = world.ring(cx, cz);
    if ring < 1 { ring = 1; }
    return (BASE_COST + STEP_COST * open) * (100 + RING_PERCENT * (ring - 1)) / 100;
}

// Unlock for coins; false when locked out or too poor.
pub fn buy(w: &World, cx: int, cz: int): bool {
    let price = cost(w, cx, cz);
    if w.coins < price { return false; }
    if !begin(w, cx, cz) { return false; }
    w.coins -= price;
    return true;
}

pub fn fits(w: &World, pos: Vec3, half: Vec3): bool {
    return world.active(w, int(pos.x - half.x), int(pos.z - half.z)) &&
        world.active(w, int(pos.x + half.x), int(pos.z - half.z)) &&
        world.active(w, int(pos.x - half.x), int(pos.z + half.z)) &&
        world.active(w, int(pos.x + half.x), int(pos.z + half.z)) &&
        pos.x - half.x >= 0 && pos.z - half.z >= 0;
}

// Nearest locked cardinal neighbor within two meters. -1 means no prompt.
pub fn nearby(w: &World, pos: Vec3): int {
    let cx = int(pos.x) / world.CHUNK;
    let cz = int(pos.z) / world.CHUNK;
    let best: f32 = 4;
    let target = -1;
    for dir in 0..4 {
        let nx = cx; let nz = cz;
        let distance = pos.x - f32(cx * world.CHUNK);
        if dir == 0 { nx -= 1; }
        if dir == 1 { nx += 1; distance = f32((cx + 1) * world.CHUNK) - pos.x; }
        if dir == 2 { nz -= 1; distance = pos.z - f32(cz * world.CHUNK); }
        if dir == 3 { nz += 1; distance = f32((cz + 1) * world.CHUNK) - pos.z; }
        if nx >= 0 && nz >= 0 && nx < world.CHUNKS && nz < world.CHUNKS &&
            w.unlocked[nx + nz * world.CHUNKS] == 0 && distance < best {
            target = nx + nz * world.CHUNKS;
            best = distance;
        }
    }
    return target;
}

// A lock sits on the middle of each wall of an open chunk that faces a chunk you could buy.
// Sides: 0 west, 1 east, 2 north, 3 south. Returns that chunk's index, or -1.
pub fn lockSide(w: &World, cx: int, cz: int, side: int): int {
    if w.unlocked[cx + cz * world.CHUNKS] == 0 { return -1; }
    let nx = cx; let nz = cz;
    if side == 0 { nx -= 1; }
    if side == 1 { nx += 1; }
    if side == 2 { nz -= 1; }
    if side == 3 { nz += 1; }
    if !allowed(w, nx, nz) { return -1; }
    return nx + nz * world.CHUNKS;
}

// Lock center on the ground plane, in cells.
pub fn lockX(cx: int, side: int): f32 {
    if side == 0 { return f32(cx * world.CHUNK); }
    if side == 1 { return f32((cx + 1) * world.CHUNK); }
    return f32(cx * world.CHUNK + world.CHUNK / 2);
}

pub fn lockZ(cz: int, side: int): f32 {
    if side == 2 { return f32(cz * world.CHUNK); }
    if side == 3 { return f32((cz + 1) * world.CHUNK); }
    return f32(cz * world.CHUNK + world.CHUNK / 2);
}

// Two voxels above the highest ground under the lock, so terrain never covers it.
pub fn lockY(w: &World, cx: int, cz: int, side: int): int {
    let x = int(lockX(cx, side)); let z = int(lockZ(cz, side));
    let top = 0;
    for dz in -1..2 { for dx in -1..2 { top = math.maxi(top, elevation.height(w.seed, x + dx, z + dz)); } }
    return top + 3;
}
const LOCK_REACH: f32 = 10;

// Slab test of the look ray against the lock box. Returns the chunk it would buy, or -1.
pub fn lockAt(w: &World, eye: Vec3, dir: Vec3): int {
    for cz in 0..world.CHUNKS { for cx in 0..world.CHUNKS {
        if w.unlocked[cx + cz * world.CHUNKS] == 0 { continue; }
        for side in 0..4 {
            let target = lockSide(w, cx, cz, side);
            if target < 0 { continue; }
            let hx: f32 = 1.2; let hz: f32 = 1.2; // ponytail: square box, wide enough for either wall
            let lo = Vec3.xyz(lockX(cx, side) - hx, f32(lockY(w, cx, cz, side)), lockZ(cz, side) - hz);
            let hi = Vec3.xyz(lockX(cx, side) + hx, f32(lockY(w, cx, cz, side) + 2), lockZ(cz, side) + hz);
            let t0: f32 = 0; let t1: f32 = LOCK_REACH;
            for axis in 0..3 {
                let o = eye.x; let d = dir.x; let a = lo.x; let b = hi.x;
                if axis == 1 { o = eye.y; d = dir.y; a = lo.y; b = hi.y; }
                if axis == 2 { o = eye.z; d = dir.z; a = lo.z; b = hi.z; }
                if d > -0.00001 && d < 0.00001 {
                    if o < a || o > b { t1 = -1; }
                } else {
                    let ta = (a - o) / d; let tb = (b - o) / d;
                    if ta > tb { let tmp = ta; ta = tb; tb = tmp; }
                    if ta > t0 { t0 = ta; }
                    if tb < t1 { t1 = tb; }
                }
            }
            if t0 <= t1 { return target; }
        }
    } }
    return -1;
}
