// First person walking, jumping, mouse look, and placement bounds.
module industry.player;

use j3.game;
use j3.game.Key;
use j3.game.physics.Body3;
use j3.gfx.Look;
use j3.gfx.voxel;
use j3.math.{ Vec3, cos, exp, sin };
use industry.chunks;
use industry.data.block;
use industry.data.item;
use industry.world;
use industry.world.World;

const JUMP_SPEED_M: f32 = 8.0;
const COYOTE: f32 = 0.12;
// How fast walking velocity eases to the wanted one (per second); higher is snappier.
const GROUND_EASE: f32 = 16;
const AIR_EASE: f32 = 6;

pub struct Player {
    body: Body3;
    yaw: f32;
    pitch: f32;
    slot: int;
    vx: f32 = 0;             // walking velocity, cells per second
    vz: f32 = 0;
    coyote: f32 = 0;         // seconds left to jump after leaving the ground
}

pub fn create(): Player {
    return Player {
        body: Body3.make(Vec3.xyz(f32(world.CENTER * world.CHUNK) + 24.5, f32(world.GROUND) + 2.75, f32(world.CENTER * world.CHUNK) + 24.5), Vec3.xyz(0, 0, 0),
            Vec3.xyz(0.6, 1.7, 0.6), 1),
        yaw: 0,
        pitch: -0.35,
        slot: 0,
    };
}

// Physics and ray casting use grid cells; the camera uses meters.
pub fn lookCells(p: &Player): Look {
    return Look.create(Vec3.xyz(p.body.pos.x, p.body.pos.y + 1.1, p.body.pos.z), p.yaw, p.pitch);
}

pub fn camera(p: &Player): Look {
    let eye = lookCells(p);
    return Look.create(eye.eye * world.VOXEL, eye.yaw, eye.pitch);
}

pub fn heldBlock(p: &Player): u8 {
    let id = item.hotbarItem(p.slot);
    if id == 0 || id == item.PICKAXE { return block.AIR; }
    return item.blockFor(id);
}

fn slotKey(i: int): Key {
    if i == 0 { return game.Key.Num1; }
    if i == 1 { return game.Key.Num2; }
    if i == 2 { return game.Key.Num3; }
    if i == 3 { return game.Key.Num4; }
    if i == 4 { return game.Key.Num5; }
    if i == 5 { return game.Key.Num6; }
    if i == 6 { return game.Key.Num7; }
    if i == 7 { return game.Key.Num8; }
    return game.Key.Num9;
}

// Keys 1-6 pick a slot; the wheel steps through them and wraps.
pub fn selectSlot(p: &Player) {
    let i = 0;
    while i < item.HOTBAR {
        if game.keyPressed(slotKey(i)) { p.slot = i; }
        i += 1;
    }
    let wheel = game.mouseWheel();
    if wheel > 0 { p.slot = (p.slot + item.HOTBAR - 1) % item.HOTBAR; }
    if wheel < 0 { p.slot = (p.slot + 1) % item.HOTBAR; }
}

pub fn canPlace(p: &Player, x: int, y: int, z: int): bool {
    let b = p.body;
    if b.pos.x + b.half.x <= f32(x) || b.pos.x - b.half.x >= f32(x + 1) { return true; }
    if b.pos.y + b.half.y <= f32(y) || b.pos.y - b.half.y >= f32(y + 1) { return true; }
    if b.pos.z + b.half.z <= f32(z) || b.pos.z - b.half.z >= f32(z + 1) { return true; }
    return false;
}

fn solidAt(p: &Player, w: &World, pos: Vec3): bool {
    let h = p.body.half;
    return voxel.overlaps(w.cells, world.SX, world.SY, world.SZ,
        Vec3.xyz(pos.x - h.x + 0.01, pos.y - h.y + 0.01, pos.z - h.z + 0.01),
        Vec3.xyz(pos.x + h.x - 0.01, pos.y + h.y - 0.01, pos.z + h.z - 0.01));
}

// One horizontal axis; on the ground, a one-voxel ledge is stepped onto instead of blocking.
fn moveAxis(p: &Player, w: &World, dx: f32, dz: f32, grounded: bool) {
    if !chunks.fits(w, p.body.pos + Vec3.xyz(dx, 0, dz), p.body.half) { return; }
    if grounded && solidAt(p, w, p.body.pos + Vec3.xyz(dx, 0, dz))
        && !solidAt(p, w, p.body.pos + Vec3.xyz(dx, 1.0, dz))
        && !solidAt(p, w, p.body.pos + Vec3.xyz(0, 1.0, 0)) {
        p.body.pos.y += 1.0;
    }
    p.body.tryAxis(w.cells, world.SX, world.SY, world.SZ, dx, 0, dz);
}

pub fn update(p: &Player, w: &World, dt: f32) {
    let d = game.mouseDelta();
    p.yaw += d.x * 0.003;
    p.pitch -= d.y * 0.003;
    if p.pitch > 1.5 { p.pitch = 1.5; }
    if p.pitch < -1.5 { p.pitch = -1.5; }
    let fwd: f32 = 0;
    let side: f32 = 0;
    if game.keyDown(game.Key.W) { fwd += 1; }
    if game.keyDown(game.Key.S) { fwd -= 1; }
    if game.keyDown(game.Key.D) { side += 1; }
    if game.keyDown(game.Key.A) { side -= 1; }
    let scale: f32 = 1;
    if fwd != 0 && side != 0 { scale = 0.7071; }
    let speed: f32 = 5 / world.VOXEL;
    if game.keyDown(game.Key.Shift) { speed = 8 / world.VOXEL; }
    let tx = (sin(p.yaw) * fwd + cos(p.yaw) * side) * speed * scale;
    let tz = (-cos(p.yaw) * fwd + sin(p.yaw) * side) * speed * scale;
    let grounded = voxel.overlaps(w.cells, world.SX, world.SY, world.SZ,
        Vec3.xyz(p.body.pos.x - 0.59, p.body.pos.y - 1.76, p.body.pos.z - 0.59),
        Vec3.xyz(p.body.pos.x + 0.59, p.body.pos.y - 1.70, p.body.pos.z + 0.59));
    // Ease toward the wanted velocity: a short ramp up and slide out, snappy on the ground.
    let rate = AIR_EASE; if grounded { rate = GROUND_EASE; }
    let k = 1 - exp(-dt * rate);
    p.vx += (tx - p.vx) * k;
    p.vz += (tz - p.vz) * k;
    let before = p.body.pos;
    moveAxis(p, w, p.vx * dt, 0, grounded);
    if p.body.pos.x == before.x && p.vx != 0 { p.vx = 0; }
    moveAxis(p, w, 0, p.vz * dt, grounded);
    if p.body.pos.z == before.z && p.vz != 0 { p.vz = 0; }
    if grounded { p.coyote = COYOTE; } else { p.coyote -= dt; }
    if p.coyote > 0 && game.keyDown(game.Key.Space) {
        p.body.vel.y = JUMP_SPEED_M / world.VOXEL;
        p.coyote = 0;
    }
    p.body.stepGrid(dt, Vec3.xyz(0, -18 / world.VOXEL, 0),
        w.cells, world.SX, world.SY, world.SZ);
}
