// Coordinate-derived randomness keeps generation independent of unlock order.
module industry.gen.random;
use j3.rand.Rng;

pub fn at(seed: int, x: int, y: int, z: int, salt: int): Rng {
    return Rng.new(seed + x * 73856093 + y * 19349663 + z * 83492791 + salt * 2654435761);
}

pub fn value(seed: int, x: int, z: int, salt: int): f32 {
    let rng = at(seed, x, 0, z, salt);
    return rng.unit();
}
