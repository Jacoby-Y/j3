// Survey pad and persistent surface resource nodes follow the ground height.
module industry.gen.structures;
use industry.data.block;
use industry.data.defs;
use j3.math.Mat4;
use industry.gen.elevation;
use industry.world;
use industry.world.World;

pub fn spawnPad(w: &World) {
    for z in world.CENTER * world.CHUNK + 21..world.CENTER * world.CHUNK + 28 {
        for x in world.CENTER * world.CHUNK + 21..world.CENTER * world.CHUNK + 28 {
            world.set(w, x, world.GROUND, z, block.FOUNDATION);
        }
    }
}

// One 2 x 2 x 2 surface node per ore in every chunk, at that ore's column offset.
pub fn nodes(w: &World, cx: int, cz: int) {
    for ore in 0..defs.oreCount() {
        let def = defs.oreInfo(ore);
        if world.ring(cx, cz) < def.minRing { continue; }
        let x = elevation.nodeX(w.seed, cx, cz, ore);
        let z = elevation.nodeZ(w.seed, cx, cz, ore);
        let base = elevation.nodeY(w.seed, cx, cz, ore);
        w.nodeModels[(cx + cz * world.CHUNKS) * defs.oreCount() + ore] = Mat4.translate(f32(x + 1) * world.VOXEL, f32(base) * world.VOXEL, f32(z + 1) * world.VOXEL)
            .mul(Mat4.scale(world.VOXEL, world.VOXEL, world.VOXEL));
        for dz in 0..2 { for dx in 0..2 {
            // Fill the small footing if even model alignment raises the base.
            for y in elevation.height(w.seed, x + dx, z + dz) + 1..base {
                world.set(w, x + dx, y, z + dz, block.DIRT);
            }
            for y in base..base + 2 { world.set(w, x + dx, y, z + dz, def.node); }
        } }
    }
}
