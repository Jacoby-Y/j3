module industry.gen.elevation;
use j3.math;
use industry.data.defs;
use industry.gen.random;
use industry.world;

pub fn ring(cx: int, cz: int): int {
    return math.maxi(math.absi(cx - world.CENTER), math.absi(cz - world.CENTER));
}

fn smooth(t: f32): f32 { return t * t * (3 - 2 * t); }

fn noise(seed: int, x: int, z: int, step: int, salt: int): f32 {
    let gx = x / step; let gz = z / step;
    let tx = smooth(f32(x % step) / f32(step));
    let tz = smooth(f32(z % step) / f32(step));
    let a = math.lerp(random.value(seed, gx, gz, salt), random.value(seed, gx + 1, gz, salt), tx);
    let b = math.lerp(random.value(seed, gx, gz + 1, salt), random.value(seed, gx + 1, gz + 1, salt), tx);
    return math.lerp(a, b, tz);
}

// Broad rolling hills with finer bumps on top, stretched so valleys and peaks both show.
fn hills(seed: int, x: int, z: int): f32 {
    let f = 0.65 * noise(seed, x, z, 64, 1) + 0.25 * noise(seed, x, z, 32, 2) + 0.1 * noise(seed, x, z, 16, 3);
    return math.clamp((f - 0.5) * 1.2 + 0.5, 0, 1);
}

pub fn height(seed: int, x: int, z: int): int {
    // Distance from the flat square, measured continuously in chunk widths.
    let low = (world.CENTER - 1) * world.CHUNK;
    let high = (world.CENTER + 2) * world.CHUNK - 1;
    let distance = math.maxi(math.maxi(low - x, x - high), math.maxi(low - z, z - high));
    if distance <= 0 { return world.GROUND; }
    let t = f32(distance) / f32(world.CHUNK);
    let cap: f32 = 3 * math.clamp(t, 0, 1);
    if t > 1 { cap = 3 + 3 * math.clamp(t - 1, 0, 1); }
    if t > 2 { cap = 6 + 9 * math.clamp(t - 2, 0, 1); }
    return world.GROUND + int(cap * hills(seed, x, z) + 0.5);
}

// Outside the start chunk, each ore's node exists in only some chunks (`OreDef.chance` percent).
pub fn hasNode(seed: int, cx: int, cz: int, ore: int): bool {
    if ring(cx, cz) == 0 { return true; }
    let rng = random.at(seed, cx, ore, cz, 9);
    let def = defs.oreInfo(ore);
    return rng.intRange(0, 100) < def.chance;
}

// Surface nodes sit near their ore's column and row; they drift so no two chunks match.
pub fn nodeX(seed: int, cx: int, cz: int, ore: int): int {
    let def = defs.oreInfo(ore);
    let x = cx * world.CHUNK + def.offset;
    let rng = random.at(seed, cx, ore, cz, 7);
    // Start chunk: copper hugs the west side, coal the east.
    if ring(cx, cz) == 0 && ore < 2 { return cx * world.CHUNK + 8 + ore * 28 + rng.intRange(0, 5) / 2 * 2; }
    return (x + rng.intRange(-2, 3)) / 2 * 2;
}

pub fn nodeZ(seed: int, cx: int, cz: int, ore: int): int {
    let rng = random.at(seed, cx, ore, cz, 8);
    // Start chunk: free along the whole side; the nodes sit far from the survey pad in x.
    if ring(cx, cz) == 0 && ore < 2 { return cz * world.CHUNK + 8 + rng.intRange(0, 30) / 2 * 2; }
    let top = 7;
    return cz * world.CHUNK + 18 + rng.intRange(-6, top) / 2 * 2;
}

// Surface nodes stay aligned to their two-cell model footprint.
pub fn nodeY(seed: int, cx: int, cz: int, ore: int): int {
    let x = nodeX(seed, cx, cz, ore);
    let z = nodeZ(seed, cx, cz, ore);
    let h = 0;
    for dz in 0..2 { for dx in 0..2 { h = math.maxi(h, height(seed, x + dx, z + dz)); } }
    return (h + 2) / 2 * 2;
}
