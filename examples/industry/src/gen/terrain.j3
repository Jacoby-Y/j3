// Global height field, followed by caves, finite veins, and surface structures.
// A chunk is generated in small steps (`step`) so an unlock can spread over frames; `generate` runs them all.
module industry.gen.terrain;
use j3.gfx.voxel;
use industry.data.block;
use industry.gen.elevation;
use industry.gen.caves;
use industry.gen.veins;
use industry.gen.structures;
use industry.world;
use industry.world.World;

const FILL: int = 0;
const PREPARE: int = 1;
const LATTICE: int = 2;
const CARVE: int = 3;
const SHAFT: int = 4;
const VEINS: int = 5;
const NODES: int = 6;
const DONE: int = 7;

pub fn start(w: &World, cx: int, cz: int) {
    w.genActive = true; w.genX = cx; w.genZ = cz; w.genStage = FILL; w.genStep = 0;
}

fn next(w: &World) { w.genStage += 1; w.genStep = 0; }

fn fillRow(w: &World, cx: int, cz: int, dz: int) {
    let z = cz * world.CHUNK + dz;
    for x in cx * world.CHUNK..(cx + 1) * world.CHUNK {
        let h = elevation.height(w.seed, x, z);
        for y in 0..h + 1 {
            let id: u8 = block.STONE;
            if y == h { id = block.GRASS; }
            else if y >= h - 2 { id = block.DIRT; }
            w.cells[voxel.index(x, y, z, world.SX, world.SZ)] = id;
        }
    }
}

// One small unit of the chunk being generated; true once the chunk is finished (then `genActive` is false).
pub fn step(w: &World): bool {
    let cx = w.genX; let cz = w.genZ; let stage = w.genStage;
    if stage == FILL {
        fillRow(w, cx, cz, w.genStep); w.genStep += 1;
        if w.genStep == world.CHUNK { next(w); }
    } else if stage == PREPARE {
        caves.prepare(w, cx, cz); next(w);
    } else if stage == LATTICE {
        caves.fill(w, cx, cz, w.genStep); w.genStep += 1;
        if w.genStep == w.caveNy { next(w); }
    } else if stage == CARVE {
        caves.row(w, cx, cz, w.genStep); w.genStep += 1;
        if w.genStep == world.CHUNK { next(w); }
    } else if stage == SHAFT {
        caves.shaftIfAny(w, cx, cz); next(w);
    } else if stage == VEINS {
        veins.generate(w, cx, cz); next(w);
    } else if stage == NODES {
        // Nodes and the pad go through `world.set`, which only edits unlocked chunks.
        w.unlocked[cx + cz * world.CHUNKS] = 1;
        structures.nodes(w, cx, cz);
        if cx == world.CENTER && cz == world.CENTER { structures.spawnPad(w); }
        next(w);
    } else {
        // Includes shared faces and corner AO, without rebuilding entire neighboring chunks.
        world.dirtyGeneratedChunk(w, cx, cz);
        w.genActive = false;
        return true;
    }
    return false;
}

pub fn generate(w: &World, cx: int, cz: int) {
    start(w, cx, cz);
    while !step(w) { }
}
