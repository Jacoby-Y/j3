// Seeded 3D gradient noise for terrain carving: a pure function of (seed, x, y, z), so every chunk
// that samples a point agrees on it. No bitwise ops in J3, so the hash is wrapping multiplies and divides.
module industry.gen.noise3;
use j3.math;

// Lattice hash: mixes the corner and seed, then keeps the high bits (low bits of a multiplicative hash are weak).
fn hash(seed: int, x: int, y: int, z: int): int {
    let h = x * 73856093 + y * 19349663 + z * 83492791 + seed * 2654435761;
    h = h * 6364136223846793005 + 1442695040888963407;
    h = (h / 4294967296) * 2862933555777941757 + 3037000493;
    return math.absi(h / 1024);
}

fn fade(t: f32): f32 { return t * t * t * (t * (t * 6 - 15) + 10); }

// Dot of the offset (dx, dy, dz) with a pseudo-random gradient (each component in [-1, 1]) chosen by the corner.
fn corner(seed: int, ix: int, iy: int, iz: int, dx: f32, dy: f32, dz: f32): f32 {
    let h = hash(seed, ix, iy, iz);
    let gx = f32(h % 2001) * 0.001 - 1;
    let gy = f32(h / 2001 % 2001) * 0.001 - 1;
    let gz = f32(h / 4004001 % 2001) * 0.001 - 1;
    return gx * dx + gy * dy + gz * dz;
}

// Gradient noise at a point, roughly in [-1, 1] with most values within +-0.6.
pub fn sample(seed: int, x: f32, y: f32, z: f32): f32 {
    let fx = math.floor(x); let fy = math.floor(y); let fz = math.floor(z);
    let ix = int(fx); let iy = int(fy); let iz = int(fz);
    let tx = x - fx; let ty = y - fy; let tz = z - fz;
    let u = fade(tx); let v = fade(ty); let t = fade(tz);
    let a = math.lerp(corner(seed, ix, iy, iz, tx, ty, tz), corner(seed, ix + 1, iy, iz, tx - 1, ty, tz), u);
    let b = math.lerp(corner(seed, ix, iy + 1, iz, tx, ty - 1, tz), corner(seed, ix + 1, iy + 1, iz, tx - 1, ty - 1, tz), u);
    let c = math.lerp(corner(seed, ix, iy, iz + 1, tx, ty, tz - 1), corner(seed, ix + 1, iy, iz + 1, tx - 1, ty, tz - 1), u);
    let d = math.lerp(corner(seed, ix, iy + 1, iz + 1, tx, ty - 1, tz - 1), corner(seed, ix + 1, iy + 1, iz + 1, tx - 1, ty - 1, tz - 1), u);
    return math.lerp(math.lerp(a, b, v), math.lerp(c, d, v), t) * 1.15;
}

// Two octaves: the base shape plus finer detail at twice the frequency and `gain` the weight.
pub fn fbm2(seed: int, x: f32, y: f32, z: f32, gain: f32): f32 {
    let base = sample(seed, x, y, z);
    let fine = sample(seed + 1, x * 2, y * 2, z * 2);
    return (base + fine * gain) / (1 + gain);
}
