// Small finite copper/coal veins; every constituent is one ordinary voxel cube.
module industry.gen.veins;
use j3.gfx.voxel;
use industry.data.block;
use industry.data.defs;
use industry.gen.random;
use industry.world;
use industry.world.World;

fn clear(w: &World, x: int, y: int, z: int): bool {
    if world.get(w, x, y, z) != block.STONE { return false; }
    // Keep separate veins from merging, including across chunk edges.
    for dz in -1..2 { for dy in -1..2 { for dx in -1..2 {
        if block.isVein(world.get(w, x + dx, y + dy, z + dz)) { return false; }
    } } }
    return true;
}

pub fn generate(w: &World, cx: int, cz: int) {
    let rng = random.at(w.seed, cx, 0, cz, 5);
    for vein in 0..48 {
        let count = rng.intRange(1, 4); let axis = rng.intRange(0, 3);
        let kind = defs.oreInfo(vein % defs.oreCount()); let id = kind.vein;
        if world.ring(cx, cz) < kind.minRing { continue; }
        for attempt in 0..128 {
            let x = cx * world.CHUNK + rng.intRange(2, world.CHUNK - 4);
            let y = rng.intRange(4, world.GROUND - 5);
            let z = cz * world.CHUNK + rng.intRange(2, world.CHUNK - 4);
            let ok = true;
            for part in 0..count {
                let px = x; let py = y; let pz = z;
                if axis == 0 { px += part; }
                if axis == 1 { py += part; }
                if axis == 2 { pz += part; }
                if !clear(w, px, py, pz) { ok = false; }
            }
            if !ok { continue; }
            for part in 0..count {
                let vx = x; let vy = y; let vz = z;
                if axis == 0 { vx += part; }
                if axis == 1 { vy += part; }
                if axis == 2 { vz += part; }
                w.cells[voxel.index(vx, vy, vz, world.SX, world.SZ)] = id;
            }
            break;
        }
    }
}

pub fn yieldAt(seed: int, x: int, y: int, z: int): int {
    let rng = random.at(seed, x, y, z, 6);
    return rng.intRange(1, 7);
}
