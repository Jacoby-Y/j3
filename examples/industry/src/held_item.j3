// Draw the held tool in camera space after the world, so nearby walls cannot clip it.
module industry.held_item;
use j3.gfx;
use j3.gfx.Mesh;
use j3.gfx.Look;
use j3.math.{ Mat4, Vec3, Vec2, sin };

// Place the grip in screen pixels, using the current projection and viewport.
pub fn transform(eye: Look, swing: f32, projection: Mat4, extent: Vec2): Mat4 {
    let arc = sin(swing * 3.1415927);
    let depth: f32 = 1.05;
    let height = extent.y * 0.42;
    if height > 380 { height = 380; }
    let scale = height * depth / (extent.y * projection.m[5]);
    let right = 144 + arc * 80;
    let bottom = 16 + arc * 36;
    let x = (1 - 2 * right / extent.x) * depth / projection.m[0];
    let y = (-1 + 2 * bottom / extent.y) * depth / projection.m[5];
    return eye.view().affineInverse()
        .mul(Mat4.translate(x, y, -depth))
        .mul(Mat4.rotate(Vec3.xyz(0, 0, 1), -0.38 - arc * 0.8))
        .mul(Mat4.rotate(Vec3.xyz(0, 1, 0), 0.3))
        .mul(Mat4.rotate(Vec3.xyz(1, 0, 0), -arc * 0.65))
        .mul(Mat4.scale(scale, scale, scale))
        .mul(Mat4.translate(-0.7, -0.3, 0));
}

pub fn update(swing: f32, mining: bool, dt: f32): f32 {
    if swing == 0 && !mining { return 0; }
    let next = swing + dt * 2.5;
    if next >= 1 {
        if !mining { return 0; }
        next -= f32(int(next));
    }
    return next;
}

pub fn draw(mesh: Mesh, eye: Look, swing: f32) {
    gfx.clearDepth();
    let view = gfx.viewState();
    gfx.draw(mesh, transform(eye, swing, view.proj, gfx.viewExtent()));
}
