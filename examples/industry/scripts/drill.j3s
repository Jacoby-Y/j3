// Tunable drill rules: one item every `period` seconds from the ore in front, held until the
// belt behind has room. The machine tables and connection rules live in `industry.machine`.
props { period: f32 = 4.0; electricSpeed: f32 = 2.0; }

use industry.data.block;
use industry.machine.belts;
use industry.machine.drills;
use industry.world;
use industry.world.World;

// Mined items wait in the drill until the rear belt, facing any way, has room.
fn drain(w: &World, at: int, slot: int) {
    if w.drills[slot].count == 0 { return; }
    if !belts.insertFrom(w, drills.rear(w, at), w.drills[slot].item, (w.facing[at] + 2) % 4) { return; }
    w.drills[slot].count -= 1;
    if w.drills[slot].count == 0 { w.drills[slot].item = 0; }
}

pub fn update(w: &World, dt: f32) {
    for slot in 1..w.slotHigh + 1 {
        if !drills.isDrill(w.slotKind[slot]) { continue; }
        // The electric drill mines faster, at the share of power its network supplies.
        let speed: f32 = 1;
        if w.slotKind[slot] == block.ELECTRIC_DRILL { speed = electricSpeed * w.powered[slot]; }
        let at = world.slotAnchor(w, slot);
        let ore = drills.ore(w, world.anchorX(at), world.anchorY(at), world.anchorZ(at), w.facing[at]);
        if ore == 0 { w.drills[slot].clock = 0; }
        if ore != 0 && w.drills[slot].count < drills.CAPACITY && (w.drills[slot].count == 0 || w.drills[slot].item == ore) {
            w.drills[slot].clock += dt * speed;
            if w.drills[slot].clock >= period {
                w.drills[slot].clock = 0;
                w.drills[slot].count += 1;
                w.drills[slot].item = ore;
            }
        }
        drain(w, at, slot);
    }
}
