// Tunable power rules: each network adds up what its lit generators supply and what its working
// machines ask for, and everything on it runs at the supplied share. Generators burn coal only
// while their network wants power. Wires and networks live in `industry.machine.power`.
props { generatorWatts: f32 = 100.0; burnSeconds: f32 = 20.0; drillWatts: f32 = 30.0; smelterWatts: f32 = 50.0; }

use industry.data.block;
use industry.machine.power;
use industry.world;
use industry.world.World;

pub fn update(w: &World, dt: f32) {
    power.rebuild(w);
    for slot in 1..w.slotHigh + 1 { w.netSupply[slot] = 0; w.netDemand[slot] = 0; }
    for slot in 1..w.slotHigh + 1 {
        if !power.wantsPower(w, slot) { continue; }
        let watts = drillWatts;
        if w.slotKind[slot] == block.ELECTRIC_SMELTER { watts = smelterWatts; }
        w.netDemand[w.powerRoot[slot]] += watts;
    }
    for slot in 1..w.slotHigh + 1 {
        if w.slotKind[slot] != block.GENERATOR { continue; }
        let root = w.powerRoot[slot];
        if w.netDemand[root] <= 0 { continue; }
        if w.gens[slot].burn <= 0 && w.gens[slot].fuel > 0 {
            w.gens[slot].fuel -= 1;
            w.gens[slot].burn = burnSeconds;
        }
        if w.gens[slot].burn > 0 {
            w.netSupply[root] += generatorWatts;
            w.gens[slot].burn -= dt;
            if w.gens[slot].burn < 0 { w.gens[slot].burn = 0; }
        }
    }
    for slot in 1..w.slotHigh + 1 {
        let net = w.powerRoot[slot];
        w.powered[slot] = 0;
        if w.netDemand[net] > 0 {
            w.powered[slot] = w.netSupply[net] / w.netDemand[net];
            if w.powered[slot] > 1 { w.powered[slot] = 1; }
        }
    }
}
