// Tunable furnace rules: each ore needs a lit coal, and one coal burns five smelts. A blocked
// output holds the finished batch. Machine tables and ports live in `industry.machine`.
props { period: f32 = 2.0; electricSpeed: f32 = 2.0; }

use industry.data.block;
use industry.data.item;
use industry.machine.belts;
use industry.machine.furnace;
use industry.world;
use industry.world.World;

pub fn update(w: &World, dt: f32) {
    for slot in 1..w.slotHigh + 1 {
        if !furnace.isSmelter(w.slotKind[slot]) { continue; }
        let at = world.slotAnchor(w, slot);
        furnace.start(w, at);
        if w.kilns[slot].item == 0 { continue; }
        let speed: f32 = 1;
        if w.slotKind[slot] == block.ELECTRIC_SMELTER { speed = electricSpeed * w.powered[slot]; }
        w.kilns[slot].clock += dt * speed;
        if w.kilns[slot].clock > period { w.kilns[slot].clock = period; }
        if w.kilns[slot].clock < period { continue; }
        if belts.insertFrom(w, furnace.outlet(w, at), item.ingotFor(w.kilns[slot].item), w.facing[at]) {
            w.kilns[slot].item = 0;
            w.kilns[slot].clock = 0;
        }
    }
}
