module raytrace.world;

use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx.Orbit;
use j3.math.{ Vec2, Vec3, clamp };
use j3.memory.Arena;
use j3.ui.Ui;
use j3.gfx.urp.raytrace;
use j3.gfx.urp.raytrace.{ AreaLight, Material, Quality, Scene, Sphere };

pub struct World {
    spheres: []Sphere;
    lights: []AreaLight;
    room: Vec3;
    camera: Orbit;
    quality: Quality;
    font: Font;
    showHud: bool;
    dragging: bool;
    lastMouse: Vec2;
}

pub fn boot(mem: &Arena): World {
    let spheres = mem.alloc::<Sphere>(3);
    spheres[0] = Sphere {
        center: Vec3.xyz(-1.55, 1.05, -0.6), radius: 1.05,
        material: Material.glass(Vec3.xyz(0.97, 0.99, 1), 1.5),
    };
    spheres[1] = Sphere {
        center: Vec3.xyz(0, 1.05, -0.7), radius: 1.05,
        material: Material.metal(Vec3.xyz(0.92, 0.87, 0.78), 0.08),
    };
    spheres[2] = Sphere {
        center: Vec3.xyz(1.55, 1.05, -0.6), radius: 1.05,
        material: Material.plastic(Vec3.xyz(0.3, 0.39, 0.57), 0.82),
    };
    let lights = mem.alloc::<AreaLight>(1);
    lights[0] = AreaLight {
        center: Vec3.xyz(0, 4, -0.7), halfSize: 0.65,
        color: Vec3.xyz(1, 1, 1), brightness: 3.5,
    };
    return World {
        spheres: spheres, lights: lights, room: Vec3.xyz(4.4, 4, 4.2),
        camera: Orbit.create(Vec3.xyz(0, 1.35, -0.7), 0, 0.12, 8.0),
        quality: Quality.medium(), font: Font { raw: 0 },
        showHud: true, dragging: false, lastMouse: Vec2 { x: 0, y: 0 },
    };
}

pub fn startup(w: &World) {
    raytrace.init();
    w.font = game.loadFont("assets/font.ttf", 17);
}

pub fn input(w: &World, dt: f32) {
    if game.keyPressed(Key.Escape) { game.requestQuit(); }
    if game.keyPressed(Key.H) { w.showHud = !w.showHud; }
    let mouse = game.mousePos();
    let overHud = w.showHud && mouse.x < 360;
    if game.mousePressed(Mouse.Left) && !overHud {
        w.dragging = true;
        w.lastMouse = mouse;
    }
    if game.mouseReleased(Mouse.Left) { w.dragging = false; }
    if w.dragging {
        let delta = mouse - w.lastMouse;
        w.camera.orbit(delta.x * 0.006, 0 - delta.y * 0.006);
        w.camera.yaw = clamp(w.camera.yaw, -0.6, 0.6);
        w.camera.pitch = clamp(w.camera.pitch, -0.1, 0.25);
        w.lastMouse = mouse;
    }
    if !overHud {
        w.camera.zoom(game.mouseWheel() * 0.7, 6.5, 10);
    }
}

fn controls(w: &World) {
    let ui = Ui.begin(w.font, 12, 12);
    ui.panel(334, 570);
    ui.labelBold("J3 URP raytracing");
    ui.label("H hide | drag orbit | wheel zoom");
    ui.scroll(1, 480);
    ui.labelBold("Quality");
    if ui.button("Low") { w.quality = Quality.low(); }
    if ui.button("Medium") { w.quality = Quality.medium(); }
    if ui.button("High") { w.quality = Quality.high(); }
    ui.slider("Render scale", &w.quality.scale, 0.25, 1);
    ui.stepper("Ray bounces", &w.quality.bounces, 1, 6);
    ui.stepper("Light samples", &w.quality.lightSamples, 1, 8);
    ui.stepper("AA samples", &w.quality.aaSamples, 1, 4);
    ui.rule();
    ui.labelBold("Glass");
    ui.slider("Radius", &w.spheres[0].radius, 0.4, 1.35);
    ui.slider("Refraction index", &w.spheres[0].material.ior, 1.01, 2.2);
    ui.slider("Tint R", &w.spheres[0].material.color.x, 0.1, 1);
    ui.slider("Tint G", &w.spheres[0].material.color.y, 0.1, 1);
    ui.slider("Tint B", &w.spheres[0].material.color.z, 0.1, 1);
    ui.rule();
    ui.labelBold("Metal");
    ui.slider("Radius", &w.spheres[1].radius, 0.4, 1.35);
    ui.slider("Roughness", &w.spheres[1].material.roughness, 0, 0.8);
    ui.slider("Tint R", &w.spheres[1].material.color.x, 0, 1);
    ui.slider("Tint G", &w.spheres[1].material.color.y, 0, 1);
    ui.slider("Tint B", &w.spheres[1].material.color.z, 0, 1);
    ui.rule();
    ui.labelBold("Dull plastic");
    ui.slider("Radius", &w.spheres[2].radius, 0.4, 1.35);
    ui.slider("Roughness", &w.spheres[2].material.roughness, 0, 1);
    ui.slider("Color R", &w.spheres[2].material.color.x, 0, 1);
    ui.slider("Color G", &w.spheres[2].material.color.y, 0, 1);
    ui.slider("Color B", &w.spheres[2].material.color.z, 0, 1);
    ui.rule();
    ui.labelBold("Ceiling light");
    ui.slider("Brightness", &w.lights[0].brightness, 0, 12);
    ui.slider("Size", &w.lights[0].halfSize, 0.15, 1.5);
    ui.slider("Red", &w.lights[0].color.x, 0, 1);
    ui.slider("Green", &w.lights[0].color.y, 0, 1);
    ui.slider("Blue", &w.lights[0].color.z, 0, 1);
    ui.end();
    ui.end();
}

pub fn draw(w: &World) {
    let scene = Scene { room: w.room, spheres: w.spheres, lights: w.lights };
    raytrace.render(&scene, w.camera, w.quality);
    if w.showHud { controls(w); }
}
