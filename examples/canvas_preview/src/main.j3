/// Preview exported assets and a texture generated in memory. Escape closes.
module canvas_preview;

use j3.gfx.canvas;
use j3.gfx.canvas.{
    Canvas, Mode
};
use j3.game.{
    Key, clearTo, destroy, destroyTexture, drawTextureAt, init, keyDown, loadTexture, poll, present, quitRequested, requestQuit, rgb, textureFromCanvas, updateTextureFromCanvas
};
use j3.math.Vec2;
use j3.memory.Arena;

fn main() {
    init("Procedural canvas", 640, 360);
    let arena = Arena.create(256000);
    let lamp = loadTexture("../canvas/lantern.png");
    let stone = loadTexture("../canvas/stone.png");

    let swatch = Canvas.create(&arena, 16, 16, Mode.Pixel);
    swatch.clear(canvas.rgb(30, 48, 65));
    let generated = textureFromCanvas(swatch);
    swatch.fillRect(4, 4, 8, 8, canvas.rgb(255, 196, 94));
    updateTextureFromCanvas(generated, swatch, 4, 4, 8, 8);

    while !quitRequested() {
        poll();
        if keyDown(Key.Escape) {
            requestQuit();
        }
        clearTo(rgb(18, 25, 36));
        drawTextureAt(lamp, Vec2 {
            x : 48, y : 36
        }
        , Vec2 {
            x : 288, y : 288
        }
        );
        drawTextureAt(stone, Vec2 {
            x : 365, y : 84
        }
        , Vec2 {
            x : 192, y : 192
        }
        );
        drawTextureAt(generated, Vec2 {
            x : 561, y : 84
        }
        , Vec2 {
            x : 64, y : 64
        }
        );
        present();
    }
    destroyTexture(lamp);
    destroyTexture(stone);
    destroyTexture(generated);
    destroy();
    arena.destroy();
}
