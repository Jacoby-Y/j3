// Orbit a voxel island. LMB drag looks around, wheel zooms, R resets, Esc quits.

module island;

use island.world.{ World, boot, draw, input, startup };
use j3.app.App;

fn main() {
    let app = App<World>.create("island", 960, 540, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
