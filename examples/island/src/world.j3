module island.world;

use j3.anim.{ Key, Track };
use j3.game;
use j3.gfx;
use j3.gfx.{
    FACE_NX, FACE_NY, FACE_NZ, FACE_PX, FACE_PY, FACE_PZ, Mesh, Orbit,
};
use j3.math.{ Mat4, Quat, TAU, Vec2, Vec3, clamp, cos, floor, lerp, sin };
use j3.memory.Arena;
use j3.sys.panic;

pub const SX: int = 24;
pub const SY: int = 16;
pub const SZ: int = 24;

const AIR: u8 = 0;
const GRASS: u8 = 1;
const DIRT: u8 = 2;
const STONE: u8 = 3;
const WOOD: u8 = 4;
const LEAF: u8 = 5;
const PLANK: u8 = 6;
const ROOF: u8 = 7;
const FLOWER: u8 = 8;
const GLOW: u8 = 9;

const DAY: f32 = 90;

const START_YAW: f32 = 0.85;
const START_PITCH: f32 = 0.42;
const START_DIST: f32 = 26;
const YAW_SPEED: f32 = 0.16;
const DRAG: f32 = 0.008;
const ZOOM: f32 = 1.6;

pub struct World {
    cells: []u8;
    mesh: Mesh;
    prop: Mesh;
    cam: Orbit;
    drag: bool;
    last: Vec2;
    time: f32;
}

fn idx(x: int, y: int, z: int): int {
    return x + SX * (z + SZ * y);
}

fn set(cells: []u8, x: int, y: int, z: int, id: u8) {
    if x < 0 || y < 0 || z < 0 {
        return;
    }
    if x >= SX || y >= SY || z >= SZ {
        return;
    }
    cells[idx(x, y, z)] = id;
}

fn get(cells: []u8, x: int, y: int, z: int): u8 {
    if x < 0 || y < 0 || z < 0 {
        return AIR;
    }
    if x >= SX || y >= SY || z >= SZ {
        return AIR;
    }
    return cells[idx(x, y, z)];
}

fn fill(cells: []u8, x0: int, y0: int, z0: int, x1: int, y1: int, z1: int, id: u8) {
    let y = y0;
    while y <= y1 {
        let z = z0;
        while z <= z1 {
            let x = x0;
            while x <= x1 {
                set(cells, x, y, z, id);
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
}

fn carve(cells: []u8, x: int, y: int, z: int) {
    set(cells, x, y, z, AIR);
}

fn buildIsland(cells: []u8) {
    let z = 0;
    while z < SZ {
        let x = 0;
        while x < SX {
            let dx = x - 12;
            let dz = z - 12;
            let d = dx * dx + dz * dz;
            if d <= 64 {
                set(cells, x, 5, z, GRASS);
                set(cells, x, 4, z, DIRT);
                set(cells, x, 3, z, DIRT);
            }
            if d <= 36 {
                set(cells, x, 2, z, STONE);
            }
            if d <= 16 {
                set(cells, x, 1, z, STONE);
            }
            if d <= 4 {
                set(cells, x, 0, z, STONE);
            }
            if d > 49 && d <= 64 && (x + z) - ((x + z) / 2) * 2 != 0 {
                set(cells, x, 5, z, AIR);
                set(cells, x, 4, z, AIR);
            }
            x += 1;
        }
        z += 1;
    }
}

fn buildTree(cells: []u8) {
    let tx = 16;
    let tz = 8;
    set(cells, tx, 6, tz, WOOD);
    set(cells, tx, 7, tz, WOOD);
    set(cells, tx, 8, tz, WOOD);
    set(cells, tx, 9, tz, WOOD);
    let y = 8;
    while y <= 11 {
        let z = tz - 2;
        while z <= tz + 2 {
            let x = tx - 2;
            while x <= tx + 2 {
                let dx = x - tx;
                let dz = z - tz;
                let dy = y - 10;
                if dx * dx + dz * dz + dy * dy <= 8 {
                    if !(x == tx && z == tz && y <= 9) {
                        set(cells, x, y, z, LEAF);
                    }
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    set(cells, tx + 3, 6, tz + 1, LEAF);
    set(cells, tx - 2, 6, tz + 3, LEAF);
    set(cells, 14, 6, 11, FLOWER);
    set(cells, 13, 6, 10, FLOWER);
    set(cells, 11, 6, 9, FLOWER);
    set(cells, 18, 6, 11, FLOWER);
    set(cells, 10, 6, 12, FLOWER);
}

fn buildHouse(cells: []u8) {
    let x0 = 6;
    let z0 = 13;
    let x1 = 10;
    let z1 = 17;
    fill(cells, x0, 6, z0, x1, 9, z1, PLANK);
    fill(cells, x0 + 1, 6, z0 + 1, x1 - 1, 8, z1 - 1, AIR);
    carve(cells, 8, 6, z1);
    carve(cells, 8, 7, z1);
    set(cells, x0, 8, 15, GLOW);
    set(cells, x1, 8, 15, GLOW);
    set(cells, 8, 8, z0, GLOW);
    let rx = x0;
    while rx <= x1 {
        let rz = z0;
        while rz <= z1 {
            set(cells, rx, 10, rz, ROOF);
            rz += 1;
        }
        rx += 1;
    }
    let ridge = z0 + 1;
    while ridge <= z1 - 1 {
        set(cells, 7, 11, ridge, ROOF);
        set(cells, 8, 11, ridge, ROOF);
        set(cells, 9, 11, ridge, ROOF);
        ridge += 1;
    }
    set(cells, 8, 12, 15, ROOF);
}

fn buildPath(cells: []u8) {
    set(cells, 8, 5, 18, DIRT);
    set(cells, 9, 5, 17, DIRT);
    set(cells, 10, 5, 16, DIRT);
    set(cells, 11, 5, 15, DIRT);
    set(cells, 12, 5, 14, DIRT);
    set(cells, 13, 5, 13, DIRT);
    set(cells, 14, 5, 12, DIRT);
    set(cells, 15, 5, 11, DIRT);
    set(cells, 15, 5, 10, DIRT);
}

fn build(cells: []u8) {
    buildIsland(cells);
    buildPath(cells);
    buildTree(cells);
    buildHouse(cells);
}

fn resetCam(w: &World) {
    w.cam = Orbit.create(Vec3.xyz(0, 5, 0), START_YAW, START_PITCH, START_DIST);
}

pub fn boot(mem: &Arena): World {
    let cells = mem.alloc::<u8>(SX * SY * SZ);
    let i = 0;
    while i < cells.len {
        cells[i] = AIR;
        i += 1;
    }
    build(cells);
    return World {
        cells: cells,
        mesh: Mesh { vao: 0, vbo: 0, count: 0 },
        prop: Mesh { vao: 0, vbo: 0, count: 0 },
        cam: Orbit.create(Vec3.xyz(0, 5, 0), START_YAW, START_PITCH, START_DIST),
        drag: false,
        last: Vec2 { x: 0, y: 0 },
        time: DAY * 0.04,
    };
}

pub fn input(w: &World, dt: f32) {
    w.time += dt;
    if game.keyPressed(game.Key.Escape) {
        game.requestQuit();
    }
    if game.keyPressed(game.Key.R) {
        resetCam(w);
    }
    let wheel = game.mouseWheel();
    if wheel != 0 {
        w.cam.zoom(wheel * ZOOM, 8, 56);
    }
    let pos = game.mousePos();
    if game.mousePressed(game.Mouse.Left) {
        w.drag = true;
        w.last = pos;
    }
    if game.mouseReleased(game.Mouse.Left) {
        w.drag = false;
    }
    if w.drag {
        let dx = pos.x - w.last.x;
        let dy = pos.y - w.last.y;
        w.cam.orbit(f32(0) - dx * DRAG, dy * DRAG);
        w.last = pos;
    } else {
        w.cam.yaw += YAW_SPEED * dt;
    }
}

fn open(cells: []u8, x: int, y: int, z: int): bool {
    return get(cells, x, y, z) == AIR;
}

fn tint(id: u8): Vec3 {
    if id == GRASS {
        return Vec3.xyz(0.34, 0.58, 0.3);
    }
    if id == DIRT {
        return Vec3.xyz(0.46, 0.34, 0.24);
    }
    if id == STONE {
        return Vec3.xyz(0.54, 0.54, 0.56);
    }
    if id == WOOD {
        return Vec3.xyz(0.42, 0.3, 0.2);
    }
    if id == LEAF {
        return Vec3.xyz(0.22, 0.5, 0.26);
    }
    if id == PLANK {
        return Vec3.xyz(0.7, 0.58, 0.44);
    }
    if id == FLOWER {
        return Vec3.xyz(0.88, 0.72, 0.3);
    }
    if id == GLOW {
        return Vec3.xyz(1, 0.86, 0.55);
    }
    return Vec3.xyz(0.62, 0.28, 0.26);
}

fn elevOf(time: f32): f32 {
    return sin(time / DAY * TAU);
}

fn mix3(a: Vec3, b: Vec3, t: f32): Vec3 {
    return Vec3.xyz(lerp(a.x, b.x, t), lerp(a.y, b.y, t), lerp(a.z, b.z, t));
}

fn lightDir(time: f32): Vec3 {
    let ang = time / DAY * TAU;
    let y = sin(ang);
    let across = cos(ang);
    if y < 0 {
        return Vec3.xyz(f32(0) - across * 0.35, f32(0) - y, f32(0) - across * 0.15).normalize();
    }
    return Vec3.xyz(across * 0.85, y, across * 0.28).normalize();
}

fn skyAt(elev: f32): Vec3 {
    let noon = Vec3.xyz(0.55, 0.72, 0.88);
    let warm = Vec3.xyz(0.95, 0.46, 0.26);
    let night = Vec3.xyz(0.035, 0.04, 0.055);
    if elev >= 0 {
        return mix3(warm, noon, elev * elev);
    }
    return mix3(warm, night, clamp((f32(0) - elev) * 2, 0, 1));
}

fn sunAt(elev: f32): Vec3 {
    let noon = Vec3.xyz(1, 0.98, 0.94);
    let warm = Vec3.xyz(1, 0.45, 0.16);
    let night = Vec3.xyz(0.07, 0.08, 0.1);
    if elev >= 0 {
        return mix3(warm, noon, elev * elev);
    }
    return mix3(warm, night, clamp((f32(0) - elev) * 2, 0, 1));
}

fn emit(out: []f32, at: int, x: int, y: int, z: int, dir: int, id: u8): int {
    let c = tint(id);
    let emi: f32 = 0;
    if id == GLOW {
        emi = 1;
    }
    return gfx.emitFace(out, at, f32(x - 12), f32(y), f32(z - 12), dir, c.x, c.y, c.z, emi);
}

fn facesOf(cells: []u8, x: int, y: int, z: int): int {
    let n = 0;
    if open(cells, x - 1, y, z) {
        n += 1;
    }
    if open(cells, x + 1, y, z) {
        n += 1;
    }
    if open(cells, x, y - 1, z) {
        n += 1;
    }
    if open(cells, x, y + 1, z) {
        n += 1;
    }
    if open(cells, x, y, z - 1) {
        n += 1;
    }
    if open(cells, x, y, z + 1) {
        n += 1;
    }
    return n;
}

fn countFaces(w: &World): int {
    let n = 0;
    let y = 0;
    while y < SY {
        let z = 0;
        while z < SZ {
            let x = 0;
            while x < SX {
                if w.cells[idx(x, y, z)] != AIR {
                    n += facesOf(w.cells, x, y, z);
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return n;
}

fn bake(w: &World, out: []f32): int {
    let at = 0;
    let y = 0;
    while y < SY {
        let z = 0;
        while z < SZ {
            let x = 0;
            while x < SX {
                let id = w.cells[idx(x, y, z)];
                if id != AIR {
                    if open(w.cells, x - 1, y, z) {
                        at = emit(out, at, x, y, z, FACE_NX, id);
                    }
                    if open(w.cells, x + 1, y, z) {
                        at = emit(out, at, x, y, z, FACE_PX, id);
                    }
                    if open(w.cells, x, y - 1, z) {
                        at = emit(out, at, x, y, z, FACE_NY, id);
                    }
                    if open(w.cells, x, y + 1, z) {
                        at = emit(out, at, x, y, z, FACE_PY, id);
                    }
                    if open(w.cells, x, y, z - 1) {
                        at = emit(out, at, x, y, z, FACE_NZ, id);
                    }
                    if open(w.cells, x, y, z + 1) {
                        at = emit(out, at, x, y, z, FACE_PZ, id);
                    }
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return at;
}

pub fn startup(w: &World) {
    gfx.init();
    let n = countFaces(w) * 60;
    if n < 60 {
        panic("island mesh");
    }
    let scratch = Arena.create(n * 4 + 64);
    let verts = scratch.alloc::<f32>(n);
    let used = bake(w, verts);
    w.mesh = gfx.upload([]f32 { ptr: verts.ptr, len: used });
    scratch.destroy();
    let boxn = 360;
    let boxmem = Arena.create(boxn * 4 + 64);
    let boxv = boxmem.alloc::<f32>(boxn);
    let usedb = bakeLantern(boxv);
    w.prop = gfx.upload([]f32 { ptr: boxv.ptr, len: usedb });
    boxmem.destroy();
}

fn bakeLantern(out: []f32): int {
    let x: f32 = f32(0) - 0.5;
    let at = 0;
    at = gfx.emitFace(out, at, x, x, x, FACE_NX, 1, 0.86, 0.55, 1);
    at = gfx.emitFace(out, at, x, x, x, FACE_PX, 1, 0.86, 0.55, 1);
    at = gfx.emitFace(out, at, x, x, x, FACE_NY, 1, 0.72, 0.35, 1);
    at = gfx.emitFace(out, at, x, x, x, FACE_PY, 1, 0.95, 0.7, 1);
    at = gfx.emitFace(out, at, x, x, x, FACE_NZ, 1, 0.86, 0.55, 1);
    at = gfx.emitFace(out, at, x, x, x, FACE_PZ, 1, 0.86, 0.55, 1);
    return at;
}

fn propAt(time: f32): Mat4 {
    let y0 = f32(7);
    let y1 = f32(7) + 0.35;
    let scale = Vec3.xyz(0.55, 0.55, 0.55);
    let keys: [2]Key = [
        Key.at(0, Vec3.xyz(9, y0, f32(0) - 6), Quat.identity(), scale),
        Key.at(1, Vec3.xyz(9, y1, f32(0) - 6), Quat.fromAxisAngle(Vec3.up(), 0.7), scale),
    ];
    let track = Track { keys: []Key { ptr: &keys[0], len: 2 } };
    let u = time - floor(time);
    return track.sample(u);
}

pub fn draw(w: &World) {
    let elev = elevOf(w.time);
    let sun = lightDir(w.time);
    let sky = skyAt(elev);
    let prop = propAt(w.time);
    gfx.shadowPass(sun, Vec3.xyz(-14, -2, -14), Vec3.xyz(14, 16, 14));
    gfx.draw(w.mesh, Mat4.identity());
    gfx.draw(w.prop, prop);
    gfx.cameraPass(w.cam, sun, sky, sunAt(elev));
    gfx.light(0, Vec3.xyz(9, 8, f32(0) - 6), Vec3.xyz(1, 0.75, 0.4), 8);
    gfx.drawAlpha(w.mesh, Mat4.identity(), 1);
    let mats: [1]Mat4 = [prop];
    gfx.drawInstanced(w.prop, []Mat4 { ptr: &mats[0], len: 1 });
    gfx.drawLine(Vec3.xyz(9, 7, f32(0) - 6), Vec3.xyz(9, 9, f32(0) - 6), Vec3.xyz(1, 0.9, 0.6));
}
