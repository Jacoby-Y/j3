module forest.world;

use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx;
use j3.gfx.{ Mesh, Orbit, Tex };
use j3.io;
use j3.math.{ Mat4, Vec2, Vec3, clamp };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.ui.Ui;
use j3.gfx.urp.forest;

pub struct World {
    mem: &Arena;
    camera: Orbit;
    ground: Mesh;
    branches: Mesh;
    trunk: Mesh;
    leaves: Mesh;
    groundTex: Tex;
    branchTex: Tex;
    trunkTex: Tex;
    leavesTex: Tex;
    environment: Tex;
    trees: []Mat4;
    font: Font;
    glass: Vec3;
    metal: Vec3;
    radius: f32;
    ior: f32;
    roughness: f32;
    shaftStrength: f32;
    exposure: f32;
    sunHeight: f32;
    time: f32;
    hud: bool;
    dragging: bool;
    lastMouse: Vec2;
}

fn emptyMesh(): Mesh { return Mesh { vao: 0, vbo: 0, count: 0 }; }
fn emptyTex(): Tex { return Tex { id: 0, w: 0, h: 0 }; }

fn tree(x: f32, z: f32, angle: f32, size: f32): Mat4 {
    return Mat4.translate(x, 0, z)
        .mul(Mat4.rotate(Vec3.up(), angle))
        .mul(Mat4.scale(size, size, size));
}

pub fn boot(mem: &Arena): World {
    let trees = mem.alloc::<Mat4>(16);
    trees[0] = tree(-4.0, -2.0, 0.8, 1.20);
    trees[1] = tree(3.4, -2.8, 2.1, 1.25);
    trees[2] = tree(-5.8, 1.9, 4.1, 1.35);
    trees[3] = tree(5.5, 1.8, 0.4, 1.3);
    trees[4] = tree(-1.7, -6.0, 1.5, 1.10);
    trees[5] = tree(1.2, -7.5, 3.5, 1.2);
    trees[6] = tree(-7.3, -5.2, 2.6, 1.42);
    trees[7] = tree(7.5, -5.7, 5.3, 1.38);
    trees[8] = tree(-4.8, 5.4, 0.9, 1.34);
    trees[9] = tree(5.3, 5.1, 3.4, 1.32);
    trees[10] = tree(-3.1, 8.3, 5.2, 1.18);
    trees[11] = tree(3.2, 9.3, 0.5, 1.35);
    trees[12] = tree(-7.6, 0.1, 1.7, 1.14);
    trees[13] = tree(7.5, -0.7, 2.8, 1.15);
    trees[14] = tree(-0.2, -10.0, 4.4, 1.4);
    trees[15] = tree(0.0, 11.5, 2.2, 1.25);
    return World {
        mem: mem,
        camera: Orbit.create(Vec3.xyz(0, 1.45, -0.2), 0.14, 0.12, 8.7),
        ground: emptyMesh(), branches: emptyMesh(), trunk: emptyMesh(), leaves: emptyMesh(),
        groundTex: emptyTex(), branchTex: emptyTex(), trunkTex: emptyTex(),
        leavesTex: emptyTex(), environment: emptyTex(), trees: trees,
        font: Font { raw: 0 },
        glass: Vec3.xyz(-0.95, 1.30, 0.0),
        metal: Vec3.xyz(0.95, 1.30, 0.0),
        radius: 0.70, ior: 1.51, roughness: 0.08,
        shaftStrength: 2.05, exposure: 0.72, sunHeight: 0.48,
        time: 0, hud: true, dragging: false,
        lastMouse: Vec2 { x: 0, y: 0 },
    };
}

fn loadMesh(path: string, arena: &Arena): Mesh {
    match io.readFile(path, arena) {
        Result.Ok(bytes) {
            if bytes.len < 48 || bytes.len - (bytes.len / 48) * 48 != 0 {
                panic(path);
            }
            return gfx.uploadUv([]f32 { ptr: bytes.ptr as &f32, len: bytes.len / 4 });
        }
        Result.Err(_) { panic(path); }
    }
    return emptyMesh();
}

fn loadTex(path: string, arena: &Arena): Tex {
    let rgba = game.loadRgba(path, arena);
    if rgba.pixels.len == 0 { panic(path); }
    return gfx.tex(rgba.pixels, rgba.w, rgba.h);
}

fn groundVertex(v: []f32, i: int, x: f32, z: f32, u: f32, t: f32) {
    let at = i * 12;
    v[at] = x; v[at + 1] = -0.035; v[at + 2] = z;
    v[at + 3] = 0; v[at + 4] = 1; v[at + 5] = 0;
    v[at + 6] = 0.76; v[at + 7] = 0.68; v[at + 8] = 0.57;
    v[at + 9] = 0; v[at + 10] = u; v[at + 11] = t;
}

fn makeGround(mem: &Arena): Mesh {
    let v = mem.alloc::<f32>(72);
    groundVertex(v, 0, -30, -30, 0, 0);
    groundVertex(v, 1, -30, 30, 0, 20);
    groundVertex(v, 2, 30, -30, 20, 0);
    groundVertex(v, 3, 30, -30, 20, 0);
    groundVertex(v, 4, -30, 30, 0, 20);
    groundVertex(v, 5, 30, 30, 20, 20);
    return gfx.uploadUv(v);
}

pub fn startup(w: &World) {
    gfx.init();
    gfx.setFog(24, 64);
    w.ground = makeGround(w.mem);
    w.branches = loadMesh("assets/branch.bin", w.mem);
    w.trunk = loadMesh("assets/trunk.bin", w.mem);
    w.leaves = loadMesh("assets/leaves.bin", w.mem);
    w.groundTex = loadTex("assets/ground.png", w.mem);
    w.branchTex = loadTex("assets/branch.png", w.mem);
    w.trunkTex = loadTex("assets/trunk.png", w.mem);
    w.leavesTex = loadTex("assets/leaves.png", w.mem);
    w.environment = loadTex("assets/autumn_forest.jpg", w.mem);
    match io.readFile("assets/forest.frag", w.mem) {
        Result.Ok(bytes) { forest.init(bytes as string); }
        Result.Err(_) { panic("assets/forest.frag"); }
    }
    w.font = game.loadFont("../dungeon/assets/font.ttf", 16);
}

pub fn input(w: &World, dt: f32) {
    if game.keyPressed(Key.Escape) { game.requestQuit(); }
    if game.keyPressed(Key.H) { w.hud = !w.hud; }
    w.time += dt;
    let mouse = game.mousePos();
    let overHud = w.hud && mouse.x < 330;
    if game.mousePressed(Mouse.Left) && !overHud {
        w.dragging = true; w.lastMouse = mouse;
    }
    if game.mouseReleased(Mouse.Left) { w.dragging = false; }
    if w.dragging {
        let delta = mouse - w.lastMouse;
        w.camera.orbit(delta.x * 0.006, 0 - delta.y * 0.006);
        w.camera.pitch = clamp(w.camera.pitch, -0.03, 0.55);
        w.lastMouse = mouse;
    }
    if !overHud { w.camera.zoom(game.mouseWheel() * 0.55, 5.2, 14); }
}

fn drawTrees(w: &World) {
    let i = 0;
    while i < w.trees.len {
        gfx.albedo(w.trunkTex); gfx.drawDoubleSided(w.trunk, w.trees[i]);
        gfx.albedo(w.branchTex); gfx.drawDoubleSided(w.branches, w.trees[i]);
        gfx.albedo(w.leavesTex); gfx.drawCutout(w.leaves, w.trees[i]);
        i += 1;
    }
}

fn controls(w: &World) {
    let ui = Ui.begin(w.font, 12, 12);
    ui.panel(300, 490);
    ui.labelBold("Autumn forest / URP");
    ui.label("H hide | drag orbit | wheel zoom");
    ui.label("Real mesh canopy + shadowed haze");
    ui.rule();
    ui.labelBold("Afternoon light");
    ui.slider("Sun height", &w.sunHeight, 0.18, 1.2);
    ui.slider("Godrays", &w.shaftStrength, 0, 3.5);
    ui.slider("Exposure", &w.exposure, 0.5, 1.8);
    ui.rule();
    ui.labelBold("Glass sphere");
    ui.slider("Refraction index", &w.ior, 1.01, 2.1);
    ui.slider("Sphere radius", &w.radius, 0.4, 1.05);
    ui.rule();
    ui.labelBold("Metal sphere");
    ui.slider("Roughness", &w.roughness, 0, 0.65);
    ui.end();
}

pub fn draw(w: &World) {
    let sun = Vec3.xyz(-0.62, w.sunHeight, 0.44).normalize();
    gfx.shadowPass(sun, Vec3.xyz(-12, -1, -12), Vec3.xyz(12, 8, 12));
    gfx.albedo(w.groundTex); gfx.draw(w.ground, Mat4.identity());
    drawTrees(w);

    forest.begin();
    gfx.cameraPass(w.camera, sun, Vec3.xyz(0.16, 0.14, 0.12), Vec3.xyz(0.79, 0.46, 0.25));
    gfx.albedo(w.groundTex); gfx.draw(w.ground, Mat4.identity());
    drawTrees(w);
    forest.present(w.camera, sun, w.glass, w.metal, w.radius, w.ior,
        w.roughness, w.shaftStrength, w.exposure, w.time, w.environment);
    if w.hud { controls(w); }
}
