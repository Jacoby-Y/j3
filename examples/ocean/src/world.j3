module ocean.world;

use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx.Orbit;
use j3.io;
use j3.math.{ Vec2, Vec3, clamp };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.ui.Ui;
use j3.gfx.urp.raytrace;
use j3.gfx.urp.raytrace.{ AreaLight, Material, Ocean, Quality, Scene, Sphere };

pub struct World {
    mem: &Arena;
    spheres: []Sphere;
    lights: []AreaLight;
    camera: Orbit;
    ocean: Ocean;
    quality: Quality;
    font: Font;
    showHud: bool;
    paused: bool;
    dragging: bool;
    lastMouse: Vec2;
}

pub fn boot(mem: &Arena): World {
    let spheres = mem.alloc::<Sphere>(2);
    spheres[0] = Sphere {
        center: Vec3.xyz(-1.12, 1.35, -0.2), radius: 0.73,
        material: Material.glass(Vec3.xyz(0.92, 0.98, 1), 1.5),
    };
    spheres[1] = Sphere {
        center: Vec3.xyz(1.05, 1.42, -0.6), radius: 0.77,
        material: Material.metal(Vec3.xyz(0.94, 0.78, 0.56), 0.08),
    };
    return World {
        mem: mem, spheres: spheres, lights: mem.alloc::<AreaLight>(0),
        camera: Orbit.create(Vec3.xyz(0, 0.72, -0.5), 0, 0.22, 7.2),
        ocean: Ocean {
            time: 0, wind: 1.0, swell: 1.0, choppiness: 0.7,
            sunHeight: 0.48, waterColor: Vec3.xyz(0.025, 0.24, 0.32),
        },
        quality: Quality { scale: 0.7, bounces: 5, lightSamples: 1, aaSamples: 1 },
        font: Font { raw: 0 }, showHud: true, paused: false,
        dragging: false, lastMouse: Vec2 { x: 0, y: 0 },
    };
}

pub fn startup(w: &World) {
    raytrace.init();
    match io.readFile("assets/ocean.frag", w.mem) {
        Result.Ok(bytes) { raytrace.initOcean(bytes as string); }
        Result.Err(_) { panic("Cannot read assets/ocean.frag"); }
    }
    w.font = game.loadFont("../dungeon/assets/font.ttf", 16);
}

pub fn input(w: &World, dt: f32) {
    if game.keyPressed(Key.Escape) { game.requestQuit(); }
    if game.keyPressed(Key.H) { w.showHud = !w.showHud; }
    if game.keyPressed(Key.Space) { w.paused = !w.paused; }
    if !w.paused { w.ocean.time += dt; }
    let mouse = game.mousePos();
    let overHud = w.showHud && mouse.x < 340;
    if game.mousePressed(Mouse.Left) && !overHud {
        w.dragging = true;
        w.lastMouse = mouse;
    }
    if game.mouseReleased(Mouse.Left) { w.dragging = false; }
    if w.dragging {
        let delta = mouse - w.lastMouse;
        w.camera.orbit(delta.x*0.006, 0-delta.y*0.006);
        w.camera.pitch = clamp(w.camera.pitch, -0.10, 0.55);
        w.lastMouse = mouse;
    }
    if !overHud { w.camera.zoom(game.mouseWheel()*0.65, 5, 13); }
}

fn controls(w: &World) {
    let ui = Ui.begin(w.font, 12, 12);
    ui.panel(316, 570);
    ui.labelBold("Ocean / glass / metal");
    ui.label("H hide | drag orbit | wheel zoom");
    ui.label("Space pauses the waves");
    ui.scroll(1, 470);
    ui.labelBold("Wave spectrum");
    ui.slider("Swell", &w.ocean.swell, 0.25, 1.8);
    ui.slider("Wind", &w.ocean.wind, 0.2, 1.8);
    ui.slider("Crest sharpness", &w.ocean.choppiness, 0, 1.4);
    ui.slider("Sun height", &w.ocean.sunHeight, 0.08, 1.3);
    ui.rule();
    ui.labelBold("Sea color");
    ui.slider("Red", &w.ocean.waterColor.x, 0, 0.25);
    ui.slider("Green", &w.ocean.waterColor.y, 0.04, 0.5);
    ui.slider("Blue", &w.ocean.waterColor.z, 0.08, 0.65);
    ui.rule();
    ui.labelBold("Glass sphere");
    ui.slider("Refraction index", &w.spheres[0].material.ior, 1.01, 2.2);
    ui.slider("Radius", &w.spheres[0].radius, 0.35, 1.0);
    ui.slider("Tint red", &w.spheres[0].material.color.x, 0.4, 1);
    ui.rule();
    ui.labelBold("Metal sphere");
    ui.slider("Roughness", &w.spheres[1].material.roughness, 0, 0.6);
    ui.slider("Radius", &w.spheres[1].radius, 0.35, 1.0);
    ui.rule();
    ui.labelBold("Rendering");
    ui.slider("Resolution", &w.quality.scale, 0.35, 1);
    ui.stepper("Ray bounces", &w.quality.bounces, 2, 6);
    ui.stepper("AA samples", &w.quality.aaSamples, 1, 4);
    ui.end();
    ui.end();
}

pub fn draw(w: &World) {
    let scene = Scene {
        room: Vec3.xyz(0, 0, 0), spheres: w.spheres, lights: w.lights,
    };
    raytrace.renderOcean(&scene, w.camera, w.quality, w.ocean);
    if w.showHud { controls(w); }
}
