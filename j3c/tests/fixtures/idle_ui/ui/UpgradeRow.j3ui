<!-- Only the style block of a small idle game's UpgradeRow component: css_test and dom_test assert against it. -->

<style>
    .row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0.75rem;
        background: var(--raised);
        border-radius: var(--radius);
    }
    .label { flex: 1; }
    .value { color: var(--good); min-width: 48px; text-align: right; }
    button { min-width: 90px; color: var(--gold); }
</style>
