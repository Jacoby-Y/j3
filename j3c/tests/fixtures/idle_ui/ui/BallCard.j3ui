<!-- Only the style block of a small idle game's BallCard component: css_test and dom_test assert against it. -->

<style>
    .card {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        padding: 0.75rem;
        background: var(--raised);
        border-radius: var(--radius);
        border: 1px solid transparent;
        transition: border-color 150ms;
    }
    .card:hover { border-color: var(--accent); }
    .card.locked { opacity: 0.7; }
    .top { display: flex; justify-content: space-between; }
    .name { font-weight: bold; }
    .owned { color: var(--muted); }
    .stats { display: flex; gap: 0.75rem; font-size: 0.8125rem; color: var(--muted); }
    button { margin-top: 4px; }
    .price { color: var(--gold); }
</style>
