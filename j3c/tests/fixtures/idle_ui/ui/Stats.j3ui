<!-- Only the style block of a small idle game's Stats component: css_test and dom_test assert against it. -->

<style>
    dl {
        display: grid;
        grid-template-columns: 1fr auto;
        row-gap: 0.625rem;
        padding: 1rem;
        background: var(--raised);
        border-radius: var(--radius);
    }
    dt { color: var(--muted); }
    dd { text-align: right; font-weight: bold; }
    .gold { color: var(--gold); }
    .crystal { color: var(--crystal); }
</style>
