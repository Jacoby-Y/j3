<!-- Only the style block of a small idle game's Game component: css_test and dom_test assert against it. -->

<style>
    .app { display: flex; height: 100%; background: var(--bg); font-size: 0.9375rem; }
    /* min-width: 0 so content can't push the halves off 50/50. */
    .field { flex: 1; min-width: 0; position: relative; }
    .half { flex: 1; min-width: 0; }

    .hud {
        position: absolute;
        left: 0.75rem;
        bottom: 0.75rem;
        display: flex;
        gap: 0.75rem;
        padding: 0.375rem 0.75rem;
        background: rgba(17, 17, 27, 0.7);
        border-radius: var(--radius);
        font-size: 0.8125rem;
        color: var(--muted);
    }
    .level { color: var(--text); font-weight: bold; }

    .paused {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: rgba(17, 17, 27, 0.6);
    }
</style>
