<!-- Only the style block of a small idle game's Prestige component: css_test and dom_test assert against it. -->

<style>
    .box {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.25rem;
        background: var(--raised);
        border-radius: var(--radius);
        border: 1px solid var(--crystal);
    }
    p { color: var(--muted); line-height: 1.4; }
    .gain { display: flex; justify-content: space-between; align-items: baseline; }
    .crystal { font-size: 2rem; font-weight: bold; color: var(--crystal); }
    .go { background: var(--crystal); color: var(--bg); font-weight: bold; }
    .confirm { display: flex; gap: var(--gap); align-items: center; }
    .confirm span { flex: 1; }
    .danger { background: var(--bad); color: var(--bg); }
</style>
