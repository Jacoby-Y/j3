<!-- Only the style block of a small idle game's Settings component: css_test and dom_test assert against it. -->

<style>
    .list { display: flex; flex-direction: column; gap: var(--gap); }
    label {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.875rem;
        background: var(--raised);
        border-radius: var(--radius);
    }
    label:hover { background: var(--hover); }
    label span:first-child { flex: 1; }
    input[type="range"] { width: 140px; accent-color: var(--accent); }
    .val { min-width: 36px; text-align: right; color: var(--muted); }
</style>
