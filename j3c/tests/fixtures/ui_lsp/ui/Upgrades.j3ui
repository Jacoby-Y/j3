<script>
    use shop.sim.{ Sim, KINDS };

    props {
        sim: &Sim;
    }
</script>

<UpgradeRow
    label="Click damage"
    value={sim.clickDamage}
    cost={sim.clickCost}
    gold={sim.gold}
    on:buy={sim.upgradeClick()} />

{#each 0..KINDS as k}
    {#if sim.shop[k].owned > 0}
        <h2>{sim.shop[k].name}</h2>
    {/if}
{/each}
