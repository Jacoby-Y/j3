<!-- A label, the value, and a buy button that emits `buy`. -->

<script>
    props {
        label: string;
        value: int;
        cost: int;
        gold: int;
    }

    events {
        buy;
    }
</script>

<div class="row">
    <span>{label}</span>
    <span>{value}</span>
    <button disabled={gold < cost} on:click={emit buy}>{cost}</button>
</div>
