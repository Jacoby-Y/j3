module shop;

use shop.sim.{ Sim, Shop };
use shop.ui.{ Game, GameProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;

struct World {
    sim: Sim;
    root: Game;
}

fn boot(mem: &Arena): World {
    return World { sim: Sim { shop: [Shop {}, Shop {}] }, root: Game.new(mem) };
}

fn draw(w: &World) {
    w.root.render(windowSize(), GameProps { sim: &w.sim });
}

fn main() {
    let app = App<World>.create("shop", 640, 360, boot);
    app.useGl();
    app.draw(draw);
    app.run();
}
