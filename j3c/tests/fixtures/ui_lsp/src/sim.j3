module shop.sim;

pub const KINDS = 2;
pub const MAX_BALLS = 20;

pub struct Shop {
    name: string = "ball";
    blurb: string = "";
    cost: int = 10;
    owned: int = 0;
    damage: int = 1;
    speed: f32 = 1;
}

pub struct Sim {
    gold: int = 0;
    ballCount: int = 0;
    clickDamage: int = 1;
    clickCost: int = 25;
    shop: [2]Shop;

    fn buyBall(this: &Sim, kind: int) {
        let s = &this.shop[kind];
        if this.gold < s.cost {
            return;
        }
        this.gold -= s.cost;
        s.owned += 1;
        this.ballCount += 1;
    }

    fn upgradeClick(this: &Sim) {
        this.clickDamage += 1;
    }
}
