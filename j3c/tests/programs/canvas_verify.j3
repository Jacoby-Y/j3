/// Pixel exactness, clipping, alpha, smooth coverage, blit, and seeded noise.
module canvas_verify;

use j3.gfx.canvas.{
    Canvas, Mode, rgb, rgba
};
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;

fn main() {
    let arena = Arena.create(4096);
    let a = Canvas.create(&arena, 8, 8, Mode.Pixel);
    a.pixel(1, 1, rgb(255, 0, 0));
    a.pixel(1, 1, rgba(0, 0, 255, 128));
    let i =(1 *8 + 1) *4;
    if a.pixels[i] != 127 || a.pixels[i + 1] != 0 || a.pixels[i + 2] != 128 || a.pixels[i + 3] != 255 {
        panic("canvas alpha blend");
    }
    a.fillRect(-2, -2, 3, 3, rgb(1, 2, 3));
    if a.pixels[0] != 1 || a.pixels[4] != 0 || a.pixels[8 *4] != 0 {
        panic("canvas clipping");
    }

    let src = Canvas.create(&arena, 2, 2, Mode.Pixel);
    src.clear(rgba(0, 0, 0, 0));
    src.pixel(0, 0, rgb(31, 61, 91));
    a.blit(src, 6, 6);
    let pasted =(6 *8 + 6) *4;
    if a.pixels[pasted] != 31 || a.pixels[pasted + 3] != 255 {
        panic("canvas blit");
    }

    let b = Canvas.create(&arena, 8, 8, Mode.Pixel);
    let c = Canvas.create(&arena, 8, 8, Mode.Pixel);
    b.noiseRect(0, 0, 8, 8, u32(19), 2, rgb(10, 20, 30), rgb(100, 110, 120));
    c.noiseRect(0, 0, 8, 8, u32(19), 2, rgb(10, 20, 30), rgb(100, 110, 120));
    let j = 0;
    while j < b.pixels.len {
        if b.pixels[j] != c.pixels[j] {
            panic("canvas seed");
        }
        j += 1;
    }
    let stray = arena.alloc::< u8 >(1);
    stray[0] = 7;
    let odd = Canvas.create(&arena, 3, 3, Mode.Pixel);
    odd.clear(rgb(7, 8, 9));
    odd.fillRect(1, 1, 2, 2, rgb(40, 50, 60));
    if odd.pixels[32] != 40 || odd.pixels[33] != 50 || odd.pixels[35] != 255 {
        panic("canvas aligned odd size");
    }
    let smooth = Canvas.create(&arena, 8, 8, Mode.Smooth);
    smooth.fillCircle(4, 4, 2.5, rgb(255, 255, 255));
    if smooth.pixels[(4 *8 + 6) *4 + 3] == 0 || smooth.pixels[(4 *8 + 6) *4 + 3] == 255 {
        panic("canvas smooth edge");
    }
    printLn("canvas checks passed");
    arena.destroy();
}
