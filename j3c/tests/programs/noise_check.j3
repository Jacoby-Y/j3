/// j3.gfx.noise stays in 0..1, is the same for the same seed, and tiles. No GL.
module noise_check;

use j3.io.printLn;
use j3.memory.Arena;
use j3.gfx.noise;
use j3.gfx.noise.{ KINDS, FRACTALS, CELL_MODES };
use j3.sys.panic;

fn near(a: f32, b: f32): bool {
    let d = a - b;
    return d < 0.001 && d > -0.001;
}

fn main() {
    let arena = Arena.create(1024 * 1024);
    let kind = 0;
    while kind < KINDS {
        let fractal = 0;
        while fractal < FRACTALS {
            let n = noise.make(7, &arena);
            let twin = noise.make(7, &arena);
            n.kind = kind;
            n.fractal = fractal;
            n.cell = (kind + fractal) - ((kind + fractal) / CELL_MODES) * CELL_MODES;
            n.warp = 0.5;
            twin.kind = kind;
            twin.fractal = fractal;
            twin.cell = n.cell;
            twin.warp = 0.5;
            let i = 0;
            while i < 200 {
                let x = f32(i) * 0.0137;
                let y = f32(i) * 0.0291;
                let v = noise.sample(&n, x, y);
                if v < 0 || v > 1 { panic("noise out of range"); }
                if !near(v, noise.sample(&twin, x, y)) { panic("same seed, different noise"); }
                // One texture width over, it repeats.
                if !near(v, noise.sample(&n, x + 1, y)) || !near(v, noise.sample(&n, x, y + 1)) {
                    panic("noise does not tile");
                }
                i += 1;
            }
            fractal += 1;
        }
        kind += 1;
    }
    let other = noise.make(8, &arena);
    let base = noise.make(7, &arena);
    let differs = false;
    let k = 0;
    while k < 50 {
        if !near(noise.sample(&base, f32(k) * 0.05, 0.3), noise.sample(&other, f32(k) * 0.05, 0.3)) { differs = true; }
        k += 1;
    }
    if !differs { panic("seed has no effect"); }
    printLn("ok");
}
