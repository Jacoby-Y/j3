module honesty.else_if_expr;

use j3.io.printLn;
use j3.math.Vec2;

struct P {
    x: int;
}

struct Box2 {
    inner: P;
    arr: [3]int;
}

fn pt(): P {
    return P { x: 7 };
}

fn mk(): Box2 {
    return Box2 { inner: P { x: 5 }, arr: [4, 5, 6] };
}

fn pick(a: int): int {
    return if a == 0 { 10 } else if a == 1 { 11 } else if a == 2 { 12 } else { 13 };
}

fn main() {
    let xs: [1]int = [7];
    let i = 3;
    let y = if i < 1 { xs[i] } else if i < 2 { xs[i + 1] } else { 2 };
    let s = pick(0) + pick(1) + pick(2) + pick(9);
    let arr: [5]int = [1, 2, 3, 4, 5];
    let sl: []int = arr[0..5];
    let n = sl[1..4].len + (pt().x) + mk().inner.x + mk().arr[2] + mk().arr[1..3].len;
    if y == 2 && s == 46 && n == 3 + 7 + 5 + 6 + 2 {
        printLn("ok");
    }
    let v = Vec2 { x: 1.0, y: 2.0 };
    let w = Vec2 { x: 3.0, y: 4.0 };
    let vx = (v + w).x;
    if vx == 4.0 {
        printLn("ok2");
    }
}
