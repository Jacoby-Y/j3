module honesty.text_find;

use j3.io.printLn;
use j3.text;

fn main() {
    if text.find("hello", "ll") == 2 && text.find("hello", "lo!") == -1
        && text.find("hi", "") == 0 && text.find("", "a") == -1
        && text.contains("plant_bush_2", "bush") && !text.contains("tree", "trees") {
        printLn("ok");
    }
}
