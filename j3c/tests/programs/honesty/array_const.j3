module honesty.array_const;

use j3.io.printLn;

struct P {
    x: int;
    y: f32;
}

const XS: [3]int = [1, 2, 3];
const FS: [2]f32 = [1.5, 2.5];
const BS: [2]bool = [true, false];
const PS: [2]P = [P { x: 1, y: 0.5 }, P { x: 2, y: 1.5 }];
const SS: [2]string = [`ab`, `cde`];

fn sum(a: []int): int {
    let t = 0;
    for x in a {
        t += x;
    }
    return t;
}

fn main() {
    let t = 0;
    for x in XS {
        t += x;
    }
    let names = 0;
    for s in SS {
        names += s.len;
    }
    if XS[1] == 2 && XS.len == 3 && FS[1] == 2.5 && BS[0] && !BS[1] && PS[1].x == 2 && PS[0].y == 0.5
        && t == 6 && sum(XS) == 6 && sum(XS[1..3]) == 5 && SS[1].len == 3 && names == 5 {
        printLn(`ok`);
    }
}
