module honesty.rem;

use j3.io.printLn;
use j3.math;

const R: int = 17 % 5;

fn main() {
    let a = 7;
    let b = 3;
    let n = -7;
    let min = -9223372036854775807 - 1;
    let m1 = -1;
    let f: f32 = 7.5;
    let g: f32 = 2.0;
    let d: f64 = -7.5;
    let e: f64 = 2.0;
    let w32: i32 = 10;
    if a % b == 1 && n % b == -1 && min % m1 == 0 && R == 2
        && f % g == 1.5 && d % e == -1.5 && w32 % 4 == 2 && (a + 2) * 3 % 4 == 3
        && math.wrapi(-1, 4) == 3 && math.wrapi(-8, 4) == 0 && math.wrapi(9, 4) == 1 {
        printLn("ok");
    }
}
