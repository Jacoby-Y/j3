module honesty.rvalue_eval_once;

use j3.io.printLn;

struct P {
    x: int;
}

struct B {
    inner: P;
}

fn mk(c: &int): B {
    *c += 1;
    return B { inner: P { x: 5 } };
}

fn g(c: &int): int {
    *c = *c * 10 + 1;
    return 1;
}

fn h(c: &int): int {
    *c = *c * 10 + 2;
    return 3;
}

fn view(xs: []int): []int {
    return xs;
}

fn main() {
    let c = 0;
    let a = mk(&c).inner.x;
    if a == 5 && c == 1 {
        printLn("once");
    }
    let d = 0;
    let xs: [4]int = [1, 2, 3, 4];
    let n = xs[g(&d)..h(&d)].len;
    if n == 2 && d == 12 {
        printLn("order");
    }
    view(xs)[2] = 9;
    view(xs)[3] += 1;
    if xs[2] == 9 && xs[3] == 5 {
        printLn("slice-store");
    }
}
