module honesty.interp_long;

use j3.io.printLn;
use j3.memory.Arena;
use j3.text.Text;

// `{s}` alone is `s` itself: no template buffer, any length. `Text.add` chains for mixed text.
fn main() {
    let mem = Arena.create(1048576);
    let t = Text.new(&mem);
    for i in 0..100000 { t.push(u8(97 + i % 26)); }
    let s = t.str();
    let one = `{s}`;
    let mixed = Text.scratch().add("n=").add(`{s.len}`).add(" ").add(`{s}`).str();
    if one.len == 100000 && one.ptr == s.ptr && mixed.len == 100009 && mixed[0] == 110 && mixed[8] == 32 && mixed[100008] == s[99999] {
        printLn("ok");
    }
}
