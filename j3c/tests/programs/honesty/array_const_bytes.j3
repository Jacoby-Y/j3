module honesty.array_const_bytes;

use j3.io.printLn;

const SS: [3]string = ["a\01", "a", "??=?"];
const FS: [3]f64 = [-1.5, 2.5, -0.25];
const NS: [2]f32 = [-2.0, 3.0];

fn same(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn main() {
    let lit = "a\01";
    let e0 = SS[0].len == 3 && SS[0][1] == 0 && SS[0][2] == 49;
    let e1 = SS[1].len == 2 && SS[1][0] == 1 && SS[1][1] == 97;
    let e2 = SS[2].len == 4 && SS[2][0] == 63 && SS[2][2] == 61;
    let l = lit.len == 3 && lit[1] == 0 && lit[2] == 49 && same(lit, SS[0]);
    let f = FS[0] == -1.5 && FS[2] == -0.25 && NS[0] == -2.0;
    if e0 && e1 && e2 && l && f {
        printLn(`ok`);
    }
}
