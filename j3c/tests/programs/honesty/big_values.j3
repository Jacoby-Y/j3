// Values over 64 bytes (`llvm_ty::big`): returned through a hidden pointer, passed by address
// and copied on entry, through direct, indirect and closure calls, enum payloads and swaps.
module t;
use j3.io.printLn;

struct Big { a: int; pad: [20]int; z: int; }
struct Pair { l: Big; r: Big; }
enum Box { Empty, Full(Big) }

fn make(n: int): Big {
    let b: Big;
    b.a = n;
    b.z = n * 2;
    defer { b.a = 999; } // runs after the value is taken
    return b;
}
fn bump(b: Big): Big { b.a += 1; return b; }
fn sum(b: Big): int { return b.a + b.z; }
fn wrap(b: Big): Box { return Box.Full(b); }

fn main() {
    let x = make(3);
    let y = bump(x);
    x = bump(x);
    let f = bump;
    let w = f(y);
    let p = Pair { l: x, r: w };
    let t = p.l;
    p.l = p.r;
    p.r = t;
    let c = fn(b: Big): Big { return bump(b); };
    let q = c(p.r);
    let s = match wrap(q) { Box.Full(v) { sum(v) } Box.Empty { 0 } };
    printLn(`{x.a} {y.a} {w.a} {p.l.a} {p.r.a} {q.a} {s}`);
}
