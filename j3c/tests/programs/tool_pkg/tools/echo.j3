//! `j3c pkg tool_pkg echo ARGS...`: prints its args, the runner's env and `[tool_pkg] greeting`
//! from the manifest JSON, then exits 3.
module tool_pkg.echo;

use j3.io.{printLn, readFile};
use j3.sys;
use j3.memory.Arena;
use j3.data.json;
use tool_pkg.words.label;

fn main() {
    let a = Arena.create(65536);
    let args = "";
    for i in 1..sys.argCount() {
        args = `{args} {sys.arg(i)}`;
    }
    printLn(`{label()}:{args}`);
    printLn(`root {sys.env("J3_PROJECT_ROOT")}`);
    printLn(`api {sys.env("J3_TOOL_API")}`);
    match readFile(sys.env("J3_MANIFEST"), &a) {
        Result.Ok(bytes) {
            match json.parseStr(bytes as string, &a) {
                Result.Ok(j) { printLn(`greeting {j.path("tool_pkg.greeting").asStr()}`); }
                Result.Err(e) { printLn(`bad json: {e.msg}`); }
            }
        }
        Result.Err(e) { printLn("no manifest"); }
    }
    sys.exit(3);
}
