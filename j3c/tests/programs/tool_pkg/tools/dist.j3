//! `build_outputs = ["fake"]`: writes its args (one per line) to `<dist>/fake/args.txt`, prints
//! that folder last, exits 0.
module tool_pkg.dist;

use j3.io.{printLn, writeFile, makeDirs};
use j3.sys;
use j3.memory.Arena;
use j3.text.Text;

fn main() {
    let a = Arena.create(65536);
    let t = Text.new(&a);
    let dist = "";
    for i in 1..sys.argCount() {
        if i > 1 && sys.arg(i - 1) == "--dist" {
            dist = sys.arg(i);
        }
        t.pushStr(sys.arg(i));
        t.push('\n');
    }
    let dir = Text.new(&a).add(dist).add("/fake").str();
    match makeDirs(dir) {
        Result.Ok(_) {}
        Result.Err(e) { printLn("mkdir failed"); sys.exit(1); }
    }
    match writeFile(Text.new(&a).add(dir).add("/args.txt").str(), t.bytes) {
        Result.Ok(_) {}
        Result.Err(e) { printLn("write failed"); sys.exit(1); }
    }
    printLn("fake: wrote args");
    printLn(dir);
}
