module voxel_ao;

use j3.gfx;
use j3.gfx.FACE_NX;
use j3.gfx.FACE_PY;
use j3.io.printLn;
use j3.memory.Arena;

fn near(a: f32, b: f32): bool {
    let d = a - b;
    if d < 0 {
        return f32(0) - d < 0.001;
    }
    return d < 0.001;
}

fn main() {
    let mem = Arena.create(8192);
    let out = mem.alloc::<f32>(120);
    let n = gfx.emitFaceAo(out, 0, 0, 0, 0, FACE_PY, 1, 1, 1, 0, 0.5, 1, 1, 1);
    if n != 60 || !near(out[0], 0) || !near(out[1], 1) || !near(out[2], 0) || !near(out[6], 0.5) {
        printLn("top");
        return;
    }
    let m = gfx.emitFaceAo(out, 0, 0, 0, 0, FACE_PY, 1, 1, 1, 0, 1, 0.5, 1, 0.5);
    if m != 60 || !near(out[0], 0) || !near(out[1], 1) || !near(out[2], 1) || !near(out[6], 0.5) {
        printLn("flip");
        return;
    }
    let k = gfx.emitFaceAo(out, 0, 0, 0, 0, FACE_NX, 1, 1, 1, 0, 1, 1, 0.5, 1);
    if k != 60 || !near(out[0], 0) || !near(out[1], 1) || !near(out[2], 1) || !near(out[6], 0.5) {
        printLn("side");
        return;
    }
    printLn("ok");
}
