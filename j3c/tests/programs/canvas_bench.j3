/// Repeatable CPU benchmark. Build with `j3c build --opt 2` for useful numbers.
module canvas_bench;

use j3.gfx.canvas.{
    Canvas, Mode, loadPng, rgb, rgba
};
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

use lib "c" as libc {
    fn clock() : int;
}

fn report(arena : &Arena, name : string, ticks : int) {
    let text = Text.new(arena);
    text.pushStr(name);
    text.pushStr(" ticks: ");
    text.pushInt(ticks);
    printLn(text.str());
}

fn main() {
    let arena = Arena.create(12000000);
    let pixels = Canvas.create(&arena, 1024, 1024, Mode.Pixel);
    let start = libc.clock();
    let i = 0;
    while i < 32 {
        pixels.fillRect(0, 0, 1024, 1024, rgb(u8(i *7), 58, 79));
        i += 1;
    }
    report(&arena, "32 opaque fills, 1024x1024", libc.clock() -start);

    let smooth = Canvas.create(&arena, 1024, 1024, Mode.Smooth);
    let shapes = libc.clock();
    let j = 0;
    while j < 512 {
        let x = f32(32 +(j -(j / 16) *16) *64);
        let y = f32(32 +(j / 16) *31);
        smooth.fillCircle(x, y, 22, rgba(229, 154, 72, 180));
        j += 1;
    }
    report(&arena, "512 antialiased circles", libc.clock() -shapes);

    let noise = libc.clock();
    pixels.noiseRect(0, 0, 1024, 1024, u32(72), 4, rgb(28, 40, 52), rgb(130, 145, 151));
    report(&arena, "seeded noise, 1024x1024", libc.clock() -noise);

    let export = libc.clock();
    match pixels.savePng("target/canvas_bench.png", &arena) {
        Result.Ok(_) {}
        Result.Err(_) { panic("canvas benchmark PNG write"); }
    }
    report(&arena, "PNG export, 1024x1024", libc.clock() -export);

    // A real compressed texture (dynamic Huffman, filtered rows). Run from `j3c/`.
    let decode = libc.clock();
    let tex = loadPng("../tools/voxel-editor/models/blocky-knight.png", &arena);
    if tex.w != 1120 { panic("canvas benchmark PNG decode"); }
    report(&arena, "PNG decode, 1120x1120 voxel render", libc.clock() -decode);
    arena.destroy();
}
