module script_bench;

// Script VM vs native. `j3c run` runs the script column on the VM (dev mode);
// `j3c build` compiles the same scripts AOT, so both columns are native.

use j3.io.printLn;
use j3.memory.{ Arena, List };
use bridge.pass;

use lib "c" as libc {
    fn clock_gettime(clock: i32, at: &Timespec): i32;
}

struct Timespec { seconds: int; nanos: int; }

const Bench = @script("scripts/bench.j3s");
const Walker = @script("scripts/walker.j3s");

fn nanos(): int {
    let stamp = Timespec { seconds: 0, nanos: 0 };
    libc.clock_gettime(1, &stamp);
    return stamp.seconds * 1000000000 + stamp.nanos;
}

// Native twins of scripts/bench.j3s and scripts/walker.j3s.
fn math(seed: int, n: int): int {
    let value = seed;
    for i in 0..n {
        value = value * (i + 3) + 1013904223;
    }
    return value;
}

fn fmath(n: int): f32 {
    let value: f32 = 0.5;
    for i in 0..n {
        value = value * 0.99999 + 0.001;
    }
    return value;
}

fn fib(n: int): int {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn calls(n: int): int {
    let value = 0;
    for i in 0..n { value = pass(value); }
    return value;
}

struct Body {
    x: f32;
    vx: f32;
    speed: f32;
    steps: int;

    fn step(this: &Body, dt: f32) {
        this.x += this.vx * this.speed * dt;
        if this.x > 10.0 { this.vx = -1.0; }
        if this.x < 0.0 { this.vx = 1.0; }
        this.steps += 1;
    }
}

fn row(name: string, n: int, native: int, script: int) {
    let per = (script * 1000 / n) as f64 / 1000.0;
    let ratio = (script * 10 / (native + 1)) as f64 / 10.0;
    printLn(`{name}: native {native / 1000} us, script {script / 1000} us, {per} ns/op, {ratio}x`);
}

fn main() {
    let arena = Arena.create(16777216);
    let bench = Bench {};
    // Vary n at run time so neither side folds the loop away.
    let n: int = 2000000 + nanos() % 7;

    let t0 = nanos();
    let a = math(7, n);
    let t1 = nanos();
    let b = bench.math(n);
    let t2 = nanos();
    if a != b { printLn("math differs"); return; }
    row("int math", n, t1 - t0, t2 - t1);

    let t3 = nanos();
    let fa = fmath(n);
    let t4 = nanos();
    let fb = bench.fmath(n);
    let t5 = nanos();
    if fa != fb { printLn("f32 math differs"); return; }
    row("f32 math", n, t4 - t3, t5 - t4);

    let depth = 24 + nanos() % 2;
    let t6 = nanos();
    let ra = fib(depth);
    let t7 = nanos();
    let rb = bench.fib(depth);
    let t8 = nanos();
    if ra != rb { printLn("fib differs"); return; }
    row("recursive calls", ra, t7 - t6, t8 - t7);

    let count = 200000;
    let t9 = nanos();
    let ca = calls(count);
    let t10 = nanos();
    let cb = bench.calls(count);
    let t11 = nanos();
    if ca != cb { printLn("native calls differ"); return; }
    row("native call", count, t10 - t9, t11 - t10);

    let walkers = List<Walker>.new(&arena);
    let bodies = arena.alloc::<Body>(10000);
    for i in 0..10000 {
        let speed = 1.0 + (i % 5) as f32;
        walkers.push(Walker { speed: speed });
        bodies[i] = Body { x: 0.0, vx: 1.0, speed: speed, steps: 0 };
    }
    let frames = 60;
    let t12 = nanos();
    for f in 0..frames {
        for i in 0..10000 { bodies[i].step(0.016); }
    }
    let t13 = nanos();
    for f in 0..frames {
        for i in 0..10000 { walkers.items[i].step(0.016); }
    }
    let t14 = nanos();
    if bodies[9999].x != walkers.items[9999].position() { printLn("walkers differ"); return; }
    row("10k instance update", frames * 10000, t13 - t12, t14 - t13);
}
