use bridge.pass;

props {
    seed: int = 7;
}

let total: int = 0;

pub fn math(n: int): int {
    let value = seed;
    for i in 0..n {
        value = value * (i + 3) + 1013904223;
    }
    total = value;
    return total;
}

pub fn fmath(n: int): f32 {
    let value: f32 = 0.5;
    for i in 0..n {
        value = value * 0.99999 + 0.001;
    }
    return value;
}

pub fn fib(n: int): int {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

pub fn calls(n: int): int {
    let value = 0;
    for i in 0..n { value = pass(value); }
    return value;
}
