module tone;

use j3.game;
use j3.io.printLn;
use j3.math.{ TAU, sin };
use j3.memory.Arena;

const RATE: int = 48000;
const AHEAD: int = 2400; // keep 50 ms queued

fn main() {
    let s = game.openAudioStream(RATE, 2);
    if s.raw == 0 {
        printLn("no audio device");
        return;
    }
    let arena = Arena.create(1024 * 1024);
    let buf = arena.alloc::<f32>(AHEAD * 2);
    let phase: f32 = 0;
    let sent = 0; // frames handed to the device
    let start = game.ticks();
    let last = start;
    while game.ticks() - start < 2000 {
        // One "frame": top the queue back up to AHEAD frames.
        let n = AHEAD - s.queued();
        if n > 0 {
            for i in 0..n {
                let v = 0.2 * sin(phase);
                buf[i * 2] = v;
                buf[i * 2 + 1] = v;
                phase = phase + TAU * 440.0 / f32(RATE);
                if phase > TAU { phase = phase - TAU; }
            }
            s.queue(buf[0..n * 2]);
            sent = sent + n;
        }
        if game.ticks() - last >= 250 {
            last = game.ticks();
            // Playhead: what the device has taken so far, to within one 512-frame buffer.
            printLn(`playhead {sent - s.queued()} frames`);
        }
        while game.ticks() - last < 16 && game.ticks() - start < 2000 {}
    }
    s.clear(); // instant stop; a seek is clear() then queue from the new spot
    s.close();
}
