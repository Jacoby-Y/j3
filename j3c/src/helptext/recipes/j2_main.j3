module modhost;

use j3.io.printLn;
use j3.j2;
use j3.j2.{ Args, Limits, Value, Vm };
use j3.memory.Arena;
use j3.result.Result;

/// `spawn(kind, x, y)`, a native the scripts can call. A wrong argument type is a script error
/// at the script's line; the getters raise it, so the native checks nothing itself.
fn spawn(vm: &Vm, args: Args): Value {
    let e = vm.newTable();
    e.set("kind", j2.str(vm, args.str(0)));
    e.set("x", j2.num(args.num(1)));
    e.set("y", j2.num(args.num(2)));
    return e.value();
}

fn main() {
    let mem = Arena.create(64 << 10);
    let vm = Vm.new(&mem, Limits { heapBytes: 8 << 20 });
    vm.openLibs(j2.LIB_ALL);
    vm.bind("spawn", spawn);

    match vm.loadFile("hello", "mods/hello.j2") {
        Result.Ok(exports) {
            let mod = vm.keep(exports);
            let onTick = vm.get(mod).get("onTick");
            for _ in 0..3 {
                match vm.call(onTick, [j2.num(0.016)]) {
                    Result.Ok(v) {
                        printLn(`onTick gave {v.asNum()}`);
                    }
                    Result.Err(e) {
                        printLn(e.message);
                    }
                }
            }
            printLn(`speed = {vm.get(mod).getNum("speed", 0.0)}`);
            vm.release(mod);
        }
        Result.Err(e) {
            printLn(e.message);
        }
    }

    match vm.loadString("broken", "pub fn onTick(dt) { spwan(1); }") {
        Result.Ok(_) {}
        Result.Err(e) {
            printLn(e.message);
        }
    }
    vm.destroy();
    mem.destroy();
}
