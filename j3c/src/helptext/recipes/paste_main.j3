module paster;

use j3.app.App;
use j3.game;
use j3.game.{ Key, rgb };
use j3.gfx.paint;
use j3.io;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.same;

struct World {
    pasted: int = 0;
}

fn boot(mem: &Arena): World {
    return World {};
}

fn input(w: &World, _dt: f32) {
    if !(game.keyDown(Key.Ctrl) && game.keyPressed(Key.V)) {
        return;
    }
    let types = game.clipboardTypes();
    let png = false;
    for i in 0..types.len {
        printLn(types[i]);
        if same(types[i], "image/png") { png = true; }
    }
    if png {
        // a view the next clipboard call replaces: write it out now
        match io.writeFile("pasted.png", game.clipboardData("image/png")) {
            Result.Ok(n) { w.pasted += 1; printLn("wrote pasted.png"); }
            Result.Err(e) { printLn("could not write pasted.png"); }
        }
    } else {
        printLn(game.clipboardData("text/uri-list") as string);
    }
}

fn draw(w: &World) {
    let c = if w.pasted > 0 { rgb(166, 227, 161) } else { rgb(49, 50, 68) };
    paint.rect(Vec2 { x: 0, y: 0 }, game.windowSize(), c);
}

fn main() {
    let app = App<World>.create("paster", 320, 180, boot);
    app.useGl();
    app.always(input);
    app.draw(draw);
    app.run();
}
