module watcher;

use j3.app.App;
use j3.game;
use j3.game.rgb;
use j3.gfx.paint;
use j3.io.printLn;
use j3.io.watch.{ Event, Kind, Watcher };
use j3.math.Vec2;
use j3.memory.{ Arena, List };
use j3.result.Result;

struct World {
    w: Watcher;
    evs: List<Event>;
    dirId: int = -1;
    fileId: int = -1;
    /// Bumped on each change, so the screen shows something happened.
    changes: int = 0;
}

fn boot(mem: &Arena): World {
    return World { w: Watcher.create(mem), evs: List<Event>.new(mem) };
}

fn startup(w: &World) {
    // a folder reports its direct entries; a file reports itself (rename-over saves read as Modify)
    match w.w.add("assets") {
        Result.Ok(id) { w.dirId = id; }
        Result.Err(_) { printLn("no assets/ folder to watch"); }
    }
    match w.w.add("j3.toml") {
        Result.Ok(id) { w.fileId = id; }
        Result.Err(_) { }
    }
}

fn kindName(k: Kind): string {
    match k {
        Kind.Create { return "create"; }
        Kind.Delete { return "delete"; }
        Kind.Modify { return "modify"; }
        Kind.MoveIn { return "move in"; }
        Kind.MoveOut { return "move out"; }
        Kind.Overflow { return "overflow: rescan everything"; }
    }
    return "";
}

fn draw(w: &World) {
    // never blocks; a change also wakes an idle (sleeping) app, so this runs when it matters
    if w.w.poll(&w.evs) > 0 {
        for i in 0..w.evs.len {
            let e = w.evs.items[i];
            // e.name points into the watcher's buffer until the next poll: copy it to keep it
            if e.id == w.fileId { printLn(`j3.toml: {kindName(e.kind)}`); }
            else { printLn(`assets/{e.name}: {kindName(e.kind)}`); }
        }
        w.changes += w.evs.len;
        w.evs.len = 0;
    }
    let c = if w.changes % 2 == 0 { rgb(30, 30, 46) } else { rgb(49, 50, 68) };
    paint.rect(Vec2 { x: 0, y: 0 }, game.windowSize(), c);
}

fn stop(w: &World) {
    w.w.close();
}

fn main() {
    let app = App<World>.create("watcher", 320, 180, boot);
    app.useGl();
    app.startup(startup);
    app.draw(draw);
    app.shutdown(stop);
    app.run();
}
