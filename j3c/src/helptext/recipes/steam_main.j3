module spacerun;

use j3.app.App;
use j3.game;
use j3.game.{ Key, rgb };
use j3.gfx.paint;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.steam;
use j3.steam.{ Status, Uploaded };
use j3.steam.game.attach;
use j3.sys;

const APP_ID: u32 = 480;   // Valve's Spacewar test app; use your own id when you have one
const GOAL: int = 100;

struct World {
    score: int = 0;
    won: bool = false;
}

fn boot(mem: &Arena): World {
    return World {};
}

fn startup(w: &World) {
    // Absent (no Steam) is fine: every call below then does nothing.
    let st = steam.init(APP_ID);
    if st == Status.Restart { sys.exit(0); }
    steam.presence("status", "Running");
}

// Runs in the leaderboard handler's chain; `up` is valid only here.
fn uploaded(up: &Uploaded, ctx: u64) {
    if up.ok { steam.presence("status", `Finished with {up.score}`); }
}

// ctx carries the score. A board handle of 0 means Steam could not find or make it.
fn gotBoard(board: u64, ok: bool, ctx: u64) {
    if !ok { return; }
    let none: []i32 = @slice(0 as ptr, 0);
    steam.uploadScore(board, steam.UPLOAD_KEEP_BEST, i32(ctx), none, uploaded, ctx);
}

fn win(w: &World) {
    w.won = true;
    steam.unlock("ACH_WIN_ONE_GAME");
    steam.findOrCreateBoard("High Score", steam.SORT_DESC, steam.DISPLAY_NUMERIC, gotBoard, u64(w.score));
    steam.store();
}

fn step(w: &World, dt: f32) {
    if w.won { return; }
    w.score += 5;                                      // the run climbs by itself
    if game.keyPressed(Key.Space) { w.score += 10; }   // and Space pushes it
    if w.score >= GOAL { win(w); }
}

fn draw(w: &World) {
    let c = if w.won { rgb(166, 227, 161) } else { rgb(137, 180, 250) };
    paint.rect(Vec2 { x: 0, y: 0 }, Vec2 { x: f32(game.windowSize().x) * f32(w.score) / f32(GOAL), y: 180 }, c);
}

// Registered before `attach`, so Steam is still live. `steam.shutdown` also stores changed stats.
fn quit(w: &World) {
    steam.store();
}

fn main() {
    let app = App<World>.create("spacerun", 320, 180, boot);
    app.useGl();
    app.startup(startup);
    app.always(step);
    app.draw(draw);
    app.shutdown(quit);
    attach(&app);          // pumps callbacks each frame, shuts Steam down at exit
    app.run();
}
