module tuidemo;

use j3.io.printLn;
use j3.memory.Arena;
use j3.memory.List;
use j3.result.Result;
use j3.term.Color;
use j3.term.Style;
use j3.term.input.Event;
use j3.term.input.EV_KEY;
use j3.term.input.KEY_CHAR;
use j3.term.screen;
use j3.term.screen.Screen;
use j3.term.screen.EV_RESIZE;

fn main() {
    let a = Arena.create(1048576);
    let plain = Style { fg: Color.default(), bg: Color.default(), attr: u16(0) };
    let green = Style { fg: Color.palette(2), bg: Color.default(), attr: u16(1) };
    match Screen.open(&a) {
        Result.Ok(s) {
            let ev = List<Event>.new(&a);
            let typed = 0;
            let run = true;
            while run {
                s.clear();
                s.box(2, 1, 30, 5, green);
                s.put(4, 2, "Hello from a TUI", green);
                s.put(4, 3, `keys typed: {typed}`, plain);
                s.put(4, 4, "press q to quit", plain);
                s.flush();
                s.poll(50, &ev);
                for i in 0..ev.len {
                    let e = ev.items[i];
                    // EV_RESIZE: the screen is already resized, the next loop redraws
                    if e.kind == EV_KEY {
                        typed += 1;
                        if e.key == KEY_CHAR && e.cp == 113 { run = false; }
                    }
                }
            }
            s.close();
        }
        Result.Err(msg) { printLn(`no terminal: {msg}`); }
    }
}
