module ptydemo;

use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys;
use j3.term.ansi.Parser;
use j3.term.ansi.feed;
use j3.term.grid.Grid;
use j3.term.pty;

fn main() {
    let a = Arena.create(4194304);
    let buf = a.alloc::<u8>(4096);
    let none: [1]string = [""];
    let argv: [3]string = ["ls", "--color=always", "."];
    match pty.spawn(argv[:], "", none[0..0], 80, 24, &a) {
        Result.Ok(p) {
            let grid = Grid.new(&a, 80, 24, 100);
            let parser = Parser.new(&a);
            // read until the program closes its side, or about 5 s
            for i in 0..100 {
                let pfd: [2]i32 = [i32(p.fd), i32(sys.POLLIN)];
                sys.pollFds(&pfd[0] as ptr, 1, 50);
                parser.feed(p.tryRead(buf), &grid);
                if p.eof { break; }
            }
            printLn(grid.dumpText(&a));
            p.wait();
            p.close();
        }
        Result.Err(_) { printLn("could not spawn ls"); }
    }
}
