module mygame;

use mygame.ui.{ Screen, ScreenProps };
use j3.app.App;
use j3.game.windowSize;
use j3.memory.Arena;
use j3.text.Text;
use j3.ui.ansi.AnsiLog;

struct World {
    log: AnsiLog;
    root: Screen;
}

/// `~` stands for ESC, since J3 strings have no escape for it.
fn esc(s: string, mem: &Arena): string {
    let t = Text.new(mem);
    for i in 0..s.len {
        t.push(if s[i] == 126 { 27 } else { s[i] });
    }
    return t.str();
}

fn boot(mem: &Arena): World {
    // 0xcdd6f4 and 0x11111b are the pane's text and background (the .log CSS): only inverse and dim need them. 10000 is the line cap.
    let w = World { log: AnsiLog.new(0xcdd6f4, 0x11111b, 10000), root: Screen.new(mem) };
    // Append output as it arrives (a process read, a log tail); chunks may split anywhere, even inside an escape.
    w.log.append(esc("~[1;34mdocs~[0m  ~[32mrun.sh~[0m  ~[1;36mlink~[0m  notes.txt\n", mem));
    w.log.append(esc("~[31merror~[0m: ~[1mcannot find~[0m ~[4mmain.j3~[0m\n~[2mhint: check the entry~[0m\n", mem));
    w.log.append(esc("~[38;5;208morange~[0m ~[38;2;120;200;255mtruecolor~[0m ~[7minverse~[0m\n", mem));
    w.log.append("progress 10%\rprogress 100%\n");
    return w;
}

fn draw(w: &World) {
    w.root.render(windowSize(), ScreenProps { log: &w.log });
}

fn main() {
    let app = App<World>.create("mygame", 640, 360, boot);
    app.useGl();
    app.hiDpi();
    app.draw(draw);
    app.run();
}
