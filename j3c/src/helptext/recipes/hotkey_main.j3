module recorder;

use j3.app.App;
use j3.game;
use j3.game.{ Key, rgb };
use j3.game.hotkey;
use j3.game.hotkey.Hotkey;
use j3.gfx.paint;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;

struct World {
    hk: Hotkey;
    paused: bool = false;
}

fn boot(mem: &Arena): World {
    return World { hk: Hotkey {} };
}

fn startup(w: &World) {
    // F8 works while another app has focus. Err on Wayland, headless, or when it is taken.
    match hotkey.register(Key.F8, hotkey.NONE) {
        Result.Ok(h) { w.hk = h; }
        Result.Err(e) { printLn("no global F8; using the in-window key only"); }
    }
}

fn input(w: &World, _dt: f32) {
    // a grabbed key goes to the hotkey, not the window, so the two never both fire
    if w.hk.pressed() || game.keyPressed(Key.F8) { w.paused = !w.paused; }
}

fn draw(w: &World) {
    let c = if w.paused { rgb(243, 139, 168) } else { rgb(166, 227, 161) };
    paint.rect(Vec2 { x: 0, y: 0 }, game.windowSize(), c);
}

fn main() {
    let app = App<World>.create("recorder", 320, 180, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
