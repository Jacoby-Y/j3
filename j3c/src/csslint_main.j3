// The `j3c check` CSS lint program (embedded by `src/csslint.rs`, built once and cached).
// argv[1] is a spec file of tab-separated lines:
//   S scope shown-path line0 css-file     a style source (scope 0 = the theme)
//   E scope tag words                      an element the component's markup can create (tag `*`: any; words space separated)
// It prints one `file TAB line TAB col TAB message` per warning: the parser's own, then `j3.ui.csslint`'s.

module csslint_tool;

use j3.io.{ printLn, readFile };
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys.{ arg, panic };
use j3.text.{ same, Text };
use j3.ui.css.{ Css, Warning };
use j3.ui.csslint.{ ElFact, lint };
use j3.ui.cssparse.parseAt;

fn load(mem: &Arena, path: string): string {
    match readFile(path, mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) { panic(`cannot read {path}`); }
    }
}

fn num(s: string): int {
    let n = 0;
    for i in 0..s.len {
        n = n * 10 + int(s[i]) - 48;
    }
    return n;
}

/// Field `k` of a line split at `sep` (the rest of the line for the last wanted one is up to the caller).
fn field(s: string, sep: int, k: int): string {
    let a = 0;
    let n = 0;
    for i in 0..s.len {
        if int(s[i]) == sep {
            if n == k {
                return s[a..i];
            }
            n += 1;
            a = i + 1;
        }
    }
    if n == k {
        return s[a..s.len];
    }
    return "";
}

fn show(mem: &Arena, w: Warning) {
    let t = Text.new(mem);
    t.pushStr(w.file);
    t.pushStr("\t");
    t.pushInt(w.line);
    t.pushStr("\t");
    t.pushInt(w.col);
    t.pushStr("\t");
    t.pushStr(w.msg);
    printLn(t.str());
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    css.lintOn = true;
    let els = List<ElFact>.new(&mem);
    let spec = load(&mem, arg(1));
    let a = 0;
    for i in 0..spec.len + 1 {
        if i < spec.len && int(spec[i]) != 10 {
            continue;
        }
        let ln = spec[a..i];
        a = i + 1;
        let kind = field(ln, 9, 0);
        if same(kind, "S") {
            let text = load(&mem, field(ln, 9, 4));
            parseAt(&css, text, field(ln, 9, 2), num(field(ln, 9, 1)), num(field(ln, 9, 3)));
        } else if same(kind, "E") {
            let words = List<string>.new(&mem);
            let ws = field(ln, 9, 3);
            let b = 0;
            for j in 0..ws.len + 1 {
                if j < ws.len && int(ws[j]) != 32 {
                    continue;
                }
                if j > b {
                    words.push(ws[b..j]);
                }
                b = j + 1;
            }
            let tag = field(ln, 9, 2);
            els.push(ElFact { scope: num(field(ln, 9, 1)), tag: if same(tag, "*") { -1 } else { css.intern(tag) }, words: words });
        }
    }
    let out = List<Warning>.new(&mem);
    for i in 0..css.warns.len {
        show(&mem, css.warns.items[i]);
    }
    lint(&css, &els, &out);
    for i in 0..out.len {
        show(&mem, out.items[i]);
    }
}
