module scene;

struct Node {
    id: int;
}

struct Scene {
    angles: [4]f32;
}

fn setAngle(this: &Scene, node: Node, degrees: f32) {
    let tmp _i0: int;
    let tmp _bc1: bool;
    let tmp _bc2: bool;
    let tmp _bc3: bool;

    _i0 = copy node.id;
    _bc1 = copy _i0 < 0;
    _bc2 = copy _i0 >= 4;
    _bc3 = copy _bc1 || copy _bc2;
    if copy _bc3 {
        abort;
    }
    (*this).angles[copy _i0] = copy degrees;
}


module script.scripts.door;

struct Door {
    hinge: Node;
    openAngle: f32;
    seconds: f32;
    open: bool;
    t: f32;
}

pub fn update(this: &Door, scene: &Scene, dt: f32) {
    let tmp _if0: f32;
    let goal: f32;
    let step: f32;
    let tmp _t1: f32;
    let tmp _t2: f32;
    let tmp _t3: f32;
    let tmp _t4: f32;
    let tmp _t5: f32;
    let tmp _t6: f32;

    if copy (*this).open {
        _if0 = f32(0x3f800000);
    } else {
        _if0 = f32(0x0);
    }
    goal = copy _if0;
    step = copy dt / copy (*this).seconds;
    _t1 = copy goal - copy (*this).t;
    _t2 = f32(0x0) - copy step;
    _t3 = clamp(copy _t1, copy _t2, copy step);
    _t4 = copy (*this).t + copy _t3;
    (*this).t = clamp(copy _t4, f32(0x0), f32(0x3f800000));
    _t5 = smooth(copy this, copy (*this).t);
    _t6 = lerp(f32(0x0), copy (*this).openAngle, copy _t5);
    setAngle(copy scene, copy (*this).hinge, copy _t6);
}

pub fn toggle(this: &Door) {
    (*this).open = !copy (*this).open;
    if copy (*this).open {
        doorsOpened += 1;
    }
}

pub fn report(this: &Door) {
    let tmp _ibuf0: [512]u8;
    let tmp _in1: int;
    let tmp _iptr2: &u8;
    let tmp _t3: string;

    _in1 = 0;
    interp _ibuf0 used _in1 `door {copy (*this).hinge.id}: open {copy (*this).open} t {copy (*this).t} opened {copy doorsOpened}`;
    _iptr2 = &_ibuf0[0];
    _t3 = string { copy _iptr2, copy _in1 };
    printLn(copy _t3);
}

fn smooth(this: &Door, x: f32): f32 {
    let tmp _t0: f32;
    let tmp _t1: f32;
    let tmp _t2: f32;
    let tmp _t3: f32;

    _t0 = copy x * copy x;
    _t1 = f32(0x40000000) * copy x;
    _t2 = f32(0x40400000) - copy _t1;
    _t3 = copy _t0 * copy _t2;
    return copy _t3;
}


