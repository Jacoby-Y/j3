module speculative.embedding;

struct Vec2 {
    x: f32;
    y: f32;
}

struct Scale2 {
    width: f32;
    height: f32;
}

struct Transform {
    use position: Vec2;
    use scale: Scale2;
}

fn main() {
    let tmp _t0: Vec2;
    let tmp _t1: Scale2;
    let transform: Transform;
    let tmp _ibuf2: [512]u8;
    let tmp _in3: int;
    let tmp _iptr4: &u8;
    let tmp _t5: string;
    let tmp _ibuf6: [512]u8;
    let tmp _in7: int;
    let tmp _iptr8: &u8;
    let tmp _t9: string;

    _t0 = Vec2 { f32(0x41200000), f32(0x41200000) };
    _t1 = Scale2 { f32(0x3f800000), f32(0x3f800000) };
    transform = Transform { copy _t0, copy _t1 };
    _in3 = 0;
    interp _ibuf2 used _in3 `x={copy transform.position.x}, width={copy transform.scale.width}`;
    _iptr4 = &_ibuf2[0];
    _t5 = string { copy _iptr4, copy _in3 };
    printLn(copy _t5);
    _in7 = 0;
    interp _ibuf6 used _in7 `x={copy transform.position.x}, width={copy transform.scale.width}`;
    _iptr8 = &_ibuf6[0];
    _t9 = string { copy _iptr8, copy _in7 };
    printLn(copy _t9);
    transform.scale.width = f32(0x40000000);
    transform.scale.width = f32(0x40000000);
}


