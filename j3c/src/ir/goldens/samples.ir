module ir.samples;

#[Debug]
struct Vec2 {
    x: f32;
    y: f32;
}

struct Arena {
    ptr: ptr;
    used: int;
    cap: int;
}

struct Game {
    mem: &Arena;
    running: bool;
}

pub fn checkpoint(this: &Arena): int {
    return copy (*this).used;
}

fn scale(this: &Vec2, s: f32) {
    (*this).x *= copy s;
    (*this).y *= copy s;
}

fn bump(xs: []int, i: int) {
    xs[copy i] += 1;
}

fn tick(g: &Game) {
    let tmp arena_ref: &Arena;
    let tmp frame: int;

    arena_ref = &(*(*g).mem);
    frame = checkpoint(copy arena_ref);
    (*g).running = false;
}

pub fn main() {
    let arena: Arena;
    let tmp arena_p: &Arena;
    let g: Game;
    let tmp g_p: &Game;
    let v: Vec2;
    let tmp v_p: &Vec2;
    let bad_x: bool;
    let bad_y: bool;
    let buf: [4]int;
    let tmp buf0: &int;
    let xs: []int;
    let bad_buf: bool;

    arena = Arena { null, 7, 9 };
    arena_p = &arena;
    g = Game { copy arena_p, true };
    g_p = &g;
    tick(copy g_p);
    if copy g.running {
        @syscall(60, 1);
    }
    v = Vec2 { f32(0x41200000), f32(0x41a00000) };
    v_p = &v;
    scale(copy v_p, f32(0x40000000));
    bad_x = copy v.x != f32(0x41a00000);
    if copy bad_x {
        @syscall(60, 1);
    }
    bad_y = copy v.y != f32(0x42200000);
    if copy bad_y {
        @syscall(60, 1);
    }
    buf[0] = 0;
    buf[1] = 0;
    buf[2] = 0;
    buf[3] = 0;
    buf0 = &buf[0];
    xs = []int { copy buf0, 4 };
    bump(copy xs, 0);
    bad_buf = copy buf[0] != 1;
    if copy bad_buf {
        @syscall(60, 1);
    }
}

