module speculative.data;

#[Debug]
struct Vec2 {
    x: f32;
    y: f32;
}

struct Entity {
    pos: Vec2;
    vel: Vec2;
}

fn operator+(this: Vec2, other: Vec2): Vec2 {
    let tmp _t0: f32;
    let tmp _t1: f32;
    let tmp _t2: Vec2;

    _t0 = copy this.x + copy other.x;
    _t1 = copy this.y + copy other.y;
    _t2 = Vec2 { copy _t0, copy _t1 };
    return copy _t2;
}

fn operator-(this: Vec2, other: Vec2): Vec2 {
    let tmp _t0: f32;
    let tmp _t1: f32;
    let tmp _t2: Vec2;

    _t0 = copy this.x - copy other.x;
    _t1 = copy this.y - copy other.y;
    _t2 = Vec2 { copy _t0, copy _t1 };
    return copy _t2;
}

fn operator*(this: Vec2, s: f32): Vec2 {
    let tmp _t0: f32;
    let tmp _t1: f32;
    let tmp _t2: Vec2;

    _t0 = copy this.x * copy s;
    _t1 = copy this.y * copy s;
    _t2 = Vec2 { copy _t0, copy _t1 };
    return copy _t2;
}

fn length(this: Vec2): f32 {
    let tmp _t0: f32;
    let tmp _t1: f32;
    let tmp _t2: f32;
    let tmp _t3: f32;

    _t0 = copy this.x * copy this.x;
    _t1 = copy this.y * copy this.y;
    _t2 = copy _t0 + copy _t1;
    _t3 = sqrt(copy _t2);
    return copy _t3;
}

fn scale(this: &Vec2, s: f32) {
    (*this).x *= copy s;
    (*this).y *= copy s;
}

fn main() {
    let pos: Vec2;
    let vel: Vec2;
    let next: Vec2;
    let offset: Vec2;
    let doubled: Vec2;
    let len: f32;
    let tmp _this0: &Vec2;
    let player: Entity;
    let tmp _ibuf1: [512]u8;
    let tmp _in2: int;
    let tmp _iptr3: &u8;
    let tmp _t4: string;

    pos = Vec2 { f32(0x41200000), f32(0x41200000) };
    vel = Vec2 { f32(0x40000000), f32(0xbf800000) };
    next = operator+(copy pos, copy vel);
    offset = operator-(copy next, copy pos);
    doubled = operator*(copy offset, f32(0x40000000));
    len = length(copy doubled);
    _this0 = &doubled;
    scale(copy _this0, f32(0x3f000000));
    player = Entity { copy next, copy vel };
    _in2 = 0;
    interp _ibuf1 used _in2 `len={copy len} player.pos={copy player.pos}`;
    _iptr3 = &_ibuf1[0];
    _t4 = string { copy _iptr3, copy _in2 };
    printLn(copy _t4);
}


