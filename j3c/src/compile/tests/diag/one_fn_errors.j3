module one_fn_errors;

use j3.io.printLn;

// Independent mistakes in one fn are each reported; uses of a failed `let`
// or of a name already reported unknown are follow-ons and stay quiet.
fn main() {
    let a: i32 = "one";
    let b: bool = 3;
    let c = nope + nope * nope;
    printLn(`{c + 1} {a}`);
    while true {
        let d: f32 = true;
        printLn(`{d} {nope}`);
        break;
    }
    let e = 2 * nope;
}
