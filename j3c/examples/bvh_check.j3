// Checks j3.gfx.bvh: every triangle lands in exactly one leaf, leaves stay small, and every
// node's box holds everything under it. Prints "ok".
module bvh_check;

use j3.gfx.bvh;
use j3.gfx.bvh.{ Bvh, LEAF, NODE_FLOATS };
use j3.io.printLn;
use j3.memory.Arena;
use j3.rand.Rng;
use j3.sys.panic;

fn check(ok: bool, msg: string) {
    if !ok { panic(msg); }
}

/// Whether node `outer`'s box holds node `inner`'s.
fn holds(b: &Bvh, outer: int, inner: int): bool {
    let k = 0;
    while k < 3 {
        if b.nodes[inner * NODE_FLOATS + k] < b.nodes[outer * NODE_FLOATS + k] - 0.0001 { return false; }
        if b.nodes[inner * NODE_FLOATS + 4 + k] > b.nodes[outer * NODE_FLOATS + 4 + k] + 0.0001 { return false; }
        k += 1;
    }
    return true;
}

fn run(n: int, stacked: bool) {
    let mem = Arena.create(8 * 1024 * 1024);
    let rng = Rng.new(n + 3);
    let corners = mem.alloc::<f32>(n * 9);
    let i = 0;
    while i < n * 9 {
        corners[i] = rng.floatRange(-10, 10);
        // Many triangles on the same spot must still split.
        if stacked { corners[i] = rng.floatRange(-0.001, 0.001); }
        i += 1;
    }
    let b = bvh.build(corners, n, &mem);
    // The GPU tracer drops pushes past a stack of 46.
    check(b.depth <= 45, "tree too deep");
    let seen = mem.alloc::<int>(n);
    i = 0;
    while i < n { seen[i] = 0; i += 1; }
    let node = 0;
    while node < b.count {
        let at = node * NODE_FLOATS;
        let count = int(b.nodes[at + 7]);
        if count > 0 {
            check(count <= LEAF, "leaf too big");
            let first = int(b.nodes[at + 3]);
            let k = first;
            while k < first + count {
                seen[b.order[k]] += 1;
                // The leaf box holds its triangles.
                let c = 0;
                while c < 9 {
                    let axis = c - (c / 3) * 3;
                    let v = corners[b.order[k] * 9 + c];
                    check(v >= b.nodes[at + axis] - 0.0001 && v <= b.nodes[at + 4 + axis] + 0.0001, "leaf box");
                    c += 1;
                }
                k += 1;
            }
        } else if n > 0 {
            let left = int(b.nodes[at + 3]);
            check(left > node && left + 1 < b.count, "child index");
            check(holds(&b, node, left) && holds(&b, node, left + 1), "inner box");
        }
        node += 1;
    }
    i = 0;
    while i < n {
        check(seen[i] == 1, "triangle not in exactly one leaf");
        i += 1;
    }
    mem.destroy();
}

fn main() {
    run(0, false);
    run(1, false);
    run(5, false);
    run(1000, false);
    run(300, true);
    printLn("ok");
}
