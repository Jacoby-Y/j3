module mesh_fmt;

use j3.io.printLn;
use j3.math.{ Mat4, Quat, TAU, Vec3 };
use j3.memory.Arena;
use j3.mesh;

fn near(a: f32, b: f32): bool {
    let d = a - b;
    if d < 0 {
        d = f32(0) - d;
    }
    return d < 0.001;
}

fn main() {
    let q = Quat.xyzw(0, 1, 0, 0);
    let p = q.rotate(Vec3.xyz(1, 0, 0));
    if !near(p.x, f32(0) - f32(1)) || !near(p.y, 0) || !near(p.z, 0) {
        printLn("rot");
        return;
    }
    let spun = q.toMat4().transformPoint(Vec3.xyz(1, 0, 0));
    if !near(spun.x, f32(0) - f32(1)) || !near(spun.z, 0) {
        printLn("mat");
        return;
    }
    let id = Quat.identity().mul(q);
    if !near(id.y, 1) || !near(id.w, 0) {
        printLn("mul");
        return;
    }
    let moved = Mat4.translate(2, 0, 0).transformPoint(Vec3.xyz(1, 0, 0));
    if !near(moved.x, 3) || !near(moved.y, 0) {
        printLn("tr");
        return;
    }
    let grown = Mat4.scale(2, 3, 4).transformPoint(Vec3.xyz(1, 1, 1));
    if !near(grown.x, 2) || !near(grown.y, 3) || !near(grown.z, 4) {
        printLn("sc");
        return;
    }
    let turned = Mat4.rotate(Vec3.up(), TAU / f32(2)).transformPoint(Vec3.xyz(1, 0, 0));
    if !near(turned.x, f32(0) - f32(1)) || !near(turned.y, 0) {
        printLn("ry");
        return;
    }
    let placed = Mat4.translate(5, 0, 0).mul(Mat4.scale(2, 2, 2)).transformPoint(Vec3.xyz(1, 0, 0));
    if !near(placed.x, 7) {
        printLn("ts");
        return;
    }
    let mem = Arena.create(8192);
    let src = "# j3mesh 1\n1\n1 2 3 0 1 0 0.5 0 0 0\n";
    let verts = mesh.parse(&mem, []u8 { ptr: src.ptr, len: src.len });
    if verts.len != 10 || !near(verts[0], 1) || !near(verts[1], 2) || !near(verts[6], 0.5) {
        printLn("mesh");
        return;
    }
    let again = mesh.parse(&mem, mesh.emit(&mem, verts));
    if again.len != 10 || !near(again[0], 1) || !near(again[6], 0.5) {
        printLn("round");
        return;
    }
    let src2 = "# j3mesh 2\n1\n1 2 3 0 1 0 0.5 0 0 0 0.25 0.75\n";
    let uv = mesh.parse(&mem, []u8 { ptr: src2.ptr, len: src2.len });
    if uv.len != 12 || !near(uv[10], 0.25) || !near(uv[11], 0.75) {
        printLn("uv");
        return;
    }
    if mesh.floatsPerVertex([]u8 { ptr: src2.ptr, len: src2.len }) != 12 {
        printLn("stride");
        return;
    }
    let back = mesh.parse(&mem, mesh.emit(&mem, uv));
    if back.len != 12 || !near(back[10], 0.25) || !near(back[11], 0.75) {
        printLn("uvround");
        return;
    }
    printLn("ok");
}
