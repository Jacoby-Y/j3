module voxel_grid;

use j3.io.printLn;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.voxel;
use j3.voxel.{ FACE_NZ, FACE_PY };

fn main() {
    let mem = Arena.create(4096);
    let cells = mem.alloc::<u8>(125);
    let i = 0;
    while i < 125 {
        cells[i] = 0;
        i += 1;
    }
    voxel.set(cells, 5, 5, 5, 2, 1, 2, 1);
    let hit = voxel.ray(cells, 5, 5, 5, Vec3.xyz(2.5, 1.5, 0.2), Vec3.xyz(0, 0, 1), 6);
    if !hit.ok || hit.x != 2 || hit.y != 1 || hit.z != 2 || hit.pz != 1 || hit.face != FACE_NZ {
        printLn("ray");
        return;
    }
    if voxel.countFaces(cells, 5, 5, 5) != 6 {
        printLn("faces");
        return;
    }
    if !voxel.overlaps(cells, 5, 5, 5, Vec3.xyz(2.1, 1.1, 2.1), Vec3.xyz(2.4, 1.4, 2.4)) {
        printLn("box");
        return;
    }
    if voxel.overlaps(cells, 5, 5, 5, Vec3.xyz(0.1, 0.1, 0.1), Vec3.xyz(0.4, 0.4, 0.4)) {
        printLn("empty");
        return;
    }
    let open = voxel.corners(cells, 5, 5, 5, 2, 1, 2, FACE_PY);
    if open.a != 3 || open.b != 3 || open.c != 3 || open.d != 3 {
        printLn("ao-open");
        return;
    }
    voxel.set(cells, 5, 5, 5, 1, 2, 2, 1);
    voxel.set(cells, 5, 5, 5, 2, 2, 1, 1);
    let crowded = voxel.corners(cells, 5, 5, 5, 2, 1, 2, FACE_PY);
    if crowded.a != 0 || crowded.b != 2 || crowded.d != 2 || crowded.c != 3 {
        printLn("ao-corner");
        return;
    }
    if voxel.shade(0) >= voxel.shade(3) {
        printLn("ao-shade");
        return;
    }
    printLn("ok");
}
