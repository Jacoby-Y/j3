module ray_aabb;

use j3.gfx;
use j3.io.printLn;
use j3.math.Vec3;

fn near(a: f32, b: f32): bool {
    let d = a - b;
    if d < 0 {
        d = f32(0) - d;
    }
    return d < 0.001;
}

fn main() {
    let lo = Vec3.xyz(f32(0) - f32(1), 0, f32(0) - f32(1));
    let hi = Vec3.xyz(1, 1, 1);
    let down = Vec3.xyz(0, f32(0) - f32(1), 0);
    let hit = gfx.rayAabb(Vec3.xyz(0, 2, 0), down, lo, hi, 10);
    if !hit.ok || !near(hit.t, 1) {
        printLn("front");
        return;
    }
    let up = Vec3.xyz(0, 1, 0);
    let miss = gfx.rayAabb(Vec3.xyz(0, 2, 0), up, lo, hi, 10);
    if miss.ok {
        printLn("miss");
        return;
    }
    let inside = gfx.rayAabb(Vec3.xyz(0, 0.5, 0), down, lo, hi, 10);
    if !inside.ok || !near(inside.t, 0) {
        printLn("inside");
        return;
    }
    let side = gfx.rayAabb(Vec3.xyz(5, 0.5, 0), down, lo, hi, 10);
    if side.ok {
        printLn("side");
        return;
    }
    let far = gfx.rayAabb(Vec3.xyz(0, 10, 0), down, lo, hi, 1);
    if far.ok {
        printLn("reach");
        return;
    }
    printLn("ok");
}
