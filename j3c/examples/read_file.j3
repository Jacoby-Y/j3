module examples.read_file;

use j3.io.{ printLn, readFile };
use j3.memory.Arena;
use j3.result.Result;

fn main() {
    let mem = Arena.create(4096);
    defer mem.destroy();
    match readFile("examples/read_file_data.txt", &mem) {
        Result.Ok(b) { printLn(`len={b.len}`); }
        Result.Err(_) { printLn("err"); }
    }
}
