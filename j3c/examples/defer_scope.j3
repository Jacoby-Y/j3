// Locks block-scoped defer (speculation.md). Not function-scoped.

module examples.defer_scope;

use j3.io.printLn;

fn main() {
    {
        defer printLn("inner");
        printLn("a");
    }
    printLn("b");

    for i in 0..3 {
        defer printLn("d");
        if i == 1 {
            break;
        }
        printLn(`i={i}`);
    }

    printLn("done");
}
