// Self-check for j3.scene3d.fpwalk: push-out, scaled boxes, walk-through, jump and gravity. No window.

module fpwalk_check;

use j3.scene3d.fpwalk;
use j3.scene3d.fpwalk.Walker;
use j3.io.printLn;
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use j3.sys.panic;

fn walk(w: &Walker, seconds: f32) {
    let t: f32 = 0;
    while t < seconds {
        fpwalk.step(w, 1, 0, 4, false, 0.05);
        t += 0.05;
    }
}

fn main() {
    let mem = Arena.create(65536);
    let w = fpwalk.empty(&mem, 4);
    w.pos = Vec3.xyz(-3, 0, 0);
    fpwalk.addBox(&w, Mat4.identity(), Vec3.xyz(-1, 0, -1), Vec3.xyz(1, 3, 1), 1, "crate");
    walk(&w, 2);
    if w.pos.x > -1.3 || w.pos.x < -1.4 { panic("walker didn't stop at the crate"); }

    fpwalk.walkThrough(&w, "crate");
    walk(&w, 1);
    if w.pos.x <= 0 { panic("walkThrough kept the crate"); }

    fpwalk.step(&w, 0, 0, 4, true, 0.05);
    if w.pos.y <= 0 { panic("jump didn't leave the floor"); }
    let i = 0;
    while i < 40 {
        fpwalk.step(&w, 0, 0, 4, false, 0.05);
        i += 1;
    }
    if w.pos.y != 0 { panic("walker didn't land"); }

    let big = fpwalk.empty(&mem, 1);
    big.pos = Vec3.xyz(-3, 0, 0);
    fpwalk.addBox(&big, Mat4.scale(2, 2, 2), Vec3.xyz(-0.5, -0.5, -0.5), Vec3.xyz(0.5, 0.5, 0.5), 2, "crate");
    walk(&big, 2);
    if big.pos.x > -1.3 || big.pos.x < -1.4 { panic("scaled box stopped the walker in the wrong place"); }
    printLn("ok");
}
