/// The J3 PNG decoder against Pillow's output (`png_check/*.rgba`), a stored-block round
/// trip through `savePng`, and a missing file. No GL. Run from `j3c/`.
module png_check;

use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode, rgba };
use j3.io.{ printLn, readFile };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;

fn sameBytes(a: []u8, b: []u8): bool {
    if a.len != b.len {
        return false;
    }
    let i = 0;
    while i < a.len {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

fn fixture(name: string, png: string, raw: string, w: i32, h: i32, arena: &Arena) {
    let c = canvas.loadPng(png, arena);
    if c.w != w || c.h != h {
        panic(name);
    }
    match readFile(raw, arena) {
        Result.Ok(want) {
            if !sameBytes(c.pixels, want) {
                panic(name);
            }
        }
        Result.Err(e) {
            panic(raw);
        }
    }
}

fn main() {
    let arena = Arena.create(16777216);
    fixture("rgb", "examples/png_check/rgb.png", "examples/png_check/rgb.rgba", 37, 23, &arena);
    fixture("pal", "examples/png_check/pal.png", "examples/png_check/pal.rgba", 19, 17, &arena);
    fixture("tiles", "examples/png_check/tiles.png", "examples/png_check/tiles.rgba", 64, 16, &arena);
    fixture("filt", "examples/png_check/filt.png", "examples/png_check/filt.rgba", 9, 10, &arena);
    // HDIST = 32: legal, though zlib never writes it.
    fixture("dist32", "examples/png_check/dist32.png", "examples/png_check/dist32.rgba", 1, 1, &arena);

    let c = Canvas.create(&arena, 5, 3, Mode.Pixel);
    c.fillRect(1, 0, 3, 2, rgba(200, 40, 10, 255));
    c.pixel(4, 2, rgba(1, 2, 3, 128));
    match c.savePng("/tmp/j3_png_check.png", &arena) {
        Result.Ok(n) {}
        Result.Err(e) {
            panic("savePng");
        }
    }
    let back = canvas.loadPng("/tmp/j3_png_check.png", &arena);
    if back.w != 5 || back.h != 3 || !sameBytes(back.pixels, c.pixels) {
        panic("round trip");
    }
    let missing = canvas.loadPng("/nonexistent.png", &arena);
    if missing.w != 0 {
        panic("missing file");
    }
    printLn("ok");
}
