// Checks gfx.boxInClip, the frustum test behind culling, without a GL context. Prints "ok".
module cull_check;

use j3.gfx;
use j3.io.printLn;
use j3.math.{ Mat4, Vec3 };
use j3.sys.panic;

fn check(ok: bool, msg: string) {
    if !ok { panic(msg); }
}

/// A unit box moved to `at` and scaled by `s`, seen through `clip`.
fn seen(clip: Mat4, at: Vec3, s: f32): bool {
    let model = Mat4.translate(at.x, at.y, at.z).mul(Mat4.scale(s, s, s));
    return gfx.boxInClip(clip.mul(model), Vec3.xyz(-0.5, -0.5, -0.5), Vec3.xyz(0.5, 0.5, 0.5));
}

fn main() {
    // Camera at z=5 looking down -z.
    let view = Mat4.lookAt(Vec3.xyz(0, 0, 5), Vec3.xyz(0, 0, 0), Vec3.xyz(0, 1, 0));
    let cam = Mat4.perspective(1, 1.6, 0.1, 100).mul(view);
    check(seen(cam, Vec3.xyz(0, 0, 0), 1), "in front");
    check(!seen(cam, Vec3.xyz(0, 0, 10), 1), "behind the eye");
    check(!seen(cam, Vec3.xyz(-100, 0, 0), 1), "far to the left");
    check(!seen(cam, Vec3.xyz(0, 50, 0), 1), "above");
    check(!seen(cam, Vec3.xyz(0, 0, -200), 1), "past the far plane");
    check(seen(cam, Vec3.xyz(0, 0, -94), 1), "just inside the far plane");
    check(seen(cam, Vec3.xyz(0, 0, 5), 1), "the eye inside the box");
    check(seen(cam, Vec3.xyz(0, 0, 0), 2000), "a box around the whole view");
    check(seen(cam, Vec3.xyz(3.2, 0, 0), 1), "poking in at the right edge");
    // Shadow pass: an orthographic light box.
    let light = Mat4.ortho(-10, 10, -10, 10, -10, 10);
    check(seen(light, Vec3.xyz(9, 0, 0), 1), "inside the light box");
    check(!seen(light, Vec3.xyz(20, 0, 0), 1), "outside the light box");
    printLn("ok");
}
