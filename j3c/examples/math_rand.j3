module math_rand;

use j3.io.printLn;
use j3.math.{ sin, cos, clamp, lerp, Vec2 };
use j3.rand.Rng;

fn main() {
    if sin(0) != 0 {
        printLn("sin");
        return;
    }
    if cos(0) != 1 {
        printLn("cos");
        return;
    }
    if clamp(2, 0, 1) != 1 {
        printLn("clamp");
        return;
    }
    if lerp(0, 10, 0.5) != 5 {
        printLn("lerp");
        return;
    }
    let u = Vec2.fromAngle(0);
    if u.x != 1 || u.y != 0 {
        printLn("angle");
        return;
    }
    let rng = Rng.new(1);
    printLn(`n={rng.intRange(0, 100)}`);
}
