module ecs_basic;

use j3.ecs.{ Column, Commands, Ecs, Entity, Events };
use j3.io.printLn;
use j3.memory.Arena;

struct Store {
    pos: Column<int>;
    hp: Column<int>;
}

fn main() {
    let mem = Arena.create(64 * 1024);
    defer mem.destroy();

    let ecs = Ecs.create(&mem, 8);
    let store = Store {
        pos: Column<int>.new(&mem),
        hp: Column<int>.new(&mem),
    };
    let cmds = Commands.new(&mem);
    let ev = Events<int>.new(&mem);

    let a = ecs.spawn();
    let b = ecs.spawn();
    store.pos.insert(a, 1);
    store.pos.insert(b, 2);
    store.hp.insert(a, 10);

    if ecs.len() != 2 {
        printLn("len");
        return;
    }
    if !ecs.isAlive(a) || !store.pos.has(a) {
        printLn("alive");
        return;
    }
    if store.pos.get(a) != 1 || store.pos.get(b) != 2 || store.hp.get(a) != 10 {
        printLn("get");
        return;
    }
    if a == b {
        printLn("eq");
        return;
    }

    cmds.despawn(b);
    cmds.flush(&ecs);
    if ecs.isAlive(b) {
        printLn("despawn");
        return;
    }
    if ecs.len() != 1 {
        printLn("after");
        return;
    }

    ev.send(7);
    if ev.len != 1 || ev.get(0) != 7 {
        printLn("ev");
        return;
    }
    ev.clear();
    if ev.len != 0 {
        printLn("clear");
        return;
    }

    let c = ecs.spawn();
    if c.id != b.id {
        printLn("reuse");
        return;
    }
    if c.gen == b.gen || a == c {
        printLn("gen");
        return;
    }
    if store.pos.has(c) {
        printLn("stale");
        return;
    }
    store.pos.insert(c, 9);
    if !store.pos.has(c) || store.pos.get(c) != 9 {
        printLn("reinsert");
        return;
    }
    let none = Entity.none();
    if none.id == a.id {
        printLn("none");
        return;
    }
    printLn("ok");
}
