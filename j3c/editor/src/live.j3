// Commands from `j3c -e mcp` while the editor is open: the same `tool` and `render` requests the
// headless modes run, applied to the open tab so the edit shows at once and is one undo step
// (nothing is saved until you, or a `save` command, save). The host appends them to the
// events file as `cmd <id> <scene> <request...>`; replies go to stdout as
// `J3EDITOR REPLY <id> <line>` lines ending with `J3EDITOR REPLY <id> end`, and the host
// files them for the MCP server. A scene not open in a tab gets `defer`, and the server edits
// its file instead.

module j3_editor.live;

use j3.game;
use j3.gfx;
use j3.gfx.Target;
use j3.io.printLn;
use j3.math.Mat4;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ Scene, INSTANCE, MESH };
use j3.text.{ Text, same };
use j3_editor.console.say;
use j3_editor.files.saveScene;
use j3_editor.history.{ modified, restore, snapshot };
use j3_editor.render.{ Lens, drawShot, lensFor, parseShot, savePng };
use j3_editor.selection.select;
use j3_editor.tabs.switchTab;
use j3_editor.tool;
use j3_editor.tool.{ Outcome, fields, resolve };
use j3_editor.types.World;
use j3_editor.util.cut;

/// Run command `request` from MCP request `id` on scene `path`.
pub fn liveCommand(w: &World, id: string, path: string, request: string) {
    let out = Text.new(scratch(0));
    let tab = tabOf(w, path);
    let words = fields(request, scratch(0));
    let op = words[0];
    w.agentCount += 1;
    w.agentAt = game.ticks();
    if w.agentOff {
        out.pushStr("err\tthe person turned agent access off in the editor (Agent button in its toolbar)\n");
    } else if tab < 0 {
        out.pushStr("defer\n");
    } else if same(op, "render") {
        renderTab(w, tab, cut(request, op.len, request.len), &out);
    } else if same(op, "select") {
        selectIn(w, tab, request, &out);
    } else if same(op, "save") {
        saveTab(w, tab, &out);
    } else if same(op, "list") || same(op, "get") || same(op, "check") {
        tool.apply(sceneOf(w, tab), &w.catalog, path, request, &out);
    } else {
        edit(w, tab, request, &out);
    }
    reply(id, out.str());
}

/// Index of the scene tab showing `path`, or -1.
fn tabOf(w: &World, path: string): int {
    if !w.matTab && same(w.path, path) { return w.active; }
    let i = 0;
    while i < w.tabCount {
        if i != w.active && w.tabs[i].mat as ptr == 0 && same(w.tabs[i].path, path) { return i; }
        i += 1;
    }
    return -1;
}

/// The live scene of tab `i`: the active one lives in `World`, the others in their tab.
fn sceneOf(w: &World, i: int): &Scene {
    if i == w.active { return &w.scene; }
    return &w.tabs[i].scene;
}

fn reply(id: string, text: string) {
    let start = 0;
    let i = 0;
    while i <= text.len {
        if i == text.len || text[i] == 10 {
            if i > start {
                let t = Text.new(scratch(0));
                t.pushStr("J3EDITOR REPLY ");
                t.pushStr(id);
                t.push(9);
                t.pushStr(cut(text, start, i));
                printLn(t.str());
            }
            start = i + 1;
        }
        i += 1;
    }
    let end = Text.new(scratch(0));
    end.pushStr("J3EDITOR REPLY ");
    end.pushStr(id);
    end.pushStr("\tend");
    printLn(end.str());
}

/// Apply an editing request in tab `i` as one undo step, then put the shown tab back.
fn edit(w: &World, i: int, request: string, out: &Text) {
    let back = w.active;
    switchTab(w, i);
    let result = applyHere(w, request, out);
    if result.ok && result.changed {
        let t = Text.new(scratch(0));
        t.pushStr("Agent: ");
        let words = fields(request, scratch(0));
        t.pushStr(words[0]);
        if result.focus != 0 {
            t.push(32);
            t.pushStr(tool.pathOf(&w.scene, result.focus, scratch(0)));
        }
        t.pushStr(" (Ctrl+Z to undo)");
        say(w, t.str());
    }
    switchTab(w, back);
}

/// Apply a `tool` request (several joined by byte 30 are fine) to the active tab as one
/// undo step. A request that fails partway leaves the scene as it was.
pub fn applyHere(w: &World, request: string, out: &Text): Outcome {
    // Close the person's own pending edit first so undo keeps the two apart.
    if w.pendingUndo { snapshot(w); }
    let gesture = w.editGesture;
    let wasDirty = w.dirty;
    w.editGesture = false;
    let result = tool.apply(&w.scene, &w.catalog, w.path, request, out);
    if !result.ok {
        // A request that failed partway leaves the scene as it was.
        if result.changed { restore(w, &w.candidate); }
        w.dirty = wasDirty;
    } else if result.changed {
        if result.reload != 0 { scene3d.reload(&w.scene, result.reload); }
        // New meshes (scatter makes many) load, and placed scenes rebuild.
        let placed = false;
        let k = 0;
        while k < w.scene.len {
            let n = w.scene.nodes[k];
            if n.owner == 0 && n.kind == MESH && n.asset.len > 0 && n.gpu.vao == 0 { scene3d.reload(&w.scene, n.id); }
            if n.owner == 0 && n.kind == INSTANCE { placed = true; }
            k += 1;
        }
        if placed { scene3d.refresh(&w.scene, w.path); }
        w.worldsReady = false;
        modified(w);
        snapshot(w);
        if result.focus != 0 { select(w, result.focus); }
    }
    w.editGesture = gesture;
    return result;
}

fn selectIn(w: &World, i: int, request: string, out: &Text) {
    let args = fields(request, scratch(0));
    if args.len < 2 {
        out.pushStr("err\tselect needs an object\n");
        return;
    }
    switchTab(w, i);
    let at = resolve(&w.scene, args[1], out);
    if at < 0 { return; }
    select(w, w.scene.nodes[at].id);
    out.pushStr("ok\tselected ");
    out.pushStr(tool.pathOf(&w.scene, w.scene.nodes[at].id, scratch(0)));
    out.push(10);
}

fn saveTab(w: &World, i: int, out: &Text) {
    let back = w.active;
    switchTab(w, i);
    if saveScene(w) {
        out.pushStr("ok\tsaved ");
        out.pushStr(w.path);
        out.push(10);
    } else {
        out.pushStr("err\tcould not write ");
        out.pushStr(w.path);
        out.push(10);
    }
    switchTab(w, back);
}

/// Draw tab `i`'s scene, as it is now (unsaved edits too), to a PNG.
fn renderTab(w: &World, i: int, options: string, out: &Text) {
    let shot = parseShot(options);
    let scene = sceneOf(w, i);
    let lens = Lens { cam: w.cam, fov: 60, near: 0.05, far: 1000, label: "", fog: true, camera: 0 };
    if !lensFor(scene, shot, &lens, out) { return; }
    let select = 0;
    if shot.select.len > 0 {
        let at = resolve(scene, shot.select, out);
        if at < 0 { return; }
        select = scene.nodes[at].id;
    }
    let matrices = scratch(0).alloc::<Mat4>(scene.len);
    scene3d.worlds(scene, matrices);
    let target = gfx.makeTarget(shot.w, shot.h);
    drawShot(scene, matrices, lens, target, select);
    if savePng(target, shot.out) {
        out.pushStr("ok\t");
        out.pushStr(shot.out);
        out.push(9);
        out.pushStr(lens.label);
        out.push(10);
    } else {
        out.pushStr("err\tcould not write ");
        out.pushStr(shot.out);
        out.push(10);
    }
    gfx.freeTarget(&target);
}
