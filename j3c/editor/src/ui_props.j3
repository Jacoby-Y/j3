// Scene props in the inspector: declaring them on the open scene (shown with nothing
// selected), and setting them on a placed copy of a scene that declares them.

module j3_editor.ui_props;

use j3.scene3d.editor.props;
use j3.scene3d.editor.props.PropDecl;
use j3.memory.{ Arena, scratch };
use j3.data.save;
use j3.scene3d;
use j3.scene3d.Node;
use j3.text.{ Text, same };
use j3.ui.Ui;
use j3_editor.console.say;
use j3_editor.history.modified;
use j3_editor.types.World;
use j3_editor.util.{ endsWith, nextOption, remember, setText };
use j3_editor.widgets.{ caption, section, toolButton };

const KINDS: string = "float|int|bool|text|material|mesh|scene";

/// Refill the prop text fields when the inspector starts showing something else.
fn sync(w: &World, owner: int, count: int): bool {
    if w.propFor == owner && w.propTab == w.active && w.propCount == count { return false; }
    w.propFor = owner;
    w.propTab = w.active;
    w.propCount = count;
    return true;
}

/// Declared props of the open scene: type, default, remove; and a row to add one.
pub @j3ui sceneProps(ui: &Ui, w: &World) {
    section(ui, "PROPS");
    caption(ui, "Settings each placed copy can change.");
    let decls = props.propsIn(&w.scene.data, scratch(0));
    if sync(w, -1, decls.len) {
        let k = 0;
        while k < decls.len && k < w.propEdits.len {
            setText(&w.propEdits[k], decls[k].value);
            k += 1;
        }
    }
    let j = 0;
    while j < decls.len && j < w.propEdits.len {
        let d = decls[j];
        ui.pushId(j);
        let head = Text.new(scratch(0));
        head.pushStr(d.name);
        head.pushStr(" default");
        caption(ui, head.str());
        row() {
            if toolButton(ui, d.kind, false) {
                props.declareProp(&w.scene, d.name, nextOption(KINDS, d.kind), w.propEdits[j].str());
                modified(w);
            }
            if ui.field(d.name, &w.propEdits[j]) {
                props.declareProp(&w.scene, d.name, d.kind, w.propEdits[j].str());
                modified(w);
            }
            if ui.button("Rename") {
                w.propRenaming = j + 1;
                setText(&w.propName, d.name);
            }
            if ui.button("x") {
                props.dropProp(&w.scene, d.name);
                w.propCount = -1;
                modified(w);
            }
        }
        ui.popId();
        j += 1;
    }
    if w.propRenaming > decls.len { w.propRenaming = 0; }
    if w.propRenaming > 0 {
        let old = decls[w.propRenaming - 1].name;
        let ask = Text.new(scratch(0));
        ask.pushStr("Rename ");
        ask.pushStr(old);
        ask.pushStr(" to");
        caption(ui, ask.str());
        row() {
            field("prop_name", &w.propName);
            if ui.button("Rename") {
                let fresh = w.propName.str();
                if fresh.len == 0 || !plainName(fresh) {
                    say(w, "Prop names use letters, digits, and _");
                } else if same(fresh, old) {
                    w.propRenaming = 0;
                } else if declared(decls, fresh) {
                    say(w, "This scene already has that prop");
                } else {
                    renameEverywhere(w, old, fresh);
                    setText(&w.propName, "");
                    w.propRenaming = 0;
                    w.propCount = -1;
                }
            }
            if ui.button("Cancel") {
                setText(&w.propName, "");
                w.propRenaming = 0;
            }
        }
        return;
    }
    caption(ui, "New prop name");
    row() {
        field("prop_name", &w.propName);
        if ui.button("Add") {
            let name = w.propName.str();
            if name.len == 0 || !plainName(name) {
                say(w, "Prop names use letters, digits, and _");
            } else if declared(decls, name) {
                say(w, "This scene already has that prop");
            } else {
                props.declareProp(&w.scene, name, "float", "0");
                setText(&w.propName, "");
                w.propCount = -1;
                modified(w);
            }
        }
    }
}

/// Rename prop `old` of the open scene, and the values scenes that place it set: open tabs
/// in memory (saved with them), other scene files on disk.
// ponytail: other tabs change without an undo step of their own; undo here restores only the declaration.
fn renameEverywhere(w: &World, old: string, name: string) {
    props.renameProp(&w.scene, "", old, name);
    modified(w);
    let files = 0;
    let a = 0;
    while a < w.assetCount {
        let path = w.assetPaths[a];
        if endsWith(path, ".j3scene") && !same(path, w.path) {
            let tab = -1;
            let i = 0;
            while i < w.tabCount {
                if same(w.tabs[i].path, path) { tab = i; }
                i += 1;
            }
            if tab >= 0 {
                if props.renameProp(&w.tabs[tab].scene, w.path, old, name) > 0 {
                    w.tabs[tab].dirty = true;
                    files += 1;
                }
            } else {
                let s = scene3d.read(path, scratch(0));
                if props.renameProp(&s, w.path, old, name) > 0 && scene3d.store(&s, path) {
                    remember(w, path);
                    files += 1;
                }
            }
        }
        a += 1;
    }
    let t = Text.new(scratch(0));
    t.pushStr("Renamed ");
    t.pushStr(old);
    t.pushStr(" to ");
    t.pushStr(name);
    if files > 0 {
        t.pushStr("; updated ");
        t.pushInt(files);
        if files == 1 { t.pushStr(" scene that places this one"); } else { t.pushStr(" scenes that place this one"); }
    }
    say(w, t.str());
}

fn plainName(s: string): bool {
    let i = 0;
    while i < s.len {
        let b = s[i];
        if !((b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95) { return false; }
        i += 1;
    }
    return true;
}

fn declared(decls: []PropDecl, name: string): bool {
    let i = 0;
    while i < decls.len {
        if same(decls[i].name, name) { return true; }
        i += 1;
    }
    return false;
}

/// The props of the scene copy `n` places, with this copy's values; Revert drops them.
pub @j3ui copyProps(ui: &Ui, w: &World, n: &Node) {
    let decls = props.declaredProps(n.scene, scratch(0));
    if decls.len == 0 { return; }
    section(ui, "PROPS");
    let refill = sync(w, n.id, decls.len);
    let any = false;
    let j = 0;
    while j < decls.len && j < w.propEdits.len {
        let d = decls[j];
        let set = scene3d.propSet(&w.scene, n.id, d.name);
        if set { any = true; }
        let value = d.value;
        if set { value = scene3d.prop(&w.scene, n.id, d.name, d.value); }
        if refill { setText(&w.propEdits[j], value); }
        ui.pushId(j);
        if same(d.kind, "float") || same(d.kind, "int") {
            let v = save.parseFloat(value as []u8, 0);
            ui.whole = same(d.kind, "int");
            if ui.number(d.name, &v, 0.05) {
                let t = Text.new(scratch(0));
                if same(d.kind, "int") { t.pushInt(int(v + 0.5)); } else { t.pushFloat(v); }
                props.setProp(&w.scene, n.id, d.name, t.str());
                modified(w);
            }
            ui.whole = false;
        } else if same(d.kind, "bool") {
            let on = same(value, "true") || same(value, "1");
            if ui.toggle(d.name, &on) {
                props.setProp(&w.scene, n.id, d.name, if on { "true" } else { "false" });
                modified(w);
            }
        } else {
            let head = Text.new(scratch(0));
            head.pushStr(d.name);
            head.pushStr(" (");
            head.pushStr(d.kind);
            head.pushStr(")");
            caption(ui, head.str());
            if ui.field(d.name, &w.propEdits[j]) {
                props.setProp(&w.scene, n.id, d.name, w.propEdits[j].str());
                modified(w);
            }
        }
        ui.popId();
        j += 1;
    }
    if any && ui.button("Revert props to the scene's defaults") {
        props.clearProp(&w.scene, n.id, "");
        w.propCount = -1;
        modified(w);
    }
}
