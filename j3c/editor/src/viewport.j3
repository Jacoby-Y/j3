// The 3D pass: grid, markers, frustums, lights, and the camera preview.

module j3_editor.viewport;

use j3.gfx;
use j3.math.{ Mat4, Vec2, Vec3, cos, sin, tan, PI };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Node, Env, GROUP, MESH, CAMERA, INSTANCE, LIGHT };
use j3_editor.cameras.{ cameraOrbit, previewBox, previewCam, syncViewCam };
use j3_editor.gizmo.cachedWorlds;
use j3_editor.layout.{ viewMin, viewSize };
use j3_editor.shared.shared;
use j3_editor.selection.isPicked;
use j3_editor.types.{ RING, World };

/// What the selected camera sees, in the viewport's top-right corner.
pub fn drawCameraPreview(w: &World, matrices: []Mat4, env: Env) {
    let id = previewCam(w);
    if id == 0 { return; }
    let n = w.scene.nodes[scene3d.index(&w.scene, id)];
    let main = gfx.viewState();
    let size = Vec2 { x: 0, y: 0 };
    let at = previewBox(&size);
    gfx.setViewRect(at.x, at.y, size.x, size.y);
    gfx.setOrtho(0);
    gfx.setFov(n.fov);
    gfx.setClip(n.near, n.far);
    gfx.cameraPass(cameraOrbit(w, id), env.sunDir, env.sky, env.sunColor);
    scene3d.drawWith(&w.scene, matrices);
    gfx.setViewState(main);
}

pub fn line(a: Vec3, b: Vec3, c: Vec3) { gfx.drawLine(a, b, c); }

pub fn drawGrid(step: f32) {
    let k = -20;
    let far = 20 * step;
    while k <= 20 {
        let v = f32(k) * step;
        let tint = Vec3.xyz(0.27, 0.29, 0.34);
        if (k / 5) * 5 == k { tint = Vec3.xyz(0.37, 0.39, 0.45); }
        let tintX = tint;
        let tintZ = tint;
        if k == 0 {
            tintX = Vec3.xyz(0.3, 0.45, 0.85);
            tintZ = Vec3.xyz(0.85, 0.3, 0.3);
        }
        // Line along Z at x = v (the x = 0 line is the Z axis), then along X at z = v.
        line(Vec3.xyz(v, 0, 0 - far), Vec3.xyz(v, 0, far), tintX);
        line(Vec3.xyz(0 - far, 0, v), Vec3.xyz(far, 0, v), tintZ);
        k += 1;
    }
}

/// Wire box around a mesh's local bounds.
pub fn drawBox(model: Mat4, lo: Vec3, hi: Vec3, c: Vec3) {
    let pad = (hi - lo) * 0.02;
    let a = lo - pad;
    let b = hi + pad;
    let p0 = model.transformPoint(Vec3.xyz(a.x, a.y, a.z));
    let p1 = model.transformPoint(Vec3.xyz(b.x, a.y, a.z));
    let p2 = model.transformPoint(Vec3.xyz(b.x, a.y, b.z));
    let p3 = model.transformPoint(Vec3.xyz(a.x, a.y, b.z));
    let p4 = model.transformPoint(Vec3.xyz(a.x, b.y, a.z));
    let p5 = model.transformPoint(Vec3.xyz(b.x, b.y, a.z));
    let p6 = model.transformPoint(Vec3.xyz(b.x, b.y, b.z));
    let p7 = model.transformPoint(Vec3.xyz(a.x, b.y, b.z));
    line(p0, p1, c); line(p1, p2, c); line(p2, p3, c); line(p3, p0, c);
    line(p4, p5, c); line(p5, p6, c); line(p6, p7, c); line(p7, p4, c);
    line(p0, p4, c); line(p1, p5, c); line(p2, p6, c); line(p3, p7, c);
}

/// Wire frustum one unit deep, looking down local -Z like the game camera.
pub fn drawFrustum(model: Mat4, fovDeg: f32, c: Vec3) {
    let half = tan(fovDeg * PI / 360);
    let depth: f32 = 1.2;
    let hy = half * depth;
    let g = shared();
    let hx = hy * g.aspect;
    let eye = model.transformPoint(Vec3.xyz(0, 0, 0));
    let a = model.transformPoint(Vec3.xyz(-hx, -hy, -depth));
    let b = model.transformPoint(Vec3.xyz(hx, -hy, -depth));
    let d = model.transformPoint(Vec3.xyz(hx, hy, -depth));
    let e = model.transformPoint(Vec3.xyz(-hx, hy, -depth));
    let top = model.transformPoint(Vec3.xyz(0, hy * 1.5, -depth));
    line(eye, a, c); line(eye, b, c); line(eye, d, c); line(eye, e, c);
    line(a, b, c); line(b, d, c); line(d, e, c); line(e, a, c);
    line(e, top, c); line(top, d, c);
}

pub fn drawMarkers(w: &World) {
    let pick = Vec3.xyz(1, 0.65, 0.15);
    let matrices = cachedWorlds(w);
    let i = 0;
    while i < w.scene.len {
        let n = w.scene.nodes[i];
        // An instance lights up with everything it placed.
        let chosen = isPicked(w, n.id) || (n.owner != 0 && isPicked(w, n.owner));
        let hovered = n.id == w.hoverNode || (n.owner != 0 && n.owner == w.hoverNode);
        if n.kind != CAMERA && n.kind != LIGHT && !((n.kind == GROUP && n.owner == 0) || n.kind == INSTANCE)
            && !(n.kind == MESH && (chosen || hovered)) { i += 1; continue; }
        if n.id == w.viewCam { i += 1; continue; }
        let model = matrices[i];
        let tint = Vec3.xyz(0.6, 0.62, 0.7);
        if n.kind == CAMERA { tint = Vec3.xyz(0.85, 0.75, 0.4); }
        if n.kind == INSTANCE { tint = Vec3.xyz(0.75, 0.52, 0.92); }
        if chosen { tint = pick; }
        if n.kind == CAMERA {
            drawFrustum(model, n.fov, tint);
        } else if n.kind == LIGHT {
            drawLight(model.transformPoint(Vec3.zero()), n, chosen);
        } else if (n.kind == GROUP && n.owner == 0) || n.kind == INSTANCE {
            let o = model.transformPoint(Vec3.xyz(0, 0, 0));
            line(o - Vec3.xyz(0.3, 0, 0), o + Vec3.xyz(0.3, 0, 0), tint);
            line(o - Vec3.xyz(0, 0.3, 0), o + Vec3.xyz(0, 0.3, 0), tint);
            line(o - Vec3.xyz(0, 0, 0.3), o + Vec3.xyz(0, 0, 0.3), tint);
        } else if n.kind == MESH && chosen {
            drawBox(model, n.boundLo, n.boundHi, tint);
        } else if n.kind == MESH && hovered {
            drawBox(model, n.boundLo, n.boundHi, Vec3.xyz(0.55, 0.62, 0.78));
        }
        i += 1;
    }
}

/// A light: a star in its color, and a ring on the ground showing how far it reaches.
pub fn drawLight(o: Vec3, n: Node, chosen: bool) {
    let c = n.color;
    if chosen { c = Vec3.xyz(1, 0.65, 0.15); }
    let r: f32 = 0.25;
    line(o - Vec3.xyz(r, 0, 0), o + Vec3.xyz(r, 0, 0), c);
    line(o - Vec3.xyz(0, r, 0), o + Vec3.xyz(0, r, 0), c);
    line(o - Vec3.xyz(0, 0, r), o + Vec3.xyz(0, 0, r), c);
    line(o - Vec3.xyz(r, r, 0) * 0.7, o + Vec3.xyz(r, r, 0) * 0.7, c);
    line(o - Vec3.xyz(r, 0 - r, 0) * 0.7, o + Vec3.xyz(r, 0 - r, 0) * 0.7, c);
    if !chosen { return; }
    let ground = Vec3.xyz(o.x, 0, o.z);
    let k = 0;
    while k < RING {
        let a = f32(k) * PI * 2 / f32(RING);
        let b = f32(k + 1) * PI * 2 / f32(RING);
        line(ground + Vec3.xyz(cos(a), 0, sin(a)) * n.range, ground + Vec3.xyz(cos(b), 0, sin(b)) * n.range, c * 0.6);
        k += 1;
    }
}

pub fn drawViewport(w: &World) {
    let matrices = cachedWorlds(w);
    let lo = viewMin();
    let size = viewSize();
    gfx.setViewRect(lo.x, lo.y, size.x, size.y);
    let env = scene3d.environment(&w.scene);
    gfx.setFog(env.fogStart, env.fogEnd);
    gfx.setClip(0.05, 1000);
    gfx.setFov(0);
    gfx.setOrtho(0);
    if w.viewCam != 0 { syncViewCam(w); }
    // Same size as the perspective view at the orbit target (tan 30 degrees).
    if w.ortho && w.viewCam == 0 { gfx.setOrtho(w.cam.radius * 0.577); }
    let cam = scene3d.index(&w.scene, w.viewCam);
    if cam >= 0 {
        gfx.setFov(w.scene.nodes[cam].fov);
        gfx.setClip(w.scene.nodes[cam].near, w.scene.nodes[cam].far);
    }
    let r = env.shadowSize;
    gfx.shadowPass(env.sunDir, Vec3.xyz(0 - r, 0 - r, 0 - r), Vec3.xyz(r, r, r));
    if env.shadows { scene3d.drawWith(&w.scene, matrices); }
    // Without lights of its own, a soft headlight keeps faces turned from the sun readable.
    if scene3d.lights(&w.scene) == 0 {
        gfx.light(0, w.cam.eye(), Vec3.xyz(0.22, 0.23, 0.26), w.cam.radius * 6 + 20);
    }
    // Looking through a camera shows its effects; markers and gizmos stay crisp on top.
    // ponytail: the corner camera preview skips effects (one set of post targets, sized once).
    let fx = w.viewCam != 0 && scene3d.beginEffects(&w.scene, w.viewCam);
    gfx.cameraPass(w.cam, env.sunDir, env.sky, env.sunColor);
    scene3d.drawSky(&w.scene);
    drawGrid(w.gridStep);
    scene3d.drawWith(&w.scene, matrices);
    if fx { scene3d.endEffects(&w.scene, w.viewCam); }
    drawMarkers(w);
    drawCameraPreview(w, matrices, env);
}
