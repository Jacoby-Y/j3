// Bundled desktop scene editor. Run by `j3c editor` with the project as cwd.

module j3_editor.session;

use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.data.save;
use j3.text.{ Text, same };
use j3_editor.assets.foldAsset;
use j3_editor.materials.setPreviewShape;
use j3_editor.prefs.SESSION;
use j3_editor.scenes.{ openMaterialTab, openScene };
use j3_editor.selection.select;
use j3_editor.shared.shared;
use j3_editor.tabs.{ moveTab, stash, tabKey, tidyPanes, unstash };
use j3_editor.types.{ MAX_PANES, PREVIEW_SPHERE, World };
use j3_editor.util.{ fileExists, isOnline, own, positive };
use j3_editor.ui_online.openOnlineTab;

/// Reopen the last session's tabs over the startup scene, which stays open.
pub fn loadSession(w: &World) {
    let g = shared();
    let p = save.load(SESSION, scratch(0));
    let count = save.getInt(&p, "tab.count", 0);
    let panes = save.getInt(&p, "panes", 1);
    g.consoleOpen = save.getInt(&p, "console.open", 0) != 0;
    g.consoleHeight = positive(save.getFloat(&p, "console.h", 200), 200);
    if panes >= 1 && panes <= MAX_PANES {
        let total: f32 = 0;
        let pane = 0;
        while pane < panes {
            let pk = Text.new(scratch(1));
            pk.pushStr("pane.");
            pk.pushInt(pane);
            g.paneShare[pane] = save.getFloat(&p, pk.str(), 1);
            if g.paneShare[pane] < 0.05 { g.paneShare[pane] = 0.05; }
            total += g.paneShare[pane];
            pane += 1;
        }
        pane = 0;
        while pane < panes {
            g.paneShare[pane] = g.paneShare[pane] / total;
            pane += 1;
        }
        g.panes = panes;
    }
    let first = own(scratch(1), w.path);
    let fronts = scratch(1).alloc::<string>(MAX_PANES);
    let f0 = 0;
    while f0 < MAX_PANES {
        fronts[f0] = "";
        f0 += 1;
    }
    let firstAt = -1;
    let i = 0;
    while i < count {
        let k = Text.new(scratch(1));
        k.pushStr("tab.");
        k.pushInt(i);
        k.push(46);
        let mark = k.len();
        tabKey(&k, mark, "path");
        let path = own(scratch(1), save.getStr(&p, k.str(), ""));
        tabKey(&k, mark, "material");
        let material = save.getInt(&p, k.str(), 0) != 0;
        if path.len > 0 && (fileExists(path) || isOnline(path)) {
            if isOnline(path) { openOnlineTab(w); } else if material { openMaterialTab(w, path); } else { openScene(w, path); }
            if same(path, first) { firstAt = w.active; }
            tabKey(&k, mark, "cam.x");
            w.cam.target.x = save.getFloat(&p, k.str(), w.cam.target.x);
            tabKey(&k, mark, "cam.y");
            w.cam.target.y = save.getFloat(&p, k.str(), w.cam.target.y);
            tabKey(&k, mark, "cam.z");
            w.cam.target.z = save.getFloat(&p, k.str(), w.cam.target.z);
            tabKey(&k, mark, "cam.yaw");
            w.cam.yaw = save.getFloat(&p, k.str(), w.cam.yaw);
            tabKey(&k, mark, "cam.pitch");
            w.cam.pitch = save.getFloat(&p, k.str(), w.cam.pitch);
            tabKey(&k, mark, "cam.radius");
            w.cam.radius = positive(save.getFloat(&p, k.str(), w.cam.radius), w.cam.radius);
            tabKey(&k, mark, "ortho");
            w.ortho = save.getInt(&p, k.str(), 0) != 0;
            tabKey(&k, mark, "axis");
            w.axisView = save.getInt(&p, k.str(), 0) != 0;
            if material {
                tabKey(&k, mark, "shape");
                setPreviewShape(w, save.getInt(&p, k.str(), PREVIEW_SPHERE));
            }
            tabKey(&k, mark, "folds");
            let folds = save.getInt(&p, k.str(), 0);
            let f = 0;
            while f < folds {
                tabKey(&k, mark, "fold.");
                k.pushInt(f);
                let at = scene3d.index(&w.scene, save.getInt(&p, k.str(), 0));
                if at >= 0 { w.scene.nodes[at].collapsed = true; }
                f += 1;
            }
            tabKey(&k, mark, "selected");
            select(w, save.getInt(&p, k.str(), 0));
            tabKey(&k, mark, "previewLock");
            w.previewLock = save.getInt(&p, k.str(), 0);
            tabKey(&k, mark, "pane");
            let tabPane = save.getInt(&p, k.str(), 0);
            if tabPane < 0 || tabPane >= g.panes { tabPane = 0; }
            w.tabs[w.active].pane = tabPane;
            tabKey(&k, mark, "front");
            if save.getInt(&p, k.str(), 0) != 0 { fronts[tabPane] = w.tabs[w.active].path; }
        }
        i += 1;
    }
    // Keep the startup scene where it was in the saved order.
    if firstAt > 0 { moveTab(w, 0, firstAt); }
    stash(w);
    i = 0;
    while i < w.tabCount {
        let t = w.tabs[i];
        w.tabs[i].front = fronts[t.pane].len > 0 && fronts[t.pane].ptr == t.path.ptr;
        i += 1;
    }
    let active = save.getInt(&p, "tab.active", 0);
    if count > 0 && active >= 0 && active < w.tabCount { unstash(w, active); }
    tidyPanes(w);
    let assetFolds = save.getInt(&p, "assets.folds", 0);
    i = 0;
    while i < assetFolds {
        let fk = Text.new(scratch(1));
        fk.pushStr("assets.fold.");
        fk.pushInt(i);
        foldAsset(w, save.getStr(&p, fk.str(), ""), true);
        i += 1;
    }
}
