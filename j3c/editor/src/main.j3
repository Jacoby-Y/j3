// Bundled desktop scene editor. Run by `j3c editor` with the project as cwd.

module j3_editor;

use j3.app.App;
use j3.game;
use j3.game.Font;
use j3.gfx;
use j3.gfx.{ Orbit, Tex };
use j3.io.printLn;
use j3.math.{ Mat4, Vec2, Vec3 };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Node, MESH };
use j3.data.save;
use j3.ui;
use j3.ui.Ui;
use j3.sys;
use j3.text.same;
use j3_editor.tool;
use j3_editor.render;
use j3_editor.console.say;
use j3_editor.files.readAssets;
use j3_editor.history.{ deltaStack, emptySnap };
use j3_editor.input.input;
use j3_editor.overlay.{ drawGizmo, drawHelp, drawTags, drawViewportOverlay };
use j3_editor.picker.drawColorPicker;
use j3_editor.prefs.loadPrefs;
use j3_editor.scenes.{ checkRecover, warnMissing };
use j3_editor.session.loadSession;
use j3_editor.shared.shared;
use j3_editor.tabs.stash;
use j3_editor.types.{
    CON_BYTES, CON_LINES, Console, HISTORY, MOVE, MatEdit, MenuItem, RESIZE_NONE, Tab, Watched, World,
};
use j3_editor.ui_dialogs.{
    drawAssetPrompt, drawClosePrompt, drawConsole, drawMenu, drawNamePrompt, drawRecoverPrompt, drawScatterPrompt, modalUp,
};
use j3_editor.ui_inspector.rightPanel;
use j3_editor.ui_panes.{ drawBars, drawPanels, drawPanes, drawTabGhost, drawTabs };
use j3_editor.ui_top.{ statusBar, toolbar };
use j3_editor.ui_tree.{ drawTreeGhost, leftPanel };
use j3_editor.ui_online.onlinePage;
use j3_editor.util.{ edit, edits, envValue, newArena };
use j3_editor.widgets.editorTheme;

pub fn boot(mem: &Arena): World {
    let path = envValue("J3_EDITOR_SCENE", "scenes/main.j3scene");
    let tab = newArena(mem, 1024 * 1024);
    let cat = newArena(mem, 64 * 1024);
    let w = World {
        mem: mem,
        clipMem: newArena(mem, 4096),
        menuMem: newArena(mem, 4096),
        scene: scene3d.load(path, tab),
        worlds: mem.alloc::<Mat4>(0),
        worldsReady: false,
        catalog: save.load("target/j3-editor/catalog", cat),
        assets: save.load("target/j3-editor/assets-catalog", cat),
        assetPaths: mem.alloc::<string>(0),
        assetCount: 0,
        path: path,
        cam: Orbit.create(Vec3.xyz(0, 0.5, 0), 0.7, 0.45, 9),
        font: Font { raw: 0 },
        selected: 0,
        lastMouse: Vec2 { x: 0, y: 0 },
        nameEdit: edit(mem, ""),
        assetEdit: edit(mem, ""),
        textureEdit: edit(mem, ""),
        scriptEdit: edit(mem, ""),
        tagsEdit: edit(mem, ""),
        newScript: edit(mem, ""),
        importPath: edit(mem, ""),
        status: edit(mem, "Ready. Right-click anything for actions, H for shortcuts."),
        eventsRead: 0,
        pollTicks: 0,
        paramEdits: edits(mem, 64),
        candidate: emptySnap(mem),
        undos: deltaStack(tab, HISTORY),
        undoCount: 0,
        redos: deltaStack(tab, HISTORY),
        redoCount: 0,
        clip: emptySnap(mem),
        spare: emptySnap(mem),
        changedFrame: false,
        pendingUndo: false,
        placedBefore: mem.alloc::<Node>(1),
        placedBeforeId: 0,
        // Take the first undo candidate once the scene is loaded.
        stale: true,
        editGesture: false,
        gizmoMode: MOVE,
        gizmoAxis: 0,
        hoverAxis: -1,
        grabTangent: Vec2 { x: 0, y: 0 },
        grabStart: Vec3.xyz(0, 0, 0),
        dragTotal: 0,
        dragging: false,
        dirty: false,
        hoverNode: 0,
        assetPress: 0,
        assetFrom: Vec2 { x: 0, y: 0 },
        assetDragging: false,
        dropNode: 0,
        dropPoint: Vec3 { x: 0, y: 0, z: 0 },
        rightFrom: Vec2 { x: 0, y: 0 },
        rightArmed: false,
        menuOpen: false,
        menuAt: Vec2 { x: 0, y: 0 },
        menuTarget: 0,
        menuPoint: Vec3.xyz(0, 0, 0),
        menu: mem.alloc::<MenuItem>(48),
        menuLen: 0,
        swallow: false,
        rows: mem.alloc::<int>(4096),
        rowCount: 0,
        treeDrag: 0,
        treeFrom: Vec2 { x: 0, y: 0 },
        dropTarget: -1,
        dropWhere: 0,
        treeFilter: edit(mem, ""),
        viewCam: 0,
        savedCam: Orbit.create(Vec3.xyz(0, 0.5, 0), 0.7, 0.45, 9),
        snapMove: 0.5,
        snapAngle: 15,
        snapScale: 0.1,
        gridStep: 1,
        showSnap: false,
        prefsDirty: false,
        snapLeft: 0,
        showAgent: false,
        agentLeft: 0,
        agentOff: false,
        agentCount: 0,
        agentAt: 0,
        picked: mem.alloc::<int>(64),
        pickedCount: 0,
        grabIds: mem.alloc::<int>(0),
        grabPos: mem.alloc::<Vec3>(0),
        grabRot: mem.alloc::<Vec3>(0),
        grabScale: mem.alloc::<Vec3>(0),
        grabCount: 0,
        grabAxis: Vec3.xyz(1, 0, 0),
        edgeFrom: Vec3.zero(),
        edgeLength: 1,
        boxFrom: Vec2 { x: 0, y: 0 },
        boxing: false,
        localSpace: false,
        assetAction: 0,
        assetPath: edit(mem, ""),
        assetTarget: edit(mem, ""),
        assetFocus: false,
        matTab: false,
        mat: 0 as &MatEdit,
        matTexture: edit(mem, ""),
        matEffect: edit(mem, ""),
        meshPath: false,
        pickDepth: 0,
        previewLock: 0,
        fps: 0,
        fpsFrom: 0,
        fpsFrames: 0,
        throughDepth: 0,
        pickFrom: Vec2 { x: -100, y: -100 },
        tabPress: 0,
        tabFrom: Vec2 { x: 0, y: 0 },
        tabDragging: false,
        dropPane: 0,
        dropBefore: -2,
        importAsScene: false,
        onlineSource: "any",
        onlineKind: "any",
        onlineQuery: edit(mem, ""),
        online: save.empty(mem),
        onlineMem: newArena(mem, 4096),
        onlineThumbs: mem.alloc::<Tex>(0),
        onlineTried: mem.alloc::<bool>(0),
        onlinePick: -1,
        onlineBusy: false,
        onlineHeaderH: 190,
        pickFor: 0,
        pickField: edit(mem, ""),
        pickObject: false,
        ortho: false,
        axisView: false,
        clickId: 0,
        clickMs: -1000,
        renameNow: false,
        showHelp: false,
        closing: false,
        closeTab: -1,
        tabs: mem.alloc::<Tab>(12),
        tabCount: 0,
        active: 0,
        fileMenu: false,
        addMenu: false,
        menuFile: "",
        naming: false,
        nameFocus: false,
        sceneName: edit(mem, ""),
        scatterWhat: edit(mem, ""),
        catMem: cat,
        folds: mem.alloc::<string>(64),
        foldCount: 0,
        gameRunning: false,
        con: Console {
            bytes: mem.alloc::<u8>(CON_BYTES), len: 0,
            starts: mem.alloc::<int>(CON_LINES), kinds: mem.alloc::<int>(CON_LINES), count: 0,
            top: 0, stick: true, onlyProblems: false, problems: 0, seen: 0,
        },
        autosaveMs: 0,
        resizing: RESIZE_NONE,
        treeTop: 0,
        treeRoom: 1,
        recoverPath: edit(mem, ""),
        colorHex: edit(mem, ""),
        watched: mem.alloc::<Watched>(64),
        watchCount: 0,
        watchTicks: 0,
        propEdits: edits(mem, 32),
        propFor: 0,
        propTab: -1,
        propCount: -1,
        propName: edit(mem, ""),
    };
    readAssets(&w);
    loadPrefs(&w);
    return w;
}

pub fn startup(w: &World) {
    gfx.init();
    game.setMinSize(900, 520);
    game.holdClose(true);
    scene3d.upload(&w.scene);
    let i = 0;
    while i < w.scene.len {
        let n = w.scene.nodes[i];
        if n.kind == MESH && n.asset.len > 0 && n.gpu.vao == 0 {
            say(w, "Some mesh assets could not be loaded");
        }
        i += 1;
    }
    warnMissing(w);
    let aspect = save.parseFloat(envValue("J3_EDITOR_ASPECT", "") as []u8, 0);
    let g = shared();
    if aspect > 0 { g.aspect = aspect; }
    w.font = game.tryLoadFont(envValue("J3_EDITOR_FONT", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"), 15);
    if w.font.raw == 0 {
        printLn("j3 editor: could not load the UI font; set J3_EDITOR_FONT to a .ttf file");
    }
    w.tabCount = 1;
    w.tabs[0].pane = 0;
    stash(w);
    checkRecover(w);
    loadSession(w);
}

pub fn draw(w: &World) {
    drawPanes(w);
    drawGizmo(w);
    drawTags(w);
    drawViewportOverlay(w);
    drawHelp(w);
    drawPanels(w);
    let modal = w.menuOpen || modalUp(w);
    ui.block(modal || w.swallow || w.resizing != RESIZE_NONE);
    let u = Ui.begin(w.font, 0, 0);
    u.theme = editorTheme();
    u.space = 2;
    leftPanel(&u, w);
    u.space = 4;
    rightPanel(&u, w);
    onlinePage(&u, w);
    u.space = 0;
    drawBars();
    drawTabs(&u, w);
    toolbar(&u, w);
    statusBar(w);
    drawConsole(&u, w);
    drawTreeGhost(w);
    drawTabGhost(w);
    // Clicking empty panel space leaves any text field.
    if !modal && game.mousePressed(game.Mouse.Left) && !ui.hovering() { ui.clearFocus(); }
    ui.block(modalUp(w));
    drawMenu(&u, w);
    ui.block(false);
    if ui.fieldFull() { say(w, "Text fields hold up to 240 characters"); }
    drawClosePrompt(&u, w);
    drawNamePrompt(&u, w);
    drawScatterPrompt(&u, w);
    drawRecoverPrompt(&u, w);
    drawAssetPrompt(&u, w);
    drawColorPicker(&u, w);
}

fn main() {
    // `j3c -e scene` runs one request headless and exits before any window opens.
    if same(envValue("J3_EDITOR_MODE", ""), "cli") {
        sys.exit(i32(tool.cli(envValue("J3_TOOL", "list"), envValue("J3_EDITOR_SCENE", "scenes/main.j3scene"))));
    }
    if same(envValue("J3_EDITOR_MODE", ""), "render") {
        sys.exit(i32(render.cli(envValue("J3_TOOL", ""), envValue("J3_EDITOR_SCENE", "scenes/main.j3scene"))));
    }
    let app = App<World>.createSized("J3 Scene Editor", 1440, 860, 96 * 1024 * 1024, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
