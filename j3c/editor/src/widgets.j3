// Theme and small `Ui` helpers shared by the panels.

module j3_editor.widgets;

use j3.game;
use j3.game.{ Color, rgb, rgba };
use j3.math.{ Vec2, Vec3 };
use j3.memory.{ Arena, scratch };
use j3.scene3d.{ MESH, CAMERA, INSTANCE, LIGHT };
use j3.text.Text;
use j3.ui.{ Ui, Theme };
use j3_editor.types.World;
use j3_editor.util.cut;

pub fn editorTheme(): Theme {
    return Theme {
        text: rgb(222, 226, 234),
        button: rgb(52, 56, 66),
        buttonHot: rgb(68, 74, 88),
        buttonDown: rgb(40, 43, 51),
        panel: rgb(34, 37, 44),
        edge: rgb(60, 64, 76),
        accent: rgb(72, 128, 220),
    };
}

pub fn fill(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    game.setColor(c);
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: wide, y: tall });
}

pub fn outline(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    fill(x, y, wide, 2, c);
    fill(x, y + tall - 2, wide, 2, c);
    fill(x, y, 2, tall, c);
    fill(x + wide - 2, y, 2, tall, c);
}

/// Small dim caption, e.g. a field name above its box.
pub @j3ui caption(ui: &Ui, msg: string) {
    let keep = ui.theme.text;
    let tall = ui.h;
    ui.theme.text = rgb(150, 156, 170);
    ui.h = 20;
    label(msg);
    ui.theme.text = keep;
    ui.h = tall;
}

/// Red caption, one line per line of `msg`.
pub @j3ui errorCaption(ui: &Ui, msg: string) {
    let keep = ui.theme.text;
    let tall = ui.h;
    ui.theme.text = rgb(235, 110, 100);
    ui.h = 20;
    let at = 0;
    while at < msg.len {
        let end = at;
        while end < msg.len && msg[end] != 10 { end += 1; }
        if end > at { label([]u8 { ptr: (msg.ptr as int + at) as &u8, len: end - at } as string); }
        at = end + 1;
    }
    ui.theme.text = keep;
    ui.h = tall;
}

/// Section header with a rule under it.
pub @j3ui section(ui: &Ui, msg: string) {
    gap(8);
    let keep = ui.theme.text;
    ui.theme.text = rgb(140, 170, 230);
    ui.h = 22;
    labelBold(msg);
    ui.h = 28;
    ui.theme.text = keep;
    gap(-8);
    rule();
}

/// A button drawn in the accent color while `on`.
pub fn toolButton(ui: &Ui, msg: string, on: bool): bool {
    let keep = ui.theme.button;
    if on { ui.theme.button = ui.theme.accent; }
    let hit = ui.button(msg);
    ui.theme.button = keep;
    return hit;
}

/// A button, or its greyed-out look when `on` is false.
pub fn maybeButton(ui: &Ui, msg: string, on: bool): bool {
    if on { return ui.button(msg); }
    ui.buttonOff(msg);
    return false;
}

pub fn kindName(kind: int): string {
    if kind == LIGHT { return "light"; }
    if kind == INSTANCE { return "scene"; }
    if kind == MESH { return "mesh"; }
    if kind == CAMERA { return "camera"; }
    return "group";
}

pub fn kindColor(kind: int): Color {
    if kind == LIGHT { return rgb(250, 235, 170); }
    if kind == INSTANCE { return rgb(190, 130, 235); }
    if kind == MESH { return rgb(110, 170, 240); }
    if kind == CAMERA { return rgb(230, 190, 90); }
    return rgb(160, 166, 180);
}

/// `s`, or its tail after "...", so it fits in `room` pixels.
/// `s`, cut short with "..." at the end when it's wider than `room`.
pub fn fitRight(w: &World, s: string, room: f32): string {
    if w.font.raw == 0 { return s; }
    let whole = game.textSize(w.font, s);
    if whole.x <= room { return s; }
    // Longest prefix that fits, by halving.
    let lo = 0;
    let hi = s.len;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        let t = Text.new(scratch(0));
        t.pushStr(cut(s, 0, mid));
        t.pushStr("...");
        let size = game.textSize(w.font, t.str());
        if size.x <= room { lo = mid; } else { hi = mid - 1; }
    }
    let out = Text.new(scratch(0));
    out.pushStr(cut(s, 0, lo));
    out.pushStr("...");
    return out.str();
}

pub fn fitLeft(w: &World, s: string, room: f32): string {
    if w.font.raw == 0 { return s; }
    let whole = game.textSize(w.font, s);
    if whole.x <= room { return s; }
    let start = 0;
    while start < s.len {
        let t = Text.new(scratch(0));
        t.pushStr("...");
        t.pushStr(cut(s, start, s.len));
        let size = game.textSize(w.font, t.str());
        if size.x <= room { return t.str(); }
        start += 1;
    }
    return s;
}

pub fn vecRow(ui: &Ui, salt: int, value: &Vec3, speed: f32): bool {
    return tripleRow(ui, salt, value, speed, "X", "Y", "Z");
}

/// Three numbers sharing the column width, labelled `a`, `b`, `c`.
pub fn tripleRow(ui: &Ui, salt: int, value: &Vec3, speed: f32, a: string, b: string, c: string): bool {
    let changed = false;
    ui.pushId(salt);
    let x0 = ui.x;
    let w0 = ui.w;
    let y0 = ui.y;
    ui.w = (w0 - 8) / 3;
    if ui.number(a, &value.x, speed) { changed = true; }
    ui.x = x0 + ui.w + 4;
    ui.y = y0;
    if ui.number(b, &value.y, speed) { changed = true; }
    ui.x = x0 + (ui.w + 4) * 2;
    ui.y = y0;
    if ui.number(c, &value.z, speed) { changed = true; }
    ui.x = x0;
    ui.w = w0;
    ui.popId();
    return changed;
}

/// Dim the window and draw an empty dialog box `bw` by `bh` in its middle; the Ui cursor
/// starts inside it. Returns the box's top-left corner.
pub fn dialog(ui: &Ui, bw: f32, bh: f32): Vec2 {
    let win = game.windowSize();
    fill(0, 0, win.x, win.y, rgba(0, 0, 0, 140));
    let x = (win.x - bw) * 0.5;
    let y = (win.y - bh) * 0.5;
    fill(x - 1, y - 1, bw + 2, bh + 2, rgb(14, 15, 19));
    fill(x, y, bw, bh, rgb(40, 44, 52));
    ui.x = x + 18;
    ui.y = y + 16;
    ui.w = bw - 36;
    return Vec2 { x: x, y: y };
}
