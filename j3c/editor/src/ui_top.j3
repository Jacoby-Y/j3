// Toolbar, snap settings, and the status bar.

module j3_editor.ui_top;

use j3.game;
use j3.game.rgb;
use j3.math.Vec2;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.MESH;
use j3.text.Text;
use j3.ui.{ Ui, typing };
use j3_editor.assets.isPaint;
use j3_editor.cameras.{ overLock, overPreview };
use j3_editor.commands.{ redo, run, undo };
use j3_editor.files.{ play, saveScene, stopGame };
use j3_editor.layout.{ overViewport, treeDragging };
use j3_editor.prefs.savePrefs;
use j3_editor.selection.nameOf;
use j3_editor.shared.shared;
use j3_editor.types.{ AGENT_H, AGENT_W, BOTTOM, CMD_FOCUS, MOVE, ROTATE, SCALE, SNAP_H, SNAP_W, TOP, World };
use j3_editor.util.{ endsWith, envValue, isOnline, positive };
use j3_editor.ui_online.openOnlineTab;
use j3_editor.console.say;
use j3_editor.widgets.{ caption, fill, maybeButton, toolButton };

pub @j3ui toolbar(ui: &Ui, w: &World) {
    let g = shared();
    let win = game.windowSize();
    ui.x = 10;
    ui.y = 8;
    let snapX = ui.x;
    row() {
        button("Save") { saveScene(w); }
        let keepButton = ui.theme.button;
        if w.gameRunning {
            ui.theme.button = rgb(150, 60, 56);
            button("  Stop  ") { stopGame(w); }
        } else {
            ui.theme.button = rgb(46, 120, 72);
            button("  Play  ") { play(w); }
        }
        ui.theme.button = keepButton;
        if toolButton(ui, "Get Asset", isOnline(w.path)) { openOnlineTab(w); }
        gap(10);
        let canUndo = w.undoCount > 0 || w.pendingUndo;
        let canRedo = w.redoCount > 0;
        if w.matTab {
            canUndo = w.mat.undoCount > 0;
            canRedo = w.mat.redoCount > 0;
        }
        if maybeButton(ui, "Undo", canUndo) { undo(w); }
        if maybeButton(ui, "Redo", canRedo) { redo(w); }
        gap(10);
        if toolButton(ui, "Move (W)", w.gizmoMode == MOVE) { w.gizmoMode = MOVE; }
        if toolButton(ui, "Rotate (E)", w.gizmoMode == ROTATE) { w.gizmoMode = ROTATE; }
        if toolButton(ui, "Scale (R)", w.gizmoMode == SCALE) { w.gizmoMode = SCALE; }
        if toolButton(ui, "Local (L)", w.localSpace) { w.localSpace = !w.localSpace; }
        gap(10);
        button("Focus (F)") { run(w, CMD_FOCUS); }
        if toolButton(ui, "Snap", w.showSnap) {
            w.showSnap = !w.showSnap;
            w.showAgent = false;
        }
        snapX = ui.x;
        let agentX = ui.x;
        let agentName = "Agent";
        if w.agentOff { agentName = "Agent (off)"; }
        if toolButton(ui, agentName, w.showAgent) {
            w.showAgent = !w.showAgent;
            w.showSnap = false;
        }
        w.agentLeft = agentX - 8;
        if toolButton(ui, "Keys (H)", w.showHelp) { w.showHelp = !w.showHelp; }
        let news = w.con.problems - w.con.seen;
        let name = Text.new(scratch(0));
        name.pushStr("Console");
        if news > 0 && !g.consoleOpen {
            name.pushStr(" (");
            name.pushInt(news);
            name.pushStr("!)");
        }
        if toolButton(ui, name.str(), g.consoleOpen) { g.consoleOpen = !g.consoleOpen; }
    }
    if w.showSnap { snapPanel(ui, w, snapX); }
    if w.showAgent { agentPanel(ui, w); }
    if w.font.raw != 0 {
        let t = Text.new(scratch(0));
        t.pushStr(w.path);
        if w.dirty { t.pushStr("  (unsaved)"); }
        let size = game.textSize(w.font, t.str());
        let x = win.x - size.x - 14;
        if x > ui.x + 20 {
            game.setColor(rgb(150, 156, 170));
            if w.dirty { game.setColor(rgb(240, 190, 90)); }
            game.drawText(w.font, Vec2 { x: x, y: 13 }, t.str());
        }
    }
}

/// Snap steps and grid spacing, dropped down from the toolbar's Snap button.
pub @j3ui snapPanel(ui: &Ui, w: &World, x: f32) {
    let top = ui.y;
    w.snapLeft = x - 64;
    fill(w.snapLeft, TOP, SNAP_W, SNAP_H, rgb(40, 44, 52));
    ui.x = x - 56;
    ui.y = TOP + 8;
    ui.w = 184;
    let changed = false;
    if ui.number("Move", &w.snapMove, 0.01) { changed = true; }
    if ui.number("Angle", &w.snapAngle, 0.2) { changed = true; }
    if ui.number("Scale", &w.snapScale, 0.005) { changed = true; }
    if ui.number("Grid", &w.gridStep, 0.01) { changed = true; }
    if changed {
        w.snapMove = positive(w.snapMove, 0.01);
        w.snapAngle = positive(w.snapAngle, 1);
        w.snapScale = positive(w.snapScale, 0.01);
        w.gridStep = positive(w.gridStep, 0.1);
    }
    // Written once the drag or typing is over, not every frame of it.
    if changed { w.prefsDirty = true; }
    if w.prefsDirty && !game.mouseDown(game.Mouse.Left) && !typing() {
        savePrefs(w);
        w.prefsDirty = false;
    }
    ui.y = top;
}

/// Agent (MCP) settings, dropped down from the toolbar's Agent button.
pub @j3ui agentPanel(ui: &Ui, w: &World) {
    let top = ui.y;
    fill(w.agentLeft, TOP, AGENT_W, AGENT_H, rgb(40, 44, 52));
    ui.x = w.agentLeft + 8;
    ui.y = TOP + 8;
    ui.w = AGENT_W - 16;
    let on = !w.agentOff;
    if ui.toggle("Let agents use this editor", &on) {
        w.agentOff = !on;
        savePrefs(w);
    }
    let t = Text.new(scratch(0));
    if w.agentCount == 0 {
        t.pushStr("No agent requests yet");
    } else {
        t.pushInt(w.agentCount);
        t.pushStr(" requests, last ");
        t.pushInt((game.ticks() - w.agentAt) / 1000);
        t.pushStr("s ago");
    }
    caption(ui, t.str());
    caption(ui, "Claude Code setup (once, any project):");
    if ui.button("Copy setup command") {
        let cmd = Text.new(scratch(0));
        cmd.pushStr("claude mcp add -s user j3 -- ");
        cmd.pushStr(envValue("J3_HOST", "j3c"));
        cmd.pushStr(" -e mcp");
        game.setClipboard(cmd.str());
        say(w, cmd.str());
        say(w, "Copied the setup command; paste it in a terminal");
    }
    ui.y = top;
}

/// Status bar tip for what the pointer is doing right now.
pub fn hint(w: &World): string {
    if treeDragging(w) { return "Drop on an object to parent it, or on empty space for the top level"; }
    if w.assetDragging { return dropHint(w); }
    if overLock(w, game.mousePos()) { return "Keep this camera's preview up, or let it go"; }
    if overPreview(w, game.mousePos()) { return "Click the preview to keep it up"; }
    if w.menuOpen { return "Pick an action, or Esc to close"; }
    if w.dragging || w.hoverAxis >= 0 { return "Drag the handle   Hold Ctrl to snap"; }
    return "Arrows move (Shift fast, Ctrl slow)   RMB orbit   MMB pan   Wheel zoom   H shortcuts";
}

/// What letting go of the dragged asset would do.
pub fn dropHint(w: &World): string {
    let path = w.assetPaths[w.assetPress - 1];
    let target = 0;
    if overViewport(game.mousePos()) { target = w.dropNode; }
    else if w.dropTarget > 0 { target = w.dropTarget; }
    if endsWith(path, ".j3fx") { return "Let go to add it to the selected camera"; }
    let t = Text.new(scratch(0));
    if isPaint(path) {
        let at = scene3d.index(&w.scene, target);
        if at < 0 || w.scene.nodes[at].kind != MESH { return "Drop on a mesh to apply it"; }
        if endsWith(path, ".j3mat") { t.pushStr("Drop to apply the material to "); }
        else { t.pushStr("Drop to apply the image to "); }
        t.pushStr(nameOf(w, target));
        return t.str();
    }
    if !overViewport(game.mousePos()) && w.dropTarget > 0 {
        t.pushStr("Drop to add it inside ");
        t.pushStr(nameOf(w, w.dropTarget));
        return t.str();
    }
    return "Drop to add it here";
}

pub fn statusBar(w: &World) {
    if w.font.raw == 0 { return; }
    let win = game.windowSize();
    let y = win.y - BOTTOM + 5;
    game.setColor(rgb(200, 204, 214));
    if w.dirty {
        game.setColor(rgb(240, 190, 90));
        game.drawText(w.font, Vec2 { x: 12, y: y }, "*");
        game.setColor(rgb(200, 204, 214));
    }
    game.drawText(w.font, Vec2 { x: 26, y: y }, w.status.str());
    let st = game.frameStats();
    let t = Text.new(scratch(1));
    t.pushInt(st.draws);
    t.pushStr(" draws · ");
    t.pushInt(st.tris);
    t.pushStr(" tris · ");
    t.pushInt(int(st.cpuMs + 0.5));
    t.pushStr(" ms");
    let statsSize = game.textSize(w.font, t.str());
    let tip = hint(w);
    let size = game.textSize(w.font, tip);
    let statusSize = game.textSize(w.font, w.status.str());
    let right = win.x - statsSize.x - 12;
    game.setColor(rgb(130, 136, 150));
    if right > statusSize.x + 60 {
        game.drawText(w.font, Vec2 { x: right, y: y }, t.str());
    }
    if right - size.x - 24 > statusSize.x + 60 {
        game.drawText(w.font, Vec2 { x: right - size.x - 24, y: y }, tip);
    }
}
