// Commands that toolbar buttons, menu rows, and shortcuts share.

module j3_editor.commands;

use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ GROUP, MESH, CAMERA, LIGHT, INSTANCE };
use j3.text.{ Text, find };
use j3_editor.assets.pickFile;
use j3_editor.cameras.{ setMainCamera, viewThrough };
use j3_editor.console.say;
use j3_editor.files.focus;
use j3_editor.live.applyHere;
use j3_editor.history.{
    applyDelta, capture, diffSnap, emptySnap, gatherMany, modified, paste, pushDelta, restore, snapshot,
};
use j3_editor.materials.matUndo;
use j3_editor.nodes.{ addNode, deleteSelected, dropOn, viewGround };
use j3_editor.overrides.{ allowedOnPlaced, isPlaced };
use j3_editor.scenes.{ addInstance, closeTab, openMaterialTab, openScene, startNaming };
use j3_editor.selection.{ parentOf, pickedRoots, select };
use j3_editor.tool;
use j3_editor.types.{
    ASSET_DELETE, ASSET_RENAME, CMD_ADD_CAMERA, CMD_ADD_GROUP, CMD_ADD_LIGHT, CMD_ADD_MESH, CMD_ADD_PLANE, CMD_ADD_SHAPE, CMD_ADD_SKY, CMD_CLOSE_TAB, CMD_COPY, CMD_CUT, CMD_DELETE, CMD_DELETE_ASSET, CMD_DUPLICATE, CMD_EDIT_MATERIAL, CMD_FOCUS, CMD_GROUND, CMD_INSTANCE, CMD_INSTANCE_CHILD, CMD_MAIN_CAMERA, CMD_NEW_SCENE, CMD_ONTOP, CMD_OPEN_SCENE, CMD_PASTE, CMD_PASTE_CHILD, CMD_PICK_FILE, CMD_RENAME, CMD_RENAME_ASSET, CMD_RESET, CMD_SCATTER, CMD_UNPARENT, CMD_VIEW_CAMERA, World,
};
use j3_editor.util.{ countMsg, cut, isOnline, setText };

pub fn undo(w: &World) {
    if w.matTab { matUndo(w, true); return; }
    if w.pendingUndo { snapshot(w); }
    if w.undoCount == 0 {
        say(w, "Nothing to undo");
        return;
    }
    capture(w, &w.spare);
    let back = applyDelta(&w.spare, &w.undos[w.undoCount - 1]);
    let forward = diffSnap(&back, &w.spare);
    w.redoCount = pushDelta(w.scene.arena, w.redos, w.redoCount, &forward);
    w.undoCount -= 1;
    restore(w, &back);
    say(w, "Undone (Ctrl+Y to redo)");
}

pub fn redo(w: &World) {
    if w.matTab { matUndo(w, false); return; }
    if w.pendingUndo { snapshot(w); }
    if w.redoCount == 0 {
        say(w, "Nothing to redo");
        return;
    }
    capture(w, &w.spare);
    let ahead = applyDelta(&w.spare, &w.redos[w.redoCount - 1]);
    let backward = diffSnap(&ahead, &w.spare);
    w.undoCount = pushDelta(w.scene.arena, w.undos, w.undoCount, &backward);
    w.redoCount -= 1;
    restore(w, &ahead);
    say(w, "Redone");
}

/// Add a top-level object in the middle of the view.
pub fn addHere(w: &World, cmd: int) {
    w.menuTarget = 0;
    w.menuPoint = viewGround(w);
    run(w, cmd);
}

pub fn run(w: &World, cmd: int) {
    if (w.matTab || isOnline(w.path)) && cmd != CMD_NEW_SCENE && cmd != CMD_CLOSE_TAB && cmd != CMD_OPEN_SCENE
        && cmd != CMD_EDIT_MATERIAL && cmd != CMD_RENAME_ASSET && cmd != CMD_DELETE_ASSET {
        if w.matTab { say(w, "That works in a scene tab; this tab edits a material"); } else { say(w, "That works in a scene tab"); }
        return;
    }
    let target = w.selected;
    let has = scene3d.index(&w.scene, target) >= 0;
    if has && isPlaced(w, target) && !allowedOnPlaced(cmd) {
        say(w, "This object comes from a placed scene; open that scene to add, move, or remove objects");
        return;
    }
    if cmd == CMD_ADD_GROUP || cmd == CMD_ADD_MESH || cmd == CMD_ADD_CAMERA || cmd == CMD_ADD_LIGHT
        || cmd == CMD_ADD_PLANE || cmd == CMD_ADD_SKY || cmd == CMD_ADD_SHAPE {
        let kind = MESH;
        let mesh = "builtin:cube";
        if cmd == CMD_ADD_GROUP { kind = GROUP; }
        if cmd == CMD_ADD_CAMERA { kind = CAMERA; }
        if cmd == CMD_ADD_LIGHT { kind = LIGHT; }
        if cmd == CMD_ADD_PLANE { mesh = "builtin:plane"; }
        if cmd == CMD_ADD_SKY { mesh = "builtin:sky"; }
        if cmd == CMD_ADD_SHAPE { mesh = w.menuFile; }
        if w.menuTarget != 0 && has {
            addNode(w, kind, mesh, target, Vec3.xyz(0, 0, 0));
        } else {
            addNode(w, kind, mesh, 0, w.menuPoint);
        }
        return;
    }
    if cmd == CMD_OPEN_SCENE { openScene(w, w.menuFile); return; }
    if cmd == CMD_PICK_FILE { pickFile(w); return; }
    if cmd == CMD_EDIT_MATERIAL { openMaterialTab(w, w.menuFile); return; }
    if cmd == CMD_RENAME_ASSET || cmd == CMD_DELETE_ASSET {
        setText(&w.assetPath, w.menuFile);
        setText(&w.assetTarget, w.menuFile);
        w.assetAction = ASSET_DELETE;
        if cmd == CMD_RENAME_ASSET {
            w.assetAction = ASSET_RENAME;
            w.assetFocus = true;
        }
        return;
    }
    if cmd == CMD_SCATTER {
        // Start from the selection's mesh or scene, else a cube.
        let at = scene3d.index(&w.scene, target);
        if at >= 0 && w.scene.nodes[at].kind == MESH { setText(&w.scatterWhat, w.scene.nodes[at].asset); }
        else if at >= 0 && w.scene.nodes[at].kind == INSTANCE { setText(&w.scatterWhat, w.scene.nodes[at].scene); }
        else if w.scatterWhat.len() == 0 { setText(&w.scatterWhat, "cube"); }
        w.scattering = true;
        return;
    }
    if cmd == CMD_VIEW_CAMERA { viewThrough(w, target); return; }
    if cmd == CMD_MAIN_CAMERA { setMainCamera(w, target); return; }
    if cmd == CMD_NEW_SCENE { startNaming(w); return; }
    if cmd == CMD_CLOSE_TAB { closeTab(w, w.active, false); return; }
    if cmd == CMD_INSTANCE || cmd == CMD_INSTANCE_CHILD {
        if has && (cmd == CMD_INSTANCE_CHILD || w.menuTarget != 0) {
            addInstance(w, w.menuFile, target, Vec3.xyz(0, 0, 0));
        } else {
            addInstance(w, w.menuFile, 0, w.menuPoint);
        }
        return;
    }
    if cmd == CMD_PASTE || cmd == CMD_PASTE_CHILD {
        if w.clip.len == 0 {
            say(w, "Clipboard is empty. Copy an object with Ctrl+C first");
            return;
        }
        // Paste next to the selection, or where it was copied from.
        let under = w.clip.nodes[0].parent;
        if scene3d.index(&w.scene, under) < 0 { under = 0; }
        if has { under = parentOf(w, target); }
        if has && cmd == CMD_PASTE_CHILD { under = target; }
        if paste(w, &w.clip, under) != 0 { say(w, countMsg("Pasted", w.clip.len)); }
        return;
    }
    if !has {
        say(w, "Select an object first");
        return;
    }
    if cmd == CMD_RENAME { w.renameNow = true; }
    if cmd == CMD_FOCUS { focus(w); }
    if cmd == CMD_DELETE { deleteSelected(w); }
    let roots = pickedRoots(w);
    if cmd == CMD_COPY || cmd == CMD_CUT {
        w.clipMem.destroy();
        gatherMany(w, roots, &w.clip, w.clipMem);
        if cmd == CMD_CUT {
            let r = 0;
            while r < roots.len {
                scene3d.remove(&w.scene, roots[r]);
                r += 1;
            }
            select(w, 0);
            modified(w);
            say(w, countMsg("Cut", w.clip.len));
        } else {
            say(w, countMsg("Copied", w.clip.len));
        }
    }
    if cmd == CMD_DUPLICATE {
        let copy = emptySnap(scratch(0));
        gatherMany(w, roots, &copy, scratch(0));
        if paste(w, &copy, parentOf(w, target)) != 0 { say(w, countMsg("Duplicated", copy.len)); }
    }
    if cmd == CMD_UNPARENT {
        let top = 0;
        while top < roots.len {
            dropOn(w, roots[top], 0);
            top += 1;
        }
    }
    if cmd == CMD_GROUND {
        // The same op as `j3c -e scene ground`; each object lands on what's below it.
        let req = Text.new(scratch(0));
        let g = 0;
        while g < w.pickedCount {
            if g > 0 { req.push(30); }
            req.pushStr("ground\t#");
            req.pushInt(w.picked[g]);
            g += 1;
        }
        runOp(w, req.str(), countMsg("Grounded", w.pickedCount));
    }
    if cmd == CMD_ONTOP {
        w.ontopPick = true;
        say(w, "Click the object to place the selection on (Esc cancels)");
    }
    if cmd == CMD_RESET {
        let p = 0;
        while p < w.pickedCount {
            let slot = scene3d.index(&w.scene, w.picked[p]);
            if slot >= 0 {
                w.scene.nodes[slot].position = Vec3.xyz(0, 0, 0);
                w.scene.nodes[slot].rotation = Vec3.xyz(0, 0, 0);
                w.scene.nodes[slot].scale = Vec3.xyz(1, 1, 1);
            }
            p += 1;
        }
        modified(w);
        say(w, "Transform reset");
    }
}

/// Run `tool` request `req` on the open scene as one undo step; say `done`, or why it failed.
fn runOp(w: &World, req: string, done: string) {
    let out = Text.new(scratch(0));
    let result = applyHere(w, req, &out);
    if result.ok {
        say(w, done);
        return;
    }
    // The reply's `err<TAB>why` line.
    let text = out.str();
    let at = find(text, "err\t");
    if at < 0 { say(w, "That didn't work"); return; }
    let end = at + 4;
    while end < text.len && text[end] != 10 { end += 1; }
    say(w, cut(text, at + 4, end));
}

/// While "Place on top of..." waits: a viewport click on `id` puts the selection on it.
/// Returns whether the click was taken.
pub fn ontopClick(w: &World, id: int): bool {
    if !w.ontopPick { return false; }
    w.ontopPick = false;
    if id == 0 {
        say(w, "Place on top cancelled");
        return true;
    }
    let roots = pickedRoots(w);
    let req = Text.new(scratch(0));
    let r = 0;
    while r < roots.len {
        if roots[r] != id {
            if req.len() > 0 { req.push(30); }
            req.pushStr("ontop\t#");
            req.pushInt(roots[r]);
            req.pushStr("\t#");
            req.pushInt(id);
        }
        r += 1;
    }
    if req.len() == 0 { return true; }
    runOp(w, req.str(), "Placed on top (Ctrl+Z to undo)");
    return true;
}

/// Scatter dialog's go: copies of `scatterWhat` around the middle of the view.
pub fn scatterNow(w: &World) {
    let mid = viewGround(w);
    let r = w.scatterSpread;
    let req = Text.new(scratch(0));
    req.pushStr("scatter\t");
    req.pushStr(w.scatterWhat.str());
    req.pushStr("\tarea=");
    req.pushFloat(mid.x - r);
    req.push(44);
    req.pushFloat(mid.z - r);
    req.push(44);
    req.pushFloat(mid.x + r);
    req.push(44);
    req.pushFloat(mid.z + r);
    req.pushStr("\tcount=");
    req.pushInt(int(w.scatterCount));
    req.pushStr("\tseed=");
    req.pushInt(int(w.scatterSeed));
    w.scattering = false;
    runOp(w, req.str(), countMsg("Scattered", int(w.scatterCount)));
}
