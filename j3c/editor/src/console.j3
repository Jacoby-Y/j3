// The console log: storing lines and classifying them. Drawing is in `ui_dialogs`.

module j3_editor.console;

use j3.memory.Arena;
use j3_editor.types.{ CON_BYTES, CON_ERROR, CON_INFO, CON_LINES, CON_WARN, Console, World };
use j3_editor.util.{ has, setText };

pub fn say(w: &World, msg: string) {
    setText(&w.status, msg);
}

/// `fallback`, or warning/error when the line says so.
pub fn lineKind(line: string, fallback: int): int {
    if has(line, "error") || has(line, "panic") || has(line, "Error") || has(line, "PANIC") { return CON_ERROR; }
    if has(line, "warning") || has(line, "Warning") || has(line, "WARN") { return CON_WARN; }
    return fallback;
}

/// Add a line to the console. When full, the older half is dropped.
pub fn conAdd(w: &World, kind: int, line: string) {
    let c = &w.con;
    let n = line.len;
    if n > 1000 { n = 1000; }
    if c.count >= CON_LINES || c.len + n > CON_BYTES {
        let keep = c.count / 2;
        let from = c.starts[c.count - keep];
        let i = 0;
        while from + i < c.len {
            c.bytes[i] = c.bytes[from + i];
            i += 1;
        }
        c.len -= from;
        i = 0;
        while i < keep {
            c.starts[i] = c.starts[c.count - keep + i] - from;
            c.kinds[i] = c.kinds[c.count - keep + i];
            i += 1;
        }
        c.top -= c.count - keep;
        if c.top < 0 { c.top = 0; }
        c.count = keep;
    }
    c.starts[c.count] = c.len;
    c.kinds[c.count] = kind;
    c.count += 1;
    let b = 0;
    while b < n {
        c.bytes[c.len + b] = line[b];
        b += 1;
    }
    c.len += n;
    if kind != CON_INFO { c.problems += 1; }
}

pub fn conLine(c: &Console, k: int): string {
    let end = c.len;
    if k + 1 < c.count { end = c.starts[k + 1]; }
    return []u8 { ptr: &c.bytes[c.starts[k]], len: end - c.starts[k] } as string;
}
