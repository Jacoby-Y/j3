// Inspector for a material tab.

module j3_editor.ui_material;

use j3.game;
use j3.game.Texture;
use j3.gfx.{ FxParam, FX_FLOAT, FX_INT, FX_BOOL, FX_COLOR };
use j3.math.{ Vec2, Vec3 };
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.gfx.noise.{ PERLIN, CELLS, NEAREST, FBM, SINGLE };
use j3.data.save;
use j3.text.Text;
use j3.ui.Ui;
use j3_editor.console.say;
use j3_editor.materials.{ matBefore, matChanged, matF, matI, putMatF, putMatI };
use j3_editor.picker.colorRow;
use j3_editor.prefs.{ putRgbKey, rgbKey };
use j3_editor.types.World;
use j3_editor.util.{ clamp01, limit, optionAt, own, setText };
use j3_editor.widgets.{ caption, errorCaption, fitLeft, section, toolButton };

/// A 0..1 number of the open material.
pub @j3ui matUnit(ui: &Ui, w: &World, label: string, key: string, fallback: f32) {
    let v = matF(w, key, fallback);
    if ui.number(label, &v, 0.005) { putMatF(w, key, clamp01(v)); }
}

/// A number of the open material kept within `lo`..`hi`, dragged by `speed` a pixel.
pub @j3ui matRange(ui: &Ui, w: &World, label: string, key: string, fallback: f32, lo: f32, hi: f32, speed: f32) {
    let v = matF(w, key, fallback);
    if ui.number(label, &v, speed) { putMatF(w, key, limit(v, lo, hi)); }
}

/// A whole number of the open material, kept within `lo`..`hi`.
pub @j3ui matWhole(ui: &Ui, w: &World, label: string, key: string, fallback: int, lo: int, hi: int) {
    let v = f32(matI(w, key, fallback));
    ui.whole = true;
    if ui.number(label, &v, 0.05) {
        let n = int(v + 0.5);
        if v < 0 { n = int(v - 0.5); }
        if n < lo { n = lo; }
        if n > hi { n = hi; }
        if n != matI(w, key, fallback) { putMatI(w, key, n); }
    }
    ui.whole = false;
}

/// A button showing `names[value]` that steps to the next name on each click.
pub @j3ui matCycle(ui: &Ui, w: &World, label: string, key: string, fallback: int, names: string) {
    let v = matI(w, key, fallback);
    let count = 1;
    let i = 0;
    while i < names.len {
        if names[i] == 124 { count += 1; }
        i += 1;
    }
    if v < 0 || v >= count { v = fallback; }
    let t = Text.new(scratch(0));
    t.pushStr(label);
    t.pushStr(": ");
    t.pushStr(optionAt(names, v));
    button(t.str()) {
        v += 1;
        if v >= count { v = 0; }
        putMatI(w, key, v);
    }
}

pub @j3ui matColorRow(ui: &Ui, w: &World, salt: int, key: string, fallback: Vec3) {
    let c = rgbKey(&w.mat.file, key, fallback);
    if colorRow(ui, salt, &c) {
        matBefore(w);
        putRgbKey(&w.mat.file, key, c);
        matChanged(w);
    }
}

/// Everything about the open material. Changes show at once on the objects that use it;
/// Save writes the file.
pub @j3ui materialPanel(ui: &Ui, w: &World) {
    section(ui, "MATERIAL");
    caption(ui, fitLeft(w, w.path, ui.w));
    caption(ui, "Save (Ctrl+S) writes it. Ctrl+Z undoes.");

    section(ui, "COLOR");
    caption(ui, "Tint (multiplies the pattern)");
    matColorRow(ui, w, 31, "tint", Vec3.xyz(1, 1, 1));
    let noiseOn = matI(w, "noise", 0) != 0;
    let image = save.getStr(&w.mat.file, "texture", "");
    let hasImage = !noiseOn && image.len > 0;
    caption(ui, "Pattern");
    row() {
        if toolButton(ui, "Plain", !noiseOn && !hasImage) {
            matBefore(w);
            save.putInt(&w.mat.file, "noise", 0);
            save.putStr(&w.mat.file, "texture", "");
            setText(&w.matTexture, "");
            matChanged(w);
        }
        if toolButton(ui, "Image", hasImage || (!noiseOn && w.matTexture.len() > 0)) {
            matBefore(w);
            save.putInt(&w.mat.file, "noise", 0);
            matChanged(w);
            say(w, "Type an image path, or click an image under Assets");
        }
        if toolButton(ui, "Noise", noiseOn) { putMatI(w, "noise", 1); }
    }
    if noiseOn {
        noisePanel(ui, w);
    } else {
        caption(ui, "Image path (or click an image under Assets)");
        if ui.field("assets/texture.png", &w.matTexture) {
            matBefore(w);
            save.putStr(&w.mat.file, "texture", w.matTexture.str());
            matChanged(w);
        }
    }

    section(ui, "SURFACE");
    matUnit(ui, w, "Highlight", "spec", 0);
    matUnit(ui, w, "Highlight sharpness", "shine", 0.3);
    matUnit(ui, w, "Mirror", "reflect", 0);
    matUnit(ui, w, "Roughness", "rough", 0);
    caption(ui, "Mirror 1 is a perfect mirror. It shows");
    caption(ui, "the sky or sky box; URP adds the scene.");

    section(ui, "GLOW");
    caption(ui, "Glow color");
    matColorRow(ui, w, 32, "glow", Vec3.xyz(0, 0, 0));
    let emits = matI(w, "emit", 0) != 0;
    let wasEmit = emits;
    check("Lights up other objects", &emits);
    if emits != wasEmit { putMatI(w, "emit", if emits { 1 } else { 0 }); }
    if emits {
        matRange(ui, w, "Light strength", "emit.strength", 1, 0, 50, 0.02);
        matRange(ui, w, "Light range", "emit.range", 6, 0.5, 200, 0.05);
        caption(ui, "Shines from the object's middle.");
    }

    section(ui, "GLASS AND TRANSPARENCY");
    // Stored as -1 (each object's own) through BLEND; shown one higher.
    let mode = matI(w, "mode", -1) + 1;
    let modes = "Each object's own|Opaque|Cutout (alpha < 0.5)|See-through";
    let t = Text.new(scratch(0));
    t.pushStr("Mode: ");
    t.pushStr(optionAt(modes, mode));
    button(t.str()) {
        mode += 1;
        if mode > 3 { mode = 0; }
        putMatI(w, "mode", mode - 1);
    }
    matUnit(ui, w, "Opacity", "opacity", 1);
    caption(ui, "Below 1 is see-through.");
    matRange(ui, w, "Refraction index", "ior", 1, 1, 3, 0.005);
    row() {
        let ior = matF(w, "ior", 1);
        if toolButton(ui, "Off", ior < 1.001) { putMatF(w, "ior", 1); }
        if toolButton(ui, "Water", ior > 1.32 && ior < 1.34) { putMatF(w, "ior", 1.33); }
        if toolButton(ui, "Glass", ior > 1.49 && ior < 1.51) { putMatF(w, "ior", 1.5); }
        if toolButton(ui, "Diamond", ior > 2.41 && ior < 2.43) { putMatF(w, "ior", 2.42); }
    }
    caption(ui, "Above 1 bends light, like glass.");
    if matF(w, "ior", 1) > 1.001 {
        matUnit(ui, w, "Cloudiness", "cloud", 0);
        caption(ui, "0 is clear glass; 1 is frosted.");
    }
    matUnit(ui, w, "Glass edges", "edge", 0);
    caption(ui, "Glass edges: clear facing you, solid at the rim.");

    effectSection(ui, w);

    section(ui, "TILING");
    matPair(ui, w, 33, "uv.scale", 1, "Repeat X", "Repeat Y");
    matPair(ui, w, 34, "uv.offset", 0, "Shift X", "Shift Y");
}

/// The material's `.j3fx` effect and its params (`fx.<name>` keys).
pub @j3ui effectSection(ui: &Ui, w: &World) {
    section(ui, "EFFECT");
    caption(ui, "Type an effect path, or click one under Assets");
    if ui.field("assets/fx/effect.j3fx", &w.matEffect) {
        matBefore(w);
        save.putStr(&w.mat.file, "fx", w.matEffect.str());
        matChanged(w);
    }
    let path = save.getStr(&w.mat.file, "fx", "");
    if path.len == 0 { return; }
    let cleared = false;
    button("None") {
        matBefore(w);
        save.putStr(&w.mat.file, "fx", "");
        setText(&w.matEffect, "");
        matChanged(w);
        cleared = true;
    }
    if cleared { return; }
    let broken = scene3d.effectError(path);
    if broken.len > 0 { errorCaption(ui, broken); }
    let params = scene3d.effectParams(path, scratch(0));
    let k = 0;
    while k < params.len {
        let p = params[k];
        let key = Text.new(scratch(0));
        key.pushStr("fx.");
        key.pushStr(p.name);
        let v = Vec3.xyz(p.def[0], p.def[1], p.def[2]);
        if p.kind == FX_COLOR { v = rgbKey(&w.mat.file, key.str(), v); }
        else if p.kind == FX_FLOAT { v.x = matF(w, key.str(), p.def[0]); }
        else { v.x = f32(matI(w, key.str(), int(p.def[0]))); }
        if fxParam(ui, p, &v, 700 + k) {
            if p.kind == FX_COLOR {
                matBefore(w);
                putRgbKey(&w.mat.file, key.str(), v);
                matChanged(w);
            } else if p.kind == FX_FLOAT { putMatF(w, key.str(), v.x); }
            else { putMatI(w, key.str(), int(v.x)); }
        }
        k += 1;
    }
}

/// One `.j3fx` param's widget, by kind; `v.x` holds a number, `v` a color. True when changed.
pub fn fxParam(ui: &Ui, p: FxParam, v: &Vec3, salt: int): bool {
    ui.pushId(salt);
    let changed = false;
    let x = v.x;
    if p.kind == FX_FLOAT {
        changed = ui.number(p.name, &x, 0.01);
    } else if p.kind == FX_INT {
        ui.whole = true;
        if ui.number(p.name, &x, 0.05) {
            let n = int(x + 0.5);
            if x < 0 { n = int(x - 0.5); }
            changed = f32(n) != v.x;
            x = f32(n);
        }
        ui.whole = false;
    } else if p.kind == FX_BOOL {
        let on = x != 0;
        if ui.toggle(p.name, &on) {
            x = if on { 1 } else { 0 };
            changed = true;
        }
    } else {
        caption(ui, p.name);
        let c = *v;
        if colorRow(ui, salt, &c) {
            *v = c;
            changed = true;
        }
    }
    if p.kind != FX_COLOR { v.x = x; }
    ui.popId();
    return changed;
}

/// `<key>.x` and `<key>.y` side by side.
pub @j3ui matPair(ui: &Ui, w: &World, salt: int, key: string, fallback: f32, a: string, b: string) {
    let kx = Text.new(scratch(1));
    kx.pushStr(key);
    kx.pushStr(".x");
    let ky = Text.new(scratch(1));
    ky.pushStr(key);
    ky.pushStr(".y");
    let x = matF(w, kx.str(), fallback);
    let y = matF(w, ky.str(), fallback);
    ui.pushId(salt);
    let x0 = ui.x;
    let w0 = ui.w;
    let y0 = ui.y;
    ui.w = (w0 - 4) / 2;
    if ui.number(a, &x, 0.01) { putMatF(w, kx.str(), x); }
    ui.x = x0 + ui.w + 4;
    ui.y = y0;
    if ui.number(b, &y, 0.01) { putMatF(w, ky.str(), y); }
    ui.x = x0;
    ui.w = w0;
    popId();
}

pub @j3ui noisePanel(ui: &Ui, w: &World) {
    // The baked texture, as the objects get it.
    let img = scene3d.materialImage(w.path);
    let side = ui.w;
    if side > 200 { side = 200; }
    if img.id != 0 && ui.shown(ui.y, side) {
        let tex = Texture { raw: int(img.id) as ptr, w: img.w, h: img.h };
        game.drawTextureAt(tex, Vec2 { x: ui.x, y: ui.y }, Vec2 { x: side, y: side });
    }
    gap(side + 6);
    matCycle(ui, w, "Type", "noise.kind", PERLIN, "Smooth blobs (value)|Clouds (Perlin)|Cells|Stripes");
    let kind = matI(w, "noise.kind", PERLIN);
    if kind == CELLS {
        matCycle(ui, w, "Measure", "noise.cell", NEAREST, "Distance to nearest|Distance to second|Cracks between cells");
    }
    matWhole(ui, w, "Features across", "noise.scale", 8, 1, 64);
    matWhole(ui, w, "Seed", "noise.seed", 1, 0, 99999);
    matCycle(ui, w, "Layers", "noise.fractal", FBM, "One layer|Detail (fbm)|Ridges|Billows");
    if matI(w, "noise.fractal", FBM) != SINGLE {
        matWhole(ui, w, "Layer count", "noise.octaves", 4, 1, 8);
        matWhole(ui, w, "Layer size step", "noise.lacunarity", 2, 1, 4);
        matUnit(ui, w, "Layer strength", "noise.gain", 0.5);
    }
    let warp = matF(w, "noise.warp", 0);
    if ui.number("Swirl (warp)", &warp, 0.01) {
        if warp < 0 { warp = 0; }
        if warp > 4 { warp = 4; }
        putMatF(w, "noise.warp", warp);
    }
    let contrast = matF(w, "noise.contrast", 1);
    if ui.number("Contrast", &contrast, 0.01) {
        if contrast < 0 { contrast = 0; }
        putMatF(w, "noise.contrast", contrast);
    }
    let bright = matF(w, "noise.brightness", 0);
    if ui.number("Brightness", &bright, 0.005) { putMatF(w, "noise.brightness", bright); }
    matWhole(ui, w, "Bands (0 is smooth)", "noise.steps", 0, 0, 16);
    matUnit(ui, w, "Cut at (0 is off)", "noise.threshold", 0);
    let inverted = matI(w, "noise.invert", 0) != 0;
    if ui.toggle("Invert", &inverted) {
        let on = 0;
        if inverted { on = 1; }
        putMatI(w, "noise.invert", on);
    }
    let size = matI(w, "noise.size", 256);
    let t = Text.new(scratch(0));
    t.pushStr("Texture size: ");
    t.pushInt(size);
    t.pushStr(" px");
    button(t.str()) {
        size *= 2;
        if size > 512 { size = 64; }
        putMatI(w, "noise.size", size);
    }
    rampPanel(ui, w);
}

/// The noise's colors: 2 to 4 stops, each a color and where along the pattern it sits.
pub @j3ui rampPanel(ui: &Ui, w: &World) {
    caption(ui, "Colors, dark parts to light");
    let count = matI(w, "ramp.count", 0);
    if count < 2 {
        // Files from before ramps: their two noise colors become the first two stops.
        putRgbKey(&w.mat.file, "ramp.0", rgbKey(&w.mat.file, "noise.a", Vec3.xyz(0.2, 0.2, 0.2)));
        putRgbKey(&w.mat.file, "ramp.1", rgbKey(&w.mat.file, "noise.b", Vec3.xyz(0.9, 0.9, 0.9)));
        save.putFloat(&w.mat.file, "ramp.0.pos", 0);
        save.putFloat(&w.mat.file, "ramp.1.pos", 1);
        save.putInt(&w.mat.file, "ramp.count", 2);
        count = 2;
    }
    let i = 0;
    while i < count {
        let key = Text.new(scratch(1));
        key.pushStr("ramp.");
        key.pushInt(i);
        let name = own(scratch(1), key.str());
        key.pushStr(".pos");
        ui.pushId(500 + i);
        matColorRow(ui, w, 1, name, Vec3.xyz(0.5, 0.5, 0.5));
        if i > 0 && i < count - 1 { matUnit(ui, w, "Position", key.str(), f32(i) / f32(count - 1)); }
        popId();
        i += 1;
    }
    row() {
        if count < 4 && ui.button("+ Color") {
            // The new stop goes last; the old last one moves in to make room.
            matBefore(w);
            let last = Text.new(scratch(1));
            last.pushStr("ramp.");
            last.pushInt(count - 1);
            let lastName = own(scratch(1), last.str());
            let next = Text.new(scratch(1));
            next.pushStr("ramp.");
            next.pushInt(count);
            putRgbKey(&w.mat.file, next.str(), rgbKey(&w.mat.file, lastName, Vec3.xyz(1, 1, 1)));
            next.pushStr(".pos");
            save.putFloat(&w.mat.file, next.str(), 1);
            last.pushStr(".pos");
            save.putFloat(&w.mat.file, last.str(), 0.5 + 0.5 * f32(count - 2) / f32(count));
            save.putInt(&w.mat.file, "ramp.count", count + 1);
            matChanged(w);
        }
        if count > 2 && ui.button("- Color") {
            matBefore(w);
            let end = Text.new(scratch(1));
            end.pushStr("ramp.");
            end.pushInt(count - 2);
            end.pushStr(".pos");
            save.putFloat(&w.mat.file, end.str(), 1);
            save.putInt(&w.mat.file, "ramp.count", count - 1);
            matChanged(w);
        }
    }
}
