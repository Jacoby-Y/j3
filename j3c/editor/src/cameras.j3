// Scene cameras: the main one, viewing through one, and the preview inset.

module j3_editor.cameras;

use j3.gfx.Orbit;
use j3.math.{ Vec2, Vec3, asin, atan2 };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.CAMERA;
use j3_editor.console.say;
use j3_editor.history.modified;
use j3_editor.layout.{ viewMin, viewSize };
use j3_editor.shared.shared;
use j3_editor.types.World;

/// The camera games start with: the first one in the scene.
pub fn mainCamera(w: &World): int {
    let i = 0;
    while i < w.scene.len {
        if w.scene.nodes[i].kind == CAMERA && w.scene.nodes[i].owner == 0 { return w.scene.nodes[i].id; }
        i += 1;
    }
    return 0;
}

/// Make `id` the first camera, which games use at start.
pub fn setMainCamera(w: &World, id: int) {
    let first = mainCamera(w);
    if first == 0 || first == id { return; }
    scene3d.moveTo(&w.scene, id, scene3d.index(&w.scene, first));
    modified(w);
    say(w, "Main camera set; games start with it");
}

/// Look through camera `id` (0 goes back to the editor view).
pub fn viewThrough(w: &World, id: int) {
    if id == 0 {
        if w.viewCam != 0 { w.cam = w.savedCam; }
        w.viewCam = 0;
        return;
    }
    if w.viewCam == 0 { w.savedCam = w.cam; }
    w.viewCam = id;
    syncViewCam(w);
    say(w, "Looking through the camera; orbit, pan, or Esc to leave");
}

/// Put the orbit camera exactly where camera `viewCam` is, looking the way it looks.
pub fn syncViewCam(w: &World) {
    let at = scene3d.index(&w.scene, w.viewCam);
    if at < 0 || w.scene.nodes[at].kind != CAMERA {
        w.viewCam = 0;
        return;
    }
    w.cam = cameraOrbit(w, w.viewCam);
}

/// An orbit that sees what camera object `id` sees.
pub fn cameraOrbit(w: &World, id: int): Orbit {
    let model = scene3d.world(&w.scene, id);
    let eye = model.transformPoint(Vec3.xyz(0, 0, 0));
    let forward = (model.transformPoint(Vec3.xyz(0, 0, -1)) - eye).normalize();
    let o = w.cam;
    o.radius = 5;
    o.target = eye + forward * 5;
    o.pitch = asin(0 - forward.y);
    o.yaw = atan2(0 - forward.x, 0 - forward.z);
    return o;
}

/// The camera previewed in the viewport's corner: the locked one while it exists and isn't
/// being looked through, else the selected camera; 0 for none.
pub fn previewCam(w: &World): int {
    let locked = scene3d.index(&w.scene, w.previewLock);
    if locked >= 0 && w.scene.nodes[locked].kind == CAMERA && w.viewCam != w.previewLock { return w.previewLock; }
    let at = scene3d.index(&w.scene, w.selected);
    if at < 0 || w.scene.nodes[at].kind != CAMERA || w.viewCam != 0 || w.pickedCount > 1 { return 0; }
    return w.selected;
}

/// The preview's Lock/Unlock button: top-left corner and size.
pub fn lockBox(size: &Vec2): Vec2 {
    let box = Vec2 { x: 0, y: 0 };
    let at = previewBox(&box);
    *size = Vec2 { x: 64, y: 24 };
    return Vec2 { x: at.x + box.x - 70, y: at.y + 6 };
}

pub fn overLock(w: &World, p: Vec2): bool {
    if previewCam(w) == 0 { return false; }
    let size = Vec2 { x: 0, y: 0 };
    let at = lockBox(&size);
    return p.x >= at.x && p.x < at.x + size.x && p.y >= at.y && p.y < at.y + size.y;
}

/// Top-left corner and size of the camera preview.
pub fn previewBox(size: &Vec2): Vec2 {
    let lo = viewMin();
    let view = viewSize();
    let wide = view.x * 0.34;
    if wide < 180 { wide = 180; }
    let g = shared();
    *size = Vec2 { x: wide, y: wide / g.aspect };
    return Vec2 { x: lo.x + view.x - wide - 10, y: lo.y + 10 };
}

pub fn overPreview(w: &World, p: Vec2): bool {
    if previewCam(w) == 0 { return false; }
    let size = Vec2 { x: 0, y: 0 };
    let at = previewBox(&size);
    return p.x >= at.x && p.x < at.x + size.x && p.y >= at.y && p.y < at.y + size.y;
}

/// Front, side, or top: look along an axis, orthographic. Orbiting goes back to perspective.
pub fn axisView(w: &World, yaw: f32, pitch: f32) {
    viewThrough(w, 0);
    w.cam.yaw = yaw;
    // Straight down would leave no "up"; a hair less than 90 degrees looks the same.
    w.cam.pitch = pitch;
    w.ortho = true;
    w.axisView = true;
}
