// Panel and pane geometry, panel resizing, and moving tabs between panes.

module j3_editor.layout;

use j3.game;
use j3.math.Vec2;
use j3.memory.Arena;
use j3_editor.shared.shared;
use j3_editor.types.{
    AGENT_H, AGENT_W, BOTTOM, EDGE, MAX_PANES, RESIZE_CONSOLE, RESIZE_LEFT, RESIZE_NONE, RESIZE_PANE, RESIZE_RIGHT, RESIZE_SPLIT, SLOP, SNAP_H, SNAP_W, TABS, TOP, World,
};
use j3_editor.util.limit;

pub fn viewMin(): Vec2 { return Vec2 { x: paneX(shownPane()), y: TOP + TABS }; }

pub fn viewSize(): Vec2 {
    let win = game.windowSize();
    let wide = paneW(shownPane());
    let tall = win.y - TOP - TABS - BOTTOM - consoleH();
    if wide < 1 { wide = 1; }
    if tall < 1 { tall = 1; }
    return Vec2 { x: wide, y: tall };
}

/// The pane being drawn or taking input.
pub fn shownPane(): int {
    let g = shared();
    if g.drawPane >= 0 { return g.drawPane; }
    return g.focus;
}

/// Width of the area the panes share.
pub fn paneArea(): f32 {
    let g = shared();
    let win = game.windowSize();
    return win.x - g.left - g.right;
}

/// Left edge and width of pane `p`.
pub fn paneX(p: int): f32 {
    let g = shared();
    let x = g.left;
    let k = 0;
    while k < p && k < MAX_PANES {
        x += g.paneShare[k] * paneArea();
        k += 1;
    }
    return x;
}

pub fn paneW(p: int): f32 {
    let g = shared();
    if p < 0 || p >= MAX_PANES { return 1; }
    return g.paneShare[p] * paneArea();
}

/// The pane whose viewport (below its tab strip) is under `p`, or -1.
pub fn paneAt(p: Vec2): int {
    let g = shared();
    let win = game.windowSize();
    if p.y < TOP + TABS || p.y >= win.y - BOTTOM - consoleH() { return -1; }
    let k = 0;
    while k < g.panes {
        if p.x >= paneX(k) && p.x < paneX(k) + paneW(k) { return k; }
        k += 1;
    }
    return -1;
}

pub fn overViewport(p: Vec2): bool {
    let lo = viewMin();
    let size = viewSize();
    return p.x >= lo.x && p.x < lo.x + size.x && p.y >= lo.y && p.y < lo.y + size.y;
}

/// Height the console takes under the panes, 0 when hidden.
pub fn consoleH(): f32 {
    let g = shared();
    if !g.consoleOpen { return 0; }
    let win = game.windowSize();
    return limit(g.consoleHeight, 90, win.y - TOP - TABS - BOTTOM - 120);
}

/// Which edge (`RESIZE_*`) is under `p`.
pub fn edgeAt(w: &World, p: Vec2): int {
    let g = shared();
    let win = game.windowSize();
    if p.y < TOP || p.y > win.y - BOTTOM { return RESIZE_NONE; }
    if p.x > g.left - EDGE && p.x < g.left + EDGE { return RESIZE_LEFT; }
    let right = win.x - g.right;
    if p.x > right - EDGE && p.x < right + EDGE { return RESIZE_RIGHT; }
    let split = w.treeTop + w.treeRoom * g.treeShare + 3;
    if p.x < g.left - EDGE && p.y > split - EDGE && p.y < split + EDGE { return RESIZE_SPLIT; }
    let conTop = win.y - BOTTOM - consoleH();
    if g.consoleOpen && p.x > g.left && p.x < right && p.y > conTop - EDGE && p.y < conTop + EDGE {
        return RESIZE_CONSOLE;
    }
    let k = 1;
    while k < g.panes {
        let x = paneX(k);
        if p.x > x - EDGE && p.x < x + EDGE && p.y > TOP + TABS && p.y < conTop { return RESIZE_PANE + k - 1; }
        k += 1;
    }
    return RESIZE_NONE;
}

/// Over the Snap or Agent drop-down panel.
pub fn overSnap(w: &World, p: Vec2): bool {
    if w.showAgent && p.x >= w.agentLeft && p.x < w.agentLeft + AGENT_W && p.y < TOP + AGENT_H { return true; }
    return w.showSnap && p.x >= w.snapLeft && p.x < w.snapLeft + SNAP_W && p.y < TOP + SNAP_H;
}

pub fn treeDragging(w: &World): bool {
    return w.treeDrag != 0 && (game.mousePos() - w.treeFrom).length() > SLOP;
}

/// 1 or 2 when `mouse` is on the left or right quarter of pane `p` and another pane fits.
pub fn dropSide(p: int, mouse: Vec2): int {
    let g = shared();
    if g.panes >= MAX_PANES { return 0; }
    let x = (mouse.x - paneX(p)) / paneW(p);
    if x < 0.25 { return 1; }
    if x > 0.75 { return 2; }
    return 0;
}
