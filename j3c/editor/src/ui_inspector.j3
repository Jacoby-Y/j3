// Right panel: node inspector, script props, and scene settings.

module j3_editor.ui_inspector;

use j3.scene3d.editor.overrides;
use j3.game;
use j3.game.rgb;
use j3.io.printLn;
use j3.math.{ Vec3, PI };
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.gfx.{ FX_FLOAT, FX_BOOL, FX_COLOR };
use j3.scene3d.{ Scene, Node, MESH, CAMERA, INSTANCE, LIGHT, OPAQUE, CUTOUT, BLEND };
use j3.data.save;
use j3.text.{ Text, same };
use j3.ui.{ Ui, focusNext };
use j3_editor.commands.run;
use j3_editor.console.say;
use j3_editor.gizmo.clampScale;
use j3_editor.history.modified;
use j3_editor.overrides.{ fieldChanged, startPick };
use j3_editor.picker.colorRow;
use j3_editor.scenes.openMaterialTab;
use j3_editor.selection.{ scriptIndex, catalogKey, loadParams, nameOf, select };
use j3_editor.shared.shared;
use j3_editor.tabs.stash;
use j3_editor.types.{
    BOTTOM, CMD_DELETE, CMD_DUPLICATE, CMD_OPEN_SCENE, CMD_RESET, CMD_UNPARENT, TOP, World,
};
use j3_editor.ui_material.{ fxParam, materialPanel };
use j3_editor.ui_props.{ copyProps, sceneProps };
use j3_editor.util.{ clamp01, cut, isOnline, keep, lastPart, limit, nextOption, setText };
use j3_editor.widgets.{ caption, errorCaption, fitLeft, kindName, section, toolButton, vecRow };

/// Lighting for the whole scene, shown when nothing is selected.
pub @j3ui sceneSettings(ui: &Ui, w: &World) {
    let env = scene3d.environment(&w.scene);
    let changed = false;
    section(ui, "RENDERING (URP)");
    if env.urp || w.scene.urpChild.len > 0 {
        let keep = ui.theme.text;
        ui.theme.text = rgb(120, 200, 140);
        label("*Using URP");
        ui.theme.text = keep;
        if !env.urp {
            let from = Text.new(scratch(0));
            from.pushStr("from ");
            from.pushStr(w.scene.urpChild);
            caption(ui, fitLeft(w, from.str(), ui.w));
        }
    }
    if ui.toggle("URP: traced mirrors and glass", &env.urp) { changed = true; }
    if env.urp {
        let bounces = f32(env.bounces);
        let samples = f32(env.samples);
        ui.whole = true;
        if ui.number("Bounces", &bounces, 0.05) {
            env.bounces = int(limit(bounces, 1, 8) + 0.5);
            changed = true;
        }
        if ui.number("Rays per pixel", &samples, 0.05) {
            env.samples = int(limit(samples, 1, 16) + 0.5);
            changed = true;
        }
        ui.whole = false;
        if ui.toggle("Traced sun shadows", &env.tracedShadows) { changed = true; }
        if env.tracedShadows && ui.number("Traced shadow distance", &env.traceNear, 0.5) {
            if env.traceNear < 0 { env.traceNear = 0; }
            changed = true;
        }
        caption(ui, "Rays per pixel smooth rough mirrors.");
    }
    caption(ui, "Scenes placing this one use URP too.");
    section(ui, "SCENE LIGHTING");
    caption(ui, "Sun direction");
    if vecRow(ui, 11, &env.sunDir, 0.01) { changed = true; }
    caption(ui, "Sun color");
    if colorRow(ui, 12, &env.sunColor) { changed = true; }
    caption(ui, "Sky, fog, and ambient color");
    if colorRow(ui, 13, &env.sky) { changed = true; }
    if ui.number("Fog starts at", &env.fogStart, 0.5) { changed = true; }
    if ui.number("Fog is full at", &env.fogEnd, 0.5) { changed = true; }
    if ui.toggle("Sun shadows", &env.shadows) { changed = true; }
    if ui.number("Shadow area", &env.shadowSize, 0.2) { changed = true; }
    if changed {
        if env.fogStart < 0 { env.fogStart = 0; }
        if env.fogEnd < env.fogStart + 1 { env.fogEnd = env.fogStart + 1; }
        if env.shadowSize < 1 { env.shadowSize = 1; }
        scene3d.setEnvironment(&w.scene, env);
        modified(w);
    }
    sceneProps(ui, w);
}

pub @j3ui scriptProps(ui: &Ui, w: &World, n: &Node) {
    let script = scriptIndex(w, n.script);
    if script < 0 {
        if n.script.len > 0 { caption(ui, "No script at that path (Rescan after adding one)"); }
        return;
    }
    let count = save.getInt(&w.catalog, catalogKey(w, script, -1, "count"), 0);
    if count > w.paramEdits.len { caption(ui, "Only the first 64 fields are shown"); }
    let j = 0;
    while j < count && j < w.paramEdits.len {
        let field = save.getStr(&w.catalog, catalogKey(w, script, j, "name"), "");
        let kind = save.getStr(&w.catalog, catalogKey(w, script, j, "type"), "");
        ui.pushId(j);
        if same(kind, "f32") {
            let value = scene3d.number(&w.scene, n.id, field,
                save.getFloat(&w.catalog, catalogKey(w, script, j, "value"), 0));
            if ui.number(field, &value, 0.02) {
                scene3d.setNumber(&w.scene, n.id, field, value);
                fieldChanged(w, n.id, field);
            }
        } else if same(kind, "bool") {
            let enabled = scene3d.flag(&w.scene, n.id, field,
                save.getInt(&w.catalog, catalogKey(w, script, j, "value"), 0) != 0);
            if ui.toggle(field, &enabled) {
                scene3d.setFlag(&w.scene, n.id, field, enabled);
                fieldChanged(w, n.id, field);
            }
        } else if same(kind, "string") {
            caption(ui, field);
            if ui.field(field, &w.paramEdits[j]) {
                scene3d.setLabel(&w.scene, n.id, field, w.paramEdits[j].str());
                fieldChanged(w, n.id, field);
            }
        } else if same(kind, "int") {
            let whole = scene3d.integer(&w.scene, n.id, field,
                save.getInt(&w.catalog, catalogKey(w, script, j, "value"), 0));
            let shown = f32(whole);
            ui.whole = true;
            if ui.number(field, &shown, 0.1) {
                let rounded = int(shown + 0.5);
                if shown < 0 { rounded = int(shown - 0.5); }
                if rounded != whole {
                    scene3d.setInteger(&w.scene, n.id, field, rounded);
                    fieldChanged(w, n.id, field);
                }
            }
            ui.whole = false;
        } else if same(kind, "vec3") || same(kind, "color") {
            let fallback = Vec3.xyz(save.getFloat(&w.catalog, catalogKey(w, script, j, "x"), 0),
                save.getFloat(&w.catalog, catalogKey(w, script, j, "y"), 0),
                save.getFloat(&w.catalog, catalogKey(w, script, j, "z"), 0));
            let triple = scene3d.vector(&w.scene, n.id, field, fallback);
            caption(ui, field);
            let changed = false;
            if same(kind, "color") { changed = colorRow(ui, 20, &triple); } else { changed = vecRow(ui, 20, &triple, 0.02); }
            if changed {
                scene3d.setVector(&w.scene, n.id, field, triple);
                fieldChanged(w, n.id, field);
            }
        } else if same(kind, "choice") {
            let options = save.getStr(&w.catalog, catalogKey(w, script, j, "options"), "");
            let current = scene3d.label(&w.scene, n.id, field,
                save.getStr(&w.catalog, catalogKey(w, script, j, "default"), ""));
            let label = Text.new(scratch(0));
            label.pushStr(field);
            label.pushStr(": ");
            label.pushStr(current);
            button(label.str()) {
                scene3d.setLabel(&w.scene, n.id, field, nextOption(options, current));
                fieldChanged(w, n.id, field);
            }
        } else if same(kind, "asset") {
            caption(ui, field);
            row() {
                if toolButton(ui, "Pick", w.pickFor == n.id && same(w.pickField.str(), field)) {
                    startPick(w, n.id, field, false);
                }
                if ui.field(field, &w.paramEdits[j]) {
                    scene3d.setLabel(&w.scene, n.id, field, w.paramEdits[j].str());
                    fieldChanged(w, n.id, field);
                }
            }
        } else if same(kind, "object") {
            let target = scene3d.object(&w.scene, n.id, field);
            let caption2 = Text.new(scratch(0));
            caption2.pushStr(field);
            caption2.pushStr(": ");
            if target == 0 {
                caption2.pushStr("none");
            } else if scene3d.index(&w.scene, target) < 0 {
                caption2.pushStr("missing");
            } else {
                caption2.pushStr(nameOf(w, target));
            }
            row() {
                if toolButton(ui, caption2.str(), w.pickFor == n.id && same(w.pickField.str(), field)) {
                    startPick(w, n.id, field, true);
                }
                if target != 0 && ui.button("x") {
                    scene3d.setObject(&w.scene, n.id, field, 0);
                    fieldChanged(w, n.id, field);
                }
            }
        }
        popId();
        j += 1;
    }
}

pub @j3ui inspector(ui: &Ui, w: &World, n: &Node) {
    if n.owner != 0 {
        section(ui, "PLACED OBJECT");
        let host = scene3d.index(&w.scene, n.owner);
        if host >= 0 { caption(ui, w.scene.nodes[host].scene); }
        caption(ui, "Changes here apply to this copy only.");
        if overrides.hasOverrides(&w.scene, n.id) && ui.button("Revert to the scene file") {
            overrides.clearOverrides(&w.scene, n.id);
            scene3d.refresh(&w.scene, w.path);
            modified(w);
            select(w, n.id);
            say(w, "Reverted");
            return;
        }
    }
    caption(ui, "Name (F2)");
    if w.renameNow {
        focusNext();
        w.renameNow = false;
    }
    if ui.field("Name", &w.nameEdit) {
        n.name = keep(w, w.nameEdit.str());
        modified(w);
    }
    let idText = Text.new(scratch(0));
    idText.pushStr(kindName(n.kind));
    // Placed objects' ids are made on load, so they mean nothing to the user.
    if n.owner == 0 {
        idText.pushStr(" object, id ");
        idText.pushInt(n.id);
    }
    if n.parent != 0 {
        idText.pushStr(", in ");
        idText.pushStr(nameOf(w, n.parent));
    }
    caption(ui, idText.str());
    if n.owner != 0 {
    } else if n.parent != 0 {
        button("Move to top level") { run(w, CMD_UNPARENT); }
    } else {
        caption(ui, "Drag it onto another object in the");
        caption(ui, "hierarchy to make it a child.");
    }

    section(ui, "TRANSFORM");
    caption(ui, "Position");
    if vecRow(ui, 1, &n.position, 0.02) { modified(w); }
    caption(ui, "Rotation (degrees)");
    let degrees = n.rotation * (f32(180) / PI);
    if vecRow(ui, 2, &degrees, 0.5) {
        n.rotation = degrees * (PI / f32(180));
        modified(w);
    }
    caption(ui, "Scale");
    let oldScale = n.scale;
    if vecRow(ui, 3, &n.scale, 0.01) {
        if n.scale.x != oldScale.x { n.scale.x = clampScale(n.scale.x); }
        if n.scale.y != oldScale.y { n.scale.y = clampScale(n.scale.y); }
        if n.scale.z != oldScale.z { n.scale.z = clampScale(n.scale.z); }
        modified(w);
    }
    button("Reset transform") { run(w, CMD_RESET); }

    if n.kind == MESH {
        section(ui, "MESH");
        caption(ui, "Shape");
        let file = w.meshPath || !scene3d.isBuiltin(n.asset);
        let shape = "";
        row() {
            if toolButton(ui, "Cube", !file && same(n.asset, "builtin:cube")) { shape = "builtin:cube"; }
            if toolButton(ui, "Sphere", !file && same(n.asset, "builtin:sphere")) { shape = "builtin:sphere"; }
            if toolButton(ui, "Quad", !file && same(n.asset, "builtin:quad")) { shape = "builtin:quad"; }
        }
        row() {
            if toolButton(ui, "Plane", !file && same(n.asset, "builtin:plane")) { shape = "builtin:plane"; }
            if toolButton(ui, "Sky", !file && same(n.asset, "builtin:sky")) { shape = "builtin:sky"; }
            if toolButton(ui, "File...", file) { w.meshPath = true; }
        }
        row() {
            if toolButton(ui, "Cylinder", !file && same(n.asset, "builtin:cylinder")) { shape = "builtin:cylinder"; }
            if toolButton(ui, "Cone", !file && same(n.asset, "builtin:cone")) { shape = "builtin:cone"; }
            if toolButton(ui, "Capsule", !file && same(n.asset, "builtin:capsule")) { shape = "builtin:capsule"; }
            if toolButton(ui, "Torus", !file && same(n.asset, "builtin:torus")) { shape = "builtin:torus"; }
        }
        if shape.len > 0 && !same(shape, n.asset) {
            w.meshPath = false;
            n.asset = keep(w, shape);
            setText(&w.assetEdit, shape);
            scene3d.reload(&w.scene, n.id);
            modified(w);
        } else if shape.len > 0 {
            w.meshPath = false;
        }
        if file {
            caption(ui, "Mesh file (or drag one on from Assets)");
            if ui.field("assets/model.j3mesh", &w.assetEdit) {
                n.asset = keep(w, w.assetEdit.str());
                scene3d.reload(&w.scene, n.id);
                modified(w);
            }
        }
        caption(ui, "Texture");
        if ui.field("assets/texture.png", &w.textureEdit) {
            n.texture = keep(w, w.textureEdit.str());
            scene3d.reload(&w.scene, n.id);
            modified(w);
        }
        caption(ui, "Material (drag one on; click it to edit)");
        if n.material.len > 0 {
            row() {
                button(fitLeft(w, n.material, ui.w - 80)) { openMaterialTab(w, n.material); }
                button("x") {
                    n.material = "";
                    scene3d.reload(&w.scene, n.id);
                    modified(w);
                }
            }
        } else {
            caption(ui, "none");
        }
        let sided = n.doubleSided;
        if ui.toggle("Double sided", &sided) {
            n.doubleSided = sided;
            modified(w);
        }
        let look = "Opaque";
        if n.alpha == CUTOUT { look = "Cutout (texture alpha)"; }
        if n.alpha == BLEND { look = "See-through"; }
        let t = Text.new(scratch(0));
        t.pushStr("Transparency: ");
        t.pushStr(look);
        button(t.str()) {
            n.alpha += 1;
            if n.alpha > BLEND { n.alpha = OPAQUE; }
            modified(w);
        }
        if n.alpha == BLEND && ui.number("Opacity", &n.opacity, 0.005) {
            n.opacity = clamp01(n.opacity);
            modified(w);
        }
        button("Reload mesh and texture") {
            stash(w);
            let scenes = scratch(0).alloc::<Scene>(w.tabCount);
            let s = 0;
            while s < w.tabCount {
                scenes[s] = w.tabs[s].scene;
                s += 1;
            }
            if !scene3d.rebuild(n.asset, n.texture, scenes) {
                say(w, "Mesh could not be loaded");
            } else {
                say(w, "Reloaded");
            }
        }
    }
    if n.kind == INSTANCE && n.owner == 0 {
        section(ui, "SCENE");
        caption(ui, n.scene);
        let open = n.editable;
        if ui.toggle("Edit placed objects", &open) { n.editable = open; }
        button("Open scene") {
            w.menuFile = n.scene;
            run(w, CMD_OPEN_SCENE);
            return;
        }
        caption(ui, "Edit it in its own tab; changes show");
        caption(ui, "up here once that scene is saved.");
        copyProps(ui, w, n);
    }
    if n.kind == CAMERA {
        section(ui, "CAMERA");
        if ui.number("FOV", &n.fov, 0.2) {
            if n.fov < 20 { n.fov = 20; }
            if n.fov > 120 { n.fov = 120; }
            modified(w);
        }
        if ui.number("Near", &n.near, 0.005) {
            if n.near < 0.01 { n.near = 0.01; }
            modified(w);
        }
        if ui.number("Far", &n.far, 1) {
            if n.far < n.near + 1 { n.far = n.near + 1; }
            modified(w);
        }
        cameraEffects(ui, w, n);
    }
    if n.kind == MESH || n.kind == INSTANCE {
        caption(ui, "Tint (1 is unchanged; above 1 brightens)");
        if colorRow(ui, 5, &n.tint) {
            modified(w);
            if n.kind == INSTANCE {
                // Placed copies multiply the new tint in; `n` may move, so stop drawing here.
                scene3d.refresh(&w.scene, w.path);
                return;
            }
        }
    }
    if n.kind == LIGHT {
        section(ui, "LIGHT");
        caption(ui, "Color (red, green, blue; 1 is full)");
        if colorRow(ui, 4, &n.color) { modified(w); }
        if ui.number("Range", &n.range, 0.05) {
            if n.range < 0.1 { n.range = 0.1; }
            modified(w);
        }
        caption(ui, "The first 4 lights in a scene shine.");
    }

    section(ui, "SCRIPT");
    caption(ui, "Script (scripts/*.j3s)");
    if ui.field("none", &w.scriptEdit) {
        n.script = keep(w, w.scriptEdit.str());
        loadParams(w);
        modified(w);
    }
    scriptProps(ui, w, n);
    caption(ui, "Tags (comma-separated; launch=30 has a value)");
    if ui.field("none", &w.tagsEdit) {
        n.tags = keep(w, w.tagsEdit.str());
        modified(w);
    }

    gap(10);
    let remove = false;
    row() {
        button("Duplicate") { run(w, CMD_DUPLICATE); }
        let keepButton = ui.theme.button;
        let keepHot = ui.theme.buttonHot;
        ui.theme.button = rgb(120, 48, 48);
        ui.theme.buttonHot = rgb(150, 60, 60);
        remove = ui.button("Delete (Del)");
        ui.theme.button = keepButton;
        ui.theme.buttonHot = keepHot;
    }
    if remove { run(w, CMD_DELETE); }
}

pub @j3ui rightPanel(ui: &Ui, w: &World) {
    let g = shared();
    let win = game.windowSize();
    ui.x = win.x - g.right + 12;
    ui.y = TOP + 6;
    ui.w = g.right - 20;
    scroll(102, win.y - TOP - BOTTOM - 12) {
        if w.matTab {
            materialPanel(ui, w);
            ui.end();
            return;
        }
        if isOnline(w.path) {
            section(ui, "GET ASSETS");
            caption(ui, "Pick an asset in the grid to see it");
            caption(ui, "and bring it into the project.");
            ui.end();
            return;
        }
        section(ui, "INSPECTOR");
        if w.pickedCount > 1 {
            let t = Text.new(scratch(0));
            t.pushInt(w.pickedCount);
            t.pushStr(" selected, showing the last clicked");
            caption(ui, t.str());
        }
        let at = scene3d.index(&w.scene, w.selected);
        if at < 0 {
            caption(ui, "Nothing selected.");
            caption(ui, "Click an object in the viewport or");
            caption(ui, "hierarchy. Right-click for actions.");
            sceneSettings(ui, w);
        } else {
            inspector(ui, w, &w.scene.nodes[at]);
        }
        section(ui, "PROJECT");
        caption(ui, "New script");
        field("script_name", &w.newScript);
        button("Create script") {
            if w.newScript.len() == 0 {
                say(w, "Type a script name first");
            } else {
                let scriptCommand = Text.new(scratch(0));
                scriptCommand.pushStr("J3EDITOR SCRIPT ");
                scriptCommand.pushStr(w.newScript.str());
                printLn(scriptCommand.str());
            }
        }
    }
}

/// A camera's `.j3fx` effects: the list in run order, and every param they declare.
pub @j3ui cameraEffects(ui: &Ui, w: &World, n: &Node) {
    section(ui, "EFFECTS");
    let list = n.effects;
    let count = 0;
    let a = 0;
    while a < list.len {
        let b = a;
        while b < list.len && list[b] != 124 { b += 1; }
        let path = cut(list, a, b);
        ui.pushId(800 + count);
        let move = 0;
        row() {
            label(fitLeft(w, lastPart(path), ui.w));
            button("Up") { move = 1; }
            button("Down") { move = 2; }
            button("x") { move = 3; }
        }
        popId();
        let broken = scene3d.effectError(path);
        if broken.len > 0 { errorCaption(ui, broken); }
        if move != 0 {
            n.effects = keep(w, reorder(list, count, move));
            modified(w);
            return;
        }
        count += 1;
        a = b + 1;
    }
    caption(ui, if count == 0 { "Click a camera effect under Assets to add it" } else { "Click another under Assets to add it" });
    let keys = []string { ptr: 0 as &string, len: 0 };
    let params = scene3d.cameraFxParams(&w.scene, n.id, &keys, scratch(0));
    let k = 0;
    while k < params.len {
        let p = params[k];
        let key = keys[k];
        let v = Vec3.xyz(p.def[0], p.def[1], p.def[2]);
        if p.kind == FX_COLOR { v = scene3d.vector(&w.scene, n.id, key, v); }
        else if p.kind == FX_FLOAT { v.x = scene3d.number(&w.scene, n.id, key, p.def[0]); }
        else if p.kind == FX_BOOL { v.x = if scene3d.flag(&w.scene, n.id, key, p.def[0] != 0) { 1 } else { 0 }; }
        else { v.x = f32(scene3d.integer(&w.scene, n.id, key, int(p.def[0]))); }
        if fxParam(ui, p, &v, 850 + k) {
            if p.kind == FX_COLOR { scene3d.setVector(&w.scene, n.id, key, v); }
            else if p.kind == FX_FLOAT { scene3d.setNumber(&w.scene, n.id, key, v.x); }
            else if p.kind == FX_BOOL { scene3d.setFlag(&w.scene, n.id, key, v.x != 0); }
            else { scene3d.setInteger(&w.scene, n.id, key, int(v.x)); }
            fieldChanged(w, n.id, key);
        }
        k += 1;
    }
}

/// `list` (`a|b|c`) with entry `at` moved up (1), down (2), or removed (3), into scratch.
fn reorder(list: string, at: int, move: int): string {
    let parts: [8]string = ["", "", "", "", "", "", "", ""];
    let count = 0;
    let a = 0;
    while a < list.len && count < 8 {
        let b = a;
        while b < list.len && list[b] != 124 { b += 1; }
        parts[count] = cut(list, a, b);
        count += 1;
        a = b + 1;
    }
    let other = if move == 1 { at - 1 } else { at + 1 };
    if move != 3 && other >= 0 && other < count {
        let t = parts[at];
        parts[at] = parts[other];
        parts[other] = t;
    }
    let out = Text.new(scratch(0));
    let i = 0;
    while i < count {
        if !(move == 3 && i == at) {
            if out.len() > 0 { out.push(124); }
            out.pushStr(parts[i]);
        }
        i += 1;
    }
    // Past 8 entries (only 8 run) the rest is kept as it was, not dropped.
    if a < list.len {
        if out.len() > 0 { out.push(124); }
        out.pushStr(cut(list, a, list.len));
    }
    return out.str();
}
