// The color picker popup and the color row that opens it.

module j3_editor.picker;

use j3.game;
use j3.gfx.canvas.{ Canvas, Mode };
use j3.game.{ rgb, rgba };
use j3.math.{ Vec2, Vec3, floor };
use j3.memory.{ Arena, scratch };
use j3.text.Text;
use j3.ui.{ Ui, typing, clearFocus };
use j3_editor.prefs.savePrefs;
use j3_editor.shared.shared;
use j3_editor.types.World;
use j3_editor.util.{ clamp01, max, min, mouseIn, setText, toColor };
use j3_editor.widgets.{ fill, outline, tripleRow };

pub const PICKER_W: f32 = 244;
pub const PICKER_H: f32 = 306;
/// Texels across the baked square and down the hue bar; filtering smooths the rest.
const BAKE: i32 = 64;

/// A `w`×`h` picker texture in scratch memory: the saturation/value square for `hue`, or the
/// hue bar when `hue < 0`. Texel centers hold exact colors, so the stretched image matches
/// what a click at the same spot picks.
fn bake(w: i32, h: i32, hue: f32): Canvas {
    let c = Canvas.create(scratch(0), w, h, Mode.Smooth);
    let y: i32 = 0;
    while y < h {
        let x: i32 = 0;
        while x < w {
            let v = (f32(y) + 0.5) / f32(h);
            let rgb = hsvToRgb(Vec3.xyz(v, 1, 1));
            if hue >= 0 { rgb = hsvToRgb(Vec3.xyz(hue, (f32(x) + 0.5) / f32(w), 1 - v)); }
            let at = (int(y) * int(w) + int(x)) * 4;
            c.pixels[at] = u8(clamp01(rgb.x) * 255 + 0.5);
            c.pixels[at + 1] = u8(clamp01(rgb.y) * 255 + 0.5);
            c.pixels[at + 2] = u8(clamp01(rgb.z) * 255 + 0.5);
            c.pixels[at + 3] = 255;
            x += 1;
        }
        y += 1;
    }
    return c;
}

/// A swatch with its hex code. Clicking it opens the color picker; while the picker is
/// open for this row, its changes land in `value` and the row returns true.
pub fn colorRow(ui: &Ui, salt: int, value: &Vec3): bool {
    let g = shared();
    ui.pushId(salt);
    let id = ui.widget("color");
    let x = ui.x;
    let y = ui.y;
    let wide = ui.w;
    let tall = ui.h;
    let changed = false;
    if g.pick.id == id && g.pick.changed {
        *value = g.pick.rgb;
        g.pick.changed = false;
        changed = true;
    }
    if g.pick.id == id && g.pick.shut { g.pick.id = 0; }
    if ui.button("") {
        g.pick.id = id;
        g.pick.rgb = *value;
        g.pick.old = *value;
        g.pick.hsv = rgbToHsv(*value);
        g.pick.at = Vec2 { x: x - PICKER_W - 12, y: y };
        g.pick.changed = false;
        g.pick.shut = false;
        g.pick.fresh = true;
        g.pick.drag = 0;
        clearFocus();
    }
    ui.popId();
    if ui.shown(y, tall) {
        let edge = rgb(20, 22, 27);
        if g.pick.id == id { edge = ui.theme.accent; }
        fill(x + 4, y + 4, wide - 96, tall - 8, edge);
        fill(x + 5, y + 5, wide - 98, tall - 10, toColor(*value));
        if ui.font.raw != 0 {
            game.setColor(ui.theme.text);
            game.drawText(ui.font, Vec2 { x: x + wide - 84, y: y + 4 }, hexOf(*value));
        }
    }
    return changed;
}

/// "#RRGGBB".
pub fn hexOf(v: Vec3): string {
    let digits = "0123456789ABCDEF";
    let t = Text.new(scratch(1));
    t.push(35);
    let k = 0;
    while k < 3 {
        let c = v.x;
        if k == 1 { c = v.y; }
        if k == 2 { c = v.z; }
        let n = int(clamp01(c) * 255 + 0.5);
        t.push(digits[n / 16]);
        t.push(digits[n - (n / 16) * 16]);
        k += 1;
    }
    return t.str();
}

pub fn hexDigit(c: u8): int {
    if c >= 48 && c <= 57 { return int(c) - 48; }
    if c >= 97 && c <= 102 { return int(c) - 87; }
    if c >= 65 && c <= 70 { return int(c) - 55; }
    return -1;
}

/// Parse "#RRGGBB" or "RRGGBB" into `out`; false when it isn't one.
pub fn parseHex(s: string, out: &Vec3): bool {
    let start = 0;
    if s.len > 0 && s[0] == 35 { start = 1; }
    if s.len - start != 6 { return false; }
    let k = 0;
    while k < 6 {
        if hexDigit(s[start + k]) < 0 { return false; }
        k += 1;
    }
    *out = Vec3.xyz(hexByte(s, start), hexByte(s, start + 2), hexByte(s, start + 4));
    return true;
}

/// The two hex digits at `at`, as 0..1.
pub fn hexByte(s: string, at: int): f32 {
    return f32(hexDigit(s[at]) * 16 + hexDigit(s[at + 1])) / 255;
}

/// Hue, saturation, and value, all 0..1.
pub fn rgbToHsv(c: Vec3): Vec3 {
    let hi = max(c.x, max(c.y, c.z));
    let lo = min(c.x, min(c.y, c.z));
    let d = hi - lo;
    let h: f32 = 0;
    if d > 0.00001 {
        if hi == c.x { h = (c.y - c.z) / d; }
        else if hi == c.y { h = 2 + (c.z - c.x) / d; }
        else { h = 4 + (c.x - c.y) / d; }
        h = h / 6;
        if h < 0 { h += 1; }
    }
    let sat: f32 = 0;
    if hi > 0.00001 { sat = d / hi; }
    return Vec3.xyz(h, sat, hi);
}

pub fn hsvToRgb(c: Vec3): Vec3 {
    let h = (c.x - floor(c.x)) * 6;
    let i = int(floor(h));
    let f = h - f32(i);
    let v = c.z;
    let p = v * (1 - c.y);
    let q = v * (1 - c.y * f);
    let t = v * (1 - c.y * (1 - f));
    if i == 0 { return Vec3.xyz(v, t, p); }
    if i == 1 { return Vec3.xyz(q, v, p); }
    if i == 2 { return Vec3.xyz(p, v, t); }
    if i == 3 { return Vec3.xyz(p, q, v); }
    if i == 4 { return Vec3.xyz(t, p, v); }
    return Vec3.xyz(v, p, q);
}

/// Set the picker's color from outside the square (hex, numbers, recent, revert).
pub fn pickRgb(c: Vec3) {
    let g = shared();
    g.pick.rgb = Vec3.xyz(clamp01(c.x), clamp01(c.y), clamp01(c.z));
    let hsv = rgbToHsv(g.pick.rgb);
    // A gray has no hue of its own; keep the one the user had.
    if hsv.y < 0.00001 { hsv.x = g.pick.hsv.x; }
    g.pick.hsv = hsv;
    g.pick.changed = true;
}

pub fn closePicker() {
    let g = shared();
    if g.pick.id == 0 || g.pick.shut { return; }
    g.pick.shut = true;
    let moved = g.pick.rgb - g.pick.old;
    if moved.length() < 0.001 { return; }
    // Newest first, no repeats.
    let i = 0;
    let fresh = scratch(1).alloc::<Vec3>(8);
    fresh[0] = g.pick.rgb;
    let keep = 1;
    while i < g.recentN && keep < 8 {
        let gap = g.recent[i] - g.pick.rgb;
        if gap.length() > 0.001 {
            fresh[keep] = g.recent[i];
            keep += 1;
        }
        i += 1;
    }
    i = 0;
    while i < keep {
        g.recent[i] = fresh[i];
        i += 1;
    }
    g.recentN = keep;
}

/// The color picker popup: saturation/value square, hue bar, old and new swatches, hex,
/// 0-255 numbers, and recent colors. Esc reverts, Enter or a click outside keeps.
pub @j3ui drawColorPicker(ui: &Ui, w: &World) {
    let g = shared();
    if g.pick.id == 0 { return; }
    if g.pick.shut {
        g.pick.id = 0;
        savePrefs(w);
        return;
    }
    let win = game.windowSize();
    let at = g.pick.at;
    if at.x < 4 { at.x = 4; }
    if at.y + PICKER_H > win.y - 4 { at.y = win.y - 4 - PICKER_H; }
    if at.y < 4 { at.y = 4; }
    g.pick.at = at;
    let mouse = game.mousePos();
    let inside = mouse.x >= at.x && mouse.x < at.x + PICKER_W && mouse.y >= at.y && mouse.y < at.y + PICKER_H;
    if game.keyPressed(game.Key.Escape) {
        pickRgb(g.pick.old);
        closePicker();
        return;
    }
    if game.keyPressed(game.Key.Enter) && !typing() {
        closePicker();
        return;
    }
    if g.pick.fresh {
        g.pick.fresh = false;
    } else if !inside && g.pick.drag == 0 && (game.mousePressed(game.Mouse.Left) || game.mousePressed(game.Mouse.Right)) {
        closePicker();
        return;
    }
    fill(at.x + 3, at.y + 5, PICKER_W, PICKER_H, rgba(0, 0, 0, 90));
    fill(at.x - 1, at.y - 1, PICKER_W + 2, PICKER_H + 2, rgb(14, 15, 19));
    fill(at.x, at.y, PICKER_W, PICKER_H, rgb(44, 48, 57));
    // Saturation across, value down, and the hue bar: small baked textures the GPU stretches smoothly.
    let sx = at.x + 10;
    let sy = at.y + 10;
    let sw: f32 = 180;
    let sh: f32 = 150;
    let hx = sx + sw + 10;
    let hw: f32 = 34;
    if g.pick.hues.raw == 0 {
        g.pick.hues = game.textureFromCanvas(bake(1, BAKE, -1));
        g.pick.square = game.textureFromCanvas(bake(BAKE, BAKE, g.pick.hsv.x));
        g.pick.squareHue = g.pick.hsv.x;
    }
    if g.pick.squareHue != g.pick.hsv.x {
        game.updateTextureFromCanvas(g.pick.square, bake(BAKE, BAKE, g.pick.hsv.x), 0, 0, BAKE, BAKE);
        g.pick.squareHue = g.pick.hsv.x;
    }
    game.setColor(rgb(255, 255, 255));
    game.drawTextureAt(g.pick.square, Vec2 { x: sx, y: sy }, Vec2 { x: sw, y: sh });
    game.drawTextureAt(g.pick.hues, Vec2 { x: hx, y: sy }, Vec2 { x: hw, y: sh });
    if game.mousePressed(game.Mouse.Left) {
        if mouseIn(sx, sy, sw, sh) { g.pick.drag = 1; }
        if mouseIn(hx, sy, hw, sh) { g.pick.drag = 2; }
    }
    if !game.mouseDown(game.Mouse.Left) { g.pick.drag = 0; }
    if g.pick.drag == 1 {
        g.pick.hsv.y = clamp01((mouse.x - sx) / sw);
        g.pick.hsv.z = clamp01(1 - (mouse.y - sy) / sh);
    }
    if g.pick.drag == 2 { g.pick.hsv.x = clamp01((mouse.y - sy) / sh); }
    if g.pick.drag != 0 {
        g.pick.rgb = hsvToRgb(g.pick.hsv);
        g.pick.changed = true;
    }
    // Markers: a ring on the square, a bar on the hue strip.
    let mx = sx + g.pick.hsv.y * sw;
    let my = sy + (1 - g.pick.hsv.z) * sh;
    outline(mx - 6, my - 6, 12, 12, rgb(255, 255, 255));
    outline(mx - 4, my - 4, 8, 8, rgb(0, 0, 0));
    let hy = sy + g.pick.hsv.x * sh;
    fill(hx - 2, hy - 2, hw + 4, 4, rgb(255, 255, 255));
    fill(hx - 2, hy - 1, hw + 4, 2, rgb(0, 0, 0));
    // Old | new; click the old one to go back.
    let y = sy + sh + 10;
    let half = (PICKER_W - 24) / 2;
    fill(sx, y, half, 24, toColor(g.pick.old));
    fill(sx + half + 4, y, half, 24, toColor(g.pick.rgb));
    if mouseIn(sx, y, half, 24) && game.mousePressed(game.Mouse.Left) { pickRgb(g.pick.old); }
    ui.x = sx;
    ui.y = y + 32;
    ui.w = PICKER_W - 20;
    ui.pushId(88001);
    if !typing() { setText(&w.colorHex, hexOf(g.pick.rgb)); }
    if ui.field("#RRGGBB", &w.colorHex) {
        let typed = g.pick.rgb;
        if parseHex(w.colorHex.str(), &typed) { pickRgb(typed); }
    }
    let bytes = g.pick.rgb * 255;
    ui.whole = true;
    if tripleRow(ui, 88002, &bytes, 1, "R", "G", "B") { pickRgb(bytes * (f32(1) / 255)); }
    ui.whole = false;
    popId();
    // Recent colors.
    let ry = ui.y + 2;
    let cell = (PICKER_W - 20 - 7 * 4) / 8;
    let r = 0;
    while r < g.recentN {
        let rx = sx + f32(r) * (cell + 4);
        fill(rx - 1, ry - 1, cell + 2, 22, rgb(20, 22, 27));
        fill(rx, ry, cell, 20, toColor(g.recent[r]));
        if mouseIn(rx, ry, cell, 20) && game.mousePressed(game.Mouse.Left) { pickRgb(g.recent[r]); }
        r += 1;
    }
    if g.recentN == 0 && ui.font.raw != 0 {
        game.setColor(rgb(150, 156, 170));
        game.drawText(ui.font, Vec2 { x: sx, y: ry }, "Recent colors show here");
    }
}
