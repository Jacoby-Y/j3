// Edits to nodes placed from another scene, stored as overrides on the instance.

module j3_editor.overrides;

use j3.scene3d.editor.overrides;
use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.Node;
use j3.text.{ Text, same };
use j3_editor.console.say;
use j3_editor.history.{ modified, sameVec };
use j3_editor.types.{
    CMD_CLOSE_TAB, CMD_DELETE_ASSET, CMD_EDIT_MATERIAL, CMD_FOCUS, CMD_NEW_SCENE, CMD_OPEN_SCENE, CMD_PICK_FILE, CMD_RENAME, CMD_RENAME_ASSET, CMD_RESET, CMD_SCATTER, CMD_VIEW_CAMERA, World,
};
use j3_editor.util.setText;

/// A script prop of object `id` changed. On a placed object it becomes an override,
/// since placed objects' own field values aren't saved.
pub fn fieldChanged(w: &World, id: int, field: string) {
    if isPlaced(w, id) {
        overrides.overrideParam(&w.scene, id, field);
        let parts = "xyz";
        let k = 0;
        while k < 3 {
            let t = Text.new(scratch(0));
            t.pushStr(field);
            t.push(46);
            t.push(parts[k]);
            overrides.overrideParam(&w.scene, id, t.str());
            k += 1;
        }
    }
    modified(w);
}

pub fn isPlaced(w: &World, id: int): bool {
    let at = scene3d.index(&w.scene, id);
    return at >= 0 && w.scene.nodes[at].owner != 0;
}

/// Commands that only change a placed object's values, not the hierarchy its file defines.
pub fn allowedOnPlaced(cmd: int): bool {
    return cmd == CMD_RENAME || cmd == CMD_FOCUS || cmd == CMD_RESET || cmd == CMD_VIEW_CAMERA
        || cmd == CMD_OPEN_SCENE || cmd == CMD_NEW_SCENE || cmd == CMD_CLOSE_TAB
        || cmd == CMD_RENAME_ASSET || cmd == CMD_DELETE_ASSET || cmd == CMD_PICK_FILE || cmd == CMD_EDIT_MATERIAL
        || cmd == CMD_SCATTER;
}

/// After an edit to a placed object settles, keep what changed as overrides of its placement.
pub fn syncOverrides(w: &World) {
    let at = scene3d.index(&w.scene, w.selected);
    if at < 0 || w.scene.nodes[at].owner == 0 {
        w.placedBeforeId = 0;
        return;
    }
    let n = w.scene.nodes[at];
    if w.placedBeforeId != n.id {
        w.placedBefore[0] = n;
        w.placedBeforeId = n.id;
        return;
    }
    let b = w.placedBefore[0];
    let wrote = false;
    if !sameVec(n.position, b.position) || !sameVec(n.rotation, b.rotation) || !sameVec(n.scale, b.scale) {
        overrideVec(w, n.id, "p", n.position);
        overrideVec(w, n.id, "r", n.rotation);
        overrideVec(w, n.id, "s", n.scale);
        wrote = true;
    }
    if !same(n.name, b.name) { overrides.override(&w.scene, n.id, "name", " s", n.name); wrote = true; }
    if !same(n.asset, b.asset) { overrides.override(&w.scene, n.id, "asset", " s", n.asset); wrote = true; }
    if !same(n.texture, b.texture) { overrides.override(&w.scene, n.id, "texture", " s", n.texture); wrote = true; }
    if !same(n.material, b.material) { overrides.override(&w.scene, n.id, "material", " s", n.material); wrote = true; }
    if !same(n.effects, b.effects) { overrides.override(&w.scene, n.id, "effects", " s", n.effects); wrote = true; }
    if !same(n.script, b.script) { overrides.override(&w.scene, n.id, "script", " s", n.script); wrote = true; }
    if n.doubleSided != b.doubleSided {
        let v = "0";
        if n.doubleSided { v = "1"; }
        overrides.override(&w.scene, n.id, "doubleSided", "", v);
        wrote = true;
    }
    if n.fov != b.fov || n.near != b.near || n.far != b.far {
        overrideFloat(w, n.id, "fov", n.fov);
        overrideFloat(w, n.id, "near", n.near);
        overrideFloat(w, n.id, "far", n.far);
        wrote = true;
    }
    if n.alpha != b.alpha || n.opacity != b.opacity {
        let mode = Text.new(scratch(0));
        mode.pushInt(n.alpha);
        overrides.override(&w.scene, n.id, "alpha", "", mode.str());
        overrideFloat(w, n.id, "opacity", n.opacity);
        wrote = true;
    }
    if !sameVec(n.tint, b.tint) {
        overrideFloat(w, n.id, "tr", n.tint.x);
        overrideFloat(w, n.id, "tg", n.tint.y);
        overrideFloat(w, n.id, "tb", n.tint.z);
        wrote = true;
    }
    if !sameVec(n.color, b.color) || n.range != b.range {
        overrideFloat(w, n.id, "cr", n.color.x);
        overrideFloat(w, n.id, "cg", n.color.y);
        overrideFloat(w, n.id, "cb", n.color.z);
        overrideFloat(w, n.id, "range", n.range);
        wrote = true;
    }
    if wrote {
        w.placedBefore[0] = n;
        w.stale = true;
        w.dirty = true;
    }
}

pub fn overrideFloat(w: &World, id: int, key: string, v: f32) {
    let t = Text.new(scratch(0));
    t.pushFloat(v);
    overrides.override(&w.scene, id, key, " f", t.str());
}

/// `px`, `py`, `pz` (or `r`, `s`) from `v`.
pub fn overrideVec(w: &World, id: int, head: string, v: Vec3) {
    let key = Text.new(scratch(0));
    key.pushStr(head);
    key.push(120);
    overrideFloat(w, id, key.str(), v.x);
    key.pop();
    key.push(121);
    overrideFloat(w, id, key.str(), v.y);
    key.pop();
    key.push(122);
    overrideFloat(w, id, key.str(), v.z);
}

/// Placed objects are listed under a placed scene whose "Edit placed objects" is on.
pub fn listedPlaced(w: &World, n: Node): bool {
    if n.owner == 0 { return false; }
    let at = scene3d.index(&w.scene, n.owner);
    return at >= 0 && w.scene.nodes[at].editable;
}

/// Wait for a click on an asset (or, for an object field, on an object) to fill `field`.
pub fn startPick(w: &World, id: int, field: string, object: bool) {
    w.pickFor = id;
    setText(&w.pickField, field);
    w.pickObject = object;
    if object { say(w, "Click the object to point at (Esc cancels)"); }
    else { say(w, "Click an asset under Assets (Esc cancels)"); }
}

/// A click on `id` while an object field waits for one: fill it and swallow the click.
pub fn claimObject(w: &World, id: int): bool {
    if w.pickFor == 0 || !w.pickObject { return false; }
    if id != 0 && id != w.pickFor {
        scene3d.setObject(&w.scene, w.pickFor, w.pickField.str(), id);
        fieldChanged(w, w.pickFor, w.pickField.str());
        say(w, "Object set");
    }
    w.pickFor = 0;
    return true;
}
