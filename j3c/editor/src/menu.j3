// The right-click menu: which rows it has and where it sits.

module j3_editor.menu;

use j3.scene3d.editor.uses;
use j3.game;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ CAMERA, INSTANCE };
use j3.text.{ Text, same };
use j3.ui;
use j3_editor.cameras.mainCamera;
use j3_editor.nodes.viewGround;
use j3_editor.selection.{ isPicked, select, setPrimary };
use j3_editor.types.{
    CMD_ADD_CAMERA, CMD_ADD_GROUP, CMD_ADD_LIGHT, CMD_ADD_MESH, CMD_ADD_PLANE, CMD_ADD_SHAPE, CMD_ADD_SKY, CMD_COPY, CMD_CUT, CMD_DELETE, CMD_DELETE_ASSET, CMD_DUPLICATE, CMD_EDIT_MATERIAL, CMD_FOCUS, CMD_GROUND, CMD_INSTANCE, CMD_INSTANCE_CHILD, CMD_MAIN_CAMERA, CMD_ONTOP, CMD_OPEN_SCENE, CMD_PASTE, CMD_PASTE_CHILD, CMD_PICK_FILE, CMD_RENAME, CMD_RENAME_ASSET, CMD_RESET, CMD_SCATTER, CMD_SEP, CMD_UNPARENT, CMD_VIEW_CAMERA, MENU_ROW, MENU_SEP, MENU_W, MenuItem, World,
};
use j3_editor.util.{ endsWith, stem };

pub fn item(w: &World, label: string, keys: string, cmd: int, on: bool) {
    fileItem(w, label, cmd, on, "");
    w.menu[w.menuLen - 1].keys = keys;
}

pub fn fileItem(w: &World, label: string, cmd: int, on: bool, file: string) {
    if w.menuLen >= w.menu.len {
        let more = w.mem.alloc::<MenuItem>(w.menu.len * 2);
        let i = 0;
        while i < w.menuLen {
            more[i] = w.menu[i];
            i += 1;
        }
        w.menu = more;
    }
    w.menu[w.menuLen] = MenuItem { label: label, keys: "", cmd: cmd, on: on, file: file };
    w.menuLen += 1;
}

/// "Add <scene>" items for the first dozen other scene files.
pub fn sceneItems(w: &World, child: bool) {
    let shown = 0;
    let a = 0;
    while a < w.assetCount {
        let path = w.assetPaths[a];
        if endsWith(path, ".j3scene") && !same(path, w.path) {
            if shown == 0 { item(w, "", "", CMD_SEP, true); }
            if shown == 12 {
                item(w, "More in Assets...", "", 0, false);
                return;
            }
            shown += 1;
            let t = Text.new(w.menuMem);
            if child { t.pushStr("Add child scene: "); } else { t.pushStr("Add scene: "); }
            t.pushStr(stem(path));
            fileItem(w, t.str(), CMD_INSTANCE, true, path);
        }
        a += 1;
    }
}

pub fn buildMenu(w: &World) {
    w.menuLen = 0;
    w.menuMem.rewind(0);
    if w.addMenu {
        item(w, "Group", "", CMD_ADD_GROUP, true);
        item(w, "Mesh", "", CMD_ADD_MESH, true);
        item(w, "Plane", "", CMD_ADD_PLANE, true);
        item(w, "Sky Box", "", CMD_ADD_SKY, true);
        fileItem(w, "Cylinder", CMD_ADD_SHAPE, true, "builtin:cylinder");
        fileItem(w, "Cone", CMD_ADD_SHAPE, true, "builtin:cone");
        fileItem(w, "Capsule", CMD_ADD_SHAPE, true, "builtin:capsule");
        fileItem(w, "Torus", CMD_ADD_SHAPE, true, "builtin:torus");
        item(w, "Camera", "", CMD_ADD_CAMERA, true);
        item(w, "Light", "", CMD_ADD_LIGHT, true);
        item(w, "", "", CMD_SEP, true);
        item(w, "Import model...", "", CMD_PICK_FILE, true);
        item(w, "Scatter...", "", CMD_SCATTER, true);
        sceneItems(w, false);
        return;
    }
    if w.fileMenu {
        if endsWith(w.menuFile, ".j3scene") {
            let other = !uses.uses(w.menuFile, w.path);
            let picked = scene3d.index(&w.scene, w.selected) >= 0;
            fileItem(w, "Open in a tab", CMD_OPEN_SCENE, true, w.menuFile);
            fileItem(w, "Add to this scene", CMD_INSTANCE, other, w.menuFile);
            fileItem(w, "Add as child of selection", CMD_INSTANCE_CHILD, other && picked, w.menuFile);
            item(w, "", "", CMD_SEP, true);
        }
        if endsWith(w.menuFile, ".j3mat") {
            fileItem(w, "Edit material", CMD_EDIT_MATERIAL, true, w.menuFile);
            item(w, "", "", CMD_SEP, true);
        }
        fileItem(w, "Rename or move...", CMD_RENAME_ASSET, true, w.menuFile);
        fileItem(w, "Delete file", CMD_DELETE_ASSET, true, w.menuFile);
        return;
    }
    let at = scene3d.index(&w.scene, w.menuTarget);
    let pasteOk = w.clip.len > 0;
    if at < 0 {
        item(w, "Paste", "Ctrl+V", CMD_PASTE, pasteOk);
        item(w, "", "", CMD_SEP, true);
        item(w, "Add group", "", CMD_ADD_GROUP, true);
        item(w, "Add mesh", "", CMD_ADD_MESH, true);
        item(w, "Add plane", "", CMD_ADD_PLANE, true);
        item(w, "Add sky box", "", CMD_ADD_SKY, true);
        item(w, "Add camera", "", CMD_ADD_CAMERA, true);
        item(w, "Add light", "", CMD_ADD_LIGHT, true);
        item(w, "Scatter...", "", CMD_SCATTER, true);
        sceneItems(w, false);
        return;
    }
    if w.scene.nodes[at].kind == INSTANCE {
        fileItem(w, "Open scene", CMD_OPEN_SCENE, true, w.scene.nodes[at].scene);
    }
    item(w, "Rename", "F2", CMD_RENAME, true);
    item(w, "Focus", "F", CMD_FOCUS, true);
    if w.scene.nodes[at].kind == CAMERA {
        item(w, "View through camera", "0", CMD_VIEW_CAMERA, true);
        item(w, "Set as main camera", "", CMD_MAIN_CAMERA, mainCamera(w) != w.menuTarget);
    }
    item(w, "", "", CMD_SEP, true);
    item(w, "Cut", "Ctrl+X", CMD_CUT, true);
    item(w, "Copy", "Ctrl+C", CMD_COPY, true);
    item(w, "Paste", "Ctrl+V", CMD_PASTE, pasteOk);
    item(w, "Paste as child", "", CMD_PASTE_CHILD, pasteOk);
    item(w, "Duplicate", "Ctrl+D", CMD_DUPLICATE, true);
    item(w, "", "", CMD_SEP, true);
    item(w, "Move to top level", "", CMD_UNPARENT, w.scene.nodes[at].parent != 0);
    item(w, "Reset transform", "", CMD_RESET, true);
    item(w, "Snap to ground", "", CMD_GROUND, true);
    item(w, "Place on top of...", "", CMD_ONTOP, true);
    item(w, "Scatter copies...", "", CMD_SCATTER, true);
    item(w, "Delete", "Del", CMD_DELETE, true);
    item(w, "", "", CMD_SEP, true);
    item(w, "Add child group", "", CMD_ADD_GROUP, true);
    item(w, "Add child mesh", "", CMD_ADD_MESH, true);
    item(w, "Add child camera", "", CMD_ADD_CAMERA, true);
    item(w, "Add child light", "", CMD_ADD_LIGHT, true);
    sceneItems(w, true);
}

/// Menu for a scene file in the asset list.
pub fn openFileMenu(w: &World, at: Vec2, file: string) {
    openMenu(w, at, 0);
    w.fileMenu = true;
    w.menuFile = file;
    w.menuPoint = viewGround(w);
    buildMenu(w);
}

/// The "+ Add" list: one item per object type, then imports and scenes to place.
/// A new object type needs only a line here.
pub fn openAddMenu(w: &World, at: Vec2) {
    openMenu(w, at, 0);
    w.addMenu = true;
    w.menuPoint = viewGround(w);
    buildMenu(w);
}

pub fn openMenu(w: &World, at: Vec2, target: int) {
    w.fileMenu = false;
    w.addMenu = false;
    w.menuOpen = true;
    w.menuAt = at;
    w.menuTarget = target;
    // Right-clicking one of several selected objects acts on all of them.
    if target != 0 && isPicked(w, target) { setPrimary(w, target); }
    else if target != 0 { select(w, target); }
    ui.clearFocus();
    buildMenu(w);
}

pub fn menuSize(w: &World): Vec2 {
    let tall: f32 = 8;
    let i = 0;
    while i < w.menuLen {
        if w.menu[i].cmd == CMD_SEP { tall += MENU_SEP; } else { tall += MENU_ROW; }
        i += 1;
    }
    return Vec2 { x: MENU_W, y: tall };
}

/// Menu corner, pulled back inside the window.
pub fn menuPos(w: &World): Vec2 {
    let win = game.windowSize();
    let size = menuSize(w);
    let p = w.menuAt;
    if p.x + size.x > win.x - 4 { p.x = win.x - 4 - size.x; }
    if p.y + size.y > win.y - 4 { p.y = win.y - 4 - size.y; }
    if p.x < 4 { p.x = 4; }
    if p.y < 4 { p.y = 4; }
    return p;
}

pub fn inMenu(w: &World, p: Vec2): bool {
    let lo = menuPos(w);
    let size = menuSize(w);
    return p.x >= lo.x && p.x < lo.x + size.x && p.y >= lo.y && p.y < lo.y + size.y;
}
