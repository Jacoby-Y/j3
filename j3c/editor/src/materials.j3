// Material tabs: the edited `.j3mat` file, its undo, and the preview shape.

module j3_editor.materials;

use j3.game;
use j3.math.Vec3;
use j3.memory.Arena;
use j3.scene3d;
use j3.data.save;
use j3.ui;
use j3_editor.console.say;
use j3_editor.scenes.{ previewMesh, previewSize };
use j3_editor.shared.shared;
use j3_editor.types.{ MATERIAL_MS, PREVIEW_PLANE, PREVIEW_SPHERE, World };
use j3_editor.util.setText;

/// Show the active material tab's material on `shape` (`PREVIEW_*`).
pub fn setPreviewShape(w: &World, shape: int) {
    if !w.matTab || w.scene.len == 0 || shape < PREVIEW_SPHERE || shape > PREVIEW_PLANE { return; }
    w.mat.shape = shape;
    w.scene.nodes[0].asset = previewMesh(shape);
    let size = previewSize(shape);
    w.scene.nodes[0].scale = Vec3.xyz(size, size, size);
    scene3d.reload(&w.scene, w.scene.nodes[0].id);
    w.worldsReady = false;
}

// ponytail: whole-file undo steps; material files are well under 1 KB.
/// Call before changing the open material: the first change of a click, drag, or typing
/// session saves the file as it was for undo.
pub fn matBefore(w: &World) {
    let g = shared();
    let m = w.mat;
    if !m.gesture {
        m.undoCount = pushBytes(m.undos, m.undoCount, m.file.bytes);
        m.redoCount = 0;
    }
    if game.mouseDown(game.Mouse.Left) || ui.typing() || g.pick.id != 0 { m.gesture = true; }
}

/// Push `b` onto `stack` (holding `count`), dropping the oldest when full; the new count.
pub fn pushBytes(stack: [][]u8, count: int, b: []u8): int {
    if count >= stack.len {
        let i = 1;
        while i < count {
            stack[i - 1] = stack[i];
            i += 1;
        }
        count -= 1;
    }
    stack[count] = b;
    return count + 1;
}

pub fn matChanged(w: &World) {
    w.mat.pending = true;
    w.dirty = true;
}

pub fn matF(w: &World, key: string, fallback: f32): f32 { return save.getFloat(&w.mat.file, key, fallback); }
pub fn matI(w: &World, key: string, fallback: int): int { return save.getInt(&w.mat.file, key, fallback); }

pub fn putMatF(w: &World, key: string, v: f32) {
    matBefore(w);
    save.putFloat(&w.mat.file, key, v);
    matChanged(w);
}

pub fn putMatI(w: &World, key: string, v: int) {
    matBefore(w);
    save.putInt(&w.mat.file, key, v);
    matChanged(w);
}

pub fn matUndo(w: &World, back: bool) {
    let m = w.mat;
    if back && m.undoCount == 0 { say(w, "Nothing to undo"); return; }
    if !back && m.redoCount == 0 { say(w, "Nothing to redo"); return; }
    if back {
        m.redoCount = pushBytes(m.redos, m.redoCount, m.file.bytes);
        m.undoCount -= 1;
        m.file.bytes = m.undos[m.undoCount];
    } else {
        m.undoCount = pushBytes(m.undos, m.undoCount, m.file.bytes);
        m.redoCount -= 1;
        m.file.bytes = m.redos[m.redoCount];
    }
    m.gesture = false;
    setText(&w.matTexture, save.getStr(&m.file, "texture", ""));
    setText(&w.matEffect, save.getStr(&m.file, "fx", ""));
    matChanged(w);
    if back { say(w, "Undone (Ctrl+Y to redo)"); } else { say(w, "Redone"); }
}

/// Show pending material edits on the objects, at most every `MATERIAL_MS` so dragging a
/// noise value doesn't re-bake every frame.
pub fn showMaterial(w: &World) {
    let g = shared();
    if !w.matTab { return; }
    if !game.mouseDown(game.Mouse.Left) && !ui.typing() && g.pick.id == 0 { w.mat.gesture = false; }
    let now = game.ticks();
    if !w.mat.pending || now - w.mat.shownMs < MATERIAL_MS { return; }
    scene3d.previewMaterial(w.path, &w.mat.file);
    w.mat.pending = false;
    w.mat.shownMs = now;
}
