// Per-user prefs and the per-project session (open tabs, panes, console).

module j3_editor.prefs;

use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.data.save;
use j3.data.save.Save;
use j3.text.Text;
use j3_editor.shared.shared;
use j3_editor.types.World;
use j3_editor.util.positive;

pub const PREFS: string = "target/j3-editor/prefs";

pub fn loadPrefs(w: &World) {
    let g = shared();
    let p = save.load(PREFS, scratch(0));
    w.snapMove = positive(save.getFloat(&p, "snap.move", 0.5), 0.5);
    w.snapAngle = positive(save.getFloat(&p, "snap.angle", 15), 15);
    w.snapScale = positive(save.getFloat(&p, "snap.scale", 0.1), 0.1);
    w.gridStep = positive(save.getFloat(&p, "grid.step", 1), 1);
    g.left = positive(save.getFloat(&p, "panel.left", 290), 290);
    g.right = positive(save.getFloat(&p, "panel.right", 320), 320);
    g.treeShare = positive(save.getFloat(&p, "panel.tree", 0.55), 0.55);
    w.agentOff = save.getInt(&p, "agent.off", 0) != 0;
    g.recentN = save.getInt(&p, "recent.count", 0);
    if g.recentN < 0 || g.recentN > 8 { g.recentN = 0; }
    let i = 0;
    while i < g.recentN {
        let t = Text.new(scratch(1));
        t.pushStr("recent.");
        t.pushInt(i);
        g.recent[i] = rgbKey(&p, t.str(), Vec3.xyz(0, 0, 0));
        i += 1;
    }
}

/// `<name>.r/g/b` of `p`, each `fallback`'s when missing.
pub fn rgbKey(p: &Save, name: string, fallback: Vec3): Vec3 {
    let t = Text.new(scratch(1));
    t.pushStr(name);
    t.pushStr(".r");
    let r = save.getFloat(p, t.str(), fallback.x);
    t.pop();
    t.pushStr("g");
    let g = save.getFloat(p, t.str(), fallback.y);
    t.pop();
    t.pushStr("b");
    return Vec3.xyz(r, g, save.getFloat(p, t.str(), fallback.z));
}

pub fn putRgbKey(p: &Save, name: string, c: Vec3) {
    let t = Text.new(scratch(1));
    t.pushStr(name);
    t.pushStr(".r");
    save.putFloat(p, t.str(), c.x);
    t.pop();
    t.pushStr("g");
    save.putFloat(p, t.str(), c.y);
    t.pop();
    t.pushStr("b");
    save.putFloat(p, t.str(), c.z);
}

pub fn savePrefs(w: &World) {
    let g = shared();
    let p = save.empty(scratch(0));
    save.putFloat(&p, "snap.move", w.snapMove);
    save.putFloat(&p, "snap.angle", w.snapAngle);
    save.putFloat(&p, "snap.scale", w.snapScale);
    save.putFloat(&p, "grid.step", w.gridStep);
    save.putFloat(&p, "panel.left", g.left);
    save.putFloat(&p, "panel.right", g.right);
    save.putFloat(&p, "panel.tree", g.treeShare);
    save.putInt(&p, "agent.off", if w.agentOff { 1 } else { 0 });
    save.putInt(&p, "recent.count", g.recentN);
    let i = 0;
    while i < g.recentN {
        let t = Text.new(scratch(1));
        t.pushStr("recent.");
        t.pushInt(i);
        putRgbKey(&p, t.str(), g.recent[i]);
        i += 1;
    }
    save.store(&p, PREFS);
}

pub const SESSION: string = "target/j3-editor/session";
