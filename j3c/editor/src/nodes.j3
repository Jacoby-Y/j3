// Selection, naming, adding, deleting, and reparenting scene nodes.

module j3_editor.nodes;

use j3.math.{ Mat4, Vec3, asin, atan2, cos };
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ Node, MESH, CAMERA, LIGHT, SKY_CLOUDS };
use j3.text.{ Text, same };
use j3_editor.console.say;
use j3_editor.history.modified;
use j3_editor.overrides.isPlaced;
use j3_editor.selection.{ nameOf, parentOf, pickedRoots, select, uniqueName };
use j3_editor.types.World;
use j3_editor.util.keep;

/// Add an object under `parent`, a mesh showing `mesh`. Top-level objects go to `at`,
/// resting on it if they are meshes.
pub fn addNode(w: &World, kind: int, mesh: string, parent: int, at: Vec3) {
    let base = "Group";
    if kind == CAMERA { base = "Camera"; }
    if kind == LIGHT { base = "Light"; }
    if kind == MESH { base = "Mesh"; }
    if same(mesh, "builtin:plane") { base = "Plane"; }
    if same(mesh, "builtin:sky") { base = "Sky"; }
    if same(mesh, "builtin:cylinder") { base = "Cylinder"; }
    if same(mesh, "builtin:cone") { base = "Cone"; }
    if same(mesh, "builtin:capsule") { base = "Capsule"; }
    if same(mesh, "builtin:torus") { base = "Torus"; }
    let name = uniqueName(w, base);
    let id = scene3d.add(&w.scene, kind, name, parent);
    let slot = scene3d.index(&w.scene, id);
    if kind == MESH {
        w.scene.nodes[slot].asset = keep(w, mesh);
        if same(mesh, "builtin:plane") { w.scene.nodes[slot].scale = Vec3.xyz(4, 1, 4); }
        if same(mesh, "builtin:sky") { w.scene.nodes[slot].texture = keep(w, SKY_CLOUDS); }
        scene3d.reload(&w.scene, id);
    }
    if w.scene.nodes[slot].parent == 0 {
        w.scene.nodes[slot].position = at;
        if kind == MESH {
            let lo = w.scene.nodes[slot].boundLo.y * w.scene.nodes[slot].scale.y;
            w.scene.nodes[slot].position.y = at.y - lo;
        }
        // Lights start above the ground so they light it.
        if kind == LIGHT { w.scene.nodes[slot].position.y = at.y + 2; }
    }
    select(w, id);
    modified(w);
    let t = Text.new(scratch(0));
    t.pushStr("Added ");
    t.pushStr(name);
    say(w, t.str());
}

pub fn deleteSelected(w: &World) {
    if scene3d.index(&w.scene, w.selected) < 0 { return; }
    let roots = pickedRoots(w);
    let t = Text.new(scratch(0));
    t.pushStr("Deleted ");
    if roots.len == 1 {
        t.pushStr(nameOf(w, w.selected));
    } else {
        t.pushInt(roots.len);
        t.pushStr(" objects");
    }
    t.pushStr(" (Ctrl+Z to undo)");
    let i = 0;
    while i < roots.len {
        if !isPlaced(w, roots[i]) { scene3d.remove(&w.scene, roots[i]); }
        i += 1;
    }
    select(w, 0);
    modified(w);
    say(w, t.str());
}

/// Inverse of a rotate/scale/translate matrix.
pub fn affineInverse(src: Mat4): Mat4 {
    return src.affineInverse();
}

/// Split `local` back into position, XYZ Euler rotation (as `scene3d.local` builds it), and scale.
// ponytail: drops shear, which only appears under a non-uniformly scaled, rotated parent.
pub fn setLocal(n: &Node, local: Mat4) {
    let m = local.m;
    let sx = Vec3.xyz(m[0], m[1], m[2]).length();
    let sy = Vec3.xyz(m[4], m[5], m[6]).length();
    let sz = Vec3.xyz(m[8], m[9], m[10]).length();
    if sx < 0.0001 || sy < 0.0001 || sz < 0.0001 { return; }
    let det = m[0] * (m[5] * m[10] - m[6] * m[9])
        - m[4] * (m[1] * m[10] - m[2] * m[9])
        + m[8] * (m[1] * m[6] - m[2] * m[5]);
    if det < 0 { sx = 0 - sx; }
    n.position = Vec3.xyz(m[12], m[13], m[14]);
    n.scale = Vec3.xyz(sx, sy, sz);
    let r20 = 0 - m[2] / sx;
    if r20 > 1 { r20 = 1; }
    if r20 < -1 { r20 = -1; }
    let pitch = asin(r20);
    if cos(pitch) > 0.0001 {
        n.rotation = Vec3.xyz(atan2(m[6] / sy, m[10] / sz), pitch, atan2(m[1] / sx, m[0] / sx));
    } else {
        n.rotation = Vec3.xyz(0, pitch, atan2(0 - m[4] / sy, m[5] / sy));
    }
}

/// World space to `parent`'s space (0 is the top level).
pub fn toParent(w: &World, parent: int): Mat4 {
    if parent == 0 { return Mat4.identity(); }
    return affineInverse(scene3d.world(&w.scene, parent));
}

/// Put `id` under `parent` (0 is the top level) without moving it in the world.
pub fn dropOn(w: &World, id: int, parent: int) {
    if parentOf(w, id) == parent || id == parent { return; }
    let before = scene3d.world(&w.scene, id);
    if !scene3d.reparent(&w.scene, id, parent) {
        say(w, "Can't put an object inside its own child");
        return;
    }
    let slot = scene3d.index(&w.scene, id);
    setLocal(&w.scene.nodes[slot], toParent(w, parent).mul(before));
    modified(w);
    let t = Text.new(scratch(0));
    t.pushStr("Moved ");
    t.pushStr(nameOf(w, id));
    if parent == 0 {
        t.pushStr(" to the top level");
    } else {
        t.pushStr(" under ");
        t.pushStr(nameOf(w, parent));
    }
    say(w, t.str());
}

/// Where the ray hits the ground plane, or `fallback` if it points away from it.
pub fn groundHit(origin: Vec3, dir: Vec3, fallback: Vec3): Vec3 {
    if dir.y > -0.0001 && dir.y < 0.0001 { return fallback; }
    let t = 0 - origin.y / dir.y;
    if t < 0 || t > 500 { return fallback; }
    return origin + dir * t;
}

/// Ground point in the middle of the view, where toolbar adds land.
pub fn viewGround(w: &World): Vec3 {
    let eye = w.cam.eye();
    let ground = groundHit(eye, (w.cam.target - eye).normalize(), w.cam.target);
    return ground;
}

pub fn setCollapsed(w: &World, id: int, on: bool) {
    let at = scene3d.index(&w.scene, id);
    if at >= 0 { w.scene.nodes[at].collapsed = on; }
}

/// Put `id` just before or after sibling `target` (under `target`'s parent), keeping its place
/// in the world.
pub fn dropBeside(w: &World, id: int, target: int, after: bool) {
    if id == target { return; }
    let parent = parentOf(w, target);
    if parentOf(w, id) != parent {
        dropOn(w, id, parent);
        if parentOf(w, id) != parent { return; }
    }
    let slot = scene3d.index(&w.scene, target);
    if after { slot += 1; }
    if scene3d.index(&w.scene, id) < slot { slot -= 1; }
    scene3d.moveTo(&w.scene, id, slot);
    modified(w);
}
