// Scene tabs: open, close, save, create, autosave, and play.

module j3_editor.tabs;

use j3.memory.{ Arena, scratch };
use j3.data.save;
use j3.text.{ Text, cstr };
use j3.ui;
use j3_editor.history.snapshot;
use j3_editor.prefs.SESSION;
use j3_editor.selection.select;
use j3_editor.shared.shared;
use j3_editor.types.{ MAX_PANES, Tab, World };
use j3_editor.util.{ removeFile, setText };

/// Remember the open tabs, each one's view, selection and folded objects, and the folded
/// asset folders, so the next launch comes back the same way.
pub fn saveSession(w: &World) {
    let g = shared();
    stash(w);
    let p = save.empty(scratch(0));
    save.putInt(&p, "tab.count", w.tabCount);
    save.putInt(&p, "tab.active", w.active);
    save.putInt(&p, "panes", g.panes);
    save.putInt(&p, "console.open", if g.consoleOpen { 1 } else { 0 });
    save.putFloat(&p, "console.h", g.consoleHeight);
    let pane = 0;
    while pane < g.panes {
        let pk = Text.new(scratch(1));
        pk.pushStr("pane.");
        pk.pushInt(pane);
        save.putFloat(&p, pk.str(), g.paneShare[pane]);
        pane += 1;
    }
    let i = 0;
    while i < w.tabCount {
        let t = w.tabs[i];
        let k = Text.new(scratch(1));
        k.pushStr("tab.");
        k.pushInt(i);
        k.push(46);
        let mark = k.len();
        tabKey(&k, mark, "path");
        save.putStr(&p, k.str(), t.path);
        tabKey(&k, mark, "material");
        save.putInt(&p, k.str(), if t.mat as ptr != 0 { 1 } else { 0 });
        tabKey(&k, mark, "cam.x");
        save.putFloat(&p, k.str(), t.cam.target.x);
        tabKey(&k, mark, "cam.y");
        save.putFloat(&p, k.str(), t.cam.target.y);
        tabKey(&k, mark, "cam.z");
        save.putFloat(&p, k.str(), t.cam.target.z);
        tabKey(&k, mark, "cam.yaw");
        save.putFloat(&p, k.str(), t.cam.yaw);
        tabKey(&k, mark, "cam.pitch");
        save.putFloat(&p, k.str(), t.cam.pitch);
        tabKey(&k, mark, "cam.radius");
        save.putFloat(&p, k.str(), t.cam.radius);
        tabKey(&k, mark, "ortho");
        save.putInt(&p, k.str(), if t.ortho { 1 } else { 0 });
        tabKey(&k, mark, "axis");
        save.putInt(&p, k.str(), if t.axisView { 1 } else { 0 });
        tabKey(&k, mark, "selected");
        save.putInt(&p, k.str(), t.selected);
        tabKey(&k, mark, "pane");
        save.putInt(&p, k.str(), t.pane);
        tabKey(&k, mark, "front");
        save.putInt(&p, k.str(), if t.front { 1 } else { 0 });
        tabKey(&k, mark, "previewLock");
        save.putInt(&p, k.str(), t.previewLock);
        if t.mat as ptr != 0 {
            tabKey(&k, mark, "shape");
            save.putInt(&p, k.str(), t.mat.shape);
        }
        let folds = 0;
        let n = 0;
        while n < t.scene.len {
            if t.scene.nodes[n].collapsed {
                tabKey(&k, mark, "fold.");
                k.pushInt(folds);
                save.putInt(&p, k.str(), t.scene.nodes[n].id);
                folds += 1;
            }
            n += 1;
        }
        tabKey(&k, mark, "folds");
        save.putInt(&p, k.str(), folds);
        i += 1;
    }
    save.putInt(&p, "assets.folds", w.foldCount);
    i = 0;
    while i < w.foldCount {
        let fk = Text.new(scratch(1));
        fk.pushStr("assets.fold.");
        fk.pushInt(i);
        save.putStr(&p, fk.str(), w.folds[i]);
        i += 1;
    }
    save.store(&p, SESSION);
}

/// `k` cut back to `mark`, then `field` appended.
pub fn tabKey(k: &Text, mark: int, field: string) {
    while k.len() > mark { k.pop(); }
    k.pushStr(field);
}

/// Move tab `from` to slot `to`, keeping the same tab active.
pub fn moveTab(w: &World, from: int, to: int) {
    if from == to || from < 0 || to < 0 || from >= w.tabCount || to >= w.tabCount { return; }
    stash(w);
    let activePath = w.tabs[w.active].path;
    let moving = w.tabs[from];
    let k = from;
    while k < to {
        w.tabs[k] = w.tabs[k + 1];
        k += 1;
    }
    while k > to {
        w.tabs[k] = w.tabs[k - 1];
        k -= 1;
    }
    w.tabs[to] = moving;
    let i = 0;
    while i < w.tabCount {
        if w.tabs[i].path.ptr == activePath.ptr { w.active = i; }
        i += 1;
    }
}

pub fn stash(w: &World) {
    // Record a pending edit in this tab's history before the tab's stacks are put away.
    if w.pendingUndo && !w.editGesture { snapshot(w); }
    w.tabs[w.active] = Tab {
        path: w.path,
        mat: w.mat,
        scene: w.scene,
        cam: w.cam,
        selected: w.selected,
        undos: w.undos,
        undoCount: w.undoCount,
        redos: w.redos,
        redoCount: w.redoCount,
        dirty: w.dirty,
        viewCam: w.viewCam,
        savedCam: w.savedCam,
        ortho: w.ortho,
        axisView: w.axisView,
        pane: w.tabs[w.active].pane,
        front: true,
        previewLock: w.previewLock,
    };
}

pub fn unstash(w: &World, i: int) {
    let g = shared();
    let t = w.tabs[i];
    w.active = i;
    g.focus = t.pane;
    let k = 0;
    while k < w.tabCount {
        if w.tabs[k].pane == t.pane { w.tabs[k].front = k == i; }
        k += 1;
    }
    w.path = t.path;
    w.mat = t.mat;
    w.matTab = t.mat as ptr != 0;
    if w.matTab {
        setText(&w.matTexture, save.getStr(&w.mat.file, "texture", ""));
        setText(&w.matEffect, save.getStr(&w.mat.file, "fx", ""));
    }
    w.scene = t.scene;
    w.worldsReady = false;
    w.cam = t.cam;
    w.undos = t.undos;
    w.undoCount = t.undoCount;
    w.redos = t.redos;
    w.redoCount = t.redoCount;
    w.dirty = t.dirty;
    w.viewCam = t.viewCam;
    w.savedCam = t.savedCam;
    w.ortho = t.ortho;
    w.axisView = t.axisView;
    w.previewLock = t.previewLock;
    w.menuOpen = false;
    w.dragging = false;
    w.treeDrag = 0;
    w.hoverNode = 0;
    w.hoverAxis = -1;
    ui.clearFocus();
    select(w, t.selected);
    snapshot(w);
}

pub fn switchTab(w: &World, i: int) {
    let g = shared();
    if i == w.active || i < 0 || i >= w.tabCount { return; }
    g.pick.id = 0;
    stash(w);
    unstash(w, i);
}

pub fn growTabs(w: &World) {
    if w.tabCount < w.tabs.len { return; }
    let more = w.mem.alloc::<Tab>(w.tabs.len * 2);
    let k = 0;
    while k < w.tabCount {
        more[k] = w.tabs[k];
        k += 1;
    }
    w.tabs = more;
}

/// Where the crash copy of scene `path` goes: `scenes/a.j3scene` -> `target/j3-editor/autosave.scenes~a.j3scene`.
pub fn autosavePath(path: string): string {
    let t = Text.new(scratch(0));
    t.pushStr("target/j3-editor/autosave.");
    let i = 0;
    while i < path.len {
        if path[i] == 47 { t.push(126); } else { t.push(path[i]); }
        i += 1;
    }
    return t.str();
}

pub fn dropAutosave(path: string) {
    removeFile(autosavePath(path));
}

/// The tab pane `p` shows, or -1.
pub fn frontTab(w: &World, p: int): int {
    let first = -1;
    let i = 0;
    while i < w.tabCount {
        if w.tabs[i].pane == p {
            if w.tabs[i].front { return i; }
            if first < 0 { first = i; }
        }
        i += 1;
    }
    return first;
}

/// Close panes left with no tabs, give their width to a neighbour, and make sure each
/// pane shows one tab.
pub fn tidyPanes(w: &World) {
    let g = shared();
    stash(w);
    let p = g.panes - 1;
    while p >= 0 {
        if frontTab(w, p) < 0 && g.panes > 1 {
            let to = if p > 0 { p - 1 } else { p + 1 };
            g.paneShare[to] += g.paneShare[p];
            let k = p;
            while k + 1 < MAX_PANES {
                g.paneShare[k] = g.paneShare[k + 1];
                k += 1;
            }
            g.paneShare[MAX_PANES - 1] = 0;
            let i = 0;
            while i < w.tabCount {
                if w.tabs[i].pane > p { w.tabs[i].pane -= 1; }
                i += 1;
            }
            g.panes -= 1;
        }
        p -= 1;
    }
    p = 0;
    while p < g.panes {
        let shown = frontTab(w, p);
        if shown >= 0 { w.tabs[shown].front = true; }
        p += 1;
    }
    g.focus = w.tabs[w.active].pane;
}

/// Put tab `i` in pane `pane`, before tab `before` (-1 for last), or in a new pane made
/// left (`side` 1) or right (`side` 2) of `pane`. It becomes the active tab.
pub fn dockTab(w: &World, i: int, pane: int, before: int, side: int) {
    let g = shared();
    stash(w);
    let target = pane;
    if side != 0 && g.panes < MAX_PANES {
        if side == 2 { target = pane + 1; }
        let k = MAX_PANES - 1;
        while k > target {
            g.paneShare[k] = g.paneShare[k - 1];
            k -= 1;
        }
        // The new pane takes half of the one it splits.
        let half = g.paneShare[if side == 2 { pane } else { pane + 1 }] * 0.5;
        g.paneShare[target] = half;
        g.paneShare[if side == 2 { pane } else { pane + 1 }] = half;
        let t = 0;
        while t < w.tabCount {
            if w.tabs[t].pane >= target { w.tabs[t].pane += 1; }
            t += 1;
        }
        g.panes += 1;
    }
    w.tabs[i].pane = target;
    let to = w.tabCount - 1;
    if before >= 0 { to = if before > i { before - 1 } else { before }; }
    let path = w.tabs[i].path;
    moveTab(w, i, to);
    let at = 0;
    while at < w.tabCount && w.tabs[at].path.ptr != path.ptr { at += 1; }
    unstash(w, at);
    tidyPanes(w);
    saveSession(w);
}

pub fn tabsIn(w: &World, p: int): int {
    let n = 0;
    let i = 0;
    while i < w.tabCount {
        if w.tabs[i].pane == p { n += 1; }
        i += 1;
    }
    return n;
}
