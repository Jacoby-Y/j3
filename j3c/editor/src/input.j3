// Keyboard shortcuts and mouse handling for the whole window.

module j3_editor.input;

use j3.game;
use j3.gfx;
use j3.math.{ Mat4, Vec2, Vec3, PI };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Node, CAMERA, MESH };
use j3.ui;
use j3_editor.assets.dropSpot;
use j3_editor.cameras.{ axisView, mainCamera, overLock, overPreview, previewCam, viewThrough };
use j3_editor.commands.{ ontopClick, redo, run, undo };
use j3_editor.console.say;
use j3_editor.files.{ autosave, focus, importFile, play, quit, rescan, saveScene };
use j3_editor.gizmo.{ cachedWorlds, dragGizmo, pickAxis, pickNode, pickPast, startGizmoDrag };
use j3_editor.history.snapshot;
use j3_editor.host.pollHost;
use j3_editor.watch.pollWatch;
use j3_editor.layout.{ overHierarchy, overSnap, overViewport, paneAt };
use j3_editor.materials.showMaterial;
use j3_editor.menu.{ inMenu, openMenu };
use j3_editor.nodes.{ groundHit, setCollapsed, viewGround };
use j3_editor.overrides.{ claimObject, syncOverrides };
use j3_editor.scenes.anyDirty;
use j3_editor.selection.{
    addPick, doubleClick, isPicked, parentOf, select, setPrimary, togglePick,
};
use j3_editor.shared.shared;
use j3_editor.tabs.{ frontTab, switchTab };
use j3_editor.types.{
    CMD_CLOSE_TAB, CMD_COPY, CMD_CUT, CMD_DELETE, CMD_DUPLICATE, CMD_FOCUS, CMD_NEW_SCENE, CMD_PASTE, CMD_RENAME, DOUBLE_MS, MOVE, ROTATE, SCALE, SLOP, World,
};
use j3_editor.ui_dialogs.modalUp;
use j3_editor.ui_panes.{ dragTab, resizePanels };
use j3_editor.util.{ countMsg, isOnline, max, min };

/// Arrow keys walk the hierarchy rows drawn last frame.
pub fn stepRow(w: &World, dir: int) {
    if w.rowCount == 0 { return; }
    let at = -1;
    let i = 0;
    while i < w.rowCount {
        if w.rows[i] == w.selected { at = i; }
        i += 1;
    }
    let next = at + dir;
    if at < 0 { next = 0; }
    if next < 0 { next = 0; }
    if next >= w.rowCount { next = w.rowCount - 1; }
    select(w, w.rows[next]);
}

pub fn shortcuts(w: &World) {
    let g = shared();
    let ctrl = game.keyDown(game.Key.Ctrl);
    let shift = game.keyDown(game.Key.Shift);
    if game.keyPressed(game.Key.Escape) {
        if w.menuOpen {
            w.menuOpen = false;
        } else if w.pickFor != 0 {
            w.pickFor = 0;
            say(w, "Pick cancelled");
        } else if w.ontopPick {
            w.ontopPick = false;
            say(w, "Place on top cancelled");
        } else if ui.typing() {
            ui.clearFocus();
        } else if w.showHelp {
            w.showHelp = false;
        } else if w.viewCam != 0 {
            viewThrough(w, 0);
        } else {
            select(w, 0);
        }
        return;
    }
    if w.menuOpen { return; }
    if ctrl && game.keyPressed(game.Key.S) { saveScene(w); }
    if ctrl && game.keyPressed(game.Key.Z) {
        if shift { redo(w); } else { undo(w); }
    }
    if ctrl && game.keyPressed(game.Key.Y) { redo(w); }
    if ctrl && game.keyPressed(game.Key.P) { play(w); }
    if ctrl && game.keyPressed(game.Key.J) { g.consoleOpen = !g.consoleOpen; }
    if game.keyPressed(game.Key.F5) { rescan(w); }
    if ctrl && game.keyPressed(game.Key.N) { run(w, CMD_NEW_SCENE); }
    if ctrl && game.keyPressed(game.Key.W) { run(w, CMD_CLOSE_TAB); }
    if ctrl && game.keyPressed(game.Key.Tab) && w.tabCount > 1 {
        let step = 1;
        if shift { step = w.tabCount - 1; }
        let next = w.active + step;
        while next >= w.tabCount { next -= w.tabCount; }
        switchTab(w, next);
    }
    // Everything below would clash with typing in a field.
    if ui.typing() { return; }
    if ctrl {
        if game.keyPressed(game.Key.C) { run(w, CMD_COPY); }
        if game.keyPressed(game.Key.X) { run(w, CMD_CUT); }
        if game.keyPressed(game.Key.V) {
            w.menuTarget = 0;
            w.menuPoint = viewGround(w);
            run(w, CMD_PASTE);
        }
        if game.keyPressed(game.Key.D) { run(w, CMD_DUPLICATE); }
        return;
    }
    if game.keyPressed(game.Key.W) { w.gizmoMode = MOVE; }
    if game.keyPressed(game.Key.E) { w.gizmoMode = ROTATE; }
    if game.keyPressed(game.Key.R) { w.gizmoMode = SCALE; }
    if game.keyPressed(game.Key.L) { w.localSpace = !w.localSpace; }
    if game.keyPressed(game.Key.F) { run(w, CMD_FOCUS); }
    if game.keyPressed(game.Key.F2) { run(w, CMD_RENAME); }
    if game.keyPressed(game.Key.Delete) { run(w, CMD_DELETE); }
    if game.keyPressed(game.Key.H) { w.showHelp = !w.showHelp; }
    if game.keyPressed(game.Key.Num0) { toggleCameraView(w); }
    if game.keyPressed(game.Key.Num1) { axisView(w, 0, 0); }
    if game.keyPressed(game.Key.Num3) { axisView(w, PI / 2, 0); }
    if game.keyPressed(game.Key.Num7) { axisView(w, 0, 1.5705); }
    if game.keyPressed(game.Key.Num5) {
        w.ortho = !w.ortho;
        w.axisView = false;
    }
}

/// Arrow keys slide the view: left and right strafe, up and down move along the look
/// direction. Shift is faster, Ctrl is slower. Over the hierarchy, plain arrows still walk the list.
pub fn arrowKeys(w: &World, dt: f32) {
    if ui.typing() || w.menuOpen || isOnline(w.path) { return; }
    let speedKey = game.keyDown(game.Key.Shift) || game.keyDown(game.Key.Ctrl);
    if overHierarchy(w, game.mousePos()) && !speedKey {
        if game.keyPressed(game.Key.Up) { stepRow(w, -1); }
        if game.keyPressed(game.Key.Down) { stepRow(w, 1); }
        if game.keyPressed(game.Key.Left) { foldOrParent(w); }
        if game.keyPressed(game.Key.Right) { setCollapsed(w, w.selected, false); }
        return;
    }
    let x: f32 = 0;
    let y: f32 = 0;
    if game.keyDown(game.Key.Left) { x -= 1; }
    if game.keyDown(game.Key.Right) { x += 1; }
    if game.keyDown(game.Key.Down) { y -= 1; }
    if game.keyDown(game.Key.Up) { y += 1; }
    if x == 0 && y == 0 { return; }
    let scale: f32 = 1;
    if game.keyDown(game.Key.Shift) { scale = 4; }
    if game.keyDown(game.Key.Ctrl) { scale *= 0.25; }
    let forward = w.cam.target - w.cam.eye();
    let right = forward.cross(Vec3.up());
    if right.length() < 0.0001 { return; }
    right = right.normalize();
    forward = forward.normalize();
    let speed = w.cam.radius * 0.85 * scale * dt;
    // Leave a looked-through camera, keeping the view that was just on screen.
    if w.viewCam != 0 { w.viewCam = 0; }
    w.cam.target = w.cam.target + right * (x * speed) + forward * (y * speed);
}

/// 0: look through the selected camera (or the main one), or stop looking through one.
pub fn toggleCameraView(w: &World) {
    if w.viewCam != 0 {
        viewThrough(w, 0);
        return;
    }
    let at = scene3d.index(&w.scene, w.selected);
    if at >= 0 && w.scene.nodes[at].kind == CAMERA {
        viewThrough(w, w.selected);
    } else if mainCamera(w) != 0 {
        viewThrough(w, mainCamera(w));
    } else {
        say(w, "Add a camera first");
    }
}

/// Left arrow: fold the selection's children if they're showing, else go to its parent.
pub fn foldOrParent(w: &World) {
    let at = scene3d.index(&w.scene, w.selected);
    if at < 0 { return; }
    if !w.scene.nodes[at].collapsed && hasChildren(w, w.selected) {
        setCollapsed(w, w.selected, true);
    } else if parentOf(w, w.selected) != 0 {
        select(w, parentOf(w, w.selected));
    }
}

pub fn hasChildren(w: &World, id: int): bool {
    let i = 0;
    while i < w.scene.len {
        if w.scene.nodes[i].parent == id && w.scene.nodes[i].owner == 0 { return true; }
        i += 1;
    }
    return false;
}

pub fn input(w: &World, dt: f32) {
    let g = shared();
    w.worldsReady = false;
    let mouse = game.mousePos();
    let delta = mouse - w.lastMouse;
    w.lastMouse = mouse;
    if game.closeRequested() {
        if anyDirty(w) {
            w.closing = true;
            w.closeTab = -1;
        } else {
            quit(w);
        }
    }
    // An open color picker is one gesture, so its whole session is one undo step.
    if !game.mouseDown(game.Mouse.Left) && !ui.typing() && g.pick.id == 0 { w.editGesture = false; }
    if !w.editGesture { syncOverrides(w); }
    w.swallow = false;
    pollHost(w);
    pollWatch(w);
    autosave(w);
    showMaterial(w);
    let dropped = game.droppedFile();
    if dropped.len > 0 { importFile(w, dropped, w.path); }
    if w.stale && !w.editGesture { snapshot(w); }
    if modalUp(w) {
        if game.keyPressed(game.Key.Escape) {
            w.closing = false;
            w.naming = false;
            w.scattering = false;
        }
        return;
    }
    if resizePanels(w, mouse) { return; }
    if dragTab(w, mouse) { return; }
    // A press in another pane only moves the focus there.
    let clicked = game.mousePressed(game.Mouse.Left) || game.mousePressed(game.Mouse.Right)
        || game.mousePressed(game.Mouse.Middle);
    let pane = paneAt(mouse);
    if clicked && pane >= 0 && pane != g.focus && !w.menuOpen {
        let shown = frontTab(w, pane);
        if shown >= 0 { switchTab(w, shown); }
        w.swallow = true;
        return;
    }
    // A press outside an open menu closes it; a left press does nothing else.
    if w.menuOpen && (game.mousePressed(game.Mouse.Left) || game.mousePressed(game.Mouse.Right)) && !inMenu(w, mouse) {
        w.menuOpen = false;
        w.swallow = game.mousePressed(game.Mouse.Left);
    }
    shortcuts(w);
    arrowKeys(w, dt);
    // The Get Assets page is all UI; the viewport's mouse handling stays out of it.
    if isOnline(w.path) && overViewport(mouse) {
        w.hoverAxis = -1;
        w.hoverNode = 0;
        return;
    }
    if game.mousePressed(game.Mouse.Right) {
        w.rightFrom = mouse;
        w.rightArmed = overViewport(mouse) && !w.menuOpen;
    }
    if (mouse - w.rightFrom).length() > SLOP { w.rightArmed = false; }
    if game.mouseReleased(game.Mouse.Right) && w.rightArmed && !w.matTab {
        w.rightArmed = false;
        let ray = gfx.mouseRay(w.cam);
        w.menuPoint = groundHit(ray.origin, ray.dir, w.cam.target);
        openMenu(w, mouse, pickNode(w));
    }
    if w.menuOpen || w.swallow {
        w.hoverAxis = -1;
        w.hoverNode = 0;
        return;
    }
    if w.dragging {
        if game.mouseDown(game.Mouse.Left) {
            dragGizmo(w, delta);
        } else {
            w.dragging = false;
        }
        return;
    }
    if w.boxing {
        if !game.mouseDown(game.Mouse.Left) {
            w.boxing = false;
            if (mouse - w.boxFrom).length() > SLOP { boxSelect(w, mouse); }
        }
        return;
    }
    if w.assetDragging {
        w.hoverAxis = -1;
        w.hoverNode = 0;
        w.dropNode = 0;
        if overViewport(mouse) {
            w.dropNode = dropSpot(w, &w.dropPoint);
            w.hoverNode = w.dropNode;
        }
        return;
    }
    if overPreview(w, mouse) {
        w.hoverAxis = -1;
        w.hoverNode = 0;
        if game.mousePressed(game.Mouse.Left) {
            let cam = previewCam(w);
            // The button toggles the lock; anywhere else on the preview locks it.
            if overLock(w, mouse) && w.previewLock == cam { w.previewLock = 0; } else { w.previewLock = cam; }
        }
        return;
    }
    if !overViewport(mouse) || w.treeDrag != 0 || overSnap(w, mouse) {
        w.hoverAxis = -1;
        w.hoverNode = 0;
        return;
    }
    w.hoverAxis = -1;
    w.hoverNode = 0;
    if !w.matTab { w.hoverAxis = pickAxis(w, mouse); }
    if w.hoverAxis < 0 && !w.matTab { w.hoverNode = pickNode(w); }
    let wheel = game.mouseWheel();
    let moving = wheel != 0 || game.mouseDown(game.Mouse.Middle)
        || (game.mouseDown(game.Mouse.Right) && (delta.x != 0 || delta.y != 0));
    // Moving the view leaves the camera, keeping what it showed.
    if moving { w.viewCam = 0; }
    if w.axisView && game.mouseDown(game.Mouse.Right) && (delta.x != 0 || delta.y != 0) {
        w.axisView = false;
        w.ortho = false;
    }
    if wheel != 0 { w.cam.zoom(wheel * w.cam.radius * 0.12, 0.5, 400); }
    if game.mouseDown(game.Mouse.Right) {
        w.cam.orbit(-delta.x * 0.008, delta.y * 0.008);
    }
    if game.mouseDown(game.Mouse.Middle) {
        let forward = (w.cam.target - w.cam.eye()).normalize();
        let right = forward.cross(Vec3.up()).normalize();
        let up = right.cross(forward);
        let speed = w.cam.radius * 0.0018;
        w.cam.target = w.cam.target - right * (delta.x * speed) + up * (delta.y * speed);
    }
    if game.mousePressed(game.Mouse.Left) && w.matTab {
        ui.clearFocus();
    } else if game.mousePressed(game.Mouse.Left) {
        ui.clearFocus();
        if ontopClick(w, w.hoverNode) {
        } else if claimObject(w, w.hoverNode) {
        } else if w.hoverAxis >= 0 {
            startGizmoDrag(w);
        } else if game.keyDown(game.Key.Ctrl) {
            togglePick(w, w.hoverNode);
        } else if w.hoverNode != 0 {
            // Clicking the same spot again reaches the next object behind the selected one,
            // then wraps to the front.
            let pick = w.hoverNode;
            let depth = w.pickDepth;
            let again = w.selected != 0 && (mouse - w.pickFrom).length() < SLOP
                && game.ticks() - w.clickMs >= DOUBLE_MS;
            if again {
                let behind = pickPast(w, w.throughDepth);
                if behind != 0 {
                    pick = behind;
                    depth = w.pickDepth;
                }
            }
            w.pickFrom = mouse;
            w.throughDepth = depth;
            select(w, pick);
            if doubleClick(w, pick) { focus(w); }
        } else {
            // Empty space: a click clears the selection, a drag draws a selection box.
            if !game.keyDown(game.Key.Shift) { select(w, 0); }
            w.boxing = true;
            w.boxFrom = mouse;
        }
    }
}

/// Select the objects the box dragged from `boxFrom` to `to` touches.
pub fn boxSelect(w: &World, to: Vec2) {
    let lo = Vec2 { x: min(w.boxFrom.x, to.x), y: min(w.boxFrom.y, to.y) };
    let hi = Vec2 { x: max(w.boxFrom.x, to.x), y: max(w.boxFrom.y, to.y) };
    let matrices = cachedWorlds(w);
    let first = 0;
    let i = 0;
    while i < w.scene.len {
        let n = w.scene.nodes[i];
        if n.owner == 0 {
            if !isPicked(w, n.id) && boxHits(lo, hi, n, matrices[i]) {
                addPick(w, n.id);
                if first == 0 { first = n.id; }
            }
        }
        i += 1;
    }
    if first != 0 { setPrimary(w, first); }
    say(w, countMsg("Selected", w.pickedCount));
}

/// Whether `n` shows inside the screen box `lo..hi`: meshes by the screen rect of their
/// bounds' corners, everything else by its origin.
fn boxHits(lo: Vec2, hi: Vec2, n: Node, model: Mat4): bool {
    if n.kind != MESH {
        let p = gfx.toScreen(model.transformPoint(Vec3.zero()));
        return p.z > 0 && p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y;
    }
    let a = Vec2 { x: 1000000, y: 1000000 };
    let b = Vec2 { x: -1000000, y: -1000000 };
    let c = 0;
    while c < 8 {
        let q = n.boundLo;
        if c % 2 == 1 { q.x = n.boundHi.x; }
        if (c / 2) % 2 == 1 { q.y = n.boundHi.y; }
        if c / 4 == 1 { q.z = n.boundHi.z; }
        // ponytail: corners behind the camera are skipped, so a mesh you stand inside can be missed.
        let s = gfx.toScreen(model.transformPoint(q));
        if s.z > 0 {
            a = Vec2 { x: min(a.x, s.x), y: min(a.y, s.y) };
            b = Vec2 { x: max(b.x, s.x), y: max(b.y, s.y) };
        }
        c += 1;
    }
    return a.x <= hi.x && b.x >= lo.x && a.y <= hi.y && b.y >= lo.y;
}
