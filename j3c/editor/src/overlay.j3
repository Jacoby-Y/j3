// 2D drawing over the viewport: gizmo handles, labels, help, fps.

module j3_editor.overlay;

use j3.game;
use j3.game.{ Color, rgb, rgba };
use j3.gfx;
use j3.math.{ Vec2, Vec3 };
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ GROUP, CAMERA };
use j3.text.Text;
use j3_editor.cameras.{ lockBox, overLock, overPreview, previewBox, previewCam };
use j3_editor.gizmo.{
    armDir, cachedWorlds, edgeAxes, edgePoint, flat, gizmoLength, gizmoOrigin, hasEdge, ringPoint,
};
use j3_editor.layout.{ overViewport, viewMin, viewSize };
use j3_editor.selection.{ isPicked, nameOf };
use j3_editor.types.{ EDGE_HANDLE, RING, ROTATE, SCALE, SLOP, World };
use j3_editor.util.{ max, min };
use j3_editor.widgets.{ fill, outline };

pub fn axisColor(axis: int, lit: bool): Color {
    if lit { return rgb(255, 214, 64); }
    if axis == 0 { return rgb(232, 72, 72); }
    if axis == 1 { return rgb(120, 205, 80); }
    return rgb(72, 136, 240);
}

// ponytail: GL mode has no 2D line primitive, so strokes are stamped squares; fine for a few gizmo arms.
pub fn stroke(a: Vec2, b: Vec2, thick: f32, c: Color) {
    let d = b - a;
    let len = d.length();
    let steps = int(len / (thick * 0.5)) + 1;
    game.setColor(c);
    let k = 0;
    while k <= steps {
        let p = a + d * (f32(k) / f32(steps));
        game.drawRect(Vec2 { x: p.x - thick * 0.5, y: p.y - thick * 0.5 }, Vec2 { x: thick, y: thick });
        k += 1;
    }
}

pub fn square(p: Vec2, size: f32, c: Color) {
    game.setColor(c);
    game.drawRect(Vec2 { x: p.x - size * 0.5, y: p.y - size * 0.5 }, Vec2 { x: size, y: size });
}

pub fn drawGizmo(w: &World) {
    if scene3d.index(&w.scene, w.selected) < 0 { return; }
    let o = gizmoOrigin(w);
    let len = gizmoLength(w);
    let center = gfx.toScreen(o);
    if center.z <= 0 { return; }
    let axis = 0;
    while axis < 3 {
        let lit = axis == w.hoverAxis || (w.dragging && axis == w.gizmoAxis);
        let c = axisColor(axis, lit);
        if w.gizmoMode == ROTATE {
            let k = 0;
            while k < RING {
                let a = gfx.toScreen(ringPoint(w, o, axis, len, k));
                let b = gfx.toScreen(ringPoint(w, o, axis, len, k + 1));
                if a.z > 0 && b.z > 0 { stroke(flat(a), flat(b), 3, c); }
                k += 1;
            }
        } else {
            let tip = gfx.toScreen(o + armDir(w, axis) * len);
            if tip.z > 0 {
                stroke(flat(center), flat(tip), 3, c);
                if w.gizmoMode == SCALE {
                    square(flat(tip), 11, c);
                } else {
                    square(flat(tip), 8, c);
                    square(flat(tip), 4, rgb(255, 255, 255));
                }
            }
        }
        axis += 1;
    }
    square(flat(center), 7, rgb(235, 235, 240));
    let axes = edgeAxes(w);
    let handle = EDGE_HANDLE;
    while handle < EDGE_HANDLE + 6 {
        if hasEdge(axes, (handle - EDGE_HANDLE) / 2) {
            let p = gfx.toScreen(edgePoint(w, handle));
            let edgeLit = handle == w.hoverAxis || (w.dragging && handle == w.gizmoAxis);
            if p.z > 0 {
                square(flat(p), 12, rgb(20, 22, 28));
                if edgeLit { square(flat(p), 9, rgb(255, 214, 90)); } else { square(flat(p), 9, rgb(235, 235, 240)); }
            }
        }
        handle += 1;
    }
}

/// Name tags for key scene landmarks and the object being inspected.
pub fn drawTags(w: &World) {
    if w.font.raw == 0 { return; }
    let matrices = cachedWorlds(w);
    let i = 0;
    while i < w.scene.len {
        let n = w.scene.nodes[i];
        let tagged = (n.kind == CAMERA || (n.kind == GROUP && n.parent == 0)
            || isPicked(w, n.id) || n.id == w.hoverNode) && n.id != w.viewCam;
        if tagged {
            let model = matrices[i];
            let origin = model.transformPoint(Vec3.xyz(0, 0, 0));
            if (origin - w.cam.eye()).length() <= 60 {
                let p = gfx.toScreen(model.transformPoint(Vec3.xyz(0, 0.35, 0)));
                if p.z > 0 && overViewport(flat(p)) {
                game.setColor(rgba(10, 12, 16, 160));
                let size = game.textSize(w.font, n.name);
                game.drawRect(Vec2 { x: p.x - 4, y: p.y - 22 }, Vec2 { x: size.x + 8, y: size.y + 2 });
                game.setColor(rgb(236, 226, 196));
                game.drawText(w.font, Vec2 { x: p.x, y: p.y - 21 }, n.name);
                }
            }
        }
        i += 1;
    }
}

pub fn toolName(mode: int): string {
    if mode == ROTATE { return "Rotate"; }
    if mode == SCALE { return "Scale"; }
    return "Move";
}

pub fn drawPreviewFrame(w: &World) {
    let id = previewCam(w);
    if id == 0 { return; }
    let size = Vec2 { x: 0, y: 0 };
    let at = previewBox(&size);
    let edge = rgb(14, 15, 19);
    if overPreview(w, game.mousePos()) { edge = rgb(255, 214, 64); }
    outline(at.x - 2, at.y - 2, size.x + 4, size.y + 4, edge);
    if w.font.raw == 0 { return; }
    let t = Text.new(scratch(0));
    t.pushStr(nameOf(w, id));
    if w.previewLock == id { t.pushStr("  (locked)"); }
    let tsize = game.textSize(w.font, t.str());
    fill(at.x, at.y + size.y - tsize.y - 6, tsize.x + 12, tsize.y + 6, rgba(12, 14, 18, 170));
    game.setColor(rgb(210, 214, 222));
    game.drawText(w.font, Vec2 { x: at.x + 6, y: at.y + size.y - tsize.y - 3 }, t.str());
    let lsize = Vec2 { x: 0, y: 0 };
    let lat = lockBox(&lsize);
    let back = rgba(12, 14, 18, 190);
    if w.previewLock == id { back = rgb(58, 96, 170); }
    if overLock(w, game.mousePos()) { back = rgb(80, 120, 200); }
    fill(lat.x, lat.y, lsize.x, lsize.y, back);
    let label = if w.previewLock == id { "Unlock" } else { "Lock" };
    let lt = game.textSize(w.font, label);
    game.setColor(rgb(230, 234, 242));
    game.drawText(w.font, Vec2 { x: lat.x + (lsize.x - lt.x) * 0.5, y: lat.y + (lsize.y - lt.y) * 0.5 }, label);
}

pub fn drawViewportOverlay(w: &World) {
    drawPreviewFrame(w);
    if w.boxing {
        let p = game.mousePos();
        if (p - w.boxFrom).length() > SLOP {
            let x = min(w.boxFrom.x, p.x);
            let y = min(w.boxFrom.y, p.y);
            let bw = max(w.boxFrom.x, p.x) - x;
            let bh = max(w.boxFrom.y, p.y) - y;
            fill(x, y, bw, bh, rgba(72, 128, 220, 40));
            outline(x, y, bw, bh, rgba(120, 170, 255, 200));
        }
    }
    if w.font.raw == 0 { return; }
    let lo = viewMin();
    let t = Text.new(scratch(0));
    if w.viewCam != 0 {
        t.pushStr("Camera: ");
        t.pushStr(nameOf(w, w.viewCam));
        t.pushStr("  |  ");
    } else if w.ortho {
        t.pushStr(viewName(w));
        t.pushStr(" (ortho)  |  ");
    } else {
        t.pushStr("Perspective  |  ");
    }
    t.pushStr(toolName(w.gizmoMode));
    t.pushStr(" tool");
    if w.localSpace { t.pushStr("  |  Local"); }
    if w.pickedCount > 1 {
        t.pushStr("  |  ");
        t.pushInt(w.pickedCount);
        t.pushStr(" selected");
    }
    if w.dragging && game.keyDown(game.Key.Ctrl) { t.pushStr("  |  Snapping"); }
    game.setColor(rgba(12, 14, 18, 150));
    let size = game.textSize(w.font, t.str());
    game.drawRect(Vec2 { x: lo.x + 8, y: lo.y + 8 }, Vec2 { x: size.x + 16, y: size.y + 8 });
    game.setColor(rgb(210, 214, 222));
    game.drawText(w.font, Vec2 { x: lo.x + 16, y: lo.y + 12 }, t.str());
    drawFps(w);
}

/// The editor's own frame rate, in the viewport's bottom-left corner.
pub fn drawFps(w: &World) {
    w.fpsFrames += 1;
    let now = game.ticks();
    if now - w.fpsFrom >= 500 {
        if w.fpsFrom > 0 { w.fps = w.fpsFrames * 1000 / (now - w.fpsFrom); }
        w.fpsFrom = now;
        w.fpsFrames = 0;
    }
    let lo = viewMin();
    let view = viewSize();
    let t = Text.new(scratch(0));
    t.pushInt(w.fps);
    t.pushStr(" FPS");
    let size = game.textSize(w.font, t.str());
    let y = lo.y + view.y - size.y - 16;
    game.setColor(rgba(12, 14, 18, 150));
    game.drawRect(Vec2 { x: lo.x + 8, y: y - 4 }, Vec2 { x: size.x + 16, y: size.y + 8 });
    game.setColor(rgb(210, 214, 222));
    game.drawText(w.font, Vec2 { x: lo.x + 16, y: y }, t.str());
}

pub fn viewName(w: &World): string {
    if !w.axisView { return "Orthographic"; }
    if w.cam.pitch > 1.5 { return "Top"; }
    if w.cam.yaw > 1 { return "Side"; }
    return "Front";
}

pub fn helpLine(w: &World, x: f32, y: f32, keys: string, what: string): f32 {
    game.setColor(rgb(240, 200, 110));
    game.drawText(w.font, Vec2 { x: x, y: y }, keys);
    game.setColor(rgb(210, 214, 222));
    game.drawText(w.font, Vec2 { x: x + 176, y: y }, what);
    return y + 21;
}

/// Shortcut sheet in the viewport's top-right corner.
pub fn drawHelp(w: &World) {
    if !w.showHelp || w.font.raw == 0 { return; }
    let lo = viewMin();
    let size = viewSize();
    let bw: f32 = 490;
    let x = lo.x + size.x - bw - 10;
    let y = lo.y + 10;
    fill(x, y, bw, 21 * 21 + 44, rgba(14, 16, 20, 225));
    game.setColor(rgb(140, 170, 230));
    game.drawText(w.font, Vec2 { x: x + 14, y: y + 10 }, "SHORTCUTS  (H to close)");
    let at = y + 36;
    x = x + 14;
    at = helpLine(w, x, at, "Left click", "Select, or drag a gizmo handle");
    at = helpLine(w, x, at, "Right click", "Actions for what is under the cursor");
    at = helpLine(w, x, at, "Right drag", "Orbit the view");
    at = helpLine(w, x, at, "Middle drag / wheel", "Pan / zoom");
    at = helpLine(w, x, at, "W  E  R  /  L", "Move / rotate / scale  /  local axes");
    at = helpLine(w, x, at, "Ctrl+click / drag", "Add to selection / box select");
    at = helpLine(w, x, at, "Ctrl while dragging", "Snap (steps under Snap)");
    at = helpLine(w, x, at, "1  3  7  /  5", "Front / side / top  /  ortho");
    at = helpLine(w, x, at, "F / double click", "Focus the selection");
    at = helpLine(w, x, at, "0", "Look through the camera (again: leave)");
    at = helpLine(w, x, at, "F2", "Rename");
    at = helpLine(w, x, at, "Arrows", "Strafe and move forward (Shift fast, Ctrl slow)");
    at = helpLine(w, x, at, "Arrows on the list", "Walk rows, fold, or go to parent");
    at = helpLine(w, x, at, "Ctrl+C  X  V", "Copy / cut / paste objects");
    at = helpLine(w, x, at, "Ctrl+D  /  Del", "Duplicate / delete");
    at = helpLine(w, x, at, "Ctrl+Z  /  Ctrl+Y", "Undo / redo");
    at = helpLine(w, x, at, "Ctrl+S  /  Ctrl+P", "Save / save and play");
    at = helpLine(w, x, at, "Drag in hierarchy", "Drop on an object to parent it");
    at = helpLine(w, x, at, "Ctrl+N  /  Ctrl+W", "New scene / close scene tab");
    at = helpLine(w, x, at, "Ctrl+Tab", "Next scene tab (Shift: previous)");
    at = helpLine(w, x, at, "Esc", "Close menu, leave field, deselect");
}
