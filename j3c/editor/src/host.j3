// Events from `j3c editor`: game output, imports, and reloads.

module j3_editor.host;

use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.text.{ Text, cstr, same };
use j3_editor.assets.{ deletedInTabs, renameInTabs };
use j3_editor.console.{ conAdd, lineKind, say };
use j3_editor.files.{ importFile, reloadCatalogs };
use j3_editor.ui_online.loadOnline;
use j3_editor.history.{ paste, snapshot };
use j3_editor.live.liveCommand;
use j3_editor.nodes.viewGround;
use j3_editor.scenes.{ addInstance, openScene };
use j3_editor.shared.shared;
use j3_editor.tabs.switchTab;
use j3_editor.types.{ CON_ERROR, CON_INFO, CON_WARN, Snap, World };
use j3_editor.util.{ cut, fileSize, readAt, removeFile, setText };

pub fn pollHost(w: &World) {
    w.pollTicks += 1;
    if w.pollTicks < 10 { return; }
    w.pollTicks = 0;
    // Read only what the host appended since last time; a game's prints can make it long.
    let size = fileSize("target/j3-editor/events");
    if size < 0 { return; }
    // A shorter file was started over by a new host.
    if size < w.eventsRead { w.eventsRead = 0; }
    let want = size - w.eventsRead;
    if want > 256 * 1024 { want = 256 * 1024; }
    if want <= 0 { return; }
    let log = readAt("target/j3-editor/events", w.eventsRead, want);
    let start = 0;
    let i = 0;
    while i < log.len {
        if log[i] == 10 {
            hostEvent(w, cut(log, start, i));
            start = i + 1;
        }
        i += 1;
    }
    w.eventsRead += start;
}

pub fn hostEvent(w: &World, line: string) {
    let g = shared();
    let a = -1;
    let b = -1;
    let c = -1;
    let i = 0;
    while i < line.len {
        if line[i] == 9 {
            if a < 0 { a = i; }
            else if b < 0 { b = i; }
            else { c = i; break; }
        }
        i += 1;
    }
    if b < 0 { return; }
    let kind = cut(line, 0, a);
    if same(kind, "cmd") {
        // `cmd <id> <scene> <request...>` from `j3c -e mcp`.
        if c < 0 { return; }
        liveCommand(w, cut(line, a + 1, b), cut(line, b + 1, c), cut(line, c + 1, line.len));
        return;
    }
    let message = cut(line, b + 1, line.len);
    if !same(kind, "out") && !same(kind, "err") && !same(kind, "build") { w.onlineBusy = false; }
    if same(kind, "import") || same(kind, "refresh") || same(kind, "placed") { reloadCatalogs(w); }
    if same(kind, "build") {
        conAdd(w, CON_ERROR, message);
        g.consoleOpen = true;
        return;
    }
    if same(kind, "out") {
        conAdd(w, lineKind(message, CON_INFO), message);
        return;
    }
    if same(kind, "err") {
        conAdd(w, lineKind(message, CON_WARN), message);
        return;
    }
    if same(kind, "run") { w.gameRunning = true; }
    if same(kind, "stopped") {
        w.gameRunning = false;
        if same(cut(line, a + 1, b), "crash") {
            conAdd(w, CON_ERROR, message);
            g.consoleOpen = true;
        } else {
            conAdd(w, CON_INFO, message);
        }
    }
    if same(kind, "online") {
        loadOnline(w);
        say(w, message);
        return;
    }
    if same(kind, "picked") {
        setText(&w.importPath, message);
        importFile(w, message, cut(line, a + 1, b));
        return;
    }
    if same(kind, "renamed") {
        if c < 0 { return; }
        reloadCatalogs(w);
        renameInTabs(w, cut(line, a + 1, b), cut(line, b + 1, c));
        say(w, cut(line, c + 1, line.len));
        return;
    }
    if same(kind, "deleted") {
        reloadCatalogs(w);
        deletedInTabs(w, cut(line, a + 1, b));
        say(w, message);
        return;
    }
    if same(kind, "placed") {
        if c < 0 { return; }
        placeImport(w, cut(line, a + 1, b), cut(line, b + 1, c));
        say(w, cut(line, c + 1, line.len));
        return;
    }
    if same(kind, "import") {
        if c < 0 { return; }
        if landImport(w, cut(line, a + 1, b), cut(line, b + 1, c)) {
            say(w, cut(line, c + 1, line.len));
        } else {
            say(w, "Import fragment was unavailable");
        }
    } else {
        say(w, message);
    }
}

/// Place the scene file an import became into scene `path`, keeping the current tab in front.
pub fn placeImport(w: &World, path: string, file: string) {
    let back = w.active;
    if path.len > 0 { openScene(w, path); }
    w.editGesture = false;
    addInstance(w, file, 0, viewGround(w));
    switchTab(w, back);
    snapshot(w);
}

/// Paste the host's imported objects into scene `path` as one undo step, opening its tab if
/// needed. The tab showing now stays in front.
pub fn landImport(w: &World, path: string, name: string): bool {
    if name.len < 16 || !same(cut(name, 0, 7), "import-")
        || !same(cut(name, name.len - 8, name.len), ".j3scene") { return false; }
    let digit = 7;
    while digit < name.len - 8 {
        if name[digit] < 48 || name[digit] > 57 { return false; }
        digit += 1;
    }
    let file = Text.new(scratch(0));
    file.pushStr("target/j3-editor/");
    file.pushStr(name);
    let part = scene3d.read(file.str(), scratch(0));
    // Gone once pasted, so no later event can paste it twice.
    removeFile(file.str());
    if part.len == 0 { return false; }
    let back = w.active;
    if path.len > 0 { openScene(w, path); }
    w.editGesture = false;
    let s = Snap { nodes: part.nodes, len: part.len, next: part.nextId, data: part.data, selected: 0, picked: scratch(0).alloc::<int>(0) };
    paste(w, &s, 0);
    switchTab(w, back);
    snapshot(w);
    return true;
}
