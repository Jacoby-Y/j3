// Small text, file, and number helpers. The only module that talks to libc.

module j3_editor.util;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
    fn access(path: cstr, mode: i32): i32;
    fn unlink(path: cstr): i32;
    fn mkdir(path: cstr, mode: i32): i32;
    fn open(path: cstr, flags: i32): i32;
    fn lseek(fd: i32, offset: int, whence: i32): int;
    fn read(fd: i32, buf: ptr, count: int): int;
    fn close(fd: i32): i32;
    fn stat(path: cstr, buf: ptr): i32;
    fn time(out: ptr): int;
}

use j3.game;
use j3.game.{ Color, rgb };
use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.text.{ Text, cstr, same };
use j3.io;
use j3.result.Result;
use j3_editor.types.{ ONLINE_TAB, Watched, World };

pub fn envValue(name: string, fallback: string): string {
    let raw = libc.getenv(cstr(name));
    if raw == 0 { return fallback; }
    let len = libc.strlen(raw);
    if len < 1 { return fallback; }
    return []u8 { ptr: raw as &u8, len: len } as string;
}

pub fn edit(mem: &Arena, value: string): Text {
    let t = Text.new(mem);
    t.pushStr(value);
    return t;
}

/// Replace a field's text, reusing its buffer.
pub fn setText(t: &Text, value: string) {
    t.clear();
    t.pushStr(value);
}

pub fn edits(mem: &Arena, count: int): []Text {
    let out = mem.alloc::<Text>(count);
    let i = 0;
    while i < count {
        out[i] = Text.new(mem);
        i += 1;
    }
    return out;
}

/// Copy of `s` on `mem`.
pub fn own(mem: &Arena, s: string): string {
    let b = mem.alloc::<u8>(s.len);
    let i = 0;
    while i < s.len {
        b[i] = s[i];
        i += 1;
    }
    return b as string;
}

/// Copy of `s` in the open tab's memory. Text fields change in place, so nodes never keep their bytes.
pub fn keep(w: &World, s: string): string {
    return own(w.scene.arena, s);
}

/// An arena at a fixed address, so a `Scene` can point at it.
pub fn newArena(mem: &Arena, cap: int): &Arena {
    let slot = mem.alloc::<Arena>(1);
    slot[0] = Arena.create(cap);
    return &slot[0];
}

/// `v` when above zero, else `fallback`.
pub fn positive(v: f32, fallback: f32): f32 {
    if v > 0.0001 { return v; }
    return fallback;
}

pub fn endsWith(value: string, suffix: string): bool {
    if value.len < suffix.len { return false; }
    let i = 0;
    while i < suffix.len {
        if value[value.len - suffix.len + i] != suffix[i] { return false; }
        i += 1;
    }
    return true;
}

/// "scenes/enemy.j3scene" -> "enemy".
/// True for the Get Assets tab's path, which names no file.
pub fn isOnline(path: string): bool { return same(path, ONLINE_TAB); }

pub fn stem(path: string): string {
    let start = 0;
    let end = path.len;
    let i = 0;
    while i < path.len {
        if path[i] == 47 {
            start = i + 1;
            end = path.len;
        }
        if path[i] == 46 && i > start { end = i; }
        i += 1;
    }
    if end < start { end = start; }
    return []u8 { ptr: (path.ptr as int + start) as &u8, len: end - start } as string;
}

pub fn fileExists(path: string): bool {
    return libc.access(cstr(path), 0) == 0;
}

pub fn nameChar(b: u8): bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b == 45;
}

pub fn countMsg(verb: string, n: int): string {
    let t = Text.new(scratch(0));
    t.pushStr(verb);
    t.push(32);
    t.pushInt(n);
    if n == 1 { t.pushStr(" object"); } else { t.pushStr(" objects"); }
    return t.str();
}

/// Bytes of `s` from `a` up to `b`.
pub fn cut(s: string, a: int, b: int): string {
    return []u8 { ptr: (s.ptr as int + a) as &u8, len: b - a } as string;
}

/// Whether `text` contains `part`.
pub fn has(text: string, part: string): bool {
    let i = 0;
    while i + part.len <= text.len {
        if same(cut(text, i, i + part.len), part) { return true; }
        i += 1;
    }
    return false;
}

pub fn min(a: f32, b: f32): f32 { if a < b { return a; } return b; }
pub fn max(a: f32, b: f32): f32 { if a > b { return a; } return b; }

/// `v` kept within `lo`..`hi` (`lo` wins when they cross).
pub fn limit(v: f32, lo: f32, hi: f32): f32 {
    if v > hi { v = hi; }
    if v < lo { v = lo; }
    return v;
}

pub fn mouseIn(x: f32, y: f32, wide: f32, tall: f32): bool {
    let p = game.mousePos();
    return p.x >= x && p.x < x + wide && p.y >= y && p.y < y + tall;
}

/// Case-insensitive: `name` contains `part`.
pub fn containsText(name: string, part: string): bool {
    if part.len == 0 { return true; }
    let i = 0;
    while i + part.len <= name.len {
        let j = 0;
        while j < part.len && lower(name[i + j]) == lower(part[j]) { j += 1; }
        if j == part.len { return true; }
        i += 1;
    }
    return false;
}

pub fn lower(b: u8): u8 {
    if b >= 65 && b <= 90 { return b + 32; }
    return b;
}

/// `path` after its last `/`.
pub fn lastPart(path: string): string {
    let start = 0;
    let i = 0;
    while i < path.len {
        if path[i] == 47 { start = i + 1; }
        i += 1;
    }
    return cut(path, start, path.len);
}

/// How many `/` are in `path`.
pub fn slashes(path: string): int {
    let n = 0;
    let i = 0;
    while i < path.len {
        if path[i] == 47 { n += 1; }
        i += 1;
    }
    return n;
}

/// `path` up to (not including) its `k`th `/`; "" for 0, all of it when it has fewer.
pub fn dirPrefix(path: string, k: int): string {
    if k <= 0 { return cut(path, 0, 0); }
    let n = 0;
    let i = 0;
    while i < path.len {
        if path[i] == 47 {
            n += 1;
            if n == k { return cut(path, 0, i); }
        }
        i += 1;
    }
    return path;
}

/// How many leading folders `a` and `b` share.
pub fn sharedDirs(a: string, b: string): int {
    let k = 1;
    while k <= slashes(a) && k <= slashes(b) {
        if !same(dirPrefix(a, k), dirPrefix(b, k)) { return k - 1; }
        k += 1;
    }
    return k - 1;
}

pub fn toColor(v: Vec3): Color {
    return rgb(u8(clamp01(v.x) * 255 + 0.5), u8(clamp01(v.y) * 255 + 0.5), u8(clamp01(v.z) * 255 + 0.5));
}

pub fn clamp01(v: f32): f32 {
    if v < 0 { return 0; }
    if v > 1 { return 1; }
    return v;
}

/// Option `i` of "a|b|c".
pub fn optionAt(options: string, i: int): string {
    let start = 0;
    let k = 0;
    let at = 0;
    while at <= options.len {
        if at == options.len || options[at] == 124 {
            if k == i { return cut(options, start, at); }
            k += 1;
            start = at + 1;
        }
        at += 1;
    }
    return "";
}

/// The option after `current` in `a|b|c`, wrapping to the first.
pub fn nextOption(options: string, current: string): string {
    let start = 0;
    let first = "";
    let takeNext = false;
    let i = 0;
    while i <= options.len {
        if i == options.len || options[i] == 124 {
            let option = cut(options, start, i);
            if takeNext { return option; }
            if start == 0 { first = option; }
            if same(option, current) { takeNext = true; }
            start = i + 1;
        }
        i += 1;
    }
    return first;
}

/// Delete `path`; a missing file is fine.
pub fn removeFile(path: string) {
    libc.unlink(cstr(path));
}

/// Make directory `path` (rwxr-xr-x); one that exists is fine.
pub fn makeDir(path: string) {
    libc.mkdir(cstr(path), 493);
}

/// Length of `path` in bytes, or -1 when it can't be opened.
pub fn fileSize(path: string): int {
    let fd = libc.open(cstr(path), 0);
    if fd < 0 { return -1; }
    let size = libc.lseek(fd, 0, 2);
    libc.close(fd);
    return size;
}

/// When `path` last changed, in nanoseconds since 1970, or 0 when it can't be read.
/// `fresh` is set when that was under two seconds ago: a file system with one-second
/// times can change a file again without changing its time, so a fresh time proves nothing.
pub fn fileStamp(path: string, fresh: &bool): int {
    // ponytail: x86_64 Linux `struct stat` (144 bytes, st_mtim at byte 88); plan 013 ports it.
    let buf = scratch(0).alloc::<int>(18);
    *fresh = true;
    if libc.stat(cstr(path), buf.ptr as ptr) != 0 { return 0; }
    *fresh = libc.time(0 as ptr) - buf[11] < 2;
    return buf[11] * 1000000000 + buf[12];
}

/// Up to `want` bytes of `path` from byte `from`, in scratch memory, or "" on failure.
pub fn readAt(path: string, from: int, want: int): string {
    let fd = libc.open(cstr(path), 0);
    if fd < 0 { return ""; }
    let buf = scratch(0).alloc::<u8>(want);
    libc.lseek(fd, from, 0);
    let got = libc.read(fd, buf.ptr as ptr, want);
    libc.close(fd);
    if got <= 0 { return ""; }
    return []u8 { ptr: buf.ptr, len: got } as string;
}

// ---- files the editor watches for outside edits (see watch.j3) ----

pub fn watchSlot(w: &World, path: string): int {
    let i = 0;
    while i < w.watchCount {
        if same(w.watched[i].path, path) { return i; }
        i += 1;
    }
    return -1;
}

/// The file's bytes on `mem`; `ok` is false when it can't be read.
pub fn readNow(path: string, mem: &Arena, ok: &bool): []u8 {
    match io.readFile(path, mem) {
        Result.Ok(b) {
            *ok = true;
            return b;
        }
        Result.Err(_) {
            *ok = false;
            return mem.alloc::<u8>(0);
        }
    }
}

/// Record `path` as it is on disk now: after the editor writes or opens it.
// ponytail: keeps each version's text in the editor heap; saves and outside edits are rare.
pub fn remember(w: &World, path: string) {
    // Stamp before reading: a write in between changes the stamp, so it is looked at again.
    let fresh = false;
    let stamp = fileStamp(path, &fresh);
    let found = false;
    let bytes = readNow(path, w.mem, &found);
    if !found { return; }
    let slot = watchSlot(w, path);
    if slot < 0 {
        if w.watchCount == w.watched.len {
            let grown = w.mem.alloc::<Watched>(w.watched.len * 2);
            let k = 0;
            while k < w.watchCount { grown[k] = w.watched[k]; k += 1; }
            w.watched = grown;
        }
        slot = w.watchCount;
        w.watchCount += 1;
        w.watched[slot].path = own(w.mem, path);
    }
    w.watched[slot].text = bytes;
    w.watched[slot].stamp = if fresh { 0 } else { stamp };
}
