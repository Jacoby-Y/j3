// Left panel: the scene hierarchy, the asset list, and the material preview.

module j3_editor.ui_tree;

use j3.game;
use j3.game.{ rgb, rgba };
use j3.math.Vec2;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ Node, CAMERA };
use j3.text.Text;
use j3.ui.{ Ui, hovering };
use j3_editor.assets.{ assetRelease, foldAsset, foldedUnder, isFolded, pickFile };
use j3_editor.cameras.mainCamera;
use j3_editor.console.say;
use j3_editor.files.{ focus, importFile, newEffect, newMaterial, rescan };
use j3_editor.layout.{ edgeAt, treeDragging };
use j3_editor.materials.setPreviewShape;
use j3_editor.menu.{ openAddMenu, openFileMenu, openMenu };
use j3_editor.nodes.{ dropBeside, dropOn, setCollapsed, viewGround };
use j3_editor.overrides.{ claimObject, listedPlaced };
use j3_editor.selection.{ doubleClick, isPicked, nameOf, pickRange, select, togglePick };
use j3_editor.shared.shared;
use j3_editor.types.{
    ARROW, BOTTOM, INDENT, PREVIEW_CUBE, PREVIEW_PLANE, PREVIEW_SPHERE, RESIZE_SPLIT, TOP, World,
};
use j3_editor.util.{
    containsText, dirPrefix, endsWith, lastPart, mouseIn, sharedDirs, slashes, stem,
};
use j3_editor.widgets.{ caption, fill, fitLeft, kindColor, kindName, outline, section, toolButton };

pub @j3ui treeRow(ui: &Ui, w: &World, n: Node, depth: int, parent: bool) {
    if w.rowCount >= w.rows.len {
        let more = w.mem.alloc::<int>(w.rows.len * 2);
        let i = 0;
        while i < w.rowCount {
            more[i] = w.rows[i];
            i += 1;
        }
        w.rows = more;
    }
    w.rows[w.rowCount] = n.id;
    w.rowCount += 1;
    if !ui.shown(ui.y, ui.h) {
        gap(ui.h + 2);
        return;
    }
    let indent = f32(depth) * 16;
    if indent > ui.w - 120 { indent = ui.w - 120; }
    if indent < 0 { indent = 0; }
    let rowX = ui.x;
    let rowY = ui.y;
    let keepW = ui.w;
    let t = Text.new(scratch(0));
    t.pushStr("    ");
    t.pushStr(n.name);
    // The fold arrow sits left of the row button, so clicking it never selects.
    if parent && !w.menuOpen && mouseIn(rowX + indent, rowY, ARROW, ui.h) && game.mousePressed(game.Mouse.Left) {
        setCollapsed(w, n.id, !n.collapsed);
    }
    ui.x = rowX + indent + ARROW;
    ui.w = keepW - indent - ARROW;
    ui.pushId(n.id);
    if toolButton(ui, t.str(), isPicked(w, n.id)) {
        if claimObject(w, n.id) {
        } else if game.keyDown(game.Key.Ctrl) {
            togglePick(w, n.id);
        } else if game.keyDown(game.Key.Shift) {
            pickRange(w, n.id);
        } else {
            select(w, n.id);
            if doubleClick(w, n.id) { focus(w); }
            // Placed objects keep the hierarchy their scene file gives them.
            if n.owner == 0 {
                w.treeDrag = n.id;
                w.treeFrom = game.mousePos();
            }
        }
    }
    popId();
    ui.x = rowX;
    ui.w = keepW;
    gap(-4);
    let visible = ui.shown(rowY, ui.h);
    let over = visible && !w.menuOpen && mouseIn(rowX, rowY, keepW, ui.h + 2);
    if over && game.mousePressed(game.Mouse.Right) { openMenu(w, game.mousePos(), n.id); }
    if over && w.assetDragging {
        w.dropTarget = n.id;
        w.dropWhere = 0;
    } else if over && w.treeDrag != 0 && n.owner == 0 {
        w.dropTarget = n.id;
        // Top and bottom quarters place it beside this row; the middle puts it inside.
        let mouse = game.mousePos();
        let dy = mouse.y - rowY;
        w.dropWhere = 0;
        if dy < ui.h * 0.25 { w.dropWhere = -1; }
        if dy > ui.h * 0.75 { w.dropWhere = 1; }
    }
    if !visible { return; }
    if parent && w.font.raw != 0 {
        let arrow = "▾";
        if n.collapsed { arrow = "▸"; }
        game.setColor(rgb(150, 156, 170));
        game.drawText(w.font, Vec2 { x: rowX + indent + 2, y: rowY + 3 }, arrow);
    }
    fill(rowX + indent + ARROW + 9, rowY + ui.h * 0.5 - 4, 8, 8, kindColor(n.kind));
    if w.font.raw != 0 {
        let tag = kindName(n.kind);
        if n.kind == CAMERA && n.id == mainCamera(w) { tag = "main camera"; }
        if n.owner != 0 { tag = "placed"; }
        if n.missing { tag = "missing"; }
        let size = game.textSize(w.font, tag);
        game.setColor(rgb(120, 126, 140));
        if isPicked(w, n.id) { game.setColor(rgb(210, 222, 245)); }
        if n.missing { game.setColor(rgb(240, 96, 96)); }
        game.drawText(w.font, Vec2 { x: rowX + keepW - size.x - 8, y: rowY + 3 }, tag);
    }
    if (treeDragging(w) || w.assetDragging) && w.dropTarget == n.id && n.id != w.treeDrag {
        let gold = rgb(255, 214, 64);
        if w.dropWhere < 0 { fill(rowX + indent, rowY - 2, keepW - indent, 2, gold); }
        else if w.dropWhere > 0 { fill(rowX + indent, rowY + ui.h, keepW - indent, 2, gold); }
        else { outline(rowX + indent, rowY, keepW - indent, ui.h, gold); }
    }
}

/// Walk depth first with an explicit stack, so deeply nested scenes do not exhaust the call stack.
/// While searching, `shown` limits rows to matches and their parents, and folds are ignored.
pub @j3ui treeRows(ui: &Ui, w: &World, first: []int, next: []int, root: int, shown: []bool) {
    let pending = scratch(0).alloc::<int>(w.scene.len + 1);
    let searching = w.treeFilter.len() > 0;
    let depth = 0;
    pending[0] = first[root];
    while depth >= 0 {
        let i = pending[depth];
        if i < 0 { depth -= 1; continue; }
        pending[depth] = next[i];
        if searching && !shown[i] { continue; }
        let n = w.scene.nodes[i];
        treeRow(ui, w, n, depth, first[i] >= 0);
        if first[i] >= 0 && (searching || !n.collapsed) {
            depth += 1;
            pending[depth] = first[i];
        }
    }
}

/// Mark the objects whose name holds the search text, and every parent above them.
pub fn searchTree(w: &World): []bool {
    let shown = scratch(0).alloc::<bool>(w.scene.len + 1);
    let i = 0;
    while i < w.scene.len { shown[i] = false; i += 1; }
    if w.treeFilter.len() == 0 { return shown; }
    i = 0;
    while i < w.scene.len {
        if w.scene.nodes[i].owner == 0 && containsText(w.scene.nodes[i].name, w.treeFilter.str()) {
            let at = i;
            while at >= 0 && !shown[at] {
                shown[at] = true;
                at = scene3d.index(&w.scene, w.scene.nodes[at].parent);
            }
        }
        i += 1;
    }
    return shown;
}

pub @j3ui tree(ui: &Ui, w: &World) {
    let len = w.scene.len;
    let first = scratch(0).alloc::<int>(len + 1);
    let next = scratch(0).alloc::<int>(len + 1);
    let i = 0;
    while i <= len {
        first[i] = -1;
        i += 1;
    }
    i = len - 1;
    while i >= 0 {
        let n = w.scene.nodes[i];
        if n.owner == 0 || listedPlaced(w, n) {
            let p = len;
            if n.parent != 0 {
                let at = scene3d.index(&w.scene, n.parent);
                if at >= 0 { p = at; }
            }
            next[i] = first[p];
            first[p] = i;
        }
        i -= 1;
    }
    treeRows(ui, w, first, next, len, searchTree(w));
}

/// The hierarchy: add menu, search, and the object tree, over `TREE_SHARE` of the room.
pub @j3ui hierarchyPanel(ui: &Ui, w: &World, bottom: f32) {
    let g = shared();
    section(ui, "HIERARCHY");
    row() {
        let addAt = Vec2 { x: ui.x, y: ui.y + ui.h + 2 };
        button("+ Add ▾") { openAddMenu(w, addAt); }
        field("Search objects", &w.treeFilter);
    }
    gap(6);
    let treeTop = ui.y;
    w.treeTop = treeTop;
    w.treeRoom = bottom - ui.y;
    let treeHeight = w.treeRoom * g.treeShare;
    w.rowCount = 0;
    w.dropTarget = -1;
    let keepH = ui.h;
    ui.h = 24;
    scroll(101, treeHeight) {
        if w.scene.len == 0 { caption(ui, "Empty scene. Add an object above."); }
        tree(ui, w);
    }
    ui.h = keepH;
    let grip = rgb(70, 76, 90);
    if w.resizing == RESIZE_SPLIT || edgeAt(w, game.mousePos()) == RESIZE_SPLIT { grip = ui.theme.accent; }
    fill(g.left * 0.5 - 18, ui.y + 2, 36, 2, grip);
    // Empty space in the tree: right-click for the add menu, drop to un-parent.
    let inTree = !w.menuOpen && mouseIn(12, treeTop, g.left - 24, treeHeight);
    if inTree && game.mousePressed(game.Mouse.Right) && !hovering() {
        w.menuPoint = viewGround(w);
        openMenu(w, game.mousePos(), 0);
    }
    if inTree && w.dropTarget < 0 && (w.treeDrag != 0 || w.assetDragging) {
        w.dropTarget = 0;
        w.dropWhere = 0;
    }
    if w.treeDrag != 0 && !game.mouseDown(game.Mouse.Left) {
        if treeDragging(w) && w.dropTarget > 0 && w.dropWhere != 0 {
            dropBeside(w, w.treeDrag, w.dropTarget, w.dropWhere > 0);
        } else if treeDragging(w) && w.dropTarget >= 0 {
            dropOn(w, w.treeDrag, w.dropTarget);
        }
        w.treeDrag = 0;
    }
}

/// A material tab's left panel: what to show the material on.
pub @j3ui previewPanel(ui: &Ui, w: &World, bottom: f32) {
    let g = shared();
    section(ui, "PREVIEW");
    caption(ui, "Show the material on");
    let shape = w.mat.shape;
    row() {
        if toolButton(ui, "Sphere", shape == PREVIEW_SPHERE) { shape = PREVIEW_SPHERE; }
        if toolButton(ui, "Cube", shape == PREVIEW_CUBE) { shape = PREVIEW_CUBE; }
        if toolButton(ui, "Plane", shape == PREVIEW_PLANE) { shape = PREVIEW_PLANE; }
    }
    if shape != w.mat.shape { setPreviewShape(w, shape); }
    caption(ui, "Right-drag to turn it, wheel to zoom.");
    caption(ui, "Click an image below to use it.");
    w.treeTop = ui.y;
    w.treeRoom = bottom - ui.y;
    gap(w.treeRoom * g.treeShare - 60);
}

pub @j3ui leftPanel(ui: &Ui, w: &World) {
    let g = shared();
    let win = game.windowSize();
    let bottom = win.y - BOTTOM - 10;
    ui.x = 12;
    ui.y = TOP + 6;
    ui.w = g.left - 24;
    if w.matTab { previewPanel(ui, w, bottom); } else { hierarchyPanel(ui, w, bottom); }
    section(ui, "ASSETS");
    row() {
        button("Import") {
            if w.importPath.len() == 0 {
                say(w, "Type a path, drop a file on the window, or pick one");
            } else {
                importFile(w, w.importPath.str(), w.path);
            }
        }
        field("model.glb", &w.importPath);
    }
    row() {
        button("Pick file...") { pickFile(w); }
        button("Rescan (F5)") { rescan(w); }
    }
    button("New material") { newMaterial(w); }
    row() {
        button("New effect") { newEffect(w, false); }
        button("New camera effect") { newEffect(w, true); }
    }
    check("Import as a reusable scene", &w.importAsScene);
    let listHeight = bottom - ui.y;
    if listHeight < 40 { listHeight = 40; }
    scroll(103, listHeight) {
        let assetCount = w.assetCount;
        if assetCount == 0 { caption(ui, "No assets in assets/ yet."); }
        if assetCount > 0 { caption(ui, "Right-click a file for actions."); }
        // Paths come sorted, so each one only opens the folders it doesn't share with the last.
        let prev = "";
        let a = 0;
        while a < assetCount {
            let path = w.assetPaths[a];
            let dirs = slashes(path);
            let k = sharedDirs(prev, path) + 1;
            while k <= dirs {
                let dir = dirPrefix(path, k);
                if !foldedUnder(w, dir) {
                    ui.pushId(300000 + a * 16 + k);
                    let open = !isFolded(w, dir);
                    let label = Text.new(scratch(1));
                    if open { label.pushStr("▾ "); } else { label.pushStr("▸ "); }
                    label.pushStr(lastPart(dir));
                    let keepX = ui.x;
                    let keepW = ui.w;
                    ui.x += f32(k - 1) * INDENT;
                    ui.w -= f32(k - 1) * INDENT;
                    button(label.str()) { foldAsset(w, dir, open); }
                    ui.x = keepX;
                    ui.w = keepW;
                    popId();
                }
                k += 1;
            }
            prev = path;
            if !foldedUnder(w, path) { assetRow(ui, w, a, dirs); }
            a += 1;
        }
    }
    assetRelease(w);
}

/// Asset `a`'s row, indented `depth` folders in: its file name and a kind tag. A press
/// can start a drag; a right-click opens its menu.
pub @j3ui assetRow(ui: &Ui, w: &World, a: int, depth: int) {
    let path = w.assetPaths[a];
    ui.pushId(100000 + a);
    let keepX = ui.x;
    let keepW = ui.w;
    ui.x += f32(depth) * INDENT;
    ui.w -= f32(depth) * INDENT;
    let rowY = ui.y;
    let rowX = ui.x;
    let tag = "image";
    if endsWith(path, ".j3mesh") { tag = "mesh"; }
    if endsWith(path, ".j3mat") { tag = "material"; }
    if endsWith(path, ".j3fx") { tag = "effect"; }
    if endsWith(path, ".j3scene") { tag = "scene"; }
    let tagRoom: f32 = 60;
    if w.font.raw != 0 {
        let tagSize = game.textSize(w.font, tag);
        tagRoom = tagSize.x + 30;
    }
    let name = lastPart(path);
    // The row acts on release, so a press can also start a drag.
    button(fitLeft(w, name, ui.w - tagRoom)) {
        w.assetPress = a + 1;
        w.assetFrom = game.mousePos();
        w.assetDragging = false;
    }
    if !w.menuOpen && ui.shown(rowY, ui.h) && mouseIn(rowX, rowY, ui.w, ui.h)
        && game.mousePressed(game.Mouse.Right) {
        openFileMenu(w, game.mousePos(), path);
    }
    if w.font.raw != 0 && ui.shown(rowY, ui.h) {
        let size = game.textSize(w.font, tag);
        fill(rowX + ui.w - size.x - 16, rowY, size.x + 16, ui.h, rgb(52, 56, 66));
        game.setColor(rgb(140, 146, 160));
        game.drawText(w.font, Vec2 { x: rowX + ui.w - size.x - 8, y: rowY + 4 }, tag);
    }
    ui.x = keepX;
    ui.w = keepW;
    popId();
}

/// The dragged hierarchy row's name, following the cursor.
pub fn drawTreeGhost(w: &World) {
    if !(treeDragging(w) || w.assetDragging) || w.font.raw == 0 { return; }
    let p = game.mousePos();
    let name = "";
    if w.assetDragging { name = stem(w.assetPaths[w.assetPress - 1]); } else { name = nameOf(w, w.treeDrag); }
    let size = game.textSize(w.font, name);
    fill(p.x + 14, p.y + 6, size.x + 16, size.y + 8, rgba(72, 128, 220, 220));
    game.setColor(rgb(255, 255, 255));
    game.drawText(w.font, Vec2 { x: p.x + 22, y: p.y + 10 }, name);
}
