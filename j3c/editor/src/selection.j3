// Bundled desktop scene editor. Run by `j3c editor` with the project as cwd.

module j3_editor.selection;

use j3.game;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.data.save;
use j3.text.{ Text, same };
use j3_editor.shared.shared;
use j3_editor.types.{ DOUBLE_MS, World };
use j3_editor.util.{ keep, setText };

/// Select only `id` (0 clears the selection).
pub fn select(w: &World, id: int) {
    let g = shared();
    g.pick.id = 0;
    w.pickedCount = 0;
    setPrimary(w, id);
}

/// Show `id` in the inspector and gizmo, adding it to the selection.
pub fn setPrimary(w: &World, id: int) {
    w.meshPath = false;
    let at = scene3d.index(&w.scene, id);
    if at < 0 {
        w.selected = 0;
        w.candidate.selected = 0;
        return;
    }
    if !isPicked(w, id) { addPick(w, id); }
    w.selected = id;
    // Undoing the next edit brings this selection back too.
    w.candidate.selected = id;
    let n = w.scene.nodes[at];
    setText(&w.nameEdit, n.name);
    setText(&w.assetEdit, n.asset);
    setText(&w.textureEdit, n.texture);
    setText(&w.scriptEdit, n.script);
    loadParams(w);
}

// ponytail: linear scans; a hash set once people select thousands of objects at once.
pub fn isPicked(w: &World, id: int): bool {
    let i = 0;
    while i < w.pickedCount {
        if w.picked[i] == id { return true; }
        i += 1;
    }
    return false;
}

pub fn addPick(w: &World, id: int) {
    if w.pickedCount >= w.picked.len {
        let more = w.mem.alloc::<int>(w.picked.len * 2);
        let i = 0;
        while i < w.pickedCount { more[i] = w.picked[i]; i += 1; }
        w.picked = more;
    }
    w.picked[w.pickedCount] = id;
    w.pickedCount += 1;
}

/// Ctrl+click: add `id` to the selection, or take it out.
pub fn togglePick(w: &World, id: int) {
    if id == 0 { return; }
    if !isPicked(w, id) {
        setPrimary(w, id);
        return;
    }
    let i = 0;
    let k = 0;
    while i < w.pickedCount {
        if w.picked[i] != id {
            w.picked[k] = w.picked[i];
            k += 1;
        }
        i += 1;
    }
    w.pickedCount = k;
    if w.selected == id {
        let next = 0;
        if k > 0 { next = w.picked[k - 1]; }
        w.selected = 0;
        setPrimary(w, next);
    }
}

/// Shift+click in the hierarchy: select the rows from the current one to `id`.
pub fn pickRange(w: &World, id: int) {
    let from = -1;
    let to = -1;
    let i = 0;
    while i < w.rowCount {
        if w.rows[i] == w.selected { from = i; }
        if w.rows[i] == id { to = i; }
        i += 1;
    }
    if from < 0 || to < 0 {
        select(w, id);
        return;
    }
    let lo = from;
    let hi = to;
    if lo > hi {
        lo = to;
        hi = from;
    }
    w.pickedCount = 0;
    i = lo;
    while i <= hi {
        addPick(w, w.rows[i]);
        i += 1;
    }
    setPrimary(w, id);
}

/// Selected objects that don't have a selected parent, grandparent, and so on. Commands act
/// on these, since each takes its children along.
pub fn pickedRoots(w: &World): []int {
    let out = scratch(0).alloc::<int>(w.pickedCount);
    let n = 0;
    let i = 0;
    while i < w.pickedCount {
        let id = w.picked[i];
        let under = false;
        let up = parentOf(w, id);
        while up != 0 && !under {
            if isPicked(w, up) { under = true; }
            up = parentOf(w, up);
        }
        if !under && scene3d.index(&w.scene, id) >= 0 {
            out[n] = id;
            n += 1;
        }
        i += 1;
    }
    return []int { ptr: out.ptr, len: n };
}

pub fn nameOf(w: &World, id: int): string {
    let at = scene3d.index(&w.scene, id);
    if at < 0 { return ""; }
    return w.scene.nodes[at].name;
}

pub fn parentOf(w: &World, id: int): int {
    let at = scene3d.index(&w.scene, id);
    if at < 0 { return 0; }
    return w.scene.nodes[at].parent;
}

pub fn catalogKey(w: &World, i: int, j: int, suffix: string): string {
    let t = Text.new(scratch(0));
    t.pushStr("catalog.");
    t.pushInt(i);
    if j >= 0 { t.push(46); t.pushInt(j); }
    t.push(46);
    t.pushStr(suffix);
    return t.str();
}

pub fn scriptIndex(w: &World, name: string): int {
    let count = save.getInt(&w.catalog, "catalog.count", 0);
    let i = 0;
    while i < count {
        if same(save.getStr(&w.catalog, catalogKey(w, i, -1, "name"), ""), name) {
            return i;
        }
        i += 1;
    }
    return -1;
}

pub fn loadParams(w: &World) {
    let at = scene3d.index(&w.scene, w.selected);
    if at < 0 { return; }
    let n = w.scene.nodes[at];
    let script = scriptIndex(w, n.script);
    if script < 0 { return; }
    let count = save.getInt(&w.catalog, catalogKey(w, script, -1, "count"), 0);
    let j = 0;
    while j < count && j < w.paramEdits.len {
        let field = save.getStr(&w.catalog, catalogKey(w, script, j, "name"), "");
        let fallback = save.getStr(&w.catalog, catalogKey(w, script, j, "default"), "");
        setText(&w.paramEdits[j], scene3d.label(&w.scene, n.id, field, fallback));
        j += 1;
    }
}

/// `base`, or `base` with the first number from 2 up that no object in the scene is named.
pub fn uniqueName(w: &World, base: string): string {
    let t = Text.new(scratch(0));
    t.pushStr(base);
    let n = 2;
    while nameTaken(w, t.str()) {
        t.clear();
        t.pushStr(base);
        t.pushInt(n);
        n += 1;
    }
    return keep(w, t.str());
}

pub fn nameTaken(w: &World, name: string): bool {
    let i = 0;
    while i < w.scene.len {
        if same(w.scene.nodes[i].name, name) { return true; }
        i += 1;
    }
    return false;
}

/// True when `id` was also the last thing clicked, recently enough to be a double click.
pub fn doubleClick(w: &World, id: int): bool {
    let now = game.ticks();
    let twice = id != 0 && id == w.clickId && now - w.clickMs < DOUBLE_MS;
    w.clickId = id;
    w.clickMs = now;
    if twice { w.clickId = 0; }
    return twice;
}
