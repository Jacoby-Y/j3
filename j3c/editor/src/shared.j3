// Editor-wide state that lives outside `World`: panel layout and the color picker.

module j3_editor.shared;

use j3.game.Texture;
use j3.math.{ Vec2, Vec3 };

/// The color picker popup: which row owns it and the color being edited.
pub struct Picker {
    /// Ui id of the color row that opened it; 0 when closed.
    id: int;
    rgb: Vec3;
    /// Hue, saturation, value, kept beside `rgb` so hue survives grays.
    hsv: Vec3;
    /// The color when it opened, for revert.
    old: Vec3;
    /// Top-left of the popup.
    at: Vec2;
    /// The popup changed the color since the row last read it.
    changed: bool;
    /// Close once the row has read the last change.
    shut: bool;
    /// Opened this frame, so the opening click isn't a click outside.
    fresh: bool;
    /// 1 while dragging in the square, 2 on the hue bar.
    drag: int;
    /// The saturation/value square baked for hue `squareHue`, and the hue bar (both made on first open).
    square: Texture;
    squareHue: f32;
    hues: Texture;
}

pub struct Shared {
    /// Hierarchy and assets panel width. Drag its edge to change it; kept in prefs.
    left: f32;
    /// Inspector panel width, likewise.
    right: f32;
    /// Share of the left panel's free height given to the hierarchy.
    treeShare: f32;
    /// The viewport area splits into up to `MAX_PANES` side-by-side panes, each showing one
    /// of its tabs. `paneShare` is each one's share of the width.
    panes: int;
    paneShare: [4]f32;
    /// The pane with the active tab, which gets input.
    focus: int;
    /// The console under the panes: shown or not, and its height.
    consoleOpen: bool;
    consoleHeight: f32;
    /// The pane being drawn when it isn't `focus`, else -1. `viewMin`/`viewSize` follow it.
    drawPane: int;
    pick: Picker;
    /// Recently picked colors, newest first; kept in prefs.
    recent: [8]Vec3;
    recentN: int;
    /// Game window width over height (`J3_EDITOR_ASPECT`), for the camera preview and frustums.
    aspect: f32 = 1.7777778;
}

#[singleton]
let SHARED: Shared = Shared {
    left: 290,
    right: 320,
    treeShare: 0.55,
    panes: 1,
    paneShare: [1, 0, 0, 0],
    focus: 0,
    consoleOpen: false,
    consoleHeight: 200,
    drawPane: -1,
    pick: Picker {
        id: 0,
        rgb: Vec3 { x: 0, y: 0, z: 0 },
        hsv: Vec3 { x: 0, y: 0, z: 0 },
        old: Vec3 { x: 0, y: 0, z: 0 },
        at: Vec2 { x: 0, y: 0 },
        changed: false,
        shut: false,
        fresh: false,
        drag: 0,
        square: Texture {},
        squareHue: 0,
        hues: Texture {},
    },
    recent: [
        Vec3 { x: 0, y: 0, z: 0 }, Vec3 { x: 0, y: 0, z: 0 }, Vec3 { x: 0, y: 0, z: 0 },
        Vec3 { x: 0, y: 0, z: 0 }, Vec3 { x: 0, y: 0, z: 0 }, Vec3 { x: 0, y: 0, z: 0 },
        Vec3 { x: 0, y: 0, z: 0 }, Vec3 { x: 0, y: 0, z: 0 },
    ],
    recentN: 0,
};

/// Singletons are private to their module, so everyone reaches this one through a pointer:
/// `let g = shared(); g.left = 300;`.
pub fn shared(): &Shared {
    return &SHARED;
}
