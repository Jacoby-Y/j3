// Scene tab strips, panes, and the panel backgrounds.

module j3_editor.ui_panes;

use j3.game;
use j3.game.{ rgb, rgba };
use j3.math.Vec2;
use j3.memory.{ Arena, scratch };
use j3.text.Text;
use j3.ui.{ Ui, hovering };
use j3_editor.commands.run;
use j3_editor.layout.{ consoleH, dropSide, edgeAt, paneArea, paneAt, paneW, paneX };
use j3_editor.prefs.savePrefs;
use j3_editor.scenes.closeTab;
use j3_editor.shared.shared;
use j3_editor.tabs.{ dockTab, frontTab, saveSession, switchTab, tabsIn };
use j3_editor.types.{
    BOTTOM, CMD_NEW_SCENE, RESIZE_CONSOLE, RESIZE_LEFT, RESIZE_NONE, RESIZE_PANE, RESIZE_RIGHT, RESIZE_SPLIT, SLOP, TABS, TOP, Tab, World,
};
use j3_editor.util.{ isOnline, limit, mouseIn, stem };
use j3_editor.viewport.drawViewport;
use j3_editor.widgets.fill;

/// Drag panel edges and the hierarchy/assets split. True while one is held, so nothing
/// else takes the mouse.
pub fn resizePanels(w: &World, mouse: Vec2): bool {
    let g = shared();
    let win = game.windowSize();
    // A smaller window squeezes the panels first.
    g.right = limit(g.right, 220, win.x - 200 - g.left);
    g.left = limit(g.left, 200, win.x - 200 - g.right);
    if w.resizing == RESIZE_NONE {
        let edge = edgeAt(w, mouse);
        if w.menuOpen || w.dragging || w.boxing || w.treeDrag != 0 || (hovering() && edge == RESIZE_SPLIT) {
            edge = RESIZE_NONE;
        }
        if edge == RESIZE_SPLIT || edge == RESIZE_CONSOLE { game.setCursor(game.Cursor.ResizeUpDown); }
        else if edge != RESIZE_NONE { game.setCursor(game.Cursor.ResizeAcross); }
        else { game.setCursor(game.Cursor.Arrow); }
        if edge == RESIZE_NONE || !game.mousePressed(game.Mouse.Left) { return false; }
        w.resizing = edge;
    }
    if !game.mouseDown(game.Mouse.Left) {
        if w.resizing >= RESIZE_PANE || w.resizing == RESIZE_CONSOLE { saveSession(w); }
        w.resizing = RESIZE_NONE;
        savePrefs(w);
        return true;
    }
    if w.resizing == RESIZE_CONSOLE {
        g.consoleHeight = limit(win.y - BOTTOM - mouse.y, 90, win.y - TOP - TABS - BOTTOM - 120);
        return true;
    }
    if w.resizing >= RESIZE_PANE {
        // Move the divider right of pane k, keeping both sides at least 200 px wide.
        let k = w.resizing - RESIZE_PANE;
        let lo = paneX(k);
        let hi = paneX(k + 1) + paneW(k + 1);
        let at = limit(mouse.x, lo + 200, hi - 200);
        let both = g.paneShare[k] + g.paneShare[k + 1];
        g.paneShare[k] = (at - lo) / paneArea();
        g.paneShare[k + 1] = both - g.paneShare[k];
        return true;
    }
    // Keep at least 200 px of viewport between the panels.
    let most = win.x - 200;
    if w.resizing == RESIZE_LEFT {
        g.left = limit(mouse.x, 200, most - g.right);
    } else if w.resizing == RESIZE_RIGHT {
        g.right = limit(win.x - mouse.x, 220, most - g.left);
    } else {
        g.treeShare = limit((mouse.y - 3 - w.treeTop) / w.treeRoom, 0.15, 0.85);
    }
    return true;
}

pub fn drawPanels(w: &World) {
    let g = shared();
    let win = game.windowSize();
    let panel = rgb(34, 37, 44);
    let edge = rgb(16, 17, 21);
    let lit = rgb(90, 130, 210);
    let over = edgeAt(w, game.mousePos());
    if w.resizing != RESIZE_NONE { over = w.resizing; }
    let leftEdge = edge;
    let rightEdge = edge;
    if over == RESIZE_LEFT { leftEdge = lit; }
    if over == RESIZE_RIGHT { rightEdge = lit; }
    fill(0, TOP, g.left, win.y - TOP - BOTTOM, panel);
    fill(g.left - 1, TOP, 2, win.y - TOP - BOTTOM, leftEdge);
    fill(win.x - g.right, TOP, g.right, win.y - TOP - BOTTOM, panel);
    fill(win.x - g.right - 1, TOP, 2, win.y - TOP - BOTTOM, rightEdge);
    let k = 1;
    while k < g.panes {
        let c = edge;
        if over == RESIZE_PANE + k - 1 { c = lit; }
        fill(paneX(k) - 1, TOP, 2, win.y - TOP - BOTTOM - consoleH(), c);
        k += 1;
    }
}

/// Toolbar and status bar backgrounds. Painted after the panels, since scroll areas
/// only skip rows that are fully outside and would otherwise bleed into the bars.
pub fn drawBars() {
    let win = game.windowSize();
    let bar = rgb(26, 28, 34);
    let edge = rgb(16, 17, 21);
    fill(0, 0, win.x, TOP, bar);
    fill(0, TOP - 1, win.x, 1, edge);
    fill(0, win.y - BOTTOM, win.x, BOTTOM, bar);
    fill(0, win.y - BOTTOM, win.x, 1, edge);
}

/// Scene tabs across the top of the viewport, with + for a new scene.
/// Each pane's tab strip. Pressing a tab and dragging moves it: along a strip to reorder
/// or change panes, or onto a pane's side to split it.
pub @j3ui drawTabs(ui: &Ui, w: &World) {
    let g = shared();
    let keepH = ui.h;
    let pickTab = -1;
    let shutTab = -1;
    let newIn = -1;
    let mouse = game.mousePos();
    if w.tabDragging { w.dropBefore = -2; }
    let p = 0;
    while p < g.panes {
        let x0 = paneX(p);
        let wide = paneW(p);
        fill(x0, TOP, wide, TABS, rgb(26, 28, 34));
        fill(x0, TOP + TABS - 1, wide, 1, rgb(16, 17, 21));
        if p > 0 { fill(x0 - 1, TOP, 2, TABS, rgb(16, 17, 21)); }
        ui.x = x0 + 6;
        ui.y = TOP + 3;
        ui.h = TABS - 6;
        row() {
            let overStrip = w.tabDragging && mouse.y >= TOP && mouse.y < TOP + TABS
                && mouse.x >= x0 && mouse.x < x0 + wide;
            if overStrip {
                w.dropPane = p;
                w.dropBefore = -1;
            }
            let i = 0;
            while i < w.tabCount {
                if w.tabs[i].pane == p {
                    let dirty = w.tabs[i].dirty;
                    if i == w.active { dirty = w.dirty; }
                    let t = Text.new(scratch(0));
                    t.pushStr(stem(w.tabs[i].path));
                    if w.tabs[i].mat as ptr != 0 { t.pushStr(" (material)"); }
                    if dirty { t.pushStr(" *"); }
                    ui.pushId(700 + i);
                    let keep = ui.theme.button;
                    ui.theme.button = rgb(38, 41, 49);
                    if w.tabs[i].front { ui.theme.button = rgb(50, 55, 68); }
                    if i == w.active { ui.theme.button = rgb(58, 66, 86); }
                    let tabX = ui.x;
                    let tabY = ui.y;
                    button(t.str()) { pickTab = i; }
                    let labelEnd = ui.x;
                    if mouseIn(tabX, tabY, labelEnd - tabX, ui.h) && game.mousePressed(game.Mouse.Left) {
                        w.tabPress = i + 1;
                        w.tabFrom = mouse;
                    }
                    // Dropping on the left half of a tab goes before it.
                    if overStrip && w.dropBefore == -1 && mouse.x < (tabX + labelEnd) * 0.5 {
                        w.dropBefore = i;
                        fill(tabX - 4, TOP + 3, 3, TABS - 6, ui.theme.accent);
                    }
                    gap(-6);
                    if w.tabCount > 1 && ui.button("x") { shutTab = i; }
                    if i == w.active { fill(tabX, ui.y + ui.h - 2, ui.x - 6 - tabX, 2, ui.theme.accent); }
                    ui.theme.button = keep;
                    popId();
                    gap(4);
                }
                i += 1;
            }
            if overStrip && w.dropBefore == -1 { fill(ui.x - 2, TOP + 3, 3, TABS - 6, ui.theme.accent); }
            ui.pushId(790 + p);
            button("+") { newIn = p; }
            popId();
        }
        p += 1;
    }
    ui.h = keepH;
    if w.tabDragging { return; }
    if pickTab >= 0 { switchTab(w, pickTab); }
    if shutTab >= 0 { closeTab(w, shutTab, false); }
    if newIn >= 0 {
        let shown = frontTab(w, newIn);
        if shown >= 0 { switchTab(w, shown); }
        run(w, CMD_NEW_SCENE);
    }
}

/// Follow a pressed tab: past `SLOP` it's being dragged, and releasing drops it where
/// `drawTabs` or the pane under the mouse says. True while it holds the mouse.
pub fn dragTab(w: &World, mouse: Vec2): bool {
    if w.tabPress == 0 { return false; }
    if !w.tabDragging && (mouse - w.tabFrom).length() > SLOP { w.tabDragging = true; }
    if game.mouseDown(game.Mouse.Left) { return w.tabDragging; }
    let i = w.tabPress - 1;
    let dragged = w.tabDragging;
    w.tabPress = 0;
    w.tabDragging = false;
    if !dragged || i >= w.tabCount { return false; }
    // The release would also click whatever tab button it's over.
    w.swallow = true;
    if w.dropBefore != -2 {
        dockTab(w, i, w.dropPane, w.dropBefore, 0);
        return true;
    }
    let pane = paneAt(mouse);
    if pane < 0 { return true; }
    let side = dropSide(pane, mouse);
    // A pane's only tab can't split off from itself.
    if side != 0 && w.tabs[i].pane == pane && tabsIn(w, pane) == 1 { side = 0; }
    if side == 0 && w.tabs[i].pane == pane { return true; }
    dockTab(w, i, pane, -1, side);
    return true;
}

/// While a tab is dragged: its name at the mouse and where it would land.
pub fn drawTabGhost(w: &World) {
    if !w.tabDragging || w.tabPress == 0 || w.font.raw == 0 { return; }
    let mouse = game.mousePos();
    let win = game.windowSize();
    let pane = paneAt(mouse);
    if w.dropBefore == -2 && pane >= 0 {
        let side = dropSide(pane, mouse);
        let x = paneX(pane);
        let wide = paneW(pane);
        if side == 1 { wide = wide * 0.5; }
        if side == 2 {
            x += wide * 0.5;
            wide = wide * 0.5;
        }
        fill(x, TOP + TABS, wide, win.y - TOP - TABS - BOTTOM - consoleH(), rgba(90, 130, 210, 60));
    }
    let name = stem(w.tabs[w.tabPress - 1].path);
    let size = game.textSize(w.font, name);
    fill(mouse.x + 12, mouse.y + 8, size.x + 16, size.y + 8, rgb(58, 66, 86));
    game.setColor(rgb(236, 238, 244));
    game.drawText(w.font, Vec2 { x: mouse.x + 20, y: mouse.y + 12 }, name);
}

/// Draw every pane but the focused one, each from its shown tab, then the focused one
/// last so its camera is what picking and the gizmo use next frame.
pub fn drawPanes(w: &World) {
    let g = shared();
    let p = 0;
    while p < g.panes {
        let i = frontTab(w, p);
        if p != g.focus && i >= 0 && !isOnline(w.tabs[i].path) {
            let keep = Tab {
                path: w.path, mat: w.mat, scene: w.scene, cam: w.cam, selected: w.selected,
                undos: w.undos, undoCount: w.undoCount, redos: w.redos, redoCount: w.redoCount,
                dirty: w.dirty, viewCam: w.viewCam, savedCam: w.savedCam, ortho: w.ortho,
                axisView: w.axisView, pane: g.focus, front: true, previewLock: w.previewLock,
            };
            let keepMat = w.matTab;
            let keepPicked = w.pickedCount;
            let t = w.tabs[i];
            w.scene = t.scene;
            w.cam = t.cam;
            w.mat = t.mat;
            w.matTab = t.mat as ptr != 0;
            w.viewCam = t.viewCam;
            w.ortho = t.ortho;
            w.axisView = t.axisView;
            w.selected = 0;
            w.pickedCount = 0;
            w.worldsReady = false;
            g.drawPane = p;
            drawViewport(w);
            g.drawPane = -1;
            w.scene = keep.scene;
            w.cam = keep.cam;
            w.mat = keep.mat;
            w.matTab = keepMat;
            w.viewCam = keep.viewCam;
            w.ortho = keep.ortho;
            w.axisView = keep.axisView;
            w.selected = keep.selected;
            w.pickedCount = keepPicked;
            w.worldsReady = false;
        }
        p += 1;
    }
    // The Get Assets page is UI, drawn over its pane later.
    if !isOnline(w.path) { drawViewport(w); }
}
