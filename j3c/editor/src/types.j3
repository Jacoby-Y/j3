// Shared constants and the structs every module passes around, `World` first among them.

module j3_editor.types;

use j3.game.Font;
use j3.gfx.{ Orbit, Tex };
use j3.math.{ Mat4, Vec2, Vec3 };
use j3.memory.Arena;
use j3.scene3d.{ Scene, Node };
use j3.data.save.Save;
use j3.text.Text;

/// The Get Assets tab's path. It names no file; `util.isOnline` tells it apart.
pub const ONLINE_TAB: string = "Get Assets";

/// Toolbar height.
pub const TOP: f32 = 44;

/// The viewport area splits into up to `MAX_PANES` side-by-side panes, each showing one of
/// its tabs. `PANE_SHARE` is each one's share of the width.
pub const MAX_PANES: int = 4;

/// Pixels either side of a panel edge that grab it.
pub const EDGE: f32 = 4;
/// Nothing being resized, the left edge, the right edge, or the hierarchy/assets split.
pub const RESIZE_NONE: int = 0;
pub const RESIZE_LEFT: int = 1;
pub const RESIZE_RIGHT: int = 2;
pub const RESIZE_SPLIT: int = 3;
/// The console's top edge.
pub const RESIZE_CONSOLE: int = 4;
/// `RESIZE_PANE + k` is the divider right of pane `k`.
pub const RESIZE_PANE: int = 10;
/// Status bar height.
pub const BOTTOM: f32 = 28;
/// Scene tab strip height, above the viewport.
pub const TABS: f32 = 30;
/// Gizmo tools.
pub const MOVE: int = 1;
pub const ROTATE: int = 2;
pub const SCALE: int = 3;
/// Pixels from a gizmo handle that still grab it.
pub const GRAB: f32 = 9;
/// Points per rotate ring.
pub const RING: int = 48;
/// Undo steps kept.
pub const HISTORY: int = 100;
/// Pixels the pointer may wander before a click becomes a drag.
pub const SLOP: f32 = 5;
/// Size of the Snap panel under the toolbar.
pub const SNAP_W: f32 = 200;
pub const SNAP_H: f32 = 152;
pub const AGENT_W: f32 = 290;
pub const AGENT_H: f32 = 132;
/// Width of the fold arrow left of a hierarchy row.
pub const ARROW: f32 = 14;
/// How often unsaved scenes are copied for crash recovery.
pub const AUTOSAVE_MS: int = 60000;
/// Milliseconds between two clicks that still count as a double click.
pub const DOUBLE_MS: int = 400;
/// Context menu metrics.
pub const MENU_W: f32 = 236;
pub const MENU_ROW: f32 = 26;
pub const MENU_SEP: f32 = 9;

/// Commands shared by the context menu, shortcuts, and buttons.
pub const CMD_RENAME: int = 1;
pub const CMD_FOCUS: int = 2;
pub const CMD_DUPLICATE: int = 3;
pub const CMD_COPY: int = 4;
pub const CMD_CUT: int = 5;
pub const CMD_PASTE: int = 6;
pub const CMD_PASTE_CHILD: int = 7;
pub const CMD_DELETE: int = 8;
pub const CMD_ADD_GROUP: int = 9;
pub const CMD_ADD_MESH: int = 10;
pub const CMD_ADD_CAMERA: int = 11;
pub const CMD_UNPARENT: int = 12;
pub const CMD_RESET: int = 13;
pub const CMD_OPEN_SCENE: int = 14;
pub const CMD_INSTANCE: int = 15;
pub const CMD_INSTANCE_CHILD: int = 16;
pub const CMD_NEW_SCENE: int = 17;
pub const CMD_CLOSE_TAB: int = 18;
pub const CMD_VIEW_CAMERA: int = 19;
pub const CMD_MAIN_CAMERA: int = 20;
pub const CMD_ADD_LIGHT: int = 21;
pub const CMD_RENAME_ASSET: int = 22;
pub const CMD_DELETE_ASSET: int = 23;
pub const CMD_PICK_FILE: int = 24;
pub const CMD_EDIT_MATERIAL: int = 25;
pub const CMD_ADD_PLANE: int = 26;
pub const CMD_ADD_SKY: int = 27;
/// Add a mesh showing the built-in shape in the menu item's `file`.
pub const CMD_ADD_SHAPE: int = 28;
/// Rest the picked objects on the surface below them.
pub const CMD_GROUND: int = 29;
pub const CMD_ONTOP: int = 30;
pub const CMD_SCATTER: int = 31;
/// `World.assetAction` values.
pub const ASSET_RENAME: int = 1;
pub const ASSET_DELETE: int = 2;
/// A divider line in the menu, not a command.
pub const CMD_SEP: int = 99;

/// Copy of the editable scene, used for undo, redo, and the clipboard.
pub struct Snap {
    nodes: []Node;
    len: int;
    next: int;
    data: Save;
    /// Selected id when taken.
    selected: int;
    /// Every selected id when taken; `pickedCount` are used.
    picked: []int;
    pickedCount: int = 0;
}

/// One undo or redo step: what turns the scene after it back into the scene before it.
/// Most edits change a few objects, so only those are kept; `order` is kept only when
/// objects were added, removed, or reordered.
pub struct Delta {
    /// Objects as they were before, where they differ or were removed. `count` are used.
    changed: []Node;
    count: int;
    /// Ids of the before scene, in order, when `reorder`. `orderLen` are used.
    order: []int;
    orderLen: int;
    reorder: bool;
    next: int;
    data: Save;
    selected: int;
    picked: []int;
    pickedCount: int = 0;
}

pub struct MenuItem {
    label: string;
    /// Shortcut shown on the right, or "".
    keys: string;
    cmd: int;
    on: bool;
    /// Scene file for open/instance commands, or "".
    file: string;
}

/// One open scene. The active tab's state lives in the `World` fields; `stash` copies it back.
/// A material tab's file and history. Edits stay in `file` until saved; the objects using
/// the material show them at once.
pub struct MatEdit {
    file: Save;
    /// Earlier versions of the file text, for undo; each edit gesture pushes one.
    undos: [][]u8;
    undoCount: int;
    redos: [][]u8;
    redoCount: int;
    /// A drag or typing is under way; its first change already pushed an undo step.
    gesture: bool;
    /// Changes not yet shown on the objects, and when they last were.
    pending: bool;
    shownMs: int;
    /// Preview mesh: `PREVIEW_SPHERE`, `PREVIEW_CUBE`, or `PREVIEW_PLANE`.
    shape: int;
}

pub const PREVIEW_SPHERE: int = 0;
pub const PREVIEW_CUBE: int = 1;
pub const PREVIEW_PLANE: int = 2;
/// Noise re-bakes at most this often while a value is dragged.
pub const MATERIAL_MS: int = 100;

pub struct Tab {
    path: string;
    /// A material tab's state; 0 for scene tabs.
    mat: &MatEdit;
    scene: Scene;
    cam: Orbit;
    selected: int;
    undos: []Delta;
    undoCount: int;
    redos: []Delta;
    redoCount: int;
    dirty: bool;
    /// How the viewport looks at this tab: through a camera object, and axis/ortho views.
    viewCam: int;
    savedCam: Orbit;
    ortho: bool;
    axisView: bool;
    /// Which side-by-side pane shows it, and whether it's that pane's shown tab.
    pane: int;
    front: bool;
    /// Camera whose preview stays up though it isn't selected; 0 for none.
    previewLock: int;
}

pub struct World {
    /// Editor-lifetime memory. Each tab's scene, history and edited strings live in its own
    /// `scene.arena`, freed when the tab closes, so nothing here may point into one.
    mem: &Arena;
    /// Holds the clipboard, so it outlives the tab it was copied from.
    clipMem: &Arena;
    /// Labels of the open context menu.
    menuMem: &Arena;
    scene: Scene;
    worlds: []Mat4;
    worldsReady: bool;
    catalog: Save;
    assets: Save;
    assetPaths: []string;
    assetCount: int;
    /// Folded asset folders ("assets/materials"), in `mem`.
    folds: []string;
    foldCount: int;
    path: string;
    cam: Orbit;
    font: Font;
    selected: int;
    lastMouse: Vec2;
    nameEdit: Text;
    assetEdit: Text;
    textureEdit: Text;
    scriptEdit: Text;
    newScript: Text;
    importPath: Text;
    status: Text;
    /// Bytes of the host's event log already handled.
    eventsRead: int;
    pollTicks: int;
    paramEdits: []Text;
    /// Scene at the start of this frame; pushed to `undos` by the first edit.
    candidate: Snap;
    undos: []Delta;
    undoCount: int;
    redos: []Delta;
    redoCount: int;
    /// Subtree copied with Ctrl+C or Ctrl+X.
    clip: Snap;
    /// Work buffer for undo and redo.
    spare: Snap;
    changedFrame: bool;
    stale: bool;
    /// An edit started since `candidate` was taken; `snapshot` turns it into an undo step.
    pendingUndo: bool;
    /// The selected placed object as last synced to overrides, and its id (0: take it anew).
    placedBefore: []Node;
    placedBeforeId: int;
    /// A mouse drag or a text field edit in progress; it makes one undo step.
    editGesture: bool;
    gizmoMode: int;
    /// Axis being dragged (0 X, 1 Y, 2 Z).
    gizmoAxis: int;
    /// Axis under the cursor, or -1.
    hoverAxis: int;
    /// Screen tangent of a rotate ring at the grab point, in pixels per radian.
    grabTangent: Vec2;
    /// At drag start: the world origin (move), rotation, or scale; then the unsnapped change since.
    grabStart: Vec3;
    dragTotal: f32;
    dragging: bool;
    dirty: bool;
    /// Object under the cursor in the viewport, or 0.
    hoverNode: int;
    /// Asset row pressed, as its index + 1; it becomes a drag once the pointer moves.
    assetPress: int;
    assetFrom: Vec2;
    assetDragging: bool;
    /// Where an asset dragged over the viewport would land: the mesh under the pointer
    /// (or 0) and the point on it or on the ground.
    dropNode: int;
    dropPoint: Vec3;
    /// Right button went down here; a release that did not drag opens the menu.
    rightFrom: Vec2;
    rightArmed: bool;
    menuOpen: bool;
    menuAt: Vec2;
    /// Object the menu acts on, or 0 for the empty-space menu.
    menuTarget: int;
    /// Where "Add" from the empty-space menu puts new objects.
    menuPoint: Vec3;
    menu: []MenuItem;
    menuLen: int;
    /// This frame's left press closed a menu, so widgets ignore it.
    swallow: bool;
    /// Hierarchy rows in draw order, for the arrow keys.
    rows: []int;
    rowCount: int;
    /// Hierarchy row held with the left button, or 0.
    treeDrag: int;
    treeFrom: Vec2;
    /// Row under a hierarchy drag: an id, 0 for the top level, -1 for nowhere.
    dropTarget: int;
    /// Where the drop lands next to `dropTarget`: -1 before it, 0 inside it, 1 after it.
    dropWhere: int;
    /// Hierarchy search text; rows that match and their parents are shown.
    treeFilter: Text;
    /// Camera object the viewport looks through, or 0.
    viewCam: int;
    /// Editor view from before looking through a camera; Esc goes back to it.
    savedCam: Orbit;
    /// Ctrl-drag steps: world units, degrees, and scale. Kept in `target/j3-editor/prefs`.
    snapMove: f32;
    snapAngle: f32;
    snapScale: f32;
    /// Grid line spacing in world units.
    gridStep: f32;
    showSnap: bool;
    prefsDirty: bool;
    /// Left edge of the Snap panel, set when it is drawn.
    snapLeft: f32;
    /// Agent panel (MCP): shown, its left edge, and whether agents may use the editor (prefs).
    showAgent: bool;
    agentLeft: f32;
    agentOff: bool;
    /// Agent requests this session, and `game.ticks()` of the last one.
    agentCount: int;
    agentAt: int;
    /// Every selected object; `selected` is the one the inspector and gizmo show.
    picked: []int;
    pickedCount: int;
    /// Objects a gizmo drag moves (selected ones without a selected parent) and where they started.
    grabIds: []int;
    grabPos: []Vec3;
    grabRot: []Vec3;
    grabScale: []Vec3;
    grabCount: int;
    /// World axis of the handle being dragged, fixed when the drag starts.
    grabAxis: Vec3;
    /// An edge drag's starting middle (world) and full size along the axis.
    edgeFrom: Vec3;
    edgeLength: f32;
    /// Box select: left drag from empty viewport space.
    boxFrom: Vec2;
    boxing: bool;
    /// Move and rotate handles follow the object's own axes instead of the world's.
    localSpace: bool;
    /// Asset dialog up: `ASSET_RENAME`, `ASSET_DELETE`, or 0. `assetPath` is the file.
    assetAction: int;
    assetPath: Text;
    assetTarget: Text;
    assetFocus: bool;
    /// The active tab edits a material (`path`) instead of a scene; `mat` is its state.
    matTab: bool;
    mat: &MatEdit;
    /// The material panel's image path field.
    matTexture: Text;
    /// The open material's effect path field.
    matEffect: Text;
    /// The mesh inspector shows the file path field though the mesh is a built-in shape.
    meshPath: bool;
    /// How far along the pointer's ray the last pick was, and where the last object click was.
    pickDepth: f32;
    /// The active tab's locked camera preview (see `Tab.previewLock`).
    previewLock: int;
    /// Editor frame rate, recounted every half second from `fpsFrom` (ms) and `fpsFrames`.
    fps: int;
    fpsFrom: int;
    fpsFrames: int;
    pickFrom: Vec2;
    throughDepth: f32;
    /// Tab being pressed (index + 1), where, and whether it's being dragged; where it would
    /// drop on a tab strip (`dropBefore` -1 is the strip's end, -2 not over a strip).
    tabPress: int;
    tabFrom: Vec2;
    tabDragging: bool;
    dropPane: int;
    dropBefore: int;
    /// Imports become their own scene file, placed once, instead of objects pasted in.
    importAsScene: bool;
    /// The Get Assets tab: the source (`any|polyhaven|ambientcg|kenney`) and kind
    /// (`any|model|material|sky`) searched, the search words, the host's results
    /// (`target/j3-editor/online`, in `onlineMem`), their thumbnails (loaded a few a frame as
    /// they scroll into view; `onlineTried` marks the ones attempted), and the picked result.
    onlineSource: string;
    onlineKind: string;
    onlineQuery: Text;
    online: Save;
    onlineMem: &Arena;
    onlineThumbs: []Tex;
    onlineTried: []bool;
    onlinePick: int;
    onlineBusy: bool;
    /// Height of the page's header last frame, where its result grid starts.
    onlineHeaderH: f32;
    /// An `asset` or `object` field waiting for a click: field `pickField` of object `pickFor`.
    pickFor: int;
    pickField: Text;
    pickObject: bool;
    /// "Place on top of...": the next viewport click picks what the selection lands on.
    ontopPick: bool = false;
    /// Scatter dialog: open, what to place, how many, how far around the view's center, seed.
    scattering: bool = false;
    scatterWhat: Text;
    scatterCount: f32 = 10;
    scatterSpread: f32 = 4;
    scatterSeed: f32 = 1;
    /// Orthographic viewport, and whether a front/side/top key set it (orbiting then leaves it).
    ortho: bool;
    axisView: bool;
    /// Last clicked object and frame, for double clicks.
    clickId: int;
    clickMs: int;
    renameNow: bool;
    showHelp: bool;
    /// Unsaved-changes prompt is up, for tab `closeTab` or (-1) the whole editor.
    closing: bool;
    closeTab: int;
    /// Open scenes. `tabs[active]` is stale until `stash`.
    tabs: []Tab;
    tabCount: int;
    active: int;
    /// The menu is for the scene file `menuFile` (an asset row), not an object.
    fileMenu: bool;
    /// The menu is the hierarchy's "+ Add" list.
    addMenu: bool;
    menuFile: string;
    /// The new-scene name prompt is up.
    naming: bool;
    nameFocus: bool;
    sceneName: Text;
    /// Holds both catalogs and `assetPaths`; recreated on each host refresh.
    catMem: &Arena;
    /// The game started by Play is still open.
    gameRunning: bool;
    /// Lines of the last failed build, newline separated.
    con: Console;
    /// `game.ticks()` of the last autosave.
    autosaveMs: int;
    /// Which edge is being dragged (`RESIZE_*`).
    resizing: int;
    /// Where the hierarchy starts and how much height it shares with the assets, for the split.
    treeTop: f32;
    treeRoom: f32;
    /// Scene with a crash autosave waiting for Recover or Discard, or "".
    recoverPath: Text;
    /// The color picker's hex field.
    colorHex: Text;
    /// Scene and material files as the editor last read or wrote them; a difference on disk
    /// is someone else's edit (an agent, `j3c -e scene`, a text editor), reloaded or merged.
    watched: []Watched;
    watchCount: int;
    watchTicks: int;
    /// Scene prop fields in the inspector, and what they were filled for (a copy's id or
    /// -1 for the scene's own props, in tab `propTab`, with `propCount` props).
    propEdits: []Text;
    propFor: int;
    propTab: int;
    propCount: int;
    propName: Text;
    /// 1 + the prop being renamed (its new name goes in `propName`), or 0.
    propRenaming: int = 0;
}

/// A file's text as the editor last saw it.
pub struct Watched {
    path: string;
    text: []u8;
    /// `fileStamp` when `text` was read; 0 reads the file again on the next look.
    stamp: int;
}

/// Context for `declared`.
pub struct Prune {
    w: &World;
    scene: &Scene;
}

/// First hover id of the edge handles on a selected plane or quad: `EDGE_HANDLE + axis * 2`
/// is the edge on the negative side of local `axis`, plus one the positive side.
pub const EDGE_HANDLE: int = 10;

/// Handle the complete lines the host appended to its event log since the last poll. Each
/// is `kind<TAB>scene<TAB>message`; imports add their fragment name before the message.
/// Game output, build errors, and Play notes, oldest first. Lines are `bytes[starts[k]..]`
/// up to the next start (or `len`).
pub struct Console {
    bytes: []u8;
    len: int;
    starts: []int;
    /// `CON_INFO`, `CON_WARN`, or `CON_ERROR` for each line.
    kinds: []int;
    count: int;
    /// First line shown, and whether new lines scroll it to the bottom.
    top: int;
    stick: bool;
    onlyProblems: bool;
    /// Warnings and errors so far, and how many of them the console showed open.
    problems: int;
    seen: int;
}

pub const CON_INFO: int = 0;
pub const CON_WARN: int = 1;
pub const CON_ERROR: int = 2;
pub const CON_BYTES: int = 512 * 1024;
pub const CON_LINES: int = 4000;
pub const CON_ROW: f32 = 18;

/// Pixels each folder level is indented in the asset tree.
pub const INDENT: f32 = 14;
