// The asset list: reading it, folding folders, placing and applying assets, renames.

module j3_editor.assets;

use j3.scene3d.editor.overrides;
use j3.game;
use j3.gfx;
use j3.io.printLn;
use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.scene3d.{ Scene, MESH, CAMERA, INSTANCE };
use j3.data.save;
use j3.text.{ Text, same };
use j3_editor.console.say;
use j3_editor.gizmo.cachedWorlds;
use j3_editor.history.{ modified, snapshot };
use j3_editor.layout.overViewport;
use j3_editor.materials.{ matBefore, matChanged };
use j3_editor.nodes.{ addNode, groundHit, viewGround };
use j3_editor.overrides.{ fieldChanged, isPlaced };
use j3_editor.scenes.{ addInstance, openScene, warnMissing };
use j3_editor.selection.{ loadParams, nameOf, select, uniqueName };
use j3_editor.shared.shared;
use j3_editor.tabs.stash;
use j3_editor.types.{ SLOP, World };
use j3_editor.util.{ cut, endsWith, isOnline, keep, own, setText, stem };

/// A click on an asset row: a mesh file goes on the selected mesh (or becomes a new one);
/// a material or image goes on the selected mesh.
pub fn useAsset(w: &World, path: string) {
    if endsWith(path, ".j3fx") {
        useEffect(w, path);
        return;
    }
    let at = scene3d.index(&w.scene, w.selected);
    let onMesh = at >= 0 && w.scene.nodes[at].kind == MESH;
    if endsWith(path, ".j3mesh") {
        if !onMesh {
            placeAsset(w, path, 0, viewGround(w));
            return;
        }
        w.scene.nodes[at].asset = keep(w, path);
        setText(&w.assetEdit, path);
        scene3d.reload(&w.scene, w.selected);
        modified(w);
        say(w, "Mesh assigned");
    } else if onMesh {
        applyAsset(w, w.selected, path);
    } else if endsWith(path, ".j3mat") {
        say(w, "Select a mesh or drag the material onto one; right-click it to edit it");
    } else {
        say(w, "Select a mesh or drag the image onto one");
    }
}

/// A camera effect clicked with a camera selected runs after its others.
fn useEffect(w: &World, path: string) {
    let at = scene3d.index(&w.scene, w.selected);
    if at < 0 || w.scene.nodes[at].kind != CAMERA {
        say(w, "Select a camera to add a camera effect; material effects go on a material (right-click it)");
        return;
    }
    if !scene3d.effectIsCamera(path) {
        say(w, "That is a material effect (kind=material); it goes on a material (right-click one)");
        return;
    }
    let n = &w.scene.nodes[at];
    let t = Text.new(scratch(0));
    t.pushStr(n.effects);
    if t.len() > 0 { t.push(124); }
    t.pushStr(path);
    n.effects = keep(w, t.str());
    modified(w);
    say(w, "Effect added to the camera");
}

pub fn isFolded(w: &World, dir: string): bool {
    let i = 0;
    while i < w.foldCount {
        if same(w.folds[i], dir) { return true; }
        i += 1;
    }
    return false;
}

/// Whether `path` is inside a folded folder.
pub fn foldedUnder(w: &World, path: string): bool {
    let i = 0;
    while i < w.foldCount {
        let f = w.folds[i];
        if path.len > f.len && path[f.len] == 47 && same(cut(path, 0, f.len), f) { return true; }
        i += 1;
    }
    return false;
}

/// Fold (hide the contents of) or unfold asset folder `dir`.
pub fn foldAsset(w: &World, dir: string, fold: bool) {
    if dir.len == 0 { return; }
    let i = 0;
    while i < w.foldCount {
        if same(w.folds[i], dir) {
            if fold { return; }
            w.folds[i] = w.folds[w.foldCount - 1];
            w.foldCount -= 1;
            return;
        }
        i += 1;
    }
    if !fold || w.foldCount >= w.folds.len { return; }
    // ponytail: fold names stay in w.mem; a few bytes a toggle.
    w.folds[w.foldCount] = own(w.mem, dir);
    w.foldCount += 1;
}

/// Finish an asset row press: a click uses the asset, a drag drops it where it ends.
pub fn assetRelease(w: &World) {
    if w.assetPress == 0 { return; }
    if w.assetPress > w.assetCount {
        w.assetPress = 0;
        w.assetDragging = false;
        return;
    }
    let path = w.assetPaths[w.assetPress - 1];
    if !w.assetDragging && (game.mousePos() - w.assetFrom).length() > SLOP { w.assetDragging = true; }
    if game.mouseDown(game.Mouse.Left) { return; }
    let dragged = w.assetDragging;
    w.assetPress = 0;
    w.assetDragging = false;
    w.hoverNode = 0;
    if !dragged || w.matTab || endsWith(path, ".j3fx") {
        assetClick(w, path);
    } else if isOnline(w.path) {
        say(w, "Switch to a scene tab to place assets");
    } else if overViewport(game.mousePos()) {
        if isPaint(path) { applyAsset(w, w.dropNode, path); } else { placeAsset(w, path, 0, w.dropPoint); }
    } else if w.dropTarget > 0 {
        if isPaint(path) { applyAsset(w, w.dropTarget, path); } else { placeAsset(w, path, w.dropTarget, Vec3.xyz(0, 0, 0)); }
    } else if w.dropTarget == 0 && !isPaint(path) {
        placeAsset(w, path, 0, viewGround(w));
    } else {
        say(w, "Drop it on the viewport or on an object in the hierarchy");
    }
}

/// In a material tab, an image becomes the material's image; nothing else applies.
pub fn assetForMaterial(w: &World, path: string) {
    if endsWith(path, ".j3fx") && scene3d.effectIsCamera(path) {
        say(w, "That is a camera effect (kind=camera); select a camera in a scene tab to add it");
        return;
    }
    if endsWith(path, ".j3fx") {
        matBefore(w);
        save.putStr(&w.mat.file, "fx", path);
        setText(&w.matEffect, path);
        matChanged(w);
        say(w, "Effect set on the material");
        return;
    }
    if !isPaint(path) || endsWith(path, ".j3mat") {
        say(w, "Only images go on a material; switch to a scene tab to use this");
        return;
    }
    matBefore(w);
    save.putInt(&w.mat.file, "noise", 0);
    save.putStr(&w.mat.file, "texture", path);
    setText(&w.matTexture, path);
    matChanged(w);
    say(w, "Image set on the material");
}

pub fn assetClick(w: &World, path: string) {
    if w.matTab {
        assetForMaterial(w, path);
        return;
    }
    if w.pickFor != 0 && !w.pickObject {
        scene3d.setLabel(&w.scene, w.pickFor, w.pickField.str(), path);
        fieldChanged(w, w.pickFor, w.pickField.str());
        w.pickFor = 0;
        loadParams(w);
        say(w, "Asset set");
    } else if endsWith(path, ".j3scene") {
        openScene(w, path);
    } else {
        useAsset(w, path);
    }
}

/// Materials and images go onto a mesh; meshes and scenes are placed as new objects.
pub fn isPaint(path: string): bool {
    return !endsWith(path, ".j3mesh") && !endsWith(path, ".j3scene");
}

/// The mesh under the pointer (0 for none), and in `point` where the pointer's ray meets it,
/// or the ground when it misses.
pub fn dropSpot(w: &World, point: &Vec3): int {
    let ray = gfx.mouseRay(w.cam);
    let matrices = cachedWorlds(w);
    let best: f32 = 100000;
    let hitId = 0;
    let i = 0;
    while i < w.scene.len {
        if w.scene.nodes[i].kind == MESH {
            let hit = scene3d.hitWith(&w.scene, matrices, i, ray, best);
            if hit.ok && hit.t < best {
                best = hit.t;
                hitId = w.scene.nodes[i].id;
            }
        }
        i += 1;
    }
    if hitId != 0 { *point = ray.origin + ray.dir * best; }
    else { *point = groundHit(ray.origin, ray.dir, w.cam.target); }
    return hitId;
}

/// Put material or image `path` on mesh `id`. On a placed object it's saved as an override.
pub fn applyAsset(w: &World, id: int, path: string) {
    let at = scene3d.index(&w.scene, id);
    if at < 0 || w.scene.nodes[at].kind != MESH {
        say(w, "Drop materials and images on a mesh");
        return;
    }
    let n = &w.scene.nodes[at];
    let material = endsWith(path, ".j3mat");
    if material { n.material = keep(w, path); } else { n.texture = keep(w, path); }
    if n.owner != 0 {
        if material { overrides.override(&w.scene, id, "material", " s", path); }
        else { overrides.override(&w.scene, id, "texture", " s", path); }
    }
    if id == w.selected && !material { setText(&w.textureEdit, path); }
    scene3d.reload(&w.scene, id);
    modified(w);
    let t = Text.new(scratch(0));
    if material { t.pushStr("Material "); } else { t.pushStr("Image "); }
    t.pushStr("applied to ");
    t.pushStr(nameOf(w, id));
    say(w, t.str());
}

/// Add mesh or scene file `path` as a new object under `parent` (0 for the top level) at `spot`.
pub fn placeAsset(w: &World, path: string, parent: int, spot: Vec3) {
    if parent != 0 && isPlaced(w, parent) {
        say(w, "Objects can't be added inside a placed scene; open that scene instead");
        return;
    }
    if endsWith(path, ".j3scene") {
        addInstance(w, path, parent, spot);
        return;
    }
    addNode(w, MESH, path, parent, spot);
    let at = scene3d.index(&w.scene, w.selected);
    w.scene.nodes[at].name = uniqueName(w, stem(path));
    setText(&w.assetEdit, path);
    setText(&w.nameEdit, w.scene.nodes[at].name);
    let t = Text.new(scratch(0));
    t.pushStr("Added ");
    t.pushStr(w.scene.nodes[at].name);
    say(w, t.str());
}

/// Ask the host for a file picker; the chosen model is imported into this tab.
pub fn pickFile(w: &World) {
    let g = shared();
    if w.matTab {
        say(w, "Switch to a scene tab to import models into it");
        return;
    }
    let t = Text.new(scratch(0));
    t.pushStr("J3EDITOR g.pick ");
    t.pushStr(w.path);
    printLn(t.str());
}

/// Point every open scene at `new` wherever it used `old`: object files and asset fields.
pub fn renameInTabs(w: &World, old: string, new: string) {
    stash(w);
    let i = 0;
    while i < w.tabCount {
        let scene = &w.tabs[i].scene;
        let placed = false;
        let k = 0;
        while k < scene.len {
            let n = &scene.nodes[k];
            if n.owner == 0 {
                let hit = false;
                if same(n.asset, old) { n.asset = own(scene.arena, new); hit = true; }
                if same(n.texture, old) { n.texture = own(scene.arena, new); hit = true; }
                if same(n.material, old) { n.material = own(scene.arena, new); hit = true; }
                if n.kind == INSTANCE && same(n.scene, old) { n.scene = own(scene.arena, new); placed = true; }
                if hit { scene3d.reload(scene, n.id); }
            }
            if n.kind == INSTANCE { placed = true; }
            k += 1;
        }
        renameInData(scene, old, new);
        if placed { scene3d.refresh(scene, w.tabs[i].path); }
        if w.tabs[i].mat as ptr != 0 && same(w.tabs[i].path, old) { w.tabs[i].path = own(scene.arena, new); }
        i += 1;
    }
    w.scene = w.tabs[w.active].scene;
    w.path = w.tabs[w.active].path;
    w.worldsReady = false;
    select(w, w.selected);
    snapshot(w);
}

/// Rewrite `param.* s=<old>` lines (asset fields) to `new`.
pub fn renameInData(scene: &Scene, old: string, new: string) {
    scene3d.flushParams(scene);
    let bytes = scene.data.bytes as string;
    let out = Text.new(scene.arena);
    let hit = false;
    let start = 0;
    while start < bytes.len {
        let end = start;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let line = cut(bytes, start, end);
        let tail = line.len - old.len - 3;
        if tail > 6 && same(cut(line, 0, 6), "param.") && same(cut(line, tail, line.len - old.len), " s=")
            && same(cut(line, line.len - old.len, line.len), old) {
            out.pushStr(cut(line, 0, tail));
            out.pushStr(" s=");
            out.pushStr(new);
            hit = true;
        } else {
            out.pushStr(line);
        }
        out.push(10);
        start = end + 1;
    }
    // A new text makes the field table rebuild from it.
    if hit { scene.data.bytes = out.bytes; }
}

/// Objects in open scenes that used a deleted file load again, and show as missing.
pub fn deletedInTabs(w: &World, path: string) {
    stash(w);
    let i = 0;
    while i < w.tabCount {
        let scene = &w.tabs[i].scene;
        let placed = false;
        let k = 0;
        while k < scene.len {
            let n = scene.nodes[k];
            if n.owner == 0 && (same(n.asset, path) || same(n.texture, path) || same(n.material, path)) {
                scene3d.reload(scene, n.id);
            }
            if n.kind == INSTANCE && same(n.scene, path) { placed = true; }
            k += 1;
        }
        if placed { scene3d.refresh(scene, w.tabs[i].path); }
        i += 1;
    }
    w.scene = w.tabs[w.active].scene;
    w.worldsReady = false;
    warnMissing(w);
}
