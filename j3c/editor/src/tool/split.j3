// tool: split, inline and fmt ops.

module j3_editor.tool;

/// `split <objects...> out=FILE [instance=1] [center=1]`: move top-level objects, with everything
/// under them, into a new scene file `out` (ids from 1, their script params and per-copy values
/// along). `center=1` recentres the file on the objects' middle in x and z; `instance=1` leaves a
/// placed copy of the file where they were, so the world looks the same. Refuses a file that exists.
/// The scene file keeps working as before for a game that loads `out` itself (`scene3d.loadParts`).
fn splitOp(scene: &Scene, path: string, args: []string, out: &Text): Outcome {
    let file = "";
    let instance = false;
    let center = false;
    let picked = scratch(0).alloc::<int>(scene.len + 1);
    let npicked = 0;
    let k = 1;
    while k < args.len {
        let eq = keyEnd(args[k]);
        let key = cut(args[k], 0, eq);
        let value = cut(args[k], eq + 1, args[k].len);
        if eq < args[k].len && same(key, "out") { file = value; }
        else if eq < args[k].len && same(key, "instance") { instance = same(value, "1") || same(value, "true"); }
        else if eq < args[k].len && same(key, "center") { center = same(value, "1") || same(value, "true"); }
        else {
            let ids = resolveMany(scene, args[k], out);
            if ids.len == 0 { return notOk(); }
            let j = 0;
            while j < ids.len && npicked < picked.len { picked[npicked] = ids[j]; npicked += 1; j += 1; }
        }
        k += 1;
    }
    if npicked == 0 { return failed(out, "split needs the objects to move"); }
    if !endsWithText(file, ".j3scene") { return failed(out, "split needs out=<new scene>.j3scene"); }
    if file[0] == 47 || file[0] == 46 { return failed(out, "out must be a project-relative path"); }
    if same(file, path) || fileExists(file) { return failed(out, "that scene file already exists"); }
    let mark = scratch(0).alloc::<int>(scene.len);
    let i = 0;
    while i < scene.len { mark[i] = 0; i += 1; }
    i = 0;
    while i < npicked {
        let at = scene3d.index(scene, picked[i]);
        if at >= 0 && scene.nodes[at].parent != 0 {
            let t = Text.new(scratch(0));
            t.pushStr("split moves top-level objects, since the new file puts them at the world's origin; ");
            t.pushStr(pathOf(scene, picked[i], scratch(0)));
            t.pushStr(" is inside another (set parent=\"\" first)");
            return failed(out, t.str());
        }
        if at >= 0 { mark[at] = 1; }
        i += 1;
    }
    let again = true;
    while again {
        again = false;
        i = 0;
        while i < scene.len {
            if isOwn(scene.nodes[i]) && mark[i] == 0 && scene.nodes[i].parent != 0 {
                let up = scene3d.index(scene, scene.nodes[i].parent);
                if up >= 0 && mark[up] == 1 { mark[i] = 1; again = true; }
            }
            i += 1;
        }
    }
    let mem = Arena.create(256 * 1024 + scene.len * 64);
    let slots = mem.alloc::<int>(scene.len + 1);
    let depths = mem.alloc::<int>(scene.len + 1);
    let count = scene3d.treeOrder(scene, &mem, slots, depths);
    let sumX: f32 = 0;
    let sumZ: f32 = 0;
    let tops = 0;
    i = 0;
    while i < scene.len {
        if mark[i] == 1 && scene.nodes[i].parent == 0 {
            sumX += scene.nodes[i].position.x;
            sumZ += scene.nodes[i].position.z;
            tops += 1;
        }
        i += 1;
    }
    let cx: f32 = 0;
    let cz: f32 = 0;
    if center && tops > 0 { cx = sumX / f32(tops); cz = sumZ / f32(tops); }
    let part = scene3d.read("/nonexistent.j3scene", scene.arena);
    let newOf = mem.alloc::<int>(scene.len + 1);
    let oldIds = mem.alloc::<int>(scene.len + 1);
    let newIds = mem.alloc::<int>(scene.len + 1);
    let moved = 0;
    k = 0;
    while k < count {
        let slot = slots[k];
        k += 1;
        if mark[slot] != 1 { continue; }
        let n = scene.nodes[slot];
        let parentNew = 0;
        if n.parent != 0 { parentNew = newOf[scene3d.index(scene, n.parent)]; }
        let id = scene3d.add(&part, n.kind, n.name, parentNew);
        copyFields(&part, id, n);
        if n.parent == 0 {
            let home = scene3d.index(&part, id);
            part.nodes[home].position = n.position - Vec3.xyz(cx, 0, cz);
        }
        newOf[slot] = id;
        oldIds[moved] = n.id;
        newIds[moved] = id;
        moved += 1;
    }
    paste.copyParamsMany(&part, &scene.data, []int { ptr: oldIds.ptr, len: moved }, []int { ptr: newIds.ptr, len: moved });
    if !scene3d.store(&part, file) {
        mem.destroy();
        return failed(out, "could not write the new scene file (does its folder exist?)");
    }
    i = 0;
    while i < npicked {
        if scene3d.index(scene, picked[i]) >= 0 { scene3d.remove(scene, picked[i]); }
        i += 1;
    }
    let focus = 0;
    if instance {
        focus = scene3d.add(scene, INSTANCE, uniqueIn(scene, stemOf(file)), 0);
        let home2 = scene3d.index(scene, focus);
        scene.nodes[home2].scene = own(scene.arena, file);
        scene.nodes[home2].position = Vec3.xyz(cx, 0, cz);
        out.pushStr("added\t");
        out.pushInt(focus);
        out.push(9);
        out.pushStr(pathOf(scene, focus, scratch(0)));
        out.push(10);
    }
    let msg = Text.new(scratch(0));
    msg.pushStr("moved ");
    msg.pushInt(moved);
    msg.pushStr(" objects into ");
    msg.pushStr(file);
    mem.destroy();
    return done(out, msg.str(), focus);
}

/// `inline <instance>`: replace a placed scene with real copies of its objects, so they can be
/// edited here (the opposite of `split instance=1`). Per-copy values and the placement's tint are
/// kept; scenes the placed scene places stay placed. The instance becomes a group.
fn inlineOp(scene: &Scene, path: string, args: []string, out: &Text): Outcome {
    if args.len < 2 { return failed(out, "inline needs a placed scene (instance object)"); }
    let at = resolve(scene, args[1], out);
    if at < 0 { return notOk(); }
    let id = scene.nodes[at].id;
    if scene.nodes[at].kind != INSTANCE { return failed(out, "inline takes a placed scene (instance object)"); }
    let placed = false;
    let i = 0;
    while i < scene.len {
        if scene.nodes[i].owner == id { placed = true; }
        i += 1;
    }
    if !placed { scene3d.expand(scene, path); }
    if scene.nodes[scene3d.index(scene, id)].missing { return failed(out, "that scene file can't be read, so there is nothing to inline"); }
    // Copy parents before children: a pass makes every object whose parent is the instance or already made.
    let from = scratch(0).alloc::<int>(scene.len);
    let to = scratch(0).alloc::<int>(scene.len);
    let made = scratch(0).alloc::<int>(scene.len);
    let copies = 0;
    let progress = true;
    while progress {
        progress = false;
        i = 0;
        while i < scene.len {
            let n = scene.nodes[i];
            i += 1;
            if n.owner != id || containsByte(n.sourcePath, 47) { continue; }
            let have = false;
            let j = 0;
            while j < copies && !have { if from[j] == n.id { have = true; } j += 1; }
            if have { continue; }
            let parent = id;
            if n.parent != id {
                parent = 0;
                j = 0;
                while j < copies { if from[j] == n.parent { parent = to[j]; } j += 1; }
                if parent == 0 { continue; }
            }
            let fresh = scene3d.add(scene, n.kind, n.name, parent);
            copyFields(scene, fresh, n);
            from[copies] = n.id;
            to[copies] = fresh;
            copies += 1;
            progress = true;
            // `add` may have moved the nodes; start the pass again.
            i = 0;
        }
    }
    paste.copyParamsMany(scene, &scene.placedData, []int { ptr: from.ptr, len: copies }, []int { ptr: to.ptr, len: copies });
    // The placed copies go; the instance becomes the group they hang from.
    let tops = 0;
    i = 0;
    while i < scene.len {
        if scene.nodes[i].owner == id && scene.nodes[i].parent == id { made[tops] = scene.nodes[i].id; tops += 1; }
        i += 1;
    }
    i = 0;
    while i < tops { scene3d.remove(scene, made[i]); i += 1; }
    let home = scene3d.index(scene, id);
    scene.nodes[home].kind = GROUP;
    scene.nodes[home].scene = "";
    scene.nodes[home].tint = Vec3.xyz(1, 1, 1);
    scene3d.clearParams(scene, id);
    let prefix = Text.new(scratch(0));
    prefix.pushStr("over.");
    prefix.pushInt(id);
    prefix.push(46);
    overrides.replaceLines(scene, prefix.str(), true, "");
    let msg = Text.new(scratch(0));
    msg.pushStr("inlined ");
    msg.pushInt(copies);
    msg.pushStr(" objects under ");
    msg.pushStr(pathOf(scene, id, scratch(0)));
    return done(out, msg.str(), id);
}

/// `fmt`: rewrite the file in the one canonical v2 layout (the caller saves it). Refuses a file
/// with a parse error, since saving would drop whatever the reader skipped.
fn fmtOp(scene: &Scene, out: &Text): Outcome {
    if scene.parseError.len > 0 { return failed(out, scene.parseError); }
    return done(out, "formatted", 0);
}
