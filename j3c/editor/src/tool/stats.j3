// tool: draw-cost stats (distinct looks).

module j3_editor.tool;

// ---- stats ----

/// Distinct looks above this cost frame time: a measured fps-shooter biome with 12 to 64
/// was fine, one with 403 ran at half speed.
const LOOKS_WARN: int = 60;

/// Meshes that share one instanced draw: same mesh, material, texture, tint, and sidedness.
// ponytail: headless there are no loaded materials, so glass set by a .j3mat counts as batched.
fn sameLook(a: Node, b: Node): bool {
    return same(a.asset, b.asset) && same(a.material, b.material) && same(a.texture, b.texture)
        && a.doubleSided == b.doubleSided && a.tint.x == b.tint.x && a.tint.y == b.tint.y && a.tint.z == b.tint.z;
}

/// Group the scene's opaque meshes by look: `heads[g]` is group g's first node slot and
/// `members[g]` its size. Cutout and blended meshes each draw alone and go to `unbatched`.
/// Returns the group count.
// ponytail: compares each mesh with every group so far; a hash like scene3d.drawBatches if slow.
fn groupLooks(scene: &Scene, heads: []int, members: []int, unbatched: &int): int {
    let groups = 0;
    *unbatched = 0;
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        i += 1;
        if n.kind != MESH || n.asset.len == 0 || scene3d.isSky(n) { continue; }
        if n.alpha != OPAQUE {
            *unbatched += 1;
            continue;
        }
        let g = 0;
        while g < groups && !sameLook(scene.nodes[heads[g]], n) { g += 1; }
        if g == groups {
            heads[g] = i - 1;
            members[g] = 0;
            groups += 1;
        }
        members[g] += 1;
    }
    return groups;
}

fn looksIssue(looks: int, out: &Text) {
    let t = Text.new(scratch(0));
    t.pushInt(looks);
    t.pushStr(" distinct looks (mesh, material, texture, tint), one draw call each per pass; above ");
    t.pushInt(LOOKS_WARN);
    t.pushStr(" costs frame time. Snap tints to a small palette in the generator or editor (j3c -e scene stats lists the biggest)");
    issue(out, false, 0, t.str());
}

/// `stats`: object and mesh counts, distinct looks, the ten biggest looks, and meshes that
/// never batch.
fn stats(scene: &Scene, out: &Text) {
    let heads = scratch(0).alloc::<int>(scene.len);
    let members = scratch(0).alloc::<int>(scene.len);
    let unbatched = 0;
    let looks = groupLooks(scene, heads, members, &unbatched);
    let meshes = unbatched;
    let g = 0;
    while g < looks {
        meshes += members[g];
        g += 1;
    }
    let t = Text.new(scratch(0));
    t.pushInt(scene.len);
    t.pushStr(" objects (placed scenes included), ");
    t.pushInt(meshes);
    t.pushStr(" meshes, ");
    t.pushInt(looks);
    t.pushStr(" distinct looks (instanced draws per pass), ");
    t.pushInt(unbatched);
    t.pushStr(" cutout or blended meshes drawn one by one");
    line2(out, "ok", t.str());
    // The ten biggest, by picking the largest left each time.
    let shown = 0;
    while shown < 10 && shown < looks {
        let best = -1;
        g = 0;
        while g < looks {
            if members[g] > 0 && (best < 0 || members[g] > members[best]) { best = g; }
            g += 1;
        }
        let n = scene.nodes[heads[best]];
        out.pushStr("look\t");
        out.pushInt(members[best]);
        out.push(9);
        out.pushStr(n.asset);
        out.push(9);
        out.pushStr(n.material);
        out.push(9);
        out.pushStr(n.texture);
        out.push(9);
        pushVec(out, n.tint);
        out.push(9);
        out.pushStr(n.name);
        out.push(10);
        members[best] = 0 - members[best];
        shown += 1;
    }
    if looks > LOOKS_WARN { looksIssue(looks, out); }
}
