// Context menu, console panel, and modal prompts.

module j3_editor.ui_dialogs;

use j3.game;
use j3.game.{ rgb, rgba };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.{ Arena, scratch };
use j3.scene3d;
use j3.text.{ Text, same };
use j3.ui.{ Ui, focusNext };
use j3_editor.commands.{ run, scatterNow };
use j3_editor.console.conLine;
use j3_editor.files.{ quit, recover, saveAll, saveScene };
use j3_editor.layout.{ consoleH, edgeAt };
use j3_editor.menu.{ menuPos, menuSize };
use j3_editor.scenes.{ closeTab, createScene };
use j3_editor.shared.shared;
use j3_editor.tabs.{ dropAutosave, switchTab };
use j3_editor.types.{
    ASSET_RENAME, BOTTOM, CMD_SEP, CON_ERROR, CON_INFO, CON_ROW, CON_WARN, MENU_ROW, MENU_SEP, RESIZE_CONSOLE, World,
};
use j3_editor.util.{ limit, setText, stem };
use j3_editor.widgets.{ caption, dialog, fill, fitRight, toolButton };

pub @j3ui drawMenu(ui: &Ui, w: &World) {
    if !w.menuOpen { return; }
    if w.menuTarget != 0 && scene3d.index(&w.scene, w.menuTarget) < 0 {
        w.menuOpen = false;
        return;
    }
    let pos = menuPos(w);
    let size = menuSize(w);
    let face = rgb(44, 48, 57);
    fill(pos.x + 3, pos.y + 5, size.x, size.y, rgba(0, 0, 0, 90));
    fill(pos.x - 1, pos.y - 1, size.x + 2, size.y + 2, rgb(14, 15, 19));
    fill(pos.x, pos.y, size.x, size.y, face);
    let keep = ui.theme;
    ui.theme.button = face;
    ui.theme.panel = face;
    ui.theme.buttonHot = ui.theme.accent;
    ui.theme.buttonDown = rgb(56, 100, 176);
    ui.x = pos.x + 4;
    ui.y = pos.y + 4;
    ui.w = size.x - 8;
    ui.h = MENU_ROW;
    ui.pushId(90000);
    let chosen = 0;
    let i = 0;
    while i < w.menuLen {
        let it = w.menu[i];
        let rowY = ui.y;
        if it.cmd == CMD_SEP {
            fill(ui.x + 6, rowY + 4, ui.w - 12, 1, rgb(66, 71, 84));
            ui.y = rowY + MENU_SEP;
        } else {
            if it.on {
                button(it.label) {
                    chosen = it.cmd;
                    if it.file.len > 0 { w.menuFile = it.file; }
                }
            } else {
                buttonOff(it.label);
            }
            ui.y = rowY + MENU_ROW;
            if it.keys.len > 0 && w.font.raw != 0 {
                let ks = game.textSize(w.font, it.keys);
                game.setColor(rgb(150, 156, 170));
                game.drawText(w.font, Vec2 { x: ui.x + ui.w - ks.x - 8, y: rowY + 4 }, it.keys);
            }
        }
        i += 1;
    }
    popId();
    ui.theme = keep;
    if chosen != 0 {
        w.menuOpen = false;
        run(w, chosen);
    }
}

/// The console: a header with its buttons, then the lines that fit, scrolled by the wheel
/// and following new output while at the bottom.
pub @j3ui drawConsole(ui: &Ui, w: &World) {
    let g = shared();
    if !g.consoleOpen { return; }
    let c = &w.con;
    c.seen = c.problems;
    let win = game.windowSize();
    let x = g.left;
    let wide = win.x - g.left - g.right;
    let h = consoleH();
    let y = win.y - BOTTOM - h;
    fill(x, y, wide, h, rgb(22, 24, 29));
    let lit = w.resizing == RESIZE_CONSOLE || edgeAt(w, game.mousePos()) == RESIZE_CONSOLE;
    fill(x, y, wide, 2, if lit { rgb(90, 130, 210) } else { rgb(16, 17, 21) });
    let keepH = ui.h;
    ui.x = x + 8;
    ui.y = y + 4;
    ui.h = 22;
    row() {
        caption(ui, "CONSOLE");
        gap(8);
        button("Clear") {
            c.count = 0;
            c.len = 0;
            c.top = 0;
            c.problems = 0;
            c.seen = 0;
        }
        if toolButton(ui, "Problems only", c.onlyProblems) { c.onlyProblems = !c.onlyProblems; }
        button("Hide (Ctrl+J)") { g.consoleOpen = false; }
    }
    ui.h = keepH;
    // The lines to show, oldest first.
    let shown = scratch(0).alloc::<int>(c.count + 1);
    let n = 0;
    let k = 0;
    while k < c.count {
        if !c.onlyProblems || c.kinds[k] != CON_INFO {
            shown[n] = k;
            n += 1;
        }
        k += 1;
    }
    let listY = y + 32;
    let rows = int((y + h - 4 - listY) / CON_ROW);
    if rows < 1 { rows = 1; }
    let most = n - rows;
    if most < 0 { most = 0; }
    let mouse = game.mousePos();
    let over = mouse.x >= x && mouse.x < x + wide && mouse.y >= y && mouse.y < y + h;
    let wheel = game.mouseWheel();
    if over && wheel != 0 {
        c.top -= int(wheel) * 3;
        c.stick = false;
    }
    if c.stick { c.top = most; }
    if c.top > most { c.top = most; }
    if c.top < 0 { c.top = 0; }
    if c.top == most { c.stick = true; }
    if w.font.raw == 0 { return; }
    if n == 0 {
        game.setColor(rgb(120, 126, 140));
        game.drawText(w.font, Vec2 { x: x + 12, y: listY }, "Game output, build errors, and warnings show here when you press Play.");
        return;
    }
    let row = 0;
    while row < rows && c.top + row < n {
        let at = shown[c.top + row];
        let kind = c.kinds[at];
        game.setColor(rgb(206, 210, 220));
        if kind == CON_WARN { game.setColor(rgb(240, 196, 100)); }
        if kind == CON_ERROR { game.setColor(rgb(245, 120, 110)); }
        let line = conLine(c, at);
        if line.len > 0 {
            game.drawText(w.font, Vec2 { x: x + 12, y: listY + f32(row) * CON_ROW }, fitRight(w, line, wide - 30));
        }
        row += 1;
    }
    // A thumb shows where the view is when there is more than fits.
    if n > rows {
        let track = h - 36;
        let thumb = track * f32(rows) / f32(n);
        if thumb < 16 { thumb = 16; }
        let t = f32(c.top) / f32(most);
        fill(x + wide - 8, listY + (track - thumb) * t, 4, thumb, rgb(80, 86, 100));
    }
}

/// Unsaved-changes prompt for closing one tab or the whole editor.
pub @j3ui drawClosePrompt(ui: &Ui, w: &World) {
    if !w.closing { return; }
    let one = w.closeTab >= 0 && w.closeTab < w.tabCount;
    let at = dialog(ui, 470, 132);
    if one {
        let t = Text.new(scratch(0));
        t.pushStr("Save changes to ");
        t.pushStr(stem(w.tabs[w.closeTab].path));
        t.pushStr(" before closing it?");
        labelBold(t.str());
        caption(ui, w.tabs[w.closeTab].path);
    } else {
        labelBold("Save changes before quitting?");
        caption(ui, "Some open scenes have unsaved changes.");
    }
    ui.y = at.y + 132 - 44;
    let saveIt = false;
    let discard = false;
    row() {
        saveIt = toolButton(ui, if one { "Save" } else { "Save all and quit" }, true);
        discard = ui.button(if one { "Don't save" } else { "Quit without saving" });
        button("Cancel") { w.closing = false; }
    }
    if one && (saveIt || discard) {
        let i = w.closeTab;
        let kept = true;
        if saveIt {
            switchTab(w, i);
            kept = saveScene(w);
        }
        w.closing = false;
        if kept { closeTab(w, i, true); }
    }
    if !one && saveIt {
        if saveAll(w) { quit(w); } else { w.closing = false; }
    }
    if !one && discard { quit(w); }
}

/// New-scene name prompt.
pub @j3ui drawNamePrompt(ui: &Ui, w: &World) {
    if !w.naming { return; }
    dialog(ui, 420, 170);
    labelBold("New scene");
    let t = Text.new(scratch(0));
    t.pushStr("Saved as scenes/");
    t.pushStr(w.sceneName.str());
    t.pushStr(".j3scene");
    caption(ui, t.str());
    if w.nameFocus {
        focusNext();
        w.nameFocus = false;
    }
    field("scene_name", &w.sceneName);
    let create = false;
    row() {
        create = toolButton(ui, "Create (Enter)", true);
        button("Cancel") { w.naming = false; }
    }
    if create || game.keyPressed(game.Key.Enter) { createScene(w); }
}

/// Scatter prompt: what to place, how many, and how far around the middle of the view.
pub @j3ui drawScatterPrompt(ui: &Ui, w: &World) {
    if !w.scattering || w.closing || w.naming { return; }
    dialog(ui, 420, 250);
    labelBold("Scatter copies");
    caption(ui, "A shape (cube, sphere, ...), a .j3mesh, or a .j3scene");
    field("scatter_what", &w.scatterWhat);
    if ui.number("Count", &w.scatterCount, 0.2) { w.scatterCount = limit(w.scatterCount, 1, 2000); }
    if ui.number("Spread (m)", &w.scatterSpread, 0.05) { w.scatterSpread = limit(w.scatterSpread, 0.1, 500); }
    ui.number("Seed", &w.scatterSeed, 0.2);
    let go = false;
    row() {
        go = toolButton(ui, "Scatter (Enter)", true);
        button("Cancel") { w.scattering = false; }
    }
    if go || game.keyPressed(game.Key.Enter) { scatterNow(w); }
}

/// A dialog is up; the rest of the window waits.
pub fn modalUp(w: &World): bool {
    let g = shared();
    return w.closing || w.naming || w.scattering || w.recoverPath.len() > 0 || w.assetAction != 0 || g.pick.id != 0;
}

/// Rename-or-move and delete prompts for an asset file.
pub @j3ui drawAssetPrompt(ui: &Ui, w: &World) {
    if w.assetAction == 0 || w.closing || w.naming || w.recoverPath.len() > 0 { return; }
    let at = dialog(ui, 470, 170);
    let go = false;
    let cancel = false;
    if w.assetAction == ASSET_RENAME {
        labelBold("Rename or move");
        caption(ui, w.assetPath.str());
        if w.assetFocus {
            focusNext();
            w.assetFocus = false;
        }
        field("assets/new/path", &w.assetTarget);
    } else {
        labelBold("Delete this file?");
        caption(ui, w.assetPath.str());
        caption(ui, "It moves to target/j3-editor/trash/.");
    }
    ui.y = at.y + 170 - 44;
    row() {
        go = toolButton(ui, if w.assetAction == ASSET_RENAME { "Rename (Enter)" } else { "Delete" }, true);
        cancel = ui.button("Cancel");
    }
    if w.assetAction == ASSET_RENAME && game.keyPressed(game.Key.Enter) { go = true; }
    if cancel || game.keyPressed(game.Key.Escape) {
        w.assetAction = 0;
        return;
    }
    if !go { return; }
    let t = Text.new(scratch(0));
    if w.assetAction == ASSET_RENAME {
        t.pushStr("J3EDITOR RENAME ");
        t.pushStr(w.assetPath.str());
        t.push(9);
        t.pushStr(w.assetTarget.str());
    } else {
        t.pushStr("J3EDITOR DELETE ");
        t.pushStr(w.assetPath.str());
    }
    printLn(t.str());
    w.assetAction = 0;
}

/// Recover or discard a crash copy of the active scene.
pub @j3ui drawRecoverPrompt(ui: &Ui, w: &World) {
    if w.recoverPath.len() == 0 || w.closing || w.naming { return; }
    let at = dialog(ui, 470, 150);
    labelBold("Recover unsaved changes?");
    caption(ui, w.recoverPath.str());
    caption(ui, "An autosave from a session that didn't close.");
    ui.y = at.y + 150 - 44;
    row() {
        // The prompt is for the scene it names; switching tabs first would be surprising.
        if toolButton(ui, "Recover", true) && same(w.recoverPath.str(), w.path) { recover(w); }
        button("Discard") {
            dropAutosave(w.recoverPath.str());
            setText(&w.recoverPath, "");
        }
    }
}
