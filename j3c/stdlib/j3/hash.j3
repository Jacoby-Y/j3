/// Stable content hashes. They never change between runs, builds, or machines: file
/// fingerprints, cache keys, lock files. (`j3.cmp.hash` is a table mixer and may change.) Each has a one-shot
/// function and an incremental hasher; feeding the same bytes in any pieces gives the same hash.
///
///     let h = hash.xxh3_64(bytes);                 // fast, 64 bits
///     let x = hash.Xxh3.new();
///     x.update(part1); x.update(part2);
///     let same = x.finish() == hash.xxh3_64(whole);
///     let d = hash.sha256(bytes);                  // Sha256Sum; d.hex(&t) appends 64 hex digits
///
/// `fnv1a64` is FNV-1a (64-bit), `xxh3_64` is XXH3 64-bit with seed 0 (xxHash 0.8, the same value
/// as `XXH3_64bits`), `sha256` is FIPS 180-4 SHA-256. Any thread: hashers hold no shared state.

module j3.hash;

use j3.text.Text;

/// FNV-1a 64-bit offset basis.
const FNV_OFFSET: u64 = 0xCBF29CE484222325;
/// FNV 64-bit prime.
const FNV_PRIME: u64 = 0x100000001B3;

/// FNV-1a 64-bit of `b`: tiny and byte at a time, fine for short keys; prefer `xxh3_64` for files.
pub fn fnv1a64(b: []u8): u64 {
    let f = Fnv1a64.new();
    f.update(b);
    return f.finish();
}

/// Incremental FNV-1a 64-bit.
pub struct Fnv1a64 {
    h: u64;

    /// A hasher with no input yet.
    fn new(): Fnv1a64 {
        return Fnv1a64 { h: FNV_OFFSET };
    }

    /// Add `b` to the input.
    fn update(this: &Fnv1a64, b: []u8) {
        let h = this.h;
        for i in 0..b.len {
            h = (h ^ u64(b[i])) * FNV_PRIME;
        }
        this.h = h;
    }

    /// The hash of everything given so far (more `update` calls may follow).
    fn finish(this: &Fnv1a64): u64 {
        return this.h;
    }
}

/// Little-endian u64 at `b[i..i + 8]`.
fn le64(b: []u8, i: int): u64 {
    // ponytail: byte loads; one unaligned 8-byte load if xxh3 throughput ever matters
    let v: u64 = 0;
    let k = 7;
    while k >= 0 {
        v = (v << 8) | u64(b[i + k]);
        k -= 1;
    }
    return v;
}

/// Little-endian u32 at `b[i..i + 4]`, widened.
fn le32(b: []u8, i: int): u64 {
    return u64(b[i]) | (u64(b[i + 1]) << 8) | (u64(b[i + 2]) << 16) | (u64(b[i + 3]) << 24);
}

/// A SHA-256 digest.
pub struct Sha256Sum {
    /// The 32 bytes, most significant first as printed.
    b: [32]u8;

    /// Append the 64 lowercase hex digits to `t`.
    fn hex(this: &Sha256Sum, t: &Text) {
        let digits = "0123456789abcdef";
        for i in 0..32 {
            t.push(digits[int(this.b[i] >> 4)]);
            t.push(digits[int(this.b[i] & 15)]);
        }
    }
}
