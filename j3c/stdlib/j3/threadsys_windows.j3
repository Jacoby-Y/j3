/// Windows j3.threadsys. Same pub names as threadsys.j3. `CreateThread`, slim reader/writer
/// locks and condition variables (both are one zeroed pointer-sized word, so a zeroed
/// `j3.thread.Mutex` / `Cond` is a valid unlocked lock). No crash stack: `enter`/`leave` are empty.

module j3.threadsys;

use lib "kernel32" as k32 {
    fn CreateThread(attr: ptr, stack: int, f: fn(ptr): ptr, arg: ptr, flags: u32, id: ptr): int;
    fn WaitForSingleObject(h: int, ms: u32): u32;
    fn CloseHandle(h: int): i32;
    fn GetSystemInfo(info: ptr);
    fn AcquireSRWLockExclusive(l: ptr);
    fn ReleaseSRWLockExclusive(l: ptr);
    fn TryAcquireSRWLockExclusive(l: ptr): u8;
    fn SleepConditionVariableSRW(cv: ptr, l: ptr, ms: u32, flags: u32): i32;
    fn WakeConditionVariable(cv: ptr);
    fn WakeAllConditionVariable(cv: ptr);
}

/// `INFINITE`.
const INFINITE: u32 = 0xFFFFFFFF;

/// Logical cores (`SYSTEM_INFO.dwNumberOfProcessors`, at byte 32 of 48).
pub fn cores(): int {
    let info: [6]int = [0, 0, 0, 0, 0, 0];
    k32.GetSystemInfo(&info[0] as ptr);
    return info[4] % 4294967296;
}

/// Start `f(arg)` on a new thread. Returns the thread handle in `out`; false when it failed.
pub fn create(out: ptr, f: fn(ptr): ptr, arg: ptr): bool {
    let h = k32.CreateThread(0 as ptr, 0, f, arg, 0, 0 as ptr);
    let slot = out as &int;
    *slot = h;
    return h != 0;
}

/// Wait for the thread `h` (what `create` stored in `out`).
pub fn join(h: int) {
    k32.WaitForSingleObject(h, INFINITE);
    k32.CloseHandle(h);
}

/// Nothing to set up on Windows.
pub fn enter(): ptr {
    return 0 as ptr;
}

pub fn leave(token: ptr) {}

pub fn lock(m: ptr) {
    k32.AcquireSRWLockExclusive(m);
}

pub fn unlock(m: ptr) {
    k32.ReleaseSRWLockExclusive(m);
}

/// True when it took the lock.
pub fn tryLock(m: ptr): bool {
    return k32.TryAcquireSRWLockExclusive(m) != 0;
}

/// Release `m`, sleep on `cv` until signalled, take `m` again.
pub fn wait(cv: ptr, m: ptr) {
    k32.SleepConditionVariableSRW(cv, m, INFINITE, 0);
}

pub fn signal(cv: ptr) {
    k32.WakeConditionVariable(cv);
}

pub fn broadcast(cv: ptr) {
    k32.WakeAllConditionVariable(cv);
}
