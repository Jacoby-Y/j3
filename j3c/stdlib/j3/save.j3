/// `key=int`, `key f=`, `key s=`, and `key b=` (hex) text. No serde.

module j3.save;

use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;

/// In-memory `key=int` save blob backed by an arena.
pub struct Save {
    /// Raw file text (`key=value` lines).
    bytes: []u8;
    /// Arena used when rewriting entries.
    arena: &Arena;
}

/// Zero-length byte slice from `arena`.
fn emptyBytes(arena: &Arena): []u8 {
    return arena.alloc::<u8>(0);
}

/// Empty save with no entries.
pub fn empty(arena: &Arena): Save {
    return Save { bytes: emptyBytes(arena), arena: arena };
}

/// Load a save file, or an empty save if the read fails.
pub fn load(path: string, arena: &Arena): Save {
    match io.readFile(path, arena) {
        Result.Ok(b) {
            return Save { bytes: b, arena: arena };
        }
        Result.Err(_) {
            return empty(arena);
        }
    }
}

/// True if `bytes` at offset `i` starts with `key` followed by `=`.
fn keyAt(bytes: []u8, i: int, key: string): bool {
    if i + key.len + 1 > bytes.len {
        return false;
    }
    let k = 0;
    while k < key.len {
        if bytes[i + k] != key[k] {
            return false;
        }
        k += 1;
    }
    return bytes[i + key.len] == 61;
}

/// Parse the integer for `key`, or `fallback` if missing or malformed.
pub fn getInt(s: &Save, key: string, fallback: int): int {
    let i = 0;
    while i < s.bytes.len {
        if keyAt(s.bytes, i, key) {
            i = i + key.len + 1;
            let n = 0;
            let neg = false;
            if i < s.bytes.len && s.bytes[i] == 45 {
                neg = true;
                i += 1;
            }
            let any = false;
            while i < s.bytes.len && s.bytes[i] >= 48 && s.bytes[i] <= 57 {
                n = n * 10 + int(s.bytes[i]) - 48;
                i += 1;
                any = true;
            }
            if !any {
                return fallback;
            }
            if neg {
                return 0 - n;
            }
            return n;
        }
        i += 1;
    }
    return fallback;
}

/// Set or replace `key=v`, dropping any prior line for that key.
pub fn putInt(s: &Save, key: string, v: int) {
    let t = Text.new(s.arena);
    let i = 0;
    while i < s.bytes.len {
        if keyAt(s.bytes, i, key) {
            while i < s.bytes.len && s.bytes[i] != 10 {
                i += 1;
            }
            if i < s.bytes.len {
                i += 1;
            }
        } else {
            while i < s.bytes.len && s.bytes[i] != 10 {
                t.push(s.bytes[i]);
                i += 1;
            }
            if i < s.bytes.len {
                t.push(10);
                i += 1;
            }
        }
    }
    t.pushStr(key);
    t.push(61);
    t.pushInt(v);
    t.push(10);
    s.bytes = t.bytes;
}

/// Parse the float for `key` (`key f=`), or `fallback` if missing.
pub fn getFloat(s: &Save, key: string, fallback: f32): f32 {
    let at = findPrefix(s, key, " f");
    if at < 0 {
        return fallback;
    }
    return parseFloat(s.bytes, at);
}

/// Set or replace `key f=v`.
pub fn putFloat(s: &Save, key: string, v: f32) {
    let value = Text.new(s.arena);
    pushFloat(&value, v);
    putPrefixed(s, key, " f", value.str());
}

/// The string for `key` (`key s=`), or `fallback` if missing.
pub fn getStr(s: &Save, key: string, fallback: string): string {
    let at = findPrefix(s, key, " s");
    if at < 0 {
        return fallback;
    }
    let end = at;
    while end < s.bytes.len && s.bytes[end] != 10 {
        end += 1;
    }
    return []u8 { ptr: &s.bytes[at], len: end - at } as string;
}

/// Set or replace `key s=v`. Newlines in `v` are stored as spaces.
pub fn putStr(s: &Save, key: string, v: string) {
    let value = Text.new(s.arena);
    let i = 0;
    while i < v.len {
        let b = v[i];
        if b == 10 {
            value.push(32);
        } else {
            value.push(b);
        }
        i += 1;
    }
    putPrefixed(s, key, " s", value.str());
}

/// Decode the hex blob for `key` (`key b=`). Empty when missing.
pub fn getBlob(s: &Save, key: string): []u8 {
    let at = findPrefix(s, key, " b");
    if at < 0 {
        return s.arena.alloc::<u8>(0);
    }
    let end = at;
    while end < s.bytes.len && s.bytes[end] != 10 {
        end += 1;
    }
    let hexLen = end - at;
    let n = hexLen / 2;
    let out = s.arena.alloc::<u8>(n);
    let i = 0;
    while i < n {
        let hi = hexVal(s.bytes[at + i * 2]);
        let lo = hexVal(s.bytes[at + i * 2 + 1]);
        out[i] = u8(hi * 16 + lo);
        i += 1;
    }
    return out;
}

/// Set or replace `key b=` with the hex of `data`.
pub fn putBlob(s: &Save, key: string, data: []u8) {
    let value = Text.new(s.arena);
    let hex = "0123456789ABCDEF";
    let i = 0;
    while i < data.len {
        let b = int(data[i]);
        value.push(hex[b / 16]);
        value.push(hex[b - (b / 16) * 16]);
        i += 1;
    }
    putPrefixed(s, key, " b", value.str());
}

/// Index just after `key + suffix + "="`, or `-1`.
fn findPrefix(s: &Save, key: string, suffix: string): int {
    let prefix = Text.new(s.arena);
    prefix.pushStr(key);
    prefix.pushStr(suffix);
    let p = prefix.str();
    let i = 0;
    while i < s.bytes.len {
        if keyAt(s.bytes, i, p) {
            return i + p.len + 1;
        }
        i += 1;
    }
    return 0 - 1;
}

/// Replace the line whose prefix is `key + suffix`, then append `value`.
fn putPrefixed(s: &Save, key: string, suffix: string, value: string) {
    let prefix = Text.new(s.arena);
    prefix.pushStr(key);
    prefix.pushStr(suffix);
    let p = prefix.str();
    let t = Text.new(s.arena);
    let i = 0;
    while i < s.bytes.len {
        if keyAt(s.bytes, i, p) {
            while i < s.bytes.len && s.bytes[i] != 10 {
                i += 1;
            }
            if i < s.bytes.len {
                i += 1;
            }
        } else {
            while i < s.bytes.len && s.bytes[i] != 10 {
                t.push(s.bytes[i]);
                i += 1;
            }
            if i < s.bytes.len {
                t.push(10);
                i += 1;
            }
        }
    }
    t.pushStr(p);
    t.push(61);
    t.pushStr(value);
    t.push(10);
    s.bytes = t.bytes;
}

/// `v` as `whole.frac` with four decimal digits.
fn pushFloat(t: &Text, v: f32) {
    let n = v;
    if n < 0 {
        t.push(45);
        n = f32(0) - n;
    }
    let whole = int(n);
    t.pushInt(whole);
    t.push(46);
    let frac = n - f32(whole);
    let digits = "0123456789";
    let i = 0;
    while i < 4 {
        frac = frac * 10;
        let d = int(frac);
        if d < 0 {
            d = 0;
        }
        if d > 9 {
            d = 9;
        }
        t.push(digits[d]);
        frac = frac - f32(d);
        i += 1;
    }
}

/// Parse a float at `i`. Stops at the first non-number byte.
fn parseFloat(bytes: []u8, i: int): f32 {
    let at = i;
    let neg = false;
    if at < bytes.len && bytes[at] == 45 {
        neg = true;
        at += 1;
    }
    let whole = 0;
    while at < bytes.len && bytes[at] >= 48 && bytes[at] <= 57 {
        whole = whole * 10 + int(bytes[at]) - 48;
        at += 1;
    }
    let frac: f32 = 0;
    let place: f32 = 1;
    if at < bytes.len && bytes[at] == 46 {
        at += 1;
        while at < bytes.len && bytes[at] >= 48 && bytes[at] <= 57 {
            place = place * 10;
            frac = frac + f32(int(bytes[at]) - 48) / place;
            at += 1;
        }
    }
    let n = f32(whole) + frac;
    if neg {
        return f32(0) - n;
    }
    return n;
}

/// Hex digit value, or 0.
fn hexVal(b: u8): int {
    if b >= 48 && b <= 57 {
        return int(b) - 48;
    }
    if b >= 65 && b <= 70 {
        return int(b) - 55;
    }
    if b >= 97 && b <= 102 {
        return int(b) - 87;
    }
    return 0;
}

/// Write the save bytes to `path`; write errors are ignored.
pub fn store(s: &Save, path: string) {
    match io.writeFile(path, s.bytes) {
        Result.Ok(_) {}
        Result.Err(_) {}
    }
}
