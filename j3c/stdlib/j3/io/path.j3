/// Path strings. `join`, `normalize`, `dirname`, `basename`, `ext`, `isAbs` and `glob` only look at
/// the bytes (`/` separated, Linux); `realpath` asks the OS.
///
///     use j3.io.path;
///     path.join("src", "main.j3", &arena)          // "src/main.j3"
///     path.normalize("./a//b/../c/", &arena)       // "a/c"
///     path.dirname("a/b.j3")                      // "a"
///     path.ext("a/b.tar.gz")                      // ".gz"

module j3.io.path;

use j3.memory.Arena;
use j3.option.Option;
use j3.sys;
use j3.text.{ cstr, Text };

/// `p` starts with `/`.
pub fn isAbs(p: string): bool {
    return p.len > 0 && p[0] == 47;
}

/// `a` then `b` with one `/` between. `b` when it is absolute or `a` is empty; `a` when `b` is empty.
/// Not normalized (`join("a/", "../b")` is `"a/../b"`); pass the result to `normalize` for that.
pub fn join(a: string, b: string, arena: &Arena): string {
    if a.len == 0 || isAbs(b) {
        return b;
    }
    if b.len == 0 {
        return a;
    }
    let t = Text.new(arena);
    t.pushStr(a);
    if a[a.len - 1] != 47 {
        t.push(47);
    }
    t.pushStr(b);
    return t.str();
}

/// `p` without `.` parts, repeated or trailing `/`, and with each `name/..` pair removed, by the
/// text alone (a symlink before `..` is not followed: `realpath` does that). A `..` that climbs
/// above the start stays in a relative path (`"../a"`) and is dropped at the root (`"/.."` is `"/"`).
/// `""` and `"a/.."` give `"."`.
pub fn normalize(p: string, arena: &Arena): string {
    let abs = isAbs(p);
    let out = Text.new(arena);
    if abs {
        out.push(47);
    }
    let base = out.len();
    let kept = 0;
    let i = 0;
    while i < p.len {
        while i < p.len && p[i] == 47 {
            i += 1;
        }
        let s = i;
        while i < p.len && p[i] != 47 {
            i += 1;
        }
        let part = p[s..i];
        if part.len == 0 || (part.len == 1 && part[0] == 46) {
            continue;
        }
        if part.len == 2 && part[0] == 46 && part[1] == 46 {
            if kept > 0 {
                // drop the last kept name and the `/` before it
                let at = out.len();
                while at > base && out.bytes[at - 1] != 47 {
                    at -= 1;
                }
                if at > base {
                    at -= 1;
                }
                out.bytes = []u8 { ptr: out.bytes.ptr, len: at };
                kept -= 1;
                continue;
            }
            if abs {
                continue;
            }
        } else {
            kept += 1;
        }
        if out.len() > base {
            out.push(47);
        }
        out.pushStr(part);
    }
    if out.len() == 0 {
        return ".";
    }
    return out.str();
}

/// `p` without trailing `/` (but `"/"` stays).
fn trimEnd(p: string): string {
    let e = p.len;
    while e > 1 && p[e - 1] == 47 {
        e -= 1;
    }
    return p[0..e];
}

/// Everything before the last name: `"a/b"` gives `"a"`, `"a"` gives `"."`, `"/a"` and `"/"` give
/// `"/"`, `"a/b/"` gives `"a"`. A view into `p`.
pub fn dirname(p: string): string {
    let q = trimEnd(p);
    let i = q.len;
    while i > 0 && q[i - 1] != 47 {
        i -= 1;
    }
    if i == 0 {
        return ".";
    }
    // drop the separators before the name; only separators left means the root
    let e = i - 1;
    while e > 0 && q[e - 1] == 47 {
        e -= 1;
    }
    if e == 0 {
        return "/";
    }
    return q[0..e];
}

/// The last name: `"a/b.j3"` gives `"b.j3"`, `"a/b/"` gives `"b"`, `"/"` gives `"/"`, `""` gives `""`.
/// A view into `p`.
pub fn basename(p: string): string {
    let q = trimEnd(p);
    if q.len == 1 && q[0] == 47 {
        return q;
    }
    let i = q.len;
    while i > 0 && q[i - 1] != 47 {
        i -= 1;
    }
    return q[i..q.len];
}

/// The extension of `basename(p)` with its dot: `"a/b.tar.gz"` gives `".gz"`; `""` when there is
/// none, for a leading-dot name (`".bashrc"`) and for `"."`/`".."`.
pub fn ext(p: string): string {
    let b = basename(p);
    let i = b.len;
    while i > 1 {
        i -= 1;
        if b[i] == 46 {
            if b.len == 2 && b[0] == 46 {
                return "";
            }
            return b[i..b.len];
        }
    }
    return "";
}

/// `text` matches `pattern`, where `*` is any run of bytes (including `/`) and `?` any one byte.
/// Linear backtracking, no recursion.
pub fn glob(pattern: string, text: string): bool {
    let p = 0;
    let t = 0;
    let star = -1;
    let mark = 0;
    while t < text.len {
        if p < pattern.len && (pattern[p] == 63 || pattern[p] == text[t]) {
            p += 1;
            t += 1;
        } else if p < pattern.len && pattern[p] == 42 {
            star = p;
            mark = t;
            p += 1;
        } else if star >= 0 {
            p = star + 1;
            mark += 1;
            t = mark;
        } else {
            return false;
        }
    }
    while p < pattern.len && pattern[p] == 42 {
        p += 1;
    }
    return p == pattern.len;
}

/// `realpath` scratch: Linux `PATH_MAX`.
#[singleton]
#[thread]
let REAL_BUF: [4096]u8;

/// The absolute path of the existing file or directory `p`, with every symlink, `.` and `..`
/// resolved, copied to `arena`. `None` when `p` does not exist or cannot be opened; `sys.errno()` then
/// says why. Linux and Windows (`GetFullPathNameA`: `.` and `..` folded against the working directory, links not
/// resolved); `None` on other targets.
pub fn realpath(p: string, arena: &Arena): Option<string> {
    let n = sys.realpathTo(cstr(p) as ptr, REAL_BUF[:]);
    if n < 0 {
        return Option.None;
    }
    let out = arena.alloc::<u8>(n);
    for i in 0..n {
        out[i] = REAL_BUF[i];
    }
    return Option.Some(out as string);
}

/// The full path of the running executable, copied to `arena` (`sys.exePathTo`, retried with a bigger buffer for a
/// long path). Linux: `/proc/self/exe` resolved like `realpath`, so None once the file was deleted or replaced;
/// Windows: `GetModuleFileNameW` as UTF-8; macOS: `_NSGetExecutablePath`. None when it cannot be read.
pub fn exePath(arena: &Arena): Option<string> {
    let cap = 4096;
    while true {
        let buf = arena.alloc::<u8>(cap);
        let n = sys.exePathTo(buf);
        if n == -36 && cap < 1 << 20 {
            cap = cap * 4;
            continue;
        }
        if n <= 0 {
            return Option.None;
        }
        let p = buf[0..n] as string;
        if sys.PLATFORM == sys.PLATFORM_LINUX {
            return realpath(p, arena);
        }
        return Option.Some(p);
    }
    return Option.None;
}
