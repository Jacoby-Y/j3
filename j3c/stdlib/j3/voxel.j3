/// Solid grid. `0` is air. Face numbers match `gfx.FACE_*`.
/// Outside XZ and below Y is empty for `get` / `ray`. `overlaps` treats that shell as solid.

module j3.voxel;

use j3.math.{ Vec3, floor };

/// Negative-X face index (matches `gfx.FACE_*`).
pub const FACE_NX: int = 0;
/// Positive-X face index.
pub const FACE_PX: int = 1;
/// Negative-Y face index.
pub const FACE_NY: int = 2;
/// Positive-Y face index.
pub const FACE_PY: int = 3;
/// Negative-Z face index.
pub const FACE_NZ: int = 4;
/// Positive-Z face index.
pub const FACE_PZ: int = 5;

/// Result of a voxel raycast: hit cell, previous cell, and entry face.
pub struct Hit {
    /// True when the ray struck a solid cell within reach.
    ok: bool = false;
    /// Grid X of the hit solid cell.
    x: int = 0;
    /// Grid Y of the hit solid cell.
    y: int = 0;
    /// Grid Z of the hit solid cell.
    z: int = 0;
    /// Grid X of the cell stepped from before the hit.
    px: int = 0;
    /// Grid Y of the cell stepped from before the hit.
    py: int = 0;
    /// Grid Z of the cell stepped from before the hit.
    pz: int = 0;
    /// Face of the hit cell that was entered (`FACE_*`).
    face: int = 0;
}

/// Flat index for column-major storage: `x + sx * (z + sz * y)`.
pub fn index(x: int, y: int, z: int, sx: int, sz: int): int {
    return x + sx * (z + sz * y);
}

/// True when `(x,y,z)` lies inside the `[0,sx) × [0,sy) × [0,sz)` box.
pub fn inside(x: int, y: int, z: int, sx: int, sy: int, sz: int): bool {
    if x < 0 || y < 0 || z < 0 {
        return false;
    }
    if x >= sx || y >= sy || z >= sz {
        return false;
    }
    return true;
}

/// Cell id at `(x,y,z)`, or `0` (air) when outside the grid.
pub fn get(cells: []u8, sx: int, sy: int, sz: int, x: int, y: int, z: int): u8 {
    if !inside(x, y, z, sx, sy, sz) {
        return 0;
    }
    return cells[index(x, y, z, sx, sz)];
}

/// Writes `id` at `(x,y,z)` when inside; no-op outside.
pub fn set(cells: []u8, sx: int, sy: int, sz: int, x: int, y: int, z: int, id: u8) {
    if !inside(x, y, z, sx, sy, sz) {
        return;
    }
    cells[index(x, y, z, sx, sz)] = id;
}

/// Counts exposed solid faces (neighbor air or out of bounds via `get`).
pub fn countFaces(cells: []u8, sx: int, sy: int, sz: int): int {
    let n = 0;
    let y = 0;
    while y < sy {
        let z = 0;
        while z < sz {
            let x = 0;
            while x < sx {
                if get(cells, sx, sy, sz, x, y, z) != 0 {
                    if get(cells, sx, sy, sz, x - 1, y, z) == 0 {
                        n += 1;
                    }
                    if get(cells, sx, sy, sz, x + 1, y, z) == 0 {
                        n += 1;
                    }
                    if get(cells, sx, sy, sz, x, y - 1, z) == 0 {
                        n += 1;
                    }
                    if get(cells, sx, sy, sz, x, y + 1, z) == 0 {
                        n += 1;
                    }
                    if get(cells, sx, sy, sz, x, y, z - 1) == 0 {
                        n += 1;
                    }
                    if get(cells, sx, sy, sz, x, y, z + 1) == 0 {
                        n += 1;
                    }
                }
                x += 1;
            }
            z += 1;
        }
        y += 1;
    }
    return n;
}

/// True if AABB `[lo,hi)` overlaps any solid cell; outside XZ/below Y counts as solid.
pub fn overlaps(cells: []u8, sx: int, sy: int, sz: int, lo: Vec3, hi: Vec3): bool {
    let x0 = int(floor(lo.x));
    let y0 = int(floor(lo.y));
    let z0 = int(floor(lo.z));
    let x1 = int(floor(hi.x - 0.0001));
    let y1 = int(floor(hi.y - 0.0001));
    let z1 = int(floor(hi.z - 0.0001));
    let x = x0;
    while x <= x1 {
        let y = y0;
        while y <= y1 {
            let z = z0;
            while z <= z1 {
                if x < 0 || z < 0 || y < 0 || x >= sx || z >= sz {
                    return true;
                }
                if y < sy && get(cells, sx, sy, sz, x, y, z) != 0 {
                    return true;
                }
                z += 1;
            }
            y += 1;
        }
        x += 1;
    }
    return false;
}

/// Empty miss hit with `ok` false.
fn miss(): Hit {
    return Hit { ok: false, x: 0, y: 0, z: 0, px: 0, py: 0, pz: 0, face: 0 };
}

/// Floors a world coordinate to a grid cell index.
fn cellOf(v: f32): int {
    return int(floor(v));
}

/// DDA raycast through the grid; returns first solid within `reach` or a miss.
pub fn ray(cells: []u8, sx: int, sy: int, sz: int, origin: Vec3, dir: Vec3, reach: f32): Hit {
    let len = dir.length();
    if len < 0.0001 || reach <= 0 {
        return miss();
    }
    let d = dir * (f32(1) / len);
    let x = cellOf(origin.x);
    let y = cellOf(origin.y);
    let z = cellOf(origin.z);
    let stepX = 1;
    let stepY = 1;
    let stepZ = 1;
    let tMaxX = reach + 1;
    let tMaxY = reach + 1;
    let tMaxZ = reach + 1;
    let tDeltaX = reach + 1;
    let tDeltaY = reach + 1;
    let tDeltaZ = reach + 1;
    if d.x < 0 {
        stepX = 0 - 1;
        tDeltaX = f32(1) / (f32(0) - d.x);
        tMaxX = (origin.x - f32(x)) * tDeltaX;
    } else if d.x > 0 {
        tDeltaX = f32(1) / d.x;
        tMaxX = (f32(x + 1) - origin.x) * tDeltaX;
    }
    if d.y < 0 {
        stepY = 0 - 1;
        tDeltaY = f32(1) / (f32(0) - d.y);
        tMaxY = (origin.y - f32(y)) * tDeltaY;
    } else if d.y > 0 {
        tDeltaY = f32(1) / d.y;
        tMaxY = (f32(y + 1) - origin.y) * tDeltaY;
    }
    if d.z < 0 {
        stepZ = 0 - 1;
        tDeltaZ = f32(1) / (f32(0) - d.z);
        tMaxZ = (origin.z - f32(z)) * tDeltaZ;
    } else if d.z > 0 {
        tDeltaZ = f32(1) / d.z;
        tMaxZ = (f32(z + 1) - origin.z) * tDeltaZ;
    }
    let px = x;
    let py = y;
    let pz = z;
    let face = FACE_NX;
    let n = 0;
    while n < 96 {
        if inside(x, y, z, sx, sy, sz) && get(cells, sx, sy, sz, x, y, z) != 0 {
            return Hit { ok: true, x: x, y: y, z: z, px: px, py: py, pz: pz, face: face };
        }
        let advance = tMaxX;
        let axis = 0;
        if tMaxY < advance {
            advance = tMaxY;
            axis = 1;
        }
        if tMaxZ < advance {
            advance = tMaxZ;
            axis = 2;
        }
        if advance > reach {
            return miss();
        }
        px = x;
        py = y;
        pz = z;
        if axis == 0 {
            x += stepX;
            tMaxX += tDeltaX;
            if stepX > 0 {
                face = FACE_NX;
            } else {
                face = FACE_PX;
            }
        } else if axis == 1 {
            y += stepY;
            tMaxY += tDeltaY;
            if stepY > 0 {
                face = FACE_NY;
            } else {
                face = FACE_PY;
            }
        } else {
            z += stepZ;
            tMaxZ += tDeltaZ;
            if stepZ > 0 {
                face = FACE_NZ;
            } else {
                face = FACE_PZ;
            }
        }
        n += 1;
    }
    return miss();
}

// Corner occlusion. `a b c d` are (u,v) corners (0,0), (1,0), (1,1), (0,1).
// 3 is open, 0 is crowded. Both side neighbors solid forces 0.
/// Ambient-occlusion levels for the four corners of a voxel face.
pub struct Corners {
    /// Occlusion at UV (0,0); 3 open through 0 crowded.
    a: int;
    /// Occlusion at UV (1,0).
    b: int;
    /// Occlusion at UV (1,1).
    c: int;
    /// Occlusion at UV (0,1).
    d: int;
}

/// True when the cell at `(x,y,z)` is non-air (outside counts as air via `get`).
fn filled(cells: []u8, sx: int, sy: int, sz: int, x: int, y: int, z: int): bool {
    return get(cells, sx, sy, sz, x, y, z) != 0;
}

/// AO level from two side neighbors and the diagonal; both sides solid → 0.
fn occlude(side1: bool, side2: bool, corner: bool): int {
    if side1 && side2 {
        return 0;
    }
    let n = 3;
    if side1 {
        n = n - 1;
    }
    if side2 {
        n = n - 1;
    }
    if corner {
        n = n - 1;
    }
    return n;
}

/// Maps a boolean axis direction to `+1` or `-1`.
fn axisSign(pos: bool): int {
    if pos {
        return 1;
    }
    return 0 - 1;
}

/// Occlusion at one face corner from side and diagonal neighbors in UV space.
fn cornerLevel(
    cells: []u8,
    sx: int,
    sy: int,
    sz: int,
    bx: int,
    by: int,
    bz: int,
    nx: int,
    ny: int,
    nz: int,
    sgnU: int,
    sgnV: int,
    ux: int,
    uy: int,
    uz: int,
    vx: int,
    vy: int,
    vz: int,
): int {
    let ax = bx + nx;
    let ay = by + ny;
    let az = bz + nz;
    let u1 = ax + sgnU * ux;
    let u2 = ay + sgnU * uy;
    let u3 = az + sgnU * uz;
    let v1 = ax + sgnV * vx;
    let v2 = ay + sgnV * vy;
    let v3 = az + sgnV * vz;
    let c1 = u1 + sgnV * vx;
    let c2 = u2 + sgnV * vy;
    let c3 = u3 + sgnV * vz;
    return occlude(
        filled(cells, sx, sy, sz, u1, u2, u3),
        filled(cells, sx, sy, sz, v1, v2, v3),
        filled(cells, sx, sy, sz, c1, c2, c3),
    );
}

/// Corner AO levels for face `face` of the solid cell at `(x,y,z)`.
pub fn corners(cells: []u8, sx: int, sy: int, sz: int, x: int, y: int, z: int, face: int): Corners {
    let ux = 0;
    let uy = 0;
    let uz = 0;
    let vx = 0;
    let vy = 0;
    let vz = 0;
    let nx = 0;
    let ny = 0;
    let nz = 0;
    if face == FACE_PY {
        ny = 1;
        ux = 1;
        vz = 1;
    } else if face == FACE_NY {
        ny = 0 - 1;
        ux = 1;
        vz = 1;
    } else if face == FACE_PX {
        nx = 1;
        uz = 1;
        vy = 1;
    } else if face == FACE_NX {
        nx = 0 - 1;
        uz = 1;
        vy = 1;
    } else if face == FACE_PZ {
        nz = 1;
        ux = 1;
        vy = 1;
    } else {
        nz = 0 - 1;
        ux = 1;
        vy = 1;
    }
    return Corners {
        a: cornerLevel(cells, sx, sy, sz, x, y, z, nx, ny, nz, axisSign(false), axisSign(false), ux, uy, uz, vx, vy, vz),
        b: cornerLevel(cells, sx, sy, sz, x, y, z, nx, ny, nz, axisSign(true), axisSign(false), ux, uy, uz, vx, vy, vz),
        c: cornerLevel(cells, sx, sy, sz, x, y, z, nx, ny, nz, axisSign(true), axisSign(true), ux, uy, uz, vx, vy, vz),
        d: cornerLevel(cells, sx, sy, sz, x, y, z, nx, ny, nz, axisSign(false), axisSign(true), ux, uy, uz, vx, vy, vz),
    };
}

/// Multiplier for vertex brightness from an AO level (0→0.70 … 3→1).
pub fn shade(level: int): f32 {
    if level <= 0 {
        return 0.70;
    }
    if level == 1 {
        return 0.82;
    }
    if level == 2 {
        return 0.92;
    }
    return 1;
}
