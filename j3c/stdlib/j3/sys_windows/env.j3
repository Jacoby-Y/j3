// Part of j3.sys for Windows (environment variables, setenv, dlopen/dlsym, exeDir); the module doc and `use lib`s are in ../sys_windows.j3.
module j3.sys;

/// NUL-terminated copy of a short name (`dlopen`, `dlsym`), per thread.
fn cstrTmp(s: string): cstr {
    if s.len + 1 > 256 {
        panic("dlopen: name too long");
    }
    for i in 0..s.len {
        DL_NAME[i] = s[i];
    }
    DL_NAME[s.len] = 0;
    return &DL_NAME[0] as cstr;
}

#[singleton]
#[thread]
let DL_NAME: [256]u8;

/// No `envp` on Windows: 0.
pub fn environ(): ptr { return 0; }

/// One cached variable: its name and value, both in process-lifetime memory.
struct EnvRow {
    name: string;
    value: string;
}

#[singleton]
#[thread]
let ENV_P: ptr;
#[singleton]
#[thread]
let ENV_CAP: int = 0;
#[singleton]
#[thread]
let ENV_N: int = 0;

/// Environment variable `name`, or "" when unset (`GetEnvironmentVariableA`, asked twice so any length fits). The
/// value is copied once into memory that is never freed, so the string stays valid for the whole process like on
/// Linux. Each thread keeps its own cache, which grows without limit (page-backed). A value changed after the first
/// read is not seen again.
pub fn env(name: string): string {
    let rows: []EnvRow = @slice(ENV_P, ENV_CAP);
    for i in 0..ENV_N {
        if rows[i].name.len == name.len {
            let same = true;
            for k in 0..name.len {
                if rows[i].name[k] != name[k] {
                    same = false;
                    break;
                }
            }
            if same {
                return rows[i].value;
            }
        }
    }
    let need = int(k32.GetEnvironmentVariableA(cstrTmp(name), 0 as ptr, u32(0)));
    if need <= 1 {
        return "";
    }
    let block = mmapAnon(name.len + need);
    if block as int == 0 {
        return "";
    }
    let got = int(k32.GetEnvironmentVariableA(cstrTmp(name), (block as int + name.len) as ptr, u32(need)));
    if got <= 0 || got >= need {
        return "";
    }
    let nb: []u8 = @slice(block, name.len);
    for k in 0..name.len {
        nb[k] = name[k];
    }
    let vb: []u8 = @slice((block as int + name.len) as ptr, got);
    let row = EnvRow { name: nb as string, value: vb as string };
    if ENV_N >= ENV_CAP {
        let cap = ENV_CAP * 2 + 16;
        let fresh = mmapAnon(cap * @sizeof(EnvRow));
        if fresh as int != 0 {
            let moved: []EnvRow = @slice(fresh, cap);
            for i in 0..ENV_N {
                moved[i] = rows[i];
            }
            ENV_P = fresh;
            ENV_CAP = cap;
            rows = moved;
        }
    }
    if ENV_N < ENV_CAP {
        rows[ENV_N] = row;
        ENV_N += 1;
    }
    return row.value;
}

/// Set environment variable `name` to `value`, replacing it, for this process (`SetEnvironmentVariableA`): `env`
/// on this thread, programs started afterwards and DLLs loaded afterwards see the new value. Another thread that
/// read `name` before keeps its cached value, and C `getenv` in a runtime that already copied the environment
/// does not see it (`_putenv_s` would, but linking msvcrt here breaks mingw's link order). False when `name` is
/// empty or has `=` or a NUL, `value` has a NUL, or the call fails. Call it at startup: not safe against another thread reading the environment meanwhile.
pub fn setenv(name: string, value: string): bool {
    let n = name.len + value.len + 2;
    let block = envPair(name, value);
    if block as int == 0 {
        return false;
    }
    let ok = k32.SetEnvironmentVariableA(block, (block as int + name.len + 1) as ptr) != 0;
    munmap(block, n);
    // forget this thread's cached copy so `env` asks the OS again
    let rows: []EnvRow = @slice(ENV_P, ENV_CAP);
    for i in 0..ENV_N {
        if rows[i].name == name {
            rows[i] = rows[ENV_N - 1];
            ENV_N -= 1;
            break;
        }
    }
    return ok;
}

/// `name\0value\0` in a fresh `mmapAnon` block of `name.len + value.len + 2` bytes, for `setenv`. 0 when
/// `name` is empty or has `=` or a NUL, or `value` has a NUL (C would cut it there).
fn envPair(name: string, value: string): ptr {
    if name.len == 0 {
        return 0;
    }
    for k in 0..name.len {
        if name[k] == 61 || name[k] == 0 {
            return 0;
        }
    }
    for k in 0..value.len {
        if value[k] == 0 {
            return 0;
        }
    }
    let n = name.len + value.len + 2;
    let block = mmapAnon(n);
    if block as int == 0 {
        return 0;
    }
    let b: []u8 = @slice(block, n);
    for k in 0..name.len {
        b[k] = name[k];
    }
    b[name.len] = 0;
    for k in 0..value.len {
        b[name.len + 1 + k] = value[k];
    }
    b[n - 1] = 0;
    return block;
}

/// The last failed call's error code (`GetLastError`).
pub fn errno(): int {
    return int(k32.GetLastError());
}

/// Load the DLL `name` (`LoadLibraryA`). 0 when it cannot be loaded.
pub fn dlopen(name: string): ptr {
    return k32.LoadLibraryA(cstrTmp(name));
}

/// Address of `name` in a DLL from `dlopen`. 0 when missing.
pub fn dlsym(handle: ptr, name: string): ptr {
    return k32.GetProcAddress(handle, cstrTmp(name));
}

#[singleton]
let EXE_DIR: [1024]u8;

/// Directory of the running executable, no trailing slash (`GetModuleFileNameA`). Valid until the
/// next call; "" when it cannot be read.
pub fn exeDir(): string {
    let n = int(k32.GetModuleFileNameA(0, &EXE_DIR[0] as ptr, u32(1023)));
    while n > 0 && EXE_DIR[n - 1] != 92 && EXE_DIR[n - 1] != 47 {
        n -= 1;
    }
    if n <= 1 {
        return "";
    }
    let bytes: []u8 = @slice(&EXE_DIR[0] as ptr, n - 1);
    return bytes as string;
}
