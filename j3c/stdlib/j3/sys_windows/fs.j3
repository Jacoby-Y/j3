// More of `j3.sys`: the calls of `sys/fs.j3`. `rmdir`, `cwd` and `realpathTo` work; fsync, flock and pidfd
// return `-ENOSYS` (-38), so `j3.io` reports `IoError.Other`.

module j3.sys;

/// `open` flag with `O_CREAT`: fail when the file is already there.
pub const O_EXCL: int = 128;
/// `flock` operations: shared, exclusive, don't block (or it in), unlock.
pub const LOCK_SH: int = 1;
pub const LOCK_EX: int = 2;
pub const LOCK_NB: int = 4;
pub const LOCK_UN: int = 8;
/// `errno` values the io layer tells apart.
pub const EINTR: int = 4;
pub const EEXIST: int = 17;
pub const EWOULDBLOCK: int = 11;

/// Not on this target yet: -38.
pub fn fsync(fd: int): int { return -38; }
/// Not on this target yet: -38.
pub fn flock(fd: int, op: int): int { return -38; }
/// Remove the empty directory `path` (`RemoveDirectoryA`): 0, -2 when missing, -39 when not empty.
pub fn rmdir(path: ptr): int {
    if k32.RemoveDirectoryA(path) == 0 {
        return winErr();
    }
    return 0;
}

/// The working directory written to `out`, no NUL (`GetCurrentDirectoryA`, e.g. `C:\Users\me`): its length,
/// or -36 when `out` is too small.
pub fn cwd(out: []u8): int {
    let n = int(k32.GetCurrentDirectoryA(u32(out.len), out.ptr as ptr));
    if n == 0 {
        return winErr();
    }
    if n >= out.len {
        return -36;
    }
    return n;
}
/// Not on this target yet: -38.
pub fn pidfdOpen(pid: int): int { return -38; }
/// The absolute path of the existing `path` (NUL-terminated) written to `out`, no NUL (`GetFullPathNameA`:
/// `.` and `..` folded, `/` turned into `\`; links are not resolved): its length, -2 when it does not exist,
/// -36 when `out` is too small.
pub fn realpathTo(path: ptr, out: []u8): int {
    if k32.GetFileAttributesA(path) == u32(4294967295) {
        return winErr();
    }
    let n = int(k32.GetFullPathNameA(path, u32(out.len), out.ptr as ptr, 0 as ptr));
    if n == 0 {
        return winErr();
    }
    if n >= out.len {
        return -36;
    }
    return n;
}
