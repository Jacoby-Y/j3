/// A* on a byte grid. Walkable cells are an inclusive byte range.

module j3.path;

use j3.memory.{ Arena, scratch };

/// Most cells `search` will expand. Larger maps return an empty path.
const MAX_CELLS: int = 4096;

/// 4-connected A* from `(x0, y0)` to `(x1, y1)`.
/// A cell is walkable when its byte is in `a..=b`.
/// Returns scratch indices `y * w + x` from start to goal, or empty.
pub fn search(
    cells: []u8,
    w: int,
    h: int,
    x0: int,
    y0: int,
    x1: int,
    y1: int,
    a: u8,
    b: u8,
): []int {
    let n = w * h;
    let empty = scratch(1).alloc::<int>(0);
    if w <= 0 || h <= 0 || n > MAX_CELLS || n > cells.len {
        return []int { ptr: empty.ptr, len: 0 };
    }
    if !walkable(cells, w, h, x0, y0, a, b) || !walkable(cells, w, h, x1, y1, a, b) {
        return []int { ptr: empty.ptr, len: 0 };
    }
    let mem = scratch(1);
    let g = mem.alloc::<int>(n);
    let parent = mem.alloc::<int>(n);
    let open = mem.alloc::<int>(n);
    let inOpen = mem.alloc::<u8>(n);
    let closed = mem.alloc::<u8>(n);
    let i = 0;
    while i < n {
        g[i] = 1073741824;
        parent[i] = 0 - 1;
        inOpen[i] = 0;
        closed[i] = 0;
        i += 1;
    }
    let start = y0 * w + x0;
    let goal = y1 * w + x1;
    g[start] = 0;
    open[0] = start;
    inOpen[start] = 1;
    let nopen = 1;
    while nopen > 0 {
        let best = 0;
        let bi = 1;
        while bi < nopen {
            if fscore(g, open[bi], w, x1, y1) < fscore(g, open[best], w, x1, y1) {
                best = bi;
            }
            bi += 1;
        }
        let cur = open[best];
        nopen = nopen - 1;
        open[best] = open[nopen];
        inOpen[cur] = 0;
        closed[cur] = 1;
        if cur == goal {
            return rebuild(parent, start, goal);
        }
        let cx = cur - (cur / w) * w;
        let cy = cur / w;
        nopen = consider(cells, w, h, a, b, g, parent, open, inOpen, closed, nopen, cur, cx + 1, cy);
        nopen = consider(cells, w, h, a, b, g, parent, open, inOpen, closed, nopen, cur, cx - 1, cy);
        nopen = consider(cells, w, h, a, b, g, parent, open, inOpen, closed, nopen, cur, cx, cy + 1);
        nopen = consider(cells, w, h, a, b, g, parent, open, inOpen, closed, nopen, cur, cx, cy - 1);
    }
    let none = mem.alloc::<int>(0);
    return []int { ptr: none.ptr, len: 0 };
}

/// Manhattan distance plus `g`, used to pick the next open cell.
fn fscore(g: []int, cell: int, w: int, x1: int, y1: int): int {
    let x = cell - (cell / w) * w;
    let y = cell / w;
    let dx = x - x1;
    let dy = y - y1;
    if dx < 0 {
        dx = 0 - dx;
    }
    if dy < 0 {
        dy = 0 - dy;
    }
    return g[cell] + dx + dy;
}

/// Relax the edge from `cur` into `(x, y)` when that step is cheaper.
fn consider(
    cells: []u8,
    w: int,
    h: int,
    a: u8,
    b: u8,
    g: []int,
    parent: []int,
    open: []int,
    inOpen: []u8,
    closed: []u8,
    nopen: int,
    cur: int,
    x: int,
    y: int,
): int {
    if !walkable(cells, w, h, x, y, a, b) {
        return nopen;
    }
    let next = y * w + x;
    if closed[next] != 0 {
        return nopen;
    }
    let cost = g[cur] + 1;
    if cost >= g[next] {
        return nopen;
    }
    g[next] = cost;
    parent[next] = cur;
    if inOpen[next] == 0 {
        open[nopen] = next;
        inOpen[next] = 1;
        return nopen + 1;
    }
    return nopen;
}

/// True when `(x, y)` is inside the grid and its byte is in `a..=b`.
fn walkable(cells: []u8, w: int, h: int, x: int, y: int, a: u8, b: u8): bool {
    if x < 0 || y < 0 || x >= w || y >= h {
        return false;
    }
    let v = cells[y * w + x];
    return v >= a && v <= b;
}

/// Walk parents from `goal` back to `start` and reverse into a scratch path.
fn rebuild(parent: []int, start: int, goal: int): []int {
    let count = 0;
    let cur = goal;
    while cur != start && count < MAX_CELLS {
        count += 1;
        cur = parent[cur];
        if cur < 0 {
            let none = scratch(1).alloc::<int>(0);
            return []int { ptr: none.ptr, len: 0 };
        }
    }
    count += 1;
    let out = scratch(1).alloc::<int>(count);
    let i = count - 1;
    cur = goal;
    while i >= 0 {
        out[i] = cur;
        if cur == start {
            break;
        }
        cur = parent[cur];
        i = i - 1;
    }
    return []int { ptr: out.ptr, len: count };
}
