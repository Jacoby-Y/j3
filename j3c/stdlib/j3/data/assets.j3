/// Load-once cache. Join dir+name in a fixed buffer (string concat is not a thing).
/// Main thread only: it loads through `j3.game` (`j3c doc threads`).

module j3.data.assets;

use j3.game.{ Font, Music, Sound, Texture, destroyFont, destroyMusic, destroySound, destroyTexture, tryLoadFontC, tryLoadMusicC, tryLoadSoundC, tryLoadTextureC };
use j3.memory.Arena;
use j3.text.same;

/// Bytes in the path-join buffer, including the trailing NUL.
const PATH_CAP: int = 512;

/// Scratch bytes for `joinC`. Not safe to hold across another join.
#[singleton]
let PATH: [512]u8;

/// Writes `dir` then `name` into the fixed PATH buffer as a NUL-terminated cstr.
fn joinC(dir: string, name: string): cstr {
    let i = 0;
    while i < dir.len && i < PATH_CAP - 1 {
        PATH[i] = dir[i];
        i += 1;
    }
    let j = 0;
    while j < name.len && i < PATH_CAP - 1 {
        PATH[i] = name[j];
        i += 1;
        j += 1;
    }
    PATH[i] = 0;
    return &PATH[0] as cstr;
}

/// Load-once cache of textures, sounds, music, and fonts under search roots.
pub struct Assets {
    /// Cached textures.
    tex: []Texture;
    /// Lookup names parallel to `tex`.
    tex_name: []string;
    /// Number of cached textures.
    tex_n: int;
    /// Cached sounds.
    snd: []Sound;
    /// Lookup names parallel to `snd`.
    snd_name: []string;
    /// Number of cached sounds.
    snd_n: int;
    /// Cached music tracks.
    mus: []Music;
    /// Lookup names parallel to `mus`.
    mus_name: []string;
    /// Number of cached music tracks.
    mus_n: int;
    /// Cached fonts.
    fonts: []Font;
    /// Lookup names parallel to `fonts`.
    font_name: []string;
    /// Point sizes parallel to `fonts`.
    font_size: []int;
    /// Number of cached fonts.
    font_n: int;
    /// Directory prefixes tried when loading by name.
    roots: []string;
    /// Number of search roots.
    root_n: int;
    /// Arena for growing cache tables.
    arena: &Arena;

    /// Empty cache with initial table capacities.
    fn new(arena: &Arena): Assets {
        return Assets {
            tex: arena.alloc::<Texture>(8),
            tex_name: arena.alloc::<string>(8),
            tex_n: 0,
            snd: arena.alloc::<Sound>(8),
            snd_name: arena.alloc::<string>(8),
            snd_n: 0,
            mus: arena.alloc::<Music>(4),
            mus_name: arena.alloc::<string>(4),
            mus_n: 0,
            fonts: arena.alloc::<Font>(4),
            font_name: arena.alloc::<string>(4),
            font_size: arena.alloc::<int>(4),
            font_n: 0,
            roots: arena.alloc::<string>(4),
            root_n: 0,
            arena: arena,
        };
    }

    /// Appends a directory root searched by loaders.
    fn addRoot(this: &Assets, dir: string) {
        if this.root_n >= this.roots.len {
            let next = this.roots.len * 2;
            if next < 4 {
                next = 4;
            }
            let fresh = this.arena.alloc::<string>(next);
            let i = 0;
            while i < this.root_n {
                fresh[i] = this.roots[i];
                i += 1;
            }
            this.roots = fresh;
        }
        this.roots[this.root_n] = dir;
        this.root_n = this.root_n + 1;
    }

    /// Returns a cached texture, loading from the first matching root on miss.
    fn texture(this: &Assets, name: string): Texture {
        let i = 0;
        while i < this.tex_n {
            if same(this.tex_name[i], name) {
                return this.tex[i];
            }
            i += 1;
        }
        let t = Texture { raw: 0, w: 0, h: 0 };
        let r = 0;
        while r < this.root_n {
            let got = tryLoadTextureC(joinC(this.roots[r], name));
            if got.raw != 0 {
                t = got;
                break;
            }
            r += 1;
        }
        if this.tex_n >= this.tex.len {
            let next = this.tex.len * 2;
            if next < 8 {
                next = 8;
            }
            let fresh_t = this.arena.alloc::<Texture>(next);
            let fresh_n = this.arena.alloc::<string>(next);
            i = 0;
            while i < this.tex_n {
                fresh_t[i] = this.tex[i];
                fresh_n[i] = this.tex_name[i];
                i += 1;
            }
            this.tex = fresh_t;
            this.tex_name = fresh_n;
        }
        this.tex[this.tex_n] = t;
        this.tex_name[this.tex_n] = name;
        this.tex_n = this.tex_n + 1;
        return t;
    }

    /// Returns a cached sound, loading from the first matching root on miss.
    fn sound(this: &Assets, name: string): Sound {
        let i = 0;
        while i < this.snd_n {
            if same(this.snd_name[i], name) {
                return this.snd[i];
            }
            i += 1;
        }
        let s = Sound { raw: 0 };
        let r = 0;
        while r < this.root_n {
            let got = tryLoadSoundC(joinC(this.roots[r], name));
            if got.raw != 0 {
                s = got;
                break;
            }
            r += 1;
        }
        if this.snd_n >= this.snd.len {
            let next = this.snd.len * 2;
            if next < 8 {
                next = 8;
            }
            let fresh_s = this.arena.alloc::<Sound>(next);
            let fresh_n = this.arena.alloc::<string>(next);
            i = 0;
            while i < this.snd_n {
                fresh_s[i] = this.snd[i];
                fresh_n[i] = this.snd_name[i];
                i += 1;
            }
            this.snd = fresh_s;
            this.snd_name = fresh_n;
        }
        this.snd[this.snd_n] = s;
        this.snd_name[this.snd_n] = name;
        this.snd_n = this.snd_n + 1;
        return s;
    }

    /// Returns cached music, loading from the first matching root on miss.
    fn music(this: &Assets, name: string): Music {
        let i = 0;
        while i < this.mus_n {
            if same(this.mus_name[i], name) {
                return this.mus[i];
            }
            i += 1;
        }
        let m = Music { raw: 0 };
        let r = 0;
        while r < this.root_n {
            let got = tryLoadMusicC(joinC(this.roots[r], name));
            if got.raw != 0 {
                m = got;
                break;
            }
            r += 1;
        }
        if this.mus_n >= this.mus.len {
            let next = this.mus.len * 2;
            if next < 4 {
                next = 4;
            }
            let fresh_m = this.arena.alloc::<Music>(next);
            let fresh_n = this.arena.alloc::<string>(next);
            i = 0;
            while i < this.mus_n {
                fresh_m[i] = this.mus[i];
                fresh_n[i] = this.mus_name[i];
                i += 1;
            }
            this.mus = fresh_m;
            this.mus_name = fresh_n;
        }
        this.mus[this.mus_n] = m;
        this.mus_name[this.mus_n] = name;
        this.mus_n = this.mus_n + 1;
        return m;
    }

    /// Returns a cached font for `name`+`size`, loading from roots on miss.
    fn font(this: &Assets, name: string, size: int): Font {
        let i = 0;
        while i < this.font_n {
            if same(this.font_name[i], name) && this.font_size[i] == size {
                return this.fonts[i];
            }
            i += 1;
        }
        let f = Font { raw: 0 };
        let r = 0;
        while r < this.root_n {
            let got = tryLoadFontC(joinC(this.roots[r], name), size);
            if got.raw != 0 {
                f = got;
                break;
            }
            r += 1;
        }
        if this.font_n >= this.fonts.len {
            let next = this.fonts.len * 2;
            if next < 4 {
                next = 4;
            }
            let fresh_f = this.arena.alloc::<Font>(next);
            let fresh_n = this.arena.alloc::<string>(next);
            let fresh_s = this.arena.alloc::<int>(next);
            i = 0;
            while i < this.font_n {
                fresh_f[i] = this.fonts[i];
                fresh_n[i] = this.font_name[i];
                fresh_s[i] = this.font_size[i];
                i += 1;
            }
            this.fonts = fresh_f;
            this.font_name = fresh_n;
            this.font_size = fresh_s;
        }
        this.fonts[this.font_n] = f;
        this.font_name[this.font_n] = name;
        this.font_size[this.font_n] = size;
        this.font_n = this.font_n + 1;
        return f;
    }

    /// Destroys all cached GPU/audio resources and resets counts to zero.
    fn destroy(this: &Assets) {
        let i = 0;
        while i < this.tex_n {
            destroyTexture(this.tex[i]);
            i += 1;
        }
        i = 0;
        while i < this.snd_n {
            destroySound(this.snd[i]);
            i += 1;
        }
        i = 0;
        while i < this.mus_n {
            destroyMusic(this.mus[i]);
            i += 1;
        }
        i = 0;
        while i < this.font_n {
            destroyFont(this.fonts[i]);
            i += 1;
        }
        this.tex_n = 0;
        this.snd_n = 0;
        this.mus_n = 0;
        this.font_n = 0;
    }
}
