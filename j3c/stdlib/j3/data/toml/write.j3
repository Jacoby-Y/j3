// Part of j3.data.toml: stringify, quote, escape; the module doc and `use`s are in ../toml.j3.
module j3.data.toml;

// ---------------------------------------------------------------- write

/// `doc` (an object) as TOML on `arena`: plain keys first, then each sub-table as `[a.b]` and each array of
/// objects as `[[a]]`, in key order. Other arrays and objects inside arrays are written inline. TOML has no
/// null: null values are left out. ponytail: a header is written only for a table with plain keys or none
/// at all, so `[a]` holding only `[a.b]` is implied, as TOML allows.
pub fn stringify(doc: &Json, arena: &Arena): string {
    let t = Text.new(arena);
    writeTable(&t, doc, "", true);
    return t.str();
}

/// Append `s` as a basic TOML string, quotes included.
pub fn quote(t: &Text, s: string) {
    t.push('"');
    escape(t, s);
    t.push('"');
}

/// Append `s` escaped for the inside of a basic string (`"`, `\`, control characters), no quotes.
pub fn escape(t: &Text, s: string) {
    let hex = "0123456789ABCDEF";
    for i in 0..s.len {
        let c = s[i];
        if c == '"' { t.pushStr("\\\""); }
        else if c == '\\' { t.pushStr("\\\\"); }
        else if c == '\n' { t.pushStr("\\n"); }
        else if c == '\t' { t.pushStr("\\t"); }
        else if c == '\r' { t.pushStr("\\r"); }
        else if c < 32 || c == 127 {
            t.pushStr("\\u00");
            t.push(hex[int(c) / 16]);
            t.push(hex[int(c) % 16]);
        } else {
            t.push(c);
        }
    }
}

/// Whether `v` is written as `[[...]]`: a non-empty array of objects only.
fn isTableArray(v: &Json): bool {
    if v.kind != Kind.Arr || v.len() == 0 { return false; }
    for i in 0..v.len() {
        if v.at(i).kind != Kind.Obj { return false; }
    }
    return true;
}

fn isSub(v: &Json): bool { return v.kind == Kind.Obj || isTableArray(v); }

fn pushKey(t: &Text, k: string) {
    let bare = k.len > 0;
    for i in 0..k.len {
        if !isBareKey(k[i]) { bare = false; }
    }
    if bare { t.pushStr(k); } else { quote(t, k); }
}

fn subPath(t: &Text, prefix: string, k: string): string {
    let p = Text.new(t.arena);
    if prefix.len > 0 { p.add(prefix).push('.'); }
    pushKey(&p, k);
    return p.str();
}

/// `o`'s plain keys, then its sub-tables. `headed`: the header (or `[[...]]`) is already written.
fn writeTable(t: &Text, o: &Json, prefix: string, headed: bool) {
    let plain = 0;
    let subs = 0;
    for i in 0..o.len() {
        let v = o.at(i);
        if v.kind == Kind.Null { continue; }
        if isSub(v) { subs += 1; } else { plain += 1; }
    }
    if !headed && (plain > 0 || subs == 0) {
        if t.bytes.len > 0 { t.push('\n'); }
        t.push('[');
        t.pushStr(prefix);
        t.pushStr("]\n");
    }
    for i in 0..o.len() {
        let v = o.at(i);
        if v.kind == Kind.Null || isSub(v) { continue; }
        pushKey(t, o.keys.items[i]);
        t.pushStr(" = ");
        writeVal(t, v);
        t.push('\n');
    }
    for i in 0..o.len() {
        let v = o.at(i);
        if v.kind == Kind.Null || !isSub(v) { continue; }
        let p = subPath(t, prefix, o.keys.items[i]);
        if v.kind == Kind.Obj {
            writeTable(t, v, p, false);
            continue;
        }
        for j in 0..v.len() {
            if t.bytes.len > 0 { t.push('\n'); }
            t.pushStr("[[");
            t.pushStr(p);
            t.pushStr("]]\n");
            writeTable(t, v.at(j), p, true);
        }
    }
}

/// One value, inline.
fn writeVal(t: &Text, v: &Json) {
    match v.kind {
        Kind.Null { t.pushStr("\"\""); }
        Kind.Bool { t.pushStr(if v.b { "true" } else { "false" }); }
        Kind.Num { writeNumber(t, v.n); }
        Kind.Str { quote(t, v.s); }
        Kind.Arr {
            t.push('[');
            let n = 0;
            for i in 0..v.len() {
                if v.at(i).kind == Kind.Null { continue; }
                if n > 0 { t.pushStr(", "); }
                n += 1;
                writeVal(t, v.at(i));
            }
            t.push(']');
        }
        Kind.Obj {
            if v.len() == 0 {
                t.pushStr("{}");
                return;
            }
            t.pushStr("{ ");
            let n = 0;
            for i in 0..v.len() {
                if v.at(i).kind == Kind.Null { continue; }
                if n > 0 { t.pushStr(", "); }
                n += 1;
                pushKey(t, v.keys.items[i]);
                t.pushStr(" = ");
                writeVal(t, v.at(i));
            }
            t.pushStr(" }");
        }
    }
}

/// Whole numbers (below 2^53) as ints, others as the shortest float that reads back; `inf`, `-inf`, `nan`.
fn writeNumber(t: &Text, n: f64) {
    if !(n == n) {
        t.pushStr("nan");
        return;
    }
    if !(n - n == 0.0) {
        t.pushStr(if n > 0.0 { "inf" } else { "-inf" });
        return;
    }
    if n == f64(int(n)) && n < 9007199254740992.0 && n > -9007199254740992.0 {
        t.pushInt(int(n));
        return;
    }
    // writeF64 gives `1e+300` or `0.5`, both TOML floats
    t.pushF64(n);
}
