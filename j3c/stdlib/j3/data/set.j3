/// Hash set `Set<T>`.
/// `Set<string>.new(&arena, 16)` is a `j3.data.map.Map<T, u8>` underneath, so the same rules hold: `T` needs
/// `Hash` and `Eq`, memory comes from the arena, `clear` keeps the slots, order is unspecified
/// (`sorted(&arena)` for a deterministic one, `T: Ord`). Not shared across threads.

module j3.data.set;

use j3.cmp.{ Eq, Hash, Ord };
use j3.data.map.Map;
use j3.memory.Arena;

pub struct Set<T: Hash + Eq> {
    m: Map<T, u8>;

    /// Empty set with room for about `cap` items before the first growth.
    fn new(arena: &Arena, cap: int): Set<T> {
        return Set<T> { m: Map<T, u8>.new(arena, cap) };
    }

    /// Add `x`; true when it was not there yet.
    fn add(this: &Set<T>, x: T): bool {
        if this.m.has(x) { return false; }
        this.m.put(x, u8(1));
        return true;
    }

    /// True when `x` is in the set.
    fn has(this: &Set<T>, x: T): bool { return this.m.has(x); }

    /// Remove `x`; false when it was not there.
    fn remove(this: &Set<T>, x: T): bool { return this.m.remove(x); }

    /// Number of items.
    fn len(this: &Set<T>): int { return this.m.len; }

    /// Drop every item, keeping the slots.
    fn clear(this: &Set<T>) { this.m.clear(); }

    /// Call `f(x)` for every item (order unspecified); `f` must not add or remove.
    fn each(this: &Set<T>, f: closure(T)) {
        for i in 0..this.m.cap {
            if this.m.live(i) { f(this.m.keyAt(i)); }
        }
    }

    /// Every item, sorted ascending (`T: Ord`), in a slice from `arena`.
    fn sorted(this: &Set<T>, arena: &Arena): []T where T: Ord { return this.m.sortedKeys(arena); }
}
