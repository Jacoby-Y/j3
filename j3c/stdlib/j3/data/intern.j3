/// String interning: `string` to `u32` and back.
/// Each distinct string is copied once into the arena you pass (so callers may reuse their buffers), symbols
/// count up from 0 in first-seen order, and the lookup is a `j3.data.map.Map<string, u32>`. Not shared across
/// threads.

module j3.data.intern;

use j3.data.map.Map;
use j3.memory.{ Arena, List };
use j3.sys.panic;

pub struct Interner {
    arena: &Arena;
    ids: Map<string, u32>;
    strs: List<string>;

    /// Empty interner allocating from `arena`.
    fn new(arena: &Arena): Interner {
        return Interner { arena: arena, ids: Map<string, u32>.new(arena, 64), strs: List<string>.new(arena) };
    }

    /// The symbol for `s`, adding it when new.
    fn intern(this: &Interner, s: string): u32 {
        let have = this.ids.find(s);
        if have >= 0 { return this.ids.valAt(have); }
        let bytes = this.arena.alloc::<u8>(s.len);
        for i in 0..s.len { bytes[i] = s[i]; }
        let own = bytes as string;
        let id = u32(this.strs.len);
        this.strs.push(own);
        this.ids.put(own, id);
        return id;
    }

    /// The symbol for `s`, or -1 when it was never interned.
    fn find(this: &Interner, s: string): int {
        let i = this.ids.find(s);
        if i < 0 { return -1; }
        return int(this.ids.valAt(i));
    }

    /// The string of symbol `id`; panics on an unknown id.
    fn str(this: &Interner, id: u32): string {
        if int(id) >= this.strs.len { panic("Interner.str: unknown symbol"); }
        return this.strs.items[int(id)];
    }

    /// Number of distinct strings.
    fn len(this: &Interner): int { return this.strs.len; }
}
