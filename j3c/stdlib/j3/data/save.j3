/// `key=int`, `key f=`, `key s=`, and `key b=` (hex) text. No serde.

module j3.data.save;

use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;

/// In-memory `key=int` save blob backed by an arena.
pub struct Save {
    /// Raw file text (`key=value` lines).
    bytes: []u8;
    /// Arena used when rewriting entries.
    arena: &Arena;
}

/// Zero-length byte slice from `arena`.
fn emptyBytes(arena: &Arena): []u8 {
    return arena.alloc::<u8>(0);
}

/// Empty save with no entries.
pub fn empty(arena: &Arena): Save {
    return Save { bytes: emptyBytes(arena), arena: arena };
}

/// Load a save file, or an empty save if the read fails.
pub fn load(path: string, arena: &Arena): Save {
    match io.readFile(path, arena) {
        Result.Ok(b) {
            return Save { bytes: b, arena: arena };
        }
        Result.Err(_) {
            return empty(arena);
        }
    }
}

/// True if the line at `i` starts with `key`, then `suffix`, then `=`.
/// Callers only pass line starts, so text inside a value never matches.
fn keyAt(bytes: []u8, i: int, key: string, suffix: string): bool {
    let n = key.len + suffix.len;
    if i + n + 1 > bytes.len {
        return false;
    }
    let k = 0;
    while k < key.len {
        if bytes[i + k] != key[k] {
            return false;
        }
        k += 1;
    }
    k = 0;
    while k < suffix.len {
        if bytes[i + key.len + k] != suffix[k] {
            return false;
        }
        k += 1;
    }
    return bytes[i + n] == 61;
}

/// Start of the line after the one containing `i`.
fn nextLine(bytes: []u8, i: int): int {
    while i < bytes.len && bytes[i] != 10 {
        i += 1;
    }
    return i + 1;
}

/// Parse the integer for `key`, or `fallback` if missing or malformed.
pub fn getInt(s: &Save, key: string, fallback: int): int {
    let at = findPrefix(s, key, "");
    if at < 0 {
        return fallback;
    }
    return parseInt(s.bytes, at, fallback);
}

/// Parse an integer at `i`, or `fallback` when no digits are there.
pub fn parseInt(bytes: []u8, i: int, fallback: int): int {
    let n = 0;
    let neg = false;
    if i < bytes.len && bytes[i] == 45 {
        neg = true;
        i += 1;
    }
    let any = false;
    while i < bytes.len && bytes[i] >= 48 && bytes[i] <= 57 {
        n = n * 10 + int(bytes[i]) - 48;
        i += 1;
        any = true;
    }
    if !any {
        return fallback;
    }
    if neg {
        return 0 - n;
    }
    return n;
}

/// Set or replace `key=v`, dropping any prior line for that key.
pub fn putInt(s: &Save, key: string, v: int) {
    let value = Text.new(s.arena);
    value.pushInt(v);
    putPrefixed(s, key, "", value.str());
}

/// Parse the float for `key` (`key f=`), or `fallback` if missing.
pub fn getFloat(s: &Save, key: string, fallback: f32): f32 {
    let at = findPrefix(s, key, " f");
    if at < 0 {
        return fallback;
    }
    return parseFloat(s.bytes, at);
}

/// Set or replace `key f=v`.
pub fn putFloat(s: &Save, key: string, v: f32) {
    let value = Text.new(s.arena);
    value.pushFloat(v);
    putPrefixed(s, key, " f", value.str());
}

/// The string for `key` (`key s=`), or `fallback` if missing.
pub fn getStr(s: &Save, key: string, fallback: string): string {
    let at = findPrefix(s, key, " s");
    if at < 0 {
        return fallback;
    }
    let end = at;
    while end < s.bytes.len && s.bytes[end] != 10 {
        end += 1;
    }
    return []u8 { ptr: &s.bytes[at], len: end - at } as string;
}

/// Set or replace `key s=v`. Newlines in `v` are stored as spaces.
pub fn putStr(s: &Save, key: string, v: string) {
    let value = Text.new(s.arena);
    let i = 0;
    while i < v.len {
        let b = v[i];
        if b == 10 {
            value.push(32);
        } else {
            value.push(b);
        }
        i += 1;
    }
    putPrefixed(s, key, " s", value.str());
}

/// Decode the hex blob for `key` (`key b=`). Empty when missing.
pub fn getBlob(s: &Save, key: string): []u8 {
    let at = findPrefix(s, key, " b");
    if at < 0 {
        return s.arena.alloc::<u8>(0);
    }
    let end = at;
    while end < s.bytes.len && s.bytes[end] != 10 {
        end += 1;
    }
    let hexLen = end - at;
    let n = hexLen / 2;
    let out = s.arena.alloc::<u8>(n);
    let i = 0;
    while i < n {
        let hi = hexVal(s.bytes[at + i * 2]);
        let lo = hexVal(s.bytes[at + i * 2 + 1]);
        out[i] = u8(hi * 16 + lo);
        i += 1;
    }
    return out;
}

/// Set or replace `key b=` with the hex of `data`.
pub fn putBlob(s: &Save, key: string, data: []u8) {
    let value = Text.new(s.arena);
    let hex = "0123456789ABCDEF";
    let i = 0;
    while i < data.len {
        let b = int(data[i]);
        value.push(hex[b / 16]);
        value.push(hex[b - (b / 16) * 16]);
        i += 1;
    }
    putPrefixed(s, key, " b", value.str());
}

/// Index just after `key + suffix + "="`, or `-1`.
fn findPrefix(s: &Save, key: string, suffix: string): int {
    let i = 0;
    while i < s.bytes.len {
        if keyAt(s.bytes, i, key, suffix) {
            return i + key.len + suffix.len + 1;
        }
        i = nextLine(s.bytes, i);
    }
    return 0 - 1;
}

/// Replace the line whose prefix is `key + suffix`, then append `value`.
fn putPrefixed(s: &Save, key: string, suffix: string, value: string) {
    let t = Text.new(s.arena);
    let i = 0;
    while i < s.bytes.len {
        let end = nextLine(s.bytes, i);
        if !keyAt(s.bytes, i, key, suffix) {
            let k = i;
            while k < end && k < s.bytes.len {
                t.push(s.bytes[k]);
                k += 1;
            }
            if end > s.bytes.len {
                t.push(10);
            }
        }
        i = end;
    }
    t.pushStr(key);
    t.pushStr(suffix);
    t.push(61);
    t.pushStr(value);
    t.push(10);
    s.bytes = t.bytes;
}

/// Parse a float at `i`. Stops at the first non-number byte.
pub fn parseFloat(bytes: []u8, i: int): f32 {
    let at = i;
    let neg = false;
    if at < bytes.len && bytes[at] == 45 {
        neg = true;
        at += 1;
    }
    // Digits become one integer over a power of ten, so the f64 quotient is correctly rounded
    // (what a Python `float()` gives) and `f32` of it is the nearest f32 to the text.
    let mantissa = 0;
    let digits = 0;
    let scale: f64 = 1.0;
    let dot = false;
    while at < bytes.len {
        let b = bytes[at];
        if b == 46 && !dot {
            dot = true;
        } else if b >= 48 && b <= 57 {
            if digits < 18 {
                mantissa = mantissa * 10 + int(b) - 48;
                digits += 1;
                if dot { scale = scale * 10.0; }
            }
        } else {
            break;
        }
        at += 1;
    }
    let n = f32(f64(mantissa) / scale);
    if neg {
        return f32(0) - n;
    }
    return n;
}

/// Hex digit value, or 0.
fn hexVal(b: u8): int {
    if b >= 48 && b <= 57 {
        return int(b) - 48;
    }
    if b >= 65 && b <= 70 {
        return int(b) - 55;
    }
    if b >= 97 && b <= 102 {
        return int(b) - 87;
    }
    return 0;
}

/// Write the save bytes to `path`; write errors are ignored.
pub fn store(s: &Save, path: string) {
    match io.writeFile(path, s.bytes) {
        Result.Ok(_) {}
        Result.Err(_) {}
    }
}
