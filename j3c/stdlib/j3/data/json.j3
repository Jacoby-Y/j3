/// JSON (RFC 8259): `parse` bytes into a `Json` tree, read it with `get` / `at` / `path`, build one
/// with `obj` / `arr` / `str` / `num` and `set` / `push`, and `write` it back out. The tree and
/// its strings live on the arena you pass. Reading never fails: a missing key, an index past the
/// end, or the wrong kind gives the shared null node, whose `asStr` is "" and `asNum` is 0.
///
///     let doc = json.parse(body, &arena)?;               // Result<&Json, JsonError>
///     let text = doc.path("choices.0.message.content").asStr();
///
///     let msg = json.obj(&arena);
///     msg.set("role", json.str("user", &arena));
///     let out = json.stringify(msg, &arena);              // {"role":"user"}
///
/// Objects keep their keys in order; `get` is a linear scan. Numbers are `f64`.

module j3.data.json;

use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text.Text;

use lib "c" as c {
    fn strtod(s: ptr, end: ptr): f64;
    // variadic in C; the emitter calls a binding of it with the variadic type
    fn snprintf(buf: ptr, n: u64, fmt: cstr, digits: i32, x: f64): i32;
}

/// What a `Json` node holds.
pub enum Kind {
    Null,
    Bool,
    Num,
    Str,
    Arr,
    Obj,
}

/// Why `parse` failed.
pub struct JsonError {
    /// Byte offset of the problem in the input.
    at: int;
    /// What was wrong.
    msg: string;
}

/// One JSON value. Read the field that matches `kind`, or use the `as*` methods, which never fail.
pub struct Json {
    /// Which value this is.
    kind: Kind;
    /// `Bool` value.
    b: bool;
    /// `Num` value.
    n: f64;
    /// `Str` value.
    s: string;
    /// `Arr` elements, or `Obj` values (in key order).
    items: List<&Json>;
    /// `Obj` keys, parallel to `items`.
    keys: List<string>;

    /// The value under `key` in an object, or null.
    fn get(this: &Json, key: string): &Json {
        if this.kind == Kind.Obj {
            // ponytail: linear key scan; fine for API replies, add an index if objects get big
            for i in 0..this.keys.len {
                if eq(this.keys.items[i], key) {
                    return this.items.items[i];
                }
            }
        }
        return &NULL;
    }

    /// True when an object has `key`.
    fn has(this: &Json, key: string): bool {
        if this.kind == Kind.Obj {
            for i in 0..this.keys.len {
                if eq(this.keys.items[i], key) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Element `i` of an array (or the `i`th value of an object), or null.
    fn at(this: &Json, i: int): &Json {
        if (this.kind == Kind.Arr || this.kind == Kind.Obj) && i >= 0 && i < this.items.len {
            return this.items.items[i];
        }
        return &NULL;
    }

    /// Elements of an array, entries of an object, else 0.
    fn len(this: &Json): int {
        if this.kind == Kind.Arr || this.kind == Kind.Obj {
            return this.items.len;
        }
        return 0;
    }

    /// Walk dot-separated keys and array indexes: `"choices.0.message.content"`. Null when any step is missing.
    fn path(this: &Json, p: string): &Json {
        let cur = this;
        let start = 0;
        for i in 0..p.len + 1 {
            if i == p.len || p[i] == 46 {
                let part = p[start..i];
                if cur.kind == Kind.Arr {
                    cur = cur.at(index(part));
                } else {
                    cur = cur.get(part);
                }
                start = i + 1;
            }
        }
        return cur;
    }

    /// The string, or "".
    fn asStr(this: &Json): string {
        if this.kind == Kind.Str {
            return this.s;
        }
        return "";
    }

    /// The number, or 0.
    fn asNum(this: &Json): f64 {
        if this.kind == Kind.Num {
            return this.n;
        }
        return 0.0;
    }

    /// The number cut to an `int`, or 0.
    fn asInt(this: &Json): int {
        if this.kind == Kind.Num {
            return int(this.n);
        }
        return 0;
    }

    /// The bool, or false.
    fn asBool(this: &Json): bool {
        return this.kind == Kind.Bool && this.b;
    }

    /// True for `null` and for anything missing.
    fn isNull(this: &Json): bool {
        return this.kind == Kind.Null;
    }

    /// Set `key` in an object to `v`, replacing an existing value.
    fn set(this: &Json, key: string, v: &Json) {
        if this.kind != Kind.Obj {
            return;
        }
        for i in 0..this.keys.len {
            if eq(this.keys.items[i], key) {
                this.items.items[i] = v;
                return;
            }
        }
        this.keys.push(key);
        this.items.push(v);
    }

    /// Append `v` to an array.
    fn push(this: &Json, v: &Json) {
        if this.kind == Kind.Arr {
            this.items.push(v);
        }
    }
}

/// The node every failed lookup returns. Read-only: never `set` or `push` on it.
#[singleton]
let NULL: Json;

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// A decimal array index, or -1.
fn index(s: string): int {
    if s.len == 0 {
        return -1;
    }
    let n = 0;
    for i in 0..s.len {
        if s[i] < 48 || s[i] > 57 {
            return -1;
        }
        n = n * 10 + int(s[i]) - 48;
    }
    return n;
}

fn node(k: Kind, arena: &Arena): &Json {
    let j = &arena.alloc::<Json>(1)[0];
    *j = Json { kind: k, b: false, n: 0.0, s: "", items: List<&Json>.new(arena), keys: List<string>.new(arena) };
    return j;
}

/// A new empty object.
pub fn obj(arena: &Arena): &Json {
    return node(Kind.Obj, arena);
}

/// A new empty array.
pub fn arr(arena: &Arena): &Json {
    return node(Kind.Arr, arena);
}

/// A string value (`s` is not copied).
pub fn str(s: string, arena: &Arena): &Json {
    let j = node(Kind.Str, arena);
    j.s = s;
    return j;
}

/// A number value.
pub fn num(n: f64, arena: &Arena): &Json {
    let j = node(Kind.Num, arena);
    j.n = n;
    return j;
}

/// A bool value.
pub fn boolean(b: bool, arena: &Arena): &Json {
    let j = node(Kind.Bool, arena);
    j.b = b;
    return j;
}

/// A null value.
pub fn null(arena: &Arena): &Json {
    return node(Kind.Null, arena);
}
