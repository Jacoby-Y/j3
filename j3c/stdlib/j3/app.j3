/// Bevy-shaped runner. Stages: startup (once) / always / first+update+last @ 60 Hz / draw.
/// Main thread only: window, GL, and audio state is not thread-safe (`j3c doc threads`).
///
/// Environment (handled in `j3.game`, so any App needs no code change):
/// - `J3_CAPTURE=out.png:N` saves frame N (1-based, before it is shown) to `out.png`, then quits.
/// - `J3_STEADY=a:b` (a < b) prints `steady layouts=N restyles=N arena_growth=N` at the end of frame b
///   (counts since the end of frame a, all `.j3ui` roots, `App.mem` growth), quits, and after the normal
///   teardown exits 1 when any is non-zero or the run ended before frame b, else 0.
/// - `J3_HOT_QUIT` / `J3_HOT_WIN` / `J3_HOT_STATE` (file paths set by `j3c run --hot`): see `App.hot`.
/// - `J3_IDLE_SKIP=1|0` forces idle frame skipping on or off (`App.idleSkip`; off by default in tests); `J3_IDLE_STATS=1` prints the frame count at exit.
/// - `J3_FIXED_DT=0.016` makes every frame's dt that many seconds instead of measured time,
///   so captures repeat exactly.

module j3.app;

use j3.data.save;
use j3.data.save.Save;
use j3.game;
use j3.game.display;
use j3.game.splash;
use j3.gfx.canvas;
use j3.appconfig;
use j3.instance;
use j3.instance.Request;
use j3.io;
use j3.io.printLn;
use j3.option.Option;
use j3.memory.{ Arena, rewindScratch, scratch, frameHook, laidTotal, restyledTotal };
use j3.sys.exit;

/// Fixed-timestep app runner over a user world `W`, with staged system lists.
pub struct App<W> {
    /// Process arena used for world boot and growing system tables.
    mem: &Arena;
    /// User world value passed by reference to every registered system.
    world: W;
    /// Startup systems run once before the main loop.
    startups: []fn(&W);
    /// Number of entries in `startups`.
    n_start: int;
    /// Shutdown callbacks (`App.shutdown`), run in registration order after the loop ends.
    downs: []fn(&W);
    /// Number of entries in `downs`.
    n_down: int;
    /// True while the shutdown callbacks run; `shutdown` then prints an error and ignores the call.
    in_down: bool;
    /// Fixed-tick systems that run before `updates` each step.
    firsts: []fn(&W, f32);
    /// Number of entries in `firsts`.
    n_first: int;
    /// Fixed-tick update systems (main simulation stage).
    updates: []fn(&W, f32);
    /// Number of entries in `updates`.
    n_update: int;
    /// Fixed-tick systems that run after `updates` each step.
    lasts: []fn(&W, f32);
    /// Number of entries in `lasts`.
    n_last: int;
    /// Variable-dt systems run every frame before fixed steps.
    alwayses: []fn(&W, f32);
    /// Number of entries in `alwayses`.
    n_always: int;
    /// Draw systems run once per frame after fixed steps.
    draws: []fn(&W);
    /// Number of entries in `draws`.
    n_draw: int;
    /// Window title passed to `game.init` / `game.initGl`.
    title: string;
    /// Initial window width in pixels.
    width: int;
    /// Initial window height in pixels.
    height: int;
    /// Minimum window width for `game.setMinSize`.
    min_w: int;
    /// Minimum window height for `game.setMinSize`.
    min_h: int;
    /// Whether the window may be resized.
    resizable: bool;
    /// When true, `run` calls `game.initGl` instead of `game.init`.
    gl: bool;
    /// When true, `run` calls `game.setHiDpi(true)` before opening a GL window.
    hidpi: bool;
    /// Video settings file for `display.load`, or empty for none.
    video: string;
    /// When true, `run` skips fixed steps. `always` and `draw` still run.
    paused: bool;
    /// Multiplier on the frame dt added into the fixed-step accumulator.
    scale: f32;
    /// `App.hot` hooks (one slot each, empty when unset).
    hot_save: []fn(&W, &Save);
    hot_load: []fn(&W, &Save);
    /// `onMessage`: arguments from a later copy of the program (`j3.instance.claim`).
    on_msg: []fn(&W, []string);
    /// `onRequest`: requests from `j3.instance.request` that expect a reply.
    on_req: []fn(&W, Request);
    /// Show the startup splash in `run` (`App.splash`).
    splash_on: bool;
    /// Sleep through idle frames when a `.j3ui` `Dom` is hosted, nothing moves and no system is registered (`App.idleSkip`, default on).
    idle_on: bool;
    /// Image paths shown after the J3 logo (`App.splashCard`).
    splash_cards: []string;

    /// Boots `W` on the default heap and returns an empty system schedule.
    fn create(title: string, width: int, height: int, boot: fn(&Arena): W): App<W> {
        let mem = heap(DEFAULT_CAP);
        let world = boot(mem);
        return App<W> {
            mem: mem,
            world: world,
            startups: mem.alloc::<fn(&W)>(4),
            n_start: 0,
            downs: mem.alloc::<fn(&W)>(2),
            n_down: 0,
            in_down: false,
            firsts: mem.alloc::<fn(&W, f32)>(4),
            n_first: 0,
            updates: mem.alloc::<fn(&W, f32)>(8),
            n_update: 0,
            lasts: mem.alloc::<fn(&W, f32)>(4),
            n_last: 0,
            alwayses: mem.alloc::<fn(&W, f32)>(8),
            n_always: 0,
            draws: mem.alloc::<fn(&W)>(8),
            n_draw: 0,
            title: title,
            width: width,
            height: height,
            min_w: 320,
            min_h: 180,
            resizable: true,
            gl: false,
            hidpi: false,
            video: "",
            paused: false,
            scale: 1,
            hot_save: mem.alloc::<fn(&W, &Save)>(0),
            hot_load: mem.alloc::<fn(&W, &Save)>(0),
            on_msg: mem.alloc::<fn(&W, []string)>(0),
            on_req: mem.alloc::<fn(&W, Request)>(0),
            splash_on: false,
            idle_on: true,
            splash_cards: mem.alloc::<string>(0),
        };
    }

    /// Like `create`, but uses `cap` bytes for the process heap.
    fn createSized(
        title: string,
        width: int,
        height: int,
        cap: int,
        boot: fn(&Arena): W,
    ): App<W> {
        let mem = heap(cap);
        let world = boot(mem);
        return App<W> {
            mem: mem,
            world: world,
            startups: mem.alloc::<fn(&W)>(4),
            n_start: 0,
            downs: mem.alloc::<fn(&W)>(2),
            n_down: 0,
            in_down: false,
            firsts: mem.alloc::<fn(&W, f32)>(4),
            n_first: 0,
            updates: mem.alloc::<fn(&W, f32)>(8),
            n_update: 0,
            lasts: mem.alloc::<fn(&W, f32)>(4),
            n_last: 0,
            alwayses: mem.alloc::<fn(&W, f32)>(8),
            n_always: 0,
            draws: mem.alloc::<fn(&W)>(8),
            n_draw: 0,
            title: title,
            width: width,
            height: height,
            min_w: 320,
            min_h: 180,
            resizable: true,
            gl: false,
            hidpi: false,
            video: "",
            paused: false,
            scale: 1,
            hot_save: mem.alloc::<fn(&W, &Save)>(0),
            hot_load: mem.alloc::<fn(&W, &Save)>(0),
            on_msg: mem.alloc::<fn(&W, []string)>(0),
            on_req: mem.alloc::<fn(&W, Request)>(0),
            splash_on: false,
            idle_on: true,
            splash_cards: mem.alloc::<string>(0),
        };
    }

    /// Shows the startup splash (`j3.game.splash`; same as `[splash] enabled = true`): `run` opens the window, shows the J3 logo while
    /// the startups run, then any `splashCard`s. Put heavy loading in a `startup`, not in `boot` (which
    /// runs before the window exists), and call `splash.tick()` between long steps to keep it moving.
    fn splash(this: &App<W>): &App<W> {
        this.splash_on = true;
        return this;
    }

    /// Adds an image (studio logo, publisher, ...) shown after the J3 logo and the `[splash] cards`; implies `splash`.
    fn splashCard(this: &App<W>, path: string): &App<W> {
        let n = this.splash_cards.len;
        let fresh = this.mem.alloc::<string>(n + 1);
        let i = 0;
        while i < n {
            fresh[i] = this.splash_cards[i];
            i += 1;
        }
        fresh[n] = path;
        this.splash_cards = fresh;
        this.splash_on = true;
        return this;
    }

    /// Asks for a high-DPI drawable on the next `run` (needs `useGl`): layout stays in logical pixels
    /// and drawing is scaled (`game.setHiDpi`). `J3_UI_SCALE=1.5` overrides the scale for testing.
    fn hiDpi(this: &App<W>): &App<W> {
        this.hidpi = true;
        return this;
    }

    /// Saves the player's Video settings in `path` (`j3.game.display`): `run` opens the window in the
    /// saved mode, resolution and monitor, with vsync and frame cap set. Missing file = the App's own size.
    fn displaySettings(this: &App<W>, path: string): &App<W> {
        this.video = path;
        return this;
    }

    /// Opens the window with no system title bar or border (`game.setDecorated(false)`), for an app
    /// that draws its own (`window-drag` in `.j3ui`). Still resizable from its edges and movable.
    fn undecorated(this: &App<W>): &App<W> {
        // before the window exists this only records, so the first frame is already undecorated
        game.setDecorated(false);
        return this;
    }

    /// Sets the window class (X11 `WM_CLASS`, Wayland `app_id`) the window opens with, so the desktop groups it
    /// under a `.desktop` file whose `StartupWMClass` is `name` (`game.setWindowClass`).
    fn windowClass(this: &App<W>, name: string): &App<W> {
        game.setWindowClass(name);
        return this;
    }

    /// Opens a see-through window (needs `useGl` and a compositor): pixels' alpha shows the desktop
    /// (`game.setTransparent`). Clear with `game.setBackgroundAlpha(a)` set, or draw backgrounds with alpha;
    /// text and opaque drawing stay opaque.
    fn transparent(this: &App<W>): &App<W> {
        game.setTransparent(true);
        return this;
    }

    /// Enables OpenGL window init on the next `run`.
    fn useGl(this: &App<W>): &App<W> {
        this.gl = true;
        return this;
    }

    /// A `.j3ui` app (a `Dom` rendering from a draw system) sleeps while nothing moves or arrives: no update, draw or swap until an input
    /// event, `Dom.requestFrame`, a `j3.thread.Queue` push (any thread), a UI timer (caret blink), `game.wakeAt(ms)` (timers in app
    /// logic) or a 250 ms safety tick. Motion keeps it awake by itself: CSS transitions and animations, and a `<canvas>` whose draws
    /// change from frame to frame (hand-drawn animation from `game.ticks()`, until it holds still for 50 ms; `j3c doc j3ui`, Idle frames). Default on; An app with any
    /// `first` / `add` / `last` / `always` system never sleeps; `false` is for visuals drawn outside the Dom with no system (3D in `draw`). Tests and captures never sleep
    /// (`j3c doc testing`).
    fn idleSkip(this: &App<W>, on: bool): &App<W> {
        this.idle_on = on;
        return this;
    }

    /// Appends a one-shot startup system.
    fn startup(this: &App<W>, sys: fn(&W)): &App<W> {
        if this.n_start >= this.startups.len {
            let cap = this.startups.len;
            let next = 4;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W)>(next);
            let i = 0;
            while i < this.n_start {
                fresh[i] = this.startups[i];
                i += 1;
            }
            this.startups = fresh;
        }
        this.startups[this.n_start] = sys;
        this.n_start = this.n_start + 1;
        return this;
    }

    /// Appends a shutdown callback (a module fn, no closures). Callbacks run once, in registration order,
    /// when the loop ends for any reason (window close, `game.requestQuit`, `--frames`, `J3_STEADY`), before
    /// `game.destroy`, so GL and the window are still alive. They do not run if the process aborts (`panic`).
    /// The list grows as needed; registering from inside a shutdown callback prints an error and is ignored.
    fn shutdown(this: &App<W>, sys: fn(&W)): &App<W> {
        if this.in_down {
            printLn("j3: App.shutdown called during shutdown; ignored");
            return this;
        }
        if this.n_down >= this.downs.len {
            let fresh = this.mem.alloc::<fn(&W)>(this.downs.len * 2 + 2);
            let i = 0;
            while i < this.n_down {
                fresh[i] = this.downs[i];
                i += 1;
            }
            this.downs = fresh;
        }
        this.downs[this.n_down] = sys;
        this.n_down = this.n_down + 1;
        return this;
    }

    /// Appends a fixed-tick system that runs before updates.
    fn first(this: &App<W>, sys: fn(&W, f32)): &App<W> {
        if this.n_first >= this.firsts.len {
            let cap = this.firsts.len;
            let next = 4;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W, f32)>(next);
            let i = 0;
            while i < this.n_first {
                fresh[i] = this.firsts[i];
                i += 1;
            }
            this.firsts = fresh;
        }
        this.firsts[this.n_first] = sys;
        this.n_first = this.n_first + 1;
        return this;
    }

    /// Appends a fixed-tick update system.
    fn add(this: &App<W>, sys: fn(&W, f32)): &App<W> {
        if this.n_update >= this.updates.len {
            let cap = this.updates.len;
            let next = 8;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W, f32)>(next);
            let i = 0;
            while i < this.n_update {
                fresh[i] = this.updates[i];
                i += 1;
            }
            this.updates = fresh;
        }
        this.updates[this.n_update] = sys;
        this.n_update = this.n_update + 1;
        return this;
    }

    /// Appends a fixed-tick system that runs after updates.
    fn last(this: &App<W>, sys: fn(&W, f32)): &App<W> {
        if this.n_last >= this.lasts.len {
            let cap = this.lasts.len;
            let next = 4;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W, f32)>(next);
            let i = 0;
            while i < this.n_last {
                fresh[i] = this.lasts[i];
                i += 1;
            }
            this.lasts = fresh;
        }
        this.lasts[this.n_last] = sys;
        this.n_last = this.n_last + 1;
        return this;
    }

    /// Appends a variable-dt system run every frame before fixed steps.
    fn always(this: &App<W>, sys: fn(&W, f32)): &App<W> {
        if this.n_always >= this.alwayses.len {
            let cap = this.alwayses.len;
            let next = 8;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W, f32)>(next);
            let i = 0;
            while i < this.n_always {
                fresh[i] = this.alwayses[i];
                i += 1;
            }
            this.alwayses = fresh;
        }
        this.alwayses[this.n_always] = sys;
        this.n_always = this.n_always + 1;
        return this;
    }

    /// Skip fixed steps while `on` is set. `always` and `draw` still run.
    fn pause(this: &App<W>, on: bool): &App<W> {
        this.paused = on;
        return this;
    }

    /// Scale the dt accumulated toward the next fixed step. `1` is realtime.
    fn timeScale(this: &App<W>, s: f32): &App<W> {
        this.scale = s;
        return this;
    }

    /// Appends a per-frame draw system.
    fn draw(this: &App<W>, sys: fn(&W)): &App<W> {
        if this.n_draw >= this.draws.len {
            let cap = this.draws.len;
            let next = 8;
            if cap != 0 {
                next = cap * 2;
            }
            let fresh = this.mem.alloc::<fn(&W)>(next);
            let i = 0;
            while i < this.n_draw {
                fresh[i] = this.draws[i];
                i += 1;
            }
            this.draws = fresh;
        }
        this.draws[this.n_draw] = sys;
        this.n_draw = this.n_draw + 1;
        return this;
    }

    /// Opt in to keeping app state across a `j3c run --hot` restart. `save` fills a `j3.data.save` blob just before the old
    /// process exits; `load` reads it back right after the new one's startups. Both only ever run in a hot restart
    /// (the first start and every other run, release builds included, call neither). Window position, size and mode
    /// are kept without this. Without the hook the app restarts fresh.
    fn hot(this: &App<W>, save: fn(&W, &Save), load: fn(&W, &Save)): &App<W> {
        this.hot_save = this.mem.alloc::<fn(&W, &Save)>(1);
        this.hot_save[0] = save;
        this.hot_load = this.mem.alloc::<fn(&W, &Save)>(1);
        this.hot_load[0] = load;
        return this;
    }

    /// Call `cb` with the arguments of each later copy of the program (its `args[0]` is the program), once per message,
    /// before the frame's systems. Needs `j3.instance.claim(name)` to have returned true in `main`.
    fn onMessage(this: &App<W>, cb: fn(&W, []string)): &App<W> {
        this.on_msg = this.mem.alloc::<fn(&W, []string)>(1);
        this.on_msg[0] = cb;
        return this;
    }

    /// Call `cb` with each request from `j3.instance.request` (once each, before the frame's systems). Reply with
    /// `req.reply(text)` now, or keep `req` and reply on a later frame. Needs `j3.instance.claim(name)` in `main`.
    fn onRequest(this: &App<W>, cb: fn(&W, Request)): &App<W> {
        this.on_req = this.mem.alloc::<fn(&W, Request)>(1);
        this.on_req[0] = cb;
        return this;
    }

    /// Opens the window, runs startups, then loops always/fixed/draw until quit.
    fn run(this: &App<W>) {
        let hot_quit = game.env("J3_HOT_QUIT");
        let hot_win = game.env("J3_HOT_WIN");
        let hot_state = game.env("J3_HOT_STATE");
        let hot_pos = false;
        let video = this.video;
        if hot_win.len > 0 && hotComplete(hot_win, this.mem) {
            video = hot_win;
            hot_pos = true;
        }
        let saved = display.current();
        if video.len > 0 {
            // Before the window exists this only records, so it opens in the saved mode.
            saved = display.loadAndApply(video, this.mem);
        }
        if this.gl {
            if this.hidpi { game.setHiDpi(true); }
            game.initGl(this.title, this.width, this.height);
        } else {
            game.init(this.title, this.width, this.height);
        }
        // `[dist] icon` when it is a PNG that loads, else the J3 logo.
        let icon = canvas.loadPng(appconfig.ICON, this.mem);
        if icon.w < 1 { icon = splash.logoIcon(this.mem); }
        game.setWindowIcon(icon);
        game.setResizable(this.resizable);
        game.setMinSize(this.min_w, this.min_h);
        if video.len > 0 { display.apply(&saved); }
        if hot_pos && saved.mode == game.WindowMode.Windowed {
            let wv = save.load(hot_win, this.mem);
            game.setWindowPos(save.getInt(&wv, "window.x", 0), save.getInt(&wv, "window.y", 0));
        }
        // A hot restart comes back without the splash.
        let show_splash = !hot_pos && (splash.forced() || ((this.splash_on || splash.configured()) && splash.wanted()));
        if show_splash { splash.begin(); }
        let i = 0;
        while i < this.n_start {
            let cb_start = this.startups[i];
            cb_start(&this.world);
            i += 1;
        }
        if hot_state.len > 0 && this.hot_load.len > 0 && hotComplete(hot_state, this.mem) {
            let hv = save.load(hot_state, this.mem);
            let cb_hot = this.hot_load[0];
            cb_hot(&this.world, &hv);
        }
        if show_splash { splash.finish(this.splash_cards); }
        let acc: f32 = 0;
        let sr = steadyRange();
        let st_a = sr[0];
        let st_b = sr[1];
        let st_laid = 0;
        let st_restyled = 0;
        let st_used = 0;
        let frame = 0;
        let st_rc = 0;
        let st_done = false;
        let loops = 0;
        let idle_stats = game.env("J3_IDLE_STATS").len > 0;
        while true {
            // Idle UI: sleep for an event or the next UI timer (`game.idleWait`), then run a frame as usual.
            if idleAllowed(this.idle_on, this.n_first + this.n_update + this.n_last + this.n_always) { game.idleWait(); }
            loops += 1;
            rewindScratch();
            frameHook();
            let dt = game.poll();
            if dt > MAX_FRAME {
                dt = MAX_FRAME;
            }
            if game.quitRequested() {
                break;
            }
            // Backgrounded (Android): no surface to draw on, so no update, draw or swap; sleep on events.
            if game.backgrounded() {
                game.waitBackground();
                continue;
            }
            // `j3c run --hot` asks for a restart by creating this file; looked for every 8th frame.
            if hotPoll() {
                break;
            }
            if this.on_msg.len > 0 {
                while instance.next() {
                    let cb_msg = this.on_msg[0];
                    cb_msg(&this.world, instance.args());
                }
            }
            if this.on_req.len > 0 {
                let more = true;
                while more {
                    match instance.nextRequest() {
                        Option.Some(req) {
                            let cb_req = this.on_req[0];
                            cb_req(&this.world, req);
                        }
                        Option.None { more = false; }
                    }
                }
            }
            i = 0;
            while i < this.n_always {
                let cb_always = this.alwayses[i];
                cb_always(&this.world, dt);
                i += 1;
            }
            if game.quitRequested() {
                break;
            }
            if !this.paused {
                acc = acc + dt * this.scale;
            }
            let steps = 0;
            while !this.paused && acc >= TICK && steps < MAX_STEPS {
                i = 0;
                while i < this.n_first {
                    let cb_first = this.firsts[i];
                    cb_first(&this.world, TICK);
                    i += 1;
                }
                i = 0;
                while i < this.n_update {
                    let cb_upd = this.updates[i];
                    cb_upd(&this.world, TICK);
                    i += 1;
                }
                i = 0;
                while i < this.n_last {
                    let cb_last = this.lasts[i];
                    cb_last(&this.world, TICK);
                    i += 1;
                }
                acc = acc - TICK;
                steps += 1;
            }
            let alpha = acc / TICK;
            if alpha < 0 {
                alpha = 0;
            }
            if alpha > 1 {
                alpha = 1;
            }
            game.setFrameAlpha(alpha);
            i = 0;
            while i < this.n_draw {
                let cb_draw = this.draws[i];
                cb_draw(&this.world);
                i += 1;
            }
            frame += 1;
            if st_b > 0 {
                if frame == st_a {
                    st_laid = laidTotal();
                    st_restyled = restyledTotal();
                    st_used = this.mem.used;
                } else if frame == st_b {
                    let dl = laidTotal() - st_laid;
                    let dr = restyledTotal() - st_restyled;
                    let dm = this.mem.used - st_used;
                    printLn(`steady layouts={dl} restyles={dr} arena_growth={dm}`);
                    if dl != 0 || dr != 0 || dm != 0 { st_rc = 1; }
                    st_done = true;
                    game.requestQuit();
                }
            }
            // `j3c run --frames N --screenshot FILE` stops and photographs in `game.present`.
            game.present();
        }
        if hot_quit.len > 0 && io.exists(hot_quit) {
            if hot_win.len > 0 {
                let cur = display.current();
                display.store(&cur, hot_win, this.mem);
                let pv = save.load(hot_win, this.mem);
                let pos = game.windowPos();
                save.putInt(&pv, "window.x", int(pos.x));
                save.putInt(&pv, "window.y", int(pos.y));
                hotStore(&pv, hot_win);
            }
            if hot_state.len > 0 && this.hot_save.len > 0 {
                let ov = save.empty(this.mem);
                let cb_hs = this.hot_save[0];
                cb_hs(&this.world, &ov);
                hotStore(&ov, hot_state);
            }
        }
        if idle_stats { printLn(`idle: loops={loops} presented={game.framesPresented()}`); }
        this.in_down = true;
        i = 0;
        while i < this.n_down {
            let cb_down = this.downs[i];
            cb_down(&this.world);
            i += 1;
        }
        game.destroy();
        rewindScratch();
        scratch(SCRATCH_CAP).destroy();
        this.mem.destroy();
        if st_b > 0 && !st_done {
            printLn(`steady: run ended at frame {frame} before {st_b}`);
            st_rc = 1;
        }
        if st_rc != 0 { exit(i32(st_rc)); }
    }
}
