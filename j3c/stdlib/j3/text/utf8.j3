// Part of j3.text: UTF-8 decoding and validation (RFC 3629: no overlong forms, no surrogates,
// nothing past U+10FFFF).

module j3.text;

/// The code point starting at `s[i]` and its byte length, or (0, 0) when the bytes there are not
/// valid UTF-8 (a bad lead byte, a missing or bad continuation, an overlong form, a surrogate,
/// past U+10FFFF, cut off by the end).
fn utf8At(s: string, i: int): (u32, int) {
    let b0 = u32(s[i]);
    if b0 < 0x80 { return (b0, 1); }
    let need = 0;
    let cp: u32 = 0;
    // the allowed range of the second byte rules out overlongs, surrogates and > U+10FFFF
    let lo: u32 = 0x80;
    let hi: u32 = 0xBF;
    if b0 >= 0xC2 && b0 <= 0xDF {
        need = 1;
        cp = b0 & 0x1F;
    } else if b0 >= 0xE0 && b0 <= 0xEF {
        need = 2;
        cp = b0 & 0x0F;
        if b0 == 0xE0 { lo = 0xA0; }
        if b0 == 0xED { hi = 0x9F; }
    } else if b0 >= 0xF0 && b0 <= 0xF4 {
        need = 3;
        cp = b0 & 0x07;
        if b0 == 0xF0 { lo = 0x90; }
        if b0 == 0xF4 { hi = 0x8F; }
    } else {
        return (0, 0);
    }
    if i + need >= s.len { return (0, 0); }
    for k in 1..need + 1 {
        let b = u32(s[i + k]);
        if b < lo || b > hi { return (0, 0); }
        lo = 0x80;
        hi = 0xBF;
        cp = (cp << 6) | (b & 0x3F);
    }
    return (cp, need + 1);
}

/// The code point starting at byte `i` of `s` (`i` below `s.len`) and its length in bytes. Bytes
/// that are not valid UTF-8 give U+FFFD with length 1, so each bad byte becomes one U+FFFD and
/// decoding goes on at the next byte (a sequence cut off by the end of `s` too).
pub fn decodeRune(s: string, i: int): (u32, int) {
    let (cp, n) = utf8At(s, i);
    if n == 0 { return (0xFFFD, 1); }
    return (cp, n);
}

/// Append `cp` as UTF-8 to `t` (the same as `t.pushChar(cp)`): a surrogate or a value past
/// U+10FFFF appends U+FFFD.
pub fn encodeRune(t: &Text, cp: u32) {
    t.pushChar(cp);
}

/// Whether all of `s` is valid UTF-8 (an encoded U+FFFD counts as valid).
pub fn isValidUtf8(s: string): bool {
    let i = 0;
    while i < s.len {
        let (_, n) = utf8At(s, i);
        if n == 0 { return false; }
        i += n;
    }
    return true;
}

/// The code points of a string, an iterator:
///
///     for cp in s.runes() { use(cp); }
///     let r = s.runes();
///     for cp in &r { use(cp, r.at); }    // r.at is the byte where cp starts
///
/// Bad bytes come out as U+FFFD, one per byte (see `decodeRune`).
pub struct Runes {
    /// The last code point `next` gave.
    cp: u32;
    /// Byte offset of `cp` in the string.
    at: int;
    s: string;
    pos: int;

    /// The next code point; `None` at the end.
    fn next(this: &Runes): Option<u32> {
        if this.pos >= this.s.len { return Option.None; }
        let (cp, n) = decodeRune(this.s, this.pos);
        this.cp = cp;
        this.at = this.pos;
        this.pos += n;
        return Option.Some(cp);
    }
}

/// A `Runes` cursor over `s`; with `use j3.text.runes;` also `s.runes()`.
pub fn runes(s: string): Runes {
    return Runes { cp: 0, at: 0, s: s, pos: 0 };
}
