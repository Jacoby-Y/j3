// Part of j3.text: reading integers and floats from text. Every function takes the whole string:
// no surrounding spaces, nothing after the number. A failure is `None`, never a panic.

module j3.text;

/// Value of digit `c` in bases up to 36 (`0-9`, `a-z`, `A-Z`), or 99.
fn digitValue(c: u8): int {
    if c >= '0' && c <= '9' { return int(c - '0'); }
    if c >= 'a' && c <= 'z' { return int(c - 'a') + 10; }
    if c >= 'A' && c <= 'Z' { return int(c - 'A') + 10; }
    return 99;
}

/// The digits of `s` from `i` in `base` as a u64 at most `limit`; None when there are no digits,
/// a byte is not a digit of `base`, or the value passes `limit`.
fn parseMag(s: string, i: int, base: int, limit: u64): Option<u64> {
    if base < 2 || base > 36 {
        panic("parseInt/parseU64: base must be 2..36");
    }
    if i >= s.len {
        return Option.None;
    }
    let b = u64(base);
    let n: u64 = 0;
    while i < s.len {
        let d = digitValue(s[i]);
        if d >= base {
            return Option.None;
        }
        // n * b + d <= limit
        if n > (limit - u64(d)) / b {
            return Option.None;
        }
        n = n * b + u64(d);
        i += 1;
    }
    return Option.Some(n);
}

/// `s` as an `int` in `base` (2..36; another base panics). An optional `+` or `-` comes first, then
/// one or more digits (`a`-`z` either case for 10-35). No `0x`/`0b` prefix, `_`, or spaces: pass
/// the base and strip those yourself. None for an empty string, a lone sign, a bad digit, or a
/// value outside the i64 range (`-9223372036854775808` reads).
pub fn parseInt(s: string, base: int): Option<int> {
    let neg = s.len > 0 && s[0] == '-';
    let start = if s.len > 0 && (s[0] == '-' || s[0] == '+') { 1 } else { 0 };
    let limit: u64 = if neg { u64(1) << 63 } else { (u64(1) << 63) - 1 };
    match parseMag(s, start, base, limit) {
        Option.Some(m) {
            if neg { return Option.Some(0 - int(m)); }
            return Option.Some(int(m));
        }
        Option.None { return Option.None; }
    }
}

/// `s` as a `u64` in `base` (2..36): digits only, no sign, prefix, `_`, or spaces. None for an
/// empty string, a bad digit, or a value past 18446744073709551615.
pub fn parseU64(s: string, base: int): Option<u64> {
    return parseMag(s, 0, base, ~u64(0));
}

/// Whether `s` from `i` is `word` in any letter case, to the end.
fn restIs(s: string, i: int, word: string): bool {
    if s.len - i != word.len { return false; }
    for k in 0..word.len {
        let c = s[i + k];
        if c >= 'A' && c <= 'Z' { c += 32; }
        if c != word[k] { return false; }
    }
    return true;
}

/// `s` as the f64 nearest to its exact decimal value (ties to even), so `writeF64` output reads
/// back to the same bits. Grammar: optional `+`/`-`, then digits with at most one `.` (at least
/// one digit, `.5` and `5.` read), then optionally `e`/`E`, a sign, and one or more digits; or
/// `inf`, `infinity`, `nan` in any case. None for anything else (spaces, `0x`, `_`, an empty
/// string). Too big gives an infinity and too small a zero, both signed, as C's `strtod` does.
pub fn parseF64(s: string): Option<f64> {
    let i = 0;
    let neg = false;
    if s.len > 0 && (s[0] == '-' || s[0] == '+') {
        neg = s[0] == '-';
        i = 1;
    }
    let signBit: u64 = if neg { u64(1) << 63 } else { 0 };
    if restIs(s, i, "inf") || restIs(s, i, "infinity") {
        return Option.Some(f64FromBits(signBit | 0x7FF0000000000000));
    }
    if restIs(s, i, "nan") {
        return Option.Some(f64FromBits(0x7FF8000000000000));
    }
    // up to 19 significant digits in `man`; `exp10` scales it; `trunc` if a nonzero digit was dropped
    let digitsStart = i;
    let man: u64 = 0;
    let kept = 0;
    let exp10 = 0;
    let trunc = false;
    let digits = 0;
    let dot = false;
    while i < s.len {
        let c = s[i];
        if c == '.' {
            if dot { return Option.None; }
            dot = true;
        } else if c >= '0' && c <= '9' {
            digits += 1;
            if kept < 19 {
                if man > 0 || c != '0' {
                    man = man * 10 + u64(c - '0');
                    kept += 1;
                }
                if dot { exp10 -= 1; }
            } else {
                if c != '0' { trunc = true; }
                if !dot { exp10 += 1; }
            }
        } else {
            break;
        }
        i += 1;
    }
    let digitsEnd = i;
    if digits == 0 {
        return Option.None;
    }
    let e = 0;
    if i < s.len && (s[i] == 'e' || s[i] == 'E') {
        i += 1;
        let eneg = false;
        if i < s.len && (s[i] == '-' || s[i] == '+') {
            eneg = s[i] == '-';
            i += 1;
        }
        if i >= s.len { return Option.None; }
        while i < s.len && s[i] >= '0' && s[i] <= '9' {
            // past 10^5 the result is 0 or infinity anyway
            if e < 100000 { e = e * 10 + int(s[i] - '0'); }
            i += 1;
        }
        if eneg { e = 0 - e; }
    }
    if i != s.len {
        return Option.None;
    }
    if man == 0 {
        return Option.Some(f64FromBits(signBit));
    }
    exp10 += e;
    let (bits, ok) = eiselLemire(man, exp10);
    if ok && trunc {
        // the dropped digits lie between man and man + 1: both must round the same way
        let (bits2, ok2) = eiselLemire(man + 1, exp10);
        ok = ok2 && bits2 == bits;
    }
    if !ok {
        bits = slowF64(s[digitsStart..digitsEnd], e);
    }
    return Option.Some(f64FromBits(bits | signBit));
}

/// The f64 bits nearest to `man * 10^exp10` (man > 0), by Eisel and Lemire's method (Lemire,
/// "Number Parsing at a Gigabyte per Second", 2021; Go's strconv). False when it cannot be sure:
/// a near tie, a subnormal or infinite result, or exp10 outside the table.
fn eiselLemire(man: u64, exp10: int): (u64, bool) {
    if exp10 < -348 || exp10 > 347 {
        return (0, false);
    }
    let clz = 0;
    while (man >> 63) == 0 {
        man = man << 1;
        clz += 1;
    }
    let retExp2 = ((217706 * exp10) >> 16) + 64 + 1023 - clz;
    let (pHi, pLo) = pow10At(exp10);
    let (xHi, xLo) = mul128(man, pHi);
    // the table entry is rounded down: when the low bits are all ones, look at the next 64 bits
    if (xHi & 0x1FF) == 0x1FF && xLo + man < man {
        let (yHi, yLo) = mul128(man, pLo);
        let mergedHi = xHi;
        let mergedLo = xLo + yHi;
        if mergedLo < xLo { mergedHi += 1; }
        if (mergedHi & 0x1FF) == 0x1FF && mergedLo + 1 == 0 && yLo + man < man {
            return (0, false);
        }
        xHi = mergedHi;
        xLo = mergedLo;
    }
    let msb = xHi >> 63;
    let retMan = xHi >> (msb + 9);
    retExp2 -= int(1 ^ msb);
    // exactly halfway between two floats: let the exact path decide
    if xLo == 0 && (xHi & 0x1FF) == 0 && (retMan & 3) == 1 {
        return (0, false);
    }
    retMan += retMan & 1;
    retMan = retMan >> 1;
    if (retMan >> 53) > 0 {
        retMan = retMan >> 1;
        retExp2 += 1;
    }
    if retExp2 <= 0 || retExp2 >= 0x7FF {
        return (0, false);
    }
    return ((u64(retExp2) << 52) | (retMan & ((u64(1) << 52) - 1)), true);
}
