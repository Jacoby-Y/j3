// Part of j3.text: string helpers (prefix, suffix, trim, search, replace) and the `split` and
// `lines` cursors. Strings are bytes; whitespace and case are ASCII. Results are views into the
// input unless they say otherwise.

module j3.text;

/// Whether `s` begins with `prefix` (always for an empty one).
pub fn startsWith(s: string, prefix: string): bool {
    return s.len >= prefix.len && s[0..prefix.len] == prefix;
}

/// Whether `s` ends with `suffix` (always for an empty one).
pub fn endsWith(s: string, suffix: string): bool {
    return s.len >= suffix.len && s[s.len - suffix.len..s.len] == suffix;
}

/// ASCII whitespace: space, tab, newline, vertical tab, form feed, carriage return.
pub fn isSpace(c: u8): bool {
    return c == ' ' || (c >= 9 && c <= 13);
}

/// `s` without ASCII whitespace at the start.
pub fn trimStart(s: string): string {
    let a = 0;
    while a < s.len && isSpace(s[a]) { a += 1; }
    return s[a..s.len];
}

/// `s` without ASCII whitespace at the end.
pub fn trimEnd(s: string): string {
    let b = s.len;
    while b > 0 && isSpace(s[b - 1]) { b -= 1; }
    return s[0..b];
}

/// `s` without ASCII whitespace at either end.
pub fn trim(s: string): string {
    return trimEnd(trimStart(s));
}

/// Byte index of the last `part` in `s`, or -1. An empty `part` is found at `s.len`.
pub fn lastIndexOf(s: string, part: string): int {
    let i = s.len - part.len;
    while i >= 0 {
        if s[i..i + part.len] == part { return i; }
        i -= 1;
    }
    return -1;
}

/// Append `s` with every `old` replaced by `new` (left to right, not overlapping) to `t`, and return
/// what was appended, a view into `t` like `fmtInt`. An empty `old` matches nothing.
pub fn replace(t: &Text, s: string, old: string, new: string): string {
    let start = t.bytes.len;
    let from = 0;
    if old.len > 0 {
        while true {
            let at = find(s[from..s.len], old);
            if at < 0 { break; }
            t.pushStr(s[from..from + at]);
            t.pushStr(new);
            from = from + at + old.len;
        }
    }
    t.pushStr(s[from..s.len]);
    return t.bytes[start..t.bytes.len] as string;
}

/// The pieces of `s` between each `sep`, as an iterator:
///
///     for part in text.split("a,,b", ",") { use(part); }     // "a", "", "b"
///
/// Every separator splits, so `n` separators give `n + 1` pieces: "" gives one empty piece, ",a,"
/// gives "", "a", "". An empty `sep` panics.
pub struct Split {
    s: string;
    sep: string;
    at: int;
    done: bool;

    /// The next piece, or None when there is none.
    fn next(this: &Split): Option<string> {
        if this.done { return Option.None; }
        let rest = this.s[this.at..this.s.len];
        let k = find(rest, this.sep);
        if k < 0 {
            this.done = true;
            return Option.Some(rest);
        }
        this.at += k + this.sep.len;
        return Option.Some(rest[0..k]);
    }
}

/// A `Split` cursor over `s` (see `Split`).
pub fn split(s: string, sep: string): Split {
    if sep.len == 0 {
        panic("split: the separator is empty");
    }
    return Split { s: s, sep: sep, at: 0, done: false };
}

/// The lines of `s`, each without its `\n` (or `\r\n`), as an iterator: `for line in lines(s) { }`.
/// A final line break ends the last line instead of starting an empty one: "a\nb\n" and "a\nb"
/// both give "a", "b"; "" gives none; "\n" gives one empty line.
pub struct Lines {
    s: string;
    at: int;

    /// The next line, or None at the end.
    fn next(this: &Lines): Option<string> {
        if this.at >= this.s.len { return Option.None; }
        let e = this.at;
        while e < this.s.len && this.s[e] != '\n' { e += 1; }
        let b = e;
        if b > this.at && this.s[b - 1] == '\r' { b -= 1; }
        let line = this.s[this.at..b];
        this.at = e + 1;
        return Option.Some(line);
    }
}

/// A `Lines` cursor over `s`.
pub fn lines(s: string): Lines {
    return Lines { s: s, at: 0 };
}
