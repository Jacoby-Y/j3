/// macOS j3.netsys. Same pub names as netsys.j3. libc, not Darwin syscall numbers.
/// Untested: no Mac in the loop when this was written. Darwin differences from Linux are the
/// leading `sin_len` byte, `O_NONBLOCK` via `fcntl`, and `errno` through `__error()`.

module j3.netsys;

use j3.text.Text;
use lib "c" as c {
    fn socket(domain: i32, kind: i32, proto: i32): i32;
    fn fcntl(fd: i32, cmd: i32, arg: i32): i32;
    fn bind(fd: i32, sa: ptr, len: u32): i32;
    fn sendto(fd: i32, buf: ptr, n: int, flags: i32, sa: ptr, len: u32): int;
    fn recvfrom(fd: i32, buf: ptr, n: int, flags: i32, sa: ptr, len: ptr): int;
    fn getsockname(fd: i32, sa: ptr, len: ptr): i32;
    fn close(fd: i32): i32;
    fn __error(): ptr;
}

/// Darwin `EAGAIN`.
const EAGAIN: int = 35;
/// `F_SETFL`.
const F_SETFL: int = 4;
/// Darwin `O_NONBLOCK`.
const O_NONBLOCK: int = 4;

/// `recvfrom` result: no datagram is waiting.
pub const NONE: int = 0 - 1;
/// Any call result: the OS refused.
pub const FAIL: int = 0 - 2;

/// A new non-blocking IPv4 UDP socket, or a negative number.
pub fn udp(): int {
    let fd = int(c.socket(2, 2, 0));
    if fd < 0 {
        return fd;
    }
    c.fcntl(i32(fd), i32(F_SETFL), i32(O_NONBLOCK));
    return fd;
}

/// Stamp the address family into a 16-byte `sockaddr_in` (Darwin: length byte, then family byte).
pub fn family(sa: []u8) {
    sa[0] = 16;
    sa[1] = 2;
}

/// Bind `fd` to the 16-byte `sockaddr_in` at `sa`. Negative on failure.
pub fn bind(fd: int, sa: ptr): int {
    return int(c.bind(i32(fd), sa, u32(16)));
}

/// Send `n` bytes of `buf` to the `sockaddr_in` at `sa`. Bytes sent, or `FAIL`.
pub fn sendto(fd: int, buf: ptr, n: int, sa: ptr): int {
    let r = c.sendto(i32(fd), buf, n, i32(0), sa, u32(16));
    if r < 0 {
        return FAIL;
    }
    return r;
}

/// Take one datagram into `buf` (cut at `n`) and write the sender to `sa`.
/// Bytes read, `NONE` when nothing is waiting, or `FAIL`.
pub fn recvfrom(fd: int, buf: ptr, n: int, sa: ptr): int {
    let len: u32 = 16;
    let r = c.recvfrom(i32(fd), buf, n, i32(0), sa, &len as ptr);
    if r < 0 {
        let e = c.__error() as &i32;
        if int(*e) == EAGAIN {
            return NONE;
        }
        return FAIL;
    }
    return r;
}

/// Write the address `fd` is bound to into `sa`. Negative on failure.
pub fn sockname(fd: int, sa: ptr): int {
    let len: u32 = 16;
    return int(c.getsockname(i32(fd), sa, &len as ptr));
}

/// Close the socket.
pub fn shut(fd: int) {
    c.close(i32(fd));
}

// TCP and DNS (`j3.net.tcp`, `j3.net.dns`) are Linux only for now: same pub names as netsys.j3, all fail.

/// TCP result: the wait ran past its timeout.
pub const TIMEOUT: int = 0 - 3;
/// `connectTimeout` result: nothing listens on that port.
pub const REFUSED: int = 0 - 4;
/// `lookup` result: the name does not exist.
pub const NO_NAME: int = 0 - 5;
/// `AF_INET`.
pub const AF_INET: int = 2;
/// `AF_INET6` (Linux value; unused here).
pub const AF_INET6: int = 10;
/// Bytes of the largest socket address `lookup` returns.
pub const SA_MAX: int = 28;

/// Not on this target yet: `FAIL`.
pub fn tcp(family: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn waitFd(fd: int, write: bool, ms: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn connectTimeout(fd: int, sa: ptr, len: int, ms: int): int { return FAIL; }
/// Not on this target yet: does nothing.
pub fn setTimeouts(fd: int, ms: int) {}
/// Not on this target yet: does nothing.
pub fn noDelay(fd: int) {}
/// Not on this target yet: `FAIL`.
pub fn listenOn(fd: int, sa: ptr, backlog: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn accept(fd: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn recv(fd: int, buf: ptr, n: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn send(fd: int, buf: ptr, n: int): int { return FAIL; }
/// Not on this target yet: `FAIL`.
pub fn lookup(host: cstr, port: int, out: []u8, lens: []int, fams: []int, max: int): int { return FAIL; }

/// Root certificate files to load one by one (Android only): none here, OpenSSL's default paths serve.
pub fn caFiles(t: &Text): int { return 0; }
