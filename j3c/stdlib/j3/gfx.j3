/// Buffer for shader and program info logs.
#[singleton]
let LOG: [2048]u8;

/// White border color for the shadow map (`GL_CLAMP_TO_BORDER`).
#[singleton]
let BORDER: [4]f32 = [1, 1, 1, 1];

/// Load a GL proc by name or panic.
fn load(name: string): ptr {
    let p = game.glProc(name);
    if p == 0 {
        panic(name);
    }
    return p;
}

/// Resolve all required OpenGL entry points into P.
fn loadProcs() {
    P.viewport = load("glViewport");
    P.clearColor = load("glClearColor");
    P.clear = load("glClear");
    P.enable = load("glEnable");
    P.disable = load("glDisable");
    P.depthFunc = load("glDepthFunc");
    P.cullFace = load("glCullFace");
    P.polygonOffset = load("glPolygonOffset");
    P.genTextures = load("glGenTextures");
    P.bindTexture = load("glBindTexture");
    P.texImage2D = load("glTexImage2D");
    P.texParameteri = load("glTexParameteri");
    P.texParameterfv = load("glTexParameterfv");
    P.texParameterf = load("glTexParameterf");
    P.generateMipmap = load("glGenerateMipmap");
    P.getFloatv = load("glGetFloatv");
    P.genFramebuffers = load("glGenFramebuffers");
    P.bindFramebuffer = load("glBindFramebuffer");
    P.framebufferTexture2D = load("glFramebufferTexture2D");
    P.checkFramebufferStatus = load("glCheckFramebufferStatus");
    P.drawBuffer = load("glDrawBuffer");
    P.readBuffer = load("glReadBuffer");
    P.genVertexArrays = load("glGenVertexArrays");
    P.bindVertexArray = load("glBindVertexArray");
    P.genBuffers = load("glGenBuffers");
    P.bindBuffer = load("glBindBuffer");
    P.bufferData = load("glBufferData");
    P.enableVertexAttribArray = load("glEnableVertexAttribArray");
    P.disableVertexAttribArray = load("glDisableVertexAttribArray");
    P.vertexAttribPointer = load("glVertexAttribPointer");
    P.vertexAttrib2f = load("glVertexAttrib2f");
    P.useProgram = load("glUseProgram");
    P.createShader = load("glCreateShader");
    P.shaderSource = load("glShaderSource");
    P.compileShader = load("glCompileShader");
    P.getShaderiv = load("glGetShaderiv");
    P.getShaderInfoLog = load("glGetShaderInfoLog");
    P.createProgram = load("glCreateProgram");
    P.attachShader = load("glAttachShader");
    P.linkProgram = load("glLinkProgram");
    P.getProgramiv = load("glGetProgramiv");
    P.getProgramInfoLog = load("glGetProgramInfoLog");
    P.deleteShader = load("glDeleteShader");
    P.getUniformLocation = load("glGetUniformLocation");
    P.uniform1i = load("glUniform1i");
    P.uniform1f = load("glUniform1f");
    P.uniform2f = load("glUniform2f");
    P.uniform3f = load("glUniform3f");
    P.uniformMatrix4fv = load("glUniformMatrix4fv");
    P.activeTexture = load("glActiveTexture");
    P.drawArrays = load("glDrawArrays");
    P.deleteBuffers = load("glDeleteBuffers");
    P.deleteVertexArrays = load("glDeleteVertexArrays");
    P.deleteTextures = load("glDeleteTextures");
    P.deleteFramebuffers = load("glDeleteFramebuffers");
    P.deleteProgram = load("glDeleteProgram");
}

/// glViewport.
fn glViewport(x: i32, y: i32, w: i32, h: i32) {
    let f = P.viewport as fn(i32, i32, i32, i32);
    f(x, y, w, h);
}

/// glClearColor.
fn glClearColor(r: f32, g: f32, b: f32, a: f32) {
    let f = P.clearColor as fn(f32, f32, f32, f32);
    f(r, g, b, a);
}

/// glClear.
fn glClear(mask: u32) {
    let f = P.clear as fn(u32);
    f(mask);
}

/// glEnable.
fn glEnable(cap: u32) {
    let f = P.enable as fn(u32);
    f(cap);
}

/// glDisable.
fn glDisable(cap: u32) {
    let f = P.disable as fn(u32);
    f(cap);
}

/// glDepthFunc.
fn glDepthFunc(func: u32) {
    let f = P.depthFunc as fn(u32);
    f(func);
}

/// glCullFace.
fn glCullFace(mode: u32) {
    let f = P.cullFace as fn(u32);
    f(mode);
}

/// glPolygonOffset.
fn glPolygonOffset(factor: f32, units: f32) {
    let f = P.polygonOffset as fn(f32, f32);
    f(factor, units);
}

/// glGenTextures.
fn glGenTextures(n: i32, ids: ptr) {
    let f = P.genTextures as fn(i32, ptr);
    f(n, ids);
}

/// glBindTexture.
fn glBindTexture(target: u32, tex: u32) {
    let f = P.bindTexture as fn(u32, u32);
    f(target, tex);
}

/// glTexImage2D.
fn glTexImage2D(
    target: u32,
    level: i32,
    internal: i32,
    w: i32,
    h: i32,
    border: i32,
    format: u32,
    ty: u32,
    data: ptr,
) {
    let f = P.texImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    f(target, level, internal, w, h, border, format, ty, data);
}

/// glTexParameteri.
fn glTexParameteri(target: u32, name: u32, param: i32) {
    let f = P.texParameteri as fn(u32, u32, i32);
    f(target, name, param);
}

/// glTexParameterfv.
fn glTexParameterfv(target: u32, name: u32, params: ptr) {
    let f = P.texParameterfv as fn(u32, u32, ptr);
    f(target, name, params);
}

/// glTexParameterf.
fn glTexParameterf(target: u32, name: u32, param: f32) {
    let f = P.texParameterf as fn(u32, u32, f32);
    f(target, name, param);
}

/// glGenerateMipmap.
fn glGenerateMipmap(target: u32) {
    let f = P.generateMipmap as fn(u32);
    f(target);
}

/// glGetFloatv.
fn glGetFloatv(name: u32, data: ptr) {
    let f = P.getFloatv as fn(u32, ptr);
    f(name, data);
}

/// Mipmaps plus a little anisotropy, so a flat surface does not alias into stripes.
fn finishColorTex() {
    glGenerateMipmap(GL_TEXTURE_2D);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    let maxA: f32 = 1;
    glGetFloatv(GL_MAX_TEXTURE_MAX_ANISOTROPY, &maxA as ptr);
    if maxA > 8 {
        maxA = 8;
    }
    if maxA > 1 {
        glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_MAX_ANISOTROPY, maxA);
    }
}

