/// Panic with the first n bytes of LOG.
fn dumpLog(n: i32) {
    if n < 1 {
        n = 1;
    }
    if n > 2047 {
        n = 2047;
    }
    panic([]u8 { ptr: &LOG[0], len: int(n) } as string);
}

/// Fetch a shader info log and panic with it.
fn shaderLog(sh: u32) {
    let n: i32 = 0;
    glGetShaderiv(sh, GL_INFO_LOG_LENGTH, &n as ptr);
    let wrote: i32 = 0;
    glGetShaderInfoLog(sh, 2048, &wrote as ptr, &LOG[0] as ptr);
    dumpLog(wrote);
}

/// Fetch a program info log and panic with it.
fn programLog(prog: u32) {
    let n: i32 = 0;
    glGetProgramiv(prog, GL_INFO_LOG_LENGTH, &n as ptr);
    let wrote: i32 = 0;
    glGetProgramInfoLog(prog, 2048, &wrote as ptr, &LOG[0] as ptr);
    dumpLog(wrote);
}

/// Compile a shader from source or panic.
fn compile(kind: u32, src: string): u32 {
    let sh = glCreateShader(kind);
    if sh == 0 {
        panic("glCreateShader");
    }
    let p: ptr = src.ptr as ptr;
    let n: i32 = i32(src.len);
    glShaderSource(sh, 1, &p as ptr, &n as ptr);
    glCompileShader(sh);
    let ok: i32 = 0;
    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok as ptr);
    if ok == 0 {
        shaderLog(sh);
    }
    return sh;
}

/// Link vertex and fragment shaders into a program.
fn link(vs: u32, fs: u32): u32 {
    let prog = glCreateProgram();
    if prog == 0 {
        panic("glCreateProgram");
    }
    glAttachShader(prog, vs);
    glAttachShader(prog, fs);
    glLinkProgram(prog);
    let ok: i32 = 0;
    glGetProgramiv(prog, GL_LINK_STATUS, &ok as ptr);
    if ok == 0 {
        programLog(prog);
    }
    glDeleteShader(vs);
    glDeleteShader(fs);
    return prog;
}

/// Uniform location for name in prog.
fn uloc(prog: u32, name: string): i32 {
    return glGetUniformLocation(prog, cstr(name));
}

/// Vertex shader source for the shadow depth pass.
fn depthVert(): string {
    return "#version 330 core\nlayout(location=0) in vec3 aPos;\nlayout(location=4) in vec2 aUv;\nuniform mat4 uLight;\nuniform mat4 uModel;\nout vec2 vUv;\nvoid main(){\n  vUv = aUv;\n  gl_Position = uLight * uModel * vec4(aPos, 1.0);\n}\n";
}

/// Fragment shader source for the shadow depth pass.
fn depthFrag(): string {
    return "#version 330 core\nin vec2 vUv;\nuniform sampler2D uAlbedo;\nuniform float uCutout;\nvoid main(){\n  if (uCutout > 0.5 && texture(uAlbedo, vUv).a < 0.5) discard;\n}\n";
}

/// Vertex shader source for the lit camera pass.
fn litVert(): string {
    return "#version 330 core\nlayout(location=0) in vec3 aPos;\nlayout(location=1) in vec3 aNrm;\nlayout(location=2) in vec3 aAlb;\nlayout(location=3) in float aEmi;\nlayout(location=4) in vec2 aUv;\nuniform mat4 uProj;\nuniform mat4 uView;\nuniform mat4 uModel;\nuniform mat4 uLight;\nuniform vec2 uNudge;\nout vec3 vPos;\nout vec3 vNrm;\nout vec3 vAlb;\nout float vEmi;\nout vec4 vShadow;\nout vec2 vUv;\nvoid main(){\n  vec4 world = uModel * vec4(aPos, 1.0);\n  vPos = world.xyz;\n  vNrm = mat3(uModel) * aNrm;\n  vAlb = aAlb;\n  vEmi = aEmi;\n  vUv = aUv;\n  vShadow = uLight * world;\n  gl_Position = uProj * uView * world;\n  gl_Position.xy += uNudge * gl_Position.w;\n}\n";
}

/// Fragment shader source for lit shading and fog.
fn litFrag(): string {
    return "#version 330 core\nin vec3 vPos;\nin vec3 vNrm;\nin vec3 vAlb;\nin float vEmi;\nin vec4 vShadow;\nin vec2 vUv;\nuniform vec3 uSun;\nuniform vec3 uSunColor;\nuniform vec3 uSky;\nuniform vec3 uEye;\nuniform sampler2DShadow uShadow;\nuniform sampler2D uAlbedo;\nuniform float uFogStart;\nuniform float uFogEnd;\nuniform float uCutout;\nuniform float uFlat;\nuniform vec3 uFlatColor;\nout vec4 oColor;\nvoid main(){\n  vec4 tex = texture(uAlbedo, vUv);\n  if (uCutout > 0.5 && tex.a < 0.5) discard;\n  if (uFlat > 0.5) {\n    float d = 0.06;\n    float ax = texture(uAlbedo, vUv + vec2(d, 0.0)).a;\n    float ay = texture(uAlbedo, vUv - vec2(d, 0.0)).a;\n    float bx = texture(uAlbedo, vUv + vec2(0.0, d)).a;\n    float by = texture(uAlbedo, vUv - vec2(0.0, d)).a;\n    if (ax > 0.5 && ay > 0.5 && bx > 0.5 && by > 0.5) discard;\n    oColor = vec4(uFlatColor, 1.0);\n    return;\n  }\n  vec3 alb = vAlb * tex.rgb;\n  if (vEmi > 0.5) {\n    oColor = vec4(alb, 1.0);\n    return;\n  }\n  vec3 N = normalize(vNrm);\n  vec3 L = normalize(uSun);\n  float ndl = max(dot(N, L), 0.0);\n  vec3 proj = vShadow.xyz / max(vShadow.w, 0.0001);\n  proj = proj * 0.5 + 0.5;\n  float dz = max(abs(dFdx(proj.z)), abs(dFdy(proj.z)));\n  float du = max(length(vec2(dFdx(proj.x), dFdy(proj.x))), length(vec2(dFdx(proj.y), dFdy(proj.y))));\n  float bias = clamp(dz / max(du, 0.0000001) * (2.0 / 2048.0), 0.0004, 0.01);\n  float vis = 0.0;\n  vec2 texel = vec2(1.0 / 2048.0);\n  for (int x = -1; x <= 1; x++) {\n    for (int y = -1; y <= 1; y++) {\n      vis += texture(uShadow, vec3(proj.xy + vec2(float(x), float(y)) * texel, proj.z - bias));\n    }\n  }\n  vis /= 9.0;\n  if (proj.z > 1.0 || proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0) {\n    vis = 1.0;\n  }\n  float hemi = N.y * 0.5 + 0.5;\n  vec3 ambient = mix(uSky * 0.35, uSky, hemi);\n  vec3 sunCol = uSunColor;\n  vec3 rgb = alb * (ambient + sunCol * ndl * vis);\n  float dist = length(vPos - uEye);\n  float fog = clamp((dist - uFogStart) / max(uFogEnd - uFogStart, 0.001), 0.0, 1.0);\n  rgb = mix(rgb, uSky, fog);\n  oColor = vec4(rgb, 1.0);\n}\n";
}

/// Create the 2048 depth texture and shadow framebuffer.
fn makeShadow() {
    let tex: u32 = 0;
    glGenTextures(1, &tex as ptr);
    if tex == 0 {
        panic("glGenTextures");
    }
    glBindTexture(GL_TEXTURE_2D, tex);
    glTexImage2D(
        GL_TEXTURE_2D,
        0,
        GL_DEPTH_COMPONENT24,
        SHADOW,
        SHADOW,
        0,
        GL_DEPTH_COMPONENT,
        GL_UNSIGNED_INT,
        0,
    );
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_BORDER);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_BORDER);
    glTexParameterfv(GL_TEXTURE_2D, GL_TEXTURE_BORDER_COLOR, &BORDER[0] as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_FUNC, i32(GL_LEQUAL));
    let fbo: u32 = 0;
    glGenFramebuffers(1, &fbo as ptr);
    if fbo == 0 {
        panic("glGenFramebuffers");
    }
    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, tex, 0);
    glDrawBuffer(GL_NONE);
    glReadBuffer(GL_NONE);
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        panic("shadow framebuffer");
    }
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
    G.shadowTex = tex;
    G.shadowFbo = fbo;
}

/// 1×1 opaque white texture used when no albedo is bound.
fn makeWhite() {
    let px: [4]u8 = [255, 255, 255, 255];
    let tex: u32 = 0;
    glGenTextures(1, &tex as ptr);
    if tex == 0 {
        panic("glGenTextures");
    }
    glBindTexture(GL_TEXTURE_2D, tex);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, &px[0] as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
    finishColorTex();
    G.white = tex;
    G.albedo = tex;
}

/// Bind the current albedo on texture unit 1.
fn bindAlbedo() {
    let tex = G.albedo;
    if tex == 0 {
        tex = G.white;
    }
    glActiveTexture(GL_TEXTURE1);
    glBindTexture(GL_TEXTURE_2D, tex);
    glActiveTexture(GL_TEXTURE0);
}

/// Enable pos/normal/albedo/emi, and uv when `uv` is set.
fn bindLayout(stride: i32, uv: bool) {
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glEnableVertexAttribArray(3);
    glVertexAttribPointer(0, 3, GL_FLOAT, 0, stride, 0 as ptr);
    glVertexAttribPointer(1, 3, GL_FLOAT, 0, stride, 12 as ptr);
    glVertexAttribPointer(2, 3, GL_FLOAT, 0, stride, 24 as ptr);
    glVertexAttribPointer(3, 1, GL_FLOAT, 0, stride, 36 as ptr);
    if uv {
        glEnableVertexAttribArray(4);
        glVertexAttribPointer(4, 2, GL_FLOAT, 0, stride, 40 as ptr);
    } else {
        glDisableVertexAttribArray(4);
    }
}

/// 12 when the buffer is UV-only, 10 when it matches the untextured layout, else 0.
/// A length divisible by both stays 10 so voxel faces (6 verts × 10 floats) stay untextured.
fn pickStride(n: int): int {
    let by12 = n >= 12 && n - (n / 12) * 12 == 0;
    let by10 = n >= 10 && n - (n / 10) * 10 == 0;
    if by12 && !by10 {
        return 12;
    }
    if by10 {
        return 10;
    }
    return 0;
}

/// Upload interleaved vertex floats as STATIC_DRAW.
fn fillBuffer(verts: []f32) {
    glBufferData(GL_ARRAY_BUFFER, verts.len * 4, verts.ptr as ptr, GL_STATIC_DRAW);
}

/// Panic unless gfx.init has completed.
fn ensure() {
    if !G.ready {
        panic("gfx.init");
    }
}

/// Load GL procs, compile shaders, build the shadow map, and enable depth.
pub fn init() {
    if G.ready {
        return;
    }
    loadProcs();
    G.depth = link(compile(GL_VERTEX_SHADER, depthVert()), compile(GL_FRAGMENT_SHADER, depthFrag()));
    G.lit = link(compile(GL_VERTEX_SHADER, litVert()), compile(GL_FRAGMENT_SHADER, litFrag()));
    G.dLight = uloc(G.depth, "uLight");
    G.dModel = uloc(G.depth, "uModel");
    G.lProj = uloc(G.lit, "uProj");
    G.lView = uloc(G.lit, "uView");
    G.lModel = uloc(G.lit, "uModel");
    G.lLight = uloc(G.lit, "uLight");
    G.lSun = uloc(G.lit, "uSun");
    G.lSunColor = uloc(G.lit, "uSunColor");
    G.lSky = uloc(G.lit, "uSky");
    G.lEye = uloc(G.lit, "uEye");
    G.lShadow = uloc(G.lit, "uShadow");
    G.lFog0 = uloc(G.lit, "uFogStart");
    G.lFog1 = uloc(G.lit, "uFogEnd");
    G.dAlbedo = uloc(G.depth, "uAlbedo");
    G.dCutout = uloc(G.depth, "uCutout");
    G.lAlbedo = uloc(G.lit, "uAlbedo");
    G.lCutout = uloc(G.lit, "uCutout");
    G.lFlat = uloc(G.lit, "uFlat");
    G.lFlatColor = uloc(G.lit, "uFlatColor");
    G.lNudge = uloc(G.lit, "uNudge");
    makeShadow();
    makeWhite();
    glVertexAttrib2f(4, 0, 0);
    glUseProgram(G.depth);
    glUniform1i(G.dAlbedo, 1);
    glUniform1f(G.dCutout, 0);
    glUseProgram(G.lit);
    glUniform1i(G.lAlbedo, 1);
    glUniform1i(G.lShadow, 0);
    glUniform1f(G.lCutout, 0);
    glUniform1f(G.lFlat, 0);
    glUniform2f(G.lNudge, 0, 0);
    glEnable(GL_DEPTH_TEST);
    glDepthFunc(GL_LEQUAL);
    glEnable(GL_CULL_FACE);
    game.setGlShutdown(shutdown);
    G.ready = true;
    G.pass = PASS_NONE;
}

/// Delete programs and the shadow map; clear ready state.
pub fn shutdown() {
    if !G.ready {
        return;
    }
    if G.depth != 0 {
        glDeleteProgram(G.depth);
        G.depth = 0;
    }
    if G.lit != 0 {
        glDeleteProgram(G.lit);
        G.lit = 0;
    }
    if G.shadowFbo != 0 {
        let fbo = G.shadowFbo;
        glDeleteFramebuffers(1, &fbo as ptr);
        G.shadowFbo = 0;
    }
    if G.shadowTex != 0 {
        let tex = G.shadowTex;
        glDeleteTextures(1, &tex as ptr);
        G.shadowTex = 0;
    }
    if G.white != 0 {
        let white = G.white;
        glDeleteTextures(1, &white as ptr);
        G.white = 0;
        G.albedo = 0;
    }
    G.ready = false;
    G.pass = PASS_NONE;
}

/// Upload interleaved verts as a new mesh.
/// 10 floats per vertex is untextured. 12 is textured, when that length is not also a multiple of 10.
/// A length divisible by both is untextured, so voxel faces keep their layout. Use `uploadUv` to force u v.
pub fn upload(verts: []f32): Mesh {
    let stride = pickStride(verts.len);
    if stride == 0 {
        panic("gfx.upload");
    }
    return uploadStride(verts, stride);
}

/// Upload a `# j3mesh 2` buffer (12 floats per vertex), including lengths also divisible by 10.
pub fn uploadUv(verts: []f32): Mesh {
    if verts.len < 12 || verts.len - (verts.len / 12) * 12 != 0 {
        panic("gfx.uploadUv");
    }
    return uploadStride(verts, 12);
}

/// Upload `verts` with an explicit float stride of 10 or 12.
fn uploadStride(verts: []f32, stride: int): Mesh {
    ensure();
    let vao: u32 = 0;
    let vbo: u32 = 0;
    glGenVertexArrays(1, &vao as ptr);
    glGenBuffers(1, &vbo as ptr);
    if vao == 0 || vbo == 0 {
        panic("gfx.upload");
    }
    glBindVertexArray(vao);
    glBindBuffer(GL_ARRAY_BUFFER, vbo);
    fillBuffer(verts);
    let bytes: i32 = 40;
    let uv = false;
    if stride == 12 {
        bytes = STRIDE12;
        uv = true;
    }
    bindLayout(bytes, uv);
    glBindVertexArray(0);
    return Mesh {
        vao: vao,
        vbo: vbo,
        count: verts.len / stride,
    };
}

/// Replace a `# j3mesh 2` buffer. Use this when the float count is also a multiple of 10.
pub fn updateUv(mesh: &Mesh, verts: []f32) {
    ensure();
    if mesh.vbo == 0 || verts.len < 12 || verts.len - (verts.len / 12) * 12 != 0 {
        panic("gfx.updateUv");
    }
    glBindVertexArray(mesh.vao);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.vbo);
    fillBuffer(verts);
    bindLayout(STRIDE12, true);
    mesh.count = verts.len / 12;
    glBindVertexArray(0);
}

/// Replace a mesh VBO contents and vertex count. Stride follows `upload`.
pub fn update(mesh: &Mesh, verts: []f32) {
    ensure();
    if mesh.vbo == 0 {
        panic("gfx.update");
    }
    let stride = pickStride(verts.len);
    if stride == 0 {
        panic("gfx.update");
    }
    glBindVertexArray(mesh.vao);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.vbo);
    fillBuffer(verts);
    let bytes: i32 = 40;
    let uv = false;
    if stride == 12 {
        bytes = STRIDE12;
        uv = true;
    }
    bindLayout(bytes, uv);
    mesh.count = verts.len / stride;
    glBindVertexArray(0);
}

/// Delete a mesh VAO/VBO and zero its fields.
pub fn free(mesh: &Mesh) {
    if mesh.vbo != 0 {
        let vbo = mesh.vbo;
        glDeleteBuffers(1, &vbo as ptr);
        mesh.vbo = 0;
    }
    if mesh.vao != 0 {
        let vao = mesh.vao;
        glDeleteVertexArrays(1, &vao as ptr);
        mesh.vao = 0;
    }
    mesh.count = 0;
}

/// Upload a mat4 uniform.
fn uMat(loc: i32, m: Mat4) {
    glUniformMatrix4fv(loc, 1, 0, &m.m[0] as ptr);
}

/// Expand an AABB by transforming point p through m.
fn grow(m: Mat4, p: Vec3, minx: &f32, maxx: &f32, miny: &f32, maxy: &f32, minz: &f32, maxz: &f32) {
    let q = m.transformPoint(p);
    if q.x < *minx {
        *minx = q.x;
    }
    if q.x > *maxx {
        *maxx = q.x;
    }
    if q.y < *miny {
        *miny = q.y;
    }
    if q.y > *maxy {
        *maxy = q.y;
    }
    if q.z < *minz {
        *minz = q.z;
    }
    if q.z > *maxz {
        *maxz = q.z;
    }
}

/// Orthographic light matrix fitting the world AABB around sun.
fn fitLight(sun: Vec3, lo: Vec3, hi: Vec3): Mat4 {
    let mid = Vec3.xyz((lo.x + hi.x) * 0.5, (lo.y + hi.y) * 0.5, (lo.z + hi.z) * 0.5);
    let rad = (hi - lo).length() * 0.5 + 2;
    if rad < 1 {
        rad = 1;
    }
    let dir = sun.normalize();
    let eye = mid + dir * (rad + 4);
    let up = Vec3.up();
    if abs(dir.dot(up)) > 0.9 {
        up = Vec3.xyz(1, 0, 0);
    }
    let view = Mat4.lookAt(eye, mid, up);
    let first = view.transformPoint(lo);
    let minx = first.x;
    let maxx = first.x;
    let miny = first.y;
    let maxy = first.y;
    let minz = first.z;
    let maxz = first.z;
    grow(view, Vec3.xyz(hi.x, lo.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, hi.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, hi.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, lo.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, lo.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, hi.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, hi.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    let pad: f32 = 2;
    return Mat4.ortho(minx - pad, maxx + pad, miny - pad, maxy + pad, f32(0) - maxz - pad, f32(0) - minz + pad).mul(view);
}

/// Begin the shadow depth pass for the given sun and world bounds.
pub fn shadowPass(sun: Vec3, boundsMin: Vec3, boundsMax: Vec3) {
    ensure();
    G.sun = sun.normalize();
    G.light = fitLight(G.sun, boundsMin, boundsMax);
    G.pass = PASS_SHADOW;
    glBindFramebuffer(GL_FRAMEBUFFER, G.shadowFbo);
    glViewport(0, 0, SHADOW, SHADOW);
    glEnable(GL_POLYGON_OFFSET_FILL);
    glPolygonOffset(4, 4);
    glCullFace(GL_BACK);
    glClear(GL_DEPTH_BUFFER_BIT);
    glUseProgram(G.depth);
    uMat(G.dLight, G.light);
}

/// Begin the lit camera pass from an orbit camera.
pub fn cameraPass(cam: Orbit, sun: Vec3, sky: Vec3, sunColor: Vec3) {
    beginCamera(cam.eye(), cam.view(), sun, sky, sunColor);
}

/// Begin the lit camera pass from a look camera.
pub fn cameraPassLook(cam: Look, sun: Vec3, sky: Vec3, sunColor: Vec3) {
    beginCamera(cam.eye, cam.view(), sun, sky, sunColor);
}

/// Shared camera-pass setup: viewport, clear, uniforms, and shadow bind.
fn beginCamera(eye: Vec3, view: Mat4, sun: Vec3, sky: Vec3, sunColor: Vec3) {
    ensure();
    G.sun = sun.normalize();
    G.sky = sky;
    G.sunColor = sunColor;
    G.eye = eye;
    G.view = view;
    let sz = game.windowSize();
    let w = i32(sz.x);
    let h = i32(sz.y);
    if h < 1 {
        h = 1;
    }
    let aspect = sz.x / sz.y;
    if aspect < 0.1 {
        aspect = 0.1;
    }
    let near = G.clipNear;
    if near < 0.01 {
        near = f32(15) / f32(100);
    }
    G.proj = Mat4.perspective(fov(), aspect, near, G.clipFar);
    G.pass = PASS_CAMERA;
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
    glViewport(0, 0, w, h);
    glDisable(GL_POLYGON_OFFSET_FILL);
    glCullFace(GL_BACK);
    glClearColor(sky.x, sky.y, sky.z, 1);
    glClear(GL_COLOR_BUFFER_BIT + GL_DEPTH_BUFFER_BIT);
    glUseProgram(G.lit);
    uMat(G.lProj, G.proj);
    uMat(G.lView, G.view);
    uMat(G.lLight, G.light);
    glUniform3f(G.lSun, G.sun.x, G.sun.y, G.sun.z);
    glUniform3f(G.lSunColor, sunColor.x, sunColor.y, sunColor.z);
    glUniform3f(G.lSky, sky.x, sky.y, sky.z);
    glUniform3f(G.lEye, G.eye.x, G.eye.y, G.eye.z);
    glUniform1f(G.lFog0, G.fogStart);
    glUniform1f(G.lFog1, G.fogEnd);
    G.albedo = G.white;
    bindAlbedo();
    glActiveTexture(GL_TEXTURE0);
    glBindTexture(GL_TEXTURE_2D, G.shadowTex);
    glUniform1i(G.lShadow, 0);
}

/// Draw a mesh in the current shadow or camera pass. Opaque, back faces culled.
pub fn draw(mesh: Mesh, model: Mat4) {
    drawMesh(mesh, model, false, 0, Vec3.xyz(0, 0, 0), 0, 0);
}

/// Draw a mesh with alpha below 0.5 discarded and both sides visible.
/// The shadow pass discards the same texels, so a card does not cast a solid rectangle.
pub fn drawCutout(mesh: Mesh, model: Mat4) {
    drawMesh(mesh, model, true, 0, Vec3.xyz(0, 0, 0), 0, 0);
}

/// Unlit rim in `color`, following the albedo's alpha edge. No-op outside the camera pass.
pub fn drawMark(mesh: Mesh, model: Mat4, color: Vec3) {
    if G.pass != PASS_CAMERA {
        return;
    }
    glEnable(GL_POLYGON_OFFSET_FILL);
    glPolygonOffset(-2, -2);
    drawMesh(mesh, model, true, 1, color, 0, 0);
    glDisable(GL_POLYGON_OFFSET_FILL);
}

/// Shared draw for opaque and cutout meshes. `flat` above 0.5 replaces lighting with `color`.
fn drawMesh(mesh: Mesh, model: Mat4, cutout: bool, flat: f32, color: Vec3, nx: f32, ny: f32) {
    ensure();
    if G.pass == PASS_NONE {
        panic("gfx.draw");
    }
    if mesh.vbo == 0 || mesh.count <= 0 {
        panic("gfx.draw");
    }
    let cut: f32 = 0;
    if cutout {
        cut = 1;
        glDisable(GL_CULL_FACE);
    }
    bindAlbedo();
    if G.pass == PASS_SHADOW {
        glUseProgram(G.depth);
        uMat(G.dLight, G.light);
        uMat(G.dModel, model);
        glUniform1i(G.dAlbedo, 1);
        glUniform1f(G.dCutout, cut);
    } else {
        glUseProgram(G.lit);
        uMat(G.lProj, G.proj);
        uMat(G.lView, G.view);
        uMat(G.lLight, G.light);
        uMat(G.lModel, model);
        glUniform3f(G.lSun, G.sun.x, G.sun.y, G.sun.z);
        glUniform3f(G.lSunColor, G.sunColor.x, G.sunColor.y, G.sunColor.z);
        glUniform3f(G.lSky, G.sky.x, G.sky.y, G.sky.z);
        glUniform3f(G.lEye, G.eye.x, G.eye.y, G.eye.z);
        glUniform1f(G.lFog0, G.fogStart);
        glUniform1f(G.lFog1, G.fogEnd);
        glActiveTexture(GL_TEXTURE0);
        glBindTexture(GL_TEXTURE_2D, G.shadowTex);
        glUniform1i(G.lShadow, 0);
        glUniform1i(G.lAlbedo, 1);
        glUniform1f(G.lCutout, cut);
        glUniform1f(G.lFlat, flat);
        glUniform3f(G.lFlatColor, color.x, color.y, color.z);
        glUniform2f(G.lNudge, nx, ny);
    }
    glBindVertexArray(mesh.vao);
    glDrawArrays(GL_TRIANGLES, 0, i32(mesh.count));
    glBindVertexArray(0);
    if cutout {
        glEnable(GL_CULL_FACE);
    }
}

/// Upload tightly packed RGBA8 pixels. Panics if the buffer is short.
pub fn tex(pixels: []u8, w: i32, h: i32): Tex {
    ensure();
    if w < 1 || h < 1 || pixels.len < int(w) * int(h) * 4 {
        panic("gfx.tex");
    }
    let id: u32 = 0;
    glGenTextures(1, &id as ptr);
    if id == 0 {
        panic("gfx.tex");
    }
    glBindTexture(GL_TEXTURE_2D, id);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.ptr as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
    finishColorTex();
    return Tex { id: id, w: w, h: h };
}

/// Delete a texture uploaded with `tex`.
pub fn freeTex(image: &Tex) {
    if image.id != 0 {
        let id = image.id;
        glDeleteTextures(1, &id as ptr);
        image.id = 0;
    }
}

/// Bind `image` as the albedo until the next `albedo` or camera pass.
/// The camera pass resets the bind to the white texture.
pub fn albedo(image: Tex) {
    ensure();
    if image.id == 0 {
        G.albedo = G.white;
    } else {
        G.albedo = image.id;
    }
    bindAlbedo();
}

/// Fog distances used by the next camera pass. Defaults are 40 and 120.
pub fn setFog(start: f32, end: f32) {
    G.fogStart = start;
    G.fogEnd = end;
}

/// Perspective clip planes used by the next camera pass. Defaults are 0.15 and 200.
pub fn setClip(near: f32, far: f32) {
    if near < 0.01 {
        near = 0.01;
    }
    if far <= near {
        far = near + f32(1);
    }
    G.clipNear = near;
    G.clipFar = far;
}

/// World ray through the mouse for an orbit camera. Same fov as the camera pass.
pub fn mouseRay(cam: Orbit): Ray {
    let eye = cam.eye();
    let forward = (cam.target - eye).normalize();
    let right = forward.cross(Vec3.up()).normalize();
    let up = right.cross(forward);
    return Ray {
        origin: eye,
        dir: pointerDir(forward, right, up),
    };
}

/// World ray through the mouse for a look camera. Same fov as the camera pass.
pub fn mouseRayLook(cam: Look): Ray {
    let forward = cam.forward();
    let right = cam.right();
    let up = right.cross(forward);
    return Ray {
        origin: cam.eye,
        dir: pointerDir(forward, right, up),
    };
}

/// Unit direction from the camera basis through the current mouse position.
fn pointerDir(forward: Vec3, right: Vec3, up: Vec3): Vec3 {
    let sz = game.windowSize();
    let w = sz.x;
    let h = sz.y;
    if w < 1 {
        w = 1;
    }
    if h < 1 {
        h = 1;
    }
    let aspect = w / h;
    if aspect < 0.1 {
        aspect = 0.1;
    }
    let mp = game.mousePos();
    let nx = mp.x / w * f32(2) - f32(1);
    let ny = f32(1) - mp.y / h * f32(2);
    let th = tan(fov() / f32(2));
    let dx = nx * aspect * th;
    let dy = ny * th;
    let dir = right * dx + up * dy + forward;
    return dir.normalize();
}

/// One slab of an AABB ray test. Updates the running near and far distances.
fn axisSlab(o: f32, d: f32, lo: f32, hi: f32, tmin: &f32, tmax: &f32): bool {
    if abs(d) < 0.0000001 {
        if o < lo || o > hi {
            return false;
        }
        return true;
    }
    let inv = f32(1) / d;
    let a = (lo - o) * inv;
    let b = (hi - o) * inv;
    let nearT = a;
    let farT = b;
    if a > b {
        nearT = b;
        farT = a;
    }
    if nearT > *tmin {
        *tmin = nearT;
    }
    if farT < *tmax {
        *tmax = farT;
    }
    return *tmin <= *tmax;
}

/// First hit of the ray against an AABB, within `reach`. A miss has `ok == false`.
/// An origin inside the box hits at `t == 0`.
pub fn rayAabb(origin: Vec3, dir: Vec3, lo: Vec3, hi: Vec3, reach: f32): RayHit {
    let miss = RayHit { ok: false, t: 0 };
    if reach < 0 {
        return miss;
    }
    let tmin: f32 = 0;
    let tmax = reach;
    if !axisSlab(origin.x, dir.x, lo.x, hi.x, &tmin, &tmax) {
        return miss;
    }
    if !axisSlab(origin.y, dir.y, lo.y, hi.y, &tmin, &tmax) {
        return miss;
    }
    if !axisSlab(origin.z, dir.z, lo.z, hi.z, &tmin, &tmax) {
        return miss;
    }
    if tmax < 0 {
        return miss;
    }
    let t = tmin;
    if t < 0 {
        t = 0;
    }
    return RayHit { ok: true, t: t };
}

/// Write one interleaved vertex (pos, normal, albedo, emi) and return the next index.
fn pushVert(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    nx: f32,
    ny: f32,
    nz: f32,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
): int {
    out[at] = x;
    out[at + 1] = y;
    out[at + 2] = z;
    out[at + 3] = nx;
    out[at + 4] = ny;
    out[at + 5] = nz;
    out[at + 6] = r;
    out[at + 7] = g;
    out[at + 8] = b;
    out[at + 9] = emi;
    return at + 10;
}

/// Append six verts for one unit-cube face; returns the next write index.
pub fn emitFace(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    dir: int,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
): int {
    let x1 = x + 1;
    let y1 = y + 1;
    let z1 = z + 1;
    let nx: f32 = 0;
    let ny: f32 = 0;
    let nz: f32 = 0;
    if dir == FACE_PY {
        ny = 1;
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_NY {
        ny = f32(0) - 1;
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_PZ {
        nz = 1;
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_NZ {
        nz = f32(0) - 1;
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_PX {
        nx = 1;
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    nx = f32(0) - 1;
    at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
    return pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
}

/// Unit normal for a FACE_* direction.
fn faceNormal(dir: int): Vec3 {
    if dir == FACE_PY {
        return Vec3.xyz(0, 1, 0);
    }
    if dir == FACE_NY {
        return Vec3.xyz(0, f32(0) - 1, 0);
    }
    if dir == FACE_PX {
        return Vec3.xyz(1, 0, 0);
    }
    if dir == FACE_NX {
        return Vec3.xyz(f32(0) - 1, 0, 0);
    }
    if dir == FACE_PZ {
        return Vec3.xyz(0, 0, 1);
    }
    return Vec3.xyz(0, 0, f32(0) - 1);
}

// Corner i is (u,v): 0 (0,0), 1 (1,0), 2 (1,1), 3 (0,1). Same order as `voxel.corners`.
/// World-space corner i of a unit-cube face.
fn faceCorner(x: f32, y: f32, z: f32, dir: int, i: int): Vec3 {
    let u: f32 = 0;
    let v: f32 = 0;
    if i == 1 || i == 2 {
        u = 1;
    }
    if i == 2 || i == 3 {
        v = 1;
    }
    let px = x;
    let py = y;
    let pz = z;
    if dir == FACE_PY {
        px = x + u;
        py = y + 1;
        pz = z + v;
    } else if dir == FACE_NY {
        px = x + u;
        py = y;
        pz = z + v;
    } else if dir == FACE_PX {
        px = x + 1;
        py = y + v;
        pz = z + u;
    } else if dir == FACE_NX {
        px = x;
        py = y + v;
        pz = z + u;
    } else if dir == FACE_PZ {
        px = x + u;
        py = y + v;
        pz = z + 1;
    } else {
        px = x + u;
        py = y + v;
        pz = z;
    }
    return Vec3.xyz(px, py, pz);
}

/// Emit one AO-scaled corner vertex.
fn emitCorner(
    out: []f32,
    at: int,
    p0: Vec3,
    p1: Vec3,
    p2: Vec3,
    p3: Vec3,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
    n: Vec3,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    i: int,
): int {
    let p = p0;
    let s = s0;
    if i == 1 {
        p = p1;
        s = s1;
    } else if i == 2 {
        p = p2;
        s = s2;
    } else if i == 3 {
        p = p3;
        s = s3;
    }
    return pushVert(out, at, p.x, p.y, p.z, n.x, n.y, n.z, r * s, g * s, b * s, emi);
}

/// Emit two triangles (six verts) for an AO face.
fn emitSix(
    out: []f32,
    at: int,
    p0: Vec3,
    p1: Vec3,
    p2: Vec3,
    p3: Vec3,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
    n: Vec3,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    i0: int,
    i1: int,
    i2: int,
    i3: int,
    i4: int,
    i5: int,
): int {
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i0);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i1);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i2);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i3);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i4);
    return emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i5);
}

// `s0..s3` match `voxel.corners`. 1 leaves the color alone. The shared edge is the darker diagonal.
/// Append an AO-shaded unit-cube face; returns the next write index.
pub fn emitFaceAo(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    dir: int,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
): int {
    let p0 = faceCorner(x, y, z, dir, 0);
    let p1 = faceCorner(x, y, z, dir, 1);
    let p2 = faceCorner(x, y, z, dir, 2);
    let p3 = faceCorner(x, y, z, dir, 3);
    let n = faceNormal(dir);
    let use02 = s0 + s2 <= s1 + s3;
    if dir == FACE_PY || dir == FACE_PX {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 3, 2, 0, 2, 1);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 3, 2, 1, 3, 1, 0);
    }
    if dir == FACE_NY || dir == FACE_PZ {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 1, 2, 0, 2, 3);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 2, 3, 1, 3, 0);
    }
    if dir == FACE_NX {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 2, 3, 0, 2, 0, 1);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 2, 3, 1, 3, 0);
    }
    if use02 {
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 3, 2, 0, 2, 1);
    }
    return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 0, 3, 1, 3, 2);
}
