    dModel: 0,
    lProj: 0,
    lView: 0,
    lModel: 0,
    lLight: 0,
    lSun: 0,
    lSky: 0,
    lSunColor: 0,
    lEye: 0,
    lShadow: 0,
    lFog0: 0,
    lFog1: 0,
    dAlbedo: 0,
    dCutout: 0,
    lAlbedo: 0,
    lCutout: 0,
    lFlat: 0,
    lFlatColor: 0,
    lNudge: 0,
    white: 0,
    albedo: 0,
    fogStart: 40,
    fogEnd: 120,
    clipNear: 0,
    clipFar: 200,
