    clearColor: 0,
    clear: 0,
    enable: 0,
    disable: 0,
    depthFunc: 0,
    cullFace: 0,
    polygonOffset: 0,
    genTextures: 0,
    bindTexture: 0,
    texImage2D: 0,
    texParameteri: 0,
    texParameterfv: 0,
    texParameterf: 0,
    generateMipmap: 0,
    getFloatv: 0,
    genFramebuffers: 0,
    bindFramebuffer: 0,
    framebufferTexture2D: 0,
    checkFramebufferStatus: 0,
    drawBuffer: 0,
    readBuffer: 0,
    genVertexArrays: 0,
    bindVertexArray: 0,
    genBuffers: 0,
    bindBuffer: 0,
    bufferData: 0,
    enableVertexAttribArray: 0,
    disableVertexAttribArray: 0,
    vertexAttribPointer: 0,
    vertexAttrib2f: 0,
    useProgram: 0,
    createShader: 0,
    shaderSource: 0,
    compileShader: 0,
    getShaderiv: 0,
    getShaderInfoLog: 0,
