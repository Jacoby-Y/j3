/// Buffer for shader and program info logs.
#[singleton]
let LOG: [2048]u8;

/// White border color for the shadow map (`GL_CLAMP_TO_BORDER`).
#[singleton]
let BORDER: [4]f32 = [1, 1, 1, 1];

/// Staging for 64 instances: 16 floats for matrices, 24 with color/emission.
#[singleton]
let INST: [1536]f32;

#[singleton]
let INSTANCE_COLOR: bool = false;

/// Two line endpoints, xyz xyz.
#[singleton]
let LINE: [6]f32;
