/// Forward OpenGL 3.3 beside `j3.game`'s 2D renderer.
/// One directional sun, one shadow map, per-pixel shade. No voxel types here.
/// Entry points come from `game.glProc` (3.3 is not a stable libGL export).

module j3.gfx;

use j3.game;
use j3.math.{ Mat4, PI, Vec3, abs, clamp, cos, sin, tan };
use j3.sys.panic;
use j3.text.cstr;

use lib "GL" as gl {
    fn glGetError(): u32;
}

/// Enable depth testing.
const GL_DEPTH_TEST: u32 = 0x0B71;
/// Enable face culling.
const GL_CULL_FACE: u32 = 0x0B44;
/// Front faces.
const GL_FRONT: u32 = 0x0404;
/// Back faces. Culled by default.
const GL_BACK: u32 = 0x0405;
/// Clear the color buffer.
const GL_COLOR_BUFFER_BIT: u32 = 0x4000;
/// Clear the depth buffer.
const GL_DEPTH_BUFFER_BIT: u32 = 0x0100;
/// Draw mode for mesh triangles.
const GL_TRIANGLES: u32 = 0x0004;
/// Depth test passes when the new depth is less or equal.
const GL_LEQUAL: u32 = 0x0203;
/// 2D texture target.
const GL_TEXTURE_2D: u32 = 0x0DE1;
/// Depth-texture format.
const GL_DEPTH_COMPONENT: u32 = 0x1902;
/// 24-bit depth renderbuffer / texture internal format.
const GL_DEPTH_COMPONENT24: i32 = 0x81A6;
/// Unsigned 32-bit index type.
const GL_UNSIGNED_INT: u32 = 0x1405;
/// 32-bit float vertex type.
const GL_FLOAT: u32 = 0x1406;
/// Linear texture filter.
const GL_LINEAR: i32 = 0x2601;
/// Trilinear minification. Grazing views of a repeating texture alias into stripes without it.
const GL_LINEAR_MIPMAP_LINEAR: i32 = 0x2703;
/// Anisotropic filter (core on desktop GL; ignored when the query returns nothing).
const GL_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FE;
/// Upper bound reported for `GL_TEXTURE_MAX_ANISOTROPY`.
const GL_MAX_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FF;
/// Clamp texture coordinates to the border color.
const GL_CLAMP_TO_BORDER: i32 = 0x812D;
/// Wrap mode for the S axis.
const GL_TEXTURE_WRAP_S: u32 = 0x2802;
/// Wrap mode for the T axis.
const GL_TEXTURE_WRAP_T: u32 = 0x2803;
/// Minification filter.
const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
/// Magnification filter.
const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
/// Border color used by `GL_CLAMP_TO_BORDER`.
const GL_TEXTURE_BORDER_COLOR: u32 = 0x1004;
/// Shadow comparison mode parameter.
const GL_TEXTURE_COMPARE_MODE: u32 = 0x884C;
/// Shadow comparison function parameter.
const GL_TEXTURE_COMPARE_FUNC: u32 = 0x884D;
/// Sample the shadow map by comparing the fragment depth to the texel.
const GL_COMPARE_REF_TO_TEXTURE: i32 = 0x884E;
/// Framebuffer target.
const GL_FRAMEBUFFER: u32 = 0x8D40;
/// Attach a texture as the depth buffer.
const GL_DEPTH_ATTACHMENT: u32 = 0x8D00;
/// Framebuffer is complete and drawable.
const GL_FRAMEBUFFER_COMPLETE: u32 = 0x8CD5;
/// No color draw or read buffer.
const GL_NONE: u32 = 0;
/// Vertex buffer target.
const GL_ARRAY_BUFFER: u32 = 0x8892;
/// Upload buffer data that will not change.
const GL_STATIC_DRAW: u32 = 0x88E4;
/// Vertex shader stage.
const GL_VERTEX_SHADER: u32 = 0x8B31;
/// Fragment shader stage.
const GL_FRAGMENT_SHADER: u32 = 0x8B30;
/// Shader compile query.
const GL_COMPILE_STATUS: u32 = 0x8B81;
/// Program link query.
const GL_LINK_STATUS: u32 = 0x8B82;
/// Length of a shader or program info log.
const GL_INFO_LOG_LENGTH: u32 = 0x8B84;
/// Depth offset while filling polygons, used to reduce shadow acne.
const GL_POLYGON_OFFSET_FILL: u32 = 0x8037;
/// Texture unit 0.
const GL_TEXTURE0: u32 = 0x84C0;
/// No draw pass is active.
const PASS_NONE: int = 0;
/// Rendering the shadow map.
const PASS_SHADOW: int = 1;
/// Rendering the camera view.
const PASS_CAMERA: int = 2;
/// Shadow map width and height, in pixels.
const SHADOW: i32 = 2048;
/// Distance where fog starts.
const FOG_START: f32 = 40;
/// Distance where fog is opaque.
const FOG_END: f32 = 120;
/// Bytes per untextured vertex (10 floats).
const STRIDE10: i32 = 40;
/// Bytes per textured vertex (12 floats: v1 layout plus u v).
const STRIDE12: i32 = 48;
/// RGBA8 internal format.
const GL_RGBA8: i32 = 0x8058;
/// RGBA pixel format.
const GL_RGBA: u32 = 0x1908;
/// Unsigned byte pixel type.
const GL_UNSIGNED_BYTE: u32 = 0x1401;
/// Repeat texture wrap.
const GL_REPEAT: i32 = 0x2901;
/// Texture unit 1, used by the albedo map. Unit 0 stays the shadow map.
const GL_TEXTURE1: u32 = 0x84C1;
/// Vertical field of view shared by the camera pass and `mouseRay`.
fn fov(): f32 {
    return PI / f32(3);
}

/// Unit cube face -X.
pub const FACE_NX: int = 0;
/// Unit cube face +X.
pub const FACE_PX: int = 1;
/// Unit cube face -Y.
pub const FACE_NY: int = 2;
/// Unit cube face +Y.
pub const FACE_PY: int = 3;
/// Unit cube face -Z.
pub const FACE_NZ: int = 4;
/// Unit cube face +Z.
pub const FACE_PZ: int = 5;

/// Orbit camera around a target point.
pub struct Orbit {
    /// Point looked at.
    target: Vec3;
    /// Yaw angle in radians.
    yaw: f32;
    /// Pitch angle in radians.
    pitch: f32;
    /// Distance from target.
    radius: f32;

    /// Build an orbit camera.
    fn create(target: Vec3, yaw: f32, pitch: f32, radius: f32): Orbit {
        return Orbit {
            target: target,
            yaw: yaw,
            pitch: pitch,
            radius: radius,
        };
    }

    /// World-space eye position.
    fn eye(this: Orbit): Vec3 {
        let cp = cos(this.pitch);
        let sp = sin(this.pitch);
        let cy = cos(this.yaw);
        let sy = sin(this.yaw);
        return Vec3 {
            x: this.target.x + this.radius * cp * sy,
            y: this.target.y + this.radius * sp,
            z: this.target.z + this.radius * cp * cy,
        };
    }

    /// View matrix looking at the target.
    fn view(this: Orbit): Mat4 {
        return Mat4.lookAt(this.eye(), this.target, Vec3.up());
    }

    /// Nudge yaw/pitch; pitch is clamped.
    fn orbit(this: &Orbit, dyaw: f32, dpitch: f32) {
        this.yaw += dyaw;
        this.pitch = clamp(this.pitch + dpitch, -1.2, 1.45);
    }

    /// Change radius by delta, clamped to [lo, hi].
    fn zoom(this: &Orbit, delta: f32, lo: f32, hi: f32) {
        this.radius = clamp(this.radius - delta, lo, hi);
    }
}

// First person. Yaw 0 looks down -Z. Pitch is clamped so `up` stays stable.
/// First-person look camera (eye, yaw, pitch).
pub struct Look {
    /// Eye position in world space.
    eye: Vec3;
    /// Yaw in radians (0 looks down -Z).
    yaw: f32;
    /// Pitch in radians.
    pitch: f32;

    /// Build a look camera.
    fn create(eye: Vec3, yaw: f32, pitch: f32): Look {
        return Look { eye: eye, yaw: yaw, pitch: pitch };
    }

    /// Unit forward vector from yaw/pitch.
    fn forward(this: Look): Vec3 {
        let cp = cos(this.pitch);
        let sp = sin(this.pitch);
        return Vec3.xyz(sin(this.yaw) * cp, sp, f32(0) - cos(this.yaw) * cp);
    }

    /// Horizontal right vector from yaw.
    fn right(this: Look): Vec3 {
        return Vec3.xyz(cos(this.yaw), 0, sin(this.yaw));
    }

    /// View matrix from eye looking forward.
    fn view(this: Look): Mat4 {
        let aim = this.eye + this.forward();
        return Mat4.lookAt(this.eye, aim, Vec3.up());
    }
}

/// Ray from an origin along a unit direction.
pub struct Ray {
    /// Start point in world space.
    origin: Vec3;
    /// Unit direction.
    dir: Vec3;
}

/// Distance along a ray to an AABB, or a miss.
pub struct RayHit {
    /// True when the segment hits the box.
    ok: bool;
    /// Distance from the origin to the hit. Zero when the origin is inside.
    t: f32;
}

/// RGBA8 texture uploaded for `albedo`.
pub struct Tex {
    /// OpenGL texture id. Zero when empty.
    id: u32;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// Uploaded triangle mesh (VAO/VBO and vertex count).
pub struct Mesh {
    /// Vertex array object id.
    vao: u32;
    /// Vertex buffer object id.
    vbo: u32;
    /// Number of vertices.
    count: int;
}

/// Loaded OpenGL 3.3 function pointers.
struct Procs {
    /// glViewport entry.
    viewport: ptr;
    /// glClearColor entry.
    clearColor: ptr;
    /// glClear entry.
    clear: ptr;
    /// glEnable entry.
    enable: ptr;
    /// glDisable entry.
    disable: ptr;
    /// glDepthFunc entry.
    depthFunc: ptr;
    /// glCullFace entry.
    cullFace: ptr;
    /// glPolygonOffset entry.
    polygonOffset: ptr;
    /// glGenTextures entry.
    genTextures: ptr;
    /// glBindTexture entry.
    bindTexture: ptr;
    /// glTexImage2D entry.
    texImage2D: ptr;
    /// glTexParameteri entry.
    texParameteri: ptr;
    /// glTexParameterfv entry.
    texParameterfv: ptr;
    /// glTexParameterf entry.
    texParameterf: ptr;
    /// glGenerateMipmap entry.
    generateMipmap: ptr;
    /// glGetFloatv entry.
    getFloatv: ptr;
    /// glGenFramebuffers entry.
    genFramebuffers: ptr;
    /// glBindFramebuffer entry.
    bindFramebuffer: ptr;
    /// glFramebufferTexture2D entry.
    framebufferTexture2D: ptr;
    /// glCheckFramebufferStatus entry.
    checkFramebufferStatus: ptr;
    /// glDrawBuffer entry.
    drawBuffer: ptr;
    /// glReadBuffer entry.
    readBuffer: ptr;
    /// glGenVertexArrays entry.
    genVertexArrays: ptr;
    /// glBindVertexArray entry.
    bindVertexArray: ptr;
    /// glGenBuffers entry.
    genBuffers: ptr;
    /// glBindBuffer entry.
    bindBuffer: ptr;
    /// glBufferData entry.
    bufferData: ptr;
    /// glEnableVertexAttribArray entry.
    enableVertexAttribArray: ptr;
    /// glDisableVertexAttribArray entry.
    disableVertexAttribArray: ptr;
    /// glVertexAttribPointer entry.
    vertexAttribPointer: ptr;
    /// glVertexAttrib2f entry.
    vertexAttrib2f: ptr;
    /// glUseProgram entry.
    useProgram: ptr;
    /// glCreateShader entry.
    createShader: ptr;
    /// glShaderSource entry.
    shaderSource: ptr;
    /// glCompileShader entry.
    compileShader: ptr;
    /// glGetShaderiv entry.
    getShaderiv: ptr;
    /// glGetShaderInfoLog entry.
    getShaderInfoLog: ptr;
    /// glCreateProgram entry.
    createProgram: ptr;
    /// glAttachShader entry.
    attachShader: ptr;
    /// glLinkProgram entry.
    linkProgram: ptr;
    /// glGetProgramiv entry.
    getProgramiv: ptr;
    /// glGetProgramInfoLog entry.
    getProgramInfoLog: ptr;
    /// glDeleteShader entry.
    deleteShader: ptr;
    /// glGetUniformLocation entry.
    getUniformLocation: ptr;
    /// glUniform1i entry.
    uniform1i: ptr;
    /// glUniform1f entry.
    uniform1f: ptr;
    /// glUniform2f entry.
    uniform2f: ptr;
    /// glUniform3f entry.
    uniform3f: ptr;
    /// glUniformMatrix4fv entry.
    uniformMatrix4fv: ptr;
    /// glActiveTexture entry.
    activeTexture: ptr;
    /// glDrawArrays entry.
    drawArrays: ptr;
    /// glDeleteBuffers entry.
    deleteBuffers: ptr;
    /// glDeleteVertexArrays entry.
    deleteVertexArrays: ptr;
    /// glDeleteTextures entry.
    deleteTextures: ptr;
    /// glDeleteFramebuffers entry.
    deleteFramebuffers: ptr;
    /// glDeleteProgram entry.
    deleteProgram: ptr;
}

/// Global lit/shadow renderer state.
struct Gfx {
    /// True after successful init.
    ready: bool;
    /// Current pass: none, shadow, or camera.
    pass: int;
    /// Depth-only shader program.
    depth: u32;
    /// Lit fragment shader program.
    lit: u32;
    /// Shadow map framebuffer.
    shadowFbo: u32;
    /// Shadow depth texture.
    shadowTex: u32;
    /// Light-space projection times view matrix.
    light: Mat4;
    /// Camera projection matrix.
    proj: Mat4;
    /// Camera view matrix.
    view: Mat4;
    /// Normalized sun direction.
    sun: Vec3;
    /// Sky / fog color.
    sky: Vec3;
    /// Sun light color.
    sunColor: Vec3;
    /// Camera eye position.
    eye: Vec3;
    /// Depth program uLight location.
    dLight: i32;
    /// Depth program uModel location.
    dModel: i32;
    /// Lit uProj location.
    lProj: i32;
    /// Lit uView location.
    lView: i32;
    /// Lit uModel location.
    lModel: i32;
    /// Lit uLight location.
    lLight: i32;
    /// Lit uSun location.
    lSun: i32;
    /// Lit uSky location.
    lSky: i32;
    /// Lit uSunColor location.
    lSunColor: i32;
    /// Lit uEye location.
    lEye: i32;
    /// Lit uShadow location.
    lShadow: i32;
    /// Lit uFogStart location.
    lFog0: i32;
    /// Lit uFogEnd location.
    lFog1: i32;
    /// Depth uAlbedo location.
    dAlbedo: i32;
    /// Depth uCutout location.
    dCutout: i32;
    /// Lit uAlbedo location.
    lAlbedo: i32;
    /// Lit uCutout location.
    lCutout: i32;
    /// Lit uFlat location. Above 0.5 replaces lighting with `uFlatColor`.
    lFlat: i32;
    /// Lit uFlatColor location.
    lFlatColor: i32;
    /// Lit uNudge location. Clip-space pixel shift for selection outlines.
    lNudge: i32;
    /// 1×1 white albedo texture.
    white: u32;
    /// Albedo bound for the next draws. Camera pass resets this to white.
    albedo: u32;
    /// Fog start distance.
    fogStart: f32;
    /// Fog end distance.
    fogEnd: f32;
    /// Perspective near plane.
    clipNear: f32;
    /// Perspective far plane.
    clipFar: f32;
}

