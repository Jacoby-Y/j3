/// Forward OpenGL 3.3 beside `j3.game`'s 2D renderer.
/// One directional sun, one shadow map, per-pixel shade. No voxel types here.
/// Entry points come from `game.glProc` (3.3 is not a stable libGL export).
/// Main thread only: it needs the GL context (`j3c doc threads`). Only these touch no state and
/// may run on a worker: `emitFace`, `emitFaceAo` (mesh building), `boxInClip`, `rayAabb` (geometry),
/// `plainSurface`, `fxWidth`.

module j3.gfx;

use j3.game;
use j3.game.letterbox.GlRect;
use j3.math.{ Mat4, PI, Vec2, Vec3, abs, clamp, cos, sin, sqrt, tan };
use j3.sys.panic;
use j3.memory.{ Arena, scratch };
use j3.text.{ Text, contains, cstr };

use lib "GL" as gl {
    fn glGetError(): u32;
}

/// Enable depth testing.
const GL_DEPTH_TEST: u32 = 0x0B71;
/// Enable face culling.
const GL_CULL_FACE: u32 = 0x0B44;
const GL_SCISSOR_TEST: u32 = 0x0C11;
/// Front faces.
const GL_FRONT: u32 = 0x0404;
/// Back faces. Culled by default.
const GL_BACK: u32 = 0x0405;
/// Clear the color buffer.
const GL_COLOR_BUFFER_BIT: u32 = 0x4000;
/// Clear the depth buffer.
const GL_DEPTH_BUFFER_BIT: u32 = 0x0100;
/// Draw mode for mesh triangles.
const GL_TRIANGLES: u32 = 0x0004;
/// Depth test passes when the new depth is less or equal.
const GL_LEQUAL: u32 = 0x0203;
const GL_ALWAYS: u32 = 0x0207;
/// 2D texture target.
const GL_TEXTURE_2D: u32 = 0x0DE1;
/// Depth-texture format.
const GL_DEPTH_COMPONENT: u32 = 0x1902;
/// 24-bit depth renderbuffer / texture internal format.
const GL_DEPTH_COMPONENT24: i32 = 0x81A6;
/// Unsigned 32-bit index type.
const GL_UNSIGNED_INT: u32 = 0x1405;
/// 32-bit float vertex type.
const GL_FLOAT: u32 = 0x1406;
/// Linear texture filter.
const GL_LINEAR: i32 = 0x2601;
/// Trilinear minification. Grazing views of a repeating texture alias into stripes without it.
const GL_LINEAR_MIPMAP_LINEAR: i32 = 0x2703;
/// Anisotropic filter (core on desktop GL; ignored when the query returns nothing).
const GL_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FE;
/// Upper bound reported for `GL_TEXTURE_MAX_ANISOTROPY`.
const GL_MAX_TEXTURE_MAX_ANISOTROPY: u32 = 0x84FF;
/// Clamp texture coordinates to the border color.
const GL_CLAMP_TO_BORDER: i32 = 0x812D;
const GL_CLAMP_TO_EDGE: i32 = 0x812F;
/// Wrap mode for the S axis.
const GL_TEXTURE_WRAP_S: u32 = 0x2802;
/// Wrap mode for the T axis.
const GL_TEXTURE_WRAP_T: u32 = 0x2803;
/// Minification filter.
const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
/// Magnification filter.
const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
/// Border color used by `GL_CLAMP_TO_BORDER`.
const GL_TEXTURE_BORDER_COLOR: u32 = 0x1004;
/// Shadow comparison mode parameter.
const GL_TEXTURE_COMPARE_MODE: u32 = 0x884C;
/// Shadow comparison function parameter.
const GL_TEXTURE_COMPARE_FUNC: u32 = 0x884D;
/// Sample the shadow map by comparing the fragment depth to the texel.
const GL_COMPARE_REF_TO_TEXTURE: i32 = 0x884E;
/// Framebuffer target.
const GL_FRAMEBUFFER: u32 = 0x8D40;
/// Attach a texture as the depth buffer.
const GL_DEPTH_ATTACHMENT: u32 = 0x8D00;
/// Framebuffer is complete and drawable.
const GL_FRAMEBUFFER_COMPLETE: u32 = 0x8CD5;
/// No color draw or read buffer.
const GL_NONE: u32 = 0;
/// Vertex buffer target.
const GL_ARRAY_BUFFER: u32 = 0x8892;
/// Upload buffer data that will not change.
const GL_STATIC_DRAW: u32 = 0x88E4;
/// Upload buffer data that changes each draw.
const GL_DYNAMIC_DRAW: u32 = 0x88E8;
/// Line primitive.
const GL_LINES: u32 = 0x0001;
/// Alpha blending.
const GL_BLEND: u32 = 0x0BE2;
/// Source alpha blend factor.
const GL_SRC_ALPHA: u32 = 0x0302;
/// One-minus-source-alpha blend factor.
const GL_ONE_MINUS_SRC_ALPHA: u32 = 0x0303;
/// Most instances `drawInstanced` will submit.
const INST_MAX: int = 64;
/// Vertex shader stage.
const GL_VERTEX_SHADER: u32 = 0x8B31;
/// Fragment shader stage.
const GL_FRAGMENT_SHADER: u32 = 0x8B30;
/// Shader compile query.
const GL_COMPILE_STATUS: u32 = 0x8B81;
/// Program link query.
const GL_LINK_STATUS: u32 = 0x8B82;
/// Length of a shader or program info log.
const GL_INFO_LOG_LENGTH: u32 = 0x8B84;
/// Depth offset while filling polygons, used to reduce shadow acne.
const GL_POLYGON_OFFSET_FILL: u32 = 0x8037;
/// Texture unit 0.
const GL_TEXTURE0: u32 = 0x84C0;
/// No draw pass is active.
const PASS_NONE: int = 0;
/// Rendering the shadow map.
const PASS_SHADOW: int = 1;
/// Rendering the camera view.
const PASS_CAMERA: int = 2;
/// Shadow map width and height, in pixels.
const SHADOW: i32 = 2048;
/// Distance where fog starts.
const FOG_START: f32 = 40;
/// Distance where fog is opaque.
const FOG_END: f32 = 120;
/// Bytes per untextured vertex (10 floats).
const STRIDE10: i32 = 40;
/// Bytes per textured vertex (12 floats: v1 layout plus u v).
const STRIDE12: i32 = 48;
/// Bytes per vertex of a lit voxel mesh (14 floats: the 12 above plus sky and block light).
const STRIDE14: i32 = 56;
/// RGBA8 internal format.
const GL_RGBA8: i32 = 0x8058;
/// RGBA pixel format.
const GL_RGBA: u32 = 0x1908;
/// Unsigned byte pixel type.
const GL_UNSIGNED_BYTE: u32 = 0x1401;
/// Repeat texture wrap.
const GL_REPEAT: i32 = 0x2901;
/// Texture unit 1, used by the albedo map. Unit 0 stays the shadow map.
const GL_TEXTURE1: u32 = 0x84C1;
const GL_TEXTURE3: u32 = 0x84C3;
const GL_TEXTURE4: u32 = 0x84C4;
const GL_TEXTURE5: u32 = 0x84C5;
const GL_TEXTURE6: u32 = 0x84C6;
const GL_TEXTURE7: u32 = 0x84C7;
const GL_TEXTURE8: u32 = 0x84C8;
const GL_TEXTURE9: u32 = 0x84C9;
const GL_RGBA16F: i32 = 0x881A;
const GL_ZERO: u32 = 0;
const GL_ONE: u32 = 1;
const GL_SRC_COLOR: u32 = 0x0300;
const GL_FUNC_ADD: u32 = 0x8006;
const GL_MIN: u32 = 0x8007;
const GL_COLOR_ATTACHMENT0: u32 = 0x8CE0;
const GL_RGBA32F: i32 = 0x8814;
const GL_NEAREST: i32 = 0x2600;
/// Vertical field of view shared by the camera pass and `mouseRay`: 60 degrees unless `setFov`.
fn fov(): f32 {
    if G.fovAngle > 0 {
        return G.fovAngle;
    }
    return PI / f32(3);
}

/// Vertical field of view in degrees for orbit camera passes and `mouseRay`. `0` restores 60.
pub fn setFov(degrees: f32) {
    G.fovAngle = clamp(degrees, 0, 170) * PI / f32(180);
}

/// Draw orbit camera passes orthographically, `half` world units from the view's center to
/// its top edge. `0` switches back to perspective. `mouseRay` follows.
pub fn setOrtho(half: f32) {
    G.orthoHalf = half;
}

/// Unit cube face -X.
pub const FACE_NX: int = 0;
/// Unit cube face +X.
pub const FACE_PX: int = 1;
/// Unit cube face -Y.
pub const FACE_NY: int = 2;
/// Unit cube face +Y.
pub const FACE_PY: int = 3;
/// Unit cube face -Z.
pub const FACE_NZ: int = 4;
/// Unit cube face +Z.
pub const FACE_PZ: int = 5;

/// Orbit camera around a target point.
pub struct Orbit {
    /// Point looked at.
    target: Vec3;
    /// Yaw angle in radians.
    yaw: f32;
    /// Pitch angle in radians.
    pitch: f32;
    /// Distance from target.
    radius: f32;

    /// Build an orbit camera.
    fn create(target: Vec3, yaw: f32, pitch: f32, radius: f32): Orbit {
        return Orbit {
            target: target,
            yaw: yaw,
            pitch: pitch,
            radius: radius,
        };
    }

    /// World-space eye position.
    fn eye(this: Orbit): Vec3 {
        let cp = cos(this.pitch);
        let sp = sin(this.pitch);
        let cy = cos(this.yaw);
        let sy = sin(this.yaw);
        return Vec3 {
            x: this.target.x + this.radius * cp * sy,
            y: this.target.y + this.radius * sp,
            z: this.target.z + this.radius * cp * cy,
        };
    }

    /// View matrix looking at the target.
    fn view(this: Orbit): Mat4 {
        return Mat4.lookAt(this.eye(), this.target, Vec3.up());
    }

    /// Nudge yaw/pitch; pitch is clamped.
    fn orbit(this: &Orbit, dyaw: f32, dpitch: f32) {
        this.yaw += dyaw;
        this.pitch = clamp(this.pitch + dpitch, -1.2, 1.45);
    }

    /// Change radius by delta, clamped to [lo, hi].
    fn zoom(this: &Orbit, delta: f32, lo: f32, hi: f32) {
        this.radius = clamp(this.radius - delta, lo, hi);
    }
}

// First person. Yaw 0 looks down -Z. Pitch is clamped so `up` stays stable.
/// First-person look camera (eye, yaw, pitch).
pub struct Look {
    /// Eye position in world space.
    eye: Vec3;
    /// Yaw in radians (0 looks down -Z).
    yaw: f32;
    /// Pitch in radians.
    pitch: f32;
    /// Roll in radians around the view direction; positive leans right. Only `view` uses it.
    roll: f32;

    /// Build a look camera (no roll).
    fn create(eye: Vec3, yaw: f32, pitch: f32): Look {
        return Look { eye: eye, yaw: yaw, pitch: pitch, roll: 0 };
    }

    /// Unit forward vector from yaw/pitch.
    fn forward(this: Look): Vec3 {
        let cp = cos(this.pitch);
        let sp = sin(this.pitch);
        return Vec3.xyz(sin(this.yaw) * cp, sp, f32(0) - cos(this.yaw) * cp);
    }

    /// Horizontal right vector from yaw.
    fn right(this: Look): Vec3 {
        return Vec3.xyz(cos(this.yaw), 0, sin(this.yaw));
    }

    /// View matrix from eye looking forward.
    fn view(this: Look): Mat4 {
        let fwd = this.forward();
        let aim = this.eye + fwd;
        if this.roll == 0 { return Mat4.lookAt(this.eye, aim, Vec3.up()); }
        let side = this.right();
        let up = side.cross(fwd);
        return Mat4.lookAt(this.eye, aim, up * cos(this.roll) + side * sin(this.roll));
    }
}

/// Ray from an origin along a unit direction.
pub struct Ray {
    /// Start point in world space.
    origin: Vec3;
    /// Unit direction.
    dir: Vec3;
}

/// Distance along a ray to an AABB, or a miss.
pub struct RayHit {
    /// True when the segment hits the box.
    ok: bool;
    /// Distance from the origin to the hit. Zero when the origin is inside.
    t: f32;
}

/// RGBA8 texture uploaded for `albedo`.
pub struct Tex {
    /// OpenGL texture id. Zero when empty.
    id: u32;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// Uploaded triangle mesh (VAO/VBO and vertex count).
pub struct Mesh {
    /// Vertex array object id.
    vao: u32 = 0;
    /// Vertex buffer object id.
    vbo: u32 = 0;
    /// Number of vertices.
    count: int = 0;
}

/// Loaded OpenGL 3.3 function pointers.
struct Procs {
    /// glViewport entry.
    viewport: ptr;
    /// glScissor entry.
    scissor: ptr;
    /// glClearColor entry.
    clearColor: ptr;
    /// glClear entry.
    clear: ptr;
    /// glEnable entry.
    enable: ptr;
    /// glDisable entry.
    disable: ptr;
    /// glDepthFunc entry.
    depthFunc: ptr;
    /// glCullFace entry.
    cullFace: ptr;
    /// glPolygonOffset entry.
    polygonOffset: ptr;
    /// glGenTextures entry.
    genTextures: ptr;
    /// glBindTexture entry.
    bindTexture: ptr;
    /// glTexImage2D entry.
    texImage2D: ptr;
    /// glTexParameteri entry.
    texParameteri: ptr;
    /// glTexParameterfv entry.
    texParameterfv: ptr;
    /// glTexParameterf entry.
    texParameterf: ptr;
    /// glGenerateMipmap entry.
    generateMipmap: ptr;
    /// glGetFloatv entry.
    getFloatv: ptr;
    /// glGenFramebuffers entry.
    genFramebuffers: ptr;
    /// glBindFramebuffer entry.
    bindFramebuffer: ptr;
    /// glFramebufferTexture2D entry.
    framebufferTexture2D: ptr;
    /// glCheckFramebufferStatus entry.
    checkFramebufferStatus: ptr;
    /// glDrawBuffer entry.
    drawBuffer: ptr;
    /// glReadBuffer entry.
    readBuffer: ptr;
    /// glReadPixels entry.
    readPixels: ptr;
    /// glGenVertexArrays entry.
    genVertexArrays: ptr;
    /// glBindVertexArray entry.
    bindVertexArray: ptr;
    /// glGenBuffers entry.
    genBuffers: ptr;
    /// glBindBuffer entry.
    bindBuffer: ptr;
    /// glBufferData entry.
    bufferData: ptr;
    /// glEnableVertexAttribArray entry.
    enableVertexAttribArray: ptr;
    /// glDisableVertexAttribArray entry.
    disableVertexAttribArray: ptr;
    /// glVertexAttribPointer entry.
    vertexAttribPointer: ptr;
    /// glVertexAttrib2f entry.
    vertexAttrib2f: ptr;
    /// glUseProgram entry.
    useProgram: ptr;
    /// glCreateShader entry.
    createShader: ptr;
    /// glShaderSource entry.
    shaderSource: ptr;
    /// glCompileShader entry.
    compileShader: ptr;
    /// glGetShaderiv entry.
    getShaderiv: ptr;
    /// glGetShaderInfoLog entry.
    getShaderInfoLog: ptr;
    /// glCreateProgram entry.
    createProgram: ptr;
    /// glAttachShader entry.
    attachShader: ptr;
    /// glLinkProgram entry.
    linkProgram: ptr;
    /// glGetProgramiv entry.
    getProgramiv: ptr;
    /// glGetProgramInfoLog entry.
    getProgramInfoLog: ptr;
    /// glDeleteShader entry.
    deleteShader: ptr;
    /// glGetUniformLocation entry.
    getUniformLocation: ptr;
    /// glUniform1i entry.
    uniform1i: ptr;
    /// glUniform1f entry.
    uniform1f: ptr;
    /// glUniform2f entry.
    uniform2f: ptr;
    /// glUniform3f entry.
    uniform3f: ptr;
    /// glUniform4f entry.
    uniform4f: ptr;
    /// glCopyTexSubImage2D entry.
    copyTexSubImage2D: ptr;
    /// glUniformMatrix4fv entry.
    uniformMatrix4fv: ptr;
    /// glActiveTexture entry.
    activeTexture: ptr;
    /// glDrawArrays entry.
    drawArrays: ptr;
    /// glDeleteBuffers entry.
    deleteBuffers: ptr;
    /// glDeleteVertexArrays entry.
    deleteVertexArrays: ptr;
    /// glDeleteTextures entry.
    deleteTextures: ptr;
    /// glDeleteFramebuffers entry.
    deleteFramebuffers: ptr;
    /// glDeleteProgram entry.
    deleteProgram: ptr;
    /// glBlendFunc entry.
    blendFunc: ptr;
    blendFuncSeparate: ptr;
    blendEquationSeparate: ptr;
    /// glDepthMask entry.
    depthMask: ptr;
    /// glDrawArraysInstanced entry.
    drawArraysInstanced: ptr;
    /// glVertexAttribDivisor entry.
    vertexAttribDivisor: ptr;
}

/// Global lit/shadow renderer state.
/// Uniform locations of one lit program variant (`LIT_*`).
struct LitLocs {
    prog: u32;
    lInst: i32;
    /// Lit uProj location.
    lProj: i32;
    /// Lit uView location.
    lView: i32;
    /// Lit uModel location.
    lModel: i32;
    /// Lit uLight location.
    lLight: i32;
    /// Lit uSun location.
    lSun: i32;
    /// Lit uSky location.
    lSky: i32;
    /// Lit uSunColor location.
    lSunColor: i32;
    /// Lit uEye location.
    lEye: i32;
    /// Lit uShadow location.
    lShadow: i32;
    /// Lit uFogStart location.
    lFog0: i32;
    /// Lit uFogEnd location.
    lFog1: i32;
    lPassTex: i32;
    /// Lit uAlbedo location.
    lAlbedo: i32;
    /// Lit uCutout location.
    lCutout: i32;
    /// Lit uFlat location. Above 0.5 replaces lighting with `uFlatColor`.
    lFlat: i32;
    /// Lit uFlatColor location.
    lFlatColor: i32;
    /// Lit uNudge location. Clip-space pixel shift for selection outlines.
    lNudge: i32;
    /// Lit uAlpha location.
    lAlpha: i32;
    /// Lit surface uniform locations (see `Surface`).
    lTint: i32;
    lGlow: i32;
    lSpec: i32;
    lShine: i32;
    lReflect: i32;
    lEdge: i32;
    lUvScale: i32;
    lUvOffset: i32;
    lIor: i32;
    lRough: i32;
    lGrab: i32;
    lGrabRect: i32;
    lSkyTex: i32;
    lHasSky: i32;
    /// Point-light position, color, and radius locations (`uLP[i]` ...), in the lit and
    /// the instanced program.
    lP: [8]i32;
    lC: [8]i32;
    lR: [8]i32;
    lTraceNear: i32;
    lMapOn: i32;
    lTraceOn: i32;
    lThickness: i32;
    lCloud: i32;
    lTraceShadowAll: i32;
    lBounces: i32;
    lSamples: i32;
    lTraceShadows: i32;
    lGrabbed: i32;
    /// Seconds since start, and the view size in pixels, for effects.
    lTime: i32;
    lResolution: i32;
}

/// The lit variant in use, and every one compiled so far (by flags; 0 until first use).
#[singleton]
let LIT: LitLocs;
#[singleton]
let LITS: [8]LitLocs;

/// Lit variant flags. Trace code slows every pixel of a program it's compiled into (GPU
/// registers), used or not, so each draw takes the smallest variant it needs.
const LIT_PLAIN: int = 0;
/// Traced sun shadows.
const LIT_SUN: int = 1;
/// Traced mirrors: one ray at a time, no path stack.
const LIT_MIRROR: int = 2;
/// Traced glass, which splits rays and needs the path stack (mirrors too).
const LIT_GLASS: int = 4;

struct Gfx {
    /// True after successful init.
    ready: bool;
    /// Current pass: none, shadow, or camera.
    pass: int;
    /// Depth-only shader program.
    depth: u32;
    /// Shadow map framebuffer.
    shadowFbo: u32;
    /// Shadow depth texture.
    shadowTex: u32;
    /// Optional camera color/depth target owned by a postprocess pipeline.
    outputFbo: u32;
    /// Light-space projection times view matrix.
    light: Mat4;
    /// Camera projection matrix.
    proj: Mat4;
    /// Camera view matrix.
    view: Mat4;
    /// Normalized sun direction.
    sun: Vec3;
    /// Sky / fog color.
    sky: Vec3;
    /// Sun light color.
    sunColor: Vec3;
    /// Camera eye position.
    eye: Vec3;
    /// Depth program uLight location.
    dLight: i32;
    /// Depth program uModel location.
    dModel: i32;
    /// uInst in the depth, lit, and pass programs: 1 takes the model from the instance buffer.
    dInst: i32;
    pInst: i32;
    /// Depth uAlbedo location.
    dAlbedo: i32;
    /// Depth uCutout location.
    dCutout: i32;
    /// Light the next shadow-pass draws let through (see `castShadow`); black is opaque.
    shadowLet: Vec3;
    /// Translucent casters' shadow: RGB is the light they let through (multiplied), A the
    /// nearest one's depth.
    passTex: u32;
    passFbo: u32;
    passProg: u32;
    pLight: i32;
    pModel: i32;
    pPass: i32;
    /// 1×1 white albedo texture.
    white: u32;
    /// Albedo bound for the next draws. Camera pass resets this to white.
    albedo: u32;
    /// Fog start distance.
    fogStart: f32;
    /// Fog end distance.
    fogEnd: f32;
    /// Perspective near plane.
    clipNear: f32;
    /// Perspective far plane.
    clipFar: f32;
    /// Orbit camera field of view in radians; `0` is the 60 degree default.
    fovAngle: f32;
    /// Half height of an orthographic orbit view; `0` is perspective.
    orthoHalf: f32;
    /// The next `drawMesh` blends even at full alpha (texture alpha still applies).
    blendNext: bool;
    /// How later draws' surfaces look. See `surface`.
    surf: Surface;
    /// Camera-pass rect in window pixels, top-left origin. Zero size uses the whole window.
    viewX: f32;
    viewY: f32;
    viewW: f32;
    viewH: f32;
    /// Instanced lit program.
    /// Instance matrix buffer.
    instBuf: u32;
    /// Unlit line program.
    lineProg: u32;
    /// Two-vertex line buffer.
    lineBuf: u32;
    /// VAO for `drawLine`. Core profile rejects attribute setup on VAO 0.
    lineVao: u32;
    /// Line uProj location.
    lLineProj: i32;
    /// Line uView location.
    lLineView: i32;
    /// Line uColor location.
    lLineColor: i32;
    /// Point-light positions. Radius 0 disables that light.
    pPos: [8]Vec3;
    /// Point-light colors.
    pCol: [8]Vec3;
    /// Point-light radii.
    pRad: [8]f32;
    /// Copy of the view taken by `grab`, which glass samples, its size, and where it came
    /// from in GL window coordinates.
    grabTex: u32;
    grabW: i32;
    grabH: i32;
    grabRect: [4]f32;
    /// Equirect image of the scene's sky box, 0 for none.
    skyTex: u32;
    /// `grab` ran in this camera pass, so glass rays that miss can look it up.
    grabbed: bool;
    /// The traced scene in use (see `traceUse`) and its settings; `trace.count` 0 is off.
    trace: Traced;
    traceBounces: int;
    traceSamples: int;
    traceShadows: bool;
    /// Traced sun shadows stop this far from the eye (0: no limit).
    traceNear: f32;
    /// Something was drawn into the shadow map since `shadowPass`, so the lit shader can
    /// trust it where it's sure and trace only the rest.
    mapUsed: bool;
}

/// Loaded GL 3.3 entry points. Zero until `startup`.
#[singleton]
let P: Procs = Procs {
    viewport: 0,
    scissor: 0,
    clearColor: 0,
    clear: 0,
    enable: 0,
    disable: 0,
    depthFunc: 0,
    cullFace: 0,
    polygonOffset: 0,
    genTextures: 0,
    bindTexture: 0,
    texImage2D: 0,
    texParameteri: 0,
    texParameterfv: 0,
    texParameterf: 0,
    generateMipmap: 0,
    getFloatv: 0,
    genFramebuffers: 0,
    bindFramebuffer: 0,
    framebufferTexture2D: 0,
    checkFramebufferStatus: 0,
    drawBuffer: 0,
    readBuffer: 0,
    readPixels: 0,
    genVertexArrays: 0,
    bindVertexArray: 0,
    genBuffers: 0,
    bindBuffer: 0,
    bufferData: 0,
    enableVertexAttribArray: 0,
    disableVertexAttribArray: 0,
    vertexAttribPointer: 0,
    vertexAttrib2f: 0,
    useProgram: 0,
    createShader: 0,
    shaderSource: 0,
    compileShader: 0,
    getShaderiv: 0,
    getShaderInfoLog: 0,
    createProgram: 0,
    attachShader: 0,
    linkProgram: 0,
    getProgramiv: 0,
    getProgramInfoLog: 0,
    deleteShader: 0,
    getUniformLocation: 0,
    uniform1i: 0,
    uniform1f: 0,
    uniform2f: 0,
    uniform3f: 0,
    uniform4f: 0,
    copyTexSubImage2D: 0,
    uniformMatrix4fv: 0,
    activeTexture: 0,
    drawArrays: 0,
    deleteBuffers: 0,
    deleteVertexArrays: 0,
    deleteTextures: 0,
    deleteFramebuffers: 0,
    deleteProgram: 0,
    blendFunc: 0,
    blendFuncSeparate: 0,
    blendEquationSeparate: 0,
    depthMask: 0,
    drawArraysInstanced: 0,
    vertexAttribDivisor: 0,
};

/// Shadow map, shader programs, and the current pass.
#[singleton]
let G: Gfx = Gfx {
    ready: false,
    pass: 0,
