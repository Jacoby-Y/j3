/// `j3.instance` off Linux: every copy runs alone, no message or request arrives, `request` is None (see `instance.j3`).

module j3.instance;

use j3.option.Option;

/// A request from `instance.request`; never made off Linux.
pub struct Request {
    slot: int;
    gen: int;

    fn args(this: Request): []string { return []string { ptr: 0 as &string, len: 0 }; }
    fn reply(this: Request, text: string) {}
    fn alive(this: Request): bool { return false; }
}

pub fn claim(name: string): bool {
    return true;
}

pub fn next(): bool {
    return false;
}

pub fn nextRequest(): Option<Request> {
    return Option.None;
}

pub fn request(name: string, args: []string, timeoutMs: int): Option<string> {
    return Option.None;
}

pub fn args(): []string {
    return []string { ptr: 0 as &string, len: 0 };
}
