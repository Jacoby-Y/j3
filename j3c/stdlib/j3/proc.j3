/// Run other programs: `run` starts one, feeds it stdin, collects stdout and stderr, and waits;
/// `start` gives a `Child` to drive yourself. The program is found on `PATH` unless its name has a
/// `/`. No shell is involved, so arguments are passed as they are (use `["sh", "-c", line]` for one).
///
///     let argv: [2]string = ["echo", "hi"];
///     match proc.run(argv[:], "", &arena) {
///         Result.Ok(o) { printLn(o.outStr()); }   // o.code is the exit code
///         Result.Err(e) { ... }                  // NotFound, ExecFailed, Fail
///     }
///
/// `runEnv` / `startInEnv` add `"NAME=value"` strings to the child's environment (no `env` program needed).
/// A bare `"NAME"` removes that variable instead (Linux, Android; scrub secrets with `proc.environ`).
///
/// `startWith` takes `StartOpts`: its own process group (`Child.killTree` then ends grandchildren too),
/// stdout/stderr onto a file, and rlimits. A log file and a hard stop (`j3c doc recipes timeout`):
///
///     let log = io.openPath("server.log", O_WRONLY + O_CREAT + O_APPEND, 420);
///     let opts = StartOpts { group: true, stdoutFd: log, stderrFd: log, cpuSecs: 600 };
///     let c = proc.startWith(argv[:], argv[0..0], opts, &arena)?;
///     sys.close(log);
///     ...
///     c.killTree(sys.SIGKILL);   // the whole group, not just `sh`
///     c.wait();
///
/// A manager that starts servers should not leave them running when it dies. `parentDeathSignal` has the
/// kernel signal the child when this process ends, even by SIGKILL; `sys.watchSignals` lets the main loop
/// see SIGTERM / Ctrl+C and stop them itself first (`j3c doc j3.sys watchSignals`):
///
///     let opts = StartOpts { group: true, parentDeathSignal: sys.SIGKILL };
///     let server = proc.startWith(argv[:], argv[0..0], opts, &arena)?;
/// Blocks until the program ends, so run a slow one on a `j3.thread` worker.
/// Platforms: Linux, Android (run programs from `J3_NATIVE_LIB_DIR` there), and Windows (`proc_windows.j3`:
/// `CreateProcessW`, `PATH` tried with `.exe` `.com` `.bat` `.cmd`, a batch file runs through `cmd.exe`, no console window,
/// `kill` terminates with code 143). On other targets every call returns `ProcError.Fail`.

module j3.proc;

use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.sys.{ O_CLOEXEC, POLLHUP, POLLIN, POLLOUT, WNOHANG };
use j3.text.Text;

/// Why a program could not be run.
pub enum ProcError {
    /// No such program on `PATH` (or at the given path).
    NotFound,
    /// It exists but `execve` refused it (not executable, bad format).
    ExecFailed,
    /// Pipes or `fork` failed.
    Fail,
}

/// What a finished program left behind.
pub struct Output {
    /// Exit code, or 128 + the signal that ended it.
    code: int;
    /// Everything it wrote to stdout.
    out: []u8;
    /// Everything it wrote to stderr.
    err: []u8;

    /// stdout as a string.
    fn outStr(this: &Output): string {
        return this.out as string;
    }

    /// stderr as a string.
    fn errStr(this: &Output): string {
        return this.err as string;
    }
}

/// A running program and the parent's ends of its stdin, stdout, and stderr pipes.
pub struct Child {
    /// Process id.
    pid: int;
    /// Write end of its stdin (-1 once closed).
    stdin: int;
    /// Read end of its stdout.
    stdout: int;
    /// Read end of its stderr.
    stderr: int;
    /// Set once `tryWait` saw it end (its code then in `code`).
    done: bool = false;
    code: int = 0;
    /// Started with `StartOpts.group`: `pid` is also its process group id.
    group: bool = false;

    /// Write `data` to its stdin. False when it stopped reading.
    fn write(this: &Child, data: []u8): bool {
        let at = 0;
        while at < data.len {
            let n = sys.write(this.stdin, (data.ptr as int + at) as ptr, data.len - at);
            if n <= 0 {
                return false;
            }
            at += n;
        }
        return true;
    }

    /// Close its stdin, so it sees end of input.
    fn closeStdin(this: &Child) {
        if this.stdin >= 0 {
            sys.close(this.stdin);
            this.stdin = -1;
        }
    }

    /// Read up to `buf.len` bytes of its stdout: the count, 0 at the end, negative on failure.
    fn read(this: &Child, buf: []u8): int {
        return sys.read(this.stdout, buf.ptr as ptr, buf.len);
    }

    /// Read up to `buf.len` bytes of its stderr, like `read`.
    fn readErr(this: &Child, buf: []u8): int {
        return sys.read(this.stderr, buf.ptr as ptr, buf.len);
    }

    /// `read` without blocking: `None` when no bytes are waiting yet, else what `read` returns.
    fn tryRead(this: &Child, buf: []u8): Option<int> {
        return tryReadFd(this.stdout, buf);
    }

    /// `readErr` without blocking: `None` when no bytes are waiting yet.
    fn tryReadErr(this: &Child, buf: []u8): Option<int> {
        return tryReadFd(this.stderr, buf);
    }

    /// Its exit code if it has ended, `None` while it runs. Does not block or close the pipes
    /// (their unread output stays readable); `wait` afterwards closes them and returns the same code.
    fn tryWait(this: &Child): Option<int> {
        if !this.done {
            let status: i32 = 0;
            let r = sys.waitpid(this.pid, &status, WNOHANG);
            if r == 0 {
                return Option.None;
            }
            this.done = true;
            this.code = if r < 0 { -1 } else { sys.exitCode(status) };
        }
        return Option.Some(this.code);
    }

    /// Write `input` to stdin, read stdout and stderr to the end (both at once, so neither pipe
    /// fills and stalls the program), then wait for it.
    fn collect(this: &Child, input: []u8, arena: &Arena): Output {
        let out = Text.new(arena);
        let err = Text.new(arena);
        let buf = arena.alloc::<u8>(65536);
        let at = 0;
        if input.len == 0 {
            this.closeStdin();
        }
        // struct pollfd[3] { i32 fd; i16 events; i16 revents; }
        let pfd: [6]i32 = [0, 0, 0, 0, 0, 0];
        let outOpen = true;
        let errOpen = true;
        while outOpen || errOpen || this.stdin >= 0 {
            let n = 0;
            let slots: [3]int = [-1, -1, -1];
            if this.stdin >= 0 {
                setPoll(pfd[:], n, this.stdin, POLLOUT);
                slots[n] = 0;
                n += 1;
            }
            if outOpen {
                setPoll(pfd[:], n, this.stdout, POLLIN);
                slots[n] = 1;
                n += 1;
            }
            if errOpen {
                setPoll(pfd[:], n, this.stderr, POLLIN);
                slots[n] = 2;
                n += 1;
            }
            if sys.pollFds(&pfd[0] as ptr, n, -1) < 0 {
                break;
            }
            for k in 0..n {
                let rev = revents(pfd[:], k);
                if rev == 0 {
                    continue;
                }
                if slots[k] == 0 {
                    // POLLOUT promises room for at least PIPE_BUF (4096) bytes, so this write cannot block
                    let chunk = input.len - at;
                    if chunk > 4096 {
                        chunk = 4096;
                    }
                    let w = sys.write(this.stdin, (input.ptr as int + at) as ptr, chunk);
                    if w <= 0 {
                        this.closeStdin();
                    } else {
                        at += w;
                        if at >= input.len {
                            this.closeStdin();
                        }
                    }
                } else {
                    let fd = if slots[k] == 1 { this.stdout } else { this.stderr };
                    let r = sys.read(fd, buf.ptr as ptr, buf.len);
                    if r > 0 {
                        if slots[k] == 1 {
                            out.pushBytes(buf[0..r]);
                        } else {
                            err.pushBytes(buf[0..r]);
                        }
                    } else if r == 0 || (rev / POLLHUP) % 2 == 1 {
                        if slots[k] == 1 {
                            outOpen = false;
                        } else {
                            errOpen = false;
                        }
                    }
                }
            }
        }
        this.closeStdin();
        let code = this.wait();
        return Output { code: code, out: out.bytes, err: err.bytes };
    }

    /// Wait for it to end, close the pipes, and return its exit code (128 + signal when killed).
    fn wait(this: &Child): int {
        this.closeStdin();
        if this.stdout >= 0 {
            sys.close(this.stdout);
            this.stdout = -1;
        }
        if this.stderr >= 0 {
            sys.close(this.stderr);
            this.stderr = -1;
        }
        if this.done {
            return this.code;
        }
        let status: i32 = 0;
        if sys.waitpid(this.pid, &status, 0) < 0 {
            return -1;
        }
        return sys.exitCode(status);
    }

    /// Ask it to stop (`SIGTERM`). `wait` afterwards.
    fn kill(this: &Child) {
        sys.kill(this.pid, sys.SIGTERM);
    }

    /// Send `sig` (`sys.SIGTERM`, `sys.SIGKILL`) to its whole process group when it was started with
    /// `StartOpts.group`, so `sh -c "make test"` takes its grandchildren down with it; else to it alone.
    /// `wait` afterwards. A grandchild that made its own group (`setsid`) escapes.
    fn killTree(this: &Child, sig: int) {
        if this.group {
            sys.kill(0 - this.pid, sig);
        } else {
            sys.kill(this.pid, sig);
        }
    }
}

/// Wait until one of `children` that has not ended yet ends, and return its index; its `code`
/// is then set (`tryWait` gives it, `wait` closes its pipes). Children that already ended
/// (`done`) are skipped, so calling it again returns the next one; when several end together,
/// each call returns one of them. Only these pids are reaped, never another child of the
/// process. `Fail` when none is left running, or the OS has no `pidfd_open` (Linux before 5.3).
pub fn waitAny(children: []Child): Result<int, ProcError> {
    let live = 0;
    for i in 0..children.len {
        if !children[i].done {
            live += 1;
            if ended(&children[i]) {
                return Result.Ok(i);
            }
        }
    }
    if live == 0 {
        return Result.Err(ProcError.Fail);
    }
    // a pidfd per running child turns readable when it exits (even one that exited after tryWait)
    let a = Arena.create(live * 16 + 64);
    defer a.destroy();
    let pfd = a.alloc::<i32>(live * 2);
    let idx = a.alloc::<int>(live);
    let n = 0;
    let failed = false;
    for i in 0..children.len {
        if !children[i].done && !failed {
            let fd = sys.pidfdOpen(children[i].pid);
            if fd < 0 {
                failed = true;
            } else {
                setPoll(pfd, n, fd, POLLIN);
                idx[n] = i;
                n += 1;
            }
        }
    }
    let found = -1;
    while !failed && found < 0 {
        if sys.pollFds(pfd.ptr as ptr, n, -1) < 0 {
            failed = true;
        }
        for k in 0..n {
            if found < 0 && !failed && revents(pfd, k) != 0 && ended(&children[idx[k]]) {
                found = idx[k];
            }
        }
    }
    for k in 0..n {
        sys.close(int(pfd[k * 2]));
    }
    if found < 0 {
        return Result.Err(ProcError.Fail);
    }
    return Result.Ok(found);
}

/// `tryWait` says it has ended.
fn ended(c: &Child): bool {
    if let Option.Some(_) = c.tryWait() {
        return true;
    }
    return false;
}

/// Read up to `buf.len` bytes of `fd` without blocking: `None` when nothing is waiting, else what `sys.read` returns.
pub fn tryReadFd(fd: int, buf: []u8): Option<int> {
    let pfd: [2]i32 = [0, 0];
    setPoll(pfd[:], 0, fd, POLLIN);
    if fd >= 0 && sys.pollFds(&pfd[0] as ptr, 1, 0) == 0 {
        return Option.None;
    }
    return Option.Some(sys.read(fd, buf.ptr as ptr, buf.len));
}

fn setPoll(pfd: []i32, k: int, fd: int, events: int) {
    pfd[k * 2] = i32(fd);
    // events in the low half, revents (cleared) in the high half of the second i32
    pfd[k * 2 + 1] = i32(events);
}

fn revents(pfd: []i32, k: int): int {
    let v = int(pfd[k * 2 + 1]);
    if v < 0 {
        v += 4294967296;
    }
    return v / 65536;
}

/// Run `argv` (program name first) with `input` on its stdin and wait for it to end.
pub fn run(argv: []string, input: string, arena: &Arena): Result<Output, ProcError> {
    return runEnv(argv, input, argv[0..0], arena);
}

/// `run` with `env` (`"NAME=value"` strings) added to the inherited environment, replacing a variable of the same
/// name (`GIT_TERMINAL_PROMPT=0`). Linux, Android, Windows.
pub fn runEnv(argv: []string, input: string, env: []string, arena: &Arena): Result<Output, ProcError> {
    let c = startInEnv(argv, "", env, arena)?;
    return Result.Ok(c.collect(input as []u8, arena));
}

/// Start `argv` in this directory. Write with `Child.write`, then `collect` or `wait`.
pub fn start(argv: []string, arena: &Arena): Result<Child, ProcError> {
    return startIn(argv, "", arena);
}

/// Start `argv` with `cwd` as its working directory ("" keeps this one).
pub fn startIn(argv: []string, cwd: string, arena: &Arena): Result<Child, ProcError> {
    return startInEnv(argv, cwd, argv[0..0], arena);
}

/// `startIn` with `env` (`"NAME=value"` strings) added to the inherited environment, as in `runEnv`.
pub fn startInEnv(argv: []string, cwd: string, env: []string, arena: &Arena): Result<Child, ProcError> {
    return startWith(argv, env, StartOpts { cwd: cwd }, arena);
}

/// How `startWith` sets up the child. The defaults change nothing (`StartOpts {}` is `start`).
pub struct StartOpts {
    /// Working directory ("" keeps this one).
    cwd: string = "";
    /// Run it in a new session (`setsid`): it leads its own process group, has no controlling terminal, and
    /// `Child.killTree` signals everything it started. Linux and Android; `Fail` on Windows.
    group: bool = false;
    /// An open fd to put on its stdout / stderr instead of a pipe (-1: the pipe). The same fd for both is
    /// `>>log 2>&1` when it was opened with `O_APPEND`. The parent may close its copy after `startWith`;
    /// the replaced pipe reads end of file at once. Linux and Android.
    stdoutFd: int = -1;
    stderrFd: int = -1;
    /// Resource limits set in the child before exec (soft = hard), 0 leaves one alone. Linux and Android.
    /// CPU seconds (it is killed past them).
    cpuSecs: int = 0;
    /// Address space in bytes: allocations past it fail (`RLIMIT_AS`).
    memBytes: int = 0;
    /// Largest file it may write, in bytes (`RLIMIT_FSIZE`).
    fileBytes: int = 0;
    /// Processes its user may have, counted over every process of the user, not just this tree (`RLIMIT_NPROC`).
    maxProcs: int = 0;
    /// Nonzero: the child gets this signal (`sys.SIGTERM`, `sys.SIGKILL`) when this process dies, even by
    /// SIGKILL, so a server it started does not outlive it. Started after this process already died, it exits.
    /// Linux sends it when the *thread* that called `startWith` ends, so call it from the main thread or one
    /// that lives as long as the child. Works with `group`. Linux and Android; ignored on Windows.
    parentDeathSignal: int = 0;
}

/// `startInEnv` with `StartOpts`: a process group for `killTree`, stdout/stderr onto files, rlimits.
/// `Fail` when the group or a limit cannot be set.
///
///     let opts = StartOpts { cwd: dir, group: true, cpuSecs: 60, memBytes: 4 << 30 };
///     let c = proc.startWith(argv[:], env[:], opts, &arena)?;
pub fn startWith(argv: []string, env: []string, opts: StartOpts, arena: &Arena): Result<Child, ProcError> {
    let cwd = opts.cwd;
    // RLIMIT_* and value pairs, read by the child (built before fork)
    let lim: [8]int = [sys.RLIMIT_CPU, opts.cpuSecs, sys.RLIMIT_AS, opts.memBytes, sys.RLIMIT_FSIZE, opts.fileBytes, sys.RLIMIT_NPROC, opts.maxProcs];
    if argv.len == 0 {
        return Result.Err(ProcError.NotFound);
    }
    let path = findProgram(argv[0], arena);
    if path.len == 0 {
        return Result.Err(ProcError.NotFound);
    }
    // everything the child touches is built before fork: it must not allocate
    let cpath = cString(path, arena);
    let cargv = arena.alloc::<int>(argv.len + 1);
    for i in 0..argv.len {
        cargv[i] = cString(argv[i], arena).ptr as int;
    }
    cargv[argv.len] = 0;
    let ccwd = if cwd.len > 0 { cString(cwd, arena).ptr as int } else { 0 };
    let envp = if env.len == 0 { sys.environ() } else { envWith(env, arena) };

    // four pipes, two ends each: stdin, stdout, stderr, and the exec-error pipe
    let fds = arena.alloc::<i32>(8);
    for k in 0..4 {
        if sys.pipe(fds[k * 2..k * 2 + 2], O_CLOEXEC) < 0 {
            closeAll(fds, k);
            return Result.Err(ProcError.Fail);
        }
    }
    let pin = fds[0..2];
    let pout = fds[2..4];
    let perr = fds[4..6];
    let pexec = fds[6..8];
    sys.ignoreSigpipe(true);
    let parentPid = sys.getpid();
    let pid = sys.fork();
    if pid < 0 {
        closeAll(fds, 4);
        return Result.Err(ProcError.Fail);
    }
    if pid == 0 {
        // child: raw calls only, then execve
        sys.dup2(int(pin[0]), 0);
        sys.dup2(int(pout[1]), 1);
        sys.dup2(int(perr[1]), 2);
        if opts.stdoutFd >= 0 { sys.dup2(opts.stdoutFd, 1); }
        if opts.stderrFd >= 0 { sys.dup2(opts.stderrFd, 2); }
        sys.ignoreSigpipe(false);
        sys.unblockSignals();
        // -1 on the exec pipe: the group or a limit could not be set (the parent says `Fail`)
        let setupOk = !opts.group || sys.setsid() >= 0;
        if setupOk && opts.parentDeathSignal != 0 {
            if sys.setParentDeathSignal(opts.parentDeathSignal) < 0 {
                setupOk = false;
            } else if sys.getppid() != parentPid {
                // the parent died before prctl took hold: nobody is left to signal us
                sys.exit(0);
            }
        }
        for k in 0..4 {
            if setupOk && lim[k * 2 + 1] > 0 && sys.setrlimit(lim[k * 2], lim[k * 2 + 1], lim[k * 2 + 1]) < 0 {
                setupOk = false;
            }
        }
        let e = 0;
        if !setupOk {
            e = -1;
        } else if ccwd != 0 && sys.chdir(ccwd as ptr) < 0 {
            e = sys.errno();
        } else {
            e = 0 - sys.execve(cpath.ptr as ptr, cargv.ptr as ptr, envp);
        }
        let sent: i32 = i32(e);
        sys.write(int(pexec[1]), &sent as ptr, 4);
        sys.exit(127);
    }
    sys.close(int(pin[0]));
    sys.close(int(pout[1]));
    sys.close(int(perr[1]));
    sys.close(int(pexec[1]));
    // the exec pipe closes (read 0) when execve succeeds; otherwise the child sent its errno
    let code: i32 = 0;
    let got = sys.read(int(pexec[0]), &code as ptr, 4);
    sys.close(int(pexec[0]));
    if got == 4 {
        sys.close(int(pin[1]));
        sys.close(int(pout[0]));
        sys.close(int(perr[0]));
        let status: i32 = 0;
        sys.waitpid(pid, &status, 0);
        // ENOENT 2, ENOTDIR 20
        if code == 2 || code == 20 {
            return Result.Err(ProcError.NotFound);
        }
        if code == -1 {
            return Result.Err(ProcError.Fail);
        }
        return Result.Err(ProcError.ExecFailed);
    }
    return Result.Ok(Child { pid: pid, stdin: int(pin[1]), stdout: int(pout[0]), stderr: int(perr[0]), group: opts.group });
}

/// Close both ends of the first `n` pipes in `fds`.
fn closeAll(fds: []i32, n: int) {
    for i in 0..n * 2 {
        sys.close(int(fds[i]));
    }
}

/// `name` itself when it has a `/`, else the first executable `dir/name` on `PATH`. "" when none.
pub fn findProgram(name: string, arena: &Arena): string {
    for i in 0..name.len {
        if name[i] == 47 {
            return name;
        }
    }
    let path = sys.env("PATH");
    if path.len == 0 {
        path = "/usr/local/bin:/usr/bin:/bin";
    }
    let start = 0;
    let i = 0;
    while i <= path.len {
        if i == path.len || path[i] == 58 {
            let dir = path[start..i];
            if dir.len == 0 {
                dir = ".";
            }
            let t = Text.new(arena);
            t.pushStr(dir);
            t.push(47);
            t.pushStr(name);
            let full = t.str();
            t.push(0);
            if sys.canExec(t.bytes.ptr as ptr) {
                return full;
            }
            start = i + 1;
        }
        i += 1;
    }
    return "";
}

/// NUL-terminated copy of `s` on `arena` (the returned bytes include the NUL).
pub fn cString(s: string, arena: &Arena): []u8 {
    let b = arena.alloc::<u8>(s.len + 1);
    for i in 0..s.len {
        b[i] = s[i];
    }
    b[s.len] = 0;
    return b;
}

/// Length of the `NAME` part of `NAME=value` (the whole string without a `=`).
fn keyLen(s: string): int {
    for i in 0..s.len {
        if s[i] == 61 {
            return i;
        }
    }
    return s.len;
}

fn sameKey(a: string, b: string): bool {
    let n = keyLen(a);
    if n != keyLen(b) {
        return false;
    }
    for i in 0..n {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// The NUL-terminated C string at `p`, as a view without the NUL.
fn cview(p: int): string {
    let n = 0;
    while true {
        let byte = ((p + n) as ptr) as &u8;
        if *byte == 0 {
            break;
        }
        n += 1;
    }
    let bytes: []u8 = @slice(p as ptr, n);
    return bytes as string;
}

/// An `envp` array for `execve`: the inherited environment minus every name in `over` (`"NAME=value"`), then
/// `over` (the last one wins when a name repeats). A bare `"NAME"` (no `=`) only removes it.
pub fn envWith(over: []string, arena: &Arena): ptr {
    let ep = sys.environ();
    let inherited = 0;
    if ep as int != 0 {
        while true {
            let slot = (ep as int + inherited * 8) as ptr as &int;
            if *slot == 0 {
                break;
            }
            inherited += 1;
        }
    }
    let envp = arena.alloc::<int>(inherited + over.len + 1);
    let n = 0;
    for i in 0..inherited {
        let slot = (ep as int + i * 8) as ptr as &int;
        let p = *slot;
        let name = cview(p);
        let hit = false;
        for j in 0..over.len {
            if sameKey(name, over[j]) {
                hit = true;
            }
        }
        if !hit {
            envp[n] = p;
            n += 1;
        }
    }
    for j in 0..over.len {
        let later = false;
        for k in j + 1..over.len {
            if sameKey(over[j], over[k]) {
                later = true;
            }
        }
        if !later && keyLen(over[j]) < over[j].len {
            envp[n] = cString(over[j], arena).ptr as int;
            n += 1;
        }
    }
    envp[n] = 0;
    return envp.ptr as ptr;
}

/// The current process environment as `"NAME=value"` strings (what `sys.environ()` points at, so `setenv`
/// changes show). The strings are views of the live environment: valid until it is changed.
pub fn environ(arena: &Arena): []string {
    let ep = sys.environ();
    let n = 0;
    if ep as int != 0 {
        while *((ep as int + n * 8) as ptr as &int) != 0 {
            n += 1;
        }
    }
    let out = arena.alloc::<string>(n);
    for i in 0..n {
        out[i] = cview(*((ep as int + i * 8) as ptr as &int));
    }
    return out;
}
