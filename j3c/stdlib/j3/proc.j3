/// Run other programs: `run` starts one, feeds it stdin, collects stdout and stderr, and waits;
/// `start` gives a `Child` to drive yourself. The program is found on `PATH` unless its name has a
/// `/`. No shell is involved, so arguments are passed as they are (use `["sh", "-c", line]` for one).
///
///     let argv: [2]string = ["echo", "hi"];
///     match proc.run(argv[:], "", &arena) {
///         Result.Ok(o) { printLn(o.outStr()); }   // o.code is the exit code
///         Result.Err(e) { ... }                  // NotFound, ExecFailed, Fail
///     }
///
/// Blocks until the program ends, so run a slow one on a `j3.thread` worker.
/// Linux and Android (run programs from `J3_NATIVE_LIB_DIR` there); on other targets every call returns `ProcError.Fail`.

module j3.proc;

use j3.memory.Arena;
use j3.result.Result;
use j3.sys;
use j3.sys.{ O_CLOEXEC, POLLHUP, POLLIN, POLLOUT };
use j3.text.Text;

/// Why a program could not be run.
pub enum ProcError {
    /// No such program on `PATH` (or at the given path).
    NotFound,
    /// It exists but `execve` refused it (not executable, bad format).
    ExecFailed,
    /// Pipes or `fork` failed.
    Fail,
}

/// What a finished program left behind.
pub struct Output {
    /// Exit code, or 128 + the signal that ended it.
    code: int;
    /// Everything it wrote to stdout.
    out: []u8;
    /// Everything it wrote to stderr.
    err: []u8;

    /// stdout as a string.
    fn outStr(this: &Output): string {
        return this.out as string;
    }

    /// stderr as a string.
    fn errStr(this: &Output): string {
        return this.err as string;
    }
}

/// A running program and the parent's ends of its stdin, stdout, and stderr pipes.
pub struct Child {
    /// Process id.
    pid: int;
    /// Write end of its stdin (-1 once closed).
    stdin: int;
    /// Read end of its stdout.
    stdout: int;
    /// Read end of its stderr.
    stderr: int;

    /// Write `data` to its stdin. False when it stopped reading.
    fn write(this: &Child, data: []u8): bool {
        let at = 0;
        while at < data.len {
            let n = sys.write(this.stdin, (data.ptr as int + at) as ptr, data.len - at);
            if n <= 0 {
                return false;
            }
            at += n;
        }
        return true;
    }

    /// Close its stdin, so it sees end of input.
    fn closeStdin(this: &Child) {
        if this.stdin >= 0 {
            sys.close(this.stdin);
            this.stdin = -1;
        }
    }

    /// Read up to `buf.len` bytes of its stdout: the count, 0 at the end, negative on failure.
    fn read(this: &Child, buf: []u8): int {
        return sys.read(this.stdout, buf.ptr as ptr, buf.len);
    }

    /// Write `input` to stdin, read stdout and stderr to the end (both at once, so neither pipe
    /// fills and stalls the program), then wait for it.
    fn collect(this: &Child, input: []u8, arena: &Arena): Output {
        let out = Text.new(arena);
        let err = Text.new(arena);
        let buf = arena.alloc::<u8>(65536);
        let at = 0;
        if input.len == 0 {
            this.closeStdin();
        }
        // struct pollfd[3] { i32 fd; i16 events; i16 revents; }
        let pfd: [6]i32 = [0, 0, 0, 0, 0, 0];
        let outOpen = true;
        let errOpen = true;
        while outOpen || errOpen || this.stdin >= 0 {
            let n = 0;
            let slots: [3]int = [-1, -1, -1];
            if this.stdin >= 0 {
                setPoll(pfd[:], n, this.stdin, POLLOUT);
                slots[n] = 0;
                n += 1;
            }
            if outOpen {
                setPoll(pfd[:], n, this.stdout, POLLIN);
                slots[n] = 1;
                n += 1;
            }
            if errOpen {
                setPoll(pfd[:], n, this.stderr, POLLIN);
                slots[n] = 2;
                n += 1;
            }
            if sys.pollFds(&pfd[0] as ptr, n, -1) < 0 {
                break;
            }
            for k in 0..n {
                let rev = revents(pfd[:], k);
                if rev == 0 {
                    continue;
                }
                if slots[k] == 0 {
                    // POLLOUT promises room for at least PIPE_BUF (4096) bytes, so this write cannot block
                    let chunk = input.len - at;
                    if chunk > 4096 {
                        chunk = 4096;
                    }
                    let w = sys.write(this.stdin, (input.ptr as int + at) as ptr, chunk);
                    if w <= 0 {
                        this.closeStdin();
                    } else {
                        at += w;
                        if at >= input.len {
                            this.closeStdin();
                        }
                    }
                } else {
                    let fd = if slots[k] == 1 { this.stdout } else { this.stderr };
                    let r = sys.read(fd, buf.ptr as ptr, buf.len);
                    if r > 0 {
                        if slots[k] == 1 {
                            out.pushBytes(buf[0..r]);
                        } else {
                            err.pushBytes(buf[0..r]);
                        }
                    } else if r == 0 || (rev / POLLHUP) % 2 == 1 {
                        if slots[k] == 1 {
                            outOpen = false;
                        } else {
                            errOpen = false;
                        }
                    }
                }
            }
        }
        this.closeStdin();
        let code = this.wait();
        return Output { code: code, out: out.bytes, err: err.bytes };
    }

    /// Wait for it to end, close the pipes, and return its exit code (128 + signal when killed).
    fn wait(this: &Child): int {
        this.closeStdin();
        if this.stdout >= 0 {
            sys.close(this.stdout);
            this.stdout = -1;
        }
        if this.stderr >= 0 {
            sys.close(this.stderr);
            this.stderr = -1;
        }
        let status: i32 = 0;
        if sys.waitpid(this.pid, &status, 0) < 0 {
            return -1;
        }
        return sys.exitCode(status);
    }

    /// Ask it to stop (`SIGTERM`). `wait` afterwards.
    fn kill(this: &Child) {
        sys.kill(this.pid, sys.SIGTERM);
    }
}

fn setPoll(pfd: []i32, k: int, fd: int, events: int) {
    pfd[k * 2] = i32(fd);
    // events in the low half, revents (cleared) in the high half of the second i32
    pfd[k * 2 + 1] = i32(events);
}

fn revents(pfd: []i32, k: int): int {
    let v = int(pfd[k * 2 + 1]);
    if v < 0 {
        v += 4294967296;
    }
    return v / 65536;
}

/// Run `argv` (program name first) with `input` on its stdin and wait for it to end.
pub fn run(argv: []string, input: string, arena: &Arena): Result<Output, ProcError> {
    let c = startIn(argv, "", arena)?;
    return Result.Ok(c.collect(input as []u8, arena));
}

/// Start `argv` in this directory. Write with `Child.write`, then `collect` or `wait`.
pub fn start(argv: []string, arena: &Arena): Result<Child, ProcError> {
    return startIn(argv, "", arena);
}

/// Start `argv` with `cwd` as its working directory ("" keeps this one).
pub fn startIn(argv: []string, cwd: string, arena: &Arena): Result<Child, ProcError> {
    if argv.len == 0 {
        return Result.Err(ProcError.NotFound);
    }
    let path = findProgram(argv[0], arena);
    if path.len == 0 {
        return Result.Err(ProcError.NotFound);
    }
    // everything the child touches is built before fork: it must not allocate
    let cpath = cString(path, arena);
    let cargv = arena.alloc::<int>(argv.len + 1);
    for i in 0..argv.len {
        cargv[i] = cString(argv[i], arena).ptr as int;
    }
    cargv[argv.len] = 0;
    let ccwd = if cwd.len > 0 { cString(cwd, arena).ptr as int } else { 0 };
    let envp = sys.environ();

    // four pipes, two ends each: stdin, stdout, stderr, and the exec-error pipe
    let fds = arena.alloc::<i32>(8);
    for k in 0..4 {
        if sys.pipe(fds[k * 2..k * 2 + 2], O_CLOEXEC) < 0 {
            closeAll(fds, k);
            return Result.Err(ProcError.Fail);
        }
    }
    let pin = fds[0..2];
    let pout = fds[2..4];
    let perr = fds[4..6];
    let pexec = fds[6..8];
    sys.ignoreSigpipe(true);
    let pid = sys.fork();
    if pid < 0 {
        closeAll(fds, 4);
        return Result.Err(ProcError.Fail);
    }
    if pid == 0 {
        // child: raw calls only, then execve
        sys.dup2(int(pin[0]), 0);
        sys.dup2(int(pout[1]), 1);
        sys.dup2(int(perr[1]), 2);
        sys.ignoreSigpipe(false);
        let e = 0;
        if ccwd != 0 && sys.chdir(ccwd as ptr) < 0 {
            e = sys.errno();
        } else {
            e = 0 - sys.execve(cpath.ptr as ptr, cargv.ptr as ptr, envp);
        }
        let sent: i32 = i32(e);
        sys.write(int(pexec[1]), &sent as ptr, 4);
        sys.exit(127);
    }
    sys.close(int(pin[0]));
    sys.close(int(pout[1]));
    sys.close(int(perr[1]));
    sys.close(int(pexec[1]));
    // the exec pipe closes (read 0) when execve succeeds; otherwise the child sent its errno
    let code: i32 = 0;
    let got = sys.read(int(pexec[0]), &code as ptr, 4);
    sys.close(int(pexec[0]));
    if got == 4 {
        sys.close(int(pin[1]));
        sys.close(int(pout[0]));
        sys.close(int(perr[0]));
        let status: i32 = 0;
        sys.waitpid(pid, &status, 0);
        // ENOENT 2, ENOTDIR 20
        if code == 2 || code == 20 {
            return Result.Err(ProcError.NotFound);
        }
        return Result.Err(ProcError.ExecFailed);
    }
    return Result.Ok(Child { pid: pid, stdin: int(pin[1]), stdout: int(pout[0]), stderr: int(perr[0]) });
}

/// Close both ends of the first `n` pipes in `fds`.
fn closeAll(fds: []i32, n: int) {
    for i in 0..n * 2 {
        sys.close(int(fds[i]));
    }
}

/// `name` itself when it has a `/`, else the first executable `dir/name` on `PATH`. "" when none.
pub fn findProgram(name: string, arena: &Arena): string {
    for i in 0..name.len {
        if name[i] == 47 {
            return name;
        }
    }
    let path = sys.env("PATH");
    if path.len == 0 {
        path = "/usr/local/bin:/usr/bin:/bin";
    }
    let start = 0;
    let i = 0;
    while i <= path.len {
        if i == path.len || path[i] == 58 {
            let dir = path[start..i];
            if dir.len == 0 {
                dir = ".";
            }
            let t = Text.new(arena);
            t.pushStr(dir);
            t.push(47);
            t.pushStr(name);
            let full = t.str();
            t.push(0);
            if sys.canExec(t.bytes.ptr as ptr) {
                return full;
            }
            start = i + 1;
        }
        i += 1;
    }
    return "";
}

/// NUL-terminated copy of `s` on `arena` (the returned bytes include the NUL).
fn cString(s: string, arena: &Arena): []u8 {
    let b = arena.alloc::<u8>(s.len + 1);
    for i in 0..s.len {
        b[i] = s[i];
    }
    b[s.len] = 0;
    return b;
}
