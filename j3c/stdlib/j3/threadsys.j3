/// Linux j3.threadsys (pthreads, `sigaltstack`). Same pub names as threadsys_windows.j3.
/// `j3.thread` is the API; this is its OS layer, picked by `[emit] target` the way `j3.sys` is.

module j3.threadsys;

use lib "c" as c {
    fn pthread_create(t: ptr, attr: ptr, f: fn(ptr): ptr, arg: ptr): i32;
    fn pthread_join(t: int, ret: ptr): i32;
    fn pthread_mutex_lock(m: ptr): i32;
    fn pthread_mutex_unlock(m: ptr): i32;
    fn pthread_mutex_trylock(m: ptr): i32;
    fn pthread_cond_wait(cv: ptr, m: ptr): i32;
    fn pthread_cond_signal(cv: ptr): i32;
    fn pthread_cond_broadcast(cv: ptr): i32;
    fn sysconf(name: i32): int;
}

use j3.sys.{ mmapAnon, munmap };

/// Linux amd64 `sigaltstack` (the debug crash handler declares the libc one).
const SYS_sigaltstack: int = 131;
/// `_SC_NPROCESSORS_ONLN`.
const SC_NPROCESSORS_ONLN: int = 84;
/// Bytes of each thread's crash stack, so a stack overflow can still print a trace.
const ALT_STACK: int = 65536;

/// Logical cores.
pub fn cores(): int {
    return c.sysconf(SC_NPROCESSORS_ONLN);
}

/// Start `f(arg)` on a new thread. Returns the thread handle in `out`; false when it failed.
pub fn create(out: ptr, f: fn(ptr): ptr, arg: ptr): bool {
    return c.pthread_create(out, 0 as ptr, f, arg) == 0;
}

/// Wait for the thread `h` (what `create` stored in `out`).
pub fn join(h: int) {
    c.pthread_join(h, 0 as ptr);
}

/// Called first on a new thread: give it a crash stack. Returns a token for `leave`.
pub fn enter(): ptr {
    let stack = mmapAnon(ALT_STACK);
    let ss: [3]int = [stack as int, 0, ALT_STACK];
    @syscall(SYS_sigaltstack, &ss[0] as ptr, 0);
    return stack;
}

/// Called last on a thread, with what `enter` returned.
pub fn leave(token: ptr) {
    let off: [3]int = [0, 2, 0];
    @syscall(SYS_sigaltstack, &off[0] as ptr, 0);
    munmap(token, ALT_STACK);
}

/// Lock the mutex at `m` (a zeroed `j3.thread.Mutex`).
pub fn lock(m: ptr) {
    c.pthread_mutex_lock(m);
}

pub fn unlock(m: ptr) {
    c.pthread_mutex_unlock(m);
}

/// True when it took the lock.
pub fn tryLock(m: ptr): bool {
    return c.pthread_mutex_trylock(m) == 0;
}

/// Release `m`, sleep on `cv` until signalled, take `m` again.
pub fn wait(cv: ptr, m: ptr) {
    c.pthread_cond_wait(cv, m);
}

pub fn signal(cv: ptr) {
    c.pthread_cond_signal(cv);
}

pub fn broadcast(cv: ptr) {
    c.pthread_cond_broadcast(cv);
}
