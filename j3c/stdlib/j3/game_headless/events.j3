// Part of j3.game (headless stand-ins: init, poll, clipboard, cursor, keys, mouse, pad); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// Headless stand-in: no window.
pub fn init(title: string, width: int, height: int) {
}

/// Headless stand-in: no GL window.
pub fn initGl(title: string, width: int, height: int) {
}

/// Headless stand-in: the window size (`windowSize`), the same as `j3.game.windowPixels` without a high-DPI drawable.
pub fn windowPixels(): Vec2 {
    return windowSize();
}

/// Headless stand-in: there is no frame to read.
pub fn readWindow(out: []u8): bool {
    return false;
}

/// Headless stand-in: no GL window.
pub fn initGlHidden(title: string, width: int, height: int) {
}

/// Whether this session uses an OpenGL context (always false headless).
pub fn usingGl(): bool {
    return false;
}

/// Whether the GL context is OpenGL ES (always false headless).
pub fn isGles(): bool {
    return false;
}

/// Resolve an OpenGL entry point (always 0 headless).
pub fn glProc(name: string): ptr {
    return 0;
}

/// Register a GL teardown callback (no-op headless).
pub fn setGlShutdown(cb: fn()) {
}

/// Register another GL teardown callback (no-op headless).
pub fn addGlShutdown(cb: fn()) {
}

/// Tear down the platform (no-op headless).
pub fn destroy() {
}

/// Advance one frame; returns a fixed ~60 Hz dt.
pub fn poll(): f32 {
    return 0.016;
}

/// Dt from the last `poll` (fixed 0.016 headless).
pub fn lastDt(): f32 {
    return 0.016;
}

/// Store the leftover fixed-step fraction (no-op headless).
pub fn setFrameAlpha(a: f32) {
}

/// Leftover fixed-step fraction (always 0 headless).
pub fn frameAlpha(): f32 {
    return 0;
}

/// Start or stop text input (no-op headless).
pub fn textInput(on: bool) {
}

/// IME composition string (always empty headless).
pub fn textComposing(): string {
    return "";
}

/// Tell the IME where the caret is (no-op headless).
pub fn textInputRect(x: f32, y: f32, w: f32, h: f32) {
}

/// Text entered since the last poll (always empty headless).
pub fn textTyped(): string {
    return "";
}

/// IME caret in `textComposing` (always 0 headless).
pub fn textComposingCaret(): int {
    return 0;
}

/// Fake key (no-op in this SDL-free build; the SDL `j3.game` under `--headless` takes it).
pub fn simKey(key: Key, down: bool) {
}

/// Fake typed text (no-op in this SDL-free build).
pub fn simText(s: string) {
}

/// Fake IME composition (no-op in this SDL-free build).
pub fn simPreedit(s: string, caret: int) {
}

/// Fake file drop (no-op in this SDL-free build).
pub fn simDrop(path: string) {
}

/// Fake cursor move (no-op in this SDL-free build; the SDL `j3.game` under `--headless` takes it).
pub fn simMouse(x: f32, y: f32) {
}

/// Fake mouse button (no-op in this SDL-free build).
pub fn simButton(btn: Mouse, down: bool) {
}

/// Fake wheel (no-op in this SDL-free build).
pub fn simWheel(dy: f32) {
}

/// Dropped file path (always empty headless).
pub fn droppedFile(): string {
    return "";
}

/// Clipboard text (always empty headless).
pub fn clipboard(): string {
    return "";
}

/// Set clipboard text (no-op headless).
pub fn setClipboard(s: string) {
}

/// Clipboard MIME types (always empty headless).
pub fn clipboardTypes(): []string {
    return []string { ptr: &NO_TYPES[0], len: 0 };
}

/// Clipboard bytes for a MIME type (always empty headless).
pub fn clipboardData(mime: string): []u8 {
    return []u8 { ptr: &NO_BYTES[0], len: 0 };
}

/// What a drag out of the window is doing (always `Idle` headless).
pub enum DragState {
    /// No drag.
    Idle,
    /// The pointer carries the files.
    Dragging,
    /// Released over an app that took the files.
    Dropped,
    /// Released where nothing takes files, or Escape.
    Cancelled,
}

/// Drag files out of the window (always false headless).
pub fn dragFiles(paths: []string): bool {
    return false;
}

/// The drag's state (always `Idle` headless).
pub fn dragState(): DragState {
    return DragState.Idle;
}

#[singleton]
let NO_TYPES: [1]string;
#[singleton]
let NO_BYTES: [1]u8;

/// System mouse cursor shapes.
pub enum Cursor {
    Arrow,
    Text,
    Crosshair,
    ResizeAcross,
    ResizeUpDown,
    Move,
    Hand,
    Wait,
    NotAllowed,
}

/// No cursor headless.
pub fn setCursor(c: Cursor) {
}

/// Frames since init (always 0 headless).
pub fn frameCount(): int {
    return 0;
}

/// Milliseconds since start (always 0 headless).
/// No fixed step headless.
pub fn fixedDt(): f32 {
    return 0.0;
}

pub fn ticks(): int {
    return 0;
}

/// Request that the main loop exit (no-op headless).
pub fn requestQuit() {
}

/// True while `key` is held (Escape is always down headless).
pub fn keyDown(key: Key): bool {
    return key == Key.Escape;
}

/// True on the frame `key` went down (always false headless).
pub fn keyPressed(key: Key): bool {
    return false;
}

/// True on the frame `key` went up (always false headless).
pub fn keyReleased(key: Key): bool {
    return false;
}

pub fn keyDownRaw(key: Key): bool {
    return keyDown(key);
}

pub fn keyPressedRaw(key: Key): bool {
    return false;
}

/// No-op headless.
pub fn takeKeys(on: bool) {
}

pub fn keysTaken(): bool {
    return false;
}

/// Cursor position in window pixels (always origin headless).
pub fn mousePos(): Vec2 {
    return Vec2 { x: 0, y: 0 };
}

/// True while `btn` is held (always false headless).
pub fn mouseDown(btn: Mouse): bool {
    return false;
}

/// True on the frame `btn` went down (always false headless).
pub fn mousePressed(btn: Mouse): bool {
    return false;
}

/// True on the frame `btn` went up (always false headless).
pub fn mouseReleased(btn: Mouse): bool {
    return false;
}

/// Mouse wheel delta this frame (always 0 headless).
pub fn mouseWheel(): f32 {
    return 0;
}

/// Enable or disable relative mouse capture (no-op headless).
pub fn captureMouse(on: bool) {
}

/// Whether relative mouse capture is on (always false headless).
pub fn mouseCaptured(): bool {
    return false;
}

/// Relative mouse motion since last `poll` (always zero headless).
pub fn mouseDelta(): Vec2 {
    return Vec2 { x: 0, y: 0 };
}

/// True while pad `i` holds `btn` (always false headless).
pub fn padDown(i: int, btn: Pad): bool {
    return false;
}

/// True on the frame pad `i` pressed `btn` (always false headless).
pub fn padPressed(i: int, btn: Pad): bool {
    return false;
}

/// Normalized pad axis with deadzone (always 0 headless).
pub fn padAxis(i: int, axis: Axis): f32 {
    return 0;
}
