// Part of j3.game (headless stand-ins: idle sleep); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// `idleReport` value for "nothing is due".
pub const IDLE_FOREVER: int = 1000000;

/// Sleeping through idle frames: a no-op headless (`game.j3` has the real one).
pub fn idleReport(ms: int) {
}

/// Wake a sleeping loop (nothing sleeps headless).
pub fn idleWake() {
}

/// Nothing sleeps headless.
pub fn wakeAt(ms: int) {
}

/// Same rule as `game.j3`.
pub fn idleClampWake(sleepMs: int, wakeAtMs: int, nowMs: int): int {
    if sleepMs <= 0 || wakeAtMs <= 0 { return sleepMs; }
    let left = wakeAtMs - nowMs;
    if left <= 0 { return 0; }
    return if left < sleepMs { left } else { sleepMs };
}

/// Same rule as `game.j3`, so tests of the decision run headless.
pub fn idleSleepMs(hosted: bool, allowed: bool, reportMs: int, capMs: int): int {
    if !hosted || !allowed || reportMs <= 0 { return 0; }
    if reportMs < capMs { return reportMs; }
    return capMs;
}

/// Never headless.
pub fn idleSkipAllowed(): bool {
    return false;
}

/// Frames shown so far.
pub fn framesPresented(): int {
    return 0;
}

/// Never sleeps headless.
pub fn idleWait(): bool {
    return false;
}

/// Never sleeps headless.
pub fn idleWoke(): bool {
    return false;
}
