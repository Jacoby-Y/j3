// Part of j3.game (headless stand-ins: profiling and the 2D painter); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// GPU zones, as in `game.j3`. Nothing is timed here.
pub const ZONE_SHADOW: int = 0;
pub const ZONE_CAMERA: int = 1;
pub const ZONE_UI: int = 2;
pub const ZONE_UI_BLUR: int = 3;
pub const ZONE_UI_LAYER: int = 4;
pub const UI_BUILD: int = 0;
pub const UI_STYLE: int = 1;
pub const UI_LAYOUT: int = 2;
pub const UI_PAINT: int = 3;
pub const PROF_BLURS: int = 9;
pub const PROF_LAYERS: int = 10;
/// No-ops: the F4 UI profiler needs a window.
pub fn profUiStart() {}
pub fn profUiMark(_k: int) {}
pub fn profUiCount(_k: int) {}
pub fn profUiZone(_z: int): int { return 0; }

/// Same fields as `game.j3`; always zero here.
pub struct FrameStats {
    draws: int = 0;
    tris: int = 0;
    frameMs: f32 = 0;
    cpuMs: f32 = 0;
    sceneMs: f32 = 0;
    shadowMs: f32 = 0;
    cameraMs: f32 = 0;
    uiMs: f32 = 0;
}

/// Most recently completed frame, without smoothing. GPU timings arrive asynchronously.
pub fn lastFrameStats(): FrameStats { return FrameStats {}; }

/// Zeros.
pub fn frameStats(): FrameStats { return FrameStats {}; }
/// No-op.
pub fn profDraw(_tris: int) {}
/// No-op headless: queue one 2D instance (see `game.j3`).
pub fn p2Push(
    kind: int, x: f32, y: f32, w: f32, h: f32, u0: f32, v0: f32, du: f32, dv: f32,
    c1: Color, c2: Color, p0: f32, p1: f32, p2: f32, p3: f32, bw: f32, tex: u32,
) {}
pub fn p2BackdropBase(): u32 { return 0; }
pub fn p2SetBackdropBase(tex: u32) {}
pub fn p2SurfaceBegin(w: int, h: int) {}
pub fn p2SurfaceEnd() {}
pub fn p2ScreenPoint(p: Vec2): Vec2 { return p; }
pub fn p2CompositeTexture(tex: u32, alpha: f32) {}
/// No-op headless.
pub fn p2BackdropBlur(x: f32, y: f32, w: f32, h: f32, tl: f32, tr: f32, br: f32, bl: f32, radius: f32, alpha: f32) {}
/// No-op headless.
pub fn p2Flush() {}
/// No-op headless.
pub fn p2Watch(on: bool) {}
/// Nothing is drawn headless: 0.
pub fn p2Watched(): u64 { return 0; }
/// No-op headless.
pub fn p2TextureFilter(tex: u32, nearest: bool) {}
/// Zero headless.
pub fn drawsNow(): int { return 0; }
/// No-op headless.
pub const RAMP_W: int = 256;
/// No-op headless.
pub const RAMP_ROWS: int = 64;
/// No-op headless.
pub fn p2RampRow(row: int, texels: ptr) {}
/// No-op headless.
pub fn p2Clip(on: bool, x0: f32, y0: f32, x1: f32, y1: f32) {}
/// No-op headless.
pub fn p2Shape(slot: int, pts: ptr, n: int, evenOdd: bool) {}
/// No-op headless.
pub fn p2ClipShapes(n: int, pts: ptr, c0: int, c1: int, c2: int, c3: int) {}
/// No-op headless.
pub fn p2Mask(kind: int, row: int, angle: f32, x: f32, y: f32, w: f32, h: f32) {}
/// No-op headless.
pub fn p2PushView(pos: Vec2, size: Vec2) {}
/// No-op headless.
pub fn p2Affine(on: bool, a: f32, b: f32, c: f32, d: f32, tx: f32, ty: f32) {}
/// No-op headless.
pub fn p2PopView() {}
/// No-op headless.
pub fn p2Text(font: Font, pos: Vec2, msg: string, color: Color, scale: f32) {}

pub fn p2TextBold(font: Font, pos: Vec2, msg: string, color: Color, scale: f32) {}
/// No-op.
pub fn profScene(_us: int) {}
/// No-op.
pub fn profZone(_z: int) {}
/// `ticks` in microseconds.
pub fn micros(): int { return ticks() * 1000; }

/// `$name`, or "" when unset. (Headless: always empty.)
pub fn env(name: string): string {
    return "";
}
