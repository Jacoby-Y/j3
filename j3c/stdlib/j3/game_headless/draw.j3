// Part of j3.game (headless stand-ins: draw color, rects, textures); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// Set the current draw color (no-op headless).
pub fn setColor(c: Color) {
}

/// Clear the backbuffer to black (no-op headless).
pub fn clear() {
}

/// Clear the backbuffer to `c` (no-op headless).
pub fn clearTo(c: Color) {
}

/// Fill a screen-space axis-aligned rect (no-op headless).
pub fn drawRect(pos: Vec2, size: Vec2) {
}

/// Fill a world-space rect through `cam` (no-op headless).
pub fn drawRectCam(cam: Camera, pos: Vec2, size: Vec2) {
