// Part of j3.game (headless stand-ins: touch); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// One finger on the touch screen (none exist headless).
pub struct Finger {
    /// SDL's finger id.
    id: int;
    /// Position in `mousePos` pixels.
    x: f32;
    /// See `x`.
    y: f32;
    /// True on the down frame.
    down: bool;
    /// True while on the screen.
    held: bool;
    /// True on the up frame.
    up: bool;
}

/// Fingers on the screen (always 0 headless).
pub fn fingerCount(): int {
    return 0;
}

/// The `i`th finger (always the empty one headless, `id` -1).
pub fn finger(i: int): Finger {
    return Finger { id: -1, x: 0, y: 0, down: false, held: false, up: false };
}

/// Whether the app is in the background (never headless).
pub fn backgrounded(): bool {
    return false;
}

/// Wait for the foreground (returns at once headless).
pub fn waitBackground() {
}

/// Treat the Back scancode as a close request on every platform (no events headless).
pub fn backKeyAnywhere(on: bool) {
}
