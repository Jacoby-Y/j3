// Part of j3.game (headless stand-ins: window, display, scale, virtual size); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// Save the frame as a PNG (headless has no pixels: always false).
pub fn captureFrame(path: string): bool {
    return false;
}

/// Present the frame (no-op headless).
pub fn present() {
}

/// Whether quit was requested (always false headless).
pub fn quitRequested(): bool {
    return false;
}

/// No window to close headless.
pub fn holdClose(_on: bool) {
}

/// Never true headless.
pub fn closeRequested(): bool {
    return false;
}

/// Allow the user to resize the window (no-op headless).
pub fn setResizable(on: bool) {
}

/// Set the window minimum size (no-op headless).
pub fn setMinSize(w: int, h: int) {
}

/// Set the window title (no-op headless).
pub fn setWindowTitle(title: string) {
}

/// Set the window icon (no-op headless).
pub fn setWindowIcon(icon: Canvas) {
}

/// Set the window maximum size (no-op headless).
pub fn setMaxSize(w: int, h: int) {
}

/// Resize the window (no-op headless).
pub fn setWindowSize(w: int, h: int) {
}

/// How the game window sits on the screen (state only headless).
pub enum WindowMode {
    Windowed,
    Borderless,
    Fullscreen,
}

#[singleton]
let WIN_MODE: int;
#[singleton]
let VSYNC_ON: bool;
#[singleton]
let FPS_LIMIT: int;

/// Records the mode; there is no window headless.
pub fn setWindowMode(m: WindowMode) {
    match m {
        WindowMode.Windowed { WIN_MODE = 0; }
        WindowMode.Borderless { WIN_MODE = 1; }
        WindowMode.Fullscreen { WIN_MODE = 2; }
    }
}

/// The recorded mode.
pub fn windowMode(): WindowMode {
    if WIN_MODE == 1 { return WindowMode.Borderless; }
    if WIN_MODE == 2 { return WindowMode.Fullscreen; }
    return WindowMode.Windowed;
}

/// No-op headless.
pub fn setResolution(w: int, h: int) {
}

/// One display headless.
pub fn displayCount(): int {
    return 1;
}

/// Always display 0 headless.
pub fn currentDisplay(): int {
    return 0;
}

/// "Display" headless.
pub fn displayName(i: int): string {
    return "Display";
}

/// No-op headless.
pub fn moveToDisplay(i: int) {
}

/// 640x360 headless.
pub fn desktopSize(display: int): Vec2 {
    return Vec2 { x: 640, y: 360 };
}

/// One resolution (640x360) headless.
pub fn resolutionCount(display: int): int {
    return 1;
}

/// 640x360 for index 0, else (0, 0).
pub fn resolutionAt(display: int, i: int): Vec2 {
    if i == 0 { return Vec2 { x: 640, y: 360 }; }
    return Vec2 { x: 0, y: 0 };
}

/// 60 headless.
pub fn refreshRate(): int {
    return 60;
}

/// Records the setting headless.
pub fn setVsync(on: bool) {
    VSYNC_ON = on;
}

/// The recorded setting.
pub fn vsync(): bool {
    return VSYNC_ON;
}

/// Records the cap headless (nothing waits).
pub fn setFpsLimit(fps: int) {
    FPS_LIMIT = fps;
    if fps < 0 { FPS_LIMIT = 0; }
}

/// The recorded cap.
pub fn fpsLimit(): int {
    return FPS_LIMIT;
}

/// Always true headless.
pub fn windowFocused(): bool {
    return true;
}

/// No-op headless.
pub fn setMaximized(on: bool) {
}

/// No-op headless.
pub fn centerWindow() {
}

/// Current window size in pixels (fixed 640×360 headless), or the virtual size.
pub fn windowSize(): Vec2 {
    if VIRT_W > 0 { return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) }; }
    return Vec2 { x: 640, y: 360 };
}

/// Same as `windowSize` headless (no high-DPI drawable).
pub fn drawSize(): Vec2 {
    return windowSize();
}

/// No-op headless.
pub fn setHiDpi(on: bool) {
}

/// Always 1 headless.
pub fn dpiScale(): f32 {
    return 1.0;
}

#[singleton]
let VIRT_W: int;
#[singleton]
let VIRT_H: int;

/// Same as `game.j3`: windowSize reports this size (no drawing headless).
pub fn setVirtualSize(w: int, h: int) {
    if w < 1 || h < 1 { VIRT_W = 0; VIRT_H = 0; } else { VIRT_W = w; VIRT_H = h; }
}

/// The size set by `setVirtualSize`, or 0 by 0 while it is off.
pub fn virtualSize(): Vec2 {
    return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) };
}

/// The virtual screen in the (640 by 360) window, as in `game.j3`.
pub fn screenRect(): Rect {
    return fit(640, 360, VIRT_W, VIRT_H);
}

/// The whole 640 by 360 window as a GL rect.
pub fn p2FbRect(): GlRect {
    return GlRect { x: 0, y: 0, w: 640, h: 360 };
}

/// A virtual-pixel rect as a GL rect, as in `game.j3`.
pub fn p2GlRect(x: f32, y: f32, w: f32, h: f32): GlRect {
    return glRect(screenRect(), 360, x, y, w, h);
}

/// No-op headless.
pub fn setUiScale(s: f32) {
}

/// Always 1 headless.
pub fn paintScale(): f32 {
    return 1.0;
}

/// Always 1 headless.
pub fn uiScale(): f32 {
    return 1.0;
}

/// Same as `windowSize` headless.
pub fn uiSize(): Vec2 {
    return windowSize();
}

/// Same as `j3.game.WindowHit`.
pub enum WindowHit {
    Normal,
    Drag,
    ResizeTop,
    ResizeTopRight,
    ResizeRight,
    ResizeBottomRight,
    ResizeBottom,
    ResizeBottomLeft,
    ResizeLeft,
    ResizeTopLeft,
}

/// Same as `j3.game.WinRect`.
pub struct WinRect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

