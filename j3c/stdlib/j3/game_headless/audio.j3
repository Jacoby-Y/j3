// Part of j3.game (headless stand-ins: sounds and music); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// Load a sound sample (empty handle headless).
pub fn loadSound(path: string): Sound {
    return Sound { raw: 0 };
}

/// Open a PCM output stream (always empty headless).
pub fn openAudioStream(rate: int, channels: int): AudioStream {
    return AudioStream { raw: 0, rate: rate, channels: channels };
}

/// Try to load a sound (empty handle headless).
pub fn tryLoadSound(path: string): Sound {
    return Sound { raw: 0 };
}

/// Try to load a sound from a C string path (empty handle headless).
pub fn tryLoadSoundC(path: cstr): Sound {
    return Sound { raw: 0 };
}

/// Play a sound once (no-op headless). Returns `-1`.
pub fn play(sound: Sound): int {
    return 0 - 1;
}

/// Play a sound with Mix-style loop count (no-op headless). Returns `-1`.
pub fn playLoops(sound: Sound, loops: int): int {
    return 0 - 1;
}

/// Play on the sfx (`0`) or voice (`1`) group (no-op headless). Returns `-1`.
pub fn playGroup(sound: Sound, group: int, loops: int): int {
    return 0 - 1;
}

/// Set a group's volume (no-op headless).
pub fn setGroupVolume(group: int, volume: int) {
}

/// Fade a sound in (no-op headless). Returns `-1`.
pub fn fadeIn(sound: Sound, group: int, ms: int): int {
    return 0 - 1;
}

/// Fade a channel out (no-op headless).
pub fn fadeOut(channel: int, ms: int) {
}

/// Place a channel in the stereo field (no-op headless).
pub fn setPosition(channel: int, angle: int, distance: int) {
}

/// Stop all sound channels (no-op headless).
pub fn stop() {
}

/// Free a sound (no-op headless).
pub fn destroySound(sound: Sound) {
}

/// Load looping music (empty handle headless).
pub fn loadMusic(path: string): Music {
    return Music { raw: 0 };
}

/// Try to load music (empty handle headless).
pub fn tryLoadMusic(path: string): Music {
    return Music { raw: 0 };
}

/// Try to load music from a C string path (empty handle headless).
pub fn tryLoadMusicC(path: cstr): Music {
    return Music { raw: 0 };
}

/// Start music looping (no-op headless).
pub fn playMusic(music: Music) {
}

/// Fade music in (no-op headless).
pub fn fadeInMusic(music: Music, ms: int) {
}

/// Fade music out (no-op headless).
pub fn fadeOutMusic(ms: int) {
}

/// Stop the music channel (no-op headless).
pub fn stopMusic() {
}

/// Free music (no-op headless).
pub fn destroyMusic(music: Music) {
}

/// Set sound channel volume 0..128 (no-op headless).
pub fn setVolume(volume: int) {
}

/// Set music volume 0..128 (no-op headless).
pub fn setMusicVolume(volume: int) {
}
