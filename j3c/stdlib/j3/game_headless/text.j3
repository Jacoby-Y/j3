// Part of j3.game (headless stand-ins: fonts and text); the module doc and `use`s are in ../game_headless.j3.
module j3.game;

/// Load a font at point size (empty handle headless).
pub fn loadFont(path: string, size: int): Font {
    return Font { raw: 0 };
}

/// Try to load a font (empty handle headless).
pub fn tryLoadFont(path: string, size: int): Font {
    return Font { raw: 0 };
}

/// Try to load a font from a C string path (empty handle headless).
pub fn tryLoadFontC(path: cstr, size: int): Font {
    return Font { raw: 0 };
}

/// Rasterize UTF-8 text to a texture (empty handle headless).
pub fn bakeText(font: Font, msg: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Stand-in text size so layout math typechecks without SDL_ttf.
pub fn textSize(font: Font, msg: string): Vec2 {
    return textSizeBytes(font, []u8 { ptr: msg.ptr, len: msg.len });
}

/// Stand-in text size: `8` pixels per byte, `16` tall.
pub fn textSizeBytes(font: Font, msg: []u8): Vec2 {
    return Vec2 { x: f32(8 * msg.len), y: 16 };
}

/// Bake and draw text at a screen position (no-op headless).
pub fn drawText(font: Font, pos: Vec2, msg: string) {
}

/// Emboldened draw (no-op headless).
pub fn drawTextBold(font: Font, pos: Vec2, msg: string) {
}

/// Emboldened measure. Same stand-in as `textSize`.
pub fn textSizeBold(font: Font, msg: string): Vec2 {
    return textSize(font, msg);
}

/// Typographic options (no effect headless: every byte is 8 wide).
pub struct TextMode {
    tabular: bool;
    letterSp: f32;
    wordSp: f32;
    shaped: bool;
}

/// Returns `m` (nothing is kept headless).
pub fn setTextMode(m: TextMode): TextMode {
    return m;
}

/// Stand-in layout width: `8` pixels per byte.
pub fn textWidth(font: Font, msg: []u8, bold: bool): f32 {
    return f32(8 * msg.len);
}

/// Stand-in: every code point is there.
pub fn fontHas(font: Font, cp: int): bool {
    return true;
}

/// Stand-in line height.
pub fn fontLine(font: Font): int {
    return 16;
}

/// Stand-in ascent.
pub fn fontAscent(font: Font): int {
    return 12;
}

/// Emboldened bake (empty handle headless).
pub fn bakeTextBold(font: Font, msg: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Rasterize UTF-8 bytes to a texture (empty handle headless).
pub fn bakeTextBytes(font: Font, msg: []u8): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Bake and draw UTF-8 bytes at a screen position (no-op headless).
pub fn drawTextBytes(font: Font, pos: Vec2, msg: []u8) {
}

/// Close a font (no-op headless).
pub fn destroyFont(font: Font) {
}
