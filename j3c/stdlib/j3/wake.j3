module j3.wake;

// One slot for "the main loop should run a frame": `j3.game` fills it with its idle wake when a window opens, and cross-thread
// hand-offs (`j3.thread.Queue`) call it, so a worker's result is drawn on the next frame even while the app sleeps between idle
// frames. Workers never need to know about the UI. Its own module so `j3.thread` does not link SDL.

#[singleton]
let HOOK: fn();

/// Set the wake (`j3.game` does, once its window exists).
pub fn setHook(f: fn()) {
    HOOK = f;
}

/// Ask the main loop for a frame. Any thread; a no-op until a hook is set.
pub fn wake() {
    let f = HOOK;
    if f as ptr != 0 as ptr {
        f();
    }
}
