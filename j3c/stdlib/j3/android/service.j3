/// Android: run in the background.
/// Keeps the process and its sockets alive while the app is in the background or the screen is
/// off: a foreground service (with the persistent notification Android requires) holding a
/// partial wake lock. Needs `[android] foreground_service = "connectedDevice"` (or `"dataSync"`)
/// in j3.toml; without it, and off Android, `keepAlive` does nothing and returns false.
/// Call `keepAlive(true)` while the app is in the foreground (Android 12+ refuses to start a
/// foreground service from the background), and `keepAlive(false)` when the work is done: the
/// wake lock costs battery.

module j3.android.service;

use j3.android;

/// Start (`true`) or stop (`false`) the foreground service. True when the request went out.
pub fn keepAlive(on: bool): bool {
    let v = 0;
    if on {
        v = 1;
    }
    let a: [1]int = [v];
    return android.call("j3KeepAlive", "(Z)Z", a[:]);
}
