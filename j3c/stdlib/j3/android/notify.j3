/// Android notifications.
/// `post` shows one (or replaces the one with that id); tapping it
/// brings the app to the front, and `tapped` is true once after that. The first `post` asks for
/// POST_NOTIFICATIONS on Android 13+; until it is granted (or when it is denied) `post` returns
/// false, never crashes. Any thread: post from a network worker while the app is backgrounded.
/// Off Android every call returns false.
///
///     use j3.android.notify;
///     notify.post(1, "JZero", "Claude is waiting in api");
///     if notify.tapped() { ... }           // once per frame

module j3.android.notify;

use j3.android;

/// Show notification `id` with `title` and `text`, replacing an earlier one with the same id.
/// False when notifications are not allowed (yet), are turned off, or not on Android.
pub fn post(id: int, title: string, text: string): bool {
    let t = android.jstr(title, 0);
    let x = android.jstr(text, 1);
    let ok = false;
    if t != 0 && x != 0 {
        let a: [3]int = [id, t, x];
        ok = android.call("j3Notify", "(ILjava/lang/String;Ljava/lang/String;)Z", a[:]);
    }
    android.drop(t);
    android.drop(x);
    return ok;
}

/// Remove notification `id` if it is showing.
pub fn cancel(id: int): bool {
    let a: [1]int = [id];
    return android.call("j3NotifyCancel", "(I)Z", a[:]);
}

/// True once after the person tapped one of this app's notifications (call it once per frame).
pub fn tapped(): bool {
    let a: [1]int = [0];
    return android.call("j3NotifyTapped", "()Z", a[0..0]);
}
