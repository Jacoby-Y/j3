// Part of j3.math: Quat; the module doc and `use`s are in ../math.j3.
module j3.math;

// Unit quaternion, `w` is the real part. `toMat4` is a rotation, no translation.
/// Unit quaternion (`w` real); converts to a pure rotation matrix.
#[Debug]
pub struct Quat {
    /// Imaginary X.
    x: f32;
    /// Imaginary Y.
    y: f32;
    /// Imaginary Z.
    z: f32;
    /// Real part.
    w: f32;

    /// Identity rotation (`w = 1`).
    fn identity(): Quat {
        return Quat { x: 0, y: 0, z: 0, w: 1 };
    }

    /// Construct from four components.
    fn xyzw(x: f32, y: f32, z: f32, w: f32): Quat {
        return Quat { x: x, y: y, z: z, w: w };
    }

    /// Rotation of `radians` about a normalized `axis`.
    fn fromAxisAngle(axis: Vec3, radians: f32): Quat {
        let a = axis.normalize();
        let h = radians / 2;
        let s = sin(h);
        return Quat {
            x: a.x * s,
            y: a.y * s,
            z: a.z * s,
            w: cos(h),
        };
    }

    /// Quaternion product `this * other`.
    fn mul(this: Quat, other: Quat): Quat {
        return Quat {
            x: this.w * other.x + this.x * other.w + this.y * other.z - this.z * other.y,
            y: this.w * other.y - this.x * other.z + this.y * other.w + this.z * other.x,
            z: this.w * other.z + this.x * other.y - this.y * other.x + this.z * other.w,
            w: this.w * other.w - this.x * other.x - this.y * other.y - this.z * other.z,
        };
    }

    /// Euclidean length of the four components.
    fn length(this: Quat): f32 {
        return sqrt(this.x * this.x + this.y * this.y + this.z * this.z + this.w * this.w);
    }

    /// Unit quaternion, or identity if length is zero.
    fn normalize(this: Quat): Quat {
        let n = this.length();
        if n == 0 {
            return Quat.identity();
        }
        return Quat {
            x: this.x / n,
            y: this.y / n,
            z: this.z / n,
            w: this.w / n,
        };
    }

    /// Rotate vector `v` by this quaternion.
    fn rotate(this: Quat, v: Vec3): Vec3 {
        let q = Vec3 { x: this.x, y: this.y, z: this.z };
        let t = q.cross(v) * 2;
        return v + t * this.w + q.cross(t);
    }

    /// 4×4 rotation matrix with no translation (after normalizing).
    fn toMat4(this: Quat): Mat4 {
        let q = this.normalize();
        let xx = q.x * q.x;
        let yy = q.y * q.y;
        let zz = q.z * q.z;
        let xy = q.x * q.y;
        let xz = q.x * q.z;
        let yz = q.y * q.z;
        let wx = q.w * q.x;
        let wy = q.w * q.y;
        let wz = q.w * q.z;
        let out = Mat4.identity();
        out.m[0] = 1 - 2 * (yy + zz);
        out.m[1] = 2 * (xy + wz);
        out.m[2] = 2 * (xz - wy);
        out.m[4] = 2 * (xy - wz);
        out.m[5] = 1 - 2 * (xx + zz);
        out.m[6] = 2 * (yz + wx);
        out.m[8] = 2 * (xz + wy);
        out.m[9] = 2 * (yz - wx);
        out.m[10] = 1 - 2 * (xx + yy);
        return out;
    }
}
