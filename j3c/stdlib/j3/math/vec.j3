// Part of j3.math: Vec2 and Vec3; the module doc and `use`s are in ../math.j3.
module j3.math;

/// Two-dimensional `f32` vector with operators and common helpers.
#[Debug]
pub struct Vec2 {
    /// X component.
    x: f32;
    /// Y component.
    y: f32;

    /// Build from components.
    fn new(x: f32, y: f32): Vec2 {
        return Vec2 { x: x, y: y };
    }

    /// Component-wise addition.
    fn operator+(this: Vec2, other: Vec2): Vec2 {
        return Vec2 {
            x: this.x + other.x,
            y: this.y + other.y,
        };
    }

    /// Component-wise subtraction.
    fn operator-(this: Vec2, other: Vec2): Vec2 {
        return Vec2 {
            x: this.x - other.x,
            y: this.y - other.y,
        };
    }

    /// Scale both components by scalar `s`.
    fn operator*(this: Vec2, s: f32): Vec2 {
        return Vec2 {
            x: this.x * s,
            y: this.y * s,
        };
    }

    /// Exact component equality.
    fn operator==(this: Vec2, other: Vec2): bool {
        return this.x == other.x && this.y == other.y;
    }

    /// Euclidean length.
    fn length(this: Vec2): f32 {
        return sqrt(this.x * this.x + this.y * this.y);
    }

    /// Multiply both components in place by `s`.
    fn scale(this: &Vec2, s: f32) {
        this.x *= s;
        this.y *= s;
    }

    /// Dot product with `other`.
    fn dot(this: Vec2, other: Vec2): f32 {
        return this.x * other.x + this.y * other.y;
    }

    /// Unit vector in this direction, or unchanged if length is zero.
    fn normalize(this: Vec2): Vec2 {
        let n = this.length();
        if n == 0 {
            return this;
        }
        return Vec2 {
            x: this.x / n,
            y: this.y / n,
        };
    }

    /// Rotate by `radians` around the origin.
    fn rotate(this: Vec2, radians: f32): Vec2 {
        let c = cos(radians);
        let s = sin(radians);
        return Vec2 {
            x: this.x * c - this.y * s,
            y: this.x * s + this.y * c,
        };
    }

    /// Unit vector at angle `radians` from the +X axis.
    fn fromAngle(radians: f32): Vec2 {
        return Vec2 {
            x: cos(radians),
            y: sin(radians),
        };
    }
}

/// The `x y z` lanes of a `vec4f` as a `Vec3` (the `w` lane is dropped).
pub fn vec3FromVec4f(v: vec4f): Vec3 {
    return Vec3 { x: v.x, y: v.y, z: v.z };
}

/// Three-dimensional `f32` vector with operators and common helpers.
#[Debug]
pub struct Vec3 {
    /// X component.
    x: f32;
    /// Y component.
    y: f32;
    /// Z component.
    z: f32;

    /// `x y z w` as a `vec4f`, for SIMD code (`j3c doc lang`).
    fn toVec4f(this: Vec3, w: f32): vec4f {
        return vec4f(this.x, this.y, this.z, w);
    }

    /// Component-wise addition.
    fn operator+(this: Vec3, other: Vec3): Vec3 {
        return Vec3 {
            x: this.x + other.x,
            y: this.y + other.y,
            z: this.z + other.z,
        };
    }

    /// Component-wise subtraction.
    fn operator-(this: Vec3, other: Vec3): Vec3 {
        return Vec3 {
            x: this.x - other.x,
            y: this.y - other.y,
            z: this.z - other.z,
        };
    }

    /// Scale all components by scalar `s`.
    fn operator*(this: Vec3, s: f32): Vec3 {
        return Vec3 {
            x: this.x * s,
            y: this.y * s,
            z: this.z * s,
        };
    }

    /// Euclidean length.
    fn length(this: Vec3): f32 {
        return sqrt(this.x * this.x + this.y * this.y + this.z * this.z);
    }

    /// Dot product with `other`.
    fn dot(this: Vec3, other: Vec3): f32 {
        return this.x * other.x + this.y * other.y + this.z * other.z;
    }

    /// Cross product with `other`.
    fn cross(this: Vec3, other: Vec3): Vec3 {
        return Vec3 {
            x: this.y * other.z - this.z * other.y,
            y: this.z * other.x - this.x * other.z,
            z: this.x * other.y - this.y * other.x,
        };
    }

    /// Unit vector in this direction, or unchanged if length is zero.
    fn normalize(this: Vec3): Vec3 {
        let n = this.length();
        if n == 0 {
            return this;
        }
        return Vec3 {
            x: this.x / n,
            y: this.y / n,
            z: this.z / n,
        };
    }

    /// Drop Z and return `(x, y)` as a `Vec2`.
    fn xy(this: Vec3): Vec2 {
        return Vec2 { x: this.x, y: this.y };
    }

    /// Construct from three components.
    fn xyz(x: f32, y: f32, z: f32): Vec3 {
        return Vec3 { x: x, y: y, z: z };
    }

    /// The zero vector.
    fn zero(): Vec3 {
        return Vec3 { x: 0, y: 0, z: 0 };
    }

    /// Unit vector along +Y.
    fn up(): Vec3 {
        return Vec3 { x: 0, y: 1, z: 0 };
    }
}
