// Part of j3.game (window and GL init, DPI, destroy, size limits); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Create a centered accelerated 2D window and renderer.
pub fn init(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO + SDL_INIT_AUDIO + SDL_INIT_GAMECONTROLLER) != 0 {
        panic("SDL_Init");
    }

    platform.window = requirePtr(
        sdl.SDL_CreateWindow(
            cstr(title),
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            i32(width),
            i32(height),
            modeFlag(),
        ),
        "SDL_CreateWindow",
    );

    platform.renderer = requirePtr(
        sdl.SDL_CreateRenderer(
            platform.window,
            -1,
            if VSYNC_ON { SDL_RENDERER_ACCELERATED + SDL_RENDERER_PRESENTVSYNC } else { SDL_RENDERER_ACCELERATED },
        ),
        "SDL_CreateRenderer",
    );
    // `drawRect` passes alpha through. Blend keeps opaque fills solid and lets shadows fade.
    sdl.SDL_SetRenderDrawBlendMode(platform.renderer, SDL_BLENDMODE_BLEND);
    platform.gl = false;
    platform.glctx = 0;
    // A virtual size set before the window existed: SDL letterboxes the 2D renderer itself.
    if VIRT_W > 0 { sdl.SDL_RenderSetLogicalSize(platform.renderer, i32(VIRT_W), i32(VIRT_H)); }

    finishInit(width, height);
}

/// Create a centered OpenGL 3.3 core window and context.
pub fn initGl(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO + SDL_INIT_AUDIO + SDL_INIT_GAMECONTROLLER) != 0 {
        panic("SDL_Init");
    }
    glWindow(title, width, height, SDL_WINDOW_OPENGL);
}

/// An OpenGL 3.3 core context whose window never shows, for rendering to files (renders,
/// screenshots). No audio or game pads. `SDL_VIDEODRIVER=offscreen` runs it without a display.
pub fn initGlHidden(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO) != 0 {
        panic("SDL_Init");
    }
    glWindow(title, width, height, SDL_WINDOW_OPENGL + SDL_WINDOW_HIDDEN);
}

fn glWindow(title: string, width: int, height: int, flags: u32) {

    sdl.SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
    sdl.SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
    // ES 3.0 on Android or `J3_GLES=1`, else 3.3 core. Read once here, before the window exists.
    let wantEs = PLATFORM == 3 || envOn("J3_GLES");
    if wantEs {
        // An RGBA8 window: ES forbids copying an RGB framebuffer into an RGBA texture (`gfx.grab`, the
        // backdrop blur), and an EGL config may otherwise come without alpha (or as RGB565).
        sdl.SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_ALPHA_SIZE, 8);
        if PLATFORM != 3 {
            // Desktop Mesa/NVIDIA make ES contexts through EGL.
            sdl.SDL_SetHint(soCstr("SDL_OPENGL_ES_DRIVER"), cstr("1"));
            sdl.SDL_SetHint(soCstr("SDL_VIDEO_X11_FORCE_EGL"), cstr("1"));
        }
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
    } else {
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
    }

    if TRANSPARENT { transparentHints(); }
    platform.window = glRequire(wantEs,
        sdl.SDL_CreateWindow(
            cstr(title),
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            i32(width),
            i32(height),
            if HIDPI_ON { flags + modeFlag() + SDL_WINDOW_ALLOW_HIGHDPI } else { flags + modeFlag() },
        ),
        "SDL_CreateWindow",
    );

    platform.glctx = glRequire(wantEs, sdl.SDL_GL_CreateContext(platform.window), "SDL_GL_CreateContext");
    let profile: i32 = 0;
    sdl.SDL_GL_GetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, &profile as ptr);
    GLES = profile == SDL_GL_CONTEXT_PROFILE_ES;
    if wantEs && !GLES {
        panic("J3_GLES=1: the driver made a desktop GL context, not OpenGL ES 3.0");
    }
    if wantEs || envOn("J3_GL_INFO") { logGlInfo(); }
    requireGlVersion();
    platform.renderer = 0;
    platform.gl = true;
    if VSYNC_ON { applyVsync(); }
    finishInit(width, height);
    refreshDpi();
}

/// Panic with a clear message when the context is older than asked for: 3.3 desktop, ES 3.0.
/// Windows without a vendor driver hands out GDI Generic (1.1) for any request, and the first
/// draw would otherwise die on a missing GL function.
fn requireGlVersion() {
    let get = glProc("glGetString") as fn(u32): cstr;
    let ver = if get as ptr == 0 { 0 as cstr } else { get(0x1F02) };
    let text = if ver == 0 { "none" } else { []u8 { ptr: ver as &u8, len: libc.strlen(ver) } as string };
    let need = if GLES { 300 } else { 303 };
    if glVersionNum(text) >= need { return; }
    let rend = if get as ptr == 0 { 0 as cstr } else { get(0x1F01) };
    let rtext = if rend == 0 { "unknown renderer" } else { []u8 { ptr: rend as &u8, len: libc.strlen(rend) } as string };
    let want = if GLES { "OpenGL ES 3.0" } else { "OpenGL 3.3" };
    panic(Text.scratch().add(want).add(" required, got ").add(text).add(" (").add(rtext).add("). Install the GPU vendor's driver.").str());
}

/// `major * 100 + minor` from a `GL_VERSION` string: "4.6.0 NVIDIA 550" is 406, "OpenGL ES 3.2
/// Mesa" is 302, "1.1.0" is 101. 0 when it has no number.
fn glVersionNum(v: string): int {
    let i = 0;
    while i < v.len && (v[i] < 48 || v[i] > 57) { i += 1; }
    let major = 0;
    while i < v.len && v[i] >= 48 && v[i] <= 57 { major = major * 10 + int(v[i] - 48); i += 1; }
    if i >= v.len || v[i] != 46 { return major * 100; }
    i += 1;
    let minor = 0;
    while i < v.len && v[i] >= 48 && v[i] <= 57 { minor = minor * 10 + int(v[i] - 48); i += 1; }
    return major * 100 + minor;
}

/// Whether `$name` is `1`.
fn envOn(name: string): bool {
    let v = env(name);
    return v.len == 1 && v[0] == 49;
}

/// `requirePtr`, with one clear message when the ES context asked for by `J3_GLES=1` can't be made.
fn glRequire(wantEs: bool, p: ptr, what: string): ptr {
    if p == 0 && wantEs && PLATFORM != 3 {
        panic("J3_GLES=1: no OpenGL ES 3.0 context (SDL_VIDEO_X11_FORCE_EGL needs EGL with ES support)");
    }
    if p == 0 && same(what, "SDL_GL_CreateContext") {
        // Windows without a vendor driver (GDI Generic, GL 1.1) lands here: SDL can't make 3.3 core.
        let want = if wantEs { "OpenGL ES 3.0" } else { "OpenGL 3.3" };
        panic(Text.scratch().add(want).add(" is required but the graphics driver could not provide it (")
            .add(sdlError()).add("). Install or update the GPU vendor's driver.").str());
    }
    return requirePtr(p, what);
}

/// Whether the context is OpenGL ES (Android, or `J3_GLES=1` on desktop). Set once when the
/// context is made, from the profile SDL reports; false before `initGl` and headless.
pub fn isGles(): bool {
    return GLES;
}

#[singleton]
let GLES: bool;

/// `src` ready for `glShaderSource` on the current context: unchanged on desktop, rewritten for
/// GLSL ES 3.00 on ES (`j3.gfx.glsl.prep`). Every shader compile goes through it; call it at
/// compile time and hand the result to GL at once.
pub fn prepGl(src: string): string {
    return glsl.prep(src, GLES);
}

/// Whether `RGBA16F` can be a framebuffer attachment: always on desktop, on ES only with
/// `GL_EXT_color_buffer_float` or `GL_EXT_color_buffer_half_float`. Checked once; when missing it
/// says so once (stderr, and SDL_Log on Android) and callers use an `RGBA8` target instead.
pub fn floatTargets(): bool {
    if !GLES { return true; }
    if FLOAT_RT == 0 {
        let get = glProc("glGetString") as fn(u32): cstr;
        let ext = get(0x1F03);
        let ok = ext != 0 && (hasWord(ext, "GL_EXT_color_buffer_float") || hasWord(ext, "GL_EXT_color_buffer_half_float"));
        FLOAT_RT = if ok { 1 } else { -1 };
        if !ok { logGl("warning", "warning: %s", cstr("no GL_EXT_color_buffer_float: float render targets fall back to RGBA8")); }
    }
    return FLOAT_RT > 0;
}

/// 1 float render targets work, -1 they don't, 0 not checked yet.
#[singleton]
let FLOAT_RT: int;

/// Whether the space-separated extension list `list` names `word`.
fn hasWord(list: cstr, word: string): bool {
    let n = libc.strlen(list);
    let all = []u8 { ptr: list as &u8, len: n } as string;
    let at = 0;
    while at <= all.len - word.len {
        let hit = find(all[at..all.len] as string, word);
        if hit < 0 { return false; }
        let e = at + hit + word.len;
        if (at + hit == 0 || all[at + hit - 1] == 32) && (e == all.len || all[e] == 32) { return true; }
        at = e;
    }
    return false;
}

/// Print `GL_VERSION`, `GL_SHADING_LANGUAGE_VERSION` and `GL_RENDERER` to stderr, and on Android
/// through SDL_Log too (`adb logcat`).
fn logGlInfo() {
    let get = glProc("glGetString") as fn(u32): cstr;
    logGl("GL_VERSION", "GL_VERSION: %s", get(0x1F02));
    logGl("GL_SHADING_LANGUAGE_VERSION", "GL_SHADING_LANGUAGE_VERSION: %s", get(0x8B8C));
    logGl("GL_RENDERER", "GL_RENDERER: %s", get(0x1F01));
}

fn logGl(label: string, fmt: string, value: cstr) {
    if value == 0 { return; }
    write(2, label.ptr as ptr, label.len);
    write(2, ": ".ptr as ptr, 2);
    write(2, value as ptr, libc.strlen(value));
    write(2, "\n".ptr as ptr, 1);
    if PLATFORM == 3 { sdl.SDL_Log(cstr(fmt), value); }
}

/// Ask for a high-DPI drawable (`SDL_WINDOW_ALLOW_HIGHDPI`) when `initGl` creates the window, and
/// lay out in logical pixels: `windowSize`, `mousePos` and 2D drawing then work in window units and
/// are scaled by `dpiScale` onto the larger drawable (text stays sharp). Call it before `initGl`.
/// On Android the scale is the screen density (densityDpi / 160). Off by default, so 3D games
/// keep drawing in real pixels. `J3_UI_SCALE=1.5` forces a scale
/// without it (GL only; a letterboxed `setVirtualSize` already fits the physical window).
pub fn setHiDpi(on: bool) {
    HIDPI_ON = on;
}

/// Physical pixels per logical pixel for 2D drawing and `windowSize` (1 without `setHiDpi` or
/// `J3_UI_SCALE`). Fractional on Linux scaling setups.
pub fn dpiScale(): f32 {
    return DPI;
}

#[singleton]
let HIDPI_ON: bool;
/// Physical pixels per logical pixel for 2D drawing (`J3_UI_SCALE` or the drawable ratio).
#[singleton]
let DPI: f32 = 1.0;
/// Drawable pixels per SDL window unit (what scales `SDL_GetMouseState`).
#[singleton]
let PHYS: f32 = 1.0;

/// Re-read the drawable size and the scale factors (window created, resized or moved to another display).
fn refreshDpi() {
    if !platform.gl || platform.window == 0 {
        return;
    }
    let ww: i32 = 0;
    let wh: i32 = 0;
    let dw: i32 = 0;
    let dh: i32 = 0;
    sdl.SDL_GetWindowSize(platform.window, &ww as ptr, &wh as ptr);
    sdl.SDL_GL_GetDrawableSize(platform.window, &dw as ptr, &dh as ptr);
    PHYS = 1.0;
    if HIDPI_ON && ww > 0 && dw > 0 {
        PHYS = f32(dw) / f32(ww);
        platform.win_w = int(dw);
        platform.win_h = int(dh);
    }
    DPI = PHYS;
    if HIDPI_ON && PLATFORM == 3 {
        // Android's drawable is the window, so take the scale from the density (SDL fills ddpi from densityDpi)
        let ddpi: f32 = 0.0;
        let shown = sdl.SDL_GetWindowDisplayIndex(platform.window);
        if sdl.SDL_GetDisplayDPI(shown, &ddpi as ptr, 0, 0) == 0 && ddpi > 0.0 {
            DPI = ddpi / 160.0;
        }
    }
    let o = envNum("J3_UI_SCALE");
    if o > 0.0 {
        DPI = o;
        if o < 0.25 { DPI = 0.25; }
        if o > 8.0 { DPI = 8.0; }
    }
}

/// Shared post-window setup: keys, timing, pads, and input state.
fn finishInit(width: int, height: int) {
    platform.keys = requirePtr(sdl.SDL_GetKeyboardState(0), "SDL_GetKeyboardState");
    platform.last_ms = sdl.SDL_GetTicks();
    platform.color = Color { r: 255, g: 255, b: 255, a: 255 };
    platform.quit = false;
    platform.win_w = width;
    platform.win_h = height;
    platform.mouse = 0;
    platform.prev_mouse = 0;
    platform.wheel = 0;
    platform.pad_bits = 0;
    platform.prev_pad = 0;
    let i = 0;
    while i < 512 {
        prevKeys[i] = 0;
        i += 1;
    }
    ensurePads();
    frameInit();
}

/// Whether this session uses an OpenGL context.
pub fn usingGl(): bool {
    return platform.gl;
}

/// Resolve an OpenGL entry point by name.
pub fn glProc(name: string): ptr {
    return sdl.SDL_GL_GetProcAddress(cstr(name));
}

/// Register a callback run before the GL context is deleted.
pub fn setGlShutdown(cb: fn()) {
    onGlShutdown = cb as ptr;
}

/// Register another callback without replacing an existing GL renderer's teardown.
pub fn addGlShutdown(cb: fn()) {
    if nGlShutdowns >= glShutdowns.len {
        panic("too many GL shutdown callbacks");
    }
    glShutdowns[nGlShutdowns] = cb as ptr;
    nGlShutdowns += 1;
}

/// Release controllers, GL/renderer, window, and subsystems.
pub fn destroy() {
    if platform.pad0 != 0 {
        sdl.SDL_GameControllerClose(platform.pad0);
    }
    if platform.pad1 != 0 {
        sdl.SDL_GameControllerClose(platform.pad1);
    }
    if platform.glctx != 0 {
        if onGlShutdown != 0 {
            let halt = onGlShutdown as fn();
            halt();
            onGlShutdown = 0;
        }
        while nGlShutdowns > 0 {
            nGlShutdowns -= 1;
            let extraHalt = glShutdowns[nGlShutdowns] as fn();
            extraHalt();
            glShutdowns[nGlShutdowns] = 0;
        }
        sdl.SDL_GL_DeleteContext(platform.glctx);
        platform.glctx = 0;
    }
    if platform.renderer != 0 {
        sdl.SDL_DestroyRenderer(platform.renderer);
        platform.renderer = 0;
    }
    sdl.SDL_DestroyWindow(platform.window);
    if platform.audio {
        Mix_CloseAudio();
    }
    if platform.img {
        IMG_Quit();
    }
    if platform.fonts {
        TTF_Quit();
    }
    sdl.SDL_Quit();
    platform = Platform {
        window: 0,
        renderer: 0,
        keys: 0,
        last_ms: 0,
        color: Color { r: 255, g: 255, b: 255, a: 255 },
        pad0: 0,
        pad1: 0,
        quit: false,
        win_w: 0,
        win_h: 0,
    ui_scale: 1.0,
        mouse: 0,
        prev_mouse: 0,
        wheel: 0,
        audio: false,
        img: false,
        fonts: false,
        pad_bits: 0,
        prev_pad: 0,
        last_span: 16,
        frames: 0,
        gl: false,
        glctx: 0,
        mouse_dx: 0,
        mouse_dy: 0,
        captured: false,
    };
}

/// Let the game decide what closing the window does: it then only raises `closeRequested`.
pub fn holdClose(on: bool) {
    closeHeld = on;
}

/// True on the frame the window close button was hit while `holdClose` is on.
pub fn closeRequested(): bool {
    return closeAsked;
}

/// Whether quit was requested.
pub fn quitRequested(): bool {
    return platform.quit;
}

/// Allow the user to resize the window.
pub fn setResizable(on: bool) {
    let v: i32 = 0;
    if on {
        v = 1;
    }
    sdl.SDL_SetWindowResizable(platform.window, v);
}

/// Set the window minimum size.
pub fn setMinSize(w: int, h: int) {
    sdl.SDL_SetWindowMinimumSize(platform.window, i32(w), i32(h));
}

/// Set the window's title-bar and taskbar icon from an RGBA canvas (`j3.gfx.canvas`; 64x64 is plenty).
/// `App.run` sets one by itself: `[dist] icon` when it is a PNG, else the J3 logo.
pub fn setWindowIcon(icon: Canvas) {
    if platform.window == 0 || icon.w < 1 { return; }
    let surf = sdl.SDL_CreateRGBSurfaceWithFormatFrom(icon.pixels.ptr as ptr, icon.w, icon.h, 32, icon.w * 4, SDL_PIXELFORMAT_ABGR8888);
    if surf == 0 { return; }
    sdl.SDL_SetWindowIcon(platform.window, surf);
    sdl.SDL_FreeSurface(surf);
}

/// Set the window title (copied; up to the `cstr` scratch size). No window yet: no effect.
pub fn setWindowTitle(title: string) {
    if platform.window == 0 { return; }
    sdl.SDL_SetWindowTitle(platform.window, cstr(title));
}

/// Set the window maximum size.
pub fn setMaxSize(w: int, h: int) {
    sdl.SDL_SetWindowMaximumSize(platform.window, i32(w), i32(h));
}

/// Resize the window and cached size.
pub fn setWindowSize(w: int, h: int) {
    sdl.SDL_SetWindowSize(platform.window, i32(w), i32(h));
    platform.win_w = w;
    platform.win_h = h;
    refreshDpi();
}
