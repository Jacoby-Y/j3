// Part of j3.game (window, GL init, display modes, vsync, virtual size, ui scale, timing); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Create a centered accelerated 2D window and renderer.
pub fn init(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO + SDL_INIT_AUDIO + SDL_INIT_GAMECONTROLLER) != 0 {
        panic("SDL_Init");
    }

    platform.window = requirePtr(
        sdl.SDL_CreateWindow(
            cstr(title),
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            i32(width),
            i32(height),
            modeFlag(),
        ),
        "SDL_CreateWindow",
    );

    platform.renderer = requirePtr(
        sdl.SDL_CreateRenderer(
            platform.window,
            -1,
            if VSYNC_ON { SDL_RENDERER_ACCELERATED + SDL_RENDERER_PRESENTVSYNC } else { SDL_RENDERER_ACCELERATED },
        ),
        "SDL_CreateRenderer",
    );
    // `drawRect` passes alpha through. Blend keeps opaque fills solid and lets shadows fade.
    sdl.SDL_SetRenderDrawBlendMode(platform.renderer, SDL_BLENDMODE_BLEND);
    platform.gl = false;
    platform.glctx = 0;
    // A virtual size set before the window existed: SDL letterboxes the 2D renderer itself.
    if VIRT_W > 0 { sdl.SDL_RenderSetLogicalSize(platform.renderer, i32(VIRT_W), i32(VIRT_H)); }

    finishInit(width, height);
}

/// Create a centered OpenGL 3.3 core window and context.
pub fn initGl(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO + SDL_INIT_AUDIO + SDL_INIT_GAMECONTROLLER) != 0 {
        panic("SDL_Init");
    }
    glWindow(title, width, height, SDL_WINDOW_OPENGL);
}

/// An OpenGL 3.3 core context whose window never shows, for rendering to files (renders,
/// screenshots). No audio or game pads. `SDL_VIDEODRIVER=offscreen` runs it without a display.
pub fn initGlHidden(title: string, width: int, height: int) {
    if sdl.SDL_Init(SDL_INIT_VIDEO) != 0 {
        panic("SDL_Init");
    }
    glWindow(title, width, height, SDL_WINDOW_OPENGL + SDL_WINDOW_HIDDEN);
}

fn glWindow(title: string, width: int, height: int, flags: u32) {

    sdl.SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
    sdl.SDL_GL_SetAttribute(SDL_GL_DEPTH_SIZE, 24);
    // ES 3.0 on Android or `J3_GLES=1`, else 3.3 core. Read once here, before the window exists.
    let wantEs = PLATFORM == 3 || envOn("J3_GLES");
    if wantEs {
        // An RGBA8 window: ES forbids copying an RGB framebuffer into an RGBA texture (`gfx.grab`, the
        // backdrop blur), and an EGL config may otherwise come without alpha (or as RGB565).
        sdl.SDL_GL_SetAttribute(SDL_GL_RED_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_GREEN_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_BLUE_SIZE, 8);
        sdl.SDL_GL_SetAttribute(SDL_GL_ALPHA_SIZE, 8);
        if PLATFORM != 3 {
            // Desktop Mesa/NVIDIA make ES contexts through EGL.
            sdl.SDL_SetHint(soCstr("SDL_OPENGL_ES_DRIVER"), cstr("1"));
            sdl.SDL_SetHint(soCstr("SDL_VIDEO_X11_FORCE_EGL"), cstr("1"));
        }
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
    } else {
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 3);
        sdl.SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
    }

    platform.window = glRequire(wantEs,
        sdl.SDL_CreateWindow(
            cstr(title),
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            i32(width),
            i32(height),
            if HIDPI_ON { flags + modeFlag() + SDL_WINDOW_ALLOW_HIGHDPI } else { flags + modeFlag() },
        ),
        "SDL_CreateWindow",
    );

    platform.glctx = glRequire(wantEs, sdl.SDL_GL_CreateContext(platform.window), "SDL_GL_CreateContext");
    let profile: i32 = 0;
    sdl.SDL_GL_GetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, &profile as ptr);
    GLES = profile == SDL_GL_CONTEXT_PROFILE_ES;
    if wantEs && !GLES {
        panic("J3_GLES=1: the driver made a desktop GL context, not OpenGL ES 3.0");
    }
    platform.renderer = 0;
    platform.gl = true;
    if VSYNC_ON { applyVsync(); }
    finishInit(width, height);
    refreshDpi();
    if wantEs || envOn("J3_GL_INFO") { logGlInfo(); }
}

/// Whether `$name` is `1`.
fn envOn(name: string): bool {
    let v = env(name);
    return v.len == 1 && v[0] == 49;
}

/// `requirePtr`, with one clear message when the ES context asked for by `J3_GLES=1` can't be made.
fn glRequire(wantEs: bool, p: ptr, what: string): ptr {
    if p == 0 && wantEs && PLATFORM != 3 {
        panic("J3_GLES=1: no OpenGL ES 3.0 context (SDL_VIDEO_X11_FORCE_EGL needs EGL with ES support)");
    }
    return requirePtr(p, what);
}

/// Whether the context is OpenGL ES (Android, or `J3_GLES=1` on desktop). Set once when the
/// context is made, from the profile SDL reports; false before `initGl` and headless.
pub fn isGles(): bool {
    return GLES;
}

#[singleton]
let GLES: bool;

/// `src` ready for `glShaderSource` on the current context: unchanged on desktop, rewritten for
/// GLSL ES 3.00 on ES (`j3.gfx.glsl.prep`). Every shader compile goes through it; call it at
/// compile time and hand the result to GL at once.
pub fn prepGl(src: string): string {
    return glsl.prep(src, GLES);
}

/// Whether `RGBA16F` can be a framebuffer attachment: always on desktop, on ES only with
/// `GL_EXT_color_buffer_float` or `GL_EXT_color_buffer_half_float`. Checked once; when missing it
/// says so once (stderr, and SDL_Log on Android) and callers use an `RGBA8` target instead.
pub fn floatTargets(): bool {
    if !GLES { return true; }
    if FLOAT_RT == 0 {
        let get = glProc("glGetString") as fn(u32): cstr;
        let ext = get(0x1F03);
        let ok = ext != 0 && (hasWord(ext, "GL_EXT_color_buffer_float") || hasWord(ext, "GL_EXT_color_buffer_half_float"));
        FLOAT_RT = if ok { 1 } else { -1 };
        if !ok { logGl("warning", "warning: %s", cstr("no GL_EXT_color_buffer_float: float render targets fall back to RGBA8")); }
    }
    return FLOAT_RT > 0;
}

/// 1 float render targets work, -1 they don't, 0 not checked yet.
#[singleton]
let FLOAT_RT: int;

/// Whether the space-separated extension list `list` names `word`.
fn hasWord(list: cstr, word: string): bool {
    let n = libc.strlen(list);
    let all = []u8 { ptr: list as &u8, len: n } as string;
    let at = 0;
    while at <= all.len - word.len {
        let hit = find(all[at..all.len] as string, word);
        if hit < 0 { return false; }
        let e = at + hit + word.len;
        if (at + hit == 0 || all[at + hit - 1] == 32) && (e == all.len || all[e] == 32) { return true; }
        at = e;
    }
    return false;
}

/// Print `GL_VERSION`, `GL_SHADING_LANGUAGE_VERSION` and `GL_RENDERER` to stderr, and on Android
/// through SDL_Log too (`adb logcat`).
fn logGlInfo() {
    let get = glProc("glGetString") as fn(u32): cstr;
    logGl("GL_VERSION", "GL_VERSION: %s", get(0x1F02));
    logGl("GL_SHADING_LANGUAGE_VERSION", "GL_SHADING_LANGUAGE_VERSION: %s", get(0x8B8C));
    logGl("GL_RENDERER", "GL_RENDERER: %s", get(0x1F01));
}

fn logGl(label: string, fmt: string, value: cstr) {
    if value == 0 { return; }
    write(2, label.ptr as ptr, label.len);
    write(2, ": ".ptr as ptr, 2);
    write(2, value as ptr, libc.strlen(value));
    write(2, "\n".ptr as ptr, 1);
    if PLATFORM == 3 { sdl.SDL_Log(cstr(fmt), value); }
}

/// Ask for a high-DPI drawable (`SDL_WINDOW_ALLOW_HIGHDPI`) when `initGl` creates the window, and
/// lay out in logical pixels: `windowSize`, `mousePos` and 2D drawing then work in window units and
/// are scaled by `dpiScale` onto the larger drawable (text stays sharp). Call it before `initGl`.
/// On Android the scale is the screen density (densityDpi / 160). Off by default, so 3D games
/// keep drawing in real pixels. `J3_UI_SCALE=1.5` forces a scale
/// without it (GL only; a letterboxed `setVirtualSize` already fits the physical window).
pub fn setHiDpi(on: bool) {
    HIDPI_ON = on;
}

/// Physical pixels per logical pixel for 2D drawing and `windowSize` (1 without `setHiDpi` or
/// `J3_UI_SCALE`). Fractional on Linux scaling setups.
pub fn dpiScale(): f32 {
    return DPI;
}

#[singleton]
let HIDPI_ON: bool;
/// Physical pixels per logical pixel for 2D drawing (`J3_UI_SCALE` or the drawable ratio).
#[singleton]
let DPI: f32 = 1.0;
/// Drawable pixels per SDL window unit (what scales `SDL_GetMouseState`).
#[singleton]
let PHYS: f32 = 1.0;

/// Re-read the drawable size and the scale factors (window created, resized or moved to another display).
fn refreshDpi() {
    if !platform.gl || platform.window == 0 {
        return;
    }
    let ww: i32 = 0;
    let wh: i32 = 0;
    let dw: i32 = 0;
    let dh: i32 = 0;
    sdl.SDL_GetWindowSize(platform.window, &ww as ptr, &wh as ptr);
    sdl.SDL_GL_GetDrawableSize(platform.window, &dw as ptr, &dh as ptr);
    PHYS = 1.0;
    if HIDPI_ON && ww > 0 && dw > 0 {
        PHYS = f32(dw) / f32(ww);
        platform.win_w = int(dw);
        platform.win_h = int(dh);
    }
    DPI = PHYS;
    if HIDPI_ON && PLATFORM == 3 {
        // Android's drawable is the window, so take the scale from the density (SDL fills ddpi from densityDpi)
        let ddpi: f32 = 0.0;
        let shown = sdl.SDL_GetWindowDisplayIndex(platform.window);
        if sdl.SDL_GetDisplayDPI(shown, &ddpi as ptr, 0, 0) == 0 && ddpi > 0.0 {
            DPI = ddpi / 160.0;
        }
    }
    let o = envNum("J3_UI_SCALE");
    if o > 0.0 {
        DPI = o;
        if o < 0.25 { DPI = 0.25; }
        if o > 8.0 { DPI = 8.0; }
    }
}

/// Shared post-window setup: keys, timing, pads, and input state.
fn finishInit(width: int, height: int) {
    platform.keys = requirePtr(sdl.SDL_GetKeyboardState(0), "SDL_GetKeyboardState");
    platform.last_ms = sdl.SDL_GetTicks();
    platform.color = Color { r: 255, g: 255, b: 255, a: 255 };
    platform.quit = false;
    platform.win_w = width;
    platform.win_h = height;
    platform.mouse = 0;
    platform.prev_mouse = 0;
    platform.wheel = 0;
    platform.pad_bits = 0;
    platform.prev_pad = 0;
    let i = 0;
    while i < 512 {
        prevKeys[i] = 0;
        i += 1;
    }
    ensurePads();
}

/// Whether this session uses an OpenGL context.
pub fn usingGl(): bool {
    return platform.gl;
}

/// Resolve an OpenGL entry point by name.
pub fn glProc(name: string): ptr {
    return sdl.SDL_GL_GetProcAddress(cstr(name));
}

/// Register a callback run before the GL context is deleted.
pub fn setGlShutdown(cb: fn()) {
    onGlShutdown = cb as ptr;
}

/// Register another callback without replacing an existing GL renderer's teardown.
pub fn addGlShutdown(cb: fn()) {
    if nGlShutdowns >= glShutdowns.len {
        panic("too many GL shutdown callbacks");
    }
    glShutdowns[nGlShutdowns] = cb as ptr;
    nGlShutdowns += 1;
}

/// Release controllers, GL/renderer, window, and subsystems.
pub fn destroy() {
    if platform.pad0 != 0 {
        sdl.SDL_GameControllerClose(platform.pad0);
    }
    if platform.pad1 != 0 {
        sdl.SDL_GameControllerClose(platform.pad1);
    }
    if platform.glctx != 0 {
        if onGlShutdown != 0 {
            let halt = onGlShutdown as fn();
            halt();
            onGlShutdown = 0;
        }
        while nGlShutdowns > 0 {
            nGlShutdowns -= 1;
            let extraHalt = glShutdowns[nGlShutdowns] as fn();
            extraHalt();
            glShutdowns[nGlShutdowns] = 0;
        }
        sdl.SDL_GL_DeleteContext(platform.glctx);
        platform.glctx = 0;
    }
    if platform.renderer != 0 {
        sdl.SDL_DestroyRenderer(platform.renderer);
        platform.renderer = 0;
    }
    sdl.SDL_DestroyWindow(platform.window);
    if platform.audio {
        Mix_CloseAudio();
    }
    if platform.img {
        IMG_Quit();
    }
    if platform.fonts {
        TTF_Quit();
    }
    sdl.SDL_Quit();
    platform = Platform {
        window: 0,
        renderer: 0,
        keys: 0,
        last_ms: 0,
        color: Color { r: 255, g: 255, b: 255, a: 255 },
        pad0: 0,
        pad1: 0,
        quit: false,
        win_w: 0,
        win_h: 0,
    ui_scale: 1.0,
        mouse: 0,
        prev_mouse: 0,
        wheel: 0,
        audio: false,
        img: false,
        fonts: false,
        pad_bits: 0,
        prev_pad: 0,
        last_span: 16,
        frames: 0,
        gl: false,
        glctx: 0,
        mouse_dx: 0,
        mouse_dy: 0,
        captured: false,
    };
}

/// Let the game decide what closing the window does: it then only raises `closeRequested`.
pub fn holdClose(on: bool) {
    closeHeld = on;
}

/// True on the frame the window close button was hit while `holdClose` is on.
pub fn closeRequested(): bool {
    return closeAsked;
}

/// Whether quit was requested.
pub fn quitRequested(): bool {
    return platform.quit;
}

/// Allow the user to resize the window.
pub fn setResizable(on: bool) {
    let v: i32 = 0;
    if on {
        v = 1;
    }
    sdl.SDL_SetWindowResizable(platform.window, v);
}

/// Set the window minimum size.
pub fn setMinSize(w: int, h: int) {
    sdl.SDL_SetWindowMinimumSize(platform.window, i32(w), i32(h));
}

/// Set the window maximum size.
pub fn setMaxSize(w: int, h: int) {
    sdl.SDL_SetWindowMaximumSize(platform.window, i32(w), i32(h));
}

/// Resize the window and cached size.
pub fn setWindowSize(w: int, h: int) {
    sdl.SDL_SetWindowSize(platform.window, i32(w), i32(h));
    platform.win_w = w;
    platform.win_h = h;
    refreshDpi();
}

/// How the game window sits on the screen.
pub enum WindowMode {
    /// A normal window with a border, at the windowed size.
    Windowed,
    /// Desktop-sized window with no border (`SDL_WINDOW_FULLSCREEN_DESKTOP`): fast alt-tab, desktop resolution.
    Borderless,
    /// Exclusive fullscreen at the chosen resolution (`setResolution`).
    Fullscreen,
}

/// 0 windowed, 1 borderless, 2 fullscreen.
#[singleton]
let WIN_MODE: int;
/// Windowed size to return to after fullscreen.
#[singleton]
let WIN_SAVED_W: int;
#[singleton]
let WIN_SAVED_H: int;
/// Resolution an exclusive fullscreen uses (0 = desktop).
#[singleton]
let FS_W: int;
#[singleton]
let FS_H: int;
#[singleton]
let VSYNC_ON: bool;
/// 0 = no limit.
#[singleton]
let FPS_LIMIT: int;
#[singleton]
let LAST_PRESENT: int;
#[singleton]
let FOCUSED: bool = true;

fn modeInt(m: WindowMode): int {
    match m {
        WindowMode.Windowed { return 0; }
        WindowMode.Borderless { return 1; }
        WindowMode.Fullscreen { return 2; }
    }
}

fn modeFrom(i: int): WindowMode {
    if i == 1 { return WindowMode.Borderless; }
    if i == 2 { return WindowMode.Fullscreen; }
    return WindowMode.Windowed;
}

/// Extra `SDL_CreateWindow` flag for a mode chosen before `init`.
fn modeFlag(): u32 {
    if WIN_MODE == 1 { return SDL_WINDOW_FULLSCREEN_DESKTOP; }
    if WIN_MODE == 2 { return SDL_WINDOW_FULLSCREEN; }
    return 0;
}

/// Re-read the real window size after a mode or size change (the resize event arrives later).
fn syncWindowSize() {
    let w: i32 = 0;
    let h: i32 = 0;
    sdl.SDL_GetWindowSize(platform.window, &w as ptr, &h as ptr);
    platform.win_w = int(w);
    platform.win_h = int(h);
    refreshDpi();
}

/// Center the window on display `d`.
fn centerOn(d: int) {
    let at = i32(0x2FFF0000 + d);
    sdl.SDL_SetWindowPosition(platform.window, at, at);
}

/// Switch between windowed, borderless and exclusive fullscreen. Called before `init` it only
/// records the mode, and the window opens that way. Leaving fullscreen restores the windowed size.
pub fn setWindowMode(m: WindowMode) {
    let k = modeInt(m);
    if platform.window == 0 {
        WIN_MODE = k;
        return;
    }
    if WIN_MODE == 0 && k != 0 {
        WIN_SAVED_W = platform.win_w;
        WIN_SAVED_H = platform.win_h;
    }
    WIN_MODE = k;
    if k == 0 {
        sdl.SDL_SetWindowFullscreen(platform.window, 0);
        if WIN_SAVED_W > 0 { sdl.SDL_SetWindowSize(platform.window, i32(WIN_SAVED_W), i32(WIN_SAVED_H)); }
        centerOn(currentDisplay());
    } else if k == 1 {
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN_DESKTOP);
    } else {
        applyFsMode();
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN);
    }
    syncWindowSize();
}

/// Point the window's exclusive-fullscreen display mode at `FS_W` x `FS_H` (desktop mode if unset).
fn applyFsMode() {
    let want = SDL_DisplayMode { format: 0, w: i32(FS_W), h: i32(FS_H), refresh_rate: 0, driverdata: 0 };
    let got = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    let d = sdl.SDL_GetWindowDisplayIndex(platform.window);
    if FS_W > 0 {
        if sdl.SDL_GetClosestDisplayMode(d, &want as ptr, &got as ptr) == 0 { return; }
    } else {
        sdl.SDL_GetDesktopDisplayMode(d, &got as ptr);
    }
    sdl.SDL_SetWindowDisplayMode(platform.window, &got as ptr);
}

/// Current mode.
pub fn windowMode(): WindowMode {
    return modeFrom(WIN_MODE);
}

/// Set the resolution. Windowed: resizes and recenters. Exclusive fullscreen: switches the display
/// to the closest mode. Borderless always uses the desktop size, so this only records it.
pub fn setResolution(w: int, h: int) {
    if WIN_MODE == 0 {
        WIN_SAVED_W = w;
        WIN_SAVED_H = h;
        if platform.window != 0 {
            setWindowSize(w, h);
            centerOn(currentDisplay());
        }
        return;
    }
    FS_W = w;
    FS_H = h;
    if platform.window != 0 && WIN_MODE == 2 {
        applyFsMode();
        // SDL applies a new display mode only on re-entering fullscreen.
        sdl.SDL_SetWindowFullscreen(platform.window, 0);
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN);
        syncWindowSize();
    }
}

/// Number of connected monitors.
pub fn displayCount(): int {
    let n = int(sdl.SDL_GetNumVideoDisplays());
    if n < 1 { return 1; }
    return n;
}

/// Monitor the window is on.
pub fn currentDisplay(): int {
    if platform.window == 0 { return 0; }
    let d = int(sdl.SDL_GetWindowDisplayIndex(platform.window));
    if d < 0 { return 0; }
    return d;
}

/// Monitor name from the system ("DELL U2723QE"), or "Display N" if it has none.
pub fn displayName(i: int): string {
    let p = sdl.SDL_GetDisplayName(i32(i));
    if p == 0 { return "Display"; }
    let bytes: []u8 = []u8 { ptr: p as &u8, len: 256 };
    let n = 0;
    while n < 255 && bytes[n] != 0 { n += 1; }
    return []u8 { ptr: p as &u8, len: n } as string;
}

/// Move the window to monitor `i`, centered, and keep the current mode there.
pub fn moveToDisplay(i: int) {
    if platform.window == 0 || i < 0 || i >= displayCount() { return; }
    let m = WIN_MODE;
    if m != 0 { setWindowMode(WindowMode.Windowed); }
    centerOn(i);
    if m != 0 { setWindowMode(modeFrom(m)); }
}

/// Desktop resolution of monitor `display`.
pub fn desktopSize(display: int): Vec2 {
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDesktopDisplayMode(i32(display), &m as ptr);
    return Vec2 { x: f32(m.w), y: f32(m.h) };
}

/// Index of the display mode (SDL lists them largest first) that is the `n`th distinct w x h, or -1.
fn modeIndexAt(display: int, n: int): int {
    let total = int(sdl.SDL_GetNumDisplayModes(i32(display)));
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    let seen = 0;
    let pw: i32 = 0;
    let ph: i32 = 0;
    for i in 0..total {
        if sdl.SDL_GetDisplayMode(i32(display), i32(i), &m as ptr) != 0 { continue; }
        if m.w == pw && m.h == ph { continue; }
        if seen == n { return i; }
        pw = m.w;
        ph = m.h;
        seen += 1;
    }
    return -1;
}

/// How many distinct resolutions monitor `display` offers (one per w x h, refresh rates folded).
pub fn resolutionCount(display: int): int {
    let n = 0;
    while modeIndexAt(display, n) >= 0 { n += 1; }
    return n;
}

/// The `i`th resolution of monitor `display`, largest first. (0, 0) if out of range.
pub fn resolutionAt(display: int, i: int): Vec2 {
    let k = modeIndexAt(display, i);
    if k < 0 { return Vec2 { x: 0, y: 0 }; }
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDisplayMode(i32(display), i32(k), &m as ptr);
    return Vec2 { x: f32(m.w), y: f32(m.h) };
}

/// Refresh rate of the window's monitor in Hz (60 if unknown), for "cap at the monitor rate".
pub fn refreshRate(): int {
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDesktopDisplayMode(i32(currentDisplay()), &m as ptr);
    if m.refresh_rate <= 0 { return 60; }
    return int(m.refresh_rate);
}

/// Push `VSYNC_ON` to the GL swap interval (adaptive sync when the driver has it).
fn applyVsync() {
    if !platform.gl { return; }
    if !VSYNC_ON { sdl.SDL_GL_SetSwapInterval(0); return; }
    if sdl.SDL_GL_SetSwapInterval(-1) != 0 { sdl.SDL_GL_SetSwapInterval(1); }
}

/// Wait for the display refresh when presenting. GL changes it live; the 2D renderer fixes it at
/// `init`, so call this before `init` there.
pub fn setVsync(on: bool) {
    VSYNC_ON = on;
    if platform.window != 0 { applyVsync(); }
}

/// Whether vsync is requested.
pub fn vsync(): bool {
    return VSYNC_ON;
}

/// Cap the frame rate by sleeping at `present` (0 = no cap). Not applied under `--frames`.
pub fn setFpsLimit(fps: int) {
    FPS_LIMIT = fps;
    if fps < 0 { FPS_LIMIT = 0; }
}

/// Current cap, 0 for none.
pub fn fpsLimit(): int {
    return FPS_LIMIT;
}

/// False while another window has focus, to pause or mute a game.
pub fn windowFocused(): bool {
    return FOCUSED;
}

/// Maximize or restore a windowed window.
pub fn setMaximized(on: bool) {
    if platform.window == 0 { return; }
    if on { sdl.SDL_MaximizeWindow(platform.window); } else { sdl.SDL_RestoreWindow(platform.window); }
    syncWindowSize();
}

/// Window top-left in desktop coordinates; (0, 0) before the window exists. `j3.app` saves it for hot restarts.
pub fn windowPos(): Vec2 {
    if platform.window == 0 { return Vec2 { x: 0.0, y: 0.0 }; }
    let x: i32 = 0;
    let y: i32 = 0;
    sdl.SDL_GetWindowPosition(platform.window, &x as ptr, &y as ptr);
    return Vec2 { x: f32(x), y: f32(y) };
}

/// Move the window's top-left to desktop coordinates (x, y).
pub fn setWindowPos(x: int, y: int) {
    if platform.window != 0 { sdl.SDL_SetWindowPosition(platform.window, i32(x), i32(y)); }
}

/// Center the window on its monitor.
pub fn centerWindow() {
    if platform.window != 0 { centerOn(currentDisplay()); }
}

/// Size to lay out and draw in: the virtual size once `setVirtualSize` is on (the same at any
/// window size), else the window size in pixels.
pub fn windowSize(): Vec2 {
    if VIRT_W > 0 { return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) }; }
    let k = dpiNow();
    return Vec2 { x: f32(platform.win_w) / k, y: f32(platform.win_h) / k };
}

/// `dpiScale`, but 1 while painting into an offscreen target (its pixels are its own).
fn dpiNow(): f32 {
    if P2_SURFACE_N > 0 { return 1.0; }
    return DPI;
}

/// Size the 3D side works in: the virtual size, else the drawable in physical pixels (`windowSize`
/// divided by `dpiScale` is the logical size). Equal to `windowSize` unless `setHiDpi` or `J3_UI_SCALE` is on.
pub fn drawSize(): Vec2 {
    if VIRT_W > 0 { return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) }; }
    return Vec2 { x: f32(platform.win_w), y: f32(platform.win_h) };
}

/// Draw at a fixed `w` by `h` size whatever the window is, letterboxed: everything (2D, 3D,
/// `.j3ui`) is laid out and drawn in these pixels, and `windowSize` returns them. The drawing
/// area is the largest rect of that aspect ratio centered in the window, drawn at the real
/// resolution (text and shapes stay sharp), and the bars around it are cleared to black each
/// frame (`poll`). `mousePos` is in these pixels too: a pointer over a bar reads outside
/// `0..w` / `0..h` (negative or past the size), not clamped. `mouseDelta` and `screenshot` /
/// `readWindow` stay in window pixels. `setVirtualSize(0, 0)` turns it off (the default).
/// Call it once at startup, or again to change; a window resize needs nothing.
/// `screenRect` has the physical rect. `j3c doc testing` shows a letterboxed headless run.
pub fn setVirtualSize(w: int, h: int) {
    if w < 1 || h < 1 { VIRT_W = 0; VIRT_H = 0; } else { VIRT_W = w; VIRT_H = h; }
    if !platform.gl && platform.renderer != 0 {
        sdl.SDL_RenderSetLogicalSize(platform.renderer, i32(VIRT_W), i32(VIRT_H));
    }
}

/// The size set by `setVirtualSize`, or 0 by 0 while it is off.
pub fn virtualSize(): Vec2 {
    return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) };
}

/// Where the virtual screen is in the real window, in physical pixels (top-left origin): `x`, `y`
/// offset, `w`, `h` size, and `s` window pixels per virtual pixel. The whole window with `s` 1
/// while no virtual size is set. Use it only for code that needs real pixels (a `glViewport`,
/// a readback); `windowSize` and `mousePos` are in virtual pixels.
pub fn screenRect(): Rect {
    if P2_SURFACE_N > 0 { return fit(int(P2_SURFACE_SIZE[0]), int(P2_SURFACE_SIZE[1]), VIRT_W, VIRT_H); }
    return fit(platform.win_w, platform.win_h, VIRT_W, VIRT_H);
}

#[singleton]
let VIRT_W: int;
#[singleton]
let VIRT_H: int;
/// Letterbox scale while painting into an offscreen target (set by the outermost `p2SurfaceBegin`).
#[singleton]
let SURF_S: f32 = 1.0;

/// The area 2D drawing lands in, in the pixels of the current framebuffer, top-left origin: the
/// letterbox rect on the window, the whole target inside `p2SurfaceBegin`.
fn fbRect(): Rect {
    if P2_SURFACE_N > 0 { return Rect { x: 0, y: 0, w: platform.win_w, h: platform.win_h, s: SURF_S }; }
    let r = fit(platform.win_w, platform.win_h, VIRT_W, VIRT_H);
    if VIRT_W < 1 { r.s = DPI; }
    if LAYER_N > 0 { r.x = 0; r.y = 0; }
    return r;
}

/// Paint layers (`j3.gfx.post.beginLayer`) draw into a target the size of the rect: no offset inside.
#[singleton]
let LAYER_N: int;
pub fn p2LayerBegin() { p2Flush(); LAYER_N += 1; }
pub fn p2LayerEnd() { p2Flush(); LAYER_N -= 1; }

/// GL y of the bottom of `fbRect` in the current framebuffer: below the bar on the window, 0 in a target.
fn fbBase(r: Rect): int {
    if P2_SURFACE_N > 0 || LAYER_N > 0 { return 0; }
    return platform.win_h - r.y - r.h;
}

/// `fbRect` as a GL bottom-left rect: what a copy from, or a viewport on, the current framebuffer takes.
pub fn p2FbRect(): GlRect {
    let r = fbRect();
    return GlRect { x: r.x, y: fbBase(r), w: r.w, h: r.h };
}

/// A virtual-pixel rect as a GL rect on the current framebuffer (rounded edges, no seams).
pub fn p2GlRect(x: f32, y: f32, w: f32, h: f32): GlRect {
    let r = fbRect();
    return glRect(r, fbBase(r) + r.y + r.h, x, y, w, h);
}

/// Scale all screen-space 2D drawing (rects, textures, text) and `mousePos` by `s` (clamped 0.25..4).
/// 2 draws everything twice as big. Reset to 1 for overlays that should stay put.
pub fn setUiScale(s: f32) {
    let v = s;
    if v < 0.25 { v = 0.25; }
    if v > 4.0 { v = 4.0; }
    platform.ui_scale = v;
}

/// Current 2D scale from `setUiScale`.
pub fn uiScale(): f32 {
    return platform.ui_scale;
}

/// Physical pixels per 2D drawing unit: `setUiScale`, the letterbox scale and the high-DPI scale together.
/// What a length in drawing units (a blur radius) is multiplied by to get framebuffer pixels.
pub fn paintScale(): f32 {
    return platform.ui_scale * fbRect().s;
}

/// Window size in scaled 2D units: what to lay a UI out in once `setUiScale` is set.
pub fn uiSize(): Vec2 {
    let size = windowSize();
    return Vec2 { x: size.x / platform.ui_scale, y: size.y / platform.ui_scale };
}

/// Dt from the last `poll`, in seconds.
pub fn lastDt(): f32 {
    return f32(platform.last_span) / 1000.0;
}

/// Store the leftover fixed-step fraction. `j3.app` calls this before draw.
pub fn setFrameAlpha(a: f32) {
    let v = a;
    if v < 0 {
        v = 0;
    }
    if v > 1 {
        v = 1;
    }
    alphaFrame = v;
}

/// Leftover fixed-step fraction, 0..1. `0` is the previous tick, `1` is the latest.
pub fn frameAlpha(): f32 {
    return alphaFrame;
}

/// Frames since init.
pub fn frameCount(): int {
    return platform.frames;
}

/// Milliseconds since SDL started, for timing that shouldn't depend on frame rate.
pub fn ticks(): int {
    return int(sdl.SDL_GetTicks());
}

/// Microseconds on a steady clock, for timing inside a frame.
pub fn micros(): int {
    // ponytail: counter / (ticks per µs) drops sub-µs precision; the counter runs at 1 GHz or 10 MHz.
    let per = int(sdl.SDL_GetPerformanceFrequency()) / 1000000;
    if per < 1 { per = 1; }
    return int(sdl.SDL_GetPerformanceCounter()) / per;
}
