// Part of j3.game (window modes, displays, resolution, vsync, fps cap, focus); the module doc and `use`s are in ../game.j3.
module j3.game;

/// How the game window sits on the screen.
pub enum WindowMode {
    /// A normal window with a border, at the windowed size.
    Windowed,
    /// Desktop-sized window with no border (`SDL_WINDOW_FULLSCREEN_DESKTOP`): fast alt-tab, desktop resolution.
    Borderless,
    /// Exclusive fullscreen at the chosen resolution (`setResolution`).
    Fullscreen,
}

/// 0 windowed, 1 borderless, 2 fullscreen.
#[singleton]
let WIN_MODE: int;
/// Windowed size to return to after fullscreen.
#[singleton]
let WIN_SAVED_W: int;
#[singleton]
let WIN_SAVED_H: int;
/// Resolution an exclusive fullscreen uses (0 = desktop).
#[singleton]
let FS_W: int;
#[singleton]
let FS_H: int;
#[singleton]
let VSYNC_ON: bool;
/// 0 = no limit.
#[singleton]
let FPS_LIMIT: int;
#[singleton]
let LAST_PRESENT: int;
#[singleton]
let FOCUSED: bool = true;

fn modeInt(m: WindowMode): int {
    match m {
        WindowMode.Windowed { return 0; }
        WindowMode.Borderless { return 1; }
        WindowMode.Fullscreen { return 2; }
    }
}

fn modeFrom(i: int): WindowMode {
    if i == 1 { return WindowMode.Borderless; }
    if i == 2 { return WindowMode.Fullscreen; }
    return WindowMode.Windowed;
}

/// Extra `SDL_CreateWindow` flag for a mode chosen before `init`.
fn modeFlag(): u32 {
    if WIN_MODE == 1 { return SDL_WINDOW_FULLSCREEN_DESKTOP; }
    if WIN_MODE == 2 { return SDL_WINDOW_FULLSCREEN; }
    return decorFlag();
}

/// Re-read the real window size after a mode or size change (the resize event arrives later).
fn syncWindowSize() {
    let w: i32 = 0;
    let h: i32 = 0;
    sdl.SDL_GetWindowSize(platform.window, &w as ptr, &h as ptr);
    platform.win_w = int(w);
    platform.win_h = int(h);
    refreshDpi();
}

/// Center the window on display `d`.
fn centerOn(d: int) {
    let at = i32(0x2FFF0000 + d);
    sdl.SDL_SetWindowPosition(platform.window, at, at);
}

/// Switch between windowed, borderless and exclusive fullscreen. Called before `init` it only
/// records the mode, and the window opens that way. Leaving fullscreen restores the windowed size.
pub fn setWindowMode(m: WindowMode) {
    let k = modeInt(m);
    if platform.window == 0 {
        WIN_MODE = k;
        return;
    }
    if WIN_MODE == 0 && k != 0 {
        WIN_SAVED_W = platform.win_w;
        WIN_SAVED_H = platform.win_h;
    }
    WIN_MODE = k;
    if k == 0 {
        sdl.SDL_SetWindowFullscreen(platform.window, 0);
        if WIN_SAVED_W > 0 { sdl.SDL_SetWindowSize(platform.window, i32(WIN_SAVED_W), i32(WIN_SAVED_H)); }
        centerOn(currentDisplay());
    } else if k == 1 {
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN_DESKTOP);
    } else {
        applyFsMode();
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN);
    }
    syncWindowSize();
}

/// Point the window's exclusive-fullscreen display mode at `FS_W` x `FS_H` (desktop mode if unset).
fn applyFsMode() {
    let want = SDL_DisplayMode { format: 0, w: i32(FS_W), h: i32(FS_H), refresh_rate: 0, driverdata: 0 };
    let got = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    let d = sdl.SDL_GetWindowDisplayIndex(platform.window);
    if FS_W > 0 {
        if sdl.SDL_GetClosestDisplayMode(d, &want as ptr, &got as ptr) == 0 { return; }
    } else {
        sdl.SDL_GetDesktopDisplayMode(d, &got as ptr);
    }
    sdl.SDL_SetWindowDisplayMode(platform.window, &got as ptr);
}

/// Current mode.
pub fn windowMode(): WindowMode {
    return modeFrom(WIN_MODE);
}

/// Set the resolution. Windowed: resizes and recenters. Exclusive fullscreen: switches the display
/// to the closest mode. Borderless always uses the desktop size, so this only records it.
pub fn setResolution(w: int, h: int) {
    if WIN_MODE == 0 {
        WIN_SAVED_W = w;
        WIN_SAVED_H = h;
        if platform.window != 0 {
            setWindowSize(w, h);
            centerOn(currentDisplay());
        }
        return;
    }
    FS_W = w;
    FS_H = h;
    if platform.window != 0 && WIN_MODE == 2 {
        applyFsMode();
        // SDL applies a new display mode only on re-entering fullscreen.
        sdl.SDL_SetWindowFullscreen(platform.window, 0);
        sdl.SDL_SetWindowFullscreen(platform.window, SDL_WINDOW_FULLSCREEN);
        syncWindowSize();
    }
}

/// Number of connected monitors.
pub fn displayCount(): int {
    let n = int(sdl.SDL_GetNumVideoDisplays());
    if n < 1 { return 1; }
    return n;
}

/// Monitor the window is on.
pub fn currentDisplay(): int {
    if platform.window == 0 { return 0; }
    let d = int(sdl.SDL_GetWindowDisplayIndex(platform.window));
    if d < 0 { return 0; }
    return d;
}

/// Monitor name from the system ("DELL U2723QE"), or "Display N" if it has none.
pub fn displayName(i: int): string {
    let p = sdl.SDL_GetDisplayName(i32(i));
    if p == 0 { return "Display"; }
    let bytes: []u8 = []u8 { ptr: p as &u8, len: 256 };
    let n = 0;
    while n < 255 && bytes[n] != 0 { n += 1; }
    return []u8 { ptr: p as &u8, len: n } as string;
}

/// Move the window to monitor `i`, centered, and keep the current mode there.
pub fn moveToDisplay(i: int) {
    if platform.window == 0 || i < 0 || i >= displayCount() { return; }
    let m = WIN_MODE;
    if m != 0 { setWindowMode(WindowMode.Windowed); }
    centerOn(i);
    if m != 0 { setWindowMode(modeFrom(m)); }
}

/// Desktop resolution of monitor `display`.
pub fn desktopSize(display: int): Vec2 {
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDesktopDisplayMode(i32(display), &m as ptr);
    return Vec2 { x: f32(m.w), y: f32(m.h) };
}

/// Index of the display mode (SDL lists them largest first) that is the `n`th distinct w x h, or -1.
fn modeIndexAt(display: int, n: int): int {
    let total = int(sdl.SDL_GetNumDisplayModes(i32(display)));
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    let seen = 0;
    let pw: i32 = 0;
    let ph: i32 = 0;
    for i in 0..total {
        if sdl.SDL_GetDisplayMode(i32(display), i32(i), &m as ptr) != 0 { continue; }
        if m.w == pw && m.h == ph { continue; }
        if seen == n { return i; }
        pw = m.w;
        ph = m.h;
        seen += 1;
    }
    return -1;
}

/// How many distinct resolutions monitor `display` offers (one per w x h, refresh rates folded).
pub fn resolutionCount(display: int): int {
    let n = 0;
    while modeIndexAt(display, n) >= 0 { n += 1; }
    return n;
}

/// The `i`th resolution of monitor `display`, largest first. (0, 0) if out of range.
pub fn resolutionAt(display: int, i: int): Vec2 {
    let k = modeIndexAt(display, i);
    if k < 0 { return Vec2 { x: 0, y: 0 }; }
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDisplayMode(i32(display), i32(k), &m as ptr);
    return Vec2 { x: f32(m.w), y: f32(m.h) };
}

/// Refresh rate of the window's monitor in Hz (60 if unknown), for "cap at the monitor rate".
pub fn refreshRate(): int {
    let m = SDL_DisplayMode { format: 0, w: 0, h: 0, refresh_rate: 0, driverdata: 0 };
    sdl.SDL_GetDesktopDisplayMode(i32(currentDisplay()), &m as ptr);
    if m.refresh_rate <= 0 { return 60; }
    return int(m.refresh_rate);
}

/// Push `VSYNC_ON` to the GL swap interval (adaptive sync when the driver has it).
fn applyVsync() {
    if !platform.gl { return; }
    if !VSYNC_ON { sdl.SDL_GL_SetSwapInterval(0); return; }
    if sdl.SDL_GL_SetSwapInterval(-1) != 0 { sdl.SDL_GL_SetSwapInterval(1); }
}

/// Wait for the display refresh when presenting. GL changes it live; the 2D renderer fixes it at
/// `init`, so call this before `init` there.
pub fn setVsync(on: bool) {
    VSYNC_ON = on;
    if platform.window != 0 { applyVsync(); }
}

/// Whether vsync is requested.
pub fn vsync(): bool {
    return VSYNC_ON;
}

/// Cap the frame rate by sleeping at `present` (0 = no cap). Not applied under `--frames`.
pub fn setFpsLimit(fps: int) {
    FPS_LIMIT = fps;
    if fps < 0 { FPS_LIMIT = 0; }
}

/// Current cap, 0 for none.
pub fn fpsLimit(): int {
    return FPS_LIMIT;
}

/// False while another window has focus, to pause or mute a game.
pub fn windowFocused(): bool {
    return FOCUSED;
}
