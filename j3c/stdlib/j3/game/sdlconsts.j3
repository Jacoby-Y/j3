// Part of j3.game (SDL, audio and GL constants); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Init the audio subsystem.
const SDL_INIT_AUDIO: u32 = 0x00000010;
/// Init the video subsystem.
const SDL_INIT_VIDEO: u32 = 0x00000020;
/// Init game-controller support.
const SDL_INIT_GAMECONTROLLER: u32 = 0x00002000;
/// Place the window in the center of the display.
const SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000;
/// Create the window with an OpenGL context.
const SDL_WINDOW_OPENGL: u32 = 0x00000002;
const SDL_WINDOW_HIDDEN: u32 = 0x00000008;
/// A window whose drawable may have more pixels than its size (Retina, Wayland/X11 scaling).
const SDL_WINDOW_ALLOW_HIGHDPI: u32 = 0x00002000;
/// Prefer a hardware renderer.
const SDL_RENDERER_ACCELERATED: u32 = 0x00000002;
/// Renderer presents in step with the display refresh.
const SDL_RENDERER_PRESENTVSYNC: u32 = 0x00000004;
/// Exclusive fullscreen at the window's display mode.
const SDL_WINDOW_FULLSCREEN: u32 = 0x00000001;
/// Borderless fullscreen at the desktop resolution.
const SDL_WINDOW_FULLSCREEN_DESKTOP: u32 = 0x00001001;
const SDL_WINDOW_MAXIMIZED: u32 = 0x00000080;
/// GL attributes: color bits of the default framebuffer.
const SDL_GL_RED_SIZE: i32 = 0;
const SDL_GL_GREEN_SIZE: i32 = 1;
const SDL_GL_BLUE_SIZE: i32 = 2;
const SDL_GL_ALPHA_SIZE: i32 = 3;
/// GL attribute: double-buffered swap.
const SDL_GL_DOUBLEBUFFER: i32 = 5;
/// GL attribute: depth-buffer bits.
const SDL_GL_DEPTH_SIZE: i32 = 6;
/// GL attribute: context major version.
const SDL_GL_CONTEXT_MAJOR_VERSION: i32 = 17;
/// GL attribute: context minor version.
const SDL_GL_CONTEXT_MINOR_VERSION: i32 = 18;
/// GL attribute: profile mask.
const SDL_GL_CONTEXT_PROFILE_MASK: i32 = 21;
/// Core profile (no compatibility entry points).
const SDL_GL_CONTEXT_PROFILE_CORE: i32 = 1;
/// OpenGL ES profile.
const SDL_GL_CONTEXT_PROFILE_ES: i32 = 4;
/// `IMG_Init` flag for PNG.
const IMG_INIT_PNG: i32 = 2;
/// Signed 16-bit little-endian audio format.
const AUDIO_S16LSB: u16 = 0x8010;
const AUDIO_F32LSB: u16 = 0x8120;
/// Little-endian packed RGBA8 (`SDL_PIXELFORMAT_ABGR8888`).
const SDL_PIXELFORMAT_ABGR8888: u32 = 0x16762004;
/// `SDL_TEXTUREACCESS_STATIC`.
const SDL_TEXTUREACCESS_STATIC: i32 = 0;
/// `SDL_BLENDMODE_BLEND`.
const SDL_BLENDMODE_BLEND: i32 = 1;
/// `TTF_STYLE_BOLD`. SDL_ttf emboldens the face. It does not load a second file.
const TTF_STYLE_BOLD: i32 = 1;
/// Enable blending.
const GL_BLEND: u32 = 0x0BE2;
/// Source alpha blend factor.
const GL_SRC_ALPHA: u32 = 0x0302;
/// One minus source alpha blend factor.
const GL_ONE_MINUS_SRC_ALPHA: u32 = 0x0303;
/// Depth test capability.
const GL_DEPTH_TEST: u32 = 0x0B71;
/// Face culling capability.
const GL_CULL_FACE: u32 = 0x0B44;
/// 2D texture target.
const GL_TEXTURE_2D: u32 = 0x0DE1;
/// Sized RGBA internal format.
const GL_RGBA8: i32 = 0x8058;
/// RGBA pixel format.
const GL_RGBA: u32 = 0x1908;
/// Unsigned byte pixel type.
const GL_UNSIGNED_BYTE: u32 = 0x1401;
/// Pixel row length for subimage uploads.
const GL_UNPACK_ROW_LENGTH: u32 = 0x0CF2;
/// 32-bit float vertex type.
const GL_FLOAT: u32 = 0x1406;
/// Linear texture filter.
const GL_LINEAR: i32 = 0x2601;
/// Nearest-neighbor filter for generated pixel art.
const GL_NEAREST: i32 = 0x2600;
/// Clamp wrap mode.
const GL_CLAMP_TO_EDGE: i32 = 0x812F;
/// Minification filter parameter.
const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
/// Magnification filter parameter.
const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
/// Wrap mode for the S axis.
const GL_TEXTURE_WRAP_S: u32 = 0x2802;
/// Wrap mode for the T axis.
const GL_TEXTURE_WRAP_T: u32 = 0x2803;
/// Triangle draw mode.
const GL_TRIANGLES: u32 = 0x0004;
/// Vertex buffer target.
const GL_ARRAY_BUFFER: u32 = 0x8892;
/// Upload buffer data that will not change.
const GL_STATIC_DRAW: u32 = 0x88E4;
/// glBufferData usage hint for per-frame data.
const GL_STREAM_DRAW: u32 = 0x88E0;
/// glDrawArrays mode.
const GL_TRIANGLE_STRIP: u32 = 0x0005;
/// glEnable cap.
const GL_SCISSOR_TEST: u32 = 0x0C11;
/// Vertex shader stage.
const GL_VERTEX_SHADER: u32 = 0x8B31;
/// Fragment shader stage.
const GL_FRAGMENT_SHADER: u32 = 0x8B30;
/// Shader compile query.
const GL_COMPILE_STATUS: u32 = 0x8B81;
/// Program link query.
const GL_LINK_STATUS: u32 = 0x8B82;
