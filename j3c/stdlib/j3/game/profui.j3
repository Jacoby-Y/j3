// Part of j3.game (F4 UI frame-time profiler); the module doc and `use`s are in ../game.j3.
module j3.game;

// ---- F4: where UI frame time goes. `j3.ui.dom` marks its phases, `j3.gfx.post` and `p2BackdropBlur` open GPU
// zones around their passes, and `p2Push` counts instances by kind. All values are per frame, summed over roots.

/// `UI_NOW` / `UI_AVG` slots. CPU ms of the j3ui phases: build (`beginFrame` to `layout`: input, the app's update,
/// the markup walk), style (`resolveStyles`), layout, paint (`paintAll`, `inputs.overlay`), and the part of paint spent
/// in effect passes (`UI_FX`).
pub const UI_BUILD: int = 0;
pub const UI_STYLE: int = 1;
pub const UI_LAYOUT: int = 2;
pub const UI_PAINT: int = 3;
const UI_FX: int = 4;
/// GPU ms: batched paint, blur, layers (3 slots, -1 before the first sample).
const UI_GPU: int = 5;
/// Counts: batch flushes (draw calls), backdrop blurs, layers.
const UI_FLUSHES: int = 8;
pub const PROF_BLURS: int = 9;
pub const PROF_LAYERS: int = 10;
/// Instances per kind group (`UI_GROUPS` of them), then their area in logical px.
const UI_INST: int = 11;
const UI_GROUPS: int = 5;
const UI_AREA: int = 16;
const UI_ROWS: int = 21;

#[singleton]
let UI_NOW: [21]f32;
#[singleton]
let UI_AVG: [21]f32;
#[singleton]
let UI_SUM: [21]f32;
#[singleton]
let UI_MARK: int;
/// Effect zone open (0 none) and when it opened.
#[singleton]
let UI_FXZ: int;
#[singleton]
let UI_FXAT: int;
/// Some UI marked a phase, so `J3UISTATS` is worth printing.
#[singleton]
let UI_SEEN: bool;

const UI_KEYS: [21]string = ["build", "style", "layout", "paint", "fx", "gpu_paint", "gpu_blur", "gpu_layer",
    "flushes", "blurs", "layers", "text", "shapes", "gradients", "shadows", "composites",
    "text_px", "shapes_px", "gradients_px", "shadows_px", "composites_px"];
const UI_GROUP_NAMES: [5]string = ["text/img", "shapes", "gradient", "shadow", "composite"];

/// Start timing one j3ui root's frame (`Dom.beginFrame`).
pub fn profUiStart() {
    UI_MARK = micros();
    UI_SEEN = true;
}

/// Add the CPU time since the last mark to phase `k` (`UI_BUILD` .. `UI_PAINT`).
pub fn profUiMark(k: int) {
    let t = micros();
    UI_NOW[k] += f32(t - UI_MARK) / 1000;
    UI_MARK = t;
}

/// Add one to count `k` (`PROF_BLURS`, `PROF_LAYERS`).
pub fn profUiCount(k: int) {
    UI_NOW[k] += 1;
}

/// Time the GPU work that follows as zone `z` (`ZONE_UI_BLUR`, `ZONE_UI_LAYER`; 0 is plain paint) and return the zone
/// it replaces, for the caller to put back. Queued paint goes out first, under the old zone. The CPU time spent while
/// any effect zone is open is `UI_FX`.
pub fn profUiZone(z: int): int {
    p2Flush();
    let old = UI_FXZ;
    if old == z { return old; }
    let t = micros();
    if old == 0 { UI_FXAT = t; }
    else if z == 0 { UI_NOW[UI_FX] += f32(t - UI_FXAT) / 1000; }
    UI_FXZ = z;
    profZone(if z > 0 { z } else { ZONE_UI });
    return old;
}

/// The zone `p2Flush` times its batch in.
fn uiZone(): int {
    return if UI_FXZ > 0 { UI_FXZ } else { ZONE_UI };
}

/// Count one queued instance of `kind` (`p2Push`) and its area.
fn uiCount(kind: int, w: f32, h: f32) {
    let g = if kind == 1 { 0 } else if kind == 6 { 2 } else if kind == 7 || kind == 8 { 3 } else if kind >= 10 { 4 } else { 1 };
    UI_NOW[UI_INST + g] += 1;
    UI_NOW[UI_AREA + g] += w * h;
}

/// Fold this frame's CPU phases and counts into the averages (GPU slots fold in `profEnd`, a few frames late).
fn profUiEnd() {
    let summing = STOP_AT > 0 && PRESENTED > STOP_AT / 10;
    for k in 0..UI_ROWS {
        if k >= UI_GPU && k < UI_FLUSHES { continue; }
        UI_AVG[k] = if PRESENTED <= 2 { UI_NOW[k] } else { ease(UI_AVG[k], UI_NOW[k]) };
        if summing { UI_SUM[k] += UI_NOW[k]; }
    }
    uiClear();
}

/// Zero the CPU phases and counts of the frame being built.
fn uiClear() {
    for k in 0..UI_ROWS {
        if k >= UI_GPU && k < UI_FLUSHES { continue; }
        UI_NOW[k] = 0;
    }
}

/// One F4 row: label, ms, percent of the frame, and a bar of that percent.
fn uiRow(font: Font, cw: f32, x: f32, y: f32, label: string, ms: f32, frame: f32) {
    let pct: f32 = if frame > 0 && ms > 0 { ms * 100 / frame } else { 0 };
    let bw: f32 = 100;
    let bx = x + cw * 24;
    let by = y + cw * 0.4;
    setColor(rgba(255, 255, 255, 30));
    drawRect(Vec2 { x: bx, y: by }, Vec2 { x: bw, y: cw });
    if pct >= 25 { setColor(rgb(230, 80, 70)); }
    else if pct >= 10 { setColor(rgb(230, 190, 70)); }
    else { setColor(rgb(90, 200, 110)); }
    drawRect(Vec2 { x: bx, y: by }, Vec2 { x: clamp(pct, 0, 100) * bw / 100, y: cw });
    if font.raw == 0 { return; }
    setColor(rgb(220, 230, 210));
    let t = Text.new(scratch(1));
    t.pushStr(label);
    drawTextBytes(font, Vec2 { x: x, y: y }, t.bytes);
    t.clear();
    pushMs(&t, ms);
    t.pushStr(" ms");
    drawTextBytes(font, Vec2 { x: x + cw * 13, y: y }, t.bytes);
    t.clear();
    t.pushInt(int(pct + 0.5));
    t.push(37);
    drawTextBytes(font, Vec2 { x: x + cw * 20, y: y }, t.bytes);
}

/// Draw the F4 overlay in the top-left corner: CPU and GPU time of each kind of UI work as a share of the frame,
/// then what the painter was asked to draw (instances, and their area in screens, which is what fill rate pays for).
fn uiOverlay() {
    let keep = platform.color;
    let font = PROF.font;
    let line: f32 = 16;
    let cw: f32 = 7;
    if font.raw != 0 {
        line = textSize(font, "Ag").y + 2;
        cw = textSize(font, "0").x;
    }
    let a = PROF.avg;
    let f = a.frameMs;
    let x: f32 = 8;
    let y: f32 = 8;
    let w = cw * 25 + 116;
    let rows: f32 = 20;
    setColor(rgba(8, 8, 12, 210));
    drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: rows * line + 12 });
    x += 8;
    y += 6;
    let t = Text.new(scratch(1));
    let head = rgb(150, 200, 255);
    if font.raw != 0 {
        setColor(head);
        t.pushStr("UI cost (F4)   frame ");
        pushMs(&t, f);
        t.pushStr(" ms   fps ");
        t.pushInt(if f > 0 { int(1000 / f + 0.5) } else { 0 });
        drawTextBytes(font, Vec2 { x: x, y: y }, t.bytes);
        setColor(head);
        drawTextBytes(font, Vec2 { x: x, y: y + line }, "CPU" as []u8);
    }
    let ui = UI_AVG[UI_BUILD] + UI_AVG[UI_STYLE] + UI_AVG[UI_LAYOUT] + UI_AVG[UI_PAINT];
    uiRow(font, cw, x + 8, y + line * 2, "build+update", UI_AVG[UI_BUILD], f);
    uiRow(font, cw, x + 8, y + line * 3, "style", UI_AVG[UI_STYLE], f);
    uiRow(font, cw, x + 8, y + line * 4, "layout", UI_AVG[UI_LAYOUT], f);
    uiRow(font, cw, x + 8, y + line * 5, "paint", UI_AVG[UI_PAINT] - UI_AVG[UI_FX], f);
    uiRow(font, cw, x + 8, y + line * 6, "effect setup", UI_AVG[UI_FX], f);
    uiRow(font, cw, x + 8, y + line * 7, "not UI", a.cpuMs - ui, f);
    if font.raw != 0 {
        setColor(head);
        drawTextBytes(font, Vec2 { x: x, y: y + line * 8 }, (if PROF.spill { "GPU (truncated: too many passes)" } else { "GPU" }) as []u8);
    }
    let scene = if a.shadowMs < 0 { f32(-1) } else { a.shadowMs + a.cameraMs };
    uiRow(font, cw, x + 8, y + line * 9, "paint batches", UI_AVG[UI_GPU], f);
    uiRow(font, cw, x + 8, y + line * 10, "backdrop blur", UI_AVG[UI_GPU + 1], f);
    uiRow(font, cw, x + 8, y + line * 11, "filter/blend", UI_AVG[UI_GPU + 2], f);
    uiRow(font, cw, x + 8, y + line * 12, "3D scene", scene, f);
    if font.raw != 0 {
        setColor(head);
        drawTextBytes(font, Vec2 { x: x, y: y + line * 13 }, "per frame" as []u8);
        setColor(rgb(220, 230, 210));
        t.clear();
        t.pushStr("draws ");
        t.pushInt(int(UI_AVG[UI_FLUSHES] + 0.5));
        t.pushStr("   blurs ");
        t.pushInt(int(UI_AVG[PROF_BLURS] + 0.5));
        t.pushStr("   layers ");
        t.pushInt(int(UI_AVG[PROF_LAYERS] + 0.5));
        drawTextBytes(font, Vec2 { x: x + 8, y: y + line * 14 }, t.bytes);
        let ws = windowSize();
        let screen = ws.x * ws.y;
        for g in 0..UI_GROUPS {
            t.clear();
            t.pushStr(UI_GROUP_NAMES[g]);
            drawTextBytes(font, Vec2 { x: x + 8, y: y + line * f32(15 + g) }, t.bytes);
            t.clear();
            t.pushInt(int(UI_AVG[UI_INST + g] + 0.5));
            drawTextBytes(font, Vec2 { x: x + cw * 13, y: y + line * f32(15 + g) }, t.bytes);
            t.clear();
            pushMs(&t, if screen > 0 { UI_AVG[UI_AREA + g] / screen } else { f32(0) });
            t.pushStr(" screens");
            drawTextBytes(font, Vec2 { x: x + cw * 20, y: y + line * f32(15 + g) }, t.bytes);
        }
    }
    platform.color = keep;
}
