/// Sprite clips and a rigid transform track. No skeleton.

module j3.game.anim;

use j3.math.{ Mat4, Quat, Vec2, Vec3 };

/// One atlas rectangle.
pub struct Frame {
    /// Top-left of the source rect, in pixels.
    src: Vec2;
    /// Width and height of the source rect.
    size: Vec2;
}

/// Sequence of `Frame`s played at `fps`.
pub struct Clip {
    /// Frames in order. Empty clips stay on frame 0.
    frames: []Frame;
    /// Frames per second. `0` holds the current frame.
    fps: f32;
}

/// Playback cursor for a `Clip`.
pub struct Player {
    /// Index into `Clip.frames`.
    index: int;
    /// Seconds accumulated toward the next frame.
    time: f32;

    /// Cursor at frame 0.
    fn fresh(): Player {
        return Player { index: 0, time: 0 };
    }

    /// Advance by `dt` and wrap at the end of `clip`.
    fn tick(this: &Player, dt: f32, clip: &Clip) {
        if clip.frames.len <= 0 || clip.fps <= 0 {
            return;
        }
        this.time = this.time + dt;
        let step = f32(1) / clip.fps;
        while this.time >= step {
            this.time = this.time - step;
            this.index = this.index + 1;
            if this.index >= clip.frames.len {
                this.index = 0;
            }
        }
    }

    /// Frame index, clamped into `clip` (0 when the clip is empty).
    fn frame(this: Player, clip: &Clip): int {
        if clip.frames.len <= 0 {
            return 0;
        }
        if this.index < 0 || this.index >= clip.frames.len {
            return 0;
        }
        return this.index;
    }
}

/// One sample on a rigid transform track.
pub struct Key {
    /// Time in seconds.
    t: f32;
    /// Translation.
    pos: Vec3;
    /// Rotation.
    rot: Quat;
    /// Scale.
    scale: Vec3;

    /// Key at time `t`.
    fn at(t: f32, pos: Vec3, rot: Quat, scale: Vec3): Key {
        return Key {
            t: t,
            pos: pos,
            rot: rot,
            scale: scale,
        };
    }
}

/// Keys sorted by time. `sample` builds `translate * rotate * scale`.
pub struct Track {
    /// Keyframes. Empty tracks sample to the identity.
    keys: []Key;

    /// Matrix at time `t`. Before the first key and after the last key, that key is held.
    fn sample(this: &Track, t: f32): Mat4 {
        if this.keys.len <= 0 {
            return Mat4.identity();
        }
        if this.keys.len == 1 || t <= this.keys[0].t {
            return pose(this.keys[0]);
        }
        let last = this.keys.len - 1;
        if t >= this.keys[last].t {
            return pose(this.keys[last]);
        }
        let i = 0;
        while i < last {
            let a = this.keys[i];
            let b = this.keys[i + 1];
            if t >= a.t && t <= b.t {
                let span = b.t - a.t;
                let u: f32 = 0;
                if span > 0 {
                    u = (t - a.t) / span;
                }
                return poseBlend(a, b, u);
            }
            i += 1;
        }
        return pose(this.keys[last]);
    }
}

/// Matrix for a single key.
fn pose(k: Key): Mat4 {
    let place = Mat4.translate(k.pos.x, k.pos.y, k.pos.z);
    let size = Mat4.scale(k.scale.x, k.scale.y, k.scale.z);
    return place.mul(k.rot.toMat4()).mul(size);
}

/// Lerp position and scale, nlerp rotation, then build the matrix.
fn poseBlend(a: Key, b: Key, u: f32): Mat4 {
    let pos = Vec3 {
        x: a.pos.x + (b.pos.x - a.pos.x) * u,
        y: a.pos.y + (b.pos.y - a.pos.y) * u,
        z: a.pos.z + (b.pos.z - a.pos.z) * u,
    };
    let scale = Vec3 {
        x: a.scale.x + (b.scale.x - a.scale.x) * u,
        y: a.scale.y + (b.scale.y - a.scale.y) * u,
        z: a.scale.z + (b.scale.z - a.scale.z) * u,
    };
    let rot = Quat {
        x: a.rot.x + (b.rot.x - a.rot.x) * u,
        y: a.rot.y + (b.rot.y - a.rot.y) * u,
        z: a.rot.z + (b.rot.z - a.rot.z) * u,
        w: a.rot.w + (b.rot.w - a.rot.w) * u,
    };
    return pose(Key { t: 0, pos: pos, rot: rot.normalize(), scale: scale });
}
