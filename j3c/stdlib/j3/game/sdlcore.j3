// Part of j3.game (SDL core FFI block, SDL structs and display mode / audio spec types); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Opaque SDL window handle.
struct SDL_Window;
/// Opaque SDL renderer handle.
struct SDL_Renderer;

/// SDL integer rectangle.
struct SDL_Rect {
    /// Left edge in pixels.
    x: i32;
    /// Top edge in pixels.
    y: i32;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// SDL RGBA color byte.
struct SDL_Color {
    /// Red.
    r: u8;
    /// Green.
    g: u8;
    /// Blue.
    b: u8;
    /// Alpha.
    a: u8;
}

use lib "SDL2" as sdl {
    fn SDL_Init(flags: u32): i32;
    fn SDL_CreateWindow(title: cstr, x: i32, y: i32, w: i32, h: i32, flags: u32): ptr;
    fn SDL_CreateRenderer(window: ptr, index: i32, flags: u32): ptr;
    fn SDL_DestroyRenderer(renderer: ptr);
    fn SDL_DestroyWindow(window: ptr);
    fn SDL_Quit();

    fn SDL_PumpEvents();
    fn SDL_GetKeyboardState(numkeys: ptr): ptr;
    fn SDL_GetMouseState(x: ptr, y: ptr): u32;
    fn SDL_SetRelativeMouseMode(enabled: i32): i32;
    fn SDL_GetTicks(): u32;
    fn SDL_GetVersion(ver: ptr);
    fn SDL_GetWindowWMInfo(window: ptr, info: ptr): i32;
    fn SDL_CaptureMouse(enabled: i32): i32;
    fn SDL_GetPerformanceCounter(): u64;
    fn SDL_GetPerformanceFrequency(): u64;
    fn SDL_PollEvent(event: ptr): i32;
    fn SDL_WaitEventTimeout(event: ptr, ms: i32): i32;
    fn SDL_PushEvent(event: ptr): i32;
    fn SDL_SetWindowResizable(window: ptr, resizable: i32);
    fn SDL_SetWindowMinimumSize(window: ptr, min_w: i32, min_h: i32);
    fn SDL_SetWindowIcon(window: ptr, icon: ptr);
    fn SDL_SetWindowTitle(window: ptr, title: cstr);
    fn SDL_CreateRGBSurfaceWithFormatFrom(pixels: ptr, w: i32, h: i32, depth: i32, pitch: i32, format: u32): ptr;
    fn SDL_SetWindowMaximumSize(window: ptr, max_w: i32, max_h: i32);
    fn SDL_SetWindowSize(window: ptr, w: i32, h: i32);
    fn SDL_GetWindowSize(window: ptr, w: ptr, h: ptr);
    fn SDL_SetWindowFullscreen(window: ptr, flags: u32): i32;
    fn SDL_GetWindowFlags(window: ptr): u32;
    fn SDL_SetWindowBordered(window: ptr, bordered: i32);
    fn SDL_SetWindowPosition(window: ptr, x: i32, y: i32);
    fn SDL_GetWindowPosition(window: ptr, x: ptr, y: ptr);
    fn SDL_GetWindowDisplayIndex(window: ptr): i32;
    fn SDL_GetDisplayDPI(display: i32, ddpi: ptr, hdpi: ptr, vdpi: ptr): i32;
    fn SDL_GetNumVideoDisplays(): i32;
    fn SDL_GetNumDisplayModes(display: i32): i32;
    fn SDL_GetDisplayMode(display: i32, index: i32, mode: ptr): i32;
    fn SDL_GetDesktopDisplayMode(display: i32, mode: ptr): i32;
    fn SDL_GetClosestDisplayMode(display: i32, want: ptr, got: ptr): ptr;
    fn SDL_SetWindowDisplayMode(window: ptr, mode: ptr): i32;
    fn SDL_GetDisplayName(display: i32): ptr;
    fn SDL_GL_SetSwapInterval(interval: i32): i32;
    fn SDL_MaximizeWindow(window: ptr);
    fn SDL_MinimizeWindow(window: ptr);
    fn SDL_SetWindowHitTest(window: ptr, callback: fn(ptr, ptr, ptr): i32, data: ptr): i32;
    fn SDL_GetMouseFocus(): ptr;
    fn SDL_RestoreWindow(window: ptr);
    fn SDL_ShowWindow(window: ptr);
    fn SDL_HideWindow(window: ptr);
    fn SDL_RaiseWindow(window: ptr);
    fn SDL_Delay(ms: u32);

    fn SDL_SetRenderDrawColor(renderer: ptr, r: u8, g: u8, b: u8, a: u8): i32;
    fn SDL_SetRenderDrawBlendMode(renderer: ptr, mode: i32): i32;
    fn SDL_RenderClear(renderer: ptr): i32;
    fn SDL_RenderFillRect(renderer: ptr, rect: &SDL_Rect): i32;
    fn SDL_RenderCopy(renderer: ptr, texture: ptr, src: ptr, dst: &SDL_Rect): i32;
    fn SDL_RenderCopyEx(renderer: ptr, texture: ptr, src: ptr, dst: &SDL_Rect, angle: f64, center: ptr, flip: i32): i32;
    fn SDL_RenderDrawLine(renderer: ptr, x1: i32, y1: i32, x2: i32, y2: i32): i32;
    fn SDL_RenderPresent(renderer: ptr);
    fn SDL_RenderSetLogicalSize(renderer: ptr, w: i32, h: i32): i32;
    fn SDL_RenderReadPixels(renderer: ptr, rect: ptr, format: u32, pixels: ptr, pitch: i32): i32;
    fn SDL_StartTextInput();
    fn SDL_StopTextInput();
    fn SDL_SetTextInputRect(rect: &SDL_Rect);
    fn SDL_GetClipboardText(): ptr;
    fn SDL_SetClipboardText(text: cstr): i32;
    fn SDL_free(mem: ptr);
    fn SDL_CreateSystemCursor(id: i32): ptr;
    fn SDL_SetCursor(cursor: ptr);

    fn SDL_GL_SetAttribute(attr: i32, value: i32): i32;
    fn SDL_GL_GetAttribute(attr: i32, value: ptr): i32;
    fn SDL_SetHint(name: cstr, value: cstr): i32;
    fn SDL_SetHintWithPriority(name: cstr, value: cstr, priority: i32): i32;
    fn SDL_Log(fmt: cstr, arg: cstr);
    fn SDL_GetError(): cstr;
    fn SDL_GL_CreateContext(window: ptr): ptr;
    fn SDL_GL_DeleteContext(ctx: ptr);
    fn SDL_GL_SwapWindow(window: ptr);
    fn SDL_GL_GetDrawableSize(window: ptr, w: ptr, h: ptr);
    fn SDL_GL_GetProcAddress(name: cstr): ptr;
    fn SDL_LoadObject(file: cstr): ptr;
    fn SDL_LoadFunction(handle: ptr, name: cstr): ptr;

    fn SDL_CreateTextureFromSurface(renderer: ptr, surface: ptr): ptr;
    fn SDL_CreateTexture(renderer: ptr, format: u32, access: i32, w: i32, h: i32): ptr;
    fn SDL_UpdateTexture(texture: ptr, rect: ptr, pixels: ptr, pitch: i32): i32;
    fn SDL_SetTextureBlendMode(texture: ptr, mode: i32): i32;
    fn SDL_SetTextureScaleMode(texture: ptr, mode: i32): i32;
    fn SDL_SetTextureColorMod(texture: ptr, r: u8, g: u8, b: u8): i32;
    fn SDL_DestroyTexture(texture: ptr);
    fn SDL_FreeSurface(surface: ptr);
    fn SDL_ConvertSurfaceFormat(src: ptr, format: u32, flags: u32): ptr;
    fn SDL_LockSurface(surface: ptr): i32;
    fn SDL_UnlockSurface(surface: ptr);
    fn SDL_QueryTexture(texture: ptr, format: ptr, access: ptr, w: ptr, h: ptr): i32;

    fn SDL_GameControllerOpen(index: i32): ptr;
    fn SDL_GameControllerClose(pad: ptr);
    fn SDL_GameControllerGetAttached(pad: ptr): i32;
    fn SDL_GameControllerGetJoystick(pad: ptr): ptr;
    fn SDL_JoystickInstanceID(joy: ptr): i32;
    fn SDL_GameControllerGetButton(pad: ptr, button: i32): u8;
    fn SDL_GameControllerGetAxis(pad: ptr, axis: i32): i16;

    fn SDL_InitSubSystem(flags: u32): i32;
    fn SDL_OpenAudioDevice(device: ptr, iscapture: i32, desired: &SDL_AudioSpec, obtained: &SDL_AudioSpec, allowed: i32): u32;
    fn SDL_QueueAudio(dev: u32, data: ptr, len: u32): i32;
    fn SDL_GetQueuedAudioSize(dev: u32): u32;
    fn SDL_ClearQueuedAudio(dev: u32);
    fn SDL_PauseAudioDevice(dev: u32, pause_on: i32);
    fn SDL_CloseAudioDevice(dev: u32);
}

/// SDL display mode (`SDL_DisplayMode`).
struct SDL_DisplayMode {
    format: u32;
    w: i32;
    h: i32;
    refresh_rate: i32;
    driverdata: ptr;
}

/// SDL audio format request (`SDL_AudioSpec`).
struct SDL_AudioSpec {
    freq: i32;
    format: u16;
    channels: u8;
    silence: u8;
    samples: u16;
    padding: u16;
    size: u32;
    callback: ptr;
    userdata: ptr;
}
