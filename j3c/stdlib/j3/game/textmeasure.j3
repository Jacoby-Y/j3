// Part of j3.game (text width, caret, selection rects, font metrics); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Width of UTF-8 `msg` for layout: the sum of per-glyph advances (the same widths the GL glyph
/// atlas draws with), and `TTF_SizeUTF8` on each run of non-ASCII bytes. With a fallback chain
/// (`fontFallback`) or a complex script (`textShaping`) each run is measured with its own font and
/// shaping, exactly as `p2Text` draws it. Needs SDL_ttf, no window or GL
/// (unlike `textSize`, whose ASCII path builds the atlas). Zero for an empty font.
pub fn textWidth(font: Font, msg: []u8, bold: bool): f32 {
    let re = false;
    let n = fbRuns(font.raw, msg, &re);
    if n == 0 {
        return textWidthPlain(font, msg, bold);
    }
    let w: f32 = 0.0;
    let ei = fbOf(font.raw);
    for k in 0..n {
        let rf = font;
        if ei >= 0 { rf = fbFont(ei, BR[k].pick); }
        let r = BR[k];
        shapeSet(rf, r);
        w += textWidthPlain(rf, msg[r.a..r.b], bold);
        shapeReset(rf, r);
    }
    return w;
}

fn textWidthPlain(font: Font, msg: []u8, bold: bool): f32 {
    if font.raw == 0 {
        return 0;
    }
    let slot = advFor(font, bold);
    let sc = strikeScale(font.raw);
    let pen = 0;
    // letter / word spacing is summed apart from the integer advances (zero work when both are 0)
    let ls = TM.letterSp;
    let ws = TM.wordSp;
    let sp = ls != 0.0 || ws != 0.0;
    let extra: f32 = 0.0;
    let i = 0;
    while i < msg.len {
        let b = int(msg[i]);
        if b >= 32 && b <= 126 {
            if sp {
                extra += ls;
                if b == 32 { extra += ws; }
            }
            if TM.tabular && b >= 48 && b <= 57 {
                pen += strikePx(int(advTabs[slot].dmax), sc);
            } else {
                pen += strikePx(int(advTabs[slot].adv[b - 32]), sc);
            }
            i += 1;
        } else if b < 128 {
            i += 1;
        } else {
            let j = i;
            while j < msg.len && int(msg[j]) >= 128 {
                j += 1;
            }
            let w: i32 = 0;
            let h: i32 = 0;
            let style: i32 = 0;
            if bold {
                style = TTF_STYLE_BOLD;
            }
            TTF_SetFontStyle(font.raw, style);
            // cstrBytes holds 1023 bytes: measure a longer run in pieces cut at code point starts (shaping does not span a cut)
            let c = i;
            while c < j {
                let e = j;
                if ls != 0.0 {
                    // letter-spaced: one code point per piece, as `p2TextRun` draws it
                    e = c + 1;
                    while e < j && int(msg[e]) >= 128 && int(msg[e]) < 192 { e += 1; }
                    extra += ls;
                } else if e - c > 1000 {
                    e = c + 1000;
                    while e > c && int(msg[e]) >= 128 && int(msg[e]) < 192 { e -= 1; }
                }
                TTF_SizeUTF8(font.raw, cstrBytes(msg[c..e]), &w as ptr, &h as ptr);
                pen += strikePx(int(w), sc);
                c = e;
            }
            i = j;
        }
    }
    return f32(pen) + extra;
}

/// Width of `msg[a..b]` set in run `r` (its chain font and shaping), as `p2Text` lays it out.
fn runWidth(font: Font, ei: int, r: BRun, msg: []u8, a: int, b: int, bold: bool): f32 {
    let rf = font;
    if ei >= 0 { rf = fbFont(ei, r.pick); }
    shapeSet(rf, r);
    let w = textWidthPlain(rf, msg[a..b], bold);
    shapeReset(rf, r);
    return w;
}

/// Bidi runs of `msg` when some run is right to left (visual order in `BVIS`), else 0: then drawing order is
/// logical and plain `textWidth` of a prefix is the caret x.
fn bidiRuns(font: Font, msg: []u8): int {
    let re = false;
    let n = fbRuns(font.raw, msg, &re);
    if n == 0 || !re { return 0; }
    fbVisual(n);
    return n;
}

/// Whether `msg` is drawn reordered (it holds a right-to-left run), so caret and selection need `textCaretX` and friends.
pub fn textBidi(font: Font, msg: []u8): bool {
    return bidiRuns(font, msg) > 0;
}

/// Visual x of the caret before byte `i` of `msg` as `p2Text` draws it. Inside a right-to-left run x decreases
/// as `i` grows. At a boundary between runs the caret belongs to the run of the preceding character
/// (index 0: the first run in logical order). Plain text: `textWidth(msg[0..i])`.
pub fn textCaretX(font: Font, msg: []u8, bold: bool, i: int): f32 {
    let n = bidiRuns(font, msg);
    if n == 0 { return textWidth(font, msg[0..i], bold); }
    let ei = fbOf(font.raw);
    let ki = 0;
    for k in 0..n {
        if BR[k].a < i && i <= BR[k].b { ki = k; }
    }
    let pen: f32 = 0.0;
    for v in 0..n {
        let k = BVIS[v];
        let r = BR[k];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        if k == ki {
            let inside = runWidth(font, ei, r, msg, r.a, i, bold);
            return if r.lvl % 2 == 1 { pen + w - inside } else { pen + inside };
        }
        pen += w;
    }
    return pen;
}

/// The caret byte index nearest to visual x `x` (0 is the line's left edge) in reordered `msg`; -1 when `msg` has no
/// right-to-left run (use the logical hit test).
pub fn textIndexAt(font: Font, msg: []u8, bold: bool, x: f32): int {
    let n = bidiRuns(font, msg);
    if n == 0 { return -1; }
    let ei = fbOf(font.raw);
    let pen: f32 = 0.0;
    for v in 0..n {
        let r = BR[BVIS[v]];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        if x < pen + w || v == n - 1 {
            let rtl = r.lvl % 2 == 1;
            let lx = if rtl { pen + w - x } else { x - pen };
            if lx <= 0.0 { return r.a; }
            if lx >= w { return r.b; }
            // bisect the code point boundaries of the run on the (monotonic) prefix width: O(n log n) in the run
            let lo = r.a;
            let hi = r.b;
            while true {
                let m = (lo + hi) / 2;
                while m > lo && int(msg[m]) >= 128 && int(msg[m]) < 192 { m -= 1; }
                if m <= lo {
                    m = lo + 1;
                    while m < hi && int(msg[m]) >= 128 && int(msg[m]) < 192 { m += 1; }
                    if m >= hi { break; }
                }
                if runWidth(font, ei, r, msg, r.a, m, bold) <= lx { lo = m; } else { hi = m; }
            }
            let wl = runWidth(font, ei, r, msg, r.a, lo, bold);
            let wh = runWidth(font, ei, r, msg, r.a, hi, bold);
            return if lx <= (wl + wh) / 2.0 { lo } else { hi };
        }
        pen += w;
    }
    return 0;
}

#[singleton]
let SELX: [64]f32;
#[singleton]
let SELW: [64]f32;

/// The visual rectangles (x, width; read with `selRectX` / `selRectW`) covering bytes `lo..hi` of `msg`: one per
/// intersected run in visual order, adjacent ones merged. Returns how many. Plain text gives one.
pub fn textSelRects(font: Font, msg: []u8, bold: bool, lo: int, hi: int): int {
    let n = bidiRuns(font, msg);
    if n == 0 {
        let xl = textWidth(font, msg[0..lo], bold);
        SELX[0] = xl;
        SELW[0] = textWidth(font, msg[0..hi], bold) - xl;
        return 1;
    }
    let ei = fbOf(font.raw);
    let cnt = 0;
    let pen: f32 = 0.0;
    for v in 0..n {
        let r = BR[BVIS[v]];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        let ia = if lo > r.a { lo } else { r.a };
        let ib = if hi < r.b { hi } else { r.b };
        if ib > ia {
            let wa = runWidth(font, ei, r, msg, r.a, ia, bold);
            let wb = runWidth(font, ei, r, msg, r.a, ib, bold);
            let x0 = pen + wa;
            let x1 = pen + wb;
            if r.lvl % 2 == 1 {
                x0 = pen + w - wb;
                x1 = pen + w - wa;
            }
            if cnt > 0 && x0 - (SELX[cnt - 1] + SELW[cnt - 1]) < 1.0 && x0 - (SELX[cnt - 1] + SELW[cnt - 1]) > -1.0 {
                SELW[cnt - 1] = x1 - SELX[cnt - 1];
            } else {
                SELX[cnt] = x0;
                SELW[cnt] = x1 - x0;
                cnt += 1;
            }
        }
        pen += w;
    }
    return cnt;
}

pub fn selRectX(k: int): f32 { return SELX[k]; }
pub fn selRectW(k: int): f32 { return SELW[k]; }

/// Whether `font` or a font of its fallback chain has a glyph for code point `cp` (true when it cannot tell: an empty font, no SDL_ttf query).
pub fn fontHas(font: Font, cp: int): bool {
    if font.raw == 0 || fontFns.glyph == 0 || fbHas(font.raw, cp) {
        return true;
    }
    let ei = fbOf(font.raw);
    if ei >= 0 {
        for k in 0..FB[ei].n {
            if fbHas(FB[ei].alt[k], cp) {
                return true;
            }
        }
    }
    return false;
}

/// `TTF_FontHeight`: the natural line height of `font` (0 for an empty font).
pub fn fontLine(font: Font): int {
    if font.raw == 0 {
        return 0;
    }
    return strikePx(int(TTF_FontHeight(font.raw)), strikeScale(font.raw));
}

/// `TTF_FontAscent`: baseline distance from the top of a line (0 for an empty font).
pub fn fontAscent(font: Font): int {
    if font.raw == 0 {
        return 0;
    }
    return strikePx(int(TTF_FontAscent(font.raw)), strikeScale(font.raw));
}
