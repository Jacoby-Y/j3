/// 2D bodies on a broadphase grid, and a thin 3D body that stops on voxel solids.

module j3.game.physics;

use j3.game.collide.{ Rect, overlap };
use j3.math.{ Vec2, Vec3, abs };
use j3.memory.Arena;
use j3.game.space.Grid;
use j3.gfx.voxel;

/// Dynamic or fixed box. `grav` scales the sim gravity. `fixed` bodies do not move.
pub struct Body {
    /// Top-left of the box.
    pos: Vec2;
    /// Velocity in units per second.
    vel: Vec2;
    /// Width and height.
    size: Vec2;
    /// Multiplier on `Sim.gravity`. `0` ignores gravity.
    grav: f32;
    /// When true, `step` does not integrate or push this body.
    fixed: bool;

    /// Dynamic body at `pos` with `vel`, `size`, and gravity scale `grav`.
    fn make(pos: Vec2, vel: Vec2, size: Vec2, grav: f32): Body {
        return Body {
            pos: pos,
            vel: vel,
            size: size,
            grav: grav,
            fixed: false,
        };
    }

    /// Body that does not integrate. Other bodies are pushed out of it.
    fn fixedAt(pos: Vec2, size: Vec2): Body {
        return Body {
            pos: pos,
            vel: Vec2 { x: 0, y: 0 },
            size: size,
            grav: 0,
            fixed: true,
        };
    }
}

/// Bodies plus a grid. `step` integrates, then separates overlapping AABBs.
pub struct Sim {
    /// Body storage. Only the first `n` are live.
    bodies: []Body;
    /// Live body count.
    n: int;
    /// Acceleration applied as `gravity * body.grav`.
    gravity: Vec2;
    /// Broadphase rebuilt each `step`.
    grid: Grid;
    /// Arena that owns `bodies`.
    arena: &Arena;

    /// Empty sim. `cell` is the grid cell size.
    fn new(arena: &Arena, cap: int, cell: f32): Sim {
        let n = cap;
        if n < 4 {
            n = 4;
        }
        return Sim {
            bodies: arena.alloc::<Body>(n),
            n: 0,
            gravity: Vec2 { x: 0, y: 0 },
            grid: Grid.new(arena, n * 16, cell),
            arena: arena,
        };
    }

    /// Append `b` and return its index. Returns `-1` when full.
    fn add(this: &Sim, b: Body): int {
        if this.n >= this.bodies.len {
            return 0 - 1;
        }
        let i = this.n;
        this.bodies[i] = b;
        this.n = this.n + 1;
        return i;
    }

    /// Pointer to body `i`.
    fn get(this: &Sim, i: int): &Body {
        return &this.bodies[i];
    }

    /// Integrate dynamic bodies, then separate overlaps found through the grid.
    fn step(this: &Sim, dt: f32) {
        let i = 0;
        while i < this.n {
            let b = &this.bodies[i];
            if !b.fixed {
                b.vel = b.vel + this.gravity * b.grav * dt;
                b.pos = b.pos + b.vel * dt;
            }
            i += 1;
        }
        this.grid.clear();
        i = 0;
        while i < this.n {
            let body = this.bodies[i];
            this.grid.insert(i, Rect { pos: body.pos, size: body.size });
            i += 1;
        }
        i = 0;
        while i < this.n {
            if !this.bodies[i].fixed {
                let rect = Rect { pos: this.bodies[i].pos, size: this.bodies[i].size };
                let hits = this.grid.query(rect);
                let k = 0;
                while k < hits.len {
                    let j = hits[k];
                    if j != i {
                        separate(&this.bodies[i], &this.bodies[j]);
                    }
                    k += 1;
                }
            }
            i += 1;
        }
    }
}

/// Push a dynamic body out of the other along the smaller overlap axis and flip that velocity.
fn separate(a: &Body, b: &Body) {
    if a.fixed && b.fixed {
        return;
    }
    if !overlap(Rect { pos: a.pos, size: a.size }, Rect { pos: b.pos, size: b.size }) {
        return;
    }
    if !a.fixed {
        pushOut(a, b);
        return;
    }
    pushOut(b, a);
}

/// Move `dyn` out of `other` on the smaller overlap axis.
fn pushOut(dyn: &Body, other: &Body) {
    let dcx = dyn.pos.x + dyn.size.x * 0.5;
    let ocx = other.pos.x + other.size.x * 0.5;
    let dcy = dyn.pos.y + dyn.size.y * 0.5;
    let ocy = other.pos.y + other.size.y * 0.5;
    let ox = (dyn.size.x + other.size.x) * 0.5 - abs(dcx - ocx);
    let oy = (dyn.size.y + other.size.y) * 0.5 - abs(dcy - ocy);
    if ox < oy {
        let sx: f32 = 1;
        if dcx < ocx {
            sx = f32(0) - 1;
        }
        dyn.pos.x = dyn.pos.x + ox * sx;
        if sx < 0 && dyn.vel.x > 0 {
            dyn.vel.x = f32(0) - dyn.vel.x;
        }
        if sx > 0 && dyn.vel.x < 0 {
            dyn.vel.x = f32(0) - dyn.vel.x;
        }
    } else {
        let sy: f32 = 1;
        if dcy < ocy {
            sy = f32(0) - 1;
        }
        dyn.pos.y = dyn.pos.y + oy * sy;
        if sy < 0 && dyn.vel.y > 0 {
            dyn.vel.y = f32(0) - dyn.vel.y;
        }
        if sy > 0 && dyn.vel.y < 0 {
            dyn.vel.y = f32(0) - dyn.vel.y;
        }
    }
}

/// Point body with a half-extent box. `stepGrid` stops on solid voxels.
pub struct Body3 {
    /// Center of the box.
    pos: Vec3;
    /// Velocity in units per second.
    vel: Vec3;
    /// Half width, height, and depth.
    half: Vec3;
    /// Multiplier on the gravity passed to `stepGrid`.
    grav: f32;

    /// Body at `pos` with `vel`, `half` extents, and gravity scale `grav`.
    fn make(pos: Vec3, vel: Vec3, half: Vec3, grav: f32): Body3 {
        return Body3 {
            pos: pos,
            vel: vel,
            half: half,
            grav: grav,
        };
    }

    /// Add `g * grav`, then move one axis at a time. A hit zeroes that axis.
    fn stepGrid(this: &Body3, dt: f32, g: Vec3, cells: []u8, sx: int, sy: int, sz: int) {
        this.vel = this.vel + g * this.grav * dt;
        this.tryAxis(cells, sx, sy, sz, this.vel.x * dt, 0, 0);
        this.tryAxis(cells, sx, sy, sz, 0, this.vel.y * dt, 0);
        this.tryAxis(cells, sx, sy, sz, 0, 0, this.vel.z * dt);
    }

    /// Move by `(dx, dy, dz)` unless the swept box overlaps a solid cell.
    fn tryAxis(this: &Body3, cells: []u8, sx: int, sy: int, sz: int, dx: f32, dy: f32, dz: f32) {
        let next = this.pos;
        next.x = next.x + dx;
        next.y = next.y + dy;
        next.z = next.z + dz;
        let lo = Vec3 {
            x: next.x - this.half.x,
            y: next.y - this.half.y,
            z: next.z - this.half.z,
        };
        let hi = Vec3 {
            x: next.x + this.half.x,
            y: next.y + this.half.y,
            z: next.z + this.half.z,
        };
        if voxel.overlaps(cells, sx, sy, sz, lo, hi) {
            if dx != 0 {
                this.vel.x = 0;
            }
            if dy != 0 {
                this.vel.y = 0;
            }
            if dz != 0 {
                this.vel.z = 0;
            }
            return;
        }
        this.pos = next;
    }
}
