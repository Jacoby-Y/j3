/// Named actions bound to a key and a pad button. The id is chosen by the game.

module j3.game.input;

use j3.game.{ Axis, Key, Pad, keyDown, keyPressed, keyReleased, padAxis, padDown, padPressed };
use j3.memory.Arena;

/// One binding: an action id, a key, and a pad button.
struct Bind {
    /// Caller-chosen action id.
    id: int;
    /// Keyboard key.
    key: Key;
    /// Pad button checked on `which`.
    pad: Pad;
    /// Controller index.
    which: int;
}

/// Table of action bindings.
pub struct Actions {
    /// Bindings. Only the first `n` are live.
    items: []Bind;
    /// Live binding count.
    n: int;
    /// Arena that owns `items`.
    arena: &Arena;

    /// Empty table with room for `cap` bindings.
    fn new(arena: &Arena, cap: int): Actions {
        let n = cap;
        if n < 4 {
            n = 4;
        }
        return Actions {
            items: arena.alloc::<Bind>(n),
            n: 0,
            arena: arena,
        };
    }

    /// Bind `id` to `key` and pad `which`'s `pad` button. A repeat id adds another binding.
    fn bind(this: &Actions, id: int, key: Key, pad: Pad, which: int) {
        if this.n >= this.items.len {
            let cap = this.items.len;
            let next = cap * 2;
            let items = this.arena.alloc::<Bind>(next);
            let i = 0;
            while i < this.n {
                items[i] = this.items[i];
                i += 1;
            }
            this.items = items;
        }
        this.items[this.n] = Bind {
            id: id,
            key: key,
            pad: pad,
            which: which,
        };
        this.n = this.n + 1;
    }

    /// True while any binding for `id` is held. A stick past 0.5 counts as that pad direction.
    fn down(this: &Actions, id: int): bool {
        let i = 0;
        while i < this.n {
            if this.items[i].id == id && held(this.items[i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    /// True on the frame any binding for `id` went down.
    fn pressed(this: &Actions, id: int): bool {
        let i = 0;
        while i < this.n {
            if this.items[i].id == id {
                let b = this.items[i];
                if keyPressed(b.key) || padPressed(b.which, b.pad) {
                    return true;
                }
            }
            i += 1;
        }
        return false;
    }

    /// True on the frame a key binding for `id` went up, and no other binding is still down.
    fn released(this: &Actions, id: int): bool {
        let up = false;
        let i = 0;
        while i < this.n {
            if this.items[i].id == id && keyReleased(this.items[i].key) {
                up = true;
            }
            i += 1;
        }
        if !up {
            return false;
        }
        return !this.down(id);
    }
}

/// Key, pad button, or matching stick for one binding.
fn held(b: Bind): bool {
    if keyDown(b.key) || padDown(b.which, b.pad) {
        return true;
    }
    if b.pad == Pad.Left && padAxis(b.which, Axis.LeftX) < f32(0) - 0.5 {
        return true;
    }
    if b.pad == Pad.Right && padAxis(b.which, Axis.LeftX) > 0.5 {
        return true;
    }
    if b.pad == Pad.Up && padAxis(b.which, Axis.LeftY) < f32(0) - 0.5 {
        return true;
    }
    if b.pad == Pad.Down && padAxis(b.which, Axis.LeftY) > 0.5 {
        return true;
    }
    return false;
}
