/// AABB / circles / axis slide against a tile grid. No closures.

module j3.game.collide;

use j3.math.Vec2;

/// Axis-aligned rectangle as position plus size.
pub struct Rect {
    /// Top-left (or min) corner.
    pos: Vec2;
    /// Width and height.
    size: Vec2;

    /// Opposite corner (`pos + size`).
    fn max(this: Rect): Vec2 {
        return Vec2 {
            x: this.pos.x + this.size.x,
            y: this.pos.y + this.size.y,
        };
    }
}

/// True if two AABBs overlap (edges touching do not count).
pub fn overlap(a: Rect, b: Rect): bool {
    if a.pos.x + a.size.x <= b.pos.x {
        return false;
    }
    if b.pos.x + b.size.x <= a.pos.x {
        return false;
    }
    if a.pos.y + a.size.y <= b.pos.y {
        return false;
    }
    if b.pos.y + b.size.y <= a.pos.y {
        return false;
    }
    return true;
}

/// AABB overlap from two positions and sizes.
pub fn overlapBox(a: Vec2, asz: Vec2, b: Vec2, bsz: Vec2): bool {
    return overlap(Rect { pos: a, size: asz }, Rect { pos: b, size: bsz });
}

/// True if two circles (centers and radii) overlap strictly inside sum of radii.
pub fn overlapRad(a: Vec2, ar: f32, b: Vec2, br: f32): bool {
    let d = a - b;
    let r = ar + br;
    return d.x * d.x + d.y * d.y < r * r;
}

/// True if world point `(x, y)` lands on tile value `a` or `b`, or is out of bounds / invalid `tw`.
pub fn tileSolid(tiles: []u8, mw: int, mh: int, tw: int, x: f32, y: f32, a: u8, b: u8): bool {
    if tw < 1 {
        return true;
    }
    let tx = int(x / f32(tw));
    let ty = int(y / f32(tw));
    if tx < 0 || ty < 0 || tx >= mw || ty >= mh {
        return true;
    }
    let t = tiles[ty * mw + tx];
    return t == a || t == b;
}

/// True if any of the four corners of an axis-aligned box of side `s` hit a solid tile.
pub fn boxHits(tiles: []u8, mw: int, mh: int, tw: int, x: f32, y: f32, s: f32, a: u8, b: u8): bool {
    let e = s - 1;
    if e < 1 {
        e = 1;
    }
    return tileSolid(tiles, mw, mh, tw, x, y, a, b)
        || tileSolid(tiles, mw, mh, tw, x + e, y, a, b)
        || tileSolid(tiles, mw, mh, tw, x, y + e, a, b)
        || tileSolid(tiles, mw, mh, tw, x + e, y + e, a, b);
}

/// Move `p` by `dir * speed * dt`, sliding on X then Y against solid tiles.
pub fn slide(
    p: Vec2,
    dir: Vec2,
    speed: f32,
    size: f32,
    dt: f32,
    tiles: []u8,
    mw: int,
    mh: int,
    tw: int,
    a: u8,
    b: u8,
): Vec2 {
    let n = p;
    let nx = p.x + dir.x * speed * dt;
    if !boxHits(tiles, mw, mh, tw, nx, p.y, size, a, b) {
        n.x = nx;
    }
    let ny = n.y + dir.y * speed * dt;
    if !boxHits(tiles, mw, mh, tw, n.x, ny, size, a, b) {
        n.y = ny;
    }
    return n;
}
