// Part of j3.game (fonts, baked text cache, text size, advances, shaping); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Where a font came from, so `twinFor` can open it again at another size.
struct FontSrc {
    raw: ptr;
    size: int;
    path: [256]u8;
    plen: int;
    /// The same face at `tsize` points (0: none yet), for sharp text under a 2D scale.
    twin: ptr;
    tsize: int;
    /// 0 not checked yet, 1 outline font, 2 fixed-strike bitmap font (`strikeScale`).
    fixed: int;
}

#[singleton]
let FONT_SRC: [32]FontSrc;
#[singleton]
let FONT_SRC_N: int;

fn rememberFont(raw: ptr, path: cstr, size: int) {
    let n = libc.strlen(path);
    if raw == 0 || FONT_SRC_N >= 32 || n >= 255 {
        return;
    }
    let f = &FONT_SRC[FONT_SRC_N];
    FONT_SRC_N += 1;
    f.raw = raw;
    f.size = size;
    f.plen = n;
    let src = []u8 { ptr: path as &u8, len: n };
    for i in 0..n {
        f.path[i] = src[i];
    }
    f.twin = 0;
    f.tsize = 0;
    f.fixed = 0;
}

/// `font` re-opened at `size * us` points (nearest whole), with `ratio` set to twin points per point
/// so glyphs draw at `1 / ratio`; `font` itself (ratio 1) when `us` is 1, the source is unknown or
/// the open fails. One twin per font: a scale change closes the old one.
fn twinFor(font: Font, us: f32, ratio: &f32): Font {
    *ratio = 1.0;
    if us > 0.98 && us < 1.02 {
        return font;
    }
    for i in 0..FONT_SRC_N {
        let f = &FONT_SRC[i];
        if f.raw != font.raw {
            continue;
        }
        let ts = int(f32(f.size) * us + 0.5);
        if ts < 1 || ts > 512 {
            return font;
        }
        if f.tsize != ts {
            if f.twin != 0 {
                textDropFont(f.twin);
                atlasDrop(f.twin);
                TTF_CloseFont(f.twin);
                f.twin = 0;
            }
            f.tsize = ts;
            f.twin = TTF_OpenFont(cstrBytes(f.path[0..f.plen]), i32(ts));
        }
        if f.twin == 0 {
            return font;
        }
        *ratio = f32(ts) / f32(f.size);
        return Font { raw: f.twin };
    }
    return font;
}

/// Try to load a font from a C string path. Empty when the file or SDL_ttf is missing.
pub fn tryLoadFontC(path: cstr, size: int): Font {
    if !ensureFont() {
        return Font { raw: 0 };
    }
    let f = Font { raw: TTF_OpenFont(path, i32(size)) };
    rememberFont(f.raw, path, size);
    // The F3 overlay writes with the first font the game loads.
    if PROF.font.raw == 0 { PROF.font = f; }
    return f;
}

/// Try to load a font. Empty when the file or SDL_ttf is missing.
pub fn tryLoadFont(path: string, size: int): Font {
    return tryLoadFontC(cstr(path), size);
}

/// Load a font at point size; panics on failure.
pub fn loadFont(path: string, size: int): Font {
    if !ensureFont() {
        panic("libSDL2_ttf-2.0.so.0");
    }
    let f = tryLoadFont(path, size);
    let p = f.raw;
    return Font { raw: requirePtr(p, "TTF_OpenFont") };
}

/// Pack `SDL_Color` into the one register `TTF_RenderUTF8_Blended` reads.
/// A 4-byte struct argument is passed as four registers, so the green, blue, and alpha never arrive.
fn fontColor(c: SDL_Color): u32 {
    let r = u32(c.r);
    let g = u32(c.g);
    let b = u32(c.b);
    let a = u32(c.a);
    return r + g * 256 + b * 65536 + a * 16777216;
}

/// Slots in the `drawText` bake cache.
const TEXT_SLOTS: int = 256;
/// Longest string the bake cache will keep. Longer text is rasterized and dropped.
const TEXT_CAP: int = 128;

/// One cached rasterization: font, color, and bytes identify the texture.
struct TextSlot {
    /// False until a bake is stored here.
    live: bool;
    /// `Font.raw` this slot was baked with.
    font: ptr;
    /// Red channel baked into the glyphs.
    r: u8;
    /// Green channel baked into the glyphs.
    g: u8;
    /// Blue channel baked into the glyphs.
    b: u8;
    /// Alpha channel baked into the glyphs.
    a: u8;
    /// Stored byte count, always `<= TEXT_CAP`.
    len: int;
    /// Copy of the UTF-8 bytes. Scratch strings die at the next frame.
    bytes: [128]u8;
    /// GPU texture. Owned by the cache until the slot is reused. Zero when the slot only stores a size.
    tex: Texture;
    /// True once `tw` / `th` are known.
    sized: bool;
    /// Measured width in pixels.
    tw: i32;
    /// Measured height in pixels.
    th: i32;
    /// `frameCount` of the last hit, for eviction.
    used: int;
    /// True when this raster was emboldened.
    bold: bool;
}

/// When true, measure and draw use `TTF_STYLE_BOLD`.
#[singleton]
let textBold: bool = false;

/// Typographic options for the measure and draw calls (`textWidth`, `p2Text`, the caret and hit-test helpers). The default
/// (all off) is what app code gets; the `.j3ui` runtime sets it from the style of the element it is measuring or painting
/// (`j3.ui.dom.enterText`) and puts the previous value back after. Each field is read in one place: `textWidthPlain`
/// (measure), `atlasDraw` (glyph pen) and `p2TextRun` (runs cut at digits or code points).
pub struct TextMode {
    /// `font-variant-numeric: tabular-nums`: every ASCII digit has the widest digit's advance, centred in it.
    tabular: bool;
    /// `letter-spacing`: extra px after every glyph (code point), the last of a run included, as a browser adds it. Ignored in shaped
    /// (complex script, right to left) runs, which a browser does not space either.
    letterSp: f32;
    /// `word-spacing`: extra px after every U+0020 (on top of `letterSp`).
    wordSp: f32;
}

#[singleton]
let TM: TextMode;

/// Make `m` the text mode and return the one it replaced, so a caller can restore it. Not thread safe, like all of `j3.game` text.
pub fn setTextMode(m: TextMode): TextMode {
    let prev = TM;
    TM = m;
    return prev;
}

/// Cross-frame text cache. Scratch is rewound every frame, so this cannot live there.
#[singleton]
let textCache: [256]TextSlot;

/// True when slot `slot` holds `msg`.
fn textSame(slot: int, msg: []u8): bool {
    if textCache[slot].len != msg.len {
        return false;
    }
    let i = 0;
    while i < msg.len {
        if textCache[slot].bytes[i] != msg[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

/// True when slot `slot` matches `font`, the current draw color, and `msg`.
fn textHit(slot: int, font: ptr, msg: []u8): bool {
    if !textCache[slot].live {
        return false;
    }
    if textCache[slot].tex.raw == 0 {
        return false;
    }
    if textCache[slot].font != font {
        return false;
    }
    if textCache[slot].r != platform.color.r {
        return false;
    }
    if textCache[slot].g != platform.color.g {
        return false;
    }
    if textCache[slot].b != platform.color.b {
        return false;
    }
    if textCache[slot].a != platform.color.a {
        return false;
    }
    if textCache[slot].bold != textBold {
        return false;
    }
    return textSame(slot, msg);
}

/// Index of a matching slot, or `-1`.
fn textFind(font: ptr, msg: []u8): int {
    let i = 0;
    while i < TEXT_SLOTS {
        if textHit(i, font, msg) {
            return i;
        }
        i += 1;
    }
    return -1;
}

/// Empty slot, or the least recently used one.
fn textVictim(): int {
    let i = 0;
    let best = 0;
    let oldest = textCache[0].used;
    while i < TEXT_SLOTS {
        if !textCache[i].live {
            return i;
        }
        if textCache[i].used < oldest {
            best = i;
            oldest = textCache[i].used;
        }
        i += 1;
    }
    return best;
}

/// Store `tex` in `slot`, dropping whatever texture was there.
fn textRemember(slot: int, font: Font, msg: []u8, tex: Texture) {
    if textCache[slot].live {
        destroyTexture(textCache[slot].tex);
    }
    textCache[slot].live = true;
    textCache[slot].font = font.raw;
    textCache[slot].r = platform.color.r;
    textCache[slot].g = platform.color.g;
    textCache[slot].b = platform.color.b;
    textCache[slot].a = platform.color.a;
    textCache[slot].len = msg.len;
    let i = 0;
    while i < msg.len {
        textCache[slot].bytes[i] = msg[i];
        i += 1;
    }
    textCache[slot].tex = tex;
    textCache[slot].sized = true;
    textCache[slot].tw = tex.w;
    textCache[slot].th = tex.h;
    textCache[slot].used = frameCount();
    textCache[slot].bold = textBold;
}

/// Slot that already measured `msg` for `font`, ignoring color. `-1` when none.
fn textFindSized(font: ptr, msg: []u8): int {
    let i = 0;
    while i < TEXT_SLOTS {
        if textCache[i].live && textCache[i].sized && textCache[i].font == font && textCache[i].bold == textBold {
            if textSame(i, msg) {
                return i;
            }
        }
        i += 1;
    }
    return -1;
}

/// Remember a measurement. Reuses a slot with the same bytes when one exists.
fn textRememberSize(font: Font, msg: []u8, w: i32, h: i32) {
    let have = textFindSized(font.raw, msg);
    if have >= 0 {
        textCache[have].tw = w;
        textCache[have].th = h;
        textCache[have].used = frameCount();
        return;
    }
    let slot = textVictim();
    if textCache[slot].live {
        destroyTexture(textCache[slot].tex);
    }
    textCache[slot].live = true;
    textCache[slot].font = font.raw;
    textCache[slot].r = 0;
    textCache[slot].g = 0;
    textCache[slot].b = 0;
    textCache[slot].a = 0;
    textCache[slot].len = msg.len;
    let i = 0;
    while i < msg.len {
        textCache[slot].bytes[i] = msg[i];
        i += 1;
    }
    textCache[slot].tex = Texture { raw: 0, w: 0, h: 0 };
    textCache[slot].sized = true;
    textCache[slot].tw = w;
    textCache[slot].th = h;
    textCache[slot].used = frameCount();
    textCache[slot].bold = textBold;
}

/// Drop cached rasters for `font`.
fn textDropFont(font: ptr) {
    let i = 0;
    while i < TEXT_SLOTS {
        if textCache[i].live {
            if textCache[i].font == font {
                destroyTexture(textCache[i].tex);
                textCache[i].live = false;
                textCache[i].tex = Texture { raw: 0, w: 0, h: 0 };
            }
        }
        i += 1;
    }
}

/// Rasterize UTF-8 bytes to a texture in an explicit glyph color.
fn bakeColoredBytes(font: Font, msg: []u8, fg: u32): Texture {
    applyFontStyle(font);
    let surf = requirePtr(TTF_RenderUTF8_Blended(font.raw, cstrBytes(msg), fg), "TTF_Render");
    if platform.gl {
        let image = surfaceRgba(surf, scratch(65536));
        sdl.SDL_FreeSurface(surf);
        let sc = strikeScale(font.raw);
        if sc < 1.0 && image.w > 0 {
            image = rgbaShrink(image, strikePx(int(image.w), sc), strikePx(int(image.h), sc), scratch(65536));
        }
        let id = hudUpload(image);
        return Texture { raw: int(id) as ptr, w: image.w, h: image.h };
    }
    let raw = requirePtr(
        sdl.SDL_CreateTextureFromSurface(platform.renderer, surf),
        "SDL_CreateTextureFromSurface",
    );
    let w: i32 = 0;
    let h: i32 = 0;
    sdl.SDL_QueryTexture(raw, 0, 0, &w as ptr, &h as ptr);
    sdl.SDL_FreeSurface(surf);
    return Texture { raw: raw, w: w, h: h };
}

/// Rasterize UTF-8 bytes to a texture using the current draw color.
pub fn bakeTextBytes(font: Font, msg: []u8): Texture {
    return bakeColoredBytes(font, msg, fontColor(sdlColor()));
}

/// Rasterize UTF-8 text to a texture.
pub fn bakeText(font: Font, msg: string): Texture {
    return bakeTextBytes(font, []u8 { ptr: msg.ptr, len: msg.len });
}

/// Pixel width and height of `msg`. Zero when `font` is empty or measurement fails.
/// ASCII reuses the glyph atlas. Other strings reuse a cached measurement.
pub fn textSize(font: Font, msg: string): Vec2 {
    return textSizeBytes(font, []u8 { ptr: msg.ptr, len: msg.len });
}

/// Bitmap color fonts (Noto Color Emoji) have one fixed strike (109 px, line height 128) whatever size they
/// are opened at. For such a font opened at `size` this is `size / TTF_FontHeight`, the factor that makes
/// its line height the font size; 1 for every outline font. Measuring and baking scale by it, so the text
/// cache holds already-scaled rasters and the draw path is unchanged. Needs the font to be a `FONT_SRC`
/// entry (or its HiDPI twin); other handles are never scaled.
fn strikeScale(raw: ptr): f32 {
    if raw == 0 {
        return 1.0;
    }
    for i in 0..FONT_SRC_N {
        let sz = 0;
        if FONT_SRC[i].raw == raw {
            sz = FONT_SRC[i].size;
        } else if FONT_SRC[i].twin == raw {
            sz = FONT_SRC[i].tsize;
        }
        if sz > 0 {
            let f = &FONT_SRC[i];
            let h = int(TTF_FontHeight(raw));
            if f.fixed == 0 {
                f.fixed = 1;
                // an outline font is ~1.2 to 1.8 em tall; taller may be a fixed strike: it is one if the height ignores the size
                if h * 10 > sz * 16 && f.size < 4000 {
                    let probe = TTF_OpenFont(cstrBytes(f.path[0..f.plen]), i32(f.size * 2));
                    if probe != 0 {
                        if int(TTF_FontHeight(probe)) == int(TTF_FontHeight(f.raw)) {
                            f.fixed = 2;
                        }
                        TTF_CloseFont(probe);
                    }
                }
            }
            if f.fixed == 2 && h > sz {
                return f32(sz) / f32(h);
            }
            return 1.0;
        }
    }
    return 1.0;
}

/// `v` scaled by the strike factor `s`, to whole pixels.
fn strikePx(v: int, s: f32): int {
    if s >= 1.0 {
        return v;
    }
    let r = int(f32(v) * s + 0.5);
    if r < 1 && v > 0 {
        return 1;
    }
    return r;
}

/// Box-filter `src` down to `dw` x `dh` (alpha-weighted, so the transparent black around a glyph does not darken its edge).
fn rgbaShrink(src: Rgba, dw: int, dh: int, arena: &Arena): Rgba {
    let sw = int(src.w);
    let sh = int(src.h);
    let out = arena.alloc::<u8>(dw * dh * 4);
    for dy in 0..dh {
        let y0 = dy * sh / dh;
        let y1 = (dy + 1) * sh / dh;
        if y1 <= y0 { y1 = y0 + 1; }
        for dx in 0..dw {
            let x0 = dx * sw / dw;
            let x1 = (dx + 1) * sw / dw;
            if x1 <= x0 { x1 = x0 + 1; }
            let sr = 0;
            let sg = 0;
            let sb = 0;
            let sa = 0;
            for y in y0..y1 {
                for x in x0..x1 {
                    let i = (y * sw + x) * 4;
                    let a = int(src.pixels[i + 3]);
                    sr += int(src.pixels[i]) * a;
                    sg += int(src.pixels[i + 1]) * a;
                    sb += int(src.pixels[i + 2]) * a;
                    sa += a;
                }
            }
            let n = (y1 - y0) * (x1 - x0);
            let o = (dy * dw + dx) * 4;
            if sa > 0 {
                out[o] = u8(sr / sa);
                out[o + 1] = u8(sg / sa);
                out[o + 2] = u8(sb / sa);
            }
            out[o + 3] = u8(sa / n);
        }
    }
    return Rgba { pixels: out, w: i32(dw), h: i32(dh) };
}

/// Pixel width and height of UTF-8 bytes. Zero when `font` is empty or measurement fails.
/// ASCII reuses the glyph atlas. Other strings reuse a cached measurement.
pub fn textSizeBytes(font: Font, msg: []u8): Vec2 {
    if font.raw == 0 {
        return Vec2 { x: 0, y: 0 };
    }
    applyFontStyle(font);
    let sc = strikeScale(font.raw);
    if atlasOk(msg) && sc >= 1.0 {
        let slot = atlasFor(font);
        if slot >= 0 {
            return Vec2 { x: atlasWidth(slot, msg), y: f32(glyphAtlas[slot].line) };
        }
    }
    let sized = textFindSized(font.raw, msg);
    if sized >= 0 {
        return Vec2 { x: f32(textCache[sized].tw), y: f32(textCache[sized].th) };
    }
    let w: i32 = 0;
    let h: i32 = 0;
    if TTF_SizeUTF8(font.raw, cstrBytes(msg), &w as ptr, &h as ptr) != 0 {
        return Vec2 { x: 0, y: 0 };
    }
    w = i32(strikePx(int(w), sc));
    h = i32(strikePx(int(h), sc));
    textRememberSize(font, msg, w, h);
    return Vec2 { x: f32(w), y: f32(h) };
}

/// Draw `msg`. ASCII comes from the glyph atlas. Other strings reuse a cached raster.
pub fn drawText(font: Font, pos: Vec2, msg: string) {
    drawTextBytes(font, pos, []u8 { ptr: msg.ptr, len: msg.len });
}

/// Like `drawText`, but SDL_ttf emboldens the glyphs.
pub fn drawTextBold(font: Font, pos: Vec2, msg: string) {
    textBold = true;
    drawText(font, pos, msg);
    textBold = false;
}

/// Like `textSize`, measured with the bold face.
pub fn textSizeBold(font: Font, msg: string): Vec2 {
    textBold = true;
    let sz = textSize(font, msg);
    textBold = false;
    return sz;
}

/// Per-font ASCII advances for `textWidth`: needs SDL_ttf only (no window, no atlas).
struct AdvTab {
    font: ptr;
    bold: bool;
    adv: [95]i32;
    /// Widest of the ten digits: the shared advance in tabular mode.
    dmax: i32;
}

#[singleton]
let advTabs: [64]AdvTab;
#[singleton]
let advCount: int;

fn advFor(font: Font, bold: bool): int {
    for i in 0..advCount {
        if advTabs[i].font == font.raw && advTabs[i].bold == bold {
            return i;
        }
    }
    let slot = advCount;
    if advCount < 64 {
        advCount += 1;
    } else {
        slot = 63;
    }
    advTabs[slot].font = font.raw;
    advTabs[slot].bold = bold;
    let style: i32 = 0;
    if bold {
        style = TTF_STYLE_BOLD;
    }
    TTF_SetFontStyle(font.raw, style);
    for g in 0..95 {
        let raw: [1]u8 = [u8(g + 32)];
        let w: i32 = 0;
        let h: i32 = 0;
        TTF_SizeUTF8(font.raw, cstrBytes([]u8 { ptr: &raw[0], len: 1 }), &w as ptr, &h as ptr);
        advTabs[slot].adv[g] = w;
    }
    advTabs[slot].dmax = 0;
    for g in 16..26 {
        if advTabs[slot].adv[g] > advTabs[slot].dmax {
            advTabs[slot].dmax = advTabs[slot].adv[g];
        }
    }
    return slot;
}

/// True when the installed SDL_ttf shapes text with HarfBuzz (2.20+ built with it): Arabic letters join,
/// Indic and other complex scripts reorder, ligatures form. Without it text is laid out glyph by glyph.
pub fn textShaping(): bool {
    if !ensureFont() || fontFns.hb == 0 {
        return false;
    }
    let major: i32 = 0;
    let minor: i32 = 0;
    let patch: i32 = 0;
    let f = fontFns.hb as fn(ptr, ptr, ptr);
    f(&major as ptr, &minor as ptr, &patch as ptr);
    return major != 0 || minor != 0;
}

/// Direction and script SDL_ttf shapes `font` with from now on (`rtl` true = right to left; `script` is an
/// ISO 15924 tag such as "Arab", "" keeps the last). Only meaningful with `textShaping()`; a no-op otherwise.
pub fn fontShape(font: Font, rtl: bool, script: string) {
    if font.raw == 0 || fontFns.dir == 0 || fontFns.script == 0 {
        return;
    }
    let d = fontFns.dir as fn(ptr, i32): i32;
    let r: i32 = 0;
    if rtl {
        r = 1;
    }
    d(font.raw, r);
    if script.len > 0 {
        let sc = fontFns.script as fn(ptr, cstr): i32;
        sc(font.raw, cstr(script));
    }
}
