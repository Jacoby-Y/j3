// Part of j3.game (ASCII glyph atlas and glyph sheet); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Fonts that can hold an ASCII atlas at once.
const ATLAS_FONTS: int = 16;
/// Glyphs from space through `~`.
const ATLAS_GLYPHS: int = 95;

/// White ASCII glyphs for one font. Digits are baked once and redrawn.
struct Atlas {
    /// False until `atlasBuild` fills this slot.
    live: bool;
    /// `Font.raw` these glyphs belong to.
    font: ptr;
    /// True when the glyphs were emboldened.
    bold: bool;
    /// `TTF_FontHeight`, used as the line size.
    line: i32;
    /// `TTF_FontAscent`, used to sit glyphs on one baseline.
    ascent: i32;
    /// Horizontal advance of each glyph.
    adv: [95]i32;
    /// Left bearing of each glyph.
    dx: [95]i32;
    /// Top of each glyph relative to the line top.
    dy: [95]i32;
    /// White glyph texture. Empty for space. (SDL path; with GL the glyphs share `sheet`.)
    tex: [95]Texture;
    /// GL: one texture holding every glyph (0 on the SDL path).
    sheet: u32;
    /// GL: sheet width and height in pixels.
    sheetW: i32;
    sheetH: i32;
    /// GL: glyph rect in the sheet (top-left and size, pixels). Width 0 for space.
    gx: [95]i32;
    gy: [95]i32;
    gw: [95]i32;
    gh: [95]i32;
}

/// Atlas table. Not the scratch arena: glyphs must outlive the frame.
#[singleton]
let glyphAtlas: [16]Atlas;

/// True when every byte is printable ASCII. Any length: the atlas places one glyph at a time (`TEXT_CAP` only bounds the bake cache).
fn atlasOk(msg: []u8): bool {
    if msg.len == 0 {
        return false;
    }
    let i = 0;
    while i < msg.len {
        let b = int(msg[i]);
        if b < 32 || b > 126 {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Packed white for atlas glyphs.
fn whiteFg(): u32 {
    return fontColor(SDL_Color { r: 255, g: 255, b: 255, a: 255 });
}

/// Index of an atlas for `font`, or `-1`.
fn atlasFind(font: ptr): int {
    let i = 0;
    while i < ATLAS_FONTS {
        if glyphAtlas[i].live && glyphAtlas[i].font == font && glyphAtlas[i].bold == textBold {
            return i;
        }
        i += 1;
    }
    return -1;
}

/// Existing atlas, or a newly built one. `-1` when the font is empty or has no height.
fn applyFontStyle(font: Font) {
    if font.raw == 0 {
        return;
    }
    let style: i32 = 0;
    if textBold {
        style = TTF_STYLE_BOLD;
    }
    TTF_SetFontStyle(font.raw, style);
}

fn atlasFor(font: Font): int {
    if font.raw == 0 {
        return -1;
    }
    applyFontStyle(font);
    let have = atlasFind(font.raw);
    if have >= 0 {
        return have;
    }
    return atlasBuild(font);
}

/// Drop glyph textures in one atlas slot.
fn atlasClear(slot: int) {
    let g = 0;
    while g < ATLAS_GLYPHS {
        destroyTexture(glyphAtlas[slot].tex[g]);
        glyphAtlas[slot].tex[g] = Texture { raw: 0, w: 0, h: 0 };
        g += 1;
    }
    glyphAtlas[slot].live = false;
    if glyphAtlas[slot].sheet != 0 && glyphAtlas[slot].sheet != SHEET_TEX {
        hudDelete(int(glyphAtlas[slot].sheet) as ptr);
        glyphAtlas[slot].sheet = 0;
    }
}

/// Bake one ASCII glyph into `slot`.
/// `TTF_RenderUTF8_Blended` already returns a font-height surface with the
/// baseline in place, so the quad sits at the line top with no extra offset.
fn atlasGlyph(slot: int, font: Font, g: int) {
    let ch = g + 32;
    let raw: [1]u8 = [0];
    raw[0] = u8(ch);
    let bytes = []u8 { ptr: &raw[0], len: 1 };
    glyphAtlas[slot].dx[g] = 0;
    glyphAtlas[slot].dy[g] = 0;
    if ch == 32 {
        let w: i32 = 0;
        let h: i32 = 0;
        TTF_SizeUTF8(font.raw, cstrBytes(bytes), &w as ptr, &h as ptr);
        glyphAtlas[slot].adv[g] = w;
        glyphAtlas[slot].tex[g] = Texture { raw: 0, w: 0, h: 0 };
        return;
    }
    let tex = bakeColoredBytes(font, bytes, whiteFg());
    glyphAtlas[slot].tex[g] = tex;
    glyphAtlas[slot].adv[g] = tex.w;
}

/// Build an atlas into a free slot, or slot 0 when the table is full.
fn atlasBuild(font: Font): int {
    let line = TTF_FontHeight(font.raw);
    let ascent = TTF_FontAscent(font.raw);
    if line < 1 {
        return -1;
    }
    let slot = 0;
    let i = 0;
    while i < ATLAS_FONTS {
        if !glyphAtlas[i].live {
            slot = i;
            i = ATLAS_FONTS;
        } else {
            i += 1;
        }
    }
    if glyphAtlas[slot].live {
        atlasClear(slot);
    }
    glyphAtlas[slot].live = true;
    glyphAtlas[slot].font = font.raw;
    glyphAtlas[slot].bold = textBold;
    glyphAtlas[slot].line = line;
    glyphAtlas[slot].ascent = ascent;
    if platform.gl {
        atlasSheet(slot, font);
        return slot;
    }
    let g = 0;
    while g < ATLAS_GLYPHS {
        atlasGlyph(slot, font, g);
        g += 1;
    }
    return slot;
}

/// GL: render every glyph into one shelf-packed texture, so a line of text is one batch.
/// Glyphs sit one transparent pixel apart so linear sampling never bleeds a neighbor.
fn atlasSheet(slot: int, font: Font) {
    hudInit();
    let line = int(glyphAtlas[slot].line);
    let sheetW = 1024;
    let x = 0;
    let y = 0;
    let g = 0;
    while g < ATLAS_GLYPHS {
        let raw: [1]u8 = [u8(g + 32)];
        let w: i32 = 0;
        let h: i32 = 0;
        TTF_SizeUTF8(font.raw, cstrBytes([]u8 { ptr: &raw[0], len: 1 }), &w as ptr, &h as ptr);
        if x + int(w) + 1 > sheetW {
            x = 0;
            y += line + 1;
        }
        glyphAtlas[slot].gx[g] = i32(x);
        glyphAtlas[slot].gy[g] = i32(y);
        glyphAtlas[slot].gw[g] = w;
        glyphAtlas[slot].adv[g] = w;
        x += int(w) + 1;
        g += 1;
    }
    let sheetH = y + line + 1;
    let pix = libc.calloc(sheetW * sheetH, 4) as &u8;
    if pix as ptr == 0 {
        panic("atlas");
    }
    g = 1;
    while g < ATLAS_GLYPHS {
        let ch1: [1]u8 = [u8(g + 32)];
        let surf = requirePtr(TTF_RenderUTF8_Blended(font.raw, cstrBytes([]u8 { ptr: &ch1[0], len: 1 }), whiteFg()), "TTF_Render");
        let image = surfaceRgba(surf, scratch(65536));
        sdl.SDL_FreeSurface(surf);
        let cw = int(image.w);
        if cw > int(glyphAtlas[slot].gw[g]) { cw = int(glyphAtlas[slot].gw[g]); }
        let ch = int(image.h);
        if ch > line { ch = line; }
        glyphAtlas[slot].gw[g] = i32(cw);
        glyphAtlas[slot].gh[g] = i32(ch);
        let dst = []u8 { ptr: pix, len: sheetW * sheetH * 4 };
        let row = 0;
        while row < ch {
            let from = row * int(image.w) * 4;
            let to = ((int(glyphAtlas[slot].gy[g]) + row) * sheetW + int(glyphAtlas[slot].gx[g])) * 4;
            let k = 0;
            while k < cw * 4 {
                dst[to + k] = image.pixels[from + k];
                k += 1;
            }
            row += 1;
        }
        g += 1;
    }
    glyphAtlas[slot].gw[0] = 0;
    glyphAtlas[slot].sheetW = i32(sheetW);
    glyphAtlas[slot].sheetH = i32(sheetH);
    glyphAtlas[slot].sheet = sheetPlace(slot, pix as ptr, sheetW, sheetH);
    libc.free(pix as ptr);
}

/// One texture shared by every font's glyph sheet (each sheet is a band of rows), so text in
/// different fonts and sizes stays in one batch. `SHEET_USED` rows are taken.
const SHEET_W: int = 1024;
const SHEET_H: int = 4096;
#[singleton]
let SHEET_TEX: u32;
#[singleton]
let SHEET_USED: int;

/// Upload a glyph sheet into the shared texture and move the slot's glyph rows to its band;
/// returns the texture id. ponytail: a cleared atlas leaves its band unused, and once the shared
/// texture is full a sheet gets a texture of its own (more batches, still correct).
fn sheetPlace(slot: int, pix: ptr, w: int, h: int): u32 {
    if w != SHEET_W || SHEET_USED + h > SHEET_H {
        return hudTexBytes(pix, i32(w), i32(h));
    }
    let bind = HUD.bindTexture as fn(u32, u32);
    if SHEET_TEX == 0 {
        let gen = HUD.genTextures as fn(i32, ptr);
        let id: u32 = 0;
        gen(1, &id as ptr);
        SHEET_TEX = id;
        bind(GL_TEXTURE_2D, id);
        let image = HUD.texImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
        image(GL_TEXTURE_2D, 0, GL_RGBA8, i32(SHEET_W), i32(SHEET_H), 0, GL_RGBA, GL_UNSIGNED_BYTE, 0 as ptr);
        let param = HUD.texParameteri as fn(u32, u32, i32);
        param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        param(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
    }
    bind(GL_TEXTURE_2D, SHEET_TEX);
    let update = HUD.texSubImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    update(GL_TEXTURE_2D, 0, 0, i32(SHEET_USED), i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, pix);
    for g in 0..ATLAS_GLYPHS {
        glyphAtlas[slot].gy[g] += i32(SHEET_USED);
    }
    glyphAtlas[slot].sheetH = i32(SHEET_H);
    SHEET_USED += h;
    return SHEET_TEX;
}

/// Sum of glyph advances.
fn atlasWidth(slot: int, msg: []u8): f32 {
    let pen = 0;
    let i = 0;
    while i < msg.len {
        let g = int(msg[i]) - 32;
        pen = pen + int(glyphAtlas[slot].adv[g]);
        i += 1;
    }
    return f32(pen);
}

/// Physical px per drawing unit when a raster at glyph `scale` lands about one texel per device pixel
/// (the HiDPI twin, no `pushScale`), else 0: then glyphs are snapped to the device grid and drawn
/// at exactly one texel per pixel, like a browser, instead of resampled by `GL_LINEAR`.
fn texelScale(scale: f32): f32 {
    let k = paintScale();
    let d = scale * k - 1.0;
    if platform.gl && d > -0.05 && d < 0.05 {
        return k;
    }
    return 0.0;
}

/// `v` rounded to a device pixel at `k` physical px per unit.
fn snapPx(v: f32, k: f32): f32 {
    let p = v * k;
    if p >= 0.0 {
        return f32(int(p + 0.5)) / k;
    }
    return (0.0 - f32(int(0.5 - p))) / k;
}

/// Draw ASCII from the atlas, tinted with the current color.
fn atlasDraw(slot: int, pos: Vec2, msg: []u8, scale: f32) {
    let pen = pos.x;
    let i = 0;
    // `TextMode.letterSp` / `wordSp` (in the units of `scale`'s glyph raster, see `p2TextRaw`)
    let ls = TM.letterSp * scale;
    let ws = TM.wordSp * scale;
    // `TextMode.tabular`: digits share the widest digit's advance, each glyph centred in it
    let dmax = 0;
    if TM.tabular {
        for g in 16..26 {
            if int(glyphAtlas[slot].adv[g]) > dmax { dmax = int(glyphAtlas[slot].adv[g]); }
        }
    }
    if platform.gl {
        let sw = f32(glyphAtlas[slot].sheetW);
        let sh = f32(glyphAtlas[slot].sheetH);
        let sheet = glyphAtlas[slot].sheet;
        let col = platform.color;
        // 1:1 texels: each glyph origin snapped, quads one texel per device pixel; the advance stays
        // `adv * scale` so a run is as wide as layout measured it
        let k = texelScale(scale);
        let qs = scale;
        let qy = pos.y;
        if k > 0.0 {
            qs = 1.0 / k;
            qy = snapPx(pos.y, k);
        }
        while i < msg.len {
            let gi = int(msg[i]) - 32;
            let gw = glyphAtlas[slot].gw[gi];
            let adv = int(glyphAtlas[slot].adv[gi]);
            let cx: f32 = 0.0;
            if dmax > 0 && gi >= 16 && gi < 26 {
                cx = f32(dmax - adv) * 0.5 * scale;
                adv = dmax;
            }
            if gw > 0 {
                let gh = f32(glyphAtlas[slot].gh[gi]);
                let qx = pen + cx;
                if k > 0.0 {
                    qx = snapPx(pen, k);
                }
                p2Push(P2_TEX, qx, qy, f32(gw) * qs, gh * qs,
                    f32(glyphAtlas[slot].gx[gi]) / sw, f32(glyphAtlas[slot].gy[gi]) / sh, f32(gw) / sw, gh / sh,
                    col, col, TG.x0, TG.y0, TG.x1, TG.y1, TG.row, sheet);
            }
            pen = pen + f32(adv) * scale + ls;
            if gi == 0 { pen += ws; }
            i += 1;
        }
        return;
    }
    while i < msg.len {
        let g = int(msg[i]) - 32;
        let tex = glyphAtlas[slot].tex[g];
        let ga = int(glyphAtlas[slot].adv[g]);
        let ox: f32 = 0.0;
        if dmax > 0 && g >= 16 && g < 26 {
            ox = f32(dmax - ga) * 0.5;
            ga = dmax;
        }
        if tex.raw != 0 {
            let x = pen + ox + f32(glyphAtlas[slot].dx[g]);
            let y = pos.y + f32(glyphAtlas[slot].dy[g]);
            drawGlyph(tex, Vec2 { x: x, y: y });
        }
        pen = pen + f32(ga) + TM.letterSp;
        if g == 0 { pen += TM.wordSp; }
        i += 1;
    }
}

/// Drop every atlas that belongs to `font`.
fn atlasDrop(font: ptr) {
    let i = 0;
    while i < ATLAS_FONTS {
        if glyphAtlas[i].live && glyphAtlas[i].font == font {
            atlasClear(i);
        }
        i += 1;
    }
}
