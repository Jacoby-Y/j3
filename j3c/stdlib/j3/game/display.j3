/// Video settings as one value a menu can bind to: window mode, resolution, monitor, vsync and
/// frame cap, applied together and saved between runs. The primitives are in `j3.game`
/// (`setWindowMode`, `setResolution`, `setVsync`, ...); this module is the "Video" menu on top.
/// Main thread only (it calls `j3.game`).
///
///     let v = display.loadAndApply("video.cfg", mem);   // at startup, before the first frame
///     // button on:click:
///     display.cycleMode(&v); display.apply(&v);
///     // Apply button:
///     display.store(&v, "video.cfg", mem);

module j3.game.display;

use j3.data.save;
use j3.game;
use j3.game.WindowMode;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.text.Text;

/// Everything a Video settings page edits.
pub struct Settings {
    /// Windowed, borderless or exclusive fullscreen.
    mode: WindowMode;
    /// Width: the windowed size, or the exclusive-fullscreen resolution. Borderless uses the desktop.
    w: int;
    /// Height, same rules as `w`.
    h: int;
    /// Monitor index.
    display: int;
    /// Wait for the display refresh.
    vsync: bool;
    /// Frame cap in frames per second, 0 for none.
    fpsLimit: int;
}

fn modeInt(m: WindowMode): int {
    match m {
        WindowMode.Windowed { return 0; }
        WindowMode.Borderless { return 1; }
        WindowMode.Fullscreen { return 2; }
    }
}

fn modeFrom(i: int): WindowMode {
    if i == 1 { return WindowMode.Borderless; }
    if i == 2 { return WindowMode.Fullscreen; }
    return WindowMode.Windowed;
}

/// The window as it is now.
pub fn current(): Settings {
    let size = game.windowSize();
    return Settings {
        mode: game.windowMode(),
        w: int(size.x),
        h: int(size.y),
        display: game.currentDisplay(),
        vsync: game.vsync(),
        fpsLimit: game.fpsLimit(),
    };
}

/// Make the window match `s`: monitor, then mode, then resolution, then vsync and cap.
/// Call before `game.init` and it only records them, so the window opens that way.
pub fn apply(s: &Settings) {
    game.setVsync(s.vsync);
    game.setFpsLimit(s.fpsLimit);
    if s.display != game.currentDisplay() { game.moveToDisplay(s.display); }
    // Windowed first so the size is set while it can take effect, then into the target mode.
    game.setWindowMode(WindowMode.Windowed);
    if s.w > 0 && s.h > 0 { game.setResolution(s.w, s.h); }
    if modeInt(s.mode) != 0 {
        game.setWindowMode(WindowMode.Borderless);
        if modeInt(s.mode) == 2 {
            game.setResolution(s.w, s.h);
            game.setWindowMode(s.mode);
        }
    }
}

/// Settings saved by `store`; any key not in the file keeps its current value.
pub fn load(path: string, arena: &Arena): Settings {
    let cur = current();
    let sv = save.load(path, arena);
    return Settings {
        mode: modeFrom(save.getInt(&sv, "window.mode", modeInt(cur.mode))),
        w: save.getInt(&sv, "window.w", cur.w),
        h: save.getInt(&sv, "window.h", cur.h),
        display: save.getInt(&sv, "window.display", cur.display),
        vsync: save.getInt(&sv, "window.vsync", if cur.vsync { 1 } else { 0 }) != 0,
        fpsLimit: save.getInt(&sv, "window.fps", cur.fpsLimit),
    };
}

/// Write `s` to `path`, keeping other keys that file already has.
pub fn store(s: &Settings, path: string, arena: &Arena) {
    let sv = save.load(path, arena);
    save.putInt(&sv, "window.mode", modeInt(s.mode));
    save.putInt(&sv, "window.w", s.w);
    save.putInt(&sv, "window.h", s.h);
    save.putInt(&sv, "window.display", s.display);
    save.putInt(&sv, "window.vsync", if s.vsync { 1 } else { 0 });
    save.putInt(&sv, "window.fps", s.fpsLimit);
    save.store(&sv, path);
}

/// `load` then `apply`: the one call for a startup system.
pub fn loadAndApply(path: string, arena: &Arena): Settings {
    let s = load(path, arena);
    apply(&s);
    return s;
}

/// Windowed, then Borderless, then Fullscreen, then back.
pub fn nextMode(m: WindowMode): WindowMode {
    return modeFrom((modeInt(m) + 1) % 3);
}

/// Step `n` through off, 30, 60, 120, 144, 165, 240 by `dir` (+1 or -1), stopping at the ends.
/// A value not on the list steps to its nearest neighbour in that direction.
pub fn stepFps(n: int, dir: int): int {
    let steps = [0, 30, 60, 120, 144, 165, 240];
    if dir > 0 {
        for i in 0..7 {
            if steps[i] > n { return steps[i]; }
        }
        return 240;
    }
    let k = 6;
    while k > 0 {
        if steps[k] < n { return steps[k]; }
        k -= 1;
    }
    return 0;
}

/// Index `i` moved by `dir` inside `0..n`, wrapping.
pub fn wrapIndex(i: int, dir: int, n: int): int {
    if n <= 0 { return 0; }
    return ((i + dir) % n + n) % n;
}

/// Change to the next mode (`s` only; call `apply`).
pub fn cycleMode(s: &Settings) {
    s.mode = nextMode(s.mode);
}

/// Windowed to Borderless and back (an F11 / Alt+Enter handler). Applies at once.
pub fn toggleFullscreen(s: &Settings) {
    if modeInt(s.mode) == 0 { s.mode = WindowMode.Borderless; } else { s.mode = WindowMode.Windowed; }
    game.setWindowMode(s.mode);
}

/// Step to the next (`dir` 1) or previous (-1) resolution the monitor offers (`s` only; call `apply`).
pub fn nextResolution(s: &Settings, dir: int) {
    let n = game.resolutionCount(s.display);
    let at = 0;
    for i in 0..n {
        let r = game.resolutionAt(s.display, i);
        if int(r.x) == s.w && int(r.y) == s.h { at = i; }
    }
    let pick = game.resolutionAt(s.display, wrapIndex(at, dir, n));
    s.w = int(pick.x);
    s.h = int(pick.y);
}

/// Next (`dir` 1) or previous (-1) monitor (`s` only; call `apply`).
pub fn nextDisplay(s: &Settings, dir: int) {
    s.display = wrapIndex(s.display, dir, game.displayCount());
}

/// Flip vsync (`s` only; call `apply`).
pub fn toggleVsync(s: &Settings) {
    s.vsync = !s.vsync;
}

/// Next (`dir` 1) or previous (-1) frame cap (`s` only; call `apply`).
pub fn nextFpsLimit(s: &Settings, dir: int) {
    s.fpsLimit = stepFps(s.fpsLimit, dir);
}

/// "Windowed", "Borderless" or "Fullscreen".
pub fn modeName(m: WindowMode): string {
    match m {
        WindowMode.Windowed { return "Windowed"; }
        WindowMode.Borderless { return "Borderless"; }
        WindowMode.Fullscreen { return "Fullscreen"; }
    }
}

/// "1920 x 1080", appended to `buf` and returned as a view into it (valid until `buf` grows or is cleared).
pub fn resolutionLabel(s: &Settings, buf: &Text): string {
    let start = buf.bytes.len;
    buf.pushInt(s.w);
    buf.pushStr(" x ");
    buf.pushInt(s.h);
    return buf.bytes[start..buf.bytes.len] as string;
}

/// "Unlimited" for 0, else the number.
pub fn fpsLabel(n: int, buf: &Text): string {
    if n <= 0 { return "Unlimited"; }
    let start = buf.bytes.len;
    buf.pushInt(n);
    return buf.bytes[start..buf.bytes.len] as string;
}
