// Part of j3.game (draw color, rects, images and textures); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Set the current draw color.
pub fn setColor(c: Color) {
    platform.color = c;
}

/// Clear the backbuffer to black.
pub fn clear() {
    if platform.gl { clearTo(Color { r: 0, g: 0, b: 0, a: 255 }); return; }
    sdl.SDL_SetRenderDrawColor(platform.renderer, 0, 0, 0, 255);
    sdl.SDL_RenderClear(platform.renderer);
}

/// Clear the backbuffer to `c`.
pub fn clearTo(c: Color) {
    if platform.gl {
        p2Flush();
        let color = glProc("glClearColor") as fn(f32, f32, f32, f32);
        color(f32(c.r) / 255.0, f32(c.g) / 255.0, f32(c.b) / 255.0, f32(c.a) / 255.0);
        let clearGl = glProc("glClear") as fn(u32);
        if VIRT_W > 0 && P2_SURFACE_N == 0 && LAYER_N == 0 {
            // Only the drawing area: the bars stay black.
            let r = p2FbRect();
            let en = glProc("glEnable") as fn(u32); let dis = glProc("glDisable") as fn(u32);
            let sc = glProc("glScissor") as fn(i32, i32, i32, i32);
            en(GL_SCISSOR_TEST); sc(i32(r.x), i32(r.y), i32(r.w), i32(r.h));
            clearGl(0x4000);
            dis(GL_SCISSOR_TEST);
            return;
        }
        clearGl(0x4000);
        return;
    }
    sdl.SDL_SetRenderDrawColor(platform.renderer, c.r, c.g, c.b, c.a);
    sdl.SDL_RenderClear(platform.renderer);
}

/// Fill a screen-space axis-aligned rect.
pub fn drawRect(pos: Vec2, size: Vec2) {
    if platform.gl {
        hudInit();
        p2Push(P2_RECT, pos.x, pos.y, size.x, size.y, 0, 0, 0, 0, platform.color, platform.color, 0, 0, 0, 0, 0, 0);
        return;
    }
    let rect = SDL_Rect {
        x: i32(pos.x),
        y: i32(pos.y),
        w: i32(size.x),
        h: i32(size.y),
    };
    applyColor();
    sdl.SDL_RenderFillRect(platform.renderer, &rect);
}

/// Fill a world-space rect through `cam`.
pub fn drawRectCam(cam: Camera, pos: Vec2, size: Vec2) {
    drawRect(cam.toScreen(pos), size * cam.zoom);
}

/// Empty RGBA image.
fn rgbaEmpty(arena: &Arena): Rgba {
    return Rgba {
        pixels: arena.alloc::<u8>(0),
        w: 0,
        h: 0,
    };
}

/// Copy a surface into tightly packed RGBA8. Frees `surf` when conversion fails only if we created it.
fn copySurface(surf: ptr, arena: &Arena): Rgba {
    if sdl.SDL_LockSurface(surf) != 0 {
        return rgbaEmpty(arena);
    }
    let locked = surf as &SDL_Surface;
    if locked.w < 1 || locked.h < 1 || locked.pitch < locked.w * 4 || locked.pixels == 0 {
        sdl.SDL_UnlockSurface(surf);
        return rgbaEmpty(arena);
    }
    let w = int(locked.w);
    let h = int(locked.h);
    let pitch = int(locked.pitch);
    let out = arena.alloc::<u8>(w * h * 4);
    let y = 0;
    while y < h {
        let src: []u8 = []u8 {
            ptr: (locked.pixels as int + y * pitch) as &u8,
            len: w * 4,
        };
        let x = 0;
        let row = y * w * 4;
        while x < w * 4 {
            out[row + x] = src[x];
            x += 1;
        }
        y += 1;
    }
    sdl.SDL_UnlockSurface(surf);
    return Rgba { pixels: out, w: locked.w, h: locked.h };
}

/// Convert `surf` to RGBA8 and copy it. Does not free `surf`.
fn surfaceRgba(surf: ptr, arena: &Arena): Rgba {
    let conv = sdl.SDL_ConvertSurfaceFormat(surf, SDL_PIXELFORMAT_ABGR8888, 0);
    if conv == 0 {
        return rgbaEmpty(arena);
    }
    let image = copySurface(conv, arena);
    sdl.SDL_FreeSurface(conv);
    return image;
}

/// Load a PNG (or other SDL_image file) as tightly packed RGBA8. Without SDL_image, 8-bit
/// PNGs still load (`j3.gfx.canvas.loadPng`). Empty when the file is missing or can't be read.
pub fn loadRgba(path: string, arena: &Arena): Rgba {
    if ensureImage() {
        let surf = IMG_Load(cstr(path));
        if surf != 0 {
            let image = surfaceRgba(surf, arena);
            sdl.SDL_FreeSurface(surf);
            return image;
        }
    }
    let c = loadPng(path, arena);
    if c.w > 0 {
        return Rgba { pixels: c.pixels, w: c.w, h: c.h };
    }
    warnNoImage(path);
    return rgbaEmpty(arena);
}

#[singleton]
let warnedNoImage: bool = false;

/// Say once per run that an image didn't load because SDL2_image is missing.
fn warnNoImage(path: string) {
    if warnedNoImage || ensureImage() {
        return;
    }
    warnedNoImage = true;
    let t = Text.new(scratch(4096));
    t.pushStr("SDL2_image is not installed: ");
    t.pushStr(path);
    t.pushStr(" did not load (PNG loads without it; JPEG needs it)");
    printLn(t.str());
}

/// A texture from an 8-bit PNG through `j3.gfx.canvas.loadPng`; empty when that can't read it.
fn pngTexture(path: string): Texture {
    let arena = Arena.create(1048576);
    let c = loadPng(path, &arena);
    let tex = Texture { raw: 0, w: 0, h: 0 };
    if c.w > 0 {
        tex = textureFromCanvas(c);
    } else {
        warnNoImage(path);
    }
    arena.destroy();
    return tex;
}

/// A texture file on a GL window: decoded to RGBA (PNG, or JPEG and the rest through SDL_image) and
/// uploaded as a HUD texture. Empty when the file can't be read.
fn glFileTexture(path: string): Texture {
    let arena = Arena.create(1048576);
    let image = loadRgba(path, &arena);
    let tex = Texture { raw: 0, w: 0, h: 0 };
    if image.w > 0 {
        let id = hudUpload(image);
        if id != 0 {
            tex = Texture { raw: int(id) as ptr, w: image.w, h: image.h };
        }
    }
    arena.destroy();
    return tex;
}

/// Load an image as a texture; panics on failure.
pub fn loadTexture(path: string): Texture {
    if platform.gl {
        let glTex = glFileTexture(path);
        if glTex.raw == 0 {
            panic(path);
        }
        return glTex;
    }
    if !ensureImage() {
        let tex = pngTexture(path);
        if tex.raw == 0 {
            panic(soLib(SO_IMAGE));
        }
        return tex;
    }
    let surf = requirePtr(IMG_Load(cstr(path)), "IMG_Load");
    let raw = requirePtr(
        sdl.SDL_CreateTextureFromSurface(platform.renderer, surf),
        "SDL_CreateTextureFromSurface",
    );
    sdl.SDL_FreeSurface(surf);
    let w: i32 = 0;
    let h: i32 = 0;
    sdl.SDL_QueryTexture(raw, 0, 0, &w as ptr, &h as ptr);
    return Texture { raw: raw, w: w, h: h };
}

/// Try to load a texture from a C string path. Empty when the file is missing, or when
/// SDL_image is missing and it isn't an 8-bit PNG.
pub fn tryLoadTextureC(path: cstr): Texture {
    if platform.gl {
        return glFileTexture([]u8 { ptr: path as &u8, len: libc.strlen(path) } as string);
    }
    if ensureImage() {
        let surf = IMG_Load(path);
        if surf != 0 {
            let raw = sdl.SDL_CreateTextureFromSurface(platform.renderer, surf);
            sdl.SDL_FreeSurface(surf);
            if raw == 0 {
                return Texture { raw: 0, w: 0, h: 0 };
            }
            let w: i32 = 0;
            let h: i32 = 0;
            sdl.SDL_QueryTexture(raw, 0, 0, &w as ptr, &h as ptr);
            return Texture { raw: raw, w: w, h: h };
        }
    }
    return pngTexture([]u8 { ptr: path as &u8, len: libc.strlen(path) } as string);
}

/// Try to load a texture. Empty when the file is missing, or when SDL_image is missing and
/// it isn't an 8-bit PNG.
pub fn tryLoadTexture(path: string): Texture {
    return tryLoadTextureC(cstr(path));
}

/// Upload a generated canvas once, with filtering selected by its raster mode.
/// The canvas can be released after upload. Call after `init` or `initGl`.
pub fn textureFromCanvas(canvas: Canvas): Texture {
    if canvas.w < 1 || canvas.h < 1 || canvas.pixels.len < int(canvas.w) * int(canvas.h) * 4 {
        panic("textureFromCanvas: invalid canvas");
    }
    if platform.gl {
        hudInit();
        let filter: i32 = GL_LINEAR;
        if canvas.mode == Mode.Pixel { filter = GL_NEAREST; }
        let id = hudTexBytesFiltered(canvas.pixels.ptr as ptr, canvas.w, canvas.h, filter);
        return Texture { raw: int(id) as ptr, w: canvas.w, h: canvas.h };
    }
    if platform.renderer == 0 { panic("textureFromCanvas: init first"); }
    let raw = requirePtr(
        sdl.SDL_CreateTexture(platform.renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STATIC, canvas.w, canvas.h),
        "SDL_CreateTexture",
    );
    sdl.SDL_SetTextureBlendMode(raw, SDL_BLENDMODE_BLEND);
    let sdlFilter: i32 = 1;
    if canvas.mode == Mode.Pixel { sdlFilter = 0; }
    if sdl.SDL_SetTextureScaleMode(raw, sdlFilter) != 0 {
        sdl.SDL_DestroyTexture(raw);
        panic("SDL_SetTextureScaleMode");
    }
    if sdl.SDL_UpdateTexture(raw, 0, canvas.pixels.ptr as ptr, canvas.w * 4) != 0 {
        sdl.SDL_DestroyTexture(raw);
        panic("SDL_UpdateTexture");
    }
    return Texture { raw: raw, w: canvas.w, h: canvas.h };
}

/// Update a clipped rectangle of a texture from a canvas of the same size.
/// Direct writes to `canvas.pixels` work: pass the changed rectangle explicitly.
pub fn updateTextureFromCanvas(tex: Texture, canvas: Canvas, x: i32, y: i32, w: i32, h: i32) {
    if tex.raw == 0 || tex.w != canvas.w || tex.h != canvas.h || canvas.pixels.len < int(canvas.w) * int(canvas.h) * 4 {
        panic("updateTextureFromCanvas: size mismatch");
    }
    let x0 = int(x); let y0 = int(y); let x1 = int(x) + int(w); let y1 = int(y) + int(h);
    if x0 < 0 { x0 = 0; } if y0 < 0 { y0 = 0; }
    if x1 > int(canvas.w) { x1 = int(canvas.w); } if y1 > int(canvas.h) { y1 = int(canvas.h); }
    if x0 >= x1 || y0 >= y1 { return; }
    let offset = (y0 * int(canvas.w) + x0) * 4;
    let pixels = (canvas.pixels.ptr as int + offset) as ptr;
    if platform.gl {
        hudInit();
        p2Flush();
        let bind = HUD.bindTexture as fn(u32, u32);
        bind(GL_TEXTURE_2D, u32(tex.raw as int));
        let store = HUD.pixelStorei as fn(u32, i32);
        store(GL_UNPACK_ROW_LENGTH, canvas.w);
        let update = HUD.texSubImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
        update(GL_TEXTURE_2D, 0, i32(x0), i32(y0), i32(x1 - x0), i32(y1 - y0), GL_RGBA, GL_UNSIGNED_BYTE, pixels);
        store(GL_UNPACK_ROW_LENGTH, 0);
        return;
    }
    let rect = SDL_Rect { x: i32(x0), y: i32(y0), w: i32(x1 - x0), h: i32(y1 - y0) };
    if sdl.SDL_UpdateTexture(tex.raw, &rect as ptr, pixels, canvas.w * 4) != 0 { panic("SDL_UpdateTexture"); }
}

/// Draw a texture at its native size.
pub fn drawTexture(tex: Texture, pos: Vec2) {
    if platform.gl {
        hudBlit(tex, pos, Vec2 { x: f32(tex.w), y: f32(tex.h) }, Vec2 { x: 0, y: 0 }, Vec2 { x: f32(tex.w), y: f32(tex.h) });
        return;
    }
    let rect = SDL_Rect {
        x: i32(pos.x),
        y: i32(pos.y),
        w: tex.w,
        h: tex.h,
    };
    sdl.SDL_RenderCopy(platform.renderer, tex.raw, 0, &rect);
}

/// Draw a texture into a screen rect.
pub fn drawTextureAt(tex: Texture, dest: Vec2, destSize: Vec2) {
    if platform.gl {
        hudBlit(tex, dest, destSize, Vec2 { x: 0, y: 0 }, Vec2 { x: f32(tex.w), y: f32(tex.h) });
        return;
    }
    let dst = SDL_Rect {
        x: i32(dest.x),
        y: i32(dest.y),
        w: i32(destSize.x),
        h: i32(destSize.y),
    };
    sdl.SDL_RenderCopy(platform.renderer, tex.raw, 0, &dst);
}

/// Draw a source sub-rect of a texture into a dest rect.
pub fn drawTextureSrc(tex: Texture, src: Vec2, srcSize: Vec2, dest: Vec2, destSize: Vec2) {
    if platform.gl {
        hudBlit(tex, dest, destSize, src, srcSize);
        return;
    }
    let srcRect = SDL_Rect {
        x: i32(src.x),
        y: i32(src.y),
        w: i32(srcSize.x),
        h: i32(srcSize.y),
    };
    let dst = SDL_Rect {
        x: i32(dest.x),
        y: i32(dest.y),
        w: i32(destSize.x),
        h: i32(destSize.y),
    };
    sdl.SDL_RenderCopy(platform.renderer, tex.raw, &srcRect as ptr, &dst);
}

/// Draw a texture in world space through `cam`.
pub fn drawTextureCam(cam: Camera, tex: Texture, pos: Vec2) {
    drawTextureAt(tex, cam.toScreen(pos), Vec2 { x: f32(tex.w) * cam.zoom, y: f32(tex.h) * cam.zoom });
}

/// Draw a sized texture in world space through `cam`.
pub fn drawTextureAtCam(cam: Camera, tex: Texture, dest: Vec2, destSize: Vec2) {
    drawTextureAt(tex, cam.toScreen(dest), destSize * cam.zoom);
}

/// Draw a source rect with rotation, flip, and tint. `flip` is 0, 1 (horizontal), or 2 (vertical).
pub fn drawTextureEx(
    tex: Texture,
    src: Vec2,
    srcSize: Vec2,
    dest: Vec2,
    destSize: Vec2,
    angle: f32,
    flip: int,
    tint: Color,
) {
    if tex.raw == 0 {
        return;
    }
    if platform.gl {
        drawTextureSrc(tex, src, srcSize, dest, destSize);
        return;
    }
    sdl.SDL_SetTextureColorMod(tex.raw, tint.r, tint.g, tint.b);
    let srcRect = SDL_Rect {
        x: i32(src.x),
        y: i32(src.y),
        w: i32(srcSize.x),
        h: i32(srcSize.y),
    };
    let dst = SDL_Rect {
        x: i32(dest.x),
        y: i32(dest.y),
        w: i32(destSize.x),
        h: i32(destSize.y),
    };
    sdl.SDL_RenderCopyEx(platform.renderer, tex.raw, &srcRect as ptr, &dst, f64(angle), 0, i32(flip));
    sdl.SDL_SetTextureColorMod(tex.raw, 255, 255, 255);
}

/// `drawTextureEx` in world space through `cam`.
pub fn drawTextureExCam(
    cam: Camera,
    tex: Texture,
    src: Vec2,
    srcSize: Vec2,
    dest: Vec2,
    destSize: Vec2,
    angle: f32,
    flip: int,
    tint: Color,
) {
    drawTextureEx(tex, src, srcSize, cam.toScreen(dest), destSize * cam.zoom, angle, flip, tint);
}

/// Stroke a line in screen pixels using the current draw color.
pub fn drawLine(a: Vec2, b: Vec2) {
    if platform.gl || platform.renderer == 0 {
        return;
    }
    applyColor();
    sdl.SDL_RenderDrawLine(platform.renderer, i32(a.x), i32(a.y), i32(b.x), i32(b.y));
}

/// Draw a source sub-rect in world space through `cam`.
pub fn drawTextureSrcCam(
    cam: Camera,
    tex: Texture,
    src: Vec2,
    srcSize: Vec2,
    dest: Vec2,
    destSize: Vec2,
) {
    drawTextureSrc(tex, src, srcSize, cam.toScreen(dest), destSize * cam.zoom);
}

/// Free a texture.
pub fn destroyTexture(tex: Texture) {
    if tex.raw == 0 {
        return;
    }
    if platform.gl {
        hudDelete(tex.raw);
        return;
    }
    sdl.SDL_DestroyTexture(tex.raw);
}
