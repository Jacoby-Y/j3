// Part of j3.game (sounds, channel groups, music, volume); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Try to load a sound from a C string path. Empty when the file or SDL_mixer is missing.
pub fn tryLoadSoundC(path: cstr): Sound {
    if !ensureAudio() {
        return Sound { raw: 0 };
    }
    return Sound { raw: Mix_LoadWAV(path) };
}

/// Try to load a sound. Empty when the file or SDL_mixer is missing.
pub fn tryLoadSound(path: string): Sound {
    return tryLoadSoundC(cstr(path));
}

/// Load a sound sample; panics on failure.
pub fn loadSound(path: string): Sound {
    if !ensureAudio() {
        panic(soLib(SO_MIXER));
    }
    let s = tryLoadSound(path);
    let p = s.raw;
    return Sound { raw: requirePtr(p, "Mix_LoadWAV") };
}

/// Play a sound once on the sfx group. Returns the mixer channel, or `-1`.
pub fn play(sound: Sound): int {
    return playGroup(sound, 0, 0);
}

// `loops` is Mix_PlayChannel: 0 plays once, 1 plays twice, -1 repeats.
/// Play a sound on the sfx group with a Mix-style loop count. Returns the channel, or `-1`.
pub fn playLoops(sound: Sound, loops: int): int {
    return playGroup(sound, 0, loops);
}

/// Channel range for a group. `0` is sfx (0..8), `1` is voice (8..16).
fn groupSpan(group: int): Vec2 {
    if group == 1 {
        return Vec2 { x: 8, y: 16 };
    }
    return Vec2 { x: 0, y: 8 };
}

/// Next free-ish channel in `group`, wrapping inside that group's range.
fn takeChannel(group: int): i32 {
    if group == 1 {
        let voice = nextVoice;
        nextVoice = nextVoice + 1;
        if nextVoice >= 16 {
            nextVoice = 8;
        }
        return i32(voice);
    }
    let sfx = nextSfx;
    nextSfx = nextSfx + 1;
    if nextSfx >= 8 {
        nextSfx = 0;
    }
    return i32(sfx);
}

/// Play `sound` on the sfx (`0`) or voice (`1`) group. Returns the channel, or `-1`.
pub fn playGroup(sound: Sound, group: int, loops: int): int {
    if sound.raw == 0 || !ensureAudio() {
        return 0 - 1;
    }
    let ch = takeChannel(group);
    let played = Mix_PlayChannel(ch, sound.raw, i32(loops));
    if played < 0 {
        return 0 - 1;
    }
    return int(played);
}

/// Set every channel in `group` to `volume` (0..128). `0` is sfx, `1` is voice.
pub fn setGroupVolume(group: int, volume: int) {
    if !ensureAudio() {
        return;
    }
    let span = groupSpan(group);
    let i = int(span.x);
    let end = int(span.y);
    while i < end {
        Mix_Volume(i32(i), i32(volume));
        i += 1;
    }
}

/// Fade `sound` in on `group` over `ms` milliseconds. Returns the channel, or `-1`.
pub fn fadeIn(sound: Sound, group: int, ms: int): int {
    if sound.raw == 0 || !ensureAudio() {
        return 0 - 1;
    }
    let ch = takeChannel(group);
    let played = Mix_FadeInChannel(ch, sound.raw, 0, i32(ms));
    if played < 0 {
        return 0 - 1;
    }
    return int(played);
}

/// Fade `channel` out over `ms` milliseconds. `-1` fades every channel.
pub fn fadeOut(channel: int, ms: int) {
    if !ensureAudio() {
        return;
    }
    Mix_FadeOutChannel(i32(channel), i32(ms));
}

/// Place `channel` in the stereo field. `angle` is degrees, `distance` is 0..255.
pub fn setPosition(channel: int, angle: int, distance: int) {
    if !ensureAudio() {
        return;
    }
    let d = distance;
    if d < 0 {
        d = 0;
    }
    if d > 255 {
        d = 255;
    }
    Mix_SetPosition(i32(channel), i16(angle), u8(d));
}

/// Halt all sound channels.
pub fn stop() {
    Mix_HaltChannel(-1);
}

/// Free a sound.
pub fn destroySound(sound: Sound) {
    if sound.raw != 0 {
        Mix_FreeChunk(sound.raw);
    }
}

/// Try to load music from a C string path. Empty when the file or SDL_mixer is missing.
pub fn tryLoadMusicC(path: cstr): Music {
    if !ensureAudio() {
        return Music { raw: 0 };
    }
    return Music { raw: Mix_LoadMUS(path) };
}

/// Try to load music. Empty when the file or SDL_mixer is missing.
pub fn tryLoadMusic(path: string): Music {
    return tryLoadMusicC(cstr(path));
}

/// Load looping music; panics on failure.
pub fn loadMusic(path: string): Music {
    if !ensureAudio() {
        panic(soLib(SO_MIXER));
    }
    let m = tryLoadMusic(path);
    let p = m.raw;
    return Music { raw: requirePtr(p, "Mix_LoadMUS") };
}

/// Start music looping forever.
pub fn playMusic(music: Music) {
    if music.raw == 0 {
        return;
    }
    Mix_PlayMusic(music.raw, -1);
}

/// Fade music in, looping forever, over `ms` milliseconds.
pub fn fadeInMusic(music: Music, ms: int) {
    if music.raw == 0 || !ensureAudio() {
        return;
    }
    Mix_FadeInMusic(music.raw, -1, i32(ms));
}

/// Fade the playing music out over `ms` milliseconds.
pub fn fadeOutMusic(ms: int) {
    if !ensureAudio() {
        return;
    }
    Mix_FadeOutMusic(i32(ms));
}

/// Stop the music channel.
pub fn stopMusic() {
    Mix_HaltMusic();
}

/// Free music.
pub fn destroyMusic(music: Music) {
    if music.raw != 0 {
        Mix_FreeMusic(music.raw);
    }
}

// Channel and music levels are 0..128.
/// Set all sound channel volumes (0..128).
pub fn setVolume(volume: int) {
    if !ensureAudio() {
        panic(soLib(SO_MIXER));
    }
    Mix_Volume(-1, i32(volume));
}

/// Set music volume (0..128).
pub fn setMusicVolume(volume: int) {
    if !ensureAudio() {
        panic(soLib(SO_MIXER));
    }
    Mix_VolumeMusic(i32(volume));
}
