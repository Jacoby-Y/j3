// Part of j3.game (IMG_* / Mix_* / TTF_* wrappers over the add-on function pointers); the module doc and `use`s are in ../game.j3.
module j3.game;

fn IMG_Init(flags: i32): i32 {
    let f = imageFns.init as fn(i32): i32;
    return f(flags);
}

fn IMG_Load(file: cstr): ptr {
    let f = imageFns.load as fn(cstr): ptr;
    return f(file);
}

fn IMG_Quit() {
    if imageFns.quit == 0 {
        return;
    }
    let f = imageFns.quit as fn();
    f();
}

fn Mix_OpenAudio(freq: i32, format: u16, channels: i32, chunksize: i32): i32 {
    let f = mixerFns.open as fn(i32, u16, i32, i32): i32;
    return f(freq, format, channels, chunksize);
}

fn Mix_LoadWAV(file: cstr): ptr {
    let f = mixerFns.loadWav as fn(cstr): ptr;
    return f(file);
}

fn Mix_PlayChannel(channel: i32, chunk: ptr, loops: i32): i32 {
    let f = mixerFns.play as fn(i32, ptr, i32): i32;
    return f(channel, chunk, loops);
}

fn Mix_HaltChannel(channel: i32) {
    let f = mixerFns.halt as fn(i32);
    f(channel);
}

fn Mix_FreeChunk(chunk: ptr) {
    let f = mixerFns.freeChunk as fn(ptr);
    f(chunk);
}

fn Mix_LoadMUS(file: cstr): ptr {
    let f = mixerFns.loadMus as fn(cstr): ptr;
    return f(file);
}

fn Mix_PlayMusic(music: ptr, loops: i32): i32 {
    let f = mixerFns.playMus as fn(ptr, i32): i32;
    return f(music, loops);
}

fn Mix_HaltMusic() {
    let f = mixerFns.haltMus as fn();
    f();
}

fn Mix_FreeMusic(music: ptr) {
    let f = mixerFns.freeMus as fn(ptr);
    f(music);
}

fn Mix_Volume(channel: i32, volume: i32): i32 {
    let f = mixerFns.volume as fn(i32, i32): i32;
    return f(channel, volume);
}

fn Mix_VolumeMusic(volume: i32): i32 {
    let f = mixerFns.volumeMus as fn(i32): i32;
    return f(volume);
}

fn Mix_AllocateChannels(n: i32): i32 {
    let f = mixerFns.alloc as fn(i32): i32;
    return f(n);
}

fn Mix_FadeInChannel(channel: i32, chunk: ptr, loops: i32, ms: i32): i32 {
    let f = mixerFns.fadeIn as fn(i32, ptr, i32, i32): i32;
    return f(channel, chunk, loops, ms);
}

fn Mix_FadeOutChannel(channel: i32, ms: i32): i32 {
    let f = mixerFns.fadeOut as fn(i32, i32): i32;
    return f(channel, ms);
}

fn Mix_FadeInMusic(music: ptr, loops: i32, ms: i32): i32 {
    let f = mixerFns.fadeInMus as fn(ptr, i32, i32): i32;
    return f(music, loops, ms);
}

fn Mix_FadeOutMusic(ms: i32): i32 {
    let f = mixerFns.fadeOutMus as fn(i32): i32;
    return f(ms);
}

fn Mix_SetPosition(channel: i32, angle: i16, distance: u8): i32 {
    let f = mixerFns.position as fn(i32, i16, u8): i32;
    return f(channel, angle, distance);
}

fn Mix_CloseAudio() {
    if mixerFns.close == 0 {
        return;
    }
    let f = mixerFns.close as fn();
    f();
}

fn TTF_Init(): i32 {
    let f = fontFns.init as fn(): i32;
    return f();
}

fn TTF_OpenFont(file: cstr, ptsize: i32): ptr {
    let f = fontFns.open as fn(cstr, i32): ptr;
    return f(file, ptsize);
}

fn TTF_CloseFont(font: ptr) {
    let f = fontFns.close as fn(ptr);
    f(font);
}

fn TTF_RenderUTF8_Blended(font: ptr, text: cstr, fg: u32): ptr {
    let f = fontFns.render as fn(ptr, cstr, u32): ptr;
    return f(font, text, fg);
}

fn TTF_SizeUTF8(font: ptr, text: cstr, w: ptr, h: ptr): i32 {
    let f = fontFns.size as fn(ptr, cstr, ptr, ptr): i32;
    return f(font, text, w, h);
}

fn TTF_FontAscent(font: ptr): i32 {
    let f = fontFns.ascent as fn(ptr): i32;
    return f(font);
}

fn TTF_FontHeight(font: ptr): i32 {
    let f = fontFns.height as fn(ptr): i32;
    return f(font);
}

fn TTF_SetFontStyle(font: ptr, style: i32) {
    let f = fontFns.style as fn(ptr, i32);
    f(font, style);
}

fn TTF_Quit() {
    if fontFns.quit == 0 {
        return;
    }
    let f = fontFns.quit as fn();
    f();
}
