// Part of j3.game (env, capture, screenshot, present); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Width and height `readWindow` reads, in window pixels (the whole window, bars included, whatever the
/// virtual size). `out` needs `w * h * 4` bytes.
pub fn windowPixels(): Vec2 {
    return Vec2 { x: f32(platform.win_w), y: f32(platform.win_h) };
}

/// Copy the frame drawn so far (before `present`) into `out` as RGBA8, top row first:
/// window pixels wide and tall (the bars too under `setVirtualSize`), 4 bytes a pixel. False when it could not be read.
pub fn readWindow(out: []u8): bool {
    p2Flush();
    let w = platform.win_w;
    let h = platform.win_h;
    if out.len < w * h * 4 || platform.window == 0 { return false; }
    if !platform.gl {
        // ABGR8888 is R, G, B, A in memory order on little-endian machines.
        return sdl.SDL_RenderReadPixels(platform.renderer, 0, 0x16762004, out.ptr as ptr, i32(w * 4)) == 0;
    }
    let bind = glProc("glBindFramebuffer");
    let pick = glProc("glReadBuffer");
    let read = glProc("glReadPixels");
    if bind == 0 || pick == 0 || read == 0 { return false; }
    let bindFbo = bind as fn(u32, u32);
    let readBuffer = pick as fn(u32);
    let readPixels = read as fn(i32, i32, i32, i32, u32, u32, ptr);
    // GL_READ_FRAMEBUFFER 0 (the window), GL_BACK, GL_RGBA, GL_UNSIGNED_BYTE.
    bindFbo(0x8CA8, 0);
    readBuffer(0x0405);
    readPixels(0, 0, i32(w), i32(h), 0x1908, 0x1401, out.ptr as ptr);
    // GL reads bottom row first; swap rows in place.
    let row = w * 4;
    let y = 0;
    while y < h / 2 {
        let a = y * row;
        let b = (h - 1 - y) * row;
        let i = 0;
        while i < row {
            let t = out[a + i];
            out[a + i] = out[b + i];
            out[b + i] = t;
            i += 1;
        }
        y += 1;
    }
    return true;
}

/// Swap the GL window or present the 2D renderer.
/// Frames presented so far.
#[singleton]
let PRESENTED: int = 0;
/// Quit after this many frames (0: never), from `J3_FRAMES`.
#[singleton]
let STOP_AT: int = 0;

/// `$name`, or "" when unset.
pub fn env(name: string): string {
    let raw = libc.getenv(cstr(name));
    if raw == 0 { return ""; }
    return []u8 { ptr: raw as &u8, len: libc.strlen(raw) } as string;
}

/// Save the frame drawn so far to `path` as a PNG. Call it after drawing and before
/// `present`. False when the pixels could not be read or the file not written.
pub fn captureFrame(path: string): bool {
    return screenshot(path);
}

/// `J3_CAPTURE=out.png:N` target path, set on the first present.
#[singleton]
let CAPTURE_PATH: string;
/// `J3_FIXED_DT` in seconds (0 unset) and whether it was read.
#[singleton]
let FIXED_DT: f32;
#[singleton]
let FIXED_READ: bool;

/// `$name` as a number (digits and one dot), or 0 when unset.
fn envNum(name: string): f32 {
    let s = env(name);
    let whole: f32 = 0.0;
    let frac: f32 = 0.0;
    let scale: f32 = 1.0;
    let dot = false;
    let k = 0;
    while k < s.len {
        let c = s[k];
        if c == 46 { dot = true; }
        else if c >= 48 && c <= 57 {
            if dot { scale = scale / 10.0; frac = frac + f32(int(c) - 48) * scale; }
            else { whole = whole * 10.0 + f32(int(c) - 48); }
        }
        k += 1;
    }
    return whole + frac;
}

/// `J3_FIXED_DT` as seconds (digits and one dot), or 0 when unset.
pub fn fixedDt(): f32 {
    if !FIXED_READ {
        FIXED_READ = true;
        FIXED_DT = envNum("J3_FIXED_DT");
    }
    return FIXED_DT;
}

/// Save the frame drawn so far to `path` as a PNG, and say where on stdout.
fn screenshot(path: string): bool {
    let ok = false;
    // The whole window, bars included, in real pixels.
    let w = i32(platform.win_w);
    let h = i32(platform.win_h);
    if w < 1 || h < 1 { return false; }
    let mem = Arena.create(int(w) * int(h) * 9 + 4096);
    let canvas = Canvas.create(&mem, w, h, Mode.Pixel);
    if !readWindow(canvas.pixels) {
        printLn("j3: could not read the frame for the screenshot");
    } else {
        // The window's alpha is not the picture's.
        let i = 3;
        while i < canvas.pixels.len {
            canvas.pixels[i] = 255;
            i += 4;
        }
        match canvas.savePng(path, &mem) {
            Result.Ok(_) { ok = true; }
            Result.Err(_) { printLn("j3: could not write the screenshot"); }
        }
    }
    mem.destroy();
    return ok;
}

/// `J3_FRAMES` as a number; 60 when only `J3_SCREENSHOT` is set.
fn framesWanted(): int {
    let frames = env("J3_FRAMES");
    let n = 0;
    let k = 0;
    while k < frames.len && frames[k] >= 48 && frames[k] <= 57 {
        n = n * 10 + int(frames[k]) - 48;
        k += 1;
    }
    let shot = env("J3_SCREENSHOT");
    if n == 0 && shot.len > 0 { n = 60; }
    // `J3_CAPTURE=out.png:N`: split at the last colon.
    let cap = env("J3_CAPTURE");
    let c = cap.len - 1;
    while c > 0 && cap[c] != 58 { c -= 1; }
    if c > 0 {
        let m = 0;
        let j = c + 1;
        while j < cap.len && cap[j] >= 48 && cap[j] <= 57 { m = m * 10 + int(cap[j]) - 48; j += 1; }
        if m > 0 {
            CAPTURE_PATH = cap[0..c];
            n = m;
        }
    }
    return n;
}

fn applyCursor() {
    let k = if EDGE_CURSOR > 0 { EDGE_CURSOR } else { cursorWant };
    cursorWant = 0;
    if k == cursorShown { return; }
    if cursors[k] == 0 { cursors[k] = sdl.SDL_CreateSystemCursor(i32(k)); }
    if cursors[k] != 0 { sdl.SDL_SetCursor(cursors[k]); cursorShown = k; }
}

/// GL entry points for `opaqueAlpha`, loaded on the first Android swap.
#[singleton]
let OPAQUE: [4]ptr;
/// Clear color saved around `opaqueAlpha`.
#[singleton]
let OPAQUE_COLOR: [4]f32;

/// Android only, just before the swap: set the default framebuffer's alpha to 1, so a stray alpha
/// below 1 (blended HUD, glass) never makes the window see-through. Writes alpha only; the clear
/// color and the color mask are put back.
fn opaqueAlpha() {
    if OPAQUE[0] == 0 {
        OPAQUE[0] = glProc("glColorMask");
        OPAQUE[1] = glProc("glClearColor");
        OPAQUE[2] = glProc("glClear");
        OPAQUE[3] = glProc("glGetFloatv");
        if OPAQUE[0] == 0 || OPAQUE[1] == 0 || OPAQUE[2] == 0 || OPAQUE[3] == 0 { panic("GL entry points for opaqueAlpha"); }
    }
    let maskFn = OPAQUE[0] as fn(u8, u8, u8, u8);
    let colorFn = OPAQUE[1] as fn(f32, f32, f32, f32);
    let clearFn = OPAQUE[2] as fn(u32);
    let getFn = OPAQUE[3] as fn(u32, ptr);
    getFn(0x0C22, &OPAQUE_COLOR[0] as ptr);
    maskFn(0, 0, 0, 1);
    colorFn(0.0, 0.0, 0.0, 1.0);
    clearFn(0x4000);
    maskFn(1, 1, 1, 1);
    colorFn(OPAQUE_COLOR[0], OPAQUE_COLOR[1], OPAQUE_COLOR[2], OPAQUE_COLOR[3]);
}

/// 1 when `J3_GL_CHECK=1` (report `glGetError` after every frame), -1 when not, 0 before the first frame.
#[singleton]
let GL_CHECK: int;

/// `J3_GL_CHECK=1`: print the GL error code seen at the end of a frame (not a repeat of the one before), so a bad call on a
/// phone shows up in the log. Costs one `glGetError` per frame, and only when asked for.
fn glCheck() {
    if GL_CHECK == 0 {
        let v = env("J3_GL_CHECK");
        GL_CHECK = if v.len == 1 && v[0] == 49 { 1 } else { -1 };
        if GL_CHECK < 0 { return; }
    }
    let get = glProc("glGetError") as fn(): u32;
    let e = get();
    while e != 0 {
        if int(e) != GL_LAST {
            GL_LAST = int(e);
            let t = Text.new(scratch(0));
            t.pushStr("GL error 0x");
            t.push("0123456789abcdef"[(int(e) / 256) % 16]);
            t.push("0123456789abcdef"[(int(e) / 16) % 16]);
            t.push("0123456789abcdef"[int(e) % 16]);
            t.pushStr(" at frame ");
            t.pushInt(PRESENTED);
            t.pushStr("\n");
            write(2, t.str().ptr as ptr, t.str().len);
        }
        e = get();
    }
}

/// The error code printed last (a repeat of it is not printed again).
#[singleton]
let GL_LAST: int;

/// Show the frame. F3 toggles the profiler overlay, F4 the UI cost breakdown (`J3_F4=1` starts it open). `j3c run --frames N --screenshot FILE`
/// sets `J3_FRAMES` and `J3_SCREENSHOT`: frame N is saved to FILE before it is shown, then
/// quit is requested, and a `J3STATS` line of the run's averages is printed.
pub fn present() {
    if PRESENTED == 0 {
        STOP_AT = framesWanted();
        // `J3_F4=1` opens the UI cost overlay from the start (screenshots).
        PROF.uiShown = env("J3_F4").len > 0;
    }
    PRESENTED += 1;
    let last = STOP_AT > 0 && PRESENTED == STOP_AT;
    if keyPressedRaw(Key.F3) { PROF.shown = !PROF.shown; }
    if keyPressedRaw(Key.F4) { PROF.uiShown = !PROF.uiShown; }
    profUiEnd();
    if PROF.shown { profOverlay(); }
    if PROF.uiShown { uiOverlay(); }
    p2Flush();
    // The overlays' own draws are not the app's.
    uiClear();
    if GL_CHECK >= 0 && platform.gl { glCheck(); }
    profEnd();
    applyCursor();
    if last {
        let shot = env("J3_SCREENSHOT");
        if CAPTURE_PATH.len > 0 { shot = CAPTURE_PATH; }
        if shot.len > 0 { screenshot(shot); }
        profReport();
    }
    if platform.gl {
        if PLATFORM == 3 { opaqueAlpha(); }
        sdl.SDL_GL_SwapWindow(platform.window);
        // An offscreen swap never waits, so `--frames` runs wait for the GPU here or
        // `J3STATS` would count only CPU time.
        if STOP_AT > 0 {
            if PROF.finish == 0 { PROF.finish = glProc("glFinish"); }
            let finish = PROF.finish as fn();
            finish();
        }
    } else {
        sdl.SDL_RenderPresent(platform.renderer);
    }
    PROF.swapped = micros();
    if FPS_LIMIT > 0 && STOP_AT == 0 {
        let want = 1000000 / FPS_LIMIT;
        let spent = PROF.swapped - LAST_PRESENT;
        if spent < want - 1000 { sdl.SDL_Delay(u32((want - spent) / 1000)); }
        PROF.swapped = micros();
    }
    LAST_PRESENT = PROF.swapped;
    if last { requestQuit(); }
}
