// Part of j3.game (Key, pad and axis to SDL ids; controller opening); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Scancode of the right-hand twin of Shift, Ctrl, Alt and Super; `scancode(key)` for other keys.
fn rightScancode(key: Key): int {
    if key == Key.Shift { return 229; }
    if key == Key.Ctrl { return 228; }
    if key == Key.Alt { return 230; }
    if key == Key.Super { return 231; }
    return scancode(key);
}

/// SDL scancode for a `Key`.
fn scancode(key: Key): int {
    match key {
        Key.Escape { return 41; }
        Key.Left { return 80; }
        Key.Right { return 79; }
        Key.Up { return 82; }
        Key.Down { return 81; }
        Key.Space { return 44; }
        Key.Enter { return 40; }
        Key.Tab { return 43; }
        Key.Shift { return 225; }
        Key.Ctrl { return 224; }
        Key.Backspace { return 42; }
        Key.A { return 4; }
        Key.B { return 5; }
        Key.C { return 6; }
        Key.D { return 7; }
        Key.E { return 8; }
        Key.F { return 9; }
        Key.G { return 10; }
        Key.H { return 11; }
        Key.I { return 12; }
        Key.J { return 13; }
        Key.K { return 14; }
        Key.L { return 15; }
        Key.M { return 16; }
        Key.N { return 17; }
        Key.O { return 18; }
        Key.P { return 19; }
        Key.Q { return 20; }
        Key.R { return 21; }
        Key.S { return 22; }
        Key.T { return 23; }
        Key.U { return 24; }
        Key.V { return 25; }
        Key.W { return 26; }
        Key.X { return 27; }
        Key.Y { return 28; }
        Key.Z { return 29; }
        Key.Num0 { return 39; }
        Key.Num1 { return 30; }
        Key.Num2 { return 31; }
        Key.Num3 { return 32; }
        Key.Num4 { return 33; }
        Key.Num5 { return 34; }
        Key.Num6 { return 35; }
        Key.Num7 { return 36; }
        Key.Num8 { return 37; }
        Key.Num9 { return 38; }
        Key.F3 { return 60; }
        Key.F10 { return 67; }
        Key.Delete { return 76; }
        Key.F2 { return 59; }
        Key.F11 { return 68; }
        Key.F12 { return 69; }
        Key.Home { return 74; }
        Key.End { return 77; }
        Key.Minus { return 45; }
        Key.Period { return 55; }
        Key.F4 { return 61; }
        Key.F5 { return 62; }
        Key.Alt { return 226; }
        Key.PageUp { return 75; }
        Key.PageDown { return 78; }
        Key.F1 { return 58; }
        Key.F6 { return 63; }
        Key.F7 { return 64; }
        Key.F8 { return 65; }
        Key.F9 { return 66; }
        Key.F13 { return 104; }
        Key.F14 { return 105; }
        Key.F15 { return 106; }
        Key.F16 { return 107; }
        Key.F17 { return 108; }
        Key.F18 { return 109; }
        Key.F19 { return 110; }
        Key.F20 { return 111; }
        Key.F21 { return 112; }
        Key.F22 { return 113; }
        Key.F23 { return 114; }
        Key.F24 { return 115; }
        Key.Insert { return 73; }
        Key.PrintScreen { return 70; }
        Key.ScrollLock { return 71; }
        Key.Pause { return 72; }
        Key.CapsLock { return 57; }
        Key.NumLock { return 83; }
        Key.Menu { return 101; }
        Key.Super { return 227; }
        Key.ShiftRight { return 229; }
        Key.CtrlRight { return 228; }
        Key.AltRight { return 230; }
        Key.Grave { return 53; }
        Key.Equals { return 46; }
        Key.LeftBracket { return 47; }
        Key.RightBracket { return 48; }
        Key.Backslash { return 49; }
        Key.Semicolon { return 51; }
        Key.Apostrophe { return 52; }
        Key.Comma { return 54; }
        Key.Slash { return 56; }
        Key.KpDivide { return 84; }
        Key.KpMultiply { return 85; }
        Key.KpMinus { return 86; }
        Key.KpPlus { return 87; }
        Key.KpEnter { return 88; }
        Key.KpPeriod { return 99; }
        Key.Kp0 { return 98; }
        Key.Kp1 { return 89; }
        Key.Kp2 { return 90; }
        Key.Kp3 { return 91; }
        Key.Kp4 { return 92; }
        Key.Kp5 { return 93; }
        Key.Kp6 { return 94; }
        Key.Kp7 { return 95; }
        Key.Kp8 { return 96; }
        Key.Kp9 { return 97; }
    }
}

/// SDL game-controller button id for a `Pad`.
fn padButton(btn: Pad): i32 {
    match btn {
        Pad.A { return 0; }
        Pad.B { return 1; }
        Pad.X { return 2; }
        Pad.Y { return 3; }
        Pad.Back { return 4; }
        Pad.Start { return 6; }
        Pad.LB { return 9; }
        Pad.RB { return 10; }
        Pad.Up { return 11; }
        Pad.Down { return 12; }
        Pad.Left { return 13; }
        Pad.Right { return 14; }
    }
}

/// SDL game-controller axis id for an `Axis`.
fn padAxisId(axis: Axis): i32 {
    match axis {
        Axis.LeftX { return 0; }
        Axis.LeftY { return 1; }
        Axis.RightX { return 2; }
        Axis.RightY { return 3; }
        Axis.LT { return 4; }
        Axis.RT { return 5; }
    }
}

/// Controller pointer for pad index 0 or 1.
fn padPtr(i: int): ptr {
    if i == 0 {
        return platform.pad0;
    }
    if i == 1 {
        return platform.pad1;
    }
    return 0;
}

/// Open controllers 0 and 1 if not already open, and drop the ones that were unplugged (hotplug, once per `poll`).
fn ensurePads() {
    // an unplugged pad: close its handle (reads give 0 meanwhile), so plugging one in reopens the slot
    if platform.pad0 != 0 && sdl.SDL_GameControllerGetAttached(platform.pad0) == 0 {
        sdl.SDL_GameControllerClose(platform.pad0);
        platform.pad0 = 0;
    }
    if platform.pad1 != 0 && sdl.SDL_GameControllerGetAttached(platform.pad1) == 0 {
        sdl.SDL_GameControllerClose(platform.pad1);
        platform.pad1 = 0;
    }
    // device indices shift when one pad leaves, so index 0 or 1 may be the physical pad the other slot already holds: compare instance ids
    // and drop the duplicate (the slot stays empty until another pad appears)
    if platform.pad0 == 0 {
        platform.pad0 = sdl.SDL_GameControllerOpen(0);
        if platform.pad0 != 0 && platform.pad1 != 0 && padId(platform.pad0) == padId(platform.pad1) {
            sdl.SDL_GameControllerClose(platform.pad0);
            platform.pad0 = 0;
        }
    }
    if platform.pad1 == 0 {
        platform.pad1 = sdl.SDL_GameControllerOpen(1);
        if platform.pad1 != 0 && platform.pad0 != 0 && padId(platform.pad1) == padId(platform.pad0) {
            sdl.SDL_GameControllerClose(platform.pad1);
            platform.pad1 = 0;
        }
    }
}

/// SDL instance id of an open controller (stable for one physical pad while it is plugged in).
fn padId(pad: ptr): i32 {
    return sdl.SDL_JoystickInstanceID(sdl.SDL_GameControllerGetJoystick(pad));
}
