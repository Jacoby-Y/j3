/// `# j3tile 1` / w h tw / grid / marks. Markers are ints or player/enemy/key/stair.

module j3.game.tile;

use j3.memory.Arena;
use j3.text.Text;

/// Marker tag for the player spawn.
pub const MARK_PLAYER: int = 1;
/// Marker tag for an enemy spawn.
pub const MARK_ENEMY: int = 2;
/// Marker tag for a key pickup.
pub const MARK_KEY: int = 3;
/// Marker tag for a stair / exit.
pub const MARK_STAIR: int = 4;

/// 2D tile grid with cell ids and tile pixel width.
pub struct Layer {
    /// Row-major cell ids (`y * w + x`).
    cells: []u8;
    /// Grid width in tiles.
    w: int;
    /// Grid height in tiles.
    h: int;
    /// Tile size in pixels (for rendering).
    tw: int;

    /// Allocates a `w×h` layer filled with wall id `1`.
    fn new(arena: &Arena, w: int, h: int, tw: int): Layer {
        let cells = arena.alloc::<u8>(w * h);
        let i = 0;
        while i < cells.len {
            cells[i] = 1;
            i += 1;
        }
        return Layer { cells: cells, w: w, h: h, tw: tw };
    }

    /// Cell at `(x,y)`, or `1` (wall) when out of bounds.
    fn get(this: &Layer, x: int, y: int): u8 {
        if x < 0 || y < 0 || x >= this.w || y >= this.h {
            return 1;
        }
        return this.cells[y * this.w + x];
    }

    /// Sets the cell at `(x,y)` when in bounds.
    fn set(this: &Layer, x: int, y: int, t: u8) {
        if x < 0 || y < 0 || x >= this.w || y >= this.h {
            return;
        }
        this.cells[y * this.w + x] = t;
    }
}

/// Named spawn / object marker on the map.
pub struct Mark {
    /// Kind (`MARK_*` or a raw int from the file).
    tag: int;
    /// Tile X of the marker.
    x: int;
    /// Tile Y of the marker.
    y: int;
}

/// Parsed tile map: grid layer plus marker list.
pub struct TileMap {
    /// Walkable / wall tile grid.
    layer: Layer;
    /// Marker storage (capacity may exceed `n_mark`).
    marks: []Mark;
    /// Number of valid markers in `marks`.
    n_mark: int;
}

/// Read cursor over a tile text file.
struct Cursor {
    /// Source bytes being scanned.
    src: []u8;
    /// Current read index into `src`.
    i: int;
}

/// Advances past the remainder of the current line, including the newline.
fn skipLine(c: &Cursor) {
    while c.i < c.src.len && c.src[c.i] != 10 {
        c.i = c.i + 1;
    }
    if c.i < c.src.len {
        c.i = c.i + 1;
    }
}

/// Skips whitespace and `#` comment lines.
fn skip(c: &Cursor) {
    while c.i < c.src.len {
        let b = c.src[c.i];
        if b == 32 || b == 9 || b == 13 || b == 10 {
            c.i = c.i + 1;
        } else if b == 35 {
            skipLine(c);
        } else {
            break;
        }
    }
}

/// Parses the next non-negative decimal integer, or `0` if none.
fn takeInt(c: &Cursor): int {
    skip(c);
    let n = 0;
    let any = false;
    while c.i < c.src.len {
        let b = c.src[c.i];
        if b < 48 || b > 57 {
            break;
        }
        n = n * 10 + int(b) - 48;
        c.i = c.i + 1;
        any = true;
    }
    if !any {
        return 0;
    }
    return n;
}

/// Copies the next whitespace-delimited word into a new arena slice.
fn takeWord(c: &Cursor, arena: &Arena): []u8 {
    skip(c);
    let start = c.i;
    while c.i < c.src.len {
        let b = c.src[c.i];
        if b == 32 || b == 9 || b == 10 || b == 13 {
            break;
        }
        c.i = c.i + 1;
    }
    let n = c.i - start;
    let out = arena.alloc::<u8>(n);
    let k = 0;
    while k < n {
        out[k] = c.src[start + k];
        k += 1;
    }
    return out;
}

/// Parses a mark as `tag x y` where tag is an int or player/enemy/key/stair word.
fn parseMark(c: &Cursor, arena: &Arena): Mark {
    skip(c);
    if c.i >= c.src.len {
        return Mark { tag: 0, x: 0, y: 0 };
    }
    let b = c.src[c.i];
    let tag = 0;
    if b >= 48 && b <= 57 {
        tag = takeInt(c);
    } else {
        let w = takeWord(c, arena);
        if w.len > 0 {
            if w[0] == 112 {
                tag = MARK_PLAYER;
            }
            if w[0] == 101 {
                tag = MARK_ENEMY;
            }
            if w[0] == 107 {
                tag = MARK_KEY;
            }
            if w[0] == 115 {
                tag = MARK_STAIR;
            }
        }
    }
    return Mark { tag: tag, x: takeInt(c), y: takeInt(c) };
}

/// Clamps a parsed cell int to `u8` ids 0–4 (else 0).
fn byteOf(n: int): u8 {
    if n == 1 {
        return 1;
    }
    if n == 2 {
        return 2;
    }
    if n == 3 {
        return 3;
    }
    if n == 4 {
        return 4;
    }
    return 0;
}

/// Parses `# j3tile` text into a layer and up to 32 marks.
pub fn parse(arena: &Arena, src: []u8): TileMap {
    let c = Cursor { src: src, i: 0 };
    let w = takeInt(&c);
    let h = takeInt(&c);
    let tw = takeInt(&c);
    if w < 1 {
        w = 1;
    }
    if h < 1 {
        h = 1;
    }
    if tw < 1 {
        tw = 16;
    }
    let layer = Layer.new(arena, w, h, tw);
    let y = 0;
    while y < h {
        let x = 0;
        while x < w {
            layer.set(x, y, byteOf(takeInt(&c)));
            x += 1;
        }
        y += 1;
    }
    let marks = arena.alloc::<Mark>(32);
    let n = 0;
    skip(&c);
    while c.i < c.src.len && n < marks.len {
        marks[n] = parseMark(&c, arena);
        if marks[n].tag != 0 {
            n += 1;
        }
        skip(&c);
    }
    return TileMap { layer: layer, marks: marks, n_mark: n };
}

/// Serializes a map to `# j3tile 1` text with a `# marks` section.
pub fn emit(arena: &Arena, map: &TileMap): []u8 {
    let t = Text.new(arena);
    t.pushStr("# j3tile 1\n");
    t.pushInt(map.layer.w);
    t.push(32);
    t.pushInt(map.layer.h);
    t.push(32);
    t.pushInt(map.layer.tw);
    t.push(10);
    let y = 0;
    while y < map.layer.h {
        let x = 0;
        while x < map.layer.w {
            if x > 0 {
                t.push(32);
            }
            t.pushInt(int(map.layer.get(x, y)));
            x += 1;
        }
        t.push(10);
        y += 1;
    }
    t.pushStr("# marks\n");
    let i = 0;
    while i < map.n_mark {
        let m = map.marks[i];
        t.pushInt(m.tag);
        t.push(32);
        t.pushInt(m.x);
        t.push(32);
        t.pushInt(m.y);
        t.push(10);
        i += 1;
    }
    return t.bytes;
}
