// Part of j3.game (backdrop blur, clip, shapes, masks, affine, views, blits); the module doc and `use`s are in ../game.j3.
module j3.game;

#[singleton]
let P2_BACKDROP_BASE: u32;
/// Complete destination behind the current isolated group, supplied by the post pipeline.
pub fn p2BackdropBase(): u32 { p2BackdropResolve(); return P2_BACKDROP_BASE; }
pub fn p2SetBackdropBase(tex: u32) { p2Flush(); P2_BACKDROP_BASE = tex; P2_BACKDROP_LAZY = false; }
/// The base exists but is not copied yet: `hook` copies it (and calls `p2SetBackdropBase`) the first time
/// something reads it. A group whose content never reads its backdrop never copies it.
#[singleton]
let P2_BACKDROP_LAZY: bool;
#[singleton]
let P2_BACKDROP_HOOK: ptr;
pub fn p2SetBackdropLazy(hook: fn()) { p2Flush(); P2_BACKDROP_BASE = 0; P2_BACKDROP_LAZY = true; P2_BACKDROP_HOOK = hook as ptr; }
pub fn p2BackdropLazy(): bool { return P2_BACKDROP_LAZY; }
fn p2BackdropResolve() {
    if P2_BACKDROP_LAZY {
        let f = P2_BACKDROP_HOOK as fn();
        f();
    }
}

/// Private reusable post targets. Never sample the target currently being drawn into.
struct Backdrop {
    ready: bool;
    prog: u32;
    vao: u32;
    tex: [2]u32;
    fbo: [2]u32;
    w: i32;
    h: i32;
    step: i32;
    sigma: i32;
    bindFb: ptr;
    getInt: ptr;
    isEnabled: ptr;
    draw: ptr;
    copy: ptr;
    blendSeparate: ptr;
    colorMask: ptr;
}

#[singleton]
let BACKDROP: Backdrop;

const BLUR_VS: string = "#version 330 core\nout vec2 vUv;\nvoid main(){ vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2); vUv = p; gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); }";
// Four samples per sigma for large radii, discrete texel taps for small radii. The kernel
// includes at least three sigma and is renormalized, including its truncated tails.
const BLUR_FS: string = "#version 330 core\nin vec2 vUv;\nuniform sampler2D uTex;\nuniform vec2 uStep;\nuniform vec3 uSigma;\nuniform sampler2D uBaseTex;\nuniform int uHasBase;\nout vec4 oColor;\nvoid main(){ vec4 c = vec4(0.0); float total = 0.0; for(int i=-12;i<=12;i++){ float d = float(i) * uSigma.y; float w = exp(-0.5*d*d/(uSigma.x*uSigma.x)); vec2 uv = vUv + float(i)*uStep; vec4 t = textureLod(uTex, uv, uSigma.z); if (uHasBase != 0) t += textureLod(uBaseTex, uv, uSigma.z) * (1.0 - t.a); c += t * w; total += w; } oColor = c / total; }";

fn backdropInit() {
    if BACKDROP.ready { return; }
    BACKDROP.bindFb = hudProc("glBindFramebuffer");
    BACKDROP.getInt = hudProc("glGetIntegerv");
    BACKDROP.isEnabled = hudProc("glIsEnabled");
    BACKDROP.draw = hudProc("glDrawArrays");
    BACKDROP.copy = hudProc("glCopyTexSubImage2D");
    BACKDROP.blendSeparate = hudProc("glBlendFuncSeparate");
    BACKDROP.colorMask = hudProc("glColorMask");
    let create = hudProc("glCreateShader");
    let source = hudProc("glShaderSource");
    let compile = hudProc("glCompileShader");
    let status = hudProc("glGetShaderiv");
    let log = hudProc("glGetShaderInfoLog");
    let vs = hudShader(GL_VERTEX_SHADER, BLUR_VS, create, source, compile, status, log);
    let fs = hudShader(GL_FRAGMENT_SHADER, BLUR_FS, create, source, compile, status, log);
    let mk = hudProc("glCreateProgram") as fn(): u32;
    BACKDROP.prog = mk();
    let attach = hudProc("glAttachShader") as fn(u32, u32);
    attach(BACKDROP.prog, vs);
    attach(BACKDROP.prog, fs);
    let link = hudProc("glLinkProgram") as fn(u32);
    link(BACKDROP.prog);
    let ok: i32 = 0;
    let get = hudProc("glGetProgramiv") as fn(u32, u32, ptr);
    get(BACKDROP.prog, GL_LINK_STATUS, &ok as ptr);
    if ok == 0 { panic("backdrop blur program"); }
    let del = hudProc("glDeleteShader") as fn(u32);
    del(vs); del(fs);
    let loc = hudProc("glGetUniformLocation") as fn(u32, cstr): i32;
    BACKDROP.step = loc(BACKDROP.prog, cstr("uStep"));
    BACKDROP.sigma = loc(BACKDROP.prog, cstr("uSigma"));
    let gen = hudProc("glGenVertexArrays") as fn(i32, ptr);
    gen(1, &BACKDROP.vao as ptr);
    let genFb = hudProc("glGenFramebuffers") as fn(i32, ptr);
    genFb(2, &BACKDROP.fbo[0] as ptr);
    let genTex = HUD.genTextures as fn(i32, ptr);
    genTex(2, &BACKDROP.tex[0] as ptr);
    BACKDROP.ready = true;
    addGlShutdown(backdropDestroy);
}

fn backdropDestroy() {
    if !BACKDROP.ready { return; }
    let delTex = HUD.deleteTextures as fn(i32, ptr);
    delTex(2, &BACKDROP.tex[0] as ptr);
    let delFb = hudProc("glDeleteFramebuffers") as fn(i32, ptr);
    delFb(2, &BACKDROP.fbo[0] as ptr);
    let delVa = hudProc("glDeleteVertexArrays") as fn(i32, ptr);
    delVa(1, &BACKDROP.vao as ptr);
    let delProg = hudProc("glDeleteProgram") as fn(u32);
    delProg(BACKDROP.prog);
    BACKDROP.ready = false;
    BACKDROP.w = 0;
    BACKDROP.h = 0;
}

fn backdropSize(w: i32, h: i32) {
    if BACKDROP.w == w && BACKDROP.h == h { return; }
    let bindTex = HUD.bindTexture as fn(u32, u32);
    let image = HUD.texImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    let param = HUD.texParameteri as fn(u32, u32, i32);
    let bindFb = BACKDROP.bindFb as fn(u32, u32);
    let attach = hudProc("glFramebufferTexture2D") as fn(u32, u32, u32, u32, i32);
    let status = hudProc("glCheckFramebufferStatus") as fn(u32): u32;
    for i in 0..2 {
        bindTex(GL_TEXTURE_2D, BACKDROP.tex[i]);
        image(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0 as ptr);
        param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        param(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
        bindFb(0x8CA9, BACKDROP.fbo[i]); // GL_DRAW_FRAMEBUFFER
        attach(0x8CA9, 0x8CE0, GL_TEXTURE_2D, BACKDROP.tex[i], 0);
        if status(0x8CA9) != 0x8CD5 { panic("backdrop blur framebuffer"); }
    }
    BACKDROP.w = w;
    BACKDROP.h = h;
}

fn backdropInt(key: u32): i32 {
    let get = BACKDROP.getInt as fn(u32, ptr);
    let v: i32 = 0;
    get(key, &v as ptr);
    return v;
}

fn backdropEnable(key: u32, enabled: bool) {
    if enabled {
        let en = HUD.enable as fn(u32); en(key);
    } else {
        let dis = HUD.disable as fn(u32); dis(key);
    }
}

/// Blur the current framebuffer behind one rounded paint primitive. `radius` is sigma in
/// view-local px (paint clamps its public input to 64). Requires a single-sample color buffer
/// at window size. Two full-window RGBA8 targets are reused, resized, and released with GL.
/// Existing batches go out first; subsequent paint retains its clip, mask, view and affine map.
pub fn p2BackdropBlur(x: f32, y: f32, w: f32, h: f32, tl: f32, tr: f32, br: f32, bl: f32, radius: f32, alpha: f32) {
    if radius <= 0 || w <= 0 || h <= 0 || alpha <= 0 { return; }
    if !platform.gl { panic("j3.gfx.paint needs GL: call app.useGl() and link \"GL\""); }
    hudInit();
    p2BackdropResolve();
    let zone = profUiZone(ZONE_UI_BLUR);
    profUiCount(PROF_BLURS);
    backdropInit();
    let fbg = p2FbRect();
    let width = i32(fbg.w);
    let height = i32(fbg.h);
    if width <= 0 || height <= 0 { profUiZone(zone); return; }
    // Snapshot state after the preceding paint flush, whose normal GL contract is unchanged.
    let get = BACKDROP.getInt as fn(u32, ptr);
    let enabled = BACKDROP.isEnabled as fn(u32): u8;
    let viewport: [4]i32 = [0, 0, 0, 0]; get(0x0BA2, &viewport[0] as ptr);
    let scissor: [4]i32 = [0, 0, 0, 0]; get(0x0C10, &scissor[0] as ptr);
    let color: [4]i32 = [0, 0, 0, 0]; get(0x0C23, &color[0] as ptr);
    let program = backdropInt(0x8B8D);
    let vao = backdropInt(0x85B5);
    let buffer = backdropInt(0x8894);
    let drawFb = backdropInt(0x8CA6);
    let readFb = backdropInt(0x8CAA);
    let drawBuffer = backdropInt(0x8825);
    let activeUnit = backdropInt(0x84E0);
    let srcRgb = backdropInt(0x80C9);
    let dstRgb = backdropInt(0x80C8);
    let srcAlpha = backdropInt(0x80CB);
    let dstAlpha = backdropInt(0x80CA);
    let depthOn = enabled(GL_DEPTH_TEST) != 0;
    let cullOn = enabled(GL_CULL_FACE) != 0;
    let blendOn = enabled(GL_BLEND) != 0;
    let scissorOn = enabled(GL_SCISSOR_TEST) != 0;
    let stencilOn = enabled(0x0B90) != 0;
    let srgbOn = enabled(0x8DB9) != 0;
    let active = HUD.activeTexture as fn(u32);
    let bindTex = HUD.bindTexture as fn(u32, u32);
    let textures: [4]i32 = [0, 0, 0, 0];
    for i in 0..4 { active(0x84C0 + u32(i)); textures[i] = backdropInt(0x8069); }
    active(0x84C0);
    backdropSize(width, height);
    let bindFb = BACKDROP.bindFb as fn(u32, u32);
    bindFb(0x8CA8, u32(drawFb)); // GL_READ_FRAMEBUFFER
    let oldReadBuffer = backdropInt(0x0C02);
    let readBuffer = hudProc("glReadBuffer") as fn(u32);
    readBuffer(u32(drawBuffer));
    bindTex(GL_TEXTURE_2D, BACKDROP.tex[0]);
    let copy = BACKDROP.copy as fn(u32, i32, i32, i32, i32, i32, i32, i32);
    copy(GL_TEXTURE_2D, 0, 0, 0, i32(fbg.x), i32(fbg.y), width, height);
    readBuffer(u32(oldReadBuffer));
    // Prefilter large tap spacings, preventing regularly spaced detail from aliasing through
    // the 25-tap kernel. The first pass samples a mip whose texels span at least one tap.
    let fr = fbRect(); let sigma = radius * platform.ui_scale * fr.s;
    if P2.rotOn {
        let sx = sqrt(P2.ra * P2.ra + P2.rb * P2.rb);
        let sy = sqrt(P2.rc * P2.rc + P2.rd * P2.rd);
        if sy > sx { sx = sy; }
        sigma *= sx;
    }
    if sigma < 0.125 { sigma = 0.125; }
    let stride = sigma / 4.0;
    if stride < 1 { stride = 1; }
    let lod: f32 = 0;
    let span: f32 = 1;
    while span < stride { span *= 2; lod += 1; }
    let param = HUD.texParameteri as fn(u32, u32, i32);
    if lod > 0 {
        let mip = hudProc("glGenerateMipmap") as fn(u32);
        mip(GL_TEXTURE_2D);
        param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, 0x2703); // GL_LINEAR_MIPMAP_LINEAR
    } else {
        param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    }
    let dis = HUD.disable as fn(u32);
    dis(GL_SCISSOR_TEST); dis(GL_DEPTH_TEST); dis(GL_CULL_FACE); dis(GL_BLEND); dis(0x0B90); dis(0x8DB9);
    let mask = BACKDROP.colorMask as fn(u8, u8, u8, u8);
    mask(1, 1, 1, 1);
    let vp = HUD.viewport as fn(i32, i32, i32, i32);
    vp(0, 0, width, height);
    let useProg = HUD.useProgram as fn(u32);
    useProg(BACKDROP.prog);
    let bindVa = HUD.bindVertexArray as fn(u32);
    bindVa(BACKDROP.vao);
    let u2 = HUD.uniform2f as fn(i32, f32, f32);
    let u3 = HUD.uniform3f as fn(i32, f32, f32, f32);
    u3(BACKDROP.sigma, sigma, stride, lod);
    let loc = hudProc("glGetUniformLocation") as fn(u32, cstr): i32;
    let u1 = HUD.uniform1i as fn(i32, i32);
    u1(loc(BACKDROP.prog, cstr("uBaseTex")), 3);
    u1(loc(BACKDROP.prog, cstr("uHasBase")), if P2_BACKDROP_BASE != 0 { 1 } else { 0 });
    if P2_BACKDROP_BASE != 0 {
        active(0x84C3); bindTex(GL_TEXTURE_2D, P2_BACKDROP_BASE);
        if lod > 0 { let bmip = hudProc("glGenerateMipmap") as fn(u32); bmip(GL_TEXTURE_2D); param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, 0x2703); }
        active(0x84C0);
    }
    let draw = BACKDROP.draw as fn(u32, i32, i32);
    // Capture -> horizontal target -> vertical target; both source/destination pairs differ.
    bindFb(0x8CA9, BACKDROP.fbo[1]);
    u2(BACKDROP.step, stride / f32(width), 0);
    profDraw(1);
    draw(0x0004, 0, 3); // GL_TRIANGLES
    bindTex(GL_TEXTURE_2D, BACKDROP.tex[1]);
    u3(BACKDROP.sigma, sigma, stride, 0);
    u1(loc(BACKDROP.prog, cstr("uHasBase")), 0);
    bindFb(0x8CA9, BACKDROP.fbo[0]);
    u2(BACKDROP.step, 0, stride / f32(height));
    profDraw(1);
    draw(0x0004, 0, 3);
    bindFb(0x8CA9, u32(drawFb));
    bindFb(0x8CA8, u32(readFb));
    backdropEnable(0x8DB9, srgbOn);
    // Composite through the painter so rounded coverage, rotation, shapes and masks agree.
    let c = Color { r: 255, g: 255, b: 255, a: u8(clamp(alpha, 0, 1) * 255.0 + 0.5) };
    p2Push(10, x, y, w, h, 0, 0, 0, 0, c, c, tl, tr, br, bl, 0, BACKDROP.tex[0]);
    p2Flush(); // Consume the reusable texture before another panel can overwrite it.
    // Restore every GL binding/enable/value touched by the passes and composite.
    useProg(u32(program)); bindVa(u32(vao));
    let bindBuf = HUD.bindBuffer as fn(u32, u32); bindBuf(GL_ARRAY_BUFFER, u32(buffer));
    for i in 0..4 { active(0x84C0 + u32(i)); bindTex(GL_TEXTURE_2D, u32(textures[i])); }
    active(u32(activeUnit));
    let blend = BACKDROP.blendSeparate as fn(u32, u32, u32, u32);
    blend(u32(srcRgb), u32(dstRgb), u32(srcAlpha), u32(dstAlpha));
    vp(viewport[0], viewport[1], viewport[2], viewport[3]);
    let sc = HUD.scissor as fn(i32, i32, i32, i32); sc(scissor[0], scissor[1], scissor[2], scissor[3]);
    mask(u8(color[0]), u8(color[1]), u8(color[2]), u8(color[3]));
    backdropEnable(GL_DEPTH_TEST, depthOn); backdropEnable(GL_CULL_FACE, cullOn);
    backdropEnable(GL_BLEND, blendOn); backdropEnable(GL_SCISSOR_TEST, scissorOn);
    backdropEnable(0x0B90, stencilOn);
    profUiZone(zone);
}

/// Clip later 2D draws to a rect in view-local logical pixels (axis-aligned; `on = false`
/// removes it). Queued draws go out first. `j3.gfx.paint.pushClip` manages the nesting.
pub fn p2Clip(on: bool, x0: f32, y0: f32, x1: f32, y1: f32) {
    if on == P2.clipOn && (!on || (x0 == P2.cx0 && y0 == P2.cy0 && x1 == P2.cx1 && y1 == P2.cy1)) {
        return;
    }
    p2Flush();
    P2.clipOn = on;
    P2.cx0 = x0;
    P2.cy0 = y0;
    P2.cx1 = x1;
    P2.cy1 = y1;
}

/// Clip later 2D draws to an outline (slot 0 or 1; `n = 0` removes it): `pts` is `n` x, y float pairs in
/// view-local logical pixels (the space of `p2Push`, before `p2Affine`), at most `path.MAXPT` points; a point with
/// x below -1e8 separates contours. Coverage is antialiased in the shader; `evenOdd` picks the fill rule.
/// The caller keeps `pts` alive while the shape is set. Queued draws go out first.
/// `j3.gfx.paint.pushShape` manages the nesting.
pub fn p2Shape(slot: int, pts: ptr, n: int, evenOdd: bool) {
    p2Flush();
    let r: f32 = 0.0;
    if evenOdd {
        r = 1.0;
    }
    if n > MAXPT {
        n = MAXPT;
    }
    if slot == 0 {
        P2.sh0 = pts;
        P2.sn0 = n;
        P2.sr0 = r;
    } else {
        P2.sh1 = pts;
        P2.sn1 = n;
        P2.sr1 = r;
    }
}

/// Clip later 2D draws to the intersection of up to four convex outlines (`n` of them, 0 removes): `pts` holds
/// `n` rows of 128 floats (x, y pairs, at most 64 points each, closed), `c0..c3` the point counts, all in the
/// frame `p2Affine` turns (like `p2Shape`). Coverage is antialiased in the shader. The caller keeps `pts` alive.
/// Queued draws go out first. `j3.gfx.paint.pushClip` manages these under rotation and skew.
pub fn p2ClipShapes(n: int, pts: ptr, c0: int, c1: int, c2: int, c3: int) {
    p2Flush();
    P2.ckn = n;
    P2.ckp = pts;
    P2.ck0 = c0;
    P2.ck1 = c1;
    P2.ck2 = c2;
    P2.ck3 = c3;
}

/// Multiply the alpha of later 2D draws by a gradient ramp row (see `paint.gradient`) laid over the box
/// `x y w h` (view-local logical pixels): `kind` 1 linear at `angle` radians (CSS: 0 is up), 2 radial
/// from the center; 0 removes it. Queued draws go out first. `j3.gfx.paint.pushMask` manages the nesting.
pub fn p2Mask(kind: int, row: int, angle: f32, x: f32, y: f32, w: f32, h: f32) {
    p2Flush();
    P2.mk = kind;
    P2.mrow = f32(row);
    P2.mang = angle;
    P2.mx = x;
    P2.my = y;
    P2.mw = w;
    P2.mh = h;
}

/// Turn later draws by an affine map of view-local logical pixels (`x' = a x + c y + tx`,
/// `y' = b x + d y + ty`; `on = false` removes it). Shapes are drawn in their own frame and only
/// their corners move, so edges stay antialiased; the clip rect and scissor are not rotated.
/// Queued draws go out first. `j3.gfx.paint.pushRotate` manages the nesting.
pub fn p2Affine(on: bool, a: f32, b: f32, c: f32, d: f32, tx: f32, ty: f32) {
    if !on && !P2.rotOn {
        return;
    }
    if on && P2.rotOn && P2.ra == a && P2.rb == b && P2.rc == c && P2.rd == d && P2.rx == tx && P2.ry == ty {
        return;
    }
    p2Flush();
    P2.rotOn = on;
    P2.ra = a;
    P2.rb = b;
    P2.rc = c;
    P2.rd = d;
    P2.rx = tx;
    P2.ry = ty;
}

/// Draw later 2D into a sub-rectangle of the window: `(0, 0)` becomes `pos` (relative to the
/// current view) and the width and height are `size`, in logical pixels. Nests; flushes.
pub fn p2PushView(pos: Vec2, size: Vec2) {
    hudInit();
    p2Flush();
    if P2.depth >= 8 {
        panic("p2PushView: nested too deep");
    }
    let o = P2.depth * 4;
    P2_VIEWS[o] = P2.vx;
    P2_VIEWS[o + 1] = P2.vy;
    P2_VIEWS[o + 2] = P2.vw;
    P2_VIEWS[o + 3] = P2.vh;
    if P2.depth == 0 {
        P2.vx = 0;
        P2.vy = 0;
    }
    P2.vx = P2.vx + pos.x;
    P2.vy = P2.vy + pos.y;
    P2.vw = size.x;
    P2.vh = size.y;
    P2.depth += 1;
}

/// Undo the last `p2PushView`. Flushes.
pub fn p2PopView() {
    p2Flush();
    if P2.depth == 0 {
        return;
    }
    P2.depth -= 1;
    let o = P2.depth * 4;
    P2.vx = P2_VIEWS[o];
    P2.vy = P2_VIEWS[o + 1];
    P2.vw = P2_VIEWS[o + 2];
    P2.vh = P2_VIEWS[o + 3];
}

/// Queue one textured quad (the path of `drawTexture*` and `drawText`).
fn hudDraw(pos: Vec2, size: Vec2, color: Color, tex: u32, uv: Vec2, uvSize: Vec2) {
    if tex == 0 {
        return;
    }
    hudInit();
    p2Push(P2_TEX, pos.x, pos.y, size.x, size.y, uv.x, uv.y, uvSize.x, uvSize.y, color, color, TG.x0, TG.y0, TG.x1, TG.y1, TG.row, tex);
}

/// Draw a GL texture into a screen rect, sampling `src` in pixels, tinted by `color`.
fn hudBlitTint(tex: Texture, dest: Vec2, destSize: Vec2, src: Vec2, srcSize: Vec2, color: Color) {
    if tex.raw == 0 || tex.w < 1 || tex.h < 1 {
        return;
    }
    let id = u32(tex.raw as int);
    let u = src.x / f32(tex.w);
    let v = src.y / f32(tex.h);
    let uw = srcSize.x / f32(tex.w);
    let vh = srcSize.y / f32(tex.h);
    hudDraw(dest, destSize, color, id, Vec2 { x: u, y: v }, Vec2 { x: uw, y: vh });
}

/// Draw a GL texture into a screen rect, sampling `src` in pixels.
fn hudBlit(tex: Texture, dest: Vec2, destSize: Vec2, src: Vec2, srcSize: Vec2) {
    hudBlitTint(tex, dest, destSize, src, srcSize, rgb(255, 255, 255));
}

/// Draw one white atlas glyph tinted with the current color.
fn drawGlyph(tex: Texture, pos: Vec2) {
    if tex.raw == 0 || tex.w < 1 || tex.h < 1 {
        return;
    }
    let size = Vec2 { x: f32(tex.w), y: f32(tex.h) };
    if platform.gl {
        hudBlitTint(tex, pos, size, Vec2 { x: 0, y: 0 }, size, platform.color);
        return;
    }
    sdl.SDL_SetTextureColorMod(tex.raw, platform.color.r, platform.color.g, platform.color.b);
    drawTexture(tex, pos);
}
