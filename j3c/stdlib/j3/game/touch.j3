// Part of j3.game (touch fingers, app lifecycle, the Android Back key); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Events from SDL_events.h (2.32).
const SDL_APP_TERMINATING: u32 = 0x101;
const SDL_APP_LOWMEMORY: u32 = 0x102;
const SDL_APP_WILLENTERBACKGROUND: u32 = 0x103;
const SDL_APP_DIDENTERBACKGROUND: u32 = 0x104;
const SDL_APP_WILLENTERFOREGROUND: u32 = 0x105;
const SDL_APP_DIDENTERFOREGROUND: u32 = 0x106;
const SDL_KEYDOWN: u32 = 0x300;
const SDL_KEYUP: u32 = 0x301;
const SDL_FINGERDOWN: u32 = 0x700;
const SDL_FINGERUP: u32 = 0x701;
const SDL_FINGERMOTION: u32 = 0x702;
/// SDL_SCANCODE_AC_BACK (SDL_scancode.h): the Android Back button.
const SDL_SCANCODE_AC_BACK: i32 = 270;

/// `SDL_TouchFingerEvent` view of an `SDL_Event` blob (SDL_events.h): `touchId` and `fingerId` are 64-bit,
/// so `x` sits at offset 24; `x`/`y` are normalized to the window.
struct SDL_FingerEvent {
    ty: u32;
    timestamp: u32;
    touchId: int;
    fingerId: int;
    x: f32;
    y: f32;
    dx: f32;
    dy: f32;
    pressure: f32;
    windowID: u32;
}

/// `SDL_KeyboardEvent` view: `keysym` starts at offset 16 with the scancode.
struct SDL_KeyEvent {
    ty: u32;
    timestamp: u32;
    windowID: u32;
    state: u8;
    repeat: u8;
    pad2: u8;
    pad3: u8;
    scancode: i32;
    sym: i32;
}

/// One finger on the touch screen, as `game.finger(i)` reports it.
pub struct Finger {
    /// SDL's finger id; stable from down to up, reused later.
    id: int;
    /// Position in the pixels of `mousePos` (virtual pixels under `setVirtualSize`).
    x: f32;
    /// See `x`.
    y: f32;
    /// True for exactly one frame, the one the finger touched down on.
    down: bool;
    /// True while the finger is on the screen (including the down frame, not the up frame).
    held: bool;
    /// True for exactly one frame, the one the finger lifted on; it is gone after that.
    up: bool;
}

const MAX_FINGERS: int = 10;

#[singleton]
let fingerId: [10]int;
/// Normalized window position, 0..1.
#[singleton]
let fingerX: [10]f32;
#[singleton]
let fingerY: [10]f32;
/// 0 free, 1 on the screen.
#[singleton]
let fingerOn: [10]u8;
#[singleton]
let fingerDown: [10]u8;
#[singleton]
let fingerUp: [10]u8;

/// Test seam: accept the Back scancode off Android (see `backKeyAnywhere`).
#[singleton]
let BACK_ANYWHERE: bool = false;

/// Set between `SDL_APP_*ENTER*` events; `App.run` skips update, draw and swap meanwhile.
#[singleton]
let BACKGROUNDED: bool = false;

/// Start of a frame: fingers that went up last frame are removed, new ones become plain held.
fn touchFrame() {
    let i = 0;
    while i < MAX_FINGERS {
        if fingerUp[i] != 0 { fingerOn[i] = 0; fingerUp[i] = 0; }
        fingerDown[i] = 0;
        i += 1;
    }
}

/// Slot of finger `id`, or -1.
fn fingerSlot(id: int): int {
    let i = 0;
    while i < MAX_FINGERS {
        // a lifted slot stays until next frame; a new touch with the same id must not reuse it
        if fingerOn[i] != 0 && fingerUp[i] == 0 && fingerId[i] == id { return i; }
        i += 1;
    }
    return -1;
}

/// Finger, lifecycle and Back events; called for every event by `handleEvent`.
fn touchEvent(ev: &SDL_Event) {
    let t = ev.ty;
    if t == SDL_FINGERDOWN || t == SDL_FINGERMOTION || t == SDL_FINGERUP {
        let f = ev as ptr as &SDL_FingerEvent;
        let s = fingerSlot(f.fingerId);
        if s < 0 && t == SDL_FINGERDOWN {
            // a free slot; an eleventh finger is dropped
            let i = 0;
            while i < MAX_FINGERS && s < 0 {
                if fingerOn[i] == 0 { s = i; }
                i += 1;
            }
            if s >= 0 { fingerOn[s] = 1; fingerId[s] = f.fingerId; fingerDown[s] = 1; fingerUp[s] = 0; }
        }
        if s < 0 { return; }
        fingerX[s] = f.x;
        fingerY[s] = f.y;
        if t == SDL_FINGERUP { fingerUp[s] = 1; }
    }
    if t == SDL_APP_WILLENTERBACKGROUND || t == SDL_APP_DIDENTERBACKGROUND { BACKGROUNDED = true; }
    if t == SDL_APP_WILLENTERFOREGROUND || t == SDL_APP_DIDENTERFOREGROUND { BACKGROUNDED = false; }
    if t == SDL_APP_TERMINATING { platform.quit = true; }
    if t == SDL_APP_LOWMEMORY { logLine("j3: low memory warning from the OS"); }
    if t == SDL_KEYDOWN {
        let k = ev as ptr as &SDL_KeyEvent;
        if k.scancode == SDL_SCANCODE_AC_BACK && k.repeat == 0 && (PLATFORM == 3 || BACK_ANYWHERE) { closeRequest(); }
    }
}

/// Fingers on the screen this frame (up to 10), including ones that lifted this frame.
pub fn fingerCount(): int {
    let n = 0;
    let i = 0;
    while i < MAX_FINGERS {
        if fingerOn[i] != 0 { n += 1; }
        i += 1;
    }
    return n;
}

/// The `i`th finger, `0 <= i < fingerCount()`, oldest slot first. Out of range gives `id` -1 and nothing set.
pub fn finger(i: int): Finger {
    let n = 0;
    let s = 0;
    while s < MAX_FINGERS {
        if fingerOn[s] != 0 {
            if n == i {
                let p = physToUi(fingerX[s] * f32(platform.win_w), fingerY[s] * f32(platform.win_h));
                return Finger { id: fingerId[s], x: p.x, y: p.y, down: fingerDown[s] != 0, held: fingerUp[s] == 0, up: fingerUp[s] != 0 };
            }
            n += 1;
        }
        s += 1;
    }
    return Finger { id: -1, x: 0, y: 0, down: false, held: false, up: false };
}

/// True between the OS sending the app to the background and bringing it back. There is no GL surface then:
/// `App.run` skips update, draw and swap, and a hand-written loop should too (call `waitBackground` instead).
pub fn backgrounded(): bool {
    return BACKGROUNDED;
}

/// Sleep until an event arrives or 100 ms pass, for a loop that is backgrounded. Resets the frame clock so
/// the first frame after resume does not see the time spent away.
pub fn waitBackground() {
    let ev = SDL_Event { ty: 0, timestamp: 0, windowID: 0, win_event: 0, pad1: 0, pad2: 0, pad3: 0, data1: 0, data2: 0, motion_y: 0, xrel: 0, yrel: 0, motion_pad: 0, tail2: 0, tail3: 0 };
    if sdl.SDL_WaitEventTimeout(&ev as ptr, 100) != 0 { handleEvent(&ev); }
    platform.last_ms = sdl.SDL_GetTicks();
}

/// One line to stderr, and to `adb logcat` on Android. `msg` must be a literal (NUL-terminated).
fn logLine(msg: string) {
    write(2, msg.ptr as ptr, msg.len);
    write(2, "\n".ptr as ptr, 1);
    if PLATFORM == 3 { sdl.SDL_Log(cstr("%s"), cstr(msg)); }
}

/// Treat the Back scancode as a close request on every platform. Only Android does by default, since some
/// desktop keyboards and mice send it; this exists so tests can drive the Android path.
pub fn backKeyAnywhere(on: bool) {
    BACK_ANYWHERE = on;
}
