// Part of j3.game (SDL_image / mixer / ttf lazy loading: function-pointer tables, sonames, bind*); the module doc and `use`s are in ../game.j3.
module j3.game;

struct ImageFns {
    init: ptr;
    load: ptr;
    quit: ptr;
}

struct MixerFns {
    open: ptr;
    loadWav: ptr;
    play: ptr;
    halt: ptr;
    freeChunk: ptr;
    loadMus: ptr;
    playMus: ptr;
    haltMus: ptr;
    freeMus: ptr;
    volume: ptr;
    volumeMus: ptr;
    close: ptr;
    alloc: ptr;
    fadeIn: ptr;
    fadeOut: ptr;
    fadeInMus: ptr;
    fadeOutMus: ptr;
    position: ptr;
}

struct FontFns {
    init: ptr;
    open: ptr;
    close: ptr;
    render: ptr;
    size: ptr;
    ascent: ptr;
    height: ptr;
    style: ptr;
    quit: ptr;
    /// Optional (SDL_ttf 2.0.18+ / 2.20+): 0 when the installed library lacks them.
    glyph: ptr;
    hb: ptr;
    dir: ptr;
    script: ptr;
}

#[singleton]
let imageSo: ptr = 0;
#[singleton]
let mixerSo: ptr = 0;
#[singleton]
let fontSo: ptr = 0;
#[singleton]
let imageFns: ImageFns = ImageFns { init: 0, load: 0, quit: 0 };
#[singleton]
let mixerFns: MixerFns = MixerFns {
    open: 0,
    loadWav: 0,
    play: 0,
    halt: 0,
    freeChunk: 0,
    loadMus: 0,
    playMus: 0,
    haltMus: 0,
    freeMus: 0,
    volume: 0,
    volumeMus: 0,
    close: 0,
    alloc: 0,
    fadeIn: 0,
    fadeOut: 0,
    fadeInMus: 0,
    fadeOutMus: 0,
    position: 0,
};
#[singleton]
let fontFns: FontFns = FontFns {
    init: 0,
    open: 0,
    close: 0,
    render: 0,
    size: 0,
    ascent: 0,
    height: 0,
    style: 0,
    quit: 0,
    glyph: 0,
    hb: 0,
    dir: 0,
    script: 0,
};

/// NUL-terminated library and symbol names. Kept apart from `cstr`'s scratch so lazily
/// binding SDL_ttf/image/mixer inside `tryLoad*C` does not clobber the caller's path.
#[singleton]
let soName: [128]u8;

/// Copy `name` into `soName`. Names are short C identifiers and sonames.
fn soCstr(name: string): cstr {
    if name.len + 1 > 128 {
        panic(name);
    }
    let i = 0;
    while i < name.len {
        soName[i] = name[i];
        i += 1;
    }
    soName[name.len] = 0;
    return &soName[0] as cstr;
}

/// Windows name of a `libSDL2_X-2.0.so.0` soname: `SDL2_X.dll` (into `soName`).
fn soWindows(soname: string): cstr {
    let n = 0;
    while 8 + n < soname.len && soname[8 + n] != 45 { n += 1; } // up to the '-'
    let i = 0;
    while i < 5 + n {
        soName[i] = soname[3 + i];
        i += 1;
    }
    let ext = ".dll";
    for k in 0..4 { soName[5 + n + k] = ext[k]; }
    soName[9 + n] = 0;
    return &soName[0] as cstr;
}

/// SDL add-on libraries, the index into `SO_NAMES`.
const SO_IMAGE: int = 0;
const SO_MIXER: int = 1;
const SO_TTF: int = 2;

/// Soname of add-on `kind` on this platform: one row per platform (Linux and the Windows/macOS
/// builds, which fall back to `soWindows`; Android, where the APK ships unversioned `.so` files).
fn soLib(kind: int): string {
    let names: [6]string = [
        "libSDL2_image-2.0.so.0", "libSDL2_mixer-2.0.so.0", "libSDL2_ttf-2.0.so.0",
        "libSDL2_image.so", "libSDL2_mixer.so", "libSDL2_ttf.so",
    ];
    return names[(if PLATFORM == 3 { 3 } else { 0 }) + kind];
}

#[singleton]
let soBesideBuf: [1100]u8;

/// `name` in the executable's folder (add-ons shipped with the game, `[steam] runtime_libs`), tried
/// before the system's. Linux only; 0 when absent.
fn soBeside(name: string): ptr {
    if PLATFORM != 0 {
        return 0;
    }
    let dir = exeDir();
    if dir.len == 0 || dir.len + 1 + name.len + 1 > 1100 {
        return 0;
    }
    let n = 0;
    for i in 0..dir.len { soBesideBuf[n] = dir[i]; n += 1; }
    soBesideBuf[n] = 47;
    n += 1;
    for i in 0..name.len { soBesideBuf[n] = name[i]; n += 1; }
    soBesideBuf[n] = 0;
    return sdl.SDL_LoadObject(&soBesideBuf[0] as cstr);
}

/// Open an SDL add-on library on first use: this platform's soname, else (not Android) the
/// Windows DLL. Image, mixer, and font are opened on first use.
fn soTry(kind: int): ptr {
    let name = soLib(kind);
    let h = soBeside(name);
    if h == 0 {
        h = sdl.SDL_LoadObject(soCstr(name));
    }
    if h == 0 && PLATFORM != 3 {
        h = sdl.SDL_LoadObject(soWindows(name));
    }
    return h;
}

fn soOpen(kind: int): ptr {
    let handle = soTry(kind);
    if handle == 0 {
        panic(soLib(kind));
    }
    return handle;
}

fn soSym(handle: ptr, name: string): ptr {
    let sym = sdl.SDL_LoadFunction(handle, soCstr(name));
    if sym == 0 {
        panic(name);
    }
    return sym;
}

fn imageLib(): ptr {
    if imageSo == 0 {
        imageSo = soOpen(SO_IMAGE);
    }
    return imageSo;
}

fn mixerLib(): ptr {
    if mixerSo == 0 {
        mixerSo = soOpen(SO_MIXER);
    }
    return mixerSo;
}

fn fontLib(): ptr {
    if fontSo == 0 {
        fontSo = soOpen(SO_TTF);
    }
    return fontSo;
}

fn bindImage() {
    if imageFns.load != 0 {
        return;
    }
    let so = imageLib();
    imageFns.init = soSym(so, "IMG_Init");
    imageFns.load = soSym(so, "IMG_Load");
    imageFns.quit = soSym(so, "IMG_Quit");
}

fn bindMixer() {
    if mixerFns.open != 0 {
        return;
    }
    let so = mixerLib();
    mixerFns.open = soSym(so, "Mix_OpenAudio");
    mixerFns.loadWav = soSym(so, "Mix_LoadWAV");
    mixerFns.play = soSym(so, "Mix_PlayChannel");
    mixerFns.halt = soSym(so, "Mix_HaltChannel");
    mixerFns.freeChunk = soSym(so, "Mix_FreeChunk");
    mixerFns.loadMus = soSym(so, "Mix_LoadMUS");
    mixerFns.playMus = soSym(so, "Mix_PlayMusic");
    mixerFns.haltMus = soSym(so, "Mix_HaltMusic");
    mixerFns.freeMus = soSym(so, "Mix_FreeMusic");
    mixerFns.volume = soSym(so, "Mix_Volume");
    mixerFns.volumeMus = soSym(so, "Mix_VolumeMusic");
    mixerFns.close = soSym(so, "Mix_CloseAudio");
    mixerFns.alloc = soSym(so, "Mix_AllocateChannels");
    mixerFns.fadeIn = soSym(so, "Mix_FadeInChannel");
    mixerFns.fadeOut = soSym(so, "Mix_FadeOutChannel");
    mixerFns.fadeInMus = soSym(so, "Mix_FadeInMusic");
    mixerFns.fadeOutMus = soSym(so, "Mix_FadeOutMusic");
    mixerFns.position = soSym(so, "Mix_SetPosition");
}

fn bindFont() {
    if fontFns.open != 0 {
        return;
    }
    let so = fontLib();
    fontFns.init = soSym(so, "TTF_Init");
    fontFns.open = soSym(so, "TTF_OpenFont");
    fontFns.close = soSym(so, "TTF_CloseFont");
    fontFns.render = soSym(so, "TTF_RenderUTF8_Blended");
    fontFns.size = soSym(so, "TTF_SizeUTF8");
    fontFns.ascent = soSym(so, "TTF_FontAscent");
    fontFns.height = soSym(so, "TTF_FontHeight");
    fontFns.style = soSym(so, "TTF_SetFontStyle");
    fontFns.quit = soSym(so, "TTF_Quit");
    fontFns.glyph = sdl.SDL_LoadFunction(so, soCstr("TTF_GlyphIsProvided32"));
    fontFns.hb = sdl.SDL_LoadFunction(so, soCstr("TTF_GetHarfBuzzVersion"));
    fontFns.dir = sdl.SDL_LoadFunction(so, soCstr("TTF_SetFontDirection"));
    fontFns.script = sdl.SDL_LoadFunction(so, soCstr("TTF_SetFontScriptName"));
}
