// Part of j3.game (font fallback chains); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Font fallback. `fontFallback(primary, extra)` appends `extra` to the chain of `primary`: a code point
/// the primary lacks (`TTF_GlyphIsProvided32`) comes from the first chain font that has it, else the primary
/// draws its own missing-glyph box. Runs of one font are measured and drawn separately (`textWidth`, `p2Text`).
/// The chain is per font handle, so give each size its own (the UI does it when it opens a font).
/// No-op when SDL_ttf is older than 2.0.18.
const FB_MAX: int = 4;
const FB_FONTS: int = 32;
const FB_HITS: int = 1024;

struct FbEnt {
    font: ptr;
    n: int;
    alt: [4]ptr;
}

/// One answer of "which chain font draws this code point", direct-mapped so it stays bounded.
struct FbHit {
    /// Chain index + 1 (0 = empty slot).
    ent: int;
    cp: int;
    pick: int;
}

#[singleton]
let FB: [32]FbEnt;
#[singleton]
let FB_N: int;
#[singleton]
let FB_HIT: [1024]FbHit;

/// Add `extra` to the fallback chain of `font` (see above). Duplicates and a full chain are ignored.
pub fn fontFallback(font: Font, extra: Font) {
    if font.raw == 0 || extra.raw == 0 || font.raw == extra.raw || fontFns.glyph == 0 {
        return;
    }
    let ei = fbEnsure(font.raw);
    if ei < 0 {
        return;
    }
    for k in 0..FB[ei].n {
        if FB[ei].alt[k] == extra.raw {
            return;
        }
    }
    if FB[ei].n < FB_MAX {
        FB[ei].alt[FB[ei].n] = extra.raw;
        FB[ei].n += 1;
        // answers cached for the shorter chain are stale
        for h in 0..FB_HITS {
            if FB_HIT[h].ent == ei + 1 {
                FB_HIT[h].ent = 0;
            }
        }
    }
}

/// A fallback font by file: recorded now, opened at `font`'s size on the first code point `font` and the fonts
/// already in its chain lack, then appended like `fontFallback`. A missing file is never used. `destroyFont(font)`
/// closes it. Needs `font` from `loadFont`/`tryLoadFont` (its size is known). At most 16 pending at once.
pub fn fontFallbackPath(font: Font, path: string) {
    if font.raw == 0 || fontFns.glyph == 0 || FB_LAZY_N >= FB_LAZIES || path.len >= 256 {
        return;
    }
    if fbEnsure(font.raw) < 0 {
        return;
    }
    let e = &FB_LAZY[FB_LAZY_N];
    FB_LAZY_N += 1;
    e.font = font.raw;
    e.raw = 0;
    e.state = 0;
    e.plen = path.len;
    for i in 0..path.len {
        e.path[i] = path[i];
    }
    // a cached "nobody has it" answer may now have a taker
    let ei = fbOf(font.raw);
    for h in 0..FB_HITS {
        if FB_HIT[h].ent == ei + 1 {
            FB_HIT[h].ent = 0;
        }
    }
}

const FB_LAZIES: int = 16;

struct FbLazy {
    font: ptr;
    /// The opened font (state 1).
    raw: ptr;
    /// 0 pending, 1 opened, 2 failed.
    state: int;
    path: [256]u8;
    plen: int;
}

#[singleton]
let FB_LAZY: [16]FbLazy;
#[singleton]
let FB_LAZY_N: int;

/// The chain index of `raw`, made if missing; -1 when the table is full.
fn fbEnsure(raw: ptr): int {
    let ei = fbOf(raw);
    if ei < 0 {
        if FB_N >= FB_FONTS {
            return -1;
        }
        ei = FB_N;
        FB_N += 1;
        FB[ei].font = raw;
        FB[ei].n = 0;
    }
    return ei;
}

/// Open pending `fontFallbackPath` files of chain `ei` in order until one has `cp`; true if one does.
fn fbLoadLazy(ei: int, cp: int): bool {
    let primary = FB[ei].font;
    for i in 0..FB_LAZY_N {
        let e = &FB_LAZY[i];
        if e.font != primary || e.state != 0 {
            continue;
        }
        let size = 0;
        for k in 0..FONT_SRC_N {
            if FONT_SRC[k].raw == primary {
                size = FONT_SRC[k].size;
            }
        }
        let f = if size > 0 { tryLoadFontC(cstrBytes(e.path[0..e.plen]), size) } else { Font { raw: 0 } };
        if f.raw == 0 {
            e.state = 2;
            continue;
        }
        e.state = 1;
        e.raw = f.raw;
        // ponytail: appends at open time, so eager fontFallback calls made later can sit before it
        fontFallback(Font { raw: primary }, f);
        if fbHas(f.raw, cp) {
            return true;
        }
    }
    return false;
}

/// `raw` is closing: forget its pending files and close the ones that were opened.
fn fbDropLazy(raw: ptr) {
    let i = 0;
    while i < FB_LAZY_N {
        if FB_LAZY[i].font != raw {
            i += 1;
            continue;
        }
        let opened = FB_LAZY[i].raw;
        FB_LAZY_N -= 1;
        FB_LAZY[i] = FB_LAZY[FB_LAZY_N];
        if opened != 0 {
            destroyFont(Font { raw: opened });
        }
    }
}

fn fbOf(raw: ptr): int {
    for i in 0..FB_N {
        if FB[i].font == raw {
            return i;
        }
    }
    return -1;
}

/// Forget the chain of `raw` (the font is closing) and `raw` as a member of any chain.
fn fbDrop(raw: ptr) {
    let i = 0;
    while i < FB_N {
        let hit = FB[i].font == raw;
        for k in 0..FB[i].n {
            if FB[i].alt[k] == raw {
                hit = true;
            }
        }
        if hit {
            FB_N -= 1;
            FB[i] = FB[FB_N];
            for h in 0..FB_HITS {
                FB_HIT[h].ent = 0;
            }
        } else {
            i += 1;
        }
    }
}

fn fbHas(font: ptr, cp: int): bool {
    let f = fontFns.glyph as fn(ptr, u32): i32;
    return f(font, u32(cp)) != 0;
}

/// Chain slot (0 = primary, k = `alt[k-1]`) that draws `cp`.
fn fbPick(ei: int, cp: int): int {
    let h = (cp + ei * 7919) % FB_HITS;
    if FB_HIT[h].ent == ei + 1 && FB_HIT[h].cp == cp {
        return FB_HIT[h].pick;
    }
    let pick = 0;
    if !fbHas(FB[ei].font, cp) {
        pick = fbScan(ei, cp);
        if pick == 0 && fbLoadLazy(ei, cp) {
            pick = fbScan(ei, cp);
        }
    }
    FB_HIT[h] = FbHit { ent: ei + 1, cp: cp, pick: pick };
    return pick;
}

/// First chain font (1-based) after the primary that has `cp`, 0 if none.
fn fbScan(ei: int, cp: int): int {
    for k in 0..FB[ei].n {
        if fbHas(FB[ei].alt[k], cp) {
            return k + 1;
        }
    }
    return 0;
}

fn fbFont(ei: int, pick: int): Font {
    if pick == 0 {
        return Font { raw: FB[ei].font };
    }
    return Font { raw: FB[ei].alt[pick - 1] };
}

/// Marks and joiners stay with the font of the code point before them.
fn fbSticky(cp: int): bool {
    return (cp >= 0x300 && cp <= 0x36F) || (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x20D0 && cp <= 0x20FF) || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || (cp >= 0xE0100 && cp <= 0xE01EF);
}

/// The code point at `msg[i]` and its byte length in `*n` (a stray or cut byte is its own code point).
fn fbCp(msg: []u8, i: int, n: &int): int {
    let b = int(msg[i]);
    let need = 0;
    let cp = b;
    if b >= 0xF0 {
        need = 3;
        cp = b - 0xF0;
    } else if b >= 0xE0 {
        need = 2;
        cp = b - 0xE0;
    } else if b >= 0xC0 {
        need = 1;
        cp = b - 0xC0;
    }
    let k = 1;
    while k <= need && i + k < msg.len && int(msg[i + k]) / 64 == 2 {
        cp = cp * 64 + int(msg[i + k]) % 64;
        k += 1;
    }
    if k <= need {
        *n = 1;
        return b;
    }
    *n = k;
    return cp;
}
