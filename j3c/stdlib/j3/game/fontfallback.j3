// Part of j3.game (font fallback chains); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Font fallback. `fontFallback(primary, extra)` appends `extra` to the chain of `primary`: a code point
/// the primary lacks (`TTF_GlyphIsProvided32`) comes from the first chain font that has it, else the primary
/// draws its own missing-glyph box. Runs of one font are measured and drawn separately (`textWidth`, `p2Text`).
/// The chain is per font handle, so give each size its own (the UI does it when it opens a font).
/// No-op when SDL_ttf is older than 2.0.18.
const FB_MAX: int = 4;
const FB_FONTS: int = 32;
const FB_HITS: int = 1024;

struct FbEnt {
    font: ptr;
    n: int;
    alt: [4]ptr;
}

/// One answer of "which chain font draws this code point", direct-mapped so it stays bounded.
struct FbHit {
    /// Chain index + 1 (0 = empty slot).
    ent: int;
    cp: int;
    pick: int;
}

#[singleton]
let FB: [32]FbEnt;
#[singleton]
let FB_N: int;
#[singleton]
let FB_HIT: [1024]FbHit;

/// Add `extra` to the fallback chain of `font` (see above). Duplicates and a full chain are ignored.
pub fn fontFallback(font: Font, extra: Font) {
    if font.raw == 0 || extra.raw == 0 || font.raw == extra.raw || fontFns.glyph == 0 {
        return;
    }
    let ei = fbOf(font.raw);
    if ei < 0 {
        if FB_N >= FB_FONTS {
            return;
        }
        ei = FB_N;
        FB_N += 1;
        FB[ei].font = font.raw;
        FB[ei].n = 0;
    }
    for k in 0..FB[ei].n {
        if FB[ei].alt[k] == extra.raw {
            return;
        }
    }
    if FB[ei].n < FB_MAX {
        FB[ei].alt[FB[ei].n] = extra.raw;
        FB[ei].n += 1;
        // answers cached for the shorter chain are stale
        for h in 0..FB_HITS {
            if FB_HIT[h].ent == ei + 1 {
                FB_HIT[h].ent = 0;
            }
        }
    }
}

fn fbOf(raw: ptr): int {
    for i in 0..FB_N {
        if FB[i].font == raw {
            return i;
        }
    }
    return -1;
}

/// Forget the chain of `raw` (the font is closing) and `raw` as a member of any chain.
fn fbDrop(raw: ptr) {
    let i = 0;
    while i < FB_N {
        let hit = FB[i].font == raw;
        for k in 0..FB[i].n {
            if FB[i].alt[k] == raw {
                hit = true;
            }
        }
        if hit {
            FB_N -= 1;
            FB[i] = FB[FB_N];
            for h in 0..FB_HITS {
                FB_HIT[h].ent = 0;
            }
        } else {
            i += 1;
        }
    }
}

fn fbHas(font: ptr, cp: int): bool {
    let f = fontFns.glyph as fn(ptr, u32): i32;
    return f(font, u32(cp)) != 0;
}

/// Chain slot (0 = primary, k = `alt[k-1]`) that draws `cp`.
fn fbPick(ei: int, cp: int): int {
    let h = (cp + ei * 7919) % FB_HITS;
    if FB_HIT[h].ent == ei + 1 && FB_HIT[h].cp == cp {
        return FB_HIT[h].pick;
    }
    let pick = 0;
    if !fbHas(FB[ei].font, cp) {
        for k in 0..FB[ei].n {
            if pick == 0 && fbHas(FB[ei].alt[k], cp) {
                pick = k + 1;
            }
        }
    }
    FB_HIT[h] = FbHit { ent: ei + 1, cp: cp, pick: pick };
    return pick;
}

fn fbFont(ei: int, pick: int): Font {
    if pick == 0 {
        return Font { raw: FB[ei].font };
    }
    return Font { raw: FB[ei].alt[pick - 1] };
}

/// Marks and joiners stay with the font of the code point before them.
fn fbSticky(cp: int): bool {
    return (cp >= 0x300 && cp <= 0x36F) || (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x20D0 && cp <= 0x20FF) || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || (cp >= 0xE0100 && cp <= 0xE01EF);
}

/// The code point at `msg[i]` and its byte length in `*n` (a stray or cut byte is its own code point).
fn fbCp(msg: []u8, i: int, n: &int): int {
    let b = int(msg[i]);
    let need = 0;
    let cp = b;
    if b >= 0xF0 {
        need = 3;
        cp = b - 0xF0;
    } else if b >= 0xE0 {
        need = 2;
        cp = b - 0xE0;
    } else if b >= 0xC0 {
        need = 1;
        cp = b - 0xC0;
    }
    let k = 1;
    while k <= need && i + k < msg.len && int(msg[i + k]) / 64 == 2 {
        cp = cp * 64 + int(msg[i + k]) % 64;
        k += 1;
    }
    if k <= need {
        *n = 1;
        return b;
    }
    *n = k;
    return cp;
}
