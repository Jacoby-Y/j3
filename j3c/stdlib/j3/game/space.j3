/// Uniform grid for broadphase queries. Ids are caller-defined.

module j3.game.space;

use j3.game.collide.Rect;
use j3.math.floor;
use j3.memory.{ Arena, scratch };

/// Number of hash buckets.
const BUCKETS: int = 64;

/// Hash grid of integer ids. `insert` covers the cells a rect touches.
pub struct Grid {
    /// World size of one cell.
    cell: f32;
    /// Head id index per bucket, or `-1` when empty.
    heads: []int;
    /// Next index in `ids` for the same bucket.
    next: []int;
    /// Stored ids, parallel with `next`.
    ids: []int;
    /// Live entries in `ids`.
    n: int;
    /// Allocated length of `ids` and `next`.
    cap: int;
    /// Arena that owns the tables.
    arena: &Arena;

    /// Empty grid. `cap` is the most cell-entries one `clear` cycle can hold.
    fn new(arena: &Arena, cap: int, cell: f32): Grid {
        let n = cap;
        if n < 8 {
            n = 8;
        }
        let c = cell;
        if c < 1 {
            c = 1;
        }
        let heads = arena.alloc::<int>(BUCKETS);
        let i = 0;
        while i < BUCKETS {
            heads[i] = 0 - 1;
            i += 1;
        }
        return Grid {
            cell: c,
            heads: heads,
            next: arena.alloc::<int>(n),
            ids: arena.alloc::<int>(n),
            n: 0,
            cap: n,
            arena: arena,
        };
    }

    /// Drop every id. Capacity stays.
    fn clear(this: &Grid) {
        let i = 0;
        while i < BUCKETS {
            this.heads[i] = 0 - 1;
            i += 1;
        }
        this.n = 0;
    }

    /// Record `id` in each cell `rect` touches, up to a 4×4 cell span.
    fn insert(this: &Grid, id: int, rect: Rect) {
        let x0 = int(floor(rect.pos.x / this.cell));
        let y0 = int(floor(rect.pos.y / this.cell));
        let x1 = int(floor((rect.pos.x + rect.size.x) / this.cell));
        let y1 = int(floor((rect.pos.y + rect.size.y) / this.cell));
        if x1 > x0 + 3 {
            x1 = x0 + 3;
        }
        if y1 > y0 + 3 {
            y1 = y0 + 3;
        }
        let y = y0;
        while y <= y1 {
            let x = x0;
            while x <= x1 {
                this.push(id, bucket(x, y));
                x += 1;
            }
            y += 1;
        }
    }

    /// Ids whose cells overlap `rect`, into scratch. Duplicates are dropped.
    fn query(this: &Grid, rect: Rect): []int {
        let out = scratch(1).alloc::<int>(this.n + 1);
        let k = 0;
        let x0 = int(floor(rect.pos.x / this.cell));
        let y0 = int(floor(rect.pos.y / this.cell));
        let x1 = int(floor((rect.pos.x + rect.size.x) / this.cell));
        let y1 = int(floor((rect.pos.y + rect.size.y) / this.cell));
        if x1 > x0 + 3 {
            x1 = x0 + 3;
        }
        if y1 > y0 + 3 {
            y1 = y0 + 3;
        }
        let y = y0;
        while y <= y1 {
            let x = x0;
            while x <= x1 {
                let slot = this.heads[bucket(x, y)];
                while slot >= 0 {
                    let id = this.ids[slot];
                    let seen = false;
                    let j = 0;
                    while j < k {
                        if out[j] == id {
                            seen = true;
                        }
                        j += 1;
                    }
                    if !seen && k < out.len {
                        out[k] = id;
                        k += 1;
                    }
                    slot = this.next[slot];
                }
                x += 1;
            }
            y += 1;
        }
        return []int { ptr: out.ptr, len: k };
    }

    /// Link `id` onto bucket `b` when there is room.
    fn push(this: &Grid, id: int, b: int) {
        if this.n >= this.cap {
            return;
        }
        let slot = this.n;
        this.ids[slot] = id;
        this.next[slot] = this.heads[b];
        this.heads[b] = slot;
        this.n = this.n + 1;
    }
}

/// Bucket for integer cell coordinates. Negatives fold into the same hash.
fn bucket(cx: int, cy: int): int {
    let x = cx;
    let y = cy;
    if x < 0 {
        x = 0 - x;
    }
    if y < 0 {
        y = 0 - y;
    }
    let h = x * 73856093 + y * 19349663;
    return h - (h / BUCKETS) * BUCKETS;
}
