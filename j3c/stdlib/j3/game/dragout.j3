// Part of j3.game (drag files out of the window: an XDND source on X11); the module doc and `use`s are in ../game.j3.
module j3.game;

/// What the drag started by `dragFiles` is doing this frame.
pub enum DragState {
    /// No drag.
    Idle,
    /// The pointer carries the files; the button is still down.
    Dragging,
    /// Released over an app that took the files. Lasts one frame.
    Dropped,
    /// Released where nothing takes files, or Escape was pressed. Lasts one frame.
    Cancelled,
}

/// Start dragging files out of the window into another app (a chat, a browser, a file manager).
/// Call it while the left button is held, typically once the mouse has moved a few pixels from a
/// press on an item. `game.poll()` moves the drag along; `dragState()` says how it ended.
/// While it runs the window gets no mouse motion; the release reaches it as a normal
/// `mouseReleased(Mouse.Left)`. Paths must be absolute. Drag data you only have in memory
/// (a rendered image) by writing it to a file first.
///
///     if game.mouseDown(Mouse.Left) && !started && moved > 6.0 {
///         started = game.dragFiles(["/tmp/shot.png"]);
///     }
///     if game.dragState() == DragState.Dropped { printLn("sent"); }
///
/// False when it cannot start: headless, no X11 (`libX11.so.6`), SDL on native Wayland (SDL2
/// normally runs on XWayland, which works), the button is not held, a path is relative, the list
/// is over 16 KB as URIs, or the last drop is still being delivered. Linux only. Main thread only.
pub fn dragFiles(paths: []string): bool {
    if DD_PHASE != 0 || paths.len == 0 || !clipUsable() || env("DISPLAY").len == 0 || !mouseDown(Mouse.Left) {
        return false;
    }
    if !DD_TRIED {
        DD_TRIED = true;
        ddLoad();
    }
    if DD_DPY as int == 0 || !ddPayload(paths) {
        return false;
    }
    // SDL's own X connection and window (SDL_SysWMinfo: subsystem at 4, x11 display at 8, window at 16)
    let info = &DD_INFO[0] as int;
    for i in 0..96 {
        DD_INFO[i] = u8(0);
    }
    sdl.SDL_GetVersion(info as ptr);
    if sdl.SDL_GetWindowWMInfo(platform.window, info as ptr) == 0 || rd32(info + 4) != 2 {
        return false;
    }
    let sdlDpy = rd64(info + 8) as ptr;
    DD_SDLWIN = rd64(info + 16);
    // the press gave SDL's connection an implicit pointer grab; ours fails until it is gone
    sdl.SDL_CaptureMouse(0);
    let ungrab = DD.ungrab as fn(ptr, u64): i32;
    let xsync = DD.sync as fn(ptr, i32): i32;
    ungrab(sdlDpy, u64(0));
    xsync(sdlDpy, 0);
    let owner = DD.setOwner as fn(ptr, u64, u64, u64): i32;
    owner(DD_DPY, u64(DD_A_SEL), u64(DD_WIN), u64(0));
    // ButtonReleaseMask | PointerMotionMask, GrabModeAsync; on the root so every window is reachable
    let grab = DD.grab as fn(ptr, u64, i32, u32, i32, i32, u64, u64, u64): i32;
    let ok = false;
    let tries = 0;
    while tries < 20 && !ok {
        ok = grab(DD_DPY, u64(DD_ROOT), 0, u32((1 << 3) + (1 << 6)), 1, 1, u64(0), u64(DD_CURSOR), u64(0)) == 0;
        if !ok {
            sdl.SDL_Delay(u32(5));
        }
        tries += 1;
    }
    if !ok {
        return false;
    }
    xsync(DD_DPY, 0);
    DD_TARGET = 0;
    DD_ACCEPT = false;
    DD_WAIT = false;
    DD_PENDING = false;
    DD_PHASE = 1;
    DD_STATE = DragState.Dragging;
    DD_ENDED = false;
    return true;
}

/// The drag started by `dragFiles`: `Dragging` while it runs, then `Dropped` or `Cancelled` for one frame.
pub fn dragState(): DragState {
    return DD_STATE;
}

/// Advance the drag; called by `poll` after SDL's events.
fn dragStep() {
    if DD_ENDED {
        DD_ENDED = false;
        DD_STATE = DragState.Idle;
    }
    if DD_PHASE == 0 {
        return;
    }
    let pending = DD.pending as fn(ptr): i32;
    let next = DD.next as fn(ptr, ptr): i32;
    while DD_PHASE != 0 && pending(DD_DPY) > 0 {
        next(DD_DPY, &DD_EV[0] as ptr);
        ddEvent();
    }
    if DD_PHASE == 1 && keyPressedRaw(Key.Escape) {
        ddRelease();
        ddCancel();
    } else if DD_PHASE >= 2 && int(sdl.SDL_GetTicks()) > DD_DEADLINE {
        // the target went quiet: no status after release (2), or no XdndFinished after drop (3)
        if DD_PHASE == 2 {
            ddCancel();
        } else {
            DD_PHASE = 0;
        }
    }
    let flush = DD.flush as fn(ptr): i32;
    flush(DD_DPY);
}

fn ddEvent() {
    let ev = &DD_EV[0] as int;
    let ty = rd32(ev);
    if ty == 6 {
        // MotionNotify: time at 56, x_root/y_root at 72/76
        DD_TIME = rd64(ev + 56);
        if DD_PHASE == 1 {
            ddMove(rd32(ev + 72), rd32(ev + 76));
        }
    } else if ty == 5 {
        // ButtonRelease: button at 84
        if rd32(ev + 84) != 1 || DD_PHASE != 1 {
            return;
        }
        DD_TIME = rd64(ev + 56);
        ddRelease();
        if DD_TARGET == 0 {
            ddCancel();
        } else if DD_WAIT {
            DD_PHASE = 2;
            DD_DEADLINE = int(sdl.SDL_GetTicks()) + 1000;
        } else {
            ddDrop();
        }
    } else if ty == 33 {
        // ClientMessage: message_type at 40, data.l[0..] at 56, 64, ...
        let mt = rd64(ev + 40);
        if mt == DD_A_STATUS && rd64(ev + 56) == DD_TARGET {
            DD_WAIT = false;
            DD_ACCEPT = (rd64(ev + 64) & 1) != 0;
            if DD_PHASE == 1 && DD_PENDING {
                ddPosition();
            } else if DD_PHASE == 2 {
                ddDrop();
            }
        } else if mt == DD_A_FINISHED && DD_PHASE == 3 {
            DD_PHASE = 0;
        }
    } else if ty == 30 {
        ddServe();
    }
}

/// Pointer at root `x`, `y`: switch targets (Leave, Enter) and tell the target where we are.
fn ddMove(x: int, y: int) {
    DD_X = x;
    DD_Y = y;
    let t = ddFind(x, y);
    if t != DD_TARGET {
        if DD_TARGET != 0 {
            ddSend(DD_TARGET, DD_A_LEAVE, 0, 0, 0, 0);
        }
        DD_TARGET = t;
        DD_ACCEPT = false;
        DD_WAIT = false;
        DD_PENDING = false;
        if t != 0 {
            // version in the high byte; three types or fewer, so no XdndTypeList
            ddSend(t, DD_A_ENTER, DD_VER << 24, DD_A_URI, 0, 0);
        }
    }
    if DD_TARGET == 0 {
        return;
    }
    // one XdndPosition in flight at a time; the newest waits for its XdndStatus
    if DD_WAIT {
        DD_PENDING = true;
    } else {
        ddPosition();
    }
}

fn ddPosition() {
    DD_PENDING = false;
    DD_WAIT = true;
    ddSend(DD_TARGET, DD_A_POS, 0, (DD_X << 16) + DD_Y, DD_TIME, DD_A_COPY);
}

fn ddDrop() {
    if !DD_ACCEPT {
        ddCancel();
        return;
    }
    ddSend(DD_TARGET, DD_A_DROP, 0, DD_TIME, 0, 0);
    // keep owning the selection and answering requests until XdndFinished
    DD_PHASE = 3;
    DD_DEADLINE = int(sdl.SDL_GetTicks()) + 2000;
    DD_STATE = DragState.Dropped;
    DD_ENDED = true;
}

fn ddCancel() {
    if DD_TARGET != 0 {
        ddSend(DD_TARGET, DD_A_LEAVE, 0, 0, 0, 0);
    }
    DD_PHASE = 0;
    DD_STATE = DragState.Cancelled;
    DD_ENDED = true;
}

/// Give the pointer back and tell SDL the button went up (it never saw the real release).
fn ddRelease() {
    let ungrab = DD.ungrab as fn(ptr, u64): i32;
    ungrab(DD_DPY, u64(0));
    let tr = DD.translate as fn(ptr, u64, u64, i32, i32, &i32, &i32, &u64): i32;
    let wx: i32 = 0;
    let wy: i32 = 0;
    let child: u64 = u64(0);
    tr(DD_DPY, u64(DD_ROOT), u64(DD_SDLWIN), i32(DD_X), i32(DD_Y), &wx, &wy, &child);
    // XButtonEvent: window 32, root 40, time 56, x/y 64/68, x_root/y_root 72/76, state 80, button 84, same_screen 88
    let ev = ddClear();
    wr32(ev, 5);
    wr64(ev + 32, DD_SDLWIN);
    wr64(ev + 40, DD_ROOT);
    wr64(ev + 56, DD_TIME);
    wr32(ev + 64, int(wx));
    wr32(ev + 68, int(wy));
    wr32(ev + 72, DD_X);
    wr32(ev + 76, DD_Y);
    wr32(ev + 80, 1 << 8);
    wr32(ev + 84, 1);
    wr32(ev + 88, 1);
    let send = DD.send as fn(ptr, u64, i32, i64, ptr): i32;
    send(DD_DPY, u64(DD_SDLWIN), 0, i64(1 << 3), ev as ptr);
}

/// The topmost window under root `x`, `y` that takes XDND (version 3 or later), or 0.
/// ponytail: no XdndProxy; add it if a target ignores drops.
fn ddFind(x: int, y: int): int {
    let tr = DD.translate as fn(ptr, u64, u64, i32, i32, &i32, &i32, &u64): i32;
    let w = DD_ROOT;
    for depth in 0..16 {
        let dx: i32 = 0;
        let dy: i32 = 0;
        let child: u64 = u64(0);
        tr(DD_DPY, u64(DD_ROOT), u64(w), i32(x), i32(y), &dx, &dy, &child);
        if child == u64(0) {
            return 0;
        }
        w = int(child);
        if w == DD_SDLWIN {
            return 0;
        }
        let v = ddAware(w);
        if v >= 3 {
            DD_VER = if v > 5 { 5 } else { v };
            return w;
        }
    }
    return 0;
}

/// The XdndAware version on window `w`, or 0.
fn ddAware(w: int): int {
    let get = DD.getProp as fn(ptr, u64, u64, i64, i64, i32, u64, &u64, &i32, &u64, &u64, &ptr): i32;
    let ty: u64 = u64(0);
    let format: i32 = 0;
    let items: u64 = u64(0);
    let after: u64 = u64(0);
    let data: ptr = 0 as ptr;
    if get(DD_DPY, u64(w), u64(DD_A_AWARE), i64(0), i64(1), 0, u64(0), &ty, &format, &items, &after, &data) != 0 {
        return 0;
    }
    if data as int == 0 {
        return 0;
    }
    let v = 0;
    if items > u64(0) && format == 32 {
        v = rd64(data as int);
    }
    let xfree = DD.free as fn(ptr): i32;
    xfree(data);
    return v;
}

/// Answer a SelectionRequest for XdndSelection: the URI list, or TARGETS.
fn ddServe() {
    // XSelectionRequestEvent: requestor 40, selection 48, target 56, property 64, time 72
    let ev = &DD_EV[0] as int;
    let req = rd64(ev + 40);
    let selection = rd64(ev + 48);
    let target = rd64(ev + 56);
    let prop = rd64(ev + 64);
    let time = rd64(ev + 72);
    if prop == 0 {
        prop = target;
    }
    let change = DD.changeProp as fn(ptr, u64, u64, u64, i32, i32, ptr, i32): i32;
    if selection != DD_A_SEL {
        prop = 0;
    } else if target == DD_A_URI {
        change(DD_DPY, u64(req), u64(prop), u64(DD_A_URI), 8, 0, &DD_PAY[0] as ptr, i32(DD_PAYLEN));
    } else if target == DD_A_TARGETS {
        // format 32 items are longs in Xlib; XA_ATOM is 4
        DD_LIST[0] = DD_A_TARGETS;
        DD_LIST[1] = DD_A_URI;
        change(DD_DPY, u64(req), u64(prop), u64(4), 32, 0, &DD_LIST[0] as ptr, 2);
    } else {
        prop = 0;
    }
    // XSelectionEvent: requestor 32, selection 40, target 48, property 56, time 64
    let out = ddClear();
    wr32(out, 31);
    wr64(out + 32, req);
    wr64(out + 40, selection);
    wr64(out + 48, target);
    wr64(out + 56, prop);
    wr64(out + 64, time);
    let send = DD.send as fn(ptr, u64, i32, i64, ptr): i32;
    send(DD_DPY, u64(req), 0, i64(0), out as ptr);
}

/// Send an XDND ClientMessage to `to`: l[0] is our window, then `l1`..`l4`.
fn ddSend(to: int, kind: int, l1: int, l2: int, l3: int, l4: int) {
    let ev = ddClear();
    wr32(ev, 33);
    wr64(ev + 32, to);
    wr64(ev + 40, kind);
    wr32(ev + 48, 32);
    wr64(ev + 56, DD_WIN);
    wr64(ev + 64, l1);
    wr64(ev + 72, l2);
    wr64(ev + 80, l3);
    wr64(ev + 88, l4);
    let send = DD.send as fn(ptr, u64, i32, i64, ptr): i32;
    send(DD_DPY, u64(to), 0, i64(0), ev as ptr);
}

/// Zero the outgoing event buffer and return its address.
fn ddClear(): int {
    for i in 0..192 {
        DD_OUT[i] = u8(0);
    }
    return &DD_OUT[0] as int;
}

/// `file:///abs/path\r\n` per path into `DD_PAY`, bytes outside [A-Za-z0-9-._~/] as %XX.
fn ddPayload(paths: []string): bool {
    let hex = "0123456789ABCDEF";
    let n = 0;
    for p in 0..paths.len {
        let s = paths[p];
        if s.len == 0 || s[0] != u8(47) {
            return false;
        }
        if n + 7 + s.len * 3 + 2 > 16384 {
            return false;
        }
        let pre = "file://";
        for i in 0..pre.len {
            DD_PAY[n] = pre[i];
            n += 1;
        }
        for i in 0..s.len {
            let c = s[i];
            let plain = (c >= u8(97) && c <= u8(122)) || (c >= u8(65) && c <= u8(90)) || (c >= u8(48) && c <= u8(57))
                || c == u8(45) || c == u8(46) || c == u8(95) || c == u8(126) || c == u8(47);
            if plain {
                DD_PAY[n] = c;
                n += 1;
            } else {
                DD_PAY[n] = u8(37);
                DD_PAY[n + 1] = hex[int(c) >> 4];
                DD_PAY[n + 2] = hex[int(c) & 15];
                n += 3;
            }
        }
        DD_PAY[n] = u8(13);
        DD_PAY[n + 1] = u8(10);
        n += 2;
    }
    DD_PAYLEN = n;
    return true;
}

fn ddSym(so: ptr, name: string): ptr {
    let p = dlsym(so, name);
    if p as int == 0 {
        DD_OK = false;
    }
    return p;
}

/// libX11, our own connection (so clipboard reads never eat XDND messages), source window, atoms.
fn ddLoad() {
    let so = dlopen("libX11.so.6");
    if so as int == 0 {
        return;
    }
    DD_OK = true;
    DD.open = ddSym(so, "XOpenDisplay");
    DD.root = ddSym(so, "XDefaultRootWindow");
    DD.createWin = ddSym(so, "XCreateSimpleWindow");
    DD.intern = ddSym(so, "XInternAtom");
    DD.setOwner = ddSym(so, "XSetSelectionOwner");
    DD.grab = ddSym(so, "XGrabPointer");
    DD.ungrab = ddSym(so, "XUngrabPointer");
    DD.send = ddSym(so, "XSendEvent");
    DD.translate = ddSym(so, "XTranslateCoordinates");
    DD.changeProp = ddSym(so, "XChangeProperty");
    DD.getProp = ddSym(so, "XGetWindowProperty");
    DD.fontCursor = ddSym(so, "XCreateFontCursor");
    DD.pending = ddSym(so, "XPending");
    DD.next = ddSym(so, "XNextEvent");
    DD.flush = ddSym(so, "XFlush");
    DD.sync = ddSym(so, "XSync");
    DD.free = ddSym(so, "XFree");
    if !DD_OK {
        return;
    }
    let open = DD.open as fn(ptr): ptr;
    let dpy = open(0 as ptr);
    if dpy as int == 0 {
        return;
    }
    let rootOf = DD.root as fn(ptr): u64;
    DD_ROOT = int(rootOf(dpy));
    let create = DD.createWin as fn(ptr, u64, i32, i32, u32, u32, u32, u64, u64): u64;
    DD_WIN = int(create(dpy, u64(DD_ROOT), 0, 0, 1, 1, 0, 0, 0));
    // XC_hand2
    let cursor = DD.fontCursor as fn(ptr, u32): u64;
    DD_CURSOR = int(cursor(dpy, u32(60)));
    let intern = DD.intern as fn(ptr, cstr, i32): u64;
    DD_A_AWARE = int(intern(dpy, cstr("XdndAware"), 0));
    DD_A_ENTER = int(intern(dpy, cstr("XdndEnter"), 0));
    DD_A_POS = int(intern(dpy, cstr("XdndPosition"), 0));
    DD_A_STATUS = int(intern(dpy, cstr("XdndStatus"), 0));
    DD_A_LEAVE = int(intern(dpy, cstr("XdndLeave"), 0));
    DD_A_DROP = int(intern(dpy, cstr("XdndDrop"), 0));
    DD_A_FINISHED = int(intern(dpy, cstr("XdndFinished"), 0));
    DD_A_SEL = int(intern(dpy, cstr("XdndSelection"), 0));
    DD_A_COPY = int(intern(dpy, cstr("XdndActionCopy"), 0));
    DD_A_URI = int(intern(dpy, cstr("text/uri-list"), 0));
    DD_A_TARGETS = int(intern(dpy, cstr("TARGETS"), 0));
    DD_DPY = dpy;
}

fn wr32(at: int, v: int) {
    let p = at as ptr as &i32;
    *p = i32(v);
}

fn wr64(at: int, v: int) {
    let p = at as ptr as &int;
    *p = v;
}

/// The libX11 calls the drag source uses.
struct DragFns {
    open: ptr;
    root: ptr;
    createWin: ptr;
    intern: ptr;
    setOwner: ptr;
    grab: ptr;
    ungrab: ptr;
    send: ptr;
    translate: ptr;
    changeProp: ptr;
    getProp: ptr;
    fontCursor: ptr;
    pending: ptr;
    next: ptr;
    flush: ptr;
    sync: ptr;
    free: ptr;
}

#[singleton]
let DD: DragFns;
#[singleton]
let DD_OK: bool = false;
#[singleton]
let DD_TRIED: bool = false;
#[singleton]
let DD_DPY: ptr = 0;
#[singleton]
let DD_ROOT: int = 0;
/// Our source window (owns XdndSelection, gets XdndStatus/XdndFinished).
#[singleton]
let DD_WIN: int = 0;
#[singleton]
let DD_CURSOR: int = 0;
/// SDL's X window, never a drop target.
#[singleton]
let DD_SDLWIN: int = 0;
/// 0 idle, 1 dragging, 2 released and waiting for XdndStatus, 3 dropped and waiting for XdndFinished.
#[singleton]
let DD_PHASE: int = 0;
#[singleton]
let DD_STATE: DragState;
/// `DD_STATE` is Dropped/Cancelled this frame; the next `dragStep` makes it Idle.
#[singleton]
let DD_ENDED: bool = false;
#[singleton]
let DD_DEADLINE: int = 0;
#[singleton]
let DD_TARGET: int = 0;
#[singleton]
let DD_VER: int = 5;
#[singleton]
let DD_ACCEPT: bool = false;
/// An XdndPosition is waiting for its XdndStatus.
#[singleton]
let DD_WAIT: bool = false;
/// The pointer moved while `DD_WAIT`; send the newest position when the status comes.
#[singleton]
let DD_PENDING: bool = false;
#[singleton]
let DD_X: int = 0;
#[singleton]
let DD_Y: int = 0;
/// Last X server time seen (motion, release), for XdndPosition and XdndDrop.
#[singleton]
let DD_TIME: int = 0;
#[singleton]
let DD_A_AWARE: int = 0;
#[singleton]
let DD_A_ENTER: int = 0;
#[singleton]
let DD_A_POS: int = 0;
#[singleton]
let DD_A_STATUS: int = 0;
#[singleton]
let DD_A_LEAVE: int = 0;
#[singleton]
let DD_A_DROP: int = 0;
#[singleton]
let DD_A_FINISHED: int = 0;
#[singleton]
let DD_A_SEL: int = 0;
#[singleton]
let DD_A_COPY: int = 0;
#[singleton]
let DD_A_URI: int = 0;
#[singleton]
let DD_A_TARGETS: int = 0;
/// `SDL_SysWMinfo` (72 bytes on LP64; room to spare).
#[singleton]
let DD_INFO: [96]u8;
/// One incoming and one outgoing `XEvent` (192 bytes on LP64).
#[singleton]
let DD_EV: [192]u8;
#[singleton]
let DD_OUT: [192]u8;
/// TARGETS answer.
#[singleton]
let DD_LIST: [2]int;
/// The `text/uri-list` payload.
#[singleton]
let DD_PAY: [16384]u8;
#[singleton]
let DD_PAYLEN: int = 0;
