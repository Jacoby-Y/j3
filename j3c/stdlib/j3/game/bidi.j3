// Part of j3.game (font fallback, bidi runs, text width, caret, selection, p2Text); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Font fallback. `fontFallback(primary, extra)` appends `extra` to the chain of `primary`: a code point
/// the primary lacks (`TTF_GlyphIsProvided32`) comes from the first chain font that has it, else the primary
/// draws its own missing-glyph box. Runs of one font are measured and drawn separately (`textWidth`, `p2Text`).
/// The chain is per font handle, so give each size its own (the UI does it when it opens a font).
/// No-op when SDL_ttf is older than 2.0.18.
const FB_MAX: int = 4;
const FB_FONTS: int = 32;
const FB_HITS: int = 1024;

struct FbEnt {
    font: ptr;
    n: int;
    alt: [4]ptr;
}

/// One answer of "which chain font draws this code point", direct-mapped so it stays bounded.
struct FbHit {
    /// Chain index + 1 (0 = empty slot).
    ent: int;
    cp: int;
    pick: int;
}

#[singleton]
let FB: [32]FbEnt;
#[singleton]
let FB_N: int;
#[singleton]
let FB_HIT: [1024]FbHit;

/// Add `extra` to the fallback chain of `font` (see above). Duplicates and a full chain are ignored.
pub fn fontFallback(font: Font, extra: Font) {
    if font.raw == 0 || extra.raw == 0 || font.raw == extra.raw || fontFns.glyph == 0 {
        return;
    }
    let ei = fbOf(font.raw);
    if ei < 0 {
        if FB_N >= FB_FONTS {
            return;
        }
        ei = FB_N;
        FB_N += 1;
        FB[ei].font = font.raw;
        FB[ei].n = 0;
    }
    for k in 0..FB[ei].n {
        if FB[ei].alt[k] == extra.raw {
            return;
        }
    }
    if FB[ei].n < FB_MAX {
        FB[ei].alt[FB[ei].n] = extra.raw;
        FB[ei].n += 1;
        // answers cached for the shorter chain are stale
        for h in 0..FB_HITS {
            if FB_HIT[h].ent == ei + 1 {
                FB_HIT[h].ent = 0;
            }
        }
    }
}

fn fbOf(raw: ptr): int {
    for i in 0..FB_N {
        if FB[i].font == raw {
            return i;
        }
    }
    return -1;
}

/// Forget the chain of `raw` (the font is closing) and `raw` as a member of any chain.
fn fbDrop(raw: ptr) {
    let i = 0;
    while i < FB_N {
        let hit = FB[i].font == raw;
        for k in 0..FB[i].n {
            if FB[i].alt[k] == raw {
                hit = true;
            }
        }
        if hit {
            FB_N -= 1;
            FB[i] = FB[FB_N];
            for h in 0..FB_HITS {
                FB_HIT[h].ent = 0;
            }
        } else {
            i += 1;
        }
    }
}

fn fbHas(font: ptr, cp: int): bool {
    let f = fontFns.glyph as fn(ptr, u32): i32;
    return f(font, u32(cp)) != 0;
}

/// Chain slot (0 = primary, k = `alt[k-1]`) that draws `cp`.
fn fbPick(ei: int, cp: int): int {
    let h = (cp + ei * 7919) % FB_HITS;
    if FB_HIT[h].ent == ei + 1 && FB_HIT[h].cp == cp {
        return FB_HIT[h].pick;
    }
    let pick = 0;
    if !fbHas(FB[ei].font, cp) {
        for k in 0..FB[ei].n {
            if pick == 0 && fbHas(FB[ei].alt[k], cp) {
                pick = k + 1;
            }
        }
    }
    FB_HIT[h] = FbHit { ent: ei + 1, cp: cp, pick: pick };
    return pick;
}

fn fbFont(ei: int, pick: int): Font {
    if pick == 0 {
        return Font { raw: FB[ei].font };
    }
    return Font { raw: FB[ei].alt[pick - 1] };
}

/// Marks and joiners stay with the font of the code point before them.
fn fbSticky(cp: int): bool {
    return (cp >= 0x300 && cp <= 0x36F) || (cp >= 0x200B && cp <= 0x200F) || (cp >= 0x20D0 && cp <= 0x20FF) || (cp >= 0xFE00 && cp <= 0xFE0F) || (cp >= 0x1F3FB && cp <= 0x1F3FF) || (cp >= 0xE0100 && cp <= 0xE01EF);
}

/// The code point at `msg[i]` and its byte length in `*n` (a stray or cut byte is its own code point).
fn fbCp(msg: []u8, i: int, n: &int): int {
    let b = int(msg[i]);
    let need = 0;
    let cp = b;
    if b >= 0xF0 {
        need = 3;
        cp = b - 0xF0;
    } else if b >= 0xE0 {
        need = 2;
        cp = b - 0xE0;
    } else if b >= 0xC0 {
        need = 1;
        cp = b - 0xC0;
    }
    let k = 1;
    while k <= need && i + k < msg.len && int(msg[i + k]) / 64 == 2 {
        cp = cp * 64 + int(msg[i + k]) % 64;
        k += 1;
    }
    if k <= need {
        *n = 1;
        return b;
    }
    *n = k;
    return cp;
}

/// Complex scripts SDL_ttf (HarfBuzz) shapes once it is told the script: index into `SCRIPTS`, 0 = nothing special.
fn scriptTag(i: int): string {
    if i == 1 { return "Arab"; }
    if i == 2 { return "Hebr"; }
    if i == 3 { return "Deva"; }
    if i == 4 { return "Beng"; }
    if i == 5 { return "Thai"; }
    if i == 6 { return "Taml"; }
    if i == 7 { return "Telu"; }
    return "Latn";
}

#[singleton]
let SHAPE_OK: int = -1;

fn scriptOf(cp: int): int {
    if cp < 0x590 || SHAPE_OK == 0 {
        return 0;
    }
    if SHAPE_OK < 0 {
        SHAPE_OK = 0;
        if textShaping() {
            SHAPE_OK = 1;
        }
        return scriptOf(cp);
    }
    if cp <= 0x5FF || (cp >= 0xFB1D && cp <= 0xFB4F) {
        return 2;
    }
    if (cp >= 0x600 && cp <= 0x77F) || (cp >= 0x8A0 && cp <= 0x8FF) || (cp >= 0xFB50 && cp <= 0xFDFF) || (cp >= 0xFE70 && cp <= 0xFEFF) {
        return 1;
    }
    if cp >= 0x900 && cp <= 0x97F { return 3; }
    if cp >= 0x980 && cp <= 0x9FF { return 4; }
    if cp >= 0xB80 && cp <= 0xBFF { return 6; }
    if cp >= 0xC00 && cp <= 0xC7F { return 7; }
    if cp >= 0xE00 && cp <= 0xE7F { return 5; }
    return 0;
}

/// One run of text drawn by one chain font, with one script and one bidi level.
struct BRun {
    a: int;
    b: int;
    pick: int;
    script: int;
    /// UAX #9 bidi class (`BC_*`); resolved in place by `bidiResolve`.
    cls: int;
    /// UAX #9 embedding level (odd = right to left).
    lvl: int;
}

#[singleton]
let BR: [1024]BRun;
#[singleton]
let BVIS: [1024]int;

const BC_L: int = 0;
const BC_R: int = 1;
const BC_AL: int = 2;
const BC_EN: int = 3;
const BC_AN: int = 4;
const BC_ES: int = 5;
const BC_ET: int = 6;
const BC_CS: int = 7;
/// Everything else (spaces, punctuation, symbols): the neutrals.
const BC_ON: int = 8;

/// Bidi class of a code point. Ranges only for what the renderer draws (Latin, Hebrew, Arabic and the Indic/Thai
/// scripts it shapes); other code points above ASCII count as letters, except the general punctuation blocks.
fn bidiClass(cp: int, script: int): int {
    if cp < 128 {
        if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) { return BC_L; }
        if cp >= 48 && cp <= 57 { return BC_EN; }
        if cp == 43 || cp == 45 { return BC_ES; }
        if cp >= 35 && cp <= 37 { return BC_ET; }
        if cp == 44 || cp == 46 || cp == 47 || cp == 58 { return BC_CS; }
        return BC_ON;
    }
    if script == 1 {
        if cp >= 0x660 && cp <= 0x669 { return BC_AN; }
        if cp == 0x66B || cp == 0x66C { return BC_AN; }
        if cp >= 0x6F0 && cp <= 0x6F9 { return BC_EN; }
        if cp == 0x66A { return BC_ET; }
        if cp == 0x60C || cp == 0x60D { return BC_CS; }
        return BC_AL;
    }
    if script == 2 { return BC_R; }
    if cp == 0xA0 { return BC_CS; }
    if cp == 0xB0 || cp == 0xB1 || (cp >= 0x2030 && cp <= 0x2034) || (cp >= 0x20A0 && cp <= 0x20CF) { return BC_ET; }
    if cp == 0xB2 || cp == 0xB3 || cp == 0xB9 { return BC_EN; }
    if cp == 0x2212 { return BC_ES; }
    if (cp >= 0x2000 && cp <= 0x206F) || (cp >= 0xA0 && cp <= 0xBF) || (cp >= 0x3000 && cp <= 0x303F) { return BC_ON; }
    return BC_L;
}

/// Nonspacing marks (W1): Arabic harakat and Quranic marks, Hebrew points. They take the class of the run before them.
fn bidiMark(cp: int): bool {
    return (cp >= 0x64B && cp <= 0x65F) || cp == 0x670 || (cp >= 0x6D6 && cp <= 0x6DC) || (cp >= 0x6DF && cp <= 0x6E4) || cp == 0x6E7 || cp == 0x6E8 || (cp >= 0x6EA && cp <= 0x6ED) || (cp >= 0x591 && cp <= 0x5BD) || cp == 0x5BF || cp == 0x5C1 || cp == 0x5C2 || cp == 0x5C4 || cp == 0x5C5 || cp == 0x5C7;
}

#[singleton]
let BR_WARNED: bool;

fn isStrong(c: int): bool {
    return c == BC_L || c == BC_R || c == BC_AL;
}

/// UAX #9 on the runs `BR[0..nr)`, one paragraph (the base direction is the first strong run): weak types W2-W7,
/// neutrals N1/N2, levels I1/I2. Runs of one class stand for their code points, so this is linear in the runs.
/// Not done: explicit embeddings/overrides/isolates (X rules), N0 bracket pairs, W1 (marks follow the font run
/// before them, so a mark takes its base's class), and RLM/LRM (they count as the preceding run).
fn bidiResolve(nr: int) {
    let base = 0;
    for k in 0..nr {
        if isStrong(BR[k].cls) {
            if BR[k].cls != BC_L { base = 1; }
            break;
        }
    }
    // W2: EN after AL is AN. W3: AL is R. (`last` is the last strong class, sos at first)
    let last = BC_L;
    if base == 1 { last = BC_R; }
    for k in 0..nr {
        let c0 = BR[k].cls;
        if isStrong(c0) { last = c0; }
        if c0 == BC_EN && last == BC_AL { BR[k].cls = BC_AN; }
    }
    for k in 0..nr {
        if BR[k].cls == BC_AL { BR[k].cls = BC_R; }
    }
    // W4: a single ES between two EN is EN; a single CS between two numbers of one type takes that type.
    for k in 1..nr - 1 {
        let c1 = BR[k].cls;
        let p = BR[k - 1].cls;
        if (c1 == BC_ES || c1 == BC_CS) && p == BR[k + 1].cls && (p == BC_EN || (p == BC_AN && c1 == BC_CS)) {
            BR[k].cls = p;
        }
    }
    // W5: ET next to EN is EN (forward, then backward, so a chain of ET runs follows).
    for k in 1..nr {
        if BR[k].cls == BC_ET && BR[k - 1].cls == BC_EN { BR[k].cls = BC_EN; }
    }
    let q = nr - 2;
    while q >= 0 {
        if BR[q].cls == BC_ET && BR[q + 1].cls == BC_EN { BR[q].cls = BC_EN; }
        q -= 1;
    }
    // W6: leftover separators and terminators are neutral. W7: EN after L (or sos L) is L.
    last = BC_L;
    if base == 1 { last = BC_R; }
    for k in 0..nr {
        let c2 = BR[k].cls;
        if c2 == BC_ES || c2 == BC_ET || c2 == BC_CS { BR[k].cls = BC_ON; }
        if isStrong(c2) { last = c2; }
        if c2 == BC_EN && last == BC_L { BR[k].cls = BC_L; }
    }
    // N1/N2: neutrals between the same direction (EN and AN count as R) take it, else the base direction.
    // I1/I2: a level from the direction and the base level.
    for k in 0..nr {
        let c3 = BR[k].cls;
        let dir = 1;
        if c3 == BC_L { dir = 0; }
        if c3 == BC_ON {
            let before = base;
            let q1 = k - 1;
            while q1 >= 0 && BR[q1].cls == BC_ON { q1 -= 1; }
            if q1 >= 0 {
                before = 1;
                if BR[q1].cls == BC_L { before = 0; }
            }
            let after = base;
            let q2 = k + 1;
            while q2 < nr && BR[q2].cls == BC_ON { q2 += 1; }
            if q2 < nr {
                after = 1;
                if BR[q2].cls == BC_L { after = 0; }
            }
            dir = base;
            if before == after { dir = before; }
        }
        if c3 == BC_EN || c3 == BC_AN {
            BR[k].lvl = 2;
        } else if dir == 0 {
            BR[k].lvl = 2 * base;
        } else {
            BR[k].lvl = 1;
        }
    }
}

/// Split `msg` into `BR[0..n)` by chain font, script and bidi level (neighbours with all three equal are
/// merged); returns n, or 0 when the primary alone draws `msg` in one go (no chain hit, no complex script),
/// so ordinary text never takes this path. `*reorder` is true when some run is right to left.
fn fbRuns(font: ptr, msg: []u8, reorder: &bool): int {
    *reorder = false;
    let ei = -1;
    if FB_N > 0 {
        ei = fbOf(font);
    }
    // quick scan: any code point that needs the run path?
    let need = false;
    let i = 0;
    while i < msg.len && !need {
        if int(msg[i]) >= 128 {
            let w0: int = 1;
            let c0 = fbCp(msg, i, &w0);
            if scriptOf(c0) != 0 || (ei >= 0 && !fbSticky(c0) && fbPick(ei, c0) > 0) {
                need = true;
            }
            i += w0;
        } else {
            i += 1;
        }
    }
    if !need {
        return 0;
    }
    let nr = 0;
    let rtl = false;
    i = 0;
    while i < msg.len {
        let n: int = 1;
        let cp = fbCp(msg, i, &n);
        let pick = 0;
        let sc = 0;
        let cl = BC_ON;
        if cp < 128 || !fbSticky(cp) {
            sc = scriptOf(cp);
            cl = bidiClass(cp, sc);
            if nr > 0 && bidiMark(cp) { cl = BR[nr - 1].cls; }
            if ei >= 0 && cp >= 128 {
                pick = fbPick(ei, cp);
            }
        } else if nr > 0 {
            pick = BR[nr - 1].pick;
            sc = BR[nr - 1].script;
            cl = BR[nr - 1].cls;
        }
        // a space or digit joins a neighbouring run of the same font; script/class are settled after
        // (a lone ES/CS is its own run: W4 needs single separators)
        if nr > 0 && BR[nr - 1].pick == pick && BR[nr - 1].script == sc && BR[nr - 1].cls == cl && cl != BC_ES && cl != BC_CS {
            BR[nr - 1].b = i + n;
        } else if nr < 1024 {
            BR[nr] = BRun { a: i, b: i + n, pick: pick, script: sc, cls: cl, lvl: 0 };
            nr += 1;
        } else {
            // past the cap the tail joins the last run: its order may be wrong, so say so once
            if !BR_WARNED {
                BR_WARNED = true;
                let w = "warning: text has more than 1024 bidi runs; the rest is laid out as one run\n";
                write(2, w.ptr as ptr, w.len);
            }
            BR[nr - 1].b = i + n;
        }
        if cl == BC_R || cl == BC_AL || cl == BC_AN { rtl = true; }
        i += n;
    }
    // no R, AL or AN anywhere (a font fallback or Latin-1 text): every level is 0, nothing to resolve
    if rtl {
        bidiResolve(nr);
    } else {
        for k in 0..nr { BR[k].lvl = 0; }
    }
    // merge neighbours that now match
    let m = 0;
    for k in 0..nr {
        if m > 0 && BR[m - 1].pick == BR[k].pick && BR[m - 1].script == BR[k].script && BR[m - 1].lvl == BR[k].lvl {
            BR[m - 1].b = BR[k].b;
        } else {
            BR[m] = BR[k];
            m += 1;
        }
    }
    for k in 0..m {
        BVIS[k] = k;
        if BR[k].lvl % 2 == 1 { *reorder = true; }
    }
    return m;
}

/// UAX #9 rule L2 over the runs: visual order into `BVIS`.
fn fbVisual(n: int) {
    let hi = 0;
    let lo = 99;
    for k in 0..n {
        if BR[k].lvl > hi { hi = BR[k].lvl; }
        if BR[k].lvl % 2 == 1 && BR[k].lvl < lo { lo = BR[k].lvl; }
    }
    let l = hi;
    while l >= lo {
        let k = 0;
        while k < n {
            if BR[BVIS[k]].lvl >= l {
                let e = k;
                while e + 1 < n && BR[BVIS[e + 1]].lvl >= l { e += 1; }
                let x = k;
                let y = e;
                while x < y {
                    let t = BVIS[x];
                    BVIS[x] = BVIS[y];
                    BVIS[y] = t;
                    x += 1;
                    y -= 1;
                }
                k = e + 1;
            } else {
                k += 1;
            }
        }
        l -= 1;
    }
}

/// `TextMode.letterSp` while a shaped run is measured or drawn (it is zeroed there: joined and right-to-left text is not spaced).
#[singleton]
let SHAPED_LS: f32;

fn shapeSet(f: Font, r: BRun) {
    if r.script != 0 || r.lvl % 2 == 1 {
        fontShape(f, r.lvl % 2 == 1, scriptTag(r.script));
        SHAPED_LS = TM.letterSp;
        TM.letterSp = 0.0;
    }
}

fn shapeReset(f: Font, r: BRun) {
    if r.script != 0 || r.lvl % 2 == 1 {
        fontShape(f, false, "Latn");
        TM.letterSp = SHAPED_LS;
    }
}

/// Width of UTF-8 `msg` for layout: the sum of per-glyph advances (the same widths the GL glyph
/// atlas draws with), and `TTF_SizeUTF8` on each run of non-ASCII bytes. With a fallback chain
/// (`fontFallback`) or a complex script (`textShaping`) each run is measured with its own font and
/// shaping, exactly as `p2Text` draws it. Needs SDL_ttf, no window or GL
/// (unlike `textSize`, whose ASCII path builds the atlas). Zero for an empty font.
pub fn textWidth(font: Font, msg: []u8, bold: bool): f32 {
    let re = false;
    let n = fbRuns(font.raw, msg, &re);
    if n == 0 {
        return textWidthPlain(font, msg, bold);
    }
    let w: f32 = 0.0;
    let ei = fbOf(font.raw);
    for k in 0..n {
        let rf = font;
        if ei >= 0 { rf = fbFont(ei, BR[k].pick); }
        let r = BR[k];
        shapeSet(rf, r);
        w += textWidthPlain(rf, msg[r.a..r.b], bold);
        shapeReset(rf, r);
    }
    return w;
}

fn textWidthPlain(font: Font, msg: []u8, bold: bool): f32 {
    if font.raw == 0 {
        return 0;
    }
    let slot = advFor(font, bold);
    let sc = strikeScale(font.raw);
    let pen = 0;
    // letter / word spacing is summed apart from the integer advances (zero work when both are 0)
    let ls = TM.letterSp;
    let ws = TM.wordSp;
    let sp = ls != 0.0 || ws != 0.0;
    let extra: f32 = 0.0;
    let i = 0;
    while i < msg.len {
        let b = int(msg[i]);
        if b >= 32 && b <= 126 {
            if sp {
                extra += ls;
                if b == 32 { extra += ws; }
            }
            if TM.tabular && b >= 48 && b <= 57 {
                pen += strikePx(int(advTabs[slot].dmax), sc);
            } else {
                pen += strikePx(int(advTabs[slot].adv[b - 32]), sc);
            }
            i += 1;
        } else if b < 128 {
            i += 1;
        } else {
            let j = i;
            while j < msg.len && int(msg[j]) >= 128 {
                j += 1;
            }
            let w: i32 = 0;
            let h: i32 = 0;
            let style: i32 = 0;
            if bold {
                style = TTF_STYLE_BOLD;
            }
            TTF_SetFontStyle(font.raw, style);
            // cstrBytes holds 1023 bytes: measure a longer run in pieces cut at code point starts (shaping does not span a cut)
            let c = i;
            while c < j {
                let e = j;
                if ls != 0.0 {
                    // letter-spaced: one code point per piece, as `p2TextRun` draws it
                    e = c + 1;
                    while e < j && int(msg[e]) >= 128 && int(msg[e]) < 192 { e += 1; }
                    extra += ls;
                } else if e - c > 1000 {
                    e = c + 1000;
                    while e > c && int(msg[e]) >= 128 && int(msg[e]) < 192 { e -= 1; }
                }
                TTF_SizeUTF8(font.raw, cstrBytes(msg[c..e]), &w as ptr, &h as ptr);
                pen += strikePx(int(w), sc);
                c = e;
            }
            i = j;
        }
    }
    return f32(pen) + extra;
}

/// Width of `msg[a..b]` set in run `r` (its chain font and shaping), as `p2Text` lays it out.
fn runWidth(font: Font, ei: int, r: BRun, msg: []u8, a: int, b: int, bold: bool): f32 {
    let rf = font;
    if ei >= 0 { rf = fbFont(ei, r.pick); }
    shapeSet(rf, r);
    let w = textWidthPlain(rf, msg[a..b], bold);
    shapeReset(rf, r);
    return w;
}

/// Bidi runs of `msg` when some run is right to left (visual order in `BVIS`), else 0: then drawing order is
/// logical and plain `textWidth` of a prefix is the caret x.
fn bidiRuns(font: Font, msg: []u8): int {
    let re = false;
    let n = fbRuns(font.raw, msg, &re);
    if n == 0 || !re { return 0; }
    fbVisual(n);
    return n;
}

/// Whether `msg` is drawn reordered (it holds a right-to-left run), so caret and selection need `textCaretX` and friends.
pub fn textBidi(font: Font, msg: []u8): bool {
    return bidiRuns(font, msg) > 0;
}

/// Visual x of the caret before byte `i` of `msg` as `p2Text` draws it. Inside a right-to-left run x decreases
/// as `i` grows. At a boundary between runs the caret belongs to the run of the preceding character
/// (index 0: the first run in logical order). Plain text: `textWidth(msg[0..i])`.
pub fn textCaretX(font: Font, msg: []u8, bold: bool, i: int): f32 {
    let n = bidiRuns(font, msg);
    if n == 0 { return textWidth(font, msg[0..i], bold); }
    let ei = fbOf(font.raw);
    let ki = 0;
    for k in 0..n {
        if BR[k].a < i && i <= BR[k].b { ki = k; }
    }
    let pen: f32 = 0.0;
    for v in 0..n {
        let k = BVIS[v];
        let r = BR[k];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        if k == ki {
            let inside = runWidth(font, ei, r, msg, r.a, i, bold);
            return if r.lvl % 2 == 1 { pen + w - inside } else { pen + inside };
        }
        pen += w;
    }
    return pen;
}

/// The caret byte index nearest to visual x `x` (0 is the line's left edge) in reordered `msg`; -1 when `msg` has no
/// right-to-left run (use the logical hit test).
pub fn textIndexAt(font: Font, msg: []u8, bold: bool, x: f32): int {
    let n = bidiRuns(font, msg);
    if n == 0 { return -1; }
    let ei = fbOf(font.raw);
    let pen: f32 = 0.0;
    for v in 0..n {
        let r = BR[BVIS[v]];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        if x < pen + w || v == n - 1 {
            let rtl = r.lvl % 2 == 1;
            let lx = if rtl { pen + w - x } else { x - pen };
            if lx <= 0.0 { return r.a; }
            if lx >= w { return r.b; }
            // bisect the code point boundaries of the run on the (monotonic) prefix width: O(n log n) in the run
            let lo = r.a;
            let hi = r.b;
            while true {
                let m = (lo + hi) / 2;
                while m > lo && int(msg[m]) >= 128 && int(msg[m]) < 192 { m -= 1; }
                if m <= lo {
                    m = lo + 1;
                    while m < hi && int(msg[m]) >= 128 && int(msg[m]) < 192 { m += 1; }
                    if m >= hi { break; }
                }
                if runWidth(font, ei, r, msg, r.a, m, bold) <= lx { lo = m; } else { hi = m; }
            }
            let wl = runWidth(font, ei, r, msg, r.a, lo, bold);
            let wh = runWidth(font, ei, r, msg, r.a, hi, bold);
            return if lx <= (wl + wh) / 2.0 { lo } else { hi };
        }
        pen += w;
    }
    return 0;
}

#[singleton]
let SELX: [64]f32;
#[singleton]
let SELW: [64]f32;

/// The visual rectangles (x, width; read with `selRectX` / `selRectW`) covering bytes `lo..hi` of `msg`: one per
/// intersected run in visual order, adjacent ones merged. Returns how many. Plain text gives one.
pub fn textSelRects(font: Font, msg: []u8, bold: bool, lo: int, hi: int): int {
    let n = bidiRuns(font, msg);
    if n == 0 {
        let xl = textWidth(font, msg[0..lo], bold);
        SELX[0] = xl;
        SELW[0] = textWidth(font, msg[0..hi], bold) - xl;
        return 1;
    }
    let ei = fbOf(font.raw);
    let cnt = 0;
    let pen: f32 = 0.0;
    for v in 0..n {
        let r = BR[BVIS[v]];
        let w = runWidth(font, ei, r, msg, r.a, r.b, bold);
        let ia = if lo > r.a { lo } else { r.a };
        let ib = if hi < r.b { hi } else { r.b };
        if ib > ia {
            let wa = runWidth(font, ei, r, msg, r.a, ia, bold);
            let wb = runWidth(font, ei, r, msg, r.a, ib, bold);
            let x0 = pen + wa;
            let x1 = pen + wb;
            if r.lvl % 2 == 1 {
                x0 = pen + w - wb;
                x1 = pen + w - wa;
            }
            if cnt > 0 && x0 - (SELX[cnt - 1] + SELW[cnt - 1]) < 1.0 && x0 - (SELX[cnt - 1] + SELW[cnt - 1]) > -1.0 {
                SELW[cnt - 1] = x1 - SELX[cnt - 1];
            } else {
                SELX[cnt] = x0;
                SELW[cnt] = x1 - x0;
                cnt += 1;
            }
        }
        pen += w;
    }
    return cnt;
}

pub fn selRectX(k: int): f32 { return SELX[k]; }
pub fn selRectW(k: int): f32 { return SELW[k]; }

/// Whether `font` or a font of its fallback chain has a glyph for code point `cp` (true when it cannot tell: an empty font, no SDL_ttf query).
pub fn fontHas(font: Font, cp: int): bool {
    if font.raw == 0 || fontFns.glyph == 0 || fbHas(font.raw, cp) {
        return true;
    }
    let ei = fbOf(font.raw);
    if ei >= 0 {
        for k in 0..FB[ei].n {
            if fbHas(FB[ei].alt[k], cp) {
                return true;
            }
        }
    }
    return false;
}

/// `TTF_FontHeight`: the natural line height of `font` (0 for an empty font).
pub fn fontLine(font: Font): int {
    if font.raw == 0 {
        return 0;
    }
    return strikePx(int(TTF_FontHeight(font.raw)), strikeScale(font.raw));
}

/// `TTF_FontAscent`: baseline distance from the top of a line (0 for an empty font).
pub fn fontAscent(font: Font): int {
    if font.raw == 0 {
        return 0;
    }
    return strikePx(int(TTF_FontAscent(font.raw)), strikeScale(font.raw));
}

/// Like `bakeText`, emboldened. The caller owns the texture.
pub fn bakeTextBold(font: Font, msg: string): Texture {
    textBold = true;
    let tex = bakeText(font, msg);
    textBold = false;
    return tex;
}

/// Draw UTF-8 bytes. ASCII comes from the glyph atlas. Other strings reuse a cached raster.
pub fn drawTextBytes(font: Font, pos: Vec2, msg: []u8) {
    drawTextScaled(font, pos, msg, 1.0);
}

/// Draw `msg` in `color`, glyphs scaled by `scale` (GL only; the SDL path ignores `scale`).
/// `j3.gfx.paint.text` calls this.
pub fn p2Text(font: Font, pos: Vec2, msg: string, color: Color, scale: f32) {
    let bytes = []u8 { ptr: msg.ptr, len: msg.len };
    let re = false;
    let n = fbRuns(font.raw, bytes, &re);
    if n == 0 {
        p2TextRun(font, pos, msg, color, scale, BRun { a: 0, b: 0, pick: 0, script: 0, cls: 0, lvl: 0 });
        return;
    }
    // runs by font, script and bidi level, in visual order, laid end to end with the widths `textWidth` reports,
    // on one baseline. The runs live in globals: copy what the loop needs before anything can reuse them.
    if re { fbVisual(n); }
    let ei = fbOf(font.raw);
    let pen: f32 = 0.0;
    for v in 0..n {
        let r = BR[BVIS[v]];
        let rf = font;
        if ei >= 0 { rf = fbFont(ei, r.pick); }
        let dy = f32(fontAscent(font) - fontAscent(rf)) * scale;
        shapeSet(rf, r);
        let w = textWidthPlain(rf, bytes[r.a..r.b], textBold);
        shapeReset(rf, r);
        p2TextRun(rf, Vec2 { x: pos.x + pen * scale, y: pos.y + dy }, msg[r.a..r.b], color, scale, r);
        pen += w;
    }
}

/// One run: `r` carries the script and level SDL_ttf shapes it with (set on the font that rasterises, which is the HiDPI twin when there is one).
/// Under `TextMode.tabular` a run that would not be drawn from the glyph atlas (non-ASCII text, over `TEXT_CAP` bytes, or a
/// fixed-strike bitmap font) is cut at its ASCII digits: each digit is drawn alone, centred in the shared cell, and the rest
/// as before (shaping and kerning do not span a digit).
fn p2TextRun(font: Font, pos: Vec2, msg: string, color: Color, scale: f32, r: BRun) {
    // letter spacing is not applied to shaped runs (`shapeSet`), word spacing always is
    let lsr: f32 = 0.0;
    if r.script == 0 && r.lvl % 2 == 0 { lsr = TM.letterSp; }
    let spaced = TM.wordSp != 0.0 || lsr != 0.0;
    if ((TM.tabular && hasDigit(msg)) || spaced) && (!atlasOk([]u8 { ptr: msg.ptr, len: msg.len }) || strikeScale(font.raw) < 1.0) {
        let slot = advFor(font, textBold);
        let sc = strikeScale(font.raw);
        let cell = f32(strikePx(int(advTabs[slot].dmax), sc));
        let pen: f32 = 0.0;
        let a = 0;
        while a < msg.len {
            let dg = TM.tabular && isDigit(msg[a]);
            let b = a + 1;
            if spaced && !dg {
                // one code point at a time: its advance (spacing included) is what `textWidthPlain` adds
                while b < msg.len && int(msg[b]) >= 128 && int(msg[b]) < 192 { b += 1; }
            } else {
                while b < msg.len && (TM.tabular && isDigit(msg[b])) == dg { b += 1; }
            }
            if dg {
                // alone and untabular: centred here instead of by `atlasDraw`
                let m = TM;
                m.tabular = false;
                let was = setTextMode(m);
                for k in a..b {
                    let adv = f32(strikePx(int(advTabs[slot].adv[int(msg[k]) - 32]), sc));
                    p2TextRaw(font, Vec2 { x: pos.x + (pen + (cell - adv) * 0.5) * scale, y: pos.y }, msg[k..k + 1], color, scale, r);
                    pen += cell + lsr;
                }
                setTextMode(was);
            } else {
                let seg = msg[a..b];
                p2TextRaw(font, Vec2 { x: pos.x + pen * scale, y: pos.y }, seg, color, scale, r);
                shapeSet(font, r);
                pen += textWidthPlain(font, []u8 { ptr: seg.ptr, len: seg.len }, textBold);
                shapeReset(font, r);
            }
            a = b;
        }
        return;
    }
    p2TextRaw(font, pos, msg, color, scale, r);
}

fn isDigit(b: u8): bool {
    return b >= 48 && b <= 57;
}

fn hasDigit(msg: string): bool {
    for i in 0..msg.len {
        if isDigit(msg[i]) { return true; }
    }
    return false;
}

fn p2TextRaw(font: Font, pos: Vec2, msg: string, color: Color, scale: f32, r: BRun) {
    let was = platform.color;
    platform.color = color;
    // glyphs rasterised at the physical size (letterbox, `setUiScale` and high DPI), drawn back at 1 / ratio
    let ratio: f32 = 1.0;
    let tf = font;
    // (not under `setVirtualSize`: its scale changes while the window is dragged, which would reopen the font each frame)
    if platform.gl && VIRT_W < 1 {
        tf = twinFor(font, platform.ui_scale * fbRect().s, &ratio);
    }
    // spacing is in layout px: `atlasDraw` multiplies by `scale / ratio`, so hand it `ratio` times more
    let tm = TM;
    if ratio != 1.0 {
        TM.letterSp = tm.letterSp * ratio;
        TM.wordSp = tm.wordSp * ratio;
    }
    shapeSet(tf, r);
    drawTextScaled(tf, pos, []u8 { ptr: msg.ptr, len: msg.len }, scale / ratio);
    shapeReset(tf, r);
    TM = tm;
    platform.color = was;
}

/// Gradient fill for the text being drawn: ramp row plus one, and the gradient line in view-local
/// pixels. `row` 0 is off.
struct TextGrad {
    row: f32;
    x0: f32;
    y0: f32;
    x1: f32;
    y1: f32;
}

#[singleton]
let TG: TextGrad;

/// `p2Text` filled from ramp `row` (see `j3.gfx.paint.gradient`) along the line `from` to `to`
/// (already in view-local pixels); `color` supplies the alpha. Text that is not in the glyph atlas
/// takes the gradient the same way. `j3.gfx.paint.textGradient` calls this.
pub fn p2TextGradient(font: Font, pos: Vec2, msg: string, color: Color, scale: f32, bold: bool, row: int, from: Vec2, to: Vec2) {
    TG = TextGrad { row: f32(row + 1), x0: from.x, y0: from.y, x1: to.x, y1: to.y };
    if bold {
        p2TextBold(font, pos, msg, color, scale);
    } else {
        p2Text(font, pos, msg, color, scale);
    }
    TG = TextGrad { row: 0.0, x0: 0.0, y0: 0.0, x1: 0.0, y1: 0.0 };
}

/// `p2Text` with the glyphs emboldened (`TTF_STYLE_BOLD`), for `j3.gfx.paint.textBold`.
pub fn p2TextBold(font: Font, pos: Vec2, msg: string, color: Color, scale: f32) {
    textBold = true;
    p2Text(font, pos, msg, color, scale);
    textBold = false;
}

/// `drawTextBytes` with a glyph scale.
fn drawTextScaled(font: Font, pos: Vec2, msg: []u8, scale: f32) {
    if msg.len == 0 {
        return;
    }
    applyFontStyle(font);
    if atlasOk(msg) && strikeScale(font.raw) >= 1.0 {
        let glyph = atlasFor(font);
        if glyph >= 0 {
            atlasDraw(glyph, pos, msg, scale);
            return;
        }
    }
    // whole-string rasters: same 1:1 snapping as `atlasDraw`
    let at = pos;
    let qs = scale;
    let k = texelScale(scale);
    if k > 0.0 {
        at = Vec2 { x: snapPx(pos.x, k), y: snapPx(pos.y, k) };
        qs = 1.0 / k;
    }
    if msg.len > TEXT_CAP {
        let fresh = bakeTextBytes(font, msg);
        drawTextureAt(fresh, at, Vec2 { x: f32(fresh.w) * qs, y: f32(fresh.h) * qs });
        destroyTexture(fresh);
        return;
    }
    let hit = textFind(font.raw, msg);
    if hit >= 0 {
        textCache[hit].used = frameCount();
        let t = textCache[hit].tex;
        drawTextureAt(t, at, Vec2 { x: f32(t.w) * qs, y: f32(t.h) * qs });
        return;
    }
    let cacheSlot = textVictim();
    let baked = bakeTextBytes(font, msg);
    textRemember(cacheSlot, font, msg, baked);
    drawTextureAt(baked, at, Vec2 { x: f32(baked.w) * qs, y: f32(baked.h) * qs });
}

/// Close a font and drop its cached rasters and glyph atlas.
pub fn destroyFont(font: Font) {
    if font.raw != 0 {
        if PROF.font.raw == font.raw { PROF.font = Font { raw: 0 }; }
        textDropFont(font.raw);
        atlasDrop(font.raw);
        fbDrop(font.raw);
        TTF_CloseFont(font.raw);
        for i in 0..FONT_SRC_N {
            if FONT_SRC[i].raw == font.raw {
                let tw = FONT_SRC[i].twin;
                if tw != 0 {
                    textDropFont(tw);
                    atlasDrop(tw);
                    TTF_CloseFont(tw);
                }
                FONT_SRC_N -= 1;
                FONT_SRC[i] = FONT_SRC[FONT_SRC_N];
                break;
            }
        }
    }
}

/// The runs of `msg` in visual order as (byte start, byte end, level) triples into `out`; returns the run
/// count, 0 when `msg` has no right-to-left run (then it is drawn in logical order). For tests and tools.
pub fn textVisualRuns(font: Font, msg: []u8, out: []int): int {
    let n = bidiRuns(font, msg);
    let m = 0;
    while m < n && 3 * m + 2 < out.len {
        let r = BR[BVIS[m]];
        out[3 * m] = r.a;
        out[3 * m + 1] = r.b;
        out[3 * m + 2] = r.lvl;
        m += 1;
    }
    return m;
}
