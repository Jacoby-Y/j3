// Part of j3.game (script tags, bidi classes, run splitting and reordering); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Complex scripts SDL_ttf (HarfBuzz) shapes once it is told the script: index into `SCRIPTS`, 0 = nothing special.
fn scriptTag(i: int): string {
    if i == 1 { return "Arab"; }
    if i == 2 { return "Hebr"; }
    if i == 3 { return "Deva"; }
    if i == 4 { return "Beng"; }
    if i == 5 { return "Thai"; }
    if i == 6 { return "Taml"; }
    if i == 7 { return "Telu"; }
    return "Latn";
}

#[singleton]
let SHAPE_OK: int = -1;

fn scriptOf(cp: int): int {
    if cp < 0x590 || SHAPE_OK == 0 {
        return 0;
    }
    if SHAPE_OK < 0 {
        SHAPE_OK = 0;
        if textShaping() {
            SHAPE_OK = 1;
        }
        return scriptOf(cp);
    }
    if cp <= 0x5FF || (cp >= 0xFB1D && cp <= 0xFB4F) {
        return 2;
    }
    if (cp >= 0x600 && cp <= 0x77F) || (cp >= 0x8A0 && cp <= 0x8FF) || (cp >= 0xFB50 && cp <= 0xFDFF) || (cp >= 0xFE70 && cp <= 0xFEFF) {
        return 1;
    }
    if cp >= 0x900 && cp <= 0x97F { return 3; }
    if cp >= 0x980 && cp <= 0x9FF { return 4; }
    if cp >= 0xB80 && cp <= 0xBFF { return 6; }
    if cp >= 0xC00 && cp <= 0xC7F { return 7; }
    if cp >= 0xE00 && cp <= 0xE7F { return 5; }
    return 0;
}

/// One run of text drawn by one chain font, with one script and one bidi level.
struct BRun {
    a: int;
    b: int;
    pick: int;
    script: int;
    /// UAX #9 bidi class (`BC_*`); resolved in place by `bidiResolve`.
    cls: int;
    /// UAX #9 embedding level (odd = right to left).
    lvl: int;
}

#[singleton]
let BR: [1024]BRun;
#[singleton]
let BVIS: [1024]int;

const BC_L: int = 0;
const BC_R: int = 1;
const BC_AL: int = 2;
const BC_EN: int = 3;
const BC_AN: int = 4;
const BC_ES: int = 5;
const BC_ET: int = 6;
const BC_CS: int = 7;
/// Everything else (spaces, punctuation, symbols): the neutrals.
const BC_ON: int = 8;

/// Bidi class of a code point. Ranges only for what the renderer draws (Latin, Hebrew, Arabic and the Indic/Thai
/// scripts it shapes); other code points above ASCII count as letters, except the general punctuation blocks.
fn bidiClass(cp: int, script: int): int {
    if cp < 128 {
        if (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) { return BC_L; }
        if cp >= 48 && cp <= 57 { return BC_EN; }
        if cp == 43 || cp == 45 { return BC_ES; }
        if cp >= 35 && cp <= 37 { return BC_ET; }
        if cp == 44 || cp == 46 || cp == 47 || cp == 58 { return BC_CS; }
        return BC_ON;
    }
    if script == 1 {
        if cp >= 0x660 && cp <= 0x669 { return BC_AN; }
        if cp == 0x66B || cp == 0x66C { return BC_AN; }
        if cp >= 0x6F0 && cp <= 0x6F9 { return BC_EN; }
        if cp == 0x66A { return BC_ET; }
        if cp == 0x60C || cp == 0x60D { return BC_CS; }
        return BC_AL;
    }
    if script == 2 { return BC_R; }
    if cp == 0xA0 { return BC_CS; }
    if cp == 0xB0 || cp == 0xB1 || (cp >= 0x2030 && cp <= 0x2034) || (cp >= 0x20A0 && cp <= 0x20CF) { return BC_ET; }
    if cp == 0xB2 || cp == 0xB3 || cp == 0xB9 { return BC_EN; }
    if cp == 0x2212 { return BC_ES; }
    if (cp >= 0x2000 && cp <= 0x206F) || (cp >= 0xA0 && cp <= 0xBF) || (cp >= 0x3000 && cp <= 0x303F) { return BC_ON; }
    return BC_L;
}

/// Nonspacing marks (W1): Arabic harakat and Quranic marks, Hebrew points. They take the class of the run before them.
fn bidiMark(cp: int): bool {
    return (cp >= 0x64B && cp <= 0x65F) || cp == 0x670 || (cp >= 0x6D6 && cp <= 0x6DC) || (cp >= 0x6DF && cp <= 0x6E4) || cp == 0x6E7 || cp == 0x6E8 || (cp >= 0x6EA && cp <= 0x6ED) || (cp >= 0x591 && cp <= 0x5BD) || cp == 0x5BF || cp == 0x5C1 || cp == 0x5C2 || cp == 0x5C4 || cp == 0x5C5 || cp == 0x5C7;
}

#[singleton]
let BR_WARNED: bool;

fn isStrong(c: int): bool {
    return c == BC_L || c == BC_R || c == BC_AL;
}

/// UAX #9 on the runs `BR[0..nr)`, one paragraph (the base direction is the first strong run): weak types W2-W7,
/// neutrals N1/N2, levels I1/I2. Runs of one class stand for their code points, so this is linear in the runs.
/// Not done: explicit embeddings/overrides/isolates (X rules), N0 bracket pairs, W1 (marks follow the font run
/// before them, so a mark takes its base's class), and RLM/LRM (they count as the preceding run).
fn bidiResolve(nr: int) {
    let base = 0;
    for k in 0..nr {
        if isStrong(BR[k].cls) {
            if BR[k].cls != BC_L { base = 1; }
            break;
        }
    }
    // W2: EN after AL is AN. W3: AL is R. (`last` is the last strong class, sos at first)
    let last = BC_L;
    if base == 1 { last = BC_R; }
    for k in 0..nr {
        let c0 = BR[k].cls;
        if isStrong(c0) { last = c0; }
        if c0 == BC_EN && last == BC_AL { BR[k].cls = BC_AN; }
    }
    for k in 0..nr {
        if BR[k].cls == BC_AL { BR[k].cls = BC_R; }
    }
    // W4: a single ES between two EN is EN; a single CS between two numbers of one type takes that type.
    for k in 1..nr - 1 {
        let c1 = BR[k].cls;
        let p = BR[k - 1].cls;
        if (c1 == BC_ES || c1 == BC_CS) && p == BR[k + 1].cls && (p == BC_EN || (p == BC_AN && c1 == BC_CS)) {
            BR[k].cls = p;
        }
    }
    // W5: ET next to EN is EN (forward, then backward, so a chain of ET runs follows).
    for k in 1..nr {
        if BR[k].cls == BC_ET && BR[k - 1].cls == BC_EN { BR[k].cls = BC_EN; }
    }
    let q = nr - 2;
    while q >= 0 {
        if BR[q].cls == BC_ET && BR[q + 1].cls == BC_EN { BR[q].cls = BC_EN; }
        q -= 1;
    }
    // W6: leftover separators and terminators are neutral. W7: EN after L (or sos L) is L.
    last = BC_L;
    if base == 1 { last = BC_R; }
    for k in 0..nr {
        let c2 = BR[k].cls;
        if c2 == BC_ES || c2 == BC_ET || c2 == BC_CS { BR[k].cls = BC_ON; }
        if isStrong(c2) { last = c2; }
        if c2 == BC_EN && last == BC_L { BR[k].cls = BC_L; }
    }
    // N1/N2: neutrals between the same direction (EN and AN count as R) take it, else the base direction.
    // I1/I2: a level from the direction and the base level.
    for k in 0..nr {
        let c3 = BR[k].cls;
        let dir = 1;
        if c3 == BC_L { dir = 0; }
        if c3 == BC_ON {
            let before = base;
            let q1 = k - 1;
            while q1 >= 0 && BR[q1].cls == BC_ON { q1 -= 1; }
            if q1 >= 0 {
                before = 1;
                if BR[q1].cls == BC_L { before = 0; }
            }
            let after = base;
            let q2 = k + 1;
            while q2 < nr && BR[q2].cls == BC_ON { q2 += 1; }
            if q2 < nr {
                after = 1;
                if BR[q2].cls == BC_L { after = 0; }
            }
            dir = base;
            if before == after { dir = before; }
        }
        if c3 == BC_EN || c3 == BC_AN {
            BR[k].lvl = 2;
        } else if dir == 0 {
            BR[k].lvl = 2 * base;
        } else {
            BR[k].lvl = 1;
        }
    }
}

/// Split `msg` into `BR[0..n)` by chain font, script and bidi level (neighbours with all three equal are
/// merged); returns n, or 0 when the primary alone draws `msg` in one go (no chain hit, no complex script),
/// so ordinary text never takes this path. `*reorder` is true when some run is right to left.
fn fbRuns(font: ptr, msg: []u8, reorder: &bool): int {
    *reorder = false;
    let ei = -1;
    if FB_N > 0 {
        ei = fbOf(font);
    }
    // quick scan: any code point that needs the run path?
    let need = false;
    let i = 0;
    while i < msg.len && !need {
        if int(msg[i]) >= 128 {
            let w0: int = 1;
            let c0 = fbCp(msg, i, &w0);
            if scriptOf(c0) != 0 || (ei >= 0 && !fbSticky(c0) && fbPick(ei, c0) > 0) {
                need = true;
            }
            i += w0;
        } else {
            i += 1;
        }
    }
    if !need {
        return 0;
    }
    let nr = 0;
    let rtl = false;
    i = 0;
    while i < msg.len {
        let n: int = 1;
        let cp = fbCp(msg, i, &n);
        let pick = 0;
        let sc = 0;
        let cl = BC_ON;
        if cp < 128 || !fbSticky(cp) {
            sc = scriptOf(cp);
            cl = bidiClass(cp, sc);
            if nr > 0 && bidiMark(cp) { cl = BR[nr - 1].cls; }
            if ei >= 0 && cp >= 128 {
                pick = fbPick(ei, cp);
            }
        } else if nr > 0 {
            pick = BR[nr - 1].pick;
            sc = BR[nr - 1].script;
            cl = BR[nr - 1].cls;
        }
        // a space or digit joins a neighbouring run of the same font; script/class are settled after
        // (a lone ES/CS is its own run: W4 needs single separators)
        if nr > 0 && BR[nr - 1].pick == pick && BR[nr - 1].script == sc && BR[nr - 1].cls == cl && cl != BC_ES && cl != BC_CS {
            BR[nr - 1].b = i + n;
        } else if nr < 1024 {
            BR[nr] = BRun { a: i, b: i + n, pick: pick, script: sc, cls: cl, lvl: 0 };
            nr += 1;
        } else {
            // past the cap the tail joins the last run: its order may be wrong, so say so once
            if !BR_WARNED {
                BR_WARNED = true;
                let w = "warning: text has more than 1024 bidi runs; the rest is laid out as one run\n";
                write(2, w.ptr as ptr, w.len);
            }
            BR[nr - 1].b = i + n;
        }
        if cl == BC_R || cl == BC_AL || cl == BC_AN { rtl = true; }
        i += n;
    }
    // no R, AL or AN anywhere (a font fallback or Latin-1 text): every level is 0, nothing to resolve
    if rtl {
        bidiResolve(nr);
    } else {
        for k in 0..nr { BR[k].lvl = 0; }
    }
    // merge neighbours that now match
    let m = 0;
    for k in 0..nr {
        if m > 0 && BR[m - 1].pick == BR[k].pick && BR[m - 1].script == BR[k].script && BR[m - 1].lvl == BR[k].lvl {
            BR[m - 1].b = BR[k].b;
        } else {
            BR[m] = BR[k];
            m += 1;
        }
    }
    for k in 0..m {
        BVIS[k] = k;
        if BR[k].lvl % 2 == 1 { *reorder = true; }
    }
    return m;
}

/// UAX #9 rule L2 over the runs: visual order into `BVIS`.
fn fbVisual(n: int) {
    let hi = 0;
    let lo = 99;
    for k in 0..n {
        if BR[k].lvl > hi { hi = BR[k].lvl; }
        if BR[k].lvl % 2 == 1 && BR[k].lvl < lo { lo = BR[k].lvl; }
    }
    let l = hi;
    while l >= lo {
        let k = 0;
        while k < n {
            if BR[BVIS[k]].lvl >= l {
                let e = k;
                while e + 1 < n && BR[BVIS[e + 1]].lvl >= l { e += 1; }
                let x = k;
                let y = e;
                while x < y {
                    let t = BVIS[x];
                    BVIS[x] = BVIS[y];
                    BVIS[y] = t;
                    x += 1;
                    y -= 1;
                }
                k = e + 1;
            } else {
                k += 1;
            }
        }
        l -= 1;
    }
}

/// `TextMode.letterSp` while a shaped run is measured or drawn (it is zeroed there: joined and right-to-left text is not spaced).
#[singleton]
let SHAPED_LS: f32;

fn shapeSet(f: Font, r: BRun) {
    if r.script != 0 || r.lvl % 2 == 1 {
        fontShape(f, r.lvl % 2 == 1, scriptTag(r.script));
        SHAPED_LS = TM.letterSp;
        TM.letterSp = 0.0;
    }
}

fn shapeReset(f: Font, r: BRun) {
    if r.script != 0 || r.lvl % 2 == 1 {
        fontShape(f, false, "Latn");
        TM.letterSp = SHAPED_LS;
    }
}
