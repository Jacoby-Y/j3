// Part of j3.game (batched 2D painter state: `Hud`, `Paint2`, the shared singletons); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Screen-space GL state for 2D drawing on an `initGl` window. Every 2D draw (`drawRect`,
/// `drawTexture*`, `drawText`, `j3.gfx.paint`) becomes one instance in a shared buffer and
/// is drawn by `p2Flush` as a single instanced draw.
struct Hud {
    /// True after the shader and buffers exist.
    ready: bool;
    /// Shader program.
    prog: u32;
    /// Vertex array: unit quad plus the instance buffer.
    vao: u32;
    /// Instance buffer.
    vbo: u32;
    /// 1×1 white texture, bound when a batch has no texture.
    white: u32;
    /// glViewport.
    viewport: ptr;
    /// glEnable.
    enable: ptr;
    /// glDisable.
    disable: ptr;
    /// glBlendFunc.
    blendFunc: ptr;
    blendSeparate: ptr;
    /// glUseProgram.
    useProgram: ptr;
    /// glBindVertexArray.
    bindVertexArray: ptr;
    /// glBindTexture.
    bindTexture: ptr;
    /// glUniform1i.
    uniform1i: ptr;
    /// glUniform2f.
    uniform2f: ptr;
    /// glUniform3f.
    uniform3f: ptr;
    /// glUniform4f.
    uniform4f: ptr;
    /// Two rows of RG32F points on texture unit 2, avoiding fragment uniform limits.
    shapes: u32;
    /// uShapeInfo, uMaskBox, uMask locations.
    uShapeInfo: i32;
    uClipN: i32;
    /// uClipN holds counts that are not zero (the uniform is only written when it has to change).
    ckLive: bool;
    uMaskBox: i32;
    uMask: i32;
    /// glActiveTexture.
    activeTexture: ptr;
    /// glGenTextures.
    genTextures: ptr;
    /// glTexImage2D.
    texImage2D: ptr;
    /// glTexSubImage2D.
    texSubImage2D: ptr;
    /// glPixelStorei.
    pixelStorei: ptr;
    /// glTexParameteri.
    texParameteri: ptr;
    /// glDeleteTextures.
    deleteTextures: ptr;
    /// glScissor.
    scissor: ptr;
    /// glBindBuffer.
    bindBuffer: ptr;
    /// glBufferData.
    bufferData: ptr;
    /// glDrawArraysInstanced.
    drawInstanced: ptr;
    /// uScreen location.
    uScreen: i32;
    /// uOrigin location: bottom-left of the letterbox rect, which `gl_FragCoord` is offset by.
    uOrigin: i32;
    /// uRA and uRB locations: the two rows of the rotation matrix.
    uRA: i32;
    uRB: i32;
    /// Gradient ramp atlas (`RAMP_W` x `RAMP_ROWS`, unit 1).
    ramp: u32;
}

/// HUD renderer. Zero until the first GL draw.
#[singleton]
let HUD: Hud;

/// Floats in one instance (64 bytes).
const P2_STRIDE: int = 16;
/// Instance kinds, as the shader sees them.
const P2_RECT: int = 0;
const P2_TEX: int = 1;
/// Gradient ramp atlas size: one baked color ramp per row.
pub const RAMP_W: int = 256;
pub const RAMP_ROWS: int = 64;

/// The queued instances and the state they were queued under.
struct Paint2 {
    /// Instance floats (`malloc`ed, grown by doubling, kept for the life of the program).
    buf: ptr;
    /// Instances `buf` can hold.
    cap: int;
    /// Instances queued.
    n: int;
    /// Texture of the queued textured instances (0: none yet).
    tex: u32;
    /// Clip active, and the clip rect in view-local logical pixels.
    clipOn: bool;
    cx0: f32;
    cy0: f32;
    cx1: f32;
    cy1: f32;
    /// Views pushed; the current view rect in window logical pixels (valid when `depth > 0`).
    depth: int;
    vx: f32;
    vy: f32;
    vw: f32;
    vh: f32;
    /// A rotation applies after the view transform: `x' = ra x + rc y + rx`, `y' = rb x + rd y + ry`
    /// (view-local logical pixels), set by `p2Affine`.
    rotOn: bool;
    ra: f32;
    rb: f32;
    rc: f32;
    rd: f32;
    rx: f32;
    ry: f32;
    /// Shape clips (`p2Shape`): two outlines, their point counts (0 none) and fill rules (1 even-odd).
    sh0: ptr;
    sn0: int;
    sr0: f32;
    sh1: ptr;
    sn1: int;
    sr1: f32;
    /// Clip shapes (`p2ClipShapes`): count (at most 4), their points (rows of 128 floats) and point counts.
    ckn: int;
    ckp: ptr;
    ck0: int;
    ck1: int;
    ck2: int;
    ck3: int;
    /// Alpha mask (`p2Mask`): 0 none, 1 linear, 2 radial; ramp row, angle, and the box in view-local px.
    mk: int;
    mrow: f32;
    mang: f32;
    mx: f32;
    my: f32;
    mw: f32;
    mh: f32;
}

#[singleton]
let P2: Paint2;
/// `p2Watch` is on, and the hash of what was queued under it (`p2Watched`).
#[singleton]
let P2_WATCH: bool;
#[singleton]
let P2_SUM: u64;
/// Saved view rects, four floats each.
#[singleton]
let P2_VIEWS: [32]f32;
