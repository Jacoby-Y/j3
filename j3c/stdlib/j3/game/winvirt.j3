// Part of j3.game (window position and size, virtual size, ui scale, timing); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Maximize or restore a windowed window.
pub fn setMaximized(on: bool) {
    if platform.window == 0 { return; }
    if on { sdl.SDL_MaximizeWindow(platform.window); } else { sdl.SDL_RestoreWindow(platform.window); }
    syncWindowSize();
}

/// Window top-left in desktop coordinates; (0, 0) before the window exists. `j3.app` saves it for hot restarts.
pub fn windowPos(): Vec2 {
    if platform.window == 0 { return Vec2 { x: 0.0, y: 0.0 }; }
    let x: i32 = 0;
    let y: i32 = 0;
    sdl.SDL_GetWindowPosition(platform.window, &x as ptr, &y as ptr);
    return Vec2 { x: f32(x), y: f32(y) };
}

/// Move the window's top-left to desktop coordinates (x, y).
pub fn setWindowPos(x: int, y: int) {
    if platform.window != 0 { sdl.SDL_SetWindowPosition(platform.window, i32(x), i32(y)); }
}

/// Center the window on its monitor.
pub fn centerWindow() {
    if platform.window != 0 { centerOn(currentDisplay()); }
}

/// Size to lay out and draw in: the virtual size once `setVirtualSize` is on (the same at any
/// window size), else the window size in pixels.
pub fn windowSize(): Vec2 {
    if VIRT_W > 0 { return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) }; }
    let k = dpiNow();
    return Vec2 { x: f32(platform.win_w) / k, y: f32(platform.win_h) / k };
}

/// `dpiScale`, but 1 while painting into an offscreen target (its pixels are its own).
fn dpiNow(): f32 {
    if P2_SURFACE_N > 0 { return 1.0; }
    return DPI;
}

/// Size the 3D side works in: the virtual size, else the drawable in physical pixels (`windowSize`
/// divided by `dpiScale` is the logical size). Equal to `windowSize` unless `setHiDpi` or `J3_UI_SCALE` is on.
pub fn drawSize(): Vec2 {
    if VIRT_W > 0 { return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) }; }
    return Vec2 { x: f32(platform.win_w), y: f32(platform.win_h) };
}

/// Draw at a fixed `w` by `h` size whatever the window is, letterboxed: everything (2D, 3D,
/// `.j3ui`) is laid out and drawn in these pixels, and `windowSize` returns them. The drawing
/// area is the largest rect of that aspect ratio centered in the window, drawn at the real
/// resolution (text and shapes stay sharp), and the bars around it are cleared to black each
/// frame (`poll`). `mousePos` is in these pixels too: a pointer over a bar reads outside
/// `0..w` / `0..h` (negative or past the size), not clamped. `mouseDelta` and `screenshot` /
/// `readWindow` stay in window pixels. `setVirtualSize(0, 0)` turns it off (the default).
/// Call it once at startup, or again to change; a window resize needs nothing.
/// `screenRect` has the physical rect. `j3c doc testing` shows a letterboxed headless run.
pub fn setVirtualSize(w: int, h: int) {
    if w < 1 || h < 1 { VIRT_W = 0; VIRT_H = 0; } else { VIRT_W = w; VIRT_H = h; }
    if !platform.gl && platform.renderer != 0 {
        sdl.SDL_RenderSetLogicalSize(platform.renderer, i32(VIRT_W), i32(VIRT_H));
    }
}

/// The size set by `setVirtualSize`, or 0 by 0 while it is off.
pub fn virtualSize(): Vec2 {
    return Vec2 { x: f32(VIRT_W), y: f32(VIRT_H) };
}

/// Where the virtual screen is in the real window, in physical pixels (top-left origin): `x`, `y`
/// offset, `w`, `h` size, and `s` window pixels per virtual pixel. The whole window with `s` 1
/// while no virtual size is set. Use it only for code that needs real pixels (a `glViewport`,
/// a readback); `windowSize` and `mousePos` are in virtual pixels.
pub fn screenRect(): Rect {
    if P2_SURFACE_N > 0 { return fit(int(P2_SURFACE_SIZE[0]), int(P2_SURFACE_SIZE[1]), VIRT_W, VIRT_H); }
    return fit(platform.win_w, platform.win_h, VIRT_W, VIRT_H);
}

#[singleton]
let VIRT_W: int;
#[singleton]
let VIRT_H: int;
/// Letterbox scale while painting into an offscreen target (set by the outermost `p2SurfaceBegin`).
#[singleton]
let SURF_S: f32 = 1.0;

/// The area 2D drawing lands in, in the pixels of the current framebuffer, top-left origin: the
/// letterbox rect on the window, the whole target inside `p2SurfaceBegin`.
fn fbRect(): Rect {
    if P2_SURFACE_N > 0 { return Rect { x: 0, y: 0, w: platform.win_w, h: platform.win_h, s: SURF_S }; }
    let r = fit(platform.win_w, platform.win_h, VIRT_W, VIRT_H);
    if VIRT_W < 1 { r.s = DPI; }
    if LAYER_N > 0 { r.x = 0; r.y = 0; }
    return r;
}

/// Paint layers (`j3.gfx.post.beginLayer`) draw into a target the size of the rect: no offset inside.
#[singleton]
let LAYER_N: int;
pub fn p2LayerBegin() {
    p2Flush();
    if LAYER_N < 8 {
        let o = LAYER_N * 4;
        LAYER_BB[o] = 1000000000; LAYER_BB[o + 1] = 1000000000; LAYER_BB[o + 2] = -1000000000; LAYER_BB[o + 3] = -1000000000;
        LAYER_FULL[LAYER_N] = false;
        LAYER_SN[LAYER_N] = P2_SURFACE_N;
    }
    LAYER_N += 1;
}
pub fn p2LayerEnd() { p2Flush(); LAYER_N -= 1; }

/// Physical top-left bbox (x0, y0, x1, y1) of what the open layer drew, from every `p2Push` quad into it;
/// `LAYER_FULL` when something drew there without a quad (`p2LayerMarkFull`). `j3.gfx.post` sizes its passes by it.
#[singleton]
let LAYER_BB: [32]f32;
#[singleton]
let LAYER_FULL: [8]bool;
/// `P2_SURFACE_N` when the layer began: draws into a target opened inside the layer are not the layer's.
#[singleton]
let LAYER_SN: [8]int;

/// The open layer's drawn bounds into `out` (x0, y0, x1, y1 physical px, top-left, layer coords). False when the
/// layer must be treated as full (raw GL drew into it). x1 <= x0 means nothing was drawn.
pub fn p2LayerBounds(out: []f32): bool {
    if LAYER_N < 1 || LAYER_N > 8 { return false; }
    let o = (LAYER_N - 1) * 4;
    for i in 0..4 { out[i] = LAYER_BB[o + i]; }
    return !LAYER_FULL[LAYER_N - 1];
}

/// Something drew into the open layer outside `p2Push` (3D meshes, raw GL): its effects run full-size.
pub fn p2LayerMarkFull() {
    if LAYER_N > 0 && LAYER_N <= 8 && P2_SURFACE_N == LAYER_SN[LAYER_N - 1] { LAYER_FULL[LAYER_N - 1] = true; }
}

/// Grow the open layer's bounds by a logical quad (the space of `p2Push`), through the affine, clip and view.
fn p2LayerGrow(x: f32, y: f32, w: f32, h: f32) {
    let d = LAYER_N - 1;
    if P2_SURFACE_N != LAYER_SN[d] || LAYER_FULL[d] { return; }
    let qx0: f32 = 1000000000; let qy0: f32 = 1000000000; let qx1: f32 = -1000000000; let qy1: f32 = -1000000000;
    for i in 0..4 {
        let px = x + (if i % 2 == 1 { w } else { 0.0 });
        let py = y + (if i >= 2 { h } else { 0.0 });
        let qx = px; let qy = py;
        if P2.rotOn { qx = P2.ra * px + P2.rc * py + P2.rx; qy = P2.rb * px + P2.rd * py + P2.ry; }
        if qx < qx0 { qx0 = qx; } if qx > qx1 { qx1 = qx; }
        if qy < qy0 { qy0 = qy; } if qy > qy1 { qy1 = qy; }
    }
    if P2.clipOn {
        if qx0 < P2.cx0 { qx0 = P2.cx0; } if qy0 < P2.cy0 { qy0 = P2.cy0; }
        if qx1 > P2.cx1 { qx1 = P2.cx1; } if qy1 > P2.cy1 { qy1 = P2.cy1; }
        if qx1 <= qx0 || qy1 <= qy0 { return; }
    }
    if P2.depth > 0 {
        if qx0 < 0 { qx0 = 0; } if qy0 < 0 { qy0 = 0; }
        if qx1 > P2.vw { qx1 = P2.vw; } if qy1 > P2.vh { qy1 = P2.vh; }
        if qx1 <= qx0 || qy1 <= qy0 { return; }
        qx0 += P2.vx; qx1 += P2.vx; qy0 += P2.vy; qy1 += P2.vy;
    }
    let us = platform.ui_scale * fbRect().s;
    let o = d * 4;
    if qx0 * us < LAYER_BB[o] { LAYER_BB[o] = qx0 * us; }
    if qy0 * us < LAYER_BB[o + 1] { LAYER_BB[o + 1] = qy0 * us; }
    if qx1 * us > LAYER_BB[o + 2] { LAYER_BB[o + 2] = qx1 * us; }
    if qy1 * us > LAYER_BB[o + 3] { LAYER_BB[o + 3] = qy1 * us; }
}

/// GL y of the bottom of `fbRect` in the current framebuffer: below the bar on the window, 0 in a target.
fn fbBase(r: Rect): int {
    if P2_SURFACE_N > 0 || LAYER_N > 0 { return 0; }
    return platform.win_h - r.y - r.h;
}

/// `fbRect` as a GL bottom-left rect: what a copy from, or a viewport on, the current framebuffer takes.
pub fn p2FbRect(): GlRect {
    let r = fbRect();
    return GlRect { x: r.x, y: fbBase(r), w: r.w, h: r.h };
}

/// A virtual-pixel rect as a GL rect on the current framebuffer (rounded edges, no seams).
pub fn p2GlRect(x: f32, y: f32, w: f32, h: f32): GlRect {
    let r = fbRect();
    return glRect(r, fbBase(r) + r.y + r.h, x, y, w, h);
}

/// Scale all screen-space 2D drawing (rects, textures, text) and `mousePos` by `s` (clamped 0.25..4).
/// 2 draws everything twice as big. Reset to 1 for overlays that should stay put.
pub fn setUiScale(s: f32) {
    let v = s;
    if v < 0.25 { v = 0.25; }
    if v > 4.0 { v = 4.0; }
    platform.ui_scale = v;
}

/// Current 2D scale from `setUiScale`.
pub fn uiScale(): f32 {
    return platform.ui_scale;
}

/// Physical pixels per 2D drawing unit: `setUiScale`, the letterbox scale and the high-DPI scale together.
/// What a length in drawing units (a blur radius) is multiplied by to get framebuffer pixels.
pub fn paintScale(): f32 {
    return platform.ui_scale * fbRect().s;
}

/// Window size in scaled 2D units: what to lay a UI out in once `setUiScale` is set.
pub fn uiSize(): Vec2 {
    let size = windowSize();
    return Vec2 { x: size.x / platform.ui_scale, y: size.y / platform.ui_scale };
}

/// Dt from the last `poll`, in seconds.
pub fn lastDt(): f32 {
    return f32(platform.last_span) / 1000.0;
}

/// Store the leftover fixed-step fraction. `j3.app` calls this before draw.
pub fn setFrameAlpha(a: f32) {
    let v = a;
    if v < 0 {
        v = 0;
    }
    if v > 1 {
        v = 1;
    }
    alphaFrame = v;
}

/// Leftover fixed-step fraction, 0..1. `0` is the previous tick, `1` is the latest.
pub fn frameAlpha(): f32 {
    return alphaFrame;
}

/// Frames since init.
pub fn frameCount(): int {
    return platform.frames;
}

/// Milliseconds since SDL started, for timing that shouldn't depend on frame rate.
pub fn ticks(): int {
    return int(sdl.SDL_GetTicks());
}

/// Sleep the calling thread about `ms` milliseconds (`SDL_Delay`).
pub fn delayMs(ms: int) {
    if ms > 0 { sdl.SDL_Delay(u32(ms)); }
}

/// Microseconds on a steady clock, for timing inside a frame.
pub fn micros(): int {
    // ponytail: counter / (ticks per µs) drops sub-µs precision; the counter runs at 1 GHz or 10 MHz.
    let per = int(sdl.SDL_GetPerformanceFrequency()) / 1000000;
    if per < 1 { per = 1; }
    return int(sdl.SDL_GetPerformanceCounter()) / per;
}
