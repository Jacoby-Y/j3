/// Pure math for a virtual resolution (`game.setVirtualSize`): fit it in the window, map points both ways.
/// No GL, no module state. Any thread (`j3c doc threads`).

module j3.game.letterbox;

use j3.math.Vec2;

/// Where the virtual screen sits in the window, in physical window pixels, top-left origin.
/// With no virtual size it is the whole window and `s` is 1.
pub struct Rect {
    /// Left edge of the drawing area.
    x: int;
    /// Top edge of the drawing area.
    y: int;
    /// Width of the drawing area.
    w: int;
    /// Height of the drawing area.
    h: int;
    /// Physical pixels per virtual pixel.
    s: f32;
}

/// A pixel rect in GL's bottom-left window coordinates (what `glViewport` and `glScissor` take).
pub struct GlRect {
    x: int;
    y: int;
    w: int;
    h: int;
}

/// Largest `vw` by `vh` aspect rect centered in a `winW` by `winH` window. `vw` or `vh` at 0 or
/// below means no virtual size: the whole window. The limiting axis fills the window exactly, the
/// other is rounded, so bars differ by at most one pixel and nothing overhangs.
pub fn fit(winW: int, winH: int, vw: int, vh: int): Rect {
    let ww = if winW < 1 { 1 } else { winW };
    let wh = if winH < 1 { 1 } else { winH };
    if vw < 1 || vh < 1 {
        return Rect { x: 0, y: 0, w: ww, h: wh, s: 1.0 };
    }
    let sx = f32(ww) / f32(vw);
    let sy = f32(wh) / f32(vh);
    let r = Rect { x: 0, y: 0, w: ww, h: wh, s: sx };
    if sx <= sy {
        r.h = int(f32(vh) * sx + 0.5);
        if r.h < 1 { r.h = 1; }
        if r.h > wh { r.h = wh; }
    } else {
        r.s = sy;
        r.w = int(f32(vw) * sy + 0.5);
        if r.w < 1 { r.w = 1; }
        if r.w > ww { r.w = ww; }
    }
    r.x = (ww - r.w) / 2;
    r.y = (wh - r.h) / 2;
    return r;
}

/// Window pixel (as SDL reports the pointer) to virtual pixels. Points in the bars land outside
/// `0..vw` / `0..vh` (negative or past the size); nothing is clamped.
pub fn toVirtual(r: Rect, px: f32, py: f32): Vec2 {
    return Vec2 { x: (px - f32(r.x)) / r.s, y: (py - f32(r.y)) / r.s };
}

/// Virtual pixel to window pixel (top-left origin).
pub fn toWindow(r: Rect, vx: f32, vy: f32): Vec2 {
    return Vec2 { x: f32(r.x) + vx * r.s, y: f32(r.y) + vy * r.s };
}

/// Rounded window-pixel edge for virtual coordinate `v` on one axis starting at `off`.
/// Both edges of a rect round the same way, so neighbours share an edge with no seam.
fn edge(off: int, s: f32, v: f32): int {
    return off + int(v * s + 0.5);
}

/// A virtual-pixel rect (top-left origin) as a GL bottom-left rect in a window `winH` tall.
/// Edges are rounded, not the size, so adjacent rects meet; it is at least 1 by 1 when `w`, `h` > 0.
pub fn glRect(r: Rect, winH: int, x: f32, y: f32, w: f32, h: f32): GlRect {
    let x0 = edge(r.x, r.s, x);
    let x1 = edge(r.x, r.s, x + w);
    let y0 = edge(r.y, r.s, y);
    let y1 = edge(r.y, r.s, y + h);
    if x1 <= x0 && w > 0 { x1 = x0 + 1; }
    if y1 <= y0 && h > 0 { y1 = y0 + 1; }
    return GlRect { x: x0, y: winH - y1, w: x1 - x0, h: y1 - y0 };
}
