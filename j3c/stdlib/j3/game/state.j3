// Part of j3.game (SDL event constants and blobs, Platform, and the per-frame input singletons); the module doc and `use`s are in ../game.j3.
module j3.game;

/// App quit event.
const SDL_QUIT: u32 = 256;
/// Window event. See `win_event` for the subtype.
const SDL_WINDOWEVENT: u32 = 512;
/// Mouse moved.
const SDL_MOUSEMOTION: u32 = 1024;
/// Mouse button went down (SDL_MouseButtonEvent: button byte at offset 16).
const SDL_MOUSEBUTTONDOWN: u32 = 1025;
/// Mouse button went up (same layout as down).
const SDL_MOUSEBUTTONUP: u32 = 1026;
/// Mouse wheel moved.
const SDL_MOUSEWHEEL: u32 = 1027;
/// UTF-8 text from the keyboard.
const SDL_TEXTEDITING: u32 = 0x302;
const SDL_TEXTINPUT: u32 = 0x303;
/// A file was dropped on the window.
const SDL_DROPFILE: u32 = 0x1000;
/// Window size changed by the user.
const SDL_WINDOWEVENT_RESIZED: u8 = 5;
/// Window size changed for any reason.
const SDL_WINDOWEVENT_SIZE_CHANGED: u8 = 6;
/// The window moved to another display (a different pixel density).
const SDL_WINDOWEVENT_DISPLAY_CHANGED: u8 = 16;
/// Window close requested.
const SDL_WINDOWEVENT_CLOSE: u8 = 14;
const SDL_WINDOWEVENT_FOCUS_GAINED: u8 = 12;
const SDL_WINDOWEVENT_FOCUS_LOST: u8 = 13;

/// SDL event blob used while polling.
struct SDL_Event {
    /// Event type tag.
    ty: u32;
    /// Event timestamp in ms.
    timestamp: u32;
    /// Window id for window events.
    windowID: u32;
    /// Window event subtype.
    win_event: u8;
    /// Padding so this blob matches SDL's event layout.
    pad1: u8;
    /// Padding so this blob matches SDL's event layout.
    pad2: u8;
    /// Padding so this blob matches SDL's event layout.
    pad3: u8;
    /// First integer payload (e.g. new width).
    data1: i32;
    /// Second integer payload (e.g. new height or wheel).
    data2: i32;
    /// Mouse motion Y (layout filler).
    motion_y: i32;
    /// Relative mouse X motion.
    xrel: i32;
    /// Relative mouse Y motion.
    yrel: i32;
    /// Padding so the motion fields match SDL's event layout.
    motion_pad: i32;
    /// Trailing padding.
    tail2: u64;
    /// Trailing padding.
    tail3: u64;
}

/// `SDL_DropEvent` view of an `SDL_Event` blob.
struct SDL_DropEvent {
    /// Event type tag.
    ty: u32;
    /// Event timestamp in ms.
    timestamp: u32;
    /// SDL-owned path; free with `SDL_free`.
    file: ptr;
}

/// Mutable SDL platform singleton state.
struct Platform {
    /// SDL window pointer.
    window: ptr;
    /// SDL renderer pointer (0 in GL mode).
    renderer: ptr;
    /// Keyboard state array from SDL.
    keys: ptr;
    /// SDL ticks at last poll.
    last_ms: u32;
    /// Current draw color.
    color: Color;
    /// First game controller.
    pad0: ptr;
    /// Second game controller.
    pad1: ptr;
    /// Quit requested flag.
    quit: bool;
    /// Window width in pixels.
    win_w: int;
    /// Window height in pixels.
    win_h: int;
    /// 2D scale: screen-space drawing and `mousePos` use window pixels divided by this.
    ui_scale: f32;
    /// Current mouse button bitmask.
    mouse: u32;
    /// Mouse buttons from previous poll.
    prev_mouse: u32;
    /// Accumulated wheel this frame.
    wheel: i32;
    /// Audio subsystem opened.
    audio: bool;
    /// Image subsystem opened.
    img: bool;
    /// Font subsystem opened.
    fonts: bool;
    /// Current pad button bitmask.
    pad_bits: u32;
    /// Pad buttons from previous poll.
    prev_pad: u32;
    /// Last frame duration in ms.
    last_span: i32;
    /// Frames since init.
    frames: int;
    /// True when using an OpenGL context.
    gl: bool;
    /// OpenGL context pointer.
    glctx: ptr;
    /// Accumulated relative mouse X.
    mouse_dx: i32;
    /// Accumulated relative mouse Y.
    mouse_dy: i32;
    /// Relative mouse capture enabled.
    captured: bool;
}

/// Previous frame's keyboard state, for edge detection.
#[singleton]
let prevKeys: [512]u8;

/// Scancodes that went down / up in this frame's events (cleared by `poll`). `keyPressed`/`keyReleased` also read these,
/// so an edge is not lost when SDL's key state changed before `poll` snapshotted it (an idle sleep pumps events) or a
/// key went down and up inside one frame.
#[singleton]
let keyDownEv: [512]u8;
#[singleton]
let keyUpEv: [512]u8;

/// Optional GL teardown callback (`fn()`). Zero means none.
#[singleton]
let onGlShutdown: ptr = 0;

/// Additional independent GL teardown callbacks.
#[singleton]
let glShutdowns: [8]ptr;
#[singleton]
let nGlShutdowns: int = 0;

/// Leftover fixed-step fraction, 0..1, written by `j3.app` before draw.
#[singleton]
let alphaFrame: f32 = 0;

/// UTF-8 bytes from `SDL_TEXTINPUT` since the last `poll`.
#[singleton]
let typed: [32]u8;

/// Length of `typed`.
#[singleton]
let typedLen: int = 0;

/// IME composition text from the last `SDL_TEXTEDITING` (kept across polls; empty when none).
#[singleton]
let composing: [32]u8;

/// Length of `composing`.
#[singleton]
let composingLen: int = 0;

/// Byte offset of the IME caret in `composing` (SDL_TEXTEDITING `start`, or `simPreedit`'s caret).
#[singleton]
let composingAt: int = 0;

/// Fake input for the next `poll` (`simKey`, `simText`, `simPreedit`, `simDrop`), applied after SDL's events.
/// Key queue entries are `scancode * 2 + down`.
#[singleton]
let SIM_KQ: [64]int;
#[singleton]
let SIM_KQ_LEN: int = 0;
/// Scancodes held down by `simKey` (OR'd into `keyDownRaw`).
#[singleton]
let SIM_HELD: [512]u8;
#[singleton]
let SIM_TEXT: [1024]u8;
#[singleton]
let SIM_TEXT_LEN: int = 0;
#[singleton]
let SIM_PRE: [32]u8;
#[singleton]
let SIM_PRE_LEN: int = 0;
#[singleton]
let SIM_PRE_AT: int = 0;
#[singleton]
let SIM_PRE_ON: bool = false;
#[singleton]
let SIM_DROP: [1024]u8;
/// `simMouse`: once set, the cursor position in window pixels instead of SDL's (`SIM_MOUSE_ON`).
#[singleton]
let SIM_MOUSE_ON: bool = false;
#[singleton]
let SIM_MX: i32 = 0;
#[singleton]
let SIM_MY: i32 = 0;
/// Buttons held by `simButton` (SDL mask bits), OR'd into SDL's state once the edge queue is empty.
#[singleton]
let SIM_BTNS: u32 = 0;
/// Wheel from `simWheel`, added on the next `poll`.
#[singleton]
let SIM_WHEEL: f32 = 0;
/// -1: no fake drop waiting.
#[singleton]
let SIM_DROP_LEN: int = -1;

/// Path of a file dropped on the window since the last `poll`.
/// System cursors made so far, by `Cursor` value.
#[singleton]
let cursors: [12]ptr;
/// Cursor asked for this frame, and the one on screen (`Cursor` numbering).
#[singleton]
let cursorWant: int = 0;
#[singleton]
let cursorShown: int = 0;

#[singleton]
let dropped: [1024]u8;

/// Length of `dropped`.
#[singleton]
let droppedLen: int = 0;

/// Last clipboard text read by `clipboard()`: a malloc'd buffer and its capacity, grown to fit.
#[singleton]
let clip: ptr = 0;
#[singleton]
let clipCap: int = 0;
/// SDL_Get/SetPrimarySelectionText, looked up on first use (0 when SDL is older than 2.26).
#[singleton]
let primaryTried: int = 0;
#[singleton]
let primaryGet: ptr = 0;
#[singleton]
let primarySet: ptr = 0;

/// When true, closing the window sets `closeAsked` instead of quitting.
#[singleton]
let closeHeld: bool = false;

/// The window close button was hit this frame while `closeHeld`.
#[singleton]
let closeAsked: bool = false;

/// A focused UI text box owns the keyboard: `keyDown`/`keyPressed`/`keyReleased` read false (see `takeKeys`).
#[singleton]
let keyTake: bool = false;

/// `takeKeys(false)` waits for the next `poll`, so the key that blurred the box does not reach the game that frame.
#[singleton]
let keysFreeAtPoll: bool = false;
/// Mouse button presses and releases not yet given a frame, oldest first: button 0..2 (left,
/// middle, right), 1 for down, and the window position the button changed at.
#[singleton]
let btnQ: [16]u8;
#[singleton]
let btnQDown: [16]u8;
#[singleton]
let btnQX: [16]i32;
#[singleton]
let btnQY: [16]i32;
#[singleton]
let btnQLen: int = 0;
/// A button changed this frame at window position (`edgeX`, `edgeY`); `mousePos` reports it.
#[singleton]
let edgeOn: bool = false;
#[singleton]
let edgeX: i32 = 0;
#[singleton]
let edgeY: i32 = 0;

/// Next sfx channel in 0..8.
#[singleton]
let nextSfx: int = 0;

/// Next voice channel in 8..16.
#[singleton]
let nextVoice: int = 8;

/// Live window, input, and subsystem flags.
#[singleton]
let platform: Platform = Platform {
    window: 0,
    renderer: 0,
    keys: 0,
    last_ms: 0,
    color: Color { r: 255, g: 255, b: 255, a: 255 },
    pad0: 0,
    pad1: 0,
    quit: false,
    win_w: 0,
    win_h: 0,
    ui_scale: 1.0,
    mouse: 0,
    prev_mouse: 0,
    wheel: 0,
    audio: false,
    img: false,
    fonts: false,
    pad_bits: 0,
    prev_pad: 0,
    last_span: 16,
    frames: 0,
    gl: false,
    glctx: 0,
    mouse_dx: 0,
    mouse_dy: 0,
    captured: false,
};
