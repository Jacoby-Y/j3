// Part of j3.game (Key, Mouse, Pad and Axis enums); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Keyboard key for input queries.
pub enum Key {
    /// Escape.
    Escape,
    /// Left arrow.
    Left,
    /// Right arrow.
    Right,
    /// Up arrow.
    Up,
    /// Down arrow.
    Down,
    /// Space bar.
    Space,
    /// Enter / return.
    Enter,
    /// Tab.
    Tab,
    /// Shift (either side).
    Shift,
    /// Ctrl (either side).
    Ctrl,
    /// Backspace.
    Backspace,
    /// Letter A.
    A,
    /// Letter B.
    B,
    /// Letter C.
    C,
    /// Letter D.
    D,
    /// Letter E.
    E,
    /// Letter F.
    F,
    /// Letter G.
    G,
    /// Letter H.
    H,
    /// Letter I.
    I,
    /// Letter J.
    J,
    /// Letter K.
    K,
    /// Letter L.
    L,
    /// Letter M.
    M,
    /// Letter N.
    N,
    /// Letter O.
    O,
    /// Letter P.
    P,
    /// Letter Q.
    Q,
    /// Letter R.
    R,
    /// Letter S.
    S,
    /// Letter T.
    T,
    /// Letter U.
    U,
    /// Letter V.
    V,
    /// Letter W.
    W,
    /// Letter X.
    X,
    /// Letter Y.
    Y,
    /// Letter Z.
    Z,
    /// Digit 0.
    Num0,
    /// Digit 1.
    Num1,
    /// Digit 2.
    Num2,
    /// Digit 3.
    Num3,
    /// Digit 4.
    Num4,
    /// Digit 5.
    Num5,
    /// Digit 6.
    Num6,
    /// Digit 7.
    Num7,
    /// Digit 8.
    Num8,
    /// Digit 9.
    Num9,
    /// Function key F3.
    F3,
    /// Context menu shortcut (Shift+F10).
    F10,
    /// Delete (forward delete).
    Delete,
    /// Function key F2.
    F2,
    /// Function key F11.
    F11,
    /// Function key F12.
    F12,
    /// Home.
    Home,
    /// End.
    End,
    /// Minus.
    Minus,
    /// Period.
    Period,
    /// Function key F4.
    F4,
    /// Function key F5.
    F5,
    /// Alt (either side).
    Alt,
    /// Page Up.
    PageUp,
    /// Page Down.
    PageDown,
    /// Function key F1.
    F1,
    /// Function key F6.
    F6,
    /// Function key F7.
    F7,
    /// Function key F8.
    F8,
    /// Function key F9.
    F9,
    /// Function key F13.
    F13,
    /// Function key F14.
    F14,
    /// Function key F15.
    F15,
    /// Function key F16.
    F16,
    /// Function key F17.
    F17,
    /// Function key F18.
    F18,
    /// Function key F19.
    F19,
    /// Function key F20.
    F20,
    /// Function key F21.
    F21,
    /// Function key F22.
    F22,
    /// Function key F23.
    F23,
    /// Function key F24.
    F24,
    /// Insert.
    Insert,
    /// Print Screen.
    PrintScreen,
    /// Scroll Lock.
    ScrollLock,
    /// Pause / Break.
    Pause,
    /// Caps Lock.
    CapsLock,
    /// Num Lock (Clear on Mac).
    NumLock,
    /// Menu / application key.
    Menu,
    /// Left Super (Windows / Command) key; the right one also counts.
    Super,
    /// Right Shift only (`Shift` is either).
    ShiftRight,
    /// Right Ctrl only (`Ctrl` is either).
    CtrlRight,
    /// Right Alt / AltGr only (`Alt` is either).
    AltRight,
    /// Backtick / tilde (`` ` ``).
    Grave,
    /// Equals (`=`).
    Equals,
    /// Left bracket (`[`).
    LeftBracket,
    /// Right bracket (`]`).
    RightBracket,
    /// Backslash.
    Backslash,
    /// Semicolon (`;`).
    Semicolon,
    /// Apostrophe (`'`).
    Apostrophe,
    /// Comma (`,`).
    Comma,
    /// Slash (`/`).
    Slash,
    /// Keypad `/`.
    KpDivide,
    /// Keypad `*`.
    KpMultiply,
    /// Keypad `-`.
    KpMinus,
    /// Keypad `+`.
    KpPlus,
    /// Keypad Enter.
    KpEnter,
    /// Keypad `.`.
    KpPeriod,
    /// Keypad 0.
    Kp0,
    /// Keypad 1.
    Kp1,
    /// Keypad 2.
    Kp2,
    /// Keypad 3.
    Kp3,
    /// Keypad 4.
    Kp4,
    /// Keypad 5.
    Kp5,
    /// Keypad 6.
    Kp6,
    /// Keypad 7.
    Kp7,
    /// Keypad 8.
    Kp8,
    /// Keypad 9.
    Kp9,
