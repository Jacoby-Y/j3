/// Mouse button.
pub enum Mouse {
    /// Left button.
    Left,
    /// Right button.
    Right,
    /// Middle button.
    Middle,
}

/// Gamepad face, shoulder, or d-pad button.
pub enum Pad {
    /// Face A / Cross.
    A,
    /// Face B / Circle.
    B,
    /// Face X / Square.
    X,
    /// Face Y / Triangle.
    Y,
    /// Back / Select.
    Back,
    /// Start.
    Start,
    /// Left bumper.
    LB,
    /// Right bumper.
    RB,
    /// D-pad up.
    Up,
    /// D-pad down.
    Down,
    /// D-pad left.
    Left,
    /// D-pad right.
    Right,
}

/// Gamepad stick or trigger axis.
pub enum Axis {
    /// Left stick X.
    LeftX,
    /// Left stick Y.
    LeftY,
    /// Right stick X.
    RightX,
    /// Right stick Y.
    RightY,
    /// Left trigger.
    LT,
    /// Right trigger.
    RT,
}
