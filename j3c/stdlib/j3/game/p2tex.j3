// Part of j3.game (2D painter: texture filter, upload, delete); the module doc and `use`s are in ../game.j3.
module j3.game;

/// Switch a texture between nearest and linear sampling (`image-rendering: pixelated`). Draws queued with the
/// old filter go out first. No-op without GL.
pub fn p2TextureFilter(tex: u32, nearest: bool) {
    if tex == 0 || !HUD.ready {
        return;
    }
    p2Flush();
    let f: i32 = GL_LINEAR;
    if nearest { f = GL_NEAREST; }
    let bind = HUD.bindTexture as fn(u32, u32);
    bind(GL_TEXTURE_2D, tex);
    let param = HUD.texParameteri as fn(u32, u32, i32);
    param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
    param(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
}

/// Upload RGBA8 bytes already in a GL-ready buffer. Caller keeps the pointer live.
fn hudTexBytes(pixels: ptr, w: i32, h: i32): u32 {
    return hudTexBytesFiltered(pixels, w, h, GL_LINEAR);
}

/// Upload an RGBA buffer with per-texture nearest or linear filtering.
fn hudTexBytesFiltered(pixels: ptr, w: i32, h: i32, filter: i32): u32 {
    if !HUD.ready && HUD.genTextures == 0 {
        return 0;
    }
    let id: u32 = 0;
    let gen = HUD.genTextures as fn(i32, ptr);
    gen(1, &id as ptr);
    if id == 0 {
        panic("hud texture");
    }
    let bind = HUD.bindTexture as fn(u32, u32);
    bind(GL_TEXTURE_2D, id);
    let image = HUD.texImage2D as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    image(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
    let param = HUD.texParameteri as fn(u32, u32, i32);
    param(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
    param(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
    param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
    param(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
    return id;
}

/// Upload an RGBA image as a HUD texture. Zero when the image is empty.
fn hudUpload(image: Rgba): u32 {
    hudInit();
    if image.w < 1 || image.h < 1 || image.pixels.len < int(image.w) * int(image.h) * 4 {
        return 0;
    }
    return hudTexBytes(image.pixels.ptr as ptr, image.w, image.h);
}

/// Delete a GL texture stored in a `Texture` handle. Draws queued with it go out first.
fn hudDelete(raw: ptr) {
    hudInit();
    p2Flush();
    let id = u32(raw as int);
    if id == 0 {
        return;
    }
    let del = HUD.deleteTextures as fn(i32, ptr);
    del(1, &id as ptr);
}

/// White texel, creating the HUD on first use.
fn hudWhite(): u32 {
    hudInit();
    return HUD.white;
}

/// Pack a color for the instance buffer (R in the lowest byte).
fn p2Pack(c: Color): u32 {
    return u32(c.r) + u32(c.g) * 256 + u32(c.b) * 65536 + u32(c.a) * 16777216;
}
