/// NUL-terminated copy of a short name (`dlopen`, `dlsym`), per thread.
fn cstrTmp(s: string): cstr {
    if s.len + 1 > 256 {
        panic("dlopen: name too long");
    }
    for i in 0..s.len {
        DL_NAME[i] = s[i];
    }
    DL_NAME[s.len] = 0;
    return &DL_NAME[0] as cstr;
}

#[singleton]
#[thread]
let DL_NAME: [256]u8;

/// The process environment: a NUL-terminated array of `NAME=value` C strings. libc's (`_NSGetEnviron`),
/// so `setenv` changes show.
pub fn environ(): ptr {
    let slot = c._NSGetEnviron() as &int;
    if slot as int == 0 {
        return 0;
    }
    return *slot as ptr;
}

/// Environment variable `name`, or "" when unset. Valid for the whole process.
pub fn env(name: string): string {
    let ep = environ();
    if ep as int == 0 {
        return "";
    }
    let i = 0;
    while true {
        let slot = (ep as int + i * 8) as ptr as &int;
        let p = *slot;
        if p == 0 {
            return "";
        }
        let n = 0;
        while true {
            let byte = ((p + n) as ptr) as &u8;
            if *byte == 0 {
                break;
            }
            n += 1;
        }
        let bytes: []u8 = @slice(p as ptr, n);
        let s = bytes as string;
        if s.len > name.len && s[name.len] == 61 {
            let same = true;
            for k in 0..name.len {
                if s[k] != name[k] {
                    same = false;
                    break;
                }
            }
            if same {
                return s[name.len + 1..s.len];
            }
        }
        i += 1;
    }
    return "";
}

/// Set environment variable `name` to `value`, replacing it, for this process: `env`, programs started
/// afterwards (`j3.proc`) and C libraries loaded in it see the new value. False when `name` is empty or
/// has `=` or a NUL, `value` has a NUL, or the OS refuses. Not thread-safe against another thread reading
/// the environment at the same moment (like C's `setenv`): call it at startup.
pub fn setenv(name: string, value: string): bool {
    let block = envPair(name, value);
    if block as int == 0 {
        return false;
    }
    let ok = c.setenv(block, (block as int + name.len + 1) as ptr, 1) == 0;
    munmap(block, name.len + value.len + 2);
    return ok;
}

/// `name\0value\0` in a fresh `mmapAnon` block of `name.len + value.len + 2` bytes, for `setenv`. 0 when
/// `name` is empty or has `=` or a NUL, or `value` has a NUL (C would cut it there).
fn envPair(name: string, value: string): ptr {
    if name.len == 0 {
        return 0;
    }
    for k in 0..name.len {
        if name[k] == 61 || name[k] == 0 {
            return 0;
        }
    }
    for k in 0..value.len {
        if value[k] == 0 {
            return 0;
        }
    }
    let n = name.len + value.len + 2;
    let block = mmapAnon(n);
    if block as int <= 0 {
        return 0;
    }
    let b: []u8 = @slice(block, n);
    for k in 0..name.len {
        b[k] = name[k];
    }
    b[name.len] = 0;
    for k in 0..value.len {
        b[name.len + 1 + k] = value[k];
    }
    b[n - 1] = 0;
    return block;
}

/// The last failed call's error number (`errno`).
pub fn errno(): int {
    let e = c.__error() as &i32;
    return int(*e);
}

/// Load the shared library `name`. 0 when it cannot be loaded.
pub fn dlopen(name: string): ptr {
    return c.dlopen(cstrTmp(name), 2);
}

/// Address of `name` in a library from `dlopen`. 0 when missing.
pub fn dlsym(handle: ptr, name: string): ptr {
    return c.dlsym(handle, cstrTmp(name));
}

#[singleton]
let EXE_DIR: [1024]u8;

/// Directory of the running executable, no trailing slash (`_NSGetExecutablePath`). Valid until the
/// next call; "" when it cannot be read.
pub fn exeDir(): string {
    let size: u32 = u32(1023);
    if c._NSGetExecutablePath(&EXE_DIR[0] as ptr, &size as ptr) != 0 {
        return "";
    }
    let n = 0;
    while n < 1023 && EXE_DIR[n] != 0 {
        n += 1;
    }
    while n > 0 && EXE_DIR[n - 1] != 47 {
        n -= 1;
    }
    if n <= 1 {
        return "";
    }
    let bytes: []u8 = @slice(&EXE_DIR[0] as ptr, n - 1);
    return bytes as string;
}
