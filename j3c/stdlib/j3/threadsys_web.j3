/// Web (Emscripten) j3.threadsys. Same pub names as threadsys.j3. Single-threaded: no
/// SharedArrayBuffer is assumed, so `create` fails and locks do nothing (plan 06 decision 6; real
/// pthreads are its chunk 13).

module j3.threadsys;

/// One core: nothing runs beside the page's thread.
pub fn cores(): int {
    return 1;
}

/// No threads in this build: false.
pub fn create(out: ptr, f: fn(ptr): ptr, arg: ptr): bool {
    return false;
}

/// Nothing to wait for.
pub fn join(h: int) {}

/// No crash stack: 0.
pub fn enter(): ptr {
    return 0 as ptr;
}

pub fn leave(token: ptr) {}

/// One thread: nobody else holds it.
pub fn lock(m: ptr) {}

pub fn unlock(m: ptr) {}

/// Always takes it.
pub fn tryLock(m: ptr): bool {
    return true;
}

/// Would sleep forever with one thread: the caller's loop rechecks its condition.
pub fn wait(cv: ptr, m: ptr) {}

pub fn signal(cv: ptr) {}

pub fn broadcast(cv: ptr) {}
