/// Windows j3.sys. Same pub names as sys.j3. Flag numbers stay Linux's;
/// open/openMode map them onto CreateFileA. No @syscall.

module j3.sys;

use lib "kernel32" as k32 {
    fn CreateFileA(name: ptr, access: u32, share: u32, sec: ptr, disp: u32, attr: u32, templ: int): int;
    fn ReadFile(file: int, buf: ptr, n: u32, got: ptr, ov: ptr): i32;
    fn WriteFile(file: int, buf: ptr, n: u32, wrote: ptr, ov: ptr): i32;
    fn CloseHandle(file: int): i32;
    fn SetFilePointerEx(file: int, off: int, pos: ptr, method: u32): i32;
    fn GetStdHandle(kind: u32): int;
    fn VirtualAlloc(addr: ptr, size: int, kind: u32, prot: u32): ptr;
    fn VirtualFree(addr: ptr, size: int, kind: u32): i32;
    fn ExitProcess(code: u32);
    fn SetUnhandledExceptionFilter(f: fn(ptr): i32): ptr;
    fn GetModuleHandleA(name: ptr): int;
    fn GetLastError(): u32;
    fn LoadLibraryA(name: cstr): ptr;
    fn GetProcAddress(dll: ptr, name: cstr): ptr;
    fn GetModuleFileNameA(hmod: int, buf: ptr, size: u32): u32;
    fn GetEnvironmentVariableA(name: cstr, buf: ptr, size: u32): u32;
    fn GetFileAttributesExA(name: ptr, level: u32, info: ptr): i32;
    fn GetFileAttributesA(name: ptr): u32;
    fn FindFirstFileA(name: ptr, data: ptr): int;
    fn FindNextFileA(h: int, data: ptr): i32;
    fn FindClose(h: int): i32;
    fn CreateDirectoryA(name: ptr, sec: ptr): i32;
    fn MoveFileExA(from: ptr, to: ptr, flags: u32): i32;
    fn DeleteFileA(name: ptr): i32;
    fn SetCurrentDirectoryA(name: ptr): i32;
    fn GetCurrentProcessId(): u32;
    fn GetConsoleProcessList(list: ptr, n: u32): u32;
}

use lib "user32" as u32lib {
    fn MessageBoxA(wnd: ptr, text: ptr, caption: ptr, kind: u32): i32;
}

/// Which OS layer this is, fixed at compile time by `[emit] target`: compare it with the
/// `PLATFORM_*` names (`if sys.PLATFORM == sys.PLATFORM_ANDROID { ... }`); the other branch is dropped.
pub const PLATFORM: int = 1;
/// `PLATFORM` on Linux (desktop).
pub const PLATFORM_LINUX: int = 0;
/// `PLATFORM` on Windows.
pub const PLATFORM_WINDOWS: int = 1;
/// `PLATFORM` on macOS.
pub const PLATFORM_MACOS: int = 2;
/// `PLATFORM` on Android.
pub const PLATFORM_ANDROID: int = 3;
/// `PLATFORM` in a browser (Emscripten, `wasm64-unknown-emscripten`).
pub const PLATFORM_WEB: int = 4;
/// `PLATFORM` as a word for logs and paths: "linux", "windows", "macos", "android", "web".
pub const PLATFORM_NAME: string = "windows";
/// `ARCH_*` names of the CPU the program is built for (`if sys.ARCH == sys.ARCH_AARCH64 { ... }`); the other branch is dropped.
/// The compiler sets it from the target triple (the host when there is no target); the value written here is a placeholder.
pub const ARCH: int = 0;
/// `ARCH` on x86-64.
pub const ARCH_X86_64: int = 0;
/// `ARCH` on 64-bit ARM (arm64).
pub const ARCH_AARCH64: int = 1;
/// `ARCH` on 32-bit x86.
pub const ARCH_X86: int = 2;
/// `ARCH` on 32-bit ARM.
pub const ARCH_ARM: int = 3;
/// `ARCH` on RISC-V.
pub const ARCH_RISCV: int = 4;
/// `ARCH` on any other CPU.
pub const ARCH_OTHER: int = 5;
/// `ARCH` as a word for logs: "x86_64", "aarch64", "x86", "arm", "riscv", "other".
pub const ARCH_NAME: string = "x86_64";
/// Open for reading only.
pub const O_RDONLY: int = 0;
/// Open for writing only.
pub const O_WRONLY: int = 1;
/// Create the file if it does not exist.
pub const O_CREAT: int = 64;
/// Truncate to empty when opening.
pub const O_TRUNC: int = 512;
/// Seek from the start of the file.
pub const SEEK_SET: int = 0;
/// Seek from the end of the file.
pub const SEEK_END: int = 2;
/// `pipe` flag: close both ends in a child at `execve`. (Linux value; process calls are Linux only.)
pub const O_CLOEXEC: int = 524288;
/// `waitpid` flag: return 0 at once when the child is still running.
pub const WNOHANG: int = 1;
/// `kill` signal: ask to stop.
pub const SIGTERM: int = 15;
/// `kill` signal: stop now.
pub const SIGKILL: int = 9;
/// `open` flag: read and write.
pub const O_RDWR: int = 2;
/// `open` flag: a terminal device opened does not become the controlling terminal.
pub const O_NOCTTY: int = 256;
/// `kill` signal: the controlling terminal went away.
pub const SIGHUP: int = 1;
/// `pollFds` events: readable, writable; results add hang-up and error.
pub const POLLIN: int = 1;
pub const POLLOUT: int = 4;
pub const POLLERR: int = 8;
pub const POLLHUP: int = 16;


/// `CreateFileA` access: read.
const GENERIC_READ: u32 = 0x80000000;
/// `CreateFileA` access: write.
const GENERIC_WRITE: u32 = 0x40000000;
/// Share the file for read and write.
const FILE_SHARE: u32 = 3;
/// Open only if the file already exists.
const OPEN_EXISTING: u32 = 3;
/// Create the file, truncating it if it exists.
const CREATE_ALWAYS: u32 = 2;
/// Open the file, creating it if needed.
const OPEN_ALWAYS: u32 = 4;
/// Open and truncate an existing file.
const TRUNCATE_EXISTING: u32 = 5;
/// Ordinary file, no special attributes.
const FILE_ATTRIBUTE_NORMAL: u32 = 0x80;
/// `VirtualAlloc`: reserve and commit pages.
const MEM_COMMIT_RESERVE: u32 = 0x3000;
/// `VirtualFree`: release the whole region.
const MEM_RELEASE: u32 = 0x8000;
/// `VirtualAlloc` protection: read and write.
const PAGE_READWRITE: u32 = 0x04;
/// Standard input handle id.
const STD_INPUT: u32 = 0xFFFFFFF6;
/// Standard output handle id.
const STD_OUTPUT: u32 = 0xFFFFFFF5;
/// Standard error handle id.
const STD_ERROR: u32 = 0xFFFFFFF4;

/// True when `value` is set in the Linux-style `flags` bitfield.
fn bit(flags: int, value: int): bool {
    if value <= 0 {
        return false;
    }
    let q = flags / value;
    return q - q / 2 * 2 == 1;
}

/// Map 0/1/2 to stdin/stdout/stderr via GetStdHandle.
fn stdHandle(fd: int): int {
    if fd == 0 {
        return k32.GetStdHandle(STD_INPUT);
    }
    if fd == 1 {
        return k32.GetStdHandle(STD_OUTPUT);
    }
    return k32.GetStdHandle(STD_ERROR);
}

/// Resolve a Unix-style fd to a Win32 handle (std streams remapped).
fn handle(fd: int): int {
    if fd == 0 || fd == 1 || fd == 2 {
        return stdHandle(fd);
    }
    return fd;
}

/// Write `n` bytes from `buf` to file descriptor `fd`.
pub fn write(fd: int, buf: ptr, n: int): int {
    let h = handle(fd);
    if h < 0 {
        return 0 - 1;
    }
    let wrote: u32 = 0;
    let ok = k32.WriteFile(h, buf, n as u32, &wrote as ptr, 0);
    if ok == 0 {
        return 0 - 1;
    }
    return wrote as int;
}

/// Open `path` with `flags` (mode 0).
pub fn open(path: ptr, flags: int): int {
    return openMode(path, flags, 0);
}

/// Open `path` with Linux-style `flags` mapped to CreateFileA.
pub fn openMode(path: ptr, flags: int, mode: int): int {
    let access: u32 = GENERIC_READ;
    if bit(flags, O_WRONLY) {
        access = GENERIC_WRITE;
    }
    let disp: u32 = OPEN_EXISTING;
    if bit(flags, O_CREAT) && bit(flags, O_TRUNC) {
        disp = CREATE_ALWAYS;
    } else if bit(flags, O_CREAT) {
        disp = OPEN_ALWAYS;
    } else if bit(flags, O_TRUNC) {
        disp = TRUNCATE_EXISTING;
    }
    if access == GENERIC_READ && disp == OPEN_EXISTING {
        let a = k32.GetFileAttributesA(path);
        if a != u32(4294967295) && (int(a) / 16) % 2 == 1 {
            return dirOpen(path);
        }
    }
    return k32.CreateFileA(path, access, FILE_SHARE, 0, disp, FILE_ATTRIBUTE_NORMAL, 0);
}

/// Read up to `n` bytes from `fd` into `buf`.
pub fn read(fd: int, buf: ptr, n: int): int {
    let h = handle(fd);
    if h < 0 {
        return 0 - 1;
    }
    let got: u32 = 0;
    let ok = k32.ReadFile(h, buf, n as u32, &got as ptr, 0);
    if ok == 0 {
        return 0 - 1;
    }
    return got as int;
}

/// Close file descriptor `fd` (no-op for std streams).
pub fn close(fd: int): int {
    if fd == 0 || fd == 1 || fd == 2 {
        return 0;
    }
    if fd >= DIR_BASE {
        return dirClose(fd);
    }
    if k32.CloseHandle(fd) == 0 {
        return 0 - 1;
    }
    return 0;
}

/// Seek in `fd` by `off` relative to `whence`.
pub fn lseek(fd: int, off: int, whence: int): int {
    let h = handle(fd);
    if h < 0 {
        return 0 - 1;
    }
    let pos: int = 0;
    if k32.SetFilePointerEx(h, off, &pos as ptr, whence as u32) == 0 {
        return 0 - 1;
    }
    return pos;
}

/// Anonymous private read/write mapping of `len` bytes.
pub fn mmapAnon(len: int): ptr {
    return k32.VirtualAlloc(0, len, MEM_COMMIT_RESERVE, PAGE_READWRITE);
}

/// Unmap a region previously returned by `mmapAnon`.
pub fn munmap(p: ptr, len: int) {
    k32.VirtualFree(p, 0, MEM_RELEASE);
}

/// Run by `exit` (so by a panic and by the end of `main`) before the process ends. One slot, see `onExit`.
#[singleton]
let EXIT_HOOK: fn();

/// Run `hook` just before the process exits, normally or by panic (Linux: a panic runs it before the message is printed).
/// One slot: a later call replaces the earlier hook. The hook must be safe to run twice and may run in a forked child
/// that calls `exit`, so check `getpid()`. `j3.term.screen` uses it to restore the terminal.
pub fn onExit(hook: fn()) {
    EXIT_HOOK = hook;
}

fn runExitHook() {
    let hook = EXIT_HOOK;
    if hook as ptr != 0 as ptr {
        hook();
    }
}

/// Not available here: 0.
pub fn monotonicMs(): int { return 0; }

/// Terminate the process with exit code `code`.
pub fn exit(code: i32) {
    runExitHook();
    k32.ExitProcess(code as u32);
}

/// Name of this thread, set by `j3.thread`. Panics print it. Empty on the main thread.
#[singleton]
#[thread]
let THREAD_NAME: string;

/// Name the current thread for panic messages. `msg` must outlive the thread.
pub fn setThreadName(name: string) {
    THREAD_NAME = name;
}

/// `[name] ` on stderr when this is a named thread.
fn writeThreadName() {
    if THREAD_NAME.len > 0 {
        write(2, "[".ptr as ptr, 1);
        write(2, THREAD_NAME.ptr as ptr, THREAD_NAME.len);
        write(2, "] ".ptr as ptr, 2);
    }
}

/// Print `msg` to stderr, show it in a message box when nobody sees the console, and exit with code 101.
pub fn panic(msg: string) {
    writeThreadName();
    write(2, msg.ptr as ptr, msg.len);
    write(2, "\n".ptr as ptr, 1);
    BOX_N = 0;
    boxAdd(THREAD_NAME);
    boxAdd(msg);
    showPanicBox();
    exit(101);
}

/// The panic text for the message box, NUL-terminated by `showPanicBox`.
#[singleton]
#[thread]
let BOX_TEXT: [2048]u8;
#[singleton]
#[thread]
let BOX_N: int;

fn boxAdd(s: string) {
    for i in 0..s.len {
        if BOX_N < 2047 {
            BOX_TEXT[BOX_N] = s[i];
            BOX_N += 1;
        }
    }
}

fn boxInt(n: int) {
    if n >= 10 { boxInt(n / 10); }
    if BOX_N < 2047 {
        BOX_TEXT[BOX_N] = u8(48 + n % 10);
        BOX_N += 1;
    }
}

/// A double-clicked exe owns its console alone (it closes on exit) and a GUI exe has none: then show
/// `BOX_TEXT` in a message box so the player can read it. Run from cmd or a terminal, stderr is enough.
fn showPanicBox() {
    let pids: [4]u32 = [0, 0, 0, 0];
    if int(k32.GetConsoleProcessList(&pids[0] as ptr, u32(4))) > 1 { return; }
    BOX_TEXT[BOX_N] = 0;
    // MB_OK + MB_ICONERROR + MB_TOPMOST
    u32lib.MessageBoxA(0 as ptr, &BOX_TEXT[0] as ptr, "Error\0".ptr as ptr, u32(0x40010));
}

/// Write `n` in decimal to stderr.
fn writeIntErr(n: int) {
    if n >= 10 { writeIntErr(n / 10); }
    let digit = "0123456789".ptr as int + n % 10;
    write(2, digit as ptr, 1);
}

/// Print `file:line: msg` to stderr and exit with code 101.
pub fn panicAt(file: string, line: int, msg: string) {
    write(2, file.ptr as ptr, file.len);
    write(2, ":".ptr as ptr, 1);
    writeIntErr(line);
    write(2, ": ".ptr as ptr, 2);
    write(2, msg.ptr as ptr, msg.len);
    write(2, "\n".ptr as ptr, 1);
    BOX_N = 0;
    boxAdd(msg);
    boxAdd("\n\n(");
    boxAdd(file);
    boxAdd(":");
    boxInt(line);
    boxAdd(")");
    showPanicBox();
    exit(101);
}

// Host `main` stores these before `start`. Pointers stay valid for the process.
#[singleton]
let ARGC: int = 0;
#[singleton]
let ARGV: ptr = 0;

fn setArgs(argc: int, argv: ptr) {
    ARGC = argc;
    ARGV = argv;
}

/// How many arguments the process was given, including the program (`arg(0)`).
pub fn argCount(): int {
    return ARGC;
}

/// Argument `i`, or "" when `i` is out of range. `arg(0)` is the program.
/// Slots are 8 bytes (LP64).
pub fn arg(i: int): string {
    if i < 0 || i >= ARGC || ARGV as int == 0 {
        return "";
    }
    let slot = ARGV as int + i * 8;
    let word = (slot as ptr) as &int;
    let p = *word;
    if p == 0 {
        return "";
    }
    let n = 0;
    while n < 65536 {
        let byte = ((p + n) as ptr) as &u8;
        let b = *byte;
        if b == 0 {
            break;
        }
        n += 1;
    }
    let bytes: []u8 = @slice(p as ptr, n);
    return bytes as string;
}

/// Append `n` as 16 hex digits and a newline to `fd`.
fn writeHexLine(fd: int, n: int) {
    let digits = "0123456789abcdef";
    let buf: [17]u8 = [48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 48, 10];
    for i in 0..16 {
        let shift = (15 - i) * 4;
        let nibble = (n / pow16(shift)) % 16;
        if nibble < 0 { nibble = nibble + 16; }
        buf[i] = digits[nibble];
    }
    write(fd, &buf[0] as ptr, 17);
}

/// 2^shift for shift in 0..60 (no shift operator needed).
fn pow16(shift: int): int {
    let v = 1;
    for i in 0..shift { v = v * 2; }
    return v;
}

/// Unhandled exception: write `crash.log` beside the exe with the exception code, the faulting
/// address, and every stack word that points into the exe (all as offsets from the module base),
/// so a build with symbols can name the function: `llvm-addr2line -e game.exe <base+offset>`.
fn crashFilter(info: ptr): i32 {
    let record = rd(info as int);
    let ctx = rd(info as int + 8);
    let base = k32.GetModuleHandleA(0 as ptr);
    let fd = openMode("crash.log\0".ptr as ptr, O_WRONLY + O_CREAT + O_TRUNC, 0);
    writeHexLine(fd, rd(record) % 4294967296);
    writeHexLine(fd, base);
    writeHexLine(fd, rd(record + 16) - base);
    writeHexLine(fd, rd(ctx + 248) - base);
    let sp = rd(ctx + 152);
    for i in 0..512 {
        let word = rd(sp + i * 8);
        if word > base && word < base + 67108864 {
            writeHexLine(fd, word - base);
        }
    }
    close(fd);
    // ponytail: MessageBox from the filter; a stack overflow may not get one, crash.log still does.
    BOX_N = 0;
    boxAdd("The game crashed (exception ");
    boxInt(rd(record) % 4294967296);
    boxAdd(").\n\nDetails were saved to crash.log next to the game.");
    showPanicBox();
    return 1;
}

/// The 8 bytes at address `addr`.
fn rd(addr: int): int {
    let p = addr as ptr;
    let w = p as &int;
    return *w;
}

/// Entry from the host: run `main`, then exit 0.
pub fn start() {
    k32.SetUnhandledExceptionFilter(crashFilter);
    main();
    exit(0);
}

// Processes (`j3.proc`) are Linux only for now: these keep the pub names of sys.j3 and fail.

/// Not on this target yet: -1.
pub fn fork(): int { return -1; }
/// Not on this target yet: -1.
pub fn execve(path: ptr, argv: ptr, envp: ptr): int { return -1; }
/// Not on this target yet: -1.
pub fn pipe(fds: []i32, flags: int): int { return -1; }
/// Not on this target yet: -1.
pub fn dup2(from: int, to: int): int { return -1; }
/// Change the working directory (`SetCurrentDirectoryA`): 0, or -1 on failure.
pub fn chdir(path: ptr): int {
    if k32.SetCurrentDirectoryA(path) == 0 {
        return 0 - 1;
    }
    return 0;
}
/// Not on this target: -1.
pub fn ioctl(fd: int, req: int, arg: ptr): int { return -1; }
/// Not on this target: -1.
pub fn setsid(): int { return -1; }
/// True when `path` is a file (not a directory) that exists. Windows has no execute bit, so any file counts.
pub fn canExec(path: ptr): bool {
    let a = k32.GetFileAttributesA(path);
    return a != u32(4294967295) && (int(a) / 16) % 2 == 0;
}

// Files and directories (`j3.io`): stat, rename, remove, mkdir and directory listing work.

/// `statAt` dirfd meaning "relative to the working directory".
pub const AT_FDCWD: int = -100;
#[singleton]
#[thread]
let STAT_W: [9]u32;

// Directory listing. `open` of a directory gives a pseudo fd (`DIR_BASE` + slot) that stands for a FindFirstFileA
// search; `dirents` turns its entries into linux_dirent64 records and `statAt` resolves names against its path.
// Eight directories can be open per thread.
fn wb(p: ptr, off: int): u8 {
    let b = (p as int + off) as ptr as &u8;
    return *b;
}

const DIR_BASE: int = 1000000;
const DIR_SLOTS: int = 8;
const DIR_PATH_MAX: int = 520;
const FIND_SIZE: int = 320;

#[singleton]
#[thread]
let DIR_STATE: [8]int;
#[singleton]
#[thread]
let DIR_HANDLE: [8]int;
#[singleton]
#[thread]
let DIR_PATH: [4160]u8;
#[singleton]
#[thread]
let DIR_FIND: [2560]u8;
#[singleton]
#[thread]
let FULL_PATH: [1100]u8;

fn dirOpen(path: ptr): int {
    let n = 0;
    while n < DIR_PATH_MAX - 4 && wb(path, n) != 0 {
        n += 1;
    }
    if n >= DIR_PATH_MAX - 4 {
        return 0 - 1;
    }
    for slot in 0..DIR_SLOTS {
        if DIR_STATE[slot] == 0 {
            let base = slot * DIR_PATH_MAX;
            for k in 0..n {
                DIR_PATH[base + k] = wb(path, k);
            }
            if n > 0 && DIR_PATH[base + n - 1] != 92 && DIR_PATH[base + n - 1] != 47 {
                DIR_PATH[base + n] = 92;
                n += 1;
            }
            DIR_PATH[base + n] = 42;
            DIR_PATH[base + n + 1] = 0;
            DIR_STATE[slot] = 1;
            DIR_HANDLE[slot] = 0 - 1;
            return DIR_BASE + slot;
        }
    }
    return 0 - 1;
}

fn dirClose(fd: int): int {
    let slot = fd - DIR_BASE;
    if slot < 0 || slot >= DIR_SLOTS || DIR_STATE[slot] == 0 {
        return 0 - 1;
    }
    if DIR_HANDLE[slot] != 0 - 1 {
        k32.FindClose(DIR_HANDLE[slot]);
    }
    DIR_STATE[slot] = 0;
    return 0;
}

/// Negative error for the last failed Win32 call, in the numbers `j3.io` knows: -2 not found, -17 exists,
/// else minus the Win32 code.
fn winErr(): int {
    let e = errno();
    if e == 2 || e == 3 {
        return 0 - 2;
    }
    if e == 183 {
        return 0 - 17;
    }
    if e <= 0 {
        return 0 - 1;
    }
    return 0 - e;
}

/// `stat` of `path` (NUL-terminated) via `GetFileAttributesExA`. For a directory fd from `open`, `path` is a name
/// inside it; otherwise `dir` is ignored (only `AT_FDCWD` or full paths work). Fills `out`: is-directory 1/0, size
/// in bytes, mtime in unix seconds; a 4th slot, if present, gets is-symlink (always 0 here). 0, or a negative error.
/// ponytail: GetFileAttributesExA never follows a reparse point, so this matches `lstatAt` for a link; follow
/// with CreateFileA + GetFileInformationByHandle if that matters.
pub fn statAt(dir: int, path: ptr, out: []int): int {
    let r = lstatAt(dir, path, out);
    if out.len > 3 {
        out[3] = 0;
    }
    return r;
}

/// Like `statAt`, for the link itself: a 4th slot in `out`, if present, gets 1 for a reparse point (symlink or
/// junction).
pub fn lstatAt(dir: int, path: ptr, out: []int): int {
    let target = path;
    if dir >= DIR_BASE {
        let slot = dir - DIR_BASE;
        if slot >= DIR_SLOTS || DIR_STATE[slot] == 0 {
            return 0 - 9;
        }
        let base = slot * DIR_PATH_MAX;
        let n = 0;
        while DIR_PATH[base + n] != 42 {
            n += 1;
        }
        for k in 0..n {
            FULL_PATH[k] = DIR_PATH[base + k];
        }
        let m = 0;
        while n + m < 1090 && wb(path, m) != 0 {
            FULL_PATH[n + m] = wb(path, m);
            m += 1;
        }
        FULL_PATH[n + m] = 0;
        target = &FULL_PATH[0] as ptr;
    }
    if k32.GetFileAttributesExA(target, u32(0), &STAT_W[0] as ptr) == 0 {
        return winErr();
    }
    // WIN32_FILE_ATTRIBUTE_DATA: attributes @0, last write FILETIME (100 ns since 1601) @20/@24, size high @28, low @32
    out[0] = if (int(STAT_W[0]) / 16) % 2 == 1 { 1 } else { 0 };
    out[1] = int(STAT_W[7]) * 4294967296 + int(STAT_W[8]);
    out[2] = (int(STAT_W[6]) * 4294967296 + int(STAT_W[5])) / 10000000 - 11644473600;
    if out.len > 3 {
        // FILE_ATTRIBUTE_REPARSE_POINT 0x400
        out[3] = if (int(STAT_W[0]) / 1024) % 2 == 1 { 1 } else { 0 };
    }
    return 0;
}

/// Directory entries of a pseudo fd from `open`, as `linux_dirent64` records in `buf` (d_reclen u16 @16, d_name @19,
/// NUL-terminated; no "." or ".."). Bytes written, 0 at the end, negative on error. Uses FindFirstFileA/FindNextFileA.
pub fn dirents(fd: int, buf: []u8): int {
    let slot = fd - DIR_BASE;
    if slot < 0 || slot >= DIR_SLOTS || DIR_STATE[slot] == 0 {
        return 0 - 9;
    }
    let data = &DIR_FIND[slot * FIND_SIZE] as ptr;
    let used = 0;
    while DIR_STATE[slot] != 3 {
        if DIR_STATE[slot] == 1 {
            let h = k32.FindFirstFileA(&DIR_PATH[slot * DIR_PATH_MAX] as ptr, data);
            if h == 0 - 1 {
                let e = winErr();
                DIR_STATE[slot] = 3;
                if e == 0 - 2 {
                    return 0;
                }
                return e;
            }
            DIR_HANDLE[slot] = h;
            DIR_STATE[slot] = 2;
        }
        // DIR_STATE 2: `data` holds an entry not yet written
        let len = 0;
        while wb(data, 44 + len) != 0 {
            len += 1;
        }
        let dots = (len == 1 && wb(data, 44) == 46) || (len == 2 && wb(data, 44) == 46 && wb(data, 45) == 46);
        if !dots {
            let reclen = (19 + len + 1 + 7) / 8 * 8;
            if used + reclen > buf.len {
                if used == 0 {
                    return 0 - 22;
                }
                return used;
            }
            for k in 0..reclen {
                buf[used + k] = 0;
            }
            buf[used + 16] = u8(reclen % 256);
            buf[used + 17] = u8(reclen / 256);
            for k in 0..len {
                buf[used + 19 + k] = wb(data, 44 + k);
            }
            used += reclen;
        }
        if k32.FindNextFileA(DIR_HANDLE[slot], data) == 0 {
            DIR_STATE[slot] = 3;
        }
    }
    return used;
}
/// Rename or move `from` to `to`, replacing `to` (`MoveFileExA` with REPLACE_EXISTING). 0, or a negative error.
pub fn rename(from: ptr, to: ptr): int {
    if k32.MoveFileExA(from, to, u32(1)) == 0 {
        return winErr();
    }
    return 0;
}
/// Delete the file `path` (`DeleteFileA`). 0, or a negative error.
pub fn unlink(path: ptr): int {
    if k32.DeleteFileA(path) == 0 {
        return winErr();
    }
    return 0;
}
/// Make the directory `path` (`CreateDirectoryA`; `mode` is ignored). 0, or a negative error (-17 when it exists).
pub fn mkdir(path: ptr, mode: int): int {
    if k32.CreateDirectoryA(path, 0) == 0 {
        return winErr();
    }
    return 0;
}
/// Not on this target yet: -1.
pub fn waitpid(pid: int, status: &i32, flags: int): int { return -1; }
/// A `waitpid` status as a shell would show it: the exit code, or 128 + the signal that ended it.
pub fn exitCode(status: i32): int {
    let s = int(status);
    let sig = s % 128;
    if sig == 0 {
        return (s / 256) % 256;
    }
    return 128 + sig;
}
/// Not on this target yet: -1.
pub fn kill(pid: int, sig: int): int { return -1; }
/// Not on this target yet: 0.
pub fn getpid(): int { return int(k32.GetCurrentProcessId()); }
/// Not on this target yet: -1.
pub fn pollFds(fds: ptr, n: int, ms: int): int { return -1; }
/// Not needed on this target.
pub fn ignoreSigpipe(on: bool) {}

/// NUL-terminated copy of a short name (`dlopen`, `dlsym`), per thread.
fn cstrTmp(s: string): cstr {
    if s.len + 1 > 256 {
        panic("dlopen: name too long");
    }
    for i in 0..s.len {
        DL_NAME[i] = s[i];
    }
    DL_NAME[s.len] = 0;
    return &DL_NAME[0] as cstr;
}

#[singleton]
#[thread]
let DL_NAME: [256]u8;

/// No `envp` on Windows: 0.
pub fn environ(): ptr { return 0; }

/// One cached variable: its name and value, both in process-lifetime memory.
struct EnvRow {
    name: string;
    value: string;
}

#[singleton]
#[thread]
let ENV_P: ptr;
#[singleton]
#[thread]
let ENV_CAP: int = 0;
#[singleton]
#[thread]
let ENV_N: int = 0;

/// Environment variable `name`, or "" when unset (`GetEnvironmentVariableA`, asked twice so any length fits). The
/// value is copied once into memory that is never freed, so the string stays valid for the whole process like on
/// Linux. Each thread keeps its own cache, which grows without limit (page-backed). A value changed after the first
/// read is not seen again.
pub fn env(name: string): string {
    let rows: []EnvRow = @slice(ENV_P, ENV_CAP);
    for i in 0..ENV_N {
        if rows[i].name.len == name.len {
            let same = true;
            for k in 0..name.len {
                if rows[i].name[k] != name[k] {
                    same = false;
                    break;
                }
            }
            if same {
                return rows[i].value;
            }
        }
    }
    let need = int(k32.GetEnvironmentVariableA(cstrTmp(name), 0 as ptr, u32(0)));
    if need <= 1 {
        return "";
    }
    let block = mmapAnon(name.len + need);
    if block as int == 0 {
        return "";
    }
    let got = int(k32.GetEnvironmentVariableA(cstrTmp(name), (block as int + name.len) as ptr, u32(need)));
    if got <= 0 || got >= need {
        return "";
    }
    let nb: []u8 = @slice(block, name.len);
    for k in 0..name.len {
        nb[k] = name[k];
    }
    let vb: []u8 = @slice((block as int + name.len) as ptr, got);
    let row = EnvRow { name: nb as string, value: vb as string };
    if ENV_N >= ENV_CAP {
        let cap = ENV_CAP * 2 + 16;
        let fresh = mmapAnon(cap * @sizeof(EnvRow));
        if fresh as int != 0 {
            let moved: []EnvRow = @slice(fresh, cap);
            for i in 0..ENV_N {
                moved[i] = rows[i];
            }
            ENV_P = fresh;
            ENV_CAP = cap;
            rows = moved;
        }
    }
    if ENV_N < ENV_CAP {
        rows[ENV_N] = row;
        ENV_N += 1;
    }
    return row.value;
}

/// The last failed call's error code (`GetLastError`).
pub fn errno(): int {
    return int(k32.GetLastError());
}

/// Load the DLL `name` (`LoadLibraryA`). 0 when it cannot be loaded.
pub fn dlopen(name: string): ptr {
    return k32.LoadLibraryA(cstrTmp(name));
}

/// Address of `name` in a DLL from `dlopen`. 0 when missing.
pub fn dlsym(handle: ptr, name: string): ptr {
    return k32.GetProcAddress(handle, cstrTmp(name));
}

#[singleton]
let EXE_DIR: [1024]u8;

/// Directory of the running executable, no trailing slash (`GetModuleFileNameA`). Valid until the
/// next call; "" when it cannot be read.
pub fn exeDir(): string {
    let n = int(k32.GetModuleFileNameA(0, &EXE_DIR[0] as ptr, u32(1023)));
    while n > 0 && EXE_DIR[n - 1] != 92 && EXE_DIR[n - 1] != 47 {
        n -= 1;
    }
    if n <= 1 {
        return "";
    }
    let bytes: []u8 = @slice(&EXE_DIR[0] as ptr, n - 1);
    return bytes as string;
}
