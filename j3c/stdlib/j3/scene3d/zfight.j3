// Part of j3.scene3d (faces on one plane (z-fighting)); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

// ---- faces on one plane (z-fighting) ----

/// Meshes over this many triangles take no part in `flushScan`, and the scan stops once
/// their world-space triangles pass this many floats or it has tried this many triangle pairs.
const FLUSH_MAX_TRIS: int = 2000;
const FLUSH_FLOATS: int = 8000000;
const FLUSH_TESTS: int = 20000000;
/// Faces closer than this (meters) to one plane count as on it, and must overlap by more
/// than FLUSH_OVERLAP across an edge to count as overlapping.
const FLUSH_GAP: f32 = 0.002;
const FLUSH_OVERLAP: f32 = 0.001;

/// `verts` (12 floats a vertex) in world space by `m`, 12 floats a triangle: three corners,
/// then the unit normal. Degenerate triangles are left out.
fn worldTris(verts: []f32, m: Mat4): []f32 {
    let tris = verts.len / 36;
    let out = scratch(0).alloc::<f32>(tris * 12);
    let used = 0;
    let t = 0;
    while t < tris {
        let base = t * 36;
        let a = m.transformPoint(Vec3.xyz(verts[base], verts[base + 1], verts[base + 2]));
        let b = m.transformPoint(Vec3.xyz(verts[base + 12], verts[base + 13], verts[base + 14]));
        let c = m.transformPoint(Vec3.xyz(verts[base + 24], verts[base + 25], verts[base + 26]));
        t += 1;
        let nr = (b - a).cross(c - a);
        let len = nr.length();
        if len < 0.000001 { continue; }
        nr = nr * (1 / len);
        let o = used * 12;
        out[o] = a.x; out[o + 1] = a.y; out[o + 2] = a.z;
        out[o + 3] = b.x; out[o + 4] = b.y; out[o + 5] = b.z;
        out[o + 6] = c.x; out[o + 7] = c.y; out[o + 8] = c.z;
        out[o + 9] = nr.x; out[o + 10] = nr.y; out[o + 11] = nr.z;
        used += 1;
    }
    return []f32 { ptr: out.ptr, len: used * 12 };
}

/// Coordinate `k` (0 or 1) of `v` once axis `drop` is left out.
fn planeAxis(v: Vec3, drop: int, k: int): f32 {
    if drop == 0 { return if k == 0 { v.y } else { v.z }; }
    if drop == 1 { return if k == 0 { v.x } else { v.z }; }
    return if k == 0 { v.x } else { v.y };
}

/// Whether coplanar triangles at `a[ai]` and `b[bi]` overlap by more than FLUSH_OVERLAP,
/// seen along axis `drop` of their plane.
// ponytail: 2D separating-axis test on the projection; exact for coplanar pairs.
fn trisOverlap(a: []f32, ai: int, b: []f32, bi: int, drop: int): bool {
    let pa = scratch(0).alloc::<f32>(6);
    let pb = scratch(0).alloc::<f32>(6);
    let k = 0;
    while k < 3 {
        let va = Vec3.xyz(a[ai + k * 3], a[ai + k * 3 + 1], a[ai + k * 3 + 2]);
        let vb = Vec3.xyz(b[bi + k * 3], b[bi + k * 3 + 1], b[bi + k * 3 + 2]);
        pa[k * 2] = planeAxis(va, drop, 0); pa[k * 2 + 1] = planeAxis(va, drop, 1);
        pb[k * 2] = planeAxis(vb, drop, 0); pb[k * 2 + 1] = planeAxis(vb, drop, 1);
        k += 1;
    }
    let side = 0;
    while side < 2 {
        let e = if side == 0 { pa } else { pb };
        let i = 0;
        while i < 3 {
            let j = (i + 1) % 3;
            let nx = e[i * 2 + 1] - e[j * 2 + 1];
            let ny = e[j * 2] - e[i * 2];
            let len = sqrt(nx * nx + ny * ny);
            if len > 0.0000001 {
                nx = nx / len;
                ny = ny / len;
                let lo0: f32 = 1000000000; let hi0: f32 = -1000000000;
                let lo1: f32 = 1000000000; let hi1: f32 = -1000000000;
                let q = 0;
                while q < 3 {
                    let d0 = pa[q * 2] * nx + pa[q * 2 + 1] * ny;
                    let d1 = pb[q * 2] * nx + pb[q * 2 + 1] * ny;
                    lo0 = min(lo0, d0); hi0 = max(hi0, d0);
                    lo1 = min(lo1, d1); hi1 = max(hi1, d1);
                    q += 1;
                }
                if min(hi0, hi1) - max(lo0, lo1) <= FLUSH_OVERLAP { return false; }
            }
            i += 1;
        }
        side += 1;
    }
    return true;
}

/// Whether some face in `a` lies on, faces the way of (either way when `both`), and overlaps
/// some face in `b`. Counts triangle pairs tried in `tests`; `at` gets the first corner found.
fn flushTris(a: []f32, b: []f32, both: bool, tests: &int, at: &Vec3): bool {
    let i = 0;
    while i < a.len {
        let na = Vec3.xyz(a[i + 9], a[i + 10], a[i + 11]);
        let p0 = Vec3.xyz(a[i], a[i + 1], a[i + 2]);
        let drop = 0;
        if abs(na.y) > abs(na.x) && abs(na.y) >= abs(na.z) { drop = 1; }
        else if abs(na.z) > abs(na.x) && abs(na.z) > abs(na.y) { drop = 2; }
        let j = 0;
        while j < b.len {
            *tests += 1;
            let nb = Vec3.xyz(b[j + 9], b[j + 10], b[j + 11]);
            let d = na.dot(nb);
            if (if both { abs(d) } else { d }) > 0.9999 {
                let k = 0;
                let flush = true;
                while k < 3 {
                    let q = Vec3.xyz(b[j + k * 3], b[j + k * 3 + 1], b[j + k * 3 + 2]);
                    if abs(na.dot(q - p0)) > FLUSH_GAP { flush = false; }
                    k += 1;
                }
                if flush && trisOverlap(a, i, b, j, drop) {
                    *at = p0;
                    return true;
                }
            }
            j += 12;
        }
        i += 12;
    }
    return false;
}

/// Find pairs of nodes with overlapping faces on one plane: they flicker where they share a
/// view. `meshes[i]` is node slot `i`'s vertices (12 floats each), empty to leave it out;
/// `transforms[i]` its world matrix. Slots of the first `a.len` pairs go to `a[k]`/`b[k]`
/// and a corner of the overlap to `at[k]`. Returns every pair found, and sets `gaveUp` when
/// the scene was too large to compare them all.
// ponytail: tests every pair whose boxes touch; a spatial grid if scenes get big.
pub fn flushScan(scene: &Scene, transforms: []Mat4, meshes: [][]f32, a: []int, b: []int, at: []Vec3, gaveUp: &bool): int {
    *gaveUp = false;
    let n = scene.len;
    let tris = scratch(0).alloc::<[]f32>(n);
    let los = scratch(0).alloc::<Vec3>(n);
    let his = scratch(0).alloc::<Vec3>(n);
    let floats = 0;
    let i = 0;
    while i < n {
        tris[i] = []f32 { ptr: 0 as &f32, len: 0 };
        let v = meshes[i];
        let count = v.len / 36;
        if count > 0 && count <= FLUSH_MAX_TRIS && floats + count * 12 <= FLUSH_FLOATS {
            let t = worldTris(v, transforms[i]);
            tris[i] = t;
            floats += t.len;
            let j = 0;
            while j < t.len {
                let k = 0;
                while k < 3 {
                    let p = Vec3.xyz(t[j + k * 3], t[j + k * 3 + 1], t[j + k * 3 + 2]);
                    if j == 0 && k == 0 { los[i] = p; his[i] = p; }
                    los[i] = Vec3.xyz(min(los[i].x, p.x), min(los[i].y, p.y), min(los[i].z, p.z));
                    his[i] = Vec3.xyz(max(his[i].x, p.x), max(his[i].y, p.y), max(his[i].z, p.z));
                    k += 1;
                }
                j += 12;
            }
        } else if count > 0 {
            *gaveUp = true;
        }
        i += 1;
    }
    let found = 0;
    let tests = 0;
    i = 0;
    while i < n {
        if tris[i].len == 0 { i += 1; continue; }
        let o = i + 1;
        while o < n {
            let e = FLUSH_GAP;
            if tris[o].len == 0 || los[i].x > his[o].x + e || his[i].x < los[o].x - e || los[i].y > his[o].y + e
                || his[i].y < los[o].y - e || los[i].z > his[o].z + e || his[i].z < los[o].z - e {
                o += 1;
                continue;
            }
            if tests > FLUSH_TESTS {
                *gaveUp = true;
                return found;
            }
            let corner = Vec3.zero();
            if flushTris(tris[i], tris[o], scene.nodes[i].doubleSided || scene.nodes[o].doubleSided, &tests, &corner) {
                if found < a.len {
                    a[found] = i;
                    b[found] = o;
                    at[found] = corner;
                }
                found += 1;
            }
            o += 1;
        }
        i += 1;
    }
    return found;
}

/// How far node `i` is pulled toward the camera: its `decal` tag's, else what `flushUpdate` found.
fn biasOf(scene: &Scene, i: int): f32 {
    let n = scene.nodes[i];
    if hasTag(n, "decal") { return decalLevel(n); }
    if i < scene.flush.len { return scene.flush[i]; }
    return 0;
}

/// World-space length of node `i`'s box: of two objects on one plane, the smaller one wins.
fn flushSize(scene: &Scene, transforms: []Mat4, i: int): f32 {
    let n = scene.nodes[i];
    return (transforms[i].transformPoint(n.boundHi) - transforms[i].transformPoint(n.boundLo)).length();
}

/// Work out `scene.flush` once the objects have stood still for two frames (and on the
/// first one). Moving objects keep what they had until they settle.
fn flushUpdate(scene: &Scene, transforms: []Mat4) {
    let sig: f32 = f32(scene.len);
    let i = 0;
    while i < scene.len {
        let m = transforms[i];
        sig += m.m[0] + m.m[5] + m.m[10] + m.m[12] * 3 + m.m[13] * 5 + m.m[14] * 7;
        i += 1;
    }
    if scene.flush.len != scene.len {
        scene.flush = scene.arena.alloc::<f32>(scene.len);
        i = 0;
        while i < scene.len { scene.flush[i] = 0; i += 1; }
        scene.flushStale = true;
        scene.flushStill = 2;
    } else if sig != scene.flushSig {
        scene.flushStale = true;
        scene.flushStill = 0;
    } else {
        scene.flushStill += 1;
    }
    scene.flushSig = sig;
    if !scene.flushStale || scene.flushStill < 2 { return; }
    scene.flushStale = false;
    let meshes = scratch(0).alloc::<[]f32>(scene.len);
    i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        meshes[i] = []f32 { ptr: 0 as &f32, len: 0 };
        if alphaOf(n) != BLEND && !hasTag(n, "decal") { meshes[i] = traceVerts(n); }
        i += 1;
    }
    let cap = 4096;
    let a = scratch(0).alloc::<int>(cap);
    let b = scratch(0).alloc::<int>(cap);
    let at = scratch(0).alloc::<Vec3>(cap);
    let gave = false;
    let found = flushScan(scene, transforms, meshes, a, b, at, &gave);
    if found > cap { found = cap; }
    i = 0;
    while i < scene.len { scene.flush[i] = 0; i += 1; }
    // The smaller of a pair (the later one when equal) wins; a winner sits above whatever it beats.
    let pass = 0;
    while pass < 4 {
        let k = 0;
        while k < found {
            let win = a[k];
            let lose = b[k];
            if flushSize(scene, transforms, a[k]) > flushSize(scene, transforms, b[k]) {
                win = b[k];
                lose = a[k];
            }
            scene.flush[win] = max(scene.flush[win], min(scene.flush[lose] + 1, 8));
            k += 1;
        }
        pass += 1;
    }
}

/// Depth steps a `decal` node is pulled toward the camera: `decal=2` is 2, bare `decal` is 1.
fn decalLevel(n: Node): f32 {
    let v = tagValue(n, "decal", "");
    if v.len == 0 { return 1; }
    return save.parseFloat(v as []u8, 0);
}
