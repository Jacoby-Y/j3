/// Whether one scene file places another, at any depth: the editor refuses a placement that
/// would put a scene inside itself.

module j3.scene3d.editor.uses;

use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.INSTANCE;
use j3.text.same;

/// True when `file`, or a scene it instances, is `target`.
pub fn uses(file: string, target: string): bool {
    let mem = Arena.create(64 * 1024);
    let visits = VisitCtx { entries: mem.alloc::<Visit>(16), used: 0,
        slots: mem.alloc::<int>(32), mem: &mem };
    let i = 0;
    while i < visits.slots.len { visits.slots[i] = 0; i += 1; }
    let found = usesIn(file, target, 0, &visits);
    mem.destroy();
    return found;
}

struct Visit {
    path: string;
    depth: int;
}

struct VisitCtx {
    entries: []Visit;
    used: int;
    slots: []int;
    mem: &Arena;
}

fn visitHash(path: string, size: int): int {
    let h = 0;
    let i = 0;
    while i < path.len {
        h = h * 33 + int(path[i]);
        h = h - (h / size) * size;
        i += 1;
    }
    return h;
}

/// Revisit a file only if this route leaves more nesting depth than the last route.
fn visit(ctx: &VisitCtx, path: string, depth: int): bool {
    let h = visitHash(path, ctx.slots.len);
    while ctx.slots[h] != 0 && !same(ctx.entries[ctx.slots[h] - 1].path, path) {
        h = scene3d.nextSlot(h, ctx.slots.len);
    }
    if ctx.slots[h] != 0 {
        let entry = &ctx.entries[ctx.slots[h] - 1];
        if depth >= entry.depth { return false; }
        entry.depth = depth;
        return true;
    }
    if ctx.used >= ctx.entries.len {
        let grown = ctx.mem.alloc::<Visit>(ctx.entries.len * 2);
        let i = 0;
        while i < ctx.used { grown[i] = ctx.entries[i]; i += 1; }
        ctx.entries = grown;
    }
    if (ctx.used + 1) * 2 >= ctx.slots.len {
        let table = ctx.mem.alloc::<int>(ctx.slots.len * 2);
        let slotIndex = 0;
        while slotIndex < table.len { table[slotIndex] = 0; slotIndex += 1; }
        slotIndex = 0;
        while slotIndex < ctx.used {
            let slot = visitHash(ctx.entries[slotIndex].path, table.len);
            while table[slot] != 0 { slot = scene3d.nextSlot(slot, table.len); }
            table[slot] = slotIndex + 1;
            slotIndex += 1;
        }
        ctx.slots = table;
        h = visitHash(path, ctx.slots.len);
        while ctx.slots[h] != 0 { h = scene3d.nextSlot(h, ctx.slots.len); }
    }
    ctx.entries[ctx.used] = Visit { path: path, depth: depth };
    ctx.slots[h] = ctx.used + 1;
    ctx.used += 1;
    return true;
}

fn usesIn(file: string, target: string, depth: int, ctx: &VisitCtx): bool {
    if same(file, target) { return true; }
    if file.len == 0 || depth > scene3d.NEST || !visit(ctx, file, depth) { return false; }
    let s = scene3d.read(file, ctx.mem);
    let i = 0;
    while i < s.len {
        if s.nodes[i].kind == INSTANCE && usesIn(s.nodes[i].scene, target, depth + 1, ctx) { return true; }
        i += 1;
    }
    return false;
}
