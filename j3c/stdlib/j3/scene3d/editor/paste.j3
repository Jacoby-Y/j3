/// Pasting placed objects: their script props and per-copy overrides come along.

module j3.scene3d.editor.paste;

use j3.memory.Arena;
use j3.data.save.Save;
use j3.scene3d;
use j3.scene3d.Scene;
use j3.text.Text;

/// Copy the parameter lines of objects `from[k]` in `src` onto objects `to[k]` in `scene`,
/// in one pass over `src`.
pub fn copyParamsMany(scene: &Scene, src: &Save, from: []int, to: []int) {
    if from.len == 0 { return; }
    scene3d.flushParams(scene);
    let mem = Arena.create(src.bytes.len * 2 + from.len * 32 + 256);
    let extra = Text.new(&mem);
    scene3d.appendParams(src, from, to, &extra, &mem);
    appendOverrides(src, from, to, &extra);
    if extra.bytes.len > 0 {
        let out = Text.new(scene.arena);
        let old = scene.data.bytes;
        out.pushStr(old as string);
        if old.len > 0 && old[old.len - 1] != 10 { out.push(10); }
        out.pushStr(extra.str());
        scene.data.bytes = out.bytes;
        scene3d.rebuildParams(scene);
    }
    mem.destroy();
}

/// `over.<from[k]>.*` lines of `src` again as `over.<to[k]>.*`, so a copied placement keeps
/// what was changed on it.
// ponytail: scans `from` per override line; a table like `appendParams` if pastes get huge.
fn appendOverrides(src: &Save, from: []int, to: []int, extra: &Text) {
    let line = 0;
    while line < src.bytes.len {
        let end = line;
        while end < src.bytes.len && src.bytes[end] != 10 { end += 1; }
        let id = scene3d.keyId(src.bytes, line, end, "over.");
        let k = 0;
        while id > 0 && k < from.len {
            if from[k] == id {
                extra.pushStr("over.");
                extra.pushInt(to[k]);
                let c = line + 5;
                while src.bytes[c] != 46 { c += 1; }
                while c < end { extra.push(src.bytes[c]); c += 1; }
                extra.push(10);
                break;
            }
            k += 1;
        }
        line = end + 1;
    }
}
