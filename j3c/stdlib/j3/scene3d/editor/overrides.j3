/// Per-copy overrides for the editor: change a placed object in one copy only, and revert it.
/// The lines are `over.<copy>.<path>.<field>`; `scene3d.load` and `refresh` apply them.

module j3.scene3d.editor.overrides;

use j3.memory.scratch;
use j3.scene3d;
use j3.scene3d.Scene;
use j3.text.Text;

/// `over.<instance>.<path>.` for placed object `id`, or "" when it isn't placed.
fn overPrefix(scene: &Scene, id: int): string {
    let at = scene3d.index(scene, id);
    if at < 0 || scene.nodes[at].owner == 0 || scene.nodes[at].sourcePath.len == 0 { return ""; }
    let t = Text.new(scratch(0));
    t.pushStr("over.");
    t.pushInt(scene.nodes[at].owner);
    t.push(46);
    t.pushStr(scene.nodes[at].sourcePath);
    t.push(46);
    return t.str();
}

/// Rewrite the scene's data without lines whose key is `key` (or, with `prefix`, starts
/// with it), then append `line` when it isn't "".
pub fn replaceLines(scene: &Scene, key: string, prefix: bool, line: string) {
    scene3d.flushParams(scene);
    let bytes = scene.data.bytes;
    let out = Text.new(scene.arena);
    let at = 0;
    while at < bytes.len {
        let end = at;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let keyEnd = at;
        while keyEnd < end && bytes[keyEnd] != 32 && bytes[keyEnd] != 61 { keyEnd += 1; }
        let drop = scene3d.fieldIs(bytes, at, keyEnd, key);
        if prefix { drop = scene3d.startsWith(bytes, at, end, key); }
        if !drop {
            let k = at;
            while k < end { out.push(bytes[k]); k += 1; }
            out.push(10);
        }
        at = end + 1;
    }
    out.pushStr(line);
    scene.data.bytes = out.bytes;
    scene3d.ensureParams(scene);
}

/// For placed object `id`, keep `key` (a node field such as `px` or `name`, or
/// `param.<field>`) at `value` in this placement only. `suffix` is the line's type: "",
/// " f", " s", or " r". Saved with the scene; `refresh` and `load` apply it.
pub fn override(scene: &Scene, id: int, key: string, suffix: string, value: string) {
    let prefix = overPrefix(scene, id);
    if prefix.len == 0 { return; }
    let full = Text.new(scratch(0));
    full.pushStr(prefix);
    full.pushStr(key);
    let line = Text.new(scratch(0));
    line.pushStr(full.str());
    line.pushStr(suffix);
    line.push(61);
    line.pushStr(value);
    line.push(10);
    replaceLines(scene, full.str(), false, line.str());
}

/// Keep placed object `id`'s current value of behavior field `field` in this placement.
pub fn overrideParam(scene: &Scene, id: int, field: string) {
    scene3d.ensureParams(scene);
    let at = scene3d.paramSlot(scene.params, id, field);
    if scene.params[at].id == 0 { return; }
    let entry = scene.params[at];
    let suffix = "";
    if entry.kind == 1 { suffix = " f"; }
    if entry.kind == 2 { suffix = " s"; }
    if entry.kind == 3 { suffix = " r"; }
    let key = Text.new(scratch(0));
    key.pushStr("param.");
    key.pushStr(field);
    override(scene, id, key.str(), suffix, entry.value as string);
}

/// Drop every override of placed object `id`. `refresh` then shows it as its file has it.
pub fn clearOverrides(scene: &Scene, id: int) {
    let prefix = overPrefix(scene, id);
    if prefix.len > 0 { replaceLines(scene, prefix, true, ""); }
}

/// Whether placed object `id` has any override in this scene.
pub fn hasOverrides(scene: &Scene, id: int): bool {
    let prefix = overPrefix(scene, id);
    if prefix.len == 0 { return false; }
    let bytes = scene.data.bytes;
    let at = 0;
    while at < bytes.len {
        let end = at;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if scene3d.startsWith(bytes, at, end, prefix) { return true; }
        at = end + 1;
    }
    return false;
}
