/// Scene props for the editor: declare them on a scene, and set, clear, or rename them on its
/// placed copies. Games read them with `scene3d.prop`.

module j3.scene3d.editor.props;

use j3.scene3d.editor.overrides.replaceLines;
use j3.memory.{ Arena, scratch };
use j3.data.save;
use j3.data.save.Save;
use j3.scene3d;
use j3.scene3d.{ Scene, INSTANCE };
use j3.text.{ Text, same };

/// A value no prop line holds, for telling "not set" from "set to empty".
const UNSET: string = "(j3 unset prop)";

/// A prop a scene declares: typed settings each placed copy can change (`int`, `float`,
/// `text`, `bool`, `material`, `mesh`, or `scene`), with a default.
pub struct PropDecl {
    name: string;
    kind: string;
    value: string;
}

/// The props scene data `data` declares, in file order (`prop.<name>.type` and `.default`).
pub fn propsIn(data: &Save, arena: &Arena): []PropDecl {
    let bytes = data.bytes;
    let count = 0;
    let line = 0;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if scene3d.startsWith(bytes, line, end, "prop.") && propTail(bytes, line, end, ".type") { count += 1; }
        line = end + 1;
    }
    let out = arena.alloc::<PropDecl>(count);
    let n = 0;
    line = 0;
    while line < bytes.len && n < count {
        let stop = line;
        while stop < bytes.len && bytes[stop] != 10 { stop += 1; }
        if scene3d.startsWith(bytes, line, stop, "prop.") && propTail(bytes, line, stop, ".type") {
            let dot = line + 5;
            while dot < stop && !scene3d.startsWith(bytes, dot, stop, ".type") { dot += 1; }
            let name = []u8 { ptr: (bytes.ptr as int + line + 5) as &u8, len: dot - line - 5 } as string;
            out[n] = PropDecl { name: name, kind: save.getStr(data, propKey(name, "type"), "text"),
                value: save.getStr(data, propKey(name, "default"), "") };
            n += 1;
        }
        line = stop + 1;
    }
    return out;
}

/// The props scene file `path` declares; empty when it has none or can't be read.
pub fn declaredProps(path: string, arena: &Arena): []PropDecl {
    let data = save.load(path, arena);
    return propsIn(&data, arena);
}

/// Whether the key of the line at `line` ends with `tail` (before ` s=`).
fn propTail(bytes: []u8, line: int, end: int, tail: string): bool {
    let k = line;
    while k < end && bytes[k] != 32 && bytes[k] != 61 { k += 1; }
    return k - line > tail.len + 5 && scene3d.startsWith(bytes, k - tail.len, k, tail);
}

fn propKey(name: string, part: string): string {
    let t = Text.new(scratch(0));
    t.pushStr("prop.");
    t.pushStr(name);
    t.push(46);
    t.pushStr(part);
    return t.str();
}

/// Declare (or change) prop `name` on this scene: its type and default.
pub fn declareProp(scene: &Scene, name: string, kind: string, value: string) {
    let line = Text.new(scratch(0));
    line.pushStr(propKey(name, "type"));
    line.pushStr(" s=");
    line.pushStr(kind);
    line.push(10);
    replaceLines(scene, propKey(name, "type"), false, line.str());
    let def = Text.new(scratch(0));
    def.pushStr(propKey(name, "default"));
    def.pushStr(" s=");
    def.pushStr(oneLine(value));
    def.push(10);
    replaceLines(scene, propKey(name, "default"), false, def.str());
}

/// Remove prop `name` from this scene's declarations.
pub fn dropProp(scene: &Scene, name: string) {
    replaceLines(scene, propKey(name, "type"), false, "");
    replaceLines(scene, propKey(name, "default"), false, "");
}

fn oneLine(value: string): string {
    let t = Text.new(scratch(0));
    let i = 0;
    while i < value.len {
        if value[i] == 10 || value[i] == 13 { t.push(32); } else { t.push(value[i]); }
        i += 1;
    }
    return t.str();
}

/// Set prop `name` on this scene's own placed copy `copy`; saved with the scene.
pub fn setProp(scene: &Scene, copy: int, name: string, value: string) {
    let line = Text.new(scratch(0));
    line.pushStr(scene3d.copyKey(copy, name));
    line.pushStr(" s=");
    line.pushStr(oneLine(value));
    line.push(10);
    replaceLines(scene, scene3d.copyKey(copy, name), false, line.str());
}

/// Back to the default: drop `name` from copy `copy`, or every prop of it when `name` is "".
pub fn clearProp(scene: &Scene, copy: int, name: string) {
    if name.len > 0 {
        replaceLines(scene, scene3d.copyKey(copy, name), false, "");
        return;
    }
    let t = Text.new(scratch(0));
    t.pushStr("over.");
    t.pushInt(copy);
    t.pushStr(".prop.");
    replaceLines(scene, t.str(), true, "");
}

fn keepStr(s: string): string {
    let t = Text.new(scratch(0));
    t.pushStr(s);
    return t.str();
}

/// Rename prop `old` to `name` where `scene` writes it: its declaration, if it declares it,
/// and the values set on its own copies of scene file `file` ("" for none). Values keep.
/// Returns how many props moved.
pub fn renameProp(scene: &Scene, file: string, old: string, name: string): int {
    scene3d.flushParams(scene);
    let moved = 0;
    // Copies: the lines they point into are rewritten below.
    let kind = keepStr(save.getStr(&scene.data, propKey(old, "type"), UNSET));
    if !same(kind, UNSET) {
        let def = keepStr(save.getStr(&scene.data, propKey(old, "default"), ""));
        dropProp(scene, old);
        declareProp(scene, name, kind, def);
        moved += 1;
    }
    let i = 0;
    while file.len > 0 && i < scene.len {
        let n = scene.nodes[i];
        if n.kind == INSTANCE && n.owner == 0 && same(n.scene, file) {
            let v = keepStr(save.getStr(&scene.data, scene3d.copyKey(n.id, old), UNSET));
            if !same(v, UNSET) {
                clearProp(scene, n.id, old);
                setProp(scene, n.id, name, v);
                moved += 1;
            }
        }
        i += 1;
    }
    return moved;
}
