// Part of j3.scene3d (object parameters: param lines, typed get/set, copy and filter); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

fn paramHash(id: int, field: string, size: int): int {
    let h = id - (id / size) * size;
    let i = 0;
    while i < field.len {
        h = h * 33 + int(field[i]);
        h = h - (h / size) * size;
        i += 1;
    }
    return h;
}

/// The slot of `id`'s `field` in `table`: its entry, or the empty slot it would take.
pub fn paramSlot(table: []ParamEntry, id: int, field: string): int {
    let h = paramHash(id, field, table.len);
    while table[h].id != 0 {
        if table[h].id == id && same(table[h].field, field) { return h; }
        h = nextSlot(h, table.len);
    }
    return h;
}

fn paramLines(bytes: []u8): int {
    let count = 0;
    let line = 0;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if paramId(bytes, line, end) > 0 { count += 1; }
        line = end + 1;
    }
    return count;
}

fn scanParams(scene: &Scene, bytes: []u8) {
    let line = 0;
    while line < bytes.len {
        let lineEnd = line;
        while lineEnd < bytes.len && bytes[lineEnd] != 10 { lineEnd += 1; }
        let id = paramId(bytes, line, lineEnd);
        if id > 0 {
            let at = line + 6;
            while at < lineEnd && bytes[at] != 46 { at += 1; }
            at += 1;
            let fe = at;
            while fe < lineEnd && bytes[fe] != 32 && bytes[fe] != 61 { fe += 1; }
            let field = []u8 { ptr: (bytes.ptr as int + at) as &u8, len: fe - at } as string;
            let valueAt = fe;
            while valueAt < lineEnd && bytes[valueAt] != 61 { valueAt += 1; }
            if valueAt < lineEnd {
                let slot = paramSlot(scene.params, id, field);
                if scene.params[slot].id == 0 { scene.paramCount += 1; }
                let kind = 0;
                if fe + 1 < lineEnd && bytes[fe] == 32 && bytes[fe + 1] == 102 { kind = 1; }
                if fe + 1 < lineEnd && bytes[fe] == 32 && bytes[fe + 1] == 115 { kind = 2; }
                if fe + 1 < lineEnd && bytes[fe] == 32 && bytes[fe + 1] == 114 { kind = 3; }
                scene.params[slot] = ParamEntry {
                    id: id, field: field, kind: kind,
                    value: []u8 { ptr: (bytes.ptr as int + valueAt + 1) as &u8, len: lineEnd - valueAt - 1 },
                    cap: 0, changed: false,
                };
            }
        }
        line = lineEnd + 1;
    }
}

/// Rebuild the parameter table after rewriting `param.` lines in the scene data.
pub fn rebuildParams(scene: &Scene) {
    let count = paramLines(scene.data.bytes) + paramLines(scene.placedData.bytes);
    let size = 16;
    while size < count * 2 + 16 { size *= 2; }
    if scene.params.len < size {
        scene.params = scene.arena.alloc::<ParamEntry>(size);
    }
    let i = 0;
    while i < scene.params.len { scene.params[i] = emptyParam(); i += 1; }
    scene.paramCount = 0;
    scanParams(scene, scene.data.bytes);
    scanParams(scene, scene.placedData.bytes);
    scene.paramsData = scene.data.bytes.ptr as ptr;
    scene.paramsLen = scene.data.bytes.len;
    scene.paramsPlacedData = scene.placedData.bytes.ptr as ptr;
    scene.paramsPlacedLen = scene.placedData.bytes.len;
    scene.paramsDirty = false;
    scene.placedDirty = false;
}

/// Build the parameter table if the scene data changed since it was last built.
pub fn ensureParams(scene: &Scene) {
    if scene.params.len == 0 || scene.paramsData != scene.data.bytes.ptr as ptr || scene.paramsLen != scene.data.bytes.len
        || scene.paramsPlacedData != scene.placedData.bytes.ptr as ptr || scene.paramsPlacedLen != scene.placedData.bytes.len {
        rebuildParams(scene);
    }
}

fn growParams(scene: &Scene) {
    let old = scene.params;
    let fresh = scene.arena.alloc::<ParamEntry>(old.len * 2);
    let i = 0;
    while i < fresh.len { fresh[i] = emptyParam(); i += 1; }
    i = 0;
    while i < old.len {
        if old[i].id != 0 {
            let at = paramSlot(fresh, old[i].id, old[i].field);
            fresh[at] = old[i];
        }
        i += 1;
    }
    scene.params = fresh;
}

fn ensurePlaced(scene: &Scene) {
    if scene.placed as ptr != 0 { return; }
    let header = scene.arena.alloc::<Arena>(1);
    scene.placed = &header[0];
    *scene.placed = Arena.create(64 * 1024);
    scene.placedData = save.empty(scene.placed);
    scene.paramsPlacedData = scene.placedData.bytes.ptr as ptr;
    scene.paramsPlacedLen = 0;
}

fn setParam(scene: &Scene, id: int, field: string, kind: int, value: string) {
    ensureParams(scene);
    if id >= GRAFT { ensurePlaced(scene); }
    if scene.paramCount * 2 + 2 >= scene.params.len { growParams(scene); }
    let slot = paramSlot(scene.params, id, field);
    if scene.params[slot].id == 0 {
        scene.params[slot].id = id;
        let name = Text.new(scene.arena);
        name.pushStr(field);
        scene.params[slot].field = name.str();
        scene.paramCount += 1;
    }
    let entry = &scene.params[slot];
    if !entry.changed || entry.cap < value.len {
        let cap = 32;
        while cap < value.len { cap *= 2; }
        let memory = scene.arena.alloc::<u8>(cap);
        entry.value = []u8 { ptr: memory.ptr, len: value.len };
        entry.cap = cap;
    } else {
        entry.value = []u8 { ptr: entry.value.ptr, len: value.len };
    }
    let i = 0;
    while i < value.len { entry.value[i] = value[i]; i += 1; }
    entry.kind = kind;
    entry.changed = true;
    if id >= GRAFT { scene.placedDirty = true; }
    else { scene.paramsDirty = true; }
}

fn writeParam(entry: ParamEntry, out: &Text) {
    out.pushStr("param.");
    out.pushInt(entry.id);
    out.push(46);
    out.pushStr(entry.field);
    if entry.kind == 1 { out.pushStr(" f"); }
    if entry.kind == 2 { out.pushStr(" s"); }
    if entry.kind == 3 { out.pushStr(" r"); }
    out.push(61);
    out.pushStr(entry.value as string);
    out.push(10);
}

/// Materialize edited fields only at save or snapshot boundaries. Old blobs stay immutable for undo.
pub fn flushParams(scene: &Scene) {
    ensureParams(scene);
    if scene.paramsDirty {
        let own = Text.new(scene.arena);
        let bytes = scene.data.bytes;
        let line = 0;
        while line < bytes.len {
            let end = line;
            while end < bytes.len && bytes[end] != 10 { end += 1; }
            if paramId(bytes, line, end) == 0 {
                let i = line;
                while i < end { own.push(bytes[i]); i += 1; }
                own.push(10);
            }
            line = end + 1;
        }
        let slot = 0;
        while slot < scene.params.len {
            if scene.params[slot].id > 0 && scene.params[slot].id < GRAFT {
                writeParam(scene.params[slot], &own);
            }
            slot += 1;
        }
        scene.data.bytes = own.bytes;
        scene.paramsDirty = false;
    }
    if scene.placedDirty {
        ensurePlaced(scene);
        let placed = Text.new(scene.placed);
        let placedSlot = 0;
        while placedSlot < scene.params.len {
            if scene.params[placedSlot].id >= GRAFT { writeParam(scene.params[placedSlot], &placed); }
            placedSlot += 1;
        }
        scene.placedData.bytes = placed.bytes;
        scene.placedDirty = false;
    }
    scene.paramsData = scene.data.bytes.ptr as ptr;
    scene.paramsLen = scene.data.bytes.len;
    scene.paramsPlacedData = scene.placedData.bytes.ptr as ptr;
    scene.paramsPlacedLen = scene.placedData.bytes.len;
}

/// A float parameter scoped to one object instance.
pub fn number(scene: &Scene, id: int, field: string, fallback: f32): f32 {
    ensureParams(scene);
    let at = paramSlot(scene.params, id, field);
    // An integer literal (`param.speed=3`) reads as a float too.
    if scene.params[at].id == 0 || (scene.params[at].kind != 1 && scene.params[at].kind != 0) { return fallback; }
    return save.parseFloat(scene.params[at].value, 0);
}

pub fn setNumber(scene: &Scene, id: int, field: string, value: f32) {
    let text = Text.new(scratch(0));
    text.pushFloat(value);
    setParam(scene, id, field, 1, text.str());
}

pub fn flag(scene: &Scene, id: int, field: string, fallback: bool): bool {
    ensureParams(scene);
    let at = paramSlot(scene.params, id, field);
    if scene.params[at].id == 0 || scene.params[at].kind == 3 { return fallback; }
    return save.parseInt(scene.params[at].value, 0, 0) != 0;
}

pub fn setFlag(scene: &Scene, id: int, field: string, value: bool) {
    if value { setParam(scene, id, field, 0, "1"); }
    else { setParam(scene, id, field, 0, "0"); }
}

pub fn integer(scene: &Scene, id: int, field: string, fallback: int): int {
    ensureParams(scene);
    let at = paramSlot(scene.params, id, field);
    if scene.params[at].id == 0 || scene.params[at].kind == 3 { return fallback; }
    return save.parseInt(scene.params[at].value, 0, fallback);
}

pub fn setInteger(scene: &Scene, id: int, field: string, value: int) {
    let text = Text.new(scratch(0));
    text.pushInt(value);
    setParam(scene, id, field, 0, text.str());
}

/// A `vec3` or `color` field, stored as numbers `<field>.x`, `.y`, and `.z`.
pub fn vector(scene: &Scene, id: int, field: string, fallback: Vec3): Vec3 {
    return Vec3.xyz(number(scene, id, part(field, "x"), fallback.x), number(scene, id, part(field, "y"), fallback.y),
        number(scene, id, part(field, "z"), fallback.z));
}

pub fn setVector(scene: &Scene, id: int, field: string, value: Vec3) {
    setNumber(scene, id, part(field, "x"), value.x);
    setNumber(scene, id, part(field, "y"), value.y);
    setNumber(scene, id, part(field, "z"), value.z);
}

/// `field.axis` in the scratch arena.
fn part(field: string, axis: string): string {
    let t = Text.new(scratch(0));
    t.pushStr(field);
    t.push(46);
    t.pushStr(axis);
    return t.str();
}

/// An `object` field: the id of another object in this scene, or 0. Copies and placed
/// scenes point it at the matching copy when that object came along.
pub fn object(scene: &Scene, id: int, field: string): int {
    ensureParams(scene);
    let at = paramSlot(scene.params, id, field);
    if scene.params[at].id == 0 || scene.params[at].kind != 3 { return 0; }
    return save.parseInt(scene.params[at].value, 0, 0);
}

pub fn setObject(scene: &Scene, id: int, field: string, target: int) {
    let text = Text.new(scratch(0));
    text.pushInt(target);
    setParam(scene, id, field, 3, text.str());
}

pub fn label(scene: &Scene, id: int, field: string, fallback: string): string {
    ensureParams(scene);
    let at = paramSlot(scene.params, id, field);
    if scene.params[at].id == 0 || scene.params[at].kind == 3 { return fallback; }
    return scene.params[at].value as string;
}

pub fn setLabel(scene: &Scene, id: int, field: string, value: string) {
    let text = Text.new(scratch(0));
    let i = 0;
    while i < value.len {
        if value[i] == 10 || value[i] == 13 { text.push(32); }
        else { text.push(value[i]); }
        i += 1;
    }
    setParam(scene, id, field, 2, text.str());
}

fn lineInt(t: &Text, field: string, value: int) {
    t.pushStr(field);
    t.push(61);
    t.pushInt(value);
    t.push(10);
}

fn lineFloat(t: &Text, field: string, value: f32) {
    t.pushStr(field);
    t.pushStr(" f=");
    t.pushFloat(value);
    t.push(10);
}

fn lineStr(t: &Text, field: string, value: string) {
    t.pushStr(field);
    t.pushStr(" s=");
    let i = 0;
    while i < value.len {
        let b = value[i];
        if b == 10 || b == 13 { t.push(32); } else { t.push(b); }
        i += 1;
    }
    t.push(10);
}

/// The id in a `param.<id>.<field>` line, or 0 for any other line.
fn paramId(bytes: []u8, at: int, end: int): int { return keyId(bytes, at, end, "param."); }

/// The id in a `<prefix><id>.<rest>` line, or 0 for any other line.
pub fn keyId(bytes: []u8, at: int, end: int, prefix: string): int {
    if end - at <= prefix.len { return 0; }
    let i = 0;
    while i < prefix.len {
        if bytes[at + i] != prefix[i] { return 0; }
        i += 1;
    }
    let c = at + prefix.len;
    let id = 0;
    while c < end && bytes[c] >= 48 && bytes[c] <= 57 {
        id = id * 10 + int(bytes[c]) - 48;
        c += 1;
    }
    if c >= end || bytes[c] != 46 { return 0; }
    return id;
}

/// Append `src`'s `param.<from[k]>.*` lines to `extra` as `param.<to[k]>.*`. An object field that
/// names one of `from` is pointed at its `to`.
pub fn appendParams(src: &Save, from: []int, to: []int, extra: &Text, mem: &Arena) {
    if from.len == 0 { return; }
    let size = 16;
    while size < from.len * 2 { size = size * 2; }
    // Open addressing: slot holds k + 1 for `from[k]`.
    let table = mem.alloc::<int>(size);
    let k = 0;
    while k < size { table[k] = 0; k += 1; }
    k = 0;
    while k < from.len {
        let h = bucket(from[k], size);
        while table[h] != 0 { h = nextSlot(h, size); }
        table[h] = k + 1;
        k += 1;
    }
    let line = 0;
    while line < src.bytes.len {
        let end = line;
        while end < src.bytes.len && src.bytes[end] != 10 { end += 1; }
        let id = paramId(src.bytes, line, end);
        if id > 0 {
            let probe = bucket(id, size);
            while table[probe] != 0 && from[table[probe] - 1] != id { probe = nextSlot(probe, size); }
            if table[probe] != 0 {
                extra.pushStr("param.");
                extra.pushInt(to[table[probe] - 1]);
                let c = line + 6;
                while src.bytes[c] != 46 { c += 1; }
                while c < end && src.bytes[c] != 61 {
                    extra.push(src.bytes[c]);
                    c += 1;
                }
                // An object field names another object; follow it to that object's copy.
                if c > 1 && src.bytes[c - 2] == 32 && src.bytes[c - 1] == 114 {
                    let target = save.parseInt(src.bytes, c + 1, 0);
                    if target > 0 {
                        let hit = bucket(target, size);
                        while table[hit] != 0 && from[table[hit] - 1] != target { hit = nextSlot(hit, size); }
                        if table[hit] != 0 { target = to[table[hit] - 1]; }
                    }
                    extra.push(61);
                    extra.pushInt(target);
                } else {
                    while c < end {
                        extra.push(src.bytes[c]);
                        c += 1;
                    }
                }
                extra.push(10);
            }
        }
        line = end + 1;
    }
}

/// Drop every parameter line of object `id`.
pub fn clearParams(scene: &Scene, id: int) {
    flushParams(scene);
    let own = filterParams(&scene.data, id, 0 as ptr, keepParam);
    let placed = filterParams(&scene.placedData, id, 0 as ptr, keepParam);
    if own || placed { rebuildParams(scene); }
}

/// Keep only the parameter lines where `keep(ctx, id, field)` is true. `ctx` is passed through.
pub fn retainParams(scene: &Scene, ctx: ptr, keep: fn(ptr, int, string): bool) {
    flushParams(scene);
    let own = filterParams(&scene.data, -1, ctx, keep);
    let placed = filterParams(&scene.placedData, -1, ctx, keep);
    if own || placed { rebuildParams(scene); }
}

fn keepParam(_ctx: ptr, _id: int, _field: string): bool { return true; }

fn filterParams(data: &Save, excluded: int, ctx: ptr, keep: fn(ptr, int, string): bool): bool {
    let bytes = data.bytes;
    let out = Text.new(data.arena);
    let line = 0;
    let dropped = false;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let id = paramId(bytes, line, end);
        let stays = true;
        if id == excluded { stays = false; }
        else if id > 0 {
            let f = line + 6;
            while bytes[f] != 46 { f += 1; }
            f += 1;
            let fe = f;
            while fe < end && bytes[fe] != 32 && bytes[fe] != 61 { fe += 1; }
            stays = keep(ctx, id, []u8 { ptr: (bytes.ptr as int + f) as &u8, len: fe - f } as string);
        }
        if stays {
            let k = line;
            while k < end { out.push(bytes[k]); k += 1; }
            out.push(10);
        } else {
            dropped = true;
        }
        line = end + 1;
    }
    if dropped { data.bytes = out.bytes; }
    return dropped;
}
