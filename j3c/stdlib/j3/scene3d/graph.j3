// Part of j3.scene3d (growing the node list, add, move, reparent, remove, world transforms); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

/// Make `scene.len` at least `count`, filling new slots with default nodes.
fn grow(scene: &Scene, count: int) {
    if count <= scene.len { return; }
    if count > scene.nodes.len {
        let fresh = scene.arena.alloc::<Node>(count * 2 + 16);
        let k = 0;
        while k < scene.len {
            fresh[k] = scene.nodes[k];
            k += 1;
        }
        scene.nodes = fresh;
    }
    while scene.len < count {
        scene.nodes[scene.len] = blank(scene.len + 1);
        scene.len += 1;
    }
}

fn ensure(scene: &Scene) {
    if scene.len < scene.nodes.len {
        return;
    }
    let fresh = scene.arena.alloc::<Node>(scene.nodes.len * 2 + 16);
    let i = 0;
    while i < scene.len {
        fresh[i] = scene.nodes[i];
        i += 1;
    }
    scene.nodes = fresh;
}

/// Index of `id`, or -1 when absent. Zero is the root sentinel.
pub fn index(scene: &Scene, id: int): int {
    link(scene);
    if scene.slots.len == 0 { return -1; }
    let size = scene.slots.len;
    let h = bucket(id, size);
    while scene.slots[h] != 0 {
        let at = scene.slots[h] - 1;
        if at < scene.len && scene.nodes[at].id == id { return at; }
        h = nextSlot(h, size);
    }
    return -1;
}

/// Next probe after `h` in a table of `size`.
pub fn nextSlot(h: int, size: int): int {
    if h + 1 >= size { return 0; }
    return h + 1;
}

/// Fibonacci hash of `id` into `0..size`.
pub fn bucket(id: int, size: int): int {
    let x = (id * (0 - 7046029254386353131)) / 1048576;
    if x < 0 { x = 0 - x; }
    return x - (x / size) * size;
}

/// Rebuild the id table. Call after rewriting `nodes` or `len` outside this module.
pub fn relink(scene: &Scene) {
    let size = 16;
    while size < scene.len * 2 + 16 { size = size * 2; }
    if scene.slots.len < size {
        scene.slots = scene.arena.alloc::<int>(size);
    }
    let k = 0;
    while k < scene.slots.len {
        scene.slots[k] = 0;
        k += 1;
    }
    scene.linked = 0;
    link(scene);
    ensureParams(scene);
}

/// Add nodes appended since the last call to the id table, growing it when half full.
fn link(scene: &Scene) {
    if scene.linked == scene.len { return; }
    if scene.linked > scene.len || scene.len * 2 + 16 > scene.slots.len {
        relink(scene);
        return;
    }
    let size = scene.slots.len;
    while scene.linked < scene.len {
        let h = bucket(scene.nodes[scene.linked].id, size);
        while scene.slots[h] != 0 { h = nextSlot(h, size); }
        scene.slots[h] = scene.linked + 1;
        scene.linked += 1;
    }
}

/// Add a node under `parent`, falling back to the root if missing.
pub fn add(scene: &Scene, kind: int, name: string, parent: int): int {
    ensure(scene);
    if parent != 0 && index(scene, parent) < 0 {
        parent = 0;
    }
    let id = scene.nextId;
    scene.nextId += 1;
    let n = blank(id);
    n.parent = parent;
    n.kind = kind;
    n.name = name;
    scene.nodes[scene.len] = n;
    scene.len += 1;
    return id;
}

/// Reparent while preserving the node's local transform. Returns false for cycles.
/// Move node `id` to array slot `slot`, shifting the nodes between. Siblings are listed in
/// array order, so this reorders them; nothing else depends on the order.
pub fn moveTo(scene: &Scene, id: int, slot: int) {
    let from = index(scene, id);
    if from < 0 { return; }
    let to = slot;
    if to < 0 { to = 0; }
    if to >= scene.len { to = scene.len - 1; }
    if to == from { return; }
    let n = scene.nodes[from];
    let i = from;
    while i < to {
        scene.nodes[i] = scene.nodes[i + 1];
        i += 1;
    }
    while i > to {
        scene.nodes[i] = scene.nodes[i - 1];
        i -= 1;
    }
    scene.nodes[to] = n;
    relink(scene);
}

pub fn reparent(scene: &Scene, id: int, parent: int): bool {
    let child = index(scene, id);
    if child < 0 {
        return false;
    }
    let cursor = parent;
    let steps = 0;
    while cursor != 0 && steps <= scene.len {
        if cursor == id {
            return false;
        }
        let at = index(scene, cursor);
        if at < 0 {
            return false;
        }
        cursor = scene.nodes[at].parent;
        steps += 1;
    }
    if steps > scene.len {
        return false;
    }
    scene.nodes[child].parent = parent;
    return true;
}

/// Delete a node and all descendants, keeping the order of everything else.
/// Objects whose parent no longer exists go too.
pub fn remove(scene: &Scene, id: int) {
    let mem = Arena.create(scene.len * 8 + 64);
    // 0 not yet known, 1 goes, 2 stays.
    let state = mem.alloc::<int>(scene.len);
    let i = 0;
    while i < scene.len {
        state[i] = 0;
        i += 1;
    }
    i = 0;
    while i < scene.len {
        let verdict = 2;
        let at = i;
        let steps = 0;
        while true {
            if state[at] != 0 { verdict = state[at]; break; }
            if scene.nodes[at].id == id { verdict = 1; break; }
            if scene.nodes[at].parent == 0 { break; }
            let up = index(scene, scene.nodes[at].parent);
            if up < 0 { verdict = 1; break; }
            steps += 1;
            if steps > scene.len { break; }
            at = up;
        }
        at = i;
        steps = 0;
        while state[at] == 0 && steps <= scene.len {
            state[at] = verdict;
            if scene.nodes[at].id == id || scene.nodes[at].parent == 0 { break; }
            let above = index(scene, scene.nodes[at].parent);
            if above < 0 { break; }
            at = above;
            steps += 1;
        }
        i += 1;
    }
    let kept = 0;
    i = 0;
    while i < scene.len {
        if state[i] == 1 {
            unload(&scene.nodes[i]);
        } else {
            scene.nodes[kept] = scene.nodes[i];
            kept += 1;
        }
        i += 1;
    }
    scene.len = kept;
    mem.destroy();
    relink(scene);
}

/// Local transform uses XYZ Euler angles in radians.
pub fn local(n: Node): Mat4 {
    let m = Mat4.translate(n.position.x, n.position.y, n.position.z);
    let rx = Mat4.rotate(Vec3.xyz(1, 0, 0), n.rotation.x);
    let ry = Mat4.rotate(Vec3.xyz(0, 1, 0), n.rotation.y);
    let rz = Mat4.rotate(Vec3.xyz(0, 0, 1), n.rotation.z);
    let scale = Mat4.scale(n.scale.x, n.scale.y, n.scale.z);
    return m.mul(rz).mul(ry).mul(rx).mul(scale);
}

/// World transform; malformed parent chains stop after `len` links.
pub fn world(scene: &Scene, id: int): Mat4 {
    let at = index(scene, id);
    if at < 0 {
        return Mat4.identity();
    }
    let model = local(scene.nodes[at]);
    let parent = scene.nodes[at].parent;
    let depth = 0;
    while parent != 0 && depth < scene.len {
        let p = index(scene, parent);
        if p < 0 {
            break;
        }
        model = local(scene.nodes[p]).mul(model);
        parent = scene.nodes[p].parent;
        depth += 1;
    }
    return model;
}

/// Fill one world matrix per node. Parents are resolved on demand and each node is computed once.
pub fn worlds(scene: &Scene, out: []Mat4) {
    let state = scratch(0).alloc::<u8>(scene.len);
    let chain = scratch(0).alloc::<int>(scene.len);
    let i = 0;
    while i < scene.len { state[i] = 0; i += 1; }
    i = 0;
    while i < scene.len {
        if state[i] == 0 {
            let used = 0;
            let at = i;
            while at >= 0 && state[at] == 0 {
                state[at] = 1;
                chain[used] = at;
                used += 1;
                at = index(scene, scene.nodes[at].parent);
            }
            while used > 0 {
                used -= 1;
                let node = chain[used];
                let parent = index(scene, scene.nodes[node].parent);
                let base = Mat4.identity();
                if parent >= 0 && state[parent] == 2 { base = out[parent]; }
                out[node] = base.mul(local(scene.nodes[node]));
                state[node] = 2;
            }
        }
        i += 1;
    }
}
