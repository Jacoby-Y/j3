// Part of j3.scene3d (node tags, field setters, load and parse); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

/// Where tag `name` is in `n.tags` (`name` or `name=value`): the index after the name, or -1.
fn tagAt(n: Node, name: string): int {
    let t = n.tags;
    let from = 0;
    while from < t.len {
        let to = from;
        while to < t.len && t[to] != 44 { to += 1; }
        let k = 0;
        while k < name.len && from + k < to && t[from + k] == name[k] { k += 1; }
        if k == name.len && (from + k == to || t[from + k] == 61) { return from + k; }
        from = to + 1;
    }
    return -1;
}

/// `n` has tag `name`, bare or with a value (`launch=30` has `launch`).
pub fn hasTag(n: Node, name: string): bool {
    return tagAt(n, name) >= 0;
}

/// The value of tag `name=value` on `n`; `fallback` when it has no such tag or no value.
pub fn tagValue(n: Node, name: string, fallback: string): string {
    let at = tagAt(n, name);
    if at < 0 || at >= n.tags.len || n.tags[at] != 61 { return fallback; }
    let end = at + 1;
    while end < n.tags.len && n.tags[end] != 44 { end += 1; }
    return []u8 { ptr: (n.tags.ptr as int + at + 1) as &u8, len: end - at - 1 } as string;
}

/// True when `bytes[at..end]` is exactly `name`.
pub fn fieldIs(bytes: []u8, at: int, end: int, name: string): bool {
    if end - at != name.len { return false; }
    let i = 0;
    while i < name.len {
        if bytes[at + i] != name[i] { return false; }
        i += 1;
    }
    return true;
}

/// Set one field of `n` from a `node.<i>.<field>` line. `v` indexes the value, `end` the line end.
fn setField(n: &Node, bytes: []u8, f: int, fe: int, v: int, end: int) {
    let text = []u8 { ptr: (bytes.ptr as int + v) as &u8, len: end - v } as string;
    if fieldIs(bytes, f, fe, "id") { n.id = save.parseInt(bytes, v, n.id); }
    else if fieldIs(bytes, f, fe, "parent") { n.parent = save.parseInt(bytes, v, 0); }
    else if fieldIs(bytes, f, fe, "kind") { n.kind = save.parseInt(bytes, v, GROUP); }
    else if fieldIs(bytes, f, fe, "doubleSided") { n.doubleSided = save.parseInt(bytes, v, 0) != 0; }
    else if fieldIs(bytes, f, fe, "name") { n.name = text; }
    else if fieldIs(bytes, f, fe, "asset") { n.asset = text; }
    else if fieldIs(bytes, f, fe, "texture") { n.texture = text; }
    else if fieldIs(bytes, f, fe, "script") { n.script = text; }
    else if fieldIs(bytes, f, fe, "scene") { n.scene = text; }
    else if fieldIs(bytes, f, fe, "px") { n.position.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "py") { n.position.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "pz") { n.position.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rx") { n.rotation.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "ry") { n.rotation.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rz") { n.rotation.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sx") { n.scale.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sy") { n.scale.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sz") { n.scale.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "fov") { n.fov = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "near") { n.near = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "far") { n.far = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cr") { n.color.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cg") { n.color.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cb") { n.color.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tr") { n.tint.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tg") { n.tint.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tb") { n.tint.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "range") { n.range = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "alpha") { n.alpha = save.parseInt(bytes, v, OPAQUE); }
    else if fieldIs(bytes, f, fe, "opacity") { n.opacity = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "material") { n.material = text; }
    else if fieldIs(bytes, f, fe, "effects") { n.effects = text; }
    else if fieldIs(bytes, f, fe, "tags") { n.tags = text; }
}

/// Read a scene written by `store`, with every instanced scene added under its
/// instance node. Missing files yield an empty scene.
pub fn load(path: string, arena: &Arena): Scene {
    let scene = read(path, arena);
    expand(&scene, path);
    return scene;
}

/// Read a scene file as stored, without adding instanced scenes. One pass: `node.*` lines
/// become nodes, every other line (`param.*`, `scene.*`) stays in `scene.data`.
pub fn read(path: string, arena: &Arena): Scene {
    let bytes = arena.alloc::<u8>(0);
    let found = false;
    match io.readFile(path, arena) {
        Result.Ok(b) { bytes = b; found = true; }
        Result.Err(_) {}
    }
    return parse(bytes, found, arena);
}

/// A scene from file text already in memory (`read` without the file). Node strings point
/// into `bytes`, so they must outlive the scene.
pub fn parse(bytes: []u8, found: bool, arena: &Arena): Scene {
    let rest = Text.new(arena);
    let scene = Scene {
        nodes: arena.alloc::<Node>(0),
        len: 0,
        nextId: 0,
        data: save.empty(arena),
        arena: arena,
        placedData: save.empty(arena),
        params: arena.alloc::<ParamEntry>(0),
        paramCount: 0,
        paramsData: 0 as ptr,
        paramsLen: 0,
        paramsDirty: false,
        paramsPlacedData: 0 as ptr,
        paramsPlacedLen: 0,
        placedDirty: false,
        placed: 0 as &Arena,
        slots: arena.alloc::<int>(0),
        linked: 0,
        grafted: GRAFT,
        found: found,
        tooDeep: false,
        parseError: "",
        urpChild: "",
        flush: arena.alloc::<f32>(0),
        flushSig: 0,
        flushStill: 0,
        flushStale: true,
        childUrp: Env {
            sunDir: Vec3.zero(), sunColor: Vec3.zero(), sky: Vec3.zero(), fogStart: 0, fogEnd: 0,
            shadows: false, shadowSize: 0, urp: false, bounces: 1, samples: 1, tracedShadows: false,
        },
    };
    let line = 0;
    if startsWith(bytes, 0, bytes.len, "j3scene") {
        parseV2(&scene, bytes, &rest);
        line = bytes.len;
    }
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let i = nodeLine(bytes, line, end);
        if i >= 0 {
            // `node.<i>.<field>[ f| s]=<value>`
            let f = line + 5;
            while bytes[f] != 46 { f += 1; }
            f += 1;
            let fe = f;
            while fe < end && bytes[fe] != 32 && bytes[fe] != 61 { fe += 1; }
            let v = fe;
            while v < end && bytes[v] != 61 { v += 1; }
            if v < end {
                grow(&scene, i + 1);
                setField(&scene.nodes[i], bytes, f, fe, v + 1, end);
            }
        } else {
            let k = line;
            while k < end { rest.push(bytes[k]); k += 1; }
            rest.push(10);
        }
        line = end + 1;
    }
    scene.data.bytes = rest.bytes;
    scene.nextId = save.getInt(&scene.data, "scene.nextId", scene.len + 1);
    let j = 0;
    while j < scene.len {
        if scene.nodes[j].id >= scene.nextId && scene.nodes[j].id < GRAFT { scene.nextId = scene.nodes[j].id + 1; }
        j += 1;
    }
    relink(&scene);
    return scene;
}

/// `i` for a `node.<i>.` line, or -1. Rejects indexes no file this size could hold.
fn nodeLine(bytes: []u8, at: int, end: int): int {
    let prefix = "node.";
    if end - at <= prefix.len { return -1; }
    let k = 0;
    while k < prefix.len {
        if bytes[at + k] != prefix[k] { return -1; }
        k += 1;
    }
    let c = at + prefix.len;
    let i = 0;
    let any = false;
    while c < end && bytes[c] >= 48 && bytes[c] <= 57 {
        i = i * 10 + int(bytes[c]) - 48;
        if i > bytes.len { return -1; }
        c += 1;
        any = true;
    }
    if !any || c >= end || bytes[c] != 46 { return -1; }
    return i;
}
