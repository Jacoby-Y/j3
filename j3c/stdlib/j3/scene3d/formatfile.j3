// Part of j3.scene3d (writer: environment text, whole-file text, store, startsWith); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

fn envVecText(t: &Text, name: string, v: Vec3, a: f32, b: f32, c: f32) {
    if q6(v.x) == q6(a) && q6(v.y) == q6(b) && q6(v.z) == q6(c) { return; }
    t.push(32);
    t.pushStr(name);
    t.push(61);
    pushVec(t, v);
}

fn envFloatText(t: &Text, name: string, v: f32, fallback: f32) {
    if q6(v) == q6(fallback) { return; }
    t.push(32);
    t.pushStr(name);
    t.push(61);
    pushNum(t, v);
}

fn envIntText(t: &Text, name: string, v: int, fallback: int) {
    if v == fallback { return; }
    t.push(32);
    t.pushStr(name);
    t.push(61);
    t.pushInt(v);
}

fn flagInt(b: bool): int {
    if b { return 1; }
    return 0;
}

/// The `env` line: lighting that differs from the defaults, or nothing.
fn writeEnv(scene: &Scene, t: &Text, mem: &Arena) {
    let e = environment(scene);
    let tok = Text.new(mem);
    envVecText(&tok, "sun", e.sunDir, 0.45, 0.8, 0.25);
    envVecText(&tok, "sunColor", e.sunColor, 1.0, 0.95, 0.85);
    envVecText(&tok, "sky", e.sky, 0.12, 0.17, 0.24);
    envFloatText(&tok, "fogStart", e.fogStart, 80.0);
    envFloatText(&tok, "fogEnd", e.fogEnd, 400.0);
    envIntText(&tok, "shadows", flagInt(e.shadows), 1);
    envFloatText(&tok, "shadowSize", e.shadowSize, 30.0);
    envIntText(&tok, "urp", flagInt(e.urp), 0);
    envIntText(&tok, "urpBounces", e.bounces, 2);
    envIntText(&tok, "urpSamples", e.samples, 1);
    envIntText(&tok, "urpShadows", flagInt(e.tracedShadows), 0);
    envFloatText(&tok, "urpShadowNear", e.traceNear, 40.0);
    if tok.bytes.len > 0 {
        t.pushStr("env");
        t.pushStr(tok.str());
        t.push(10);
    }
}

fn lineLess(bytes: []u8, a: int, b: int): bool {
    let ea = eol(bytes, a);
    let eb = eol(bytes, b);
    while a < ea && b < eb {
        if bytes[a] != bytes[b] { return bytes[a] < bytes[b]; }
        a += 1;
        b += 1;
    }
    return a == ea && b < eb;
}

/// The scene as v2 text (header, `env`, objects, then the `prop.` declarations).
fn fileText(scene: &Scene, t: &Text, mem: &Arena) {
    t.pushStr("j3scene 2 next=");
    t.pushInt(scene.nextId);
    t.push(10);
    writeEnv(scene, t, mem);
    let slots = mem.alloc::<int>(scene.len + 1);
    let depths = mem.alloc::<int>(scene.len + 1);
    let count = treeOrder(scene, mem, slots, depths);
    let tmp = Arena.create(64 * 1024);
    let prevKids = false;
    let firstTop = true;
    let k = 0;
    while k < count {
        if depths[k] == 0 {
            let kids = k + 1 < count && depths[k + 1] > 0;
            if firstTop || prevKids || kids { t.push(10); }
            firstTop = false;
            prevKids = kids;
        }
        nodeText(scene, slots[k], depths[k], t, &tmp);
        tmp.rewind(0);
        k += 1;
    }
    tmp.destroy();
    let data = scene.data.bytes;
    let props = 0;
    let at = 0;
    let end = 0;
    while at < data.len {
        end = eol(data, at);
        if startsWith(data, at, end, "prop.") { props += 1; }
        at = end + 1;
    }
    if props == 0 { return; }
    let order = mem.alloc::<int>(props);
    let n = 0;
    at = 0;
    while at < data.len {
        end = eol(data, at);
        if startsWith(data, at, end, "prop.") {
            let j = n;
            while j > 0 && lineLess(data, at, order[j - 1]) {
                order[j] = order[j - 1];
                j -= 1;
            }
            order[j] = at;
            n += 1;
        }
        at = end + 1;
    }
    t.push(10);
    let i = 0;
    while i < n {
        t.pushStr(data[order[i]..eol(data, order[i])] as string);
        t.push(10);
        i += 1;
    }
}

/// Persist all node edits in one pass. Parameter lines stay in `data`.
/// Returns false on a write error. Allocates nothing that outlives the call.
pub fn store(scene: &Scene, path: string): bool {
    // The file had something this reader could not use; writing now would lose it.
    if scene.parseError.len > 0 { return false; }
    flushParams(scene);
    let mem = Arena.create(64 * 1024 + scene.len * 512 + scene.data.bytes.len);
    let ok = write(scene, path, &mem);
    mem.destroy();
    return ok;
}

fn write(scene: &Scene, path: string, mem: &Arena): bool {
    let t = Text.new(mem);
    fileText(scene, &t, mem);
    let temp = Text.new(mem);
    temp.pushStr(path);
    temp.pushStr(".j3tmp");
    match io.writeFile(temp.str(), t.bytes) {
        Result.Ok(_) {
            let from = Text.new(mem);
            from.pushStr(temp.str());
            from.push(0);
            let to = Text.new(mem);
            to.pushStr(path);
            to.push(0);
            return libc.rename(&from.bytes[0] as cstr, &to.bytes[0] as cstr) == 0;
        }
        Result.Err(_) { return false; }
    }
}

/// Whether `bytes[at..end]` starts with `prefix`.
pub fn startsWith(bytes: []u8, at: int, end: int, prefix: string): bool {
    if end - at < prefix.len { return false; }
    let k = 0;
    while k < prefix.len {
        if bytes[at + k] != prefix[k] { return false; }
        k += 1;
    }
    return true;
}
