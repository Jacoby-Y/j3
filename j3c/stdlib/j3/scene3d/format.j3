// Part of j3.scene3d (scene file format v2: read, write, store); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

// ---- Scene file format v2 ----
// One object per line, indented two spaces a level, defaults left out: see "Scene file format"
// in j3c/editor/README.md. `tools/j3scene_migrate.py` writes the same text from v1 files, so a
// rule changed here changes there. Rotation is degrees in the file and radians in `Node`.

fn eol(bytes: []u8, at: int): int {
    let end = at;
    while end < bytes.len && bytes[end] != 10 { end += 1; }
    return end;
}

fn skipSp(bytes: []u8, at: int, end: int): int {
    while at < end && bytes[at] == 32 { at += 1; }
    return at;
}

/// End of the token that starts at `at`: the next space outside quotes.
fn tokEnd(bytes: []u8, at: int, end: int): int {
    let i = at;
    let quoted = false;
    while i < end {
        let b = bytes[i];
        if quoted {
            if b == 92 { i += 1; } else if b == 34 { quoted = false; }
        } else if b == 34 {
            quoted = true;
        } else if b == 32 {
            return i;
        }
        i += 1;
    }
    return end;
}

fn eqAt(bytes: []u8, at: int, end: int): int {
    if at < end && bytes[at] == 34 { return -1; }
    let i = at;
    while i < end && bytes[i] != 61 { i += 1; }
    if i >= end { return -1; }
    return i;
}

fn hasByte(bytes: []u8, at: int, end: int, b: u8): bool {
    while at < end {
        if bytes[at] == b { return true; }
        at += 1;
    }
    return false;
}

/// The `#id` that ends an object line, or 0. `start` gets where that token begins.
fn trailingId(bytes: []u8, s: int, end: int, start: &int): int {
    let e = end;
    while e > s && (bytes[e - 1] == 32 || bytes[e - 1] == 13) { e -= 1; }
    let b = e;
    while b > s && bytes[b - 1] != 32 { b -= 1; }
    if b + 1 >= e || bytes[b] != 35 { return 0; }
    let i = b + 1;
    while i < e {
        if bytes[i] < 48 || bytes[i] > 57 { return 0; }
        i += 1;
    }
    *start = b;
    return save.parseInt(bytes, b + 1, 0);
}

/// A `key=value` line of the data section (`prop.door.type s=bool`): the first token ends in `=`
/// or in ` f=`, ` s=`, ` r=`.
fn isDataLine(bytes: []u8, s: int, end: int): bool {
    let i = s;
    while i < end && bytes[i] != 32 && bytes[i] != 61 && bytes[i] != 34 { i += 1; }
    if i == s || i >= end { return false; }
    if bytes[i] == 61 { return true; }
    if bytes[i] != 32 || i + 2 >= end || bytes[i + 2] != 61 { return false; }
    return bytes[i + 1] == 102 || bytes[i + 1] == 115 || bytes[i + 1] == 114;
}

/// What a v2 line is: 0 blank, 1 `//` note, 2 header, 3 `env`, 4 data, 5 object.
fn lineKind(bytes: []u8, at: int, s: int, end: int): int {
    if s >= end || (s == end - 1 && bytes[s] == 13) { return 0; }
    if startsWith(bytes, s, end, "//") { return 1; }
    if at == 0 && startsWith(bytes, s, end, "j3scene") { return 2; }
    if s == at && startsWith(bytes, s, end, "env ") {
        let t = skipSp(bytes, s + 3, end);
        if eqAt(bytes, t, tokEnd(bytes, t, end)) >= 0 { return 3; }
    }
    if s == at && isDataLine(bytes, s, end) { return 4; }
    return 5;
}

struct V2 {
    scene: &Scene;
    bytes: []u8;
    rest: &Text;
    arena: &Arena;
    /// Next id for an object line without `#id`.
    auto: int;
    /// `stack[d]` is the id of the last object seen at depth `d`; `open` is how many are set.
    stack: []int;
    open: int;
    note: Text;
    hasNote: bool;
    ln: int;
}

fn v2Fail(p: &V2, message: string) {
    if p.scene.parseError.len > 0 { return; }
    let t = Text.new(p.arena);
    t.pushStr("line ");
    t.pushInt(p.ln);
    t.pushStr(": ");
    t.pushStr(message);
    p.scene.parseError = t.str();
}

fn v2FailKey(p: &V2, message: string, at: int, end: int) {
    let t = Text.new(p.arena);
    t.pushStr(message);
    t.push(32);
    t.pushStr(p.bytes[at..end] as string);
    v2Fail(p, t.str());
}

/// The text of a token value: a quoted one without its quotes and escapes, else as written.
fn unq(p: &V2, at: int, end: int): string {
    let bytes = p.bytes;
    if at < end && bytes[at] == 34 {
        let stop = end;
        if stop > at + 1 && bytes[stop - 1] == 34 { stop -= 1; }
        let plain = true;
        let i = at + 1;
        while i < stop { if bytes[i] == 92 { plain = false; } i += 1; }
        if plain { return bytes[at + 1..stop] as string; }
        let t = Text.new(p.arena);
        i = at + 1;
        while i < stop {
            if bytes[i] == 92 && i + 1 < stop { i += 1; }
            t.push(bytes[i]);
            i += 1;
        }
        return t.str();
    }
    return bytes[at..end] as string;
}

fn radians(degrees: f32): f32 { return f32(f64(degrees) * 0.017453292519943295); }

/// `x,y,z` (or, with `uniform`, one number for all three) at `bytes[at..end]`.
fn parseVec3(bytes: []u8, at: int, end: int, v: &Vec3, uniform: bool): bool {
    let vals: [3]f32 = [0.0, 0.0, 0.0];
    let n = 0;
    let i = at;
    while n < 3 && i < end {
        vals[n] = save.parseFloat(bytes, i);
        n += 1;
        while i < end && bytes[i] != 44 { i += 1; }
        i += 1;
    }
    if n == 3 { *v = Vec3.xyz(vals[0], vals[1], vals[2]); return true; }
    if n == 1 && uniform { *v = Vec3.xyz(vals[0], vals[0], vals[0]); return true; }
    return false;
}

/// `grain` is `assets/materials/grain.j3mat`; a value with a `/` or a `.` is a path as it is.
fn expandName(p: &V2, at: int, end: int, folder: string, ext: string): string {
    let raw = unq(p, at, end);
    if raw.len == 0 || hasByte(raw as []u8, 0, raw.len, 47) || hasByte(raw as []u8, 0, raw.len, 46) { return raw; }
    let t = Text.new(p.arena);
    t.pushStr(folder);
    t.pushStr(raw);
    t.pushStr(ext);
    return t.str();
}

/// One `a|b` list of short names, each expanded.
fn expandList(p: &V2, at: int, end: int, folder: string, ext: string): string {
    let raw = unq(p, at, end);
    let t = Text.new(p.arena);
    let from = 0;
    while from <= raw.len {
        let to = from;
        while to < raw.len && raw[to] != 124 { to += 1; }
        if from > 0 { t.push(124); }
        let part = raw[from..to];
        if part.len == 0 || hasByte(part as []u8, 0, part.len, 47) || hasByte(part as []u8, 0, part.len, 46) {
            t.pushStr(part);
        } else {
            t.pushStr(folder);
            t.pushStr(part);
            t.pushStr(ext);
        }
        from = to + 1;
    }
    return t.str();
}

/// Append `<head><id>.<field>[ f| s| r]=<value>` to the data section. The literal's shape picks the
/// type: `"text"` is a string, `#7` an object, a number with a `.` a float, any other an integer.
fn v2Data(p: &V2, head: string, id: int, fa: int, fe: int, v: int, e: int, text: bool) {
    let bytes = p.bytes;
    let t = p.rest;
    t.pushStr(head);
    t.pushInt(id);
    t.push(46);
    t.pushStr(bytes[fa..fe] as string);
    if text || (v < e && bytes[v] == 34) {
        t.pushStr(" s=");
        t.pushStr(unq(p, v, e));
    } else if v < e && bytes[v] == 35 {
        t.pushStr(" r=");
        t.pushStr(bytes[v + 1..e] as string);
    } else if hasByte(bytes, v, e, 46) {
        t.pushStr(" f=");
        t.pushStr(bytes[v..e] as string);
    } else {
        t.push(61);
        t.pushStr(bytes[v..e] as string);
    }
    t.push(10);
}

fn v2Kind(p: &V2, n: &Node, a: int, e: int) {
    let bytes = p.bytes;
    if fieldIs(bytes, a, e, "group") { n.kind = GROUP; }
    else if fieldIs(bytes, a, e, "mesh") { n.kind = MESH; }
    else if fieldIs(bytes, a, e, "place") { n.kind = INSTANCE; }
    else if fieldIs(bytes, a, e, "light") { n.kind = LIGHT; }
    else if fieldIs(bytes, a, e, "camera") { n.kind = CAMERA; }
    else if isShape(bytes[a..e] as string) {
        n.kind = MESH;
        let t = Text.new(p.arena);
        t.pushStr("builtin:");
        t.pushStr(bytes[a..e] as string);
        n.asset = t.str();
    } else {
        v2FailKey(p, "unknown kind", a, e);
    }
}

fn isShape(name: string): bool {
    return same(name, "cube") || same(name, "sphere") || same(name, "cylinder") || same(name, "cone")
        || same(name, "capsule") || same(name, "torus") || same(name, "quad") || same(name, "plane")
        || same(name, "sky");
}

/// One token of an object line after its kind: a mesh or scene path, or `key=value`.
fn v2Field(p: &V2, n: &Node, id: int, a: int, e: int) {
    let bytes = p.bytes;
    let eq = eqAt(bytes, a, e);
    if eq < 0 {
        if n.kind == MESH { n.asset = unq(p, a, e); }
        else if n.kind == INSTANCE { n.scene = unq(p, a, e); }
        else { v2FailKey(p, "a path only goes on mesh and place objects:", a, e); }
        return;
    }
    let v = eq + 1;
    let ok = true;
    if fieldIs(bytes, a, eq, "pos") { ok = parseVec3(bytes, v, e, &n.position, false); }
    else if fieldIs(bytes, a, eq, "rot") {
        let d = Vec3.zero();
        ok = parseVec3(bytes, v, e, &d, false);
        n.rotation = Vec3.xyz(radians(d.x), radians(d.y), radians(d.z));
    }
    else if fieldIs(bytes, a, eq, "scale") { ok = parseVec3(bytes, v, e, &n.scale, true); }
    else if fieldIs(bytes, a, eq, "tint") { ok = parseVec3(bytes, v, e, &n.tint, true); }
    else if fieldIs(bytes, a, eq, "color") { ok = parseVec3(bytes, v, e, &n.color, true); }
    else if fieldIs(bytes, a, eq, "range") { n.range = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "fov") { n.fov = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "near") { n.near = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "far") { n.far = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "opacity") { n.opacity = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, a, eq, "material") { n.material = expandName(p, v, e, "assets/materials/", ".j3mat"); }
    else if fieldIs(bytes, a, eq, "fx") || fieldIs(bytes, a, eq, "effects") {
        n.effects = expandList(p, v, e, "assets/fx/", ".j3fx");
    }
    else if fieldIs(bytes, a, eq, "texture") { n.texture = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "script") { n.script = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "tags") { n.tags = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "asset") { n.asset = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "scene") { n.scene = unq(p, v, e); }
    else if fieldIs(bytes, a, eq, "doubleSided") { n.doubleSided = save.parseInt(bytes, v, 0) != 0; }
    else if fieldIs(bytes, a, eq, "alpha") {
        if fieldIs(bytes, v, e, "cutout") { n.alpha = CUTOUT; }
        else if fieldIs(bytes, v, e, "blend") { n.alpha = BLEND; }
        else if fieldIs(bytes, v, e, "opaque") { n.alpha = OPAQUE; }
        else { n.alpha = save.parseInt(bytes, v, OPAQUE); }
    }
    else if startsWith(bytes, a, eq, "param.") { v2Data(p, "param.", id, a + 6, eq, v, e, false); }
    else if startsWith(bytes, a, eq, "fx.") { v2Data(p, "param.", id, a, eq, v, e, false); }
    else if startsWith(bytes, a, eq, "prop.") { v2Data(p, "over.", id, a, eq, v, e, true); }
    else if startsWith(bytes, a, eq, "over.") { v2Data(p, "over.", id, a + 5, eq, v, e, false); }
    else { v2FailKey(p, "unknown key", a, eq); }
    if !ok { v2FailKey(p, "bad value in", a, e); }
}

fn v2Object(p: &V2, at: int, s: int, end: int) {
    let bytes = p.bytes;
    let scene = p.scene;
    let depth = (s - at) / 2;
    if (s - at) - depth * 2 != 0 {
        v2Fail(p, "indent must be a multiple of two spaces");
        depth = 0;
    } else if depth > p.open || depth >= 64 {
        v2Fail(p, "indented more than one level below its parent");
        depth = 0;
    }
    let parent = 0;
    if depth > 0 { parent = p.stack[depth - 1]; }
    let idAt = end;
    let id = trailingId(bytes, s, end, &idAt);
    if id == 0 {
        id = p.auto;
        p.auto += 1;
    }
    let stop = idAt;
    while stop > s && (bytes[stop - 1] == 32 || bytes[stop - 1] == 13) { stop -= 1; }
    grow(scene, scene.len + 1);
    let n = &scene.nodes[scene.len - 1];
    n.id = id;
    n.parent = parent;
    if p.hasNote {
        n.note = p.note.str();
        p.note = Text.new(p.arena);
        p.hasNote = false;
    }
    p.stack[depth] = id;
    p.open = depth + 1;
    let cur = s;
    let te = tokEnd(bytes, cur, stop);
    n.name = unq(p, cur, te);
    cur = skipSp(bytes, te, stop);
    te = tokEnd(bytes, cur, stop);
    if cur >= stop { v2Fail(p, "object needs a kind after its name"); return; }
    v2Kind(p, n, cur, te);
    cur = skipSp(bytes, te, stop);
    while cur < stop {
        te = tokEnd(bytes, cur, stop);
        v2Field(p, n, id, cur, te);
        cur = skipSp(bytes, te, stop);
    }
}

fn envComp(p: &V2, name: string, at: int, end: int) {
    p.rest.pushStr("scene.env.");
    p.rest.pushStr(name);
    p.rest.pushStr(" f=");
    p.rest.pushStr(p.bytes[at..end] as string);
    p.rest.push(10);
}

/// `x,y,z` at `bytes[at..end]` as three float lines.
fn envVec(p: &V2, x: string, y: string, z: string, at: int, end: int) {
    let to = at;
    while to < end && p.bytes[to] != 44 { to += 1; }
    envComp(p, x, at, to);
    let from = to + 1;
    to = from;
    while to < end && p.bytes[to] != 44 { to += 1; }
    envComp(p, y, from, to);
    from = to + 1;
    envComp(p, z, from, end);
}

fn envScalar(p: &V2, name: string, at: int, end: int, float: bool) {
    p.rest.pushStr("scene.env.");
    p.rest.pushStr(name);
    if float { p.rest.pushStr(" f="); } else { p.rest.push(61); }
    p.rest.pushStr(p.bytes[at..end] as string);
    p.rest.push(10);
}

fn v2Env(p: &V2, s: int, end: int) {
    let bytes = p.bytes;
    let cur = skipSp(bytes, s + 3, end);
    while cur < end {
        let te = tokEnd(bytes, cur, end);
        let eq = eqAt(bytes, cur, te);
        if eq < 0 { v2FailKey(p, "env needs key=value, got", cur, te); }
        else {
            let v = eq + 1;
            if fieldIs(bytes, cur, eq, "sun") { envVec(p, "sunX", "sunY", "sunZ", v, te); }
            else if fieldIs(bytes, cur, eq, "sunColor") { envVec(p, "sunR", "sunG", "sunB", v, te); }
            else if fieldIs(bytes, cur, eq, "sky") { envVec(p, "skyR", "skyG", "skyB", v, te); }
            else if fieldIs(bytes, cur, eq, "fogStart") { envScalar(p, "fogStart", v, te, true); }
            else if fieldIs(bytes, cur, eq, "fogEnd") { envScalar(p, "fogEnd", v, te, true); }
            else if fieldIs(bytes, cur, eq, "shadowSize") { envScalar(p, "shadowSize", v, te, true); }
            else if fieldIs(bytes, cur, eq, "urpShadowNear") { envScalar(p, "urpShadowNear", v, te, true); }
            else if fieldIs(bytes, cur, eq, "shadows") { envScalar(p, "shadows", v, te, false); }
            else if fieldIs(bytes, cur, eq, "urp") { envScalar(p, "urp", v, te, false); }
            else if fieldIs(bytes, cur, eq, "urpBounces") { envScalar(p, "urpBounces", v, te, false); }
            else if fieldIs(bytes, cur, eq, "urpSamples") { envScalar(p, "urpSamples", v, te, false); }
            else if fieldIs(bytes, cur, eq, "urpShadows") { envScalar(p, "urpShadows", v, te, false); }
            else { v2FailKey(p, "unknown env key", cur, eq); }
        }
        cur = skipSp(bytes, te, end);
    }
}

/// Read a v2 file: objects become `scene.nodes`; `env`, params, overrides and the data section
/// become the v1 `key=value` lines in `rest` (the same data `scene.data` always held).
fn parseV2(scene: &Scene, bytes: []u8, rest: &Text) {
    let arena = scene.arena;
    let p = V2 { scene: scene, bytes: bytes, rest: rest, arena: arena, auto: 1, stack: arena.alloc::<int>(64),
        open: 0, note: Text.new(arena), hasNote: false, ln: 0 };
    // First pass: the header's `next=` and the largest `#id`, so a line without one gets a free id.
    let at = 0;
    let end = 0;
    let s = 0;
    let kind = 0;
    while at < bytes.len {
        end = eol(bytes, at);
        s = skipSp(bytes, at, end);
        kind = lineKind(bytes, at, s, end);
        if kind == 2 {
            let k = s;
            while k < end {
                if startsWith(bytes, k, end, "next=") {
                    let next = save.parseInt(bytes, k + 5, 1);
                    if next > p.auto { p.auto = next; }
                }
                k += 1;
            }
        } else if kind == 5 {
            let ignore = end;
            let id = trailingId(bytes, s, end, &ignore);
            if id >= p.auto { p.auto = id + 1; }
        }
        at = end + 1;
    }
    at = 0;
    while at < bytes.len {
        end = eol(bytes, at);
        p.ln += 1;
        s = skipSp(bytes, at, end);
        kind = lineKind(bytes, at, s, end);
        if kind == 1 {
            let from = s + 2;
            if from < end && bytes[from] == 32 { from += 1; }
            let to = end;
            if to > from && bytes[to - 1] == 13 { to -= 1; }
            if p.hasNote { p.note.push(10); }
            p.note.pushStr(bytes[from..to] as string);
            p.hasNote = true;
        } else if kind == 2 {
            let h = s;
            while h < end {
                if startsWith(bytes, h, end, "next=") {
                    rest.pushStr("scene.nextId=");
                    rest.pushInt(save.parseInt(bytes, h + 5, 1));
                    rest.push(10);
                }
                h += 1;
            }
        } else if kind == 3 {
            v2Env(&p, s, end);
        } else if kind == 4 {
            rest.pushStr(bytes[s..end] as string);
            rest.push(10);
        } else if kind == 5 {
            v2Object(&p, at, s, end);
        }
        at = end + 1;
    }
}
