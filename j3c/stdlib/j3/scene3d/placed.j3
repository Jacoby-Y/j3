// Part of j3.scene3d (placed scenes: parts, expansion, overrides, props); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

/// A scene file loaded into another at `at`: see `loadParts`.
pub struct Part {
    file: string;
    /// Added to the position of the part's top-level objects.
    at: Vec3;
}

/// Append `src`'s `param.` and `over.` lines for its own objects to `out`, ids moved up by `base`
/// (and so object fields that name one of them). The lines of a scene brought in by `loadParts`.
fn shiftData(src: &Scene, base: int, out: &Text) {
    let bytes = src.data.bytes;
    let at = 0;
    let end = 0;
    while at < bytes.len {
        end = eol(bytes, at);
        let head = 6;
        let id = keyId(bytes, at, end, "param.");
        if id == 0 { head = 5; id = keyId(bytes, at, end, "over."); }
        if id > 0 && index(src, id) >= 0 {
            out.pushStr(bytes[at..at + head] as string);
            out.pushInt(base + id);
            let dot = at + head;
            while bytes[dot] != 46 { dot += 1; }
            let eq = dot;
            while eq < end && bytes[eq] != 61 { eq += 1; }
            if eq < end && eq > dot + 1 && bytes[eq - 2] == 32 && bytes[eq - 1] == 114 && head == 6 {
                out.pushStr(bytes[dot..eq + 1] as string);
                out.pushInt(base + save.parseInt(bytes, eq + 1, 0));
            } else {
                out.pushStr(bytes[dot..end] as string);
            }
            out.push(10);
        }
        at = end + 1;
    }
}

/// Read `path` and bring each of `parts` into it: the part's objects get ids past everything so far,
/// those at the top of the part move by its `at`, and their params and per-copy values come along.
/// Placed scenes are expanded after. A part that isn't there is skipped. This is how a game
/// builds one world from a scene per region; `-e scene split` makes such files.
pub fn loadParts(path: string, parts: []Part, arena: &Arena): Scene {
    let scene = read(path, arena);
    let extra = Text.new(arena);
    let b = 0;
    while b < parts.len {
        let part = read(parts[b].file, arena);
        if part.found && part.len > 0 {
            let fresh = arena.alloc::<Node>(scene.len + part.len);
            let k = 0;
            while k < scene.len { fresh[k] = scene.nodes[k]; k += 1; }
            let base = scene.nextId;
            k = 0;
            while k < part.len {
                let n = part.nodes[k];
                n.id = base + n.id;
                if n.parent == 0 { n.position = n.position + parts[b].at; }
                else { n.parent = base + n.parent; }
                fresh[scene.len + k] = n;
                k += 1;
            }
            shiftData(&part, base, &extra);
            scene.nodes = fresh;
            scene.len += part.len;
            scene.nextId = base + part.nextId;
        }
        b += 1;
    }
    if extra.bytes.len > 0 {
        let all = Text.new(arena);
        all.pushStr(scene.data.bytes as string);
        all.pushStr(extra.str());
        scene.data.bytes = all.bytes;
    }
    relink(&scene);
    expand(&scene, path);
    return scene;
}

/// True when `file` is one of the newline-separated paths in `chain`.
fn inChain(chain: string, file: string): bool {
    let at = 0;
    while at <= chain.len {
        let end = at;
        while end < chain.len && chain[end] != 10 { end += 1; }
        if end - at == file.len {
            let equal = true;
            let i = 0;
            while i < file.len {
                if chain[at + i] != file[i] { equal = false; }
                i += 1;
            }
            if equal { return true; }
        }
        at = end + 1;
    }
    return false;
}

/// Add every instanced scene's objects under its instance node. `path` is this scene's
/// own file, so a scene that instances itself (directly or not) stops there.
struct CachedScene {
    path: string;
    scene: Scene;
}

struct ExpandCtx {
    cache: []CachedScene;
    used: int;
    temp: &Arena;
    extra: Text;
    placed: &Arena;
    /// Override lines of the placed files themselves, rekeyed to the top copy; deeper files
    /// first, so a file's overrides win over the ones in the files it places.
    nested: Text;
}

fn cachedScene(ctx: &ExpandCtx, file: string): Scene {
    let i = 0;
    while i < ctx.used {
        if same(ctx.cache[i].path, file) { return ctx.cache[i].scene; }
        i += 1;
    }
    if ctx.used >= ctx.cache.len {
        let grown = ctx.temp.alloc::<CachedScene>(ctx.cache.len * 2);
        let k = 0;
        while k < ctx.used { grown[k] = ctx.cache[k]; k += 1; }
        ctx.cache = grown;
    }
    let loaded = read(file, ctx.placed);
    ctx.cache[ctx.used] = CachedScene { path: file, scene: loaded };
    ctx.used += 1;
    return loaded;
}

pub fn expand(scene: &Scene, path: string) {
    flushParams(scene);
    if scene.placed as ptr == 0 { ensurePlaced(scene); }
    else { scene.placed.destroy(); }
    *scene.placed = Arena.create(64 * 1024);
    scene.placedData = save.empty(scene.placed);
    scene.paramsPlacedData = scene.placedData.bytes.ptr as ptr;
    scene.paramsPlacedLen = 0;
    let temp = Arena.create(64 * 1024);
    let ctx = ExpandCtx {
        cache: temp.alloc::<CachedScene>(16), used: 0, temp: &temp,
        extra: Text.new(&temp), placed: scene.placed, nested: Text.new(&temp),
    };
    scene.urpChild = "";
    scene.childUrp.urp = false;
    scene.childUrp.bounces = 1;
    scene.childUrp.samples = 1;
    scene.childUrp.tracedShadows = false;
    let count = scene.len;
    let i = 0;
    while i < count {
        let n = scene.nodes[i];
        if n.kind == INSTANCE && n.owner == 0 {
            graft(scene, &ctx, n.id, n.id, n.scene, 1, path, "");
        }
        i += 1;
    }
    applyOverrides(scene, ctx.nested.bytes, &ctx.extra, count);
    applyOverrides(scene, scene.data.bytes, &ctx.extra, count);
    if ctx.extra.bytes.len > 0 {
        let out = Text.new(scene.placed);
        out.pushStr(ctx.extra.str());
        scene.placedData.bytes = out.bytes;
    }
    rebuildParams(scene);
    temp.destroy();
}

/// Copy the objects of `file` under node `under`, with ids from `scene.grafted`, recursively.
/// `path` is `under`'s `sourcePath` ("" for the top copy).
fn graft(scene: &Scene, ctx: &ExpandCtx, under: int, owner: int, file: string, depth: int, chain: string, path: string) {
    if depth > NEST {
        scene.tooDeep = true;
        return;
    }
    if file.len == 0 || inChain(chain, file) { return; }
    let sub = cachedScene(ctx, file);
    let host = index(scene, under);
    if host >= 0 { scene.nodes[host].missing = !sub.found; }
    let subEnv = environment(&sub);
    if subEnv.urp {
        if scene.urpChild.len == 0 { scene.urpChild = keepKey(file); }
        let c = &scene.childUrp;
        c.urp = true;
        if subEnv.bounces > c.bounces { c.bounces = subEnv.bounces; }
        if subEnv.samples > c.samples { c.samples = subEnv.samples; }
        c.tracedShadows = c.tracedShadows || subEnv.tracedShadows;
        if subEnv.tracedShadows { c.traceNear = subEnv.traceNear; }
    }
    let from = ctx.temp.alloc::<int>(sub.len);
    let ids = ctx.temp.alloc::<int>(sub.len);
    let k = 0;
    while k < sub.len {
        from[k] = sub.nodes[k].id;
        ids[k] = scene.grafted;
        scene.grafted += 1;
        k += 1;
    }
    let deeper = Text.new(ctx.temp);
    deeper.pushStr(chain);
    deeper.push(10);
    deeper.pushStr(file);
    k = 0;
    while k < sub.len {
        let n = sub.nodes[k];
        let up = index(&sub, n.parent);
        n.id = ids[k];
        n.parent = under;
        if up >= 0 { n.parent = ids[up]; }
        n.owner = owner;
        if host >= 0 { n.tint = mulVec(n.tint, scene.nodes[host].tint); }
        n.source = from[k];
        n.sourcePath = joinPath(ctx.placed, path, from[k]);
        ensure(scene);
        scene.nodes[scene.len] = n;
        scene.len += 1;
        if n.kind == INSTANCE {
            graft(scene, ctx, n.id, owner, n.scene, depth + 1, deeper.str(), n.sourcePath);
        }
        k += 1;
    }
    rekeyOverrides(sub.data.bytes, owner, path, &ctx.nested);
    appendParams(&sub.data, from, ids, &ctx.extra, ctx.temp);
    appendProps(&sub.data, under, from, ids, &ctx.extra);
}

/// For a scene placed under node `under`: its prop defaults as `propdef.<under>.<name>`
/// lines, and the prop values it sets on scenes it places itself, moved to their copies'
/// new ids. Both go to the placed data, where `prop` finds them after this scene's own.
fn appendProps(src: &Save, under: int, from: []int, to: []int, extra: &Text) {
    let bytes = src.bytes;
    let line = 0;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if startsWith(bytes, line, end, "prop.") {
            // `prop.<name>.default s=<value>`; the value may hold dots, so look in the key.
            let keyStop = line;
            while keyStop < end && bytes[keyStop] != 32 && bytes[keyStop] != 61 { keyStop += 1; }
            let dot = keyStop;
            while dot > line && bytes[dot] != 46 { dot -= 1; }
            let eq = dot;
            while eq < end && bytes[eq] != 61 { eq += 1; }
            if dot > line + 5 && startsWith(bytes, dot, end, ".default") && eq < end {
                extra.pushStr("propdef.");
                extra.pushInt(under);
                extra.push(46);
                extra.pushStr([]u8 { ptr: (bytes.ptr as int + line + 5) as &u8, len: dot - line - 5 } as string);
                extra.pushStr(" s=");
                extra.pushStr([]u8 { ptr: (bytes.ptr as int + eq + 1) as &u8, len: end - eq - 1 } as string);
                extra.push(10);
            }
        } else if startsWith(bytes, line, end, "over.") {
            let at = line + 5;
            let id = save.parseInt(bytes, at, 0);
            while at < end && bytes[at] != 46 { at += 1; }
            if startsWith(bytes, at + 1, end, "prop.") {
                let k = 0;
                while k < from.len {
                    if from[k] == id {
                        extra.pushStr("over.");
                        extra.pushInt(to[k]);
                        extra.pushStr([]u8 { ptr: (bytes.ptr as int + at) as &u8, len: end - at } as string);
                        extra.push(10);
                    }
                    k += 1;
                }
            }
        }
        line = end + 1;
    }
}

/// `path/id`, or `id` when `path` is "", on `arena`.
fn joinPath(arena: &Arena, path: string, id: int): string {
    let t = Text.new(arena);
    t.pushStr(path);
    if path.len > 0 { t.push(47); }
    t.pushInt(id);
    return t.str();
}

/// A placed file's own `over.<copy>.<path>.<key>` lines (not props), as seen from the top
/// copy `owner`: `over.<owner>.<path>/<copy>/<path>.<key>`, where the first `path` leads to
/// where that file was placed.
fn rekeyOverrides(bytes: []u8, owner: int, path: string, out: &Text) {
    let line = 0;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if startsWith(bytes, line, end, "over.") {
            let at = line + 5;
            while at < end && bytes[at] != 46 { at += 1; }
            if !startsWith(bytes, at + 1, end, "prop.") {
                out.pushStr("over.");
                out.pushInt(owner);
                out.push(46);
                out.pushStr(path);
                if path.len > 0 { out.push(47); }
                out.pushStr([]u8 { ptr: (bytes.ptr as int + line + 5) as &u8, len: at - line - 5 } as string);
                out.push(47);
                let k = at + 1;
                while k < end { out.push(bytes[k]); k += 1; }
                out.push(10);
            }
        }
        line = end + 1;
    }
}

/// Apply `over.<instance>.<path>.<key>` lines in `bytes` to the objects just placed (slots
/// from `first` on). Node fields change in place; `param.` keys become field values.
fn applyOverrides(scene: &Scene, bytes: []u8, extra: &Text, first: int) {
    let line = 0;
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let propLine = false;
        if startsWith(bytes, line, end, "over.") {
            let p = line + 5;
            while p < end && bytes[p] != 46 { p += 1; }
            propLine = startsWith(bytes, p + 1, end, "prop.");
        }
        if startsWith(bytes, line, end, "over.") && !propLine {
            let at = line + 5;
            let inst = save.parseInt(bytes, at, 0);
            while at < end && bytes[at] != 46 { at += 1; }
            at += 1;
            let pathAt = at;
            while at < end && bytes[at] != 46 { at += 1; }
            let path = []u8 { ptr: (bytes.ptr as int + pathAt) as &u8, len: at - pathAt } as string;
            at += 1;
            let keyEnd = at;
            while keyEnd < end && bytes[keyEnd] != 32 && bytes[keyEnd] != 61 { keyEnd += 1; }
            let value = keyEnd;
            while value < end && bytes[value] != 61 { value += 1; }
            // ponytail: linear search per override; index placed objects by (owner, source) if scenes get huge.
            let target = -1;
            let j = first;
            while j < scene.len && target < 0 {
                if scene.nodes[j].owner == inst && same(scene.nodes[j].sourcePath, path) { target = j; }
                j += 1;
            }
            if target >= 0 && value < end {
                if startsWith(bytes, at, end, "param.") {
                    extra.pushStr("param.");
                    extra.pushInt(scene.nodes[target].id);
                    let k = at + 5;
                    while k < end { extra.push(bytes[k]); k += 1; }
                    extra.push(10);
                } else if !fieldIs(bytes, at, keyEnd, "id") && !fieldIs(bytes, at, keyEnd, "parent")
                    && !fieldIs(bytes, at, keyEnd, "kind") && !fieldIs(bytes, at, keyEnd, "scene") {
                    setField(&scene.nodes[target], bytes, at, keyEnd, value + 1, end);
                }
            }
        }
        line = end + 1;
    }
}

/// A value no prop line holds, for telling "not set" from "set to empty".
const UNSET: string = "(j3 unset prop)";

/// The data key of prop `name` set on placed copy `copy`: `over.<copy>.prop.<name>`.
pub fn copyKey(copy: int, name: string): string {
    let t = Text.new(scratch(0));
    t.pushStr("over.");
    t.pushInt(copy);
    t.pushStr(".prop.");
    t.pushStr(name);
    return t.str();
}

/// The placed copy (an `INSTANCE` node) that `id` belongs to: itself when it is one, else
/// the nearest one above it; 0 for none. Behaviors inside a reusable scene call
/// `prop(scene, copyOf(scene, self), ...)`.
pub fn copyOf(scene: &Scene, id: int): int {
    let at = index(scene, id);
    let steps = 0;
    while at >= 0 && steps <= scene.len {
        if scene.nodes[at].kind == INSTANCE { return scene.nodes[at].id; }
        at = index(scene, scene.nodes[at].parent);
        steps += 1;
    }
    return 0;
}

/// Prop `name` of placed copy `copy`: the value set on this copy (in this scene, or by the
/// scene that placed it), else its scene's default, else `fallback`.
pub fn prop(scene: &Scene, copy: int, name: string, fallback: string): string {
    flushParams(scene);
    let key = copyKey(copy, name);
    let own = save.getStr(&scene.data, key, UNSET);
    if !same(own, UNSET) { return own; }
    let nested = save.getStr(&scene.placedData, key, UNSET);
    if !same(nested, UNSET) { return nested; }
    let t = Text.new(scratch(0));
    t.pushStr("propdef.");
    t.pushInt(copy);
    t.push(46);
    t.pushStr(name);
    return save.getStr(&scene.placedData, t.str(), fallback);
}

pub fn propNumber(scene: &Scene, copy: int, name: string, fallback: f32): f32 {
    let v = prop(scene, copy, name, "");
    if v.len == 0 { return fallback; }
    return save.parseFloat(v as []u8, 0);
}

pub fn propInt(scene: &Scene, copy: int, name: string, fallback: int): int {
    let v = prop(scene, copy, name, "");
    if v.len == 0 { return fallback; }
    return save.parseInt(v as []u8, 0, fallback);
}

pub fn propFlag(scene: &Scene, copy: int, name: string, fallback: bool): bool {
    let v = prop(scene, copy, name, "");
    if v.len == 0 { return fallback; }
    return same(v, "true") || same(v, "1");
}

/// Whether copy `copy` sets `name` itself (in this scene), rather than using the default.
pub fn propSet(scene: &Scene, copy: int, name: string): bool {
    flushParams(scene);
    return !same(save.getStr(&scene.data, copyKey(copy, name), UNSET), UNSET);
}

/// Rebuild instanced objects after scene files changed on disk, and upload the new ones.
/// Meshes still in use stay on the GPU.
pub fn refresh(scene: &Scene, path: string) {
    let mem = Arena.create(scene.len * 64 + 64);
    let old = mem.alloc::<Node>(scene.len);
    let gone = 0;
    let kept = 0;
    let i = 0;
    while i < scene.len {
        if scene.nodes[i].owner == 0 {
            scene.nodes[kept] = scene.nodes[i];
            kept += 1;
        } else {
            old[gone] = scene.nodes[i];
            // `expand` frees the placed arena these live in, and `unload` below looks them up.
            old[gone].asset = copyStr(&mem, old[gone].asset);
            old[gone].texture = copyStr(&mem, old[gone].texture);
            gone += 1;
        }
        i += 1;
    }
    scene.len = kept;
    scene.grafted = GRAFT;
    scene.tooDeep = false;
    relink(scene);
    expand(scene, path);
    let j = kept;
    while j < scene.len {
        reload(scene, scene.nodes[j].id);
        j += 1;
    }
    i = 0;
    while i < gone {
        unload(&old[i]);
        i += 1;
    }
    mem.destroy();
}

fn copyStr(mem: &Arena, s: string): string {
    let t = Text.new(mem);
    t.pushStr(s);
    return t.str();
}
