// Part of j3.scene3d (writer: one object's text and the tree order); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

/// The v2 text of object `at` (its slot in `scene.nodes`): its note lines, then its line, at
/// `depth` levels of indent, newline-ended. Reads the scene's param and override lines.
pub fn nodeText(scene: &Scene, at: int, depth: int, out: &Text, mem: &Arena) {
    flushParams(scene);
    let n = scene.nodes[at];
    let k = n.kind;
    if k != MESH && k != CAMERA && k != INSTANCE && k != LIGHT { k = GROUP; }
    if n.note.len > 0 {
        let nfrom = 0;
        while nfrom <= n.note.len {
            let nto = nfrom;
            while nto < n.note.len && n.note[nto] != 10 { nto += 1; }
            pushPad(out, depth);
            out.pushStr("//");
            if nto > nfrom { out.push(32); out.pushStr(n.note[nfrom..nto]); }
            out.push(10);
            nfrom = nto + 1;
        }
    }
    pushPad(out, depth);
    pushName(out, n.name);
    out.push(32);
    if k == MESH {
        if startsWith(n.asset as []u8, 0, n.asset.len, "builtin:") && isShape(n.asset[8..n.asset.len]) {
            out.pushStr(n.asset[8..n.asset.len]);
        } else {
            out.pushStr("mesh");
            if n.asset.len > 0 { out.push(32); pushValue(out, n.asset, true); }
        }
    } else if k == INSTANCE {
        out.pushStr("place");
        if n.scene.len > 0 { out.push(32); pushValue(out, n.scene, true); }
    } else if k == CAMERA { out.pushStr("camera"); }
    else if k == LIGHT { out.pushStr("light"); }
    else { out.pushStr("group"); }
    let p = n.position;
    if q6(p.x) != 0 || q6(p.y) != 0 || q6(p.z) != 0 { out.pushStr(" pos="); pushVec(out, p); }
    let r = n.rotation;
    if qd(r.x) != 0 || qd(r.y) != 0 || qd(r.z) != 0 {
        out.pushStr(" rot=");
        pushDeg(out, r.x);
        out.push(44);
        pushDeg(out, r.y);
        out.push(44);
        pushDeg(out, r.z);
    }
    let s = n.scale;
    if q6(s.x) != 1000000 || q6(s.y) != 1000000 || q6(s.z) != 1000000 { out.pushStr(" scale="); pushVecOrUniform(out, s); }
    if k == MESH {
        if n.material.len > 0 {
            out.pushStr(" material=");
            pushValue(out, shorten(n.material, "assets/materials/", ".j3mat"), false);
        }
        if n.texture.len > 0 { out.pushStr(" texture="); pushValue(out, n.texture, false); }
    }
    let tint = n.tint;
    if (k == MESH || k == INSTANCE) && (q6(tint.x) != 1000000 || q6(tint.y) != 1000000 || q6(tint.z) != 1000000) {
        out.pushStr(" tint=");
        pushVecOrUniform(out, tint);
    }
    if k == LIGHT {
        let c = n.color;
        if q6(c.x) != 1000000 || q6(c.y) != 900000 || q6(c.z) != 750000 { out.pushStr(" color="); pushVec(out, c); }
        if q6(n.range) != 8000000 { out.pushStr(" range="); pushNum(out, n.range); }
    }
    if k == CAMERA {
        if q6(n.fov) != 60000000 { out.pushStr(" fov="); pushNum(out, n.fov); }
        if q6(n.near) != 150000 { out.pushStr(" near="); pushNum(out, n.near); }
        if q6(n.far) != 200000000 { out.pushStr(" far="); pushNum(out, n.far); }
        if n.effects.len > 0 {
            let list = Text.new(mem);
            let from = 0;
            while from <= n.effects.len {
                let to = from;
                while to < n.effects.len && n.effects[to] != 124 { to += 1; }
                if from > 0 { list.push(124); }
                list.pushStr(shorten(n.effects[from..to], "assets/fx/", ".j3fx"));
                from = to + 1;
            }
            out.pushStr(" fx=");
            if hasByte(n.effects as []u8, 0, n.effects.len, 32) || hasByte(n.effects as []u8, 0, n.effects.len, 34) {
                pushQuoted(out, list.bytes, 0, list.bytes.len);
            } else {
                out.pushStr(list.str());
            }
        }
    }
    if k == MESH {
        if n.alpha != OPAQUE {
            out.pushStr(" alpha=");
            if n.alpha == BLEND { out.pushStr("blend"); } else if n.alpha == CUTOUT { out.pushStr("cutout"); } else { out.pushStr("opaque"); }
            if q6(n.opacity) != 1000000 { out.pushStr(" opacity="); pushNum(out, n.opacity); }
        }
        if n.doubleSided { out.pushStr(" doubleSided=1"); }
    }
    if n.script.len > 0 { out.pushStr(" script="); pushValue(out, n.script, false); }
    if n.tags.len > 0 { out.pushStr(" tags="); pushValue(out, n.tags, false); }
    let data = scene.data.bytes;
    let params = pickLines(data, "param.", n.id, mem);
    let i = 0;
    let f = 0;
    while i < params.len {
        f = fieldAt(data, params[i], "param.");
        if !startsWith(data, f, eol(data, params[i]), "fx.") { pushDataToken(out, data, params[i], "param.", "param."); }
        i += 1;
    }
    i = 0;
    while i < params.len {
        f = fieldAt(data, params[i], "param.");
        if startsWith(data, f, eol(data, params[i]), "fx.") { pushDataToken(out, data, params[i], "param.", ""); }
        i += 1;
    }
    if k == INSTANCE {
        let overs = pickLines(data, "over.", n.id, mem);
        i = 0;
        while i < overs.len {
            f = fieldAt(data, overs[i], "over.");
            if startsWith(data, f, eol(data, overs[i]), "prop.") { pushDataToken(out, data, overs[i], "over.", ""); }
            i += 1;
        }
        i = 0;
        while i < overs.len {
            f = fieldAt(data, overs[i], "over.");
            if !startsWith(data, f, eol(data, overs[i]), "prop.") { pushDataToken(out, data, overs[i], "over.", "over."); }
            i += 1;
        }
    }
    out.pushStr(" #");
    out.pushInt(n.id);
    out.push(10);
}

/// The scene's own objects (not placed ones) depth first, parents before children, siblings in
/// array order: `slots[k]` is a slot in `scene.nodes` and `depths[k]` its depth. Both need room
/// for `scene.len`. An object whose parent loops back to itself is listed at depth 0. Returns how many.
pub fn treeOrder(scene: &Scene, mem: &Arena, slots: []int, depths: []int): int {
    let n = scene.len;
    let first = mem.alloc::<int>(n + 1);
    let next = mem.alloc::<int>(n + 1);
    let resume = mem.alloc::<int>(n + 1);
    let seen = mem.alloc::<int>(n + 1);
    let i = 0;
    while i <= n { first[i] = -1; next[i] = -1; resume[i] = -1; seen[i] = 0; i += 1; }
    let roots = -1;
    i = n - 1;
    while i >= 0 {
        if scene.nodes[i].owner == 0 {
            let parent = -1;
            if scene.nodes[i].parent != 0 { parent = index(scene, scene.nodes[i].parent); }
            if parent >= 0 && parent != i && scene.nodes[parent].owner == 0 {
                next[i] = first[parent];
                first[parent] = i;
            } else {
                next[i] = roots;
                roots = i;
            }
        }
        i -= 1;
    }
    let count = 0;
    let cur = roots;
    let depth = 0;
    let sp = 0;
    while cur >= 0 {
        slots[count] = cur;
        depths[count] = depth;
        count += 1;
        seen[cur] = 1;
        if first[cur] >= 0 {
            resume[sp] = next[cur];
            sp += 1;
            cur = first[cur];
            depth += 1;
        } else {
            cur = next[cur];
            while cur < 0 && sp > 0 {
                sp -= 1;
                cur = resume[sp];
                depth -= 1;
            }
        }
    }
    i = 0;
    while i < n {
        if scene.nodes[i].owner == 0 && seen[i] == 0 {
            slots[count] = i;
            depths[count] = 0;
            count += 1;
        }
        i += 1;
    }
    return count;
}
