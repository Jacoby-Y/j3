// Part of j3.scene3d (environment, lights, world cache, trace meshes, drawing); the module doc and `use`s are in ../scene3d.j3.
module j3.scene3d;

/// The scene's lighting; defaults for anything never set.
pub fn environment(scene: &Scene): Env {
    let d = &scene.data;
    return Env {
        sunDir: Vec3.xyz(save.getFloat(d, "scene.env.sunX", 0.45), save.getFloat(d, "scene.env.sunY", 0.8),
            save.getFloat(d, "scene.env.sunZ", 0.25)),
        sunColor: Vec3.xyz(save.getFloat(d, "scene.env.sunR", 1), save.getFloat(d, "scene.env.sunG", 0.95),
            save.getFloat(d, "scene.env.sunB", 0.85)),
        sky: Vec3.xyz(save.getFloat(d, "scene.env.skyR", 0.12), save.getFloat(d, "scene.env.skyG", 0.17),
            save.getFloat(d, "scene.env.skyB", 0.24)),
        fogStart: save.getFloat(d, "scene.env.fogStart", 80),
        fogEnd: save.getFloat(d, "scene.env.fogEnd", 400),
        shadows: save.getInt(d, "scene.env.shadows", 1) != 0,
        shadowSize: save.getFloat(d, "scene.env.shadowSize", 30),
        urp: save.getInt(d, "scene.env.urp", 0) != 0,
        bounces: save.getInt(d, "scene.env.urpBounces", 2),
        samples: save.getInt(d, "scene.env.urpSamples", 1),
        tracedShadows: save.getInt(d, "scene.env.urpShadows", 0) != 0,
        traceNear: save.getFloat(d, "scene.env.urpShadowNear", 40),
    };
}

/// Store `env` in the scene's data (saved with it).
pub fn setEnvironment(scene: &Scene, env: Env) {
    // Field values live in the same text; write pending ones first so the rebuild keeps them.
    flushParams(scene);
    let d = &scene.data;
    save.putFloat(d, "scene.env.sunX", env.sunDir.x);
    save.putFloat(d, "scene.env.sunY", env.sunDir.y);
    save.putFloat(d, "scene.env.sunZ", env.sunDir.z);
    save.putFloat(d, "scene.env.sunR", env.sunColor.x);
    save.putFloat(d, "scene.env.sunG", env.sunColor.y);
    save.putFloat(d, "scene.env.sunB", env.sunColor.z);
    save.putFloat(d, "scene.env.skyR", env.sky.x);
    save.putFloat(d, "scene.env.skyG", env.sky.y);
    save.putFloat(d, "scene.env.skyB", env.sky.z);
    save.putFloat(d, "scene.env.fogStart", env.fogStart);
    save.putFloat(d, "scene.env.fogEnd", env.fogEnd);
    let on = 0;
    if env.shadows { on = 1; }
    save.putInt(d, "scene.env.shadows", on);
    save.putFloat(d, "scene.env.shadowSize", env.shadowSize);
    save.putInt(d, "scene.env.urp", if env.urp { 1 } else { 0 });
    save.putInt(d, "scene.env.urpBounces", env.bounces);
    save.putInt(d, "scene.env.urpSamples", env.samples);
    save.putInt(d, "scene.env.urpShadows", if env.tracedShadows { 1 } else { 0 });
    save.putFloat(d, "scene.env.urpShadowNear", env.traceNear);
    ensureParams(scene);
}

/// Point the first four `LIGHT` objects at gfx's point lights and turn the rest off. Returns
/// how many lights the scene has (it may be more than four).
// ponytail: 4 point lights, the shader's limit; spot and shadow-casting lights need gfx work.
pub fn lights(scene: &Scene): int {
    let used = 0;
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if n.kind == LIGHT {
            let at = world(scene, n.id).transformPoint(Vec3.xyz(0, 0, 0));
            gfx.light(used, at, n.color, n.range);
            used += 1;
        }
        i += 1;
    }
    // Then meshes whose material emits light, from the middle of their bounds.
    // ponytail: first ones in scene order get the free slots; nearest-to-camera if scenes have many.
    i = 0;
    while i < scene.len && used < LIGHTS {
        let lamp = scene.nodes[i];
        if lamp.kind == MESH && lamp.mat > 0 && MATS[lamp.mat - 1].emit {
            let m = MATS[lamp.mat - 1];
            let middle = (lamp.boundLo + lamp.boundHi) * 0.5;
            let spot = world(scene, lamp.id).transformPoint(middle);
            gfx.light(used, spot, m.look.glow * m.strength, m.range);
            used += 1;
        }
        i += 1;
    }
    let off = used;
    while off < LIGHTS {
        gfx.light(off, Vec3.xyz(0, 0, 0), Vec3.xyz(0, 0, 0), 0);
        off += 1;
    }
    return used;
}

/// Set gfx fog and run the sun shadow pass for this scene's `env`, drawing it into the
/// shadow map unless shadows are off. Call before the camera pass.
pub fn shadows(scene: &Scene, env: Env) {
    gfx.setFog(env.fogStart, env.fogEnd);
    let r = env.shadowSize;
    gfx.shadowPass(env.sunDir, Vec3.xyz(0 - r, 0 - r, 0 - r), Vec3.xyz(r, r, r));
    if env.shadows { draw(scene); }
}

/// One frame of `scene` seen from `look`: fog, a sun shadow box of half size
/// `env.shadowSize` around the eye (so a smaller box is sharper nearby), lights, sky, and the
/// scene, then the scene's first camera's effects (see `beginEffects`).
/// The camera pass reuses the shadow pass's world matrices (see `draw`).
// ponytail: clip is 0.1 to fogEnd + 20; take near/far when a game needs them.
pub fn drawFrame(scene: &Scene, look: Look, env: Env, fov: f32) {
    gfx.setFog(env.fogStart, env.fogEnd);
    gfx.setClip(0.1, env.fogEnd + 20);
    let r = env.shadowSize;
    let e = look.eye;
    gfx.shadowPass(env.sunDir, Vec3.xyz(e.x - r, 0 - r, e.z - r), Vec3.xyz(e.x + r, r, e.z + r));
    if env.shadows { draw(scene); }
    lights(scene);
    let cam = 0;
    let i = 0;
    while i < scene.len && cam == 0 {
        if scene.nodes[i].kind == CAMERA && scene.nodes[i].owner == 0 { cam = scene.nodes[i].id; }
        i += 1;
    }
    let fx = cam != 0 && beginEffects(scene, cam);
    gfx.cameraPassLookFov(look, env.sunDir, env.sky, env.sunColor, fov);
    drawSky(scene);
    draw(scene);
    if fx { endEffects(scene, cam); }
}

/// Transforms the last shadow-pass `draw` computed (in the frame's scratch arena).
struct WorldCache {
    scene: ptr;
    epoch: int;
    at: ptr;
    len: int;
}

#[singleton]
let SHADOW_WORLDS: WorldCache = WorldCache { scene: 0, epoch: 0, at: 0, len: 0 };

/// The `drawWith` running now got its transforms from `SHADOW_WORLDS`.
#[singleton]
let REUSED: bool = false;

/// Draw the scene's meshes in the current gfx pass.
pub fn draw(scene: &Scene) {
    let t0 = game.micros();
    let c = SHADOW_WORLDS;
    SHADOW_WORLDS.scene = 0;
    let transforms = []Mat4 { ptr: c.at as &Mat4, len: c.len };
    // The camera pass right after a shadow pass reuses its transforms; nothing moves between
    // the two. ponytail: add dirty flags if `worlds` still shows up in the profiler.
    let reuse = gfx.inCameraPass() && c.scene == scene as ptr && c.epoch == gfx.shadowEpoch() && c.len == scene.len;
    if !reuse {
        transforms = scratch(0).alloc::<Mat4>(scene.len);
        worlds(scene, transforms);
        if !gfx.inCameraPass() {
            SHADOW_WORLDS = WorldCache { scene: scene as ptr, epoch: gfx.shadowEpoch(), at: transforms.ptr as ptr, len: scene.len };
        }
    }
    REUSED = reuse;
    drawWith(scene, transforms);
    REUSED = false;
    game.profScene(game.micros() - t0);
}

/// The URP settings a scene draws with: its own when it turns URP on, else the strongest of
/// the scenes placed in it (see `Scene.urpChild`). `urp` false means plain drawing.
pub fn urpSettings(scene: &Scene): Env {
    let own = environment(scene);
    if own.urp || !scene.childUrp.urp { return own; }
    return scene.childUrp;
}

/// Most mesh triangles URP traces, counting each mesh once however many objects use it.
/// Meshes past it are left out of reflections and shadows.
// ponytail: 262144 × 7 texels is 1792 texture rows; no GL_MAX_TEXTURE_SIZE check, every GL 3.3 desktop GPU takes 8192+.
pub const TRACE_MAX: int = 262144;

/// The last clamp or depth warned about, so each prints once.
#[singleton]
let TRACE_WARNED: int = 0;

/// Every loaded mesh on the GPU for tracing, each with a BVH in its own space.
struct TraceMeshes {
    /// `meshSignature` when it was built, and how many builds so far.
    sig: int;
    builds: int;
    /// Root node of each `SHARED` slot's tree, or -1 for none.
    roots: []int;
    data: Traced;
}

#[singleton]
let TRACE_MESHES: TraceMeshes;
/// Holds `TRACE_MESHES.roots`.
#[singleton]
let TRACE_ROOTS: Arena = Arena { ptr: 0, used: 0, cap: 0, head: 0 };

/// A scene's objects uploaded for tracing, and what they were built from.
struct TraceSlot {
    key: int;
    sig: f32;
    /// `TRACE_MESHES.builds` it was built against.
    meshes: int;
    data: Traced;
    used: int;
}

#[singleton]
let TRACES: [4]TraceSlot;
#[singleton]
let TRACE_TICK: int = 0;

/// With URP on, make sure gfx traces this scene's current objects; otherwise turn tracing
/// off. Meshes upload once; objects, a small BVH over their boxes, redo when one moves or
/// changes look.
fn traceScene(scene: &Scene, transforms: []Mat4) {
    let settings = urpSettings(scene);
    if !settings.urp {
        gfx.traceOff();
        return;
    }
    TRACE_TICK += 1;
    let key = scene.arena as ptr as int;
    let slot = 0;
    let k = 0;
    while k < 4 {
        if TRACES[k].key == key { slot = k; break; }
        if TRACES[k].used < TRACES[slot].used { slot = k; }
        k += 1;
    }
    traceMeshes();
    // Transforms reused from the shadow pass were signed there.
    let sig = if REUSED && TRACES[slot].key == key { TRACES[slot].sig } else { traceSignature(scene, transforms) };
    let s = &TRACES[slot];
    if s.key != key || s.sig != sig || s.meshes != TRACE_MESHES.builds {
        s.key = key;
        s.sig = sig;
        s.meshes = TRACE_MESHES.builds;
        traceObjects(scene, transforms, &s.data);
    }
    s.data.tris = TRACE_MESHES.data.tris;
    s.data.nodes = TRACE_MESHES.data.nodes;
    s.used = TRACE_TICK;
    let bounces = settings.bounces;
    if bounces < 1 { bounces = 1; }
    if bounces > 8 { bounces = 8; }
    let samples = settings.samples;
    if samples < 1 { samples = 1; }
    if samples > 16 { samples = 16; }
    gfx.traceUse(s.data, bounces, samples, settings.tracedShadows, settings.traceNear);
}

fn traced(n: Node): bool {
    return n.kind == MESH && n.gpu.vao != 0 && !isSky(n);
}

/// A number that changes when any traced object moves or its mesh or material changes.
fn traceSignature(scene: &Scene, transforms: []Mat4): f32 {
    let sig = f32(scene.len);
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if traced(n) {
            let weight = f32(i - (i / 7) * 7 + 1);
            let k = 0;
            while k < 16 {
                sig += transforms[i].m[k] * weight * f32(k + 3);
                k += 1;
            }
            sig += f32(n.gpu.vao) * 0.37 + f32(n.mat) * 1.7 + n.tint.x * 29.3 + n.tint.y * 31.7 + n.tint.z * 37.1;
            if n.mat > 0 {
                let m = MATS[n.mat - 1];
                let l = m.look;
                sig += l.tint.x * 3.1 + l.tint.y * 5.3 + l.tint.z * 7.7 + l.glow.x * 2.3 + l.glow.y * 4.1
                    + l.glow.z * 6.7 + l.reflect * 11.3 + l.ior * 13.1 + l.rough * 17.9 + m.opacity * 19.3 + l.cloud * 23.1;
            }
        }
        i += 1;
    }
    return sig;
}

/// A number that changes when a mesh loads, unloads, or reloads.
fn meshSignature(): int {
    let sig = SHARED_LEN;
    let k = 0;
    while k < SHARED_LEN {
        let v = SHARED[k].verts;
        sig += ((v.ptr as ptr as int) % 1000003 + v.len) * (k + 1);
        k += 1;
    }
    return sig;
}

/// Upload every loaded mesh's triangles in its own space, each with its own BVH, when the
/// set of meshes changed.
// ponytail: rebuilds every mesh when one changes; append new ones if editor imports lag.
fn traceMeshes() {
    let sig = meshSignature();
    let m = &TRACE_MESHES;
    if m.data.tris != 0 && m.sig == sig && m.roots.len == SHARED_LEN { return; }
    m.sig = sig;
    m.builds += 1;
    TRACE_ROOTS.destroy();
    TRACE_ROOTS = Arena.create(SHARED_LEN * 8 + 64);
    m.roots = TRACE_ROOTS.alloc::<int>(SHARED_LEN);
    let total = 0;
    let wanted = 0;
    let k = 0;
    while k < SHARED_LEN {
        let size = SHARED[k].verts.len / 36;
        wanted += size;
        if total + size <= TRACE_MAX { total += size; }
        k += 1;
    }
    if wanted > TRACE_MAX && TRACE_WARNED != wanted {
        TRACE_WARNED = wanted;
        let say = Text.new(scratch(0));
        say.pushStr("scene3d: URP traces ");
        say.pushInt(total);
        say.pushStr(" of ");
        say.pushInt(wanted);
        say.pushStr(" mesh triangles; raise TRACE_MAX or use fewer meshes");
        io.printLn(say.str());
    }
    let mem = Arena.create((total * 60 + 1024) * 8 + 4 * 1024 * 1024);
    let tris = mem.alloc::<f32>(total * 28 + 4);
    let nodes = mem.alloc::<f32>((total * 2 + SHARED_LEN + 1) * bvh.NODE_FLOATS);
    let triBase = 0;
    let nodeBase = 0;
    k = 0;
    while k < SHARED_LEN {
        m.roots[k] = -1;
        let verts = SHARED[k].verts;
        let n = verts.len / 36;
        if n > 0 && triBase + n <= TRACE_MAX {
            let corners = mem.alloc::<f32>(n * 9);
            let t = 0;
            while t < n * 3 {
                corners[t * 3] = verts[t * 12];
                corners[t * 3 + 1] = verts[t * 12 + 1];
                corners[t * 3 + 2] = verts[t * 12 + 2];
                t += 1;
            }
            let tree = bvh.build(corners, n, &mem);
            if tree.depth > 45 && TRACE_WARNED != 0 - tree.depth {
                TRACE_WARNED = 0 - tree.depth;
                let deep = Text.new(scratch(0));
                deep.pushStr("scene3d: a URP mesh tree is ");
                deep.pushInt(tree.depth);
                deep.pushStr(" deep; traced rays may skip geometry");
                io.printLn(deep.str());
            }
            // Triangles in leaf order: corner, two edges, three corner normals, color.
            let j = 0;
            while j < n {
                let v = tree.order[j] * 36;
                let at = (triBase + j) * 28;
                let p0 = Vec3.xyz(verts[v], verts[v + 1], verts[v + 2]);
                put3(tris, at, p0);
                put3(tris, at + 4, Vec3.xyz(verts[v + 12], verts[v + 13], verts[v + 14]) - p0);
                put3(tris, at + 8, Vec3.xyz(verts[v + 24], verts[v + 25], verts[v + 26]) - p0);
                let c = 0;
                while c < 3 {
                    put3(tris, at + 12 + c * 4, Vec3.xyz(verts[v + c * 12 + 3], verts[v + c * 12 + 4], verts[v + c * 12 + 5]));
                    c += 1;
                }
                put3(tris, at + 24, Vec3.xyz(verts[v + 6], verts[v + 7], verts[v + 8]));
                j += 1;
            }
            // Nodes point at triangles (leaves) and children (inner) in the shared textures.
            let q = 0;
            while q < tree.count {
                let from = q * bvh.NODE_FLOATS;
                let to = (nodeBase + q) * bvh.NODE_FLOATS;
                let f = 0;
                while f < bvh.NODE_FLOATS {
                    nodes[to + f] = tree.nodes[from + f];
                    f += 1;
                }
                nodes[to + 3] += f32(if tree.nodes[from + 7] > 0 { triBase } else { nodeBase });
                q += 1;
            }
            m.roots[k] = nodeBase;
            triBase += n;
            nodeBase += tree.count;
        }
        k += 1;
    }
    gfx.traceMeshes(&m.data, tris, triBase, nodes, nodeBase);
    mem.destroy();
}

/// Upload the scene's traced objects (where each mesh is, and its look) and a BVH over
/// their world boxes into `out`.
fn traceObjects(scene: &Scene, transforms: []Mat4, out: &Traced) {
    let mem = Arena.create(scene.len * 512 + 64 * 1024);
    let boxes = mem.alloc::<f32>(scene.len * 9 + 9);
    let which = mem.alloc::<int>(scene.len + 1);
    let roots = mem.alloc::<int>(scene.len + 1);
    let count = 0;
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        let k = if traced(n) { sharedSlot(n.asset, n.texture) } else { -1 };
        if k >= 0 && k < TRACE_MESHES.roots.len && TRACE_MESHES.roots[k] >= 0 {
            let lo = SHARED[k].lo;
            let hi = SHARED[k].hi;
            let model = transforms[i];
            let wlo = model.transformPoint(lo);
            let whi = wlo;
            let c = 1;
            while c < 8 {
                let x = if c % 2 == 1 { hi.x } else { lo.x };
                let y = if (c / 2) % 2 == 1 { hi.y } else { lo.y };
                let z = if c / 4 == 1 { hi.z } else { lo.z };
                let p = model.transformPoint(Vec3.xyz(x, y, z));
                wlo = Vec3.xyz(min(wlo.x, p.x), min(wlo.y, p.y), min(wlo.z, p.z));
                whi = Vec3.xyz(max(whi.x, p.x), max(whi.y, p.y), max(whi.z, p.z));
                c += 1;
            }
            // ponytail: each box goes to `bvh.build` as the triangle (lo, hi, center), whose
            // bounds are the box and whose centroid is its center.
            put3(boxes, count * 9, wlo);
            put3(boxes, count * 9 + 3, whi);
            put3(boxes, count * 9 + 6, (wlo + whi) * 0.5);
            which[count] = i;
            roots[count] = TRACE_MESHES.roots[k];
            count += 1;
        }
        i += 1;
    }
    let tree = bvh.build(boxes, count, &mem);
    // The shader's object stack holds 32.
    if tree.depth > 29 && TRACE_WARNED != 0 - 1000 - tree.depth {
        TRACE_WARNED = 0 - 1000 - tree.depth;
        let deep = Text.new(scratch(0));
        deep.pushStr("scene3d: the URP object tree is ");
        deep.pushInt(tree.depth);
        deep.pushStr(" deep; traced rays may skip objects");
        io.printLn(deep.str());
    }
    // Objects in leaf order: world-to-object rows, then the look.
    let inst = mem.alloc::<f32>(count * 24 + 4);
    let j = 0;
    while j < count {
        let from = tree.order[j];
        let obj = scene.nodes[which[from]];
        let inv = transforms[which[from]].inverseAffine();
        let at = j * 24;
        let r = 0;
        while r < 3 {
            inst[at + r * 4] = inv.m[r];
            inst[at + r * 4 + 1] = inv.m[4 + r];
            inst[at + r * 4 + 2] = inv.m[8 + r];
            inst[at + r * 4 + 3] = inv.m[12 + r];
            r += 1;
        }
        let look = gfx.plainSurface();
        let opacity: f32 = 1;
        if obj.mat > 0 {
            look = MATS[obj.mat - 1].look;
            opacity = MATS[obj.mat - 1].opacity;
        }
        look = tinted(look, obj);
        put3(inst, at + 12, look.tint);
        inst[at + 15] = look.reflect;
        put3(inst, at + 16, look.glow);
        inst[at + 19] = look.ior;
        inst[at + 20] = look.rough;
        inst[at + 21] = opacity;
        inst[at + 22] = look.cloud;
        inst[at + 23] = f32(roots[from]);
        j += 1;
    }
    gfx.traceInstances(out, inst, count, tree.nodes, tree.count);
    mem.destroy();
}

fn put3(out: []f32, at: int, v: Vec3) {
    out[at] = v.x;
    out[at + 1] = v.y;
    out[at + 2] = v.z;
}

/// The vertices URP traces for `n`: a visible mesh's, not a sky's.
fn traceVerts(n: Node): []f32 {
    if n.kind != MESH || n.gpu.vao == 0 || isSky(n) { return []f32 { ptr: 0 as &f32, len: 0 }; }
    let k = sharedSlot(n.asset, n.texture);
    if k < 0 { return []f32 { ptr: 0 as &f32, len: 0 }; }
    return SHARED[k].verts;
}

#[singleton]
let SKY_DRAWN: bool = false;

/// Draw the scene's sky boxes now, behind anything drawn later, such as an editor grid.
/// The next `draw` or `drawWith` then leaves them out.
pub fn drawSky(scene: &Scene) {
    let i = 0;
    while i < scene.len {
        let sky = scene.nodes[i];
        if isSky(sky) && sky.gpu.vao != 0 {
            look(sky);
            gfx.drawSky(sky.gpu);
        }
        i += 1;
    }
    SKY_DRAWN = true;
}

/// Draw with matrices produced by `worlds` for this scene. See-through meshes go last,
/// farthest from the camera first.
pub fn drawWith(scene: &Scene, transforms: []Mat4) {
    if !SKY_DRAWN { drawSky(scene); }
    SKY_DRAWN = false;
    gfx.skyImage(skyImage(scene));
    traceScene(scene, transforms);
    if gfx.inCameraPass() { flushUpdate(scene, transforms); }
    let blended = 0;
    let batch = scratch(0).alloc::<int>(scene.len);
    let batched = 0;
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if n.kind == MESH && n.gpu.vao != 0 && !isSky(n) {
            let mode = alphaOf(n);
            if mode == BLEND { blended += 1; }
            else if !gfx.visible(transforms[i], n.boundLo, n.boundHi) {}
            else if mode == OPAQUE && biasOf(scene, i) == 0 && (n.mat == 0 || MATS[n.mat - 1].look.ior <= 1.001) {
                batch[batched] = i;
                batched += 1;
            } else { drawNode(n, transforms[i], biasOf(scene, i)); }
        }
        i += 1;
    }
    drawBatches(scene, transforms, []int { ptr: batch.ptr, len: batched });
    if blended == 0 {
        plain();
        return;
    }
    let order = scratch(0).alloc::<int>(blended);
    let far = scratch(0).alloc::<f32>(blended);
    let eye = gfx.cameraEye();
    let count = 0;
    i = 0;
    while i < scene.len {
        let see = scene.nodes[i];
        if see.kind == MESH && see.gpu.vao != 0 && !isSky(see) && alphaOf(see) == BLEND
            && gfx.visible(transforms[i], see.boundLo, see.boundHi) {
            // ponytail: insertion sort by origin distance; fine for the few see-through meshes a scene has.
            let d = (transforms[i].transformPoint(Vec3.xyz(0, 0, 0)) - eye).length();
            let k = count;
            while k > 0 && far[k - 1] < d {
                far[k] = far[k - 1];
                order[k] = order[k - 1];
                k -= 1;
            }
            far[k] = d;
            order[k] = i;
            count += 1;
        }
        i += 1;
    }
    i = 0;
    while i < count {
        let back = scene.nodes[order[i]];
        // Glass bends what's behind it, so it needs a copy of everything drawn so far,
        // other glass included (farthest first).
        if gfx.inCameraPass() && back.mat > 0 && MATS[back.mat - 1].look.ior > 1.001 { gfx.grab(); }
        drawNode(back, transforms[order[i]], biasOf(scene, order[i]));
        i += 1;
    }
    plain();
}

/// Whether `a` and `b` draw the same: same mesh, material, texture, tint, and sides.
fn sameLook(a: Node, b: Node): bool {
    return a.gpu.vao == b.gpu.vao && a.mat == b.mat && a.image.id == b.image.id
        && a.doubleSided == b.doubleSided && a.tint.x == b.tint.x && a.tint.y == b.tint.y && a.tint.z == b.tint.z;
}

/// Draw the opaque nodes `list` (indexes into `scene.nodes`), one instanced draw per look.
fn drawBatches(scene: &Scene, transforms: []Mat4, list: []int) {
    if list.len == 0 { return; }
    // Group by look: an open-addressed table maps a look to its group's first member, and
    // `next` chains each member to the following one.
    let size = 16;
    while size < list.len * 2 { size *= 2; }
    let table = scratch(0).alloc::<int>(size);
    let k = 0;
    while k < size {
        table[k] = -1;
        k += 1;
    }
    let next = scratch(0).alloc::<int>(list.len);
    let last = scratch(0).alloc::<int>(list.len);
    let heads = scratch(0).alloc::<int>(list.len);
    let groups = 0;
    k = 0;
    while k < list.len {
        let n = scene.nodes[list[k]];
        next[k] = -1;
        let h = (int(n.gpu.vao) * 31 + n.mat * 7 + int(n.image.id) * 13) % size;
        while true {
            let first = table[h];
            if first < 0 {
                table[h] = k;
                last[k] = k;
                heads[groups] = k;
                groups += 1;
                break;
            }
            if sameLook(scene.nodes[list[first]], n) {
                next[last[first]] = k;
                last[first] = k;
                break;
            }
            h = (h + 1) % size;
        }
        k += 1;
    }
    let models = scratch(0).alloc::<Mat4>(list.len);
    let g = 0;
    while g < groups {
        let count = 0;
        k = heads[g];
        while k >= 0 {
            models[count] = transforms[list[k]];
            count += 1;
            k = next[k];
        }
        let head = scene.nodes[list[heads[g]]];
        if count == 1 {
            drawNode(head, models[0], 0);
        } else {
            look(head);
            let copies = []Mat4 { ptr: models.ptr, len: count };
            if head.doubleSided { gfx.drawInstancedDoubleSided(head.gpu, copies); }
            else { gfx.drawInstanced(head.gpu, copies); }
        }
        g += 1;
    }
}

/// The first sky box's image, which mirrors reflect; none when the scene has no sky box.
fn skyImage(scene: &Scene): Tex {
    let i = 0;
    while i < scene.len {
        if isSky(scene.nodes[i]) && scene.nodes[i].image.id != 0 { return scene.nodes[i].image; }
        i += 1;
    }
    return Tex { id: 0, w: 0, h: 0 };
}

/// Leave gfx untinted for whatever the game draws next.
fn plain() {
    gfx.material(Vec3.xyz(1, 1, 1), Vec3.xyz(0, 0, 0));
}

/// `n`'s transparency: its material's mode when that sets one, else its own.
/// A material that leaves the mode to each object but is see-through (`opacity` under 1)
/// blends anyway, so its opacity shows.
fn alphaOf(n: Node): int {
    if n.mat > 0 {
        let m = MATS[n.mat - 1];
        if m.mode >= 0 { return m.mode; }
        if m.opacity < 0.999 || m.look.ior > 1.001 { return BLEND; }
    }
    return n.alpha;
}

/// Set gfx's surface and albedo for `n`.
fn look(n: Node) {
    if n.mat > 0 {
        let m = MATS[n.mat - 1];
        gfx.surface(tinted(m.look, n));
        if m.image.id != 0 { gfx.albedo(m.image); } else { gfx.albedo(n.image); }
    } else {
        gfx.surface(tinted(gfx.plainSurface(), n));
        gfx.albedo(n.image);
    }
}

/// `s` with its tint multiplied by the node's.
fn tinted(s: Surface, n: Node): Surface {
    let out = s;
    out.tint = mulVec(s.tint, n.tint);
    return out;
}

fn mulVec(a: Vec3, b: Vec3): Vec3 {
    return Vec3.xyz(a.x * b.x, a.y * b.y, a.z * b.z);
}

fn drawNode(n: Node, model: Mat4, bias: f32) {
    look(n);
    let opacity = n.opacity;
    // Light the object lets through to its shadow; black is a solid shadow.
    let through = Vec3.zero();
    if n.mat > 0 {
        let m = MATS[n.mat - 1];
        if m.mode >= 0 || m.opacity < 0.999 { opacity = m.opacity; }
        // Glass bends light by how thick the object is.
        let size = (n.boundHi - n.boundLo);
        let across = (model.transformPoint(size) - model.transformPoint(Vec3.zero())).length();
        let s = tinted(m.look, n);
        s.thickness = across * 0.5;
        gfx.surface(s);
        // Clear glass passes its tint, less what frosting and reflection keep back.
        if m.look.ior > 1.001 { through = m.look.tint * ((1 - m.look.cloud) * 0.96); }
    }
    let mode = alphaOf(n);
    if mode == BLEND && through.x + through.y + through.z == 0 {
        through = Vec3.xyz(1 - opacity, 1 - opacity, 1 - opacity);
    }
    gfx.castShadow(through);
    if bias > 0 { gfx.depthBias(bias); }
    if mode == CUTOUT {
        gfx.drawCutout(n.gpu, model);
    } else if mode == BLEND {
        gfx.drawBlended(n.gpu, model, opacity);
    } else if n.doubleSided {
        gfx.drawDoubleSided(n.gpu, model);
    } else {
        gfx.draw(n.gpu, model);
    }
    if bias > 0 { gfx.depthBias(0); }
    gfx.castShadow(Vec3.zero());
}
