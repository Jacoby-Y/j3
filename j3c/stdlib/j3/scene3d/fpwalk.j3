/// First-person walker for scene3d games: mouse look, WASD, Shift to sprint, Space to jump,
/// and pushing out of boxes around the scene's objects. The floor is flat at y = 0.
// ponytail: flat floor at y = 0 and static boxes; stand-on-top and moving colliders when a game needs them.

module j3.scene3d.fpwalk;

use j3.game;
use j3.game.Key;
use j3.gfx.Look;
use j3.math.{ Mat4, Vec3, asin, atan2, clamp, cos, sin, sqrt };
use j3.memory.Arena;
use j3.scene3d;
use j3.scene3d.{ Scene, CAMERA, INSTANCE, MESH };
use j3.text;

const EYE: f32 = 1.7;
const RADIUS: f32 = 0.35;
const GRAVITY: f32 = 22;
const JUMP: f32 = 7.5;

/// An object's box in its own space: `toLocal` takes world points there, `toWorld` brings
/// them back. `scale` is its (uniform) scale, so the walker's radius shrinks with it. `path`
/// is the placed scene or mesh asset, for `walkThrough` and `trunks`.
struct Box {
    toLocal: Mat4;
    toWorld: Mat4;
    lo: Vec3;
    hi: Vec3;
    scale: f32;
    path: string;
}

pub struct Walker {
    /// Feet position.
    pos: Vec3;
    yaw: f32;
    pitch: f32;
    fall: f32;
    boxes: []Box;
    count: int;
}

/// A walker at the origin with room for `capacity` boxes.
pub fn empty(mem: &Arena, capacity: int): Walker {
    return Walker { pos: Vec3.xyz(0, 0, 0), yaw: 0, pitch: 0, fall: 0, boxes: mem.alloc::<Box>(capacity), count: 0 };
}

/// Start where the scene's camera is, looking where it looks, with a box around each object.
/// Call after `scene3d.upload`: boxes need the meshes' bounds.
pub fn spawn(scene: &Scene, mem: &Arena): Walker {
    let w = empty(mem, scene.len);
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if n.kind == CAMERA && n.owner == 0 {
            let model = scene3d.world(scene, n.id);
            let eye = model.transformPoint(Vec3.xyz(0, 0, 0));
            let forward = (model.transformPoint(Vec3.xyz(0, 0, -1)) - eye).normalize();
            w.pos = Vec3.xyz(eye.x, 0, eye.z);
            w.yaw = atan2(forward.x, 0 - forward.z);
            w.pitch = asin(forward.y);
            break;
        }
        i += 1;
    }
    colliders(&w, scene, mem);
    return w;
}

/// Add a box from `lo` to `hi` in the space `world` maps to the scene. Ignored when full.
pub fn addBox(w: &Walker, world: Mat4, lo: Vec3, hi: Vec3, scale: f32, path: string) {
    if w.count >= w.boxes.len { return; }
    w.boxes[w.count] = Box { toLocal: world.affineInverse(), toWorld: world, lo: lo, hi: hi, scale: scale, path: path };
    w.count += 1;
}

/// Walk through everything whose placed scene or mesh asset contains `part` (grass, flowers).
pub fn walkThrough(w: &Walker, part: string) {
    let kept = 0;
    let i = 0;
    while i < w.count {
        if !text.contains(w.boxes[i].path, part) {
            w.boxes[kept] = w.boxes[i];
            kept += 1;
        }
        i += 1;
    }
    w.count = kept;
}

/// Shrink the boxes whose path contains `part` to `keep` of their width, around the middle
/// (a tree keeps only its trunk).
pub fn trunks(w: &Walker, part: string, keep: f32) {
    let i = 0;
    while i < w.count {
        let b = w.boxes[i];
        if text.contains(b.path, part) {
            let mid = (b.lo + b.hi) * 0.5;
            let hx = (b.hi.x - b.lo.x) * keep * 0.5;
            let hz = (b.hi.z - b.lo.z) * keep * 0.5;
            w.boxes[i].lo = Vec3.xyz(mid.x - hx, b.lo.y, mid.z - hz);
            w.boxes[i].hi = Vec3.xyz(mid.x + hx, b.hi.y, mid.z + hz);
        }
        i += 1;
    }
}

/// One box per placed scene around all its meshes, and one per top-level mesh (not the sky
/// or a ground plane).
// ponytail: one box per object, so a house is solid and a fountain is its bounding box.
fn colliders(w: &Walker, scene: &Scene, mem: &Arena) {
    let at = mem.alloc::<Mat4>(scene.len);
    scene3d.worlds(scene, at);
    let i = 0;
    while i < scene.len {
        let n = scene.nodes[i];
        if n.owner == 0 && n.kind == MESH && n.gpu.vao != 0 && !scene3d.isSky(n) && !text.same(n.asset, "builtin:plane") {
            addBox(w, at[i], n.boundLo, n.boundHi, n.scale.x, n.asset);
        }
        if n.owner != 0 || n.kind != INSTANCE { i += 1; continue; }
        let toLocal = at[i].affineInverse();
        let lo = Vec3.xyz(1000000, 1000000, 1000000);
        let hi = Vec3.xyz(-1000000, -1000000, -1000000);
        let k = 0;
        while k < scene.len {
            let m = scene.nodes[k];
            if m.owner == n.id && m.kind == MESH && m.gpu.vao != 0 {
                let into = toLocal.mul(at[k]);
                let c = 0;
                while c < 8 {
                    let corner = m.boundLo;
                    if c - (c / 2) * 2 == 1 { corner.x = m.boundHi.x; }
                    if (c / 2) - (c / 4) * 2 == 1 { corner.y = m.boundHi.y; }
                    if c >= 4 { corner.z = m.boundHi.z; }
                    let q = into.transformPoint(corner);
                    lo = Vec3.xyz(min(lo.x, q.x), min(lo.y, q.y), min(lo.z, q.z));
                    hi = Vec3.xyz(max(hi.x, q.x), max(hi.y, q.y), max(hi.z, q.z));
                    c += 1;
                }
            }
            k += 1;
        }
        if lo.x < hi.x { addBox(w, at[i], lo, hi, n.scale.x, n.scene); }
        i += 1;
    }
}

fn min(a: f32, b: f32): f32 { if a < b { return a; } return b; }
fn max(a: f32, b: f32): f32 { if a > b { return a; } return b; }

/// Mouse look and WASD while `looking` (the mouse is captured and no menu is open).
pub fn update(w: &Walker, dt: f32, looking: bool, sensitivity: f32, speed: f32) {
    if looking {
        let d = game.mouseDelta();
        w.yaw += d.x * 0.0025 * sensitivity;
        w.pitch = clamp(w.pitch - d.y * 0.0025 * sensitivity, -1.45, 1.45);
    }
    let fx = sin(w.yaw);
    let fz = 0 - cos(w.yaw);
    let mx: f32 = 0;
    let mz: f32 = 0;
    if looking {
        if game.keyDown(Key.W) { mx += fx; mz += fz; }
        if game.keyDown(Key.S) { mx -= fx; mz -= fz; }
        if game.keyDown(Key.D) { mx -= fz; mz += fx; }
        if game.keyDown(Key.A) { mx += fz; mz -= fx; }
    }
    let run = speed;
    if game.keyDown(Key.Shift) { run *= 2; }
    step(w, mx, mz, run, looking && game.keyPressed(Key.Space), dt);
}

/// Move toward world direction (`mx`, `mz`) at `speed`, jump from the floor when `jump`,
/// fall, and push out of boxes. No input read, so tests can drive it.
pub fn step(w: &Walker, mx: f32, mz: f32, speed: f32, jump: bool, dt: f32) {
    let len = sqrt(mx * mx + mz * mz);
    if len > 0 {
        w.pos.x += mx / len * speed * dt;
        w.pos.z += mz / len * speed * dt;
    }
    if jump && w.pos.y <= 0 { w.fall = JUMP; }
    w.fall -= GRAVITY * dt;
    w.pos.y += w.fall * dt;
    if w.pos.y < 0 {
        w.pos.y = 0;
        w.fall = 0;
    }
    pushOut(w);
}

/// Move the walker out of every box it overlaps, sideways only.
fn pushOut(w: &Walker) {
    let i = 0;
    while i < w.count {
        let b = w.boxes[i];
        let feet = b.toLocal.transformPoint(w.pos);
        let head = b.toLocal.transformPoint(Vec3.xyz(w.pos.x, w.pos.y + EYE, w.pos.z));
        let r = RADIUS / b.scale;
        if head.y > b.lo.y && feet.y < b.hi.y
            && feet.x > b.lo.x - r && feet.x < b.hi.x + r && feet.z > b.lo.z - r && feet.z < b.hi.z + r {
            let cx = clamp(feet.x, b.lo.x, b.hi.x);
            let cz = clamp(feet.z, b.lo.z, b.hi.z);
            let dx = feet.x - cx;
            let dz = feet.z - cz;
            let d = sqrt(dx * dx + dz * dz);
            if d > 0.0001 {
                if d < r {
                    feet.x = cx + dx / d * r;
                    feet.z = cz + dz / d * r;
                }
            } else {
                // Inside: leave by the nearest side.
                let west = feet.x - b.lo.x;
                let east = b.hi.x - feet.x;
                let north = feet.z - b.lo.z;
                let south = b.hi.z - feet.z;
                let least = min(min(west, east), min(north, south));
                if least == west { feet.x = b.lo.x - r; }
                else if least == east { feet.x = b.hi.x + r; }
                else if least == north { feet.z = b.lo.z - r; }
                else { feet.z = b.hi.z + r; }
            }
            let back = b.toWorld.transformPoint(feet);
            w.pos.x = back.x;
            w.pos.z = back.z;
        }
        i += 1;
    }
}

/// The view from the walker's eyes, for `scene3d.drawFrame`.
pub fn look(w: &Walker): Look {
    return Look.create(Vec3.xyz(w.pos.x, w.pos.y + EYE, w.pos.z), w.yaw, w.pitch);
}
