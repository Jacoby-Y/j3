/// `.j3fx` shader effect files, parsed without GL. A file is `key=value` header lines, a
/// `---` line, then GLSL:
///
/// ```
/// kind=material
/// param.bands=int:3
/// param.rim=color:1,0.8,0.4
/// ---
/// vec3 effect(Surface s, vec3 lit) { ... }
/// ```
///
/// `kind` is `material` (the default) or `camera`. Params are `float`, `int`, `bool`, or
/// `color` (`r,g,b`), each a `uFx_<name>` uniform. Blank lines and `#` lines are skipped.

module j3.scene3d.fx;

use j3.gfx.{ FxParam, FX_FLOAT, FX_INT, FX_BOOL, FX_COLOR, FX_PARAMS, FX_FLOATS, fxWidth };
use j3.data.save;
use j3.memory.Arena;
use j3.text.{ Text, same };

pub struct FxFile {
    /// False when the file can't be used; `error` says why, with its line.
    ok: bool;
    error: string;
    camera: bool;
    params: []FxParam;
    /// Everything after the `---` line.
    glsl: string;
    /// File line of `glsl`'s first line (1-based).
    bodyLine: int;
}

/// Parse a `.j3fx` file's bytes. Strings point into `bytes` or `arena`.
pub fn parseEffect(bytes: []u8, arena: &Arena): FxFile {
    let out = FxFile { ok: false, error: "", camera: false, params: arena.alloc::<FxParam>(FX_PARAMS), glsl: "", bodyLine: 0 };
    let count = 0;
    let floats = 0;
    let line = 1;
    let at = 0;
    while at < bytes.len {
        let end = at;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let stop = end;
        if stop > at && bytes[stop - 1] == 13 { stop -= 1; }
        if stop - at == 3 && bytes[at] == 45 && bytes[at + 1] == 45 && bytes[at + 2] == 45 {
            out.ok = true;
            out.params = []FxParam { ptr: out.params.ptr, len: count };
            out.bodyLine = line + 1;
            let from = if end < bytes.len { end + 1 } else { end };
            out.glsl = slice(bytes, from, bytes.len);
            return out;
        }
        if stop > at && bytes[at] != 35 {
            let eq = at;
            while eq < stop && bytes[eq] != 61 { eq += 1; }
            if eq == stop { return fail(out, line, "expected key=value", arena); }
            let key = slice(bytes, at, eq);
            let value = slice(bytes, eq + 1, stop);
            if same(key, "kind") {
                if same(value, "camera") { out.camera = true; }
                else if same(value, "material") { out.camera = false; }
                else { return fail(out, line, "kind is material or camera", arena); }
            } else if key.len > 6 && same(slice(key as []u8, 0, 6), "param.") {
                let name = slice(key as []u8, 6, key.len);
                if !wordOk(name) { return fail(out, line, "param names use letters, digits, and _", arena); }
                let k = 0;
                while k < count {
                    if same(out.params[k].name, name) { return fail(out, line, "param named twice", arena); }
                    k += 1;
                }
                if count >= FX_PARAMS { return fail(out, line, "more than 8 params", arena); }
                let colon = 0;
                while colon < value.len && value[colon] != 58 { colon += 1; }
                let kind = kindOf(slice(value as []u8, 0, colon));
                if kind < 0 { return fail(out, line, "param types are float, int, bool, color", arena); }
                floats += fxWidth(kind);
                if floats > FX_FLOATS { return fail(out, line, "params take more than 16 floats", arena); }
                let p = FxParam { name: name, kind: kind, def: [0, 0, 0] };
                if colon < value.len { defaults(&p, value as []u8, colon + 1); }
                out.params[count] = p;
                count += 1;
            } else {
                return fail(out, line, "unknown key (kind, param.<name>)", arena);
            }
        }
        at = end + 1;
        line += 1;
    }
    return fail(out, line, "no --- line before the GLSL", arena);
}

/// Rewrite a GL compile log so line numbers point into the `.j3fx` file: `firstLine` is
/// where its GLSL starts in the compiled source, `bodyLine` where it starts in the file.
/// Knows Mesa (`0:<line>(<col>): ...`), NVIDIA (`0(<line>) : ...`), and AMD/Intel
/// (`ERROR: 0:<line>: ...`); other lines and lines
/// outside the file's GLSL pass through unchanged.
pub fn mapGlslLog(log: string, path: string, firstLine: int, bodyLine: int, out: &Text) {
    let bytes = log as []u8;
    let at = 0;
    while at < bytes.len {
        let end = at;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        if end > at {
            let n = 0 - 1;
            let rest = end;
            // AMD and Intel: ERROR: 0:<line>: <rest> (also WARNING:).
            let from = at;
            let tag = "";
            if startsAt(bytes, at, end, "ERROR: ") { from = at + 7; tag = "error: "; }
            if startsAt(bytes, at, end, "WARNING: ") { from = at + 9; tag = "warning: "; }
            let i = digits(bytes, from, end);
            if from > at && i > from && i < end && bytes[i] == 58 {
                let j2 = digits(bytes, i + 1, end);
                if j2 > i + 1 && j2 < end && bytes[j2] == 58 {
                    n = save.parseInt(bytes, i + 1, 0);
                    rest = j2 + 1;
                    while rest < end && bytes[rest] == 32 { rest += 1; }
                }
            } else if i > at && i < end && bytes[i] == 58 {
                // Mesa: 0:<line>(<col>): <rest>
                let j = digits(bytes, i + 1, end);
                if j > i + 1 && j < end && bytes[j] == 40 {
                    n = save.parseInt(bytes, i + 1, 0);
                    let k = j;
                    while k + 2 < end && !(bytes[k] == 41 && bytes[k + 1] == 58 && bytes[k + 2] == 32) { k += 1; }
                    rest = k + 3;
                }
            } else if i > at && i < end && bytes[i] == 40 {
                // NVIDIA: 0(<line>) : <rest>
                let close = digits(bytes, i + 1, end);
                if close > i + 1 && close + 3 < end && bytes[close] == 41 && bytes[close + 1] == 32 && bytes[close + 2] == 58 && bytes[close + 3] == 32 {
                    n = save.parseInt(bytes, i + 1, 0);
                    rest = close + 4;
                }
            }
            if n >= firstLine && rest <= end {
                out.pushStr(path);
                out.push(58);
                out.pushInt(n - firstLine + bodyLine);
                out.pushStr(": ");
                out.pushStr(tag);
                out.pushStr(slice(bytes, rest, end));
            } else {
                out.pushStr(slice(bytes, at, end));
            }
            out.push(10);
        }
        at = end + 1;
    }
}

fn fail(out: FxFile, line: int, why: string, arena: &Arena): FxFile {
    let t = Text.new(arena);
    t.pushStr("line ");
    t.pushInt(line);
    t.pushStr(": ");
    t.pushStr(why);
    out.ok = false;
    out.error = t.str();
    return out;
}

fn startsAt(bytes: []u8, at: int, end: int, prefix: string): bool {
    if end - at < prefix.len { return false; }
    let k = 0;
    while k < prefix.len {
        if bytes[at + k] != prefix[k] { return false; }
        k += 1;
    }
    return true;
}

fn slice(bytes: []u8, from: int, to: int): string {
    return []u8 { ptr: (bytes.ptr as int + from) as &u8, len: to - from } as string;
}

/// End of the run of ASCII digits starting at `at`.
fn digits(bytes: []u8, at: int, end: int): int {
    let i = at;
    while i < end && bytes[i] >= 48 && bytes[i] <= 57 { i += 1; }
    return i;
}

fn wordOk(name: string): bool {
    if name.len == 0 { return false; }
    let i = 0;
    while i < name.len {
        let c = name[i];
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if !ok { return false; }
        i += 1;
    }
    return true;
}

fn kindOf(t: string): int {
    if same(t, "float") { return FX_FLOAT; }
    if same(t, "int") { return FX_INT; }
    if same(t, "bool") { return FX_BOOL; }
    if same(t, "color") { return FX_COLOR; }
    return 0 - 1;
}

/// Fill `p.def` from the text after the `:` at `at`.
fn defaults(p: &FxParam, value: []u8, at: int) {
    if p.kind == FX_BOOL {
        let v = slice(value, at, value.len);
        p.def[0] = if same(v, "true") || same(v, "1") { 1 } else { 0 };
        return;
    }
    if p.kind == FX_INT {
        p.def[0] = f32(save.parseInt(value, at, 0));
        return;
    }
    let i = at;
    let k = 0;
    while k < fxWidth(p.kind) && i < value.len {
        p.def[k] = save.parseFloat(value, i);
        while i < value.len && value[i] != 44 { i += 1; }
        i += 1;
        k += 1;
    }
}
