// LIB_ARRAY: `push pop insert remove pick map filter find sort join keys has`. Part of `j3.j2`.
//
// `map`/`filter`/`find`/`sort` call script fns (re-entrant). A callback may change the array it
// is walking: the walk re-reads the length each step, so it never reads past the end, and `sort`
// sorts a snapshot it then writes back. New arrays are `protect`ed while callbacks run.

module j3.j2;

extend Vm {
    fn openArrayLib(this: &Vm) {
        this.bindLib("push", libPush);
        this.bindLib("pop", libPop);
        this.bindLib("insert", libInsert);
        this.bindLib("remove", libRemove);
        this.bindLib("pick", libPick);
        this.bindLib("map", libMap);
        this.bindLib("filter", libFilter);
        this.bindLib("find", libFind);
        this.bindLib("sort", libSort);
        this.bindLib("join", libJoin);
        this.bindLib("keys", libKeys);
        this.bindLib("has", libHas);
    }

    /// `f(x)`; false (error pending, `passOn` it) when it failed.
    fn call1(this: &Vm, f: Value, x: Value, out: &Value): bool {
        let one: [1]Value = [x];
        match this.call(f, one[0..1]) {
            Result.Ok(r) { *out = r; }
            Result.Err(_) { return false; }
        }
        return true;
    }
}

/// `push(a, v)`: append.
fn libPush(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    if vm.raised { return nilv(); }
    arrOf(a).push(vm.heap, args.get(1));
    return nilv();
}

/// `pop(a)`: remove and return the last value; nil when empty.
fn libPop(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    if vm.raised { return nilv(); }
    return arrOf(a).pop();
}

/// `insert(a, i, v)`: put `v` before index `i` (0..len).
fn libInsert(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let i = args.int(1);
    if vm.raised { return nilv(); }
    if i < 0 || i > arrOf(a).len { return outOfRange(vm, "insert", i, arrOf(a).len + 1); }
    // the values after `i` move: charged like bytes
    if !vm.chargeNative((arrOf(a).len - i) * @sizeof(Value)) { return nilv(); }
    arrOf(a).insert(vm.heap, i, args.get(2));
    return nilv();
}

/// `remove(a, i)`: take out and return `a[i]`.
fn libRemove(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let i = args.int(1);
    if vm.raised { return nilv(); }
    if i < 0 || i >= arrOf(a).len { return outOfRange(vm, "remove", i, arrOf(a).len); }
    if !vm.chargeNative((arrOf(a).len - i) * @sizeof(Value)) { return nilv(); }
    return arrOf(a).remove(i);
}

/// `<what>: index i is out of range (len n)`.
fn outOfRange(vm: &Vm, what: string, i: int, n: int): Value {
    let t = vm.errText();
    t.pushStr(what);
    t.pushStr(": index ");
    t.pushInt(i);
    t.pushStr(" is out of range (0 to ");
    t.pushInt(n - 1);
    t.pushStr(")");
    vm.raised = true;
    return nilv();
}

/// `pick(a)`: a random element (the VM's seeded sequence); nil when empty.
fn libPick(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    if vm.raised { return nilv(); }
    let n = arrOf(a).len;
    if n == 0 { return nilv(); }
    return arrOf(a).get(int(vm.nextRand() % u64(n)));
}

/// `map(a, f)`: a new array of `f(v)` for each value.
fn libMap(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let f = args.func(1);
    if vm.raised { return nilv(); }
    let out = vm.protect(vm.heap.newArray(arrOf(a).len));
    let i = 0;
    while i < arrOf(a).len {
        let r = nilv();
        if !vm.call1(f, arrOf(a).get(i), &r) { return vm.passOn(); }
        arrOf(out).push(vm.heap, r);
        i += 1;
    }
    return out;
}

/// `filter(a, f)`: a new array of the values `f` is true for.
fn libFilter(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let f = args.func(1);
    if vm.raised { return nilv(); }
    let out = vm.protect(vm.heap.newArray(0));
    let i = 0;
    while i < arrOf(a).len {
        // the callback may drop `v` from `a`: protect it until it is in `out` (or skipped)
        let mark = vm.ntemps;
        let v = vm.protect(arrOf(a).get(i));
        let r = nilv();
        if !vm.call1(f, v, &r) { return vm.passOn(); }
        if r.truthy() { arrOf(out).push(vm.heap, v); }
        vm.ntemps = mark;
        i += 1;
    }
    return out;
}

/// `find(a, f)`: the first value `f` is true for; nil when none.
fn libFind(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let f = args.func(1);
    if vm.raised { return nilv(); }
    let i = 0;
    while i < arrOf(a).len {
        // the callback may drop `v` from `a`: protect it until it is returned (or skipped)
        let mark = vm.ntemps;
        let v = vm.protect(arrOf(a).get(i));
        let r = nilv();
        if !vm.call1(f, v, &r) { return vm.passOn(); }
        if r.truthy() { return v; }
        vm.ntemps = mark;
        i += 1;
    }
    return nilv();
}

/// `x` before `y`: `less(x, y)` (`f(x, y)` is true), or `<` (numbers, or strings by bytes)
/// without `f`. False with the error pending.
fn sortLess(vm: &Vm, f: Value, x: Value, y: Value, out: &bool): bool {
    if f.isNil() { return vm.less(OP_LT, x, y, out); }
    let two: [2]Value = [x, y];
    match vm.call(f, two[0..2]) {
        Result.Ok(r) { *out = r.truthy(); }
        Result.Err(_) { return false; }
    }
    return true;
}

/// `sort(a)` / `sort(a, less)`: sort in place, ascending; `less(x, y)` says whether `x` goes
/// first. A stable bottom-up merge sort over a snapshot: O(n log n) calls whatever `less`
/// answers, so an inconsistent one gives some order but can't loop or crash; an error stops it.
fn libSort(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let f = nilv();
    if !args.get(1).isNil() { f = args.func(1); }
    if vm.raised { return nilv(); }
    let n = arrOf(a).len;
    if n < 2 { return nilv(); }
    let src = vm.protect(vm.heap.newArray(n));
    let dst = vm.protect(vm.heap.newArray(n));
    for i in 0..n {
        arrOf(src).push(vm.heap, arrOf(a).get(i));
        arrOf(dst).push(vm.heap, nilv());
    }
    let width = 1;
    while width < n {
        // each pass compares and moves n values (a `less` fn also pays for its own calls)
        if !vm.chargeNative(n * @sizeof(Value)) { return nilv(); }
        let s = arrOf(src).values();
        let d = arrOf(dst).values();
        let lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let i = lo;
            let j = mid;
            let k = lo;
            while i < mid && j < hi {
                let takeRight = false;
                if !sortLess(vm, f, s[j], s[i], &takeRight) { return vm.passOn(); }
                if takeRight {
                    d[k] = s[j];
                    j += 1;
                } else {
                    d[k] = s[i];
                    i += 1;
                }
                k += 1;
            }
            while i < mid {
                d[k] = s[i];
                i += 1;
                k += 1;
            }
            while j < hi {
                d[k] = s[j];
                j += 1;
                k += 1;
            }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        width *= 2;
    }
    // a callback may have resized `a`: it becomes the sorted snapshot
    let out = arrOf(a);
    out.len = 0;
    let sorted = arrOf(src).values();
    for i in 0..n { out.push(vm.heap, sorted[i]); }
    return nilv();
}

/// `join(a, sep)`: the `str()` texts with `sep` between (no `sep`: nothing between).
fn libJoin(vm: &Vm, args: Args): Value {
    let a = args.array(0);
    let sep = if args.get(1).isNil() { "" } else { args.str(1) };
    if vm.raised { return nilv(); }
    let b = &vm.sb;
    b.clear();
    let xs = arrOf(a).values();
    for i in 0..xs.len {
        if i > 0 { b.pushStr(sep); }
        fmtBuf(b, xs[i]);
    }
    return vm.bufOut(b);
}

/// `keys(t)`: the field names (any key type), in the order they were added.
fn libKeys(vm: &Vm, args: Args): Value {
    let tv = args.table(0);
    if vm.raised { return nilv(); }
    let t = tableOf(tv.v);
    let out = vm.heap.newArray(t.count());
    let i = t.next(0);
    while i >= 0 {
        arrOf(out).push(vm.heap, t.entries()[i].key);
        i = t.next(i + 1);
    }
    return out;
}

/// `has(t, name)`: whether field `name` is set (not nil).
fn libHas(vm: &Vm, args: Args): Value {
    let tv = args.table(0);
    if vm.raised { return nilv(); }
    return boolv(!tableOf(tv.v).get(args.get(1)).isNil());
}
