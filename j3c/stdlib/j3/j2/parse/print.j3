// AST back to source: one statement per line, 4-space indents, parentheses only where
// precedence needs them. Comments and the original layout are gone, but the text parses to the
// same tree (the round-trip test checks print(parse(print(parse(x)))) == print(parse(x))).
// Part of `j3.j2.parse`.

module j3.j2.parse;

struct Printer {
    ast: &Ast;
    t: Text;
    indent: int;
}

/// The source text of `ast`, on `mem`.
pub fn print(ast: &Ast, mem: &Arena): string {
    let p = Printer { ast: ast, t: Text.new(mem), indent: 0 };
    let root = ast.root;
    for i in 0..ast.node(root).count {
        p.stmt(ast.kid(root, i));
    }
    return p.t.str();
}

/// Binding power of expression node `n` (higher binds tighter).
fn precOf(nd: &Node): int {
    if nd.kind == N_BINARY { return binaryPrec(nd.op); }
    if nd.kind == N_UNARY { return PREC_UNARY; }
    if (nd.kind == N_INT && nd.i < 0) || (nd.kind == N_FLOAT && nd.f < 0.0) { return PREC_UNARY; }
    return PREC_POSTFIX;
}

/// Source text of operator token `k`.
pub fn opText(k: int): string {
    if k == lex.T_PLUS { return "+"; }
    if k == lex.T_MINUS { return "-"; }
    if k == lex.T_STAR { return "*"; }
    if k == lex.T_SLASH { return "/"; }
    if k == lex.T_PERCENT { return "%"; }
    if k == lex.T_EQ { return "=="; }
    if k == lex.T_NE { return "!="; }
    if k == lex.T_LT { return "<"; }
    if k == lex.T_LE { return "<="; }
    if k == lex.T_GT { return ">"; }
    if k == lex.T_GE { return ">="; }
    if k == lex.T_AND { return "&&"; }
    if k == lex.T_OR { return "||"; }
    if k == lex.T_NOT { return "!"; }
    if k == lex.T_ASSIGN { return "="; }
    if k == lex.T_PLUS_EQ { return "+="; }
    if k == lex.T_MINUS_EQ { return "-="; }
    if k == lex.T_STAR_EQ { return "*="; }
    if k == lex.T_SLASH_EQ { return "/="; }
    if k == lex.T_PERCENT_EQ { return "%="; }
    return "?";
}

extend Printer {
    fn nl(this: &Printer) {
        this.t.push(10);
        for i in 0..this.indent { this.t.pushStr("    "); }
    }

    fn stmt(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        let k = nd.kind;
        if (k == N_LET || k == N_FNDECL) && (nd.flags & F_PUB) != 0 { this.t.pushStr("pub "); }
        if k == N_LET {
            this.t.pushStr(if (nd.flags & F_CONST) != 0 { "const " } else { "let " });
            this.t.pushStr(nd.s);
            if nd.a >= 0 {
                this.t.pushStr(" = ");
                this.expr(nd.a, 1);
            }
            this.t.push(59);
        } else if k == N_FNDECL {
            this.t.pushStr("fn ");
            this.t.pushStr(nd.s);
            this.fnRest(n);
        } else if k == N_USE {
            this.t.pushStr("use ");
            this.t.pushStr(nd.s);
            this.t.push(59);
        } else if k == N_ASSIGN {
            this.leading(nd.a);
            this.t.push(32);
            this.t.pushStr(opText(nd.op));
            this.t.push(32);
            this.expr(nd.b, 1);
            this.t.push(59);
        } else if k == N_EXPR {
            this.leading(nd.a);
            this.t.push(59);
        } else if k == N_IF {
            this.ifRest(n);
        } else if k == N_WHILE {
            this.t.pushStr("while ");
            this.expr(nd.a, 1);
            this.t.push(32);
            this.block(nd.b);
        } else if k == N_FOR_RANGE {
            this.t.pushStr("for ");
            this.t.pushStr(nd.s);
            this.t.pushStr(" in ");
            this.expr(nd.a, 1);
            this.t.pushStr("..");
            this.expr(nd.b, 1);
            this.t.push(32);
            this.block(nd.c);
        } else if k == N_FOR_IN {
            this.t.pushStr("for ");
            for i in 0..nd.count {
                if i > 0 { this.t.pushStr(", "); }
                this.t.pushStr(this.ast.node(this.ast.kid(n, i)).s);
            }
            this.t.pushStr(" in ");
            this.expr(nd.a, 1);
            this.t.push(32);
            this.block(nd.c);
        } else if k == N_BREAK {
            this.t.pushStr("break;");
        } else if k == N_CONTINUE {
            this.t.pushStr("continue;");
        } else if k == N_RETURN {
            this.t.pushStr("return");
            if nd.a >= 0 {
                this.t.push(32);
                this.expr(nd.a, 1);
            }
            this.t.push(59);
        } else if k == N_MATCH {
            this.t.pushStr("match ");
            this.expr(nd.a, 1);
            this.t.pushStr(" {");
            this.indent += 1;
            for i in 0..nd.count {
                let arm = this.ast.node(this.ast.kid(n, i));
                this.nl();
                if arm.a < 0 { this.t.push(95); } else { this.expr(arm.a, 1); }
                this.t.push(32);
                this.block(arm.b);
            }
            this.indent -= 1;
            this.nl();
            this.t.push(125);
        } else if k == N_BLOCK {
            this.block(n);
        }
        this.t.push(10);
        for i in 0..this.indent { this.t.pushStr("    "); }
    }

    fn ifRest(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        this.t.pushStr("if ");
        this.expr(nd.a, 1);
        this.t.push(32);
        this.block(nd.b);
        if nd.c >= 0 {
            this.t.pushStr(" else ");
            if this.ast.node(nd.c).kind == N_IF { this.ifRest(nd.c); } else { this.block(nd.c); }
        }
    }

    fn block(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        if nd.count == 0 {
            this.t.pushStr("{}");
            return;
        }
        this.t.push(123);
        this.indent += 1;
        this.nl();
        for i in 0..nd.count { this.stmt(this.ast.kid(n, i)); }
        // `stmt` ended with a newline at the inner indent; pull the brace back out
        this.t.remove(this.t.len() - 4, 4);
        this.indent -= 1;
        this.t.push(125);
    }

    /// `(params) { body }` of an N_FN or N_FNDECL.
    fn fnRest(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        this.t.push(40);
        for i in 0..nd.count {
            if i > 0 { this.t.pushStr(", "); }
            this.t.pushStr(this.ast.node(this.ast.kid(n, i)).s);
        }
        this.t.pushStr(") ");
        this.block(nd.b);
    }

    /// An expression that starts a statement: wrapped when it starts with `{`, which would
    /// read as a block.
    fn leading(this: &Printer, n: int) {
        let wrap = this.startsWithTable(n);
        if wrap { this.t.push(40); }
        this.expr(n, 1);
        if wrap { this.t.push(41); }
    }

    fn startsWithTable(this: &Printer, n: int): bool {
        let nd = this.ast.node(n);
        if nd.kind == N_TABLE { return true; }
        if nd.kind == N_BINARY || nd.kind == N_FIELD || nd.kind == N_INDEX || nd.kind == N_CALL {
            return precOf(this.ast.node(nd.a)) >= binaryPrec(nd.op) && this.startsWithTable(nd.a);
        }
        return false;
    }

    /// Expression `n` where the context needs binding power `min`.
    fn expr(this: &Printer, n: int, min: int) {
        let nd = this.ast.node(n);
        let wrap = precOf(nd) < min;
        if wrap { this.t.push(40); }
        this.exprInner(n);
        if wrap { this.t.push(41); }
    }

    fn exprInner(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        let k = nd.kind;
        if k == N_NIL { this.t.pushStr("nil"); }
        else if k == N_TRUE { this.t.pushStr("true"); }
        else if k == N_FALSE { this.t.pushStr("false"); }
        else if k == N_INT { this.t.pushInt(nd.i); }
        else if k == N_FLOAT { lex.fmtFloat(&this.t, nd.f); }
        else if k == N_STR { lex.quote(&this.t, nd.s); }
        else if k == N_NAME { this.t.pushStr(nd.s); }
        else if k == N_TPL {
            this.t.push(96);
            for i in 0..nd.count {
                let part = this.ast.kid(n, i);
                if i % 2 == 0 {
                    lex.escapeInto(&this.t, this.ast.node(part).s, 96);
                } else {
                    this.t.push(123);
                    this.expr(part, 1);
                    this.t.push(125);
                }
            }
            this.t.push(96);
        } else if k == N_UNARY {
            this.t.pushStr(opText(nd.op));
            this.expr(nd.a, PREC_UNARY);
        } else if k == N_BINARY {
            let p = binaryPrec(nd.op);
            this.expr(nd.a, p);
            this.t.push(32);
            this.t.pushStr(opText(nd.op));
            this.t.push(32);
            this.expr(nd.b, p + 1);
        } else if k == N_FIELD {
            this.expr(nd.a, PREC_POSTFIX);
            this.t.push(46);
            this.t.pushStr(nd.s);
        } else if k == N_INDEX {
            this.expr(nd.a, PREC_POSTFIX);
            this.t.push(91);
            this.expr(nd.b, 1);
            this.t.push(93);
        } else if k == N_CALL {
            this.expr(nd.a, PREC_POSTFIX);
            this.t.push(40);
            this.items(n);
            this.t.push(41);
        } else if k == N_ARRAY {
            this.t.push(91);
            this.items(n);
            this.t.push(93);
        } else if k == N_TABLE {
            this.t.push(123);
            for i in 0..nd.count {
                let pair = this.ast.node(this.ast.kid(n, i));
                if i > 0 { this.t.pushStr(", "); }
                if (pair.flags & F_QUOTED) != 0 { lex.quote(&this.t, pair.s); } else { this.t.pushStr(pair.s); }
                this.t.pushStr(": ");
                this.expr(pair.a, 1);
            }
            this.t.push(125);
        } else if k == N_FN {
            this.t.pushStr("fn");
            this.fnRest(n);
        }
    }

    /// A node's kid list, comma separated.
    fn items(this: &Printer, n: int) {
        for i in 0..this.ast.node(n).count {
            if i > 0 { this.t.pushStr(", "); }
            this.expr(this.ast.kid(n, i), 1);
        }
    }
}
