// AST back to source: one statement per line, 4-space indents, parentheses only where
// precedence needs them. Comments and the original layout are gone, but the text parses to the
// same tree (the round-trip test checks print(parse(print(parse(x)))) == print(parse(x))).
// Part of `j3.j2.parse`.

module j3.j2.parse;

struct Printer {
    ast: &Ast;
    t: Text;
    indent: int;
}

/// The source text of `ast`, on `mem`.
pub fn print(ast: &Ast, mem: &Arena): string {
    let p = Printer { ast: ast, t: Text.new(mem), indent: 0 };
    let root = ast.root;
    for i in 0..ast.node(root).count {
        p.stmt(ast.kid(root, i));
    }
    return p.t.str();
}

/// Binding power of expression node `n` (higher binds tighter).
fn precOf(nd: &Node): int {
    return match nd.kind {
        Kind.Binary { binaryPrec(nd.op) }
        Kind.Unary { PREC_UNARY }
        Kind.Int if nd.i < 0 { PREC_UNARY }
        Kind.Float if nd.f < 0.0 { PREC_UNARY }
        _ { PREC_POSTFIX }
    };
}

/// Source text of operator token `k`.
pub fn opText(k: Tok): string {
    return match k {
        Tok.Plus { "+" }
        Tok.Minus { "-" }
        Tok.Star { "*" }
        Tok.Slash { "/" }
        Tok.Percent { "%" }
        Tok.Eq { "==" }
        Tok.Ne { "!=" }
        Tok.Lt { "<" }
        Tok.Le { "<=" }
        Tok.Gt { ">" }
        Tok.Ge { ">=" }
        Tok.And { "&&" }
        Tok.Or { "||" }
        Tok.Not { "!" }
        Tok.Assign { "=" }
        Tok.PlusEq { "+=" }
        Tok.MinusEq { "-=" }
        Tok.StarEq { "*=" }
        Tok.SlashEq { "/=" }
        Tok.PercentEq { "%=" }
        _ { "?" }
    };
}

extend Printer {
    fn nl(this: &Printer) {
        this.t.push('\n');
        for i in 0..this.indent { this.t.pushStr("    "); }
    }

    fn stmt(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        let t = &this.t;
        match nd.kind {
            Kind.Let {
                if (nd.flags & F_PUB) != 0 { t.pushStr("pub "); }
                t.pushStr(if (nd.flags & F_CONST) != 0 { "const " } else { "let " });
                t.pushStr(nd.s);
                if nd.a >= 0 {
                    t.pushStr(" = ");
                    this.expr(nd.a, 1);
                }
                t.push(';');
            }
            Kind.FnDecl {
                if (nd.flags & F_PUB) != 0 { t.pushStr("pub "); }
                t.pushStr("fn ");
                t.pushStr(nd.s);
                this.fnRest(n);
            }
            Kind.Use {
                t.pushStr("use ");
                t.pushStr(nd.s);
                t.push(';');
            }
            Kind.Assign {
                this.leading(nd.a);
                t.push(' ');
                t.pushStr(opText(nd.op));
                t.push(' ');
                this.expr(nd.b, 1);
                t.push(';');
            }
            Kind.Expr {
                this.leading(nd.a);
                t.push(';');
            }
            Kind.If { this.ifRest(n); }
            Kind.While {
                t.pushStr("while ");
                this.expr(nd.a, 1);
                t.push(' ');
                this.block(nd.b);
            }
            Kind.ForRange {
                t.pushStr("for ");
                t.pushStr(nd.s);
                t.pushStr(" in ");
                this.expr(nd.a, 1);
                t.pushStr("..");
                this.expr(nd.b, 1);
                t.push(' ');
                this.block(nd.c);
            }
            Kind.ForIn {
                t.pushStr("for ");
                for i in 0..nd.count {
                    if i > 0 { t.pushStr(", "); }
                    t.pushStr(this.ast.node(this.ast.kid(n, i)).s);
                }
                t.pushStr(" in ");
                this.expr(nd.a, 1);
                t.push(' ');
                this.block(nd.c);
            }
            Kind.Break { t.pushStr("break;"); }
            Kind.Continue { t.pushStr("continue;"); }
            Kind.Return {
                t.pushStr("return");
                if nd.a >= 0 {
                    t.push(' ');
                    this.expr(nd.a, 1);
                }
                t.push(';');
            }
            Kind.Match {
                t.pushStr("match ");
                this.expr(nd.a, 1);
                t.pushStr(" {");
                this.indent += 1;
                for i in 0..nd.count {
                    let arm = this.ast.node(this.ast.kid(n, i));
                    this.nl();
                    if arm.a < 0 { t.push('_'); } else { this.expr(arm.a, 1); }
                    t.push(' ');
                    this.block(arm.b);
                }
                this.indent -= 1;
                this.nl();
                t.push('}');
            }
            Kind.Block { this.block(n); }
            _ {}
        }
        this.nl();
    }

    fn ifRest(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        this.t.pushStr("if ");
        this.expr(nd.a, 1);
        this.t.push(' ');
        this.block(nd.b);
        if nd.c >= 0 {
            this.t.pushStr(" else ");
            if this.ast.node(nd.c).kind == Kind.If { this.ifRest(nd.c); } else { this.block(nd.c); }
        }
    }

    fn block(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        if nd.count == 0 {
            this.t.pushStr("{}");
            return;
        }
        this.t.push('{');
        this.indent += 1;
        this.nl();
        for i in 0..nd.count { this.stmt(this.ast.kid(n, i)); }
        // `stmt` ended with a newline at the inner indent; pull the brace back out
        this.t.remove(this.t.len() - 4, 4);
        this.indent -= 1;
        this.t.push('}');
    }

    /// `(params) { body }` of an Fn or FnDecl.
    fn fnRest(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        this.t.push('(');
        for i in 0..nd.count {
            if i > 0 { this.t.pushStr(", "); }
            this.t.pushStr(this.ast.node(this.ast.kid(n, i)).s);
        }
        this.t.pushStr(") ");
        this.block(nd.b);
    }

    /// An expression that starts a statement: wrapped when it starts with `{`, which would
    /// read as a block.
    fn leading(this: &Printer, n: int) {
        let wrap = this.startsWithTable(n);
        if wrap { this.t.push('('); }
        this.expr(n, 1);
        if wrap { this.t.push(')'); }
    }

    fn startsWithTable(this: &Printer, n: int): bool {
        let nd = this.ast.node(n);
        return match nd.kind {
            Kind.Table { true }
            Kind.Binary | Kind.Field | Kind.Index | Kind.Call {
                precOf(this.ast.node(nd.a)) >= binaryPrec(nd.op) && this.startsWithTable(nd.a)
            }
            _ { false }
        };
    }

    /// Expression `n` where the context needs binding power `min`.
    fn expr(this: &Printer, n: int, min: int) {
        let wrap = precOf(this.ast.node(n)) < min;
        if wrap { this.t.push('('); }
        this.exprInner(n);
        if wrap { this.t.push(')'); }
    }

    fn exprInner(this: &Printer, n: int) {
        let nd = this.ast.node(n);
        let t = &this.t;
        match nd.kind {
            Kind.Nil { t.pushStr("nil"); }
            Kind.True { t.pushStr("true"); }
            Kind.False { t.pushStr("false"); }
            Kind.Int { t.pushInt(nd.i); }
            Kind.Float { lex.fmtFloat(t, nd.f); }
            Kind.Str { lex.quote(t, nd.s); }
            Kind.Name { t.pushStr(nd.s); }
            Kind.Tpl {
                t.push('`');
                for i in 0..nd.count {
                    let part = this.ast.kid(n, i);
                    if i % 2 == 0 {
                        lex.escapeInto(t, this.ast.node(part).s, '`');
                    } else {
                        t.push('{');
                        this.expr(part, 1);
                        t.push('}');
                    }
                }
                t.push('`');
            }
            Kind.Unary {
                t.pushStr(opText(nd.op));
                this.expr(nd.a, PREC_UNARY);
            }
            Kind.Binary {
                let p = binaryPrec(nd.op);
                this.expr(nd.a, p);
                t.push(' ');
                t.pushStr(opText(nd.op));
                t.push(' ');
                this.expr(nd.b, p + 1);
            }
            Kind.Field {
                this.expr(nd.a, PREC_POSTFIX);
                t.push('.');
                t.pushStr(nd.s);
            }
            Kind.Index {
                this.expr(nd.a, PREC_POSTFIX);
                t.push('[');
                this.expr(nd.b, 1);
                t.push(']');
            }
            Kind.Call {
                this.expr(nd.a, PREC_POSTFIX);
                t.push('(');
                this.items(n);
                t.push(')');
            }
            Kind.Array {
                t.push('[');
                this.items(n);
                t.push(']');
            }
            Kind.Table {
                t.push('{');
                for i in 0..nd.count {
                    let pair = this.ast.node(this.ast.kid(n, i));
                    if i > 0 { t.pushStr(", "); }
                    if (pair.flags & F_QUOTED) != 0 { lex.quote(t, pair.s); } else { t.pushStr(pair.s); }
                    t.pushStr(": ");
                    this.expr(pair.a, 1);
                }
                t.push('}');
            }
            Kind.Fn {
                t.pushStr("fn");
                this.fnRest(n);
            }
            _ {}
        }
    }

    /// A node's kid list, comma separated.
    fn items(this: &Printer, n: int) {
        for i in 0..this.ast.node(n).count {
            if i > 0 { this.t.pushStr(", "); }
            this.expr(this.ast.kid(n, i), 1);
        }
    }
}
