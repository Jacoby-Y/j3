// Statements: declarations, control flow, assignment. Part of `j3.j2.parse`.

module j3.j2.parse;

extend Parser {
    /// One statement. `top`: at the top level of the chunk, where `pub` and `use` are allowed.
    fn statement(this: &Parser, top: bool): int {
        if !this.enter() { return -1; }
        let n = this.statementInner(top);
        this.depth -= 1;
        return n;
    }

    fn statementInner(this: &Parser, top: bool): int {
        let t = this.tok();
        return match t.kind {
            Tok.Pub if !top { this.failNode(t, "`pub` is only allowed at the top level") }
            Tok.Pub {
                this.bump();
                let k = this.tok().kind;
                let n = match k {
                    Tok.Let | Tok.Const { this.letStmt() }
                    Tok.Fn if this.peekKind(1) == Tok.Name { this.fnDecl() }
                    _ {
                        this.expected("`let`, `const` or `fn` after `pub`");
                        -1
                    }
                };
                if n >= 0 { this.n(n).flags |= F_PUB; }
                n
            }
            Tok.Let | Tok.Const { this.letStmt() }
            Tok.Fn if this.peekKind(1) == Tok.Name { this.fnDecl() }
            Tok.Use if !top { this.failNode(t, "`use` is only allowed at the top level") }
            Tok.Use {
                this.bump();
                let n = this.node(Kind.Use, t);
                let name = this.name("a script name after `use`");
                this.n(n).s = name;
                this.expect(Tok.Semi, "`;`");
                n
            }
            Tok.If { this.ifStmt() }
            Tok.Else { this.failNode(t, "`else` without `if`") }
            Tok.While {
                this.bump();
                let n = this.node(Kind.While, t);
                let cond = this.expr();
                let body = this.block();
                this.n(n).a = cond;
                this.n(n).b = body;
                n
            }
            Tok.For { this.forStmt() }
            Tok.Break | Tok.Continue {
                this.bump();
                let n = this.node(if t.kind == Tok.Break { Kind.Break } else { Kind.Continue }, t);
                this.expect(Tok.Semi, "`;`");
                n
            }
            Tok.Return {
                this.bump();
                let n = this.node(Kind.Return, t);
                if this.tok().kind != Tok.Semi {
                    let v = this.expr();
                    this.n(n).a = v;
                }
                this.expect(Tok.Semi, "`;`");
                n
            }
            Tok.Match { this.matchStmt() }
            Tok.LBrace { this.block() }
            _ { this.exprStmt() }
        };
    }

    /// Fail with `msg` at `t`; the "node" is -1.
    fn failNode(this: &Parser, t: Token, msg: string): int {
        this.failAt(t, msg);
        return -1;
    }

    /// `{ statements }`.
    fn block(this: &Parser): int {
        let open = this.expect(Tok.LBrace, "`{`");
        if this.failed { return -1; }
        let n = this.node(Kind.Block, open);
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != Tok.RBrace && this.tok().kind != Tok.Eof {
            this.stack.push(this.statement(false));
        }
        this.expect(Tok.RBrace, "`}`");
        this.closeKids(n, mark);
        return n;
    }

    fn letStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(Kind.Let, t);
        let isConst = t.kind == Tok.Const;
        if isConst { this.n(n).flags |= F_CONST; }
        let name = this.name("a name after `let`");
        if isConst && this.failed {
            return n;
        }
        this.n(n).s = name;
        if isConst || this.tok().kind == Tok.Assign {
            this.expect(Tok.Assign, "`=`");
            let v = this.expr();
            this.n(n).a = v;
        }
        this.expect(Tok.Semi, "`;`");
        return n;
    }

    fn fnDecl(this: &Parser): int {
        let t = this.bump();
        let name = this.name("a function name");
        let n = this.fnRest(t);
        if n >= 0 {
            this.n(n).kind = Kind.FnDecl;
            this.n(n).s = name;
        }
        return n;
    }

    /// `(params) { body }` after `fn` (and a name), as an Fn at `t`.
    fn fnRest(this: &Parser, t: Token): int {
        let n = this.node(Kind.Fn, t);
        this.expect(Tok.LParen, "`(`");
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != Tok.RParen {
            let pt = this.tok();
            let pname = this.name("a parameter name");
            if this.failed { break; }
            let p = this.node(Kind.Name, pt);
            this.n(p).s = pname;
            this.stack.push(p);
            if !this.accept(Tok.Comma) { break; }
        }
        this.expect(Tok.RParen, "`,` or `)`");
        this.closeKids(n, mark);
        if this.n(n).count > 0 && this.n(this.ast.kid(n, 0)).s == "this" {
            this.n(n).flags |= F_THIS;
        }
        let body = this.block();
        this.n(n).b = body;
        return n;
    }

    fn ifStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(Kind.If, t);
        let cond = this.expr();
        let then = this.block();
        this.n(n).a = cond;
        this.n(n).b = then;
        if this.tok().kind == Tok.Else {
            this.bump();
            let other = -1;
            if this.tok().kind == Tok.If {
                if !this.enter() { return n; }
                other = this.ifStmt();
                this.depth -= 1;
            } else {
                other = this.block();
            }
            this.n(n).c = other;
        }
        return n;
    }

    fn forStmt(this: &Parser): int {
        let t = this.bump();
        let mark = this.stack.len;
        let names = 0;
        while !this.failed {
            let vt = this.tok();
            let v = this.name("a loop variable");
            if this.failed { break; }
            let p = this.node(Kind.Name, vt);
            this.n(p).s = v;
            this.stack.push(p);
            names += 1;
            if names == 2 || !this.accept(Tok.Comma) { break; }
        }
        this.expect(Tok.In, "`in`");
        let from = this.expr();
        let n = -1;
        if this.tok().kind == Tok.DotDot {
            if names == 2 && !this.failed {
                this.failAt(this.tok(), "a range loop takes one variable");
            }
            this.bump();
            n = this.node(Kind.ForRange, t);
            if names > 0 { this.n(n).s = this.n(this.stack.items[mark]).s; }
            this.stack.len = mark;
            let to = this.expr();
            this.n(n).a = from;
            this.n(n).b = to;
        } else {
            n = this.node(Kind.ForIn, t);
            this.closeKids(n, mark);
            this.n(n).a = from;
        }
        let body = this.block();
        this.n(n).c = body;
        return n;
    }

    fn matchStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(Kind.Match, t);
        let subject = this.expr();
        this.n(n).a = subject;
        this.expect(Tok.LBrace, "`{`");
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != Tok.RBrace {
            let at = this.tok();
            let arm = this.node(Kind.Arm, at);
            let pat = this.pattern();
            let body = this.block();
            this.n(arm).a = pat;
            this.n(arm).b = body;
            this.stack.push(arm);
        }
        if !this.failed && this.stack.len == mark {
            this.expected("a match arm");
        }
        this.expect(Tok.RBrace, "`}`");
        this.closeKids(n, mark);
        return n;
    }

    /// A match arm's pattern: a literal (a number may have a `-`), or `_` (-1).
    fn pattern(this: &Parser): int {
        let t = this.tok();
        let next = this.peekKind(1);
        return match t.kind {
            Tok.Name if this.src[t.s..t.e] == "_" {
                this.bump();
                -1
            }
            Tok.Minus if next == Tok.Int || next == Tok.Float {
                this.bump();
                let lit = this.primary();
                let nd = this.n(lit);
                nd.i = 0 - nd.i;
                nd.f = 0.0 - nd.f;
                nd.line = t.line;
                nd.col = t.col;
                lit
            }
            Tok.Int | Tok.Float | Tok.Str | Tok.True | Tok.False | Tok.Nil { this.primary() }
            _ {
                this.expected("a match pattern (a number, string, `true`, `false`, `nil` or `_`)");
                -1
            }
        };
    }

    /// An expression statement or an assignment, then `;`.
    fn exprStmt(this: &Parser): int {
        let t = this.tok();
        let e = this.expr();
        if this.failed { return -1; }
        let k = this.tok().kind;
        match k {
            Tok.Assign | Tok.PlusEq | Tok.MinusEq | Tok.StarEq | Tok.SlashEq | Tok.PercentEq {
                match this.n(e).kind {
                    Kind.Name | Kind.Field | Kind.Index {}
                    _ { return this.failNode(t, "can only assign to a name, a field or an index"); }
                }
                let op = this.bump();
                let n = this.node(Kind.Assign, op);
                let v = this.expr();
                let nd = this.n(n);
                nd.op = k;
                nd.a = e;
                nd.b = v;
                this.expect(Tok.Semi, "`;`");
                return n;
            }
            _ {}
        }
        let n = this.node1(Kind.Expr, t, e);
        this.expect(Tok.Semi, "`;`");
        return n;
    }
}
