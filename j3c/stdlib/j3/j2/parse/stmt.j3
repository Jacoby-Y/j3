// Statements: declarations, control flow, assignment. Part of `j3.j2.parse`.

module j3.j2.parse;

extend Parser {
    /// One statement. `top`: at the top level of the chunk, where `pub` and `use` are allowed.
    fn statement(this: &Parser, top: bool): int {
        if !this.enter() { return -1; }
        let n = this.statementInner(top);
        this.depth -= 1;
        return n;
    }

    fn statementInner(this: &Parser, top: bool): int {
        let t = this.tok();
        let k = t.kind;
        if k == lex.K_PUB {
            if !top {
                this.failAt(t, "`pub` is only allowed at the top level");
                return -1;
            }
            this.bump();
            let k2 = this.tok().kind;
            let n = -1;
            if k2 == lex.K_LET || k2 == lex.K_CONST {
                n = this.letStmt();
            } else if k2 == lex.K_FN && this.peekKind(1) == lex.T_NAME {
                n = this.fnDecl();
            } else {
                this.expected("`let`, `const` or `fn` after `pub`");
                return -1;
            }
            if n >= 0 { this.n(n).flags |= F_PUB; }
            return n;
        }
        if k == lex.K_LET || k == lex.K_CONST { return this.letStmt(); }
        if k == lex.K_FN && this.peekKind(1) == lex.T_NAME { return this.fnDecl(); }
        if k == lex.K_USE {
            if !top {
                this.failAt(t, "`use` is only allowed at the top level");
                return -1;
            }
            this.bump();
            let n = this.node(N_USE, t);
            let name = this.name("a script name after `use`");
            this.n(n).s = name;
            this.expect(lex.T_SEMI, "`;`");
            return n;
        }
        if k == lex.K_IF { return this.ifStmt(); }
        if k == lex.K_ELSE {
            this.failAt(t, "`else` without `if`");
            return -1;
        }
        if k == lex.K_WHILE {
            this.bump();
            let n = this.node(N_WHILE, t);
            let cond = this.expr();
            let body = this.block();
            this.n(n).a = cond;
            this.n(n).b = body;
            return n;
        }
        if k == lex.K_FOR { return this.forStmt(); }
        if k == lex.K_BREAK || k == lex.K_CONTINUE {
            this.bump();
            let n = this.node(if k == lex.K_BREAK { N_BREAK } else { N_CONTINUE }, t);
            this.expect(lex.T_SEMI, "`;`");
            return n;
        }
        if k == lex.K_RETURN {
            this.bump();
            let n = this.node(N_RETURN, t);
            if this.tok().kind != lex.T_SEMI {
                let v = this.expr();
                this.n(n).a = v;
            }
            this.expect(lex.T_SEMI, "`;`");
            return n;
        }
        if k == lex.K_MATCH { return this.matchStmt(); }
        if k == lex.T_LBRACE { return this.block(); }
        return this.exprStmt();
    }

    /// `{ statements }`.
    fn block(this: &Parser): int {
        let open = this.expect(lex.T_LBRACE, "`{`");
        if this.failed { return -1; }
        let n = this.node(N_BLOCK, open);
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != lex.T_RBRACE && this.tok().kind != lex.T_EOF {
            this.stack.push(this.statement(false));
        }
        this.expect(lex.T_RBRACE, "`}`");
        this.closeKids(n, mark);
        return n;
    }

    fn letStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(N_LET, t);
        let isConst = t.kind == lex.K_CONST;
        if isConst { this.n(n).flags |= F_CONST; }
        let name = this.name("a name after `let`");
        if isConst && this.failed {
            return n;
        }
        this.n(n).s = name;
        if isConst || this.tok().kind == lex.T_ASSIGN {
            this.expect(lex.T_ASSIGN, "`=`");
            let v = this.expr();
            this.n(n).a = v;
        }
        this.expect(lex.T_SEMI, "`;`");
        return n;
    }

    fn fnDecl(this: &Parser): int {
        let t = this.bump();
        let name = this.name("a function name");
        let n = this.fnRest(t);
        if n >= 0 {
            this.n(n).kind = N_FNDECL;
            this.n(n).s = name;
        }
        return n;
    }

    /// `(params) { body }` after `fn` (and a name), as an N_FN at `t`.
    fn fnRest(this: &Parser, t: Token): int {
        let n = this.node(N_FN, t);
        this.expect(lex.T_LPAREN, "`(`");
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != lex.T_RPAREN {
            let pt = this.tok();
            let pname = this.name("a parameter name");
            if this.failed { break; }
            let p = this.node(N_NAME, pt);
            this.n(p).s = pname;
            this.stack.push(p);
            if !this.accept(lex.T_COMMA) { break; }
        }
        this.expect(lex.T_RPAREN, "`,` or `)`");
        this.closeKids(n, mark);
        if this.n(n).count > 0 && this.n(this.ast.kid(n, 0)).s == "this" {
            this.n(n).flags |= F_THIS;
        }
        let body = this.block();
        this.n(n).b = body;
        return n;
    }

    fn ifStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(N_IF, t);
        let cond = this.expr();
        let then = this.block();
        this.n(n).a = cond;
        this.n(n).b = then;
        if this.tok().kind == lex.K_ELSE {
            this.bump();
            let other = -1;
            if this.tok().kind == lex.K_IF {
                if !this.enter() { return n; }
                other = this.ifStmt();
                this.depth -= 1;
            } else {
                other = this.block();
            }
            this.n(n).c = other;
        }
        return n;
    }

    fn forStmt(this: &Parser): int {
        let t = this.bump();
        let mark = this.stack.len;
        let names = 0;
        while !this.failed {
            let vt = this.tok();
            let v = this.name("a loop variable");
            if this.failed { break; }
            let p = this.node(N_NAME, vt);
            this.n(p).s = v;
            this.stack.push(p);
            names += 1;
            if names == 2 || !this.accept(lex.T_COMMA) { break; }
        }
        this.expect(lex.K_IN, "`in`");
        let from = this.expr();
        let n = -1;
        if this.tok().kind == lex.T_DOTDOT {
            if names == 2 && !this.failed {
                this.failAt(this.tok(), "a range loop takes one variable");
            }
            this.bump();
            n = this.node(N_FOR_RANGE, t);
            if names > 0 { this.n(n).s = this.n(this.stack.items[mark]).s; }
            this.stack.len = mark;
            let to = this.expr();
            this.n(n).a = from;
            this.n(n).b = to;
        } else {
            n = this.node(N_FOR_IN, t);
            this.closeKids(n, mark);
            this.n(n).a = from;
        }
        let body = this.block();
        this.n(n).c = body;
        return n;
    }

    fn matchStmt(this: &Parser): int {
        let t = this.bump();
        let n = this.node(N_MATCH, t);
        let subject = this.expr();
        this.n(n).a = subject;
        this.expect(lex.T_LBRACE, "`{`");
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != lex.T_RBRACE {
            let at = this.tok();
            let arm = this.node(N_ARM, at);
            let pat = this.pattern();
            let body = this.block();
            this.n(arm).a = pat;
            this.n(arm).b = body;
            this.stack.push(arm);
        }
        if !this.failed && this.stack.len == mark {
            this.expected("a match arm");
        }
        this.expect(lex.T_RBRACE, "`}`");
        this.closeKids(n, mark);
        return n;
    }

    /// A match arm's pattern: a literal (a number may have a `-`), or `_` (-1).
    fn pattern(this: &Parser): int {
        let t = this.tok();
        let k = t.kind;
        if k == lex.T_NAME && this.src[t.s..t.e] == "_" {
            this.bump();
            return -1;
        }
        if k == lex.T_MINUS && (this.peekKind(1) == lex.T_INT || this.peekKind(1) == lex.T_FLOAT) {
            this.bump();
            let lit = this.primary();
            let nd = this.n(lit);
            nd.i = 0 - nd.i;
            nd.f = 0.0 - nd.f;
            nd.line = t.line;
            nd.col = t.col;
            return lit;
        }
        if k == lex.T_INT || k == lex.T_FLOAT || k == lex.T_STR || k == lex.K_TRUE || k == lex.K_FALSE
            || k == lex.K_NIL {
            return this.primary();
        }
        this.expected("a match pattern (a number, string, `true`, `false`, `nil` or `_`)");
        return -1;
    }

    /// An expression statement or an assignment, then `;`.
    fn exprStmt(this: &Parser): int {
        let t = this.tok();
        let e = this.expr();
        if this.failed { return -1; }
        let k = this.tok().kind;
        if k == lex.T_ASSIGN || (k >= lex.T_PLUS_EQ && k <= lex.T_PERCENT_EQ) {
            let tk = this.n(e).kind;
            if tk != N_NAME && tk != N_FIELD && tk != N_INDEX {
                this.failAt(t, "can only assign to a name, a field or an index");
                return -1;
            }
            let op = this.bump();
            let n = this.node(N_ASSIGN, op);
            let v = this.expr();
            let nd = this.n(n);
            nd.op = k;
            nd.a = e;
            nd.b = v;
            this.expect(lex.T_SEMI, "`;`");
            return n;
        }
        let n = this.node(N_EXPR, t);
        this.n(n).a = e;
        this.expect(lex.T_SEMI, "`;`");
        return n;
    }
}
