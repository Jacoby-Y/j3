// Expressions by precedence, loosest first: `||`, `&&`, comparisons, `+ -`, `* / %`, unary
// `- !`, then postfix `.name`, `[i]`, `(args)` on a primary. Binary operators are left
// associative. Part of `j3.j2.parse`.

module j3.j2.parse;

/// Binding power of a binary operator token, 0 when `k` is not one.
pub fn binaryPrec(k: Tok): int {
    return match k {
        Tok.Or { 1 }
        Tok.And { 2 }
        Tok.Eq | Tok.Ne | Tok.Lt | Tok.Le | Tok.Gt | Tok.Ge { 3 }
        Tok.Plus | Tok.Minus { 4 }
        Tok.Star | Tok.Slash | Tok.Percent { 5 }
        _ { 0 }
    };
}

/// Unary operators bind tighter than every binary one.
pub const PREC_UNARY: int = 6;
/// Postfix operators and primaries.
pub const PREC_POSTFIX: int = 7;

extend Parser {
    fn expr(this: &Parser): int {
        if !this.enter() { return -1; }
        let n = this.binary(1);
        this.depth -= 1;
        return n;
    }

    /// Operators of binding power `min` and up.
    fn binary(this: &Parser, min: int): int {
        let left = this.unary();
        while !this.failed {
            let t = this.tok();
            let prec = binaryPrec(t.kind);
            if prec == 0 || prec < min { break; }
            this.bump();
            let right = this.binary(prec + 1);
            let n = this.node(Kind.Binary, t);
            let nd = this.n(n);
            nd.op = t.kind;
            nd.a = left;
            nd.b = right;
            left = n;
        }
        return left;
    }

    fn unary(this: &Parser): int {
        let t = this.tok();
        if t.kind == Tok.Minus || t.kind == Tok.Not {
            if !this.enter() { return -1; }
            this.bump();
            let a = this.unary();
            this.depth -= 1;
            let n = this.node(Kind.Unary, t);
            this.n(n).op = t.kind;
            this.n(n).a = a;
            return n;
        }
        return this.postfix();
    }

    fn postfix(this: &Parser): int {
        let e = this.primary();
        while !this.failed {
            let t = this.tok();
            match t.kind {
                Tok.Dot {
                    this.bump();
                    let name = this.name("a field name after `.`");
                    e = this.node1(Kind.Field, t, e);
                    this.n(e).s = name;
                }
                Tok.LBrack {
                    this.bump();
                    let i = this.expr();
                    this.expect(Tok.RBrack, "`]`");
                    e = this.node1(Kind.Index, t, e);
                    this.n(e).b = i;
                }
                Tok.LParen {
                    this.bump();
                    e = this.node1(Kind.Call, t, e);
                    let mark = this.stack.len;
                    this.list(Tok.RParen, "`,` or `)`");
                    this.closeKids(e, mark);
                }
                _ { break; }
            }
        }
        return e;
    }

    /// Comma-separated expressions onto the stack up to `close` (a trailing comma is fine).
    fn list(this: &Parser, close: Tok, what: string) {
        while !this.failed && this.tok().kind != close {
            this.stack.push(this.expr());
            if !this.accept(Tok.Comma) { break; }
        }
        this.expect(close, what);
    }

    fn primary(this: &Parser): int {
        let t = this.tok();
        let node = match t.kind {
            Tok.Nil | Tok.True | Tok.False {
                this.bump();
                this.node(match t.kind { Tok.Nil { Kind.Nil } Tok.True { Kind.True } _ { Kind.False } }, t)
            }
            Tok.Int {
                this.bump();
                let n = this.node(Kind.Int, t);
                this.n(n).i = t.i;
                n
            }
            Tok.Float {
                this.bump();
                let n = this.node(Kind.Float, t);
                this.n(n).f = t.f;
                n
            }
            Tok.Str {
                this.bump();
                this.text(t)
            }
            Tok.TplHead { this.template() }
            Tok.Name {
                this.bump();
                let n = this.node(Kind.Name, t);
                this.n(n).s = this.src[t.s..t.e];
                n
            }
            Tok.LParen {
                this.bump();
                let e = this.expr();
                this.expect(Tok.RParen, "`)`");
                e
            }
            Tok.LBrack {
                this.bump();
                let n = this.node(Kind.Array, t);
                let mark = this.stack.len;
                this.list(Tok.RBrack, "`,` or `]`");
                this.closeKids(n, mark);
                n
            }
            Tok.LBrace { this.table() }
            Tok.Fn {
                this.bump();
                this.fnRest(t)
            }
            _ {
                this.expected("an expression");
                -1
            }
        };
        return node;
    }

    /// An Str with the decoded text of string token `t`.
    fn text(this: &Parser, t: Token): int {
        let n = this.node(Kind.Str, t);
        this.n(n).s = lex.strText(this.src, t, this.mem);
        return n;
    }

    /// `` `text{expr}text{expr}text` `` from its TPL_HEAD.
    fn template(this: &Parser): int {
        let head = this.bump();
        let n = this.node(Kind.Tpl, head);
        let mark = this.stack.len;
        this.stack.push(this.text(head));
        while !this.failed {
            this.stack.push(this.expr());
            let t = this.tok();
            if t.kind == Tok.TplMid {
                this.bump();
                this.stack.push(this.text(t));
            } else if t.kind == Tok.TplTail {
                this.bump();
                this.stack.push(this.text(t));
                break;
            } else {
                this.expected("`}` to close the `{` in the string");
            }
        }
        this.closeKids(n, mark);
        return n;
    }

    /// `{ name: value, "key": value, }`.
    fn table(this: &Parser): int {
        let open = this.bump();
        let n = this.node(Kind.Table, open);
        let mark = this.stack.len;
        while !this.failed && this.tok().kind != Tok.RBrace {
            let kt = this.tok();
            let p = this.node(Kind.Pair, kt);
            if kt.kind == Tok.Name {
                this.bump();
                this.n(p).s = this.src[kt.s..kt.e];
            } else if kt.kind == Tok.Str {
                this.bump();
                this.n(p).s = lex.strText(this.src, kt, this.mem);
                this.n(p).flags = F_QUOTED;
            } else {
                this.expected("a field name or `}`");
                break;
            }
            this.expect(Tok.Colon, "`:`");
            let v = this.expr();
            this.n(p).a = v;
            this.stack.push(p);
            if !this.accept(Tok.Comma) { break; }
        }
        this.expect(Tok.RBrace, "`,` or `}`");
        this.closeKids(n, mark);
        return n;
    }
}
