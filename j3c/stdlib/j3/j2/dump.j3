// `dumpProto`: a bytecode listing for tests and `J3_J2_DUMP=1`. Part of `j3.j2`.

module j3.j2;

/// Append a listing of `p` and its child functions to `t`: one line per instruction,
/// `pc line:col OP operands`, with the constant shown after `;` where one is used.
pub fn dumpProto(t: &Text, p: &Proto) {
    t.pushStr("fn ");
    if p.name.tag == T_STR { t.pushStr(textOf(p.name)); } else { t.pushStr("(literal)"); }
    t.pushStr(" params=");
    t.pushInt(p.nparams);
    t.pushStr(" regs=");
    t.pushInt(p.maxStack);
    t.pushStr(" ups=");
    t.pushInt(p.nups);
    if (p.flags & parse.F_THIS) != 0 { t.pushStr(" this"); }
    t.push(10);
    let code = p.codeOf();
    let lines = p.linesOf();
    let ks = p.constsOf();
    for pc in 0..code.len {
        let ins = int(code[pc]);
        let op = ins & 255;
        let a = (ins >> 8) & 255;
        let b = (ins >> 16) & 255;
        let c = (ins >> 24) & 255;
        let bx = ins >> 16;
        t.pushStr("  ");
        t.pushInt(pc);
        t.pushStr("  ");
        t.pushInt(lines[pc] >> 32);
        t.push(58);
        t.pushInt(lines[pc] & 0xffffffff);
        t.pushStr("  ");
        t.pushStr(opName(op));
        t.push(32);
        t.pushInt(a);
        if op == OP_LOADK || op == OP_GETENV || op == OP_SETENV || op == OP_GETGLOBAL || op == OP_CLOSURE
            || op == OP_EXTRA || op == OP_GETPUB || op == OP_SETPUB {
            t.push(32);
            t.pushInt(bx);
        } else if op == OP_JMP || op == OP_JMPIF || op == OP_JMPIFNOT || op == OP_FORPREP || op == OP_FORLOOP
            || op == OP_FORINPREP || op == OP_FORINNEXT {
            t.pushStr(" -> ");
            t.pushInt(pc + 1 + bx - SBX_BIAS);
        } else {
            t.push(32);
            t.pushInt(b);
            t.push(32);
            t.pushInt(c);
        }
        let k = -1;
        if op == OP_LOADK || op == OP_GETGLOBAL || op == OP_GETPUB || op == OP_SETPUB { k = bx; }
        if op == OP_GETFIELD || (op >= OP_ADDK && op <= OP_MODK) { k = c; }
        if op >= OP_TEQ && op <= OP_TGE && (c & TEST_K) != 0 { k = b; }
        if op == OP_SETFIELD { k = b; }
        if op == OP_EXTRA && pc > 0 && (int(code[pc - 1]) & 255) == OP_METHOD { k = bx; }
        if k >= 0 && k < ks.len {
            t.pushStr("  ; ");
            if ks[k].tag == T_STR { lex.quote(t, textOf(ks[k])); } else { fmtValue(t, ks[k]); }
        }
        t.push(10);
    }
    let ps = p.protosOf();
    for i in 0..ps.len { dumpProto(t, ps[i] as ptr as &Proto); }
}
