// LIB_MATH: the global table `math` (`pi sqrt sin cos tan atan2 abs floor ceil min max clamp
// lerp random`) and the global `rand(lo, hi)`. `rand`, `math.random` and `pick` share the VM's
// seeded sequence (`vm.seed`). Part of `j3.j2`.

module j3.j2;

extend Vm {
    fn openMathLib(this: &Vm) {
        this.bindLib("rand", libRand);
        let key = this.heap.lookupStr("math");
        if !key.isNil() && !this.global(key).isNil() { return; }
        let m = this.heap.newTable();
        let t = tableOf(m);
        t.set(this.heap, fix(this.heap.intern("pi")), floatv(3.141592653589793));
        this.mathFn(m, "sqrt", mathSqrt);
        this.mathFn(m, "sin", mathSin);
        this.mathFn(m, "cos", mathCos);
        this.mathFn(m, "tan", mathTan);
        this.mathFn(m, "atan2", mathAtan2);
        this.mathFn(m, "abs", mathAbs);
        this.mathFn(m, "floor", mathFloor);
        this.mathFn(m, "ceil", mathCeil);
        this.mathFn(m, "min", mathMin);
        this.mathFn(m, "max", mathMax);
        this.mathFn(m, "clamp", mathClamp);
        this.mathFn(m, "lerp", mathLerp);
        this.mathFn(m, "random", libRand);
        this.setLibGlobal("math", m);
    }

    /// `math.<name>` = native `f` (errors name it `math.<name>`).
    fn mathFn(this: &Vm, m: Value, name: string, f: fn(&Vm, Args): Value) {
        this.sb.clear();
        this.sb.pushStr("math.");
        this.sb.pushStr(name);
        let full = fix(this.heap.intern(this.sb.str()));
        tableOf(m).set(this.heap, fix(this.heap.intern(name)), this.newNative(full, f));
    }
}

/// `rand(lo, hi)`: a float from `lo` up to (not including) `hi`.
fn libRand(vm: &Vm, args: Args): Value {
    let lo = args.num(0);
    let hi = args.num(1);
    if vm.raised { return nilv(); }
    return floatv(lo + (hi - lo) * vm.randUnit());
}

fn mathSqrt(_vm: &Vm, args: Args): Value { return floatv(libm.sqrt(args.num(0))); }
fn mathSin(_vm: &Vm, args: Args): Value { return floatv(libm.sin(args.num(0))); }
fn mathCos(_vm: &Vm, args: Args): Value { return floatv(libm.cos(args.num(0))); }
fn mathTan(_vm: &Vm, args: Args): Value { return floatv(libm.tan(args.num(0))); }
fn mathAtan2(_vm: &Vm, args: Args): Value { return floatv(libm.atan2(args.num(0), args.num(1))); }

/// `abs(x)`: an int stays an int.
fn mathAbs(_vm: &Vm, args: Args): Value {
    let v = args.get(0);
    if v.tag == T_INT { return intv(if v.bits < 0 { 0 - v.bits } else { v.bits }); }
    let x = args.num(0);
    return floatv(if x < 0.0 { 0.0 - x } else { x });
}

/// A float with no fraction as an int when it fits (else the float: inf, nan, huge).
fn intIfFits(x: f64): Value {
    if x > -9223372036854775808.0 && x < 9223372036854775808.0 { return intv(int(x)); }
    return floatv(x);
}

/// `floor(x)` / `ceil(x)`: an int (ints pass through).
fn mathFloor(_vm: &Vm, args: Args): Value {
    let v = args.get(0);
    if v.tag == T_INT { return v; }
    return intIfFits(libm.floor(args.num(0)));
}

fn mathCeil(_vm: &Vm, args: Args): Value {
    let v = args.get(0);
    if v.tag == T_INT { return v; }
    return intIfFits(libm.ceil(args.num(0)));
}

/// The argument `min` (`max`: the largest) as it was given, int or float.
fn pickExtreme(vm: &Vm, args: Args, max: bool): Value {
    if args.count() == 0 { args.num(0); }
    let best = args.get(0);
    for i in 0..args.count() {
        let x = args.num(i);
        if vm.raised { return nilv(); }
        let b = best.asNum();
        if (max && x > b) || (!max && x < b) { best = args.get(i); }
    }
    return best;
}

/// `min(a, b, ...)` / `max(a, b, ...)`.
fn mathMin(vm: &Vm, args: Args): Value { return pickExtreme(vm, args, false); }
fn mathMax(vm: &Vm, args: Args): Value { return pickExtreme(vm, args, true); }

/// `clamp(v, lo, hi)`: `v` held between `lo` and `hi` (the one returned keeps its type).
fn mathClamp(vm: &Vm, args: Args): Value {
    let x = args.num(0);
    let lo = args.num(1);
    let hi = args.num(2);
    if vm.raised { return nilv(); }
    if x < lo { return args.get(1); }
    if x > hi { return args.get(2); }
    return args.get(0);
}

/// `lerp(a, b, t)`: `a + (b - a) * t`, a float.
fn mathLerp(_vm: &Vm, args: Args): Value {
    let a = args.num(0);
    return floatv(a + (args.num(1) - a) * args.num(2));
}
