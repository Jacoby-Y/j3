// Arrays: 0-indexed and growable, their own type apart from tables. Reading out of range gives
// nil, writing at `len` appends, writing past it is an error (`set` returns false). Part of `j3.j2`.

module j3.j2;

pub struct Arr {
    h: GcHeader;
    /// `cap` values, the first `len` in use.
    items: ptr;
    len: int;
    cap: int;
}

/// The `Arr` of a `T_ARRAY` value.
pub fn arrOf(v: Value): &Arr { return v.obj() as &Arr; }

extend Heap {
    /// A new empty array with room for `n` values.
    fn newArray(this: &Heap, n: int): Value {
        let p = this.newObject(OBJ_ARRAY, @sizeof(Arr));
        if n > 0 { (p as &Arr).reserve(this, n); }
        return objv(T_ARRAY, p);
    }
}

extend Arr {
    /// The values in use (a view; invalid after the array grows).
    fn values(this: &Arr): []Value { return @slice(this.items, this.len); }

    /// `a[i]`, nil when out of range.
    fn get(this: &Arr, i: int): Value {
        if i < 0 || i >= this.len { return nilv(); }
        return this.values()[i];
    }

    /// `a[i] = v`: replaces, or appends when `i == len`. False when `i` is negative or past `len`.
    fn set(this: &Arr, h: &Heap, i: int, v: Value): bool {
        if i == this.len {
            this.push(h, v);
            return true;
        }
        if i < 0 || i > this.len { return false; }
        this.values()[i] = v;
        return true;
    }

    fn push(this: &Arr, h: &Heap, v: Value) {
        if this.len == this.cap {
            this.reserve(h, if this.cap == 0 { 4 } else { this.cap * 2 });
        }
        this.len += 1;
        this.values()[this.len - 1] = v;
    }

    /// Remove and return the last value, nil when empty.
    fn pop(this: &Arr): Value {
        if this.len == 0 { return nilv(); }
        this.len -= 1;
        let all: []Value = @slice(this.items, this.cap);
        let v = all[this.len];
        all[this.len] = nilv();
        return v;
    }

    /// Insert `v` before index `i` (0..len). False when `i` is out of that range.
    fn insert(this: &Arr, h: &Heap, i: int, v: Value): bool {
        if i < 0 || i > this.len { return false; }
        this.push(h, v);
        let xs = this.values();
        let j = this.len - 1;
        while j > i {
            xs[j] = xs[j - 1];
            j -= 1;
        }
        xs[i] = v;
        return true;
    }

    /// Remove and return `a[i]`, keeping order; nil when out of range.
    fn remove(this: &Arr, i: int): Value {
        if i < 0 || i >= this.len { return nilv(); }
        let xs = this.values();
        let v = xs[i];
        for j in i..this.len - 1 { xs[j] = xs[j + 1]; }
        this.pop();
        return v;
    }

    /// Make room for at least `n` values.
    fn reserve(this: &Arr, h: &Heap, n: int) {
        if n <= this.cap { return; }
        let p = h.allocRaw(n * @sizeof(Value));
        let next: []Value = @slice(p, n);
        let old = this.values();
        for i in 0..this.len { next[i] = old[i]; }
        if this.cap > 0 { h.freeRaw(this.items, this.cap * @sizeof(Value)); }
        this.items = p;
        this.cap = n;
    }

    /// Give back the item buffer (the sweep calls this before `freeObject`).
    fn freeParts(this: &Arr, h: &Heap) {
        if this.cap > 0 { h.freeRaw(this.items, this.cap * @sizeof(Value)); }
        this.cap = 0;
        this.len = 0;
    }
}
