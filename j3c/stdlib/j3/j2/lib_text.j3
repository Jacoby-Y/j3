// LIB_STRING: `upper lower trim split contains slice`. Strings are bytes; case changes and
// trimming are ASCII only, so UTF-8 text passes through unchanged. Part of `j3.j2`.

module j3.j2;

extend Vm {
    fn openTextLib(this: &Vm) {
        this.bindLib("upper", libUpper);
        this.bindLib("lower", libLower);
        this.bindLib("trim", libTrim);
        this.bindLib("split", libSplit);
        this.bindLib("contains", libContains);
        this.bindLib("slice", libSlice);
    }
}

fn isSpace(c: u8): bool { return c == 32 || (c >= 9 && c <= 13); }

/// `s` without ASCII whitespace at either end (a view).
fn trimSpace(s: string): string {
    let a = 0;
    let b = s.len;
    while a < b && isSpace(s[a]) { a += 1; }
    while b > a && isSpace(s[b - 1]) { b -= 1; }
    return s[a..b];
}

/// `s` with ASCII letters in [lo, lo+26) shifted by `by`.
fn shiftCase(vm: &Vm, s: string, lo: u8, by: int): Value {
    let b = &vm.sb;
    b.clear();
    for i in 0..s.len {
        let c = s[i];
        if c >= lo && c < lo + 26 { b.push(u8(int(c) + by)); } else { b.push(c); }
    }
    return vm.bufOut(b);
}

/// `upper(s)`.
fn libUpper(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    if vm.raised { return nilv(); }
    return shiftCase(vm, s, 97, -32);
}

/// `lower(s)`.
fn libLower(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    if vm.raised { return nilv(); }
    return shiftCase(vm, s, 65, 32);
}

/// `trim(s)`: without spaces, tabs and newlines at the ends.
fn libTrim(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    if vm.raised { return nilv(); }
    return vm.strOut(trimSpace(s));
}

/// The first index of `part` in `s` at or after `from`, or -1; -2 with the native failed when
/// the bytes compared ran out the step budget (the naive scan is O(len(s) * len(part))).
// ponytail: naive scan, charged per byte compared; a two-way / Boyer-Moore search if scripts
// search big texts for long patterns.
fn indexOf(vm: &Vm, s: string, part: string, from: int): int {
    let i = from;
    let work = 0;
    while i + part.len <= s.len {
        let j = 0;
        while j < part.len && s[i + j] == part[j] { j += 1; }
        if j == part.len { return if vm.chargeNative(work) { i } else { -2 }; }
        work += j + 1;
        if work >= 1 << 16 {
            if !vm.chargeNative(work) { return -2; }
            work = 0;
        }
        i += 1;
    }
    return if vm.chargeNative(work) { -1 } else { -2 };
}

/// `split(s, sep)`: the pieces between each `sep` (`"a,,b"` gives `["a", "", "b"]`).
fn libSplit(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    let sep = args.str(1);
    if vm.raised { return nilv(); }
    if sep.len == 0 { return vm.raise("split: the separator can't be empty"); }
    // `strOut` may collect: the array must stay alive
    let out = vm.protect(vm.heap.newArray(0));
    let from = 0;
    while true {
        let at = indexOf(vm, s, sep, from);
        if at == -2 { return nilv(); }
        if at < 0 { break; }
        let piece = vm.strOut(s[from..at]);
        if vm.raised { return nilv(); }
        arrOf(out).push(vm.heap, piece);
        from = at + sep.len;
    }
    let last = vm.strOut(s[from..s.len]);
    if vm.raised { return nilv(); }
    arrOf(out).push(vm.heap, last);
    return out;
}

/// `contains(s, part)`.
fn libContains(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    let part = args.str(1);
    if vm.raised { return nilv(); }
    let at = indexOf(vm, s, part, 0);
    if at == -2 { return nilv(); }
    return boolv(at >= 0);
}

/// `slice(s, from, to)`: bytes `from` up to (not including) `to` (default: the end). Both are
/// clamped to the string, so out-of-range bounds give a shorter (or empty) string.
fn libSlice(vm: &Vm, args: Args): Value {
    let s = args.str(0);
    let a = args.int(1);
    let b = args.intOr(2, s.len);
    if vm.raised { return nilv(); }
    if a < 0 { a = 0; }
    if b > s.len { b = s.len; }
    if b < a { b = a; }
    if a > s.len { return vm.strOut(""); }
    return vm.strOut(s[a..b]);
}
