/// The j2 parser: tokens to an AST by recursive descent. Errors are values with the text
/// `file:line:col: expected X, found Y`; nothing here panics on any input, and nesting deeper
/// than `MAX_DEPTH` is an error rather than a native stack overflow.
///
/// The AST is flat: `Ast.nodes` holds every `Node`, children are node numbers (`a`, `b`, `c`,
/// -1 for none) or a run of `Ast.kids` (`first`, `count`; read with `ast.kid(n, i)`). Every node
/// has the `line:col` of its token: the first one of a statement or literal, the operator of a
/// unary or binary expression, the `.` of a field, the `[` of an index, the `(` of a call.
/// `print` writes an AST back as source that parses to the same tree.
///
/// Shapes by `Kind` (fields not named are unused):
///   Chunk kids: top-level statements
///   Block kids: statements
///   Let   s: name, a: value or -1, flags: F_PUB, F_CONST (a const always has a value)
///   FnDecl / Fn  s: name ("" for a literal), kids: Name params, b: Block body,
///           flags: F_PUB (decl), F_THIS (first param is `this`)
///   Use   s: script name
///   Assign op: Tok.Assign or Tok.PlusEq.., a: target (Name, Field or Index), b: value
///   Expr  a: expression
///   If    a: condition, b: Block, c: else (Block, If) or -1
///   While a: condition, b: Block
///   ForRange  s: variable, a: from, b: to (exclusive), c: Block
///   ForIn     kids: one Name (value) or two (key or index, value), a: iterable, c: Block
///   Break, Continue
///   Return a: value or -1
///   Match a: subject, kids: Arm (at least one)
///   Arm   a: pattern (Int, Float, Str, True, False, Nil) or -1 for `_`, b: Block
///   Nil True False; Int i; Float f; Str s (escapes applied); Name s
///   Tpl   kids: Str text, expr, Str text, ..., Str text (odd kids are the holes)
///   Unary op: Tok.Minus or Tok.Not, a
///   Binary op: Tok.Plus .. Tok.Or (And, Or short-circuit), a, b
///   Field a: object, s: name
///   Index a: object, b: index
///   Call  a: callee (a Field callee is a method call: `this` and the dot fallback), kids: args
///   Table kids: Pair (s: key, a: value, flags: F_QUOTED when the key was written as a string)
///   Array kids: elements

module j3.j2.parse;

use j3.j2.lex;
use j3.j2.lex.{ Token, SyntaxError, Tok };
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.text.Text;

/// What a node is; the shapes above say which fields each kind uses.
pub enum Kind {
    Chunk, Block, Let, FnDecl, Use, Assign, Expr, If, While, ForRange, ForIn, Break, Continue, Return, Match,
    Arm, Nil, True, False, Int, Float, Str, Name, Tpl, Unary, Binary, Field, Index, Call, Table, Pair, Array, Fn,
}

pub const F_PUB: int = 1;
pub const F_CONST: int = 2;
pub const F_THIS: int = 4;
pub const F_QUOTED: int = 8;

/// Statements and expressions nested deeper than this are an error.
pub const MAX_DEPTH: int = 200;

pub struct Node {
    kind: Kind;
    /// The operator of an `Assign`, `Unary` or `Binary`.
    op: Tok;
    line: int;
    col: int;
    a: int;
    b: int;
    c: int;
    first: int;
    count: int;
    flags: int;
    i: int;
    f: f64;
    s: string;
}

pub struct Ast {
    file: string;
    nodes: List<Node>;
    kids: List<int>;
    /// The Chunk.
    root: int;

    fn node(this: &Ast, n: int): &Node { return &this.nodes.items[n]; }

    /// Child `i` of node `n`'s kid list.
    fn kid(this: &Ast, n: int, i: int): int { return this.kids.items[this.nodes.items[n].first + i]; }
}

struct Parser {
    file: string;
    src: string;
    mem: &Arena;
    toks: []Token;
    at: int;
    ast: Ast;
    /// Kid lists under construction, popped into `ast.kids` when done.
    stack: List<int>;
    depth: int;
    failed: bool;
    err: SyntaxError;
}

/// Parse `src` (named `file` in errors) into an AST on `mem`.
pub fn parse(file: string, src: string, mem: &Arena): Result<Ast, SyntaxError> {
    let toks = lex.lex(file, src, mem)?;
    let p = Parser {
        file: file,
        src: src,
        mem: mem,
        toks: toks,
        at: 0,
        ast: Ast { file: file, nodes: List<Node>.new(mem), kids: List<int>.new(mem), root: -1 },
        stack: List<int>.new(mem),
        depth: 0,
        failed: false,
        err: SyntaxError { file: file, line: 0, col: 0, msg: "", text: "" },
    };
    let root = p.node(Kind.Chunk, p.tok());
    let mark = p.stack.len;
    while !p.failed && p.tok().kind != Tok.Eof {
        p.stack.push(p.statement(true));
    }
    p.closeKids(root, mark);
    if p.failed {
        return Result.Err(p.err);
    }
    p.ast.root = root;
    return Result.Ok(p.ast);
}

extend Parser {
    fn tok(this: &Parser): Token { return this.toks[this.at]; }

    fn peekKind(this: &Parser, k: int): Tok {
        let i = this.at + k;
        if i >= this.toks.len { i = this.toks.len - 1; }
        return this.toks[i].kind;
    }

    /// Step past the current token (never past EOF).
    fn bump(this: &Parser): Token {
        let t = this.toks[this.at];
        if t.kind != Tok.Eof { this.at += 1; }
        return t;
    }

    fn accept(this: &Parser, kind: Tok): bool {
        if this.tok().kind == kind {
            this.bump();
            return true;
        }
        return false;
    }

    /// Stop with `msg` at `tok`. Only the first error counts.
    fn failAt(this: &Parser, tok: Token, msg: string) {
        if this.failed { return; }
        this.failed = true;
        this.err = lex.syntaxError(this.mem, this.file, tok.line, tok.col, msg);
    }

    /// `expected <what>, found <current token>`.
    fn expected(this: &Parser, what: string) {
        let t = Text.new(this.mem);
        t.pushStr("expected ");
        t.pushStr(what);
        t.pushStr(", found ");
        lex.describe(&t, this.src, this.tok());
        this.failAt(this.tok(), t.str());
    }

    /// Step past a `kind` token (written `what` in the error) or fail.
    fn expect(this: &Parser, kind: Tok, what: string): Token {
        let t = this.tok();
        if t.kind != kind {
            this.expected(what);
            return t;
        }
        return this.bump();
    }

    fn node(this: &Parser, kind: Kind, at: Token): int {
        this.ast.nodes.push(Node { kind: kind, op: Tok.Eof, line: at.line, col: at.col, a: -1, b: -1, c: -1,
            first: 0, count: 0, flags: 0, i: 0, f: 0.0, s: "" });
        return this.ast.nodes.len - 1;
    }

    /// A `kind` node at `at` whose `a` is `a`.
    fn node1(this: &Parser, kind: Kind, at: Token, a: int): int {
        let n = this.node(kind, at);
        this.n(n).a = a;
        return n;
    }

    fn n(this: &Parser, i: int): &Node { return &this.ast.nodes.items[i]; }

    /// Move `stack[mark..]` into node `n`'s kid list.
    fn closeKids(this: &Parser, n: int, mark: int) {
        let first = this.ast.kids.len;
        for i in mark..this.stack.len { this.ast.kids.push(this.stack.items[i]); }
        let nd = this.n(n);
        nd.first = first;
        nd.count = this.stack.len - mark;
        this.stack.len = mark;
    }

    /// Count one level of nesting; false (and an error) past `MAX_DEPTH`.
    fn enter(this: &Parser): bool {
        this.depth += 1;
        if this.depth > MAX_DEPTH {
            this.failAt(this.tok(), "too deeply nested");
            return false;
        }
        return true;
    }

    fn name(this: &Parser, what: string): string {
        let t = this.expect(Tok.Name, what);
        if this.failed { return ""; }
        return this.src[t.s..t.e];
    }
}
