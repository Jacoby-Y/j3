// Values: a tag and 64 bits. Ints are the bits, floats their IEEE pattern, bools 0/1, and heap
// values (strings, arrays, tables, functions) the object's address. Part of `j3.j2`.

module j3.j2;

pub const T_NIL: int = 0;
pub const T_BOOL: int = 1;
pub const T_INT: int = 2;
pub const T_FLOAT: int = 3;
pub const T_STR: int = 4;
pub const T_ARRAY: int = 5;
pub const T_TABLE: int = 6;
/// A script function (closure). Its object kind is added by the compiler chunk.
pub const T_FN: int = 7;
/// A host function bound with `vm.bind`; `bits` is its index in the VM's native table.
pub const T_NATIVE: int = 8;
/// Internal: a deleted table entry. Never seen by scripts.
const T_DEAD: int = 15;

/// A j2 value, 16 bytes. Compare with `equals` (script `==`) or `same` (identity, table keys).
pub struct Value {
    tag: int;
    bits: int;

    fn isNil(this: Value): bool { return this.tag == T_NIL; }

    /// Only `nil` and `false` are false.
    fn truthy(this: Value): bool {
        return !(this.tag == T_NIL || (this.tag == T_BOOL && this.bits == 0));
    }

    fn isNum(this: Value): bool { return this.tag == T_INT || this.tag == T_FLOAT; }

    /// The number as a float (ints convert); 0 for anything else.
    fn asNum(this: Value): f64 {
        if this.tag == T_INT { return f64(this.bits); }
        if this.tag == T_FLOAT { return floatOf(this.bits); }
        return 0.0;
    }

    /// The float of a `T_FLOAT` value.
    fn f(this: Value): f64 { return floatOf(this.bits); }

    /// The address of a heap value.
    fn obj(this: Value): ptr { return this.bits as ptr; }
}

pub fn nilv(): Value { return Value { tag: T_NIL, bits: 0 }; }
pub fn boolv(b: bool): Value { return Value { tag: T_BOOL, bits: if b { 1 } else { 0 } }; }
pub fn intv(n: int): Value { return Value { tag: T_INT, bits: n }; }
pub fn floatv(x: f64): Value { return Value { tag: T_FLOAT, bits: bitsOf(x) }; }
/// A heap value of `tag` at address `p`.
pub fn objv(tag: int, p: ptr): Value { return Value { tag: tag, bits: p as int }; }

/// The IEEE bit pattern of `x`.
pub fn bitsOf(x: f64): int {
    let v = x;
    let b: []int = @slice(&v as ptr, 1);
    return b[0];
}

/// The float with bit pattern `b`.
pub fn floatOf(b: int): f64 {
    let v = b;
    let f: []f64 = @slice(&v as ptr, 1);
    return f[0];
}

/// Script `==`: numbers compare by value across int and float (`2 == 2.0`), everything else by
/// tag and bits (strings are interned, so that is content equality; tables and arrays are identity).
pub fn equals(a: Value, b: Value): bool {
    if a.tag == b.tag {
        if a.tag == T_FLOAT { return a.f() == b.f(); }
        return a.bits == b.bits;
    }
    if a.isNum() && b.isNum() {
        return a.asNum() == b.asNum();
    }
    return false;
}

/// Identity: same tag and bits. Table keys compare this way after `keyOf`.
pub fn same(a: Value, b: Value): bool {
    return a.tag == b.tag && a.bits == b.bits;
}

/// A float that holds an exact int in i64 range, as that int.
fn exactInt(x: f64): bool {
    return x >= -9223372036854775808.0 && x < 9223372036854775808.0 && x == f64(int(x));
}

/// The key `v` is stored under. Floats holding an exact integer become that int (`t[2.0]` is
/// `t[2]`, and `-0.0` is `0`), as in Lua 5.4, so a key never depends on how the number was made.
/// `nil` and NaN can't be keys: the result is `nil`, which `Table.set` rejects and `get` misses.
pub fn keyOf(v: Value): Value {
    if v.tag == T_FLOAT {
        let x = v.f();
        if !(x == x) { return nilv(); }
        if exactInt(x) { return intv(int(x)); }
    }
    return v;
}

/// The name `type(x)` gives.
pub fn typeName(v: Value): string {
    match v.tag {
        T_NIL { return "nil"; }
        T_BOOL { return "bool"; }
        T_INT { return "int"; }
        T_FLOAT { return "float"; }
        T_STR { return "string"; }
        T_ARRAY { return "array"; }
        T_TABLE { return "table"; }
        _ { return "fn"; }
    }
}
