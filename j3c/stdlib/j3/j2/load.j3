// Loading scripts: `loadString` / `loadFile` compile a chunk and run its top level, and give
// back its exports table (the `pub` names). `use name;` asks `vm.resolver` for another chunk's
// exports while compiling; a chunk that `use`s one still loading is a cycle. Part of `j3.j2`.
//
// Every load is a fresh module (new env, new exports table): reloading a script never reuses
// the old one. Reusing the exports of a script loaded earlier is the resolver's choice (keep the
// table and hand it back).

module j3.j2;

extend Vm {
    /// Compile `text` as chunk `name` and run its top level. Ok holds its exports table.
    fn loadString(this: &Vm, name: string, text: string): Result<Value, Error> {
        return this.load(name, name, text);
    }

    /// `loadString` of the file at `path` (errors name the path). The only place j2 reads files.
    fn loadFile(this: &Vm, name: string, path: string): Result<Value, Error> {
        let mem = Arena.create(64 << 10);
        let r: Result<Value, Error> = Result.Err(this.err);
        match io.readFile(path, &mem) {
            Result.Ok(b) { r = this.load(name, path, b as string); }
            Result.Err(_) {
                let t = this.errText();
                t.pushStr("can't read ");
                t.pushStr(path);
                this.located = true;
                this.err.chunk = textOf(fix(this.heap.intern(name)));
                this.err.line = 0;
                this.err.col = 0;
                this.traceBuf.clear();
                r = Result.Err(this.error());
            }
        }
        mem.destroy();
        return r;
    }

    fn load(this: &Vm, name: string, file: string, text: string): Result<Value, Error> {
        if this.callDepth == 0 { this.raised = false; }
        if this.nloading == this.loading.len {
            this.fail("too many nested `use`s");
            return Result.Err(this.error());
        }
        this.loading[this.nloading] = fix(this.heap.intern(name));
        this.nloading += 1;
        let r = this.compileAndRun(name, file, text);
        this.nloading -= 1;
        return r;
    }

    fn compileAndRun(this: &Vm, name: string, file: string, text: string): Result<Value, Error> {
        let f = compileModule(this, name, file, text)?;
        this.call(f, @slice(0 as ptr, 0))?;
        return Result.Ok(arrOf(closureOf(f).env).values()[0]);
    }

    /// The exports table `use name;` binds, from `resolver`. False with the error text pending
    /// (`use cycle: a -> b -> a` when `name` is still loading).
    fn useModule(this: &Vm, name: string, out: &Value): bool {
        for i in 0..this.nloading {
            if textOf(this.loading[i]) == name {
                let t = this.errText();
                t.pushStr("use cycle: ");
                for j in i..this.nloading {
                    t.pushStr(textOf(this.loading[j]));
                    t.pushStr(" -> ");
                }
                t.pushStr(name);
                return false;
            }
        }
        let outer = this.raised;
        this.raised = false;
        let resolve = this.resolver;
        let v = resolve(this.resolverCtx, this, name);
        let failed = this.raised;
        this.raised = outer;
        if failed { return false; }
        if v.tag != T_TABLE {
            let t = this.errText();
            t.pushStr("use ");
            t.pushStr(name);
            t.pushStr(": the resolver gave ");
            t.pushStr(typeName(v));
            t.pushStr(", not a script's exports");
            return false;
        }
        *out = v;
        return true;
    }
}
