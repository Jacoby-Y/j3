// Strings: immutable and all interned, so two equal strings are the same object and `==` or a
// table lookup is a pointer compare. The bytes sit right after the `Str` header. Part of `j3.j2`.
// ponytail: every concatenation result pays a hash and an intern probe; add an unintern path for
// strings over 40 bytes if profiling says so.

module j3.j2;

pub struct Str {
    h: GcHeader;
    hash: int;
    len: int;
}

/// The bytes of `s` (a view into the heap; valid while the string is alive).
pub fn strBytes(s: &Str): string {
    let b: []u8 = @slice((s as ptr as int + @sizeof(Str)) as ptr, s.len);
    return b as string;
}

/// The `Str` of a `T_STR` value.
pub fn strOf(v: Value): &Str { return v.obj() as &Str; }

/// The text of a `T_STR` value, "" for anything else.
pub fn textOf(v: Value): string {
    if v.tag != T_STR { return ""; }
    return strBytes(strOf(v));
}

fn hashText(s: string): int { return int(cmp.hashOf(s)); }

fn sameBytes(o: &Str, s: string): bool {
    if o.len != s.len { return false; }
    let b = strBytes(o);
    for i in 0..s.len {
        if b[i] != s[i] { return false; }
    }
    return true;
}

extend Heap {
    /// The interned string with these bytes, made if new.
    fn intern(this: &Heap, s: string): Value {
        let hash = hashText(s);
        let at = this.findStr(s, hash);
        if at >= 0 { return objv(T_STR, this.strs[at] as ptr); }
        if (this.strCount + 1) * 4 > this.strs.len * 3 {
            this.growStrs();
        }
        let p = this.newObject(OBJ_STR, @sizeof(Str) + s.len);
        let o = p as &Str;
        o.hash = hash;
        o.len = s.len;
        let b: []u8 = @slice((p as int + @sizeof(Str)) as ptr, s.len);
        for i in 0..s.len { b[i] = s[i]; }
        let mask = this.strs.len - 1;
        let i = hash & mask;
        while this.strs[i] != 0 { i = (i + 1) & mask; }
        this.strs[i] = p as int;
        this.strCount += 1;
        return objv(T_STR, p);
    }

    /// The interned string with these bytes, or nil when no such string exists (then no table
    /// can have it as a key, so a host lookup by name can stop there without allocating).
    fn lookupStr(this: &Heap, s: string): Value {
        let at = this.findStr(s, hashText(s));
        if at < 0 { return nilv(); }
        return objv(T_STR, this.strs[at] as ptr);
    }

    /// The slot of `s` in `strs`, or -1.
    fn findStr(this: &Heap, s: string, hash: int): int {
        if this.strs.len == 0 { return -1; }
        let mask = this.strs.len - 1;
        let i = hash & mask;
        while this.strs[i] != 0 {
            let o = this.strs[i] as ptr as &Str;
            if o.hash == hash && sameBytes(o, s) { return i; }
            i = (i + 1) & mask;
        }
        return -1;
    }

    fn growStrs(this: &Heap) {
        let old = this.strs;
        let n = if old.len == 0 { 64 } else { old.len * 2 };
        let next: []int = @slice(this.allocRaw(n * 8), n);
        let mask = n - 1;
        for j in 0..old.len {
            if old[j] != 0 {
                let i = (old[j] as ptr as &Str).hash & mask;
                while next[i] != 0 { i = (i + 1) & mask; }
                next[i] = old[j];
            }
        }
        if old.len > 0 { this.freeRaw(old.ptr as ptr, old.len * 8); }
        this.strs = next;
    }
}
