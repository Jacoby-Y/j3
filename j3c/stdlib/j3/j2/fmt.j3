// `str()` text of a value, written into a `Text`: ints in decimal, floats as the shortest digits
// that read back (always with a `.` or an exponent, so `3.0` stays a float), strings as they
// are at the top and quoted inside containers, arrays `[1, 2]`, tables `{x: 1, "a b": 2}` in
// insertion order. Containers nest two levels below the top; deeper ones print `[...]` and
// `{...}`, which also cuts cycles. Part of `j3.j2`.

module j3.j2;

/// Levels of containers shown under the top one.
const FMT_DEPTH: int = 2;

/// Append the `str()` text of `v` to `t`.
pub fn fmtValue(t: &Text, v: Value) {
    let left = 1 << 62;
    fmtAt(t, v, 0, &left);
}

/// `fmtValue` into a heap `Buf` (what the VM uses while a script runs). Shared containers can
/// make the text far bigger than the heap (`[b, b, ..]` of `[a, a, ..]`): past `heap.limit / 2`
/// values (each adds at least 2 bytes) it stops and marks `b` full, instead of walking them all.
pub fn fmtBuf(b: &Buf, v: Value) {
    let left = b.heap.limit / 2;
    fmtAt(b, v, 0, &left);
    if left < 0 { b.full = true; }
}

// Generic over the sink. A generic fn called from another module can't reach this module's other
// generic fns (they resolve in the caller), so only the two wrappers above are public.
fn fmtAt<W>(t: &W, v: Value, depth: int, left: &int) {
    *left -= 1;
    if *left < 0 { return; }
    match v.tag {
        T_NIL { t.pushStr("nil"); }
        T_BOOL { t.pushStr(if v.bits != 0 { "true" } else { "false" }); }
        T_INT { t.pushInt(v.bits); }
        T_FLOAT { lex.fmtFloat(t, v.f()); }
        T_STR {
            if depth == 0 { t.pushStr(textOf(v)); } else { lex.quote(t, textOf(v)); }
        }
        T_ARRAY {
            if depth > FMT_DEPTH {
                t.pushStr("[...]");
                return;
            }
            let xs = arrOf(v).values();
            t.push(91);
            for i in 0..xs.len {
                if i > 0 { t.pushStr(", "); }
                fmtAt(t, xs[i], depth + 1, left);
            }
            t.push(93);
        }
        T_TABLE {
            if depth > FMT_DEPTH {
                t.pushStr("{...}");
                return;
            }
            let tb = tableOf(v);
            let es = tb.entries();
            t.push(123);
            let i = tb.next(0);
            let first = true;
            while i >= 0 {
                if !first { t.pushStr(", "); }
                first = false;
                let k = es[i].key;
                if k.tag == T_STR && isIdent(textOf(k)) {
                    t.pushStr(textOf(k));
                } else {
                    fmtAt(t, k, depth + 1, left);
                }
                t.pushStr(": ");
                fmtAt(t, es[i].val, depth + 1, left);
                i = tb.next(i + 1);
            }
            t.push(125);
        }
        T_NATIVE { t.pushStr("native fn"); }
        _ { t.pushStr("fn"); }
    }
}

/// Letters, digits and `_`, not starting with a digit.
fn isIdent(s: string): bool {
    if s.len == 0 { return false; }
    for i in 0..s.len {
        let c = s[i];
        let letter = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
        if !letter && !(i > 0 && c >= 48 && c <= 57) { return false; }
    }
    return true;
}
