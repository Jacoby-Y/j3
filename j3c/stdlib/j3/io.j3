module j3.io;

use j3.memory.Arena;
use j3.result.Result;
use j3.sys.{ close, lseek, open, openMode, read, write, O_CREAT, O_RDONLY, O_TRUNC, O_WRONLY, SEEK_END, SEEK_SET };
use j3.text.cstr;

/// Why a file call failed.
pub enum IoError {
    /// The path could not be opened for reading.
    NotFound,
    /// Open, seek, or a short read/write.
    Other,
}

/// Write `s` and a newline to stdout.
pub fn printLn(s: string) {
    write(1, s.ptr as ptr, s.len);
    write(1, "\n".ptr as ptr, 1);
}

/// Read the whole file into `arena`. `NotFound` if it cannot be opened.
pub fn readFile(path: string, arena: &Arena): Result<[]u8, IoError> {
    let fd = open(cstr(path) as ptr, O_RDONLY);
    if fd < 0 {
        return Result.Err(IoError.NotFound);
    }
    let n = lseek(fd, 0, SEEK_END);
    if n < 0 {
        close(fd);
        return Result.Err(IoError.Other);
    }
    if lseek(fd, 0, SEEK_SET) < 0 {
        close(fd);
        return Result.Err(IoError.Other);
    }
    let buf = arena.alloc::<u8>(n);
    let got = read(fd, buf.ptr as ptr, buf.len);
    close(fd);
    if got != n {
        return Result.Err(IoError.Other);
    }
    return Result.Ok(buf);
}

/// True when `path` can be opened for reading.
pub fn exists(path: string): bool {
    let fd = open(cstr(path) as ptr, O_RDONLY);
    if fd < 0 {
        return false;
    }
    close(fd);
    return true;
}

/// Create or truncate `path` and write `data`. Returns the byte count.
pub fn writeFile(path: string, data: []u8): Result<int, IoError> {
    let fd = openMode(cstr(path) as ptr, O_WRONLY + O_CREAT + O_TRUNC, 420);
    if fd < 0 {
        return Result.Err(IoError.Other);
    }
    let got = write(fd, data.ptr as ptr, data.len);
    close(fd);
    if got != data.len {
        return Result.Err(IoError.Other);
    }
    return Result.Ok(got);
}
