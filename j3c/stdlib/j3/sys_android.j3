/// Android (bionic) j3.sys. Same pub names as sys.j3. libc, not syscall numbers, so one file serves
/// arm64 and x86_64. No flag that differs by arch is used (`O_DIRECTORY`, `O_NOFOLLOW` are not here).
/// `start`/`setArgs` keep the contract of sys.j3: the host entry (`SDL_main(argc, argv)`) calls them.

module j3.sys;

use j3.apkassets.{ boot, Source };

use lib "c" as c {
    fn open(path: ptr, flags: int, mode: int): int;
    fn read(fd: int, buf: ptr, n: int): int;
    // fd is i32 to match the emitter's own `declare i64 @write(i32, ptr, i64)`.
    fn write(fd: i32, buf: ptr, n: int): int;
    fn close(fd: int): int;
    fn lseek(fd: int, off: int, whence: int): int;
    fn mmap(addr: ptr, len: int, prot: int, flags: int, fd: int, offset: int): ptr;
    fn munmap(addr: ptr, len: int): int;
    fn exit(code: i32);
    fn __errno(): ptr;
    fn dlopen(name: cstr, flags: i32): ptr;
    fn dlsym(handle: ptr, name: cstr): ptr;
    fn signal(sig: i32, handler: int): int;
    // processes (`j3.proc`); C int/pid_t returns are i32 so -1 reads as -1
    fn fork(): i32;
    fn execve(path: ptr, argv: ptr, envp: ptr): i32;
    fn pipe2(fds: ptr, flags: i32): i32;
    fn dup2(from: i32, to: i32): i32;
    fn chdir(path: ptr): i32;
    fn access(path: ptr, mode: i32): i32;
    fn rename(from: ptr, to: ptr): i32;
    fn unlink(path: ptr): i32;
    fn mkdir(path: ptr, mode: u32): i32;
    fn waitpid(pid: i32, status: ptr, flags: i32): i32;
    fn kill(pid: i32, sig: i32): i32;
    fn getpid(): i32;
    fn poll(fds: ptr, n: int, ms: i32): i32;
}

use lib "SDL2" as sdl {
    fn SDL_AndroidGetInternalStoragePath(): ptr;
    fn SDL_RWFromFile(file: ptr, mode: ptr): ptr;
    fn SDL_RWread(ctx: ptr, buf: ptr, size: int, maxnum: int): int;
    fn SDL_RWclose(ctx: ptr): i32;
    fn SDL_RWsize(ctx: ptr): int;
    fn SDL_Log(fmt: ptr, msg: ptr);
    fn SDL_GetTicks(): u32;
}

/// Which OS layer this is, fixed at compile time by `[emit] target`: compare it with the
/// `PLATFORM_*` names (`if sys.PLATFORM == sys.PLATFORM_ANDROID { ... }`); the other branch is dropped.
pub const PLATFORM: int = 3;
/// `PLATFORM` on Linux (desktop).
pub const PLATFORM_LINUX: int = 0;
/// `PLATFORM` on Windows.
pub const PLATFORM_WINDOWS: int = 1;
/// `PLATFORM` on macOS.
pub const PLATFORM_MACOS: int = 2;
/// `PLATFORM` on Android.
pub const PLATFORM_ANDROID: int = 3;
/// `PLATFORM` as a word for logs and paths: "linux", "windows", "macos", "android".
pub const PLATFORM_NAME: string = "android";
/// `ARCH_*` names of the CPU the program is built for (`if sys.ARCH == sys.ARCH_AARCH64 { ... }`); the other branch is dropped.
/// The compiler sets it from the target triple (the host when there is no target); the value written here is a placeholder.
pub const ARCH: int = 0;
/// `ARCH` on x86-64.
pub const ARCH_X86_64: int = 0;
/// `ARCH` on 64-bit ARM (arm64).
pub const ARCH_AARCH64: int = 1;
/// `ARCH` on 32-bit x86.
pub const ARCH_X86: int = 2;
/// `ARCH` on 32-bit ARM.
pub const ARCH_ARM: int = 3;
/// `ARCH` on RISC-V.
pub const ARCH_RISCV: int = 4;
/// `ARCH` on any other CPU.
pub const ARCH_OTHER: int = 5;
/// `ARCH` as a word for logs: "x86_64", "aarch64", "x86", "arm", "riscv", "other".
pub const ARCH_NAME: string = "x86_64";
/// Open for reading only.
pub const O_RDONLY: int = 0;
/// Open for writing only.
pub const O_WRONLY: int = 1;
/// Create the file if it does not exist (bionic, same on arm64 and x86_64).
pub const O_CREAT: int = 64;
/// Truncate to empty when opening (bionic, same on arm64 and x86_64).
pub const O_TRUNC: int = 512;
/// Seek from the start of the file.
pub const SEEK_SET: int = 0;
/// Seek from the end of the file.
pub const SEEK_END: int = 2;
/// `pipe` flag: close both ends in a child at `execve`.
pub const O_CLOEXEC: int = 524288;
/// `waitpid` flag: return 0 at once when the child is still running.
pub const WNOHANG: int = 1;
/// `kill` signal: ask to stop.
pub const SIGTERM: int = 15;
/// `kill` signal: stop now.
pub const SIGKILL: int = 9;
/// `open` flag: read and write.
pub const O_RDWR: int = 2;
/// `open` flag: a terminal device opened does not become the controlling terminal.
pub const O_NOCTTY: int = 256;
/// `kill` signal: the controlling terminal went away.
pub const SIGHUP: int = 1;
/// `pollFds` events: readable, writable; results add hang-up and error.
pub const POLLIN: int = 1;
pub const POLLOUT: int = 4;
pub const POLLERR: int = 8;
pub const POLLHUP: int = 16;


/// `mmap` protection: pages may be read.
const PROT_READ: int = 1;
/// `mmap` protection: pages may be written.
const PROT_WRITE: int = 2;
/// `mmap` flag: mapping is private to this process.
const MAP_PRIVATE: int = 2;
/// `mmap` flag: anonymous mapping (bionic `MAP_ANONYMOUS`).
const MAP_ANON: int = 32;

/// Write `n` bytes from `buf` to file descriptor `fd`.
pub fn write(fd: int, buf: ptr, n: int): int {
    return c.write(fd as i32, buf, n);
}

/// Open `path` with `flags` (mode 0).
pub fn open(path: ptr, flags: int): int {
    return c.open(path, flags, 0);
}

/// Open `path` with `flags` and permission `mode`.
pub fn openMode(path: ptr, flags: int, mode: int): int {
    return c.open(path, flags, mode);
}

/// Read up to `n` bytes from `fd` into `buf`.
pub fn read(fd: int, buf: ptr, n: int): int {
    return c.read(fd, buf, n);
}

/// Close file descriptor `fd`.
pub fn close(fd: int): int {
    return c.close(fd);
}

/// Seek in `fd` by `off` relative to `whence`.
pub fn lseek(fd: int, off: int, whence: int): int {
    return c.lseek(fd, off, whence);
}

/// Anonymous private read/write mapping of `len` bytes.
pub fn mmapAnon(len: int): ptr {
    let p = c.mmap(0, len, PROT_READ + PROT_WRITE, MAP_PRIVATE + MAP_ANON, 0 - 1, 0);
    if p as int == 0 - 1 {
        return 0;
    }
    return p;
}

/// Unmap a region previously returned by `mmapAnon`.
pub fn munmap(p: ptr, len: int) {
    c.munmap(p, len);
}

/// Run by `exit` (so by a panic and by the end of `main`) before the process ends. One slot, see `onExit`.
#[singleton]
let EXIT_HOOK: fn();

/// Run `hook` just before the process exits, normally or by panic (Linux: a panic runs it before the message is printed).
/// One slot: a later call replaces the earlier hook. The hook must be safe to run twice and may run in a forked child
/// that calls `exit`, so check `getpid()`. `j3.term.screen` uses it to restore the terminal.
pub fn onExit(hook: fn()) {
    EXIT_HOOK = hook;
}

fn runExitHook() {
    let hook = EXIT_HOOK;
    if hook as ptr != 0 as ptr {
        hook();
    }
}

/// Not available here: 0.
pub fn monotonicMs(): int { return 0; }

/// Terminate the process with exit code `code`.
pub fn exit(code: i32) {
    runExitHook();
    c.exit(code);
}

/// No thread names on Android yet.
pub fn setThreadName(name: string) {}

/// Print `msg` to stderr and exit with code 101.
pub fn panic(msg: string) {
    write(2, msg.ptr as ptr, msg.len);
    write(2, "\n".ptr as ptr, 1);
    exit(101);
}

/// Write `n` in decimal to stderr.
fn writeIntErr(n: int) {
    if n >= 10 { writeIntErr(n / 10); }
    let digit = "0123456789".ptr as int + n % 10;
    write(2, digit as ptr, 1);
}

/// Print `file:line: msg` to stderr and exit with code 101.
pub fn panicAt(file: string, line: int, msg: string) {
    write(2, file.ptr as ptr, file.len);
    write(2, ":".ptr as ptr, 1);
    writeIntErr(line);
    write(2, ": ".ptr as ptr, 2);
    write(2, msg.ptr as ptr, msg.len);
    write(2, "\n".ptr as ptr, 1);
    exit(101);
}

// Host `main` stores these before `start`. Pointers stay valid for the process.
#[singleton]
let ARGC: int = 0;
#[singleton]
let ARGV: ptr = 0;

fn setArgs(argc: int, argv: ptr) {
    ARGC = argc;
    ARGV = argv;
}

/// How many arguments the process was given, including the program (`arg(0)`).
pub fn argCount(): int {
    return ARGC;
}

/// Argument `i`, or "" when `i` is out of range. `arg(0)` is the program.
/// Slots are 8 bytes (LP64).
pub fn arg(i: int): string {
    if i < 0 || i >= ARGC || ARGV as int == 0 {
        return "";
    }
    let slot = ARGV as int + i * 8;
    let word = (slot as ptr) as &int;
    let p = *word;
    if p == 0 {
        return "";
    }
    let n = 0;
    while n < 65536 {
        let byte = ((p + n) as ptr) as &u8;
        let b = *byte;
        if b == 0 {
            break;
        }
        n += 1;
    }
    let bytes: []u8 = @slice(p as ptr, n);
    return bytes as string;
}

// Asset copy (j3.apkassets) reads the APK through SDL_RWops, which resolves relative paths in `assets/`.
fn apkOpen(path: ptr): ptr { return sdl.SDL_RWFromFile(path, "rb".ptr as ptr); }
fn apkRead(h: ptr, buf: ptr, n: int): int { return sdl.SDL_RWread(h, buf, 1, n); }
fn apkClose(h: ptr) { sdl.SDL_RWclose(h); }
fn apkSize(h: ptr): int { return sdl.SDL_RWsize(h); }
fn apkLog(msg: ptr) { sdl.SDL_Log("%s".ptr as ptr, msg); }
fn apkMs(): int { return sdl.SDL_GetTicks() as int; }

/// Entry from the host (`SDL_main`): copy the APK's assets into internal storage and `chdir` there
/// (before any window exists), run `main`, then return so SDLActivity can finish the app.
pub fn start() {
    let dir = sdl.SDL_AndroidGetInternalStoragePath();
    if dir as int != 0 {
        let n = 0;
        while n < 4096 {
            let cp = ((dir as int + n) as ptr) as &u8;
            let b = *cp;
            if b == 0 { break; }
            n += 1;
        }
        let bytes: []u8 = @slice(dir, n);
        boot(Source { open: apkOpen, read: apkRead, close: apkClose, size: apkSize, log: apkLog, ms: apkMs }, bytes as string);
    } else {
        apkLog("assets: SDL_AndroidGetInternalStoragePath is null, assets not copied".ptr as ptr);
    }
    main();
}

// Processes: the OS calls under `j3.proc`, through bionic. A program run this way must sit in the
// app's nativeLibraryDir (`J3_NATIVE_LIB_DIR`): Android 10+ refuses exec from app storage.

/// Copy this process. 0 in the child, the child's pid in the parent, negative on failure.
/// Before `execve` the child may only make raw calls from this module (`j3.proc` does this for you).
pub fn fork(): int { return int(c.fork()); }
/// Replace this process with the program at `path`. Returns only on failure, with `-errno`.
pub fn execve(path: ptr, argv: ptr, envp: ptr): int {
    c.execve(path, argv, envp);
    return 0 - errno();
}
/// Make a pipe: `fds[0]` reads what `fds[1]` writes. `flags` is 0 or `O_CLOEXEC`. Negative on failure.
pub fn pipe(fds: []i32, flags: int): int {
    if fds.len < 2 {
        return -1;
    }
    return int(c.pipe2(fds.ptr as ptr, i32(flags)));
}
/// Make `to` a copy of `from` (closing `to` first). Negative on failure.
pub fn dup2(from: int, to: int): int { return int(c.dup2(i32(from), i32(to))); }
/// Change the working directory to `path` (NUL-terminated). Negative on failure.
pub fn chdir(path: ptr): int { return int(c.chdir(path)); }
/// Not on this target: -1.
pub fn ioctl(fd: int, req: int, arg: ptr): int { return -1; }
/// Not on this target: -1.
pub fn setsid(): int { return -1; }
/// True when the file at `path` (NUL-terminated) exists and may be executed.
pub fn canExec(path: ptr): bool { return c.access(path, 1) == 0; }

// Files and directories (`j3.io`). ponytail: no stat/listing here yet (struct stat differs on arm64
// and x86_64); add through libc fstatat/readdir when an Android game needs `listDir`.

/// `statAt` dirfd meaning "relative to the working directory".
pub const AT_FDCWD: int = -100;
/// Not on Android yet: -1.
pub fn statAt(dir: int, path: ptr, out: []int): int { return -1; }
pub fn lstatAt(dir: int, path: ptr, out: []int): int { return -1; }
/// Not on Android yet: -1.
pub fn dirents(fd: int, buf: []u8): int { return -1; }
/// Rename `from` to `to` (both NUL-terminated), replacing `to`. `-errno` on failure.
pub fn rename(from: ptr, to: ptr): int { return failed(int(c.rename(from, to))); }
/// Delete the file `path` (NUL-terminated). `-errno` on failure.
pub fn unlink(path: ptr): int { return failed(int(c.unlink(path))); }
/// Make directory `path` (NUL-terminated) with permission bits `mode`. `-errno` on failure.
pub fn mkdir(path: ptr, mode: int): int { return failed(int(c.mkdir(path, u32(mode)))); }
fn failed(r: int): int {
    if r < 0 {
        return 0 - errno();
    }
    return r;
}
/// Wait for child `pid` (`flags` 0 blocks, `WNOHANG` polls) and store its raw status in `status`.
/// The pid, 0 when `WNOHANG` and it still runs, negative on failure. `exitCode` decodes `status`.
pub fn waitpid(pid: int, status: &i32, flags: int): int {
    while true {
        let r = int(c.waitpid(i32(pid), status as ptr, i32(flags)));
        if r >= 0 || errno() != 4 {
            return r;
        }
    }
    return 0 - 1;
}
/// A `waitpid` status as a shell would show it: the exit code, or 128 + the signal that ended it.
pub fn exitCode(status: i32): int {
    let s = int(status);
    let sig = s % 128;
    if sig == 0 {
        return (s / 256) % 256;
    }
    return 128 + sig;
}
/// Send `sig` to process `pid`. Negative on failure.
pub fn kill(pid: int, sig: int): int { return int(c.kill(i32(pid), i32(sig))); }
/// This process's id.
pub fn getpid(): int { return int(c.getpid()); }
/// Wait up to `ms` (negative waits forever) for events on `n` `struct pollfd`s at `fds`.
/// The count ready, 0 on timeout, negative on failure.
pub fn pollFds(fds: ptr, n: int, ms: int): int {
    while true {
        let r = int(c.poll(fds, n, i32(ms)));
        if r >= 0 || errno() != 4 {
            return r;
        }
    }
    return 0 - 1;
}
/// Ignore `SIGPIPE` (`on`) so a write to a closed socket returns an error instead of killing the app.
pub fn ignoreSigpipe(on: bool) {
    // SIG_IGN 1, SIG_DFL 0; SIGPIPE 13
    c.signal(13, if on { 1 } else { 0 });
}

/// NUL-terminated copy of a short name (`dlopen`, `dlsym`), per thread.
fn cstrTmp(s: string): cstr {
    if s.len + 1 > 256 {
        panic("dlopen: name too long");
    }
    for i in 0..s.len {
        DL_NAME[i] = s[i];
    }
    DL_NAME[s.len] = 0;
    return &DL_NAME[0] as cstr;
}

#[singleton]
#[thread]
let DL_NAME: [256]u8;

/// The process environment: a NUL-terminated array of `NAME=value` C strings.
/// Read from libc's `environ` variable (found with `dlsym`), not from the stack above `argv`:
/// on Android the process is started by the Java VM, and `SDL_main` is not `main`.
pub fn environ(): ptr {
    // RTLD_DEFAULT is 0 on bionic: search everything already loaded.
    let slot = c.dlsym(0 as ptr, cstrTmp("environ")) as &int;
    if slot as int == 0 {
        return 0;
    }
    let p = *slot;
    return p as ptr;
}

/// Environment variable `name`, or "" when unset. Valid for the whole process.
pub fn env(name: string): string {
    let ep = environ();
    if ep as int == 0 {
        return "";
    }
    let i = 0;
    while true {
        let slot = (ep as int + i * 8) as ptr as &int;
        let p = *slot;
        if p == 0 {
            return "";
        }
        let n = 0;
        while true {
            let byte = ((p + n) as ptr) as &u8;
            if *byte == 0 {
                break;
            }
            n += 1;
        }
        let bytes: []u8 = @slice(p as ptr, n);
        let s = bytes as string;
        if s.len > name.len && s[name.len] == 61 {
            let same = true;
            for k in 0..name.len {
                if s[k] != name[k] {
                    same = false;
                    break;
                }
            }
            if same {
                return s[name.len + 1..s.len];
            }
        }
        i += 1;
    }
    return "";
}

/// The last failed call's error number (`errno`).
pub fn errno(): int {
    let e = c.__errno() as &i32;
    return int(*e);
}

/// Load the shared library `name`. 0 when it cannot be loaded.
pub fn dlopen(name: string): ptr {
    return c.dlopen(cstrTmp(name), 2);
}

/// Address of `name` in a library from `dlopen`. 0 when missing.
pub fn dlsym(handle: ptr, name: string): ptr {
    return c.dlsym(handle, cstrTmp(name));
}

/// Directory of the running executable: always "" on Android (libraries come from the APK).
pub fn exeDir(): string { return ""; }
