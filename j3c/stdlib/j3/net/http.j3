/// HTTP/1.1 client over `j3.net.tcp`, with `https://` through `j3.net.tls` (system OpenSSL, the
/// certificate always checked). `request` sends one and reads the whole reply; `open` returns a
/// `Stream` that reads the body as it arrives (`readLine` for server-sent events, as LLM APIs
/// stream tokens). Bodies with `Content-Length`, `chunked`, or ending at close are all handled,
/// and redirects are followed (the `Authorization` header is dropped when one leaves the host).
///
///     let req = http.post("https://api.example.com/v1/x", body, &arena);
///     req.header("Authorization", auth);
///     req.header("Content-Type", "application/json");
///     match http.request(&req, &arena) {
///         Result.Ok(res) { /* res.status, res.bodyStr(), res.header("content-type") */ }
///         Result.Err(e) { /* http.errorName(e) */ }
///     }
///
/// Blocks for up to `timeoutMs` per connect, read, or write, so call it from a `j3.thread` worker,
/// never the frame thread (`j3c doc recipes http`). One connection per request (`Connection: close`).

module j3.net.http;

use j3.memory.{ Arena, List };
use j3.net.tcp;
use j3.net.tcp.{ Conn, TcpError };
use j3.net.tls;
use j3.net.tls.Tls;
use j3.result.Result;
use j3.text.Text;

// ponytail: no keep-alive or pooling, no gzip (Accept-Encoding is never sent); add when a game makes many calls

/// Why a request failed.
pub enum HttpError {
    /// The URL is not `http://` or `https://` with a host.
    BadUrl,
    /// A method, header, or path holds a line break or is empty.
    BadRequest,
    /// The host name did not resolve.
    Resolve,
    /// The host refused or could not be reached.
    Connect,
    /// TLS failed: untrusted certificate, handshake, or no libssl. `tls.lastError` says why.
    Tls,
    /// No progress within `timeoutMs`.
    Timeout,
    /// The server's reply was not valid HTTP/1.x, or the connection broke mid-reply.
    Protocol,
    /// More than `maxRedirects` redirects.
    TooManyRedirects,
}

/// A short English name for `e` (`"timeout"`, `"tls"`, ...), for logs.
pub fn errorName(e: HttpError): string {
    match e {
        HttpError.BadUrl { return "bad url"; }
        HttpError.BadRequest { return "bad request"; }
        HttpError.Resolve { return "host not found"; }
        HttpError.Connect { return "could not connect"; }
        HttpError.Tls { return "tls"; }
        HttpError.Timeout { return "timeout"; }
        HttpError.Protocol { return "bad reply"; }
        HttpError.TooManyRedirects { return "too many redirects"; }
    }
    return "";
}

/// The parts of an `http://` or `https://` URL.
pub struct Url {
    /// `https://`.
    https: bool;
    /// Host name or address (an IPv6 address without its brackets).
    host: string;
    /// Port, from the URL or the scheme's default.
    port: int;
    /// Path and query: `/` or more, or `?query` alone (sent as `/?query`). A `#fragment` is dropped.
    path: string;
}

fn lower(b: u8): u8 {
    if b >= 65 && b <= 90 {
        return b + 32;
    }
    return b;
}

/// ASCII case-insensitive equality (header names, schemes).
fn same(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if lower(a[i]) != lower(b[i]) {
            return false;
        }
    }
    return true;
}

fn startsWith(s: string, p: string): bool {
    return s.len >= p.len && same(s[0..p.len], p);
}

/// Split `s` into scheme, host, port, and path.
pub fn parseUrl(s: string): Result<Url, HttpError> {
    let https = false;
    let rest = s;
    if startsWith(s, "https://") {
        https = true;
        rest = s[8..s.len];
    } else if startsWith(s, "http://") {
        rest = s[7..s.len];
    } else {
        return Result.Err(HttpError.BadUrl);
    }
    let end = 0;
    while end < rest.len && rest[end] != 47 && rest[end] != 63 && rest[end] != 35 {
        end += 1;
    }
    let auth = rest[0..end];
    // drop `user:pass@`; credentials belong in a header
    for i in 0..auth.len {
        if auth[i] == 64 {
            auth = auth[i + 1..auth.len];
            break;
        }
    }
    let path = rest[end..rest.len];
    for i in 0..path.len {
        if path[i] == 35 {
            path = path[0..i];
            break;
        }
    }
    if path.len == 0 {
        path = "/";
    }
    let host = auth;
    let port = if https { 443 } else { 80 };
    let colon = -1;
    if auth.len > 0 && auth[0] == 91 {
        let close = -1;
        for i in 0..auth.len {
            if auth[i] == 93 {
                close = i;
                break;
            }
        }
        if close < 0 {
            return Result.Err(HttpError.BadUrl);
        }
        host = auth[1..close];
        if close + 1 < auth.len {
            if auth[close + 1] != 58 {
                return Result.Err(HttpError.BadUrl);
            }
            colon = close + 1;
        }
    } else {
        for i in 0..auth.len {
            if auth[i] == 58 {
                colon = i;
                host = auth[0..i];
            }
        }
    }
    if colon >= 0 {
        let p = 0;
        let digits = auth[colon + 1..auth.len];
        if digits.len == 0 || digits.len > 5 {
            return Result.Err(HttpError.BadUrl);
        }
        for i in 0..digits.len {
            if digits[i] < 48 || digits[i] > 57 {
                return Result.Err(HttpError.BadUrl);
            }
            p = p * 10 + int(digits[i]) - 48;
        }
        if p == 0 || p > 65535 {
            return Result.Err(HttpError.BadUrl);
        }
        port = p;
    }
    if host.len == 0 {
        return Result.Err(HttpError.BadUrl);
    }
    return Result.Ok(Url { https: https, host: host, port: port, path: path });
}

/// One header line.
pub struct Header {
    /// Name as sent or received (compare with `same`-style case folding; `Stream.header` does).
    name: string;
    /// Value without surrounding spaces.
    value: string;
}

/// What to send. Make one with `get` / `post` / `newRequest`, then add headers.
pub struct Request {
    /// `GET`, `POST`, ...
    method: string;
    /// Full `http://` or `https://` URL.
    url: string;
    /// Extra headers. `Host`, `Content-Length`, and `Connection` are written for you.
    headers: List<Header>;
    /// Body bytes (empty for none).
    body: []u8;
    /// Milliseconds each connect, read, or write may wait.
    timeoutMs: int = 30000;
    /// Redirects to follow before failing; 0 returns the 3xx reply itself.
    maxRedirects: int = 5;

    /// Add a header (replaces nothing; call once per name).
    fn header(this: &Request, name: string, value: string) {
        this.headers.push(Header { name: name, value: value });
    }
}

/// A request with `method`, `url`, and `body`.
pub fn newRequest(method: string, url: string, body: string, arena: &Arena): Request {
    return Request { method: method, url: url, headers: List<Header>.new(arena), body: body as []u8 };
}

/// A `GET` request.
pub fn get(url: string, arena: &Arena): Request {
    return newRequest("GET", url, "", arena);
}

/// A `POST` request with `body`. Set `Content-Type` with `header`.
pub fn post(url: string, body: string, arena: &Arena): Request {
    return newRequest("POST", url, body, arena);
}

/// A whole reply.
pub struct Response {
    /// Status code (`200`, `404`, ...).
    status: int;
    /// Reply headers in order.
    headers: List<Header>;
    /// The body, de-chunked.
    body: []u8;

    /// The body as a string.
    fn bodyStr(this: &Response): string {
        return this.body as string;
    }

    /// The first header called `name` (any case), or "".
    fn header(this: &Response, name: string): string {
        return findHeader(&this.headers, name);
    }
}

/// The first header in `hs` called `name` (any case), or "".
pub fn findHeader(hs: &List<Header>, name: string): string {
    for i in 0..hs.len {
        if same(hs.items[i].name, name) {
            return hs.items[i].value;
        }
    }
    return "";
}

/// How the body ends.
const BODY_LENGTH: int = 0;
const BODY_CHUNKED: int = 1;
const BODY_CLOSE: int = 2;

/// Bytes of the receive buffer, and the most a header block may take.
const BUF: int = 16384;
const MAX_HEAD: int = 65536;

/// A reply whose headers are read and whose body is read as it arrives. `close` it once.
pub struct Stream {
    /// Status code.
    status: int;
    /// Reply headers in order.
    headers: List<Header>;
    /// The URL that answered (after redirects).
    url: string;
    https: bool;
    plain: Conn;
    secure: Tls;
    buf: []u8;
    lo: int;
    hi: int;
    mode: int;
    /// Body bytes left (`BODY_LENGTH`), or left in this chunk (`BODY_CHUNKED`).
    left: int;
    done: bool;
    /// Set when the body broke off: `read` returned a negative number.
    failed: HttpError;
    broken: bool;

    /// The first header called `name` (any case), or "".
    fn header(this: &Stream, name: string): string {
        return findHeader(&this.headers, name);
    }

    /// Read more raw bytes into the buffer. False at the end of the connection or on failure.
    fn fill(this: &Stream): bool {
        if this.lo > 0 && this.lo == this.hi {
            this.lo = 0;
            this.hi = 0;
        }
        if this.hi == this.buf.len {
            if this.lo == 0 {
                return false;
            }
            let n = this.hi - this.lo;
            for i in 0..n {
                this.buf[i] = this.buf[this.lo + i];
            }
            this.lo = 0;
            this.hi = n;
        }
        let space = this.buf[this.hi..this.buf.len];
        let r = if this.https { this.secure.read(space) } else { this.plain.read(space) };
        if r > 0 {
            this.hi += r;
            return true;
        }
        if r < 0 {
            this.broken = true;
            this.failed = if r == tcp.TIMEOUT { HttpError.Timeout } else { HttpError.Protocol };
        }
        return false;
    }

    /// One raw line (CRLF or LF stripped) from the buffer, on `arena`. False when the connection ended first.
    fn rawLine(this: &Stream, t: &Text): bool {
        t.clear();
        while true {
            for i in this.lo..this.hi {
                if this.buf[i] == 10 {
                    let end = i;
                    if end > this.lo && this.buf[end - 1] == 13 {
                        end -= 1;
                    }
                    t.pushBytes(this.buf[this.lo..end]);
                    this.lo = i + 1;
                    return true;
                }
            }
            if t.len() + this.hi - this.lo > MAX_HEAD {
                return false;
            }
            t.pushBytes(this.buf[this.lo..this.hi]);
            this.lo = this.hi;
            if !this.fill() {
                return false;
            }
        }
        return false;
    }

    /// Start the next chunk of a chunked body. False on a bad size line.
    fn nextChunk(this: &Stream, scratch: &Text): bool {
        if !this.rawLine(scratch) {
            return false;
        }
        let line = scratch.str();
        let n = 0;
        let digits = 0;
        for i in 0..line.len {
            let b = int(lower(line[i]));
            let d = -1;
            if b >= 48 && b <= 57 {
                d = b - 48;
            } else if b >= 97 && b <= 102 {
                d = b - 87;
            }
            if d < 0 {
                break;
            }
            if digits >= 15 {
                return false;
            }
            n = n * 16 + d;
            digits += 1;
        }
        if digits == 0 {
            return false;
        }
        if n == 0 {
            // trailers, then a blank line
            while true {
                if !this.rawLine(scratch) {
                    return false;
                }
                if scratch.len() == 0 {
                    break;
                }
            }
            this.done = true;
            return true;
        }
        this.left = n;
        return true;
    }

    /// Read up to `out.len` body bytes: the count, 0 at the end of the body, or -1 when it broke
    /// off (`failed` says why).
    fn read(this: &Stream, out: []u8): int {
        if this.done || out.len == 0 {
            return 0;
        }
        if this.broken {
            return -1;
        }
        if this.mode == BODY_CHUNKED && this.left == 0 {
            let scratch = Text.new(this.headers.arena);
            if !this.nextChunk(&scratch) {
                return this.fault();
            }
            if this.done {
                return 0;
            }
        }
        if this.lo == this.hi && !this.fill() {
            if this.mode == BODY_CLOSE && !this.broken {
                this.done = true;
                return 0;
            }
            return this.fault();
        }
        let n = this.hi - this.lo;
        if n > out.len {
            n = out.len;
        }
        if this.mode != BODY_CLOSE && n > this.left {
            n = this.left;
        }
        for i in 0..n {
            out[i] = this.buf[this.lo + i];
        }
        this.lo += n;
        if this.mode != BODY_CLOSE {
            this.left -= n;
            if this.left == 0 {
                if this.mode == BODY_LENGTH {
                    this.done = true;
                } else {
                    // the CRLF after each chunk's data
                    let tail = Text.new(this.headers.arena);
                    if !this.rawLine(&tail) || tail.len() != 0 {
                        this.broken = true;
                        this.failed = HttpError.Protocol;
                    }
                }
            }
        }
        return n;
    }

    fn fault(this: &Stream): int {
        if !this.broken {
            this.broken = true;
            this.failed = HttpError.Protocol;
        }
        return -1;
    }

    /// The next line of the body into `t` (CR LF or LF stripped). False at the end of the body
    /// with nothing left; a last line without a newline is still returned. This is how to read
    /// server-sent events (`data: ...` lines).
    fn readLine(this: &Stream, t: &Text): bool {
        t.clear();
        let one: [1]u8 = [0];
        let got = false;
        while true {
            let r = this.read(one[:]);
            if r <= 0 {
                return got;
            }
            got = true;
            if one[0] == 10 {
                if t.len() > 0 && t.bytes[t.len() - 1] == 13 {
                    t.pop();
                }
                return true;
            }
            t.push(one[0]);
        }
        return got;
    }

    /// The rest of the body, on `arena`.
    fn readAll(this: &Stream, arena: &Arena): Result<[]u8, HttpError> {
        let t = Text.new(arena);
        let chunk = arena.alloc::<u8>(BUF);
        while true {
            let n = this.read(chunk);
            if n == 0 {
                break;
            }
            if n < 0 {
                return Result.Err(this.failed);
            }
            t.pushBytes(chunk[0..n]);
        }
        return Result.Ok(t.bytes);
    }

    /// Close the connection.
    fn close(this: &Stream) {
        if this.https {
            this.secure.close();
        } else {
            this.plain.close();
        }
    }

    fn send(this: &Stream, data: []u8): bool {
        if this.https {
            return this.secure.writeAll(data);
        }
        return this.plain.writeAll(data);
    }
}

/// True when `s` holds a CR, LF, or NUL (header injection).
fn unsafe(s: string): bool {
    for i in 0..s.len {
        if s[i] == 13 || s[i] == 10 || s[i] == 0 {
            return true;
        }
    }
    return false;
}

/// Send `req` and read the status and headers, following redirects. Read the body from the
/// `Stream`, then `close` it.
pub fn open(req: &Request, arena: &Arena): Result<Stream, HttpError> {
    if req.method.len == 0 || unsafe(req.method) {
        return Result.Err(HttpError.BadRequest);
    }
    for i in 0..req.headers.len {
        let h = req.headers.items[i];
        if h.name.len == 0 || unsafe(h.name) || unsafe(h.value) {
            return Result.Err(HttpError.BadRequest);
        }
    }
    let url = req.url;
    let method = req.method;
    let body = req.body;
    let headers = req.headers;
    let hops = 0;
    while true {
        let u = parseUrl(url)?;
        if unsafe(u.path) || unsafe(u.host) {
            return Result.Err(HttpError.BadRequest);
        }
        let s = once(&u, method, &headers, body, req.timeoutMs, arena)?;
        s.url = url;
        let st = s.status;
        let redirect = st == 301 || st == 302 || st == 303 || st == 307 || st == 308;
        let loc = s.header("location");
        if !redirect || loc.len == 0 || req.maxRedirects == 0 {
            return Result.Ok(s);
        }
        s.close();
        hops += 1;
        if hops > req.maxRedirects {
            return Result.Err(HttpError.TooManyRedirects);
        }
        let next = resolve(&u, loc, arena);
        let nu = parseUrl(next)?;
        if !same(nu.host, u.host) || nu.port != u.port || nu.https != u.https {
            // credentials were meant for the first host only
            let kept = List<Header>.new(arena);
            for i in 0..headers.len {
                let hd = headers.items[i];
                if !same(hd.name, "authorization") && !same(hd.name, "cookie") && !same(hd.name, "proxy-authorization") {
                    kept.push(hd);
                }
            }
            headers = kept;
        }
        if st == 303 || ((st == 301 || st == 302) && same(method, "POST")) {
            if !same(method, "HEAD") {
                method = "GET";
            }
            body = "" as []u8;
        }
        url = next;
    }
    return Result.Err(HttpError.Protocol);
}

/// `loc` (a `Location` header) as an absolute URL relative to `base`.
fn resolve(base: &Url, loc: string, arena: &Arena): string {
    if startsWith(loc, "http://") || startsWith(loc, "https://") {
        return loc;
    }
    let t = Text.new(arena);
    t.pushStr(if base.https { "https:" } else { "http:" });
    if loc.len >= 2 && loc[0] == 47 && loc[1] == 47 {
        t.pushStr(loc);
        return t.str();
    }
    t.pushStr("//");
    pushHost(&t, base);
    if loc.len > 0 && loc[0] == 47 {
        t.pushStr(loc);
        return t.str();
    }
    // relative to the base path's directory
    t.push(47);
    let dir = 0;
    for i in 0..base.path.len {
        if base.path[i] == 63 {
            break;
        }
        if base.path[i] == 47 {
            dir = i;
        }
    }
    if dir > 0 {
        t.pushStr(base.path[1..dir + 1]);
    }
    t.pushStr(loc);
    return t.str();
}

/// `host`, `[v6]`, and `:port` when it is not the scheme's default.
fn pushHost(t: &Text, u: &Url) {
    let v6 = false;
    for i in 0..u.host.len {
        if u.host[i] == 58 {
            v6 = true;
        }
    }
    if v6 {
        t.push(91);
    }
    t.pushStr(u.host);
    if v6 {
        t.push(93);
    }
    if u.port != (if u.https { 443 } else { 80 }) {
        t.push(58);
        t.pushInt(u.port);
    }
}

/// One request on a fresh connection, without redirects.
fn once(u: &Url, method: string, headers: &List<Header>, body: []u8, timeoutMs: int, arena: &Arena): Result<Stream, HttpError> {
    let conn = Conn {};
    match tcp.dial(u.host, u.port, timeoutMs, arena) {
        Result.Ok(c) { conn = c; }
        Result.Err(e) {
            match e {
                TcpError.Resolve { return Result.Err(HttpError.Resolve); }
                TcpError.Timeout { return Result.Err(HttpError.Timeout); }
                TcpError.Refused { return Result.Err(HttpError.Connect); }
                TcpError.Fail { return Result.Err(HttpError.Connect); }
            }
        }
    }
    let s = Stream {
        status: 0,
        headers: List<Header>.new(arena),
        url: "",
        https: u.https,
        plain: conn,
        secure: Tls { ssl: 0, ctx: 0, conn: Conn {} },
        buf: arena.alloc::<u8>(BUF),
        lo: 0,
        hi: 0,
        mode: BODY_CLOSE,
        left: 0,
        done: false,
        failed: HttpError.Protocol,
        broken: false,
    };
    if u.https {
        match tls.connect(conn, u.host) {
            Result.Ok(t) { s.secure = t; }
            Result.Err(_) { return Result.Err(HttpError.Tls); }
        }
    }

    let t = Text.new(arena);
    t.pushStr(method);
    t.push(32);
    if u.path[0] != 47 {
        t.push(47);
    }
    t.pushStr(u.path);
    t.pushStr(" HTTP/1.1\r\nHost: ");
    pushHost(&t, u);
    t.pushStr("\r\n");
    if findHeader(headers, "user-agent").len == 0 {
        t.pushStr("User-Agent: j3\r\n");
    }
    if findHeader(headers, "accept").len == 0 {
        t.pushStr("Accept: */*\r\n");
    }
    for i in 0..headers.len {
        let h = headers.items[i];
        if same(h.name, "host") || same(h.name, "content-length") || same(h.name, "connection") || same(h.name, "transfer-encoding") {
            continue;
        }
        t.pushStr(h.name);
        t.pushStr(": ");
        t.pushStr(h.value);
        t.pushStr("\r\n");
    }
    let sendsBody = body.len > 0 || same(method, "POST") || same(method, "PUT") || same(method, "PATCH");
    if sendsBody {
        t.pushStr("Content-Length: ");
        t.pushInt(body.len);
        t.pushStr("\r\n");
    }
    t.pushStr("Connection: close\r\n\r\n");
    if !s.send(t.bytes) || (body.len > 0 && !s.send(body)) {
        s.close();
        return Result.Err(HttpError.Timeout);
    }

    // status line and headers; 1xx replies (103 Early Hints) are skipped
    let line = Text.new(arena);
    while true {
        if !s.rawLine(&line) {
            let why = if s.broken { s.failed } else { HttpError.Protocol };
            s.close();
            return Result.Err(why);
        }
        let st = statusOf(line.str());
        if st < 0 {
            s.close();
            return Result.Err(HttpError.Protocol);
        }
        s.status = st;
        s.headers = List<Header>.new(arena);
        while true {
            if !s.rawLine(&line) {
                s.close();
                return Result.Err(HttpError.Protocol);
            }
            if line.len() == 0 {
                break;
            }
            let raw = line.str();
            let colon = -1;
            for i in 0..raw.len {
                if raw[i] == 58 {
                    colon = i;
                    break;
                }
            }
            if colon <= 0 {
                s.close();
                return Result.Err(HttpError.Protocol);
            }
            let keep = Text.new(arena);
            keep.pushStr(raw);
            let all = keep.str();
            s.headers.push(Header { name: all[0..colon], value: trim(all[colon + 1..all.len]) });
        }
        if st >= 200 || st < 100 {
            break;
        }
    }

    let te = s.header("transfer-encoding");
    let cl = s.header("content-length");
    if same(method, "HEAD") || s.status == 204 || s.status == 304 {
        s.done = true;
    } else if te.len > 0 && endsWithChunked(te) {
        s.mode = BODY_CHUNKED;
    } else if cl.len > 0 {
        let n = decimal(cl);
        if n < 0 {
            s.close();
            return Result.Err(HttpError.Protocol);
        }
        s.mode = BODY_LENGTH;
        s.left = n;
        if n == 0 {
            s.done = true;
        }
    }
    return Result.Ok(s);
}

/// Send `req` and read the whole reply (following redirects). Any status is `Ok`; check `status`.
pub fn request(req: &Request, arena: &Arena): Result<Response, HttpError> {
    let s = open(req, arena)?;
    let r = s.readAll(arena);
    s.close();
    let body = r?;
    return Result.Ok(Response { status: s.status, headers: s.headers, body: body });
}

/// The code in an `HTTP/1.x NNN reason` line, or -1.
fn statusOf(line: string): int {
    if line.len < 12 || !startsWith(line, "HTTP/1.") || line[8] != 32 {
        return -1;
    }
    let n = 0;
    for i in 9..12 {
        if line[i] < 48 || line[i] > 57 {
            return -1;
        }
        n = n * 10 + int(line[i]) - 48;
    }
    if line.len > 12 && line[12] != 32 {
        return -1;
    }
    return n;
}

fn trim(s: string): string {
    let a = 0;
    let b = s.len;
    while a < b && (s[a] == 32 || s[a] == 9) {
        a += 1;
    }
    while b > a && (s[b - 1] == 32 || s[b - 1] == 9) {
        b -= 1;
    }
    return s[a..b];
}

/// A non-negative decimal, or -1.
fn decimal(s: string): int {
    if s.len == 0 || s.len > 18 {
        return -1;
    }
    let n = 0;
    for i in 0..s.len {
        if s[i] < 48 || s[i] > 57 {
            return -1;
        }
        n = n * 10 + int(s[i]) - 48;
    }
    return n;
}

/// `Transfer-Encoding` whose last coding is `chunked`.
fn endsWithChunked(te: string): bool {
    let t = trim(te);
    return t.len >= 7 && same(t[t.len - 7..t.len], "chunked");
}
