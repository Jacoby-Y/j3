/// Name lookup for TCP: a host name or a numeric IPv4/IPv6 address to socket addresses, through the
/// system resolver (`getaddrinfo`: `/etc/hosts`, nsswitch, systemd-resolved). Blocks for as long
/// as the resolver takes, so call it from a `j3.thread` worker, not the frame thread.
/// Linux and Android; on macOS and Windows `resolve` returns `DnsError.Fail` for now.

module j3.net.dns;

use j3.memory.{ Arena, List };
use j3.netsys;
use j3.result.Result;
use j3.text.{ Text, cstr };

/// Why `resolve` failed.
pub enum DnsError {
    /// The name does not exist.
    NotFound,
    /// The resolver failed (no network, timeout, bad input).
    Fail,
}

/// One socket address for a host: IPv4 (`sockaddr_in`, 16 bytes) or IPv6 (`sockaddr_in6`, 28).
pub struct Endpoint {
    /// The raw socket address, port included (`len` bytes, on the lookup's arena).
    sa: []u8;
    /// Bytes of `sa` in use.
    len: int = 0;
    /// `netsys.AF_INET` or `netsys.AF_INET6`.
    family: int = 0;
}

/// Most addresses kept per lookup.
const MAX: int = 8;

/// Every TCP address for `host` at `port`, in the resolver's preferred order.
pub fn resolve(host: string, port: int, arena: &Arena): Result<List<Endpoint>, DnsError> {
    let raw = arena.alloc::<u8>(MAX * netsys.SA_MAX);
    let lens: [8]int = [0, 0, 0, 0, 0, 0, 0, 0];
    let fams: [8]int = [0, 0, 0, 0, 0, 0, 0, 0];
    let n = netsys.lookup(cstr(host), port, raw, lens[:], fams[:], MAX);
    if n == netsys.NO_NAME {
        return Result.Err(DnsError.NotFound);
    }
    if n < 0 {
        return Result.Err(DnsError.Fail);
    }
    if n == 0 {
        return Result.Err(DnsError.NotFound);
    }
    let out = List<Endpoint>.new(arena);
    for i in 0..n {
        let at = i * netsys.SA_MAX;
        out.push(Endpoint { sa: raw[at..at + lens[i]], len: lens[i], family: fams[i] });
    }
    return Result.Ok(out);
}

/// Append `e` as `1.2.3.4:443` or `[2001:db8:0:0:0:0:0:1]:443` to `t`.
pub fn format(e: &Endpoint, t: &Text) {
    let port = int(e.sa[2]) * 256 + int(e.sa[3]);
    if e.family == netsys.AF_INET6 {
        let hex = "0123456789abcdef";
        t.push(91);
        for g in 0..8 {
            if g > 0 {
                t.push(58);
            }
            let v = int(e.sa[8 + g * 2]) * 256 + int(e.sa[9 + g * 2]);
            let started = false;
            let div = 4096;
            while div > 0 {
                let d = (v / div) % 16;
                if d != 0 || started || div == 1 {
                    t.push(hex[d]);
                    started = true;
                }
                div = div / 16;
            }
        }
        t.push(93);
    } else {
        for i in 0..4 {
            if i > 0 {
                t.push(46);
            }
            t.pushInt(int(e.sa[4 + i]));
        }
    }
    t.push(58);
    t.pushInt(port);
}
