// Part of j3.net.http: URL parsing, redirect resolution, header-injection guard; the module doc and `use`s are in ../http.j3.
module j3.net.http;

/// The parts of an `http://` or `https://` URL.
pub struct Url {
    /// `https://`.
    https: bool;
    /// Host name or address (an IPv6 address without its brackets).
    host: string;
    /// Port, from the URL or the scheme's default.
    port: int;
    /// Path and query: `/` or more, or `?query` alone (sent as `/?query`). A `#fragment` is dropped.
    path: string;
}

fn lower(b: u8): u8 {
    if b >= 65 && b <= 90 {
        return b + 32;
    }
    return b;
}

/// ASCII case-insensitive equality (header names, schemes).
fn same(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if lower(a[i]) != lower(b[i]) {
            return false;
        }
    }
    return true;
}

fn startsWith(s: string, p: string): bool {
    return s.len >= p.len && same(s[0..p.len], p);
}

/// Split `s` into scheme, host, port, and path.
pub fn parseUrl(s: string): Result<Url, HttpError> {
    let https = false;
    let rest = s;
    if startsWith(s, "https://") {
        https = true;
        rest = s[8..s.len];
    } else if startsWith(s, "http://") {
        rest = s[7..s.len];
    } else {
        return Result.Err(HttpError.BadUrl);
    }
    let end = 0;
    while end < rest.len && rest[end] != 47 && rest[end] != 63 && rest[end] != 35 {
        end += 1;
    }
    let auth = rest[0..end];
    // drop `user:pass@`; credentials belong in a header
    for i in 0..auth.len {
        if auth[i] == 64 {
            auth = auth[i + 1..auth.len];
            break;
        }
    }
    let path = rest[end..rest.len];
    for i in 0..path.len {
        if path[i] == 35 {
            path = path[0..i];
            break;
        }
    }
    if path.len == 0 {
        path = "/";
    }
    let host = auth;
    let port = if https { 443 } else { 80 };
    let colon = -1;
    if auth.len > 0 && auth[0] == 91 {
        let close = -1;
        for i in 0..auth.len {
            if auth[i] == 93 {
                close = i;
                break;
            }
        }
        if close < 0 {
            return Result.Err(HttpError.BadUrl);
        }
        host = auth[1..close];
        if close + 1 < auth.len {
            if auth[close + 1] != 58 {
                return Result.Err(HttpError.BadUrl);
            }
            colon = close + 1;
        }
    } else {
        for i in 0..auth.len {
            if auth[i] == 58 {
                colon = i;
                host = auth[0..i];
            }
        }
    }
    if colon >= 0 {
        let p = 0;
        let digits = auth[colon + 1..auth.len];
        if digits.len == 0 || digits.len > 5 {
            return Result.Err(HttpError.BadUrl);
        }
        for i in 0..digits.len {
            if digits[i] < 48 || digits[i] > 57 {
                return Result.Err(HttpError.BadUrl);
            }
            p = p * 10 + int(digits[i]) - 48;
        }
        if p == 0 || p > 65535 {
            return Result.Err(HttpError.BadUrl);
        }
        port = p;
    }
    if host.len == 0 {
        return Result.Err(HttpError.BadUrl);
    }
    return Result.Ok(Url { https: https, host: host, port: port, path: path });
}

/// True when `s` holds a CR, LF, or NUL (header injection).
fn unsafe(s: string): bool {
    for i in 0..s.len {
        if s[i] == 13 || s[i] == 10 || s[i] == 0 {
            return true;
        }
    }
    return false;
}

/// `loc` (a `Location` header) as an absolute URL relative to `base`.
fn resolve(base: &Url, loc: string, arena: &Arena): string {
    if startsWith(loc, "http://") || startsWith(loc, "https://") {
        return loc;
    }
    let t = Text.new(arena);
    t.pushStr(if base.https { "https:" } else { "http:" });
    if loc.len >= 2 && loc[0] == 47 && loc[1] == 47 {
        t.pushStr(loc);
        return t.str();
    }
    t.pushStr("//");
    pushHost(&t, base);
    if loc.len > 0 && loc[0] == 47 {
        t.pushStr(loc);
        return t.str();
    }
    // relative to the base path's directory
    t.push(47);
    let dir = 0;
    for i in 0..base.path.len {
        if base.path[i] == 63 {
            break;
        }
        if base.path[i] == 47 {
            dir = i;
        }
    }
    if dir > 0 {
        t.pushStr(base.path[1..dir + 1]);
    }
    t.pushStr(loc);
    return t.str();
}

/// `host`, `[v6]`, and `:port` when it is not the scheme's default.
fn pushHost(t: &Text, u: &Url) {
    let v6 = false;
    for i in 0..u.host.len {
        if u.host[i] == 58 {
            v6 = true;
        }
    }
    if v6 {
        t.push(91);
    }
    t.pushStr(u.host);
    if v6 {
        t.push(93);
    }
    if u.port != (if u.https { 443 } else { 80 }) {
        t.push(58);
        t.pushInt(u.port);
    }
}
