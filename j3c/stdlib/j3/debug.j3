/// Frame time + entity count. F3-style overlay; `panicAt` lives on `j3.sys`.

module j3.debug;

use j3.game.{ Font, drawRect, drawTextBytes, lastDt, rgb, rgba, setColor };
use j3.math.Vec2;
use j3.memory.scratch;
use j3.text.Text;

/// Frame time and entity count for an F3-style overlay.
pub struct Stats {
    /// Last frame delta, in seconds.
    dt: f32;
    /// `1 / dt` after `sample`, else the previous value.
    fps: f32;
    /// Count passed to the latest `sample`.
    entities: int;
    /// When false, `overlay` draws nothing.
    shown: bool;

    /// 60 fps, no entities, hidden.
    fn fresh(): Stats {
        return Stats { dt: 0.016, fps: 60, entities: 0, shown: false };
    }

    /// Store `lastDt()` and `entities`, and recompute fps.
    fn sample(this: &Stats, entities: int) {
        this.dt = lastDt();
        this.entities = entities;
        if this.dt > 0.0001 {
            this.fps = f32(1) / this.dt;
        }
    }

    /// Draw fps and entity count when `shown` is set.
    fn overlay(this: &Stats, font: Font) {
        if !this.shown {
            return;
        }
        setColor(rgba(8, 8, 12, 180));
        drawRect(Vec2 { x: 8, y: 8 }, Vec2 { x: 140, y: 48 });
        if font.raw == 0 {
            return;
        }
        let t = Text.new(scratch(1));
        t.pushStr("fps ");
        t.pushInt(int(this.fps));
        setColor(rgb(200, 220, 180));
        drawTextBytes(font, Vec2 { x: 14, y: 12 }, t.bytes);
        t = Text.new(scratch(1));
        t.pushStr("ent ");
        t.pushInt(this.entities);
        drawTextBytes(font, Vec2 { x: 14, y: 32 }, t.bytes);
    }
}
