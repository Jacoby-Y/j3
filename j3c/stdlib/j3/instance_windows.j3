/// Windows `j3.instance`: the pub names and message semantics of `instance.j3` over a named pipe
/// `\\.\pipe\j3-<name>-<USERNAME>` (local clients only; gone when the process ends). A message or request travels as
/// a 4-byte length and the same bytes as on Linux; a reply is the bytes until the server closes its end.
/// ponytail: messages and request arguments over 64 KB are cut; at most 64 requests wait for a reply at once;
/// `reply` blocks the main thread until the client has read the text; a client that connects and sends nothing
/// stalls `next` until it does.

module j3.instance;

use j3.option.Option;
use j3.sys;
use j3.winsys;

/// First byte of a request's payload (a message starts with its argv[0], never this byte).
const REQ_MARK = 1;
const MAX_REQ = 64;
const MAX_MSG = 65536;
const MAX_ARGS = 256;

/// The listening pipe instance, or -1.
#[singleton]
let FD: int = -1;
#[singleton]
let ADDR: [160]u8;
#[singleton]
let BUF: [65536]u8;
#[singleton]
let ARGS: [256]string;
#[singleton]
let NARGS: int = 0;
#[singleton]
let RBUF: [65536]u8;
#[singleton]
let RLEN: int = 0;
#[singleton]
let PARKED: bool = false;
#[singleton]
let TAKEN_FD: int = -1;
/// The listening instance's OVERLAPPED, and whether its `ConnectNamedPipe` is in flight.
#[singleton]
let OV: [4]int;
#[singleton]
let PENDING: bool = false;
#[singleton]
let REQ_STATE: [64]int;
#[singleton]
let REQ_FD: [64]int;
#[singleton]
let REQ_GEN: [64]int;
#[singleton]
let REQ_SEQ: [64]int;
#[singleton]
let REQ_MEM: [64]ptr;
#[singleton]
let REQ_MEMLEN: [64]int;
#[singleton]
let REQ_ARGS: [64][]string;
#[singleton]
let SEQ: int = 0;

/// A request from `instance.request` that expects an answer: a copyable handle, valid until `reply`.
pub struct Request {
    slot: int;
    gen: int;

    /// The client's arguments (`args()[0]` is its program). Valid until `reply`; empty after it.
    fn args(this: Request): []string {
        if !this.live() { return ARGS[0..0]; }
        return REQ_ARGS[this.slot];
    }

    /// Send `text` as the answer and close the connection. A second call, or one after the client left, does nothing.
    fn reply(this: Request, text: string) {
        if !this.live() { return; }
        let h = REQ_FD[this.slot];
        let m: u8 = u8(REQ_MARK);
        if winsys.ovWrite(h, &m as ptr, 1) && winsys.ovWrite(h, text.ptr as ptr, text.len) {
            winsys.flush(h);
        }
        winsys.close(h);
        sys.munmap(REQ_MEM[this.slot], REQ_MEMLEN[this.slot]);
        REQ_STATE[this.slot] = 0;
        REQ_GEN[this.slot] += 1;
    }

    /// False once the client disconnected (killed, Ctrl+C, timed out) or the request was replied to.
    fn alive(this: Request): bool {
        return this.live() && winsys.avail(REQ_FD[this.slot]) >= 0;
    }

    fn live(this: Request): bool {
        return this.slot >= 0 && this.slot < MAX_REQ && REQ_STATE[this.slot] == 2 && REQ_GEN[this.slot] == this.gen;
    }
}

/// Become the one copy named `name` and return true, or, when another copy already holds it, send it this process's
/// arguments and return false (the caller exits). True also when pipes fail, so a broken setup still starts.
pub fn claim(name: string): bool {
    address(name);
    let h = winsys.pipeServer(&ADDR[0] as ptr, true);
    if h != winsys.INVALID {
        FD = h;
        return true;
    }
    let err = winsys.lastError();
    if err != winsys.ERROR_ACCESS_DENIED && err != winsys.ERROR_PIPE_BUSY {
        return true;
    }
    let c = connect(2000);
    if c == winsys.INVALID {
        return false;
    }
    let total = 0;
    for i in 0..sys.argCount() {
        total += sys.arg(i).len + 1;
    }
    sendLen(c, total);
    for i in 0..sys.argCount() {
        let a = sys.arg(i);
        let z: u8 = 0;
        winsys.writeAll(c, a.ptr as ptr, a.len);
        winsys.writeAll(c, &z as ptr, 1);
    }
    winsys.flush(c);
    winsys.close(c);
    return false;
}

/// Take one message from a later copy: true when `args()` now holds its arguments. Never blocks.
pub fn next(): bool {
    if PARKED {
        PARKED = false;
        return true;
    }
    while take() {
        if !queueRequest() {
            parkMessage();
            PARKED = false;
            return true;
        }
    }
    return false;
}

/// Take one request from `instance.request`, or None when none is waiting. Never blocks.
pub fn nextRequest(): Option<Request> {
    while take() {
        if !queueRequest() {
            // ponytail: one parked message; a second one before `next` runs replaces it.
            parkMessage();
        }
    }
    let best = 0 - 1;
    for i in 0..MAX_REQ {
        if REQ_STATE[i] == 1 && (best < 0 || REQ_SEQ[i] < REQ_SEQ[best]) { best = i; }
    }
    if best < 0 { return Option.None; }
    REQ_STATE[best] = 2;
    return Option.Some(Request { slot: best, gen: REQ_GEN[best] });
}

/// Send `args` to the running copy named `name` and wait for its reply, at most `timeoutMs` (<= 0 waits forever).
/// None when no copy runs, the pipe fails, the copy closes without replying, or the time runs out.
pub fn request(name: string, args: []string, timeoutMs: int): Option<string> {
    address(name);
    let c = connect(if timeoutMs > 0 { timeoutMs } else { 2000 });
    if c == winsys.INVALID { return Option.None; }
    let total = 1;
    for i in 0..args.len { total += args[i].len + 1; }
    let m: u8 = u8(REQ_MARK);
    let ok = sendLen(c, total) && winsys.writeAll(c, &m as ptr, 1);
    for i in 0..args.len {
        let z: u8 = 0;
        ok = ok && winsys.writeAll(c, args[i].ptr as ptr, args[i].len) && winsys.writeAll(c, &z as ptr, 1);
    }
    let deadline = winsys.nowMs() + timeoutMs;
    let cap = 65536;
    let buf = sys.mmapAnon(cap);
    let n = 0;
    while ok {
        let a = winsys.avail(c);
        if a < 0 { break; }
        if a == 0 {
            if timeoutMs > 0 && winsys.nowMs() >= deadline { ok = false; break; }
            winsys.sleepMs(2);
            continue;
        }
        if n == cap {
            let bigger = sys.mmapAnon(cap * 2);
            copyBytes(bigger, buf, n);
            sys.munmap(buf, cap);
            buf = bigger;
            cap = cap * 2;
        }
        let r = winsys.read(c, @slice((buf as int + n) as ptr, cap - n));
        if r <= 0 { break; }
        n += r;
    }
    winsys.close(c);
    if !ok || n == 0 {
        sys.munmap(buf, cap);
        return Option.None;
    }
    return Option.Some([]u8 { ptr: (buf as int + 1) as &u8, len: n - 1 } as string);
}

/// The arguments of the message `next` took (valid until the next `next`). `args()[0]` is the sender's program.
pub fn args(): []string {
    return ARGS[0..NARGS];
}

/// Open the pipe at `ADDR` as a client, waiting up to `ms` while every instance is busy. `INVALID` when no copy runs.
fn connect(ms: int): int {
    let until = winsys.nowMs() + ms;
    while true {
        let c = winsys.pipeClient(&ADDR[0] as ptr);
        if c != winsys.INVALID { return c; }
        if winsys.lastError() != winsys.ERROR_PIPE_BUSY { return winsys.INVALID; }
        let left = until - winsys.nowMs();
        if left <= 0 { return winsys.INVALID; }
        winsys.waitPipe(&ADDR[0] as ptr, left);
    }
    return winsys.INVALID;
}

fn sendLen(c: int, n: int): bool {
    let len: u32 = u32(n);
    return winsys.writeAll(c, &len as ptr, 4);
}

/// Read exactly `n` bytes from blocking pipe `h` into `p`; false when it ends first.
fn readFull(h: int, p: ptr, n: int): bool {
    let at = 0;
    while at < n {
        let r = winsys.ovRead(h, @slice((p as int + at) as ptr, n - at));
        if r <= 0 { return false; }
        at += r;
    }
    return true;
}

/// Take the connected client of the listening instance, if any, and read its payload into `RBUF`. False when none.
fn take(): bool {
    if FD < 0 {
        return false;
    }
    // keeps the instance listening; whether a client is there is read from the bytes it sent, since
    // implementations differ in what a non-blocking ConnectNamedPipe returns
    let r = winsys.pipeAccept(FD, &OV[0] as ptr, PENDING);
    PENDING = r == 0;
    if r <= 0 {
        if r < 0 {
            // a broken instance: start over with a fresh one
            winsys.close(FD);
            FD = winsys.pipeServer(&ADDR[0] as ptr, false);
        }
        return false;
    }
    let c = FD;
    FD = winsys.pipeServer(&ADDR[0] as ptr, false);
    // the client sends right after connecting
    let len: u32 = 0;
    let n = 0;
    if readFull(c, &len as ptr, 4) {
        n = int(len);
        if n > MAX_MSG { n = MAX_MSG; }
        if !readFull(c, &RBUF[0] as ptr, n) { n = 0; }
    }
    RLEN = n;
    if n > 0 && RBUF[0] == u8(REQ_MARK) {
        TAKEN_FD = c;
    } else {
        TAKEN_FD = 0 - 1;
        winsys.close(c);
    }
    return true;
}

/// When the connection `take` read is a request, put it in a free slot (or close it when all are busy) and return true.
fn queueRequest(): bool {
    if TAKEN_FD < 0 { return false; }
    let slot = 0 - 1;
    for i in 0..MAX_REQ {
        if slot < 0 && REQ_STATE[i] == 0 { slot = i; }
    }
    if slot < 0 {
        winsys.close(TAKEN_FD);
        return true;
    }
    let bytes = (RLEN + 7) / 8 * 8;
    let len = bytes + MAX_ARGS * @sizeof(string);
    let mem = sys.mmapAnon(len);
    copyBytes(mem, &RBUF[1] as ptr, RLEN - 1);
    let out: []string = @slice((mem as int + bytes) as ptr, MAX_ARGS);
    let k = 0;
    let s = 0;
    for i in 0..RLEN - 1 {
        if RBUF[i + 1] == 0 && k < MAX_ARGS {
            out[k] = []u8 { ptr: (mem as int + s) as &u8, len: i - s } as string;
            k += 1;
            s = i + 1;
        }
    }
    REQ_FD[slot] = TAKEN_FD;
    REQ_MEM[slot] = mem;
    REQ_MEMLEN[slot] = len;
    REQ_ARGS[slot] = out[0..k];
    REQ_SEQ[slot] = SEQ;
    SEQ += 1;
    REQ_STATE[slot] = 1;
    return true;
}

/// Copy the message `take` read into `BUF` and split it into `ARGS`; sets `PARKED`.
fn parkMessage() {
    copyBytes(&BUF[0] as ptr, &RBUF[0] as ptr, RLEN);
    NARGS = 0;
    let s = 0;
    for i in 0..RLEN {
        if BUF[i] == 0 && NARGS < MAX_ARGS {
            ARGS[NARGS] = []u8 { ptr: &BUF[s], len: i - s } as string;
            NARGS += 1;
            s = i + 1;
        }
    }
    PARKED = true;
}

fn copyBytes(dst: ptr, src: ptr, n: int) {
    let d: []u8 = @slice(dst, n);
    let s: []u8 = @slice(src, n);
    for i in 0..n { d[i] = s[i]; }
}

/// `\\.\pipe\j3-<name>-<USERNAME>`, NUL-terminated, in `ADDR`.
fn address(name: string) {
    let n = 0;
    let parts: [4]string = ["\\\\.\\pipe\\j3-", name, "-", sys.env("USERNAME")];
    for p in 0..4 {
        for i in 0..parts[p].len {
            // a pipe name may not hold a backslash past the prefix
            if n < 150 { ADDR[n] = if p > 0 && parts[p][i] == 92 { u8(95) } else { parts[p][i] }; n += 1; }
        }
    }
    ADDR[n] = 0;
}

