/// Timers, tweens, and a tiny particle burst. No new language.

module j3.fx;

use j3.game.{ Camera, drawRect, drawRectCam, rgb, setColor };
use j3.math.{ Vec2, cos, sin };
use j3.memory.Arena;

/// Countdown timer in seconds.
pub struct Timer {
    /// Remaining time; done when `<= 0`.
    left: f32;

    /// Start a timer with `sec` seconds remaining.
    fn of(sec: f32): Timer {
        return Timer { left: sec };
    }

    /// Set remaining time to `sec`.
    fn reset(this: &Timer, sec: f32) {
        this.left = sec;
    }

    /// Subtract `dt`; returns true only on the frame it crosses into done.
    fn tick(this: &Timer, dt: f32): bool {
        if this.left <= 0 {
            return false;
        }
        this.left = this.left - dt;
        return this.left <= 0;
    }

    /// True when no time remains.
    fn done(this: &Timer): bool {
        return this.left <= 0;
    }
}

/// Linear float tween from `a` to `b` over `dur` seconds.
pub struct Tween {
    /// Elapsed time, clamped to `dur`.
    t: f32;
    /// Total duration.
    dur: f32;
    /// Start value.
    a: f32;
    /// End value.
    b: f32;

    /// Tween from `a` to `b` lasting `dur` seconds (starts at `t = 0`).
    fn of(a: f32, b: f32, dur: f32): Tween {
        return Tween { t: 0, dur: dur, a: a, b: b };
    }

    /// Advance elapsed time by `dt`, capped at `dur`.
    fn tick(this: &Tween, dt: f32) {
        this.t = this.t + dt;
        if this.t > this.dur {
            this.t = this.dur;
        }
    }

    /// Interpolated value; returns `b` immediately if `dur <= 0`.
    fn value(this: Tween): f32 {
        if this.dur <= 0 {
            return this.b;
        }
        return this.a + (this.b - this.a) * (this.t / this.dur);
    }

    /// True when elapsed time has reached `dur`.
    fn done(this: Tween): bool {
        return this.t >= this.dur;
    }
}

/// One particle: position, velocity, and remaining life.
pub struct Particle {
    /// World position.
    pos: Vec2;
    /// Velocity in units per second.
    vel: Vec2;
    /// Seconds of life left.
    life: f32;
}

/// Fixed-capacity particle pool with burst spawn and simple draw.
pub struct Particles {
    /// Preallocated particle slots.
    items: []Particle;
    /// Number of live particles.
    count: int;
    /// Arena that owns `items`.
    arena: &Arena;

    /// Empty pool with room for `cap` particles.
    fn new(arena: &Arena, cap: int): Particles {
        return Particles {
            items: arena.alloc::<Particle>(cap),
            count: 0,
            arena: arena,
        };
    }

    /// Spawn up to `n` particles at `pos` in evenly spaced directions at `speed`.
    fn burst(this: &Particles, pos: Vec2, n: int, speed: f32) {
        let i = 0;
        while i < n && this.count < this.items.len {
            let a = f32(i) * 0.785;
            this.items[this.count] = Particle {
                pos: pos,
                vel: Vec2 { x: cos(a) * speed, y: sin(a) * speed },
                life: 0.35,
            };
            this.count = this.count + 1;
            i += 1;
        }
    }

    /// Integrate positions and remove particles whose life has expired.
    fn tick(this: &Particles, dt: f32) {
        let i = 0;
        while i < this.count {
            let p = this.items[i];
            p.pos = p.pos + p.vel * dt;
            p.life = p.life - dt;
            this.items[i] = p;
            if p.life <= 0 {
                this.count = this.count - 1;
                this.items[i] = this.items[this.count];
            } else {
                i += 1;
            }
        }
    }

    /// Draw live particles as 3×3 screen-space rects.
    fn draw(this: &Particles) {
        setColor(rgb(240, 200, 90));
        let i = 0;
        while i < this.count {
            let p = this.items[i];
            drawRect(p.pos, Vec2 { x: 3, y: 3 });
            i += 1;
        }
    }

    /// Draw live particles as 3×3 rects in camera space.
    fn drawCam(this: &Particles, cam: Camera) {
        setColor(rgb(240, 200, 90));
        let i = 0;
        while i < this.count {
            let p = this.items[i];
            drawRectCam(cam, p.pos, Vec2 { x: 3, y: 3 });
            i += 1;
        }
    }
}
