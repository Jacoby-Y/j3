/// Terminal types shared by the ANSI parser and the cell grid: `Color`, `Attr` bits, `Style`, `Cell`.
/// Pure data, no OS calls. Any thread. See `j3c doc j3.term.ansi` for the parser.

module j3.term;

use j3.text.Text;

/// `Color.kind()` of the terminal's own default color.
pub const COLOR_DEFAULT = 0;
/// `Color.kind()` of a palette entry (0-15 the ANSI colors, 16-255 the xterm cube and gray ramp).
pub const COLOR_PALETTE = 1;
/// `Color.kind()` of a 24-bit color.
pub const COLOR_RGB = 2;

/// A color in one `u32`: the kind in the top byte, the palette index or `0xRRGGBB` below. All zero is the default color.
pub struct Color {
    v: u32;

    /// The terminal's default foreground or background.
    fn default(): Color {
        return Color { v: 0 };
    }

    /// Palette entry `n` (taken mod 256).
    fn palette(n: int): Color {
        return Color { v: (u32(COLOR_PALETTE) << 24) | u32(n & 255) };
    }

    /// A 24-bit color; each channel is taken mod 256.
    fn rgb(r: int, g: int, b: int): Color {
        return Color { v: (u32(COLOR_RGB) << 24) | (u32(r & 255) << 16) | (u32(g & 255) << 8) | u32(b & 255) };
    }

    /// `COLOR_DEFAULT`, `COLOR_PALETTE` or `COLOR_RGB`.
    fn kind(this: Color): int {
        return int(this.v >> 24);
    }

    /// Palette index (palette colors only; 0 otherwise).
    fn index(this: Color): int {
        if this.kind() != COLOR_PALETTE {
            return 0;
        }
        return int(this.v & 255);
    }

    /// Red channel (rgb colors only; 0 otherwise).
    fn r(this: Color): int {
        if this.kind() != COLOR_RGB {
            return 0;
        }
        return int((this.v >> 16) & 255);
    }

    /// Green channel (rgb colors only; 0 otherwise).
    fn g(this: Color): int {
        if this.kind() != COLOR_RGB {
            return 0;
        }
        return int((this.v >> 8) & 255);
    }

    /// Blue channel (rgb colors only; 0 otherwise).
    fn b(this: Color): int {
        if this.kind() != COLOR_RGB {
            return 0;
        }
        return int(this.v & 255);
    }

    fn operator==(this: Color, other: Color): bool {
        return this.v == other.v;
    }
}

/// `Style.attr` bits.
pub const ATTR_BOLD = 1;
pub const ATTR_DIM = 2;
pub const ATTR_ITALIC = 4;
pub const ATTR_UNDERLINE = 8;
pub const ATTR_BLINK = 16;
pub const ATTR_INVERSE = 32;
pub const ATTR_HIDDEN = 64;
pub const ATTR_STRIKE = 128;

/// What SGR sets: foreground, background and `ATTR_*` bits.
pub struct Style {
    fg: Color;
    bg: Color;
    attr: u16;

    /// Default colors, no attributes.
    fn plain(): Style {
        return Style { fg: Color.default(), bg: Color.default(), attr: 0 };
    }

    /// Whether every `ATTR_*` bit in `bits` is set.
    fn has(this: Style, bits: int): bool {
        return (int(this.attr) & bits) == bits;
    }

    fn operator==(this: Style, other: Style): bool {
        return this.fg == other.fg && this.bg == other.bg && this.attr == other.attr;
    }
}

/// One grid cell. `cp` 0 is empty; `width` is 1, 2 (wide head), or 0 (the right half of a wide char).
/// `link` is an OSC 8 hyperlink id (0 none) that the grid keeps a table for. `marks` holds up to two combining code
/// points printed after `cp` (BMP only), low 16 bits first, 0 none: read them with `mark(i)`.
pub struct Cell {
    cp: i32;
    style: Style;
    width: u8;
    link: u16;
    marks: u32;

    /// Combining mark `i` (0 or 1) on this cell, 0 when there is none.
    fn mark(this: Cell, i: int): i32 {
        return i32((this.marks >> u32(16 * i)) & 0xffff);
    }

    /// A blank cell in `style`.
    fn blank(style: Style): Cell {
        return Cell { cp: 0, style: style, width: 1, link: 0, marks: 0 };
    }
}

/// Append the UTF-8 bytes of code point `cp` (1 to 4 bytes) to `out`.
pub fn pushUtf8(out: &Text, cp: i32) {
    let c = int(cp);
    if c < 0x80 {
        out.push(u8(c));
    } else if c < 0x800 {
        out.push(u8(0xc0 | (c >> 6)));
        out.push(u8(0x80 | (c & 0x3f)));
    } else if c < 0x10000 {
        out.push(u8(0xe0 | (c >> 12)));
        out.push(u8(0x80 | ((c >> 6) & 0x3f)));
        out.push(u8(0x80 | (c & 0x3f)));
    } else {
        out.push(u8(0xf0 | (c >> 18)));
        out.push(u8(0x80 | ((c >> 12) & 0x3f)));
        out.push(u8(0x80 | ((c >> 6) & 0x3f)));
        out.push(u8(0x80 | (c & 0x3f)));
    }
}

/// The code point at `s[i..]` and, through `n`, how many bytes it used. A bad byte decodes as U+FFFD with `n` 1. A
/// sequence cut off by the end of `s` (more bytes may follow) gives `n` 0 and U+FFFD. `i` must be below `s.len`.
pub fn decodeUtf8(s: string, i: int, n: &int): i32 {
    let b0 = int(s[i]);
    let need = 0;
    let cp = b0;
    if b0 >= 0xF0 && b0 < 0xF8 {
        need = 3;
        cp = b0 & 7;
    } else if b0 >= 0xE0 && b0 < 0xF0 {
        need = 2;
        cp = b0 & 15;
    } else if b0 >= 0xC2 && b0 < 0xE0 {
        need = 1;
        cp = b0 & 31;
    } else if b0 >= 0x80 {
        *n = 1;
        return 65533;
    }
    for k in 1..need + 1 {
        if i + k >= s.len {
            *n = 0;
            return 65533;
        }
        let b = int(s[i + k]);
        if (b & 0xC0) != 0x80 {
            *n = 1;
            return 65533;
        }
        cp = (cp << 6) | (b & 63);
    }
    *n = need + 1;
    return i32(cp);
}

/// The 16 base ANSI colors as 0xRRGGBB (VS Code's terminal theme), the first 16 entries of `paletteRgb`.
const PAL16: [16]int = [
    0x000000, 0xcd3131, 0x0dbc79, 0xe5e510, 0x2472c8, 0xbc3fbc, 0x11a8cd, 0xe5e5e5,
    0x666666, 0xf14c4c, 0x23d18b, 0xf5f543, 0x3b8eea, 0xd670d6, 0x29b8db, 0xffffff,
];

/// 0xRRGGBB of xterm palette entry `n` (0-15 ANSI colors, 16-231 the 6x6x6 cube, 232-255 the gray ramp).
pub fn paletteRgb(n: int): int {
    if n < 16 {
        return PAL16[n];
    }
    if n >= 232 {
        let g = 8 + 10 * (n - 232);
        return (g << 16) | (g << 8) | g;
    }
    let c = n - 16;
    let r = c / 36;
    let g = (c / 6) % 6;
    let b = c % 6;
    let lr = if r == 0 { 0 } else { 55 + 40 * r };
    let lg = if g == 0 { 0 } else { 55 + 40 * g };
    let lb = if b == 0 { 0 } else { 55 + 40 * b };
    return (lr << 16) | (lg << 8) | lb;
}
