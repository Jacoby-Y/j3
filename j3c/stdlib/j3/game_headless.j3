/// Advance one frame; returns a fixed ~60 Hz dt.
pub fn poll(): f32 {
    return 0.016;
}

/// Dt from the last `poll` (fixed 0.016 headless).
pub fn lastDt(): f32 {
    return 0.016;
}

/// Frames since init (always 0 headless).
pub fn frameCount(): int {
    return 0;
}

/// Request that the main loop exit (no-op headless).
pub fn requestQuit() {
}

/// True while `key` is held (Escape is always down headless).
pub fn keyDown(key: Key): bool {
    return key == Key.Escape;
}

/// True on the frame `key` went down (always false headless).
pub fn keyPressed(key: Key): bool {
    return false;
}

/// True on the frame `key` went up (always false headless).
pub fn keyReleased(key: Key): bool {
    return false;
}

/// Cursor position in window pixels (always origin headless).
pub fn mousePos(): Vec2 {
    return Vec2 { x: 0, y: 0 };
}

/// True while `btn` is held (always false headless).
