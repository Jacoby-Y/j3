/// GPU zones, as in `game.j3`. Nothing is timed here.
pub const ZONE_SHADOW: int = 0;
pub const ZONE_CAMERA: int = 1;
pub const ZONE_UI: int = 2;

/// Same fields as `game.j3`; always zero here.
pub struct FrameStats {
    draws: int = 0;
    tris: int = 0;
    frameMs: f32 = 0;
    cpuMs: f32 = 0;
    sceneMs: f32 = 0;
    shadowMs: f32 = 0;
    cameraMs: f32 = 0;
    uiMs: f32 = 0;
}

/// Most recently completed frame, without smoothing. GPU timings arrive asynchronously.
pub fn lastFrameStats(): FrameStats { return FrameStats {}; }

/// Zeros.
pub fn frameStats(): FrameStats { return FrameStats {}; }
/// No-op.
pub fn profDraw(_tris: int) {}
/// No-op.
pub fn profScene(_us: int) {}
/// No-op.
pub fn profZone(_z: int) {}
/// `ticks` in microseconds.
pub fn micros(): int { return ticks() * 1000; }
