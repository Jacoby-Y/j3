/// Load RGBA8 pixels from an 8-bit PNG (`j3.gfx.canvas.loadPng`); empty for anything else.
pub fn loadRgba(path: string, arena: &Arena): Rgba {
    let c = loadPng(path, arena);
    return Rgba { pixels: c.pixels, w: c.w, h: c.h };
}

/// Load an image as a texture (empty handle headless).
pub fn loadTexture(path: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Try to load a texture (empty handle headless).
pub fn tryLoadTexture(path: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Generated canvas textures are empty in headless mode.
pub fn textureFromCanvas(canvas: Canvas): Texture {
    return Texture { raw: 0, w: canvas.w, h: canvas.h };
}

