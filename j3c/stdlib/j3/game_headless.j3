}

/// Gamepad stick or trigger axis.
pub enum Axis {
    /// Left stick X.
    LeftX,
    /// Left stick Y.
    LeftY,
    /// Right stick X.
    RightX,
    /// Right stick Y.
    RightY,
    /// Left trigger.
    LT,
    /// Right trigger.
    RT,
}

/// Tightly packed RGBA8 image. Headless loads are empty.
pub struct Rgba {
    /// Row-major pixels, 4 bytes each.
    pixels: []u8;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// GPU texture handle and pixel size.
pub struct Texture {
    /// Backend texture pointer (0 if empty).
    raw: ptr = 0;
    /// Width in pixels.
    w: i32 = 0;
    /// Height in pixels.
    h: i32 = 0;
}

/// Loaded sound sample.
pub struct Sound {
    /// Backend chunk pointer (0 if empty).
    raw: ptr;
}

/// Loaded music stream.
pub struct Music {
    /// Backend music pointer (0 if empty).
    raw: ptr;
}

/// Opened TrueType font.
pub struct Font {
    /// Backend font pointer (0 if empty).
    raw: ptr;
}

/// 2D camera: world origin and zoom.
pub struct Camera {
    /// World-space top-left of the view.
    pos: Vec2;
    /// Screen pixels per world unit.
    zoom: f32;

    /// Camera at origin with the given zoom.
    fn create(zoom: f32): Camera {
        return Camera {
            pos: Vec2 { x: 0, y: 0 },
            zoom: zoom,
        };
    }

    /// Map a world point to screen space.
    fn toScreen(this: Camera, world: Vec2): Vec2 {
        return (world - this.pos) * this.zoom;
    }

    /// Map a screen point to world space.
    fn toWorld(this: Camera, screen: Vec2): Vec2 {
        return screen * (f32(1) / this.zoom) + this.pos;
    }

    /// Headless stand-in: sets `pos` to `focus` (no clamp).
    fn follow(this: &Camera, focus: Vec2, view: Vec2, map_w: f32, map_h: f32) {
        this.pos = focus;
    }
}

