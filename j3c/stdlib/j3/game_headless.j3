/// Tightly packed RGBA8 image. Headless loads are empty.
pub struct Rgba {
    /// Row-major pixels, 4 bytes each.
    pixels: []u8;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// GPU texture handle and pixel size.
pub struct Texture {
    /// Backend texture pointer (0 if empty).
    raw: ptr = 0;
    /// Width in pixels.
    w: i32 = 0;
    /// Height in pixels.
    h: i32 = 0;
}

/// Loaded sound sample.
pub struct Sound {
    /// Backend chunk pointer (0 if empty).
    raw: ptr;
}

/// PCM output stream (always empty headless).
pub struct AudioStream {
    /// Device id (always 0 headless).
    raw: int;
    /// Frames per second.
    rate: int;
    /// Interleaved channels per frame.
    channels: int;

    /// Append interleaved samples (no-op headless).
    fn queue(this: &AudioStream, samples: []f32) {}

    /// Frames queued but not played (0 headless).
    fn queued(this: &AudioStream): int {
        return 0;
    }

    /// Drop everything queued (no-op headless).
    fn clear(this: &AudioStream) {}

    /// Pause or resume (no-op headless).
    fn pause(this: &AudioStream, paused: bool) {}

    /// Close the stream (no-op headless).
    fn close(this: &AudioStream) {}
}

/// Loaded music stream (empty headless).
pub struct Music {
    /// Backend music pointer (0 if empty).
    raw: ptr;
}

/// Opened TrueType font.
pub struct Font {
    /// Backend font pointer (0 if empty).
    raw: ptr;
}

/// 2D camera: world origin and zoom.
pub struct Camera {
    /// World-space top-left of the view.
    pos: Vec2;
    /// Screen pixels per world unit.
    zoom: f32;

    /// Camera at origin with the given zoom.
    fn create(zoom: f32): Camera {
        return Camera {
            pos: Vec2 { x: 0, y: 0 },
            zoom: zoom,
        };
    }

    /// Map a world point to screen space.
    fn toScreen(this: Camera, world: Vec2): Vec2 {
        return (world - this.pos) * this.zoom;
    }

    /// Map a screen point to world space.
    fn toWorld(this: Camera, screen: Vec2): Vec2 {
        return screen * (1 / this.zoom) + this.pos;
    }

    /// Headless stand-in: sets `pos` to `focus` (no clamp).
    fn follow(this: &Camera, focus: Vec2, view: Vec2, map_w: f32, map_h: f32) {
        this.pos = focus;
    }
}
