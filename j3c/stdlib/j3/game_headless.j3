}

/// Emboldened measure. Same stand-in as `textSize`.
pub fn textSizeBold(font: Font, msg: string): Vec2 {
    return textSize(font, msg);
}

/// Emboldened bake (empty handle headless).
pub fn bakeTextBold(font: Font, msg: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Rasterize UTF-8 bytes to a texture (empty handle headless).
