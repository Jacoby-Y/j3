/// Rasterize UTF-8 text to a texture (empty handle headless).
pub fn bakeText(font: Font, msg: string): Texture {
    return Texture { raw: 0, w: 0, h: 0 };
}

/// Stand-in text size so layout math typechecks without SDL_ttf.
pub fn textSize(font: Font, msg: string): Vec2 {
    return textSizeBytes(font, []u8 { ptr: msg.ptr, len: msg.len });
}

/// Stand-in text size: `8` pixels per byte, `16` tall.
pub fn textSizeBytes(font: Font, msg: []u8): Vec2 {
    return Vec2 { x: f32(8 * msg.len), y: 16 };
}

