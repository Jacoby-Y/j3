    return false;
}

/// True on the frame `btn` went up (always false headless).
pub fn mouseReleased(btn: Mouse): bool {
    return false;
}

/// Mouse wheel delta this frame (always 0 headless).
pub fn mouseWheel(): f32 {
    return 0;
