// Part of j3.script: bytecode record types (Prop, Arg, Instr, Function, Module, ...) and the file Reader; the module doc and `use`s are in ../script.j3.
module j3.script;

/// One prop for `Vm.new`: the field name and the bytes to copy in.
pub struct Prop {
    name: string;
    value: ptr;
    size: int;
}

/// One argument for `Vm.call`: where the value is and how many bytes it has.
pub struct Arg {
    value: ptr;
    size: int;
}

struct Instr { op: u16; aux: u16; dst: u32; a: u32; b: u32; imm: u64; }
struct Param { reg: u32; offset: u32; size: u32; load: u32; }
struct CallArg { reg: u32; size: u32; aggregate: u32; }
struct CallSite {
    kind: u32; key: u64; index: u32; retSize: int; retLoad: u32; retAggregate: bool;
    args: []CallArg; argBytes: int; target: ptr; thunk: fn(ptr, ptr); linked: bool;
}
struct Field { name: string; offset: int; size: int; defaultBytes: []u8; defaultConst: int; }
struct Global { key: u64; name: string; data: ptr; size: int; }
struct Native { key: u64; name: string; }
struct Function {
    key: u64; name: string; signature: string; public: bool; owner: int;
    frameSize: int; regs: int; retSize: int; retAggregate: bool;
    params: []Param; calls: []CallSite; code: []Instr;
}
struct Module {
    name: string; path: string; layoutHash: u64; signatureHash: u64;
    instanceSize: int; propCount: int; fields: []Field; globals: []Global;
    constants: [][]u8; natives: []Native; functions: []Function;
}
struct FnSlot { key: u64; f: ptr; }
struct ThunkSlot { key: u64; call: fn(ptr, ptr); used: bool; }

struct Reader {
    base: int;
    at: int;
    end: int;

    fn need(this: &Reader, n: int) {
        if this.at + n > this.end { panic("script: truncated bytecode"); }
    }
    fn u16(this: &Reader): u16 { this.need(2); let v = ld16(this.at); this.at += 2; return v; }
    fn u32(this: &Reader): u32 { this.need(4); let v = ld32(this.at); this.at += 4; return v; }
    fn u64(this: &Reader): u64 { this.need(8); let v = ld64(this.at); this.at += 8; return v; }
    fn bytes(this: &Reader): []u8 {
        let n = this.u32() as int;
        this.need(n);
        let out: []u8 = @slice(this.at as ptr, n);
        this.at += n;
        return out;
    }
    fn text(this: &Reader): string { return this.bytes() as string; }
}
