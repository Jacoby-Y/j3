// Part of j3.script: the dispatch loop (`Vm.exec`); the module doc and `use`s are in ../script.j3. `Vm` methods in an `extend Vm` block.
module j3.script;

extend Vm {
    /// Run one function body. Returns a scalar result; an aggregate result is copied to
    /// `result`.
    fn exec(this: &Vm, f: &Function, regs: int, result: ptr): u64 {
        let code = f.code.ptr as int;
        let pc = 0;
        while true {
            let ins = ((code + pc * INSTR_BYTES) as ptr) as &Instr;
            pc += 1;
            let op = ins.op;
            if op == LD64 {
                wr(regs, ins.dst, ld64(rd(regs, ins.a) as int + ins.imm as int));
            } else if op == ST64 {
                st64(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b));
            } else if op == ADD {
                wr(regs, ins.dst, rd(regs, ins.a) + rd(regs, ins.b));
            } else if op == CONST {
                wr(regs, ins.dst, ins.imm);
            } else if op == MOV {
                wr(regs, ins.dst, rd(regs, ins.a));
            } else if op == JN_LTS {
                if (rd(regs, ins.a) as int) >= (rd(regs, ins.b) as int) { pc = ins.imm as int; }
            } else if op == JMP {
                pc = ins.imm as int;
            } else if op == JZ {
                if rd(regs, ins.a) == 0 { pc = ins.imm as int; }
            } else if op == LD32U {
                wr(regs, ins.dst, ld32(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST32 {
                st32(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u32);
            } else if op == FADD {
                wf(regs, ins.dst, rf(regs, ins.a) + rf(regs, ins.b));
            } else if op == FMUL {
                wf(regs, ins.dst, rf(regs, ins.a) * rf(regs, ins.b));
            } else if op == FSUB {
                wf(regs, ins.dst, rf(regs, ins.a) - rf(regs, ins.b));
            } else if op == SUB {
                wr(regs, ins.dst, rd(regs, ins.a) - rd(regs, ins.b));
            } else if op == MUL {
                wr(regs, ins.dst, rd(regs, ins.a) * rd(regs, ins.b));
            } else if op == ADDR {
                wr(regs, ins.dst, rd(regs, ins.a) + ins.imm);
            } else if op == IDX {
                wr(regs, ins.dst, rd(regs, ins.a) + rd(regs, ins.b) * ins.imm);
            } else if op == CALL {
                this.callSite(f, regs, ins);
            } else if op == RET {
                return 0;
            } else if op == RETV {
                return rd(regs, ins.a);
            } else if op == LD8U {
                wr(regs, ins.dst, ld8(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST8 {
                st8(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u8);
            } else if op == LD32S {
                wr(regs, ins.dst, (ld32(rd(regs, ins.a) as int + ins.imm as int) as i32) as int as u64);
            } else if op == JN_LES {
                if (rd(regs, ins.a) as int) > (rd(regs, ins.b) as int) { pc = ins.imm as int; }
            } else if op == JN_LTU {
                if rd(regs, ins.a) >= rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_LEU {
                if rd(regs, ins.a) > rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_EQ {
                if rd(regs, ins.a) != rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_NE {
                if rd(regs, ins.a) == rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_FLT {
                if !(rf(regs, ins.a) < rf(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_FLE {
                if !(rf(regs, ins.a) <= rf(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_DLT {
                if !(rdd(regs, ins.a) < rdd(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_DLE {
                if !(rdd(regs, ins.a) <= rdd(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JNZ {
                if rd(regs, ins.a) != 0 { pc = ins.imm as int; }
            } else if op == EQ {
                wb(regs, ins.dst, rd(regs, ins.a) == rd(regs, ins.b));
            } else if op == NE {
                wb(regs, ins.dst, rd(regs, ins.a) != rd(regs, ins.b));
            } else if op == LTS {
                wb(regs, ins.dst, (rd(regs, ins.a) as int) < (rd(regs, ins.b) as int));
            } else if op == LES {
                wb(regs, ins.dst, (rd(regs, ins.a) as int) <= (rd(regs, ins.b) as int));
            } else if op == LTU {
                wb(regs, ins.dst, rd(regs, ins.a) < rd(regs, ins.b));
            } else if op == LEU {
                wb(regs, ins.dst, rd(regs, ins.a) <= rd(regs, ins.b));
            } else if op == FDIV {
                wf(regs, ins.dst, rf(regs, ins.a) / rf(regs, ins.b));
            } else if op == FNEG {
                wf(regs, ins.dst, 0.0 - rf(regs, ins.a));
            } else if op == FEQ {
                wb(regs, ins.dst, rf(regs, ins.a) == rf(regs, ins.b));
            } else if op == FNE {
                wb(regs, ins.dst, rf(regs, ins.a) != rf(regs, ins.b));
            } else if op == FLT {
                wb(regs, ins.dst, rf(regs, ins.a) < rf(regs, ins.b));
            } else if op == FLE {
                wb(regs, ins.dst, rf(regs, ins.a) <= rf(regs, ins.b));
            } else if op == DADD {
                wd(regs, ins.dst, rdd(regs, ins.a) + rdd(regs, ins.b));
            } else if op == DSUB {
                wd(regs, ins.dst, rdd(regs, ins.a) - rdd(regs, ins.b));
            } else if op == DMUL {
                wd(regs, ins.dst, rdd(regs, ins.a) * rdd(regs, ins.b));
            } else if op == DDIV {
                wd(regs, ins.dst, rdd(regs, ins.a) / rdd(regs, ins.b));
            } else if op == DNEG {
                wd(regs, ins.dst, 0.0 - rdd(regs, ins.a));
            } else if op == DEQ {
                wb(regs, ins.dst, rdd(regs, ins.a) == rdd(regs, ins.b));
            } else if op == DNE {
                wb(regs, ins.dst, rdd(regs, ins.a) != rdd(regs, ins.b));
            } else if op == DLT {
                wb(regs, ins.dst, rdd(regs, ins.a) < rdd(regs, ins.b));
            } else if op == DLE {
                wb(regs, ins.dst, rdd(regs, ins.a) <= rdd(regs, ins.b));
            } else if op == DIVS {
                wr(regs, ins.dst, ((rd(regs, ins.a) as int) / (rd(regs, ins.b) as int)) as u64);
            } else if op == REMS {
                wr(regs, ins.dst, ((rd(regs, ins.a) as int) % (rd(regs, ins.b) as int)) as u64);
            } else if op == DIVU {
                wr(regs, ins.dst, rd(regs, ins.a) / rd(regs, ins.b));
            } else if op == REMU {
                wr(regs, ins.dst, rd(regs, ins.a) % rd(regs, ins.b));
            } else if op == NEG {
                wr(regs, ins.dst, 0 - rd(regs, ins.a));
            } else if op == NOT {
                wb(regs, ins.dst, rd(regs, ins.a) == 0);
            } else if op == LAND {
                wb(regs, ins.dst, rd(regs, ins.a) != 0 && rd(regs, ins.b) != 0);
            } else if op == LOR {
                wb(regs, ins.dst, rd(regs, ins.a) != 0 || rd(regs, ins.b) != 0);
            } else if op == BAND {
                wr(regs, ins.dst, rd(regs, ins.a) & rd(regs, ins.b));
            } else if op == BOR {
                wr(regs, ins.dst, rd(regs, ins.a) | rd(regs, ins.b));
            } else if op == BXOR {
                wr(regs, ins.dst, rd(regs, ins.a) ^ rd(regs, ins.b));
            } else if op == BNOT {
                wr(regs, ins.dst, ~rd(regs, ins.a));
            } else if op == SEXT8 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i8) as int as u64);
            } else if op == SEXT16 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i16) as int as u64);
            } else if op == SEXT32 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i32) as int as u64);
            } else if op == ZEXT8 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u8) as u64);
            } else if op == ZEXT16 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u16) as u64);
            } else if op == ZEXT32 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u32) as u64);
            } else if op == LD8S {
                wr(regs, ins.dst, (ld8(rd(regs, ins.a) as int + ins.imm as int) as i8) as int as u64);
            } else if op == LD16S {
                wr(regs, ins.dst, (ld16(rd(regs, ins.a) as int + ins.imm as int) as i16) as int as u64);
            } else if op == LD16U {
                wr(regs, ins.dst, ld16(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST16 {
                st16(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u16);
            } else if op == COPY {
                copyBytes(rd(regs, ins.a) as int, rd(regs, ins.b) as int, ins.imm as int);
            } else if op == STR {
                st64(rd(regs, ins.a) as int, ins.imm);
                st64(rd(regs, ins.a) as int + 8, ins.b as u64);
            } else if op == I2F {
                wf(regs, ins.dst, (rd(regs, ins.a) as int) as f32);
            } else if op == U2F {
                wf(regs, ins.dst, rd(regs, ins.a) as f32);
            } else if op == F2I {
                wr(regs, ins.dst, (rf(regs, ins.a) as int) as u64);
            } else if op == F2U {
                wr(regs, ins.dst, rf(regs, ins.a) as u64);
            } else if op == I2D {
                wd(regs, ins.dst, (rd(regs, ins.a) as int) as f64);
            } else if op == U2D {
                wd(regs, ins.dst, rd(regs, ins.a) as f64);
            } else if op == D2I {
                wr(regs, ins.dst, (rdd(regs, ins.a) as int) as u64);
            } else if op == D2U {
                wr(regs, ins.dst, rdd(regs, ins.a) as u64);
            } else if op == F2D {
                wd(regs, ins.dst, rf(regs, ins.a) as f64);
            } else if op == D2F {
                wf(regs, ins.dst, rdd(regs, ins.a) as f32);
            } else if op == RETA {
                if result as int != 0 {
                    copyBytes(result as int, rd(regs, ins.a) as int, ins.imm as int);
                }
                return 0;
            } else if op == APP_LIT {
                append(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, ins.imm as int, ins.b as int);
            } else if op == APP_STR {
                appendStr(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) as int);
            } else if op == APP_INT {
                appendInt(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) as int);
            } else if op == APP_F64 {
                appendF64(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rdd(regs, ins.b));
            } else if op == APP_BOOL {
                appendBool(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) != 0);
            } else if op == ABORT || op == DIV0 {
                exit(1);
            } else {
                panic("script: bad opcode; rerun j3c");
            }
        }
        return 0;
    }
}
