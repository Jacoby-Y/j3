// Part of j3.script: raw memory helpers (register and byte loads/stores, file reads, append); the module doc and `use`s are in ../script.j3.
module j3.script;

#[singleton]
let STAMP_BUF: [160]u8;

fn readStamp(path: string): int {
    if path.len >= 127 { return 0; }
    let base = &STAMP_BUF[0] as ptr as int;
    copyBytes(base, path.ptr as int, path.len);
    st8(base + path.len, 0);
    let fd = open(base as ptr, O_RDONLY);
    if fd < 0 { return 0; }
    let n = read(fd, (base + 128) as ptr, 31);
    close(fd);
    let value = 0;
    for i in 0..n {
        let c = ld8(base + 128 + i) as int;
        if c >= 48 && c <= 57 { value = value * 10 + (c - 48); }
    }
    return value;
}

fn readFile(arena: &Arena, path: string): []u8 {
    let cpath = arena.alloc::<u8>(path.len + 1);
    copyBytes(cpath.ptr as int, path.ptr as int, path.len);
    cpath[path.len] = 0;
    let fd = open(cpath.ptr as ptr, O_RDONLY);
    if fd < 0 {
        printLn(`script: cannot open {path}`);
        panic("script: missing bytecode; run the program with `j3c run`");
    }
    let size = lseek(fd, 0, SEEK_END);
    if size < 0 { panic("script: cannot size bytecode"); }
    lseek(fd, 0, SEEK_SET);
    let base = alignedAlloc(arena, size) as int;
    let done = 0;
    while done < size {
        let n = read(fd, (base + done) as ptr, size - done);
        if n <= 0 { panic("script: cannot read bytecode"); }
        done += n;
    }
    close(fd);
    let out: []u8 = @slice(base as ptr, size);
    return out;
}

/// `size` bytes at an 8-aligned address (`allocBytes` aligns).
fn alignedAlloc(arena: &Arena, size: int): ptr {
    return arena.allocBytes(size);
}

/// Append bytes to an interpolation buffer, like native code does (abort past the cap).
fn append(buf: int, used: int, src: int, n: int) {
    let have = ld64(used) as int;
    if have + n > INTERP_CAP { exit(1); }
    copyBytes(buf + have, src, n);
    st64(used, (have + n) as u64);
}

fn appendStr(buf: int, used: int, s: int) { append(buf, used, ld64(s) as int, ld64(s + 8) as int); }
fn appendInt(buf: int, used: int, v: int) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }
fn appendF64(buf: int, used: int, v: f64) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }
fn appendBool(buf: int, used: int, v: bool) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }

fn rd(regs: int, i: u32): u64 { let p = ((regs + (i as int) * 8) as ptr) as &u64; return *p; }
fn wr(regs: int, i: u32, v: u64) { let p = ((regs + (i as int) * 8) as ptr) as &u64; *p = v; }
fn wb(regs: int, i: u32, v: bool) { if v { wr(regs, i, 1); } else { wr(regs, i, 0); } }
fn rf(regs: int, i: u32): f32 { let p = ((regs + (i as int) * 8) as ptr) as &f32; return *p; }
fn wf(regs: int, i: u32, v: f32) { let p = ((regs + (i as int) * 8) as ptr) as &f32; *p = v; }
fn rdd(regs: int, i: u32): f64 { let p = ((regs + (i as int) * 8) as ptr) as &f64; return *p; }
fn wd(regs: int, i: u32, v: f64) { let p = ((regs + (i as int) * 8) as ptr) as &f64; *p = v; }

fn ld8(at: int): u8 { let p = (at as ptr) as &u8; return *p; }
fn ld16(at: int): u16 { let p = (at as ptr) as &u16; return *p; }
fn ld32(at: int): u32 { let p = (at as ptr) as &u32; return *p; }
fn ld64(at: int): u64 { let p = (at as ptr) as &u64; return *p; }
fn st8(at: int, v: u8) { let p = (at as ptr) as &u8; *p = v; }
fn st16(at: int, v: u16) { let p = (at as ptr) as &u16; *p = v; }
fn st32(at: int, v: u32) { let p = (at as ptr) as &u32; *p = v; }
fn st64(at: int, v: u64) { let p = (at as ptr) as &u64; *p = v; }

/// Store the low `size` bytes of a register value.
fn storeN(at: int, v: u64, size: int) {
    if size == 8 { st64(at, v); }
    else if size == 4 { st32(at, v as u32); }
    else if size == 2 { st16(at, v as u16); }
    else if size == 1 { st8(at, v as u8); }
    else { panic("script: odd scalar size"); }
}

/// Load a scalar from memory into register form with the given load opcode.
fn loadAs(at: int, op: u32): u64 {
    let code = op as u16;
    if code == LD8S { return (ld8(at) as i8) as int as u64; }
    if code == LD8U { return ld8(at) as u64; }
    if code == LD16S { return (ld16(at) as i16) as int as u64; }
    if code == LD16U { return ld16(at) as u64; }
    if code == LD32S { return (ld32(at) as i32) as int as u64; }
    if code == LD32U { return ld32(at) as u64; }
    return ld64(at);
}

fn copyBytes(dst: int, src: int, n: int) {
    let i = 0;
    while i + 8 <= n {
        st64(dst + i, ld64(src + i));
        i += 8;
    }
    while i < n {
        st8(dst + i, ld8(src + i));
        i += 1;
    }
}

fn clearBytes(at: int, n: int) {
    let i = 0;
    while i + 8 <= n {
        st64(at + i, 0);
        i += 8;
    }
    while i < n {
        st8(at + i, 0);
        i += 1;
    }
}

fn clearWords(at: int, n: int) {
    clearBytes(at, n);
}
