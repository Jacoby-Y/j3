// Part of j3.script (Vm create/destroy, native and function tables); the module doc and `use`s are in ../script.j3. `Vm` methods in an `extend Vm` block.
module j3.script;

extend Vm {
    fn create(arenaBytes: int, stackBytes: int): Vm {
        let header = mmapAnon(@sizeof(Arena));
        if header as int == 0 { panic("script: cannot allocate the VM arena"); }
        let slot: []Arena = @slice(header, 1);
        slot[0] = Arena.create(arenaBytes);
        let arena = &slot[0];
        let fnSlots = arena.alloc::<FnSlot>(TABLE_SLOTS);
        let thunkSlots = arena.alloc::<ThunkSlot>(TABLE_SLOTS);
        clearBytes(fnSlots.ptr as int, TABLE_SLOTS * @sizeof(FnSlot));
        clearBytes(thunkSlots.ptr as int, TABLE_SLOTS * @sizeof(ThunkSlot));
        let stack = alignedAlloc(arena, stackBytes);
        return Vm { arena: arena, stackBase: stack as int, stackCap: stackBytes, top: 0,
                    modules: arena.alloc::<Module>(MAX_MODULES), loaded: 0, fnSlots: fnSlots,
                    thunkSlots: thunkSlots, reloadStamp: 0 };
    }

    fn destroy(this: &Vm) {
        this.arena.destroy();
        munmap(this.arena as ptr, @sizeof(Arena));
        this.loaded = 0;
        this.top = 0;
    }

    /// Link a native function a script may call. `key` is the one `j3c` gives it.
    fn register(this: &Vm, key: u64, call: fn(ptr, ptr)) {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.thunkSlots[i];
            if !slot.used || slot.key == key {
                slot.key = key;
                slot.call = call;
                slot.used = true;
                return;
            }
            i = (i + 1) % TABLE_SLOTS;
        }
        panic("script: thunk table full");
    }

    fn thunk(this: &Vm, key: u64): int {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.thunkSlots[i];
            if !slot.used { return 0 - 1; }
            if slot.key == key { return i; }
            i = (i + 1) % TABLE_SLOTS;
        }
        return 0 - 1;
    }

    fn addFunction(this: &Vm, f: &Function) {
        let i = slotOf(f.key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.fnSlots[i];
            if slot.f as int == 0 || slot.key == f.key {
                slot.key = f.key;
                slot.f = f as ptr;
                return;
            }
            i = (i + 1) % TABLE_SLOTS;
        }
        panic("script: function table full");
    }

    fn function(this: &Vm, key: u64): ptr {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.fnSlots[i];
            if slot.f as int == 0 { return 0 as ptr; }
            if slot.key == key { return slot.f; }
            i = (i + 1) % TABLE_SLOTS;
        }
        return 0 as ptr;
    }

    /// The key of a function in a loaded script, by name.
    fn methodKey(this: &Vm, moduleId: int, name: string): u64 {
        let m = this.moduleAt(moduleId);
        for i in 0..m.functions.len {
            if same(m.functions[i].name, name) { return m.functions[i].key; }
        }
        panic("script: no function with that name");
        return 0;
    }

    fn moduleAt(this: &Vm, moduleId: int): &Module {
        if moduleId < 0 || moduleId >= this.loaded { panic("script: invalid module id"); }
        return &this.modules[moduleId];
    }
}
