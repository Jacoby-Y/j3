/// Comparison and hashing traits (`Eq`, `Ord`, `Hash`, `Clone`; `#[derive(..)]` writes them field by field) with `#[impl]` hashes for the primitives and `string`,
/// plus generic helpers (`contains`, `indexOf`, `minOf`, `maxOf`, `hashOf`) and stable sorting (`sort`, `sortBy`). A type meets a trait by having the
/// method (`j3c doc lang`, "Traits"); ints, floats, bools, strings and C-like enums already meet `Eq`, and
/// ints, floats and strings (byte order) meet `Ord`. Hash values are 64-bit and well mixed: use the low bits freely.
/// Any thread: no module state (sorting borrows this thread's `j3.memory` scratch arena and rewinds it).

module j3.cmp;

use j3.memory.scratch;

/// Equality: `a == b` (and `!=`). Meet it with `fn operator==(this: T, other: T): bool`.
pub trait Eq { fn operator==(this: Self, other: Self): bool; }

/// Order: `a < b` (and `>`, `<=`, `>=` through it). Meet it with `fn operator<(this: T, other: T): bool`.
/// A supertrait of `Eq`: a type meeting `Ord` also has `==`.
pub trait Ord: Eq { fn operator<(this: Self, other: Self): bool; }

/// Hash: equal values must hash equal. Meet it with `fn hash(this: &T): u64` or `#[impl] fn hash(x: T): u64`.
pub trait Hash { fn hash(this: Self): u64; }

/// A copy: `fn clone(this: &T): T`. `#[derive(Clone)]` writes it (J3 values copy by value).
pub trait Clone { fn clone(this: Self): Self; }

/// Spread the bits of `x` (splitmix64 finalizer): sequential inputs give unrelated outputs.
pub fn mix(x: u64): u64 {
    let z = x + u64(-7046029254386353131);
    z = (z ^ (z >> u64(30))) * u64(-4658895280553007687);
    z = (z ^ (z >> u64(27))) * u64(-7723592293110705685);
    return z ^ (z >> u64(31));
}

/// Fold hash `b` into `a`, order-sensitive. For a struct: `combine(hashOf(this.x), hashOf(this.y))`.
pub fn combine(a: u64, b: u64): u64 {
    return mix(a ^ (b + u64(-7046029254386353131) + (a << u64(6)) + (a >> u64(2))));
}

#[impl]
pub fn hash(x: int): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: i32): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u32): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u8): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u64): u64 { return mix(x); }
#[impl]
pub fn hash(x: bool): u64 { if x { return mix(u64(1)); } return mix(u64(0)); }

/// Bit pattern of `x`, with `-0.0` folded into `0.0` so equal floats hash equal.
fn bits64(x: f64): u64 {
    if x == 0.0 { return u64(0); }
    let b = x;
    let p: []u64 = @slice(&b as ptr, 1);
    return p[0];
}

#[impl]
pub fn hash(x: f64): u64 { return mix(bits64(x)); }
#[impl]
pub fn hash(x: f32): u64 { return mix(bits64(f64(x))); }

/// FNV-1a over the bytes, then `mix` (FNV alone leaves weak low bits).
#[impl]
pub fn hash(s: string): u64 {
    let h = u64(-3750763034362895579);
    for i in 0..s.len {
        h = (h ^ u64(s[i])) * u64(1099511628211);
    }
    return mix(h);
}

/// Byte-wise (UTF-8 code point) order, so `string` meets `Ord`: `sort` of names, `Map.sortedKeys`.
#[impl]
pub fn operator<(a: string, b: string): bool {
    let n = if a.len < b.len { a.len } else { b.len };
    for i in 0..n {
        if a[i] != b[i] { return a[i] < b[i]; }
    }
    return a.len < b.len;
}

/// Hash of any value that meets `Hash`.
pub fn hashOf<T: Hash>(x: T): u64 { return x.hash(); }

/// True when some element of `xs` equals `x`.
pub fn contains<T: Eq>(xs: []T, x: T): bool { return indexOf(xs, x) >= 0; }

/// Index of the first element equal to `x`, or -1.
pub fn indexOf<T: Eq>(xs: []T, x: T): int {
    for i in 0..xs.len {
        if xs[i] == x { return i; }
    }
    return -1;
}

/// The smaller of `a` and `b` (`a` when equal).
pub fn minOf<T: Ord>(a: T, b: T): T { if b < a { return b; } return a; }

/// The larger of `a` and `b` (`a` when equal).
pub fn maxOf<T: Ord>(a: T, b: T): T { if a < b { return b; } return a; }

/// Sort `xs` ascending by `<`, stable (equal elements keep their order). O(n log n).
pub fn sort<T: Ord>(xs: []T) {
    sortBy(xs, fn(a: T, b: T): bool { return a < b; });
}

/// Elements per insertion-sorted run before merging.
const RUN: int = 16;

/// Sort `xs` so that `less(a, b)` never holds for a later `a` and earlier `b`. Stable: equal elements
/// (neither `less`) keep their order, so sorted output is deterministic. Merge sort, O(n log n); the merge
/// buffer comes from this thread's scratch arena and is given back before returning (`less` must not keep
/// scratch memory it allocates).
pub fn sortBy<T>(xs: []T, less: closure(T, T): bool) {
    let n = xs.len;
    let s = 0;
    while s < n {
        let e = if s + RUN < n { s + RUN } else { n };
        for i in s + 1..e {
            let v = xs[i];
            let j = i;
            while j > s && less(v, xs[j - 1]) {
                xs[j] = xs[j - 1];
                j -= 1;
            }
            xs[j] = v;
        }
        s = e;
    }
    if n <= RUN { return; }
    let a = scratch(1 << 16);
    let mark = a.checkpoint();
    let src = xs;
    let dst = a.alloc::<T>(n);
    let inXs = true;
    let w = RUN;
    while w < n {
        let lo = 0;
        while lo < n {
            let mid = if lo + w < n { lo + w } else { n };
            let hi = if mid + w < n { mid + w } else { n };
            let i = lo;
            let j = mid;
            let k = lo;
            while i < mid && j < hi {
                // Right only when strictly smaller: ties take the left, which keeps the sort stable.
                if less(src[j], src[i]) {
                    dst[k] = src[j];
                    j += 1;
                } else {
                    dst[k] = src[i];
                    i += 1;
                }
                k += 1;
            }
            while i < mid { dst[k] = src[i]; i += 1; k += 1; }
            while j < hi { dst[k] = src[j]; j += 1; k += 1; }
            lo = hi;
        }
        let t = src;
        src = dst;
        dst = t;
        inXs = !inXs;
        w *= 2;
    }
    if !inXs {
        for i in 0..n { xs[i] = src[i]; }
    }
    a.rewind(mark);
}
