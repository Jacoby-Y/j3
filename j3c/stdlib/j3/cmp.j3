/// Comparison and hashing traits (`Eq`, `Ord`, `Hash`) with `#[impl]` hashes for the primitives and `string`,
/// plus generic helpers (`contains`, `indexOf`, `minOf`, `maxOf`, `hashOf`). A type meets a trait by having the
/// method (`j3c doc lang`, "Traits"); ints, floats, bools, strings and C-like enums already meet `Eq`, and
/// ints and floats meet `Ord`. Hash values are 64-bit and well mixed: use the low bits freely.
/// Any thread: no module state.

module j3.cmp;

/// Equality: `a == b` (and `!=`). Meet it with `fn operator==(this: T, other: T): bool`.
pub trait Eq { fn operator==(this: Self, other: Self): bool; }

/// Order: `a < b` (and `>`, `<=`, `>=` through it). Meet it with `fn operator<(this: T, other: T): bool`.
pub trait Ord { fn operator<(this: Self, other: Self): bool; }

/// Hash: equal values must hash equal. Meet it with `fn hash(this: &T): u64` or `#[impl] fn hash(x: T): u64`.
pub trait Hash { fn hash(this: Self): u64; }

/// Spread the bits of `x` (splitmix64 finalizer): sequential inputs give unrelated outputs.
pub fn mix(x: u64): u64 {
    let z = x + u64(-7046029254386353131);
    z = (z ^ (z >> u64(30))) * u64(-4658895280553007687);
    z = (z ^ (z >> u64(27))) * u64(-7723592293110705685);
    return z ^ (z >> u64(31));
}

/// Fold hash `b` into `a`, order-sensitive. For a struct: `combine(hashOf(this.x), hashOf(this.y))`.
pub fn combine(a: u64, b: u64): u64 {
    return mix(a ^ (b + u64(-7046029254386353131) + (a << u64(6)) + (a >> u64(2))));
}

#[impl]
pub fn hash(x: int): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: i32): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u32): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u8): u64 { return mix(u64(x)); }
#[impl]
pub fn hash(x: u64): u64 { return mix(x); }
#[impl]
pub fn hash(x: bool): u64 { if x { return mix(u64(1)); } return mix(u64(0)); }

/// Bit pattern of `x`, with `-0.0` folded into `0.0` so equal floats hash equal.
fn bits64(x: f64): u64 {
    if x == 0.0 { return u64(0); }
    let b = x;
    let p: []u64 = @slice(&b as ptr, 1);
    return p[0];
}

#[impl]
pub fn hash(x: f64): u64 { return mix(bits64(x)); }
#[impl]
pub fn hash(x: f32): u64 { return mix(bits64(f64(x))); }

/// FNV-1a over the bytes, then `mix` (FNV alone leaves weak low bits).
#[impl]
pub fn hash(s: string): u64 {
    let h = u64(-3750763034362895579);
    for i in 0..s.len {
        h = (h ^ u64(s[i])) * u64(1099511628211);
    }
    return mix(h);
}

/// Hash of any value that meets `Hash`.
pub fn hashOf<T: Hash>(x: T): u64 { return x.hash(); }

/// True when some element of `xs` equals `x`.
pub fn contains<T: Eq>(xs: []T, x: T): bool { return indexOf(xs, x) >= 0; }

/// Index of the first element equal to `x`, or -1.
pub fn indexOf<T: Eq>(xs: []T, x: T): int {
    for i in 0..xs.len {
        if xs[i] == x { return i; }
    }
    return -1;
}

/// The smaller of `a` and `b` (`a` when equal).
pub fn minOf<T: Ord>(a: T, b: T): T { if b < a { return b; } return a; }

/// The larger of `a` and `b` (`a` when equal).
pub fn maxOf<T: Ord>(a: T, b: T): T { if a < b { return b; } return a; }
