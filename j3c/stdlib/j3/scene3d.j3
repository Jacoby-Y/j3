/// Editable, hierarchical 3D scene data. Paths are relative to the project root.
/// Main thread only: scene and GL state is not thread-safe (`j3c doc threads`).

module j3.scene3d;

use lib "c" as libc {
    fn rename(old: cstr, new: cstr): i32;
}

use j3.gfx;
use j3.gfx.{ Look, Mesh, Tex, Ray, RayHit, Surface, Traced, LIGHTS };
use j3.game;
use j3.game.Rgba;
use j3.io;
use j3.result.Result;
use j3.math.{ Mat4, Vec3, PI, TAU, abs, cos, max, min, sin, sqrt };
use j3.memory.{ Arena, scratch };
use j3.gfx.mesh;
use j3.gfx.meshgen;
use j3.gfx.noise;
use j3.gfx.bvh;
use j3.gfx.bvh.Bvh;
use j3.gfx.{ FxParam, FX_FLOAT, FX_BOOL, FX_COLOR, fxWidth };
use j3.scene3d.fx;
use j3.scene3d.fx.FxFile;
use j3.gfx.noise.{ Noise, Ramp, PERLIN, FBM, NEAREST };
use j3.data.save;
use j3.data.save.Save;
use j3.text.{ Text, same };
use j3.sys.panic;

pub const GROUP: int = 0;
pub const MESH: int = 1;
pub const CAMERA: int = 2;
/// Places another scene file (`Node.scene`) under this node. `load` adds that scene's
/// objects as children with `owner` set; `store` leaves them out.
pub const INSTANCE: int = 3;
/// A point light: `color`, and `range` in world units. `lights` feeds the first eight to gfx.
pub const LIGHT: int = 4;

/// `Node.alpha` values.
pub const OPAQUE: int = 0;
pub const CUTOUT: int = 1;
pub const BLEND: int = 2;

/// Instances nested deeper than this are skipped.
pub const NEST: int = 8;

/// First id given to objects added from placed scenes. They count up from here on every
/// load, so the same files always give the same ids and the saved `nextId` never moves.
pub const GRAFT: int = 1099511627776;

/// Stable id, local transform, asset paths, and the script attached to it (if any).
pub struct Node {
    id: int;
    parent: int;
    kind: int;
    name: string;
    asset: string;
    texture: string;
    /// Script attached in the editor (`scripts/door.j3s`), or "". `j3.scene3d.scripts`
    /// makes its instances.
    script: string;
    doubleSided: bool;
    position: Vec3;
    rotation: Vec3;
    scale: Vec3;
    fov: f32;
    near: f32;
    far: f32;
    gpu: Mesh;
    image: Tex;
    boundLo: Vec3;
    boundHi: Vec3;
    /// Scene file an `INSTANCE` node places.
    scene: string;
    /// For objects added from an instanced scene, the id of the instance node in this
    /// scene that brought them in. `0` for the scene's own objects.
    owner: int;
    /// An `INSTANCE` whose scene file, or a `MESH` whose mesh or texture file, could not be read.
    missing: bool;
    /// Children hidden in an editor's hierarchy. Not saved.
    collapsed: bool;
    /// `LIGHT` color (1 is full brightness) and reach.
    color: Vec3;
    /// `MESH`/`INSTANCE` color multiplier, 1 = unchanged (above 1 brightens); on an
    /// instance it multiplies everything it places.
    tint: Vec3;
    range: f32;
    /// `MESH` transparency: `OPAQUE`, `CUTOUT` (texture alpha under 0.5 is a hole), or
    /// `BLEND` (see-through by `opacity` times texture alpha).
    alpha: int;
    opacity: f32;
    /// `MESH` material file (`.j3mat`): tint, glow, and a texture or generated noise. It
    /// replaces `texture` when set. `mat` is its slot in the loaded materials, plus one.
    material: string;
    mat: int;
    /// For a placed object, its id in the file it came from; `0` otherwise.
    source: int;
    /// For a placed object, the ids leading to it from its placed copy (`owner`): its id in
    /// that copy's file, or `<id>/<id>/...` through scenes nested deeper. `override` keys on
    /// it; "" otherwise.
    sourcePath: string;
    /// An `INSTANCE` whose placed objects an editor lists and lets you edit. Not saved.
    editable: bool;
    /// `CAMERA` effect files (`kind=camera` `.j3fx`), `|`-separated, run in order over what
    /// it sees. Their params are `fx.<file stem>.<name>` in the param table.
    effects: string;
    /// Comma-separated tags a game reads instead of name prefixes: `nocollide`, or
    /// `launch=30` with a value. See `hasTag` and `tagValue`.
    tags: string;
    /// A comment kept with the object: the `//` lines above it in the file, joined by newlines.
    note: string;
}

/// A handle to one object: its stable id. A script prop of this type is set in the editor
/// by picking an object (`param.<id>.<prop> r=<target id>`); `scene.node(handle)` reads it.
pub struct NodeId {
    id: int;
}

/// Scene-wide lighting, stored as `scene.env.*` lines so undo and the file keep it.
pub struct Env {
    /// Direction toward the sun.
    sunDir: Vec3;
    sunColor: Vec3;
    /// Sky, fog, and ambient color.
    sky: Vec3;
    fogStart: f32;
    fogEnd: f32;
    shadows: bool;
    /// Half size of the box around the origin that casts sun shadows.
    shadowSize: f32;
    /// URP: mirrors and glass trace real rays through the scene. `bounces` surfaces a ray
    /// follows, `samples` rays a pixel on rough or glass surfaces, and traced sun shadows
    /// at the surfaces rays hit (else the shadow map).
    urp: bool;
    bounces: int;
    samples: int;
    tracedShadows: bool;
    /// Traced sun shadows reach this far from the eye; the shadow map covers the rest (0: no limit).
    traceNear: f32 = 40;
}

/// One script prop (or effect param) value in a scene's parameter table (`Scene.params`).
pub struct ParamEntry {
    id: int;
    field: string;
    /// 0 is integer/bool, 1 is float, 2 is string.
    kind: int;
    value: []u8;
    cap: int;
    changed: bool;
}

fn emptyParam(): ParamEntry {
    return ParamEntry { id: 0, field: "", kind: 0,
        value: []u8 { ptr: 0 as &u8, len: 0 }, cap: 0, changed: false };
}

/// A scene owns its nodes and editable key/value data in `arena`.
/// Code outside this module that rewrites `nodes` or `len` directly must call `relink`.
pub struct Scene {
    nodes: []Node;
    len: int;
    nextId: int;
    data: Save;
    arena: &Arena;
    placedData: Save;
    params: []ParamEntry;
    paramCount: int;
    paramsData: ptr;
    paramsLen: int;
    paramsDirty: bool;
    paramsPlacedData: ptr;
    paramsPlacedLen: int;
    placedDirty: bool;
    /// Expanded scene file text and placed-node strings are replaced on refresh.
    placed: &Arena;
    /// Id lookup table: open addressing, each entry a slot + 1 (0 is empty).
    slots: []int;
    /// `nodes[0..linked]` are in `slots`.
    linked: int;
    /// Next id for an object added from a placed scene.
    grafted: int;
    /// The file `read` came from existed.
    found: bool;
    /// Placed scenes went more than `NEST` levels deep; the deeper ones were left out.
    tooDeep: bool;
    /// The first thing `read` could not make sense of in a v2 file (`line 12: ...`), or "".
    /// `store` refuses to overwrite a file whose last read had one.
    parseError: string;
    /// The first placed scene (at any depth) that turns URP on, "" for none, and the
    /// strongest URP settings among placed scenes.
    urpChild: string;
    childUrp: Env;
    /// Per node slot, how far `drawWith` pulls it toward the camera in depth (0 for none):
    /// the smaller of two objects with faces on one plane. See `flushScan`.
    flush: []f32;
    /// Where the objects stood when `flush` was last worked out, how many frames they have
    /// stood still, and whether they moved since.
    flushSig: f32;
    flushStill: int;
    flushStale: bool;

    /// The object `handle` names. Panics when it isn't in the scene.
    fn node(this: &Scene, handle: NodeId): &Node {
        let at = index(this, handle.id);
        if at < 0 { panic("scene3d: no object with that id"); }
        return &this.nodes[at];
    }

    /// The object at `path`: a name (`"Door"`, the first object with it) or a
    /// `Parent/Child` path from the top. `NodeId { id: 0 }` when nothing matches.
    fn find(this: &Scene, path: string): NodeId {
        let slash = false;
        for i in 0..path.len { if path[i] == 47 { slash = true; } }
        if !slash {
            for i in 0..this.len {
                if same(this.nodes[i].name, path) { return NodeId { id: this.nodes[i].id }; }
            }
            return NodeId { id: 0 };
        }
        let parent = 0;
        let start = 0;
        while start <= path.len {
            let end = start;
            while end < path.len && path[end] != 47 { end += 1; }
            let part = path[start..end];
            let next = 0;
            for i in 0..this.len {
                if this.nodes[i].parent == parent && same(this.nodes[i].name, part) {
                    next = this.nodes[i].id;
                    break;
                }
            }
            if next == 0 { return NodeId { id: 0 }; }
            parent = next;
            start = end + 1;
        }
        return NodeId { id: parent };
    }
}

fn key(i: int, field: string, arena: &Arena): string {
    let t = Text.new(arena);
    t.pushStr("node.");
    t.pushInt(i);
    t.push(46);
    t.pushStr(field);
    return t.str();
}

/// A node with default fields.
fn blank(id: int): Node {
    return Node {
        id: id,
        parent: 0,
        kind: GROUP,
        name: "Object",
        asset: "",
        texture: "",
        script: "",
        doubleSided: false,
        position: Vec3.xyz(0, 0, 0),
        rotation: Vec3.xyz(0, 0, 0),
        scale: Vec3.xyz(1, 1, 1),
        fov: 60,
        near: 0.15,
        far: 200,
        gpu: Mesh {},
        image: Tex { id: 0, w: 0, h: 0 },
        boundLo: Vec3.xyz(-0.5, -0.5, -0.5),
        boundHi: Vec3.xyz(0.5, 0.5, 0.5),
        scene: "",
        owner: 0,
        missing: false,
        collapsed: false,
        color: Vec3.xyz(1, 0.9, 0.75),
        tint: Vec3.xyz(1, 1, 1),
        range: 8,
        alpha: OPAQUE,
        opacity: 1,
        material: "",
        mat: 0,
        source: 0,
        sourcePath: "",
        editable: false,
        effects: "",
        tags: "",
        note: "",
    };
}
