/// Editable, hierarchical 3D scene data. Paths are relative to the project root.
/// Main thread only: scene and GL state is not thread-safe (`j3c doc threads`).

module j3.scene3d;

use lib "c" as libc {
    fn rename(old: cstr, new: cstr): i32;
}

use j3.gfx;
use j3.gfx.{ Look, Mesh, Tex, Ray, RayHit, Surface, Traced, LIGHTS };
use j3.game;
use j3.game.Rgba;
use j3.io;
use j3.result.Result;
use j3.math.{ Mat4, Vec3, PI, TAU, abs, cos, max, min, sin, sqrt };
use j3.memory.{ Arena, scratch };
use j3.gfx.mesh;
use j3.gfx.meshgen;
use j3.gfx.noise;
use j3.gfx.bvh;
use j3.gfx.bvh.Bvh;
use j3.gfx.{ FxParam, FX_FLOAT, FX_BOOL, FX_COLOR, fxWidth };
use j3.scene3d.fx;
use j3.scene3d.fx.FxFile;
use j3.gfx.noise.{ Noise, Ramp, PERLIN, FBM, NEAREST };
use j3.data.save;
use j3.data.save.Save;
use j3.text.{ Text, same };
use j3.sys.panic;

pub const GROUP: int = 0;
pub const MESH: int = 1;
pub const CAMERA: int = 2;
/// Places another scene file (`Node.scene`) under this node. `load` adds that scene's
/// objects as children with `owner` set; `store` leaves them out.
pub const INSTANCE: int = 3;
/// A point light: `color`, and `range` in world units. `lights` feeds the first eight to gfx.
pub const LIGHT: int = 4;

/// `Node.alpha` values.
pub const OPAQUE: int = 0;
pub const CUTOUT: int = 1;
pub const BLEND: int = 2;

/// Instances nested deeper than this are skipped.
pub const NEST: int = 8;

/// First id given to objects added from placed scenes. They count up from here on every
/// load, so the same files always give the same ids and the saved `nextId` never moves.
pub const GRAFT: int = 1099511627776;

/// Stable id, local transform, asset paths, and the script attached to it (if any).
pub struct Node {
    id: int;
    parent: int;
    kind: int;
    name: string;
    asset: string;
    texture: string;
    /// Script attached in the editor (`scripts/door.j3s`), or "". `j3.scene3d.scripts`
    /// makes its instances.
    script: string;
    doubleSided: bool;
    position: Vec3;
    rotation: Vec3;
    scale: Vec3;
    fov: f32;
    near: f32;
    far: f32;
    gpu: Mesh;
    image: Tex;
    boundLo: Vec3;
    boundHi: Vec3;
    /// Scene file an `INSTANCE` node places.
    scene: string;
    /// For objects added from an instanced scene, the id of the instance node in this
    /// scene that brought them in. `0` for the scene's own objects.
    owner: int;
    /// An `INSTANCE` whose scene file, or a `MESH` whose mesh or texture file, could not be read.
    missing: bool;
    /// Children hidden in an editor's hierarchy. Not saved.
    collapsed: bool;
    /// `LIGHT` color (1 is full brightness) and reach.
    color: Vec3;
    /// `MESH`/`INSTANCE` color multiplier, 1 = unchanged (above 1 brightens); on an
    /// instance it multiplies everything it places.
    tint: Vec3;
    range: f32;
    /// `MESH` transparency: `OPAQUE`, `CUTOUT` (texture alpha under 0.5 is a hole), or
    /// `BLEND` (see-through by `opacity` times texture alpha).
    alpha: int;
    opacity: f32;
    /// `MESH` material file (`.j3mat`): tint, glow, and a texture or generated noise. It
    /// replaces `texture` when set. `mat` is its slot in the loaded materials, plus one.
    material: string;
    mat: int;
    /// For a placed object, its id in the file it came from; `0` otherwise.
    source: int;
    /// For a placed object, the ids leading to it from its placed copy (`owner`): its id in
    /// that copy's file, or `<id>/<id>/...` through scenes nested deeper. `override` keys on
    /// it; "" otherwise.
    sourcePath: string;
    /// An `INSTANCE` whose placed objects an editor lists and lets you edit. Not saved.
    editable: bool;
    /// `CAMERA` effect files (`kind=camera` `.j3fx`), `|`-separated, run in order over what
    /// it sees. Their params are `fx.<file stem>.<name>` in the param table.
    effects: string;
    /// Comma-separated tags a game reads instead of name prefixes: `nocollide`, or
    /// `launch=30` with a value. See `hasTag` and `tagValue`.
    tags: string;
    /// A comment kept with the object: the `//` lines above it in the file, joined by newlines.
    note: string;
}

/// A handle to one object: its stable id. A script prop of this type is set in the editor
/// by picking an object (`param.<id>.<prop> r=<target id>`); `scene.node(handle)` reads it.
pub struct NodeId {
    id: int;
}

/// Scene-wide lighting, stored as `scene.env.*` lines so undo and the file keep it.
pub struct Env {
    /// Direction toward the sun.
    sunDir: Vec3;
    sunColor: Vec3;
    /// Sky, fog, and ambient color.
    sky: Vec3;
    fogStart: f32;
    fogEnd: f32;
    shadows: bool;
    /// Half size of the box around the origin that casts sun shadows.
    shadowSize: f32;
    /// URP: mirrors and glass trace real rays through the scene. `bounces` surfaces a ray
    /// follows, `samples` rays a pixel on rough or glass surfaces, and traced sun shadows
    /// at the surfaces rays hit (else the shadow map).
    urp: bool;
    bounces: int;
    samples: int;
    tracedShadows: bool;
    /// Traced sun shadows reach this far from the eye; the shadow map covers the rest (0: no limit).
    traceNear: f32 = 40;
}

/// One script prop (or effect param) value in a scene's parameter table (`Scene.params`).
pub struct ParamEntry {
    id: int;
    field: string;
    /// 0 is integer/bool, 1 is float, 2 is string.
    kind: int;
    value: []u8;
    cap: int;
    changed: bool;
}

fn emptyParam(): ParamEntry {
    return ParamEntry { id: 0, field: "", kind: 0,
        value: []u8 { ptr: 0 as &u8, len: 0 }, cap: 0, changed: false };
}

/// A scene owns its nodes and editable key/value data in `arena`.
/// Code outside this module that rewrites `nodes` or `len` directly must call `relink`.
pub struct Scene {
    nodes: []Node;
    len: int;
    nextId: int;
    data: Save;
    arena: &Arena;
    placedData: Save;
    params: []ParamEntry;
    paramCount: int;
    paramsData: ptr;
    paramsLen: int;
    paramsDirty: bool;
    paramsPlacedData: ptr;
    paramsPlacedLen: int;
    placedDirty: bool;
    /// Expanded scene file text and placed-node strings are replaced on refresh.
    placed: &Arena;
    /// Id lookup table: open addressing, each entry a slot + 1 (0 is empty).
    slots: []int;
    /// `nodes[0..linked]` are in `slots`.
    linked: int;
    /// Next id for an object added from a placed scene.
    grafted: int;
    /// The file `read` came from existed.
    found: bool;
    /// Placed scenes went more than `NEST` levels deep; the deeper ones were left out.
    tooDeep: bool;
    /// The first thing `read` could not make sense of in a v2 file (`line 12: ...`), or "".
    /// `store` refuses to overwrite a file whose last read had one.
    parseError: string;
    /// The first placed scene (at any depth) that turns URP on, "" for none, and the
    /// strongest URP settings among placed scenes.
    urpChild: string;
    childUrp: Env;
    /// Per node slot, how far `drawWith` pulls it toward the camera in depth (0 for none):
    /// the smaller of two objects with faces on one plane. See `flushScan`.
    flush: []f32;
    /// Where the objects stood when `flush` was last worked out, how many frames they have
    /// stood still, and whether they moved since.
    flushSig: f32;
    flushStill: int;
    flushStale: bool;

    /// The object `handle` names. Panics when it isn't in the scene.
    fn node(this: &Scene, handle: NodeId): &Node {
        let at = index(this, handle.id);
        if at < 0 { panic("scene3d: no object with that id"); }
        return &this.nodes[at];
    }

    /// The object at `path`: a name (`"Door"`, the first object with it) or a
    /// `Parent/Child` path from the top. `NodeId { id: 0 }` when nothing matches.
    fn find(this: &Scene, path: string): NodeId {
        let slash = false;
        for i in 0..path.len { if path[i] == 47 { slash = true; } }
        if !slash {
            for i in 0..this.len {
                if same(this.nodes[i].name, path) { return NodeId { id: this.nodes[i].id }; }
            }
            return NodeId { id: 0 };
        }
        let parent = 0;
        let start = 0;
        while start <= path.len {
            let end = start;
            while end < path.len && path[end] != 47 { end += 1; }
            let part = path[start..end];
            let next = 0;
            for i in 0..this.len {
                if this.nodes[i].parent == parent && same(this.nodes[i].name, part) {
                    next = this.nodes[i].id;
                    break;
                }
            }
            if next == 0 { return NodeId { id: 0 }; }
            parent = next;
            start = end + 1;
        }
        return NodeId { id: parent };
    }
}

fn key(i: int, field: string, arena: &Arena): string {
    let t = Text.new(arena);
    t.pushStr("node.");
    t.pushInt(i);
    t.push(46);
    t.pushStr(field);
    return t.str();
}

/// A node with default fields.
fn blank(id: int): Node {
    return Node {
        id: id,
        parent: 0,
        kind: GROUP,
        name: "Object",
        asset: "",
        texture: "",
        script: "",
        doubleSided: false,
        position: Vec3.xyz(0, 0, 0),
        rotation: Vec3.xyz(0, 0, 0),
        scale: Vec3.xyz(1, 1, 1),
        fov: 60,
        near: 0.15,
        far: 200,
        gpu: Mesh {},
        image: Tex { id: 0, w: 0, h: 0 },
        boundLo: Vec3.xyz(-0.5, -0.5, -0.5),
        boundHi: Vec3.xyz(0.5, 0.5, 0.5),
        scene: "",
        owner: 0,
        missing: false,
        collapsed: false,
        color: Vec3.xyz(1, 0.9, 0.75),
        tint: Vec3.xyz(1, 1, 1),
        range: 8,
        alpha: OPAQUE,
        opacity: 1,
        material: "",
        mat: 0,
        source: 0,
        sourcePath: "",
        editable: false,
        effects: "",
        tags: "",
        note: "",
    };
}

/// Where tag `name` is in `n.tags` (`name` or `name=value`): the index after the name, or -1.
fn tagAt(n: Node, name: string): int {
    let t = n.tags;
    let from = 0;
    while from < t.len {
        let to = from;
        while to < t.len && t[to] != 44 { to += 1; }
        let k = 0;
        while k < name.len && from + k < to && t[from + k] == name[k] { k += 1; }
        if k == name.len && (from + k == to || t[from + k] == 61) { return from + k; }
        from = to + 1;
    }
    return -1;
}

/// `n` has tag `name`, bare or with a value (`launch=30` has `launch`).
pub fn hasTag(n: Node, name: string): bool {
    return tagAt(n, name) >= 0;
}

/// The value of tag `name=value` on `n`; `fallback` when it has no such tag or no value.
pub fn tagValue(n: Node, name: string, fallback: string): string {
    let at = tagAt(n, name);
    if at < 0 || at >= n.tags.len || n.tags[at] != 61 { return fallback; }
    let end = at + 1;
    while end < n.tags.len && n.tags[end] != 44 { end += 1; }
    return []u8 { ptr: (n.tags.ptr as int + at + 1) as &u8, len: end - at - 1 } as string;
}

/// True when `bytes[at..end]` is exactly `name`.
pub fn fieldIs(bytes: []u8, at: int, end: int, name: string): bool {
    if end - at != name.len { return false; }
    let i = 0;
    while i < name.len {
        if bytes[at + i] != name[i] { return false; }
        i += 1;
    }
    return true;
}

/// Set one field of `n` from a `node.<i>.<field>` line. `v` indexes the value, `end` the line end.
fn setField(n: &Node, bytes: []u8, f: int, fe: int, v: int, end: int) {
    let text = []u8 { ptr: (bytes.ptr as int + v) as &u8, len: end - v } as string;
    if fieldIs(bytes, f, fe, "id") { n.id = save.parseInt(bytes, v, n.id); }
    else if fieldIs(bytes, f, fe, "parent") { n.parent = save.parseInt(bytes, v, 0); }
    else if fieldIs(bytes, f, fe, "kind") { n.kind = save.parseInt(bytes, v, GROUP); }
    else if fieldIs(bytes, f, fe, "doubleSided") { n.doubleSided = save.parseInt(bytes, v, 0) != 0; }
    else if fieldIs(bytes, f, fe, "name") { n.name = text; }
    else if fieldIs(bytes, f, fe, "asset") { n.asset = text; }
    else if fieldIs(bytes, f, fe, "texture") { n.texture = text; }
    else if fieldIs(bytes, f, fe, "script") { n.script = text; }
    else if fieldIs(bytes, f, fe, "scene") { n.scene = text; }
    else if fieldIs(bytes, f, fe, "px") { n.position.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "py") { n.position.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "pz") { n.position.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rx") { n.rotation.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "ry") { n.rotation.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "rz") { n.rotation.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sx") { n.scale.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sy") { n.scale.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "sz") { n.scale.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "fov") { n.fov = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "near") { n.near = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "far") { n.far = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cr") { n.color.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cg") { n.color.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "cb") { n.color.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tr") { n.tint.x = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tg") { n.tint.y = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "tb") { n.tint.z = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "range") { n.range = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "alpha") { n.alpha = save.parseInt(bytes, v, OPAQUE); }
    else if fieldIs(bytes, f, fe, "opacity") { n.opacity = save.parseFloat(bytes, v); }
    else if fieldIs(bytes, f, fe, "material") { n.material = text; }
    else if fieldIs(bytes, f, fe, "effects") { n.effects = text; }
    else if fieldIs(bytes, f, fe, "tags") { n.tags = text; }
}

/// Read a scene written by `store`, with every instanced scene added under its
/// instance node. Missing files yield an empty scene.
pub fn load(path: string, arena: &Arena): Scene {
    let scene = read(path, arena);
    expand(&scene, path);
    return scene;
}

/// Read a scene file as stored, without adding instanced scenes. One pass: `node.*` lines
/// become nodes, every other line (`param.*`, `scene.*`) stays in `scene.data`.
pub fn read(path: string, arena: &Arena): Scene {
    let bytes = arena.alloc::<u8>(0);
    let found = false;
    match io.readFile(path, arena) {
        Result.Ok(b) { bytes = b; found = true; }
        Result.Err(_) {}
    }
    return parse(bytes, found, arena);
}

/// A scene from file text already in memory (`read` without the file). Node strings point
/// into `bytes`, so they must outlive the scene.
pub fn parse(bytes: []u8, found: bool, arena: &Arena): Scene {
    let rest = Text.new(arena);
    let scene = Scene {
        nodes: arena.alloc::<Node>(0),
        len: 0,
        nextId: 0,
        data: save.empty(arena),
        arena: arena,
        placedData: save.empty(arena),
        params: arena.alloc::<ParamEntry>(0),
        paramCount: 0,
        paramsData: 0 as ptr,
        paramsLen: 0,
        paramsDirty: false,
        paramsPlacedData: 0 as ptr,
        paramsPlacedLen: 0,
        placedDirty: false,
        placed: 0 as &Arena,
        slots: arena.alloc::<int>(0),
        linked: 0,
        grafted: GRAFT,
        found: found,
        tooDeep: false,
        parseError: "",
        urpChild: "",
        flush: arena.alloc::<f32>(0),
        flushSig: 0,
        flushStill: 0,
        flushStale: true,
        childUrp: Env {
            sunDir: Vec3.zero(), sunColor: Vec3.zero(), sky: Vec3.zero(), fogStart: 0, fogEnd: 0,
            shadows: false, shadowSize: 0, urp: false, bounces: 1, samples: 1, tracedShadows: false,
        },
    };
    let line = 0;
    if startsWith(bytes, 0, bytes.len, "j3scene") {
        parseV2(&scene, bytes, &rest);
        line = bytes.len;
    }
    while line < bytes.len {
        let end = line;
        while end < bytes.len && bytes[end] != 10 { end += 1; }
        let i = nodeLine(bytes, line, end);
        if i >= 0 {
            // `node.<i>.<field>[ f| s]=<value>`
            let f = line + 5;
            while bytes[f] != 46 { f += 1; }
            f += 1;
            let fe = f;
            while fe < end && bytes[fe] != 32 && bytes[fe] != 61 { fe += 1; }
            let v = fe;
            while v < end && bytes[v] != 61 { v += 1; }
            if v < end {
                grow(&scene, i + 1);
                setField(&scene.nodes[i], bytes, f, fe, v + 1, end);
            }
        } else {
            let k = line;
            while k < end { rest.push(bytes[k]); k += 1; }
            rest.push(10);
        }
        line = end + 1;
    }
    scene.data.bytes = rest.bytes;
    scene.nextId = save.getInt(&scene.data, "scene.nextId", scene.len + 1);
    let j = 0;
    while j < scene.len {
        if scene.nodes[j].id >= scene.nextId && scene.nodes[j].id < GRAFT { scene.nextId = scene.nodes[j].id + 1; }
        j += 1;
    }
    relink(&scene);
    return scene;
}

/// `i` for a `node.<i>.` line, or -1. Rejects indexes no file this size could hold.
fn nodeLine(bytes: []u8, at: int, end: int): int {
    let prefix = "node.";
    if end - at <= prefix.len { return -1; }
    let k = 0;
    while k < prefix.len {
        if bytes[at + k] != prefix[k] { return -1; }
        k += 1;
    }
    let c = at + prefix.len;
    let i = 0;
    let any = false;
    while c < end && bytes[c] >= 48 && bytes[c] <= 57 {
        i = i * 10 + int(bytes[c]) - 48;
        if i > bytes.len { return -1; }
        c += 1;
        any = true;
    }
    if !any || c >= end || bytes[c] != 46 { return -1; }
    return i;
}

/// Make `scene.len` at least `count`, filling new slots with default nodes.
fn grow(scene: &Scene, count: int) {
    if count <= scene.len { return; }
    if count > scene.nodes.len {
        let fresh = scene.arena.alloc::<Node>(count * 2 + 16);
        let k = 0;
        while k < scene.len {
            fresh[k] = scene.nodes[k];
            k += 1;
        }
        scene.nodes = fresh;
    }
    while scene.len < count {
        scene.nodes[scene.len] = blank(scene.len + 1);
        scene.len += 1;
    }
}

fn ensure(scene: &Scene) {
    if scene.len < scene.nodes.len {
        return;
    }
    let fresh = scene.arena.alloc::<Node>(scene.nodes.len * 2 + 16);
    let i = 0;
    while i < scene.len {
        fresh[i] = scene.nodes[i];
        i += 1;
    }
    scene.nodes = fresh;
}

/// Index of `id`, or -1 when absent. Zero is the root sentinel.
pub fn index(scene: &Scene, id: int): int {
    link(scene);
    if scene.slots.len == 0 { return -1; }
    let size = scene.slots.len;
    let h = bucket(id, size);
    while scene.slots[h] != 0 {
        let at = scene.slots[h] - 1;
        if at < scene.len && scene.nodes[at].id == id { return at; }
        h = nextSlot(h, size);
    }
    return -1;
}

/// Next probe after `h` in a table of `size`.
pub fn nextSlot(h: int, size: int): int {
    if h + 1 >= size { return 0; }
    return h + 1;
}

/// Fibonacci hash of `id` into `0..size`.
pub fn bucket(id: int, size: int): int {
    let x = (id * (0 - 7046029254386353131)) / 1048576;
    if x < 0 { x = 0 - x; }
    return x - (x / size) * size;
}

/// Rebuild the id table. Call after rewriting `nodes` or `len` outside this module.
pub fn relink(scene: &Scene) {
    let size = 16;
    while size < scene.len * 2 + 16 { size = size * 2; }
    if scene.slots.len < size {
        scene.slots = scene.arena.alloc::<int>(size);
    }
    let k = 0;
    while k < scene.slots.len {
        scene.slots[k] = 0;
        k += 1;
    }
    scene.linked = 0;
    link(scene);
    ensureParams(scene);
}

/// Add nodes appended since the last call to the id table, growing it when half full.
fn link(scene: &Scene) {
    if scene.linked == scene.len { return; }
    if scene.linked > scene.len || scene.len * 2 + 16 > scene.slots.len {
        relink(scene);
        return;
    }
    let size = scene.slots.len;
    while scene.linked < scene.len {
        let h = bucket(scene.nodes[scene.linked].id, size);
        while scene.slots[h] != 0 { h = nextSlot(h, size); }
        scene.slots[h] = scene.linked + 1;
        scene.linked += 1;
    }
}

/// Add a node under `parent`, falling back to the root if missing.
pub fn add(scene: &Scene, kind: int, name: string, parent: int): int {
    ensure(scene);
    if parent != 0 && index(scene, parent) < 0 {
        parent = 0;
    }
    let id = scene.nextId;
    scene.nextId += 1;
    let n = blank(id);
    n.parent = parent;
    n.kind = kind;
    n.name = name;
    scene.nodes[scene.len] = n;
    scene.len += 1;
    return id;
}

/// Reparent while preserving the node's local transform. Returns false for cycles.
/// Move node `id` to array slot `slot`, shifting the nodes between. Siblings are listed in
/// array order, so this reorders them; nothing else depends on the order.
pub fn moveTo(scene: &Scene, id: int, slot: int) {
    let from = index(scene, id);
    if from < 0 { return; }
    let to = slot;
    if to < 0 { to = 0; }
    if to >= scene.len { to = scene.len - 1; }
    if to == from { return; }
    let n = scene.nodes[from];
    let i = from;
    while i < to {
        scene.nodes[i] = scene.nodes[i + 1];
        i += 1;
    }
    while i > to {
        scene.nodes[i] = scene.nodes[i - 1];
        i -= 1;
    }
    scene.nodes[to] = n;
    relink(scene);
}

pub fn reparent(scene: &Scene, id: int, parent: int): bool {
    let child = index(scene, id);
    if child < 0 {
        return false;
    }
    let cursor = parent;
    let steps = 0;
    while cursor != 0 && steps <= scene.len {
        if cursor == id {
            return false;
        }
        let at = index(scene, cursor);
        if at < 0 {
            return false;
        }
        cursor = scene.nodes[at].parent;
        steps += 1;
    }
    if steps > scene.len {
        return false;
    }
    scene.nodes[child].parent = parent;
    return true;
}

/// Delete a node and all descendants, keeping the order of everything else.
/// Objects whose parent no longer exists go too.
pub fn remove(scene: &Scene, id: int) {
    let mem = Arena.create(scene.len * 8 + 64);
    // 0 not yet known, 1 goes, 2 stays.
    let state = mem.alloc::<int>(scene.len);
    let i = 0;
    while i < scene.len {
        state[i] = 0;
        i += 1;
    }
    i = 0;
    while i < scene.len {
        let verdict = 2;
        let at = i;
        let steps = 0;
        while true {
            if state[at] != 0 { verdict = state[at]; break; }
            if scene.nodes[at].id == id { verdict = 1; break; }
            if scene.nodes[at].parent == 0 { break; }
            let up = index(scene, scene.nodes[at].parent);
            if up < 0 { verdict = 1; break; }
            steps += 1;
            if steps > scene.len { break; }
            at = up;
        }
        at = i;
        steps = 0;
        while state[at] == 0 && steps <= scene.len {
            state[at] = verdict;
            if scene.nodes[at].id == id || scene.nodes[at].parent == 0 { break; }
            let above = index(scene, scene.nodes[at].parent);
            if above < 0 { break; }
            at = above;
            steps += 1;
        }
        i += 1;
    }
    let kept = 0;
    i = 0;
    while i < scene.len {
        if state[i] == 1 {
            unload(&scene.nodes[i]);
        } else {
            scene.nodes[kept] = scene.nodes[i];
            kept += 1;
        }
        i += 1;
    }
    scene.len = kept;
    mem.destroy();
    relink(scene);
}

/// Local transform uses XYZ Euler angles in radians.
pub fn local(n: Node): Mat4 {
    let m = Mat4.translate(n.position.x, n.position.y, n.position.z);
    let rx = Mat4.rotate(Vec3.xyz(1, 0, 0), n.rotation.x);
    let ry = Mat4.rotate(Vec3.xyz(0, 1, 0), n.rotation.y);
    let rz = Mat4.rotate(Vec3.xyz(0, 0, 1), n.rotation.z);
    let scale = Mat4.scale(n.scale.x, n.scale.y, n.scale.z);
    return m.mul(rz).mul(ry).mul(rx).mul(scale);
}

/// World transform; malformed parent chains stop after `len` links.
pub fn world(scene: &Scene, id: int): Mat4 {
    let at = index(scene, id);
    if at < 0 {
        return Mat4.identity();
    }
    let model = local(scene.nodes[at]);
    let parent = scene.nodes[at].parent;
    let depth = 0;
    while parent != 0 && depth < scene.len {
        let p = index(scene, parent);
        if p < 0 {
            break;
        }
        model = local(scene.nodes[p]).mul(model);
        parent = scene.nodes[p].parent;
        depth += 1;
    }
    return model;
}

/// Fill one world matrix per node. Parents are resolved on demand and each node is computed once.
pub fn worlds(scene: &Scene, out: []Mat4) {
    let state = scratch(0).alloc::<u8>(scene.len);
    let chain = scratch(0).alloc::<int>(scene.len);
    let i = 0;
    while i < scene.len { state[i] = 0; i += 1; }
    i = 0;
    while i < scene.len {
        if state[i] == 0 {
            let used = 0;
            let at = i;
            while at >= 0 && state[at] == 0 {
                state[at] = 1;
                chain[used] = at;
                used += 1;
                at = index(scene, scene.nodes[at].parent);
            }
            while used > 0 {
                used -= 1;
                let node = chain[used];
                let parent = index(scene, scene.nodes[node].parent);
                let base = Mat4.identity();
                if parent >= 0 && state[parent] == 2 { base = out[parent]; }
                out[node] = base.mul(local(scene.nodes[node]));
                state[node] = 2;
            }
        }
        i += 1;
    }
}

/// World-space AABB hit for a mesh's loaded vertex bounds.
pub fn hit(scene: &Scene, id: int, ray: Ray, reach: f32): RayHit {
    let at = index(scene, id);
    if at < 0 { return RayHit { ok: false, t: 0 }; }
    return hitModel(scene.nodes[at], world(scene, id), ray, reach);
}

/// Hit test with an already computed transform at node slot `at`. Meshes are tested
/// against their triangles (both sides); a mesh with no loaded vertices and a sky never
/// hit. Other nodes use their bounds box.
pub fn hitWith(scene: &Scene, transforms: []Mat4, at: int, ray: Ray, reach: f32): RayHit {
    let none = RayHit { ok: false, t: 0 };
    if at < 0 || at >= scene.len { return none; }
    let n = scene.nodes[at];
    if n.kind != MESH { return hitModel(n, transforms[at], ray, reach); }
    // The box only rules meshes out; being inside it isn't a hit.
    let box = hitModel(n, transforms[at], ray, reach);
    if !box.ok { return none; }
    let verts = traceVerts(n);
    if verts.len < 36 { return none; }
    return hitTriangles(verts, transforms[at], ray, reach);
}

/// Nearest crossing of `ray` with the triangles of `verts` (12 floats a vertex) placed by
/// `model`, within `reach`. Meshes past `PICK_BVH` triangles are searched through a BVH
/// built on first use and kept.
pub fn hitTriangles(verts: []f32, model: Mat4, ray: Ray, reach: f32): RayHit {
    // In the mesh's own space; the direction isn't renormalized, so t stays in world units.
    let inv = model.affineInverse();
    let o = inv.transformPoint(ray.origin);
    let d = inv.transformPoint(ray.origin + ray.dir) - o;
    let best = reach;
    let tris = verts.len / 36;
    if tris <= PICK_BVH {
        let t = 0;
        while t < tris {
            best = hitTriangle(verts, t, o, d, best);
            t += 1;
        }
        return RayHit { ok: best < reach, t: best };
    }
    let b = pickTree(verts);
    let stack = scratch(0).alloc::<int>(b.count);
    let top = 1;
    stack[0] = 0;
    while top > 0 {
        top -= 1;
        let at = stack[top] * bvh.NODE_FLOATS;
        let lo = Vec3.xyz(b.nodes[at], b.nodes[at + 1], b.nodes[at + 2]);
        let hi = Vec3.xyz(b.nodes[at + 4], b.nodes[at + 5], b.nodes[at + 6]);
        let box = gfx.rayAabb(o, d, lo, hi, best);
        if !box.ok { continue; }
        let first = int(b.nodes[at + 3]);
        let count = int(b.nodes[at + 7]);
        if count == 0 {
            stack[top] = first;
            stack[top + 1] = first + 1;
            top += 2;
        }
        let k = 0;
        while k < count {
            best = hitTriangle(verts, b.order[first + k], o, d, best);
            k += 1;
        }
    }
    return RayHit { ok: best < reach, t: best };
}

/// `best`, or the distance to triangle `t` of `verts` along `o + d * t` when that is nearer.
fn hitTriangle(verts: []f32, t: int, o: Vec3, d: Vec3, best: f32): f32 {
    let v = t * 36;
    let a = Vec3.xyz(verts[v], verts[v + 1], verts[v + 2]);
    let e1 = Vec3.xyz(verts[v + 12], verts[v + 13], verts[v + 14]) - a;
    let e2 = Vec3.xyz(verts[v + 24], verts[v + 25], verts[v + 26]) - a;
    let p = d.cross(e2);
    let det = e1.dot(p);
    if det < 0.0000001 && det > -0.0000001 { return best; }
    let s = o - a;
    let u = s.dot(p) / det;
    if u < 0 || u > 1 { return best; }
    let q = s.cross(e1);
    let w = d.dot(q) / det;
    if w < 0 || u + w > 1 { return best; }
    let hit = e2.dot(q) / det;
    if hit > 0 && hit < best { return hit; }
    return best;
}

/// Triangles past which `hitTriangles` searches a BVH instead of every triangle.
const PICK_BVH: int = 256;
/// Meshes whose picking BVH is kept at once.
const PICK_SLOTS: int = 16;

/// A kept picking BVH. `at`, `len`, and `probe` (a sample of the floats) name the vertices:
/// the pointer alone isn't enough, since scratch memory is reused for other meshes.
struct PickTree {
    at: ptr;
    len: int;
    probe: f32;
    tree: Bvh;
}

#[singleton]
let PICKS: Arena = Arena { ptr: 0, used: 0, cap: 0, head: 0 };
#[singleton]
let PICK_TREES: ptr = 0;
#[singleton]
let PICK_NEXT: int = 0;

fn probeOf(verts: []f32): f32 {
    let n = verts.len;
    return verts[0] + verts[n / 2] * 3.1 + verts[n - 1] * 7.3 + verts[n / 3] * 11.7 + verts[(n * 2) / 3] * 13.9;
}

/// The BVH over `verts`' triangles, from the kept ones or built now.
// ponytail: past PICK_SLOTS meshes, all kept trees are dropped and rebuilt as needed.
fn pickTree(verts: []f32): &Bvh {
    let probe = probeOf(verts);
    let trees = []PickTree { ptr: PICK_TREES as &PickTree, len: PICK_NEXT };
    let k = 0;
    while k < PICK_NEXT {
        let kept = &trees[k];
        if kept.at == verts.ptr as ptr && kept.len == verts.len && kept.probe == probe { return &kept.tree; }
        k += 1;
    }
    if PICK_TREES == 0 || PICK_NEXT == PICK_SLOTS {
        if PICK_TREES != 0 { PICKS.destroy(); }
        PICKS = Arena.create(1024 * 1024);
        let slots = PICKS.alloc::<PickTree>(PICK_SLOTS);
        PICK_TREES = slots.ptr as ptr;
        PICK_NEXT = 0;
    }
    trees = []PickTree { ptr: PICK_TREES as &PickTree, len: PICK_SLOTS };
    let t = &trees[PICK_NEXT];
    PICK_NEXT += 1;
    let n = verts.len / 36;
    let corners = PICKS.alloc::<f32>(n * 9);
    let i = 0;
    while i < n {
        let c = 0;
        while c < 3 {
            corners[i * 9 + c * 3] = verts[i * 36 + c * 12];
            corners[i * 9 + c * 3 + 1] = verts[i * 36 + c * 12 + 1];
            corners[i * 9 + c * 3 + 2] = verts[i * 36 + c * 12 + 2];
            c += 1;
        }
        i += 1;
    }
    t.tree = bvh.build(corners, n, &PICKS);
    t.at = verts.ptr as ptr;
    t.len = verts.len;
    t.probe = probe;
    return &t.tree;
}

fn hitModel(n: Node, model: Mat4, ray: Ray, reach: f32): RayHit {
    let lo = Vec3.xyz(1000000, 1000000, 1000000);
    let hi = Vec3.xyz(-1000000, -1000000, -1000000);
    let x = 0;
    while x < 2 {
        let y = 0;
        while y < 2 {
            let z = 0;
            while z < 2 {
                let px = n.boundLo.x;
                let py = n.boundLo.y;
                let pz = n.boundLo.z;
                if x == 1 { px = n.boundHi.x; }
                if y == 1 { py = n.boundHi.y; }
                if z == 1 { pz = n.boundHi.z; }
                let point = model.transformPoint(Vec3.xyz(px, py, pz));
                if point.x < lo.x { lo.x = point.x; }
                if point.y < lo.y { lo.y = point.y; }
                if point.z < lo.z { lo.z = point.z; }
                if point.x > hi.x { hi.x = point.x; }
                if point.y > hi.y { hi.y = point.y; }
                if point.z > hi.z { hi.z = point.z; }
                z += 1;
            }
            y += 1;
        }
        x += 1;
    }
    return gfx.rayAabb(ray.origin, ray.dir, lo, hi, reach);
}
