/// Plain text and styled runs from a string with escapes. Part of `j3.term.ansi`.

module j3.term.ansi;

/// A span of the stripped text: bytes `start..start+len`, all in `style`.
pub struct Run {
    start: int;
    len: int;
    style: Style;
}

/// Collects text (and, when `keep`, runs) from a parse. Keeps printable text plus LF, CR and HT.
struct Collect {
    text: Text;
    runs: List<Run>;
    keep: bool;
    style: Style;
    open: bool;
    rs: int;
    rstyle: Style;

    fn closeRun(this: &Collect) {
        if this.open && this.text.len() > this.rs {
            this.runs.push(Run { start: this.rs, len: this.text.len() - this.rs, style: this.rstyle });
        }
        this.open = false;
    }

    fn mark(this: &Collect) {
        if this.keep && (!this.open || !(this.rstyle == this.style)) {
            this.closeRun();
            this.rs = this.text.len();
            this.rstyle = this.style;
            this.open = true;
        }
    }

    fn print(this: &Collect, cp: i32) {
        this.mark();
        pushUtf8(&this.text, cp);
    }

    fn exec(this: &Collect, c0: u8) {
        if c0 == 10 || c0 == 13 || c0 == 9 {
            this.mark();
            this.text.push(c0);
        }
    }

    fn csi(this: &Collect, p: &Params, final: u8) {
        if final == 0x6d && p.marker == 0 && p.inter == 0 {
            this.style = sgr(this.style, p);
        }
    }

    fn esc(this: &Collect, inter: int, final: u8) {}

    fn apc(this: &Collect, bytes: string) {}

    fn osc(this: &Collect, bytes: string) {}
}

fn collectText(s: string, arena: &Arena, keep: bool): Collect {
    let c = Collect {
        text: Text.new(arena),
        runs: List<Run>.new(arena),
        keep: keep,
        style: Style.plain(),
        open: false,
        rs: 0,
        rstyle: Style.plain(),
    };
    let p = Parser.new(arena);
    p.feed(s, &c);
    c.closeRun();
    return c;
}

/// `s` as plain text: every escape sequence removed, bad UTF-8 as U+FFFD, controls other than LF, CR and
/// HT dropped. Allocated from `arena` (up to 3x `s.len` in the worst case).
pub fn strip(s: string, arena: &Arena): string {
    let c = collectText(s, arena, false);
    return c.text.str();
}

/// The styled spans of `strip(s, arena)`, in order, same-style neighbors merged; `start` and `len` are
/// byte offsets into that stripped text. Text with no style change is one run; empty text gives none.
pub fn toRuns(s: string, arena: &Arena): List<Run> {
    let c = collectText(s, arena, true);
    return c.runs;
}
