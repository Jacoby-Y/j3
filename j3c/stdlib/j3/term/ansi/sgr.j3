/// SGR: `CSI ... m` applied to a `Style`. Part of `j3.term.ansi`.

module j3.term.ansi;

fn setAttr(s: &Style, bit: int, on: bool) {
    if on {
        s.attr = u16(int(s.attr) | bit);
    } else {
        s.attr = u16(int(s.attr) & ~bit);
    }
}

/// A flat parameter, empty as 0.
fn sv(q: &Params, k: int): int {
    if q.v[k] < 0 {
        return 0;
    }
    return int(q.v[k]);
}

fn simple(s: &Style, code: int) {
    if code == 0 {
        s.fg = Color.default();
        s.bg = Color.default();
        s.attr = 0;
    } else if code == 1 {
        setAttr(s, ATTR_BOLD, true);
    } else if code == 2 {
        setAttr(s, ATTR_DIM, true);
    } else if code == 3 {
        setAttr(s, ATTR_ITALIC, true);
    } else if code == 4 || code == 21 {
        setAttr(s, ATTR_UNDERLINE, true);
    } else if code == 5 || code == 6 {
        setAttr(s, ATTR_BLINK, true);
    } else if code == 7 {
        setAttr(s, ATTR_INVERSE, true);
    } else if code == 8 {
        setAttr(s, ATTR_HIDDEN, true);
    } else if code == 9 {
        setAttr(s, ATTR_STRIKE, true);
    } else if code == 22 {
        setAttr(s, ATTR_BOLD | ATTR_DIM, false);
    } else if code == 23 {
        setAttr(s, ATTR_ITALIC, false);
    } else if code == 24 {
        setAttr(s, ATTR_UNDERLINE, false);
    } else if code == 25 {
        setAttr(s, ATTR_BLINK, false);
    } else if code == 27 {
        setAttr(s, ATTR_INVERSE, false);
    } else if code == 28 {
        setAttr(s, ATTR_HIDDEN, false);
    } else if code == 29 {
        setAttr(s, ATTR_STRIKE, false);
    } else if code >= 30 && code <= 37 {
        s.fg = Color.palette(code - 30);
    } else if code == 39 {
        s.fg = Color.default();
    } else if code >= 40 && code <= 47 {
        s.bg = Color.palette(code - 40);
    } else if code == 49 {
        s.bg = Color.default();
    } else if code >= 90 && code <= 97 {
        s.fg = Color.palette(code - 90 + 8);
    } else if code >= 100 && code <= 107 {
        s.bg = Color.palette(code - 100 + 8);
    }
}

/// `style` after the SGR parameters `q` (the params of `CSI ... m`). No parameters resets. Understands
/// `38;5;n`, `38;2;r;g;b` and the colon forms `38:5:n`, `38:2:r:g:b`, `38:2:cs:r:g:b` (same for 48), and
/// `4:0` (underline off). Unknown codes (and 58/59, underline color) are skipped; a color value over 255 ignores that color; a malformed or truncated 38/48 skips the rest.
pub fn sgr(style: Style, q: &Params): Style {
    let s = style;
    if q.n == 0 {
        return Style.plain();
    }
    let k = 0;
    while k < q.n {
        let code = sv(q, k);
        let e = k + 1;
        while e < q.n && q.colon[e] != 0 {
            e += 1;
        }
        let next = e;
        if code == 38 || code == 48 || code == 58 {
            let c = Color.default();
            let ok = false;
            if e - k > 1 {
                let mode = sv(q, k + 1);
                if mode == 5 && e - k >= 3 {
                    c = Color.palette(sv(q, k + 2));
                    ok = sv(q, k + 2) < 256;
                } else if mode == 2 && e - k >= 5 {
                    let o = if e - k >= 6 { k + 3 } else { k + 2 };
                    c = Color.rgb(sv(q, o), sv(q, o + 1), sv(q, o + 2));
                    ok = sv(q, o) < 256 && sv(q, o + 1) < 256 && sv(q, o + 2) < 256;
                }
            } else if k + 1 < q.n {
                let mode = sv(q, k + 1);
                next = q.n;
                if mode == 5 && k + 2 < q.n {
                    c = Color.palette(sv(q, k + 2));
                    ok = sv(q, k + 2) < 256;
                    next = k + 3;
                } else if mode == 2 && k + 4 < q.n {
                    c = Color.rgb(sv(q, k + 2), sv(q, k + 3), sv(q, k + 4));
                    ok = sv(q, k + 2) < 256 && sv(q, k + 3) < 256 && sv(q, k + 4) < 256;
                    next = k + 5;
                }
            }
            // 58 (underline color) is consumed like 38 but not kept: Style has no slot for it.
            if ok && code != 58 {
                if code == 38 {
                    s.fg = c;
                } else {
                    s.bg = c;
                }
            }
        } else if code == 4 && e - k > 1 {
            setAttr(&s, ATTR_UNDERLINE, sv(q, k + 1) != 0);
        } else {
            simple(&s, code);
        }
        k = next;
    }
    return s;
}

