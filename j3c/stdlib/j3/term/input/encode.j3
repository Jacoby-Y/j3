/// Encode half of `j3.term.input` (see that module's doc): `encodeKey`, `encodePaste`, `encodeMouse`.

module j3.term.input;


fn csiMod(out: &Text, first: int, mods: int, final: u8) {
    out.push(ESC);
    out.push(91);
    if mods != 0 {
        out.pushInt(first);
        out.push(59);
        out.pushInt(mods + 1);
    } else if first != 1 {
        out.pushInt(first);
    }
    out.push(final);
}

/// `encodeKeyEvent` event types (kitty's numbers).
pub const KEV_PRESS = 1;
pub const KEV_REPEAT = 2;
pub const KEV_RELEASE = 3;

/// Append the bytes a key press sends. `modes` is `Grid.modes`: `MODE_CURSOR_KEYS`, and the kitty keyboard flags
/// a program pushed (see `encodeKeyEvent`). `cp` is read for `KEY_CHAR`. Shift on `KEY_CHAR` is ignored by
/// the legacy encoding (pass the shifted character).
pub fn encodeKey(key: int, mods: int, cp: i32, modes: int, out: &Text) {
    encodeKeyEvent(key, mods, cp, KEV_PRESS, modes, out);
}

/// Like `encodeKey` for a press, repeat or release (`KEV_*`). With no kitty flags in `modes` it is xterm's
/// encoding (a release sends nothing). With flags (`j3.term.grid.kittyFlags`) it follows the kitty keyboard
/// protocol: disambiguate (Esc and Ctrl/Alt combos as `CSI code;mods u`), event types (`mods:event`),
/// alternate keys (`code:shifted` for Shift+letter), all keys as escapes, associated text (`;text`, with
/// all-as-escapes). `KEY_CHAR`'s key code is `cp` lowercased; Shift+letter may pass either case.
/// ponytail: no keypad, modifier-key or base-layout-key reports, and the shifted key is known for letters only.
pub fn encodeKeyEvent(key: int, mods: int, cp: i32, event: int, modes: int, out: &Text) {
    let flags = kittyFlags(modes);
    if flags != 0 {
        encodeKitty(key, mods & 7, cp, event, flags, modes, out);
        return;
    }
    if event == KEV_RELEASE {
        return;
    }
    let m = mods & 7;
    let alt = (m & MOD_ALT) != 0;
    let ctrl = (m & MOD_CTRL) != 0;
    if key == KEY_NONE || key < 0 || key > KEY_F12 {
        return;
    }
    if key >= KEY_UP && key <= KEY_END {
        let f = keyFinal(key);
        if m == 0 && (modes & MODE_CURSOR_KEYS) != 0 {
            out.push(ESC);
            out.push(79);
            out.push(f);
        } else {
            csiMod(out, 1, m, f);
        }
        return;
    }
    if key >= KEY_F1 && key <= KEY_F1 + 3 {
        let f: u8 = 80 + u8(key - KEY_F1);
        if m == 0 {
            out.push(ESC);
            out.push(79);
            out.push(f);
        } else {
            csiMod(out, 1, m, f);
        }
        return;
    }
    let code = tildeCode(key);
    if code != 0 {
        csiMod(out, code, m, 126);
        return;
    }
    if alt {
        out.push(ESC);
    }
    if key == KEY_ENTER {
        out.push(13);
    } else if key == KEY_TAB {
        if (m & MOD_SHIFT) != 0 {
            out.push(ESC);
            out.push(91);
            out.push(90);
        } else {
            out.push(9);
        }
    } else if key == KEY_BACKSPACE {
        out.push(if ctrl { 8 } else { 127 });
    } else if key == KEY_ESC {
        out.push(ESC);
    } else if key == KEY_CHAR {
        if ctrl && ((cp >= 64 && cp <= 95) || (cp >= 97 && cp <= 122)) {
            // @ A-Z [ \ ] ^ _ and a-z
            out.push(u8(cp & 31));
        } else if ctrl && cp == 32 {
            out.push(0);
        } else if ctrl && cp == 63 {
            out.push(127);
        } else {
            pushUtf8(out, cp);
        }
    }
}

fn encodeKitty(key: int, m: int, cp: i32, event: int, flags: int, modes: int, out: &Text) {
    if key == KEY_NONE || key < 0 || key > KEY_F12 {
        return;
    }
    let all = (flags & KITTY_ALL_AS_ESCAPES) != 0;
    let ev = if (flags & KITTY_EVENT_TYPES) != 0 { event } else { KEV_PRESS };
    if event == KEV_RELEASE && ev != KEV_RELEASE {
        return;
    }
    let plain = m == 0 && ev == KEV_PRESS && !all;
    if (key >= KEY_UP && key <= KEY_END) || key == KEY_F1 || key == KEY_F1 + 1 || key == KEY_F1 + 3 {
        if plain {
            encodeKeyEvent(key, 0, 0, KEV_PRESS, modes & ~MODE_KITTY_MASK, out);
            return;
        }
        let f = if key >= KEY_F1 { 80 + u8(key - KEY_F1) } else { keyFinal(key) };
        kittyCsi(out, 1, 0, m, ev, 0, f);
        return;
    }
    let code = if key == KEY_F1 + 2 { 13 } else { tildeCode(key) };
    if code != 0 {
        if plain && key != KEY_F1 + 2 {
            csiMod(out, code, 0, 126);
        } else {
            kittyCsi(out, code, 0, m, ev, 0, 126);
        }
        return;
    }
    if key == KEY_ENTER || key == KEY_TAB || key == KEY_BACKSPACE {
        if event == KEV_RELEASE && !all {
            return;
        }
        let c = if key == KEY_ENTER { 13 } else if key == KEY_TAB { 9 } else { 127 };
        if plain {
            out.push(u8(c));
        } else {
            kittyCsi(out, c, 0, m, ev, 0, 117);
        }
        return;
    }
    if key == KEY_ESC {
        kittyCsi(out, 27, 0, m, ev, 0, 117);
        return;
    }
    // KEY_CHAR
    let shift = (m & MOD_SHIFT) != 0;
    let lower = if cp >= 65 && cp <= 90 { cp + 32 } else { cp };
    let text = if shift && lower >= 97 && lower <= 122 { lower - 32 } else { cp };
    if (m & ~MOD_SHIFT) == 0 && ev == KEV_PRESS && !all {
        pushUtf8(out, text);
        return;
    }
    let alt = if (flags & KITTY_ALTERNATE_KEYS) != 0 && shift && text != lower { text } else { 0 };
    let withText = (flags & KITTY_TEXT) != 0 && all && event != KEV_RELEASE && (m & ~MOD_SHIFT) == 0 && text >= 32;
    kittyCsi(out, int(lower), int(alt), m, ev, if withText { int(text) } else { 0 }, 117);
}

/// `CSI code[:alt] [; [mods+1][:ev]] [; text] final`, leaving out defaults (code 1 with nothing after it too).
fn kittyCsi(out: &Text, code: int, alt: int, m: int, ev: int, text: int, final: u8) {
    out.push(ESC);
    out.push(91);
    let modsField = m != 0 || ev != KEV_PRESS;
    if code != 1 || alt != 0 || modsField || text != 0 {
        out.pushInt(code);
    }
    if alt != 0 {
        out.push(58);
        out.pushInt(alt);
    }
    if modsField || text != 0 {
        out.push(59);
        if modsField {
            out.pushInt(m + 1);
        }
        if ev != KEV_PRESS {
            out.push(58);
            out.pushInt(ev);
        }
    }
    if text != 0 {
        out.push(59);
        out.pushInt(text);
    }
    out.push(final);
}

/// Append a paste to the child: wrapped in `ESC[200~ ... ESC[201~` when `MODE_PASTE` is on, raw otherwise.
/// Any `ESC[201~` in `s` is removed (also one that removal would join), so pasted text cannot end the paste early.
pub fn encodePaste(s: string, modes: int, out: &Text) {
    let wrap = (modes & MODE_PASTE) != 0;
    if wrap {
        out.push(ESC);
        out.pushStr("[200~");
    }
    let base = out.len();
    for b in s {
        out.push(b);
        let n = out.len();
        if b == 126 && n - base >= 6 && markerMatch(out.bytes[n - 6..n]) == 6 {
            out.remove(n - 6, 6);
        }
    }
    if wrap {
        out.push(ESC);
        out.pushStr("[201~");
    }
}

/// Append an SGR (1006) mouse report when the grid asked for one: `button` is `MB_*`, `action` `MA_*`, `x`/`y`
/// 0-based, `mods` `MOD_*`. Nothing is written when the mode does not want this event (no mouse mode or no SGR,
/// motion without drag/any-motion mode, motion with no button without any-motion mode).
/// Known limit: only SGR (1006) is encoded; the legacy X10/UTF-8 mouse encodings are not.
pub fn encodeMouse(button: int, action: int, x: int, y: int, mods: int, modes: int, out: &Text) {
    if (modes & MODE_MOUSE_ANY) == 0 || (modes & MODE_MOUSE_SGR) == 0 {
        return;
    }
    let cb = 0;
    if action == MA_WHEEL || button >= MB_WHEEL_UP {
        cb = 64 + (button - MB_WHEEL_UP);
    } else {
        cb = button & 3;
        if action == MA_MOVE {
            let drag = (modes & (MODE_MOUSE_DRAG | MODE_MOUSE_MOVE)) != 0;
            if (button == MB_NONE && (modes & MODE_MOUSE_MOVE) == 0) || !drag {
                return;
            }
            cb |= 32;
        }
    }
    if (mods & MOD_SHIFT) != 0 { cb |= 4; }
    if (mods & MOD_ALT) != 0 { cb |= 8; }
    if (mods & MOD_CTRL) != 0 { cb |= 16; }
    out.push(ESC);
    out.push(91);
    out.push(60);
    out.pushInt(cb);
    out.push(59);
    out.pushInt(x + 1);
    out.push(59);
    out.pushInt(y + 1);
    out.push(if action == MA_RELEASE { 109 } else { 77 });
}
