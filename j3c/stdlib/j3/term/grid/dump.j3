/// Text dumps of `Grid` for golden tests and logs. Part of `j3.term.grid`.

module j3.term.grid;


fn colorTag(t: &Text, c: Color) {
    if c.kind() == COLOR_PALETTE {
        t.push(0x70);
        t.pushInt(c.index());
    } else if c.kind() == COLOR_RGB {
        t.push(0x23);
        t.pushInt(c.r());
        t.push(0x2e);
        t.pushInt(c.g());
        t.push(0x2e);
        t.pushInt(c.b());
    } else {
        t.push(0x2d);
    }
}

/// `cells` as text: empty cells are spaces, width-0 spacers are skipped, trailing spaces are trimmed. With `styled`,
/// a style change is marked `{fg;bg;attr}` (`-` default, `pN` palette, `#r.g.b`), and the row's run to the last
/// cell that has a style or a character is kept so a colored blank is visible.
pub fn lineText(t: &Text, cells: []Cell, styled: bool) {
    let last = -1;
    for x in 0..cells.len {
        let c = cells[x];
        let has = (c.cp != 0 && c.cp != 32) || (styled && !(c.style == Style.plain()));
        if has {
            last = x;
        }
    }
    let cur = Style.plain();
    for x in 0..(last + 1) {
        let c = cells[x];
        if styled && !(c.style == cur) {
            cur = c.style;
            t.push(0x7b);
            colorTag(t, cur.fg);
            t.push(0x3b);
            colorTag(t, cur.bg);
            t.push(0x3b);
            t.pushInt(int(cur.attr));
            t.push(0x7d);
        }
        if c.width != 0 {
            pushUtf8(t, if c.cp == 0 { 32 } else { c.cp });
            if c.marks != 0 {
                pushUtf8(t, c.mark(0));
                if c.mark(1) != 0 {
                    pushUtf8(t, c.mark(1));
                }
            }
        }
    }
    if styled && !(cur == Style.plain()) {
        t.add("{-;-;0}");
    }
}

extend Grid {
    /// The screen as text: rows joined by `\n`, trailing spaces trimmed, no cursor. Allocates on `arena`.
    fn dumpText(this: &Grid, arena: &Arena): string {
        return this.dump(arena, false);
    }

    /// Like `dumpText` but marking style changes (see `lineText`).
    fn dumpStyled(this: &Grid, arena: &Arena): string {
        return this.dump(arena, true);
    }

    fn dump(this: &Grid, arena: &Arena, styled: bool): string {
        let t = Text.new(arena);
        for y in 0..this.nrows {
            if y > 0 {
                t.push(0x0a);
            }
            lineText(&t, this.rowCells(y), styled);
        }
        return t.str();
    }

    /// Virtual line `i` (scrollback then screen, see `line`) as trimmed text.
    fn lineString(this: &Grid, i: int, arena: &Arena): string {
        let t = Text.new(arena);
        lineText(&t, this.line(i), false);
        return t.str();
    }
}
