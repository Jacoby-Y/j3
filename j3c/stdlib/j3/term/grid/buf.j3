/// Grid storage helpers: row access, erasing, wide-character repair, scrolling, scrollback. Part of `j3.term.grid`.

module j3.term.grid;

fn mn(a: int, b: int): int {
    return if a < b { a } else { b };
}

fn mx(a: int, b: int): int {
    return if a > b { a } else { b };
}

extend Grid {
    /// The buffer on screen.
    fn bufp(this: &Grid): &Buf {
        if this.isAlt {
            return &this.altb;
        }
        return &this.pri;
    }

    /// Index in `Buf.cells` of the first cell of logical row `y`.
    fn rowStart(this: &Grid, y: int): int {
        let b = this.bufp();
        return b.ridx[y] * this.maxCols;
    }

    fn touch(this: &Grid, y: int) {
        let b = this.bufp();
        b.dirty[b.ridx[y]] = 1;
    }

    /// What erasing leaves: an empty cell with the pen's background (BCE), nothing else.
    fn erased(this: &Grid): Cell {
        return Cell { cp: 0, style: Style { fg: Color.default(), bg: this.pen.bg, attr: 0 }, width: 1, link: 0, marks: 0 };
    }

    fn resetTabs(this: &Grid) {
        for x in 0..this.maxCols {
            this.tabs[x] = if x % 8 == 0 { 1 } else { 0 };
        }
    }

    /// Make sure no wide character straddles the boundary between columns `x - 1` and `x` of the row at `s`:
    /// if `x` is a right half, both halves are blanked.
    fn splitAt(this: &Grid, s: int, x: int) {
        if x <= 0 || x >= this.ncols {
            return;
        }
        let b = this.bufp();
        if b.cells[s + x].width == 0 {
            let e = this.erased();
            b.cells[s + x - 1] = e;
            b.cells[s + x] = e;
        }
    }

    /// Before overwriting column `x` of the row at `s`: blank the other half of a wide character there.
    fn killHalf(this: &Grid, s: int, x: int) {
        let b = this.bufp();
        let w = b.cells[s + x].width;
        if w == 0 {
            if x > 0 {
                b.cells[s + x - 1] = this.erased();
            }
        } else if w == 2 && x + 1 < this.ncols {
            b.cells[s + x + 1] = this.erased();
        }
    }

    /// Erase columns `a..b` of logical row `y` (clamped), repairing wide characters at the edges.
    fn eraseRow(this: &Grid, y: int, a: int, b: int) {
        let lo = mx(a, 0);
        let hi = mn(b, this.ncols);
        if lo >= hi {
            return;
        }
        let s = this.rowStart(y);
        this.splitAt(s, lo);
        this.splitAt(s, hi);
        let bf = this.bufp();
        let e = this.erased();
        for x in lo..hi {
            bf.cells[s + x] = e;
        }
        if hi == this.ncols {
            bf.wrap[bf.ridx[y]] = 0;
        }
        this.touch(y);
    }

    /// Blank physical row `p` (the visible columns) and mark it dirty.
    fn blankPhys(this: &Grid, p: int) {
        let b = this.bufp();
        let e = this.erased();
        let s = p * this.maxCols;
        for x in 0..this.ncols {
            b.cells[s + x] = e;
        }
        b.dirty[p] = 1;
        b.wrap[p] = 0;
    }

    /// Copy physical row `p` of the primary buffer into the scrollback ring.
    fn pushSb(this: &Grid, p: int) {
        if this.sbCap == 0 {
            return;
        }
        let slot = 0;
        if this.sbCount < this.sbCap {
            slot = (this.sbHead + this.sbCount) % this.sbCap;
            this.sbCount += 1;
        } else {
            slot = this.sbHead;
            this.sbHead = (this.sbHead + 1) % this.sbCap;
        }
        let from = p * this.maxCols;
        let to = slot * this.maxCols;
        for x in 0..this.ncols {
            this.sb[to + x] = this.pri.cells[from + x];
        }
        this.sbLens[slot] = this.ncols;
        this.sbWrap[slot] = this.pri.wrap[p];
    }

    /// Scroll rows `t..=bt` up (`up`) or down by `n` (clamped to the region height); the rows that open up are
    /// blank. With `sb`, rows that leave the top of a full-screen region on the primary buffer go to scrollback.
    /// Rotates row indexes; touches only the blanked rows' cells.
    fn scrollRegion(this: &Grid, t: int, bt: int, n: int, up: bool, sb: bool) {
        let h = bt - t + 1;
        let k = mn(n, h);
        if k <= 0 {
            return;
        }
        let b = this.bufp();
        if up {
            if sb && !this.isAlt && t == 0 && bt == this.nrows - 1 {
                for i in 0..k {
                    this.pushSb(b.ridx[i]);
                }
            }
            for i in 0..k {
                b.tmp[i] = b.ridx[t + i];
            }
            for i in t..(bt - k + 1) {
                b.ridx[i] = b.ridx[i + k];
            }
            for i in 0..k {
                b.ridx[bt - k + 1 + i] = b.tmp[i];
                this.blankPhys(b.tmp[i]);
            }
        } else {
            for i in 0..k {
                b.tmp[i] = b.ridx[bt - k + 1 + i];
            }
            let i = bt;
            while i >= t + k {
                b.ridx[i] = b.ridx[i - k];
                i -= 1;
            }
            for j in 0..k {
                b.ridx[t + j] = b.tmp[j];
                this.blankPhys(b.tmp[j]);
            }
        }
        for y in t..(bt + 1) {
            this.touch(y);
        }
        if t == 0 && bt == this.nrows - 1 {
            this.kScroll(k, up);
        }
    }

    /// IND: down one row, scrolling the region at its bottom margin; nothing below the region's last row.
    fn index(this: &Grid) {
        this.wrapPending = false;
        if this.cy == this.bot {
            this.scrollRegion(this.top, this.bot, 1, true, true);
        } else if this.cy < this.nrows - 1 {
            this.cy += 1;
        }
    }

    /// RI: up one row, scrolling the region down at its top margin.
    fn reverseIndex(this: &Grid) {
        this.wrapPending = false;
        if this.cy == this.top {
            this.scrollRegion(this.top, this.bot, 1, false, false);
        } else if this.cy > 0 {
            this.cy -= 1;
        }
    }

    /// Shift the cursor row's cells from `cx` right by `n` (clamped), blanking the gap.
    fn insertCells(this: &Grid, n0: int) {
        let n = mn(n0, this.ncols - this.cx);
        if n <= 0 {
            return;
        }
        let b = this.bufp();
        let s = this.rowStart(this.cy);
        this.splitAt(s, this.cx);
        let x = this.ncols - 1;
        while x >= this.cx + n {
            b.cells[s + x] = b.cells[s + x - n];
            x -= 1;
        }
        let e = this.erased();
        for i in this.cx..(this.cx + n) {
            b.cells[s + i] = e;
        }
        if b.cells[s + this.ncols - 1].width == 2 {
            b.cells[s + this.ncols - 1] = e;
        }
        this.touch(this.cy);
    }

    /// Delete `n` (clamped) cells at `cx`, pulling the rest of the row left.
    fn deleteCells(this: &Grid, n0: int) {
        let n = mn(n0, this.ncols - this.cx);
        if n <= 0 {
            return;
        }
        let b = this.bufp();
        let s = this.rowStart(this.cy);
        this.splitAt(s, this.cx);
        this.splitAt(s, this.cx + n);
        for x in this.cx..(this.ncols - n) {
            b.cells[s + x] = b.cells[s + x + n];
        }
        let e = this.erased();
        for x in (this.ncols - n)..this.ncols {
            b.cells[s + x] = e;
        }
        this.touch(this.cy);
    }
}
