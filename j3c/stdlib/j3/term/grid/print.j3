/// Printing, C0 controls and ESC sequences of `Grid` (the `ansi.Sink` methods `print`, `exec`, `esc`).
/// Part of `j3.term.grid`.

module j3.term.grid;

/// DEC special graphics for 0x5f..0x7e.
const DEC_GFX: [32]i32 = [
    32, 0x25c6, 0x2592, 0x2409, 0x240c, 0x240d, 0x240a, 0xb0,
    0xb1, 0x2424, 0x240b, 0x2518, 0x2510, 0x250c, 0x2514, 0x253c,
    0x23ba, 0x23bb, 0x2500, 0x23bc, 0x23bd, 0x251c, 0x2524, 0x2534,
    0x252c, 0x2502, 0x2264, 0x2265, 0x3c0, 0x2260, 0xa3, 0xb7,
];

extend Grid {
    /// Sink: a printable code point (translated through the DEC set when G0 is line drawing).
    fn print(this: &Grid, cp0: i32) {
        let cp = cp0;
        if this.drawG0 && cp >= 0x5f && cp <= 0x7e {
            cp = DEC_GFX[int(cp) - 0x5f];
        }
        this.put(cp);
    }

    /// Write one already translated code point at the cursor: wide characters take two cells (the second has
    /// width 0) and wrap first when one column is left; width 0 code points (combining marks, stray controls) are
    /// dropped without moving the cursor; the last column sets the pending wrap instead of wrapping.
    fn put(this: &Grid, cp: i32) {
        let w = cpWidth(cp);
        if w == 0 {
            this.addMark(cp);
            return;
        }
        if w > this.ncols {
            return;
        }
        this.lastCp = cp;
        if this.wrapPending {
            this.wrapPending = false;
            if (this.modes & MODE_WRAP) != 0 {
                let b = this.bufp();
                b.wrap[b.ridx[this.cy]] = 1;
                this.cx = 0;
                this.index();
            }
        }
        if w == 2 && this.cx == this.ncols - 1 {
            if (this.modes & MODE_WRAP) == 0 {
                return;
            }
            let s = this.rowStart(this.cy);
            this.killHalf(s, this.cx);
            this.bufp().cells[s + this.cx] = this.erased();
            let b = this.bufp();
            b.wrap[b.ridx[this.cy]] = 1;
            this.cx = 0;
            this.index();
        }
        if (this.modes & MODE_INSERT) != 0 {
            this.insertCells(w);
        }
        let b = this.bufp();
        let s = this.rowStart(this.cy);
        this.killHalf(s, this.cx);
        b.cells[s + this.cx] = Cell { cp: cp, style: this.pen, width: u8(w), link: u16(this.link), marks: 0 };
        if w == 2 {
            this.killHalf(s, this.cx + 1);
            b.cells[s + this.cx + 1] = Cell { cp: 0, style: this.pen, width: 0, link: u16(this.link), marks: 0 };
        }
        this.touch(this.cy);
        if this.cx + w >= this.ncols {
            this.cx = this.ncols - 1;
            this.wrapPending = (this.modes & MODE_WRAP) != 0;
        } else {
            this.cx += w;
        }
    }

    /// Attach combining code point `cp` to the character before the cursor (the one just printed): kept when it is
    /// in the BMP and the cell has fewer than 2 marks; dropped otherwise, or at the start of a row.
    fn addMark(this: &Grid, cp: i32) {
        if cp <= 0 || cp > 0xffff {
            return;
        }
        let x = if this.wrapPending { this.cx } else { this.cx - 1 };
        if x < 0 {
            return;
        }
        let b = this.bufp();
        let s = this.rowStart(this.cy);
        if b.cells[s + x].width == 0 && x > 0 {
            x -= 1;
        }
        let c = b.cells[s + x];
        if c.cp == 0 {
            return;
        }
        if (c.marks & 0xffff) == 0 {
            b.cells[s + x].marks = u32(cp);
        } else if (c.marks >> 16) == 0 {
            b.cells[s + x].marks = c.marks | (u32(cp) << 16);
        } else {
            return;
        }
        this.touch(this.cy);
    }

    /// Sink: a C0 control. BEL counts in `bells`; the rest that matter are BS HT LF VT FF CR.
    fn exec(this: &Grid, c0: u8) {
        if c0 == 0x07 {
            this.bells += 1;
        } else if c0 == 0x08 {
            this.wrapPending = false;
            if this.cx > 0 {
                this.cx -= 1;
            }
        } else if c0 == 0x09 {
            this.tabForward(1);
        } else if c0 == 0x0a || c0 == 0x0b || c0 == 0x0c {
            this.index();
        } else if c0 == 0x0d {
            this.wrapPending = false;
            this.cx = 0;
        }
    }

    /// Move to the `n`th next tab stop (or the last column).
    fn tabForward(this: &Grid, n: int) {
        this.wrapPending = false;
        for k in 0..mn(n, this.ncols) {
            let x = this.cx + 1;
            while x < this.ncols - 1 && this.tabs[x] == 0 {
                x += 1;
            }
            this.cx = mn(x, this.ncols - 1);
        }
    }

    /// Move to the `n`th previous tab stop (or column 0).
    fn tabBack(this: &Grid, n: int) {
        this.wrapPending = false;
        for k in 0..mn(n, this.ncols) {
            let x = this.cx - 1;
            while x > 0 && this.tabs[x] == 0 {
                x -= 1;
            }
            this.cx = mx(x, 0);
        }
    }

    /// Sink: `ESC 7 8 D E M H c = >` and `ESC ( 0` / `ESC ( B`; others are ignored.
    fn esc(this: &Grid, inter: int, final: u8) {
        if inter == 0x28 {
            this.drawG0 = final == 0x30;
            return;
        }
        if inter != 0 {
            return;
        }
        if final == 0x37 {
            this.saveCursor();
        } else if final == 0x38 {
            this.restoreCursor();
        } else if final == 0x44 {
            this.index();
        } else if final == 0x45 {
            this.cx = 0;
            this.index();
        } else if final == 0x4d {
            this.reverseIndex();
        } else if final == 0x48 {
            this.tabs[this.cx] = 1;
        } else if final == 0x63 {
            this.fullReset();
        } else if final == 0x3d {
            this.modes |= MODE_KEYPAD;
        } else if final == 0x3e {
            this.modes &= ~MODE_KEYPAD;
        }
    }
}
