/// CSI dispatch of `Grid` (the `ansi.Sink` method `csi`): cursor movement, erasing, line and cell editing,
/// scrolling, SGR, status replies. Mode setting is in `modes.j3`. Part of `j3.term.grid`.

module j3.term.grid;

/// Parameter `i` as a count: empty or 0 means 1.
fn arg(p: &Params, i: int): int {
    let v = p.param(i, 1);
    return if v < 1 { 1 } else { v };
}

extend Grid {
    /// Lowest and highest row the cursor may be moved to by absolute addressing (the region under origin mode).
    fn rowLo(this: &Grid): int {
        return if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 };
    }

    fn rowHi(this: &Grid): int {
        return if (this.modes & MODE_ORIGIN) != 0 { this.bot } else { this.nrows - 1 };
    }

    /// CUP with 0-based `x` and `y` (`y` relative to the region under origin mode), clamped. Clears the pending wrap.
    fn moveTo(this: &Grid, x: int, y: int) {
        this.wrapPending = false;
        this.cx = mx(0, mn(x, this.ncols - 1));
        let base = if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 };
        this.cy = mx(this.rowLo(), mn(y + base, this.rowHi()));
    }

    /// Append `ESC [` to the reply buffer.
    fn replyCsi(this: &Grid) {
        this.reply.push(0x1b);
        this.reply.push(0x5b);
    }

    /// Sink: a CSI sequence. Unknown ones are ignored.
    fn csi(this: &Grid, p: &Params, final: u8) {
        if p.inter != 0 {
            if p.marker == 0 && p.inter == 0x20 && final == 0x71 {
                this.cursorShape = mx(0, mn(p.param(0, 0), 6));
            } else if p.marker == 0 && p.inter == 0x21 && final == 0x70 {
                this.softReset();
            } else if p.marker == 0x3f && p.inter == 0x24 && final == 0x70 {
                // DECRQM: CSI ? Ps ; Pm $ y
                let m = p.param(0, 0);
                this.replyCsi();
                this.reply.push(0x3f);
                this.reply.pushInt(m);
                this.reply.push(0x3b);
                this.reply.pushInt(this.decMode(m));
                this.reply.add("$y");
            }
            return;
        }
        if final == 0x75 && p.marker != 0 {
            this.kittyKeyboard(p);
            return;
        }
        if p.marker == 0x3f {
            if final == 0x68 {
                this.setModes(p, true);
            } else if final == 0x6c {
                this.setModes(p, false);
            }
            return;
        }
        if p.marker == 0x3e {
            if final == 0x63 {
                this.replyCsi();
                this.reply.add(">0;0;0c");
            }
            return;
        }
        if p.marker != 0 {
            return;
        }
        let n = arg(p, 0);
        let f = int(final);
        if f == 0x41 {
            // A CUU
            this.wrapPending = false;
            this.cy = mx(this.cy - n, if this.cy >= this.top { this.top } else { 0 });
        } else if f == 0x42 || f == 0x65 {
            // B CUD, e VPR
            this.wrapPending = false;
            this.cy = mn(this.cy + n, if this.cy <= this.bot { this.bot } else { this.nrows - 1 });
        } else if f == 0x43 || f == 0x61 {
            // C CUF, a HPR
            this.wrapPending = false;
            this.cx = mn(this.cx + n, this.ncols - 1);
        } else if f == 0x44 {
            // D CUB
            this.wrapPending = false;
            this.cx = mx(this.cx - n, 0);
        } else if f == 0x45 {
            // E CNL
            this.moveTo(0, this.cy - (if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 }) + n);
        } else if f == 0x46 {
            // F CPL
            this.moveTo(0, this.cy - (if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 }) - n);
        } else if f == 0x47 || f == 0x60 {
            // G CHA, ` HPA
            this.moveTo(n - 1, this.cy - (if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 }));
        } else if f == 0x64 {
            // d VPA
            this.moveTo(this.cx, n - 1);
        } else if f == 0x48 || f == 0x66 {
            // H CUP, f HVP
            this.moveTo(arg(p, 1) - 1, n - 1);
        } else if f == 0x4a {
            this.eraseDisplay(p.param(0, 0));
        } else if f == 0x4b {
            this.eraseLine(p.param(0, 0));
        } else if f == 0x4c {
            // L IL
            if this.cy >= this.top && this.cy <= this.bot {
                this.scrollRegion(this.cy, this.bot, n, false, false);
                this.cx = 0;
                this.wrapPending = false;
            }
        } else if f == 0x4d {
            // M DL
            if this.cy >= this.top && this.cy <= this.bot {
                this.scrollRegion(this.cy, this.bot, n, true, false);
                this.cx = 0;
                this.wrapPending = false;
            }
        } else if f == 0x40 {
            // @ ICH
            this.wrapPending = false;
            this.insertCells(n);
        } else if f == 0x50 {
            // P DCH
            this.wrapPending = false;
            this.deleteCells(n);
        } else if f == 0x58 {
            // X ECH
            this.eraseRow(this.cy, this.cx, this.cx + mn(n, this.ncols));
        } else if f == 0x53 {
            // S SU
            this.scrollRegion(this.top, this.bot, n, true, true);
        } else if f == 0x54 {
            // T SD (CSI T with several parameters is mouse tracking; not supported)
            if p.count() <= 1 {
                this.scrollRegion(this.top, this.bot, n, false, false);
            }
        } else if f == 0x72 {
            // r DECSTBM
            let t = p.param(0, 1);
            let b = p.param(1, 0);
            t = if t < 1 { 1 } else { t };
            b = if b < 1 || b > this.nrows { this.nrows } else { b };
            if t < b {
                this.top = t - 1;
                this.bot = b - 1;
                this.moveTo(0, 0);
            }
        } else if f == 0x67 {
            // g TBC
            let m = p.param(0, 0);
            if m == 0 {
                this.tabs[this.cx] = 0;
            } else if m == 3 {
                for x in 0..this.maxCols {
                    this.tabs[x] = 0;
                }
            }
        } else if f == 0x49 {
            // I CHT
            this.tabForward(n);
        } else if f == 0x5a {
            // Z CBT
            this.tabBack(n);
        } else if f == 0x62 {
            // b REP
            for k in 0..mn(n, this.ncols) {
                this.put(this.lastCp);
            }
        } else if f == 0x6d {
            this.pen = sgr(this.pen, p);
        } else if f == 0x68 || f == 0x6c {
            // h SM, l RM
            for i in 0..p.count() {
                if p.param(i, 0) == 4 {
                    this.modes = if f == 0x68 { this.modes | MODE_INSERT } else { this.modes & ~MODE_INSERT };
                }
            }
        } else if f == 0x6e {
            // n DSR
            let m = p.param(0, 0);
            if m == 5 {
                this.replyCsi();
                this.reply.add("0n");
            } else if m == 6 {
                this.replyCsi();
                this.reply.pushInt(this.cy - (if (this.modes & MODE_ORIGIN) != 0 { this.top } else { 0 }) + 1);
                this.reply.push(0x3b);
                this.reply.pushInt(this.cx + 1);
                this.reply.push(0x52);
            }
        } else if f == 0x63 {
            // c DA1
            if p.param(0, 0) == 0 {
                this.replyCsi();
                this.reply.add("?62;22c");
            }
        }
    }

    /// Kitty keyboard protocol: `CSI > f u` push, `CSI < n u` pop, `CSI = f ; m u` set (1 all, 2 or, 3 and-not),
    /// `CSI ? u` query (replies `CSI ? flags u`). The stack belongs to the screen showing (primary or alt).
    fn kittyKeyboard(this: &Grid, p: &Params) {
        let base = if this.isAlt { 8 } else { 0 };
        let idx = if this.isAlt { this.kbdAlt } else { this.kbdPri };
        let m = p.marker;
        if m == 0x3f {
            this.replyCsi();
            this.reply.push(0x3f);
            this.reply.pushInt(this.kbd[base + idx]);
            this.reply.push(0x75);
            return;
        }
        if m == 0x3e {
            if idx == 7 {
                for i in 0..7 {
                    this.kbd[base + i] = this.kbd[base + i + 1];
                }
            } else {
                idx += 1;
            }
            this.kbd[base + idx] = p.param(0, 0) & 31;
        } else if m == 0x3c {
            for k in 0..mn(arg(p, 0), 8) {
                this.kbd[base + idx] = 0;
                if idx > 0 {
                    idx -= 1;
                }
            }
        } else if m == 0x3d {
            let f = p.param(0, 0) & 31;
            let how = p.param(1, 1);
            let cur = this.kbd[base + idx];
            this.kbd[base + idx] = if how == 2 { cur | f } else if how == 3 { cur & ~f } else { f };
        }
        if this.isAlt {
            this.kbdAlt = idx;
        } else {
            this.kbdPri = idx;
        }
        this.syncKbd();
    }

    /// Copy the showing screen's kitty flags into `modes`.
    fn syncKbd(this: &Grid) {
        let f = if this.isAlt { this.kbd[8 + this.kbdAlt] } else { this.kbd[this.kbdPri] };
        this.modes = (this.modes & ~MODE_KITTY_MASK) | (f << MODE_KITTY_SHIFT);
    }

    /// ED/EL/ECH keep the pending-wrap flag (the cursor does not move); ICH/DCH/IL/DL clear it.
    /// ED: 0 cursor to end, 1 start to cursor, 2 all, 3 all and the scrollback. The cursor stays.
    fn eraseDisplay(this: &Grid, m: int) {
        if m == 0 {
            this.eraseRow(this.cy, this.cx, this.ncols);
            for y in (this.cy + 1)..this.nrows {
                this.eraseRow(y, 0, this.ncols);
            }
        } else if m == 1 {
            for y in 0..this.cy {
                this.eraseRow(y, 0, this.ncols);
            }
            this.eraseRow(this.cy, 0, this.cx + 1);
        } else if m == 2 || m == 3 {
            for y in 0..this.nrows {
                this.eraseRow(y, 0, this.ncols);
            }
            if m == 3 && !this.isAlt {
                this.sbCount = 0;
                this.sbHead = 0;
            }
            this.kClear(m == 3);
        }
    }

    /// EL: 0 cursor to end, 1 start to cursor, 2 whole line.
    fn eraseLine(this: &Grid, m: int) {
        if m == 0 {
            this.eraseRow(this.cy, this.cx, this.ncols);
        } else if m == 1 {
            this.eraseRow(this.cy, 0, this.cx + 1);
        } else if m == 2 {
            this.eraseRow(this.cy, 0, this.ncols);
        }
    }
}
