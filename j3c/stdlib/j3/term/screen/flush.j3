// `Screen.flush`: diff the back buffer against the front buffer and write the difference in one go.
// Part of `j3.term.screen`.

module j3.term.screen;



/// SGR parameters for color `c`; `base` is 30 (foreground) or 40 (background).
fn pushColor(out: &Text, c: Color, base: int) {
    let k = c.kind();
    if k == COLOR_DEFAULT {
        out.pushInt(base + 9);
    } else if k == COLOR_PALETTE {
        let n = c.index();
        if n < 8 {
            out.pushInt(base + n);
        } else if n < 16 {
            out.pushInt(base + 60 + n - 8);
        } else {
            out.pushInt(base + 8);
            out.pushStr(";5;");
            out.pushInt(n);
        }
    } else {
        out.pushInt(base + 8);
        out.pushStr(";2;");
        out.pushInt(c.r());
        out.push(59);
        out.pushInt(c.g());
        out.push(59);
        out.pushInt(c.b());
    }
}

/// The SGR sequence that turns the pen `from` into `to`: only what changed, or a reset plus everything when an
/// attribute has to go off (SGR has no safe per-attribute "off" for bold/dim).
fn sgrDelta(out: &Text, from: Style, to: Style) {
    if from == to {
        return;
    }
    out.push(27);
    out.push(91);
    let n = 0;
    let f = from;
    if (int(from.attr) & ~int(to.attr)) != 0 {
        out.pushInt(0);
        n = 1;
        f = Style.plain();
    }
    let codes: [8]int = [1, 2, 3, 4, 5, 7, 8, 9];
    for b in 0..8 {
        let bit = 1 << b;
        if (int(to.attr) & bit) != 0 && (int(f.attr) & bit) == 0 {
            if n > 0 { out.push(59); }
            out.pushInt(codes[b]);
            n += 1;
        }
    }
    if !(to.fg == f.fg) {
        if n > 0 { out.push(59); }
        pushColor(out, to.fg, 30);
        n += 1;
    }
    if !(to.bg == f.bg) {
        if n > 0 { out.push(59); }
        pushColor(out, to.bg, 40);
        n += 1;
    }
    out.push(109);
}

fn sameCell(a: Cell, b: Cell): bool {
    return a.cp == b.cp && a.width == b.width && a.style == b.style;
}

extend Screen {
    /// Hide the cursor before the first thing a frame draws (shown again at the end if the app wants it).
    fn quiet(this: &Screen) {
        if this.termVis {
            this.out.push(27);
            this.out.pushStr("[?25l");
            this.termVis = false;
        }
    }

    /// Emit the shortest cursor move to `(x, y)`: nothing when already there, CUF along a row, else CUP.
    fn moveTo(this: &Screen, x: int, y: int) {
        if this.posKnown && this.posX == x && this.posY == y {
            return;
        }
        let o = &this.out;
        o.push(27);
        o.push(91);
        if this.posKnown && this.posY == y && x > this.posX {
            if x - this.posX > 1 {
                o.pushInt(x - this.posX);
            }
            o.push(67);
        } else {
            o.pushInt(y + 1);
            o.push(59);
            o.pushInt(x + 1);
            o.push(72);
        }
        this.posX = x;
        this.posY = y;
        this.posKnown = true;
    }

    /// Send what changed since the last flush with one `write` (nothing when nothing changed). A frame after a resize,
    /// and the first frame, clear the screen and draw everything. False when the write failed.
    fn flush(this: &Screen): bool {
        let o = &this.out;
        o.clear();
        let cols = this.ncols;
        if this.full {
            this.full = false;
            this.quiet();
            o.push(27);
            o.pushStr("[0m");
            o.push(27);
            o.pushStr("[2J");
            this.pen = Style.plain();
            this.posKnown = false;
            let blank = Cell.blank(Style.plain());
            for i in 0..cols * this.nrows {
                this.front[i] = blank;
            }
        }
        for y in 0..this.nrows {
            let x = 0;
            while x < cols {
                let i = y * cols + x;
                let b = this.back[i];
                if b.width == 0 || sameCell(b, this.front[i]) {
                    x += 1;
                    continue;
                }
                this.quiet();
                this.moveTo(x, y);
                sgrDelta(o, this.pen, b.style);
                this.pen = b.style;
                pushUtf8(o, if b.cp == 0 { 32 } else { b.cp });
                let w = int(b.width);
                this.front[i] = b;
                if w == 2 {
                    this.front[i + 1] = this.back[i + 1];
                }
                this.posX += w;
                if this.posX >= cols {
                    // after the last column the cursor is in "pending wrap": its place is not reliable
                    this.posKnown = false;
                }
                x += w;
            }
        }
        if this.curVis {
            let cx = if this.curX >= cols { cols - 1 } else { this.curX };
            let cy = if this.curY >= this.nrows { this.nrows - 1 } else { this.curY };
            this.moveTo(if cx < 0 { 0 } else { cx }, if cy < 0 { 0 } else { cy });
            if !this.termVis {
                o.push(27);
                o.pushStr("[?25h");
                this.termVis = true;
            }
        } else {
            this.quiet();
        }
        this.lastBytes = o.len();
        if this.lastBytes == 0 {
            return true;
        }
        return writeAll(this.outFd, o.bytes.ptr as ptr, this.lastBytes);
    }
}
