// Drawing into the back buffer of `Screen`: `put`, `fill`, `box`, `clear`, clip rects, cursor. Part of `j3.term.screen`.

module j3.term.screen;


extend Screen {
    /// Blank the cell next to a wide char that a write at index `i` (column `x`) is about to cut in half.
    fn repair(this: &Screen, i: int, x: int) {
        let c = this.back[i];
        if c.width == 0 && x > 0 {
            this.back[i - 1] = Cell.blank(this.back[i - 1].style);
        } else if c.width == 2 && x + 1 < this.ncols {
            this.back[i + 1] = Cell.blank(c.style);
        }
    }

    /// Store a cell of width `w` (1 or 2) at an in-bounds, unclipped place.
    fn setCell(this: &Screen, x: int, y: int, cp: i32, w: int, style: Style) {
        let i = y * this.ncols + x;
        this.repair(i, x);
        if w == 2 {
            this.repair(i + 1, x + 1);
            this.back[i + 1] = Cell { cp: 0, style: style, width: 0, link: 0, marks: 0 };
        }
        this.back[i] = Cell { cp: cp, style: style, width: u8(w), link: 0, marks: 0 };
    }

    /// Draw the UTF-8 text `s` at `(x, y)` in `style`: wide characters take two columns, combining marks and control
    /// bytes are skipped, cells outside the screen or the clip rect are not drawn (a wide character cut by the clip is
    /// dropped). No wrapping. Returns the columns the text spans, drawn or not, so callers can lay out the next piece.
    fn put(this: &Screen, x: int, y: int, s: string, style: Style): int {
        let col = x;
        let i = 0;
        let used = 0;
        let n = 1;
        while i < s.len {
            let cp = decodeUtf8(s, i, &n);
            if n == 0 {
                n = 1;
            }
            i += n;
            let w = cpWidth(cp);
            if w == 0 {
                continue;
            }
            if y >= this.cy0 && y < this.cy1 && col >= this.cx0 && col + w <= this.cx1 {
                this.setCell(col, y, cp, w, style);
            }
            col += w;
            used += w;
        }
        return used;
    }

    /// Fill the rect with `cp` (0 or 32 for blanks) in `style`.
    fn fill(this: &Screen, x: int, y: int, w: int, h: int, cp: i32, style: Style) {
        let cw = cpWidth(cp);
        if cw == 0 {
            cw = 1;
        }
        let x0 = if x < this.cx0 { this.cx0 } else { x };
        let y0 = if y < this.cy0 { this.cy0 } else { y };
        let x1 = if x + w > this.cx1 { this.cx1 } else { x + w };
        let y1 = if y + h > this.cy1 { this.cy1 } else { y + h };
        // keep wide fills aligned to the rect's own left edge
        for yy in y0..y1 {
            let xx = x + ((x0 - x + cw - 1) / cw) * cw;
            while xx + cw <= x1 {
                this.setCell(xx, yy, cp, cw, style);
                xx += cw;
            }
        }
    }

    /// A single-line box: its outer edge is the `w` x `h` rect at `(x, y)` (at least 2 x 2); the inside is untouched.
    fn box(this: &Screen, x: int, y: int, w: int, h: int, style: Style) {
        if w < 2 || h < 2 {
            return;
        }
        this.fill(x, y, 1, 1, 0x250C, style);
        this.fill(x + w - 1, y, 1, 1, 0x2510, style);
        this.fill(x, y + h - 1, 1, 1, 0x2514, style);
        this.fill(x + w - 1, y + h - 1, 1, 1, 0x2518, style);
        this.fill(x + 1, y, w - 2, 1, 0x2500, style);
        this.fill(x + 1, y + h - 1, w - 2, 1, 0x2500, style);
        this.fill(x, y + 1, 1, h - 2, 0x2502, style);
        this.fill(x + w - 1, y + 1, 1, h - 2, 0x2502, style);
    }

    /// Blank the whole back buffer (plain style), ignoring the clip.
    fn clear(this: &Screen) {
        let blank = Cell.blank(Style.plain());
        for i in 0..this.ncols * this.nrows {
            this.back[i] = blank;
        }
    }

    /// Restrict drawing to the rect (intersected with the current clip) until `clipPop`. Up to 16 levels deep.
    fn clipPush(this: &Screen, x: int, y: int, w: int, h: int) {
        if this.nclips >= MAX_CLIPS {
            sys.panic("screen: clipPush nested more than 16 deep");
        }
        let b = this.nclips * 4;
        this.clips[b] = this.cx0;
        this.clips[b + 1] = this.cy0;
        this.clips[b + 2] = this.cx1;
        this.clips[b + 3] = this.cy1;
        this.nclips += 1;
        if x > this.cx0 { this.cx0 = x; }
        if y > this.cy0 { this.cy0 = y; }
        if x + w < this.cx1 { this.cx1 = x + w; }
        if y + h < this.cy1 { this.cy1 = y + h; }
    }

    /// Undo the last `clipPush` (no-op when there is none).
    fn clipPop(this: &Screen) {
        if this.nclips == 0 {
            return;
        }
        this.nclips -= 1;
        let b = this.nclips * 4;
        this.cx0 = this.clips[b];
        this.cy0 = this.clips[b + 1];
        this.cx1 = this.clips[b + 2];
        this.cy1 = this.clips[b + 3];
    }

    /// Where the terminal cursor goes at the next flush, and whether it is shown (it starts hidden).
    fn setCursor(this: &Screen, x: int, y: int, visible: bool) {
        this.curX = x;
        this.curY = y;
        this.curVis = visible;
    }
}
