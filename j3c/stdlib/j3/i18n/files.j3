// Part of j3.i18n: locale file loading, parsing, lookup tables, plural entry; the module doc and `use`s are in ../i18n.j3.
module j3.i18n;

// Files

fn loadTab(name: string) {
    let t = &TABS[NTAB];
    NTAB += 1;
    let p = Text.new(&ARENA);
    p.pushStr(DIR);
    p.push(47);
    p.pushStr(name);
    p.pushStr(".txt");
    t.name = copy(name);
    t.path = p.bytes as string;
    match readFile(t.path, &ARENA) {
        Result.Ok(b) { parse(t, b); }
        Result.Err(_) { parse(t, ARENA.alloc::<u8>(0)); }
    }
}

fn parse(t: &Tab, bytes: []u8) {
    t.file = bytes;
    let lines = 1;
    for b in bytes {
        if b == 10 { lines += 1; }
    }
    t.keys = ARENA.alloc::<string>(lines);
    t.vals = ARENA.alloc::<string>(lines);
    t.slots = ARENA.alloc::<int>(lines * 2 + 1);
    for i in 0..t.slots.len {
        t.slots[i] = 0;
    }
    t.n = 0;
    let i = 0;
    while i < bytes.len {
        let e = i;
        while e < bytes.len && bytes[e] != 10 {
            e += 1;
        }
        addLine(t, bytes[i..e]);
        i = e + 1;
    }
}

// `key = text`; `#` starts a comment line; `\n`, `\t`, `\\` in the text; later duplicate keys win.
fn addLine(t: &Tab, line: []u8) {
    let l = trim(line);
    if l.len == 0 || l[0] == 35 {
        return;
    }
    let eq = indexOf(l, 61);
    if eq <= 0 {
        return;
    }
    let key = trim(l[0..eq]) as string;
    let v = trim(l[eq + 1..l.len]);
    let val = v as string;
    if indexOf(v, 92) >= 0 {
        val = unescape(v);
    }
    let cap = t.slots.len;
    let pos = slot(key, cap);
    while t.slots[pos] != 0 {
        if same(t.keys[t.slots[pos] - 1], key) {
            t.vals[t.slots[pos] - 1] = val;
            return;
        }
        pos = (pos + 1) % cap;
    }
    t.keys[t.n] = key;
    t.vals[t.n] = val;
    t.n += 1;
    t.slots[pos] = t.n;
}

fn lookup(t: &Tab, key: string): int {
    let cap = t.slots.len;
    if cap == 0 {
        return -1;
    }
    let pos = slot(key, cap);
    while t.slots[pos] != 0 {
        if same(t.keys[t.slots[pos] - 1], key) {
            return t.slots[pos] - 1;
        }
        pos = (pos + 1) % cap;
    }
    return -1;
}

fn slot(key: string, cap: int): int {
    let h = 5381;
    for i in 0..key.len {
        h = h * 33 + int(key[i]);
    }
    let m = h % cap;
    if m < 0 { m += cap; }
    return m;
}

fn unescape(v: []u8): string {
    let o = Text.new(&ARENA);
    let i = 0;
    while i < v.len {
        if v[i] == 92 && i + 1 < v.len {
            let c = v[i + 1];
            if c == 110 {
                o.push(10);
            } else if c == 116 {
                o.push(9);
            } else if c == 92 {
                o.push(92);
            } else {
                o.push(92);
                o.push(c);
            }
            i += 2;
        } else {
            o.push(v[i]);
            i += 1;
        }
    }
    return o.bytes as string;
}

fn trim(b: []u8): []u8 {
    let a = 0;
    let e = b.len;
    while a < e && (b[a] == 32 || b[a] == 9 || b[a] == 13) {
        a += 1;
    }
    while e > a && (b[e - 1] == 32 || b[e - 1] == 9 || b[e - 1] == 13) {
        e -= 1;
    }
    return b[a..e];
}

fn indexOf(b: []u8, c: u8): int {
    for i in 0..b.len {
        if b[i] == c { return i; }
    }
    return -1;
}

fn sameBytes(a: []u8, b: []u8): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] { return false; }
    }
    return true;
}

fn copyBytes(b: []u8): []u8 {
    let c = ARENA.alloc::<u8>(b.len);
    for i in 0..b.len {
        c[i] = b[i];
    }
    return c;
}

fn copy(s: string): string {
    let c = Text.new(&ARENA);
    c.pushStr(s);
    return c.bytes as string;
}

/// The CLDR plural category (`zero`, `one`, `two`, `few`, `many`, `other`) of `n` in language `lang`
/// (`j3c doc j3.i18nplural plural` has the rules). `frac` says the number has a visible fraction (1.5).
pub fn plural(lang: string, n: int, frac: bool): string {
    return i18nplural.plural(lang, n, frac);
}
