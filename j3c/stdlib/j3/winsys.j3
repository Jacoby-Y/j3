/// Win32 calls shared by the Windows twins of `j3.proc`, `j3.term.pty`, `j3.io.watch`, `j3.instance` and
/// `j3.game.hotkey`: kernel32 bindings, UTF-8 <-> UTF-16, command lines, environment blocks, pipe peeks.
/// Only those `*_windows.j3` files import it; it is not part of the documented stdlib.

module j3.winsys;

use j3.memory.Arena;
use j3.sys;
use j3.text.Text;

use lib "kernel32" as k32 {
    fn CreatePipe(r: ptr, w: ptr, sa: ptr, size: u32): i32;
    fn SetHandleInformation(h: int, mask: u32, flags: u32): i32;
    fn PeekNamedPipe(h: int, buf: ptr, n: u32, got: ptr, avail: ptr, left: ptr): i32;
    fn ReadFile(file: int, buf: ptr, n: u32, got: ptr, ov: ptr): i32;
    fn WriteFile(file: int, buf: ptr, n: u32, wrote: ptr, ov: ptr): i32;
    fn CloseHandle(file: int): i32;
    fn CreateProcessW(app: ptr, cmd: ptr, psa: ptr, tsa: ptr, inherit: i32, flags: u32, env: ptr, cwd: ptr, si: ptr, pi: ptr): i32;
    fn WaitForSingleObject(h: int, ms: u32): u32;
    fn WaitForMultipleObjects(n: u32, hs: ptr, all: i32, ms: u32): u32;
    fn GetExitCodeProcess(h: int, code: ptr): i32;
    fn TerminateProcess(h: int, code: u32): i32;
    fn MultiByteToWideChar(cp: u32, flags: u32, s: ptr, n: i32, w: ptr, wn: i32): i32;
    fn WideCharToMultiByte(cp: u32, flags: u32, w: ptr, wn: i32, s: ptr, n: i32, def: ptr, used: ptr): i32;
    fn GetEnvironmentStringsW(): ptr;
    fn FreeEnvironmentStringsW(p: ptr): i32;
    fn Sleep(ms: u32);
    fn GetLastError(): u32;
    fn GetTickCount64(): u64;
    fn InitializeProcThreadAttributeList(list: ptr, n: u32, flags: u32, size: ptr): i32;
    fn UpdateProcThreadAttribute(list: ptr, flags: u32, attr: int, val: ptr, size: int, prev: ptr, ret: ptr): i32;
    fn DeleteProcThreadAttributeList(list: ptr);
    fn CreatePseudoConsole(size: u32, hin: int, hout: int, flags: u32, hpc: ptr): i32;
    fn ResizePseudoConsole(hpc: int, size: u32): i32;
    fn ClosePseudoConsole(hpc: int);
    fn CreateEventA(sa: ptr, manual: i32, initial: i32, name: ptr): int;
    fn SetEvent(h: int): i32;
    fn CreateFileW(name: ptr, access: u32, share: u32, sec: ptr, disp: u32, attr: u32, templ: int): int;
    fn CreateFileA(name: ptr, access: u32, share: u32, sec: ptr, disp: u32, attr: u32, templ: int): int;
    fn ReadDirectoryChangesW(h: int, buf: ptr, n: u32, subtree: i32, filter: u32, got: ptr, ov: ptr, done: ptr): i32;
    fn GetOverlappedResult(h: int, ov: ptr, got: ptr, wait: i32): i32;
    fn CancelIoEx(h: int, ov: ptr): i32;
    fn CreateNamedPipeA(name: ptr, open: u32, mode: u32, max: u32, outSize: u32, inSize: u32, ms: u32, sa: ptr): int;
    fn ConnectNamedPipe(h: int, ov: ptr): i32;
    fn DisconnectNamedPipe(h: int): i32;
    fn SetNamedPipeHandleState(h: int, mode: ptr, max: ptr, ms: ptr): i32;
    fn WaitNamedPipeA(name: ptr, ms: u32): i32;
    fn FlushFileBuffers(h: int): i32;
    fn GetModuleHandleA(name: ptr): int;
    fn GetStdHandle(kind: u32): int;
    fn SetStdHandle(kind: u32, h: int): i32;
}

pub const INVALID: int = 0 - 1;
pub const ERROR_FILE_NOT_FOUND: int = 2;
pub const ERROR_PATH_NOT_FOUND: int = 3;
pub const ERROR_ACCESS_DENIED: int = 5;
pub const ERROR_BROKEN_PIPE: int = 109;
pub const ERROR_PIPE_BUSY: int = 231;
pub const ERROR_NO_DATA: int = 232;
pub const ERROR_PIPE_CONNECTED: int = 535;
pub const ERROR_OPERATION_ABORTED: int = 995;
pub const ERROR_IO_INCOMPLETE: int = 996;
pub const STILL_ACTIVE: int = 259;
pub const WAIT_OBJECT_0: int = 0;
pub const INFINITE: u32 = 0xFFFFFFFF;
/// `PROC_THREAD_ATTRIBUTE_HANDLE_LIST`, `PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE`.
pub const ATTR_HANDLE_LIST: int = 0x20002;
pub const ATTR_PSEUDOCONSOLE: int = 0x20016;
pub const EXTENDED_STARTUPINFO_PRESENT: u32 = 0x80000;
pub const CREATE_UNICODE_ENVIRONMENT: u32 = 0x400;
pub const CREATE_NO_WINDOW: u32 = 0x08000000;
pub const STARTF_USESTDHANDLES: u32 = 0x100;
/// `STARTUPINFOEXW` on x64: `STARTUPINFOW` (104 bytes) plus the attribute list pointer.
pub const SI_SIZE: int = 112;

pub fn lastError(): int {
    return int(k32.GetLastError());
}

/// Milliseconds since boot (`GetTickCount64`): `sys.monotonicMs` is 0 on Windows.
pub fn nowMs(): int {
    return int(k32.GetTickCount64());
}

pub fn sleepMs(ms: int) {
    k32.Sleep(u32(if ms < 0 { 0 } else { ms }));
}

pub fn close(h: int) {
    if h != 0 && h != INVALID {
        k32.CloseHandle(h);
    }
}

/// Bytes waiting in pipe `h`, or -1 when the other end is closed (or `h` is no pipe).
pub fn avail(h: int): int {
    let n: u32 = 0;
    if k32.PeekNamedPipe(h, 0 as ptr, u32(0), 0 as ptr, &n as ptr, 0 as ptr) == 0 {
        return -1;
    }
    return int(n);
}

/// `ReadFile` into `buf`: the count, 0 at the end of a pipe, -1 on failure.
pub fn read(h: int, buf: []u8): int {
    let got: u32 = 0;
    if k32.ReadFile(h, buf.ptr as ptr, u32(buf.len), &got as ptr, 0 as ptr) == 0 {
        return if lastError() == ERROR_BROKEN_PIPE { 0 } else { -1 };
    }
    return int(got);
}

/// Write all of `n` bytes at `p` to `h` (blocks while the pipe is full). False when the reader is gone.
pub fn writeAll(h: int, p: ptr, n: int): bool {
    let at = 0;
    while at < n {
        let wrote: u32 = 0;
        if k32.WriteFile(h, (p as int + at) as ptr, u32(n - at), &wrote as ptr, 0 as ptr) == 0 || wrote == u32(0) {
            return false;
        }
        at += int(wrote);
    }
    return true;
}

/// A pipe (`CreatePipe`): read end, write end. `inherit` makes both inheritable (clear the parent's end after).
pub fn pipe(inherit: bool, ends: []int): bool {
    let sa: [3]int = [24, 0, if inherit { 1 } else { 0 }];
    return k32.CreatePipe(&ends[0] as ptr, &ends[1] as ptr, &sa[0] as ptr, u32(65536)) != 0;
}

/// Keep `h` out of child processes.
pub fn noInherit(h: int) {
    k32.SetHandleInformation(h, u32(1), u32(0));
}

/// `s` as NUL-terminated UTF-16 on `arena`.
pub fn wide(s: string, arena: &Arena): ptr {
    let n = if s.len == 0 { 0 } else { int(k32.MultiByteToWideChar(u32(65001), u32(0), s.ptr as ptr, i32(s.len), 0 as ptr, i32(0))) };
    let out = arena.alloc::<u16>(n + 1);
    if n > 0 {
        k32.MultiByteToWideChar(u32(65001), u32(0), s.ptr as ptr, i32(s.len), out.ptr as ptr, i32(n));
    }
    out[n] = u16(0);
    return out.ptr as ptr;
}

/// `n` UTF-16 units at `w` as UTF-8 into `out`: the bytes written (cut at `out.len`).
pub fn utf8(w: ptr, n: int, out: []u8): int {
    if n == 0 || out.len == 0 {
        return 0;
    }
    return int(k32.WideCharToMultiByte(u32(65001), u32(0), w, i32(n), out.ptr as ptr, i32(out.len), 0 as ptr, 0 as ptr));
}

/// Append `a` to a command line the way `CommandLineToArgvW` / the C runtime read it back.
pub fn quoteArg(t: &Text, a: string) {
    let plain = a.len > 0;
    for i in 0..a.len {
        if a[i] == 32 || a[i] == 9 || a[i] == 10 || a[i] == 11 || a[i] == 34 {
            plain = false;
        }
    }
    if plain {
        t.pushStr(a);
        return;
    }
    t.push(34);
    let slashes = 0;
    for i in 0..a.len {
        if a[i] == 92 {
            slashes += 1;
            continue;
        }
        // backslashes before a quote are doubled, plus one to escape the quote
        let n = if a[i] == 34 { slashes * 2 + 1 } else { slashes };
        for k in 0..n { t.push(92); }
        t.push(a[i]);
        slashes = 0;
    }
    for k in 0..slashes * 2 { t.push(92); }
    t.push(34);
}

/// `argv` as one command line, the program `path` (already resolved) first. A `.bat`/`.cmd` runs through
/// `cmd.exe /d /s /c`. ponytail: cmd.exe has its own metacharacters (`&|<>^%`); arguments with them reach a batch
/// file unescaped, so do not pass untrusted text to one.
pub fn cmdLine(path: string, argv: []string, arena: &Arena): ptr {
    let t = Text.new(arena);
    let batch = endsWithFold(path, ".bat") || endsWithFold(path, ".cmd");
    if batch {
        t.pushStr("cmd.exe /d /s /c \"");
    }
    quoteArg(&t, path);
    for i in 1..argv.len {
        t.push(32);
        quoteArg(&t, argv[i]);
    }
    if batch {
        t.push(34);
    }
    return wide(t.str(), arena);
}

pub fn endsWithFold(s: string, end: string): bool {
    if s.len < end.len {
        return false;
    }
    for i in 0..end.len {
        if fold(int(s[s.len - end.len + i])) != fold(int(end[i])) {
            return false;
        }
    }
    return true;
}

/// ASCII lower case.
pub fn fold(c: int): int {
    return if c >= 65 && c <= 90 { c + 32 } else { c };
}

/// `name` itself when it has a path separator or drive, else the first `dir\name[.exe|.com|.bat|.cmd]` on `PATH`.
/// "" when none.
pub fn findProgram(name: string, arena: &Arena): string {
    let exts: [5]string = ["", ".exe", ".com", ".bat", ".cmd"];
    for i in 0..name.len {
        if name[i] == 47 || name[i] == 92 || name[i] == 58 {
            for e in 0..5 {
                let full = joinC("", name, exts[e], arena);
                if sys.canExec(full.ptr) {
                    return full.str;
                }
            }
            return "";
        }
    }
    let path = sys.env("PATH");
    let start = 0;
    let i = 0;
    while i <= path.len {
        if i == path.len || path[i] == 59 {
            let dir = path[start..i];
            if dir.len > 0 {
                for e in 0..5 {
                    // a name without an extension is never run as is (Windows needs one)
                    if e == 0 && !hasExt(name) { continue; }
                    let full = joinC(dir, name, exts[e], arena);
                    if sys.canExec(full.ptr) {
                        return full.str;
                    }
                }
            }
            start = i + 1;
        }
        i += 1;
    }
    return "";
}

fn hasExt(name: string): bool {
    for i in 0..name.len {
        if name[i] == 46 { return true; }
    }
    return false;
}

struct CPath {
    str: string;
    ptr: ptr;
}

/// `dir\name ext` as a string and a NUL-terminated copy.
fn joinC(dir: string, name: string, ext: string, arena: &Arena): CPath {
    let t = Text.new(arena);
    if dir.len > 0 {
        t.pushStr(dir);
        if dir[dir.len - 1] != 92 && dir[dir.len - 1] != 47 { t.push(92); }
    }
    t.pushStr(name);
    t.pushStr(ext);
    let s = t.str();
    t.push(0);
    return CPath { str: s, ptr: t.bytes.ptr as ptr };
}

/// UTF-16 units in the NUL-terminated string at `w`.
fn wlen(w: int): int {
    let n = 0;
    while true {
        let c = (w + n * 2) as ptr as &u16;
        if *c == u16(0) { return n; }
        n += 1;
    }
    return n;
}

/// Units of the name in `NAME=value` at `w` (`n` units); a leading `=` belongs to the name (`=C:=C:\`).
fn wkey(w: int, n: int): int {
    for i in 1..n {
        let c = (w + i * 2) as ptr as &u16;
        if *c == u16(61) { return i; }
    }
    return n;
}

fn wsameKey(a: int, an: int, b: int, bn: int): bool {
    let ka = wkey(a, an);
    if ka != wkey(b, bn) { return false; }
    for i in 0..ka {
        let x = (a + i * 2) as ptr as &u16;
        let y = (b + i * 2) as ptr as &u16;
        if fold(int(*x)) != fold(int(*y)) { return false; }
    }
    return true;
}

/// A `CREATE_UNICODE_ENVIRONMENT` block: the inherited environment minus every name in `over` (`K=V`, names compared
/// without case), then `over` (the last of a repeated name wins).
pub fn envBlock(over: []string, arena: &Arena): ptr {
    let ow = arena.alloc::<int>(over.len);
    let on = arena.alloc::<int>(over.len);
    for j in 0..over.len {
        ow[j] = wide(over[j], arena) as int;
        on[j] = wlen(ow[j]);
    }
    let base = k32.GetEnvironmentStringsW();
    // measure, then copy
    let total = 1;
    for pass in 0..2 {
        let out: []u16 = if pass == 0 { arena.alloc::<u16>(0) } else { arena.alloc::<u16>(total) };
        let at = 0;
        let p = base as int;
        while base as int != 0 {
            let n = wlen(p);
            if n == 0 { break; }
            let hit = false;
            for j in 0..over.len {
                if wsameKey(p, n, ow[j], on[j]) { hit = true; }
            }
            if !hit {
                if pass == 1 { copyUnits(out, at, p, n); }
                at += n + 1;
            }
            p += (n + 1) * 2;
        }
        for j in 0..over.len {
            let later = false;
            for k in j + 1..over.len {
                if wsameKey(ow[j], on[j], ow[k], on[k]) { later = true; }
            }
            if !later && on[j] > 0 {
                if pass == 1 { copyUnits(out, at, ow[j], on[j]); }
                at += on[j] + 1;
            }
        }
        if pass == 0 {
            total = at + 1;
        } else {
            out[at] = u16(0);
            if base as int != 0 { k32.FreeEnvironmentStringsW(base); }
            return out.ptr as ptr;
        }
    }
    return 0 as ptr;
}

/// `n` units from `w` into `out` at `at`, then a NUL.
fn copyUnits(out: []u16, at: int, w: int, n: int) {
    for i in 0..n {
        let c = (w + i * 2) as ptr as &u16;
        out[at + i] = *c;
    }
    out[at + n] = u16(0);
}

/// An initialized `PROC_THREAD_ATTRIBUTE_LIST` with room for one attribute, on `arena`.
pub fn attrList(arena: &Arena): ptr {
    let size: int = 0;
    k32.InitializeProcThreadAttributeList(0 as ptr, u32(1), u32(0), &size as ptr);
    let mem = arena.alloc::<int>(size / 8 + 1);
    if k32.InitializeProcThreadAttributeList(mem.ptr as ptr, u32(1), u32(0), &size as ptr) == 0 {
        return 0 as ptr;
    }
    return mem.ptr as ptr;
}

/// Exit code of process `h` if it has ended, -1 while it runs.
pub fn exitCodeIfDone(h: int): int {
    if k32.WaitForSingleObject(h, u32(0)) != u32(0) {
        return -1;
    }
    let code: u32 = 0;
    if k32.GetExitCodeProcess(h, &code as ptr) == 0 {
        return 1;
    }
    return int(code);
}

/// Process id and handle from a `PROCESS_INFORMATION` (thread handle closed).
pub struct Started {
    h: int;
    pid: int;
}

/// `CreateProcessW` with a filled `STARTUPINFOEXW` `si` (`SI_SIZE` bytes). `Started.h` is 0 on failure (`lastError`).
pub fn create(cmd: ptr, inherit: bool, flags: u32, env: ptr, cwd: ptr, si: ptr): Started {
    let pi: [3]int = [0, 0, 0];
    if k32.CreateProcessW(0 as ptr, cmd, 0 as ptr, 0 as ptr, if inherit { 1 } else { 0 }, flags | EXTENDED_STARTUPINFO_PRESENT, env, cwd, si, &pi[0] as ptr) == 0 {
        return Started { h: 0, pid: 0 };
    }
    close(pi[1]);
    return Started { h: pi[0], pid: pi[2] % 4294967296 };
}

/// `WaitForSingleObject`: true when `h` is signaled within `ms` (`INFINITE` waits forever).
pub fn waitFor(h: int, ms: u32): bool {
    return k32.WaitForSingleObject(h, ms) == u32(0);
}

/// `WaitForMultipleObjects` on `n` handles, any one: its index, or -1 on failure or timeout.
pub fn waitAnyOf(hs: ptr, n: int, ms: u32): int {
    let r = int(k32.WaitForMultipleObjects(u32(n), hs, 0, ms));
    return if r >= 0 && r < n { r } else { -1 };
}

pub fn terminate(h: int, code: int) {
    k32.TerminateProcess(h, u32(code));
}

/// Put `size` bytes at `val` as attribute `attr` of a list from `attrList`.
pub fn setAttr(list: ptr, attr: int, val: ptr, size: int): bool {
    return k32.UpdateProcThreadAttribute(list, u32(0), attr, val, size, 0 as ptr, 0 as ptr) != 0;
}

pub fn freeAttrList(list: ptr) {
    if list as int != 0 {
        k32.DeleteProcThreadAttributeList(list);
    }
}

/// `CreatePseudoConsole` of `size` (a `COORD`): its handle, 0 on failure.
pub fn pcCreate(size: u32, hin: int, hout: int): int {
    let hpc: int = 0;
    if k32.CreatePseudoConsole(size, hin, hout, u32(0), &hpc as ptr) < 0 {
        return 0;
    }
    return hpc;
}

pub fn pcResize(hpc: int, size: u32): bool {
    return k32.ResizePseudoConsole(hpc, size) >= 0;
}

pub fn pcClose(hpc: int) {
    k32.ClosePseudoConsole(hpc);
}

/// `CreateEventA`, unnamed, not signaled: its handle (0 on failure).
pub fn newEvent(manual: bool): int {
    return k32.CreateEventA(0 as ptr, if manual { 1 } else { 0 }, 0, 0 as ptr);
}

pub fn setEvent(h: int) {
    k32.SetEvent(h);
}

/// Open folder `dir` for `ReadDirectoryChangesW` (overlapped): its handle, or `INVALID`.
pub fn openDir(dir: string, arena: &Arena): int {
    // FILE_LIST_DIRECTORY, share read/write/delete, OPEN_EXISTING, BACKUP_SEMANTICS | OVERLAPPED
    return k32.CreateFileW(wide(dir, arena), u32(1), u32(7), 0 as ptr, u32(3), u32(0x42000000), 0);
}

/// Start an overlapped `ReadDirectoryChangesW` of folder `h` into `buf` with `filter`.
pub fn readChanges(h: int, buf: []u8, filter: int, ov: ptr): bool {
    return k32.ReadDirectoryChangesW(h, buf.ptr as ptr, u32(buf.len), 0, u32(filter), 0 as ptr, ov, 0 as ptr) != 0;
}

/// `GetOverlappedResult`: the bytes moved, or -1 on failure (`lastError`; `ERROR_IO_INCOMPLETE` while it runs).
pub fn overlapped(h: int, ov: ptr, wait: bool): int {
    let got: u32 = 0;
    if k32.GetOverlappedResult(h, ov, &got as ptr, if wait { 1 } else { 0 }) == 0 {
        return -1;
    }
    return int(got);
}

pub fn cancelIo(h: int, ov: ptr) {
    k32.CancelIoEx(h, ov);
}

pub fn flush(h: int) {
    k32.FlushFileBuffers(h);
}

/// A new overlapped instance of byte pipe `name` (NUL-terminated), local clients only; `first` fails with
/// `ERROR_ACCESS_DENIED` when the name already exists. `INVALID` on failure. Read and write it with `ovRead`/`ovWrite`.
pub fn pipeServer(name: ptr, first: bool): int {
    // PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED (| FILE_FLAG_FIRST_PIPE_INSTANCE); PIPE_REJECT_REMOTE_CLIENTS
    return k32.CreateNamedPipeA(name, u32(if first { 3 + 0x40000000 + 0x80000 } else { 3 + 0x40000000 }), u32(8), u32(255), u32(65536), u32(65536), u32(0), 0 as ptr);
}

/// Open pipe `name` as a client (read and write). `INVALID` on failure (`ERROR_PIPE_BUSY` when every instance is taken).
pub fn pipeClient(name: ptr): int {
    return k32.CreateFileA(name, u32(0xC0000000), u32(0), 0 as ptr, u32(3), u32(0), 0);
}

pub fn waitPipe(name: ptr, ms: int) {
    k32.WaitNamedPipeA(name, u32(if ms < 0 { 0 } else { ms }));
}

/// Overlapped `ConnectNamedPipe` on server instance `h` with `ov` (32 zeroed bytes that stay put): 1 when a client
/// is connected (or connected and already gone), 0 while it waits (call again later with `pending` true), -1 on failure.
pub fn pipeAccept(h: int, ov: ptr, pending: bool): int {
    if pending {
        if overlapped(h, ov, false) >= 0 { return 1; }
        return if lastError() == ERROR_IO_INCOMPLETE { 0 } else { -1 };
    }
    if k32.ConnectNamedPipe(h, ov) != 0 { return 1; }
    let err = lastError();
    if err == ERROR_PIPE_CONNECTED || err == ERROR_NO_DATA { return 1; }
    return if err == 997 { 0 } else { -1 };
}

/// One read or write on an overlapped handle, waited for: the bytes moved, 0 at the end of a pipe, -1 on failure.
fn ovIo(h: int, p: ptr, n: int, write: bool): int {
    let ov: [4]int = [0, 0, 0, 0];
    let got: u32 = 0;
    let ok = if write { k32.WriteFile(h, p, u32(n), &got as ptr, &ov[0] as ptr) } else { k32.ReadFile(h, p, u32(n), &got as ptr, &ov[0] as ptr) };
    if ok == 0 {
        let err = lastError();
        if err != 997 { return if err == ERROR_BROKEN_PIPE { 0 } else { -1 }; }
        let r = overlapped(h, &ov[0] as ptr, true);
        if r < 0 { return if lastError() == ERROR_BROKEN_PIPE { 0 } else { -1 }; }
        return r;
    }
    return int(got);
}

pub fn ovRead(h: int, buf: []u8): int {
    return ovIo(h, buf.ptr as ptr, buf.len, false);
}

/// Write all `n` bytes at `p` to overlapped handle `h`; false when the reader is gone.
pub fn ovWrite(h: int, p: ptr, n: int): bool {
    let at = 0;
    while at < n {
        let r = ovIo(h, (p as int + at) as ptr, n - at, true);
        if r <= 0 { return false; }
        at += r;
    }
    return true;
}


/// Swap the process's std handle `which` (0 in, 1 out, 2 err) for `h`; returns the old one.
pub fn swapStd(which: int, h: int): int {
    let id = u32(0xFFFFFFF6 - which);
    let old = k32.GetStdHandle(id);
    k32.SetStdHandle(id, h);
    return old;
}



/// True under wine (ntdll exports `wine_get_version`).
pub fn underWine(): bool {
    let nt = sys.dlopen("ntdll.dll");
    return nt as int != 0 && sys.dlsym(nt, "wine_get_version") as int != 0;
}
