/// Seedable LCG. Overflow wraps (spec). Arithmetic, not bit ops: the code predates them.
/// Any thread: no module state, so a worker can use a value it owns (`j3c doc threads`).

module j3.rand;

/// Seedable LCG. A seed of 0 becomes 1. Overflow wraps.
pub struct Rng {
    /// Current generator state.
    state: int;

    /// Start from `seed`. Zero is replaced with 1.
    fn new(seed: int): Rng {
        let s = seed;
        if s == 0 {
            s = 1;
        }
        return Rng { state: s };
    }

    /// Next non-negative value.
    fn next(this: &Rng): int {
        this.state = this.state * 6364136223846793005 + 1442695040888963407;
        if this.state < 0 {
            return 0 - this.state;
        }
        return this.state;
    }

    /// Integer in `lo..hi`. Returns `lo` when `hi <= lo`.
    fn intRange(this: &Rng, lo: int, hi: int): int {
        let span = hi - lo;
        if span <= 0 {
            return lo;
        }
        let n = this.next();
        return lo + (n - (n / span) * span);
    }

    /// Float in `[0, 1)`.
    fn unit(this: &Rng): f32 {
        let m = 16777216;
        let n = this.next();
        let r = n - (n / m) * m;
        return f32(r) / f32(m);
    }

    /// Float from `lo` toward `hi` using `unit`.
    fn floatRange(this: &Rng, lo: f32, hi: f32): f32 {
        return lo + (hi - lo) * this.unit();
    }
}
