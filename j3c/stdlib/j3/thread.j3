/// Threads, locks, a blocking queue, and a worker pool (Linux, pthreads).
/// Start with `j3c doc threads` (the rules, which modules are safe on a worker, common
/// mistakes) and `j3c doc recipes threads` (a whole program). The idea: hand work over, do not
/// share it. GL, SDL, and `j3.gfx` / `j3.game` / `j3.scene3d` state are main-thread only.

module j3.thread;

use lib "c" as c {
    fn pthread_create(t: ptr, attr: ptr, f: fn(ptr): ptr, arg: ptr): i32;
    fn pthread_join(t: int, ret: ptr): i32;
    fn pthread_mutex_lock(m: ptr): i32;
    fn pthread_mutex_unlock(m: ptr): i32;
    fn pthread_mutex_trylock(m: ptr): i32;
    fn pthread_cond_wait(cv: ptr, m: ptr): i32;
    fn pthread_cond_signal(cv: ptr): i32;
    fn pthread_cond_broadcast(cv: ptr): i32;
    fn sysconf(name: i32): int;
}

use j3.memory.{ Arena, freeScratch, rewindScratch };
use j3.option.Option;
use j3.sys.{ mmapAnon, munmap, panic, setThreadName };

/// Linux amd64 `sigaltstack` (the debug crash handler declares the libc one).
const SYS_sigaltstack: int = 131;
/// `_SC_NPROCESSORS_ONLN`.
const SC_NPROCESSORS_ONLN: int = 84;
/// Bytes of each thread's crash stack, so a stack overflow can still print a trace.
const ALT_STACK: int = 65536;

/// Logical cores, to size a `Pool`.
pub fn cores(): int {
    let n = c.sysconf(SC_NPROCESSORS_ONLN);
    return if n < 1 { 1 } else { n };
}

/// A running thread. Fill it with `spawn`, wait for it with `join`.
pub struct Thread {
    tid: int = 0;
    f: fn(ptr);
    arg: ptr = 0;
    name: string = "";
}

fn entry(p: ptr): ptr {
    let t = p as &Thread;
    setThreadName(t.name);
    let stack = mmapAnon(ALT_STACK);
    let ss: [3]int = [stack as int, 0, ALT_STACK];
    @syscall(SYS_sigaltstack, &ss[0] as ptr, 0);
    let f = t.f;
    f(t.arg);
    freeScratch();
    let off: [3]int = [0, 2, 0];
    @syscall(SYS_sigaltstack, &off[0] as ptr, 0);
    munmap(stack, ALT_STACK);
    return 0 as ptr;
}

/// Start `f(arg)` on a new thread named `name` (shown in panics; it must outlive the thread).
pub fn spawn(t: &Thread, name: string, f: fn(ptr), arg: ptr) {
    t.f = f;
    t.arg = arg;
    t.name = name;
    if c.pthread_create(&t.tid as ptr, 0 as ptr, entry, t as ptr) != 0 {
        panic("thread.spawn");
    }
}

/// Wait for the thread to finish.
pub fn join(t: &Thread) {
    c.pthread_join(t.tid, 0 as ptr);
}

/// Mutual exclusion. A zeroed `Mutex {}` is ready to use.
pub struct Mutex {
    w0: int = 0;
    w1: int = 0;
    w2: int = 0;
    w3: int = 0;
    w4: int = 0;

    fn lock(this: &Mutex) {
        c.pthread_mutex_lock(this as ptr);
    }

    fn unlock(this: &Mutex) {
        c.pthread_mutex_unlock(this as ptr);
    }

    /// True when it took the lock.
    fn tryLock(this: &Mutex): bool {
        return c.pthread_mutex_trylock(this as ptr) == 0;
    }
}

/// Condition variable. A zeroed `Cond {}` is ready to use. Wait in a loop that rechecks the
/// condition: a wait can return early.
pub struct Cond {
    w0: int = 0;
    w1: int = 0;
    w2: int = 0;
    w3: int = 0;
    w4: int = 0;
    w5: int = 0;

    /// Release `m`, sleep until signalled, take `m` again. Hold `m` when calling.
    fn wait(this: &Cond, m: &Mutex) {
        c.pthread_cond_wait(this as ptr, m as ptr);
    }

    fn signal(this: &Cond) {
        c.pthread_cond_signal(this as ptr);
    }

    fn broadcast(this: &Cond) {
        c.pthread_cond_broadcast(this as ptr);
    }
}

/// Fixed-capacity ring of `T` shared between threads. `push` blocks while full, `pop` blocks
/// while empty; `tryPush` and `tryPop` never block (use them on the frame thread). `close`
/// wakes every waiter: pops drain what is left and then return `None`, pushes return false.
pub struct Queue<T> {
    m: Mutex;
    notEmpty: Cond;
    notFull: Cond;
    items: []T;
    head: int = 0;
    len: int = 0;
    closed: int = 0;

    /// A queue of `cap` slots (at least 1) allocated from `arena`.
    fn create(arena: &Arena, cap: int): Queue<T> {
        if cap < 1 {
            panic("Queue.create");
        }
        return Queue<T> {
            m: Mutex {},
            notEmpty: Cond {},
            notFull: Cond {},
            items: arena.alloc::<T>(cap),
        };
    }

    fn put(this: &Queue<T>, item: T) {
        this.items[(this.head + this.len) % this.items.len] = item;
        this.len += 1;
        this.notEmpty.signal();
    }

    fn take(this: &Queue<T>): T {
        let item = this.items[this.head];
        this.head = (this.head + 1) % this.items.len;
        this.len -= 1;
        this.notFull.signal();
        return item;
    }

    /// Wait for room, then add `item`. False when the queue is closed.
    fn push(this: &Queue<T>, item: T): bool {
        this.m.lock();
        while this.len == this.items.len && this.closed == 0 {
            this.notFull.wait(&this.m);
        }
        if this.closed != 0 {
            this.m.unlock();
            return false;
        }
        this.put(item);
        this.m.unlock();
        return true;
    }

    /// Add `item` if there is room.
    fn tryPush(this: &Queue<T>, item: T): bool {
        this.m.lock();
        if this.len == this.items.len || this.closed != 0 {
            this.m.unlock();
            return false;
        }
        this.put(item);
        this.m.unlock();
        return true;
    }

    /// Wait for an item. `None` once the queue is closed and empty.
    fn pop(this: &Queue<T>): Option<T> {
        this.m.lock();
        while this.len == 0 && this.closed == 0 {
            this.notEmpty.wait(&this.m);
        }
        if this.len == 0 {
            this.m.unlock();
            return Option.None;
        }
        let item = this.take();
        this.m.unlock();
        return Option.Some(item);
    }

    /// The oldest item, or `None` right away.
    fn tryPop(this: &Queue<T>): Option<T> {
        this.m.lock();
        if this.len == 0 {
            this.m.unlock();
            return Option.None;
        }
        let item = this.take();
        this.m.unlock();
        return Option.Some(item);
    }

    /// Items waiting right now.
    fn count(this: &Queue<T>): int {
        this.m.lock();
        let n = this.len;
        this.m.unlock();
        return n;
    }

    /// No more pushes; wake everyone.
    fn close(this: &Queue<T>) {
        this.m.lock();
        this.closed = 1;
        this.notEmpty.broadcast();
        this.notFull.broadcast();
        this.m.unlock();
    }
}

/// One unit of pool work: `f(arg)` runs on a worker.
pub struct Job {
    f: fn(ptr);
    arg: ptr;
}

/// A slice `[lo, hi)` of a `parallelFor`.
struct Range {
    f: fn(ptr, int, int);
    ctx: ptr;
    lo: int;
    hi: int;
}

/// Worker threads draining one `Queue` of jobs. Make one with `Pool.create` and keep the
/// `&Pool`. After each job a worker rewinds its `memory.scratch` arena.
pub struct Pool {
    jobs: Queue<Job>;
    threads: []Thread;
    ranges: []Range;
    /// Jobs submitted and not yet finished; touched only with atomics.
    pending: int = 0;
    m: Mutex;
    idle: Cond;

    /// Start `workers` threads (at least 1) over a queue of `cap` jobs. Everything lives in
    /// `arena`, which must outlive the pool.
    fn create(arena: &Arena, workers: int, cap: int): &Pool {
        if workers < 1 {
            panic("Pool.create");
        }
        let slot = arena.alloc::<Pool>(1);
        slot[0] = Pool {
            jobs: Queue<Job>.create(arena, cap),
            threads: arena.alloc::<Thread>(workers),
            ranges: arena.alloc::<Range>(workers),
            m: Mutex {},
            idle: Cond {},
        };
        let p = &slot[0];
        for i in 0..workers {
            spawn(&p.threads[i], "worker", poolWorker, p as ptr);
        }
        return p;
    }

    /// Queue `f(arg)`; blocks while the queue is full (use `trySubmit` on a frame thread). `arg`
    /// must stay valid until it runs.
    fn submit(this: &Pool, f: fn(ptr), arg: ptr) {
        @atomicAdd(&this.pending, 1);
        if !this.jobs.push(Job { f: f, arg: arg }) {
            panic("Pool.submit after shutdown");
        }
    }

    /// Queue `f(arg)` if there is room and return true; false (nothing queued) when the queue
    /// is full or the pool is shut down. Never blocks, so a frame thread can call it: on false,
    /// keep the job and try again next frame. `arg` must stay valid until it runs.
    fn trySubmit(this: &Pool, f: fn(ptr), arg: ptr): bool {
        @atomicAdd(&this.pending, 1);
        if this.jobs.tryPush(Job { f: f, arg: arg }) {
            return true;
        }
        this.finished();
        return false;
    }

    /// Jobs submitted and not yet finished (queued or running). Never blocks.
    fn pendingJobs(this: &Pool): int {
        return @atomicLoad(&this.pending);
    }

    /// One job less pending; wake `wait` when it was the last.
    fn finished(this: &Pool) {
        if @atomicAdd(&this.pending, 0 - 1) == 1 {
            this.m.lock();
            this.idle.broadcast();
            this.m.unlock();
        }
    }

    /// Block until every submitted job has finished.
    fn wait(this: &Pool) {
        this.m.lock();
        while @atomicLoad(&this.pending) > 0 {
            this.idle.wait(&this.m);
        }
        this.m.unlock();
    }

    /// Run `f(ctx, lo, hi)` over `0..n` split into one range per worker, and wait. Call from
    /// one thread at a time. Have `f` write `out[i]` and reduce afterwards in index order.
    fn parallelFor(this: &Pool, n: int, f: fn(ptr, int, int), ctx: ptr) {
        let w = this.ranges.len;
        let chunk = (n + w - 1) / w;
        for i in 0..w {
            let lo = i * chunk;
            let hi = lo + chunk;
            if hi > n {
                hi = n;
            }
            if lo >= hi {
                break;
            }
            this.ranges[i] = Range { f: f, ctx: ctx, lo: lo, hi: hi };
            this.submit(rangeJob, &this.ranges[i] as ptr);
        }
        this.wait();
    }

    /// Finish queued jobs, stop the workers, and join them.
    fn shutdown(this: &Pool) {
        this.jobs.close();
        for i in 0..this.threads.len {
            join(&this.threads[i]);
        }
    }
}

fn rangeJob(arg: ptr) {
    let r = arg as &Range;
    let f = r.f;
    f(r.ctx, r.lo, r.hi);
}

fn poolWorker(arg: ptr) {
    let p = arg as &Pool;
    while true {
        match p.jobs.pop() {
            Option.None {
                return;
            }
            Option.Some(job) {
                let f = job.f;
                f(job.arg);
                rewindScratch();
                p.finished();
            }
        }
    }
}
