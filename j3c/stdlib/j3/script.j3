/// Runtime for `.j3sb` script bytecode (`j3c dump-bc`). A `Vm` owns the scripts it loaded,
/// their `shared` values, the instances it made, and one preallocated call stack. Loading
/// and `new` use its arena; running a function never allocates.
///
/// Registers are 8-byte slots; register 0 is the frame pointer. Instance fields, slices, and
/// structs use the native layout, so a script and the program share memory as-is.
///
/// Dev builds (`j3c run` on a program with scripts) reach the VM through compiler-made stubs:
/// `devRegister` (one thunk per native function a script may call), `devNew`, `devCall`,
/// and `poll`, which swaps in new bytecode at a frame boundary.
module j3.script;

use j3.memory.{ Arena, setFrameHook };
use j3.text.same;
use j3.sys.{ open, read, close, lseek, mmapAnon, munmap, exit, O_RDONLY, SEEK_END, SEEK_SET, panic };
use j3.io.printLn;

const VERSION: int = 2;
const NO_REG: u32 = 4294967295;
const MAX_MODULES: int = 256;
const TABLE_SLOTS: int = 8192;
const INTERP_CAP: int = 512;
const INSTR_BYTES: int = 24;

// Opcodes. Same numbers as `j3c/src/emit/bc.rs`.
const CONST: u16 = 1;
const MOV: u16 = 2;
const ADDR: u16 = 3;
const IDX: u16 = 4;
const GLOBAL: u16 = 5;
const STR: u16 = 6;
const LD8S: u16 = 7;
const LD8U: u16 = 8;
const LD16S: u16 = 9;
const LD16U: u16 = 10;
const LD32S: u16 = 11;
const LD32U: u16 = 12;
const LD64: u16 = 13;
const ST8: u16 = 14;
const ST16: u16 = 15;
const ST32: u16 = 16;
const ST64: u16 = 17;
const COPY: u16 = 18;
const ADD: u16 = 19;
const SUB: u16 = 20;
const MUL: u16 = 21;
const DIVS: u16 = 22;
const REMS: u16 = 23;
const DIVU: u16 = 24;
const REMU: u16 = 25;
const NEG: u16 = 26;
const NOT: u16 = 27;
const EQ: u16 = 28;
const NE: u16 = 29;
const LTS: u16 = 30;
const LES: u16 = 31;
const LTU: u16 = 32;
const LEU: u16 = 33;
const SEXT8: u16 = 34;
const SEXT16: u16 = 35;
const SEXT32: u16 = 36;
const ZEXT8: u16 = 37;
const ZEXT16: u16 = 38;
const ZEXT32: u16 = 39;
const FADD: u16 = 40;
const FSUB: u16 = 41;
const FMUL: u16 = 42;
const FDIV: u16 = 43;
const FNEG: u16 = 44;
const FEQ: u16 = 45;
const FNE: u16 = 46;
const FLT: u16 = 47;
const FLE: u16 = 48;
const DADD: u16 = 49;
const DSUB: u16 = 50;
const DMUL: u16 = 51;
const DDIV: u16 = 52;
const DNEG: u16 = 53;
const DEQ: u16 = 54;
const DNE: u16 = 55;
const DLT: u16 = 56;
const DLE: u16 = 57;
const I2F: u16 = 58;
const U2F: u16 = 59;
const F2I: u16 = 60;
const F2U: u16 = 61;
const I2D: u16 = 62;
const U2D: u16 = 63;
const D2I: u16 = 64;
const D2U: u16 = 65;
const F2D: u16 = 66;
const D2F: u16 = 67;
const JMP: u16 = 68;
const JZ: u16 = 69;
const JNZ: u16 = 70;
const JN_LTS: u16 = 71;
const JN_LES: u16 = 72;
const JN_LTU: u16 = 73;
const JN_LEU: u16 = 74;
const JN_EQ: u16 = 75;
const JN_NE: u16 = 76;
const JN_FLT: u16 = 77;
const JN_FLE: u16 = 78;
const JN_DLT: u16 = 79;
const JN_DLE: u16 = 80;
const CALL: u16 = 81;
const RET: u16 = 82;
const RETV: u16 = 83;
const RETA: u16 = 84;
const ABORT: u16 = 85;
const DIV0: u16 = 86;
const APP_LIT: u16 = 87;
const APP_STR: u16 = 88;
const APP_INT: u16 = 89;
const APP_F64: u16 = 90;
const APP_BOOL: u16 = 91;
const LAND: u16 = 92;
const LOR: u16 = 93;

// Call kinds.
const CALL_LOCAL: u32 = 0;
const CALL_SCRIPT: u32 = 1;
const CALL_NATIVE: u32 = 2;

/// One prop for `Vm.new`: the field name and the bytes to copy in.
pub struct Prop {
    name: string;
    value: ptr;
    size: int;
}

/// One argument for `Vm.call`: where the value is and how many bytes it has.
pub struct Arg {
    value: ptr;
    size: int;
}

struct Instr { op: u16; aux: u16; dst: u32; a: u32; b: u32; imm: u64; }
struct Param { reg: u32; offset: u32; size: u32; load: u32; }
struct CallArg { reg: u32; size: u32; aggregate: u32; }
struct CallSite {
    kind: u32; key: u64; index: u32; retSize: int; retLoad: u32; retAggregate: bool;
    args: []CallArg; argBytes: int; target: ptr; thunk: fn(ptr, ptr); linked: bool;
}
struct Field { name: string; offset: int; size: int; defaultBytes: []u8; defaultConst: int; }
struct Global { key: u64; name: string; data: ptr; size: int; }
struct Native { key: u64; name: string; }
struct Function {
    key: u64; name: string; signature: string; public: bool; owner: int;
    frameSize: int; regs: int; retSize: int; retAggregate: bool;
    params: []Param; calls: []CallSite; code: []Instr;
}
struct Module {
    name: string; path: string; layoutHash: u64; signatureHash: u64;
    instanceSize: int; propCount: int; fields: []Field; globals: []Global;
    constants: [][]u8; natives: []Native; functions: []Function;
}
struct FnSlot { key: u64; f: ptr; }
struct ThunkSlot { key: u64; call: fn(ptr, ptr); used: bool; }

pub struct Vm {
    arena: &Arena;
    stackBase: int;
    stackCap: int;
    top: int;
    modules: []Module;
    loaded: int;
    fnSlots: []FnSlot;
    thunkSlots: []ThunkSlot;
    reloadStamp: int;

    fn create(arenaBytes: int, stackBytes: int): Vm {
        let header = mmapAnon(@sizeof(Arena));
        if header as int == 0 { panic("script: cannot allocate the VM arena"); }
        let slot: []Arena = @slice(header, 1);
        slot[0] = Arena.create(arenaBytes);
        let arena = &slot[0];
        let fnSlots = arena.alloc::<FnSlot>(TABLE_SLOTS);
        let thunkSlots = arena.alloc::<ThunkSlot>(TABLE_SLOTS);
        clearBytes(fnSlots.ptr as int, TABLE_SLOTS * @sizeof(FnSlot));
        clearBytes(thunkSlots.ptr as int, TABLE_SLOTS * @sizeof(ThunkSlot));
        let stack = alignedAlloc(arena, stackBytes);
        return Vm { arena: arena, stackBase: stack as int, stackCap: stackBytes, top: 0,
                    modules: arena.alloc::<Module>(MAX_MODULES), loaded: 0, fnSlots: fnSlots,
                    thunkSlots: thunkSlots, reloadStamp: 0 };
    }

    fn destroy(this: &Vm) {
        this.arena.destroy();
        munmap(this.arena as ptr, @sizeof(Arena));
        this.loaded = 0;
        this.top = 0;
    }

    /// Link a native function a script may call. `key` is the one `j3c` gives it.
    fn register(this: &Vm, key: u64, call: fn(ptr, ptr)) {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.thunkSlots[i];
            if !slot.used || slot.key == key {
                slot.key = key;
                slot.call = call;
                slot.used = true;
                return;
            }
            i = (i + 1) % TABLE_SLOTS;
        }
        panic("script: thunk table full");
    }

    fn thunk(this: &Vm, key: u64): int {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.thunkSlots[i];
            if !slot.used { return 0 - 1; }
            if slot.key == key { return i; }
            i = (i + 1) % TABLE_SLOTS;
        }
        return 0 - 1;
    }

    fn addFunction(this: &Vm, f: &Function) {
        let i = slotOf(f.key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.fnSlots[i];
            if slot.f as int == 0 || slot.key == f.key {
                slot.key = f.key;
                slot.f = f as ptr;
                return;
            }
            i = (i + 1) % TABLE_SLOTS;
        }
        panic("script: function table full");
    }

    fn function(this: &Vm, key: u64): ptr {
        let i = slotOf(key);
        for n in 0..TABLE_SLOTS {
            let slot = &this.fnSlots[i];
            if slot.f as int == 0 { return 0 as ptr; }
            if slot.key == key { return slot.f; }
            i = (i + 1) % TABLE_SLOTS;
        }
        return 0 as ptr;
    }

    /// The key of a function in a loaded script, by name.
    fn methodKey(this: &Vm, moduleId: int, name: string): u64 {
        let m = this.moduleAt(moduleId);
        for i in 0..m.functions.len {
            if same(m.functions[i].name, name) { return m.functions[i].key; }
        }
        panic("script: no function with that name");
        return 0;
    }

    fn moduleAt(this: &Vm, moduleId: int): &Module {
        if moduleId < 0 || moduleId >= this.loaded { panic("script: invalid module id"); }
        return &this.modules[moduleId];
    }

    /// Load `target/j3s/<script>.j3sb` for a script path like `scripts/door.j3s`, once.
    fn loadScript(this: &Vm, script: string): int {
        for i in 0..this.loaded {
            if same(this.modules[i].path, script) { return i; }
        }
        let text = this.bytecodePath(script);
        return this.load(text);
    }

    fn bytecodePath(this: &Vm, script: string): string {
        let prefix = "target/j3s/";
        let stem = script.len;
        if stem > 4 && same(script[stem - 4..stem], ".j3s") { stem -= 4; }
        let bytes = this.arena.alloc::<u8>(prefix.len + stem + 5);
        copyBytes(bytes.ptr as int, prefix.ptr as int, prefix.len);
        copyBytes(bytes.ptr as int + prefix.len, script.ptr as int, stem);
        let tail = ".j3sb";
        copyBytes(bytes.ptr as int + prefix.len + stem, tail.ptr as int, 5);
        return bytes as string;
    }

    /// Read a compiled script, and the scripts it calls into. The path is relative to the
    /// working directory (`J3_ROOT` under `j3c run`).
    fn load(this: &Vm, path: string): int {
        if this.loaded >= this.modules.len { panic("script: module table full"); }
        let m = this.parse(readFile(this.arena, path), path);
        for i in 0..this.loaded {
            if same(this.modules[i].path, m.path) { return i; }
        }
        let id = this.loaded;
        this.modules[id] = m;
        this.loaded += 1;
        this.link(id, this.arena.alloc::<Global>(0));
        return id;
    }

    /// Resolve a module's shared values, constants, and local calls to addresses. Globals
    /// whose key is in `keep` keep their current data (a live swap).
    fn link(this: &Vm, id: int, keep: []Global) {
        let m = &this.modules[id];
        for g in 0..m.globals.len {
            for k in 0..keep.len {
                if keep[k].key == m.globals[g].key && keep[k].size == m.globals[g].size {
                    m.globals[g].data = keep[k].data;
                }
            }
        }
        for f in 0..m.functions.len {
            let fun = &m.functions[f];
            fun.owner = id;
            for pc in 0..fun.code.len {
                let ins = &fun.code[pc];
                if ins.op == GLOBAL {
                    ins.op = CONST;
                    ins.imm = m.globals[ins.imm as int].data as int as u64;
                } else if ins.op == STR || ins.op == APP_LIT {
                    let constant = m.constants[ins.imm as int];
                    ins.imm = constant.ptr as int as u64;
                    ins.b = constant.len as u32;
                }
            }
            for c in 0..fun.calls.len {
                let site = &fun.calls[c];
                if site.kind == CALL_LOCAL {
                    site.target = &m.functions[site.index as int] as ptr;
                    site.linked = true;
                } else if site.kind == CALL_NATIVE {
                    let t = this.thunk(site.key);
                    if t >= 0 {
                        site.thunk = this.thunkSlots[t].call;
                        site.linked = true;
                    }
                }
            }
            this.addFunction(fun);
        }
    }

    fn parse(this: &Vm, file: []u8, path: string): Module {
        let r = Reader { base: file.ptr as int, at: file.ptr as int, end: file.ptr as int + file.len };
        if file.len < 8 || !same(file[0..4] as string, "J3SB") { panic("script: not a .j3sb file"); }
        r.at += 4;
        if r.u16() as int != VERSION { panic("script: bytecode version differs; rerun j3c"); }
        r.u16();
        let layoutHash = r.u64();
        let signatureHash = r.u64();
        let name = r.text();
        let scriptPath = r.text();
        let instanceSize = r.u32() as int;
        let propCount = r.u32() as int;
        let fields = this.arena.alloc::<Field>(r.u32() as int);
        for i in 0..fields.len {
            fields[i] = Field { name: r.text(), offset: r.u32() as int, size: r.u32() as int,
                                defaultBytes: r.bytes(), defaultConst: r.u32() as int };
        }
        let globals = this.arena.alloc::<Global>(r.u32() as int);
        let inits = this.arena.alloc::<[]u8>(globals.len);
        let initConsts = this.arena.alloc::<int>(globals.len);
        for i in 0..globals.len {
            let key = r.u64();
            let globalName = r.text();
            let size = r.u32() as int;
            inits[i] = r.bytes();
            initConsts[i] = r.u32() as int;
            let data = alignedAlloc(this.arena, size);
            clearBytes(data as int, size);
            copyBytes(data as int, inits[i].ptr as int, inits[i].len);
            globals[i] = Global { key: key, name: globalName, data: data, size: size };
        }
        let constants = this.arena.alloc::<[]u8>(r.u32() as int);
        for i in 0..constants.len { constants[i] = r.bytes(); }
        for i in 0..globals.len {
            if initConsts[i] != NO_REG as int {
                st64(globals[i].data as int, constants[initConsts[i]].ptr as int as u64);
            }
        }
        let natives = this.arena.alloc::<Native>(r.u32() as int);
        for i in 0..natives.len { natives[i] = Native { key: r.u64(), name: r.text() }; }
        let deps = r.u32() as int;
        for i in 0..deps { this.loadScript(r.text()); }
        let functions = this.arena.alloc::<Function>(r.u32() as int);
        for i in 0..functions.len { functions[i] = this.readFunction(&r); }
        return Module { name: name, path: scriptPath, layoutHash: layoutHash,
            signatureHash: signatureHash, instanceSize: instanceSize, propCount: propCount,
            fields: fields, globals: globals, constants: constants, natives: natives,
            functions: functions };
    }

    fn readFunction(this: &Vm, r: &Reader): Function {
        let key = r.u64();
        let name = r.text();
        let signature = r.text();
        let public = r.u32() != 0;
        let frameSize = r.u32() as int;
        let regs = r.u32() as int;
        let retSize = r.u32() as int;
        let retAggregate = r.u32() != 0;
        let params = this.arena.alloc::<Param>(r.u32() as int);
        for i in 0..params.len {
            params[i] = Param { reg: r.u32(), offset: r.u32(), size: r.u32(), load: r.u32() };
        }
        let calls = this.arena.alloc::<CallSite>(r.u32() as int);
        for i in 0..calls.len {
            let kind = r.u32();
            let callKey = r.u64();
            let index = r.u32();
            let callRet = r.u32() as int;
            let retLoad = r.u32();
            let aggregate = r.u32() != 0;
            let args = this.arena.alloc::<CallArg>(r.u32() as int);
            let argBytes = 0;
            for j in 0..args.len {
                args[j] = CallArg { reg: r.u32(), size: r.u32(), aggregate: r.u32() };
                argBytes += (args[j].size as int + 7) / 8 * 8;
            }
            calls[i] = CallSite { kind: kind, key: callKey, index: index, retSize: callRet,
                retLoad: retLoad, retAggregate: aggregate, args: args,
                argBytes: argBytes + (callRet + 7) / 8 * 8 + 8, target: 0 as ptr,
                thunk: missingThunk, linked: false };
        }
        let count = r.u32() as int;
        r.at = r.base + (r.at - r.base + 7) / 8 * 8;
        let code: []Instr = @slice(alignedAlloc(this.arena, count * INSTR_BYTES), count);
        if r.at + count * INSTR_BYTES > r.end { panic("script: truncated bytecode"); }
        copyBytes(code.ptr as int, r.at, count * INSTR_BYTES);
        r.at += count * INSTR_BYTES;
        return Function { key: key, name: name, signature: signature, public: public, owner: 0,
            frameSize: frameSize, regs: regs, retSize: retSize, retAggregate: retAggregate,
            params: params, calls: calls, code: code };
    }

    /// Make one instance: defaults first, then the given props. Every prop without a
    /// default must be given.
    fn new(this: &Vm, moduleId: int, props: []Prop): ptr {
        let m = this.moduleAt(moduleId);
        let instance = alignedAlloc(this.arena, m.instanceSize);
        clearBytes(instance as int, m.instanceSize);
        for i in 0..m.fields.len {
            let field = &m.fields[i];
            copyBytes(instance as int + field.offset, field.defaultBytes.ptr as int,
                      field.defaultBytes.len);
            if field.defaultConst != NO_REG as int {
                st64(instance as int + field.offset,
                     m.constants[field.defaultConst].ptr as int as u64);
            }
        }
        for i in 0..props.len {
            let found = false;
            for j in 0..m.propCount {
                let prop = &m.fields[j];
                if same(prop.name, props[i].name) {
                    if props[i].size != prop.size { panic("script: prop size differs"); }
                    copyBytes(instance as int + prop.offset, props[i].value as int, prop.size);
                    found = true;
                    break;
                }
            }
            if !found { panic("script: unknown prop"); }
        }
        for i in 0..m.propCount {
            if m.fields[i].defaultBytes.len > 0 { continue; }
            let given = false;
            for j in 0..props.len {
                if same(props[j].name, m.fields[i].name) { given = true; }
            }
            if !given { panic("script: a required prop is missing"); }
        }
        return instance;
    }

    /// Call a `pub` script function by key. `args` leave out the instance.
    fn call(this: &Vm, key: u64, instance: ptr, args: []Arg, result: ptr) {
        let found = this.function(key);
        if found as int == 0 { panic("script: no loaded function has that key"); }
        let f = found as &Function;
        if !f.public { panic("script: that function is private"); }
        if f.params.len != args.len + 1 { panic("script: argument count differs"); }
        let saved = this.top;
        let regs = this.enter(f);
        let fp = rd(regs, 0) as int;
        this.putParam(regs, fp, &f.params[0], instance as int as u64, false);
        for i in 0..args.len {
            let p = &f.params[i + 1];
            if args[i].size != p.size as int { panic("script: argument size differs"); }
            if p.load == 0 {
                copyBytes(fp + p.offset as int, args[i].value as int, p.size as int);
            } else {
                this.putParam(regs, fp, p, loadAs(args[i].value as int, p.load), false);
            }
        }
        let value = this.exec(f, regs, result);
        this.top = saved;
        if !f.retAggregate && f.retSize > 0 && result as int != 0 {
            storeN(result as int, value, f.retSize);
        }
    }

    fn putParam(this: &Vm, regs: int, fp: int, p: &Param, value: u64, aggregate: bool) {
        if p.reg != NO_REG {
            wr(regs, p.reg, value);
        } else if aggregate {
            copyBytes(fp + p.offset as int, value as int, p.size as int);
        } else {
            storeN(fp + p.offset as int, value, p.size as int);
        }
    }

    /// Push a frame: registers, then the zeroed local bytes. Register 0 is the frame pointer.
    fn enter(this: &Vm, f: &Function): int {
        let start = (this.top + 7) / 8 * 8;
        let end = start + f.regs * 8 + f.frameSize;
        if end > this.stackCap { panic("script: VM stack overflow"); }
        this.top = end;
        let regs = this.stackBase + start;
        let fp = regs + f.regs * 8;
        clearWords(fp, f.frameSize);
        wr(regs, 0, fp as u64);
        return regs;
    }

    fn resolve(this: &Vm, caller: &Function, site: &CallSite) {
        if site.kind == CALL_SCRIPT {
            let found = this.function(site.key);
            if found as int == 0 { panic("script: called script function isn't loaded"); }
            site.target = found;
            site.linked = true;
            return;
        }
        let t = this.thunk(site.key);
        if t < 0 {
            let m = &this.modules[caller.owner];
            for i in 0..m.natives.len {
                if m.natives[i].key == site.key {
                    printLn(`script: {m.natives[i].name} isn't linked into this program`);
                }
            }
            panic("script: native function not linked; rerun `j3c run` to rebuild");
        }
        site.thunk = this.thunkSlots[t].call;
        site.linked = true;
    }

    fn callSite(this: &Vm, caller: &Function, regs: int, ins: &Instr) {
        let site = &caller.calls[ins.imm as int];
        if !site.linked { this.resolve(caller, site); }
        if site.kind == CALL_NATIVE {
            this.callNative(site, regs, ins.dst);
        } else {
            this.callScript(site, regs, ins.dst);
        }
    }

    /// Pack the arguments in 8-byte slots and run the program's thunk for the target.
    fn callNative(this: &Vm, site: &CallSite, regs: int, dst: u32) {
        let saved = this.top;
        let area = (this.top + 7) / 8 * 8;
        if area + site.argBytes > this.stackCap { panic("script: VM stack overflow"); }
        this.top = area + site.argBytes;
        let args = this.stackBase + area;
        let off = 0;
        for i in 0..site.args.len {
            let arg = &site.args[i];
            if arg.aggregate != 0 {
                copyBytes(args + off, rd(regs, arg.reg) as int, arg.size as int);
            } else {
                st64(args + off, rd(regs, arg.reg));
            }
            off += (arg.size as int + 7) / 8 * 8;
        }
        let out = args + off;
        if site.retAggregate && dst != NO_REG { out = rd(regs, dst) as int; }
        let native = site.thunk;
        native(args as ptr, out as ptr);
        if !site.retAggregate && site.retSize > 0 && dst != NO_REG {
            wr(regs, dst, loadAs(out, site.retLoad));
        }
        this.top = saved;
    }

    fn callScript(this: &Vm, site: &CallSite, regs: int, dst: u32) {
        let saved = this.top;
        let callee = site.target as &Function;
        let child = this.enter(callee);
        let fp = rd(child, 0) as int;
        for i in 0..site.args.len {
            let arg = &site.args[i];
            this.putParam(child, fp, &callee.params[i], rd(regs, arg.reg), arg.aggregate != 0);
        }
        let out = 0;
        if site.retAggregate && dst != NO_REG { out = rd(regs, dst) as int; }
        let value = this.exec(callee, child, out as ptr);
        this.top = saved;
        if !site.retAggregate && site.retSize > 0 && dst != NO_REG {
            wr(regs, dst, value);
        }
    }

    /// Run one function body. Returns a scalar result; an aggregate result is copied to
    /// `result`.
    fn exec(this: &Vm, f: &Function, regs: int, result: ptr): u64 {
        let code = f.code.ptr as int;
        let pc = 0;
        while true {
            let ins = ((code + pc * INSTR_BYTES) as ptr) as &Instr;
            pc += 1;
            let op = ins.op;
            if op == LD64 {
                wr(regs, ins.dst, ld64(rd(regs, ins.a) as int + ins.imm as int));
            } else if op == ST64 {
                st64(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b));
            } else if op == ADD {
                wr(regs, ins.dst, rd(regs, ins.a) + rd(regs, ins.b));
            } else if op == CONST {
                wr(regs, ins.dst, ins.imm);
            } else if op == MOV {
                wr(regs, ins.dst, rd(regs, ins.a));
            } else if op == JN_LTS {
                if (rd(regs, ins.a) as int) >= (rd(regs, ins.b) as int) { pc = ins.imm as int; }
            } else if op == JMP {
                pc = ins.imm as int;
            } else if op == JZ {
                if rd(regs, ins.a) == 0 { pc = ins.imm as int; }
            } else if op == LD32U {
                wr(regs, ins.dst, ld32(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST32 {
                st32(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u32);
            } else if op == FADD {
                wf(regs, ins.dst, rf(regs, ins.a) + rf(regs, ins.b));
            } else if op == FMUL {
                wf(regs, ins.dst, rf(regs, ins.a) * rf(regs, ins.b));
            } else if op == FSUB {
                wf(regs, ins.dst, rf(regs, ins.a) - rf(regs, ins.b));
            } else if op == SUB {
                wr(regs, ins.dst, rd(regs, ins.a) - rd(regs, ins.b));
            } else if op == MUL {
                wr(regs, ins.dst, rd(regs, ins.a) * rd(regs, ins.b));
            } else if op == ADDR {
                wr(regs, ins.dst, rd(regs, ins.a) + ins.imm);
            } else if op == IDX {
                wr(regs, ins.dst, rd(regs, ins.a) + rd(regs, ins.b) * ins.imm);
            } else if op == CALL {
                this.callSite(f, regs, ins);
            } else if op == RET {
                return 0;
            } else if op == RETV {
                return rd(regs, ins.a);
            } else if op == LD8U {
                wr(regs, ins.dst, ld8(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST8 {
                st8(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u8);
            } else if op == LD32S {
                wr(regs, ins.dst, (ld32(rd(regs, ins.a) as int + ins.imm as int) as i32) as int as u64);
            } else if op == JN_LES {
                if (rd(regs, ins.a) as int) > (rd(regs, ins.b) as int) { pc = ins.imm as int; }
            } else if op == JN_LTU {
                if rd(regs, ins.a) >= rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_LEU {
                if rd(regs, ins.a) > rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_EQ {
                if rd(regs, ins.a) != rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_NE {
                if rd(regs, ins.a) == rd(regs, ins.b) { pc = ins.imm as int; }
            } else if op == JN_FLT {
                if !(rf(regs, ins.a) < rf(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_FLE {
                if !(rf(regs, ins.a) <= rf(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_DLT {
                if !(rdd(regs, ins.a) < rdd(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JN_DLE {
                if !(rdd(regs, ins.a) <= rdd(regs, ins.b)) { pc = ins.imm as int; }
            } else if op == JNZ {
                if rd(regs, ins.a) != 0 { pc = ins.imm as int; }
            } else if op == EQ {
                wb(regs, ins.dst, rd(regs, ins.a) == rd(regs, ins.b));
            } else if op == NE {
                wb(regs, ins.dst, rd(regs, ins.a) != rd(regs, ins.b));
            } else if op == LTS {
                wb(regs, ins.dst, (rd(regs, ins.a) as int) < (rd(regs, ins.b) as int));
            } else if op == LES {
                wb(regs, ins.dst, (rd(regs, ins.a) as int) <= (rd(regs, ins.b) as int));
            } else if op == LTU {
                wb(regs, ins.dst, rd(regs, ins.a) < rd(regs, ins.b));
            } else if op == LEU {
                wb(regs, ins.dst, rd(regs, ins.a) <= rd(regs, ins.b));
            } else if op == FDIV {
                wf(regs, ins.dst, rf(regs, ins.a) / rf(regs, ins.b));
            } else if op == FNEG {
                wf(regs, ins.dst, 0.0 - rf(regs, ins.a));
            } else if op == FEQ {
                wb(regs, ins.dst, rf(regs, ins.a) == rf(regs, ins.b));
            } else if op == FNE {
                wb(regs, ins.dst, rf(regs, ins.a) != rf(regs, ins.b));
            } else if op == FLT {
                wb(regs, ins.dst, rf(regs, ins.a) < rf(regs, ins.b));
            } else if op == FLE {
                wb(regs, ins.dst, rf(regs, ins.a) <= rf(regs, ins.b));
            } else if op == DADD {
                wd(regs, ins.dst, rdd(regs, ins.a) + rdd(regs, ins.b));
            } else if op == DSUB {
                wd(regs, ins.dst, rdd(regs, ins.a) - rdd(regs, ins.b));
            } else if op == DMUL {
                wd(regs, ins.dst, rdd(regs, ins.a) * rdd(regs, ins.b));
            } else if op == DDIV {
                wd(regs, ins.dst, rdd(regs, ins.a) / rdd(regs, ins.b));
            } else if op == DNEG {
                wd(regs, ins.dst, 0.0 - rdd(regs, ins.a));
            } else if op == DEQ {
                wb(regs, ins.dst, rdd(regs, ins.a) == rdd(regs, ins.b));
            } else if op == DNE {
                wb(regs, ins.dst, rdd(regs, ins.a) != rdd(regs, ins.b));
            } else if op == DLT {
                wb(regs, ins.dst, rdd(regs, ins.a) < rdd(regs, ins.b));
            } else if op == DLE {
                wb(regs, ins.dst, rdd(regs, ins.a) <= rdd(regs, ins.b));
            } else if op == DIVS {
                wr(regs, ins.dst, ((rd(regs, ins.a) as int) / (rd(regs, ins.b) as int)) as u64);
            } else if op == REMS {
                wr(regs, ins.dst, ((rd(regs, ins.a) as int) % (rd(regs, ins.b) as int)) as u64);
            } else if op == DIVU {
                wr(regs, ins.dst, rd(regs, ins.a) / rd(regs, ins.b));
            } else if op == REMU {
                wr(regs, ins.dst, rd(regs, ins.a) % rd(regs, ins.b));
            } else if op == NEG {
                wr(regs, ins.dst, 0 - rd(regs, ins.a));
            } else if op == NOT {
                wb(regs, ins.dst, rd(regs, ins.a) == 0);
            } else if op == LAND {
                wb(regs, ins.dst, rd(regs, ins.a) != 0 && rd(regs, ins.b) != 0);
            } else if op == LOR {
                wb(regs, ins.dst, rd(regs, ins.a) != 0 || rd(regs, ins.b) != 0);
            } else if op == SEXT8 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i8) as int as u64);
            } else if op == SEXT16 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i16) as int as u64);
            } else if op == SEXT32 {
                wr(regs, ins.dst, (rd(regs, ins.a) as i32) as int as u64);
            } else if op == ZEXT8 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u8) as u64);
            } else if op == ZEXT16 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u16) as u64);
            } else if op == ZEXT32 {
                wr(regs, ins.dst, (rd(regs, ins.a) as u32) as u64);
            } else if op == LD8S {
                wr(regs, ins.dst, (ld8(rd(regs, ins.a) as int + ins.imm as int) as i8) as int as u64);
            } else if op == LD16S {
                wr(regs, ins.dst, (ld16(rd(regs, ins.a) as int + ins.imm as int) as i16) as int as u64);
            } else if op == LD16U {
                wr(regs, ins.dst, ld16(rd(regs, ins.a) as int + ins.imm as int) as u64);
            } else if op == ST16 {
                st16(rd(regs, ins.a) as int + ins.imm as int, rd(regs, ins.b) as u16);
            } else if op == COPY {
                copyBytes(rd(regs, ins.a) as int, rd(regs, ins.b) as int, ins.imm as int);
            } else if op == STR {
                st64(rd(regs, ins.a) as int, ins.imm);
                st64(rd(regs, ins.a) as int + 8, ins.b as u64);
            } else if op == I2F {
                wf(regs, ins.dst, (rd(regs, ins.a) as int) as f32);
            } else if op == U2F {
                wf(regs, ins.dst, rd(regs, ins.a) as f32);
            } else if op == F2I {
                wr(regs, ins.dst, (rf(regs, ins.a) as int) as u64);
            } else if op == F2U {
                wr(regs, ins.dst, rf(regs, ins.a) as u64);
            } else if op == I2D {
                wd(regs, ins.dst, (rd(regs, ins.a) as int) as f64);
            } else if op == U2D {
                wd(regs, ins.dst, rd(regs, ins.a) as f64);
            } else if op == D2I {
                wr(regs, ins.dst, (rdd(regs, ins.a) as int) as u64);
            } else if op == D2U {
                wr(regs, ins.dst, rdd(regs, ins.a) as u64);
            } else if op == F2D {
                wd(regs, ins.dst, rf(regs, ins.a) as f64);
            } else if op == D2F {
                wf(regs, ins.dst, rdd(regs, ins.a) as f32);
            } else if op == RETA {
                if result as int != 0 {
                    copyBytes(result as int, rd(regs, ins.a) as int, ins.imm as int);
                }
                return 0;
            } else if op == APP_LIT {
                append(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, ins.imm as int, ins.b as int);
            } else if op == APP_STR {
                appendStr(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) as int);
            } else if op == APP_INT {
                appendInt(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) as int);
            } else if op == APP_F64 {
                appendF64(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rdd(regs, ins.b));
            } else if op == APP_BOOL {
                appendBool(rd(regs, ins.dst) as int, rd(regs, ins.a) as int, rd(regs, ins.b) != 0);
            } else if op == ABORT || op == DIV0 {
                exit(1);
            } else {
                panic("script: bad opcode; rerun j3c");
            }
        }
        return 0;
    }

    /// Reload every module whose `.j3sb` changed and kept its layout. Instances and
    /// `shared` values stay. A module whose layout changed keeps its old code; `j3c run`
    /// relaunches the program for that.
    fn reload(this: &Vm) {
        let count = this.loaded;
        for i in 0..count {
            let old = this.modules[i];
            let file = readFile(this.arena, this.bytecodePath(old.path));
            let fresh = this.parse(file, old.path);
            if fresh.layoutHash != old.layoutHash {
                printLn(`script: {old.path} changed layout; restart to use it`);
                continue;
            }
            this.modules[i] = fresh;
            clearWords(this.fnSlots.ptr as int, TABLE_SLOTS * @sizeof(FnSlot));
            for m in 0..this.loaded {
                let owner = &this.modules[m];
                for f in 0..owner.functions.len { this.addFunction(&owner.functions[f]); }
            }
            this.link(i, old.globals);
        }
        for m in 0..this.loaded {
            let each = &this.modules[m];
            for f in 0..each.functions.len {
                for c in 0..each.functions[f].calls.len {
                    if each.functions[f].calls[c].kind == CALL_SCRIPT {
                        each.functions[f].calls[c].linked = false;
                    }
                }
            }
        }
    }

    /// Check `target/j3s/reload` (j3c bumps it after writing new bytecode) and reload.
    fn poll(this: &Vm) {
        if this.loaded == 0 { return; }
        let stamp = readStamp("target/j3s/reload");
        if stamp == this.reloadStamp { return; }
        this.reloadStamp = stamp;
        this.reload();
    }
}

struct Reader {
    base: int;
    at: int;
    end: int;

    fn need(this: &Reader, n: int) {
        if this.at + n > this.end { panic("script: truncated bytecode"); }
    }
    fn u16(this: &Reader): u16 { this.need(2); let v = ld16(this.at); this.at += 2; return v; }
    fn u32(this: &Reader): u32 { this.need(4); let v = ld32(this.at); this.at += 4; return v; }
    fn u64(this: &Reader): u64 { this.need(8); let v = ld64(this.at); this.at += 8; return v; }
    fn bytes(this: &Reader): []u8 {
        let n = this.u32() as int;
        this.need(n);
        let out: []u8 = @slice(this.at as ptr, n);
        this.at += n;
        return out;
    }
    fn text(this: &Reader): string { return this.bytes() as string; }
}

#[singleton]
let DEV: Vm;
#[singleton]
let DEV_READY: bool = false;

fn devVm(): &Vm {
    if !DEV_READY {
        DEV = Vm.create(268435456, 8388608);
        DEV_READY = true;
        DEV.reloadStamp = readStamp("target/j3s/reload");
        setFrameHook(poll);
    }
    return &DEV;
}

/// Dev builds: link one native function scripts may call.
pub fn devRegister(key: u64, call: fn(ptr, ptr)) {
    devVm().register(key, call);
}

/// Dev builds: `Door { ... }` for a script at `path` (`scripts/door.j3s`).
pub fn devNew(path: string, props: []Prop): ptr {
    let vm = devVm();
    return vm.new(vm.loadScript(path), props);
}

/// Dev builds: `door.toggle()`.
pub fn devCall(key: u64, instance: ptr, args: []Arg, result: ptr) {
    devVm().call(key, instance, args, result);
}

/// Swap in new script code at a frame boundary. `j3.app` calls this through
/// `j3.memory.frameHook`; a program without a window loop calls it itself.
pub fn poll() {
    if DEV_READY { DEV.poll(); }
}

fn missingThunk(args: ptr, result: ptr) {
    panic("script: native function not linked");
}

fn slotOf(key: u64): int {
    return (key % (TABLE_SLOTS as u64)) as int;
}

#[singleton]
let STAMP_BUF: [160]u8;

fn readStamp(path: string): int {
    if path.len >= 127 { return 0; }
    let base = &STAMP_BUF[0] as ptr as int;
    copyBytes(base, path.ptr as int, path.len);
    st8(base + path.len, 0);
    let fd = open(base as ptr, O_RDONLY);
    if fd < 0 { return 0; }
    let n = read(fd, (base + 128) as ptr, 31);
    close(fd);
    let value = 0;
    for i in 0..n {
        let c = ld8(base + 128 + i) as int;
        if c >= 48 && c <= 57 { value = value * 10 + (c - 48); }
    }
    return value;
}

fn readFile(arena: &Arena, path: string): []u8 {
    let cpath = arena.alloc::<u8>(path.len + 1);
    copyBytes(cpath.ptr as int, path.ptr as int, path.len);
    cpath[path.len] = 0;
    let fd = open(cpath.ptr as ptr, O_RDONLY);
    if fd < 0 {
        printLn(`script: cannot open {path}`);
        panic("script: missing bytecode; run the program with `j3c run`");
    }
    let size = lseek(fd, 0, SEEK_END);
    if size < 0 { panic("script: cannot size bytecode"); }
    lseek(fd, 0, SEEK_SET);
    let base = alignedAlloc(arena, size) as int;
    let done = 0;
    while done < size {
        let n = read(fd, (base + done) as ptr, size - done);
        if n <= 0 { panic("script: cannot read bytecode"); }
        done += n;
    }
    close(fd);
    let out: []u8 = @slice(base as ptr, size);
    return out;
}

/// `size` bytes at an 8-aligned address (the arena itself only bumps).
fn alignedAlloc(arena: &Arena, size: int): ptr {
    let raw = arena.allocBytes(size + 8) as int;
    return ((raw + 7) / 8 * 8) as ptr;
}

/// Append bytes to an interpolation buffer, like native code does (abort past the cap).
fn append(buf: int, used: int, src: int, n: int) {
    let have = ld64(used) as int;
    if have + n > INTERP_CAP { exit(1); }
    copyBytes(buf + have, src, n);
    st64(used, (have + n) as u64);
}

fn appendStr(buf: int, used: int, s: int) { append(buf, used, ld64(s) as int, ld64(s + 8) as int); }
fn appendInt(buf: int, used: int, v: int) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }
fn appendF64(buf: int, used: int, v: f64) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }
fn appendBool(buf: int, used: int, v: bool) { let t = `{v}`; append(buf, used, t.ptr as int, t.len); }

fn rd(regs: int, i: u32): u64 { let p = ((regs + (i as int) * 8) as ptr) as &u64; return *p; }
fn wr(regs: int, i: u32, v: u64) { let p = ((regs + (i as int) * 8) as ptr) as &u64; *p = v; }
fn wb(regs: int, i: u32, v: bool) { if v { wr(regs, i, 1); } else { wr(regs, i, 0); } }
fn rf(regs: int, i: u32): f32 { let p = ((regs + (i as int) * 8) as ptr) as &f32; return *p; }
fn wf(regs: int, i: u32, v: f32) { let p = ((regs + (i as int) * 8) as ptr) as &f32; *p = v; }
fn rdd(regs: int, i: u32): f64 { let p = ((regs + (i as int) * 8) as ptr) as &f64; return *p; }
fn wd(regs: int, i: u32, v: f64) { let p = ((regs + (i as int) * 8) as ptr) as &f64; *p = v; }

fn ld8(at: int): u8 { let p = (at as ptr) as &u8; return *p; }
fn ld16(at: int): u16 { let p = (at as ptr) as &u16; return *p; }
fn ld32(at: int): u32 { let p = (at as ptr) as &u32; return *p; }
fn ld64(at: int): u64 { let p = (at as ptr) as &u64; return *p; }
fn st8(at: int, v: u8) { let p = (at as ptr) as &u8; *p = v; }
fn st16(at: int, v: u16) { let p = (at as ptr) as &u16; *p = v; }
fn st32(at: int, v: u32) { let p = (at as ptr) as &u32; *p = v; }
fn st64(at: int, v: u64) { let p = (at as ptr) as &u64; *p = v; }

/// Store the low `size` bytes of a register value.
fn storeN(at: int, v: u64, size: int) {
    if size == 8 { st64(at, v); }
    else if size == 4 { st32(at, v as u32); }
    else if size == 2 { st16(at, v as u16); }
    else if size == 1 { st8(at, v as u8); }
    else { panic("script: odd scalar size"); }
}

/// Load a scalar from memory into register form with the given load opcode.
fn loadAs(at: int, op: u32): u64 {
    let code = op as u16;
    if code == LD8S { return (ld8(at) as i8) as int as u64; }
    if code == LD8U { return ld8(at) as u64; }
    if code == LD16S { return (ld16(at) as i16) as int as u64; }
    if code == LD16U { return ld16(at) as u64; }
    if code == LD32S { return (ld32(at) as i32) as int as u64; }
    if code == LD32U { return ld32(at) as u64; }
    return ld64(at);
}

fn copyBytes(dst: int, src: int, n: int) {
    let i = 0;
    while i + 8 <= n {
        st64(dst + i, ld64(src + i));
        i += 8;
    }
    while i < n {
        st8(dst + i, ld8(src + i));
        i += 1;
    }
}

fn clearBytes(at: int, n: int) {
    let i = 0;
    while i + 8 <= n {
        st64(at + i, 0);
        i += 8;
    }
    while i < n {
        st8(at + i, 0);
        i += 1;
    }
}

fn clearWords(at: int, n: int) {
    clearBytes(at, n);
}
