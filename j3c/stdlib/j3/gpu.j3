/// Shader programs written in J3. `#[shader(vertex)]` and `#[shader(fragment)]` fns, `#[vertex]` and `#[varying]`
/// structs and `#[uniform] let`s are checked and turned into GLSL text at compile time (`j3c doc shaders`).
/// `const PROG: Source = @shader(vs, fs);` is the pair as a `Source`: hand `PROG.vert` and `PROG.frag` to the
/// existing shader compile calls, bind uniforms by the names the `#[uniform] let`s have, and describe the vertex
/// buffers from `PROG.attrib(i)` instead of numbering attributes by hand.

module j3.gpu;

/// One vertex attribute of the program: what `glVertexAttribPointer` (or `glVertexAttribIPointer` when
/// `isInt`) and `glVertexAttribDivisor` take. `offset` is within the vertex struct; `stride` is its size.
pub struct Attrib {
    loc: int;
    comps: int;
    glType: int;
    offset: int;
    stride: int;
    divisor: int;
    isInt: bool;
    /// Fixed-point bytes read as 0..1 floats: the `normalized` argument of `glVertexAttribPointer`.
    normalized: bool;
}

/// Four bytes (r lowest) as a `#[vertex]` field: the shader sees a `vec4` of 0..1.
pub struct Rgba8 {
    r: u8;
    g: u8;
    b: u8;
    a: u8;
}

/// A vertex and fragment shader as GLSL 3.30 text (`#version 330 core`; the game's shader compile paths turn
/// it into ES 3.0 text at run time), the uniform names the program reads separated by spaces, and the vertex
/// attributes (`count` of them in `data`, 8 ints each; read them with `attrib`).
pub struct Source {
    vert: string;
    frag: string;
    uniforms: string;
    count: int;
    data: [128]i32;
}

/// Attribute `i` of `0 .. s.count`.
pub fn attrib(s: &Source, i: int): Attrib {
    let o = i * 8;
    return Attrib {
        loc: int(s.data[o]),
        comps: int(s.data[o + 1]),
        glType: int(s.data[o + 2]),
        offset: int(s.data[o + 3]),
        stride: int(s.data[o + 4]),
        divisor: int(s.data[o + 5]),
        isInt: s.data[o + 6] != 0,
        normalized: s.data[o + 7] != 0,
    };
}
