/// Windows j3.netsys. Same pub names as netsys.j3. Winsock 2 (`ws2_32`): `WSAStartup` runs
/// on the first `udp()`, and a SOCKET is a handle-sized integer.
/// Untested: no Windows box in the loop when this was written.

module j3.netsys;

use lib "ws2_32" as ws {
    fn WSAStartup(version: u32, data: ptr): i32;
    fn WSAGetLastError(): i32;
    fn socket(af: i32, kind: i32, proto: i32): int;
    fn ioctlsocket(s: int, cmd: i32, arg: ptr): i32;
    fn bind(s: int, sa: ptr, len: i32): i32;
    fn sendto(s: int, buf: ptr, n: i32, flags: i32, sa: ptr, len: i32): i32;
    fn recvfrom(s: int, buf: ptr, n: i32, flags: i32, sa: ptr, len: ptr): i32;
    fn getsockname(s: int, sa: ptr, len: ptr): i32;
    fn closesocket(s: int): i32;
}

/// `WSAEWOULDBLOCK`.
const WSAEWOULDBLOCK: int = 10035;
/// `WSAEMSGSIZE`: the datagram was longer than the buffer. The prefix is delivered, like Linux.
const WSAEMSGSIZE: int = 10040;
/// `FIONBIO`, as a signed i32.
const FIONBIO: int = 0 - 2147195266;
/// `INVALID_SOCKET` read as a signed int.
const INVALID_SOCKET: int = 0 - 1;

/// `WSADATA` scratch for `WSAStartup` (about 400 bytes on x64).
#[singleton]
let wsaData: [512]u8;

/// Winsock has been started.
#[singleton]
let started: bool = false;

/// `recvfrom` result: no datagram is waiting.
pub const NONE: int = 0 - 1;
/// Any call result: the OS refused.
pub const FAIL: int = 0 - 2;

/// A new non-blocking IPv4 UDP socket, or a negative number.
pub fn udp(): int {
    if !started {
        if ws.WSAStartup(u32(514), &wsaData[0] as ptr) != 0 {
            return FAIL;
        }
        started = true;
    }
    let s = ws.socket(2, 2, 0);
    if s == INVALID_SOCKET {
        return FAIL;
    }
    let on: u32 = 1;
    ws.ioctlsocket(s, i32(FIONBIO), &on as ptr);
    return s;
}

/// Stamp the address family into a 16-byte `sockaddr_in` (Windows: a u16 at byte 0).
pub fn family(sa: []u8) {
    sa[0] = 2;
    sa[1] = 0;
}

/// Bind `s` to the 16-byte `sockaddr_in` at `sa`. Negative on failure.
pub fn bind(s: int, sa: ptr): int {
    return int(ws.bind(s, sa, i32(16)));
}

/// Send `n` bytes of `buf` to the `sockaddr_in` at `sa`. Bytes sent, or `FAIL`.
pub fn sendto(s: int, buf: ptr, n: int, sa: ptr): int {
    let r = int(ws.sendto(s, buf, i32(n), i32(0), sa, i32(16)));
    if r < 0 {
        return FAIL;
    }
    return r;
}

/// Take one datagram into `buf` (cut at `n`) and write the sender to `sa`.
/// Bytes read, `NONE` when nothing is waiting, or `FAIL`.
pub fn recvfrom(s: int, buf: ptr, n: int, sa: ptr): int {
    let len: i32 = 16;
    let r = int(ws.recvfrom(s, buf, i32(n), i32(0), sa, &len as ptr));
    if r >= 0 {
        return r;
    }
    let e = int(ws.WSAGetLastError());
    if e == WSAEWOULDBLOCK {
        return NONE;
    }
    if e == WSAEMSGSIZE {
        return n;
    }
    return FAIL;
}

/// Write the address `s` is bound to into `sa`. Negative on failure.
pub fn sockname(s: int, sa: ptr): int {
    let len: i32 = 16;
    return int(ws.getsockname(s, sa, &len as ptr));
}

/// Close the socket.
pub fn shut(s: int) {
    ws.closesocket(s);
}
