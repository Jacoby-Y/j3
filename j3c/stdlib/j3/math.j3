/// Gameplay math is f32. `float` (f64) is not used here.
/// Any thread: no module state, so a worker can use a value it owns (`j3c doc threads`).

module j3.math;

use lib "m" as libm {
    fn sqrtf(x: f32): f32;
    fn sinf(x: f32): f32;
    fn cosf(x: f32): f32;
    fn tanf(x: f32): f32;
    fn asinf(x: f32): f32;
    fn acosf(x: f32): f32;
    fn atanf(x: f32): f32;
    fn atan2f(y: f32, x: f32): f32;
    fn floorf(x: f32): f32;
    fn ceilf(x: f32): f32;
    fn fabsf(x: f32): f32;
    fn expf(x: f32): f32;
    fn log10f(x: f32): f32;
}

/// Ratio of a circle's circumference to its diameter.
pub const PI: f32 = 3.1415927;
/// Full turn in radians (`2 * PI`).
pub const TAU: f32 = 6.2831855;

/// Square root via `libm.sqrtf`.
pub fn sqrt(x: f32): f32 {
    return libm.sqrtf(x);
}

/// Sine via `libm.sinf` (radians).
pub fn sin(x: f32): f32 {
    return libm.sinf(x);
}

/// Cosine via `libm.cosf` (radians).
pub fn cos(x: f32): f32 {
    return libm.cosf(x);
}

/// Tangent via `libm.tanf` (radians).
pub fn tan(x: f32): f32 {
    return libm.tanf(x);
}

/// Arcsine via `libm.asinf` (radians).
pub fn asin(x: f32): f32 {
    return libm.asinf(x);
}

/// Arccosine via `libm.acosf` (radians).
pub fn acos(x: f32): f32 {
    return libm.acosf(x);
}

/// Arctangent via `libm.atanf` (radians).
pub fn atan(x: f32): f32 {
    return libm.atanf(x);
}

/// Two-argument arctangent via `libm.atan2f` (radians).
pub fn atan2(y: f32, x: f32): f32 {
    return libm.atan2f(y, x);
}

/// Greatest integer not greater than `x`, via `libm.floorf`.
pub fn floor(x: f32): f32 {
    return libm.floorf(x);
}

/// Least integer not less than `x`, via `libm.ceilf`.
pub fn ceil(x: f32): f32 {
    return libm.ceilf(x);
}

/// Absolute value via `libm.fabsf`.
pub fn abs(x: f32): f32 {
    return libm.fabsf(x);
}

/// e raised to `x`, via `libm.expf`.
pub fn exp(x: f32): f32 {
    return libm.expf(x);
}

/// Base-10 logarithm via `libm.log10f`.
pub fn log10(x: f32): f32 {
    return libm.log10f(x);
}

/// Integer absolute value (`0 - x` when negative).
pub fn absi(x: int): int {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

/// `x` wrapped into `[0, n)` for `n > 0`. `%` truncates (`-1 % 4 == -1`); this gives 3.
pub fn wrapi(x: int, n: int): int {
    let r = x % n;
    if r < 0 {
        r += n;
    }
    return r;
}

/// Lesser of two `f32` values.
pub fn min(a: f32, b: f32): f32 {
    if a < b {
        return a;
    }
    return b;
}

/// Greater of two `f32` values.
pub fn max(a: f32, b: f32): f32 {
    if a > b {
        return a;
    }
    return b;
}

/// Lesser of two integers.
pub fn mini(a: int, b: int): int {
    if a < b {
        return a;
    }
    return b;
}

/// Greater of two integers.
pub fn maxi(a: int, b: int): int {
    if a > b {
        return a;
    }
    return b;
}

/// Clamp `x` into `[lo, hi]` using `min`/`max`.
pub fn clamp(x: f32, lo: f32, hi: f32): f32 {
    return max(lo, min(x, hi));
}

/// Clamp integer `x` into `[lo, hi]`.
pub fn clampi(x: int, lo: int, hi: int): int {
    return maxi(lo, mini(x, hi));
}

/// Linear interpolate from `a` to `b` by factor `t`.
pub fn lerp(a: f32, b: f32, t: f32): f32 {
    return a + (b - a) * t;
}

/// Sign of `x`: `-1`, `0`, or `1`.
pub fn sign(x: f32): f32 {
    if x < 0 {
        return -1;
    }
    if x > 0 {
        return 1;
    }
    return 0;
}
