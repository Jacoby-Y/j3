/// `?` is `#[TryCatch]`, not this name. Compiler does not special-case `Result`.

module j3.result;

/// Success or failure. `?` uses `#[TryCatch]`: `Err` propagates, `Ok` unwraps.
#[TryCatch(Ok, Err)]
pub enum Result<T, E> {
    /// A value of `T`.
    Ok(T),
    /// A failure of `E`.
    Err(E),
}
