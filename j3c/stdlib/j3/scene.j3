/// Int scene stack. Swap with `replace`, pause with `push`/`pop`.

module j3.scene;

use j3.memory.Arena;

/// Stack of scene ids. `push` pauses, `replace` swaps the current scene.
pub struct Scenes {
    /// Scene ids, oldest at index 0. Grows from `arena`.
    stack: []int;
    /// Number of live ids.
    len: int;
    /// Allocator used when the stack grows.
    arena: &Arena;

    /// Empty stack with room for 8 ids.
    fn new(arena: &Arena): Scenes {
        return Scenes {
            stack: arena.alloc::<int>(8),
            len: 0,
            arena: arena,
        };
    }

    /// Pause the current scene and put `id` on top.
    fn push(this: &Scenes, id: int) {
        if this.len >= this.stack.len {
            let next = 8;
            if this.stack.len != 0 {
                next = this.stack.len * 2;
            }
            let fresh = this.arena.alloc::<int>(next);
            let i = 0;
            while i < this.len {
                fresh[i] = this.stack[i];
                i += 1;
            }
            this.stack = fresh;
        }
        this.stack[this.len] = id;
        this.len = this.len + 1;
    }

    /// Remove the top scene. Returns 0 when the stack is empty.
    fn pop(this: &Scenes): int {
        if this.len == 0 {
            return 0;
        }
        this.len = this.len - 1;
        return this.stack[this.len];
    }

    /// The current scene id, or 0 when empty.
    fn top(this: &Scenes): int {
        if this.len == 0 {
            return 0;
        }
        return this.stack[this.len - 1];
    }

    /// True when `top` equals `id`.
    fn is(this: &Scenes, id: int): bool {
        return this.top() == id;
    }

    /// Replace the current scene. Pushes when the stack is empty.
    fn replace(this: &Scenes, id: int) {
        if this.len == 0 {
            this.push(id);
            return;
        }
        this.stack[this.len - 1] = id;
    }
}
