/// Arithmetic of draggable, resizable, dockable panels, with no tree and no GL: keeping a panel inside
/// its workspace, snapping to dock zones, and resizing. `j3.ui.panels` runs it on a `Dom`; the markup
/// side is `panel`, `panel-handle` and `panel-resize` (`j3c doc j3ui`). All numbers are CSS px inside
/// the workspace (the panel's parent box, or the window for `position: fixed`).

module j3.ui.panelmath;

use j3.math.{ abs, max, min };

/// `Panel.dock` values: floating, or snapped to a workspace edge.
pub const DOCK_NONE: int = 0;
pub const DOCK_LEFT: int = 1;
pub const DOCK_RIGHT: int = 2;
pub const DOCK_BOTTOM: int = 3;

/// A press this close to a workspace edge (px) while dragging offers that dock zone.
pub const EDGE: f32 = 28.0;
/// Pointer travel (px) before a press on a handle becomes a drag, so a click on a docked header stays put.
pub const SLOP: f32 = 4.0;
/// Smallest size a panel is resized to when its CSS has no `min-width` / `min-height`.
pub const MIN_W: f32 = 80.0;
pub const MIN_H: f32 = 36.0;
/// A docked panel takes at most this share of the workspace across its dock axis.
const MAX_DOCK: f32 = 0.8;

/// Box in workspace px.
pub struct Rect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

/// State of one panel element. `node` is -1 for a free slot. `set` is true once the user (or a
/// shrinking window) took the position away from the CSS; `fw` / `fh` are the floating size
/// (-1 until resized), kept while docked so undocking restores them.
pub struct Panel {
    node: int;
    canDock: bool;
    dock: int;
    set: bool;
    x: f32;
    y: f32;
    fw: f32;
    fh: f32;
    /// The zone the pointer is over while dragging (previewed, applied on release).
    zone: int;
}

/// What the pointer is doing: `mode` 0 nothing, 1 move, 2 resize; `panel` indexes the panel list;
/// the grab offset inside the panel (move) or the start point and size (resize); `live` once past `SLOP`.
pub struct Grab {
    mode: int;
    panel: int;
    gx: f32;
    gy: f32;
    sx: f32;
    sy: f32;
    w0: f32;
    h0: f32;
    live: bool;
}

pub fn noGrab(): Grab {
    return Grab { mode: 0, panel: -1, gx: 0.0, gy: 0.0, sx: 0.0, sy: 0.0, w0: 0.0, h0: 0.0, live: false };
}

/// A new panel state for element `node`.
pub fn fresh(node: int, canDock: bool): Panel {
    return Panel { node: node, canDock: canDock, dock: DOCK_NONE, set: false, x: 0.0, y: 0.0, fw: -1.0, fh: -1.0, zone: DOCK_NONE };
}

/// The index of the panel of `node` among the first `n` of `l` (-1 for none). `node` -1 finds a free slot.
pub fn find(l: []Panel, n: int, node: int): int {
    for i in 0..n {
        if l[i].node == node {
            return i;
        }
    }
    return -1;
}

/// The slot for a panel of `node`: its own, else a free one (-1: append).
pub fn slot(l: []Panel, n: int, node: int): int {
    let at = find(l, n, node);
    return if at < 0 { find(l, n, -1) } else { at };
}

/// `v` as a position of a box `size` long inside `0..ws` (a box longer than the workspace sits at 0).
pub fn clampPos(v: f32, size: f32, ws: f32): f32 {
    return max(0.0, min(v, ws - size));
}

/// `v` as a size between `lo` and the workspace (`lo` wins when the workspace is smaller).
pub fn clampSize(v: f32, lo: f32, ws: f32): f32 {
    return max(lo, min(v, max(ws, lo)));
}

/// The dock zone at workspace point `(px, py)` (`DOCK_NONE` away from the left, right and bottom edges).
pub fn zoneAt(px: f32, py: f32, wsw: f32, wsh: f32): int {
    if px < 0.0 || py < 0.0 || px > wsw || py > wsh {
        return DOCK_NONE;
    }
    if px < EDGE {
        return DOCK_LEFT;
    }
    if px > wsw - EDGE {
        return DOCK_RIGHT;
    }
    if py > wsh - EDGE {
        return DOCK_BOTTOM;
    }
    return DOCK_NONE;
}

/// The box a panel of floating size `fw` by `fh` (-1 for unknown: `cw` by `ch`, its current size) fills
/// in zone `z`: full height on the left or right, full width at the bottom.
pub fn dockRect(z: int, fw: f32, fh: f32, wsw: f32, wsh: f32, minW: f32, minH: f32): Rect {
    if z == DOCK_BOTTOM {
        let h = clampSize(fh, minH, wsh * MAX_DOCK);
        return Rect { x: 0.0, y: wsh - h, w: wsw, h: h };
    }
    let w = clampSize(fw, minW, wsw * MAX_DOCK);
    if z == DOCK_RIGHT {
        return Rect { x: wsw - w, y: 0.0, w: w, h: wsh };
    }
    return Rect { x: 0.0, y: 0.0, w: w, h: wsh };
}

/// Size after the pointer moved `(dx, dy)` since a resize began at `w0` by `h0`. A floating panel grows
/// from its bottom-right corner; a docked one only along its dock axis, from the inner edge (so a right
/// or bottom panel grows when dragged left or up).
pub fn resized(z: int, dx: f32, dy: f32, w0: f32, h0: f32): Rect {
    if z == DOCK_LEFT {
        return Rect { x: 0.0, y: 0.0, w: w0 + dx, h: h0 };
    }
    if z == DOCK_RIGHT {
        return Rect { x: 0.0, y: 0.0, w: w0 - dx, h: h0 };
    }
    if z == DOCK_BOTTOM {
        return Rect { x: 0.0, y: 0.0, w: w0, h: h0 - dy };
    }
    return Rect { x: 0.0, y: 0.0, w: w0 + dx, h: h0 + dy };
}

/// Whether the pointer has left the press point by more than `SLOP`.
pub fn pastSlop(dx: f32, dy: f32): bool {
    return abs(dx) + abs(dy) > SLOP;
}

/// Where a panel of size `w` by `h` sits for the pointer at `(px, py)` holding it at grab offset
/// `(gx, gy)`, kept inside the workspace.
pub fn dragPos(px: f32, py: f32, gx: f32, gy: f32, w: f32, h: f32, wsw: f32, wsh: f32): Rect {
    return Rect { x: clampPos(px - gx, w, wsw), y: clampPos(py - gy, h, wsh), w: w, h: h };
}
