/// State of the one item drag in progress (`j3.ui.drag` runs it, `Dom.drag` holds it; markup is `draggable`,
/// `on:dragstart` .. `on:dragend`, `j3c doc j3ui`). No tree and no GL, so `Dom` can hold it.
///
/// `state`: 0 idle, 1 pressed on a source (waiting for the pointer to pass the slop), 2 dragging, 3 cancelled
/// (Escape) until the button is released. The `*At` fields are the frame (`Dom.frame`) an event fired on, the `*N`
/// fields the node it fired on; generated code asks `d.dragEntered(n)` and so on. `dragend` is delivered the frame
/// AFTER the release (`endAt`), so a `drop` handler always runs first, wherever the two elements are in the markup.

module j3.ui.dragstate;

pub struct Drag {
    state: int;
    src: int;
    x0: f32;
    y0: f32;
    /// The innermost element with a drag handler under the pointer, and the one that rejected the drag (-1 none).
    tgt: int;
    rej: int;
    startAt: int;
    endN: int;
    endAt: int;
    dropped: bool;
    enterN: int;
    enterAt: int;
    leaveN: int;
    leaveAt: int;
    overN: int;
    overAt: int;
    dropN: int;
    dropAt: int;
}

pub fn fresh(): Drag {
    return Drag { state: 0, src: -1, x0: 0.0, y0: 0.0, tgt: -1, rej: -1, startAt: -1, endN: -1, endAt: -1, dropped: false, enterN: -1, enterAt: -1, leaveN: -1, leaveAt: -1, overN: -1, overAt: -1, dropN: -1, dropAt: -1 };
}

/// Node `id` was freed: forget it everywhere, so no event fires on, and no ghost is painted of, whatever reuses its id.
/// A source that goes ends the drag without a `dragend` (nothing is left to receive it).
pub fn forget(g: &Drag, id: int) {
    if g.src == id {
        g.src = -1;
        if g.state == 1 || g.state == 2 {
            g.state = 0;
        }
    }
    if g.tgt == id { g.tgt = -1; g.rej = -1; }
    if g.enterN == id { g.enterN = -1; }
    if g.leaveN == id { g.leaveN = -1; }
    if g.overN == id { g.overN = -1; }
    if g.dropN == id { g.dropN = -1; }
    if g.endN == id { g.endN = -1; }
}
