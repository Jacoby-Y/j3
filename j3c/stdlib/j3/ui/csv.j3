/// Comma-separated lists of values: how a `<select multiple>` binds (`"red,blue"`). No escaping: a
/// value that contains a comma cannot be told apart. No allocation.

module j3.ui.csv;

use j3.text.same;

/// Whether `v` is one of the items of `list`. An empty list holds nothing.
pub fn has(list: string, v: string): bool {
    let i = 0;
    while i <= list.len {
        let j = i;
        while j < list.len && list[j] != 44 {
            j += 1;
        }
        if j > i && same(list[i..j], v) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

/// How many items `list` has.
pub fn count(list: string): int {
    let n = 0;
    let i = 0;
    while i <= list.len {
        let j = i;
        while j < list.len && list[j] != 44 {
            j += 1;
        }
        if j > i {
            n += 1;
        }
        i = j + 1;
    }
    return n;
}
