/// The CSS parser entry point: declarations, selectors, rule blocks, `@keyframes`, `@font-face`, and `parse(&css, src, file, scope)`.

module j3.ui.cssparse;

use j3.text.{ Text, same };
use j3.ui.css.{ animKind, CK_NONE, COMB_CHILD, COMB_DESC, COMB_NEXT, COMB_SIB, Css, FL_ACTIVE, FL_DISABLED, FL_DRAGGING, FL_DROP, FL_CHECKED, FL_FIRST_CHILD, FL_FOCUS, FL_OPEN, FL_PH_SHOWN, FL_FOCUS_VIS, FL_FOCUS_WITHIN, FL_LAST_CHILD, NK_CHILD, NK_LAST_CHILD, NK_LAST_TYPE, NK_TYPE, SS_EMPTY, SS_FIRST_TYPE, SS_LAST_TYPE, SS_ONLY_CHILD, SS_ONLY_TYPE };
use j3.ui.css.{ FL_HOVER, FontFace, Frame, hasBit, Keyframes, P_BACKGROUND, P_BG_IMAGE, P_BG_POS, P_BG_REPEAT, P_BG_SIZE, P_BORDER_IMAGE, P_BORDER_IMG_W, P_BORDER_OUTSET, P_BORDER_REPEAT, P_BORDER_SLICE };
use j3.ui.css.{ P_BORDER_TOP_COLOR, P_BORDER_TOP_WIDTH, P_FONT_FAMILY, P_FONT_SIZE, P_FONT_WEIGHT, P_GAP, P_LINE_HEIGHT, P_MARGIN_TOP };
use j3.ui.css.{ P_SCROLL_MARGIN, P_SCROLL_PAD };
use j3.ui.css.{ Media, NPROPS, P_PADDING_TOP, P_RADIUS_TL, P_ROW_GAP, PS_ROOT, Rule, Sheet, SrcText, Step };
use j3.ui.css.DeclLog;
use j3.ui.css.{ coerceSyn, Reg, SY_ANGLE, SY_ANY, SY_COLOR, SY_LEN, SY_LENPCT, SY_NUM, SY_PCT, SY_URL, Value, Deferred, P_ANIM_FILL, P_ANIM_NAME, P_ALL, P_DEFER, V_AUTO, V_COLOR, V_INHERIT, V_INITIAL, V_NONE, V_NUM, V_REVERT, V_UNSET, V_UNSETKW };
use j3.ui.csslex.{ Lexer, next, T_AT, T_COLON, T_COMMA, T_DELIM, T_EOF, T_FUNC };
use j3.ui.csslex.{ T_IDENT, T_LBRACE, T_LBRACK, T_LPAREN, T_NUM, T_PCT, T_RBRACE, T_RBRACK };
use j3.ui.csslex.{ T_HASH, T_RPAREN, T_SEMI, T_STR, T_URL, Token };
use j3.ui.cssvalue.{ gradients, isWord, mk, P, parseColor, parseLen, propId, setTk, tk, unitIs };
use j3.ui.cssvalue.{ txt, warnAt, warnName, expects, catOf, C_KW };
use j3.ui.cssprop.{ animation, animList, hasListComma, hasUrl, borderSides, box4, decoration, emit, outline, overflow2, parseVal, scrollbarColor, stroke, wave };
use j3.ui.cssprop.{ parseCustom, transitions, wideKind, wideShort };
use j3.ui.cssgrid;
use j3.ui.cssnest.{ join, part };
use j3.ui.cssimage.{ bgShorthand, borderImage };

#[singleton]
#[thread]
let PEND: [576]Rule;

/// `@media` conditions open at the top level (saved `p.mq`), and the resolved selector list of each open rule level (nesting).
#[singleton]
#[thread]
let MQS: [8]int;

#[singleton]
#[thread]
let PT: [9]string;

/// `style:name="text"`: parse `text` as the value of property `name` and append its declarations
/// to `css.decls` (a shorthand gives several). Returns how many; 0 with a warning when the value is
/// not valid. The caller copies them out and cuts `css.decls` back.
pub fn inlineDecl(css: &Css, name: string, text: string): int {
    let p = P {
        css: css,
        lx: Lexer { src: text, pos: 0, line: 1, ls: 0 },
        file: "style:",
        scope: 0,
        npend: 0,
        mode: 0,
        ffFamily: 0,
        ffPath: "",
        ffHave: false,
        ndecl: 0,
        mq: -1,
        vs: 0,
        ve: 0,
        late: false,
        pdSeen: 0,
        pdSyn: 0,
        pdInh: false,
        pdInit: "",
        pdLine: 0,
        pdCol: 0,
        nlev: -1,
        pbase: 0,
        mqd: 0,
        kf: false,
    };
    let n = 0;
    while true {
        let t = next(&p.lx);
        if t.kind == T_EOF {
            break;
        }
        if n >= 192 {
            warnAt(&p, 1, 1, "value is too long");
            return 0;
        }
        setTk(n, t);
        n += 1;
    }
    let w0 = css.warns.len;
    declare(&p, name, 1, 1, n);
    if css.warns.len > w0 {
        return 0;
    }
    return p.ndecl;
}

/// Parse `src` as CSS and append its rules, `@font-face`s, custom properties, and warnings to
/// `css`. `file` is for messages and for resolving `url()`; `scope` is 0 for global CSS or the
/// component id for a component's `<style>`. Parse the global sheet first (source order breaks
/// specificity ties). Invalidates the style cache: recompute styles after calling it.
pub fn parse(css: &Css, text: string, file: string, scope: int): Sheet {
    return parseAt(css, text, file, scope, 0);
}

/// `parse` for a style block that starts below the top of `file` (a `.j3ui`): `line0` lines come before it, so line numbers are the file's.
pub fn parseAt(css: &Css, text: string, file: string, scope: int, line0: int): Sheet {
    css.clearCache();
    let src = text;
    for i in 0..css.hot.len {
        let h = &css.hot.items[i];
        if h.live && same(h.path, file) {
            src = h.style;
            line0 = h.line0;
        }
    }
    let p = P {
        css: css,
        lx: Lexer { src: src, pos: 0, line: 1 + line0, ls: 0 },
        file: file,
        scope: scope,
        npend: 0,
        mode: 0,
        ffFamily: 0,
        ffPath: "",
        ffHave: false,
        ndecl: 0,
        mq: -1,
        vs: 0,
        ve: 0,
        late: true,
        pdSeen: 0,
        pdSyn: 0,
        pdInh: false,
        pdInit: "",
        pdLine: 0,
        pdCol: 0,
        nlev: -1,
        pbase: 0,
        mqd: 0,
        kf: false,
    };
    css.srcs.push(SrcText { file: file, text: src, scope: scope });
    let sheet = Sheet { file: file, scope: scope, rule0: css.rules.len, nrules: 0, warn0: css.warns.len, nwarn: 0 };
    while true {
        let pos0 = p.lx.pos;
        let t = next(&p.lx);
        if t.kind == T_EOF {
            break;
        }
        if t.kind == T_AT {
            atRule(&p, t);
            continue;
        }
        if t.kind == T_RBRACE && p.mqd > 0 {
            p.mqd -= 1;
            p.mq = MQS[p.mqd];
            continue;
        }
        if t.kind == T_RBRACE || t.kind == T_SEMI {
            warnAt(&p, t.line, t.col, "unexpected token");
            continue;
        }
        // prelude up to `{`
        let n = 0;
        setTk(0, t);
        n = 1;
        let tooLong = false;
        let open = false;
        let bracePos = 0;
        while true {
            let v = next(&p.lx);
            if v.kind == T_LBRACE {
                open = true;
                bracePos = p.lx.pos - 1;
                break;
            }
            if v.kind == T_EOF || v.kind == T_RBRACE {
                break;
            }
            if n < 192 {
                setTk(n, v);
                n += 1;
            } else {
                tooLong = true;
            }
        }
        if !open {
            warnAt(&p, t.line, t.col, "selector without a block");
            if tooLong {
                continue;
            }
            continue;
        }
        p.npend = 0;
        if tooLong {
            warnAt(&p, t.line, t.col, "selector is too long");
        } else {
            let g0 = 0;
            // a comma inside `:not( )` does not end the selector
            let depth = 0;
            for i in 0..=n {
                if i < n && tk(i).kind == T_FUNC {
                    depth += 1;
                } else if i < n && tk(i).kind == T_RPAREN && depth > 0 {
                    depth -= 1;
                }
                if i == n || (tk(i).kind == T_COMMA && depth == 0) {
                    compileSel(&p, g0, i);
                    g0 = i + 1;
                }
            }
        }
        p.ndecl = 0;
        // declarations overwrite TOK, so the selectors were compiled first; the block pushes its own rules (nested ones too)
        PT[0] = p.lx.src[pos0..bracePos];
        p.nlev = 0;
        p.pbase = 0;
        parseBlock(&p);
        p.nlev = -1;
    }
    sheet.nrules = css.rules.len - sheet.rule0;
    sheet.nwarn = css.warns.len - sheet.warn0;
    css.sheets.push(sheet);
    return sheet;
}

