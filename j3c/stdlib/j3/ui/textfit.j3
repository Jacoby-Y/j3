/// Cutting UTF-8 text to a width, for `j3.ui.dom` (`text-overflow: ellipsis`, `overflow-wrap:
/// break-word`) and for text animation. Measures with `j3.game.textWidth` (SDL_ttf, no window). Cuts
/// always fall between code points. No GL; main thread only (it uses the font handle).
///
/// ```
/// let n = fitPrefix(font, false, bytes, 120.0);   // bytes[0..n] is at most 120 px wide
/// ```

module j3.ui.textfit;

use j3.game.{ Font, textWidth };

/// True when `b` is a UTF-8 continuation byte (`10xxxxxx`), so a cut before it would split a code point.
pub fn isCont(b: u8): bool {
    return (int(b) / 64) % 4 == 2;
}

/// The byte length of the code point that starts at `s[i]` (1 for a stray continuation byte), at most `s.len - i`.
pub fn cpLen(s: []u8, i: int): int {
    let n = 1;
    while i + n < s.len && isCont(s[i + n]) {
        n += 1;
    }
    return n;
}

/// The longest prefix of `s` whose width is at most `maxW`, as a byte length on a code point
/// boundary (0 when not even the first code point fits). Probes at doubling lengths, then bisects, so
/// the cost follows the prefix that fits, not the length of `s`.
pub fn fitPrefix(font: Font, bold: bool, s: []u8, maxW: f32): int {
    if s.len == 0 || maxW <= 0.0 {
        return 0;
    }
    let lo = 0;
    let hi = 0;
    let probe = 16;
    while true {
        let p = probe;
        if p >= s.len {
            p = s.len;
        } else {
            while p > lo && isCont(s[p]) {
                p -= 1;
            }
        }
        if textWidth(font, s[0..p], bold) <= maxW {
            if p == s.len {
                return p;
            }
            lo = p;
            probe = probe * 2;
        } else {
            hi = p - 1;
            break;
        }
    }
    while true {
        let nxt = lo + cpLen(s, lo);
        if nxt > hi {
            break;
        }
        let b = (lo + hi + 1) / 2;
        while b > lo && b < s.len && isCont(s[b]) {
            b -= 1;
        }
        if b <= lo {
            b = nxt;
        }
        if textWidth(font, s[0..b], bold) <= maxW {
            lo = b;
        } else {
            hi = b - 1;
        }
    }
    return lo;
}

/// `s` cut to its first `n` code points (the whole string when it has fewer). A view, no copy.
pub fn codePoints(s: string, n: int): string {
    let i = 0;
    let seen = 0;
    while i < s.len && seen < n {
        i += 1;
        while i < s.len && isCont(s[i]) {
            i += 1;
        }
        seen += 1;
    }
    return s[0..i];
}
