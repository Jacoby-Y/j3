// Part of j3.ui.media; Setters: source, sprite, icon, paint and numbers. The module doc and `use`s are in ../media.j3.
module j3.ui.media;

/// `Dom.attrMedia` kinds: `src`, `sprite="cols,rows"`, `viewBox="x y w h"`, `d`, `fill`, `stroke`,
/// `fill-rule`, and `M_ICON` (`x y w h|E<d>|N<d>...`: a viewBox, then path data per fill rule; `j3c/src/ui/icons.rs`).
pub const M_SRC: int = 0;
pub const M_SPRITE: int = 1;
pub const M_VIEWBOX: int = 2;
pub const M_D: int = 3;
pub const M_FILL: int = 4;
pub const M_STROKE: int = 5;
pub const M_FILL_RULE: int = 6;
pub const M_ICON: int = 7;

/// `Dom.attrMediaNum` kinds: `frame`, `fps`, `stroke-width`.
pub const N_FRAME: int = 0;
pub const N_FPS: int = 1;
pub const N_STROKE_WIDTH: int = 2;

/// Set a string attribute; true when the size of the element may have changed.
pub fn setStr(m: &Media, mem: &Arena, what: int, s: string): bool {
    if what == M_SRC {
        if store(mem, &m.src, &m.srcLen, s) {
            m.need = true;
            return true;
        }
    } else if what == M_SPRITE {
        let v: [2]f32 = [1.0, 1.0];
        let c = m.cols;
        let r = m.rows;
        if path.numbers(s, v[0..2]) == 2 {
            m.cols = maxi(1, int(v[0]));
            m.rows = maxi(1, int(v[1]));
        }
        return c != m.cols || r != m.rows;
    } else if what == M_VIEWBOX {
        let had = m.hasVb;
        let w0 = m.vb[2];
        let h0 = m.vb[3];
        m.hasVb = path.numbers(s, m.vb[0..4]) == 4 && m.vb[2] > 0.0 && m.vb[3] > 0.0;
        return had != m.hasVb || w0 != m.vb[2] || h0 != m.vb[3];
    } else if what == M_D {
        // flattened once per change
        if store(mem, &m.dText, &m.dLen, s) {
            if m.pts.len == 0 {
                m.pts = mem.alloc::<f32>(2 * path.MAXPT);
            }
            m.flat = path.parseFit(m.dText[0..m.dLen] as string, m.pts);
        }
    } else if what == M_FILL {
        m.fillMode = parsePaint(s, &m.fillC);
    } else if what == M_STROKE {
        m.strokeMode = parsePaint(s, &m.strokeC);
    } else if what == M_FILL_RULE {
        m.evenOdd = s.len == 7 && int(s[0]) == 101;
    } else if what == M_ICON {
        return setIcon(m, mem, s);
    }
    return false;
}

/// The `<icon>` whose name is `name`: its data from `table` (`name\tdata` lines), set when the name
/// changes. False when the name is not in the table (nothing draws). `changed` says the size may have.
pub fn icon(m: &Media, mem: &Arena, name: string, table: string, changed: &bool): bool {
    if !store(mem, &m.iName, &m.iLen, name) {
        return m.runs > 0;
    }
    let i = 0;
    while i < table.len {
        let e = i;
        while e < table.len && int(table[e]) != 10 {
            e += 1;
        }
        let t = i + name.len;
        if t < e && int(table[t]) == 9 && same(table[i..t], name) {
            *changed = setIcon(m, mem, table[t + 1..e]);
            return true;
        }
        i = e + 1;
    }
    *changed = setIcon(m, mem, "");
    return false;
}

/// `M_ICON` data: the viewBox, then each `|`-separated run flattened into `flat` with the points left
/// shared between the runs still to come.
fn setIcon(m: &Media, mem: &Arena, s: string): bool {
    let had = m.hasVb;
    let w0 = m.vb[2];
    let h0 = m.vb[3];
    m.runs = 0;
    m.flat.n = 0;
    m.hasVb = false;
    let bar = 0;
    while bar < s.len && int(s[bar]) != 124 {
        bar += 1;
    }
    if bar < s.len {
        m.hasVb = path.numbers(s[0..bar], m.vb[0..4]) == 4 && m.vb[2] > 0.0 && m.vb[3] > 0.0;
        if m.pts.len == 0 {
            m.pts = mem.alloc::<f32>(2 * path.MAXPT);
        }
        let left = 0;
        for k in bar..s.len {
            if int(s[k]) == 124 {
                left += 1;
            }
        }
        let used = 0;
        let i = bar + 1;
        while i < s.len && m.runs < 8 {
            let e = i;
            while e < s.len && int(s[e]) != 124 {
                e += 1;
            }
            if e > i {
                let room = (path.MAXPT - used) / maxi(1, left);
                let p = path.parseFit(s[i + 1..e], m.pts[2 * used..2 * (used + room)]);
                used += p.n;
                if m.runs == 0 {
                    m.flat = p;
                } else {
                    m.flat.minx = min(m.flat.minx, p.minx);
                    m.flat.miny = min(m.flat.miny, p.miny);
                    m.flat.maxx = max(m.flat.maxx, p.maxx);
                    m.flat.maxy = max(m.flat.maxy, p.maxy);
                }
                m.flat.pts = m.pts[0..2 * used];
                m.flat.n = used;
                m.runEnd[m.runs] = used;
                m.runEo[m.runs] = int(s[i]) == 69;
                m.runs += 1;
            }
            left -= 1;
            i = e + 1;
        }
    }
    return had != m.hasVb || w0 != m.vb[2] || h0 != m.vb[3];
}

/// Set a number attribute.
pub fn setNum(m: &Media, what: int, v: f32) {
    if what == N_FRAME {
        m.frame = v;
    } else if what == N_FPS {
        m.fps = v;
    } else {
        m.sw = v;
    }
}

fn hexNib(c: int): int {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    if c >= 65 && c <= 70 { return c - 55; }
    return -1;
}

/// A `fill` / `stroke` value: `none`, `currentColor`, `accent`, a CSS color name (`red`, any case), `transparent`, `#rgb`, `#rrggbb`, `#rrggbbaa`. Returns the paint mode. No `rgb()` or `hsl()` here.
pub fn parsePaint(s: string, out: &Color): int {
    if same(s, "none") {
        return PAINT_NONE;
    }
    if same(s, "currentColor") || same(s, "currentcolor") {
        return PAINT_CURRENT;
    }
    if same(s, "accent") {
        return PAINT_ACCENT;
    }
    if same(s, "white") || same(s, "black") || same(s, "transparent") {
        let channel: u8 = 0;
        if same(s, "white") { channel = 255; }
        *out = Color { r: channel, g: channel, b: channel, a: 255 };
        if same(s, "transparent") { out.a = 0; }
        return PAINT_COLOR;
    }
    let nc = namedColor(s);
    if nc >= 0 {
        *out = Color { r: u8((nc / 65536) % 256), g: u8((nc / 256) % 256), b: u8(nc % 256), a: 255 };
        return PAINT_COLOR;
    }
    if s.len >= 4 && int(s[0]) == 35 {
        let nd = s.len - 1;
        if nd == 3 || nd == 6 || nd == 8 {
            let v: [8]int = [0, 0, 0, 0, 0, 0, 15, 15];
            let ok = true;
            for i in 0..nd {
                let h = hexNib(int(s[1 + i]));
                if h < 0 {
                    ok = false;
                }
                v[i] = h;
            }
            if ok {
                if nd == 3 {
                    out.r = u8(v[0] * 17);
                    out.g = u8(v[1] * 17);
                    out.b = u8(v[2] * 17);
                    out.a = 255;
                } else {
                    out.r = u8(v[0] * 16 + v[1]);
                    out.g = u8(v[2] * 16 + v[3]);
                    out.b = u8(v[4] * 16 + v[5]);
                    out.a = 255;
                    if nd == 8 {
                        out.a = u8(v[6] * 16 + v[7]);
                    }
                }
                return PAINT_COLOR;
            }
        }
    }
    return PAINT_NONE;
}
