// Part of j3.ui (immediate mode); `Ui` styled widgets: cards, toggle, check, chip, rule. The module doc, `use`s and shared types are in ../ui.j3.
module j3.ui;

/// Absolute value.
fn abs(v: f32): f32 {
    if v < 0 {
        return 0 - v;
    }
    return v;
}

/// Fixed rect button. Does not move the cursor. `on` false draws dim and never clicks.
fn pressAt(ui: &Ui, caption: string, x: f32, y: f32, w: f32, h: f32, on: bool): bool {
    let pos = Vec2 { x: x, y: y };
    let size = Vec2 { x: w, y: h };
    let id = ui.widget(caption);
    let hit = false;
    if on && ui.shown(y, h) {
        hit = inside(pos, size);
    }
    if hit {
        uiInput.hot = id;
    }
    let clicked = false;
    if hit && mousePressed(Mouse.Left) {
        uiInput.active = id;
        clicked = true;
    }
    let face = ui.theme.button;
    let ink = ui.theme.text;
    if !on {
        face = mixColor(ui.theme.button, ui.theme.panel, 0.45);
        ink = mixColor(ui.theme.text, ui.theme.button, 0.5);
    } else if uiInput.active == id {
        face = ui.theme.buttonDown;
    } else if hit {
        face = ui.theme.buttonHot;
    }
    if ui.shown(y, h) {
        fillRound(x, y, w, h, 6, face);
        if ui.font.raw != 0 {
            setColor(ink);
            let tw = ui.words(caption);
            drawText(ui.font, Vec2 { x: x + (w - tw) * 0.5, y: y + 4 }, caption);
        }
    }
    return clicked;
}

extend Ui {
    /// Rounded panel filled with a vertical gradient and a drop shadow. Pair with `end`.
    fn card(this: &Ui, w: f32, h: f32, top: Color, bottom: Color, radius: f32) {
        let x = this.x;
        let y = this.y;
        if this.shown(y, h) {
            fillShadow(x, y, w, h, radius);
            fillWash(x, y, w, h, top, bottom, radius);
        }
        this.open(0, w, h);
        this.x = x + PAD;
        this.y = y + PAD;
        let inner = w - PAD * 2;
        if inner < 0 {
            inner = 0;
        }
        this.w = inner;
        this.across = false;
    }

    /// Rounded vertical gradient. Advances by its size. Does not open a frame.
    fn wash(this: &Ui, w: f32, h: f32, top: Color, bottom: Color, radius: f32) {
        if this.shown(this.y, h) {
            fillWash(this.x, this.y, w, h, top, bottom, radius);
        }
        if this.across {
            this.place(w + 8, h);
        } else {
            this.place(w, h + 8);
        }
    }

    /// Rounded `panel` fill with a drop shadow.
    fn drop(this: &Ui, w: f32, h: f32, radius: f32) {
        if this.shown(this.y, h) {
            fillShadow(this.x, this.y, w, h, radius);
            fillRound(this.x, this.y, w, h, radius, this.theme.panel);
        }
        if this.across {
            this.place(w + 8, h);
        } else {
            this.place(w, h + 8);
        }
    }

    /// Pill switch. `msg` is drawn beside it. Returns true when `on` flips.
    fn toggle(this: &Ui, msg: string, on: &bool): bool {
        let pillW = f32(48);
        let pillH = f32(26);
        let y = this.y + (this.h - pillH) * 0.5;
        let words = this.words(msg);
        let wide = pillW + 8 + words;
        let hit = false;
        if this.shown(this.y, this.h) {
            hit = inside(Vec2 { x: this.x, y: this.y }, Vec2 { x: wide, y: this.h });
        }
        let id = this.widget(msg);
        if hit {
            uiInput.hot = id;
        }
        let changed = false;
        if hit && mousePressed(Mouse.Left) {
            uiInput.active = id;
            let next = true;
            if *on {
                next = false;
            }
            *on = next;
            changed = true;
        }
        if this.shown(this.y, this.h) {
            let track = this.theme.button;
            if *on {
                track = this.theme.accent;
            }
            if hit {
                track = mixColor(track, this.theme.text, 0.18);
            }
            fillRound(this.x, y, pillW, pillH, pillH * 0.5, track);
            let knob = f32(20);
            let kx = this.x + 3;
            if *on {
                kx = this.x + pillW - 3 - knob;
            }
            let ky = y + (pillH - knob) * 0.5;
            fillRound(kx, ky + 1, knob, knob, knob * 0.5, rgba(0, 0, 0, 70));
            fillRound(kx, ky, knob, knob, knob * 0.5, this.theme.text);
            if this.font.raw != 0 {
                setColor(this.theme.text);
                drawText(this.font, Vec2 { x: this.x + pillW + 8, y: this.y + 4 }, msg);
            }
        }
        if this.across {
            this.place(wide + 6, this.h);
        } else {
            this.place(wide, this.h + 6);
        }
        return changed;
    }

    /// Box and caption. Click flips `on`. Returns true when it flips.
    fn check(this: &Ui, msg: string, on: &bool): bool {
        let box = f32(18);
        let y = this.y + (this.h - box) * 0.5;
        let wide = box + 8 + this.words(msg);
        let hit = false;
        if this.shown(this.y, this.h) {
            hit = inside(Vec2 { x: this.x, y: this.y }, Vec2 { x: wide, y: this.h });
        }
        let id = this.widget(msg);
        if hit {
            uiInput.hot = id;
        }
        let changed = false;
        if hit && mousePressed(Mouse.Left) {
            uiInput.active = id;
            let next = true;
            if *on {
                next = false;
            }
            *on = next;
            changed = true;
        }
        if this.shown(this.y, this.h) {
            let face = this.theme.button;
            if hit {
                face = this.theme.buttonHot;
            }
            fillRound(this.x, y, box, box, 4, face);
            if *on {
                fillRound(this.x + 4, y + 4, box - 8, box - 8, 2, this.theme.accent);
            }
            if this.font.raw != 0 {
                setColor(this.theme.text);
                drawText(this.font, Vec2 { x: this.x + box + 8, y: this.y + 4 }, msg);
            }
        }
        if this.across {
            this.place(wide + 6, this.h);
        } else {
            this.place(wide, this.h + 6);
        }
        return changed;
    }

    /// Small accent pill. The caption is the whole widget.
    fn chip(this: &Ui, msg: string) {
        let wide = this.words(msg) + 16;
        let tall = f32(22);
        let y = this.y + (this.h - tall) * 0.5;
        if this.shown(y, tall) {
            fillRound(this.x, y, wide, tall, tall * 0.5, this.theme.accent);
            if this.font.raw != 0 {
                setColor(this.theme.text);
                drawText(this.font, Vec2 { x: this.x + 8, y: y + 2 }, msg);
            }
        }
        if this.across {
            this.place(wide + 6, this.h);
        } else {
            this.place(wide, this.h + 6);
        }
    }

    /// One-pixel rule across the column.
    fn rule(this: &Ui) {
        let y = this.y + 6;
        if this.shown(y, 1) {
            setColor(this.theme.edge);
            let wide = this.w;
            if this.across {
                wide = 80;
            }
            drawRect(Vec2 { x: this.x, y: y }, Vec2 { x: wide, y: 1 });
        }
        if this.across {
            this.place(88, this.h);
        } else {
            this.place(this.w, 14);
        }
    }
}
