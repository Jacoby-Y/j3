/// CSS lint for `j3c check`: runs over a `Css` that `parse` filled (with `css.lintOn` set before, so `css.dlog` has every
/// declaration as written) and reports problems that need no running UI. Each warning's message ends in `[rule]`:
///   never-matches            a scoped rule whose last compound matches no element of its component's markup
///   ellipsis-without-overflow  `text-overflow` and no `overflow` on the element (no rule that covers it sets one)
///   offset-without-position  `top` `left` `right` `bottom` `inset` and no `position` set
///   duplicate-decl           one property written twice in a rule (the second wins)
///   undefined-var            `var(--x)` with no fallback and no `--x` declared or registered anywhere
///   broad-has                `:has()` on a carrier with no class or id (every such element is a carrier)
///   has-before-combinator    `:has()` outside the last compound (`.a:has(.b) .c`: a change restyles the whole subtree)
/// The compiler (`j3c/src/csslint.rs`) fills `ElFact` from the markup: the tag and the class and `#id` words each element
/// can have; a word with `*` is a pattern (`r{rarity}` is `r*`), and `*` alone means "any class".

module j3.ui.csslint;

use j3.memory.{ Arena, List };
use j3.text.{ contains, same, Text };
use j3.ui.css.{ Css, DeclLog, hasBit, PS_ROOT, Rule, Step, Warning };

/// One element a component's markup can create (or a use of a child component that passes a class: `tag` -1).
pub struct ElFact {
    scope: int;
    tag: int;
    words: List<string>;
}

fn startsWith(s: string, p: string): bool {
    return s.len >= p.len && same(s[0..p.len], p);
}

fn trim(s: string): string {
    let a = 0;
    let b = s.len;
    while a < b && int(s[a]) <= 32 {
        a += 1;
    }
    while b > a && int(s[b - 1]) <= 32 {
        b -= 1;
    }
    return s[a..b];
}

fn glob(p: string, pi: int, s: string, si: int): bool {
    while pi < p.len {
        if int(p[pi]) == 42 {
            for k in si..s.len + 1 {
                if glob(p, pi + 1, s, k) {
                    return true;
                }
            }
            return false;
        }
        if si >= s.len || p[pi] != s[si] {
            return false;
        }
        pi += 1;
        si += 1;
    }
    return si == s.len;
}

/// Can element `e` carry the class (or `#id`) word `w`?
fn elHas(e: &ElFact, w: string): bool {
    for i in 0..e.words.len {
        let x = e.words.items[i];
        if same(x, w) || (contains(x, "*") && glob(x, 0, w, 0)) {
            return true;
        }
    }
    return false;
}

fn say(css: &Css, out: &List<Warning>, file: string, line: int, col: int, msg: string, rule: string) {
    let t = Text.new(css.mem);
    t.pushStr(msg);
    t.pushStr(" [");
    t.pushStr(rule);
    t.pushStr("]");
    out.push(Warning { file: file, line: line, col: col, msg: t.str() });
}

/// The rightmost compound as written (`div.a.b#c`), for messages.
fn compound(css: &Css, st: Step): string {
    let t = Text.new(css.mem);
    if st.tag >= 0 {
        t.pushStr(css.name(st.tag));
    }
    for i in 0..st.ncls {
        t.pushStr(".");
        t.pushStr(css.name(st.cls[i]));
    }
    if st.id >= 0 {
        t.pushStr("#");
        t.pushStr(css.name(st.id));
    }
    if t.len() == 0 {
        t.pushStr("*");
    }
    return t.str();
}

fn canMatch(css: &Css, e: &ElFact, st: Step): bool {
    if st.tag >= 0 && e.tag >= 0 && st.tag != e.tag {
        return false;
    }
    // a component use (tag unknown) gets a parent's rule only through a class it names (`cssmatch.collect`)
    if e.tag < 0 && st.ncls == 0 {
        return false;
    }
    for i in 0..st.ncls {
        if !elHas(e, css.name(st.cls[i])) {
            return false;
        }
    }
    if st.id >= 0 {
        let w = css.name(st.id);
        let t = Text.new(css.mem);
        t.pushStr("#");
        t.pushStr(w);
        if !elHas(e, t.str()) {
            return false;
        }
    }
    return true;
}

/// Names the runtime makes itself (popup lists, tooltips, color panels): never judged.
fn runtimeName(n: string): bool {
    return startsWith(n, "j3-") || same(n, "selected");
}

fn neverMatches(css: &Css, els: &List<ElFact>, r: Rule, out: &List<Warning>) {
    let st = css.steps.items[r.step0 + r.nsteps - 1];
    if hasBit(st.pseudo, PS_ROOT) {
        return;
    }
    if st.tag >= 0 && runtimeName(css.name(st.tag)) {
        return;
    }
    for i in 0..st.ncls {
        if runtimeName(css.name(st.cls[i])) {
            return;
        }
    }
    let known = false;
    for i in 0..els.len {
        let e1 = &els.items[i];
        if e1.scope != r.scope {
            continue;
        }
        known = true;
        if canMatch(css, e1, st) {
            return;
        }
    }
    if !known {
        return;
    }
    // the first part of the compound no element of the component has, else "not all on one element"
    let what = "";
    let anyTag = st.tag < 0;
    for i in 0..els.len {
        let e2 = &els.items[i];
        if e2.scope == r.scope && (st.tag < 0 || e2.tag == st.tag) {
            anyTag = true;
        }
    }
    let t = Text.new(css.mem);
    t.pushStr("selector `");
    t.pushStr(compound(css, st));
    t.pushStr("` matches no element of this component");
    if !anyTag {
        t.pushStr(": it has no `<");
        t.pushStr(css.name(st.tag));
        t.pushStr(">`");
    } else {
        for i in 0..st.ncls {
            let w = css.name(st.cls[i]);
            let have = false;
            for j in 0..els.len {
                let e3 = &els.items[j];
                if e3.scope == r.scope && (st.tag < 0 || e3.tag < 0 || e3.tag == st.tag) && elHas(e3, w) {
                    have = true;
                }
            }
            if !have && what.len == 0 {
                what = w;
                t.pushStr(": nothing has the class `.");
                t.pushStr(w);
                t.pushStr("`");
            }
        }
    }
    say(css, out, r.file, r.line, r.col, t.str(), "never-matches");
}

fn lintRules(css: &Css, els: &List<ElFact>, out: &List<Warning>) {
    for ri in 0..css.rules.len {
        let r = css.rules.items[ri];
        if r.nsteps == 0 {
            continue;
        }
        let lastK = r.step0 + r.nsteps - 1;
        for k in r.step0..lastK + 1 {
            let st = css.steps.items[k];
            if st.nhas == 0 {
                continue;
            }
            if k != lastK {
                say(css, out, r.file, r.line, r.col, "`:has()` before a combinator: a change it tests restyles the carrier's whole subtree; put the `:has()` on the last compound", "has-before-combinator");
            } else if st.ncls == 0 && st.id < 0 {
                say(css, out, r.file, r.line, r.col, "`:has()` on a compound with no class or id: every such element is a carrier whose subtree is searched", "broad-has");
            }
        }
        if r.scope != 0 {
            neverMatches(css, els, r, out);
        }
    }
}

/// Does a declaration in `r` named `name` have a value for which `ok` ... : true when `r` declares `name` with a value other than `not`.
fn declares(css: &Css, r: Rule, name: string, not: string): bool {
    for i in 0..css.dlog.len {
        let d = css.dlog.items[i];
        if d.nd > 0 && d.d0 >= r.decl0 && d.d0 < r.decl0 + r.ndecl && same(d.name, name) && !same(trim(d.val), not) {
            return true;
        }
    }
    return false;
}

/// Is one of `names` set to something but `not` for an element that rule `b` styles? Judged by the markup: the elements
/// of `b`'s component that its last compound can match, and every rule (the component's or the theme's) that can match one
/// of them. Not judged (true) for theme rules, a class passed to a child's root (the child's sheet may set it) and a
/// rule that matches nothing (`never-matches` says so).
fn setByCover(css: &Css, els: &List<ElFact>, b: Rule, names: []string, not: string): bool {
    if b.scope == 0 {
        return true;
    }
    let sb = css.steps.items[b.step0 + b.nsteps - 1];
    let any = false;
    for i in 0..els.len {
        let el = &els.items[i];
        if el.scope != b.scope || !canMatch(css, el, sb) {
            continue;
        }
        any = true;
        if el.tag < 0 {
            return true;
        }
        for ri in 0..css.rules.len {
            let a = css.rules.items[ri];
            if a.nsteps == 0 || a.pe != b.pe || (a.scope != b.scope && a.scope != 0) {
                continue;
            }
            if !canMatch(css, el, css.steps.items[a.step0 + a.nsteps - 1]) {
                continue;
            }
            for n in 0..names.len {
                if declares(css, a, names[n], not) {
                    return true;
                }
            }
        }
    }
    return !any;
}

/// The rule (with at least one step) whose declarations include the one at `css.decls[d0]`, or -1.
fn ruleOf(css: &Css, d: DeclLog): int {
    for ri in 0..css.rules.len {
        let r = css.rules.items[ri];
        if r.nsteps > 0 && r.decl0 <= d.d0 && d.d0 < r.decl0 + r.ndecl && same(r.file, d.file) {
            return ri;
        }
    }
    return -1;
}

fn defined(css: &Css, name: string): bool {
    if startsWith(name, "--j3-") {
        return true;
    }
    for i in 0..css.dlog.len {
        if same(css.dlog.items[i].name, name) {
            return true;
        }
    }
    for i in 0..css.regs.len {
        if same(css.name(css.regs.items[i].name), name) {
            return true;
        }
    }
    return false;
}

fn nameChar(c: int): bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c >= 128;
}

fn lintVars(css: &Css, d: DeclLog, out: &List<Warning>) {
    let v = d.val;
    let i = 0;
    while i + 4 <= v.len {
        if !same(v[i..i + 4], "var(") {
            i += 1;
            continue;
        }
        i += 4;
        while i < v.len && int(v[i]) <= 32 {
            i += 1;
        }
        let a = i;
        while i < v.len && nameChar(int(v[i])) {
            i += 1;
        }
        let name = v[a..i];
        while i < v.len && int(v[i]) <= 32 {
            i += 1;
        }
        let fallback = i < v.len && int(v[i]) == 44;
        if name.len > 2 && !fallback && !defined(css, name) {
            let t = Text.new(css.mem);
            t.pushStr("`var(");
            t.pushStr(name);
            t.pushStr(")` has no fallback and `");
            t.pushStr(name);
            t.pushStr("` is not declared in any stylesheet");
            say(css, out, d.file, d.line, d.col, t.str(), "undefined-var");
        }
    }
}

fn lintDecls(css: &Css, els: &List<ElFact>, out: &List<Warning>) {
    let blk = List<int>.new(css.mem);
    for i in 0..css.dlog.len {
        let d = css.dlog.items[i];
        let bi = -1;
        if !d.kf && d.nd > 0 {
            bi = ruleOf(css, d);
        }
        blk.push(bi);
        lintVars(css, d, out);
        if bi < 0 {
            continue;
        }
        let r = css.rules.items[bi];
        for j in 0..i {
            if blk.items[j] >= 0 && css.rules.items[blk.items[j]].decl0 == r.decl0 && same(css.dlog.items[j].name, d.name) {
                let td = Text.new(css.mem);
                td.pushStr("`");
                td.pushStr(d.name);
                td.pushStr("` is declared twice in this rule; the earlier one (line ");
                td.pushInt(css.dlog.items[j].line);
                td.pushStr(") is overridden");
                say(css, out, d.file, d.line, d.col, td.str(), "duplicate-decl");
                break;
            }
        }
        if same(d.name, "text-overflow") && !same(trim(d.val), "clip") {
            let ov: [3]string = ["overflow", "overflow-x", "overflow-y"];
            if !setByCover(css, els, r, ov[0..3], "visible") {
                say(css, out, d.file, d.line, d.col, "`text-overflow` does nothing without `overflow` (hidden, clip, auto or scroll) on the same element", "ellipsis-without-overflow");
            }
        } else if same(d.name, "top") || same(d.name, "left") || same(d.name, "right") || same(d.name, "bottom") || same(d.name, "inset") {
            let po: [1]string = ["position"];
            if !setByCover(css, els, r, po[0..1], "static") {
                let to = Text.new(css.mem);
                to.pushStr("`");
                to.pushStr(d.name);
                to.pushStr("` does nothing on an element that is not positioned: add `position: relative`, `absolute`, `fixed` or `sticky`");
                say(css, out, d.file, d.line, d.col, to.str(), "offset-without-position");
            }
        }
    }
}

/// Lint everything `parse` put in `css`. `els` are the elements of each component scope (see `ElFact`); rules of a scope
/// without facts, and theme rules (scope 0), are not judged for `never-matches`. Warnings go to `out`.
pub fn lint(css: &Css, els: &List<ElFact>, out: &List<Warning>) {
    lintRules(css, els, out);
    lintDecls(css, els, out);
}
