/// A popup as a real DOM subtree on the overlay layer: select lists, tooltips and color panels; context
/// menus and caret popups can reuse it. The root is a child of its owner (so `color`, `font-*` and `accent-color` inherit
/// from it, and rules like `.dark .j3-select-list` match) that `j3.ui.dom` treats specially (`Node.rt`): the
/// build walk of the generated update never reuses or removes it, the generated paint walk skips it, it is always
/// `position: fixed` on its own layer (`OVERLAY_Z + 8`, above modals), hover and press do not reach its owner
/// (`setChain` stops at it), and a press on it finds it by the normal hit test. One input popup is open at a time
/// (`Dom.ptRoot`), with a separate passive tooltip slot (`Dom.ttRoot`); both die with their owner (`freeSubtree`).
///
/// Use, from the frame's input step (`j3.ui.inputs.begin`, before the build walk):
///
///     let root = popnode.open(d, owner, "j3-list", "j3-select-list");
///     popnode.build(d, root);              // d.open / d.cls / d.text ... now fill `root`
///     ... rows ...
///     popnode.done(d);
///
/// and from the overlay step after the page is painted: `popnode.place(...)` (a rectangle to hang below, else
/// above, clamped to the window; squeezes the height when neither side has room) then `popnode.paint(d, root)`.
/// `popnode.close(d)` removes it. A steady frame does no layout: building only touches what changed.
///
/// Slots: rows are opened with `d.enter(c)` + `d.open(slot, ...)` like generated code, so `c * 4096 + slot` rows fit.

module j3.ui.popnode;

use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.popup;
use j3.ui.uastyle;

/// The root of the popup for `owner` (made when there is none), carrying class `cls`; `tag` should be a name the
/// page's CSS does not style (`j3-list`). Loads the built-in sheet when nobody did.
pub fn open(d: &Dom, owner: int, tag: string, cls: string): int {
    uastyle.load(d.css);
    let root = d.popRoot(owner, d.tag(tag));
    d.cls(root, cls);
    return root;
}

/// Start filling `root` (see the module comment); pair with `done`.
pub fn build(d: &Dom, root: int) {
    d.buildIn(root);
}

pub fn done(d: &Dom) {
    d.buildOut();
}

/// Remove the popup subtree.
pub fn close(d: &Dom) {
    d.dropRoot();
}

/// Whether node `id` is inside the open popup `root`.
pub fn contains(d: &Dom, root: int, id: int): bool {
    return root >= 0 && id >= 0 && dom.inside(d, root, id);
}

/// Put `root` below the anchor rectangle `ax, ay, aw, ah` (root px), above it when there is more room there, kept
/// inside the window; with room for less than its natural height it is squeezed (down to `minH`) and scrolls by its
/// own `overflow`. Call every frame after layout; costs nothing when nothing moved.
pub fn place(d: &Dom, root: int, ax: f32, ay: f32, aw: f32, ah: f32, minH: f32) {
    let n = &d.nodes.items[root];
    if n.oh < 0.0 {
        d.ptNat = n.h;
    }
    let r = popup.place(ax, ay, aw, ah, n.w, d.ptNat, minH, d.vw, d.vh);
    if r.h < d.ptNat - 0.5 {
        d.panelSize(root, -1.0, r.h);
    } else {
        d.panelSize(root, -1.0, -1.0);
    }
    n.x = r.x;
    n.y = r.y;
}

/// Draw the popup above everything (after the generated paint walk).
pub fn paint(d: &Dom, root: int) {
    d.paintDetached(root);
}
