/// Animated text for `.j3ui` markup: pure functions of a time in seconds, so a component calls them
/// with its own clock and the text node changes only when the visible text does. No GL, no state.
///
/// ```
/// <p>{typewriter("Hello, world", t, 20.0)}</p>
/// ```

module j3.ui.textanim;

use j3.math.floor;
use j3.ui.textfit.codePoints;

/// The first `secs * cps` code points of `s` (a view of `s`, UTF-8 safe), like a typewriter at
/// `cps` characters per second.
pub fn typewriter(s: string, secs: f32, cps: f32): string {
    if secs <= 0.0 {
        return s[0..0];
    }
    return codePoints(s, int(secs * cps));
}

/// The first `secs * wps` words of `s` (a view): a word reveal.
pub fn words(s: string, secs: f32, wps: f32): string {
    let want = int(secs * wps);
    let i = 0;
    let seen = 0;
    while i < s.len {
        while i < s.len && int(s[i]) == 32 {
            i += 1;
        }
        if i >= s.len {
            break;
        }
        if seen >= want {
            let e = i;
            while e > 0 && int(s[e - 1]) == 32 {
                e -= 1;
            }
            return s[0..e];
        }
        while i < s.len && int(s[i]) != 32 {
            i += 1;
        }
        seen += 1;
    }
    return s;
}

/// `secs` folded into a loop of `dur` seconds of animation then `hold` seconds of rest: the clock
/// that makes a typewriter repeat.
pub fn cycle(secs: f32, dur: f32, hold: f32): f32 {
    let period = dur + hold;
    if period <= 0.0 {
        return 0.0;
    }
    return secs - floor(secs / period) * period;
}

/// A caret that is on for half of each period of `1 / hz` seconds.
pub fn blink(secs: f32, hz: f32): bool {
    return secs * hz - floor(secs * hz) < 0.5;
}
