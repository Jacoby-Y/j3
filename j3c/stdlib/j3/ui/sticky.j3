/// `position: sticky; top: Npx`. The box stays in flow; while its scroll box scrolls it is pushed down
/// (`Node.sy`, applied by `j3.ui.dom` when painting, hit testing and in `absY`) so its top edge stays
/// `top` px under the scroll box's top edge, and never past the bottom of its parent. The nearest
/// ancestor that clips (`overflow` not `visible`) is the scroll box; with none, the box does not move.
/// `inputs.begin` runs `step` once per frame, after the frame's scrolling and before the build walk,
/// so it uses the previous layout. Only `top` is read (no `bottom`, `left`, `right`).

module j3.ui.sticky;

use j3.math.max;
use j3.math.min;
use j3.ui.css.{ P_TOP, V_PX };
use j3.ui.dom;
use j3.ui.dom.{ Dom, edgesOf, isScroll };

/// How far a box at `nat` (its top edge in scroll content px) is pushed for a scroll offset of
/// `scroll` and a `top` inset, at most `limit` (the room left in its parent below it, never negative).
pub fn offset(scroll: f32, nat: f32, top: f32, limit: f32): f32 {
    return max(0.0, min(scroll + top - nat, max(0.0, limit)));
}

fn pushOf(d: &Dom, id: int): f32 {
    let n = &d.nodes.items[id];
    let tv = d.css.get(n.style, P_TOP);
    if tv.kind != V_PX {
        return 0.0;
    }
    // natural top edge inside the scroll box's content, and the scroll box
    let nat: f32 = 0.0;
    let c = id;
    while c >= 0 && !(c != id && isScroll(d, d.nodes.items[c].style)) {
        nat += d.nodes.items[c].y;
        c = d.nodes.items[c].parent;
    }
    if c < 0 {
        return 0.0;
    }
    let par = n.parent;
    let pe = edgesOf(d, d.nodes.items[par].style, d.nodes.items[par].basisW);
    // the parent's content bottom, in the parent's own coordinates
    let bottom = if par == c { d.nodes.items[par].contentH - pe.pb } else { d.nodes.items[par].h - pe.pb - pe.bb };
    return offset(d.nodes.items[c].scrollY, nat, tv.f, bottom - (n.y + n.h));
}

/// Recompute the push of every sticky box; boxes that went away or stopped being sticky leave the list.
pub fn step(d: &Dom) {
    let i = 0;
    while i < d.stk.len {
        let id = d.stk.items[i].v;
        let n = &d.nodes.items[id];
        if n.kind != dom.K_ELEM || !n.isStk {
            d.stk.items[i] = d.stk.items[d.stk.len - 1];
            d.stk.len -= 1;
            continue;
        }
        n.sy = pushOf(d, id);
        i += 1;
    }
}
