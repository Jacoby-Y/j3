/// Selector matching and the cascade for `j3.ui.css`: `computeStyle(&css, nodes, id, parentStyle)`.

module j3.ui.cssmatch;

use j3.ui.css.{ CacheEnt, COMB_CHILD, COMB_DESC, COMB_NEXT, COMB_SIB, Css, Custom, hasBit, MatchNode, FL_NONBLANK, FL_OPEN, NK_LAST_CHILD, NK_LAST_TYPE, NK_TYPE, SS_EMPTY, SS_FIRST_TYPE, SS_LAST_TYPE, SS_ONLY_CHILD, SS_ONLY_TYPE, MAXM, NPROPS, P_LINE_HEIGHT, PS_ROOT, Step };
use j3.memory.Arena;
use j3.text.{ contains, same, Text };
use j3.ui.csscalc.fontCalc;
use j3.ui.cssparse.inlineDecl;
use j3.ui.css.{ P_FONT_SIZE, resolveUnits, Rule, SLOTS, V_AUTO, V_CALC, V_EM, V_REM, V_COLOR, V_INHERIT, V_INITIAL, V_REVERT, V_UNSETKW, V_NUM, V_PCT, V_PX };
use j3.ui.css.{ coerceSyn, KvStop, P_ALL, P_DEFER, V_ANG, V_CURRENT, V_UNSET, V_URL, V_VAR, Value, Warning };
use j3.ui.cssvalue.{ C_ANGLE, C_COLOR, C_LEN, C_NUM, catOf, inherits, initial };

fn matchStep(css: &Css, si: int, nodes: []MatchNode, id: int): bool {
    return stepHolds(css, &css.steps.items[si], nodes, id);
}

/// Does the compound `st` (a rule step or a `:not()` argument) select `nodes[id]`?
fn stepHolds(css: &Css, st: &Step, nodes: []MatchNode, id: int): bool {
    let nd = &nodes[id];
    if st.tag >= 0 && nd.tag != st.tag && !(st.tag == css.tTextarea && nd.type == st.tag) {
        return false;
    }
    if st.attr >= 0 && nd.type != st.attr {
        return false;
    }
    if st.id >= 0 && nd.id != st.id {
        return false;
    }
    for c in 0..st.ncls {
        let want = st.cls[c];
        let found = false;
        for j in 0..nd.classes.len {
            if nd.classes[j] == want {
                found = true;
            }
        }
        if !found {
            return false;
        }
    }
    if st.pseudo != 0 {
        let bit = 1;
        while bit <= FL_OPEN {
            if hasBit(st.pseudo, bit) {
                if bit == PS_ROOT {
                    if nd.parent >= 0 {
                        return false;
                    }
                } else if !hasBit(nd.flags, bit) {
                    return false;
                }
            }
            bit = bit * 2;
        }
    }
    if st.nth && !nthHolds(nodes, id, st.nthA, st.nthB, st.nthK) {
        return false;
    }
    if st.ss != 0 && !structHolds(nodes, id, st.ss) {
        return false;
    }
    for k in st.not0..st.not0 + st.nnot {
        if stepHolds(css, &css.nots.items[k], nodes, id) {
            return false;
        }
    }
    if st.nhas > 0 && !hasHolds(css, st, nodes, id) {
        return false;
    }
    return true;
}

/// Could a `:has()` rule select `nodes[id]` (the rest of its compound holds, the arguments ignored)? Gates which ancestors restyle.
pub fn hasSubject(css: &Css, nodes: []MatchNode, id: int): bool {
    for k in 0..css.hasSubj.len {
        if stepHolds(css, &css.hasSubj.items[k], nodes, id) {
            return true;
        }
    }
    return false;
}

/// Does one of the `:has()` arguments of `st` hold for element `id`? Searches the children, the subtree (early exit), or the later
/// siblings of `id`, one `stepHolds` per node visited. Text, `::before` / `::after` boxes and leaving elements are not visited.
/// Descendant and child arguments are memoized per element and argument for the length of a style pass (`beginPass`), so a subtree is
/// searched once per argument however many rules and descendants ask: a pass costs O(nodes) per argument, not O(nodes x subtree).
/// ponytail: `+` / `~` arguments are not memoized (they cost the later siblings); add a memo if long sibling lists with `~` get slow.
fn hasHolds(css: &Css, st: &Step, nodes: []MatchNode, id: int): bool {
    for k in st.has0..st.has0 + st.nhas {
        let a = &css.hass.items[k];
        if a.comb == COMB_NEXT || a.comb == COMB_SIB {
            let q = nextEl(nodes, id);
            while q >= 0 {
                css.hasEvals += 1;
                if stepHolds(css, a, nodes, q) {
                    return true;
                }
                q = if a.comb == COMB_NEXT { -1 } else { nextEl(nodes, q) };
            }
        } else if hasKid(css, k, a, nodes, id) {
            return true;
        }
    }
    return false;
}

/// Argument `k` (`a`, a `>` or descendant one) of a `:has()` on `id`: a child matches, or for a descendant argument a child has one.
fn hasKid(css: &Css, k: int, a: &Step, nodes: []MatchNode, id: int): bool {
    let slot = -1;
    if css.hasOn && id < css.hcap {
        slot = k * css.hcap + id;
        if css.hmemo[slot] / 2 == css.hasGen {
            return css.hmemo[slot] % 2 == 1;
        }
    }
    let res = false;
    let c = nodes[id].first;
    while c >= 0 && !res {
        if nodes[c].pe == 0 {
            css.hasEvals += 1;
            res = stepHolds(css, a, nodes, c) || (a.comb == COMB_DESC && hasKid(css, k, a, nodes, c));
        }
        c = nodes[c].next;
    }
    if slot >= 0 {
        css.hmemo[slot] = css.hasGen * 2 + (if res { 1 } else { 0 });
    }
    return res;
}

/// Start a style pass over `n` nodes: `:has()` results are remembered until `endPass`. Does nothing without `:has()` rules.
pub fn beginPass(css: &Css, n: int) {
    if css.hasMode == 0 {
        return;
    }
    css.hasGen += 1;
    let cap = 16;
    while cap < n {
        cap = cap * 2;
    }
    if cap != css.hcap || css.hmemo.len < css.hass.len * cap {
        css.hmemo = css.mem.alloc::<int>(css.hass.len * cap);
        for i in 0..css.hmemo.len {
            css.hmemo[i] = 0;
        }
        css.hcap = cap;
    }
    css.hasOn = true;
}

pub fn endPass(css: &Css) {
    css.hasOn = false;
}

/// `:nth-child(An+B)` and its `last` / `of-type` forms (`kind`, `NK_*`): is the 1-based position of element `id` among its parent's
/// elements (from the end for the `last` ones, only those of its tag for the `type` ones) `A*n + B` for some n >= 0?
/// ponytail: counts the siblings on every match, O(siblings); cache the index on the node if a long list gets slow.
fn nthHolds(nodes: []MatchNode, id: int, a: int, b: int, kind: int): bool {
    let pos = 1 + countSibs(nodes, id, kind == NK_LAST_CHILD || kind == NK_LAST_TYPE, kind >= NK_TYPE, -1);
    if a == 0 {
        return pos == b;
    }
    let d = pos - b;
    return d % a == 0 && d / a >= 0;
}

/// How many element siblings come before `id` (after it when `after`), only those of its tag when `typed`; stops at `cap` when >= 0.
fn countSibs(nodes: []MatchNode, id: int, after: bool, typed: bool, cap: int): int {
    let n = 0;
    let q = if after { nextEl(nodes, id) } else { prevEl(nodes, id) };
    while q >= 0 && (cap < 0 || n < cap) {
        if !typed || nodes[q].tag == nodes[id].tag {
            n += 1;
        }
        q = if after { nextEl(nodes, q) } else { prevEl(nodes, q) };
    }
    return n;
}

/// The argument-less structural pseudo-classes (`SS_*` bits, all of them must hold).
fn structHolds(nodes: []MatchNode, id: int, ss: int): bool {
    if hasBit(ss, SS_EMPTY) {
        // Selectors 4: no element child and no text but whitespace (`::before` / `::after` boxes do not count)
        let c = nodes[id].first;
        while c >= 0 {
            if nodes[c].pe == 0 || (nodes[c].pe == -1 && hasBit(nodes[c].flags, FL_NONBLANK)) {
                return false;
            }
            c = nodes[c].next;
        }
    }
    if hasBit(ss, SS_ONLY_CHILD) && (prevEl(nodes, id) >= 0 || nextEl(nodes, id) >= 0) {
        return false;
    }
    if (hasBit(ss, SS_FIRST_TYPE) || hasBit(ss, SS_ONLY_TYPE)) && countSibs(nodes, id, false, true, 1) > 0 {
        return false;
    }
    if (hasBit(ss, SS_LAST_TYPE) || hasBit(ss, SS_ONLY_TYPE)) && countSibs(nodes, id, true, true, 1) > 0 {
        return false;
    }
    return true;
}

/// The closest later sibling that is an element, -1 for none.
fn nextEl(nodes: []MatchNode, id: int): int {
    let p = nodes[id].next;
    while p >= 0 && nodes[p].pe != 0 {
        p = nodes[p].next;
    }
    return p;
}

/// The closest earlier sibling that is an element (text nodes and pseudo-element boxes do not count), -1 for none.
pub fn prevEl(nodes: []MatchNode, id: int): int {
    let p = nodes[id].prevSibling;
    while p >= 0 && nodes[p].pe != 0 {
        p = nodes[p].prevSibling;
    }
    return p;
}

/// Does `nodes[id]` match step `s` of the rule that starts at `step0`, with the steps left of it
/// related by their combinators? Backtracks over the ancestors (` `) and earlier siblings (`~`).
fn matchAt(css: &Css, s: int, step0: int, nodes: []MatchNode, id: int): bool {
    if !matchStep(css, s, nodes, id) {
        return false;
    }
    if s == step0 {
        return true;
    }
    let cb = css.steps.items[s - 1].comb;
    if cb == COMB_CHILD {
        let p = nodes[id].parent;
        return p >= 0 && matchAt(css, s - 1, step0, nodes, p);
    }
    if cb == COMB_NEXT {
        let q = prevEl(nodes, id);
        return q >= 0 && matchAt(css, s - 1, step0, nodes, q);
    }
    if cb == COMB_SIB {
        let e = prevEl(nodes, id);
        while e >= 0 {
            if matchAt(css, s - 1, step0, nodes, e) {
                return true;
            }
            e = prevEl(nodes, e);
        }
        return false;
    }
    let a = nodes[id].parent;
    while a >= 0 {
        if matchAt(css, s - 1, step0, nodes, a) {
            return true;
        }
        a = nodes[a].parent;
    }
    return false;
}

fn matchRule(css: &Css, r: &Rule, nodes: []MatchNode, id: int): bool {
    let last = r.step0 + r.nsteps - 1;
    if r.sib {
        return matchAt(css, last, r.step0, nodes, id);
    }
    // only descendant and child steps: the nearest matching ancestor is always enough (no backtracking)
    if !matchStep(css, last, nodes, id) {
        return false;
    }
    let cur = id;
    let s = last - 1;
    while s >= r.step0 {
        cur = nodes[cur].parent;
        if css.steps.items[s].comb == COMB_CHILD {
            if cur < 0 || !matchStep(css, s, nodes, cur) {
                return false;
            }
        } else {
            while cur >= 0 && !matchStep(css, s, nodes, cur) {
                cur = nodes[cur].parent;
            }
            if cur < 0 {
                return false;
            }
        }
        s -= 1;
    }
    return true;
}

/// Does the `::before` / `::after` rule `r` select element `host` (media and component scope included)?
pub fn peHolds(css: &Css, r: &Rule, nodes: []MatchNode, host: int): bool {
    let foreign = r.scope != 0 && r.scope != nodes[host].scope;
    if foreign && (r.scope != nodes[host].scope2 || r.cls0 < 0) {
        return false;
    }
    if r.mq >= 0 && !css.mediaHolds(r.mq) {
        return false;
    }
    return matchRule(css, r, nodes, host);
}

