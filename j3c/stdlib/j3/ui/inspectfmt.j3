/// Value text for `j3.ui.inspect`: a computed or declared `Value` as CSS (colors `#rrggbbaa`, lengths with units, keywords by `kwList`, times, gradient
/// and shadow summaries, transform lists, transitions, grid tracks, image lists). Only an unknown kind prints as `<kind N>`.

module j3.ui.inspectfmt;

use j3.text.Text;
use j3.ui.cssmatch;
use j3.ui.cssvalue.kwList;
use j3.ui.dom.Dom;
use j3.ui.css.{ Css, Decl, Value, MatchNode, NPROPS, P_DEFER, P_ALL, PROP_NAMES, transCount, transDelay, transEase };
use j3.ui.css.{ P_ANIM_DELAY, P_ANIM_DUR, P_BG_POS, P_BG_REPEAT, P_BG_SIZE, P_BORDER_SLICE, P_GRID_COL0, P_OBJECT_POS, P_ORIGIN, P_WAVE_PERIOD };
use j3.ui.css.{ V_ANIM, V_AUTO, V_CALC, V_EASE, V_FR, V_GRAD, V_INHERIT, V_KW, V_LIST, V_NONE, V_NUM, V_PCT, V_REM, V_EM, V_SHADOW, V_STR, V_TRANS, V_URL, V_VAR, V_XFORM };

/// Word `i` of the space-separated `list`, "" past the end.
pub fn nth(list: string, i: int): string {
    let a = 0;
    let k = 0;
    for j in 0..list.len + 1 {
        if j == list.len || list[j] == 32 {
            if k == i { return list[a..j]; }
            k += 1;
            a = j + 1;
        }
    }
    return "";
}

pub fn valSame(a: Value, b: Value): bool {
    return a.kind == b.kind && a.f == b.f && a.i == b.i && a.c == b.c;
}

fn hex2(t: &Text, b: int) {
    let hex = "0123456789abcdef";
    let c = if b < 0 { 0 } else if b > 255 { 255 } else { b };
    t.push(hex[c / 16]);
    t.push(hex[c % 16]);
}

/// `r g b a` as `#rrggbbaa`.
fn rgba(t: &Text, r: f32, g: f32, b: f32, a: f32) {
    t.push(35);
    hex2(t, int(r + 0.5));
    hex2(t, int(g + 0.5));
    hex2(t, int(b + 0.5));
    hex2(t, int(a + 0.5));
}

/// A track bound or `background-size` component: `kind` is `V_PX` / `V_PCT` / `V_AUTO` / `V_FR` / `V_EM` / `V_REM`.
fn unitLen(t: &Text, kind: int, f: f32) {
    if kind == V_AUTO { t.pushStr("auto"); return; }
    t.pushFloat(f);
    t.pushStr(if kind == V_PCT { "%" } else if kind == V_FR { "fr" } else if kind == V_EM { "em" } else if kind == V_REM { "rem" } else { "px" });
}

/// 0 px, 1 %, 2 auto (the `unit` numbers of `background-size`, `background-position`, `object-position`).
fn unit3(t: &Text, f: f32, u: f32) {
    if int(u) == 2 { t.pushStr("auto"); return; }
    t.pushFloat(f);
    t.pushStr(if int(u) == 1 { "%" } else { "px" });
}

fn gradient(d: &Dom, t: &Text, at: int) {
    let p = d.css.paints.items;
    let nl = int(p[at]);
    let o = at + 1;
    for l in 0..nl {
        if l > 0 { t.pushStr(", "); }
        let kind = int(p[o]);
        t.pushStr(if kind == 1 { "radial-gradient(" } else if kind == 2 { "conic-gradient(" } else { "linear-gradient(" });
        t.pushFloat(p[o + 1]);
        t.pushStr("deg");
        let ns = int(p[o + 2]);
        for k in 0..ns {
            let q = o + 3 + k * 5;
            t.pushStr(", ");
            rgba(t, p[q + 1], p[q + 2], p[q + 3], p[q + 4]);
            t.push(32);
            t.pushFloat(p[q] * 100.0);
            t.push(37);
        }
        t.push(41);
        o += 3 + ns * 5;
    }
}

fn shadows(d: &Dom, t: &Text, at: int) {
    let p = d.css.paints.items;
    let n = int(p[at]);
    for k in 0..n {
        let q = at + 1 + k * 9;
        if k > 0 { t.pushStr(", "); }
        if p[q] != 0.0 { t.pushStr("inset "); }
        for j in 1..5 {
            t.pushFloat(p[q + j]);
            t.pushStr("px ");
        }
        rgba(t, p[q + 5], p[q + 6], p[q + 7], p[q + 8]);
    }
}

fn tracks(d: &Dom, t: &Text, at: int) {
    let p = d.css.paints.items;
    let fillK = int(p[at]);
    let n = int(p[at + 1]);
    if fillK > 0 { t.pushStr(if fillK == 1 { "repeat(auto-fill, " } else { "repeat(auto-fit, " }); }
    for k in 0..n {
        let q = at + 2 + k * 4;
        if k > 0 { t.push(32); }
        if int(p[q]) == int(p[q + 2]) && p[q + 1] == p[q + 3] {
            unitLen(t, int(p[q]), p[q + 1]);
        } else {
            t.pushStr("minmax(");
            unitLen(t, int(p[q]), p[q + 1]);
            t.pushStr(", ");
            unitLen(t, int(p[q + 2]), p[q + 3]);
            t.push(41);
        }
    }
    if fillK > 0 { t.push(41); }
}

/// A transform list (`xform.j3`: `[n, [kind, a, b, c, d, e, f, pct]...]`; kinds 0 translate, 1 rotate, 2 scale, 3 skew, 4 matrix).
fn xforms(d: &Dom, t: &Text, prop: int, at: int) {
    let p = d.css.paints.items;
    if prop == P_ORIGIN {
        t.pushFloat(p[at]);
        t.pushStr(if p[at + 1] > 0.5 { "% " } else { "px " });
        t.pushFloat(p[at + 2]);
        t.pushStr(if p[at + 3] > 0.5 { "%" } else { "px" });
        return;
    }
    let n = int(p[at]);
    for k in 0..n {
        let q = at + 1 + k * 8;
        if k > 0 { t.push(32); }
        let kind = int(p[q]);
        if kind == 0 {
            t.pushStr("translate(");
            t.pushFloat(p[q + 1]);
            t.pushStr(if int(p[q + 7]) % 2 == 1 { "%, " } else { "px, " });
            t.pushFloat(p[q + 2]);
            t.pushStr(if int(p[q + 7]) / 2 % 2 == 1 { "%)" } else { "px)" });
        } else if kind == 1 {
            t.pushStr("rotate(");
            t.pushFloat(p[q + 1] * 57.29578);
            t.pushStr("deg)");
        } else if kind == 2 {
            t.pushStr("scale(");
            t.pushFloat(p[q + 1]);
            t.pushStr(", ");
            t.pushFloat(p[q + 2]);
            t.push(41);
        } else if kind == 3 {
            t.pushStr("skew(");
            t.pushFloat(p[q + 1] * 57.29578);
            t.pushStr("deg, ");
            t.pushFloat(p[q + 2] * 57.29578);
            t.pushStr("deg)");
        } else {
            t.pushStr("matrix(");
            for m in 1..7 {
                if m > 1 { t.pushStr(", "); }
                t.pushFloat(p[q + m]);
            }
            t.push(41);
        }
    }
}

/// A `V_LIST` value, by the property that owns it; "(list)" for the few without a short spelling.
fn list(d: &Dom, t: &Text, prop: int, v: Value) {
    let p = d.css.paints.items;
    let at = v.i;
    let cnt = if v.c > 0 { v.c } else { 1 };
    if prop >= P_GRID_COL0 && prop < P_GRID_COL0 + 4 { tracks(d, t, at); }
    else if prop == P_BG_SIZE {
        for k in 0..cnt {
            let qa = at + k * 5;
            if k > 0 { t.pushStr(", "); }
            if int(p[qa]) == 1 { t.pushStr("cover"); }
            else if int(p[qa]) == 2 { t.pushStr("contain"); }
            else { unit3(t, p[qa + 1], p[qa + 2]); t.push(32); unit3(t, p[qa + 3], p[qa + 4]); }
        }
    } else if prop == P_BG_POS || prop == P_OBJECT_POS {
        for k in 0..cnt {
            let qb = at + k * 4;
            if k > 0 { t.pushStr(", "); }
            unit3(t, p[qb], p[qb + 1]);
            t.push(32);
            unit3(t, p[qb + 2], p[qb + 3]);
        }
    } else if prop == P_BG_REPEAT {
        for k in 0..cnt {
            let qc = at + k * 2;
            if k > 0 { t.pushStr(", "); }
            t.pushStr(nth("repeat no-repeat space round", int(p[qc])));
            t.push(32);
            t.pushStr(nth("repeat no-repeat space round", int(p[qc + 1])));
        }
    } else if prop == P_BORDER_SLICE {
        for k in 0..4 {
            if k > 0 { t.push(32); }
            t.pushFloat(p[at + k]);
            if (int(p[at + 5]) / (if k == 0 { 1 } else if k == 1 { 2 } else if k == 2 { 4 } else { 8 })) % 2 == 1 { t.push(37); }
        }
        if p[at + 4] != 0.0 { t.pushStr(" fill"); }
    } else {
        t.pushStr("(list)");
    }
}

/// Value `v` of property `prop` as CSS text. Every kind a stylesheet produces has a spelling; only an unknown kind prints as `<kind N>`.
pub fn fmt(d: &Dom, t: &Text, prop: int, v: Value) {
    if cssmatch.pushValue(t, v) {
        if v.kind == V_NUM && (prop == P_ANIM_DUR || prop == P_ANIM_DELAY || prop == P_WAVE_PERIOD) { t.pushStr("ms"); }
        return;
    }
    let k = v.kind;
    if k == V_KW {
        let w = nth(kwList(prop), v.i);
        if w.len > 0 { t.pushStr(w); } else { t.pushInt(v.i); }
    }
    else if k == V_NONE { t.pushStr("none"); }
    else if k == V_INHERIT { t.pushStr("inherit"); }
    else if k == V_FR { t.pushFloat(v.f); t.pushStr("fr"); }
    else if k == V_STR { t.pushStr(if v.i >= 0 { d.css.name(v.i) } else { "(default font)" }); }
    else if k == V_URL { t.pushStr("url("); t.pushStr(d.css.name(v.i)); t.push(41); }
    else if k == V_VAR { t.pushStr("var("); t.pushStr(d.css.name(v.i)); t.push(41); }
    else if k == V_ANIM { t.pushStr(d.css.name(v.i)); }
    else if k == V_GRAD { gradient(d, t, v.i); }
    else if k == V_SHADOW { shadows(d, t, v.i); }
    else if k == V_LIST { list(d, t, prop, v); }
    else if k == V_CALC { t.pushStr("calc()"); }
    else if k == V_XFORM { xforms(d, t, prop, v.i); }
    else if k == V_TRANS {
        let nprop = transCount(v);
        t.pushStr(if nprop == 1 { nth(PROP_NAMES, v.i) } else if nprop >= NPROPS { "all" } else { "(properties)" });
        t.push(32);
        t.pushFloat(v.f);
        t.pushStr("ms ");
        t.pushStr(easeName(d, transEase(v)));
        if transDelay(v) != 0 {
            t.push(32);
            t.pushInt(transDelay(v));
            t.pushStr("ms");
        }
    }
    else if k == V_EASE { t.pushStr(easeName(d, v.i)); }
    else {
        t.pushStr("<kind ");
        t.pushInt(k);
        t.push(62);
    }
}

fn easeName(d: &Dom, i: int): string {
    let w = nth("ease linear ease-in ease-out ease-in-out bounce spring", i);
    return if w.len > 0 { w } else { "custom" };
}
