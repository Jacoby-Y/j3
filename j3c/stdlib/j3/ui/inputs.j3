/// Keyboard and mouse behaviour of the input widgets, between the frame's input (`Dom.beginFrame`) and
/// the build walk (`update`): text boxes, sliders, focus and Tab, Enter on buttons. The generated root
/// calls `begin(d)` after `d.beginFrame` and `overlay(d)` after painting. Dropdown and color popups
/// are in `j3.ui.dropdown`. Results reach the markup through `Dom.changed`, `submitted`, `strValue`,
/// `value`, `highValue` (what `bind:` and `on:input` read).
///
/// A text box edits its own buffer (`Dom.eds`) while it has focus and `strValue` is a view of it, valid
/// until the next change; assign it to the bound variable the same frame (`bind:value` does).

module j3.ui.inputs;

use j3.game;
use j3.game.fontLine;
use j3.game.{ Cursor, Mouse };
use j3.game.letterbox.toWindow;
use j3.ui.area;
use j3.ui.dom;
use j3.ui.drag;
use j3.ui.dom.{ Dom, edgesOf, enterText, fontOf, isBold, isDisabled, isFocusable, isField, leaveText };
use j3.ui.dropdown;
use j3.ui.field;
use j3.ui.inspect;
use j3.ui.keys.KeyIn;
use j3.ui.overlays;
use j3.ui.padnav;
use j3.ui.panels;
use j3.ui.popup;
use j3.ui.slider;
use j3.ui.grid;
use j3.ui.spans;
use j3.ui.sticky;
use j3.ui.textedit;
use j3.ui.textsel;
use j3.ui.windrag;
use j3.ui.textedit.Edit;
use j3.text.{ same, Text };
use j3.ui.css.Warning;

#[singleton]
let FOCUS_HOOK: ptr;
#[singleton]
let BLUR_HOOK: ptr;
/// True between a focus hook call and the matching blur: the hook has been told a text box has the focus.
#[singleton]
let HOOKED: bool;

/// Call `f(x, y, w, h, kind)` when a text box (`<input>` that types text, or `<textarea>`) gains the keyboard focus. The rect is the box in
/// window pixels (top-left origin, scroll and the `setVirtualSize` letterbox included, CSS transforms not), read once at the focus change.
/// `kind`: 0 single line, 1 multi line (`textarea`), 2 `type="email"`, 3 `type="number"`. Moving the focus straight from one text box to
/// another calls `f` again for the new box and does not call the blur hook. Checkboxes, radios, ranges, buttons and selects never call
/// it. Main thread; one hook, setting again replaces it; the `Dom` is not passed, so hook state is global. `j3.ui` knows nothing of the
/// caller: `j3.steam.game.attach` uses it for Steam's on-screen keyboard.
pub fn setTextFocusHook(f: fn(int, int, int, int, int)) {
    FOCUS_HOOK = f as ptr;
}

/// Call `f()` when the focus leaves the text boxes: to a control that is not one, to nothing, or because the focused box left the tree.
/// Not called when it moves to another text box (`setTextFocusHook` runs instead).
pub fn setTextBlurHook(f: fn()) {
    BLUR_HOOK = f as ptr;
}

/// Run once per frame after `d.beginFrame(size)` and before the build walk.
pub fn begin(d: &Dom) {
    beginInput(d);
    toggleDetails(d);
    labelClick(d);
    radioClick(d);
    if d.insp { inspect.input(d); }
}

fn beginInput(d: &Dom) {
    padnav.step(d);
    let k = &d.kin;
    if k.typed.len > 0 || k.left || k.right || k.up || k.down || k.home || k.end || k.back || k.del || k.enter || k.esc || k.tab || k.space || k.pgup || k.pgdn {
        d.setKeyboard(true);
    }
    if d.focus >= 0 && !dom.styleVisible(d, d.focus) { d.focusNode(-1); }
    grid.step(d);
    drag.step(d);
    seeFocus(d);
    let popWas = d.pop.kind != popup.NONE;
    dropdown.input(d);
    overlays.input(d, popWas);
    panels.step(d);
    sticky.step(d);
    windrag.step(d);
    textsel.step(d);
    if d.downBtn == 1 && d.pop.kind == popup.NONE {
        middlePaste(d, d.downHit);
    }
    let f = d.focus;
    if f >= 0 && !isDisabled(d, f) && d.pop.kind == popup.NONE {
        let n = &d.nodes.items[f];
        if isField(d, f) && n.tag == d.tInput {
            overlays.caretKeys(d, f);
            textKeys(d, f);
            textMouse(d, f);
            primarySettle(d, f);
        } else if d.mnodes.items[f].type == d.vRange {
            rangeKeys(d, f);
        } else if n.tag == d.tButton || n.mitem || d.mnodes.items[f].type == d.vCheckbox || dom.isRadio(d, f) {
            if dom.isRadio(d, f) { radioKeys(d, f); }
            if (d.kin.enter || d.kin.space) && dom.allowedByModal(d, f) {
                d.clickNode = f;
            }
        }
    }
    trigger(d);
    let r = d.downHit;
    if r >= 0 && !isDisabled(d, r) && d.mnodes.items[r].type == d.vRange {
        rangePress(d, r);
    }
    if d.dragNode >= 0 && d.down && d.dragNode < d.nodes.len && d.nodes.items[d.dragNode].kind == dom.K_ELEM && d.mnodes.items[d.dragNode].type == d.vRange && !isDisabled(d, d.dragNode) && dom.styleVisible(d, d.dragNode) {
        rangeDrag(d, d.dragNode);
    }
    if d.kin.tab {
        tab(d, if d.kin.shift { -1 } else { 1 });
    }
    let h = d.hover;
    if h >= 0 && isField(d, h) && d.nodes.items[h].tag == d.tInput && !isDisabled(d, h) {
        game.setCursor(Cursor.Text);
    }
}

/// Draw the open popup, above everything. Call after the paint walk, before `endFrame`.
pub fn overlay(d: &Dom) {
    dropdown.paint(d);
    panels.paint(d);
    overlays.paintTip(d);
    drag.paint(d);
    if d.insp { inspect.paintAll(d); }
    if d.dumpSpec.len > 0 { inspect.dumpStep(d); }
}

