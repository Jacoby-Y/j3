/// The semantic (accessibility) tree of a laid-out `Dom`: a role, name, states and actions per element,
/// computed on demand from the nodes (nothing runs per frame). `dump` writes it as text (`domhtml.dumpA11y`,
/// goldens); a platform bridge reads `role`/`name`/`actions`/`bounds`/`text` and calls `perform`, drains `events` and `liveChanges`, and
/// wakes an idle loop with `Inbox.post`. An AT id is a node handle (`Dom.handle`): every function here takes a handle or a plain id, and
/// a handle whose node is gone gives the empty answer (`""`, 0, false). All of it is main-thread, between frames, except `post`.
///
/// Roles come from the tag (`button`, `input` by `type`, `select`, `option`, `dialog`, `nav`, `h1`...) or the
/// `role` attribute. Names: `aria-label` (an `<img>`'s `alt`), else the text content for buttons, menu items,
/// options and headings, or the wrapping `<label>`'s text (or a `<label for>` naming its `id`), `placeholder` or `title` for a control. Hidden
/// nodes (`display: none`, fading out) are left out. A password box's value is never read.

module j3.ui.a11y;

use j3.i18n;
use j3.math.Vec2;
use j3.memory.{ Arena, List };
use j3.text.{ same, Text };
use j3.thread.Mutex;
use j3.ui.dom;
use j3.ui.dom.{ AEv, Dom, isDisabled, isFocusable, K_ELEM, K_TEXT, STALE };
use j3.ui.popup;

pub const A_FOCUS: int = 1;
pub const A_CLICK: int = 2;
pub const A_SET: int = 4;

/// `events` kinds (the same numbers as `dom.EV_*`): focus moved (h = new focus, -1 for none), checked / expanded / selected / value of
/// h changed, children of h came or went, name of h changed.
pub const EV_FOCUS: int = 1;
pub const EV_CHECKED: int = 2;
pub const EV_EXPANDED: int = 3;
pub const EV_SELECTED: int = 4;
pub const EV_VALUE: int = 5;
pub const EV_CHILDREN: int = 6;
pub const EV_NAME: int = 7;

/// Start queueing `events` and `liveChanges`. Off (the default), the Dom pays one flag test per change and idle frames cost nothing either way.
pub fn enable(d: &Dom) {
    d.a11yOn = true;
}

fn tagOf(d: &Dom, id: int): string {
    return d.css.name(d.nodes.items[id].tag);
}

fn typeIs(d: &Dom, id: int, ty: int): bool {
    return d.mnodes.items[id].type == ty;
}

/// Whether `id` is an element a screen reader would reach (not removed, fading out, `display: none` or a runtime popup: the select list is
/// its select's `aria-expanded` and options).
pub fn shown(d: &Dom, id: int): bool {
    id = d.resolve(id);
    if id == STALE { return false; }
    return present(d, id) && dom.styleVisible(d, id);
}

/// The document language (`j3.i18n.locale()`, "" when none was set): the AT's `lang` for the whole tree.
pub fn language(): string {
    return i18n.locale();
}

/// `shown` without `visibility`: a `visibility: hidden` box takes no part of the tree itself, but a visible child of it does.
fn present(d: &Dom, id: int): bool {
    let n = &d.nodes.items[id];
    // an option's box is not laid out, but it is part of its select
    return n.kind == K_ELEM && !n.ghost && !n.rt && (n.disp != dom.DP_NONE || n.tag == d.tOption);
}

/// The role of `id`: the `role` attribute, else what the tag implies ("" for none).
pub fn role(d: &Dom, id: int): string {
    id = d.resolve(id);
    if id == STALE { return ""; }
    let r = d.roleOf(id);
    if r.len > 0 {
        return r;
    }
    let n = &d.nodes.items[id];
    let tag = tagOf(d, id);
    if n.tag == d.tInput {
        if typeIs(d, id, d.vCheckbox) { return "checkbox"; }
        if typeIs(d, id, d.vRadio) { return "radio"; }
        if typeIs(d, id, d.vRange) { return "slider"; }
        if typeIs(d, id, d.vColor) { return "button"; }
        if typeIs(d, id, d.vSearch) { return "searchbox"; }
        return "textbox";
    }
    if n.mitem { return "menuitem"; }
    if n.tag == d.tSelect { return if n.multi { "listbox" } else { "combobox" }; }
    if n.tag == d.tButton { return "button"; }
    if same(tag, "option") { return "option"; }
    if same(tag, "dialog") { return "dialog"; }
    if same(tag, "h1") || same(tag, "h2") || same(tag, "h3") || same(tag, "h4") || same(tag, "h5") || same(tag, "h6") { return "heading"; }
    if same(tag, "ul") || same(tag, "ol") { return "list"; }
    if same(tag, "li") { return "listitem"; }
    if same(tag, "a") { return "link"; }
    if same(tag, "hr") { return "separator"; }
    if same(tag, "nav") { return "navigation"; }
    if same(tag, "main") { return "main"; }
    if same(tag, "header") { return "banner"; }
    if same(tag, "aside") { return "complementary"; }
    if same(tag, "section") { return "region"; }
    if same(tag, "img") || n.tag == d.tGlyph { return "img"; }
    if same(tag, "p") { return "paragraph"; }
    if n.tag == d.tProgress { return "progressbar"; }
    if n.tag == d.tMeter { return "meter"; }
    if n.tag == d.tDetails { return "group"; }
    return "";
}

/// A control, or a gauge: what a `<label>` can name.
fn labelable(d: &Dom, id: int): bool {
    let t = d.nodes.items[id].tag;
    return isCtl(d, id) || t == d.tProgress || t == d.tMeter;
}

fn isCtl(d: &Dom, id: int): bool {
    let t = d.nodes.items[id].tag;
    return t == d.tInput || t == d.tSelect;
}

/// Roles whose name is their text.
fn fromContent(r: string): bool {
    return same(r, "button") || same(r, "menuitem") || same(r, "option") || same(r, "heading") || same(r, "tab") || same(r, "link");
}

/// The visible text under `id` (an `aria-label` stands for its element; controls are skipped).
fn content(d: &Dom, id: int, t: &Text) {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.kind == K_TEXT {
            t.pushStr(d.textOf(c));
        } else if shown(d, c) && !isCtl(d, c) && n.tag != d.tButton {
            if d.ariaOf(c).len > 0 {
                t.pushStr(d.ariaOf(c));
            } else {
                content(d, c, t);
            }
            t.push(32);
        }
        c = n.next;
    }
}

/// `s` with runs of whitespace as one space and no ends.
fn squash(mem: &Arena, s: string): string {
    let t = Text.new(mem);
    let sp = false;
    for i in 0..s.len {
        let b = s[i];
        if b == 32 || b == 10 || b == 9 || b == 13 {
            sp = t.len() > 0;
        } else {
            if sp {
                t.push(32);
                sp = false;
            }
            t.push(b);
        }
    }
    return t.str();
}

fn contentOf(d: &Dom, mem: &Arena, id: int): string {
    let t = Text.new(mem);
    content(d, id, &t);
    return squash(mem, t.str());
}

/// The first heading under `id` (-1 for none).
fn heading(d: &Dom, id: int): int {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        if shown(d, c) {
            if same(role(d, c), "heading") {
                return c;
            }
            let h = heading(d, c);
            if h >= 0 {
                return h;
            }
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

/// The accessible name of `id`, built in `mem` ("" for none).
pub fn name(d: &Dom, mem: &Arena, id: int): string {
    id = d.resolve(id);
    if id == STALE { return ""; }
    let a = d.ariaOf(id);
    if a.len > 0 {
        return a;
    }
    let r = role(d, id);
    let s = "";
    if fromContent(r) {
        s = contentOf(d, mem, id);
    } else if same(r, "dialog") {
        let h = heading(d, id);
        if h >= 0 {
            s = contentOf(d, mem, h);
        }
    } else if labelable(d, id) {
        // the nearest wrapping <label>, its own text only; a label whose `for` names another control is that one's
        let nm = d.mnodes.items[id].id;
        let p = d.nodes.items[id].parent;
        while p >= 0 && s.len == 0 {
            if same(tagOf(d, p), "label") && (d.forOf(p).len == 0 || nm >= 0 && same(d.forOf(p), d.css.name(nm))) {
                s = contentOf(d, mem, p);
            }
            p = d.nodes.items[p].parent;
        }
        if s.len == 0 && nm >= 0 && d.forLabels > 0 {
            let l = labelFor(d, 0, d.css.name(nm));
            if l >= 0 {
                s = contentOf(d, mem, l);
            }
        }
        if s.len == 0 && isCtl(d, id) && !typeIs(d, id, d.vCheckbox) && !typeIs(d, id, d.vRadio) && !typeIs(d, id, d.vRange) {
            s = d.nodes.items[id].ph;
        }
    }
    if s.len == 0 {
        s = d.tipOf(id);
    }
    return s;
}

/// Whether a modal dialog is open and `id` is not in it (or an overlay above it).
fn inert(d: &Dom, id: int): bool {
    return !dom.allowedByModal(d, id);
}

/// `A_*` bits: what a user can do to `id` (0 for a disabled, hidden or inert node).
pub fn actions(d: &Dom, id: int): int {
    id = d.resolve(id);
    if id == STALE { return 0; }
    if !isFocusable(d, id) || inert(d, id) {
        return 0;
    }
    let n = &d.nodes.items[id];
    let a = A_FOCUS;
    if dom.isField(d, id) || typeIs(d, id, d.vRange) {
        a += A_SET;
    } else {
        a += A_CLICK;
    }
    return a;
}

/// Do `act` to `id` on the next frame (call between frames): focus it, activate it (focus and Enter, which
/// clicks a button, flips a checkbox, opens a select), or set a slider to `num` / a text box to `text`.
/// False when it is not offered (`actions`).
pub fn perform(d: &Dom, id: int, act: int, num: f32, text: string): bool {
    id = d.resolve(id);
    if id == STALE || (actions(d, id) / act) % 2 == 0 {
        return false;
    }
    let n = &d.nodes.items[id];
    if act == A_FOCUS {
        // a screen reader moves focus like the keyboard: the ring shows (`:focus-visible`)
        d.setKeyboard(true);
        d.focusNode(id);
    } else if act == A_CLICK {
        d.setKeyboard(true);
        d.focusNode(id);
        d.simKeys("", "Enter");
    } else if typeIs(d, id, d.vRange) {
        dom.aNote(d, dom.EV_VALUE, id);
        n.value = num;
        if num < n.attrMin { n.value = n.attrMin; }
        if num > n.attrMax { n.value = n.attrMax; }
        n.chg = d.frame + 1;
    } else {
        let e = &d.eds.items[d.claim(id)];
        e.set(text);
        n.sval = e.str();
        n.chg = d.frame + 1;
        dom.aNote(d, dom.EV_VALUE, id);
    }
    return true;
}

fn pushState(t: &Text, key: string, val: string) {
    t.push(32);
    t.pushStr(key);
    if val.len > 0 {
        t.push(61);
        t.pushStr(val);
    }
}

fn pushQuoted(t: &Text, s: string) {
    t.push(34);
    for i in 0..s.len {
        if s[i] == 34 {
            t.push(92);
        }
        t.push(s[i]);
    }
    t.push(34);
}

fn states(d: &Dom, mem: &Arena, t: &Text, id: int) {
    let n = &d.nodes.items[id];
    let r = role(d, id);
    if typeIs(d, id, d.vCheckbox) || typeIs(d, id, d.vRadio) {
        pushState(t, "checked", if n.checked { "true" } else { "false" });
    }
    if typeIs(d, id, d.vRadio) && n.rname >= 0 {
        t.pushStr(" group=");
        pushQuoted(t, d.nameOf(id));
    }
    if isDisabled(d, id) {
        pushState(t, "disabled", "");
    }
    if n.tag == d.tSelect || typeIs(d, id, d.vColor) {
        pushState(t, "expanded", if d.pop.kind != popup.NONE && d.pop.owner == id { "true" } else { "false" });
    }
    if n.tag == d.tSummary && n.parent >= 0 {
        pushState(t, "expanded", if d.isOpen(n.parent) { "true" } else { "false" });
    }
    if n.tag == d.tDetails {
        pushState(t, "expanded", if d.isOpen(id) { "true" } else { "false" });
    }
    if n.asel == 2 {
        pushState(t, "selected", "");
    } else if n.asel == 1 {
        pushState(t, "selected", "false");
    }
    let lv = d.liveOf(id);
    if lv.len > 0 {
        pushState(t, "live", lv);
    }
    let ds = describedBy(d, mem, id);
    if ds.len > 0 {
        t.pushStr(" desc=");
        pushQuoted(t, ds);
    }
    if d.focus == id {
        pushState(t, "focused", "");
    }
    if same(r, "dialog") && n.ov == dom.OV_MODAL {
        pushState(t, "modal", "");
    }
    if shown(d, id) && inert(d, id) && (isCtl(d, id) || n.tag == d.tButton || n.mitem) {
        pushState(t, "inert", "");
    }
    if n.tag == d.tProgress || n.tag == d.tMeter {
        // an indeterminate progress (no value) has no `now`
        t.pushStr(` min={n.attrMin} max={n.attrMax}`);
        if n.value >= 0.0 {
            t.pushStr(` now={n.value}`);
        }
    } else if typeIs(d, id, d.vRange) {
        t.pushStr(` min={n.attrMin} max={n.attrMax} now={n.value}`);
        if n.multi {
            t.pushStr(` high={n.high}`);
        }
    } else if same(tagOf(d, id), "option") && n.parent >= 0 && dom.optSelected(d, n.parent, id) {
        if n.asel != 2 {
            pushState(t, "selected", "");
        }
    } else if n.tag == d.tInput && !typeIs(d, id, d.vCheckbox) && !typeIs(d, id, d.vRadio) && !typeIs(d, id, d.vPassword) {
        // a password box says nothing about its value
        t.pushStr(" value=");
        pushQuoted(t, n.sval);
    } else if typeIs(d, id, d.vPassword) {
        pushState(t, "secret", "");
    }
    let a = actions(d, id);
    if a != 0 {
        t.pushStr(" actions=focus");
        if a / A_CLICK % 2 == 1 {
            t.pushStr(",click");
        }
        if a / A_SET % 2 == 1 {
            t.pushStr(",set");
        }
    }
}

/// Roles that are not required to have a name.
fn landmark(r: string): bool {
    return same(r, "paragraph") || same(r, "list") || same(r, "region") || same(r, "navigation") || same(r, "main") || same(r, "banner") || same(r, "complementary");
}

/// The first `<label for="want">` under `id` (-1 for none).
fn labelFor(d: &Dom, id: int, want: string): int {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_ELEM {
            if same(tagOf(d, c), "label") && same(d.forOf(c), want) {
                return c;
            }
            let r = labelFor(d, c, want);
            if r >= 0 {
                return r;
            }
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

fn hasCtl(d: &Dom, id: int): bool {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_ELEM && (labelable(d, c) || hasCtl(d, c)) {
            return true;
        }
        c = d.nodes.items[c].next;
    }
    return false;
}

fn walk(d: &Dom, mem: &Arena, t: &Text, id: int, depth: int) {
    let n = &d.nodes.items[id];
    if n.kind == K_TEXT {
        // a wrapping <label>'s text is its control's name
        let p = n.parent;
        if p >= 0 && !dom.styleVisible(d, p) {
            return;
        }
        if p >= 0 && same(tagOf(d, p), "label") && hasCtl(d, p) && d.forOf(p).len == 0 {
            return;
        }
        let s = squash(mem, d.textOf(id));
        if s.len > 0 {
            for i in 0..depth {
                t.pushStr("  ");
            }
            t.pushStr("text ");
            pushQuoted(t, s);
            t.push(10);
        }
        return;
    }
    if !present(d, id) {
        return;
    }
    let r = if dom.styleVisible(d, id) { role(d, id) } else { "" };
    let down = depth;
    if r.len > 0 {
        for i in 0..depth {
            t.pushStr("  ");
        }
        t.pushStr(r);
        let nm = name(d, mem, id);
        if nm.len > 0 || !landmark(r) {
            t.push(32);
            pushQuoted(t, nm);
        }
        states(d, mem, t, id);
        t.push(10);
        down = depth + 1;
        if fromContent(r) || isCtl(d, id) && !same(r, "combobox") && !same(r, "listbox") {
            return;
        }
    }
    let c = n.first;
    while c >= 0 {
        walk(d, mem, t, c, down);
        c = d.nodes.items[c].next;
    }
}

/// Append the tree under the root to `t`, one line per element with a role (`role "name" state=... actions=...`),
/// children indented, other text as `text "..."`. Scratch strings use `mem`. Call after `layout()`.
pub fn dump(d: &Dom, mem: &Arena, t: &Text) {
    walk(d, mem, t, 0, 0);
}

/// The description of `id`: the text of the elements its `aria-describedby` names (static ids, space separated), joined by a space ("" for none).
pub fn describedBy(d: &Dom, mem: &Arena, id: int): string {
    id = d.resolve(id);
    if id == STALE { return ""; }
    let ids = d.descByOf(id);
    if ids.len == 0 {
        return "";
    }
    let t = Text.new(mem);
    let i = 0;
    while i < ids.len {
        while i < ids.len && ids[i] == 32 {
            i += 1;
        }
        let j = i;
        while j < ids.len && ids[j] != 32 {
            j += 1;
        }
        if j > i {
            let key = Text.new(mem);
            for k in i..j {
                key.push(ids[k]);
            }
            let e = d.byId(key.str());
            if e >= 0 {
                let a = d.ariaOf(e);
                let part = if a.len > 0 { a } else { contentOf(d, mem, e) };
                if part.len > 0 {
                    if t.len() > 0 {
                        t.push(32);
                    }
                    t.pushStr(part);
                }
            }
        }
        i = j;
    }
    return t.str();
}

/// A node's absolute rectangle (root coordinates, px): the bounding box of its border box after scroll, `animate:flip`, transition
/// scale and `transform` of it and its ancestors (the same transforms `hitNode` undoes). `ok` is false for a gone or hidden node.
pub struct Rect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
    ok: bool;
}

/// The bounds of `id` (see `Rect`). Call after `layout()`.
pub fn bounds(d: &Dom, id: int): Rect {
    id = d.resolve(id);
    if id == STALE || !shown(d, id) {
        return Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ok: false };
    }
    let n = &d.nodes.items[id];
    let a = Vec2 { x: 0.0, y: 0.0 };
    dom.mapUp(d, id, 0.0, 0.0, &a);
    let lox = a.x;
    let loy = a.y;
    let hix = a.x;
    let hiy = a.y;
    for k in 1..4 {
        dom.mapUp(d, id, if k % 2 == 1 { n.w } else { 0.0 }, if k >= 2 { n.h } else { 0.0 }, &a);
        if a.x < lox { lox = a.x; }
        if a.y < loy { loy = a.y; }
        if a.x > hix { hix = a.x; }
        if a.y > hiy { hiy = a.y; }
    }
    return Rect { x: lox, y: loy, w: hix - lox, h: hiy - loy, ok: true };
}

/// A text box as the AT text interface reads it: the whole value, the caret and the selection as byte offsets into `value`
/// (`selLo == selHi` for none; the caret is the end that moves).
pub struct TextInfo {
    value: string;
    caret: int;
    selLo: int;
    selHi: int;
}

/// Fill `out` for the text box `id`. False for anything but a text box, textarea or search box, and always false for `type=password`
/// (its value, caret and selection are never exposed).
pub fn text(d: &Dom, id: int, out: &TextInfo): bool {
    id = d.resolve(id);
    if id == STALE || !shown(d, id) || !dom.isField(d, id) || typeIs(d, id, d.vPassword) {
        return false;
    }
    let n = &d.nodes.items[id];
    out.value = n.sval;
    out.caret = 0;
    out.selLo = 0;
    out.selHi = 0;
    if n.edit >= 0 {
        let e = &d.eds.items[n.edit];
        out.caret = e.cur;
        out.selLo = if e.cur < e.anc { e.cur } else { e.anc };
        out.selHi = if e.cur < e.anc { e.anc } else { e.cur };
        if out.caret > n.sval.len { out.caret = n.sval.len; }
        if out.selHi > n.sval.len { out.selHi = n.sval.len; }
        if out.selLo > out.selHi { out.selLo = out.selHi; }
    }
    return true;
}

/// Take the queued events (focus moved; checked, expanded, selected or value changed; children came or went; name changed), oldest
/// first, one per kind and node since the last call; the list is built in `mem`. Empty when nothing changed (and always before `enable`).
/// Handles of nodes freed since are still listed: `Dom.alive(h)` before reading them.
pub fn events(d: &Dom, mem: &Arena): List<AEv> {
    let out = List<AEv>.new(mem);
    for i in 0..d.aev.len {
        out.push(d.aev.items[i]);
    }
    d.aev.len = 0;
    return out;
}

/// One announcement: the live region `h`, whether it is `assertive` (else polite) and its text now.
pub struct Live {
    h: int;
    assertive: bool;
    text: string;
}

/// Take the live regions (`aria-live` elements) whose text or children changed since the last call, in order, each once, with their
/// text now (the whole region, as a browser would read an `aria-atomic` one). Regions that are gone, hidden or `aria-live="off"` are
/// dropped; a region's first frame is not announced. Assertive ones should interrupt, polite ones queue.
pub fn liveChanges(d: &Dom, mem: &Arena): List<Live> {
    let out = List<Live>.new(mem);
    for i in 0..d.lq.len {
        let h = d.lq.items[i].v;
        let id = d.resolve(h);
        if id == STALE || !shown(d, id) {
            continue;
        }
        let m = d.liveOf(id);
        if same(m, "polite") || same(m, "assertive") {
            out.push(Live { h: h, assertive: same(m, "assertive"), text: contentOf(d, mem, id) });
        }
    }
    d.lq.len = 0;
    return out;
}

/// Actions posted by another thread (the AT bridge) for the main thread to `drain`. `post` is the only call that is safe off the main thread.
pub struct Inbox {
    m: Mutex;
    d: &Dom;
    n: int;
    cap: int;
    ids: []int;
    acts: []int;
    nums: []f32;
    lens: []int;
    texts: []u8;
    /// Called (main thread, lock not held) before each action runs; see `onAction`.
    hook: fn(ptr);
    harg: ptr;
}

fn noHook(p: ptr) {}

/// Run `f(arg)` before each action `drain` performs (the inbox is unlocked, so `f` may `post`). For a bridge that mirrors its queue, and tests.
pub fn onAction(ib: &Inbox, f: fn(ptr), arg: ptr) {
    ib.hook = f;
    ib.harg = arg;
}

const INBOX_TEXT: int = 256;

/// An inbox for `cap` pending actions, in `mem` (which must outlive the bridge thread).
pub fn inbox(mem: &Arena, d: &Dom, cap: int): &Inbox {
    // the arena does not align: a mutex (a futex word) on an odd address aborts the process
    mem.allocBytes((8 - mem.used % 8) % 8);
    let slot = mem.alloc::<Inbox>(1);
    slot[0] = Inbox {
        m: Mutex {},
        d: d,
        n: 0,
        cap: cap,
        ids: mem.alloc::<int>(cap),
        acts: mem.alloc::<int>(cap),
        nums: mem.alloc::<f32>(cap),
        lens: mem.alloc::<int>(cap),
        texts: mem.alloc::<u8>(cap * INBOX_TEXT),
        hook: noHook,
        harg: 0 as ptr,
    };
    return &slot[0];
}

/// Queue `perform(d, h, act, num, text)` (text cut at 256 bytes) and wake the loop (`Dom.requestFrame`). Any thread. False when full.
pub fn post(ib: &Inbox, h: int, act: int, num: f32, text: string): bool {
    ib.m.lock();
    if ib.n >= ib.cap {
        ib.m.unlock();
        return false;
    }
    let k = ib.n;
    let len = if text.len > INBOX_TEXT { INBOX_TEXT } else { text.len };
    ib.ids[k] = h;
    ib.acts[k] = act;
    ib.nums[k] = num;
    ib.lens[k] = len;
    for i in 0..len {
        ib.texts[k * INBOX_TEXT + i] = text[i];
    }
    ib.n = k + 1;
    ib.m.unlock();
    ib.d.requestFrame();
    return true;
}

/// Run the posted actions in order (main thread, between frames; `mem` holds the text copies). How many were taken.
/// The queue is copied out and unlocked first, so an action (or `onAction` hook) can post and the poster is never blocked while they run.
pub fn drain(ib: &Inbox, mem: &Arena): int {
    ib.m.lock();
    let n = ib.n;
    let ids = mem.alloc::<int>(n);
    let acts = mem.alloc::<int>(n);
    let nums = mem.alloc::<f32>(n);
    let texts = mem.alloc::<string>(n);
    for k in 0..n {
        let txt = Text.new(mem);
        for i in 0..ib.lens[k] {
            txt.push(ib.texts[k * INBOX_TEXT + i]);
        }
        ids[k] = ib.ids[k];
        acts[k] = ib.acts[k];
        nums[k] = ib.nums[k];
        texts[k] = txt.str();
    }
    ib.n = 0;
    ib.m.unlock();
    for k in 0..n {
        let f = ib.hook;
        f(ib.harg);
        perform(ib.d, ids[k], acts[k], nums[k], texts[k]);
    }
    return n;
}
