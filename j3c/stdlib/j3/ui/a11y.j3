/// The semantic (accessibility) tree of a laid-out `Dom`: a role, name, states and actions per element,
/// computed on demand from the nodes (nothing runs per frame). `dump` writes it as text (`domhtml.dumpA11y`,
/// goldens); a platform bridge reads `role`/`name`/`actions`/`bounds`/`text` and calls `perform`, drains `events` and `liveChanges`, and
/// wakes an idle loop with `Inbox.post`. An AT id is a node handle (`Dom.handle`): every function here takes a handle or a plain id, and
/// a handle whose node is gone gives the empty answer (`""`, 0, false). All of it is main-thread, between frames, except `post`.
///
/// Roles come from the tag (`button`, `input` by `type`, `select`, `option`, `dialog`, `nav`, `h1`...) or the
/// `role` attribute. Names: `aria-label` (an `<img>`'s `alt`), else the text content for buttons, menu items,
/// options and headings, or the wrapping `<label>`'s text (or a `<label for>` naming its `id`), `placeholder` or `title` for a control. Hidden
/// nodes (`display: none`, fading out) are left out. A password box's value is never read.

module j3.ui.a11y;

use j3.i18n;
use j3.math.Vec2;
use j3.memory.{ Arena, List };
use j3.text.{ same, Text };
use j3.thread.Mutex;
use j3.ui.dom;
use j3.ui.dom.{ AEv, Dom, isDisabled, isFocusable, K_ELEM, K_TEXT, STALE };
use j3.ui.popup;

pub const A_FOCUS: int = 1;
pub const A_CLICK: int = 2;
pub const A_SET: int = 4;

/// `events` kinds (the same numbers as `dom.EV_*`): focus moved (h = new focus, -1 for none), checked / expanded / selected / value of
/// h changed, children of h came or went, name of h changed.
pub const EV_FOCUS: int = 1;
pub const EV_CHECKED: int = 2;
pub const EV_EXPANDED: int = 3;
pub const EV_SELECTED: int = 4;
pub const EV_VALUE: int = 5;
pub const EV_CHILDREN: int = 6;
pub const EV_NAME: int = 7;

/// Start queueing `events` and `liveChanges`. Off (the default), the Dom pays one flag test per change and idle frames cost nothing either way.
pub fn enable(d: &Dom) {
    d.a11yOn = true;
}

fn tagOf(d: &Dom, id: int): string {
    return d.css.name(d.nodes.items[id].tag);
}

fn typeIs(d: &Dom, id: int, ty: int): bool {
    return d.mnodes.items[id].type == ty;
}

/// Whether `id` is an element a screen reader would reach (not removed, fading out, `display: none` or a runtime popup: the select list is
/// its select's `aria-expanded` and options).
pub fn shown(d: &Dom, id: int): bool {
    id = d.resolve(id);
    if id == STALE { return false; }
    return present(d, id) && dom.styleVisible(d, id);
}

/// The document language (`j3.i18n.locale()`, "" when none was set): the AT's `lang` for the whole tree.
pub fn language(): string {
    return i18n.locale();
}

/// `shown` without `visibility`: a `visibility: hidden` box takes no part of the tree itself, but a visible child of it does.
fn present(d: &Dom, id: int): bool {
    let n = &d.nodes.items[id];
    // an option's box is not laid out, but it is part of its select
    return n.kind == K_ELEM && !n.ghost && !n.rt && (n.disp != dom.DP_NONE || n.tag == d.tOption);
}

/// The role of `id`: the `role` attribute, else what the tag implies ("" for none).
pub fn role(d: &Dom, id: int): string {
    id = d.resolve(id);
    if id == STALE { return ""; }
    let r = d.roleOf(id);
    if r.len > 0 {
        return r;
    }
    let n = &d.nodes.items[id];
    let tag = tagOf(d, id);
    if n.tag == d.tInput {
        if typeIs(d, id, d.vCheckbox) { return "checkbox"; }
        if typeIs(d, id, d.vRadio) { return "radio"; }
        if typeIs(d, id, d.vRange) { return "slider"; }
        if typeIs(d, id, d.vColor) { return "button"; }
        if typeIs(d, id, d.vSearch) { return "searchbox"; }
        return "textbox";
    }
    if n.mitem { return "menuitem"; }
    if n.tag == d.tSelect { return if n.multi { "listbox" } else { "combobox" }; }
    if n.tag == d.tButton { return "button"; }
    if same(tag, "option") { return "option"; }
    if same(tag, "dialog") { return "dialog"; }
    if same(tag, "h1") || same(tag, "h2") || same(tag, "h3") || same(tag, "h4") || same(tag, "h5") || same(tag, "h6") { return "heading"; }
    if same(tag, "ul") || same(tag, "ol") { return "list"; }
    if same(tag, "li") { return "listitem"; }
    if same(tag, "a") { return "link"; }
    if same(tag, "hr") { return "separator"; }
    if same(tag, "nav") { return "navigation"; }
    if same(tag, "main") { return "main"; }
    if same(tag, "header") { return "banner"; }
    if same(tag, "aside") { return "complementary"; }
    if same(tag, "section") { return "region"; }
    if same(tag, "img") || n.tag == d.tGlyph { return "img"; }
    if same(tag, "p") { return "paragraph"; }
    if n.tag == d.tProgress { return "progressbar"; }
    if n.tag == d.tMeter { return "meter"; }
    if n.tag == d.tDetails { return "group"; }
    return "";
}

