use j3.ui.media.{ Imgs, Media };
use j3.ui.mediastyle;

/// The tree. Make one with `Dom.new`, keep it in a `let`, pass `&d`.
pub struct Dom {
    mem: &Arena;
    css: &Css;
    nodes: List<Node>;
    mnodes: List<MatchNode>;
    frags: List<Frag>;
    fragFree: List<Idx>;
    boxes: List<Frag>;
    boxFree: List<Idx>;
    ob: List<OBox>;
    pseg: List<BSeg>;
    free: List<Idx>;
    abs: List<Idx>;
    fonts: List<FontEnt>;
    fi: []FItem;
    fiTop: int;
    gs: []f32;
    gTop: int;
    occ: []u8;
    stack: []int;
    cursor: []int;
    sp: int;
    gen: int;
    serial: int;
    tText: int;
    tRoot: int;
    tButton: int;
    vCheckbox: int;
    vRadio: int;
    tBefore: int;
    tAfter: int;
    vRange: int;
    vColor: int;
    vSearch: int;
    vTextarea: int;
    vPassword: int;
    tSelect: int;
    tOption: int;
    tGlyph: int;
    fallback: string;
    /// Fonts that failed to load (their text measures 0 wide).
    fontMissing: int;
    /// Boxes laid out so far (a counter: unchanged across a steady `layout`).
    laid: int;
    /// Styles recomputed so far.
    restyled: int;
    /// Children `markKids` flagged for restyle (`:nth-last-child` & co.); a test reads it to check a mass append stays linear.
    kidMarks: int;
    /// Slot offset and unit for nested constructs (`enter`/`leave`).
    base: int;
    scale: int;
    /// Frames begun with `beginFrame`, the clock in ms, and a fixed step (0 uses `game.ticks`).
    frame: int;
    now: f32;
    fixedMs: f32;
    vw: f32;
    vh: f32;
    simOn: bool;
    simX: f32;
    simY: f32;
    simDown: bool;
    simWheel: f32;
    mx: f32;
    my: f32;
    pmx: f32;
    pmy: f32;
    down: bool;
    prevDown: bool;
    wheelV: f32;
    moved: bool;
    hover: int;
    pressNode: int;
    clickNode: int;
    /// The control a label click forwarded to this frame (-1 none); `clicked` is true for it and for the label.
    clickTo: int;
    /// Live `<label for>` elements (`a11y` scans for them only when there are some).
    forLabels: int;
    /// `a11y.enable` was called: the setters below queue events into `aev`, live-region changes into `lq` (handles). Off, they cost one test.
    a11yOn: bool;
    aev: List<AEv>;
    /// Tab press serial and the scratch table `radioMark` fills (one Tab stop per radio group): a radio is a stop when its `rstop` is `tabSer`.
    tabSer: int;
    rtab: List<int>;
    lq: List<Idx>;
    /// Live elements with an `aria-live` (the live-region walk is skipped when none), events queued so far, and wake requests (atomic).
    liveCount: int;
    aevTotal: int;
    wake: int;
    downHit: int;
    /// The button behind `downHit` / `upHit` (0 left, 1 middle, 2 right): `on:mousedown`'s `button`.
    downBtn: int;
    upBtn: int;
    /// The focused node as the frame began, before this frame's press moved it (`j3.ui.grid`: a header press blurs the grid).
    focusWas: int;
    /// Static text selection (`j3.ui.textsel`): anchor and focus as text node + byte offset (-1 none), a drag in
    /// progress, whether any node carries marks, and the copy buffer.
    selA: int;
    selAo: int;
    selF: int;
    selFo: int;
    selDrag: bool;
    selMarked: bool;
    /// Fast-click count on static text and the last press (time, x, y), for word and block select.
    selClicks: int;
    selCt: f32;
    selCx: f32;
    selCy: f32;
    selBuf: Text;
    /// PRIMARY selection kept in the Dom instead of the system after `simPrimary` (tests; headless has none).
    primFake: bool;
    primBuf: Text;
    upHit: int;
    dragNode: int;
    /// Faded-out nodes still in the tree, and transitions in flight.
    ghosts: int;
    /// Live `::before` / `::after` boxes: `syncPseudo` keeps running while any exist, so a reload that drops the last rule removes them.
    npe: int;
    animating: int;
    /// Hash of every `<canvas>` body's draws last frame (`game.p2Watched`), the `now` they last differed, and whether that was under
    /// `CANVAS_HOLD_MS` ago: a canvas animating by itself keeps the loop awake (`idleMs`) until its output holds still.
    canvasSum: u64;
    canvasAt: f32;
    canvasLive: bool;
    /// Motions that move `letter-spacing` / `word-spacing` (`motion.spacing`); `enterTextNode` walks ancestors only while this is above 0.
    spMo: int;
    /// Visible indeterminate `<progress>` boxes the build walk set this frame and the frame before (`isLive`).
    gaugeLive: int;
    gaugeSeen: int;
    /// Overlay rebuilds of followers of an animated custom property (`followVars`), for tests and `J3_STEADY`-style checks.
    followed: int;
    /// Nodes with `animate:flip`, the viewport they were last laid out in, and how many are mid-flight.
    flips: List<Flip>;
    flipVw: f32;
    flipVh: f32;
    flipLive: int;
    trns: List<Trans>;
    trs: List<Motion>;
    trFree: List<Idx>;
    dyns: List<Dyn>;
    dynFree: List<Idx>;
    /// Elements with a transition or animation in flight.
    act: List<Idx>;
    /// Click ripples in flight, and the element with focus (-1 none).
    rip: Ripples;
    focus: int;
    /// Input modality for `:focus-visible`: the last input was a key (true) or a pointer press (false). See `setKeyboard`.
    keyMode: bool;
    /// Paint walk: parent stack, per-level cursor (last child consumed), depth, hidden depth.
    pst: []int;
    pcu: []int;
    ptarget: []int;
    psp: int;
    /// 1 where the element at that paint depth draws its own box (0: an ancestor reopened on the way to a stacking-context entry).
    pz: []int;
    /// Stacking contexts (`dom/stack.j3`): every context's entries as node ids (`Node.zs`..), their paint-order keys, the contexts still to
    /// fill, the top-layer entries found on the way, a scratch stack for the ancestors reopened by `paintEntry`/`hitEntry`, and the
    /// fingerprint of the tree the lists were built for. `stackBuilds` counts the rebuilds (idle frames add none).
    zl: List<Idx>;
    zk: List<Idx>;
    zw: List<Idx>;
    zt: List<Idx>;
    pch: []int;
    pchn: int;
    zsig: int;
    zbuilt: bool;
    /// `buildStack` is on its second pass over a context: its scrollers count as contexts (`ctxOf`).
    zscr: bool;
    stackBuilds: int;
    /// Paint a detached subtree in tree order, lifted boxes included (`paintDetached` of a box that is no context).
    pflat: bool;
    /// `<canvas>` replay: the generated paint walk, run to reach one canvas body. `rpc` is the path from the root to it, `rpI` how far down
    /// the walk is. `hook`/`hookSelf` are set by the generated `render`.
    rpOn: bool;
    rpT: int;
    rpLen: int;
    rpI: int;
    rpc: []int;
    hookOn: bool;
    hook: fn(ptr);
    hookSelf: ptr;
    hidden: int;
    tInput: int;
    tCanvas: int;
    tDialog: int;
    /// `<br>`, `<progress>`, `<meter>`, `<details>`, `<summary>`.
    tBr: int;
    tProgress: int;
    tMeter: int;
    tDetails: int;
    tSummary: int;
    tLabel: int;
    tImg: int;
    tSvg: int;
    tIcon: int;
    tPath: int;
    /// Class `sub` (submenu, `subOf`). `tagDisp` caches `tagDisplay` by tag id (-1 = not looked up).
    vSub: int;
    tagDisp: List<int>;
    chain: []int;
    /// Saved slot base and unit per open element (build walk and paint walk).
    sv: []int;
    pv: []int;
    /// Text states of input widgets (`Node.edit` indexes it), the open popup, and the keyboard this
    /// frame (`kin`; `simK` is a headless one for the next frame). `seen` is the focus `inputs.begin`
    /// last handled, `thumb` the range thumb in use.
    eds: List<Edit>;
    pop: Popup;
    kin: KeyIn;
    /// A focused text box, select or grid owns the keyboard: game code's `j3.game.keyDown`/`keyPressed`
    /// read false (`keyDownRaw`/`keyPressedRaw` still see keys). Default true; false lets keys through.
    takeKeys: bool;
    kbd: Repeat;
    simK: KeyIn;
    simKOn: bool;
    /// Gamepad (`j3.ui.padnav`): last frame's buttons and the repeat clock, the state `setPad` fed (`padOn`; else `j3.game` is polled),
    /// the field the pad just focused (-1 none: the on-screen keyboard hook) and the shoulder buttons this frame (-1 LB, 1 RB, 0 none).
    padSt: PadState;
    padRaw: PadRaw;
    padOn: bool;
    padText: int;
    padShoulder: int;
    /// `<glyph>` prompts (`dom/glyph.j3`): the pad style (`GS_*`) and the games' own action bindings.
    glyphStyle: int;
    gbinds: List<GlyphBind>;
    /// Scratch for a `<glyph>`'s accessible name (cleared and reused, so a device switch allocates nothing).
    gtmp: Text;
    /// Counters for tests: frames the pad was read (one is attached), and nodes `padnav` looked at for moves.
    padReads: int;
    padVisits: int;
    seen: int;
    thumb: int;
    /// Right button this frame, last frame, and from `simInput`; the element it was released on
    /// (-1 none) and where.
    rdown: bool;
    prevR: bool;
    simR: bool;
    /// Middle button this frame, last frame, and from `simMiddle`.
    mdown: bool;
    prevM: bool;
    simM: bool;
    ctxNode: int;
    ctxX: f32;
    ctxY: f32;
    /// Open overlays (`<dialog modal>`, `popover`) from the bottom of the stack up; the press target
    /// before the modal filter (-1 none); the part of a scrollbar under the mouse and the box it
    /// belongs to; the scrollbar being dragged (box, part, grab offset); boxes still coasting.
    ovs: List<Idx>;
    /// The open runtime popup subtree (`popnode`; -1 none) and the build-walk state saved while it is built.
    ptRoot: int;
    /// Height the open popup would have without `popnode.place` squeezing it (px).
    ptNat: f32;
    /// Independent passive tooltip subtree; it may coexist with an input popup.
    ttRoot: int;
    rtSv: []int;
    rawHit: int;
    /// Inspector (`j3.ui.inspect`): on, the F12 hotkey allowed (`J3_INSPECT`), the pinned element, the raw input it took from the app this frame
    /// (keys, wheel, left button now and last frame), the panel's scroll, its text with the node and style it was built for, how many times it
    /// was built (tests), the hover label with its key, and the `J3_INSPECT_DUMP` spec.
    insp: bool;
    inspHot: bool;
    inspPin: int;
    inspIn: KeyIn;
    inspWheel: f32;
    inspDown: bool;
    inspMasked: bool;
    inspPrev: bool;
    inspScroll: f32;
    inspTxt: string;
    inspTxtPin: int;
    inspTxtStyle: int;
    inspBuilds: int;
    inspLbl: string;
    inspLblKey: int;
    /// Scratch arenas of the panel text and the hover label, rewound per rebuild (start empty, grow on first use).
    inspAr: []Arena;
    inspInit: bool;
    dumpSpec: string;
    barHover: int;
    barOf: int;
    barNode: int;
    barPart: int;
    barGrab: f32;
    coasting: int;
    /// Boxes with a scroll gesture waiting to settle onto a snap point or a scroll animation running (`isLive`); a snap container was
    /// laid out since the last `layout` (it re-snaps to the same item); the snap candidates of the axis being solved; the focus
    /// that a key moved (revealed at the next `beginFrame`); the virtual lists bound last frame (`scrollToKey`).
    snapPend: int;
    /// Snap passes run (`snapCollect` calls): stays put on idle frames (a test reads it).
    snapWork: int;
    snapDirty: bool;
    snapPts: List<SnapPt>;
    reveal: int;
    vlists: List<VListRef>;
    /// Tooltip: the element whose `title` waits to show and since when (ms).
    tipNode: int;
    tipT0: f32;
    /// Menu keys (`j3.ui.overlays`): the element hover is forced to while the keyboard drives a menu (-1 none,
    /// the mouse moving ends it); a host whose submenu opened with Right and the frames spent waiting for it
    /// to show; the hover-intent hold (a submenu host the pointer left, kept open until `holdT + 300` ms).
    kbHover: int;
    /// Caret popup (`popover="caret"`, `on:trigger`): the box with an active trigger and its byte range, the box and frame of the
    /// last trigger change (an end counts), the range Escape dismissed, and the popup entry the keys are on.
    trigNode: int;
    /// Data grids (`grid={g}`; `j3.ui.grid`): the ones bound in the last frame, each with its scroll box.
    grids: List<GridRef>;
    /// The grid's cell editor box: when it is freed its `Edit` is reset in place instead of replaced.
    poolEd: int;
    trigLo: int;
    trigHi: int;
    trigEv: int;
    trigChg: int;
    trigSup: int;
    trigSupNode: int;
    cpHot: int;
    kbPend: int;
    kbWait: int;
    holdId: int;
    holdT: f32;
    /// Select type-ahead (`j3.ui.dropdown`): the typed prefix (bytes), its length and when the last key came.
    ta: []u8;
    taLen: int;
    taAt: f32;
    taOwner: int;
    taCycle: bool;
    /// Frame step in ms, and the clock before this frame.
    dtMs: f32;
    prevNow: f32;
    /// Panels (`panel` attribute), the drag in progress, and the `position: sticky` boxes.
    pans: List<Panel>;
    grab: Grab;
    /// The item drag in progress (`j3.ui.drag`).
    drag: Drag;
    stk: List<Idx>;
    /// `window-drag` boxes (`j3.ui.windrag`), registered by `attrWindowDrag`.
    wdr: List<Idx>;
    /// Keyed rows: open row ids (build / paint walks) and each row's parent row.
    gstk: []int;
    gsp: int;
    pgs: []int;
    pgsp: int;
    gpar: List<Idx>;
    /// A node last seen in each row (-1: none yet): `keyBegin` finds a moved row's run from it, a hint that is validated.
    gfirst: List<Idx>;
    /// Row ids free to reuse, ids of dead rows waiting for their nodes to be gone, and a scratch stamp per id.
    gfree: List<Idx>;
    gdead: List<Idx>;
    gseen: List<Idx>;
    gstamp: int;
    /// Images: textures by path, and what `<img>` / `<svg>` / `<path>` elements carry (`j3.ui.media`).
    imgs: Imgs;
    media: List<Media>;
}
