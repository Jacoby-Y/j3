use j3.ui.css.{ BORDER_DASHED, BORDER_DOTTED, BORDER_NONE, BORDER_SOLID, P_BACKDROP_FILTER, P_BG_IMAGE, P_BORDER_IMAGE, P_BORDER_STYLE, P_BOX_SHADOW };
use j3.ui.css.{ P_BG_CLIP, P_OVERFLOW_WRAP, P_STROKE_COLOR, P_STROKE_WIDTH, P_TEXT_OVERFLOW, P_TEXT_SHADOW, P_WHITE_SPACE };
use j3.ui.css.{ CLIP_TEXT, TO_ELLIPSIS, WRAP_NORMAL, WS_NOWRAP, WS_PRE_LINE };
use j3.ui.css.{ P_OBJECT_FIT, V_URL };
use j3.ui.css.{ P_ISOLATION, P_CLIP_PATH, P_FILTER, P_MASK_IMAGE, P_MIX_BLEND_MODE, P_PERSPECTIVE, P_ROTATE_X, P_ROTATE_Y, V_LIST };
use j3.ui.cssmatch.{ beginPass, computeStyle, endPass, hasSubject, peHolds, prevEl, varValue };
