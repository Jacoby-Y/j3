pub const K_ELEM: int = 0;

pub const K_TEXT: int = 1;

pub const K_FREE: int = 2;
/// `Dom.handle`: serial * HANDLE_UNIT + id. Below it a number is a plain id; `resolve` gives STALE for a handle whose node is gone.
pub const HANDLE_UNIT: int = 4294967296;
pub const STALE: int = -2;

/// `j3.ui.a11y.events` kinds (the bridge's change queue; only filled after `a11y.enable`).
pub const EV_FOCUS: int = 1;
pub const EV_CHECKED: int = 2;
pub const EV_EXPANDED: int = 3;
pub const EV_SELECTED: int = 4;
pub const EV_VALUE: int = 5;
pub const EV_CHILDREN: int = 6;
pub const EV_NAME: int = 7;

/// One queued accessibility event: its kind (`EV_*`) and the handle of the node it is about (-1 for "no focus").
pub struct AEv {
    kind: int;
    h: int;
}

pub const DP_BLOCK: int = 0;

pub const DP_INLINE: int = 1;

const DP_INLINE_BLOCK: int = 2;

const DP_FLEX: int = 3;

const DP_GRID: int = 4;

pub const DP_NONE: int = 5;

/// `display: contents`: no box; a grid parent lays the children out as its own items (`flatFrom`).
const DP_CONTENTS: int = 6;

const UNDEF: f32 = -1.0;

/// A `<meter>` `low`, `high` or `optimum` the markup did not set.
const METER_UNSET: f32 = -1000000000.0;

/// Overlay kinds (`Node.ov`) and the first of their paint layers (`z-index` 1000 up, one per stack depth).
pub const OV_MODAL: int = 1;

pub const OV_POPOVER: int = 2;

pub const OVERLAY_Z: int = 1000;

const MAX_DEPTH: int = 128;

/// Paint frames: the tree depth, plus the same again for a `<canvas>` replay (`runCanvas`).
const PAINT_DEPTH: int = 2 * MAX_DEPTH + 4;
const GROUP_DEPTH: int = 64;

const FI_CAP: int = 16384;

/// Scratch floats (`Dom.gs`, a stack so nested grids take turns) and cells (`Dom.occ`) for grid track sizing and placement:
/// they start this size and double on demand; `OCC_MAX` cells (64 MiB) is a grid too big to place.
const GS_START: int = 4096;

const OCC_START: int = 4096;

const OCC_MAX: int = 67108864;

/// One node. Read the layout results; build with the `Dom` methods.
pub struct Node {
    kind: int;
    tag: int;
    parent: int;
    first: int;
    last: int;
    next: int;
    prev: int;
    /// Visual links for ordered flex children; source links remain unchanged.
    vfirst: int;
    vlast: int;
    vnext: int;
    vprev: int;
    ordered: bool;
    /// Stacking (`dom/stack.j3`, set by `buildStack`): `ctx` the box is a stacking context (it paints its descendants as one unit,
    /// `z-index` inside it is relative to it), `lift` it paints after the in-flow content of its context (positioned or a context).
    /// A context's entries, in paint order, are `Dom.zl[zs .. zs + zc]`: the first `zneg` have a negative key.
    ctx: bool = false;
    lift: bool = false;
    /// A scroller that is no context with a lifted box inside it: its scrollbars paint last in its context (`paintBarEntry`).
    bdef: bool = false;
    zs: int = 0;
    zneg: int = 0;
    zc: int = 0;
    slot: int;
    scope: int;
    /// Innermost keyed `{#each}` row it was built in (`keyBegin`), -1 outside.
    gk: int;
    /// Computed style id (`css.get(style, P_*)`).
    style: int;
    disp: int;
    isAbs: bool;
    checked: bool;
    value: f32;
    attrMin: f32;
    attrMax: f32;
    attrStep: f32;
    buf: []u8;
    tlen: int;
    x: f32;
    y: f32;
    w: f32;
    h: f32;
    /// Scroll height: content plus padding (an `overflow-y` box can scroll `scrollMax` px).
    contentH: f32;
    scrollY: f32;
    scrollMax: f32;
    /// Distance from the border-box top to the first text baseline.
    baseline: f32;
    /// Selected bytes `sa..sb` of a text node (`j3.ui.textsel`), -1 when none.
    sa: int;
    sb: int;
    /// First text fragment owned by this block (-1 for none).
    frag0: int;
    fragTail: int;
    fragReuse: int;
    /// Per-line boxes of this block's decorated inline children (`inline boxes`, chain of `Dom.boxes`).
    box0: int;
    boxTail: int;
    boxReuse: int;
    dirty: bool;
    laid: bool;
    lastW: f32;
    lastH: f32;
    basisW: f32;
    basisH: f32;
    styleDirty: bool;
    subStyle: bool;
    /// `markKids` already restyled this node's children since its last restyle (so a mass append marks them once).
    kidsMk: bool;
    /// Restyle was asked only by a `:has()` invalidation (`markHas`): the subtree restyles only if this node's style id changes.
    hasOnly: bool;
    /// `Css.hasGen` of the last `markHas` walk through this node: a walk stops at a node an earlier walk already covered this round.
    hasEp: int;
    firstEl: int;
    /// The last element child (carries `FL_LAST_CHILD`), -1 for none.
    lastEl: int;
    dirtyGen: int;
    intrGen: int;
    minc: f32;
    maxc: f32;
    clsBuf: []int;
    ncls: int;
    /// Paint bits set by `paintBox` for `paintEnd` (see `PB_*`).
    pflags: int;
    /// Index into `Dom.trns` (-1: no `transition:` / `in:` / `out:`), when the enter transition began, and the ghost state.
    trn: int;
    fadeT0: f32;
    ghost: bool;
    ghostT0: f32;
    /// Frame (`Dom.frame`) in which the node was created.
    born: int;
    /// Serial of the node (`Dom.serial` at creation): a handle (`Dom.handle`) holds it, so a recycled id is told from the old node.
    ser: int;
    /// Index into `Dom.trs` (-1 none).
    tr: int;
    /// Computed style from the cascade; `style` is this, or the overlay while the node moves.
    tstyle: int;
    /// `animation-delay` added by markup (`anim-delay`), in ms.
    adelay: f32;
    /// Index into `Dom.flips` (-1: no `animate:flip`).
    flip: int;
    /// On `Dom.act`.
    inAct: bool;
    /// Input widgets (`j3.ui.inputs`): the bound string (`value`) as a view, `placeholder`, the index
    /// of the `Dom.eds` text state (-1 none), `multiple`, the second thumb of a range slider, and the
    /// frame of the last user change / Enter press.
    sval: string;
    ph: string;
    edit: int;
    multi: bool;
    high: f32;
    /// `<meter>` `low`, `high` and `optimum` (`METER_UNSET` for an absent one), and what `attrOpen` last applied to a `<details>` (0 nothing, 1 closed, 2 open).
    mlow: f32;
    mhigh: f32;
    mopt: f32;
    openSet: int;
    /// The frame whose update sees this `<details>`'s `toggled` (it changed state).
    togAt: int;
    /// The frame a click on its `<summary>` flipped this `<details>` (`bind:open` writes back only those), or the frame the user checked or
    /// unchecked this radio.
    clkAt: int;
    /// A radio's `name` (interned, -1 none).
    rname: int;
    /// `Dom.tabSer` of the Tab press that chose this radio as its group's stop.
    rstop: int;
    /// The `<meter>` good / ok / bad colors resolved for computed style `mcSt` (-1 none): they follow the node's own custom properties.
    mcSt: int;
    mc0: int;
    mc1: int;
    mc2: int;
    chg: int;
    sub: int;
    /// `maxlength` in code points (0 none) and `rows` of a `textarea` (0: 3).
    maxlen: int;
    rows: int;
    /// Horizontal scroll (`overflow-x`): offset, range, scroll width, and the inertia speeds of both
    /// axes in px/ms (`scroll-behavior: smooth`).
    scrollX: f32;
    scrollMaxX: f32;
    contentW: f32;
    velX: f32;
    velY: f32;
    /// Scroll snap and animated scrolls (`dom/snap.j3`): the time (ms) of the last scroll by a gesture or by code, -1 when settled, and
    /// the offsets the gesture began at; `anX` / `anY` = an x / y animation toward `anTx` / `anTy`; the item last snapped to per axis.
    snapAt: f32;
    snapSx: f32;
    snapSy: f32;
    anX: bool;
    anY: bool;
    anTx: f32;
    anTy: f32;
    snapKx: int;
    snapKy: int;
    /// `born` of those items when they were snapped to: a node id that was freed and reused has another stamp.
    snapBx: int;
    snapBy: int;
    /// Overlays (`j3.ui.overlay`): `OV_*` kind (0 none), the `closedby` mode, the frame a close was
    /// requested, the focus to give back, and the stack depth that picked its paint layer.
    ov: int;
    ovBy: int;
    closeAt: int;
    ovFocus: int;
    ovZ: int;
    ovInit: bool;
    /// `autoselect` (dialog), `on:submit` (input), `default` (button), and a pending select-all for the field the dialog focused.
    fAuto: bool;
    fSub: bool;
    fDef: bool;
    fSel: bool;
    ovContext: bool;
    ctxPending: bool;
    /// `popover="caret"` (anchored at its box's caret; `cth` is the caret line height + 4 for flipping above) and a text box's
    /// `triggers` characters (a literal).
    ovCaret: bool;
    cth: f32;
    trigs: string;
    hcAt: f32;
    hcLeave: f32;
    hcOpen: bool;
    hcBlock: bool;
    /// `position: fixed` (or a `<dialog>`): `x`/`y` are viewport px.
    isFixed: bool;
    /// `title` text (copied), and `left`/`top` attributes (px; `hasAt`).
    svBuf: []u8;
    svLen: int;
    /// `text-transform` copy of the text (`shownText`), and the transform it holds (0: stale).
    tbuf: []u8;
    txm: int;
    tipBuf: []u8;
    tipLen: int;
    /// `aria-label` and `role` attributes (copied; `j3.ui.a11y`).
    ariaBuf: []u8;
    ariaLen: int;
    roleBuf: []u8;
    /// `for` (labels): the static id of the control.
    forBuf: []u8;
    forLen: int;
    /// `aria-live` ("polite" / "assertive" / "off"), `aria-describedby` (static ids) and `aria-selected` (0 unset, 1 false, 2 true).
    liveBuf: []u8;
    liveLen: int;
    descBuf: []u8;
    descLen: int;
    asel: int;
    /// `focus-group` and `nav-up|down|left|right` (copied, packed as `group;up;down;left;right`; `j3.ui.padnav`).
    navBuf: []u8;
    navLen: int;
    roleLen: int;
    hasAtX: bool;
    hasAtY: bool;
    atx: f32;
    aty: f32;
    /// `j3.ui.panels` role (`PK_*`) and the size it forces on a panel (-1 none; border box px).
    pk: int;
    /// `menuitem` / `tabindex` attribute: focusable like a button, a target of the menu keys (`j3.ui.overlays`).
    mitem: bool;
    /// `tabindex="-1"`: focusable by code and click, skipped by Tab and the pad.
    noTab: bool;
    /// `tabindex` above 0: Tab visits these first, in ascending order (ties in tree order).
    tabIdx: int;
    /// Item drag (`j3.ui.drag`): `draggable`, the handlers it has (bits 1 enter, 2 leave, 4 over, 8 drop), `drag-ghost="none"`,
    /// `drag-id`, and `drag-data` (copied).
    draggable: bool;
    dragT: int;
    noGhost: bool;
    dragId: int;
    dgBuf: []u8;
    dgLen: int;
    ow: f32;
    oh: f32;
    /// `position: sticky` (`j3.ui.sticky`): registered on `Dom.stk`, and how far it is pushed down.
    isStk: bool;
    sy: f32;
    /// `<img>` / `<svg>` / `<path>` data: index into `Dom.media` plus one (0 none).
    media: int;
    /// Visual-only option mirror: borrows source media; never owns source handlers or identity.
    optionSource: int;
    /// Last source dirty generation (mirrors), or cached label generation (logical options).
    optionGen: int;
    /// Index into `Dom.dyns` (-1 none): `class` holes and `style:` overrides.
    dyn: int;
    /// Root of a popup subtree the runtime owns (`j3.ui.popnode`): the build walk neither reuses nor removes it,
    /// the generated paint walk skips it, and it is always `position: fixed` on the overlay layer. `pidx` is a
    /// popup row's index (-1 none).
    rt: bool;
    pidx: int;
    /// 1 or 2 for the runtime-made `::before` / `::after` box of its parent (`Node.ghost` is set too, so the build walk,
    /// hit testing, focus, a11y and the test kit leave it alone and the paint walk draws it from the tree), else 0.
    pe: int;
}

/// `Node.pk`: a panel, its drag handle, its resize grip.
pub const PK_PANEL: int = 1;
pub const PK_HANDLE: int = 2;
pub const PK_GRIP: int = 3;

/// One run of text on one line. `start..end` index the bytes of the text node `node`.
pub struct Frag {
    node: int;
    /// 0 text, 1 inline-block (use the node's rect).
    kind: int;
    x: f32;
    y: f32;
    w: f32;
    start: int;
    end: int;
    ap: f32;
    dp: f32;
    asc: f32;
    /// Where the "…" of `text-overflow: ellipsis` goes (px from `x`), or -1 for none. The run then
    /// ends at `end` and `w` includes the ellipsis.
    ell: f32;
    next: int;
    /// `vertical-align`: `vm` 0 raised `sh` px from the line's baseline, 1 `top`, 2 `bottom` (of the line box).
    sh: f32;
    vm: int;
    /// Which `top` / `bottom` group the fragment belongs to (`vm` != 0): its element is one box on the line.
    grp: int;
}

struct Idx {
    v: int;
}

/// `animate:flip` state of one node (`Dom.flips`, dense; `Node.flip` indexes it): duration, `Css.eases` index,
/// the layout position seen last frame (`seen` once), the paint offset now and at the start of the flight, and its start time.
struct Flip {
    node: int;
    ms: f32;
    ease: int;
    seen: bool;
    x: f32;
    y: f32;
    ox: f32;
    oy: f32;
    ox0: f32;
    oy0: f32;
    t0: f32;
}

/// Enter and leave transitions of one node (`Dom.trns`, dense; `Node.trn` indexes it). `inK` / `outK`: 0 none, 1 fade,
/// 2 fly, 3 slide, 4 scale, with durations `inMs` / `outMs`; `ease` is a `Css.eases` index (-1: linear for fade, ease-out
/// otherwise); `fx` / `fy` the fly offset in px, `sf` the scale start, `axis` the slide axis (0 height, 1 width).
struct Trans {
    node: int;
    inK: int;
    inMs: f32;
    outK: int;
    outMs: f32;
    ease: int;
    fx: f32;
    fy: f32;
    sf: f32;
    axis: int;
    /// A slide was in flight at the last layout (`stepSlides`).
    sliding: bool;
}

/// An open decorated inline element while its block is laid out (`Dom.ob`, a stack).
struct OBox {
    node: int;
    seq: int;
    /// margin + border + padding to the left / right, and the border + padding part alone.
    lead: f32;
    trail: f32;
    lpad: f32;
    rpad: f32;
    /// Whether its left edge has been placed (on its first fragment).
    used: bool;
    /// First / last fragment of this box on the current line (-1 none), and the left extension of that segment.
    fa: int;
    fb: int;
    segL: f32;
    first: bool;
    /// `vertical-align` of the element: raise from the baseline, and `top` / `bottom` (see `Frag.vm`).
    sh: f32;
    vm: int;
    /// `box-decoration-break: clone`: every line piece repeats the left / right padding and border.
    cl: bool;
}

/// A finished per-line piece of an inline box, waiting for its line to be positioned (`Dom.pseg`).
struct BSeg {
    node: int;
    seq: int;
    fa: int;
    fb: int;
    left: f32;
    right: f32;
    first: bool;
    last: bool;
    sh: f32;
    vm: int;
    cl: bool;
}

struct FontEnt {
    family: int;
    size: int;
    font: Font;
}

struct FItem {
    id: int;
    grow: f32;
    shrink: f32;
    padM: f32;
    base: f32;
    minM: f32;
    maxM: f32;
    size: f32;
    mm: f32;
    cm: f32;
    cross: f32;
    nat: f32;
    frozen: bool;
    pos: f32;
    /// Flex line (0 without `flex-wrap`), its cross size, its baseline distance from cross-start (descent when reversed), and its cross offset.
    ln: int;
    lc: f32;
    la: f32;
    ly: f32;
    /// Grid area: column lines `c0..c1`, row lines `r0..r1` (0 based, end exclusive).
    c0: int;
    c1: int;
    r0: int;
    r1: int;
}

pub struct Edges {
    pl: f32;
    pr: f32;
    pt: f32;
    pb: f32;
    bl: f32;
    br: f32;
    bt: f32;
    bb: f32;
    ml: f32;
    mr: f32;
    mt: f32;
    mb: f32;
}

/// The tree. Make one with `Dom.new`, keep it in a `let`, pass `&d`.
pub struct Dom {
    mem: &Arena;
    css: &Css;
    nodes: List<Node>;
    mnodes: List<MatchNode>;
    frags: List<Frag>;
    fragFree: List<Idx>;
    boxes: List<Frag>;
    boxFree: List<Idx>;
    ob: List<OBox>;
    pseg: List<BSeg>;
    free: List<Idx>;
    abs: List<Idx>;
    fonts: List<FontEnt>;
    fi: []FItem;
    fiTop: int;
    gs: []f32;
    gTop: int;
    occ: []u8;
    stack: []int;
    cursor: []int;
    sp: int;
    gen: int;
    serial: int;
    tText: int;
    tRoot: int;
    tButton: int;
    vCheckbox: int;
    vRadio: int;
    tBefore: int;
    tAfter: int;
    vRange: int;
    vColor: int;
    vSearch: int;
    vTextarea: int;
    vPassword: int;
    tSelect: int;
    tOption: int;
    tGlyph: int;
    fallback: string;
    /// Fonts that failed to load (their text measures 0 wide).
    fontMissing: int;
    /// Boxes laid out so far (a counter: unchanged across a steady `layout`).
    laid: int;
    /// Styles recomputed so far.
    restyled: int;
    /// Children `markKids` flagged for restyle (`:nth-last-child` & co.); a test reads it to check a mass append stays linear.
    kidMarks: int;
    /// Slot offset and unit for nested constructs (`enter`/`leave`).
    base: int;
    scale: int;
    /// Frames begun with `beginFrame`, the clock in ms, and a fixed step (0 uses `game.ticks`).
    frame: int;
    now: f32;
    fixedMs: f32;
    vw: f32;
    vh: f32;
    simOn: bool;
    simX: f32;
    simY: f32;
    simDown: bool;
    simWheel: f32;
    mx: f32;
    my: f32;
    pmx: f32;
    pmy: f32;
    down: bool;
    prevDown: bool;
    wheelV: f32;
    moved: bool;
    hover: int;
    pressNode: int;
    clickNode: int;
    /// The control a label click forwarded to this frame (-1 none); `clicked` is true for it and for the label.
    clickTo: int;
    /// Live `<label for>` elements (`a11y` scans for them only when there are some).
    forLabels: int;
    /// `a11y.enable` was called: the setters below queue events into `aev`, live-region changes into `lq` (handles). Off, they cost one test.
    a11yOn: bool;
    aev: List<AEv>;
    /// Tab press serial and the scratch table `radioMark` fills (one Tab stop per radio group): a radio is a stop when its `rstop` is `tabSer`.
    tabSer: int;
    rtab: List<int>;
    lq: List<Idx>;
    /// Live elements with an `aria-live` (the live-region walk is skipped when none), events queued so far, and wake requests (atomic).
    liveCount: int;
    aevTotal: int;
    wake: int;
    downHit: int;
    /// The focused node as the frame began, before this frame's press moved it (`j3.ui.grid`: a header press blurs the grid).
    focusWas: int;
    /// Static text selection (`j3.ui.textsel`): anchor and focus as text node + byte offset (-1 none), a drag in
    /// progress, whether any node carries marks, and the copy buffer.
    selA: int;
    selAo: int;
    selF: int;
    selFo: int;
    selDrag: bool;
    selMarked: bool;
    /// Fast-click count on static text and the last press (time, x, y), for word and block select.
    selClicks: int;
    selCt: f32;
    selCx: f32;
    selCy: f32;
    selBuf: Text;
    upHit: int;
    dragNode: int;
    /// Faded-out nodes still in the tree, and transitions in flight.
    ghosts: int;
    /// Live `::before` / `::after` boxes: `syncPseudo` keeps running while any exist, so a reload that drops the last rule removes them.
    npe: int;
    animating: int;
    /// Motions that move `letter-spacing` / `word-spacing` (`motion.spacing`); `enterTextNode` walks ancestors only while this is above 0.
    spMo: int;
    /// Visible indeterminate `<progress>` boxes the build walk set this frame and the frame before (`isLive`).
    gaugeLive: int;
    gaugeSeen: int;
    /// Overlay rebuilds of followers of an animated custom property (`followVars`), for tests and `J3_STEADY`-style checks.
    followed: int;
    /// Nodes with `animate:flip`, the viewport they were last laid out in, and how many are mid-flight.
    flips: List<Flip>;
    flipVw: f32;
    flipVh: f32;
    flipLive: int;
    trns: List<Trans>;
    trs: List<Motion>;
    trFree: List<Idx>;
    dyns: List<Dyn>;
    dynFree: List<Idx>;
    /// Elements with a transition or animation in flight.
    act: List<Idx>;
    /// Click ripples in flight, and the element with focus (-1 none).
    rip: Ripples;
    focus: int;
    /// Input modality for `:focus-visible`: the last input was a key (true) or a pointer press (false). See `setKeyboard`.
    keyMode: bool;
    /// Paint walk: parent stack, per-level cursor (last child consumed), depth, hidden depth.
    pst: []int;
    pcu: []int;
    ptarget: []int;
    psp: int;
    /// 1 where the element at that paint depth draws its own box (0: an ancestor reopened on the way to a stacking-context entry).
    pz: []int;
    /// Stacking contexts (`dom/stack.j3`): every context's entries as node ids (`Node.zs`..), their paint-order keys, the contexts still to
    /// fill, the top-layer entries found on the way, a scratch stack for the ancestors reopened by `paintEntry`/`hitEntry`, and the
    /// fingerprint of the tree the lists were built for. `stackBuilds` counts the rebuilds (idle frames add none).
    zl: List<Idx>;
    zk: List<Idx>;
    zw: List<Idx>;
    zt: List<Idx>;
    pch: []int;
    pchn: int;
    zsig: int;
    zbuilt: bool;
    /// `buildStack` is on its second pass over a context: its scrollers count as contexts (`ctxOf`).
    zscr: bool;
    stackBuilds: int;
    /// Paint a detached subtree in tree order, lifted boxes included (`paintDetached` of a box that is no context).
    pflat: bool;
    /// `<canvas>` replay: the generated paint walk, run to reach one canvas body. `rpc` is the path from the root to it, `rpI` how far down
    /// the walk is. `hook`/`hookSelf` are set by the generated `render`.
    rpOn: bool;
    rpT: int;
    rpLen: int;
    rpI: int;
    rpc: []int;
    hookOn: bool;
    hook: fn(ptr);
    hookSelf: ptr;
    hidden: int;
    tInput: int;
    tCanvas: int;
    tDialog: int;
    /// `<br>`, `<progress>`, `<meter>`, `<details>`, `<summary>`.
    tBr: int;
    tProgress: int;
    tMeter: int;
    tDetails: int;
    tSummary: int;
    tLabel: int;
    tImg: int;
    tSvg: int;
    tPath: int;
    chain: []int;
    /// Saved slot base and unit per open element (build walk and paint walk).
    sv: []int;
    pv: []int;
    /// Text states of input widgets (`Node.edit` indexes it), the open popup, and the keyboard this
    /// frame (`kin`; `simK` is a headless one for the next frame). `seen` is the focus `inputs.begin`
    /// last handled, `thumb` the range thumb in use.
    eds: List<Edit>;
    pop: Popup;
    kin: KeyIn;
    kbd: Repeat;
    simK: KeyIn;
    simKOn: bool;
    /// Gamepad (`j3.ui.padnav`): last frame's buttons and the repeat clock, the state `setPad` fed (`padOn`; else `j3.game` is polled),
    /// the field the pad just focused (-1 none: the on-screen keyboard hook) and the shoulder buttons this frame (-1 LB, 1 RB, 0 none).
    padSt: PadState;
    padRaw: PadRaw;
    padOn: bool;
    padText: int;
    padShoulder: int;
    /// `<glyph>` prompts (`dom/glyph.j3`): the pad style (`GS_*`) and the games' own action bindings.
    glyphStyle: int;
    gbinds: List<GlyphBind>;
    /// Scratch for a `<glyph>`'s accessible name (cleared and reused, so a device switch allocates nothing).
    gtmp: Text;
    /// Counters for tests: frames the pad was read (one is attached), and nodes `padnav` looked at for moves.
    padReads: int;
    padVisits: int;
    seen: int;
    thumb: int;
    /// Right button this frame, last frame, and from `simInput`; the element it was released on
    /// (-1 none) and where.
    rdown: bool;
    prevR: bool;
    simR: bool;
    ctxNode: int;
    ctxX: f32;
    ctxY: f32;
    /// Open overlays (`<dialog modal>`, `popover`) from the bottom of the stack up; the press target
    /// before the modal filter (-1 none); the part of a scrollbar under the mouse and the box it
    /// belongs to; the scrollbar being dragged (box, part, grab offset); boxes still coasting.
    ovs: List<Idx>;
    /// The open runtime popup subtree (`popnode`; -1 none) and the build-walk state saved while it is built.
    ptRoot: int;
    /// Height the open popup would have without `popnode.place` squeezing it (px).
    ptNat: f32;
    /// Independent passive tooltip subtree; it may coexist with an input popup.
    ttRoot: int;
    rtSv: []int;
    rawHit: int;
    /// Inspector (`j3.ui.inspect`): on, the F12 hotkey allowed (`J3_INSPECT`), the pinned element, the raw input it took from the app this frame
    /// (keys, wheel, left button now and last frame), the panel's scroll, its text with the node and style it was built for, how many times it
    /// was built (tests), the hover label with its key, and the `J3_INSPECT_DUMP` spec.
    insp: bool;
    inspHot: bool;
    inspPin: int;
    inspIn: KeyIn;
    inspWheel: f32;
    inspDown: bool;
    inspMasked: bool;
    inspPrev: bool;
    inspScroll: f32;
    inspTxt: string;
    inspTxtPin: int;
    inspTxtStyle: int;
    inspBuilds: int;
    inspLbl: string;
    inspLblKey: int;
    /// Scratch arenas of the panel text and the hover label, rewound per rebuild (start empty, grow on first use).
    inspAr: []Arena;
    inspInit: bool;
    dumpSpec: string;
    barHover: int;
    barOf: int;
    barNode: int;
    barPart: int;
    barGrab: f32;
    coasting: int;
    /// Boxes with a scroll gesture waiting to settle onto a snap point or a scroll animation running (`isLive`); a snap container was
    /// laid out since the last `layout` (it re-snaps to the same item); the snap candidates of the axis being solved; the focus
    /// that a key moved (revealed at the next `beginFrame`); the virtual lists bound last frame (`scrollToKey`).
    snapPend: int;
    /// Snap passes run (`snapCollect` calls): stays put on idle frames (a test reads it).
    snapWork: int;
    snapDirty: bool;
    snapPts: List<SnapPt>;
    reveal: int;
    vlists: List<VListRef>;
    /// Tooltip: the element whose `title` waits to show and since when (ms).
    tipNode: int;
    tipT0: f32;
    /// Menu keys (`j3.ui.overlays`): the element hover is forced to while the keyboard drives a menu (-1 none,
    /// the mouse moving ends it); a host whose submenu opened with Right and the frames spent waiting for it
    /// to show; the hover-intent hold (a submenu host the pointer left, kept open until `holdT + 300` ms).
    kbHover: int;
    /// Caret popup (`popover="caret"`, `on:trigger`): the box with an active trigger and its byte range, the box and frame of the
    /// last trigger change (an end counts), the range Escape dismissed, and the popup entry the keys are on.
    trigNode: int;
    /// Data grids (`grid={g}`; `j3.ui.grid`): the ones bound in the last frame, each with its scroll box.
    grids: List<GridRef>;
    /// The grid's cell editor box: when it is freed its `Edit` is reset in place instead of replaced.
    poolEd: int;
    trigLo: int;
    trigHi: int;
    trigEv: int;
    trigChg: int;
    trigSup: int;
    trigSupNode: int;
    cpHot: int;
    kbPend: int;
    kbWait: int;
    holdId: int;
    holdT: f32;
    /// Select type-ahead (`j3.ui.dropdown`): the typed prefix (bytes), its length and when the last key came.
    ta: []u8;
    taLen: int;
    taAt: f32;
    taOwner: int;
    taCycle: bool;
    /// Frame step in ms, and the clock before this frame.
    dtMs: f32;
    prevNow: f32;
    /// Panels (`panel` attribute), the drag in progress, and the `position: sticky` boxes.
    pans: List<Panel>;
    grab: Grab;
    /// The item drag in progress (`j3.ui.drag`).
    drag: Drag;
    stk: List<Idx>;
    /// Keyed rows: open row ids (build / paint walks) and each row's parent row.
    gstk: []int;
    gsp: int;
    pgs: []int;
    pgsp: int;
    gpar: List<Idx>;
    /// A node last seen in each row (-1: none yet): `keyBegin` finds a moved row's run from it, a hint that is validated.
    gfirst: List<Idx>;
    /// Row ids free to reuse, ids of dead rows waiting for their nodes to be gone, and a scratch stamp per id.
    gfree: List<Idx>;
    gdead: List<Idx>;
    gseen: List<Idx>;
    gstamp: int;
    /// Images: textures by path, and what `<img>` / `<svg>` / `<path>` elements carry (`j3.ui.media`).
    imgs: Imgs;
    media: List<Media>;

    /// Empty tree with a root node (id 0, tag `root`, a block).
    fn new(mem: &Arena, css: &Css): Dom {
        let d = Dom {
            mem: mem,
            css: css,
            nodes: List<Node>.new(mem),
            mnodes: List<MatchNode>.new(mem),
            frags: List<Frag>.new(mem),
            fragFree: List<Idx>.new(mem),
            boxes: List<Frag>.new(mem),
            boxFree: List<Idx>.new(mem),
            ob: List<OBox>.new(mem),
            pseg: List<BSeg>.new(mem),
            free: List<Idx>.new(mem),
            abs: List<Idx>.new(mem),
            fonts: List<FontEnt>.new(mem),
            fi: mem.alloc::<FItem>(FI_CAP),
            fiTop: 0,
            gs: mem.alloc::<f32>(GS_START),
            gTop: 0,
            occ: mem.alloc::<u8>(OCC_START),
            stack: mem.alloc::<int>(MAX_DEPTH),
            cursor: mem.alloc::<int>(MAX_DEPTH),
            sp: 0,
            gen: 1,
            serial: 0,
            tText: css.intern("#text"),
            tRoot: css.intern("root"),
            tButton: css.intern("button"),
            vCheckbox: css.intern("checkbox"),
            vRadio: css.intern("radio"),
            tBefore: css.intern("::before"),
            tAfter: css.intern("::after"),
            vRange: css.intern("range"),
            vColor: css.intern("color"),
            vSearch: css.intern("search"),
            vTextarea: css.intern("textarea"),
            vPassword: css.intern("password"),
            tSelect: css.intern("select"),
            tGlyph: css.intern("glyph"),
            glyphStyle: 0,
            gbinds: List<GlyphBind>.new(mem),
            gtmp: Text.new(mem),
            tOption: css.intern("option"),
            fallback: "",
            fontMissing: 0,
            laid: 0,
            restyled: 0,
            kidMarks: 0,
            base: 0,
            scale: SLOT_UNIT,
            frame: 0,
            now: 0.0,
            fixedMs: 0.0,
            vw: 0.0,
            vh: 0.0,
            simOn: false,
            simX: 0.0,
            simY: 0.0,
            simDown: false,
            simWheel: 0.0,
            mx: -1.0,
            my: -1.0,
            pmx: -1.0,
            pmy: -1.0,
            down: false,
            prevDown: false,
            wheelV: 0.0,
            moved: false,
            hover: -1,
            pressNode: -1,
            clickNode: -1,
            clickTo: -1,
            forLabels: 0,
            a11yOn: false,
            aev: List<AEv>.new(mem),
            tabSer: 0,
            rtab: List<int>.new(mem),
            lq: List<Idx>.new(mem),
            liveCount: 0,
            aevTotal: 0,
            wake: 0,
            downHit: -1,
            focusWas: -1,
            selA: -1,
            selAo: 0,
            selF: -1,
            selFo: 0,
            selDrag: false,
            selMarked: false,
            selClicks: 0,
            selCt: -1000000.0,
            selCx: 0.0,
            selCy: 0.0,
            selBuf: Text.new(mem),
            upHit: -1,
            dragNode: -1,
            ghosts: 0,
            npe: 0,
            animating: 0,
            spMo: 0,
            gaugeLive: 0,
            gaugeSeen: 0,
            followed: 0,
            flips: List<Flip>.new(mem),
            flipVw: 0.0,
            flipVh: 0.0,
            flipLive: 0,
            trns: List<Trans>.new(mem),
            trs: List<Motion>.new(mem),
            trFree: List<Idx>.new(mem),
            dyns: List<Dyn>.new(mem),
            dynFree: List<Idx>.new(mem),
            act: List<Idx>.new(mem),
            rip: ripple.none(),
            focus: -1,
            keyMode: false,
            pst: mem.alloc::<int>(PAINT_DEPTH),
            pcu: mem.alloc::<int>(PAINT_DEPTH),
            ptarget: mem.alloc::<int>(PAINT_DEPTH),
            psp: 0,
            pz: mem.alloc::<int>(PAINT_DEPTH),
            zl: List<Idx>.new(mem),
            zk: List<Idx>.new(mem),
            zw: List<Idx>.new(mem),
            zt: List<Idx>.new(mem),
            pch: mem.alloc::<int>(PAINT_DEPTH),
            pchn: 0,
            zsig: 0,
            zbuilt: false,
            zscr: false,
            stackBuilds: 0,
            pflat: false,
            rpOn: false,
            rpT: -1,
            rpLen: 0,
            rpI: 0,
            rpc: mem.alloc::<int>(MAX_DEPTH + 2),
            hookOn: false,
            hook: noHook,
            hookSelf: 0 as ptr,
            hidden: 0,
            tInput: css.intern("input"),
            tCanvas: css.intern("canvas"),
            tDialog: css.intern("dialog"),
            tBr: css.intern("br"),
            tProgress: css.intern("progress"),
            tMeter: css.intern("meter"),
            tDetails: css.intern("details"),
            tSummary: css.intern("summary"),
            tLabel: css.intern("label"),
            tImg: css.intern("img"),
            tSvg: css.intern("svg"),
            tPath: css.intern("path"),
            chain: mem.alloc::<int>(MAX_DEPTH + 2),
            sv: mem.alloc::<int>(2 * MAX_DEPTH + 4),
            pv: mem.alloc::<int>(2 * PAINT_DEPTH),
            eds: List<Edit>.new(mem),
            pop: popup.closed(),
            kin: KeyIn {},
            kbd: keys.newRepeat(),
            simK: KeyIn {},
            padSt: PadState {},
            padRaw: PadRaw {},
            padOn: false,
            padText: -1,
            padShoulder: 0,
            padReads: 0,
            padVisits: 0,
            simKOn: false,
            seen: -1,
            thumb: 0,
            rdown: false,
            prevR: false,
            simR: false,
            ctxNode: -1,
            ctxX: 0.0,
            ctxY: 0.0,
            ovs: List<Idx>.new(mem),
            ptRoot: -1,
            ptNat: 0.0,
            ttRoot: -1,
            rtSv: mem.alloc::<int>(8),
            rawHit: -1,
            insp: false,
            inspHot: game.env("J3_INSPECT").len > 0 && !same(game.env("J3_INSPECT"), "0"),
            inspPin: -1,
            inspIn: KeyIn {},
            inspWheel: 0.0,
            inspDown: false,
            inspMasked: false,
            inspPrev: false,
            inspScroll: 0.0,
            inspTxt: "",
            inspTxtPin: -1,
            inspTxtStyle: -1,
            inspBuilds: 0,
            inspLbl: "",
            inspLblKey: -1,
            inspAr: mem.alloc::<Arena>(2),
            inspInit: false,
            dumpSpec: game.env("J3_INSPECT_DUMP"),
            barHover: 0,
            barOf: -1,
            barNode: -1,
            barPart: 0,
            barGrab: 0.0,
            coasting: 0,
            snapPend: 0,
            snapWork: 0,
            snapDirty: false,
            snapPts: List<SnapPt>.new(mem),
            reveal: -1,
            vlists: List<VListRef>.new(mem),
            tipNode: -1,
            tipT0: 0.0,
            kbHover: -1,
            trigNode: -1,
            grids: List<GridRef>.new(mem),
            poolEd: -1,
            trigLo: -1,
            trigHi: -1,
            trigEv: -1,
            trigChg: -1,
            trigSup: -1,
            trigSupNode: -1,
            cpHot: -1,
            kbPend: -1,
            kbWait: 0,
            holdId: -1,
            holdT: 0.0,
            ta: mem.alloc::<u8>(32),
            taLen: 0,
            taAt: -100000.0,
            taOwner: -1,
            taCycle: false,
            dtMs: 0.0,
            prevNow: 0.0,
            pans: List<Panel>.new(mem),
            grab: panelmath.noGrab(),
            drag: dragstate.fresh(),
            stk: List<Idx>.new(mem),
            gstk: mem.alloc::<int>(GROUP_DEPTH),
            gsp: 0,
            pgs: mem.alloc::<int>(GROUP_DEPTH),
            pgsp: 0,
            gpar: List<Idx>.new(mem),
            gfirst: List<Idx>.new(mem),
            gfree: List<Idx>.new(mem),
            gdead: List<Idx>.new(mem),
            gseen: List<Idx>.new(mem),
            gstamp: 0,
            imgs: media.newImgs(mem),
            media: media.newMedia(mem),
        };
        // test / launch overrides for the program's answers (`setReducedMotion`, `setColorScheme`); the OS is never asked
        if !css.prefsSet {
            let rm = game.env("J3_REDUCED_MOTION");
            css.reduced = rm.len > 0 && !same(rm, "0");
            css.dark = same(game.env("J3_COLOR_SCHEME"), "dark");
        }
        return d;
    }

    /// Intern a tag name for `open`.
    fn tag(this: &Dom, name: string): int {
        return this.css.intern(name);
    }

    /// Font file used when no `@font-face` matches (or there is none).
    fn setFallbackFont(this: &Dom, path: string) {
        this.fallback = path;
    }

    /// Start a frame of build calls (creates the root on first use).
    fn begin(this: &Dom) {
        if this.nodes.len == 0 {
            let r = newNode(this, K_ELEM, this.tRoot, 0, 0);
            this.nodes.items[r].parent = -1;
            this.mnodes.items[r].parent = -1;
        }
        this.sp = 0;
        this.stack[0] = 0;
        this.cursor[0] = -1;
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.gsp = 0;
    }

    /// Finish the frame: the root's unvisited children are removed.
    fn end(this: &Dom) {
        trimTail(this, this.stack[0], this.cursor[0]);
    }

    /// Next child element at `slot`: reuse it or insert. Returns its id. The slot is local (below
    /// 4096) and offset by `enter`; faded-out ghosts are skipped.
    fn open(this: &Dom, slot0: int, tag: int, scope: int): int {
        let slot = realSlot(this, slot0);
        let parent = this.stack[this.sp];
        let at = this.cursor[this.sp];
        let nxt = if at < 0 { this.nodes.items[parent].first } else { this.nodes.items[at].next };
        let from = nxt;
        nxt = skipGhost(this, nxt);
        while nxt >= 0 && this.nodes.items[nxt].kind == K_ELEM && this.nodes.items[nxt].slot < slot && ownsNode(this, nxt) {
            let gone = nxt;
            nxt = skipGhost(this, this.nodes.items[nxt].next);
            removeNode(this, gone);
        }
        let id = -1;
        if nxt >= 0 {
            let nn = &this.nodes.items[nxt];
            if nn.kind == K_ELEM && nn.slot == slot && nn.tag == tag && nn.scope == scope && ownsNode(this, nxt) {
                id = nxt;
            }
        }
        if id < 0 && this.ghosts > 0 {
            id = reviveGhost(this, from, nxt, slot, tag, scope);
        }
        if id < 0 {
            id = newNode(this, K_ELEM, tag, slot, scope);
            insertBefore(this, parent, id, nxt);
        }
        this.cursor[this.sp] = id;
        if this.sp + 1 >= MAX_DEPTH {
            panic("dom: nesting too deep");
        }
        this.sp += 1;
        this.stack[this.sp] = id;
        this.cursor[this.sp] = -1;
        this.sv[2 * this.sp] = this.base;
        this.sv[2 * this.sp + 1] = this.scale;
        this.base = 0;
        this.scale = SLOT_UNIT;
        return id;
    }

    /// Done with the element `open` returned: its unvisited children are removed.
    fn close(this: &Dom) {
        trimTail(this, this.stack[this.sp], this.cursor[this.sp]);
        this.base = this.sv[2 * this.sp];
        this.scale = this.sv[2 * this.sp + 1];
        this.sp -= 1;
    }

    /// Next child text node with content `s` (copied, and only when the bytes changed).
    fn text(this: &Dom, s: string): int {
        let parent = this.stack[this.sp];
        let at = this.cursor[this.sp];
        let nxt = if at < 0 { this.nodes.items[parent].first } else { this.nodes.items[at].next };
        nxt = skipGhost(this, nxt);
        let id = -1;
        if nxt >= 0 && this.nodes.items[nxt].kind == K_TEXT && ownsNode(this, nxt) {
            id = nxt;
        } else {
            id = newNode(this, K_TEXT, this.tText, -1, 0);
            insertBefore(this, parent, id, nxt);
        }
        this.cursor[this.sp] = id;
        if storeBytes(this, &this.nodes.items[id], s) {
            markDirty(this, id);
            aTouch(this, parent);
            // `:empty` ignores whitespace-only text
            let blank = true;
            for i in 0..s.len {
                if s[i] > 32 {
                    blank = false;
                }
            }
            if blank == hasBit(this.mnodes.items[id].flags, FL_NONBLANK) {
                this.mnodes.items[id].flags = if blank { this.mnodes.items[id].flags - FL_NONBLANK } else { this.mnodes.items[id].flags + FL_NONBLANK };
                markKids(this, parent);
                markHas(this, id, 2, 0);
            }
        }
        return id;
    }

    /// Add class `name` if missing.
    fn cls(this: &Dom, id: int, name: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsId(id, this.css.intern(name));
    }

    /// `cls` with the class interned once (`css.intern`): no name search per frame.
    fn clsId(this: &Dom, id: int, c: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        for i in 0..n.ncls {
            if n.clsBuf[i] == c {
                return;
            }
        }
        if n.ncls >= 8 {
            panic("dom: more than 8 classes");
        }
        n.clsBuf[n.ncls] = c;
        n.ncls += 1;
        this.mnodes.items[id].classes = []int { ptr: n.clsBuf.ptr, len: n.ncls };
        markStyle(this, id);
        markHas(this, id, 0, c);
    }

    /// Add class `name` when `on`, remove it otherwise.
    fn clsIf(this: &Dom, id: int, name: string, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsIfId(id, this.css.intern(name), on);
    }

    /// `clsIf` with the class interned once.
    fn clsIfId(this: &Dom, id: int, c: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        if on {
            this.clsId(id, c);
            return;
        }
        let n = &this.nodes.items[id];
        for i in 0..n.ncls {
            if n.clsBuf[i] == c {
                n.clsBuf[i] = n.clsBuf[n.ncls - 1];
                n.ncls -= 1;
                this.mnodes.items[id].classes = []int { ptr: n.clsBuf.ptr, len: n.ncls };
                markStyle(this, id);
                markHas(this, id, 0, c);
                return;
            }
        }
    }

    /// `class="a r{n}"` holes: `s` is the text of the non-literal words. Classes it added last time are
    /// dropped and the new words added, only when the text changed.
    fn clsDyn(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsWords(id, 0, s);
    }

    /// `class` / `class:x` written on a component tag: the text its root element gets, same rules as `clsDyn`
    /// but a channel of its own, so the root's own holes and the parent's classes never drop each other's words.
    fn clsPass(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsWords(id, 1, s);
    }

    fn clsWords(this: &Dom, id: int, ch: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let y = dynOf(this, id);
        let h = dynattr.hashOf(s);
        if y.cl[ch] == s.len && y.ch[ch] == h {
            return;
        }
        y.cl[ch] = s.len;
        y.ch[ch] = h;
        for i in 0..y.cn[ch] {
            this.clsIfId(id, y.cids[ch * 8 + i], false);
        }
        y.cn[ch] = 0;
        let a = 0;
        for i in 0..=s.len {
            if i == s.len || isWs(s[i]) {
                if i > a {
                    if y.cn[ch] >= 8 {
                        panic("dom: more than 8 classes");
                    }
                    let c = this.css.intern(s[a..i]);
                    y.cids[ch * 8 + y.cn[ch]] = c;
                    y.cn[ch] += 1;
                    this.clsId(id, c);
                }
                a = i + 1;
            }
        }
    }

    /// The parent component whose scoped rules (those naming a class) also apply to this root element.
    fn scopePass(this: &Dom, id: int, scope: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let m = &this.mnodes.items[id];
        if m.scope2 != scope {
            m.scope2 = scope;
            markStyle(this, id);
        }
    }

    /// `style:` written on a component tag, slot `k` of the root: `kind` 0 none, 1 number `f`, 2 text `s`.
    fn stylePass(this: &Dom, id: int, k: int, kind: int, name: string, f: f32, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        if kind == 1 {
            this.styleNum(id, k, name, f);
        } else if kind == 2 || dynOf(this, id).sk[k] != 0 {
            this.styleStr(id, k, name, if kind == 2 { s } else { "" });
        }
    }

    /// `style:prop={number}` (attribute number `k` of the element): an inline value that beats every
    /// rule and transitions like one. Lengths are px. See `j3.ui.dynattr`.
    fn styleNum(this: &Dom, id: int, k: int, name: string, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if dynattr.setNum(this.css, dynOf(this, id), k, name, v) {
            markStyle(this, id);
        }
    }

    /// `style:prop="css value"` (see `styleNum`).
    fn styleStr(this: &Dom, id: int, k: int, name: string, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        if dynattr.setStr(this.css, dynOf(this, id), k, name, s) {
            markStyle(this, id);
        }
    }

    /// Force the next `layout` to redo every box (benchmarks, font reloads).
    fn invalidate(this: &Dom) {
        this.gen += 1;
        for i in 0..this.nodes.len {
            this.nodes.items[i].dirty = true;
            this.nodes.items[i].dirtyGen = this.gen;
        }
    }

    /// `id` attribute (`#id` selectors): a static name, no lookup by id exists.
    fn attrId(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].id;
        if cur >= 0 && same(this.css.name(cur), s) {
            return;
        }
        this.mnodes.items[id].id = this.css.intern(s);
        markStyle(this, id);
        markHas(this, id, 2, 0);
    }

    /// `type` attribute (`[type="range"]` selectors, replaced box size).
    fn attrType(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].type;
        if cur >= 0 && same(this.css.name(cur), s) {
            return;
        }
        this.mnodes.items[id].type = this.css.intern(s);
        markStyle(this, id);
        markHas(this, id, 2, 0);
    }

    /// `disabled` (the `:disabled` flag).
    fn attrDisabled(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.setFlag(id, 4, on);
    }

    /// `checked` (no layout effect).
    fn attrChecked(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].checked = on;
        this.setFlag(id, FL_CHECKED, on);
    }

    /// A radio's `checked`, `bind:checked` or `bind:group` state: applied when the program's value for it changes (a radio the user
    /// checked stays checked until the program says otherwise), and checking it unchecks the others of its group.
    fn attrRadio(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let want = if on { 2 } else { 1 };
        if this.nodes.items[id].openSet == want { return; }
        this.nodes.items[id].openSet = want;
        radioSet(this, id, on, false);
    }

    /// Whether `id` is checked (`bind:checked` on a radio writes it back).
    fn isChecked(this: &Dom, id: int): bool {
        id = this.resolve(id);
        return id != STALE && this.nodes.items[id].checked;
    }

    /// Text equality for a `bind:group` string (the generated module does not import `j3.text`).
    fn textIs(this: &Dom, a: string, b: string): bool {
        return same(a, b);
    }

    /// A radio's `bind:group` state: checked while the variable equals its value, whatever the radio shows now (so a variable no radio has
    /// unchecks them all, and the variable wins over a pick it did not take). A radio the user flipped this frame waits for the next frame,
    /// when the variable has had its say.
    fn attrGroup(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        n.openSet = if on { 2 } else { 1 };
        if n.clkAt == this.frame || n.checked == on { return; }
        radioSet(this, id, on, false);
    }

    /// A radio's `name`: radios with the same name in the same group scope are exclusive. A checked radio that changes group
    /// (or gets its name after its `checked`) takes the check from the group it joins.
    fn attrName(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.nodes.items[id].rname;
        if cur >= 0 && same(this.css.name(cur), s) { return; }
        this.nodes.items[id].rname = this.css.intern(s);
        if this.nodes.items[id].checked { radioClear(this, id, false); }
    }

    /// The `name` of a radio ("" for none).
    fn nameOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE || this.nodes.items[id].rname < 0 { return ""; }
        return this.css.name(this.nodes.items[id].rname);
    }

    /// `value` (no layout effect).
    fn attrValue(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.a11yOn && this.nodes.items[id].value != v { aNote(this, EV_VALUE, id); }
        this.nodes.items[id].value = v;
        if v < 0.0 && this.nodes.items[id].tag == this.tProgress && !this.css.reduced && paintVisible(this, id) {
            this.gaugeLive += 1;
        }
    }

    /// `value` of a text, search, color or select input (and of an `<option>`): the bound string (copied
    /// unless the box is being edited). While the box has focus its own buffer is the truth, and `s` only replaces it
    /// when it differs (the program changed the variable).
    fn attrText(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !same(n.sval, s) { aNote(this, EV_VALUE, id); }
        if n.edit >= 0 && this.focus == id && isField(this, id) {
            let e = &this.eds.items[n.edit];
            if !e.matches(s) {
                e.set(s);
            }
            n.sval = e.str();
        } else if this.mnodes.items[id].type == this.vTextarea {
            // a textarea lays its text out unfocused too, so its buffer is always the truth
            let t = &this.eds.items[this.claim(id)];
            if !t.matches(s) {
                t.set(s);
            }
            n.sval = t.str();
        } else {
            // copied: `s` may be frame scratch (a markup fn's string), and events read `sval` between frames
            keep(this.mem, &n.svBuf, &n.svLen, s);
            n.sval = ([]u8 { ptr: n.svBuf.ptr, len: n.svLen }) as string;
        }
        this.syncPlaceholder(id);
    }

    /// `:placeholder-shown` from the box's current text (`sval`); also called when the user edits, so it does not wait for the bound value.
    fn syncPlaceholder(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        this.setFlag(id, FL_PH_SHOWN, n.ph.len > 0 && n.sval.len == 0);
    }

    /// `rich` on a textarea: it keeps spans (bold, italic, link, atomic tokens) beside its text.
    fn attrRich(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.eds.items[this.claim(id)].rich = on;
    }

    /// `bind:spans` of a rich textarea: the program's spans, copied into the box when they are not just the view `spansValue` gave
    /// out. Replacing the text from the program drops the old spans (set the new ones in the same update, in any order).
    fn attrSpans(this: &Dom, id: int, v: []Span) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.eds.items[this.claim(id)].setSpans(v);
    }

    /// The spans of a rich textarea as a view of its own storage, valid until the next edit (`bind:spans` assigns it).
    fn spansValue(this: &Dom, id: int): []Span {
        return this.eds.items[this.claim(id)].spans();
    }

    /// Where the caret of the focused text box `id` is now, in window px: top left and height (w is 1), from the box's last layout
    /// and its current text and caret (not the last paint, so a popup placed in the same update does not trail a keystroke).
    /// `x` is -1 when the box is not focused or laid out, or is a password box. A caret popup (`@ja` completion) anchors here.
    fn caretRect(this: &Dom, id: int): CaretRect {
        let n = &this.nodes.items[id];
        let none = CaretRect { x: -1.0, y: -1.0, w: 1.0, h: 0.0 };
        if n.edit < 0 || this.focus != id || !n.laid || n.disp == DP_NONE || this.mnodes.items[id].type == this.vPassword {
            return none;
        }
        let e = &this.eds.items[n.edit];
        let ed = edgesOf(this, n.style, n.basisW);
        let cw = n.w - ed.pl - ed.pr - ed.bl - ed.br;
        let font = fontOf(this, n.style);
        let bold = isBold(this, n.style);
        let tm = enterText(this, n.style);
        let at = Vec2 { x: 0.0, y: 0.0 };
        let h: f32 = n.h - ed.pt - ed.pb - ed.bt - ed.bb;
        if this.mnodes.items[id].type == this.vTextarea {
            let lh = f32(fontLine(font));
            area.layout(e, font, bold, cw);
            area.follow(e, true, lh, h);
            let line = area.caretLine(e);
            at.x = area.caretAt(e, font, bold, e.str(), e.ls.items[line], area.lineEnd(e, line), e.cur);
            at.y = f32(line) * lh - e.ty;
            h = lh;
        } else {
            let s = e.str();
            let avail = if this.mnodes.items[id].type == this.vSearch { cw - 18.0 } else { cw };
            let vs = field.scroll(font, bold, s, e.vs, e.cur, avail);
            at.x = field.caretX(font, bold, s, vs, vs + fitPrefix(font, bold, bytesOf(s[vs..s.len]), avail), e.cur);
        }
        leaveText(tm);
        return CaretRect { x: this.absX(id) + ed.bl + ed.pl + at.x, y: this.absY(id) + ed.bt + ed.pt + at.y, w: 1.0, h: h };
    }

    /// Byte index of the caret of text box `id` (a selection's moving end).
    fn caret(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        return this.eds.items[this.claim(id)].cur;
    }

    /// Replace `lo..hi` of a rich textarea's text with the atomic token `label` (`SPAN_MENTION` / `SPAN_EMOJI`, `data` its id): the
    /// bound value and spans update like user input (`changed` is true this frame if the box has not been updated yet, and
    /// on the next one either way, so call it from any handler), and it is one undo step. False when the range is bad.
    fn insertToken(this: &Dom, id: int, lo: int, hi: int, label: string, kind: int, data: string): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let e = &this.eds.items[this.claim(id)];
        if !e.replaceWithToken(lo, hi, label, kind, data) {
            return false;
        }
        let n = &this.nodes.items[id];
        n.sval = e.str();
        n.chg = this.frame;
        e.late = this.frame + 1;
        e.t0 = this.now;
        return true;
    }

    /// `maxlength` of a text box, in code points.
    fn attrMaxLen(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].maxlen = int(v);
    }

    /// `rows` of a textarea: its height when no `height` is set.
    fn attrRows(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.nodes.items[id].rows != int(v) {
            this.nodes.items[id].rows = int(v);
            markStyle(this, id);
        }
    }

    /// The text state of node `id`: its slot in `eds` (made on first use, reusing a freed one). A
    /// text box edits it; a select or color input builds its value in it.
    fn claim(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        let n = &this.nodes.items[id];
        if n.edit >= 0 {
            this.eds.items[n.edit].nl = this.mnodes.items[id].type == this.vTextarea;
            return n.edit;
        }
        let k = -1;
        for i in 0..this.eds.len {
            if k < 0 && this.eds.items[i].owner < 0 {
                k = i;
            }
        }
        if k < 0 {
            this.eds.push(Edit.new(this.mem));
            k = this.eds.len - 1;
        }
        let e = &this.eds.items[k];
        e.owner = id;
        e.nl = this.mnodes.items[id].type == this.vTextarea;
        e.lver = -1;
        e.clearUndo();
        e.rich = false;
        e.late = -1;
        e.sp.len = 0;
        e.dn = 0;
        e.px = -1.0;
        e.py = -1.0;
        e.ty = 0.0;
        e.gx = -1.0;
        e.clicks = 0;
        e.fcur = -1;
        n.edit = k;
        return k;
    }

    /// `placeholder`, copied (it is often a template string, which dies with the frame's `update`).
    fn attrPlaceholder(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        storeBytes(this, n, s);
        n.ph = ([]u8 { ptr: n.buf.ptr, len: n.tlen }) as string;
        this.syncPlaceholder(id);
    }

    /// `multiple` on a `<select>`.
    fn attrMultiple(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].multi = on;
    }

    /// The second thumb of a range slider (`high`, `bind:high`).
    fn attrHigh(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].high = v;
    }

    /// `<meter>` `low` (0), `high` (1) or `optimum` (2).
    fn attrMeter(this: &Dom, id: int, which: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if which == 0 { n.mlow = v; } else if which == 1 { n.mhigh = v; } else { n.mopt = v; }
    }

    /// `open` of a `<details>`. Applied when the attribute's value changes, not on every update, so a click that flipped
    /// the box stands until the program changes its mind (`bind:open` writes the click back first). A change of state the
    /// program makes fires `toggled` in the next frame's update; the first value a box gets does not fire.
    fn attrOpen(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let want = if on { 2 } else { 1 };
        if n.openSet == want {
            return;
        }
        let first = n.openSet == 0;
        n.openSet = want;
        if !first && this.isOpen(id) != on {
            n.togAt = this.frame + 1;
        }
        this.setOpen(id, on);
    }

    /// Open or close a `<details>` now: `:open`, its content shows or hides (the children stay mounted). Closing it drops the focus
    /// from content inside it (the summary keeps it).
    fn setOpen(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.setFlag(id, FL_OPEN, on);
        let f = this.focus;
        if !on && f >= 0 {
            let c = f;
            while c >= 0 && c != id && this.nodes.items[c].tag != this.tSummary {
                c = this.nodes.items[c].parent;
            }
            if c == id {
                this.focusNode(-1);
            }
        }
    }

    /// Whether `<details>` `id` is open.
    fn isOpen(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return (this.mnodes.items[id].flags / FL_OPEN) % 2 == 1;
    }

    /// `<details>` `id` changed state (a click on its `<summary>` this frame, or the program's `open` last frame): `on:toggle`,
    /// `bind:open`. Once per change.
    fn toggled(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].togAt == this.frame;
    }

    /// A click on the `<summary>` of `<details>` `id` flipped it this frame: `bind:open` writes the new state back (a state the program
    /// set is already in its variable, and a write-back could undo a newer change of the program's).
    fn userToggled(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].clkAt == this.frame;
    }

    /// The user changed the value of `id` this frame (typing, dragging, picking): write it back with
    /// `strValue`, `value` or `highValue`.
    fn changed(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        return n.chg == this.frame || (n.edit >= 0 && this.eds.items[n.edit].late == this.frame);
    }

    /// Enter was pressed in the text box `id` this frame.
    fn submitted(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].sub == this.frame;
    }

    /// The string value after a change (a view of the box's buffer, valid until the next change).
    fn strValue(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        return this.nodes.items[id].sval;
    }

    /// The range value after a change (the low thumb of a two-thumb slider).
    fn value(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        return this.nodes.items[id].value;
    }

    /// The high thumb after a change.
    fn highValue(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        return this.nodes.items[id].high;
    }

    /// `min`.
    fn attrMin(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrMin = v;
    }

    /// `max`.
    fn attrMax(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrMax = v;
    }

    /// `step`.
    fn attrStep(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrStep = v;
    }

    /// Set or clear a `css.FL_*` bit (hover, active, disabled) and restyle.
    fn setFlag(this: &Dom, id: int, flag: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].flags;
        let has = (cur / flag) % 2 == 1;
        if has == on {
            return;
        }
        if on {
            this.mnodes.items[id].flags = cur + flag;
        } else {
            this.mnodes.items[id].flags = cur - flag;
        }
        markStyle(this, id);
        markHas(this, id, 1, flag);
        if this.a11yOn {
            if flag == FL_CHECKED { aNote(this, EV_CHECKED, id); }
            if flag == FL_OPEN { aNote(this, EV_EXPANDED, id); }
        }
    }

    /// Restyle everything (after `css.reset()` and `parse` again, for hot reload).
    fn restyle(this: &Dom) {
        // overlay styles die with `css.reset()`; style ids restart, so a node can keep its id with new
        // values: lay everything out again
        for i in 0..this.nodes.len {
            if this.nodes.items[i].kind == K_ELEM {
                // meter colors were looked up for a style id that may now mean something else
                this.nodes.items[i].mcSt = -1;
                if this.nodes.items[i].tr >= 0 {
                    dropMotion(this, i);
                }
                markDirty(this, i);
            }
        }
        for i in 0..this.trs.len {
            motion.forget(&this.trs.items[i]);
        }
        // so do the `style:` styles; the next update sets every override again
        for i in 0..this.dyns.len {
            dynattr.forget(&this.dyns.items[i]);
        }
        if this.nodes.len > 0 {
            markStyle(this, 0);
        }
    }

    /// Scroll an `overflow-y` box by `dy` px, clamped to its range.
    fn scrollBy(this: &Dom, id: int, dy: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let nv = max(0.0, min(n.scrollMax, n.scrollY + dy));
        if nv != n.scrollY {
            scrollMark(this, id);
            n.scrollY = nv;
            scrolled(this);
        }
    }

    /// Scroll an `overflow-x` box by `dx` px, clamped to its range.
    fn scrollByX(this: &Dom, id: int, dx: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let nv = scroll.clampOff(n.scrollX, dx, n.scrollMaxX);
        if nv != n.scrollX {
            scrollMark(this, id);
            n.scrollX = nv;
            scrolled(this);
        }
    }

    /// Bring element `id` into view: every scroll box around it scrolls, nearest first, as little as needed (`block` = `SC_START`, `SC_CENTER`,
    /// `SC_END` or `SC_NEAREST` on y; x uses nearest). `scroll-padding` of the boxes and `scroll-margin` of the element count, a snap
    /// axis lands on a snap position. `smooth` animates (instant under reduced motion). Uses the last layout.
    fn scrollIntoView(this: &Dom, id: int, block: int, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        intoView(this, id, block, SC_NEAREST, smooth);
    }

    /// Like `scrollIntoView` with both modes: `block` on y, `inl` on x (a carousel item: `SC_CENTER` for `inl`).
    fn scrollIntoViewXY(this: &Dom, id: int, block: int, inl: int, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        intoView(this, id, block, inl, smooth);
    }

    /// Scroll box `id` to offset `(x, y)` (clamped; a snap axis goes to its nearest snap position); `smooth` animates.
    fn scrollTo(this: &Dom, id: int, x: f32, y: f32, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        goTo(this, id, x, y, smooth);
    }

    /// A handle for element `id`: its id plus the node's serial, so a freed and recycled id no longer matches. -1 for a free or unknown node.
    /// `bind:this` and `use:` hand these out. `focusNode`, `scrollIntoView(XY)`, `scrollTo`, `scrollBy(X)`, `size`, `absX` and `absY` take a
    /// handle or a plain id; for any other call use `node(h)`.
    fn handle(this: &Dom, id: int): int {
        if id < 0 || id >= this.nodes.len || this.nodes.items[id].kind == K_FREE {
            return -1;
        }
        return this.nodes.items[id].ser * HANDLE_UNIT + id;
    }

    /// The plain id behind handle `h`, -1 when the element is gone (or `h` is -1). A plain id passes through unchecked.
    fn node(this: &Dom, h: int): int {
        let id = this.resolve(h);
        if id == STALE {
            return -1;
        }
        return id;
    }

    /// Is the element behind handle `h` still in the tree?
    fn alive(this: &Dom, h: int): bool {
        return this.node(h) >= 0;
    }

    /// Does `buf[0..n]` hold the bytes of `s`? (`use:` compares a string parameter with the copy it kept.)
    fn strHas(this: &Dom, buf: []u8, n: int, s: string): bool {
        if n != s.len {
            return false;
        }
        for i in 0..n {
            if buf[i] != s[i] {
                return false;
            }
        }
        return true;
    }

    /// Copy `s` into `buf` (a bigger buffer from the Dom's arena when it does not fit: it only ever grows, so a parameter that changes
    /// every frame allocates nothing after the first few). The buffer comes back.
    fn strPut(this: &Dom, buf: []u8, s: string): []u8 {
        if buf.len < s.len {
            let cap = if s.len > 2 * buf.len { s.len } else { 2 * buf.len };
            if cap < 16 {
                cap = 16;
            }
            buf = this.mem.alloc::<u8>(cap);
        }
        for i in 0..s.len {
            buf[i] = s[i];
        }
        return buf;
    }

    fn resolve(this: &Dom, h: int): int {
        if h < HANDLE_UNIT {
            return h;
        }
        let id = h % HANDLE_UNIT;
        if id >= this.nodes.len || this.nodes.items[id].kind == K_FREE || this.nodes.items[id].ser != h / HANDLE_UNIT {
            return STALE;
        }
        return id;
    }

    /// The element with static `id="name"` (first in tree order), -1 for none. A walk of the live tree each call.
    fn byId(this: &Dom, name: string): int {
        return findId(this, name);
    }

    /// Scroll the virtual list in box `list` to the row with key `key` (`block` as `scrollIntoView`), even when the row is not built.
    /// False for an unknown list or key. The row shows once it is measured (variable heights aim again each frame until then).
    fn scrollToKey(this: &Dom, list: int, key: string, block: int): bool {
        return toKey(this, list, key, block);
    }

    /// `vlist.step` registers the virtual list of scroll box `id` (every frame).
    fn vlistBind(this: &Dom, id: int, v: &VList) {
        id = this.resolve(id);
        if id == STALE { return; }
        for i in 0..this.vlists.len {
            if this.vlists.items[i].node == id {
                this.vlists.items[i].vl = v;
                return;
            }
        }
        this.vlists.push(VListRef { node: id, vl: v });
    }

    /// Make `id` an overlay: `OV_MODAL` (a `<dialog modal>`: the page behind it takes no input, Tab stays
    /// inside, Escape asks to close) or `OV_POPOVER` (light dismiss: a press outside or Escape asks to
    /// close). Call it every frame the element is built; the element leaves the stack when it is
    /// removed. See `j3.ui.overlay`.
    fn attrOverlay(this: &Dom, id: int, kind: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.ov == 0 {
            this.ovs.push(Idx { v: id });
            n.ovFocus = this.focus;
            n.ovZ = OVERLAY_Z + mini(this.ovs.len - 1, 7);
        }
        n.ovContext = false;
        n.ovCaret = false;
        n.ctxPending = false;
        n.ov = kind;
    }

    /// Markup flags: 1 `autoselect` (a modal selects its first text box when it opens), 2 `on:submit` (this box handles Enter, so
    /// the dialog's default button does not), 3 `default` (the button Enter clicks in its dialog).
    fn attrFlag(this: &Dom, id: int, which: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if which == 1 { n.fAuto = true; } else if which == 2 { n.fSub = true; } else { n.fDef = true; }
    }

    /// A context popover is a conditional child of its request owner. Capture this frame only.
    fn attrContext(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let fresh = this.nodes.items[id].ov == 0;
        let pending = this.nodes.items[id].ctxPending;
        this.attrOverlay(id, OV_POPOVER);
        this.nodes.items[id].ovContext = true;
        let par = this.nodes.items[id].parent;
        if this.ctxNode >= 0 && inside(this, par, this.ctxNode) {
            this.attrLeft(id, this.ctxX);
            this.attrTop(id, this.ctxY);
        } else if fresh || pending {
            // The owner may itself be new: resolve only after its normal/absolute layout.
            this.nodes.items[id].ctxPending = true;
        }
    }

    /// A caret popover is a conditional child of a wrapper holding the text box: it hangs below the box's caret (above it when
    /// there is no room), follows it as the text wraps or scrolls, and never takes focus. The box is the one with an active
    /// trigger, else the focused one, inside the wrapper.
    fn attrCaret(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrOverlay(id, OV_POPOVER);
        let n = &this.nodes.items[id];
        n.ovCaret = true;
        let t = if this.trigNode >= 0 { this.trigNode } else { this.focus };
        if t >= 0 && t < this.nodes.len && this.nodes.items[t].kind == K_ELEM && inside(this, n.parent, t) && this.nodes.items[t].edit >= 0 {
            let r = this.caretRect(t);
            if r.x >= 0.0 {
                this.attrLeft(id, r.x);
                this.attrTop(id, r.y + r.h + 2.0);
                n.cth = r.h + 4.0;
            }
        }
    }

    /// The trigger of `on:trigger` changed this frame on `id` (or ended: `triggerText` is empty).
    fn triggered(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.trigEv == id && this.trigChg == this.frame;
    }

    /// The trigger text of the box with the active trigger, `@ja` (empty when it ended). A view of the box's text.
    fn triggerText(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        if this.trigNode != id || this.trigLo < 0 {
            return "";
        }
        let s = this.eds.items[this.claim(id)].str();
        return s[this.trigLo..this.trigHi];
    }

    /// `grid={g.sized(n)}`: `id` is the scroll box of data grid `g` (`j3.ui.grid`). Call it every frame it is built.
    fn gridBind(this: &Dom, id: int, g: &Grid) {
        id = this.resolve(id);
        if id == STALE { return; }
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                this.grids.items[i].g = g;
                this.grids.items[i].frame = this.frame;
                return;
            }
        }
        this.grids.push(GridRef { node: id, g: g, frame: this.frame });
    }

    /// The grid bound to box `id`.
    fn gridOf(this: &Dom, id: int): &Grid {
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                return this.grids.items[i].g;
            }
        }
        panic("gridOf: no grid on this element");
    }

    /// Is `id` the scroll box of a bound grid.
    fn isGrid(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                return true;
            }
        }
        return false;
    }

    /// The grid on box `id` began or committed an edit this frame (`on:edit`; `Grid.evKind` ...).
    fn gridEdit(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.isGrid(id) && this.gridOf(id).evFrame == this.frame;
    }

    /// `triggers` of a text box: the characters that start a trigger (default `@` and `:`).
    fn attrTriggers(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].trigs = s;
    }

    /// Delayed custom tooltip binding. The conditional popover must be a direct child.
    fn hoverCard(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        let over = this.rawHit >= 0 && inside(this, id, this.rawHit) && allowedByModal(this, this.rawHit);
        let held = false;
        let closed = false;
        let c = n.first;
        while c >= 0 {
            if this.nodes.items[c].ov == OV_POPOVER && !this.nodes.items[c].ovContext {
                held = held || (this.focus >= 0 && inside(this, c, this.focus));
                closed = closed || this.closeRequested(c);
            }
            c = this.nodes.items[c].next;
        }
        if closed { n.hcOpen = false; n.hcBlock = true; }
        if !over && !held {
            n.hcAt = -1.0;
            n.hcBlock = false;
            if n.hcLeave < 0.0 { n.hcLeave = this.now; }
            if this.now - n.hcLeave >= 300.0 { n.hcOpen = false; }
        } else {
            n.hcLeave = -1.0;
            if n.hcAt < 0.0 { n.hcAt = this.now; }
            if !n.hcBlock && this.now - n.hcAt >= uastyle.tipDelay(this.css) { n.hcOpen = true; }
        }
        // A modal opened above the owner must hide its card even while it holds focus.
        if !allowedByModal(this, id) { n.hcOpen = false; n.hcAt = -1.0; }
        return n.hcOpen;
    }

    /// `closedby` of an overlay: `"any"`, `"closerequest"` or `"none"` (default: a popover is `any`, a
    /// modal dialog `closerequest`).
    fn attrClosedBy(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let by = 2;
        if same(s, "any") {
            by = 1;
        } else if same(s, "none") {
            by = 3;
        }
        this.nodes.items[id].ovBy = by;
    }

    /// `title`: the tooltip text of `id` (copied).
    fn attrTitle(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !this.strHas(n.tipBuf, n.tipLen, s) { aNote(this, EV_NAME, id); }
        keep(this.mem, &n.tipBuf, &n.tipLen, s);
    }

    /// `aria-label`: the accessible name of `id` (copied).
    fn attrAria(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !this.strHas(n.ariaBuf, n.ariaLen, s) { aNote(this, EV_NAME, id); }
        keep(this.mem, &n.ariaBuf, &n.ariaLen, s);
    }

    /// `aria-live`: "polite", "assertive" or "off" (copied). A change of the element's text or children is queued for `a11y.liveChanges`.
    fn attrLive(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.liveLen == 0 && s.len > 0 {
            this.liveCount += 1;
        } else if n.liveLen > 0 && s.len == 0 {
            this.liveCount -= 1;
        }
        keep(this.mem, &n.liveBuf, &n.liveLen, s);
    }

    /// The `aria-live` of `id` ("" for none).
    fn liveOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.liveBuf.ptr, len: n.liveLen }) as string;
    }

    /// `aria-describedby`: the static `id`s (space separated) of the elements that describe `id` (copied).
    fn attrDescBy(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.descBuf, &n.descLen, s);
    }

    /// The `aria-describedby` ids of `id` ("" for none).
    fn descByOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.descBuf.ptr, len: n.descLen }) as string;
    }

    /// `aria-selected`: 0 unset, 1 false, 2 true (any selectable role: tab, option, row, listitem).
    fn attrSelected(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let want = if on { 2 } else { 1 };
        if this.nodes.items[id].asel != want {
            this.nodes.items[id].asel = want;
            aNote(this, EV_SELECTED, id);
        }
    }

    /// Ask the host for a frame from any thread (an AT thread that queued an action while the loop is idle). Atomic; nothing else is touched.
    fn requestFrame(this: &Dom) {
        @atomicAdd(&this.wake, 1);
    }

    /// The loop should run a frame now: something moves (`isLive`) or `requestFrame` was called since the last `wantsFrame`
    /// (this clears the request; main thread). `App` draws every frame today, so only a host that sleeps when idle needs it.
    fn wantsFrame(this: &Dom): bool {
        let w = @atomicLoad(&this.wake);
        if w > 0 {
            @atomicAdd(&this.wake, 0 - w);
        }
        return w > 0 || this.isLive();
    }

    /// `for` on a `<label>`: the `id` of the control it activates (copied).
    fn attrFor(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.forLen == 0 && s.len > 0 {
            this.forLabels += 1;
        }
        keep(this.mem, &n.forBuf, &n.forLen, s);
    }

    /// The `for` of label `id` ("" for none).
    fn forOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.forBuf.ptr, len: n.forLen }) as string;
    }

    /// `role`: overrides the role the tag implies (copied).
    fn attrRole(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.roleBuf, &n.roleLen, s);
    }

    /// The `aria-label` of `id` ("" for none).
    fn ariaOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.ariaBuf.ptr, len: n.ariaLen }) as string;
    }

    /// The `role` attribute of `id` ("" for none).
    fn roleOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.roleBuf.ptr, len: n.roleLen }) as string;
    }

    /// `panel` / `panel="dock"`: `id` is a draggable panel (`position: absolute` or `fixed`), one that
    /// docks when given `"dock"` (`j3.ui.panels`).
    fn attrPanel(this: &Dom, id: int, mode: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.pk != PK_PANEL {
            n.pk = PK_PANEL;
            // a recycled node id restarts its state; a dead panel's slot is reused
            let at = panelmath.slot(this.pans.items, this.pans.len, id);
            if at < 0 {
                this.pans.push(panelmath.fresh(id, same(mode, "dock")));
            } else {
                this.pans.items[at] = panelmath.fresh(id, same(mode, "dock"));
            }
        }
    }

    /// `panel-handle` (role `PK_HANDLE`) / `panel-resize` (`PK_GRIP`): dragging `id` moves / resizes its panel.
    fn attrPanelRole(this: &Dom, id: int, role: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].pk = role;
    }

    /// `draggable` / `draggable={bool}`.
    fn attrDraggable(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].draggable = on;
    }

    /// `on:dragenter` (1), `on:dragleave` (2), `on:dragover` (4) or `on:drop` (8) is on `id`: it is a drop target.
    fn attrDragTarget(this: &Dom, id: int, bit: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if (n.dragT / bit) % 2 == 0 {
            n.dragT += bit;
        }
    }

    /// `drag-ghost="none"`: the page draws its own drag image.
    fn attrDragGhost(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].noGhost = same(s, "none");
    }

    /// `drag-id`: the integer payload of a drag from `id`.
    fn attrDragId(this: &Dom, id: int, v: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].dragId = v;
    }

    /// `drag-data`: the text payload of a drag from `id` (copied).
    fn attrDragData(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.dgBuf, &n.dgLen, s);
    }

    /// The source whose payload handlers read: the one whose `dragend` is delivered this frame, else the current one.
    fn dragSrcNow(this: &Dom): int {
        return if this.drag.endAt == this.frame { this.drag.endN } else { this.drag.src };
    }

    /// The `drag-data` of the item being dragged ("" for none).
    fn dragData(this: &Dom): string {
        let s = this.dragSrcNow();
        if s < 0 || s >= this.nodes.len {
            return "";
        }
        let n = &this.nodes.items[s];
        return ([]u8 { ptr: n.dgBuf.ptr, len: n.dgLen }) as string;
    }

    /// The `drag-id` of the item being dragged (0 for none).
    fn dragIdOf(this: &Dom): int {
        let s = this.dragSrcNow();
        return if s < 0 || s >= this.nodes.len { 0 } else { this.nodes.items[s].dragId };
    }

    /// A drag started from `id` this frame.
    fn dragStarted(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.startAt == this.frame && this.drag.src == id;
    }

    /// A drag from `id` ended (the frame after the release, so after any `drop`), dropped or not. Not delivered when the page removed `id`.
    fn dragEnded(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.endAt == this.frame && this.drag.endN == id;
    }

    /// Whether the drag that ended this frame landed on an element with `on:drop`.
    fn dragDropped(this: &Dom): bool {
        return this.drag.dropped;
    }

    /// The dragged item came over `id` this frame.
    fn dragEntered(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.enterAt == this.frame && this.drag.enterN == id;
    }

    /// The dragged item left `id` this frame (moved off, or Escape).
    fn dragLeft(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.leaveAt == this.frame && this.drag.leaveN == id;
    }

    /// The dragged item is over `id` (every frame while it is).
    fn dragOver(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.overAt == this.frame && this.drag.overN == id;
    }

    /// The dragged item was released on `id` this frame.
    fn dropAt(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.dropAt == this.frame && this.drag.dropN == id;
    }

    /// `on:dragover` set `accept = false`: `id` is no target for this drag (no `:drop-target`, no `on:drop`) while the pointer stays on it.
    fn dragReject(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.drag.tgt == id && this.drag.rej != id {
            this.drag.rej = id;
            this.setFlag(id, FL_DROP, false);
        }
    }

    /// `menuitem`: `id` is a menu entry (focusable, Enter clicks it, Up/Down/Left/Right move between entries).
    fn attrMenuItem(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].mitem = true;
    }

    /// `tabindex="0"`: `id` is focusable like a button (a `button` role unless `role=` says otherwise).
    fn attrTabIndex(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].mitem = true;
        if this.nodes.items[id].roleLen == 0 {
            this.attrRole(id, "button");
        }
    }

    /// `tabindex="-1"`: like `tabindex="0"`, but Tab and the pad skip it (`focusNode` and a press still focus it).
    fn attrTabIndexOff(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrTabIndex(id);
        this.nodes.items[id].noTab = true;
    }

    /// `tabindex={v}` / a static positive value: `v < 0` skips Tab, `0` is tree order, `v > 0` goes first in ascending order.
    fn attrTabIndexN(this: &Dom, id: int, v: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrTabIndex(id);
        this.nodes.items[id].noTab = v < 0;
        this.nodes.items[id].tabIdx = if v > 0 { v } else { 0 };
    }

    /// `<img>` / `<svg>` / `<path>` string attributes (`media.M_*`: src, sprite, viewBox, d, fill, stroke).
    fn attrMedia(this: &Dom, id: int, what: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.media == 0 {
            n.media = media.acquire(&this.media) + 1;
        }
        if media.setStr(&this.media.items[n.media - 1], this.mem, what, s) {
            markDirty(this, id);
        }
    }

    /// Number attributes (`media.N_*`: frame, fps, stroke-width).
    fn attrMediaNum(this: &Dom, id: int, what: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.media == 0 {
            n.media = media.acquire(&this.media) + 1;
        }
        media.setNum(&this.media.items[n.media - 1], what, v);
    }

    /// Delete every cached image texture (they reload when next drawn).
    fn freeImages(this: &Dom) {
        media.freeAll(&this.imgs);
        for i in 0..this.media.len {
            this.media.items[i].need = this.media.items[i].used;
        }
    }

    /// Force the border-box size of panel `id` (-1 on an axis: back to its CSS).
    fn panelSize(this: &Dom, id: int, w: f32, h: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.ow != w || n.oh != h {
            n.ow = w;
            n.oh = h;
            markDirty(this, id);
        }
    }

    /// The dock zone of panel `id` (`panelmath.DOCK_*`; 0 when floating or not a panel).
    fn panelDock(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        let at = panelmath.find(this.pans.items, this.pans.len, id);
        return if at < 0 { 0 } else { this.pans.items[at].dock };
    }

    /// The `title` of `id` ("" for none).
    fn tipOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.tipBuf.ptr, len: n.tipLen }) as string;
    }

    /// `left` attribute: where a `position: fixed` or `absolute` box goes, in px (overrides the CSS).
    fn attrLeft(this: &Dom, id: int, x: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if !n.hasAtX || n.atx != x {
            n.hasAtX = true;
            n.atx = x;
            markDirty(this, id);
        }
    }

    /// `top` attribute (see `attrLeft`).
    fn attrTop(this: &Dom, id: int, y: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if !n.hasAtY || n.aty != y {
            n.hasAtY = true;
            n.aty = y;
            markDirty(this, id);
        }
    }

    /// The mouse in viewport px (what `left` / `top` take for a menu opened at the pointer).
    fn mouseAt(this: &Dom): Vec2 {
        return if this.ctxNode >= 0 { Vec2 { x: this.ctxX, y: this.ctxY } } else { Vec2 { x: this.mx, y: this.my } };
    }

    /// A close was asked of overlay `id` this frame (Escape on top of the stack, a press outside it).
    fn closeRequested(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].closeAt == this.frame;
    }

    /// The right button went down this frame on `id` or a descendant (a context menu request).
    fn contextAt(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let c = this.ctxNode;
        return c >= 0 && styleVisible(this, id) && styleVisible(this, c) && (c == id || isAncestor(this, id, c));
    }

    /// Feed the right button for the next `beginFrame`s (with `simInput`).
    fn simRight(this: &Dom, down: bool) {
        this.simOn = true;
        this.simR = down;
    }

    /// Resolve dirty styles and lay out the tree in a `w` by `h` viewport. Does nothing when no
    /// node changed and the size is the same.
    fn layoutAt(this: &Dom, w: f32, h: f32) {
        if this.css.setViewport(w, h) && this.nodes.len > 0 {
            // an `@media` condition flipped: restyle everything
            markStyle(this, 0);
            if this.css.vpUnits {
                // `vw` and friends change a length without changing its style: lay every box out again
                for i in 0..this.nodes.len {
                    this.nodes.items[i].dirty = true;
                }
            }
        }
        refreshOptionVisuals(this);
        resolveStyles(this);
        if this.focus >= 0 && !styleVisible(this, this.focus) { this.focusNode(-1); }
        stepMotion(this);
        if this.trns.len > 0 {
            stepSlides(this);
        }
        let r = &this.nodes.items[0];
        if r.dirty || !r.laid || r.basisW != w || r.basisH != h {
            layoutBox(this, 0, w, h, w, h);
            layoutAbs(this);
        }
        if this.flips.len > 0 {
            stepFlips(this, w, h);
        } else {
            this.flipLive = 0;
        }
    }

    /// Left edge in root coordinates (scroll offsets of the ancestors included).
    fn absX(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let x: f32 = 0.0;
        let c = id;
        while c >= 0 {
            x += this.nodes.items[c].x;
            if this.nodes.items[c].isFixed {
                break;
            }
            let p = this.nodes.items[c].parent;
            if p >= 0 {
                x -= this.nodes.items[p].scrollX;
            }
            c = p;
        }
        return x;
    }

    /// Top edge in root coordinates (scroll offsets of the ancestors included).
    fn absY(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let y: f32 = 0.0;
        let c = id;
        while c >= 0 {
            y += this.nodes.items[c].y + this.nodes.items[c].sy;
            if this.nodes.items[c].isFixed {
                break;
            }
            let p = this.nodes.items[c].parent;
            if p >= 0 {
                y -= this.nodes.items[p].scrollY;
            }
            c = p;
        }
        return y;
    }

    /// The text of a text node.
    fn textOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.buf.ptr, len: n.tlen }) as string;
    }

    // ---- frame, input, events (stage 05) ------------------------------------------------------------

    /// Offset the slots of a nested construct (a child component, an `{#each}` body) by its number `c`
    /// in the parent's sequence. Returns the token for `leave`. Slots stay local (below 4096).
    fn enter(this: &Dom, c: int): int {
        if c < 0 || c >= 4096 {
            panic("dom: enter number out of range (0..4095)");
        }
        if this.scale < 4096 {
            panic("dom: constructs nested too deep inside one element");
        }
        let tok = this.base;
        this.base = this.base + c * this.scale;
        this.scale = this.scale / 4096;
        return tok;
    }

    /// Undo `enter`.
    fn leave(this: &Dom, tok: int) {
        this.scale = this.scale * 4096;
        this.base = tok;
    }

    /// A new keyed `{#each}` row inside row `parent` (-1 at top level). An id comes back only after
    /// `groupFree` and once no node, ghost included, can still be taken for the old row's.
    fn groupNew(this: &Dom, parent: int): int {
        if this.gfree.len > 0 {
            this.gfree.len -= 1;
            let id = this.gfree.items[this.gfree.len].v;
            this.gpar.items[id].v = parent;
            this.gfirst.items[id].v = -1;
            return id;
        }
        this.gpar.push(Idx { v: parent });
        this.gfirst.push(Idx { v: -1 });
        this.gseen.push(Idx { v: 0 });
        return this.gpar.len - 1;
    }

    /// Row `uid` is destroyed (its nodes go this frame, fading ghosts a little later).
    fn groupFree(this: &Dom, uid: int) {
        this.gdead.push(Idx { v: uid });
    }

    /// Move dead row ids to the free list once no node (a fading ghost, or one of a row nested in it) can
    /// still be taken for the old row's. ponytail: one pass over the nodes on a frame where rows died.
    fn reclaimGroups(this: &Dom) {
        this.gstamp += 1;
        for i in 0..this.nodes.len {
            let k = this.nodes.items[i].gk;
            if this.nodes.items[i].kind == K_FREE {
                k = -1;
            }
            while k >= 0 && this.gseen.items[k].v != this.gstamp {
                this.gseen.items[k].v = this.gstamp;
                k = this.gpar.items[k].v;
            }
        }
        let keep = 0;
        for i in 0..this.gdead.len {
            let id = this.gdead.items[i].v;
            if this.gseen.items[id].v == this.gstamp {
                this.gdead.items[keep].v = id;
                keep += 1;
            } else {
                this.gfree.push(Idx { v: id });
            }
        }
        this.gdead.len = keep;
    }

    /// Start building keyed row `uid`: its nodes (kept together as a run) move here from wherever the
    /// last frame left them, so state, focus, scroll and transitions follow the row. Pair with `keyEnd`.
    fn keyBegin(this: &Dom, uid: int) {
        if this.gsp >= GROUP_DEPTH {
            panic("dom: keyed lists nested too deep");
        }
        let parent = this.stack[this.sp];
        let at = this.cursor[this.sp];
        let nxt = if at < 0 { this.nodes.items[parent].first } else { this.nodes.items[at].next };
        nxt = skipGhost(this, nxt);
        if nxt >= 0 && !inGroup(this, nxt, uid) {
            // Find the row's run from the hint `gfirst` (set when a node of the row is made and at `keyEnd`):
            // trusted only if it is a live child of `parent` still in the row, then walked back to the run's
            // start. -1 means the row never had a node (new row: nothing to move). A stale hint falls back
            // to scanning the siblings after `nxt`. Rows are contiguous runs, so both find the same start.
            let h = this.gfirst.items[uid].v;
            let s = -1;
            if h >= 0 {
                if h < this.nodes.len && this.nodes.items[h].kind != K_FREE && this.nodes.items[h].parent == parent && inGroup(this, h, uid) {
                    s = h;
                    while this.nodes.items[s].prev >= 0 && inGroup(this, this.nodes.items[s].prev, uid) {
                        s = this.nodes.items[s].prev;
                    }
                } else {
                    s = this.nodes.items[nxt].next;
                    while s >= 0 && !inGroup(this, s, uid) {
                        s = this.nodes.items[s].next;
                    }
                }
            }
            while s >= 0 && inGroup(this, s, uid) {
                let after = this.nodes.items[s].next;
                unlinkNode(this, s);
                insertBefore(this, parent, s, nxt);
                s = after;
            }
        }
        this.gstk[this.gsp] = uid;
        this.gsp += 1;
    }

    /// Done with the current keyed row: nodes it didn't visit this frame are removed.
    fn keyEnd(this: &Dom) {
        this.gsp -= 1;
        let uid = this.gstk[this.gsp];
        let at = this.cursor[this.sp];
        if at >= 0 && inGroup(this, at, uid) {
            this.gfirst.items[uid].v = at;
        }
        let c = if at < 0 { this.nodes.items[this.stack[this.sp]].first } else { this.nodes.items[at].next };
        while c >= 0 && inGroup(this, c, uid) {
            let nx = this.nodes.items[c].next;
            if !this.nodes.items[c].ghost {
                removeNode(this, c);
            }
            c = nx;
        }
    }

    /// `keyBegin` for the paint walk: `paintNext` stays inside row `uid`.
    fn paintGroup(this: &Dom, uid: int) {
        if this.pgsp >= GROUP_DEPTH {
            panic("dom: keyed lists nested too deep");
        }
        this.pgs[this.pgsp] = uid;
        this.pgsp += 1;
    }

    fn paintGroupEnd(this: &Dom) {
        this.pgsp -= 1;
    }

    /// Fixed clock step in ms per `beginFrame` (tests, `J3_FIXED_DT`); 0 follows `game.ticks()`.
    fn setFrameMs(this: &Dom, ms: f32) {
        this.fixedMs = ms;
    }

    /// The UI clock in ms: the same `now` that animations, transitions and `dt()` use, so it follows
    /// `setFrameMs` / `J3_FIXED_DT` (and is deterministic in goldens). Advances once per `beginFrame`.
    fn timeMs(this: &Dom): f32 {
        return this.now;
    }

    /// Something is moving without input: a transition or animation, a flip, wheel inertia, or a visible indeterminate `<progress>`
    /// (not under reduced motion). A host that drew only on change would keep drawing while this holds; `App` draws every frame today.
    fn isLive(this: &Dom): bool {
        return this.animating > 0 || this.flipLive > 0 || this.coasting > 0 || this.gaugeSeen > 0 || this.gaugeLive > 0 || this.snapPend > 0;
    }

    /// Feed synthetic mouse input (position in px, left button) instead of the real mouse, from the
    /// next `beginFrame`. `wheel` is added once. A click is a frame with `down` then one without.
    fn simInput(this: &Dom, x: f32, y: f32, down: bool, wheel: f32) {
        this.simOn = true;
        this.simX = x;
        this.simY = y;
        this.simDown = down;
        this.simWheel = this.simWheel + wheel;
    }

    /// Feed a synthetic keyboard to the next `beginFrame` (once): `typed` text and key names such as
    /// `"S+Left C+a Backspace"` (`j3.ui.keys.parse`). Headless tests and `UI_SIM`.
    fn simKeys(this: &Dom, typed: string, names: string) {
        this.simK = keys.parse(names, typed);
        this.simKOn = true;
    }

    /// Feed the gamepad (`j3.ui.padin.parse`, or a `PadRaw` from an action-set layer or Steam Input) instead of polling `j3.game`, from the
    /// next frame on and until `usePad(false)`. It is a state, not an event: it holds until you call this again.
    fn setPad(this: &Dom, p: PadRaw) {
        this.padOn = true;
        this.padRaw = p;
    }

    /// `false`: poll `j3.game` for pads again after `setPad`.
    fn usePad(this: &Dom, on: bool) {
        this.padOn = on;
        if !on { this.padRaw = PadRaw {}; }
    }

    /// The pad a `<glyph>` draws: `"xbox"` (default), `"playstation"`, `"nintendo"` or `"generic"` (anything else warns and keeps xbox).
    fn setGlyphStyle(this: &Dom, name: string) {
        glyphSetStyle(this, name);
    }

    /// Bind `action` (a name `<glyph action="...">` uses) to the key label `key` ("Space") and the pad button `pad` ("a", "b", "x", "y",
    /// "lb", "rb", "lt", "rt", "up", "down", "left", "right", "start", "select", "ls", "rs"); "" keeps the built-in for that device. A rebinding screen calls this.
    fn setGlyphBinding(this: &Dom, action: string, key: string, pad: string) {
        glyphBind(this, action, key, pad);
    }

    /// `<glyph action key pad>`: set the shown device and label of the element `id` just opened (generated code).
    fn glyph(this: &Dom, id: int, action: string, key: string, pad: string) {
        glyphBuild(this, id, action, key, pad);
    }

    /// `focus-group` (`"wrap"`, `"trap"`, `"arrows"`, one or more) or `nav-up|down|left|right` (`which` 0 group, 1 up, 2 down, 3 left, 4 right):
    /// static strings (`j3.ui.padnav`).
    fn attrNav(this: &Dom, id: int, which: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        // the update walk sets it every frame: nothing to do (and nothing allocated) when it is the same
        if same(this.navOf(id, which), s) { return; }
        let n = &this.nodes.items[id];
        let t = Text.new(this.mem);
        let i = 0;
        let cur = ([]u8 { ptr: n.navBuf.ptr, len: n.navLen }) as string;
        for f in 0..5 {
            let j = i;
            while j < cur.len && cur[j] != 59 { j += 1; }
            if f > 0 { t.push(59); }
            if f == which { t.pushStr(s); } else if i <= cur.len { t.pushStr(cur[i..j]); }
            i = j + 1;
        }
        keep(this.mem, &n.navBuf, &n.navLen, t.str());
    }

    /// Field `which` (0 group, 1 up, 2 down, 3 left, 4 right) of `id`'s `focus-group` / `nav-*` attributes ("" for none).
    fn navOf(this: &Dom, id: int, which: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        let cur = ([]u8 { ptr: n.navBuf.ptr, len: n.navLen }) as string;
        let i = 0;
        for f in 0..5 {
            let j = i;
            while j < cur.len && cur[j] != 59 { j += 1; }
            if f == which { return if i <= cur.len { cur[i..j] } else { "" }; }
            i = j + 1;
        }
        return "";
    }

    /// Turn the inspector (`j3.ui.inspect`) on or off; off by default, and `J3_INSPECT=1` also lets F12 toggle it. While on it takes the
    /// pointer and keys from the app. One bool check per frame when off.
    fn setInspector(this: &Dom, on: bool) {
        this.insp = on;
        this.inspPrev = this.down;
        dropPress(this);
        if !on { this.inspPin = -1; }
    }

    /// Seconds since the previous `beginFrame` (what `onFrame(dt)` gets): 0 on the first frame, at most 0.1,
    /// and exactly the step `setFrameMs` / `J3_FIXED_DT` set.
    fn dt(this: &Dom): f32 {
        if this.frame <= 1 {
            return 0.0;
        }
        return min(this.dtMs / 1000.0, 0.1);
    }

    /// Start a frame: advance the clock, snapshot the mouse, find the hit target in last frame's
    /// layout (hover, active, click, wheel scroll), then `begin()` the build.
    fn beginFrame(this: &Dom, size: Vec2) {
        this.frame += 1;
        this.gaugeSeen = this.gaugeLive;
        this.gaugeLive = 0;
        this.focusWas = this.focus;
        if this.gdead.len > 0 {
            this.reclaimGroups();
        }
        this.vw = size.x;
        this.vh = size.y;
        let fx = this.fixedMs;
        if fx <= 0.0 {
            // J3_FIXED_DT makes captures repeatable
            fx = game.fixedDt() * 1000.0;
        }
        if fx > 0.0 {
            this.now = this.now + fx;
        } else {
            this.now = f32(game.ticks());
        }
        this.pmx = this.mx;
        this.pmy = this.my;
        // the real button of the last frame, also when the inspector held it back from the app
        this.prevDown = if this.inspMasked { this.inspDown } else { this.down };
        this.inspMasked = false;
        this.dtMs = this.now - this.prevNow;
        this.prevNow = this.now;
        this.prevR = this.rdown;
        if this.simOn {
            this.rdown = this.simR;
            this.mx = this.simX;
            this.my = this.simY;
            this.down = this.simDown;
            this.wheelV = this.simWheel;
            this.simWheel = 0.0;
        } else {
            let p = game.mousePos();
            this.mx = p.x;
            this.my = p.y;
            this.down = game.mouseDown(Mouse.Left);
            this.rdown = game.mouseDown(Mouse.Right);
            this.wheelV = game.mouseWheel();
        }
        this.moved = this.mx != this.pmx || this.my != this.pmy;
        if this.simOn || this.simKOn {
            this.kin = if this.simKOn { this.simK } else { KeyIn {} };
            this.simKOn = false;
        } else {
            this.kin = keys.poll(&this.kbd, this.now);
        }
        if (this.inspHot || this.insp) && this.kin.f12 {
            this.insp = !this.insp;
            this.inspPrev = this.down;
            dropPress(this);
        }
        if this.insp {
            // the inspector takes the pointer and keys (`j3.ui.inspect.input` reads them); the app sees an idle frame
            this.inspMasked = true;
            this.inspIn = this.kin;
            this.inspWheel = this.wheelV;
            this.inspDown = this.down;
            this.kin = KeyIn {};
            this.wheelV = 0.0;
            this.down = false;
            this.rdown = false;
        }
        if this.reveal >= 0 {
            // a key moved the focus: keep it on screen (last frame's layout)
            let r = this.reveal;
            this.reveal = -1;
            if r == this.focus { intoView(this, r, SC_NEAREST, SC_NEAREST, false); }
        }
        inputEvents(this);
        this.begin();
    }

    /// After the build walk: removes unvisited root children, resolves styles, lays out in the
    /// `beginFrame` size, and rewinds the paint walk. Nothing runs when nothing changed.
    fn layout(this: &Dom) {
        this.end();
        this.layoutAt(this.vw, this.vh);
        if this.snapDirty { resnap(this); }
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.psp = 0;
        this.pgsp = 0;
        this.pst[0] = 0;
        this.pcu[0] = -1;
        this.ptarget[0] = -1;
        this.pz[0] = 0;
        this.hidden = 0;
    }

    /// After the paint walk: drops ghosts whose fade-out has finished.
    fn endFrame(this: &Dom) {
        if this.rip.n > 0 {
            ripple.prune(&this.rip, this.now, -1);
        }
        if this.ghosts > 0 {
            for i in 0..this.nodes.len {
                let n = &this.nodes.items[i];
                if n.kind == K_ELEM && n.ghost && n.pe == 0 && this.now - n.ghostT0 >= this.trns.items[n.trn].outMs {
                    dropNode(this, i);
                }
            }
        }
    }

    /// Give element `id` `animate:flip={ms}` with timing function `ease` (a `Css.eases` index): when a
    /// layout puts it somewhere else, it paints from the old place and glides to the new one.
    fn flip(this: &Dom, id: int, ms: f32, ease: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.flip < 0 {
            n.flip = this.flips.len;
            this.flips.push(Flip { node: id, ms: ms, ease: ease, seen: false, x: 0.0, y: 0.0, ox: 0.0, oy: 0.0, ox0: 0.0, oy0: 0.0, t0: 0.0 });
        }
        let f = &this.flips.items[n.flip];
        f.ms = ms;
        f.ease = ease;
    }

    /// `prefers-reduced-motion: reduce` holds (the program's setting, default off; `J3_REDUCED_MOTION=1` starts it on). Re-tests
    /// `@media` once; the built-in motion (flip, enter / leave transitions, ripple, smooth wheel scroll) stops. CSS `transition` /
    /// `animation` keep running unless the stylesheet turns them off under the media query.
    fn setReducedMotion(this: &Dom, on: bool) {
        this.setPrefs(on, this.css.dark);
    }

    /// `prefers-color-scheme: dark` holds when `dark` (default light; `J3_COLOR_SCHEME=dark` starts dark). Re-tests `@media` once.
    fn setColorScheme(this: &Dom, dark: bool) {
        this.setPrefs(this.css.reduced, dark);
    }

    fn reducedMotion(this: &Dom): bool { return this.css.reduced; }
    fn darkScheme(this: &Dom): bool { return this.css.dark; }

    fn setPrefs(this: &Dom, reduced: bool, dark: bool) {
        let was = this.css.reduced;
        if this.css.setPrefs(reduced, dark) && this.nodes.len > 0 {
            markStyle(this, 0);
        }
        if reduced && !was {
            // motion in flight ends now: leaving ghosts, ripples, flips and wheel inertia
            for i in 0..this.nodes.len {
                let n = &this.nodes.items[i];
                if n.kind == K_ELEM && n.ghost && n.trn >= 0 {
                    n.ghostT0 = this.now - this.trns.items[n.trn].outMs;
                }
                n.velX = 0.0;
                n.velY = 0.0;
            }
            for i in 0..this.flips.len {
                let f = &this.flips.items[i];
                f.ox0 = 0.0;
                f.oy0 = 0.0;
                f.ox = 0.0;
                f.oy = 0.0;
            }
            this.flipLive = 0;
            this.coasting = 0;
            this.rip.n = 0;
        }
    }

    /// The paint offset of an `animate:flip` flight on `id` (0 when none): its box and subtree are drawn this far from the layout position.
    fn flipDx(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let f = this.nodes.items[id].flip;
        return if f >= 0 { this.flips.items[f].ox } else { 0.0 };
    }

    fn flipDy(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let f = this.nodes.items[id].flip;
        return if f >= 0 { this.flips.items[f].oy } else { 0.0 };
    }

    /// Give element `id` enter / leave transitions (`Trans`; kind 0 is none): it plays `inK` when created this frame,
    /// and stays as a ghost (in the tree, no input) playing `outK` when its `{#if}` branch is left or its keyed row removed.
    fn trans(this: &Dom, id: int, inK: int, inMs: f32, outK: int, outMs: f32, ease: int, fx: f32, fy: f32, sf: f32, axis: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if inMs <= 0.0 { inK = 0; }
        if outMs <= 0.0 { outK = 0; }
        if n.trn < 0 {
            n.trn = this.trns.len;
            this.trns.push(Trans { node: id, inK: 0, inMs: 0.0, outK: 0, outMs: 0.0, ease: 0, fx: 0.0, fy: 0.0, sf: 0.0, axis: 0, sliding: false });
            if inK != 0 && n.born == this.frame {
                n.fadeT0 = this.now;
            }
        }
        let t = &this.trns.items[n.trn];
        t.inK = inK;
        t.inMs = inMs;
        t.outK = outK;
        t.outMs = outMs;
        t.ease = ease;
        t.fx = fx;
        t.fy = fy;
        t.sf = sf;
        t.axis = axis;
    }

    /// The kind, shown amount, fly offset and scale of the transition running on `id` (see `Trans`; for tests and hit testing).
    fn trKind(this: &Dom, id: int): int { id = this.resolve(id); if id == STALE { return -1; } return transKind(this, id); }
    fn trAmt(this: &Dom, id: int): f32 { id = this.resolve(id); if id == STALE { return 0.0; } return transAmt(this, id); }
    fn trDx(this: &Dom, id: int): f32 { id = this.resolve(id); if id == STALE { return 0.0; } return transDx(this, id); }
    fn trDy(this: &Dom, id: int): f32 { id = this.resolve(id); if id == STALE { return 0.0; } return transDy(this, id); }
    fn trScale(this: &Dom, id: int): f32 { id = this.resolve(id); if id == STALE { return 0.0; } return transScale(this, id); }

    /// `transition:fade={ms}` on `id`: `trans` with a linear fade both ways.
    fn fade(this: &Dom, id: int, ms: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.trans(id, 1, ms, 1, ms, -1, 0.0, 0.0, 0.5, 0);
    }

    /// Move focus to `id` (-1 clears it): `:focus` matches it. A press focuses the `button` or
    /// `input` under the mouse, or clears focus when it lands elsewhere.
    fn focusNode(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if id >= 0 && !styleVisible(this, id) { return; }
        if id == this.focus {
            return;
        }
        let old = this.focus;
        if old >= 0 {
            this.setFlag(old, FL_FOCUS, false);
            this.setFlag(old, FL_FOCUS_VIS, false);
        }
        this.focus = id;
        aNote(this, EV_FOCUS, id);
        if id >= 0 {
            this.setFlag(id, FL_FOCUS, true);
            // browsers: keyboard focus shows, mouse focus does not, a text box always does
            if this.keyMode || isField(this, id) {
                this.setFlag(id, FL_FOCUS_VIS, true);
            }
            focusWithin(this, id, true, -1);
            if this.keyMode {
                this.reveal = id;
            }
        }
        // only the two parent chains restyle, and the part they share is not touched at all
        if old >= 0 {
            focusWithin(this, old, false, id);
        }
    }

    /// The last input was the keyboard (`true`: Tab, keys, a gamepad) or a pointer press (`false`). A focus that moves is
    /// `:focus-visible` when this is true; a key (`true`) also shows the ring on the node that already has focus, as in a browser
    /// (one restyle). `j3.ui.inputs` sets it from keys and presses, a gamepad layer calls it too. In one frame the press is
    /// handled by `beginFrame` and the keys by `inputs.begin`, so a press and a key together end in keyboard mode, ring on.
    fn setKeyboard(this: &Dom, on: bool) {
        this.keyMode = on;
        if on && this.focus >= 0 {
            this.setFlag(this.focus, FL_FOCUS_VIS, true);
        }
    }

    /// Whether the last input was the keyboard (see `setKeyboard`).
    fn keyboard(this: &Dom): bool {
        return this.keyMode;
    }

    /// The focused element matches `:focus-visible` (false with no focus).
    fn focusVisible(this: &Dom): bool {
        return this.focus >= 0 && (this.mnodes.items[this.focus].flags / FL_FOCUS_VIS) % 2 == 1;
    }

    /// The element with focus, or -1.
    fn focused(this: &Dom): int {
        return this.focus;
    }

    /// Delay `id`'s CSS `animation` by `ms` more (the markup attribute `anim-delay`), to stagger a list.
    fn animDelay(this: &Dom, id: int, ms: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].adelay = ms;
    }

    /// Box size in px.
    fn size(this: &Dom, id: int): Vec2 {
        id = this.resolve(id);
        if id == STALE { return Vec2 { x: 0.0, y: 0.0 }; }
        return Vec2 { x: this.nodes.items[id].w, y: this.nodes.items[id].h };
    }

    /// The press and release both landed on `id` (or a descendant of it, like a browser's bubbling)
    /// this frame, and the target was not disabled.
    fn clicked(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return styleVisible(this, id) && (clickHit(this, this.clickNode, id) || clickHit(this, this.clickTo, id));
    }

    /// The left button went down this frame with `id` itself as the hit target (a child on top
    /// swallows it).
    fn mouseDown(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return hitIs(this, this.downHit, id);
    }

    /// The left button went up this frame over `id` itself.
    fn mouseUp(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return hitIs(this, this.upHit, id);
    }

    /// The mouse moved this frame and `id` itself is under it.
    fn mouseMove(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.moved && hitIs(this, this.hover, id);
    }

    /// Wheel movement this frame when `id` itself is under the mouse (0 otherwise).
    fn wheelAt(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        if hitIs(this, this.hover, id) {
            return this.wheelV;
        }
        return 0.0;
    }

    /// Mouse position relative to the top left of `id`'s border box.
    fn localMouse(this: &Dom, id: int): Vec2 {
        id = this.resolve(id);
        if id == STALE { return Vec2 { x: 0.0, y: 0.0 }; }
        return Vec2 { x: this.mx - this.absX(id), y: this.my - this.absY(id) };
    }

    /// A press that began on `id` is held (or ended this frame): a range input being dragged.
    fn dragging(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.dragNode == id;
    }

    /// The range value under the mouse, clamped to `min`..`max` and snapped to `step`.
    fn rangeValue(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let n = &this.nodes.items[id];
        let r = n.h / 2.0;
        let span = n.w - 2.0 * r;
        let t: f32 = 0.0;
        if span > 0.0 {
            t = (this.mx - this.absX(id) - r) / span;
        }
        if t < 0.0 {
            t = 0.0;
        }
        if t > 1.0 {
            t = 1.0;
        }
        let v = n.attrMin + t * (n.attrMax - n.attrMin);
        if n.attrStep > 0.0 {
            let k = (v - n.attrMin) / n.attrStep + 0.5;
            v = n.attrMin + f32(int(k)) * n.attrStep;
        }
        return max(n.attrMin, min(n.attrMax, v));
    }

    // ---- paint walk ------------------------------------------------------------------------------

    /// Reset the paint walk to the root (every pass starts here).
    fn paintStart(this: &Dom) {
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.psp = 0;
        this.pgsp = 0;
        this.pcu[0] = -1;
        this.ptarget[0] = -1;
        this.pz[0] = 1;
        this.hidden = 0;
        this.pflat = false;
    }

    /// Bring the stacking lists (`Node.ctx`, `Node.lift`, the entries of each context) up to date with the tree; `paintAll` does it
    /// itself, and nothing is rebuilt when the tree is the one they were built for.
    fn stack(this: &Dom) {
        ensureStack(this);
    }

    /// Paint the whole page: the root stacking context, then (recursively) its entries in z order (`dom/stack.j3`). Boxes are
    /// painted from the tree; a `<canvas>` body is the generated component's, reached through the hook the generated `render` sets
    /// (`setPaintHook`). Overlays and popups come last, above everything (`inputs.overlay`).
    fn paintAll(this: &Dom) {
        if this.nodes.len == 0 {
            return;
        }
        ensureStack(this);
        this.paintStart();
        paintNode(this, 0);
    }

    /// The generated component paints `<canvas>` bodies through `fn(self)`.
    fn setPaintHook(this: &Dom, f: fn(ptr), self: ptr) {
        this.hook = f;
        this.hookSelf = self;
        this.hookOn = true;
    }

    /// The child of the paint walk's current element to enter next when it was built at `slot`, -1 for any other. Only a `<canvas>`
    /// replay (`runCanvas`) walks the generated code, and it follows the path to the canvas and nothing else; boxes, text and ghosts are
    /// painted from the tree.
    fn paintNext(this: &Dom, slot0: int): int {
        let target = this.ptarget[this.psp];
        if !this.rpOn || target < 0 {
            return -1;
        }
        let g = if this.pgsp > 0 { this.pgs[this.pgsp - 1] } else { -1 };
        if this.pcu[this.psp] == this.nodes.items[target].prev && this.nodes.items[target].slot == realSlot(this, slot0) && (g < 0 || inGroup(this, target, g)) {
            return target;
        }
        return -1;
    }

    /// Children passes of the generated walk: one, except in a replay, where the walk goes on only along the path to the canvas.
    fn paintChildren(this: &Dom, pass: int): bool {
        if this.rpOn {
            return pass == 0 && this.ptarget[this.psp] >= 0;
        }
        return pass == 0;
    }

    /// Paint `id`'s own box (background, border, radius, opacity, transform, clip, controls, text)
    /// and start its children. Always pair with `paintEnd`. In a replay it only follows the path (nothing is pushed or drawn).
    fn paintBox(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.rpOn {
            this.psp += 1;
            this.pst[this.psp] = id;
            this.rpI += 1;
            let nx = if this.rpI < this.rpLen { this.rpc[this.rpI] } else { -1 };
            this.ptarget[this.psp] = nx;
            this.pcu[this.psp] = if nx >= 0 { this.nodes.items[nx].prev } else { -1 };
            this.pv[2 * this.psp] = this.base;
            this.pv[2 * this.psp + 1] = this.scale;
            this.base = 0;
            this.scale = SLOT_UNIT;
            return;
        }
        paintOpen(this, id, true);
    }

    /// Finish `id`: paints trailing text children, pops what `paintBox` pushed.
    fn paintEnd(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.rpOn {
            this.base = this.pv[2 * this.psp];
            this.scale = this.pv[2 * this.psp + 1];
            this.psp -= 1;
            this.pcu[this.psp] = id;
            this.rpI -= 1;
            return;
        }
        paintClose(this, id);
    }

    /// Start a `<canvas>` body: flush, and point `game` and `paint` draws at the box (`0,0` is its
    /// corner, `size(id)` is its size). False when it is hidden or empty (skip the body and
    /// `endCanvas`), or when it is not the canvas a replay was started for.
    fn beginCanvas(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        if this.rpOn {
            if id != this.rpT {
                return false;
            }
        } else if !paintVisible(this, id) || this.hidden > 0 || n.w < 1.0 || n.h < 1.0 || this.pz[this.psp] != 1 {
            return false;
        }
        paint.pushView(Vec2 { x: this.absX(id), y: this.absY(id) }, Vec2 { x: n.w, y: n.h });
        paint.pushIdentity();
        return true;
    }

    /// End a `<canvas>` body.
    fn endCanvas(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        paint.popTransform();
        paint.popView();
    }

    /// The runtime popup root (`j3.ui.popnode`) of `owner` (it takes the owner's style scope, so the owner's component
    /// `<style>` rules reach it, and the nodes built under it should too): a child the build walk leaves alone (`Node.rt`),
    /// always `position: fixed` on its own paint layer above the page and the modals (`OVERLAY_Z + 8`, or its
    /// `z-index`). One at a time (`ptRoot`); asking again for the same owner returns it, another owner replaces it.
    fn popRoot(this: &Dom, owner: int, tag: int): int {
        return this.runtimeRoot(owner, tag, false);
    }

    /// Independent passive tooltip slot; shares the runtime subtree lifetime/build rules.
    fn tipRoot(this: &Dom, owner: int, tag: int): int {
        return this.runtimeRoot(owner, tag, true);
    }

    fn runtimeRoot(this: &Dom, owner: int, tag: int, tip: bool): int {
        let id = if tip { this.ttRoot } else { this.ptRoot };
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt && this.nodes.items[id].tag == tag && this.nodes.items[id].parent == owner {
            return id;
        }
        if tip { this.dropTip(); } else { this.dropRoot(); }
        id = newNode(this, K_ELEM, tag, 0, this.mnodes.items[owner].scope);
        insertBefore(this, owner, id, -1);
        let n = &this.nodes.items[id];
        n.rt = true;
        n.ovZ = OVERLAY_Z + if tip { 9 } else { 8 };
        if tip { this.ttRoot = id; } else { this.ptRoot = id; }
        return id;
    }

    /// Remove the runtime popup subtree, if any.
    fn dropRoot(this: &Dom) {
        let id = this.ptRoot;
        this.ptRoot = -1;
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt {
            dropNode(this, id);
        }
    }

    /// Remove the tooltip without disturbing an open select or color panel.
    fn dropTip(this: &Dom) {
        let id = this.ttRoot;
        this.ttRoot = -1;
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt {
            dropNode(this, id);
        }
    }

    /// Point the build API (`open`, `text`, `cls`, ...) at the children of `root` until `buildOut`; the walk of
    /// the generated update is saved and comes back untouched.
    fn buildIn(this: &Dom, root: int) {
        this.rtSv[0] = this.sp;
        this.rtSv[1] = this.stack[0];
        this.rtSv[2] = this.cursor[0];
        this.rtSv[3] = this.base;
        this.rtSv[4] = this.scale;
        this.rtSv[5] = this.gsp;
        this.sp = 0;
        this.stack[0] = root;
        this.cursor[0] = -1;
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.gsp = 0;
    }

    /// End `buildIn`: children of the root that were not visited are removed.
    fn buildOut(this: &Dom) {
        trimTail(this, this.stack[0], this.cursor[0]);
        this.sp = this.rtSv[0];
        this.stack[0] = this.rtSv[1];
        this.cursor[0] = this.rtSv[2];
        this.base = this.rtSv[3];
        this.scale = this.rtSv[4];
        this.gsp = this.rtSv[5];
    }

    /// Paint the runtime popup `id` above everything painted so far (call after the generated paint walk). A box that is no stacking
    /// context (a dragged item) paints in tree order, positioned descendants included.
    fn paintDetached(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        ensureStack(this);
        this.paintStart();
        this.pflat = !this.nodes.items[id].ctx;
        paintNode(this, id);
        this.pflat = false;
    }

    /// Live nodes (ids in use).
    fn count(this: &Dom): int {
        return this.nodes.len - this.free.len;
    }
}
