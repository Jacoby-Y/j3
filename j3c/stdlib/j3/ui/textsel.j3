/// Selecting static text (`user-select: text`): press and drag across text nodes, double-click a word, triple-click a
/// block, Shift+click extends, Ctrl+A selects all (the top modal only when one is open), Ctrl+C copies. Run once per
/// frame by `j3.ui.inputs.begin`. The selection is two ends (`Dom.selA/selAo`, `selF/selFo`: text node and
/// byte offset); each frame the nodes in between get their selected byte range (`Node.sa..sb`), which
/// `dom.paintSel` highlights. Opt-in: only text whose computed `user-select` is `text` takes part, and a press
/// on a control (button, input, select, `menuitem`) never starts one. Offsets follow logical order; picks and highlights use the same visual run helpers as painted text.

module j3.ui.textsel;

use j3.game;
use j3.game.fontLine;
use j3.math.{ abs, max, min, maxi, mini };
use j3.ui.css.P_USER_SELECT;
use j3.ui.dom;
use j3.ui.dom.{ Dom, fontOf, enterText, enterTextNode, isBold, isField, leaveText, K_ELEM, K_TEXT };
use j3.ui.popup;
use j3.ui.textedit.wordRange;
use j3.ui.textfit.{ cpLen, fitPrefix };
use j3.game.textWidth;

const KW_TEXT: int = 2;

/// Whether text node `tn` takes part in selection.
fn selectable(d: &Dom, tn: int): bool {
    let n = &d.nodes.items[tn];
    return dom.paintVisible(d, tn) && n.kind == K_TEXT && n.style >= 0 && dom.kwOf(d, n.style, P_USER_SELECT) == KW_TEXT;
}

/// Next node after `id` in document order (children first), -1 at the end.
fn after(d: &Dom, id: int): int {
    let c = d.nodes.items[id].first;
    if c >= 0 {
        return c;
    }
    let x = id;
    while x >= 0 {
        let nx = d.nodes.items[x].next;
        if nx >= 0 {
            return nx;
        }
        x = d.nodes.items[x].parent;
    }
    return -1;
}

struct Pick {
    node: int;
    off: int;
}

/// The selectable text position nearest to window point (x, y), over the fragments of the whole tree.
fn pick(d: &Dom, x: f32, y: f32): Pick {
    let best = Pick { node: -1, off: 0 };
    let bf = -1;
    let bo = -1;
    let bs: f32 = 0.0;
    let id = 0;
    while id >= 0 && d.nodes.len > 0 {
        let ow = &d.nodes.items[id];
        if ow.frag0 >= 0 && ow.disp != dom.DP_NONE {
            let ax = d.absX(id);
            let ay = d.absY(id);
            let lsx: f32 = 0.0;
            let lsy: f32 = 0.0;
            if ow.kind == K_ELEM && dom.isScroll(d, ow.style) {
                lsx = ow.scrollX;
                lsy = ow.scrollY;
            }
            let f = ow.frag0;
            while f >= 0 {
                let g = &d.frags.items[f];
                if g.kind == 0 && selectable(d, g.node) {
                    let gf = fontOf(d, d.nodes.items[g.node].style);
                    let x0 = ax + g.x - lsx;
                    let y0 = ay + g.y - lsy;
                    let h = f32(fontLine(gf));
                    let dy: f32 = 0.0;
                    if y < y0 { dy = y0 - y; } else if y > y0 + h { dy = y - y0 - h; }
                    let dx: f32 = 0.0;
                    if x < x0 { dx = x0 - x; } else if x > x0 + g.w { dx = x - x0 - g.w; }
                    let score = dy * 10000.0 + dx;
                    if bf < 0 || score < bs {
                        bf = f;
                        bo = id;
                        bs = score;
                    }
                }
                f = g.next;
            }
        }
        id = after(d, id);
    }
    if bf < 0 {
        return best;
    }
    let fr = d.frags.items[bf];
    let tn = &d.nodes.items[fr.node];
    let o = &d.nodes.items[bo];
    let sx: f32 = 0.0;
    if o.kind == K_ELEM && dom.isScroll(d, o.style) {
        sx = o.scrollX;
    }
    let cx = max(0.0, min(x - (d.absX(bo) + fr.x - sx), fr.w));
    let whole = dom.shownText(d, fr.node);
    let seg = whole[fr.start..fr.end];
    let font = fontOf(d, tn.style);
    let bold = isBold(d, tn.style);
    let tm = enterTextNode(d, fr.node);
    let p = game.textIndexAt(font, seg, bold, cx);
    if p < 0 {
        p = fitPrefix(font, bold, seg, cx);
        if p < seg.len {
            let q = p + cpLen(seg, p);
            if cx - textWidth(font, seg[0..p], bold) > textWidth(font, seg[0..q], bold) - cx { p = q; }
        }
    }
    leaveText(tm);
    if seg.len == 1 && (seg[0] == 9 || seg[0] == 10 || seg[0] == 13 || seg[0] == 32) { p = if cx < fr.w / 2.0 { 0 } else { 1 }; }
    best.node = fr.node;
    best.off = fr.start + p;
    return best;
}

/// Set `Node.sa/sb` on every text node: the selected range, or -1. A selection whose end node left the tree is dropped.
fn mark(d: &Dom) {
    let inside = false;
    let found = 0;
    let id = 0;
    let hasSel = active(d); // a collapsed anchor marks nothing (and clears old marks once)
    while id >= 0 && d.nodes.len > 0 {
        let n = &d.nodes.items[id];
        n.sa = -1;
        n.sb = -1;
        if hasSel && n.kind == K_TEXT && n.disp != dom.DP_NONE && !n.ghost {
            let isA = id == d.selA;
            let isF = id == d.selF;
            let a = 0;
            let b = n.tlen;
            if isA && isF {
                a = mini(d.selAo, d.selFo);
                b = maxi(d.selAo, d.selFo);
                found = 2;
                n.sa = a;
                n.sb = mini(b, n.tlen);
                if !selectable(d, id) { n.sa = -1; n.sb = -1; }
            } else if isA || isF {
                let off = if isA { d.selAo } else { d.selFo };
                found += 1;
                if !inside {
                    inside = true;
                    a = off;
                } else {
                    inside = false;
                    b = off;
                }
                if selectable(d, id) {
                    n.sa = mini(a, n.tlen);
                    n.sb = mini(b, n.tlen);
                }
            } else if inside && selectable(d, id) {
                n.sa = 0;
                n.sb = n.tlen;
            }
        }
        id = after(d, id);
    }
    d.selMarked = hasSel;
    if hasSel && found < 2 {
        d.selA = -1;
        d.selF = -1;
        d.selDrag = false;
        mark(d);
    }
}

/// Last painted byte of `tn`, or zero when layout omitted it (clamp/ellipsis/display).
fn visibleEnd(d: &Dom, tn: int): int {
    let owner = tn;
    let end = 0;
    while owner >= 0 {
        let f = d.nodes.items[owner].frag0;
        while f >= 0 {
            let fr = &d.frags.items[f];
            if fr.kind == 0 && fr.node == tn { end = maxi(end, fr.end); }
            f = fr.next;
        }
        if end > 0 { return end; }
        owner = d.nodes.items[owner].parent;
    }
    return end;
}

/// The block that owns the line fragments of text node `tn` (inline spans share their block's).
fn ownerOf(d: &Dom, tn: int): int {
    let o = tn;
    while o >= 0 && d.nodes.items[o].frag0 < 0 { o = d.nodes.items[o].parent; }
    return o;
}

/// The selected text, pieces from different blocks on separate lines.
pub fn selected(d: &Dom): string {
    d.selBuf.clear();
    let lastParent = -2;
    // a collapsed space layout dropped at the end of a piece ("ab " before a span): kept as one space if text follows in the same block
    let gap = false;
    // a `<br>` between two selected pieces of one block is a line break in the copy
    let brk = false;
    let id = 0;
    while id >= 0 && d.nodes.len > 0 {
        let n = &d.nodes.items[id];
        if n.tag == d.tBr && lastParent != -2 && n.disp != dom.DP_NONE {
            brk = true;
        }
        if selectable(d, id) && n.kind == K_TEXT && n.sa >= 0 && n.sa < n.sb {
            let end = mini(n.sb, visibleEnd(d, id));
            if n.sa >= end { id = after(d, id); continue; }
            let ow = ownerOf(d, id);
            if lastParent != -2 && (ow != lastParent || brk) {
                d.selBuf.pushStr("\n");
            } else if gap {
                d.selBuf.pushStr(" ");
            }
            lastParent = ow;
            brk = false;
            let whole = []u8 { ptr: n.buf.ptr, len: n.tlen };
            d.selBuf.pushStr((whole[n.sa..end]) as string);
            gap = end < n.sb && whole[end] == 32 && whole[n.sb - 1] == 32;
        }
        id = after(d, id);
    }
    return d.selBuf.str();
}

/// Whether a static selection exists (a collapsed anchor from a plain click is not one).
pub fn active(d: &Dom): bool {
    return d.selA >= 0 && !(d.selA == d.selF && d.selAo == d.selFo);
}

/// Clear the selection.
pub fn clear(d: &Dom) {
    d.selA = -1;
    d.selF = -1;
    d.selDrag = false;
}

/// One frame: start, extend or drop the selection from the pointer, copy on Ctrl+C, refresh the marks.
pub fn step(d: &Dom) {
    if d.down && !d.prevDown {
        let r = d.downHit;
        let start = false;
        if r >= 0 && r < d.nodes.len && dom.focusableAt(d, r) < 0 {
            let p = pick(d, d.mx, d.my);
            // the press must land on the selectable text itself (not on a box beside it)
            if p.node >= 0 && d.nodes.items[p.node].parent >= 0 && inRange(d, p.node, r) {
                start = true;
                let again = d.now - d.selCt < 400.0 && abs(d.mx - d.selCx) < 4.0 && abs(d.my - d.selCy) < 4.0;
                d.selClicks = if again && d.selClicks < 3 { d.selClicks + 1 } else { 1 };
                d.selCt = d.now;
                d.selCx = d.mx;
                d.selCy = d.my;
                if d.kin.shift && d.selA >= 0 {
                    // extend from the anchor
                    d.selF = p.node;
                    d.selFo = p.off;
                    d.selDrag = true;
                    d.selClicks = 1;
                } else if d.selClicks == 2 {
                    let tn = &d.nodes.items[p.node];
                    let w = wordRange([]u8 { ptr: tn.buf.ptr, len: tn.tlen }, p.off);
                    setRange(d, p.node, w.lo, p.node, w.hi);
                } else if d.selClicks == 3 {
                    block(d, p.node);
                } else {
                    d.selA = p.node;
                    d.selAo = p.off;
                    d.selF = p.node;
                    d.selFo = p.off;
                    d.selDrag = true;
                }
            }
        }
        if !start {
            clear(d);
        }
    } else if d.selDrag {
        if d.down {
            let q = pick(d, d.mx, d.my);
            if q.node >= 0 {
                d.selF = q.node;
                d.selFo = q.off;
            }
        } else {
            // a click with no drag leaves a collapsed anchor (nothing highlighted) for a later Shift+click
            d.selDrag = false;
        }
    }
    let all = d.kin.ctrl && d.kin.a && d.pop.kind == popup.NONE && !(d.focus >= 0 && isField(d, d.focus));
    if all {
        selectAll(d);
    }
    if active(d) || d.selMarked {
        mark(d);
    }
    // a selection settled (mouse up, Ctrl+A): it becomes PRIMARY
    if active(d) && (all || (!d.down && d.prevDown)) {
        let s = selected(d);
        if s.len > 0 { d.setPrimary(s); }
    }
    if d.selA >= 0 && d.kin.ctrl && d.kin.c && !(d.focus >= 0 && isField(d, d.focus)) {
        let s = selected(d);
        if s.len > 0 {
            game.setClipboard(s);
        }
    }
}

fn setRange(d: &Dom, a: int, ao: int, f: int, fo: int) {
    d.selA = a;
    d.selAo = ao;
    d.selF = f;
    d.selFo = fo;
    d.selDrag = false;
}

/// Select every selectable text under `root` (the document, or the top modal).
fn selectUnder(d: &Dom, root: int) {
    let first = -1;
    let last = -1;
    let id = root;
    while id >= 0 && inRange(d, id, root) {
        if selectable(d, id) && d.nodes.items[id].tlen > 0 && visibleEnd(d, id) > 0 {
            if first < 0 { first = id; }
            last = id;
        }
        id = after(d, id);
    }
    if first >= 0 {
        setRange(d, first, 0, last, d.nodes.items[last].tlen);
    }
}

/// Ctrl+A with no text box focused: the top modal dialog if one is open, else the whole document.
fn selectAll(d: &Dom) {
    let m = dom.modalIndex(d);
    selectUnder(d, if m >= 0 { d.ovs.items[m].v } else { 0 });
}

/// Select the block (the nearest ancestor that owns line fragments) holding text node `tn`.
fn block(d: &Dom, tn: int) {
    let owner = ownerOf(d, tn);
    let a = -1;
    let ao = 0;
    let f = -1;
    let fo = 0;
    let fr = if owner >= 0 { d.nodes.items[owner].frag0 } else { -1 };
    while fr >= 0 {
        let g = &d.frags.items[fr];
        if g.kind == 0 && selectable(d, g.node) {
            if a < 0 { a = g.node; ao = g.start; }
            f = g.node;
            fo = g.end;
        }
        fr = g.next;
    }
    if a >= 0 { setRange(d, a, ao, f, fo); }
}

/// Whether text node `tn` is `r` or inside it (the element the press hit).
fn inRange(d: &Dom, tn: int, r: int): bool {
    let c = tn;
    while c >= 0 {
        if c == r {
            return true;
        }
        c = d.nodes.items[c].parent;
    }
    return false;
}
