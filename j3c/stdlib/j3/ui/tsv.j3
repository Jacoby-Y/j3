// Tab-separated text as spreadsheets copy it (plan 023 stage 6b): fields split by tab, rows by newline; a field with a
// tab, newline or double quote is wrapped in quotes and its quotes doubled. Pure functions, no Dom. Parsing stores the
// fields flat (unescaped bytes in `data`, the end offset of each field in `ends`, the field count at the end of each
// row in `rows`), so ragged input needs no padding and a cell read is O(1).

module j3.ui.tsv;

use j3.memory.List;
use j3.text.Text;

const TAB: u8 = 9;
const LF: u8 = 10;
const CR: u8 = 13;
const QUOTE: u8 = 34;

/// Must `s` be quoted.
pub fn needsQuote(s: string): bool {
    for i in 0..s.len {
        let c = s[i];
        if c == TAB || c == LF || c == CR || c == QUOTE {
            return true;
        }
    }
    return false;
}

/// Append `s` as one TSV field.
pub fn field(out: &Text, s: string) {
    if !needsQuote(s) {
        out.pushStr(s);
        return;
    }
    out.push(QUOTE);
    for i in 0..s.len {
        out.push(s[i]);
        if s[i] == QUOTE {
            out.push(QUOTE);
        }
    }
    out.push(QUOTE);
}

/// Append `c` unless `data` is full (one huge field is cut, not stored whole).
fn put(data: &Text, c: u8, maxBytes: int): bool {
    if data.len() < maxBytes {
        data.push(c);
        return false;
    }
    return true;
}

/// Drop a UTF-8 sequence cut short at the end of `data`.
fn trimPartial(data: &Text) {
    let n = data.len();
    let i = n - 1;
    while i >= 0 && data.bytes[i] >= 128 && data.bytes[i] < 192 {
        i -= 1;
    }
    if i >= 0 && data.bytes[i] >= 192 {
        let want = 2;
        if data.bytes[i] >= 240 {
            want = 4;
        } else if data.bytes[i] >= 224 {
            want = 3;
        }
        if n - i < want {
            while data.len() > i {
                data.pop();
            }
        }
    }
}

/// Parse `src`, replacing the contents of `data`, `ends` and `rows`. Stops (returns false) once `maxCells` fields or
/// `maxBytes` of field data are stored: the field that hit the cap is cut at a character boundary and is the last
/// one (its row is kept). Rows end at LF, CRLF or CR; a newline at the very end
/// ends no extra row; a quoted field may hold tabs, newlines and `""`; text after a closing quote is kept as is.
pub fn parse(src: string, data: &Text, ends: &List<int>, rows: &List<int>, maxCells: int, maxBytes: int): bool {
    data.clear();
    ends.len = 0;
    rows.len = 0;
    let n = src.len;
    let i = 0;
    let inRow = 0;
    let cut = false;
    while i < n {
        if ends.len >= maxCells || data.len() >= maxBytes {
            if inRow > 0 {
                rows.push(ends.len);
            }
            return false;
        }
        if src[i] == QUOTE {
            i += 1;
            let closed = false;
            while i < n && !closed {
                if src[i] == QUOTE {
                    if i + 1 < n && src[i + 1] == QUOTE {
                        cut = put(data, QUOTE, maxBytes) || cut;
                        i += 2;
                    } else {
                        closed = true;
                        i += 1;
                    }
                } else {
                    cut = put(data, src[i], maxBytes) || cut;
                    i += 1;
                }
            }
        }
        while i < n && src[i] != TAB && src[i] != LF && src[i] != CR {
            cut = put(data, src[i], maxBytes) || cut;
            i += 1;
        }
        if cut {
            trimPartial(data); // a field cut at the cap does not end inside a character
            rows.push(ends.len + 1);
            ends.push(data.len());
            return false;
        }
        ends.push(data.len());
        inRow += 1;
        if i >= n {
            rows.push(ends.len);
            return true;
        }
        if src[i] == TAB {
            i += 1;
            if i >= n {
                // a trailing tab: one more, empty, field
                ends.push(data.len());
                rows.push(ends.len);
                return true;
            }
        } else {
            if src[i] == CR && i + 1 < n && src[i + 1] == LF {
                i += 1;
            }
            i += 1;
            rows.push(ends.len);
            inRow = 0;
        }
    }
    return true;
}

/// Fields in row `i` of a parsed text.
pub fn rowLen(rows: &List<int>, i: int): int {
    if i < 0 || i >= rows.len {
        return 0;
    }
    return rows.items[i] - (if i == 0 { 0 } else { rows.items[i - 1] });
}

/// The widest parsed row.
pub fn maxCols(rows: &List<int>): int {
    let m = 0;
    for i in 0..rows.len {
        let w = rowLen(rows, i);
        if w > m {
            m = w;
        }
    }
    return m;
}

/// Field `(i, j)` of a parsed text, or "" past the end of a short row. A view of `data`.
pub fn cell(data: &Text, ends: &List<int>, rows: &List<int>, i: int, j: int): string {
    if j < 0 || j >= rowLen(rows, i) {
        return "";
    }
    let f = (if i == 0 { 0 } else { rows.items[i - 1] }) + j;
    let a = if f == 0 { 0 } else { ends.items[f - 1] };
    let b = ends.items[f];
    return []u8 { ptr: (data.str().ptr as int + a) as &u8, len: b - a } as string;
}
