// Part of j3.ui.cssprop; Multi-value shorthands: box sides, borders, outline, decoration, stroke, wave, overflow, scrollbar-color. The module doc and `use`s are in ../cssprop.j3.
module j3.ui.cssprop;

/// The `V_*` kind of CSS-wide keyword token (only a whole value: the callers check that nothing else is around it) `t` (`inherit`, `initial`, `unset`, `revert`, `revert-layer`), 0 for any other token.
pub fn wideKind(p: &P, t: &Token): int {
    if t.kind != T_IDENT { return 0; }
    if isWord(p, t, "inherit") { return V_INHERIT; }
    if isWord(p, t, "initial") { return V_INITIAL; }
    if isWord(p, t, "unset") { return V_UNSETKW; }
    if isWord(p, t, "revert") || isWord(p, t, "revert-layer") { return V_REVERT; }
    return 0;
}

fn emitN(p: &P, first: int, n: int, v: Value) {
    for i in 0..n {
        emit(p, first + i, v);
    }
}

/// `name: <keyword>` for a shorthand: the keyword on each longhand it sets (`all`: one `P_ALL`). False for a longhand or a name that is not one.
pub fn wideShort(p: &P, name: string, v: Value): bool {
    if same(name, "all") { emit(p, P_ALL, v); return true; }
    if same(name, "padding") { emitN(p, P_PADDING_TOP, 4, v); return true; }
    if same(name, "margin") { emitN(p, P_MARGIN_TOP, 4, v); return true; }
    if same(name, "scroll-padding") { emitN(p, P_SCROLL_PAD, 4, v); return true; }
    if same(name, "scroll-margin") { emitN(p, P_SCROLL_MARGIN, 4, v); return true; }
    if same(name, "border-width") { emitN(p, P_BORDER_TOP_WIDTH, 4, v); return true; }
    if same(name, "border-color") { emitN(p, P_BORDER_TOP_COLOR, 4, v); return true; }
    if same(name, "border-radius") { emitN(p, P_RADIUS_TL, 4, v); return true; }
    if same(name, "inset") {
        emit(p, P_TOP, v);
        emit(p, P_RIGHT, v);
        emit(p, P_BOTTOM, v);
        emit(p, P_LEFT, v);
        return true;
    }
    if same(name, "border") || same(name, "border-top") || same(name, "border-right") || same(name, "border-bottom") || same(name, "border-left") {
        let first = 0;
        let count = 4;
        if same(name, "border-right") { first = 1; count = 1; }
        if same(name, "border-bottom") { first = 2; count = 1; }
        if same(name, "border-left") { first = 3; count = 1; }
        if same(name, "border-top") { count = 1; }
        emitN(p, P_BORDER_TOP_WIDTH + first, count, v);
        emitN(p, P_BORDER_TOP_COLOR + first, count, v);
        emit(p, P_BORDER_STYLE, v);
        return true;
    }
    if same(name, "outline") {
        emit(p, P_OUTLINE_WIDTH, v);
        emit(p, P_OUTLINE_STYLE, v);
        emit(p, P_OUTLINE_COLOR, v);
        return true;
    }
    if same(name, "overflow") { emit(p, P_OVERFLOW_X, v); emit(p, P_OVERFLOW_Y, v); return true; }
    if same(name, "scrollbar-color") { emit(p, P_SB_THUMB, v); emit(p, P_SB_TRACK, v); return true; }
    if same(name, "gap") { emit(p, P_ROW_GAP, v); emit(p, P_GAP, v); return true; }
    if same(name, "text-stroke") || same(name, "-webkit-text-stroke") { emit(p, P_STROKE_WIDTH, v); emit(p, P_STROKE_COLOR, v); return true; }
    if same(name, "text-wave") { emitN(p, P_WAVE_AMP, 3, v); return true; }
    if same(name, "font") {
        emit(p, P_FONT_SIZE, v);
        emit(p, P_FONT_WEIGHT, v);
        emit(p, P_FONT_FAMILY, v);
        emit(p, P_LINE_HEIGHT, v);
        emit(p, P_FONT_STYLE, v);
        return true;
    }
    if same(name, "background") {
        emit(p, P_BACKGROUND, v);
        emit(p, P_BG_IMAGE, v);
        emit(p, P_BG_REPEAT, v);
        emit(p, P_BG_SIZE, v);
        emit(p, P_BG_POS, v);
        return true;
    }
    if same(name, "border-image") {
        emit(p, P_BORDER_IMAGE, v);
        emit(p, P_BORDER_SLICE, v);
        emit(p, P_BORDER_REPEAT, v);
        emit(p, P_BORDER_IMG_W, v);
        emit(p, P_BORDER_OUTSET, v);
        return true;
    }
    if same(name, "transition") { emitN(p, P_TRANS0, 4, v); return true; }
    if same(name, "animation") { emitN(p, P_ANIM_NAME, 7, v); return true; }
    if same(name, "grid-template-columns") { emit(p, P_GRID_COL0, v); return true; }
    if same(name, "grid-template-rows") { emit(p, P_GRID_ROWS, v); return true; }
    if same(name, "grid-auto-columns") { emit(p, P_GRID_ACOLS, v); return true; }
    if same(name, "grid-auto-rows") { emit(p, P_GRID_AROWS, v); return true; }
    if same(name, "grid-auto-flow") { emit(p, P_GRID_FLOW, v); return true; }
    if same(name, "grid-template-areas") { emit(p, P_GRID_AREAS, v); return true; }
    if same(name, "grid-column-start") { emit(p, P_GRID_CS, v); return true; }
    if same(name, "grid-column-end") { emit(p, P_GRID_CS + 1, v); return true; }
    if same(name, "grid-row-start") { emit(p, P_GRID_CS + 2, v); return true; }
    if same(name, "grid-row-end") { emit(p, P_GRID_CS + 3, v); return true; }
    if same(name, "grid-column") { emitN(p, P_GRID_CS, 2, v); return true; }
    if same(name, "grid-row") { emitN(p, P_GRID_CS + 2, 2, v); return true; }
    if same(name, "grid-area") { emitN(p, P_GRID_CS, 4, v); return true; }
    if same(name, "place-items") { emit(p, P_ALIGN_ITEMS, v); emit(p, P_JUSTIFY_ITEMS, v); return true; }
    if same(name, "place-self") { emit(p, P_ALIGN_SELF, v); emit(p, P_JUSTIFY_SELF, v); return true; }
    return false;
}

pub fn emit(p: &P, prop: int, v: Value) {
    p.css.decls.push(Decl { prop: prop, v: v });
    p.ndecl += 1;
}

fn slotId(base: int, i: int): int {
    if base < 0 {
        // inset: top, right, bottom, left
        if i == 0 { return P_TOP; }
        if i == 1 { return P_RIGHT; }
        if i == 2 { return P_BOTTOM; }
        return P_LEFT;
    }
    return base + i;
}

/// 1 to 4 values for the four sides or corners starting at `base`; `cat` is any prop in that group
/// (picks the value parser).
pub fn box4(p: &P, base: int, n: int): bool {
    let c = 0;
    let k = 0;
    let probe = base;
    if base < 0 {
        probe = P_LEFT;
    }
    while k < n {
        if c >= 4 {
            return false;
        }
        let used = parseVal(p, probe, k, n, &V4[c]);
        if used == 0 {
            return false;
        }
        k += used;
        c += 1;
    }
    if c == 0 {
        return false;
    }
    for i in 0..4 {
        let src = 0;
        if c == 2 {
            src = i % 2;
        } else if c == 3 {
            src = i;
            if i == 3 {
                src = 1;
            }
        } else if c == 4 {
            src = i;
        }
        emit(p, slotId(base, i), V4[src]);
    }
    return true;
}

pub fn borderSides(p: &P, first: int, count: int, n: int): bool {
    let w = mk(V_UNSET, 0.0, 0, 0);
    let col = mk(V_UNSET, 0.0, 0, 0);
    let none = false;
    let style = BORDER_SOLID;
    let k = 0;
    let v = mk(V_UNSET, 0.0, 0, 0);
    while k < n {
        let t = tk(k);
        if isWord(p, t, "solid") {
            k += 1;
        } else if isWord(p, t, "dashed") {
            style = BORDER_DASHED;
            k += 1;
        } else if isWord(p, t, "dotted") {
            style = BORDER_DOTTED;
            k += 1;
        } else if isWord(p, t, "none") {
            none = true;
            k += 1;
        } else if t.kind == T_NUM || t.kind == T_PCT {
            if !parseLenU(p, t, &w) || (w.kind != V_PX && w.kind != V_EM && w.kind != V_REM) {
                return false;
            }
            k += 1;
        } else {
            let used = parseVal(p, P_COLOR, k, n, &v);
            if used == 0 {
                return false;
            }
            col = v;
            k += used;
        }
    }
    if none {
        w = mk(V_PX, 0.0, 0, 0);
        col = mk(V_COLOR, 0.0, 0, 0);
    }
    if w.kind == V_UNSET {
        w = mk(V_PX, 3.0, 0, 0);
    }
    if col.kind == V_UNSET {
        col = mk(V_CURRENT, 0.0, 0, 0);
    }
    for i in 0..count {
        emit(p, P_BORDER_TOP_WIDTH + first + i, w);
        emit(p, P_BORDER_TOP_COLOR + first + i, col);
    }
    if count == 4 {
        emit(p, P_BORDER_STYLE, mk(V_KW, 0.0, style, 0));
    }
    return true;
}

/// `outline: <width> <style> <color>` in any order; `none` turns it off. Width defaults to 3px like `border`, the style to solid.
pub fn outline(p: &P, n: int): bool {
    let w = mk(V_UNSET, 0.0, 0, 0);
    let col = mk(V_CURRENT, 0.0, 0, 0);
    let style = 0;
    let k = 0;
    let v = mk(V_UNSET, 0.0, 0, 0);
    while k < n {
        let t = tk(k);
        if isWord(p, t, "solid") {
            k += 1;
        } else if isWord(p, t, "dashed") {
            style = BORDER_DASHED;
            k += 1;
        } else if isWord(p, t, "dotted") {
            style = BORDER_DOTTED;
            k += 1;
        } else if isWord(p, t, "none") {
            style = 3;
            k += 1;
        } else if t.kind == T_NUM || t.kind == T_PCT {
            if !parseLenU(p, t, &w) || (w.kind != V_PX && w.kind != V_EM && w.kind != V_REM) {
                return false;
            }
            k += 1;
        } else {
            let used = parseVal(p, P_COLOR, k, n, &v);
            if used == 0 {
                return false;
            }
            col = v;
            k += used;
        }
    }
    if w.kind == V_UNSET {
        w = mk(V_PX, 3.0, 0, 0);
    }
    emit(p, P_OUTLINE_WIDTH, w);
    emit(p, P_OUTLINE_STYLE, mk(V_KW, 0.0, style, 0));
    emit(p, P_OUTLINE_COLOR, col);
    return true;
}

/// `text-decoration: <line>`: only the line keyword is kept (color and style words are accepted and ignored).
pub fn decoration(p: &P, n: int): bool {
    let line = 0;
    let k = 0;
    let v = mk(V_UNSET, 0.0, 0, 0);
    while k < n {
        let t = tk(k);
        if isWord(p, t, "none") {
            line = 0;
        } else if isWord(p, t, "underline") {
            line = 1;
        } else if isWord(p, t, "line-through") {
            line = 2;
        } else if isWord(p, t, "overline") {
            line = 3;
        } else if isWord(p, t, "solid") || isWord(p, t, "dashed") || isWord(p, t, "dotted") || isWord(p, t, "wavy") || isWord(p, t, "double") {
            k += 1;
            continue;
        } else {
            let used = parseVal(p, P_COLOR, k, n, &v);
            if used == 0 {
                return false;
            }
            k += used;
            continue;
        }
        k += 1;
    }
    emit(p, P_TEXT_DECORATION, mk(V_KW, 0.0, line, 0));
    return true;
}

/// `-webkit-text-stroke: <width> [<color>]` (either order).
pub fn stroke(p: &P, n: int): bool {
    let w = mk(V_UNSET, 0.0, 0, 0);
    let col = mk(V_CURRENT, 0.0, 0, 0);
    let k = 0;
    while k < n {
        let used = 0;
        if tk(k).kind == T_NUM {
            used = 1;
            if !parseLen(p, tk(k), &w) || w.kind != V_PX {
                return false;
            }
        } else {
            used = parseColor(p, k, n, &col);
        }
        if used == 0 {
            return false;
        }
        k += used;
    }
    if w.kind != V_PX {
        return false;
    }
    emit(p, P_STROKE_WIDTH, w);
    emit(p, P_STROKE_COLOR, col);
    return true;
}

/// `text-wave: <amplitude> <length> <period>` (J3 extension, see `P_WAVE_AMP`): `none` or `0` turns it off.
pub fn wave(p: &P, n: int): bool {
    if n == 1 && isWord(p, tk(0), "none") {
        emit(p, P_WAVE_AMP, mk(V_PX, 0.0, 0, 0));
        return true;
    }
    let a = mk(V_UNSET, 0.0, 0, 0);
    let l = mk(V_UNSET, 0.0, 0, 0);
    let t = mk(V_UNSET, 0.0, 0, 0);
    let u = parseVal(p, P_WAVE_AMP, 0, n, &a);
    let v = 0;
    let w = 0;
    if u > 0 {
        v = parseVal(p, P_WAVE_LEN, u, n, &l);
    }
    if v > 0 {
        w = parseVal(p, P_WAVE_PERIOD, u + v, n, &t);
    }
    if w == 0 || u + v + w != n || a.kind != V_PX || l.kind != V_PX {
        return false;
    }
    emit(p, P_WAVE_AMP, a);
    emit(p, P_WAVE_LEN, l);
    emit(p, P_WAVE_PERIOD, t);
    return true;
}

/// `overflow: x [y]`: one value sets both axes.
pub fn overflow2(p: &P, n: int): bool {
    let a = mk(V_UNSET, 0.0, 0, 0);
    let used = parseVal(p, P_OVERFLOW_X, 0, n, &a);
    if used == 0 {
        return false;
    }
    let b = a;
    if used < n && parseVal(p, P_OVERFLOW_Y, used, n, &b) != n - used {
        return false;
    }
    emit(p, P_OVERFLOW_X, a);
    emit(p, P_OVERFLOW_Y, b);
    return true;
}

/// `scrollbar-color: thumb track` (or `auto`).
pub fn scrollbarColor(p: &P, n: int): bool {
    let a = mk(V_UNSET, 0.0, 0, 0);
    let used = 0;
    if n == 1 && isWord(p, tk(0), "auto") {
        emit(p, P_SB_THUMB, mk(V_CURRENT, 0.0, 0, 0));
        emit(p, P_SB_TRACK, mk(V_CURRENT, 0.0, 0, 0));
        return true;
    }
    used = parseVal(p, P_SB_THUMB, 0, n, &a);
    let b = mk(V_UNSET, 0.0, 0, 0);
    if used == 0 || parseVal(p, P_SB_TRACK, used, n, &b) != n - used {
        return false;
    }
    emit(p, P_SB_THUMB, a);
    emit(p, P_SB_TRACK, b);
    return true;
}
