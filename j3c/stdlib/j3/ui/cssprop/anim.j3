// Part of j3.ui.cssprop; `transition` and `animation` list parsing. The module doc and `use`s are in ../cssprop.j3.
module j3.ui.cssprop;

fn groupFirst(name: string): int {
    if same(name, "padding") { return P_PADDING_TOP; }
    if same(name, "margin") { return P_MARGIN_TOP; }
    if same(name, "inset") { return P_LEFT; }
    if same(name, "border-width") || same(name, "border") { return P_BORDER_TOP_WIDTH; }
    if same(name, "border-color") { return P_BORDER_TOP_COLOR; }
    if same(name, "border-radius") { return P_RADIUS_TL; }
    if same(name, "gap") { return P_GAP; }
    return propId(name);
}

fn groupCount(name: string): int {
    if same(name, "border") { return 8; }
    if same(name, "gap") || same(name, "inset") { return 4; }
    if same(name, "padding") || same(name, "margin") || same(name, "border-width") || same(name, "border-color") || same(name, "border-radius") {
        return 4;
    }
    return 1;
}

/// `transition: <prop|all> <time> [<ease>] [<delay>], ...` (up to four).
pub fn transitions(p: &P, n: int): bool {
    let k = 0;
    let c = 0;
    while k < n {
        if c >= 4 || tk(k).kind != T_IDENT {
            return false;
        }
        let nm = txt(p, tk(k));
        let first = 0;
        let count = NPROPS;
        if nm.len > 2 && int(nm[0]) == 45 && int(nm[1]) == 45 {
            // a custom property (it only blends when `@property` gives it a type)
            first = NPROPS + p.css.intern(nm);
            count = 1;
        } else if !same(nm, "all") {
            first = groupFirst(nm);
            count = groupCount(nm);
            if first < 0 || same(nm, "gap") || same(nm, "inset") {
                return false;
            }
        }
        k += 1;
        let nt = 0;
        let ms: f32 = 0.0;
        let delay: f32 = 0.0;
        let ez = 0;
        while k < n && tk(k).kind != T_COMMA {
            let u = parseEase(p, k, n, &ez);
            if u > 0 {
                k += u;
            } else if nt == 0 && timeOf(p, tk(k), &ms) {
                nt = 1;
                k += 1;
            } else if nt == 1 && timeOf(p, tk(k), &delay) {
                nt = 2;
                k += 1;
            } else {
                return false;
            }
        }
        if nt == 0 {
            return false;
        }
        if k < n {
            k += 1;
        }
        V4[c] = mk(V_TRANS, ms, first, count + 256 * (ez + 256 * int(delay)));
        c += 1;
    }
    if c == 0 {
        return false;
    }
    for i in 0..4 {
        if i < c {
            emit(p, P_TRANS0 + i, V4[i]);
        } else {
            emit(p, P_TRANS0 + i, mk(V_NONE, 0.0, 0, 0));
        }
    }
    return true;
}

/// The end of the comma-separated entry of `TOK[k..n)` that starts at `k` (a comma inside a function does not end it).
fn entryEnd(p: &P, k: int, n: int): int {
    let depth = 0;
    let e = k;
    while e < n {
        let t = tk(e);
        if t.kind == T_COMMA && depth == 0 {
            break;
        }
        if t.kind == T_FUNC {
            depth += 1;
        } else if t.kind == T_RPAREN && depth > 0 {
            depth -= 1;
        }
        e += 1;
    }
    return e;
}

/// Does `TOK[0..n)` have a comma outside any function?
pub fn hasListComma(p: &P, n: int): bool {
    return entryEnd(p, 0, n) < n;
}

/// Write the `c` entries `AV[L * 4 ..]` as the value of `animation-*` longhand number `L` (name, duration, easing, delay, count, direction, fill):
/// the first is the property's value, the rest go to `Css.anx` (`animAt`).
fn emitAnim(p: &P, L: int, c: int) {
    let v = AV[L * 4];
    v.c = 0;
    if c > 1 {
        v.c = c + 256 * p.css.anx.len;
        for q in 1..c {
            p.css.anx.push(AV[L * 4 + q]);
        }
    }
    emit(p, P_ANIM_NAME + L, v);
}

fn tooMany(p: &P) {
    warnAt(p, p.lx.line, 1, "at most 4 animations per element; the rest are ignored");
}

/// One `animation` entry at `TOK[j..n)` into `AV[c], AV[4 + c] ...`.
fn animOne(p: &P, j0: int, n: int, c: int): bool {
    let name = mk(V_NONE, 0.0, 0, 0);
    let dur: f32 = 0.0;
    let delay: f32 = 0.0;
    let iter: f32 = 1.0;
    let dir = 0;
    let fill = 0;
    let ez = 0;
    let nt = 0;
    let j = j0;
    while j < n {
        let t = tk(j);
        let u = parseEase(p, j, n, &ez);
        if u > 0 {
            j += u;
        } else if t.kind == T_NUM && t.us == t.ue {
            iter = t.f;
            j += 1;
        } else if t.kind == T_NUM {
            if nt == 0 && timeOf(p, t, &dur) {
                nt = 1;
            } else if nt == 1 && timeOf(p, t, &delay) {
                nt = 2;
            } else {
                return false;
            }
            j += 1;
        } else if t.kind == T_IDENT {
            let w = txt(p, t);
            if same(w, "infinite") {
                iter = -1.0;
            } else if wordIndex("normal reverse alternate alternate-reverse", w) >= 0 {
                dir = wordIndex("normal reverse alternate alternate-reverse", w);
            } else if wordIndex("forwards backwards both", w) >= 0 {
                fill = wordIndex("forwards backwards both", w) + 1;
            } else if !same(w, "none") {
                name = mk(V_ANIM, 0.0, p.css.intern(w), 0);
            }
            j += 1;
        } else {
            return false;
        }
    }
    AV[c] = name;
    AV[4 + c] = mk(V_NUM, dur, 0, 0);
    AV[8 + c] = mk(V_EASE, 0.0, ez, 0);
    AV[12 + c] = mk(V_NUM, delay, 0, 0);
    AV[16 + c] = mk(V_NUM, iter, 0, 0);
    AV[20 + c] = mk(V_KW, 0.0, dir, 0);
    AV[24 + c] = mk(V_KW, 0.0, fill, 0);
    return true;
}

/// `animation: <name> <duration> <ease> <delay> <count|infinite> <direction> <fill>` in any order,
/// one or several separated by commas (`MAX_ANIM`; later ones win a property they share).
pub fn animation(p: &P, n: int): bool {
    let k = 0;
    let c = 0;
    while true {
        let e = entryEnd(p, k, n);
        if e == k {
            return false;
        }
        if c >= MAX_ANIM {
            tooMany(p);
            break;
        }
        if !animOne(p, k, e, c) {
            return false;
        }
        c += 1;
        if e >= n {
            break;
        }
        k = e + 1;
    }
    for L in 0..7 {
        emitAnim(p, L, c);
    }
    return true;
}

/// A comma list for one `animation-*` longhand (`animation-name: a, b`); the list cycles over the animations.
pub fn animList(p: &P, prop: int, n: int): bool {
    let k = 0;
    let c = 0;
    while true {
        let e = entryEnd(p, k, n);
        if e == k {
            return false;
        }
        if c < MAX_ANIM {
            AV[(prop - P_ANIM_NAME) * 4 + c] = mk(V_UNSET, 0.0, 0, 0);
            if parseVal(p, prop, k, e, &AV[(prop - P_ANIM_NAME) * 4 + c]) != e - k {
                return false;
            }
            let kind = AV[(prop - P_ANIM_NAME) * 4 + c].kind;
            if kind == V_VAR || kind == V_INHERIT || kind == V_UNSET {
                return false;
            }
            c += 1;
        } else {
            tooMany(p);
            break;
        }
        if e >= n {
            break;
        }
        k = e + 1;
    }
    emitAnim(p, prop - P_ANIM_NAME, c);
    return true;
}
