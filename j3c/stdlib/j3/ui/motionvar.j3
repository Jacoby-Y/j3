/// What an animated `@property` custom property does to the styles that read it: `applyVars` rewrites the overlay style of the
/// animating node (and of descendants that inherit the value, `follow`) from its recorded rules under the animated values. No Dom, no GL.

module j3.ui.motionvar;

use j3.sys.panic;
use j3.ui.xform.REC;
use j3.ui.anim.SH;
use j3.ui.gradmix;
use j3.ui.css.{ forgetXres, animKind, Css, CK_NONE, NPROPS, V_CALC, V_GRAD, V_LIST, V_SHADOW, V_XFORM, Value };
use j3.ui.cssmatch.varValue;
use j3.ui.cssvars.{ maskHas, readsMask, rebuildReaders, rederive, scratchSet };
use j3.ui.motionbase.{ MAXV, Motion, layoutProp, refresh, STEP_LAYOUT };

/// Scratch of `applyVars`: the overriding custom properties, the paint floats rebuilt from `var()` readers and where each property's go.
#[singleton]
let VN: [16]int;
#[singleton]
let VV: [16]Value;
#[singleton]
let STASH: [512]f32;
#[singleton]
let SIZED: bool;
#[singleton]
// one slot per property: a literal size (no const in array sizes), checked against `NPROPS` where they are used
let SOFF: [160]int;
#[singleton]
let SSZ: [160]int;

fn sameRaw(a: Value, b: Value): bool {
    return a.kind == b.kind && a.f == b.f && a.i == b.i && a.c == b.c;
}

/// Floats a paint value of the overlay owns in `Css.paints` when it was just parsed at or after `p0`: 0 for nothing to move, -1 when its size is unknown.
fn paintLen(css: &Css, v: Value, p0: int): int {
    let a = css.paints.items;
    if v.kind == V_GRAD && v.i >= p0 {
        return gradmix.size(a, v.i);
    }
    if v.kind == V_SHADOW && v.i >= p0 {
        return 1 + int(a[v.i]) * SH;
    }
    if v.kind == V_XFORM && v.i >= p0 {
        return 1 + int(a[v.i]) * REC;
    }
    if v.kind == V_CALC && v.i >= p0 {
        return 2 * v.c;
    }
    if v.kind == V_LIST && v.i >= p0 {
        return -1;
    }
    return 0;
}

/// Rewrite the properties of the overlay that read custom properties, under the values `src` animates (`src.vname` / `vval`; `src` is
/// the node itself, or an ancestor when `follow`: then only the properties the node inherits from it are overridden). The style is
/// recomputed from its rules in a scratch set (`rebuildReaders`); of the result only the declarations that used `var()` are copied.
/// What a deferred value parses into `Css.paints` is moved to the node's own region, so a running animation allocates nothing.
/// Returns `STEP_LAYOUT` when a layout property was written.
pub fn applyVars(m: &Motion, css: &Css, tst: int, src: &Motion, follow: bool): int {
    let vs = css.varsOf(tst);
    let n = 0;
    let top = if follow { src.vt } else { src.vn };
    for j in 0..top {
        let bv = varValue(css, vs, src.vname[j]);
        if !follow {
            src.vbase[j] = bv;
        } else if !sameRaw(bv, src.vbase[j]) {
            continue;
        }
        VN[n] = src.vname[j];
        VV[n] = src.vval[j];
        n += 1;
    }
    let need = css.vsn.items[vs] + 2 * MAXV;
    if m.vset < 0 || m.vcap < need {
        m.vset = -1;
        m.vcap = need * 2 + 2;
    }
    m.vset = scratchSet(css, vs, m.vset, m.vcap, VN[0..16], VV[0..16], n);
    let nd = rederive(css, tst, m.vset, VN[0..16], VV[0..16], n, 2 * MAXV);
    if !follow {
        // what descendants follow: the animated values, then the ones derived from them
        for j in n..nd {
            src.vname[j] = VN[j];
            src.vval[j] = VV[j];
            src.vbase[j] = varValue(css, vs, VN[j]);
        }
        src.vt = nd;
    }
    let p0 = css.paints.len;
    if !rebuildReaders(css, tst, m.vset) {
        return 0;
    }
    if !SIZED {
        // once: the scratch tables must cover every property
        if SOFF.len < NPROPS || SSZ.len < NPROPS {
            panic("motionvar: SOFF / SSZ are smaller than NPROPS; grow them with it");
        }
        SIZED = true;
    }
    let total = 0;
    for p in 0..NPROPS {
        SOFF[p] = -1;
        if css.omask[p] {
            let sz = paintLen(css, css.out[p], p0);
            if sz < 0 || total + sz > 512 {
                css.omask[p] = false;
            } else if sz > 0 {
                SOFF[p] = total;
                SSZ[p] = sz;
                for q in 0..sz {
                    STASH[total + q] = css.paints.items[css.out[p].i + q];
                }
                total += sz;
            }
        }
    }
    css.paints.len = p0;
    forgetXres(css);
    if m.vpc < total {
        m.vp = p0;
        m.vpc = total;
        for z in 0..total {
            css.paints.push(0.0);
        }
    }
    let r = 0;
    for p in 0..NPROPS {
        if !css.omask[p] {
            continue;
        }
        let v = css.out[p];
        if SOFF[p] >= 0 {
            v.i = m.vp + SOFF[p];
            for q in 0..SSZ[p] {
                css.paints.items[v.i + q] = STASH[SOFF[p] + q];
            }
        } else if (v.kind == V_GRAD || v.kind == V_SHADOW || v.kind == V_XFORM || v.kind == V_CALC) && v.i >= p0 {
            continue;
        }
        let at = m.ov * NPROPS + p;
        if (layoutProp(p) || animKind(p) == CK_NONE) && !sameRaw(css.vals.items[at], v) {
            r = STEP_LAYOUT;
        }
        css.vals.items[at] = v;
    }
    return r;
}

/// How a node whose computed style is `tst` relates to the custom properties `src` animates: 1 it reads one it inherits (rebuild it),
/// 0 it inherits them but does not read them, 2 it declares them itself (its subtree does not see the animation).
pub fn followKind(src: &Motion, css: &Css, tst: int): int {
    let vs = css.varsOf(tst);
    let mask = readsMask(css, tst);
    let inherited = false;
    let reads = false;
    for j in 0..src.vt {
        if sameRaw(varValue(css, vs, src.vname[j]), src.vbase[j]) {
            inherited = true;
            if maskHas(mask, src.vname[j]) {
                reads = true;
            }
        }
    }
    if !inherited {
        return 2;
    }
    if reads {
        return 1;
    }
    return 0;
}

/// The node reads custom properties `src` animates: rebuild its overlay under them (see `applyVars`). Returns `STEP_LAYOUT` bits.
pub fn follow(m: &Motion, css: &Css, tst: int, src: &Motion): int {
    if !m.vf || m.vfst != tst {
        refresh(m, css, tst);
        m.vf = true;
        m.vfst = tst;
    }
    return applyVars(m, css, tst, src, true);
}

/// `src` stopped animating (`src.vn` is 0): put the node's overlay back to its computed values and let go of it.
pub fn unfollow(m: &Motion, css: &Css, tst: int, src: &Motion): int {
    if !m.vf {
        return 0;
    }
    m.vf = false;
    if m.vfst != tst {
        return 0;
    }
    return applyVars(m, css, tst, src, true);
}

