// Keys of a keyed `{#each}` (plan 023 stage 4): which row of last frame is which row now.
// The generated component calls `begin`, `add` per item, `finish`, then reads `changed`, `from`, `dead`.
// Keys are text (the generated code formats them with a template), kept as bytes in two buffers that swap
// every frame, so a steady frame (same keys, same order) compares bytes and allocates nothing.
// `{#each xs as x (expr : int)}` calls `addInt` instead: the int is stored as 8 raw bytes, so the same byte
// compares and hashes apply and nothing is formatted. One list never mixes the two kinds.

module j3.ui.keyed;

use j3.io.printLn;
use j3.memory.{ Arena, List };

pub struct Keyed {
    mem: &Arena;
    /// Last frame's keys: `cb[co[i]..co[i + 1]]` is key `i`.
    cb: []u8;
    co: List<int>;
    cn: int;
    /// This frame's keys, the same way.
    nb: []u8;
    nlen: int;
    no: List<int>;
    nn: int;
    /// New row `i` was row `from[i]` last frame, or -1 for a new row.
    from: List<int>;
    /// Last frame's rows that have no row now.
    dead: List<int>;
    claim: List<bool>;
    /// Scratch hash tables of `finish` (old keys, new keys): row index or -1.
    otab: List<int>;
    ntab: List<int>;
    /// The order or the set of rows differs from last frame.
    changed: bool;
    warned: bool;
    /// `ntab` indexes the current keys (set by a changed `finish`, cleared by `reset`), for `find`.
    hashed: bool;
    /// This frame's keys came from `addInt` (only the duplicate warning needs to know).
    ints: bool;

    fn new(mem: &Arena): Keyed {
        let k = Keyed { mem: mem, cb: mem.alloc::<u8>(0), co: List<int>.new(mem), cn: 0, nb: mem.alloc::<u8>(0), nlen: 0, no: List<int>.new(mem), nn: 0, from: List<int>.new(mem), dead: List<int>.new(mem), claim: List<bool>.new(mem), otab: List<int>.new(mem), ntab: List<int>.new(mem), changed: false, warned: false, hashed: false, ints: false };
        k.co.push(0);
        return k;
    }

    fn begin(this: &Keyed) {
        this.nlen = 0;
        this.nn = 0;
        this.no.len = 0;
        this.no.push(0);
        this.ints = false;
    }

    /// Add the next row's key as an int (see `encode`).
    fn addInt(this: &Keyed, v: int) {
        this.ints = true;
        if this.nlen + 9 > this.nb.len {
            let next = this.mem.alloc::<u8>(max2(this.nlen + 9, this.nb.len * 2));
            for i in 0..this.nlen {
                next[i] = this.nb[i];
            }
            this.nb = next;
        }
        this.nlen += encode(this.nb, this.nlen, v);
        this.no.push(this.nlen);
        this.nn += 1;
    }

    /// Add the next row's key (copied: the caller's string may be a buffer it reuses).
    fn add(this: &Keyed, key: string) {
        if this.nlen + key.len > this.nb.len {
            let next = this.mem.alloc::<u8>(max2(this.nlen + key.len, this.nb.len * 2));
            for i in 0..this.nlen {
                next[i] = this.nb[i];
            }
            this.nb = next;
        }
        for i in 0..key.len {
            this.nb[this.nlen + i] = key[i];
        }
        this.nlen += key.len;
        this.no.push(this.nlen);
        this.nn += 1;
    }

    /// Forget every row (the list's rows were dropped, e.g. its `{#if}` branch was left).
    fn reset(this: &Keyed) {
        this.cn = 0;
        this.co.len = 1;
        this.hashed = false;
    }

    /// Add one row at the end of the current keys (after `finish`): a list that only grew at its tail. The hash
    /// table takes the key in O(key bytes); it is rebuilt (no key formatting) when it passes half full, so
    /// amortised O(1). `changed` / `from` / `dead` describe the last `finish`, not this.
    fn push(this: &Keyed, key: string) {
        let at = this.co.items[this.cn];
        if at + key.len > this.cb.len {
            let next = this.mem.alloc::<u8>(max2(at + key.len, this.cb.len * 2));
            for i in 0..at {
                next[i] = this.cb[i];
            }
            this.cb = next;
        }
        for i in 0..key.len {
            this.cb[at + i] = key[i];
        }
        this.pushed(at, key.len);
    }

    /// `push` for an int key (see `addInt`).
    fn pushInt(this: &Keyed, v: int) {
        let at = this.co.items[this.cn];
        if at + 9 > this.cb.len {
            let next = this.mem.alloc::<u8>(max2(at + 9, this.cb.len * 2));
            for i in 0..at {
                next[i] = this.cb[i];
            }
            this.cb = next;
        }
        this.pushed(at, encode(this.cb, at, v));
    }

    /// The bytes `at..at + len` of `cb` are a new last key: index it.
    fn pushed(this: &Keyed, at: int, len: int) {
        this.co.push(at + len);
        this.cn += 1;
        if !this.hashed || 2 * this.cn > this.ntab.len {
            this.rehash();
            return;
        }
        let cap = this.ntab.len;
        let g = slot(this.cb, at, at + len, cap);
        while this.ntab.items[g] >= 0 {
            g = if g + 1 == cap { 0 } else { g + 1 };
        }
        this.ntab.items[g] = this.cn - 1;
    }

    /// Rebuild `ntab` over the current keys.
    fn rehash(this: &Keyed) {
        let cap = 16;
        while cap < 2 * this.cn {
            cap = cap * 2;
        }
        this.ntab.len = 0;
        for t in 0..cap {
            this.ntab.push(-1);
        }
        for p in 0..this.cn {
            let g = slot(this.cb, this.co.items[p], this.co.items[p + 1], cap);
            while this.ntab.items[g] >= 0 {
                g = if g + 1 == cap { 0 } else { g + 1 };
            }
            this.ntab.items[g] = p;
        }
        this.hashed = true;
    }

    /// Row of the current keys (after `finish`) whose key is `key`, -1 if none. O(key bytes).
    fn find(this: &Keyed, key: string): int {
        if !this.hashed {
            return -1;
        }
        let cap = this.ntab.len;
        let h = 1469598103934665603;
        for i in 0..key.len {
            h = (h + int(key[i]) + 1) * 1099511628211;
        }
        h = h + h / 4294967296;
        let g = h % cap;
        if g < 0 {
            g += cap;
        }
        while this.ntab.items[g] >= 0 {
            let r = this.ntab.items[g];
            let a = this.co.items[r];
            if this.co.items[r + 1] - a == key.len {
                let same = true;
                for t in 0..key.len {
                    if this.cb[a + t] != key[t] {
                        same = false;
                    }
                }
                if same {
                    return r;
                }
            }
            g = if g + 1 == cap { 0 } else { g + 1 };
        }
        return -1;
    }

    /// Current key `i` of this list equals current key `j` of `o`.
    fn sameAs(this: &Keyed, i: int, o: &Keyed, j: int): bool {
        let a = this.co.items[i];
        let b = o.co.items[j];
        let len = this.co.items[i + 1] - a;
        if len != o.co.items[j + 1] - b {
            return false;
        }
        for t in 0..len {
            if this.cb[a + t] != o.cb[b + t] {
                return false;
            }
        }
        return true;
    }

    /// Old key `c` equals new key `n`.
    fn eqCN(this: &Keyed, c: int, n: int): bool {
        let a = this.co.items[c];
        let b = this.no.items[n];
        let len = this.co.items[c + 1] - a;
        if len != this.no.items[n + 1] - b {
            return false;
        }
        for i in 0..len {
            if this.cb[a + i] != this.nb[b + i] {
                return false;
            }
        }
        return true;
    }

    /// New keys `i` and `j` are equal.
    fn eqNN(this: &Keyed, i: int, j: int): bool {
        let a = this.no.items[i];
        let b = this.no.items[j];
        let len = this.no.items[i + 1] - a;
        if len != this.no.items[j + 1] - b {
            return false;
        }
        for t in 0..len {
            if this.nb[a + t] != this.nb[b + t] {
                return false;
            }
        }
        return true;
    }

    /// Match this frame's keys to last frame's rows, then make this frame's the "last". A repeated key
    /// takes the next unclaimed old row with that key (so it stays stable by position) and warns once;
    /// `where` names the `.j3ui` line. A frame that changed builds two open-addressing tables (old keys,
    /// new keys; kept and reused, they only grow), so matching is linear in the rows plus key bytes.
    fn finish(this: &Keyed, where: string) {
        let n = this.nn;
        let old = this.cn;
        let i = 0;
        while i < n && i < old && this.eqCN(i, i) {
            i += 1;
        }
        if i == n && n == old {
            this.changed = false;
            return;
        }
        this.changed = true;
        this.hashed = true;
        this.claim.len = 0;
        this.dead.len = 0;
        this.from.len = 0;
        for p in 0..old {
            this.claim.push(false);
        }
        let cap = 16;
        while cap < 2 * max2(old, n) {
            cap = cap * 2;
        }
        // Slots hold old (or new) row indices in insertion order; linear probing keeps equal keys in
        // index order, so the first unclaimed match in probe order is the next one by position.
        this.otab.len = 0;
        this.ntab.len = 0;
        for t in 0..cap {
            this.otab.push(-1);
            this.ntab.push(-1);
        }
        for p in 0..old {
            let oh = slot(this.cb, this.co.items[p], this.co.items[p + 1], cap);
            while this.otab.items[oh] >= 0 {
                oh = if oh + 1 == cap { 0 } else { oh + 1 };
            }
            this.otab.items[oh] = p;
        }
        for q in 0..n {
            let f = -1;
            let h = slot(this.nb, this.no.items[q], this.no.items[q + 1], cap);
            if q < old && !this.claim.items[q] && this.eqCN(q, q) {
                f = q;
            } else {
                let g = h;
                while f < 0 && this.otab.items[g] >= 0 {
                    let cand = this.otab.items[g];
                    if !this.claim.items[cand] && this.eqCN(cand, q) {
                        f = cand;
                    }
                    g = if g + 1 == cap { 0 } else { g + 1 };
                }
            }
            if f >= 0 {
                this.claim.items[f] = true;
            }
            this.from.push(f);
            let z = h;
            let dup = false;
            while this.ntab.items[z] >= 0 {
                if !dup && !this.warned && this.eqNN(this.ntab.items[z], q) {
                    dup = true;
                }
                z = if z + 1 == cap { 0 } else { z + 1 };
            }
            this.ntab.items[z] = q;
            if dup {
                this.warned = true;
                let len = this.no.items[q + 1] - this.no.items[q];
                let s = this.mem.alloc::<u8>(len);
                for t in 0..len {
                    s[t] = this.nb[this.no.items[q] + t];
                }
                if this.ints {
                    printLn(`{where}: duplicate each key {decode(s)} (rows with the same key are matched by position)`);
                } else {
                    printLn(`{where}: duplicate each key "{s as string}" (rows with the same key are matched by position)`);
                }
            }
        }
        for p in 0..old {
            if !this.claim.items[p] {
                this.dead.push(p);
            }
        }
        // this frame's keys become last frame's
        let tb = this.cb;
        this.cb = this.nb;
        this.nb = tb;
        let to = this.co;
        this.co = this.no;
        this.no = to;
        this.cn = n;
    }
}

/// Hash of bytes `a..b` of `buf` as a slot in a table of `cap` (a power of two).
fn slot(buf: []u8, a: int, b: int, cap: int): int {
    let h = 1469598103934665603;
    for i in a..b {
        h = (h + int(buf[i]) + 1) * 1099511628211;
    }
    h = h + h / 4294967296;
    let m = h % cap;
    return if m < 0 { m + cap } else { m };
}

fn max2(a: int, b: int): int {
    return if a > b { a } else { b };
}

/// Write `v` at `buf[at..]` and return the byte count (2 to 9): a sign byte (0, or 1 for a negative), then the
/// magnitude (`-v - 1` when negative) low byte first, stopping at its top non-zero byte. Distinct ints give distinct
/// byte strings, and small ints (the usual ids) are 2 or 3 bytes to hash and compare. No bit ops: `%` and `/`.
pub fn encode(buf: []u8, at: int, v: int): int {
    let m = v;
    buf[at] = u8(0);
    if v < 0 {
        m = 0 - v - 1;
        buf[at] = u8(1);
    }
    buf[at + 1] = u8(m % 256);
    m = m / 256;
    let n = 2;
    while m > 0 {
        buf[at + n] = u8(m % 256);
        m = m / 256;
        n += 1;
    }
    return n;
}

/// The int `encode` wrote (`s` is exactly its bytes).
pub fn decode(s: []u8): int {
    let m = 0;
    let t = s.len - 1;
    while t >= 1 {
        m = m * 256 + int(s[t]);
        t -= 1;
    }
    return if s[0] == u8(1) { 0 - m - 1 } else { m };
}
