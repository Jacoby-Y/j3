/// HTML snapshot of a laid-out `Dom` for comparing with a browser (`dumpHtml`, `j3c doc testing`).

module j3.ui.domhtml;

use j3.memory.Arena;
use j3.io.writeFile;
use j3.result.Result;
use j3.text.{ same, Text };
use j3.ui.a11y;
use j3.ui.dom.{ Dom, isDisabled, optSelected };

fn htmlEsc(t: &Text, s: string) {
    for i in 0..s.len {
        let b = s[i];
        if b == 38 {
            t.pushStr("&amp;");
        } else if b == 60 {
            t.pushStr("&lt;");
        } else if b == 62 {
            t.pushStr("&gt;");
        } else {
            t.push(b);
        }
    }
}

/// `s` for inside a double-quoted attribute.
fn attrEsc(t: &Text, s: string) {
    for i in 0..s.len {
        if s[i] == 34 {
            t.pushStr("&quot;");
        } else {
            htmlEsc(t, s[i..i + 1]);
        }
    }
}

/// `src` without `/* */` comments.
fn noComments(t: &Text, s: string) {
    let i = 0;
    while i < s.len {
        if s[i] == 47 && i + 1 < s.len && s[i + 1] == 42 {
            i += 2;
            while i + 1 < s.len && !(s[i] == 42 && s[i + 1] == 47) {
                i += 1;
            }
            i += 2;
        } else {
            t.push(s[i]);
            i += 1;
        }
    }
}

/// One sheet as browser CSS: a scoped sheet's selectors get `.s<scope>` on their last compound
/// (the rule `css.j3` applies), `@font-face` is dropped (the caller writes its own).
fn scopedCss(t: &Text, mem: &Arena, src: string, scope: int) {
    let clean = Text.new(mem);
    noComments(&clean, src);
    let s = clean.str();
    let i = 0;
    while i < s.len {
        let a = i;
        while i < s.len && s[i] != 123 {
            i += 1;
        }
        if i >= s.len {
            break;
        }
        let pre = s[a..i];
        let depth = 0;
        let b = i;
        while i < s.len {
            if s[i] == 123 {
                depth += 1;
            } else if s[i] == 125 {
                depth -= 1;
                if depth == 0 {
                    i += 1;
                    break;
                }
            }
            i += 1;
        }
        let k = 0;
        while k < pre.len && (pre[k] == 32 || pre[k] == 10 || pre[k] == 9 || pre[k] == 13) {
            k += 1;
        }
        if k < pre.len && pre[k] == 64 {
            continue;
        }
        // each selector of the list, trimmed, then the scope class
        let first = true;
        let st = 0;
        for j in 0..pre.len + 1 {
            if j == pre.len || pre[j] == 44 {
                let e = j;
                let sa = st;
                while sa < e && (pre[sa] == 32 || pre[sa] == 10 || pre[sa] == 9 || pre[sa] == 13) {
                    sa += 1;
                }
                while e > sa && (pre[e - 1] == 32 || pre[e - 1] == 10 || pre[e - 1] == 9 || pre[e - 1] == 13) {
                    e -= 1;
                }
                if e > sa {
                    if !first {
                        t.pushStr(", ");
                    }
                    first = false;
                    t.pushStr(pre[sa..e]);
                    if scope != 0 {
                        t.push(46);
                        t.push(115);
                        t.pushInt(scope);
                    }
                }
                st = j + 1;
            }
        }
        t.pushStr(" ");
        t.pushStr(s[b..i]);
        t.pushStr("\n");
    }
}

fn htmlNode(d: &Dom, t: &Text, id: int) {
    let n = &d.nodes.items[id];
    if n.ghost {
        return;
    }
    if n.kind == 1 {
        htmlEsc(t, d.textOf(id));
        return;
    }
    let mn = &d.mnodes.items[id];
    let tag = d.css.name(n.tag);
    let out = tag;
    let isCanvas = same(tag, "canvas");
    if isCanvas || id == 0 {
        out = "div";
    }
    t.push(60);
    t.pushStr(out);
    if id == 0 {
        t.pushStr(` style="width:{int(n.w)}px;height:{int(n.h)}px"`);
    }
    if isCanvas {
        t.pushStr(` data-canvas="{int(n.w)}x{int(n.h)}" style="background:#808080"`);
    }
    if mn.classes.len > 0 || mn.scope != 0 {
        t.pushStr(" class=\"");
        for i in 0..mn.classes.len {
            t.pushStr(d.css.name(mn.classes[i]));
            t.push(32);
        }
        if mn.scope != 0 {
            t.push(115);
            t.pushInt(mn.scope);
        }
        if mn.scope2 != 0 {
            t.pushStr(" s");
            t.pushInt(mn.scope2);
        }
        t.push(34);
    }
    if mn.type >= 0 {
        t.pushStr(` type="{d.css.name(mn.type)}"`);
        if (mn.type == d.vCheckbox || mn.type == d.vRadio) && n.checked {
            t.pushStr(" checked");
        }
        if same(d.css.name(mn.type), "range") {
            t.pushStr(` min="{n.attrMin}" max="{n.attrMax}" step="{n.attrStep}" value="{n.value}"`);
        }
    }
    if isDisabled(d, id) {
        t.pushStr(" disabled");
    }
    // Entered state, so a snapshot diff shows it. A password box's value is never written.
    if n.tag == d.tInput && mn.type != d.vCheckbox && mn.type != d.vRadio && mn.type != d.vRange && mn.type != d.vPassword {
        t.pushStr(" value=\"");
        attrEsc(t, n.sval);
        t.push(34);
    } else if n.tag == d.tSelect {
        t.pushStr(" value=\"");
        attrEsc(t, n.sval);
        t.push(34);
    } else if same(tag, "option") && n.parent >= 0 && optSelected(d, n.parent, id) {
        t.pushStr(" selected");
    }
    if d.roleOf(id).len > 0 {
        t.pushStr(` role="{d.roleOf(id)}"`);
    }
    if d.ariaOf(id).len > 0 {
        t.pushStr(" aria-label=\"");
        attrEsc(t, d.ariaOf(id));
        t.push(34);
    }
    t.push(62);
    let c = n.first;
    while c >= 0 {
        htmlNode(d, t, c);
        c = d.nodes.items[c].next;
    }
    t.pushStr("</");
    t.pushStr(out);
    t.push(62);
}

/// Write the current tree to `path` as static HTML: every element's classes, the CSS (global
/// sheets as written, scoped ones with `.s<scope>` added, as `parse` scopes them), `<canvas>` as a
/// grey box; `checked`, `disabled`, `selected`, and the value of text boxes and selects (never a
/// password's) are written too. Open it in a browser at the window size to compare with a capture.
/// Call after `root.render(...)` (it runs `layout()`), or after `layout()` on a hand-driven `Dom`.
/// Returns false when the file cannot be written.
pub fn dumpHtml(d: &Dom, path: string): bool {
    let tmp = Arena.create(1048576);
    let t = Text.new(&tmp);
    t.pushStr("<!doctype html>\n<html><head><meta charset=\"utf-8\"><style>\n");
    for i in 0..d.css.fonts.len {
        // font paths are relative to the project; the snapshot is written to target/
        t.pushStr("@font-face { font-family: \"");
        t.pushStr(d.css.name(d.css.fonts.items[i].family));
        t.pushStr("\"; src: url(\"../");
        t.pushStr(d.css.fonts.items[i].path);
        t.pushStr("\"); }\n");
    }
    t.pushStr("html, body { margin: 0; }\n");
    for i in 0..d.css.srcs.len {
        let s = d.css.srcs.items[i];
        scopedCss(&t, &tmp, s.text, s.scope);
    }
    t.pushStr("</style></head><body>\n");
    htmlNode(d, &t, 0);
    t.pushStr("\n</body></html>\n");
    let ok = false;
    match writeFile(path, t.bytes) {
        Result.Ok(_) {
            ok = true;
        }
        Result.Err(_) {}
    }
    tmp.destroy();
    return ok;
}

/// Write the accessibility tree (`j3.ui.a11y.dump`: role, name, states, actions per element) to `path`.
/// Call after `layout()`. Returns false when the file cannot be written.
pub fn dumpA11y(d: &Dom, path: string): bool {
    let tmp = Arena.create(1048576);
    let t = Text.new(&tmp);
    a11y.dump(d, &tmp, &t);
    let ok = false;
    match writeFile(path, t.bytes) {
        Result.Ok(_) {
            ok = true;
        }
        Result.Err(_) {}
    }
    tmp.destroy();
    return ok;
}
