/// Built-in popup CSS, loaded before the application theme. Selects, color panels and tooltips are real
/// runtime DOM subtrees under their owners, inheriting their style scopes and matching ordinary ancestors.
/// `.j3-select-list`, `.j3-option` (`:hover`, `:disabled`, `.selected`), `.j3-check`, `.j3-label` theme selects.
/// `.j3-color-panel`, `.j3-color-sv`, `.j3-color-hue`, `.j3-color-marker`, `.j3-color-handle`,
/// `.j3-color-preview`, `.j3-color-value` theme the color picker. Its drag areas follow the actual node boxes.
/// `.j3-tooltip` supports ordinary box styles and wrapped text (`white-space: pre-line`, `overflow-wrap`).
/// Auto-width titles wrap at 320px or the viewport; an explicit CSS width changes that limit.
/// `:root { --j3-tooltip-delay: 500ms }` controls the wait; the fade lasts 120ms.
/// `:root { --j3-meter-good, --j3-meter-ok, --j3-meter-bad }` are the fill colors of a `<meter>` (the region of its value against its `optimum`); any element may set them for the meters below it.

module j3.ui.uastyle;

use j3.ui.css.Css;
use j3.ui.cssmatch.customNum;
use j3.ui.cssparse.parse;

pub const UA: string = ":root { --j3-tooltip-delay: 500ms; --j3-meter-good: #3fb950; --j3-meter-ok: #d29922; --j3-meter-bad: #f85149; } .j3-select-list, .j3-color-panel { background: #1e1e2e; border: 1px solid #45475a; border-radius: 8px; } .j3-select-list { display: block; box-sizing: border-box; padding: 3px 0; max-height: 216px; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; } .j3-pad { display: block; } .j3-option { display: flex; align-items: center; box-sizing: border-box; height: 24px; margin: 0 3px 2px; padding: 1.5px 4px 0 0; border-radius: 5px; } .j3-option:hover { background: rgba(0, 117, 255, 0.2745); } .j3-check { width: 10px; height: 8px; margin: 0 6px 2px; } .j3-label { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; } .j3-option:disabled .j3-label { opacity: 0.353; } .j3-color-panel { display: block; box-sizing: border-box; width: 200px; padding: 9px; } .j3-color-sv { display: block; position: relative; height: 120px; } .j3-color-saturation { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-image: linear-gradient(90deg, #ffffff, transparent); } .j3-color-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-image: linear-gradient(180deg, transparent, #000000); } .j3-color-marker { position: absolute; box-sizing: border-box; width: 12px; height: 12px; border: 2px solid #ffffff; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0,0,0,0.63); } .j3-color-hue { display: block; position: relative; height: 14px; margin-top: 8px; border-radius: 4px; background-image: linear-gradient(90deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000); } .j3-color-handle { position: absolute; top: -1px; box-sizing: border-box; width: 16px; height: 16px; border: 2px solid #ffffff; border-radius: 50%; } .j3-color-footer { display: flex; height: 24px; margin-top: 10px; } .j3-color-preview { width: 24px; height: 24px; border-radius: 5px; } .j3-color-value { margin-left: 10px; padding-top: 4px; } .j3-tooltip { display: block; box-sizing: border-box; white-space: pre-line; overflow-wrap: break-word; pointer-events: none; background: rgba(24, 27, 34, 0.98); color: #e6e8ee; border: 1px solid #404654; border-radius: 6px; padding: 5px 8px; }";

/// The tag defaults (`strong`, `em`, `pre`, `hr`, `a`). A browser's own origin: any author rule beats them, whatever its
/// specificity (a theme's `*` included), so they rank at zero and source order decides.
pub const TAG_DEFAULTS: string = "strong, b { font-weight: 700; } em, i { font-style: italic; } pre { white-space: pre; } hr { height: 1px; background: rgba(127,127,127,0.5); } a { cursor: pointer; } progress, meter { background: rgba(127,127,127,0.3); border-radius: 4px; } summary { cursor: pointer; } input[type=radio] { border-radius: 50%; } glyph { padding: 1px 6px; min-width: 1.4em; text-align: center; font-size: 0.85em; border: 1px solid rgba(127,127,127,0.8); border-radius: 4px; background: rgba(127,127,127,0.25); } glyph[type=pad] { border-radius: 999px; padding: 1px 7px; } icon { width: 1em; height: 1em; vertical-align: middle; }";

/// Parse `UA` as the first global sheet. A `Css` that never called this gets it on the first popup (after
/// its theme, so the theme's equal-specificity rules lose: call `load` first in hand-built setups).
/// Must run before any author sheet is parsed: `TAG_DEFAULTS` rules are specificity 0, so source order decides against them.
pub fn load(css: &Css) {
    if !css.ua {
        css.ua = true;
        css.uaLo = css.rules.len;
        parse(css, UA, "j3 popups", 0);
        let sh = parse(css, TAG_DEFAULTS, "j3 tag defaults", 0);
        for i in sh.rule0..sh.rule0 + sh.nrules {
            css.rules.items[i].spec = 0;
        }
        css.uaHi = css.rules.len;
    }
}

/// `--j3-tooltip-delay` in ms (500 when a theme broke it; the parser already warned).
pub fn tipDelay(css: &Css): f32 {
    load(css);
    return customNum(css, "--j3-tooltip-delay", 500.0);
}
