/// Wrapped multi-line text for a `<textarea>`: line starts (`layout`), moving the caret between lines with
/// a goal x, hit testing, and drawing with the view scrolled to follow the caret. The text and caret are a
/// `j3.ui.textedit.Edit`; line breaks are its `\n` bytes plus soft breaks at spaces (or mid-word when a
/// word is wider than the box). Needs SDL_ttf for measuring and a `j3.gfx.paint` frame for `paint`.

module j3.ui.area;

use j3.game.{ Font, fontLine, selRectW, selRectX, textSelRects, textWidth };
use j3.gfx.paint;
use j3.math.{ Vec2, max, maxi, min, mini };
use j3.ui.field;
use j3.ui.field.Look;
use j3.ui.rich;
use j3.ui.textedit.Edit;
use j3.ui.textfit.{ cpLen, fitPrefix };

fn view(s: string, a: int, b: int): []u8 {
    let t = s[a..b];
    return []u8 { ptr: t.ptr, len: t.len };
}

/// Width of `s[a..b]`; with spans each segment is measured in its own font and a token as its chip.
pub fn wid(e: &Edit, font: Font, bold: bool, s: string, a: int, b: int): f32 {
    if e.sp.len > 0 {
        return rich.width(e, font, bold, a, b);
    }
    return textWidth(font, view(s, a, b), bold);
}

/// Visual x of the caret before byte `i` on the line drawn from `a` to `b` (right-to-left runs reordered).
pub fn caretAt(e: &Edit, font: Font, bold: bool, s: string, a: int, b: int, i: int): f32 {
    if e.sp.len > 0 {
        return rich.caretX(e, font, bold, a, b, i);
    }
    return field.caretX(font, bold, s, a, b, i);
}

/// Bytes from `a` to the boundary nearest to `x` on the line `a..b`.
fn colAt(e: &Edit, font: Font, bold: bool, s: string, a: int, b: int, x: f32): int {
    if e.sp.len > 0 {
        return rich.indexAt(e, font, bold, a, b, x);
    }
    return field.indexAt(font, bold, s[a..b], 0, x);
}

/// Fill `e.ls` with the byte index where each line starts, for text width `w`. Nothing runs again until the
/// text or `w` changes. A space that does not fit hangs at the end of its line.
pub fn layout(e: &Edit, font: Font, bold: bool, w: f32) {
    if e.lver == e.ver && e.lw == w {
        return;
    }
    e.lver = e.ver;
    e.lw = w;
    e.ls.len = 0;
    e.ls.push(0);
    let s = e.str();
    let a = 0;
    while true {
        let h = a;
        while h < s.len && s[h] != 10 {
            h += 1;
        }
        let b = a;
        while b < h {
            let n = if e.sp.len > 0 { rich.fit(e, font, bold, b, h, w) } else { fitPrefix(font, bold, view(s, b, h), w) };
            if b + n >= h {
                break;
            }
            if n == 0 {
                n = cpLen(view(s, b, h), 0);
            }
            let cut = b + n;
            if s[cut] == 32 {
                cut += 1;
            } else {
                let k = cut;
                while k > b && s[k - 1] != 32 {
                    k -= 1;
                }
                if k > b {
                    cut = k;
                }
            }
            if e.sp.len > 0 {
                // a soft break never falls inside a token
                let t = e.tokenAt(cut);
                if t >= 0 {
                    let sp = e.sp.items[t];
                    cut = if sp.start > b { sp.start } else { sp.start + sp.len };
                }
            }
            if cut >= h {
                break;
            }
            e.ls.push(cut);
            b = cut;
        }
        if h >= s.len {
            break;
        }
        e.ls.push(h + 1);
        a = h + 1;
    }
}

/// The line holding byte `i` (a caret at a soft break belongs to the line after it).
pub fn lineOf(e: &Edit, i: int): int {
    let lo = 0;
    let hi = e.ls.len - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if e.ls.items[mid] <= i {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    return lo;
}

/// The line the caret is drawn on: `lineOf`, except right after End at a mid-word soft break (`e.up`), which stays on the line it ended.
pub fn caretLine(e: &Edit): int {
    let k = lineOf(e, e.cur);
    return if e.cur == e.up && k > 0 && e.ls.items[k] == e.cur { k - 1 } else { k };
}

/// Where the caret may sit furthest right on line `k` (before its newline or hanging space).
pub fn lineEnd(e: &Edit, k: int): int {
    let s = e.text.bytes;
    if k + 1 >= e.ls.len {
        return s.len;
    }
    let n = e.ls.items[k + 1];
    let c = s[n - 1];
    return if c == 10 || c == 32 { n - 1 } else { n };
}

/// The byte nearest to local `x`, `y` (content box, before the scroll) in the laid out text. Sets `e.up` (caret affinity) for a hit at a soft break.
pub fn indexAt(e: &Edit, font: Font, bold: bool, x: f32, y: f32): int {
    let lh = f32(fontLine(font));
    let k = int((y + e.ty) / lh);
    if y + e.ty < 0.0 {
        k = 0;
    }
    k = mini(k, e.ls.len - 1);
    let s = e.str();
    let a = e.ls.items[k];
    let i = a + colAt(e, font, bold, s, a, lineEnd(e, k), x);
    // a click at the end of a line that wraps mid-word keeps the caret on that line (`e.up`, as End does)
    // only a boundary hit decides the affinity: on the line before the break it is upstream, on the line after it downstream
    if k + 1 < e.ls.len && i == e.ls.items[k + 1] {
        e.up = i;
    } else if k > 0 && i == e.ls.items[k] {
        e.up = -1;
    }
    return i;
}

/// Move the caret `dy` lines (negative up), keeping the column it started from in `e.gx` (until something else moves the caret); past the first
/// or last line it goes to the start or end of the text.
pub fn moveV(e: &Edit, font: Font, bold: bool, dy: int, extend: bool) {
    let s = e.str();
    let k = caretLine(e);
    if e.gx < 0.0 || e.cur != e.gcur {
        e.gx = caretAt(e, font, bold, s, e.ls.items[k], lineEnd(e, k), e.cur);
    }
    let t = k + dy;
    if t < 0 {
        e.moveTo(0, extend);
    } else if t >= e.ls.len {
        e.moveTo(s.len, extend);
    } else {
        let a = e.ls.items[t];
        e.moveTo(a + colAt(e, font, bold, s, a, lineEnd(e, t), e.gx), extend);
        if e.cur > a {
            e.up = e.cur;
        }
    }
    e.gcur = e.cur;
}

/// Scroll `e.ty` so the caret line shows in a view `h` px tall, when the caret or text moved since last
/// time and the box has focus (an unfocused one stays where it is); always keep the scroll inside the
/// text. Needs `layout`.
pub fn follow(e: &Edit, focused: bool, lh: f32, h: f32) {
    e.lh = lh;
    e.vh = h;
    // fcur -2: `Dom.setSelection` asked to show the caret once, focused or not
    if (focused || e.fcur == -2) && (e.cur != e.fcur || e.ver != e.fver) {
        e.fcur = e.cur;
        e.fver = e.ver;
        let top = f32(caretLine(e)) * lh;
        if top < e.ty {
            e.ty = top;
        } else if top + lh > e.ty + h {
            e.ty = top + lh - h;
        }
    }
    e.ty = max(0.0, min(e.ty, f32(e.ls.len) * lh - h));
}

/// Draw the text in the `w` x `h` content box (the caller translates and clips): the lines in view, the
/// selection, the IME composition `comp` at the caret and the caret when `focused` and `blink`. The view
/// scrolls (`e.ty`) to keep the caret in sight after the caret or text moved. Returns the caret's top left
/// (-1, -1 when none).
pub fn paint(e: &Edit, font: Font, bold: bool, focused: bool, blink: bool, hint: string, comp: string, w: f32, h: f32, look: &Look): Vec2 {
    let lh = f32(fontLine(font));
    layout(e, font, bold, w);
    let s = e.str();
    let n = e.ls.len;
    let ck = caretLine(e);
    follow(e, focused, lh, h);
    if s.len == 0 && !focused && hint.len > 0 {
        paint.text(font, Vec2 { x: 0.0, y: 0.0 }, hint, look.hint);
    }
    let lo = mini(e.cur, e.anc);
    let hi = maxi(e.cur, e.anc);
    let at = Vec2 { x: -1.0, y: -1.0 };
    let k0 = int(e.ty / lh);
    for k in k0..n {
        let y = f32(k) * lh - e.ty;
        if y >= h {
            break;
        }
        let a = e.ls.items[k];
        let nx = if k + 1 < n { e.ls.items[k + 1] } else { s.len };
        let de = if nx > a && s[nx - 1] == 10 { nx - 1 } else { nx };
        if focused && hi > lo && comp.len == 0 && hi > a && lo < nx {
            let ia = maxi(lo, a);
            let ib = mini(hi, de);
            let tail: f32 = if hi > de && k + 1 < n { 4.0 } else { 0.0 };
            if e.sp.len > 0 {
                let rn = rich.selRects(e, font, bold, a, de, ia, ib);
                for r in 0..rn {
                    paint.rect(Vec2 { x: rich.rectX(r), y: y }, Vec2 { x: rich.rectW(r), y: lh }, look.sel);
                }
            } else {
                let nr = textSelRects(font, view(s, a, de), bold, ia - a, maxi(ib, ia) - a);
                for r in 0..nr {
                    if selRectW(r) > 0.0 {
                        paint.rect(Vec2 { x: selRectX(r), y: y }, Vec2 { x: selRectW(r), y: lh }, look.sel);
                    }
                }
            }
            if tail > 0.0 {
                // the selected newline: a 4 px stub at the logical end of the line (the right edge of left-to-right text)
                paint.rect(Vec2 { x: caretAt(e, font, bold, s, a, de, de), y: y }, Vec2 { x: tail, y: lh }, look.sel);
            }
        }
        let at0 = if focused && k == ck { e.cur } else { -2 };
        let cx = if e.sp.len > 0 { rich.run(e, font, bold, a, de, at0, comp, y, look) } else { field.run(font, bold, s, a, de, at0, comp, y, look) };
        if focused && k == ck && cx >= 0.0 {
            at = Vec2 { x: cx, y: y };
            if blink {
                paint.rect(at, Vec2 { x: 1.0, y: lh }, look.caret);
            }
        }
    }
    return at;
}
