// Part of j3.ui.cssimage; `background-image` layers and the `background` shorthand with a `url()`. The module doc and `use`s are in ../cssimage.j3.
module j3.ui.cssimage;

/// One `background-image` layer at `TOK[j]` appended to `paints`: `url()` as `[LAYER_URL, pathId, 0]`, `none` as the same
/// with id -1, or a gradient. Returns tokens used, 0 when it is none of them.
fn imageLayer(p: &P, j: int, n: int): int {
    let t = tk(j);
    if t.kind == T_URL {
        pf(p, f32(LAYER_URL));
        pf(p, f32(p.css.intern(txt(p, t))));
        pf(p, 0.0);
        return 1;
    }
    if isWord(p, t, "none") {
        pf(p, f32(LAYER_URL));
        pf(p, -1.0);
        pf(p, 0.0);
        return 1;
    }
    return gradientAt(p, j, n);
}

/// Close the layer list that starts at `paints[head]` (count slot already pushed): a lone `url()` becomes a plain
/// `V_URL`, a lone `none` a `V_NONE`; more than `MAX_LAYERS` layers warn and the extra ones are never painted.
fn finishLayers(p: &P, head: int, count: int, at: int, out: &Value) {
    let a = p.css.paints.items;
    if count == 1 && int(a[head + 1]) == LAYER_URL {
        let id = int(a[head + 2]);
        p.css.paints.len = head;
        if id < 0 {
            out.kind = V_NONE;
        } else {
            out.kind = V_URL;
            out.i = id;
        }
        return;
    }
    if count > MAX_LAYERS {
        warnAt(p, tk(at).line, tk(at).col, "more than 8 background layers: the extra ones are ignored");
    }
    p.css.paints.items[head] = f32(count);
    setv(out, mk(V_GRAD, 0.0, head, 0));
}

/// `background-image` at `TOK[k..n)` when it has a `url()` among its layers (else `gradients` handles it);
/// returns tokens used, 0 when invalid.
pub fn bgImage(p: &P, k: int, n: int, out: &Value): int {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let j = k;
    let count = 0;
    while j < n {
        let used = imageLayer(p, j, n);
        if used == 0 {
            break;
        }
        count += 1;
        j += used;
        if j < n && tk(j).kind == T_COMMA {
            j += 1;
            if j >= n {
                count = 0;
            }
        } else {
            break;
        }
    }
    if count == 0 {
        p.css.paints.len = head;
        return 0;
    }
    finishLayers(p, head, count, k, out);
    return j - k;
}

/// Index of the first top-level comma in `TOK[j..n)`, or `n`.
fn layerEnd(j: int, n: int): int {
    let depth = 0;
    while j < n {
        let kd = tk(j).kind;
        if kd == T_FUNC || kd == T_LPAREN {
            depth += 1;
        } else if kd == T_RPAREN {
            depth -= 1;
        } else if kd == T_COMMA && depth <= 0 {
            return j;
        }
        j += 1;
    }
    return n;
}

/// The `background` shorthand when it has a `url()`: comma layers of `<image> <position> [/ <size>] <repeat>` in any order,
/// the last layer may also hold the base color. Fills the image, position, size, repeat and color values (every layer gets
/// an entry in each list, so the shorthand resets the longhands); false when invalid.
pub fn bgShorthand(p: &P, n: int, img: &Value, pos: &Value, sz: &Value, rep: &Value, col: &Value): bool {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let count = 0;
    let j = 0;
    let ok = true;
    col.kind = V_UNSET;
    while ok && j < n {
        let e = layerEnd(j, n);
        let last = e == n;
        let hasImg = false;
        let hasRep = false;
        let hasPos = false;
        let hasCol = false;
        // layers past the cap write to a spare slot
        let slot = count;
        if slot > MAX_LAYERS {
            slot = MAX_LAYERS;
        }
        // defaults: 0% 0%, auto auto, repeat repeat
        let po = slot * 4;
        LPOS[po] = 0.0; LPOS[po + 1] = f32(LU_PCT); LPOS[po + 2] = 0.0; LPOS[po + 3] = f32(LU_PCT);
        let so = slot * 5;
        LSIZE[so] = 0.0; LSIZE[so + 1] = 0.0; LSIZE[so + 2] = f32(LU_AUTO); LSIZE[so + 3] = 0.0; LSIZE[so + 4] = f32(LU_AUTO);
        LREP[slot * 2] = f32(REP_REPEAT);
        LREP[slot * 2 + 1] = f32(REP_REPEAT);
        while ok && j < e {
            let used = 0;
            if !hasImg {
                used = imageLayer(p, j, n);
                hasImg = used > 0;
            }
            if used == 0 && !hasRep {
                let r: [2]int = [0, 0];
                used = repeatVals(p, j, e, false, &r);
                if used > 0 {
                    LREP[slot * 2] = f32(r[0]);
                    LREP[slot * 2 + 1] = f32(r[1]);
                    hasRep = true;
                }
            }
            if used == 0 && !hasPos {
                used = posVals(p, j, e);
                if used > 0 {
                    for q in 0..4 {
                        LPOS[po + q] = PV[q];
                    }
                    hasPos = true;
                    if j + used < e && isSlash(j + used) {
                        let sused = size(p, j + used + 1, e);
                        if sused == 0 {
                            ok = false;
                        } else {
                            // `size` pushed its entry at the end of paints: copy it out and drop it
                            let at = p.css.paints.len - 5;
                            for q in 0..5 {
                                LSIZE[so + q] = p.css.paints.items[at + q];
                            }
                            p.css.paints.len = at;
                            used += 1 + sused;
                        }
                    }
                }
            }
            if used == 0 && last && !hasCol {
                used = parseColor(p, j, e, col);
                hasCol = used > 0;
            }
            if used == 0 {
                ok = false;
            }
            j += used;
        }
        if ok && !hasImg {
            // only the base color is allowed to stand without an image
            ok = last && hasCol && !hasPos && !hasRep;
            if ok && count == 0 {
                ok = false;
            }
        } else if ok {
            count += 1;
        }
        if !ok || e >= n {
            break;
        }
        j = e + 1;
        if j >= n {
            ok = false;
        }
    }
    if !ok || count == 0 {
        p.css.paints.len = head;
        return false;
    }
    finishLayers(p, head, count, 0, img);
    let k = count;
    if k > MAX_LAYERS {
        k = MAX_LAYERS;
    }
    setv(pos, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 4 { pf(p, LPOS[q]); }
    setv(sz, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 5 { pf(p, LSIZE[q]); }
    setv(rep, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 2 { pf(p, LREP[q]); }
    return true;
}
