/// Text side of CSS nesting for `j3.ui.cssparse`: splitting selector lists and joining a nested selector with its parent.
/// A joined selector is flat text (`.card:hover`), compiled like any other rule; there is no `:is()`, so only joins that mean the same
/// thing without it are made (see `join`).

module j3.ui.cssnest;

use j3.text.Text;

fn isIdent(c: int): bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95;
}

/// Split a selector list at its top-level commas: the part starting at `pos` goes to `lo..hi` (trimmed),
/// the result is where the next one starts, -1 after the last.
pub fn part(s: string, pos: int, lo: &int, hi: &int): int {
    if pos > s.len {
        return -1;
    }
    let i = pos;
    let depth = 0;
    let q = 0;
    while i < s.len {
        let c = int(s[i]);
        if q != 0 {
            if c == q {
                q = 0;
            }
        } else if c == 34 || c == 39 {
            q = c;
        } else if c == 40 || c == 91 {
            depth += 1;
        } else if c == 41 || c == 93 {
            depth -= 1;
        } else if c == 44 && depth == 0 {
            break;
        }
        i += 1;
    }
    let a = pos;
    let b = i;
    while a < b && int(s[a]) <= 32 {
        a += 1;
    }
    while b > a && int(s[b - 1]) <= 32 {
        b -= 1;
    }
    *lo = a;
    *hi = b;
    return i + 1;
}

/// Does selector `s` have a combinator (space, `>`, `+`, `~`) outside parentheses, brackets and strings?
fn hasComb(s: string): bool {
    let depth = 0;
    let q = 0;
    for i in 0..s.len {
        let c = int(s[i]);
        if q != 0 {
            if c == q {
                q = 0;
            }
        } else if c == 34 || c == 39 {
            q = c;
        } else if c == 40 || c == 91 {
            depth += 1;
        } else if c == 41 || c == 93 {
            depth -= 1;
        } else if depth == 0 && (c <= 32 || c == 62 || c == 43 || c == 126) {
            return true;
        }
    }
    return false;
}

/// Join nested selector `ns` with the parent selector `par` into `j`; "" when done, else why it cannot be (the nested rule is dropped).
/// - no `&`: a descendant (`par ns`);
/// - parent is one compound: `&` is replaced anywhere, any number of times (`& + &`, `.dark &`, `&.on`); a type selector moves to the
///   front of the compound it lands in (`.x&` on `div` is `div.x`);
/// - parent has combinators: `&` may lead the nested selector (`&:hover`, `&.on > li`), where gluing the rest on its last compound is
///   exact, or be the whole last part after a descendant space (`.dark &`), joined as `.dark .card .title` like Sass (`.x > &`, `.x + &` would bind to the wrong compound). Anywhere else the browser matches
///   `:is(parent)`, which this does not have.
pub fn join(j: &Text, par: string, ns: string): string {
    let amps = 0;
    for k in 0..ns.len {
        if int(ns[k]) == 38 {
            amps += 1;
        }
    }
    if amps == 0 {
        j.pushStr(par);
        j.push(32);
        j.pushStr(ns);
        return "";
    }
    let complex = hasComb(par);
    let tagLen = 0;
    if par.len > 0 && int(par[0]) == 42 {
        tagLen = 1;
    } else {
        while tagLen < par.len && isIdent(int(par[tagLen])) {
            tagLen += 1;
        }
    }
    // where the current compound starts in `j`
    let start = j.len();
    for k in 0..ns.len {
        let c = int(ns[k]);
        if c != 38 {
            j.push(ns[k]);
            if c <= 32 || c == 62 || c == 43 || c == 126 || c == 40 || c == 44 {
                start = j.len();
            }
            continue;
        }
        if k + 1 < ns.len && isIdent(int(ns[k + 1])) {
            return "`&` cannot be followed by a name (write `&.class`, `&:pseudo` or `& tag`)";
        }
        if complex {
            // `.dark &`: `&` alone as the last part is Sass's textual join, same as `:is()` unless the prefix's element is inside the parent's chain
            // only a descendant space before it: `.x > &` would bind the combinator to the parent's first compound, not its last
            let b = k;
            while b > 0 && int(ns[b - 1]) <= 32 {
                b -= 1;
            }
            let pc = if b > 0 { int(ns[b - 1]) } else { 0 };
            let ctx = amps == 1 && k == ns.len - 1 && b < k && pc != 62 && pc != 43 && pc != 126;
            if k != 0 && !ctx {
                return "`&` after other parts of the selector needs :is() when the parent has a combinator, which is not supported (write the parent out, or put `&` first)";
            }
            j.pushStr(par);
        } else if j.len() > start && tagLen > 0 {
            // `.x&` on `div`: the type selector goes first; a type already there cannot be doubled
            let at = int(j.str()[start]);
            if isIdent(at) || at == 42 {
                return "two type selectors in one compound (`&` is a tag here)";
            }
            j.insert(start, par[0..tagLen]);
            j.pushStr(par[tagLen..par.len]);
        } else {
            j.pushStr(par);
        }
    }
    return "";
}
