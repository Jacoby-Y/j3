/// In-game UI inspector, the browser devtools of a `.j3ui` app. `d.setInspector(true)` (or F12 with `J3_INSPECT=1`) turns it on: the element under
/// the pointer gets a box-model overlay (margin orange, border yellow, padding green, content blue) and a `tag.class#id  W×H` label, a click
/// pins an element (Escape unpins; Up goes to the parent, Down to the first child, Left/Right to the siblings), and a side panel shows the
/// pinned element: box, computed style (non-default properties), the matched rules in cascade order with `file:line` (declarations a later one
/// overrides are dimmed and struck through) and the custom properties in scope. The mouse wheel over the panel scrolls it.
///
/// While on, the app sees no clicks, wheel or keys (`Dom.beginFrame` hands it an idle input); the panel is drawn with `j3.gfx.paint` after
/// everything else (`inputs.overlay`), not as a component. Off, it costs a bool check per frame. The panel text is built only when the pinned
/// element, its style or its box changes. `inspect.text(d, id)` gives the same text without the panel, and `J3_INSPECT_DUMP=<selector>:<frame>`
/// (`#id`, `.class`, a tag, or a node number) prints it to stdout at that frame (1-based), for agents and tests.

module j3.ui.inspect;

use j3.game;
use j3.game.{ Color, Font, fontLine, textWidth };
use j3.gfx.paint;
use j3.io.printLn;
use j3.math.{ max, Vec2 };
use j3.memory.Arena;
use j3.text.{ same, Text };
use j3.ui.css.{ Css, Decl, Value, MatchNode, NPROPS, P_DEFER, P_ALL, PROP_NAMES, transCount, transDelay, transEase };
use j3.ui.css.{ P_ANIM_DELAY, P_ANIM_DUR, P_BG_POS, P_BG_REPEAT, P_BG_SIZE, P_BORDER_SLICE, P_GRID_COL0, P_OBJECT_POS, P_ORIGIN, P_WAVE_PERIOD };
use j3.ui.css.{ V_ANIM, V_AUTO, V_CALC, V_EASE, V_FR, V_GRAD, V_INHERIT, V_KW, V_LIST, V_NONE, V_NUM, V_PCT, V_REM, V_EM, V_SHADOW, V_STR, V_TRANS, V_URL, V_VAR, V_XFORM };
use j3.ui.cssmatch;
use j3.ui.inspectfmt.{ fmt, nth, valSame };
use j3.ui.cssvalue.{ initial, kwList };
use j3.ui.dom;
use j3.ui.dynattr;
use j3.ui.dom.{ Dom, edgesOf, fontOf };

const PANEL_W: f32 = 380.0;

/// Scratch arena `k` (0 panel text, 1 hover label): rewound per rebuild, so re-pinning never grows memory. Starts empty and grows on first use.
fn scratch(d: &Dom, k: int): &Arena {
    if !d.inspInit {
        for j in 0..2 {
            let a = &d.inspAr[j];
            a.ptr = 0 as ptr;
            a.used = 0;
            a.cap = 0;
            a.head = 0 as ptr;
        }
        d.inspInit = true;
    }
    return &d.inspAr[k];
}

/// Is `id` a live element the inspector can show (not text, a ghost, or a `::before` box)?
fn isEl(d: &Dom, id: int): bool {
    return id >= 0 && id < d.nodes.len && d.nodes.items[id].kind == dom.K_ELEM && !d.nodes.items[id].ghost && d.mnodes.items[id].pe == 0;
}

fn overPanel(d: &Dom): bool {
    return d.mx >= d.vw - PANEL_W;
}

// ---- input ---------------------------------------------------------------------------------------------

/// First live element in the sibling chain from `c` (following `next` or `prev`), -1 for none.
fn elFrom(d: &Dom, c: int, fwd: bool): int {
    while c >= 0 && !isEl(d, c) {
        c = if fwd { d.nodes.items[c].next } else { d.nodes.items[c].prev };
    }
    return c;
}

fn pin(d: &Dom, id: int) {
    d.inspPin = id;
    d.inspScroll = 0.0;
}

/// The inspector's share of a frame, after `Dom.beginFrame` took the input from the app (`inputs.begin` calls it): click pins, keys walk, wheel scrolls.
pub fn input(d: &Dom) {
    if d.inspPin >= 0 && !isEl(d, d.inspPin) { d.inspPin = -1; }
    let pressed = d.inspDown && !d.inspPrev;
    d.inspPrev = d.inspDown;
    let over = overPanel(d);
    if pressed && !over && isEl(d, d.rawHit) { pin(d, d.rawHit); }
    if over && d.inspWheel != 0.0 {
        d.inspScroll = max(0.0, d.inspScroll - d.inspWheel * 40.0);
    }
    let k = &d.inspIn;
    let p = d.inspPin;
    if k.esc { d.inspPin = -1; }
    if p < 0 { return; }
    let n = &d.nodes.items[p];
    if k.up && n.parent >= 0 { pin(d, n.parent); }
    else if k.down && elFrom(d, n.first, true) >= 0 { pin(d, elFrom(d, n.first, true)); }
    else if k.right && elFrom(d, n.next, true) >= 0 { pin(d, elFrom(d, n.next, true)); }
    else if k.left && elFrom(d, n.prev, false) >= 0 { pin(d, elFrom(d, n.prev, false)); }
}

// ---- text ----------------------------------------------------------------------------------------------

fn line(t: &Text, s: string) {
    t.pushStr(s);
    t.push(10);
}

fn nameOf(d: &Dom, id: int, t: &Text) {
    let mn = &d.mnodes.items[id];
    t.pushStr(d.css.name(mn.tag));
    for i in 0..mn.classes.len {
        t.push(46);
        t.pushStr(d.css.name(mn.classes[i]));
    }
    if mn.id >= 0 {
        t.push(35);
        t.pushStr(d.css.name(mn.id));
    }
}

fn edges4(t: &Text, label: string, a: f32, b: f32, c: f32, e: f32) {
    t.pushStr(label);
    t.pushFloat(a);
    t.push(32);
    t.pushFloat(b);
    t.push(32);
    t.pushFloat(c);
    t.push(32);
    t.pushFloat(e);
    t.push(10);
}

/// The panel text for element `id`. Lines that start with a space belong to the section above; a declaration a later rule overrides ends in
/// `(overridden)`.
pub fn text(d: &Dom, id: int): string {
    if !isEl(d, id) { return "(no element)\n"; }
    d.inspBuilds += 1;
    d.inspTxtPin = -1;
    // one scratch arena rewound per build, so re-pinning never grows memory (the result is valid until the next call)
    let am = scratch(d, 0);
    am.rewind(0);
    let css = d.css;
    let n = &d.nodes.items[id];
    let mn = &d.mnodes.items[id];
    let t = Text.new(am);
    nameOf(d, id, &t);
    t.pushStr(`  #{id}`);
    t.push(10);
    if mn.scope != 0 {
        t.pushStr(`component scope {mn.scope}:`);
        for s in 0..css.sheets.len {
            if css.sheets.items[s].scope == mn.scope {
                t.push(32);
                t.pushStr(css.sheets.items[s].file);
            }
        }
        t.push(10);
    }
    t.pushStr(`box: x={d.absX(id)} y={d.absY(id)} w={n.w} h={n.h}`);
    t.push(10);
    let basis = if n.parent >= 0 { d.nodes.items[n.parent].w } else { d.vw };
    let e = edgesOf(d, n.style, basis);
    edges4(&t, "margin: ", e.mt, e.mr, e.mb, e.ml);
    edges4(&t, "border: ", e.bt, e.br, e.bb, e.bl);
    edges4(&t, "padding: ", e.pt, e.pr, e.pb, e.pl);
    line(&t, "computed (non-default):");
    for q in 0..NPROPS {
        let v = css.get(n.style, q);
        if !valSame(v, initial(q)) {
            t.pushStr("  ");
            t.pushStr(nth(PROP_NAMES, q));
            t.pushStr(": ");
            fmt(d, &t, q, v);
            t.push(10);
        }
    }
    // matched rules, ascending cascade order: a property's last declaration wins
    let nm = cssmatch.collect(css, d.mnodes.items, id);
    let ids = am.alloc::<int>(nm + 1);
    for m in 0..nm { ids[m] = css.midx[m]; }
    let win = am.alloc::<int>(NPROPS);
    for q in 0..NPROPS { win[q] = -1; }
    for m in 0..nm {
        let rl = css.rules.items[ids[m]];
        for k in 0..rl.ndecl {
            let p = declProp(css, css.decls.items[rl.decl0 + k]);
            if p >= 0 && p < NPROPS { win[p] = m * 4096 + k; }
        }
    }
    // inline `style:` overrides beat every rule: listed first, and the rules' declarations they replace are marked
    let ninl = 0;
    if n.dyn >= 0 {
        let dy = &d.dyns.items[n.dyn];
        for sl in 0..dynattr.SLOTS {
            for j in 0..dy.sn[sl] {
                let ip = dy.sp[sl * dynattr.PER + j];
                if ip >= 0 && ip < NPROPS { win[ip] = -2; }
                ninl += 1;
            }
        }
    }
    line(&t, "matched rules (cascade order, later wins):");
    if ninl > 0 {
        let dz = &d.dyns.items[n.dyn];
        line(&t, "  style:  inline `style:` attributes (win over every rule)");
        for sl2 in 0..dynattr.SLOTS {
            for j2 in 0..dz.sn[sl2] {
                let ip2 = dz.sp[sl2 * dynattr.PER + j2];
                t.pushStr("    ");
                t.pushStr(if ip2 == P_ALL { "all" } else if ip2 >= 0 && ip2 < NPROPS { nth(PROP_NAMES, ip2) } else { "(deferred)" });
                t.pushStr(": ");
                fmt(d, &t, ip2, dz.sv[sl2 * dynattr.PER + j2]);
                t.push(10);
            }
        }
    }
    for m in 0..nm {
        let ru = css.rules.items[ids[m]];
        t.pushStr("  ");
        t.pushStr(if ru.file.len > 0 { ru.file } else { "(inline)" });
        t.push(58);
        t.pushInt(ru.line);
        t.pushStr(`  specificity {ru.spec / 10000},{ru.spec / 100 % 100},{ru.spec % 100}`);
        if ru.scope != 0 { t.pushStr(`  scope {ru.scope}`); }
        if ru.pe != 0 { t.pushStr(if ru.pe == 1 { "  ::before" } else { "  ::after" }); }
        t.push(10);
        for k in 0..ru.ndecl {
            let dc = css.decls.items[ru.decl0 + k];
            t.pushStr("    ");
            if dc.prop == P_DEFER {
                let df = css.dtpl.items[dc.v.i];
                t.pushStr(df.name);
                t.pushStr(": ");
                t.pushStr(df.text);
            } else if dc.prop == P_ALL {
                t.pushStr("all");
            } else if dc.prop >= NPROPS {
                t.pushStr(css.name(dc.prop - NPROPS));
                t.pushStr(": ");
                fmt(d, &t, dc.prop, dc.v);
            } else {
                t.pushStr(nth(PROP_NAMES, dc.prop));
                t.pushStr(": ");
                fmt(d, &t, dc.prop, dc.v);
            }
            let wp = declProp(css, dc);
            if wp >= 0 && wp < NPROPS && win[wp] != m * 4096 + k { t.pushStr("  (overridden)"); }
            t.push(10);
        }
    }
    line(&t, "custom properties:");
    let vs = css.varsOf(n.style);
    for k in 0..css.vsn.items[vs] {
        let c = css.vsEnt.items[css.vso.items[vs] + k];
        t.pushStr("  ");
        t.pushStr(css.name(c.name));
        t.pushStr(": ");
        fmt(d, &t, 0, c.v);
        t.push(10);
    }
    return t.str();
}

/// The property a declaration sets (a deferred one's longhand), -1 for `all` and shorthands that stay deferred.
fn declProp(css: &Css, dc: Decl): int {
    if dc.prop == P_DEFER { return css.dtpl.items[dc.v.i].prop; }
    if dc.prop == P_ALL { return -1; }
    return dc.prop;
}

// ---- dump ----------------------------------------------------------------------------------------------

fn hasClass(d: &Dom, id: int, name: string): bool {
    let mn = &d.mnodes.items[id];
    for i in 0..mn.classes.len {
        if same(d.css.name(mn.classes[i]), name) { return true; }
    }
    return false;
}

fn isNum(s: string): bool {
    for i in 0..s.len {
        if s[i] < 48 || s[i] > 57 { return false; }
    }
    return s.len > 0;
}

/// The first element matching `sel`: `#id`, `.class`, a tag, or a node number.
pub fn find(d: &Dom, sel: string): int {
    if isNum(sel) {
        let v = 0;
        for i in 0..sel.len { v = v * 10 + int(sel[i]) - 48; }
        return if isEl(d, v) { v } else { -1 };
    }
    for id in 0..d.nodes.len {
        if !isEl(d, id) { continue; }
        let mn = &d.mnodes.items[id];
        if sel[0] == 35 && mn.id >= 0 && same(d.css.name(mn.id), sel[1..sel.len]) { return id; }
        if sel[0] == 46 && hasClass(d, id, sel[1..sel.len]) { return id; }
        if sel[0] != 35 && sel[0] != 46 && same(d.css.name(mn.tag), sel) { return id; }
    }
    return -1;
}

/// `J3_INSPECT_DUMP=<selector>:<frame>`: at that frame (1-based) print the panel text of the first matching element, once.
pub fn dumpStep(d: &Dom) {
    let s = d.dumpSpec;
    let c = s.len;
    while c > 0 && s[c - 1] != 58 { c -= 1; }
    if c < 2 || !isNum(s[c..s.len]) {
        printLn("j3: J3_INSPECT_DUMP wants <selector>:<frame>; ignored");
        d.dumpSpec = "";
        return;
    }
    let fr = 0;
    for i in c..s.len { fr = fr * 10 + int(s[i]) - 48; }
    if d.frame != fr || d.nodes.len == 0 { return; }
    let id = find(d, s[0..c - 1]);
    d.dumpSpec = "";
    if id < 0 {
        printLn(`inspect: no element matches {s}`);
        return;
    }
    printLn(text(d, id));
}

// ---- paint ---------------------------------------------------------------------------------------------

fn col(r: int, g: int, b: int, a: int): Color {
    return Color { r: u8(r), g: u8(g), b: u8(b), a: u8(a) };
}

fn fill(x0: f32, y0: f32, x1: f32, y1: f32, c: Color) {
    if x1 > x0 && y1 > y0 {
        paint.rect(Vec2 { x: x0, y: y0 }, Vec2 { x: x1 - x0, y: y1 - y0 }, c);
    }
}

/// The band between the outer rect and the inner one (four strips).
fn band(ox0: f32, oy0: f32, ox1: f32, oy1: f32, ix0: f32, iy0: f32, ix1: f32, iy1: f32, c: Color) {
    fill(ox0, oy0, ox1, iy0, c);
    fill(ox0, iy1, ox1, oy1, c);
    fill(ox0, iy0, ix0, iy1, c);
    fill(ix1, iy0, ox1, iy1, c);
}

/// Margin, border, padding and content bands of `id`, translucent.
fn boxModel(d: &Dom, id: int, alpha: int) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, n.style, if n.parent >= 0 { d.nodes.items[n.parent].w } else { d.vw });
    let x = d.absX(id);
    let y = d.absY(id);
    let x1 = x + n.w;
    let y1 = y + n.h;
    band(x - e.ml, y - e.mt, x1 + e.mr, y1 + e.mb, x, y, x1, y1, col(246, 178, 107, alpha));
    band(x, y, x1, y1, x + e.bl, y + e.bt, x1 - e.br, y1 - e.bb, col(255, 229, 153, alpha));
    band(x + e.bl, y + e.bt, x1 - e.br, y1 - e.bb, x + e.bl + e.pl, y + e.bt + e.pt, x1 - e.br - e.pr, y1 - e.bb - e.pb, col(147, 196, 125, alpha));
    fill(x + e.bl + e.pl, y + e.bt + e.pt, x1 - e.br - e.pr, y1 - e.bb - e.pb, col(111, 168, 220, alpha));
}

fn drawText(font: Font, x: f32, y: f32, s: string, c: Color) {
    paint.text(font, Vec2 { x: x, y: y }, s, c);
}

fn label(d: &Dom, font: Font, id: int) {
    let n = &d.nodes.items[id];
    let key = id + 100003 * int(n.w) + 7919 * int(n.h);
    if key != d.inspLblKey || d.inspLbl.len == 0 {
        let lm = scratch(d, 1);
        lm.rewind(0);
        let t = Text.new(lm);
        nameOf(d, id, &t);
        t.pushStr(`  {int(n.w)}×{int(n.h)}`);
        d.inspLbl = t.str();
        d.inspLblKey = key;
    }
    let s = d.inspLbl;
    let lh = f32(fontLine(font));
    let w = textWidth(font, []u8 { ptr: s.ptr, len: s.len }, false) + 8.0;
    let y = d.absY(id) - lh - 6.0;
    if y < 0.0 { y = d.absY(id) + n.h + 2.0; }
    let x = d.absX(id);
    if x + w > d.vw - PANEL_W { x = d.vw - PANEL_W - w; }
    fill(x, y, x + w, y + lh + 4.0, col(30, 30, 34, 235));
    drawText(font, x + 4.0, y + 2.0, s, col(255, 255, 255, 255));
}

/// The pinned element's text, rebuilt only when the pin, its style or its box changed since the last call.
pub fn panelText(d: &Dom): string {
    let p = d.inspPin;
    if p < 0 || !isEl(d, p) { return ""; }
    let st = d.nodes.items[p];
    let key = st.style + 31 * int(st.w) + 997 * int(st.h) + 7919 * int(d.absX(p)) + 104729 * int(d.absY(p));
    if d.inspTxtPin != p || d.inspTxtStyle != key {
        d.inspTxt = text(d, p);
        d.inspTxtPin = p;
        d.inspTxtStyle = key;
    }
    return d.inspTxt;
}

fn panel(d: &Dom, font: Font) {
    let x0 = d.vw - PANEL_W;
    fill(x0, 0.0, d.vw, d.vh, col(24, 24, 28, 238));
    fill(x0, 0.0, x0 + 1.0, d.vh, col(90, 90, 100, 255));
    let p = d.inspPin;
    let lh = f32(fontLine(font));
    if p < 0 {
        drawText(font, x0 + 8.0, 6.0, "click an element to pin it", col(170, 170, 180, 255));
        drawText(font, x0 + 8.0, 6.0 + lh, "arrows walk, Esc unpins", col(170, 170, 180, 255));
        return;
    }
    let s = panelText(d);
    let nl = 0;
    for i in 0..s.len { if s[i] == 10 { nl += 1; } }
    let maxScroll = max(0.0, f32(nl) * lh + 12.0 - d.vh);
    if d.inspScroll > maxScroll { d.inspScroll = maxScroll; }
    paint.pushClip(Vec2 { x: x0 + 1.0, y: 0.0 }, Vec2 { x: PANEL_W - 1.0, y: d.vh });
    let y = 6.0 - d.inspScroll;
    let a = 0;
    for i in 0..s.len + 1 {
        if i < s.len && s[i] != 10 { continue; }
        let ln = s[a..i];
        a = i + 1;
        if ln.len > 0 && y > 0.0 - lh && y < d.vh {
            let over = ln.len > 14 && same(ln[ln.len - 14..ln.len], "  (overridden)");
            let head = ln[0] != 32;
            let c = if over { col(130, 130, 140, 255) } else if head { col(255, 214, 120, 255) } else { col(225, 225, 230, 255) };
            drawText(font, x0 + 8.0, y, ln, c);
            if over {
                let w = textWidth(font, []u8 { ptr: ln.ptr, len: ln.len }, false);
                fill(x0 + 8.0, y + lh * 0.55, x0 + 8.0 + w, y + lh * 0.55 + 1.0, c);
            }
        }
        y += lh;
    }
    paint.popClip();
}

/// Draw the highlights and the panel, above everything (`inputs.overlay` calls it when the inspector is on).
pub fn paintAll(d: &Dom) {
    if d.nodes.len == 0 { return; }
    let font = fontOf(d, d.nodes.items[0].style);
    let h = d.rawHit;
    let showHover = isEl(d, h) && !overPanel(d) && h != d.inspPin;
    if showHover {
        boxModel(d, h, 100);
        label(d, font, h);
    }
    if isEl(d, d.inspPin) { boxModel(d, d.inspPin, 150); }
    panel(d, font);
}
