/// The geometry of images in boxes, with no GL and no tree: `object-fit` / `object-position`,
/// `background-size` / `background-position` / `background-repeat` tiles, sprite-sheet frames, and the
/// SVG `viewBox` map. Everything is box-local px. `Place` is one draw: a source rect of the image placed
/// in a dest rect, already cut to the box (`dw <= 0` means nothing to draw).
///
/// ```
/// let pl = imgfit.fit(imgfit.COVER, 200.0, 100.0, 0.0, 0.0, 64.0, 64.0, 50.0, 1, 50.0, 1);
/// paint.imageSrc(tex, Vec2 { x: pl.sx, y: pl.sy }, Vec2 { x: pl.sw, y: pl.sh }, Vec2 { x: pl.dx, y: pl.dy }, Vec2 { x: pl.dw, y: pl.dh }, white);
/// ```

module j3.ui.imgfit;

use j3.math.{ ceil, floor, max, min };

/// `object-fit` modes (the order of `css.FIT_*`).
pub const FILL: int = 0;
pub const CONTAIN: int = 1;
pub const COVER: int = 2;
pub const NONE: int = 3;
pub const SCALE_DOWN: int = 4;

/// Tiles one `background-image` may repeat into; more draws it once.
pub const MAX_TILES: int = 4096;

pub struct Place {
    dx: f32;
    dy: f32;
    dw: f32;
    dh: f32;
    sx: f32;
    sy: f32;
    sw: f32;
    sh: f32;
}

pub struct Rect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

/// Place source rect `(sx, sy, sw, sh)` at `(dx, dy)` sized `dw` x `dh`, then cut it to the box
/// `0..bw` x `0..bh`, moving the source rect with the cut so pixels stay where they were.
pub fn crop(dx: f32, dy: f32, dw: f32, dh: f32, sx: f32, sy: f32, sw: f32, sh: f32, bw: f32, bh: f32): Place {
    let none = Place { dx: 0.0, dy: 0.0, dw: 0.0, dh: 0.0, sx: 0.0, sy: 0.0, sw: 0.0, sh: 0.0 };
    if dw <= 0.0 || dh <= 0.0 || sw <= 0.0 || sh <= 0.0 {
        return none;
    }
    let x0 = max(dx, 0.0);
    let y0 = max(dy, 0.0);
    let x1 = min(dx + dw, bw);
    let y1 = min(dy + dh, bh);
    if x1 <= x0 || y1 <= y0 {
        return none;
    }
    let kx = sw / dw;
    let ky = sh / dh;
    return Place { dx: x0, dy: y0, dw: x1 - x0, dh: y1 - y0, sx: sx + (x0 - dx) * kx, sy: sy + (y0 - dy) * ky, sw: (x1 - x0) * kx, sh: (y1 - y0) * ky };
}

/// A position component in px for free space `free` (box minus object): unit 1 is a percentage of it.
fn offset(v: f32, unit: int, free: f32): f32 {
    if unit == 1 {
        return free * v / 100.0;
    }
    return v;
}

/// `object-fit` mode `mode` of the source rect `(sx, sy, sw, sh)` in a `bw` x `bh` content box at
/// `object-position` `(px, pxu, py, pyu)` (unit 0 px, 1 %).
pub fn fit(mode: int, bw: f32, bh: f32, sx: f32, sy: f32, sw: f32, sh: f32, px: f32, pxu: int, py: f32, pyu: int): Place {
    let none = Place { dx: 0.0, dy: 0.0, dw: 0.0, dh: 0.0, sx: 0.0, sy: 0.0, sw: 0.0, sh: 0.0 };
    if sw <= 0.0 || sh <= 0.0 || bw <= 0.0 || bh <= 0.0 {
        return none;
    }
    let cw = bw;
    let ch = bh;
    let k = min(bw / sw, bh / sh);
    if mode == CONTAIN || (mode == SCALE_DOWN && k < 1.0) {
        cw = sw * k;
        ch = sh * k;
    } else if mode == COVER {
        k = max(bw / sw, bh / sh);
        cw = sw * k;
        ch = sh * k;
    } else if mode == NONE || mode == SCALE_DOWN {
        cw = sw;
        ch = sh;
    }
    return crop(offset(px, pxu, bw - cw), offset(py, pyu, bh - ch), cw, ch, sx, sy, sw, sh, bw, bh);
}

/// How a tile repeats along one axis (`background-repeat`, `border-image-repeat`): `REP_REPEAT` tiles
/// at natural size, `REP_NONE` (`no-repeat`, `stretch`) is one, `REP_SPACE` whole tiles with the
/// leftover shared out as gaps, `REP_ROUND` scales the tile so a whole number fits.
pub const REP_REPEAT: int = 0;
pub const REP_NONE: int = 1;
pub const REP_SPACE: int = 2;
pub const REP_ROUND: int = 3;

/// The tiles along one axis: `n` of them from `start` (the first may begin before 0), `step` apart, each `size` long.
pub struct Axis {
    n: int;
    start: f32;
    step: f32;
    size: f32;
}

/// A tile length scaled to the nearest whole number of tiles in `span` (at least one).
pub fn roundLen(span: f32, tile: f32): f32 {
    if tile <= 0.0 || span <= 0.0 {
        return tile;
    }
    let k = floor(span / tile + 0.5);
    if k < 1.0 {
        k = 1.0;
    }
    return span / k;
}

/// One axis of `span` px tiled with `tile`-long tiles in `mode`; `anchor` is where a tile starts (the
/// background position, or the centered spot for a border image). More than `MAX_TILES` makes one tile.
pub fn axis(mode: int, span: f32, tile: f32, anchor: f32): Axis {
    let a = Axis { n: 1, start: anchor, step: tile, size: tile };
    if tile <= 0.0 || span <= 0.0 {
        a.n = 0;
        return a;
    }
    if mode == REP_NONE {
        return a;
    }
    if mode == REP_SPACE {
        let k = int(floor(span / tile));
        if k >= 2 && k <= MAX_TILES {
            a.n = k;
            a.start = 0.0;
            a.step = tile + (span - f32(k) * tile) / f32(k - 1);
        }
        return a;
    }
    if mode == REP_ROUND {
        a.size = roundLen(span, tile);
        a.step = a.size;
    }
    let s = anchor - a.step * ceil(anchor / a.step);
    let n = int(ceil((span - s) / a.step - 0.0001));
    if n < 1 { n = 1; }
    if n <= MAX_TILES {
        a.n = n;
        a.start = s;
    }
    return a;
}

/// The tile of a `background-image`: its size, and the tiles to draw as a grid starting at
/// `(x0, y0)` with `nx` x `ny` cells, `sx` x `sy` apart (more than the size with `space`).
pub struct Tiles {
    w: f32;
    h: f32;
    x0: f32;
    y0: f32;
    nx: int;
    ny: int;
    sx: f32;
    sy: f32;
}

/// One axis of a tile size: unit 0 px, 1 % of the box, 2 auto (`other` keeps the aspect, else natural).
fn tileLen(v: f32, unit: int, box: f32, nat: f32, otherLen: f32, otherNat: f32): f32 {
    if unit == 0 {
        return v;
    }
    if unit == 1 {
        return box * v / 100.0;
    }
    if otherLen >= 0.0 && otherNat > 0.0 {
        return nat * otherLen / otherNat;
    }
    return nat;
}

/// `tilesR` with `repeat` / `no-repeat` per axis.
pub fn tiles(mode: int, szx: f32, szxu: int, szy: f32, szyu: int, posx: f32, posxu: int, posy: f32, posyu: int, repeatX: bool, repeatY: bool, bw: f32, bh: f32, iw: f32, ih: f32): Tiles {
    let rx = REP_NONE;
    let ry = REP_NONE;
    if repeatX { rx = REP_REPEAT; }
    if repeatY { ry = REP_REPEAT; }
    return tilesR(mode, szx, szxu, szy, szyu, posx, posxu, posy, posyu, rx, ry, bw, bh, iw, ih);
}

/// Where the tiles of an image `iw` x `ih` go in a `bw` x `bh` box. `mode` 0 uses the lengths (value and
/// unit per axis, unit 2 auto), 1 cover, 2 contain. `rx` / `ry` are the `REP_*` modes per axis.
pub fn tilesR(mode: int, szx: f32, szxu: int, szy: f32, szyu: int, posx: f32, posxu: int, posy: f32, posyu: int, rx: int, ry: int, bw: f32, bh: f32, iw: f32, ih: f32): Tiles {
    let t = Tiles { w: 0.0, h: 0.0, x0: 0.0, y0: 0.0, nx: 0, ny: 0, sx: 0.0, sy: 0.0 };
    if iw <= 0.0 || ih <= 0.0 || bw <= 0.0 || bh <= 0.0 {
        return t;
    }
    if mode == 1 {
        let kc = max(bw / iw, bh / ih);
        t.w = iw * kc;
        t.h = ih * kc;
    } else if mode == 2 {
        let kn = min(bw / iw, bh / ih);
        t.w = iw * kn;
        t.h = ih * kn;
    } else {
        t.w = tileLen(szx, szxu, bw, iw, -1.0, ih);
        t.h = tileLen(szy, szyu, bh, ih, t.w, iw);
        if szxu == 2 && szyu != 2 {
            t.w = tileLen(szx, szxu, bw, iw, t.h, ih);
        }
    }
    if t.w <= 0.0 || t.h <= 0.0 {
        t.w = 0.0;
        t.h = 0.0;
        return t;
    }
    // round fits a whole number of tiles; an `auto` other axis follows to keep the aspect (unless it rounds itself)
    let ow = t.w;
    let oh = t.h;
    if rx == REP_ROUND {
        t.w = roundLen(bw, ow);
        if mode == 0 && szyu == 2 && ry != REP_ROUND { t.h = oh * t.w / ow; }
    }
    if ry == REP_ROUND {
        t.h = roundLen(bh, oh);
        if mode == 0 && szxu == 2 && rx != REP_ROUND { t.w = ow * t.h / oh; }
    }
    let ax = axis(rx, bw, t.w, offset(posx, posxu, bw - t.w));
    let ay = axis(ry, bh, t.h, offset(posy, posyu, bh - t.h));
    t.x0 = ax.start;
    t.y0 = ay.start;
    t.nx = ax.n;
    t.ny = ay.n;
    t.sx = ax.step;
    t.sy = ay.step;
    if t.nx * t.ny > MAX_TILES {
        t.nx = 1;
        t.ny = 1;
        t.x0 = offset(posx, posxu, bw - t.w);
        t.y0 = offset(posy, posyu, bh - t.h);
    }
    return t;
}

/// Tile the source rect `(sx, sy, sw, sh)` over a `dw` x `dh` cell with `tw` x `th` tiles, centered, in
/// the `REP_*` modes `mx` / `my` (`REP_NONE` stretches that axis over the whole cell). Writes quads
/// `[x, y, w, h, sx, sy, sw, sh]` (x, y cell-local, cut to the cell with the source cut alongside) to `out`;
/// returns how many. `space` draws nothing when one tile does not fit.
pub fn tileCell(dw: f32, dh: f32, sx: f32, sy: f32, sw: f32, sh: f32, tw: f32, th: f32, mx: int, my: int, out: []f32): int {
    if dw <= 0.0 || dh <= 0.0 || sw <= 0.0 || sh <= 0.0 {
        return 0;
    }
    if mx == REP_NONE { tw = dw; }
    if my == REP_NONE { th = dh; }
    if (mx == REP_SPACE && dw < tw) || (my == REP_SPACE && dh < th) {
        return 0;
    }
    // repeat centers the pattern; round fits whole tiles, so it starts at the edge
    let ax = axis(mx, dw, tw, if mx == REP_ROUND { 0.0 } else { (dw - tw) * 0.5 });
    let ay = axis(my, dh, th, if my == REP_ROUND { 0.0 } else { (dh - th) * 0.5 });
    if ax.n * ay.n > MAX_TILES {
        ax = axis(REP_NONE, dw, dw, 0.0);
        ay = axis(REP_NONE, dh, dh, 0.0);
    }
    let n = 0;
    let cap = out.len / 8;
    for iy in 0..ay.n {
        for ix in 0..ax.n {
            let px = ax.start + f32(ix) * ax.step;
            let py = ay.start + f32(iy) * ay.step;
            let x0 = max(px, 0.0);
            let y0 = max(py, 0.0);
            let x1 = min(px + ax.size, dw);
            let y1 = min(py + ay.size, dh);
            if x1 - x0 > 0.0001 && y1 - y0 > 0.0001 && n < cap {
                let o = n * 8;
                out[o + 4] = sx + (x0 - px) / ax.size * sw;
                out[o + 5] = sy + (y0 - py) / ay.size * sh;
                out[o + 6] = (x1 - x0) / ax.size * sw;
                out[o + 7] = (y1 - y0) / ay.size * sh;
                // neighbors share whole-pixel edges: no hairline seams between tiles, crisp pixel art
                if ax.n * ay.n > 1 {
                    x0 = floor(x0 + 0.5);
                    y0 = floor(y0 + 0.5);
                    x1 = floor(x1 + 0.5);
                    y1 = floor(y1 + 0.5);
                }
                if x1 > x0 && y1 > y0 {
                    out[o] = x0;
                    out[o + 1] = y0;
                    out[o + 2] = x1 - x0;
                    out[o + 3] = y1 - y0;
                    n += 1;
                }
            }
        }
    }
    return n;
}

/// Frame `frame` (rounded down, wrapped into the sheet) of a `cols` x `rows` sprite sheet that is
/// `iw` x `ih` px, as a source rect.
pub fn cell(cols: int, rows: int, iw: f32, ih: f32, frame: int): Rect {
    let c = cols;
    let r = rows;
    if c < 1 { c = 1; }
    if r < 1 { r = 1; }
    let n = c * r;
    let f = frame % n;
    if f < 0 {
        f += n;
    }
    let w = iw / f32(c);
    let h = ih / f32(r);
    return Rect { x: f32(f % c) * w, y: f32(f / c) * h, w: w, h: h };
}

/// The frame a sprite shows `nowMs` after the start: `fps` frames per second from `first` (a static
/// frame number when `fps` is 0), over `count` frames.
pub fn frameAt(first: f32, fps: f32, nowMs: f32, count: int): int {
    let f = first;
    if fps != 0.0 {
        f = first + floor(nowMs * fps / 1000.0);
    }
    let i = int(floor(f));
    if count < 1 {
        return 0;
    }
    i = i % count;
    if i < 0 {
        i += count;
    }
    return i;
}

/// An SVG `viewBox` fitted into a `bw` x `bh` box (`preserveAspectRatio` xMidYMid meet): device = user * s + (ox, oy).
pub struct ViewMap {
    s: f32;
    ox: f32;
    oy: f32;
}

pub fn viewMap(bw: f32, bh: f32, vx: f32, vy: f32, vw: f32, vh: f32): ViewMap {
    if vw <= 0.0 || vh <= 0.0 {
        return ViewMap { s: 1.0, ox: 0.0, oy: 0.0 };
    }
    let s = min(bw / vw, bh / vh);
    return ViewMap { s: s, ox: (bw - vw * s) * 0.5 - vx * s, oy: (bh - vh * s) * 0.5 - vy * s };
}
