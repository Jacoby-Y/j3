// Part of j3.ui.cssparse; declarations: `declare`, custom properties, `url()` paths, invalid-value warnings. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

/// Vendor and legacy names for properties that have a standard spelling here.
fn realName(name: string): string {
    if same(name, "-webkit-text-stroke-width") { return "text-stroke-width"; }
    if same(name, "-webkit-text-stroke-color") { return "text-stroke-color"; }
    if same(name, "-webkit-background-clip") { return "background-clip"; }
    if same(name, "word-wrap") { return "overflow-wrap"; }
    return name;
}

/// `--name: value`: a custom property declaration, kept in `css.decls` as prop `NPROPS + interned name`.
fn custom(p: &P, name: string, n: int): bool {
    let v = mk(V_UNSET, 0.0, 0, 0);
    if n == 1 && wideKind(p, tk(0)) > 0 {
        emit(p, NPROPS + p.css.intern(name), mk(wideKind(p, tk(0)), 0.0, 0, 0));
        return true;
    }
    if n == 0 || parseCustom(p, 0, n, &v) != n {
        return false;
    }
    emit(p, NPROPS + p.css.intern(name), v);
    return true;
}

fn dirOf(file: string): int {
    let i = file.len;
    while i > 0 && int(file[i - 1]) != 47 {
        i -= 1;
    }
    return i;
}

/// `rel` against the directory of `file`, collapsing leading `../`.
fn joinPath(p: &P, rel: string): string {
    let d = dirOf(p.file);
    let dir = p.file[0..d];
    let r = rel;
    if r.len > 0 && int(r[0]) == 47 {
        return r;
    }
    while true {
        if r.len >= 3 && int(r[0]) == 46 && int(r[1]) == 46 && int(r[2]) == 47 && dir.len > 0 {
            // drop one directory segment
            let e = dir.len - 1;
            let s = e;
            while s > 0 && int(dir[s - 1]) != 47 {
                s -= 1;
            }
            if same(dir[s..e], "..") {
                break;
            }
            dir = dir[0..s];
            r = r[3..];
        } else if r.len >= 2 && int(r[0]) == 46 && int(r[1]) == 47 {
            r = r[2..];
        } else {
            break;
        }
    }
    let t = Text.new(p.css.mem);
    t.pushStr(dir);
    t.pushStr(r);
    return t.str();
}

/// Handle one `name: TOK[0..n)`.
fn declare(p: &P, name: string, line: int, col: int, n: int) {
    if p.mode == 1 {
        if same(name, "font-family") && n >= 1 && (tk(0).kind == T_STR || tk(0).kind == T_IDENT) {
            p.ffFamily = p.css.intern(txt(p, tk(0)));
            p.ffHave = true;
        } else if same(name, "src") && n >= 1 && tk(0).kind == T_URL {
            p.ffPath = joinPath(p, txt(p, tk(0)));
        } else {
            warnName(p, line, col, "unsupported @font-face declaration '", name, "'");
        }
        return;
    }
    if p.mode == 2 {
        descriptor(p, name, line, col, n);
        return;
    }
    let ok = false;
    name = realName(name);
    let d0 = p.css.decls.len;
    let w0 = p.css.warns.len;
    let nd0 = p.ndecl;
    let wk = 0;
    if n == 1 {
        wk = wideKind(p, tk(0));
    }
    if name.len > 2 && int(name[0]) == 45 && int(name[1]) == 45 {
        ok = custom(p, name, n);
    } else if wk > 0 && wideShort(p, name, mk(wk, 0.0, 0, 0)) {
        ok = true;
    } else if same(name, "padding") {
        ok = box4(p, P_PADDING_TOP, n);
    } else if same(name, "margin") {
        ok = box4(p, P_MARGIN_TOP, n);
    } else if same(name, "scroll-padding") {
        ok = box4(p, P_SCROLL_PAD, n);
    } else if same(name, "scroll-margin") {
        ok = box4(p, P_SCROLL_MARGIN, n);
    } else if same(name, "inset") {
        ok = box4(p, -1, n);
    } else if same(name, "border-color") {
        ok = box4(p, P_BORDER_TOP_COLOR, n);
    } else if same(name, "border-width") {
        ok = box4(p, P_BORDER_TOP_WIDTH, n);
    } else if same(name, "border-radius") {
        ok = box4(p, P_RADIUS_TL, n);
    } else if same(name, "border") {
        ok = borderSides(p, 0, 4, n);
    } else if same(name, "border-top") {
        ok = borderSides(p, 0, 1, n);
    } else if same(name, "border-right") {
        ok = borderSides(p, 1, 1, n);
    } else if same(name, "border-bottom") {
        ok = borderSides(p, 2, 1, n);
    } else if same(name, "border-left") {
        ok = borderSides(p, 3, 1, n);
    } else if same(name, "outline") {
        ok = outline(p, n);
    } else if same(name, "text-decoration") {
        ok = decoration(p, n);
    } else if same(name, "overflow") {
        ok = overflow2(p, n);
    } else if same(name, "scrollbar-color") {
        ok = scrollbarColor(p, n);
    } else if same(name, "gap") {
        let a = mk(V_UNSET, 0.0, 0, 0);
        let used = parseVal(p, P_GAP, 0, n, &a);
        if used > 0 && used == n {
            emit(p, P_ROW_GAP, a);
            emit(p, P_GAP, a);
            ok = true;
        } else if used > 0 {
            let b = mk(V_UNSET, 0.0, 0, 0);
            if parseVal(p, P_GAP, used, n, &b) == n - used {
                emit(p, P_ROW_GAP, a);
                emit(p, P_GAP, b);
                ok = true;
            }
        }
    } else if same(name, "-webkit-text-stroke") || same(name, "text-stroke") {
        ok = stroke(p, n);
    } else if same(name, "text-wave") {
        ok = wave(p, n);
    } else if same(name, "font") {
        if n == 1 && isWord(p, tk(0), "inherit") {
            let inh = mk(V_INHERIT, 0.0, 0, 0);
            emit(p, P_FONT_SIZE, inh);
            emit(p, P_FONT_WEIGHT, inh);
            emit(p, P_FONT_FAMILY, inh);
            emit(p, P_LINE_HEIGHT, inh);
            ok = true;
        }
    } else if cssgrid.declare(p, name, n, &ok) {
    } else if same(name, "transition") {
        ok = transitions(p, n);
    } else if same(name, "animation") {
        ok = animation(p, n);
    } else if same(name, "background") {
        let bgv = mk(V_UNSET, 0.0, 0, 0);
        let img = mk(V_NONE, 0.0, 0, 0);
        let nused = 0;
        if n > 0 && hasUrl(0, n) {
            // image layers with url(): the shorthand also sets position, size and repeat per layer
            let pos = mk(V_NONE, 0.0, 0, 0);
            let sz = mk(V_NONE, 0.0, 0, 0);
            let rep = mk(V_NONE, 0.0, 0, 0);
            ok = bgShorthand(p, n, &img, &pos, &sz, &rep, &bgv);
            if ok {
                if bgv.kind == V_UNSET {
                    bgv = mk(V_COLOR, 0.0, 0, 0);
                }
                emit(p, P_BG_IMAGE, img);
                emit(p, P_BACKGROUND, bgv);
                emit(p, P_BG_REPEAT, rep);
                emit(p, P_BG_SIZE, sz);
                emit(p, P_BG_POS, pos);
            }
        } else if n > 0 && tk(0).kind == T_FUNC && tk(0).e - tk(0).s > 9 {
            nused = gradients(p, 0, n, &img, true);
            if nused > 0 && nused < n && tk(nused).kind == T_COMMA {
                // the last layer may be a base color
                ok = parseVal(p, P_BACKGROUND, nused + 1, n, &bgv) == n - nused - 1;
            } else {
                ok = nused == n;
                bgv = mk(V_COLOR, 0.0, 0, 0);
            }
            if ok {
                emit(p, P_BG_IMAGE, img);
                emit(p, P_BACKGROUND, bgv);
            }
        } else {
            ok = parseVal(p, P_BACKGROUND, 0, n, &bgv) == n && n > 0;
            if ok {
                emit(p, P_BG_IMAGE, img);
                emit(p, P_BACKGROUND, bgv);
            }
        }
    } else if same(name, "border-image") {
        let bi = mk(V_UNSET, 0.0, 0, 0);
        let sl = mk(V_NONE, 0.0, 0, 0);
        let wd = mk(V_NONE, 0.0, 0, 0);
        let ot = mk(V_NONE, 0.0, 0, 0);
        let rp = mk(V_NONE, 0.0, 0, 0);
        ok = n > 0 && borderImage(p, n, &bi, &sl, &wd, &ot, &rp);
        if ok {
            if bi.kind == V_UNSET {
                bi = mk(V_NONE, 0.0, 0, 0);
            }
            emit(p, P_BORDER_IMAGE, bi);
            emit(p, P_BORDER_SLICE, sl);
            emit(p, P_BORDER_REPEAT, rp);
            emit(p, P_BORDER_IMG_W, wd);
            emit(p, P_BORDER_OUTSET, ot);
        }
    } else {
        let prop = propId(name);
        if prop < 0 {
            warnName(p, line, col, "unknown property '", name, "'");
            return;
        }
        let v = mk(V_UNSET, 0.0, 0, 0);
        if prop >= P_ANIM_NAME && prop <= P_ANIM_FILL && hasListComma(p, n) {
            ok = animList(p, prop, n);
        } else if wk > 0 {
            emit(p, prop, mk(wk, 0.0, 0, 0));
            ok = true;
        } else {
            ok = n > 0 && parseVal(p, prop, 0, n, &v) == n;
            if ok {
                emit(p, prop, v);
            }
        }
    }
    if !ok && p.late && p.ve > p.vs && !(name.len > 2 && int(name[0]) == 45 && int(name[1]) == 45) && hasVar(p, n) {
        // `var()` inside a compound value: keep the text, the cascade substitutes and parses it again
        p.css.decls.len = d0;
        p.css.warns.len = w0;
        p.ndecl = nd0;
        p.css.dtpl.push(Deferred { name: name, prop: propId(name), text: p.lx.src[p.vs..p.ve], file: p.file, line: line, col: col, warned: false });
        emit(p, P_DEFER, mk(V_UNSET, 0.0, p.css.dtpl.len - 1, 0));
        return;
    }
    if !ok && !p.late && hasVar(p, n) && !(name.len > 2 && int(name[0]) == 45 && int(name[1]) == 45) {
        warnName(p, line, col, "var() inside a compound value is not supported in style: text ('", name, "'): put the declaration in a class of a stylesheet");
    } else if !ok {
        for i in 0..n {
            if n > 1 && wideKind(p, tk(i)) > 0 {
                warnName(p, line, col, "inherit, initial, unset and revert must be the whole value of '", name, "'");
                return;
            }
        }
        warnInvalid(p, name, line, col, n);
    }
}

/// `invalid value 'TEXT' for 'NAME'`, plus what the property takes when that is short.
fn warnInvalid(p: &P, name: string, line: int, col: int, n: int) {
    let m = Text.new(p.css.mem);
    m.pushStr("invalid value ");
    if n > 0 {
        m.pushStr("'");
        // token spans leave out a leading `#` and string quotes: widen to the written text
        let a = tk(0).s;
        let b = tk(n - 1).e;
        if a > 0 && (int(p.lx.src[a - 1]) == 35 || int(p.lx.src[a - 1]) == 34 || int(p.lx.src[a - 1]) == 39) { a -= 1; }
        if b < p.lx.src.len && (int(p.lx.src[b]) == 34 || int(p.lx.src[b]) == 39) { b += 1; }
        m.pushStr(p.lx.src[a..b]);
        m.pushStr("' ");
    }
    m.pushStr("for '");
    m.pushStr(name);
    m.pushStr("'");
    let ex = expects(propId(name));
    if ex.len > 0 {
        m.pushStr(": expected ");
        if catOf(propId(name)) == C_KW {
            m.pushStr("one of ");
        }
        m.pushStr(ex);
    }
    warnAt(p, line, col, m.str());
}

/// Does `TOK[0..n)` contain a `var(`?
fn hasVar(p: &P, n: int): bool {
    for i in 0..n {
        if tk(i).kind == T_FUNC && same(txt(p, tk(i)), "var") {
            return true;
        }
    }
    return false;
}
