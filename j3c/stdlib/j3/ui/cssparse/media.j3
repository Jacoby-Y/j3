// Part of j3.ui.cssparse; `@media` conditions and the at-rule dispatch. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

/// `@media screen and (min-width: 600px) and (max-height: 400px) { rules }`: width and height bounds
/// in px joined by `and` (`screen`, `all`, `only` are accepted and ignored), `not` before a condition,
/// and alternatives separated by `,` or `or`. The rules inside carry the condition (`Rule.mq`);
/// `Css.setViewport` decides when it holds. Also `(prefers-reduced-motion: reduce | no-preference)` and
/// `(prefers-color-scheme: dark | light)`, answered by `Css.setPrefs` (the program's choice, not the OS's), and
/// `(pointer: coarse | fine)` / `(hover: none | hover)`, answered by `Css.setTouch`.
/// Inside another `@media` (or in a style rule) the conditions AND (`Media.and`). Not supported: other features, parenthesised `and`/`or` groups.
fn media(p: &P, at: Token): bool {
    let fresh = Media { minW: -1.0, maxW: 1000000000.0, minH: -1.0, maxH: 1000000000.0, neg: false, alt: -1, rm: 0, cs: 0, ptr: 0, hov: 0, and: -1 };
    if p.mqd >= 8 {
        warnAt(p, at.line, at.col, "@media nested more than 8 deep is skipped");
        skipBlock(p);
        return false;
    }
    // inside another @media the enclosing condition must hold too
    let outer = p.mq;
    let m = fresh;
    let css = p.css;
    let base = css.media.len;
    let last = -1;
    let bad = false;
    while true {
        let t = next(&p.lx);
        if t.kind == T_EOF {
            css.media.len = base;
            return false;
        }
        if t.kind == T_LBRACE || t.kind == T_COMMA || isWord(p, &t, "or") {
            // one alternative is complete
            m.and = outer;
            css.media.push(m);
            if last >= 0 {
                css.media.items[last].alt = css.media.len - 1;
            }
            last = css.media.len - 1;
            m = fresh;
            if t.kind == T_LBRACE {
                break;
            }
        } else if t.kind == T_IDENT {
            if isWord(p, &t, "not") {
                m.neg = true;
            } else if !(isWord(p, &t, "screen") || isWord(p, &t, "all") || isWord(p, &t, "and") || isWord(p, &t, "only")) {
                bad = true;
            }
        } else if t.kind == T_LPAREN {
            let nm = next(&p.lx);
            let co = next(&p.lx);
            let v = next(&p.lx);
            let rp = next(&p.lx);
            let unit = p.lx.src[v.us..v.ue];
            if nm.kind == T_IDENT && co.kind == T_COLON && v.kind == T_IDENT && rp.kind == T_RPAREN && isWord(p, &nm, "prefers-reduced-motion")
                && (isWord(p, &v, "reduce") || isWord(p, &v, "no-preference")) {
                m.rm = if isWord(p, &v, "reduce") { 1 } else { 2 };
            } else if nm.kind == T_IDENT && co.kind == T_COLON && v.kind == T_IDENT && rp.kind == T_RPAREN && isWord(p, &nm, "prefers-color-scheme")
                && (isWord(p, &v, "dark") || isWord(p, &v, "light")) {
                m.cs = if isWord(p, &v, "dark") { 1 } else { 2 };
            } else if nm.kind == T_IDENT && co.kind == T_COLON && v.kind == T_IDENT && rp.kind == T_RPAREN && isWord(p, &nm, "pointer")
                && (isWord(p, &v, "coarse") || isWord(p, &v, "fine")) {
                m.ptr = if isWord(p, &v, "coarse") { 1 } else { 2 };
            } else if nm.kind == T_IDENT && co.kind == T_COLON && v.kind == T_IDENT && rp.kind == T_RPAREN && isWord(p, &nm, "hover")
                && (isWord(p, &v, "none") || isWord(p, &v, "hover")) {
                m.hov = if isWord(p, &v, "none") { 1 } else { 2 };
            } else if nm.kind != T_IDENT || co.kind != T_COLON || v.kind != T_NUM || rp.kind != T_RPAREN || !(unit.len == 0 || same(unit, "px")) {
                bad = true;
            } else if isWord(p, &nm, "min-width") {
                m.minW = v.f;
            } else if isWord(p, &nm, "max-width") {
                m.maxW = v.f;
            } else if isWord(p, &nm, "min-height") {
                m.minH = v.f;
            } else if isWord(p, &nm, "max-height") {
                m.maxH = v.f;
            } else {
                bad = true;
            }
        } else {
            bad = true;
        }
    }
    if bad {
        css.media.len = base;
        warnAt(p, at.line, at.col, "unsupported @media condition (use screen and (min-width: Npx) and (max-width: Npx), also heights, prefers-reduced-motion, prefers-color-scheme, pointer, hover; not, comma and or lists)");
        skipBlock(p);
        return false;
    }
    p.mq = base;
    if css.media.len == base + 1 {
        // a single plain condition: share an equal earlier entry
        let n = css.media.items[base];
        for i in 0..base {
            let o = css.media.items[i];
            if o.minW == n.minW && o.maxW == n.maxW && o.minH == n.minH && o.maxH == n.maxH && o.neg == n.neg && o.alt == n.alt && o.rm == n.rm && o.cs == n.cs && o.ptr == n.ptr && o.hov == n.hov && o.and == n.and {
                p.mq = i;
                css.media.len = base;
                return true;
            }
        }
    }
    return true;
}

fn atRule(p: &P, at: Token) {
    if same(txt(p, &at), "media") {
        let saved = p.mq;
        if media(p, at) {
            MQS[p.mqd] = saved;
            p.mqd += 1;
        }
        return;
    }
    if same(txt(p, &at), "font-face") {
        let b = next(&p.lx);
        if b.kind != T_LBRACE {
            warnAt(p, at.line, at.col, "@font-face needs a block");
            return;
        }
        p.mode = 1;
        p.ffHave = false;
        p.ffPath = "";
        parseBlock(p);
        p.mode = 0;
        if p.ffHave && p.ffPath.len > 0 {
            p.css.fonts.push(FontFace { family: p.ffFamily, path: p.ffPath });
        } else {
            warnAt(p, at.line, at.col, "@font-face needs font-family and src: url()");
        }
        return;
    }
    if same(txt(p, &at), "property") {
        property(p, at);
        return;
    }
    if same(txt(p, &at), "keyframes") {
        keyframes(p, at);
        return;
    }
    warnName(p, at.line, at.col, "at-rule '@", txt(p, &at), "' is not supported");
    while true {
        let t = next(&p.lx);
        if t.kind == T_EOF || t.kind == T_SEMI {
            return;
        }
        if t.kind == T_LBRACE {
            skipBlock(p);
            return;
        }
    }
}
