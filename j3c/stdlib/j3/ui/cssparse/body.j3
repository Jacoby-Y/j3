// Part of j3.ui.cssparse; the rule-block body loop. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

/// Declarations up to the closing `}`. In a style rule (`p.nlev >= 0`) the block may also hold nested rules and `@media`: the
/// declarations before one become a rule for the pending selectors, the nested rules follow, and declarations after them are a
/// further rule with the same selectors (a browser's "nested declarations"), so source order wins. `first` is false in a nested
/// `@media`, whose declarations never belong to the parent's first segment.
fn body(p: &P, first: bool) {
    let css = p.css;
    let lev = p.nlev;
    let d0 = css.decls.len;
    let nested = false;
    if lev >= 0 {
        p.ndecl = 0;
    }
    while true {
        let pos0 = p.lx.pos;
        let t = next(&p.lx);
        if t.kind == T_EOF || t.kind == T_RBRACE {
            break;
        }
        if t.kind == T_SEMI {
            continue;
        }
        if lev >= 0 && t.kind == T_AT {
            nested = true;
            flush(p, d0, true);
            if same(txt(p, &t), "media") {
                let saved = p.mq;
                if media(p, t) {
                    p.mqd += 1;
                    p.ndecl = 0;
                    body(p, false);
                    p.mqd -= 1;
                    p.mq = saved;
                }
            } else {
                warnName(p, t.line, t.col, "at-rule '@", txt(p, &t), "' is not supported inside a rule");
                while true {
                    let u = next(&p.lx);
                    if u.kind == T_EOF || u.kind == T_SEMI || u.kind == T_RBRACE {
                        break;
                    }
                    if u.kind == T_LBRACE {
                        skipBlock(p);
                        break;
                    }
                }
            }
            d0 = css.decls.len;
            p.ndecl = 0;
            continue;
        }
        if lev >= 0 && t.kind != T_IDENT {
            // a nested rule: `&:hover {`, `.x {`, `> li {`
            let open = false;
            while true {
                let w = next(&p.lx);
                if w.kind == T_LBRACE {
                    open = true;
                    break;
                }
                if w.kind == T_SEMI || w.kind == T_EOF || w.kind == T_RBRACE {
                    break;
                }
            }
            if !open {
                warnAt(p, t.line, t.col, "selector without a block");
                continue;
            }
            nested = true;
            flush(p, d0, true);
            nestedRule(p, lev, pos0, p.lx.pos - 1, t.line, t.col);
            d0 = css.decls.len;
            p.ndecl = 0;
            continue;
        }
        let nameTok = t;
        let bad = false;
        let closed = false;
        let noColon = false;
        let isRule = false;
        let n = 0;
        if t.kind != T_IDENT {
            warnAt(p, t.line, t.col, "expected a property name");
            bad = true;
        } else {
            let c = next(&p.lx);
            if c.kind != T_COLON {
                if lev >= 0 && c.kind == T_LBRACE {
                    // `div {`
                    nested = true;
                    flush(p, d0, true);
                    nestedRule(p, lev, pos0, p.lx.pos - 1, t.line, t.col);
                    d0 = css.decls.len;
                    p.ndecl = 0;
                    continue;
                }
                if lev >= 0 && c.kind != T_SEMI && c.kind != T_EOF && c.kind != T_RBRACE {
                    // `div p {` or a typo: decided at the `{`
                    noColon = true;
                } else {
                    warnAt(p, t.line, t.col, "expected ':' after the property name");
                }
                bad = true;
                if c.kind == T_SEMI || c.kind == T_EOF {
                    continue;
                }
                if c.kind == T_RBRACE {
                    break;
                }
            }
        }
        let depth = 0;
        p.vs = p.lx.pos;
        while true {
            let v = next(&p.lx);
            p.ve = p.lx.pos - 1;
            if v.kind == T_EOF {
                p.ve = p.lx.pos;
                closed = true;
                break;
            }
            if v.kind == T_SEMI && depth == 0 {
                break;
            }
            if v.kind == T_RBRACE && depth == 0 {
                closed = true;
                break;
            }
            if v.kind == T_LBRACE {
                if lev >= 0 {
                    // `a:hover {`
                    isRule = true;
                    break;
                }
                if !bad {
                    warnAt(p, nameTok.line, nameTok.col, "nested blocks are not supported");
                }
                bad = true;
                skipBlock(p);
                continue;
            }
            if v.kind == T_LPAREN || v.kind == T_FUNC {
                depth += 1;
            } else if v.kind == T_RPAREN && depth > 0 {
                depth -= 1;
            }
            if v.kind == T_DELIM && v.ch == 33 && !bad {
                warnAt(p, nameTok.line, nameTok.col, "!important is not supported");
                bad = true;
            }
            if n < 192 {
                setTk(n, v);
                n += 1;
            } else if !bad {
                warnAt(p, nameTok.line, nameTok.col, "value is too long");
                bad = true;
            }
        }
        if isRule {
            nested = true;
            flush(p, d0, true);
            nestedRule(p, lev, pos0, p.lx.pos - 1, nameTok.line, nameTok.col);
            d0 = css.decls.len;
            p.ndecl = 0;
            continue;
        }
        if noColon {
            warnAt(p, nameTok.line, nameTok.col, "expected ':' after the property name");
        }
        if !bad {
            let kd0 = css.decls.len;
            declare(p, txt(p, &nameTok), nameTok.line, nameTok.col, n);
            if css.lintOn && p.mode == 0 {
                css.dlog.push(DeclLog { file: p.file, line: nameTok.line, col: nameTok.col, name: txt(p, &nameTok), val: p.lx.src[p.vs..p.ve], d0: kd0, nd: css.decls.len - kd0, kf: p.kf });
            }
            if p.kf {
                dropWide(p, kd0, nameTok.line, nameTok.col);
            }
        }
        if closed {
            break;
        }
    }
    if lev >= 0 {
        flush(p, d0, !first || nested);
    }
}
