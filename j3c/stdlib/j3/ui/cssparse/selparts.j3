// Part of j3.ui.cssparse; selector pieces: pseudo-class tables, `:nth-*`, `:not()` and `:has()` arguments. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

fn pseudoBit(name: string): int {
    if same(name, "hover") { return FL_HOVER; }
    if same(name, "active") { return FL_ACTIVE; }
    if same(name, "disabled") { return FL_DISABLED; }
    if same(name, "first-child") { return FL_FIRST_CHILD; }
    if same(name, "last-child") { return FL_LAST_CHILD; }
    if same(name, "focus") { return FL_FOCUS; }
    if same(name, "focus-within") { return FL_FOCUS_WITHIN; }
    if same(name, "focus-visible") { return FL_FOCUS_VIS; }
    if same(name, "checked") { return FL_CHECKED; }
    if same(name, "placeholder-shown") { return FL_PH_SHOWN; }
    if same(name, "open") { return FL_OPEN; }
    if same(name, "root") { return PS_ROOT; }
    if same(name, "dragging") { return FL_DRAGGING; }
    if same(name, "drop-target") { return FL_DROP; }
    return 0;
}

/// The `SS_*` bit of an argument-less structural pseudo-class, 0 for any other name.
fn ssBit(name: string): int {
    if same(name, "empty") { return SS_EMPTY; }
    if same(name, "only-child") { return SS_ONLY_CHILD; }
    if same(name, "first-of-type") { return SS_FIRST_TYPE; }
    if same(name, "last-of-type") { return SS_LAST_TYPE; }
    if same(name, "only-of-type") { return SS_ONLY_TYPE; }
    return 0;
}

/// The `NK_*` kind of an `:nth-...()` function name, -1 for any other name.
fn nthKind(name: string): int {
    if same(name, "nth-child") { return NK_CHILD; }
    if same(name, "nth-last-child") { return NK_LAST_CHILD; }
    if same(name, "nth-of-type") { return NK_TYPE; }
    if same(name, "nth-last-of-type") { return NK_LAST_TYPE; }
    return -1;
}

/// `before` / `after` (the pseudo-element name) as `Rule.pe`, 0 for any other word.
fn peKind(name: string): int {
    if same(name, "before") { return 1; }
    if same(name, "after") { return 2; }
    return 0;
}

fn newStep(): Step {
    return Step { tag: -1, ncls: 0, cls: [0, 0, 0, 0], attr: -1, pseudo: 0, comb: COMB_DESC, id: -1, not0: 0, nnot: 0, nth: false, nthA: 0, nthB: 0, nthK: 0, ss: 0, has0: 0, nhas: 0 };
}

/// The integer at `t[k..]` (digits only) into `*v`, returning the index after it; `k` when there are none.
fn nthNum(t: string, k: int, v: &int): int {
    let i = k;
    let x = 0;
    while i < t.len && int(t[i]) >= 48 && int(t[i]) <= 57 {
        x = x * 10 + (int(t[i]) - 48);
        i += 1;
    }
    *v = x;
    return i;
}

/// `An+B` of `:nth-child`: `odd`, `even`, `N`, `n`, `-n+3`, `2n + 1`. False for anything else.
fn nthParse(s: string, oa: &int, ob: &int): bool {
    let lo = 0;
    let hi = s.len;
    while lo < hi && int(s[lo]) == 32 {
        lo += 1;
    }
    while hi > lo && int(s[hi - 1]) == 32 {
        hi -= 1;
    }
    let t = s[lo..hi];
    if same(t, "odd") {
        *oa = 2;
        *ob = 1;
        return true;
    }
    if same(t, "even") {
        *oa = 2;
        *ob = 0;
        return true;
    }
    let k = 0;
    let sign = 1;
    if k < t.len && int(t[k]) == 45 {
        sign = -1;
        k += 1;
    } else if k < t.len && int(t[k]) == 43 {
        k += 1;
    }
    let num = 0;
    let e = nthNum(t, k, &num);
    let hasNum = e > k;
    k = e;
    if k < t.len && int(t[k]) == 110 {
        k += 1;
        *oa = sign * (if hasNum { num } else { 1 });
        while k < t.len && int(t[k]) == 32 {
            k += 1;
        }
        if k == t.len {
            *ob = 0;
            return true;
        }
        let sign2 = 1;
        if int(t[k]) == 45 {
            sign2 = -1;
        } else if int(t[k]) != 43 {
            return false;
        }
        k += 1;
        while k < t.len && int(t[k]) == 32 {
            k += 1;
        }
        let b = 0;
        let e2 = nthNum(t, k, &b);
        if e2 == k || e2 != t.len {
            return false;
        }
        *ob = sign2 * b;
        return true;
    }
    if !hasNum || k != t.len {
        return false;
    }
    *oa = 0;
    *ob = sign * num;
    return true;
}

/// Parentheses opened and not yet closed in `TOK[a..b)` (a comma inside a nested `(...)` does not split a `:not()` / `:has()` list).
fn openParens(a: int, b: int): int {
    let n = 0;
    for k in a..b {
        if tk(k).kind == T_FUNC || tk(k).kind == T_LPAREN {
            n += 1;
        } else if tk(k).kind == T_RPAREN {
            n -= 1;
        }
    }
    return n;
}

/// One argument of `:not(...)`, `TOK[a..b)`: a compound of a tag, `*`, `.class`, `#id`, `:pseudo-class` and `[type=x]` (no combinators, no
/// nesting) into `out`. Returns its specificity (`a*10000 + b*100 + c`), -1 with a warning when it is not supported.
fn notArg(p: &P, a: int, b: int, out: &Step): int {
    let na = 0;
    let nb = 0;
    let nc = 0;
    let started = false;
    let i = a;
    while i < b {
        let t = tk(i);
        if t.kind == T_IDENT && !started {
            out.tag = p.css.intern(txt(p, t));
            nc += 1;
        } else if t.kind == T_DELIM && t.ch == 42 && !started {
            started = true;
        } else if t.kind == T_DELIM && t.ch == 46 && i + 1 < b && tk(i + 1).kind == T_IDENT && out.ncls < 4 {
            out.cls[out.ncls] = p.css.intern(txt(p, tk(i + 1)));
            out.ncls += 1;
            nb += 1;
            i += 1;
        } else if t.kind == T_HASH && out.id < 0 {
            out.id = p.css.intern(txt(p, t));
            na += 1;
        } else if t.kind == T_COLON && i + 1 < b && tk(i + 1).kind == T_IDENT && pseudoBit(txt(p, tk(i + 1))) != 0 {
            let bit = pseudoBit(txt(p, tk(i + 1)));
            if !hasBit(out.pseudo, bit) {
                out.pseudo += bit;
            }
            nb += 1;
            i += 1;
        } else if t.kind == T_COLON && i + 1 < b && tk(i + 1).kind == T_IDENT && ssBit(txt(p, tk(i + 1))) != 0 {
            if !hasBit(out.ss, ssBit(txt(p, tk(i + 1)))) { out.ss += ssBit(txt(p, tk(i + 1))); }
            p.css.structMode = 1;
            nb += 1;
            i += 1;
        } else if t.kind == T_LBRACK && i + 4 < b && tk(i + 1).kind == T_IDENT && same(txt(p, tk(i + 1)), "type") && tk(i + 2).kind == T_DELIM && tk(i + 2).ch == 61 && (tk(i + 3).kind == T_STR || tk(i + 3).kind == T_IDENT) && tk(i + 4).kind == T_RBRACK {
            out.attr = p.css.intern(txt(p, tk(i + 3)));
            nb += 1;
            i += 4;
        } else {
            warnAt(p, t.line, t.col, ":not() takes a tag, class, #id, :pseudo-class or [type] (no combinators or nesting)");
            return -1;
        }
        started = true;
        i += 1;
    }
    if !started {
        warnAt(p, tk(a).line, tk(a).col, "empty :not()");
        return -1;
    }
    return na * 10000 + nb * 100 + nc;
}

/// One argument of `:has(...)`, `TOK[a..b)`: an optional `>`, `+` or `~` and one compound (what `:not()` takes) into `out`, with
/// `out.comb` the relation to the subject. Returns its specificity, -1 with a warning for a nested `:has()` or a complex selector.
fn hasArg(p: &P, a: int, b: int, out: &Step): int {
    let lo = a;
    out.comb = COMB_DESC;
    if lo < b && tk(lo).kind == T_DELIM && (tk(lo).ch == 62 || tk(lo).ch == 43 || tk(lo).ch == 126) {
        out.comb = if tk(lo).ch == 62 { COMB_CHILD } else if tk(lo).ch == 43 { COMB_NEXT } else { COMB_SIB };
        lo += 1;
    }
    for k in lo + 1..b {
        if tk(k).sp || (tk(k).kind == T_DELIM && (tk(k).ch == 62 || tk(k).ch == 43 || tk(k).ch == 126)) {
            warnAt(p, tk(k).line, tk(k).col, ":has() takes one compound selector, optionally after > + or ~ (no .a .b)");
            return -1;
        }
    }
    if lo >= b {
        warnAt(p, tk(a).line, tk(a).col, "empty :has()");
        return -1;
    }
    let comb = out.comb;
    let sp = notArg(p, lo, b, out);
    out.comb = comb;
    return sp;
}
