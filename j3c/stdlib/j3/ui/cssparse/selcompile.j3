// Part of j3.ui.cssparse; `compileSel`: a selector into steps and a pending rule. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

/// Compile `TOK[a..b)` into steps and one pending rule; false (with a warning) when unsupported.
fn compileSel(p: &P, a: int, b: int): bool {
    if a >= b {
        return false;
    }
    let step0 = p.css.steps.len;
    let cur = newStep();
    let started = false;
    let nb = 0;
    let nc = 0;
    let na = 0;
    let pe = 0;
    let i = a;
    let bad = "";
    let bl = tk(a).line;
    let bc = tk(a).col;
    while i < b && bad.len == 0 {
        let t = tk(i);
        if pe != 0 {
            bad = "a pseudo-element must end the selector";
            break;
        }
        if t.sp && started {
            p.css.steps.push(cur);
            cur = newStep();
            started = false;
        }
        if t.kind == T_IDENT && !started {
            cur.tag = p.css.intern(txt(p, t));
            nc += 1;
            started = true;
        } else if t.kind == T_DELIM && t.ch == 42 && !started {
            started = true;
        } else if t.kind == T_DELIM && t.ch == 46 && i + 1 < b && tk(i + 1).kind == T_IDENT && !tk(i + 1).sp {
            if cur.ncls >= 4 {
                bad = "more than 4 classes in one compound selector";
            } else {
                cur.cls[cur.ncls] = p.css.intern(txt(p, tk(i + 1)));
                cur.ncls += 1;
                nb += 1;
                started = true;
                i += 1;
            }
        } else if t.kind == T_HASH && !(t.sp && started) {
            if cur.id >= 0 {
                bad = "two #ids in one compound selector";
            } else {
                cur.id = p.css.intern(txt(p, t));
                na += 1;
                started = true;
            }
        } else if t.kind == T_COLON && i + 2 < b && tk(i + 1).kind == T_COLON && tk(i + 2).kind == T_IDENT && !tk(i + 1).sp && !tk(i + 2).sp {
            pe = peKind(txt(p, tk(i + 2)));
            if pe == 0 {
                warnName(p, t.line, t.col, "unsupported pseudo-element '::", txt(p, tk(i + 2)), "'");
                bad = "-";
            }
            nc += 1;
            started = true;
            i += 2;
        } else if t.kind == T_COLON && i + 1 < b && tk(i + 1).kind == T_FUNC {
            // `:not(a, .b)` and `:nth-child(2n+1)`: the arguments sit between the parens
            let fname = txt(p, tk(i + 1));
            let close = i + 2;
            let depth = 1;
            while close < b && depth > 0 {
                if tk(close).kind == T_FUNC || tk(close).kind == T_LPAREN {
                    depth += 1;
                } else if tk(close).kind == T_RPAREN {
                    depth -= 1;
                }
                close += 1;
            }
            close -= 1;
            if depth > 0 {
                close = b;
            }
            if close >= b {
                bad = "missing ) in selector";
            } else if same(fname, "not") {
                if cur.nnot == 0 {
                    cur.not0 = p.css.nots.len;
                }
                let argLo = i + 2;
                let q = i + 2;
                // the specificity of `:not()` is that of its most specific argument
                let top = 0;
                while q <= close && bad.len == 0 {
                    if q == close || (tk(q).kind == T_COMMA && openParens(i + 2, q) == 0) {
                        let ns = newStep();
                        let sp = notArg(p, argLo, q, &ns);
                        if sp < 0 {
                            bad = "-";
                        } else {
                            p.css.nots.push(ns);
                            cur.nnot += 1;
                            if sp > top { top = sp; }
                        }
                        argLo = q + 1;
                    }
                    q += 1;
                }
                na += top / 10000;
                nb += (top / 100) % 100;
                nc += top % 100;
                started = true;
                i = close;
            } else if same(fname, "has") {
                if cur.nhas > 0 {
                    bad = "two :has() in one compound selector";
                    break;
                }
                cur.has0 = p.css.hass.len;
                let hLo = i + 2;
                let hq = i + 2;
                // the specificity of `:has()` is that of its most specific argument
                let htop = 0;
                while hq <= close && bad.len == 0 {
                    if hq == close || (tk(hq).kind == T_COMMA && openParens(i + 2, hq) == 0) {
                        let hs = newStep();
                        let hsp = hasArg(p, hLo, hq, &hs);
                        if hsp < 0 {
                            bad = "-";
                        } else {
                            p.css.hass.push(hs);
                            cur.nhas += 1;
                            if hsp > htop { htop = hsp; }
                        }
                        hLo = hq + 1;
                    }
                    hq += 1;
                }
                na += htop / 10000;
                nb += (htop / 100) % 100;
                nc += htop % 100;
                started = true;
                i = close;
            } else if nthKind(fname) >= 0 {
                let fa = 0;
                let fb = 0;
                let textLo = tk(i + 1).e + 1;
                let textHi = tk(close).s;
                if textHi < textLo || cur.nth || !nthParse(p.lx.src[textLo..textHi], &fa, &fb) {
                    bad = "unsupported :nth-*() argument (odd, even, N, An+B)";
                } else {
                    cur.nth = true;
                    cur.nthA = fa;
                    cur.nthB = fb;
                    cur.nthK = nthKind(fname);
                    if cur.nthK != NK_CHILD {
                        p.css.structMode = 1;
                    }
                    nb += 1;
                    started = true;
                    i = close;
                }
            } else {
                warnName(p, t.line, t.col, "unsupported pseudo-class ':", fname, "()'");
                bad = "-";
            }
        } else if t.kind == T_COLON && i + 1 < b && tk(i + 1).kind == T_IDENT {
            let pk = peKind(txt(p, tk(i + 1)));
            if pk != 0 {
                // the old one-colon spelling
                pe = pk;
                nc += 1;
                started = true;
                i += 1;
            } else if ssBit(txt(p, tk(i + 1))) != 0 {
                if !hasBit(cur.ss, ssBit(txt(p, tk(i + 1)))) { cur.ss += ssBit(txt(p, tk(i + 1))); }
                p.css.structMode = 1;
                nb += 1;
                started = true;
                i += 1;
            } else if same(txt(p, tk(i + 1)), "enabled") {
                // `:not(:disabled)`
                if cur.nnot == 0 {
                    cur.not0 = p.css.nots.len;
                }
                let en = newStep();
                en.pseudo = FL_DISABLED;
                p.css.nots.push(en);
                cur.nnot += 1;
                nb += 1;
                started = true;
                i += 1;
            } else {
                let bit = pseudoBit(txt(p, tk(i + 1)));
                if bit == 0 {
                    warnName(p, t.line, t.col, "unsupported pseudo-class ':", txt(p, tk(i + 1)), "'");
                    bad = "-";
                } else {
                    if !hasBit(cur.pseudo, bit) {
                        cur.pseudo += bit;
                    }
                    nb += 1;
                    started = true;
                    i += 1;
                }
            }
        } else if t.kind == T_LBRACK && i + 4 < b && tk(i + 1).kind == T_IDENT && same(txt(p, tk(i + 1)), "type") && tk(i + 2).kind == T_DELIM && tk(i + 2).ch == 61 && (tk(i + 3).kind == T_STR || tk(i + 3).kind == T_IDENT) && tk(i + 4).kind == T_RBRACK {
            cur.attr = p.css.intern(txt(p, tk(i + 3)));
            nb += 1;
            started = true;
            i += 4;
        } else if t.kind == T_DELIM && (t.ch == 62 || t.ch == 43 || t.ch == 126) && (started || p.css.steps.len > step0) {
            let cb = COMB_CHILD;
            if t.ch == 43 {
                cb = COMB_NEXT;
            } else if t.ch == 126 {
                cb = COMB_SIB;
            }
            if started {
                cur.comb = cb;
                p.css.steps.push(cur);
                cur = newStep();
                started = false;
            } else if p.css.steps.items[p.css.steps.len - 1].comb != COMB_DESC {
                bad = "two combinators in a row";
            } else {
                // `a > b`: the space before `>` already closed `a`
                p.css.steps.items[p.css.steps.len - 1].comb = cb;
            }
        } else {
            bad = "selector is not supported";
        }
        i += 1;
    }
    if bad.len > 0 {
        if int(bad[0]) != 45 {
            warnAt(p, bl, bc, bad);
        }
        p.css.steps.len = step0;
        return false;
    }
    if !started {
        p.css.steps.len = step0;
        warnAt(p, bl, bc, "empty selector");
        return false;
    }
    let cls0 = -1;
    if cur.ncls > 0 {
        cls0 = cur.cls[0];
    }
    p.css.steps.push(cur);
    if p.npend - p.pbase >= 64 {
        p.css.steps.len = step0;
        warnAt(p, bl, bc, "more than 64 selectors in one rule");
        return false;
    }
    if p.scope != 0 {
        nb += 1;
    }
    let nsteps = p.css.steps.len - step0;
    PEND[p.npend] = Rule { step0: step0, nsteps: nsteps, decl0: 0, ndecl: 0, spec: na * 10000 + nb * 100 + nc, scope: p.scope, order: 0, tag: cur.tag, cls0: cls0, mq: p.mq, pe: pe, sib: false, file: p.file, line: bl, col: bc };
    p.npend += 1;
    return true;
}
