// Part of j3.ui.cssparse; rule blocks: skip, flush, nested rules, `:has()` bookkeeping. The module doc, `use`s and parser statics are in ../cssparse.j3.
module j3.ui.cssparse;

/// Skip to the end of a `{...}` whose `{` is already read.
fn skipBlock(p: &P) {
    let depth = 1;
    while depth > 0 {
        let t = next(&p.lx);
        if t.kind == T_EOF {
            return;
        }
        if t.kind == T_LBRACE {
            depth += 1;
        } else if t.kind == T_RBRACE {
            depth -= 1;
        }
    }
}

/// Declarations up to the closing `}`.
fn parseBlock(p: &P) {
    body(p, true);
}

/// Compile one expanded nested selector (its own text, so `&` is already replaced); its warnings are moved to `line:col`
/// of the nested rule, since the text has no place in the file.
fn compileJoined(p: &P, js: string, line: int, col: int): bool {
    let lx = Lexer { src: js, pos: 0, line: 1, ls: 0 };
    let n = 0;
    while true {
        let t = next(&lx);
        if t.kind == T_EOF {
            break;
        }
        if n >= 192 {
            warnAt(p, line, col, "selector is too long");
            return false;
        }
        setTk(n, t);
        n += 1;
    }
    let keep = p.lx.src;
    let w0 = p.css.warns.len;
    let r0 = p.npend;
    p.lx.src = js;
    let ok = compileSel(p, 0, n);
    p.lx.src = keep;
    for i in r0..p.npend {
        PEND[i].line = line;
    }
    for i in w0..p.css.warns.len {
        p.css.warns.items[i].line = line;
        p.css.warns.items[i].col = col;
    }
    return ok;
}

/// Record what the `:has()` step `st` tests (`Css.hasMode` and its filters, `Css.hasSubj`).
fn noteHas(css: &Css, st: Step) {
    let subj = st;
    subj.nhas = 0;
    css.hasSubj.push(subj);
    for k in st.has0..st.has0 + st.nhas {
        let a = &css.hass.items[k];
        let rel = if a.comb == COMB_DESC { 1 } else if a.comb == COMB_CHILD { 2 } else if a.comb == COMB_NEXT { 4 } else { 8 };
        if !hasBit(css.hasMode, rel) {
            css.hasMode += rel;
        }
        for c in 0..a.ncls {
            css.hasCls.push(a.cls[c]);
        }
        let bit = 1;
        while bit <= 8192 {
            if hasBit(a.pseudo, bit) && !hasBit(css.hasFlags, bit) {
                css.hasFlags += bit;
            }
            bit = bit * 2;
        }
        if a.id >= 0 || a.attr >= 0 || a.ss != 0 {
            css.hasAttr = 1;
        }
    }
}

/// Push the rules of the pending selectors with the `p.ndecl` declarations since `d0` (nothing when there is no valid selector, or
/// `skipEmpty` and no declarations: the bare parent segments of a block that has nested rules).
fn flush(p: &P, d0: int, skipEmpty: bool) {
    let css = p.css;
    if p.npend == p.pbase || (skipEmpty && p.ndecl == 0) {
        css.decls.len = d0;
        return;
    }
    for i in p.pbase..p.npend {
        let r = PEND[i];
        r.decl0 = d0;
        r.ndecl = p.ndecl;
        r.mq = p.mq;
        r.order = css.rules.len;
        if r.pe != 0 {
            css.peRules.push(css.rules.len);
        }
        // sibling combinators: a lone `+` only restyles the next sibling, anything else all following ones
        let nsib = 0;
        let longSib = false;
        for k in r.step0..r.step0 + r.nsteps - 1 {
            let cb = css.steps.items[k].comb;
            if cb == COMB_NEXT {
                nsib += 1;
            } else if cb == COMB_SIB {
                longSib = true;
            }
        }
        r.sib = longSib || nsib > 0;
        for k in r.step0..r.step0 + r.nsteps {
            if css.steps.items[k].nhas > 0 {
                if k != r.step0 + r.nsteps - 1 {
                    css.hasInner = 1;
                }
                noteHas(css, css.steps.items[k]);
            }
        }
        // `:nth-child` counts the siblings before it: one inserted or removed restyles every later one
        for k in r.step0..r.step0 + r.nsteps {
            if css.steps.items[k].nth {
                longSib = true;
            }
        }
        if longSib || nsib > 1 {
            css.sibMode = 2;
        } else if nsib == 1 && css.sibMode == 0 {
            css.sibMode = 1;
        }
        css.rules.push(r);
    }
}

/// A nested style rule whose prelude is `src[lo..hi]` and whose `{` is read: join it with the parent list `PT[lev]` (`&` is the
/// parent, no `&` means a descendant; every nested x parent pair becomes one flat selector), parse the block, and push its rules.
/// Any bad selector drops the whole rule (like a browser), with the warning at `line:col`.
fn nestedRule(p: &P, lev: int, lo: int, hi: int, line: int, col: int) {
    let css = p.css;
    let base = p.pbase;
    let np = p.npend;
    if lev >= 8 {
        warnAt(p, line, col, "rules nested more than 8 deep are skipped");
        skipBlock(p);
        return;
    }
    if np == base {
        // the parent selector was invalid and has warned
        skipBlock(p);
        return;
    }
    let sel = p.lx.src[lo..hi];
    let out = Text.new(css.mem);
    let s0 = css.steps.len;
    p.pbase = base + 64;
    p.npend = base + 64;
    let ok = true;
    let ni = 0;
    let nlo = 0;
    let nhi = 0;
    while ok {
        ni = part(sel, ni, &nlo, &nhi);
        if ni < 0 {
            break;
        }
        let ns = sel[nlo..nhi];
        if ns.len == 0 {
            warnAt(p, line, col, "empty selector");
            ok = false;
            break;
        }
        let qi = 0;
        let qlo = 0;
        let qhi = 0;
        while ok {
            qi = part(PT[lev], qi, &qlo, &qhi);
            if qi < 0 {
                break;
            }
            let par = PT[lev][qlo..qhi];
            let j = Text.new(css.mem);
            let why = join(&j, par, ns);
            if why.len > 0 {
                warnAt(p, line, col, why);
                ok = false;
                break;
            }
            let js = j.str();
            if out.len() > 0 {
                out.pushStr(", ");
            }
            out.pushStr(js);
            if !compileJoined(p, js, line, col) {
                ok = false;
            }
        }
    }
    if !ok {
        css.steps.len = s0;
        p.pbase = base;
        p.npend = np;
        skipBlock(p);
        return;
    }
    PT[lev + 1] = out.str();
    p.nlev = lev + 1;
    body(p, true);
    p.nlev = lev;
    p.pbase = base;
    p.npend = np;
}
