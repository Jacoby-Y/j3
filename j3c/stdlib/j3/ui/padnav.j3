/// Gamepad focus navigation and the arrow keys' opt-in twin, run by `inputs.begin` after the frame's input is read. The D-pad and the left
/// stick (repeating, `j3.ui.padin`) move focus to the nearest focusable in that direction by box geometry; A is Enter, B is Escape (so the
/// keyboard path does the click, the select, the popup and the modal), LB / RB set `Dom.padShoulder` (-1 / 1, for a tab strip to read),
/// LT / RT scroll the focused box a page, the right stick scrolls it smoothly. Pad input makes focus `:focus-visible`; a mouse move hides it again.
///
/// Spatial rules: only focusable, shown elements the open modal allows count. Candidates lie beyond the focused box's center in the
/// direction; those overlapping it on the other axis win over the rest and the nearest of them wins; of the rest the smallest gap plus twice how far off it is.
/// `focus-group="wrap trap arrows"` on a container: `wrap` takes the move that finds nothing to the far side of the group, `trap` keeps the move
/// inside it, `arrows` also lets the keyboard arrows move focus (not from a text box, slider, select or open menu: they keep their keys).
/// `nav-up|down|left|right="id"` on an element (or a group it is in) names where that direction goes; an id that is not on the page is ignored
/// with one `css.warns` entry. Inside an open select or menu, and left/right on a slider, the directions are the arrow keys. A text box
/// takes the pad direction as a focus move (a pad has no caret keys); `Dom.padText` names the box the pad just focused, for an on-screen keyboard.
/// Idle cost: reading the pad state each frame, nothing else.

module j3.ui.padnav;

use j3.text.{ same, Text };
use j3.ui.css.{ FL_FOCUS_VIS, Warning };
use j3.ui.dom;
use j3.ui.dom.{ allowedByModal, Dom, inside, isField, isFocusable, K_ELEM };
use j3.ui.padin;
use j3.ui.padin.PadRaw;
use j3.ui.padin.{ B_A, B_B, B_LB, B_RB, D_DOWN, D_LEFT, D_RIGHT, D_UP };
use j3.ui.popup;
use j3.math.{ abs, max };

fn usable(d: &Dom, id: int): bool {
    if id < 0 || id >= d.nodes.len { return false; }
    let n = &d.nodes.items[id];
    return dom.padReach(d, id) && allowedByModal(d, id) && n.w > 0.0 && n.h > 0.0;
}

/// Whether `s` (space separated words) has the word `w`.
fn hasWord(s: string, w: string): bool {
    let i = 0;
    while i < s.len {
        while i < s.len && s[i] == 32 { i += 1; }
        let j = i;
        while j < s.len && s[j] != 32 { j += 1; }
        if same(s[i..j], w) { return true; }
        i = j;
    }
    return false;
}

/// The nearest ancestor of `id` (itself counted) whose `focus-group` has the word `w` (-1 for none).
pub fn groupWith(d: &Dom, id: int, w: string): int {
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].navLen > 0 && hasWord(d.navOf(c, 0), w) { return c; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// The next node of a pre-order walk of the whole tree (-1 at the end).
fn next(d: &Dom, k: int): int {
    if d.nodes.items[k].first >= 0 { return d.nodes.items[k].first; }
    let c = k;
    while c >= 0 {
        if d.nodes.items[c].next >= 0 { return d.nodes.items[c].next; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Best candidate in direction `dir` from the box (`sx`, `sy`, `sw`, `sh`) that `f` has (-1 for none), all inside `within` when that is not -1;
/// `level`: only those overlapping the box on the other axis.
fn search(d: &Dom, f: int, dir: int, sx: f32, sy: f32, sw: f32, sh: f32, within: int, level: bool): int {
    let horiz = dir == D_LEFT || dir == D_RIGHT;
    let scx = sx + sw / 2.0;
    let scy = sy + sh / 2.0;
    let best = -1;
    let bestTier = 2;
    let bestScore: f32 = 0.0;
    if d.nodes.len == 0 { return -1; }
    let c = d.nodes.items[0].first;
    while c >= 0 {
        d.padVisits += 1;
        if c != f && d.nodes.items[c].kind == K_ELEM && usable(d, c) && (within < 0 || inside(d, within, c)) {
            let cx = d.absX(c);
            let cy = d.absY(c);
            let cw = d.nodes.items[c].w;
            let ch = d.nodes.items[c].h;
            let ccx = cx + cw / 2.0;
            let ccy = cy + ch / 2.0;
            let ahead = if dir == D_RIGHT { ccx > scx } else if dir == D_LEFT { ccx < scx } else if dir == D_DOWN { ccy > scy } else { ccy < scy };
            if ahead {
                let gap = if dir == D_RIGHT { cx - (sx + sw) } else if dir == D_LEFT { sx - (cx + cw) } else if dir == D_DOWN { cy - (sy + sh) } else { sy - (cy + ch) };
                gap = max(0.0, gap);
                let side = if horiz { abs(ccy - scy) } else { abs(ccx - scx) };
                let along = if horiz { abs(ccx - scx) } else { abs(ccy - scy) };
                let off = if horiz { max(cy - (sy + sh), sy - (cy + ch)) } else { max(cx - (sx + sw), sx - (cx + cw)) };
                let overlap = off < 0.0;
                let tier = if overlap { 0 } else { 1 };
                if level && !overlap { c = next(d, c); continue; }
                // level ones: the nearest gap (a wide button is as good as a narrow one), then the centers; the rest: the gap and twice how far off
                let score = gap + 0.25 * side + 0.01 * along + (if overlap { 0.0 } else { 2.0 * off });
                if best < 0 || tier < bestTier || (tier == bestTier && score < bestScore) {
                    best = c;
                    bestTier = tier;
                    bestScore = score;
                }
            }
        }
        c = next(d, c);
    }
    return best;
}

/// Once per `id`: a `nav-*` names an element that is not on the page.
fn warnMissing(d: &Dom, id: string) {
    let m = Text.new(d.mem);
    m.pushStr("nav-up|down|left|right=\"");
    m.pushStr(id);
    m.pushStr("\": no element has this id, so the direction moves by position");
    for i in 0..d.css.warns.len {
        if same(d.css.warns.items[i].msg, m.str()) { return; }
    }
    d.css.warns.push(Warning { file: "nav:", line: 1, col: 1, msg: m.str() });
}

/// Focus the first usable element in tree order (-1 when there is none).
fn first(d: &Dom): int {
    if d.nodes.len == 0 { return -1; }
    let c = d.nodes.items[0].first;
    while c >= 0 {
        if usable(d, c) { return c; }
        c = next(d, c);
    }
    return -1;
}

/// The element a move from the focus in `dir` (`D_*`) lands on: a `nav-*` name, else the geometry (wrapping inside a `wrap` group), -1 for none.
pub fn target(d: &Dom, dir: int): int {
    let f = d.focus;
    if f < 0 || f >= d.nodes.len { return first(d); }
    let c = f;
    while c >= 0 {
        let want = d.navOf(c, dir);
        if want.len > 0 {
            let t = d.byId(want);
            if t < 0 {
                warnMissing(d, want);
            } else if usable(d, t) {
                return t;
            }
            break;
        }
        c = d.nodes.items[c].parent;
    }
    let trap = groupWith(d, f, "trap");
    let sx = d.absX(f);
    let sy = d.absY(f);
    let sw = d.nodes.items[f].w;
    let sh = d.nodes.items[f].h;
    let hit = search(d, f, dir, sx, sy, sw, sh, trap, false);
    let g = groupWith(d, f, "wrap");
    if g < 0 || (hit >= 0 && inside(d, g, hit)) { return hit; }
    // wrapping: the move leaves the group, so start from a point just outside its far side and take what is level with the focus there
    let w = wrapTo(d, f, dir, g);
    return if w >= 0 { w } else { hit };
}

/// The element a move in `dir` from `f` wraps to inside group `g` (-1 for none).
fn wrapTo(d: &Dom, f: int, dir: int, g: int): int {
    let sx = d.absX(f);
    let sy = d.absY(f);
    let sw = d.nodes.items[f].w;
    let sh = d.nodes.items[f].h;
    let gx = d.absX(g);
    let gy = d.absY(g);
    let gw = d.nodes.items[g].w;
    let gh = d.nodes.items[g].h;
    if dir == D_RIGHT { return search(d, f, dir, gx - 1.0, sy, 0.0, sh, g, true); }
    if dir == D_LEFT { return search(d, f, dir, gx + gw + 1.0, sy, 0.0, sh, g, true); }
    if dir == D_DOWN { return search(d, f, dir, sx, gy - 1.0, sw, 0.0, g, true); }
    return search(d, f, dir, sx, gy + gh + 1.0, sw, 0.0, g, true);
}

/// Move focus one step in `dir`; false when nowhere to go. Focus shows as `:focus-visible` and scrolls into view.
pub fn move(d: &Dom, dir: int): bool {
    let t = target(d, dir);
    if t < 0 { return false; }
    d.setKeyboard(true);
    d.focusNode(t);
    if isField(d, t) { d.padText = t; }
    return true;
}

fn key(d: &Dom, dir: int) {
    if dir == D_UP { d.kin.up = true; }
    else if dir == D_DOWN { d.kin.down = true; }
    else if dir == D_LEFT { d.kin.left = true; }
    else { d.kin.right = true; }
}

/// The scrolling box the triggers and right stick move: the nearest one above the focus, else the first on the page the modal allows.
fn scrollBox(d: &Dom): int {
    let c = d.focus;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.kind == K_ELEM && dom.isScroll(d, n.style) && n.scrollMax > 0.0 { return c; }
        c = n.parent;
    }
    if d.nodes.len == 0 { return -1; }
    c = 0;
    while c >= 0 {
        let m = &d.nodes.items[c];
        if m.kind == K_ELEM && dom.isScroll(d, m.style) && m.scrollMax > 0.0 && allowedByModal(d, c) { return c; }
        c = next(d, c);
    }
    return -1;
}

fn topPopover(d: &Dom): bool {
    let n = d.ovs.len;
    return n > 0 && d.nodes.items[d.ovs.items[n - 1].v].ov == dom.OV_POPOVER;
}

/// Whether the arrow keys this frame belong to the focused element (text box, slider, radio, select, open menu or select list: a radio
/// group wins over a `focus-group="arrows"` around it).
fn ownsArrows(d: &Dom): bool {
    let f = d.focus;
    if f < 0 { return false; }
    return isField(d, f) || dom.isRadio(d, f) || d.mnodes.items[f].type == d.vRange || d.nodes.items[f].tag == d.tSelect || d.pop.kind != popup.NONE || topPopover(d);
}

/// Whether the last input was the pad (a pad button or stick, until a key or a mouse move): what the `<glyph>` element reads to show pad prompts instead
/// of key prompts (`dom/glyph.j3`; a game with its own art can still put a `{#if padnav.usingPad(d)}` around two images).
pub fn usingPad(d: &Dom): bool {
    return d.padSt.mode;
}

/// Per frame, from `inputs.begin` before anything reads `Dom.kin`.
pub fn step(d: &Dom) {
    d.padText = -1;
    d.padShoulder = 0;
    let s = &d.padSt;
    let k = &d.kin;
    if k.left || k.right || k.up || k.down || k.enter || k.esc || k.tab || k.space || k.typed.len > 0 {
        // the keyboard is back in use
        s.mode = false;
        // opt-in arrow keys: a focus-group with `arrows` turns an arrow into a move
        let kd = if k.up { D_UP } else if k.down { D_DOWN } else if k.left { D_LEFT } else if k.right { D_RIGHT } else { 0 };
        if kd != 0 && !k.shift && !k.ctrl && d.focus >= 0 && !ownsArrows(d) && groupWith(d, d.focus, "arrows") >= 0 {
            k.up = false;
            k.down = false;
            k.left = false;
            k.right = false;
            move(d, kd);
        }
    }
    let raw = if d.padOn { d.padRaw } else { padin.poll() };
    if raw.attached { d.padReads += 1; } else { raw = PadRaw {}; }
    let dir = padin.dirOf(&raw);
    let fired = padin.fire(s, dir, d.now);
    let a = padin.pressed(s, raw.mask, B_A);
    let b = padin.pressed(s, raw.mask, B_B);
    let lb = padin.pressed(s, raw.mask, B_LB);
    let rb = padin.pressed(s, raw.mask, B_RB);
    let lt = raw.lt > 0.5;
    let rt = raw.rt > 0.5;
    let ltE = lt && !s.lt;
    let rtE = rt && !s.rt;
    s.prev = raw.mask;
    s.lt = lt;
    s.rt = rt;
    let stick = abs(raw.ry) > 0.2;
    if s.mode && (d.moved || (d.down && !d.prevDown)) {
        // a mouse move or press: hover takes over, the ring goes (a text box keeps its caret ring)
        s.mode = false;
        d.setKeyboard(false);
        if d.focus >= 0 && !isField(d, d.focus) { d.setFlag(d.focus, FL_FOCUS_VIS, false); }
    }
    if !(fired || a || b || lb || rb || ltE || rtE || stick) { return; }
    s.mode = true;
    d.setKeyboard(true);
    if fired {
        let f = d.focus;
        if d.pop.kind != popup.NONE || topPopover(d) {
            key(d, dir);
        } else if f >= 0 && d.mnodes.items[f].type == d.vRange && (dir == D_LEFT || dir == D_RIGHT) {
            key(d, dir);
        } else {
            move(d, dir);
        }
    }
    if a {
        // A on a multi-line box must not type a newline: it asks for the on-screen keyboard instead
        if d.focus >= 0 && d.mnodes.items[d.focus].type == d.vTextarea { d.padText = d.focus; } else { k.enter = true; }
    }
    if b { k.esc = true; }
    if lb { d.padShoulder = -1; }
    if rb { d.padShoulder = 1; }
    if ltE || rtE || stick {
        let box = scrollBox(d);
        if box >= 0 {
            if ltE { d.scrollBy(box, 0.0 - d.nodes.items[box].h * 0.9); }
            if rtE { d.scrollBy(box, d.nodes.items[box].h * 0.9); }
            if stick { d.scrollBy(box, raw.ry * d.dt() * 900.0); }
        }
    }
}
