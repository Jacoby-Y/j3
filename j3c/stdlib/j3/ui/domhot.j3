/// Style hot reload for `.j3ui` projects (dev runs): a generated root calls `hotDue` once per frame and `hotFile` for
/// theme.css and every component `<style>` when it is due. Takes only a `Css`; no tree.

module j3.ui.domhot;

use j3.game;
use j3.memory.Arena;
use j3.io.readFile;
use j3.result.Result;
use j3.sys.write;
use j3.text.{ find, same };
use j3.ui.css.{ Css, HotFile };

// A generated root calls `hotDue` once per frame and, when it is true, `hotFile` for theme.css and every
// .j3ui, then re-parses and restyles if any returned true. Active only when `J3_ROOT` is set (`j3c run`);
// a built binary started by hand never polls. ponytail: the poll compares file contents (no mtime call in
// j3.sys), 10 small files every 250 ms; add an fstat binding if a project has hundreds of .j3ui files.

/// True on the frames where the files should be re-read: the first frame, then every 250 ms.
/// Also prints the CSS warnings parsed so far (`file:line:col: msg`) once per new warning.
pub fn hotDue(css: &Css): bool {
    if css.hotAt < 0 {
        return false;
    }
    let now = game.ticks();
    if css.hotAt == 0 {
        if same(game.env("J3_ROOT"), "") {
            css.hotAt = -1;
            return false;
        }
    } else if now < css.hotAt {
        return false;
    }
    css.hotAt = now + 250;
    hotWarns(css);
    return true;
}

/// Print the CSS warnings not printed yet, as `warning: file:line:col: msg`.
pub fn hotWarns(css: &Css) {
    while css.hotWarn < css.warns.len {
        let w = css.warns.items[css.hotWarn];
        say(`warning: {w.file}:{w.line}:{w.col}: {w.msg}`);
        css.hotWarn += 1;
    }
}

fn say(s: string) {
    write(1, s.ptr as ptr, s.len);
    write(1, "\n".ptr as ptr, 1);
}

/// Hash of `s[0..a]` then `s[b..]`: what the compiler computed for the file's non-style part.
fn restHash(s: []u8, a: int, b: int): int {
    let h = 7;
    for i in 0..a {
        h = (h * 31 + int(s[i])) % 1000000007;
    }
    for i in b..s.len {
        h = (h * 31 + int(s[i])) % 1000000007;
    }
    return h;
}

/// Re-read `path`. `style` and `rest` are what the compiler embedded (for a `.j3ui`: the `<style>`
/// text and `restHash` of the rest; for CSS files `ui` is false and the whole file is the style).
/// Returns true when the style text differs from the last one seen; the next `parse` of `path` then
/// uses the new text. A markup or script change prints one line (needs a rebuild).
pub fn hotFile(css: &Css, path: string, style: string, rest: int, ui: bool): bool {
    let at = -1;
    for i in 0..css.hot.len {
        if same(css.hot.items[i].path, path) {
            at = i;
        }
    }
    if at < 0 {
        css.hot.push(HotFile { path: path, style: style, rest: rest, live: false, line0: 0 });
        at = css.hot.len - 1;
    }
    let h = &css.hot.items[at];
    let tmp = Arena.create(65536);
    let changed = false;
    match readFile(path, &tmp) {
        Result.Ok(bytes) {
            let text = bytes as string;
            let a = 0;
            let b = bytes.len;
            if ui {
                a = find(text, "<style");
                if a >= 0 {
                    a = a + find(text[a..text.len], ">") + 1;
                    b = a + find(text[a..text.len], "</style>");
                } else {
                    a = bytes.len;
                    b = a;
                }
                let r = restHash(bytes, a, b);
                if r != h.rest {
                    h.rest = r;
                    // under `j3c run --hot` the compiler is already rebuilding and will restart this process
                    if game.env("J3_HOT_QUIT").len == 0 {
                        say(`{path}: markup or script changed, rebuild to see it (styles reload live; j3c run --hot rebuilds for you)`);
                    }
                }
            }
            // the compiler trims newlines around a style block
            while a < b && bytes[a] == 10 {
                a += 1;
            }
            while b > a && bytes[b - 1] == 10 {
                b -= 1;
            }
            let now = text[a..b];
            if !same(now, h.style) {
                let keep = css.mem.alloc::<u8>(now.len);
                for i in 0..now.len {
                    keep[i] = bytes[a + i];
                }
                h.style = keep as string;
                h.line0 = 0;
                for i in 0..a {
                    if bytes[i] == 10 { h.line0 += 1; }
                }
                h.live = true;
                changed = true;
            }
        }
        Result.Err(_) {}
    }
    tmp.destroy();
    return changed;
}
