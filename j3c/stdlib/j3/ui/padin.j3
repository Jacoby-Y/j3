/// Gamepad state for the UI, one frame at a time: `poll` reads `j3.game` (pads 0 and 1 merged), `parse` builds the same thing from names
/// for headless tests, and `Dom.setPad` takes one from anywhere else (an action-set layer, Steam Input). `step` turns a direction held on the
/// D-pad or left stick into presses: one at once, then repeats after 400 ms every 120 ms. No GL; main thread only.

module j3.ui.padin;

use j3.game;
use j3.game.{ Axis, Pad };
use j3.text.same;

pub const B_UP: int = 1;
pub const B_DOWN: int = 2;
pub const B_LEFT: int = 4;
pub const B_RIGHT: int = 8;
pub const B_A: int = 16;
pub const B_B: int = 32;
pub const B_LB: int = 64;
pub const B_RB: int = 128;

/// Directions `dirOf` returns (0 for none).
pub const D_UP: int = 1;
pub const D_DOWN: int = 2;
pub const D_LEFT: int = 3;
pub const D_RIGHT: int = 4;

/// What the pad holds right now: buttons as `B_*` bits (the left stick past half way sets the direction bits through `dirOf`, not here),
/// sticks and triggers in -1..1 (triggers 0..1).
pub struct PadRaw {
    /// False when no pad is plugged in (`Dom.setPad` can say so too): every other field is then ignored, so a direction held at unplug stops.
    attached: bool = true;
    mask: int = 0;
    lx: f32 = 0.0;
    ly: f32 = 0.0;
    rx: f32 = 0.0;
    ry: f32 = 0.0;
    lt: f32 = 0.0;
    rt: f32 = 0.0;
}

/// Between frames: last buttons and triggers (for edges), the direction held and its repeat clock, and whether the last focus move came
/// from the pad (a mouse move then hides the ring).
pub struct PadState {
    prev: int = 0;
    dir: int = 0;
    t0: f32 = 0.0;
    last: f32 = 0.0;
    lt: bool = false;
    rt: bool = false;
    mode: bool = false;
}

pub const FIRST_MS: f32 = 400.0;
pub const EVERY_MS: f32 = 120.0;

/// Whether bit `b` (a power of two) is set in `mask`.
pub fn has(mask: int, b: int): bool {
    return (mask / b) % 2 == 1;
}

/// `mask` with bit `b` set when `on` (no bit operators in J3: bits are powers of two).
fn put(mask: int, b: int, on: bool): int {
    return if on && !has(mask, b) { mask + b } else { mask };
}

/// Pad `i` alone: its buttons and axes (`attached` false when it is not plugged in).
fn one(i: int): PadRaw {
    let r = PadRaw { attached: game.padConnected(i) };
    if !r.attached { return r; }
    r.mask = put(r.mask, B_UP, game.padDown(i, Pad.Up));
    r.mask = put(r.mask, B_DOWN, game.padDown(i, Pad.Down));
    r.mask = put(r.mask, B_LEFT, game.padDown(i, Pad.Left));
    r.mask = put(r.mask, B_RIGHT, game.padDown(i, Pad.Right));
    r.mask = put(r.mask, B_A, game.padDown(i, Pad.A));
    r.mask = put(r.mask, B_B, game.padDown(i, Pad.B));
    r.mask = put(r.mask, B_LB, game.padDown(i, Pad.LB));
    r.mask = put(r.mask, B_RB, game.padDown(i, Pad.RB));
    r.lx = game.padAxis(i, Axis.LeftX);
    r.ly = game.padAxis(i, Axis.LeftY);
    r.rx = game.padAxis(i, Axis.RightX);
    r.ry = game.padAxis(i, Axis.RightY);
    r.lt = game.padAxis(i, Axis.LT);
    r.rt = game.padAxis(i, Axis.RT);
    return r;
}

/// Two pads as one: any pad's button counts, the larger push wins an axis, attached when either is. So whichever pad is used drives
/// the UI, and two players' pads both move the same focus (no per-player focus).
pub fn merge(a: &PadRaw, b: &PadRaw): PadRaw {
    let r = PadRaw { attached: a.attached || b.attached };
    r.mask = a.mask;
    for k in 0..8 {
        let bit = 1;
        for j in 0..k { bit = bit * 2; }
        r.mask = put(r.mask, bit, has(b.mask, bit));
    }
    r.lx = if b.lx * b.lx > a.lx * a.lx { b.lx } else { a.lx };
    r.ly = if b.ly * b.ly > a.ly * a.ly { b.ly } else { a.ly };
    r.rx = if b.rx * b.rx > a.rx * a.rx { b.rx } else { a.rx };
    r.ry = if b.ry * b.ry > a.ry * a.ry { b.ry } else { a.ry };
    r.lt = if b.lt > a.lt { b.lt } else { a.lt };
    r.rt = if b.rt > a.rt { b.rt } else { a.rt };
    return r;
}

/// The pads now: controllers 0 and 1 merged. With none plugged in this is two pointer checks (no SDL calls).
pub fn poll(): PadRaw {
    if !game.padConnected(0) && !game.padConnected(1) { return PadRaw { attached: false }; }
    let a = one(0);
    let b = one(1);
    return merge(&a, &b);
}

/// Names separated by spaces: `Up Down Left Right A B LB RB` (D-pad and buttons), `LT RT` (triggers, fully pressed), `SUp SDown SLeft SRight`
/// (left stick fully pushed), `RUp RDown` (right stick). Unknown names are ignored.
pub fn parse(spec: string): PadRaw {
    let r = PadRaw {};
    let i = 0;
    while i < spec.len {
        while i < spec.len && spec[i] == 32 {
            i += 1;
        }
        let j = i;
        while j < spec.len && spec[j] != 32 {
            j += 1;
        }
        let w = spec[i..j];
        if same(w, "Up") { r.mask = put(r.mask, B_UP, true); }
        else if same(w, "Down") { r.mask = put(r.mask, B_DOWN, true); }
        else if same(w, "Left") { r.mask = put(r.mask, B_LEFT, true); }
        else if same(w, "Right") { r.mask = put(r.mask, B_RIGHT, true); }
        else if same(w, "A") { r.mask = put(r.mask, B_A, true); }
        else if same(w, "B") { r.mask = put(r.mask, B_B, true); }
        else if same(w, "LB") { r.mask = put(r.mask, B_LB, true); }
        else if same(w, "RB") { r.mask = put(r.mask, B_RB, true); }
        else if same(w, "LT") { r.lt = 1.0; }
        else if same(w, "RT") { r.rt = 1.0; }
        else if same(w, "SUp") { r.ly = -1.0; }
        else if same(w, "SDown") { r.ly = 1.0; }
        else if same(w, "SLeft") { r.lx = -1.0; }
        else if same(w, "SRight") { r.lx = 1.0; }
        else if same(w, "RUp") { r.ry = -1.0; }
        else if same(w, "RDown") { r.ry = 1.0; }
        i = j;
    }
    return r;
}

/// The direction held: the D-pad (first of up, down, left, right), else the left stick past half way on its stronger axis (0 for none).
pub fn dirOf(r: &PadRaw): int {
    if has(r.mask, B_UP) { return D_UP; }
    if has(r.mask, B_DOWN) { return D_DOWN; }
    if has(r.mask, B_LEFT) { return D_LEFT; }
    if has(r.mask, B_RIGHT) { return D_RIGHT; }
    let ax = if r.lx < 0.0 { 0.0 - r.lx } else { r.lx };
    let ay = if r.ly < 0.0 { 0.0 - r.ly } else { r.ly };
    if ax < 0.5 && ay < 0.5 { return 0; }
    if ay >= ax { return if r.ly < 0.0 { D_UP } else { D_DOWN }; }
    return if r.lx < 0.0 { D_LEFT } else { D_RIGHT };
}

/// Whether `dir` (from `dirOf`) fires a press this frame: when it changes to a direction, then again after `FIRST_MS`, every `EVERY_MS`.
pub fn fire(s: &PadState, dir: int, now: f32): bool {
    if dir == 0 {
        s.dir = 0;
        return false;
    }
    if dir != s.dir {
        s.dir = dir;
        s.t0 = now;
        s.last = now;
        return true;
    }
    if now - s.t0 >= FIRST_MS && now - s.last >= EVERY_MS {
        s.last = now;
        return true;
    }
    return false;
}

/// Whether button bit `b` of `mask` went down since the last frame.
pub fn pressed(s: &PadState, mask: int, b: int): bool {
    return has(mask, b) && !has(s.prev, b);
}
