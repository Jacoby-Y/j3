/// `window-drag`: a `.j3ui` element whose box moves the window, for a client-side title bar
/// (`app.undecorated()`). Its focusable descendants (`button`, `input`, `select`, anything with
/// `tabindex` or `menuitem`) stay ordinary clicks. `inputs.begin` runs `step` once per frame, after
/// scrolling and before the build walk, so the regions come from the previous layout; they go to
/// `game.setDragRegions` / `setNoDragRegions`. Double-clicking a drag area toggles maximize.

module j3.ui.windrag;

use j3.game;
use j3.game.WinRect;
use j3.ui.dom;
use j3.ui.dom.{ Dom, isFocusable, paintVisible };

// ponytail: one window, one Dom; the tables match game's 32 regions
#[singleton]
let DRAG: [32]WinRect;
#[singleton]
let NODRAG: [32]WinRect;
#[singleton]
let SENT: bool = false;

fn boxOf(d: &Dom, id: int): WinRect {
    let n = &d.nodes.items[id];
    return WinRect { x: d.absX(id), y: d.absY(id), w: n.w, h: n.h };
}

/// Send this frame's drag and no-drag boxes to `j3.game`; boxes that went away leave the list.
pub fn step(d: &Dom) {
    if d.wdr.len == 0 && !SENT { return; }
    let nd = 0;
    let nn = 0;
    let i = 0;
    while i < d.wdr.len {
        let id = d.wdr.items[i].v;
        if d.nodes.items[id].kind != dom.K_ELEM || d.nodes.items[id].pk != dom.PK_WDRAG {
            d.wdr.items[i] = d.wdr.items[d.wdr.len - 1];
            d.wdr.len -= 1;
            continue;
        }
        i += 1;
        if !paintVisible(d, id) || nd == 32 { continue; }
        DRAG[nd] = boxOf(d, id);
        nd += 1;
        // focusable descendants, tree order, without recursion
        let c = d.nodes.items[id].first;
        while c >= 0 && c != id {
            let down = true;
            if isFocusable(d, c) {
                if nn < 32 {
                    NODRAG[nn] = boxOf(d, c);
                    nn += 1;
                }
                down = false;
            }
            if down && d.nodes.items[c].first >= 0 {
                c = d.nodes.items[c].first;
            } else {
                while c != id && d.nodes.items[c].next < 0 { c = d.nodes.items[c].parent; }
                if c != id { c = d.nodes.items[c].next; }
            }
        }
    }
    game.setNoDragRegions(NODRAG[0..nn]);
    game.setDragRegions(DRAG[0..nd]);
    SENT = nd > 0;
}
