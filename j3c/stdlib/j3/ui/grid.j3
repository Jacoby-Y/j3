// The data grid's side that touches the Dom (plan 023 stage 6): keyboard cell navigation, the cell edit lifecycle and
// scroll-into-view for the one grid bound this frame (`grid={g}`, `Dom.gridBind`). `inputs.begin` calls `step` first
// every frame, so keys the grid takes (arrows, Tab, Enter, Escape, typing) never reach the text box or the focus walk.
// The state and the moves are in `j3.ui.gridstate`; the app owns the cell data and writes a value when `on:edit` says
// commit. One grid per window.

module j3.ui.grid;

use j3.game;
use j3.game.Cursor;
use j3.math.max;
use j3.ui.dom;
use j3.ui.dom.{ Dom, isAncestor };
use j3.ui.gridstate.{ Grid, MIN_W };
use j3.ui.popup;
use j3.ui.vlist;

/// Room taken by a scroll bar on the far edge of the box.
const BAR: f32 = 12.0;
/// Frames the editor box may take to appear after the edit began before the edit is dropped.
const WAIT: int = 3;

/// Edit event kinds (`kind` in `on:edit`).
pub const EDIT_BEGIN: int = 0;
pub const EDIT_COMMIT: int = 1;
/// A paste (or a cut's clear): the target is `pasteRows` x `pasteCols` cells from `(row, col)`; read them with `g.pasteCell(i, j)`.
pub const EDIT_PASTE: int = 2;
/// A column was resized (on release): `col` is the column, read its width with `g.w(col)`. Not fired for a drag that changed nothing.
pub const EDIT_RESIZE: int = 3;

fn fire(d: &Dom, g: &Grid, kind: int, text: string) {
    g.evFrame = d.frame;
    g.evKind = kind;
    g.evRow = g.row;
    g.evCol = g.col;
    g.evText = text;
}

/// Paste TSV `text` into the range as one `on:edit` event of kind 2 (what Ctrl+V does with the clipboard). The target
/// becomes the selection. Nothing happens for empty text or when nothing fits.
pub fn paste(d: &Dom, g: &Grid, text: string) {
    if g.stagePaste(text) {
        firePaste(d, g);
    }
}

fn firePaste(d: &Dom, g: &Grid) {
    g.evFrame = d.frame;
    g.evKind = EDIT_PASTE;
    g.evRow = g.pasteRow;
    g.evCol = g.pasteCol;
    g.evText = "";
    g.selectPasted();
}

/// The text box inside the grid (the editor), or -1.
fn editor(d: &Dom, b: int): int {
    for i in b + 1..d.nodes.len {
        let n = &d.nodes.items[i];
        if n.kind == dom.K_ELEM && n.tag == d.tInput && isAncestor(d, b, i) {
            return i;
        }
    }
    return -1;
}

fn begin(d: &Dom, g: &Grid, seeded: bool, typed: string) {
    g.editing = true;
    g.seen = false;
    g.wait = 0;
    g.seeded = seeded;
    if seeded {
        g.seed.clear();
        g.seed.pushStr(typed);
    }
    fire(d, g, EDIT_BEGIN, "");
}

fn stop(g: &Grid) {
    g.editing = false;
    g.seeded = false;
}

/// Commit the editor's text, then move (`dr` rows, or a Tab step `tab`), and give the box back focus when `back`.
fn commit(d: &Dom, g: &Grid, b: int, ed: int, dr: int, tab: int, back: bool) {
    fire(d, g, EDIT_COMMIT, d.eds.items[d.claim(ed)].str());
    stop(g);
    if tab != 0 {
        g.tab(tab);
    } else {
        g.move(dr, 0);
    }
    if back {
        d.focusNode(b);
    }
}

/// Scroll the box so the active cell is inside it, on both axes.
fn showCell(d: &Dom, g: &Grid, b: int) {
    let n = &d.nodes.items[b];
    let vh = vlist.viewHeight(d, b) - (if n.scrollMaxX > 0.0 { BAR } else { 0.0 });
    let vw = n.w - (if n.scrollMax > 0.0 { BAR } else { 0.0 });
    let y0 = (g.row as f32) * g.rowH;
    let y1 = y0 + g.rowH;
    if y0 < n.scrollY {
        d.scrollBy(b, y0 - n.scrollY);
    } else if y1 > n.scrollY + vh {
        d.scrollBy(b, y1 - vh - n.scrollY);
    }
    // a frozen column is always in view: moving onto one leaves the scroll alone. The others scroll under the frozen
    // ones, so their left bound is past them
    if g.col >= g.frozen {
        let fw = g.fw();
        let x0 = g.colX(g.col);
        let x1 = x0 + g.w(g.col);
        if x0 - fw < n.scrollX {
            d.scrollByX(b, x0 - fw - n.scrollX);
        } else if x1 > n.scrollX + vw {
            d.scrollByX(b, x1 - vw - n.scrollX);
        }
    }
}

/// Once per frame for every grid bound in the last frame (none: nothing to do).
pub fn step(d: &Dom) {
    let i = d.grids.len - 1;
    while i >= 0 {
        let r = &d.grids.items[i];
        if d.frame - r.frame > 1 || r.node >= d.nodes.len || d.nodes.items[r.node].kind != dom.K_ELEM {
            // not built last frame (or gone): forget it
            d.grids.items[i] = d.grids.items[d.grids.len - 1];
            d.grids.len -= 1;
        } else {
            one(d, r.node, r.g);
        }
        i -= 1;
    }
}

/// A header-edge drag in progress (`Grid.grab`): the width follows the pointer; the event fires on release.
fn resize(d: &Dom, g: &Grid, b: int) {
    if g.rj < 0 {
        return;
    }
    game.setCursor(Cursor.ResizeAcross);
    let j = g.rj;
    if !g.rset {
        // the first frame after the press (the handler ran in the build): measure from where the press was
        g.rset = true;
        g.rx = g.px;
        g.rw0 = g.widths[j];
        if g.keep && d.focus != b {
            d.focusNode(b);
        }
    }
    if d.down {
        let w = max(MIN_W, g.rw0 + d.mx - g.rx);
        if w != g.widths[j] {
            g.setWidth(j, w);
        }
    } else {
        g.rj = -1;
        if g.widths[j] != g.rw0 {
            g.evFrame = d.frame;
            g.evKind = EDIT_RESIZE;
            g.evRow = g.row;
            g.evCol = j;
            g.evText = "";
        }
    }
}

fn one(d: &Dom, b: int, g: &Grid) {
    let n = &d.nodes.items[b];
    g.sx = n.scrollX;
    g.viewH = vlist.viewHeight(d, b);
    g.viewW = n.w;
    if d.pop.kind != popup.NONE {
        return;
    }
    if d.downHit >= 0 {
        g.px = d.mx;
        g.keep = d.focusWas == b || (g.editing && d.focusWas == editor(d, b));
    }
    resize(d, g, b);
    if g.pending {
        // `queuePaste` from outside a frame (a menu command, a test)
        g.pending = false;
        firePaste(d, g);
    }
    // the editor: focus it once it exists; losing focus (a click elsewhere) commits
    let ed = -1;
    if g.editing {
        ed = editor(d, b);
        if !g.seen {
            if ed >= 0 {
                d.focusNode(ed);
                d.poolEd = ed;
                g.seen = true;
            } else {
                g.wait += 1;
                if g.wait > WAIT {
                    stop(g);
                }
            }
        } else if ed < 0 {
            // the box is gone (its row left the list): commit what it held a frame ago
            fire(d, g, EDIT_COMMIT, g.last.str());
            stop(g);
            g.move(0, 0);
            d.focusNode(b);
        } else if d.focus != ed {
            commit(d, g, b, ed, 0, 0, false);
        }
    }
    if g.editing && ed >= 0 {
        g.last.clear();
        g.last.pushStr(d.eds.items[d.claim(ed)].str());
    }
    let k = &d.kin;
    // a press on a cell makes it active (Shift extends the range; a press inside the open editor is the editor's)
    let h = d.downHit;
    if h >= 0 && (h == b || isAncestor(d, b, h)) && !(g.editing && ed >= 0 && (h == ed || isAncestor(d, ed, h))) {
        g.ext = k.shift;
        g.goto(g.rowAt(d.my - d.absY(b) + n.scrollY), g.colAtView(d.mx - d.absX(b)));
        g.ext = false;
        g.drag = true;
    } else if g.drag {
        // dragging: the pointer's cell is the other corner. Above or below the box the row is outside the window,
        // `reveal` scrolls to it, so the speed follows the distance.
        if d.down && !g.editing {
            g.ext = true;
            g.goto(g.rowAt(d.my - d.absY(b) + n.scrollY), g.colAtView(d.mx - d.absX(b)));
            g.ext = false;
        } else {
            g.drag = false;
        }
    }
    let f = d.focus;
    if g.editing {
        if g.seen && f == ed && ed >= 0 {
            if k.esc {
                stop(g);
                d.focusNode(b);
                k.esc = false;
            } else if k.enter {
                commit(d, g, b, ed, if k.shift { -1 } else { 1 }, 0, true);
                k.enter = false;
            } else if k.tab {
                commit(d, g, b, ed, 0, if k.shift { -1 } else { 1 }, true);
                k.tab = false;
            }
        }
    } else if f == b {
        if k.enter || k.f2 {
            begin(d, g, false, "");
            k.enter = false;
            k.f2 = false;
        } else if k.ctrl && (k.a || k.c || k.x || k.v) {
            if k.a {
                g.selectAll();
            } else if k.v {
                paste(d, g, game.clipboard());
            } else {
                let t = g.copyText();
                if t.len > 0 {
                    game.setClipboard(t);
                    if k.x {
                        paste(d, g, "\n"); // cut: clear the range
                    }
                }
            }
            k.a = false;
            k.c = false;
            k.x = false;
            k.v = false;
        } else if k.typed.len > 0 && !k.ctrl && k.comp.len == 0 {
            begin(d, g, true, k.typed);
            k.typed = "";
        } else if k.tab {
            g.tab(if k.shift { -1 } else { 1 });
            k.tab = false;
        } else if k.left || k.right || k.up || k.down {
            let dr = 0;
            let dc = 0;
            if k.up { dr = -1; }
            if k.down { dr = 1; }
            if k.left { dc = -1; }
            if k.right { dc = 1; }
            g.ext = k.shift;
            if k.ctrl {
                g.jump(dr, dc);
            } else {
                g.move(dr, dc);
            }
            g.ext = false;
            k.left = false;
            k.right = false;
            k.up = false;
            k.down = false;
        } else if k.home || k.end {
            g.ext = k.shift;
            g.homeEnd(k.end, k.ctrl);
            g.ext = false;
            k.home = false;
            k.end = false;
        } else if k.pgup || k.pgdn {
            g.ext = k.shift;
            g.page(if k.pgdn { 1 } else { -1 });
            g.ext = false;
            k.pgup = false;
            k.pgdn = false;
        }
    }
    if g.reveal {
        g.reveal = false;
        showCell(d, g, b);
    }
}
