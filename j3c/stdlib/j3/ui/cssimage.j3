/// Value parsers for the image and shape properties of `j3.ui.css`: `url()`, `background-position`
/// and `object-position`, `background-size`, `border-image-slice`, and `clip-path` shapes. Each
/// writes a `V_LIST` (or `V_URL`) whose numbers sit in `Css.paints`; `j3.ui.imgfit` and `dom` read them.
///
/// Layouts (all lengths are `value, unit` pairs; unit `LU_PX`, `LU_PCT`, `LU_AUTO`, `LU_CLOSEST`, `LU_FARTHEST`):
///   position        [x, xu, y, yu]
///   background-size [mode, x, xu, y, yu]                      mode 0 lengths, 1 cover, 2 contain
///   slice           [top, right, bottom, left, fill, pct]     pct: bit i set when side i is a percentage of the image
///   repeat          [x, y]                                    `imgfit.REP_*`
///   border width    [v, unit] * 4                             unit `BW_NUM`, `BW_PX`, `BW_PCT`, `BW_AUTO`
///   border outset   [v, unit] * 4                             unit `BW_NUM`, `BW_PX`
///   background-size, -position and -repeat hold a comma list of entries (count in `Value.c`).
///   background-image with a `url()` among several layers is a `V_GRAD` list whose url layers are `[LAYER_URL, pathId, 0]`
///   (path id -1: `none`); a lone `url()` stays a `V_URL`.
///   clip-path       [CP_INSET, t, tu, r, ru, b, bu, l, lu, radius, ru]
///                   [CP_CIRCLE, r, ru, cx, cxu, cy, cyu]
///                   [CP_ELLIPSE, rx, rxu, ry, ryu, cx, cxu, cy, cyu]
///                   [CP_POLYGON, evenodd, n, (x, xu, y, yu) * n]

module j3.ui.cssimage;

use j3.text.same;
use j3.ui.css.{ P_BG_POS, P_BG_REPEAT, P_BG_SIZE, P_BORDER_IMG_W, P_BORDER_OUTSET, P_BORDER_REPEAT, P_BORDER_SLICE, P_CLIP_PATH, V_GRAD, V_LIST, V_NONE, V_PCT, V_PX, V_UNSET, V_URL, Value };
use j3.ui.csslex.{ T_COMMA, T_DELIM, T_FUNC, T_IDENT, T_LPAREN, T_NUM, T_PCT, T_RPAREN, T_URL, Token };
use j3.ui.cssvalue.{ gradientAt, gradients, isWord, mk, P, parseColor, parseLen, pf, setv, tk, txt, warnAt };
use j3.ui.imgfit.{ REP_NONE, REP_REPEAT, REP_ROUND, REP_SPACE };

pub const LU_PX: int = 0;
pub const LU_PCT: int = 1;
pub const LU_AUTO: int = 2;
pub const LU_CLOSEST: int = 3;
pub const LU_FARTHEST: int = 4;

/// Units of `border-image-width` / `-outset` entries.
pub const BW_NUM: int = 0;
pub const BW_PX: int = 1;
pub const BW_PCT: int = 2;
pub const BW_AUTO: int = 3;

/// Layer type of a `url()` layer in a `background-image` list (gradients are 0 to 2).
pub const LAYER_URL: int = 9;

/// Most `background-image` layers painted; more parse, warn, and are dropped.
pub const MAX_LAYERS: int = 8;

pub const CP_INSET: int = 1;
pub const CP_CIRCLE: int = 2;
pub const CP_ELLIPSE: int = 3;
pub const CP_POLYGON: int = 4;

/// Most vertices a `polygon()` may list (the painter's outline holds 127 points).
pub const MAX_POLY: int = 60;

/// Position scratch (x, xunit, y, yunit), written by `posVals`.
#[singleton]
#[thread]
let PV: [4]f32;

/// `url(...)` at `TOK[k]`.
pub fn url(p: &P, k: int, out: &Value): int {
    let t = tk(k);
    if t.kind != T_URL {
        return 0;
    }
    out.kind = V_URL;
    out.i = p.css.intern(txt(p, t));
    return 1;
}

/// A length token as value and unit; false for anything else.
fn lenTok(p: &P, t: &Token, v: &f32, u: &int): bool {
    let o = mk(V_UNSET, 0.0, 0, 0);
    if !parseLen(p, t, &o) {
        return false;
    }
    if o.kind == V_PX {
        *v = o.f;
        *u = LU_PX;
        return true;
    }
    if o.kind == V_PCT {
        *v = o.f;
        *u = LU_PCT;
        return true;
    }
    *v = 0.0;
    *u = LU_AUTO;
    return true;
}

/// `<position>` at `TOK[k..n)` (one or two of `left right top bottom center <length>`) into `PV`;
/// returns tokens used, 0 when none.
fn posVals(p: &P, k: int, n: int): int {
    let vals: [2]f32 = [50.0, 50.0];
    let units: [2]int = [LU_PCT, LU_PCT];
    // 0 a length, 1 only horizontal (left right), 2 only vertical (top bottom), 3 center
    let role: [2]int = [0, 0];
    let cnt = 0;
    while cnt < 2 && k + cnt < n {
        let t = tk(k + cnt);
        let v: f32 = 0.0;
        let u = 0;
        let r = 0;
        if t.kind == T_IDENT {
            if isWord(p, t, "left") { v = 0.0; u = LU_PCT; r = 1; }
            else if isWord(p, t, "right") { v = 100.0; u = LU_PCT; r = 1; }
            else if isWord(p, t, "top") { v = 0.0; u = LU_PCT; r = 2; }
            else if isWord(p, t, "bottom") { v = 100.0; u = LU_PCT; r = 2; }
            else if isWord(p, t, "center") { v = 50.0; u = LU_PCT; r = 3; }
            else { break; }
        } else if !lenTok(p, t, &v, &u) || u == LU_AUTO {
            break;
        }
        vals[cnt] = v;
        units[cnt] = u;
        role[cnt] = r;
        cnt += 1;
    }
    if cnt == 0 {
        return 0;
    }
    let xi = 0;
    let yi = 1;
    PV[0] = 50.0;
    PV[1] = f32(LU_PCT);
    PV[2] = 50.0;
    PV[3] = f32(LU_PCT);
    if cnt == 1 {
        if role[0] == 2 {
            PV[2] = vals[0];
            PV[3] = f32(units[0]);
        } else {
            PV[0] = vals[0];
            PV[1] = f32(units[0]);
        }
        return 1;
    }
    if role[0] == 2 || role[1] == 1 {
        xi = 1;
        yi = 0;
    }
    if role[xi] == 2 || role[yi] == 1 {
        return 0;
    }
    PV[0] = vals[xi];
    PV[1] = f32(units[xi]);
    PV[2] = vals[yi];
    PV[3] = f32(units[yi]);
    return 2;
}

fn pushPos(p: &P) {
    for i in 0..4 {
        pf(p, PV[i]);
    }
}

fn position(p: &P, k: int, n: int, out: &Value): int {
    let used = posVals(p, k, n);
    if used == 0 {
        return 0;
    }
    setv(out, mk(V_LIST, 0.0, p.css.paints.len, 0));
    pushPos(p);
    return used;
}

/// One `background-size` entry at `TOK[k..n)` pushed as `[mode, x, xu, y, yu]`; tokens used, 0 when invalid.
fn size(p: &P, k: int, n: int): int {
    let t = tk(k);
    let mode = 0;
    let used = 0;
    let vals: [2]f32 = [0.0, 0.0];
    let units: [2]int = [LU_AUTO, LU_AUTO];
    if isWord(p, t, "cover") {
        mode = 1;
        used = 1;
    } else if isWord(p, t, "contain") {
        mode = 2;
        used = 1;
    } else {
        while used < 2 && k + used < n && lenTok(p, tk(k + used), &vals[used], &units[used]) {
            used += 1;
        }
        if used == 0 {
            return 0;
        }
        if used == 1 {
            units[1] = LU_AUTO;
        }
    }
    pf(p, f32(mode));
    for i in 0..2 {
        pf(p, vals[i]);
        pf(p, f32(units[i]));
    }
    return used;
}

/// Repeat keywords at `TOK[k..n)` as `[x, y]`: for `background-repeat` `repeat no-repeat space round` (one word for
/// both axes, two for x then y) and `repeat-x` / `repeat-y`; for `border-image-repeat` `stretch repeat round space`.
/// Returns tokens used, 0 when invalid.
fn repeatVals(p: &P, k: int, n: int, border: bool, rep: &[2]int): int {
    let cnt = 0;
    let m: [2]int = [0, 0];
    while cnt < 2 && k + cnt < n {
        let t = tk(k + cnt);
        let v = -1;
        if isWord(p, t, "repeat") { v = REP_REPEAT; }
        else if isWord(p, t, "round") { v = REP_ROUND; }
        else if isWord(p, t, "space") { v = REP_SPACE; }
        else if border && isWord(p, t, "stretch") { v = REP_NONE; }
        else if !border && isWord(p, t, "no-repeat") { v = REP_NONE; }
        else if !border && cnt == 0 && isWord(p, t, "repeat-x") { *rep = [REP_REPEAT, REP_NONE]; return 1; }
        else if !border && cnt == 0 && isWord(p, t, "repeat-y") { *rep = [REP_NONE, REP_REPEAT]; return 1; }
        if v < 0 {
            break;
        }
        m[cnt] = v;
        cnt += 1;
    }
    if cnt == 0 {
        return 0;
    }
    if cnt == 1 {
        m[1] = m[0];
    }
    *rep = m;
    return cnt;
}

/// A comma list of `prop` entries (`background-size`, `-position`, `-repeat`) at `TOK[k..n)`; the count goes in `out.c`.
fn entryList(p: &P, prop: int, k: int, n: int, out: &Value): int {
    let head = p.css.paints.len;
    let cnt = 0;
    let j = k;
    while j < n {
        let used = 0;
        if prop == P_BG_SIZE {
            used = size(p, j, n);
        } else if prop == P_BG_REPEAT {
            let r: [2]int = [0, 0];
            used = repeatVals(p, j, n, false, &r);
            if used > 0 {
                pf(p, f32(r[0]));
                pf(p, f32(r[1]));
            }
        } else {
            used = posVals(p, j, n);
            if used > 0 {
                pushPos(p);
            }
        }
        if used == 0 {
            p.css.paints.len = head;
            return 0;
        }
        cnt += 1;
        j += used;
        if j < n && tk(j).kind == T_COMMA {
            j += 1;
            if j >= n {
                p.css.paints.len = head;
                return 0;
            }
        } else {
            break;
        }
    }
    setv(out, mk(V_LIST, 0.0, head, cnt));
    return j - k;
}

/// `border-image-slice`: one to four numbers or percentages and an optional `fill`, in any order.
pub fn slice(p: &P, k: int, n: int, out: &Value): int {
    let v: [4]f32 = [0.0, 0.0, 0.0, 0.0];
    let cnt = 0;
    let fill: f32 = 0.0;
    let pct: [4]bool = [false, false, false, false];
    let j = k;
    while j < n {
        let t = tk(j);
        if (t.kind == T_PCT || (t.kind == T_NUM && t.us == t.ue)) && cnt < 4 && t.f >= 0.0 {
            v[cnt] = t.f;
            pct[cnt] = t.kind == T_PCT;
            cnt += 1;
        } else if isWord(p, t, "fill") {
            fill = 1.0;
        } else {
            break;
        }
        j += 1;
    }
    if cnt == 0 {
        return 0;
    }
    // CSS order: top right bottom left, with missing sides copying the opposite ones
    if cnt == 1 { v[1] = v[0]; v[2] = v[0]; v[3] = v[0]; pct[1] = pct[0]; pct[2] = pct[0]; pct[3] = pct[0]; }
    else if cnt == 2 { v[2] = v[0]; v[3] = v[1]; pct[2] = pct[0]; pct[3] = pct[1]; }
    else if cnt == 3 { v[3] = v[1]; pct[3] = pct[1]; }
    let mask = 0;
    let bit = 1;
    for i in 0..4 {
        if pct[i] {
            mask += bit;
        }
        bit *= 2;
    }
    setv(out, mk(V_LIST, 0.0, p.css.paints.len, 0));
    for i in 0..4 {
        pf(p, v[i]);
    }
    pf(p, fill);
    pf(p, f32(mask));
    return j - k;
}

/// One to four `border-image-width` values (numbers, lengths, percentages, `auto`) or, with `outset`, `border-image-outset`
/// values (numbers, lengths), pushed as `[v, unit] * 4` with CSS side copying; tokens used, 0 when invalid.
fn sides4(p: &P, k: int, n: int, outset: bool): int {
    let v: [4]f32 = [0.0, 0.0, 0.0, 0.0];
    let u: [4]int = [0, 0, 0, 0];
    let cnt = 0;
    let j = k;
    while j < n && cnt < 4 {
        let t = tk(j);
        if t.kind == T_NUM && t.us == t.ue && t.f >= 0.0 {
            v[cnt] = t.f;
            u[cnt] = BW_NUM;
        } else if t.kind == T_PCT && !outset && t.f >= 0.0 {
            v[cnt] = t.f;
            u[cnt] = BW_PCT;
        } else if isWord(p, t, "auto") && !outset {
            v[cnt] = 0.0;
            u[cnt] = BW_AUTO;
        } else if t.kind == T_NUM {
            let lv: f32 = 0.0;
            let lu = 0;
            if !lenTok(p, t, &lv, &lu) || lu != LU_PX || lv < 0.0 {
                break;
            }
            v[cnt] = lv;
            u[cnt] = BW_PX;
        } else {
            break;
        }
        cnt += 1;
        j += 1;
    }
    if cnt == 0 {
        return 0;
    }
    if cnt == 1 { v[1] = v[0]; u[1] = u[0]; v[2] = v[0]; u[2] = u[0]; v[3] = v[0]; u[3] = u[0]; }
    else if cnt == 2 { v[2] = v[0]; u[2] = u[0]; v[3] = v[1]; u[3] = u[1]; }
    else if cnt == 3 { v[3] = v[1]; u[3] = u[1]; }
    for i in 0..4 {
        pf(p, v[i]);
        pf(p, f32(u[i]));
    }
    return j - k;
}

fn isSlash(k: int): bool {
    return tk(k).kind == T_DELIM && tk(k).ch == 47;
}

/// Shorthand `border-image`: `<source> || <slice> [/ <width>? [/ <outset>]] || <repeat>` at `TOK[0..n)`.
/// Fills the five values (unset ones stay `V_NONE`); false when invalid.
pub fn borderImage(p: &P, n: int, src: &Value, sl: &Value, wd: &Value, ot: &Value, rp: &Value): bool {
    let head = p.css.paints.len;
    let j = 0;
    let haveSrc = false;
    let haveSlice = false;
    let haveRep = false;
    let ok = true;
    while ok && j < n {
        let t = tk(j);
        let used = 0;
        if !haveSrc && isWord(p, t, "none") {
            src.kind = V_NONE;
            used = 1;
            haveSrc = true;
        } else if !haveSrc && t.kind == T_URL {
            used = url(p, j, src);
            haveSrc = true;
        } else if !haveSrc && t.kind == T_FUNC {
            used = gradients(p, j, n, src, false);
            haveSrc = true;
        } else if !haveSlice && (t.kind == T_PCT || t.kind == T_NUM || isWord(p, t, "fill")) {
            haveSlice = true;
            used = slice(p, j, n, sl);
            let q = j + used;
            if used > 0 && q < n && isSlash(q) {
                q += 1;
                if q >= n {
                    used = 0;
                } else if !isSlash(q) {
                    let w = sides4(p, q, n, false);
                    if w == 0 {
                        used = 0;
                    } else {
                        setv(wd, mk(V_LIST, 0.0, p.css.paints.len - 8, 0));
                        q += w;
                    }
                }
                if used > 0 && q < n && isSlash(q) {
                    let w2 = sides4(p, q + 1, n, true);
                    if w2 == 0 {
                        used = 0;
                    } else {
                        setv(ot, mk(V_LIST, 0.0, p.css.paints.len - 8, 0));
                        q += 1 + w2;
                    }
                }
            }
            if used > 0 {
                used = q - j;
            }
        } else if !haveRep {
            let r: [2]int = [0, 0];
            used = repeatVals(p, j, n, true, &r);
            if used > 0 {
                setv(rp, mk(V_LIST, 0.0, p.css.paints.len, 0));
                pf(p, f32(r[0]));
                pf(p, f32(r[1]));
                haveRep = true;
            }
        }
        if used == 0 {
            ok = false;
        }
        j += used;
    }
    if !ok || j != n {
        p.css.paints.len = head;
        return false;
    }
    return true;
}

/// Up to four lengths from `j` (stops at `round`, a comma, or the closing paren), pushed as
/// `[value, unit]` for top right bottom left with CSS copying; returns the next index or -1.
fn inset(p: &P, j0: int, n: int): int {
    let v: [4]f32 = [0.0, 0.0, 0.0, 0.0];
    let u: [4]int = [0, 0, 0, 0];
    let cnt = 0;
    let j = j0;
    while j < n && cnt < 4 && lenTok(p, tk(j), &v[cnt], &u[cnt]) && u[cnt] != LU_AUTO {
        cnt += 1;
        j += 1;
    }
    if cnt == 0 {
        return -1;
    }
    if cnt == 1 { v[1] = v[0]; u[1] = u[0]; v[2] = v[0]; u[2] = u[0]; v[3] = v[0]; u[3] = u[0]; }
    else if cnt == 2 { v[2] = v[0]; u[2] = u[0]; v[3] = v[1]; u[3] = u[1]; }
    else if cnt == 3 { v[3] = v[1]; u[3] = u[1]; }
    for i in 0..4 {
        pf(p, v[i]);
        pf(p, f32(u[i]));
    }
    return j;
}

/// `at <position>` when present at `j`; pushes x, xu, y, yu (50% 50% otherwise); returns the next index or -1.
fn atPos(p: &P, j: int, n: int): int {
    if j < n && isWord(p, tk(j), "at") {
        let used = posVals(p, j + 1, n);
        if used == 0 {
            return -1;
        }
        pushPos(p);
        return j + 1 + used;
    }
    PV[0] = 50.0;
    PV[1] = f32(LU_PCT);
    PV[2] = 50.0;
    PV[3] = f32(LU_PCT);
    pushPos(p);
    return j;
}

/// A radius: a length, `closest-side` or `farthest-side`; pushes value and unit.
fn radius(p: &P, j: int, n: int): int {
    if j >= n {
        return -1;
    }
    let t = tk(j);
    let v: f32 = 0.0;
    let u = 0;
    if isWord(p, t, "closest-side") {
        pf(p, 0.0);
        pf(p, f32(LU_CLOSEST));
        return j + 1;
    }
    if isWord(p, t, "farthest-side") {
        pf(p, 0.0);
        pf(p, f32(LU_FARTHEST));
        return j + 1;
    }
    if !lenTok(p, t, &v, &u) || u == LU_AUTO || v < 0.0 {
        return -1;
    }
    pf(p, v);
    pf(p, f32(u));
    return j + 1;
}

/// The shape function at `TOK[k..n)`; returns tokens used or 0.
fn shape(p: &P, k: int, n: int, out: &Value): int {
    let t = tk(k);
    if t.kind != T_FUNC {
        return 0;
    }
    let name = txt(p, t);
    let head = p.css.paints.len;
    let j = k + 1;
    let ok = true;
    if same(name, "inset") {
        pf(p, f32(CP_INSET));
        j = inset(p, j, n);
        ok = j >= 0;
        if ok && j < n && isWord(p, tk(j), "round") {
            // one radius for all corners (per-corner radii are not supported)
            j += 1;
            let v: f32 = 0.0;
            let u = 0;
            ok = j < n && lenTok(p, tk(j), &v, &u) && u != LU_AUTO;
            if ok {
                pf(p, v);
                pf(p, f32(u));
                j += 1;
            }
        } else if ok {
            pf(p, 0.0);
            pf(p, f32(LU_PX));
        }
    } else if same(name, "circle") {
        pf(p, f32(CP_CIRCLE));
        if j < n && !isWord(p, tk(j), "at") && tk(j).kind != T_RPAREN {
            j = radius(p, j, n);
        } else {
            pf(p, 0.0);
            pf(p, f32(LU_CLOSEST));
        }
        ok = j >= 0;
        if ok {
            j = atPos(p, j, n);
            ok = j >= 0;
        }
    } else if same(name, "ellipse") {
        pf(p, f32(CP_ELLIPSE));
        if j < n && !isWord(p, tk(j), "at") && tk(j).kind != T_RPAREN {
            j = radius(p, j, n);
            if j >= 0 {
                j = radius(p, j, n);
            }
        } else {
            pf(p, 0.0);
            pf(p, f32(LU_CLOSEST));
            pf(p, 0.0);
            pf(p, f32(LU_CLOSEST));
        }
        ok = j >= 0;
        if ok {
            j = atPos(p, j, n);
            ok = j >= 0;
        }
    } else if same(name, "polygon") {
        pf(p, f32(CP_POLYGON));
        // slots head + 1 (fill rule) and head + 2 (count) are filled in below
        pf(p, 0.0);
        pf(p, 0.0);
        let evenodd: f32 = 0.0;
        let lead = false;
        if j < n && isWord(p, tk(j), "evenodd") {
            evenodd = 1.0;
            lead = true;
        } else if j < n && isWord(p, tk(j), "nonzero") {
            lead = true;
        }
        if lead {
            j += 1;
            if j < n && tk(j).kind == T_COMMA {
                j += 1;
            } else {
                ok = false;
            }
        }
        let cnt = 0;
        while ok && j < n && tk(j).kind != T_RPAREN {
            let xv: f32 = 0.0;
            let xu = 0;
            let yv: f32 = 0.0;
            let yu = 0;
            if j + 1 < n && cnt < MAX_POLY && lenTok(p, tk(j), &xv, &xu) && lenTok(p, tk(j + 1), &yv, &yu) && xu != LU_AUTO && yu != LU_AUTO {
                pf(p, xv);
                pf(p, f32(xu));
                pf(p, yv);
                pf(p, f32(yu));
                cnt += 1;
                j += 2;
                if j < n && tk(j).kind == T_COMMA {
                    j += 1;
                }
            } else {
                ok = false;
            }
        }
        ok = ok && cnt >= 3;
        if ok {
            p.css.paints.items[head + 1] = evenodd;
            p.css.paints.items[head + 2] = f32(cnt);
        }
    } else {
        return 0;
    }
    if !ok || j < 0 || j >= n || tk(j).kind != T_RPAREN {
        p.css.paints.len = head;
        return 0;
    }
    setv(out, mk(V_LIST, 0.0, head, 0));
    return j + 1 - k;
}

/// One `background-image` layer at `TOK[j]` appended to `paints`: `url()` as `[LAYER_URL, pathId, 0]`, `none` as the same
/// with id -1, or a gradient. Returns tokens used, 0 when it is none of them.
fn imageLayer(p: &P, j: int, n: int): int {
    let t = tk(j);
    if t.kind == T_URL {
        pf(p, f32(LAYER_URL));
        pf(p, f32(p.css.intern(txt(p, t))));
        pf(p, 0.0);
        return 1;
    }
    if isWord(p, t, "none") {
        pf(p, f32(LAYER_URL));
        pf(p, -1.0);
        pf(p, 0.0);
        return 1;
    }
    return gradientAt(p, j, n);
}

/// Close the layer list that starts at `paints[head]` (count slot already pushed): a lone `url()` becomes a plain
/// `V_URL`, a lone `none` a `V_NONE`; more than `MAX_LAYERS` layers warn and the extra ones are never painted.
fn finishLayers(p: &P, head: int, count: int, at: int, out: &Value) {
    let a = p.css.paints.items;
    if count == 1 && int(a[head + 1]) == LAYER_URL {
        let id = int(a[head + 2]);
        p.css.paints.len = head;
        if id < 0 {
            out.kind = V_NONE;
        } else {
            out.kind = V_URL;
            out.i = id;
        }
        return;
    }
    if count > MAX_LAYERS {
        warnAt(p, tk(at).line, tk(at).col, "more than 8 background layers: the extra ones are ignored");
    }
    p.css.paints.items[head] = f32(count);
    setv(out, mk(V_GRAD, 0.0, head, 0));
}

/// `background-image` at `TOK[k..n)` when it has a `url()` among its layers (else `gradients` handles it);
/// returns tokens used, 0 when invalid.
pub fn bgImage(p: &P, k: int, n: int, out: &Value): int {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let j = k;
    let count = 0;
    while j < n {
        let used = imageLayer(p, j, n);
        if used == 0 {
            break;
        }
        count += 1;
        j += used;
        if j < n && tk(j).kind == T_COMMA {
            j += 1;
            if j >= n {
                count = 0;
            }
        } else {
            break;
        }
    }
    if count == 0 {
        p.css.paints.len = head;
        return 0;
    }
    finishLayers(p, head, count, k, out);
    return j - k;
}

/// Index of the first top-level comma in `TOK[j..n)`, or `n`.
fn layerEnd(j: int, n: int): int {
    let depth = 0;
    while j < n {
        let kd = tk(j).kind;
        if kd == T_FUNC || kd == T_LPAREN {
            depth += 1;
        } else if kd == T_RPAREN {
            depth -= 1;
        } else if kd == T_COMMA && depth <= 0 {
            return j;
        }
        j += 1;
    }
    return n;
}

#[singleton]
#[thread]
let LPOS: [40]f32;

#[singleton]
#[thread]
let LSIZE: [48]f32;

#[singleton]
#[thread]
let LREP: [20]f32;

/// The `background` shorthand when it has a `url()`: comma layers of `<image> <position> [/ <size>] <repeat>` in any order,
/// the last layer may also hold the base color. Fills the image, position, size, repeat and color values (every layer gets
/// an entry in each list, so the shorthand resets the longhands); false when invalid.
pub fn bgShorthand(p: &P, n: int, img: &Value, pos: &Value, sz: &Value, rep: &Value, col: &Value): bool {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let count = 0;
    let j = 0;
    let ok = true;
    col.kind = V_UNSET;
    while ok && j < n {
        let e = layerEnd(j, n);
        let last = e == n;
        let hasImg = false;
        let hasRep = false;
        let hasPos = false;
        let hasCol = false;
        // layers past the cap write to a spare slot
        let slot = count;
        if slot > MAX_LAYERS {
            slot = MAX_LAYERS;
        }
        // defaults: 0% 0%, auto auto, repeat repeat
        let po = slot * 4;
        LPOS[po] = 0.0; LPOS[po + 1] = f32(LU_PCT); LPOS[po + 2] = 0.0; LPOS[po + 3] = f32(LU_PCT);
        let so = slot * 5;
        LSIZE[so] = 0.0; LSIZE[so + 1] = 0.0; LSIZE[so + 2] = f32(LU_AUTO); LSIZE[so + 3] = 0.0; LSIZE[so + 4] = f32(LU_AUTO);
        LREP[slot * 2] = f32(REP_REPEAT);
        LREP[slot * 2 + 1] = f32(REP_REPEAT);
        while ok && j < e {
            let used = 0;
            if !hasImg {
                used = imageLayer(p, j, n);
                hasImg = used > 0;
            }
            if used == 0 && !hasRep {
                let r: [2]int = [0, 0];
                used = repeatVals(p, j, e, false, &r);
                if used > 0 {
                    LREP[slot * 2] = f32(r[0]);
                    LREP[slot * 2 + 1] = f32(r[1]);
                    hasRep = true;
                }
            }
            if used == 0 && !hasPos {
                used = posVals(p, j, e);
                if used > 0 {
                    for q in 0..4 {
                        LPOS[po + q] = PV[q];
                    }
                    hasPos = true;
                    if j + used < e && isSlash(j + used) {
                        let sused = size(p, j + used + 1, e);
                        if sused == 0 {
                            ok = false;
                        } else {
                            // `size` pushed its entry at the end of paints: copy it out and drop it
                            let at = p.css.paints.len - 5;
                            for q in 0..5 {
                                LSIZE[so + q] = p.css.paints.items[at + q];
                            }
                            p.css.paints.len = at;
                            used += 1 + sused;
                        }
                    }
                }
            }
            if used == 0 && last && !hasCol {
                used = parseColor(p, j, e, col);
                hasCol = used > 0;
            }
            if used == 0 {
                ok = false;
            }
            j += used;
        }
        if ok && !hasImg {
            // only the base color is allowed to stand without an image
            ok = last && hasCol && !hasPos && !hasRep;
            if ok && count == 0 {
                ok = false;
            }
        } else if ok {
            count += 1;
        }
        if !ok || e >= n {
            break;
        }
        j = e + 1;
        if j >= n {
            ok = false;
        }
    }
    if !ok || count == 0 {
        p.css.paints.len = head;
        return false;
    }
    finishLayers(p, head, count, 0, img);
    let k = count;
    if k > MAX_LAYERS {
        k = MAX_LAYERS;
    }
    setv(pos, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 4 { pf(p, LPOS[q]); }
    setv(sz, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 5 { pf(p, LSIZE[q]); }
    setv(rep, mk(V_LIST, 0.0, p.css.paints.len, k));
    for q in 0..k * 2 { pf(p, LREP[q]); }
    return true;
}

/// Parse a `C_SHAPE` property value at `TOK[k..n)`; tokens used, 0 on failure.
pub fn parseShape(p: &P, prop: int, k: int, n: int, out: &Value): int {
    if isWord(p, tk(k), "none") {
        out.kind = V_NONE;
        return 1;
    }
    let head = p.css.paints.len;
    let used = 0;
    if prop == P_CLIP_PATH {
        used = shape(p, k, n, out);
    } else if prop == P_BORDER_SLICE {
        used = slice(p, k, n, out);
    } else if prop == P_BG_SIZE || prop == P_BG_POS || prop == P_BG_REPEAT {
        used = entryList(p, prop, k, n, out);
    } else if prop == P_BORDER_REPEAT {
        let r: [2]int = [0, 0];
        used = repeatVals(p, k, n, true, &r);
        if used > 0 {
            setv(out, mk(V_LIST, 0.0, p.css.paints.len, 0));
            pf(p, f32(r[0]));
            pf(p, f32(r[1]));
        }
    } else if prop == P_BORDER_IMG_W || prop == P_BORDER_OUTSET {
        setv(out, mk(V_LIST, 0.0, p.css.paints.len, 0));
        used = sides4(p, k, n, prop == P_BORDER_OUTSET);
    } else {
        used = position(p, k, n, out);
    }
    if used == 0 {
        p.css.paints.len = head;
    }
    return used;
}
