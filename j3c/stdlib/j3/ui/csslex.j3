/// Tokenizer for `j3.ui.css`: `next(&lx)` returns the next `Token` (idents, numbers with units, hashes, strings, urls, functions, punctuation).
/// Private to the CSS parser; `j3.ui.cssvalue` and friends are its callers.

module j3.ui.csslex;

use j3.text.same;

pub const T_EOF: int = 0;

pub const T_IDENT: int = 1;

pub const T_HASH: int = 2;

pub const T_NUM: int = 3;

pub const T_PCT: int = 4;

pub const T_STR: int = 5;

pub const T_URL: int = 6;

pub const T_FUNC: int = 7;

pub const T_DELIM: int = 8;

pub const T_COLON: int = 9;

pub const T_SEMI: int = 10;

pub const T_LBRACE: int = 11;

pub const T_RBRACE: int = 12;

pub const T_LPAREN: int = 13;

pub const T_RPAREN: int = 14;

pub const T_COMMA: int = 15;

pub const T_LBRACK: int = 16;

pub const T_RBRACK: int = 17;

pub const T_AT: int = 18;

pub struct Token {
    kind: int;
    /// Text range in the source (ident name, hash name without `#`, string or url content).
    s: int;
    e: int;
    ch: int;
    f: f32;
    /// Unit range of a number.
    us: int;
    ue: int;
    line: int;
    col: int;
    /// Whitespace or a comment came before this token.
    sp: bool;
}

pub struct Lexer {
    src: string;
    pos: int;
    line: int;
    ls: int;
}

fn isDigit(c: int): bool {
    return c >= 48 && c <= 57;
}

fn isIdStart(c: int): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c >= 128;
}

fn isIdChar(c: int): bool {
    return isIdStart(c) || isDigit(c) || c == 45;
}

fn at(lx: &Lexer, i: int): int {
    if i >= lx.src.len {
        return 0;
    }
    return int(lx.src[i]);
}

fn skipWs(lx: &Lexer): bool {
    let start = lx.pos;
    let n = lx.src.len;
    while lx.pos < n {
        let c = int(lx.src[lx.pos]);
        if c == 10 {
            lx.pos += 1;
            lx.line += 1;
            lx.ls = lx.pos;
        } else if c == 32 || c == 9 || c == 13 || c == 12 {
            lx.pos += 1;
        } else if c == 47 && at(lx, lx.pos + 1) == 42 {
            lx.pos += 2;
            while lx.pos < n && !(int(lx.src[lx.pos]) == 42 && at(lx, lx.pos + 1) == 47) {
                if int(lx.src[lx.pos]) == 10 {
                    lx.line += 1;
                    lx.ls = lx.pos + 1;
                }
                lx.pos += 1;
            }
            lx.pos += 2;
            if lx.pos > n {
                lx.pos = n;
            }
        } else {
            break;
        }
    }
    return lx.pos > start;
}

fn readIdent(lx: &Lexer) {
    while lx.pos < lx.src.len && isIdChar(int(lx.src[lx.pos])) {
        lx.pos += 1;
    }
}

pub fn next(lx: &Lexer): Token {
    let sp = skipWs(lx);
    let t = Token { kind: T_EOF, s: lx.pos, e: lx.pos, ch: 0, f: 0.0, us: 0, ue: 0, line: lx.line, col: lx.pos - lx.ls + 1, sp: sp };
    let n = lx.src.len;
    if lx.pos >= n {
        return t;
    }
    let c = int(lx.src[lx.pos]);
    let c1 = at(lx, lx.pos + 1);
    let c2 = at(lx, lx.pos + 2);
    let signed = (c == 45 || c == 43) && (isDigit(c1) || (c1 == 46 && isDigit(c2)));
    if isDigit(c) || (c == 46 && isDigit(c1)) || signed {
        let neg = false;
        if c == 45 {
            neg = true;
            lx.pos += 1;
        } else if c == 43 {
            lx.pos += 1;
        }
        let ip = 0;
        while isDigit(at(lx, lx.pos)) {
            ip = ip * 10 + (at(lx, lx.pos) - 48);
            lx.pos += 1;
        }
        let fp = 0;
        let div = 1;
        if at(lx, lx.pos) == 46 && isDigit(at(lx, lx.pos + 1)) {
            lx.pos += 1;
            while isDigit(at(lx, lx.pos)) {
                if div < 100000000 {
                    fp = fp * 10 + (at(lx, lx.pos) - 48);
                    div = div * 10;
                }
                lx.pos += 1;
            }
        }
        t.f = f32(ip) + f32(fp) / f32(div);
        if neg {
            t.f = 0.0 - t.f;
        }
        t.e = lx.pos;
        if at(lx, lx.pos) == 37 {
            lx.pos += 1;
            t.kind = T_PCT;
        } else {
            t.kind = T_NUM;
            t.us = lx.pos;
            if isIdStart(at(lx, lx.pos)) {
                readIdent(lx);
            }
            t.ue = lx.pos;
        }
        return t;
    }
    if isIdStart(c) || (c == 45 && (isIdStart(c1) || c1 == 45)) {
        lx.pos += 1;
        readIdent(lx);
        t.e = lx.pos;
        t.kind = T_IDENT;
        if at(lx, lx.pos) == 40 {
            lx.pos += 1;
            t.kind = T_FUNC;
            if same(lx.src[t.s..t.e], "url") {
                skipWs(lx);
                let q = at(lx, lx.pos);
                if q == 34 || q == 39 {
                    lx.pos += 1;
                    t.s = lx.pos;
                    while lx.pos < n && at(lx, lx.pos) != q && at(lx, lx.pos) != 10 {
                        lx.pos += 1;
                    }
                    t.e = lx.pos;
                    lx.pos += 1;
                    while lx.pos < n && at(lx, lx.pos) != 41 {
                        lx.pos += 1;
                    }
                } else {
                    t.s = lx.pos;
                    while lx.pos < n && at(lx, lx.pos) != 41 {
                        lx.pos += 1;
                    }
                    t.e = lx.pos;
                }
                lx.pos += 1;
                t.kind = T_URL;
            }
        }
        return t;
    }
    lx.pos += 1;
    if c == 35 {
        t.s = lx.pos;
        readIdent(lx);
        t.e = lx.pos;
        t.kind = T_HASH;
    } else if c == 34 || c == 39 {
        t.s = lx.pos;
        while lx.pos < n && at(lx, lx.pos) != c && at(lx, lx.pos) != 10 {
            lx.pos += 1;
        }
        t.e = lx.pos;
        lx.pos += 1;
        t.kind = T_STR;
    } else if c == 64 {
        t.s = lx.pos;
        readIdent(lx);
        t.e = lx.pos;
        t.kind = T_AT;
    } else if c == 58 {
        t.kind = T_COLON;
    } else if c == 59 {
        t.kind = T_SEMI;
    } else if c == 123 {
        t.kind = T_LBRACE;
    } else if c == 125 {
        t.kind = T_RBRACE;
    } else if c == 40 {
        t.kind = T_LPAREN;
    } else if c == 41 {
        t.kind = T_RPAREN;
    } else if c == 44 {
        t.kind = T_COMMA;
    } else if c == 91 {
        t.kind = T_LBRACK;
    } else if c == 93 {
        t.kind = T_RBRACK;
    } else {
        t.kind = T_DELIM;
        t.ch = c;
    }
    if t.kind != T_STR {
        t.e = lx.pos;
    }
    return t;
}
