/// `@keyframes` animations of a node (`animation` with up to `MAX_ANIM` comma-separated entries): matching the entries to the slots a `Motion`
/// already runs (`startAnims`), sampling a stop list (`var()` and `%` resolved per element), and the two-pass per-frame step of each slot.

module j3.ui.motionkf;

use j3.ui.xform;
use j3.ui.xform.{ REC, XI, XN };
use j3.ui.anim;
use j3.ui.anim.{ SH, SH_MAX };
use j3.ui.gradmix;
use j3.ui.css.{ lenToPx, V_EM, V_REM, V_PCT, P_FONT_SIZE, animAt, animCount, animKind, transCount, transDelay, transEase, Css, Frame, Keyframes, MAX_ANIM, Value };
use j3.ui.cssmatch.{ stopValue, varValue };
use j3.ui.css.coerceSyn;
use j3.ui.cssprop.calcProp;
use j3.ui.csscalc.{ O_ADD, O_PCT, O_PX };
use j3.ui.css.{ CK_COLOR, CK_GRAD, CK_LEN, CK_NONE, CK_NUM, CK_SHADOW, CK_VAR, CK_XFORM, NPROPS, VBASE };
use j3.ui.css.{ P_ANIM_DELAY, P_ANIM_DIR, P_ANIM_DUR, P_ANIM_EASE, P_ANIM_FILL, P_ANIM_ITER, P_ANIM_NAME };
use j3.ui.css.{ SY_URL, P_DEFER, P_BG_IMAGE, P_BORDER_IMAGE, P_BOX_SHADOW, P_COLOR, P_FLEX, P_OPACITY, P_RADIUS_TL, P_TRANS0, P_TRANSFORM, P_TRANSLATE, P_SCALE };
use j3.ui.css.{ V_ANG, V_ANIM, V_CALC, V_UNSET, V_COLOR, V_CURRENT, V_EASE, V_GRAD, V_NONE, V_NUM, V_PX, V_SHADOW, V_TRANS, V_XFORM };

use j3.ui.motionbase.{ MAXT, MAXV, Motion, SHN, STEP_LAYOUT, STEP_LIVE, blendable, chanOf, chanVal, colorVal, curve, ensureOverlay, gradRegion, gslot, isXProp, kindOf, layoutProp, loadShadow, mixGrad, mixOut, mixVal, num, outOff, put, putShadow, realProp, refresh, sameVal, snapGrad, snapOff, xoff, xprop, zeroValue };

#[singleton]
let SA: [37]f32;
#[singleton]
let SB: [37]f32;
#[singleton]
let SC: [37]f32;

/// Match the animations of style `st` (`animation-name` entries) to the ones running: an entry whose name is already
/// running keeps its timeline (adding or removing a neighbour restarts nothing), a new name starts at `now`.
pub fn startAnims(m: &Motion, css: &Css, st: int, now: f32) {
    let on = m.kname;
    let okf = m.kf;
    let ot = m.kt0;
    let oh = m.kheld;
    let of = m.kfin;
    let taken: [4]bool = [false, false, false, false];
    let nn = animCount(css, st);
    for k in 0..MAX_ANIM {
        m.kname[k] = -1;
        m.kf[k] = -1;
        m.kheld[k] = false;
        m.kfin[k] = false;
        let nv = animAt(css, st, P_ANIM_NAME, k);
        if k >= nn || nv.kind != V_ANIM {
            continue;
        }
        let j = -1;
        if on[k] == nv.i && !taken[k] {
            j = k;
        } else {
            for q in 0..MAX_ANIM {
                if j < 0 && on[q] == nv.i && !taken[q] {
                    j = q;
                }
            }
        }
        m.kname[k] = nv.i;
        if j < 0 {
            m.kf[k] = css.findKf(nv.i);
            m.kt0[k] = now;
            continue;
        }
        taken[j] = true;
        m.kt0[k] = ot[j];
        m.kheld[k] = oh[j];
        m.kfin[k] = of[j];
        m.kf[k] = okf[j];
        if m.kf[k] < 0 && !of[j] {
            m.kf[k] = css.findKf(nv.i);
        }
    }
}

// ---- keyframes ----------------------------------------------------------------------------------------------

fn findDecl(css: &Css, fr: &Frame, prop: int): int {
    for d in 0..fr.ndecl {
        let dp = css.decls.items[fr.decl0 + d].prop;
        if dp == prop || (dp == P_DEFER && css.dtpl.items[css.decls.items[fr.decl0 + d].v.i].prop == prop) {
            return fr.decl0 + d;
        }
    }
    return -1;
}

fn lenOrPct(v: Value): bool {
    return v.kind == V_PX || v.kind == V_PCT;
}

/// `a` to `b` (px or `%`, at least one `%`) at `e`: `%` against `%` stays a `%`; with px it is `calc(px + %)` in the channel's
/// scratch program in `Css.paints` (3 ops: px, %, add). `V_UNSET` when the property does not take a `calc()` or the channel has
/// no scratch left (8 per element), then the caller jumps at the middle like any unmixable pair.
fn mixPct(m: &Motion, css: &Css, cp: int, a: Value, b: Value, e: f32): Value {
    let apx: f32 = 0.0;
    let apc: f32 = 0.0;
    let bpx: f32 = 0.0;
    let bpc: f32 = 0.0;
    if a.kind == V_PCT { apc = a.f; } else { apx = a.f; }
    if b.kind == V_PCT { bpc = b.f; } else { bpx = b.f; }
    let px = anim.mix(apx, bpx, e);
    let pc = anim.mix(apc, bpc, e);
    if a.kind == V_PCT && b.kind == V_PCT {
        if pc < 0.0 && !(cp >= 2 && cp <= 5) { pc = 0.0; }
        return Value { kind: V_PCT, f: pc, i: 0, c: 0 };
    }
    if !calcProp(cp) {
        return zeroValue();
    }
    let q = 0;
    while q < 8 && m.cc[q] != 0 && m.cc[q] != cp + 1 {
        q += 1;
    }
    if q == 8 {
        return zeroValue();
    }
    if m.cc[q] == 0 {
        m.cc[q] = cp + 1;
        m.co[q] = css.paints.len;
        for z in 0..6 {
            css.paints.push(0.0);
        }
    }
    let o = m.co[q];
    let a2 = css.paints.items;
    a2[o] = f32(O_PX);
    a2[o + 1] = px;
    a2[o + 2] = f32(O_PCT);
    a2[o + 3] = pc;
    a2[o + 4] = f32(O_ADD);
    a2[o + 5] = 0.0;
    return Value { kind: V_CALC, f: 0.0, i: o, c: 3 };
}

/// Sample channel `cp` of keyframes `kf` at position `pos` into the overlay. `animEase` is the
/// element's `animation-timing-function` (a stop may override it for the span after it).
fn sampleChan(m: &Motion, css: &Css, kf: &Keyframes, cp: int, pos: f32, tst: int, animEase: int) {
    let rp = realProp(cp);
    let vs = css.varsOf(tst);
    let loAt: f32 = 0.0;
    let hiAt: f32 = 1.0;
    let syn = -1;
    let base = zeroValue();
    if cp >= VBASE {
        syn = css.regs.items[css.regOf(rp - NPROPS)].syn;
        base = varValue(css, vs, rp - NPROPS);
    } else {
        base = css.get(tst, rp);
    }
    let loV = chanOf(css, base, tst, cp);
    let hiV = loV;
    let ez = animEase;
    for fi in 0..kf.nf {
        let fr = &css.frames.items[kf.f0 + fi];
        let di = findDecl(css, fr, rp);
        if di < 0 {
            continue;
        }
        let raw = stopValue(css, di, rp, vs);
        if raw.kind == V_UNSET {
            continue;
        }
        let v = chanOf(css, raw, tst, cp);
        if syn >= 0 {
            // a stop of a registered custom property takes only values of its type
            v = coerceSyn(css, syn, v, css.get(tst, P_FONT_SIZE).f);
            if v.kind == V_UNSET {
                continue;
            }
        }
        if fr.at <= pos {
            loAt = fr.at;
            loV = v;
            let ei = findDecl(css, fr, P_ANIM_EASE);
            ez = animEase;
            if ei >= 0 {
                ez = css.decls.items[ei].v.i;
            }
        } else {
            hiAt = fr.at;
            hiV = v;
            break;
        }
    }
    let e: f32 = 0.0;
    if hiAt > loAt {
        e = curve(css, ez, (pos - loAt) / (hiAt - loAt));
    }
    if kindOf(cp) == CK_SHADOW {
        loadShadow(css, loV, SA[0..SHN]);
        loadShadow(css, hiV, SB[0..SHN]);
        let len = anim.mixShadows(SA[0..SHN], 0, SB[0..SHN], 0, e, SC[0..SHN]);
        putShadow(m, css, SC[0..SHN], len);
        return;
    }
    if kindOf(cp) == CK_LEN && (loV.kind == V_PCT || hiV.kind == V_PCT) && lenOrPct(loV) && lenOrPct(hiV) {
        // a `%` mixes with px as a `calc()` that layout resolves against the containing block
        let pv = mixPct(m, css, cp, loV, hiV, e);
        if pv.kind != V_UNSET {
            put(m, css, cp, pv);
            return;
        }
    }
    if !blendable(css, cp, loV, hiV) {
        if e < 0.5 { put(m, css, cp, loV); } else { put(m, css, cp, hiV); }
        return;
    }
    put(m, css, cp, mixOut(m, css, cp, loV, hiV, e));
}

/// Write every property the keyframes animate: sampled at `pos` when `pos >= 0`, else the computed
/// value (`tst`). Returns true when a layout property was written.
fn applyFrames(m: &Motion, css: &Css, kf: &Keyframes, pos: f32, tst: int, animEase: int, vars: bool): bool {
    let layout = false;
    for q in 0..kf.nprop {
        let rp = kf.props[q];
        if (rp >= NPROPS) != vars {
            continue;
        }
        if rp >= NPROPS && (css.regs.len == 0 || css.regOf(rp - NPROPS) < 0 || css.regs.items[css.regOf(rp - NPROPS)].syn == 0 || css.regs.items[css.regOf(rp - NPROPS)].syn == SY_URL) {
            // not registered (or untyped): custom properties only animate with an `@property` type
            continue;
        }
        for part in 0..1 {
            let cp = rp;
            if rp >= NPROPS {
                cp = rp + 4;
            } else if rp == P_TRANSFORM {
                cp = NPROPS;
            } else if isXProp(rp) {
                cp = NPROPS + 1 + rp - P_TRANSLATE;
            }
            if pos >= 0.0 {
                sampleChan(m, css, kf, cp, pos, tst, animEase);
            } else if kindOf(cp) == CK_SHADOW {
                css.vals.items[m.ov * NPROPS + cp] = css.get(tst, cp);
            } else if cp < VBASE {
                // (a custom property finished without fill leaves no override: `applyVars` puts the readers back)
                put(m, css, cp, chanVal(css, tst, cp));
            }
            if layoutProp(cp) {
                layout = true;
            }
        }
    }
    return layout;
}

/// Advance animation slot `k` for one frame, in two passes so a later animation's end cannot overwrite an earlier one that still
/// runs: pass 0 puts back the computed values of a slot that finished without fill; pass 1 writes the running slots in list
/// order (a later one wins a property they share) and settles the slot's state. Returns `STEP_*` bits.
pub fn stepSlot(m: &Motion, css: &Css, tst: int, k: int, now: f32, extraDelay: f32, pass: int, vars: bool): int {
    if m.kf[k] < 0 || m.kf[k] >= css.kfs.len || css.kfs.items[m.kf[k]].name != m.kname[k] {
        m.kf[k] = css.findKf(m.kname[k]);
        if m.kf[k] < 0 {
            return 0;
        }
    }
    let kf = &css.kfs.items[m.kf[k]];
    let ph = anim.phase(
        now - m.kt0[k], animAt(css, tst, P_ANIM_DELAY, k).f + extraDelay, animAt(css, tst, P_ANIM_DUR, k).f,
        animAt(css, tst, P_ANIM_ITER, k).f, animAt(css, tst, P_ANIM_DIR, k).i, animAt(css, tst, P_ANIM_FILL, k).i,
    );
    let ez = animAt(css, tst, P_ANIM_EASE, k).i;
    let r = 0;
    if pass == 0 {
        if !ph.on && (ph.done || m.kheld[k]) {
            // finished without fill: back to the computed values
            if applyFrames(m, css, kf, -1.0, tst, ez, vars) {
                r = STEP_LAYOUT;
            }
        }
        return r;
    }
    if ph.on {
        if applyFrames(m, css, kf, ph.t, tst, ez, vars) {
            r = STEP_LAYOUT;
        }
    }
    if vars {
        // the custom properties are sampled first (`motion.step`); the state below settles in the second run
        return r;
    }
    if ph.done {
        m.kfin[k] = true;
        if !ph.on {
            m.kf[k] = -1;
        } else {
            m.kheld[k] = true;
        }
        return r;
    }
    return r + STEP_LIVE;
}

