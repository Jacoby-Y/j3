/// The one open popup (a dropdown list or a color panel): its state and where it goes. `j3.ui.dom` only needs the
/// color panel's rectangle (presses inside it do not reach the page); `j3.ui.dropdown` fills it in and draws it. This is the "draw last" layer that
/// modals, tooltips and drawers can grow from. No GL.

module j3.ui.popup;

use j3.math.{ max, min };
use j3.ui.colorpick.Hsv;

/// Which kind of popup is open.
pub const NONE: int = 0;
pub const SELECT: int = 1;
pub const COLOR: int = 2;

/// State of the open popup (`kind == NONE` when closed). For a color panel `x y w h` is the rectangle of the last
/// draw in root px and `drag` is 0 none, 1 square, 2 hue bar, `hsv` the working color. A select list is a DOM
/// subtree (`j3.ui.popnode`, `Dom.ptRoot`) and leaves `x y w h` at 0: `hot` is the highlighted option, `rh` the
/// row pitch measured from the layout (26 until then), `oy` the offset of row 0 in the list's scroll content,
/// `kb` whether the keyboard (not the pointer) chose `hot`, `pend` that the selected row is still to be scrolled in.
pub struct Popup {
    kind: int;
    owner: int;
    x: f32;
    y: f32;
    w: f32;
    h: f32;
    hot: int;
    drag: int;
    hsv: Hsv;
    rh: f32;
    oy: f32;
    kb: bool;
    pend: bool;
}

pub fn closed(): Popup {
    return Popup { kind: NONE, owner: -1, x: 0.0, y: 0.0, w: 0.0, h: 0.0, hot: -1, drag: 0, hsv: Hsv { h: 0.0, s: 0.0, v: 0.0 }, rh: 26.0, oy: 4.0, kb: true, pend: false };
}

/// Whether the root-px point is over the popup.
pub fn inside(p: &Popup, x: f32, y: f32): bool {
    return p.kind != NONE && x >= p.x && y >= p.y && x < p.x + p.w && y < p.y + p.h;
}

/// A rectangle.
pub struct Rect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

/// Where a `w` x `h` popup goes for an owner box at `ox, oy` (size `ow, oh`) in a `vw` x `vh` window:
/// below the owner, else above it when there is more room there, else squeezed to the larger side
/// (the height may shrink, down to `minH`). Kept inside the window horizontally.
pub fn place(ox: f32, oy: f32, ow: f32, oh: f32, w: f32, h: f32, minH: f32, vw: f32, vh: f32): Rect {
    let below = vh - (oy + oh) - 4.0;
    let above = oy - 4.0;
    let r = Rect { x: ox, y: oy + oh + 2.0, w: w, h: h };
    if h > below {
        if above > below {
            r.h = min(h, above);
            r.y = oy - 2.0 - r.h;
        } else {
            r.h = max(min(h, below), min(h, minH));
        }
    }
    if r.x + r.w > vw {
        r.x = vw - r.w;
    }
    if r.x < 0.0 {
        r.x = 0.0;
    }
    return r;
}
