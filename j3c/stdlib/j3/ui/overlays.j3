/// The overlay stack: `<dialog modal>`, `popover` boxes, and `title` tooltips. `j3.ui.dom` keeps the
/// stack (`Dom.ovs`, bottom to top, in open order), their paint layers (`z-index` 1000 up, one per
/// depth), the modal's input block and the `left`/`top`/`position-try-fallbacks` placement; this module
/// is the behaviour the generated root runs once per frame from `j3.ui.inputs.begin`:
///
/// - Escape asks the topmost overlay to close (`on:close`), and no other layer sees that key.
/// - A press (either button) outside an overlay asks it to close when its `closedby` is `any` (popovers
///   by default); the layers under it are asked too, down to the first one the press is inside, and a
///   modal ends the walk. A press on a button next to the popover (inside its parent) is the
///   trigger's: it does not dismiss, so a toggle button works.
/// - A modal takes focus when it opens (the first button, input or select inside), Tab stays inside
///   it, and focus goes back to what had it when the modal goes away (`Dom.dropOverlay`).
/// - A `title` shows as a tooltip (`.j3-tooltip`) after the mouse rests `--j3-tooltip-delay` (500 ms) on its element (or a descendant of it).
///
/// The overlay itself is an ordinary element: style it with CSS, animate it with `transition` and
/// `@keyframes`, fade it out with `transition:fade`. The app owns the open state: render the element
/// while it is open and clear the flag in `on:close`.

module j3.ui.overlays;

use j3.gfx.paint;
use j3.math.{ max, min };
use j3.ui.dom;
use j3.ui.dom.{ Dom, inside, isFocusable };
use j3.ui.popnode;
use j3.ui.dropdown;
use j3.ui.uastyle;

/// The fade-in of a tooltip in ms; the wait before it is `--j3-tooltip-delay` (`uastyle.tipDelay`).
const TIP_FADE: f32 = 120.0;

fn alive(d: &Dom, id: int): bool {
    return id >= 0 && id < d.nodes.len && d.nodes.items[id].kind == dom.K_ELEM && !d.nodes.items[id].ghost;
}

/// Whether the overlay at `id` lets a press outside close it: `closedby` any (popover default) or not.
fn dismissesOnPress(d: &Dom, id: int): bool {
    let by = d.nodes.items[id].ovBy;
    if by == 0 {
        return d.nodes.items[id].ov == dom.OV_POPOVER;
    }
    return by == 1;
}

fn mayClose(d: &Dom, id: int): bool {
    return d.nodes.items[id].ovBy != 3;
}

/// The first focusable element at or below `id` in document order (-1 for none).
fn firstFocusable(d: &Dom, id: int): int {
    if isFocusable(d, id) {
        return id;
    }
    let c = d.nodes.items[id].first;
    while c >= 0 {
        if d.nodes.items[c].kind == dom.K_ELEM {
            let r = firstFocusable(d, c);
            if r >= 0 {
                return r;
            }
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

/// The first enabled text box or textarea at or below `id` (-1 for none).
fn firstField(d: &Dom, id: int): int {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let nd = &d.nodes.items[c];
        if nd.kind == dom.K_ELEM && !nd.ghost && nd.disp != dom.DP_NONE {
            if dom.isField(d, c) && isFocusable(d, c) {
                return c;
            }
            let r = firstField(d, c);
            if r >= 0 {
                return r;
            }
        }
        c = nd.next;
    }
    return -1;
}

/// Enter in a text box of an open modal that does not handle `on:submit`: click the dialog's default button, the first
/// `<button default>`, else the first `button.primary`, through the same path as Enter on a focused button. A disabled
/// one does nothing.
pub fn defaultClick(d: &Dom, f: int) {
    let m = f;
    while m >= 0 && d.nodes.items[m].ov != dom.OV_MODAL {
        m = d.nodes.items[m].parent;
    }
    if m < 0 {
        return;
    }
    let b = findButton(d, m, true);
    if b < 0 {
        b = findButton(d, m, false);
    }
    if b >= 0 && !dom.isDisabled(d, b) {
        d.clickNode = b;
    }
}

fn findButton(d: &Dom, id: int, byAttr: bool): int {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let nd = &d.nodes.items[c];
        if nd.kind == dom.K_ELEM && !nd.ghost && nd.disp != dom.DP_NONE {
            if dom.paintVisible(d, c) && nd.tag == d.tButton && (if byAttr { nd.fDef } else { hasClass(d, c, "primary") }) {
                return c;
            }
            // a nested popover or dialog is another layer, not this dialog's default
            let r = if nd.ov == 0 { findButton(d, c, byAttr) } else { -1 };
            if r >= 0 {
                return r;
            }
        }
        c = nd.next;
    }
    return -1;
}

/// The nearest focusable element at or above `id`.
fn focusAbove(d: &Dom, id: int): int {
    let c = id;
    while c >= 0 {
        if isFocusable(d, c) {
            return c;
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// A press on a control that sits beside the popover (in its parent) belongs to that control.
fn isTriggerPress(d: &Dom, ov: int, raw: int): bool {
    let f = focusAbove(d, raw);
    let par = d.nodes.items[ov].parent;
    return f >= 0 && par > 0 && inside(d, par, f) && !inside(d, ov, f);
}

/// Run once per frame after `Dom.beginFrame`, before the page reads input. `popWas`: a select or color
/// popup was open at the start of the frame (it owns Escape and the outside press).
pub fn input(d: &Dom, popWas: bool) {
    let n = d.ovs.len;
    if n > 0 {
        enter(d);
    }
    if n == 0 {
        if d.ptRoot < 0 {
            d.kbHover = -1;
        }
        d.kbPend = -1;
    }
    if n > 0 && !popWas {
        let top = d.ovs.items[n - 1].v;
        if alive(d, top) && d.nodes.items[top].ov == dom.OV_POPOVER {
            menuKeys(d, top);
        }
        if d.kin.esc && alive(d, top) {
            if d.nodes.items[top].ovCaret {
                // Escape dismisses the completion for this trigger and ends it; the box keeps its text
                d.trigSup = d.trigLo;
                d.trigSupNode = d.trigNode;
                if d.trigNode >= 0 {
                    d.trigEv = d.trigNode;
                    d.trigChg = d.frame;
                    d.trigNode = -1;
                }
            }
            if mayClose(d, top) {
                d.nodes.items[top].closeAt = d.frame;
            }
            d.kin.esc = false;
        }
        let pressed = (d.down && !d.prevDown) || (d.rdown && !d.prevR);
        if pressed {
            dismissOutside(d);
        }
    }
    tipInput(d);
}

/// Give a new modal its focus.
fn enter(d: &Dom) {
    for i in 0..d.ovs.len {
        let id = d.ovs.items[i].v;
        let nd = &d.nodes.items[id];
        if !nd.ovInit && alive(d, id) {
            nd.ovInit = true;
            if nd.ov == dom.OV_MODAL || nd.ovContext {
                // no control inside: the page behind loses the keyboard anyway
                d.focusNode(firstFocusable(d, id));
                if nd.fAuto {
                    // `autoselect`: the first text box (not just the first control) gets focus, selected when `inputs.seeFocus` loads it
                    let t = firstField(d, id);
                    if t >= 0 {
                        d.focusNode(t);
                        d.nodes.items[t].fSel = true;
                    }
                }
            }
        }
    }
}

fn dismissOutside(d: &Dom) {
    let raw = d.rawHit;
    let i = d.ovs.len - 1;
    while i >= 0 {
        let id = d.ovs.items[i].v;
        if alive(d, id) {
            if raw >= 0 && inside(d, id, raw) {
                return;
            }
            if d.nodes.items[id].ovContext && d.contextAt(d.nodes.items[id].parent) { return; }
            if dismissesOnPress(d, id) && !isTriggerPress(d, id, raw) {
                d.nodes.items[id].closeAt = d.frame;
            }
            if d.nodes.items[id].ov == dom.OV_MODAL {
                return;
            }
        }
        i -= 1;
    }
}

// ---- menu keys ---------------------------------------------------------------------------------------

/// One pass over a menu level's entries in document order: where `f` is, its neighbours, the ends.
struct Scan {
    f: int;
    found: bool;
    prev: int;
    next: int;
    first: int;
    last: int;
}

fn hasClass(d: &Dom, id: int, name: string): bool {
    let c = d.css.intern(name);
    let cl = d.mnodes.items[id].classes;
    for i in 0..cl.len {
        if cl[i] == c {
            return true;
        }
    }
    return false;
}

/// The entries of the level rooted at `level` (the popover, or a `.sub`): focusable descendants, not those
/// inside a nested `.sub` (the next level down).
fn visit(d: &Dom, id: int, level: int, sc: &Scan) {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let nd = &d.nodes.items[c];
        if nd.kind == dom.K_ELEM && !nd.ghost && nd.disp != dom.DP_NONE {
            if isFocusable(d, c) {
                if sc.first < 0 {
                    sc.first = c;
                }
                sc.last = c;
                if c == sc.f {
                    sc.found = true;
                } else if !sc.found {
                    sc.prev = c;
                } else if sc.next < 0 {
                    sc.next = c;
                }
            }
            if !hasClass(d, c, "sub") {
                visit(d, c, level, sc);
            }
        }
        c = nd.next;
    }
}

fn scan(d: &Dom, level: int, f: int): Scan {
    let sc = Scan { f: f, found: false, prev: -1, next: -1, first: -1, last: -1 };
    visit(d, level, level, &sc);
    return sc;
}

struct TypeScan { f: int; passed: bool; first: int; after: int; current: int; }

// Match a visible text descendant (or explicit aria-label), without allocating joined label strings.
fn matches(d: &Dom, id: int): bool {
    if d.nodes.items[id].ariaLen > 0 { return dropdown.startsWith(d.ariaOf(id), d.ta[0..d.taLen]); }
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.kind == dom.K_TEXT && d.textOf(c).len > 0 { return dropdown.startsWith(d.textOf(c), d.ta[0..d.taLen]); }
        if n.kind == dom.K_ELEM && !n.ghost && n.disp != dom.DP_NONE && !hasClass(d, c, "sub") && matches(d, c) { return true; }
        c = n.next;
    }
    return false;
}

fn typeVisit(d: &Dom, id: int, sc: &TypeScan) {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.kind == dom.K_ELEM && !n.ghost && n.disp != dom.DP_NONE {
            if isFocusable(d, c) {
                if matches(d, c) {
                    if sc.first < 0 { sc.first = c; }
                    if sc.passed && sc.after < 0 { sc.after = c; }
                    if c == sc.f { sc.current = c; }
                }
                if c == sc.f { sc.passed = true; }
            }
            if !hasClass(d, c, "sub") { typeVisit(d, c, sc); }
        }
        c = n.next;
    }
}

/// Focus `id`; hover follows its parent chain, so the submenus above it stay open and its own is closed.
fn goTo(d: &Dom, id: int) {
    d.focusNode(id);
    d.kbHover = d.nodes.items[id].parent;
    dom.setHover(d, d.kbHover, false);
}

/// The level `f` is in: the nearest ancestor that is `top` or a `.sub`.
fn levelOf(d: &Dom, top: int, f: int): int {
    let c = d.nodes.items[f].parent;
    while c >= 0 && c != top && !hasClass(d, c, "sub") {
        c = d.nodes.items[c].parent;
    }
    return c;
}

/// The entry that owns submenu `level`: the nearest focusable above it.
fn hostOf(d: &Dom, level: int): int {
    return focusAbove(d, d.nodes.items[level].parent);
}

/// Arrow keys in the topmost popover. Up/Down/Home/End move between entries (wrapping), Right opens the
/// `.sub` of the focused entry and enters it, Left and Escape leave a submenu one level, Enter and Space
/// click the entry (`inputs.begin`). With focus on the trigger (beside the popover) Down / Up enter the menu.
fn menuKeys(d: &Dom, top: int) {
    if d.kbPend >= 0 {
        let first = firstFocusable(d, d.kbPend);
        if first >= 0 {
            d.kbPend = -1;
            goTo(d, first);
        } else {
            d.kbWait += 1;
            if d.kbWait > 3 {
                d.kbPend = -1;
            }
        }
    }
    let k = &d.kin;
    let f = d.focus;
    if k.comp.len > 0 { return; }
    if f >= d.nodes.len || (f >= 0 && d.nodes.items[f].kind != dom.K_ELEM) {
        return;
    }
    // Controls beside the menu retain input too; a shared wrapper is not necessarily its trigger.
    if f >= 0 && (dom.isField(d, f) || d.mnodes.items[f].type == d.vRange || d.nodes.items[f].tag == d.tSelect) { return; }
    if f < 0 || !inside(d, top, f) {
        let par = d.nodes.items[top].parent;
        let onTrigger = f < 0 || (par > 0 && inside(d, par, f) && !dom.isField(d, f));
        if onTrigger && dropdown.prefix(d, top) {
            let triggerScan = TypeScan { f: -1, passed: false, first: -1, after: -1, current: -1 };
            typeVisit(d, top, &triggerScan);
            if triggerScan.first >= 0 { goTo(d, triggerScan.first); }
        } else if onTrigger && (k.down || k.up) {
            let ent = scan(d, top, -1);
            let at = if k.down { ent.first } else { ent.last };
            if at >= 0 {
                goTo(d, at);
                k.down = false;
                k.up = false;
            }
        }
        return;
    }
    let level = levelOf(d, top, f);
    if level < 0 {
        return;
    }
    if d.taOwner != level { d.taLen = 0; d.taOwner = level; }
    let sc = scan(d, level, f);
    if !sc.found {
        return;
    }
    if dropdown.prefix(d, level) {
        let ts = TypeScan { f: f, passed: false, first: -1, after: -1, current: -1 };
        typeVisit(d, level, &ts);
        let typedTo = if !d.taCycle && ts.current >= 0 { ts.current } else { if ts.after >= 0 { ts.after } else { ts.first } };
        if typedTo >= 0 { goTo(d, typedTo); }
    } else if k.down || k.up || k.home || k.end {
        let to = sc.first;
        if k.down {
            to = if sc.next >= 0 { sc.next } else { sc.first };
        } else if k.up {
            to = if sc.prev >= 0 { sc.prev } else { sc.last };
        } else if k.end {
            to = sc.last;
        }
        goTo(d, to);
    } else if k.right {
        let sub = dom.subOf(d, f);
        if sub >= 0 {
            // CSS shows the submenu while its host is hovered; focus moves in once it has been laid out
            d.kbHover = f;
            dom.setHover(d, f, false);
            d.kbPend = sub;
            d.kbWait = 0;
        }
    } else if (k.left || k.esc) && level != top {
        let host = hostOf(d, level);
        if host >= 0 {
            goTo(d, host);
            k.esc = false;
        }
    }
}

// ---- caret popup keys --------------------------------------------------------------------------------

/// The open caret popup (`popover="caret"`) that belongs to text box `f` (its wrapper holds `f`), -1 for none.
fn caretPop(d: &Dom, f: int): int {
    for i in 0..d.ovs.len {
        let id = d.ovs.items[i].v;
        if alive(d, id) && d.nodes.items[id].ovCaret && inside(d, d.nodes.items[id].parent, f) {
            return id;
        }
    }
    return -1;
}

/// Keys for the focused text box `f` while its caret popup is open, before the box reads them: Up and Down move the
/// active entry (wrapping; the caret stays), Enter and Tab click it. The mouse hovering an entry makes it active.
/// Everything else (typing, Left, Right, Backspace) still reaches the box.
pub fn caretKeys(d: &Dom, f: int) {
    let pop = caretPop(d, f);
    if pop < 0 {
        d.cpHot = -1;
        return;
    }
    let k = &d.kin;
    let sc = scan(d, pop, d.cpHot);
    if d.moved && d.hover >= 0 {
        let h = focusAbove(d, d.hover);
        if h >= 0 && inside(d, pop, h) {
            sc = scan(d, pop, h);
        }
    }
    if sc.first < 0 {
        d.cpHot = -1;
        return;
    }
    let hot = sc.f;
    if !sc.found {
        hot = sc.first;
    } else if k.comp.len == 0 {
        if k.down {
            hot = if sc.next >= 0 { sc.next } else { sc.first };
        } else if k.up {
            hot = if sc.prev >= 0 { sc.prev } else { sc.last };
        }
    }
    if k.comp.len == 0 {
        if k.down || k.up {
            k.down = false;
            k.up = false;
        }
        if k.enter || k.tab {
            d.clickNode = hot;
            k.enter = false;
            k.tab = false;
        }
    }
    d.cpHot = hot;
    d.kbHover = hot;
    dom.setHover(d, hot, false);
}

// ---- tooltips ----------------------------------------------------------------------------------------

/// The nearest element at or above `id` with a `title` (-1 for none).
fn titled(d: &Dom, id: int): int {
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].hcOpen { return -1; }
        if d.nodes.items[c].tipLen > 0 {
            return c;
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

fn tipInput(d: &Dom) {
    // Keyboard select/menu highlighting may own `hover`; titles follow the actual pointer.
    let t = if d.rawHit >= 0 && dom.allowedByModal(d, d.rawHit) { titled(d, d.rawHit) } else { -1 };
    if d.down || d.rdown {
        t = -1;
    }
    if t != d.tipNode {
        d.tipNode = t;
        d.tipT0 = d.now;
    } else if d.moved && d.now - d.tipT0 < uastyle.tipDelay(d.css) {
        // moving restarts the wait
        d.tipT0 = d.now;
    }
    if tipAlpha(d) <= 0.0 {
        d.dropTip();
        return;
    }
    let root = d.tipRoot(t, d.tag("j3-tip"));
    d.cls(root, "j3-tooltip");
    popnode.build(d, root);
    d.text(d.tipOf(t));
    popnode.done(d);
}

/// Whether the tooltip of `tipNode` is showing, and how opaque (0..1).
pub fn tipAlpha(d: &Dom): f32 {
    if d.tipNode < 0 || !alive(d, d.tipNode) || !dom.paintVisible(d, d.tipNode) {
        return 0.0;
    }
    let u = (d.now - d.tipT0 - uastyle.tipDelay(d.css)) / TIP_FADE;
    return max(0.0, min(1.0, u));
}

/// Position the passive title box after layout. Its own text fragments wrap naturally.
pub fn settleTip(d: &Dom) {
    if d.ttRoot < 0 { return; }
    let n = &d.nodes.items[d.ttRoot];
    n.x = max(4.0, min(d.mx + 12.0, d.vw - n.w - 4.0));
    let y = d.my + 20.0;
    if y + n.h > d.vh { y = d.my - n.h - 8.0; }
    n.y = max(4.0, y);
}

/// Draw the real tooltip subtree above the page and input popups, preserving the 120ms fade.
pub fn paintTip(d: &Dom) {
    let a = tipAlpha(d);
    if a <= 0.0 || d.ttRoot < 0 { return; }
    settleTip(d);
    paint.pushAlpha(a);
    popnode.paint(d, d.ttRoot);
    paint.popAlpha();
}
