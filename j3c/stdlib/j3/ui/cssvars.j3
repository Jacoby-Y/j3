/// Custom property sets rebuilt under overridden values, for `@property` animation (`j3.ui.motionvar`): rebuilding a computed
/// style from its recorded rules (`rebuildReaders`), which declarations read which property (`readsMask`), the scratch set an
/// animation keeps its overrides in (`scratchSet`), and custom properties derived from an overridden one (`rederive`).

module j3.ui.cssvars;

use j3.text.same;
use j3.ui.css.{ coerceSyn, Css, Custom, NPROPS, P_DEFER, P_FONT_SIZE, V_UNSET, V_VAR, Value };
use j3.ui.cssmatch.{ cascade, isNameChar, resolveVar };

/// Recompute the values of computed style `tst` as if its custom properties were set `vs` into `css.out`; `css.omask[p]` says which
/// came from a `var()` reader. False when the style has no known rules. Parses nothing but the deferred values (`applyDeferred`).
pub fn rebuildReaders(css: &Css, tst: int, vs: int): bool {
    if tst < 0 || tst >= css.sro.len || css.sro.items[tst] < 0 {
        return false;
    }
    cascade(css, css.srl.items, css.sro.items[tst], css.srn.items[tst], css.spar.items[tst], vs, true);
    return true;
}

fn bitOf(name: int): int {
    let b = 1;
    for k in 0..name % 30 {
        b *= 2;
    }
    return b;
}

fn addBit(mask: int, name: int): int {
    if maskHas(mask, name) {
        return mask;
    }
    return mask + bitOf(name);
}

/// A bit mask (bit `name mod 30`) of the custom properties the rules of `style` read with `var()` in a declaration; cached per style.
pub fn readsMask(css: &Css, style: int): int {
    while css.sdep.len <= style {
        css.sdep.push(-1);
    }
    if css.sdep.items[style] >= 0 {
        return css.sdep.items[style];
    }
    let mask = 0;
    if style < css.sro.len && css.sro.items[style] >= 0 {
        for m in 0..css.srn.items[style] {
            let r = css.rules.items[css.srl.items[css.sro.items[style] + m]];
            for d in 0..r.ndecl {
                let dc = css.decls.items[r.decl0 + d];
                if dc.prop >= 0 && dc.prop < NPROPS && dc.v.kind == V_VAR {
                    mask = addBit(mask, dc.v.i);
                } else if dc.prop == P_DEFER {
                    mask = textReads(css, css.dtpl.items[dc.v.i].text, mask);
                }
            }
        }
    }
    css.sdep.items[style] = mask;
    return mask;
}

/// Does mask `mask` (`readsMask`) possibly include custom property `name`?
pub fn maskHas(mask: int, name: int): bool {
    return (mask / bitOf(name)) % 2 == 1;
}

/// `mask` plus the bits of the names `var(--x` in `src`.
fn textReads(css: &Css, src: string, mask: int): int {
    let i = 0;
    while i + 4 < src.len {
        if int(src[i]) == 118 && same(src[i..i + 4], "var(") && (i == 0 || !isNameChar(int(src[i - 1]))) {
            let j = i + 4;
            while j < src.len && int(src[j]) == 32 {
                j += 1;
            }
            let ns = j;
            while j < src.len && isNameChar(int(src[j])) {
                j += 1;
            }
            if j - ns > 2 {
                mask = addBit(mask, css.intern(src[ns..j]));
            }
            i = j;
        } else {
            i += 1;
        }
    }
    return mask;
}

/// A custom property set made of `vs` with `n` values replaced or added (`names[i]` gets `vals[i]`), kept in the scratch set `cur`
/// (-1: make one with room for `cap` entries, at least `vsn[vs] + n`) so an animation reuses the same entries every frame.
/// Nothing else refers to the set: it is only passed to `rebuildReaders`.
pub fn scratchSet(css: &Css, vs: int, cur: int, cap: int, names: []int, vals: []Value, n: int): int {
    if cur < 0 {
        cur = css.vso.len;
        css.vso.push(css.vsEnt.len);
        css.vsn.push(0);
        for k in 0..cap {
            css.vsEnt.push(Custom { name: 0, v: Value { kind: V_UNSET, f: 0.0, i: 0, c: 0 } });
        }
    }
    let o = css.vso.items[cur];
    let c = css.vsn.items[vs];
    for i in 0..c {
        css.vsEnt.items[o + i] = css.vsEnt.items[css.vso.items[vs] + i];
    }
    for k in 0..n {
        let at = -1;
        for i in 0..c {
            if css.vsEnt.items[o + i].name == names[k] {
                at = i;
            }
        }
        if at < 0 {
            at = c;
            c += 1;
            css.vsEnt.items[o + at].name = names[k];
        }
        css.vsEnt.items[o + at].v = vals[k];
    }
    css.vsn.items[cur] = c;
    return cur;
}


/// The custom properties `tst`'s own rules declare as a whole `var()` (`--b: var(--a)`), evaluated again in scratch set `vs`
/// after some of its values were overridden (`names[0..n]` are those, left alone). A changed entry is written into `vs` and
/// appended to `names` / `vals` (up to `cap`), so what reads `--b` follows `--a`; several passes settle chains. Returns the new count.
/// Only the node's own declarations: a derived property declared on an ancestor keeps the value it had.
pub fn rederive(css: &Css, tst: int, vs: int, names: []int, vals: []Value, n: int, cap: int): int {
    if tst < 0 || tst >= css.sro.len || css.sro.items[tst] < 0 {
        return n;
    }
    let n0 = n;
    let fs = css.get(tst, P_FONT_SIZE).f;
    let o = css.vso.items[vs];
    for pass in 0..4 {
        let changed = false;
        for m in 0..css.srn.items[tst] {
            let r = css.rules.items[css.srl.items[css.sro.items[tst] + m]];
            for d in 0..r.ndecl {
                let dc = css.decls.items[r.decl0 + d];
                if dc.prop < NPROPS || dc.v.kind != V_VAR {
                    continue;
                }
                let name = dc.prop - NPROPS;
                let skip = false;
                for q in 0..n0 {
                    if names[q] == name {
                        skip = true;
                    }
                }
                if skip {
                    continue;
                }
                let v = resolveVar(css, -1, vs, 0, dc.v);
                let rg = css.regOf(name);
                if rg >= 0 {
                    v = coerceSyn(css, css.regs.items[rg].syn, v, fs);
                }
                if v.kind == V_UNSET || v.kind == V_VAR {
                    continue;
                }
                for i in 0..css.vsn.items[vs] {
                    let e = &css.vsEnt.items[o + i];
                    if e.name == name && (e.v.kind != v.kind || e.v.f != v.f || e.v.i != v.i || e.v.c != v.c) {
                        e.v = v;
                        changed = true;
                        let at = -1;
                        for q in n0..n {
                            if names[q] == name {
                                at = q;
                            }
                        }
                        if at >= 0 {
                            vals[at] = v;
                        } else if n < cap {
                            names[n] = name;
                            vals[n] = v;
                            n += 1;
                        }
                    }
                }
            }
        }
        if !changed {
            break;
        }
    }
    return n;
}
