/// Inline spans of a `rich` textarea: the `Span` type, its kinds, and the pure functions that keep a span list right
/// while the text is edited (`spanEdit`) or styled (`covered`, `uncover`). `j3.ui.textedit.Edit` owns the list.

module j3.ui.spans;

use j3.memory.List;

/// Span kinds. Bold and italic style the covered text; a link styles it and carries its URL in `data`.
/// A mention and a custom emoji are atomic tokens (`isToken`): the covered text is their label, drawn as one chip.
pub const SPAN_BOLD: int = 1;
pub const SPAN_ITALIC: int = 2;
pub const SPAN_LINK: int = 3;
pub const SPAN_MENTION: int = 4;
pub const SPAN_EMOJI: int = 5;

/// A styled run of a `rich` textarea: `len` bytes of its UTF-8 text from byte `start`. `data` is the mention id,
/// emoji name or link URL (empty for bold and italic). Spans may overlap each other, never a token.
pub struct Span {
    start: int;
    len: int;
    kind: int;
    data: string;
}

/// Whether spans of `kind` are atomic: the caret skips them, one delete removes them, a selection covers them whole.
pub fn isToken(kind: int): bool {
    return kind >= SPAN_MENTION;
}

fn cut(p: int, at: int, del: int): int {
    if p <= at {
        return p;
    }
    return if p >= at + del { p - del } else { at };
}

/// Keep `l` right after the text changed: `del` bytes at `at` were removed, then `ins` bytes were inserted at `at`.
/// A span after the edit shifts; one it touches is trimmed; a token it touches is dropped; an emptied span goes.
/// An insert inside a bold, italic or link span grows it. With `inherit`, typing at the very end of a bold or
/// italic span grows it too (a link and a token never extend).
pub fn spanEdit(l: &List<Span>, at: int, del: int, ins: int, inherit: bool) {
    let w = 0;
    for i in 0..l.len {
        let sp = l.items[i];
        let s = sp.start;
        let e = sp.start + sp.len;
        let tok = isToken(sp.kind);
        if del > 0 && tok && s < at + del && e > at {
            continue;
        }
        s = cut(s, at, del);
        e = cut(e, at, del);
        if e <= s {
            continue;
        }
        if ins > 0 {
            if s >= at {
                s += ins;
                e += ins;
            } else if e > at {
                if !tok {
                    e += ins;
                }
            } else if e == at && inherit && (sp.kind == SPAN_BOLD || sp.kind == SPAN_ITALIC) {
                e += ins;
            }
        }
        sp.start = s;
        sp.len = e - s;
        l.items[w] = sp;
        w += 1;
    }
    l.len = w;
}

    /// Whether every byte of `lo..hi` has a span of `kind`.
    pub fn covered(l: &List<Span>, kind: int, lo: int, hi: int): bool {
        let p = lo;
        let go = true;
        while go && p < hi {
            go = false;
            for i in 0..l.len {
                let s = l.items[i];
                if s.kind == kind && s.start <= p && p < s.start + s.len {
                    p = s.start + s.len;
                    go = true;
                }
            }
        }
        return p >= hi;
    }

    /// Take `kind` off `lo..hi` (a span across an edge is trimmed, one across the whole range is split).
    pub fn uncover(l: &List<Span>, kind: int, lo: int, hi: int) {
        let n = l.len;
        for i in 0..n {
            let s = l.items[i];
            if s.kind == kind && s.start < hi && s.start + s.len > lo {
                let e = s.start + s.len;
                if e > hi {
                    l.push(Span { start: hi, len: e - hi, kind: kind, data: s.data });
                }
                l.items[i].len = if s.start < lo { lo - s.start } else { 0 };
            }
        }
        let w = 0;
        for i in 0..l.len {
            if l.items[i].len > 0 {
                l.items[w] = l.items[i];
                w += 1;
            }
        }
        l.len = w;
    }
