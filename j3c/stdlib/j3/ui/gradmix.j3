/// Blending two gradient lists (`V_GRAD` values in `Css.paints`) for `transition` and `@keyframes`.
/// Pure functions of float offsets into one `[]f32` (no Css, no Dom), so tests drive them directly and
/// a frame blends in place with no allocation or parsing: the caller owns the output region.
///
/// List layout: `[nlayers, layers...]`, each layer `[type, angle, nstops, stops...]`, a stop `at r g b a`.
///
/// The rule (CSS leaves gradients discrete, so this is a J3 extension): two lists blend when they have
/// the same number of layers of the same types (`compatible`). Per layer the angle (the linear angle or
/// the conic start), each stop position and each stop color blend; colors blend premultiplied like CSS
/// colors. With different stop counts the shorter list is padded with copies of its last stop up to the
/// longer one, so new stops grow out of the end. Anything else is not blendable and flips halfway.
///
/// ```
/// if gradmix.compatible(a, ao, a, bo) {
///     let n = gradmix.mix(a, ao, bo, 0.5, oo);     // writes the blend at a[oo..oo+n]
/// }
/// ```

module j3.ui.gradmix;

use j3.ui.anim;

/// Floats of the list at `a[o]`.
pub fn size(a: []f32, o: int): int {
    let q = o + 1;
    for i in 0..int(a[o]) {
        q += 3 + 5 * int(a[q + 2]);
    }
    return q - o;
}

/// True when lists `ao` and `bo` have the same layer count and layer types.
pub fn compatible(a: []f32, ao: int, bo: int): bool {
    let n = int(a[ao]);
    if n != int(a[bo]) {
        return false;
    }
    let qa = ao + 1;
    let qb = bo + 1;
    for i in 0..n {
        // a `url()` layer (type 9, `cssimage.LAYER_URL`) has nothing to blend: it jumps
        if a[qa] != a[qb] || a[qa] > 8.5 {
            return false;
        }
        qa += 3 + 5 * int(a[qa + 2]);
        qb += 3 + 5 * int(a[qb + 2]);
    }
    return true;
}

/// Floats `mix` writes for compatible lists `ao` and `bo`.
pub fn mixSize(a: []f32, ao: int, bo: int): int {
    let q = 1;
    let qa = ao + 1;
    let qb = bo + 1;
    for i in 0..int(a[ao]) {
        let na = int(a[qa + 2]);
        let nb = int(a[qb + 2]);
        q += 3 + 5 * (if na > nb { na } else { nb });
        qa += 3 + 5 * na;
        qb += 3 + 5 * nb;
    }
    return q;
}

fn pack(a: []f32, q: int): int {
    return int(a[q]) * 16777216 + int(a[q + 1]) * 65536 + int(a[q + 2]) * 256 + int(a[q + 3]);
}

/// Stop `i` of the layer whose stops start at `s` (`n` of them); past the end it is the last stop.
fn stopAt(s: int, n: int, i: int): int {
    if i >= n {
        i = n - 1;
    }
    return s + i * 5;
}

/// Write the blend of compatible lists `ao` and `bo` at progress `t` (it may leave 0..1: easing
/// overshoot) to `a[oo..]`; returns the floats written (`mixSize`). The output region must not overlap
/// either input.
pub fn mix(a: []f32, ao: int, bo: int, t: f32, oo: int): int {
    let n = int(a[ao]);
    a[oo] = f32(n);
    let qa = ao + 1;
    let qb = bo + 1;
    let q = oo + 1;
    for i in 0..n {
        let na = int(a[qa + 2]);
        let nb = int(a[qb + 2]);
        let ns = if na > nb { na } else { nb };
        a[q] = a[qa];
        a[q + 1] = anim.mix(a[qa + 1], a[qb + 1], t);
        a[q + 2] = f32(ns);
        let prev: f32 = -1000000.0;
        for s in 0..ns {
            let sa = stopAt(qa + 3, na, s);
            let sb = stopAt(qb + 3, nb, s);
            let at = anim.mix(a[sa], a[sb], t);
            if at < prev {
                at = prev;
            }
            prev = at;
            let c = anim.mixColor(pack(a, sa + 1), pack(a, sb + 1), t);
            let o = q + 3 + s * 5;
            a[o] = at;
            a[o + 1] = f32((c / 16777216) % 256);
            a[o + 2] = f32((c / 65536) % 256);
            a[o + 3] = f32((c / 256) % 256);
            a[o + 4] = f32(c % 256);
        }
        q += 3 + 5 * ns;
        qa += 3 + 5 * na;
        qb += 3 + 5 * nb;
    }
    return q - oo;
}
