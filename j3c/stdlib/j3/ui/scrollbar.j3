/// Scrollbars of an `overflow: auto | scroll` box: where the thumbs and tracks are, which one a point
/// hits, and how they are drawn. They overlay the box at its right and bottom edge and take no layout
/// space. Pure geometry plus `j3.gfx.paint` calls, no tree. `scrollbar-width: auto | thin | none` and
/// `scrollbar-color: thumb track` pick the look (`j3.ui.dom` reads them).

module j3.ui.scrollbar;

use j3.game.Color;
use j3.gfx.paint;
use j3.math.Vec2;
use j3.math.{ max, min };

pub const NONE: int = 0;
pub const Y_THUMB: int = 1;
pub const Y_TRACK: int = 2;
pub const X_THUMB: int = 3;
pub const X_TRACK: int = 4;

const MIN_THUMB: f32 = 24.0;
const INSET: f32 = 2.0;

/// One box's bars. `showX`/`showY` say a bar exists; `offX`/`maxX` and `contX` (content width) are
/// the scroll offset, its range and the scrollable width, likewise for y.
pub struct Bars {
    w: f32;
    h: f32;
    t: f32;
    showX: bool;
    showY: bool;
    offX: f32;
    maxX: f32;
    contX: f32;
    offY: f32;
    maxY: f32;
    contY: f32;
}

/// Thickness in px of `scrollbar-width` keyword `sbw` (0 auto, 1 thin, 2 none).
pub fn thickness(sbw: int): f32 {
    if sbw == 1 { return 6.0; }
    if sbw == 2 { return 0.0; }
    return 10.0;
}

/// A thumb: start offset and length along its track.
pub struct Thumb {
    pos: f32;
    len: f32;
}

/// Thumb for a track of `track` px, a view of `view` px over `content` px, scrolled to `off`.
pub fn thumb(track: f32, view: f32, content: f32, off: f32, maxOff: f32): Thumb {
    let len = track;
    if content > view && content > 0.0 {
        len = max(min(MIN_THUMB, track), track * view / content);
    }
    let pos: f32 = 0.0;
    if maxOff > 0.0 {
        pos = (track - len) * off / maxOff;
    }
    return Thumb { pos: pos, len: len };
}

/// The scroll offset that puts the thumb's start at `pos` (the inverse of `thumb`).
pub fn offsetFor(track: f32, view: f32, content: f32, maxOff: f32, pos: f32): f32 {
    let t = thumb(track, view, content, 0.0, maxOff);
    let free = track - t.len;
    if free <= 0.0 {
        return 0.0;
    }
    return max(0.0, min(maxOff, maxOff * pos / free));
}

/// Length of the y track: the box height less the insets, and less the corner when x shows too.
pub fn trackY(b: &Bars): f32 {
    let corner: f32 = 0.0;
    if b.showX {
        corner = b.t;
    }
    return max(0.0, b.h - 2.0 * INSET - corner);
}

pub fn trackX(b: &Bars): f32 {
    let corner: f32 = 0.0;
    if b.showY {
        corner = b.t;
    }
    return max(0.0, b.w - 2.0 * INSET - corner);
}

/// Which part of the bars the point `(px, py)` (box-local) is over.
pub fn hit(b: &Bars, px: f32, py: f32): int {
    if b.showY && px >= b.w - b.t - INSET && px < b.w {
        let ty = trackY(b);
        let thY = thumb(ty, b.h, b.contY, b.offY, b.maxY);
        let y = py - INSET;
        if y >= thY.pos && y < thY.pos + thY.len {
            return Y_THUMB;
        }
        if py >= 0.0 && y < ty {
            return Y_TRACK;
        }
    }
    if b.showX && py >= b.h - b.t - INSET && py < b.h {
        let tx = trackX(b);
        let thX = thumb(tx, b.w, b.contX, b.offX, b.maxX);
        let x = px - INSET;
        if x >= thX.pos && x < thX.pos + thX.len {
            return X_THUMB;
        }
        if px >= 0.0 && x < tx {
            return X_TRACK;
        }
    }
    return NONE;
}

fn lift(c: Color): Color {
    return Color { r: u8(min(255.0, f32(c.r) + (255.0 - f32(c.r)) * 0.3)), g: u8(min(255.0, f32(c.g) + (255.0 - f32(c.g)) * 0.3)), b: u8(min(255.0, f32(c.b) + (255.0 - f32(c.b)) * 0.3)), a: c.a };
}

/// Draw the bars in box-local coordinates. `hot` is the part under the mouse or being dragged.
pub fn draw(b: &Bars, thumbCol: Color, trackCol: Color, hot: int) {
    let r = b.t / 2.0;
    if b.showY {
        let ty = trackY(b);
        let x = b.w - b.t - INSET;
        paint.roundRect(Vec2 { x: x, y: INSET }, Vec2 { x: b.t, y: ty }, r, trackCol);
        let thY = thumb(ty, b.h, b.contY, b.offY, b.maxY);
        let c = if hot == Y_THUMB { lift(thumbCol) } else { thumbCol };
        paint.roundRect(Vec2 { x: x, y: INSET + thY.pos }, Vec2 { x: b.t, y: thY.len }, r, c);
    }
    if b.showX {
        let tx = trackX(b);
        let y = b.h - b.t - INSET;
        paint.roundRect(Vec2 { x: INSET, y: y }, Vec2 { x: tx, y: b.t }, r, trackCol);
        let thX = thumb(tx, b.w, b.contX, b.offX, b.maxX);
        let cx = if hot == X_THUMB { lift(thumbCol) } else { thumbCol };
        paint.roundRect(Vec2 { x: INSET + thX.pos, y: y }, Vec2 { x: thX.len, y: b.t }, r, cx);
    }
}
