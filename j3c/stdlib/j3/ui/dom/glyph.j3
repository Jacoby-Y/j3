// Part of j3.ui.dom (`<glyph>` input prompts: the label for an action on the device last used, the pad styles, the games' bindings.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

pub const GS_XBOX: int = 0;
pub const GS_PLAYSTATION: int = 1;
pub const GS_NINTENDO: int = 2;
pub const GS_GENERIC: int = 3;

/// A game's own binding of an action name ("" in `key` / `pad` keeps the built-in for that device).
pub struct GlyphBind {
    action: string;
    key: string;
    pad: string;
}

/// The built-in UI actions: what `j3.ui.padnav` does with the pad and the key that does the same.
/// confirm A / Enter, back B / Esc, prev LB / Shift+Tab, next RB / Tab, up|down|left|right D-pad / arrows, page-up|page-down LT, RT / PgUp, PgDn, scroll right stick / Wheel.
pub fn glyphKnown(a: string): bool {
    return glyphKey(a).len > 0;
}

fn glyphKey(a: string): string {
    if same(a, "confirm") { return "Enter"; }
    if same(a, "back") { return "Esc"; }
    if same(a, "prev") { return "Shift+Tab"; }
    if same(a, "next") { return "Tab"; }
    if same(a, "up") { return "Up"; }
    if same(a, "down") { return "Down"; }
    if same(a, "left") { return "Left"; }
    if same(a, "right") { return "Right"; }
    if same(a, "page-up") { return "PgUp"; }
    if same(a, "page-down") { return "PgDn"; }
    if same(a, "scroll") { return "Wheel"; }
    return "";
}

fn glyphPad(a: string): string {
    if same(a, "confirm") { return "a"; }
    if same(a, "back") { return "b"; }
    if same(a, "prev") { return "lb"; }
    if same(a, "next") { return "rb"; }
    if same(a, "page-up") { return "lt"; }
    if same(a, "page-down") { return "rt"; }
    if same(a, "scroll") { return "rs"; }
    if same(a, "up") || same(a, "down") || same(a, "left") || same(a, "right") { return a; }
    return "";
}

fn glyphCopy(d: &Dom, s: string): string {
    let t = Text.new(d.mem);
    t.pushStr(s);
    return t.str();
}

pub fn glyphSetStyle(d: &Dom, name: string) {
    if same(name, "xbox") { d.glyphStyle = GS_XBOX; }
    else if same(name, "playstation") { d.glyphStyle = GS_PLAYSTATION; }
    else if same(name, "nintendo") { d.glyphStyle = GS_NINTENDO; }
    else if same(name, "generic") { d.glyphStyle = GS_GENERIC; }
    else {
        d.glyphStyle = GS_XBOX;
        d.css.warns.push(Warning { file: "glyph:", line: 1, col: 1, msg: "setGlyphStyle: styles are xbox, playstation, nintendo, generic" });
    }
}

pub fn glyphBind(d: &Dom, action: string, key: string, pad: string) {
    for i in 0..d.gbinds.len {
        let b = &d.gbinds.items[i];
        if same(b.action, action) {
            // copies only what changed, so a rebinding screen that sets every action each frame allocates nothing
            if !same(b.key, key) { b.key = glyphCopy(d, key); }
            if !same(b.pad, pad) { b.pad = glyphCopy(d, pad); }
            return;
        }
    }
    d.gbinds.push(GlyphBind { action: glyphCopy(d, action), key: glyphCopy(d, key), pad: glyphCopy(d, pad) });
}

/// The code point of the PlayStation face-button symbol for pad button `b` (0 for a button with no symbol).
fn glyphSym(b: string): int {
    if same(b, "a") { return 10005; }
    if same(b, "b") { return 9675; }
    if same(b, "x") { return 9633; }
    if same(b, "y") { return 9651; }
    return 0;
}

/// The text of pad button `b` ("a", "b", "x", "y" are the bottom, right, left and top face buttons; also "lb" "rb" "lt" "rt" "up" "down" "left"
/// "right" "start" "select" "ls" "rs") in the pad style. `plain`: the font has no PlayStation symbols, so the face buttons are named.
pub fn glyphPadLabel(style: int, b: string, plain: bool): string {
    if style == GS_PLAYSTATION {
        if same(b, "a") { return if plain { "Cross" } else { "✕" }; }
        if same(b, "b") { return if plain { "Circle" } else { "○" }; }
        if same(b, "x") { return if plain { "Square" } else { "□" }; }
        if same(b, "y") { return if plain { "Triangle" } else { "△" }; }
        if same(b, "lb") { return "L1"; }
        if same(b, "rb") { return "R1"; }
        if same(b, "lt") { return "L2"; }
        if same(b, "rt") { return "R2"; }
        if same(b, "start") { return "Options"; }
        if same(b, "select") { return "Share"; }
        if same(b, "ls") { return "L3"; }
        if same(b, "rs") { return "R3"; }
    } else if style == GS_NINTENDO {
        if same(b, "a") { return "B"; }
        if same(b, "b") { return "A"; }
        if same(b, "x") { return "Y"; }
        if same(b, "y") { return "X"; }
        if same(b, "lb") { return "L"; }
        if same(b, "rb") { return "R"; }
        if same(b, "lt") { return "ZL"; }
        if same(b, "rt") { return "ZR"; }
        if same(b, "start") { return "+"; }
        if same(b, "select") { return "-"; }
    } else if style == GS_GENERIC {
        if same(b, "a") { return "South"; }
        if same(b, "b") { return "East"; }
        if same(b, "x") { return "West"; }
        if same(b, "y") { return "North"; }
        if same(b, "lb") { return "L1"; }
        if same(b, "rb") { return "R1"; }
        if same(b, "lt") { return "L2"; }
        if same(b, "rt") { return "R2"; }
        if same(b, "start") { return "Start"; }
        if same(b, "select") { return "Select"; }
        if same(b, "ls") { return "L3"; }
        if same(b, "rs") { return "R3"; }
    } else {
        if same(b, "a") { return "A"; }
        if same(b, "b") { return "B"; }
        if same(b, "x") { return "X"; }
        if same(b, "y") { return "Y"; }
        if same(b, "lb") { return "LB"; }
        if same(b, "rb") { return "RB"; }
        if same(b, "lt") { return "LT"; }
        if same(b, "rt") { return "RT"; }
        if same(b, "start") { return "Menu"; }
        if same(b, "select") { return "View"; }
    }
    if same(b, "up") { return "Up"; }
    if same(b, "down") { return "Down"; }
    if same(b, "left") { return "Left"; }
    if same(b, "right") { return "Right"; }
    if same(b, "ls") { return "LS"; }
    if same(b, "rs") { return "RS"; }
    return b;
}

/// Set up the `<glyph>` element `id` that was just opened: its device (`[type=pad]` or `[type=key]`, the pad when `padnav` saw the pad last and
/// the action has a pad button), its label as the one text child and its accessible name. Explicit `key` / `pad` win over a binding, a
/// binding over the built-ins. Every call compares first, so a steady frame allocates and restyles nothing; a device switch touches only the glyphs.
pub fn glyphBuild(d: &Dom, id: int, action: string, key: string, pad: string) {
    id = d.resolve(id);
    if id == STALE { return; }
    if action.len > 0 {
        let bk = "";
        let bp = "";
        for i in 0..d.gbinds.len {
            if same(d.gbinds.items[i].action, action) {
                bk = d.gbinds.items[i].key;
                bp = d.gbinds.items[i].pad;
            }
        }
        if key.len == 0 { key = if bk.len > 0 { bk } else { glyphKey(action) }; }
        if pad.len == 0 { pad = if bp.len > 0 { bp } else { glyphPad(action) }; }
    }
    let onPad = if d.padSt.mode { pad.len > 0 } else { key.len == 0 };
    // the PlayStation symbols come from the glyph's own font; one without them (known once the glyph has a style) gets names instead
    let plain = false;
    if onPad && d.glyphStyle == GS_PLAYSTATION && glyphSym(pad) > 0 && d.nodes.items[id].style >= 0 {
        plain = !fontHas(fontOf(d, d.nodes.items[id].style), glyphSym(pad));
    }
    let label = if onPad { glyphPadLabel(d.glyphStyle, pad, plain) } else { key };
    if label.len == 0 { label = if action.len > 0 { action } else { "?" }; }
    let dev = if onPad { "pad" } else { "key" };
    let first = d.nodes.items[id].first;
    let cur = d.mnodes.items[id].type;
    let unchanged = first >= 0 && d.nodes.items[first].kind == K_TEXT && same(d.textOf(first), label) && cur >= 0 && same(d.css.name(cur), dev);
    if unchanged { d.text(label); return; }
    d.attrType(id, dev);
    d.text(label);
    if onPad {
        d.gtmp.clear();
        d.gtmp.pushStr(label);
        d.gtmp.pushStr(" button");
        d.attrAria(id, d.gtmp.str());
    } else {
        d.attrAria(id, label);
    }
}
