// Part of j3.ui.dom (Radio groups: scope, exclusive checking, the one tab stop, arrow-key neighbours.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Whether `id` is an `<input type="radio">`.
pub fn isRadio(d: &Dom, id: int): bool {
    return id >= 0 && d.nodes.items[id].kind == K_ELEM && d.nodes.items[id].tag == d.tInput && d.mnodes.items[id].type == d.vRadio;
}

/// The group scope of radio `id`: the nearest ancestor with `role="radiogroup"`, -1 for the whole Dom (there is no `<form>`).
pub fn radioScope(d: &Dom, id: int): int {
    let c = d.nodes.items[id].parent;
    while c >= 0 {
        if d.nodes.items[c].roleLen > 0 && same(d.roleOf(c), "radiogroup") { return c; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Whether `m` is in the group of radio `r` (`r` itself counts): same `name`, same scope. A radio with no name is its own group.
fn radioMate(d: &Dom, r: int, m: int): bool {
    if r == m { return true; }
    let nm = d.nodes.items[r].rname;
    return nm >= 0 && isRadio(d, m) && !d.nodes.items[m].ghost && d.nodes.items[m].rname == nm && radioScope(d, m) == radioScope(d, r);
}

fn radioNext(d: &Dom, k: int): int {
    if d.nodes.items[k].first >= 0 { return d.nodes.items[k].first; }
    let c = k;
    while c >= 0 {
        if d.nodes.items[c].next >= 0 { return d.nodes.items[c].next; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

fn radioPaint(d: &Dom, id: int, on: bool) {
    d.nodes.items[id].checked = on;
    d.setFlag(id, FL_CHECKED, on);
}

/// Once per name: radios of one group sit in different keyed `{#each}` rows, which almost always means each row wanted its own group.
fn radioWarn(d: &Dom, id: int) {
    let m = Text.new(d.mem);
    m.pushStr("radio group \"");
    m.pushStr(d.css.name(d.nodes.items[id].rname));
    m.pushStr("\" spans several {#each} rows: add role=\"radiogroup\" to the row's element to give each row its own group");
    for i in 0..d.css.warns.len {
        if same(d.css.warns.items[i].msg, m.str()) { return; }
    }
    d.css.warns.push(Warning { file: "radio group:", line: 1, col: 1, msg: m.str() });
}

/// Uncheck the other checked radios of `id`'s group (`user`: stamp them for `bind:checked`). Walks the tree once.
fn radioClear(d: &Dom, id: int, user: bool) {
    if d.nodes.items[id].rname < 0 { return; }
    let c = 0;
    while c >= 0 {
        if c != id && d.nodes.items[c].checked && radioMate(d, id, c) {
            if radioScope(d, id) < 0 && d.nodes.items[c].gk != d.nodes.items[id].gk { radioWarn(d, id); }
            radioPaint(d, c, false);
            if user { d.nodes.items[c].clkAt = d.frame; }
        }
        c = radioNext(d, c);
    }
}

/// Check (or uncheck) radio `id`; checking unchecks the rest of its group. `user`: stamp the frame so `on:change` (the one checked) and
/// `bind:checked` (every one that flipped) see it.
pub fn radioSet(d: &Dom, id: int, on: bool, user: bool) {
    let n = &d.nodes.items[id];
    if n.checked == on { return; }
    if !on {
        radioPaint(d, id, false);
        if user { n.clkAt = d.frame; }
        return;
    }
    radioClear(d, id, user);
    radioPaint(d, id, true);
    if user {
        n.clkAt = d.frame;
        n.chg = d.frame;
    }
}

/// Before a Tab press walks the tree: choose each group's stop (the checked radio, else the first one that can take focus) in one pass
/// and mark it with `Dom.tabSer`, so `tabbable` is a field test per radio. A hash of (scope, name) in `Dom.rtab`, four ints a slot:
/// scope + 2 (0 empty), name, first, checked.
pub fn radioMark(d: &Dom) {
    d.tabSer += 1;
    let cnt = 0;
    let c = 0;
    while c >= 0 {
        if isRadio(d, c) { cnt += 1; }
        c = radioNext(d, c);
    }
    if cnt == 0 { return; }
    let cap = 16;
    while cap < cnt * 2 { cap *= 2; }
    let t = &d.rtab;
    t.len = 0;
    for i in 0..cap * 4 { t.push(0); }
    c = 0;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if isRadio(d, c) && isFocusable(d, c) {
            if n.rname < 0 {
                n.rstop = d.tabSer;
            } else {
                let sc = radioScope(d, c);
                let h = ((sc + 1) * 31 + n.rname) % cap;
                let i = h * 4;
                while t.items[i] != 0 && !(t.items[i] == sc + 2 && t.items[i + 1] == n.rname) {
                    h = (h + 1) % cap;
                    i = h * 4;
                }
                if t.items[i] == 0 {
                    t.items[i] = sc + 2;
                    t.items[i + 1] = n.rname;
                    t.items[i + 2] = c;
                    t.items[i + 3] = -1;
                }
                if n.checked && t.items[i + 3] < 0 { t.items[i + 3] = c; }
            }
        }
        c = radioNext(d, c);
    }
    for k in 0..cap {
        let q = k * 4;
        if t.items[q] != 0 {
            d.nodes.items[if t.items[q + 3] >= 0 { t.items[q + 3] } else { t.items[q + 2] }].rstop = d.tabSer;
        }
    }
}

/// Whether Tab can land on `id` after `radioMark`: `padReach`, and a radio only when it is its group's stop.
pub fn tabStop(d: &Dom, id: int): bool {
    return padReach(d, id) && (!isRadio(d, id) || d.nodes.items[id].rstop == d.tabSer);
}

/// The member of `id`'s group Tab lands on (one call, a tree walk; a Tab press uses `radioMark`): the checked one, else the first one that can take focus (-1 for none). Another radio of the group
/// that is checked but disabled or hidden does not count, so Tab never skips the whole group.
pub fn radioStop(d: &Dom, id: int): int {
    let first = -1;
    let chk = -1;
    let c = 0;
    while c >= 0 {
        if radioMate(d, id, c) && isFocusable(d, c) {
            if first < 0 { first = c; }
            if d.nodes.items[c].checked && chk < 0 { chk = c; }
        }
        c = radioNext(d, c);
    }
    return if chk >= 0 { chk } else { first };
}

/// The radio an arrow key from `id` goes to: the previous (`dir` -1) or next (1) member of its group that can take focus, wrapping
///, skipping disabled ones and those the modal blocks (`id` itself when it is alone).
pub fn radioNeighbor(d: &Dom, id: int, dir: int): int {
    let prev = -1;      // last focusable member before `id`
    let first = -1;
    let after = -1;     // first focusable member after `id`
    let last = -1;
    let seen = false;
    let c = 0;
    while c >= 0 {
        if c == id {
            seen = true;
        } else if radioMate(d, id, c) && isFocusable(d, c) && allowedByModal(d, c) {
            if first < 0 { first = c; }
            last = c;
            if !seen { prev = c; } else if after < 0 { after = c; }
        }
        c = radioNext(d, c);
    }
    let r = if dir > 0 { if after >= 0 { after } else { first } } else { if prev >= 0 { prev } else { last } };
    return if r >= 0 { r } else { id };
}
