// Part of j3.ui.dom (Dirty marking, layout boundaries.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Layout (and intrinsic sizes) of `id` and every ancestor are stale, up to the first layout boundary above `id` (`Node.relay`):
/// its border box can't change, so its ancestors stay clean and `layoutBounds` lays it out again in the same box. `id` itself
/// never stops the climb, since a caller marking a node may have changed its own size.
fn markDirty(d: &Dom, id: int) {
    d.gen += 1;
    let c = id;
    while c >= 0 {
        d.nodes.items[c].dirty = true;
        d.nodes.items[c].dirtyGen = d.gen;
        if c != id && stopsAt(d, c) {
            return;
        }
        c = d.nodes.items[c].parent;
    }
}

/// `markDirty` for a change inside `id` that leaves its border box as the parent sees it (`applyStyle` with the same
/// `OUTER_PROPS`): a boundary stops at itself.
fn markInner(d: &Dom, id: int) {
    if stopsAt(d, id) {
        d.gen += 1;
        d.nodes.items[id].dirty = true;
        d.nodes.items[id].dirtyGen = d.gen;
        return;
    }
    markDirty(d, id);
}

/// Is `c` a boundary the dirty climb ends at? Queues it on `Dom.relayout` (once). A box mid enter/leave slide changes size.
fn stopsAt(d: &Dom, c: int): bool {
    let n = &d.nodes.items[c];
    if !n.bound || !n.relay || n.trn >= 0 {
        return false;
    }
    if !n.relQ {
        n.relQ = true;
        d.relayout.push(Idx { v: c });
    }
    return true;
}

/// Restyle `id` and its whole subtree on the next `layout`.
///
/// With sibling combinators (`a + b`, `a ~ b`) in the loaded CSS the following siblings restyle too: only the next element
/// for a lone `+` (`Css.sibMode` 1), every following element for `~` or chained `+` (mode 2), so one change costs
/// up to the number of siblings after it. Text nodes and `::before` / `::after` boxes are not siblings for selectors.
fn markStyle(d: &Dom, id: int) {
    d.nodes.items[id].styleDirty = true;
    d.nodes.items[id].hasOnly = false;
    let c = d.nodes.items[id].parent;
    // an ancestor already marked has its whole chain marked (`resolveNode` clears top-down)
    while c >= 0 && !d.nodes.items[c].subStyle {
        d.nodes.items[c].subStyle = true;
        c = d.nodes.items[c].parent;
    }
    if d.css.sibMode > 0 && d.mnodes.items[id].pe == 0 {
        markFrom(d, d.nodes.items[id].next);
    }
}

/// A `style:` value of `id` changed: no selector reads it, so the rules that match stand (`resolveNode` reruns only
/// `inlineStyle`, and the subtree only when an inherited value changed). A `markStyle` the same frame wins.
fn markInline(d: &Dom, id: int) {
    d.nodes.items[id].inlineDirty = true;
    let c = d.nodes.items[id].parent;
    while c >= 0 && !d.nodes.items[c].subStyle {
        d.nodes.items[c].subStyle = true;
        c = d.nodes.items[c].parent;
    }
}

/// A restyle changed only what paints (`styleDiff`): no layout, but `dirtyGen` moves as `markDirty` would move it.
fn markPaint(d: &Dom, id: int) {
    d.gen += 1;
    d.nodes.items[id].dirtyGen = d.gen;
}

/// A child of `parent` came, went or moved (or a text child changed between blank and not): the selectors that look at the siblings
/// after an element or at its children (`Css.structMode`: `:nth-last-child`, `:*-of-type`, `:only-child`, `:empty`) restyle the
/// parent and every element child, so one change costs the number of children. Nothing happens without such a rule.
fn markKids(d: &Dom, parent: int) {
    if d.css.structMode == 0 || parent < 0 {
        return;
    }
    if d.nodes.items[parent].kidsMk && d.nodes.items[parent].styleDirty {
        return;
    }
    d.nodes.items[parent].kidsMk = true;
    markStyle(d, parent);
    let c = d.nodes.items[parent].first;
    while c >= 0 {
        if d.mnodes.items[c].pe == 0 {
            d.nodes.items[c].styleDirty = true;
            d.nodes.items[c].hasOnly = false;
            d.kidMarks += 1;
        }
        c = d.nodes.items[c].next;
    }
    d.nodes.items[parent].subStyle = true;
}

/// Something a `:has()` argument could test changed on `id` (`what`: 0 a class `v` came or went, 1 the `FL_*` bit `v`, 2 an `#id` /
/// `[type]` / text blankness, 3 it was inserted, removed or moved): restyle the elements that carry a `:has()` and could now
/// flip, which are the ancestors for a descendant argument, the parent for `>`, the earlier siblings for `+` / `~`. Does nothing
/// without `:has()` rules or when no argument tests this feature (`Css.hasMode`, `hasCls`, `hasFlags`, `hasAttr`); otherwise costs the
/// depth (one cheap compound test per ancestor, and an ordinary restyle of the ones that pass).
fn markHas(d: &Dom, id: int, what: int, v: int) {
    let css = d.css;
    if css.hasMode == 0 {
        return;
    }
    let nodes = d.mnodes.items;
    // text and `::before` / `::after` boxes are no element for an argument to find (a text node's blankness is `what` 2)
    if what == 3 && (d.nodes.items[id].kind != K_ELEM || nodes[id].pe != 0) {
        return;
    }
    let hit = what == 3 || (what == 2 && css.hasAttr != 0);
    if what == 0 {
        for i in 0..css.hasCls.len {
            if css.hasCls.items[i] == v {
                hit = true;
            }
        }
    } else if what == 1 {
        hit = hasBit(css.hasFlags, v);
    }
    if !hit {
        return;
    }
    if css.hasMode % 2 == 1 || (css.hasMode / 2) % 2 == 1 {
        let a = nodes[id].parent;
        let up = css.hasMode % 2 == 1;
        while a >= 0 {
            // an earlier walk this round went through `a` and so through everything above it (mass inserts walk once)
            if up && d.nodes.items[a].hasEp == css.hasGen {
                break;
            }
            if up {
                d.nodes.items[a].hasEp = css.hasGen;
            }
            css.hasWalked += 1;
            if d.nodes.items[a].kind == K_ELEM && nodes[a].pe == 0 && hasSubject(css, nodes, a) {
                restyleHas(d, a);
            }
            a = if up { nodes[a].parent } else { -1 };
        }
    }
    if css.hasMode / 4 > 0 {
        let q = prevEl(nodes, id);
        while q >= 0 {
            if hasSubject(css, nodes, q) {
                restyleHas(d, q);
            }
            q = if css.hasMode / 8 > 0 { prevEl(nodes, q) } else { -1 };
        }
    }
}

/// `markStyle` for an element whose `:has()` may have flipped: its subtree restyles only if its style id changes (`resolveNode`), unless
/// some rule has a `:has()` outside its rightmost compound (`Css.hasInner`).
fn restyleHas(d: &Dom, a: int) {
    let n = &d.nodes.items[a];
    let only = !n.styleDirty || n.hasOnly;
    markStyle(d, a);
    n.hasOnly = only;
}

/// Restyle the element `c` or the first one after it (every one after it in sibling mode 2).
fn markFrom(d: &Dom, c0: int) {
    let c = c0;
    let first = true;
    while c >= 0 {
        if d.mnodes.items[c].pe == 0 {
            d.nodes.items[c].styleDirty = true;
            d.nodes.items[c].hasOnly = false;
            if first {
                first = false;
                let a = d.nodes.items[c].parent;
                while a >= 0 {
                    d.nodes.items[a].subStyle = true;
                    a = d.nodes.items[a].parent;
                }
            }
            if d.css.sibMode == 1 {
                return;
            }
        }
        c = d.nodes.items[c].next;
    }
}

/// Lay out again the layout boundaries `markDirty` stopped at, each in the box its (clean) parent gave it last time. One whose
/// baseline moved, which the parent may have read, marks its ancestors dirty after all (the caller runs the normal pass
/// again). An entry whose node was laid out by the normal pass or freed is dropped; one under a box that is still dirty marks the
/// path up to that box dirty, so the box's own replay (or the rerun normal pass) reaches it.
/// Returns 0 when it laid nothing out, 1 when it did, 2 when a moved baseline dirtied ancestors.
fn layoutBounds(d: &Dom): int {
    let res = 0;
    let i = 0;
    // the fallback below can queue an outer boundary: the list grows while this walks it
    while i < d.relayout.len {
        let b = d.relayout.items[i].v;
        i += 1;
        let n = &d.nodes.items[b];
        if !n.relQ {
            continue;
        }
        n.relQ = false;
        if !n.dirty || !n.relay || !n.laid {
            continue;
        }
        if !cleanAbove(d, b) {
            // the dirty box above lays out only dirty children: open the path down to `b` (it stops here, so it is clean)
            let c = d.nodes.items[b].parent;
            while c >= 0 && !d.nodes.items[c].dirty && d.nodes.items[c].laid {
                d.nodes.items[c].dirty = true;
                c = d.nodes.items[c].parent;
            }
            continue;
        }
        let base = n.baseline;
        layoutBox(d, b, n.lastW, n.lastH, n.basisW, n.basisH);
        let m = &d.nodes.items[b];
        if m.baseline == base {
            m.relay = true;
            res = max4(res, 1);
        } else {
            // `layoutBox` cleared `relay`, so the climb goes past this box
            markDirty(d, b);
            res = 2;
        }
    }
    d.relayout.len = 0;
    return res;
}

/// No ancestor of `b` is dirty (the parent's last layout of it still holds). A scroll-snap container above it re-snaps,
/// since a snap target inside may have moved.
fn cleanAbove(d: &Dom, b: int): bool {
    let snap = false;
    let c = d.nodes.items[b].parent;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.dirty || !n.laid {
            return false;
        }
        if n.kind == K_ELEM && snapAxis(d, n.style) != 0 {
            snap = true;
        }
        c = n.parent;
    }
    if snap {
        d.snapDirty = true;
    }
    return true;
}
