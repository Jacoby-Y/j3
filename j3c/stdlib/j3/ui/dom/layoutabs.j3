// Part of j3.ui.dom (Absolute and fixed positioned layout.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Position `position: absolute` boxes against their containing block (after the main pass).
fn layoutAbs(d: &Dom) {
    // ancestors first: laying out an absolute box puts its absolute descendants back at its content origin, so they
    // must come after it (`dropAbs` swap-removes and a box can turn absolute late, so `d.abs` is not in tree order)
    for i in 1..d.abs.len {
        let v = d.abs.items[i].v;
        let dv = depthOf(d, v);
        let j = i;
        while j > 0 && depthOf(d, d.abs.items[j - 1].v) > dv {
            d.abs.items[j].v = d.abs.items[j - 1].v;
            j -= 1;
        }
        d.abs.items[j].v = v;
    }
    for i in 0..d.abs.len {
        layoutOneAbs(d, d.abs.items[i].v);
    }
}

fn depthOf(d: &Dom, id: int): int {
    let k = 0;
    let c = d.nodes.items[id].parent;
    while c >= 0 {
        k += 1;
        c = d.nodes.items[c].parent;
    }
    return k;
}

/// Where a flipped box goes (`position-try-fallbacks`): mirrored inside the anchor span `a0..a0 + aw`.
fn mirror(v: f32, a0: f32, aw: f32, size: f32): f32 {
    return a0 + aw - (v - a0) - size;
}

fn layoutOneAbs(d: &Dom, a: int) {
    if d.nodes.items[a].disp == DP_NONE {
        return;
    }
    let anchor = &d.nodes.items[a];
    let owner = anchor.parent;
    if anchor.ovContext && anchor.ctxPending && d.nodes.items[owner].laid && !isHidden(d, owner) {
        anchor.atx = d.absX(owner);
        anchor.aty = d.absY(owner) + d.nodes.items[owner].h;
        anchor.hasAtX = true;
        anchor.hasAtY = true;
        anchor.ctxPending = false;
    }
    let ast = d.nodes.items[a].style;
    let pos = kwOf(d, ast, P_POSITION);
    // fixed boxes and dialogs are placed in the root; a popover in the nearest positioned ancestor
    let fixed = pos == POS_FIXED || d.nodes.items[a].tag == d.tDialog || d.nodes.items[a].rt || (pos == POS_STATIC && d.nodes.items[a].ov != 0);
    let hasAtX = d.nodes.items[a].hasAtX;
    let hasAtY = d.nodes.items[a].hasAtY;
    let hasAt = hasAtX || hasAtY;
    // containing block: nearest positioned ancestor, else the root (always the root for `fixed`)
    let cb = d.nodes.items[a].parent;
    while cb > 0 && !fixed {
        if kwOf(d, d.nodes.items[cb].style, P_POSITION) != POS_STATIC {
            break;
        }
        cb = d.nodes.items[cb].parent;
    }
    if fixed {
        cb = 0;
    }
    // offset of the parent's border box inside cb's border box (fixed: its viewport position)
    let par = d.nodes.items[a].parent;
    let px: f32 = 0.0;
    let py: f32 = 0.0;
    if fixed {
        px = d.absX(par);
        py = d.absY(par);
    } else {
        let q = par;
        while q >= 0 && q != cb {
            px += d.nodes.items[q].x;
            py += d.nodes.items[q].y;
            q = d.nodes.items[q].parent;
        }
    }
    let cst = d.nodes.items[cb].style;
    let ce = edgesOf(d, cst, d.nodes.items[cb].basisW);
    let cbw = d.nodes.items[cb].w - ce.bl - ce.br;
    let cbh = d.nodes.items[cb].h - ce.bt - ce.bb;
    let e = edgesOf(d, ast, cbw);
    let lf = lenVal(d, d.css.get(ast, P_LEFT), cbw);
    let rt = lenVal(d, d.css.get(ast, P_RIGHT), cbw);
    let tp = lenVal(d, d.css.get(ast, P_TOP), cbh);
    let bt = lenVal(d, d.css.get(ast, P_BOTTOM), cbh);
    // percentages are of the containing block
    if lf.kind == V_PCT { lf = Value { kind: V_PX, f: lf.f * cbw / 100.0, i: 0, c: 0 }; }
    if rt.kind == V_PCT { rt = Value { kind: V_PX, f: rt.f * cbw / 100.0, i: 0, c: 0 }; }
    if tp.kind == V_PCT { tp = Value { kind: V_PX, f: tp.f * cbh / 100.0, i: 0, c: 0 }; }
    if bt.kind == V_PCT { bt = Value { kind: V_PX, f: bt.f * cbh / 100.0, i: 0, c: 0 }; }
    let hasL = lf.kind == V_PX;
    let hasR = rt.kind == V_PX;
    let hasT = tp.kind == V_PX;
    let hasB = bt.kind == V_PX;
    if hasAtX {
        // the `left` / `top` attributes win over the CSS insets
        lf.f = d.nodes.items[a].atx;
        hasL = true;
        hasR = false;
    }
    if hasAtY {
        tp.f = d.nodes.items[a].aty;
        hasT = true;
        hasB = false;
    }
    let w = specW(d, ast, cbw, e);
    if d.nodes.items[a].ow >= 0.0 {
        w = d.nodes.items[a].ow;
    }
    if w < 0.0 {
        if hasL && hasR {
            w = max(cbw - lf.f - rt.f - e.ml - e.mr, 0.0);
        } else {
            let avail = cbw - e.ml - e.mr;
            if hasL {
                avail -= lf.f;
            }
            if hasR {
                avail -= rt.f;
            }
            w = fitWidth(d, a, max(avail, 0.0), cbw);
            // Auto-width titles shrink to their text, wrapping at 320px (or the viewport).
            // Explicit CSS width still wins; sizing limits apply below.
            if a == d.ttRoot {
                w = min(w, max(0.0, min(320.0, cbw - 8.0)));
            }
        }
    }
    let h = specH(d, ast, cbh, e);
    if d.nodes.items[a].oh >= 0.0 {
        h = d.nodes.items[a].oh;
    }
    if h < 0.0 && hasT && hasB {
        h = max(cbh - tp.f - bt.f - e.mt - e.mb, 0.0);
    }
    layoutBox(d, a, w, h, cbw, cbh);
    w = d.nodes.items[a].w;
    let hh = d.nodes.items[a].h;
    // coordinates in the containing block's border box
    let ax = ce.bl;
    let ay = ce.bt;
    if hasL {
        ax = ce.bl + lf.f + e.ml;
        if hasR {
            // `left` and `right` both set: auto side margins share what the box leaves
            let autoL = autoM(d, ast, 3);
            let autoR = autoM(d, ast, 1);
            let spare = max(cbw - lf.f - rt.f - w - e.ml - e.mr, 0.0);
            ax += if autoL && autoR { spare / 2.0 } else if autoL { spare } else { 0.0 };
        }
    } else if hasR {
        ax = ce.bl + cbw - rt.f - e.mr - w;
    } else if d.nodes.items[a].tag == d.tDialog {
        ax = ce.bl + (cbw - w) / 2.0;
    } else {
        ax = px + edgeOf(d, d.nodes.items[par].style, P_PADDING_TOP + 3, d.nodes.items[par].basisW) + edgeOf(d, d.nodes.items[par].style, P_BORDER_TOP_WIDTH + 3, d.nodes.items[par].basisW) + e.ml;
    }
    if hasT {
        ay = ce.bt + tp.f + e.mt;
        if hasB {
            let autoT = autoM(d, ast, 0);
            let autoB = autoM(d, ast, 2);
            let spareY = max(cbh - tp.f - bt.f - hh - e.mt - e.mb, 0.0);
            ay += if autoT && autoB { spareY / 2.0 } else if autoT { spareY } else { 0.0 };
        }
    } else if hasB {
        ay = ce.bt + cbh - bt.f - e.mb - hh;
    } else if d.nodes.items[a].tag == d.tDialog {
        ay = ce.bt + (cbh - hh) / 2.0;
    } else {
        ay = py + edgeOf(d, d.nodes.items[par].style, P_PADDING_TOP, d.nodes.items[par].basisW) + edgeOf(d, d.nodes.items[par].style, P_BORDER_TOP_WIDTH, d.nodes.items[par].basisW) + e.mt;
    }
    // viewport position, for flipping and keeping popups on screen
    let vx = if fixed { ax } else { d.absX(par) + (ax - px) };
    let vy = if fixed { ay } else { d.absY(par) + (ay - py) };
    if d.nodes.items[a].ovCaret && vy + hh > d.vh && vy - d.nodes.items[a].cth - hh >= 0.0 {
        // a caret popup with no room below the caret line goes above it
        ay -= d.nodes.items[a].cth + hh;
        vy -= d.nodes.items[a].cth + hh;
    }
    let tr = kwOf(d, ast, P_TRY);
    if tr != 0 {
        // anchor: the point of a `left`/`top` attribute, else the parent's box
        let a0x = vx;
        let a0y = vy;
        let awx: f32 = 0.0;
        let awy: f32 = 0.0;
        if !hasAtX {
            a0x = d.absX(par);
            awx = d.nodes.items[par].w;
        }
        if !hasAtY {
            a0y = d.absY(par);
            awy = d.nodes.items[par].h;
        }
        if tr == TRY_INLINE || tr == TRY_BOTH {
            let nx = mirror(vx, a0x, awx, w);
            if (vx + w > d.vw || vx < 0.0) && nx >= 0.0 && nx + w <= d.vw {
                ax += nx - vx;
                vx = nx;
            }
        }
        if tr == TRY_BLOCK || tr == TRY_BOTH {
            let ny = mirror(vy, a0y, awy, hh);
            if (vy + hh > d.vh || vy < 0.0) && ny >= 0.0 && ny + hh <= d.vh {
                ay += ny - vy;
                vy = ny;
            }
        }
    }
    if d.nodes.items[a].ov != 0 || d.nodes.items[a].rt || hasAt {
        // keep a popup inside the window
        let cx = max(0.0, min(vx, d.vw - w));
        let cy = max(0.0, min(vy, d.vh - hh));
        ax += cx - vx;
        ay += cy - vy;
        vx = cx;
        vy = cy;
    }
    if d.nodes.items[a].isFixed {
        d.nodes.items[a].x = vx;
        d.nodes.items[a].y = vy;
    } else {
        d.nodes.items[a].x = ax - px;
        d.nodes.items[a].y = ay - py;
    }
}
