// Part of j3.ui.dom (panel, drag-and-drop, tab index, media and position attributes); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// `panel` / `panel="dock"`: `id` is a draggable panel (`position: absolute` or `fixed`), one that
    /// docks when given `"dock"` (`j3.ui.panels`).
    fn attrPanel(this: &Dom, id: int, mode: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.pk != PK_PANEL {
            n.pk = PK_PANEL;
            // a recycled node id restarts its state; a dead panel's slot is reused
            let at = panelmath.slot(this.pans.items, this.pans.len, id);
            if at < 0 {
                this.pans.push(panelmath.fresh(id, same(mode, "dock")));
            } else {
                this.pans.items[at] = panelmath.fresh(id, same(mode, "dock"));
            }
        }
    }

    /// `panel-handle` (role `PK_HANDLE`) / `panel-resize` (`PK_GRIP`): dragging `id` moves / resizes its panel.
    fn attrPanelRole(this: &Dom, id: int, role: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].pk = role;
    }

    /// `window-drag`: `id`'s box moves the window (`j3.ui.windrag`); its buttons and inputs stay clicks.
    fn attrWindowDrag(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.pk != PK_WDRAG {
            n.pk = PK_WDRAG;
            this.wdr.push(Idx { v: id });
        }
    }

    /// `draggable` / `draggable={bool}`.
    fn attrDraggable(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].draggable = on;
    }

    /// `on:dragenter` (1), `on:dragleave` (2), `on:dragover` (4) or `on:drop` (8) is on `id`: it is a drop target.
    fn attrDragTarget(this: &Dom, id: int, bit: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if (n.dragT / bit) % 2 == 0 {
            n.dragT += bit;
        }
    }

    /// `drag-ghost="none"`: the page draws its own drag image.
    fn attrDragGhost(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].noGhost = same(s, "none");
    }

    /// `drag-id`: the integer payload of a drag from `id`.
    fn attrDragId(this: &Dom, id: int, v: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].dragId = v;
    }

    /// `drag-data`: the text payload of a drag from `id` (copied).
    fn attrDragData(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.dgBuf, &n.dgLen, s);
    }

    /// The source whose payload handlers read: the one whose `dragend` is delivered this frame, else the current one.
    fn dragSrcNow(this: &Dom): int {
        return if this.drag.endAt == this.frame { this.drag.endN } else { this.drag.src };
    }

    /// The `drag-data` of the item being dragged ("" for none).
    fn dragData(this: &Dom): string {
        let s = this.dragSrcNow();
        if s < 0 || s >= this.nodes.len {
            return "";
        }
        let n = &this.nodes.items[s];
        return ([]u8 { ptr: n.dgBuf.ptr, len: n.dgLen }) as string;
    }

    /// The `drag-id` of the item being dragged (0 for none).
    fn dragIdOf(this: &Dom): int {
        let s = this.dragSrcNow();
        return if s < 0 || s >= this.nodes.len { 0 } else { this.nodes.items[s].dragId };
    }

    /// A drag started from `id` this frame.
    fn dragStarted(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.startAt == this.frame && this.drag.src == id;
    }

    /// A drag from `id` ended (the frame after the release, so after any `drop`), dropped or not. Not delivered when the page removed `id`.
    fn dragEnded(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.endAt == this.frame && this.drag.endN == id;
    }

    /// Whether the drag that ended this frame landed on an element with `on:drop`.
    fn dragDropped(this: &Dom): bool {
        return this.drag.dropped;
    }

    /// The dragged item came over `id` this frame.
    fn dragEntered(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.enterAt == this.frame && this.drag.enterN == id;
    }

    /// The dragged item left `id` this frame (moved off, or Escape).
    fn dragLeft(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.leaveAt == this.frame && this.drag.leaveN == id;
    }

    /// The dragged item is over `id` (every frame while it is).
    fn dragOver(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.overAt == this.frame && this.drag.overN == id;
    }

    /// The dragged item was released on `id` this frame.
    fn dropAt(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.drag.dropAt == this.frame && this.drag.dropN == id;
    }

    /// `on:dragover` set `accept = false`: `id` is no target for this drag (no `:drop-target`, no `on:drop`) while the pointer stays on it.
    fn dragReject(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.drag.tgt == id && this.drag.rej != id {
            this.drag.rej = id;
            this.setFlag(id, FL_DROP, false);
        }
    }

    /// `menuitem`: `id` is a menu entry (focusable, Enter clicks it, Up/Down/Left/Right move between entries).
    fn attrMenuItem(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].mitem = true;
    }

    /// `tabindex="0"`: `id` is focusable like a button (a `button` role unless `role=` says otherwise).
    fn attrTabIndex(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].mitem = true;
        if this.nodes.items[id].roleLen == 0 {
            this.attrRole(id, "button");
        }
    }

    /// `tabindex="-1"`: like `tabindex="0"`, but Tab and the pad skip it (`focusNode` and a press still focus it).
    fn attrTabIndexOff(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrTabIndex(id);
        this.nodes.items[id].noTab = true;
    }

    /// `tabindex={v}` / a static positive value: `v < 0` skips Tab, `0` is tree order, `v > 0` goes first in ascending order.
    fn attrTabIndexN(this: &Dom, id: int, v: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrTabIndex(id);
        this.nodes.items[id].noTab = v < 0;
        this.nodes.items[id].tabIdx = if v > 0 { v } else { 0 };
    }

    /// `<img>` / `<svg>` / `<path>` string attributes (`media.M_*`: src, sprite, viewBox, d, fill, stroke).
    fn attrMedia(this: &Dom, id: int, what: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.media == 0 {
            n.media = media.acquire(&this.media) + 1;
        }
        if media.setStr(&this.media.items[n.media - 1], this.mem, what, s) {
            markDirty(this, id);
        }
    }

    /// `<icon name=...>`: `table` is the `name\tdata` lines the compiler copied for this element
    /// (`j3c/src/ui/icons.rs`); a name missing from it warns once and draws nothing.
    fn attrIcon(this: &Dom, id: int, name: string, table: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.media == 0 {
            n.media = media.acquire(&this.media) + 1;
        }
        let m = &this.media.items[n.media - 1];
        let was = m.iLen;
        let changed = false;
        if !media.icon(m, this.mem, name, table, &changed) && (was != m.iLen || changed) && name.len > 0 {
            this.css.warns.push(Warning { file: "icon:", line: 1, col: 1, msg: "unknown icon name (a computed name must be one of the string literals in its `name={...}`)" });
        }
        if changed {
            markDirty(this, id);
        }
    }

    /// Number attributes (`media.N_*`: frame, fps, stroke-width).
    fn attrMediaNum(this: &Dom, id: int, what: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.media == 0 {
            n.media = media.acquire(&this.media) + 1;
        }
        media.setNum(&this.media.items[n.media - 1], what, v);
    }

    /// Delete every cached image texture (they reload when next drawn).
    fn freeImages(this: &Dom) {
        media.freeAll(&this.imgs);
        for i in 0..this.media.len {
            this.media.items[i].need = this.media.items[i].used;
        }
    }

    /// Force the border-box size of panel `id` (-1 on an axis: back to its CSS).
    fn panelSize(this: &Dom, id: int, w: f32, h: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.ow != w || n.oh != h {
            n.ow = w;
            n.oh = h;
            markDirty(this, id);
        }
    }

    /// The dock zone of panel `id` (`panelmath.DOCK_*`; 0 when floating or not a panel).
    fn panelDock(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        let at = panelmath.find(this.pans.items, this.pans.len, id);
        return if at < 0 { 0 } else { this.pans.items[at].dock };
    }

    /// The `title` of `id` ("" for none).
    fn tipOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.tipBuf.ptr, len: n.tipLen }) as string;
    }

    /// `left` attribute: where a `position: fixed` or `absolute` box goes, in px (overrides the CSS).
    fn attrLeft(this: &Dom, id: int, x: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if !n.hasAtX || n.atx != x {
            n.hasAtX = true;
            n.atx = x;
            markDirty(this, id);
        }
    }

    /// `top` attribute (see `attrLeft`).
    fn attrTop(this: &Dom, id: int, y: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if !n.hasAtY || n.aty != y {
            n.hasAtY = true;
            n.aty = y;
            markDirty(this, id);
        }
    }
}

