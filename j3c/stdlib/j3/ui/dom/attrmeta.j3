// Part of j3.ui.dom (overlay, context, trigger, a11y and role attributes); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Make `id` an overlay: `OV_MODAL` (a `<dialog modal>`: the page behind it takes no input, Tab stays
    /// inside, Escape asks to close) or `OV_POPOVER` (light dismiss: a press outside or Escape asks to
    /// close). Call it every frame the element is built; the element leaves the stack when it is
    /// removed. See `j3.ui.overlay`.
    fn attrOverlay(this: &Dom, id: int, kind: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.ov == 0 {
            this.ovs.push(Idx { v: id });
            n.ovFocus = this.focus;
            n.ovZ = OVERLAY_Z + mini(this.ovs.len - 1, 7);
        }
        n.ovContext = false;
        n.ovCaret = false;
        n.ctxPending = false;
        n.ov = kind;
    }

    /// Markup flags: 1 `autoselect` (a modal selects its first text box when it opens), 2 `on:submit` (this box handles Enter, so
    /// the dialog's default button does not), 3 `default` (the button Enter clicks in its dialog), 4 `on:wheel|stop` (the wheel
    /// over this box scrolls neither it nor its ancestors).
    fn attrFlag(this: &Dom, id: int, which: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if which == 1 { n.fAuto = true; } else if which == 2 { n.fSub = true; } else if which == 4 { n.fWheel = true; } else if which >= 8 { n.fStop = n.fStop | u8(which); } else { n.fDef = true; }
    }

    /// A context popover is a conditional child of its request owner. Capture this frame only.
    fn attrContext(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let fresh = this.nodes.items[id].ov == 0;
        let pending = this.nodes.items[id].ctxPending;
        this.attrOverlay(id, OV_POPOVER);
        this.nodes.items[id].ovContext = true;
        let par = this.nodes.items[id].parent;
        if this.ctxNode >= 0 && inside(this, par, this.ctxNode) {
            this.attrLeft(id, this.ctxX);
            this.attrTop(id, this.ctxY);
        } else if fresh || pending {
            // The owner may itself be new: resolve only after its normal/absolute layout.
            this.nodes.items[id].ctxPending = true;
        }
    }

    /// A caret popover is a conditional child of a wrapper holding the text box: it hangs below the box's caret (above it when
    /// there is no room), follows it as the text wraps or scrolls, and never takes focus. The box is the one with an active
    /// trigger, else the focused one, inside the wrapper.
    fn attrCaret(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.attrOverlay(id, OV_POPOVER);
        let n = &this.nodes.items[id];
        n.ovCaret = true;
        let t = if this.trigNode >= 0 { this.trigNode } else { this.focus };
        if t >= 0 && t < this.nodes.len && this.nodes.items[t].kind == K_ELEM && inside(this, n.parent, t) && this.nodes.items[t].edit >= 0 {
            let r = this.caretRect(t);
            if r.x >= 0.0 {
                this.attrLeft(id, r.x);
                this.attrTop(id, r.y + r.h + 2.0);
                n.cth = r.h + 4.0;
            }
        }
    }

    /// The trigger of `on:trigger` changed this frame on `id` (or ended: `triggerText` is empty).
    fn triggered(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.trigEv == id && this.trigChg == this.frame;
    }

    /// The trigger text of the box with the active trigger, `@ja` (empty when it ended). A view of the box's text.
    fn triggerText(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        if this.trigNode != id || this.trigLo < 0 {
            return "";
        }
        let s = this.eds.items[this.claim(id)].str();
        return s[this.trigLo..this.trigHi];
    }

    /// `grid={g.sized(n)}`: `id` is the scroll box of data grid `g` (`j3.ui.grid`). Call it every frame it is built.
    fn gridBind(this: &Dom, id: int, g: &Grid) {
        id = this.resolve(id);
        if id == STALE { return; }
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                this.grids.items[i].g = g;
                this.grids.items[i].frame = this.frame;
                return;
            }
        }
        this.grids.push(GridRef { node: id, g: g, frame: this.frame });
    }

    /// The grid bound to box `id`.
    fn gridOf(this: &Dom, id: int): &Grid {
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                return this.grids.items[i].g;
            }
        }
        panic("gridOf: no grid on this element");
    }

    /// Is `id` the scroll box of a bound grid.
    fn isGrid(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        for i in 0..this.grids.len {
            if this.grids.items[i].node == id {
                return true;
            }
        }
        return false;
    }

    /// The grid on box `id` began or committed an edit this frame (`on:edit`; `Grid.evKind` ...).
    fn gridEdit(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.isGrid(id) && this.gridOf(id).evFrame == this.frame;
    }

    /// `triggers` of a text box: the characters that start a trigger (default `@` and `:`).
    fn attrTriggers(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].trigs = s;
    }

    /// Delayed custom tooltip binding. The conditional popover must be a direct child.
    fn hoverCard(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        let over = this.rawHit >= 0 && inside(this, id, this.rawHit) && allowedByModal(this, this.rawHit);
        let held = false;
        let closed = false;
        let c = n.first;
        while c >= 0 {
            if this.nodes.items[c].ov == OV_POPOVER && !this.nodes.items[c].ovContext {
                held = held || (this.focus >= 0 && inside(this, c, this.focus));
                closed = closed || this.closeRequested(c);
            }
            c = this.nodes.items[c].next;
        }
        if closed { n.hcOpen = false; n.hcBlock = true; }
        if !over && !held {
            n.hcAt = -1.0;
            n.hcBlock = false;
            if n.hcLeave < 0.0 { n.hcLeave = this.now; }
            if this.now - n.hcLeave >= 300.0 { n.hcOpen = false; }
        } else {
            n.hcLeave = -1.0;
            if n.hcAt < 0.0 { n.hcAt = this.now; }
            if !n.hcBlock && this.now - n.hcAt >= uastyle.tipDelay(this.css) { n.hcOpen = true; }
        }
        // A modal opened above the owner must hide its card even while it holds focus.
        if !allowedByModal(this, id) { n.hcOpen = false; n.hcAt = -1.0; }
        return n.hcOpen;
    }

    /// `closedby` of an overlay: `"any"`, `"closerequest"` or `"none"` (default: a popover is `any`, a
    /// modal dialog `closerequest`).
    fn attrClosedBy(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let by = 2;
        if same(s, "any") {
            by = 1;
        } else if same(s, "none") {
            by = 3;
        }
        this.nodes.items[id].ovBy = by;
    }

    /// `title`: the tooltip text of `id` (copied).
    fn attrTitle(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !this.strHas(n.tipBuf, n.tipLen, s) { aNote(this, EV_NAME, id); }
        keep(this.mem, &n.tipBuf, &n.tipLen, s);
    }

    /// `aria-label`: the accessible name of `id` (copied).
    fn attrAria(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !this.strHas(n.ariaBuf, n.ariaLen, s) { aNote(this, EV_NAME, id); }
        keep(this.mem, &n.ariaBuf, &n.ariaLen, s);
    }

    /// `aria-live`: "polite", "assertive" or "off" (copied). A change of the element's text or children is queued for `a11y.liveChanges`.
    fn attrLive(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.liveLen == 0 && s.len > 0 {
            this.liveCount += 1;
        } else if n.liveLen > 0 && s.len == 0 {
            this.liveCount -= 1;
        }
        keep(this.mem, &n.liveBuf, &n.liveLen, s);
    }

    /// The `aria-live` of `id` ("" for none).
    fn liveOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.liveBuf.ptr, len: n.liveLen }) as string;
    }

    /// `aria-describedby`: the static `id`s (space separated) of the elements that describe `id` (copied).
    fn attrDescBy(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.descBuf, &n.descLen, s);
    }

    /// The `aria-describedby` ids of `id` ("" for none).
    fn descByOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.descBuf.ptr, len: n.descLen }) as string;
    }

    /// `aria-selected`: 0 unset, 1 false, 2 true (any selectable role: tab, option, row, listitem).
    fn attrSelected(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let want = if on { 2 } else { 1 };
        if this.nodes.items[id].asel != want {
            this.nodes.items[id].asel = want;
            aNote(this, EV_SELECTED, id);
        }
    }

    /// Ask the host for a frame from any thread (an AT thread that queued an action while the loop is idle). Atomic; nothing else is touched.
    fn requestFrame(this: &Dom) {
        @atomicAdd(&this.wake, 1);
        game.idleWake();
    }

    /// The loop should run a frame now: something moves (`isLive`) or `requestFrame` was called since the last `wantsFrame`
    /// (this clears the request; main thread). `App` sleeps through idle frames (`game.idleSkipAllowed`) by asking the last frame's
    /// `idleMs`, which calls this; a hand-written loop can call it itself.
    fn wantsFrame(this: &Dom): bool {
        let w = @atomicLoad(&this.wake);
        if w > 0 {
            @atomicAdd(&this.wake, 0 - w);
        }
        return w > 0 || this.isLive();
    }

    /// `for` on a `<label>`: the `id` of the control it activates (copied).
    fn attrFor(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if n.forLen == 0 && s.len > 0 {
            this.forLabels += 1;
        }
        keep(this.mem, &n.forBuf, &n.forLen, s);
    }

    /// The `for` of label `id` ("" for none).
    fn forOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.forBuf.ptr, len: n.forLen }) as string;
    }

    /// `role`: overrides the role the tag implies (copied).
    fn attrRole(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        keep(this.mem, &n.roleBuf, &n.roleLen, s);
    }

    /// The `aria-label` of `id` ("" for none).
    fn ariaOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.ariaBuf.ptr, len: n.ariaLen }) as string;
    }

    /// The `role` attribute of `id` ("" for none).
    fn roleOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.roleBuf.ptr, len: n.roleLen }) as string;
    }
}

