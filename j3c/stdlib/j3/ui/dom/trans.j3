// Part of j3.ui.dom (enter / leave transitions: `transition:` / `in:` / `out:`; state in `Dom.trns`); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Kind of the transition playing on `id` right now (`Trans.inK` / `outK` values; 0 none).
fn transKind(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    if n.trn < 0 || d.css.reduced {
        return 0;
    }
    let t = &d.trns.items[n.trn];
    if n.ghost {
        return t.outK;
    }
    if t.inK != 0 && d.now - n.fadeT0 < t.inMs {
        return t.inK;
    }
    return 0;
}

/// How much of `id` its running transition shows, 0..1 (eased; 1 outside a transition).
fn transAmt(d: &Dom, id: int): f32 {
    let k = transKind(d, id);
    if k == 0 {
        return 1.0;
    }
    let n = &d.nodes.items[id];
    let t = &d.trns.items[n.trn];
    let u = if n.ghost { (d.now - n.ghostT0) / t.outMs } else { (d.now - n.fadeT0) / t.inMs };
    let e = if t.ease >= 0 { t.ease } else if k == 1 { 1 } else { 3 };
    let v = anim.ease(&d.css.eases.items[e], min(1.0, max(0.0, u)));
    return if n.ghost { 1.0 - v } else { v };
}

/// Paint offset of a running `fly`, in px; 0 for anything else.
fn transDx(d: &Dom, id: int): f32 {
    if transKind(d, id) != 2 { return 0.0; }
    return d.trns.items[d.nodes.items[id].trn].fx * (1.0 - transAmt(d, id));
}

fn transDy(d: &Dom, id: int): f32 {
    if transKind(d, id) != 2 { return 0.0; }
    return d.trns.items[d.nodes.items[id].trn].fy * (1.0 - transAmt(d, id));
}

/// Scale of a running `scale` transition about the box center; 1 for anything else.
fn transScale(d: &Dom, id: int): f32 {
    if transKind(d, id) != 4 { return 1.0; }
    let sf = d.trns.items[d.nodes.items[id].trn].sf;
    return sf + (1.0 - sf) * transAmt(d, id);
}

/// Drop `id`'s transition record (its node is being freed): swap-remove, repointing the moved record's node.
fn untrans(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let i = n.trn;
    d.trns.len -= 1;
    if i < d.trns.len {
        d.trns.items[i] = d.trns.items[d.trns.len];
        d.nodes.items[d.trns.items[i].node].trn = i;
    }
    n.trn = -1;
}

/// A slide in flight changes the box's size in layout: the size the content gave it, times the amount shown.
/// Content stays at its natural place and is clipped by the (smaller) box, and siblings follow the size.
/// Called at the end of `layoutBox`.
fn slideSize(d: &Dom, id: int) {
    if transKind(d, id) != 3 {
        return;
    }
    let n = &d.nodes.items[id];
    let wide = d.trns.items[n.trn].axis == 1;
    let p = n.parent;
    if p >= 0 && d.nodes.items[p].disp == DP_FLEX && wide == flexRow(d, p) {
        return; // the flex line already sized this axis (`slideMain`)
    }
    let a = transAmt(d, id);
    if wide {
        n.w = n.w * a;
    } else {
        n.h = n.h * a;
    }
}

fn flexRow(d: &Dom, id: int): bool {
    let dir = kwOf(d, d.nodes.items[id].style, P_FLEX_DIRECTION);
    return dir != DIR_COLUMN && dir != DIR_COLUMN_REVERSE;
}

/// The part of its main size a sliding flex item shows in a container laid out as `row` (1 when it does not slide on that axis).
fn slideMain(d: &Dom, id: int, row: bool): f32 {
    if transKind(d, id) != 3 || (d.trns.items[d.nodes.items[id].trn].axis == 1) != row {
        return 1.0;
    }
    return transAmt(d, id);
}

/// Before layout: a box whose slide is in flight, or ended since last frame, is laid out again (and its ancestors,
/// so siblings follow). Idle cost: one compare per record, no layout once the slides are done.
fn stepSlides(d: &Dom) {
    for i in 0..d.trns.len {
        let t = &d.trns.items[i];
        let live = (t.inK == 3 || t.outK == 3) && transKind(d, t.node) == 3;
        if live || t.sliding {
            markDirty(d, t.node);
        }
        t.sliding = live;
    }
}

/// A node leaving as a ghost in `from..stop` of the sibling chain that has the slot, tag and scope of the element
/// `open` is about to create: it comes back instead of a second copy, entering from how much of it is still shown
/// (a linear estimate under easing). -1 when there is none.
fn reviveGhost(d: &Dom, from: int, stop: int, slot: int, tag: int, scope: int): int {
    let c = from;
    while c >= 0 && c != stop {
        let g = &d.nodes.items[c];
        if g.ghost && g.kind == K_ELEM && g.pe == 0 && g.trn >= 0 && g.slot == slot && g.tag == tag && g.scope == scope && ownsNode(d, c) {
            let t = &d.trns.items[g.trn];
            let shown = transAmt(d, c);
            if t.inK != 0 {
                g.fadeT0 = d.now - shown * t.inMs;
            }
            g.ghost = false;
            d.ghosts -= 1;
            d.mnodes.items[c].pe = 0;
            markStyle(d, c);
            markHas(d, c, 3, 0);
            markDirty(d, c);
            return c;
        }
        c = g.next;
    }
    return -1;
}
