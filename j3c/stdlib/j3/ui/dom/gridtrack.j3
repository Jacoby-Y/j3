// Part of j3.ui.dom (CSS grid: track lists and the scratch stack.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// A track list property (`P_GRID_COL0` ...): `o` the offset of its tracks in `Css.paints` (-1: none), `n` how many,
/// `fill` 0 listed, 1 `auto-fill`, 2 `auto-fit` (then `n` is the pattern length).
struct TrackList {
    o: int;
    n: int;
    fill: int;
}

/// One track: the minimum and the maximum as a kind (`V_PX` with px in `minV`/`maxV`, `V_AUTO`, and `V_FR` for the maximum) and a value.
struct Trk {
    minK: int;
    minV: f32;
    maxK: int;
    maxV: f32;
}

/// One axis of the grid being laid out. Its tracks live in `Dom.gs` from `o`, six arrays of `n` floats:
/// size, min-content and max-content contributions, growth limit, flex factor (-1: collapsed `auto-fit` track), start.
struct Axis {
    ls: TrackList;
    als: TrackList;
    nExp: int;
    n: int;
    o: int;
    fs: f32;
    avail: f32;
    gap: f32;
}

fn trackList(d: &Dom, st: int, prop: int): TrackList {
    let v = d.css.get(st, prop);
    if v.kind != V_LIST {
        return TrackList { o: -1, n: 0, fill: 0 };
    }
    return TrackList { o: v.i + 2, n: int(d.css.paints.items[v.i + 1]), fill: int(d.css.paints.items[v.i]) };
}

/// A stored track side as px, `V_AUTO` or `V_FR`: `em`/`rem` resolved, `%` of `avail` (auto when that is unknown, as in a browser).
fn trkSide(d: &Dom, k: int, f: f32, fs: f32, avail: f32): Value {
    if k == V_EM {
        return Value { kind: V_PX, f: f * fs, i: 0, c: 0 };
    }
    if k == V_REM {
        return Value { kind: V_PX, f: f * d.css.rootFs, i: 0, c: 0 };
    }
    if k == V_PCT {
        if avail < 0.0 {
            return Value { kind: V_AUTO, f: 0.0, i: 0, c: 0 };
        }
        return Value { kind: V_PX, f: f * avail / 100.0, i: 0, c: 0 };
    }
    return Value { kind: k, f: f, i: 0, c: 0 };
}

/// Track `t`: from the template while `t < nExp` (a repeating pattern when it is `auto-fill`), else from the implicit
/// track list (cycling), else `auto`.
fn trkAt(d: &Dom, ls: TrackList, als: TrackList, t: int, nExp: int, fs: f32, avail: f32): Trk {
    let o = -1;
    let idx = 0;
    // tracks only `grid-template-areas` makes explicit (past a shorter template list) are sized like implicit ones
    let tplN = if ls.o < 0 { 0 } else if ls.fill > 0 { nExp } else { ls.n };
    if t < tplN {
        o = ls.o;
        idx = if ls.fill > 0 { t % ls.n } else { t };
    } else if als.o >= 0 {
        o = als.o;
        idx = (t - tplN) % als.n;
    }
    if o < 0 {
        // a grid with no column list at all (`n` -1, set by the caller) has one `1fr` column, as it always did
        return Trk { minK: V_AUTO, minV: 0.0, maxK: if ls.n < 0 { V_FR } else { V_AUTO }, maxV: if ls.n < 0 { 1.0 } else { 0.0 } };
    }
    let q = o + idx * 4;
    let ps = d.css.paints.items;
    let mn = trkSide(d, int(ps[q]), ps[q + 1], fs, avail);
    let mx = trkSide(d, int(ps[q + 2]), ps[q + 3], fs, avail);
    return Trk { minK: mn.kind, minV: mn.f, maxK: mx.kind, maxV: mx.f };
}

/// The column list: `n` is -1 when there is neither a template nor `grid-auto-columns` (see `trkAt`).
fn columnList(d: &Dom, st: int): TrackList {
    let ls = trackList(d, st, P_GRID_COL0);
    if ls.o < 0 && trackList(d, st, P_GRID_ACOLS).o < 0 {
        ls.n = -1;
    }
    return ls;
}

/// `grid-template-areas`: `o` where the cells start in `Css.paints` (-1: none), `nr` rows, `nc` columns.
struct Areas {
    o: int;
    nr: int;
    nc: int;
}

fn areaTable(d: &Dom, st: int): Areas {
    let v = d.css.get(st, P_GRID_AREAS);
    if v.kind != V_LIST {
        return Areas { o: -1, nr: 0, nc: 0 };
    }
    return Areas { o: v.i + 2, nr: int(d.css.paints.items[v.i]), nc: int(d.css.paints.items[v.i + 1]) };
}

/// The column list as `columnList` gives it, but a grid with areas and no column list has `auto` columns, not one `1fr`.
fn columnListA(d: &Dom, st: int, ar: Areas): TrackList {
    let ls = columnList(d, st);
    if ar.o >= 0 && ls.n < 0 {
        ls.n = 0;
    }
    return ls;
}

/// The line (1 based) where the area `name` starts, or just past its end (`isEnd`); 0 when there is no such area.
fn areaLine(d: &Dom, ar: Areas, name: int, isCol: bool, isEnd: bool): int {
    let lo = 1000000;
    let hi = -1;
    for q in 0..ar.nr * ar.nc {
        if int(d.css.paints.items[ar.o + q]) == name {
            let ix = if isCol { q % ar.nc } else { q / ar.nc };
            lo = mini(lo, ix);
            hi = maxi(hi, ix);
        }
    }
    if hi < 0 {
        return 0;
    }
    return if isEnd { hi + 2 } else { lo + 1 };
}

/// A placement line that is an area name as the line it names (`auto` when there is no such area).
fn resolveLine(d: &Dom, ar: Areas, v: Value, isCol: bool, isEnd: bool): Value {
    if v.kind != V_STR {
        return v;
    }
    let l = if ar.o < 0 { 0 } else { areaLine(d, ar, v.i, isCol, isEnd) };
    if l == 0 {
        return Value { kind: V_AUTO, f: 0.0, i: 0, c: 0 };
    }
    return Value { kind: V_NUM, f: f32(l), i: 0, c: 0 };
}

/// Number of template tracks: the list, or for `auto-fill` / `auto-fit` as many repetitions as fit `avail` (one when it is unknown).
fn explicitCount(d: &Dom, ls: TrackList, fs: f32, avail: f32, gap: f32): int {
    if ls.o < 0 {
        return 0;
    }
    if ls.fill == 0 || avail < 0.0 {
        return ls.n;
    }
    // a repeated track counts as its maximum when that is a length, else its minimum (at least 1px)
    let per: f32 = 0.0;
    for i in 0..ls.n {
        let tr = trkAt(d, ls, ls, i, ls.n, fs, avail);
        per += max(1.0, if tr.maxK == V_PX { tr.maxV } else if tr.minK == V_PX { tr.minV } else { 0.0 });
    }
    let reps = int((avail + gap) / (per + gap * f32(ls.n)) + 0.0001);
    return maxi(1, mini(reps, MAX_TRACKS / ls.n)) * ls.n;
}

/// `n` zeroed floats on the `Dom.gs` stack (it grows by doubling); the caller gives them back by restoring `gTop`.
fn gsAlloc(d: &Dom, n: int): int {
    if d.gTop + n > d.gs.len {
        let bigger = d.mem.alloc::<f32>(maxi(d.gs.len * 2, d.gTop + n));
        for i in 0..d.gTop {
            bigger[i] = d.gs[i];
        }
        d.gs = bigger;
    }
    let o = d.gTop;
    d.gTop += n;
    for i in 0..n {
        d.gs[o + i] = 0.0;
    }
    return o;
}
