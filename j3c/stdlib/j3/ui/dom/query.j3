// Part of j3.ui.dom (focus, keyboard, click and drag queries, range value); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Move focus to `id` (-1 clears it): `:focus` matches it. A press focuses the `button` or
    /// `input` under the mouse, or clears focus when it lands elsewhere.
    fn focusNode(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if id >= 0 && !styleVisible(this, id) { return; }
        if id == this.focus {
            return;
        }
        let old = this.focus;
        if old >= 0 {
            this.setFlag(old, FL_FOCUS, false);
            this.setFlag(old, FL_FOCUS_VIS, false);
        }
        this.focus = id;
        aNote(this, EV_FOCUS, id);
        if id >= 0 {
            this.setFlag(id, FL_FOCUS, true);
            // browsers: keyboard focus shows, mouse focus does not, a text box always does
            if this.keyMode || isField(this, id) {
                this.setFlag(id, FL_FOCUS_VIS, true);
            }
            focusWithin(this, id, true, -1);
            if this.keyMode {
                this.reveal = id;
            }
        }
        // only the two parent chains restyle, and the part they share is not touched at all
        if old >= 0 {
            focusWithin(this, old, false, id);
        }
    }

    /// The last input was the keyboard (`true`: Tab, keys, a gamepad) or a pointer press (`false`). A focus that moves is
    /// `:focus-visible` when this is true; a key (`true`) also shows the ring on the node that already has focus, as in a browser
    /// (one restyle). `j3.ui.inputs` sets it from keys and presses, a gamepad layer calls it too. In one frame the press is
    /// handled by `beginFrame` and the keys by `inputs.begin`, so a press and a key together end in keyboard mode, ring on.
    fn setKeyboard(this: &Dom, on: bool) {
        this.keyMode = on;
        if on && this.focus >= 0 {
            this.setFlag(this.focus, FL_FOCUS_VIS, true);
        }
    }

    /// Whether the last input was the keyboard (see `setKeyboard`).
    fn keyboard(this: &Dom): bool {
        return this.keyMode;
    }

    /// The focused element matches `:focus-visible` (false with no focus).
    fn focusVisible(this: &Dom): bool {
        return this.focus >= 0 && (this.mnodes.items[this.focus].flags / FL_FOCUS_VIS) % 2 == 1;
    }

    /// The element with focus, or -1.
    fn focused(this: &Dom): int {
        return this.focus;
    }

    /// Delay `id`'s CSS `animation` by `ms` more (the markup attribute `anim-delay`), to stagger a list.
    fn animDelay(this: &Dom, id: int, ms: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].adelay = ms;
    }

    /// Box size in px.
    fn size(this: &Dom, id: int): Vec2 {
        id = this.resolve(id);
        if id == STALE { return Vec2 { x: 0.0, y: 0.0 }; }
        return Vec2 { x: this.nodes.items[id].w, y: this.nodes.items[id].h };
    }

    /// The press and release both landed on `id` (or a descendant of it, like a browser's bubbling)
    /// this frame, and the target was not disabled.
    fn clicked(this: &Dom, id: int): bool {
        if this.clickNode < 0 && this.clickTo < 0 { return false; }
        id = this.resolve(id);
        if id == STALE { return false; }
        return styleVisible(this, id) && (clickHit(this, this.clickNode, id) || clickHit(this, this.clickTo, id));
    }

    /// A button went down this frame on `id` or a descendant (bubbling like `clicked`), unless a node between the
    /// hit target and `id` has `on:mousedown|stop`; `downBtn` says which, left first when several did.
    fn mouseDown(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return bubbleHit(this, this.downHit, id, 8);
    }

    /// A button went up this frame over `id` or a descendant (bubbling, `on:mouseup|stop` ends it); `upBtn` says which.
    fn mouseUp(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return bubbleHit(this, this.upHit, id, 16);
    }

    /// The mouse moved this frame and `id` itself is under it.
    fn mouseMove(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.moved && hitIs(this, this.hover, id);
    }

    /// Wheel movement this frame when `id` itself is under the mouse (0 otherwise).
    fn wheelAt(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        if hitIs(this, this.hover, id) {
            return this.wheelV;
        }
        return 0.0;
    }

    /// Mouse position relative to the top left of `id`'s border box.
    fn localMouse(this: &Dom, id: int): Vec2 {
        id = this.resolve(id);
        if id == STALE { return Vec2 { x: 0.0, y: 0.0 }; }
        return Vec2 { x: this.mx - this.absX(id), y: this.my - this.absY(id) };
    }

    /// A press that began on `id` is held (or ended this frame): a range input being dragged.
    fn dragging(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.dragNode == id;
    }

    /// The range value under the mouse, clamped to `min`..`max` and snapped to `step`.
    fn rangeValue(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let n = &this.nodes.items[id];
        let r = n.h / 2.0;
        let span = n.w - 2.0 * r;
        let t: f32 = 0.0;
        if span > 0.0 {
            t = (this.mx - this.absX(id) - r) / span;
        }
        if t < 0.0 {
            t = 0.0;
        }
        if t > 1.0 {
            t = 1.0;
        }
        let v = n.attrMin + t * (n.attrMax - n.attrMin);
        if n.attrStep > 0.0 {
            let k = (v - n.attrMin) / n.attrStep + 0.5;
            v = n.attrMin + f32(int(k)) * n.attrStep;
        }
        return max(n.attrMin, min(n.attrMax, v));
    }

    /// Live nodes (ids in use).
    fn count(this: &Dom): int {
        return this.nodes.len - this.free.len;
    }
}

// ---- paint walk ------------------------------------------------------------------------------
