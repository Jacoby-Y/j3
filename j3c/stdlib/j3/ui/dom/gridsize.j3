// Part of j3.ui.dom (CSS grid: sizing the tracks of one axis.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// `repeat(auto-fit, ...)`: mark the template tracks no item touches as collapsed (flex factor -1): no size, no gap.
fn gridCollapse(d: &Dom, ax: Axis, b0: int, cnt: int, isCol: bool) {
    if ax.ls.fill != 2 {
        return;
    }
    let frO = ax.o + 4 * ax.n;
    for t in 0..ax.nExp {
        d.gs[frO + t] = -1.0;
    }
    for i in 0..cnt {
        let it1 = &d.fi[b0 + i];
        let a0 = if isCol { it1.c0 } else { it1.r0 };
        let a1 = if isCol { it1.c1 } else { it1.r1 };
        for t in a0..a1 {
            d.gs[frO + t] = 0.0;
        }
    }
}

/// Whether track `t` takes its size from its items (not a fixed length).
fn contentSized(d: &Dom, ax: Axis, t: int): bool {
    let tr = trkAt(d, ax.ls, ax.als, t, ax.nExp, ax.fs, ax.avail);
    return tr.minK == V_AUTO || tr.maxK != V_PX;
}

/// What each track's items ask for: `isCol` min/max-content widths, else the laid-out heights (`FItem.mm`). An item over several
/// tracks adds what the tracks it spans lack, evenly over those that size to content (not fixed lengths).
fn gridContrib(d: &Dom, ax: Axis, b0: int, cnt: int, isCol: bool) {
    let n = ax.n;
    let maxSpan = 1;
    for i in 0..cnt {
        let it1 = &d.fi[b0 + i];
        let a0 = if isCol { it1.c0 } else { it1.r0 };
        let len = (if isCol { it1.c1 } else { it1.r1 }) - a0;
        if len > 1 {
            maxSpan = maxi(maxSpan, len);
            continue;
        }
        let tr = trkAt(d, ax.ls, ax.als, a0, ax.nExp, ax.fs, ax.avail);
        if tr.minK == V_PX && tr.maxK == V_PX {
            continue;
        }
        let cmin = ax.o + n + a0;
        let cmax = ax.o + 2 * n + a0;
        d.gs[cmin] = max(d.gs[cmin], if isCol { outerMinMax(d, it1.id, false) } else { it1.mm });
        d.gs[cmax] = max(d.gs[cmax], if isCol { outerMinMax(d, it1.id, true) } else { it1.mm });
    }
    for sp in 2..(maxSpan + 1) {
        for i in 0..cnt {
            let it2 = &d.fi[b0 + i];
            let s0 = if isCol { it2.c0 } else { it2.r0 };
            let s1 = if isCol { it2.c1 } else { it2.r1 };
            if s1 - s0 != sp {
                continue;
            }
            let k = 0;
            for t in s0..s1 {
                if contentSized(d, ax, t) {
                    k += 1;
                }
            }
            if k == 0 {
                continue;
            }
            for pass in 0..2 {
                let arr = ax.o + (1 + pass) * n;
                let v = if isCol { outerMinMax(d, it2.id, pass == 1) } else { it2.mm };
                let cur = ax.gap * f32(sp - 1);
                for t in s0..s1 {
                    // a fixed track is its length whatever the items ask
                    cur += if contentSized(d, ax, t) { d.gs[arr + t] } else { trkAt(d, ax.ls, ax.als, t, ax.nExp, ax.fs, ax.avail).maxV };
                }
                if v - cur > 0.01 {
                    let each = (v - cur) / f32(k);
                    for t in s0..s1 {
                        if contentSized(d, ax, t) {
                            d.gs[arr + t] += each;
                        }
                    }
                }
            }
        }
    }
}

/// Size the tracks of `ax` from their contributions and `avail` (-1: unknown, then a track is its growth limit and `fr` is `auto`);
/// the total with gaps. A track is its minimum, grows equally toward its maximum while there is room, then `fr` tracks share the
/// rest (`fr` of a sum under 1 takes that part), each at least its minimum. A plain `auto` track is its max-content (it does not
/// shrink to its min-content or stretch to fill).
fn gridSize(d: &Dom, ax: Axis): f32 {
    let n = ax.n;
    if n == 0 {
        return 0.0;
    }
    let szO = ax.o;
    let cminO = ax.o + n;
    let cmaxO = ax.o + 2 * n;
    let limO = ax.o + 3 * n;
    let frO = ax.o + 4 * n;
    let posO = ax.o + 5 * n;
    let present = 0;
    for t in 0..n {
        if d.gs[frO + t] < 0.0 {
            continue;
        }
        present += 1;
        let tr = trkAt(d, ax.ls, ax.als, t, ax.nExp, ax.fs, ax.avail);
        let fr: f32 = 0.0;
        if tr.maxK == V_FR {
            if ax.avail < 0.0 {
                tr.maxK = V_AUTO;
            } else {
                fr = tr.maxV;
            }
        }
        let b: f32 = 0.0;
        if tr.minK == V_PX {
            b = tr.minV;
        } else if tr.maxK == V_AUTO && tr.minK == V_AUTO {
            b = d.gs[cmaxO + t];
        } else {
            b = d.gs[cminO + t];
        }
        let lim = b;
        if tr.maxK == V_PX {
            lim = max(b, tr.maxV);
        } else if tr.maxK == V_AUTO {
            lim = max(b, d.gs[cmaxO + t]);
        }
        d.gs[szO + t] = b;
        d.gs[limO + t] = lim;
        d.gs[frO + t] = fr;
    }
    let gaps: f32 = 0.0;
    if present > 1 {
        gaps = ax.gap * f32(present - 1);
    }
    if ax.avail < 0.0 {
        for t in 0..n {
            if d.gs[frO + t] >= 0.0 {
                d.gs[szO + t] = d.gs[limO + t];
            }
        }
    } else {
        let free = ax.avail - gaps;
        for t in 0..n {
            if d.gs[frO + t] >= 0.0 {
                free -= d.gs[szO + t];
            }
        }
        let guard = 0;
        // ponytail: at most 32 rounds of equal sharing (exact when every track reaches its limit in a few); sort by limit for exactness
        while free > 0.01 && guard < 32 {
            guard += 1;
            let k = 0;
            for t in 0..n {
                if d.gs[frO + t] >= 0.0 && d.gs[szO + t] < d.gs[limO + t] - 0.01 {
                    k += 1;
                }
            }
            if k == 0 {
                break;
            }
            let share = free / f32(k);
            for t in 0..n {
                if d.gs[frO + t] >= 0.0 && d.gs[szO + t] < d.gs[limO + t] - 0.01 {
                    let add = min(share, d.gs[limO + t] - d.gs[szO + t]);
                    d.gs[szO + t] += add;
                    free -= add;
                }
            }
        }
        let sumF: f32 = 0.0;
        let fixed: f32 = 0.0;
        for t in 0..n {
            if d.gs[frO + t] > 0.0 {
                sumF += d.gs[frO + t];
            } else if d.gs[frO + t] == 0.0 {
                fixed += d.gs[szO + t];
            }
        }
        if sumF > 0.0 {
            let left = ax.avail - gaps - fixed;
            // a flexible track whose minimum beats its share is fixed at the minimum (growth limit -1 marks it), then the rest share again
            for pass in 0..n {
                let sf: f32 = 0.0;
                let lf = left;
                for t in 0..n {
                    if d.gs[frO + t] > 0.0 {
                        if d.gs[limO + t] < 0.0 {
                            lf -= d.gs[szO + t];
                        } else {
                            sf += d.gs[frO + t];
                        }
                    }
                }
                let hyp: f32 = 0.0;
                if sf > 0.0 {
                    hyp = max(lf, 0.0) / max(sf, 1.0);
                }
                let changed = false;
                for t in 0..n {
                    if d.gs[frO + t] > 0.0 && d.gs[limO + t] >= 0.0 && d.gs[frO + t] * hyp < d.gs[szO + t] - 0.01 {
                        d.gs[limO + t] = -1.0;
                        changed = true;
                    }
                }
                if !changed {
                    for t in 0..n {
                        if d.gs[frO + t] > 0.0 && d.gs[limO + t] >= 0.0 {
                            d.gs[szO + t] = d.gs[frO + t] * hyp;
                        }
                    }
                    break;
                }
            }
        }
    }
    let x: f32 = 0.0;
    for t in 0..n {
        d.gs[posO + t] = x;
        if d.gs[frO + t] >= 0.0 {
            x += d.gs[szO + t] + ax.gap;
        }
    }
    if present == 0 {
        return 0.0;
    }
    return x - ax.gap;
}

/// Start and size of the area over tracks `a0..a1` of the axis at `o` (`n` tracks).
fn areaStart(d: &Dom, o: int, n: int, a0: int): f32 {
    return d.gs[o + 5 * n + a0];
}

fn areaSize(d: &Dom, o: int, n: int, a0: int, a1: int): f32 {
    return d.gs[o + 5 * n + a1 - 1] + d.gs[o + a1 - 1] - d.gs[o + 5 * n + a0];
}

fn gridAxis(d: &Dom, ls: TrackList, als: TrackList, nExp: int, n: int, fs: f32, avail: f32, gap: f32): Axis {
    return Axis { ls: ls, als: als, nExp: nExp, n: n, o: gsAlloc(d, 6 * n), fs: fs, avail: avail, gap: gap };
}
