// Part of j3.ui.dom (Computed-style value readers, scroll and clip state.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn vi(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.i;
}

fn vf(d: &Dom, st: int, prop: int): f32 {
    let v = d.css.get(st, prop);
    return v.f;
}

fn vkind(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.kind;
}

/// `v` with a `calc()` / viewport length resolved to px against `basis` (negative: unknown). `auto`
/// when it needs a basis it lacks or its math fails, like an unresolvable percentage.
fn lenVal(d: &Dom, v: Value, basis: f32): Value {
    if v.kind != V_CALC {
        return v;
    }
    let r: f32 = 0.0;
    if calcEval(d.css, v, basis, &r) {
        return Value { kind: V_PX, f: r, i: 0, c: 0 };
    }
    return Value { kind: V_AUTO, f: 0.0, i: 0, c: 0 };
}

fn numOf(d: &Dom, st: int, prop: int): f32 {
    let v = lenVal(d, d.css.get(st, prop), -1.0);
    if v.kind == V_NUM || v.kind == V_PX {
        return v.f;
    }
    return 0.0;
}

pub fn kwOf(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.i;
}

/// Margin/padding/border in px (percent of `basis` when known; auto and the rest are 0).
fn edgeOf(d: &Dom, st: int, prop: int, basis: f32): f32 {
    let v = lenVal(d, d.css.get(st, prop), basis);
    if v.kind == V_PX {
        return v.f;
    }
    if v.kind == V_PCT && basis >= 0.0 {
        return basis * v.f / 100.0;
    }
    return 0.0;
}

/// Is the margin on `side` (0 top, 1 right, 2 bottom, 3 left) `auto`? `edgeOf` counts it as 0; layout hands it the free space.
pub fn autoM(d: &Dom, st: int, side: int): bool {
    return d.css.get(st, P_MARGIN_TOP + side).kind == V_AUTO;
}

pub fn edgesOf(d: &Dom, st: int, basis: f32): Edges {
    return Edges {
        pl: edgeOf(d, st, P_PADDING_TOP + 3, basis), pr: edgeOf(d, st, P_PADDING_TOP + 1, basis),
        pt: edgeOf(d, st, P_PADDING_TOP, basis), pb: edgeOf(d, st, P_PADDING_TOP + 2, basis),
        bl: edgeOf(d, st, P_BORDER_TOP_WIDTH + 3, basis), br: edgeOf(d, st, P_BORDER_TOP_WIDTH + 1, basis),
        bt: edgeOf(d, st, P_BORDER_TOP_WIDTH, basis), bb: edgeOf(d, st, P_BORDER_TOP_WIDTH + 2, basis),
        ml: edgeOf(d, st, P_MARGIN_TOP + 3, basis), mr: edgeOf(d, st, P_MARGIN_TOP + 1, basis),
        mt: edgeOf(d, st, P_MARGIN_TOP, basis), mb: edgeOf(d, st, P_MARGIN_TOP + 2, basis),
    };
}

/// A width/height style as a border-box size; UNDEF for auto, or a percentage of an unknown basis.
fn sizeOf(d: &Dom, st: int, prop: int, basis: f32, extra: f32): f32 {
    let v = lenVal(d, d.css.get(st, prop), basis);
    let r = UNDEF;
    if v.kind == V_PX {
        r = v.f;
    } else if v.kind == V_PCT && basis >= 0.0 {
        r = basis * v.f / 100.0;
    } else {
        return UNDEF;
    }
    if kwOf(d, st, P_BOX_SIZING) == BOX_CONTENT {
        r += extra;
    }
    return r;
}

/// `aspect-ratio` (width over height), 0 for `auto`.
fn ratioOf(d: &Dom, st: int): f32 {
    let v = d.css.get(st, P_ASPECT_RATIO);
    return if v.kind == V_NUM { v.f } else { 0.0 };
}

fn specW(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    let w = sizeOf(d, st, P_WIDTH, basis, e.pl + e.pr + e.bl + e.br);
    if w < 0.0 {
        // an auto width follows a length height through the ratio (a height in % of an unknown basis stays auto)
        let ar = ratioOf(d, st);
        if ar > 0.0 {
            let h = sizeOf(d, st, P_HEIGHT, -1.0, e.pt + e.pb + e.bt + e.bb);
            if h >= 0.0 {
                return h * ar;
            }
        }
    }
    return w;
}

fn specH(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_HEIGHT, basis, e.pt + e.pb + e.bt + e.bb);
}

fn minWOf(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_MIN_WIDTH, basis, e.pl + e.pr + e.bl + e.br);
}

fn minHOf(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_MIN_HEIGHT, basis, e.pt + e.pb + e.bt + e.bb);
}

/// Clamp a border-box dimension; minimums beat maximums.
fn limitSize(d: &Dom, st: int, value: f32, basis: f32, e: Edges, row: bool): f32 {
    let extra = if row { e.pl + e.pr + e.bl + e.br } else { e.pt + e.pb + e.bt + e.bb };
    let mn = sizeOf(d, st, if row { P_MIN_WIDTH } else { P_MIN_HEIGHT }, basis, extra);
    let mx = sizeOf(d, st, if row { P_MAX_WIDTH } else { P_MAX_HEIGHT }, basis, extra);
    let result = if mx >= 0.0 { min(value, mx) } else { value };
    // Virtual lists use oversized padding as spacers: retain border-box padding overflow.
    return max(max(result, mn), 0.0);
}

fn flexGrow(d: &Dom, st: int): f32 {
    let v = d.css.get(st, P_FLEX);
    if v.kind == V_NUM {
        return v.f;
    }
    return 0.0;
}

/// Something scrolled: with overlays open, lay out again so popovers placed from a scrolled anchor follow it.
fn scrolled(d: &Dom) {
    if d.ovs.len > 0 && d.nodes.len > 0 {
        d.nodes.items[0].dirty = true;
    }
}

/// The computed `overflow-x` / `overflow-y` (`prop`): a `visible` or `clip` axis next to a scrolling one (hidden, auto,
/// scroll) becomes `auto` or `hidden`, as in a browser. `clip` next to `visible` stays, so it clips one axis only.
fn ovOf(d: &Dom, st: int, prop: int): int {
    let k = kwOf(d, st, prop);
    let o = kwOf(d, st, if prop == P_OVERFLOW_X { P_OVERFLOW_Y } else { P_OVERFLOW_X });
    if o == OVERFLOW_VISIBLE || o == OVERFLOW_CLIP {
        return k;
    }
    if k == OVERFLOW_VISIBLE { return OVERFLOW_AUTO; }
    if k == OVERFLOW_CLIP { return OVERFLOW_HIDDEN; }
    return k;
}

/// Whether the box is a scroll container on an axis (`hidden`, `auto`, `scroll`: it has a scroll offset there).
fn isScrollOn(d: &Dom, st: int, prop: int): bool {
    let k = ovOf(d, st, prop);
    return k != OVERFLOW_VISIBLE && k != OVERFLOW_CLIP;
}

/// A scroll container: `hidden`, `auto` or `scroll` on either axis.
pub fn isScroll(d: &Dom, st: int): bool {
    return isScrollOn(d, st, P_OVERFLOW_Y) || isScrollOn(d, st, P_OVERFLOW_X);
}

/// Whether the box clips its content on an axis (anything but `visible`).
fn clipsOn(d: &Dom, st: int, prop: int): bool {
    return ovOf(d, st, prop) != OVERFLOW_VISIBLE;
}

/// A box that clips on either axis (scroll containers and `clip`).
pub fn isClip(d: &Dom, st: int): bool {
    return clipsOn(d, st, P_OVERFLOW_Y) || clipsOn(d, st, P_OVERFLOW_X);
}

/// Whether the point `(x, y)` of a clipping box `w` by `h` is inside the clip: an axis that does not clip lets any value in.
fn inClip(d: &Dom, st: int, x: f32, y: f32, w: f32, h: f32): bool {
    return (!clipsOn(d, st, P_OVERFLOW_X) || (x >= 0.0 && x < w)) && (!clipsOn(d, st, P_OVERFLOW_Y) || (y >= 0.0 && y < h));
}

/// Whether the wheel and scrollbars move the box on an axis (`auto` or `scroll`; `hidden` only by code).
fn scrollsOn(d: &Dom, st: int, prop: int): bool {
    let k = ovOf(d, st, prop);
    return k == OVERFLOW_AUTO || k == OVERFLOW_SCROLL;
}

/// The scrollbars of box `id` (nothing shows when `scrollbar-width: none`).
pub fn barsOf(d: &Dom, id: int): Bars {
    let n = &d.nodes.items[id];
    let st = n.style;
    let t = scrollbar.thickness(kwOf(d, st, P_SB_WIDTH));
    let ky = ovOf(d, st, P_OVERFLOW_Y);
    let kx = ovOf(d, st, P_OVERFLOW_X);
    return Bars {
        w: n.w, h: n.h, t: t,
        showX: t > 0.0 && (kx == OVERFLOW_SCROLL || (kx == OVERFLOW_AUTO && n.scrollMaxX > 0.0)),
        showY: t > 0.0 && (ky == OVERFLOW_SCROLL || (ky == OVERFLOW_AUTO && n.scrollMax > 0.0)),
        offX: n.scrollX, maxX: n.scrollMaxX, contX: n.contentW,
        offY: n.scrollY, maxY: n.scrollMax, contY: n.contentH,
    };
}

/// Whether `id` is a `display: contents` element that flattens: only under a grid (or another flattened
/// contents element); anywhere else it lays out as a plain block.
fn isFlat(d: &Dom, id: int): bool {
    while d.nodes.items[id].disp == DP_CONTENTS {
        let p = d.nodes.items[id].parent;
        if p < 0 {
            return false;
        }
        if d.nodes.items[p].disp == DP_GRID {
            return true;
        }
        id = p;
    }
    return false;
}

/// Right edge of what `id` holds (children boxes and its own text lines), px from its left border edge.
fn contentRight(d: &Dom, id: int): f32 {
    let r: f32 = 0.0;
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let k = &d.nodes.items[c];
        if k.kind == K_ELEM && isFlat(d, c) {
            r = max(r, contentRight(d, c));
        } else if k.kind == K_ELEM && k.disp != DP_NONE && !k.isAbs {
            r = max(r, k.x + k.w);
        }
        c = k.next;
    }
    let f = d.nodes.items[id].frag0;
    while f >= 0 {
        r = max(r, d.frags.items[f].x + d.frags.items[f].w);
        f = d.frags.items[f].next;
    }
    return r;
}

/// Px past a scroll box's viewport at which children are skipped by paint and hit testing.
const CULL: f32 = 400.0;

/// Whether child `c` of scroll box `p` is far outside its viewport (so it need not paint or be hit).
fn farOff(d: &Dom, p: int, c: int): bool {
    // a `display: contents` node has no box; its children are items of the nearest real ancestor
    while isFlat(d, p) {
        p = d.nodes.items[p].parent;
    }
    let pn = &d.nodes.items[p];
    let cn = &d.nodes.items[c];
    if isFlat(d, c) || cn.isAbs || cn.isStk || !isClip(d, pn.style) {
        return false;
    }
    let cy = clipsOn(d, pn.style, P_OVERFLOW_Y);
    let cx = clipsOn(d, pn.style, P_OVERFLOW_X);
    let far = (cy && (cn.y + cn.h < pn.scrollY - CULL || cn.y > pn.scrollY + pn.h + CULL)) || (cx && (cn.x + cn.w < pn.scrollX - CULL || cn.x > pn.scrollX + pn.w + CULL));
    // a transform can bring a far box back into view
    if !far {
        return false;
    }
    let xf = xform.of(d.css, cn.style, cn.w, cn.h);
    return !xf.on;
}

fn skipped(d: &Dom, id: int): bool {
    return d.nodes.items[id].disp == DP_NONE || d.nodes.items[id].isAbs;
}

fn inlineLevel(d: &Dom, id: int): bool {
    if d.nodes.items[id].kind == K_TEXT {
        return true;
    }
    let dp = d.nodes.items[id].disp;
    return dp == DP_INLINE || dp == DP_INLINE_BLOCK;
}
