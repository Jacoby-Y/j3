// Part of j3.ui.dom (Style resolution for nodes, value accessors, scroll queries, fonts.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn tagDisplay(d: &Dom, tag: int): int {
    let nm = d.css.name(tag);
    if same(nm, "div") || same(nm, "dialog") || same(nm, "aside") || same(nm, "section") || same(nm, "header") || same(nm, "main") || same(nm, "nav") || same(nm, "root") {
        return DP_BLOCK;
    }
    if same(nm, "p") || same(nm, "h1") || same(nm, "h2") || same(nm, "h3") || same(nm, "h4") || same(nm, "h5") || same(nm, "h6") || same(nm, "dl") || same(nm, "dt") || same(nm, "dd") || same(nm, "label") {
        return DP_BLOCK;
    }
    if same(nm, "ul") || same(nm, "ol") || same(nm, "li") || same(nm, "hr") || same(nm, "pre") || same(nm, "details") || same(nm, "summary") {
        return DP_BLOCK;
    }
    if same(nm, "button") || same(nm, "input") || same(nm, "canvas") || same(nm, "select") || same(nm, "img") || same(nm, "svg") || same(nm, "progress") || same(nm, "meter") || same(nm, "glyph") {
        return DP_INLINE_BLOCK;
    }
    if same(nm, "option") || same(nm, "path") {
        return DP_NONE;
    }
    return DP_INLINE;
}

/// The `Dyn` of `id`, taken from the pool on first use.
fn dynOf(d: &Dom, id: int): &Dyn {
    let n = &d.nodes.items[id];
    if n.dyn < 0 {
        if d.dynFree.len > 0 {
            d.dynFree.len -= 1;
            n.dyn = d.dynFree.items[d.dynFree.len].v;
            dynattr.reset(&d.dyns.items[n.dyn]);
        } else {
            n.dyn = d.dyns.len;
            d.dyns.push(dynattr.new(d.mem));
        }
    }
    return &d.dyns.items[n.dyn];
}

/// Cascade style `base` of `id` with its `style:` overrides on top. The result is a style id owned by
/// the node (two, alternating: the previous one must stay readable for the transition from it).
fn inlineStyle(d: &Dom, id: int, base: int, ps: int): int {
    let n = &d.nodes.items[id];
    let y = &d.dyns.items[n.dyn];
    if !y.dirty && y.base == base && y.cur >= 0 && y.cur == n.tstyle {
        return y.cur;
    }
    let dst = 0;
    if y.cur >= 0 && y.cur == y.a {
        if y.b < 0 {
            y.b = dynattr.alloc(d.css);
        }
        dst = y.b;
    } else {
        if y.a < 0 {
            y.a = dynattr.alloc(d.css);
        }
        dst = y.a;
    }
    if dynattr.build(d.css, y, base, ps, dst) {
        // children cached under this id inherited the old values
        d.css.clearCache();
    }
    y.base = base;
    y.cur = dst;
    y.dirty = false;
    return dst;
}

fn applyStyle(d: &Dom, id: int, ps: int) {
    d.restyled += 1;
    countRestyled();
    let st = computeStyle(d.css, d.mnodes.items, id, ps);
    let n = &d.nodes.items[id];
    if n.dyn >= 0 && n.kind == K_ELEM {
        st = inlineStyle(d, id, st, ps);
    }
    if id == 0 { d.css.rootFs = d.css.get(st, P_FONT_SIZE).f; }
    let changed = st != n.tstyle;
    let old = n.tstyle;
    n.tstyle = st;
    if n.kind == K_ELEM && (changed || old < 0) {
        moveStyle(d, id, old, st);
    } else if n.kind != K_ELEM {
        n.style = st;
    }
    let dv = d.css.get(st, P_DISPLAY);
    let ds = tagDisplay(d, n.tag);
    if dv.i == DISPLAY_FLEX {
        ds = DP_FLEX;
    } else if dv.i == DISPLAY_GRID {
        ds = DP_GRID;
    } else if dv.i == DISPLAY_NONE {
        ds = DP_NONE;
    } else if dv.i == DISPLAY_CONTENTS && n.kind == K_ELEM {
        ds = DP_CONTENTS;
    } else if dv.i == DISPLAY_BLOCK {
        ds = DP_BLOCK;
    }
    if n.pe != 0 && n.kind == K_ELEM {
        // the box shows `content: "text"`; without it there is no box
        let cv = d.css.get(st, P_CONTENT);
        let tx = n.first;
        if cv.kind == V_STR && tx >= 0 {
            if storeBytes(d, &d.nodes.items[tx], d.css.name(cv.i)) {
                markDirty(d, tx);
            }
        } else {
            ds = DP_NONE;
            if tx >= 0 && storeBytes(d, &d.nodes.items[tx], "") {
                markDirty(d, tx);
            }
        }
    }
    if n.pe == 0 && n.parent >= 0 && n.tag != d.tSummary && d.nodes.items[n.parent].tag == d.tDetails && !d.isOpen(n.parent) {
        // a closed `<details>` shows only its `<summary>`; the rest stays mounted (state kept), just not displayed
        ds = DP_NONE;
    }
    if ds != n.disp {
        changed = true;
    }
    n.disp = ds;
    let pv = d.css.get(st, P_POSITION);
    let wantStk = pv.i == POS_STICKY && n.kind == K_ELEM;
    if wantStk && !n.isStk {
        n.isStk = true;
        d.stk.push(Idx { v: id });
    } else if !wantStk && n.isStk {
        n.isStk = false;
        n.sy = 0.0;
    }
    let isDialog = n.tag == d.tDialog;
    let isOv = n.ov != 0 || n.rt;
    let wantAbs = (pv.i == POS_ABSOLUTE || pv.i == POS_FIXED || isDialog || isOv) && n.kind == K_ELEM;
    // viewport coordinates, painted past the ancestors' clips: fixed boxes, dialogs, popovers and runtime popups
    n.isFixed = wantAbs && (pv.i == POS_FIXED || isDialog || isOv);
    if wantAbs && !n.isAbs {
        n.isAbs = true;
        d.abs.push(Idx { v: id });
    } else if !wantAbs && n.isAbs {
        dropAbs(d, id);
    }
    if changed {
        markDirty(d, id);
    }
}

/// Recompute the styles that are dirty. `force` means an ancestor's style id changed or was restyled.
fn resolveNode(d: &Dom, id: int, ps: int, force: bool) {
    let need = force || d.nodes.items[id].styleDirty;
    if !need && !d.nodes.items[id].subStyle {
        return;
    }
    // a restyle only a `:has()` flip asked for leaves the subtree alone when this node's style id did not change
    let kids = need;
    if need {
        let old = d.nodes.items[id].tstyle;
        let lite = !force && d.nodes.items[id].hasOnly && d.css.hasInner == 0;
        applyStyle(d, id, ps);
        if lite && d.nodes.items[id].tstyle == old {
            kids = false;
        }
        if (d.css.peRules.len > 0 || d.npe > 0) && d.nodes.items[id].kind == K_ELEM && d.nodes.items[id].pe == 0 {
            syncPseudo(d, id);
        }
    }
    d.nodes.items[id].styleDirty = false;
    d.nodes.items[id].kidsMk = false;
    d.nodes.items[id].hasOnly = false;
    d.nodes.items[id].subStyle = false;
    let st = d.nodes.items[id].tstyle;
    let c = d.nodes.items[id].first;
    while c >= 0 {
        resolveNode(d, c, st, kids);
        c = d.nodes.items[c].next;
    }
}

/// Make or drop the `::before` / `::after` boxes of `host` after its style was applied. A box exists while some such rule
/// matches the host (`content: none` then makes it `display: none`, see `applyStyle`); it is a ghost-flagged child
/// (`Node.pe`) holding one text node, first for `::before` and last for `::after` (`insertBefore` keeps it last).
/// Cost: one `matchRule` per `::before`/`::after` rule per restyled element; nothing when nothing restyles.
fn syncPseudo(d: &Dom, host: int) {
    for k in 1..3 {
        let want = false;
        for i in 0..d.css.peRules.len {
            let r = &d.css.rules.items[d.css.peRules.items[i]];
            if r.pe == k && peHolds(d.css, r, d.mnodes.items, host) {
                want = true;
                break;
            }
        }
        let f = d.nodes.items[host].first;
        let l = d.nodes.items[host].last;
        let cur = -1;
        if k == 1 && f >= 0 && d.nodes.items[f].pe == 1 {
            cur = f;
        } else if k == 2 && l >= 0 && d.nodes.items[l].pe == 2 {
            cur = l;
        }
        if want && cur < 0 {
            let id = newNode(d, K_ELEM, if k == 1 { d.tBefore } else { d.tAfter }, 0, d.mnodes.items[host].scope);
            d.nodes.items[id].pe = k;
            d.npe += 1;
            d.nodes.items[id].ghost = true;
            d.mnodes.items[id].pe = k;
            insertBefore(d, host, id, if k == 1 { f } else { -1 });
            let tx = newNode(d, K_TEXT, d.tText, -1, 0);
            insertBefore(d, id, tx, -1);
        } else if !want && cur >= 0 {
            dropNode(d, cur);
        }
    }
}

fn resolveStyles(d: &Dom) {
    if d.nodes.len > 0 {
        beginPass(d.css, d.nodes.len);
        resolveNode(d, 0, -1, false);
        endPass(d.css);
    }
}

fn vi(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.i;
}

fn vf(d: &Dom, st: int, prop: int): f32 {
    let v = d.css.get(st, prop);
    return v.f;
}

fn vkind(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.kind;
}

/// `v` with a `calc()` / viewport length resolved to px against `basis` (negative: unknown). `auto`
/// when it needs a basis it lacks or its math fails, like an unresolvable percentage.
fn lenVal(d: &Dom, v: Value, basis: f32): Value {
    if v.kind != V_CALC {
        return v;
    }
    let r: f32 = 0.0;
    if calcEval(d.css, v, basis, &r) {
        return Value { kind: V_PX, f: r, i: 0, c: 0 };
    }
    return Value { kind: V_AUTO, f: 0.0, i: 0, c: 0 };
}

fn numOf(d: &Dom, st: int, prop: int): f32 {
    let v = lenVal(d, d.css.get(st, prop), -1.0);
    if v.kind == V_NUM || v.kind == V_PX {
        return v.f;
    }
    return 0.0;
}

pub fn kwOf(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    return v.i;
}

/// Margin/padding/border in px (percent of `basis` when known; auto and the rest are 0).
fn edgeOf(d: &Dom, st: int, prop: int, basis: f32): f32 {
    let v = lenVal(d, d.css.get(st, prop), basis);
    if v.kind == V_PX {
        return v.f;
    }
    if v.kind == V_PCT && basis >= 0.0 {
        return basis * v.f / 100.0;
    }
    return 0.0;
}

/// Is the margin on `side` (0 top, 1 right, 2 bottom, 3 left) `auto`? `edgeOf` counts it as 0; layout hands it the free space.
pub fn autoM(d: &Dom, st: int, side: int): bool {
    return d.css.get(st, P_MARGIN_TOP + side).kind == V_AUTO;
}

pub fn edgesOf(d: &Dom, st: int, basis: f32): Edges {
    return Edges {
        pl: edgeOf(d, st, P_PADDING_TOP + 3, basis), pr: edgeOf(d, st, P_PADDING_TOP + 1, basis),
        pt: edgeOf(d, st, P_PADDING_TOP, basis), pb: edgeOf(d, st, P_PADDING_TOP + 2, basis),
        bl: edgeOf(d, st, P_BORDER_TOP_WIDTH + 3, basis), br: edgeOf(d, st, P_BORDER_TOP_WIDTH + 1, basis),
        bt: edgeOf(d, st, P_BORDER_TOP_WIDTH, basis), bb: edgeOf(d, st, P_BORDER_TOP_WIDTH + 2, basis),
        ml: edgeOf(d, st, P_MARGIN_TOP + 3, basis), mr: edgeOf(d, st, P_MARGIN_TOP + 1, basis),
        mt: edgeOf(d, st, P_MARGIN_TOP, basis), mb: edgeOf(d, st, P_MARGIN_TOP + 2, basis),
    };
}

/// A width/height style as a border-box size; UNDEF for auto, or a percentage of an unknown basis.
fn sizeOf(d: &Dom, st: int, prop: int, basis: f32, extra: f32): f32 {
    let v = lenVal(d, d.css.get(st, prop), basis);
    let r = UNDEF;
    if v.kind == V_PX {
        r = v.f;
    } else if v.kind == V_PCT && basis >= 0.0 {
        r = basis * v.f / 100.0;
    } else {
        return UNDEF;
    }
    if kwOf(d, st, P_BOX_SIZING) == BOX_CONTENT {
        r += extra;
    }
    return r;
}

/// `aspect-ratio` (width over height), 0 for `auto`.
fn ratioOf(d: &Dom, st: int): f32 {
    let v = d.css.get(st, P_ASPECT_RATIO);
    return if v.kind == V_NUM { v.f } else { 0.0 };
}

fn specW(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    let w = sizeOf(d, st, P_WIDTH, basis, e.pl + e.pr + e.bl + e.br);
    if w < 0.0 {
        // an auto width follows a length height through the ratio (a height in % of an unknown basis stays auto)
        let ar = ratioOf(d, st);
        if ar > 0.0 {
            let h = sizeOf(d, st, P_HEIGHT, -1.0, e.pt + e.pb + e.bt + e.bb);
            if h >= 0.0 {
                return h * ar;
            }
        }
    }
    return w;
}

fn specH(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_HEIGHT, basis, e.pt + e.pb + e.bt + e.bb);
}

fn minWOf(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_MIN_WIDTH, basis, e.pl + e.pr + e.bl + e.br);
}

fn minHOf(d: &Dom, st: int, basis: f32, e: Edges): f32 {
    return sizeOf(d, st, P_MIN_HEIGHT, basis, e.pt + e.pb + e.bt + e.bb);
}

/// Clamp a border-box dimension; minimums beat maximums.
fn limitSize(d: &Dom, st: int, value: f32, basis: f32, e: Edges, row: bool): f32 {
    let extra = if row { e.pl + e.pr + e.bl + e.br } else { e.pt + e.pb + e.bt + e.bb };
    let mn = sizeOf(d, st, if row { P_MIN_WIDTH } else { P_MIN_HEIGHT }, basis, extra);
    let mx = sizeOf(d, st, if row { P_MAX_WIDTH } else { P_MAX_HEIGHT }, basis, extra);
    let result = if mx >= 0.0 { min(value, mx) } else { value };
    // Virtual lists use oversized padding as spacers: retain border-box padding overflow.
    return max(max(result, mn), 0.0);
}

fn flexGrow(d: &Dom, st: int): f32 {
    let v = d.css.get(st, P_FLEX);
    if v.kind == V_NUM {
        return v.f;
    }
    return 0.0;
}

/// Something scrolled: with overlays open, lay out again so popovers placed from a scrolled anchor follow it.
fn scrolled(d: &Dom) {
    if d.ovs.len > 0 && d.nodes.len > 0 {
        d.nodes.items[0].dirty = true;
    }
}

/// The computed `overflow-x` / `overflow-y` (`prop`): a `visible` or `clip` axis next to a scrolling one (hidden, auto,
/// scroll) becomes `auto` or `hidden`, as in a browser. `clip` next to `visible` stays, so it clips one axis only.
fn ovOf(d: &Dom, st: int, prop: int): int {
    let k = kwOf(d, st, prop);
    let o = kwOf(d, st, if prop == P_OVERFLOW_X { P_OVERFLOW_Y } else { P_OVERFLOW_X });
    if o == OVERFLOW_VISIBLE || o == OVERFLOW_CLIP {
        return k;
    }
    if k == OVERFLOW_VISIBLE { return OVERFLOW_AUTO; }
    if k == OVERFLOW_CLIP { return OVERFLOW_HIDDEN; }
    return k;
}

/// Whether the box is a scroll container on an axis (`hidden`, `auto`, `scroll`: it has a scroll offset there).
fn isScrollOn(d: &Dom, st: int, prop: int): bool {
    let k = ovOf(d, st, prop);
    return k != OVERFLOW_VISIBLE && k != OVERFLOW_CLIP;
}

/// A scroll container: `hidden`, `auto` or `scroll` on either axis.
pub fn isScroll(d: &Dom, st: int): bool {
    return isScrollOn(d, st, P_OVERFLOW_Y) || isScrollOn(d, st, P_OVERFLOW_X);
}

/// Whether the box clips its content on an axis (anything but `visible`).
fn clipsOn(d: &Dom, st: int, prop: int): bool {
    return ovOf(d, st, prop) != OVERFLOW_VISIBLE;
}

/// A box that clips on either axis (scroll containers and `clip`).
pub fn isClip(d: &Dom, st: int): bool {
    return clipsOn(d, st, P_OVERFLOW_Y) || clipsOn(d, st, P_OVERFLOW_X);
}

/// Whether the point `(x, y)` of a clipping box `w` by `h` is inside the clip: an axis that does not clip lets any value in.
fn inClip(d: &Dom, st: int, x: f32, y: f32, w: f32, h: f32): bool {
    return (!clipsOn(d, st, P_OVERFLOW_X) || (x >= 0.0 && x < w)) && (!clipsOn(d, st, P_OVERFLOW_Y) || (y >= 0.0 && y < h));
}

/// Whether the wheel and scrollbars move the box on an axis (`auto` or `scroll`; `hidden` only by code).
fn scrollsOn(d: &Dom, st: int, prop: int): bool {
    let k = ovOf(d, st, prop);
    return k == OVERFLOW_AUTO || k == OVERFLOW_SCROLL;
}

/// The scrollbars of box `id` (nothing shows when `scrollbar-width: none`).
pub fn barsOf(d: &Dom, id: int): Bars {
    let n = &d.nodes.items[id];
    let st = n.style;
    let t = scrollbar.thickness(kwOf(d, st, P_SB_WIDTH));
    let ky = ovOf(d, st, P_OVERFLOW_Y);
    let kx = ovOf(d, st, P_OVERFLOW_X);
    return Bars {
        w: n.w, h: n.h, t: t,
        showX: t > 0.0 && (kx == OVERFLOW_SCROLL || (kx == OVERFLOW_AUTO && n.scrollMaxX > 0.0)),
        showY: t > 0.0 && (ky == OVERFLOW_SCROLL || (ky == OVERFLOW_AUTO && n.scrollMax > 0.0)),
        offX: n.scrollX, maxX: n.scrollMaxX, contX: n.contentW,
        offY: n.scrollY, maxY: n.scrollMax, contY: n.contentH,
    };
}

/// Whether `id` is a `display: contents` element that flattens: only under a grid (or another flattened
/// contents element); anywhere else it lays out as a plain block.
fn isFlat(d: &Dom, id: int): bool {
    while d.nodes.items[id].disp == DP_CONTENTS {
        let p = d.nodes.items[id].parent;
        if p < 0 {
            return false;
        }
        if d.nodes.items[p].disp == DP_GRID {
            return true;
        }
        id = p;
    }
    return false;
}

/// Right edge of what `id` holds (children boxes and its own text lines), px from its left border edge.
fn contentRight(d: &Dom, id: int): f32 {
    let r: f32 = 0.0;
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let k = &d.nodes.items[c];
        if k.kind == K_ELEM && isFlat(d, c) {
            r = max(r, contentRight(d, c));
        } else if k.kind == K_ELEM && k.disp != DP_NONE && !k.isAbs {
            r = max(r, k.x + k.w);
        }
        c = k.next;
    }
    let f = d.nodes.items[id].frag0;
    while f >= 0 {
        r = max(r, d.frags.items[f].x + d.frags.items[f].w);
        f = d.frags.items[f].next;
    }
    return r;
}

/// Px past a scroll box's viewport at which children are skipped by paint and hit testing.
const CULL: f32 = 400.0;

/// Whether child `c` of scroll box `p` is far outside its viewport (so it need not paint or be hit).
fn farOff(d: &Dom, p: int, c: int): bool {
    // a `display: contents` node has no box; its children are items of the nearest real ancestor
    while isFlat(d, p) {
        p = d.nodes.items[p].parent;
    }
    let pn = &d.nodes.items[p];
    let cn = &d.nodes.items[c];
    if isFlat(d, c) || cn.isAbs || cn.isStk || !isClip(d, pn.style) {
        return false;
    }
    let cy = clipsOn(d, pn.style, P_OVERFLOW_Y);
    let cx = clipsOn(d, pn.style, P_OVERFLOW_X);
    let far = (cy && (cn.y + cn.h < pn.scrollY - CULL || cn.y > pn.scrollY + pn.h + CULL)) || (cx && (cn.x + cn.w < pn.scrollX - CULL || cn.x > pn.scrollX + pn.w + CULL));
    // a transform can bring a far box back into view
    if !far {
        return false;
    }
    let xf = xform.of(d.css, cn.style, cn.w, cn.h);
    return !xf.on;
}

fn skipped(d: &Dom, id: int): bool {
    return d.nodes.items[id].disp == DP_NONE || d.nodes.items[id].isAbs;
}

fn inlineLevel(d: &Dom, id: int): bool {
    if d.nodes.items[id].kind == K_TEXT {
        return true;
    }
    let dp = d.nodes.items[id].disp;
    return dp == DP_INLINE || dp == DP_INLINE_BLOCK;
}

/// The font for style `st`. A `font-family` list (`"Ui", "Symbols"`) opens each listed `@font-face` family
/// at the size: the first is the font, the others its per-glyph fallbacks (`game.fontFallback`). Names with
/// no `@font-face` (`sans-serif`) are skipped; with none left the default file is used. The fallback chain
/// belongs to the primary's font handle, and a list gets a handle of its own (opened here, cached under the whole list at the size), so two lists
/// with the same first family never share a chain. The HiDPI twin is per handle inside `game`, so the scale is not part of the key.
pub fn fontOf(d: &Dom, st: int): Font {
    let fam = vi(d, st, P_FONT_FAMILY);
    let sz = int(vf(d, st, P_FONT_SIZE) + 0.5);
    for i in 0..d.fonts.len {
        if d.fonts.items[i].family == fam && d.fonts.items[i].size == sz {
            return d.fonts.items[i].font;
        }
    }
    if fam < 0 {
        return familyFont(d, fam, sz);
    }
    let names = d.css.name(fam);
    let commas = 0;
    for i in 0..names.len {
        if int(names[i]) == 44 {
            commas += 1;
        }
    }
    if commas == 0 {
        return familyFont(d, fam, sz);
    }
    let f = Font { raw: 0 };
    let have = false;
    let a = 0;
    while a <= names.len {
        let b = a;
        while b < names.len && int(names[b]) != 44 {
            b += 1;
        }
        let id = d.css.intern(names[a..b]);
        let face = false;
        for j in 0..d.css.fonts.len {
            if d.css.fonts.items[j].family == id {
                face = true;
            }
        }
        if face {
            if !have {
                f = loadFamily(d, id, sz);
                have = true;
            } else {
                fontFallback(f, familyFont(d, id, sz));
            }
        }
        a = b + 1;
    }
    if !have {
        return familyFont(d, fam, sz);
    }
    d.fonts.push(FontEnt { family: fam, size: sz, font: f });
    return f;
}

/// One family at `sz` px: its `@font-face` file (else the default, else the first `@font-face`), cached.
fn familyFont(d: &Dom, fam: int, sz: int): Font {
    for i in 0..d.fonts.len {
        if d.fonts.items[i].family == fam && d.fonts.items[i].size == sz {
            return d.fonts.items[i].font;
        }
    }
    let f = loadFamily(d, fam, sz);
    d.fonts.push(FontEnt { family: fam, size: sz, font: f });
    return f;
}

/// A fresh handle for family `fam` at `sz` px (not cached): its `@font-face` file, else the default, else the first `@font-face`.
fn loadFamily(d: &Dom, fam: int, sz: int): Font {
    let path = d.fallback;
    let found = false;
    for j in 0..d.css.fonts.len {
        if d.css.fonts.items[j].family == fam && !found {
            path = d.css.fonts.items[j].path;
            found = true;
        }
    }
    if !found && d.css.fonts.len > 0 {
        path = d.css.fonts.items[0].path;
    }
    let f = tryLoadFont(path, sz);
    if f.raw == 0 {
        d.fontMissing += 1;
    }
    return f;
}

pub fn isBold(d: &Dom, st: int): bool {
    return vf(d, st, P_FONT_WEIGHT) >= 600.0;
}

/// The `TextMode` the style asks for (`font-variant-numeric`, `letter-spacing`, `word-spacing`).
pub fn textModeOf(d: &Dom, st: int): TextMode {
    return TextMode { tabular: kwOf(d, st, P_FONT_VARIANT_NUMERIC) == 1, letterSp: vf(d, st, P_LETTER_SPACING), wordSp: vf(d, st, P_WORD_SPACING) };
}

/// The bytes of text node `id` as `text-transform` shows them: `buf` itself under `none`, else a same-length copy in `tbuf`
/// (ASCII and the Latin-1 letters, which keep their byte count in UTF-8; `capitalize` raises the first letter after a
/// non-word byte). The copy is made once per text or transform change, so a frame allocates nothing. Layout, paint and
/// the static selection's hit test read this; the selection's copy text and `<input>` values stay as written.
pub fn shownText(d: &Dom, id: int): []u8 {
    let n = &d.nodes.items[id];
    let whole = []u8 { ptr: n.buf.ptr, len: n.tlen };
    if n.style < 0 || n.kind != K_TEXT {
        return whole;
    }
    let m = kwOf(d, n.style, P_TEXT_TRANSFORM);
    if m == 0 {
        return whole;
    }
    if n.txm != m {
        if n.tbuf.len < n.tlen {
            n.tbuf = d.mem.alloc::<u8>(max4(n.tlen, n.tbuf.len * 2));
        }
        let start = true;
        let i = 0;
        while i < n.tlen {
            let b = int(n.buf[i]);
            let up = m == 1 || (m == 3 && start);
            let o = b;
            if up && b >= 97 && b <= 122 { o = b - 32; }
            if m == 2 && b >= 65 && b <= 90 { o = b + 32; }
            n.tbuf[i] = u8(o);
            if b == 195 && i + 1 < n.tlen {
                // Latin-1 letters: C3 80..9E upper (97 is x), C3 A0..BE lower (B7 is /)
                let c = int(n.buf[i + 1]);
                let oc = c;
                if up && c >= 160 && c <= 190 && c != 183 { oc = c - 32; }
                if m == 2 && c >= 128 && c <= 158 && c != 151 { oc = c + 32; }
                n.tbuf[i + 1] = u8(oc);
                i += 2;
                start = false;
                continue;
            }
            start = !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 39 || b == 95 || b >= 128);
            i += 1;
        }
        n.txm = m;
    }
    return []u8 { ptr: n.tbuf.ptr, len: n.tlen };
}

/// Make `st`'s text mode the one `j3.game` measures and draws with, and return the previous mode. Every `enterText`
/// is paired with a `leaveText(prev)` in the same function before it returns, so the app's own text is never affected.
pub fn enterText(d: &Dom, st: int): TextMode {
    return setTextMode(textModeOf(d, st));
}

/// `enterText` for text node `id`. A text node's style is the static computed one, so a `letter-spacing` / `word-spacing`
/// transition or animation on an ancestor (its overlay, `Node.style` != `tstyle`) is read from the nearest ancestor that
/// is animating and still passes the node's own spacing through. Free unless some Motion moves spacing (`Dom.spMo`, a `forwards` hold included).
pub fn enterTextNode(d: &Dom, id: int): TextMode {
    let st = d.nodes.items[id].style;
    let tm = textModeOf(d, st);
    if d.spMo > 0 {
        let a = d.nodes.items[id].parent;
        while a >= 0 && vf(d, d.nodes.items[a].tstyle, P_LETTER_SPACING) == tm.letterSp && vf(d, d.nodes.items[a].tstyle, P_WORD_SPACING) == tm.wordSp {
            // an overlay that animates something else (opacity) passes the spacing through: keep climbing
            let ast = d.nodes.items[a].style;
            let ls = vf(d, ast, P_LETTER_SPACING);
            let ws = vf(d, ast, P_WORD_SPACING);
            if ls != tm.letterSp || ws != tm.wordSp {
                tm.letterSp = ls;
                tm.wordSp = ws;
                break;
            }
            a = d.nodes.items[a].parent;
        }
    }
    return setTextMode(tm);
}

pub fn leaveText(prev: TextMode) {
    setTextMode(prev);
}

/// Line box height in px for the style's font.
fn lineHeightOf(d: &Dom, st: int, font: Font): f32 {
    let v = d.css.get(st, P_LINE_HEIGHT);
    let fs = vf(d, st, P_FONT_SIZE);
    if v.kind == V_NUM {
        return v.f * fs;
    }
    if v.kind == V_PX {
        return v.f;
    }
    if v.kind == V_PCT {
        return v.f * fs / 100.0;
    }
    return f32(fontLine(font));
}
