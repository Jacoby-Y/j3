// Part of j3.ui.dom (form-field and text attributes, values, open state, restyle); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// `id` attribute (`#id` selectors): a static name, no lookup by id exists.
    fn attrId(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].id;
        if cur >= 0 && same(this.css.name(cur), s) {
            return;
        }
        this.mnodes.items[id].id = this.css.intern(s);
        markStyle(this, id);
        markHas(this, id, 2, 0);
    }

    /// `type` attribute (`[type="range"]` selectors, replaced box size).
    fn attrType(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].type;
        if cur >= 0 && same(this.css.name(cur), s) {
            return;
        }
        this.mnodes.items[id].type = this.css.intern(s);
        markStyle(this, id);
        markHas(this, id, 2, 0);
    }

    /// `disabled` (the `:disabled` flag).
    fn attrDisabled(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.setFlag(id, 4, on);
    }

    /// `checked` (no layout effect).
    fn attrChecked(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].checked = on;
        this.setFlag(id, FL_CHECKED, on);
    }

    /// A radio's `checked`, `bind:checked` or `bind:group` state: applied when the program's value for it changes (a radio the user
    /// checked stays checked until the program says otherwise), and checking it unchecks the others of its group.
    fn attrRadio(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let want = if on { 2 } else { 1 };
        if this.nodes.items[id].openSet == want { return; }
        this.nodes.items[id].openSet = want;
        radioSet(this, id, on, false);
    }

    /// Whether `id` is checked (`bind:checked` on a radio writes it back).
    fn isChecked(this: &Dom, id: int): bool {
        id = this.resolve(id);
        return id != STALE && this.nodes.items[id].checked;
    }

    /// Text equality for a `bind:group` string (the generated module does not import `j3.text`).
    fn textIs(this: &Dom, a: string, b: string): bool {
        return same(a, b);
    }

    /// A radio's `bind:group` state: checked while the variable equals its value, whatever the radio shows now (so a variable no radio has
    /// unchecks them all, and the variable wins over a pick it did not take). A radio the user flipped this frame waits for the next frame,
    /// when the variable has had its say.
    fn attrGroup(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        n.openSet = if on { 2 } else { 1 };
        if n.clkAt == this.frame || n.checked == on { return; }
        radioSet(this, id, on, false);
    }

    /// A radio's `name`: radios with the same name in the same group scope are exclusive. A checked radio that changes group
    /// (or gets its name after its `checked`) takes the check from the group it joins.
    fn attrName(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.nodes.items[id].rname;
        if cur >= 0 && same(this.css.name(cur), s) { return; }
        this.nodes.items[id].rname = this.css.intern(s);
        if this.nodes.items[id].checked { radioClear(this, id, false); }
    }

    /// The `name` of a radio ("" for none).
    fn nameOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE || this.nodes.items[id].rname < 0 { return ""; }
        return this.css.name(this.nodes.items[id].rname);
    }

    /// `value` (no layout effect).
    fn attrValue(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.a11yOn && this.nodes.items[id].value != v { aNote(this, EV_VALUE, id); }
        this.nodes.items[id].value = v;
        if v < 0.0 && this.nodes.items[id].tag == this.tProgress && !this.css.reduced && paintVisible(this, id) {
            this.gaugeLive += 1;
        }
    }

    /// `value` of a text, search, color or select input (and of an `<option>`): the bound string (copied
    /// unless the box is being edited). While the box has focus its own buffer is the truth, and `s` only replaces it
    /// when it differs (the program changed the variable).
    fn attrText(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if this.a11yOn && !same(n.sval, s) { aNote(this, EV_VALUE, id); }
        if n.edit >= 0 && this.focus == id && isField(this, id) {
            let e = &this.eds.items[n.edit];
            if !e.matches(s) {
                e.set(s);
            }
            n.sval = e.str();
        } else if this.mnodes.items[id].type == this.vTextarea {
            // a textarea lays its text out unfocused too, so its buffer is always the truth
            let t = &this.eds.items[this.claim(id)];
            if !t.matches(s) {
                t.set(s);
            }
            n.sval = t.str();
        } else {
            // copied: `s` may be frame scratch (a markup fn's string), and events read `sval` between frames
            keep(this.mem, &n.svBuf, &n.svLen, s);
            n.sval = ([]u8 { ptr: n.svBuf.ptr, len: n.svLen }) as string;
        }
        this.syncPlaceholder(id);
    }

    /// `:placeholder-shown` from the box's current text (`sval`); also called when the user edits, so it does not wait for the bound value.
    fn syncPlaceholder(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        this.setFlag(id, FL_PH_SHOWN, n.ph.len > 0 && n.sval.len == 0);
    }

    /// `rich` on a textarea: it keeps spans (bold, italic, link, atomic tokens) beside its text.
    fn attrRich(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.eds.items[this.claim(id)].rich = on;
    }

    /// `bind:spans` of a rich textarea: the program's spans, copied into the box when they are not just the view `spansValue` gave
    /// out. Replacing the text from the program drops the old spans (set the new ones in the same update, in any order).
    fn attrSpans(this: &Dom, id: int, v: []Span) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.eds.items[this.claim(id)].setSpans(v);
    }

    /// The spans of a rich textarea as a view of its own storage, valid until the next edit (`bind:spans` assigns it).
    fn spansValue(this: &Dom, id: int): []Span {
        return this.eds.items[this.claim(id)].spans();
    }

    /// Where the caret of the focused text box `id` is now, in window px: top left and height (w is 1), from the box's last layout
    /// and its current text and caret (not the last paint, so a popup placed in the same update does not trail a keystroke).
    /// `x` is -1 when the box is not focused or laid out, or is a password box. A caret popup (`@ja` completion) anchors here.
    fn caretRect(this: &Dom, id: int): CaretRect {
        let n = &this.nodes.items[id];
        let none = CaretRect { x: -1.0, y: -1.0, w: 1.0, h: 0.0 };
        if n.edit < 0 || this.focus != id || !n.laid || n.disp == DP_NONE || this.mnodes.items[id].type == this.vPassword {
            return none;
        }
        let e = &this.eds.items[n.edit];
        let ed = edgesOf(this, n.style, n.basisW);
        let cw = n.w - ed.pl - ed.pr - ed.bl - ed.br;
        let font = fontOf(this, n.style);
        let bold = isBold(this, n.style);
        let tm = enterText(this, n.style);
        let at = Vec2 { x: 0.0, y: 0.0 };
        let h: f32 = n.h - ed.pt - ed.pb - ed.bt - ed.bb;
        if this.mnodes.items[id].type == this.vTextarea {
            let lh = f32(fontLine(font));
            area.layout(e, font, bold, cw);
            area.follow(e, true, lh, h);
            let line = area.caretLine(e);
            at.x = area.caretAt(e, font, bold, e.str(), e.ls.items[line], area.lineEnd(e, line), e.cur);
            at.y = f32(line) * lh - e.ty;
            h = lh;
        } else {
            let s = e.str();
            let avail = if this.mnodes.items[id].type == this.vSearch { cw - 18.0 } else { cw };
            let vs = field.scroll(font, bold, s, e.vs, e.cur, avail);
            at.x = field.caretX(font, bold, s, vs, vs + fitPrefix(font, bold, bytesOf(s[vs..s.len]), avail), e.cur);
        }
        leaveText(tm);
        return CaretRect { x: this.absX(id) + ed.bl + ed.pl + at.x, y: this.absY(id) + ed.bt + ed.pt + at.y, w: 1.0, h: h };
    }

    /// Byte index of the caret of text box `id` (a selection's moving end).
    fn caret(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        return this.eds.items[this.claim(id)].cur;
    }

    /// The selection of text box `id` as a byte range (`lo == hi` when nothing is selected; both -1 for a stale id).
    fn selection(this: &Dom, id: int): WordRange {
        id = this.resolve(id);
        if id == STALE { return WordRange { lo: -1, hi: -1 }; }
        let e = &this.eds.items[this.claim(id)];
        return WordRange { lo: e.lo(), hi: e.hi() };
    }

    /// The selected text of text box `id` (a view, valid until its next edit; empty when nothing is selected).
    fn selectedText(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        return this.eds.items[this.claim(id)].selected();
    }

    /// `noprimary` on a text box: selecting in it does not set the PRIMARY selection and a middle click does not paste it.
    fn attrNoPrimary(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.eds.items[this.claim(id)].noprim = on;
    }

    /// Put `s` on the PRIMARY selection (X11/Wayland: pasted with a middle click), or in the Dom's own buffer after `simPrimary`.
    fn setPrimary(this: &Dom, s: string) {
        if this.primFake {
            this.primBuf.clear();
            this.primBuf.pushStr(s);
        } else {
            game.setPrimarySelection(s);
        }
    }

    /// The PRIMARY selection (`j3.game.primarySelection`), or the Dom's own buffer after `simPrimary`.
    fn primary(this: &Dom): string {
        return if this.primFake { this.primBuf.str() } else { game.primarySelection() };
    }

    /// Tests: keep PRIMARY in the Dom from now on instead of the system (headless has none), starting as `s`.
    fn simPrimary(this: &Dom, s: string) {
        this.primFake = true;
        this.primBuf.clear();
        this.primBuf.pushStr(s);
    }

    /// Select bytes `lo..hi` of text box `id` (caret at `hi`; `lo == hi` just moves the caret), clamped to the text and
    /// moved out of tokens, and scroll a textarea so the caret shows, focused or not. For a find box:
    /// `dom.setSelection(editor, at, at + query.len)`.
    fn setSelection(this: &Dom, id: int, lo: int, hi: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let e = &this.eds.items[this.claim(id)];
        e.moveTo(lo, false);
        e.moveTo(hi, true);
        e.fcur = -2;
        e.t0 = this.now;
    }

    /// Replace `lo..hi` of a rich textarea's text with the atomic token `label` (`SPAN_MENTION` / `SPAN_EMOJI`, `data` its id): the
    /// bound value and spans update like user input (`changed` is true this frame if the box has not been updated yet, and
    /// on the next one either way, so call it from any handler), and it is one undo step. False when the range is bad.
    fn insertToken(this: &Dom, id: int, lo: int, hi: int, label: string, kind: int, data: string): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let e = &this.eds.items[this.claim(id)];
        if !e.replaceWithToken(lo, hi, label, kind, data) {
            return false;
        }
        let n = &this.nodes.items[id];
        n.sval = e.str();
        n.chg = this.frame;
        e.late = this.frame + 1;
        e.t0 = this.now;
        return true;
    }

    /// `maxlength` of a text box, in code points.
    fn attrMaxLen(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].maxlen = int(v);
    }

    /// `rows` of a textarea: its height when no `height` is set.
    fn attrRows(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.nodes.items[id].rows != int(v) {
            this.nodes.items[id].rows = int(v);
            markStyle(this, id);
        }
    }

    /// The text state of node `id`: its slot in `eds` (made on first use, reusing a freed one). A
    /// text box edits it; a select or color input builds its value in it.
    fn claim(this: &Dom, id: int): int {
        id = this.resolve(id);
        if id == STALE { return -1; }
        let n = &this.nodes.items[id];
        if n.edit >= 0 {
            this.eds.items[n.edit].nl = this.mnodes.items[id].type == this.vTextarea;
            return n.edit;
        }
        let k = -1;
        for i in 0..this.eds.len {
            if k < 0 && this.eds.items[i].owner < 0 {
                k = i;
            }
        }
        if k < 0 {
            this.eds.push(Edit.new(this.mem));
            k = this.eds.len - 1;
        }
        let e = &this.eds.items[k];
        e.owner = id;
        e.nl = this.mnodes.items[id].type == this.vTextarea;
        e.lver = -1;
        e.clearUndo();
        e.rich = false;
        e.noprim = false;
        e.late = -1;
        e.sp.len = 0;
        e.dn = 0;
        e.px = -1.0;
        e.py = -1.0;
        e.ty = 0.0;
        e.gx = -1.0;
        e.clicks = 0;
        e.fcur = -1;
        n.edit = k;
        return k;
    }

    /// `placeholder`, copied (it is often a template string, which dies with the frame's `update`).
    fn attrPlaceholder(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        storeBytes(this, n, s);
        n.ph = ([]u8 { ptr: n.buf.ptr, len: n.tlen }) as string;
        this.syncPlaceholder(id);
    }

    /// `multiple` on a `<select>`.
    fn attrMultiple(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].multi = on;
    }

    /// The second thumb of a range slider (`high`, `bind:high`).
    fn attrHigh(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].high = v;
    }

    /// `<meter>` `low` (0), `high` (1) or `optimum` (2).
    fn attrMeter(this: &Dom, id: int, which: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        if which == 0 { n.mlow = v; } else if which == 1 { n.mhigh = v; } else { n.mopt = v; }
    }

    /// `open` of a `<details>`. Applied when the attribute's value changes, not on every update, so a click that flipped
    /// the box stands until the program changes its mind (`bind:open` writes the click back first). A change of state the
    /// program makes fires `toggled` in the next frame's update; the first value a box gets does not fire.
    fn attrOpen(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let want = if on { 2 } else { 1 };
        if n.openSet == want {
            return;
        }
        let first = n.openSet == 0;
        n.openSet = want;
        if !first && this.isOpen(id) != on {
            n.togAt = this.frame + 1;
        }
        this.setOpen(id, on);
    }

    /// Open or close a `<details>` now: `:open`, its content shows or hides (the children stay mounted). Closing it drops the focus
    /// from content inside it (the summary keeps it).
    fn setOpen(this: &Dom, id: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.setFlag(id, FL_OPEN, on);
        let f = this.focus;
        if !on && f >= 0 {
            let c = f;
            while c >= 0 && c != id && this.nodes.items[c].tag != this.tSummary {
                c = this.nodes.items[c].parent;
            }
            if c == id {
                this.focusNode(-1);
            }
        }
    }

    /// Whether `<details>` `id` is open.
    fn isOpen(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return (this.mnodes.items[id].flags / FL_OPEN) % 2 == 1;
    }

    /// `<details>` `id` changed state (a click on its `<summary>` this frame, or the program's `open` last frame): `on:toggle`,
    /// `bind:open`. Once per change.
    fn toggled(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].togAt == this.frame;
    }

    /// A click on the `<summary>` of `<details>` `id` flipped it this frame: `bind:open` writes the new state back (a state the program
    /// set is already in its variable, and a write-back could undo a newer change of the program's).
    fn userToggled(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].clkAt == this.frame;
    }

    /// The user changed the value of `id` this frame (typing, dragging, picking): write it back with
    /// `strValue`, `value` or `highValue`.
    fn changed(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        return n.chg == this.frame || (n.edit >= 0 && this.eds.items[n.edit].late == this.frame);
    }

    /// Enter was pressed in the text box `id` this frame.
    fn submitted(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].sub == this.frame;
    }

    /// The string value after a change (a view of the box's buffer, valid until the next change).
    fn strValue(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        return this.nodes.items[id].sval;
    }

    /// The range value after a change (the low thumb of a two-thumb slider).
    fn value(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        return this.nodes.items[id].value;
    }

    /// The high thumb after a change.
    fn highValue(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        return this.nodes.items[id].high;
    }

    /// `min`.
    fn attrMin(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrMin = v;
    }

    /// `max`.
    fn attrMax(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrMax = v;
    }

    /// `step`.
    fn attrStep(this: &Dom, id: int, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.nodes.items[id].attrStep = v;
    }

    /// Set or clear a `css.FL_*` bit (hover, active, disabled) and restyle.
    fn setFlag(this: &Dom, id: int, flag: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        let cur = this.mnodes.items[id].flags;
        let has = (cur / flag) % 2 == 1;
        if has == on {
            return;
        }
        if on {
            this.mnodes.items[id].flags = cur + flag;
        } else {
            this.mnodes.items[id].flags = cur - flag;
        }
        markStyle(this, id);
        markHas(this, id, 1, flag);
        if this.a11yOn {
            if flag == FL_CHECKED { aNote(this, EV_CHECKED, id); }
            if flag == FL_OPEN { aNote(this, EV_EXPANDED, id); }
        }
    }

    /// Restyle everything (after `css.reset()` and `parse` again, for hot reload).
    fn restyle(this: &Dom) {
        // overlay styles die with `css.reset()`; style ids restart, so a node can keep its id with new
        // values: lay everything out again
        for i in 0..this.nodes.len {
            if this.nodes.items[i].kind == K_ELEM {
                // meter colors were looked up for a style id that may now mean something else
                this.nodes.items[i].mcSt = -1;
                if this.nodes.items[i].tr >= 0 {
                    dropMotion(this, i);
                }
                markDirty(this, i);
            }
        }
        for i in 0..this.trs.len {
            motion.forget(&this.trs.items[i]);
        }
        // so do the `style:` styles; the next update sets every override again
        for i in 0..this.dyns.len {
            dynattr.forget(&this.dyns.items[i]);
        }
        if this.nodes.len > 0 {
            markStyle(this, 0);
        }
    }
}

