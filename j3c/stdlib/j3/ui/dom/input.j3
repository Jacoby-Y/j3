// Part of j3.ui.dom (Hit testing, hover and focus, modal rules, wheel and scrollbar input, motion stepping.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

const SLOT_UNIT: int = 281474976710656;

pub fn isDisabled(d: &Dom, id: int): bool {
    return id >= 0 && (d.mnodes.items[id].flags / FL_DISABLED) % 2 == 1;
}

/// `c` is a live click target at or inside `id`.
pub fn clickHit(d: &Dom, c: int, id: int): bool {
    return c >= 0 && styleVisible(d, c) && (c == id || isAncestor(d, id, c));
}

/// Whether `a` is a proper ancestor of `b`.
pub fn isAncestor(d: &Dom, a: int, b: int): bool {
    let c = d.nodes.items[b].parent;
    while c >= 0 {
        if c == a {
            return true;
        }
        c = d.nodes.items[c].parent;
    }
    return false;
}

/// Map the point `(px, py)`, in the coordinates of `id`'s parent content origin (scroll included), into the border box of `id`
/// (`out` is relative to its top left): undo the `animate:flip` flight, a transition scale and the box's transform. False when the
/// transform has no inverse (`scale(0)`), so nothing in the box can be hit.
fn hitEnter(d: &Dom, id: int, px: f32, py: f32, out: &Vec2): bool {
    let n = &d.nodes.items[id];
    // an `animate:flip` flight moves the box and what it holds, like a translate
    px -= d.flipDx(id) + transDx(d, id);
    py -= d.flipDy(id) + transDy(d, id);
    let ts = transScale(d, id);
    if ts != 1.0 {
        let ox = n.x + n.w * 0.5;
        let oy = n.y + n.sy + n.h * 0.5;
        px = ox + (px - ox) / ts;
        py = oy + (py - oy) / ts;
    }
    out.x = px - n.x;
    out.y = py - n.y - n.sy;
    let xf = xform.of(d.css, n.style, n.w, n.h);
    if xf.on {
        // the inverse of the box's matrix; a singular one (`scale(0)`) leaves nothing to hit
        let q = Vec2 { x: 0.0, y: 0.0 };
        if !xform.unmap(&xf, n.x, n.y + n.sy, px, py, &q) {
            return false;
        }
        out.x = q.x - n.x;
        out.y = q.y - n.y - n.sy;
    }
    return true;
}

/// The forward map of `hitNode`: the point `(px, py)` in the border box of `id` (relative to its top left) in root coordinates, with each
/// ancestor's scroll, `animate:flip` flight, transition scale and transform applied (a `position: fixed` box starts at the root).
/// `j3.ui.a11y.bounds` maps the four corners with it.
pub fn mapUp(d: &Dom, id: int, px: f32, py: f32, out: &Vec2) {
    let c = id;
    while c >= 0 {
        let n = &d.nodes.items[c];
        let bx = n.x;
        let by = n.y + n.sy;
        let xf = xform.of(d.css, n.style, n.w, n.h);
        let qx = px;
        let qy = py;
        if xf.on {
            qx = xf.e + xf.a * px + xf.c * py;
            qy = xf.f + xf.b * px + xf.d * py;
        }
        let ax = bx + qx;
        let ay = by + qy;
        let ts = transScale(d, c);
        if ts != 1.0 {
            let ox = n.x + n.w * 0.5;
            let oy = by + n.h * 0.5;
            ax = ox + (ax - ox) * ts;
            ay = oy + (ay - oy) * ts;
        }
        ax += d.flipDx(c) + transDx(d, c);
        ay += d.flipDy(c) + transDy(d, c);
        let p = n.parent;
        if n.isFixed || p < 0 {
            px = ax;
            py = ay;
            break;
        }
        px = ax - d.nodes.items[p].scrollX;
        py = ay - d.nodes.items[p].scrollY;
        c = p;
    }
    out.x = px;
    out.y = py;
}

/// Topmost element under the point `(px, py)`, given in the coordinates of `id`'s parent content
/// origin (scroll included). -1 for none. The order is the paint order (`dom/stack.j3`), topmost first: the entries of a stacking
/// context above its in-flow content, the in-flow children from the last (lifted ones are entries, found through their context),
/// the entries below it, then the box itself. A scroll box's bars are above its children and set `barHover`/`barOf`.
fn hitNode(d: &Dom, id: int, px: f32, py: f32): int {
    let n = &d.nodes.items[id];
    if n.kind != K_ELEM || n.ghost || n.disp == DP_NONE {
        return -1;
    }
    let q = Vec2 { x: 0.0, y: 0.0 };
    if !hitEnter(d, id, px, py, &q) {
        return -1;
    }
    let lx = q.x;
    let ly = q.y;
    let inside = lx >= 0.0 && ly >= 0.0 && lx < n.w && ly < n.h;
    if !inside && transKind(d, id) == 3 {
        return -1; // a sliding box clips what it holds
    }
    let clip = isClip(d, n.style);
    if clip && !inClip(d, n.style, lx, ly, n.w, n.h) {
        return -1;
    }
    if inside && clip && paintVisible(d, id) {
        let bars = barsOf(d, id);
        let part = scrollbar.hit(&bars, lx, ly);
        if part != scrollbar.NONE {
            d.barHover = part;
            d.barOf = id;
            return id;
        }
    }
    let cx = lx + n.scrollX;
    let cy = ly + n.scrollY;
    if n.ctx {
        let k = n.zc - 1;
        while k >= n.zneg {
            let r1 = hitSlot(d, id, n.zs + k, cx, cy);
            if r1 >= 0 {
                return r1;
            }
            k -= 1;
        }
    }
    let c = if n.ordered { n.vlast } else { n.last };
    while c >= 0 {
        let cn = &d.nodes.items[c];
        if !cn.lift && !cn.rt && !(clip && farOff(d, id, c)) {
            let r2 = hitNode(d, c, cx, cy);
            if r2 >= 0 {
                return r2;
            }
        }
        c = if n.ordered { cn.vprev } else { cn.prev };
    }
    if n.ctx {
        let k2 = n.zneg - 1;
        while k2 >= 0 {
            let r3 = hitSlot(d, id, n.zs + k2, cx, cy);
            if r3 >= 0 {
                return r3;
            }
            k2 -= 1;
        }
    }
    // a box may stick out of its block (vertical padding above the first line): the block's rect does not gate it
    if n.box0 >= 0 && paintVisible(d, id) {
        let hb = hitBox(d, id, cx, cy);
        if hb >= 0 {
            return hb;
        }
    }
    if inside && paintVisible(d, id) && kwOf(d, n.style, P_POINTER_EVENTS) != PE_NONE {
        return id;
    }
    return -1;
}

/// Hit slot `i` of the entry lists, a box or a scroller's bars (`barOf`).
fn hitSlot(d: &Dom, s: int, i: int, cx: f32, cy: f32): int {
    let v = d.zl.items[i].v;
    let b = barOf(v);
    return hitEntry(d, s, if b >= 0 { b } else { v }, b >= 0, cx, cy);
}

/// Hit entry `e` of context `s`, whose content origin holds the point `(cx, cy)`: walk down through the boxes between (their
/// clips and transforms), then hit `e`. Fixed boxes (overlays, popups) escape their ancestors and are given the pointer itself.
/// `bars`: the entry is a scroller's scrollbars (above the context's content): only they count.
fn hitEntry(d: &Dom, s: int, e: int, bars: bool, cx: f32, cy: f32): int {
    if e < 0 || e >= d.nodes.len || d.nodes.items[e].kind != K_ELEM {
        return -1;
    }
    let en = &d.nodes.items[e];
    if en.isFixed {
        if isHidden(d, e) {
            return -1;
        }
        return hitNode(d, e, d.mx, d.my);
    }
    let base = d.pchn;
    let k = 0;
    let c = en.parent;
    while c >= 0 && c != s {
        if base + k >= PAINT_DEPTH {
            return -1;
        }
        d.pch[base + k] = c;
        k += 1;
        c = d.nodes.items[c].parent;
    }
    let px = cx;
    let py = cy;
    let i = k - 1;
    let q = Vec2 { x: 0.0, y: 0.0 };
    while i >= 0 {
        let a = d.pch[base + i];
        let an = &d.nodes.items[a];
        if an.kind != K_ELEM || an.ghost || an.disp == DP_NONE || !hitEnter(d, a, px, py, &q) {
            return -1;
        }
        if (isClip(d, an.style) && !inClip(d, an.style, q.x, q.y, an.w, an.h)) || (transKind(d, a) == 3 && !(q.x >= 0.0 && q.y >= 0.0 && q.x < an.w && q.y < an.h)) {
            return -1;
        }
        px = q.x + an.scrollX;
        py = q.y + an.scrollY;
        i -= 1;
    }
    if bars {
        let en2 = &d.nodes.items[e];
        if en2.ghost || en2.disp == DP_NONE || !hitEnter(d, e, px, py, &q) || !paintVisible(d, e) {
            return -1;
        }
        let bb = barsOf(d, e);
        let part = scrollbar.hit(&bb, q.x, q.y);
        if part == scrollbar.NONE || !(q.x >= 0.0 && q.y >= 0.0 && q.x < en2.w && q.y < en2.h) {
            return -1;
        }
        d.barHover = part;
        d.barOf = e;
        return e;
    }
    return hitNode(d, e, px, py);
}

/// The innermost inline element whose box (padding and border included) holds the point `(cx, cy)` of block `id`
/// (its border-box frame plus scroll), else -1. A `::before` / `::after` box answers for its host.
fn hitBox(d: &Dom, id: int, cx: f32, cy: f32): int {
    let hit = -1;
    let bx = d.nodes.items[id].box0;
    while bx >= 0 {
        let b = &d.boxes.items[bx];
        if cx >= b.x && cx < b.x + b.w && cy >= b.y && cy < b.y + b.ap {
            let k = b.node;
            if d.nodes.items[k].ghost && d.nodes.items[k].parent >= 0 {
                k = d.nodes.items[k].parent;
            }
            if paintVisible(d, k) && kwOf(d, d.nodes.items[k].style, P_POINTER_EVENTS) != PE_NONE {
                hit = k;
            }
        }
        bx = b.next;
    }
    return hit;
}

/// Whether the hit node `hit` counts as `id` itself: it is `id`, or an inline element (a decorated span, an inline
/// box) inside `id`, which is part of `id`'s own text. A block child on top still swallows the pointer.
fn hitIs(d: &Dom, hit: int, id: int): bool {
    let c = hit;
    while c >= 0 {
        if c == id {
            return true;
        }
        if d.nodes.items[c].disp != DP_INLINE {
            return false;
        }
        c = d.nodes.items[c].parent;
    }
    return false;
}

/// Whether `id` paints and takes pointer input: `visibility` is visible and no ancestor is `display: none`.
pub fn paintVisible(d: &Dom, id: int): bool {
    return styleVisible(d, id) && !isHidden(d, id);
}

/// `visibility` alone (inherited, so no ancestor walk). Focus and activation use this: a virtual list keeps
/// the focused row alive as `display: none`, and that row must keep its focus.
pub fn styleVisible(d: &Dom, id: int): bool {
    return id >= 0 && id < d.nodes.len && (d.nodes.items[id].style < 0 || kwOf(d, d.nodes.items[id].style, P_VISIBILITY) == 0);
}

fn isHidden(d: &Dom, id: int): bool {
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].disp == DP_NONE {
            return true;
        }
        c = d.nodes.items[c].parent;
    }
    return false;
}

/// Mark `target` and its ancestors with `flag`, clear it everywhere else.
/// How long a submenu stays open after the pointer leaves its host (ms), so a diagonal move to it works.
const HOLD_MS: f32 = 300.0;

/// Whether `id` is a submenu host: an element with a direct child of class `sub`.
pub fn subOf(d: &Dom, id: int): int {
    let sub = d.css.intern("sub");
    let c = d.nodes.items[id].first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_ELEM {
            let cl = d.mnodes.items[c].classes;
            for i in 0..cl.len {
                if cl[i] == sub {
                    return c;
                }
            }
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

/// The pointer (or the keyboard) moved hover from `old` to `hv`: the outermost submenu host that `hv` is no
/// longer inside becomes the hold, unless `hv` is inside a sibling host (that one opens instead).
fn pickHold(d: &Dom, old: int, hv: int) {
    d.holdId = -1;
    let c = if old < d.nodes.len { old } else { -1 };
    let n = 0;
    while c >= 0 && n < MAX_DEPTH {
        if !(hv >= 0 && inside(d, c, hv)) && subOf(d, c) >= 0 {
            d.holdId = c;
        }
        c = d.nodes.items[c].parent;
        n += 1;
    }
    if d.holdId >= 0 {
        let par = d.nodes.items[d.holdId].parent;
        c = hv;
        n = 0;
        while c >= 0 && n < MAX_DEPTH {
            if d.nodes.items[c].parent == par && subOf(d, c) >= 0 {
                d.holdId = -1;
            }
            c = d.nodes.items[c].parent;
            n += 1;
        }
    }
    d.holdT = d.now;
}

/// Hover moves to `hv` (-1 none): `:hover` follows it, and with `hold` a submenu host it left stays hovered for
/// `HOLD_MS` (the pointer's hover-intent; keys pass false).
pub fn setHover(d: &Dom, hv: int, hold: bool) {
    if hv == d.hover {
        return;
    }
    let old = d.hover;
    d.hover = hv;
    pickHold(d, old, hv);
    if !hold {
        d.holdId = -1;
    }
    setChain(d, FL_HOVER, hv);
    let c = d.holdId;
    while c >= 0 {
        d.setFlag(c, FL_HOVER, true);
        c = d.nodes.items[c].parent;
    }
}

/// `cursor` of the node under the pointer (`hv`, -1 none) as this frame's system cursor. `auto` and `default` leave the
/// arrow (or whatever `inputs` picked for a field) alone; rules with `:hover` / `:active` / `:disabled` switch it.
fn applyCursor(d: &Dom, hv: int) {
    if hv < 0 || hv >= d.nodes.len || d.nodes.items[hv].style < 0 {
        return;
    }
    let k = kwOf(d, d.nodes.items[hv].style, P_CURSOR);
    // auto default pointer text crosshair move not-allowed grab grabbing ew-resize ns-resize col-resize row-resize wait progress help
    if k == 2 || k == 7 || k == 8 {
        game.setCursor(Cursor.Hand);
    } else if k == 3 {
        game.setCursor(Cursor.Text);
    } else if k == 4 {
        game.setCursor(Cursor.Crosshair);
    } else if k == 5 {
        game.setCursor(Cursor.Move);
    } else if k == 6 {
        game.setCursor(Cursor.NotAllowed);
    } else if k == 9 || k == 11 {
        game.setCursor(Cursor.ResizeAcross);
    } else if k == 10 || k == 12 {
        game.setCursor(Cursor.ResizeUpDown);
    } else if k == 13 || k == 14 {
        game.setCursor(Cursor.Wait);
    }
}

fn setChain(d: &Dom, flag: int, target: int) {
    let cnt = 0;
    let c = target;
    while c >= 0 && cnt < MAX_DEPTH {
        d.chain[cnt] = c;
        cnt += 1;
        d.setFlag(c, flag, true);
        if d.nodes.items[c].rt {
            // a popup is not part of its owner's hover or press
            break;
        }
        c = d.nodes.items[c].parent;
    }
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind != K_FREE && (d.mnodes.items[i].flags / flag) % 2 == 1 {
            let keep = false;
            for k in 0..cnt {
                if d.chain[k] == i {
                    keep = true;
                }
            }
            if !keep {
                d.setFlag(i, flag, false);
            }
        }
    }
}

/// Whether `id` is inside a caret popup: a press there keeps focus in the text box.
fn inCaretPop(d: &Dom, id: int): bool {
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].ovCaret && d.nodes.items[c].ov != 0 {
            return true;
        }
        c = d.nodes.items[c].parent;
    }
    return false;
}

/// Whether Tab can land on `id`: an enabled `button`, `input`, `select` or `tabindex` / `menuitem` element that is
/// shown (not `display: none`, not fading out, and none of its ancestors is either).
pub fn isFocusable(d: &Dom, id: int): bool {
    if !paintVisible(d, id) { return false; }
    let n = &d.nodes.items[id];
    let t = n.tag;
    if !(n.kind == K_ELEM && !isDisabled(d, id) && (t == d.tButton || t == d.tInput || t == d.tSelect || n.mitem)) {
        return false;
    }
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].ghost || d.nodes.items[c].disp == DP_NONE {
            return false;
        }
        c = d.nodes.items[c].parent;
    }
    return true;
}

/// Whether Tab and the pad can land on `id`: `isFocusable` and not `tabindex="-1"`.
pub fn tabbable(d: &Dom, id: int): bool {
    return padReach(d, id) && (!isRadio(d, id) || radioStop(d, id) == id);
}

/// Whether the pad can land on `id`: `tabbable` without the radio rule (one Tab stop per group), so the D-pad reaches every radio.
pub fn padReach(d: &Dom, id: int): bool {
    return isFocusable(d, id) && !d.nodes.items[id].noTab;
}

/// The nearest `button`, `input` or `select` at or above `id` (-1 for none; the current focus when it is disabled).
pub fn focusableAt(d: &Dom, id: int): int {
    let c = id;
    while c >= 0 {
        let t = d.nodes.items[c].tag;
        if t == d.tButton || t == d.tInput || t == d.tSelect || d.nodes.items[c].mitem {
            // a disabled control takes no focus (and a press on it does not blur the one that has it)
            return if isDisabled(d, c) { d.focus } else if paintVisible(d, c) { c } else { -1 };
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// A press at the mouse: start the `ripple` of the nearest element above `target` that has one.
fn startRipple(d: &Dom, target: int) {
    let c = target;
    while c >= 0 && !d.css.reduced {
        let v = d.css.get(d.nodes.items[c].style, P_RIPPLE);
        if v.kind == V_COLOR {
            ripple.add(&d.rip, c, d.mx - d.absX(c), d.my - d.absY(c), d.now, v.f, v.c);
            return;
        }
        c = d.nodes.items[c].parent;
    }
}

/// Index in `Dom.ovs` of the topmost modal dialog (-1 for none).
pub fn modalIndex(d: &Dom): int {
    let i = d.ovs.len - 1;
    while i >= 0 {
        if d.nodes.items[d.ovs.items[i].v].ov == OV_MODAL && paintVisible(d, d.ovs.items[i].v) {
            return i;
        }
        i -= 1;
    }
    return -1;
}

/// Whether `id` is `top` or inside it.
pub fn inside(d: &Dom, top: int, id: int): bool {
    return id == top || isAncestor(d, top, id);
}

/// Whether a press at `id` may reach it with a modal open: it is inside the modal or an overlay above it.
pub fn allowedByModal(d: &Dom, id: int): bool {
    let m = modalIndex(d);
    if m < 0 {
        return true;
    }
    for i in m..d.ovs.len {
        if inside(d, d.ovs.items[i].v, id) {
            return true;
        }
    }
    return false;
}

/// Wheel `notches` (positive scrolls forward) over `target`: the nearest ancestor box that scrolls on the
/// axis (Shift picks x) and can still move takes it; at its end the wheel goes on to the next one unless
/// `overscroll-behavior: contain`.
fn wheelRoute(d: &Dom, target: int, notches: f32) {
    let horiz = d.kin.shift;
    let c = target;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.kind == K_ELEM && isScroll(d, n.style) {
            // a plain wheel goes sideways over a box that cannot move up or down (y not scrolling, or no range: a coerced `auto` y)
            let onX = horiz || ((!scrollsOn(d, n.style, P_OVERFLOW_Y) || n.scrollMax <= 0.0) && scrollsOn(d, n.style, P_OVERFLOW_X));
            let ok = scrollsOn(d, n.style, if onX { P_OVERFLOW_X } else { P_OVERFLOW_Y });
            let off = if onX { n.scrollX } else { n.scrollY };
            let range = if onX { n.scrollMaxX } else { n.scrollMax };
            if ok && range > 0.0 && scroll.canMove(off, range, notches) {
                if kwOf(d, n.style, P_SCROLL_BEHAVIOR) == SMOOTH_ON && !d.css.reduced {
                    scrollMark(d, c);
                    if onX {
                        n.velX = scroll.kick(n.velX, notches);
                    } else {
                        n.velY = scroll.kick(n.velY, notches);
                    }
                    d.coasting += 1;
                } else if onX {
                    d.scrollByX(c, notches * scroll.NOTCH);
                } else {
                    d.scrollBy(c, notches * scroll.NOTCH);
                }
                return;
            }
            if ok && kwOf(d, n.style, P_OVERSCROLL) == OVERSCROLL_CONTAIN {
                return;
            }
        }
        c = n.parent;
    }
}

/// A wheel over a textarea whose text is taller than its box scrolls the text. False: not taken.
fn areaWheel(d: &Dom, target: int): bool {
    let n = &d.nodes.items[target];
    if n.kind != K_ELEM || n.tag != d.tInput || n.edit < 0 || d.mnodes.items[target].type != d.vTextarea || d.kin.shift {
        return false;
    }
    let e = &d.eds.items[n.edit];
    let range = f32(e.ls.len) * e.lh - e.vh;
    let by = (0.0 - d.wheelV) * scroll.NOTCH;
    if range <= 0.0 || !scroll.canMove(e.ty, range, by) {
        return false;
    }
    e.ty = scroll.clampOff(e.ty, by, range);
    return true;
}

/// Advance the wheel inertia of every coasting box by this frame's step.
fn stepCoast(d: &Dom) {
    let live = 0;
    for i in 0..d.nodes.len {
        let n = &d.nodes.items[i];
        if n.kind == K_ELEM && (n.velX != 0.0 || n.velY != 0.0) {
            let v: f32 = 0.0;
            if n.velY != 0.0 {
                let dist = scroll.coast(n.velY, d.dtMs, &v);
                d.scrollBy(i, dist);
                n.velY = if n.scrollY <= 0.0 || n.scrollY >= n.scrollMax { 0.0 } else { v };
            }
            if n.velX != 0.0 {
                let distX = scroll.coast(n.velX, d.dtMs, &v);
                d.scrollByX(i, distX);
                n.velX = if n.scrollX <= 0.0 || n.scrollX >= n.scrollMaxX { 0.0 } else { v };
            }
            if n.velX != 0.0 || n.velY != 0.0 {
                live += 1;
            }
        }
    }
    d.coasting = live;
}

/// A press on a scrollbar of `id`: start dragging its thumb, or page toward the press on the track.
fn barPress(d: &Dom, id: int, part: int) {
    let n = &d.nodes.items[id];
    let b = barsOf(d, id);
    let lx = d.mx - d.absX(id);
    let ly = d.my - d.absY(id);
    let vertical = part == scrollbar.Y_THUMB || part == scrollbar.Y_TRACK;
    let m = if vertical { ly - 2.0 } else { lx - 2.0 };
    let tr = if vertical { scrollbar.trackY(&b) } else { scrollbar.trackX(&b) };
    let th = if vertical { scrollbar.thumb(tr, b.h, b.contY, b.offY, b.maxY) } else { scrollbar.thumb(tr, b.w, b.contX, b.offX, b.maxX) };
    n.velX = 0.0;
    n.velY = 0.0;
    if part == scrollbar.Y_THUMB || part == scrollbar.X_THUMB {
        d.barNode = id;
        d.barPart = part;
        d.barGrab = m - th.pos;
    } else {
        let dir: f32 = 1.0;
        if m < th.pos {
            dir = -1.0;
        }
        if vertical {
            d.scrollBy(id, dir * n.h * 0.9);
        } else {
            d.scrollByX(id, dir * n.w * 0.9);
        }
    }
}

/// While the button is held on a dragged thumb, follow the mouse.
fn barDrag(d: &Dom) {
    let id = d.barNode;
    if id < 0 || id >= d.nodes.len || d.nodes.items[id].kind != K_ELEM {
        d.barNode = -1;
        return;
    }
    if !d.down {
        d.barNode = -1;
        return;
    }
    let n = &d.nodes.items[id];
    let b = barsOf(d, id);
    if d.barPart == scrollbar.Y_THUMB {
        let m = d.my - d.absY(id) - 2.0 - d.barGrab;
        let nv = scrollbar.offsetFor(scrollbar.trackY(&b), b.h, b.contY, b.maxY, m);
        if nv != n.scrollY { scrollMark(d, id); }
        n.scrollY = nv;
        scrolled(d);
    } else {
        let mx = d.mx - d.absX(id) - 2.0 - d.barGrab;
        let nvx = scrollbar.offsetFor(scrollbar.trackX(&b), b.w, b.contX, b.maxX, mx);
        if nvx != n.scrollX { scrollMark(d, id); }
        n.scrollX = nvx;
        scrolled(d);
    }
}

fn inputEvents(d: &Dom) {
    d.downHit = -1;
    d.upHit = -1;
    d.clickNode = -1;
    d.clickTo = -1;
    d.ctxNode = -1;
    d.barHover = scrollbar.NONE;
    d.barOf = -1;
    let target = -1;
    // a press on the open popup is the popup's (`j3.ui.inputs`), not the page's
    let onPop = popup.inside(&d.pop, d.mx, d.my);
    if d.nodes.len > 0 && d.mx >= 0.0 && d.my >= 0.0 {
        ensureStack(d);
        target = hitNode(d, 0, d.mx, d.my);
    }
    d.rawHit = target;
    // the inspector (`j3.ui.inspect`) only looks: hover, active, cursor and presses stay as they were when it came on
    if d.insp { return; }
    if target >= 0 && !allowedByModal(d, target) {
        // the dim behind a modal: it swallows the press (`j3.ui.overlay` may close the dialog)
        target = -1;
        d.barHover = scrollbar.NONE;
        d.barOf = -1;
    }
    let hv = target;
    if d.kbHover >= 0 {
        if d.moved || d.down != d.prevDown || (d.ovs.len == 0 && d.ptRoot < 0) || d.kbHover >= d.nodes.len || d.nodes.items[d.kbHover].kind != K_ELEM {
            d.kbHover = -1;
        } else {
            hv = d.kbHover;
        }
    }
    if d.holdId >= d.nodes.len || (d.holdId >= 0 && d.nodes.items[d.holdId].kind != K_ELEM) {
        d.holdId = -1;
    }
    setHover(d, hv, true);
    applyCursor(d, hv);
    if d.holdId >= 0 && d.now - d.holdT >= HOLD_MS {
        // the pointer did not reach the submenu in time
        d.holdId = -1;
        setChain(d, FL_HOVER, d.hover);
    }
    let pressed = d.down && !d.prevDown;
    let released = !d.down && d.prevDown;
    if d.rdown && !d.prevR {
        d.ctxNode = target;
        d.ctxX = d.mx;
        d.ctxY = d.my;
    }
    if d.kin.context && d.focus >= 0 && isFocusable(d, d.focus) && allowedByModal(d, d.focus) {
        d.ctxNode = d.focus;
        d.ctxX = d.absX(d.focus);
        d.ctxY = d.absY(d.focus) + d.nodes.items[d.focus].h;
    }
    if pressed {
        d.pressNode = target;
        d.downHit = target;
        if d.barOf == target && target >= 0 {
            barPress(d, target, d.barHover);
            d.pressNode = -1;
            d.downHit = -1;
        } else if !isDisabled(d, target) {
            setChain(d, FL_ACTIVE, target);
            startRipple(d, target);
        }
        if !onPop && d.pressNode >= 0 && !inCaretPop(d, target) {
            d.setKeyboard(false);
            d.focusNode(focusableAt(d, target));
        }
    }
    barDrag(d);
    d.dragNode = -1;
    if d.down || released {
        d.dragNode = d.pressNode;
    }
    if released {
        d.upHit = target;
        if d.pressNode >= 0 && d.pressNode == target && !isDisabled(d, target) {
            d.clickNode = target;
        }
        d.pressNode = -1;
        setChain(d, FL_ACTIVE, -1);
    }
    if d.wheelV != 0.0 && target >= 0 && !areaWheel(d, target) {
        wheelRoute(d, target, 0.0 - d.wheelV);
    }
    if d.coasting > 0 {
        stepCoast(d);
    }
    if d.snapPend > 0 {
        stepSnap(d);
    }
}

/// Drop the app's press state (pressed element, drag, active chain) when the inspector turns on or off, so a button held across the switch
/// leaves nothing stuck and no click fires for it.
pub fn dropPress(d: &Dom) {
    d.pressNode = -1;
    d.dragNode = -1;
    d.barNode = -1;
    setChain(d, FL_ACTIVE, -1);
}

/// The Motion of `id`, taking one from the pool (keeping its overlay style) when it has none.
fn ensureMotion(d: &Dom, id: int): int {
    let ti = d.nodes.items[id].tr;
    if ti >= 0 {
        return ti;
    }
    let m = motion.fresh();
    if d.trFree.len > 0 {
        d.trFree.len -= 1;
        ti = d.trFree.items[d.trFree.len].v;
        motion.adopt(&m, &d.trs.items[ti]);
        d.trs.items[ti] = m;
    } else {
        ti = d.trs.len;
        d.trs.push(m);
    }
    d.nodes.items[id].tr = ti;
    return ti;
}

/// Put `id` on the list `stepMotion` walks.
fn wake(d: &Dom, id: int) {
    if !d.nodes.items[id].inAct {
        d.nodes.items[id].inAct = true;
        d.act.push(Idx { v: id });
    }
}

/// Walk the subtree of `id` (whose Motion animates custom properties, `Motion.vn`) and rebuild the overlay of every element that reads
/// one it inherits (`motion.follow`); a subtree that declares the property itself is skipped. `release`: the animation is over,
/// put every follower back (`motionvar.unfollow`) and drop the Motions that have nothing else to do. Cost: one pass over the subtree
/// per frame while the property animates (a style lookup per element, a rebuild only for readers); nothing after.
fn followVars(d: &Dom, id: int, release: bool) {
    followWalk(d, d.nodes.items[id].first, id, release);
}

fn followWalk(d: &Dom, c: int, sid: int, release: bool) {
    while c >= 0 {
        let nxt = d.nodes.items[c].next;
        let down = true;
        if d.nodes.items[c].kind == K_ELEM && d.nodes.items[c].tstyle >= 0 {
            let st = d.nodes.items[c].tstyle;
            let ti = d.nodes.items[c].tr;
            if release {
                if ti >= 0 && d.trs.items[ti].vf {
                    if motionvar.unfollow(&d.trs.items[ti], d.css, st, &d.trs.items[d.nodes.items[sid].tr]) != 0 {
                        markDirty(d, c);
                    }
                    if !motion.active(&d.trs.items[ti]) {
                        dropMotion(d, c);
                    } else if d.nodes.items[c].inAct == false {
                        d.nodes.items[c].style = d.trs.items[ti].ov;
                    }
                }
            } else if ti >= 0 && (d.trs.items[ti].vn > 0 || d.trs.items[ti].vprev > 0) {
                // animates custom properties of its own: its walk covers its subtree
                down = false;
            } else {
                let k = motionvar.followKind(&d.trs.items[d.nodes.items[sid].tr], d.css, st);
                if k == 2 {
                    down = false;
                } else if k == 1 {
                    let tj = ensureMotion(d, c);
                    d.followed += 1;
                    let r = motionvar.follow(&d.trs.items[tj], d.css, st, &d.trs.items[d.nodes.items[sid].tr]);
                    d.nodes.items[c].style = d.trs.items[tj].ov;
                    d.trs.items[d.nodes.items[sid].tr].vdesc = true;
                    if r != 0 {
                        markDirty(d, c);
                    }
                }
            }
        }
        if down {
            followWalk(d, d.nodes.items[c].first, sid, release);
        }
        c = nxt;
    }
}

/// The animation of custom properties on `id` ended (or its Motion goes away): release the followers.
fn endFollow(d: &Dom, id: int) {
    let ti = d.nodes.items[id].tr;
    if ti >= 0 && d.trs.items[ti].vdesc {
        d.trs.items[ti].vn = 0;
        d.trs.items[ti].vt = 0;
        followVars(d, id, true);
        d.trs.items[d.nodes.items[id].tr].vdesc = false;
    }
}

fn dropMotion(d: &Dom, id: int) {
    endFollow(d, id);
    let n = &d.nodes.items[id];
    d.animating -= motion.live(&d.trs.items[n.tr]);
    if d.trs.items[n.tr].sp {
        d.spMo -= 1;
    }
    motion.release(&d.trs.items[n.tr]);
    d.trFree.push(Idx { v: n.tr });
    n.tr = -1;
    n.inAct = false;
    n.style = n.tstyle;
}

/// Keep `Dom.spMo` equal to the number of Motions that move spacing (`motion.spacing`), as `m` changed.
fn syncSpacing(d: &Dom, m: &Motion) {
    let sp = motion.spacing(m, d.css);
    if sp != m.sp {
        d.spMo += if sp { 1 } else { -1 };
        m.sp = sp;
    }
}

/// The computed style of element `id` is now `st` (it was `old`, -1 for its first): start its
/// transitions and animation, and pick the style that layout and paint read (its overlay while it moves).
fn moveStyle(d: &Dom, id: int, old: int, st: int) {
    let n = &d.nodes.items[id];
    if n.tr < 0 && !motion.wants(d.css, st, old < 0) {
        n.style = st;
        return;
    }
    let m = &d.trs.items[ensureMotion(d, id)];
    let before = motion.live(m);
    motion.onStyle(m, d.css, old, st, d.now);
    d.animating += motion.live(m) - before;
    syncSpacing(d, m);
    n.style = st;
    if motion.active(m) {
        n.style = m.ov;
        wake(d, id);
    } else if m.vdesc {
        endFollow(d, id);
    }
}

/// Advance every moving element to `d.now`: rewrite overlay styles and dirty the layout of those
/// whose layout properties moved.
fn stepMotion(d: &Dom) {
    let i = 0;
    while i < d.act.len {
        let id = d.act.items[i].v;
        let n = &d.nodes.items[id];
        let keep = false;
        if n.kind == K_ELEM && n.tr >= 0 && n.inAct {
            let m = &d.trs.items[n.tr];
            let before = motion.live(m);
            let r = motion.step(m, d.css, n.tstyle, d.now, n.adelay);
            d.animating += motion.live(m) - before;
            if m.sp {
                syncSpacing(d, m);
            }
            if m.vn > 0 {
                followVars(d, id, false);
            } else if m.vdesc {
                endFollow(d, id);
            }
            m = &d.trs.items[n.tr];
            if (r / motionbase.STEP_LAYOUT) % 2 == 1 {
                markDirty(d, id);
            }
            if !motion.active(m) {
                n.style = n.tstyle;
            }
            keep = r % 2 == 1;
        }
        if keep {
            i += 1;
        } else {
            if n.kind == K_ELEM {
                n.inAct = false;
            }
            d.act.len -= 1;
            d.act.items[i] = d.act.items[d.act.len];
        }
    }
}

/// Drop `id`'s flip record (its node is being freed): swap-remove, repointing the moved record's node.
fn unflip(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let i = n.flip;
    let f = &d.flips.items[i];
    d.flips.len -= 1;
    if i < d.flips.len {
        d.flips.items[i] = d.flips.items[d.flips.len];
        d.nodes.items[d.flips.items[i].node].flip = i;
    }
    n.flip = -1;
}

/// `animate:flip`, after layout: a listed node whose layout position moved since last frame starts a
/// glide from where it was drawn (offset = old - new, plus any flight still going), then every flight
/// is stepped to `d.now`. A viewport resize only re-records positions, and a scroll never moves
/// `n.x` / `n.y`, so neither flips. Paint-only: nothing here dirties layout or style. Idle cost: two compares per record.
/// Under `prefers-reduced-motion` (`Css.reduced`) positions are still recorded but no flight starts and offsets stay 0;
/// `Dom.setPrefs` zeroes flights already in the air when it turns on.
fn stepFlips(d: &Dom, w: f32, h: f32) {
    let resized = w != d.flipVw || h != d.flipVh;
    d.flipVw = w;
    d.flipVh = h;
    let live = 0;
    for i in 0..d.flips.len {
        let f = &d.flips.items[i];
        let n = &d.nodes.items[f.node];
        if f.seen && !resized && (n.x != f.x || n.y != f.y) && f.ms > 0.0 && !d.css.reduced {
            f.ox0 = f.ox + f.x - n.x;
            f.oy0 = f.oy + f.y - n.y;
            f.t0 = d.now;
            f.ox = f.ox0;
            f.oy = f.oy0;
        }
        f.x = n.x;
        f.y = n.y;
        f.seen = true;
        if f.ox0 != 0.0 || f.oy0 != 0.0 {
            let t = (d.now - f.t0) / f.ms;
            if t >= 1.0 || resized || d.css.reduced {
                f.ox0 = 0.0;
                f.oy0 = 0.0;
                f.ox = 0.0;
                f.oy = 0.0;
            } else {
                live += 1;
                let k = 1.0 - anim.ease(&d.css.eases.items[f.ease], t);
                f.ox = f.ox0 * k;
                f.oy = f.oy0 * k;
            }
        }
    }
    d.flipLive = live;
}
