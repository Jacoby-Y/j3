// Part of j3.ui.dom (Colors, effects, backgrounds, controls, text, and the paint walk.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn cr(c: int): int {
    return (c / 16777216) % 256;
}

fn cg(c: int): int {
    return (c / 65536) % 256;
}

fn cb(c: int): int {
    return (c / 256) % 256;
}

fn ca(c: int): int {
    return c % 256;
}

pub fn toColor(c: int): Color {
    return Color { r: u8(cr(c)), g: u8(cg(c)), b: u8(cb(c)), a: u8(ca(c)) };
}

/// A color property of style `st` as a packed color (`currentcolor` resolved, unset is transparent).
pub fn colorOf(d: &Dom, st: int, prop: int): int {
    let v = d.css.get(st, prop);
    if v.kind == V_COLOR {
        return v.c;
    }
    if v.kind == V_CURRENT && prop != P_COLOR {
        let tv = d.css.get(st, P_COLOR);
        if tv.kind == V_COLOR {
            return tv.c;
        }
        return 255;
    }
    if v.kind == V_CURRENT {
        return 255;
    }
    return 0;
}

fn opacityOf(d: &Dom, st: int): f32 {
    let v = d.css.get(st, P_OPACITY);
    if v.kind == V_NUM {
        return v.f;
    }
    return 1.0;
}

const PB_ALPHA: int = 1;

const PB_SCALE: int = 2;

const PB_CLIP: int = 4;

const PB_HIDDEN: int = 8;

const PB_MOVE: int = 16;

/// An ancestor is hidden: nothing was pushed.
const PB_SKIP: int = 32;

const PB_FIXED: int = 64;

/// A `clip-path` outline and a `mask-image` were pushed.
const PB_SHAPE: int = 128;

const PB_MASK: int = 256;

const PB_POST: int = 512;

/// An outer projection capture separates own coverage from ancestor coverage.
const PB_PROJECT: int = 1024;

/// A `slide` transition clip and a `scale` transition transform were pushed (`trans.j3`).
const PB_TCLIP: int = 2048;

const PB_TSCALE: int = 4096;

/// Post-processing settings for a box. Filter amounts are stored in renderer order, independently
/// of transform/motion; projection angles are J3 extensions and do not affect layout or hit testing.
pub fn effectsOf(d: &Dom, st: int): Effects {
    let fx = Effects {
        blur: 0.0, bloom: 0.0, bloomThreshold: 0.7, grain: 0.0, scanlines: 0.0, crt: 0.0,
        brightness: 1.0, contrast: 1.0, saturation: 1.0, grayscale: 0.0, sepia: 0.0,
        invert: 0.0, hue: 0.0, blend: kwOf(d, st, P_MIX_BLEND_MODE), shader: 0,
        time: d.now / 1000.0, perspective: numOf(d, st, P_PERSPECTIVE),
        rotateX: numOf(d, st, P_ROTATE_X), rotateY: numOf(d, st, P_ROTATE_Y)
    };
    let v = d.css.get(st, P_FILTER);
    if v.kind == V_LIST {
        let a = d.css.paints.items;
        fx.blur = a[v.i];
        fx.bloom = a[v.i + 1];
        fx.grain = a[v.i + 2];
        fx.scanlines = a[v.i + 3];
        fx.crt = a[v.i + 4];
        fx.brightness = a[v.i + 5];
        fx.contrast = a[v.i + 6];
        fx.saturation = a[v.i + 7];
        fx.grayscale = a[v.i + 8];
        fx.sepia = a[v.i + 9];
        fx.invert = a[v.i + 10];
        fx.hue = a[v.i + 11];
    }
    return fx;
}

fn needsPost(d: &Dom, st: int): bool {
    return vkind(d, st, P_FILTER) == V_LIST || kwOf(d, st, P_MIX_BLEND_MODE) != 0 || numOf(d, st, P_PERSPECTIVE) > 0.0 || numOf(d, st, P_ROTATE_X) != 0.0 || numOf(d, st, P_ROTATE_Y) != 0.0;
}

fn projectedCoverage(d: &Dom, st: int): bool {
    return (numOf(d, st, P_ROTATE_X) != 0.0 || numOf(d, st, P_ROTATE_Y) != 0.0) && (vkind(d, st, P_CLIP_PATH) == V_LIST || vkind(d, st, P_MASK_IMAGE) == V_GRAD);
}

fn hasBit(f: int, bit: int): bool {
    return (f / bit) % 2 == 1;
}

/// Round to a physical pixel: whole logical px at 1x, whole device px (so 1.5x edges stay sharp) otherwise.
/// `paintScale`, not `dpiScale`: `setUiScale` moves the device grid too.
fn rnd(v: f32): f32 {
    let k = game.paintScale();
    if k != 1.0 {
        return rnd1(v * k) / k;
    }
    return rnd1(v);
}

fn rnd1(v: f32): f32 {
    if v >= 0.0 {
        return f32(int(v + 0.5));
    }
    return 0.0 - f32(int(0.5 - v));
}

pub fn accentOf(d: &Dom, st: int): int {
    let v = d.css.get(st, P_ACCENT_COLOR);
    if v.kind == V_COLOR {
        return v.c;
    }
    // browser default accent
    return 7733247;
}

/// Open `id`: push its place, clips, transform and effects, and when `mine` draw its own box. A box reopened only to reach a
/// stacking-context entry below it (`paintEntry`) is not `mine`: it pushes the same state and draws nothing.
fn paintOpen(d: &Dom, id: int, mine: bool) {
    let n = &d.nodes.items[id];
    n.pflags = 0;
    if d.psp + 2 >= MAX_DEPTH {
        panic("dom: paint nesting too deep");
    }
    // slot offsets are per element: save the outer ones
    d.psp += 1;
    d.pst[d.psp] = id;
    d.pcu[d.psp] = -1;
    d.ptarget[d.psp] = -1;
    d.pz[d.psp] = if mine { 1 } else { 0 };
    d.pv[2 * d.psp] = d.base;
    d.pv[2 * d.psp + 1] = d.scale;
    d.base = 0;
    d.scale = SLOT_UNIT;
    if d.hidden > 0 {
        n.pflags = PB_SKIP;
        return;
    }
    if n.disp == DP_NONE {
        d.hidden += 1;
        n.pflags = PB_HIDDEN;
        return;
    }
    let st = n.style;
    let par = n.parent;
    let ps: f32 = 0.0;
    let psx: f32 = 0.0;
    if par >= 0 {
        ps = d.nodes.items[par].scrollY;
        psx = d.nodes.items[par].scrollX;
        if !n.isFixed && farOff(d, par, id) {
            d.hidden += 1;
            n.pflags = PB_HIDDEN;
            return;
        }
    }
    if n.isFixed {
        // viewport coordinates, not clipped by the ancestors
        paint.pushNoClip();
        paint.pushIdentity();
        n.pflags = PB_FIXED;
        paint.pushTranslate(Vec2 { x: rnd(n.x), y: rnd(n.y) });
    } else {
        paint.pushTranslate(Vec2 { x: rnd(n.x - psx + d.flipDx(id) + transDx(d, id)), y: rnd(n.y + n.sy - ps + d.flipDy(id) + transDy(d, id)) });
    }
    n.pflags = n.pflags + PB_MOVE;
    let w = rnd(n.w);
    let h = rnd(n.h);
    let tk = transKind(d, id);
    let ta = transAmt(d, id);
    let a = opacityOf(d, st) * (if tk == 3 { 1.0 } else { ta });
    if a < 1.0 {
        paint.pushAlpha(a);
        n.pflags = n.pflags + PB_ALPHA;
    }
    if tk == 3 {
        // the box itself shrinks in layout (`slideSize`); what it holds stays at its natural place, clipped
        paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h });
        n.pflags = n.pflags + PB_TCLIP;
    }
    if tk == 4 {
        paint.pushXform(Vec2 { x: w / 2.0, y: h / 2.0 }, Vec2 { x: 0.0, y: 0.0 }, 0.0, transScale(d, id));
        n.pflags = n.pflags + PB_TSCALE;
    }
    if mine && paintVisible(d, id) && n.ov == OV_MODAL && n.isFixed {
        let bc = d.css.get(st, P_BACKDROP);
        let col = if bc.kind == V_COLOR { toColor(bc.c) } else { Color { r: 0, g: 0, b: 0, a: 140 } };
        paint.rect(Vec2 { x: 0.0 - rnd(n.x), y: 0.0 - rnd(n.y) }, Vec2 { x: d.vw, y: d.vh }, col);
    }
    let xf = xform.of(d.css, st, w, h);
    if xf.on {
        paint.pushAffine(xf.a, xf.b, xf.c, xf.d, xf.e, xf.f);
        n.pflags = n.pflags + PB_SCALE;
    }
    if mine && projectedCoverage(d, st) {
        // Own mask/shape belongs on the projected texture; ancestor coverage stays screen-fixed.
        // The inner filter capture applies own coverage once over overlapping backgrounds/children.
        paint.beginLayer();
        n.pflags = n.pflags + PB_PROJECT;
    }
    if mediastyle.pushClipPath(d.css, st, w, h) {
        n.pflags = n.pflags + PB_SHAPE;
    }
    if mediastyle.pushMask(d.css, st, w, h) {
        n.pflags = n.pflags + PB_MASK;
    }
    if mine {
        if needsPost(d, st) {
            // A group contains this box and its whole stacking context (every descendant, whatever its z-index).
            // beginLayer clears the saved clip/mask state; endLayer applies it once to the result.
            paint.beginLayer();
            n.pflags = n.pflags + PB_POST;
        }
        if paintVisible(d, id) { paintBackground(d, id, st, w, h); }
        if paintVisible(d, id) { paintOutline(d, st, w, h); }
        if paintVisible(d, id) && (n.tag == d.tInput || n.tag == d.tSelect || n.tag == d.tProgress || n.tag == d.tMeter) {
            paintControl(d, id, st, w, h);
        }
        if paintVisible(d, id) && n.media > 0 {
            paintMedia(d, id, st, w, h);
        }
    }
    if isClip(d, st) {
        if n.scrollY > n.scrollMax {
            n.scrollY = n.scrollMax;
        }
        // an axis that does not clip gets a rect far past the box
        let cx = clipsOn(d, st, P_OVERFLOW_X);
        let cy = clipsOn(d, st, P_OVERFLOW_Y);
        paint.pushClip(Vec2 { x: if cx { 0.0 } else { -1000000.0 }, y: if cy { 0.0 } else { -1000000.0 } }, Vec2 { x: if cx { w } else { 2000000.0 }, y: if cy { h } else { 2000000.0 } });
        n.pflags = n.pflags + PB_CLIP;
    }
    if n.frag0 >= 0 && mine {
        paintFrags(d, id, id);
    }
}

/// `outline`: a ring outside the border box, `outline-offset` away from it, taking no layout space. Drawn under the children.
/// ponytail: children and later siblings paint over it; move the call to `paintClose` if that shows.
fn paintOutline(d: &Dom, st: int, w: f32, h: f32) {
    let style = kwOf(d, st, P_OUTLINE_STYLE);
    let ow = edgeOf(d, st, P_OUTLINE_WIDTH, w);
    if style == BORDER_NONE || ow <= 0.0 {
        return;
    }
    let g = edgeOf(d, st, P_OUTLINE_OFFSET, w) + ow;
    let c = Corners {
        tl: max(0.0, edgeOf(d, st, P_RADIUS_TL, w) + g), tr: max(0.0, edgeOf(d, st, P_RADIUS_TL + 1, w) + g),
        br: max(0.0, edgeOf(d, st, P_RADIUS_TL + 2, w) + g), bl: max(0.0, edgeOf(d, st, P_RADIUS_TL + 3, w) + g),
    };
    let pos = Vec2 { x: 0.0 - g, y: 0.0 - g };
    let size = Vec2 { x: w + 2.0 * g, y: h + 2.0 * g };
    let col = toColor(colorOf(d, st, P_OUTLINE_COLOR));
    if style == BORDER_DASHED || style == BORDER_DOTTED {
        paint.roundRectDashed(pos, size, c, toColor(0), ow, col, style);
    } else {
        paint.roundRectEx(pos, size, c, toColor(0), ow, col);
    }
}

/// Stops of the layer at `paints[o]` (`[type, angle, nstops, stops...]`) as a ramp row.
fn layerRow(d: &Dom, o: int): int {
    return mediastyle.layerRow(d.css, o);
}

/// Draw the gradient layer at `paints[o]` over the box, filling it (`onBorder` false) or as the
/// border of width `bw`.
fn paintGradient(d: &Dom, o: int, pos: Vec2, size: Vec2, c: Corners, bw: f32, none: Color, onBorder: bool, border: Color) {
    let a = d.css.paints.items;
    let row = layerRow(d, o);
    if onBorder {
        paint.gradientBorder(pos, size, c, none, bw, row, int(a[o]), a[o + 1]);
    } else {
        paint.gradientRect(pos, size, c, row, int(a[o]), a[o + 1], bw, border);
    }
}

/// True when the shadow list at `paints[o]` has an inset shadow.
fn hasInset(d: &Dom, o: int): bool {
    let a = d.css.paints.items;
    let n = int(a[o]);
    for i in 0..n {
        if a[o + 1 + i * 9] > 0.5 {
            return true;
        }
    }
    return false;
}

/// Draw the inset (`inset` true) or outer shadows of the list at `paints[o]`, last first so the
/// first listed ends on top.
fn paintShadows(d: &Dom, o: int, inset: bool, pos: Vec2, size: Vec2, c: Corners) {
    let a = d.css.paints.items;
    let i = int(a[o]) - 1;
    while i >= 0 {
        let q = o + 1 + i * 9;
        if (a[q] > 0.5) == inset {
            let col = Color { r: u8(a[q + 5]), g: u8(a[q + 6]), b: u8(a[q + 7]), a: u8(a[q + 8]) };
            let off = Vec2 { x: a[q + 1], y: a[q + 2] };
            if inset {
                paint.insetShadow(pos, size, c, off, a[q + 3], a[q + 4], col);
            } else {
                paint.shadow(pos, size, c, off, a[q + 3], a[q + 4], col);
            }
        }
        i -= 1;
    }
}

/// Draw what an `<img>` or `<svg>` shows inside its border box (`j3.ui.media`).
fn paintMedia(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let m = &d.media.items[n.media - 1];
    let e = edgesOf(d, st, n.basisW);
    let l = e.bl + e.pl;
    let t = e.bt + e.pt;
    if n.tag == d.tImg {
        let sty = mediastyle.imgStyle(d.css, st, l, t, e.br + e.pr, e.bb + e.pb, vf(d, st, P_RADIUS_TL), vf(d, st, P_RADIUS_TL + 1), vf(d, st, P_RADIUS_TL + 2), vf(d, st, P_RADIUS_TL + 3));
        media.drawImg(m, w, h, &sty, d.now);
    } else if n.tag == d.tSvg {
        let cw = w - l - e.br - e.pr;
        let ch = h - t - e.bb - e.pb;
        let vm = imgfit.viewMap(cw, ch, m.vb[0], m.vb[1], m.vb[2], m.vb[3]);
        if !m.hasVb {
            vm = imgfit.viewMap(cw, ch, 0.0, 0.0, 300.0, 150.0);
        }
        let cur = toColor(colorOf(d, st, P_COLOR));
        let acc = toColor(accentOf(d, st));
        paint.pushTranslate(Vec2 { x: l, y: t });
        paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: cw, y: ch });
        let c = n.first;
        while c >= 0 {
            let k = &d.nodes.items[c];
            if k.kind == K_ELEM && k.tag == d.tPath && k.media > 0 {
                media.drawPath(&d.media.items[k.media - 1], vm.s, vm.ox, vm.oy, cur, acc);
            }
            c = k.next;
        }
        paint.popClip();
        paint.popTransform();
    }
}

/// The texture of a `url()` value, loaded once per path.
fn urlTexture(d: &Dom, v: Value): Texture {
    return media.load(&d.imgs, d.mem, d.css.name(v.i));
}

fn paintBackground(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let bg = colorOf(d, st, P_BACKGROUND);
    let clip = kwOf(d, st, P_BG_CLIP) == CLIP_TEXT;
    if clip {
        // the background shows through the glyphs instead (`paintFrags`)
        bg = 0;
    }
    let e = edgesOf(d, st, n.basisW);
    let bt = e.bt;
    let br = e.br;
    let bb = e.bb;
    let bl = e.bl;
    let rtl = max(0.0, edgeOf(d, st, P_RADIUS_TL, w));
    let rtr = max(0.0, edgeOf(d, st, P_RADIUS_TL + 1, w));
    let rbr = max(0.0, edgeOf(d, st, P_RADIUS_TL + 2, w));
    let rbl = max(0.0, edgeOf(d, st, P_RADIUS_TL + 3, w));
    let hasBorder = bt > 0.0 || br > 0.0 || bb > 0.0 || bl > 0.0;
    let img = d.css.get(st, P_BG_IMAGE);
    if clip {
        img.kind = V_NONE;
    }
    let shade = d.css.get(st, P_BOX_SHADOW);
    let bimg = d.css.get(st, P_BORDER_IMAGE);
    let bsv = d.css.get(st, P_BORDER_STYLE);
    let bstyle = bsv.i;
    let zero = Vec2 { x: 0.0, y: 0.0 };
    let size = Vec2 { x: w, y: h };
    let corners = Corners { tl: rtl, tr: rtr, br: rbr, bl: rbl };
    if shade.kind == V_SHADOW {
        paintShadows(d, shade.i, false, zero, size, corners);
    }
    let backdrop = d.css.get(st, P_BACKDROP_FILTER);
    if backdrop.kind == V_PX && backdrop.f > 0.0 {
        paint.backdropBlur(zero, size, corners, backdrop.f);
    }
    let urlBorder = bimg.kind == V_URL;
    let extras = img.kind == V_GRAD || img.kind == V_URL || urlBorder || (bimg.kind == V_GRAD && hasBorder) || (bstyle != BORDER_SOLID && bstyle != BORDER_NONE && hasBorder) || (shade.kind == V_SHADOW && hasInset(d, shade.i));
    if ca(bg) == 0 && !hasBorder && !extras {
        return;
    }
    let round = rtl > 0.0 || rtr > 0.0 || rbr > 0.0 || rbl > 0.0;
    let c0 = colorOf(d, st, P_BORDER_TOP_COLOR);
    let uniform = (bt == br && br == bb && bb == bl) || urlBorder;
    if extras && (uniform || !hasBorder) {
        // base color, gradient layers (first on top), inset shadows, then the border over them
        if ca(bg) > 0 {
            if round {
                paint.roundRectEx(zero, size, corners, toColor(bg), 0.0, toColor(0));
            } else {
                paint.rect(zero, size, toColor(bg));
            }
        }
        if img.kind == V_GRAD {
            let o = img.i;
            let nl = int(d.css.paints.items[o]);
            let at = o + 1;
            let offs: [8]int = [0, 0, 0, 0, 0, 0, 0, 0];
            for q in 0..nl {
                if q < 8 {
                    offs[q] = at;
                }
                at += 3 + 5 * int(d.css.paints.items[at + 2]);
            }
            let q = nl - 1;
            if q > 7 {
                q = 7;
            }
            while q >= 0 {
                if d.css.paints.items[offs[q]] > 8.5 {
                    // a url() layer: its own size, position and repeat entry (`cssimage.LAYER_URL`)
                    let pid = int(d.css.paints.items[offs[q] + 1]);
                    if pid >= 0 {
                        let ls = mediastyle.bgStyle(d.css, st, q, rtl, rtr, rbr, rbl);
                        media.drawBg(media.load(&d.imgs, d.mem, d.css.name(pid)), w, h, &ls);
                    }
                } else {
                    paintGradient(d, offs[q], zero, size, corners, 0.0, toColor(0), false, toColor(0));
                }
                q -= 1;
            }
        }
        if img.kind == V_URL {
            let bs = mediastyle.bgStyle(d.css, st, 0, rtl, rtr, rbr, rbl);
            media.drawBg(urlTexture(d, img), w, h, &bs);
        }
        if shade.kind == V_SHADOW {
            paintShadows(d, shade.i, true, zero, size, corners);
        }
        if urlBorder {
            mediastyle.drawBorderImage(d.css, st, urlTexture(d, bimg), w, h, bt, br, bb, bl);
        } else if hasBorder {
            if bimg.kind == V_GRAD {
                paintGradient(d, bimg.i + 1, zero, size, corners, bt, toColor(0), true, toColor(0));
            } else if bstyle != BORDER_NONE {
                if bstyle != BORDER_SOLID {
                    paint.roundRectDashed(zero, size, corners, toColor(0), bt, toColor(c0), bstyle);
                } else {
                    paint.roundRectEx(zero, size, corners, toColor(0), bt, toColor(c0));
                }
            }
        }
        return;
    }
    if hasBorder && uniform {
        paint.roundRectEx(zero, size, corners, toColor(bg), bt, toColor(c0));
        return;
    }
    if round {
        paint.roundRectEx(zero, size, corners, toColor(bg), 0.0, toColor(0));
    } else if ca(bg) > 0 {
        paint.rect(zero, size, toColor(bg));
    }
    // one-sided borders are flat strips over the fill (the example uses them on square corners)
    if bt > 0.0 {
        paint.rect(zero, Vec2 { x: w, y: bt }, toColor(c0));
    }
    if br > 0.0 {
        paint.rect(Vec2 { x: w - br, y: 0.0 }, Vec2 { x: br, y: h }, toColor(colorOf(d, st, P_BORDER_TOP_COLOR + 1)));
    }
    if bb > 0.0 {
        paint.rect(Vec2 { x: 0.0, y: h - bb }, Vec2 { x: w, y: bb }, toColor(colorOf(d, st, P_BORDER_TOP_COLOR + 2)));
    }
    if bl > 0.0 {
        paint.rect(zero, Vec2 { x: bl, y: h }, toColor(colorOf(d, st, P_BORDER_TOP_COLOR + 3)));
    }
}

/// The next `<option>` child of `sel` after its child `c` (-1: from the first); -1 when none.
pub fn nextOption(d: &Dom, sel: int, c: int): int {
    let k = if c < 0 { d.nodes.items[sel].first } else { d.nodes.items[c].next };
    while k >= 0 {
        if d.nodes.items[k].kind == K_ELEM && d.nodes.items[k].tag == d.tOption {
            return k;
        }
        k = d.nodes.items[k].next;
    }
    return -1;
}

/// Sync after generated updates, before resolving/layout: a conditional source child may have been
/// removed since input built the rows. Never paint borrowed media or stale text for an extra frame.
fn refreshOptionVisuals(d: &Dom) {
    if d.ptRoot < 0 || d.pop.kind != popup.SELECT { return; }
    let row = d.nodes.items[d.ptRoot].first;
    while row >= 0 {
        if d.nodes.items[row].pidx >= 0 {
            let check = d.nodes.items[row].first;
            let label = if check >= 0 { d.nodes.items[check].next } else { -1 };
            if label >= 0 {
                let src = d.nodes.items[label].optionSource;
                d.buildIn(label);
                if src >= 0 && d.nodes.items[src].kind == K_ELEM && d.nodes.items[src].tag == d.tOption {
                    optionVisuals(d, src);
                }
                d.buildOut();
            }
        }
        row = d.nodes.items[row].next;
    }
}

/// Visual children of one option, mirrored only for the rows in the popup window. Matching uses the
/// source ancestry; layout/inheritance uses the real row. Media is borrowed, inline styles are owned.
/// Call only while building inside the row's label; source nodes remain under their logical option.
pub fn optionVisuals(d: &Dom, source: int) {
    let c = d.nodes.items[source].first;
    let slot = 0;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if !n.ghost && !n.rt {
            if n.kind == K_TEXT {
                d.text(d.textOf(c));
            } else if n.kind == K_ELEM {
                let tok = d.enter(slot / 4096);
                let id = d.open(slot % 4096, n.tag, n.scope);
                let out = &d.nodes.items[id];
                let changed = out.optionSource != c || out.media != n.media || out.optionGen != n.dirtyGen;
                let ancestor = c;
                while ancestor >= 0 {
                    if d.nodes.items[ancestor].styleDirty { changed = true; }
                    ancestor = d.nodes.items[ancestor].parent;
                }
                out.optionSource = c;
                out.optionGen = n.dirtyGen;
                out.media = n.media;
                // Match the logical tree (including scoped option selectors), without copying events,
                // focus flags, ids or overlay state into the visual tree.
                d.mnodes.items[id] = d.mnodes.items[c];
                if changed || out.born == d.frame {
                    if n.dyn >= 0 {
                        let a = &d.dyns.items[n.dyn];
                        let b = dynOf(d, id);
                        for k in 0..dynattr.SLOTS {
                            b.sk[k] = a.sk[k];
                            b.sn[k] = a.sn[k];
                        }
                        for k in 0..a.sp.len {
                            b.sp[k] = a.sp[k];
                            b.sv[k] = a.sv[k];
                        }
                        b.dirty = true;
                    } else if out.dyn >= 0 {
                        dynattr.reset(&d.dyns.items[out.dyn]);
                        d.dyns.items[out.dyn].dirty = true;
                    }
                    markStyle(d, id);
                    markDirty(d, id);
                }
                optionVisuals(d, c);
                d.close();
                d.leave(tok);
                slot += 1;
            }
        }
        c = n.next;
    }
}

/// Depth-first next descendant, bounded by the source option (never its runtime popup sibling).
fn optionNext(d: &Dom, opt: int, id: int): int {
    if d.nodes.items[id].first >= 0 && !d.nodes.items[id].rt && !d.nodes.items[id].ghost {
        return d.nodes.items[id].first;
    }
    let c = id;
    while c != opt {
        if d.nodes.items[c].next >= 0 { return d.nodes.items[c].next; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Full scalar label: concatenate descendant text in document order. An option owns a reusable byte
/// buffer; unchanged labels allocate nothing, including type-ahead and closed-select paint frames.
pub fn optLabel(d: &Dom, opt: int): string {
    if d.nodes.items[opt].optionGen == d.nodes.items[opt].dirtyGen { return d.textOf(opt); }
    let len = 0;
    let c = d.nodes.items[opt].first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_TEXT && !d.nodes.items[c].ghost { len += d.nodes.items[c].tlen; }
        c = optionNext(d, opt, c);
    }
    let n = &d.nodes.items[opt];
    if len > n.buf.len { n.buf = d.mem.alloc::<u8>(max4(len, n.buf.len * 2)); }
    let at = 0;
    c = n.first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_TEXT && !d.nodes.items[c].ghost {
            let t = d.textOf(c);
            for j in 0..t.len { n.buf[at + j] = t[j]; }
            at += t.len;
        }
        c = optionNext(d, opt, c);
    }
    n.tlen = len;
    n.optionGen = n.dirtyGen;
    return d.textOf(opt);
}

/// What an option is worth: its `value`, else its text.
pub fn optValue(d: &Dom, opt: int): string {
    if d.nodes.items[opt].sval.len > 0 {
        return d.nodes.items[opt].sval;
    }
    return optLabel(d, opt);
}

/// Whether option `opt` of `sel` is selected (`multiple`: its value is in the comma list).
pub fn optSelected(d: &Dom, sel: int, opt: int): bool {
    let v = d.nodes.items[sel].sval;
    if d.nodes.items[sel].multi {
        return csv.has(v, optValue(d, opt));
    }
    return same(v, optValue(d, opt));
}

fn bytesOf(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

fn alpha(c: Color, a: int): Color {
    return Color { r: c.r, g: c.g, b: c.b, a: u8(a) };
}

fn paintCheckbox(n: &Node, acc: Color, w: f32, h: f32) {
    let bx = Vec2 { x: w, y: h };
    let zero = Vec2 { x: 0.0, y: 0.0 };
    if n.checked {
        paint.roundRect(zero, bx, 3.0, acc);
        let white = Color { r: 255, g: 255, b: 255, a: 255 };
        paint.line(Vec2 { x: w * 0.24, y: h * 0.52 }, Vec2 { x: w * 0.43, y: h * 0.72 }, 2.0, white);
        paint.line(Vec2 { x: w * 0.43, y: h * 0.72 }, Vec2 { x: w * 0.78, y: h * 0.30 }, 2.0, white);
    } else {
        paint.roundRect(zero, bx, 3.0, Color { r: 88, g: 91, b: 112, a: 255 });
        paint.roundRect(Vec2 { x: 1.5, y: 1.5 }, Vec2 { x: w - 3.0, y: h - 3.0 }, 2.0, Color { r: 49, g: 50, b: 68, a: 255 });
    }
}

fn paintRadio(n: &Node, acc: Color, w: f32, h: f32) {
    let c = Vec2 { x: w * 0.5, y: h * 0.5 };
    let r = min(w, h) * 0.5;
    if n.checked {
        paint.circle(c, r, acc);
        paint.circle(c, r * 0.4, Color { r: 255, g: 255, b: 255, a: 255 });
    } else {
        paint.circle(c, r, Color { r: 88, g: 91, b: 112, a: 255 });
        paint.circle(c, r - 1.5, Color { r: 49, g: 50, b: 68, a: 255 });
    }
}

/// Which of a `<meter>`'s three regions `x` falls in: 0 below `low`, 1 between, 2 above `high`.
fn meterRegion(x: f32, low: f32, high: f32): int {
    if x < low { return 0; }
    if x > high { return 2; }
    return 1;
}

/// How good a `<meter>`'s value is, by the HTML rules: the region of the value against the region of its `optimum`. The same region is
/// 0 (good), the next one 1 (ok), the far one 2 (bad).
pub fn meterGrade(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    let lo = n.attrMin;
    let hi = max(n.attrMax, lo);
    let low = if n.mlow > METER_UNSET { max(lo, min(hi, n.mlow)) } else { lo };
    let high = if n.mhigh > METER_UNSET { max(low, min(hi, n.mhigh)) } else { hi };
    let opt = if n.mopt > METER_UNSET { max(lo, min(hi, n.mopt)) } else { (lo + hi) / 2.0 };
    let gap = meterRegion(n.value, low, high) - meterRegion(opt, low, high);
    if gap < 0 { gap = 0 - gap; }
    return gap;
}

/// How much of a `<progress>` or `<meter>` is filled, 0..1; -1 for a progress with no value (indeterminate).
pub fn gaugeFrac(d: &Dom, id: int): f32 {
    let n = &d.nodes.items[id];
    if n.tag == d.tMeter {
        let span = n.attrMax - n.attrMin;
        if span <= 0.0 { return 0.0; }
        return max(0.0, min(1.0, (n.value - n.attrMin) / span));
    }
    if n.value < 0.0 { return -1.0; }
    if n.attrMax <= 0.0 { return 0.0; }
    return min(1.0, n.value / n.attrMax);
}

/// Left edge, in the track, of the indeterminate bar `sw` wide in a track `cw` wide: it crosses every 1.4 s, and sits in the middle under
/// `prefers-reduced-motion`.
pub fn sweepX(d: &Dom, cw: f32, sw: f32): f32 {
    if d.css.reduced {
        return (cw - sw) / 2.0;
    }
    let t = (d.now - 1400.0 * f32(int(d.now / 1400.0))) / 1400.0;
    return (0.0 - sw) + t * (cw + sw);
}

/// A color custom property of style `st` (it resolves like `var()`: the node's own rules, then inherited), `dflt` when absent or not a color.
fn styleColorVar(d: &Dom, st: int, name: string, dflt: int): int {
    let v = varValue(d.css, d.css.varsOf(st), d.css.intern(name));
    if v.kind == V_COLOR {
        return v.c;
    }
    return dflt;
}

/// Fill `n.mc0..2` (good, ok, bad) for style `st`: looked up once per computed style, so a steady frame scans nothing.
fn meterColors(d: &Dom, n: &Node, st: int) {
    if n.mcSt == st {
        return;
    }
    n.mcSt = st;
    n.mc0 = styleColorVar(d, st, "--j3-meter-good", 1069109503);
    n.mc1 = styleColorVar(d, st, "--j3-meter-ok", 3533251327);
    n.mc2 = styleColorVar(d, st, "--j3-meter-bad", 4166076927);
}

/// The packed fill color of `<meter>` `id` (style `st`): its grade picks `--j3-meter-good`, `-ok` or `-bad`.
pub fn meterFill(d: &Dom, id: int, st: int): int {
    let n = &d.nodes.items[id];
    meterColors(d, n, st);
    let g = meterGrade(d, id);
    return if g == 0 { n.mc0 } else if g == 1 { n.mc1 } else { n.mc2 };
}

/// `<progress>` and `<meter>`: the element's own `background` is the track (painted before); this draws the fill inside its border, rounded by
/// its `border-radius`. A progress fills with `accent-color`, a meter with the good / ok / bad color of `meterGrade` (`--j3-meter-good`, `-ok`
/// and `-bad`, on `:root` or any ancestor or the meter itself). A progress without a value sweeps a bar across the track.
fn paintGauge(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.bl - e.br;
    let ch = h - e.bt - e.bb;
    if cw <= 0.0 || ch <= 0.0 {
        return;
    }
    let r = min(ch / 2.0, max(0.0, edgeOf(d, st, P_RADIUS_TL, w)));
    let at = Vec2 { x: e.bl, y: e.bt };
    let frac = gaugeFrac(d, id);
    let col = toColor(accentOf(d, st));
    if n.tag == d.tMeter {
        col = toColor(meterFill(d, id, st));
    }
    if frac > 0.0 {
        paint.roundRect(at, Vec2 { x: cw * frac, y: ch }, r, col);
    } else if frac < 0.0 {
        let sw = cw * 0.4;
        paint.pushClip(at, Vec2 { x: cw, y: ch });
        paint.roundRect(Vec2 { x: e.bl + sweepX(d, cw, sw), y: e.bt }, Vec2 { x: sw, y: ch }, r, col);
        paint.popClip();
    }
}

/// A text, search, password or textarea box inside its border box `w` x `h`: the text from the view start,
/// selection, caret and IME composition. A password shows one bullet per code point (`Edit.maskOf`); the
/// view start, caret and anchor then count bullets. Tells the IME where the caret is while focused.
fn paintField(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.pl - e.pr - e.bl - e.br;
    let ch = h - e.pt - e.pb - e.bt - e.bb;
    let font = fontOf(d, st);
    if font.raw == 0 || cw < 1.0 {
        return;
    }
    let ty = d.mnodes.items[id].type;
    let search = ty == d.vSearch;
    let pw = ty == d.vPassword;
    let ed = n.edit >= 0 && d.focus == id;
    let blink = false;
    let tc = toColor(colorOf(d, st, P_COLOR));
    let acc = toColor(accentOf(d, st));
    let look = Look { text: tc, hint: alpha(tc, 110), sel: alpha(acc, 100), caret: tc, chip: alpha(acc, 70), link: acc, dim: alpha(tc, 170) };
    let bold = isBold(d, st);
    let tm = enterText(d, st);
    let comp = if ed { d.kin.comp } else { "" };
    let at = Vec2 { x: -1.0, y: 0.0 };
    let atH = ch;
    paint.pushTranslate(Vec2 { x: e.bl + e.pl, y: e.bt + e.pt });
    paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: cw, y: ch });
    if ty == d.vTextarea {
        let t = &d.eds.items[d.claim(id)];
        blink = ed && int((d.now - t.t0) / 530.0) % 2 == 0;
        at = area.paint(t, font, bold, ed, blink, n.ph, comp, cw, ch, &look);
        t.px = at.x;
        t.py = at.y;
        atH = f32(fontLine(font));
    } else {
        let avail = if search { cw - 18.0 } else { cw };
        let s = n.sval;
        let vs = 0;
        let cur = 0;
        let anc = 0;
        if ed || pw {
            let te = &d.eds.items[d.claim(id)];
            if ed {
                s = te.str();
                blink = int((d.now - te.t0) / 530.0) % 2 == 0;
            }
            vs = te.vs;
            cur = te.cur;
            anc = te.anc;
            if pw {
                let m = te.maskOf(s);
                cur = textedit.toMask(s, cur);
                anc = textedit.toMask(s, anc);
                s = m;
            }
            if ed {
                vs = field.scroll(font, bold, s, vs, cur, avail);
                te.vs = vs;
            }
        }
        at.x = field.paint(font, bold, s, vs, cur, anc, ed, blink, n.ph, comp, avail, ch, &look);
        if search && s.len > 0 {
            let c = Vec2 { x: cw - 9.0, y: ch / 2.0 };
            paint.line(Vec2 { x: c.x - 4.0, y: c.y - 4.0 }, Vec2 { x: c.x + 4.0, y: c.y + 4.0 }, 1.5, alpha(tc, 150));
            paint.line(Vec2 { x: c.x - 4.0, y: c.y + 4.0 }, Vec2 { x: c.x + 4.0, y: c.y - 4.0 }, 1.5, alpha(tc, 150));
        }
    }
    paint.popClip();
    paint.popTransform();
    if ed && at.x >= 0.0 {
        game.textInputRect(d.absX(id) + e.bl + e.pl + at.x, d.absY(id) + e.bt + e.pt + at.y, 1.0, atH);
    }
    leaveText(tm);
}

/// A closed `<select>`: the chosen label(s) (or the placeholder) and a chevron.
fn paintSelect(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.pl - e.pr - e.bl - e.br;
    let ch = h - e.pt - e.pb - e.bt - e.bb;
    let font = fontOf(d, st);
    let tc = toColor(colorOf(d, st, P_COLOR));
    paint.pushTranslate(Vec2 { x: e.bl + e.pl, y: e.bt + e.pt });
    let cx = cw - 9.0;
    let cy = ch / 2.0;
    let open = d.pop.kind == popup.SELECT && d.pop.owner == id;
    let dy: f32 = if open { -3.0 } else { 3.0 };
    paint.line(Vec2 { x: cx - 4.0, y: cy - dy }, Vec2 { x: cx, y: cy + dy }, 1.5, alpha(tc, 170));
    paint.line(Vec2 { x: cx, y: cy + dy }, Vec2 { x: cx + 4.0, y: cy - dy }, 1.5, alpha(tc, 170));
    if font.raw != 0 && cw > 20.0 {
        paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: cw - 18.0, y: ch });
        let y = f32(int((ch - f32(fontLine(font))) / 2.0 + 0.5));
        let x: f32 = 0.0;
        let any = false;
        let bold = isBold(d, st);
        let tm = enterText(d, st);
        let o = nextOption(d, id, -1);
        while o >= 0 && x < cw {
            if optSelected(d, id, o) {
                let lab = optLabel(d, o);
                if any {
                    paint.text(font, Vec2 { x: x, y: y }, ", ", tc);
                    x += textWidth(font, bytesOf(", "), bold);
                }
                paint.text(font, Vec2 { x: x, y: y }, lab, tc);
                x += textWidth(font, bytesOf(lab), bold);
                any = true;
                if !n.multi {
                    break;
                }
            }
            o = nextOption(d, id, o);
        }
        if !any && n.ph.len > 0 {
            paint.text(font, Vec2 { x: 0.0, y: y }, n.ph, alpha(tc, 110));
        }
        leaveText(tm);
        paint.popClip();
    }
    paint.popTransform();
}

/// Checkbox, radio, range, text, color and select controls, drawn inside the (possibly styled) box.
fn paintControl(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let ty = d.mnodes.items[id].type;
    let acc = toColor(accentOf(d, st));
    if n.tag == d.tProgress || n.tag == d.tMeter {
        paintGauge(d, id, st, w, h);
    } else if n.tag == d.tSelect {
        paintSelect(d, id, st, w, h);
    } else if ty == d.vCheckbox {
        paintCheckbox(n, acc, w, h);
    } else if ty == d.vRadio {
        paintRadio(n, acc, w, h);
    } else if ty == d.vRange {
        slider.paint(w, h, n.attrMin, n.attrMax, n.value, n.high, n.multi, acc, d.focus == id, d.thumb);
    } else if ty == d.vColor {
        let rgb = colorpick.parseHex(n.sval);
        if rgb < 0 {
            rgb = 0;
        }
        paint.roundRect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h }, 4.0, colorpick.color(rgb));
    } else {
        paintField(d, id, st, w, h);
    }
}

/// Text color of text node `tn`; an animating `color` on the element `oe` carries over when the
/// text inherits it.
fn textColor(d: &Dom, tn: int, oe: int): int {
    let c = colorOf(d, d.nodes.items[tn].style, P_COLOR);
    if oe >= 0 {
        let o = &d.nodes.items[oe];
        if o.style != o.tstyle && colorOf(d, o.tstyle, P_COLOR) == c {
            return colorOf(d, o.style, P_COLOR);
        }
    }
    return c;
}

/// How the text of one block is filled: a plain color, or (`background-clip: text`) the block's
/// linear gradient measured over its border box.
struct TextFill {
    grad: bool;
    row: int;
    a: Vec2;
    b: Vec2;
    /// Replaces the text color when `background-clip: text` has a plain background color (alpha 0: none).
    flat: int;
}

fn textFillOf(d: &Dom, owner: int): TextFill {
    let none = TextFill { grad: false, row: 0, a: Vec2 { x: 0.0, y: 0.0 }, b: Vec2 { x: 0.0, y: 0.0 }, flat: 0 };
    let n = &d.nodes.items[owner];
    if n.kind != K_ELEM || kwOf(d, n.style, P_BG_CLIP) != CLIP_TEXT {
        return none;
    }
    none.flat = colorOf(d, n.style, P_BACKGROUND);
    let img = d.css.get(n.style, P_BG_IMAGE);
    if img.kind == V_GRAD {
        let o = img.i + 1;
        let a = d.css.paints.items;
        if int(a[o]) == 0 {
            let ln = textfx.gradientLine(rnd(n.w), rnd(n.h), a[o + 1]);
            return TextFill { grad: true, row: layerRow(d, o), a: ln.a, b: ln.b, flat: 0 };
        }
    }
    return none;
}

/// One string of text at `pos` with the effects of `st`: shadows, outline, then the fill. With
/// `text-wave` each code point is its own run, lifted by `textwave.lift` (effects follow the glyph).
fn paintRun(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    // `font-style: italic | oblique`: the face has no slanted twin, so the run is sheared about its baseline
    // ponytail: faux italic; a real italic face via `@font-face` would be crisper
    let slant = kwOf(d, st, P_FONT_STYLE) != 0;
    if slant {
        paint.pushSkew(Vec2 { x: pos.x, y: pos.y + f32(fontAscent(font)) }, 0.2);
    }
    paintRunFx(d, st, font, bold, pos, seg, col, fill);
    if slant {
        paint.popTransform();
    }
}

fn paintRunFx(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    let amp = vf(d, st, P_WAVE_AMP);
    let len = vf(d, st, P_WAVE_LEN);
    let period = vf(d, st, P_WAVE_PERIOD);
    if !textwave.on(amp, len, period) {
        paintPlain(d, st, font, bold, pos, seg, col, fill);
        return;
    }
    let bytes = []u8 { ptr: seg.ptr, len: seg.len };
    let x = pos.x;
    let i = 0;
    while i < seg.len {
        let e = i + cpLen(bytes, i);
        let at = Vec2 { x: x, y: pos.y + rnd(textwave.lift(amp, len, period, d.now, x)) };
        if int(seg[i]) != 32 {
            paintPlain(d, st, font, bold, at, seg[i..e], col, fill);
        }
        x += textWidth(font, bytes[i..e], bold);
        i = e;
    }
}

fn paintPlain(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    let sh = d.css.get(st, P_TEXT_SHADOW);
    if sh.kind == V_SHADOW {
        textfx.shadowList(font, pos, seg, bold, d.css.paints.items, sh.i);
    }
    let sw = vf(d, st, P_STROKE_WIDTH);
    if sw > 0.0 {
        textfx.outline(font, pos, seg, sw, toColor(colorOf(d, st, P_STROKE_COLOR)), bold);
    }
    if fill.grad {
        paint.textGradient(font, pos, seg, fill.row, fill.a, fill.b, 1.0, bold);
    } else if bold {
        paint.textBold(font, pos, seg, toColor(col));
    } else {
        paint.text(font, pos, seg, toColor(col));
    }
    let line = kwOf(d, st, P_TEXT_DECORATION);
    if line != 0 {
        // `text-decoration-line`: a bar as wide as the run, as thick as the font is tall / 14
        let thick = max(1.0, rnd(f32(fontLine(font)) / 14.0));
        let asc = f32(fontAscent(font));
        let y = pos.y;
        if line == 1 {
            y = pos.y + asc + thick;
        } else if line == 2 {
            y = pos.y + rnd(asc * 0.65);
        }
        paint.rect(Vec2 { x: pos.x, y: y }, Vec2 { x: textWidth(font, bytesOf(seg), bold), y: thick }, toColor(col));
    }
}

/// The highlight behind the selected part of fragment `fr` (`Node.sa..sb`, see `j3.ui.textsel`).
fn paintSel(d: &Dom, tn: &Node, fr: Frag, font: Font, bold: bool, pos: Vec2, whole: []u8) {
    let lo = maxi(tn.sa, fr.start);
    let hi = mini(mini(tn.sb, fr.end), tn.tlen);
    if lo >= hi {
        return;
    }
    let acc = toColor(accentOf(d, tn.style));
    let seg = whole[fr.start..fr.end];
    if seg.len == 1 && (seg[0] == 9 || seg[0] == 10 || seg[0] == 13 || seg[0] == 32) {
        paint.rect(pos, Vec2 { x: fr.w, y: f32(fontLine(font)) }, alpha(acc, 100));
        return;
    }
    let count = game.textSelRects(font, seg, bold, lo - fr.start, hi - fr.start);
    for r in 0..count {
        paint.rect(Vec2 { x: pos.x + game.selRectX(r), y: pos.y }, Vec2 { x: game.selRectW(r), y: f32(fontLine(font)) }, alpha(acc, 100));
    }
}

/// Paint the text fragments owned by `owner` (positions are relative to its border box). `oe` is
/// the element whose transitions apply.
fn paintFrags(d: &Dom, owner: int, oe: int) {
    let shift: f32 = 0.0;
    let shiftX: f32 = 0.0;
    if d.nodes.items[owner].kind == K_ELEM && isScroll(d, d.nodes.items[owner].style) {
        shift = d.nodes.items[owner].scrollY;
        shiftX = d.nodes.items[owner].scrollX;
    }
    let fill = textFillOf(d, owner);
    let bx = d.nodes.items[owner].box0;
    while bx >= 0 {
        let b = d.boxes.items[bx];
        if paintVisible(d, b.node) {
            let x0 = rnd(b.x - shiftX);
            let w = rnd(b.x + b.w - shiftX) - x0;
            paint.pushTranslate(Vec2 { x: x0, y: rnd(b.y - shift) });
            // `box-decoration-break: slice`: an end that is not the element's own is the box continuing, so the box is
            // drawn whole, taller-than-radius wider on that side, and clipped to the piece.
            let extL = if b.start == 0 { b.ap } else { 0.0 };
            let extR = if b.end == 0 { b.ap } else { 0.0 };
            let cut = extL > 0.0 || extR > 0.0;
            if cut {
                paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: b.ap });
                paint.pushTranslate(Vec2 { x: 0.0 - extL, y: 0.0 });
            }
            paintBackground(d, b.node, d.nodes.items[b.node].style, w + extL + extR, b.ap);
            if cut {
                paint.popTransform();
                paint.popClip();
            }
            paint.popTransform();
        }
        bx = b.next;
    }
    let f = d.nodes.items[owner].frag0;
    while f >= 0 {
        let fr = d.frags.items[f];
        if fr.kind == 0 && paintVisible(d, fr.node) {
            let tn = &d.nodes.items[fr.node];
            let whole = shownText(d, fr.node);
            let seg = (whole[fr.start..fr.end]) as string;
            let font = fontOf(d, tn.style);
            if font.raw != 0 {
                let pos = Vec2 { x: rnd(fr.x - shiftX), y: rnd(fr.y - shift) };
                let col = textColor(d, fr.node, oe);
                if ca(fill.flat) > 0 {
                    col = fill.flat;
                }
                let bold = isBold(d, tn.style);
                let tm = enterTextNode(d, fr.node);
                if tn.sa >= 0 {
                    paintSel(d, tn, fr, font, bold, pos, whole);
                }
                if !(seg.len == 1 && (seg[0] == 9 || seg[0] == 10 || seg[0] == 13)) { paintRun(d, tn.style, font, bold, pos, seg, col, &fill); }
                if fr.ell >= 0.0 {
                    paintRun(d, tn.style, font, bold, Vec2 { x: rnd(fr.x - shiftX + fr.ell), y: pos.y }, ELLIPSIS, col, &fill);
                }
                leaveText(tm);
            }
        }
        f = fr.next;
    }
}

/// A text node that is a flex or grid item owns its fragments.
fn paintTextNode(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    if n.frag0 < 0 || d.hidden > 0 || d.pz[d.psp] != 1 {
        return;
    }
    let ps: f32 = 0.0;
    let psx: f32 = 0.0;
    if n.parent >= 0 {
        ps = d.nodes.items[n.parent].scrollY;
        psx = d.nodes.items[n.parent].scrollX;
    }
    paint.pushTranslate(Vec2 { x: rnd(n.x - psx), y: rnd(n.y - ps) });
    paintFrags(d, id, n.parent);
    paint.popTransform();
}

/// Draw the click ripples of `id` over its box, clipped to it.
fn paintRipples(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let w = rnd(n.w);
    let h = rnd(n.h);
    paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h });
    for i in 0..d.rip.n {
        if d.rip.id[i] == id {
            let u = ripple.progress(&d.rip, i, d.now);
            let x = d.rip.x[i];
            let y = d.rip.y[i];
            let dx = max(x, w - x);
            let dy = max(y, h - y);
            let reach = sqrt(dx * dx + dy * dy);
            let col = d.rip.col[i];
            let a = f32(ca(col)) * (1.0 - u);
            paint.circle(Vec2 { x: x, y: y }, ripple.radius(reach, u), Color { r: u8(cr(col)), g: u8(cg(col)), b: u8(cb(col)), a: u8(a) });
        }
    }
    paint.popClip();
}

/// Draw the scrollbars of box `id` (inside its clip, over its content).
fn paintBars(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let b = barsOf(d, id);
    if !b.showX && !b.showY {
        return;
    }
    let st = n.style;
    let tv = d.css.get(st, P_SB_THUMB);
    let kv = d.css.get(st, P_SB_TRACK);
    let thumbCol = if tv.kind == V_COLOR { toColor(tv.c) } else { Color { r: 255, g: 255, b: 255, a: 70 } };
    let trackCol = if kv.kind == V_COLOR { toColor(kv.c) } else { Color { r: 255, g: 255, b: 255, a: 14 } };
    let hot = scrollbar.NONE;
    if d.barNode == id {
        hot = d.barPart;
    } else if d.barOf == id {
        hot = d.barHover;
    }
    scrollbar.draw(&b, thumbCol, trackCol, hot);
}

fn paintClose(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    // trailing text and ghosts
    let c = d.pcu[d.psp];
    let nx = if c < 0 { n.first } else { d.nodes.items[c].next };
    while nx >= 0 {
        if d.nodes.items[nx].kind == K_TEXT {
            paintTextNode(d, nx);
        } else if d.nodes.items[nx].ghost {
            paintNode(d, nx);
        }
        nx = d.nodes.items[nx].next;
    }
    let f = n.pflags;
    if paintVisible(d, id) && d.rip.n > 0 && d.pz[d.psp] == 1 && !hasBit(f, PB_SKIP) && !hasBit(f, PB_HIDDEN) {
        paintRipples(d, id);
    }
    if hasBit(f, PB_CLIP) {
        // a scroller with a lifted box inside has its bars painted last in its context (`paintBarEntry`)
        if paintVisible(d, id) && d.pz[d.psp] == 1 && (!n.bdef || d.pflat) {
            paintBars(d, id);
        }
        paint.popClip();
    }
    if hasBit(f, PB_POST) {
        let fx = effectsOf(d, n.style);
        if hasBit(f, PB_PROJECT) {
            fx.perspective = 0.0;
            fx.rotateX = 0.0;
            fx.rotateY = 0.0;
            fx.blend = 0;
        }
        paint.endLayer(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: rnd(n.w), y: rnd(n.h) }, fx);
    }
    if hasBit(f, PB_MASK) {
        paint.popMask();
    }
    if hasBit(f, PB_SHAPE) {
        paint.popShape(0);
    }
    if hasBit(f, PB_PROJECT) {
        let source = effectsOf(d, n.style);
        let projection = Effects { perspective: source.perspective, rotateX: source.rotateX, rotateY: source.rotateY, blend: source.blend };
        paint.endLayer(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: rnd(n.w), y: rnd(n.h) }, projection);
    }
    if hasBit(f, PB_SCALE) {
        paint.popTransform();
    }
    if hasBit(f, PB_TSCALE) {
        paint.popTransform();
    }
    if hasBit(f, PB_TCLIP) {
        paint.popClip();
    }
    if hasBit(f, PB_ALPHA) {
        paint.popAlpha();
    }
    if hasBit(f, PB_MOVE) {
        paint.popTransform();
    }
    if hasBit(f, PB_FIXED) {
        paint.popTransform();
        paint.popClip();
    }
    if hasBit(f, PB_HIDDEN) {
        d.hidden -= 1;
    }
    d.base = d.pv[2 * d.psp];
    d.scale = d.pv[2 * d.psp + 1];
    d.psp -= 1;
    d.pcu[d.psp] = id;
}
