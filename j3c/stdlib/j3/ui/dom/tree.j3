// Part of j3.ui.dom (Node storage: allocation, insert and remove, ghosts, dirty marks.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Copy `s` into `buf` / `len` when it differs (grows the buffer in the arena).
fn keep(mem: &Arena, buf: &[]u8, len: &int, s: string) {
    let differs = *len != s.len;
    for i in 0..s.len {
        if !differs && (*buf)[i] != s[i] {
            differs = true;
        }
    }
    if differs {
        if s.len > buf.len {
            *buf = mem.alloc::<u8>(max4(s.len, buf.len * 2));
        }
        for j in 0..s.len {
            (*buf)[j] = s[j];
        }
        *len = s.len;
    }
}

fn max4(a: int, b: int): int {
    if a > b {
        return a;
    }
    return b;
}

fn isWs(b: u8): bool {
    return b == 32 || b == 10 || b == 9 || b == 13;
}

fn blankNode(kind: int, tag: int, slot: int, scope: int, buf: []u8, cls: []int): Node {
    // zero-length views, so the title / aria / role buffers never share the text buffer's memory
    let none = []u8 { ptr: buf.ptr, len: 0 };
    return Node {
        kind: kind, tag: tag, parent: -1, first: -1, last: -1, next: -1, prev: -1, vfirst: -1, vlast: -1, vnext: -1, vprev: -1, ordered: false, slot: slot, scope: scope, gk: -1,
        style: -1, disp: DP_BLOCK, isAbs: false, checked: false, value: 0.0, attrMin: 0.0, attrMax: 100.0, attrStep: 1.0,
        buf: buf, tlen: 0, x: 0.0, y: 0.0, w: 0.0, h: 0.0, contentH: 0.0, scrollY: 0.0, scrollMax: 0.0, baseline: 0.0, sa: -1, sb: -1,
        frag0: -1, fragTail: -1, fragReuse: -1, box0: -1, boxTail: -1, boxReuse: -1, dirty: true, laid: false, lastW: -2.0, lastH: -2.0, basisW: -2.0, basisH: -2.0,
        styleDirty: true, subStyle: false, kidsMk: false, hasOnly: false, hasEp: 0, firstEl: -1, lastEl: -1, dirtyGen: 1, intrGen: 0, minc: 0.0, maxc: 0.0,
        clsBuf: cls, ncls: 0,
        pflags: 0, trn: -1, fadeT0: -1000000000.0, ghost: false, ghostT0: 0.0, born: 0, ser: 0, tr: -1, tstyle: -1, adelay: 0.0, flip: -1, inAct: false,
        sval: "", ph: "", edit: -1, multi: false, high: 0.0, mlow: METER_UNSET, mhigh: METER_UNSET, mopt: METER_UNSET, openSet: 0, togAt: -1, clkAt: -1, rname: -1, rstop: 0, mcSt: -1, mc0: 0, mc1: 0, mc2: 0, chg: 0, sub: 0, maxlen: 0, rows: 0,
        scrollX: 0.0, scrollMaxX: 0.0, contentW: 0.0, velX: 0.0, velY: 0.0, snapAt: -1.0, snapSx: 0.0, snapSy: 0.0, anX: false, anY: false, anTx: 0.0, anTy: 0.0, snapKx: -1, snapKy: -1, snapBx: -1, snapBy: -1,
        ov: 0, ovBy: 0, closeAt: -1, ovFocus: -1, ovZ: 0, ovInit: false, fAuto: false, fSub: false, fDef: false, fSel: false, ovContext: false, ctxPending: false, ovCaret: false, cth: 0.0, trigs: "", hcAt: -1.0, hcLeave: -1.0, hcOpen: false, hcBlock: false, isFixed: false, svBuf: none, svLen: 0, tipBuf: none, tipLen: 0, ariaBuf: none, ariaLen: 0, roleBuf: none, roleLen: 0, forBuf: none, forLen: 0, liveBuf: none, liveLen: 0, descBuf: none, descLen: 0, asel: 0, navBuf: none, navLen: 0, hasAtX: false, hasAtY: false, atx: 0.0, aty: 0.0, pk: 0, mitem: false, noTab: false, tabIdx: 0, draggable: false, dragT: 0, noGhost: false, dragId: 0, dgBuf: none, dgLen: 0, ow: -1.0, oh: -1.0, isStk: false, sy: 0.0, media: 0, optionSource: -1, optionGen: -1, dyn: -1, tbuf: none, txm: 0, rt: false, pidx: -1, pe: 0,
    };
}

fn newNode(d: &Dom, kind: int, tag: int, slot: int, scope: int): int {
    let id = 0;
    if d.free.len > 0 {
        d.free.len -= 1;
        id = d.free.items[d.free.len].v;
        let keepBuf = d.nodes.items[id].buf;
        let keepCls = d.nodes.items[id].clsBuf;
        let keepSv = d.nodes.items[id].svBuf;
        let keepTx = d.nodes.items[id].tbuf;
        d.nodes.items[id] = blankNode(kind, tag, slot, scope, keepBuf, keepCls);
        // capacity survives the free pool (svLen is 0 again), so a recycled input's `value=` allocates nothing
        d.nodes.items[id].svBuf = keepSv;
        // `text-transform` copy: capacity survives too (`txm` is 0 again, so it is rebuilt on first use)
        d.nodes.items[id].tbuf = keepTx;
    } else {
        id = d.nodes.len;
        d.nodes.push(blankNode(kind, tag, slot, scope, d.mem.alloc::<u8>(0), d.mem.alloc::<int>(8)));
        d.mnodes.push(MatchNode { tag: tag, classes: d.mem.alloc::<int>(0), parent: -1, prevSibling: -1, flags: 0, type: -1, scope: scope, scope2: 0, id: -1, pe: if kind == K_ELEM { 0 } else { -1 }, next: -1, first: -1 });
    }
    d.mnodes.items[id] = MatchNode { tag: tag, classes: d.mem.alloc::<int>(0), parent: -1, prevSibling: -1, flags: 0, type: -1, scope: scope, scope2: 0, id: -1, pe: if kind == K_ELEM { 0 } else { -1 }, next: -1, first: -1 };
    d.gen += 1;
    d.nodes.items[id].dirtyGen = d.gen;
    d.nodes.items[id].born = d.frame;
    d.serial += 1;
    d.nodes.items[id].ser = d.serial;
    d.nodes.items[id].gk = if d.gsp > 0 { d.gstk[d.gsp - 1] } else { -1 };
    if d.gsp > 0 {
        d.gfirst.items[d.gstk[d.gsp - 1]].v = id;
    }
    return id;
}

/// Copy `s` into the node's own byte buffer unless it already holds it; whether it changed.
fn storeBytes(d: &Dom, n: &Node, s: string): bool {
    let differs = n.tlen != s.len;
    if !differs {
        for i in 0..s.len {
            if n.buf[i] != s[i] {
                differs = true;
            }
        }
    }
    if differs {
        if s.len > n.buf.len {
            let cap = max4(s.len, n.buf.len * 2);
            n.buf = d.mem.alloc::<u8>(cap);
        }
        for j in 0..s.len {
            n.buf[j] = s[j];
        }
        n.tlen = s.len;
        n.txm = 0;
    }
    return differs;
}

/// A text box: an `<input>` that is not a checkbox, radio, range or color.
pub fn isField(d: &Dom, id: int): bool {
    let t = d.mnodes.items[id].type;
    return d.nodes.items[id].tag == d.tInput && t != d.vCheckbox && t != d.vRadio && t != d.vRange && t != d.vColor;
}

/// First non-ghost node at or after `n` among siblings.
fn skipGhost(d: &Dom, n: int): int {
    let c = n;
    while c >= 0 && (d.nodes.items[c].ghost || d.nodes.items[c].rt) {
        c = d.nodes.items[c].next;
    }
    return c;
}

/// Local `slot` to the number stored in the node (see `Dom.enter`).
fn realSlot(d: &Dom, slot: int): int {
    if slot < 0 || slot >= 4096 {
        panic("dom: slot out of range (0..4095 per construct)");
    }
    return d.base + slot * d.scale;
}

/// Link `id` into `parent` before `before` (-1 appends).
fn insertBefore(d: &Dom, parent: int, id: int, before: int) {
    // an appended child goes before the `::after` box, which stays last
    if before < 0 && d.nodes.items[parent].last >= 0 && d.nodes.items[d.nodes.items[parent].last].pe == 2 && d.nodes.items[id].pe != 2 {
        before = d.nodes.items[parent].last;
    }
    let prev = if before < 0 { d.nodes.items[parent].last } else { d.nodes.items[before].prev };
    d.nodes.items[id].parent = parent;
    d.nodes.items[id].prev = prev;
    d.nodes.items[id].next = before;
    if prev >= 0 {
        d.nodes.items[prev].next = id;
    } else {
        d.nodes.items[parent].first = id;
    }
    if before >= 0 {
        d.nodes.items[before].prev = id;
    } else {
        d.nodes.items[parent].last = id;
    }
    d.mnodes.items[id].parent = parent;
    d.mnodes.items[id].prevSibling = prev;
    d.mnodes.items[id].next = before;
    if prev >= 0 {
        d.mnodes.items[prev].next = id;
    } else {
        d.mnodes.items[parent].first = id;
    }
    if before >= 0 {
        d.mnodes.items[before].prevSibling = id;
    }
    if d.nodes.items[id].pe == 0 {
        markKids(d, parent);
        markHas(d, id, 3, 0);
    }
    markStyle(d, id);
    markDirty(d, parent);
    fixFirst(d, parent);
    fixLast(d, parent);
    aKids(d, parent);
}

/// Queue an accessibility event (`EV_*`) about node `id` (-1: none), once per kind and node until drained. Only after `a11y.enable`.
pub fn aNote(d: &Dom, kind: int, id: int) {
    if !d.a11yOn {
        return;
    }
    let h = d.handle(id);
    for i in 0..d.aev.len {
        if d.aev.items[i].kind == kind && d.aev.items[i].h == h {
            return;
        }
    }
    // a runaway page cannot grow the queue without bound: the bridge drains it every frame
    if d.aev.len < 256 {
        d.aev.push(AEv { kind: kind, h: h });
        d.aevTotal += 1;
    }
}

/// The content of `id` changed: queue the nearest `aria-live` region above it (not one made this frame: a region's first content is not announced).
pub fn aLive(d: &Dom, id: int) {
    if !d.a11yOn || d.liveCount == 0 {
        return;
    }
    let c = id;
    while c >= 0 && d.nodes.items[c].liveLen == 0 {
        c = d.nodes.items[c].parent;
    }
    if c < 0 || d.nodes.items[c].born == d.frame {
        return;
    }
    let h = d.handle(c);
    for i in 0..d.lq.len {
        if d.lq.items[i].v == h {
            return;
        }
    }
    d.lq.push(Idx { v: h });
}

/// The text under `id` changed (its name, and its live region's text).
pub fn aTouch(d: &Dom, id: int) {
    if d.a11yOn {
        aNote(d, EV_NAME, id);
        aLive(d, id);
    }
}

/// A child of `parent` came or went.
pub fn aKids(d: &Dom, parent: int) {
    if d.a11yOn {
        aNote(d, EV_CHILDREN, parent);
        aLive(d, parent);
    }
}

/// Keep `FL_FIRST_CHILD` on the first element child only.
fn fixFirst(d: &Dom, parent: int) {
    let f = d.nodes.items[parent].first;
    while f >= 0 && (d.nodes.items[f].kind != K_ELEM || d.nodes.items[f].pe != 0) {
        f = d.nodes.items[f].next;
    }
    let old = d.nodes.items[parent].firstEl;
    if f == old {
        return;
    }
    if old >= 0 && d.nodes.items[old].kind == K_ELEM && d.nodes.items[old].parent == parent {
        d.mnodes.items[old].flags = d.mnodes.items[old].flags - FL_FIRST_CHILD * ((d.mnodes.items[old].flags / FL_FIRST_CHILD) % 2);
        markStyle(d, old);
        markHas(d, old, 1, FL_FIRST_CHILD);
    }
    if f >= 0 {
        d.mnodes.items[f].flags = d.mnodes.items[f].flags + FL_FIRST_CHILD * (1 - (d.mnodes.items[f].flags / FL_FIRST_CHILD) % 2);
        markStyle(d, f);
        markHas(d, f, 1, FL_FIRST_CHILD);
    }
    d.nodes.items[parent].firstEl = f;
}

/// Keep `FL_LAST_CHILD` on the last element child only (the mirror of `fixFirst`).
fn fixLast(d: &Dom, parent: int) {
    let l = d.nodes.items[parent].last;
    while l >= 0 && (d.nodes.items[l].kind != K_ELEM || d.nodes.items[l].pe != 0) {
        l = d.nodes.items[l].prev;
    }
    let old = d.nodes.items[parent].lastEl;
    if l == old {
        return;
    }
    if old >= 0 && d.nodes.items[old].kind == K_ELEM && d.nodes.items[old].parent == parent {
        d.setFlag(old, FL_LAST_CHILD, false);
    }
    if l >= 0 {
        d.setFlag(l, FL_LAST_CHILD, true);
    }
    d.nodes.items[parent].lastEl = l;
}

/// Remove every child after `last` (the last one visited this frame).
fn trimTail(d: &Dom, parent: int, last: int) {
    let c = if last < 0 { d.nodes.items[parent].first } else { d.nodes.items[last].next };
    while c >= 0 {
        let nx = d.nodes.items[c].next;
        if !d.nodes.items[c].ghost && !d.nodes.items[c].rt {
            removeNode(d, c);
        }
        c = nx;
    }
}

fn freeSubtree(d: &Dom, id: int) {
    let c = d.nodes.items[id].first;
    while c >= 0 {
        let nx = d.nodes.items[c].next;
        freeSubtree(d, c);
        c = nx;
    }
    releaseFrags(d, d.nodes.items[id].frag0);
    releaseBoxes(d, d.nodes.items[id].box0);
    if d.nodes.items[id].ghost && d.nodes.items[id].pe == 0 {
        d.ghosts -= 1;
    }
    if d.nodes.items[id].pe != 0 {
        d.npe -= 1;
    }
    if d.nodes.items[id].tr >= 0 {
        dropMotion(d, id);
    }
    if d.focus == id {
        d.focus = -1;
        aNote(d, EV_FOCUS, -1);
    }
    dragstate.forget(&d.drag, id);
    if d.nodes.items[id].flip >= 0 {
        unflip(d, id);
    }
    if d.nodes.items[id].trn >= 0 {
        untrans(d, id);
    }
    if d.nodes.items[id].ov != 0 {
        dropOverlay(d, id);
    }
    if d.barNode == id {
        d.barNode = -1;
    }
    if d.tipNode == id {
        d.tipNode = -1;
    }
    if d.pop.owner == id {
        d.pop = popup.closed();
    }
    if d.ttRoot == id {
        d.ttRoot = -1;
    }
    if d.ptRoot == id {
        d.ptRoot = -1;
    }
    if d.nodes.items[id].edit >= 0 {
        if id == d.poolEd {
            // a pooled box (the grid's cell editor) is made again and again: keep its buffers
            d.eds.items[d.nodes.items[id].edit].reset();
            d.poolEd = -1;
        } else {
            // the old buffer may still be a bound variable's view: leave it alone, start a new one
            d.eds.items[d.nodes.items[id].edit] = Edit.new(d.mem);
        }
    }
    if d.rip.n > 0 {
        ripple.prune(&d.rip, d.now, id);
    }
    d.nodes.items[id].inAct = false;
    if d.nodes.items[id].isAbs {
        dropAbs(d, id);
    }
    if d.nodes.items[id].media > 0 && d.nodes.items[id].optionSource < 0 {
        media.release(&d.media, d.nodes.items[id].media - 1);
    }
    if d.nodes.items[id].dyn >= 0 {
        d.dynFree.push(Idx { v: d.nodes.items[id].dyn });
    }
    if d.nodes.items[id].forLen > 0 {
        d.forLabels -= 1;
    }
    if d.nodes.items[id].liveLen > 0 {
        d.liveCount -= 1;
    }
    d.nodes.items[id].kind = K_FREE;
    d.free.push(Idx { v: id });
}

/// Remove `id`; a node with an `out:` / `transition:` stays as a ghost playing it first.
fn removeNode(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    if n.ov != 0 {
        dropOverlay(d, id);
    }
    if n.kind == K_ELEM && n.trn >= 0 && d.trns.items[n.trn].outK != 0 && !n.ghost && !d.css.reduced {
        // removed mid-enter: leave from how far the enter got (a linear estimate under easing)
        let t = &d.trns.items[n.trn];
        let p: f32 = 1.0;
        if t.inK != 0 && d.now - n.fadeT0 < t.inMs {
            p = (d.now - n.fadeT0) / t.inMs;
        }
        n.ghost = true;
        n.ghostT0 = d.now - (1.0 - p) * t.outMs;
        d.ghosts += 1;
        markHas(d, id, 3, 0);
        // a leaving element is no sibling for `+` / `~` any more (browsers have already removed it)
        d.mnodes.items[id].pe = -2;
        if d.css.sibMode > 0 {
            markFrom(d, n.next);
        }
        markKids(d, n.parent);
        aKids(d, n.parent);
        return;
    }
    dropNode(d, id);
}

/// `:focus-within` on `from` and every ancestor of it (the popup roots too: a popup is inside its owner), stopping below the
/// first one that contains `keep` (it stays on). Costs the depth.
fn focusWithin(d: &Dom, from: int, on: bool, keep: int) {
    let c = from;
    while c >= 0 {
        if !on && keep >= 0 && inside(d, c, keep) {
            return;
        }
        d.setFlag(c, FL_FOCUS_WITHIN, on);
        c = d.nodes.items[c].parent;
    }
}

fn dropNode(d: &Dom, id: int) {
    let parent = d.nodes.items[id].parent;
    if d.focus >= 0 && inside(d, id, d.focus) {
        // the focus dies with the subtree: its surviving ancestors stop being `:focus-within`
        focusWithin(d, d.focus, false, -1);
    }
    unlinkNode(d, id);
    freeSubtree(d, id);
    markDirty(d, parent);
    fixFirst(d, parent);
    fixLast(d, parent);
    aKids(d, parent);
}

/// Take `id` out of its parent's child list (the node and its subtree stay alive).
fn unlinkNode(d: &Dom, id: int) {
    let parent = d.nodes.items[id].parent;
    let prev = d.nodes.items[id].prev;
    let nxt = d.nodes.items[id].next;
    if prev >= 0 {
        d.nodes.items[prev].next = nxt;
        d.mnodes.items[prev].next = nxt;
    } else {
        d.nodes.items[parent].first = nxt;
        d.mnodes.items[parent].first = nxt;
    }
    if d.nodes.items[id].pe == 0 {
        markKids(d, parent);
        markHas(d, id, 3, 0);
    }
    if nxt >= 0 {
        d.nodes.items[nxt].prev = prev;
        d.mnodes.items[nxt].prevSibling = prev;
        if d.css.sibMode > 0 {
            markFrom(d, nxt);
        }
    } else {
        d.nodes.items[parent].last = prev;
    }
}

/// Is `n` in keyed row `g`, or in a row nested inside it?
fn inGroup(d: &Dom, n: int, g: int): bool {
    let k = d.nodes.items[n].gk;
    while k >= 0 {
        if k == g {
            return true;
        }
        k = d.gpar.items[k].v;
    }
    return false;
}

/// May the build walk reuse or remove `n`? Inside a keyed row only its own nodes are the walk's.
fn ownsNode(d: &Dom, n: int): bool {
    return d.gsp == 0 || inGroup(d, n, d.gstk[d.gsp - 1]);
}

/// `id` leaves the overlay stack; focus goes back to what had it when the overlay opened.
fn dropOverlay(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let at = -1;
    for i in 0..d.ovs.len {
        if d.ovs.items[i].v == id {
            at = i;
        }
    }
    if at >= 0 {
        for j in at..(d.ovs.len - 1) {
            d.ovs.items[j] = d.ovs.items[j + 1];
        }
        d.ovs.len -= 1;
    }
    if d.taOwner >= 0 && inside(d, id, d.taOwner) { d.taOwner = -1; d.taLen = 0; }
    let back = n.ovFocus;
    n.ov = 0;
    n.ovFocus = -1;
    let held = d.focus < 0 || inside(d, id, d.focus);
    // a caret popup never took focus from its box, so there is nothing to give back (a blurred box stays blurred)
    if held && !n.ovCaret && back >= 0 && back < d.nodes.len && d.nodes.items[back].kind == K_ELEM && !inside(d, id, back) {
        d.focusNode(back);
    }
}

fn dropAbs(d: &Dom, id: int) {
    for i in 0..d.abs.len {
        if d.abs.items[i].v == id {
            d.abs.items[i].v = d.abs.items[d.abs.len - 1].v;
            d.abs.len -= 1;
            break;
        }
    }
    d.nodes.items[id].isAbs = false;
}

/// Layout (and intrinsic sizes) of `id` and every ancestor are stale.
fn markDirty(d: &Dom, id: int) {
    d.gen += 1;
    let c = id;
    while c >= 0 {
        d.nodes.items[c].dirty = true;
        d.nodes.items[c].dirtyGen = d.gen;
        c = d.nodes.items[c].parent;
    }
}

/// Restyle `id` and its whole subtree on the next `layout`.
///
/// With sibling combinators (`a + b`, `a ~ b`) in the loaded CSS the following siblings restyle too: only the next element
/// for a lone `+` (`Css.sibMode` 1), every following element for `~` or chained `+` (mode 2), so one change costs
/// up to the number of siblings after it. Text nodes and `::before` / `::after` boxes are not siblings for selectors.
fn markStyle(d: &Dom, id: int) {
    d.nodes.items[id].styleDirty = true;
    d.nodes.items[id].hasOnly = false;
    let c = d.nodes.items[id].parent;
    while c >= 0 {
        d.nodes.items[c].subStyle = true;
        c = d.nodes.items[c].parent;
    }
    if d.css.sibMode > 0 && d.mnodes.items[id].pe == 0 {
        markFrom(d, d.nodes.items[id].next);
    }
}

/// A child of `parent` came, went or moved (or a text child changed between blank and not): the selectors that look at the siblings
/// after an element or at its children (`Css.structMode`: `:nth-last-child`, `:*-of-type`, `:only-child`, `:empty`) restyle the
/// parent and every element child, so one change costs the number of children. Nothing happens without such a rule.
fn markKids(d: &Dom, parent: int) {
    if d.css.structMode == 0 || parent < 0 {
        return;
    }
    if d.nodes.items[parent].kidsMk && d.nodes.items[parent].styleDirty {
        return;
    }
    d.nodes.items[parent].kidsMk = true;
    markStyle(d, parent);
    let c = d.nodes.items[parent].first;
    while c >= 0 {
        if d.mnodes.items[c].pe == 0 {
            d.nodes.items[c].styleDirty = true;
            d.nodes.items[c].hasOnly = false;
            d.kidMarks += 1;
        }
        c = d.nodes.items[c].next;
    }
    d.nodes.items[parent].subStyle = true;
}

/// Something a `:has()` argument could test changed on `id` (`what`: 0 a class `v` came or went, 1 the `FL_*` bit `v`, 2 an `#id` /
/// `[type]` / text blankness, 3 it was inserted, removed or moved): restyle the elements that carry a `:has()` and could now
/// flip, which are the ancestors for a descendant argument, the parent for `>`, the earlier siblings for `+` / `~`. Does nothing
/// without `:has()` rules or when no argument tests this feature (`Css.hasMode`, `hasCls`, `hasFlags`, `hasAttr`); otherwise costs the
/// depth (one cheap compound test per ancestor, and an ordinary restyle of the ones that pass).
fn markHas(d: &Dom, id: int, what: int, v: int) {
    let css = d.css;
    if css.hasMode == 0 {
        return;
    }
    let nodes = d.mnodes.items;
    // text and `::before` / `::after` boxes are no element for an argument to find (a text node's blankness is `what` 2)
    if what == 3 && (d.nodes.items[id].kind != K_ELEM || nodes[id].pe != 0) {
        return;
    }
    let hit = what == 3 || (what == 2 && css.hasAttr != 0);
    if what == 0 {
        for i in 0..css.hasCls.len {
            if css.hasCls.items[i] == v {
                hit = true;
            }
        }
    } else if what == 1 {
        hit = hasBit(css.hasFlags, v);
    }
    if !hit {
        return;
    }
    if css.hasMode % 2 == 1 || (css.hasMode / 2) % 2 == 1 {
        let a = nodes[id].parent;
        let up = css.hasMode % 2 == 1;
        while a >= 0 {
            // an earlier walk this round went through `a` and so through everything above it (mass inserts walk once)
            if up && d.nodes.items[a].hasEp == css.hasGen {
                break;
            }
            if up {
                d.nodes.items[a].hasEp = css.hasGen;
            }
            css.hasWalked += 1;
            if d.nodes.items[a].kind == K_ELEM && nodes[a].pe == 0 && hasSubject(css, nodes, a) {
                restyleHas(d, a);
            }
            a = if up { nodes[a].parent } else { -1 };
        }
    }
    if css.hasMode / 4 > 0 {
        let q = prevEl(nodes, id);
        while q >= 0 {
            if hasSubject(css, nodes, q) {
                restyleHas(d, q);
            }
            q = if css.hasMode / 8 > 0 { prevEl(nodes, q) } else { -1 };
        }
    }
}

/// `markStyle` for an element whose `:has()` may have flipped: its subtree restyles only if its style id changes (`resolveNode`), unless
/// some rule has a `:has()` outside its rightmost compound (`Css.hasInner`).
fn restyleHas(d: &Dom, a: int) {
    let n = &d.nodes.items[a];
    let only = !n.styleDirty || n.hasOnly;
    markStyle(d, a);
    n.hasOnly = only;
}

/// Restyle the element `c` or the first one after it (every one after it in sibling mode 2).
fn markFrom(d: &Dom, c0: int) {
    let c = c0;
    let first = true;
    while c >= 0 {
        if d.mnodes.items[c].pe == 0 {
            d.nodes.items[c].styleDirty = true;
            d.nodes.items[c].hasOnly = false;
            if first {
                first = false;
                let a = d.nodes.items[c].parent;
                while a >= 0 {
                    d.nodes.items[a].subStyle = true;
                    a = d.nodes.items[a].parent;
                }
            }
            if d.css.sibMode == 1 {
                return;
            }
        }
        c = d.nodes.items[c].next;
    }
}
