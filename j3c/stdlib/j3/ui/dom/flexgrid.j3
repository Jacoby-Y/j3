// Part of j3.ui.dom (Flex and grid layout.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn selfAlign(d: &Dom, st: int, parentAlign: int, row: bool): int {
    // an auto margin on the cross axis takes the free space itself: the item does not stretch
    if autoM(d, st, if row { 0 } else { 3 }) || autoM(d, st, if row { 2 } else { 1 }) {
        return ALIGN_START;
    }
    let a = kwOf(d, st, P_ALIGN_SELF);
    return if a == 0 { parentAlign } else { a - 1 };
}

fn layoutFlex(d: &Dom, id: int, cw: f32, chDef: f32, e: Edges): f32 {
    let st = d.nodes.items[id].style;
    let dir = kwOf(d, st, P_FLEX_DIRECTION);
    let row = dir != DIR_COLUMN && dir != DIR_COLUMN_REVERSE;
    let reverse = dir == DIR_ROW_REVERSE || dir == DIR_COLUMN_REVERSE;
    let wrapKind = kwOf(d, st, P_FLEX_WRAP);
    let wrap = (if row { cw } else { chDef }) >= 0.0 && wrapKind != 0;
    let crossReverse = wrapKind == 2;
    let justify = kwOf(d, st, P_JUSTIFY_CONTENT);
    let alignC = kwOf(d, st, P_ALIGN_ITEMS);
    let gap = if row { numOf(d, st, P_GAP) } else { numOf(d, st, P_ROW_GAP) };
    let mainAvail = if row { cw } else { chDef };
    let crossAvail = if row { chDef } else { cw };
    let ox = e.bl + e.pl;
    let oy = e.bt + e.pt;
    let b0 = d.fiTop;
    let cnt = 0;
    let c0 = d.nodes.items[id].first;
    while c0 >= 0 {
        if skipped(d, c0) {
            d.nodes.items[c0].x = ox;
            d.nodes.items[c0].y = oy;
        } else {
            if b0 + cnt >= FI_CAP {
                panic("dom: too many flex/grid items in nested containers");
            }
            d.fi[b0 + cnt] = FItem { id: c0, grow: 0.0, shrink: 1.0, padM: 0.0, base: 0.0, minM: 0.0, maxM: 1000000000.0, size: 0.0, mm: 0.0, cm: 0.0, cross: 0.0, nat: UNDEF, frozen: false, pos: 0.0, ln: 0, lc: 0.0, la: 0.0, ly: 0.0, c0: 0, c1: 0, r0: 0, r1: 0 };
            cnt += 1;
        }
        c0 = d.nodes.items[c0].next;
    }
    // Stable insertion sort leaves the DOM/event/focus links untouched.
    for k in 1..cnt {
        let item = d.fi[b0 + k];
        let order = numOf(d, d.nodes.items[item.id].style, P_ORDER);
        let j = k;
        while j > 0 && numOf(d, d.nodes.items[d.fi[b0 + j - 1].id].style, P_ORDER) > order {
            d.fi[b0 + j] = d.fi[b0 + j - 1];
            j -= 1;
        }
        d.fi[b0 + j] = item;
    }
    d.fiTop = b0 + cnt;
    // 1. flex base sizes and min sizes
    for k in 0..cnt {
        let ci = d.fi[b0 + k].id;
        let cst = d.nodes.items[ci].style;
        let ce = edgesOf(d, cst, cw);
        let padMain = if row { ce.pl + ce.pr + ce.bl + ce.br } else { ce.pt + ce.pb + ce.bt + ce.bb };
        let mm = if row { ce.ml + ce.mr } else { ce.mt + ce.mb };
        let cm = if row { ce.mt + ce.mb } else { ce.ml + ce.mr };
        let grow = flexGrow(d, cst);
        let align = selfAlign(d, cst, alignC, row);
        let sMain = if row { specW(d, cst, cw, ce) } else { specH(d, cst, chDef, ce) };
        let cwItem: f32 = 0.0;
        if !row {
            let swc = specW(d, cst, cw, ce);
            if swc >= 0.0 {
                cwItem = swc;
            } else if align == ALIGN_STRETCH && !wrap {
                cwItem = max(cw - cm, 0.0);
            } else {
                cwItem = fitWidth(d, ci, max(cw - cm, 0.0), cw);
            }
            let mwc = minWOf(d, cst, cw, ce);
            if mwc >= 0.0 {
                cwItem = max(cwItem, mwc);
            }
        }
        if !row { cwItem = limitSize(d, cst, cwItem, cw, ce, true); }
        let base: f32 = 0.0;
        let nat = UNDEF;
        let basis = sizeOf(d, cst, P_FLEX_BASIS, mainAvail, padMain);
        if basis >= 0.0 {
            base = max(basis, padMain);
        } else if grow > 0.0 && d.css.get(cst, P_FLEX_BASIS).kind == V_NONE {
            base = padMain;
        } else if sMain >= 0.0 && (d.css.get(cst, P_FLEX_BASIS).kind == V_AUTO || d.css.get(cst, P_FLEX_BASIS).kind == V_NONE) {
            base = sMain;
        } else if row {
            let cs = contentSizes(d, ci);
            base = cs.y;
        } else {
            layoutBox(d, ci, cwItem, UNDEF, cw, chDef);
            nat = d.nodes.items[ci].h;
            base = d.nodes.items[ci].contentH + ce.bt + ce.bb;
        }
        let mx = sizeOf(d, cst, if row { P_MAX_WIDTH } else { P_MAX_HEIGHT }, mainAvail, padMain);
        let mn = if row { minWOf(d, cst, cw, ce) } else { minHOf(d, cst, chDef, ce) };
        if mn < 0.0 {
            if isScroll(d, cst) {
                mn = 0.0;
            } else {
                if row {
                    mn = contentMin(d, ci);
                } else {
                    if nat < 0.0 {
                        layoutBox(d, ci, cwItem, UNDEF, cw, chDef);
                        nat = d.nodes.items[ci].h;
                    }
                    mn = nat;
                }
                if sMain >= 0.0 { mn = min(mn, sMain); }
                if mx >= 0.0 { mn = min(mn, mx); }
            }
        }
        let it = &d.fi[b0 + k];
        it.grow = grow;
        it.shrink = max(numOf(d, cst, P_FLEX_SHRINK), 0.0);
        it.padM = padMain;
        it.base = base;
        it.minM = mn;
        it.maxM = if mx >= 0.0 { max(mx, mn) } else { 1000000000.0 };
        it.mm = mm;
        it.cm = cm;
        it.nat = nat;
        it.cross = cwItem;
        let sa = slideMain(d, ci, row);
        if sa != 1.0 {
            // a sliding item takes the shown part of its main size (`slideSize` leaves that axis to this)
            it.base *= sa;
            it.minM *= sa;
            if it.maxM < 1000000000.0 { it.maxM *= sa; }
        }
    }
    // 2. A definite main size permits wrapping; gaps follow physical axes.
    let crossGap = if row { numOf(d, st, P_ROW_GAP) } else { numOf(d, st, P_GAP) };
    let acc: f32 = 0.0;
    let lineN = 0;
    let first = 0;
    for kb in 0..cnt {
        let ib = &d.fi[b0 + kb];
        let hyp = max(min(ib.base, ib.maxM), ib.minM) + ib.mm;
        if wrap && kb > first && acc + gap + hyp > mainAvail + 0.01 {
            lineN += 1;
            first = kb;
            acc = hyp;
        } else {
            acc = if kb == first { hyp } else { acc + gap + hyp };
        }
        ib.ln = lineN;
    }
    // 3. per line: main sizes, then lay each item out and find the line's cross size
    let ks = 0;
    while ks < cnt {
        let lnk = d.fi[b0 + ks].ln;
        let ke = ks;
        while ke < cnt && d.fi[b0 + ke].ln == lnk {
            ke += 1;
        }
        let lb = b0 + ks;
        let lcn = ke - ks;
        if mainAvail >= 0.0 {
            resolveMain(d, lb, lcn, mainAvail, gap);
        } else {
            for k2 in 0..lcn {
                let it2 = &d.fi[lb + k2];
                it2.size = max(min(it2.base, it2.maxM), it2.minM);
            }
        }
        let lineCross: f32 = 0.0;
        let maxAsc: f32 = 0.0;
        let maxDesc: f32 = 0.0;
        let crossOuterMax: f32 = 0.0;
        for k3 in 0..lcn {
            let ci3 = d.fi[lb + k3].id;
            let cst3 = d.nodes.items[ci3].style;
            let ce3 = edgesOf(d, cst3, cw);
            let align3 = selfAlign(d, cst3, alignC, row);
            let size3 = d.fi[lb + k3].size;
            let cm3 = d.fi[lb + k3].cm;
            if row {
                let hs = specH(d, cst3, chDef, ce3);
                if hs < 0.0 && align3 == ALIGN_STRETCH && crossAvail >= 0.0 && !wrap {
                    hs = max(crossAvail - cm3, 0.0);
                }
                layoutBox(d, ci3, size3, hs, cw, chDef);
                let hh = d.nodes.items[ci3].h;
                d.fi[lb + k3].cross = hh;
                if align3 == ALIGN_BASELINE {
                    let asc3 = ce3.mt + d.nodes.items[ci3].baseline;
                    maxAsc = max(maxAsc, asc3);
                    maxDesc = max(maxDesc, hh + ce3.mt + ce3.mb - asc3);
                } else {
                    crossOuterMax = max(crossOuterMax, hh + cm3);
                }
            } else {
                let wItem = d.fi[lb + k3].cross;
                let nat3 = d.fi[lb + k3].nat;
                let g3 = d.fi[lb + k3].grow;
                if nat3 < 0.0 || g3 > 0.0 || size3 - nat3 > 0.01 || nat3 - size3 > 0.01 {
                    layoutBox(d, ci3, wItem, size3, cw, chDef);
                }
                crossOuterMax = max(crossOuterMax, wItem + cm3);
            }
        }
        if row {
            lineCross = if crossAvail >= 0.0 && !wrap { crossAvail } else { max(crossOuterMax, maxAsc + maxDesc) };
        } else {
            lineCross = if wrap { crossOuterMax } else { cw };
        }
        for kc in 0..lcn {
            d.fi[lb + kc].lc = lineCross;
            d.fi[lb + kc].la = if row && crossReverse { maxDesc } else { maxAsc };
        }
        ks = ke;
    }
    // 4. `align-content`: share a wrapped container's spare cross space between its lines
    let sumLines: f32 = 0.0;
    for kl in 0..cnt {
        if kl == 0 || d.fi[b0 + kl].ln != d.fi[b0 + kl - 1].ln {
            sumLines += d.fi[b0 + kl].lc;
        }
    }
    sumLines += crossGap * f32(max4(lineN, 0));
    let ystart: f32 = 0.0;
    let ybetween = crossGap;
    if wrap && crossAvail >= 0.0 && sumLines < crossAvail {
        let ac = kwOf(d, st, P_ALIGN_CONTENT);
        let spare = crossAvail - sumLines;
        let nl = f32(lineN + 1);
        if ac == ALIGN_STRETCH {
            for ka in 0..cnt {
                d.fi[b0 + ka].lc += spare / nl;
            }
        } else if ac == ALIGN_END {
            ystart = spare;
        } else if ac == ALIGN_CENTER {
            ystart = spare / 2.0;
        } else if ac == ALIGN_BETWEEN {
            if lineN > 0 {
                ybetween = crossGap + spare / f32(lineN);
            }
        } else if ac == ALIGN_AROUND {
            ystart = spare / nl / 2.0;
            ybetween = crossGap + spare / nl;
        } else if ac == ALIGN_EVENLY {
            ystart = spare / (nl + 1.0);
            ybetween = crossGap + spare / (nl + 1.0);
        }
    }
    let yl = ystart;
    for ky in 0..cnt {
        if ky > 0 && d.fi[b0 + ky].ln != d.fi[b0 + ky - 1].ln {
            yl += d.fi[b0 + ky - 1].lc + ybetween;
        }
        d.fi[b0 + ky].ly = yl;
    }
    // 5. per line: stretch short items, then main and cross positions
    let usedMain: f32 = 0.0;
    let maxMain: f32 = 0.0;
    ks = 0;
    while ks < cnt {
        let lnk2 = d.fi[b0 + ks].ln;
        let ke2 = ks;
        while ke2 < cnt && d.fi[b0 + ke2].ln == lnk2 {
            ke2 += 1;
        }
        let lb2 = b0 + ks;
        let lcn2 = ke2 - ks;
        let lineCross2 = d.fi[lb2].lc;
        let lineBase = d.fi[lb2].la;
        let yoff = d.fi[lb2].ly;
        // Stretch auto cross sizes to their line, keeping containing-block percentage bases.
        if (row && crossAvail < 0.0) || wrap {
            for k4 in 0..lcn2 {
                let ci4 = d.fi[lb2 + k4].id;
                let cst4 = d.nodes.items[ci4].style;
                let ce4 = edgesOf(d, cst4, cw);
                if selfAlign(d, cst4, alignC, row) == ALIGN_STRETCH && (if row { specH(d, cst4, chDef, ce4) } else { specW(d, cst4, cw, ce4) }) < 0.0 {
                    let want = max(lineCross2 - d.fi[lb2 + k4].cm, 0.0);
                    let actual = if row { d.nodes.items[ci4].h } else { d.nodes.items[ci4].w };
                    if want - actual > 0.01 {
                        if row { layoutBox(d, ci4, d.fi[lb2 + k4].size, want, cw, chDef); }
                        else { layoutBox(d, ci4, want, d.fi[lb2 + k4].size, cw, chDef); }
                        d.fi[lb2 + k4].cross = if row { d.nodes.items[ci4].h } else { d.nodes.items[ci4].w };
                    }
                }
            }
        }
        usedMain = gap * f32(max4(lcn2 - 1, 0));
        for k5 in 0..lcn2 {
            usedMain += d.fi[lb2 + k5].size + d.fi[lb2 + k5].mm;
        }
        maxMain = max(maxMain, usedMain);
        let start: f32 = 0.0;
        let between = gap;
        let free = if mainAvail >= 0.0 { mainAvail - usedMain } else { 0.0 };
        if free > 0.0 {
            if justify == JUSTIFY_END {
                start = free;
            } else if justify == JUSTIFY_CENTER {
                start = free / 2.0;
            } else if justify == JUSTIFY_BETWEEN {
                if lcn2 > 1 {
                    between = gap + free / f32(lcn2 - 1);
                }
            } else if justify == JUSTIFY_AROUND {
                start = free / f32(lcn2) / 2.0;
                between = gap + free / f32(lcn2);
            } else if justify == JUSTIFY_EVENLY {
                start = free / f32(lcn2 + 1);
                between = gap + free / f32(lcn2 + 1);
            }
        }
        // auto margins on the main axis share the free space; they replace `justify-content`
        let autoCnt = 0;
        for k7 in 0..lcn2 {
            let cst7 = d.nodes.items[d.fi[lb2 + k7].id].style;
            autoCnt += (if autoM(d, cst7, if row { 3 } else { 0 }) { 1 } else { 0 }) + (if autoM(d, cst7, if row { 1 } else { 2 }) { 1 } else { 0 });
        }
        let autoShare: f32 = 0.0;
        if free > 0.0 && autoCnt > 0 {
            autoShare = free / f32(autoCnt);
            start = 0.0;
            between = gap;
        }
        let pen = start;
        for k6 in 0..lcn2 {
            let ci6 = d.fi[lb2 + k6].id;
            let cst6 = d.nodes.items[ci6].style;
            let ce6 = edgesOf(d, cst6, cw);
            let align6 = selfAlign(d, cst6, alignC, row);
            let size6 = d.fi[lb2 + k6].size;
            let outerCross = d.fi[lb2 + k6].cross + d.fi[lb2 + k6].cm;
            let co: f32 = 0.0;
            let cAutoA = autoM(d, cst6, if row { 0 } else { 3 });
            let cAutoB = autoM(d, cst6, if row { 2 } else { 1 });
            if cAutoA || cAutoB {
                let crossFree = max(lineCross2 - outerCross, 0.0);
                co = if cAutoA && cAutoB { crossFree / 2.0 } else if cAutoA { crossFree } else { 0.0 };
            } else if row && align6 == ALIGN_BASELINE && !crossReverse {
                co = lineBase - (ce6.mt + d.nodes.items[ci6].baseline);
            } else if align6 == ALIGN_CENTER {
                co = (lineCross2 - outerCross) / 2.0;
            } else if align6 == ALIGN_END {
                co = lineCross2 - outerCross;
            }
            let cn = &d.nodes.items[ci6];
            let mainSize = if mainAvail >= 0.0 { mainAvail } else { usedMain };
            let extraA = if autoM(d, cst6, if row { 3 } else { 0 }) { autoShare } else { 0.0 };
            let extraB = if autoM(d, cst6, if row { 1 } else { 2 }) { autoShare } else { 0.0 };
            let mainPos = if reverse { mainSize - pen - extraB - size6 - (if row { ce6.mr } else { ce6.mb }) } else { pen + extraA + (if row { ce6.ml } else { ce6.mt }) };
            let crossSize = if crossAvail >= 0.0 { crossAvail } else { sumLines };
            let crossPos = yoff + co + (if row { ce6.mt } else { ce6.ml });
            if crossReverse {
                // Anchor the baseline group by its descent at reversed cross-start.
                crossPos = if row && align6 == ALIGN_BASELINE { crossSize - yoff - lineBase - cn.baseline }
                    else { crossSize - yoff - co - d.fi[lb2 + k6].cross - (if row { ce6.mb } else { ce6.mr }) };
            }
            if row {
                cn.x = ox + mainPos;
                cn.y = oy + crossPos;
            } else {
                cn.x = ox + crossPos;
                cn.y = oy + mainPos;
            }
            if ks == 0 && k6 == 0 {
                d.nodes.items[id].baseline = cn.y + cn.baseline;
            }
            pen += extraA + extraB + size6 + d.fi[lb2 + k6].mm + between;
        }
        ks = ke2;
    }
    d.fiTop = b0;
    if row {
        if crossAvail >= 0.0 {
            return crossAvail;
        }
        return sumLines;
    }
    return maxMain;
}
