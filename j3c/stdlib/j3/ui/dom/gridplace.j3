// Part of j3.ui.dom (CSS grid: item placement.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// A placement on one axis: the first track (-1: auto) and how many.
struct AxisPos {
    start: int;
    len: int;
}

struct Extent {
    nc: int;
    nr: int;
}


fn gridItem(id: int): FItem {
    return FItem { id: id, grow: 0.0, shrink: 1.0, padM: 0.0, base: 0.0, minM: 0.0, maxM: 1000000000.0, size: 0.0, mm: 0.0, cm: 0.0, cross: 0.0, nat: UNDEF, frozen: false, pos: 0.0, ln: 0, lc: 0.0, la: 0.0, ly: 0.0, c0: 0, c1: 0, r0: 0, r1: 0 };
}

/// Push the in-flow items of grid `id` (`display: contents` flattened) on `Dom.fi`; the count. `fiTop` moves past them;
/// the caller restores it. `place` puts the skipped children (none, absolute) at the content origin.
fn gridCollect(d: &Dom, id: int, place: bool, ox: f32, oy: f32): int {
    let b0 = d.fiTop;
    let cnt = 0;
    let c0 = flatFrom(d, id, d.nodes.items[id].first);
    while c0 >= 0 {
        if skipped(d, c0) {
            if place {
                d.nodes.items[c0].x = ox;
                d.nodes.items[c0].y = oy;
            }
        } else {
            if b0 + cnt >= FI_CAP {
                panic("dom: too many flex/grid items in nested containers");
            }
            d.fi[b0 + cnt] = gridItem(c0);
            cnt += 1;
        }
        c0 = flatFrom(d, id, flatAdv(d, id, c0));
    }
    d.fiTop = b0 + cnt;
    return cnt;
}

/// Track index of a grid line: 1 is the first line, -1 the last line of the explicit grid.
fn lineIdx(l: f32, nExp: int): int {
    let li = int(l);
    if li > 0 {
        return li - 1;
    }
    return maxi(nExp + 1 + li, 0);
}

fn axisPos(sv: Value, ev: Value, nExp: int): AxisPos {
    let sLine = sv.kind == V_NUM && sv.i == 0;
    let eLine = ev.kind == V_NUM && ev.i == 0;
    let sSpan = sv.kind == V_NUM && sv.i == 1;
    let eSpan = ev.kind == V_NUM && ev.i == 1;
    if sLine && eLine {
        let a = lineIdx(sv.f, nExp);
        let b = lineIdx(ev.f, nExp);
        if b < a {
            let t = a;
            a = b;
            b = t;
        }
        return AxisPos { start: a, len: maxi(b - a, 1) };
    }
    if sLine {
        return AxisPos { start: lineIdx(sv.f, nExp), len: if eSpan { int(ev.f) } else { 1 } };
    }
    if eLine {
        let len = if sSpan { int(sv.f) } else { 1 };
        return AxisPos { start: maxi(lineIdx(ev.f, nExp) - len, 0), len: len };
    }
    return AxisPos { start: -1, len: if sSpan { int(sv.f) } else if eSpan { int(ev.f) } else { 1 } };
}

/// The table holds one byte per cell, `w` per row, and is all zero between placements. It grows by doubling when a cell is marked
/// past its end, so a read past the end is a free cell.
fn occFree(d: &Dom, w: int, p0: int, pl: int, q0: int, ql: int): bool {
    for q in q0..(q0 + ql) {
        for p in p0..(p0 + pl) {
            if q * w + p < d.occ.len && d.occ[q * w + p] != 0 {
                return false;
            }
        }
    }
    return true;
}

fn occMark(d: &Dom, w: int, p0: int, pl: int, q0: int, ql: int) {
    let need = (q0 + ql) * w;
    if need > d.occ.len {
        if need > OCC_MAX {
            panic("dom: grid has too many cells");
        }
        let bigger = d.mem.alloc::<u8>(maxi(d.occ.len * 2, need));
        for i in 0..d.occ.len {
            bigger[i] = d.occ[i];
        }
        d.occ = bigger;
    }
    for q in q0..(q0 + ql) {
        for p in p0..(p0 + pl) {
            d.occ[q * w + p] = 1;
        }
    }
}

/// Give every item of `d.fi[b0..b0+cnt]` its area (`c0..c1`, `r0..r1`): the CSS auto-placement algorithm with the
/// sparse "next free cell" cursor (`dense` restarts it for each item), in source order (`order` is not used).
/// Items with both positions fixed go first, then items fixed to a row (column for `grid-auto-flow: column`), then
/// the rest. Works in terms of a primary axis (the one the cursor runs along: columns for `row` flow) and a secondary
/// one; for `column` flow the fields are swapped going in and out. Lines before the first (negative past the start) clamp to it.
fn gridPlace(d: &Dom, st: int, b0: int, cnt: int, nce: int, nre: int, flow: int): Extent {
    let flowCol = flow % 2 == 1;
    let dense = flow >= 2;
    let ar = areaTable(d, st);
    for i in 0..cnt {
        let it1 = &d.fi[b0 + i];
        let cst = d.nodes.items[it1.id].style;
        let cp = axisPos(resolveLine(d, ar, d.css.get(cst, P_GRID_CS), true, false), resolveLine(d, ar, d.css.get(cst, P_GRID_CE), true, true), nce);
        let rp = axisPos(resolveLine(d, ar, d.css.get(cst, P_GRID_RS), false, false), resolveLine(d, ar, d.css.get(cst, P_GRID_RE), false, true), nre);
        // c0/r0: start (-1 auto) and c1/r1: length for now; P is the c side
        if flowCol {
            it1.c0 = rp.start;
            it1.c1 = rp.len;
            it1.r0 = cp.start;
            it1.r1 = cp.len;
        } else {
            it1.c0 = cp.start;
            it1.c1 = cp.len;
            it1.r0 = rp.start;
            it1.r1 = rp.len;
        }
        it1.frozen = false;
    }
    let nP = maxi(if flowCol { nre } else { nce }, 1);
    // the occupancy table is `wP` wide: enough for every fixed item and for the items that may be pushed past the explicit tracks
    let wP = nP;
    let defQ = 0;
    let lockedP = 0;
    for i in 0..cnt {
        let it2 = &d.fi[b0 + i];
        wP = maxi(wP, it2.c1);
        if it2.c0 >= 0 {
            wP = maxi(wP, it2.c0 + it2.c1);
        }
        if it2.r0 >= 0 {
            defQ = maxi(defQ, it2.r0 + it2.r1);
            if it2.c0 < 0 {
                lockedP += it2.c1;
            }
        }
    }
    wP += lockedP;
    let g0 = d.gTop;
    let lastP = gsAlloc(d, defQ + 1);
    // 1. both positions fixed
    for i in 0..cnt {
        let it3 = &d.fi[b0 + i];
        if it3.c0 >= 0 && it3.r0 >= 0 {
            occMark(d, wP, it3.c0, it3.c1, it3.r0, it3.r1);
            it3.frozen = true;
        }
    }
    // 2. fixed secondary position, auto primary: the first free place, past the earlier ones in that line when sparse
    for i in 0..cnt {
        let it4 = &d.fi[b0 + i];
        if !it4.frozen && it4.r0 >= 0 {
            let p = if dense { 0 } else { int(d.gs[lastP + it4.r0]) };
            while !occFree(d, wP, p, it4.c1, it4.r0, it4.r1) {
                p += 1;
                if p + it4.c1 > wP {
                    panic("dom: grid placement overflow");
                }
            }
            it4.c0 = p;
            occMark(d, wP, p, it4.c1, it4.r0, it4.r1);
            it4.frozen = true;
            d.gs[lastP + it4.r0] = f32(p + it4.c1);
        }
    }
    // 3. the rest, a cursor wrapping at the implicit primary size
    let nImp = nP;
    for i in 0..cnt {
        let it5 = &d.fi[b0 + i];
        nImp = maxi(nImp, if it5.c0 >= 0 { it5.c0 + it5.c1 } else { it5.c1 });
    }
    let curP = 0;
    let curQ = 0;
    for i in 0..cnt {
        let it6 = &d.fi[b0 + i];
        if it6.frozen {
            continue;
        }
        if it6.c0 >= 0 {
            if dense {
                curQ = 0;
            } else if it6.c0 < curP {
                curQ += 1;
            }
            curP = it6.c0;
            while !occFree(d, wP, it6.c0, it6.c1, curQ, it6.r1) {
                curQ += 1;
            }
        } else {
            if dense {
                curP = 0;
                curQ = 0;
            }
            let found = false;
            while !found {
                if curP + it6.c1 > nImp {
                    curQ += 1;
                    curP = 0;
                } else if occFree(d, wP, curP, it6.c1, curQ, it6.r1) {
                    found = true;
                } else {
                    curP += 1;
                }
            }
            it6.c0 = curP;
        }
        it6.r0 = curQ;
        occMark(d, wP, it6.c0, it6.c1, it6.r0, it6.r1);
        it6.frozen = true;
    }
    // leave the table zeroed: only the rows that were used
    let usedQ = 0;
    for i in 0..cnt {
        usedQ = maxi(usedQ, d.fi[b0 + i].r0 + d.fi[b0 + i].r1);
    }
    for i in 0..mini(usedQ * wP, d.occ.len) {
        d.occ[i] = 0;
    }
    d.gTop = g0;
    let nc = nce;
    let nr = nre;
    for i in 0..cnt {
        let it7 = &d.fi[b0 + i];
        it7.c1 += it7.c0;
        it7.r1 += it7.r0;
        if flowCol {
            let a0 = it7.c0;
            let a1 = it7.c1;
            it7.c0 = it7.r0;
            it7.c1 = it7.r1;
            it7.r0 = a0;
            it7.r1 = a1;
        }
        nc = maxi(nc, it7.c1);
        nr = maxi(nr, it7.r1);
    }
    return Extent { nc: nc, nr: nr };
}
