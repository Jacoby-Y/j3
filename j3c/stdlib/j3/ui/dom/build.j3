// Part of j3.ui.dom (build API: tag, open/text/close, classes, inline styles); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Start a frame of build calls (creates the root on first use).
    fn begin(this: &Dom) {
        if this.nodes.len == 0 {
            let r = newNode(this, K_ELEM, this.tRoot, 0, 0);
            this.nodes.items[r].parent = -1;
            this.mnodes.items[r].parent = -1;
        }
        this.sp = 0;
        this.stack[0] = 0;
        this.cursor[0] = -1;
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.gsp = 0;
    }

    /// Finish the frame: the root's unvisited children are removed.
    fn end(this: &Dom) {
        trimTail(this, this.stack[0], this.cursor[0]);
    }

    /// Next child element at `slot`: reuse it or insert. Returns its id. The slot is local (below
    /// 4096) and offset by `enter`; faded-out ghosts are skipped.
    fn open(this: &Dom, slot0: int, tag: int, scope: int): int {
        let slot = realSlot(this, slot0);
        let parent = this.stack[this.sp];
        let at = this.cursor[this.sp];
        let nxt = if at < 0 { this.nodes.items[parent].first } else { this.nodes.items[at].next };
        let from = nxt;
        nxt = skipGhost(this, nxt);
        while nxt >= 0 && this.nodes.items[nxt].kind == K_ELEM && this.nodes.items[nxt].slot < slot && ownsNode(this, nxt) {
            let gone = nxt;
            nxt = skipGhost(this, this.nodes.items[nxt].next);
            removeNode(this, gone);
        }
        let id = -1;
        if nxt >= 0 {
            let nn = &this.nodes.items[nxt];
            if nn.kind == K_ELEM && nn.slot == slot && nn.tag == tag && nn.scope == scope && ownsNode(this, nxt) {
                id = nxt;
            }
        }
        if id < 0 && this.ghosts > 0 {
            id = reviveGhost(this, from, nxt, slot, tag, scope);
        }
        if id < 0 {
            id = newNode(this, K_ELEM, tag, slot, scope);
            insertBefore(this, parent, id, nxt);
        }
        this.cursor[this.sp] = id;
        if this.sp + 1 >= MAX_DEPTH {
            panic("dom: nesting too deep");
        }
        this.sp += 1;
        this.stack[this.sp] = id;
        this.cursor[this.sp] = -1;
        this.sv[2 * this.sp] = this.base;
        this.sv[2 * this.sp + 1] = this.scale;
        this.base = 0;
        this.scale = SLOT_UNIT;
        return id;
    }

    /// Done with the element `open` returned: its unvisited children are removed.
    fn close(this: &Dom) {
        trimTail(this, this.stack[this.sp], this.cursor[this.sp]);
        this.base = this.sv[2 * this.sp];
        this.scale = this.sv[2 * this.sp + 1];
        this.sp -= 1;
    }

    /// Next child text node with content `s` (copied, and only when the bytes changed).
    fn text(this: &Dom, s: string): int {
        let parent = this.stack[this.sp];
        let at = this.cursor[this.sp];
        let nxt = if at < 0 { this.nodes.items[parent].first } else { this.nodes.items[at].next };
        nxt = skipGhost(this, nxt);
        let id = -1;
        if nxt >= 0 && this.nodes.items[nxt].kind == K_TEXT && ownsNode(this, nxt) {
            id = nxt;
        } else {
            id = newNode(this, K_TEXT, this.tText, -1, 0);
            insertBefore(this, parent, id, nxt);
        }
        this.cursor[this.sp] = id;
        if storeBytes(this, &this.nodes.items[id], s) {
            markDirty(this, id);
            aTouch(this, parent);
            // `:empty` ignores whitespace-only text
            let blank = true;
            for i in 0..s.len {
                if s[i] > 32 {
                    blank = false;
                    break;
                }
            }
            if blank == hasBit(this.mnodes.items[id].flags, FL_NONBLANK) {
                this.mnodes.items[id].flags = if blank { this.mnodes.items[id].flags - FL_NONBLANK } else { this.mnodes.items[id].flags + FL_NONBLANK };
                markKids(this, parent);
                markHas(this, id, 2, 0);
            }
        }
        return id;
    }

    /// Add class `name` if missing.
    fn cls(this: &Dom, id: int, name: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsId(id, this.css.intern(name));
    }

    /// `cls` with the class interned once (`css.intern`): no name search per frame.
    fn clsId(this: &Dom, id: int, c: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        for i in 0..n.ncls {
            if n.clsBuf[i] == c {
                return;
            }
        }
        if n.ncls >= 8 {
            panic("dom: more than 8 classes");
        }
        n.clsBuf[n.ncls] = c;
        n.ncls += 1;
        this.mnodes.items[id].classes = []int { ptr: n.clsBuf.ptr, len: n.ncls };
        markStyle(this, id);
        markHas(this, id, 0, c);
    }

    /// Add class `name` when `on`, remove it otherwise.
    fn clsIf(this: &Dom, id: int, name: string, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsIfId(id, this.css.intern(name), on);
    }

    /// `clsIf` with the class interned once.
    fn clsIfId(this: &Dom, id: int, c: int, on: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        if on {
            this.clsId(id, c);
            return;
        }
        let n = &this.nodes.items[id];
        for i in 0..n.ncls {
            if n.clsBuf[i] == c {
                n.clsBuf[i] = n.clsBuf[n.ncls - 1];
                n.ncls -= 1;
                this.mnodes.items[id].classes = []int { ptr: n.clsBuf.ptr, len: n.ncls };
                markStyle(this, id);
                markHas(this, id, 0, c);
                return;
            }
        }
    }

    /// `class="a r{n}"` holes: `s` is the text of the non-literal words. Classes it added last time are
    /// dropped and the new words added, only when the text changed.
    fn clsDyn(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsWords(id, 0, s);
    }

    /// `class` / `class:x` written on a component tag: the text its root element gets, same rules as `clsDyn`
    /// but a channel of its own, so the root's own holes and the parent's classes never drop each other's words.
    fn clsPass(this: &Dom, id: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        this.clsWords(id, 1, s);
    }

    fn clsWords(this: &Dom, id: int, ch: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        let y = dynOf(this, id);
        let h = int(hashOf(s));
        if y.cl[ch] == s.len && y.ch[ch] == h {
            return;
        }
        y.cl[ch] = s.len;
        y.ch[ch] = h;
        for i in 0..y.cn[ch] {
            this.clsIfId(id, y.cids[ch * 8 + i], false);
        }
        y.cn[ch] = 0;
        let a = 0;
        for i in 0..=s.len {
            if i == s.len || isWs(s[i]) {
                if i > a {
                    if y.cn[ch] >= 8 {
                        panic("dom: more than 8 classes");
                    }
                    let c = this.css.intern(s[a..i]);
                    y.cids[ch * 8 + y.cn[ch]] = c;
                    y.cn[ch] += 1;
                    this.clsId(id, c);
                }
                a = i + 1;
            }
        }
    }

    /// The parent component whose scoped rules (those naming a class) also apply to this root element.
    fn scopePass(this: &Dom, id: int, scope: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        let m = &this.mnodes.items[id];
        if m.scope2 != scope {
            m.scope2 = scope;
            markStyle(this, id);
        }
    }

    /// `style:` written on a component tag, slot `k` of the root: `kind` 0 none, 1 number `f`, 2 text `s`.
    fn stylePass(this: &Dom, id: int, k: int, kind: int, name: string, f: f32, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        if kind == 1 {
            this.styleNum(id, k, name, f);
        } else if kind == 2 || dynOf(this, id).sk[k] != 0 {
            this.styleStr(id, k, name, if kind == 2 { s } else { "" });
        }
    }

    /// `style:prop={number}` (attribute number `k` of the element): an inline value that beats every
    /// rule and transitions like one. Lengths are px. See `j3.ui.dynattr`.
    fn styleNum(this: &Dom, id: int, k: int, name: string, v: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        if dynattr.setNum(this.css, dynOf(this, id), k, name, v) {
            markInline(this, id);
        }
    }

    /// `style:prop="css value"` (see `styleNum`).
    fn styleStr(this: &Dom, id: int, k: int, name: string, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        if dynattr.setStr(this.css, dynOf(this, id), k, name, s) {
            markInline(this, id);
        }
    }

    /// `styleNum` / `styleStr` from generated code: a warning names the attribute's place in the `.j3ui`.
    fn styleNumAt(this: &Dom, id: int, k: int, name: string, v: f32, file: string, line: int, col: int) {
        let w0 = this.css.warns.len;
        this.styleNum(id, k, name, v);
        dynattr.placeWarns(this.css, w0, file, line, col);
    }

    fn styleStrAt(this: &Dom, id: int, k: int, name: string, s: string, file: string, line: int, col: int) {
        let w0 = this.css.warns.len;
        this.styleStr(id, k, name, s);
        dynattr.placeWarns(this.css, w0, file, line, col);
    }

    /// Force the next `layout` to redo every box (benchmarks, font reloads).
    fn invalidate(this: &Dom) {
        this.gen += 1;
        for i in 0..this.nodes.len {
            this.nodes.items[i].dirty = true;
            this.nodes.items[i].dirtyGen = this.gen;
        }
    }
}

