// Part of j3.ui.dom (Checkbox, radio, meter, gauge, field and select drawing, ripples and scrollbars.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn bytesOf(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

fn alpha(c: Color, a: int): Color {
    return Color { r: c.r, g: c.g, b: c.b, a: u8(a) };
}

fn paintCheckbox(n: &Node, acc: Color, w: f32, h: f32) {
    let bx = Vec2 { x: w, y: h };
    let zero = Vec2 { x: 0.0, y: 0.0 };
    if n.checked {
        paint.roundRect(zero, bx, 3.0, acc);
        let white = Color { r: 255, g: 255, b: 255, a: 255 };
        paint.line(Vec2 { x: w * 0.24, y: h * 0.52 }, Vec2 { x: w * 0.43, y: h * 0.72 }, 2.0, white);
        paint.line(Vec2 { x: w * 0.43, y: h * 0.72 }, Vec2 { x: w * 0.78, y: h * 0.30 }, 2.0, white);
    } else {
        paint.roundRect(zero, bx, 3.0, Color { r: 88, g: 91, b: 112, a: 255 });
        paint.roundRect(Vec2 { x: 1.5, y: 1.5 }, Vec2 { x: w - 3.0, y: h - 3.0 }, 2.0, Color { r: 49, g: 50, b: 68, a: 255 });
    }
}

fn paintRadio(n: &Node, acc: Color, w: f32, h: f32) {
    let c = Vec2 { x: w * 0.5, y: h * 0.5 };
    let r = min(w, h) * 0.5;
    if n.checked {
        paint.circle(c, r, acc);
        paint.circle(c, r * 0.4, Color { r: 255, g: 255, b: 255, a: 255 });
    } else {
        paint.circle(c, r, Color { r: 88, g: 91, b: 112, a: 255 });
        paint.circle(c, r - 1.5, Color { r: 49, g: 50, b: 68, a: 255 });
    }
}

/// Which of a `<meter>`'s three regions `x` falls in: 0 below `low`, 1 between, 2 above `high`.
fn meterRegion(x: f32, low: f32, high: f32): int {
    if x < low { return 0; }
    if x > high { return 2; }
    return 1;
}

/// How good a `<meter>`'s value is, by the HTML rules: the region of the value against the region of its `optimum`. The same region is
/// 0 (good), the next one 1 (ok), the far one 2 (bad).
pub fn meterGrade(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    let lo = n.attrMin;
    let hi = max(n.attrMax, lo);
    let low = if n.mlow > METER_UNSET { max(lo, min(hi, n.mlow)) } else { lo };
    let high = if n.mhigh > METER_UNSET { max(low, min(hi, n.mhigh)) } else { hi };
    let opt = if n.mopt > METER_UNSET { max(lo, min(hi, n.mopt)) } else { (lo + hi) / 2.0 };
    let gap = meterRegion(n.value, low, high) - meterRegion(opt, low, high);
    if gap < 0 { gap = 0 - gap; }
    return gap;
}

/// How much of a `<progress>` or `<meter>` is filled, 0..1; -1 for a progress with no value (indeterminate).
pub fn gaugeFrac(d: &Dom, id: int): f32 {
    let n = &d.nodes.items[id];
    if n.tag == d.tMeter {
        let span = n.attrMax - n.attrMin;
        if span <= 0.0 { return 0.0; }
        return max(0.0, min(1.0, (n.value - n.attrMin) / span));
    }
    if n.value < 0.0 { return -1.0; }
    if n.attrMax <= 0.0 { return 0.0; }
    return min(1.0, n.value / n.attrMax);
}

/// Left edge, in the track, of the indeterminate bar `sw` wide in a track `cw` wide: it crosses every 1.4 s, and sits in the middle under
/// `prefers-reduced-motion`.
pub fn sweepX(d: &Dom, cw: f32, sw: f32): f32 {
    if d.css.reduced {
        return (cw - sw) / 2.0;
    }
    let t = (d.now - 1400.0 * f32(int(d.now / 1400.0))) / 1400.0;
    return (0.0 - sw) + t * (cw + sw);
}

/// A color custom property of style `st` (it resolves like `var()`: the node's own rules, then inherited), `dflt` when absent or not a color.
fn styleColorVar(d: &Dom, st: int, name: string, dflt: int): int {
    let v = varValue(d.css, d.css.varsOf(st), d.css.intern(name));
    if v.kind == V_COLOR {
        return v.c;
    }
    return dflt;
}

/// Fill `n.mc0..2` (good, ok, bad) for style `st`: looked up once per computed style, so a steady frame scans nothing.
fn meterColors(d: &Dom, n: &Node, st: int) {
    if n.mcSt == st {
        return;
    }
    n.mcSt = st;
    n.mc0 = styleColorVar(d, st, "--j3-meter-good", 1069109503);
    n.mc1 = styleColorVar(d, st, "--j3-meter-ok", 3533251327);
    n.mc2 = styleColorVar(d, st, "--j3-meter-bad", 4166076927);
}

/// The packed fill color of `<meter>` `id` (style `st`): its grade picks `--j3-meter-good`, `-ok` or `-bad`.
pub fn meterFill(d: &Dom, id: int, st: int): int {
    let n = &d.nodes.items[id];
    meterColors(d, n, st);
    let g = meterGrade(d, id);
    return if g == 0 { n.mc0 } else if g == 1 { n.mc1 } else { n.mc2 };
}

/// `<progress>` and `<meter>`: the element's own `background` is the track (painted before); this draws the fill inside its border, rounded by
/// its `border-radius`. A progress fills with `accent-color`, a meter with the good / ok / bad color of `meterGrade` (`--j3-meter-good`, `-ok`
/// and `-bad`, on `:root` or any ancestor or the meter itself). A progress without a value sweeps a bar across the track.
fn paintGauge(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.bl - e.br;
    let ch = h - e.bt - e.bb;
    if cw <= 0.0 || ch <= 0.0 {
        return;
    }
    let r = min(ch / 2.0, max(0.0, edgeOf(d, st, P_RADIUS_TL, w)));
    let at = Vec2 { x: e.bl, y: e.bt };
    let frac = gaugeFrac(d, id);
    let col = toColor(accentOf(d, st));
    if n.tag == d.tMeter {
        col = toColor(meterFill(d, id, st));
    }
    if frac > 0.0 {
        paint.roundRect(at, Vec2 { x: cw * frac, y: ch }, r, col);
    } else if frac < 0.0 {
        let sw = cw * 0.4;
        paint.pushClip(at, Vec2 { x: cw, y: ch });
        paint.roundRect(Vec2 { x: e.bl + sweepX(d, cw, sw), y: e.bt }, Vec2 { x: sw, y: ch }, r, col);
        paint.popClip();
    }
}

/// A text, search, password or textarea box inside its border box `w` x `h`: the text from the view start,
/// selection, caret and IME composition. A password shows one bullet per code point (`Edit.maskOf`); the
/// view start, caret and anchor then count bullets. Tells the IME where the caret is while focused.
fn paintField(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.pl - e.pr - e.bl - e.br;
    let ch = h - e.pt - e.pb - e.bt - e.bb;
    let font = fontOf(d, st);
    if font.raw == 0 || cw < 1.0 {
        return;
    }
    let ty = d.mnodes.items[id].type;
    let search = ty == d.vSearch;
    let pw = ty == d.vPassword;
    let ed = n.edit >= 0 && d.focus == id;
    let blink = false;
    let tc = toColor(colorOf(d, st, P_COLOR));
    let acc = toColor(accentOf(d, st));
    let look = Look { text: tc, hint: alpha(tc, 110), sel: alpha(acc, 100), caret: tc, chip: alpha(acc, 70), link: acc, dim: alpha(tc, 170) };
    let bold = isBold(d, st);
    let tm = enterText(d, st);
    let comp = if ed { d.kin.comp } else { "" };
    let at = Vec2 { x: -1.0, y: 0.0 };
    let atH = ch;
    paint.pushTranslate(Vec2 { x: e.bl + e.pl, y: e.bt + e.pt });
    paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: cw, y: ch });
    if ty == d.vTextarea {
        let t = &d.eds.items[d.claim(id)];
        blink = ed && int((d.now - t.t0) / 530.0) % 2 == 0;
        at = area.paint(t, font, bold, ed, blink, n.ph, comp, cw, ch, &look);
        t.px = at.x;
        t.py = at.y;
        atH = f32(fontLine(font));
    } else {
        let avail = if search { cw - 18.0 } else { cw };
        let s = n.sval;
        let vs = 0;
        let cur = 0;
        let anc = 0;
        if ed || pw {
            let te = &d.eds.items[d.claim(id)];
            if ed {
                s = te.str();
                blink = int((d.now - te.t0) / 530.0) % 2 == 0;
            }
            vs = te.vs;
            cur = te.cur;
            anc = te.anc;
            if pw {
                let m = te.maskOf(s);
                cur = textedit.toMask(s, cur);
                anc = textedit.toMask(s, anc);
                s = m;
            }
            if ed {
                vs = field.scroll(font, bold, s, vs, cur, avail);
                te.vs = vs;
            }
        }
        at.x = field.paint(font, bold, s, vs, cur, anc, ed, blink, n.ph, comp, avail, ch, &look);
        if search && s.len > 0 {
            let c = Vec2 { x: cw - 9.0, y: ch / 2.0 };
            paint.line(Vec2 { x: c.x - 4.0, y: c.y - 4.0 }, Vec2 { x: c.x + 4.0, y: c.y + 4.0 }, 1.5, alpha(tc, 150));
            paint.line(Vec2 { x: c.x - 4.0, y: c.y + 4.0 }, Vec2 { x: c.x + 4.0, y: c.y - 4.0 }, 1.5, alpha(tc, 150));
        }
    }
    paint.popClip();
    paint.popTransform();
    if ed && at.x >= 0.0 {
        game.textInputRect(d.absX(id) + e.bl + e.pl + at.x, d.absY(id) + e.bt + e.pt + at.y, 1.0, atH);
    }
    leaveText(tm);
}

/// A closed `<select>`: the chosen label(s) (or the placeholder) and a chevron.
fn paintSelect(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, st, n.basisW);
    let cw = w - e.pl - e.pr - e.bl - e.br;
    let ch = h - e.pt - e.pb - e.bt - e.bb;
    let font = fontOf(d, st);
    let tc = toColor(colorOf(d, st, P_COLOR));
    paint.pushTranslate(Vec2 { x: e.bl + e.pl, y: e.bt + e.pt });
    let cx = cw - 9.0;
    let cy = ch / 2.0;
    let open = d.pop.kind == popup.SELECT && d.pop.owner == id;
    let dy: f32 = if open { -3.0 } else { 3.0 };
    paint.line(Vec2 { x: cx - 4.0, y: cy - dy }, Vec2 { x: cx, y: cy + dy }, 1.5, alpha(tc, 170));
    paint.line(Vec2 { x: cx, y: cy + dy }, Vec2 { x: cx + 4.0, y: cy - dy }, 1.5, alpha(tc, 170));
    if font.raw != 0 && cw > 20.0 {
        paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: cw - 18.0, y: ch });
        let y = f32(int((ch - f32(fontLine(font))) / 2.0 + 0.5));
        let x: f32 = 0.0;
        let any = false;
        let bold = isBold(d, st);
        let tm = enterText(d, st);
        let o = nextOption(d, id, -1);
        while o >= 0 && x < cw {
            if optSelected(d, id, o) {
                let lab = optLabel(d, o);
                if any {
                    paint.text(font, Vec2 { x: x, y: y }, ", ", tc);
                    x += textWidth(font, bytesOf(", "), bold);
                }
                paint.text(font, Vec2 { x: x, y: y }, lab, tc);
                x += textWidth(font, bytesOf(lab), bold);
                any = true;
                if !n.multi {
                    break;
                }
            }
            o = nextOption(d, id, o);
        }
        if !any && n.ph.len > 0 {
            paint.text(font, Vec2 { x: 0.0, y: y }, n.ph, alpha(tc, 110));
        }
        leaveText(tm);
        paint.popClip();
    }
    paint.popTransform();
}

/// Checkbox, radio, range, text, color and select controls, drawn inside the (possibly styled) box.
fn paintControl(d: &Dom, id: int, st: int, w: f32, h: f32) {
    let n = &d.nodes.items[id];
    let ty = d.mnodes.items[id].type;
    let acc = toColor(accentOf(d, st));
    if n.tag == d.tProgress || n.tag == d.tMeter {
        paintGauge(d, id, st, w, h);
    } else if n.tag == d.tSelect {
        paintSelect(d, id, st, w, h);
    } else if ty == d.vCheckbox {
        paintCheckbox(n, acc, w, h);
    } else if ty == d.vRadio {
        paintRadio(n, acc, w, h);
    } else if ty == d.vRange {
        slider.paint(w, h, n.attrMin, n.attrMax, n.value, n.high, n.multi, acc, d.focus == id, d.thumb);
    } else if ty == d.vColor {
        let rgb = colorpick.parseHex(n.sval);
        if rgb < 0 {
            rgb = 0;
        }
        paint.roundRect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h }, 4.0, colorpick.color(rgb));
    } else {
        paintField(d, id, st, w, h);
    }
}
