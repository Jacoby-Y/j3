// Part of j3.ui.dom (What a restyle changed: OUTER_PROPS, PAINT_PROPS, styleDiff.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// What a parent's layout reads from a child's style: its box sizes and edges, placement, and the flex and grid item props.
/// Padding, margin and border widths are four props each from `P_PADDING_TOP`, `P_MARGIN_TOP`, `P_BORDER_TOP_WIDTH` (`sameOuter`).
const OUTER_PROPS: [32]int = [
    P_DISPLAY, P_POSITION, P_LEFT, P_RIGHT, P_TOP, P_BOTTOM, P_FLEX, P_WIDTH, P_HEIGHT, P_MIN_WIDTH, P_MIN_HEIGHT,
    P_PADDING_TOP, P_MARGIN_TOP, P_BORDER_TOP_WIDTH, P_BOX_SIZING, P_OVERFLOW_Y, P_BORDER_STYLE, P_OVERFLOW_X,
    P_MAX_HEIGHT, P_MAX_WIDTH, P_FLEX_BASIS, P_FLEX_SHRINK, P_ALIGN_SELF, P_ORDER, P_ASPECT_RATIO, P_GRID_CS, P_GRID_CE,
    P_GRID_RS, P_GRID_RE, P_GRID_AREAS, P_JUSTIFY_SELF, P_VALIGN,
];

/// Styles `a` and `b` agree on every `OUTER_PROPS` value.
fn sameOuter(d: &Dom, a: int, b: int): bool {
    if a == b {
        return true;
    }
    for i in 0..32 {
        let p = OUTER_PROPS[i];
        let n = if p == P_PADDING_TOP || p == P_MARGIN_TOP || p == P_BORDER_TOP_WIDTH { 4 } else { 1 };
        for k in 0..n {
            if !sameVal(d.css.get(a, p + k), d.css.get(b, p + k)) {
                return false;
            }
        }
    }
    return true;
}

fn sameVal(x: Value, y: Value): bool {
    return x.kind == y.kind && x.f == y.f && x.i == y.i && x.c == y.c;
}

/// `styleDiff` bits: a property layout reads differs (anything but `PAINT_PROPS`); an inherited value or the custom properties differ
/// (asked only for a `style:`-only restyle: otherwise the subtree restyles anyway).
const D_LAYOUT: int = 1;
const D_INHERIT: int = 2;

/// What layout and text measurement never read (checked by grepping every reader): a change of only these repaints, it
/// does not lay out. `inlineBox` adds the three that give an inline element a box of its own (`inlineDeco`). Everything
/// else counts as layout, so a property added later is safe until it is listed here. Border colors and radii are four
/// props each from `P_BORDER_TOP_COLOR` and `P_RADIUS_TL` (`paintProp`).
const PAINT_PROPS: [24]int = [
    P_BACKGROUND, P_COLOR, P_BORDER_TOP_COLOR, P_RADIUS_TL, P_OPACITY, P_ACCENT_COLOR, P_TRANSFORM, P_TRANSLATE, P_ROTATE,
    P_SCALE, P_ORIGIN, P_BOX_SHADOW, P_TEXT_SHADOW, P_STROKE_COLOR, P_BG_IMAGE, P_OUTLINE_COLOR, P_OUTLINE_WIDTH,
    P_OUTLINE_STYLE, P_OUTLINE_OFFSET, P_CURSOR, P_SB_THUMB, P_SB_TRACK, P_VISIBILITY, P_Z_INDEX,
];

fn paintProp(p: int, inlineBox: bool): bool {
    if inlineBox && (p == P_BACKGROUND || p == P_BG_IMAGE || p == P_BOX_SHADOW) {
        return false;
    }
    if p > P_BORDER_TOP_COLOR && p < P_BORDER_TOP_COLOR + 4 {
        p = P_BORDER_TOP_COLOR;
    } else if p > P_RADIUS_TL && p < P_RADIUS_TL + 4 {
        p = P_RADIUS_TL;
    }
    for i in 0..24 {
        if PAINT_PROPS[i] == p {
            return true;
        }
    }
    return false;
}

/// How styles `a` and `b` differ (`D_*` bits), in one pass over the values; only a differing one looks its property up.
/// Without `lay` the layout bit is set unlooked; the inherited bit is looked for only with `inh`.
fn styleDiff(d: &Dom, a: int, b: int, inlineBox: bool, lay: bool, inh: bool): int {
    let r = if lay { 0 } else { D_LAYOUT };
    let want = D_LAYOUT;
    if inh {
        want = D_LAYOUT + D_INHERIT;
        if d.css.varsOf(a) != d.css.varsOf(b) {
            r += D_INHERIT;
        }
    }
    if r == want {
        return r;
    }
    let vs = d.css.vals.items;
    let ra = vs[a * NPROPS..(a + 1) * NPROPS];
    let rb = vs[b * NPROPS..(b + 1) * NPROPS];
    for p in 0..NPROPS {
        if ra[p].i != rb[p].i || ra[p].kind != rb[p].kind || ra[p].c != rb[p].c || ra[p].f != rb[p].f {
            r = diffBits(r, p, inlineBox, inh);
            if r == want {
                return r;
            }
        }
    }
    return r;
}

/// `r` with the bits property `p` (whose value differs) adds.
fn diffBits(r: int, p: int, inlineBox: bool, inh: bool): int {
    if r % 2 == 0 && !paintProp(p, inlineBox) {
        r += D_LAYOUT;
    }
    if inh && r < D_INHERIT && inherits(p) {
        r += D_INHERIT;
    }
    return r;
}

/// `styleDiff` (inherited bit included) of the inline styles `a` and `b` of one element, built over the same cascade style
/// and parent (`Dyn.rb`): only what their overrides wrote can differ. Anything else takes the full pass.
fn inlineDiff(d: &Dom, y: &Dyn, a: int, b: int, inlineBox: bool, lay: bool): int {
    let sa = if a == y.a { 0 } else if a == y.b { 1 } else { -1 };
    let sb = if b == y.a { 0 } else if b == y.b { 1 } else { -1 };
    if sa < 0 || sb < 0 || sa == sb || y.rb[sa] < 0 || y.rb[sa] != y.rb[sb] || y.rp[sa] != y.rp[sb] {
        return styleDiff(d, a, b, inlineBox, lay, true);
    }
    let r = if lay { 0 } else { D_LAYOUT };
    for k in 0..2 {
        let s = if k == 0 { sa } else { sb };
        for i in 0..y.rn[s] {
            let p = y.rprops[s * dynattr.SLOTS * dynattr.PER + i];
            if !sameVal(d.css.get(a, p), d.css.get(b, p)) {
                r = diffBits(r, p, inlineBox, true);
            }
        }
    }
    return r;
}
