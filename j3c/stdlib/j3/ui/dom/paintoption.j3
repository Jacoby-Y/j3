// Part of j3.ui.dom (Select/option visuals and labels.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// The next `<option>` child of `sel` after its child `c` (-1: from the first); -1 when none.
pub fn nextOption(d: &Dom, sel: int, c: int): int {
    let k = if c < 0 { d.nodes.items[sel].first } else { d.nodes.items[c].next };
    while k >= 0 {
        if d.nodes.items[k].kind == K_ELEM && d.nodes.items[k].tag == d.tOption {
            return k;
        }
        k = d.nodes.items[k].next;
    }
    return -1;
}

/// Sync after generated updates, before resolving/layout: a conditional source child may have been
/// removed since input built the rows. Never paint borrowed media or stale text for an extra frame.
fn refreshOptionVisuals(d: &Dom) {
    if d.ptRoot < 0 || d.pop.kind != popup.SELECT { return; }
    let row = d.nodes.items[d.ptRoot].first;
    while row >= 0 {
        if d.nodes.items[row].pidx >= 0 {
            let check = d.nodes.items[row].first;
            let label = if check >= 0 { d.nodes.items[check].next } else { -1 };
            if label >= 0 {
                let src = d.nodes.items[label].optionSource;
                d.buildIn(label);
                if src >= 0 && d.nodes.items[src].kind == K_ELEM && d.nodes.items[src].tag == d.tOption {
                    optionVisuals(d, src);
                }
                d.buildOut();
            }
        }
        row = d.nodes.items[row].next;
    }
}

/// Visual children of one option, mirrored only for the rows in the popup window. Matching uses the
/// source ancestry; layout/inheritance uses the real row. Media is borrowed, inline styles are owned.
/// Call only while building inside the row's label; source nodes remain under their logical option.
pub fn optionVisuals(d: &Dom, source: int) {
    let c = d.nodes.items[source].first;
    let slot = 0;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if !n.ghost && !n.rt {
            if n.kind == K_TEXT {
                d.text(d.textOf(c));
            } else if n.kind == K_ELEM {
                let tok = d.enter(slot / 4096);
                let id = d.open(slot % 4096, n.tag, n.scope);
                let out = &d.nodes.items[id];
                let changed = out.optionSource != c || out.media != n.media || out.optionGen != n.dirtyGen;
                let ancestor = c;
                while ancestor >= 0 {
                    if d.nodes.items[ancestor].styleDirty { changed = true; }
                    ancestor = d.nodes.items[ancestor].parent;
                }
                out.optionSource = c;
                out.optionGen = n.dirtyGen;
                out.media = n.media;
                // Match the logical tree (including scoped option selectors), without copying events,
                // focus flags, ids or overlay state into the visual tree.
                d.mnodes.items[id] = d.mnodes.items[c];
                if changed || out.born == d.frame {
                    if n.dyn >= 0 {
                        let a = &d.dyns.items[n.dyn];
                        let b = dynOf(d, id);
                        for k in 0..dynattr.SLOTS {
                            b.sk[k] = a.sk[k];
                            b.sn[k] = a.sn[k];
                        }
                        for k in 0..a.sp.len {
                            b.sp[k] = a.sp[k];
                            b.sv[k] = a.sv[k];
                        }
                        b.dirty = true;
                    } else if out.dyn >= 0 {
                        dynattr.reset(&d.dyns.items[out.dyn]);
                        d.dyns.items[out.dyn].dirty = true;
                    }
                    markStyle(d, id);
                    markDirty(d, id);
                }
                optionVisuals(d, c);
                d.close();
                d.leave(tok);
                slot += 1;
            }
        }
        c = n.next;
    }
}

/// Depth-first next descendant, bounded by the source option (never its runtime popup sibling).
fn optionNext(d: &Dom, opt: int, id: int): int {
    if d.nodes.items[id].first >= 0 && !d.nodes.items[id].rt && !d.nodes.items[id].ghost {
        return d.nodes.items[id].first;
    }
    let c = id;
    while c != opt {
        if d.nodes.items[c].next >= 0 { return d.nodes.items[c].next; }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Full scalar label: concatenate descendant text in document order. An option owns a reusable byte
/// buffer; unchanged labels allocate nothing, including type-ahead and closed-select paint frames.
pub fn optLabel(d: &Dom, opt: int): string {
    if d.nodes.items[opt].optionGen == d.nodes.items[opt].dirtyGen { return d.textOf(opt); }
    let len = 0;
    let c = d.nodes.items[opt].first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_TEXT && !d.nodes.items[c].ghost { len += d.nodes.items[c].tlen; }
        c = optionNext(d, opt, c);
    }
    let n = &d.nodes.items[opt];
    if len > n.buf.len { n.buf = d.mem.alloc::<u8>(max4(len, n.buf.len * 2)); }
    let at = 0;
    c = n.first;
    while c >= 0 {
        if d.nodes.items[c].kind == K_TEXT && !d.nodes.items[c].ghost {
            let t = d.textOf(c);
            for j in 0..t.len { n.buf[at + j] = t[j]; }
            at += t.len;
        }
        c = optionNext(d, opt, c);
    }
    n.tlen = len;
    n.optionGen = n.dirtyGen;
    return d.textOf(opt);
}

/// What an option is worth: its `value`, else its text.
pub fn optValue(d: &Dom, opt: int): string {
    if d.nodes.items[opt].sval.len > 0 {
        return d.nodes.items[opt].sval;
    }
    return optLabel(d, opt);
}

/// Whether option `opt` of `sel` is selected (`multiple`: its value is in the comma list).
pub fn optSelected(d: &Dom, sel: int, opt: int): bool {
    let v = d.nodes.items[sel].sval;
    if d.nodes.items[sel].multi {
        return csv.has(v, optValue(d, opt));
    }
    return same(v, optValue(d, opt));
}
