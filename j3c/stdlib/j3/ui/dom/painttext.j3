// Part of j3.ui.dom (Text runs, fills, selection and fragment painting.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Text color of text node `tn`; an animating `color` on the element `oe` carries over when the
/// text inherits it.
fn textColor(d: &Dom, tn: int, oe: int): int {
    let c = colorOf(d, d.nodes.items[tn].style, P_COLOR);
    if oe >= 0 {
        let o = &d.nodes.items[oe];
        if o.style != o.tstyle && colorOf(d, o.tstyle, P_COLOR) == c {
            return colorOf(d, o.style, P_COLOR);
        }
    }
    return c;
}

/// How the text of one block is filled: a plain color, or (`background-clip: text`) the block's
/// linear gradient measured over its border box.
struct TextFill {
    grad: bool;
    row: int;
    a: Vec2;
    b: Vec2;
    /// Replaces the text color when `background-clip: text` has a plain background color (alpha 0: none).
    flat: int;
}

fn textFillOf(d: &Dom, owner: int): TextFill {
    let none = TextFill { grad: false, row: 0, a: Vec2 { x: 0.0, y: 0.0 }, b: Vec2 { x: 0.0, y: 0.0 }, flat: 0 };
    let n = &d.nodes.items[owner];
    if n.kind != K_ELEM || kwOf(d, n.style, P_BG_CLIP) != CLIP_TEXT {
        return none;
    }
    none.flat = colorOf(d, n.style, P_BACKGROUND);
    let img = d.css.get(n.style, P_BG_IMAGE);
    if img.kind == V_GRAD {
        let o = img.i + 1;
        let a = d.css.paints.items;
        if int(a[o]) == 0 {
            let ln = textfx.gradientLine(rnd(n.w), rnd(n.h), a[o + 1]);
            return TextFill { grad: true, row: layerRow(d, o), a: ln.a, b: ln.b, flat: 0 };
        }
    }
    return none;
}

/// One string of text at `pos` with the effects of `st`: shadows, outline, then the fill. With
/// `text-wave` each code point is its own run, lifted by `textwave.lift` (effects follow the glyph).
fn paintRun(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    // `font-style: italic | oblique`: the face has no slanted twin, so the run is sheared about its baseline
    // ponytail: faux italic; a real italic face via `@font-face` would be crisper
    let slant = kwOf(d, st, P_FONT_STYLE) != 0;
    if slant {
        paint.pushSkew(Vec2 { x: pos.x, y: pos.y + f32(fontAscent(font)) }, 0.2);
    }
    paintRunFx(d, st, font, bold, pos, seg, col, fill);
    if slant {
        paint.popTransform();
    }
}

fn paintRunFx(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    let amp = vf(d, st, P_WAVE_AMP);
    let len = vf(d, st, P_WAVE_LEN);
    let period = vf(d, st, P_WAVE_PERIOD);
    if !textwave.on(amp, len, period) {
        paintPlain(d, st, font, bold, pos, seg, col, fill);
        return;
    }
    let bytes = []u8 { ptr: seg.ptr, len: seg.len };
    let x = pos.x;
    let i = 0;
    while i < seg.len {
        let e = i + cpLen(bytes, i);
        let at = Vec2 { x: x, y: pos.y + rnd(textwave.lift(amp, len, period, d.now, x)) };
        if int(seg[i]) != 32 {
            paintPlain(d, st, font, bold, at, seg[i..e], col, fill);
        }
        x += textWidth(font, bytes[i..e], bold);
        i = e;
    }
}

fn paintPlain(d: &Dom, st: int, font: Font, bold: bool, pos: Vec2, seg: string, col: int, fill: &TextFill) {
    let sh = d.css.get(st, P_TEXT_SHADOW);
    if sh.kind == V_SHADOW {
        textfx.shadowList(font, pos, seg, bold, d.css.paints.items, sh.i);
    }
    let sw = vf(d, st, P_STROKE_WIDTH);
    if sw > 0.0 {
        textfx.outline(font, pos, seg, sw, toColor(colorOf(d, st, P_STROKE_COLOR)), bold);
    }
    if fill.grad {
        paint.textGradient(font, pos, seg, fill.row, fill.a, fill.b, 1.0, bold);
    } else if bold {
        paint.textBold(font, pos, seg, toColor(col));
    } else {
        paint.text(font, pos, seg, toColor(col));
    }
    let line = kwOf(d, st, P_TEXT_DECORATION);
    if line != 0 {
        // `text-decoration-line`: a bar as wide as the run, as thick as the font is tall / 14
        let thick = max(1.0, rnd(f32(fontLine(font)) / 14.0));
        let asc = f32(fontAscent(font));
        let y = pos.y;
        if line == 1 {
            y = pos.y + asc + thick;
        } else if line == 2 {
            y = pos.y + rnd(asc * 0.65);
        }
        paint.rect(Vec2 { x: pos.x, y: y }, Vec2 { x: textWidth(font, bytesOf(seg), bold), y: thick }, toColor(col));
    }
}

/// The highlight behind the selected part of fragment `fr` (`Node.sa..sb`, see `j3.ui.textsel`).
fn paintSel(d: &Dom, tn: &Node, fr: Frag, font: Font, bold: bool, pos: Vec2, whole: []u8) {
    let lo = maxi(tn.sa, fr.start);
    let hi = mini(mini(tn.sb, fr.end), tn.tlen);
    if lo >= hi {
        return;
    }
    let acc = toColor(accentOf(d, tn.style));
    let seg = whole[fr.start..fr.end];
    if seg.len == 1 && (seg[0] == 9 || seg[0] == 10 || seg[0] == 13 || seg[0] == 32) {
        paint.rect(pos, Vec2 { x: fr.w, y: f32(fontLine(font)) }, alpha(acc, 100));
        return;
    }
    let count = game.textSelRects(font, seg, bold, lo - fr.start, hi - fr.start);
    for r in 0..count {
        paint.rect(Vec2 { x: pos.x + game.selRectX(r), y: pos.y }, Vec2 { x: game.selRectW(r), y: f32(fontLine(font)) }, alpha(acc, 100));
    }
}

/// Paint the text fragments owned by `owner` (positions are relative to its border box). `oe` is
/// the element whose transitions apply.
fn paintFrags(d: &Dom, owner: int, oe: int) {
    let shift: f32 = 0.0;
    let shiftX: f32 = 0.0;
    if d.nodes.items[owner].kind == K_ELEM && isScroll(d, d.nodes.items[owner].style) {
        shift = d.nodes.items[owner].scrollY;
        shiftX = d.nodes.items[owner].scrollX;
    }
    let fill = textFillOf(d, owner);
    let bx = d.nodes.items[owner].box0;
    while bx >= 0 {
        let b = d.boxes.items[bx];
        if paintVisible(d, b.node) {
            let x0 = rnd(b.x - shiftX);
            let w = rnd(b.x + b.w - shiftX) - x0;
            paint.pushTranslate(Vec2 { x: x0, y: rnd(b.y - shift) });
            // `box-decoration-break: slice`: an end that is not the element's own is the box continuing, so the box is
            // drawn whole, taller-than-radius wider on that side, and clipped to the piece.
            let extL = if b.start == 0 { b.ap } else { 0.0 };
            let extR = if b.end == 0 { b.ap } else { 0.0 };
            let cut = extL > 0.0 || extR > 0.0;
            if cut {
                paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: b.ap });
                paint.pushTranslate(Vec2 { x: 0.0 - extL, y: 0.0 });
            }
            paintBackground(d, b.node, d.nodes.items[b.node].style, w + extL + extR, b.ap);
            if cut {
                paint.popTransform();
                paint.popClip();
            }
            paint.popTransform();
        }
        bx = b.next;
    }
    let f = d.nodes.items[owner].frag0;
    // runs of fragments share a text node: walk to the root once per node
    let lastN = -1;
    let lastVis = false;
    while f >= 0 {
        let fr = d.frags.items[f];
        if fr.kind == 0 && fr.node != lastN {
            lastN = fr.node;
            lastVis = paintVisible(d, fr.node);
        }
        if fr.kind == 0 && lastVis {
            let tn = &d.nodes.items[fr.node];
            let whole = shownText(d, fr.node);
            let seg = (whole[fr.start..fr.end]) as string;
            let font = fontOf(d, tn.style);
            if font.raw != 0 {
                let pos = Vec2 { x: rnd(fr.x - shiftX), y: rnd(fr.y - shift) };
                let col = textColor(d, fr.node, oe);
                if ca(fill.flat) > 0 {
                    col = fill.flat;
                }
                let bold = isBold(d, tn.style);
                let tm = enterTextNode(d, fr.node);
                if tn.sa >= 0 {
                    paintSel(d, tn, fr, font, bold, pos, whole);
                }
                if !(seg.len == 1 && (seg[0] == 9 || seg[0] == 10 || seg[0] == 13)) { paintRun(d, tn.style, font, bold, pos, seg, col, &fill); }
                if fr.ell >= 0.0 {
                    paintRun(d, tn.style, font, bold, Vec2 { x: rnd(fr.x - shiftX + fr.ell), y: pos.y }, ELLIPSIS, col, &fill);
                }
                leaveText(tm);
            }
        }
        f = fr.next;
    }
}

/// A text node that is a flex or grid item owns its fragments.
fn paintTextNode(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    if n.frag0 < 0 || d.hidden > 0 || d.pz[d.psp] != 1 {
        return;
    }
    let ps: f32 = 0.0;
    let psx: f32 = 0.0;
    if n.parent >= 0 {
        ps = d.nodes.items[n.parent].scrollY;
        psx = d.nodes.items[n.parent].scrollX;
    }
    paint.pushTranslate(Vec2 { x: rnd(n.x - psx), y: rnd(n.y - ps) });
    paintFrags(d, id, n.parent);
    paint.popTransform();
}

/// Draw the click ripples of `id` over its box, clipped to it.
fn paintRipples(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let w = rnd(n.w);
    let h = rnd(n.h);
    paint.pushClip(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h });
    for i in 0..d.rip.n {
        if d.rip.id[i] == id {
            let u = ripple.progress(&d.rip, i, d.now);
            let x = d.rip.x[i];
            let y = d.rip.y[i];
            let dx = max(x, w - x);
            let dy = max(y, h - y);
            let reach = sqrt(dx * dx + dy * dy);
            let col = d.rip.col[i];
            let a = f32(ca(col)) * (1.0 - u);
            paint.circle(Vec2 { x: x, y: y }, ripple.radius(reach, u), Color { r: u8(cr(col)), g: u8(cg(col)), b: u8(cb(col)), a: u8(a) });
        }
    }
    paint.popClip();
}

/// Draw the scrollbars of box `id` (inside its clip, over its content).
fn paintBars(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let b = barsOf(d, id);
    if !b.showX && !b.showY {
        return;
    }
    let st = n.style;
    let tv = d.css.get(st, P_SB_THUMB);
    let kv = d.css.get(st, P_SB_TRACK);
    let thumbCol = if tv.kind == V_COLOR { toColor(tv.c) } else { Color { r: 255, g: 255, b: 255, a: 70 } };
    let trackCol = if kv.kind == V_COLOR { toColor(kv.c) } else { Color { r: 255, g: 255, b: 255, a: 14 } };
    let hot = scrollbar.NONE;
    if d.barNode == id {
        hot = d.barPart;
    } else if d.barOf == id {
        hot = d.barHover;
    }
    scrollbar.draw(&b, thumbCol, trackCol, hot);
}

fn paintClose(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    // trailing text and ghosts
    let c = d.pcu[d.psp];
    let nx = if c < 0 { n.first } else { d.nodes.items[c].next };
    while nx >= 0 {
        if d.nodes.items[nx].kind == K_TEXT {
            paintTextNode(d, nx);
        } else if d.nodes.items[nx].ghost {
            paintNode(d, nx);
        }
        nx = d.nodes.items[nx].next;
    }
    let f = n.pflags;
    if d.rip.n > 0 && d.pz[d.psp] == 1 && !hasBit(f, PB_SKIP) && !hasBit(f, PB_HIDDEN) && paintVisible(d, id) {
        paintRipples(d, id);
    }
    if hasBit(f, PB_CLIP) {
        // a scroller with a lifted box inside has its bars painted last in its context (`paintBarEntry`)
        if d.pz[d.psp] == 1 && (!n.bdef || d.pflat) && paintVisible(d, id) {
            paintBars(d, id);
        }
        paint.popClip();
    }
    if hasBit(f, PB_POST) {
        let fx = effectsOf(d, n.style);
        if hasBit(f, PB_PROJECT) {
            fx.perspective = 0.0;
            fx.rotateX = 0.0;
            fx.rotateY = 0.0;
            fx.blend = 0;
        }
        paint.endLayer(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: rnd(n.w), y: rnd(n.h) }, fx);
    }
    if hasBit(f, PB_MASK) {
        paint.popMask();
    }
    if hasBit(f, PB_SHAPE) {
        paint.popShape(0);
    }
    if hasBit(f, PB_PROJECT) {
        let source = effectsOf(d, n.style);
        let projection = Effects { perspective: source.perspective, rotateX: source.rotateX, rotateY: source.rotateY, blend: source.blend };
        paint.endLayer(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: rnd(n.w), y: rnd(n.h) }, projection);
    }
    if hasBit(f, PB_SCALE) {
        paint.popTransform();
    }
    if hasBit(f, PB_TSCALE) {
        paint.popTransform();
    }
    if hasBit(f, PB_TCLIP) {
        paint.popClip();
    }
    if hasBit(f, PB_ALPHA) {
        paint.popAlpha();
    }
    if hasBit(f, PB_MOVE) {
        paint.popTransform();
    }
    if hasBit(f, PB_FIXED) {
        paint.popTransform();
        paint.popClip();
    }
    if hasBit(f, PB_HIDDEN) {
        d.hidden -= 1;
    }
    d.base = d.pv[2 * d.psp];
    d.scale = d.pv[2 * d.psp + 1];
    d.psp -= 1;
    d.pcu[d.psp] = id;
}
