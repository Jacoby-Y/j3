// Part of j3.ui.dom (Stacking contexts: paint order of z-index, positioned and effect boxes, and the paint walk over it.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn noHook(p: ptr) {
}

/// Key of top-layer entries: above any `z-index` of the page.
const Z_TOP: int = 1073741824;

/// CSS 2.1 Appendix E, as far as this renderer goes. A box is a stacking context (`Node.ctx`) when it is the root, `position: fixed`
/// or `sticky`, an overlay, positioned with a `z-index` other than `auto`, or has `opacity` below 1, a transform, `filter`,
/// `backdrop-filter`, `mix-blend-mode`, `perspective` / `rotate-x` / `rotate-y`, `clip-path`, `mask-image` or `isolation: isolate`;
/// also a flex or grid item with a `z-index` (positioned or not), and while a transition or animation of one of the
/// properties above runs on it (its overlay style may start or stop one on any frame).
/// Inside a context the paint order is: the context's own box, entries with a negative key, the in-flow (not positioned) content in
/// tree order, then the entries with key 0 in tree order, then the rest by ascending key. An entry is a descendant that is a context
/// or positioned (`Node.lift`) and has no context between it and the owner; a `z-index` is only compared with the entries of its own
/// context. Positioned boxes without a context keep their descendants' entries in the owner's list. Overlays (`ovZ`) and popups are
/// entries of the root, after every page key. A scroller (`overflow: auto | scroll`) is no context: what is lifted inside it is an entry of the owner, reopened through it
/// (clip and scroll), and its scrollbars are an entry of their own just after the highest of those (`barAdd`). When every entry of a context is a
/// plain positioned box inside a scroller the scrollers are contexts instead (`onlyInScrollers`): the same picture for one walk. The lists are built by `buildStack` when the tree's fingerprint changes and painted
/// (`paintEntry`) or hit (`hitEntry`) by walking from the owner down to the entry through the boxes in between.
fn stackSig(d: &Dom): int {
    let h = d.nodes.len + d.css.epoch * 7919;
    for i in 0..d.nodes.len {
        let n = &d.nodes.items[i];
        h = h * 1000003 + n.style * 31 + n.tstyle * 11 + n.tr * 3 + n.vnext * 5 + n.parent * 17 + n.next * 13 + n.first * 7 + n.ovZ;
        if n.isFixed { h += 1; }
        if n.rt { h += 2; }
        if n.ghost { h += 4; }
        if n.ordered { h += 8; }
    }
    return h;
}

/// A property whose value can make a box a stacking context (`ctxOf`).
fn ctxProp(p: int): bool {
    return p == P_OPACITY || p == P_Z_INDEX || p == P_FILTER || p == P_BACKDROP_FILTER || p == P_MIX_BLEND_MODE || p == P_PERSPECTIVE
        || p == P_ROTATE_X || p == P_ROTATE_Y || p == P_CLIP_PATH || p == P_MASK_IMAGE || p == P_ISOLATION || motionbase.isXProp(p);
}

/// The box has a transition track or a `@keyframes` animation running on a property that can make it a context.
fn animCtx(d: &Dom, n: &Node): bool {
    if n.tr < 0 {
        return false;
    }
    let m = &d.trs.items[n.tr];
    for i in 0..m.n {
        if ctxProp(motionbase.realProp(m.p[i])) {
            return true;
        }
    }
    for k in 0..4 {
        if m.kf[k] >= 0 {
            let kf = &d.css.kfs.items[m.kf[k]];
            for q in 0..kf.nprop {
                if ctxProp(kf.props[q]) {
                    return true;
                }
            }
        }
    }
    return false;
}

/// `z-index` counts on a positioned box, and on a flex or grid item whatever its `position`.
fn zActive(d: &Dom, id: int, st: int): bool {
    if vkind(d, st, P_Z_INDEX) != V_NUM {
        return false;
    }
    if kwOf(d, st, P_POSITION) != POS_STATIC {
        return true;
    }
    let p = d.nodes.items[id].parent;
    return p >= 0 && (d.nodes.items[p].disp == DP_FLEX || d.nodes.items[p].disp == DP_GRID);
}

/// A box with scrollbars (`overflow: auto | scroll`).
fn scrollers(d: &Dom, st: int): bool {
    return scrollsOn(d, st, P_OVERFLOW_Y) || scrollsOn(d, st, P_OVERFLOW_X);
}

/// Whether the box paints as one unit with its own `z-index` space (see the top of this file).
fn ctxOf(d: &Dom, id: int): bool {
    let n = &d.nodes.items[id];
    let st = n.style;
    if id == 0 || n.isFixed || n.ovZ > 0 || n.rt {
        return true;
    }
    if st < 0 {
        return false;
    }
    if animCtx(d, n) || kwOf(d, st, P_POSITION) == POS_STICKY || zActive(d, id, st) {
        return true;
    }
    if d.zscr && scrollers(d, st) {
        return true;
    }
    if opacityOf(d, st) < 1.0 || kwOf(d, st, P_ISOLATION) == 1 || needsPost(d, st) || xform.of(d.css, st, 1.0, 1.0).on {
        return true;
    }
    if vkind(d, st, P_CLIP_PATH) == V_LIST || vkind(d, st, P_MASK_IMAGE) == V_GRAD {
        return true;
    }
    let bf = d.css.get(st, P_BACKDROP_FILTER);
    return bf.kind == V_PX && bf.f > 0.0;
}

/// Paint-order key of a lifted box inside its context.
fn keyOf(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    let k = 0;
    let z = d.css.get(n.style, P_Z_INDEX);
    let zset = zActive(d, id, n.style);
    if zset {
        k = int(z.f);
    }
    if n.ovZ > 0 {
        if !zset {
            k = n.ovZ;
        }
        return Z_TOP + k;
    }
    return k;
}

/// The scrollbar entry of scroller `id` (no context): `zl` holds `-2 - id`, so it is told from a box entry (`barOf`). Its key is the
/// highest of the lifted boxes inside the scroller (not below 0), and it sorts after them: what covers those covers the bars.
fn barAdd(d: &Dom, id: int, key: int) {
    d.zl.push(Idx { v: -2 - id });
    d.zk.push(Idx { v: key });
}

/// The scroller of the bar entry `v` of `zl`, -1 for a box entry.
fn barOf(v: int): int {
    return if v < -1 { -2 - v } else { -1 };
}

fn entryAdd(d: &Dom, id: int) {
    d.zl.push(Idx { v: id });
    d.zk.push(Idx { v: keyOf(d, id) });
}

/// Collect the entries of context `s` below `p`: the lifted boxes (not inside another context, whose own pass finds theirs).
fn collectIn(d: &Dom, s: int, p: int) {
    let pn = &d.nodes.items[p];
    let c = if pn.ordered { pn.vfirst } else { pn.first };
    while c >= 0 {
        let cn = &d.nodes.items[c];
        if cn.kind == K_ELEM {
            cn.ctx = ctxOf(d, c);
            cn.lift = cn.ctx || (cn.style >= 0 && kwOf(d, cn.style, P_POSITION) != POS_STATIC);
            cn.zc = 0;
            cn.zneg = 0;
            cn.bdef = false;
            if cn.ovZ > 0 || cn.rt {
                d.zt.push(Idx { v: c });
                d.zw.push(Idx { v: c });
            } else if cn.ctx {
                entryAdd(d, c);
                d.zw.push(Idx { v: c });
            } else {
                if cn.lift {
                    entryAdd(d, c);
                }
                let mark = d.zl.len;
                collectIn(d, s, c);
                // only what a lifted box inside could cover waits for its place in the order: else the bars paint with the scroller
                if d.zl.len > mark && cn.style >= 0 && !cn.ghost && scrollers(d, cn.style) {
                    let key = 0;
                    for q in mark..d.zl.len {
                        key = maxi(key, d.zk.items[q].v);
                    }
                    cn.bdef = true;
                    barAdd(d, c, key);
                }
            }
        }
        c = if pn.ordered { cn.vnext } else { cn.next };
    }
}

/// Stable insertion sort of the entries `a..b` by key; sets the context's list.
fn sortEntries(d: &Dom, s: int, a: int, b: int) {
    let neg = 0;
    for i in a..b {
        let kk = d.zk.items[i].v;
        let vv = d.zl.items[i].v;
        let j = i - 1;
        while j >= a && d.zk.items[j].v > kk {
            d.zk.items[j + 1].v = d.zk.items[j].v;
            d.zl.items[j + 1].v = d.zl.items[j].v;
            j -= 1;
        }
        d.zk.items[j + 1].v = kk;
        d.zl.items[j + 1].v = vv;
    }
    for i in a..b {
        if d.zk.items[i].v < 0 {
            neg += 1;
        }
    }
    let sn = &d.nodes.items[s];
    sn.zs = a;
    sn.zc = b - a;
    sn.zneg = neg;
}

/// Whether every entry of context `s` found since `from` is a plain positioned box (key 0, no context) inside a scroller (or the
/// scroller itself): nothing else in the context could interleave with it, so the scrollers may stay contexts, as one paint walk
/// and no chain per entry. (A static scroller then paints in tree order among the in-flow boxes: only overlap with those shows.)
fn onlyInScrollers(d: &Dom, s: int, from: int): bool {
    if d.zl.len == from {
        return false;
    }
    for i in from..d.zl.len {
        let v = d.zl.items[i].v;
        if barOf(v) >= 0 {
            continue;
        }
        if d.zk.items[i].v != 0 || d.nodes.items[v].ctx {
            return false;
        }
        let c = v;
        let found = false;
        while c >= 0 && c != s && !found {
            let cs = d.nodes.items[c].style;
            found = cs >= 0 && scrollers(d, cs);
            c = d.nodes.items[c].parent;
        }
        if !found {
            return false;
        }
    }
    return true;
}

/// `collectIn` for context `s`, and again with its scrollers as contexts when that leaves no entry that could interleave.
fn collectCtx(d: &Dom, s: int) {
    let e0 = d.zl.len;
    let w0 = d.zw.len;
    let t0 = d.zt.len;
    collectIn(d, s, s);
    if onlyInScrollers(d, s, e0) {
        d.zl.len = e0;
        d.zk.len = e0;
        d.zw.len = w0;
        d.zt.len = t0;
        d.zscr = true;
        collectIn(d, s, s);
        d.zscr = false;
    }
}

/// Rebuild every context's entry list.
fn buildStack(d: &Dom) {
    d.stackBuilds += 1;
    d.zl.len = 0;
    d.zk.len = 0;
    d.zw.len = 0;
    d.zt.len = 0;
    let root = &d.nodes.items[0];
    root.ctx = true;
    root.lift = true;
    root.zc = 0;
    root.zneg = 0;
    d.zw.push(Idx { v: 0 });
    collectCtx(d, 0);
    let rootEnd = d.zl.len;
    let i = 1;
    while i < d.zw.len {
        let s = d.zw.items[i].v;
        let from = d.zl.len;
        collectCtx(d, s);
        sortEntries(d, s, from, d.zl.len);
        i += 1;
    }
    // the root's list: its own entries, then the top-layer boxes found anywhere
    let a = d.zl.len;
    for k in 0..rootEnd {
        let id = d.zl.items[k].v;
        let key = d.zk.items[k].v;
        d.zl.push(Idx { v: id });
        d.zk.push(Idx { v: key });
    }
    for k in 0..d.zt.len {
        entryAdd(d, d.zt.items[k].v);
    }
    sortEntries(d, 0, a, d.zl.len);
}

/// Bring the entry lists up to date with the tree: nothing when its fingerprint is unchanged.
fn ensureStack(d: &Dom) {
    if d.nodes.len == 0 {
        return;
    }
    let sig = stackSig(d);
    if d.zbuilt && sig == d.zsig {
        return;
    }
    buildStack(d);
    d.zsig = sig;
    d.zbuilt = true;
}

/// Paint `id`: its box, the entries below it, its in-flow content, the entries above that, and close it. Opened `mine`, so a context
/// group (`filter`, blend, projection) holds all of it.
fn paintNode(d: &Dom, id: int) {
    paintOpen(d, id, true);
    let n = &d.nodes.items[id];
    if !hasBit(n.pflags, PB_SKIP) && !hasBit(n.pflags, PB_HIDDEN) {
        if n.tag == d.tCanvas && d.hookOn && d.pz[d.psp] == 1 && paintVisible(d, id) && n.w >= 1.0 && n.h >= 1.0 {
            runCanvas(d, id);
        }
        if n.ctx {
            for k in 0..n.zneg {
                paintSlot(d, id, n.zs + k);
            }
        }
        paintInflow(d, id);
        if n.ctx {
            for k in n.zneg..n.zc {
                paintSlot(d, id, n.zs + k);
            }
        }
    }
    d.pcu[d.psp] = n.last;
    paintClose(d, id);
}

/// The children of `id` that paint with it: text, and boxes that are not lifted (those are entries of a context).
fn paintInflow(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    let c = if n.ordered { n.vfirst } else { n.first };
    while c >= 0 {
        let cn = &d.nodes.items[c];
        if !cn.rt {
            if cn.kind == K_TEXT {
                paintTextNode(d, c);
            } else if cn.kind == K_ELEM && (d.pflat || !cn.lift) {
                paintNode(d, c);
            }
        }
        c = if n.ordered { cn.vnext } else { cn.next };
    }
}

fn paintSlot(d: &Dom, s: int, i: int) {
    let b = barOf(d.zl.items[i].v);
    if b >= 0 {
        paintBarEntry(d, s, b);
    } else {
        paintEntry(d, s, d.zl.items[i].v);
    }
}

/// Paint the scrollbars of scroller `e`, which is no context, above everything of context `s`: reopen `e` and the boxes between.
fn paintBarEntry(d: &Dom, s: int, e: int) {
    if e < 0 || e >= d.nodes.len || d.nodes.items[e].kind != K_ELEM || d.nodes.items[e].rt {
        return;
    }
    let b = barsOf(d, e);
    if !b.showX && !b.showY {
        return;
    }
    let base = d.pchn;
    let k = 0;
    let c = e;
    while c >= 0 && c != s {
        if base + k >= PAINT_DEPTH {
            panic("dom: paint nesting too deep");
        }
        d.pch[base + k] = c;
        k += 1;
        c = d.nodes.items[c].parent;
    }
    let i = k - 1;
    while i >= 0 {
        paintOpen(d, d.pch[base + i], false);
        i -= 1;
    }
    d.pchn = base + k;
    if hasBit(d.nodes.items[e].pflags, PB_CLIP) && paintVisible(d, e) {
        paintBars(d, e);
    }
    d.pchn = base;
    for j in 0..k {
        let a = d.pch[base + j];
        d.pcu[d.psp] = d.nodes.items[a].last;
        paintClose(d, a);
    }
}

/// Paint entry `e` of context `s`: reopen the boxes between them (their place, clips and transforms, nothing drawn), paint `e`, close.
/// Top-layer boxes are fixed and paint on their own.
fn paintEntry(d: &Dom, s: int, e: int) {
    if e < 0 || e >= d.nodes.len {
        return;
    }
    let en = &d.nodes.items[e];
    if en.kind != K_ELEM || en.rt {
        return;
    }
    let base = d.pchn;
    let k = 0;
    if en.ovZ > 0 {
        if isHidden(d, e) {
            return;
        }
    } else {
        let c = en.parent;
        while c >= 0 && c != s {
            if base + k >= PAINT_DEPTH {
                panic("dom: paint nesting too deep");
            }
            d.pch[base + k] = c;
            k += 1;
            c = d.nodes.items[c].parent;
        }
    }
    let i = k - 1;
    while i >= 0 {
        paintOpen(d, d.pch[base + i], false);
        i -= 1;
    }
    d.pchn = base + k;
    paintNode(d, e);
    d.pchn = base;
    for j in 0..k {
        let a = d.pch[base + j];
        d.pcu[d.psp] = d.nodes.items[a].last;
        paintClose(d, a);
    }
}

/// Draw the body of `<canvas>` `t`, which lives in the generated component: run its paint walk (the hook) with `rpOn`, so it only
/// follows the path from the root to `t` and runs the body there. The frames it pushes sit above the ones in use.
fn runCanvas(d: &Dom, t: int) {
    let k = 0;
    let c = t;
    while c > 0 && k < MAX_DEPTH {
        if d.nodes.items[c].ghost {
            return; // a box fading out is no longer in the generated walk
        }
        d.rpc[k] = c;
        k += 1;
        c = d.nodes.items[c].parent;
    }
    if k == 0 {
        return;
    }
    for i in 0..k / 2 {
        let q = d.rpc[i];
        d.rpc[i] = d.rpc[k - 1 - i];
        d.rpc[k - 1 - i] = q;
    }
    let sp = d.psp;
    let b = d.base;
    let sc = d.scale;
    let pg = d.pgsp;
    d.rpOn = true;
    d.rpT = t;
    d.rpLen = k;
    d.rpI = 0;
    d.psp = sp + 1;
    d.pst[d.psp] = 0;
    d.ptarget[d.psp] = d.rpc[0];
    d.pcu[d.psp] = d.nodes.items[d.rpc[0]].prev;
    d.base = 0;
    d.scale = SLOT_UNIT;
    d.pgsp = 0;
    let f = d.hook;
    f(d.hookSelf);
    d.rpOn = false;
    d.psp = sp;
    d.base = b;
    d.scale = sc;
    d.pgsp = pg;
}
