// Part of j3.ui.dom (tree constructor); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Empty tree with a root node (id 0, tag `root`, a block).
    fn new(mem: &Arena, css: &Css): Dom {
        let d = Dom {
            mem: mem,
            css: css,
            nodes: List<Node>.new(mem),
            mnodes: List<MatchNode>.new(mem),
            frags: List<Frag>.new(mem),
            fragFree: List<Idx>.new(mem),
            boxes: List<Frag>.new(mem),
            boxFree: List<Idx>.new(mem),
            ob: List<OBox>.new(mem),
            pseg: List<BSeg>.new(mem),
            free: List<Idx>.new(mem),
            abs: List<Idx>.new(mem),
            relayout: List<Idx>.new(mem),
            fonts: List<FontEnt>.new(mem),
            fi: mem.alloc::<FItem>(FI_CAP),
            fiTop: 0,
            gs: mem.alloc::<f32>(GS_START),
            gTop: 0,
            occ: mem.alloc::<u8>(OCC_START),
            stack: mem.alloc::<int>(MAX_DEPTH),
            cursor: mem.alloc::<int>(MAX_DEPTH),
            sp: 0,
            gen: 1,
            serial: 0,
            tText: css.intern("#text"),
            tRoot: css.intern("root"),
            tButton: css.intern("button"),
            vCheckbox: css.intern("checkbox"),
            vRadio: css.intern("radio"),
            tBefore: css.intern("::before"),
            tAfter: css.intern("::after"),
            vRange: css.intern("range"),
            vColor: css.intern("color"),
            vSearch: css.intern("search"),
            vTextarea: css.intern("textarea"),
            vPassword: css.intern("password"),
            tSelect: css.intern("select"),
            tGlyph: css.intern("glyph"),
            glyphStyle: 0,
            gbinds: List<GlyphBind>.new(mem),
            gtmp: Text.new(mem),
            tOption: css.intern("option"),
            fallback: "",
            fontMissing: 0,
            laid: 0,
            restyled: 0,
            cascaded: 0,
            kidMarks: 0,
            base: 0,
            scale: SLOT_UNIT,
            frame: 0,
            now: 0.0,
            fixedMs: 0.0,
            vw: 0.0,
            vh: 0.0,
            simOn: false,
            simX: 0.0,
            simY: 0.0,
            simDown: false,
            simWheel: 0.0,
            mx: -1.0,
            my: -1.0,
            pmx: -1.0,
            pmy: -1.0,
            down: false,
            prevDown: false,
            wheelV: 0.0,
            moved: false,
            hover: -1,
            pressNode: -1,
            clickNode: -1,
            clickTo: -1,
            forLabels: 0,
            a11yOn: false,
            aev: List<AEv>.new(mem),
            tabSer: 0,
            rtab: List<int>.new(mem),
            lq: List<Idx>.new(mem),
            liveCount: 0,
            aevTotal: 0,
            wake: 0,
            downHit: -1,
            downBtn: 0,
            upBtn: 0,
            focusWas: -1,
            selA: -1,
            selAo: 0,
            selF: -1,
            selFo: 0,
            selDrag: false,
            selMarked: false,
            selClicks: 0,
            selCt: -1000000.0,
            selCx: 0.0,
            selCy: 0.0,
            selBuf: Text.new(mem),
            primFake: false,
            primBuf: Text.new(mem),
            upHit: -1,
            dragNode: -1,
            ghosts: 0,
            npe: 0,
            animating: 0,
            canvasSum: 0,
            canvasAt: -1000000.0,
            canvasLive: false,
            spMo: 0,
            gaugeLive: 0,
            gaugeSeen: 0,
            followed: 0,
            flips: List<Flip>.new(mem),
            flipVw: 0.0,
            flipVh: 0.0,
            flipLive: 0,
            trns: List<Trans>.new(mem),
            trs: List<Motion>.new(mem),
            trFree: List<Idx>.new(mem),
            dyns: List<Dyn>.new(mem),
            dynFree: List<Idx>.new(mem),
            act: List<Idx>.new(mem),
            rip: ripple.none(),
            focus: -1,
            keyMode: false,
            pst: mem.alloc::<int>(PAINT_DEPTH),
            pcu: mem.alloc::<int>(PAINT_DEPTH),
            ptarget: mem.alloc::<int>(PAINT_DEPTH),
            psp: 0,
            pz: mem.alloc::<int>(PAINT_DEPTH),
            zl: List<Idx>.new(mem),
            zk: List<Idx>.new(mem),
            zw: List<Idx>.new(mem),
            zt: List<Idx>.new(mem),
            pch: mem.alloc::<int>(PAINT_DEPTH),
            pchn: 0,
            zsig: 0,
            zbuilt: false,
            zscr: false,
            zfe: 0,
            stackBuilds: 0,
            pmemo: List<PaintMemo>.new(mem),
            pmBuilt: 0,
            pmOn: true,
            pflat: false,
            rpOn: false,
            rpT: -1,
            rpLen: 0,
            rpI: 0,
            rpc: mem.alloc::<int>(MAX_DEPTH + 2),
            hookOn: false,
            hook: noHook,
            hookSelf: 0 as ptr,
            hidden: 0,
            tInput: css.intern("input"),
            tCanvas: css.intern("canvas"),
            tDialog: css.intern("dialog"),
            tBr: css.intern("br"),
            tProgress: css.intern("progress"),
            tMeter: css.intern("meter"),
            tDetails: css.intern("details"),
            tSummary: css.intern("summary"),
            tLabel: css.intern("label"),
            tImg: css.intern("img"),
            tSvg: css.intern("svg"),
            tIcon: css.intern("icon"),
            tPath: css.intern("path"),
            vSub: css.intern("sub"),
            tagDisp: List<int>.new(mem),
            chain: mem.alloc::<int>(MAX_DEPTH + 2),
            sv: mem.alloc::<int>(2 * MAX_DEPTH + 4),
            pv: mem.alloc::<int>(2 * PAINT_DEPTH),
            eds: List<Edit>.new(mem),
            pop: popup.closed(),
            kin: KeyIn {},
            takeKeys: true,
            kbd: keys.newRepeat(),
            simK: KeyIn {},
            padSt: PadState {},
            padRaw: PadRaw {},
            padOn: false,
            padText: -1,
            padShoulder: 0,
            padReads: 0,
            padVisits: 0,
            simKOn: false,
            seen: -1,
            thumb: 0,
            rdown: false,
            prevR: false,
            simR: false,
            mdown: false,
            prevM: false,
            simM: false,
            ctxNode: -1,
            ctxX: 0.0,
            ctxY: 0.0,
            ovs: List<Idx>.new(mem),
            ptRoot: -1,
            ptNat: 0.0,
            ttRoot: -1,
            rtSv: mem.alloc::<int>(8),
            rawHit: -1,
            insp: false,
            inspHot: game.env("J3_INSPECT").len > 0 && !same(game.env("J3_INSPECT"), "0"),
            inspPin: -1,
            inspIn: KeyIn {},
            inspWheel: 0.0,
            inspDown: false,
            inspMasked: false,
            inspPrev: false,
            inspScroll: 0.0,
            inspTxt: "",
            inspTxtPin: -1,
            inspTxtStyle: -1,
            inspBuilds: 0,
            inspLbl: "",
            inspLblKey: -1,
            inspAr: mem.alloc::<Arena>(2),
            inspInit: false,
            dumpSpec: game.env("J3_INSPECT_DUMP"),
            barHover: 0,
            barOf: -1,
            barNode: -1,
            barPart: 0,
            barGrab: 0.0,
            coasting: 0,
            snapPend: 0,
            snapWork: 0,
            snapDirty: false,
            snapPts: List<SnapPt>.new(mem),
            reveal: -1,
            vlists: List<VListRef>.new(mem),
            tipNode: -1,
            tipT0: 0.0,
            kbHover: -1,
            trigNode: -1,
            grids: List<GridRef>.new(mem),
            poolEd: -1,
            trigLo: -1,
            trigHi: -1,
            trigEv: -1,
            trigChg: -1,
            trigSup: -1,
            trigSupNode: -1,
            cpHot: -1,
            kbPend: -1,
            kbWait: 0,
            holdId: -1,
            holdT: 0.0,
            ta: mem.alloc::<u8>(32),
            taLen: 0,
            taAt: -100000.0,
            taOwner: -1,
            taCycle: false,
            dtMs: 0.0,
            prevNow: 0.0,
            pans: List<Panel>.new(mem),
            grab: panelmath.noGrab(),
            drag: dragstate.fresh(),
            stk: List<Idx>.new(mem),
            wdr: List<Idx>.new(mem),
            gstk: mem.alloc::<int>(GROUP_DEPTH),
            gsp: 0,
            pgs: mem.alloc::<int>(GROUP_DEPTH),
            pgsp: 0,
            gpar: List<Idx>.new(mem),
            gfirst: List<Idx>.new(mem),
            gfree: List<Idx>.new(mem),
            gdead: List<Idx>.new(mem),
            gseen: List<Idx>.new(mem),
            gstamp: 0,
            imgs: media.newImgs(mem),
            media: media.newMedia(mem),
        };
        // test / launch overrides for the program's answers (`setReducedMotion`, `setColorScheme`); the OS is never asked
        if !css.prefsSet {
            let rm = game.env("J3_REDUCED_MOTION");
            css.reduced = rm.len > 0 && !same(rm, "0");
            css.dark = same(game.env("J3_COLOR_SCHEME"), "dark");
        }
        // ponytail: platform decides, not the last input device; flip it with `setTouch` if a game needs that
        let ptr = game.env("J3_POINTER");
        css.setTouch(same(ptr, "coarse") || (ptr.len == 0 && sys.PLATFORM == sys.PLATFORM_ANDROID));
        return d;
    }

    /// Intern a tag name for `open`.
    fn tag(this: &Dom, name: string): int {
        return this.css.intern(name);
    }

    /// Font file used when no `@font-face` matches (or there is none).
    fn setFallbackFont(this: &Dom, path: string) {
        this.fallback = path;
    }
}

