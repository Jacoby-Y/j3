// Part of j3.ui.dom (Scroll snap, animated scrolls, scroll into view, id lookup.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// `block` / `inline` of `scrollIntoView`: which edge of the box the element goes to (`NEAREST`: the least movement, none when it shows).
pub const SC_START: int = 0;
pub const SC_CENTER: int = 1;
pub const SC_END: int = 2;
pub const SC_NEAREST: int = 3;

/// Ms a snap container must rest before it settles onto a snap point (a discrete wheel notch, a held scrollbar thumb).
const SNAP_IDLE: f32 = 90.0;
/// Time constant (ms) of the settle and of smooth `scrollTo`: the box closes `1 - e^(-dt / TAU)` of the gap each frame.
const ANIM_TAU: f32 = 60.0;

/// A snap position of one axis: the child it aligns, the scroll offset that does it, and `scroll-snap-stop: always`.
struct SnapPt {
    node: int;
    pos: f32;
    always: bool;
}

/// `scroll-snap-type` axes of box style `st`: 0 none, 1 x, 2 y, 3 both.
fn snapAxis(d: &Dom, st: int): int {
    if st < 0 { return 0; }
    return kwOf(d, st, P_SNAP_TYPE) % 4;
}

fn snapsOn(d: &Dom, id: int, vertical: bool): bool {
    let a = snapAxis(d, d.nodes.items[id].style);
    return a == 3 || a == (if vertical { 2 } else { 1 });
}

/// A scroll of box `id` by a gesture or by code is about to happen: it cancels a running animation, and a snap container starts waiting
/// to settle (remembering where the gesture began, for `scroll-snap-stop`).
fn scrollMark(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    n.anX = false;
    n.anY = false;
    if snapAxis(d, n.style) == 0 { return; }
    if n.snapAt < 0.0 {
        n.snapSx = n.scrollX;
        n.snapSy = n.scrollY;
    }
    n.snapAt = d.now;
    d.snapPend += 1;
}

/// Set both offsets (clamped to the range) without marking a gesture.
fn putScroll(d: &Dom, id: int, x: f32, y: f32) {
    let n = &d.nodes.items[id];
    let nx = max(0.0, min(n.scrollMaxX, x));
    let ny = max(0.0, min(n.scrollMax, y));
    if nx != n.scrollX || ny != n.scrollY {
        n.scrollX = nx;
        n.scrollY = ny;
        scrolled(d);
    }
}

/// The next node of a pre-order walk below `top` (-1 at the end); `descend` false skips the subtree of `k`.
fn walkNext(d: &Dom, k: int, top: int, descend: bool): int {
    if descend && d.nodes.items[k].first >= 0 {
        return d.nodes.items[k].first;
    }
    let c = k;
    while c >= 0 && c != top {
        if d.nodes.items[c].next >= 0 {
            return d.nodes.items[c].next;
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Fill `d.snapPts` with the snap positions of box `c` on one axis: every child (not inside a nested scroll box) with a
/// `scroll-snap-align` there, as the offset that puts its snap area (border box plus `scroll-margin`) at the edge or center of the snapport
/// (the box less its borders and `scroll-padding`), clamped to the range.
fn snapCollect(d: &Dom, c: int, vertical: bool) {
    d.snapPts.len = 0;
    d.snapWork += 1;
    let cn = &d.nodes.items[c];
    let e = edgesOf(d, cn.style, cn.basisW);
    let basis = if vertical { cn.h } else { cn.w };
    let side = if vertical { 0 } else { 3 };
    let ps = (if vertical { e.bt } else { e.bl }) + edgeOf(d, cn.style, P_SCROLL_PAD + side, basis);
    let pe = (if vertical { cn.h - e.bb } else { cn.w - e.br }) - edgeOf(d, cn.style, P_SCROLL_PAD + (if vertical { 2 } else { 1 }), basis);
    let range = if vertical { cn.scrollMax } else { cn.scrollMaxX };
    let k = cn.first;
    while k >= 0 {
        let m = &d.nodes.items[k];
        let into = false;
        if m.kind == K_ELEM && !m.ghost && !m.isFixed && m.disp != DP_NONE && m.style >= 0 {
            let al = kwOf(d, m.style, P_SNAP_ALIGN);
            let a = if vertical { al % 4 } else { al / 4 };
            if a != 0 {
                // the child's place in the box's content, whatever the nested boxes between them scrolled
                let at: f32 = 0.0;
                let q = k;
                while q != c {
                    let qn = &d.nodes.items[q];
                    at += if vertical { qn.y } else { qn.x };
                    if qn.parent != c {
                        at -= if vertical { d.nodes.items[qn.parent].scrollY } else { d.nodes.items[qn.parent].scrollX };
                    }
                    q = qn.parent;
                }
                let a0 = at - edgeOf(d, m.style, P_SCROLL_MARGIN + side, 0.0);
                let a1 = at + (if vertical { m.h } else { m.w }) + edgeOf(d, m.style, P_SCROLL_MARGIN + (if vertical { 2 } else { 1 }), 0.0);
                let s = a0 - ps;
                if a == 2 { s = (a0 + a1) / 2.0 - (ps + pe) / 2.0; }
                if a == 3 { s = a1 - pe; }
                d.snapPts.push(SnapPt { node: k, pos: max(0.0, min(range, s)), always: kwOf(d, m.style, P_SNAP_STOP) == 1 });
            }
            into = !isScroll(d, m.style);
        }
        k = walkNext(d, k, c, into);
    }
}

/// Where box `c` settles on one axis from offset `cur`, a gesture that began at `start`: the nearest snap position (`mandatory`: always;
/// proximity: only within a third of the view), but never past a `scroll-snap-stop: always` position the gesture reached first.
/// `*item` is the child snapped to (-1: none, the offset is `cur`).
fn snapTarget(d: &Dom, c: int, vertical: bool, cur: f32, start: f32, mandatory: bool, item: &int): f32 {
    *item = -1;
    snapCollect(d, c, vertical);
    if d.snapPts.len == 0 { return cur; }
    let best = 0;
    for i in 1..d.snapPts.len {
        if abs(d.snapPts.items[i].pos - cur) < abs(d.snapPts.items[best].pos - cur) { best = i; }
    }
    let n = &d.nodes.items[c];
    let view = if vertical { n.h } else { n.w };
    if !mandatory && abs(d.snapPts.items[best].pos - cur) > view / 3.0 { return cur; }
    let t = d.snapPts.items[best].pos;
    // from `start`, a stop between it and the target ends the gesture there
    let dir: f32 = if cur >= start { 1.0 } else { -1.0 };
    for i in 0..d.snapPts.len {
        let p = &d.snapPts.items[i];
        let far = (p.pos - start) * dir;
        if p.always && far > 0.5 && far < (t - start) * dir - 0.01 {
            t = p.pos;
            best = i;
        }
    }
    *item = d.snapPts.items[best].node;
    return t;
}

/// Move box `id` to `(tx, ty)` (clamped; a snap axis then goes to its nearest snap position): at once, or by the settle animation when
/// `smooth` (not under reduced motion).
fn goTo(d: &Dom, id: int, tx: f32, ty: f32, smooth: bool) {
    let n = &d.nodes.items[id];
    tx = max(0.0, min(n.scrollMaxX, tx));
    ty = max(0.0, min(n.scrollMax, ty));
    let item = -1;
    if snapsOn(d, id, false) {
        tx = snapTarget(d, id, false, tx, tx, kwOf(d, n.style, P_SNAP_TYPE) >= 4, &item);
        setItem(d, n, false, item);
    }
    if snapsOn(d, id, true) {
        ty = snapTarget(d, id, true, ty, ty, kwOf(d, n.style, P_SNAP_TYPE) >= 4, &item);
        setItem(d, n, true, item);
    }
    n.anX = false;
    n.anY = false;
    n.snapAt = -1.0;
    if smooth && !d.css.reduced {
        n.anX = abs(tx - n.scrollX) > 0.01;
        n.anY = abs(ty - n.scrollY) > 0.01;
        n.anTx = tx;
        n.anTy = ty;
        if n.anX || n.anY { d.snapPend += 1; }
    } else {
        putScroll(d, id, tx, ty);
    }
}

/// Scroll the offset along one axis that shows `[r0, r1]` (in the box's view) inside the snapport `[ps, pe]`: the change to the offset.
pub fn fitDelta(mode: int, r0: f32, r1: f32, ps: f32, pe: f32): f32 {
    if mode == SC_START { return r0 - ps; }
    if mode == SC_END { return r1 - pe; }
    if mode == SC_CENTER { return (r0 + r1) / 2.0 - (ps + pe) / 2.0; }
    if r0 >= ps && r1 <= pe { return 0.0; }
    if r0 < ps && r1 > pe { return 0.0; }
    if r0 < ps { return r0 - ps; }
    if r1 - r0 > pe - ps { return r0 - ps; }
    return r1 - pe;
}

/// Remember the child `item` a box snapped to (-1 none) with its `born` stamp: ids are reused, and `resnap` must not follow a new element.
fn setItem(d: &Dom, n: &Node, vertical: bool, item: int) {
    let b = if item >= 0 { d.nodes.items[item].born } else { -1 };
    if vertical {
        n.snapKy = item;
        n.snapBy = b;
    } else {
        n.snapKx = item;
        n.snapBx = b;
    }
}

/// `Dom.scrollIntoView`: scroll every scroll box around `id`, the nearest first, so that it shows (`block` on y, `inline` on x). A box's
/// `scroll-padding` and the element's `scroll-margin` count; a snap axis lands on a snap position. Each box's shift moves the element in
/// the boxes outside it, so the targets are worked out outward before any animation runs.
fn intoView(d: &Dom, id: int, block: int, inl: int, smooth: bool) {
    if id < 0 || id >= d.nodes.len { return; }
    let node = &d.nodes.items[id];
    if node.kind != K_ELEM || !node.laid || node.disp == DP_NONE || node.style < 0 { return; }
    let vx = d.absX(id);
    let vy = d.absY(id);
    let sx: f32 = 0.0;
    let sy: f32 = 0.0;
    let c = node.parent;
    while c >= 0 {
        let cn = &d.nodes.items[c];
        if cn.kind == K_ELEM && cn.style >= 0 && isScroll(d, cn.style) && (cn.scrollMax > 0.0 || cn.scrollMaxX > 0.0) {
            let e = edgesOf(d, cn.style, cn.basisW);
            let rx = vx - sx - d.absX(c);
            let ry = vy - sy - d.absY(c);
            let tx = cn.scrollX;
            let ty = cn.scrollY;
            if cn.scrollMaxX > 0.0 {
                let ps = e.bl + edgeOf(d, cn.style, P_SCROLL_PAD + 3, cn.w);
                let pe = cn.w - e.br - edgeOf(d, cn.style, P_SCROLL_PAD + 1, cn.w);
                let r0 = rx - edgeOf(d, node.style, P_SCROLL_MARGIN + 3, 0.0);
                let r1 = rx + node.w + edgeOf(d, node.style, P_SCROLL_MARGIN + 1, 0.0);
                tx = max(0.0, min(cn.scrollMaxX, cn.scrollX + fitDelta(inl, r0, r1, ps, pe)));
            }
            if cn.scrollMax > 0.0 {
                let qs = e.bt + edgeOf(d, cn.style, P_SCROLL_PAD, cn.h);
                let qe = cn.h - e.bb - edgeOf(d, cn.style, P_SCROLL_PAD + 2, cn.h);
                let q0 = ry - edgeOf(d, node.style, P_SCROLL_MARGIN, 0.0);
                let q1 = ry + node.h + edgeOf(d, node.style, P_SCROLL_MARGIN + 2, 0.0);
                ty = max(0.0, min(cn.scrollMax, cn.scrollY + fitDelta(block, q0, q1, qs, qe)));
            }
            let ox = cn.scrollX;
            let oy = cn.scrollY;
            if tx != ox || ty != oy {
                goTo(d, c, tx, ty, smooth);
                // where it ended is where the elements inside it shift to: the animation target, or the offset reached
                sx += (if cn.anX { cn.anTx } else { cn.scrollX }) - ox;
                sy += (if cn.anY { cn.anTy } else { cn.scrollY }) - oy;
            }
        }
        if cn.isFixed { return; }
        c = cn.parent;
    }
}

/// The element with static `id="name"` (first in tree order), -1 when there is none. A walk of the tree; call it from a handler, not
/// every frame of a big page.
fn findId(d: &Dom, name: string): int {
    if d.nodes.len == 0 { return -1; }
    let k = d.nodes.items[0].first;
    while k >= 0 {
        let m = &d.mnodes.items[k];
        if d.nodes.items[k].kind == K_ELEM && !d.nodes.items[k].ghost && m.id >= 0 && same(d.css.name(m.id), name) {
            return k;
        }
        k = walkNext(d, k, 0, true);
    }
    return -1;
}

/// `Dom.scrollToKey`: the row with key `key` of the virtual list in box `list` is brought into view even when it is not built; false when
/// the list or the key is unknown. The list jumps (no animation) and aims again each frame until the row is measured.
fn toKey(d: &Dom, list: int, key: string, block: int): bool {
    for i in 0..d.vlists.len {
        if d.vlists.items[i].node == list {
            let v = d.vlists.items[i].vl;
            let r = v.all.find(key);
            if r < 0 { return false; }
            v.want = r;
            v.wantN = 0;
            v.wantBlock = block;
            return true;
        }
    }
    return false;
}

/// One frame of everything pending: a settling box animates, a rested snap container picks its snap position.
fn stepSnap(d: &Dom) {
    let live = 0;
    let k = 1.0 - exp(0.0 - d.dtMs / ANIM_TAU);
    for i in 0..d.nodes.len {
        let n = &d.nodes.items[i];
        if n.kind == K_ELEM && (n.anX || n.anY) {
            let x = n.scrollX;
            let y = n.scrollY;
            if n.anX {
                x = if abs(n.anTx - x) < 0.5 { n.anTx } else { x + (n.anTx - x) * k };
                n.anX = x != n.anTx;
            }
            if n.anY {
                y = if abs(n.anTy - y) < 0.5 { n.anTy } else { y + (n.anTy - y) * k };
                n.anY = y != n.anTy;
            }
            putScroll(d, i, x, y);
            if n.anX || n.anY { live += 1; }
        } else if n.kind == K_ELEM && n.snapAt >= 0.0 {
            if n.velX != 0.0 || n.velY != 0.0 || d.barNode == i || d.now - n.snapAt < SNAP_IDLE {
                live += 1;
            } else {
                let sx = n.snapSx;
                let sy = n.snapSy;
                let ax = snapsOn(d, i, false);
                let ay = snapsOn(d, i, true);
                let tx = n.scrollX;
                let ty = n.scrollY;
                let item = -1;
                let mandatory = kwOf(d, n.style, P_SNAP_TYPE) >= 4;
                if ax {
                    tx = snapTarget(d, i, false, n.scrollX, sx, mandatory, &item);
                    setItem(d, n, false, item);
                }
                if ay {
                    ty = snapTarget(d, i, true, n.scrollY, sy, mandatory, &item);
                    setItem(d, n, true, item);
                }
                n.snapAt = -1.0;
                if tx != n.scrollX || ty != n.scrollY {
                    goTo(d, i, tx, ty, true);
                    if n.anX || n.anY { live += 1; }
                }
            }
        }
    }
    d.snapPend = live;
}

/// A snap container was laid out (a resize, content that changed): keep each one on the item it last snapped to.
fn resnap(d: &Dom) {
    d.snapDirty = false;
    for i in 0..d.nodes.len {
        let n = &d.nodes.items[i];
        if n.kind == K_ELEM && (n.snapKx >= 0 || n.snapKy >= 0) && n.snapAt < 0.0 && !n.anX && !n.anY && snapAxis(d, n.style) != 0 {
            let tx = n.scrollX;
            let ty = n.scrollY;
            for pass in 0..2 {
                let vertical = pass == 1;
                let item = if vertical { n.snapKy } else { n.snapKx };
                if item >= 0 && snapsOn(d, i, vertical) {
                    snapCollect(d, i, vertical);
                    let found = false;
                    for q in 0..d.snapPts.len {
                        if d.snapPts.items[q].node == item && d.nodes.items[item].born == (if vertical { n.snapBy } else { n.snapBx }) {
                            found = true;
                            if vertical { ty = d.snapPts.items[q].pos; } else { tx = d.snapPts.items[q].pos; }
                        }
                    }
                    if !found {
                        if vertical { n.snapKy = -1; } else { n.snapKx = -1; }
                    }
                }
            }
            putScroll(d, i, tx, ty);
        }
    }
}
