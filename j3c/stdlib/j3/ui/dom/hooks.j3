// Part of j3.ui.dom (paint hooks, canvas, runtime popup roots, build in/out); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Reset the paint walk to the root (every pass starts here).
    fn paintStart(this: &Dom) {
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.psp = 0;
        this.pgsp = 0;
        this.pcu[0] = -1;
        this.ptarget[0] = -1;
        this.pz[0] = 1;
        this.hidden = 0;
        this.pflat = false;
    }

    /// Bring the stacking lists (`Node.ctx`, `Node.lift`, the entries of each context) up to date with the tree; `paintAll` does it
    /// itself, and nothing is rebuilt when the tree is the one they were built for.
    fn stack(this: &Dom) {
        ensureStack(this);
    }

    /// Paint the whole page: the root stacking context, then (recursively) its entries in z order (`dom/stack.j3`). Boxes are
    /// painted from the tree; a `<canvas>` body is the generated component's, reached through the hook the generated `render` sets
    /// (`setPaintHook`). Overlays and popups come last, above everything (`inputs.overlay`).
    fn paintAll(this: &Dom) {
        if this.nodes.len == 0 {
            return;
        }
        ensureStack(this);
        this.paintStart();
        paintNode(this, 0);
    }

    /// The generated component paints `<canvas>` bodies through `fn(self)`.
    fn setPaintHook(this: &Dom, f: fn(ptr), self: ptr) {
        this.hook = f;
        this.hookSelf = self;
        this.hookOn = true;
    }

    /// The child of the paint walk's current element to enter next when it was built at `slot`, -1 for any other. Only a `<canvas>`
    /// replay (`runCanvas`) walks the generated code, and it follows the path to the canvas and nothing else; boxes, text and ghosts are
    /// painted from the tree.
    fn paintNext(this: &Dom, slot0: int): int {
        let target = this.ptarget[this.psp];
        if !this.rpOn || target < 0 {
            return -1;
        }
        let g = if this.pgsp > 0 { this.pgs[this.pgsp - 1] } else { -1 };
        if this.pcu[this.psp] == this.nodes.items[target].prev && this.nodes.items[target].slot == realSlot(this, slot0) && (g < 0 || inGroup(this, target, g)) {
            return target;
        }
        return -1;
    }

    /// Children passes of the generated walk: one, except in a replay, where the walk goes on only along the path to the canvas.
    fn paintChildren(this: &Dom, pass: int): bool {
        if this.rpOn {
            return pass == 0 && this.ptarget[this.psp] >= 0;
        }
        return pass == 0;
    }

    /// Paint `id`'s own box (background, border, radius, opacity, transform, clip, controls, text)
    /// and start its children. Always pair with `paintEnd`. In a replay it only follows the path (nothing is pushed or drawn).
    fn paintBox(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.rpOn {
            this.psp += 1;
            this.pst[this.psp] = id;
            this.rpI += 1;
            let nx = if this.rpI < this.rpLen { this.rpc[this.rpI] } else { -1 };
            this.ptarget[this.psp] = nx;
            this.pcu[this.psp] = if nx >= 0 { this.nodes.items[nx].prev } else { -1 };
            this.pv[2 * this.psp] = this.base;
            this.pv[2 * this.psp + 1] = this.scale;
            this.base = 0;
            this.scale = SLOT_UNIT;
            return;
        }
        paintOpen(this, id, true);
    }

    /// Finish `id`: paints trailing text children, pops what `paintBox` pushed.
    fn paintEnd(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        if this.rpOn {
            this.base = this.pv[2 * this.psp];
            this.scale = this.pv[2 * this.psp + 1];
            this.psp -= 1;
            this.pcu[this.psp] = id;
            this.rpI -= 1;
            return;
        }
        paintClose(this, id);
    }

    /// Start a `<canvas>` body: flush, and point `game` and `paint` draws at the box (`0,0` is its
    /// corner, `size(id)` is its size). False when it is hidden or empty (skip the body and
    /// `endCanvas`), or when it is not the canvas a replay was started for.
    fn beginCanvas(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let n = &this.nodes.items[id];
        if this.rpOn {
            if id != this.rpT {
                return false;
            }
        } else if !paintVisible(this, id) || this.hidden > 0 || n.w < 1.0 || n.h < 1.0 || this.pz[this.psp] != 1 {
            return false;
        }
        game.p2Watch(true);
        paint.pushView(Vec2 { x: this.absX(id), y: this.absY(id) }, Vec2 { x: n.w, y: n.h });
        paint.pushIdentity();
        return true;
    }

    /// End a `<canvas>` body.
    fn endCanvas(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        game.p2Watch(false);
        paint.popTransform();
        paint.popView();
    }

    /// The runtime popup root (`j3.ui.popnode`) of `owner` (it takes the owner's style scope, so the owner's component
    /// `<style>` rules reach it, and the nodes built under it should too): a child the build walk leaves alone (`Node.rt`),
    /// always `position: fixed` on its own paint layer above the page and the modals (`OVERLAY_Z + 8`, or its
    /// `z-index`). One at a time (`ptRoot`); asking again for the same owner returns it, another owner replaces it.
    fn popRoot(this: &Dom, owner: int, tag: int): int {
        return this.runtimeRoot(owner, tag, false);
    }

    /// Independent passive tooltip slot; shares the runtime subtree lifetime/build rules.
    fn tipRoot(this: &Dom, owner: int, tag: int): int {
        return this.runtimeRoot(owner, tag, true);
    }

    fn runtimeRoot(this: &Dom, owner: int, tag: int, tip: bool): int {
        let id = if tip { this.ttRoot } else { this.ptRoot };
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt && this.nodes.items[id].tag == tag && this.nodes.items[id].parent == owner {
            return id;
        }
        if tip { this.dropTip(); } else { this.dropRoot(); }
        id = newNode(this, K_ELEM, tag, 0, this.mnodes.items[owner].scope);
        insertBefore(this, owner, id, -1);
        let n = &this.nodes.items[id];
        n.rt = true;
        n.ovZ = OVERLAY_Z + if tip { 9 } else { 8 };
        if tip { this.ttRoot = id; } else { this.ptRoot = id; }
        return id;
    }

    /// Remove the runtime popup subtree, if any.
    fn dropRoot(this: &Dom) {
        let id = this.ptRoot;
        this.ptRoot = -1;
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt {
            dropNode(this, id);
        }
    }

    /// Remove the tooltip without disturbing an open select or color panel.
    fn dropTip(this: &Dom) {
        let id = this.ttRoot;
        this.ttRoot = -1;
        if id >= 0 && id < this.nodes.len && this.nodes.items[id].kind == K_ELEM && this.nodes.items[id].rt {
            dropNode(this, id);
        }
    }

    /// Point the build API (`open`, `text`, `cls`, ...) at the children of `root` until `buildOut`; the walk of
    /// the generated update is saved and comes back untouched.
    fn buildIn(this: &Dom, root: int) {
        this.rtSv[0] = this.sp;
        this.rtSv[1] = this.stack[0];
        this.rtSv[2] = this.cursor[0];
        this.rtSv[3] = this.base;
        this.rtSv[4] = this.scale;
        this.rtSv[5] = this.gsp;
        this.sp = 0;
        this.stack[0] = root;
        this.cursor[0] = -1;
        this.base = 0;
        this.scale = SLOT_UNIT;
        this.gsp = 0;
    }

    /// End `buildIn`: children of the root that were not visited are removed.
    fn buildOut(this: &Dom) {
        trimTail(this, this.stack[0], this.cursor[0]);
        this.sp = this.rtSv[0];
        this.stack[0] = this.rtSv[1];
        this.cursor[0] = this.rtSv[2];
        this.base = this.rtSv[3];
        this.scale = this.rtSv[4];
        this.gsp = this.rtSv[5];
    }

    /// Paint the runtime popup `id` above everything painted so far (call after the generated paint walk). A box that is no stacking
    /// context (a dragged item) paints in tree order, positioned descendants included.
    fn paintDetached(this: &Dom, id: int) {
        id = this.resolve(id);
        if id == STALE { return; }
        ensureStack(this);
        this.paintStart();
        this.pflat = !this.nodes.items[id].ctx;
        paintNode(this, id);
        this.pflat = false;
    }
}

