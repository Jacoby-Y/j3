// Part of j3.ui.dom (scrolling API, node handles, string buffers, list binding); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// Scroll an `overflow-y` box by `dy` px, clamped to its range.
    fn scrollBy(this: &Dom, id: int, dy: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let nv = max(0.0, min(n.scrollMax, n.scrollY + dy));
        if nv != n.scrollY {
            scrollMark(this, id);
            n.scrollY = nv;
            scrolled(this);
        }
    }

    /// Scroll an `overflow-x` box by `dx` px, clamped to its range.
    fn scrollByX(this: &Dom, id: int, dx: f32) {
        id = this.resolve(id);
        if id == STALE { return; }
        let n = &this.nodes.items[id];
        let nv = scroll.clampOff(n.scrollX, dx, n.scrollMaxX);
        if nv != n.scrollX {
            scrollMark(this, id);
            n.scrollX = nv;
            scrolled(this);
        }
    }

    /// Bring element `id` into view: every scroll box around it scrolls, nearest first, as little as needed (`block` = `SC_START`, `SC_CENTER`,
    /// `SC_END` or `SC_NEAREST` on y; x uses nearest). `scroll-padding` of the boxes and `scroll-margin` of the element count, a snap
    /// axis lands on a snap position. `smooth` animates (instant under reduced motion). Uses the last layout.
    fn scrollIntoView(this: &Dom, id: int, block: int, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        intoView(this, id, block, SC_NEAREST, smooth);
    }

    /// Like `scrollIntoView` with both modes: `block` on y, `inl` on x (a carousel item: `SC_CENTER` for `inl`).
    fn scrollIntoViewXY(this: &Dom, id: int, block: int, inl: int, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        intoView(this, id, block, inl, smooth);
    }

    /// Scroll box `id` to offset `(x, y)` (clamped; a snap axis goes to its nearest snap position); `smooth` animates.
    fn scrollTo(this: &Dom, id: int, x: f32, y: f32, smooth: bool) {
        id = this.resolve(id);
        if id == STALE { return; }
        goTo(this, id, x, y, smooth);
    }

    /// `bind:scrollX` (`onX`) / `bind:scrollY`: `v` is the bound value, the result its new value. A scroll since the last call (wheel,
    /// scrollbar, inertia, `scrollTo`, a clamp at layout) comes back; else a changed `v` moves the box at once and stops its motion.
    fn bindScroll(this: &Dom, id: int, v: f32, onX: bool): f32 {
        id = this.resolve(id);
        if id == STALE { return v; }
        let n = &this.nodes.items[id];
        let cur = if onX { n.scrollX } else { n.scrollY };
        let seen = if onX { n.bsx } else { n.bsy };
        if cur != seen {
            v = cur;
        } else if v != cur {
            // a box not laid out yet has no range: layout clamps it
            let laid = n.w > 0.0 || n.h > 0.0;
            v = max(0.0, if laid { min(if onX { n.scrollMaxX } else { n.scrollMax }, v) } else { v });
            if onX {
                n.scrollX = v;
                n.velX = 0.0;
                n.anX = false;
            } else {
                n.scrollY = v;
                n.velY = 0.0;
                n.anY = false;
            }
            scrolled(this);
        }
        if onX { n.bsx = v; } else { n.bsy = v; }
        return v;
    }

    /// A handle for element `id`: its id plus the node's serial, so a freed and recycled id no longer matches. -1 for a free or unknown node.
    /// `bind:this` and `use:` hand these out. `focusNode`, `scrollIntoView(XY)`, `scrollTo`, `scrollBy(X)`, `size`, `absX` and `absY` take a
    /// handle or a plain id; for any other call use `node(h)`.
    fn handle(this: &Dom, id: int): int {
        if id < 0 || id >= this.nodes.len || this.nodes.items[id].kind == K_FREE {
            return -1;
        }
        return this.nodes.items[id].ser * HANDLE_UNIT + id;
    }

    /// The plain id behind handle `h`, -1 when the element is gone (or `h` is -1). A plain id passes through unchecked.
    fn node(this: &Dom, h: int): int {
        let id = this.resolve(h);
        if id == STALE {
            return -1;
        }
        return id;
    }

    /// Is the element behind handle `h` still in the tree?
    fn alive(this: &Dom, h: int): bool {
        return this.node(h) >= 0;
    }

    /// Does `buf[0..n]` hold the bytes of `s`? (`use:` compares a string parameter with the copy it kept.)
    fn strHas(this: &Dom, buf: []u8, n: int, s: string): bool {
        if n != s.len {
            return false;
        }
        for i in 0..n {
            if buf[i] != s[i] {
                return false;
            }
        }
        return true;
    }

    /// Copy `s` into `buf` (a bigger buffer from the Dom's arena when it does not fit: it only ever grows, so a parameter that changes
    /// every frame allocates nothing after the first few). The buffer comes back.
    fn strPut(this: &Dom, buf: []u8, s: string): []u8 {
        if buf.len < s.len {
            let cap = if s.len > 2 * buf.len { s.len } else { 2 * buf.len };
            if cap < 16 {
                cap = 16;
            }
            buf = this.mem.alloc::<u8>(cap);
        }
        for i in 0..s.len {
            buf[i] = s[i];
        }
        return buf;
    }

    fn resolve(this: &Dom, h: int): int {
        if h < HANDLE_UNIT {
            return h;
        }
        let id = h % HANDLE_UNIT;
        if id >= this.nodes.len || this.nodes.items[id].kind == K_FREE || this.nodes.items[id].ser != h / HANDLE_UNIT {
            return STALE;
        }
        return id;
    }

    /// The element with static `id="name"` (first in tree order), -1 for none. A walk of the live tree each call.
    fn byId(this: &Dom, name: string): int {
        return findId(this, name);
    }

    /// Scroll the virtual list in box `list` to the row with key `key` (`block` as `scrollIntoView`), even when the row is not built.
    /// False for an unknown list or key. The row shows once it is measured (variable heights aim again each frame until then).
    fn scrollToKey(this: &Dom, list: int, key: string, block: int): bool {
        return toKey(this, list, key, block);
    }

    /// `vlist.step` registers the virtual list of scroll box `id` (every frame).
    fn vlistBind(this: &Dom, id: int, v: &VList) {
        id = this.resolve(id);
        if id == STALE { return; }
        for i in 0..this.vlists.len {
            if this.vlists.items[i].node == id {
                this.vlists.items[i].vl = v;
                return;
            }
        }
        this.vlists.push(VListRef { node: id, vl: v });
    }
}

