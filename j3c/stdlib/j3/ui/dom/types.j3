// Part of j3.ui.dom (node, fragment, edge and transition types, kinds and layout constants); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

pub const K_ELEM: int = 0;

pub const K_TEXT: int = 1;

pub const K_FREE: int = 2;
/// `Dom.handle`: serial * HANDLE_UNIT + id. Below it a number is a plain id; `resolve` gives STALE for a handle whose node is gone.
pub const HANDLE_UNIT: int = 4294967296;
pub const STALE: int = -2;

/// `j3.ui.a11y.events` kinds (the bridge's change queue; only filled after `a11y.enable`).
pub const EV_FOCUS: int = 1;
pub const EV_CHECKED: int = 2;
pub const EV_EXPANDED: int = 3;
pub const EV_SELECTED: int = 4;
pub const EV_VALUE: int = 5;
pub const EV_CHILDREN: int = 6;
pub const EV_NAME: int = 7;

/// One queued accessibility event: its kind (`EV_*`) and the handle of the node it is about (-1 for "no focus").
pub struct AEv {
    kind: int;
    h: int;
}

pub const DP_BLOCK: int = 0;

pub const DP_INLINE: int = 1;

const DP_INLINE_BLOCK: int = 2;

const DP_FLEX: int = 3;

const DP_GRID: int = 4;

pub const DP_NONE: int = 5;

/// `display: contents`: no box; a grid parent lays the children out as its own items (`flatFrom`).
const DP_CONTENTS: int = 6;

const UNDEF: f32 = -1.0;

/// A `<meter>` `low`, `high` or `optimum` the markup did not set.
const METER_UNSET: f32 = -1000000000.0;

/// Overlay kinds (`Node.ov`) and the first of their paint layers (`z-index` 1000 up, one per stack depth).
pub const OV_MODAL: int = 1;

pub const OV_POPOVER: int = 2;

pub const OVERLAY_Z: int = 1000;

const MAX_DEPTH: int = 128;

/// Paint frames: the tree depth, plus the same again for a `<canvas>` replay (`runCanvas`).
const PAINT_DEPTH: int = 2 * MAX_DEPTH + 4;
const GROUP_DEPTH: int = 64;

const FI_CAP: int = 16384;

/// Scratch floats (`Dom.gs`, a stack so nested grids take turns) and cells (`Dom.occ`) for grid track sizing and placement:
/// they start this size and double on demand; `OCC_MAX` cells (64 MiB) is a grid too big to place.
const GS_START: int = 4096;

const OCC_START: int = 4096;

const OCC_MAX: int = 67108864;

/// One node. Read the layout results; build with the `Dom` methods.
pub struct Node {
    kind: int;
    tag: int;
    parent: int;
    first: int;
    last: int;
    next: int;
    prev: int;
    /// Visual links for ordered flex children; source links remain unchanged.
    vfirst: int;
    vlast: int;
    vnext: int;
    vprev: int;
    ordered: bool;
    /// Stacking (`dom/stack.j3`, set by `buildStack`): `ctx` the box is a stacking context (it paints its descendants as one unit,
    /// `z-index` inside it is relative to it), `lift` it paints after the in-flow content of its context (positioned or a context).
    /// A context's entries, in paint order, are `Dom.zl[zs .. zs + zc]`: the first `zneg` have a negative key.
    ctx: bool = false;
    lift: bool = false;
    /// A scroller that is no context with a lifted box inside it: its scrollbars paint last in its context (`paintBarEntry`).
    bdef: bool = false;
    zs: int = 0;
    zneg: int = 0;
    zc: int = 0;
    /// `stackSig`'s memo: the hash of the stacking values (`stackVals`) of style `zfs` (-1: none yet), for `Dom.zfe`'s CSS epoch.
    zfs: int = -1;
    zfp: int = 0;
    slot: int;
    scope: int;
    /// Innermost keyed `{#each}` row it was built in (`keyBegin`), -1 outside.
    gk: int;
    /// Computed style id (`css.get(style, P_*)`).
    style: int;
    disp: int;
    isAbs: bool;
    checked: bool;
    value: f32;
    attrMin: f32;
    attrMax: f32;
    attrStep: f32;
    buf: []u8;
    tlen: int;
    x: f32;
    y: f32;
    w: f32;
    h: f32;
    /// Scroll height: content plus padding (an `overflow-y` box can scroll `scrollMax` px).
    contentH: f32;
    scrollY: f32;
    scrollMax: f32;
    /// Distance from the border-box top to the first text baseline.
    baseline: f32;
    /// Selected bytes `sa..sb` of a text node (`j3.ui.textsel`), -1 when none.
    sa: int;
    sb: int;
    /// First text fragment owned by this block (-1 for none).
    frag0: int;
    fragTail: int;
    fragReuse: int;
    /// Per-line boxes of this block's decorated inline children (`inline boxes`, chain of `Dom.boxes`).
    box0: int;
    boxTail: int;
    boxReuse: int;
    dirty: bool;
    laid: bool;
    /// Layout boundary (`applyStyle`): an element whose `width` and `height` are lengths, so its border box can't follow its content.
    bound: bool;
    /// The parent's last layout of this boundary read nothing from its content (set by that parent, cleared by `layoutBox`):
    /// `markDirty` from inside stops here and `layoutBounds` replays its last box. `relQ`: it is on `Dom.relayout`.
    relay: bool;
    relQ: bool;
    lastW: f32;
    lastH: f32;
    basisW: f32;
    basisH: f32;
    styleDirty: bool;
    /// Only a `style:` value changed (`markInline`): the cascade result `Dyn.base` stands, `inlineStyle` alone runs again.
    inlineDirty: bool;
    subStyle: bool;
    /// `markKids` already restyled this node's children since its last restyle (so a mass append marks them once).
    kidsMk: bool;
    /// Restyle was asked only by a `:has()` invalidation (`markHas`): the subtree restyles only if this node's style id changes.
    hasOnly: bool;
    /// `Css.hasGen` of the last `markHas` walk through this node: a walk stops at a node an earlier walk already covered this round.
    hasEp: int;
    firstEl: int;
    /// The last element child (carries `FL_LAST_CHILD`), -1 for none.
    lastEl: int;
    dirtyGen: int;
    intrGen: int;
    minc: f32;
    maxc: f32;
    clsBuf: []int;
    ncls: int;
    /// Paint bits set by `paintBox` for `paintEnd` (see `PB_*`).
    pflags: int;
    /// Index into `Dom.trns` (-1: no `transition:` / `in:` / `out:`), when the enter transition began, and the ghost state.
    trn: int;
    fadeT0: f32;
    ghost: bool;
    ghostT0: f32;
    /// Frame (`Dom.frame`) in which the node was created.
    born: int;
    /// Serial of the node (`Dom.serial` at creation): a handle (`Dom.handle`) holds it, so a recycled id is told from the old node.
    ser: int;
    /// Index into `Dom.trs` (-1 none).
    tr: int;
    /// Computed style from the cascade; `style` is this, or the overlay while the node moves.
    tstyle: int;
    /// `animation-delay` added by markup (`anim-delay`), in ms.
    adelay: f32;
    /// Index into `Dom.flips` (-1: no `animate:flip`).
    flip: int;
    /// On `Dom.act`.
    inAct: bool;
    /// Input widgets (`j3.ui.inputs`): the bound string (`value`) as a view, `placeholder`, the index
    /// of the `Dom.eds` text state (-1 none), `multiple`, the second thumb of a range slider, and the
    /// frame of the last user change / Enter press.
    sval: string;
    ph: string;
    edit: int;
    multi: bool;
    high: f32;
    /// `<meter>` `low`, `high` and `optimum` (`METER_UNSET` for an absent one), and what `attrOpen` last applied to a `<details>` (0 nothing, 1 closed, 2 open).
    mlow: f32;
    mhigh: f32;
    mopt: f32;
    openSet: int;
    /// The frame whose update sees this `<details>`'s `toggled` (it changed state).
    togAt: int;
    /// The frame a click on its `<summary>` flipped this `<details>` (`bind:open` writes back only those), or the frame the user checked or
    /// unchecked this radio.
    clkAt: int;
    /// A radio's `name` (interned, -1 none).
    rname: int;
    /// `Dom.tabSer` of the Tab press that chose this radio as its group's stop.
    rstop: int;
    /// The `<meter>` good / ok / bad colors resolved for computed style `mcSt` (-1 none): they follow the node's own custom properties.
    mcSt: int;
    mc0: int;
    mc1: int;
    mc2: int;
    chg: int;
    sub: int;
    /// `maxlength` in code points (0 none) and `rows` of a `textarea` (0: 3).
    maxlen: int;
    rows: int;
    /// Horizontal scroll (`overflow-x`): offset, range, scroll width, and the inertia speeds of both
    /// axes in px/ms (`scroll-behavior: smooth`).
    scrollX: f32;
    scrollMaxX: f32;
    contentW: f32;
    velX: f32;
    velY: f32;
    /// The offsets `bind:scrollX` / `bind:scrollY` last wrote or read (`bindScroll`).
    bsx: f32;
    bsy: f32;
    /// Scroll snap and animated scrolls (`dom/snap.j3`): the time (ms) of the last scroll by a gesture or by code, -1 when settled, and
    /// the offsets the gesture began at; `anX` / `anY` = an x / y animation toward `anTx` / `anTy`; the item last snapped to per axis.
    snapAt: f32;
    snapSx: f32;
    snapSy: f32;
    anX: bool;
    anY: bool;
    anTx: f32;
    anTy: f32;
    snapKx: int;
    snapKy: int;
    /// `born` of those items when they were snapped to: a node id that was freed and reused has another stamp.
    snapBx: int;
    snapBy: int;
    /// Overlays (`j3.ui.overlay`): `OV_*` kind (0 none), the `closedby` mode, the frame a close was
    /// requested, the focus to give back, and the stack depth that picked its paint layer.
    ov: int;
    ovBy: int;
    closeAt: int;
    ovFocus: int;
    ovZ: int;
    ovInit: bool;
    /// `autoselect` (dialog), `on:submit` (input), `default` (button), and a pending select-all for the field the dialog focused.
    fAuto: bool;
    fSub: bool;
    fDef: bool;
    fSel: bool;
    /// `on:wheel|stop`: the wheel over this box scrolls none of its ancestors.
    fWheel: bool;
    /// `on:mousedown|stop` (8), `on:mouseup|stop` (16), `on:contextmenu|stop` (32): the event does not bubble past this node.
    fStop: u8;
    ovContext: bool;
    ctxPending: bool;
    /// `popover="caret"` (anchored at its box's caret; `cth` is the caret line height + 4 for flipping above) and a text box's
    /// `triggers` characters (a literal).
    ovCaret: bool;
    cth: f32;
    trigs: string;
    hcAt: f32;
    hcLeave: f32;
    hcOpen: bool;
    hcBlock: bool;
    /// `position: fixed` (or a `<dialog>`): `x`/`y` are viewport px.
    isFixed: bool;
    /// `title` text (copied), and `left`/`top` attributes (px; `hasAt`).
    svBuf: []u8;
    svLen: int;
    /// `text-transform` copy of the text (`shownText`), and the transform it holds (0: stale).
    tbuf: []u8;
    txm: int;
    tipBuf: []u8;
    tipLen: int;
    /// `aria-label` and `role` attributes (copied; `j3.ui.a11y`).
    ariaBuf: []u8;
    ariaLen: int;
    roleBuf: []u8;
    /// `for` (labels): the static id of the control.
    forBuf: []u8;
    forLen: int;
    /// `aria-live` ("polite" / "assertive" / "off"), `aria-describedby` (static ids) and `aria-selected` (0 unset, 1 false, 2 true).
    liveBuf: []u8;
    liveLen: int;
    descBuf: []u8;
    descLen: int;
    asel: int;
    /// `focus-group` and `nav-up|down|left|right` (copied, packed as `group;up;down;left;right`; `j3.ui.padnav`).
    navBuf: []u8;
    navLen: int;
    roleLen: int;
    hasAtX: bool;
    hasAtY: bool;
    atx: f32;
    aty: f32;
    /// `j3.ui.panels` role (`PK_*`) and the size it forces on a panel (-1 none; border box px).
    pk: int;
    /// `menuitem` / `tabindex` attribute: focusable like a button, a target of the menu keys (`j3.ui.overlays`).
    mitem: bool;
    /// `tabindex="-1"`: focusable by code and click, skipped by Tab and the pad.
    noTab: bool;
    /// `tabindex` above 0: Tab visits these first, in ascending order (ties in tree order).
    tabIdx: int;
    /// Item drag (`j3.ui.drag`): `draggable`, the handlers it has (bits 1 enter, 2 leave, 4 over, 8 drop), `drag-ghost="none"`,
    /// `drag-id`, and `drag-data` (copied).
    draggable: bool;
    dragT: int;
    noGhost: bool;
    dragId: int;
    dgBuf: []u8;
    dgLen: int;
    ow: f32;
    oh: f32;
    /// `position: sticky` (`j3.ui.sticky`): registered on `Dom.stk`, and how far it is pushed down.
    isStk: bool;
    sy: f32;
    /// `<img>` / `<svg>` / `<path>` data: index into `Dom.media` plus one (0 none).
    media: int;
    /// Visual-only option mirror: borrows source media; never owns source handlers or identity.
    optionSource: int;
    /// Last source dirty generation (mirrors), or cached label generation (logical options).
    optionGen: int;
    /// Index into `Dom.dyns` (-1 none): `class` holes and `style:` overrides.
    dyn: int;
    /// Root of a popup subtree the runtime owns (`j3.ui.popnode`): the build walk neither reuses nor removes it,
    /// the generated paint walk skips it, and it is always `position: fixed` on the overlay layer. `pidx` is a
    /// popup row's index (-1 none).
    rt: bool;
    pidx: int;
    /// 1 or 2 for the runtime-made `::before` / `::after` box of its parent (`Node.ghost` is set too, so the build walk,
    /// hit testing, focus, a11y and the test kit leave it alone and the paint walk draws it from the tree), else 0.
    pe: int;
}

/// `Node.pk`: a panel, its drag handle, its resize grip.
pub const PK_PANEL: int = 1;
pub const PK_HANDLE: int = 2;
pub const PK_GRIP: int = 3;
/// `window-drag` (`j3.ui.windrag`): the box moves the window.
pub const PK_WDRAG: int = 4;

/// One run of text on one line. `start..end` index the bytes of the text node `node`.
pub struct Frag {
    node: int;
    /// 0 text, 1 inline-block (use the node's rect).
    kind: int;
    x: f32;
    y: f32;
    w: f32;
    start: int;
    end: int;
    ap: f32;
    dp: f32;
    asc: f32;
    /// Where the "…" of `text-overflow: ellipsis` goes (px from `x`), or -1 for none. The run then
    /// ends at `end` and `w` includes the ellipsis.
    ell: f32;
    next: int;
    /// `vertical-align`: `vm` 0 raised `sh` px from the line's baseline, 1 `top`, 2 `bottom` (of the line box).
    sh: f32;
    vm: int;
    /// Which `top` / `bottom` group the fragment belongs to (`vm` != 0): its element is one box on the line.
    grp: int;
}

struct Idx {
    v: int;
}

/// `animate:flip` state of one node (`Dom.flips`, dense; `Node.flip` indexes it): duration, `Css.eases` index,
/// the layout position seen last frame (`seen` once), the paint offset now and at the start of the flight, and its start time.
struct Flip {
    node: int;
    ms: f32;
    ease: int;
    seen: bool;
    x: f32;
    y: f32;
    ox: f32;
    oy: f32;
    ox0: f32;
    oy0: f32;
    t0: f32;
}

/// Enter and leave transitions of one node (`Dom.trns`, dense; `Node.trn` indexes it). `inK` / `outK`: 0 none, 1 fade,
/// 2 fly, 3 slide, 4 scale, with durations `inMs` / `outMs`; `ease` is a `Css.eases` index (-1: linear for fade, ease-out
/// otherwise); `fx` / `fy` the fly offset in px, `sf` the scale start, `axis` the slide axis (0 height, 1 width).
struct Trans {
    node: int;
    inK: int;
    inMs: f32;
    outK: int;
    outMs: f32;
    ease: int;
    fx: f32;
    fy: f32;
    sf: f32;
    axis: int;
    /// A slide was in flight at the last layout (`stepSlides`).
    sliding: bool;
}

/// An open decorated inline element while its block is laid out (`Dom.ob`, a stack).
struct OBox {
    node: int;
    seq: int;
    /// margin + border + padding to the left / right, and the border + padding part alone.
    lead: f32;
    trail: f32;
    lpad: f32;
    rpad: f32;
    /// Whether its left edge has been placed (on its first fragment).
    used: bool;
    /// First / last fragment of this box on the current line (-1 none), and the left extension of that segment.
    fa: int;
    fb: int;
    segL: f32;
    first: bool;
    /// `vertical-align` of the element: raise from the baseline, and `top` / `bottom` (see `Frag.vm`).
    sh: f32;
    vm: int;
    /// `box-decoration-break: clone`: every line piece repeats the left / right padding and border.
    cl: bool;
}

/// A finished per-line piece of an inline box, waiting for its line to be positioned (`Dom.pseg`).
struct BSeg {
    node: int;
    seq: int;
    fa: int;
    fb: int;
    left: f32;
    right: f32;
    first: bool;
    last: bool;
    sh: f32;
    vm: int;
    cl: bool;
}

struct FontEnt {
    family: int;
    size: int;
    font: Font;
}

struct FItem {
    id: int;
    grow: f32;
    shrink: f32;
    padM: f32;
    base: f32;
    minM: f32;
    maxM: f32;
    size: f32;
    mm: f32;
    cm: f32;
    cross: f32;
    nat: f32;
    frozen: bool;
    pos: f32;
    /// Flex line (0 without `flex-wrap`), its cross size, its baseline distance from cross-start (descent when reversed), and its cross offset.
    ln: int;
    lc: f32;
    la: f32;
    ly: f32;
    /// Grid area: column lines `c0..c1`, row lines `r0..r1` (0 based, end exclusive).
    c0: int;
    c1: int;
    r0: int;
    r1: int;
}

pub struct Edges {
    pl: f32;
    pr: f32;
    pt: f32;
    pb: f32;
    bl: f32;
    br: f32;
    bt: f32;
    bb: f32;
    ml: f32;
    mr: f32;
    mt: f32;
    mb: f32;
}
