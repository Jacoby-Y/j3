// Part of j3.ui.dom (Paint memo: what a style row says about painting a box, worked out once per row.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

// Most boxes paint the same way frame after frame: no effect, and a fill and border straight from their style. Answering that
// takes about 40 style lookups per box, so it is kept per style row (`Dom.pmemo`, indexed by row id) and `paintOpen` reads the
// answer. A cascade row is never rewritten (until `Css.reset`, which moves the epoch the entry is checked against), so its entry
// stays right. A box whose row can change in place takes the long way: a box in motion (its overlay row blends in place) and a
// `style:` slot (`dynattr.build` rewrites it), except a slot whose overrides are all `PM_GEOM` props, which paints as its base row.

/// The background is drawn by `paintBackground` (anything but the cases below).
const BG_SLOW: int = 0;
/// Nothing to draw.
const BG_NONE: int = 1;
/// One `roundRectEx`: the fill (`bg`), corners, and a uniform solid border (`bw` wide, `bc`), as `paintBackground` draws it.
const BG_ROUND: int = 2;
/// One `rect` of `bg`: square corners, no border.
const BG_RECT: int = 3;

/// One style row's entry (`ep` 0: not worked out; else `Css.epoch + 1`).
pub struct PaintMemo {
    ep: int = 0;
    /// No transform, clip, clip-path, mask, filter, blend, projection or outline: `paintOpen` pushes only place and alpha.
    plain: bool = false;
    /// `opacity`.
    opa: f32 = 1;
    bgm: int = 0;
    bg: int = 0;
    bw: f32 = 0;
    bc: int = 0;
    rtl: f32 = 0;
    rtr: f32 = 0;
    rbr: f32 = 0;
    rbl: f32 = 0;
}

/// Props that paint never reads (`paintOpen` and what it calls get only the laid-out box): a `style:` slot overriding only these
/// paints as its base row. A prop not listed here keeps the slot on the long way.
const PM_GEOM: [19]int = [
    P_WIDTH, P_HEIGHT, P_MIN_WIDTH, P_MIN_HEIGHT, P_MAX_WIDTH, P_MAX_HEIGHT, P_MARGIN_TOP, P_LEFT, P_RIGHT, P_TOP, P_BOTTOM,
    P_FLEX, P_FLEX_BASIS, P_FLEX_SHRINK, P_GAP, P_ROW_GAP, P_ORDER, P_ALIGN_SELF, P_ASPECT_RATIO,
];

fn geomProp(p: int): bool {
    if p > P_MARGIN_TOP && p < P_MARGIN_TOP + 4 {
        p = P_MARGIN_TOP;
    }
    for k in 0..19 {
        if PM_GEOM[k] == p {
            return true;
        }
    }
    return false;
}

/// The cascade row the `style:` slot `id` shows holds, except where its overrides wrote (`Dyn.rb`, `rprops`): that row stands in
/// for the slot when every override is a `PM_GEOM` prop (`paintSide`) or no override is a `STACK_PROPS` one (-1: none).
fn slotBase(d: &Dom, id: int, paintSide: bool): int {
    let n = &d.nodes.items[id];
    let y = &d.dyns.items[n.dyn];
    if y.cur >= 0 && y.cur == y.base && n.style == y.cur {
        // no override: `inlineStyle` showed the cascade row itself
        return n.style;
    }
    let s = if n.style == y.a { 0 } else if n.style == y.b { 1 } else { -1 };
    if s < 0 || y.rb[s] < 0 {
        return -1;
    }
    let r0 = s * dynattr.SLOTS * dynattr.PER;
    for i in 0..y.rn[s] {
        let p = y.rprops[r0 + i];
        if (paintSide && !geomProp(p)) || (!paintSide && stackProp(p)) {
            return -1;
        }
    }
    return y.rb[s];
}

/// The memo entry for painting `id` (-1: none, paint it the long way).
fn paintMemo(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    if !d.pmOn || n.tr >= 0 || n.style < 0 {
        return -1;
    }
    let row = n.style;
    if n.dyn >= 0 && n.kind == K_ELEM {
        row = slotBase(d, id, true);
        if row < 0 {
            return -1;
        }
    }
    while d.pmemo.len <= row {
        d.pmemo.push(PaintMemo { ep: 0 });
    }
    if d.pmemo.items[row].ep != d.css.epoch + 1 {
        d.pmemo.items[row] = memoOf(d, row);
        d.pmBuilt += 1;
    }
    return row;
}

/// A length a box's size does not change: px, or anything `edgeOf` counts as 0. Percentages and `calc()` are not.
fn fixedLen(d: &Dom, st: int, p: int): bool {
    let k = vkind(d, st, p);
    return k != V_PCT && k != V_CALC;
}

fn memoOf(d: &Dom, st: int): PaintMemo {
    let m = PaintMemo { ep: d.css.epoch + 1, plain: false, opa: opacityOf(d, st), bgm: BG_SLOW, bg: 0, bw: 0.0, bc: 0, rtl: 0.0, rtr: 0.0, rbr: 0.0, rbl: 0.0 };
    let noXf = vkind(d, st, P_TRANSLATE) != V_XFORM && vkind(d, st, P_ROTATE) != V_XFORM && vkind(d, st, P_SCALE) != V_XFORM && vkind(d, st, P_TRANSFORM) != V_XFORM;
    let ow = kwOf(d, st, P_OUTLINE_STYLE) == BORDER_NONE || (fixedLen(d, st, P_OUTLINE_WIDTH) && edgeOf(d, st, P_OUTLINE_WIDTH, -1.0) <= 0.0);
    // `needsPost` false implies no projection (`projectedCoverage`)
    m.plain = noXf && ow && !needsPost(d, st) && !isClip(d, st) && vkind(d, st, P_CLIP_PATH) != V_LIST && vkind(d, st, P_MASK_IMAGE) != V_GRAD;
    for k in 0..4 {
        if !fixedLen(d, st, P_BORDER_TOP_WIDTH + k) || !fixedLen(d, st, P_RADIUS_TL + k) {
            return m;
        }
    }
    // what makes `paintBackground` leave its two plain endings
    let bimg = vkind(d, st, P_BORDER_IMAGE);
    let back = d.css.get(st, P_BACKDROP_FILTER);
    if kwOf(d, st, P_BG_CLIP) == CLIP_TEXT || vkind(d, st, P_BG_IMAGE) == V_GRAD || vkind(d, st, P_BG_IMAGE) == V_URL || vkind(d, st, P_BOX_SHADOW) == V_SHADOW
        || bimg == V_GRAD || bimg == V_URL || (back.kind == V_PX && back.f > 0.0) {
        return m;
    }
    let bt = edgeOf(d, st, P_BORDER_TOP_WIDTH, -1.0);
    let br = edgeOf(d, st, P_BORDER_TOP_WIDTH + 1, -1.0);
    let bb = edgeOf(d, st, P_BORDER_TOP_WIDTH + 2, -1.0);
    let bl = edgeOf(d, st, P_BORDER_TOP_WIDTH + 3, -1.0);
    let hasBorder = bt > 0.0 || br > 0.0 || bb > 0.0 || bl > 0.0;
    let bstyle = kwOf(d, st, P_BORDER_STYLE);
    if bstyle != BORDER_SOLID && bstyle != BORDER_NONE && hasBorder {
        return m;
    }
    m.bg = colorOf(d, st, P_BACKGROUND);
    m.rtl = max(0.0, edgeOf(d, st, P_RADIUS_TL, -1.0));
    m.rtr = max(0.0, edgeOf(d, st, P_RADIUS_TL + 1, -1.0));
    m.rbr = max(0.0, edgeOf(d, st, P_RADIUS_TL + 2, -1.0));
    m.rbl = max(0.0, edgeOf(d, st, P_RADIUS_TL + 3, -1.0));
    let round = m.rtl > 0.0 || m.rtr > 0.0 || m.rbr > 0.0 || m.rbl > 0.0;
    let uniform = bt == br && br == bb && bb == bl;
    if ca(m.bg) == 0 && !hasBorder {
        m.bgm = BG_NONE;
    } else if hasBorder && uniform {
        m.bgm = BG_ROUND;
        m.bw = bt;
        m.bc = colorOf(d, st, P_BORDER_TOP_COLOR);
    } else if hasBorder {
        // one-sided borders are strips over the fill
        return m;
    } else if round {
        m.bgm = BG_ROUND;
    } else {
        m.bgm = BG_RECT;
    }
    return m;
}

/// Draw `id`'s background from memo row `row`, as `paintBackground` would.
fn paintMemoBg(d: &Dom, id: int, row: int, w: f32, h: f32) {
    let m = &d.pmemo.items[row];
    if m.bgm == BG_SLOW {
        paintBackground(d, id, d.nodes.items[id].style, w, h);
    } else if m.bgm == BG_ROUND {
        paint.roundRectEx(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h }, Corners { tl: m.rtl, tr: m.rtr, br: m.rbr, bl: m.rbl }, toColor(m.bg), m.bw, toColor(m.bc));
    } else if m.bgm == BG_RECT {
        paint.rect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: w, y: h }, toColor(m.bg));
    }
}
