// Part of j3.ui.dom (Inline flow: text, br and node walk, runs.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// The closing edges (margin, border, padding right) of the inline boxes that end right after text node `id`.
fn trailAfter(d: &Dom, id: int, owner: int): f32 {
    let t: f32 = 0.0;
    let k = id;
    while k != owner && d.nodes.items[k].next < 0 {
        let p = d.nodes.items[k].parent;
        if p < 0 || p == owner || d.nodes.items[p].disp != DP_INLINE {
            break;
        }
        let e = edgesOf(d, d.nodes.items[p].style, d.nodes.items[p].basisW);
        t += if kwOf(d, d.nodes.items[p].style, P_BOX_BREAK) == 1 { e.mr } else { e.mr + e.br + e.pr };
        k = p;
    }
    return t;
}

fn ifcText(d: &Dom, s: &Ifc, id: int) {
    if s.stopped { return; }
    let st = d.nodes.items[id].style;
    let oldMode = s.mode;
    let oldNowrap = s.nowrap;
    let oldPreLine = s.preLine;
    let oldPreserve = s.preserve;
    let oldBreak = s.brk;
    let ws = kwOf(d, st, P_WHITE_SPACE);
    s.nowrap = ws == WS_NOWRAP || ws == WS_PRE;
    s.preLine = ws == WS_PRE_LINE || ws == WS_PRE || ws == WS_PRE_WRAP;
    s.preserve = ws == WS_PRE || ws == WS_PRE_WRAP;
    s.brk = kwOf(d, st, P_OVERFLOW_WRAP) != WRAP_NORMAL;
    if s.mode == 1 && s.nowrap { s.mode = 2; }
    let font = fontOf(d, st);
    let bold = isBold(d, st);
    let tm = enterTextNode(d, id);
    let lh = lineHeightOf(d, st, font);
    let fh = f32(fontLine(font));
    let asc = f32(fontAscent(font));
    let ap = (lh - fh) / 2.0 + asc;
    let dp = lh - ap;
    let spc: [1]u8 = [32];
    let spaceW = textWidth(font, spc[:], bold);
    let whole = shownText(d, id);
    let len = whole.len;
    let i = 0;
    while i < len {
        let bt = whole[i];
        if isWs(bt) {
            if bt == 10 && s.preLine {
                ifcNewline(d, s, ap, dp);
            } else if s.preserve {
                let whiteW = spaceW;
                if bt == 9 {
                    let tab = max(1.0, spaceW * 8.0);
                    whiteW = tab - (s.x - f32(int(s.x / tab)) * tab);
                }
                placeItem(d, s, id, 0, i, i + 1, whiteW, ap, dp, asc);
            } else {
                s.pend = true;
                s.pendW = spaceW;
                s.pendNode = id;
                s.pendAt = i;
            }
            i += 1;
        } else {
            let j = i;
            while j < len && !isWs(whole[j]) {
                j += 1;
            }
            let ww = textWidth(font, whole[i..j], bold);
            if s.brk && !s.nowrap && s.mode == 0 && ww > s.avail + 0.01 {
                ifcBreakWord(d, s, id, font, bold, i, j, ap, dp, asc);
            } else {
                if j == len { s.tr = trailAfter(d, id, s.owner); }
                placeItem(d, s, id, 0, i, j, ww, ap, dp, asc);
                s.tr = 0.0;
            }
            i = j;
        }
    }    leaveText(tm);
    s.mode = oldMode;
    s.nowrap = oldNowrap;
    s.preLine = oldPreLine;
    s.preserve = oldPreserve;
    s.brk = oldBreak;

}

/// `<br>`: a forced line break whatever `white-space` is (an empty line when nothing is on this one). Nothing follows a trailing `<br>`.
fn ifcBr(d: &Dom, s: &Ifc, id: int) {
    if s.stopped { return; }
    let st = d.nodes.items[id].style;
    let font = fontOf(d, st);
    let lh = lineHeightOf(d, st, font);
    let ap = (lh - f32(fontLine(font))) / 2.0 + f32(fontAscent(font));
    d.nodes.items[id].x = 0.0;
    d.nodes.items[id].y = 0.0;
    d.nodes.items[id].w = 0.0;
    d.nodes.items[id].h = 0.0;
    if s.mode == 0 {
        if !s.has {
            s.has = true;
            s.ca = max(s.ca, ap);
            s.cd = max(s.cd, lh - ap);
        }
        endLine(d, s, true, false);
    } else if s.mode == 2 {
        s.maxW = max(s.maxW, s.x);
        s.x = 0.0;
        s.has = false;
    }
    s.pend = false;
}

fn ifcNode(d: &Dom, s: &Ifc, id: int, cw: f32) {
    if d.nodes.items[id].kind == K_TEXT {
        ifcText(d, s, id);
        return;
    }
    if skipped(d, id) {
        return;
    }
    if d.nodes.items[id].tag == d.tBr {
        ifcBr(d, s, id);
        return;
    }
    let dp = d.nodes.items[id].disp;
    if dp == DP_INLINE {
        d.nodes.items[id].x = 0.0;
        d.nodes.items[id].y = 0.0;
        d.nodes.items[id].w = 0.0;
        d.nodes.items[id].h = 0.0;
        let ist = d.nodes.items[id].style;
        let oSh = s.sh;
        let oVm = s.vm;
        let oPst = s.pst;
        let oGrp = s.grp;
        if s.mode == 0 {
            let ifont = fontOf(d, ist);
            let ilh = lineHeightOf(d, ist, ifont);
            let iap = (ilh - f32(fontLine(ifont))) / 2.0 + f32(fontAscent(ifont));
            enterAlign(d, s, ist, iap, ilh - iap, ilh);
            s.pst = ist;
        }
        let ie = edgesOf(d, ist, cw);
        let deco = inlineDeco(d, ist, ie);
        let lead = ie.ml + ie.bl + ie.pl;
        let trail = ie.mr + ie.br + ie.pr;
        let cl = deco && kwOf(d, ist, P_BOX_BREAK) == 1;
        if cl {
            s.cll += ie.bl + ie.pl;
            s.clr += ie.br + ie.pr;
        }
        if deco {
            d.nodes.items[id].basisW = cw;
            s.lead += lead;
            if s.mode == 0 {
                s.seq += 1;
                d.ob.push(OBox { node: id, seq: s.seq, lead: lead, trail: trail, lpad: ie.bl + ie.pl, rpad: ie.br + ie.pr, used: false, fa: -1, fb: -1, segL: 0.0, first: false, sh: s.sh, vm: s.vm, cl: cl });
            }
        }
        let c = d.nodes.items[id].first;
        while c >= 0 {
            ifcNode(d, s, c, cw);
            c = d.nodes.items[c].next;
        }
        if cl {
            s.cll -= ie.bl + ie.pl;
            s.clr -= ie.br + ie.pr;
        }
        if deco {
            if s.mode == 0 {
                d.ob.len -= 1;
                let b = d.ob.items[d.ob.len];
                if !b.used {
                    // nothing of it was placed (empty, or cut by a line limit): it takes no room
                    s.lead -= lead;
                } else {
                    if b.fa >= 0 {
                        d.pseg.push(BSeg { node: id, seq: b.seq, fa: b.fa, fb: b.fb, left: b.segL, right: s.trailAcc + b.rpad, first: b.first, last: true, sh: b.sh, vm: b.vm, cl: b.cl });
                    }
                    if s.has {
                        s.x += trail;
                    }
                    s.trailAcc += trail;
                }
            } else if s.mode == 2 {
                s.x += trail;
                s.maxW = max(s.maxW, s.x);
            }
        }
        s.sh = oSh;
        s.vm = oVm;
        s.pst = oPst;
        s.grp = oGrp;
        return;
    }
    // inline-block or any other box in a line: an atomic item
    let st = d.nodes.items[id].style;
    let e = edgesOf(d, st, cw);
    let outerMin = minContent(d, id) + e.ml + e.mr;
    let outerMax = maxContent(d, id) + e.ml + e.mr;
    if s.mode == 1 {
        placeItem(d, s, id, 1, 0, 0, outerMin, 0.0, 0.0, 0.0);
        return;
    }
    if s.mode == 2 {
        placeItem(d, s, id, 1, 0, 0, outerMax, 0.0, 0.0, 0.0);
        return;
    }
    let aw = s.avail - e.ml - e.mr;
    if s.has {
        aw = aw - s.x;
        if s.pend {
            aw = aw - s.pendW;
        }
    }
    let w = fitWidth(d, id, max(aw, 0.0), cw);
    if s.has && w + e.ml + e.mr > aw + 0.01 {
        w = fitWidth(d, id, s.avail - e.ml - e.mr, cw);
    }
    let owner = &d.nodes.items[s.owner];
    let oe = edgesOf(d, owner.style, owner.basisW);
    let bh = if owner.lastH >= 0.0 { max(0.0, owner.lastH - oe.pt - oe.pb - oe.bt - oe.bb) } else { UNDEF };
    let hs = specH(d, st, bh, e);
    layoutBox(d, id, w, hs, cw, bh);
    let h = d.nodes.items[id].h;
    let bl = d.nodes.items[id].baseline;
    let aSh = s.sh;
    let aVm = s.vm;
    let aGrp = s.grp;
    let alh = lineHeightOf(d, st, fontOf(d, st));
    enterAlign(d, s, st, e.mt + bl, h + e.mb - bl, alh);
    placeItem(d, s, id, 1, 0, 0, w + e.ml + e.mr, e.mt + bl, h + e.mb - bl, e.mt + bl);
    s.sh = aSh;
    s.vm = aVm;
    s.grp = aGrp;
    d.nodes.items[id].x = d.nodes.items[id].x + e.ml;
}

/// Lay out the siblings `first..last` of `owner` as inline content starting at `y0`.
fn layoutRun(d: &Dom, owner: int, first: int, last: int, e: Edges, cw: f32, y0: f32): Ifc {
    let st = d.nodes.items[owner].style;
    let font = fontOf(d, st);
    let lh = lineHeightOf(d, st, font);
    let fh = f32(fontLine(font));
    let sa = (lh - fh) / 2.0 + f32(fontAscent(font));
    let align = kwOf(d, st, P_TEXT_ALIGN);
    if align == TEXT_LEFT && d.nodes.items[owner].tag == d.tButton {
        align = TEXT_CENTER;
    }
    let s = newIfc(d, 0, owner, cw, e.bl + e.pl, y0, align, sa, lh - sa);
    let c = first;
    while c >= 0 {
        ifcNode(d, &s, c, cw);
        if c == last {
            break;
        }
        c = d.nodes.items[c].next;
    }
    endLine(d, &s, false, false);
    return s;
}
