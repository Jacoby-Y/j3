// Part of j3.ui.dom (mouse position, layoutAt, absolute coordinates, text of a node); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// The mouse in viewport px (what `left` / `top` take for a menu opened at the pointer).
    fn mouseAt(this: &Dom): Vec2 {
        return if this.ctxNode >= 0 { Vec2 { x: this.ctxX, y: this.ctxY } } else { Vec2 { x: this.mx, y: this.my } };
    }

    /// A close was asked of overlay `id` this frame (Escape on top of the stack, a press outside it).
    fn closeRequested(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        return this.nodes.items[id].closeAt == this.frame;
    }

    /// The right button went down this frame on `id` or a descendant (a context menu request), unless a node
    /// between them has `on:contextmenu|stop`.
    fn contextAt(this: &Dom, id: int): bool {
        id = this.resolve(id);
        if id == STALE { return false; }
        let c = this.ctxNode;
        return c >= 0 && styleVisible(this, c) && bubbleHit(this, c, id, 32);
    }

    /// Feed the right button for the next `beginFrame`s (with `simInput`).
    fn simRight(this: &Dom, down: bool) {
        this.simOn = true;
        this.simR = down;
    }

    /// Feed the middle button for the next `beginFrame`s (with `simInput`).
    fn simMiddle(this: &Dom, down: bool) {
        this.simOn = true;
        this.simM = down;
    }

    /// Resolve dirty styles and lay out the tree in a `w` by `h` viewport. Does nothing when no
    /// node changed and the size is the same.
    fn layoutAt(this: &Dom, w: f32, h: f32) {
        if this.css.setViewport(w, h) && this.nodes.len > 0 {
            // an `@media` condition flipped: restyle everything
            markStyle(this, 0);
            if this.css.vpUnits {
                // `vw` and friends change a length without changing its style: lay every box out again
                for i in 0..this.nodes.len {
                    this.nodes.items[i].dirty = true;
                }
            }
        }
        refreshOptionVisuals(this);
        resolveStyles(this);
        game.profUiMark(game.UI_STYLE);
        if this.focus >= 0 && !styleVisible(this, this.focus) { this.focusNode(-1); }
        stepMotion(this);
        if this.trns.len > 0 {
            stepSlides(this);
        }
        // the normal pass (it skips clean subtrees), then the boundaries `markDirty` stopped at; a boundary whose
        // baseline moved dirties its ancestors, so the normal pass runs again
        let did = false;
        let again = this.nodes.len > 0;
        while again {
            let r = &this.nodes.items[0];
            if r.dirty || !r.laid || r.basisW != w || r.basisH != h {
                layoutBox(this, 0, w, h, w, h);
                did = true;
            }
            let lb = layoutBounds(this);
            if lb > 0 {
                did = true;
            }
            again = lb == 2 && this.nodes.items[0].dirty;
        }
        if did {
            layoutAbs(this);
        }
        if this.flips.len > 0 {
            stepFlips(this, w, h);
        } else {
            this.flipLive = 0;
        }
    }

    /// Left edge in root coordinates (scroll offsets of the ancestors included).
    fn absX(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let x: f32 = 0.0;
        let c = id;
        while c >= 0 {
            x += this.nodes.items[c].x;
            if this.nodes.items[c].isFixed {
                break;
            }
            let p = this.nodes.items[c].parent;
            if p >= 0 {
                x -= this.nodes.items[p].scrollX;
            }
            c = p;
        }
        return x;
    }

    /// Top edge in root coordinates (scroll offsets of the ancestors included).
    fn absY(this: &Dom, id: int): f32 {
        id = this.resolve(id);
        if id == STALE { return 0.0; }
        let y: f32 = 0.0;
        let c = id;
        while c >= 0 {
            y += this.nodes.items[c].y + this.nodes.items[c].sy;
            if this.nodes.items[c].isFixed {
                break;
            }
            let p = this.nodes.items[c].parent;
            if p >= 0 {
                y -= this.nodes.items[p].scrollY;
            }
            c = p;
        }
        return y;
    }

    /// The text of a text node.
    fn textOf(this: &Dom, id: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        return ([]u8 { ptr: n.buf.ptr, len: n.tlen }) as string;
    }
}

// ---- frame, input, events (stage 05) ------------------------------------------------------------
