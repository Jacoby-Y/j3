// Part of j3.ui.dom (Inline formatting: fragments, boxes, line breaking, text runs.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

fn releaseFrags(d: &Dom, first: int) {
    let f = first;
    while f >= 0 {
        let nx = d.frags.items[f].next;
        d.fragFree.push(Idx { v: f });
        f = nx;
    }
}

fn releaseBoxes(d: &Dom, first: int) {
    let f = first;
    while f >= 0 {
        let nx = d.boxes.items[f].next;
        d.boxFree.push(Idx { v: f });
        f = nx;
    }
}

fn beginFrags(d: &Dom, owner: int) {
    let n = &d.nodes.items[owner];
    n.fragReuse = n.frag0;
    n.frag0 = -1;
    n.fragTail = -1;
    n.boxReuse = n.box0;
    n.box0 = -1;
    n.boxTail = -1;
}

/// Append an inline-box piece to `owner`'s chain (reusing last frame's).
fn addBox(d: &Dom, owner: int, fr: Frag) {
    let f = d.nodes.items[owner].boxReuse;
    if f >= 0 {
        d.nodes.items[owner].boxReuse = d.boxes.items[f].next;
        d.boxes.items[f] = fr;
    } else if d.boxFree.len > 0 {
        d.boxFree.len -= 1;
        f = d.boxFree.items[d.boxFree.len].v;
        d.boxes.items[f] = fr;
    } else {
        f = d.boxes.len;
        d.boxes.push(fr);
    }
    d.boxes.items[f].next = -1;
    let tail = d.nodes.items[owner].boxTail;
    if tail >= 0 {
        d.boxes.items[tail].next = f;
    } else {
        d.nodes.items[owner].box0 = f;
    }
    d.nodes.items[owner].boxTail = f;
}

fn endFrags(d: &Dom, owner: int) {
    let n = &d.nodes.items[owner];
    releaseFrags(d, n.fragReuse);
    n.fragReuse = -1;
    releaseBoxes(d, n.boxReuse);
    n.boxReuse = -1;
    if n.boxTail >= 0 {
        d.boxes.items[n.boxTail].next = -1;
    }
    if n.fragTail >= 0 {
        d.frags.items[n.fragTail].next = -1;
    }
}

/// Append a fragment to `owner`'s chain (reusing last frame's), return its id.
fn addFrag(d: &Dom, owner: int, fr: Frag): int {
    let f = d.nodes.items[owner].fragReuse;
    if f >= 0 {
        d.nodes.items[owner].fragReuse = d.frags.items[f].next;
        d.frags.items[f] = fr;
    } else if d.fragFree.len > 0 {
        d.fragFree.len -= 1;
        f = d.fragFree.items[d.fragFree.len].v;
        d.frags.items[f] = fr;
    } else {
        f = d.frags.len;
        d.frags.push(fr);
    }
    d.frags.items[f].next = -1;
    let tail = d.nodes.items[owner].fragTail;
    if tail >= 0 {
        d.frags.items[tail].next = f;
    } else {
        d.nodes.items[owner].frag0 = f;
    }
    d.nodes.items[owner].fragTail = f;
    return f;
}

/// State of one inline run. `mode`: 0 lay out, 1 min-content (widest word), 2 max-content (one line).
struct Ifc {
    mode: int;
    owner: int;
    avail: f32;
    ox: f32;
    top: f32;
    x: f32;
    ca: f32;
    cd: f32;
    has: bool;
    pend: bool;
    pendW: f32;
    pendNode: int;
    pendAt: int;
    line0: int;
    lastFrag: int;
    lastNode: int;
    lastEnd: int;
    align: int;
    maxW: f32;
    totalH: f32;
    strutA: f32;
    strutD: f32;
    baseline: f32;
    hasBase: bool;
    /// Shared whitespace, wrapping, line-limit and ellipsis state for intrinsic and used geometry.
    nowrap: bool;
    preLine: bool;
    brk: bool;
    ell: bool;
    preserve: bool;
    lines: int;
    clamp: int;
    stopped: bool;
    /// Inline boxes: stack / pending-piece bases in `Dom.ob` / `Dom.pseg`, left edge not yet placed, trailing edges
    /// closed since the last item, open order counter.
    obBase: int;
    psBase: int;
    lead: f32;
    trailAcc: f32;
    seq: int;
    /// Closing edges that follow the item being placed (it is the last of its inline boxes): they must fit with it.
    tr: f32;
    /// `vertical-align`: the raise from the baseline and the `top` / `bottom` mode of the box being placed, the style of the
    /// enclosing inline box (the parent for `sub`, `text-top`, ...), and the tallest `top` / `bottom` items on this line.
    sh: f32;
    vm: int;
    pst: int;
    /// The `top` / `bottom` group being placed (0 none; a new id per outermost `top` / `bottom` element or item), the last id
    /// given, and whether this line holds such items.
    grp: int;
    gseq: int;
    al: bool;
    /// Open `clone` boxes: their left (`cll`) and right (`clr`) padding + border, repeated on every line piece.
    cll: f32;
    clr: f32;
}

const ELLIPSIS: string = "…";

/// `text-indent` as the start of the first line: a % needs the box, so only a laid-out run (mode 0) has one; min-content ignores it.
fn indentOf(d: &Dom, st: int, mode: int, avail: f32): f32 {
    let v = d.css.get(st, P_TEXT_INDENT);
    if v.kind == V_PX && mode != 1 {
        return v.f;
    }
    if v.kind == V_PCT && mode == 0 {
        return avail * v.f / 100.0;
    }
    return 0.0;
}

fn newIfc(d: &Dom, mode: int, owner: int, avail: f32, ox: f32, top: f32, align: int, sa: f32, sd: f32): Ifc {
    let st = d.nodes.items[owner].style;
    // a text node that is a flex item has no `text-overflow` of its own (it is not inherited)
    let bst = st;
    if d.nodes.items[owner].kind == K_TEXT && d.nodes.items[owner].parent >= 0 {
        bst = d.nodes.items[d.nodes.items[owner].parent].style;
    }
    let ws = kwOf(d, st, P_WHITE_SPACE);
    return Ifc {
        mode: mode, owner: owner, avail: avail, ox: ox, top: top, x: indentOf(d, st, mode, avail), ca: 0.0, cd: 0.0, has: false, pend: false,
        pendW: 0.0, pendNode: -1, pendAt: 0, line0: -1, lastFrag: -1, lastNode: -1, lastEnd: -1, align: align, maxW: 0.0, totalH: 0.0,
        strutA: sa, strutD: sd, baseline: 0.0, hasBase: false,
        nowrap: ws == WS_NOWRAP || ws == WS_PRE, preLine: ws == WS_PRE_LINE || ws == WS_PRE || ws == WS_PRE_WRAP, brk: kwOf(d, st, P_OVERFLOW_WRAP) != WRAP_NORMAL,
        preserve: ws == WS_PRE || ws == WS_PRE_WRAP, lines: 0, clamp: int(d.css.get(bst, P_LINE_CLAMP).f), stopped: false,
        obBase: d.ob.len, psBase: d.pseg.len, lead: 0.0, trailAcc: 0.0, seq: 0, tr: 0.0, sh: 0.0, vm: 0, pst: st, grp: 0, gseq: 0, al: false, cll: 0.0, clr: 0.0,
        ell: kwOf(d, bst, P_TEXT_OVERFLOW) == TO_ELLIPSIS && isClip(d, bst),
    };
}

/// `text-overflow: ellipsis` on a line wider than its box: cut the first run that crosses the edge
/// so a "…" fits, and drop what follows.
fn clipLine(d: &Dom, s: &Ifc) {
    let ofont = fontOf(d, d.nodes.items[s.owner].style);
    let el = ELLIPSIS;
    let otm = enterText(d, d.nodes.items[s.owner].style);
    let ew = textWidth(ofont, []u8 { ptr: el.ptr, len: el.len }, false);
    leaveText(otm);
    let budget = s.avail - ew;
    let tail = d.nodes.items[s.owner].fragTail;
    let f = s.line0;
    while f >= 0 {
        let fr = &d.frags.items[f];
        if fr.x + fr.w > budget {
            if fr.kind != 0 {
                return;
            }
            let tn = &d.nodes.items[fr.node];
            let font = fontOf(d, tn.style);
            let bold = isBold(d, tn.style);
            let tm = enterTextNode(d, fr.node);
            let whole = shownText(d, fr.node);
            let cut = fitPrefix(font, bold, whole[fr.start..fr.end], budget - fr.x);
            let pw = textWidth(font, whole[fr.start..fr.start + cut], bold);
            fr.end = fr.start + cut;
            fr.ell = pw;
            fr.w = pw + ew;
            leaveText(tm);
            releaseFrags(d, fr.next);
            fr.next = -1;
            d.nodes.items[s.owner].fragTail = f;
            s.x = fr.x + fr.w;
            return;
        }
        if f == tail {
            if fr.kind == 0 { fr.ell = fr.w; fr.w += ew; s.x += ew; }
            break;
        }
        f = fr.next;
    }
}

fn spaceFrag(d: &Dom, fr: &Frag): bool {
    return fr.kind == 0 && fr.end == fr.start + 1 && isWs(d.nodes.items[fr.node].buf[fr.start]);
}

/// The extent of `vertical-align: top` / `bottom` group `grp` on the line `f0..tail`: x above, y below the group's baseline
/// (the largest of its fragments' parts, each moved by its own raise inside the group).
fn groupExt(d: &Dom, f0: int, tail: int, grp: int): Vec2 {
    let r = Vec2 { x: 0.0, y: 0.0 };
    let f = f0;
    while f >= 0 {
        let fr = &d.frags.items[f];
        if fr.grp == grp && fr.vm != 0 {
            r.x = max(r.x, fr.ap + fr.sh);
            r.y = max(r.y, fr.dp - fr.sh);
        }
        if f == tail { break; }
        f = fr.next;
    }
    return r;
}

fn endLine(d: &Dom, s: &Ifc, more: bool, soft: bool) {
    if s.stopped || !s.has {
        return;
    }
    s.lines += 1;
    if s.mode == 0 { s.x += s.clr; }
    let clamped = s.mode == 0 && s.clamp > 0 && s.lines >= s.clamp && more;
    if s.mode == 0 && (clamped || (s.ell && s.x > s.avail + 0.01)) {
        clipLine(d, s);
    }
    let a = max(s.ca, s.strutA);
    let dd = max(s.cd, s.strutD);
    let tail = d.nodes.items[s.owner].fragTail;
    // `vertical-align: top` / `bottom` groups grow the line box when taller than the rest
    if s.al {
        let tt: f32 = 0.0;
        let tb: f32 = 0.0;
        let g = s.line0;
        while g >= 0 {
            let gr = &d.frags.items[g];
            if gr.vm != 0 {
                let ge = groupExt(d, s.line0, tail, gr.grp);
                if gr.vm == 1 { tt = max(tt, ge.x + ge.y); } else { tb = max(tb, ge.x + ge.y); }
            }
            if g == tail { break; }
            g = gr.next;
        }
        if tt > a + dd { dd = tt - a; }
        if tb > a + dd { a = tb - dd; }
    }
    let off: f32 = 0.0;
    let free = s.avail - s.x;
    if free > 0.0 {
        if s.align == TEXT_RIGHT {
            off = free;
        } else if s.align == TEXT_CENTER {
            off = free / 2.0;
        }
    }
    let gaps = 0;
    let f = s.line0;
    while s.align == TEXT_JUSTIFY && f >= 0 {
        let gapFrag = &d.frags.items[f];
        if spaceFrag(d, gapFrag) { gaps += 1; }
        if f == tail { break; }
        f = gapFrag.next;
    }
    let spread: f32 = 0.0;
    if s.align == TEXT_JUSTIFY && soft && !clamped && free > 0.0 && gaps > 0 { spread = free / f32(gaps); }
    let extra: f32 = 0.0;
    f = s.line0;
    while f >= 0 {
        let fr = &d.frags.items[f];
        fr.x += extra;
        if spread > 0.0 && spaceFrag(d, fr) { fr.w += spread; extra += spread; }
        fr.x = fr.x + off + s.ox;
        let bl = s.top + a - fr.sh;
        if fr.vm != 0 {
            let gx = groupExt(d, s.line0, tail, fr.grp);
            bl = (if fr.vm == 1 { s.top + gx.x } else { s.top + a + dd - gx.y }) - fr.sh;
        }
        if fr.kind == 0 {
            fr.y = bl - fr.asc;
        } else {
            fr.y = bl - fr.ap;
            d.nodes.items[fr.node].x = fr.x;
            d.nodes.items[fr.node].y = fr.y;
        }
        if f == tail {
            break;
        }
        f = fr.next;
    }
    if s.mode == 0 && (d.ob.len > s.obBase || d.pseg.len > s.psBase) {
        flushBoxes(d, s, s.top + a);
    }
    if !s.hasBase {
        s.baseline = s.top + a;
        s.hasBase = true;
    }
    s.top += a + dd;
    s.totalH += a + dd;
    s.maxW = max(s.maxW, s.x);
    s.x = 0.0;
    s.ca = 0.0;
    s.cd = 0.0;
    s.has = false;
    s.pend = false;
    s.al = false;
    s.line0 = -1;
    s.lastFrag = -1;
    s.lastNode = -1;
    s.stopped = clamped;
}

/// Bookkeeping of the open inline boxes for a placed item (fragment `fid`).
fn boxItem(d: &Dom, s: &Ifc, fid: int) {
    let acc: f32 = 0.0;
    let k = d.ob.len - 1;
    while k >= s.obBase {
        let b = &d.ob.items[k];
        if !b.used {
            b.segL = acc + b.lpad;
            acc += b.lead;
            b.used = true;
            b.first = true;
            b.fa = fid;
        } else if b.fa < 0 {
            // a continuation piece reaches back over the cloned left edges of the boxes inside it
            b.segL = if b.cl { acc + b.lpad } else { acc };
            if b.cl { acc += b.lpad; }
            b.first = false;
            b.fa = fid;
        }
        b.fb = fid;
        k -= 1;
    }
}

/// The line is positioned: turn this line's inline-box pieces (finished ones in `Dom.pseg`, open ones cut at the
/// line end) into rects on the owner's box chain, outer boxes first. `base` is the baseline.
fn flushBoxes(d: &Dom, s: &Ifc, base: f32) {
    // innermost first: a box cut here also covers the right edges of the boxes inside it (cloned ones, and ones closed after the last item)
    let k = d.ob.len - 1;
    let inner: f32 = s.trailAcc;
    while k >= s.obBase {
        let b = &d.ob.items[k];
        if b.fa >= 0 {
            if b.cl { inner += b.rpad; }
            d.pseg.push(BSeg { node: b.node, seq: b.seq, fa: b.fa, fb: b.fb, left: b.segL, right: inner, first: b.first, last: false, sh: b.sh, vm: b.vm, cl: b.cl });
            b.fa = -1;
            b.fb = -1;
        }
        k -= 1;
    }
    // insertion sort by open order
    let i = s.psBase + 1;
    while i < d.pseg.len {
        let j = i;
        while j > s.psBase && d.pseg.items[j - 1].seq > d.pseg.items[j].seq {
            let t = d.pseg.items[j - 1];
            d.pseg.items[j - 1] = d.pseg.items[j];
            d.pseg.items[j] = t;
            j -= 1;
        }
        i += 1;
    }
    let tail = d.nodes.items[s.owner].fragTail;
    for q in s.psBase..d.pseg.len {
        let sg = d.pseg.items[q];
        let foundA = false;
        let foundB = false;
        let ax: f32 = 0.0;
        let bx: f32 = 0.0;
        let fbl: f32 = 0.0;
        let f = s.line0;
        while f >= 0 {
            let fr = &d.frags.items[f];
            if f == sg.fa {
                foundA = true;
                ax = fr.x;
                fbl = (if fr.kind == 0 { fr.y + fr.asc } else { fr.y + fr.ap }) + fr.sh;
            }
            if f == sg.fb { foundB = true; bx = fr.x + fr.w; }
            if f == tail { break; }
            f = fr.next;
        }
        if foundA {
            let right = sg.right;
            let last = sg.last;
            if !foundB {
                bx = d.frags.items[tail].x + d.frags.items[tail].w;
                right = 0.0;
                last = false;
            }
            let st = d.nodes.items[sg.node].style;
            let e = edgesOf(d, st, d.nodes.items[sg.node].basisW);
            let font = fontOf(d, st);
            // a box in a `top` / `bottom` group follows its first fragment's group baseline, any other the line's; both raised by `sh`
            let y0 = (if sg.vm != 0 { fbl - sg.sh } else { base - sg.sh }) - f32(fontAscent(font)) - e.pt - e.bt;
            addBox(d, s.owner, Frag { node: sg.node, kind: 2, x: ax - sg.left, y: y0, w: bx + right - (ax - sg.left),
                start: if sg.first || sg.cl { 1 } else { 0 }, end: if last || sg.cl { 1 } else { 0 },
                ap: f32(fontLine(font)) + e.pt + e.pb + e.bt + e.bb, dp: 0.0, asc: 0.0, ell: -1.0, next: -1, sh: 0.0, vm: 0, grp: 0 });
        }
    }
    d.pseg.len = s.psBase;
}

/// Whether an inline element has a box: edges that take room in the line, or anything that paints around its text.
fn inlineDeco(d: &Dom, st: int, e: Edges): bool {
    if e.ml != 0.0 || e.mr != 0.0 || e.bl != 0.0 || e.br != 0.0 || e.pl != 0.0 || e.pr != 0.0 {
        return true;
    }
    if e.bt > 0.0 || e.bb > 0.0 || e.pt != 0.0 || e.pb != 0.0 || ca(colorOf(d, st, P_BACKGROUND)) > 0 {
        return true;
    }
    return d.css.get(st, P_BG_IMAGE).kind != V_NONE || d.css.get(st, P_BOX_SHADOW).kind == V_SHADOW;
}

/// Place something `ww` wide: `ap`/`dp` are its parts above and below the baseline.
fn placeItem(d: &Dom, s: &Ifc, node: int, kind: int, a: int, b: int, ww: f32, ap: f32, dp: f32, asc: f32) {
    if s.stopped { return; }
    let sp: f32 = 0.0;
    if s.has && s.pend {
        sp = s.pendW;
    }
    if s.mode == 1 {
        s.maxW = max(s.maxW, ww + max(s.lead, s.cll) + s.tr + s.clr);
        s.lead = 0.0;
        s.pend = false;
        return;
    }
    if s.mode == 2 {
        s.x += sp + s.lead + ww;
        s.lead = 0.0;
        s.maxW = max(s.maxW, s.x);
        s.has = true;
        s.pend = false;
        return;
    }
    if s.has && !s.nowrap && s.x + sp + s.lead + ww + s.tr + s.clr > s.avail + 0.01 {
        endLine(d, s, true, true);
        if s.stopped { return; }
        sp = 0.0;
    }
    // A collapsed interword space owns its stretched geometry for paint, picking and selection.
    if s.align == TEXT_JUSTIFY && kind == 0 && sp > 0.0 && s.pendNode >= 0 {
        let gap = addFrag(d, s.owner, Frag { node: s.pendNode, kind: 0, x: s.x, y: 0.0, w: sp, start: s.pendAt, end: s.pendAt + 1, ap: ap, dp: dp, asc: asc, ell: -1.0, next: -1, sh: s.sh, vm: s.vm, grp: s.grp });
        if s.line0 < 0 { s.line0 = gap; }
    }
    if !s.has {
        // a `clone` box continuing from the line before opens again with its padding and border
        let k = s.obBase;
        while k < d.ob.len {
            let ob = &d.ob.items[k];
            if ob.used && ob.fa < 0 && ob.cl { s.lead += ob.lpad; }
            k += 1;
        }
    }
    let merged = false;
    if kind == 0 && !s.preserve && s.align != TEXT_JUSTIFY && s.has && s.lastNode == node && s.lastFrag >= 0 && s.lastEnd + 1 == a {
        let nb = &d.nodes.items[node];
        if nb.buf[a - 1] == 32 {
            let fl = &d.frags.items[s.lastFrag];
            fl.w += sp + ww;
            fl.end = b;
            merged = true;
        }
    }
    if !merged {
        let fid = addFrag(d, s.owner, Frag { node: node, kind: kind, x: s.x + sp + s.lead, y: 0.0, w: ww, start: a, end: b, ap: ap, dp: dp, asc: asc, ell: -1.0, next: -1, sh: s.sh, vm: s.vm, grp: s.grp });
        if s.line0 < 0 {
            s.line0 = fid;
        }
        s.lastFrag = fid;
    }
    s.lastNode = node;
    s.lastEnd = b;
    if d.ob.len > s.obBase {
        boxItem(d, s, s.lastFrag);
    }
    s.x += sp + s.lead + ww;
    s.lead = 0.0;
    s.trailAcc = 0.0;
    s.has = true;
    s.pend = false;
    if s.vm != 0 {
        s.al = true;
    } else {
        s.ca = max(s.ca, ap + s.sh);
        s.cd = max(s.cd, dp - s.sh);
    }
}

/// How far `vertical-align` raises an element's baseline above its parent's (`s.pst`): `ap`/`dp` are its parts above and below
/// its baseline, `lh` its line-height. `top` / `bottom` are the caller's (they sit against the line box).
fn raiseOf(d: &Dom, s: &Ifc, st: int, ap: f32, dp: f32, lh: f32): f32 {
    let v = d.css.get(st, P_VALIGN);
    if v.kind == V_PX { return v.f; }
    if v.kind == V_PCT { return lh * v.f / 100.0; }
    if v.kind != V_KW || v.i < 3 { return 0.0; }
    let pf = fontOf(d, s.pst);
    let psz = d.css.get(s.pst, P_FONT_SIZE).f;
    let pa = f32(fontAscent(pf));
    if v.i == 3 { return psz * 0.25 - (ap - dp) / 2.0; }
    if v.i == 4 { return pa - ap; }
    if v.i == 5 { return dp - (f32(fontLine(pf)) - pa); }
    if v.i == 6 { return 0.0 - (psz / 5.0 + 1.0); }
    return psz / 3.0 + 1.0;
}

/// Enter an element's `vertical-align` (its parts `ap`/`dp` above and below its baseline): sets `s.sh` / `s.vm` for what it holds.
fn enterAlign(d: &Dom, s: &Ifc, st: int, ap: f32, dp: f32, lh: f32) {
    let v = d.css.get(st, P_VALIGN);
    if v.kind == V_KW && (v.i == 1 || v.i == 2) && s.vm == 0 {
        // the outermost `top` / `bottom` element is one box: its fragments align as a group (a nested one is a plain raise of 0)
        s.vm = v.i;
        s.sh = 0.0;
        s.gseq += 1;
        s.grp = s.gseq;
    } else {
        s.sh += raiseOf(d, s, st, ap, dp, lh);
    }
}

/// A forced line break (`white-space: pre-line`): an empty line when nothing is on this one.
fn ifcNewline(d: &Dom, s: &Ifc, ap: f32, dp: f32) {
    if s.mode == 0 {
        if !s.has {
            s.has = true;
            s.ca = max(s.ca, ap);
            s.cd = max(s.cd, dp);
        }
        endLine(d, s, true, false);
        if s.preserve && !s.stopped { s.has = true; s.ca = ap; s.cd = dp; }
    } else if s.mode == 2 {
        s.maxW = max(s.maxW, s.x);
        s.x = 0.0;
        s.has = false;
    }
    s.pend = false;
}

/// A word wider than the line (`overflow-wrap: break-word`): it starts a line of its own and is cut
/// between code points, as many as fit on each line.
fn ifcBreakWord(d: &Dom, s: &Ifc, id: int, font: Font, bold: bool, a0: int, b: int, ap: f32, dp: f32, asc: f32) {
    let whole = shownText(d, id);
    if s.has {
        endLine(d, s, true, true);
    }
    let a = a0;
    while a < b && !s.stopped {
        let cut = fitPrefix(font, bold, whole[a..b], s.avail);
        if cut == 0 {
            cut = cpLen(whole[a..b], 0);
        }
        placeItem(d, s, id, 0, a, a + cut, textWidth(font, whole[a..a + cut], bold), ap, dp, asc);
        a += cut;
        if a < b {
            endLine(d, s, true, true);
        }
    }
}

/// The closing edges (margin, border, padding right) of the inline boxes that end right after text node `id`.
fn trailAfter(d: &Dom, id: int, owner: int): f32 {
    let t: f32 = 0.0;
    let k = id;
    while k != owner && d.nodes.items[k].next < 0 {
        let p = d.nodes.items[k].parent;
        if p < 0 || p == owner || d.nodes.items[p].disp != DP_INLINE {
            break;
        }
        let e = edgesOf(d, d.nodes.items[p].style, d.nodes.items[p].basisW);
        t += if kwOf(d, d.nodes.items[p].style, P_BOX_BREAK) == 1 { e.mr } else { e.mr + e.br + e.pr };
        k = p;
    }
    return t;
}

fn ifcText(d: &Dom, s: &Ifc, id: int) {
    if s.stopped { return; }
    let st = d.nodes.items[id].style;
    let oldMode = s.mode;
    let oldNowrap = s.nowrap;
    let oldPreLine = s.preLine;
    let oldPreserve = s.preserve;
    let oldBreak = s.brk;
    let ws = kwOf(d, st, P_WHITE_SPACE);
    s.nowrap = ws == WS_NOWRAP || ws == WS_PRE;
    s.preLine = ws == WS_PRE_LINE || ws == WS_PRE || ws == WS_PRE_WRAP;
    s.preserve = ws == WS_PRE || ws == WS_PRE_WRAP;
    s.brk = kwOf(d, st, P_OVERFLOW_WRAP) != WRAP_NORMAL;
    if s.mode == 1 && s.nowrap { s.mode = 2; }
    let font = fontOf(d, st);
    let bold = isBold(d, st);
    let tm = enterTextNode(d, id);
    let lh = lineHeightOf(d, st, font);
    let fh = f32(fontLine(font));
    let asc = f32(fontAscent(font));
    let ap = (lh - fh) / 2.0 + asc;
    let dp = lh - ap;
    let spc: [1]u8 = [32];
    let spaceW = textWidth(font, spc[:], bold);
    let whole = shownText(d, id);
    let len = whole.len;
    let i = 0;
    while i < len {
        let bt = whole[i];
        if isWs(bt) {
            if bt == 10 && s.preLine {
                ifcNewline(d, s, ap, dp);
            } else if s.preserve {
                let whiteW = spaceW;
                if bt == 9 {
                    let tab = max(1.0, spaceW * 8.0);
                    whiteW = tab - (s.x - f32(int(s.x / tab)) * tab);
                }
                placeItem(d, s, id, 0, i, i + 1, whiteW, ap, dp, asc);
            } else {
                s.pend = true;
                s.pendW = spaceW;
                s.pendNode = id;
                s.pendAt = i;
            }
            i += 1;
        } else {
            let j = i;
            while j < len && !isWs(whole[j]) {
                j += 1;
            }
            let ww = textWidth(font, whole[i..j], bold);
            if s.brk && !s.nowrap && s.mode == 0 && ww > s.avail + 0.01 {
                ifcBreakWord(d, s, id, font, bold, i, j, ap, dp, asc);
            } else {
                if j == len { s.tr = trailAfter(d, id, s.owner); }
                placeItem(d, s, id, 0, i, j, ww, ap, dp, asc);
                s.tr = 0.0;
            }
            i = j;
        }
    }    leaveText(tm);
    s.mode = oldMode;
    s.nowrap = oldNowrap;
    s.preLine = oldPreLine;
    s.preserve = oldPreserve;
    s.brk = oldBreak;

}

/// `<br>`: a forced line break whatever `white-space` is (an empty line when nothing is on this one). Nothing follows a trailing `<br>`.
fn ifcBr(d: &Dom, s: &Ifc, id: int) {
    if s.stopped { return; }
    let st = d.nodes.items[id].style;
    let font = fontOf(d, st);
    let lh = lineHeightOf(d, st, font);
    let ap = (lh - f32(fontLine(font))) / 2.0 + f32(fontAscent(font));
    d.nodes.items[id].x = 0.0;
    d.nodes.items[id].y = 0.0;
    d.nodes.items[id].w = 0.0;
    d.nodes.items[id].h = 0.0;
    if s.mode == 0 {
        if !s.has {
            s.has = true;
            s.ca = max(s.ca, ap);
            s.cd = max(s.cd, lh - ap);
        }
        endLine(d, s, true, false);
    } else if s.mode == 2 {
        s.maxW = max(s.maxW, s.x);
        s.x = 0.0;
        s.has = false;
    }
    s.pend = false;
}

fn ifcNode(d: &Dom, s: &Ifc, id: int, cw: f32) {
    if d.nodes.items[id].kind == K_TEXT {
        ifcText(d, s, id);
        return;
    }
    if skipped(d, id) {
        return;
    }
    if d.nodes.items[id].tag == d.tBr {
        ifcBr(d, s, id);
        return;
    }
    let dp = d.nodes.items[id].disp;
    if dp == DP_INLINE {
        d.nodes.items[id].x = 0.0;
        d.nodes.items[id].y = 0.0;
        d.nodes.items[id].w = 0.0;
        d.nodes.items[id].h = 0.0;
        let ist = d.nodes.items[id].style;
        let oSh = s.sh;
        let oVm = s.vm;
        let oPst = s.pst;
        let oGrp = s.grp;
        if s.mode == 0 {
            let ifont = fontOf(d, ist);
            let ilh = lineHeightOf(d, ist, ifont);
            let iap = (ilh - f32(fontLine(ifont))) / 2.0 + f32(fontAscent(ifont));
            enterAlign(d, s, ist, iap, ilh - iap, ilh);
            s.pst = ist;
        }
        let ie = edgesOf(d, ist, cw);
        let deco = inlineDeco(d, ist, ie);
        let lead = ie.ml + ie.bl + ie.pl;
        let trail = ie.mr + ie.br + ie.pr;
        let cl = deco && kwOf(d, ist, P_BOX_BREAK) == 1;
        if cl {
            s.cll += ie.bl + ie.pl;
            s.clr += ie.br + ie.pr;
        }
        if deco {
            d.nodes.items[id].basisW = cw;
            s.lead += lead;
            if s.mode == 0 {
                s.seq += 1;
                d.ob.push(OBox { node: id, seq: s.seq, lead: lead, trail: trail, lpad: ie.bl + ie.pl, rpad: ie.br + ie.pr, used: false, fa: -1, fb: -1, segL: 0.0, first: false, sh: s.sh, vm: s.vm, cl: cl });
            }
        }
        let c = d.nodes.items[id].first;
        while c >= 0 {
            ifcNode(d, s, c, cw);
            c = d.nodes.items[c].next;
        }
        if cl {
            s.cll -= ie.bl + ie.pl;
            s.clr -= ie.br + ie.pr;
        }
        if deco {
            if s.mode == 0 {
                d.ob.len -= 1;
                let b = d.ob.items[d.ob.len];
                if !b.used {
                    // nothing of it was placed (empty, or cut by a line limit): it takes no room
                    s.lead -= lead;
                } else {
                    if b.fa >= 0 {
                        d.pseg.push(BSeg { node: id, seq: b.seq, fa: b.fa, fb: b.fb, left: b.segL, right: s.trailAcc + b.rpad, first: b.first, last: true, sh: b.sh, vm: b.vm, cl: b.cl });
                    }
                    if s.has {
                        s.x += trail;
                    }
                    s.trailAcc += trail;
                }
            } else if s.mode == 2 {
                s.x += trail;
                s.maxW = max(s.maxW, s.x);
            }
        }
        s.sh = oSh;
        s.vm = oVm;
        s.pst = oPst;
        s.grp = oGrp;
        return;
    }
    // inline-block or any other box in a line: an atomic item
    let st = d.nodes.items[id].style;
    let e = edgesOf(d, st, cw);
    let outerMin = minContent(d, id) + e.ml + e.mr;
    let outerMax = maxContent(d, id) + e.ml + e.mr;
    if s.mode == 1 {
        placeItem(d, s, id, 1, 0, 0, outerMin, 0.0, 0.0, 0.0);
        return;
    }
    if s.mode == 2 {
        placeItem(d, s, id, 1, 0, 0, outerMax, 0.0, 0.0, 0.0);
        return;
    }
    let aw = s.avail - e.ml - e.mr;
    if s.has {
        aw = aw - s.x;
        if s.pend {
            aw = aw - s.pendW;
        }
    }
    let w = fitWidth(d, id, max(aw, 0.0), cw);
    if s.has && w + e.ml + e.mr > aw + 0.01 {
        w = fitWidth(d, id, s.avail - e.ml - e.mr, cw);
    }
    let owner = &d.nodes.items[s.owner];
    let oe = edgesOf(d, owner.style, owner.basisW);
    let bh = if owner.lastH >= 0.0 { max(0.0, owner.lastH - oe.pt - oe.pb - oe.bt - oe.bb) } else { UNDEF };
    let hs = specH(d, st, bh, e);
    layoutBox(d, id, w, hs, cw, bh);
    let h = d.nodes.items[id].h;
    let bl = d.nodes.items[id].baseline;
    let aSh = s.sh;
    let aVm = s.vm;
    let aGrp = s.grp;
    let alh = lineHeightOf(d, st, fontOf(d, st));
    enterAlign(d, s, st, e.mt + bl, h + e.mb - bl, alh);
    placeItem(d, s, id, 1, 0, 0, w + e.ml + e.mr, e.mt + bl, h + e.mb - bl, e.mt + bl);
    s.sh = aSh;
    s.vm = aVm;
    s.grp = aGrp;
    d.nodes.items[id].x = d.nodes.items[id].x + e.ml;
}

/// Lay out the siblings `first..last` of `owner` as inline content starting at `y0`.
fn layoutRun(d: &Dom, owner: int, first: int, last: int, e: Edges, cw: f32, y0: f32): Ifc {
    let st = d.nodes.items[owner].style;
    let font = fontOf(d, st);
    let lh = lineHeightOf(d, st, font);
    let fh = f32(fontLine(font));
    let sa = (lh - fh) / 2.0 + f32(fontAscent(font));
    let align = kwOf(d, st, P_TEXT_ALIGN);
    if align == TEXT_LEFT && d.nodes.items[owner].tag == d.tButton {
        align = TEXT_CENTER;
    }
    let s = newIfc(d, 0, owner, cw, e.bl + e.pl, y0, align, sa, lh - sa);
    let c = first;
    while c >= 0 {
        ifcNode(d, &s, c, cw);
        if c == last {
            break;
        }
        c = d.nodes.items[c].next;
    }
    endLine(d, &s, false, false);
    return s;
}
