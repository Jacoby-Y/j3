// Part of j3.ui.dom (CSS grid layout: lay out a grid container.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// An item's alignment on the horizontal axis (`justify-self`, else the container's `justify-items`); an auto margin on either side
/// takes the free space itself, so the item does not stretch.
fn gridJustify(d: &Dom, st: int, parentJ: int): int {
    if autoM(d, st, 3) || autoM(d, st, 1) {
        return ALIGN_START;
    }
    let a = kwOf(d, st, P_JUSTIFY_SELF);
    return if a == 0 { parentJ } else { a - 1 };
}

/// Where in `free` px an item of an axis with auto margins `lo` / `hi` starts (before its own leading margin): auto margins share
/// the space, else `align` (`ALIGN_END` all of it, `ALIGN_CENTER` half).
fn gridOffset(free: f32, align: int, lo: bool, hi: bool): f32 {
    if lo || hi {
        let f = max(free, 0.0);
        return if lo && hi { f / 2.0 } else if lo { f } else { 0.0 };
    }
    if align == ALIGN_CENTER {
        return free / 2.0;
    }
    return if align == ALIGN_END { free } else { 0.0 };
}

/// `justify-content` / `align-content` for a grid whose tracks (`total` with gaps) are smaller than `ax.avail`: shift the
/// tracks (`mode` a `JUSTIFY_*`, -1 none). `fr` tracks have used the space already, so this only moves fixed and auto ones.
fn gridDistribute(d: &Dom, ax: Axis, total: f32, mode: int) {
    let free = ax.avail - total;
    if mode <= JUSTIFY_START || free <= 0.01 || ax.n == 0 {
        return;
    }
    let present = 0;
    for t in 0..ax.n {
        if d.gs[ax.o + 4 * ax.n + t] >= 0.0 {
            present += 1;
        }
    }
    let off: f32 = 0.0;
    let extra: f32 = 0.0;
    if mode == JUSTIFY_END {
        off = free;
    } else if mode == JUSTIFY_CENTER {
        off = free / 2.0;
    } else if mode == JUSTIFY_BETWEEN {
        if present > 1 {
            extra = free / f32(present - 1);
        }
    } else if mode == JUSTIFY_AROUND {
        extra = free / f32(present);
        off = extra / 2.0;
    } else if mode == JUSTIFY_EVENLY {
        extra = free / f32(present + 1);
        off = extra;
    }
    let x = off;
    for t in 0..ax.n {
        d.gs[ax.o + 5 * ax.n + t] = x;
        if d.gs[ax.o + 4 * ax.n + t] >= 0.0 {
            x += d.gs[ax.o + t] + ax.gap + extra;
        }
    }
}

fn layoutGrid(d: &Dom, id: int, cw: f32, chDef: f32, e: Edges): f32 {
    let st = d.nodes.items[id].style;
    let alignC = kwOf(d, st, P_ALIGN_ITEMS);
    let justC = kwOf(d, st, P_JUSTIFY_ITEMS);
    let gapC = numOf(d, st, P_GAP);
    let gapR = numOf(d, st, P_ROW_GAP);
    let ox = e.bl + e.pl;
    let oy = e.bt + e.pt;
    let fs = d.css.get(st, P_FONT_SIZE).f;
    let ar = areaTable(d, st);
    let colsL = columnListA(d, st, ar);
    let rowsL = trackList(d, st, P_GRID_ROWS);
    let b0 = d.fiTop;
    let g0 = d.gTop;
    let cnt = gridCollect(d, id, true, ox, oy);
    let nce = maxi(explicitCount(d, colsL, fs, cw, gapC), ar.nc);
    let nre = maxi(explicitCount(d, rowsL, fs, chDef, gapR), ar.nr);
    let ext = gridPlace(d, st, b0, cnt, nce, nre, d.css.get(st, P_GRID_FLOW).i);
    let cx = gridAxis(d, colsL, trackList(d, st, P_GRID_ACOLS), nce, ext.nc, fs, cw, gapC);
    let rx = gridAxis(d, rowsL, trackList(d, st, P_GRID_AROWS), nre, ext.nr, fs, chDef, gapR);
    gridCollapse(d, cx, b0, cnt, true);
    gridCollapse(d, rx, b0, cnt, false);
    gridContrib(d, cx, b0, cnt, true);
    gridDistribute(d, cx, gridSize(d, cx), kwOf(d, st, P_JUSTIFY_CONTENT));
    // each item laid out across its columns; its height (with margins) is what it asks of its rows
    for k in 0..cnt {
        let it1 = &d.fi[b0 + k];
        let ci = it1.id;
        let cst = d.nodes.items[ci].style;
        let aw = areaSize(d, cx.o, cx.n, it1.c0, it1.c1);
        let ce = edgesOf(d, cst, aw);
        let sw = specW(d, cst, aw, ce);
        let w = max(aw - ce.ml - ce.mr, 0.0);
        if sw >= 0.0 {
            w = sw;
        } else if gridJustify(d, cst, justC) != ALIGN_STRETCH {
            // not stretched: as wide as its content wants, at most the area
            w = fitWidth(d, ci, w, aw);
            let mw = minWOf(d, cst, aw, ce);
            if mw >= 0.0 {
                w = max(w, mw);
            }
        }
        layoutBox(d, ci, w, specH(d, cst, UNDEF, ce), aw, UNDEF);
        it1.size = d.nodes.items[ci].w;
        it1.cross = d.nodes.items[ci].h;
        it1.mm = it1.cross + ce.mt + ce.mb;
    }
    gridContrib(d, rx, b0, cnt, false);
    let total = gridSize(d, rx);
    gridDistribute(d, rx, total, kwOf(d, st, P_ALIGN_CONTENT) - 1);
    // stretch to the row area and put each item in its cell, aligned by `align-self` / `justify-self` or the margins
    for k2 in 0..cnt {
        let it2 = &d.fi[b0 + k2];
        let ci2 = it2.id;
        let cst2 = d.nodes.items[ci2].style;
        let aw2 = areaSize(d, cx.o, cx.n, it2.c0, it2.c1);
        let ah = areaSize(d, rx.o, rx.n, it2.r0, it2.r1);
        let ce2 = edgesOf(d, cst2, aw2);
        let hh = d.nodes.items[ci2].h;
        let am = selfAlign(d, cst2, alignC, true);
        if am == ALIGN_STRETCH && specH(d, cst2, UNDEF, ce2) < 0.0 {
            let want = max(ah - ce2.mt - ce2.mb, 0.0);
            if want - hh > 0.01 {
                layoutBox(d, ci2, it2.size, want, aw2, UNDEF);
                hh = d.nodes.items[ci2].h;
            }
        }
        let co2 = gridOffset(ah - hh - ce2.mt - ce2.mb, am, autoM(d, cst2, 0), autoM(d, cst2, 2));
        let jx2 = gridOffset(aw2 - it2.size - ce2.ml - ce2.mr, gridJustify(d, cst2, justC), autoM(d, cst2, 3), autoM(d, cst2, 1));
        let cn2 = &d.nodes.items[ci2];
        cn2.x = ox + areaStart(d, cx.o, cx.n, it2.c0) + jx2 + ce2.ml;
        cn2.y = oy + areaStart(d, rx.o, rx.n, it2.r0) + co2 + ce2.mt;
        if k2 == 0 {
            d.nodes.items[id].baseline = cn2.y + cn2.baseline;
        }
    }
    d.gTop = g0;
    d.fiTop = b0;
    return total;
}

/// Content-box (min-content, max-content) width of grid `id` for `contentSizes`: its columns sized with no width to fill.
fn gridIntrinsic(d: &Dom, id: int): Size {
    let st = d.nodes.items[id].style;
    let gapC = numOf(d, st, P_GAP);
    let fs = d.css.get(st, P_FONT_SIZE).f;
    let ar = areaTable(d, st);
    let colsL = columnListA(d, st, ar);
    let rowsL = trackList(d, st, P_GRID_ROWS);
    let b0 = d.fiTop;
    let g0 = d.gTop;
    let cnt = gridCollect(d, id, false, 0.0, 0.0);
    let nce = maxi(explicitCount(d, colsL, fs, UNDEF, gapC), ar.nc);
    let nre = maxi(explicitCount(d, rowsL, fs, UNDEF, 0.0), ar.nr);
    let ext = gridPlace(d, st, b0, cnt, nce, nre, d.css.get(st, P_GRID_FLOW).i);
    let cx = gridAxis(d, colsL, trackList(d, st, P_GRID_ACOLS), nce, ext.nc, fs, UNDEF, gapC);
    gridCollapse(d, cx, b0, cnt, true);
    gridContrib(d, cx, b0, cnt, true);
    let mx = gridSize(d, cx);
    let mn: f32 = 0.0;
    let present = 0;
    for t in 0..cx.n {
        if d.gs[cx.o + 4 * cx.n + t] < 0.0 {
            continue;
        }
        present += 1;
        let tr = trkAt(d, colsL, cx.als, t, nce, fs, UNDEF);
        mn += if tr.minK == V_PX { tr.minV } else { d.gs[cx.o + cx.n + t] };
    }
    if present > 1 {
        mn += gapC * f32(present - 1);
    }
    d.gTop = g0;
    d.fiTop = b0;
    return Size { x: mn, y: mx };
}
