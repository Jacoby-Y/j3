// Part of j3.ui.dom (Inline line boxes: box items and item placement.); the module doc and `use`s are in ../dom.j3.
module j3.ui.dom;

/// Bookkeeping of the open inline boxes for a placed item (fragment `fid`).
fn boxItem(d: &Dom, s: &Ifc, fid: int) {
    let acc: f32 = 0.0;
    let k = d.ob.len - 1;
    while k >= s.obBase {
        let b = &d.ob.items[k];
        if !b.used {
            b.segL = acc + b.lpad;
            acc += b.lead;
            b.used = true;
            b.first = true;
            b.fa = fid;
        } else if b.fa < 0 {
            // a continuation piece reaches back over the cloned left edges of the boxes inside it
            b.segL = if b.cl { acc + b.lpad } else { acc };
            if b.cl { acc += b.lpad; }
            b.first = false;
            b.fa = fid;
        }
        b.fb = fid;
        k -= 1;
    }
}

/// The line is positioned: turn this line's inline-box pieces (finished ones in `Dom.pseg`, open ones cut at the
/// line end) into rects on the owner's box chain, outer boxes first. `base` is the baseline.
fn flushBoxes(d: &Dom, s: &Ifc, base: f32) {
    // innermost first: a box cut here also covers the right edges of the boxes inside it (cloned ones, and ones closed after the last item)
    let k = d.ob.len - 1;
    let inner: f32 = s.trailAcc;
    while k >= s.obBase {
        let b = &d.ob.items[k];
        if b.fa >= 0 {
            if b.cl { inner += b.rpad; }
            d.pseg.push(BSeg { node: b.node, seq: b.seq, fa: b.fa, fb: b.fb, left: b.segL, right: inner, first: b.first, last: false, sh: b.sh, vm: b.vm, cl: b.cl });
            b.fa = -1;
            b.fb = -1;
        }
        k -= 1;
    }
    // insertion sort by open order
    let i = s.psBase + 1;
    while i < d.pseg.len {
        let j = i;
        while j > s.psBase && d.pseg.items[j - 1].seq > d.pseg.items[j].seq {
            let t = d.pseg.items[j - 1];
            d.pseg.items[j - 1] = d.pseg.items[j];
            d.pseg.items[j] = t;
            j -= 1;
        }
        i += 1;
    }
    let tail = d.nodes.items[s.owner].fragTail;
    for q in s.psBase..d.pseg.len {
        let sg = d.pseg.items[q];
        let foundA = false;
        let foundB = false;
        let ax: f32 = 0.0;
        let bx: f32 = 0.0;
        let fbl: f32 = 0.0;
        let f = s.line0;
        while f >= 0 {
            let fr = &d.frags.items[f];
            if f == sg.fa {
                foundA = true;
                ax = fr.x;
                fbl = (if fr.kind == 0 { fr.y + fr.asc } else { fr.y + fr.ap }) + fr.sh;
            }
            if f == sg.fb { foundB = true; bx = fr.x + fr.w; }
            if f == tail { break; }
            f = fr.next;
        }
        if foundA {
            let right = sg.right;
            let last = sg.last;
            if !foundB {
                bx = d.frags.items[tail].x + d.frags.items[tail].w;
                right = 0.0;
                last = false;
            }
            let st = d.nodes.items[sg.node].style;
            let e = edgesOf(d, st, d.nodes.items[sg.node].basisW);
            let font = fontOf(d, st);
            // a box in a `top` / `bottom` group follows its first fragment's group baseline, any other the line's; both raised by `sh`
            let y0 = (if sg.vm != 0 { fbl - sg.sh } else { base - sg.sh }) - f32(fontAscent(font)) - e.pt - e.bt;
            addBox(d, s.owner, Frag { node: sg.node, kind: 2, x: ax - sg.left, y: y0, w: bx + right - (ax - sg.left),
                start: if sg.first || sg.cl { 1 } else { 0 }, end: if last || sg.cl { 1 } else { 0 },
                ap: f32(fontLine(font)) + e.pt + e.pb + e.bt + e.bb, dp: 0.0, asc: 0.0, ell: -1.0, next: -1, sh: 0.0, vm: 0, grp: 0 });
        }
    }
    d.pseg.len = s.psBase;
}

/// Whether an inline element has a box: edges that take room in the line, or anything that paints around its text.
fn inlineDeco(d: &Dom, st: int, e: Edges): bool {
    if e.ml != 0.0 || e.mr != 0.0 || e.bl != 0.0 || e.br != 0.0 || e.pl != 0.0 || e.pr != 0.0 {
        return true;
    }
    if e.bt > 0.0 || e.bb > 0.0 || e.pt != 0.0 || e.pb != 0.0 || ca(colorOf(d, st, P_BACKGROUND)) > 0 {
        return true;
    }
    return d.css.get(st, P_BG_IMAGE).kind != V_NONE || d.css.get(st, P_BOX_SHADOW).kind == V_SHADOW;
}

/// Place something `ww` wide: `ap`/`dp` are its parts above and below the baseline.
fn placeItem(d: &Dom, s: &Ifc, node: int, kind: int, a: int, b: int, ww: f32, ap: f32, dp: f32, asc: f32) {
    if s.stopped { return; }
    let sp: f32 = 0.0;
    if s.has && s.pend {
        sp = s.pendW;
    }
    if s.mode == 1 {
        s.maxW = max(s.maxW, ww + max(s.lead, s.cll) + s.tr + s.clr);
        s.lead = 0.0;
        s.pend = false;
        return;
    }
    if s.mode == 2 {
        s.x += sp + s.lead + ww;
        s.lead = 0.0;
        s.maxW = max(s.maxW, s.x);
        s.has = true;
        s.pend = false;
        return;
    }
    if s.has && !s.nowrap && s.x + sp + s.lead + ww + s.tr + s.clr > s.avail + 0.01 {
        endLine(d, s, true, true);
        if s.stopped { return; }
        sp = 0.0;
    }
    // A collapsed interword space owns its stretched geometry for paint, picking and selection.
    if s.align == TEXT_JUSTIFY && kind == 0 && sp > 0.0 && s.pendNode >= 0 {
        let gap = addFrag(d, s.owner, Frag { node: s.pendNode, kind: 0, x: s.x, y: 0.0, w: sp, start: s.pendAt, end: s.pendAt + 1, ap: ap, dp: dp, asc: asc, ell: -1.0, next: -1, sh: s.sh, vm: s.vm, grp: s.grp });
        if s.line0 < 0 { s.line0 = gap; }
    }
    if !s.has {
        // a `clone` box continuing from the line before opens again with its padding and border
        let k = s.obBase;
        while k < d.ob.len {
            let ob = &d.ob.items[k];
            if ob.used && ob.fa < 0 && ob.cl { s.lead += ob.lpad; }
            k += 1;
        }
    }
    let merged = false;
    if kind == 0 && !s.preserve && s.align != TEXT_JUSTIFY && s.has && s.lastNode == node && s.lastFrag >= 0 && s.lastEnd + 1 == a {
        let nb = &d.nodes.items[node];
        if nb.buf[a - 1] == 32 {
            let fl = &d.frags.items[s.lastFrag];
            fl.w += sp + ww;
            fl.end = b;
            merged = true;
        }
    }
    if !merged {
        let fid = addFrag(d, s.owner, Frag { node: node, kind: kind, x: s.x + sp + s.lead, y: 0.0, w: ww, start: a, end: b, ap: ap, dp: dp, asc: asc, ell: -1.0, next: -1, sh: s.sh, vm: s.vm, grp: s.grp });
        if s.line0 < 0 {
            s.line0 = fid;
        }
        s.lastFrag = fid;
    }
    s.lastNode = node;
    s.lastEnd = b;
    if d.ob.len > s.obBase {
        boxItem(d, s, s.lastFrag);
    }
    s.x += sp + s.lead + ww;
    s.lead = 0.0;
    s.trailAcc = 0.0;
    s.has = true;
    s.pend = false;
    if s.vm != 0 {
        s.al = true;
    } else {
        s.ca = max(s.ca, ap + s.sh);
        s.cd = max(s.cd, dp - s.sh);
    }
}

/// How far `vertical-align` raises an element's baseline above its parent's (`s.pst`): `ap`/`dp` are its parts above and below
/// its baseline, `lh` its line-height. `top` / `bottom` are the caller's (they sit against the line box).
fn raiseOf(d: &Dom, s: &Ifc, st: int, ap: f32, dp: f32, lh: f32): f32 {
    let v = d.css.get(st, P_VALIGN);
    if v.kind == V_PX { return v.f; }
    if v.kind == V_PCT { return lh * v.f / 100.0; }
    if v.kind != V_KW || v.i < 3 { return 0.0; }
    let pf = fontOf(d, s.pst);
    let psz = d.css.get(s.pst, P_FONT_SIZE).f;
    let pa = f32(fontAscent(pf));
    if v.i == 3 { return psz * 0.25 - (ap - dp) / 2.0; }
    if v.i == 4 { return pa - ap; }
    if v.i == 5 { return dp - (f32(fontLine(pf)) - pa); }
    if v.i == 6 { return 0.0 - (psz / 5.0 + 1.0); }
    return psz / 3.0 + 1.0;
}

/// Enter an element's `vertical-align` (its parts `ap`/`dp` above and below its baseline): sets `s.sh` / `s.vm` for what it holds.
fn enterAlign(d: &Dom, s: &Ifc, st: int, ap: f32, dp: f32, lh: f32) {
    let v = d.css.get(st, P_VALIGN);
    if v.kind == V_KW && (v.i == 1 || v.i == 2) && s.vm == 0 {
        // the outermost `top` / `bottom` element is one box: its fragments align as a group (a nested one is a plain raise of 0)
        s.vm = v.i;
        s.sh = 0.0;
        s.gseq += 1;
        s.grp = s.gseq;
    } else {
        s.sh += raiseOf(d, s, st, ap, dp, lh);
    }
}

/// A forced line break (`white-space: pre-line`): an empty line when nothing is on this one.
fn ifcNewline(d: &Dom, s: &Ifc, ap: f32, dp: f32) {
    if s.mode == 0 {
        if !s.has {
            s.has = true;
            s.ca = max(s.ca, ap);
            s.cd = max(s.cd, dp);
        }
        endLine(d, s, true, false);
        if s.preserve && !s.stopped { s.has = true; s.ca = ap; s.cd = dp; }
    } else if s.mode == 2 {
        s.maxW = max(s.maxW, s.x);
        s.x = 0.0;
        s.has = false;
    }
    s.pend = false;
}

/// A word wider than the line (`overflow-wrap: break-word`): it starts a line of its own and is cut
/// between code points, as many as fit on each line.
fn ifcBreakWord(d: &Dom, s: &Ifc, id: int, font: Font, bold: bool, a0: int, b: int, ap: f32, dp: f32, asc: f32) {
    let whole = shownText(d, id);
    if s.has {
        endLine(d, s, true, true);
    }
    let a = a0;
    while a < b && !s.stopped {
        let cut = fitPrefix(font, bold, whole[a..b], s.avail);
        if cut == 0 {
            cut = cpLen(whole[a..b], 0);
        }
        placeItem(d, s, id, 0, a, a + cut, textWidth(font, whole[a..a + cut], bold), ap, dp, asc);
        a += cut;
        if a < b {
            endLine(d, s, true, true);
        }
    }
}
