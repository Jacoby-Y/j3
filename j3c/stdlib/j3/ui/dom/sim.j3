// Part of j3.ui.dom (frame clock, simulated input, pads, nav, inspector); the module doc and `use`s are in ../dom.j3. `Dom` methods in an `extend Dom` block.
module j3.ui.dom;

extend Dom {
    /// How long the loop may sleep after this frame, in ms: 0 for a frame now (motion, `requestFrame`, a held button or key, a pending
    /// tooltip, ripples or fade-outs, a `<canvas>` whose draws differ from last frame's, the inspector, fake input), else the time to the caret's next blink edge, else
    /// `game.IDLE_FOREVER`. `endFrame` hands it to `game.idleReport`. Anything else with a timer is caught by the loop's own cap.
    fn idleMs(this: &Dom): int {
        if this.wantsFrame() || this.canvasLive || this.simOn || this.simKOn || this.insp { return 0; }
        if this.down || this.rdown || this.mdown || this.holdId >= 0 || this.kbWait > 0 || this.rip.n > 0 || this.ghosts > 0 { return 0; }
        if this.tipNode >= 0 && this.now - this.tipT0 < uastyle.tipDelay(this.css) + 200.0 { return 0; }
        for i in 0..22 {
            if this.kbd.held[i] { return 0; }
        }
        if this.focus >= 0 && this.nodes.items[this.focus].edit >= 0 {
            let t = &this.eds.items[this.nodes.items[this.focus].edit];
            return 530 - int(this.now - t.t0) % 530;
        }
        return game.IDLE_FOREVER;
    }

    /// Feed synthetic mouse input (position in px, left button) instead of the real mouse, from the
    /// next `beginFrame`. `wheel` is added once. A click is a frame with `down` then one without.
    fn simInput(this: &Dom, x: f32, y: f32, down: bool, wheel: f32) {
        this.simOn = true;
        this.simX = x;
        this.simY = y;
        this.simDown = down;
        this.simWheel = this.simWheel + wheel;
    }

    /// Feed a synthetic keyboard to the next `beginFrame` (once): `typed` text and key names such as
    /// `"S+Left C+a Backspace"` (`j3.ui.keys.parse`). Headless tests and `UI_SIM`.
    fn simKeys(this: &Dom, typed: string, names: string) {
        this.simK = keys.parse(names, typed);
        this.simKOn = true;
    }

    /// Feed the gamepad (`j3.ui.padin.parse`, or a `PadRaw` from an action-set layer or Steam Input) instead of polling `j3.game`, from the
    /// next frame on and until `usePad(false)`. It is a state, not an event: it holds until you call this again.
    fn setPad(this: &Dom, p: PadRaw) {
        this.padOn = true;
        this.padRaw = p;
    }

    /// `false`: poll `j3.game` for pads again after `setPad`.
    fn usePad(this: &Dom, on: bool) {
        this.padOn = on;
        if !on { this.padRaw = PadRaw {}; }
    }

    /// The pad a `<glyph>` draws: `"xbox"` (default), `"playstation"`, `"nintendo"` or `"generic"` (anything else warns and keeps xbox).
    fn setGlyphStyle(this: &Dom, name: string) {
        glyphSetStyle(this, name);
    }

    /// Bind `action` (a name `<glyph action="...">` uses) to the key label `key` ("Space") and the pad button `pad` ("a", "b", "x", "y",
    /// "lb", "rb", "lt", "rt", "up", "down", "left", "right", "start", "select", "ls", "rs"); "" keeps the built-in for that device. A rebinding screen calls this.
    fn setGlyphBinding(this: &Dom, action: string, key: string, pad: string) {
        glyphBind(this, action, key, pad);
    }

    /// `<glyph action key pad>`: set the shown device and label of the element `id` just opened (generated code).
    fn glyph(this: &Dom, id: int, action: string, key: string, pad: string) {
        glyphBuild(this, id, action, key, pad);
    }

    /// `focus-group` (`"wrap"`, `"trap"`, `"arrows"`, one or more) or `nav-up|down|left|right` (`which` 0 group, 1 up, 2 down, 3 left, 4 right):
    /// static strings (`j3.ui.padnav`).
    fn attrNav(this: &Dom, id: int, which: int, s: string) {
        id = this.resolve(id);
        if id == STALE { return; }
        // the update walk sets it every frame: nothing to do (and nothing allocated) when it is the same
        if same(this.navOf(id, which), s) { return; }
        let n = &this.nodes.items[id];
        let t = Text.new(this.mem);
        let i = 0;
        let cur = ([]u8 { ptr: n.navBuf.ptr, len: n.navLen }) as string;
        for f in 0..5 {
            let j = i;
            while j < cur.len && cur[j] != 59 { j += 1; }
            if f > 0 { t.push(59); }
            if f == which { t.pushStr(s); } else if i <= cur.len { t.pushStr(cur[i..j]); }
            i = j + 1;
        }
        keep(this.mem, &n.navBuf, &n.navLen, t.str());
    }

    /// Field `which` (0 group, 1 up, 2 down, 3 left, 4 right) of `id`'s `focus-group` / `nav-*` attributes ("" for none).
    fn navOf(this: &Dom, id: int, which: int): string {
        id = this.resolve(id);
        if id == STALE { return ""; }
        let n = &this.nodes.items[id];
        let cur = ([]u8 { ptr: n.navBuf.ptr, len: n.navLen }) as string;
        let i = 0;
        for f in 0..5 {
            let j = i;
            while j < cur.len && cur[j] != 59 { j += 1; }
            if f == which { return if i <= cur.len { cur[i..j] } else { "" }; }
            i = j + 1;
        }
        return "";
    }

    /// Turn the inspector (`j3.ui.inspect`) on or off; off by default, and `J3_INSPECT=1` also lets F12 toggle it. While on it takes the
    /// pointer and keys from the app. One bool check per frame when off.
    fn setInspector(this: &Dom, on: bool) {
        this.insp = on;
        this.inspPrev = this.down;
        dropPress(this);
        if !on { this.inspPin = -1; }
    }

    /// Seconds since the previous `beginFrame` (what `onFrame(dt)` gets): 0 on the first frame, at most 0.1,
    /// and exactly the step `setFrameMs` / `J3_FIXED_DT` set.
    fn dt(this: &Dom): f32 {
        if this.frame <= 1 {
            return 0.0;
        }
        return min(this.dtMs / 1000.0, 0.1);
    }
}

