// Per-list state of a virtual list (plan 023 stage 1): the key table and measured heights of every row, the
// window, kept rows and scroll state. The generated component owns one `VList` per `virtual` list and talks to
// it directly (`cfg`, `stale`, `rebuilt`, `at`, `verify`); `j3.ui.vlist` is the part that reads the DOM.

module j3.ui.vstate;

use j3.math.{ floor, maxi };
use j3.memory.{ Arena, List };
use j3.ui.keyed.Keyed;
use j3.ui.virt;
use j3.ui.virt.{ Tree, Win };

/// A virtual list bound this frame: its scroll box (`vlist.step` records it, so `Dom.scrollToKey` finds the list).
pub struct VListRef {
    node: int;
    vl: &VList;
}

pub struct VList {
    /// Settings, written every frame by the generated code: row height (0: measured), the guess before any
    /// row is measured, `stick-to-bottom`.
    rh: f32;
    est: f32;
    stickOn: bool;
    /// `keep={...}`: keys whose rows stay alive outside the window.
    keep: []string;
    /// The key of every row (when `keys`), and the measured heights.
    all: Keyed;
    /// Scratch for `probeOk`.
    pk: Keyed;
    tree: Tree;
    /// Rows the key table describes, and "the window's keys disagree with it" (a same-length edit).
    n: int;
    bad: bool;
    fresh: bool;
    /// The window of the last step, the rows kept outside it (sorted; `nb` of them before it), and how many
    /// rows are alive: `cnt = hi - lo + ex.len`.
    lo: int;
    hi: int;
    nb: int;
    ex: List<int>;
    cnt: int;
    /// `Dom.laid` at the last measurement, and the gap between rows (margin, `gap`) seen there.
    laid: int;
    gap: f32;
    /// Scroll: the offset after the last step, the first visible row and its top, `stick-to-bottom` state,
    /// "at the end" (`bind:at-end`), and a request to jump to the end.
    lastY: f32;
    anchor: int;
    anchorTop: f32;
    stick: bool;
    atEnd: bool;
    toEnd: bool;
    /// Some row is hidden by `finish`.
    hid: bool;
    /// `Dom.scrollToKey`: the row to bring into view (-1 none) and how (`SC_*`), re-aimed each frame until the row is measured.
    want: int;
    wantBlock: int;
    /// Frames spent aiming; the aim is dropped after `WANT_TRIES`.
    wantN: int;

    fn new(mem: &Arena): VList {
        let all = Keyed.new(mem);
        all.warned = true; // the window's own `Keyed` already warns about a repeated key
        let pk = Keyed.new(mem);
        pk.warned = true;
        return VList { rh: 0.0, est: 40.0, stickOn: false, keep: mem.alloc::<string>(0), all: all, pk: pk, tree: Tree.new(mem, 40.0), n: 0, bad: false, fresh: false, lo: 0, hi: 0, nb: 0, ex: List<int>.new(mem), cnt: 0, laid: -1, gap: 0.0, lastY: 0.0, anchor: -1, anchorTop: 0.0, stick: true, atEnd: false, toEnd: false, hid: false, want: -1, wantBlock: 0, wantN: 0 };
    }

    /// Back to a new list (the component was reset).
    fn reset(this: &VList) {
        this.all.reset();
        this.pk.reset();
        this.tree.reset(0);
        this.n = 0;
        this.bad = false;
        this.fresh = false;
        this.lo = 0;
        this.hi = 0;
        this.nb = 0;
        this.ex.len = 0;
        this.cnt = 0;
        this.laid = -1;
        this.anchor = -1;
        this.stick = true;
        this.hid = false;
        this.want = -1;
    }

    /// The generated code calls this every frame with the element's attributes.
    fn cfg(this: &VList, rh: f32, est: f32, stick: bool, keep: bool) {
        this.rh = rh;
        this.est = est;
        this.tree.est = est;
        this.stickOn = stick;
        if !keep {
            this.keep = this.keep[0..0];
        }
    }

    /// The list's length or keys changed since the key table was built: the generated code formats every key
    /// into `all` (O(rows), once per change, never on a steady frame) and calls `rebuilt`.
    fn stale(this: &VList, len: int): bool {
        return this.n != len || this.bad;
    }

    /// The list only grew at its tail? True when it has more rows than the table and the table is not known
    /// bad. The caller then formats the first and last old rows into `pk` and asks `probeOk`.
    fn grew(this: &VList, len: int): bool {
        return this.n > 0 && len > this.n && !this.bad;
    }

    /// `pk` holds the keys of rows 0 and `n - 1` as the list has them now: they must be the table's. (Rows in
    /// between are not checked; an edit there shows up in the window's `verify`, which forces a full rebuild.)
    fn probeOk(this: &VList): bool {
        this.pk.finish("");
        return this.pk.cn == 2 && this.pk.sameAs(0, &this.all, 0) && this.pk.sameAs(1, &this.all, this.n - 1);
    }

    /// The tail rows `n..len` were added to the table (`all.push`): extend the heights, keep everything else.
    fn appended(this: &VList, len: int) {
        this.tree.append(len - this.n);
        this.n = len;
    }

    fn rebuilt(this: &VList, len: int) {
        this.n = len;
        this.bad = false;
        this.fresh = this.all.changed;
    }

    /// List index of the `i`-th live row (they are in list order: kept rows before the window, the window,
    /// kept rows after it).
    fn at(this: &VList, i: int): int {
        if i < this.nb {
            return this.ex.items[i];
        }
        if i < this.nb + this.hi - this.lo {
            return this.lo + i - this.nb;
        }
        return this.ex.items[i - (this.hi - this.lo)];
    }

    /// After the window's keys are reconciled (`kd`): they must be the rows `lo..hi` of the key table, else the
    /// list was edited in place and the table is rebuilt next frame.
    fn verify(this: &VList, kd: &Keyed) {
        if this.bad {
            return;
        }
        for t in 0..this.hi - this.lo {
            if this.lo + t >= this.all.cn || !this.all.sameAs(this.lo + t, kd, this.nb + t) {
                this.bad = true;
                return;
            }
        }
    }

    fn pre(this: &VList, i: int): f32 {
        if this.rh > 0.0 {
            return f32(i) * this.rh;
        }
        return this.tree.prefix(i);
    }

    fn rowAt(this: &VList, y: f32): int {
        if this.rh > 0.0 {
            return maxi(0, int(floor(y / this.rh)));
        }
        return this.tree.find(y);
    }
}

/// New index of old row `o` after a rebuild (`from[new] = old`), -1 if it is gone. O(rows), once per change.
pub fn moved(from: &List<int>, o: int): int {
    if o < 0 {
        return -1;
    }
    for q in 0..from.len {
        if from.items[q] == o {
            return q;
        }
    }
    return -1;
}

/// Add list index `i` to the kept rows if it is a row outside the window (sorted insert, no duplicates).
pub fn keepRow(v: &VList, i: int, w: Win) {
    if i < 0 || (i >= w.lo && i < w.hi) {
        return;
    }
    let p = v.ex.len;
    for t in 0..v.ex.len {
        if v.ex.items[t] == i {
            return;
        }
    }
    v.ex.push(i);
    while p > 0 && v.ex.items[p - 1] > i {
        v.ex.items[p] = v.ex.items[p - 1];
        p -= 1;
    }
    v.ex.items[p] = i;
}

