/// Wave text (`text-wave`, a J3 extension; CSS has no per-glyph motion): the vertical lift of each glyph
/// of a run. Pure functions of numbers, so `j3.ui.dom` only has to split a run into glyphs and ask
/// `lift` for each one. Cost is one `sin` and one text draw per glyph, so use it on labels.
///
/// A crest moves right: glyph at `x` px is lifted `amplitude * sin(tau * (t / period - x / length))`
/// (negative is up). `x` is measured in the owner's box, so neighbouring runs share one wave field.
///
/// ```
/// let dy = textwave.lift(6.0, 90.0, 1400.0, now, glyphX);
/// ```

module j3.ui.textwave;

use j3.math.{ floor, sin };

const TAU: f32 = 6.2831853;

/// True when the three `text-wave-*` values make a visible wave (all positive).
pub fn on(amp: f32, length: f32, period: f32): bool {
    return amp > 0.0 && length > 0.0 && period > 0.0;
}

/// The y offset of a glyph at `x` px, `now` ms into the page clock (`period` in ms, `length` in px).
pub fn lift(amp: f32, length: f32, period: f32, now: f32, x: f32): f32 {
    let turns = now / period - x / length;
    return amp * sin(TAU * (turns - floor(turns)));
}
