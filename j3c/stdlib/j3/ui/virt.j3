// Window of a virtual list (plan 023 stage 1): which rows of a fixed-height `{#each}` are alive.
// Pure arithmetic, no tree, so it is unit-tested alone (`stdlib/tests/virt_test.j3`). `Dom.virtWin`
// feeds it the box's scroll offset and height. Fixed rows use `window`; measured rows use `Tree` / `windowTree`.

module j3.ui.virt;

use j3.math.{ abs, ceil, floor, max, maxi, min, mini };
use j3.memory.{ Arena, List };

/// Rows kept alive above and below the viewport.
pub const OVERSCAN: int = 4;

/// Rows `lo..hi` are alive: `0 <= lo <= hi <= count`. `top` / `bottom` are the px the dead rows above and below
/// would take (the spacers), so the generated code never does row-height arithmetic itself.
pub struct Win {
    lo: int;
    hi: int;
    top: f32;
    bottom: f32;
}

/// The rows that touch a viewport `viewH` px tall scrolled to `scrollY`, plus `over` rows each side.
/// `scrollY` is clamped to the real range first, so a list that shrank under a scrolled-down box still gets a valid window.
pub fn window(count: int, rh: f32, scrollY: f32, viewH: f32, over: int): Win {
    if count <= 0 || rh <= 0.0 {
        return Win { lo: 0, hi: 0, top: 0.0, bottom: 0.0 };
    }
    let s = max(0.0, min(scrollY, f32(count) * rh - viewH));
    let lo = maxi(0, int(floor(s / rh)) - over);
    let hi = mini(count, int(ceil((s + viewH) / rh)) + over);
    if lo > hi {
        lo = hi;
    }
    return Win { lo: lo, hi: hi, top: f32(lo) * rh, bottom: f32(count - hi) * rh };
}

// ---- Variable heights (plan 023 chunk 1c) -------------------------------------------------------------------
// `Tree` is an array segment tree over the rows: each node holds the sum of the measured heights below it and
// how many rows below it are not measured yet. A row not measured counts as `avg()` (the mean of the measured
// ones, `est` before any), so `prefix` (px above row i) and `find` (row at a px offset) are O(log n), `set` (a
// row got measured) is O(log n), and `remap` (the list changed) is O(n). No bit tricks: the language has none.

pub struct Tree {
    mem: &Arena;
    n: int;
    size: int;
    /// Node sums of measured heights, and unmeasured row counts (node 1 is the root; leaves at `size + i`).
    s: List<f32>;
    u: List<int>;
    /// Measured height per row, -1 for not measured yet (`h2` is the scratch of `remap`).
    h: List<f32>;
    h2: List<f32>;
    /// Guess for a row before any is measured.
    est: f32;

    fn new(mem: &Arena, est: f32): Tree {
        return Tree { mem: mem, n: 0, size: 1, s: List<f32>.new(mem), u: List<int>.new(mem), h: List<f32>.new(mem), h2: List<f32>.new(mem), est: est };
    }

    /// `n` rows, none measured.
    fn reset(this: &Tree, n: int) {
        this.h.len = 0;
        for i in 0..n {
            this.h.push(-1.0);
        }
        this.n = n;
        this.build();
    }

    /// Rebuild every node from `h`. O(size).
    fn build(this: &Tree) {
        let size = 1;
        while size < this.n {
            size = size * 2;
        }
        this.size = size;
        this.s.len = 0;
        this.u.len = 0;
        for i in 0..2 * size {
            this.s.push(0.0);
            this.u.push(0);
        }
        for i in 0..this.n {
            if this.h.items[i] >= 0.0 {
                this.s.items[size + i] = this.h.items[i];
            } else {
                this.u.items[size + i] = 1;
            }
        }
        let p = size - 1;
        while p >= 1 {
            this.s.items[p] = this.s.items[2 * p] + this.s.items[2 * p + 1];
            this.u.items[p] = this.u.items[2 * p] + this.u.items[2 * p + 1];
            p -= 1;
        }
    }

    /// `k` more rows at the end, none measured. O(k log n), plus O(size) when the tree has to double.
    fn append(this: &Tree, k: int) {
        for t in 0..k {
            this.h.push(-1.0);
            this.n += 1;
            if this.n > this.size {
                this.build();
            } else {
                let p = this.size + this.n - 1;
                this.u.items[p] = 1;
                p = p / 2;
                while p >= 1 {
                    this.u.items[p] = this.u.items[2 * p] + this.u.items[2 * p + 1];
                    p = p / 2;
                }
            }
        }
    }

    /// Mean height of a row: the measured mean, `est` before any (never below 1 px, so windows stay finite).
    fn avg(this: &Tree): f32 {
        let known = this.n - this.u.items[1];
        let a = this.est;
        if known > 0 {
            a = this.s.items[1] / f32(known);
        }
        return max(a, 1.0);
    }

    fn total(this: &Tree): f32 {
        if this.n == 0 {
            return 0.0;
        }
        return this.s.items[1] + this.avg() * f32(this.u.items[1]);
    }

    fn isKnown(this: &Tree, i: int): bool {
        return this.h.items[i] >= 0.0;
    }

    /// Row `i` measured `v` px. True when that changed what the tree knows (by more than a hair).
    fn set(this: &Tree, i: int, v: f32): bool {
        let old = this.h.items[i];
        if old >= 0.0 && abs(old - v) < 0.05 {
            return false;
        }
        this.h.items[i] = v;
        let p = this.size + i;
        this.s.items[p] = v;
        this.u.items[p] = 0;
        p = p / 2;
        while p >= 1 {
            this.s.items[p] = this.s.items[2 * p] + this.s.items[2 * p + 1];
            this.u.items[p] = this.u.items[2 * p] + this.u.items[2 * p + 1];
            p = p / 2;
        }
        return true;
    }

    /// Px above row `i` (`i == n` is the total).
    fn prefix(this: &Tree, i: int): f32 {
        let a = this.avg();
        let sum: f32 = 0.0;
        let l = this.size;
        let r = this.size + mini(maxi(i, 0), this.n);
        while l < r {
            if l % 2 == 1 {
                sum += this.s.items[l] + a * f32(this.u.items[l]);
                l += 1;
            }
            if r % 2 == 1 {
                r -= 1;
                sum += this.s.items[r] + a * f32(this.u.items[r]);
            }
            l = l / 2;
            r = r / 2;
        }
        return sum;
    }

    /// The row that covers px offset `y` (0 for an empty tree; the last row for `y` past the end).
    fn find(this: &Tree, y: f32): int {
        if this.n == 0 {
            return 0;
        }
        let a = this.avg();
        let node = 1;
        let base = 0;
        let span = this.size;
        while node < this.size {
            let l = 2 * node;
            let ls = this.s.items[l] + a * f32(this.u.items[l]);
            span = span / 2;
            if y < ls {
                node = l;
            } else {
                y -= ls;
                node = l + 1;
                base += span;
            }
        }
        return mini(base, this.n - 1);
    }

    /// The list now has `from.len` rows and new row `q` was row `from[q]` (-1: new). Measured heights follow.
    fn remap(this: &Tree, from: &List<int>) {
        this.h2.len = 0;
        for q in 0..from.len {
            let f = from.items[q];
            this.h2.push(if f >= 0 { this.h.items[f] } else { -1.0 });
        }
        let t = this.h;
        this.h = this.h2;
        this.h2 = t;
        this.n = from.len;
        this.build();
    }
}

/// The window of rows near a viewport, from measured heights. Same contract as `window`.
pub fn windowTree(t: &Tree, scrollY: f32, viewH: f32, over: int): Win {
    let count = t.n;
    if count <= 0 {
        return Win { lo: 0, hi: 0, top: 0.0, bottom: 0.0 };
    }
    let total = t.total();
    let s = max(0.0, min(scrollY, total - viewH));
    let lo = maxi(0, t.find(s) - over);
    let hi = mini(count, t.find(s + viewH) + 1 + over);
    if lo > hi {
        lo = hi;
    }
    let top = t.prefix(lo);
    return Win { lo: lo, hi: hi, top: top, bottom: total - t.prefix(hi) };
}

/// Where the scroll offset goes this frame. `y` is where the box is now (the user may have scrolled since
/// `last`, the offset this function returned the frame before), `shift` is how far the anchor row (the first
/// visible row of last frame) moved since then because rows above it were measured, inserted or removed,
/// `total` / `viewH` give the end. Anchoring adds `shift` so the visible rows stay put; `stick`
/// (`stick-to-bottom`, `want`) pins to the end while at the end, is released when the user scrolls up, and
/// re-engages on reaching the end again. Returns the new offset and the new `stick`.
pub struct Follow {
    y: f32;
    stick: bool;
}

pub fn follow(y: f32, last: f32, shift: f32, total: f32, viewH: f32, stick: bool, want: bool): Follow {
    let end = max(0.0, total - viewH);
    if want {
        if stick && y < min(last, end) - 1.0 {
            stick = false;
        } else if !stick && y >= end - 1.0 {
            stick = true;
        }
    } else {
        stick = false;
    }
    if stick {
        return Follow { y: end, stick: true };
    }
    return Follow { y: max(0.0, min(y + shift, end)), stick: false };
}
