/// The color picker's math: `#rrggbb` text, HSV, and the panel (a saturation/value
/// square, a hue bar, a preview and the hex text). No Dom: `j3.ui.dropdown` owns the open state and the
/// drags. A color is `r * 65536 + g * 256 + b` in an `int`; hue is 0..360, saturation and value 0..1.

module j3.ui.colorpick;

use j3.game.Color;
use j3.math.{ max, min };
use j3.text.Text;

/// Panel size and the square / hue bar inside it (panel-local px).
pub const W: f32 = 200.0;
pub const H: f32 = 196.0;
const PAD: f32 = 10.0;
const SQ_W: f32 = 180.0;
const SQ_H: f32 = 120.0;
const BAR_Y: f32 = 138.0;
const BAR_H: f32 = 14.0;

pub struct Hsv {
    h: f32;
    s: f32;
    v: f32;
}

fn hexVal(b: u8): int {
    if b >= 48 && b <= 57 {
        return int(b) - 48;
    }
    if b >= 97 && b <= 102 {
        return int(b) - 87;
    }
    if b >= 65 && b <= 70 {
        return int(b) - 55;
    }
    return -1;
}

/// `#rrggbb` or `#rgb` (the `#` optional) as a color, or -1 when `s` is not one.
pub fn parseHex(s: string): int {
    let t = s;
    if t.len > 0 && t[0] == 35 {
        t = t[1..t.len];
    }
    if t.len != 6 && t.len != 3 {
        return -1;
    }
    let v = 0;
    for i in 0..t.len {
        let d = hexVal(t[i]);
        if d < 0 {
            return -1;
        }
        if t.len == 3 {
            v = v * 256 + d * 17;
        } else {
            v = v * 16 + d;
        }
    }
    return v;
}

/// Replace the contents of `out` with `#rrggbb`.
pub fn writeHex(rgb: int, out: &Text) {
    let digits = "0123456789abcdef";
    out.clear();
    out.push(35);
    let sh = 20;
    while sh >= 0 {
        let div = 1;
        for i in 0..sh {
            div = div * 2;
        }
        out.push(digits[(rgb / div) % 16]);
        sh -= 4;
    }
}

/// HSV of a color.
pub fn toHsv(rgb: int): Hsv {
    let r = f32(rgb / 65536) / 255.0;
    let g = f32((rgb / 256) % 256) / 255.0;
    let b = f32(rgb % 256) / 255.0;
    let mx = max(r, max(g, b));
    let mn = min(r, min(g, b));
    let d = mx - mn;
    let h: f32 = 0.0;
    if d > 0.0 {
        if mx == r {
            h = 60.0 * ((g - b) / d);
            if h < 0.0 {
                h += 360.0;
            }
        } else if mx == g {
            h = 60.0 * ((b - r) / d + 2.0);
        } else {
            h = 60.0 * ((r - g) / d + 4.0);
        }
    }
    let s: f32 = 0.0;
    if mx > 0.0 {
        s = d / mx;
    }
    return Hsv { h: h, s: s, v: mx };
}

fn chan(v: f32): int {
    return int(max(0.0, min(1.0, v)) * 255.0 + 0.5);
}

/// The color of `h` (degrees), `s` and `v` (0..1).
pub fn fromHsv(h: f32, s: f32, v: f32): int {
    let hh = h;
    while hh >= 360.0 {
        hh -= 360.0;
    }
    while hh < 0.0 {
        hh += 360.0;
    }
    let sec = int(hh / 60.0);
    let f = hh / 60.0 - f32(sec);
    let p = v * (1.0 - s);
    let q = v * (1.0 - s * f);
    let t = v * (1.0 - s * (1.0 - f));
    let r = v;
    let g = t;
    let b = p;
    if sec == 1 {
        r = q; g = v; b = p;
    } else if sec == 2 {
        r = p; g = v; b = t;
    } else if sec == 3 {
        r = p; g = q; b = v;
    } else if sec == 4 {
        r = t; g = p; b = v;
    } else if sec == 5 {
        r = v; g = p; b = q;
    }
    return chan(r) * 65536 + chan(g) * 256 + chan(b);
}

/// As a paint color.
pub fn color(rgb: int): Color {
    return Color { r: u8(rgb / 65536), g: u8((rgb / 256) % 256), b: u8(rgb % 256), a: 255 };
}

/// What a panel-local point is over: 1 the saturation/value square, 2 the hue bar, 0 neither.
pub fn zone(x: f32, y: f32): int {
    if x >= PAD && x < PAD + SQ_W && y >= PAD && y < PAD + SQ_H {
        return 1;
    }
    if x >= PAD && x < PAD + SQ_W && y >= BAR_Y && y < BAR_Y + BAR_H {
        return 2;
    }
    return 0;
}

/// Saturation at panel-local x, clamped to the square.
pub fn satAt(x: f32): f32 {
    return max(0.0, min(1.0, (x - PAD) / SQ_W));
}

/// Value at panel-local y (top is 1), clamped to the square.
pub fn valAt(y: f32): f32 {
    return 1.0 - max(0.0, min(1.0, (y - PAD) / SQ_H));
}

/// Hue at panel-local x, clamped to the bar.
pub fn hueAt(x: f32): f32 {
    return max(0.0, min(1.0, (x - PAD) / SQ_W)) * 359.9;
}
