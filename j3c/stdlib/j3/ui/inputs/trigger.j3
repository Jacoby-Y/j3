// Part of j3.ui.inputs; Keyboard activation of buttons and links. The module doc and `use`s are in ../inputs.j3.
module j3.ui.inputs;

fn isSpaceByte(b: u8): bool {
    return b == 32 || b == 10 || b == 9;
}

fn hasByte(set: string, b: u8): bool {
    for i in 0..set.len {
        if set[i] == b {
            return true;
        }
    }
    return false;
}

/// The trigger the caret of text box `id` is in: a trigger character (`triggers`) at the start of the text or after
/// whitespace, then non-space bytes up to the caret, none of them in a token. Returns its start, -1 for none; it ends at the caret.
fn findTrigger(d: &Dom, id: int, e: &Edit): int {
    let s = e.str();
    let set = d.nodes.items[id].trigs;
    let c = e.cur;
    if e.hasSel() || c > s.len || d.kin.comp.len > 0 {
        return -1;
    }
    let i = c;
    while i > 0 && c - i < 48 {
        let b = s[i - 1];
        if isSpaceByte(b) {
            return -1;
        }
        if hasByte(set, b) && (i == 1 || isSpaceByte(s[i - 2])) {
            for k in 0..e.sp.len {
                let t = e.sp.items[k];
                if spans.isToken(t.kind) && t.start < c && t.start + t.len > i - 1 {
                    return -1;
                }
            }
            return i - 1;
        }
        i -= 1;
    }
    return -1;
}

/// Follow the trigger of the focused text box (`on:trigger`): it starts, changes with each edit, and ends when the caret
/// leaves it, the box loses focus, or Escape dismissed it (`d.trigSup`: the same trigger stays quiet until it ends).
fn trigger(d: &Dom) {
    let f = d.focus;
    let lo = -1;
    if f >= 0 && alive(d, f) && isField(d, f) && !isDisabled(d, f) && d.nodes.items[f].trigs.len > 0 && d.nodes.items[f].edit >= 0 {
        lo = findTrigger(d, f, &d.eds.items[d.nodes.items[f].edit]);
    }
    if lo >= 0 && f == d.trigSupNode && lo == d.trigSup {
        lo = -1;
    } else {
        d.trigSup = -1;
        d.trigSupNode = -1;
    }
    if d.trigNode >= 0 && d.trigNode != f {
        // focus moved to another box: the old box gets its end event first, the new trigger starts next frame (one event slot)
        d.trigEv = d.trigNode;
        d.trigChg = d.frame;
        d.trigNode = -1;
        return;
    }
    if lo < 0 {
        if d.trigNode >= 0 {
            d.trigEv = d.trigNode;
            d.trigChg = d.frame;
            d.trigNode = -1;
        }
        return;
    }
    let hi = d.eds.items[d.nodes.items[f].edit].cur;
    if d.trigNode != f || d.trigLo != lo || d.trigHi != hi || d.nodes.items[f].chg == d.frame {
        d.trigNode = f;
        d.trigLo = lo;
        d.trigHi = hi;
        d.trigEv = f;
        d.trigChg = d.frame;
    }
}

