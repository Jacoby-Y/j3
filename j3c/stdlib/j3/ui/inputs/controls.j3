// Part of j3.ui.inputs; Labels, radio groups and `<details>`. The module doc and `use`s are in ../inputs.j3.
module j3.ui.inputs;

fn labelable(d: &Dom, id: int): bool {
    let t = d.nodes.items[id].tag;
    return d.nodes.items[id].kind == dom.K_ELEM && (t == d.tButton || t == d.tInput || t == d.tSelect);
}

/// The control a `<label>` activates, -1 for none: the element whose static `id` is its `for` (anywhere in the tree, the first in tree
/// order), else the first control inside it.
/// Once per id: `label for` found two elements with this id (it uses the first), in `css.warns` like other runtime authoring mistakes.
fn warnDup(d: &Dom, id: string) {
    let m = Text.new(d.mem);
    m.pushStr("duplicate id \"");
    m.pushStr(id);
    m.pushStr("\": a label's for= uses the first");
    for i in 0..d.css.warns.len {
        if same(d.css.warns.items[i].msg, m.str()) { return; }
    }
    d.css.warns.push(Warning { file: "label for:", line: 1, col: 1, msg: m.str() });
}

fn labelTarget(d: &Dom, label: int): int {
    let want = d.forOf(label);
    let c = d.nodes.items[label].first;
    if want.len > 0 { c = d.nodes.items[0].first; }
    // pre-order walk below the start (the label itself, or the root)
    let top = if want.len > 0 { 0 } else { label };
    let found = -1;
    while c >= 0 {
        let m = &d.mnodes.items[c];
        if d.nodes.items[c].kind == dom.K_ELEM {
            if want.len > 0 {
                if m.id >= 0 && same(d.css.name(m.id), want) {
                    if found >= 0 {
                        warnDup(d, want);
                        return found;
                    }
                    found = if labelable(d, c) { c } else { -1 };
                    if found < 0 { return -1; }
                }
            } else if labelable(d, c) {
                return c;
            }
        }
        let n = &d.nodes.items[c];
        if n.first >= 0 {
            c = n.first;
        } else {
            while c >= 0 && c != top && d.nodes.items[c].next < 0 { c = d.nodes.items[c].parent; }
            if c < 0 || c == top { return found; }
            c = d.nodes.items[c].next;
        }
    }
    return -1;
}

/// A click on a `<label>` (not on a control inside it, which takes its own) goes to its control: a checkbox toggles, a radio checks and a button is
/// clicked (`d.clickTo`: `clicked` is true for it as well as for the label), a text box, range or select takes focus. Not for a
/// disabled control; a drag already cleared `clickNode`.
fn labelClick(d: &Dom) {
    let c = d.clickNode;
    let label = -1;
    while c >= 0 && label < 0 {
        if labelable(d, c) { return; }
        if d.nodes.items[c].tag == d.tLabel { label = c; }
        c = d.nodes.items[c].parent;
    }
    if label < 0 { return; }
    let t = labelTarget(d, label);
    if t < 0 || isDisabled(d, t) || !dom.styleVisible(d, t) || !dom.allowedByModal(d, t) { return; }
    if isFocusable(d, t) { d.focusNode(t); }
    if d.nodes.items[t].tag == d.tButton || d.mnodes.items[t].type == d.vCheckbox || dom.isRadio(d, t) {
        d.clickTo = t;
    }
}

/// A click on a radio (the mouse, a label that points at it, Space or Enter on it) checks it and unchecks the rest of its group; the one
/// that became checked has `changed`, every one that flipped has `userToggled`. A disabled radio is not checkable.
fn radioClick(d: &Dom) {
    for i in 0..2 {
        let t = if i == 0 { d.clickNode } else { d.clickTo };
        if t >= 0 && t < d.nodes.len && dom.isRadio(d, t) && !isDisabled(d, t) && dom.styleVisible(d, t) && dom.allowedByModal(d, t) {
            dom.radioSet(d, t, true, true);
        }
    }
}

/// Arrow keys on a focused radio: Up / Left go to the previous radio of its group, Down / Right to the next (wrapping, skipping disabled
/// ones); focus moves and the radio there is checked.
fn radioKeys(d: &Dom, f: int) {
    if d.kin.shift || d.kin.ctrl { return; }
    let dir = if d.kin.up || d.kin.left { -1 } else if d.kin.down || d.kin.right { 1 } else { 0 };
    if dir == 0 { return; }
    let t = dom.radioNeighbor(d, f, dir);
    d.focusNode(t);
    dom.radioSet(d, t, true, true);
}

/// A click (mouse, or Enter / Space on the focused summary) on a `<summary>` flips its `<details>`: `:open`, `toggled`. A control inside the
/// summary takes the click for itself.
fn toggleDetails(d: &Dom) {
    let c = d.clickNode;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.tag == d.tButton || n.tag == d.tInput || n.tag == d.tSelect {
            return;
        }
        if n.tag == d.tSummary {
            let p = n.parent;
            if p >= 0 && d.nodes.items[p].tag == d.tDetails {
                d.setOpen(p, !d.isOpen(p));
                d.nodes.items[p].togAt = d.frame;
                d.nodes.items[p].clkAt = d.frame;
            }
            return;
        }
        c = n.parent;
    }
}
