// Part of j3.ui.inputs; Range input press, drag and keys. The module doc and `use`s are in ../inputs.j3.
module j3.ui.inputs;

fn rangePress(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    if n.multi {
        let x = d.mx - d.absX(id);
        d.thumb = slider.pickThumb(x, n.w, n.h, n.attrMin, n.attrMax, n.value, n.high);
    } else {
        d.thumb = 0;
    }
}

/// Set the thumb in use to `v` (two thumbs never cross); a change counts as user input.
fn setThumb(d: &Dom, id: int, v: f32) {
    let n = &d.nodes.items[id];
    let old = if d.thumb == 1 { n.high } else { n.value };
    let nv = v;
    if n.multi && d.thumb == 0 && nv > n.high {
        nv = n.high;
    }
    if n.multi && d.thumb == 1 && nv < n.value {
        nv = n.value;
    }
    if nv == old {
        return;
    }
    if d.thumb == 1 {
        n.high = nv;
    } else {
        n.value = nv;
    }
    n.chg = d.frame;
    dom.aNote(d, dom.EV_VALUE, id);
}

fn rangeDrag(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    setThumb(d, id, slider.fromX(d.mx - d.absX(id), n.w, n.h, n.attrMin, n.attrMax, n.attrStep));
}

/// Arrow keys step the thumb (Shift: ten steps), Home / End jump to the ends.
fn rangeKeys(d: &Dom, id: int) {
    let k = &d.kin;
    let n = &d.nodes.items[id];
    let cur = if d.thumb == 1 && n.multi { n.high } else { n.value };
    let dir = 0;
    if k.left || k.down { dir = -1; }
    if k.right || k.up { dir = 1; }
    if dir != 0 {
        setThumb(d, id, slider.nudge(cur, n.attrMin, n.attrMax, n.attrStep, dir, k.shift));
    }
    if k.home { setThumb(d, id, n.attrMin); }
    if k.end { setThumb(d, id, slider.snap(n.attrMax, n.attrMin, n.attrMax, n.attrStep)); }
}
