// Part of j3.ui.inputs; Focus visibility and Tab navigation. The module doc and `use`s are in ../inputs.j3.
module j3.ui.inputs;

fn alive(d: &Dom, id: int): bool {
    return id >= 0 && id < d.nodes.len && d.nodes.items[id].kind == dom.K_ELEM;
}

/// React to focus having moved since the last frame: text boxes get their buffer and SDL text input.
fn seeFocus(d: &Dom) {
    if d.focus == d.seen {
        return;
    }
    let old = d.seen;
    d.seen = d.focus;
    if alive(d, old) {
        if isField(d, old) && d.nodes.items[old].edit >= 0 {
            let e = &d.eds.items[d.nodes.items[old].edit];
            e.vs = 0;
            e.anc = e.cur;
        }
        if d.pop.owner == old {
            d.pop = popup.closed();
        }
    }
    let f = d.focus;
    textHooks(d, f);
    // stopping first cancels an IME composition begun in the box we left
    game.textInput(false);
    game.takeKeys(false);
    if f >= 0 && alive(d, f) && d.nodes.items[f].tag == d.tInput && isField(d, f) {
        let ed = &d.eds.items[d.claim(f)];
        ed.set(d.nodes.items[f].sval);
        ed.t0 = d.now;
        if d.nodes.items[f].fSel {
            // a dialog's `autoselect`: only the focus it gave on open
            d.nodes.items[f].fSel = false;
            ed.selectAll();
        }
        d.nodes.items[f].sval = ed.str();
        startTyping(d);
    } else if f >= 0 && alive(d, f) && d.nodes.items[f].tag == d.tSelect {
        // type-ahead picks an option by its first letters
        startTyping(d);
    } else if f >= 0 && d.isGrid(f) && alive(d, f) {
        // typing on a grid cell starts its editor
        startTyping(d);
    } else if f >= 0 && alive(d, f) {
        let c = d.nodes.items[f].parent;
        while c >= 0 {
            if d.nodes.items[c].ov == dom.OV_POPOVER { startTyping(d); break; }
            c = d.nodes.items[c].parent;
        }
    }
}

/// 0 single line, 1 multi line, 2 email, 3 number for a text box; -1 for anything else.
fn textKind(d: &Dom, id: int): int {
    if !alive(d, id) || d.nodes.items[id].tag != d.tInput || !isField(d, id) {
        return -1;
    }
    let t = d.mnodes.items[id].type;
    if t == d.vTextarea { return 1; }
    if t == d.css.intern("email") { return 2; }
    if t == d.css.intern("number") { return 3; }
    return 0;
}

/// Tell the `setTextFocusHook` / `setTextBlurHook` functions about a focus change (edge: `seeFocus` runs it once per change).
fn textHooks(d: &Dom, f: int) {
    let kind = textKind(d, f);
    if kind >= 0 {
        if FOCUS_HOOK as int != 0 {
            let r = game.screenRect();
            let n = &d.nodes.items[f];
            let p = toWindow(r, d.absX(f), d.absY(f));
            let hook = FOCUS_HOOK as fn(int, int, int, int, int);
            hook(int(p.x + 0.5), int(p.y + 0.5), int(n.w * r.s + 0.5), int(n.h * r.s + 0.5), kind);
        }
        HOOKED = true;
    } else if HOOKED {
        HOOKED = false;
        if BLUR_HOOK as int != 0 {
            let hook = BLUR_HOOK as fn();
            hook();
        }
    }
}

/// Text input on, and game code's `keyDown`/`keyPressed` read false until the focus leaves (`Dom.takeKeys`).
fn startTyping(d: &Dom) {
    game.textInput(true);
    if d.takeKeys { game.takeKeys(true); }
}

fn focusable(d: &Dom, id: int): bool {
    return dom.tabStop(d, id) && dom.allowedByModal(d, id);
}

/// The next node after `id` in document order (-1 at the end).
fn succ(d: &Dom, id: int): int {
    let n = &d.nodes.items[id];
    if n.first >= 0 {
        return n.first;
    }
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].next >= 0 {
            return d.nodes.items[c].next;
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Tab order key: positive `tabindex` first (ascending), then the rest.
fn tabKey(d: &Dom, id: int): int {
    let t = d.nodes.items[id].tabIdx;
    return if t > 0 { t } else { 2000000000 };
}

/// Tab (`dir` 1) and Shift+Tab (-1): focus the next focusable element, wrapping. Order is (positive `tabindex`
/// ascending, then the rest), ties in document order. Two O(n) walks and no allocation; Tab is rare.
/// Starting point: the focused node's place in the order, even when Tab skips it (`tabindex="-1"`), so Tab goes to the next one
/// after it; with no focus, or a focus that was removed, Tab starts at the first and Shift+Tab at the last. A `focus-group="trap"`
/// holding the focus keeps Tab inside it, like the pad.
fn tab(d: &Dom, dir: int) {
    if d.nodes.len == 0 {
        return;
    }
    dom.radioMark(d);
    let f = d.focus;
    let has = f >= 0 && alive(d, f);
    let fk = if has { tabKey(d, f) } else { 0 };
    // the focus's place in document order
    let fpos = -1;
    if has {
        let w = 0;
        let q = 0;
        while w >= 0 && w != f {
            w = succ(d, w);
            q += 1;
        }
        if w == f { fpos = q; }
    }
    let after = fpos >= 0;
    let trap = if after { padnav.groupWith(d, f, "trap") } else { -1 };
    let best = -1;     // nearest candidate past the focus in direction `dir`
    let bk = 0;
    let bp = 0;
    let wrap = -1;     // the far end, for wrapping
    let wk = 0;
    let wp = 0;
    let c = 0;
    let p = 0;
    while c >= 0 {
        if focusable(d, c) && (trap < 0 || dom.inside(d, trap, c)) {
            let k = tabKey(d, c);
            let gt = k > fk || (k == fk && p > fpos);
            let lt = k < fk || (k == fk && p < fpos);
            let past = if !after { false } else if dir > 0 { gt } else { lt };
            let beats = if dir > 0 { k < bk || (k == bk && p < bp) } else { k > bk || (k == bk && p > bp) };
            if past && (best < 0 || beats) { best = c; bk = k; bp = p; }
            let far = if dir > 0 { k < wk || (k == wk && p < wp) } else { k > wk || (k == wk && p > wp) };
            if wrap < 0 || far { wrap = c; wk = k; wp = p; }
        }
        c = succ(d, c);
        p += 1;
    }
    // no focus: start at the first (Tab) or last (Shift+Tab); past the end: wrap
    let to = if best >= 0 { best } else { wrap };
    if to >= 0 && to != f {
        d.focusNode(to);
    }
}

