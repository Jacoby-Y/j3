// Part of j3.ui.inputs; Text box geometry, keys and mouse. The module doc and `use`s are in ../inputs.j3.
module j3.ui.inputs;

/// The box's content origin: (left edge, width) in node-local px.
fn contentX(d: &Dom, id: int): f32 {
    let e = edgesOf(d, d.nodes.items[id].style, d.nodes.items[id].basisW);
    return e.bl + e.pl;
}

fn contentW(d: &Dom, id: int): f32 {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, n.style, n.basisW);
    let w = n.w - e.pl - e.pr - e.bl - e.br;
    if d.mnodes.items[id].type == d.vSearch {
        w -= 18.0;
    }
    return w;
}

fn contentY(d: &Dom, id: int): f32 {
    let e = edgesOf(d, d.nodes.items[id].style, d.nodes.items[id].basisW);
    return e.bt + e.pt;
}

fn contentH(d: &Dom, id: int): f32 {
    let n = &d.nodes.items[id];
    let e = edgesOf(d, n.style, n.basisW);
    return n.h - e.pt - e.pb - e.bt - e.bb;
}

fn touched(d: &Dom, id: int, e: &Edit) {
    d.nodes.items[id].sval = e.str();
    d.nodes.items[id].chg = d.frame;
    dom.aNote(d, dom.EV_VALUE, id);
    d.syncPlaceholder(id);
    e.t0 = d.now;
}

/// The byte nearest to local `x`, `y` in the text box (a password counts bullets, a textarea lines).
fn hit(d: &Dom, id: int, e: &Edit, x: f32, y: f32): int {
    let tm = enterText(d, d.nodes.items[id].style);
    let at = hitIn(d, id, e, x, y);
    leaveText(tm);
    return at;
}

fn hitIn(d: &Dom, id: int, e: &Edit, x: f32, y: f32): int {
    let st = d.nodes.items[id].style;
    let font = fontOf(d, st);
    let bold = isBold(d, st);
    let ty = d.mnodes.items[id].type;
    if ty == d.vTextarea {
        area.layout(e, font, bold, contentW(d, id));
        return area.indexAt(e, font, bold, x, y);
    }
    if ty == d.vPassword {
        let s = e.str();
        return textedit.fromMask(s, field.indexAt(font, bold, e.maskOf(s), e.vs, x));
    }
    return field.indexAt(font, bold, e.str(), e.vs, x);
}

/// Typing, deleting, caret keys and the clipboard on the focused text box. A textarea also takes Enter
/// (a newline; Ctrl+Enter submits), Up, Down, PageUp, PageDown and line Home / End; a password box
/// neither copies nor cuts. While the IME is composing, only its committed text is taken.
fn textKeys(d: &Dom, id: int) {
    let k = &d.kin;
    let n = &d.nodes.items[id];
    let e = &d.eds.items[d.claim(id)];
    let ty = d.mnodes.items[id].type;
    let multi = ty == d.vTextarea;
    let before = e.text.len();
    e.maxlen = n.maxlen;
    if k.comp.len > 0 {
        // text committed in the same poll that a new composition began still counts
        if k.typed.len > 0 {
            e.paste(k.typed);
            touched(d, id, e);
        }
        return;
    }
    if k.ctrl && k.a {
        e.selectAll();
    } else if k.ctrl && k.c {
        if e.hasSel() && ty != d.vPassword {
            game.setClipboard(e.selected());
        }
    } else if k.ctrl && k.x {
        if e.hasSel() && ty != d.vPassword {
            game.setClipboard(e.selected());
            e.deleteSel();
            touched(d, id, e);
        }
    } else if k.ctrl && k.v {
        let clip = game.clipboard();
        if clip.len > 0 {
            e.paste(clip);
            touched(d, id, e);
        }
    } else if k.ctrl && (k.y || (k.z && k.shift)) {
        if e.redo() {
            touched(d, id, e);
        }
    } else if k.ctrl && k.z {
        if e.undo() {
            touched(d, id, e);
        }
    } else if k.ctrl && (k.b || k.i) {
        // rich textarea only: toggles bold / italic on the selection
        if e.toggle(if k.b { spans.SPAN_BOLD } else { spans.SPAN_ITALIC }) {
            touched(d, id, e);
        }
    }
    if k.typed.len > 0 {
        e.insert(k.typed);
        touched(d, id, e);
    }
    if k.back {
        e.deleteBack(k.ctrl);
        if e.text.len() != before {
            touched(d, id, e);
        }
    }
    if k.del {
        e.deleteFwd(k.ctrl);
        if e.text.len() != before {
            touched(d, id, e);
        }
    }
    if k.left { e.left(k.shift, k.ctrl); e.t0 = d.now; }
    if k.right { e.right(k.shift, k.ctrl); e.t0 = d.now; }
    if multi {
        let st = n.style;
        let font = fontOf(d, st);
        let bold = isBold(d, st);
        let tm = enterText(d, st);
        area.layout(e, font, bold, contentW(d, id));
        let page = int(contentH(d, id) / f32(fontLine(font))) - 1;
        if page < 1 {
            page = 1;
        }
        if k.up { area.moveV(e, font, bold, -1, k.shift); e.t0 = d.now; }
        if k.down { area.moveV(e, font, bold, 1, k.shift); e.t0 = d.now; }
        if k.pgup { area.moveV(e, font, bold, 0 - page, k.shift); e.t0 = d.now; }
        if k.pgdn { area.moveV(e, font, bold, page, k.shift); e.t0 = d.now; }
        if k.home { e.moveTo(if k.ctrl { 0 } else { e.ls.items[area.caretLine(e)] }, k.shift); e.t0 = d.now; }
        if k.end { e.moveTo(if k.ctrl { e.text.len() } else { area.lineEnd(e, area.caretLine(e)) }, k.shift); e.up = e.cur; e.fcur = -1; e.t0 = d.now; }
        leaveText(tm);
    } else {
        if k.home { e.moveTo(0, k.shift); e.t0 = d.now; }
        if k.end { e.moveTo(e.text.len(), k.shift); e.t0 = d.now; }
    }
    if k.enter {
        if multi && !k.ctrl {
            e.insert("\n");
            touched(d, id, e);
        } else {
            n.sub = d.frame;
            if !n.fSub {
                overlays.defaultClick(d, id);
            }
        }
    }
    if k.esc && d.mnodes.items[id].type == d.vSearch && e.text.len() > 0 {
        e.set("");
        touched(d, id, e);
    }
}

/// Press, drag and the search box's clear button. Presses in quick succession on one spot select a word
/// (a whole password), then a line (all of a single-line box).
fn textMouse(d: &Dom, id: int) {
    let down = d.downHit == id && d.downBtn == 0;
    let drag = d.dragNode == id && d.down && !down;
    if !down && !drag {
        return;
    }
    let n = &d.nodes.items[id];
    let st = n.style;
    let font = fontOf(d, st);
    let ty = d.mnodes.items[id].type;
    let e = &d.eds.items[d.claim(id)];
    let x = d.mx - d.absX(id) - contentX(d, id);
    let y = d.my - d.absY(id) - contentY(d, id);
    let cw = contentW(d, id);
    let s = e.str();
    if down && ty == d.vSearch && s.len > 0 && x > cw {
        e.set("");
        touched(d, id, e);
        return;
    }
    e.t0 = d.now;
    if drag && ty != d.vTextarea {
        // past an edge the caret walks one code point a frame, which scrolls the view
        if x < 0.0 {
            e.moveTo(e.prev(e.cur), true);
        } else if x > cw {
            e.moveTo(e.next(e.cur), true);
        } else {
            e.moveTo(hit(d, id, e, x, y), true);
        }
        return;
    }
    let i = hit(d, id, e, x, y);
    if drag {
        e.moveTo(i, true);
        return;
    }
    let again = d.now - e.ct < 400.0 && (i == e.ci || (e.clicks >= 2 && i >= e.lo() && i <= e.hi()));
    e.clicks = if again && e.clicks < 3 { e.clicks + 1 } else { 1 };
    e.ct = d.now;
    e.ci = i;
    if e.clicks == 1 {
        e.moveTo(i, d.kin.shift);
    } else if e.clicks == 2 && ty != d.vPassword {
        e.selectWord(i);
    } else if ty == d.vTextarea {
        e.selectLine(i);
    } else {
        e.selectAll();
    }
}

/// Once a selection settles (the mouse goes up after a press in the box, Ctrl+A, a Shift+caret key), put it on PRIMARY.
/// A password box and a `noprimary` box never do.
fn primarySettle(d: &Dom, id: int) {
    let e = &d.eds.items[d.claim(id)];
    if e.noprim || !e.hasSel() || d.mnodes.items[id].type == d.vPassword {
        return;
    }
    let k = &d.kin;
    let up = !d.down && d.prevDown && d.dragNode == id;
    let keys = (k.ctrl && k.a) || (k.shift && (k.left || k.right || k.up || k.down || k.home || k.end || k.pgup || k.pgdn));
    if up || keys {
        d.setPrimary(e.selected());
    }
}

/// A middle press on an enabled text box: focus it, put the caret at the click and insert PRIMARY there (like Ctrl+V: one undo
/// step, `maxlength`, `on:input`). A `noprimary` box ignores it.
fn middlePaste(d: &Dom, r: int) {
    if r < 0 || !dom.allowedByModal(d, r) {
        return;
    }
    let id = dom.focusableAt(d, r);
    if id < 0 || !isField(d, id) || isDisabled(d, id) {
        return;
    }
    let e = &d.eds.items[d.claim(id)];
    if e.noprim {
        return;
    }
    d.focusNode(id);
    let x = d.mx - d.absX(id) - contentX(d, id);
    let y = d.my - d.absY(id) - contentY(d, id);
    e.moveTo(hit(d, id, e, x, y), false);
    e.t0 = d.now;
    let s = d.primary();
    if s.len > 0 {
        e.maxlen = d.nodes.items[id].maxlen;
        e.paste(s);
        touched(d, id, e);
    }
}

