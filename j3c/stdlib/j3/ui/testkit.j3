/// Headless UI tests driven by fake input, frame by frame. Call these every frame from your draw hook with the
/// current frame number `f`; each acts only on its own frame(s), so a script is a list of calls.
///
///     testkit.clickText(d, f, 3, "Size");      // press on frames 3..5 (move, down, up); check on frame 6
///     testkit.typeInto(d, f, 18, "input", 0, "ro");   // click the first <input> on 18..20, type on 21
///     testkit.simKeys(d, f, 33, "", "C+a Backspace"); // several key names in one frame (`j3.ui.keys.parse`)
///     if testkit.hasText(d, "Saved") { .. }
///
///     testkit.padPress(d, f, 40, "Down"); // pad buttons: Up Down Left Right A B LB RB LT RT SUp.. RUp RDown; padHold(d, f, a, b, ..)
///     testkit.dragText(d, f, 3, "Sword", "Slot 2");   // drag an item onto another element: frames 3..8; check on 9
///
/// A target that is not there is a miss: it prints `testkit: frame N: no text "X"` (or `... is hidden or off screen`)
/// and counts in `misses()`, so a test can fail on it instead of clicking nothing. One missing target is ONE miss:
/// the click helpers report on the first frame it fails and skip the same failure on the next frame (a target
/// found at `f0` that is gone later counts once too). Read `misses()` at the end, or `resetMisses()` between suites.
///
/// Matching: `textNode` / `hasText` / `clickText` take a text node whose whole text equals the argument (not a
/// substring, and not text split over several nodes such as `Rename {name}`: look for a part, or use `clickTag`).
/// The first match in tree order wins when the text appears twice; `display: none` and fading-out nodes are never
/// matched, so a closed popup's text is not found. A click also needs the target to have a size and to overlap the window (the press
/// point is pulled inside the window); a node clipped by a scroll container is not detected. Frame numbers are the caller's;
/// a modal that fades in needs about 8 frames before clicks land. Main thread only.

module j3.ui.testkit;

use j3.io.printLn;
use j3.math.{ max, min };
use j3.text.same;
use j3.ui.padin;
use j3.ui.dom.{ Dom, K_ELEM, K_TEXT, DP_NONE, styleVisible };

#[singleton]
let MISSES: int;
#[singleton]
let LAST: int = -10;
#[singleton]
let LASTF0: int = -10;

/// How many targets were not found so far.
pub fn misses(): int {
    return MISSES;
}

/// Start counting again from 0 (between suites that share a program).
pub fn resetMisses() {
    MISSES = 0;
    LAST = -10;
    LASTF0 = -10;
}

/// Count a miss unless this click's failure was already counted on the frame before (same `f0`).
fn miss(f: int, f0: int, why: string, kind: string, what: string) {
    if !(f != f0 && LAST == f - 1 && LASTF0 == f0) {
        MISSES += 1;
        if what.len == 0 {
            printLn(`testkit: frame {f}: {why} {kind}`);
        } else {
            printLn(`testkit: frame {f}: {why} {kind} "{what}"`);
        }
    }
    LAST = f;
    LASTF0 = f0;
}

/// Whether the node (and every ancestor) is laid out and not fading out.
fn shown(d: &Dom, id: int): bool {
    if !styleVisible(d, id) { return false; }
    let c = id;
    while c >= 0 {
        if d.nodes.items[c].disp == DP_NONE || d.nodes.items[c].ghost {
            return false;
        }
        c = d.nodes.items[c].parent;
    }
    return true;
}

/// The first text node with exactly this text (-1 when there is none).
pub fn textNode(d: &Dom, want: string): int {
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_TEXT && same(d.textOf(i), want) && shown(d, i) {
            return i;
        }
    }
    return -1;
}

/// The first text node with exactly this text inside an element tagged `within`, such as `"dialog"` (-1 when none).
pub fn textNodeIn(d: &Dom, within: string, want: string): int {
    let w = d.tag(within);
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_TEXT && same(d.textOf(i), want) && shown(d, i) {
            let p = d.nodes.items[i].parent;
            while p >= 0 {
                if d.nodes.items[p].tag == w {
                    return i;
                }
                p = d.nodes.items[p].parent;
            }
        }
    }
    return -1;
}

/// The k-th element with this tag in tree order (-1 when there is none).
pub fn tagNode(d: &Dom, tag: string, k: int): int {
    let t = d.tag(tag);
    let seen = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_ELEM && d.nodes.items[i].tag == t && shown(d, i) {
            if seen == k {
                return i;
            }
            seen += 1;
        }
    }
    return -1;
}

pub fn hasText(d: &Dom, want: string): bool {
    return textNode(d, want) >= 0;
}

pub fn countText(d: &Dom, want: string): int {
    let n = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == K_TEXT && same(d.textOf(i), want) && shown(d, i) {
            n += 1;
        }
    }
    return n;
}

/// Move, press and release over node `id` on frames `f0`, `f0 + 1`, `f0 + 2` (nothing on other frames).
/// A negative, hidden, zero-size or off-screen `id` is a miss and sends no input.
pub fn click(d: &Dom, f: int, f0: int, id: int) {
    press(d, f, f0, id, `node #{id}`, "");
}

fn press(d: &Dom, f: int, f0: int, id: int, kind: string, what: string) {
    if f < f0 || f > f0 + 2 {
        return;
    }
    if id < 0 {
        miss(f, f0, "no", kind, what);
        return;
    }
    // a text node may have no box of its own: the element holding it must
    let e = id;
    if d.nodes.items[id].kind == K_TEXT && d.nodes.items[id].parent >= 0 {
        e = d.nodes.items[id].parent;
    }
    let ax = d.absX(e);
    let ay = d.absY(e);
    let n = &d.nodes.items[e];
    if !shown(d, id) || n.w <= 0.0 || n.h <= 0.0 || ax + n.w <= 0.0 || ay + n.h <= 0.0 || ax >= d.vw || ay >= d.vh {
        miss(f, f0, "hidden or off screen:", kind, what);
        return;
    }
    // just inside the box's corner, pulled into the window when the box sticks out of it
    let x = max(0.0, min(d.absX(id) + 3.0, d.vw - 1.0));
    let y = max(0.0, min(d.absY(id) + 3.0, d.vh - 1.0));
    d.simInput(x, y, f == f0 + 1, 0.0);
}

/// Click the element showing exactly this text.
pub fn clickText(d: &Dom, f: int, f0: int, text: string) {
    press(d, f, f0, textNode(d, text), "text", text);
}

/// Click the text inside an element tagged `within` (a `"dialog"`, say), not a same-named text elsewhere.
pub fn clickTextIn(d: &Dom, f: int, f0: int, within: string, text: string) {
    press(d, f, f0, textNodeIn(d, within, text), within, text);
}

/// Click the k-th element with this tag.
pub fn clickTag(d: &Dom, f: int, f0: int, tag: string, k: int) {
    press(d, f, f0, tagNode(d, tag, k), "tag", tag);
}

/// Click the k-th element with this tag on `f0..f0 + 2` to focus it, then type `text` on frame `f0 + 3`.
pub fn typeInto(d: &Dom, f: int, f0: int, tag: string, k: int, text: string) {
    clickTag(d, f, f0, tag, k);
    if f == f0 + 3 {
        d.simKeys(text, "");
    }
}

/// On frame `at` only: type `typed` and press the keys in `names`, space separated, all in that one frame
/// (`"C+a C+c"`, `"S+Left Backspace"`; names as in `j3.ui.keys.parse`).
pub fn simKeys(d: &Dom, f: int, at: int, typed: string, names: string) {
    if f == at {
        d.simKeys(typed, names);
    }
}

/// Hold these pad buttons for the frames `from..to` (a press is `from, from + 1`), then release: `"Down"`, `"A"`, `"SRight"`, `"LT"` and so on
/// (`j3.ui.padin.parse`). The pad is a state: every frame in the range sets it, so the repeat clock of a held stick runs.
pub fn padHold(d: &Dom, f: int, from: int, to: int, names: string) {
    if f >= from && f < to {
        d.setPad(padin.parse(names));
    } else if f == to {
        d.setPad(padin.parse(""));
    }
}

/// A one-frame pad press on frame `at`: `padHold(d, f, at, at + 1, names)`.
pub fn padPress(d: &Dom, f: int, at: int, names: string) {
    padHold(d, f, at, at + 1, names);
}

/// Drag node `from` onto node `to` (a drop) on frames `f0..f0 + 5`: move to `from`, press, move 6 px (past the drag slop),
/// move onto `to`, hold one frame (`on:dragover` runs), release. Send Escape on frame `f0 + 4` with `simKeys` to cancel it.
pub fn drag(d: &Dom, f: int, f0: int, from: int, to: int) {
    dragStep(d, f, f0, from, to, false, 0.0, 0.0, `node #{from}`, "");
}

/// Like `drag`, released at the window point `(x, y)`: drop where nothing takes it.
pub fn dragTo(d: &Dom, f: int, f0: int, from: int, x: f32, y: f32) {
    dragStep(d, f, f0, from, -1, true, x, y, `node #{from}`, "");
}

/// Drag the element showing text `from` onto the element showing text `to`.
pub fn dragText(d: &Dom, f: int, f0: int, from: string, to: string) {
    dragStep(d, f, f0, textNode(d, from), textNode(d, to), false, 0.0, 0.0, "text", from);
}

/// Drag the k-th `fromTag` element onto the j-th `toTag` element.
pub fn dragTag(d: &Dom, f: int, f0: int, fromTag: string, k: int, toTag: string, j: int) {
    dragStep(d, f, f0, tagNode(d, fromTag, k), tagNode(d, toTag, j), false, 0.0, 0.0, "tag", fromTag);
}

fn dragStep(d: &Dom, f: int, f0: int, from: int, to: int, pt: bool, px: f32, py: f32, kind: string, what: string) {
    if f < f0 || f > f0 + 5 {
        return;
    }
    if from < 0 || !shown(d, from) || (!pt && (to < 0 || !shown(d, to))) {
        miss(f, f0, "hidden or off screen:", kind, what);
        return;
    }
    let sx = max(0.0, min(d.absX(from) + 3.0, d.vw - 1.0));
    let sy = max(0.0, min(d.absY(from) + 3.0, d.vh - 1.0));
    let tx = px;
    let ty = py;
    if !pt {
        tx = max(0.0, min(d.absX(to) + 3.0, d.vw - 1.0));
        ty = max(0.0, min(d.absY(to) + 3.0, d.vh - 1.0));
    }
    if f == f0 {
        d.simInput(sx, sy, false, 0.0);
    } else if f == f0 + 1 {
        d.simInput(sx, sy, true, 0.0);
    } else if f == f0 + 2 {
        d.simInput(sx + 6.0, sy, true, 0.0);
    } else if f == f0 + 5 {
        d.simInput(tx, ty, false, 0.0);
    } else {
        d.simInput(tx, ty, true, 0.0);
    }
}
