// Part of j3.ui.cssmatch; Custom properties: `var()` lookup, registration, substitution, revert and unset. The module doc and `use`s are in ../cssmatch.j3.
module j3.ui.cssmatch;

/// The declaration (index in `Css.decls`) of custom property `name` (with the `--`) in the newest plain `:root` rule that has it, -1 for none.
fn rootDecl(css: &Css, name: string): int {
    let want = NPROPS + css.intern(name);
    let ri = css.rules.len - 1;
    while ri >= 0 {
        let r = css.rules.items[ri];
        if r.nsteps == 0 {
            // an inline-style rule (`dynattr`), not part of any sheet
            ri -= 1;
            continue;
        }
        let st = css.steps.items[r.step0];
        if r.nsteps == 1 && st.tag < 0 && st.attr < 0 && st.ncls == 0 && hasBit(st.pseudo, PS_ROOT) {
            let d = r.decl0 + r.ndecl - 1;
            while d >= r.decl0 {
                if css.decls.items[d].prop == want {
                    return d;
                }
                d -= 1;
            }
        }
        ri -= 1;
    }
    return -1;
}

/// The number of custom property `name` (with the `--`) declared by the newest plain `:root` rule, or
/// `dflt` when it is absent or not a number. A time (`500ms`, `0.5s`) reads as milliseconds. Needs no node.
pub fn customNum(css: &Css, name: string, dflt: f32): f32 {
    let d = rootDecl(css, name);
    if d >= 0 && css.decls.items[d].v.kind == V_NUM {
        return css.decls.items[d].v.f;
    }
    return dflt;
}

fn fits(cat: int, prop: int, v: &Value): bool {
    if cat == C_COLOR {
        return v.kind == V_COLOR;
    }
    if cat == C_LEN {
        return v.kind == V_PX || v.kind == V_PCT || v.kind == V_AUTO || v.kind == V_CALC || v.kind == V_EM || v.kind == V_REM;
    }
    if cat == C_ANGLE {
        return v.kind == V_ANG;
    }
    if cat == C_NUM {
        return v.kind == V_NUM || (prop == P_LINE_HEIGHT && (v.kind == V_PX || v.kind == V_EM || v.kind == V_REM));
    }
    return false;
}

/// Custom property `name` in set `vs` (or in the set under construction at `vsEnt[vs0..]` when `vs < 0`);
/// kind `V_UNSET` when absent or invalid, `V_VAR` when it still waits for another `var()`.
fn lookupVar(css: &Css, vs: int, vs0: int, name: int): Value {
    let o = vs0;
    let e = css.vsEnt.len;
    if vs >= 0 {
        o = css.vso.items[vs];
        e = o + css.vsn.items[vs];
    }
    for i in o..e {
        if css.vsEnt.items[i].name == name {
            if css.vsEnt.items[i].v.kind != V_UNSET {
                return css.vsEnt.items[i].v;
            }
            break;
        }
    }
    return regInit(css, name);
}

/// The initial value of `@property`-registered custom property `name` (`V_UNSET` when it is not registered or has none).
fn regInit(css: &Css, name: int): Value {
    if css.regs.len > 0 {
        let r = css.regOf(name);
        if r >= 0 {
            return css.regs.items[r].init;
        }
    }
    return unset();
}

/// Custom property `name` in set `vs` as an element sees it, with the registered initial value when the set lacks it.
pub fn varValue(css: &Css, vs: int, name: int): Value {
    return lookupVar(css, vs, 0, name);
}

/// What `var()` value `v` is in set `vs` / `vs0` (see `lookupVar`). For property `prop` (-1 for the
/// value of a custom property) the found value must have the property's type (a fallback is already
/// typed). Result `V_UNSET`: invalid, skip the declaration. `V_VAR`: waits for another custom property.
pub fn resolveVar(css: &Css, prop: int, vs: int, vs0: int, v: Value): Value {
    let e = lookupVar(css, vs, vs0, v.i);
    if e.kind == V_VAR {
        return v;
    }
    if e.kind != V_UNSET {
        if prop < 0 || prop >= NPROPS {
            return e;
        }
        if fits(catOf(prop), prop, &e) {
            if e.kind == V_ANG {
                return Value { kind: V_NUM, f: e.f, i: 0, c: 0 };
            }
            return e;
        }
        return unset();
    }
    if v.c > 0 {
        let fb = css.fbs.items[v.c - 1];
        if fb.kind == V_VAR {
            return resolveVar(css, prop, vs, vs0, fb);
        }
        return fb;
    }
    return unset();
}

/// What the declaration `prop: v` sets under parent style `parent`, with custom property set `vs`:
/// `var()` and `inherit` resolved. Kind `V_UNSET` means skip it (an unknown or ill-typed `var()`).
pub fn declValue(css: &Css, prop: int, v: Value, parent: int, vs: int): Value {
    if v.kind == V_VAR {
        v = resolveVar(css, prop, vs, 0, v);
    }
    if prop < 0 || prop >= NPROPS {
        return v;
    }
    if v.kind == V_INHERIT {
        if parent >= 0 {
            return css.vals.items[parent * NPROPS + prop];
        }
        return initial(prop);
    }
    if v.kind == V_INITIAL {
        return initial(prop);
    }
    if v.kind == V_UNSETKW || v.kind == V_REVERT {
        // `revert` only reaches here where there is no earlier origin to return to (`cascade` looks that up first)
        if parent >= 0 && inherits(prop) {
            return css.vals.items[parent * NPROPS + prop];
        }
        return initial(prop);
    }
    return v;
}

/// `revert` of property `prop` in rule `ids[off + m]`: the last tag-default (or popup) declaration of it among the matched rules
/// `ids[off..off + nm]`, else `unset`. A rule that is itself built in has nothing earlier: `unset`.
fn revertValue(css: &Css, ids: []int, off: int, nm: int, m: int, prop: int, parent: int, vs: int): Value {
    let v = Value { kind: V_UNSETKW, f: 0.0, i: 0, c: 0 };
    let ri = ids[off + m];
    if ri >= css.uaLo && ri < css.uaHi {
        return declValue(css, prop, v, parent, vs);
    }
    for j in 0..nm {
        let uj = ids[off + j];
        if uj < css.uaLo || uj >= css.uaHi {
            continue;
        }
        let r = css.rules.items[uj];
        for d in 0..r.ndecl {
            let dc = css.decls.items[r.decl0 + d];
            if dc.prop == prop {
                v = dc.v;
            }
        }
    }
    return declValue(css, prop, v, parent, vs);
}

fn unset(): Value {
    return Value { kind: V_UNSET, f: 0.0, i: 0, c: 0 };
}

/// The custom property set of a style that declares `--x` in its matched rules (`css.midx[0..nm]`) on top
/// of its parent's set `base`: a copy of `base` with the new values, last declaration winning. Values that
/// are `var()`s are resolved against the set itself, so order does not matter and a cycle stays invalid.
fn ownVars(css: &Css, nm: int, base: int, parent: int): int {
    let n0 = css.vsEnt.len;
    let fs: f32 = 16.0;
    if parent >= 0 {
        fs = css.vals.items[parent * NPROPS + P_FONT_SIZE].f;
    }
    for i in 0..css.vsn.items[base] {
        let ce = css.vsEnt.items[css.vso.items[base] + i];
        if css.noInh > 0 && !inheritsVar(css, ce.name) {
            continue;
        }
        css.vsEnt.push(ce);
    }
    for m in 0..nm {
        let r = css.rules.items[css.midx[m]];
        for d in 0..r.ndecl {
            let dc = css.decls.items[r.decl0 + d];
            if dc.prop < NPROPS {
                continue;
            }
            let dv = dc.v;
            if dv.kind == V_INITIAL {
                // the guaranteed-invalid value: `lookupVar` then reads the registered initial-value, if any
                dv = unset();
            } else if dv.kind == V_INHERIT || dv.kind == V_UNSETKW || dv.kind == V_REVERT {
                dv = unset();
                if dc.v.kind == V_INHERIT || inheritsVar(css, dc.prop - NPROPS) {
                    // the parent's value (its set is `base`, which also holds the ones that do not inherit)
                    for i in 0..css.vsn.items[base] {
                        let be = css.vsEnt.items[css.vso.items[base] + i];
                        if be.name == dc.prop - NPROPS {
                            dv = be.v;
                        }
                    }
                }
            } else if css.regs.len > 0 && dv.kind != V_VAR {
                // a registered property takes only values of its type; a bad declaration is dropped
                let rg = css.regOf(dc.prop - NPROPS);
                if rg >= 0 {
                    dv = coerceSyn(css, css.regs.items[rg].syn, dv, fs);
                    if dv.kind == V_UNSET {
                        continue;
                    }
                }
            }
            let at = n0;
            while at < css.vsEnt.len && css.vsEnt.items[at].name != dc.prop - NPROPS {
                at += 1;
            }
            if at == css.vsEnt.len {
                css.vsEnt.push(Custom { name: dc.prop - NPROPS, v: dv });
            } else {
                css.vsEnt.items[at].v = dv;
            }
        }
    }
    // resolve var() values; each pass settles at least one or stops
    let changed = true;
    while changed {
        changed = false;
        for i in n0..css.vsEnt.len {
            let v = css.vsEnt.items[i].v;
            if v.kind == V_VAR {
                let rv = resolveVar(css, -1, -1, n0, v);
                if rv.kind != V_VAR || rv.i != v.i || rv.c != v.c {
                    css.vsEnt.items[i].v = rv;
                    changed = true;
                }
            }
        }
    }
    // still waiting: a cycle
    for i in n0..css.vsEnt.len {
        if css.vsEnt.items[i].v.kind == V_VAR {
            css.vsEnt.items[i].v = unset();
        }
        if css.regs.len > 0 && css.vsEnt.items[i].v.kind != V_UNSET {
            // a `var()` that resolved to a value of the wrong type
            let rj = css.regOf(css.vsEnt.items[i].name);
            if rj >= 0 {
                css.vsEnt.items[i].v = coerceSyn(css, css.regs.items[rj].syn, css.vsEnt.items[i].v, fs);
            }
        }
    }
    css.vso.push(n0);
    css.vsn.push(css.vsEnt.len - n0);
    return css.vso.len - 1;
}

/// False for a registered custom property with `inherits: false`.
fn inheritsVar(css: &Css, name: int): bool {
    let r = css.regOf(name);
    return r < 0 || css.regs.items[r].inh;
}

/// Does set `vs` hold a registered property that does not inherit?
fn hasNoInherit(css: &Css, vs: int): bool {
    for i in 0..css.vsn.items[vs] {
        if !inheritsVar(css, css.vsEnt.items[css.vso.items[vs] + i].name) {
            return true;
        }
    }
    return false;
}

/// Write custom property value `e` as CSS text; false for a kind that has no spelling here.
pub fn pushValue(t: &Text, e: Value): bool {
    if e.kind == V_COLOR {
        let hex = "0123456789abcdef";
        t.push(35);
        for sh in 0..4 {
            let b = (e.c / (if sh == 0 { 16777216 } else if sh == 1 { 65536 } else if sh == 2 { 256 } else { 1 })) % 256;
            t.push(hex[b / 16]);
            t.push(hex[b % 16]);
        }
    } else if e.kind == V_CURRENT {
        t.pushStr("currentcolor");
    } else if e.kind == V_NUM {
        t.pushFloat(e.f);
    } else if e.kind == V_ANG {
        t.pushFloat(e.f);
        t.pushStr("deg");
    } else if e.kind == V_PX || e.kind == V_PCT || e.kind == V_EM || e.kind == V_REM {
        t.pushFloat(e.f);
        t.pushStr(if e.kind == V_PX { "px" } else if e.kind == V_PCT { "%" } else if e.kind == V_EM { "em" } else { "rem" });
    } else if e.kind == V_AUTO {
        t.pushStr("auto");
    } else {
        return false;
    }
    return true;
}

pub fn isNameChar(c: int): bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95;
}

/// `src` with every `var(--x)` / `var(--x, fallback)` replaced by custom property `--x` of set `vs` (or the
/// fallback text, itself substituted). False when one has neither or the value has no spelling.
fn substVars(css: &Css, src: string, vs: int, t: &Text, depth: int): bool {
    let i = 0;
    while i < src.len {
        let c = int(src[i]);
        if c != 118 || i + 4 > src.len || !same(src[i..i + 4], "var(") || (i > 0 && isNameChar(int(src[i - 1]))) {
            t.push(src[i]);
            i += 1;
            continue;
        }
        let j = i + 4;
        while j < src.len && int(src[j]) == 32 {
            j += 1;
        }
        let ns = j;
        while j < src.len && isNameChar(int(src[j])) {
            j += 1;
        }
        if j - ns <= 2 || int(src[ns]) != 45 || int(src[ns + 1]) != 45 || depth > 8 {
            return false;
        }
        let name = css.intern(src[ns..j]);
        while j < src.len && int(src[j]) == 32 {
            j += 1;
        }
        let fb0 = -1;
        let fb1 = -1;
        if j < src.len && int(src[j]) == 44 {
            fb0 = j + 1;
            let d = 1;
            j += 1;
            while j < src.len && d > 0 {
                if int(src[j]) == 40 { d += 1; }
                if int(src[j]) == 41 { d -= 1; }
                j += 1;
            }
            if d > 0 {
                return false;
            }
            fb1 = j - 1;
        } else if j < src.len && int(src[j]) == 41 {
            j += 1;
        } else {
            return false;
        }
        if fb0 > fb1 && fb0 >= 0 {
            return false;
        }
        let e = lookupVar(css, vs, 0, name);
        if e.kind == V_URL {
            // quoted, with whichever quote the path does not contain (the lexer has no escapes)
            let path = css.name(e.i);
            let q = if contains(path, "\"") { "'" } else { "\"" };
            if contains(path, q) {
                return false;
            }
            t.pushStr("url(");
            t.pushStr(q);
            t.pushStr(path);
            t.pushStr(q);
            t.push(41);
        } else if e.kind != V_UNSET && e.kind != V_VAR {
            if !pushValue(t, e) {
                return false;
            }
        } else if fb0 >= 0 {
            if !substVars(css, src[fb0..fb1], vs, t, depth + 1) {
                return false;
            }
        } else {
            return false;
        }
        i = j;
    }
    return true;
}
