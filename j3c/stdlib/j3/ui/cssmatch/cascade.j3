// Part of j3.ui.cssmatch; The cascade: deferred values, rule collection and `computeStyle`. The module doc and `use`s are in ../cssmatch.j3.
module j3.ui.cssmatch;

/// The value of keyframe declaration `di` (of `Css.decls`) for property `prop` on an element with custom property set `vs`:
/// a `var()` resolved, a deferred compound value (`P_DEFER`) substituted and parsed again. The deferred ones are cached
/// per (declaration, set) in `Css.kvc`, so a running animation parses nothing. `V_UNSET`: it does not apply to this element.
pub fn stopValue(css: &Css, di: int, prop: int, vs: int): Value {
    let dc = css.decls.items[di];
    if dc.prop != P_DEFER {
        if dc.v.kind != V_VAR {
            return dc.v;
        }
        return declValue(css, prop, dc.v, -1, vs);
    }
    let at = kvSlot(css, di, vs);
    if css.kslots[at] != 0 {
        return css.kvc.items[css.kslots[at] - 1].v;
    }
    let r = unset();
    let tp = &css.dtpl.items[dc.v.i];
    let t = &css.dbuf;
    t.clear();
    if substVars(css, tp.text, vs, t, 0) {
        let d0 = css.decls.len;
        let w0 = css.warns.len;
        let n = inlineDecl(css, tp.name, t.str());
        for j in 0..n {
            let d2 = css.decls.items[d0 + j];
            if d2.prop == prop {
                r = declValue(css, prop, d2.v, -1, vs);
            }
        }
        css.decls.len = d0;
        css.warns.len = w0;
    }
    if r.kind == V_UNSET {
        failDeferred(css, dc.v.i, "a var() here is undefined or the value is invalid after substituting it");
    }
    kvAdd(css, di, vs, r);
    return r;
}

/// The slot of (`di`, `vs`) in `Css.kslots`: its own entry, or the empty one it would go in.
fn kvSlot(css: &Css, di: int, vs: int): int {
    let n = css.kslots.len;
    let h = (di * 1000003 + vs * 7919) % n;
    if h < 0 {
        h += n;
    }
    while css.kslots[h] != 0 {
        let e = &css.kvc.items[css.kslots[h] - 1];
        if e.decl == di && e.vs == vs {
            break;
        }
        h = (h + 1) % n;
    }
    return h;
}

/// Remember `v` for (`di`, `vs`) (not there yet); the index doubles when it is half full.
fn kvAdd(css: &Css, di: int, vs: int, v: Value) {
    css.kvc.push(KvStop { decl: di, vs: vs, v: v });
    if css.kvc.len * 2 > css.kslots.len {
        css.kslots = css.mem.alloc::<int>(css.kslots.len * 2);
        for i in 0..css.kslots.len {
            css.kslots[i] = 0;
        }
        for k in 0..css.kvc.len {
            css.kslots[kvSlot(css, css.kvc.items[k].decl, css.kvc.items[k].vs)] = k + 1;
        }
        return;
    }
    css.kslots[kvSlot(css, di, vs)] = css.kvc.len;
}

/// A declaration kept with `var()` inside (`P_DEFER`, see `cssparse.declare`): substitute the custom
/// properties of `vs`, parse the text as an ordinary declaration, and apply what it sets to `css.out`.
/// Any failure skips it, like an undefined `var()`. Runs once per computed style (the cache is keyed by
/// the matched rules and the parent, which fix the custom properties).
fn applyDeferred(css: &Css, di: int, parent: int, vs: int) {
    let tp = &css.dtpl.items[di];
    let t = &css.dbuf;
    t.clear();
    if !substVars(css, tp.text, vs, t, 0) {
        failDeferred(css, di, "a var() here is undefined or holds a value that cannot be written back (time, calc, keyword)");
        return;
    }
    let d0 = css.decls.len;
    let w0 = css.warns.len;
    let n = inlineDecl(css, tp.name, t.str());
    if n == 0 {
        css.warns.len = w0;
        failDeferred(css, di, "invalid value after substituting var()");
        return;
    }
    for j in 0..n {
        let dc = css.decls.items[d0 + j];
        let v = declValue(css, dc.prop, dc.v, parent, vs);
        if v.kind != V_UNSET {
            css.out[dc.prop] = v;
            css.omask[dc.prop] = true;
        }
    }
    css.decls.len = d0;
    css.warns.len = w0;
}

/// A deferred declaration did not resolve: say so once, at its place in the sheet (it may be a typo, or a
/// variable that only some subtrees define; either way the declaration is skipped for this element).
fn failDeferred(css: &Css, di: int, why: string) {
    let tp = &css.dtpl.items[di];
    if tp.warned {
        return;
    }
    tp.warned = true;
    let m = Text.new(css.mem);
    m.pushStr("'");
    m.pushStr(tp.name);
    m.pushStr("' does not apply: ");
    m.pushStr(why);
    css.warns.push(Warning { file: tp.file, line: tp.line, col: tp.col, msg: m.str() });
}

/// Fill `css.out` for an element under `parent` with custom property set `vs` from the rules `ids[off..off + nm]` (ascending specificity):
/// inherited and initial values, the declarations in order, then units. `mask` records in `css.omask` which properties
/// the last winning declaration set through a `var()`.
pub fn cascade(css: &Css, ids: []int, off: int, nm: int, parent: int, vs: int, mask: bool) {
    for q in 0..NPROPS {
        if parent >= 0 && inherits(q) {
            css.out[q] = css.vals.items[parent * NPROPS + q];
        } else {
            css.out[q] = initial(q);
        }
        css.omask[q] = false;
    }
    for m in 0..nm {
        let r = css.rules.items[ids[off + m]];
        for d in 0..r.ndecl {
            let dc = css.decls.items[r.decl0 + d];
            if dc.prop == P_DEFER {
                applyDeferred(css, dc.v.i, parent, vs);
                continue;
            }
            if dc.prop >= NPROPS {
                continue;
            }
            if dc.prop == P_ALL {
                for q in 0..NPROPS {
                    let av = dc.v;
                    if av.kind == V_REVERT {
                        av = revertValue(css, ids, off, nm, m, q, parent, vs);
                    } else {
                        av = declValue(css, q, av, parent, vs);
                    }
                    css.out[q] = av;
                    css.omask[q] = false;
                }
                continue;
            }
            let v = declValue(css, dc.prop, dc.v, parent, vs);
            if dc.v.kind == V_REVERT {
                v = revertValue(css, ids, off, nm, m, dc.prop, parent, vs);
            }
            if v.kind != V_UNSET {
                css.out[dc.prop] = v;
                css.omask[dc.prop] = mask && dc.v.kind == V_VAR;
            }
        }
    }
    fontCalc(css, css.out, 0, parent);
    resolveUnits(css, css.out, 0, parent);
}

fn buildStyle(css: &Css, nm: int, parent: int): int {
    let vs = css.varsOf(parent);
    let own = false;
    for m in 0..nm {
        let r0 = css.rules.items[css.midx[m]];
        for d in 0..r0.ndecl {
            if css.decls.items[r0.decl0 + d].prop >= NPROPS {
                own = true;
            }
        }
    }
    if own || (css.noInh > 0 && hasNoInherit(css, vs)) {
        vs = ownVars(css, nm, vs, parent);
    }
    cascade(css, css.midx, 0, nm, parent, vs, false);
    for q in 0..NPROPS {
        css.vals.push(css.out[q]);
    }
    css.nstyles += 1;
    css.setVars(css.nstyles - 1, vs);
    css.setRules(css.nstyles - 1, nm, parent);
    return css.nstyles - 1;
}

/// Match every rule against `nodes[id]` into `css.midx[0..n]` (ascending specificity, then source order); returns n.
/// `j3.ui.inspect` calls it for the pinned element.
pub fn collect(css: &Css, nodes: []MatchNode, id: int): int {
    let nm = 0;
    // a `::before` / `::after` box takes the rules of that kind, matched against its host element
    let rpe = if nodes[id].pe > 0 { nodes[id].pe } else { 0 };
    let hid = if rpe > 0 { nodes[id].parent } else { id };
    let scope = nodes[hid].scope;
    let scope2 = nodes[hid].scope2;
    let tag = nodes[hid].tag;
    let classes = nodes[hid].classes;
    let ncls = classes.len;
    for s in 0..css.sheets.len {
        let sh = &css.sheets.items[s];
        // a sheet of the parent that passed a class to this root: only rules that name a class, see `scope2`
        let foreign = sh.scope != 0 && sh.scope != scope;
        if foreign && sh.scope != scope2 {
            continue;
        }
        for ri in sh.rule0..sh.rule0 + sh.nrules {
            let r = &css.rules.items[ri];
            if r.pe != rpe {
                continue;
            }
            if r.tag >= 0 && r.tag != tag && !(r.tag == css.tTextarea && nodes[hid].type == r.tag) {
                continue;
            }
            if foreign && r.cls0 < 0 {
                continue;
            }
            if r.mq >= 0 && !css.mediaHolds(r.mq) {
                continue;
            }
            if r.cls0 >= 0 {
                let has = false;
                for j in 0..ncls {
                    if classes[j] == r.cls0 {
                        has = true;
                    }
                }
                if !has {
                    continue;
                }
            }
            if nm < MAXM && matchRule(css, r, nodes, hid) {
                // insertion by (spec, order)
                // a passed class beats the component's own rule of the same specificity
                let key = (r.spec + (if foreign { 1 } else { 0 })) * 1048576 + r.order;
                let at = nm;
                while at > 0 && css.mkey[at - 1] > key {
                    css.mkey[at] = css.mkey[at - 1];
                    css.midx[at] = css.midx[at - 1];
                    at -= 1;
                }
                css.mkey[at] = key;
                css.midx[at] = ri;
                nm += 1;
            }
        }
    }
    return nm;
}

/// Computed style id for `nodes[id]`. `parent` is the style id `computeStyle` returned for the
/// node's parent (-1 for the root); compute parents first. Styles are shared: the same matched
/// rules under the same parent style return the same id. Read values with `css.get(style, P_*)`.
/// Ponytail limits: 128 matching rules per node (extra ones are ignored) and a 4096-slot cache
/// that is cleared when full.
pub fn computeStyle(css: &Css, nodes: []MatchNode, id: int, parent: int): int {
    let nm = collect(css, nodes, id);
    let h = parent + 7;
    for m in 0..nm {
        h = h * 1000003 + css.midx[m] + 1;
    }
    let slot = h % SLOTS;
    if slot < 0 {
        slot += SLOTS;
    }
    while css.slots[slot] != 0 {
        let ce = css.cents.items[css.slots[slot] - 1];
        if ce.hash == h && ce.parent == parent && ce.n == nm {
            let same_ = true;
            for m in 0..nm {
                if css.crules.items[ce.r0 + m] != css.midx[m] {
                    same_ = false;
                }
            }
            if same_ {
                if parent < 0 { css.rootFs = css.get(ce.style, P_FONT_SIZE).f; }
                return ce.style;
            }
        }
        slot = (slot + 1) % SLOTS;
    }
    if css.cents.len >= SLOTS / 2 {
        css.clearCache();
        slot = ((h % SLOTS) + SLOTS) % SLOTS;
    }
    let style = buildStyle(css, nm, parent);
    let r0 = css.crules.len;
    for m in 0..nm {
        css.crules.push(css.midx[m]);
    }
    css.cents.push(CacheEnt { hash: h, parent: parent, r0: r0, n: nm, style: style });
    css.slots[slot] = css.cents.len;
    if parent < 0 { css.rootFs = css.get(style, P_FONT_SIZE).f; }
    return style;
}
