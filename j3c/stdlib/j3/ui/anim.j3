/// Animation math for `.j3ui` CSS: easing curves, the time of a `@keyframes` animation, and color
/// and shadow blending. Pure functions of numbers (no Dom, no Css, no GL), so tests drive them
/// directly. `j3.ui.motion` is the per-node state built on this.
///
/// ```
/// let e = anim.cubic(0.25, 0.1, 0.25, 1.0);    // CSS `ease`
/// let y = anim.ease(&e, 0.4);                  // progress 0..1 in, curve value out (may overshoot)
/// ```

module j3.ui.anim;

use j3.math.{ cos, exp, floor };

/// `Ease.kind`: `cubic-bezier(a, b, c, d)` (also ease, ease-in, ease-out, ease-in-out).
pub const E_CUBIC: int = 0;
/// `steps(a)`; `b` is 1 for `jump-start`, 0 for `jump-end`.
pub const E_STEPS: int = 1;
/// Ball bounce that ends at 1 (`bounce`).
pub const E_BOUNCE: int = 2;
/// Damped oscillation around 1: `a` damping, `b` cycles (`spring(a, b)`).
pub const E_SPRING: int = 3;

/// A timing function: `kind` and its numbers.
pub struct Ease {
    kind: int;
    a: f32;
    b: f32;
    c: f32;
    d: f32;
}

fn pick(c: bool, a: f32, b: f32): f32 {
    if c {
        return a;
    }
    return b;
}

/// `cubic-bezier(x1, y1, x2, y2)`.
pub fn cubic(x1: f32, y1: f32, x2: f32, y2: f32): Ease {
    return Ease { kind: E_CUBIC, a: x1, b: y1, c: x2, d: y2 };
}

/// `spring(damping, cycles)`.
pub fn spring(damping: f32, cycles: f32): Ease {
    return Ease { kind: E_SPRING, a: damping, b: cycles, c: 0.0, d: 0.0 };
}

/// `steps(n)` with the jump at the start (`start`) or the end.
pub fn steps(n: f32, start: bool): Ease {
    return Ease { kind: E_STEPS, a: n, b: pick(start, 1.0, 0.0), c: 0.0, d: 0.0 };
}

/// The presets, in the order `Css` seeds them (index = `PRESET_*`).
pub const PRESET_EASE: int = 0;
pub const PRESET_LINEAR: int = 1;
pub const PRESET_IN: int = 2;
pub const PRESET_OUT: int = 3;
pub const PRESET_IN_OUT: int = 4;
pub const PRESET_BOUNCE: int = 5;
pub const PRESET_SPRING: int = 6;
pub const NPRESET: int = 7;

/// Preset `i` (`PRESET_*`).
pub fn preset(i: int): Ease {
    if i == PRESET_LINEAR { return cubic(0.0, 0.0, 1.0, 1.0); }
    if i == PRESET_IN { return cubic(0.42, 0.0, 1.0, 1.0); }
    if i == PRESET_OUT { return cubic(0.0, 0.0, 0.58, 1.0); }
    if i == PRESET_IN_OUT { return cubic(0.42, 0.0, 0.58, 1.0); }
    if i == PRESET_BOUNCE { return Ease { kind: E_BOUNCE, a: 0.0, b: 0.0, c: 0.0, d: 0.0 }; }
    if i == PRESET_SPRING { return spring(7.0, 2.5); }
    return cubic(0.25, 0.1, 0.25, 1.0);
}

/// Bezier coordinate at parameter `s` for control values `p1`, `p2` (end points 0 and 1).
fn bez(p1: f32, p2: f32, s: f32): f32 {
    let u = 1.0 - s;
    return 3.0 * u * u * s * p1 + 3.0 * u * s * s * p2 + s * s * s;
}

fn bezSlope(p1: f32, p2: f32, s: f32): f32 {
    let u = 1.0 - s;
    return 3.0 * u * u * p1 + 6.0 * u * s * (p2 - p1) + 3.0 * s * s * (1.0 - p2);
}

/// The y of the cubic-bezier at x = `t`: Newton from `t`, then bisection when the slope is flat.
fn cubicAt(e: &Ease, t: f32): f32 {
    let s = t;
    for i in 0..6 {
        let err = bez(e.a, e.c, s) - t;
        let sl = bezSlope(e.a, e.c, s);
        if sl < 0.0001 && sl > -0.0001 {
            break;
        }
        s = s - err / sl;
    }
    let x = bez(e.a, e.c, s);
    if s < 0.0 || s > 1.0 || x - t > 0.001 || t - x > 0.001 {
        let lo: f32 = 0.0;
        let hi: f32 = 1.0;
        for i in 0..24 {
            s = (lo + hi) * 0.5;
            if bez(e.a, e.c, s) < t {
                lo = s;
            } else {
                hi = s;
            }
        }
    }
    return bez(e.b, e.d, s);
}

fn bounceOut(t: f32): f32 {
    if t < 0.36363636 {
        return 7.5625 * t * t;
    }
    if t < 0.72727273 {
        return 7.5625 * (t - 0.54545455) * (t - 0.54545455) + 0.75;
    }
    if t < 0.90909091 {
        return 7.5625 * (t - 0.81818182) * (t - 0.81818182) + 0.9375;
    }
    return 7.5625 * (t - 0.95454545) * (t - 0.95454545) + 0.984375;
}

/// The curve value at progress `t`. 0 and 1 map to 0 and 1; inputs outside 0..1 are clamped.
pub fn ease(e: &Ease, t: f32): f32 {
    if t <= 0.0 {
        return 0.0;
    }
    if t >= 1.0 {
        return 1.0;
    }
    if e.kind == E_STEPS {
        let n = pick(e.a < 1.0, 1.0, e.a);
        let k = floor(t * n);
        if e.b > 0.5 {
            k = k + 1.0;
        }
        if k > n {
            k = n;
        }
        return k / n;
    }
    if e.kind == E_BOUNCE {
        return bounceOut(t);
    }
    if e.kind == E_SPRING {
        return 1.0 - exp(0.0 - e.a * t) * cos(6.2831853 * e.b * t);
    }
    return cubicAt(e, t);
}

/// `a + (b - a) * t`.
pub fn mix(a: f32, b: f32, t: f32): f32 {
    return a + (b - a) * t;
}

fn cr(c: int): int {
    return (c / 16777216) % 256;
}

fn cg(c: int): int {
    return (c / 65536) % 256;
}

fn cb(c: int): int {
    return (c / 256) % 256;
}

fn ca(c: int): int {
    return c % 256;
}

/// Interpolate two packed colors (`r*16777216 + g*65536 + b*256 + a`) with premultiplied alpha, like
/// CSS (transparent to blue is blue fading in, not grey). `t` may leave 0..1 (spring overshoot);
/// channels clamp.
pub fn mixColor(a: int, b: int, t: f32): int {
    let aa = f32(ca(a));
    let ba = f32(ca(b));
    let wa = aa * (1.0 - t);
    let wb = ba * t;
    let pa = wa + wb;
    if pa < 0.5 {
        return 0;
    }
    let r = (f32(cr(a)) * wa + f32(cr(b)) * wb) / pa;
    let g = (f32(cg(a)) * wa + f32(cg(b)) * wb) / pa;
    let bl = (f32(cb(a)) * wa + f32(cb(b)) * wb) / pa;
    return chan(r) * 16777216 + chan(g) * 65536 + chan(bl) * 256 + chan(pa);
}

fn chan(v: f32): int {
    if v <= 0.0 {
        return 0;
    }
    if v >= 255.0 {
        return 255;
    }
    return int(v + 0.5);
}

/// Floats in one shadow: inset, x, y, blur, spread, r, g, b, a.
pub const SH: int = 9;
/// Most shadows blended (extra ones are dropped).
pub const SH_MAX: int = 4;

/// Blend shadow list `a` into `b` at `t`: both are `[n, shadows...]`; the shorter list is padded
/// with transparent zero shadows of the other's inset flag and color (CSS). Writes into `out`
/// (room for `1 + SH * SH_MAX`). Returns the floats written.
pub fn mixShadows(a: []f32, ao: int, b: []f32, bo: int, t: f32, out: []f32): int {
    let na = int(a[ao]);
    let nb = int(b[bo]);
    let n = if na > nb { na } else { nb };
    if n > SH_MAX {
        n = SH_MAX;
    }
    out[0] = f32(n);
    for i in 0..n {
        let o = 1 + i * SH;
        let ha = i < na;
        let hb = i < nb;
        let qa = ao + 1 + i * SH;
        let qb = bo + 1 + i * SH;
        out[o] = if hb { b[qb] } else { a[qa] };
        for k in 1..5 {
            let va: f32 = 0.0;
            let vb: f32 = 0.0;
            if ha { va = a[qa + k]; }
            if hb { vb = b[qb + k]; }
            out[o + k] = mix(va, vb, t);
        }
        let ca_ = packAt(a, qa + 5);
        let cb_ = packAt(b, qb + 5);
        if !ha { ca_ = cb_ - cb_ % 256; }
        if !hb { cb_ = ca_ - ca_ % 256; }
        let m = mixColor(ca_, cb_, t);
        out[o + 5] = f32(cr(m));
        out[o + 6] = f32(cg(m));
        out[o + 7] = f32(cb(m));
        out[o + 8] = f32(ca(m));
    }
    return 1 + n * SH;
}

fn packAt(a: []f32, q: int): int {
    return int(a[q]) * 16777216 + int(a[q + 1]) * 65536 + int(a[q + 2]) * 256 + int(a[q + 3]);
}

/// `animation-direction` values.
pub const DIR_NORMAL: int = 0;
pub const DIR_REVERSE: int = 1;
pub const DIR_ALTERNATE: int = 2;
pub const DIR_ALT_REVERSE: int = 3;
/// `animation-fill-mode` values.
pub const FILL_NONE: int = 0;
pub const FILL_FORWARDS: int = 1;
pub const FILL_BACKWARDS: int = 2;
pub const FILL_BOTH: int = 3;

/// Where a `@keyframes` animation is at one moment.
pub struct Phase {
    /// A value applies (running, or held by `animation-fill-mode`).
    on: bool;
    /// Past the last iteration (the animation will not change again).
    done: bool;
    /// Position along the keyframes, 0 to 1, after `animation-direction`.
    t: f32;
}

/// The phase `elapsed` ms after the animation started: `delay` and `dur` in ms, `iters` iterations
/// (negative: forever), `dir` and `fill` as above.
pub fn phase(elapsed: f32, delay: f32, dur: f32, iters: f32, dir: int, fill: int): Phase {
    let x = elapsed - delay;
    let backwards = fill == FILL_BACKWARDS || fill == FILL_BOTH;
    let forwards = fill == FILL_FORWARDS || fill == FILL_BOTH;
    let rev = dir == DIR_REVERSE || dir == DIR_ALT_REVERSE;
    if dur <= 0.0 {
        // zero duration: one instant at the end of the delay
        if x < 0.0 {
            return Phase { on: backwards, done: false, t: pick(rev, 1.0, 0.0) };
        }
        return Phase { on: forwards, done: true, t: pick(rev, 0.0, 1.0) };
    }
    if x < 0.0 {
        return Phase { on: backwards, done: false, t: pick(rev, 1.0, 0.0) };
    }
    let ph = x / dur;
    let it = floor(ph);
    let frac = ph - it;
    let finished = iters >= 0.0 && ph >= iters;
    if finished {
        // hold the end of the last (possibly partial) iteration
        it = floor(iters);
        frac = iters - it;
        if frac <= 0.0 {
            frac = 1.0;
            it = it - 1.0;
        }
    }
    let flip = rev;
    if dir == DIR_ALTERNATE || dir == DIR_ALT_REVERSE {
        let odd = (it - 2.0 * floor(it / 2.0)) > 0.5;
        if odd {
            flip = !flip;
        }
    }
    let t = if flip { 1.0 - frac } else { frac };
    if finished {
        return Phase { on: forwards, done: true, t: t };
    }
    return Phase { on: true, done: false, t: t };
}
