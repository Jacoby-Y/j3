/// Drawing and hit testing for a single-line text box (`j3.ui.textedit` holds the text). Everything is
/// in the content box: the caller translates to its top left, and passes its width and height.
/// Only the visible slice of the text is measured and drawn, so a very long value costs what is shown.
/// Needs SDL_ttf for measuring and a `j3.gfx.paint` frame for `paint`; main thread only.

module j3.ui.field;

use j3.game.{ Color, Font, fontLine, selRectW, selRectX, textBidi, textCaretX, textIndexAt, textSelRects, textWidth };
use j3.gfx.paint;
use j3.math.Vec2;
use j3.ui.textfit.{ fitPrefix, isCont };

fn view(s: string, a: int, b: int): []u8 {
    let t = s[a..b];
    return []u8 { ptr: t.ptr, len: t.len };
}

fn width(font: Font, bold: bool, s: string, a: int, b: int): f32 {
    return textWidth(font, view(s, a, b), bold);
}

/// Visual x of the caret before byte `cur` when `s[a..b]` is drawn (right-to-left runs reordered; see `game.textCaretX`).
pub fn caretX(font: Font, bold: bool, s: string, a: int, b: int, cur: int): f32 {
    return textCaretX(font, view(s, a, b), bold, cur - a);
}

fn align(s: string, i: int): int {
    let j = i;
    if j < 0 {
        j = 0;
    }
    if j > s.len {
        j = s.len;
    }
    while j > 0 && j < s.len && isCont(s[j]) {
        j -= 1;
    }
    return j;
}

/// The first visible byte after the caret `cur` moved: `vs` unchanged while the caret is inside
/// `avail` px, else the view that puts the caret at the edge it left through. A shrunk text pulls
/// the view back so no blank space shows at the right.
pub fn scroll(font: Font, bold: bool, s: string, vs: int, cur: int, avail: f32): int {
    let v = align(s, vs);
    if cur < v {
        return align(s, cur);
    }
    if fitPrefix(font, bold, view(s, v, cur), avail) < cur - v {
        // caret past the right edge: walk back from it until a run no longer fits
        v = cur;
        while v > 0 {
            let p = v - 1;
            while p > 0 && isCont(s[p]) {
                p -= 1;
            }
            if width(font, bold, s, p, cur) > avail {
                break;
            }
            v = p;
        }
        return v;
    }
    if v > 0 && fitPrefix(font, bold, view(s, v, s.len), avail) == s.len - v {
        // everything after v fits: show more to the left
        let w = v;
        while w > 0 {
            let q = w - 1;
            while q > 0 && isCont(s[q]) {
                q -= 1;
            }
            if width(font, bold, s, q, s.len) > avail {
                break;
            }
            w = q;
        }
        return w;
    }
    return v;
}

/// The byte index nearest to local x `x` when the text shows from `vs`.
pub fn indexAt(font: Font, bold: bool, s: string, vs: int, x: f32): int {
    let a = align(s, vs);
    if x <= 0.0 {
        return a;
    }
    if textBidi(font, view(s, a, s.len)) {
        return a + textIndexAt(font, view(s, a, s.len), bold, x);
    }
    let n = fitPrefix(font, bold, view(s, a, s.len), x);
    let i = a + n;
    if i >= s.len {
        return s.len;
    }
    let nx = i + 1;
    while nx < s.len && isCont(s[nx]) {
        nx += 1;
    }
    let w0 = width(font, bold, s, a, i);
    let w1 = width(font, bold, s, a, nx);
    if x - w0 > (w1 - w0) / 2.0 {
        return nx;
    }
    return i;
}

/// Colors for `paint`.
pub struct Look {
    text: Color;
    hint: Color;
    sel: Color;
    caret: Color;
    /// Rich textarea: token chip background, link color, italic (dimmed) color.
    chip: Color;
    link: Color;
    dim: Color;
}

/// Draw `s[a..b]` from x 0 at height `y`, with the IME composition `comp` (underlined) inserted at byte
/// `cur`. Returns the x of the caret (after the composition), or -1 when `cur` is outside `a..b`.
pub fn run(font: Font, bold: bool, s: string, a: int, b: int, cur: int, comp: string, y: f32, look: &Look): f32 {
    let inside = cur >= a && cur <= b;
    if comp.len > 0 && inside {
        let x0 = width(font, bold, s, a, cur);
        let cw = textWidth(font, view(comp, 0, comp.len), bold);
        if cur > a {
            paint.text(font, Vec2 { x: 0.0, y: y }, s[a..cur], look.text);
        }
        paint.text(font, Vec2 { x: x0, y: y }, comp, look.text);
        paint.rect(Vec2 { x: x0, y: y + f32(fontLine(font)) - 1.0 }, Vec2 { x: cw, y: 1.0 }, look.text);
        if b > cur {
            paint.text(font, Vec2 { x: x0 + cw, y: y }, s[cur..b], look.text);
        }
        return x0 + cw;
    }
    if b > a {
        paint.text(font, Vec2 { x: 0.0, y: y }, s[a..b], look.text);
    }
    return if inside { caretX(font, bold, s, a, b, cur) } else { -1.0 };
}

/// Draw `s` (or `hint` when `s` is empty and not focused) from byte `vs`, then the selection `anc..cur`
/// and the caret when `focused` (`blink` false hides the caret), with the IME composition `comp` at the
/// caret. `w` x `h` is the content box; text is vertically centered. Returns the caret x (-1: none).
pub fn paint(font: Font, bold: bool, s: string, vs: int, cur: int, anc: int, focused: bool, blink: bool, hint: string, comp: string, w: f32, h: f32, look: &Look): f32 {
    let lh = f32(fontLine(font));
    let y = f32(int((h - lh) / 2.0 + 0.5));
    if s.len == 0 {
        if !focused && hint.len > 0 {
            paint.text(font, Vec2 { x: 0.0, y: y }, hint, look.hint);
        }
        let cx0: f32 = 0.0;
        if focused {
            cx0 = run(font, bold, s, 0, 0, 0, comp, y, look);
        }
        if focused && blink {
            paint.rect(Vec2 { x: cx0, y: y }, Vec2 { x: 1.0, y: lh }, look.caret);
        }
        return if focused { cx0 } else { -1.0 };
    }
    let a = align(s, vs);
    let end = a + fitPrefix(font, bold, view(s, a, s.len), w);
    if focused && cur != anc && comp.len == 0 {
        let lo = if cur < anc { cur } else { anc };
        let hi = if cur < anc { anc } else { cur };
        lo = if lo < a { a } else { lo };
        hi = if hi > end { end } else { hi };
        if hi > lo {
            let nr = textSelRects(font, view(s, a, end), bold, lo - a, hi - a);
            for k in 0..nr {
                paint.rect(Vec2 { x: selRectX(k), y: y }, Vec2 { x: selRectW(k), y: lh }, look.sel);
            }
        }
    }
    let cx = run(font, bold, s, a, end, if focused { cur } else { -2 }, comp, y, look);
    if focused && blink && cx >= 0.0 {
        paint.rect(Vec2 { x: cx, y: y }, Vec2 { x: 1.0, y: lh }, look.caret);
    }
    return if focused { cx } else { -1.0 };
}
