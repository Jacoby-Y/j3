/// Scroll arithmetic with no tree and no GL: clamping, wheel chaining, and the wheel inertia of
/// `scroll-behavior: smooth`. `j3.ui.dom` calls it for the wheel; `j3.ui.scrollbar` has the bars.

module j3.ui.scroll;

use j3.math.{ abs, exp, max, min };

/// Pixels one wheel notch scrolls.
pub const NOTCH: f32 = 48.0;
/// Inertia: a notch gives `NOTCH / TAU` px/ms of speed, which decays with time constant `TAU` ms,
/// so it travels `NOTCH` px in total, like an instant step.
pub const TAU: f32 = 140.0;
/// Speed (px/ms) below which a coasting box stops.
const STOP: f32 = 0.004;

/// `off + by` kept inside `0..maxOff`.
pub fn clampOff(off: f32, by: f32, maxOff: f32): f32 {
    return max(0.0, min(maxOff, off + by));
}

/// Whether a box at `off` (range `0..maxOff`) can still move in direction `dir` (+1 forward, -1 back).
pub fn canMove(off: f32, maxOff: f32, dir: f32): bool {
    if dir > 0.0 {
        return off < maxOff - 0.01;
    }
    return off > 0.01;
}

/// Speed after a wheel impulse of `notches` (positive scrolls forward).
pub fn kick(vel: f32, notches: f32): f32 {
    return vel + notches * NOTCH / TAU;
}

/// One inertia step of `dt` ms: the distance travelled and the new speed (`out`).
pub fn coast(vel: f32, dt: f32, out: &f32): f32 {
    let k = exp(0.0 - dt / TAU);
    let dist = vel * TAU * (1.0 - k);
    let v = vel * k;
    if abs(v) < STOP {
        v = 0.0;
    }
    *out = v;
    return dist;
}
