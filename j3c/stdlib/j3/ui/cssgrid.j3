/// Grid properties for `j3.ui.css`: track lists (`grid-template-columns` / `-rows`, `grid-auto-columns` / `-rows`),
/// `grid-template-areas`, item placement (`grid-area`, `grid-column`, `grid-row` and their `-start` / `-end` longhands),
/// `grid-auto-flow` and the `place-items` / `place-self` shorthands.
/// The value layouts are on `P_GRID_COL0` and `P_GRID_CS` in `j3.ui.css`.

module j3.ui.cssgrid;

use j3.text.same;
use j3.ui.css.{ P_ALIGN_ITEMS, P_ALIGN_SELF, P_GRID_AREAS, P_JUSTIFY_ITEMS, P_JUSTIFY_SELF, V_STR };
use j3.ui.css.{ MAX_TRACKS, P_GRID_ACOLS, P_GRID_AROWS, P_GRID_COL0, P_GRID_CS, P_GRID_FLOW, P_GRID_ROWS };
use j3.ui.css.{ V_AUTO, V_FR, V_KW, V_LIST, V_NONE, V_NUM, V_UNSET, Value };
use j3.ui.csslex.{ T_COMMA, T_DELIM, T_FUNC, T_IDENT, T_LPAREN, T_NUM, T_RPAREN, T_STR };
use j3.ui.cssprop.{ emit, parseVal };
use j3.ui.cssvalue.{ isWord, mk, P, parseLenU, pf, tk, txt, unitIs, warnAt };

/// The tracks being parsed, four numbers each (`[minKind, min, maxKind, max]`).
#[singleton]
#[thread]
let GT: [256]f32;

fn whole(f: f32): bool {
    return f32(int(f)) == f;
}

/// A track size at `TOK[k]`: `fr` (when allowed), a length, a percentage or `auto`.
fn sizeTok(p: &P, k: int, allowFr: bool, kind: &int, val: &f32): bool {
    let t = tk(k);
    if t.kind == T_NUM && t.us != t.ue && unitIs(p, t, "fr") {
        if !allowFr || t.f < 0.0 {
            return false;
        }
        *kind = V_FR;
        *val = t.f;
        return true;
    }
    let v = mk(V_UNSET, 0.0, 0, 0);
    if !parseLenU(p, t, &v) || (v.kind != V_AUTO && v.f < 0.0) {
        return false;
    }
    *kind = v.kind;
    *val = v.f;
    return true;
}

/// Whether a track kind (as stored) is a length or a percentage.
fn sized(kind: f32): bool {
    return kind != f32(V_AUTO) && kind != f32(V_FR);
}

/// One track (`<size>` or `minmax(<min>, <max>)`) at `TOK[k..end)` into `GT[c]`; the tokens used, 0 when it is not one.
/// ponytail: `min-content`, `max-content`, `fit-content()` and named lines are not tracks.
fn oneTrack(p: &P, k: int, end: int, c: int): int {
    let t = tk(k);
    let nk = 0;
    let nv: f32 = 0.0;
    let xk = 0;
    let xv: f32 = 0.0;
    let used = 1;
    if t.kind == T_FUNC {
        if !same(txt(p, t), "minmax") || k + 5 > end || tk(k + 2).kind != T_COMMA || tk(k + 4).kind != T_RPAREN {
            return 0;
        }
        if !sizeTok(p, k + 1, false, &nk, &nv) || !sizeTok(p, k + 3, true, &xk, &xv) {
            return 0;
        }
        used = 5;
    } else if sizeTok(p, k, true, &xk, &xv) {
        nk = if xk == V_FR { V_AUTO } else { xk };
        nv = if xk == V_FR { 0.0 } else { xv };
    } else {
        return 0;
    }
    GT[c * 4] = f32(nk);
    GT[c * 4 + 1] = nv;
    GT[c * 4 + 2] = f32(xk);
    GT[c * 4 + 3] = xv;
    return used;
}

/// Index of the `)` closing the function at `TOK[k]`, -1 when there is none before `n`.
fn closeOf(k: int, n: int): int {
    let depth = 0;
    for j in k..n {
        let kind = tk(j).kind;
        if kind == T_FUNC || kind == T_LPAREN {
            depth += 1;
        } else if kind == T_RPAREN {
            depth -= 1;
            if depth == 0 {
                return j;
            }
        }
    }
    return -1;
}

fn tooMany(p: &P, k: int): bool {
    warnAt(p, tk(k).line, tk(k).col, "more than 64 grid tracks (declaration dropped)");
    return true;
}

/// `grid-template-columns` / `-rows` / `grid-auto-columns` / `-rows` (`prop`): sizes, `minmax()`, `repeat(N, ...)`, and as the
/// whole value `repeat(auto-fill | auto-fit, ...)` (templates only; each repeated track needs a definite size).
pub fn tracks(p: &P, n: int, prop: int): bool {
    if n == 1 && isWord(p, tk(0), "none") {
        emit(p, prop, mk(V_NONE, 0.0, 0, 0));
        return true;
    }
    let c = 0;
    let fill = 0;
    let k = 0;
    while k < n {
        if c >= MAX_TRACKS {
            return tooMany(p, k);
        }
        let t = tk(k);
        if t.kind == T_FUNC && same(txt(p, t), "repeat") {
            let close = closeOf(k, n);
            if close < k + 4 || tk(k + 2).kind != T_COMMA {
                return false;
            }
            let r = tk(k + 1);
            let reps = 1;
            if isWord(p, r, "auto-fill") || isWord(p, r, "auto-fit") {
                if k != 0 || close != n - 1 || prop == P_GRID_ACOLS || prop == P_GRID_AROWS {
                    return false;
                }
                fill = if isWord(p, r, "auto-fill") { 1 } else { 2 };
            } else if r.kind == T_NUM && r.us == r.ue && whole(r.f) && r.f >= 1.0 {
                reps = int(r.f);
            } else {
                return false;
            }
            let c0 = c;
            let j = k + 3;
            while j < close {
                if c >= MAX_TRACKS {
                    return tooMany(p, j);
                }
                if tk(j).kind == T_FUNC && same(txt(p, tk(j)), "repeat") {
                    return false;
                }
                let u = oneTrack(p, j, close, c);
                if u == 0 {
                    return false;
                }
                // auto-fill needs a size to count with: a length or percentage as the minimum or the maximum
                if fill > 0 && !sized(GT[c * 4]) && !sized(GT[c * 4 + 2]) {
                    return false;
                }
                j += u;
                c += 1;
            }
            let m = c - c0;
            if m == 0 {
                return false;
            }
            if c0 + m * reps > MAX_TRACKS {
                return tooMany(p, k);
            }
            for rep in 1..reps {
                for i in 0..m * 4 {
                    GT[(c0 + rep * m) * 4 + i] = GT[c0 * 4 + i];
                }
            }
            c = c0 + m * reps;
            k = close + 1;
        } else {
            let u2 = oneTrack(p, k, n, c);
            if u2 == 0 {
                return false;
            }
            c += 1;
            k += u2;
        }
    }
    if c == 0 {
        return false;
    }
    emit(p, prop, mk(V_LIST, 0.0, p.css.paints.len, 0));
    pf(p, f32(fill));
    pf(p, f32(c));
    for i in 0..c * 4 {
        pf(p, GT[i]);
    }
    return true;
}

/// A grid line at `TOK[k]`: `auto`, a nonzero integer, `span N`, or an area name (`V_STR`). The tokens used, 0 when it is none of them.
/// Stored as `V_AUTO`, `V_NUM` (`f` the line, `i` 0) or `V_NUM` (`f` the span, `i` 1).
fn lineTok(p: &P, k: int, n: int, out: &Value): int {
    let t = tk(k);
    if isWord(p, t, "auto") {
        *out = mk(V_AUTO, 0.0, 0, 0);
        return 1;
    }
    if isWord(p, t, "span") && k + 1 < n {
        let u = tk(k + 1);
        if u.kind == T_NUM && u.us == u.ue && whole(u.f) && u.f >= 1.0 && u.f <= 1000.0 {
            *out = mk(V_NUM, u.f, 1, 0);
            return 2;
        }
        return 0;
    }
    if t.kind == T_NUM && t.us == t.ue && whole(t.f) && t.f != 0.0 && t.f >= -1000.0 && t.f <= 1000.0 {
        *out = mk(V_NUM, t.f, 0, 0);
        return 1;
    }
    // a `grid-template-areas` name: its `name-start` / `name-end` line, found at layout
    if t.kind == T_IDENT {
        *out = mk(V_STR, 0.0, p.css.intern(txt(p, t)), 0);
        return 1;
    }
    return 0;
}

/// `grid-column` / `grid-row` (`both`, `first` the start property: `start [/ end]`) or one `-start` / `-end` longhand.
pub fn lines(p: &P, n: int, first: int, both: bool): bool {
    let a = mk(V_AUTO, 0.0, 0, 0);
    let used = lineTok(p, 0, n, &a);
    if used == 0 {
        return false;
    }
    if !both {
        if used != n {
            return false;
        }
        emit(p, first, a);
        return true;
    }
    // `grid-column: main` is `main / main`
    let b = if a.kind == V_STR { a } else { mk(V_AUTO, 0.0, 0, 0) };
    if used < n {
        if tk(used).kind != T_DELIM || tk(used).ch != 47 {
            return false;
        }
        let u2 = lineTok(p, used + 1, n, &b);
        if u2 == 0 || used + 1 + u2 != n {
            return false;
        }
    }
    emit(p, first, a);
    emit(p, first + 1, b);
    return true;
}

/// `grid-area: <name>` or `<row-start> [/ <col-start> [/ <row-end> [/ <col-end>]]]`; what is left out is the first line again
/// when that is a name, else `auto`.
pub fn area(p: &P, n: int): bool {
    let rs = mk(V_AUTO, 0.0, 0, 0);
    let cs = rs;
    let re = rs;
    let ce = rs;
    let tmp = rs;
    let pos = 0;
    let cnt = 0;
    while pos < n && cnt < 4 {
        let u = lineTok(p, pos, n, &tmp);
        if u == 0 {
            return false;
        }
        if cnt == 0 { rs = tmp; } else if cnt == 1 { cs = tmp; } else if cnt == 2 { re = tmp; } else { ce = tmp; }
        cnt += 1;
        pos += u;
        if pos < n {
            if tk(pos).kind != T_DELIM || tk(pos).ch != 47 || pos + 1 >= n {
                return false;
            }
            pos += 1;
        }
    }
    if pos != n || cnt == 0 {
        return false;
    }
    if cnt < 2 && cs.kind == V_AUTO && rs.kind == V_STR { cs = rs; }
    if cnt < 3 && re.kind == V_AUTO && rs.kind == V_STR { re = rs; }
    if cnt < 4 && ce.kind == V_AUTO && cs.kind == V_STR { ce = cs; }
    emit(p, P_GRID_CS, cs);
    emit(p, P_GRID_CS + 1, ce);
    emit(p, P_GRID_CS + 2, rs);
    emit(p, P_GRID_CS + 3, re);
    return true;
}

/// The cells being parsed (interned name, -1 for `.`), row by row.
#[singleton]
#[thread]
let GA: [1024]int;

fn isNameCh(c: int): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45 || c >= 128;
}

fn rowsWarn(p: &P, k: int, msg: string): bool {
    warnAt(p, tk(k).line, tk(k).col, msg);
    return true;
}

/// `grid-template-areas: "a a" "b c"`: strings, one per row, of names and `.` (an empty cell). Stored as the rows, the columns
/// and the cells (see `P_GRID_AREAS`). A name that is not one rectangle, or a row of another length, drops the declaration
/// with a warning.
pub fn areas(p: &P, n: int): bool {
    if n == 1 && isWord(p, tk(0), "none") {
        emit(p, P_GRID_AREAS, mk(V_NONE, 0.0, 0, 0));
        return true;
    }
    if n == 0 {
        return false;
    }
    let cols = 0;
    for k in 0..n {
        if tk(k).kind != T_STR {
            return false;
        }
        let s = txt(p, tk(k));
        let c = 0;
        let i = 0;
        while i < s.len {
            if int(s[i]) == 32 || int(s[i]) == 9 {
                i += 1;
                continue;
            }
            let j = i;
            while j < s.len && int(s[j]) != 32 && int(s[j]) != 9 {
                j += 1;
            }
            if (k + 1) * (if c + 1 > cols { c + 1 } else { cols }) > 1024 || c >= MAX_TRACKS {
                return rowsWarn(p, k, "grid-template-areas is too big (declaration dropped)");
            }
            let id = -1;
            let dots = true;
            for q in i..j {
                if int(s[q]) != 46 { dots = false; }
                if !isNameCh(int(s[q])) && int(s[q]) != 46 {
                    return rowsWarn(p, k, "grid-template-areas: a name may hold letters, digits, - and _ (declaration dropped)");
                }
            }
            if !dots {
                if int(s[i]) == 46 {
                    return rowsWarn(p, k, "grid-template-areas: a name cannot hold '.' (declaration dropped)");
                }
                id = p.css.intern(s[i..j]);
            }
            GA[k * (if k == 0 { 0 } else { cols }) + c] = id;
            c += 1;
            i = j;
        }
        if c == 0 {
            return rowsWarn(p, k, "grid-template-areas: an empty row (declaration dropped)");
        }
        if k == 0 {
            cols = c;
        } else if c != cols {
            return rowsWarn(p, k, "grid-template-areas: rows have different numbers of cells (declaration dropped)");
        }
    }
    // each name is one rectangle
    for cj in 0..n * cols {
        let aid = GA[cj];
        let first = aid >= 0;
        for cq in 0..cj {
            if GA[cq] == aid { first = false; }
        }
        if !first {
            continue;
        }
        let ar0 = n;
        let ar1 = 0;
        let ac0 = cols;
        let ac1 = 0;
        let acnt = 0;
        for cq in 0..n * cols {
            if GA[cq] == aid {
                ar0 = if cq / cols < ar0 { cq / cols } else { ar0 };
                ar1 = if cq / cols > ar1 { cq / cols } else { ar1 };
                ac0 = if cq % cols < ac0 { cq % cols } else { ac0 };
                ac1 = if cq % cols > ac1 { cq % cols } else { ac1 };
                acnt += 1;
            }
        }
        if acnt != (ar1 - ar0 + 1) * (ac1 - ac0 + 1) {
            return rowsWarn(p, cj / cols, "grid-template-areas: an area must be a rectangle (declaration dropped)");
        }
    }
    emit(p, P_GRID_AREAS, mk(V_LIST, 0.0, p.css.paints.len, 0));
    pf(p, f32(n));
    pf(p, f32(cols));
    for cj in 0..n * cols {
        pf(p, f32(GA[cj]));
    }
    return true;
}

/// `place-items: <align> [<justify>]` and `place-self` (`ap` and `jp` the two longhands): one value sets both.
fn place(p: &P, n: int, ap: int, jp: int): bool {
    let a = mk(V_UNSET, 0.0, 0, 0);
    let used = parseVal(p, ap, 0, n, &a);
    if used == 0 {
        return false;
    }
    let b = a;
    if used < n {
        b = mk(V_UNSET, 0.0, 0, 0);
        if parseVal(p, jp, used, n, &b) != n - used {
            return false;
        }
    }
    emit(p, ap, a);
    emit(p, jp, b);
    return true;
}

/// `grid-auto-flow: row | column`, optionally with `dense`.
pub fn flow(p: &P, n: int): bool {
    let col = false;
    let dense = false;
    let axis = false;
    for k in 0..n {
        let t = tk(k);
        if isWord(p, t, "dense") && !dense {
            dense = true;
        } else if (isWord(p, t, "row") || isWord(p, t, "column")) && !axis {
            axis = true;
            col = isWord(p, t, "column");
        } else {
            return false;
        }
    }
    if n == 0 {
        return false;
    }
    emit(p, P_GRID_FLOW, mk(V_KW, 0.0, (if col { 1 } else { 0 }) + (if dense { 2 } else { 0 }), 0));
    return true;
}

/// Dispatch for the declaration `name`: false when it is not a grid property here (`ok` says whether it parsed).
pub fn declare(p: &P, name: string, n: int, ok: &bool): bool {
    if same(name, "grid-template-columns") { *ok = tracks(p, n, P_GRID_COL0); }
    else if same(name, "grid-template-rows") { *ok = tracks(p, n, P_GRID_ROWS); }
    else if same(name, "grid-auto-columns") { *ok = tracks(p, n, P_GRID_ACOLS); }
    else if same(name, "grid-auto-rows") { *ok = tracks(p, n, P_GRID_AROWS); }
    else if same(name, "grid-column") { *ok = lines(p, n, P_GRID_CS, true); }
    else if same(name, "grid-row") { *ok = lines(p, n, P_GRID_CS + 2, true); }
    else if same(name, "grid-column-start") { *ok = lines(p, n, P_GRID_CS, false); }
    else if same(name, "grid-column-end") { *ok = lines(p, n, P_GRID_CS + 1, false); }
    else if same(name, "grid-row-start") { *ok = lines(p, n, P_GRID_CS + 2, false); }
    else if same(name, "grid-row-end") { *ok = lines(p, n, P_GRID_CS + 3, false); }
    else if same(name, "grid-auto-flow") { *ok = flow(p, n); }
    else if same(name, "grid-area") { *ok = area(p, n); }
    else if same(name, "grid-template-areas") { *ok = areas(p, n); }
    else if same(name, "place-items") { *ok = place(p, n, P_ALIGN_ITEMS, P_JUSTIFY_ITEMS); }
    else if same(name, "place-self") { *ok = place(p, n, P_ALIGN_SELF, P_JUSTIFY_SELF); }
    else { return false; }
    return true;
}
