/// Slider math and drawing for `<input type="range">` (one thumb) and the two-thumb range slider
/// (`bind:high`). No Dom: `j3.ui.dom` calls `paint`, `j3.ui.inputs` calls the rest. Values are clamped to
/// `lo..hi` (a `max` below `min` collapses to `min`) and snapped to `step` counted from `lo`
/// (`step <= 0` is continuous). The track is inset by the thumb radius, `h / 2`, at both ends.

module j3.ui.slider;

use j3.game.Color;
use j3.gfx.paint;
use j3.math.Vec2;
use j3.math.{ max, min };

/// `v` clamped to `lo..hi` and snapped to `step`.
pub fn snap(v: f32, lo: f32, hi: f32, step: f32): f32 {
    let top = max(lo, hi);
    let r = v;
    if step > 0.0 && top > lo {
        let k = (r - lo) / step;
        r = lo + f32(int(k + (if k >= 0.0 { 0.5 } else { -0.5 }))) * step;
    }
    return max(lo, min(top, r));
}

/// The value at local x `x` of a box `w` wide and `h` tall.
pub fn fromX(x: f32, w: f32, h: f32, lo: f32, hi: f32, step: f32): f32 {
    let r = h / 2.0;
    let span = w - 2.0 * r;
    let t: f32 = 0.0;
    if span > 0.0 {
        t = max(0.0, min(1.0, (x - r) / span));
    }
    return snap(lo + t * (max(lo, hi) - lo), lo, hi, step);
}

/// Local x of the thumb for value `v`.
pub fn thumbX(v: f32, w: f32, h: f32, lo: f32, hi: f32): f32 {
    let r = h / 2.0;
    let t: f32 = 0.0;
    if hi > lo {
        t = max(0.0, min(1.0, (v - lo) / (hi - lo)));
    }
    return r + (w - 2.0 * r) * t;
}

/// Which thumb a press at local `x` grabs: 0 the low (or only) one, 1 the high one. Ties go to the
/// side the press is on, so thumbs stacked at one end can still be pulled apart.
pub fn pickThumb(x: f32, w: f32, h: f32, lo: f32, hi: f32, a: f32, b: f32): int {
    let da = x - thumbX(a, w, h, lo, hi);
    let db = x - thumbX(b, w, h, lo, hi);
    if da < 0.0 { da = 0.0 - da; }
    if db < 0.0 { db = 0.0 - db; }
    if da < db {
        return 0;
    }
    if db < da {
        return 1;
    }
    return if x < thumbX(a, w, h, lo, hi) { 0 } else { 1 };
}

/// `v` moved `dir` steps (a continuous slider moves 1/20 of its range), `big` for ten times that.
pub fn nudge(v: f32, lo: f32, hi: f32, step: f32, dir: int, big: bool): f32 {
    let s = step;
    if s <= 0.0 {
        s = (max(lo, hi) - lo) / 20.0;
    }
    if big {
        s = s * 10.0;
    }
    return snap(v + s * f32(dir), lo, hi, step);
}

/// Draw the slider in a `w` x `h` box: track, the filled part (from `lo` to the thumb, or between
/// the thumbs when `dual`), the thumbs, and a halo on the one in use when `focus`.
pub fn paint(w: f32, h: f32, lo: f32, hi: f32, a: f32, b: f32, dual: bool, acc: Color, focus: bool, thumb: int) {
    let cy = h / 2.0;
    let r = h / 2.0;
    let xa = thumbX(a, w, h, lo, hi);
    let xb = thumbX(b, w, h, lo, hi);
    paint.roundRect(Vec2 { x: 0.0, y: cy - 2.0 }, Vec2 { x: w, y: 4.0 }, 2.0, Color { r: 88, g: 91, b: 112, a: 255 });
    if dual {
        paint.roundRect(Vec2 { x: xa, y: cy - 2.0 }, Vec2 { x: max(0.0, xb - xa), y: 4.0 }, 2.0, acc);
    } else {
        paint.roundRect(Vec2 { x: 0.0, y: cy - 2.0 }, Vec2 { x: xa, y: 4.0 }, 2.0, acc);
    }
    let halo = Color { r: acc.r, g: acc.g, b: acc.b, a: 70 };
    if focus && (!dual || thumb == 0) {
        paint.circle(Vec2 { x: xa, y: cy }, r, halo);
    }
    paint.circle(Vec2 { x: xa, y: cy }, r - 1.0, acc);
    if dual {
        if focus && thumb == 1 {
            paint.circle(Vec2 { x: xb, y: cy }, r, halo);
        }
        paint.circle(Vec2 { x: xb, y: cy }, r - 1.0, acc);
    }
}
