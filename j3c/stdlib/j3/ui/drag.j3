/// Item drag and drop: `draggable` elements, `on:dragstart` / `on:dragenter` / `on:dragover` / `on:dragleave` / `on:drop`
/// / `on:dragend`, and the ghost. `step` runs once per frame from `inputs.begin` (before the overlays, so Escape cancels
/// the drag first) and `paint` from `inputs.overlay`. State is `Dom.drag` (`j3.ui.dragstate`); the markup side is
/// `j3c doc j3ui`.
///
/// A press on a `draggable` element (or inside one) that moves 4 px (`panelmath.SLOP`) becomes a drag: no click follows
/// it, the source gets `:dragging`, and the innermost element under the pointer with a drag handler is the target
/// (`on:drop` makes it `:drop-target` while the pointer is on it). Release drops, Escape cancels; `dragend` fires
/// either way, one frame after the release so `drop` always comes first. A source or target the page removes mid-drag
/// ends it quietly (`dragstate.forget`); losing window focus cancels it. Text boxes do not start drags (they select text). One drag at a time.

module j3.ui.drag;

use j3.game;
use j3.gfx.paint;
use j3.math.Vec2;
use j3.ui.css.{ FL_DRAGGING, FL_DROP };
use j3.ui.dom;
use j3.ui.dom.{ Dom, isDisabled };
use j3.ui.panelmath;

fn live(d: &Dom, id: int): bool {
    return id >= 0 && id < d.nodes.len && d.nodes.items[id].kind == dom.K_ELEM && !d.nodes.items[id].ghost;
}

/// The nearest draggable element at or above `from` (-1 for none; a text box on the way is a no).
fn sourceAt(d: &Dom, from: int): int {
    let c = from;
    while c >= 0 {
        let n = &d.nodes.items[c];
        if n.tag == d.tInput {
            return -1;
        }
        if n.draggable && !isDisabled(d, c) {
            return c;
        }
        c = n.parent;
    }
    return -1;
}

/// The innermost element at or above the pointer's hit that has a drag handler (-1 for none).
fn targetAt(d: &Dom): int {
    let c = d.rawHit;
    if c >= 0 && !dom.allowedByModal(d, c) {
        return -1;
    }
    while c >= 0 {
        if d.nodes.items[c].dragT != 0 {
            return c;
        }
        c = d.nodes.items[c].parent;
    }
    return -1;
}

/// Move the drop target to `t`: leave the old one, enter the new one.
fn retarget(d: &Dom, t: int) {
    let g = &d.drag;
    if t == g.tgt {
        return;
    }
    if live(d, g.tgt) {
        g.leaveN = g.tgt;
        g.leaveAt = d.frame;
        d.setFlag(g.tgt, FL_DROP, false);
    }
    g.tgt = t;
    g.rej = -1;
    if t >= 0 {
        g.enterN = t;
        g.enterAt = d.frame;
        if (d.nodes.items[t].dragT / 8) % 2 == 1 {
            d.setFlag(t, FL_DROP, true);
        }
    }
}

/// The drag is over: `dragend` on the source, flags cleared. The source stays in `Dom.drag` for the end frame's payload reads.
fn finish(d: &Dom, dropped: bool, state: int) {
    let g = &d.drag;
    if live(d, g.src) {
        d.setFlag(g.src, FL_DRAGGING, false);
    }
    g.endN = g.src;
    g.endAt = d.frame + 1;
    g.dropped = dropped;
    g.state = state;
}

/// The window lost focus while a real mouse button was held: SDL may never send the release.
fn lostFocus(d: &Dom): bool {
    return !d.simOn && !game.windowFocused();
}

pub fn step(d: &Dom) {
    let g = &d.drag;
    if g.state == 0 && g.tgt >= 0 {
        // the source went away mid-drag (`forget`): the target it was over is not a target any more
        d.setFlag(g.tgt, FL_DROP, false);
        g.tgt = -1;
    }
    if g.state == 3 {
        if !d.down {
            g.state = 0;
        }
        return;
    }
    if g.state == 0 {
        if !d.down || d.prevDown || d.downHit < 0 {
            return;
        }
        let s = sourceAt(d, d.downHit);
        if s < 0 {
            return;
        }
        g.src = s;
        g.state = 1;
        g.x0 = d.mx;
        g.y0 = d.my;
        g.tgt = -1;
        g.rej = -1;
        return;
    }
    if !live(d, g.src) {
        // the page removed the source: nothing to end
        if live(d, g.tgt) {
            d.setFlag(g.tgt, FL_DROP, false);
        }
        g.tgt = -1;
        g.state = 0;
        g.src = -1;
        return;
    }
    if g.state == 1 {
        if !d.down || lostFocus(d) {
            g.state = 0;
            return;
        }
        if !panelmath.pastSlop(d.mx - g.x0, d.my - g.y0) {
            return;
        }
        g.state = 2;
        g.startAt = d.frame;
        // the release will not be a click
        d.pressNode = -1;
        d.setFlag(g.src, FL_DRAGGING, true);
    }
    if d.kin.esc || lostFocus(d) {
        d.kin.esc = false;
        retarget(d, -1);
        finish(d, false, 3);
        return;
    }
    let t = targetAt(d);
    retarget(d, t);
    if !d.down {
        let hit = t >= 0 && (d.nodes.items[t].dragT / 8) % 2 == 1 && g.rej != t;
        if hit {
            g.dropN = t;
            g.dropAt = d.frame;
        }
        if t >= 0 {
            d.setFlag(t, FL_DROP, false);
        }
        g.tgt = -1;
        finish(d, hit, 0);
        return;
    }
    if t >= 0 {
        g.overN = t;
        g.overAt = d.frame;
    }
}

/// The ghost: a translucent copy of the source following the pointer, above everything (`drag-ghost="none"` skips it).
pub fn paint(d: &Dom) {
    let g = &d.drag;
    if g.state != 2 || !live(d, g.src) {
        return;
    }
    let n = &d.nodes.items[g.src];
    if n.noGhost || !dom.paintVisible(d, g.src) {
        return;
    }
    let dx = d.mx - g.x0;
    let dy = d.my - g.y0;
    paint.pushAlpha(0.6);
    if n.isFixed {
        // paintOpen resets the transform for a fixed box, so move the box itself (put back right after; paint has no early exit)
        let ox = n.x;
        let oy = n.y;
        n.x = ox + dx;
        n.y = oy + dy;
        d.paintDetached(g.src);
        n.x = ox;
        n.y = oy;
    } else {
        // paintOpen translates by (x - parent scroll, y + sy - parent scroll): shift the whole box to its page spot plus the drag
        let psx: f32 = 0.0;
        let ps: f32 = 0.0;
        if n.parent >= 0 {
            psx = d.nodes.items[n.parent].scrollX;
            ps = d.nodes.items[n.parent].scrollY;
        }
        paint.pushTranslate(Vec2 { x: d.absX(g.src) + dx - (n.x - psx + d.flipDx(g.src)), y: d.absY(g.src) + dy - (n.y + n.sy - ps + d.flipDy(g.src)) });
        d.paintDetached(g.src);
        paint.popTransform();
    }
    paint.popAlpha();
}
