/// Parser state (`P`, the token buffer) and the single-value parsers for `j3.ui.css`: property and keyword tables,
/// colors, lengths, gradients, shadows. `parseVal` (`j3.ui.cssprop`) builds on these.

module j3.ui.cssvalue;

use j3.text.{ Text, same };
use j3.ui.css.{ Css, P_ACCENT_COLOR, P_ALIGN_ITEMS, P_ANIM_DELAY, P_ANIM_DIR, P_ANIM_DUR, P_ANIM_EASE, P_ANIM_FILL };
use j3.ui.css.{ P_ANIM_ITER, P_ANIM_NAME, P_BACKDROP, P_BACKDROP_FILTER, P_BACKGROUND, P_BG_CLIP, P_BG_IMAGE, P_BORDER_IMAGE, P_BORDER_STYLE };
use j3.ui.css.{ P_BORDER_TOP_COLOR, P_BOTTOM, P_BOX_SHADOW, P_BOX_SIZING, P_COLOR, P_DISPLAY, P_FLEX, P_FLEX_DIRECTION };
use j3.ui.css.{ P_FONT_FAMILY, P_FONT_SIZE, P_FONT_WEIGHT, P_GRID_COL0, P_GRID_CS, P_GRID_FLOW, P_GRID_RE, P_JUSTIFY_CONTENT, P_LEFT, P_LINE_HEIGHT };
use j3.ui.css.{ P_MIN_HEIGHT, P_OPACITY, P_OVERFLOW_WRAP, P_OVERFLOW_X, P_OVERFLOW_Y, P_OVERSCROLL, P_POINTER_EVENTS, P_POSITION };
use j3.ui.css.{ P_RIPPLE, P_SB_THUMB, P_SB_TRACK, P_SB_WIDTH, P_SCROLL_BEHAVIOR, P_STROKE_COLOR, P_TEXT_ALIGN, P_TEXT_OVERFLOW };
use j3.ui.css.{ P_BORDER_IMG_W, P_BORDER_OUTSET, P_BORDER_REPEAT, P_BG_POS, P_BG_REPEAT, P_BG_SIZE, P_BORDER_SLICE, P_CLIP_PATH, P_MASK_IMAGE, P_OBJECT_FIT, P_OBJECT_POS, P_TINT };
use j3.ui.css.{ P_BOX_BREAK, P_VALIGN, P_IMAGE_RENDERING, P_ISOLATION, P_ORIGIN, P_TRANSLATE, P_SNAP_ALIGN, P_SNAP_STOP, P_SNAP_TYPE };
use j3.ui.css.{ P_TEXT_SHADOW, P_TRANS0, P_TRANSFORM, P_TRY, P_WHITE_SPACE, P_WIDTH, P_Z_INDEX, PROP_NAMES };
use j3.ui.css.{ P_FLEX_BASIS, P_FLEX_SHRINK, P_ALIGN_SELF, P_ORDER, P_LINE_CLAMP, P_VISIBILITY, P_CONTENT };
use j3.ui.css.{ P_GRID_AREAS, P_JUSTIFY_ITEMS, P_JUSTIFY_SELF };
use j3.ui.css.{ P_ALIGN_CONTENT, P_FLEX_WRAP, P_MAX_HEIGHT, P_MAX_WIDTH, P_USER_SELECT };
use j3.ui.css.{ P_LETTER_SPACING, P_TEXT_INDENT, P_TEXT_TRANSFORM, P_WORD_SPACING, P_ASPECT_RATIO, P_CURSOR, P_FONT_STYLE, P_FONT_VARIANT_NUMERIC, P_OUTLINE_COLOR, P_OUTLINE_OFFSET, P_OUTLINE_STYLE, P_OUTLINE_WIDTH, P_TEXT_DECORATION };
use j3.ui.css.{ P_FILTER, P_MIX_BLEND_MODE, P_PERSPECTIVE, P_ROTATE_X, P_ROTATE_Y, P_WAVE_AMP, P_WAVE_PERIOD };
use j3.ui.css.{ V_AUTO, V_COLOR, V_CURRENT, V_EASE, V_GRAD, V_KW, V_NONE, V_NUM };
use j3.ui.css.{ V_EM, V_PCT, V_PX, V_REM, V_SHADOW, V_STR, V_UNSET, Value, Warning };
use j3.ui.csslex.{ Lexer, T_COMMA, T_DELIM, T_FUNC, T_HASH, T_IDENT, T_NUM, T_PCT, T_RPAREN };
use j3.ui.csslex.Token;
use j3.ui.cssnames.namedColor;

pub struct P {
    css: &Css;
    lx: Lexer;
    file: string;
    scope: int;
    /// Number of selectors waiting in `PEND` for their block.
    npend: int;
    /// 1 while inside `@font-face`.
    mode: int;
    ffFamily: int;
    ffPath: string;
    ffHave: bool;
    /// Declarations emitted for the current block.
    ndecl: int;
    /// `css.media` index of the `@media` block being parsed (-1 outside one).
    mq: int;
    /// Source range of the current declaration's value (`late` keeps it when it holds `var()`).
    vs: int;
    ve: int;
    /// A declaration with `var()` inside a compound value may wait for the cascade (in `@keyframes` the stop resolves it per element, `motion.stopValue`; not in `style:` text).
    late: bool;
    /// Inside `@property` (`mode` 2): which descriptors were seen (1 syntax, 2 inherits, 4 initial-value), and their values.
    pdSeen: int;
    pdSyn: int;
    pdInh: bool;
    pdInit: string;
    pdLine: int;
    pdCol: int;
    /// Nesting level of the rule block being parsed (-1: not a style rule, nesting is not allowed); its selectors sit in `PEND[pbase..npend)`.
    nlev: int;
    pbase: int;
    /// Open `@media` blocks (they stack in `MQS` at the top level).
    mqd: int;
    /// Inside `@keyframes`: `initial`, `unset`, `revert` and `all` are not allowed there (`cssparse.keyframes`).
    kf: bool;
}

#[singleton]
#[thread]
let TOK: [192]Token;

/// `&TOK[i]` and `TOK[i] = t` for the other CSS parser modules (a singleton cannot be `pub`).
pub fn tk(i: int): &Token {
    return &TOK[i];
}

pub fn setTk(i: int, t: Token) {
    TOK[i] = t;
}

pub fn txt(p: &P, t: &Token): string {
    return p.lx.src[t.s..t.e];
}

pub fn isWord(p: &P, t: &Token, w: string): bool {
    return t.kind == T_IDENT && same(p.lx.src[t.s..t.e], w);
}

pub fn warnAt(p: &P, line: int, col: int, msg: string) {
    p.css.warns.push(Warning { file: p.file, line: line, col: col, msg: msg });
}

pub fn warnName(p: &P, line: int, col: int, pre: string, name: string, post: string) {
    let t = Text.new(p.css.mem);
    t.pushStr(pre);
    t.pushStr(name);
    t.pushStr(post);
    warnAt(p, line, col, t.str());
}

pub fn mk(kind: int, f: f32, i: int, c: int): Value {
    return Value { kind: kind, f: f, i: i, c: c };
}

pub fn wordIndex(list: string, w: string): int {
    let i = 0;
    let idx = 0;
    let n = list.len;
    while i < n {
        let j = i;
        while j < n && int(list[j]) != 32 {
            j += 1;
        }
        if same(list[i..j], w) {
            return idx;
        }
        idx += 1;
        i = j + 1;
    }
    return -1;
}

/// Longhand id for a CSS property name, or -1.
pub fn propId(name: string): int {
    if name.len == 0 || int(name[0]) == 45 {
        return -1;
    }
    return wordIndex(PROP_NAMES, name);
}

pub fn kwList(prop: int): string {
    if prop == P_VISIBILITY { return "visible hidden"; }
    if prop == P_MIX_BLEND_MODE { return "normal multiply screen overlay add"; }
    if prop == P_DISPLAY { return "inline block flex grid none contents"; }
    if prop == P_POSITION { return "static relative absolute fixed sticky"; }
    if prop == P_FLEX_DIRECTION { return "row column row-reverse column-reverse"; }
    if prop == P_FLEX_WRAP { return "nowrap wrap wrap-reverse"; }
    if prop == P_USER_SELECT { return "auto none text"; }
    if prop == P_TEXT_DECORATION { return "none underline line-through overline"; }
    if prop == P_FONT_STYLE { return "normal italic oblique"; }
    if prop == P_FONT_VARIANT_NUMERIC { return "normal tabular-nums proportional-nums lining-nums oldstyle-nums slashed-zero"; }
    if prop == P_TEXT_TRANSFORM { return "none uppercase lowercase capitalize"; }
    if prop == P_CURSOR { return "auto default pointer text crosshair move not-allowed grab grabbing ew-resize ns-resize col-resize row-resize wait progress help"; }
    if prop == P_ALIGN_CONTENT { return "stretch flex-start flex-end center space-between space-around space-evenly start end"; }
    if prop == P_JUSTIFY_CONTENT { return "flex-start flex-end center space-between space-around space-evenly start end"; }
    if prop == P_ALIGN_SELF { return "auto stretch flex-start flex-end center baseline start end"; }
    if prop == P_ALIGN_ITEMS || prop == P_JUSTIFY_ITEMS { return "stretch flex-start flex-end center baseline start end"; }
    if prop == P_JUSTIFY_SELF { return "auto stretch flex-start flex-end center baseline start end"; }
    if prop == P_BOX_SIZING { return "content-box border-box"; }
    if prop == P_OVERFLOW_Y || prop == P_OVERFLOW_X { return "visible hidden auto scroll clip"; }
    if prop == P_POINTER_EVENTS { return "auto none"; }
    if prop == P_ISOLATION { return "auto isolate"; }
    if prop == P_BOX_BREAK { return "slice clone"; }
    if prop == P_IMAGE_RENDERING { return "auto pixelated"; }
    if prop == P_VALIGN { return "baseline top bottom middle text-top text-bottom sub super"; }
    if prop == P_SB_WIDTH { return "auto thin none"; }
    if prop == P_SCROLL_BEHAVIOR { return "auto smooth"; }
    if prop == P_OVERSCROLL { return "auto contain"; }
    if prop == P_TRY { return "none flip-inline flip-block flip-both"; }
    if prop == P_BORDER_STYLE || prop == P_OUTLINE_STYLE { return "solid dashed dotted none"; }
    if prop == P_WHITE_SPACE { return "normal nowrap pre-line pre pre-wrap"; }
    if prop == P_TEXT_OVERFLOW { return "clip ellipsis"; }
    if prop == P_OVERFLOW_WRAP { return "normal break-word anywhere"; }
    if prop == P_BG_CLIP { return "border-box text"; }
    if prop == P_ANIM_DIR { return "normal reverse alternate alternate-reverse"; }
    if prop == P_ANIM_FILL { return "none forwards backwards both"; }
    if prop == P_OBJECT_FIT { return "fill contain cover none scale-down"; }
    if prop == P_SNAP_STOP { return "normal always"; }
    return "left right center justify";
}

pub const C_KW: int = 0;

pub const C_LEN: int = 1;

pub const C_COLOR: int = 2;

pub const C_NUM: int = 3;

pub const C_FONT: int = 4;

pub const C_XFORM: int = 5;

const C_TRACK: int = 6;

const C_TRANS: int = 7;

pub const C_PAINT: int = 8;

pub const C_ANIM: int = 9;

pub const C_TIME: int = 10;

pub const C_EASE: int = 11;

pub const C_RIPPLE: int = 12;

/// Short lists of lengths and shapes (`j3.ui.cssimage`).
pub const C_SHAPE: int = 13;

pub const C_FILTER: int = 14;

pub const C_POST: int = 15;

pub const C_PERSPECTIVE: int = 16;

pub const C_ANGLE: int = 17;

pub fn catOf(p: int): int {
    if p == P_BACKDROP_FILTER { return C_FILTER; }
    if p == P_FILTER { return C_POST; }
    if p == P_PERSPECTIVE { return C_PERSPECTIVE; }
    if p == P_ROTATE_X || p == P_ROTATE_Y { return C_ANGLE; }
    if p == P_VISIBILITY || p == P_MIX_BLEND_MODE || p == P_TEXT_DECORATION || p == P_FONT_STYLE || p == P_FONT_VARIANT_NUMERIC || p == P_TEXT_TRANSFORM || p == P_CURSOR || p == P_OUTLINE_STYLE || (p >= P_SNAP_TYPE && p <= P_SNAP_STOP) || p == P_ISOLATION || p == P_IMAGE_RENDERING || p == P_BOX_BREAK { return C_KW; }
    if p == P_ALIGN_SELF || p == P_DISPLAY || p == P_POSITION || p == P_FLEX_DIRECTION || p == P_JUSTIFY_CONTENT || p == P_ALIGN_ITEMS || p == P_FLEX_WRAP || p == P_ALIGN_CONTENT || p == P_USER_SELECT {
        return C_KW;
    }
    if p == P_JUSTIFY_ITEMS || p == P_JUSTIFY_SELF { return C_KW; }
    if p == P_GRID_FLOW || p == P_BOX_SIZING || p == P_OVERFLOW_Y || p == P_TEXT_ALIGN || p == P_BORDER_STYLE {
        return C_KW;
    }
    if p >= P_WHITE_SPACE && p <= P_OVERFLOW_WRAP || p == P_BG_CLIP || p == P_ANIM_DIR || p == P_ANIM_FILL || (p >= P_OVERFLOW_X && p <= P_SB_WIDTH) || p == P_SCROLL_BEHAVIOR || p == P_OVERSCROLL || p == P_TRY || p == P_OBJECT_FIT {
        return C_KW;
    }
    if p == P_ANIM_NAME { return C_ANIM; }
    if p == P_ANIM_DUR || p == P_ANIM_DELAY || p == P_WAVE_PERIOD { return C_TIME; }
    if p == P_ANIM_EASE { return C_EASE; }
    if p == P_RIPPLE { return C_RIPPLE; }
    if p == P_LINE_CLAMP || p == P_ORDER || p == P_FLEX_SHRINK || p == P_FLEX || p == P_OPACITY || p == P_FONT_WEIGHT || p == P_ASPECT_RATIO || p == P_LINE_HEIGHT || p == P_Z_INDEX || p == P_ANIM_ITER {
        return C_NUM;
    }
    if p == P_BACKGROUND || p == P_COLOR || p == P_ACCENT_COLOR || p == P_OUTLINE_COLOR || (p >= P_BORDER_TOP_COLOR && p < P_BORDER_TOP_COLOR + 4) || p == P_STROKE_COLOR || p == P_SB_THUMB || p == P_SB_TRACK || p == P_BACKDROP || p == P_TINT {
        return C_COLOR;
    }
    if p == P_FONT_FAMILY || p == P_CONTENT { return C_FONT; }
    if p == P_TRANSFORM || (p >= P_TRANSLATE && p <= P_ORIGIN) { return C_XFORM; }
    if (p >= P_GRID_COL0 && p < P_GRID_COL0 + 4) || p == P_GRID_AREAS { return C_TRACK; }
    if p == P_BG_IMAGE || p == P_BOX_SHADOW || p == P_BORDER_IMAGE || p == P_TEXT_SHADOW || p == P_MASK_IMAGE { return C_PAINT; }
    if p == P_OBJECT_POS || p == P_BG_SIZE || p == P_BG_POS || p == P_BG_REPEAT || p == P_BORDER_SLICE || p == P_BORDER_REPEAT || p == P_BORDER_IMG_W || p == P_BORDER_OUTSET || p == P_CLIP_PATH { return C_SHAPE; }
    if p >= P_TRANS0 && p <= P_TRANS0 + 3 { return C_TRANS; }
    return C_LEN;
}

pub fn inherits(p: int): bool {
    return p == P_VISIBILITY || p == P_COLOR || p == P_FONT_SIZE || p == P_FONT_WEIGHT || p == P_FONT_FAMILY || p == P_TEXT_ALIGN || p == P_LINE_HEIGHT || p == P_ACCENT_COLOR || p == P_WHITE_SPACE || p == P_OVERFLOW_WRAP || p == P_USER_SELECT || p == P_TEXT_DECORATION || p == P_FONT_STYLE || p == P_FONT_VARIANT_NUMERIC || (p >= P_LETTER_SPACING && p <= P_TEXT_INDENT) || p == P_CURSOR || (p >= P_TEXT_SHADOW && p <= P_STROKE_COLOR) || (p >= P_WAVE_AMP && p <= P_WAVE_PERIOD) || p == P_IMAGE_RENDERING;
}

pub fn initial(p: int): Value {
    let cat = catOf(p);
    // Unspecified basis preserves numeric flex: n (zero basis); explicit auto uses width/height.
    if p == P_FLEX_BASIS { return mk(V_NONE, 0.0, 0, 0); }
    if p == P_FLEX_SHRINK { return mk(V_NUM, 1.0, 0, 0); }
    if p == P_LINE_CLAMP { return mk(V_NONE, 0.0, 0, 0); }
    if p == P_ORDER { return mk(V_NUM, 0.0, 0, 0); }
    if p == P_OUTLINE_STYLE { return mk(V_KW, 0.0, 3, 0); }
    if p == P_VALIGN { return mk(V_KW, 0.0, 0, 0); }
    if p == P_ASPECT_RATIO || (p >= P_GRID_CS && p <= P_GRID_RE) { return mk(V_AUTO, 0.0, 0, 0); }
    if cat == C_KW { return mk(V_KW, 0.0, 0, 0); }
    if cat == C_ANGLE { return mk(V_NUM, 0.0, 0, 0); }
    if cat == C_POST || cat == C_PERSPECTIVE { return mk(V_NONE, 0.0, 0, 0); }
    if p == P_OPACITY { return mk(V_NUM, 1.0, 0, 0); }
    if p == P_FONT_WEIGHT { return mk(V_NUM, 400.0, 0, 0); }
    if p == P_ANIM_ITER { return mk(V_NUM, 1.0, 0, 0); }
    if p == P_ANIM_DUR || p == P_ANIM_DELAY || p == P_WAVE_PERIOD { return mk(V_NUM, 0.0, 0, 0); }
    if p == P_ANIM_EASE { return mk(V_EASE, 0.0, 0, 0); }
    if p == P_FLEX { return mk(V_NUM, 0.0, 0, 0); }
    if p == P_Z_INDEX { return mk(V_AUTO, 0.0, 0, 0); }
    if p == P_LINE_HEIGHT || p == P_ACCENT_COLOR { return mk(V_AUTO, 0.0, 0, 0); }
    if p == P_COLOR { return mk(V_COLOR, 0.0, 0, 255); }
    if p == P_BACKGROUND { return mk(V_COLOR, 0.0, 0, 0); }
    if cat == C_COLOR { return mk(V_CURRENT, 0.0, 0, 0); }
    if p == P_CONTENT { return mk(V_NONE, 0.0, 0, 0); }
    if p == P_FONT_FAMILY { return mk(V_STR, 0.0, -1, 0); }
    if p == P_FONT_SIZE { return mk(V_PX, 16.0, 0, 0); }
    if cat == C_XFORM || cat == C_TRACK || cat == C_TRANS || cat == C_PAINT || cat == C_ANIM || cat == C_RIPPLE || cat == C_SHAPE || cat == C_FILTER { return mk(V_NONE, 0.0, 0, 0); }
    if p >= P_LEFT && p <= P_BOTTOM { return mk(V_AUTO, 0.0, 0, 0); }
    if (p >= P_WIDTH && p <= P_MIN_HEIGHT) || p == P_MAX_HEIGHT || p == P_MAX_WIDTH { return mk(V_AUTO, 0.0, 0, 0); }
    return mk(V_PX, 0.0, 0, 0);
}

fn hexVal(c: int): int {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    if c >= 65 && c <= 70 { return c - 55; }
    return -1;
}

fn clampi(v: int, lo: int, hi: int): int {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn packRgba(r: int, g: int, b: int, a: int): int {
    return r * 16777216 + g * 65536 + b * 256 + a;
}

pub fn unitIs(p: &P, t: &Token, u: string): bool {
    return same(p.lx.src[t.us..t.ue], u);
}

/// Hue token as degrees: a bare number or any angle unit (`deg`, `turn`, `rad`, `grad`).
fn hueTok(p: &P, t: &Token, out: &f32): bool {
    if t.kind != T_NUM {
        return false;
    }
    if t.us == t.ue {
        *out = t.f;
        return true;
    }
    return angleOf(p, t, out);
}

/// A number token as is, or a percentage of `full` (`rgb(100% ...)` is 255; alpha passes `full` 1).
fn numTok(t: &Token, full: f32, out: &f32): bool {
    if t.kind == T_NUM {
        *out = t.f;
        return true;
    }
    if t.kind == T_PCT {
        *out = t.f * full / 100.0;
        return true;
    }
    return false;
}

/// Packed RGBA of an HSL color: hue in degrees (wrapped), saturation and lightness in percent (clamped).
fn hslToRgb(h: f32, sp: f32, lp: f32, al: int): int {
    let hh = h - 360.0 * f32(int(h / 360.0));
    if hh < 0.0 {
        hh += 360.0;
    }
    let s = sp / 100.0;
    if s < 0.0 { s = 0.0; }
    if s > 1.0 { s = 1.0; }
    let l = lp / 100.0;
    if l < 0.0 { l = 0.0; }
    if l > 1.0 { l = 1.0; }
    let d = 2.0 * l - 1.0;
    if d < 0.0 { d = -d; }
    let c = (1.0 - d) * s;
    let hs = hh / 60.0;
    let u = hs - 2.0 * f32(int(hs / 2.0));
    let w = u - 1.0;
    if w < 0.0 { w = -w; }
    let x = c * (1.0 - w);
    let r1: f32 = 0.0;
    let g1: f32 = 0.0;
    let b1: f32 = 0.0;
    if hs < 1.0 {
        r1 = c;
        g1 = x;
    } else if hs < 2.0 {
        r1 = x;
        g1 = c;
    } else if hs < 3.0 {
        g1 = c;
        b1 = x;
    } else if hs < 4.0 {
        g1 = x;
        b1 = c;
    } else if hs < 5.0 {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m = l - c / 2.0;
    return packRgba(to255(r1 + m), to255(g1 + m), to255(b1 + m), al);
}

fn to255(v: f32): int {
    return clampi(int(v * 255.0 + 0.5), 0, 255);
}

/// `rgb(`, `rgba(`, `hsl(` or `hsla(` at `TOK[k]`: commas (`rgb(1, 2, 3, 0.5)`), or spaces with `/` before an alpha
/// (`hsl(120 100% 25% / 50%)`). Returns tokens used, 0 when it is not one.
fn funcColor(p: &P, k: int, n: int, hsl: bool, out: &Value): int {
    let v: [3]f32 = [0.0, 0.0, 0.0];
    let full: f32 = 255.0;
    if hsl {
        full = 100.0;
    }
    let comma = k + 2 < n && TOK[k + 2].kind == T_COMMA;
    let j = k + 1;
    for i in 0..3 {
        if i > 0 && comma {
            if j >= n || TOK[j].kind != T_COMMA {
                return 0;
            }
            j += 1;
        }
        if j >= n {
            return 0;
        }
        let x: f32 = 0.0;
        let ok = false;
        if hsl && i == 0 {
            ok = hueTok(p, &TOK[j], &x);
        } else {
            ok = numTok(&TOK[j], full, &x);
        }
        if !ok {
            return 0;
        }
        v[i] = x;
        j += 1;
    }
    let al = 255;
    if j < n && ((comma && TOK[j].kind == T_COMMA) || (!comma && TOK[j].kind == T_DELIM && TOK[j].ch == 47)) {
        j += 1;
        let a: f32 = 0.0;
        if j >= n || !numTok(&TOK[j], 1.0, &a) {
            return 0;
        }
        al = clampi(int(a * 255.0 + 0.5), 0, 255);
        j += 1;
    }
    if j >= n || TOK[j].kind != T_RPAREN {
        return 0;
    }
    out.kind = V_COLOR;
    if hsl {
        out.c = hslToRgb(v[0], v[1], v[2], al);
    } else {
        out.c = packRgba(clampi(int(v[0] + 0.5), 0, 255), clampi(int(v[1] + 0.5), 0, 255), clampi(int(v[2] + 0.5), 0, 255), al);
    }
    return j - k + 1;
}

/// One `color-mix()` argument at `TOK[j]`: a color with an optional percentage before or after it.
/// Returns the next index, -1 when invalid. `pct` is -1.0 when absent.
fn mixArg(p: &P, j: int, n: int, c: &Value, pct: &f32): int {
    *pct = -1.0;
    let given = false;
    if j < n && TOK[j].kind == T_PCT {
        *pct = TOK[j].f;
        given = true;
        j += 1;
    }
    if j >= n {
        return -1;
    }
    let used = parseColor(p, j, n, c);
    if used == 0 || c.kind != V_COLOR {
        return -1;
    }
    j += used;
    if j < n && TOK[j].kind == T_PCT {
        if given {
            return -1;
        }
        *pct = TOK[j].f;
        given = true;
        j += 1;
    }
    if given && (*pct < 0.0 || *pct > 100.0) {
        return -1;
    }
    return j;
}

/// `color-mix(in srgb, <color> [<pct>], <color> [<pct>])` at `TOK[k]` (CSS Color 5: a missing percentage is
/// 100 minus the other, both missing is 50/50, a sum under 100 scales the alpha, a sum of 0 is invalid;
/// premultiplied alpha). Only `srgb`. Returns tokens used, 0 when invalid.
fn colorMix(p: &P, k: int, n: int, out: &Value): int {
    if k + 4 >= n || !isWord(p, &TOK[k + 1], "in") || !isWord(p, &TOK[k + 2], "srgb") || TOK[k + 3].kind != T_COMMA {
        return 0;
    }
    let c1 = Value { kind: V_UNSET, f: 0.0, i: 0, c: 0 };
    let c2 = c1;
    let p1: f32 = 0.0;
    let p2: f32 = 0.0;
    let j = mixArg(p, k + 4, n, &c1, &p1);
    if j < 0 || j >= n || TOK[j].kind != T_COMMA {
        return 0;
    }
    j = mixArg(p, j + 1, n, &c2, &p2);
    if j < 0 || j >= n || TOK[j].kind != T_RPAREN {
        return 0;
    }
    if p1 < 0.0 && p2 < 0.0 {
        p1 = 50.0;
        p2 = 50.0;
    } else if p1 < 0.0 {
        p1 = 100.0 - p2;
    } else if p2 < 0.0 {
        p2 = 100.0 - p1;
    }
    let sum = p1 + p2;
    if sum <= 0.0 {
        return 0;
    }
    let w1 = p1 / sum;
    let w2 = p2 / sum;
    let a1 = f32(c1.c % 256) / 255.0;
    let a2 = f32(c2.c % 256) / 255.0;
    let a = a1 * w1 + a2 * w2;
    let r: f32 = 0.0;
    let g: f32 = 0.0;
    let b: f32 = 0.0;
    if a > 0.0 {
        r = (f32((c1.c / 16777216) % 256) * a1 * w1 + f32((c2.c / 16777216) % 256) * a2 * w2) / a;
        g = (f32((c1.c / 65536) % 256) * a1 * w1 + f32((c2.c / 65536) % 256) * a2 * w2) / a;
        b = (f32((c1.c / 256) % 256) * a1 * w1 + f32((c2.c / 256) % 256) * a2 * w2) / a;
    }
    if sum < 100.0 {
        a = a * sum / 100.0;
    }
    out.kind = V_COLOR;
    out.c = packRgba(clampi(int(r + 0.5), 0, 255), clampi(int(g + 0.5), 0, 255), clampi(int(b + 0.5), 0, 255), clampi(int(a * 255.0 + 0.5), 0, 255));
    return j - k + 1;
}

/// A color at `TOK[k]`; returns tokens used, 0 when it is not one.
pub fn parseColor(p: &P, k: int, n: int, out: &Value): int {
    let t = &TOK[k];
    if t.kind == T_HASH {
        let len = t.e - t.s;
        if len != 3 && len != 4 && len != 6 && len != 8 {
            return 0;
        }
        let d: int = 0;
        let r = 0;
        let g = 0;
        let b = 0;
        let a = 255;
        let digits = 0;
        let ok = true;
        for i in 0..len {
            let h = hexVal(int(p.lx.src[t.s + i]));
            if h < 0 {
                ok = false;
            }
            d = d * 16 + h;
        }
        if !ok {
            return 0;
        }
        digits = len;
        if digits <= 4 {
            // d holds 3 or 4 nibbles
            let x = d;
            if digits == 4 {
                a = (x % 16) * 17;
                x = x / 16;
            }
            b = (x % 16) * 17;
            x = x / 16;
            g = (x % 16) * 17;
            r = (x / 16) * 17;
        } else {
            let y = d;
            if digits == 8 {
                a = y % 256;
                y = y / 256;
            }
            b = y % 256;
            g = (y / 256) % 256;
            r = y / 65536;
        }
        out.kind = V_COLOR;
        out.c = packRgba(r, g, b, a);
        return 1;
    }
    if t.kind == T_IDENT {
        if isWord(p, t, "transparent") {
            out.kind = V_COLOR;
            out.c = 0;
            return 1;
        }
        if isWord(p, t, "currentcolor") {
            out.kind = V_CURRENT;
            return 1;
        }
        let nc = namedColor(txt(p, t));
        if nc >= 0 {
            out.kind = V_COLOR;
            out.c = packRgba((nc / 65536) % 256, (nc / 256) % 256, nc % 256, 255);
            return 1;
        }
        return 0;
    }
    if t.kind == T_FUNC {
        let fname = txt(p, t);
        if same(fname, "rgb") || same(fname, "rgba") {
            return funcColor(p, k, n, false, out);
        }
        if same(fname, "hsl") || same(fname, "hsla") {
            return funcColor(p, k, n, true, out);
        }
        if same(fname, "color-mix") {
            return colorMix(p, k, n, out);
        }
        return 0;
    }
    return 0;
}

pub fn parseLen(p: &P, t: &Token, out: &Value): bool {
    if t.kind == T_PCT {
        out.kind = V_PCT;
        out.f = t.f;
        return true;
    }
    if t.kind == T_NUM {
        if t.us == t.ue {
            if t.f == 0.0 {
                out.kind = V_PX;
                out.f = 0.0;
                return true;
            }
            return false;
        }
        if unitIs(p, t, "px") {
            out.kind = V_PX;
            out.f = t.f;
            return true;
        }
        return false;
    }
    if isWord(p, t, "auto") {
        // ponytail: `auto` is accepted on every length property (padding, radius ...), not only
        // the ones CSS allows. Add a per-property check if a stage needs the rejection.
        out.kind = V_AUTO;
        return true;
    }
    return false;
}

/// `parseLen`, plus `em` and `rem` (`V_EM` / `V_REM`, resolved to px by `computeStyle`). Only for properties
/// whose value goes through the cascade (not gradient stops, shadows, filters, positions).
pub fn parseLenU(p: &P, t: &Token, out: &Value): bool {
    if parseLen(p, t, out) {
        return true;
    }
    if t.kind == T_NUM && t.us != t.ue {
        if unitIs(p, t, "em") { out.kind = V_EM; out.f = t.f; return true; }
        if unitIs(p, t, "rem") { out.kind = V_REM; out.f = t.f; return true; }
    }
    return false;
}

pub fn pf(p: &P, v: f32) {
    p.css.paints.push(v);
}

/// Angle token as degrees; false when it is not one (`deg`, `turn`, `rad`, `grad`, or a bare 0).
pub fn angleOf(p: &P, t: &Token, out: &f32): bool {
    if t.kind != T_NUM {
        return false;
    }
    if t.us == t.ue {
        if t.f == 0.0 {
            *out = 0.0;
            return true;
        }
        return false;
    }
    if unitIs(p, t, "deg") { *out = t.f; return true; }
    if unitIs(p, t, "turn") { *out = t.f * 360.0; return true; }
    if unitIs(p, t, "rad") { *out = t.f * 57.29578; return true; }
    if unitIs(p, t, "grad") { *out = t.f * 0.9; return true; }
    return false;
}

/// `to top|right|bottom|left` (one or two sides) at `TOK[k..]` as degrees; returns tokens used.
/// ponytail: `to top right` is a plain 45 degrees; CSS bends it to the box aspect so the 50% line
/// passes the other two corners.
fn toSide(p: &P, k: int, n: int, out: &f32): int {
    if !isWord(p, &TOK[k], "to") || k + 1 >= n {
        return 0;
    }
    let x = 0;
    let y = 0;
    let used = 1;
    while used < 3 && k + used < n && TOK[k + used].kind == T_IDENT {
        let t = &TOK[k + used];
        if isWord(p, t, "left") { x = -1; }
        else if isWord(p, t, "right") { x = 1; }
        else if isWord(p, t, "top") { y = -1; }
        else if isWord(p, t, "bottom") { y = 1; }
        else { break; }
        used += 1;
    }
    if used == 1 {
        return 0;
    }
    if x == 0 && y == -1 { *out = 0.0; }
    else if x == 1 && y == 0 { *out = 90.0; }
    else if x == 0 && y == 1 { *out = 180.0; }
    else if x == -1 && y == 0 { *out = 270.0; }
    else if x == 1 && y == -1 { *out = 45.0; }
    else if x == 1 && y == 1 { *out = 135.0; }
    else if x == -1 && y == 1 { *out = 225.0; }
    else { *out = 315.0; }
    return used;
}

/// One `linear-gradient(` / `radial-gradient(` / `conic-gradient(` at `TOK[k]`, appended to
/// `paints` as a layer. Returns tokens used (through the closing paren), 0 when invalid.
/// ponytail: stop colors are colors (`var()` is substituted before this runs, see `cssmatch.applyDeferred`); radial is a
/// centered farthest-corner ellipse and conic is centered, so size and `at` words are skipped.
pub fn gradientAt(p: &P, k: int, n: int): int {
    let t = &TOK[k];
    if t.kind != T_FUNC {
        return 0;
    }
    let ty = -1;
    if same(txt(p, t), "linear-gradient") { ty = 0; }
    else if same(txt(p, t), "radial-gradient") { ty = 1; }
    else if same(txt(p, t), "conic-gradient") { ty = 2; }
    if ty < 0 {
        return 0;
    }
    let j = k + 1;
    let angle: f32 = 180.0;
    if ty == 2 {
        angle = 0.0;
    }
    // optional leading direction / shape words, then a comma
    if j < n && TOK[j].kind == T_NUM {
        if ty == 1 || !angleOf(p, &TOK[j], &angle) {
            return 0;
        }
        j += 1;
        if j >= n || TOK[j].kind != T_COMMA {
            return 0;
        }
        j += 1;
    } else if j < n && TOK[j].kind == T_IDENT && !isWord(p, &TOK[j], "transparent") && !isWord(p, &TOK[j], "currentcolor") && namedColor(txt(p, &TOK[j])) < 0 {
        if ty == 0 {
            let side = toSide(p, j, n, &angle);
            if side == 0 {
                return 0;
            }
            j += side;
        } else if ty == 2 && isWord(p, &TOK[j], "from") && j + 1 < n {
            if !angleOf(p, &TOK[j + 1], &angle) {
                return 0;
            }
            j += 2;
        }
        while j < n && TOK[j].kind != T_COMMA {
            j += 1;
        }
        if j >= n {
            return 0;
        }
        j += 1;
    }
    let base = p.css.paints.len;
    pf(p, f32(ty));
    pf(p, angle);
    pf(p, 0.0);
    let ns = 0;
    let colorVal = mk(V_UNSET, 0.0, 0, 0);
    while true {
        let used = parseColor(p, j, n, &colorVal);
        if used == 0 || colorVal.kind != V_COLOR {
            p.css.paints.len = base;
            return 0;
        }
        j += used;
        let c = colorVal.c;
        let at: f32 = -1.0;
        let reps = 1;
        if j < n && TOK[j].kind == T_PCT {
            at = TOK[j].f / 100.0;
            j += 1;
            if j < n && TOK[j].kind == T_PCT {
                // `red 10% 30%`: the same color at both ends
                reps = 2;
            }
        }
        for r in 0..reps {
            if r == 1 {
                at = TOK[j].f / 100.0;
                j += 1;
            }
            pf(p, at);
            pf(p, f32((c / 16777216) % 256));
            pf(p, f32((c / 65536) % 256));
            pf(p, f32((c / 256) % 256));
            pf(p, f32(c % 256));
            ns += 1;
        }
        if j >= n || ns > 16 {
            p.css.paints.len = base;
            return 0;
        }
        if TOK[j].kind == T_COMMA {
            j += 1;
        } else if TOK[j].kind == T_RPAREN {
            j += 1;
            break;
        } else {
            p.css.paints.len = base;
            return 0;
        }
    }
    if ns < 2 {
        p.css.paints.len = base;
        return 0;
    }
    p.css.paints.items[base + 2] = f32(ns);
    fixStops(p, base + 3, ns);
    return j - k;
}

/// Fill in the stops without a position (`-1`) like CSS: the ends default to 0 and 1, the rest
/// spread evenly between their neighbors, and no stop sits before the one ahead of it.
fn fixStops(p: &P, at0: int, ns: int) {
    let a = p.css.paints.items;
    if a[at0] < 0.0 { a[at0] = 0.0; }
    if a[at0 + (ns - 1) * 5] < 0.0 { a[at0 + (ns - 1) * 5] = 1.0; }
    let i = 1;
    while i < ns {
        if a[at0 + i * 5] < 0.0 {
            let j = i;
            while a[at0 + j * 5] < 0.0 {
                j += 1;
            }
            let lo = a[at0 + (i - 1) * 5];
            let hi = a[at0 + j * 5];
            for q in i..j {
                a[at0 + q * 5] = lo + (hi - lo) * f32(q - i + 1) / f32(j - i + 1);
            }
            i = j;
        }
        i += 1;
    }
    for q in 1..ns {
        if a[at0 + q * 5] < a[at0 + (q - 1) * 5] {
            a[at0 + q * 5] = a[at0 + (q - 1) * 5];
        }
    }
}

/// Comma-separated gradients starting at `TOK[k]`; returns tokens used. With `colorTail` a
/// trailing color (the `background` shorthand's base color) is allowed and left unread.
pub fn gradients(p: &P, k: int, n: int, out: &Value, colorTail: bool): int {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let j = k;
    let end = k;
    let count = 0;
    while j < n {
        let used = gradientAt(p, j, n);
        if used == 0 {
            if count > 0 && !colorTail {
                // a comma with nothing valid after it
                count = 0;
            }
            break;
        }
        count += 1;
        j += used;
        end = j;
        if j < n && TOK[j].kind == T_COMMA {
            j += 1;
        } else {
            break;
        }
    }
    if count == 0 {
        p.css.paints.len = head;
        return 0;
    }
    p.css.paints.items[head] = f32(count);
    setv(out, mk(V_GRAD, 0.0, head, 0));
    return end - k;
}

/// Lengths and a color of one shadow at `TOK[k..e)`; false when invalid.
fn shadowAt(p: &P, k: int, e: int): bool {
    let inset: f32 = 0.0;
    let nl = 0;
    let lens: [4]f32 = [0.0, 0.0, 0.0, 0.0];
    let col = mk(V_UNSET, 0.0, 0, 0);
    let j = k;
    while j < e {
        let t = &TOK[j];
        if isWord(p, t, "inset") {
            inset = 1.0;
            j += 1;
        } else if t.kind == T_NUM {
            let v = mk(V_UNSET, 0.0, 0, 0);
            if nl >= 4 || !parseLen(p, t, &v) || v.kind != V_PX {
                return false;
            }
            lens[nl] = v.f;
            nl += 1;
            j += 1;
        } else {
            let used = parseColor(p, j, e, &col);
            if used == 0 || col.kind != V_COLOR {
                return false;
            }
            j += used;
        }
    }
    if nl < 2 || col.kind != V_COLOR || lens[2] < 0.0 {
        return false;
    }
    pf(p, inset);
    for q in 0..4 {
        pf(p, lens[q]);
    }
    pf(p, f32((col.c / 16777216) % 256));
    pf(p, f32((col.c / 65536) % 256));
    pf(p, f32((col.c / 256) % 256));
    pf(p, f32(col.c % 256));
    return true;
}

/// `box-shadow` list at `TOK[k..n)`.
pub fn shadows(p: &P, k: int, n: int, out: &Value): int {
    let head = p.css.paints.len;
    pf(p, 0.0);
    let count = 0;
    let s = k;
    while s <= n {
        // a shadow ends at a top-level comma (colors never contain one outside rgb( ))
        let e = s;
        let depth = 0;
        while e < n {
            if TOK[e].kind == T_FUNC { depth += 1; }
            else if TOK[e].kind == T_RPAREN { depth -= 1; }
            else if TOK[e].kind == T_COMMA && depth == 0 { break; }
            e += 1;
        }
        if !shadowAt(p, s, e) {
            p.css.paints.len = head;
            return 0;
        }
        count += 1;
        s = e + 1;
        if e >= n {
            break;
        }
    }
    p.css.paints.items[head] = f32(count);
    setv(out, mk(V_SHADOW, 0.0, head, 0));
    return n - k;
}

pub fn setv(out: &Value, v: Value) {
    out.kind = v.kind;
    out.f = v.f;
    out.i = v.i;
    out.c = v.c;
}
