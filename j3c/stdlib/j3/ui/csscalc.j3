/// `calc()`, `min()`, `max()`, `clamp()` and the viewport units (`vw` `vh` `vmin` `vmax`) as lengths.
/// Parsed to a postfix program in `Css.paints` (pairs of `[op, arg]`; `V_CALC.i` is the offset,
/// `.c` the op count) and evaluated at layout time by `calcEval` against a percentage basis and the
/// viewport. Private to the CSS parser and `dom`.

module j3.ui.csscalc;

use j3.math.{ max, min };
use j3.ui.css.{ Css, NPROPS, P_FONT_SIZE, V_CALC, V_PX, Value };
use j3.ui.csslex.{ T_COMMA, T_DELIM, T_FUNC, T_LPAREN, T_NUM, T_PCT, T_RPAREN };
use j3.ui.cssvalue.{ mk, P, tk, txt, unitIs };
use j3.text.same;

pub const O_PX: int = 0;
pub const O_PCT: int = 1;
const O_VW: int = 2;
const O_VH: int = 3;
const O_VMIN: int = 4;
const O_VMAX: int = 5;
const O_NUM: int = 6;
pub const O_ADD: int = 7;
const O_SUB: int = 8;
const O_MUL: int = 9;
const O_DIV: int = 10;
const O_MIN: int = 11;
const O_MAX: int = 12;
/// `em` (of `Value.f`, the element's font-size) and `rem` (of `css.rootFs`): pushes like the units above.
const O_EM: int = 13;
const O_REM: int = 14;

/// Most ops in one expression, and its deepest stack (`calcEval` keeps 16 values).
const MAX_OPS: int = 48;
const MAX_STACK: int = 12;

#[singleton]
#[thread]
let STK: [16]f32;

struct Cp {
    p: &P;
    k: int;
    n: int;
    bad: bool;
    ops: int;
    sp: int;
}

fn put(c: &Cp, op: int, arg: f32) {
    c.p.css.paints.push(f32(op));
    c.p.css.paints.push(arg);
    c.ops += 1;
    if op >= O_VW && op <= O_VMAX { c.p.css.vpUnits = true; }
    if op <= O_VMAX || op == O_NUM || op >= O_EM { c.sp += 1; } else { c.sp -= 1; }
    if c.ops > MAX_OPS || c.sp > MAX_STACK { c.bad = true; }
}

fn delim(c: &Cp, ch: int): bool {
    return c.k < c.n && tk(c.k).kind == T_DELIM && tk(c.k).ch == ch;
}

fn close(c: &Cp) {
    if c.k < c.n && tk(c.k).kind == T_RPAREN { c.k += 1; } else { c.bad = true; }
}

fn factor(c: &Cp): int {
    if c.bad || c.k >= c.n { c.bad = true; return 0; }
    let t = tk(c.k);
    c.k += 1;
    if t.kind == T_PCT { put(c, O_PCT, t.f); return 1; }
    if t.kind == T_NUM {
        if t.us == t.ue { put(c, O_NUM, t.f); return 0; }
        if unitIs(c.p, t, "px") { put(c, O_PX, t.f); return 1; }
        if unitIs(c.p, t, "em") { put(c, O_EM, t.f); return 1; }
        if unitIs(c.p, t, "rem") { put(c, O_REM, t.f); return 1; }
        if unitIs(c.p, t, "vw") { put(c, O_VW, t.f); return 1; }
        if unitIs(c.p, t, "vh") { put(c, O_VH, t.f); return 1; }
        if unitIs(c.p, t, "vmin") { put(c, O_VMIN, t.f); return 1; }
        if unitIs(c.p, t, "vmax") { put(c, O_VMAX, t.f); return 1; }
        c.bad = true;
        return 0;
    }
    if t.kind == T_LPAREN {
        let d1 = sum(c);
        close(c);
        return d1;
    }
    if t.kind == T_FUNC {
        let nm = txt(c.p, t);
        if same(nm, "calc") {
            let d2 = sum(c);
            close(c);
            return d2;
        }
        if same(nm, "min") || same(nm, "max") {
            let op = if same(nm, "min") { O_MIN } else { O_MAX };
            let d3 = sum(c);
            while !c.bad && c.k < c.n && tk(c.k).kind == T_COMMA {
                c.k += 1;
                if sum(c) != d3 { c.bad = true; }
                put(c, op, 0.0);
            }
            close(c);
            return d3;
        }
        if same(nm, "clamp") {
            // clamp(lo, v, hi) = max(lo, min(v, hi))
            let d4 = sum(c);
            if c.k < c.n && tk(c.k).kind == T_COMMA { c.k += 1; } else { c.bad = true; }
            if sum(c) != d4 { c.bad = true; }
            if c.k < c.n && tk(c.k).kind == T_COMMA { c.k += 1; } else { c.bad = true; }
            if sum(c) != d4 { c.bad = true; }
            put(c, O_MIN, 0.0);
            put(c, O_MAX, 0.0);
            close(c);
            return d4;
        }
    }
    c.bad = true;
    return 0;
}

fn term(c: &Cp): int {
    let d = factor(c);
    while !c.bad && (delim(c, 42) || delim(c, 47)) {
        let mul = delim(c, 42);
        c.k += 1;
        let e = factor(c);
        if mul {
            d += e;
            if d > 1 { c.bad = true; }
            put(c, O_MUL, 0.0);
        } else {
            if e != 0 { c.bad = true; }
            put(c, O_DIV, 0.0);
        }
    }
    return d;
}

fn sum(c: &Cp): int {
    let d = term(c);
    while !c.bad && (delim(c, 43) || delim(c, 45)) {
        let add = delim(c, 43);
        c.k += 1;
        if term(c) != d { c.bad = true; }
        put(c, if add { O_ADD } else { O_SUB }, 0.0);
    }
    return d;
}

/// A length expression at `TOK[k]` (`calc(`, `min(`, `max(`, `clamp(` or a `vw`/`vh`/`vmin`/`vmax`
/// number): the tokens used, 0 when it is not one or is ill-typed (mixed units, `px * px`, divide
/// by a length, a bare number).
pub fn parseCalc(p: &P, k: int, n: int, out: &Value): int {
    let start = p.css.paints.len;
    let c = Cp { p: p, k: k, n: n, bad: false, ops: 0, sp: 0 };
    let d = factor(&c);
    if c.bad || d != 1 {
        p.css.paints.len = start;
        return 0;
    }
    out.kind = V_CALC;
    out.f = 0.0;
    out.i = start;
    out.c = c.ops;
    return c.k - k;
}

/// If `a[off + P_FONT_SIZE]` is a `V_CALC`, evaluate it now to `V_PX` (`%` and `em` are of the parent's font-size,
/// `parent` -1 meaning 16px; `rem` is of the root's, 16px for the root itself). Run before `resolveUnits`.
pub fn fontCalc(css: &Css, a: []Value, off: int, parent: int) {
    let v = a[off + P_FONT_SIZE];
    if v.kind != V_CALC {
        return;
    }
    let pfs: f32 = 16.0;
    if parent >= 0 {
        pfs = css.vals.items[parent * NPROPS + P_FONT_SIZE].f;
    }
    v.f = pfs;
    let keep = css.rootFs;
    if parent < 0 { css.rootFs = 16.0; }
    let r: f32 = 0.0;
    if calcEval(css, v, pfs, &r) {
        a[off + P_FONT_SIZE] = Value { kind: V_PX, f: r, i: 0, c: 0 };
    } else {
        a[off + P_FONT_SIZE] = Value { kind: V_PX, f: pfs, i: 0, c: 0 };
    }
    css.rootFs = keep;
}

/// `v` (a `V_CALC`) in px. `basis` is what `%` is of (negative: unknown). False when it has a `%`
/// with no basis, divides by zero, or overflows.
pub fn calcEval(css: &Css, v: Value, basis: f32, out: &f32): bool {
    let st = STK[0..16];
    let sp = 0;
    let a = css.paints.items;
    for q in 0..v.c {
        let op = int(a[v.i + 2 * q]);
        let x = a[v.i + 2 * q + 1];
        if op <= O_NUM || op >= O_EM {
            if op == O_PX || op == O_NUM { st[sp] = x; }
            else if op == O_PCT {
                if basis < 0.0 { return false; }
                st[sp] = basis * x / 100.0;
            }
            else if op == O_EM { st[sp] = v.f * x; }
            else if op == O_REM { st[sp] = css.rootFs * x; }
            else if op == O_VW { st[sp] = css.vw * x / 100.0; }
            else if op == O_VH { st[sp] = css.vh * x / 100.0; }
            else if op == O_VMIN { st[sp] = min(css.vw, css.vh) * x / 100.0; }
            else { st[sp] = max(css.vw, css.vh) * x / 100.0; }
            sp += 1;
        } else {
            sp -= 1;
            let l = st[sp - 1];
            let r = st[sp];
            if op == O_ADD { l = l + r; }
            else if op == O_SUB { l = l - r; }
            else if op == O_MUL { l = l * r; }
            else if op == O_DIV {
                if r == 0.0 { return false; }
                l = l / r;
            }
            else if op == O_MIN { l = min(l, r); }
            else { l = max(l, r); }
            st[sp - 1] = l;
        }
    }
    let res = st[0];
    if res != res || res > 1000000000.0 || res < -1000000000.0 { return false; }
    *out = res;
    return true;
}
