/// Android: vibrate.
/// Local notifications are `j3.android.notify`; keeping sockets alive in the background is `j3.android.service`.
/// Every call works from any thread (each gets its own JNI env) and returns false off Android,
/// so host runs (`j3c run --host`) keep working. They call methods of the generated `J3Activity`
/// through JNI (`call`); `j3c doc android` has the j3.toml side.

module j3.android;

use j3.sys;

#[singleton]
let SDL: ptr;
#[singleton]
let SDL_TRIED: bool;

/// NUL-terminated copies for JNI, per thread: method name, signature, two string arguments.
#[singleton]
#[thread]
let ZBUF: [4][1024]u8;

// JNIEnv function table slots (jni.h order).
const DELETE_LOCAL_REF: int = 23;
const EXCEPTION_CLEAR: int = 17;
const GET_OBJECT_CLASS: int = 31;
const GET_METHOD_ID: int = 33;
const CALL_BOOLEAN_METHOD_A: int = 39;
const NEW_STRING_UTF: int = 167;
const EXCEPTION_CHECK: int = 228;

/// Buzz for `ms` milliseconds. False when there is no vibrator, `ms <= 0`, or not on Android.
/// The APK always declares the VIBRATE permission (no prompt).
pub fn vibrate(ms: int): bool {
    let a: [1]int = [ms];
    return call("j3Vibrate", "(I)Z", a[:]);
}

/// Call `boolean name(sig)` on the app's activity with `args` as JNI `jvalue`s (one 8-byte slot
/// each: an int, a bool as 0/1, or a reference from `jstr`). False off Android, when the method
/// is missing, or when it throws.
pub fn call(name: string, sig: string, args: []int): bool {
    if sys.PLATFORM != sys.PLATFORM_ANDROID {
        return false;
    }
    let env = env();
    let actFn = sdlFn("SDL_AndroidGetActivity");
    if env == 0 || actFn == 0 {
        return false;
    }
    let getAct = actFn as fn(): int;
    let act = getAct();
    if act == 0 {
        return false;
    }
    let getClass = slot(env, GET_OBJECT_CLASS) as fn(int, int): int;
    let getMethod = slot(env, GET_METHOD_ID) as fn(int, int, ptr, ptr): int;
    let callA = slot(env, CALL_BOOLEAN_METHOD_A) as fn(int, int, int, ptr): u8;
    let cls = getClass(env, act);
    let ok = false;
    if cls != 0 {
        let mid = getMethod(env, cls, z(name, 0), z(sig, 1));
        if mid != 0 {
            ok = callA(env, act, mid, args.ptr as ptr) != u8(0);
        }
    }
    if cleared(env) {
        ok = false;
    }
    drop(cls);
    drop(act);
    return ok;
}

/// A Java string (a local reference) of `s` for `call`, or 0. `which` (0 or 1) picks the scratch
/// buffer, so two can be built for one call. Free it with `drop` after the call.
pub fn jstr(s: string, which: int): int {
    let env = env();
    if env == 0 {
        return 0;
    }
    let newStr = slot(env, NEW_STRING_UTF) as fn(int, ptr): int;
    let r = newStr(env, z(s, 2 + which % 2));
    cleared(env);
    return r;
}

/// Free a local reference from `jstr` (0 is ignored).
pub fn drop(ref: int) {
    let env = env();
    if env == 0 || ref == 0 {
        return;
    }
    let del = slot(env, DELETE_LOCAL_REF) as fn(int, int);
    del(env, ref);
}

/// This thread's JNIEnv (SDL attaches the thread on first use), or 0.
fn env(): int {
    if sys.PLATFORM != sys.PLATFORM_ANDROID {
        return 0;
    }
    let f = sdlFn("SDL_AndroidGetJNIEnv");
    if f == 0 {
        return 0;
    }
    let get = f as fn(): int;
    return get();
}

/// Clear a pending Java exception; true when there was one.
fn cleared(env: int): bool {
    let check = slot(env, EXCEPTION_CHECK) as fn(int): u8;
    if check(env) == u8(0) {
        return false;
    }
    let clear = slot(env, EXCEPTION_CLEAR) as fn(int);
    clear(env);
    return true;
}

/// Function `i` of the JNIEnv table.
fn slot(env: int, i: int): int {
    let head = env as &int;
    let at = (*head + i * 8) as &int;
    return *at;
}

/// An SDL function by name, from the libSDL2.so the activity loaded (0 when missing).
fn sdlFn(name: string): int {
    if !SDL_TRIED {
        SDL_TRIED = true;
        SDL = sys.dlopen("libSDL2.so");
    }
    if SDL as int == 0 {
        return 0;
    }
    return sys.dlsym(SDL, name) as int;
}

/// `s` NUL-terminated in scratch buffer `i` (cut at 1023 bytes, on a UTF-8 boundary).
fn z(s: string, i: int): ptr {
    let n = s.len;
    if n > 1023 {
        n = 1023;
        while n > 0 && (int(s[n]) & 0xC0) == 0x80 {
            n -= 1;
        }
    }
    for k in 0..n {
        ZBUF[i][k] = s[k];
    }
    ZBUF[i][n] = 0;
    return &ZBUF[i][0] as ptr;
}
