// Part of j3.steam: fake mode, which delivers callbacks and results with no Steam; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Message kinds in the fake queue.
const FK_CALLBACK: i32 = 0;
const FK_RESULT: i32 = 1;
const FK_FAILED: i32 = 2;

struct FakeMsg {
    kind: i32;
    id: i32;
    call: u64;
    off: int;
    len: int;
}

#[singleton]
let FQ: []FakeMsg;
#[singleton]
let FQ_HEAD: int = 0;
#[singleton]
let FQ_N: int = 0;
#[singleton]
let FDATA: ptr;
#[singleton]
let FDATA_CAP: int = 0;
#[singleton]
let FDATA_USED: int = 0;
#[singleton]
let FAKE_CALLS: u64;
/// Most messages one `frame()` delivers in fake mode (a handler that queues another each time cannot hang the frame).
const FAKE_BUDGET: int = 4096;

/// True in fake mode (see `initFake` and `J3_STEAM_FAKE`): parts keep state in memory instead of calling Steam.
pub fn fake(): bool {
    return STATE == STATE_FAKE;
}

/// In fake mode print `steam(fake): <line>` to stderr; otherwise nothing. Every part logs one line per call.
pub fn fakeLog(line: string) {
    if STATE == STATE_FAKE {
        eprint(`steam(fake): {line}`);
    }
}

/// Hand out a fresh fake `SteamAPICall_t` (never 0). Pair it with `await` and `fakeResult`.
pub fn fakeCall(): u64 {
    FAKE_CALLS = FAKE_CALLS + u64(1);
    return FAKE_CALLS;
}

fn fakePush(kind: i32, id: i32, call: u64, data: ptr, len: int) {
    if STATE != STATE_FAKE {
        return;
    }
    if FQ_N >= FQ.len {
        let fresh = arena().alloc::<FakeMsg>(FQ.len * 2 + 16);
        for i in FQ_HEAD..FQ_N {
            fresh[i - FQ_HEAD] = FQ[i];
        }
        FQ_N -= FQ_HEAD;
        FQ_HEAD = 0;
        FQ = fresh;
    }
    if FDATA_USED + len > FDATA_CAP {
        // a new block; handlers still holding a pointer into the old one stay valid, and queued
        // messages keep their own block because only unread ones are copied over
        let cap = (FDATA_USED + len) * 2 + 256;
        let fresh = arena().allocBytes(cap);
        let used = 0;
        for i in FQ_HEAD..FQ_N {
            let m = FQ[i];
            copyBytes((fresh as int + used) as ptr, (FDATA as int + m.off) as ptr, m.len);
            FQ[i].off = used;
            used += m.len;
        }
        FDATA = fresh;
        FDATA_CAP = cap;
        FDATA_USED = used;
    }
    copyBytes((FDATA as int + FDATA_USED) as ptr, data, len);
    FQ[FQ_N] = FakeMsg { kind: kind, id: id, call: call, off: FDATA_USED, len: len };
    FDATA_USED += len;
    FQ_N += 1;
}

fn copyBytes(dst: ptr, src: ptr, n: int) {
    for i in 0..n {
        wrU8(dst, i, rdU8(src, i));
    }
}

/// Fake mode: queue callback `id` with struct bytes `data` (build them with the `wr*` writers and `lay`);
/// the next `frame()` delivers it to the same handlers a real callback reaches. No-op outside fake mode.
pub fn fakeCallback(id: i32, data: []u8) {
    fakePush(FK_CALLBACK, id, u64(0), data.ptr as ptr, data.len);
}

/// Fake mode: queue the result for `call` (from `fakeCall`), struct bytes `data`, for the next `frame()`.
pub fn fakeResult(call: u64, id: i32, data: []u8) {
    fakePush(FK_RESULT, id, call, data.ptr as ptr, data.len);
}

/// Fake mode: queue an I/O failure for `call`; its awaiter gets `ioFailure` true.
pub fn fakeFail(call: u64) {
    fakePush(FK_FAILED, 0, call, 0 as ptr, 0);
}

/// Deliver queued fake messages through `deliver` / `deliverResult`, the real path's handlers.
fn pumpFake() {
    let budget = FAKE_BUDGET;
    while FQ_HEAD < FQ_N && budget > 0 {
        let m = FQ[FQ_HEAD];
        FQ_HEAD += 1;
        budget -= 1;
        let p = (FDATA as int + m.off) as ptr;
        if m.kind == FK_CALLBACK {
            deliver(m.id, p, i32(m.len));
        } else {
            deliverResult(m.call, p, i32(m.len), m.kind == FK_FAILED);
        }
    }
    if FQ_HEAD >= FQ_N {
        FQ_HEAD = 0;
        FQ_N = 0;
        FDATA_USED = 0;
    }
}

fn fakeReset() {
    FQ_HEAD = 0;
    FQ_N = 0;
    FDATA_USED = 0;
}
