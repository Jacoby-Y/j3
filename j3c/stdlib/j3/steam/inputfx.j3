// Part of j3.steam: ISteamInput rumble, haptics and the LED; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Rumble the pad: `left` and `right` motor strength, 0 to 65535, for a short moment (call it again to keep going).
pub fn vibrate(h: u64, left: u16, right: u16) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`vibrate {h} {int(left)} {int(right)}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_TriggerVibration") as fn(ptr, u64, u16, u16);
    f(si(), h, left, right);
}

/// `vibrate` plus the two trigger motors (Xbox One pads).
pub fn vibrateEx(h: u64, left: u16, right: u16, leftTrigger: u16, rightTrigger: u16) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`vibrateEx {h} {int(left)} {int(right)} {int(leftTrigger)} {int(rightTrigger)}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_TriggerVibrationExtended") as fn(ptr, u64, u16, u16, u16, u16);
    f(si(), h, left, right, leftTrigger, rightTrigger);
}

/// A haptic pulse on a Steam Controller / Deck pad: `location` is `ESteamControllerPad` (0 left, 1 right), intensity 0 to 255,
/// gain in dB (negative is quieter), and the same two for the other pad.
pub fn hapticEvent(h: u64, location: i32, intensity: u8, gainDb: i8, otherIntensity: u8, otherGainDb: i8) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`hapticEvent {h} pad {int(location)} intensity {int(intensity)}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_TriggerSimpleHapticEvent") as fn(ptr, u64, i32, u8, i8, u8, i8);
    f(si(), h, location, intensity, gainDb, otherIntensity, otherGainDb);
}

/// Colour the pad's light bar. `flags` is `LED_SET` or `LED_RESTORE_USER_DEFAULT`.
pub fn led(h: u64, r: u8, g: u8, b: u8, flags: u32) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`led {h} {int(r)} {int(g)} {int(b)} flags {int(flags)}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_SetLEDColor") as fn(ptr, u64, u8, u8, u8, u32);
    f(si(), h, r, g, b, flags);
}
