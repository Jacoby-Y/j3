// Part of j3.steam: ISteamScreenshots; the module doc and `use`s are in ../steam.j3.
module j3.steam;

const CB_SHOT_READY: i32 = 2301;
const CB_SHOT_REQUESTED: i32 = 2302;

#[singleton]
let H_SHOT_REQ: ptr;
#[singleton]
let H_SHOT_READY: ptr;
#[singleton]
let OFF_SHOT_HANDLE: int = 0;
#[singleton]
let OFF_SHOT_RESULT: int = 0;
#[singleton]
let SHOT_READY_SIZE: int = 0;
#[singleton]
let CAP_SIZE: ptr;
#[singleton]
let CAP_READ: ptr;
#[singleton]
let HOOKED: bool = false;
#[singleton]
let FAKE_SHOTS: u32;
/// Window pixels (RGBA) and the RGB copy sent to Steam; allocated once, grown when the window gets bigger.
#[singleton]
let SHOT_RGBA: ptr;
#[singleton]
let SHOT_RGBA_CAP: int = 0;
#[singleton]
let SHOT_RGB: ptr;
#[singleton]
let SHOT_RGB_CAP: int = 0;

fn ss(): ptr {
    return iface("SteamScreenshots");
}

/// Fake: queue `ScreenshotReady_t` for `handle` (`ok` false is a failed capture).
fn fakeShotReady(handle: u32, ok: bool) {
    let p = fbuf();
    wrU32(p, OFF_SHOT_HANDLE, handle);
    if ok {
        wrI32(p, OFF_SHOT_RESULT, RESULT_OK);
    } else {
        wrI32(p, OFF_SHOT_RESULT, 2);
    }
    fakeCallback(CB_SHOT_READY, @slice(p, SHOT_READY_SIZE));
}

/// Ask Steam to take a screenshot, as if the user pressed the screenshot key. With `hookScreenshots(true)` the game
/// captures it itself (see `onScreenshotRequest`). Does nothing when Steam is absent.
pub fn screenshot() {
    if fake() {
        fakeLog("screenshot");
        if HOOKED {
            fakeCallback(CB_SHOT_REQUESTED, @slice(fbuf(), 1));
        } else {
            FAKE_SHOTS = FAKE_SHOTS + u32(1);
            fakeShotReady(FAKE_SHOTS, true);
        }
        return;
    }
    let f = method("SteamScreenshots", "SteamAPI_ISteamScreenshots_TriggerScreenshot") as fn(ptr);
    f(ss());
}

/// With `on` true the game takes screenshots itself: Steam sends a request instead of capturing, and this module
/// answers it by writing the window (`captureWindow`), or runs the handler from `onScreenshotRequest`.
/// With `on` false Steam captures the screen (default).
pub fn hookScreenshots(on: bool) {
    HOOKED = on;
    if fake() {
        fakeLog(`hookScreenshots {on}`);
        return;
    }
    let f = method("SteamScreenshots", "SteamAPI_ISteamScreenshots_HookScreenshots") as fn(ptr, bool);
    f(ss(), on);
}

/// Run `f()` instead of the default window capture when a hooked screenshot is requested. It should end with
/// `writeScreenshot` or `captureWindow`. One handler: setting again replaces it.
pub fn onScreenshotRequest(f: fn()) {
    H_SHOT_REQ = f as ptr;
}

/// Run `f(handle, ok)` when Steam has finished a screenshot (`ScreenshotReady_t`); `handle` goes to
/// `screenshotLocation`. One handler: setting again replaces it.
pub fn onScreenshotReady(f: fn(u32, bool)) {
    H_SHOT_READY = f as ptr;
}

/// Send an RGB image (`w` x `h`, 3 bytes a pixel, top row first, `w*h*3` bytes) to Steam as a screenshot.
/// Returns its handle, or 0 when Steam is absent, `rgb` is too short or Steam refuses. `onScreenshotReady` follows.
pub fn writeScreenshot(rgb: []u8, w: int, h: int): u32 {
    let size = w * h * 3;
    if w < 1 || h < 1 || rgb.len < size {
        return u32(0);
    }
    if fake() {
        fakeLog(`writeScreenshot {w}x{h}`);
        FAKE_SHOTS = FAKE_SHOTS + u32(1);
        fakeShotReady(FAKE_SHOTS, true);
        return FAKE_SHOTS;
    }
    let f = method("SteamScreenshots", "SteamAPI_ISteamScreenshots_WriteScreenshot") as fn(ptr, ptr, u32, i32, i32): u32;
    return f(ss(), rgb.ptr as ptr, u32(size), i32(w), i32(h));
}

/// Add an image file (JPEG, PNG or TGA) that is already on disk to the user's screenshot library. `thumbPath` may be
/// "" (Steam makes one). Returns its handle, or 0 when Steam is absent or refuses.
pub fn addScreenshot(path: string, thumbPath: string, w: int, h: int): u32 {
    if fake() {
        fakeLog(`addScreenshot {path}`);
        FAKE_SHOTS = FAKE_SHOTS + u32(1);
        return FAKE_SHOTS;
    }
    let p = cs(path, 0);
    let t: ptr = 0;
    if thumbPath.len > 0 {
        t = cs(thumbPath, 1);
    }
    if p as int == 0 || (thumbPath.len > 0 && t as int == 0) {
        return u32(0);
    }
    let f = method("SteamScreenshots", "SteamAPI_ISteamScreenshots_AddScreenshotToLibrary") as fn(ptr, ptr, ptr, i32, i32): u32;
    return f(ss(), p, t, i32(w), i32(h));
}

/// Tag screenshot `handle` with a place name (shown in the library, e.g. a level name).
pub fn screenshotLocation(handle: u32, place: string) {
    if fake() {
        fakeLog(`screenshotLocation {handle} {place}`);
        return;
    }
    let l = cs(place, 0);
    if l as int == 0 {
        return;
    }
    let f = method("SteamScreenshots", "SteamAPI_ISteamScreenshots_SetLocation") as fn(ptr, u32, ptr);
    f(ss(), handle, l);
}

/// Tell the default capture how to read the screen: `size` gives the pixel size `read` fills, and `read(out)` copies
/// the frame into `out` as RGBA8, top row first (`w*h*4` bytes), returning false when it cannot. A game registers
/// `j3.game` here (see `captureWindow`); `j3.steam` itself does not import `j3.game`, so console programs link no SDL.
pub fn setCapture(size: fn(): ImageSize, read: fn([]u8): bool) {
    CAP_SIZE = size as ptr;
    CAP_READ = read as ptr;
}

/// Read the frame through the `setCapture` hooks and send it with `writeScreenshot`. Call it after drawing, before
/// `present`. Returns the handle, or 0 when no hook is set, the read fails or Steam is absent. In fake mode a failed
/// grab still queues a failed `ScreenshotReady_t`.
pub fn captureWindow(): u32 {
    let w = 0;
    let h = 0;
    let ok = CAP_SIZE as int != 0 && CAP_READ as int != 0;
    if ok {
        let sz = CAP_SIZE as fn(): ImageSize;
        let s = sz();
        w = s.w;
        h = s.h;
        ok = w > 0 && h > 0;
    }
    if ok {
        if w * h * 4 > SHOT_RGBA_CAP {
            SHOT_RGBA_CAP = w * h * 4;
            SHOT_RGBA = arena().allocBytes(SHOT_RGBA_CAP);
        }
        let px: []u8 = @slice(SHOT_RGBA, w * h * 4);
        let rd = CAP_READ as fn([]u8): bool;
        ok = rd(px);
    }
    if !ok {
        eprintOnce("steam: screenshot capture failed (no capture hook or no window to read)");
        if fake() {
            fakeShotReady(u32(0), false);
        }
        return u32(0);
    }
    if w * h * 3 > SHOT_RGB_CAP {
        SHOT_RGB_CAP = w * h * 3;
        SHOT_RGB = arena().allocBytes(SHOT_RGB_CAP);
    }
    let src: []u8 = @slice(SHOT_RGBA, w * h * 4);
    let dst: []u8 = @slice(SHOT_RGB, w * h * 3);
    // RGBA with the top row first in, RGB top row first out: drop alpha
    for i in 0..w * h {
        dst[i * 3] = src[i * 4];
        dst[i * 3 + 1] = src[i * 4 + 1];
        dst[i * 3 + 2] = src[i * 4 + 2];
    }
    return writeScreenshot(dst, w, h);
}

fn onShotRequestedCb(p: ptr, n: i32) {
    if H_SHOT_REQ as int != 0 {
        let f = H_SHOT_REQ as fn();
        f();
        return;
    }
    captureWindow();
}

fn onShotReadyCb(p: ptr, n: i32) {
    if H_SHOT_READY as int != 0 {
        let f = H_SHOT_READY as fn(u32, bool);
        f(rdU32(p, OFF_SHOT_HANDLE), rdI32(p, OFF_SHOT_RESULT) == RESULT_OK);
    }
}

fn shotsInit() {
    OFF_SHOT_HANDLE = lay("ScreenshotReady_t", "hLocal");
    OFF_SHOT_RESULT = lay("ScreenshotReady_t", "eResult");
    SHOT_READY_SIZE = lay("ScreenshotReady_t", SIZE);
    onCallback(CB_SHOT_READY, onShotReadyCb);
    onCallback(CB_SHOT_REQUESTED, onShotRequestedCb);
}
