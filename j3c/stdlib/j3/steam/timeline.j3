// Part of j3.steam: ISteamTimeline (SDK 1.61 and later; the method set changed across versions); the module doc and `use`s are in ../steam.j3.
// Event priorities and clip kinds: `clip` 0 none, 1 standard, 2 featured. Offsets are seconds from now (negative is the past).
module j3.steam;

#[singleton]
let FAKE_EVENTS: u64;

fn tl(): ptr {
    return iface("SteamTimeline");
}

/// Show `desc` as a tooltip on the timeline, `delta` seconds from now. Does nothing when Steam is absent.
pub fn timelineTooltip(desc: string, delta: f32) {
    if fake() {
        fakeLog(`timelineTooltip {desc}`);
        return;
    }
    let d = cs(desc, 0);
    if d as int == 0 {
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_SetTimelineTooltip") as fn(ptr, ptr, f32);
    f(tl(), d, delta);
}

/// Remove the tooltip set by `timelineTooltip`, `delta` seconds from now.
pub fn timelineClearTooltip(delta: f32) {
    if fake() {
        fakeLog("timelineClearTooltip");
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_ClearTimelineTooltip") as fn(ptr, f32);
    f(tl(), delta);
}

/// Tell Steam what the game is doing: 1 playing, 2 staging (pre-round), 3 menus, 4 loading screen.
pub fn timelineMode(mode: int) {
    if fake() {
        fakeLog(`timelineMode {mode}`);
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_SetTimelineGameMode") as fn(ptr, i32);
    f(tl(), i32(mode));
}

/// Mark a moment `offset` seconds from now (negative is the past). `icon` is a Steam icon name ("steam_death",
/// "steam_marker", ...), `priority` orders overlapping events. Returns the event handle, 0 when Steam is absent.
pub fn timelineEvent(title: string, desc: string, icon: string, priority: u32, offset: f32, clip: int): u64 {
    if fake() {
        fakeLog(`timelineEvent {title}`);
        FAKE_EVENTS = FAKE_EVENTS + u64(1);
        return FAKE_EVENTS;
    }
    let t = cs(title, 0);
    let d = cs(desc, 1);
    let i = cs(icon, 2);
    if t as int == 0 || d as int == 0 || i as int == 0 {
        return u64(0);
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_AddInstantaneousTimelineEvent") as fn(ptr, ptr, ptr, ptr, u32, f32, i32): u64;
    return f(tl(), t, d, i, priority, offset, i32(clip));
}

/// Mark a span that starts `offset` seconds from now and lasts `duration` seconds. Arguments as `timelineEvent`.
pub fn timelineRange(title: string, desc: string, icon: string, priority: u32, offset: f32, duration: f32, clip: int): u64 {
    if fake() {
        fakeLog(`timelineRange {title}`);
        FAKE_EVENTS = FAKE_EVENTS + u64(1);
        return FAKE_EVENTS;
    }
    let t = cs(title, 0);
    let d = cs(desc, 1);
    let i = cs(icon, 2);
    if t as int == 0 || d as int == 0 || i as int == 0 {
        return u64(0);
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_AddRangeTimelineEvent") as fn(ptr, ptr, ptr, ptr, u32, f32, f32, i32): u64;
    return f(tl(), t, d, i, priority, offset, duration, i32(clip));
}

/// Start a span that ends later (`timelineEnd`). Arguments as `timelineEvent`. Returns the handle for
/// `timelineUpdate` / `timelineEnd`, 0 when Steam is absent.
pub fn timelineStart(title: string, desc: string, icon: string, priority: u32, offset: f32, clip: int): u64 {
    if fake() {
        fakeLog(`timelineStart {title}`);
        FAKE_EVENTS = FAKE_EVENTS + u64(1);
        return FAKE_EVENTS;
    }
    let t = cs(title, 0);
    let d = cs(desc, 1);
    let i = cs(icon, 2);
    if t as int == 0 || d as int == 0 || i as int == 0 {
        return u64(0);
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_StartRangeTimelineEvent") as fn(ptr, ptr, ptr, ptr, u32, f32, i32): u64;
    return f(tl(), t, d, i, priority, offset, i32(clip));
}

/// Change the text, icon, priority or clip of an open span from `timelineStart`.
pub fn timelineUpdate(handle: u64, title: string, desc: string, icon: string, priority: u32, clip: int) {
    if fake() {
        fakeLog(`timelineUpdate {handle} {title}`);
        return;
    }
    let t = cs(title, 0);
    let d = cs(desc, 1);
    let i = cs(icon, 2);
    if t as int == 0 || d as int == 0 || i as int == 0 {
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_UpdateRangeTimelineEvent") as fn(ptr, u64, ptr, ptr, ptr, u32, i32);
    f(tl(), handle, t, d, i, priority, i32(clip));
}

/// End a span from `timelineStart`, `offset` seconds from now.
pub fn timelineEnd(handle: u64, offset: f32) {
    if fake() {
        fakeLog(`timelineEnd {handle}`);
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_EndRangeTimelineEvent") as fn(ptr, u64, f32);
    f(tl(), handle, offset);
}

/// Remove an event or span by handle.
pub fn timelineRemove(handle: u64) {
    if fake() {
        fakeLog(`timelineRemove {handle}`);
        return;
    }
    let f = method("SteamTimeline", "SteamAPI_ISteamTimeline_RemoveTimelineEvent") as fn(ptr, u64);
    f(tl(), handle);
}
