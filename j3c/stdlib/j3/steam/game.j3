/// `j3.steam` for a game built on `j3.app`: `attach` pumps Steam with the `App` loop and wires screenshots to the
/// window. A separate module so that programs that use only `j3.steam` do not link SDL.
///
///     use j3.steam.game.attach;
///     attach(&app);       // after steam.init

module j3.steam.game;

use j3.app.App;
use j3.game.{ readWindow, windowPixels };
use j3.steam;
use j3.steam.ImageSize;
use j3.ui.inputs;
use j3.ui.padin;
use j3.ui.padin.PadRaw;

/// Where `App.paused` lives (set by `attach`); 0 before.
#[singleton]
let PAUSED_AT: ptr;
/// The overlay state `tick` last saw, and the `paused` value to restore when it closes.
#[singleton]
let SAW_OVERLAY: bool;
#[singleton]
let WAS_PAUSED: bool;
#[singleton]
let PAUSE_OFF: bool;

fn tick(w: ptr, dt: f32) {
    steam.frame();
    let open = steam.overlayOpen();
    if open != SAW_OVERLAY {
        SAW_OVERLAY = open;
        if PAUSED_AT as int != 0 && !PAUSE_OFF {
            if open {
                WAS_PAUSED = steam.rdBool(PAUSED_AT, 0);
                steam.wrBool(PAUSED_AT, 0, true);
            } else {
                steam.wrBool(PAUSED_AT, 0, WAS_PAUSED);
            }
        }
    }
}

/// Whether to show Steam's keyboard: on a Deck, and in Big Picture mode.
fn wantKeyboard(): bool {
    return steam.onDeck() || steam.bigPicture();
}

fn textFocus(x: int, y: int, w: int, h: int, kind: int) {
    if wantKeyboard() {
        steam.textInput(kind, x, y, w, h);
    }
}

fn textBlur() {
    if wantKeyboard() {
        steam.dismissTextInput();
    }
}

/// Opt out of (or back into) pausing the `App` while the Steam overlay is open. On by default. A game that pauses itself turns this off and
/// reads `steam.overlayOpen()`.
pub fn pauseOnOverlay(on: bool) {
    PAUSE_OFF = !on;
}

fn downHook(w: ptr) {
    steam.shutdown();
}

/// The pixel size `readWindow` reads.
fn pixels(): ImageSize {
    let v = windowPixels();
    return ImageSize { w: int(v.x), h: int(v.y) };
}

/// Pump Steam every frame (`App.always`) and shut it down when the loop ends (`App.shutdown`), and let hooked
/// screenshots grab the window (`setCapture` with `j3.game.readWindow`). Both hooks ignore the world, so they are
/// plain module fns used as `fn(&W, ...)` (a generic fn cannot be passed as a value).
///
/// It also does two things for the Deck and Big Picture. (1) Overlay pause: when `GameOverlayActivated_t` says the overlay opened, `app.paused`
/// is set (fixed steps stop; `always` and `draw` still run), and when it closes `paused` goes back to what it was when the overlay opened, so a
/// game that was already paused stays paused. `pauseOnOverlay(false)` turns this off. (2) On-screen keyboard: when a `.j3ui` text box gains
/// focus (`j3.ui.inputs.setTextFocusHook`) and `steam.onDeck()` or `steam.bigPicture()` is true, it calls `steam.textInput` with the box's window
/// rect, and `steam.dismissTextInput()` when the focus leaves the text boxes. Steam types what the player enters as ordinary key presses, so the
/// text arrives as normal SDL text input (the box keeps SDL text input on while focused) with no code of yours; this is the documented behaviour
/// of `ShowFloatingGamepadTextInput` and was not tried on hardware here. When the player closes the keyboard (callback 738) the box keeps the
/// focus; the keyboard shows again the next time a text box gains focus (focus another box and back), or call `steam.textInput` yourself from `steam.onTextInputClosed`. Call `attach` once; it replaces the two text
/// hooks of `j3.ui.inputs`.
pub fn attach<W>(app: &App<W>) {
    let t: fn(ptr, f32) = tick;
    let d: fn(ptr) = downHook;
    app.always((t as ptr) as fn(&W, f32));
    app.shutdown((d as ptr) as fn(&W));
    steam.setCapture(pixels, readWindow);
    PAUSED_AT = &app.paused as ptr;
    inputs.setTextFocusHook(textFocus);
    inputs.setTextBlurHook(textBlur);
}

/// Which Steam Input actions stand for the menu buttons: `menuSet` is the action set to hold while a menu is open, the rest are digital
/// action handles (from `steam.digitalAction`). A 0 action is never pressed.
pub struct PadMap {
    menuSet: u64;
    up: u64;
    down: u64;
    left: u64;
    right: u64;
    a: u64;
    b: u64;
    lb: u64;
    rb: u64;
}

fn held(h: u64, action: u64, bit: int): int {
    if action != u64(0) && steam.digital(h, action).state {
        return bit;
    }
    return 0;
}

/// The pad as `j3.ui.padin` wants it, built from Steam Input digital actions on controller `h` (feed it to `Dom.setPad`). Makes
/// `map.menuSet` the active set of `h` when it is not already. `attached` is false when `h` is 0 or Steam Input is not started,
/// so a direction held at unplug stops. Sticks and triggers stay 0. Lives here, not in `j3.steam`, because `padin` pulls in `j3.game`.
pub fn padRaw(h: u64, map: PadMap): PadRaw {
    let r = PadRaw { attached: h != u64(0) && steam.inputType(h) != steam.INPUT_UNKNOWN };
    if !r.attached {
        return r;
    }
    if map.menuSet != u64(0) && steam.currentSet(h) != map.menuSet {
        steam.activateSet(h, map.menuSet);
    }
    r.mask = held(h, map.up, padin.B_UP) + held(h, map.down, padin.B_DOWN) + held(h, map.left, padin.B_LEFT)
        + held(h, map.right, padin.B_RIGHT) + held(h, map.a, padin.B_A) + held(h, map.b, padin.B_B)
        + held(h, map.lb, padin.B_LB) + held(h, map.rb, padin.B_RB);
    return r;
}
