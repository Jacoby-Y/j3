// Part of j3.steam: ISteamInput action sets and layers; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// The handle of action set `name` (from the game's action manifest), cached by name so it is cheap to ask every frame.
/// 0 when the set is unknown or Steam Input is not started (a 0 is not cached, so it is asked again).
pub fn actionSet(name: string): u64 {
    if !INPUT_ON || name.len == 0 {
        return u64(0);
    }
    let h = ncGet(&C_SET, name);
    if h != u64(0) {
        return h;
    }
    if fake() {
        h = u64(C_SET.n + 1);
    } else {
        let p = cs(name, 0);
        if p as int == 0 {
            return u64(0);
        }
        let f = method("SteamInput", "SteamAPI_ISteamInput_GetActionSetHandle") as fn(ptr, ptr): u64;
        h = f(si(), p);
    }
    if h != u64(0) {
        ncPut(&C_SET, name, h);
    }
    return h;
}

/// Make `set` the active action set of controller `h` (`INPUT_ALL_CONTROLLERS` for every one).
pub fn activateSet(h: u64, set: u64) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeSetCurrent(h, set);
        fakeLog(`activateSet {h} {set}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_ActivateActionSet") as fn(ptr, u64, u64);
    f(si(), h, set);
}

/// The active action set of `h`, or 0.
pub fn currentSet(h: u64): u64 {
    if !INPUT_ON {
        return u64(0);
    }
    if fake() {
        return fakeCurrent(h);
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetCurrentActionSet") as fn(ptr, u64): u64;
    return f(si(), h);
}

/// Add action set layer `layer` on top of `h`'s set.
pub fn activateLayer(h: u64, layer: u64) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`activateLayer {h} {layer}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_ActivateActionSetLayer") as fn(ptr, u64, u64);
    f(si(), h, layer);
}

/// Remove layer `layer` from `h`.
pub fn deactivateLayer(h: u64, layer: u64) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`deactivateLayer {h} {layer}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_DeactivateActionSetLayer") as fn(ptr, u64, u64);
    f(si(), h, layer);
}

/// Remove every layer from `h`.
pub fn deactivateAllLayers(h: u64) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`deactivateAllLayers {h}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_DeactivateAllActionSetLayers") as fn(ptr, u64);
    f(si(), h);
}

/// Fill `out` with the layers active on `h`; returns how many. `out` must hold `INPUT_MAX_LAYERS` (16), else the call is
/// refused (logged once, returns 0). Fake mode keeps no layers.
pub fn activeLayers(h: u64, out: []u64): int {
    if out.len < INPUT_MAX_LAYERS {
        eprintOnce(`steam: activeLayers needs room for {INPUT_MAX_LAYERS} handles, got {out.len}; call refused`);
        return 0;
    }
    if !INPUT_ON || fake() {
        return 0;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetActiveActionSetLayers") as fn(ptr, u64, ptr): i32;
    return int(f(si(), h, out.ptr as ptr));
}
