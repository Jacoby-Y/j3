// Part of j3.steam: ISteamApps (ownership, DLC, betas, install info, launch parameters); the module doc and `use`s are in ../steam.j3.
module j3.steam;

const CB_DLC_INSTALLED: i32 = 1005;
const CB_NEW_LAUNCH: i32 = 1014;
/// Fake DLC ids: the first is installed, the second is not.
const FAKE_DLC_A: u32 = 1001;
const FAKE_DLC_B: u32 = 1002;
const DLC_NAME_MAX: int = 128;
const BETA_MAX: int = 128;
const DIR_MAX: int = 1024;

/// One piece of downloadable content.
pub struct Dlc {
    /// App id of the DLC.
    id: u32;
    /// The user may install it (owned, or free).
    available: bool;
    /// Store name; a copy valid until the next `frame()`.
    name: string;
}

/// Download progress of a DLC in bytes. `ok` is false when nothing is downloading.
pub struct DlcProgress {
    ok: bool;
    downloaded: u64;
    total: u64;
}

#[singleton]
let APPS_BUF: ptr;
#[singleton]
let H_DLC: ptr;
#[singleton]
let H_LAUNCH: ptr;
#[singleton]
let OFF_DLC_APP: int = 0;
#[singleton]
let FAKE_B_INSTALLED: bool = false;

fn appsBuf(): ptr {
    if APPS_BUF as int == 0 {
        APPS_BUF = arena().allocBytes(DIR_MAX + 16);
    }
    return APPS_BUF;
}

/// Zero the buffer, so a call that writes nothing reads as "".
fn appsClear(): ptr {
    let p = appsBuf();
    wrU8(p, 0, u8(0));
    wrU8(p, DIR_MAX - 1, u8(0));
    return p;
}

/// True when the user owns this game (`BIsSubscribed`). False when Steam is absent; true in fake mode.
pub fn owns(): bool {
    if fake() {
        return true;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsSubscribed") as fn(ptr): bool;
    return f(ap());
}

/// True when the user owns app `id`. False when Steam is absent; fake mode owns only the game and the two fake DLCs.
pub fn ownsApp(id: u32): bool {
    if fake() {
        return id == FAKE_APP || id == FAKE_DLC_A || id == FAKE_DLC_B;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsSubscribedApp") as fn(ptr, u32): bool;
    return f(ap(), id);
}

/// True when DLC `id` is installed. False when Steam is absent.
pub fn dlcInstalled(id: u32): bool {
    if fake() {
        return id == FAKE_DLC_A || (id == FAKE_DLC_B && FAKE_B_INSTALLED);
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsDlcInstalled") as fn(ptr, u32): bool;
    return f(ap(), id);
}

/// How many DLCs the game has. 0 when Steam is absent; fake mode has 2.
pub fn dlcCount(): i32 {
    if fake() {
        return i32(2);
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetDLCCount") as fn(ptr): i32;
    return f(ap());
}

/// DLC number `i` (0 to `dlcCount() - 1`). Id 0 and an empty name when `i` is out of range or Steam is absent.
/// Fake mode: 1001 (available, installed) and 1002 (available, not installed until `installDlc`). The name is valid until the next frame.
pub fn dlcAt(i: i32): Dlc {
    if fake() {
        if i == i32(0) {
            return Dlc { id: FAKE_DLC_A, available: true, name: "Fake DLC A" };
        }
        if i == i32(1) {
            return Dlc { id: FAKE_DLC_B, available: true, name: "Fake DLC B" };
        }
        return Dlc { id: u32(0), available: false, name: "" };
    }
    let out = outCell();
    let name = appsClear();
    let f = method("SteamApps", "SteamAPI_ISteamApps_BGetDLCDataByIndex") as fn(ptr, i32, ptr, ptr, ptr, i32): bool;
    if !f(ap(), i, out, (out as int + 8) as ptr, name, i32(DLC_NAME_MAX)) {
        return Dlc { id: u32(0), available: false, name: "" };
    }
    wrU8(name, DLC_NAME_MAX - 1, u8(0));
    return Dlc { id: rdU32(out, 0), available: rdBool(out, 8), name: fromFixed(name, DLC_NAME_MAX - 1) };
}

/// Ask Steam to download and install DLC `id`; `onDlcInstalled` fires when it is done. Does nothing when Steam is absent.
pub fn installDlc(id: u32) {
    if fake() {
        fakeLog(`installDlc {id}`);
        if id == FAKE_DLC_B && !FAKE_B_INSTALLED {
            FAKE_B_INSTALLED = true;
            let p = fbuf();
            wrU32(p, OFF_DLC_APP, id);
            let bytes: []u8 = @slice(p, 4);
            fakeCallback(CB_DLC_INSTALLED, bytes);
        }
        return;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_InstallDLC") as fn(ptr, u32);
    f(ap(), id);
}

/// Ask Steam to remove DLC `id`. Does nothing when Steam is absent.
pub fn uninstallDlc(id: u32) {
    if fake() {
        fakeLog(`uninstallDlc {id}`);
        if id == FAKE_DLC_B {
            FAKE_B_INSTALLED = false;
        }
        return;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_UninstallDLC") as fn(ptr, u32);
    f(ap(), id);
}

/// Bytes downloaded so far of DLC `id`; `ok` is false when it is not downloading (or Steam is absent, or fake mode).
pub fn dlcProgress(id: u32): DlcProgress {
    if fake() {
        return DlcProgress { ok: false, downloaded: u64(0), total: u64(0) };
    }
    let out = outCell();
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetDlcDownloadProgress") as fn(ptr, u32, ptr, ptr): bool;
    if !f(ap(), id, out, (out as int + 8) as ptr) {
        return DlcProgress { ok: false, downloaded: u64(0), total: u64(0) };
    }
    return DlcProgress { ok: true, downloaded: rdU64(out, 0), total: rdU64(out, 8) };
}

/// Run `f(appId)` when a DLC finishes installing (`DlcInstalled_t`). One handler: setting again replaces it.
pub fn onDlcInstalled(f: fn(u32)) {
    H_DLC = f as ptr;
}

/// Name of the beta branch the game runs on. "" on the default branch, when Steam is absent, and in fake mode. Valid until the next frame.
pub fn beta(): string {
    if !ready() {
        return "";
    }
    let buf = appsClear();
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetCurrentBetaName") as fn(ptr, ptr, i32): bool;
    if !f(ap(), buf, i32(BETA_MAX)) {
        return "";
    }
    wrU8(buf, BETA_MAX - 1, u8(0));
    return fromFixed(buf, BETA_MAX - 1);
}

/// Build id of the installed game. 0 when Steam is absent; 1 in fake mode.
pub fn buildId(): i32 {
    if fake() {
        return i32(1);
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetAppBuildId") as fn(ptr): i32;
    return f(ap());
}

/// Steam id of the account that owns the game (differs from `userId()` under family sharing). 0 when Steam is absent.
pub fn appOwner(): u64 {
    if fake() {
        return FAKE_USER;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetAppOwner") as fn(ptr): u64;
    return f(ap());
}

/// True when app `id` is installed. False when Steam is absent; in fake mode only the game itself.
pub fn appInstalled(id: u32): bool {
    if fake() {
        return id == FAKE_APP;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsAppInstalled") as fn(ptr, u32): bool;
    return f(ap(), id);
}

/// Install folder of app `id`. "" when it is not installed, when Steam is absent, and in fake mode. Valid until the next frame.
pub fn installDir(id: u32): string {
    if !ready() {
        return "";
    }
    let buf = appsClear();
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetAppInstallDir") as fn(ptr, u32, ptr, u32): u32;
    let n = f(ap(), id, buf, u32(DIR_MAX));
    if n == u32(0) {
        return "";
    }
    wrU8(buf, DIR_MAX - 1, u8(0));
    return fromFixed(buf, DIR_MAX - 1);
}

/// Unix time (seconds) the user first got app `id`. 0 when Steam is absent or in fake mode.
pub fn purchaseTime(id: u32): u32 {
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetEarliestPurchaseUnixTime") as fn(ptr, u32): u32;
    return f(ap(), id);
}

/// True when the user plays during a free weekend. False when Steam is absent.
pub fn freeWeekend(): bool {
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsSubscribedFromFreeWeekend") as fn(ptr): bool;
    return f(ap());
}

/// True when the game is borrowed through Family Sharing. False when Steam is absent.
pub fn familyShared(): bool {
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsSubscribedFromFamilySharing") as fn(ptr): bool;
    return f(ap());
}

/// True when the user asked for the low-violence version. False when Steam is absent.
pub fn lowViolence(): bool {
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsLowViolence") as fn(ptr): bool;
    return f(ap());
}

/// True when the account has a VAC ban. False when Steam is absent.
pub fn vacBanned(): bool {
    let f = method("SteamApps", "SteamAPI_ISteamApps_BIsVACBanned") as fn(ptr): bool;
    return f(ap());
}

/// Comma-separated Steam language codes the game ships ("english,french"). "" when Steam is absent; fake mode says "english". Valid until the next frame.
pub fn languages(): string {
    if fake() {
        return "english";
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetAvailableGameLanguages") as fn(ptr): ptr;
    return fromC(f(ap()));
}

/// Value of `key` in the URL launch parameters (`steam://run/<id>//?key=value`). "" when unset or Steam is absent. Valid until the next frame.
pub fn launchParam(key: string): string {
    let k = cs(key, 0);
    if k as int == 0 || fake() {
        return "";
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetLaunchQueryParam") as fn(ptr, ptr): ptr;
    return fromC(f(ap(), k));
}

/// Run `f()` when new URL launch parameters arrive while the game runs (`NewUrlLaunchParameters_t`); read them with `launchParam`.
/// One handler: setting again replaces it.
pub fn onLaunchParams(f: fn()) {
    H_LAUNCH = f as ptr;
}

/// Tell Steam the install is damaged so it verifies the files. `missingFilesOnly` skips files that exist but differ.
/// Does nothing when Steam is absent.
pub fn markCorrupt(missingFilesOnly: bool) {
    if fake() {
        fakeLog(`markCorrupt {missingFilesOnly}`);
        return;
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_MarkContentCorrupt") as fn(ptr, bool): bool;
    f(ap(), missingFilesOnly);
}

fn onDlcCb(p: ptr, n: i32) {
    if H_DLC as int != 0 {
        let f = H_DLC as fn(u32);
        f(rdU32(p, OFF_DLC_APP));
    }
}

fn onLaunchCb(p: ptr, n: i32) {
    if H_LAUNCH as int != 0 {
        let f = H_LAUNCH as fn();
        f();
    }
}

fn appsDown() {
    FAKE_B_INSTALLED = false;
}

fn appsInit() {
    OFF_DLC_APP = lay("DlcInstalled_t", "nAppID");
    onCallback(CB_DLC_INSTALLED, onDlcCb);
    onCallback(CB_NEW_LAUNCH, onLaunchCb);
    onShutdown(appsDown);
}
