// Part of j3.steam: ISteamUserStats stat values, store, reset, global percentages, shutdown hook; the module doc and `use`s are in ../steam.j3.
module j3.steam;

// ---- stats ----

/// Integer stat `name`; 0 when Steam is absent or the stat is unknown.
pub fn statInt(name: string): i32 {
    if fake() {
        let at = fstatFind(name, false, false);
        if at < 0 {
            return 0;
        }
        return FSTATS[at].i;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return 0;
    }
    let out = outCell();
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetStatInt32") as fn(ptr, ptr, ptr): bool;
    if f(us(), n, out) {
        return rdI32(out, 0);
    }
    return 0;
}

/// Set integer stat `name`. False when Steam is absent or the stat is unknown. Save with `store`.
pub fn setStatInt(name: string, v: i32): bool {
    if fake() {
        fakeLog(`setStatInt {name} {v}`);
        FSTATS[fstatFind(name, false, true)].i = v;
        DIRTY = true;
        return true;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return false;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_SetStatInt32") as fn(ptr, ptr, i32): bool;
    if f(us(), n, v) {
        DIRTY = true;
        return true;
    }
    return false;
}

/// Float stat `name`; 0.0 when Steam is absent or the stat is unknown.
pub fn statFloat(name: string): f32 {
    if fake() {
        let at = fstatFind(name, true, false);
        if at < 0 {
            return 0.0;
        }
        return FSTATS[at].f;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return 0.0;
    }
    let out = outCell();
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetStatFloat") as fn(ptr, ptr, ptr): bool;
    if f(us(), n, out) {
        return rdF32(out, 0);
    }
    return 0.0;
}

/// Set float stat `name`. False when Steam is absent or the stat is unknown. Save with `store`.
pub fn setStatFloat(name: string, v: f32): bool {
    if fake() {
        fakeLog(`setStatFloat {name} {v}`);
        FSTATS[fstatFind(name, true, true)].f = v;
        DIRTY = true;
        return true;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return false;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_SetStatFloat") as fn(ptr, ptr, f32): bool;
    if f(us(), n, v) {
        DIRTY = true;
        return true;
    }
    return false;
}

/// Feed an average-rate stat (e.g. kills per hour): `countThisSession` events over `sessionLength`
/// seconds. False when Steam is absent or the stat is unknown. Fake: the stat is the running total
/// count over the total length.
pub fn updateAvgRate(name: string, countThisSession: f32, sessionLength: f64): bool {
    if fake() {
        fakeLog(`updateAvgRate {name} {countThisSession} {sessionLength}`);
        let at = fstatFind(name, true, true);
        FSTATS[at].acc += f64(countThisSession);
        FSTATS[at].span += sessionLength;
        if FSTATS[at].span > 0.0 {
            FSTATS[at].f = f32(FSTATS[at].acc / FSTATS[at].span);
        }
        DIRTY = true;
        return true;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return false;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_UpdateAvgRateStat") as fn(ptr, ptr, f32, f64): bool;
    if f(us(), n, countThisSession, sessionLength) {
        DIRTY = true;
        return true;
    }
    return false;
}

/// Send changed stats and achievements to Steam. Call it at checkpoints (level end, menu), not every
/// frame: Steam rate-limits it. Also runs at `shutdown` when something changed. Stats load by
/// themselves at `init` (SDK 1.61 and later), so there is nothing to wait for. Returns false when
/// Steam is absent or refused; the result arrives later as `UserStatsStored_t`, and a failure prints
/// a line to stderr and keeps the stats marked as unsaved.
pub fn store(): bool {
    if fake() {
        fakeLog("store");
        DIRTY = false;
        FSTORES += 1;
        let p = fbuf();
        wrU64(p, OFF_STORED_GAME, u64(480));
        wrI32(p, OFF_STORED_RESULT, RESULT_OK);
        let bytes: []u8 = @slice(p, STORED_SIZE);
        fakeCallback(CB_STATS_STORED, bytes);
        return true;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_StoreStats") as fn(ptr): bool;
    if f(us()) {
        DIRTY = false;
        return true;
    }
    return false;
}

/// Reset every stat, and the achievements too when `achievementsToo`. Works in any build, release
/// included, and cannot be undone: only call it from a dev tool or behind a confirmation. Returns
/// false when Steam is absent. Call `store` afterwards.
pub fn resetAll(achievementsToo: bool): bool {
    if fake() {
        fakeLog(`resetAll {achievementsToo}`);
        for i in 0..FSTAT_N {
            FSTATS[i].i = 0;
            FSTATS[i].f = 0.0;
            FSTATS[i].acc = 0.0;
            FSTATS[i].span = 0.0;
        }
        if achievementsToo {
            for i in 0..FACH_N {
                FACH[i].done = false;
            }
        }
        DIRTY = true;
        return true;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_ResetAllStats") as fn(ptr, bool): bool;
    if f(us(), achievementsToo) {
        DIRTY = true;
        return true;
    }
    return false;
}

// ---- global percentages ----

fn onPercents(p: ptr, n: i32, failed: bool, ctx: u64) {
    let r = reqTake(ctx);
    if !r.used {
        return;
    }
    let ok = !failed && rdI32(p, OFF_PCT_RESULT) == RESULT_OK;
    if ok {
        PCT_READY = true;
    }
    let f = r.f as fn(bool, u64);
    f(ok, r.ctx);
}

/// Ask Steam for the share of players who unlocked each achievement. `f(ok, ctx)` runs on a later
/// frame; after `ok`, `globalPercent` has values. With Steam absent `f(false, ctx)` runs on the next
/// `frame()`. Fake: every percent is 50.0.
pub fn requestGlobalPercents(f: fn(bool, u64), ctx: u64) {
    let slot = reqNew(f as ptr, ctx);
    if fake() {
        fakeLog("requestGlobalPercents");
        let call = fakeCall();
        await(call, onPercents, slot);
        let p = fbuf();
        wrU64(p, OFF_PCT_GAME, u64(480));
        wrI32(p, OFF_PCT_RESULT, RESULT_OK);
        let bytes: []u8 = @slice(p, PCT_SIZE);
        fakeResult(call, CB_GLOBAL_PERCENTS, bytes);
        return;
    }
    let g = method("SteamUserStats", "SteamAPI_ISteamUserStats_RequestGlobalAchievementPercentages") as fn(ptr): u64;
    await(g(us()), onPercents, slot);
}

/// Percent (0 to 100) of all players who unlocked `name`, after `requestGlobalPercents` finished.
/// -1.0 when unknown, not yet loaded, or Steam is absent.
pub fn globalPercent(name: string): f32 {
    if fake() {
        if PCT_READY {
            return 50.0;
        }
        return 0.0 - 1.0;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        return 0.0 - 1.0;
    }
    let out = outCell();
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetAchievementAchievedPercent") as fn(ptr, ptr, ptr): bool;
    if f(us(), n, out) {
        return rdF32(out, 0);
    }
    return 0.0 - 1.0;
}

// ---- callbacks, shutdown ----

fn onStatsStored(p: ptr, n: i32) {
    let r = rdI32(p, OFF_STORED_RESULT);
    if r != RESULT_OK {
        DIRTY = true;
        eprint(`steam: StoreStats failed (EResult {r}); stats stay unsaved`);
    }
}

/// Shutdown hook: save what changed, then forget fake state and parked requests.
fn statsDown() {
    if DIRTY {
        store();
    }
    FACH_N = 0;
    FSTAT_N = 0;
    PCT_READY = false;
    DIRTY = false;
    for i in 0..REQ_N {
        REQS[i].used = false;
    }
    boardsReset();
}

/// Read this part's offsets and register its callbacks and hook; called once from `registerParts`.
fn statsInit() {
    sb();
    OFF_STORED_GAME = lay("UserStatsStored_t", "gameId");
    OFF_STORED_RESULT = lay("UserStatsStored_t", "eResult");
    STORED_SIZE = lay("UserStatsStored_t", SIZE);
    OFF_PCT_GAME = lay("GlobalAchievementPercentagesReady_t", "gameId");
    OFF_PCT_RESULT = lay("GlobalAchievementPercentagesReady_t", "eResult");
    PCT_SIZE = lay("GlobalAchievementPercentagesReady_t", SIZE);
    onCallback(CB_STATS_STORED, onStatsStored);
    onShutdown(statsDown);
    boardsInit();
}
