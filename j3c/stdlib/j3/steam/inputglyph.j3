// Part of j3.steam: ISteamInput actions, origins, motion and glyph files; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// The handle of digital action `name` (a button in the action manifest), cached by name. 0 when unknown or Steam Input is not started.
pub fn digitalAction(name: string): u64 {
    if !INPUT_ON || name.len == 0 {
        return u64(0);
    }
    let h = ncGet(&C_DIGITAL, name);
    if h != u64(0) {
        return h;
    }
    if fake() {
        h = u64(C_DIGITAL.n + 1);
    } else {
        let p = cs(name, 0);
        if p as int == 0 {
            return u64(0);
        }
        let f = method("SteamInput", "SteamAPI_ISteamInput_GetDigitalActionHandle") as fn(ptr, ptr): u64;
        h = f(si(), p);
    }
    if h != u64(0) {
        ncPut(&C_DIGITAL, name, h);
    }
    return h;
}

/// The handle of analog action `name` (a stick, trigger or mouse in the manifest), cached by name. 0 when unknown.
pub fn analogAction(name: string): u64 {
    if !INPUT_ON || name.len == 0 {
        return u64(0);
    }
    let h = ncGet(&C_ANALOG, name);
    if h != u64(0) {
        return h;
    }
    if fake() {
        h = u64(C_ANALOG.n + 1);
    } else {
        let p = cs(name, 0);
        if p as int == 0 {
            return u64(0);
        }
        let f = method("SteamInput", "SteamAPI_ISteamInput_GetAnalogActionHandle") as fn(ptr, ptr): u64;
        h = f(si(), p);
    }
    if h != u64(0) {
        ncPut(&C_ANALOG, name, h);
    }
    return h;
}

/// The state of digital `action` on controller `h`. All false when Steam Input is not started.
pub fn digital(h: u64, action: u64): Digital {
    if !INPUT_ON {
        return Digital { state: false, active: false };
    }
    if fake() {
        return fakeDigital(h, action);
    }
    return digitalRaw(h, action);
}

/// The state of analog `action` on controller `h`. Zeros and `active` false when Steam Input is not started.
pub fn analog(h: u64, action: u64): Analog {
    if !INPUT_ON {
        return Analog { mode: i32(0), x: 0.0, y: 0.0, active: false };
    }
    if fake() {
        return fakeAnalogState(h, action);
    }
    return analogRaw(h, action);
}

/// Stop the momentum of an analog action that was flung (a trackpad swipe).
pub fn stopMomentum(h: u64, action: u64) {
    if !INPUT_ON {
        return;
    }
    if fake() {
        fakeLog(`stopMomentum {h} {action}`);
        return;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_StopAnalogActionMomentum") as fn(ptr, u64, u64);
    f(si(), h, action);
}

/// Gyro and accelerometer of `h`; zeros when Steam Input is not started or in fake mode. Only on x86-64 targets (other CPUs log once and get zeros, see `inputabi.j3`).
pub fn motion(h: u64): Motion {
    if !INPUT_ON || fake() {
        return Motion { qx: 0.0, qy: 0.0, qz: 0.0, qw: 0.0, ax: 0.0, ay: 0.0, az: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
    }
    return motionRaw(h);
}

/// Fill `out` with the origins (physical inputs, `EInputActionOrigin`) bound to digital `action` in `set` for `h`; returns how many.
/// `out` must hold `INPUT_MAX_ORIGINS` (8), else the call is refused (logged once, returns 0).
pub fn digitalOrigins(h: u64, set: u64, action: u64, out: []i32): int {
    if out.len < INPUT_MAX_ORIGINS {
        eprintOnce(`steam: digitalOrigins needs room for {INPUT_MAX_ORIGINS} origins, got {out.len}; call refused`);
        return 0;
    }
    if !INPUT_ON {
        return 0;
    }
    if fake() {
        out[0] = ORIGIN_FAKE;
        return 1;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetDigitalActionOrigins") as fn(ptr, u64, u64, u64, ptr): i32;
    return int(f(si(), h, set, action, out.ptr as ptr));
}

/// Like `digitalOrigins`, for an analog action.
pub fn analogOrigins(h: u64, set: u64, action: u64, out: []i32): int {
    if out.len < INPUT_MAX_ORIGINS {
        eprintOnce(`steam: analogOrigins needs room for {INPUT_MAX_ORIGINS} origins, got {out.len}; call refused`);
        return 0;
    }
    if !INPUT_ON {
        return 0;
    }
    if fake() {
        out[0] = ORIGIN_FAKE;
        return 1;
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetAnalogActionOrigins") as fn(ptr, u64, u64, u64, ptr): i32;
    return int(f(si(), h, set, action, out.ptr as ptr));
}

/// The manifest name of digital `action`. "" when unknown or absent. Valid until the next frame.
pub fn digitalName(action: u64): string {
    if !INPUT_ON {
        return "";
    }
    if fake() {
        return "fake_digital";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetStringForDigitalActionName") as fn(ptr, u64): ptr;
    return fromC(f(si(), action));
}

/// The manifest name of analog `action`. "" when unknown or absent. Valid until the next frame.
pub fn analogName(action: u64): string {
    if !INPUT_ON {
        return "";
    }
    if fake() {
        return "fake_analog";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetStringForAnalogActionName") as fn(ptr, u64): ptr;
    return fromC(f(si(), action));
}

/// Path of a PNG glyph file for `origin` (what you show as "press (A)"), made by Steam on disk. `size` is `GLYPH_SMALL`
/// (32 px), `GLYPH_MEDIUM` (128) or `GLYPH_LARGE` (256); `flags` adds `GLYPH_*` style bits (0 for the default). "" when there is none,
/// when Steam Input is not started, and in fake mode (no files). Valid until the next frame.
pub fn glyphPng(origin: i32, size: int, flags: u32): string {
    if !INPUT_ON || fake() {
        return "";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetGlyphPNGForActionOrigin") as fn(ptr, i32, i32, u32): ptr;
    return fromC(f(si(), origin, i32(size), flags));
}

/// Path of an SVG glyph file for `origin`; same rules as `glyphPng`.
pub fn glyphSvg(origin: i32, flags: u32): string {
    if !INPUT_ON || fake() {
        return "";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetGlyphSVGForActionOrigin") as fn(ptr, i32, u32): ptr;
    return fromC(f(si(), origin, flags));
}

/// The display name of `origin` ("A", "Left Trigger"), in the user's language. "" when absent. Valid until the next frame.
pub fn originName(origin: i32): string {
    if !INPUT_ON {
        return "";
    }
    if fake() {
        return "Fake A";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetStringForActionOrigin") as fn(ptr, i32): ptr;
    return fromC(f(si(), origin));
}

/// The display name of an Xbox origin (`EXboxOrigin`). "" when absent.
pub fn xboxOriginName(origin: i32): string {
    if !INPUT_ON || fake() {
        return "";
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetStringForXboxOrigin") as fn(ptr, i32): ptr;
    return fromC(f(si(), origin));
}

/// The action origin that stands for Xbox origin `xboxOrigin` on controller `h`. 0 when absent.
pub fn originFromXbox(h: u64, xboxOrigin: i32): i32 {
    if !INPUT_ON || fake() {
        return i32(0);
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetActionOriginFromXboxOrigin") as fn(ptr, u64, i32): i32;
    return f(si(), h, xboxOrigin);
}

/// The origin on controller type `destInputType` (an `INPUT_*` constant) that matches `origin`, for showing another pad's glyph.
pub fn translateOrigin(destInputType: int, origin: i32): i32 {
    if !INPUT_ON || fake() {
        return i32(0);
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_TranslateActionOrigin") as fn(ptr, i32, i32): i32;
    return f(si(), i32(destInputType), origin);
}
