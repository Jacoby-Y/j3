// Part of j3.steam: fake-mode leaderboards, kept in memory; the module doc and `use`s are in ../steam.j3.
module j3.steam;

struct FBoard {
    name: string;
    sort: i32;
    display: i32;
}

/// One stored score. `FE` is kept sorted by board, then rank, so a board's rows are one run and rank is the position in it.
struct FEnt {
    board: int;
    user: u64;
    score: i32;
    detOff: int;
    detN: int;
}

/// One entry of a download, copied when the request is made.
struct FSnap {
    user: u64;
    rank: i32;
    score: i32;
    detOff: int;
    detN: int;
}

#[singleton]
let FB: []FBoard;
#[singleton]
let FB_N: int = 0;
#[singleton]
let FE: []FEnt;
#[singleton]
let FE_N: int = 0;
/// Detail values of all stored and downloaded entries; only grows while fake mode runs (dev only).
#[singleton]
let FDET: []i32;
#[singleton]
let FDET_N: int = 0;
#[singleton]
let FS: []FSnap;
#[singleton]
let FS_N: int = 0;
/// Downloads asked for and not yet delivered; the snapshot pool empties when it reaches 0.
#[singleton]
let FS_LIVE: int = 0;

fn boardsReset() {
    FB_N = 0;
    FE_N = 0;
    FDET_N = 0;
    FS_N = 0;
    FS_LIVE = 0;
}

fn boardFind(name: string, create: bool, sort: i32, display: i32): int {
    for i in 0..FB_N {
        if same(FB[i].name, name) {
            return i;
        }
    }
    if !create {
        return 0 - 1;
    }
    if FB_N >= FB.len {
        FB = grown(FB, FB_N);
    }
    FB[FB_N] = FBoard { name: keep(name), sort: sort, display: display };
    FB_N += 1;
    return FB_N - 1;
}

/// Index of the board with handle `h` (handle = index + 1), or -1.
fn boardAt(h: u64): int {
    let i = int(h) - 1;
    if i < 0 || i >= FB_N {
        return 0 - 1;
    }
    return i;
}

fn runStart(b: int): int {
    for i in 0..FE_N {
        if FE[i].board == b {
            return i;
        }
    }
    return FE_N;
}

fn runCount(b: int): int {
    let s = runStart(b);
    let n = 0;
    while s + n < FE_N && FE[s + n].board == b {
        n += 1;
    }
    return n;
}

/// True when score `a` ranks above score `b` under sort method `sort`.
fn better(sort: i32, a: i32, b: i32): bool {
    if sort == SORT_ASC {
        return a < b;
    }
    return a > b;
}

fn storeDetails(d: []i32): int {
    let off = FDET_N;
    while FDET_N + d.len > FDET.len {
        FDET = grown(FDET, FDET_N);
    }
    for i in 0..d.len {
        FDET[FDET_N + i] = d[i];
    }
    FDET_N += d.len;
    return off;
}

#[singleton]
let PUT_CHANGED: bool = false;
#[singleton]
let PUT_RANK: i32 = 0;
#[singleton]
let PUT_PREV: i32 = 0;

/// Store `score` for `user` on board index `b` (`method` as in `uploadScore`); the outcome is left in
/// `PUT_CHANGED`, `PUT_RANK` (rank now) and `PUT_PREV` (rank before, 0 if none).
fn fakePut(b: int, user: u64, method: i32, score: i32, details: []i32) {
    let sort = FB[b].sort;
    let s = runStart(b);
    let n = runCount(b);
    let at = 0 - 1;
    for i in s..s + n {
        if FE[i].user == user {
            at = i;
        }
    }
    PUT_CHANGED = false;
    PUT_RANK = 0;
    PUT_PREV = 0;
    if at >= 0 {
        PUT_RANK = i32(at - s + 1);
        PUT_PREV = PUT_RANK;
        let old = FE[at].score;
        if method == UPLOAD_KEEP_BEST && !better(sort, score, old) {
            return;
        }
        if score == old {
            FE[at].detOff = storeDetails(details);
            FE[at].detN = details.len;
            return;
        }
        for i in at..FE_N - 1 {
            FE[i] = FE[i + 1];
        }
        FE_N -= 1;
        n -= 1;
    }
    // a new score goes after equal ones, so ties keep upload order
    let pos = s + n;
    for i in s..s + n {
        if better(sort, score, FE[i].score) {
            pos = i;
            break;
        }
    }
    if FE_N >= FE.len {
        FE = grown(FE, FE_N);
    }
    let k = FE_N;
    while k > pos {
        FE[k] = FE[k - 1];
        k -= 1;
    }
    FE[pos] = FEnt { board: b, user: user, score: score, detOff: storeDetails(details), detN: details.len };
    FE_N += 1;
    PUT_CHANGED = true;
    PUT_RANK = i32(pos - s + 1);
}

/// Fake: put a score from another player on a board (keep-best), so tests and demos have rivals.
/// Returns false outside fake mode or when `board` is not a handle from `findOrCreateBoard`.
pub fn fakeScore(board: u64, user: u64, score: i32): bool {
    let b = boardAt(board);
    if !fake() || b < 0 {
        return false;
    }
    let none: []i32 = @slice(0 as ptr, 0);
    fakePut(b, user, UPLOAD_KEEP_BEST, score, none);
    return true;
}

fn snapPush(e: FEnt, rank: int) {
    if FS_N >= FS.len {
        FS = grown(FS, FS_N);
    }
    FS[FS_N] = FSnap { user: e.user, rank: i32(rank), score: e.score, detOff: e.detOff, detN: e.detN };
    FS_N += 1;
}

fn inIds(ids: []u64, u: u64): bool {
    for i in 0..ids.len {
        if ids[i] == u {
            return true;
        }
    }
    return false;
}

/// Snapshot the entries a download asks for onto `FS`; returns where they start in `FS`.
fn fakeDownload(b: int, request: i32, start: int, end: int, ids: []u64, byIds: bool): int {
    let first = FS_N;
    let s = runStart(b);
    let n = runCount(b);
    let lo = 1;
    let hi = n;
    let filter = byIds || request == DOWNLOAD_FRIENDS;
    if !filter && request == DOWNLOAD_AROUND_USER {
        let me = 0;
        for i in s..s + n {
            if FE[i].user == FAKE_USER {
                me = i - s + 1;
            }
        }
        if me == 0 {
            return first;
        }
        lo = me + start;
        hi = me + end;
    } else if !filter {
        lo = start;
        hi = end;
    }
    if lo < 1 {
        lo = 1;
    }
    if hi > n {
        hi = n;
    }
    for r in lo..=hi {
        let e = FE[s + r - 1];
        if byIds && !inIds(ids, e.user) {
            continue;
        }
        if request == DOWNLOAD_FRIENDS && !byIds && e.user != FAKE_USER {
            continue;
        }
        snapPush(e, r);
    }
    return first;
}

fn fakeEntry(s: &Scores, i: int, out: ptr, max: int): Entry {
    let at = int(s.handle) - 1 + i;
    if at < 0 || at >= FS_N {
        return emptyEntry();
    }
    let e = FS[at];
    let m = e.detN;
    if m > max {
        m = max;
    }
    for k in 0..m {
        wrI32(out, k * 4, FDET[e.detOff + k]);
    }
    return Entry { user: e.user, rank: e.rank, score: e.score, details: e.detN };
}
