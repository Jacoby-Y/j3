// Part of j3.steam: byte-offset readers and writers, and the struct layout table; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// One row of the layout table: where `field` of the Steam struct `name` sits, for each pack rule.
/// A row whose `field` is `SIZE` gives the struct's total size instead.
pub struct Layout {
    /// Steam struct name, e.g. `CallbackMsg_t`.
    name: string;
    /// Field name as in the Steamworks header, or `SIZE`.
    field: string;
    /// Byte offset (or size) under pack(4): Linux and macOS.
    pack4: int;
    /// Byte offset (or size) under pack(8): Windows.
    pack8: int;
}

/// `Layout.field` of a row that holds the struct's total size.
pub const SIZE: string = "SIZE";

#[singleton]
let LAYS: []Layout;
#[singleton]
let LAY_N: int = 0;

fn addLayout(name: string, field: string, pack4: int, pack8: int) {
    if LAY_N >= LAYS.len {
        let fresh = arena().alloc::<Layout>(LAYS.len * 2 + 32);
        for i in 0..LAY_N {
            fresh[i] = LAYS[i];
        }
        LAYS = fresh;
    }
    LAYS[LAY_N] = Layout { name: name, field: field, pack4: pack4, pack8: pack8 };
    LAY_N += 1;
}

/// Every struct field `j3.steam` reads or writes, by byte offset, built on first use. The binding
/// checker (`steam-check`) compares these rows (one `addLayout("Struct", "field", pack4, pack8)` line
/// each) with `offsetof` in the SDK headers. A part that reads a field adds its row here; the readers
/// below never assume an offset.
fn buildLayouts() {
    // { HSteamUser hSteamUser; int iCallback; uint8 *pubParam; int cubParam; }
    addLayout("CallbackMsg_t", "hSteamUser", 0, 0);
    addLayout("CallbackMsg_t", "iCallback", 4, 4);
    addLayout("CallbackMsg_t", "pubParam", 8, 8);
    addLayout("CallbackMsg_t", "cubParam", 16, 16);
    addLayout("CallbackMsg_t", SIZE, 20, 24);
    // { SteamAPICall_t hAsyncCall; int iCallback; uint32 cubParam; }
    addLayout("SteamAPICallCompleted_t", "hAsyncCall", 0, 0);
    addLayout("SteamAPICallCompleted_t", "iCallback", 8, 8);
    addLayout("SteamAPICallCompleted_t", "cubParam", 12, 12);
    addLayout("SteamAPICallCompleted_t", SIZE, 16, 16);
    // { uint8 bActive; bool bUserInitiated; AppId_t nAppID; uint32 dwOverlayPID; } only bActive is read
    addLayout("GameOverlayActivated_t", "bActive", 0, 0);
    // { uint64 m_nGameID; EResult m_eResult; } UserStatsStored_t and GlobalAchievementPercentagesReady_t
    addLayout("UserStatsStored_t", "gameId", 0, 0);
    addLayout("UserStatsStored_t", "eResult", 8, 8);
    addLayout("UserStatsStored_t", SIZE, 12, 16);
    addLayout("GlobalAchievementPercentagesReady_t", "gameId", 0, 0);
    addLayout("GlobalAchievementPercentagesReady_t", "eResult", 8, 8);
    addLayout("GlobalAchievementPercentagesReady_t", SIZE, 12, 16);
    // { SteamLeaderboard_t hSteamLeaderboard; uint8 bLeaderboardFound; }
    addLayout("LeaderboardFindResult_t", "hSteamLeaderboard", 0, 0);
    addLayout("LeaderboardFindResult_t", "bLeaderboardFound", 8, 8);
    addLayout("LeaderboardFindResult_t", SIZE, 12, 16);
    // { uint8 bSuccess; SteamLeaderboard_t hSteamLeaderboard; int32 nScore; uint8 bScoreChanged; int nGlobalRankNew; int nGlobalRankPrevious; }
    addLayout("LeaderboardScoreUploaded_t", "bSuccess", 0, 0);
    addLayout("LeaderboardScoreUploaded_t", "hSteamLeaderboard", 4, 8);
    addLayout("LeaderboardScoreUploaded_t", "nScore", 12, 16);
    addLayout("LeaderboardScoreUploaded_t", "bScoreChanged", 16, 20);
    addLayout("LeaderboardScoreUploaded_t", "nGlobalRankNew", 20, 24);
    addLayout("LeaderboardScoreUploaded_t", "nGlobalRankPrevious", 24, 28);
    addLayout("LeaderboardScoreUploaded_t", SIZE, 28, 32);
    // { SteamLeaderboard_t hSteamLeaderboard; SteamLeaderboardEntries_t hSteamLeaderboardEntries; int cEntryCount; }
    addLayout("LeaderboardScoresDownloaded_t", "hSteamLeaderboard", 0, 0);
    addLayout("LeaderboardScoresDownloaded_t", "hSteamLeaderboardEntries", 8, 8);
    addLayout("LeaderboardScoresDownloaded_t", "cEntryCount", 16, 16);
    addLayout("LeaderboardScoresDownloaded_t", SIZE, 20, 24);
    // { CSteamID m_steamIDUser; int32 m_nGlobalRank; int32 m_nScore; int32 m_cDetails; UGCHandle_t m_hUGC; }
    addLayout("LeaderboardEntry_t", "steamIDUser", 0, 0);
    addLayout("LeaderboardEntry_t", "nGlobalRank", 8, 8);
    addLayout("LeaderboardEntry_t", "nScore", 12, 12);
    addLayout("LeaderboardEntry_t", "cDetails", 16, 16);
    addLayout("LeaderboardEntry_t", "hUGC", 20, 24);
    addLayout("LeaderboardEntry_t", SIZE, 28, 32);
    // { CSteamID m_steamID; int m_iImage; int m_iWide; int m_iTall; } AvatarImageLoaded_t
    addLayout("AvatarImageLoaded_t", "steamID", 0, 0);
    addLayout("AvatarImageLoaded_t", "iImage", 8, 8);
    addLayout("AvatarImageLoaded_t", "iWide", 12, 12);
    addLayout("AvatarImageLoaded_t", "iTall", 16, 16);
    addLayout("AvatarImageLoaded_t", SIZE, 20, 20);
    // { CSteamID m_steamIDFriend; char m_rgchConnect[256]; }
    addLayout("GameRichPresenceJoinRequested_t", "steamIDFriend", 0, 0);
    addLayout("GameRichPresenceJoinRequested_t", "rgchConnect", 8, 8);
    addLayout("GameRichPresenceJoinRequested_t", SIZE, 264, 264);
    // { bool m_bSubmitted; uint32 m_unSubmittedText; AppId_t m_unAppID; }
    addLayout("GamepadTextInputDismissed_t", "bSubmitted", 0, 0);
    addLayout("GamepadTextInputDismissed_t", "unSubmittedText", 4, 4);
    addLayout("GamepadTextInputDismissed_t", "unAppID", 8, 8);
    addLayout("GamepadTextInputDismissed_t", SIZE, 12, 12);
    // {} FloatingGamepadTextInputDismissed_t and ScreenshotRequested_t are empty structs (size 1)
    addLayout("FloatingGamepadTextInputDismissed_t", SIZE, 1, 1);
    addLayout("ScreenshotRequested_t", SIZE, 1, 1);
    // { ScreenshotHandle m_hLocal; EResult m_eResult; }
    addLayout("ScreenshotReady_t", "hLocal", 0, 0);
    addLayout("ScreenshotReady_t", "eResult", 4, 4);
    addLayout("ScreenshotReady_t", SIZE, 8, 8);
    // { AppId_t m_nAppID; } DlcInstalled_t
    addLayout("DlcInstalled_t", "nAppID", 0, 0);
    addLayout("DlcInstalled_t", SIZE, 4, 4);
    // {} NewUrlLaunchParameters_t is an empty struct (size 1)
    addLayout("NewUrlLaunchParameters_t", SIZE, 1, 1);
    // { EResult m_eResult; }
    addLayout("RemoteStorageFileWriteAsyncComplete_t", "eResult", 0, 0);
    addLayout("RemoteStorageFileWriteAsyncComplete_t", SIZE, 4, 4);
    // { SteamAPICall_t m_hFileReadAsync; EResult m_eResult; uint32 m_nOffset; uint32 m_cubRead; }
    addLayout("RemoteStorageFileReadAsyncComplete_t", "hFileReadAsync", 0, 0);
    addLayout("RemoteStorageFileReadAsyncComplete_t", "eResult", 8, 8);
    addLayout("RemoteStorageFileReadAsyncComplete_t", "nOffset", 12, 12);
    addLayout("RemoteStorageFileReadAsyncComplete_t", "cubRead", 16, 16);
    addLayout("RemoteStorageFileReadAsyncComplete_t", SIZE, 20, 24);
    // { InputHandle_t m_ulConnectedDeviceHandle; } SteamInputDeviceConnected_t and SteamInputDeviceDisconnected_t
    addLayout("SteamInputDeviceConnected_t", "deviceHandle", 0, 0);
    addLayout("SteamInputDeviceConnected_t", SIZE, 8, 8);
    addLayout("SteamInputDeviceDisconnected_t", "deviceHandle", 0, 0);
    addLayout("SteamInputDeviceDisconnected_t", SIZE, 8, 8);
    // { AppId_t m_unAppID; InputHandle_t m_ulDeviceHandle; CSteamID m_ulMappingCreator; uint32 m_unMajorRevision; uint32 m_unMinorRevision; bool m_bUsesSteamInputAPI; bool m_bUsesGamepadAPI; }
    addLayout("SteamInputConfigurationLoaded_t", "appID", 0, 0);
    addLayout("SteamInputConfigurationLoaded_t", "deviceHandle", 4, 8);
    addLayout("SteamInputConfigurationLoaded_t", "mappingCreator", 12, 16);
    addLayout("SteamInputConfigurationLoaded_t", "majorRevision", 20, 24);
    addLayout("SteamInputConfigurationLoaded_t", "minorRevision", 24, 28);
    addLayout("SteamInputConfigurationLoaded_t", "usesSteamInputAPI", 28, 32);
    addLayout("SteamInputConfigurationLoaded_t", "usesGamepadAPI", 29, 33);
    addLayout("SteamInputConfigurationLoaded_t", SIZE, 32, 40);
    // { AppId_t m_unAppID; InputHandle_t m_ulDeviceHandle; ESteamInputType m_eDeviceType; int m_nOldGamepadSlot; int m_nNewGamepadSlot; }
    addLayout("SteamInputGamepadSlotChange_t", "appID", 0, 0);
    addLayout("SteamInputGamepadSlotChange_t", "deviceHandle", 4, 8);
    addLayout("SteamInputGamepadSlotChange_t", "deviceType", 12, 16);
    addLayout("SteamInputGamepadSlotChange_t", "oldGamepadSlot", 16, 20);
    addLayout("SteamInputGamepadSlotChange_t", "newGamepadSlot", 20, 24);
    addLayout("SteamInputGamepadSlotChange_t", SIZE, 24, 32);
    // { bool bState; bool bActive; } returned by value, so these are not callback packing: same on both rules
    addLayout("InputDigitalActionData_t", "bState", 0, 0);
    addLayout("InputDigitalActionData_t", "bActive", 1, 1);
    addLayout("InputDigitalActionData_t", SIZE, 2, 2);
    // { EInputSourceMode eMode; float x; float y; bool bActive; }
    addLayout("InputAnalogActionData_t", "eMode", 0, 0);
    addLayout("InputAnalogActionData_t", "x", 4, 4);
    addLayout("InputAnalogActionData_t", "y", 8, 8);
    addLayout("InputAnalogActionData_t", "bActive", 12, 12);
    addLayout("InputAnalogActionData_t", SIZE, 13, 13);
    // Lobbies (ISteamMatchmaking). Results: LobbyCreated_t 513, LobbyMatchList_t 510, LobbyEnter_t 504.
    // { EResult m_eResult; uint64 m_ulSteamIDLobby; }
    addLayout("LobbyCreated_t", "eResult", 0, 0);
    addLayout("LobbyCreated_t", "ulSteamIDLobby", 4, 8);
    addLayout("LobbyCreated_t", SIZE, 12, 16);
    // { uint32 m_nLobbiesMatching; }
    addLayout("LobbyMatchList_t", "nLobbiesMatching", 0, 0);
    addLayout("LobbyMatchList_t", SIZE, 4, 4);
    // { uint64 m_ulSteamIDLobby; uint32 m_rgfChatPermissions; bool m_bLocked; uint32 m_EChatRoomEnterResponse; }
    addLayout("LobbyEnter_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyEnter_t", "rgfChatPermissions", 8, 8);
    addLayout("LobbyEnter_t", "bLocked", 12, 12);
    addLayout("LobbyEnter_t", "EChatRoomEnterResponse", 16, 16);
    addLayout("LobbyEnter_t", SIZE, 20, 24);
    // { uint64 m_ulSteamIDLobby; uint64 m_ulSteamIDMember; uint8 m_bSuccess; } LobbyDataUpdate_t 505
    addLayout("LobbyDataUpdate_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyDataUpdate_t", "ulSteamIDMember", 8, 8);
    addLayout("LobbyDataUpdate_t", "bSuccess", 16, 16);
    addLayout("LobbyDataUpdate_t", SIZE, 20, 24);
    // { uint64 m_ulSteamIDLobby; uint64 m_ulSteamIDUserChanged; uint64 m_ulSteamIDMakingChange; uint32 m_rgfChatMemberStateChange; } 506
    addLayout("LobbyChatUpdate_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyChatUpdate_t", "ulSteamIDUserChanged", 8, 8);
    addLayout("LobbyChatUpdate_t", "ulSteamIDMakingChange", 16, 16);
    addLayout("LobbyChatUpdate_t", "rgfChatMemberStateChange", 24, 24);
    addLayout("LobbyChatUpdate_t", SIZE, 28, 32);
    // { uint64 m_ulSteamIDLobby; uint64 m_ulSteamIDUser; uint8 m_eChatEntryType; uint32 m_iChatID; } 507
    addLayout("LobbyChatMsg_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyChatMsg_t", "ulSteamIDUser", 8, 8);
    addLayout("LobbyChatMsg_t", "eChatEntryType", 16, 16);
    addLayout("LobbyChatMsg_t", "iChatID", 20, 20);
    addLayout("LobbyChatMsg_t", SIZE, 24, 24);
    // { uint64 m_ulSteamIDLobby; uint64 m_ulSteamIDGameServer; uint32 m_unIP; uint16 m_usPort; } 509
    addLayout("LobbyGameCreated_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyGameCreated_t", "ulSteamIDGameServer", 8, 8);
    addLayout("LobbyGameCreated_t", "unIP", 16, 16);
    addLayout("LobbyGameCreated_t", "usPort", 20, 20);
    addLayout("LobbyGameCreated_t", SIZE, 24, 24);
    // { uint64 m_ulSteamIDUser; uint64 m_ulSteamIDLobby; uint64 m_ulGameID; } 503
    addLayout("LobbyInvite_t", "ulSteamIDUser", 0, 0);
    addLayout("LobbyInvite_t", "ulSteamIDLobby", 8, 8);
    addLayout("LobbyInvite_t", "ulGameID", 16, 16);
    addLayout("LobbyInvite_t", SIZE, 24, 24);
    // { uint64 m_ulSteamIDLobby; uint64 m_ulSteamIDAdmin; uint8 m_bKickedDueToDisconnect; } 512
    addLayout("LobbyKicked_t", "ulSteamIDLobby", 0, 0);
    addLayout("LobbyKicked_t", "ulSteamIDAdmin", 8, 8);
    addLayout("LobbyKicked_t", "bKickedDueToDisconnect", 16, 16);
    addLayout("LobbyKicked_t", SIZE, 20, 24);
    // { CSteamID m_steamIDLobby; CSteamID m_steamIDFriend; } GameLobbyJoinRequested_t 333
    addLayout("GameLobbyJoinRequested_t", "steamIDLobby", 0, 0);
    addLayout("GameLobbyJoinRequested_t", "steamIDFriend", 8, 8);
    addLayout("GameLobbyJoinRequested_t", SIZE, 16, 16);
    // { float rotQuatX, rotQuatY, rotQuatZ, rotQuatW, posAccelX, posAccelY, posAccelZ, rotVelX, rotVelY, rotVelZ; }
    addLayout("InputMotionData_t", "rotQuatX", 0, 0);
    addLayout("InputMotionData_t", "rotQuatY", 4, 4);
    addLayout("InputMotionData_t", "rotQuatZ", 8, 8);
    addLayout("InputMotionData_t", "rotQuatW", 12, 12);
    addLayout("InputMotionData_t", "posAccelX", 16, 16);
    addLayout("InputMotionData_t", "posAccelY", 20, 20);
    addLayout("InputMotionData_t", "posAccelZ", 24, 24);
    addLayout("InputMotionData_t", "rotVelX", 28, 28);
    addLayout("InputMotionData_t", "rotVelY", 32, 32);
    addLayout("InputMotionData_t", "rotVelZ", 36, 36);
    addLayout("InputMotionData_t", SIZE, 40, 40);
    netLayoutInit();
}

/// True when Steam structs use pack(8) (Windows); false for pack(4) (Linux, macOS).
pub fn packLarge(): bool {
    return sys.PLATFORM == sys.PLATFORM_WINDOWS;
}

fn pick(r: Layout, large: bool): int {
    if large {
        return r.pack8;
    }
    return r.pack4;
}

/// Offset of `field` in struct `name` under pack(8) (`large`) or pack(4). Prints an error once and
/// returns 0 for a name the table lacks, so a typo shows up on stderr instead of reading garbage.
pub fn layAt(name: string, field: string, large: bool): int {
    if LAY_N == 0 {
        buildLayouts();
    }
    for i in 0..LAY_N {
        if same(LAYS[i].name, name) && same(LAYS[i].field, field) {
            return pick(LAYS[i], large);
        }
    }
    eprintOnce(`steam: no layout row for {name}.{field}`);
    return 0;
}

/// `layAt` for this platform's pack rule. Parts call it once and keep the number.
pub fn lay(name: string, field: string): int {
    return layAt(name, field, packLarge());
}

fn byteAt(p: ptr, off: int): u8 {
    let b = ((p as int + off) as ptr) as &u8;
    return *b;
}

fn putAt(p: ptr, off: int, v: u8) {
    let b = ((p as int + off) as ptr) as &u8;
    *b = v;
}

/// Byte `off` bytes past `p`.
pub fn rdU8(p: ptr, off: int): u8 {
    return byteAt(p, off);
}

/// Bool (one byte, non-zero is true) `off` bytes past `p`.
pub fn rdBool(p: ptr, off: int): bool {
    return byteAt(p, off) != u8(0);
}

/// Little-endian u32; safe at any alignment (assembled from bytes).
pub fn rdU32(p: ptr, off: int): u32 {
    let v = int(byteAt(p, off)) + int(byteAt(p, off + 1)) * 256 + int(byteAt(p, off + 2)) * 65536 + int(byteAt(p, off + 3)) * 16777216;
    return u32(v);
}

/// Little-endian i32; safe at any alignment.
pub fn rdI32(p: ptr, off: int): i32 {
    let v = int(rdU32(p, off));
    if v >= 2147483648 {
        v -= 4294967296;
    }
    return i32(v);
}

/// Little-endian u64; safe at any alignment.
pub fn rdU64(p: ptr, off: int): u64 {
    let lo = u64(rdU32(p, off));
    let hi = u64(rdU32(p, off + 4));
    return lo | (hi << u64(32));
}

/// Pointer stored at `off`; safe at any alignment (64-bit targets).
pub fn rdPtr(p: ptr, off: int): ptr {
    return rdU64(p, off) as int as ptr;
}

/// f32 stored at `off`; safe at any alignment.
pub fn rdF32(p: ptr, off: int): f32 {
    let tmp: [1]u32 = [rdU32(p, off)];
    let f = (&tmp[0] as ptr) as &f32;
    return *f;
}

/// Write one byte.
pub fn wrU8(p: ptr, off: int, v: u8) {
    putAt(p, off, v);
}

/// Write a bool as one byte.
pub fn wrBool(p: ptr, off: int, v: bool) {
    if v {
        putAt(p, off, u8(1));
    } else {
        putAt(p, off, u8(0));
    }
}

/// Write a little-endian u32 at any alignment.
pub fn wrU32(p: ptr, off: int, v: u32) {
    let x = int(v);
    for i in 0..4 {
        putAt(p, off + i, u8(x % 256));
        x = x / 256;
    }
}

/// Write a little-endian i32 at any alignment.
pub fn wrI32(p: ptr, off: int, v: i32) {
    let x = int(v);
    if x < 0 {
        x += 4294967296;
    }
    wrU32(p, off, u32(x));
}

/// Write a little-endian u64 at any alignment.
pub fn wrU64(p: ptr, off: int, v: u64) {
    wrU32(p, off, u32(v & u64(4294967295)));
    wrU32(p, off + 4, u32(v >> u64(32)));
}

/// Write a pointer at any alignment.
pub fn wrPtr(p: ptr, off: int, v: ptr) {
    wrU64(p, off, u64(v as int));
}

/// Write an f32 at any alignment.
pub fn wrF32(p: ptr, off: int, v: f32) {
    let tmp: [1]f32 = [v];
    let u = (&tmp[0] as ptr) as &u32;
    wrU32(p, off, *u);
}
