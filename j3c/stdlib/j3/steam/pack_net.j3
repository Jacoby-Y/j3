// Part of j3.steam: layout rows for networking structs (messages, identities, connection info, callbacks 1251, 1252, 1281).
// Sockets (netsock.j3) have theirs at the end. The module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Called at the end of `buildLayouts`: adds the networking rows to the same table.
fn netLayoutInit() {
    // ISteamNetworkingMessages (netid.j3). SteamNetworkingIdentity: { ESteamNetworkingIdentityType eType; int cbSize; union { uint64 m_steamID64; char m_szGenericString[32]; ... 128 bytes } }
    addLayout("SteamNetworkingIdentity", "eType", 0, 0);
    addLayout("SteamNetworkingIdentity", "cbSize", 4, 4);
    addLayout("SteamNetworkingIdentity", "steamID64", 8, 8);
    addLayout("SteamNetworkingIdentity", SIZE, 136, 136);
    // SteamNetworkingIPAddr is pack(1): { uint8 ipv6[16]; uint16 port; }
    addLayout("SteamNetworkingIPAddr", "ipv6", 0, 0);
    addLayout("SteamNetworkingIPAddr", "port", 16, 16);
    addLayout("SteamNetworkingIPAddr", SIZE, 18, 18);
    // SteamNetworkingMessage_t (pointers are 8 bytes; every field is naturally aligned, so both pack rules agree)
    addLayout("SteamNetworkingMessage_t", "pData", 0, 0);
    addLayout("SteamNetworkingMessage_t", "cbSize", 8, 8);
    addLayout("SteamNetworkingMessage_t", "conn", 12, 12);
    addLayout("SteamNetworkingMessage_t", "identityPeer", 16, 16);
    addLayout("SteamNetworkingMessage_t", "connUserData", 152, 152);
    addLayout("SteamNetworkingMessage_t", "usecTimeReceived", 160, 160);
    addLayout("SteamNetworkingMessage_t", "nMessageNumber", 168, 168);
    addLayout("SteamNetworkingMessage_t", "freeData", 176, 176);
    addLayout("SteamNetworkingMessage_t", "release", 184, 184);
    addLayout("SteamNetworkingMessage_t", "channel", 192, 192);
    addLayout("SteamNetworkingMessage_t", "flags", 196, 196);
    addLayout("SteamNetworkingMessage_t", "userData", 200, 200);
    addLayout("SteamNetworkingMessage_t", "idxLane", 208, 208);
    addLayout("SteamNetworkingMessage_t", SIZE, 216, 216);
    // SteamNetConnectionInfo_t: identityRemote, userData, listenSocket, addrRemote (18), pad, idPOPRemote, idPOPRelay, eState, eEndReason, szEndDebug[128], szConnectionDescription[128], nFlags, reserved[63]
    addLayout("SteamNetConnectionInfo_t", "identityRemote", 0, 0);
    addLayout("SteamNetConnectionInfo_t", "userData", 136, 136);
    addLayout("SteamNetConnectionInfo_t", "listenSocket", 144, 144);
    addLayout("SteamNetConnectionInfo_t", "addrRemote", 148, 148);
    addLayout("SteamNetConnectionInfo_t", "idPOPRemote", 168, 168);
    addLayout("SteamNetConnectionInfo_t", "idPOPRelay", 172, 172);
    addLayout("SteamNetConnectionInfo_t", "eState", 176, 176);
    addLayout("SteamNetConnectionInfo_t", "eEndReason", 180, 180);
    addLayout("SteamNetConnectionInfo_t", "szEndDebug", 184, 184);
    addLayout("SteamNetConnectionInfo_t", "szConnectionDescription", 312, 312);
    addLayout("SteamNetConnectionInfo_t", "nFlags", 440, 440);
    addLayout("SteamNetConnectionInfo_t", SIZE, 696, 696);
    // SteamNetConnectionRealTimeStatus_t: { eState; nPing; flConnectionQualityLocal; ...; usecQueueTime (int64 @48); reserved[16] } only nPing is read
    addLayout("SteamNetConnectionRealTimeStatus_t", "eState", 0, 0);
    addLayout("SteamNetConnectionRealTimeStatus_t", "nPing", 4, 4);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flConnectionQualityLocal", 8, 8);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flConnectionQualityRemote", 12, 12);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flOutPacketsPerSec", 16, 16);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flOutBytesPerSec", 20, 20);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flInPacketsPerSec", 24, 24);
    addLayout("SteamNetConnectionRealTimeStatus_t", "flInBytesPerSec", 28, 28);
    addLayout("SteamNetConnectionRealTimeStatus_t", "nSendRateBytesPerSecond", 32, 32);
    addLayout("SteamNetConnectionRealTimeStatus_t", "cbPendingUnreliable", 36, 36);
    addLayout("SteamNetConnectionRealTimeStatus_t", "cbPendingReliable", 40, 40);
    addLayout("SteamNetConnectionRealTimeStatus_t", "cbSentUnackedReliable", 44, 44);
    addLayout("SteamNetConnectionRealTimeStatus_t", "usecQueueTime", 48, 48);
    addLayout("SteamNetConnectionRealTimeStatus_t", SIZE, 120, 120);
    // { SteamNetworkingIdentity m_identityRemote; } SteamNetworkingMessagesSessionRequest_t 1251
    addLayout("SteamNetworkingMessagesSessionRequest_t", "identityRemote", 0, 0);
    addLayout("SteamNetworkingMessagesSessionRequest_t", SIZE, 136, 136);
    // { SteamNetConnectionInfo_t m_info; } SteamNetworkingMessagesSessionFailed_t 1252
    addLayout("SteamNetworkingMessagesSessionFailed_t", "info", 0, 0);
    addLayout("SteamNetworkingMessagesSessionFailed_t", SIZE, 696, 696);
    // { ESteamNetworkingAvailability m_eAvail; int m_bPingMeasurementInProgress; ESteamNetworkingAvailability m_eAvailNetworkConfig; m_eAvailAnyRelay; char m_debugMsg[256]; } SteamRelayNetworkStatus_t 1281
    addLayout("SteamRelayNetworkStatus_t", "eAvail", 0, 0);
    addLayout("SteamRelayNetworkStatus_t", "bPingMeasurementInProgress", 4, 4);
    addLayout("SteamRelayNetworkStatus_t", "eAvailNetworkConfig", 8, 8);
    addLayout("SteamRelayNetworkStatus_t", "eAvailAnyRelay", 12, 12);
    addLayout("SteamRelayNetworkStatus_t", "debugMsg", 16, 16);
    addLayout("SteamRelayNetworkStatus_t", SIZE, 272, 272);
    // { HSteamNetConnection m_hConn; SteamNetConnectionInfo_t m_info; ESteamNetworkingConnectionState m_eOldState; } SteamNetConnectionStatusChangedCallback_t 1221.
    // The info holds int64 fields, so on pack(8) it starts at 8 and the struct is padded to 712; on pack(4) it starts at 4 and the struct is 704.
    addLayout("SteamNetConnectionStatusChangedCallback_t", "hConn", 0, 0);
    addLayout("SteamNetConnectionStatusChangedCallback_t", "info", 4, 8);
    addLayout("SteamNetConnectionStatusChangedCallback_t", "eOldState", 700, 704);
    addLayout("SteamNetConnectionStatusChangedCallback_t", SIZE, 704, 712);
    // { ESteamNetworkingAvailability m_eAvail; char m_debugMsg[256]; } SteamNetAuthenticationStatus_t 1222
    addLayout("SteamNetAuthenticationStatus_t", "eAvail", 0, 0);
    addLayout("SteamNetAuthenticationStatus_t", "debugMsg", 4, 4);
    addLayout("SteamNetAuthenticationStatus_t", SIZE, 260, 260);
}
