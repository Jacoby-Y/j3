// Part of j3.steam: fake Steam Input (two pads, held buttons by hand); the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Handles of the two fake controllers: an Xbox One pad and a Steam Deck.
pub const FAKE_PAD_A: u64 = 1;
pub const FAKE_PAD_B: u64 = 2;
/// The one origin every fake action has (`k_EInputActionOrigin_A`).
pub const ORIGIN_FAKE: i32 = 1;

/// One held fake action: `analog` tells which handle space `action` is in.
struct FakeHeld {
    pad: u64;
    action: u64;
    analog: bool;
    on: bool;
    x: f32;
    y: f32;
}

#[singleton]
let FH: []FakeHeld;
#[singleton]
let FH_N: int = 0;
#[singleton]
let FSET: []u64;

fn fakePadType(h: u64): int {
    if h == FAKE_PAD_A {
        return INPUT_XBOX_ONE;
    }
    if h == FAKE_PAD_B {
        return INPUT_STEAM_DECK;
    }
    return INPUT_UNKNOWN;
}

fn fakePadAtSlot(i: int): u64 {
    if i == 0 {
        return FAKE_PAD_A;
    }
    if i == 1 {
        return FAKE_PAD_B;
    }
    return u64(0);
}

fn fakeSlotOf(h: u64): int {
    if h == FAKE_PAD_A {
        return 0;
    }
    if h == FAKE_PAD_B {
        return 1;
    }
    return -1;
}

fn fakeCurrent(h: u64): u64 {
    let at = fakeSlotOf(h);
    if at < 0 || FSET.len == 0 {
        return u64(0);
    }
    return FSET[at];
}

fn fakeSetCurrent(h: u64, set: u64) {
    if FSET.len == 0 {
        FSET = arena().alloc::<u64>(2);
        FSET[0] = u64(0);
        FSET[1] = u64(0);
    }
    if h == INPUT_ALL_CONTROLLERS {
        FSET[0] = set;
        FSET[1] = set;
        return;
    }
    let at = fakeSlotOf(h);
    if at >= 0 {
        FSET[at] = set;
    }
}

/// Queue the connect callback for fake pad `h`.
fn fakeConnect(h: u64) {
    let data = arena().alloc::<u8>(lay("SteamInputDeviceConnected_t", SIZE));
    wrU64(data.ptr as ptr, OFF_PAD_HANDLE, h);
    fakeCallback(CB_PAD_CONNECTED, data);
}

/// The row for (pad, action), made when missing.
fn fakeRow(pad: u64, action: u64, an: bool): int {
    for i in 0..FH_N {
        if FH[i].pad == pad && FH[i].action == action && FH[i].analog == an {
            return i;
        }
    }
    if FH_N >= FH.len {
        let fresh = arena().alloc::<FakeHeld>(FH.len * 2 + 8);
        for i in 0..FH_N {
            fresh[i] = FH[i];
        }
        FH = fresh;
    }
    FH[FH_N] = FakeHeld { pad: pad, action: action, analog: an, on: false, x: 0.0, y: 0.0 };
    FH_N += 1;
    return FH_N - 1;
}

fn fakeDigital(h: u64, action: u64): Digital {
    if fakePadType(h) == INPUT_UNKNOWN || action == u64(0) {
        return Digital { state: false, active: false };
    }
    return Digital { state: FH[fakeRow(h, action, false)].on, active: true };
}

fn fakeAnalogState(h: u64, action: u64): Analog {
    if fakePadType(h) == INPUT_UNKNOWN || action == u64(0) {
        return Analog { mode: i32(0), x: 0.0, y: 0.0, active: false };
    }
    let r = FH[fakeRow(h, action, true)];
    return Analog { mode: i32(1), x: r.x, y: r.y, active: true };
}

fn fakeInputReset() {
    FH_N = 0;
    if FSET.len > 0 {
        FSET[0] = u64(0);
        FSET[1] = u64(0);
    }
}

/// Fake mode: hold (`on`) or release digital `action` (from `digitalAction`) on fake pad `h`. No-op outside fake mode.
pub fn fakePress(h: u64, action: u64, on: bool) {
    if !fake() || !INPUT_ON {
        return;
    }
    FH[fakeRow(h, action, false)].on = on;
}

/// Fake mode: set analog `action` on fake pad `h` to (`x`, `y`). No-op outside fake mode.
pub fn fakeAnalog(h: u64, action: u64, x: f32, y: f32) {
    if !fake() || !INPUT_ON {
        return;
    }
    let at = fakeRow(h, action, true);
    FH[at].x = x;
    FH[at].y = y;
}
