// Part of j3.steam: fake-mode lobby search (filters, near-value ordering) and the test helpers that act as other users.
// The module doc and `use`s are in ../steam.j3.
module j3.steam;

// ---- search ----

fn flStrCmp(a: string, b: string): int {
    let n = a.len;
    if b.len < n {
        n = b.len;
    }
    for i in 0..n {
        if a[i] != b[i] {
            if a[i] < b[i] {
                return 0 - 1;
            }
            return 1;
        }
    }
    if a.len < b.len {
        return 0 - 1;
    }
    if a.len > b.len {
        return 1;
    }
    return 0;
}

/// `c` (-1, 0, 1: lobby value against the filter value) satisfies comparison `cmp`.
fn flHolds(c: int, cmp: int): bool {
    if cmp == CMP_EQUAL {
        return c == 0;
    }
    if cmp == CMP_LESS {
        return c < 0;
    }
    if cmp == CMP_EQUAL_OR_LESS {
        return c <= 0;
    }
    if cmp == CMP_GREATER {
        return c > 0;
    }
    if cmp == CMP_EQUAL_OR_GREATER {
        return c >= 0;
    }
    return c != 0;
}

/// Parse a decimal integer; `ok` false when `s` is not one.
fn flInt(s: string, okOut: &bool): int {
    *okOut = false;
    let i = 0;
    let neg = false;
    if s.len > 0 && s[0] == u8(45) {
        neg = true;
        i = 1;
    }
    if i >= s.len || s.len - i > 15 {
        return 0;
    }
    let v = 0;
    while i < s.len {
        let c = int(s[i]);
        if c < 48 || c > 57 {
            return 0;
        }
        v = v * 10 + (c - 48);
        i += 1;
    }
    *okOut = true;
    if neg {
        return 0 - v;
    }
    return v;
}

fn flAbs(v: int): int {
    if v < 0 {
        return 0 - v;
    }
    return v;
}

/// Does lobby `at` pass every filter? Near filters never reject; `score` receives their distance sum.
fn flPasses(at: int, score: &int): bool {
    let l = FLOBS[at];
    if l.kind != LOBBY_FRIENDS_ONLY && l.kind != LOBBY_PUBLIC {
        return false;
    }
    if F_SLOTS > 0 && l.max - flMemberCount(l.id) < F_SLOTS {
        return false;
    }
    *score = 0;
    for f in 0..FFILT_N {
        let ft = FFILTS[f];
        let k = flKvFind(l.id, u64(0), ft.key);
        if ft.kind == 0 {
            if k < 0 {
                if ft.cmp != CMP_NOT_EQUAL {
                    return false;
                }
            } else if !flHolds(flStrCmp(FKVS[k].value, ft.sv), ft.cmp) {
                return false;
            }
        } else {
            let isNum = false;
            let v = 0;
            if k >= 0 {
                v = flInt(FKVS[k].value, &isNum);
            }
            if ft.kind == 1 {
                if !isNum {
                    if ft.cmp != CMP_NOT_EQUAL {
                        return false;
                    }
                } else {
                    let c = 0;
                    if v < ft.nv {
                        c = 0 - 1;
                    }
                    if v > ft.nv {
                        c = 1;
                    }
                    if !flHolds(c, ft.cmp) {
                        return false;
                    }
                }
            } else if isNum {
                *score += flAbs(v - ft.nv);
            } else {
                *score += FL_FAR;
            }
        }
    }
    return true;
}

/// Fill `FFOUND` for the pending filters (near filters sort it, nearest first, ties by creation order), then clear them.
fn flSearch() {
    FFOUND_N = 0;
    if FFOUND.len < FLOB_N {
        FFOUND = arena().alloc::<u64>(FLOB_N + 16);
        FSCORE = arena().alloc::<int>(FLOB_N + 16);
    }
    for i in 0..FLOB_N {
        let s = 0;
        if flPasses(i, &s) {
            // insertion keeps the list sorted by score; equal scores stay in creation order
            let at = FFOUND_N;
            while at > 0 && FSCORE[at - 1] > s {
                FFOUND[at] = FFOUND[at - 1];
                FSCORE[at] = FSCORE[at - 1];
                at -= 1;
            }
            FFOUND[at] = FLOBS[i].id;
            FSCORE[at] = s;
            FFOUND_N += 1;
        }
    }
    if F_COUNT > 0 && FFOUND_N > F_COUNT {
        FFOUND_N = F_COUNT;
    }
    FFILT_N = 0;
    F_SLOTS = 0;
    F_COUNT = 0;
}

fn flAddFilter(kind: int, key: string, sv: string, nv: int, cmp: int) {
    if FFILT_N >= FFILTS.len {
        FFILTS = grown(FFILTS, FFILT_N);
    }
    FFILTS[FFILT_N] = FFilt { kind: kind, key: lkeep(key), sv: lkeep(sv), nv: nv, cmp: cmp };
    FFILT_N += 1;
}

/// Fake mode: another user joins `lobby` as Steam would show it: false (and nothing happens) when the lobby is missing,
/// closed (`setJoinable`) or full. Fires the members callback (`ENTERED`) on success.
/// For tests; no-op outside fake mode.
pub fn fakeLobbyJoin(lobby: u64, user: u64): bool {
    if !fake() || user == u64(0) {
        return false;
    }
    fakeLog(`lobby {lobby}: {user} joins`);
    return flJoin(lobby, user, true) == ENTER_SUCCESS && flIsMember(lobby, user);
}

/// Fake mode: `user` leaves `lobby` (the members callback gets `LEFT`); the owner's seat moves to the oldest member and
/// an empty lobby disappears. False when `user` is not in it. For tests; no-op outside fake mode.
pub fn fakeLobbyLeave(lobby: u64, user: u64): bool {
    if !fake() {
        return false;
    }
    fakeLog(`lobby {lobby}: {user} leaves`);
    return flLeave(lobby, user, LOBBY_LEFT);
}

/// Fake mode: `user` sends a chat message to `lobby` (everyone gets the chat callback). False when `user` is not a member
/// or `data` is over 4096 bytes. For tests; no-op outside fake mode.
pub fn fakeLobbyMsg(lobby: u64, user: u64, data: []u8): bool {
    if !fake() || data.len > CHAT_MAX || !flIsMember(lobby, user) {
        return false;
    }
    flMsgAdd(lobby, user, data);
    return true;
}
