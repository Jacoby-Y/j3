// Part of j3.steam: listing cloud files and the cloud quota; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// A file in the cloud: its name (valid until the next frame) and size in bytes.
pub struct CloudFile {
    name: string;
    size: i32;
}

/// Cloud space in bytes.
pub struct CloudQuota {
    total: u64;
    available: u64;
}

/// How many files this game has in the cloud. 0 when Steam is absent.
pub fn cloudCount(): i32 {
    if fake() {
        return i32(FC_N);
    }
    let f = method("SteamRemoteStorage", "SteamAPI_ISteamRemoteStorage_GetFileCount") as fn(ptr): i32;
    return f(rs());
}

/// Cloud file number `i` (0 to `cloudCount() - 1`). An empty name and size 0 when out of range or Steam is absent.
/// The name is valid until the next frame.
pub fn cloudAt(i: i32): CloudFile {
    if fake() {
        if int(i) < 0 || int(i) >= FC_N {
            return CloudFile { name: "", size: i32(0) };
        }
        return CloudFile { name: FC[int(i)].name, size: i32(FC[int(i)].data.len) };
    }
    let out = outCell();
    let f = method("SteamRemoteStorage", "SteamAPI_ISteamRemoteStorage_GetFileNameAndSize") as fn(ptr, i32, ptr): ptr;
    let p = f(rs(), i, out);
    if p as int == 0 {
        return CloudFile { name: "", size: i32(0) };
    }
    return CloudFile { name: fromC(p), size: rdI32(out, 0) };
}

/// Cloud space in bytes. Both 0 when Steam is absent; fake mode has 1 GiB with the stored bytes taken off.
pub fn cloudQuota(): CloudQuota {
    if fake() {
        let used = 0;
        for i in 0..FC_N {
            used += FC[i].data.len;
        }
        return CloudQuota { total: u64(FC_QUOTA), available: u64(FC_QUOTA - used) };
    }
    let out = outCell();
    let f = method("SteamRemoteStorage", "SteamAPI_ISteamRemoteStorage_GetQuota") as fn(ptr, ptr, ptr): bool;
    if !f(rs(), out, (out as int + 8) as ptr) {
        return CloudQuota { total: u64(0), available: u64(0) };
    }
    return CloudQuota { total: rdU64(out, 0), available: rdU64(out, 8) };
}
