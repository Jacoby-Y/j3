// Part of j3.steam: which Steamworks struct carries which callback id; the module doc and `use`s are in ../steam.j3.
module j3.steam;

#[singleton]
let CBT_NAMES: []string;
#[singleton]
let CBT_IDS: []i32;
#[singleton]
let CBT_N: int = 0;

fn addCallback(name: string, id: i32) {
    if CBT_N >= CBT_NAMES.len {
        let names = arena().alloc::<string>(CBT_NAMES.len * 2 + 32);
        let ids = arena().alloc::<i32>(CBT_NAMES.len * 2 + 32);
        for i in 0..CBT_N {
            names[i] = CBT_NAMES[i];
            ids[i] = CBT_IDS[i];
        }
        CBT_NAMES = names;
        CBT_IDS = ids;
    }
    CBT_NAMES[CBT_N] = name;
    CBT_IDS[CBT_N] = id;
    CBT_N += 1;
}

/// The `k_iCallback` number of the Steamworks struct `name` (`"UserStatsStored_t"`), or 0 when
/// `j3.steam` does not use that struct. Every `CB_*` id in the parts is a row here, and the binding
/// checker (`j3c -e steam-check`) compares each row with `Struct::k_iCallback` in the SDK headers.
pub fn callbackId(name: string): i32 {
    if CBT_N == 0 {
        addCallback("GameOverlayActivated_t", 331);
        addCallback("GameLobbyJoinRequested_t", 333);
        addCallback("AvatarImageLoaded_t", 334);
        addCallback("GameRichPresenceJoinRequested_t", 337);
        addCallback("LobbyInvite_t", 503);
        addCallback("LobbyEnter_t", 504);
        addCallback("LobbyDataUpdate_t", 505);
        addCallback("LobbyChatUpdate_t", 506);
        addCallback("LobbyChatMsg_t", 507);
        addCallback("LobbyGameCreated_t", 509);
        addCallback("LobbyMatchList_t", 510);
        addCallback("LobbyKicked_t", 512);
        addCallback("LobbyCreated_t", 513);
        addCallback("SteamAPICallCompleted_t", 703);
        addCallback("GamepadTextInputDismissed_t", 714);
        addCallback("FloatingGamepadTextInputDismissed_t", 738);
        addCallback("DlcInstalled_t", 1005);
        addCallback("NewUrlLaunchParameters_t", 1014);
        addCallback("UserStatsStored_t", 1102);
        addCallback("LeaderboardFindResult_t", 1104);
        addCallback("LeaderboardScoresDownloaded_t", 1105);
        addCallback("LeaderboardScoreUploaded_t", 1106);
        addCallback("GlobalAchievementPercentagesReady_t", 1110);
        addCallback("SteamNetConnectionStatusChangedCallback_t", 1221);
        addCallback("SteamNetAuthenticationStatus_t", 1222);
        addCallback("SteamNetworkingMessagesSessionRequest_t", 1251);
        addCallback("SteamNetworkingMessagesSessionFailed_t", 1252);
        addCallback("SteamRelayNetworkStatus_t", 1281);
        addCallback("RemoteStorageFileWriteAsyncComplete_t", 1331);
        addCallback("RemoteStorageFileReadAsyncComplete_t", 1332);
        addCallback("ScreenshotReady_t", 2301);
        addCallback("ScreenshotRequested_t", 2302);
        addCallback("SteamInputDeviceConnected_t", 2801);
        addCallback("SteamInputDeviceDisconnected_t", 2802);
        addCallback("SteamInputConfigurationLoaded_t", 2803);
        addCallback("SteamInputGamepadSlotChange_t", 2804);
    }
    for i in 0..CBT_N {
        if same(CBT_NAMES[i], name) {
            return CBT_IDS[i];
        }
    }
    return 0;
}
