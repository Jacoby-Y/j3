// Part of j3.steam: ISteamNetworkingUtils, Steam Datagram Relay status and the local clock. The module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Relay availability: a permanent failure, not retried.
pub const RELAY_CANNOT_TRY: i32 = -102;
/// Relay availability: failed.
pub const RELAY_FAILED: i32 = -101;
/// Relay availability: worked before, lost now.
pub const RELAY_PREVIOUSLY: i32 = -100;
/// Relay availability: trying again.
pub const RELAY_RETRYING: i32 = -10;
/// Relay availability: `relayInit` was never called.
pub const RELAY_NEVER_TRIED: i32 = 1;
/// Relay availability: waiting for something else first.
pub const RELAY_WAITING: i32 = 2;
/// Relay availability: working on it.
pub const RELAY_ATTEMPTING: i32 = 3;
/// Relay availability: ready.
pub const RELAY_CURRENT: i32 = 100;
/// Relay availability: Steam is absent or does not say.
pub const RELAY_UNKNOWN: i32 = 0;

const CB_RELAY: i32 = 1281;

#[singleton]
let H_RELAY: ptr;
#[singleton]
let FAKE_RELAY: i32 = 1;
#[singleton]
let FAKE_CLOCK: int = 0;

fn nu(): ptr {
    return iface("SteamNetworkingUtils");
}

/// Run `f(avail, msg)` when relay access changes: `avail` is a `RELAY_*` value, `msg` a short text from
/// Steam (frame scratch arena). One handler: setting again replaces it.
pub fn onRelayStatus(f: fn(i32, string)) {
    H_RELAY = f as ptr;
}

fn onRelayCb(p: ptr, n: i32) {
    if H_RELAY as int != 0 {
        let f = H_RELAY as fn(i32, string);
        f(rdI32(p, no(N_RS_AVAIL)), fromFixed((p as int + no(N_RS_MSG)) as ptr, 256));
    }
}

/// Start talking to Steam's relay network. Call it early (at startup): the first connection to another
/// user is quicker when the relay is ready. Safe to call again. `relayStatus` and `onRelayStatus` report progress.
pub fn relayInit() {
    if fake() {
        fakeLog("relayInit");
        FAKE_RELAY = RELAY_CURRENT;
        let b = netCbBuf();
        wrI32(b, no(N_RS_AVAIL), RELAY_CURRENT);
        wrU8(b, no(N_RS_MSG), u8(79));
        wrU8(b, no(N_RS_MSG) + 1, u8(75));
        fakeCallback(CB_RELAY, @slice(b, no(N_RS_SIZE)));
        return;
    }
    let f = method("SteamNetworkingUtils", "SteamAPI_ISteamNetworkingUtils_InitRelayNetworkAccess") as fn(ptr);
    f(nu());
}

/// Relay availability as a `RELAY_*` value; `RELAY_UNKNOWN` when Steam is absent.
pub fn relayStatus(): i32 {
    if fake() {
        return FAKE_RELAY;
    }
    let f = method("SteamNetworkingUtils", "SteamAPI_ISteamNetworkingUtils_GetRelayNetworkStatus") as fn(ptr, ptr): i32;
    return f(nu(), 0 as ptr);
}

/// Steam's local clock in microseconds (the clock message timestamps use). In fake mode a counter that grows
/// by 1000 per call; 0 when Steam is absent.
pub fn netTimestamp(): i64 {
    if fake() {
        FAKE_CLOCK += 1000;
        return i64(FAKE_CLOCK);
    }
    let f = method("SteamNetworkingUtils", "SteamAPI_ISteamNetworkingUtils_GetLocalTimestamp") as fn(ptr): i64;
    return f(nu());
}
