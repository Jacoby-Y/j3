// Part of j3.steam: the cold-start lobby id from the launch command; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// The number after `+connect_lobby` in `s` (separated by spaces or `=`), 0 when there is none.
fn parseConnect(s: string): u64 {
    let tag = "+connect_lobby";
    let i = 0;
    while i + tag.len < s.len {
        let hit = true;
        for k in 0..tag.len {
            if s[i + k] != tag[k] {
                hit = false;
                break;
            }
        }
        if hit {
            return parseDigits(s, i + tag.len);
        }
        i += 1;
    }
    return u64(0);
}

/// The digits in `s` at `from`, after spaces and `=`; 0 when there are none or the number does not fit in a u64.
fn parseDigits(s: string, from: int): u64 {
    let i = from;
    while i < s.len && (s[i] == u8(32) || s[i] == u8(61)) {
        i += 1;
    }
    let v = u64(0);
    let max = u64(0) - u64(1);
    while i < s.len && s[i] >= u8(48) && s[i] <= u8(57) {
        let d = u64(int(s[i]) - 48);
        // v * 10 + d must fit in u64
        if v > (max - d) / u64(10) {
            return u64(0);
        }
        v = v * u64(10) + d;
        i += 1;
    }
    return v;
}

/// The lobby id the game was started to join: Steam's `+connect_lobby <id>` in `launchCommandLine()` or in the process
/// arguments (Steam passes it there on a cold start). 0 when there is none. Call `joinLobby` with it after `init`.
pub fn connectLobbyArg(): u64 {
    let id = parseConnect(launchCommandLine());
    if id != u64(0) {
        return id;
    }
    for i in 1..sys.argCount() {
        let a = sys.arg(i);
        id = parseConnect(a);
        if id != u64(0) {
            return id;
        }
        if same(a, "+connect_lobby") {
            return parseDigits(sys.arg(i + 1), 0);
        }
    }
    return u64(0);
}
