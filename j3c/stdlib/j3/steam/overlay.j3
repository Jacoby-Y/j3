// Part of j3.steam: overlay dialogs and notification placement (ISteamFriends / ISteamUtils); the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Open the overlay on `dialog`: "friends", "community", "players", "settings", "officialgamegroup", "stats" or "achievements".
/// Does nothing when Steam is absent (fake mode logs it).
pub fn overlay(dialog: string) {
    if fake() {
        fakeLog(`overlay {dialog}`);
        return;
    }
    let d = cs(dialog, 0);
    if d as int == 0 {
        return;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_ActivateGameOverlay") as fn(ptr, ptr);
    f(fr(), d);
}

/// Open the overlay on a user dialog for `id`: "steamid" (profile), "chat", "jointrade", "stats", "achievements",
/// "friendadd", "friendremove", "friendrequestaccept", "friendrequestignore".
pub fn overlayToUser(dialog: string, id: u64) {
    if fake() {
        fakeLog(`overlayToUser {dialog} {id}`);
        return;
    }
    let d = cs(dialog, 0);
    if d as int == 0 {
        return;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_ActivateGameOverlayToUser") as fn(ptr, ptr, u64);
    f(fr(), d, id);
}

/// Open `url` in the overlay browser. `modal` keeps it on top and takes input until closed.
pub fn openUrl(url: string, modal: bool) {
    if fake() {
        fakeLog(`openUrl {url} modal={modal}`);
        return;
    }
    let u = cs(url, 0);
    if u as int == 0 {
        return;
    }
    let mode: i32 = 0;
    if modal {
        mode = 1;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_ActivateGameOverlayToWebPage") as fn(ptr, ptr, i32);
    f(fr(), u, mode);
}

/// Open the store page of `appId` (0 is this game) in the overlay. `flag`: 0 just the page, 1 add to cart, 2 add to cart and show it.
pub fn openStore(appId: u32, flag: int) {
    let id = appId;
    if id == u32(0) {
        id = appId();
    }
    if fake() {
        fakeLog(`openStore {id} flag={flag}`);
        return;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_ActivateGameOverlayToStore") as fn(ptr, u32, i32);
    f(fr(), id, i32(flag));
}

/// True when the overlay can open (Steam running, overlay not disabled). False when Steam is absent or in fake mode.
pub fn overlayEnabled(): bool {
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_IsOverlayEnabled") as fn(ptr): bool;
    return f(iface("SteamUtils"));
}

/// Corner for achievement toasts: 0 top left, 1 top right, 2 bottom left, 3 bottom right.
pub fn setNotifyPosition(pos: int) {
    if fake() {
        fakeLog(`setNotifyPosition {pos}`);
        return;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_SetOverlayNotificationPosition") as fn(ptr, i32);
    f(iface("SteamUtils"), i32(pos));
}

/// Move toasts `x` pixels horizontally and `y` vertically away from their corner.
pub fn setNotifyInset(x: int, y: int) {
    if fake() {
        fakeLog(`setNotifyInset {x} {y}`);
        return;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_SetOverlayNotificationInset") as fn(ptr, i32, i32);
    f(iface("SteamUtils"), i32(x), i32(y));
}
