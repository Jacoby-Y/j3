/// Steam Input for `.j3ui`: `feedPad` hands the controller to a `Dom` (menu navigation by pad). Opt-in like `j3.steam.game`;
/// `j3.steam` and `j3.app` do not import `j3.ui`.
///
///     use j3.steam.game.PadMap;
///     use j3.steam.ui.feedPad;
///     // once: steam.init(...); steam.inputInit(true); let pads: [4]u64; steam.controllers(pads[0..4]); let h = pads[0]; map = PadMap { menuSet: ..., up: ..., a: ... };
///     // every frame, before the root's frame fn (it calls `d.beginFrame`, which reads the pad):
///     feedPad(&dom, h, map);
///
/// With no controller (`h` 0) the pad is reported unplugged and `Dom` stops any direction it was repeating.

module j3.steam.ui;

use j3.steam.game.{ padRaw, PadMap };
use j3.ui.dom.Dom;

/// Build the `j3.ui.padin` state from Steam Input controller `h` and `map` (`j3.steam.game.padRaw`) and give it to `d.setPad`. Call it once
/// per frame; it holds until the next call. It allocates nothing.
pub fn feedPad(d: &Dom, h: u64, map: PadMap) {
    d.setPad(padRaw(h, map));
}
