// Part of j3.steam: the types networking shares (identities, IP addresses, connection info) and the scratch
// buffers they are built in. Messages (netmsg.j3) and, later, sockets use these. The module doc and `use`s are in ../steam.j3.
module j3.steam;

const ID_TYPE_STEAM: i32 = 16;
/// Identity buffers handed out by `idPut`: slot 0..3, each its own 136 bytes.
const ID_SLOTS: int = 4;
const ID_BYTES: int = 136;
const NB_INFO: int = 544;
const NB_RT: int = 1240;
const NB_CB: int = 1496;
const NB_CB_SIZE: int = 1024;
const NB_SIZE: int = 2560;

// Indexes into `NOFF`, filled from the layout table once.
const N_ID_TYPE: int = 0;
const N_ID_CB: int = 1;
const N_ID_STEAM: int = 2;
const N_ID_SIZE: int = 3;
const N_M_DATA: int = 4;
const N_M_CB: int = 5;
const N_M_PEER: int = 6;
const N_M_NUM: int = 7;
const N_M_REL: int = 8;
const N_CI_ID: int = 9;
const N_CI_UDATA: int = 10;
const N_CI_LISTEN: int = 11;
const N_CI_ADDR: int = 12;
const N_CI_STATE: int = 13;
const N_CI_REASON: int = 14;
const N_CI_DBG: int = 15;
const N_CI_DESC: int = 16;
const N_CI_FLAGS: int = 17;
const N_CI_SIZE: int = 18;
const N_CI_POPR: int = 19;
const N_CI_POPY: int = 20;
const N_IP_PORT: int = 21;
const N_IP_SIZE: int = 22;
const N_RT_PING: int = 23;
const N_RQ_ID: int = 24;
const N_FL_INFO: int = 25;
const N_RS_AVAIL: int = 26;
const N_RS_MSG: int = 27;
const N_RS_SIZE: int = 28;
const N_COUNT: int = 29;

#[singleton]
let NOFF: []int;
#[singleton]
let NB: ptr;
#[singleton]
let ID_MODE: int = 0;

fn no(i: int): int {
    return NOFF[i];
}

fn setN(i: int, name: string, field: string) {
    NOFF[i] = lay(name, field);
}

/// Read the networking offsets and pick how identities are filled; safe to call again. `setUp` runs it
/// once the library is (or is not) loaded: flat helpers when the library exports them, else raw fields.
fn netIdInit() {
    if NOFF.len > 0 {
        return;
    }
    NOFF = arena().alloc::<int>(N_COUNT);
    NB = arena().allocBytes(NB_SIZE);
    setN(N_ID_TYPE, "SteamNetworkingIdentity", "eType");
    setN(N_ID_CB, "SteamNetworkingIdentity", "cbSize");
    setN(N_ID_STEAM, "SteamNetworkingIdentity", "steamID64");
    setN(N_ID_SIZE, "SteamNetworkingIdentity", SIZE);
    setN(N_M_DATA, "SteamNetworkingMessage_t", "pData");
    setN(N_M_CB, "SteamNetworkingMessage_t", "cbSize");
    setN(N_M_PEER, "SteamNetworkingMessage_t", "identityPeer");
    setN(N_M_NUM, "SteamNetworkingMessage_t", "nMessageNumber");
    setN(N_M_REL, "SteamNetworkingMessage_t", "release");
    setN(N_CI_ID, "SteamNetConnectionInfo_t", "identityRemote");
    setN(N_CI_UDATA, "SteamNetConnectionInfo_t", "userData");
    setN(N_CI_LISTEN, "SteamNetConnectionInfo_t", "listenSocket");
    setN(N_CI_ADDR, "SteamNetConnectionInfo_t", "addrRemote");
    setN(N_CI_STATE, "SteamNetConnectionInfo_t", "eState");
    setN(N_CI_REASON, "SteamNetConnectionInfo_t", "eEndReason");
    setN(N_CI_DBG, "SteamNetConnectionInfo_t", "szEndDebug");
    setN(N_CI_DESC, "SteamNetConnectionInfo_t", "szConnectionDescription");
    setN(N_CI_FLAGS, "SteamNetConnectionInfo_t", "nFlags");
    setN(N_CI_SIZE, "SteamNetConnectionInfo_t", SIZE);
    setN(N_CI_POPR, "SteamNetConnectionInfo_t", "idPOPRemote");
    setN(N_CI_POPY, "SteamNetConnectionInfo_t", "idPOPRelay");
    setN(N_IP_PORT, "SteamNetworkingIPAddr", "port");
    setN(N_IP_SIZE, "SteamNetworkingIPAddr", SIZE);
    setN(N_RT_PING, "SteamNetConnectionRealTimeStatus_t", "nPing");
    setN(N_RQ_ID, "SteamNetworkingMessagesSessionRequest_t", "identityRemote");
    setN(N_FL_INFO, "SteamNetworkingMessagesSessionFailed_t", "info");
    setN(N_RS_AVAIL, "SteamRelayNetworkStatus_t", "eAvail");
    setN(N_RS_MSG, "SteamRelayNetworkStatus_t", "debugMsg");
    setN(N_RS_SIZE, "SteamRelayNetworkStatus_t", SIZE);
    ID_MODE = 2;
    if hasFn("SteamAPI_SteamNetworkingIdentity_SetSteamID64") && hasFn("SteamAPI_SteamNetworkingIdentity_GetSteamID64") {
        ID_MODE = 1;
    }
}

fn zeroBytes(p: ptr, n: int) {
    for i in 0..n / 8 {
        wrU64(p, i * 8, u64(0));
    }
}

/// Identity scratch buffer `slot` (0 to 3) holding Steam user `user`, 136 bytes, ready to pass as a
/// `SteamNetworkingIdentity*`. Give each identity in one call its own slot: a call that takes two
/// identities (a socket connect, say) uses two slots. Good until the next `idPut` of the same slot.
fn idPut(slot: int, user: u64): ptr {
    netIdInit();
    let p = (NB as int + slot * ID_BYTES) as ptr;
    zeroBytes(p, ID_BYTES);
    if ID_MODE == 1 {
        let set = fnp("SteamAPI_SteamNetworkingIdentity_SetSteamID64") as fn(ptr, u64);
        set(p, user);
    } else {
        wrI32(p, no(N_ID_TYPE), ID_TYPE_STEAM);
        wrI32(p, no(N_ID_CB), i32(8));
        wrU64(p, no(N_ID_STEAM), user);
    }
    return p;
}

/// The SteamID64 inside the identity at `p`; 0 when it is not a Steam identity.
fn idGet(p: ptr): u64 {
    netIdInit();
    if ID_MODE == 1 {
        let get = fnp("SteamAPI_SteamNetworkingIdentity_GetSteamID64") as fn(ptr): u64;
        return get(p);
    }
    if rdI32(p, no(N_ID_TYPE)) != ID_TYPE_STEAM {
        return u64(0);
    }
    return rdU64(p, no(N_ID_STEAM));
}

/// A peer address (`SteamNetworkingIPAddr`).
pub struct NetAddr {
    /// False for an all-zero address (a P2P connection has none).
    set: bool;
    /// True when `ip` holds an IPv4 address (stored as an IPv4-mapped IPv6 address).
    v4: bool;
    /// The IPv4 address as a host-order number (`a.b.c.d` = a*2^24 + b*2^16 + c*2^8 + d); 0 for IPv6.
    ip: u32;
    /// Port, host order.
    port: i32;
}

/// Decode the 18-byte `SteamNetworkingIPAddr` at `p`.
pub fn decodeAddr(p: ptr): NetAddr {
    netIdInit();
    let any = false;
    for i in 0..16 {
        if rdU8(p, i) != u8(0) {
            any = true;
        }
    }
    let po = no(N_IP_PORT);
    let port = i32(int(rdU8(p, po)) + int(rdU8(p, po + 1)) * 256);
    let mapped = true;
    for i in 0..10 {
        if rdU8(p, i) != u8(0) {
            mapped = false;
        }
    }
    if rdU8(p, 10) != u8(255) || rdU8(p, 11) != u8(255) {
        mapped = false;
    }
    let ip = u32(0);
    if mapped {
        ip = u32(int(rdU8(p, 12)) * 16777216 + int(rdU8(p, 13)) * 65536 + int(rdU8(p, 14)) * 256 + int(rdU8(p, 15)));
    }
    return NetAddr { set: any || port != i32(0), v4: mapped && any, ip: ip, port: port };
}

/// Write an IPv4 address and port into the 18-byte `SteamNetworkingIPAddr` at `p`.
fn writeAddr(p: ptr, ip: u32, port: int) {
    netIdInit();
    zeroBytes(p, 16);
    wrU8(p, 16, u8(0));
    wrU8(p, 17, u8(0));
    wrU8(p, 10, u8(255));
    wrU8(p, 11, u8(255));
    let x = int(ip);
    wrU8(p, 12, u8(x / 16777216 % 256));
    wrU8(p, 13, u8(x / 65536 % 256));
    wrU8(p, 14, u8(x / 256 % 256));
    wrU8(p, 15, u8(x % 256));
    let po = no(N_IP_PORT);
    wrU8(p, po, u8(port % 256));
    wrU8(p, po + 1, u8(port / 256 % 256));
}

/// What a `SteamNetConnectionInfo_t` says. The strings are copies on the frame scratch arena (valid until the next frame).
pub struct ConnInfo {
    /// SteamID64 of the other side; 0 for a non-Steam identity.
    peer: u64;
    /// The connection's user data.
    userData: i64;
    /// Listen socket handle it came in on; 0 for an outgoing connection.
    listenSocket: u32;
    /// `NET_STATE_*`.
    state: i32;
    /// Why it ended (`k_ESteamNetConnectionEnd_*`); 0 while it is alive.
    endReason: i32;
    /// Text from the side that ended it.
    endDebug: string;
    /// Steam's description of the connection.
    description: string;
    /// `nFlags` of the connection.
    flags: i32;
    /// Remote IP address; `set` is false for P2P.
    addr: NetAddr;
    /// Steam datacenter id of the remote side's relay, or 0.
    popRemote: u32;
    /// Steam datacenter id of the relay in use, or 0.
    popRelay: u32;
}

/// Decode the `SteamNetConnectionInfo_t` at `p`.
pub fn decodeConn(p: ptr): ConnInfo {
    netIdInit();
    return ConnInfo {
        peer: idGet((p as int + no(N_CI_ID)) as ptr),
        userData: i64(rdU64(p, no(N_CI_UDATA))),
        listenSocket: rdU32(p, no(N_CI_LISTEN)),
        state: rdI32(p, no(N_CI_STATE)),
        endReason: rdI32(p, no(N_CI_REASON)),
        endDebug: fromFixed((p as int + no(N_CI_DBG)) as ptr, 128),
        description: fromFixed((p as int + no(N_CI_DESC)) as ptr, 128),
        flags: rdI32(p, no(N_CI_FLAGS)),
        addr: decodeAddr((p as int + no(N_CI_ADDR)) as ptr),
        popRemote: rdU32(p, no(N_CI_POPR)),
        popRelay: rdU32(p, no(N_CI_POPY))
    };
}

/// Fill the `SteamNetConnectionInfo_t` at `p` (zeroed first) for fake mode: `peer`, `state`, `reason`, `debug` (cut at 127 bytes).
fn writeConn(p: ptr, peer: u64, state: i32, reason: i32, debug: string) {
    netIdInit();
    zeroBytes(p, no(N_CI_SIZE));
    let id = idPut(3, peer);
    for i in 0..ID_BYTES {
        wrU8(p, no(N_CI_ID) + i, rdU8(id, i));
    }
    wrI32(p, no(N_CI_STATE), state);
    wrI32(p, no(N_CI_REASON), reason);
    let n = debug.len;
    if n > 127 {
        n = 127;
    }
    for i in 0..n {
        wrU8(p, no(N_CI_DBG) + i, debug[i]);
    }
}

/// Zeroed 1 KB block to build a fake callback struct in (`fakeCallback` copies it).
fn netCbBuf(): ptr {
    netIdInit();
    let p = (NB as int + NB_CB) as ptr;
    zeroBytes(p, NB_CB_SIZE);
    return p;
}
