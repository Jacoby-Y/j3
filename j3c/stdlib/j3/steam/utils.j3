// Part of j3.steam: ISteamUtils (app id, device state), on-screen keyboards, and language; the module doc and `use`s are in ../steam.j3.
module j3.steam;

const CB_FLOAT_KEYS_CLOSED: i32 = 738;
const CB_GAMEPAD_TEXT: i32 = 714;
const LAUNCH_MAX: int = 1024;

#[singleton]
let FAKE_APP: u32;
#[singleton]
let FAKE_DECK: bool;
#[singleton]
let FAKE_KB_SHOWN: int;
#[singleton]
let FAKE_KB_HIDDEN: int;
#[singleton]
let H_KEYS_CLOSED: ptr;
#[singleton]
let H_GP_TEXT: ptr;
#[singleton]
let OFF_GP_SUBMITTED: int = 0;
#[singleton]
let OFF_GP_LEN: int = 0;
#[singleton]
let GP_BUF: ptr;
#[singleton]
let GP_CAP: int = 0;
#[singleton]
let FAKE_GP: string = "";
#[singleton]
let LAUNCH_BUF: ptr;

fn ut(): ptr {
    return iface("SteamUtils");
}

fn ap(): ptr {
    return iface("SteamApps");
}

// ---- utils ----

/// This game's app id. 0 when Steam is absent; fake mode returns the id given to `initFake`.
pub fn appId(): u32 {
    if fake() {
        return FAKE_APP;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetAppID") as fn(ptr): u32;
    return f(ut());
}

/// True on a Steam Deck. False when Steam is absent; in fake mode what `fakeDeck` set (false at first).
pub fn onDeck(): bool {
    if fake() {
        return FAKE_DECK;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_IsRunningOnSteamHardware") as fn(ptr): i32;
    return f(ut()) == 1; // k_ESteamHardwareTypeSteamDeck
}

/// True when Steam runs in Big Picture (or Deck gaming) mode. False when Steam is absent or in fake mode.
pub fn bigPicture(): bool {
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_IsSteamInBigPictureMode") as fn(ptr): bool;
    return f(ut());
}

/// Two-letter country code of the user's IP ("US"). "" when Steam is absent; fake mode says "US". Valid until the next frame.
pub fn country(): string {
    if fake() {
        return "US";
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetIPCountry") as fn(ptr): ptr;
    return fromC(f(ut()));
}

/// Seconds since the user last used the computer's input (idle time). 0 when Steam is absent or in fake mode.
pub fn secondsSinceActive(): u32 {
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetSecondsSinceComputerActive") as fn(ptr): u32;
    return f(ut());
}

/// Battery charge in percent, or 255 on AC power (or when Steam is absent).
pub fn battery(): u8 {
    if !ready() {
        return u8(255);
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetCurrentBatteryPower") as fn(ptr): u8;
    return f(ut());
}

// ---- keyboards ----

/// Dev only, fake mode: make `onDeck` answer `on`, so the keyboard hooks of `j3.steam.game.attach` can be tried on a desktop.
pub fn fakeDeck(on: bool) {
    FAKE_DECK = on;
}

/// Dev only, fake mode: how many times `textInput` showed the keyboard and `dismissTextInput` hid it.
pub fn fakeKeyboardCalls(): int {
    return FAKE_KB_SHOWN;
}

/// Dev only, fake mode: how many times `dismissTextInput` was called.
pub fn fakeKeyboardHides(): int {
    return FAKE_KB_HIDDEN;
}

/// Show the Steam on-screen keyboard (Deck, Big Picture) over the text box at `x`, `y`, `w`, `h` (window pixels),
/// so it does not cover it. `mode`: 0 single line, 1 multi line, 2 email, 3 numeric. Typed text arrives as normal
/// key input. True when Steam showed it; false when Steam is absent. `onTextInputClosed` fires when it goes away.
pub fn textInput(mode: int, x: int, y: int, w: int, h: int): bool {
    if fake() {
        FAKE_KB_SHOWN += 1;
        fakeLog(`textInput mode={mode} {x},{y} {w}x{h}`);
        fakeCallback(CB_FLOAT_KEYS_CLOSED, @slice(fbuf(), 1));
        return true;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_ShowFloatingGamepadTextInput") as fn(ptr, i32, i32, i32, i32, i32): bool;
    return f(ut(), i32(mode), i32(x), i32(y), i32(w), i32(h));
}

/// Hide the on-screen keyboard from `textInput`.
pub fn dismissTextInput() {
    if fake() {
        FAKE_KB_HIDDEN += 1;
        fakeLog("dismissTextInput");
        return;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_DismissFloatingGamepadTextInput") as fn(ptr);
    f(ut());
}

/// Run `f()` when the keyboard from `textInput` closes (`FloatingGamepadTextInputDismissed_t`). One handler:
/// setting again replaces it.
pub fn onTextInputClosed(f: fn()) {
    H_KEYS_CLOSED = f as ptr;
}

/// Show the full-screen Big Picture text box. `mode`: 0 normal, 1 password; `lineMode`: 0 single line, 1 multi line;
/// `desc` is the title, `maxChars` the length limit, `existing` the starting text. The result arrives in
/// `onGamepadText`. False when Steam is absent or a text is over 1023 bytes. Fake mode submits `existing` next frame.
pub fn gamepadTextInput(mode: int, lineMode: int, desc: string, maxChars: u32, existing: string): bool {
    if fake() {
        fakeLog(`gamepadTextInput {desc}`);
        FAKE_GP = keep(existing);
        let p = fbuf();
        wrBool(p, OFF_GP_SUBMITTED, true);
        wrU32(p, OFF_GP_LEN, u32(existing.len));
        fakeCallback(CB_GAMEPAD_TEXT, @slice(p, lay("GamepadTextInputDismissed_t", SIZE)));
        return true;
    }
    let d = cs(desc, 0);
    let e = cs(existing, 1);
    if d as int == 0 || e as int == 0 {
        return false;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_ShowGamepadTextInput") as fn(ptr, i32, i32, ptr, u32, ptr): bool;
    return f(ut(), i32(mode), i32(lineMode), d, maxChars, e);
}

/// Run `f(submitted, text)` when `gamepadTextInput` closes: `submitted` is false when cancelled (then `text` is "").
/// `text` is valid until the next frame. One handler: setting again replaces it.
pub fn onGamepadText(f: fn(bool, string)) {
    H_GP_TEXT = f as ptr;
}

fn onKeysClosedCb(p: ptr, n: i32) {
    if H_KEYS_CLOSED as int != 0 {
        let f = H_KEYS_CLOSED as fn();
        f();
    }
}

/// The text the user entered, `len` bytes, read into a buffer that is reused (grown when needed).
fn enteredText(len: int): string {
    if fake() {
        return FAKE_GP;
    }
    if len + 1 > GP_CAP {
        GP_CAP = (len + 1) * 2;
        GP_BUF = arena().allocBytes(GP_CAP);
    }
    wrU8(GP_BUF, 0, u8(0));
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetEnteredGamepadTextInput") as fn(ptr, ptr, u32): bool;
    if !f(ut(), GP_BUF, u32(len + 1)) {
        return "";
    }
    return fromFixed(GP_BUF, len);
}

fn onGamepadTextCb(p: ptr, n: i32) {
    if H_GP_TEXT as int != 0 {
        let f = H_GP_TEXT as fn(bool, string);
        let sent = rdBool(p, OFF_GP_SUBMITTED);
        if sent {
            f(true, enteredText(int(rdU32(p, OFF_GP_LEN))));
        } else {
            f(false, "");
        }
    }
}

// ---- language ----

/// Steam API language code, then BCP-47 tag (the style `j3.i18n` locales use), as one flat table.
const LANGS: [60]string = [
    "english", "en", "french", "fr", "german", "de", "spanish", "es", "latam", "es-419",
    "italian", "it", "japanese", "ja", "koreana", "ko", "schinese", "zh-Hans", "tchinese", "zh-Hant",
    "russian", "ru", "brazilian", "pt-BR", "portuguese", "pt", "polish", "pl", "turkish", "tr",
    "ukrainian", "uk", "dutch", "nl", "swedish", "sv", "danish", "da", "finnish", "fi",
    "norwegian", "no", "czech", "cs", "hungarian", "hu", "romanian", "ro", "thai", "th",
    "vietnamese", "vi", "greek", "el", "bulgarian", "bg", "arabic", "ar", "indonesian", "id"
];

/// Steam's name for the game's current language ("english", "schinese", ...). "" when Steam is absent; fake mode
/// says "english". Valid until the next frame.
pub fn lang(): string {
    if fake() {
        return "english";
    }
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetCurrentGameLanguage") as fn(ptr): ptr;
    return fromC(f(ap()));
}

/// BCP-47 tag for a Steam language code ("schinese" gives "zh-Hans"), or "en" for a code the table lacks.
pub fn localeOf(code: string): string {
    for i in 0..30 {
        if same(LANGS[i * 2], code) {
            return LANGS[i * 2 + 1];
        }
    }
    return "en";
}

/// The game's Steam language as a `j3.i18n` locale tag: `i18n.setLocale(steam.locale())`. "en" when Steam is absent
/// or the language is not in the table (`lang()` still has the raw code).
pub fn locale(): string {
    return localeOf(lang());
}

/// The command line Steam started the game with (a join invite's "connect" string arrives here on a cold start).
/// "" when Steam is absent or there is none. Valid until the next frame.
pub fn launchCommandLine(): string {
    if fake() {
        return "";
    }
    if !ready() {
        return "";
    }
    if LAUNCH_BUF as int == 0 {
        LAUNCH_BUF = arena().allocBytes(LAUNCH_MAX);
    }
    wrU8(LAUNCH_BUF, 0, u8(0));
    let f = method("SteamApps", "SteamAPI_ISteamApps_GetLaunchCommandLine") as fn(ptr, ptr, i32): i32;
    let n = int(f(ap(), LAUNCH_BUF, i32(LAUNCH_MAX)));
    if n <= 0 {
        return "";
    }
    return fromFixed(LAUNCH_BUF, LAUNCH_MAX - 1);
}

fn utilsInit() {
    OFF_GP_SUBMITTED = lay("GamepadTextInputDismissed_t", "bSubmitted");
    OFF_GP_LEN = lay("GamepadTextInputDismissed_t", "unSubmittedText");
    onCallback(CB_FLOAT_KEYS_CLOSED, onKeysClosedCb);
    onCallback(CB_GAMEPAD_TEXT, onGamepadTextCb);
}
