// Part of j3.steam: ISteamInput constants, result types, name caches and the by-value struct returns; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// `InputHandle_t` that means every connected controller (`activateSet(INPUT_ALL_CONTROLLERS, set)`).
pub const INPUT_ALL_CONTROLLERS: u64 = 0 - 1;
/// Most controllers Steam reports at once (`STEAM_INPUT_MAX_COUNT`): the capacity `controllers` needs.
pub const INPUT_MAX_COUNT: int = 16;
/// Most origins one action has (`STEAM_INPUT_MAX_ORIGINS`): the capacity `digitalOrigins` and `analogOrigins` need.
pub const INPUT_MAX_ORIGINS: int = 8;
/// Most action set layers active on one controller (`STEAM_INPUT_MAX_ACTIVE_LAYERS`): the capacity `activeLayers` needs.
pub const INPUT_MAX_LAYERS: int = 16;

/// `ESteamInputType` values `inputType` returns.
pub const INPUT_UNKNOWN: int = 0;
pub const INPUT_STEAM_CONTROLLER: int = 1;
pub const INPUT_XBOX360: int = 2;
pub const INPUT_XBOX_ONE: int = 3;
pub const INPUT_GENERIC_GAMEPAD: int = 4;
pub const INPUT_PS4: int = 5;
pub const INPUT_APPLE_MFI: int = 6;
pub const INPUT_ANDROID: int = 7;
pub const INPUT_SWITCH_JOYCON_PAIR: int = 8;
pub const INPUT_SWITCH_JOYCON_SINGLE: int = 9;
pub const INPUT_SWITCH_PRO: int = 10;
pub const INPUT_MOBILE_TOUCH: int = 11;
pub const INPUT_PS3: int = 12;
pub const INPUT_PS5: int = 13;
pub const INPUT_STEAM_DECK: int = 14;

/// `ESteamInputGlyphSize` values for `glyphPng`: 32, 128 and 256 pixels.
pub const GLYPH_SMALL: int = 0;
pub const GLYPH_MEDIUM: int = 1;
pub const GLYPH_LARGE: int = 2;

/// `ESteamInputGlyphStyle` bits for the `flags` of `glyphPng` and `glyphSvg` (add them together; 0 is the default look).
pub const GLYPH_KNOCKOUT: u32 = 0;
pub const GLYPH_LIGHT: u32 = 1;
pub const GLYPH_DARK: u32 = 2;
pub const GLYPH_NEUTRAL_ABXY: u32 = 16;
pub const GLYPH_SOLID_ABXY: u32 = 32;

/// `flags` of `led`: set the colour, or give the LED back to the user's own setting.
pub const LED_SET: u32 = 0;
pub const LED_RESTORE_USER_DEFAULT: u32 = 1;

/// A digital action (a button): `state` is held, `active` is false when the action is not in the current action set.
pub struct Digital {
    state: bool;
    active: bool;
}

/// An analog action: `mode` is `EInputSourceMode`, `x` and `y` are -1 to 1 (a trigger uses `x` only).
pub struct Analog {
    mode: i32;
    x: f32;
    y: f32;
    active: bool;
}

/// Gyro and accelerometer: orientation quaternion, acceleration and angular velocity.
pub struct Motion {
    qx: f32;
    qy: f32;
    qz: f32;
    qw: f32;
    ax: f32;
    ay: f32;
    az: f32;
    vx: f32;
    vy: f32;
    vz: f32;
}

const MOTION_FIELDS: int = 10;

/// Two eightbytes: how a struct of 9 to 16 bytes comes back in RAX:RDX (System V x86-64, and AAPCS64 in x0:x1).
struct Pair {
    lo: u64;
    hi: u64;
}

/// One name and the handle Steam gave it.
struct NameRow {
    name: string;
    h: u64;
}

/// Handles by name, so a game can ask per frame without a call into Steam or an allocation (only a new name copies).
struct NameCache {
    rows: []NameRow;
    n: int;
}

#[singleton]
let C_SET: NameCache;
#[singleton]
let C_DIGITAL: NameCache;
#[singleton]
let C_ANALOG: NameCache;
#[singleton]
let IN_CELL: ptr;
#[singleton]
let OFF_DIG_STATE: int = 0;
#[singleton]
let OFF_DIG_ACTIVE: int = 0;
#[singleton]
let OFF_AN_MODE: int = 0;
#[singleton]
let OFF_AN_X: int = 0;
#[singleton]
let OFF_AN_Y: int = 0;
#[singleton]
let OFF_AN_ACTIVE: int = 0;
#[singleton]
let OFF_MO: []int;

fn ncSlot(rows: []NameRow, name: string): int {
    let i = hash(name) % rows.len;
    while rows[i].name.len > 0 && !same(rows[i].name, name) {
        i = (i + 1) % rows.len;
    }
    return i;
}

/// The handle cached for `name`, or 0.
fn ncGet(c: &NameCache, name: string): u64 {
    if c.n == 0 {
        return u64(0);
    }
    let at = ncSlot(c.rows, name);
    if c.rows[at].name.len == 0 {
        return u64(0);
    }
    return c.rows[at].h;
}

/// Remember `name` -> `h` (a nonzero handle, a name not cached yet); the name is copied.
fn ncPut(c: &NameCache, name: string, h: u64) {
    if (c.n + 1) * 2 > c.rows.len {
        let old = c.rows;
        let cap = 32;
        if old.len > 0 {
            cap = old.len * 2;
        }
        let fresh = arena().alloc::<NameRow>(cap);
        for i in 0..cap {
            fresh[i] = NameRow { name: "", h: u64(0) };
        }
        for i in 0..old.len {
            if old[i].name.len > 0 {
                fresh[ncSlot(fresh, old[i].name)] = old[i];
            }
        }
        c.rows = fresh;
    }
    let t = Text.new(arena());
    t.pushStr(name);
    c.rows[ncSlot(c.rows, name)] = NameRow { name: t.str(), h: h };
    c.n += 1;
}

/// Forget every name (handles do not survive a Steam Input restart). The table memory stays.
fn ncClear(c: &NameCache) {
    for i in 0..c.rows.len {
        c.rows[i] = NameRow { name: "", h: u64(0) };
    }
    c.n = 0;
}

fn inputAbiInit() {
    OFF_DIG_STATE = lay("InputDigitalActionData_t", "bState");
    OFF_DIG_ACTIVE = lay("InputDigitalActionData_t", "bActive");
    OFF_AN_MODE = lay("InputAnalogActionData_t", "eMode");
    OFF_AN_X = lay("InputAnalogActionData_t", "x");
    OFF_AN_Y = lay("InputAnalogActionData_t", "y");
    OFF_AN_ACTIVE = lay("InputAnalogActionData_t", "bActive");
    OFF_MO = arena().alloc::<int>(MOTION_FIELDS);
    OFF_MO[0] = lay("InputMotionData_t", "rotQuatX");
    OFF_MO[1] = lay("InputMotionData_t", "rotQuatY");
    OFF_MO[2] = lay("InputMotionData_t", "rotQuatZ");
    OFF_MO[3] = lay("InputMotionData_t", "rotQuatW");
    OFF_MO[4] = lay("InputMotionData_t", "posAccelX");
    OFF_MO[5] = lay("InputMotionData_t", "posAccelY");
    OFF_MO[6] = lay("InputMotionData_t", "posAccelZ");
    OFF_MO[7] = lay("InputMotionData_t", "rotVelX");
    OFF_MO[8] = lay("InputMotionData_t", "rotVelY");
    OFF_MO[9] = lay("InputMotionData_t", "rotVelZ");
    IN_CELL = arena().allocBytes(lay("InputMotionData_t", SIZE) + 24);
}

/// The ISteamInput object, 0 unless Steam is live.
fn si(): ptr {
    return iface("SteamInput");
}

// By-value struct returns. A C struct returned by value follows the platform ABI, and a `fn` cast cannot say "struct":
//   Digital (2 bytes): in RAX on System V and Win64 alike. Declared as returning u64; only the low 16 bits mean anything.
//   Analog (13 bytes, pack 1): System V returns it in RAX:RDX (both eightbytes INTEGER class), declared as returning `Pair`;
//     Win64 returns any size but 1, 2, 4 or 8 through a hidden first pointer argument, so `self` moves to the second place.
//   Motion (40 bytes): hidden pointer to the result as the first argument on both ABIs (RDI on System V, RCX on Win64).
// Digital and Analog are correct on x86-64 and aarch64 (AAPCS64 returns a 16 byte struct in x0:x1 like `Pair`, and a 2 byte one in x0).
// Only Motion is gated: AAPCS64 passes the hidden result pointer in x8, which a `fn` cast cannot do, so on any CPU but
// x86-64 `motion` logs once and returns zeros. Proven against clang and mingw built stubs (chunk 5 report).

/// The three raw calls: each fills `IN_CELL` the way the ABI above says and decodes it with the layout rows. Callers check `ready()` first.
fn digitalRaw(h: u64, action: u64): Digital {
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetDigitalActionData") as fn(ptr, u64, u64): u64;
    let v = f(si(), h, action);
    wrU64(IN_CELL, 0, v);
    return Digital { state: rdBool(IN_CELL, OFF_DIG_STATE), active: rdBool(IN_CELL, OFF_DIG_ACTIVE) };
}

fn analogRaw(h: u64, action: u64): Analog {
    if sys.PLATFORM == sys.PLATFORM_WINDOWS {
        let w = method("SteamInput", "SteamAPI_ISteamInput_GetAnalogActionData") as fn(ptr, ptr, u64, u64): ptr;
        w(IN_CELL, si(), h, action);
    } else {
        let f = method("SteamInput", "SteamAPI_ISteamInput_GetAnalogActionData") as fn(ptr, u64, u64): Pair;
        let r = f(si(), h, action);
        wrU64(IN_CELL, 0, r.lo);
        wrU64(IN_CELL, 8, r.hi);
    }
    return Analog {
        mode: rdI32(IN_CELL, OFF_AN_MODE),
        x: rdF32(IN_CELL, OFF_AN_X),
        y: rdF32(IN_CELL, OFF_AN_Y),
        active: rdBool(IN_CELL, OFF_AN_ACTIVE),
    };
}

fn motionRaw(h: u64): Motion {
    if sys.ARCH != sys.ARCH_X86_64 {
        eprintOnce(`steam: motion data is not supported on {sys.ARCH_NAME}; motion returns zeros`);
        return Motion { qx: 0.0, qy: 0.0, qz: 0.0, qw: 0.0, ax: 0.0, ay: 0.0, az: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
    }
    let f = method("SteamInput", "SteamAPI_ISteamInput_GetMotionData") as fn(ptr, ptr, u64): ptr;
    f(IN_CELL, si(), h);
    let o = OFF_MO;
    return Motion {
        qx: rdF32(IN_CELL, o[0]),
        qy: rdF32(IN_CELL, o[1]),
        qz: rdF32(IN_CELL, o[2]),
        qw: rdF32(IN_CELL, o[3]),
        ax: rdF32(IN_CELL, o[4]),
        ay: rdF32(IN_CELL, o[5]),
        az: rdF32(IN_CELL, o[6]),
        vx: rdF32(IN_CELL, o[7]),
        vy: rdF32(IN_CELL, o[8]),
        vz: rdF32(IN_CELL, o[9]),
    };
}
