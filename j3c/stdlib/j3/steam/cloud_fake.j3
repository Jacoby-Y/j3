// Part of j3.steam: the in-memory Steam Cloud used in fake mode; the module doc and `use`s are in ../steam.j3.
// Dev only: replaced data stays in the arena until the process ends.
module j3.steam;

/// First fake cloud timestamp (unix seconds); every write adds 10.
const FC_START: i64 = 1700000000;
/// Fake quota, bytes (1 GiB).
const FC_QUOTA: int = 1073741824;

struct FCloud {
    name: string;
    data: []u8;
    time: i64;
    persisted: bool;
}

#[singleton]
let FC: []FCloud;
#[singleton]
let FC_N: int = 0;
#[singleton]
let FC_CLOCK: i64 = 1700000000;
#[singleton]
let FC_APP_ON: bool = true;

fn fcFind(name: string): int {
    for i in 0..FC_N {
        if same(FC[i].name, name) {
            return i;
        }
    }
    return 0 - 1;
}

fn fcCopy(data: []u8): []u8 {
    let out = arena().alloc::<u8>(data.len);
    for i in 0..data.len {
        out[i] = data[i];
    }
    return out;
}

/// Store `data` under `name` with the next fake timestamp.
fn fcPut(name: string, data: []u8) {
    FC_CLOCK = FC_CLOCK + i64(10);
    let at = fcFind(name);
    if at >= 0 {
        FC[at].data = fcCopy(data);
        FC[at].time = FC_CLOCK;
        FC[at].persisted = true;
        return;
    }
    if FC_N >= FC.len {
        let fresh = arena().alloc::<FCloud>(FC.len * 2 + 8);
        for i in 0..FC_N {
            fresh[i] = FC[i];
        }
        FC = fresh;
    }
    let n = fcCopy(name as []u8);
    FC[FC_N] = FCloud { name: n as string, data: fcCopy(data), time: FC_CLOCK, persisted: true };
    FC_N += 1;
}

fn fcRemove(at: int) {
    FC_N -= 1;
    FC[at] = FC[FC_N];
}

/// Fake mode: set the cloud timestamp of `name` (unix seconds), so a test can make the cloud copy older or newer.
/// Does nothing for a missing file or outside fake mode.
pub fn fakeCloudTime(name: string, time: i64) {
    let at = fcFind(name);
    if fake() && at >= 0 {
        FC[at].time = time;
    }
}

fn cloudDown() {
    FC_N = 0;
    FC_CLOCK = FC_START;
    FC_APP_ON = true;
}
