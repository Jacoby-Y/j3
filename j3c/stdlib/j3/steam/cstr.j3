// Part of j3.steam: C-string helpers shared by every part; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// Longest string a call takes (names, URLs, presence values, timeline text), in bytes; longer ones are refused.
const UC_MAX: int = 1023;
const UC_SLOT: int = 1024;
const UC_SLOTS: int = 4;

#[singleton]
let UC: ptr;
#[singleton]
let FBUF: ptr;

/// `s` as a NUL-terminated C string in slot `slot` (0 to 3) of a 4 KB block; 0 when `s` is over 1023 bytes
/// (reported once). No allocation after the first call. Good until the next `cs` for the same slot, so a call
/// that needs several strings at once uses a different slot for each.
fn cs(s: string, slot: int): ptr {
    if s.len > UC_MAX {
        eprintOnce(`steam: text of {s.len} bytes is over the {UC_MAX} byte limit; call refused`);
        return 0;
    }
    if UC as int == 0 {
        UC = arena().allocBytes(UC_SLOT * UC_SLOTS);
    }
    let base = (UC as int + slot * UC_SLOT) as ptr;
    for i in 0..s.len {
        wrU8(base, i, s[i]);
    }
    wrU8(base, s.len, u8(0));
    return base;
}

/// The text of a fixed `char[max]` field at `p`: up to the first NUL, never past `max` bytes. A copy on the frame scratch arena.
fn fromFixed(p: ptr, max: int): string {
    let n = 0;
    while n < max && rdU8(p, n) != u8(0) {
        n += 1;
    }
    let t = scratchText();
    for i in 0..n {
        t.push(rdU8(p, i));
    }
    return t.str();
}

/// A copy of the C string at `p` on the frame scratch arena (valid until the next frame); "" for null.
fn fromC(p: ptr): string {
    if p as int == 0 {
        return "";
    }
    let n = 0;
    while rdU8(p, n) != u8(0) {
        n += 1;
    }
    return fromFixed(p, n);
}

/// Zeroed 64 bytes to build a fake result struct in (`fakeResult` copies it, so one buffer serves all).
fn fbuf(): ptr {
    if FBUF as int == 0 {
        FBUF = arena().allocBytes(64);
    }
    for i in 0..8 {
        wrU64(FBUF, i * 8, u64(0));
    }
    return FBUF;
}
