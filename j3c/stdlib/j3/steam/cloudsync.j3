// Part of j3.steam: cloudSync, a newest-wins sync of one local file with one cloud file; the module doc and `use`s are in ../steam.j3.
module j3.steam;

/// What `cloudSync` did.
pub enum Sync {
    /// The local file was newer (or the cloud had none): it was uploaded.
    Pushed,
    /// The cloud file was newer (or there was no local file): it replaced the local file.
    Pulled,
    /// Both sides have the same bytes, or neither exists: nothing changed.
    Same,
    /// Steam is absent or Steam Cloud is off: nothing changed.
    Off,
    /// Something went wrong (the reason went to stderr); nothing was deleted and neither side lost data.
    Failed,
}

/// Write `data` to `path` through `<path>.tmp` and a rename, so a crash leaves the old file or the new one.
fn writeAtomic(path: string, data: []u8): bool {
    let tmp = `{path}.tmp`;
    match io.writeFile(tmp, data) {
        Result.Ok(_) {}
        Result.Err(_) {
            eprint(`steam: cloudSync could not write {tmp}`);
            return false;
        }
    }
    match io.rename(tmp, path) {
        Result.Ok(_) {
            return true;
        }
        Result.Err(_) {
            eprint(`steam: cloudSync could not rename {tmp} to {path}`);
            return false;
        }
    }
}

fn sameBytes(a: []u8, b: []u8): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// Keep one file in step with the cloud for a game that does not use Auto-Cloud. The newer side wins: local
/// `mtime` against `cloudTime(name)`, both in whole seconds, so changes within the same second count as equal.
/// A file missing on one side is copied to the other. Identical bytes always give `Same`. Equal times with
/// different bytes cannot be ordered, so the local file wins (pushed, a warning logged, cloud copy kept). Before a side is
/// replaced, its bytes are kept: the old local file as `<localPath>.bak` when pulling, the old cloud bytes as
/// `<localPath>.cloud.bak` when pushing. Local writes go through `<localPath>.tmp` and a rename. Call it at
/// start (before loading the save) and after saving. Reads both files into `mem`. Returns `Off` when Steam is
/// absent or Cloud is off, `Failed` on any error (logged; nothing is deleted).
pub fn cloudSync(name: string, localPath: string, mem: &Arena): Sync {
    if !cloudOn() {
        return Sync.Off;
    }
    let hasCloud = cloudExists(name);
    let hasLocal = false;
    let lt = 0;
    match io.stat(localPath) {
        Result.Ok(e) {
            hasLocal = true;
            lt = e.mtime;
        }
        Result.Err(e) {
            if e != IoError.NotFound {
                eprint(`steam: cloudSync cannot stat {localPath}`);
                return Sync.Failed;
            }
        }
    }
    if !hasCloud && !hasLocal {
        return Sync.Same;
    }
    let local = mem.alloc::<u8>(0);
    let cloud = mem.alloc::<u8>(0);
    if hasLocal {
        match io.readFile(localPath, mem) {
            Result.Ok(b) {
                local = b;
            }
            Result.Err(_) {
                eprint(`steam: cloudSync cannot read {localPath}`);
                return Sync.Failed;
            }
        }
    }
    if hasCloud {
        cloud = cloudRead(name, mem);
        if cloud.len != int(cloudSize(name)) {
            eprint(`steam: cloudSync read {cloud.len} bytes of cloud file {name}, expected {cloudSize(name)}`);
            return Sync.Failed;
        }
    }
    if hasLocal && hasCloud {
        if sameBytes(local, cloud) {
            return Sync.Same;
        }
        if int(cloudTime(name)) == lt {
            eprint(`steam: cloudSync {name}: same time but different bytes; pushing the local file, cloud copy kept as {localPath}.cloud.bak`);
        }
    }
    let push = hasLocal && (!hasCloud || lt >= int(cloudTime(name)));
    if push {
        if hasCloud && !writeAtomic(`{localPath}.cloud.bak`, cloud) {
            return Sync.Failed;
        }
        if !cloudWrite(name, local) {
            eprint(`steam: cloudSync could not write cloud file {name}`);
            return Sync.Failed;
        }
        return Sync.Pushed;
    }
    if hasLocal && !writeAtomic(`{localPath}.bak`, local) {
        return Sync.Failed;
    }
    if !writeAtomic(localPath, cloud) {
        return Sync.Failed;
    }
    return Sync.Pulled;
}
