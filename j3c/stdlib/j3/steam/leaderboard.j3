// Part of j3.steam: ISteamUserStats leaderboards through call results; the module doc and `use`s are in ../steam.j3.
module j3.steam;

const CB_LB_FIND: i32 = 1104;
const CB_LB_SCORES: i32 = 1105;
const CB_LB_UPLOADED: i32 = 1106;

/// `ELeaderboardSortMethod`: lowest score ranks first (times).
pub const SORT_ASC: i32 = 1;
/// `ELeaderboardSortMethod`: highest score ranks first (points).
pub const SORT_DESC: i32 = 2;
/// `ELeaderboardDisplayType`: show the score as a plain number.
pub const DISPLAY_NUMERIC: i32 = 1;
/// `ELeaderboardDisplayType`: show the score as seconds (`m:ss`).
pub const DISPLAY_SECONDS: i32 = 2;
/// `ELeaderboardDisplayType`: show the score as milliseconds.
pub const DISPLAY_MS: i32 = 3;
/// `ELeaderboardUploadScoreMethod`: store the score only if it beats the old one.
pub const UPLOAD_KEEP_BEST: i32 = 1;
/// `ELeaderboardUploadScoreMethod`: store the score even if it is worse.
pub const UPLOAD_FORCE: i32 = 2;
/// `ELeaderboardDataRequest`: ranks `start` to `end`, 1-based, from the top.
pub const DOWNLOAD_GLOBAL: i32 = 0;
/// `ELeaderboardDataRequest`: `start` and `end` are offsets from the player's rank (-2 to 2 is five rows).
pub const DOWNLOAD_AROUND_USER: i32 = 1;
/// `ELeaderboardDataRequest`: the player and their friends; `start` and `end` are ignored.
pub const DOWNLOAD_FRIENDS: i32 = 2;
/// Most detail values one score carries (`k_cLeaderboardDetailsMax`).
pub const DETAILS_MAX: int = 64;

#[singleton]
let OFF_FIND_H: int = 0;
#[singleton]
let OFF_FIND_OK: int = 0;
#[singleton]
let FIND_SIZE: int = 0;
#[singleton]
let OFF_UP_OK: int = 0;
#[singleton]
let OFF_UP_H: int = 0;
#[singleton]
let OFF_UP_SCORE: int = 0;
#[singleton]
let OFF_UP_CHANGED: int = 0;
#[singleton]
let OFF_UP_NEW: int = 0;
#[singleton]
let OFF_UP_PREV: int = 0;
#[singleton]
let UP_SIZE: int = 0;
#[singleton]
let OFF_DL_H: int = 0;
#[singleton]
let OFF_DL_ENTRIES: int = 0;
#[singleton]
let OFF_DL_COUNT: int = 0;
#[singleton]
let DL_SIZE: int = 0;
#[singleton]
let OFF_E_USER: int = 0;
#[singleton]
let OFF_E_RANK: int = 0;
#[singleton]
let OFF_E_SCORE: int = 0;
#[singleton]
let OFF_E_DETAILS: int = 0;

/// What `uploadScore` reports. Valid only inside the handler.
pub struct Uploaded {
    /// The upload reached Steam and succeeded.
    ok: bool;
    /// The leaderboard.
    board: u64;
    /// The score that was sent.
    score: i32;
    /// The stored score changed (false when an older score was better and kept).
    changed: bool;
    /// The player's rank now (1 is first); 0 when unknown.
    rank: i32;
    /// The rank before this upload; 0 when the player had no score.
    prevRank: i32;
}

/// One row of a downloaded page.
pub struct Entry {
    /// SteamID of the player; 0 for a bad index.
    user: u64;
    /// Global rank, 1 is first; 0 for a bad index.
    rank: i32;
    /// The score.
    score: i32;
    /// How many detail values the entry has (read them with `entryDetails`).
    details: int;
}

/// A downloaded page of a leaderboard. The handler of `downloadScores` gets one: read it there, do
/// not keep it; after the handler returns it is empty (`count` 0).
pub struct Scores {
    /// The leaderboard handle.
    board: u64;
    /// Steam's handle for these entries; dead once the handler returns.
    handle: u64;
    /// How many entries the page holds.
    count: int;

    /// Entry `i` (0-based, in rank order) with its detail count; all zero when `i` is out of range.
    fn entry(this: &Scores, i: int): Entry {
        return readEntry(this, i, 0, 0);
    }

    /// Copy the details of entry `i` into `out`. Returns how many were written (at most `out.len`).
    fn entryDetails(this: &Scores, i: int, out: []i32): int {
        let e = readEntry(this, i, out.ptr as ptr, out.len);
        if e.details < out.len {
            return e.details;
        }
        return out.len;
    }
}

#[singleton]
let UP: Uploaded;
#[singleton]
let SC: Scores;

fn emptyEntry(): Entry {
    return Entry { user: u64(0), rank: 0, score: 0, details: 0 };
}

fn readEntry(s: &Scores, i: int, out: ptr, max: int): Entry {
    if i < 0 || i >= s.count {
        return emptyEntry();
    }
    if fake() {
        return fakeEntry(s, i, out, max);
    }
    let e = (sb() as int + SB_ENTRY) as ptr;
    let g = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetDownloadedLeaderboardEntry") as fn(ptr, u64, i32, ptr, ptr, i32): bool;
    if !g(us(), s.handle, i32(i), e, out, i32(max)) {
        return emptyEntry();
    }
    return Entry { user: rdU64(e, OFF_E_USER), rank: rdI32(e, OFF_E_RANK), score: rdI32(e, OFF_E_SCORE), details: int(rdI32(e, OFF_E_DETAILS)) };
}

// ---- find ----

fn onFound(p: ptr, n: i32, failed: bool, ctx: u64) {
    let r = reqTake(ctx);
    if !r.used {
        return;
    }
    let f = r.f as fn(u64, bool, u64);
    if failed {
        f(u64(0), false, r.ctx);
        return;
    }
    f(rdU64(p, OFF_FIND_H), rdBool(p, OFF_FIND_OK), r.ctx);
}

fn findImpl(name: string, create: bool, sort: i32, display: i32, f: fn(u64, bool, u64), ctx: u64) {
    let slot = reqNew(f as ptr, ctx);
    if fake() {
        fakeLog(`find leaderboard {name} create={create}`);
        let call = fakeCall();
        await(call, onFound, slot);
        let at = boardFind(name, create, sort, display);
        let p = fbuf();
        if at >= 0 {
            wrU64(p, OFF_FIND_H, u64(at + 1));
            wrBool(p, OFF_FIND_OK, true);
        }
        let bytes: []u8 = @slice(p, FIND_SIZE);
        fakeResult(call, CB_LB_FIND, bytes);
        return;
    }
    let n = cs(name, 0);
    if n as int == 0 {
        await(u64(0), onFound, slot);
        return;
    }
    if create {
        let g = method("SteamUserStats", "SteamAPI_ISteamUserStats_FindOrCreateLeaderboard") as fn(ptr, ptr, i32, i32): u64;
        await(g(us(), n, sort, display), onFound, slot);
    } else {
        let g = method("SteamUserStats", "SteamAPI_ISteamUserStats_FindLeaderboard") as fn(ptr, ptr): u64;
        await(g(us(), n), onFound, slot);
    }
}

/// Look up the existing leaderboard `name`. `f(board, found, ctx)` runs on a later frame: `board` is the
/// handle for the calls below, `found` false when it does not exist (or Steam is absent: `f` then
/// runs on the next `frame()` with `found` false). Names over 128 bytes fail the same way.
pub fn findBoard(name: string, f: fn(u64, bool, u64), ctx: u64) {
    findImpl(name, false, 0, 0, f, ctx);
}

/// Like `findBoard`, but create the leaderboard when it is missing, with `sort` (`SORT_ASC`,
/// `SORT_DESC`) and `display` (`DISPLAY_*`). The sort and display of an existing board are not changed.
pub fn findOrCreateBoard(name: string, sort: i32, display: i32, f: fn(u64, bool, u64), ctx: u64) {
    findImpl(name, true, sort, display, f, ctx);
}

/// Display name of `board`, valid until the next frame. "" when Steam is absent or the handle is bad.
pub fn boardName(board: u64): string {
    if fake() {
        let at = boardAt(board);
        if at < 0 {
            return "";
        }
        return FB[at].name;
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetLeaderboardName") as fn(ptr, u64): ptr;
    return fromC(f(us(), board));
}

/// How many players have a score on `board`. 0 when Steam is absent or the handle is bad.
pub fn boardEntryCount(board: u64): int {
    if fake() {
        let at = boardAt(board);
        if at < 0 {
            return 0;
        }
        return runCount(at);
    }
    let f = method("SteamUserStats", "SteamAPI_ISteamUserStats_GetLeaderboardEntryCount") as fn(ptr, u64): i32;
    return int(f(us(), board));
}

// ---- upload ----

fn onUploaded(p: ptr, n: i32, failed: bool, ctx: u64) {
    let r = reqTake(ctx);
    if !r.used {
        return;
    }
    UP = Uploaded { ok: false, board: u64(0), score: 0, changed: false, rank: 0, prevRank: 0 };
    if !failed {
        UP.ok = rdBool(p, OFF_UP_OK);
        UP.board = rdU64(p, OFF_UP_H);
        UP.score = rdI32(p, OFF_UP_SCORE);
        UP.changed = rdBool(p, OFF_UP_CHANGED);
        UP.rank = rdI32(p, OFF_UP_NEW);
        UP.prevRank = rdI32(p, OFF_UP_PREV);
    }
    let f = r.f as fn(&Uploaded, u64);
    f(&UP, r.ctx);
}

/// Send `score` to `board` with up to 64 extra `details` values (ghost data, level id). `method` is
/// `UPLOAD_KEEP_BEST` or `UPLOAD_FORCE`. `f(up, ctx)` runs on a later frame; `up.ok` is false on
/// failure, when Steam is absent (`f` runs on the next `frame()`), or with over 64 details. `up` is
/// valid only inside `f`.
pub fn uploadScore(board: u64, method: i32, score: i32, details: []i32, f: fn(&Uploaded, u64), ctx: u64) {
    let slot = reqNew(f as ptr, ctx);
    if details.len > DETAILS_MAX {
        eprintOnce(`steam: uploadScore with {details.len} details; the limit is {DETAILS_MAX}`);
        await(u64(0), onUploaded, slot);
        return;
    }
    if fake() {
        fakeLog(`uploadScore board {board} score {score}`);
        let call = fakeCall();
        await(call, onUploaded, slot);
        let at = boardAt(board);
        let p = fbuf();
        if at >= 0 {
            fakePut(at, FAKE_USER, method, score, details);
            wrBool(p, OFF_UP_OK, true);
            wrU64(p, OFF_UP_H, board);
            wrI32(p, OFF_UP_SCORE, score);
            wrBool(p, OFF_UP_CHANGED, PUT_CHANGED);
            wrI32(p, OFF_UP_NEW, PUT_RANK);
            wrI32(p, OFF_UP_PREV, PUT_PREV);
        }
        let bytes: []u8 = @slice(p, UP_SIZE);
        fakeResult(call, CB_LB_UPLOADED, bytes);
        return;
    }
    let g = steamMethod("SteamAPI_ISteamUserStats_UploadLeaderboardScore") as fn(ptr, u64, i32, i32, ptr, i32): u64;
    await(g(us(), board, method, score, details.ptr as ptr, i32(details.len)), onUploaded, slot);
}

/// `method("SteamUserStats", symbol)`; the symbol must be a literal at the call site.
fn steamMethod(symbol: string): ptr {
    return method("SteamUserStats", symbol);
}

// ---- download ----

fn onScores(p: ptr, n: i32, failed: bool, ctx: u64) {
    let r = reqTake(ctx);
    if fake() {
        FS_LIVE -= 1;
    }
    if !r.used {
        return;
    }
    SC = Scores { board: u64(0), handle: u64(0), count: 0 };
    if !failed {
        SC.board = rdU64(p, OFF_DL_H);
        SC.handle = rdU64(p, OFF_DL_ENTRIES);
        SC.count = int(rdI32(p, OFF_DL_COUNT));
    }
    let f = r.f as fn(&Scores, bool, u64);
    f(&SC, !failed, r.ctx);
    SC = Scores { board: u64(0), handle: u64(0), count: 0 };
    if fake() && FS_LIVE <= 0 {
        FS_LIVE = 0;
        FS_N = 0;
    }
}

fn downloadImpl(board: u64, request: i32, start: i32, end: i32, ids: []u64, byIds: bool, f: fn(&Scores, bool, u64), ctx: u64) {
    let slot = reqNew(f as ptr, ctx);
    if fake() {
        fakeLog(`downloadScores board {board} request {request}`);
        let call = fakeCall();
        await(call, onScores, slot);
        FS_LIVE += 1;
        let at = boardAt(board);
        let p = fbuf();
        wrU64(p, OFF_DL_H, board);
        if at >= 0 {
            let first = fakeDownload(at, request, int(start), int(end), ids, byIds);
            wrU64(p, OFF_DL_ENTRIES, u64(first + 1));
            wrI32(p, OFF_DL_COUNT, i32(FS_N - first));
        }
        let bytes: []u8 = @slice(p, DL_SIZE);
        fakeResult(call, CB_LB_SCORES, bytes);
        return;
    }
    if byIds {
        let g = steamMethod("SteamAPI_ISteamUserStats_DownloadLeaderboardEntriesForUsers") as fn(ptr, u64, ptr, i32): u64;
        await(g(us(), board, ids.ptr as ptr, i32(ids.len)), onScores, slot);
    } else {
        let g = steamMethod("SteamAPI_ISteamUserStats_DownloadLeaderboardEntries") as fn(ptr, u64, i32, i32, i32): u64;
        await(g(us(), board, request, start, end), onScores, slot);
    }
}

/// Download a page of `board`. `request` is `DOWNLOAD_GLOBAL`, `DOWNLOAD_AROUND_USER` or
/// `DOWNLOAD_FRIENDS`; `start` and `end` as documented on those. `f(scores, ok, ctx)` runs on a later
/// frame (on the next `frame()` with `ok` false when Steam is absent); read `scores` inside it, it is
/// empty afterwards.
pub fn downloadScores(board: u64, request: i32, start: i32, end: i32, f: fn(&Scores, bool, u64), ctx: u64) {
    let none: []u64 = @slice(0 as ptr, 0);
    downloadImpl(board, request, start, end, none, false, f, ctx);
}

/// Download the scores of the players in `ids` (SteamIDs; at most 100 are used by Steam), in rank
/// order. Same handler rules as `downloadScores`.
pub fn downloadScoresForUsers(board: u64, ids: []u64, f: fn(&Scores, bool, u64), ctx: u64) {
    downloadImpl(board, DOWNLOAD_GLOBAL, 0, 0, ids, true, f, ctx);
}

/// Read this part's offsets and register its callbacks; called from `statsInit`.
fn boardsInit() {
    OFF_FIND_H = lay("LeaderboardFindResult_t", "hSteamLeaderboard");
    OFF_FIND_OK = lay("LeaderboardFindResult_t", "bLeaderboardFound");
    FIND_SIZE = lay("LeaderboardFindResult_t", SIZE);
    OFF_UP_OK = lay("LeaderboardScoreUploaded_t", "bSuccess");
    OFF_UP_H = lay("LeaderboardScoreUploaded_t", "hSteamLeaderboard");
    OFF_UP_SCORE = lay("LeaderboardScoreUploaded_t", "nScore");
    OFF_UP_CHANGED = lay("LeaderboardScoreUploaded_t", "bScoreChanged");
    OFF_UP_NEW = lay("LeaderboardScoreUploaded_t", "nGlobalRankNew");
    OFF_UP_PREV = lay("LeaderboardScoreUploaded_t", "nGlobalRankPrevious");
    UP_SIZE = lay("LeaderboardScoreUploaded_t", SIZE);
    OFF_DL_H = lay("LeaderboardScoresDownloaded_t", "hSteamLeaderboard");
    OFF_DL_ENTRIES = lay("LeaderboardScoresDownloaded_t", "hSteamLeaderboardEntries");
    OFF_DL_COUNT = lay("LeaderboardScoresDownloaded_t", "cEntryCount");
    DL_SIZE = lay("LeaderboardScoresDownloaded_t", SIZE);
    OFF_E_USER = lay("LeaderboardEntry_t", "steamIDUser");
    OFF_E_RANK = lay("LeaderboardEntry_t", "nGlobalRank");
    OFF_E_SCORE = lay("LeaderboardEntry_t", "nScore");
    OFF_E_DETAILS = lay("LeaderboardEntry_t", "cDetails");
}
