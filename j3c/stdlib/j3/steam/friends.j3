// Part of j3.steam: ISteamUser / ISteamFriends (ids, names, avatars, rich presence, overlay dialogs); the module doc and `use`s are in ../steam.j3.
//
// Handlers (`onAvatar`, `onJoinRequest`, and the other `on...` setters in this part's siblings) hold ONE
// function each: setting again replaces it. Strings that come from C are copies on the frame scratch
// arena, valid until the next `frame()`; copy them to keep them.
module j3.steam;

const CB_AVATAR: i32 = 334;
const CB_JOIN_REQUEST: i32 = 337;
/// Size of `rgchConnect` in `GameRichPresenceJoinRequested_t`.
const CONNECT_MAX: int = 256;

/// `GetFriendCount` flag: friends of the local user.
pub const FRIENDS_IMMEDIATE: int = 4;
/// Fake mode: the first fake friend; the second is this plus one.
pub const FAKE_FRIEND: u64 = 76561197960265730;
/// Fake mode: the second fake friend.
pub const FAKE_FRIEND2: u64 = 76561197960265731;

/// Size of an avatar or other Steam image, in pixels.
pub struct ImageSize {
    /// Width, 0 when the image is unknown.
    w: int;
    /// Height, 0 when the image is unknown.
    h: int;
}

#[singleton]
let H_AVATAR: ptr;
#[singleton]
let H_JOIN: ptr;
#[singleton]
let OFF_AV_ID: int = 0;
#[singleton]
let OFF_AV_IMAGE: int = 0;
#[singleton]
let OFF_JOIN_FRIEND: int = 0;
#[singleton]
let OFF_JOIN_CONNECT: int = 0;

fn fr(): ptr {
    return iface("SteamFriends");
}

fn su(): ptr {
    return iface("SteamUser");
}

// ---- fake state ----

struct FPres {
    key: string;
    value: string;
}

#[singleton]
let FPRES: []FPres;
#[singleton]
let FPRES_N: int = 0;

fn fpresFind(key: string): int {
    for i in 0..FPRES_N {
        if same(FPRES[i].key, key) {
            return i;
        }
    }
    return 0 - 1;
}

fn fpresSet(key: string, value: string) {
    let at = fpresFind(key);
    if value.len == 0 {
        if at >= 0 {
            FPRES_N -= 1;
            FPRES[at] = FPRES[FPRES_N];
        }
        return;
    }
    if at >= 0 {
        FPRES[at].value = keep(value);
        return;
    }
    if FPRES_N >= FPRES.len {
        FPRES = grown(FPRES, FPRES_N);
    }
    FPRES[FPRES_N] = FPres { key: keep(key), value: keep(value) };
    FPRES_N += 1;
}

// ---- user and friends ----

/// The local user's SteamID (64-bit). 0 when Steam is absent.
pub fn userId(): u64 {
    if fake() {
        return FAKE_USER;
    }
    let f = method("SteamUser", "SteamAPI_ISteamUser_GetSteamID") as fn(ptr): u64;
    return f(su());
}

/// The local user's display name. "" when Steam is absent. Valid until the next frame.
pub fn userName(): string {
    if fake() {
        return "FakeUser";
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetPersonaName") as fn(ptr): ptr;
    return fromC(f(fr()));
}

/// Display name of user `id` (a friend, or yourself). "" when Steam is absent or `id` is unknown. Valid until the next frame.
pub fn friendName(id: u64): string {
    if fake() {
        if id == FAKE_USER {
            return "FakeUser";
        }
        if id == FAKE_FRIEND {
            return "FakeFriendOne";
        }
        if id == FAKE_FRIEND2 {
            return "FakeFriendTwo";
        }
        return "";
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetFriendPersonaName") as fn(ptr, u64): ptr;
    return fromC(f(fr(), id));
}

/// How many friends match `flags` (`FRIENDS_IMMEDIATE`, or an `EFriendFlags` mask from the SDK). 0 when Steam is
/// absent. Fake mode has two friends for any flags.
pub fn friendCount(flags: int): int {
    if fake() {
        return 2;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetFriendCount") as fn(ptr, i32): i32;
    return int(f(fr(), i32(flags)));
}

/// SteamID of friend number `i` (0-based, below `friendCount(flags)`). 0 when Steam is absent or `i` is out of range.
pub fn friendAt(i: int, flags: int): u64 {
    if fake() {
        if i == 0 {
            return FAKE_FRIEND;
        }
        if i == 1 {
            return FAKE_FRIEND2;
        }
        return u64(0);
    }
    if i < 0 {
        return u64(0);
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetFriendByIndex") as fn(ptr, i32, i32): u64;
    return f(fr(), i32(i), i32(flags));
}

/// Image handle of user `id`'s avatar: `size` 0 small (32x32), 1 medium (64x64), 2 large (184x184). 0 means no
/// avatar, -1 means it is still loading (`onAvatar` fires when it is ready). Pass the handle to `imageSize` and
/// `imageRgba`. 0 when Steam is absent or in fake mode.
pub fn avatar(id: u64, size: int): int {
    if fake() {
        return 0;
    }
    if size == 0 {
        let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetSmallFriendAvatar") as fn(ptr, u64): i32;
        return int(f(fr(), id));
    }
    if size == 1 {
        let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetMediumFriendAvatar") as fn(ptr, u64): i32;
        return int(f(fr(), id));
    }
    if size == 2 {
        let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetLargeFriendAvatar") as fn(ptr, u64): i32;
        return int(f(fr(), id));
    }
    return 0;
}

/// Run `f(id, image)` when an avatar that was loading (`avatar` returned -1) is ready; `image` is the new handle.
/// One handler: setting again replaces it.
pub fn onAvatar(f: fn(u64, i32)) {
    H_AVATAR = f as ptr;
}

/// Pixel size of image `img` (from `avatar`). 0 by 0 when Steam is absent or the handle is unknown.
pub fn imageSize(img: int): ImageSize {
    if fake() {
        return ImageSize { w: 0, h: 0 };
    }
    let out = outCell();
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetImageSize") as fn(ptr, i32, ptr, ptr): bool;
    if f(iface("SteamUtils"), i32(img), out, (out as int + 4) as ptr) {
        return ImageSize { w: int(rdU32(out, 0)), h: int(rdU32(out, 4)) };
    }
    return ImageSize { w: 0, h: 0 };
}

/// Copy image `img` into `out` as RGBA8, top row first, 4 bytes a pixel (`imageSize` w x h x 4 bytes needed).
/// False when Steam is absent, the handle is unknown or `out` is too small. Make a texture from it.
pub fn imageRgba(img: int, out: []u8): bool {
    let s = imageSize(img);
    let need = s.w * s.h * 4;
    if need == 0 || out.len < need {
        return false;
    }
    let f = method("SteamUtils", "SteamAPI_ISteamUtils_GetImageRGBA") as fn(ptr, i32, ptr, i32): bool;
    return f(iface("SteamUtils"), i32(img), out.ptr as ptr, i32(need));
}

// ---- rich presence ----

/// Set rich presence `key` to `value` for the local user (friends see it; "status" and "connect" are special keys).
/// An empty `value` removes the key. False when Steam is absent or the text is over 1023 bytes.
pub fn presence(key: string, value: string): bool {
    if fake() {
        fakeLog(`presence {key}={value}`);
        fpresSet(key, value);
        return true;
    }
    let k = cs(key, 0);
    let v = cs(value, 1);
    if k as int == 0 || v as int == 0 {
        return false;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_SetRichPresence") as fn(ptr, ptr, ptr): bool;
    return f(fr(), k, v);
}

/// Remove all rich presence keys of the local user.
pub fn clearPresence() {
    if fake() {
        fakeLog("clearPresence");
        FPRES_N = 0;
        return;
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_ClearRichPresence") as fn(ptr);
    f(fr());
}

/// Rich presence `key` of user `id`. "" when unset or Steam is absent. Fake mode knows the local user only.
/// Valid until the next frame.
pub fn friendPresence(id: u64, key: string): string {
    if fake() {
        let at = fpresFind(key);
        if id == FAKE_USER && at >= 0 {
            return FPRES[at].value;
        }
        return "";
    }
    let k = cs(key, 0);
    if k as int == 0 {
        return "";
    }
    let f = method("SteamFriends", "SteamAPI_ISteamFriends_GetFriendRichPresence") as fn(ptr, u64, ptr): ptr;
    return fromC(f(fr(), id, k));
}

/// Run `f(friend, connect)` when the user accepts a join invite or "Join Game" (`GameRichPresenceJoinRequested_t`);
/// `connect` is the friend's "connect" presence value. The text is valid until the next frame. One handler:
/// setting again replaces it. On a cold start the same string arrives in `launchCommandLine`.
pub fn onJoinRequest(f: fn(u64, string)) {
    H_JOIN = f as ptr;
}

fn onAvatarCb(p: ptr, n: i32) {
    if H_AVATAR as int != 0 {
        let f = H_AVATAR as fn(u64, i32);
        f(rdU64(p, OFF_AV_ID), rdI32(p, OFF_AV_IMAGE));
    }
}

fn onJoinCb(p: ptr, n: i32) {
    if H_JOIN as int != 0 {
        let f = H_JOIN as fn(u64, string);
        let id = rdU64(p, OFF_JOIN_FRIEND);
        f(id, fromFixed((p as int + OFF_JOIN_CONNECT) as ptr, CONNECT_MAX));
    }
}

fn friendsInit() {
    OFF_AV_ID = lay("AvatarImageLoaded_t", "steamID");
    OFF_AV_IMAGE = lay("AvatarImageLoaded_t", "iImage");
    OFF_JOIN_FRIEND = lay("GameRichPresenceJoinRequested_t", "steamIDFriend");
    OFF_JOIN_CONNECT = lay("GameRichPresenceJoinRequested_t", "rgchConnect");
    onCallback(CB_AVATAR, onAvatarCb);
    onCallback(CB_JOIN_REQUEST, onJoinCb);
}

fn friendsDown() {
    FPRES_N = 0;
}

/// Register the social parts' callbacks and shutdown work; called once from `registerParts`.
fn socialInit() {
    friendsInit();
    utilsInit();
    shotsInit();
    onShutdown(friendsDown);
}
