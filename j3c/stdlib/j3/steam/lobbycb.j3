// Part of j3.steam: lobby callbacks (data, members, chat, game server, invite, kicked, join request): offsets, handler
// setters, delivery, and the fake-mode senders for the same structs. The module doc and `use`s are in ../steam.j3.
module j3.steam;

const CB_LOBBY_INVITE: i32 = 503;
const CB_LOBBY_DATA: i32 = 505;
const CB_LOBBY_MEMBERS: i32 = 506;
const CB_LOBBY_MSG: i32 = 507;
const CB_LOBBY_SERVER: i32 = 509;
const CB_LOBBY_KICKED: i32 = 512;
const CB_LOBBY_JOIN_REQ: i32 = 333;
const CB_LOBBY_ENTER: i32 = 504;
const CB_LOBBY_LIST: i32 = 510;
const CB_LOBBY_CREATED: i32 = 513;

// Offsets and sizes in `LOFF`, read once from the layout table.
const O_CR_RESULT: int = 0;
const O_CR_LOBBY: int = 1;
const O_CR_SIZE: int = 2;
const O_LS_COUNT: int = 3;
const O_LS_SIZE: int = 4;
const O_EN_LOBBY: int = 5;
const O_EN_LOCKED: int = 6;
const O_EN_RESP: int = 7;
const O_EN_SIZE: int = 8;
const O_DU_LOBBY: int = 9;
const O_DU_MEMBER: int = 10;
const O_DU_OK: int = 11;
const O_DU_SIZE: int = 12;
const O_MU_LOBBY: int = 13;
const O_MU_USER: int = 14;
const O_MU_BY: int = 15;
const O_MU_CHANGE: int = 16;
const O_MU_SIZE: int = 17;
const O_CM_LOBBY: int = 18;
const O_CM_USER: int = 19;
const O_CM_TYPE: int = 20;
const O_CM_ID: int = 21;
const O_CM_SIZE: int = 22;
const O_GC_LOBBY: int = 23;
const O_GC_SERVER: int = 24;
const O_GC_IP: int = 25;
const O_GC_PORT: int = 26;
const O_GC_SIZE: int = 27;
const O_IV_USER: int = 28;
const O_IV_LOBBY: int = 29;
const O_IV_SIZE: int = 30;
const O_KK_LOBBY: int = 31;
const O_KK_ADMIN: int = 32;
const O_KK_DISC: int = 33;
const O_KK_SIZE: int = 34;
const O_JR_LOBBY: int = 35;
const O_JR_FRIEND: int = 36;
const O_JR_SIZE: int = 37;
const O_COUNT: int = 38;

#[singleton]
let LOFF: []int;
#[singleton]
let H_LDATA: ptr;
#[singleton]
let H_LMEM: ptr;
#[singleton]
let H_LMSG: ptr;
#[singleton]
let H_LSRV: ptr;
#[singleton]
let H_LINV: ptr;
#[singleton]
let H_LKICK: ptr;
#[singleton]
let H_LJOIN: ptr;

fn lo(i: int): int {
    return LOFF[i];
}

/// Run `f(lobby, member, ok)` when lobby data or a member's data changed (`member` is the lobby id for lobby data),
/// or `refreshLobby` finished. Read the new value with `lobbyData` / `memberData`. One handler: setting again replaces it.
pub fn onLobbyData(f: fn(u64, u64, bool)) {
    H_LDATA = f as ptr;
}

/// Run `f(lobby, user, by, change)` when a member enters, leaves, drops, is kicked or banned: `change` is one of
/// `LOBBY_ENTERED`, `LOBBY_LEFT`, `LOBBY_DISCONNECTED`, `LOBBY_KICKED`, `LOBBY_BANNED`; `by` is who caused it.
/// One handler: setting again replaces it.
pub fn onLobbyMembers(f: fn(u64, u64, u64, u32)) {
    H_LMEM = f as ptr;
}

/// Run `f(lobby, user, chatId)` when a chat message arrives, your own included. Read it with `lobbyMsg(lobby, chatId, out)`.
/// One handler: setting again replaces it.
pub fn onLobbyMsg(f: fn(u64, u64, int)) {
    H_LMSG = f as ptr;
}

/// Run `f(lobby, ip, port, server)` when the owner sets a game server for the lobby (`setLobbyServer`).
/// One handler: setting again replaces it.
pub fn onLobbyServer(f: fn(u64, u32, int, u64)) {
    H_LSRV = f as ptr;
}

/// Run `f(from, lobby)` when a friend invites you to a lobby while the game runs. One handler: setting again replaces it.
pub fn onLobbyInvite(f: fn(u64, u64)) {
    H_LINV = f as ptr;
}

/// Run `f(lobby, admin, disconnected)` when you are removed from a lobby; `disconnected` says the link dropped.
/// One handler: setting again replaces it.
pub fn onLobbyKicked(f: fn(u64, u64, bool)) {
    H_LKICK = f as ptr;
}

/// Run `f(lobby, friend)` when the user accepts a lobby invite or "Join Game" from the overlay. Call `joinLobby(lobby, ...)`
/// from it. On a cold start the same lobby comes from `connectLobbyArg`. One handler: setting again replaces it.
pub fn onLobbyJoinRequest(f: fn(u64, u64)) {
    H_LJOIN = f as ptr;
}

fn onLDataCb(p: ptr, n: i32) {
    if H_LDATA as int != 0 {
        let f = H_LDATA as fn(u64, u64, bool);
        f(rdU64(p, lo(O_DU_LOBBY)), rdU64(p, lo(O_DU_MEMBER)), rdBool(p, lo(O_DU_OK)));
    }
}

fn onLMemCb(p: ptr, n: i32) {
    if H_LMEM as int != 0 {
        let f = H_LMEM as fn(u64, u64, u64, u32);
        f(rdU64(p, lo(O_MU_LOBBY)), rdU64(p, lo(O_MU_USER)), rdU64(p, lo(O_MU_BY)), rdU32(p, lo(O_MU_CHANGE)));
    }
}

fn onLMsgCb(p: ptr, n: i32) {
    if H_LMSG as int != 0 {
        let f = H_LMSG as fn(u64, u64, int);
        f(rdU64(p, lo(O_CM_LOBBY)), rdU64(p, lo(O_CM_USER)), int(rdI32(p, lo(O_CM_ID))));
    }
}

fn onLSrvCb(p: ptr, n: i32) {
    if H_LSRV as int != 0 {
        let f = H_LSRV as fn(u64, u32, int, u64);
        let at = lo(O_GC_PORT);
        let port = int(rdU8(p, at)) + int(rdU8(p, at + 1)) * 256;
        f(rdU64(p, lo(O_GC_LOBBY)), rdU32(p, lo(O_GC_IP)), port, rdU64(p, lo(O_GC_SERVER)));
    }
}

fn onLInvCb(p: ptr, n: i32) {
    if H_LINV as int != 0 {
        let f = H_LINV as fn(u64, u64);
        f(rdU64(p, lo(O_IV_USER)), rdU64(p, lo(O_IV_LOBBY)));
    }
}

fn onLKickCb(p: ptr, n: i32) {
    if H_LKICK as int != 0 {
        let f = H_LKICK as fn(u64, u64, bool);
        f(rdU64(p, lo(O_KK_LOBBY)), rdU64(p, lo(O_KK_ADMIN)), rdBool(p, lo(O_KK_DISC)));
    }
}

fn onLJoinCb(p: ptr, n: i32) {
    if H_LJOIN as int != 0 {
        let f = H_LJOIN as fn(u64, u64);
        f(rdU64(p, lo(O_JR_LOBBY)), rdU64(p, lo(O_JR_FRIEND)));
    }
}

// ---- fake-mode senders: build the struct with the same offsets and queue it ----

fn flFireData(lobby: u64, member: u64, good: bool) {
    let p = fbuf();
    wrU64(p, lo(O_DU_LOBBY), lobby);
    wrU64(p, lo(O_DU_MEMBER), member);
    wrBool(p, lo(O_DU_OK), good);
    let bytes: []u8 = @slice(p, lo(O_DU_SIZE));
    fakeCallback(CB_LOBBY_DATA, bytes);
}

fn flFireMembers(lobby: u64, user: u64, by: u64, change: u32) {
    let p = fbuf();
    wrU64(p, lo(O_MU_LOBBY), lobby);
    wrU64(p, lo(O_MU_USER), user);
    wrU64(p, lo(O_MU_BY), by);
    wrU32(p, lo(O_MU_CHANGE), change);
    let bytes: []u8 = @slice(p, lo(O_MU_SIZE));
    fakeCallback(CB_LOBBY_MEMBERS, bytes);
}

fn flFireMsg(lobby: u64, user: u64, id: int) {
    let p = fbuf();
    wrU64(p, lo(O_CM_LOBBY), lobby);
    wrU64(p, lo(O_CM_USER), user);
    wrU8(p, lo(O_CM_TYPE), u8(CHAT_MSG));
    wrI32(p, lo(O_CM_ID), i32(id));
    let bytes: []u8 = @slice(p, lo(O_CM_SIZE));
    fakeCallback(CB_LOBBY_MSG, bytes);
}

fn flFireServer(at: int) {
    let l = FLOBS[at];
    let p = fbuf();
    wrU64(p, lo(O_GC_LOBBY), l.id);
    wrU64(p, lo(O_GC_SERVER), l.server);
    wrU32(p, lo(O_GC_IP), l.ip);
    wrU8(p, lo(O_GC_PORT), u8(l.port & 255));
    wrU8(p, lo(O_GC_PORT) + 1, u8((l.port >> 8) & 255));
    let bytes: []u8 = @slice(p, lo(O_GC_SIZE));
    fakeCallback(CB_LOBBY_SERVER, bytes);
}

fn lobbyDown() {
    flReset();
}

fn setOff(i: int, name: string, field: string) {
    LOFF[i] = layAt(name, field, LARGE);
}

fn lobbyOffsets() {
    setOff(O_CR_RESULT, "LobbyCreated_t", "eResult");
    setOff(O_CR_LOBBY, "LobbyCreated_t", "ulSteamIDLobby");
    setOff(O_CR_SIZE, "LobbyCreated_t", SIZE);
    setOff(O_LS_COUNT, "LobbyMatchList_t", "nLobbiesMatching");
    setOff(O_LS_SIZE, "LobbyMatchList_t", SIZE);
    setOff(O_EN_LOBBY, "LobbyEnter_t", "ulSteamIDLobby");
    setOff(O_EN_LOCKED, "LobbyEnter_t", "bLocked");
    setOff(O_EN_RESP, "LobbyEnter_t", "EChatRoomEnterResponse");
    setOff(O_EN_SIZE, "LobbyEnter_t", SIZE);
    setOff(O_DU_LOBBY, "LobbyDataUpdate_t", "ulSteamIDLobby");
    setOff(O_DU_MEMBER, "LobbyDataUpdate_t", "ulSteamIDMember");
    setOff(O_DU_OK, "LobbyDataUpdate_t", "bSuccess");
    setOff(O_DU_SIZE, "LobbyDataUpdate_t", SIZE);
    setOff(O_MU_LOBBY, "LobbyChatUpdate_t", "ulSteamIDLobby");
    setOff(O_MU_USER, "LobbyChatUpdate_t", "ulSteamIDUserChanged");
    setOff(O_MU_BY, "LobbyChatUpdate_t", "ulSteamIDMakingChange");
    setOff(O_MU_CHANGE, "LobbyChatUpdate_t", "rgfChatMemberStateChange");
    setOff(O_MU_SIZE, "LobbyChatUpdate_t", SIZE);
    setOff(O_CM_LOBBY, "LobbyChatMsg_t", "ulSteamIDLobby");
    setOff(O_CM_USER, "LobbyChatMsg_t", "ulSteamIDUser");
    setOff(O_CM_TYPE, "LobbyChatMsg_t", "eChatEntryType");
    setOff(O_CM_ID, "LobbyChatMsg_t", "iChatID");
    setOff(O_CM_SIZE, "LobbyChatMsg_t", SIZE);
    setOff(O_GC_LOBBY, "LobbyGameCreated_t", "ulSteamIDLobby");
    setOff(O_GC_SERVER, "LobbyGameCreated_t", "ulSteamIDGameServer");
    setOff(O_GC_IP, "LobbyGameCreated_t", "unIP");
    setOff(O_GC_PORT, "LobbyGameCreated_t", "usPort");
    setOff(O_GC_SIZE, "LobbyGameCreated_t", SIZE);
    setOff(O_IV_USER, "LobbyInvite_t", "ulSteamIDUser");
    setOff(O_IV_LOBBY, "LobbyInvite_t", "ulSteamIDLobby");
    setOff(O_IV_SIZE, "LobbyInvite_t", SIZE);
    setOff(O_KK_LOBBY, "LobbyKicked_t", "ulSteamIDLobby");
    setOff(O_KK_ADMIN, "LobbyKicked_t", "ulSteamIDAdmin");
    setOff(O_KK_DISC, "LobbyKicked_t", "bKickedDueToDisconnect");
    setOff(O_KK_SIZE, "LobbyKicked_t", SIZE);
    setOff(O_JR_LOBBY, "GameLobbyJoinRequested_t", "steamIDLobby");
    setOff(O_JR_FRIEND, "GameLobbyJoinRequested_t", "steamIDFriend");
    setOff(O_JR_SIZE, "GameLobbyJoinRequested_t", SIZE);
}

/// Fake mode, for tests: deliver call result `bytes` (a hand-written `LobbyCreated_t` for `which` 0, `LobbyMatchList_t` for 1,
/// `LobbyEnter_t` for 2, laid out for pack(8) when `large`) to handler `f` through the real result handler, now.
/// `f` has the type of `createLobby`'s, `findLobbies`'s or `joinLobby`'s handler. No-op outside fake mode.
pub fn fakeLobbyResult(which: int, bytes: []u8, large: bool, f: ptr, ctx: u64) {
    if !fake() || which < 0 || which > 2 {
        return;
    }
    LARGE = large;
    lobbyOffsets();
    let slot = reqNew(f, ctx);
    let call = fakeCall();
    if which == 0 {
        await(call, onLobbyCreated, slot);
        fakeResult(call, CB_LOBBY_CREATED, bytes);
    }
    if which == 1 {
        await(call, onLobbyList, slot);
        fakeResult(call, CB_LOBBY_LIST, bytes);
    }
    if which == 2 {
        await(call, onLobbyEnter, slot);
        fakeResult(call, CB_LOBBY_ENTER, bytes);
    }
    frame();
    LARGE = packLarge();
    lobbyOffsets();
}

#[singleton]
let LARGE: bool = false;

/// Read the offsets, register the callbacks and the shutdown work; called once from `registerParts`.
fn lobbyInit() {
    LOFF = arena().alloc::<int>(O_COUNT);
    LARGE = packLarge();
    lobbyOffsets();
    onCallback(CB_LOBBY_DATA, onLDataCb);
    onCallback(CB_LOBBY_MEMBERS, onLMemCb);
    onCallback(CB_LOBBY_MSG, onLMsgCb);
    onCallback(CB_LOBBY_SERVER, onLSrvCb);
    onCallback(CB_LOBBY_INVITE, onLInvCb);
    onCallback(CB_LOBBY_KICKED, onLKickCb);
    onCallback(CB_LOBBY_JOIN_REQ, onLJoinCb);
    onShutdown(lobbyDown);
}
