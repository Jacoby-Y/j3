}

/// SDL display mode (`SDL_DisplayMode`).
struct SDL_DisplayMode {
    format: u32;
    w: i32;
    h: i32;
    refresh_rate: i32;
    driverdata: ptr;
}

struct ImageFns {
    init: ptr;
    load: ptr;
    quit: ptr;
}

struct MixerFns {
    open: ptr;
    loadWav: ptr;
    play: ptr;
    halt: ptr;
    freeChunk: ptr;
    loadMus: ptr;
    playMus: ptr;
    haltMus: ptr;
    freeMus: ptr;
    volume: ptr;
    volumeMus: ptr;
    close: ptr;
    alloc: ptr;
    fadeIn: ptr;
    fadeOut: ptr;
    fadeInMus: ptr;
    fadeOutMus: ptr;
    position: ptr;
}

struct FontFns {
    init: ptr;
    open: ptr;
    close: ptr;
    render: ptr;
    size: ptr;
    ascent: ptr;
    height: ptr;
    style: ptr;
    quit: ptr;
    /// Optional (SDL_ttf 2.0.18+ / 2.20+): 0 when the installed library lacks them.
    glyph: ptr;
    hb: ptr;
    dir: ptr;
    script: ptr;
}

#[singleton]
let imageSo: ptr = 0;
#[singleton]
let mixerSo: ptr = 0;
#[singleton]
let fontSo: ptr = 0;
#[singleton]
let imageFns: ImageFns = ImageFns { init: 0, load: 0, quit: 0 };
#[singleton]
let mixerFns: MixerFns = MixerFns {
    open: 0,
    loadWav: 0,
    play: 0,
    halt: 0,
    freeChunk: 0,
    loadMus: 0,
    playMus: 0,
    haltMus: 0,
    freeMus: 0,
    volume: 0,
    volumeMus: 0,
    close: 0,
    alloc: 0,
    fadeIn: 0,
    fadeOut: 0,
    fadeInMus: 0,
    fadeOutMus: 0,
    position: 0,
};
#[singleton]
let fontFns: FontFns = FontFns {
    init: 0,
    open: 0,
    close: 0,
    render: 0,
    size: 0,
    ascent: 0,
    height: 0,
    style: 0,
    quit: 0,
    glyph: 0,
    hb: 0,
    dir: 0,
    script: 0,
};

/// NUL-terminated library and symbol names. Kept apart from `cstr`'s scratch so lazily
/// binding SDL_ttf/image/mixer inside `tryLoad*C` does not clobber the caller's path.
#[singleton]
let soName: [128]u8;

/// Copy `name` into `soName`. Names are short C identifiers and sonames.
fn soCstr(name: string): cstr {
    if name.len + 1 > 128 {
        panic(name);
    }
    let i = 0;
    while i < name.len {
        soName[i] = name[i];
        i += 1;
    }
    soName[name.len] = 0;
    return &soName[0] as cstr;
}

/// Windows name of a `libSDL2_X-2.0.so.0` soname: `SDL2_X.dll` (into `soName`).
fn soWindows(soname: string): cstr {
    let n = 0;
    while 8 + n < soname.len && soname[8 + n] != 45 { n += 1; } // up to the '-'
    let i = 0;
    while i < 5 + n {
        soName[i] = soname[3 + i];
        i += 1;
    }
    let ext = ".dll";
    for k in 0..4 { soName[5 + n + k] = ext[k]; }
    soName[9 + n] = 0;
    return &soName[0] as cstr;
}

/// Open an SDL add-on library on first use: the Linux soname, else the Windows DLL.
/// Image, mixer, and font are opened on first use.
fn soTry(soname: string): ptr {
    let h = sdl.SDL_LoadObject(soCstr(soname));
    if h == 0 {
        h = sdl.SDL_LoadObject(soWindows(soname));
    }
    return h;
}

fn soOpen(soname: string): ptr {
    let handle = soTry(soname);
    if handle == 0 {
        panic(soname);
    }
    return handle;
}

fn soSym(handle: ptr, name: string): ptr {
    let sym = sdl.SDL_LoadFunction(handle, soCstr(name));
    if sym == 0 {
        panic(name);
    }
    return sym;
}

fn imageLib(): ptr {
    if imageSo == 0 {
        imageSo = soOpen("libSDL2_image-2.0.so.0");
    }
    return imageSo;
}

fn mixerLib(): ptr {
    if mixerSo == 0 {
        mixerSo = soOpen("libSDL2_mixer-2.0.so.0");
    }
    return mixerSo;
}

fn fontLib(): ptr {
    if fontSo == 0 {
        fontSo = soOpen("libSDL2_ttf-2.0.so.0");
    }
    return fontSo;
}

fn bindImage() {
    if imageFns.load != 0 {
        return;
    }
    let so = imageLib();
    imageFns.init = soSym(so, "IMG_Init");
    imageFns.load = soSym(so, "IMG_Load");
    imageFns.quit = soSym(so, "IMG_Quit");
}

fn bindMixer() {
    if mixerFns.open != 0 {
        return;
    }
    let so = mixerLib();
    mixerFns.open = soSym(so, "Mix_OpenAudio");
    mixerFns.loadWav = soSym(so, "Mix_LoadWAV");
    mixerFns.play = soSym(so, "Mix_PlayChannel");
    mixerFns.halt = soSym(so, "Mix_HaltChannel");
    mixerFns.freeChunk = soSym(so, "Mix_FreeChunk");
    mixerFns.loadMus = soSym(so, "Mix_LoadMUS");
    mixerFns.playMus = soSym(so, "Mix_PlayMusic");
    mixerFns.haltMus = soSym(so, "Mix_HaltMusic");
    mixerFns.freeMus = soSym(so, "Mix_FreeMusic");
    mixerFns.volume = soSym(so, "Mix_Volume");
    mixerFns.volumeMus = soSym(so, "Mix_VolumeMusic");
    mixerFns.close = soSym(so, "Mix_CloseAudio");
    mixerFns.alloc = soSym(so, "Mix_AllocateChannels");
    mixerFns.fadeIn = soSym(so, "Mix_FadeInChannel");
    mixerFns.fadeOut = soSym(so, "Mix_FadeOutChannel");
    mixerFns.fadeInMus = soSym(so, "Mix_FadeInMusic");
    mixerFns.fadeOutMus = soSym(so, "Mix_FadeOutMusic");
    mixerFns.position = soSym(so, "Mix_SetPosition");
}

fn bindFont() {
    if fontFns.open != 0 {
        return;
    }
    let so = fontLib();
    fontFns.init = soSym(so, "TTF_Init");
    fontFns.open = soSym(so, "TTF_OpenFont");
    fontFns.close = soSym(so, "TTF_CloseFont");
    fontFns.render = soSym(so, "TTF_RenderUTF8_Blended");
    fontFns.size = soSym(so, "TTF_SizeUTF8");
    fontFns.ascent = soSym(so, "TTF_FontAscent");
    fontFns.height = soSym(so, "TTF_FontHeight");
    fontFns.style = soSym(so, "TTF_SetFontStyle");
    fontFns.quit = soSym(so, "TTF_Quit");
    fontFns.glyph = sdl.SDL_LoadFunction(so, soCstr("TTF_GlyphIsProvided32"));
    fontFns.hb = sdl.SDL_LoadFunction(so, soCstr("TTF_GetHarfBuzzVersion"));
    fontFns.dir = sdl.SDL_LoadFunction(so, soCstr("TTF_SetFontDirection"));
    fontFns.script = sdl.SDL_LoadFunction(so, soCstr("TTF_SetFontScriptName"));
}

fn IMG_Init(flags: i32): i32 {
    let f = imageFns.init as fn(i32): i32;
    return f(flags);
}

fn IMG_Load(file: cstr): ptr {
    let f = imageFns.load as fn(cstr): ptr;
    return f(file);
}

fn IMG_Quit() {
    if imageFns.quit == 0 {
        return;
    }
    let f = imageFns.quit as fn();
    f();
}

fn Mix_OpenAudio(freq: i32, format: u16, channels: i32, chunksize: i32): i32 {
    let f = mixerFns.open as fn(i32, u16, i32, i32): i32;
    return f(freq, format, channels, chunksize);
}

fn Mix_LoadWAV(file: cstr): ptr {
    let f = mixerFns.loadWav as fn(cstr): ptr;
    return f(file);
}

fn Mix_PlayChannel(channel: i32, chunk: ptr, loops: i32): i32 {
    let f = mixerFns.play as fn(i32, ptr, i32): i32;
    return f(channel, chunk, loops);
}

fn Mix_HaltChannel(channel: i32) {
    let f = mixerFns.halt as fn(i32);
    f(channel);
}

fn Mix_FreeChunk(chunk: ptr) {
    let f = mixerFns.freeChunk as fn(ptr);
    f(chunk);
}

fn Mix_LoadMUS(file: cstr): ptr {
    let f = mixerFns.loadMus as fn(cstr): ptr;
    return f(file);
}

fn Mix_PlayMusic(music: ptr, loops: i32): i32 {
    let f = mixerFns.playMus as fn(ptr, i32): i32;
    return f(music, loops);
}

fn Mix_HaltMusic() {
    let f = mixerFns.haltMus as fn();
    f();
}

fn Mix_FreeMusic(music: ptr) {
    let f = mixerFns.freeMus as fn(ptr);
    f(music);
}

fn Mix_Volume(channel: i32, volume: i32): i32 {
    let f = mixerFns.volume as fn(i32, i32): i32;
    return f(channel, volume);
}

fn Mix_VolumeMusic(volume: i32): i32 {
    let f = mixerFns.volumeMus as fn(i32): i32;
    return f(volume);
}

fn Mix_AllocateChannels(n: i32): i32 {
    let f = mixerFns.alloc as fn(i32): i32;
    return f(n);
}

fn Mix_FadeInChannel(channel: i32, chunk: ptr, loops: i32, ms: i32): i32 {
    let f = mixerFns.fadeIn as fn(i32, ptr, i32, i32): i32;
    return f(channel, chunk, loops, ms);
}

fn Mix_FadeOutChannel(channel: i32, ms: i32): i32 {
    let f = mixerFns.fadeOut as fn(i32, i32): i32;
    return f(channel, ms);
}

fn Mix_FadeInMusic(music: ptr, loops: i32, ms: i32): i32 {
    let f = mixerFns.fadeInMus as fn(ptr, i32, i32): i32;
    return f(music, loops, ms);
}

fn Mix_FadeOutMusic(ms: i32): i32 {
    let f = mixerFns.fadeOutMus as fn(i32): i32;
    return f(ms);
}

fn Mix_SetPosition(channel: i32, angle: i16, distance: u8): i32 {
    let f = mixerFns.position as fn(i32, i16, u8): i32;
    return f(channel, angle, distance);
}

fn Mix_CloseAudio() {
    if mixerFns.close == 0 {
        return;
    }
    let f = mixerFns.close as fn();
    f();
}

fn TTF_Init(): i32 {
    let f = fontFns.init as fn(): i32;
    return f();
}

fn TTF_OpenFont(file: cstr, ptsize: i32): ptr {
    let f = fontFns.open as fn(cstr, i32): ptr;
    return f(file, ptsize);
}

fn TTF_CloseFont(font: ptr) {
    let f = fontFns.close as fn(ptr);
    f(font);
}

fn TTF_RenderUTF8_Blended(font: ptr, text: cstr, fg: u32): ptr {
    let f = fontFns.render as fn(ptr, cstr, u32): ptr;
    return f(font, text, fg);
}

fn TTF_SizeUTF8(font: ptr, text: cstr, w: ptr, h: ptr): i32 {
    let f = fontFns.size as fn(ptr, cstr, ptr, ptr): i32;
    return f(font, text, w, h);
}

fn TTF_FontAscent(font: ptr): i32 {
    let f = fontFns.ascent as fn(ptr): i32;
    return f(font);
}

fn TTF_FontHeight(font: ptr): i32 {
    let f = fontFns.height as fn(ptr): i32;
    return f(font);
}

fn TTF_SetFontStyle(font: ptr, style: i32) {
    let f = fontFns.style as fn(ptr, i32);
    f(font, style);
}

fn TTF_Quit() {
    if fontFns.quit == 0 {
        return;
    }
    let f = fontFns.quit as fn();
    f();
}

/// Init the audio subsystem.
const SDL_INIT_AUDIO: u32 = 0x00000010;
/// Init the video subsystem.
const SDL_INIT_VIDEO: u32 = 0x00000020;
/// Init game-controller support.
const SDL_INIT_GAMECONTROLLER: u32 = 0x00002000;
/// Place the window in the center of the display.
const SDL_WINDOWPOS_CENTERED: i32 = 0x2FFF0000;
/// Create the window with an OpenGL context.
const SDL_WINDOW_OPENGL: u32 = 0x00000002;
const SDL_WINDOW_HIDDEN: u32 = 0x00000008;
/// A window whose drawable may have more pixels than its size (Retina, Wayland/X11 scaling).
const SDL_WINDOW_ALLOW_HIGHDPI: u32 = 0x00002000;
/// Prefer a hardware renderer.
const SDL_RENDERER_ACCELERATED: u32 = 0x00000002;
/// Renderer presents in step with the display refresh.
const SDL_RENDERER_PRESENTVSYNC: u32 = 0x00000004;
/// Exclusive fullscreen at the window's display mode.
const SDL_WINDOW_FULLSCREEN: u32 = 0x00000001;
/// Borderless fullscreen at the desktop resolution.
const SDL_WINDOW_FULLSCREEN_DESKTOP: u32 = 0x00001001;
const SDL_WINDOW_MAXIMIZED: u32 = 0x00000080;
/// GL attribute: double-buffered swap.
const SDL_GL_DOUBLEBUFFER: i32 = 5;
/// GL attribute: depth-buffer bits.
const SDL_GL_DEPTH_SIZE: i32 = 6;
/// GL attribute: context major version.
const SDL_GL_CONTEXT_MAJOR_VERSION: i32 = 17;
/// GL attribute: context minor version.
const SDL_GL_CONTEXT_MINOR_VERSION: i32 = 18;
/// GL attribute: profile mask.
const SDL_GL_CONTEXT_PROFILE_MASK: i32 = 21;
/// Core profile (no compatibility entry points).
const SDL_GL_CONTEXT_PROFILE_CORE: i32 = 1;
/// `IMG_Init` flag for PNG.
const IMG_INIT_PNG: i32 = 2;
/// Signed 16-bit little-endian audio format.
const AUDIO_S16LSB: u16 = 0x8010;
/// Little-endian packed RGBA8 (`SDL_PIXELFORMAT_ABGR8888`).
const SDL_PIXELFORMAT_ABGR8888: u32 = 0x16762004;
/// `SDL_TEXTUREACCESS_STATIC`.
const SDL_TEXTUREACCESS_STATIC: i32 = 0;
/// `SDL_BLENDMODE_BLEND`.
const SDL_BLENDMODE_BLEND: i32 = 1;
/// `TTF_STYLE_BOLD`. SDL_ttf emboldens the face. It does not load a second file.
const TTF_STYLE_BOLD: i32 = 1;
/// Enable blending.
const GL_BLEND: u32 = 0x0BE2;
/// Source alpha blend factor.
const GL_SRC_ALPHA: u32 = 0x0302;
/// One minus source alpha blend factor.
const GL_ONE_MINUS_SRC_ALPHA: u32 = 0x0303;
/// Depth test capability.
const GL_DEPTH_TEST: u32 = 0x0B71;
/// Face culling capability.
const GL_CULL_FACE: u32 = 0x0B44;
/// 2D texture target.
const GL_TEXTURE_2D: u32 = 0x0DE1;
/// Sized RGBA internal format.
const GL_RGBA8: i32 = 0x8058;
/// RGBA pixel format.
const GL_RGBA: u32 = 0x1908;
/// Unsigned byte pixel type.
const GL_UNSIGNED_BYTE: u32 = 0x1401;
/// Pixel row length for subimage uploads.
const GL_UNPACK_ROW_LENGTH: u32 = 0x0CF2;
/// 32-bit float vertex type.
const GL_FLOAT: u32 = 0x1406;
/// Linear texture filter.
const GL_LINEAR: i32 = 0x2601;
/// Nearest-neighbor filter for generated pixel art.
const GL_NEAREST: i32 = 0x2600;
/// Clamp wrap mode.
const GL_CLAMP_TO_EDGE: i32 = 0x812F;
/// Minification filter parameter.
const GL_TEXTURE_MIN_FILTER: u32 = 0x2801;
/// Magnification filter parameter.
const GL_TEXTURE_MAG_FILTER: u32 = 0x2800;
/// Wrap mode for the S axis.
const GL_TEXTURE_WRAP_S: u32 = 0x2802;
/// Wrap mode for the T axis.
const GL_TEXTURE_WRAP_T: u32 = 0x2803;
/// Triangle draw mode.
const GL_TRIANGLES: u32 = 0x0004;
/// Vertex buffer target.
const GL_ARRAY_BUFFER: u32 = 0x8892;
/// Upload buffer data that will not change.
const GL_STATIC_DRAW: u32 = 0x88E4;
/// glBufferData usage hint for per-frame data.
const GL_STREAM_DRAW: u32 = 0x88E0;
/// glDrawArrays mode.
const GL_TRIANGLE_STRIP: u32 = 0x0005;
/// glEnable cap.
const GL_SCISSOR_TEST: u32 = 0x0C11;
/// Vertex shader stage.
const GL_VERTEX_SHADER: u32 = 0x8B31;
/// Fragment shader stage.
const GL_FRAGMENT_SHADER: u32 = 0x8B30;
/// Shader compile query.
const GL_COMPILE_STATUS: u32 = 0x8B81;
/// Program link query.
const GL_LINK_STATUS: u32 = 0x8B82;

/// RGBA color (0–255 per channel).
pub struct Color {
    /// Red channel.
    r: u8;
    /// Green channel.
    g: u8;
    /// Blue channel.
    b: u8;
    /// Alpha channel.
    a: u8;

    /// Opaque color from RGB (alpha 255).
    fn rgb(r: u8, g: u8, b: u8): Color {
        return Color { r: r, g: g, b: b, a: 255 };
    }

    /// Color from RGBA.
    fn rgba(r: u8, g: u8, b: u8, a: u8): Color {
        return Color { r: r, g: g, b: b, a: a };
    }
}

/// Opaque RGB color (alpha 255).
pub fn rgb(r: u8, g: u8, b: u8): Color {
    return Color.rgb(r, g, b);
}

/// RGBA color.
pub fn rgba(r: u8, g: u8, b: u8, a: u8): Color {
    return Color.rgba(r, g, b, a);
}

/// App quit event.
const SDL_QUIT: u32 = 256;
/// Window event. See `win_event` for the subtype.
const SDL_WINDOWEVENT: u32 = 512;
/// Mouse moved.
const SDL_MOUSEMOTION: u32 = 1024;
/// Mouse wheel moved.
const SDL_MOUSEWHEEL: u32 = 1027;
/// UTF-8 text from the keyboard.
const SDL_TEXTEDITING: u32 = 0x302;
const SDL_TEXTINPUT: u32 = 0x303;
/// A file was dropped on the window.
const SDL_DROPFILE: u32 = 0x1000;
/// Window size changed by the user.
const SDL_WINDOWEVENT_RESIZED: u8 = 5;
/// Window size changed for any reason.
const SDL_WINDOWEVENT_SIZE_CHANGED: u8 = 6;
/// The window moved to another display (a different pixel density).
const SDL_WINDOWEVENT_DISPLAY_CHANGED: u8 = 16;
/// Window close requested.
const SDL_WINDOWEVENT_CLOSE: u8 = 14;
const SDL_WINDOWEVENT_FOCUS_GAINED: u8 = 12;
const SDL_WINDOWEVENT_FOCUS_LOST: u8 = 13;

/// SDL event blob used while polling.
struct SDL_Event {
    /// Event type tag.
    ty: u32;
    /// Event timestamp in ms.
    timestamp: u32;
    /// Window id for window events.
    windowID: u32;
    /// Window event subtype.
    win_event: u8;
    /// Padding so this blob matches SDL's event layout.
    pad1: u8;
    /// Padding so this blob matches SDL's event layout.
    pad2: u8;
    /// Padding so this blob matches SDL's event layout.
    pad3: u8;
    /// First integer payload (e.g. new width).
    data1: i32;
    /// Second integer payload (e.g. new height or wheel).
    data2: i32;
    /// Mouse motion Y (layout filler).
    motion_y: i32;
    /// Relative mouse X motion.
    xrel: i32;
    /// Relative mouse Y motion.
    yrel: i32;
    /// Padding so the motion fields match SDL's event layout.
    motion_pad: i32;
    /// Trailing padding.
    tail2: u64;
    /// Trailing padding.
    tail3: u64;
}

/// `SDL_DropEvent` view of an `SDL_Event` blob.
struct SDL_DropEvent {
    /// Event type tag.
    ty: u32;
    /// Event timestamp in ms.
    timestamp: u32;
    /// SDL-owned path; free with `SDL_free`.
    file: ptr;
}

/// Mutable SDL platform singleton state.
struct Platform {
    /// SDL window pointer.
    window: ptr;
    /// SDL renderer pointer (0 in GL mode).
    renderer: ptr;
    /// Keyboard state array from SDL.
    keys: ptr;
    /// SDL ticks at last poll.
    last_ms: u32;
    /// Current draw color.
    color: Color;
    /// First game controller.
    pad0: ptr;
    /// Second game controller.
    pad1: ptr;
    /// Quit requested flag.
    quit: bool;
    /// Window width in pixels.
    win_w: int;
    /// Window height in pixels.
    win_h: int;
    /// 2D scale: screen-space drawing and `mousePos` use window pixels divided by this.
    ui_scale: f32;
    /// Current mouse button bitmask.
    mouse: u32;
    /// Mouse buttons from previous poll.
    prev_mouse: u32;
    /// Accumulated wheel this frame.
    wheel: i32;
    /// Audio subsystem opened.
    audio: bool;
    /// Image subsystem opened.
    img: bool;
    /// Font subsystem opened.
    fonts: bool;
    /// Current pad button bitmask.
    pad_bits: u32;
    /// Pad buttons from previous poll.
    prev_pad: u32;
    /// Last frame duration in ms.
    last_span: i32;
    /// Frames since init.
    frames: int;
    /// True when using an OpenGL context.
    gl: bool;
    /// OpenGL context pointer.
    glctx: ptr;
    /// Accumulated relative mouse X.
    mouse_dx: i32;
    /// Accumulated relative mouse Y.
    mouse_dy: i32;
    /// Relative mouse capture enabled.
    captured: bool;
}

/// Previous frame's keyboard state, for edge detection.
#[singleton]
let prevKeys: [512]u8;

/// Optional GL teardown callback (`fn()`). Zero means none.
#[singleton]
let onGlShutdown: ptr = 0;

/// Additional independent GL teardown callbacks.
#[singleton]
let glShutdowns: [8]ptr;
#[singleton]
let nGlShutdowns: int = 0;

/// Leftover fixed-step fraction, 0..1, written by `j3.app` before draw.
#[singleton]
let alphaFrame: f32 = 0;

/// UTF-8 bytes from `SDL_TEXTINPUT` since the last `poll`.
#[singleton]
let typed: [32]u8;

/// Length of `typed`.
#[singleton]
let typedLen: int = 0;

/// IME composition text from the last `SDL_TEXTEDITING` (kept across polls; empty when none).
#[singleton]
let composing: [32]u8;

/// Length of `composing`.
#[singleton]
let composingLen: int = 0;

/// Path of a file dropped on the window since the last `poll`.
/// System cursors made so far, by `Cursor` value.
#[singleton]
let cursors: [12]ptr;
/// Cursor asked for this frame, and the one on screen (`Cursor` numbering).
#[singleton]
let cursorWant: int = 0;
#[singleton]
let cursorShown: int = 0;

#[singleton]
let dropped: [1024]u8;

/// Length of `dropped`.
#[singleton]
let droppedLen: int = 0;

/// Last clipboard text read by `clipboard()`: a malloc'd buffer and its capacity, grown to fit.
#[singleton]
let clip: ptr = 0;
#[singleton]
let clipCap: int = 0;

/// When true, closing the window sets `closeAsked` instead of quitting.
#[singleton]
let closeHeld: bool = false;

/// The window close button was hit this frame while `closeHeld`.
#[singleton]
let closeAsked: bool = false;

/// Next sfx channel in 0..8.
#[singleton]
let nextSfx: int = 0;

/// Next voice channel in 8..16.
#[singleton]
let nextVoice: int = 8;

/// Live window, input, and subsystem flags.
#[singleton]
let platform: Platform = Platform {
    window: 0,
    renderer: 0,
    keys: 0,
    last_ms: 0,
    color: Color { r: 255, g: 255, b: 255, a: 255 },
    pad0: 0,
    pad1: 0,
    quit: false,
    win_w: 0,
    win_h: 0,
    ui_scale: 1.0,
    mouse: 0,
    prev_mouse: 0,
    wheel: 0,
    audio: false,
    img: false,
    fonts: false,
    pad_bits: 0,
    prev_pad: 0,
    last_span: 16,
    frames: 0,
    gl: false,
    glctx: 0,
    mouse_dx: 0,
    mouse_dy: 0,
    captured: false,
};

/// Panic if `p` is null; otherwise return it.
fn requirePtr(p: ptr, what: string): ptr {
    if p == 0 {
        panic(what);
    }
    return p;
}

