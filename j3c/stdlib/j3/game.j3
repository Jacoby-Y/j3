/// Window, input, draw, audio. C names stay private.
/// SDL wrapper. game_headless.j3 is the test stand-in, not a second API.
/// Main thread only: window, GL, and audio state is not thread-safe (`j3c doc threads`).

module j3.game;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
}

use j3.gfx.canvas.{ Canvas, Mode, loadPng };
use j3.io.printLn;
use j3.math.{ Vec2, clamp };
use j3.memory.{ Arena, scratch };
use j3.result.Result;
use j3.sys.panic;
use j3.text.{ Text, cstr, cstrBytes };

/// Opaque SDL window handle.
struct SDL_Window;
/// Opaque SDL renderer handle.
struct SDL_Renderer;

/// SDL integer rectangle.
struct SDL_Rect {
    /// Left edge in pixels.
    x: i32;
    /// Top edge in pixels.
    y: i32;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// SDL RGBA color byte.
struct SDL_Color {
    /// Red.
    r: u8;
    /// Green.
    g: u8;
    /// Blue.
    b: u8;
    /// Alpha.
    a: u8;
}

