/// Window, input, draw, audio. C names stay private.
/// SDL wrapper. game_headless.j3 is the test stand-in, not a second API.
/// Main thread only: window, GL, and audio state is not thread-safe (`j3c doc threads`).

module j3.game;

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
    fn malloc(n: int): ptr;
    fn calloc(n: int, size: int): ptr;
    fn realloc(p: ptr, n: int): ptr;
    fn free(p: ptr);
}

use j3.game.letterbox.{ GlRect, Rect, fit, glRect, toVirtual };
use j3.gfx.canvas.{ Canvas, Mode, loadPng };
use j3.gfx.glsl;
use j3.gpu;
use j3.gpu.{ Rgba8, Source };
use j3.gfx.path.MAXPT;
use j3.io.printLn;
use j3.math.{ Vec2, clamp, sqrt };
use j3.memory.{ Arena, scratch };
use j3.result.Result;
use j3.proc;
use j3.sys.{ PLATFORM, exeDir, dlopen, dlsym, panic, write };
use j3.text.{ Text, cstr, cstrBytes, find, same };
use j3.wake;

/// RGBA color (0–255 per channel).
pub struct Color {
    /// Red channel.
    r: u8;
    /// Green channel.
    g: u8;
    /// Blue channel.
    b: u8;
    /// Alpha channel.
    a: u8;

    /// Opaque color from RGB (alpha 255).
    fn rgb(r: u8, g: u8, b: u8): Color {
        return Color { r: r, g: g, b: b, a: 255 };
    }

    /// Color from RGBA.
    fn rgba(r: u8, g: u8, b: u8, a: u8): Color {
        return Color { r: r, g: g, b: b, a: a };
    }
}

/// Opaque RGB color (alpha 255).
pub fn rgb(r: u8, g: u8, b: u8): Color {
    return Color.rgb(r, g, b);
}

/// RGBA color.
pub fn rgba(r: u8, g: u8, b: u8, a: u8): Color {
    return Color.rgba(r, g, b, a);
}

/// Panic if `p` is null; otherwise return it.
fn requirePtr(p: ptr, what: string): ptr {
    if p == 0 {
        panic(Text.scratch().add(what).add(": ").add(sdlError()).str());
    }
    return p;
}

/// SDL's last error message, "" when none.
fn sdlError(): string {
    let e = sdl.SDL_GetError();
    if e == 0 { return ""; }
    return []u8 { ptr: e as &u8, len: libc.strlen(e) } as string;
}

/// Tightly packed RGBA8 image. `pixels.len` is `w * h * 4`, or 0 on failure.
pub struct Rgba {
    /// Row-major pixels, 4 bytes each, top row first.
    pixels: []u8;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// Leading fields of `SDL_Surface` on LP64, enough to read size and pixels.
struct SDL_Surface {
    /// Surface flags.
    flags: u32;
    /// Pixel format pointer. Unused here.
    format: ptr;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
    /// Bytes from one row to the next.
    pitch: i32;
    /// First byte of the pixel buffer.
    pixels: ptr;
}

/// GPU texture handle and pixel size.
pub struct Texture {
    /// SDL texture pointer (0 if empty).
    raw: ptr = 0;
    /// Width in pixels.
    w: i32 = 0;
    /// Height in pixels.
    h: i32 = 0;
}

/// Loaded sound sample.
pub struct Sound {
    /// Mixer chunk pointer (0 if empty).
    raw: ptr;
}

/// PCM output stream: push f32 interleaved samples from the main thread, SDL plays them.
/// Its own audio device, separate from SDL_mixer's `Sound`/`Music`; both play at once.
/// Playhead in frames = frames sent - `queued()`. `queued()` counts SDL's queue only, not
/// the device buffer (512 frames), so the speakers trail it by up to that much.
/// Under `SDL_AUDIODRIVER=dummy` the device drains in real time, so `queued()` still counts down.
pub struct AudioStream {
    /// SDL audio device id (0 if empty).
    raw: int;
    /// Frames per second.
    rate: int;
    /// Interleaved channels per frame.
    channels: int;

    /// Append interleaved samples (frames * channels). Never blocks.
    fn queue(this: &AudioStream, samples: []f32) {
        if this.raw == 0 || samples.len == 0 {
            return;
        }
        sdl.SDL_QueueAudio(u32(this.raw), samples.ptr as ptr, u32(samples.len * 4));
    }

    /// Frames queued but not yet played. Playhead = frames sent - queued().
    fn queued(this: &AudioStream): int {
        if this.raw == 0 {
            return 0;
        }
        return int(sdl.SDL_GetQueuedAudioSize(u32(this.raw))) / (4 * this.channels);
    }

    /// Drop everything queued right away (instant stop or seek).
    fn clear(this: &AudioStream) {
        if this.raw != 0 {
            sdl.SDL_ClearQueuedAudio(u32(this.raw));
        }
    }

    /// Pause or resume the device. Queued samples stay queued while paused.
    fn pause(this: &AudioStream, paused: bool) {
        if this.raw != 0 {
            sdl.SDL_PauseAudioDevice(u32(this.raw), if paused { 1 } else { 0 });
        }
    }

    /// Close the device; the stream is empty afterwards.
    fn close(this: &AudioStream) {
        if this.raw != 0 {
            sdl.SDL_CloseAudioDevice(u32(this.raw));
            this.raw = 0;
        }
    }
}

/// Loaded music stream.
pub struct Music {
    /// Mixer music pointer (0 if empty).
    raw: ptr;
}

/// Opened TrueType font.
pub struct Font {
    /// TTF font pointer (0 if empty).
    raw: ptr;
}

/// 2D camera: world origin and zoom.
pub struct Camera {
    /// World-space top-left of the view.
    pos: Vec2;
    /// Screen pixels per world unit.
    zoom: f32;

    /// Camera at origin with zoom (minimum 0.01).
    fn create(zoom: f32): Camera {
        let z = zoom;
        if z < 0.01 {
            z = 0.01;
        }
        return Camera {
            pos: Vec2 { x: 0, y: 0 },
            zoom: z,
        };
    }

    /// Map a world point to screen space.
    fn toScreen(this: Camera, world: Vec2): Vec2 {
        return (world - this.pos) * this.zoom;
    }

    /// Map a screen point to world space.
    fn toWorld(this: Camera, screen: Vec2): Vec2 {
        let inv = 1 / this.zoom;
        let world = screen * inv;
        return world + this.pos;
    }

    /// Center on focus, clamped so the view stays inside the map.
    fn follow(this: &Camera, focus: Vec2, view: Vec2, map_w: f32, map_h: f32) {
        let z = this.zoom;
        if z < 0.01 {
            z = 0.01;
        }
        let vw = view.x / z;
        let vh = view.y / z;
        let maxx = map_w - vw;
        let maxy = map_h - vh;
        if maxx < 0 {
            maxx = 0;
        }
        if maxy < 0 {
            maxy = 0;
        }
        this.pos.x = clamp(focus.x - vw / 2, 0, maxx);
        this.pos.y = clamp(focus.y - vh / 2, 0, maxy);
    }
}

/// Open SDL_image once. False when `libSDL2_image` is not installed.
fn ensureImage(): bool {
    if platform.img {
        return true;
    }
    if imageSo == 0 {
        imageSo = soTry(SO_IMAGE);
        if imageSo == 0 {
            return false;
        }
    }
    bindImage();
    IMG_Init(IMG_INIT_PNG);
    platform.img = true;
    return true;
}

/// Open the mixer once. False when `libSDL2_mixer` is not installed.
/// True after the library loads, even when the audio device does not open.
fn ensureAudio(): bool {
    if mixerFns.open != 0 {
        if !platform.audio {
            if Mix_OpenAudio(44100, AUDIO_S16LSB, 2, 2048) == 0 {
                Mix_AllocateChannels(16);
                platform.audio = true;
            }
        }
        return true;
    }
    if mixerSo == 0 {
        mixerSo = soTry(SO_MIXER);
        if mixerSo == 0 {
            return false;
        }
    }
    bindMixer();
    if Mix_OpenAudio(44100, AUDIO_S16LSB, 2, 2048) == 0 {
        Mix_AllocateChannels(16);
        platform.audio = true;
    }
    return true;
}

/// Initialize SDL_ttf once. False when `libSDL2_ttf` is missing or `TTF_Init` fails.
fn ensureFont(): bool {
    if platform.fonts {
        return true;
    }
    if fontSo == 0 {
        fontSo = soTry(SO_TTF);
        if fontSo == 0 {
            return false;
        }
    }
    bindFont();
    if TTF_Init() != 0 {
        return false;
    }
    platform.fonts = true;
    return true;
}

/// Push `platform.color` to the SDL draw color.
fn applyColor() {
    sdl.SDL_SetRenderDrawColor(
        platform.renderer,
        platform.color.r,
        platform.color.g,
        platform.color.b,
        platform.color.a,
    );
}

/// Current draw color as an SDL_Color.
fn sdlColor(): SDL_Color {
    return SDL_Color {
        r: platform.color.r,
        g: platform.color.g,
        b: platform.color.b,
        a: platform.color.a,
    };
}
