use j3.memory.{ Arena, scratch };
use j3.result.Result;
use j3.sys.{ panic, write };
use j3.text.{ Text, cstr, cstrBytes };

/// Opaque SDL window handle.
struct SDL_Window;
/// Opaque SDL renderer handle.
struct SDL_Renderer;

/// SDL integer rectangle.
struct SDL_Rect {
    /// Left edge in pixels.
    x: i32;
    /// Top edge in pixels.
    y: i32;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// SDL RGBA color byte.
struct SDL_Color {
    /// Red.
    r: u8;
    /// Green.
    g: u8;
    /// Blue.
    b: u8;
    /// Alpha.
    a: u8;
}

