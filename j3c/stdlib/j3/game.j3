    fn SDL_RenderFillRect(renderer: ptr, rect: &SDL_Rect): i32;
    fn SDL_RenderCopy(renderer: ptr, texture: ptr, src: ptr, dst: &SDL_Rect): i32;
    fn SDL_RenderCopyEx(renderer: ptr, texture: ptr, src: ptr, dst: &SDL_Rect, angle: f64, center: ptr, flip: i32): i32;
    fn SDL_RenderDrawLine(renderer: ptr, x1: i32, y1: i32, x2: i32, y2: i32): i32;
    fn SDL_RenderPresent(renderer: ptr);
    fn SDL_RenderReadPixels(renderer: ptr, rect: ptr, format: u32, pixels: ptr, pitch: i32): i32;
    fn SDL_StartTextInput();
    fn SDL_StopTextInput();
    fn SDL_GetClipboardText(): ptr;
