    fn SDL_SetTextureBlendMode(texture: ptr, mode: i32): i32;
    fn SDL_SetTextureScaleMode(texture: ptr, mode: i32): i32;
    fn SDL_SetTextureColorMod(texture: ptr, r: u8, g: u8, b: u8): i32;
    fn SDL_DestroyTexture(texture: ptr);
    fn SDL_FreeSurface(surface: ptr);
    fn SDL_ConvertSurfaceFormat(src: ptr, format: u32, flags: u32): ptr;
    fn SDL_LockSurface(surface: ptr): i32;
