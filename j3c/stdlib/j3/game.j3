/// Gamepad stick or trigger axis.
pub enum Axis {
    /// Left stick X.
    LeftX,
    /// Left stick Y.
    LeftY,
    /// Right stick X.
    RightX,
    /// Right stick Y.
    RightY,
    /// Left trigger.
    LT,
    /// Right trigger.
    RT,
}

/// Tightly packed RGBA8 image. `pixels.len` is `w * h * 4`, or 0 on failure.
pub struct Rgba {
    /// Row-major pixels, 4 bytes each, top row first.
    pixels: []u8;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
}

/// Leading fields of `SDL_Surface` on LP64, enough to read size and pixels.
struct SDL_Surface {
    /// Surface flags.
    flags: u32;
    /// Pixel format pointer. Unused here.
    format: ptr;
    /// Width in pixels.
    w: i32;
    /// Height in pixels.
    h: i32;
    /// Bytes from one row to the next.
    pitch: i32;
    /// First byte of the pixel buffer.
    pixels: ptr;
}

/// GPU texture handle and pixel size.
pub struct Texture {
    /// SDL texture pointer (0 if empty).
    raw: ptr = 0;
    /// Width in pixels.
    w: i32 = 0;
    /// Height in pixels.
    h: i32 = 0;
}

/// Loaded sound sample.
pub struct Sound {
    /// Mixer chunk pointer (0 if empty).
    raw: ptr;
}

/// Loaded music stream.
pub struct Music {
    /// Mixer music pointer (0 if empty).
    raw: ptr;
}

/// Opened TrueType font.
pub struct Font {
    /// TTF font pointer (0 if empty).
    raw: ptr;
}

/// 2D camera: world origin and zoom.
pub struct Camera {
    /// World-space top-left of the view.
    pos: Vec2;
    /// Screen pixels per world unit.
    zoom: f32;

    /// Camera at origin with zoom (minimum 0.01).
    fn create(zoom: f32): Camera {
        let z = zoom;
        if z < 0.01 {
            z = 0.01;
        }
        return Camera {
            pos: Vec2 { x: 0, y: 0 },
            zoom: z,
        };
    }

    /// Map a world point to screen space.
    fn toScreen(this: Camera, world: Vec2): Vec2 {
        return (world - this.pos) * this.zoom;
    }

    /// Map a screen point to world space.
    fn toWorld(this: Camera, screen: Vec2): Vec2 {
        let inv = f32(1) / this.zoom;
        let world = screen * inv;
        return world + this.pos;
    }

    /// Center on focus, clamped so the view stays inside the map.
    fn follow(this: &Camera, focus: Vec2, view: Vec2, map_w: f32, map_h: f32) {
        let z = this.zoom;
        if z < 0.01 {
            z = 0.01;
        }
        let vw = view.x / z;
        let vh = view.y / z;
        let maxx = map_w - vw;
        let maxy = map_h - vh;
        if maxx < 0 {
            maxx = 0;
        }
        if maxy < 0 {
            maxy = 0;
        }
        this.pos.x = clamp(focus.x - vw / 2, 0, maxx);
        this.pos.y = clamp(focus.y - vh / 2, 0, maxy);
    }
}

/// Scancode of the right-hand twin of Shift and Ctrl; `scancode(key)` for other keys.
fn rightScancode(key: Key): int {
    if key == Key.Shift { return 229; }
    if key == Key.Ctrl { return 228; }
    if key == Key.Alt { return 230; }
    return scancode(key);
}

/// SDL scancode for a `Key`.
fn scancode(key: Key): int {
    match key {
        Key.Escape { return 41; }
        Key.Left { return 80; }
        Key.Right { return 79; }
        Key.Up { return 82; }
        Key.Down { return 81; }
        Key.Space { return 44; }
        Key.Enter { return 40; }
        Key.Tab { return 43; }
        Key.Shift { return 225; }
        Key.Ctrl { return 224; }
        Key.Backspace { return 42; }
        Key.A { return 4; }
        Key.B { return 5; }
        Key.C { return 6; }
        Key.D { return 7; }
        Key.E { return 8; }
        Key.F { return 9; }
        Key.G { return 10; }
        Key.H { return 11; }
        Key.I { return 12; }
        Key.J { return 13; }
        Key.K { return 14; }
        Key.L { return 15; }
        Key.M { return 16; }
        Key.N { return 17; }
        Key.O { return 18; }
        Key.P { return 19; }
        Key.Q { return 20; }
        Key.R { return 21; }
        Key.S { return 22; }
        Key.T { return 23; }
        Key.U { return 24; }
        Key.V { return 25; }
        Key.W { return 26; }
        Key.X { return 27; }
        Key.Y { return 28; }
        Key.Z { return 29; }
        Key.Num0 { return 39; }
        Key.Num1 { return 30; }
        Key.Num2 { return 31; }
        Key.Num3 { return 32; }
        Key.Num4 { return 33; }
        Key.Num5 { return 34; }
        Key.Num6 { return 35; }
        Key.Num7 { return 36; }
        Key.Num8 { return 37; }
        Key.Num9 { return 38; }
        Key.F3 { return 60; }
        Key.F10 { return 67; }
        Key.Delete { return 76; }
        Key.F2 { return 59; }
        Key.F11 { return 68; }
        Key.F12 { return 69; }
        Key.Home { return 74; }
        Key.End { return 77; }
        Key.Minus { return 45; }
        Key.Period { return 55; }
        Key.F4 { return 61; }
        Key.F5 { return 62; }
        Key.Alt { return 226; }
        Key.PageUp { return 75; }
        Key.PageDown { return 78; }
    }
}

/// SDL game-controller button id for a `Pad`.
fn padButton(btn: Pad): i32 {
    match btn {
        Pad.A { return 0; }
        Pad.B { return 1; }
        Pad.X { return 2; }
        Pad.Y { return 3; }
        Pad.Back { return 4; }
        Pad.Start { return 6; }
        Pad.LB { return 9; }
        Pad.RB { return 10; }
        Pad.Up { return 11; }
        Pad.Down { return 12; }
        Pad.Left { return 13; }
        Pad.Right { return 14; }
    }
}

/// SDL game-controller axis id for an `Axis`.
fn padAxisId(axis: Axis): i32 {
    match axis {
        Axis.LeftX { return 0; }
        Axis.LeftY { return 1; }
        Axis.RightX { return 2; }
        Axis.RightY { return 3; }
        Axis.LT { return 4; }
        Axis.RT { return 5; }
    }
}

/// Controller pointer for pad index 0 or 1.
fn padPtr(i: int): ptr {
    if i == 0 {
        return platform.pad0;
    }
    if i == 1 {
        return platform.pad1;
    }
    return 0;
}

/// Open controllers 0 and 1 if not already open, and drop the ones that were unplugged (hotplug, once per `poll`).
fn ensurePads() {
    // an unplugged pad: close its handle (reads give 0 meanwhile), so plugging one in reopens the slot
    if platform.pad0 != 0 && sdl.SDL_GameControllerGetAttached(platform.pad0) == 0 {
        sdl.SDL_GameControllerClose(platform.pad0);
        platform.pad0 = 0;
    }
    if platform.pad1 != 0 && sdl.SDL_GameControllerGetAttached(platform.pad1) == 0 {
        sdl.SDL_GameControllerClose(platform.pad1);
        platform.pad1 = 0;
    }
    // device indices shift when one pad leaves, so index 0 or 1 may be the physical pad the other slot already holds: compare instance ids
    // and drop the duplicate (the slot stays empty until another pad appears)
    if platform.pad0 == 0 {
        platform.pad0 = sdl.SDL_GameControllerOpen(0);
        if platform.pad0 != 0 && platform.pad1 != 0 && padId(platform.pad0) == padId(platform.pad1) {
            sdl.SDL_GameControllerClose(platform.pad0);
            platform.pad0 = 0;
        }
    }
    if platform.pad1 == 0 {
        platform.pad1 = sdl.SDL_GameControllerOpen(1);
        if platform.pad1 != 0 && platform.pad0 != 0 && padId(platform.pad1) == padId(platform.pad0) {
            sdl.SDL_GameControllerClose(platform.pad1);
            platform.pad1 = 0;
        }
    }
}

/// SDL instance id of an open controller (stable for one physical pad while it is plugged in).
fn padId(pad: ptr): i32 {
    return sdl.SDL_JoystickInstanceID(sdl.SDL_GameControllerGetJoystick(pad));
}

/// Open SDL_image once. False when `libSDL2_image` is not installed.
fn ensureImage(): bool {
    if platform.img {
        return true;
    }
    if imageSo == 0 {
        imageSo = soTry("libSDL2_image-2.0.so.0");
        if imageSo == 0 {
            return false;
        }
    }
    bindImage();
    IMG_Init(IMG_INIT_PNG);
    platform.img = true;
    return true;
}

/// Open the mixer once. False when `libSDL2_mixer` is not installed.
/// True after the library loads, even when the audio device does not open.
fn ensureAudio(): bool {
    if mixerFns.open != 0 {
        if !platform.audio {
            if Mix_OpenAudio(44100, AUDIO_S16LSB, 2, 2048) == 0 {
                Mix_AllocateChannels(16);
                platform.audio = true;
            }
        }
        return true;
    }
    if mixerSo == 0 {
        mixerSo = soTry("libSDL2_mixer-2.0.so.0");
        if mixerSo == 0 {
            return false;
        }
    }
    bindMixer();
    if Mix_OpenAudio(44100, AUDIO_S16LSB, 2, 2048) == 0 {
        Mix_AllocateChannels(16);
        platform.audio = true;
    }
    return true;
}

/// Initialize SDL_ttf once. False when `libSDL2_ttf` is missing or `TTF_Init` fails.
fn ensureFont(): bool {
    if platform.fonts {
        return true;
    }
    if fontSo == 0 {
        fontSo = soTry("libSDL2_ttf-2.0.so.0");
        if fontSo == 0 {
            return false;
        }
    }
    bindFont();
    if TTF_Init() != 0 {
        return false;
    }
    platform.fonts = true;
    return true;
}

/// Push `platform.color` to the SDL draw color.
fn applyColor() {
    sdl.SDL_SetRenderDrawColor(
        platform.renderer,
        platform.color.r,
        platform.color.g,
        platform.color.b,
        platform.color.a,
    );
}

/// Current draw color as an SDL_Color.
fn sdlColor(): SDL_Color {
    return SDL_Color {
        r: platform.color.r,
        g: platform.color.g,
        b: platform.color.b,
        a: platform.color.a,
    };
}
