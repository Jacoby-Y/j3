/// Mouse button.
pub enum Mouse {
    /// Left button.
    Left,
    /// Right button.
    Right,
    /// Middle button.
    Middle,
}

/// Gamepad face, shoulder, or d-pad button.
pub enum Pad {
    /// Face A / Cross.
    A,
    /// Face B / Circle.
    B,
    /// Face X / Square.
    X,
    /// Face Y / Triangle.
    Y,
    /// Back / Select.
    Back,
    /// Start.
    Start,
    /// Left bumper.
    LB,
    /// Right bumper.
    RB,
