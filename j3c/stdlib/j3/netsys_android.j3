/// Android j3.netsys. Same pub names as netsys.j3, on bionic libc instead of syscall numbers, so one
/// file serves arm64 and x86_64. The APK asks for `android.permission.INTERNET` (dist/apk.rs).

module j3.netsys;

use j3.sys.{ close, errno, read };
use j3.text.{ Text, cstr };

// `fcntl` is variadic in C; on arm64 and x86_64 Linux a fixed third argument is passed the same way.
use lib "c" as c {
    fn socket(domain: i32, kind: i32, proto: i32): i32;
    fn bind(fd: i32, sa: ptr, len: u32): i32;
    fn sendto(fd: i32, buf: ptr, n: int, flags: i32, sa: ptr, len: u32): int;
    fn recvfrom(fd: i32, buf: ptr, n: int, flags: i32, sa: ptr, len: ptr): int;
    fn getsockname(fd: i32, sa: ptr, len: ptr): i32;
    fn poll(fds: ptr, n: u64, ms: i32): i32;
    fn connect(fd: i32, sa: ptr, len: u32): i32;
    fn listen(fd: i32, backlog: i32): i32;
    fn setsockopt(fd: i32, level: i32, name: i32, val: ptr, len: u32): i32;
    fn getsockopt(fd: i32, level: i32, name: i32, val: ptr, len: ptr): i32;
    fn accept4(fd: i32, sa: ptr, len: ptr, flags: i32): i32;
    fn fcntl(fd: i32, cmd: i32, arg: int): i32;
    fn getaddrinfo(node: cstr, service: ptr, hints: ptr, res: ptr): i32;
    fn freeaddrinfo(res: ptr);
    fn opendir(path: cstr): ptr;
    fn readdir(d: ptr): ptr;
    fn closedir(d: ptr): i32;
}

const MSG_NOSIGNAL: int = 16384;
/// `SOCK_DGRAM` plus `SOCK_NONBLOCK`, so `recvfrom` never waits.
const SOCK_UDP_NONBLOCK: int = 2 + 2048;
/// `SOCK_STREAM` plus `SOCK_CLOEXEC`.
const SOCK_TCP: int = 1 + 524288;
const EAGAIN: int = 11;
const EINTR: int = 4;
const EINPROGRESS: int = 115;
const ECONNREFUSED: int = 111;
const ETIMEDOUT: int = 110;
const SOL_SOCKET: int = 1;
const SO_REUSEADDR: int = 2;
const SO_ERROR: int = 4;
const SO_RCVTIMEO: int = 20;
const SO_SNDTIMEO: int = 21;
const IPPROTO_TCP: int = 6;
const TCP_NODELAY: int = 1;
const F_GETFL: int = 3;
const F_SETFL: int = 4;
const O_NONBLOCK: int = 2048;
const POLLIN: int = 1;
const POLLOUT: int = 4;

/// `recvfrom` result: no datagram is waiting.
pub const NONE: int = 0 - 1;
/// Any call result: the OS refused.
pub const FAIL: int = 0 - 2;
/// TCP result: the wait ran past its timeout.
pub const TIMEOUT: int = 0 - 3;
/// `connectTimeout` result: nothing listens on that port.
pub const REFUSED: int = 0 - 4;
/// `lookup` result: the name does not exist.
pub const NO_NAME: int = 0 - 5;
/// `AF_INET`.
pub const AF_INET: int = 2;
/// `AF_INET6`.
pub const AF_INET6: int = 10;
/// Bytes of the largest socket address `lookup` returns (`sockaddr_in6`).
pub const SA_MAX: int = 28;

/// A new non-blocking IPv4 UDP socket, or a negative number.
pub fn udp(): int {
    return int(c.socket(2, i32(SOCK_UDP_NONBLOCK), 0));
}

/// Stamp the address family into a 16-byte `sockaddr_in` (a u16 at byte 0, little endian).
pub fn family(sa: []u8) {
    sa[0] = 2;
    sa[1] = 0;
}

/// Bind `fd` to the 16-byte `sockaddr_in` at `sa`. Negative on failure.
pub fn bind(fd: int, sa: ptr): int {
    return int(c.bind(i32(fd), sa, u32(16)));
}

/// Send `n` bytes of `buf` to the `sockaddr_in` at `sa`. Bytes sent, or `FAIL`.
pub fn sendto(fd: int, buf: ptr, n: int, sa: ptr): int {
    let r = c.sendto(i32(fd), buf, n, 0, sa, u32(16));
    if r < 0 {
        return FAIL;
    }
    return r;
}

/// Take one datagram into `buf` (cut at `n`) and write the sender to `sa`.
/// Bytes read, `NONE` when nothing is waiting, or `FAIL`.
pub fn recvfrom(fd: int, buf: ptr, n: int, sa: ptr): int {
    let len: u32 = 16;
    let r = c.recvfrom(i32(fd), buf, n, 0, sa, &len as ptr);
    if r < 0 {
        if errno() == EAGAIN {
            return NONE;
        }
        return FAIL;
    }
    return r;
}

/// Write the address `fd` is bound to into `sa`. Negative on failure.
pub fn sockname(fd: int, sa: ptr): int {
    let len: u32 = 16;
    return int(c.getsockname(i32(fd), sa, &len as ptr));
}

/// Close the socket.
pub fn shut(fd: int) {
    close(fd);
}

/// Map a failed call to `TIMEOUT`, `REFUSED`, or `FAIL`.
fn failure(): int {
    let e = errno();
    if e == EAGAIN || e == ETIMEDOUT {
        return TIMEOUT;
    }
    if e == ECONNREFUSED {
        return REFUSED;
    }
    return FAIL;
}

/// A new blocking TCP socket of `family` (`AF_INET` or `AF_INET6`), or `FAIL`.
pub fn tcp(family: int): int {
    let fd = int(c.socket(i32(family), i32(SOCK_TCP), 0));
    if fd < 0 {
        return FAIL;
    }
    return fd;
}

fn setBlocking(fd: int, on: bool) {
    let fl = int(c.fcntl(i32(fd), i32(F_GETFL), 0));
    if fl < 0 {
        return;
    }
    let nb = (fl / O_NONBLOCK) % 2 == 1;
    if on && nb {
        c.fcntl(i32(fd), i32(F_SETFL), fl - O_NONBLOCK);
    } else if !on && !nb {
        c.fcntl(i32(fd), i32(F_SETFL), fl + O_NONBLOCK);
    }
}

/// Wait up to `ms` (negative waits forever) until `fd` can read (`write` false) or write.
/// 1 when ready, `TIMEOUT`, or `FAIL`.
pub fn waitFd(fd: int, write: bool, ms: int): int {
    // struct pollfd { int fd; short events; short revents; }
    let pfd: [2]i32 = [i32(fd), 0];
    let ev = if write { POLLOUT } else { POLLIN };
    let half = &pfd[1] as ptr as &u16;
    *half = u16(ev);
    while true {
        let r = int(c.poll(&pfd[0] as ptr, u64(1), i32(ms)));
        if r > 0 {
            return 1;
        }
        if r == 0 {
            return TIMEOUT;
        }
        if errno() != EINTR {
            return FAIL;
        }
    }
    return FAIL;
}

/// Connect `fd` to the socket address `sa` (`len` bytes), giving up after `ms`.
/// 0, `TIMEOUT`, `REFUSED`, or `FAIL`. The socket is blocking again afterwards.
pub fn connectTimeout(fd: int, sa: ptr, len: int, ms: int): int {
    setBlocking(fd, false);
    let r = int(c.connect(i32(fd), sa, u32(len)));
    if r < 0 {
        if errno() != EINPROGRESS {
            let f = failure();
            setBlocking(fd, true);
            return f;
        }
        let w = waitFd(fd, true, ms);
        if w < 0 {
            setBlocking(fd, true);
            return w;
        }
        let err: i32 = 0;
        let elen: u32 = 4;
        if c.getsockopt(i32(fd), i32(SOL_SOCKET), i32(SO_ERROR), &err as ptr, &elen as ptr) < 0 {
            setBlocking(fd, true);
            return FAIL;
        }
        setBlocking(fd, true);
        if int(err) == ECONNREFUSED {
            return REFUSED;
        }
        if int(err) == ETIMEDOUT {
            return TIMEOUT;
        }
        if err != 0 {
            return FAIL;
        }
        return 0;
    }
    setBlocking(fd, true);
    return 0;
}

/// Make blocking reads and writes on `fd` fail with `TIMEOUT` after `ms` (0 waits forever).
pub fn setTimeouts(fd: int, ms: int) {
    // struct timeval { long sec; long usec; }
    let tv: [2]int = [ms / 1000, (ms % 1000) * 1000];
    c.setsockopt(i32(fd), i32(SOL_SOCKET), i32(SO_RCVTIMEO), &tv[0] as ptr, u32(16));
    c.setsockopt(i32(fd), i32(SOL_SOCKET), i32(SO_SNDTIMEO), &tv[0] as ptr, u32(16));
}

/// Send small writes at once instead of batching them (`TCP_NODELAY`).
pub fn noDelay(fd: int) {
    let on: i32 = 1;
    c.setsockopt(i32(fd), i32(IPPROTO_TCP), i32(TCP_NODELAY), &on as ptr, u32(4));
}

/// Bind `fd` to the IPv4 address `sa` (16 bytes) with `SO_REUSEADDR` and listen. Negative on failure.
pub fn listenOn(fd: int, sa: ptr, backlog: int): int {
    let on: i32 = 1;
    c.setsockopt(i32(fd), i32(SOL_SOCKET), i32(SO_REUSEADDR), &on as ptr, u32(4));
    if c.bind(i32(fd), sa, u32(16)) < 0 {
        return FAIL;
    }
    if c.listen(i32(fd), i32(backlog)) < 0 {
        return FAIL;
    }
    return 0;
}

/// Wait for one connection on the listening `fd`. The new socket, or `FAIL`.
pub fn accept(fd: int): int {
    while true {
        let r = int(c.accept4(i32(fd), 0, 0, i32(524288)));
        if r >= 0 {
            return r;
        }
        if errno() != EINTR {
            return failure();
        }
    }
    return FAIL;
}

/// Read up to `n` bytes. Bytes read, 0 at end of stream, `TIMEOUT`, or `FAIL`.
pub fn recv(fd: int, buf: ptr, n: int): int {
    while true {
        let r = read(fd, buf, n);
        if r >= 0 {
            return r;
        }
        if errno() != EINTR {
            return failure();
        }
    }
    return FAIL;
}

/// Write up to `n` bytes (no `SIGPIPE` on a closed peer). Bytes written, `TIMEOUT`, or `FAIL`.
pub fn send(fd: int, buf: ptr, n: int): int {
    while true {
        let r = c.sendto(i32(fd), buf, n, i32(MSG_NOSIGNAL), 0, u32(0));
        if r >= 0 {
            return r;
        }
        if errno() != EINTR {
            return failure();
        }
    }
    return FAIL;
}

/// Resolve `host` (a name or a numeric address) for TCP. Copies up to `max` socket addresses into
/// `out` (`SA_MAX` bytes each), their lengths into `lens` and families into `fams`.
/// The count found, `NO_NAME`, or `FAIL`. Blocks; call it off the frame thread.
pub fn lookup(host: cstr, port: int, out: []u8, lens: []int, fams: []int, max: int): int {
    // struct addrinfo hints: ai_flags@0 ai_family@4 ai_socktype@8 ai_protocol@12 ... 48 bytes
    let hints: [6]int = [0, 0, 0, 0, 0, 0];
    let st = ((&hints[0] as int) + 8) as ptr as &i32;
    *st = 1;
    let res: ptr = 0;
    let r = int(c.getaddrinfo(host, 0, &hints[0] as ptr, &res as ptr));
    if r != 0 {
        // bionic EAI_NODATA 7, EAI_NONAME 8 (BSD numbering, unlike glibc)
        if r == 7 || r == 8 {
            return NO_NAME;
        }
        return FAIL;
    }
    let n = 0;
    let ai = res as int;
    while ai != 0 && n < max {
        // bionic order: ai_canonname@24 before ai_addr@32 (glibc has them swapped)
        let pfam = (ai + 4) as ptr as &i32;
        let plen = (ai + 16) as ptr as &u32;
        let paddr = (ai + 32) as ptr as &int;
        let pnext = (ai + 40) as ptr as &int;
        let fam = int(*pfam);
        let alen = int(*plen);
        let addr = *paddr;
        if (fam == AF_INET || fam == AF_INET6) && alen <= SA_MAX && addr != 0 {
            let src: []u8 = @slice(addr as ptr, alen);
            for i in 0..SA_MAX {
                out[n * SA_MAX + i] = if i < alen { src[i] } else { 0 };
            }
            // the port is big-endian at bytes 2..3 in both sockaddr_in and sockaddr_in6
            out[n * SA_MAX + 2] = u8(port / 256);
            out[n * SA_MAX + 3] = u8(port % 256);
            lens[n] = alen;
            fams[n] = fam;
            n += 1;
        }
        ai = *pnext;
    }
    c.freeaddrinfo(res);
    return n;
}

/// Append the path of every trusted root certificate file to `t`, each ending in a 0 byte, and
/// return how many. Android keeps them one PEM per file in a folder whose file names use OpenSSL's
/// old hash, which OpenSSL 3 cannot look up, so `j3.net.tls` loads each file instead.
pub fn caFiles(t: &Text): int {
    // Android 14+ updates the store through the Conscrypt module; older ones only have /system
    let dir = "/apex/com.android.conscrypt/cacerts";
    let d = c.opendir(cstr(dir));
    if d as int == 0 {
        dir = "/system/etc/security/cacerts";
        d = c.opendir(cstr(dir));
    }
    if d as int == 0 {
        return 0;
    }
    let n = 0;
    while true {
        let e = c.readdir(d) as int;
        if e == 0 {
            break;
        }
        // struct dirent: d_ino@0 d_off@8 d_reclen@16 d_type@18 d_name@19
        let name = (e + 19) as ptr as &u8;
        if *name == 46 {
            continue;
        }
        t.pushStr(dir);
        t.push(47);
        let nm: []u8 = @slice((e + 19) as ptr, 256);
        let k = 0;
        while k < 256 && nm[k] != 0 {
            t.push(nm[k]);
            k += 1;
        }
        t.push(0);
        n += 1;
    }
    c.closedir(d);
    return n;
}

