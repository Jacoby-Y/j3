/// Named slot. No Default / traits: empty needs a dummy value.

module j3.res;

/// A value that may be empty. Empty still stores a dummy `T`.
pub struct Slot<T> {
    /// True after `of` or `put`, false after `none` or `take`.
    ok: bool;
    /// The stored value, including the dummy while empty.
    val: T;

    /// A filled slot.
    fn of(v: T): Slot<T> {
        return Slot<T> { ok: true, val: v };
    }

    /// An empty slot holding `dummy` so `T` need not be optional.
    fn none(dummy: T): Slot<T> {
        return Slot<T> { ok: false, val: dummy };
    }

    /// Store `v` and mark the slot filled.
    fn put(this: &Slot<T>, v: T) {
        this.ok = true;
        this.val = v;
    }

    /// The stored value. Does not check `ok`.
    fn get(this: &Slot<T>): T {
        return this.val;
    }

    /// True when the slot holds a real value.
    fn ready(this: &Slot<T>): bool {
        return this.ok;
    }

    /// Return the value and mark the slot empty. The dummy stays in `val`.
    fn take(this: &Slot<T>): T {
        this.ok = false;
        return this.val;
    }
}
