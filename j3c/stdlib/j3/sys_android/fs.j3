// More of `j3.sys`: the Linux-only calls of `sys/fs.j3` (fsync, flock, rmdir, pidfd, realpath).
// Not on this target yet: each returns `-ENOSYS` (-38), so `j3.io` reports `IoError.Other`.

module j3.sys;

/// `open` flag with `O_CREAT`: fail when the file is already there.
pub const O_EXCL: int = 128;
/// `flock` operations: shared, exclusive, don't block (or it in), unlock.
pub const LOCK_SH: int = 1;
pub const LOCK_EX: int = 2;
pub const LOCK_NB: int = 4;
pub const LOCK_UN: int = 8;
/// `errno` values the io layer tells apart.
pub const EINTR: int = 4;
pub const EEXIST: int = 17;
pub const EWOULDBLOCK: int = 11;

/// Not on this target yet: -38.
pub fn fsync(fd: int): int { return -38; }
/// Not on this target yet: -38.
pub fn flock(fd: int, op: int): int { return -38; }
/// Not on this target yet: -38.
pub fn rmdir(path: ptr): int { return -38; }
/// Not on this target yet: -38.
pub fn pidfdOpen(pid: int): int { return -38; }
/// Not on this target yet: -38.
pub fn realpathTo(path: ptr, out: []u8): int { return -38; }

/// The working directory written to `out`, no NUL: its length, or a negative error (libc `getcwd`).
pub fn cwd(out: []u8): int {
    if out.len == 0 || c.getcwd(out.ptr as ptr, out.len) as int == 0 {
        return -34;
    }
    let n = 0;
    while n < out.len && out[n] != 0 {
        n += 1;
    }
    return n;
}
