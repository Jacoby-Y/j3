/// Heap is mmap'd chunks. Grow adds a block (old pointers stay valid).
/// Keep the Arena header in one `let`; pass `&Arena`. Scratch is frame-local.
/// Not shared between threads: give each thread its own `Arena`. `scratch` is per thread, and a
/// pool worker rewinds it after every job (`j3c doc threads`).

module j3.memory;

use j3.sys.{ mmapAnon, munmap, panic };

/// Bytes stored in front of each mmap chunk (next pointer, then capacity).
const HDR: int = 16;

/// Frame-local arena. `rewindScratch` resets it. One per thread.
#[singleton]
#[thread]
let SCRATCH: Arena = Arena { ptr: 0, used: 0, cap: 0, head: 0 };

/// Work counters: process-wide tallies a library bumps (`j3.ui.dom`: boxes laid out, styles recomputed) and `j3.app`
/// reads for `J3_STEADY`. They live here because `j3.app` cannot import `j3.ui` (that would link the UI into every app)
/// and `j3.memory` is the one module both already import. Whole-program release builds inline the calls.
#[singleton]
let STEADY_LAID: int;
#[singleton]
let STEADY_RESTYLED: int;

/// Dom counters: one box laid out / one style recomputed.
pub fn countLaid() { STEADY_LAID += 1; }
pub fn countRestyled() { STEADY_RESTYLED += 1; }
pub fn laidTotal(): int { return STEADY_LAID; }
pub fn restyledTotal(): int { return STEADY_RESTYLED; }

/// Bump allocator over one or more mmap'd chunks; old pointers stay valid across grow.
pub struct Arena {
    /// Current chunk payload start (after the 16-byte header).
    ptr: ptr;
    /// Bytes used in the current chunk.
    used: int;
    /// Capacity of the current chunk payload.
    cap: int;
    /// Linked list of mmap blocks (0 if never grown / destroyed).
    head: ptr;

    /// mmap a new arena with at least `cap` bytes (minimum 64).
    fn create(cap: int): Arena {
        let n = cap;
        if n < 64 {
            n = 64;
        }
        let raw = mmapAnon(n + HDR);
        if raw == 0 {
            panic("Arena.create");
        }
        let hdr: []int = @slice(raw, 2);
        hdr[0] = 0;
        hdr[1] = n;
        return Arena {
            ptr: (raw as int + HDR) as ptr,
            used: 0,
            cap: n,
            head: raw,
        };
    }

    /// Unmap every chunk and clear the arena fields.
    fn destroy(this: &Arena) {
        let b = this.head;
        if b == 0 {
            if this.ptr != 0 {
                munmap(this.ptr, this.cap);
            }
        } else {
            while b != 0 {
                let hdr: []int = @slice(b, 2);
                let next = hdr[0] as ptr;
                let cap = hdr[1];
                munmap(b, cap + HDR);
                b = next;
            }
        }
        this.ptr = 0;
        this.used = 0;
        this.cap = 0;
        this.head = 0;
    }

    /// Snapshot of `used` for a later `rewind`.
    fn checkpoint(this: &Arena): int {
        return this.used;
    }

    /// Restore `used` to a prior checkpoint (does not free mmap blocks).
    fn rewind(this: &Arena, used: int) {
        this.used = used;
    }

    /// Append a larger mmap block and reset bump into it; prior pointers remain valid.
    fn grow(this: &Arena, need: int) {
        let n = this.cap * 2;
        if n < need {
            n = need;
        }
        if n < 64 {
            n = 64;
        }
        let raw = mmapAnon(n + HDR);
        if raw == 0 {
            panic("Arena.grow");
        }
        let hdr: []int = @slice(raw, 2);
        hdr[0] = 0;
        hdr[1] = n;
        if this.head == 0 {
            this.head = raw;
        } else {
            let b = this.head;
            while true {
                let h: []int = @slice(b, 2);
                if h[0] == 0 {
                    h[0] = raw as int;
                    break;
                }
                b = h[0] as ptr;
            }
        }
        this.ptr = (raw as int + HDR) as ptr;
        this.used = 0;
        this.cap = n;
    }

    /// Bump-allocate `n` bytes at an 8-aligned address, growing if needed; panics on negative `n`.
    /// Alignment matters: pthread mutexes/condvars (`j3.thread`) fail in futex at odd addresses.
    fn allocBytes(this: &Arena, n: int): ptr {
        return this.allocAligned(n, 8);
    }

    /// Like `allocBytes` at an `align`-aligned address (a power of two up to 16; blocks start 16-aligned).
    fn allocAligned(this: &Arena, n: int, align: int): ptr {
        if n < 0 {
            panic("Arena.allocBytes");
        }
        let start = (this.used + align - 1) / align * align;
        if start + n > this.cap {
            this.grow(n);
            start = 0;
        }
        this.used = start + n;
        return (this.ptr as int + start) as ptr;
    }

    /// Allocate space for `n` elements of `T` and return them as a slice. Types whose size is a
    /// multiple of 16 (`vec4f`, structs holding one) start 16-aligned.
    fn alloc<T>(this: &Arena, n: int): []T {
        let bytes = n * @sizeof(T);
        let p = this.allocAligned(bytes, if @sizeof(T) % 16 == 0 { 16 } else { 8 });
        return @slice(p, n);
    }
}

/// A new arena of at least `cap` bytes. Same as `Arena.create`.
/// A script file named `arena.j3s` cannot import the type `Arena`, so it calls this.
pub fn newArena(cap: int): Arena {
    return Arena.create(cap);
}

/// Process-wide scratch arena; creates it on first use with the given capacity.
pub fn scratch(cap: int): &Arena {
    if SCRATCH.ptr == 0 {
        SCRATCH = Arena.create(cap);
    }
    return &SCRATCH;
}

/// Reset the scratch arena's bump cursor to zero (keeps the mmap).
pub fn rewindScratch() {
    if SCRATCH.ptr != 0 {
        SCRATCH.used = 0;
    }
}

/// Unmap this thread's scratch arena. `j3.thread` calls it when a thread ends.
pub fn freeScratch() {
    if SCRATCH.ptr != 0 {
        SCRATCH.destroy();
    }
}

/// Set by dev builds of script programs (`j3.script`); run once per frame by `frameHook`.
#[singleton]
let FRAME_HOOK: fn();

/// Run `hook` at every frame boundary (`j3.app` calls `frameHook` each frame).
pub fn setFrameHook(hook: fn()) {
    FRAME_HOOK = hook;
}

/// Run the frame hook, if one is set. A program without `j3.app` calls this in its loop.
pub fn frameHook() {
    let hook = FRAME_HOOK;
    if hook as ptr != 0 as ptr {
        hook();
    }
}

/// Growable contiguous list backed by an arena (old buffers are abandoned, not freed).
pub struct List<T> {
    /// Storage slice (length is capacity).
    items: []T;
    /// Number of live elements.
    len: int;
    /// Arena used for reallocation.
    arena: &Arena;

    /// Empty list allocated from `arena`.
    fn new(arena: &Arena): List<T> {
        return List<T> {
            items: arena.alloc::<T>(0),
            len: 0,
            arena: arena,
        };
    }

    /// Append `item`, doubling capacity from 0→4 then ×2 as needed.
    fn push(this: &List<T>, item: T) {
        if this.len >= this.items.len {
            let cap = this.items.len;
            let next_cap = if cap == 0 { 4 } else { cap * 2 };
            let next = this.arena.alloc::<T>(next_cap);
            for i in 0..this.len {
                next[i] = this.items[i];
            }
            this.items = next;
        }
        this.items[this.len] = item;
        this.len += 1;
    }

    /// Remove element `i`, keeping the order of the rest. Out of range is a no-op.
    fn remove(this: &List<T>, i: int) {
        if i < 0 || i >= this.len { return; }
        for j in i..this.len - 1 {
            this.items[j] = this.items[j + 1];
        }
        this.len -= 1;
    }

    /// Remove element `i` by moving the last element into its place (O(1), order changes).
    fn swapRemove(this: &List<T>, i: int) {
        if i < 0 || i >= this.len { return; }
        this.items[i] = this.items[this.len - 1];
        this.len -= 1;
    }
}
