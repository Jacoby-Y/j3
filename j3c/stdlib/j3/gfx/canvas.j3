/// Rasterization and texture filtering style.
pub enum Mode {
    Pixel, Smooth
}

/// Straight-alpha RGBA color; channels are 0..255.
pub struct Color {
    r : u8;
    g : u8;
    b : u8;
    a : u8;
}

/// Opaque color.
pub fn rgb(r : u8, g : u8, b : u8) : Color {
    return Color {
        r : r, g : g, b : b, a : 255
    };
}

/// Color with alpha.
pub fn rgba(r : u8, g : u8, b : u8, a : u8) : Color {
    return Color {
        r : r, g : g, b : b, a : a
    };
}

/// A mutable, tightly packed RGBA8 image. Pixels are top row first.
pub struct Canvas {
    pixels :[] u8;
    w : i32;
    h : i32;
    mode : Mode;

    /// Allocate one 8-byte-aligned image buffer. Maximum is 268,435,455 pixels.
    fn create(arena : &Arena, w : i32, h : i32, mode : Mode) : Canvas {
        if w < 1 || h < 1 || int(w) *int(h) > 268435455 {
            panic("Canvas.create: invalid size");
        }
        let count = int(w) *int(h) *4;
        let raw = arena.alloc::< u8 >(count + 7);
        let base =(raw.ptr as ptr) as int;
        let aligned =((base + 7) / 8) *8;
        let bytes :[] u8 = @slice(aligned as ptr, count);
        let c = Canvas {
            pixels : bytes, w : w, h : h, mode : mode
        };
        c.clear(rgba(0, 0, 0, 0));
        return c;
    }

    /// Replace every pixel, including alpha.
    fn clear(this : &Canvas, color : Color) {
        let words :[] u64 = @slice(this.pixels.ptr as ptr, this.pixels.len / 8);
        let packed = pack64(color);
        let i = 0;
        while i < words.len {
            words[i] = packed;
            i += 1;
        }
        if (this.pixels.len / 4) -((this.pixels.len / 8) *2) != 0 {
            let tail :[] u32 = @slice(this.pixels.ptr as ptr, this.pixels.len / 4);
            tail[tail.len -1] = pack(color);
        }
    }

    /// Composite one pixel. Out-of-bounds coordinates are ignored.
    fn pixel(this : &Canvas, x : i32, y : i32, color : Color) {
        if x < 0 || y < 0 || x >= this.w || y >= this.h {
            return;
        }
        blend(this.pixels,(int(y) *int(this.w) + int(x)) *4, color, 255);
    }

    /// Fill a clipped rectangle; opaque colors use a direct row loop.
    fn fillRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, color : Color) {
        if w <= 0 || h <= 0 || color.a == 0 {
            return;
        }
        let x0 = int(x);
        let y0 = int(y);
        let x1 = int(x) + int(w);
        let y1 = int(y) + int(h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        if x0 >= x1 || y0 >= y1 {
            return;
        }
        let words :[] u32 = @slice(this.pixels.ptr as ptr, this.pixels.len / 4);
        let pairs :[] u64 = @slice(this.pixels.ptr as ptr, this.pixels.len / 8);
        let packed = pack(color);
        let packedPair = pack64(color);
        let row = int(y0);
        while row < y1 {
            if color.a == 255 {
                let wi = row *int(this.w) + int(x0);
                let wend = row *int(this.w) + x1;
                if wi < wend && wi -(wi / 2) *2 != 0 {
                    words[wi] = packed;
                    wi += 1;
                }
                while wi + 1 < wend {
                    pairs[wi / 2] = packedPair;
                    wi += 2;
                }
                if wi < wend {
                    words[wi] = packed;
                }
            } else {
                let i =(row *int(this.w) + int(x0)) *4;
                let end =(row *int(this.w) + x1) *4;
                while i < end {
                    blend(this.pixels, i, color, 255);
                    i += 4;
                }
            }
            row += 1;
        }
    }

    /// Draw a rectangle border inward from its edges.
    fn strokeRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, thick : i32, color : Color) {
        if thick <= 0 || w <= 0 || h <= 0 {
            return;
        }
        if int(thick) *2 >= int(w) || int(thick) *2 >= int(h) {
            this.fillRect(x, y, w, h, color);
            return;
        }
        let t = thick;
        if t > w / 2 {
            t = w / 2;
        }
        if t > h / 2 {
            t = h / 2;
        }
        if t < 1 {
            t = 1;
        }
        this.fillRect(x, y, w, t, color);
        this.fillRect(x, y + h -t, w, t, color);
        this.fillRect(x, y + t, t, h -t *2, color);
        this.fillRect(x + w -t, y + t, t, h -t *2, color);
    }

    /// Fill a circle. Pixel mode uses exact coverage; smooth mode softens the edge.
    fn fillCircle(this : &Canvas, cx : f32, cy : f32, radius : f32, color : Color) {
        circle(this, cx, cy, radius, f32(0), color);
    }

    /// Draw a circle border of `thick` pixels.
    fn strokeCircle(this : &Canvas, cx : f32, cy : f32, radius : f32, thick : f32, color : Color) {
        if thick <= 0 {
            return;
        }
        circle(this, cx, cy, radius, thick, color);
    }

    /// Draw a line with round caps and a positive thickness.
    fn line(this : &Canvas, ax : f32, ay : f32, bx : f32, by : f32, thick : f32, color : Color) {
        if thick <= 0 || color.a == 0 {
            return;
        }
        let half = thick *f32(0.5);
        let x0 = i32(ax -half -f32(1));
        let y0 = i32(ay -half -f32(1));
        let x1 = i32(bx + half + f32(2));
        let y1 = i32(by + half + f32(2));
        if bx < ax {
            x0 = i32(bx -half -f32(1));
            x1 = i32(ax + half + f32(2));
        }
        if by < ay {
            y0 = i32(by -half -f32(1));
            y1 = i32(ay + half + f32(2));
        }
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > this.w {
            x1 = this.w;
        }
        if y1 > this.h {
            y1 = this.h;
        }
        let dx = bx -ax;
        let dy = by -ay;
        let len2 = dx *dx + dy *dy;
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let px = f32(x) + f32(0.5);
                let py = f32(y) + f32(0.5);
                let t : f32 = 0;
                if len2 > 0 {
                    t = clamp(((px -ax) *dx +(py -ay) *dy) / len2, 0, 1);
                }
                let ex = px -(ax + t *dx);
                let ey = py -(ay + t *dy);
                let dist2 = ex *ex + ey *ey;
                let cov = 0;
                if this.mode == Mode.Pixel {
                    if dist2 <= half *half {
                        cov = 255;
                    }
                } else if dist2 <(half + f32(0.5)) *(half + f32(0.5)) {
                    if half >= f32(0.5) && dist2 <=(half -f32(0.5)) *(half -f32(0.5)) {
                        cov = 255;
                    } else {
                        cov = coverage(this.mode, half -sqrt(dist2));
                    }
                }
                if cov > 0 {
                    blend(this.pixels,(int(y) *int(this.w) + int(x)) *4, color, cov);
                }
                x += 1;
            }
            y += 1;
        }
    }

    /// Fill a triangle, clipping to the image. Smooth mode antialiases edges.
    fn fillTriangle(this : &Canvas, ax : f32, ay : f32, bx : f32, by : f32, cx : f32, cy : f32, color : Color) {
        if color.a == 0 {
            return;
        }
        let area = edge(ax, ay, bx, by, cx, cy);
        if area == 0 {
            return;
        }
        let minx = ax;
        if bx < minx {
            minx = bx;
        }
        if cx < minx {
            minx = cx;
        }
        let maxx = ax;
        if bx > maxx {
            maxx = bx;
        }
        if cx > maxx {
            maxx = cx;
        }
        let miny = ay;
        if by < miny {
            miny = by;
        }
        if cy < miny {
            miny = cy;
        }
        let maxy = ay;
        if by > maxy {
            maxy = by;
        }
        if cy > maxy {
            maxy = cy;
        }
        let x0 = i32(minx -f32(1));
        let x1 = i32(maxx + f32(2));
        let y0 = i32(miny -f32(1));
        let y1 = i32(maxy + f32(2));
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > this.w {
            x1 = this.w;
        }
        if y1 > this.h {
            y1 = this.h;
        }
        let sign : f32 = 1;
        if area < 0 {
            sign = -1;
        }
        let len0 : f32 = 1;
        let len1 : f32 = 1;
        let len2 : f32 = 1;
        if this.mode == Mode.Smooth {
            len0 = sqrt((bx -ax) *(bx -ax) +(by -ay) *(by -ay));
            len1 = sqrt((cx -bx) *(cx -bx) +(cy -by) *(cy -by));
            len2 = sqrt((ax -cx) *(ax -cx) +(ay -cy) *(ay -cy));
        }
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let px = f32(x) + f32(0.5);
                let py = f32(y) + f32(0.5);
                let e0 = edge(ax, ay, bx, by, px, py) *sign;
                let e1 = edge(bx, by, cx, cy, px, py) *sign;
                let e2 = edge(cx, cy, ax, ay, px, py) *sign;
                let cov = 255;
                if this.mode == Mode.Pixel {
                    if e0 < 0 || e1 < 0 || e2 < 0 {
                        cov = 0;
                    }
                } else {
                    let d0 = e0 / len0;
                    let d1 = e1 / len1;
                    let d2 = e2 / len2;
                    let d = d0;
                    if d1 < d {
                        d = d1;
                    }
                    if d2 < d {
                        d = d2;
                    }
                    cov = coverage(this.mode, d);
                }
                if cov > 0 {
                    blend(this.pixels,(int(y) *int(this.w) + int(x)) *4, color, cov);
                }
                x += 1;
            }
            y += 1;
        }
    }

    /// Fill an axis-aligned rectangle with a horizontal or vertical gradient.
    fn gradientRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, start : Color, end : Color, vertical : bool) {
        if w <= 0 || h <= 0 {
            return;
        }
        let x0 = int(x);
        let y0 = int(y);
        let x1 = int(x) + int(w);
        let y1 = int(y) + int(h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        if x0 >= x1 || y0 >= y1 {
            return;
        }
        let verticalSpan = int(h) -1;
        let horizontalSpan = int(w) -1;
        if verticalSpan < 1 {
            verticalSpan = 1;
        }
        if horizontalSpan < 1 {
            horizontalSpan = 1;
        }
        let yy = int(y0);
        while yy < y1 {
            let rowColor = start;
            if vertical {
                rowColor = mix(start, end, yy -int(y), verticalSpan);
            }
            let xx = int(x0);
            while xx < x1 {
                let shade = rowColor;
                if !vertical {
                    shade = mix(start, end, xx -int(x), horizontalSpan);
                }
                blend(this.pixels,(yy *int(this.w) + xx) *4, shade, 255);
                xx += 1;
            }
            yy += 1;
        }
    }

    /// Deterministic two-color noise. `cell` controls block size (minimum 1).
    fn noiseRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, seed : u32, cell : i32, low : Color, high : Color) {
        if w <= 0 || h <= 0 {
            return;
        }
        let step = cell;
        if step < 1 {
            step = 1;
        }
        let x0 = int(x);
        let y0 = int(y);
        let x1 = int(x) + int(w);
        let y1 = int(y) + int(h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        if x0 >= x1 || y0 >= y1 {
            return;
        }
        if step > 1 {
            let cellY =((y0 -int(y)) / int(step)) *int(step);
            while int(y) + cellY < y1 {
                let cellX =((x0 -int(x)) / int(step)) *int(step);
                let cellH = int(step);
                if cellY + cellH > int(h) {
                    cellH = int(h) -cellY;
                }
                while int(x) + cellX < x1 {
                    let cellW = int(step);
                    if cellX + cellW > int(w) {
                        cellW = int(w) -cellX;
                    }
                    let cellNx = u32(cellX / int(step));
                    let cellNy = u32(cellY / int(step));
                    let cellValue = hash(seed + cellNx *u32(374761393) + cellNy *u32(668265263));
                    let cellShade = cellValue -(cellValue / u32(256)) *u32(256);
                    this.fillRect(i32(int(x) + cellX), i32(int(y) + cellY), i32(cellW), i32(cellH), mix(low, high, int(cellShade), 255));
                    cellX += int(step);
                }
                cellY += int(step);
            }
            return;
        }
        let yy = int(y0);
        while yy < y1 {
            let xx = int(x0);
            while xx < x1 {
                let nx = u32((xx -int(x)) / int(step));
                let ny = u32((yy -int(y)) / int(step));
                let v = hash(seed + nx *u32(374761393) + ny *u32(668265263));
                let shade = v -(v / u32(256)) *u32(256);
                blend(this.pixels,(yy *int(this.w) + xx) *4, mix(low, high, int(shade), 255), 255);
                xx += 1;
            }
            yy += 1;
        }
    }

    /// Composite a source image at an integer destination. Source must be distinct.
    fn blit(this : &Canvas, source : Canvas, dx : i32, dy : i32) {
        if this.pixels.ptr == source.pixels.ptr {
            panic("Canvas.blit: source aliases destination");
        }
        let x0 = int(dx);
        let y0 = int(dy);
        let x1 = int(dx) + int(source.w);
        let y1 = int(dy) + int(source.h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let si =((y -int(dy)) *int(source.w) + x -int(dx)) *4;
                let a = source.pixels[si + 3];
                if a > 0 {
                    let c = rgba(source.pixels[si], source.pixels[si + 1], source.pixels[si + 2], a);
                    blend(this.pixels,(y *int(this.w) + x) *4, c, 255);
                }
                x += 1;
            }
            y += 1;
        }
    }

    /// Export RGBA8 PNG. Uses stored DEFLATE blocks for fast, dependency-free writing.
    fn savePng(this : Canvas, path : string, arena : &Arena) : Result < int, IoError > {
        let row = int(this.w) *4 + 1;
        let raw = row *int(this.h);
        let blocks =(raw + 65534) / 65535;
        let zlen = 2 + raw + blocks *5 + 4;
        let out = arena.alloc::< u8 >(57 + zlen);
        out[0] = 137;
        out[1] = 80;
        out[2] = 78;
        out[3] = 71;
        out[4] = 13;
        out[5] = 10;
        out[6] = 26;
        out[7] = 10;
        be32(out, 8, u32(13));
        chunkType(out, 12, 73, 72, 68, 82);
        be32(out, 16, u32(this.w));
        be32(out, 20, u32(this.h));
        out[24] = 8;
        out[25] = 6;
        out[26] = 0;
        out[27] = 0;
        out[28] = 0;
        be32(out, 29, crc(out, 12, 17));
        be32(out, 33, u32(zlen));
        chunkType(out, 37, 73, 68, 65, 84);
        let at = 41;
        out[at] = 120;
        out[at + 1] = 1;
        at += 2;
        let a : u32 = 1;
        let b : u32 = 0;
        let remaining = raw;
        let source = 0;
        while remaining > 0 {
            let count = remaining;
            if count > 65535 {
                count = 65535;
            }
            out[at] = 0;
            if count == remaining {
                out[at] = 1;
            }
            out[at + 1] = u8(count -(count / 256) *256);
            out[at + 2] = u8(count / 256);
            out[at + 3] = u8((65535 -count) -((65535 -count) / 256) *256);
            out[at + 4] = u8((65535 -count) / 256);
            at += 5;
            let n = 0;
            while n < count {
                let offset = source + n;
                let col = offset -(offset / row) *row;
                let value : u8 = 0;
                if col > 0 {
                    value = this.pixels[(offset / row) *int(this.w) *4 + col -1];
                }
                out[at] = value;
                at += 1;
                a = a + u32(value);
                if a >= u32(65521) {
                    a -= u32(65521);
                }
                b = b + a;
                if b >= u32(65521) {
                    b -= u32(65521);
                }
                n += 1;
            }
            source += count;
            remaining -= count;
        }
        be32(out, at, b *u32(65536) + a);
        at += 4;
        be32(out, at, crc(out, 37, zlen + 4));
        at += 4;
        be32(out, at, u32(0));
        at += 4;
        chunkType(out, at, 73, 69, 78, 68);
        at += 4;
        be32(out, at, crc(out, at -4, 4));
        match writeFile(path, out) {
            Result.Ok(written) {
                return Result.Ok(written);
            }
            Result.Err(e) {
                return Result.Err(e);
            }
        }
    }
}

/// One native word containing RGBA bytes on J3's little-endian targets.
fn pack(color : Color) : u32 {
    return u32(color.r) + u32(color.g) *u32(256) + u32(color.b) *u32(65536) + u32(color.a) *u32(16777216);
}

fn pack64(color : Color) : u64 {
    let value = u64(pack(color));
    return value + value *u64(4294967296);
}

fn blend(pixels :[] u8, i : int, color : Color, coverage : int) {
    let sa =(int(color.a) *coverage + 127) / 255;
    if sa == 0 {
        return;
    }
    if sa == 255 || pixels[i + 3] == 0 {
        pixels[i] = color.r;
        pixels[i + 1] = color.g;
        pixels[i + 2] = color.b;
        pixels[i + 3] = u8(sa);
        return;
    }
    let da = int(pixels[i + 3]);
    let tail =(da *(255 -sa) + 127) / 255;
    let oa = sa + tail;
    pixels[i] = u8((int(color.r) *sa + int(pixels[i]) *tail + oa / 2) / oa);
    pixels[i + 1] = u8((int(color.g) *sa + int(pixels[i + 1]) *tail + oa / 2) / oa);
    pixels[i + 2] = u8((int(color.b) *sa + int(pixels[i + 2]) *tail + oa / 2) / oa);
    pixels[i + 3] = u8(oa);
}

fn coverage(mode : Mode, distance : f32) : int {
    if mode == Mode.Pixel {
        if distance >= 0 {
            return 255;
        }
        return 0;
    }
    let v = clamp(distance + f32(0.5), 0, 1);
    return int(v *f32(255) + f32(0.5));
}

fn circle(c : &Canvas, cx : f32, cy : f32, radius : f32, thick : f32, color : Color) {
    if radius <= 0 || color.a == 0 {
        return;
    }
    let x0 = i32(cx -radius -f32(1));
    let x1 = i32(cx + radius + f32(2));
    let y0 = i32(cy -radius -f32(1));
    let y1 = i32(cy + radius + f32(2));
    if x0 < 0 {
        x0 = 0;
    }
    if y0 < 0 {
        y0 = 0;
    }
    if x1 > c.w {
        x1 = c.w;
    }
    if y1 > c.h {
        y1 = c.h;
    }
    let inner = radius -thick;
    if inner < 0 {
        inner = 0;
    }
    let y = y0;
    while y < y1 {
        let x = x0;
        while x < x1 {
            let dx = f32(x) + f32(0.5) -cx;
            let dy = f32(y) + f32(0.5) -cy;
            let dist2 = dx *dx + dy *dy;
            let cov = 0;
            if c.mode == Mode.Pixel {
                if dist2 <= radius *radius &&(thick <= 0 || dist2 >= inner *inner) {
                    cov = 255;
                }
            } else if dist2 <(radius + f32(0.5)) *(radius + f32(0.5)) {
                if thick <= 0 && radius >= f32(0.5) && dist2 <=(radius -f32(0.5)) *(radius -f32(0.5)) {
                    cov = 255;
                } else {
                    let dist = sqrt(dist2);
                    cov = coverage(c.mode, radius -dist);
                    if thick > 0 {
                        let ic = coverage(c.mode, dist -inner);
                        if ic < cov {
                            cov = ic;
                        }
                    }
                }
            }
            if cov > 0 {
                blend(c.pixels,(int(y) *int(c.w) + int(x)) *4, color, cov);
            }
            x += 1;
        }
        y += 1;
    }
}

fn edge(ax : f32, ay : f32, bx : f32, by : f32, px : f32, py : f32) : f32 {
    return(bx -ax) *(py -ay) -(by -ay) *(px -ax);
}

fn mix(a : Color, b : Color, n : int, span : int) : Color {
    let inv = span -n;
    return rgba(
    u8((int(a.r) *inv + int(b.r) *n) / span),
    u8((int(a.g) *inv + int(b.g) *n) / span),
    u8((int(a.b) *inv + int(b.b) *n) / span),
    u8((int(a.a) *inv + int(b.a) *n) / span),
    );
}

fn hash(v : u32) : u32 {
    let x = v;
    x = x *u32(1664525) + u32(1013904223);
    x = x *u32(22695477) + u32(1);
    return x;
}

fn be32(out :[] u8, i : int, value : u32) {
    out[i] = u8(value / u32(16777216));
    out[i + 1] = u8((value / u32(65536)) -(value / u32(16777216)) *u32(256));
    out[i + 2] = u8((value / u32(256)) -(value / u32(65536)) *u32(256));
    out[i + 3] = u8(value -(value / u32(256)) *u32(256));
}

fn chunkType(out :[] u8, i : int, a : u8, b : u8, c : u8, d : u8) {
    out[i] = a;
    out[i + 1] = b;
    out[i + 2] = c;
    out[i + 3] = d;
}

fn crc(bytes :[] u8, start : int, len : int) : u32 {
    let value : u32 = u32(0xffffffff);
    let i = start;
    while i < start + len {
        let low = value -(value / u32(256)) *u32(256);
        let index = int(xor32(low, u32(bytes[i])));
        value = xor32(value / u32(256), CRC_TABLE[index]);
        i += 1;
    }
    return xor32(value, u32(0xffffffff));
}

fn xor32(a : u32, b : u32) : u32 {
    let left = a;
    let right = b;
    let power : u32 = 1;
    let value : u32 = 0;
    let n = 0;
    while n < 8 {
        let al = left -(left / u32(16)) *u32(16);
        let bl = right -(right / u32(16)) *u32(16);
        value += u32(XOR4[int(al *u32(16) + bl)]) *power;
        left = left / u32(16);
        right = right / u32(16);
        power *= u32(16);
        n += 1;
    }
    return value;
}

/// Decode an 8-bit, non-interlaced PNG (gray, RGB, palette, gray+alpha, RGBA) to RGBA8.
/// Returns a canvas with `w == 0` when the bytes are not one of those. The Rust side
/// (`j3c/src/png.rs` `decode`) is the same algorithm; fix both together.
// ponytail: CRC and Adler aren't checked; 16-bit, interlaced, and low-bit-depth PNGs give w == 0.
pub fn decodePng(bytes :[] u8, arena : &Arena) : Canvas {
    // Only the pixels land in `arena`; the zlib stream and raw rows are freed here.
    let tmp = Arena.create(65536);
    let c = decodeWith(bytes, arena, &tmp);
    tmp.destroy();
    return c;
}

fn decodeWith(bytes :[] u8, arena : &Arena, tmp : &Arena) : Canvas {
    let fail = Canvas {
        pixels : arena.alloc::< u8 >(0), w : 0, h : 0, mode : Mode.Pixel
    };
    if bytes.len < 8 || bytes[0] != 137 || bytes[1] != 80 || bytes[2] != 78 || bytes[3] != 71 {
        return fail;
    }
    // First pass: header, palette, transparency, and the total IDAT size.
    let at = 8;
    let w = 0;
    let h = 0;
    let depth = 0;
    let ctype = 0;
    let interlace = 0;
    let plte = 0;
    let plteLen = 0;
    let trns = 0;
    let trnsLen = 0;
    let zlen = 0;
    while at + 12 <= bytes.len {
        let len = be32at(bytes, at);
        if len < 0 || at + 12 + len > bytes.len {
            return fail;
        }
        let d = at + 8;
        if isType(bytes, at + 4, 73, 72, 68, 82) && len == 13 {
            w = be32at(bytes, d);
            h = be32at(bytes, d + 4);
            depth = int(bytes[d + 8]);
            ctype = int(bytes[d + 9]);
            interlace = int(bytes[d + 12]);
        } else if isType(bytes, at + 4, 80, 76, 84, 69) {
            plte = d;
            plteLen = len;
        } else if isType(bytes, at + 4, 116, 82, 78, 83) {
            trns = d;
            trnsLen = len;
        } else if isType(bytes, at + 4, 73, 68, 65, 84) {
            zlen += len;
        } else if isType(bytes, at + 4, 73, 69, 78, 68) {
            break;
        }
        at += 12 + len;
    }
    let ch = 0;
    if ctype == 0 || ctype == 3 {
        ch = 1;
    } else if ctype == 2 {
        ch = 3;
    } else if ctype == 4 {
        ch = 2;
    } else if ctype == 6 {
        ch = 4;
    }
    if ch == 0 || depth != 8 || interlace != 0 || w < 1 || h < 1 || w * h > 268435455 || zlen < 2 {
        return fail;
    }
    // Second pass: the IDAT data joined into one zlib stream.
    let z = tmp.alloc::< u8 >(zlen);
    let zi = 0;
    at = 8;
    while at + 12 <= bytes.len {
        let size = be32at(bytes, at);
        if isType(bytes, at + 4, 73, 68, 65, 84) {
            let k = 0;
            while k < size {
                z[zi + k] = bytes[at + 8 + k];
                k += 1;
            }
            zi += size;
        } else if isType(bytes, at + 4, 73, 69, 78, 68) {
            break;
        }
        at += 12 + size;
    }
    let row = w * ch;
    let raw = tmp.alloc::< u8 >(h *(row + 1));
    if !inflate(z, raw, tmp) {
        return fail;
    }
    // Undo the row filters in place.
    let y = 0;
    while y < h {
        let base = y *(row + 1);
        let f = int(raw[base]);
        if f > 4 {
            return fail;
        }
        let i = 0;
        while i < row {
            let a = 0;
            let b = 0;
            let c = 0;
            if i >= ch {
                a = int(raw[base + 1 + i -ch]);
            }
            if y > 0 {
                b = int(raw[base -row + i]);
                if i >= ch {
                    c = int(raw[base -row + i -ch]);
                }
            }
            let pred = 0;
            if f == 1 {
                pred = a;
            } else if f == 2 {
                pred = b;
            } else if f == 3 {
                pred =(a + b) / 2;
            } else if f == 4 {
                let p = a + b -c;
                let pa = absi(p -a);
                let pb = absi(p -b);
                let pc = absi(p -c);
                if pa <= pb && pa <= pc {
                    pred = a;
                } else if pb <= pc {
                    pred = b;
                } else {
                    pred = c;
                }
            }
            let v = int(raw[base + 1 + i]) + pred;
            if v >= 256 {
                v -= 256;
            }
            raw[base + 1 + i] = u8(v);
            i += 1;
        }
        y += 1;
    }
    // Expand to RGBA.
    let out = Canvas.create(arena, i32(w), i32(h), Mode.Pixel);
    let px = out.pixels;
    y = 0;
    while y < h {
        let x = 0;
        while x < w {
            let s = y *(row + 1) + 1 + x * ch;
            let o =(y * w + x) *4;
            if ctype == 0 {
                px[o] = raw[s];
                px[o + 1] = raw[s];
                px[o + 2] = raw[s];
                px[o + 3] = 255;
            } else if ctype == 2 {
                px[o] = raw[s];
                px[o + 1] = raw[s + 1];
                px[o + 2] = raw[s + 2];
                px[o + 3] = 255;
            } else if ctype == 3 {
                let idx = int(raw[s]);
                if idx * 3 + 3 > plteLen {
                    return fail;
                }
                px[o] = bytes[plte + idx * 3];
                px[o + 1] = bytes[plte + idx * 3 + 1];
                px[o + 2] = bytes[plte + idx * 3 + 2];
                px[o + 3] = 255;
                if idx < trnsLen {
                    px[o + 3] = bytes[trns + idx];
                }
            } else if ctype == 4 {
                px[o] = raw[s];
                px[o + 1] = raw[s];
                px[o + 2] = raw[s];
                px[o + 3] = raw[s + 1];
            } else {
                px[o] = raw[s];
                px[o + 1] = raw[s + 1];
                px[o + 2] = raw[s + 2];
                px[o + 3] = raw[s + 3];
            }
            x += 1;
        }
        y += 1;
    }
    return out;
}

/// `decodePng` of a file; `w == 0` when it is missing or unsupported.
pub fn loadPng(path : string, arena : &Arena) : Canvas {
    let tmp = Arena.create(65536);
    let c = Canvas {
        pixels : arena.alloc::< u8 >(0), w : 0, h : 0, mode : Mode.Pixel
    };
    match readFile(path, &tmp) {
        Result.Ok(bytes) {
            c = decodeWith(bytes, arena, &tmp);
        }
        Result.Err(e) {}
    }
    tmp.destroy();
    return c;
}

fn be32at(b :[] u8, i : int) : int {
    return int(b[i]) *16777216 + int(b[i + 1]) *65536 + int(b[i + 2]) *256 + int(b[i + 3]);
}

fn isType(b :[] u8, i : int, c0 : int, c1 : int, c2 : int, c3 : int) : bool {
    return int(b[i]) == c0 && int(b[i + 1]) == c1 && int(b[i + 2]) == c2 && int(b[i + 3]) == c3;
}

/// DEFLATE input read least significant bit first, without shift operators.
struct Bits {
    src :[] u8;
    at : int;
    buf : int;
    cnt : int;
    bad : bool;
}

fn need(s : &Bits, n : int) : int {
    while s.cnt < n {
        if s.at >= s.src.len {
            s.bad = true;
            return 0;
        }
        s.buf += int(s.src[s.at]) *POW2[s.cnt];
        s.at += 1;
        s.cnt += 8;
    }
    let v = s.buf -(s.buf / POW2[n]) *POW2[n];
    s.buf = s.buf / POW2[n];
    s.cnt -= n;
    return v;
}

/// Canonical Huffman code as zlib's puff keeps it: code counts per length, and the
/// symbols in code order.
struct Huff {
    count :[] int;
    symbol :[] int;
}

/// Build from the first `n` code lengths; false when the lengths over-subscribe.
fn build(h : &Huff, lens :[] int, first : int, n : int, arena : &Arena) : bool {
    let offs = arena.alloc::< int >(16);
    let i = 0;
    while i < 16 {
        h.count[i] = 0;
        offs[i] = 0;
        i += 1;
    }
    i = 0;
    while i < n {
        h.count[lens[first + i]] += 1;
        i += 1;
    }
    let left = 1;
    let len = 1;
    while len < 16 {
        left = left * 2 -h.count[len];
        if left < 0 {
            return false;
        }
        len += 1;
    }
    len = 1;
    while len < 15 {
        offs[len + 1] = offs[len] + h.count[len];
        len += 1;
    }
    i = 0;
    while i < n {
        let l = lens[first + i];
        if l != 0 {
            h.symbol[offs[l]] = i;
            offs[l] += 1;
        }
        i += 1;
    }
    h.count[0] = 0;
    return true;
}

/// The next symbol, or -1 on bad input.
// ponytail: bit-at-a-time decode; add a first-9-bits lookup table if loads show in a profile.
fn decodeSym(s : &Bits, h : &Huff) : int {
    let code = 0;
    let first = 0;
    let index = 0;
    let len = 1;
    while len < 16 {
        code += need(s, 1);
        let count = h.count[len];
        if code -count < first {
            return h.symbol[index + code -first];
        }
        index += count;
        first =(first + count) *2;
        code = code * 2;
        len += 1;
    }
    return -1;
}

/// Inflate the zlib stream `z` into exactly `out`. False on bad or short data.
fn inflate(z :[] u8, out :[] u8, arena : &Arena) : bool {
    let s = Bits {
        src : z, at : 2, buf : 0, cnt : 0, bad : false
    };
    let lit = Huff {
        count : arena.alloc::< int >(16), symbol : arena.alloc::< int >(288)
    };
    let dist = Huff {
        count : arena.alloc::< int >(16), symbol : arena.alloc::< int >(32)
    };
    let lens = arena.alloc::< int >(320);
    let cl = arena.alloc::< int >(19);
    let o = 0;
    let last = 0;
    while last == 0 {
        last = need(&s, 1);
        let kind = need(&s, 2);
        if kind == 0 {
            s.buf = 0;
            s.cnt = 0;
            if s.at + 4 > z.len {
                return false;
            }
            let stored = int(z[s.at]) + int(z[s.at + 1]) *256;
            s.at += 4;
            if s.at + stored > z.len || o + stored > out.len {
                return false;
            }
            let b = 0;
            while b < stored {
                out[o + b] = z[s.at + b];
                b += 1;
            }
            s.at += stored;
            o += stored;
        } else if kind == 1 || kind == 2 {
            let nlen = 288;
            let ndist = 30;
            if kind == 1 {
                let f = 0;
                while f < 288 {
                    lens[f] = 8;
                    if f >= 144 && f < 256 {
                        lens[f] = 9;
                    } else if f >= 256 && f < 280 {
                        lens[f] = 7;
                    }
                    f += 1;
                }
                f = 0;
                while f < 30 {
                    lens[288 + f] = 5;
                    f += 1;
                }
            } else {
                nlen = need(&s, 5) + 257;
                ndist = need(&s, 5) + 1;
                let ncode = need(&s, 4) + 4;
                let i = 0;
                while i < 19 {
                    cl[i] = 0;
                    i += 1;
                }
                i = 0;
                while i < ncode {
                    cl[CODE_ORDER[i]] = need(&s, 3);
                    i += 1;
                }
                if s.bad || !build(&lit, cl, 0, 19, arena) {
                    return false;
                }
                // The code-length code gives the literal lengths (at 0) and the distance
                // lengths (at 288, where the fixed tables keep them).
                let got = 0;
                let prev = 0;
                while got < nlen + ndist {
                    let c = decodeSym(&s, &lit);
                    if c < 0 || s.bad {
                        return false;
                    }
                    let v = 0;
                    let n = 1;
                    if c < 16 {
                        v = c;
                    } else if c == 16 {
                        if got == 0 {
                            return false;
                        }
                        v = prev;
                        n = 3 + need(&s, 2);
                    } else if c == 17 {
                        n = 3 + need(&s, 3);
                    } else {
                        n = 11 + need(&s, 7);
                    }
                    if got + n > nlen + ndist {
                        return false;
                    }
                    while n > 0 {
                        if got < nlen {
                            lens[got] = v;
                        } else {
                            lens[288 + got -nlen] = v;
                        }
                        got += 1;
                        n -= 1;
                    }
                    prev = v;
                }
                if lens[256] == 0 {
                    return false;
                }
            }
            if !build(&lit, lens, 0, nlen, arena) || !build(&dist, lens, 288, ndist, arena) {
                return false;
            }
            let sym = 0;
            while sym != 256 {
                sym = decodeSym(&s, &lit);
                if sym < 0 || s.bad {
                    return false;
                }
                if sym < 256 {
                    if o >= out.len {
                        return false;
                    }
                    out[o] = u8(sym);
                    o += 1;
                } else if sym > 256 {
                    let li = sym -257;
                    if li >= 29 {
                        return false;
                    }
                    let run = LEN_BASE[li] + need(&s, LEN_EXTRA[li]);
                    let di = decodeSym(&s, &dist);
                    if di < 0 || di >= 30 {
                        return false;
                    }
                    let d = DIST_BASE[di] + need(&s, DIST_EXTRA[di]);
                    if s.bad || d > o || o + run > out.len {
                        return false;
                    }
                    // Byte by byte: the copy may overlap what it writes.
                    let k = 0;
                    while k < run {
                        out[o] = out[o -d];
                        o += 1;
                        k += 1;
                    }
                }
            }
        } else {
            return false;
        }
        if s.bad {
            return false;
        }
    }
    return o == out.len;
}
