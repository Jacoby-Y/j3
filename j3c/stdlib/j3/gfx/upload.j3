// Part of j3.gfx (mesh and texture upload, traced-scene data); the module doc and `use`s are in ../gfx.j3.
module j3.gfx;

/// Upload interleaved verts as a new mesh.
/// 10 floats per vertex is untextured. 12 is textured, when that length is not also a multiple of 10.
/// A length divisible by both is untextured, so voxel faces keep their layout. Use `uploadUv` to force u v.
pub fn upload(verts: []f32): Mesh {
    let stride = pickStride(verts.len);
    if stride == 0 {
        panic("gfx.upload");
    }
    return uploadStride(verts, stride);
}

/// Upload a `# j3mesh 2` buffer (12 floats per vertex), including lengths also divisible by 10.
pub fn uploadUv(verts: []f32): Mesh {
    if verts.len < 12 || verts.len - (verts.len / 12) * 12 != 0 {
        panic("gfx.uploadUv");
    }
    return uploadStride(verts, 12);
}

/// Upload `verts` with an explicit float stride of 10 or 12.
fn uploadStride(verts: []f32, stride: int): Mesh {
    ensure();
    let vao: u32 = 0;
    let vbo: u32 = 0;
    glGenVertexArrays(1, &vao as ptr);
    glGenBuffers(1, &vbo as ptr);
    if vao == 0 || vbo == 0 {
        panic("gfx.upload");
    }
    glBindVertexArray(vao);
    glBindBuffer(GL_ARRAY_BUFFER, vbo);
    fillBuffer(verts);
    let bytes: i32 = 40;
    let uv = false;
    if stride == 12 {
        bytes = STRIDE12;
        uv = true;
    }
    bindLayout(bytes, uv, false);
    glBindVertexArray(0);
    return Mesh {
        vao: vao,
        vbo: vbo,
        count: verts.len / stride,
    };
}

/// Upload verts of 14 floats: pos, normal, color, emission, u v, then `sky` and `block` light (0..1 each).
/// A material effect reads them as `vLight` (x sky, y block); the stock shader ignores them.
/// Meshes uploaded any other way read `vLight = (1, 0)`.
pub fn uploadUvLight(verts: []f32): Mesh {
    if verts.len < 14 || verts.len - (verts.len / 14) * 14 != 0 {
        panic("gfx.uploadUvLight");
    }
    ensure();
    let vao: u32 = 0;
    let vbo: u32 = 0;
    glGenVertexArrays(1, &vao as ptr);
    glGenBuffers(1, &vbo as ptr);
    if vao == 0 || vbo == 0 {
        panic("gfx.upload");
    }
    glBindVertexArray(vao);
    glBindBuffer(GL_ARRAY_BUFFER, vbo);
    fillBuffer(verts);
    bindLayout(STRIDE14, true, true);
    glBindVertexArray(0);
    return Mesh { vao: vao, vbo: vbo, count: verts.len / 14 };
}

/// Replace a `# j3mesh 2` buffer. Use this when the float count is also a multiple of 10.
pub fn updateUv(mesh: &Mesh, verts: []f32) {
    ensure();
    if mesh.vbo == 0 || verts.len < 12 || verts.len - (verts.len / 12) * 12 != 0 {
        panic("gfx.updateUv");
    }
    glBindVertexArray(mesh.vao);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.vbo);
    fillBuffer(verts);
    bindLayout(STRIDE12, true, false);
    mesh.count = verts.len / 12;
    glBindVertexArray(0);
}

/// Replace a mesh VBO contents and vertex count. Stride follows `upload`.
pub fn update(mesh: &Mesh, verts: []f32) {
    ensure();
    if mesh.vbo == 0 {
        panic("gfx.update");
    }
    let stride = pickStride(verts.len);
    if stride == 0 {
        panic("gfx.update");
    }
    glBindVertexArray(mesh.vao);
    glBindBuffer(GL_ARRAY_BUFFER, mesh.vbo);
    fillBuffer(verts);
    let bytes: i32 = 40;
    let uv = false;
    if stride == 12 {
        bytes = STRIDE12;
        uv = true;
    }
    bindLayout(bytes, uv, false);
    mesh.count = verts.len / stride;
    glBindVertexArray(0);
}

/// Delete a mesh VAO/VBO and zero its fields.
pub fn free(mesh: &Mesh) {
    if mesh.vbo != 0 {
        let vbo = mesh.vbo;
        glDeleteBuffers(1, &vbo as ptr);
        mesh.vbo = 0;
    }
    if mesh.vao != 0 {
        let vao = mesh.vao;
        glDeleteVertexArrays(1, &vao as ptr);
        mesh.vao = 0;
    }
    mesh.count = 0;
}

/// Upload tightly packed RGBA8 pixels. Panics if the buffer is short.
pub fn tex(pixels: []u8, w: i32, h: i32): Tex {
    ensure();
    if w < 1 || h < 1 || pixels.len < int(w) * int(h) * 4 {
        panic("gfx.tex");
    }
    let id: u32 = 0;
    glGenTextures(1, &id as ptr);
    if id == 0 {
        panic("gfx.tex");
    }
    glBindTexture(GL_TEXTURE_2D, id);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.ptr as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
    finishColorTex();
    return Tex { id: id, w: w, h: h };
}

/// Like `tex`, but sampled with hard nearest-texel filtering and no mipmaps: crisp pixel art at any distance.
pub fn texPixelArt(pixels: []u8, w: i32, h: i32): Tex {
    let t = tex(pixels, w, h);
    glBindTexture(GL_TEXTURE_2D, t.id);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
    return t;
}

/// Copy what the current camera pass has drawn so far into the texture glass surfaces
/// sample (see `Surface.ior`). Call after the opaque draws, before the see-through ones.
pub fn grab() {
    if G.pass != PASS_CAMERA {
        return;
    }
    let at = viewOrigin();
    let sz = viewExtent();
    let r = glView(at.x, at.y, sz.x, sz.y);
    let x = i32(r.x);
    let y = i32(r.y);
    let w = i32(r.w);
    let h = i32(r.h);
    if w < 1 || h < 1 {
        return;
    }
    if G.grabTex == 0 {
        let id: u32 = 0;
        glGenTextures(1, &id as ptr);
        G.grabTex = id;
    }
    glActiveTexture(GL_TEXTURE3);
    glBindTexture(GL_TEXTURE_2D, G.grabTex);
    if w != G.grabW || h != G.grabH {
        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0 as ptr);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
        G.grabW = w;
        G.grabH = h;
    }
    glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, x, y, w, h);
    G.grabbed = true;
    glActiveTexture(GL_TEXTURE0);
    G.grabRect[0] = f32(x);
    G.grabRect[1] = f32(y);
    G.grabRect[2] = f32(w);
    G.grabRect[3] = f32(h);
}

/// Texels a row in the traced-scene textures.
/// Texels per row of the trace textures; the lit shader hardcodes it as `& 1023` and `>> 10`.
const TRACE_W: int = 1024;

/// A scene on the GPU for URP tracing, in two levels: meshes with their own BVHs in their
/// own space (`traceMeshes`), and the objects placing them with a BVH over their boxes
/// (`traceInstances`). Moving objects only redoes the second.
pub struct Traced {
    tris: u32;
    nodes: u32;
    top: u32;
    inst: u32;
    /// Objects; 0 means nothing to trace.
    count: int;
}

fn genTexture(): u32 {
    let a: u32 = 0;
    glGenTextures(1, &a as ptr);
    return a;
}

/// Upload mesh triangles (28 floats each: corner, two edges, three corner normals, color)
/// and every mesh's BVH nodes (8 floats each, `j3.gfx.bvh` layout, indices absolute) into
/// `t`, reusing its textures.
pub fn traceMeshes(t: &Traced, tris: []f32, count: int, nodes: []f32, nodeCount: int) {
    ensure();
    if t.tris == 0 {
        t.tris = genTexture();
        t.nodes = genTexture();
    }
    floatTexture(t.tris, tris, count * 7);
    floatTexture(t.nodes, nodes, nodeCount * 2);
}

/// Upload objects (24 floats each: world-to-object rows, tint+mirror, glow+ior, then
/// roughness, opacity, cloud, and the mesh's root node in `traceMeshes`' nodes) and the
/// BVH over them (leaves index objects) into `t`.
pub fn traceInstances(t: &Traced, inst: []f32, count: int, top: []f32, topCount: int) {
    ensure();
    if t.top == 0 {
        t.top = genTexture();
        t.inst = genTexture();
    }
    floatTexture(t.inst, inst, count * 6);
    floatTexture(t.top, top, topCount * 2);
    t.count = count;
}

/// Fill texture `id` with `texels` RGBA floats from `data`, `TRACE_W` a row.
fn floatTexture(id: u32, data: []f32, texels: int) {
    let rows = (texels + TRACE_W - 1) / TRACE_W;
    if rows < 1 { rows = 1; }
    // The last row is padded, so upload from a buffer that covers it.
    let full = data;
    if data.len < rows * TRACE_W * 4 {
        full = scratch(0).alloc::<f32>(rows * TRACE_W * 4);
        let i = 0;
        while i < texels * 4 && i < data.len {
            full[i] = data[i];
            i += 1;
        }
    }
    glBindTexture(GL_TEXTURE_2D, id);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA32F, i32(TRACE_W), i32(rows), 0, GL_RGBA, GL_FLOAT, full.ptr as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
}

/// Trace mirrors and glass through `t` in later draws: rays follow up to `bounces`
/// surfaces, rough and glass surfaces average `samples` rays, and `shadows` traces sun
/// shadows at hits (else the shadow map is used). `traceOff` stops it.
/// Trace with `t`. `shadows` traces sun shadows too, where the shadow map is unsure and
/// within `near` of the eye (0: everywhere).
pub fn traceUse(t: Traced, bounces: int, samples: int, shadows: bool, near: f32) {
    G.traceNear = near;
    G.trace = t;
    G.traceBounces = bounces;
    G.traceSamples = samples;
    G.traceShadows = shadows;
}

pub fn traceOff() {
    G.trace.count = 0;
}

/// Mirrors reflect `image` (an equirect sky, as `builtin:sky` maps it) instead of the plain
/// sky color. Id 0 goes back to the sky color.
pub fn skyImage(image: Tex) {
    G.skyTex = image.id;
}

/// Replace the pixels of an existing texture while keeping its GL id stable.
pub fn updateTex(image: &Tex, pixels: []u8, w: i32, h: i32) {
    ensure();
    if image.id == 0 || w < 1 || h < 1 || pixels.len < int(w) * int(h) * 4 {
        panic("gfx.updateTex");
    }
    glBindTexture(GL_TEXTURE_2D, image.id);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.ptr as ptr);
    image.w = w;
    image.h = h;
}

/// Delete a texture uploaded with `tex`.
pub fn freeTex(image: &Tex) {
    if image.id != 0 {
        let id = image.id;
        glDeleteTextures(1, &id as ptr);
        image.id = 0;
    }
}

/// Bind `image` as the albedo until the next `albedo` or camera pass.
/// The camera pass resets the bind to the white texture.
pub fn albedo(image: Tex) {
    ensure();
    if image.id == 0 {
        G.albedo = G.white;
    } else {
        G.albedo = image.id;
    }
    bindAlbedo();
}
