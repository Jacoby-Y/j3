/// `# j3mesh 1` then a vertex count, then 10 floats per vertex.
/// `# j3mesh 2` is the same layout plus `u v` (12 floats).
/// Layout matches `gfx.upload`: x y z nx ny nz r g b emi [u v].

module j3.gfx.mesh;

use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;

/// Floats per vertex for `# j3mesh 1` and untextured `gfx.upload`.
pub const STRIDE: int = 10;
/// Floats per vertex for `# j3mesh 2` (v1 layout plus u v).
pub const STRIDE_UV: int = 12;

/// Read cursor over a mesh text file.
struct Cursor {
    /// Source bytes being scanned.
    src: []u8;
    /// Current read index into `src`.
    i: int;
}

/// Advances past the remainder of the current line, including the newline.
fn skipLine(c: &Cursor) {
    while c.i < c.src.len && c.src[c.i] != 10 {
        c.i = c.i + 1;
    }
    if c.i < c.src.len {
        c.i = c.i + 1;
    }
}

/// Skips whitespace and `#` comment lines.
fn skip(c: &Cursor) {
    while c.i < c.src.len {
        let b = c.src[c.i];
        if b == 32 || b == 9 || b == 13 || b == 10 {
            c.i = c.i + 1;
        } else if b == 35 {
            skipLine(c);
        } else {
            break;
        }
    }
}

/// True when `n` is a positive multiple of `d`.
fn multiple(n: int, d: int): bool {
    if n < d {
        return false;
    }
    return n - (n / d) * d == 0;
}

/// Floats per vertex from a `# j3mesh N` header. Missing or v1 headers are 10.
fn headerStride(src: []u8): int {
    let i = 0;
    while i < src.len {
        let b = src[i];
        if b == 32 || b == 9 || b == 13 || b == 10 {
            i += 1;
        } else {
            break;
        }
    }
    if i >= src.len || src[i] != 35 {
        return STRIDE;
    }
    let end = i;
    while end < src.len && src[end] != 10 {
        end += 1;
    }
    let needle = "j3mesh 2";
    let at = i;
    while at + needle.len <= end {
        let k = 0;
        let ok = true;
        while k < needle.len {
            if src[at + k] != needle[k] {
                ok = false;
            }
            k += 1;
        }
        if ok {
            let after = at + needle.len;
            if after >= end || src[after] < 48 || src[after] > 57 {
                return STRIDE_UV;
            }
        }
        at += 1;
    }
    return STRIDE;
}

/// Floats per vertex declared by the mesh header (10 or 12).
pub fn floatsPerVertex(src: []u8): int {
    return headerStride(src);
}

/// Parses the next decimal float (optional sign and fraction) from the cursor.
fn takeF32(c: &Cursor): f32 {
    skip(c);
    let sign: f32 = 1;
    if c.i < c.src.len && c.src[c.i] == 45 {
        sign = f32(0) - f32(1);
        c.i = c.i + 1;
    }
    let whole = 0;
    let any = false;
    while c.i < c.src.len {
        let b = c.src[c.i];
        if b < 48 || b > 57 {
            break;
        }
        whole = whole * 10 + int(b) - 48;
        c.i = c.i + 1;
        any = true;
    }
    let frac: f32 = 0;
    let scale: f32 = 1;
    if c.i < c.src.len && c.src[c.i] == 46 {
        c.i = c.i + 1;
        any = true;
        while c.i < c.src.len {
            let d = c.src[c.i];
            if d < 48 || d > 57 {
                break;
            }
            frac = frac * f32(10) + f32(int(d) - 48);
            scale = scale * f32(10);
            c.i = c.i + 1;
        }
    }
    if !any {
        return 0;
    }
    return sign * (f32(whole) + frac / scale);
}

/// Parses a j3mesh buffer into interleaved floats, or empty on a bad count.
/// v1 is `n * 10`. v2 (`# j3mesh 2`) is `n * 12`.
pub fn parse(arena: &Arena, src: []u8): []f32 {
    let stride = headerStride(src);
    let c = Cursor { src: src, i: 0 };
    let n = takeF32(&c) as int;
    if n < 1 {
        return arena.alloc::<f32>(0);
    }
    let out = arena.alloc::<f32>(n * stride);
    let i = 0;
    while i < out.len {
        out[i] = takeF32(&c);
        i += 1;
    }
    return out;
}

/// Reads a mesh file and parses it; returns an empty slice on I/O error.
pub fn load(path: string, arena: &Arena): []f32 {
    match io.readFile(path, arena) {
        Result.Ok(b) {
            return parse(arena, b);
        }
        Result.Err(_) {
            return arena.alloc::<f32>(0);
        }
    }
}

/// Appends `v` to `t` as a signed float with four fractional digits.
fn pushF32(t: &Text, v: f32) {
    if v < 0 {
        t.push(45);
        v = f32(0) - v;
    }
    let whole = v as int;
    t.pushInt(whole);
    t.push(46);
    let frac = v - f32(whole);
    let digits = "0123456789";
    let k = 0;
    while k < 4 {
        frac = frac * f32(10);
        let d = frac as int;
        if d < 0 {
            d = 0;
        }
        if d > 9 {
            d = 9;
        }
        t.push(digits[d]);
        frac = frac - f32(d);
        k += 1;
    }
}

/// 12 when `len` is a v2 buffer that is not also a v1 length; otherwise 10.
/// A length divisible by both 60-float chunks stays v1 so voxel meshes round-trip.
fn emitStride(n: int): int {
    if multiple(n, STRIDE_UV) && !multiple(n, STRIDE) {
        return STRIDE_UV;
    }
    return STRIDE;
}

/// Serializes interleaved vertices. v2 when the length is 12-per-vertex only.
pub fn emit(arena: &Arena, verts: []f32): []u8 {
    return emitAs(arena, verts, emitStride(verts.len));
}

/// Serializes 12-float vertices (with uv) as v2, whatever their count.
pub fn emitUv(arena: &Arena, verts: []f32): []u8 {
    return emitAs(arena, verts, STRIDE_UV);
}

fn emitAs(arena: &Arena, verts: []f32, stride: int): []u8 {
    let t = Text.new(arena);
    if stride == STRIDE_UV {
        t.pushStr("# j3mesh 2\n");
    } else {
        t.pushStr("# j3mesh 1\n");
    }
    let n = verts.len / stride;
    t.pushInt(n);
    t.push(10);
    let i = 0;
    while i < n * stride && i < verts.len {
        if i - (i / stride) * stride != 0 {
            t.push(32);
        }
        pushF32(&t, verts[i]);
        if i - (i / stride) * stride == stride - 1 {
            t.push(10);
        }
        i += 1;
    }
    return t.bytes;
}
