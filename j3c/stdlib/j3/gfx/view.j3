// Part of j3.gfx (fog, view rect and state, targets, readback, picking rays); the module doc and `use`s are in ../gfx.j3.
module j3.gfx;

/// Fog distances used by the next camera pass. Defaults are 40 and 120.
pub fn setFog(start: f32, end: f32) {
    G.fogStart = start;
    G.fogEnd = end;
}

/// Render later camera passes into a window-pixel rect (top-left origin), e.g. an editor
/// viewport between panels. `mouseRay` maps the pointer through the same rect.
/// A zero width or height restores the whole window.
pub fn setViewRect(x: f32, y: f32, w: f32, h: f32) {
    G.viewX = x;
    G.viewY = y;
    G.viewW = w;
    G.viewH = h;
}

/// Top-left of the camera-pass rect in window pixels.
pub fn viewOrigin(): Vec2 {
    if G.viewW < 1 || G.viewH < 1 {
        return Vec2 { x: 0, y: 0 };
    }
    return Vec2 { x: G.viewX, y: G.viewY };
}

/// A window-pixel rect (top-left origin) as the GL rect to draw it in on the output: bottom-left
/// origin, and under `game.setVirtualSize` mapped into the letterbox area. An offscreen output
/// (a post target, `setOutputFbo`) is not letterboxed: its pixels are the rect's.
fn glView(x: f32, y: f32, w: f32, h: f32): GlRect {
    let vs = game.virtualSize();
    if G.outputFbo == 0 && vs.x > 0 { return game.p2GlRect(x, y, w, h); }
    let win = game.drawSize();
    return GlRect { x: int(x), y: int(win.y - y - h), w: int(w), h: int(h) };
}

/// Size of the camera-pass rect in window pixels.
pub fn viewExtent(): Vec2 {
    if G.viewW < 1 || G.viewH < 1 {
        return game.drawSize();
    }
    return Vec2 { x: G.viewW, y: G.viewH };
}

/// Window pixel for a world point under the latest camera pass. `z` is the clip-space `w`;
/// zero or less means the point is behind the camera and `x`/`y` are meaningless.
pub fn toScreen(p: Vec3): Vec3 {
    let m = G.proj.mul(G.view);
    let cw = m.m[3] * p.x + m.m[7] * p.y + m.m[11] * p.z + m.m[15];
    if cw <= 0 {
        return Vec3.xyz(0, 0, cw);
    }
    let ndc = m.transformPoint(p);
    let at = viewOrigin();
    let sz = viewExtent();
    return Vec3.xyz(at.x + (ndc.x * 0.5 + 0.5) * sz.x, at.y + (0.5 - ndc.y * 0.5) * sz.y, cw);
}

/// What `toScreen` and `mouseRay` read from the last camera pass. Save it before drawing a
/// second view (a picture-in-picture, say) and put it back after.
pub struct ViewState {
    view: Mat4;
    proj: Mat4;
    eye: Vec3;
    x: f32;
    y: f32;
    w: f32;
    h: f32;
    fov: f32;
    ortho: f32;
    near: f32;
    far: f32;
}

pub fn viewState(): ViewState {
    return ViewState {
        view: G.view,
        proj: G.proj,
        eye: G.eye,
        x: G.viewX,
        y: G.viewY,
        w: G.viewW,
        h: G.viewH,
        fov: G.fovAngle,
        ortho: G.orthoHalf,
        near: G.clipNear,
        far: G.clipFar,
    };
}

/// Restore a `viewState`. GL state is left alone; the next camera pass sets it.
pub fn setViewState(s: ViewState) {
    G.view = s.view;
    G.proj = s.proj;
    G.eye = s.eye;
    G.viewX = s.x;
    G.viewY = s.y;
    G.viewW = s.w;
    G.viewH = s.h;
    G.fovAngle = s.fov;
    G.orthoHalf = s.ortho;
    G.clipNear = s.near;
    G.clipFar = s.far;
}

/// An offscreen color and depth target: pass `fbo` to `setOutputFbo` to draw a view into it,
/// for example to save it with `readPixels`. `freeTarget` releases it.
pub struct Target {
    fbo: u32;
    color: u32;
    depth: u32;
    w: int;
    h: int;
}

pub fn makeTarget(w: int, h: int): Target {
    ensure();
    let t = Target { fbo: 0, color: 0, depth: 0, w: w, h: h };
    glGenTextures(1, &t.color as ptr);
    glBindTexture(GL_TEXTURE_2D, t.color);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, i32(w), i32(h), 0, GL_RGBA, GL_UNSIGNED_BYTE, 0);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glGenTextures(1, &t.depth as ptr);
    glBindTexture(GL_TEXTURE_2D, t.depth);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT24, i32(w), i32(h), 0, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, 0);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
    glGenFramebuffers(1, &t.fbo as ptr);
    glBindFramebuffer(GL_FRAMEBUFFER, t.fbo);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, t.color, 0);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, t.depth, 0);
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE { panic("render target framebuffer"); }
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
    glBindTexture(GL_TEXTURE_2D, 0);
    return t;
}

pub fn freeTarget(t: &Target) {
    if t.fbo != 0 { glDeleteFramebuffers(1, &t.fbo as ptr); }
    if t.color != 0 { glDeleteTextures(1, &t.color as ptr); }
    if t.depth != 0 { glDeleteTextures(1, &t.depth as ptr); }
    t.fbo = 0;
    t.color = 0;
    t.depth = 0;
}

/// Real pixels, not virtual (`game.setVirtualSize` letterbox bars are in them).
/// Copy the `w` by `h` pixels at the bottom-left of the camera pass's output (the window, or
/// the framebuffer given to `setOutputFbo`) into `out` as RGBA8, top row first, the way
/// `j3.gfx.canvas` and PNG files store them. Call it after drawing and before `game.present`.
pub fn readPixels(w: int, h: int, out: []u8) {
    if out.len < w * h * 4 || P.readPixels as int == 0 { return; }
    glBindFramebuffer(GL_FRAMEBUFFER, G.outputFbo);
    let f = P.readPixels as fn(i32, i32, i32, i32, u32, u32, ptr);
    f(0, 0, i32(w), i32(h), GL_RGBA, GL_UNSIGNED_BYTE, out.ptr as ptr);
    // GL reads bottom row first; swap rows in place.
    let row = w * 4;
    let y = 0;
    while y < h / 2 {
        let a = y * row;
        let b = (h - 1 - y) * row;
        let i = 0;
        while i < row {
            let t = out[a + i];
            out[a + i] = out[b + i];
            out[b + i] = t;
            i += 1;
        }
        y += 1;
    }
}

/// Route the camera pass into an external framebuffer; zero restores the window.
/// The caller owns the framebuffer and must attach both color and depth.
pub fn setOutputFbo(id: u32) {
    G.outputFbo = id;
}

/// Shadow depth texture generated by the most recent shadow pass.
pub fn shadowTexture(): u32 { return G.shadowTex; }

/// Light matrix used to project world points into that shadow texture.
pub fn shadowMatrix(): Mat4 { return G.light; }

/// Clear depth mid camera pass, so later draws (a first-person gun) land on top of the world.
pub fn clearDepth() {
    glClear(GL_DEPTH_BUFFER_BIT);
}

/// Perspective clip planes used by the next camera pass. Defaults are 0.15 and 200.
pub fn setClip(near: f32, far: f32) {
    if near < 0.01 {
        near = 0.01;
    }
    if far <= near {
        far = near + f32(1);
    }
    G.clipNear = near;
    G.clipFar = far;
}

/// World ray through the mouse for an orbit camera. Same fov as the camera pass.
pub fn mouseRay(cam: Orbit): Ray {
    let eye = cam.eye();
    let forward = (cam.target - eye).normalize();
    let right = forward.cross(Vec3.up()).normalize();
    let up = right.cross(forward);
    if G.orthoHalf > 0 {
        // Parallel rays, starting far behind the view so nothing in front of it is missed.
        let sz = viewExtent();
        let mp = game.mousePos() - viewOrigin();
        let nx = mp.x / sz.x * f32(2) - f32(1);
        let ny = f32(1) - mp.y / sz.y * f32(2);
        let h = G.orthoHalf;
        let at = cam.target + right * (nx * h * sz.x / sz.y) + up * (ny * h);
        return Ray { origin: at - forward * G.clipFar, dir: forward };
    }
    return Ray {
        origin: eye,
        dir: pointerDir(forward, right, up),
    };
}

/// World ray through the mouse for a look camera. Same fov as the camera pass.
pub fn mouseRayLook(cam: Look): Ray {
    let forward = cam.forward();
    let right = cam.right();
    let up = right.cross(forward);
    return Ray {
        origin: cam.eye,
        dir: pointerDir(forward, right, up),
    };
}

/// Unit direction from the camera basis through the current mouse position.
fn pointerDir(forward: Vec3, right: Vec3, up: Vec3): Vec3 {
    let sz = viewExtent();
    let w = sz.x;
    let h = sz.y;
    if w < 1 {
        w = 1;
    }
    if h < 1 {
        h = 1;
    }
    let aspect = w / h;
    if aspect < 0.1 {
        aspect = 0.1;
    }
    let mp = game.mousePos() - viewOrigin();
    let nx = mp.x / w * f32(2) - f32(1);
    let ny = f32(1) - mp.y / h * f32(2);
    let th = tan(fov() / f32(2));
    let dx = nx * aspect * th;
    let dy = ny * th;
    let dir = right * dx + up * dy + forward;
    return dir.normalize();
}

/// One slab of an AABB ray test. Updates the running near and far distances.
fn axisSlab(o: f32, d: f32, lo: f32, hi: f32, tmin: &f32, tmax: &f32): bool {
    if abs(d) < 0.0000001 {
        if o < lo || o > hi {
            return false;
        }
        return true;
    }
    let inv = f32(1) / d;
    let a = (lo - o) * inv;
    let b = (hi - o) * inv;
    let nearT = a;
    let farT = b;
    if a > b {
        nearT = b;
        farT = a;
    }
    if nearT > *tmin {
        *tmin = nearT;
    }
    if farT < *tmax {
        *tmax = farT;
    }
    return *tmin <= *tmax;
}

/// First hit of the ray against an AABB, within `reach`. A miss has `ok == false`.
/// An origin inside the box hits at `t == 0`.
pub fn rayAabb(origin: Vec3, dir: Vec3, lo: Vec3, hi: Vec3, reach: f32): RayHit {
    let miss = RayHit { ok: false, t: 0 };
    if reach < 0 {
        return miss;
    }
    let tmin: f32 = 0;
    let tmax = reach;
    if !axisSlab(origin.x, dir.x, lo.x, hi.x, &tmin, &tmax) {
        return miss;
    }
    if !axisSlab(origin.y, dir.y, lo.y, hi.y, &tmin, &tmax) {
        return miss;
    }
    if !axisSlab(origin.z, dir.z, lo.z, hi.z, &tmin, &tmax) {
        return miss;
    }
    if tmax < 0 {
        return miss;
    }
    let t = tmin;
    if t < 0 {
        t = 0;
    }
    return RayHit { ok: true, t: t };
}
