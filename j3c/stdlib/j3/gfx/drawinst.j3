// Part of j3.gfx (instanced draws).

module j3.gfx;

/// Draw one copy of `mesh` per matrix with the current surface, in instanced GL draws.
pub fn drawInstanced(mesh: Mesh, models: []Mat4) {
    drawCopies(mesh, models, false);
}

/// One opaque instance. Tint and emission replace the current material's colors.
pub struct Instance {
    model: Mat4;
    tint: Vec3;
    emission: Vec3;
}

/// Draw colored copies, retaining the current surface's other properties.
/// Custom effects use ordinary draws so their existing uniform contract is preserved.
pub fn drawInstances(mesh: Mesh, instances: []Instance) { drawInstancesAlpha(mesh, instances, 1); }

/// `drawInstances` with one alpha `a` for the whole batch. Below 1 it blends with depth writes off:
/// draw these after the opaque scene; copies are not sorted against each other.
pub fn drawInstancesAlpha(mesh: Mesh, instances: []Instance, a: f32) {
    if G.pass == PASS_NONE || instances.len == 0 { return; }
    let old = G.surf;
    if old.fx > 0 {
        let fallback = 0;
        while fallback < instances.len {
            G.surf.tint = instances[fallback].tint;
            G.surf.glow = instances[fallback].emission;
            drawAlpha(mesh, instances[fallback].model, a);
            fallback += 1;
        }
        G.surf = old;
        return;
    }
    G.surf.tint = Vec3.xyz(1, 1, 1);
    G.surf.glow = Vec3.zero();
    let at = 0;
    while at < instances.len {
        let n = instances.len - at;
        if n > INST_MAX { n = INST_MAX; }
        let i = 0;
        while i < n {
            let v = instances[at + i];
            let k = 0;
            while k < 16 { INST[i * 24 + k] = v.model.m[k]; k += 1; }
            INST[i * 24 + 16] = v.tint.x;
            INST[i * 24 + 17] = v.tint.y;
            INST[i * 24 + 18] = v.tint.z;
            INST[i * 24 + 20] = v.emission.x;
            INST[i * 24 + 21] = v.emission.y;
            INST[i * 24 + 22] = v.emission.z;
            i += 1;
        }
        glBindBuffer(GL_ARRAY_BUFFER, G.instBuf);
        glBufferData(GL_ARRAY_BUFFER, n * 96, &INST[0] as ptr, GL_DYNAMIC_DRAW);
        COPIES = n;
        INSTANCE_COLOR = true;
        drawMesh(mesh, instances[at].model, false, 0, Vec3.zero(), 0, 0, a);
        INSTANCE_COLOR = false;
        COPIES = 0;
        at += n;
    }
    G.surf = old;
}

/// Batched back-face outlines, camera pass only.
pub fn drawHullInstances(mesh: Mesh, instances: []Instance) {
    if G.pass != PASS_CAMERA { return; }
    glCullFace(GL_FRONT);
    drawInstances(mesh, instances);
    glCullFace(GL_BACK);
}

/// `drawInstanced` with back faces drawn too, like `drawDoubleSided`.
pub fn drawInstancedDoubleSided(mesh: Mesh, models: []Mat4) {
    drawCopies(mesh, models, true);
}

/// Draw `models.len` copies of `mesh`, `INST_MAX` per GL draw, with the current surface.
fn drawCopies(mesh: Mesh, models: []Mat4, both: bool) {
    if G.pass == PASS_NONE { return; }
    ensure();
    if both { glDisable(GL_CULL_FACE); }
    let at = 0;
    while at < models.len {
        let n = models.len - at;
        if n > INST_MAX { n = INST_MAX; }
        let i = 0;
        while i < n {
            let m = models[at + i];
            let k = 0;
            while k < 16 {
                INST[i * 16 + k] = m.m[k];
                k += 1;
            }
            i += 1;
        }
        glBindBuffer(GL_ARRAY_BUFFER, G.instBuf);
        glBufferData(GL_ARRAY_BUFFER, n * 16 * 4, &INST[0] as ptr, GL_DYNAMIC_DRAW);
        COPIES = n;
        drawMesh(mesh, models[at], false, 0, Vec3.xyz(0, 0, 0), 0, 0, 1);
        COPIES = 0;
        at += n;
    }
    if both { glEnable(GL_CULL_FACE); }
}

/// Copies the next `drawMesh` draws from the instance buffer; 0 draws once with its model.
#[singleton]
let COPIES: int = 0;
