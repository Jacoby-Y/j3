// Part of j3.gfx.post (filter layers, blur, endLayer); the module doc and `use`s are in ../post.j3.
module j3.gfx.post;

pub fn beginLayer() {
    init();
    if LDEPTH >= 8 {
        panic("paint layer nesting exceeds eight");
    }
    let zone = game.profUiZone(game.ZONE_UI_LAYER);
    game.profUiCount(game.PROF_LAYERS);
    let size = game.p2FbRect();
    let h = LAYERS[LDEPTH];
    if h != 0 {
        let prev = surface(h);
        if prev.w != int(size.w) || prev.h != int(size.h) {
            destroyTarget(h);
            h = 0;
        }
    }
    if h == 0 {
        h = target(int(size.w), int(size.h));
        LAYERS[LDEPTH] = h;
    }
    let old = save();
    let destinationBuffer = get(0x8825);
    active(0);
    let s = surface(h);
    for i in 1.. 4 {
        allocate(s, i);
    }

    // Preserve the exact parent destination for blend modes, including nested layers.
    framebuffer(0x8CA8, u32(old.draw));
    let rb = get(0x0C02);
    let db = destinationBuffer;
    let read = game.glProc("glReadBuffer") as fn(u32);
    read(u32(db));
    texture(s.tex[3]);
    let copy = game.glProc("glCopyTexSubImage2D") as fn(u32, i32, i32, i32, i32, i32, i32, i32);
    copy(0x0DE1, 0, 0, 0, i32(size.x), i32(size.y), i32(s.w), i32(s.h));
    read(u32(rb));
    if game.p2BackdropBase() != 0 {
        raw();
        program(OVER);
        active(1);
        texture(game.p2BackdropBase());
        sampler(OVER, "uBack", 1);
        pass(s, 3, 2, OVER);
        let tt = s.tex[2];
        s.tex[2] = s.tex[3];
        s.tex[3] = tt;
        let ff = s.fb[2];
        s.fb[2] = s.fb[3];
        s.fb[3] = ff;
    }
    restore(old);
    begin(h, 1);
    game.p2LayerBegin();
    game.p2SetBackdropBase(s.tex[3]);
    LDEPTH += 1;
    // The layer's content is ordinary paint.
    game.profUiZone(zone);
}
fn pass(s: &Surface, src: int, dst: int, prog: u32) {
    framebuffer(0x8CA9, s.fb[dst]);
    viewport(0, 0, i32(s.w), i32(s.h));
    active(0);
    texture(s.tex[src]);
    program(prog);
    sampler(prog, "uTex", 0);
    vao(VAO);
    let draw = game.glProc("glDrawArrays") as fn(u32, i32, i32);
    game.profDraw(1);
    draw(4, 0, 3);
}
fn blur(s: &Surface, src: int, temp: int, dst: int, radius: f32) {
    let sigma = radius;
    if sigma < 0.125 {
        sigma = 0.125;
    }
    let stride = sigma / 4.0;
    if stride < 1 {
        stride = 1;
    }
    let mip = game.glProc("glGenerateMipmap") as fn(u32);
    let param = game.glProc("glTexParameteri") as fn(u32, u32, i32);
    active(0);
    texture(s.tex[src]);
    mip(0x0DE1);
    param(0x0DE1, 0x2801, 0x2703);
    program(BLUR);
    uniform2(BLUR, "uSigma", sigma, stride);
    uniform2(BLUR, "uStep", stride / f32(s.w), 0);
    pass(s, src, temp, BLUR);
    texture(s.tex[temp]);
    mip(0x0DE1);
    param(0x0DE1, 0x2801, 0x2703);
    uniform2(BLUR, "uStep", 0, stride / f32(s.h));
    pass(s, temp, dst, BLUR);

    // Compositors sample level zero; discard stale mip selection after the write.
    texture(s.tex[dst]);
    param(0x0DE1, 0x2801, 0x2601);
}
/// Packed canonical effects, followed by screen-space perspective bounds.
pub fn endLayer(f:[] f32, box:[] f32): u32 {
    if DEPTH < 1 || KIND[DEPTH -1] != 1 || LDEPTH < 1 {
        panic("unbalanced paint layer");
    }
    let zone = game.profUiZone(game.ZONE_UI_LAYER);
    let s = surface(STACK[DEPTH -1]);
    raw();
    let cur = 0;
    if f[0] > 0 {
        blur(s, 0, 1, 2, f[0]);
        cur = 2;
    }
    let bloom = 1;
    if f[1] > 0 {
        program(BRIGHT);
        uniform2(BRIGHT, "uAmount", f[2], 0);
        pass(s, cur, 1, BRIGHT);
        let temp = if cur == 2 {
            0
        } else {
            2
        };
        blur(s, 1, temp, 1, 12);
    }
    else {
        framebuffer(0x8CA9, s.fb[1]);
        let cc = game.glProc("glClearColor") as fn(f32, f32, f32, f32);
        cc(0, 0, 0, 0);
        let cl = game.glProc("glClear") as fn(u32);
        cl(0x4000);
    }
    let dst = if cur == 2 {
        0
    } else {
        2
    };
    program(FX);
    uniform4(FX, "uA", f[1], f[2], f[3], f[4]);
    uniform4(FX, "uB", 0, f[5], f[6], f[7]);
    uniform4(FX, "uC", f[8], f[9], f[10], f[11]);
    uniform4(FX, "uD", f[12] *0.017453292, f[13], 0, 0);
    uniform2(FX, "uE", 0, f[15]);
    uniform2(FX, "uResolution", f32(s.w), f32(s.h));
    uniform4(FX, "uBox", box[0] / f32(s.w), 1 -(box[1] + box[3]) / f32(s.h), box[2] / f32(s.w), box[3] / f32(s.h));
    active(1);
    texture(s.tex[bloom]);
    sampler(FX, "uBloom", 1);
    active(2);
    texture(s.tex[3]);
    sampler(FX, "uBack", 2);
    pass(s, cur, dst, FX);
    cur = dst;
    if f[14] > 0 {
        let id = int(f[14]);
        if id > 32 || SHADER[id -1] == 0 {
            panic("invalid paint shader");
        }
        let prog = SHADER[id -1];
        program(prog);
        uniform2(prog, "uResolution", f32(s.w), f32(s.h));
        let loc = game.glProc("glGetUniformLocation") as fn(u32, cstr): i32;
        let u = game.glProc("glUniform1f") as fn(i32, f32);
        u(loc(prog, cstr("uTime")), f[15]);
        pass(s, cur, 1, prog);
        cur = 1;
    }
    if f[17] != 0 || f[18] != 0 {
        let projectedDst = if cur == 0 {
            2
        } else {
            0
        };
        project(s.tex[cur], s, projectedDst, box, f[17], f[18], f[16], true);
        cur = projectedDst;
    }
    let out = s.tex[cur];
    game.p2LayerEnd();
    DEPTH -= 1;
    LDEPTH -= 1;
    game.p2SetBackdropBase(BASESTACK[DEPTH]);
    restore(SAVED[DEPTH]);
    game.profUiZone(zone);
    return out;
}
