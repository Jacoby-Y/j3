// Part of j3.gfx.post (shaders, compile, link, init); the module doc and `use`s are in ../post.j3.
module j3.gfx.post;

// The fullscreen triangle (from `gl_VertexID`, no vertex buffer) and the plain "source over" pass are shader fns
// (`j3c doc shaders`); the other fragments below are still GLSL text and read the varying as `v_uv`.
#[varying]
struct Full { position: vec4; uv: vec2; }
#[uniform] let uTex: sampler2D;
#[uniform] let uBack: sampler2D;

#[shader(vertex)]
fn vsFull(): Full {
    let id = @vertexId();
    let p = vec2(f32((id << 1) & 2), f32(id & 2));
    return Full { position: vec4(p * 2.0 - 1.0, 0.0, 1.0), uv: p };
}

/// Premultiplied source over the backdrop.
#[shader(fragment)]
fn fsOver(v: Full): vec4 {
    let c = @texture(uTex, v.uv);
    return c + @texture(uBack, v.uv) * (1.0 - c.a);
}

const OVER_PROG: Source = @shader(vsFull, fsOver);
const FS_BLUR: string = "#version 330 core\nin vec2 v_uv; uniform sampler2D uTex; uniform vec2 uStep; uniform vec2 uSigma; out vec4 oColor; void main(){vec4 c=vec4(0);float total=0.0;for(int i=-12;i<=12;i++){float d=float(i)*uSigma.y;float w=exp(-0.5*d*d/(uSigma.x*uSigma.x)); c+=textureLod(uTex,v_uv+float(i)*uStep,uSigma.y>1.0?ceil(log2(uSigma.y)):0.0)*w;total+=w;}oColor=c/total;}";
const FS_BRIGHT: string = "#version 330 core\nin vec2 v_uv;uniform sampler2D uTex;uniform vec2 uAmount;out vec4 oColor;void main(){vec4 c=texture(uTex,v_uv);float l=max(max(c.r,c.g),c.b);float t=smoothstep(uAmount.x,uAmount.x+0.15,l);oColor=vec4(c.rgb*t,c.a*t);}";
const FS_FX: string = "#version 330 core\nin vec2 v_uv;uniform sampler2D uTex;uniform sampler2D uBloom;uniform sampler2D uBack;uniform vec4 uA;uniform vec4 uB;uniform vec4 uC;uniform vec4 uD;uniform vec2 uE;uniform vec2 uResolution;uniform vec4 uBox;out vec4 oColor;\nvoid main(){vec2 uv=v_uv;vec2 local=(uv-uBox.xy)/max(uBox.zw,vec2(0.00001));vec2 q=local*2.0-1.0;if(uB.y>0.0){q*=1.0+dot(q,q)*0.09*uB.y;local=q*0.5+0.5;uv=uBox.xy+local*uBox.zw;if(any(lessThan(local,vec2(0)))||any(greaterThan(local,vec2(1)))){oColor=vec4(0);return;}}vec4 p=texture(uTex,uv);vec3 c=p.a>0.00001?p.rgb/p.a:vec3(0);vec4 bloom=texture(uBloom,uv);float a=clamp(p.a+bloom.a*uA.x,0.0,1.0);vec3 pm=p.rgb+bloom.rgb*uA.x;c=a>0.00001?pm/a:vec3(0);float noise=fract(sin(dot(floor(uv*uResolution)+uE.y,vec2(12.9898,78.233)))*43758.5453)-0.5;c+=noise*uA.z;c*=1.0-uA.w*(0.5+0.5*cos(floor(uv.y*uResolution.y)*3.14159265));c*=1.0-uB.y*0.3*dot(local-0.5,local-0.5);c*=uB.z;c=(c-0.5)*uB.w+0.5;float lum=dot(c,vec3(0.2126,0.7152,0.0722));c=mix(vec3(lum),c,uC.x);lum=dot(c,vec3(0.2126,0.7152,0.0722));c=mix(c,vec3(lum),uC.y);vec3 sep=vec3(dot(c,vec3(0.393,0.769,0.189)),dot(c,vec3(0.349,0.686,0.168)),dot(c,vec3(0.272,0.534,0.131)));c=mix(c,sep,uC.z);c=mix(c,1.0-c,uC.w);float cs=cos(uD.x);float sn=sin(uD.x);c=vec3(dot(c,vec3(.213+.787*cs-.213*sn,.715-.715*cs-.715*sn,.072-.072*cs+.928*sn)),dot(c,vec3(.213-.213*cs+.143*sn,.715+.285*cs+.140*sn,.072-.072*cs-.283*sn)),dot(c,vec3(.213-.213*cs-.787*sn,.715-.715*cs+.715*sn,.072+.928*cs+.072*sn)));vec4 back=texture(uBack,v_uv);vec3 b=back.a>0.00001?back.rgb/back.a:back.rgb;vec3 mixed=c;if(uD.y>0.5&&uD.y<1.5)mixed=b*c;else if(uD.y<2.5&&uD.y>1.5)mixed=1.0-(1.0-b)*(1.0-c);else if(uD.y<3.5&&uD.y>2.5)mixed=mix(2.0*b*c,1.0-2.0*(1.0-b)*(1.0-c),step(vec3(0.5),b));else if(uD.y>3.5)mixed=min(b+c,vec3(1));if(uD.y>0.5)c=mix(c,mixed,back.a);oColor=vec4(clamp(c,0.0,1.0)*a,a);}";
const VS_PROJECT: string = "#version 330 core\nlayout(location=0)in vec4 aPos;layout(location=1)in vec2 aUv;out vec2 vUv;void main(){gl_Position=aPos;vUv=aUv;}";
const FS_PROJECT: string = "#version 330 core\nin vec2 vUv;uniform sampler2D uTex;out vec4 oColor;void main(){oColor=texture(uTex,vUv);}";

fn compile(kind: u32, src: string): u32 {
    let mk = game.glProc("glCreateShader") as fn(u32): u32;
    let sh = mk(kind);
    let source = game.glProc("glShaderSource") as fn(u32, i32, ptr, ptr);
    let full = game.prepGl(src);
    let p = full.ptr as ptr;
    let n = i32(full.len);
    source(sh, 1, &p as ptr, &n as ptr);
    let comp = game.glProc("glCompileShader") as fn(u32);
    comp(sh);
    let status = game.glProc("glGetShaderiv") as fn(u32, u32, ptr);
    let ok: i32 = 0;
    status(sh, 0x8B81, &ok as ptr);
    if ok == 0 {
        let log = game.glProc("glGetShaderInfoLog") as fn(u32, i32, ptr, ptr);
        let len: i32 = 0;
        log(sh, 4095, &len as ptr, &LOG[0] as ptr);
        printLn([] u8 {
            ptr: &LOG[0], len: int(len)
        }
        as string);
        let del = game.glProc("glDeleteShader") as fn(u32);
        del(sh);
        return 0;
    }
    return sh;
}
fn link(vsrc: string, fsrc: string): u32 {
    let vs = compile(0x8B31, vsrc);
    let fs = compile(0x8B30, fsrc);
    let del = game.glProc("glDeleteShader") as fn(u32);
    if vs == 0 || fs == 0 {
        if vs != 0 {
            del(vs);
        }
        if fs != 0 {
            del(fs);
        }
        return 0;
    }
    let mk = game.glProc("glCreateProgram") as fn(): u32;
    let p = mk();
    let attach = game.glProc("glAttachShader") as fn(u32, u32);
    attach(p, vs);
    attach(p, fs);
    let linkFn = game.glProc("glLinkProgram") as fn(u32);
    linkFn(p);
    del(vs);
    del(fs);
    let status = game.glProc("glGetProgramiv") as fn(u32, u32, ptr);
    let ok: i32 = 0;
    status(p, 0x8B82, &ok as ptr);
    if ok == 0 {
        let log = game.glProc("glGetProgramInfoLog") as fn(u32, i32, ptr, ptr);
        let len: i32 = 0;
        log(p, 4095, &len as ptr, &LOG[0] as ptr);
        printLn([] u8 {
            ptr: &LOG[0], len: int(len)
        }
        as string);
        let delp = game.glProc("glDeleteProgram") as fn(u32);
        delp(p);
        return 0;
    }
    return p;
}
fn init() {
    if READY {
        return;
    }
    if !game.usingGl() {
        panic("post effects require GL");
    }
    BLUR = link(OVER_PROG.vert, FS_BLUR);
    FX = link(OVER_PROG.vert, FS_FX);
    BRIGHT = link(OVER_PROG.vert, FS_BRIGHT);
    PROJECT = link(VS_PROJECT, FS_PROJECT);
    OVER = link(OVER_PROG.vert, OVER_PROG.frag);
    if BLUR == 0 || FX == 0 || BRIGHT == 0 || PROJECT == 0 || OVER == 0 {
        panic("post shader compilation");
    }
    let gen = game.glProc("glGenVertexArrays") as fn(i32, ptr);
    gen(1, &VAO as ptr);
    let genb = game.glProc("glGenBuffers") as fn(i32, ptr);
    genb(1, &VBO as ptr);
    READY = true;
    game.addGlShutdown(shutdown);
}
