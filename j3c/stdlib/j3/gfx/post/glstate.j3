// Part of j3.gfx.post (GL state get/set, save and restore); the module doc and `use`s are in ../post.j3.
module j3.gfx.post;

fn get(key: u32): i32 {
    let f = game.glProc("glGetIntegerv") as fn(u32, ptr);
    let v: i32 = 0;
    f(key, &v as ptr);
    return v;
}
fn enabled(key: u32): bool {
    let f = game.glProc("glIsEnabled") as fn(u32): u8;
    return f(key) != 0;
}
fn enable(key: u32, on: bool) {
    if on {
        let f = game.glProc("glEnable") as fn(u32);
        f(key);
    }
    else {
        let dis = game.glProc("glDisable") as fn(u32);
        dis(key);
    }
}
fn active(unit: int) {
    let f = game.glProc("glActiveTexture") as fn(u32);
    f(0x84C0 + u32(unit));
}
fn texture(tex: u32) {
    let f = game.glProc("glBindTexture") as fn(u32, u32);
    f(0x0DE1, tex);
}
fn framebuffer(key: u32, fb: u32) {
    let f = game.glProc("glBindFramebuffer") as fn(u32, u32);
    f(key, fb);
}
fn program(prog: u32) {
    let f = game.glProc("glUseProgram") as fn(u32);
    f(prog);
}
fn vao(id: u32) {
    let f = game.glProc("glBindVertexArray") as fn(u32);
    f(id);
}
fn viewport(x: i32, y: i32, w: i32, h: i32) {
    let f = game.glProc("glViewport") as fn(i32, i32, i32, i32);
    f(x, y, w, h);
}
fn uniform2(prog: u32, name: string, x: f32, y: f32) {
    let loc = game.glProc("glGetUniformLocation") as fn(u32, cstr): i32;
    let f = game.glProc("glUniform2f") as fn(i32, f32, f32);
    f(loc(prog, cstr(name)), x, y);
}
fn uniform4(prog: u32, name: string, x: f32, y: f32, z: f32, w: f32) {
    let loc = game.glProc("glGetUniformLocation") as fn(u32, cstr): i32;
    let f = game.glProc("glUniform4f") as fn(i32, f32, f32, f32, f32);
    f(loc(prog, cstr(name)), x, y, z, w);
}
fn sampler(prog: u32, name: string, unit: i32) {
    let loc = game.glProc("glGetUniformLocation") as fn(u32, cstr): i32;
    let f = game.glProc("glUniform1i") as fn(i32, i32);
    f(loc(prog, cstr(name)), unit);
}
fn save(): Saved {
    let s = Saved {
        vp:[0, 0, 0, 0], sc:[0, 0, 0, 0], color:[0, 0, 0, 0], clear:[0, 0, 0, 0], textures:[0, 0, 0, 0]
    };
    let gi = game.glProc("glGetIntegerv") as fn(u32, ptr);
    let gf = game.glProc("glGetFloatv") as fn(u32, ptr);
    gi(0x0BA2, &s.vp[0] as ptr);
    gi(0x0C10, &s.sc[0] as ptr);
    gi(0x0C23, &s.color[0] as ptr);
    gf(0x0C22, &s.clear[0] as ptr);
    s.prog = get(0x8B8D);
    s.vao = get(0x85B5);
    s.buf = get(0x8894);
    s.draw = get(0x8CA6);
    s.read = get(0x8CAA);
    s.active = get(0x84E0);
    s.src = get(0x80C9);
    s.dst = get(0x80C8);
    s.srca = get(0x80CB);
    s.dsta = get(0x80CA);
    s.depth = enabled(0x0B71);
    s.cull = enabled(0x0B44);
    s.blend = enabled(0x0BE2);
    s.clip = enabled(0x0C11);
    s.stencil = enabled(0x0B90);
    s.srgb = enabled(0x8DB9);
    for i in 0.. 4 {
        active(i);
        s.textures[i] = get(0x8069);
    }
    let a = game.glProc("glActiveTexture") as fn(u32);
    a(u32(s.active));
    return s;
}
fn restore(s: Saved) {
    framebuffer(0x8CA9, u32(s.draw));
    framebuffer(0x8CA8, u32(s.read));
    program(u32(s.prog));
    vao(u32(s.vao));
    let bind = game.glProc("glBindBuffer") as fn(u32, u32);
    bind(0x8892, u32(s.buf));
    for i in 0.. 4 {
        active(i);
        texture(u32(s.textures[i]));
    }
    let a = game.glProc("glActiveTexture") as fn(u32);
    a(u32(s.active));
    let blend = game.glProc("glBlendFuncSeparate") as fn(u32, u32, u32, u32);
    blend(u32(s.src), u32(s.dst), u32(s.srca), u32(s.dsta));
    viewport(s.vp[0], s.vp[1], s.vp[2], s.vp[3]);
    let sc = game.glProc("glScissor") as fn(i32, i32, i32, i32);
    sc(s.sc[0], s.sc[1], s.sc[2], s.sc[3]);
    let mask = game.glProc("glColorMask") as fn(u8, u8, u8, u8);
    mask(u8(s.color[0]), u8(s.color[1]), u8(s.color[2]), u8(s.color[3]));
    let clear = game.glProc("glClearColor") as fn(f32, f32, f32, f32);
    clear(s.clear[0], s.clear[1], s.clear[2], s.clear[3]);
    enable(0x0B71, s.depth);
    enable(0x0B44, s.cull);
    enable(0x0BE2, s.blend);
    enable(0x0C11, s.clip);
    enable(0x0B90, s.stencil);
    enable(0x8DB9, s.srgb);
}
fn raw() {
    enable(0x0B71, false);
    enable(0x0B44, false);
    enable(0x0BE2, false);
    enable(0x0C11, false);
    enable(0x0B90, false);
    enable(0x8DB9, false);
    let f = game.glProc("glColorMask") as fn(u8, u8, u8, u8);
    f(1, 1, 1, 1);
}
