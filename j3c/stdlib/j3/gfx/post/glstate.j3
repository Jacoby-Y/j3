// Part of j3.gfx.post (GL state get/set, save and restore); the module doc and `use`s are in ../post.j3.
module j3.gfx.post;

/// Look up every entry point `GL` holds (once per context, from `init`).
fn loadGl() {
    GL.getInt = game.glProc("glGetIntegerv");
    GL.getFloat = game.glProc("glGetFloatv");
    GL.isOn = game.glProc("glIsEnabled");
    GL.enable = game.glProc("glEnable");
    GL.disable = game.glProc("glDisable");
    GL.active = game.glProc("glActiveTexture");
    GL.bindTex = game.glProc("glBindTexture");
    GL.bindFb = game.glProc("glBindFramebuffer");
    GL.useProg = game.glProc("glUseProgram");
    GL.bindVa = game.glProc("glBindVertexArray");
    GL.bindBuf = game.glProc("glBindBuffer");
    GL.viewport = game.glProc("glViewport");
    GL.scissor = game.glProc("glScissor");
    GL.loc = game.glProc("glGetUniformLocation");
    GL.u1i = game.glProc("glUniform1i");
    GL.u1f = game.glProc("glUniform1f");
    GL.u2f = game.glProc("glUniform2f");
    GL.u4f = game.glProc("glUniform4f");
    GL.blendSep = game.glProc("glBlendFuncSeparate");
    GL.colorMask = game.glProc("glColorMask");
    GL.clearColor = game.glProc("glClearColor");
    GL.clear = game.glProc("glClear");
    GL.draw = game.glProc("glDrawArrays");
    GL.copy = game.glProc("glCopyTexSubImage2D");
    GL.readBuf = game.glProc("glReadBuffer");
    GL.mip = game.glProc("glGenerateMipmap");
    GL.texParam = game.glProc("glTexParameteri");
}
fn get(key: u32): i32 {
    let f = GL.getInt as fn(u32, ptr);
    let v: i32 = 0;
    f(key, &v as ptr);
    return v;
}
fn enabled(key: u32): bool {
    let f = GL.isOn as fn(u32): u8;
    return f(key) != 0;
}
fn enable(key: u32, on: bool) {
    if on {
        let f = GL.enable as fn(u32);
        f(key);
    }
    else {
        let dis = GL.disable as fn(u32);
        dis(key);
    }
}
fn active(unit: int) {
    let f = GL.active as fn(u32);
    f(0x84C0 + u32(unit));
}
fn texture(tex: u32) {
    let f = GL.bindTex as fn(u32, u32);
    f(0x0DE1, tex);
}
fn framebuffer(key: u32, fb: u32) {
    let f = GL.bindFb as fn(u32, u32);
    f(key, fb);
}
fn program(prog: u32) {
    let f = GL.useProg as fn(u32);
    f(prog);
}
fn vao(id: u32) {
    let f = GL.bindVa as fn(u32);
    f(id);
}
fn viewport(x: i32, y: i32, w: i32, h: i32) {
    let f = GL.viewport as fn(i32, i32, i32, i32);
    f(x, y, w, h);
}
fn scissor(x: i32, y: i32, w: i32, h: i32) {
    let f = GL.scissor as fn(i32, i32, i32, i32);
    f(x, y, w, h);
}
fn clearRgba() {
    let cc = GL.clearColor as fn(f32, f32, f32, f32);
    cc(0, 0, 0, 0);
    let cl = GL.clear as fn(u32);
    cl(0x4000);
}
fn draw3() {
    let draw = GL.draw as fn(u32, i32, i32);
    game.profDraw(1);
    draw(4, 0, 3);
}
/// Copy a framebuffer rect of the bound read framebuffer into the bound texture at (0, 0).
fn copyTo(x: i32, y: i32, w: i32, h: i32) {
    let copy = GL.copy as fn(u32, i32, i32, i32, i32, i32, i32, i32);
    copy(0x0DE1, 0, 0, 0, x, y, w, h);
}
/// Cached `glGetUniformLocation`; `name` is a string literal (its address is the key).
fn uloc(prog: u32, name: string): i32 {
    let key = int(name.ptr as ptr);
    for i in 0.. ULC {
        if ULP[i] == prog && ULN[i] == key {
            return ULV[i];
        }
    }
    let loc = GL.loc as fn(u32, cstr): i32;
    let v = loc(prog, cstr(name));
    if ULC < 128 {
        ULP[ULC] = prog;
        ULN[ULC] = key;
        ULV[ULC] = v;
        ULC += 1;
    }
    return v;
}
/// Forget `prog`'s cached locations (it was deleted; GL may reuse the id).
fn uforget(prog: u32) {
    let i = 0;
    while i < ULC {
        if ULP[i] == prog {
            ULC -= 1;
            ULP[i] = ULP[ULC];
            ULN[i] = ULN[ULC];
            ULV[i] = ULV[ULC];
        } else {
            i += 1;
        }
    }
}
fn uniform1(prog: u32, name: string, x: f32) {
    let f = GL.u1f as fn(i32, f32);
    f(uloc(prog, name), x);
}
fn uniform2(prog: u32, name: string, x: f32, y: f32) {
    let f = GL.u2f as fn(i32, f32, f32);
    f(uloc(prog, name), x, y);
}
fn uniform4(prog: u32, name: string, x: f32, y: f32, z: f32, w: f32) {
    let f = GL.u4f as fn(i32, f32, f32, f32, f32);
    f(uloc(prog, name), x, y, z, w);
}
fn sampler(prog: u32, name: string, unit: i32) {
    let f = GL.u1i as fn(i32, i32);
    f(uloc(prog, name), unit);
}
fn save(): Saved {
    let s = Saved {
        vp:[0, 0, 0, 0], sc:[0, 0, 0, 0], color:[0, 0, 0, 0], clear:[0, 0, 0, 0], textures:[0, 0, 0, 0]
    };
    let gi = GL.getInt as fn(u32, ptr);
    let gf = GL.getFloat as fn(u32, ptr);
    gi(0x0BA2, &s.vp[0] as ptr);
    gi(0x0C10, &s.sc[0] as ptr);
    gi(0x0C23, &s.color[0] as ptr);
    gf(0x0C22, &s.clear[0] as ptr);
    s.prog = get(0x8B8D);
    s.vao = get(0x85B5);
    s.buf = get(0x8894);
    s.draw = get(0x8CA6);
    s.read = get(0x8CAA);
    s.active = get(0x84E0);
    s.src = get(0x80C9);
    s.dst = get(0x80C8);
    s.srca = get(0x80CB);
    s.dsta = get(0x80CA);
    s.depth = enabled(0x0B71);
    s.cull = enabled(0x0B44);
    s.blend = enabled(0x0BE2);
    s.clip = enabled(0x0C11);
    s.stencil = enabled(0x0B90);
    s.srgb = enabled(0x8DB9);
    for i in 0.. 4 {
        active(i);
        s.textures[i] = get(0x8069);
    }
    let a = GL.active as fn(u32);
    a(u32(s.active));
    return s;
}
fn restore(s: Saved) {
    framebuffer(0x8CA9, u32(s.draw));
    framebuffer(0x8CA8, u32(s.read));
    program(u32(s.prog));
    vao(u32(s.vao));
    let bind = GL.bindBuf as fn(u32, u32);
    bind(0x8892, u32(s.buf));
    for i in 0.. 4 {
        active(i);
        texture(u32(s.textures[i]));
    }
    let a = GL.active as fn(u32);
    a(u32(s.active));
    let blend = GL.blendSep as fn(u32, u32, u32, u32);
    blend(u32(s.src), u32(s.dst), u32(s.srca), u32(s.dsta));
    viewport(s.vp[0], s.vp[1], s.vp[2], s.vp[3]);
    scissor(s.sc[0], s.sc[1], s.sc[2], s.sc[3]);
    let mask = GL.colorMask as fn(u8, u8, u8, u8);
    mask(u8(s.color[0]), u8(s.color[1]), u8(s.color[2]), u8(s.color[3]));
    let clear = GL.clearColor as fn(f32, f32, f32, f32);
    clear(s.clear[0], s.clear[1], s.clear[2], s.clear[3]);
    enable(0x0B71, s.depth);
    enable(0x0B44, s.cull);
    enable(0x0BE2, s.blend);
    enable(0x0C11, s.clip);
    enable(0x0B90, s.stencil);
    enable(0x8DB9, s.srgb);
}
fn raw() {
    enable(0x0B71, false);
    enable(0x0B44, false);
    enable(0x0BE2, false);
    enable(0x0C11, false);
    enable(0x0B90, false);
    enable(0x8DB9, false);
    let f = GL.colorMask as fn(u8, u8, u8, u8);
    f(1, 1, 1, 1);
}
