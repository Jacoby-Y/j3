// Part of j3.gfx.post (render targets); the module doc and `use`s are in ../post.j3.
module j3.gfx.post;

fn allocate(s: &Surface, i: int) {
    if s.tex[i] != 0 {
        return;
    }
    let gen = game.glProc("glGenTextures") as fn(i32, ptr);
    gen(1, &s.tex[i] as ptr);
    texture(s.tex[i]);
    let image = game.glProc("glTexImage2D") as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    image(0x0DE1, 0, 0x8058, i32(s.w), i32(s.h), 0, 0x1908, 0x1401, 0 as ptr);
    let param = game.glProc("glTexParameteri") as fn(u32, u32, i32);
    param(0x0DE1, 0x2801, 0x2601);
    param(0x0DE1, 0x2800, 0x2601);
    param(0x0DE1, 0x2802, 0x812F);
    param(0x0DE1, 0x2803, 0x812F);
    let gf = game.glProc("glGenFramebuffers") as fn(i32, ptr);
    gf(1, &s.fb[i] as ptr);
    framebuffer(0x8CA9, s.fb[i]);
    let attach = game.glProc("glFramebufferTexture2D") as fn(u32, u32, u32, u32, i32);
    attach(0x8CA9, 0x8CE0, 0x0DE1, s.tex[i], 0);
    let check = game.glProc("glCheckFramebufferStatus") as fn(u32): u32;
    if check(0x8CA9) != 0x8CD5 {
        panic("post framebuffer incomplete");
    }
}
pub fn target(w: int, h: int): int {
    init();
    game.p2Flush();
    let old = save();
    active(0);
    if w < 1 || h < 1 || w > 8192 || h > 8192 {
        panic("paint target dimensions must be 1..8192");
    }
    for i in 0.. 96 {
        if !SURF[i].live {
            SURF[i].live = true;
            SURF[i].w = w;
            SURF[i].h = h;
            SURF[i].dirty = [0, 0, w, h];
            allocate(&SURF[i], 0);
            restore(old);
            return i + 1;
        }
    }
    panic("paint target limit 96");
    return 0;
}
fn surface(handle: int): &Surface {
    if handle < 1 || handle > 96 || !SURF[handle -1].live {
        panic("invalid paint target");
    }
    return &SURF[handle -1];
}
pub fn targetTexture(handle: int): Texture {
    let s = surface(handle);
    return Texture {
        raw: int(s.tex[0]) as ptr, w: i32(s.w), h: i32(s.h)
    };
}
pub fn destroyTarget(handle: int) {
    let s = surface(handle);
    for i in 0.. DEPTH {
        if STACK[i] == handle {
            panic("cannot destroy active paint target");
        }
    }
    game.p2Flush();
    let dt = game.glProc("glDeleteTextures") as fn(i32, ptr);
    dt(4, &s.tex[0] as ptr);
    let df = game.glProc("glDeleteFramebuffers") as fn(i32, ptr);
    df(4, &s.fb[0] as ptr);
    for i in 0.. 4 {
        s.tex[i] = 0;
        s.fb[i] = 0;
    }
    s.live = false;
}
fn begin(handle: int, kind: int) {
    game.p2Flush();
    if DEPTH >= 16 {
        panic("paint capture nesting limit");
    }
    for i in 0.. DEPTH {
        if STACK[i] == handle {
            panic("paint target feedback");
        }
    }
    SAVED[DEPTH] = save();
    STACK[DEPTH] = handle;
    KIND[DEPTH] = kind;
    // a lazy backdrop stays lazy: reading it would copy it
    BASELAZY[DEPTH] = game.p2BackdropLazy();
    BASESTACK[DEPTH] = if BASELAZY[DEPTH] { 0 } else { game.p2BackdropBase() };
    DEPTH += 1;
    let s = surface(handle);
    framebuffer(0x8CA9, s.fb[0]);
    raw();
    viewport(0, 0, i32(s.w), i32(s.h));
    if kind != 1 {
        clearRgba();
        return;
    }
    // a layer target is transparent outside what its last group drew: clear only that
    let d = s.dirty;
    if d[2] <= d[0] || d[3] <= d[1] {
        return;
    }
    let full = d[0] <= 0 && d[1] <= 0 && d[2] >= s.w && d[3] >= s.h;
    if !full {
        enable(0x0C11, true);
        scissor(i32(d[0]), i32(s.h - d[3]), i32(d[2] - d[0]), i32(d[3] - d[1]));
    }
    clearRgba();
    if !full {
        enable(0x0C11, false);
    }
    s.dirty = [0, 0, 0, 0];
}

/// An effect target of exactly `w` x `h` with images 0..2 (and 3 for `back`), least recently used one replaced.
fn pooled(w: int, h: int, back: bool): &Surface {
    POOLTICK += 1;
    let pick = -1;
    for i in 0.. 32 {
        if POOL[i] != 0 && SURF[POOL[i] -1].live && SURF[POOL[i] -1].w == w && SURF[POOL[i] -1].h == h {
            pick = i;
            break;
        }
    }
    if pick < 0 {
        pick = 0;
        for i in 0.. 32 {
            if POOL[i] == 0 || !SURF[POOL[i] -1].live {
                pick = i;
                break;
            }
            if POOLAT[i] < POOLAT[pick] {
                pick = i;
            }
        }
        if POOL[pick] != 0 && SURF[POOL[pick] -1].live {
            destroyTarget(POOL[pick]);
        }
        POOL[pick] = target(w, h);
    }
    POOLAT[pick] = POOLTICK;
    let s = surface(POOL[pick]);
    allocate(s, 1);
    allocate(s, 2);
    if back {
        allocate(s, 3);
    }
    return s;
}
pub fn beginTarget(handle: int) {
    init();
    let s = surface(handle);
    begin(handle, 0);
    game.p2SurfaceBegin(s.w, s.h);
    game.p2SetBackdropBase(0);
}
pub fn endTarget() {
    if DEPTH < 1 || KIND[DEPTH -1] != 0 {
        panic("unbalanced paint target");
    }
    game.p2SurfaceEnd();
    DEPTH -= 1;
    restoreBase(DEPTH);
    restore(SAVED[DEPTH]);
}

/// Put back the backdrop base `begin` saved at stack slot `i`.
fn restoreBase(i: int) {
    if BASELAZY[i] {
        game.p2SetBackdropLazy(resolveBase);
    } else {
        game.p2SetBackdropBase(BASESTACK[i]);
    }
}
