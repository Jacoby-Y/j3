// Part of j3.gfx (GL function pointers and lit program variants).

module j3.gfx;

/// Loaded OpenGL 3.3 function pointers.
struct Procs {
    /// glViewport entry.
    viewport: ptr;
    /// glScissor entry.
    scissor: ptr;
    /// glClearColor entry.
    clearColor: ptr;
    /// glClear entry.
    clear: ptr;
    /// glEnable entry.
    enable: ptr;
    /// glDisable entry.
    disable: ptr;
    /// glDepthFunc entry.
    depthFunc: ptr;
    /// glCullFace entry.
    cullFace: ptr;
    /// glPolygonOffset entry.
    polygonOffset: ptr;
    /// glGenTextures entry.
    genTextures: ptr;
    /// glBindTexture entry.
    bindTexture: ptr;
    /// glTexImage2D entry.
    texImage2D: ptr;
    /// glTexParameteri entry.
    texParameteri: ptr;
    /// glTexParameterfv entry.
    texParameterfv: ptr;
    /// glTexParameterf entry.
    texParameterf: ptr;
    /// glGenerateMipmap entry.
    generateMipmap: ptr;
    /// glGetFloatv entry.
    getFloatv: ptr;
    /// glGenFramebuffers entry.
    genFramebuffers: ptr;
    /// glBindFramebuffer entry.
    bindFramebuffer: ptr;
    /// glFramebufferTexture2D entry.
    framebufferTexture2D: ptr;
    /// glCheckFramebufferStatus entry.
    checkFramebufferStatus: ptr;
    /// glDrawBuffers entry.
    drawBuffer: ptr;
    /// glReadBuffer entry.
    readBuffer: ptr;
    /// glReadPixels entry.
    readPixels: ptr;
    /// glGenVertexArrays entry.
    genVertexArrays: ptr;
    /// glBindVertexArray entry.
    bindVertexArray: ptr;
    /// glGenBuffers entry.
    genBuffers: ptr;
    /// glBindBuffer entry.
    bindBuffer: ptr;
    /// glBufferData entry.
    bufferData: ptr;
    /// glEnableVertexAttribArray entry.
    enableVertexAttribArray: ptr;
    /// glDisableVertexAttribArray entry.
    disableVertexAttribArray: ptr;
    /// glVertexAttribPointer entry.
    vertexAttribPointer: ptr;
    /// glVertexAttrib2f entry.
    vertexAttrib2f: ptr;
    /// glUseProgram entry.
    useProgram: ptr;
    /// glCreateShader entry.
    createShader: ptr;
    /// glShaderSource entry.
    shaderSource: ptr;
    /// glCompileShader entry.
    compileShader: ptr;
    /// glGetShaderiv entry.
    getShaderiv: ptr;
    /// glGetShaderInfoLog entry.
    getShaderInfoLog: ptr;
    /// glCreateProgram entry.
    createProgram: ptr;
    /// glAttachShader entry.
    attachShader: ptr;
    /// glLinkProgram entry.
    linkProgram: ptr;
    /// glGetProgramiv entry.
    getProgramiv: ptr;
    /// glGetProgramInfoLog entry.
    getProgramInfoLog: ptr;
    /// glDeleteShader entry.
    deleteShader: ptr;
    /// glGetUniformLocation entry.
    getUniformLocation: ptr;
    /// glUniform1i entry.
    uniform1i: ptr;
    /// glUniform1f entry.
    uniform1f: ptr;
    /// glUniform2f entry.
    uniform2f: ptr;
    /// glUniform3f entry.
    uniform3f: ptr;
    /// glUniform4f entry.
    uniform4f: ptr;
    /// glCopyTexSubImage2D entry.
    copyTexSubImage2D: ptr;
    /// glUniformMatrix4fv entry.
    uniformMatrix4fv: ptr;
    /// glActiveTexture entry.
    activeTexture: ptr;
    /// glDrawArrays entry.
    drawArrays: ptr;
    /// glDeleteBuffers entry.
    deleteBuffers: ptr;
    /// glDeleteVertexArrays entry.
    deleteVertexArrays: ptr;
    /// glDeleteTextures entry.
    deleteTextures: ptr;
    /// glDeleteFramebuffers entry.
    deleteFramebuffers: ptr;
    /// glDeleteProgram entry.
    deleteProgram: ptr;
    /// glBlendFunc entry.
    blendFunc: ptr;
    blendFuncSeparate: ptr;
    blendEquationSeparate: ptr;
    /// glDepthMask entry.
    depthMask: ptr;
    /// glDrawArraysInstanced entry.
    drawArraysInstanced: ptr;
    /// glVertexAttribDivisor entry.
    vertexAttribDivisor: ptr;
}

/// Global lit/shadow renderer state.
/// Uniform locations of one lit program variant (`LIT_*`).
struct LitLocs {
    prog: u32;
    lInst: i32;
    /// Lit uProj location.
    lProj: i32;
    /// Lit uView location.
    lView: i32;
    /// Lit uModel location.
    lModel: i32;
    /// Lit uLight location.
    lLight: i32;
    /// Lit uSun location.
    lSun: i32;
    /// Lit uSky location.
    lSky: i32;
    /// Lit uSunColor location.
    lSunColor: i32;
    /// Lit uEye location.
    lEye: i32;
    /// Lit uShadow location.
    lShadow: i32;
    /// Lit uFogStart location.
    lFog0: i32;
    /// Lit uFogEnd location.
    lFog1: i32;
    lPassTex: i32;
    /// Lit uAlbedo location.
    lAlbedo: i32;
    /// Lit uCutout location.
    lCutout: i32;
    /// Lit uFlat location. Above 0.5 replaces lighting with `uFlatColor`.
    lFlat: i32;
    /// Lit uFlatColor location.
    lFlatColor: i32;
    /// Lit uNudge location. Clip-space pixel shift for selection outlines.
    lNudge: i32;
    /// Lit uAlpha location.
    lAlpha: i32;
    /// Lit surface uniform locations (see `Surface`).
    lTint: i32;
    lGlow: i32;
    lSpec: i32;
    lShine: i32;
    lReflect: i32;
    lEdge: i32;
    lUvScale: i32;
    lUvOffset: i32;
    lIor: i32;
    lRough: i32;
    lGrab: i32;
    lGrabRect: i32;
    lSkyTex: i32;
    lHasSky: i32;
    /// Point-light position, color, and radius locations (`uLP[i]` ...), in the lit and
    /// the instanced program.
    lP: [8]i32;
    lC: [8]i32;
    lR: [8]i32;
    lTraceNear: i32;
    lMapOn: i32;
    lTraceOn: i32;
    lThickness: i32;
    lCloud: i32;
    lTraceShadowAll: i32;
    lBounces: i32;
    lSamples: i32;
    lTraceShadows: i32;
    lGrabbed: i32;
    /// Seconds since start, and the view size in pixels, for effects.
    lTime: i32;
    lResolution: i32;
}

/// The lit variant in use, and every one compiled so far (by flags; 0 until first use).
#[singleton]
let LIT: LitLocs;
#[singleton]
let LITS: [8]LitLocs;

/// Lit variant flags. Trace code slows every pixel of a program it's compiled into (GPU
/// registers), used or not, so each draw takes the smallest variant it needs.
const LIT_PLAIN: int = 0;
/// Traced sun shadows.
const LIT_SUN: int = 1;
/// Traced mirrors: one ray at a time, no path stack.
const LIT_MIRROR: int = 2;
/// Traced glass, which splits rays and needs the path stack (mirrors too).
const LIT_GLASS: int = 4;
