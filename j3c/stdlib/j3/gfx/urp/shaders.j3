/// Embedded OpenGL 3.3 shaders for the optional raytracer.
module j3.gfx.urp.shaders;

pub fn vertex(): string { return "#version 330 core\nout vec2 vUv;\nvoid main() {\n  vec2 uv = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n  vUv = uv;\n  gl_Position = vec4(uv * 2.0 - 1.0, 0.0, 1.0);\n}\n"; }
pub fn trace(): string { return "#version 330 core\nin vec2 vUv;\nout vec4 oColor;\nuniform vec2 uResolution;\nuniform vec3 uEye, uForward, uRight, uUp, uRoom;\nuniform int uSphereCount, uLightCount, uBounces, uLightSamples, uAaSamples;\nuniform vec4 uSphere[16], uMatA[16], uMatB[16];\nuniform vec4 uLightPR[4], uLightCI[4];\nstruct Hit { float t; vec3 p; vec3 n; int kind; int id; };\nstruct Work { vec3 o; vec3 d; vec3 weight; int depth; int medium; };\nfloat hash12(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }\nHit closest(vec3 ro, vec3 rd) {\n  Hit h; h.t = 1e20; h.kind = -1; h.id = -1;\n  for (int i=0; i<16; ++i) {\n    if (i>=uSphereCount) break;\n    vec3 oc = ro-uSphere[i].xyz;\n    float b = dot(oc,rd), c = dot(oc,oc)-uSphere[i].w*uSphere[i].w;\n    float disc = b*b-c;\n    if (disc < 0.0) continue;\n    float s = sqrt(disc), t = -b-s;\n    if (t<0.001) t=-b+s;\n    if (t>0.001 && t<h.t) {\n      h.t=t; h.p=ro+rd*t; h.n=normalize(h.p-uSphere[i].xyz);\n      h.kind=int(uMatB[i].x+0.5); h.id=i;\n    }\n  }\n  for (int axis=0; axis<3; ++axis) {\n    for (int sign=-1; sign<=1; sign+=2) {\n      if (axis==2 && sign==1) continue;\n      float plane = axis==1 ? (sign<0 ? 0.0 : uRoom.y) : float(sign)*uRoom[axis];\n      float denom=rd[axis];\n      if (abs(denom)<0.0001) continue;\n      float t=(plane-ro[axis])/denom;\n      if (t<0.001 || t>=h.t) continue;\n      vec3 p=ro+rd*t;\n      if (abs(p.x)>uRoom.x+0.001 || p.y< -0.001 || p.y>uRoom.y+0.001 || p.z< -uRoom.z-0.001 || p.z>uRoom.z+0.001) continue;\n      h.t=t; h.p=p; h.n=vec3(0.0); h.n[axis]=-float(sign);\n      h.kind=0; h.id=-1;\n      if (axis==1 && sign==1) {\n        for (int l=0; l<4; ++l) {\n          if (l>=uLightCount) break;\n          if (abs(p.x-uLightPR[l].x)<uLightPR[l].w && abs(p.z-uLightPR[l].z)<uLightPR[l].w) { h.kind=4; h.id=l; break; }\n        }\n      }\n    }\n  }\n  return h;\n}\nfloat glassFresnel(float ior, float cosine) {\n  float f0=pow((ior-1.0)/(ior+1.0),2.0);\n  return f0+(1.0-f0)*pow(1.0-clamp(cosine,0.0,1.0),5.0);\n}\n// Equal-area disk approximation of a square emitter. The overlap fraction\n// varies continuously as a sphere moves across the emitter's angular footprint.\nfloat diskCover(float d, float r, float lightR) {\n  if (lightR<0.0001) return d<r ? 1.0 : 0.0;\n  if (d>=r+lightR) return 0.0;\n  if (d<=abs(r-lightR)) {\n    if (r>=lightR) return 1.0;\n    return r*r/(lightR*lightR);\n  }\n  float rr=r*r, aa=lightR*lightR, dd=d*d;\n  float x=clamp((dd+rr-aa)/(2.0*d*r),-1.0,1.0);\n  float y=clamp((dd+aa-rr)/(2.0*d*lightR),-1.0,1.0);\n  float edge=sqrt(max(0.0,(-d+r+lightR)*(d+r-lightR)*(d-r+lightR)*(d+r+lightR)));\n  float area=rr*acos(x)+aa*acos(y)-0.5*edge;\n  return clamp(area/(3.14159265*aa),0.0,1.0);\n}\n// Approximate the covered light area for each sphere. Opaque spheres block it;\n// glass applies the same Fresnel and distance tint model as camera rays.\nvec3 areaTransmission(vec3 point, vec4 light) {\n  vec3 toLight=light.xyz-point;\n  float totalDist=length(toLight);\n  vec3 axis=toLight/totalDist;\n  vec3 visibility=vec3(1.0);\n  for (int i=0;i<16;++i) {\n    if (i>=uSphereCount) break;\n    vec3 toSphere=uSphere[i].xyz-point;\n    float along=dot(toSphere,axis);\n    if (along<=0.001 || along>=totalDist) continue;\n    float radius=uSphere[i].w;\n    float lateral=length(toSphere-axis*along);\n    float lightRadius=1.12837917*light.w*along/totalDist;\n    float covered=diskCover(lateral,radius,lightRadius);\n    if (covered<=0.0) continue;\n    if (int(uMatB[i].x+0.5)!=3) {\n      visibility*=1.0-covered;\n      continue;\n    }\n    float impact=min(lateral,radius*0.999);\n    float cosine=sqrt(max(0.0,1.0-impact*impact/(radius*radius)));\n    float fres=glassFresnel(max(uMatB[i].y,1.01),cosine);\n    float inside=2.0*sqrt(max(0.0,radius*radius-impact*impact));\n    vec3 transmitted=pow(max(uMatA[i].rgb,vec3(0.001)),vec3(inside))*(1.0-fres)*(1.0-fres);\n    visibility*=mix(vec3(1.0),transmitted,covered);\n  }\n  return visibility;\n}\nvec3 directLight(Hit h, vec3 base, float ambient) {\n  vec3 total=base*ambient;\n  for (int l=0; l<4; ++l) {\n    if (l>=uLightCount) break;\n    vec3 visibility=areaTransmission(h.p+h.n*0.004,uLightPR[l]);\n    vec3 sum=vec3(0.0);\n    for (int s=0; s<8; ++s) {\n      if (s>=uLightSamples) break;\n      float x=(float((s*5)%8)+0.5)/8.0;\n      float z=(float((s*3)%8)+0.5)/8.0;\n      vec3 lp=uLightPR[l].xyz+vec3((x*2.0-1.0)*uLightPR[l].w,0.0,(z*2.0-1.0)*uLightPR[l].w);\n      vec3 to=lp-h.p;\n      float d2=dot(to,to), dist=sqrt(d2);\n      vec3 ld=to/dist;\n      float ndl=max(dot(h.n,ld),0.0);\n      if (ndl<=0.0) continue;\n      float fall=1.0/(1.0+0.11*d2);\n      sum+=uLightCI[l].rgb*uLightCI[l].w*ndl*fall*visibility;\n    }\n    total+=base*sum/float(max(uLightSamples,1));\n  }\n  return total;\n}\nvec3 pathColor(vec3 ro, vec3 rd, vec2 seed) {\n  Work stack[16]; int sp=1;\n  stack[0]=Work(ro,rd,vec3(1.0),0,-1);\n  vec3 result=vec3(0.0);\n  for (int path=0; path<32; ++path) {\n    if (sp==0) break;\n    Work w=stack[--sp];\n    for (int bounce=0; bounce<6; ++bounce) {\n      if (w.depth>=uBounces || max(w.weight.r,max(w.weight.g,w.weight.b))<0.008) break;\n      Hit h=closest(w.o,w.d);\n      if (w.medium>=0 && h.kind>=0) w.weight*=pow(max(uMatA[w.medium].rgb,vec3(0.001)),vec3(h.t));\n      if (h.kind<0) { result+=w.weight*vec3(0.22); break; }\n      if (h.kind==4) { result+=w.weight*uLightCI[h.id].rgb*uLightCI[h.id].w; break; }\n      if (h.kind==0 || h.kind==1) {\n        vec3 base=h.kind==0 ? vec3(0.9) : uMatA[h.id].rgb;\n        if (h.kind==0 && (abs(h.p.z+uRoom.z)<0.01 || h.p.y<0.01)) {\n          vec2 marks=abs(fract((h.p.y<0.01 ? h.p.xz : h.p.xy)*0.8)-0.5);\n          float seam=step(0.484,max(marks.x,marks.y));\n          base*=1.0-0.15*seam;\n        }\n        vec3 n=dot(w.d,h.n)<0.0 ? h.n : -h.n;\n        h.n=n;\n        result+=w.weight*directLight(h,base,h.kind==0 ? 0.22 : 0.08);\n        if (h.kind==1) {\n          float shininess=1.0-uMatA[h.id].w;\n          vec3 view=-w.d;\n          for (int l=0;l<4;++l) {\n            if (l>=uLightCount) break;\n            vec3 ld=normalize(uLightPR[l].xyz-h.p);\n            float spec=pow(max(dot(reflect(-ld,n),view),0.0),mix(8.0,96.0,shininess));\n            result+=w.weight*uLightCI[l].rgb*(spec*0.14*shininess*uLightCI[l].w)*areaTransmission(h.p+n*0.004,uLightPR[l]);\n          }\n        }\n        break;\n      }\n      vec3 n=dot(w.d,h.n)<0.0 ? h.n : -h.n;\n      if (h.kind==2) {\n        vec3 reflected=reflect(w.d,n);\n        float rough=clamp(uMatA[h.id].w,0.0,0.8);\n        vec3 jitter=vec3(hash12(seed+vec2(float(path),float(bounce))),hash12(seed+vec2(float(bounce),float(path)+17.0)),hash12(seed+vec2(float(path)+41.0,float(bounce))));\n        w.d=normalize(reflected+(jitter*2.0-1.0)*rough*0.35);\n        w.o=h.p+n*0.004;\n        w.weight*=uMatA[h.id].rgb;\n        w.depth++;\n        continue;\n      }\n      float ior=max(uMatB[h.id].y,1.01);\n      bool entering=dot(w.d,h.n)<0.0;\n      float eta=entering ? 1.0/ior : ior;\n      float cosi=clamp(dot(-w.d,n),0.0,1.0);\n      float fres=glassFresnel(ior,cosi);\n      vec3 refr=refract(w.d,n,eta);\n      vec3 refl=reflect(w.d,n);\n      if (length(refr)<0.1) {\n        w.o=h.p+n*0.004; w.d=refl; w.depth++;\n        continue;\n      }\n      if (sp<16 && fres>0.012) {\n        stack[sp++]=Work(h.p+n*0.004,refl,w.weight*fres,w.depth+1,w.medium);\n      }\n      w.o=h.p-n*0.004; w.d=normalize(refr);\n      w.weight*=1.0-fres;\n      w.medium=entering ? h.id : -1;\n      w.depth++;\n    }\n  }\n  return result;\n}\nvoid main() {\n  vec3 sum=vec3(0.0);\n  for (int s=0;s<4;++s) {\n    if (s>=uAaSamples) break;\n    vec2 jitter=vec2(0.0);\n    if (uAaSamples>1) jitter=(s==0 ? vec2(-0.25,-0.25) : s==1 ? vec2(0.25,0.25) : s==2 ? vec2(-0.25,0.25) : vec2(0.25,-0.25))/uResolution;\n    vec2 p=(vUv+jitter)*2.0-1.0;\n    p.x*=uResolution.x/uResolution.y;\n    vec3 rd=normalize(uForward+p.x*uRight*0.8+p.y*uUp*0.8);\n    sum+=pathColor(uEye,rd,gl_FragCoord.xy+float(s)*19.0);\n  }\n  vec3 linear=sum/float(max(uAaSamples,1));\n  vec3 mapped=linear/(vec3(1.0)+linear);\n  oColor=vec4(pow(mapped,vec3(1.0/2.2)),1.0);\n}\n"; }
pub fn present(): string { return "#version 330 core\nin vec2 vUv;\nout vec4 oColor;\nuniform sampler2D uImage;\nvoid main() { oColor=texture(uImage,vUv); }\n"; }
