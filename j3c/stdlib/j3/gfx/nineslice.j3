/// Nine-slice (CSS `border-image`) drawing: a texture cut by four insets into corners that keep their
/// size, edges that stretch along one axis, and a center that stretches along both. `layout` is
/// the pure geometry (insets larger than the image or the box shrink to fit); `draw` queues the cells
/// through `j3.gfx.paint`, so a panel is one batched draw.
///
/// ```
/// let s = nineslice.layout(48.0, 48.0, 12.0, 12.0, 12.0, 12.0, 200.0, 90.0, 12.0, 12.0, 12.0, 12.0);
/// nineslice.draw(tex, &s, Vec2 { x: 10.0, y: 10.0 }, true, white);
/// ```

module j3.gfx.nineslice;

use j3.game.{ Color, Texture };
use j3.gfx.paint;
use j3.math.{ min, Vec2 };

/// The four cut positions on each axis, in the source image and in the box: `x[0..3]` run left to right.
pub struct Slice9 {
    sx: [4]f32;
    sy: [4]f32;
    dx: [4]f32;
    dy: [4]f32;
}

/// One of the nine pieces: source rect and box rect.
pub struct Cell {
    sx: f32;
    sy: f32;
    sw: f32;
    sh: f32;
    dx: f32;
    dy: f32;
    dw: f32;
    dh: f32;
}

fn clampInset(a: f32, b: f32, total: f32): Vec2 {
    let x = a;
    let y = b;
    if x < 0.0 { x = 0.0; }
    if y < 0.0 { y = 0.0; }
    if x + y > total && x + y > 0.0 {
        let f = total / (x + y);
        x = x * f;
        y = y * f;
    }
    return Vec2 { x: x, y: y };
}

/// Cut a `srcW` x `srcH` image by the insets `l t r b` (source px) and place it in a `dstW` x `dstH`
/// box whose border widths are `bl bt br bb`. Source insets that overlap shrink together; when the
/// widths do not fit the box, all four shrink by the same factor (the CSS rule).
pub fn layout(srcW: f32, srcH: f32, l: f32, t: f32, r: f32, b: f32, dstW: f32, dstH: f32, bl: f32, bt: f32, br: f32, bb: f32): Slice9 {
    let h = clampInset(l, r, srcW);
    let v = clampInset(t, b, srcH);
    let f: f32 = 1.0;
    if bl + br > dstW && bl + br > 0.0 { f = min(f, dstW / (bl + br)); }
    if bt + bb > dstH && bt + bb > 0.0 { f = min(f, dstH / (bt + bb)); }
    if f < 0.0 { f = 0.0; }
    bl = bl * f;
    br = br * f;
    bt = bt * f;
    bb = bb * f;
    return Slice9 {
        sx: [0.0, h.x, srcW - h.y, srcW],
        sy: [0.0, v.x, srcH - v.y, srcH],
        dx: [0.0, bl, dstW - br, dstW],
        dy: [0.0, bt, dstH - bb, dstH],
    };
}

/// Piece `i` (0..8, row by row; 4 is the center).
pub fn cell(s: &Slice9, i: int): Cell {
    let cx = i % 3;
    let cy = i / 3;
    return Cell {
        sx: s.sx[cx], sy: s.sy[cy], sw: s.sx[cx + 1] - s.sx[cx], sh: s.sy[cy + 1] - s.sy[cy],
        dx: s.dx[cx], dy: s.dy[cy], dw: s.dx[cx + 1] - s.dx[cx], dh: s.dy[cy + 1] - s.dy[cy],
    };
}

/// Draw the pieces with the box's top left at `pos`; the center only when `fill`. `color` tints.
/// Empty pieces (a zero inset or width) are skipped.
pub fn draw(tex: Texture, s: &Slice9, pos: Vec2, fill: bool, color: Color) {
    for i in 0..9 {
        if i == 4 && !fill {
            continue;
        }
        let c = cell(s, i);
        if c.sw <= 0.0 || c.sh <= 0.0 || c.dw <= 0.0 || c.dh <= 0.0 {
            continue;
        }
        paint.imageSrc(tex, Vec2 { x: c.sx, y: c.sy }, Vec2 { x: c.sw, y: c.sh }, Vec2 { x: pos.x + c.dx, y: pos.y + c.dy }, Vec2 { x: c.dw, y: c.dh }, color);
    }
}
