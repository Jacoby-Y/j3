// Part of j3.gfx (voxel-style face mesh building); the module doc and `use`s are in ../gfx.j3.
module j3.gfx;

/// Write one interleaved vertex (pos, normal, albedo, emi) and return the next index.
fn pushVert(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    nx: f32,
    ny: f32,
    nz: f32,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
): int {
    out[at] = x;
    out[at + 1] = y;
    out[at + 2] = z;
    out[at + 3] = nx;
    out[at + 4] = ny;
    out[at + 5] = nz;
    out[at + 6] = r;
    out[at + 7] = g;
    out[at + 8] = b;
    out[at + 9] = emi;
    return at + 10;
}

/// Append six verts for one unit-cube face; returns the next write index.
pub fn emitFace(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    dir: int,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
): int {
    let x1 = x + 1;
    let y1 = y + 1;
    let z1 = z + 1;
    let nx: f32 = 0;
    let ny: f32 = 0;
    let nz: f32 = 0;
    if dir == FACE_PY {
        ny = 1;
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_NY {
        ny = f32(0) - 1;
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_PZ {
        nz = 1;
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_NZ {
        nz = f32(0) - 1;
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        return at;
    }
    if dir == FACE_PX {
        nx = 1;
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y1, z1, nx, ny, nz, r, g, b, emi);
        at = pushVert(out, at, x1, y, z1, nx, ny, nz, r, g, b, emi);
        return at;
    }
    nx = f32(0) - 1;
    at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y, z1, nx, ny, nz, r, g, b, emi);
    at = pushVert(out, at, x, y1, z, nx, ny, nz, r, g, b, emi);
    return pushVert(out, at, x, y, z, nx, ny, nz, r, g, b, emi);
}

/// Unit normal for a FACE_* direction.
fn faceNormal(dir: int): Vec3 {
    if dir == FACE_PY {
        return Vec3.xyz(0, 1, 0);
    }
    if dir == FACE_NY {
        return Vec3.xyz(0, f32(0) - 1, 0);
    }
    if dir == FACE_PX {
        return Vec3.xyz(1, 0, 0);
    }
    if dir == FACE_NX {
        return Vec3.xyz(f32(0) - 1, 0, 0);
    }
    if dir == FACE_PZ {
        return Vec3.xyz(0, 0, 1);
    }
    return Vec3.xyz(0, 0, f32(0) - 1);
}

// Corner i is (u,v): 0 (0,0), 1 (1,0), 2 (1,1), 3 (0,1). Same order as `voxel.corners`.
/// World-space corner i of a unit-cube face.
fn faceCorner(x: f32, y: f32, z: f32, dir: int, i: int): Vec3 {
    let u: f32 = 0;
    let v: f32 = 0;
    if i == 1 || i == 2 {
        u = 1;
    }
    if i == 2 || i == 3 {
        v = 1;
    }
    let px = x;
    let py = y;
    let pz = z;
    if dir == FACE_PY {
        px = x + u;
        py = y + 1;
        pz = z + v;
    } else if dir == FACE_NY {
        px = x + u;
        py = y;
        pz = z + v;
    } else if dir == FACE_PX {
        px = x + 1;
        py = y + v;
        pz = z + u;
    } else if dir == FACE_NX {
        px = x;
        py = y + v;
        pz = z + u;
    } else if dir == FACE_PZ {
        px = x + u;
        py = y + v;
        pz = z + 1;
    } else {
        px = x + u;
        py = y + v;
        pz = z;
    }
    return Vec3.xyz(px, py, pz);
}

/// Emit one AO-scaled corner vertex.
fn emitCorner(
    out: []f32,
    at: int,
    p0: Vec3,
    p1: Vec3,
    p2: Vec3,
    p3: Vec3,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
    n: Vec3,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    i: int,
): int {
    let p = p0;
    let s = s0;
    if i == 1 {
        p = p1;
        s = s1;
    } else if i == 2 {
        p = p2;
        s = s2;
    } else if i == 3 {
        p = p3;
        s = s3;
    }
    return pushVert(out, at, p.x, p.y, p.z, n.x, n.y, n.z, r * s, g * s, b * s, emi);
}

/// Emit two triangles (six verts) for an AO face.
fn emitSix(
    out: []f32,
    at: int,
    p0: Vec3,
    p1: Vec3,
    p2: Vec3,
    p3: Vec3,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
    n: Vec3,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    i0: int,
    i1: int,
    i2: int,
    i3: int,
    i4: int,
    i5: int,
): int {
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i0);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i1);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i2);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i3);
    at = emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i4);
    return emitCorner(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, i5);
}

// `s0..s3` match `voxel.corners`. 1 leaves the color alone. The shared edge is the darker diagonal.
/// Append an AO-shaded unit-cube face; returns the next write index.
pub fn emitFaceAo(
    out: []f32,
    at: int,
    x: f32,
    y: f32,
    z: f32,
    dir: int,
    r: f32,
    g: f32,
    b: f32,
    emi: f32,
    s0: f32,
    s1: f32,
    s2: f32,
    s3: f32,
): int {
    let p0 = faceCorner(x, y, z, dir, 0);
    let p1 = faceCorner(x, y, z, dir, 1);
    let p2 = faceCorner(x, y, z, dir, 2);
    let p3 = faceCorner(x, y, z, dir, 3);
    let n = faceNormal(dir);
    let use02 = s0 + s2 <= s1 + s3;
    if dir == FACE_PY || dir == FACE_PX {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 3, 2, 0, 2, 1);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 3, 2, 1, 3, 1, 0);
    }
    if dir == FACE_NY || dir == FACE_PZ {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 1, 2, 0, 2, 3);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 2, 3, 1, 3, 0);
    }
    if dir == FACE_NX {
        if use02 {
            return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 2, 3, 0, 2, 0, 1);
        }
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 2, 3, 1, 3, 0);
    }
    if use02 {
        return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 0, 3, 2, 0, 2, 1);
    }
    return emitSix(out, at, p0, p1, p2, p3, s0, s1, s2, s3, n, r, g, b, emi, 1, 0, 3, 1, 3, 2);
}
