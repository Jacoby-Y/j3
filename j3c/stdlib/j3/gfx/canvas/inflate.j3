// Part of j3.gfx.canvas (DEFLATE decoder).

module j3.gfx.canvas;

/// DEFLATE input read least significant bit first, without shift operators.
struct Bits {
    src :[] u8;
    at : int;
    buf : int;
    cnt : int;
    bad : bool;
}

fn need(s : &Bits, n : int) : int {
    while s.cnt < n {
        if s.at >= s.src.len {
            s.bad = true;
            return 0;
        }
        s.buf += int(s.src[s.at]) *POW2[s.cnt];
        s.at += 1;
        s.cnt += 8;
    }
    let v = s.buf -(s.buf / POW2[n]) *POW2[n];
    s.buf = s.buf / POW2[n];
    s.cnt -= n;
    return v;
}

/// Canonical Huffman code as zlib's puff keeps it: code counts per length, and the
/// symbols in code order.
struct Huff {
    count :[] int;
    symbol :[] int;
}

/// Build from the first `n` code lengths; false when the lengths over-subscribe.
fn build(h : &Huff, lens :[] int, first : int, n : int, arena : &Arena) : bool {
    let offs = arena.alloc::< int >(16);
    let i = 0;
    while i < 16 {
        h.count[i] = 0;
        offs[i] = 0;
        i += 1;
    }
    i = 0;
    while i < n {
        h.count[lens[first + i]] += 1;
        i += 1;
    }
    let left = 1;
    let len = 1;
    while len < 16 {
        left = left * 2 -h.count[len];
        if left < 0 {
            return false;
        }
        len += 1;
    }
    len = 1;
    while len < 15 {
        offs[len + 1] = offs[len] + h.count[len];
        len += 1;
    }
    i = 0;
    while i < n {
        let l = lens[first + i];
        if l != 0 {
            h.symbol[offs[l]] = i;
            offs[l] += 1;
        }
        i += 1;
    }
    h.count[0] = 0;
    return true;
}

/// The next symbol, or -1 on bad input.
// ponytail: bit-at-a-time decode; add a first-9-bits lookup table if loads show in a profile.
fn decodeSym(s : &Bits, h : &Huff) : int {
    let code = 0;
    let first = 0;
    let index = 0;
    let len = 1;
    while len < 16 {
        code += need(s, 1);
        let count = h.count[len];
        if code -count < first {
            return h.symbol[index + code -first];
        }
        index += count;
        first =(first + count) *2;
        code = code * 2;
        len += 1;
    }
    return -1;
}

/// Inflate the zlib stream `z` into exactly `out`. False on bad or short data.
pub fn inflate(z :[] u8, out :[] u8, arena : &Arena) : bool {
    let s = Bits {
        src : z, at : 2, buf : 0, cnt : 0, bad : false
    };
    let lit = Huff {
        count : arena.alloc::< int >(16), symbol : arena.alloc::< int >(288)
    };
    let dist = Huff {
        count : arena.alloc::< int >(16), symbol : arena.alloc::< int >(32)
    };
    let lens = arena.alloc::< int >(320);
    let cl = arena.alloc::< int >(19);
    let o = 0;
    let last = 0;
    while last == 0 {
        last = need(&s, 1);
        let kind = need(&s, 2);
        if kind == 0 {
            s.buf = 0;
            s.cnt = 0;
            if s.at + 4 > z.len {
                return false;
            }
            let stored = int(z[s.at]) + int(z[s.at + 1]) *256;
            s.at += 4;
            if s.at + stored > z.len || o + stored > out.len {
                return false;
            }
            let b = 0;
            while b < stored {
                out[o + b] = z[s.at + b];
                b += 1;
            }
            s.at += stored;
            o += stored;
        } else if kind == 1 || kind == 2 {
            let nlen = 288;
            let ndist = 30;
            if kind == 1 {
                let f = 0;
                while f < 288 {
                    lens[f] = 8;
                    if f >= 144 && f < 256 {
                        lens[f] = 9;
                    } else if f >= 256 && f < 280 {
                        lens[f] = 7;
                    }
                    f += 1;
                }
                f = 0;
                while f < 30 {
                    lens[288 + f] = 5;
                    f += 1;
                }
            } else {
                nlen = need(&s, 5) + 257;
                ndist = need(&s, 5) + 1;
                let ncode = need(&s, 4) + 4;
                let i = 0;
                while i < 19 {
                    cl[i] = 0;
                    i += 1;
                }
                i = 0;
                while i < ncode {
                    cl[CODE_ORDER[i]] = need(&s, 3);
                    i += 1;
                }
                if s.bad || !build(&lit, cl, 0, 19, arena) {
                    return false;
                }
                // The code-length code gives the literal lengths (at 0) and the distance
                // lengths (at 288, where the fixed tables keep them).
                let got = 0;
                let prev = 0;
                while got < nlen + ndist {
                    let c = decodeSym(&s, &lit);
                    if c < 0 || s.bad {
                        return false;
                    }
                    let v = 0;
                    let n = 1;
                    if c < 16 {
                        v = c;
                    } else if c == 16 {
                        if got == 0 {
                            return false;
                        }
                        v = prev;
                        n = 3 + need(&s, 2);
                    } else if c == 17 {
                        n = 3 + need(&s, 3);
                    } else {
                        n = 11 + need(&s, 7);
                    }
                    if got + n > nlen + ndist {
                        return false;
                    }
                    while n > 0 {
                        if got < nlen {
                            lens[got] = v;
                        } else {
                            lens[288 + got -nlen] = v;
                        }
                        got += 1;
                        n -= 1;
                    }
                    prev = v;
                }
                if lens[256] == 0 {
                    return false;
                }
            }
            if !build(&lit, lens, 0, nlen, arena) || !build(&dist, lens, 288, ndist, arena) {
                return false;
            }
            let sym = 0;
            while sym != 256 {
                sym = decodeSym(&s, &lit);
                if sym < 0 || s.bad {
                    return false;
                }
                if sym < 256 {
                    if o >= out.len {
                        return false;
                    }
                    out[o] = u8(sym);
                    o += 1;
                } else if sym > 256 {
                    let li = sym -257;
                    if li >= 29 {
                        return false;
                    }
                    let run = LEN_BASE[li] + need(&s, LEN_EXTRA[li]);
                    let di = decodeSym(&s, &dist);
                    if di < 0 || di >= 30 {
                        return false;
                    }
                    let d = DIST_BASE[di] + need(&s, DIST_EXTRA[di]);
                    if s.bad || d > o || o + run > out.len {
                        return false;
                    }
                    // Byte by byte: the copy may overlap what it writes.
                    let k = 0;
                    while k < run {
                        out[o] = out[o -d];
                        o += 1;
                        k += 1;
                    }
                }
            }
        } else {
            return false;
        }
        if s.bad {
            return false;
        }
    }
    return o == out.len;
}
