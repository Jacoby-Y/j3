// Part of j3.gfx.canvas (gradient, noise and blit).

module j3.gfx.canvas;

extend Canvas {
    /// Fill an axis-aligned rectangle with a horizontal or vertical gradient.
    fn gradientRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, start : Color, end : Color, vertical : bool) {
        if w <= 0 || h <= 0 {
            return;
        }
        let x0 = int(x);
        let y0 = int(y);
        let x1 = int(x) + int(w);
        let y1 = int(y) + int(h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        if x0 >= x1 || y0 >= y1 {
            return;
        }
        let verticalSpan = int(h) -1;
        let horizontalSpan = int(w) -1;
        if verticalSpan < 1 {
            verticalSpan = 1;
        }
        if horizontalSpan < 1 {
            horizontalSpan = 1;
        }
        let yy = int(y0);
        while yy < y1 {
            let rowColor = start;
            if vertical {
                rowColor = mix(start, end, yy -int(y), verticalSpan);
            }
            let xx = int(x0);
            while xx < x1 {
                let shade = rowColor;
                if !vertical {
                    shade = mix(start, end, xx -int(x), horizontalSpan);
                }
                blend(this.pixels,(yy *int(this.w) + xx) *4, shade, 255);
                xx += 1;
            }
            yy += 1;
        }
    }

    /// Deterministic two-color noise. `cell` controls block size (minimum 1).
    fn noiseRect(this : &Canvas, x : i32, y : i32, w : i32, h : i32, seed : u32, cell : i32, low : Color, high : Color) {
        if w <= 0 || h <= 0 {
            return;
        }
        let step = cell;
        if step < 1 {
            step = 1;
        }
        let x0 = int(x);
        let y0 = int(y);
        let x1 = int(x) + int(w);
        let y1 = int(y) + int(h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        if x0 >= x1 || y0 >= y1 {
            return;
        }
        if step > 1 {
            let cellY =((y0 -int(y)) / int(step)) *int(step);
            while int(y) + cellY < y1 {
                let cellX =((x0 -int(x)) / int(step)) *int(step);
                let cellH = int(step);
                if cellY + cellH > int(h) {
                    cellH = int(h) -cellY;
                }
                while int(x) + cellX < x1 {
                    let cellW = int(step);
                    if cellX + cellW > int(w) {
                        cellW = int(w) -cellX;
                    }
                    let cellNx = u32(cellX / int(step));
                    let cellNy = u32(cellY / int(step));
                    let cellValue = hash(seed + cellNx *u32(374761393) + cellNy *u32(668265263));
                    let cellShade = cellValue -(cellValue / u32(256)) *u32(256);
                    this.fillRect(i32(int(x) + cellX), i32(int(y) + cellY), i32(cellW), i32(cellH), mix(low, high, int(cellShade), 255));
                    cellX += int(step);
                }
                cellY += int(step);
            }
            return;
        }
        let yy = int(y0);
        while yy < y1 {
            let xx = int(x0);
            while xx < x1 {
                let nx = u32((xx -int(x)) / int(step));
                let ny = u32((yy -int(y)) / int(step));
                let v = hash(seed + nx *u32(374761393) + ny *u32(668265263));
                let shade = v -(v / u32(256)) *u32(256);
                blend(this.pixels,(yy *int(this.w) + xx) *4, mix(low, high, int(shade), 255), 255);
                xx += 1;
            }
            yy += 1;
        }
    }

    /// Composite a source image at an integer destination. Source must be distinct.
    fn blit(this : &Canvas, source : Canvas, dx : i32, dy : i32) {
        if this.pixels.ptr == source.pixels.ptr {
            panic("Canvas.blit: source aliases destination");
        }
        let x0 = int(dx);
        let y0 = int(dy);
        let x1 = int(dx) + int(source.w);
        let y1 = int(dy) + int(source.h);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > int(this.w) {
            x1 = int(this.w);
        }
        if y1 > int(this.h) {
            y1 = int(this.h);
        }
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let si =((y -int(dy)) *int(source.w) + x -int(dx)) *4;
                let a = source.pixels[si + 3];
                if a > 0 {
                    let c = rgba(source.pixels[si], source.pixels[si + 1], source.pixels[si + 2], a);
                    blend(this.pixels,(y *int(this.w) + x) *4, c, 255);
                }
                x += 1;
            }
            y += 1;
        }
    }
}

fn mix(a : Color, b : Color, n : int, span : int) : Color {
    let inv = span -n;
    return rgba(
    u8((int(a.r) *inv + int(b.r) *n) / span),
    u8((int(a.g) *inv + int(b.g) *n) / span),
    u8((int(a.b) *inv + int(b.b) *n) / span),
    u8((int(a.a) *inv + int(b.a) *n) / span),
    );
}

fn hash(v : u32) : u32 {
    let x = v;
    x = x *u32(1664525) + u32(1013904223);
    x = x *u32(22695477) + u32(1);
    return x;
}
