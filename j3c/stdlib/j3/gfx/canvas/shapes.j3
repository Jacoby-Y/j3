// Part of j3.gfx.canvas (circles, lines, triangles).

module j3.gfx.canvas;

extend Canvas {
    /// Fill a circle. Pixel mode uses exact coverage; smooth mode softens the edge.
    fn fillCircle(this : &Canvas, cx : f32, cy : f32, radius : f32, color : Color) {
        circle(this, cx, cy, radius, f32(0), color);
    }

    /// Draw a circle border of `thick` pixels.
    fn strokeCircle(this : &Canvas, cx : f32, cy : f32, radius : f32, thick : f32, color : Color) {
        if thick <= 0 {
            return;
        }
        circle(this, cx, cy, radius, thick, color);
    }

    /// Draw a line with round caps and a positive thickness.
    fn line(this : &Canvas, ax : f32, ay : f32, bx : f32, by : f32, thick : f32, color : Color) {
        if thick <= 0 || color.a == 0 {
            return;
        }
        let half = thick *0.5;
        let x0 = i32(ax -half -1);
        let y0 = i32(ay -half -1);
        let x1 = i32(bx + half + 2);
        let y1 = i32(by + half + 2);
        if bx < ax {
            x0 = i32(bx -half -1);
            x1 = i32(ax + half + 2);
        }
        if by < ay {
            y0 = i32(by -half -1);
            y1 = i32(ay + half + 2);
        }
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > this.w {
            x1 = this.w;
        }
        if y1 > this.h {
            y1 = this.h;
        }
        let dx = bx -ax;
        let dy = by -ay;
        let len2 = dx *dx + dy *dy;
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let px = f32(x) + 0.5;
                let py = f32(y) + 0.5;
                let t : f32 = 0;
                if len2 > 0 {
                    t = clamp(((px -ax) *dx +(py -ay) *dy) / len2, 0, 1);
                }
                let ex = px -(ax + t *dx);
                let ey = py -(ay + t *dy);
                let dist2 = ex *ex + ey *ey;
                let cov = 0;
                if this.mode == Mode.Pixel {
                    if dist2 <= half *half {
                        cov = 255;
                    }
                } else if dist2 <(half + 0.5) *(half + 0.5) {
                    if half >= 0.5 && dist2 <=(half -0.5) *(half -0.5) {
                        cov = 255;
                    } else {
                        cov = coverage(this.mode, half -sqrt(dist2));
                    }
                }
                if cov > 0 {
                    blend(this.pixels,(int(y) *int(this.w) + int(x)) *4, color, cov);
                }
                x += 1;
            }
            y += 1;
        }
    }

    /// Fill a triangle, clipping to the image. Smooth mode antialiases edges.
    fn fillTriangle(this : &Canvas, ax : f32, ay : f32, bx : f32, by : f32, cx : f32, cy : f32, color : Color) {
        if color.a == 0 {
            return;
        }
        let area = edge(ax, ay, bx, by, cx, cy);
        if area == 0 {
            return;
        }
        let minx = ax;
        if bx < minx {
            minx = bx;
        }
        if cx < minx {
            minx = cx;
        }
        let maxx = ax;
        if bx > maxx {
            maxx = bx;
        }
        if cx > maxx {
            maxx = cx;
        }
        let miny = ay;
        if by < miny {
            miny = by;
        }
        if cy < miny {
            miny = cy;
        }
        let maxy = ay;
        if by > maxy {
            maxy = by;
        }
        if cy > maxy {
            maxy = cy;
        }
        let x0 = i32(minx -1);
        let x1 = i32(maxx + 2);
        let y0 = i32(miny -1);
        let y1 = i32(maxy + 2);
        if x0 < 0 {
            x0 = 0;
        }
        if y0 < 0 {
            y0 = 0;
        }
        if x1 > this.w {
            x1 = this.w;
        }
        if y1 > this.h {
            y1 = this.h;
        }
        let sign : f32 = 1;
        if area < 0 {
            sign = -1;
        }
        let len0 : f32 = 1;
        let len1 : f32 = 1;
        let len2 : f32 = 1;
        if this.mode == Mode.Smooth {
            len0 = sqrt((bx -ax) *(bx -ax) +(by -ay) *(by -ay));
            len1 = sqrt((cx -bx) *(cx -bx) +(cy -by) *(cy -by));
            len2 = sqrt((ax -cx) *(ax -cx) +(ay -cy) *(ay -cy));
        }
        let y = y0;
        while y < y1 {
            let x = x0;
            while x < x1 {
                let px = f32(x) + 0.5;
                let py = f32(y) + 0.5;
                let e0 = edge(ax, ay, bx, by, px, py) *sign;
                let e1 = edge(bx, by, cx, cy, px, py) *sign;
                let e2 = edge(cx, cy, ax, ay, px, py) *sign;
                let cov = 255;
                if this.mode == Mode.Pixel {
                    if e0 < 0 || e1 < 0 || e2 < 0 {
                        cov = 0;
                    }
                } else {
                    let d0 = e0 / len0;
                    let d1 = e1 / len1;
                    let d2 = e2 / len2;
                    let d = d0;
                    if d1 < d {
                        d = d1;
                    }
                    if d2 < d {
                        d = d2;
                    }
                    cov = coverage(this.mode, d);
                }
                if cov > 0 {
                    blend(this.pixels,(int(y) *int(this.w) + int(x)) *4, color, cov);
                }
                x += 1;
            }
            y += 1;
        }
    }
}

fn circle(c : &Canvas, cx : f32, cy : f32, radius : f32, thick : f32, color : Color) {
    if radius <= 0 || color.a == 0 {
        return;
    }
    let x0 = i32(cx -radius -1);
    let x1 = i32(cx + radius + 2);
    let y0 = i32(cy -radius -1);
    let y1 = i32(cy + radius + 2);
    if x0 < 0 {
        x0 = 0;
    }
    if y0 < 0 {
        y0 = 0;
    }
    if x1 > c.w {
        x1 = c.w;
    }
    if y1 > c.h {
        y1 = c.h;
    }
    let inner = radius -thick;
    if inner < 0 {
        inner = 0;
    }
    let y = y0;
    while y < y1 {
        let x = x0;
        while x < x1 {
            let dx = f32(x) + 0.5 -cx;
            let dy = f32(y) + 0.5 -cy;
            let dist2 = dx *dx + dy *dy;
            let cov = 0;
            if c.mode == Mode.Pixel {
                if dist2 <= radius *radius &&(thick <= 0 || dist2 >= inner *inner) {
                    cov = 255;
                }
            } else if dist2 <(radius + 0.5) *(radius + 0.5) {
                if thick <= 0 && radius >= 0.5 && dist2 <=(radius -0.5) *(radius -0.5) {
                    cov = 255;
                } else {
                    let dist = sqrt(dist2);
                    cov = coverage(c.mode, radius -dist);
                    if thick > 0 {
                        let ic = coverage(c.mode, dist -inner);
                        if ic < cov {
                            cov = ic;
                        }
                    }
                }
            }
            if cov > 0 {
                blend(c.pixels,(int(y) *int(c.w) + int(x)) *4, color, cov);
            }
            x += 1;
        }
        y += 1;
    }
}

fn edge(ax : f32, ay : f32, bx : f32, by : f32, px : f32, py : f32) : f32 {
    return(bx -ax) *(py -ay) -(by -ay) *(px -ax);
}
