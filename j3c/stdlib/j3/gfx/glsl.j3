/// GLSL source prep for OpenGL ES. Every shader source goes through `prep` (via `game.prepGl`) before
/// `glShaderSource`; on desktop it returns the source untouched (same bytes, no allocation).
/// Main thread, at shader compile time (the result lives in the frame scratch arena: pass it to GL at once).

module j3.gfx.glsl;

use j3.memory.scratch;
use j3.text.{ Text, contains, find };

/// Sampler types that get an explicit `precision highp` when the source names them: ES gives
/// `sampler3D`, `sampler2DShadow`, `sampler2DArray` and the integer samplers no default, and the
/// default for `sampler2D`/`samplerCube` is `lowp`, too coarse for float textures.
const SAMPLERS: [9]string = [
    "sampler2D", "samplerCube", "sampler3D", "sampler2DShadow", "sampler2DArray",
    "isampler2D", "usampler2D", "isampler3D", "usampler3D",
];

/// `src` made valid for the context: with `es` false the same string; with `es` true the first line
/// `#version ...` becomes `#version 300 es` (a source with no `#version` line gets one, since ES would
/// read it as GLSL ES 1.00), and `precision highp float; precision highp int;` plus the sampler
/// defaults go after the leading `#` directive lines (`#extension` must precede any real code).
/// The precision statements join the first code line, so no line is added or removed and a driver log
/// line number is the line number in `src`.
pub fn prep(src: string, es: bool): string {
    if !es { return src; }
    let t = Text.new(scratch(0));
    // Leading lines that may precede code: blank, `//` comment, a one-line `/* */` comment, or a `#` line
    // that is not conditional (`#version`, `#extension`, `#define`). They are copied as they are, the
    // `#version` line swapped, and the precision goes after them, never inside an `#ifdef` branch.
    let end = 0;
    let hasVersion = false;
    let n = lineEnd(src, 0);
    while end < src.len && leadLine(src, end, n) {
        if isVersion(src, end) { hasVersion = true; }
        end = n;
        n = lineEnd(src, end);
    }
    // ponytail: no #version line: one is prepended, shifting log lines by one; every shipped source has one
    if !hasVersion { t.pushStr("#version 300 es\n"); }
    let at = 0;
    while at < end {
        let e = lineEnd(src, at);
        if isVersion(src, at) { t.pushStr("#version 300 es\n"); } else { t.pushStr(src[at..e] as string); }
        at = e;
    }
    t.pushStr("precision highp float;precision highp int;");
    let rest = src[at..src.len] as string;
    for i in 0..9 {
        if contains(rest, SAMPLERS[i]) {
            t.pushStr("precision highp ");
            t.pushStr(SAMPLERS[i]);
            t.pushStr(";");
        }
    }
    t.pushStr(rest);
    return t.str();
}

/// First non-blank byte of the line starting at `from`.
fn firstByte(s: string, from: int): int {
    let i = from;
    while i < s.len && (s[i] == 32 || s[i] == 9 || s[i] == 13) { i += 1; }
    return i;
}

/// Whether the line at `from` is a `#version` line.
fn isVersion(s: string, from: int): bool {
    let i = firstByte(s, from);
    return s.len - i >= 8 && find(s[i..i + 8] as string, "#version") == 0;
}

/// Whether the line `from..to` may stay above the precision statements (see `prep`).
fn leadLine(s: string, from: int, to: int): bool {
    let i = firstByte(s, from);
    if i >= to || s[i] == 10 { return true; }
    if s[i] == 47 && i + 1 < s.len && s[i + 1] == 47 { return true; }
    if s[i] == 47 && i + 1 < s.len && s[i + 1] == 42 {
        // one-line block comment only: ends on this line with nothing after it
        let c = find(s[i + 2..to] as string, "*/");
        return c >= 0 && firstByte(s, i + 2 + c + 2) >= to - 1;
    }
    if s[i] != 35 { return false; }
    let k = firstByte(s, i + 1);
    let rest = s[k..to] as string;
    return !(startsWith(rest, "if") || startsWith(rest, "else") || startsWith(rest, "elif") || startsWith(rest, "endif"));
}

/// Whether `s` starts with `head`.
fn startsWith(s: string, head: string): bool {
    return s.len >= head.len && find(s[0..head.len] as string, head) == 0;
}

/// Index just past the newline that ends the line starting at `from` (or the end of `s`).
fn lineEnd(s: string, from: int): int {
    let i = from;
    while i < s.len && s[i] != 10 { i += 1; }
    if i < s.len { i += 1; }
    return i;
}
