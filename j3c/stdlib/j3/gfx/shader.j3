// Part of j3.gfx (shader compile and link, lit and shadow programs, init and shutdown); the module doc and `use`s are in ../gfx.j3.
module j3.gfx;

/// Panic with the first n bytes of LOG.
fn dumpLog(n: i32) {
    if n < 1 {
        n = 1;
    }
    if n > 2047 {
        n = 2047;
    }
    panic([]u8 { ptr: &LOG[0], len: int(n) } as string);
}

/// Fetch a shader info log and panic with it.
fn shaderLog(sh: u32) {
    let n: i32 = 0;
    glGetShaderiv(sh, GL_INFO_LOG_LENGTH, &n as ptr);
    let wrote: i32 = 0;
    glGetShaderInfoLog(sh, 2048, &wrote as ptr, &LOG[0] as ptr);
    dumpLog(wrote);
}

/// Fetch a program info log and panic with it.
fn programLog(prog: u32) {
    let n: i32 = 0;
    glGetProgramiv(prog, GL_INFO_LOG_LENGTH, &n as ptr);
    let wrote: i32 = 0;
    glGetProgramInfoLog(prog, 2048, &wrote as ptr, &LOG[0] as ptr);
    dumpLog(wrote);
}

/// Compile a shader from source or panic.
fn compile(kind: u32, src: string): u32 {
    let sh = glCreateShader(kind);
    if sh == 0 {
        panic("glCreateShader");
    }
    let p: ptr = src.ptr as ptr;
    let n: i32 = i32(src.len);
    glShaderSource(sh, 1, &p as ptr, &n as ptr);
    glCompileShader(sh);
    let ok: i32 = 0;
    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok as ptr);
    if ok == 0 {
        shaderLog(sh);
    }
    return sh;
}

/// Link vertex and fragment shaders into a program.
fn link(vs: u32, fs: u32): u32 {
    let prog = glCreateProgram();
    if prog == 0 {
        panic("glCreateProgram");
    }
    glAttachShader(prog, vs);
    glAttachShader(prog, fs);
    glLinkProgram(prog);
    let ok: i32 = 0;
    glGetProgramiv(prog, GL_LINK_STATUS, &ok as ptr);
    if ok == 0 {
        programLog(prog);
    }
    glDeleteShader(vs);
    glDeleteShader(fs);
    return prog;
}

/// Uniform location for name in prog.
fn uloc(prog: u32, name: string): i32 {
    return glGetUniformLocation(prog, cstr(name));
}

/// Vertex shader source for the shadow depth pass.
/// Translucent shadow casters: the light they let through, and their depth for the MIN blend.
fn passFrag(): string {
    return "#version 330 core\nuniform vec3 uPass;\nout vec4 oColor;\nvoid main(){\n  oColor = vec4(uPass, gl_FragCoord.z);\n}\n";
}

/// Shadow depth vertex shader declarations, before `main`.
const DEPTH_VERT_HEAD: string = "#version 330 core\nlayout(location=0) in vec3 aPos;\nlayout(location=1) in vec3 aNrm;\nlayout(location=4) in vec2 aUv;\nlayout(location=5) in vec4 i0;\nlayout(location=6) in vec4 i1;\nlayout(location=7) in vec4 i2;\nlayout(location=8) in vec4 i3;\nuniform mat4 uLight;\nuniform mat4 uModel;\nuniform float uInst;\nout vec2 vUv;\n";
/// Shadow depth vertex `main` up to the world position (`world`).
const DEPTH_VERT_START: string = "void main(){\n  mat4 model = uInst > 0.5 ? mat4(i0, i1, i2, i3) : uModel;\n  vUv = aUv;\n  vec4 world = model * vec4(aPos, 1.0);\n";
const DEPTH_VERT_END: string = "  gl_Position = uLight * world;\n}\n";

fn depthVert(): string {
    let t = Text.new(scratch(0));
    t.pushStr(DEPTH_VERT_HEAD);
    t.pushStr(DEPTH_VERT_START);
    t.pushStr(DEPTH_VERT_END);
    return t.str();
}

/// Fragment shader source for the shadow depth pass.
fn depthFrag(): string {
    return "#version 330 core\nin vec2 vUv;\nuniform sampler2D uAlbedo;\nuniform float uCutout;\nvoid main(){\n  if (uCutout > 0.5 && texture(uAlbedo, vUv).a < 0.5) discard;\n}\n";
}

/// Lit vertex shader declarations, before `main`.
const LIT_VERT_HEAD: string = "#version 330 core\nlayout(location=0) in vec3 aPos;\nlayout(location=1) in vec3 aNrm;\nlayout(location=2) in vec3 aAlb;\nlayout(location=3) in float aEmi;\nlayout(location=4) in vec2 aUv;\nlayout(location=5) in vec4 i0;\nlayout(location=6) in vec4 i1;\nlayout(location=7) in vec4 i2;\nlayout(location=8) in vec4 i3;\nlayout(location=9) in vec3 iTint;\nlayout(location=10) in vec3 iGlow;\nlayout(location=11) in vec2 aLight;\nout vec2 vLight;\nout vec3 vTint;\nout vec3 vGlow;\nuniform mat4 uProj;\nuniform mat4 uView;\nuniform mat4 uModel;\nuniform float uInst;\nuniform mat4 uLight;\nuniform vec2 uNudge;\nout vec3 vPos;\nout vec3 vNrm;\nout vec3 vAlb;\nout float vEmi;\nout vec4 vShadow;\nout vec2 vUv;\n";
/// Lit vertex `main` up to the world position (`world`).
const LIT_VERT_START: string = "void main(){\n  mat4 model = uInst > 0.5 ? mat4(i0, i1, i2, i3) : uModel;\n  vec4 world = model * vec4(aPos, 1.0);\n";
/// The rest of lit vertex `main`.
const LIT_VERT_END: string = "  vPos = world.xyz;\n  vNrm = mat3(model) * aNrm;\n  vAlb = aAlb;\n  vTint = uInst > 1.5 ? iTint : vec3(1.0);\n  vGlow = uInst > 1.5 ? iGlow : vec3(0.0);\n  vEmi = aEmi;\n  vLight = aLight;\n  vUv = aUv;\n  vShadow = uLight * world;\n  gl_Position = uProj * uView * world;\n  gl_Position.xy += uNudge * gl_Position.w;\n}\n";

/// Vertex shader source for the lit camera pass.
fn litVert(): string {
    let t = Text.new(scratch(0));
    t.pushStr(LIT_VERT_HEAD);
    t.pushStr(LIT_VERT_START);
    t.pushStr(LIT_VERT_END);
    return t.str();
}

/// Lit fragment shader up to `main`: uniforms and helpers. Effects are spliced in after it.
fn litFragTop(): string {
    return "uniform float uTime;\nuniform vec2 uResolution;\nconst bool TRACE_SUN = TRACE_LEVEL % 2 == 1;\nconst bool TRACE_MIRROR = TRACE_LEVEL >= 2;\nconst bool TRACE_GLASS = TRACE_LEVEL >= 4;\nin vec3 vPos;\nin vec3 vNrm;\nin vec3 vAlb;\nin vec3 vTint;\nin vec3 vGlow;\nin float vEmi;\nin vec2 vLight;\nin vec4 vShadow;\nin vec2 vUv;\nuniform vec3 uSun;\nuniform vec3 uSunColor;\nuniform vec3 uSky;\nuniform vec3 uEye;\nuniform sampler2DShadow uShadow;\nuniform sampler2D uAlbedo;\nuniform float uFogStart;\nuniform float uFogEnd;\nuniform float uCutout;\nuniform float uFlat;\nuniform vec3 uFlatColor;\nuniform float uAlpha;\nuniform vec3 uTint;\nuniform vec3 uGlow;\nuniform float uSpec;\nuniform float uShine;\nuniform float uReflect;\nuniform float uEdge;\nuniform vec2 uUvScale;\nuniform vec2 uUvOffset;\nuniform vec3 uLP[8];\nuniform vec3 uLC[8];\nuniform float uLR[8];\nuniform float uIor;\nuniform float uRough;\nuniform sampler2D uGrab;\nuniform vec4 uGrabRect;\nuniform sampler2D uSkyTex;\nuniform float uHasSky;\nuniform mat4 uView;\nuniform float uThickness;\nuniform float uCloud;\nuniform float uTraceShadowAll;\nuniform float uTraceNear;\nuniform float uMapOn;\nuniform sampler2D uPassShadow;\n// Sun light let through by translucent casters between the sun and shadow-map point `proj`.\nvec3 passedLight(vec3 proj) {\n  if (proj.z > 1.0 || proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0) return vec3(1.0);\n  vec4 t = texture(uPassShadow, proj.xy);\n  return proj.z > t.a + 0.003 ? t.rgb : vec3(1.0);\n}\nout vec4 oColor;\nvec3 pointLit(vec3 P, vec3 C, float R, vec3 N, vec3 V, vec3 alb, float power, float norm, vec3 pos) {\n  vec3 lp = P - pos;\n  float ld = length(lp);\n  float la = clamp(1.0 - ld / max(R, 0.001), 0.0, 1.0);\n  vec3 L = lp / max(ld, 0.001);\n  float nl = max(dot(N, L), 0.0);\n  return C * la * la * (alb * nl + uSpec * norm * nl * pow(max(dot(N, normalize(L + V)), 0.0), power));\n}\n// The sky (or sky box) along `d`, with the sun as a glint that is small and bright on\n// smooth surfaces and broad and dim on rough ones.\nvec3 skyAlong(vec3 d, float rough) {\n  vec3 L = normalize(uSun);\n  float power = mix(2048.0, 12.0, clamp(rough, 0.0, 1.0));\n  vec3 glint = min(uSunColor * pow(max(dot(d, L), 0.0), power) * (power + 2.0) / 64.0, vec3(6.0));\n  if (uHasSky > 0.5) {\n    float u = 1.0 - fract(atan(d.z, d.x) / 6.2831853);\n    float v = acos(clamp(d.y, -1.0, 1.0)) / 3.1415927;\n    return texture(uSkyTex, vec2(u, v)).rgb + glint;\n  }\n  return mix(uSky * 0.5, uSky * 1.3 + vec3(0.05), clamp(d.y * 0.5 + 0.5, 0.0, 1.0)) + glint;\n}\nfloat schlick(float ior, float cosi) {\n  float f0 = pow((ior - 1.0) / (ior + 1.0), 2.0);\n  return f0 + (1.0 - f0) * pow(1.0 - clamp(cosi, 0.0, 1.0), 5.0);\n}\nuniform mat4 uProj;\nuniform mat4 uLight;\nuniform sampler2D uTris;\nuniform sampler2D uNodes;\nuniform float uTraceOn;\nuniform int uBounces;\nuniform int uSamples;\nuniform float uTraceShadows;\nuniform float uGrabbed;\nuniform sampler2D uTop;\nuniform sampler2D uObjects;\n// Mesh triangles in their mesh's own space, 7 texels each: corner, two edges, three corner\n// normals, then color.\nvec4 triAt(int t, int k) {\n  int i = t * 7 + k;\n  return texelFetch(uTris, ivec2(i & 1023, i >> 10), 0);\n}\n// Nodes of every mesh's own tree (`uNodes`) and of the tree over objects (`uTop`).\nvec4 nodeAt(int n, int k) {\n  int i = n * 2 + k;\n  return texelFetch(uNodes, ivec2(i & 1023, i >> 10), 0);\n}\nvec4 topAt(int n, int k) {\n  int i = n * 2 + k;\n  return texelFetch(uTop, ivec2(i & 1023, i >> 10), 0);\n}\n// Object `o`, 6 texels: world-to-object rows (3), tint + mirror, glow + ior, then\n// roughness, opacity, cloud, and its mesh's root node.\nvec4 instAt(int o, int k) {\n  int i = o * 6 + k;\n  return texelFetch(uObjects, ivec2(i & 1023, i >> 10), 0);\n}\n// `p` in object `o`'s space: a point when `w` is 1, a direction when 0.\nvec3 toObject(int o, vec3 p, float w) {\n  vec4 r0 = instAt(o, 0);\n  vec4 r1 = instAt(o, 1);\n  vec4 r2 = instAt(o, 2);\n  return vec3(dot(r0.xyz, p) + r0.w * w, dot(r1.xyz, p) + r1.w * w, dot(r2.xyz, p) + r2.w * w);\n}\n// An object-space normal in world space: the transposed world-to-object rows.\nvec3 toWorldNormal(int o, vec3 n) {\n  return instAt(o, 0).xyz * n.x + instAt(o, 1).xyz * n.y + instAt(o, 2).xyz * n.z;\n}\nvec3 hitNormal(int o, int h, vec2 b) {\n  return normalize(toWorldNormal(o, triAt(h, 3).xyz * (1.0 - b.x - b.y) + triAt(h, 4).xyz * b.x + triAt(h, 5).xyz * b.y));\n}\n// Face direction of the hit triangle in world space, flipped for mirrored objects the way\n// transformed edges would be.\nvec3 hitFace(int o, int h) {\n  float flip = sign(dot(instAt(o, 0).xyz, cross(instAt(o, 1).xyz, instAt(o, 2).xyz)));\n  return toWorldNormal(o, cross(triAt(h, 1).xyz, triAt(h, 2).xyz)) * flip;\n}\n// The hit's surface: color + mirror, glow + ior, roughness, opacity, cloud.\nvoid hitMat(int o, int h, out vec4 m0, out vec4 m1, out vec4 m2) {\n  vec4 t = instAt(o, 3);\n  m0 = vec4(triAt(h, 6).rgb * t.rgb, t.w);\n  m1 = instAt(o, 4);\n  m2 = instAt(o, 5);\n}\n// Distance along the ray to triangle `t`, or -1; `uv` gets the hit's barycentrics.\nfloat triHit(int t, vec3 ro, vec3 rd, out vec2 uv) {\n  vec3 v0 = triAt(t, 0).xyz;\n  vec3 e1 = triAt(t, 1).xyz;\n  vec3 e2 = triAt(t, 2).xyz;\n  vec3 p = cross(rd, e2);\n  float det = dot(e1, p);\n  if (abs(det) < 0.0000001) return -1.0;\n  float id = 1.0 / det;\n  vec3 s = ro - v0;\n  float u = dot(s, p) * id;\n  if (u < 0.0 || u > 1.0) return -1.0;\n  vec3 q = cross(s, e1);\n  float v = dot(rd, q) * id;\n  if (v < 0.0 || u + v > 1.0) return -1.0;\n  uv = vec2(u, v);\n  return dot(e2, q) * id;\n}\n// Where the ray enters box `lo`..`hi`, or -1 when it misses or enters past `reach`.\nfloat boxEnter(vec4 lo, vec4 hi, vec3 ro, vec3 inv, float reach) {\n  vec3 ta = (lo.xyz - ro) * inv;\n  vec3 tb = (hi.xyz - ro) * inv;\n  vec3 mn = min(ta, tb);\n  vec3 mx = max(ta, tb);\n  float t0 = max(max(mn.x, mn.y), mn.z);\n  float t1 = min(min(mx.x, mx.y), mx.z);\n  return (t1 < max(t0, 0.0) || t0 > reach) ? -1.0 : max(t0, 0.0);\n}\nfloat meshEnter(int n, vec3 ro, vec3 inv, float reach) {\n  return boxEnter(nodeAt(n, 0), nodeAt(n, 1), ro, inv, reach);\n}\nfloat topEnter(int n, vec3 ro, vec3 inv, float reach) {\n  return boxEnter(topAt(n, 0), topAt(n, 1), ro, inv, reach);\n}\nvec3 inverseDir(vec3 rd) {\n  return 1.0 / (rd + vec3(equal(rd, vec3(0.0))) * 0.000001);\n}\n// Closest hit along the ray within `reach`. One loop walks the tree over objects and, on\n// reaching an object, its mesh's tree in the object's space; `obj` says which, and the mesh's\n// entries sit above `base` on the shared stack. (Nested loops made the driver's compiler\n// crash.) The object-space direction isn't normalized, so distances stay world distances.\n// Children are box-tested before pushing and the nearer one pops first, so `best` shrinks\n// early and boxes behind it are skipped. Matters for long grazing rays, like reflections off\n// water. A stack entry below 0 is object -1 - entry, waiting to be entered.\nfloat traceRay(vec3 ro, vec3 rd, float reach, out int hit, out int inst, out vec2 bary) {\n  vec3 winv = inverseDir(rd);\n  vec3 o = ro;\n  vec3 d = rd;\n  vec3 inv = winv;\n  int obj = -1;\n  int base = 0;\n  float best = reach;\n  hit = -1;\n  inst = -1;\n  bary = vec2(0.0);\n  int stack[64];\n  float enter[64];\n  int sp = 0;\n  float r = topEnter(0, ro, winv, best);\n  if (r >= 0.0) { stack[0] = 0; enter[0] = r; sp = 1; }\n  for (int guard = 0; guard < 8192; guard++) {\n    if (obj >= 0 && sp == base) {\n      obj = -1;\n      o = ro;\n      d = rd;\n      inv = winv;\n    }\n    if (sp == 0) break;\n    sp--;\n    if (enter[sp] > best) continue;\n    int n = stack[sp];\n    float here = enter[sp];\n    if (n < 0) {\n      obj = -1 - n;\n      o = toObject(obj, ro, 1.0);\n      d = toObject(obj, rd, 0.0);\n      inv = inverseDir(d);\n      base = sp;\n      int root = int(instAt(obj, 5).w);\n      float e = meshEnter(root, o, inv, best);\n      if (e >= 0.0) { stack[sp] = root; enter[sp] = e; sp++; }\n      continue;\n    }\n    vec4 lo = obj >= 0 ? nodeAt(n, 0) : topAt(n, 0);\n    vec4 hi = obj >= 0 ? nodeAt(n, 1) : topAt(n, 1);\n    int count = int(hi.w);\n    int first = int(lo.w);\n    if (count > 0) {\n      for (int k = 0; k < 4; k++) {\n        if (k >= count) break;\n        if (obj < 0) {\n          if (sp < 64) { stack[sp] = -1 - (first + k); enter[sp] = here; sp++; }\n          continue;\n        }\n        vec2 uv;\n        float t = triHit(first + k, o, d, uv);\n        if (t > 0.0005 && t < best) {\n          best = t;\n          hit = first + k;\n          inst = obj;\n          bary = uv;\n        }\n      }\n    } else {\n      float a = obj >= 0 ? meshEnter(first, o, inv, best) : topEnter(first, o, inv, best);\n      float b = obj >= 0 ? meshEnter(first + 1, o, inv, best) : topEnter(first + 1, o, inv, best);\n      if (a >= 0.0 && b >= 0.0 && sp < 62) {\n        bool leftNear = a <= b;\n        stack[sp] = leftNear ? first + 1 : first; enter[sp] = leftNear ? b : a; sp++;\n        stack[sp] = leftNear ? first : first + 1; enter[sp] = leftNear ? a : b; sp++;\n      } else if (a >= 0.0 && sp < 63) {\n        stack[sp] = first; enter[sp] = a; sp++;\n      } else if (b >= 0.0 && sp < 63) {\n        stack[sp] = first + 1; enter[sp] = b; sp++;\n      }\n    }\n  }\n  return best;\n}\n// Whether anything opaque lies along the ray; stops at the first one. `glassy` says a\n// see-through object was crossed on the way, so the caller must trace the tint. Walks both\n// trees in one loop like `traceRay`.\n// ponytail: plain push order; near-first ordering was tried and cost more than it saved.\nbool occluded(vec3 ro, vec3 rd, out bool glassy) {\n  vec3 winv = inverseDir(rd);\n  vec3 o = ro;\n  vec3 d = rd;\n  vec3 inv = winv;\n  int obj = -1;\n  bool see = false;\n  int base = 0;\n  glassy = false;\n  int stack[64];\n  int sp = 0;\n  stack[sp++] = 0;\n  for (int guard = 0; guard < 8192; guard++) {\n    if (obj >= 0 && sp == base) {\n      obj = -1;\n      o = ro;\n      d = rd;\n      inv = winv;\n    }\n    if (sp == 0) break;\n    int n = stack[--sp];\n    if (n < 0) {\n      obj = -1 - n;\n      see = instAt(obj, 4).w > 1.001 || instAt(obj, 5).y < 0.999;\n      // One see-through object is enough to know the tint must be traced.\n      if (see && glassy) { obj = -1; continue; }\n      o = toObject(obj, ro, 1.0);\n      d = toObject(obj, rd, 0.0);\n      inv = inverseDir(d);\n      base = sp;\n      stack[sp++] = int(instAt(obj, 5).w);\n      continue;\n    }\n    if (obj >= 0 ? meshEnter(n, o, inv, 1e30) < 0.0 : topEnter(n, o, inv, 1e30) < 0.0) continue;\n    vec4 lo = obj >= 0 ? nodeAt(n, 0) : topAt(n, 0);\n    vec4 hi = obj >= 0 ? nodeAt(n, 1) : topAt(n, 1);\n    int count = int(hi.w);\n    int first = int(lo.w);\n    if (count > 0) {\n      for (int k = 0; k < 4; k++) {\n        if (k >= count) break;\n        if (obj < 0) {\n          if (sp < 64) stack[sp++] = -1 - (first + k);\n          continue;\n        }\n        vec2 uv;\n        if (triHit(first + k, o, d, uv) > 0.0005) {\n          if (!see) return true;\n          glassy = true;\n          // Done with this object: drop the rest of its mesh.\n          sp = base;\n          break;\n        }\n      }\n    } else if (sp < 62) {\n      stack[sp++] = first;\n      stack[sp++] = first + 1;\n    }\n  }\n  return false;\n}\n// Sunlight reaching `p`: none behind opaque things, tinted and dimmed through glass and\n// see-through surfaces. Without traced shadows, the shadow map.\nvec3 sunReach(vec3 p, vec3 n, bool gated) {\n  vec3 L = normalize(uSun);\n  vec4 sp = uLight * vec4(p, 1.0);\n  vec3 proj = sp.xyz / max(sp.w, 0.0001) * 0.5 + 0.5;\n  bool inMap = !(proj.z > 1.0 || proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0);\n  float lit = 1.0;\n  vec3 passed = vec3(1.0);\n  if (inMap) {\n    lit = 0.0;\n    for (int x = -1; x <= 1; x++) {\n      for (int y = -1; y <= 1; y++) {\n        lit += texture(uShadow, vec3(proj.xy + vec2(float(x), float(y)) / 2048.0, proj.z - 0.004));\n      }\n    }\n    lit /= 9.0;\n    passed = passedLight(proj);\n  }\n  // Hits in mirrors and glass get the main surface's test (`gated` means it already ran):\n  // trace only where the map is unsure, within uTraceNear.\n  bool unsure = gated || uMapOn < 0.5 || !inMap || (lit > 0.001 && lit < 0.999) || passed != vec3(1.0);\n  bool near = gated || uTraceNear <= 0.0 || length(p - uEye) < uTraceNear;\n  if (!TRACE_SUN || uTraceShadows < 0.5 || !unsure || !near) return vec3(lit) * passed;\n  bool glassy;\n  if (occluded(p + n * 0.003, L, glassy)) return vec3(0.0);\n  if (!glassy) return vec3(1.0);\n  vec3 pass = vec3(1.0);\n  vec3 ro = p + n * 0.003;\n  for (int k = 0; k < 8; k++) {\n    int h;\n    int o;\n    vec2 b;\n    float d = traceRay(ro, L, 1000.0, h, o, b);\n    if (h < 0) return pass;\n    vec4 m0;\n    vec4 m1;\n    vec4 m2;\n    hitMat(o, h, m0, m1, m2);\n    // Count each see-through object once, where the ray enters it.\n    bool entering = dot(L, hitFace(o, h)) < 0.0;\n    if (m1.w > 1.001) {\n      if (entering) pass *= m0.rgb * (1.0 - m2.z) * (1.0 - schlick(m1.w, 1.0));\n    } else if (m2.y < 0.999) {\n      if (entering) pass *= 1.0 - m2.y;\n    } else {\n      return vec3(0.0);\n    }\n    if (max(pass.r, max(pass.g, pass.b)) < 0.01) return vec3(0.0);\n    ro += L * (d + 0.003);\n  }\n  return pass;\n}\nvec3 shadeHit(int o, int t, vec3 p, vec3 n) {\n  vec3 alb = triAt(t, 6).rgb * instAt(o, 3).rgb;\n  vec3 L = normalize(uSun);\n  float ndl = max(dot(n, L), 0.0);\n  vec3 reach = ndl > 0.0 ? sunReach(p, n, false) : vec3(0.0);\n  vec3 ambient = mix(uSky * 0.35, uSky, n.y * 0.5 + 0.5);\n  vec3 c = alb * (ambient + uSunColor * ndl * reach);\n  for (int i = 0; i < 8; i++) {\n    c += pointLit(uLP[i], uLC[i], uLR[i], n, n, alb, 4.0, 0.0, p);\n  }\n  return c + instAt(o, 4).rgb;\n}\n// What a ray that hits nothing sees: the sky, or for a ray that came through glass, the\n// frame drawn behind it where that direction lands on screen (so the grid shows through).\nvec3 missColor(vec3 rd, bool throughGlass) {\n  if (throughGlass && uGrabbed > 0.5) {\n    vec4 c = uProj * uView * vec4(rd, 0.0);\n    vec2 uv = c.xy / max(c.w, 0.0001) * 0.5 + 0.5;\n    if (c.w > 0.0 && uv.x > 0.0 && uv.x < 1.0 && uv.y > 0.0 && uv.y < 1.0) return texture(uGrab, uv).rgb;\n  }\n  return skyAlong(rd, 0.0);\n}\nstruct Path {\n  vec3 o;\n  vec3 d;\n  vec3 w;\n  int depth;\n  bool inside;\n  bool glass;\n};\n// Follow rays through the scene. Glass splits each ray into a reflected part (Fresnel) and\n// a refracted part, absorbing its tint over the distance travelled inside; mirrors reflect\n// their tint; see-through surfaces pass the rest on; anything else ends the ray.\nvec3 follow(Path first, Path second, bool two) {\n  Path stack[12];\n  int sp = 0;\n  stack[sp++] = first;\n  if (two) stack[sp++] = second;\n  vec3 acc = vec3(0.0);\n  for (int seg = 0; seg < 32; seg++) {\n    if (sp == 0) break;\n    Path r = stack[--sp];\n    if (max(r.w.r, max(r.w.g, r.w.b)) < 0.005) continue;\n    if (r.depth >= uBounces) {\n      acc += r.w * missColor(r.d, r.glass);\n      continue;\n    }\n    int h;\n    int o;\n    vec2 bary;\n    float d = traceRay(r.o, r.d, 1000.0, h, o, bary);\n    if (h < 0) {\n      acc += r.w * missColor(r.d, r.glass);\n      continue;\n    }\n    vec3 p = r.o + r.d * d;\n    vec3 n = hitNormal(o, h, bary);\n    vec4 m0;\n    vec4 m1;\n    vec4 m2;\n    hitMat(o, h, m0, m1, m2);\n    bool outside = dot(r.d, n) < 0.0;\n    vec3 f = outside ? n : -n;\n    if (r.inside) r.w *= pow(max(m0.rgb, vec3(0.001)), vec3(d));\n    if (m1.w > 1.001) {\n      acc += r.w * shadeHit(o, h, p, f) * m2.z;\n      r.w *= 1.0 - m2.z;\n      float F = schlick(m1.w, dot(-r.d, f));\n      vec3 bent = refract(r.d, f, outside ? 1.0 / m1.w : m1.w);\n      if (dot(bent, bent) < 0.01) {\n        stack[sp++] = Path(p + f * 0.003, reflect(r.d, f), r.w, r.depth + 1, r.inside, r.glass);\n        continue;\n      }\n      if (F > 0.02 && sp < 11) stack[sp++] = Path(p + f * 0.003, reflect(r.d, f), r.w * F, r.depth + 1, r.inside, false);\n      stack[sp++] = Path(p - f * 0.003, normalize(bent), r.w * (1.0 - F), r.depth + 1, outside, true);\n      continue;\n    }\n    vec3 base = shadeHit(o, h, p, f);\n    if (m0.w > 0.001) {\n      acc += r.w * base * (1.0 - m0.w);\n      stack[sp++] = Path(p + f * 0.003, reflect(r.d, f), r.w * m0.w * m0.rgb, r.depth + 1, r.inside, false);\n      continue;\n    }\n    if (m2.y < 0.999) {\n      acc += r.w * base * m2.y;\n      stack[sp++] = Path(p + r.d * 0.003, r.d, r.w * (1.0 - m2.y), r.depth + 1, r.inside, r.glass);\n      continue;\n    }\n    acc += r.w * base;\n  }\n  return acc;\n}\n// One ray through mirrors and see-through surfaces. It never splits (glass it meets lets\n// the ray straight through, tinted), so unlike `follow` it needs no path stack.\nvec3 mirrorRay(vec3 o, vec3 d) {\n  vec3 w = vec3(1.0);\n  vec3 acc = vec3(0.0);\n  for (int depth = 0; depth < 16; depth++) {\n    if (max(w.r, max(w.g, w.b)) < 0.005) break;\n    if (depth >= uBounces) {\n      acc += w * missColor(d, false);\n      break;\n    }\n    int h;\n    int inst;\n    vec2 bary;\n    float t = traceRay(o, d, 1000.0, h, inst, bary);\n    if (h < 0) {\n      acc += w * missColor(d, false);\n      break;\n    }\n    vec3 p = o + d * t;\n    vec3 n = hitNormal(inst, h, bary);\n    vec4 m0;\n    vec4 m1;\n    vec4 m2;\n    hitMat(inst, h, m0, m1, m2);\n    vec3 f = dot(d, n) < 0.0 ? n : -n;\n    vec3 base = shadeHit(inst, h, p, f);\n    if (m1.w > 1.001) {\n      acc += w * base * m2.z;\n      w *= (1.0 - m2.z) * m0.rgb;\n      o = p + d * 0.003;\n    } else if (m0.w > 0.001) {\n      acc += w * base * (1.0 - m0.w);\n      w *= m0.w * m0.rgb;\n      o = p + f * 0.003;\n      d = reflect(d, f);\n    } else if (m2.y < 0.999) {\n      acc += w * base * m2.y;\n      w *= 1.0 - m2.y;\n      o = p + d * 0.003;\n    } else {\n      acc += w * base;\n      break;\n    }\n  }\n  return acc;\n}\nfloat hash13(vec3 p) {\n  return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);\n}\n// `d` nudged by roughness for sample `s`, kept on the same side of `n`.\nvec3 jitter(vec3 d, vec3 n, float rough, int s) {\n  if (rough < 0.001) return d;\n  vec3 j = vec3(hash13(vec3(gl_FragCoord.xy, float(s))), hash13(vec3(gl_FragCoord.yx, float(s) + 7.0)), hash13(vec3(gl_FragCoord.xy * 0.37, float(s) + 13.0))) * 2.0 - 1.0;\n  vec3 nd = normalize(d + j * rough * 0.5);\n  return dot(nd, n) * dot(d, n) < 0.0 ? d : nd;\n}\n// Rays for a surface of roughness `rough`: all of uSamples from 0.2 up, fewer below, since\n// a near-mirror's jittered rays land on the same spot.\n// ponytail: linear ramp to 0.2; tune if rough surfaces under 0.2 look noisy.\nint samplesFor(float rough) {\n  return rough < 0.001 ? 1 : max(int(1.0 + float(max(uSamples, 1) - 1) * clamp(rough / 0.2, 0.0, 1.0) + 0.5), 1);\n}\n";
}

/// What a material effect's `effect(Surface s, vec3 lit)` hook sees.
const FX_STRUCT: string = "struct Surface {\n  vec3 pos;\n  vec3 normal;\n  vec3 view;\n  vec2 uv;\n  vec3 albedo;\n  float alpha;\n};\n";
/// The stock shader's hook: no effect.
const FX_IDENTITY: string = "vec3 effect(Surface s, vec3 lit) { return lit; }\n";

/// Lit fragment `main`: lighting, glow, the effect hook, then fog.
fn litFragMain(): string {
    return "void main(){\n  vec4 tex = texture(uAlbedo, vUv * uUvScale + uUvOffset);\n  if (uCutout > 0.5 && tex.a < 0.5) discard;\n  if (uFlat > 0.5) {\n    float d = 0.06;\n    float ax = texture(uAlbedo, vUv + vec2(d, 0.0)).a;\n    float ay = texture(uAlbedo, vUv - vec2(d, 0.0)).a;\n    float bx = texture(uAlbedo, vUv + vec2(0.0, d)).a;\n    float by = texture(uAlbedo, vUv - vec2(0.0, d)).a;\n    if (ax > 0.5 && ay > 0.5 && bx > 0.5 && by > 0.5) discard;\n    oColor = vec4(uFlatColor, 1.0);\n    return;\n  }\n  vec3 alb = vAlb * tex.rgb * uTint * vTint;\n  if (vEmi > 0.5) {\n    oColor = vec4(alb, 1.0);\n    return;\n  }\n  vec3 N = normalize(vNrm);\n  vec3 L = normalize(uSun);\n  float ndl = max(dot(N, L), 0.0);\n  vec3 proj = vShadow.xyz / max(vShadow.w, 0.0001);\n  proj = proj * 0.5 + 0.5;\n  float dz = max(abs(dFdx(proj.z)), abs(dFdy(proj.z)));\n  float du = max(length(vec2(dFdx(proj.x), dFdy(proj.x))), length(vec2(dFdx(proj.y), dFdy(proj.y))));\n  float bias = clamp(dz / max(du, 0.0000001) * (2.0 / 2048.0), 0.0004, 0.01);\n  float vis = 0.0;\n  vec2 texel = vec2(1.0 / 2048.0);\n  for (int x = -1; x <= 1; x++) {\n    for (int y = -1; y <= 1; y++) {\n      vis += texture(uShadow, vec3(proj.xy + vec2(float(x), float(y)) * texel, proj.z - bias));\n    }\n  }\n  vis /= 9.0;\n  bool inMap = !(proj.z > 1.0 || proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0);\n  if (!inMap) vis = 1.0;\n  vec3 passed = passedLight(proj);\n  vec3 sunLight = vec3(vis) * passed;\n  float dist = length(vPos - uEye);\n  // URP with traced shadows: surfaces trace their sun ray, so glass casts tinted shadows.\n  // Where the shadow map is sure (fully lit or fully dark, nothing see-through above) its\n  // answer stands; only edges, tinted spots, and places off the map trace, up to uTraceNear.\n  bool unsure = uMapOn < 0.5 || !inMap || (vis > 0.001 && vis < 0.999) || passed != vec3(1.0);\n  bool near = uTraceNear <= 0.0 || dist < uTraceNear;\n  if (TRACE_SUN && uTraceShadowAll > 0.5 && ndl > 0.0 && unsure && near) sunLight = sunReach(vPos, N, true);\n  float hemi = N.y * 0.5 + 0.5;\n  vec3 ambient = mix(uSky * 0.35, uSky, hemi);\n  vec3 sunCol = uSunColor;\n  vec3 rgb = alb * (ambient + sunCol * ndl * sunLight);\n  vec3 V = normalize(uEye - vPos);\n  float power = mix(4.0, 256.0, uShine);\n  float norm = (power + 8.0) / 25.0;\n  vec3 hi = sunCol * sunLight * ndl * uSpec * norm * pow(max(dot(N, normalize(L + V)), 0.0), power);\n  rgb += hi;\n  for (int i = 0; i < 8; i++) {\n    rgb += pointLit(uLP[i], uLC[i], uLR[i], N, V, alb, power, norm, vPos);\n  }\n  float fog = clamp((dist - uFogStart) / max(uFogEnd - uFogStart, 0.001), 0.0, 1.0);\n  float facing = max(dot(N, V), 0.0);\n  float fres = pow(1.0 - facing, 5.0);\n  vec3 Rv = reflect(-V, N);\n  bool tracing = TRACE_MIRROR && uTraceOn > 0.5;\n  // Full strength is a mirror at every angle; weaker ones show mostly at grazing angles.\n  float mirror = clamp(uReflect * mix(1.0, 0.35 + 0.65 * fres, 1.0 - uReflect), 0.0, 1.0);\n  float a = uAlpha * tex.a * mix(1.0, 0.15 + 0.85 * (1.0 - facing), uEdge);\n  if (uIor > 1.001) {\n    // Glass: Fresnel reflection plus the refracted view, tinted by the distance it travels\n    // inside. Cloudiness mixes in a lit, frosted surface.\n    float F = schlick(uIor, facing);\n    vec3 bent = refract(-V, N, 1.0 / uIor);\n    vec3 clear;\n    if (TRACE_GLASS && tracing) {\n      clear = vec3(0.0);\n      int n = samplesFor(uRough);\n      for (int s = 0; s < 16; s++) {\n        if (s >= n) break;\n        Path refl = Path(vPos + N * 0.003, jitter(Rv, N, uRough, s), vec3(F), 0, false, false);\n        Path into = Path(vPos - N * 0.003, jitter(bent, -N, uRough, s), vec3(1.0 - F), 0, true, true);\n        clear += follow(refl, into, true);\n      }\n      clear /= float(n);\n    } else {\n      // Where the bent ray leaves the object, on screen, in the frame drawn behind it.\n      vec4 c = uProj * uView * vec4(vPos + bent * uThickness, 1.0);\n      vec2 at = clamp(c.xy / max(c.w, 0.0001) * 0.5 + 0.5, 0.001, 0.999);\n      vec3 behind = texture(uGrab, at).rgb * pow(max(uTint * vTint, vec3(0.001)), vec3(uThickness));\n      clear = mix(behind, skyAlong(Rv, uRough), F);\n    }\n    rgb = mix(clear, rgb, clamp(uCloud, 0.0, 1.0));\n    a = 1.0;\n  } else if (mirror > 0.001) {\n    vec3 env;\n    if (tracing) {\n      env = vec3(0.0);\n      int n = samplesFor(uRough);\n      for (int s = 0; s < 16; s++) {\n        if (s >= n) break;\n        env += mirrorRay(vPos + N * 0.003, jitter(Rv, N, uRough, s));\n      }\n      env /= float(n);\n    } else {\n      env = mix(skyAlong(Rv, uRough), uSky, uRough * 0.5);\n    }\n    rgb = mix(rgb, env * uTint * vTint, mirror);\n  }\n  rgb += uGlow + vGlow;\n  rgb = effect(Surface(vPos, N, V, vUv * uUvScale + uUvOffset, alb, a), rgb);\n  rgb = mix(rgb, uSky, fog);\n  // Highlights stay bright on see-through surfaces.\n  oColor = vec4(rgb, max(a, clamp(max(hi.r, max(hi.g, hi.b)), 0.0, 1.0)));\n}\n";
}

/// Unlit line vertex shader.
fn lineVert(): string {
    return "#version 330 core\nlayout(location=0) in vec3 aPos;\nuniform mat4 uProj;\nuniform mat4 uView;\nvoid main(){\n  gl_Position = uProj * uView * vec4(aPos, 1.0);\n}\n";
}

/// Unlit line fragment shader.
fn lineFrag(): string {
    return "#version 330 core\nuniform vec3 uColor;\nout vec4 oColor;\nvoid main(){ oColor = vec4(uColor, 1.0); }\n";
}

/// Create the 2048 depth texture and shadow framebuffer.
fn makeShadow() {
    let tex: u32 = 0;
    glGenTextures(1, &tex as ptr);
    if tex == 0 {
        panic("glGenTextures");
    }
    glBindTexture(GL_TEXTURE_2D, tex);
    glTexImage2D(
        GL_TEXTURE_2D,
        0,
        GL_DEPTH_COMPONENT24,
        SHADOW,
        SHADOW,
        0,
        GL_DEPTH_COMPONENT,
        GL_UNSIGNED_INT,
        0,
    );
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_BORDER);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_BORDER);
    glTexParameterfv(GL_TEXTURE_2D, GL_TEXTURE_BORDER_COLOR, &BORDER[0] as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_FUNC, i32(GL_LEQUAL));
    let fbo: u32 = 0;
    glGenFramebuffers(1, &fbo as ptr);
    if fbo == 0 {
        panic("glGenFramebuffers");
    }
    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, tex, 0);
    glDrawBuffer(GL_NONE);
    glReadBuffer(GL_NONE);
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        panic("shadow framebuffer");
    }
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
    G.shadowTex = tex;
    G.shadowFbo = fbo;
    let pt: u32 = 0;
    glGenTextures(1, &pt as ptr);
    glBindTexture(GL_TEXTURE_2D, pt);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, SHADOW, SHADOW, 0, GL_RGBA, GL_FLOAT, 0);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
    let pf: u32 = 0;
    glGenFramebuffers(1, &pf as ptr);
    glBindFramebuffer(GL_FRAMEBUFFER, pf);
    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, pt, 0);
    if glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE {
        panic("translucent shadow framebuffer");
    }
    glBindFramebuffer(GL_FRAMEBUFFER, 0);
    G.passTex = pt;
    G.passFbo = pf;
}

/// 1×1 opaque white texture used when no albedo is bound.
fn makeWhite() {
    let px: [4]u8 = [255, 255, 255, 255];
    let tex: u32 = 0;
    glGenTextures(1, &tex as ptr);
    if tex == 0 {
        panic("glGenTextures");
    }
    glBindTexture(GL_TEXTURE_2D, tex);
    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, &px[0] as ptr);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
    finishColorTex();
    G.white = tex;
    G.albedo = tex;
}

/// Bind the current albedo on texture unit 1.
fn bindAlbedo() {
    let tex = G.albedo;
    if tex == 0 {
        tex = G.white;
    }
    glActiveTexture(GL_TEXTURE1);
    glBindTexture(GL_TEXTURE_2D, tex);
    glActiveTexture(GL_TEXTURE0);
}

/// Enable pos/normal/albedo/emi, uv when `uv` is set, and the light pair (attribute 11, at float 12) when `light` is set.
fn bindLayout(stride: i32, uv: bool, light: bool) {
    glEnableVertexAttribArray(0);
    glEnableVertexAttribArray(1);
    glEnableVertexAttribArray(2);
    glEnableVertexAttribArray(3);
    glVertexAttribPointer(0, 3, GL_FLOAT, 0, stride, 0 as ptr);
    glVertexAttribPointer(1, 3, GL_FLOAT, 0, stride, 12 as ptr);
    glVertexAttribPointer(2, 3, GL_FLOAT, 0, stride, 24 as ptr);
    glVertexAttribPointer(3, 1, GL_FLOAT, 0, stride, 36 as ptr);
    if uv {
        glEnableVertexAttribArray(4);
        glVertexAttribPointer(4, 2, GL_FLOAT, 0, stride, 40 as ptr);
    } else {
        glDisableVertexAttribArray(4);
    }
    if light {
        glEnableVertexAttribArray(11);
        glVertexAttribPointer(11, 2, GL_FLOAT, 0, stride, 48 as ptr);
    } else {
        glDisableVertexAttribArray(11);
    }
}

/// 12 when the buffer is UV-only, 10 when it matches the untextured layout, else 0.
/// A length divisible by both stays 10 so voxel faces (6 verts × 10 floats) stay untextured.
fn pickStride(n: int): int {
    let by12 = n >= 12 && n - (n / 12) * 12 == 0;
    let by10 = n >= 10 && n - (n / 10) * 10 == 0;
    if by12 && !by10 {
        return 12;
    }
    if by10 {
        return 10;
    }
    return 0;
}

/// Upload interleaved vertex floats as STATIC_DRAW.
fn fillBuffer(verts: []f32) {
    glBufferData(GL_ARRAY_BUFFER, verts.len * 4, verts.ptr as ptr, GL_STATIC_DRAW);
}

/// Whether `init` has run (a GL context exists).
pub fn ready(): bool {
    return G.ready;
}

/// Panic unless gfx.init has completed.
fn ensure() {
    if !G.ready {
        panic("gfx.init");
    }
}

/// Load GL procs, compile shaders, build the shadow map, and enable depth.
pub fn init() {
    if G.ready {
        return;
    }
    loadProcs();
    G.depth = link(compile(GL_VERTEX_SHADER, depthVert()), compile(GL_FRAGMENT_SHADER, depthFrag()));
    litProgram(LIT_PLAIN);
    G.lineProg = link(compile(GL_VERTEX_SHADER, lineVert()), compile(GL_FRAGMENT_SHADER, lineFrag()));
    G.dLight = uloc(G.depth, "uLight");
    G.dModel = uloc(G.depth, "uModel");
    G.dInst = uloc(G.depth, "uInst");
    G.dAlbedo = uloc(G.depth, "uAlbedo");
    G.dCutout = uloc(G.depth, "uCutout");
    G.passProg = link(compile(GL_VERTEX_SHADER, depthVert()), compile(GL_FRAGMENT_SHADER, passFrag()));
    G.pLight = uloc(G.passProg, "uLight");
    G.pModel = uloc(G.passProg, "uModel");
    G.pInst = uloc(G.passProg, "uInst");
    G.pPass = uloc(G.passProg, "uPass");
    G.lLineProj = uloc(G.lineProg, "uProj");
    G.lLineView = uloc(G.lineProg, "uView");
    G.lLineColor = uloc(G.lineProg, "uColor");
    let ib: u32 = 0;
    glGenBuffers(1, &ib as ptr);
    G.instBuf = ib;
    let lb: u32 = 0;
    glGenBuffers(1, &lb as ptr);
    G.lineBuf = lb;
    let lv: u32 = 0;
    glGenVertexArrays(1, &lv as ptr);
    G.lineVao = lv;
    glBindVertexArray(lv);
    glBindBuffer(GL_ARRAY_BUFFER, lb);
    glEnableVertexAttribArray(0);
    glVertexAttribPointer(0, 3, GL_FLOAT, 0, 12, 0 as ptr);
    glBindVertexArray(0);
    makeShadow();
    makeWhite();
    glVertexAttrib2f(4, 0, 0);
    glVertexAttrib2f(11, 1, 0); // meshes without a light pair read full sky, no block light
    glUseProgram(G.depth);
    glUniform1i(G.dAlbedo, 1);
    glUniform1f(G.dCutout, 0);
    glEnable(GL_DEPTH_TEST);
    glDepthFunc(GL_LEQUAL);
    glEnable(GL_CULL_FACE);
    game.setGlShutdown(shutdown);
    G.ready = true;
    G.pass = PASS_NONE;
}

/// Compile lit variant `level` (`LIT_*`), find its uniforms, and store them in `LITS`.
fn litProgram(level: int) {
    let first = 0;
    fillLit(link(compile(GL_VERTEX_SHADER, litVert()), compile(GL_FRAGMENT_SHADER, litSource(level, FX_IDENTITY, &first))));
    LITS[level] = LIT;
}

/// The lit fragment shader at trace `level`, with `fx` (an `effect` hook and the uniforms
/// it uses) before `main`. `firstLine` gets the 1-based line `fx` starts on.
fn litSource(level: int, fx: string, firstLine: &int): string {
    let src = Text.new(scratch(0));
    src.pushStr("#version 330 core\n#define TRACE_LEVEL ");
    src.pushInt(level);
    src.pushStr("\n");
    src.pushStr(litFragTop());
    src.pushStr(FX_STRUCT);
    let lines = 1;
    let i = 0;
    while i < src.len() {
        if src.bytes[i] == 10 { lines += 1; }
        i += 1;
    }
    *firstLine = lines;
    src.pushStr(fx);
    src.push(10);
    src.pushStr(litFragMain());
    return src.str();
}

/// Find lit program `prog`'s uniforms, into `LIT`.
fn fillLit(prog: u32) {
    LIT.prog = prog;
    LIT.lProj = uloc(LIT.prog, "uProj");
    LIT.lView = uloc(LIT.prog, "uView");
    LIT.lModel = uloc(LIT.prog, "uModel");
    LIT.lInst = uloc(LIT.prog, "uInst");
    LIT.lLight = uloc(LIT.prog, "uLight");
    LIT.lSun = uloc(LIT.prog, "uSun");
    LIT.lSunColor = uloc(LIT.prog, "uSunColor");
    LIT.lSky = uloc(LIT.prog, "uSky");
    LIT.lEye = uloc(LIT.prog, "uEye");
    LIT.lShadow = uloc(LIT.prog, "uShadow");
    LIT.lFog0 = uloc(LIT.prog, "uFogStart");
    LIT.lFog1 = uloc(LIT.prog, "uFogEnd");
    LIT.lPassTex = uloc(LIT.prog, "uPassShadow");
    LIT.lAlbedo = uloc(LIT.prog, "uAlbedo");
    LIT.lCutout = uloc(LIT.prog, "uCutout");
    LIT.lFlat = uloc(LIT.prog, "uFlat");
    LIT.lFlatColor = uloc(LIT.prog, "uFlatColor");
    LIT.lNudge = uloc(LIT.prog, "uNudge");
    LIT.lAlpha = uloc(LIT.prog, "uAlpha");
    LIT.lTint = uloc(LIT.prog, "uTint");
    LIT.lGlow = uloc(LIT.prog, "uGlow");
    LIT.lSpec = uloc(LIT.prog, "uSpec");
    LIT.lShine = uloc(LIT.prog, "uShine");
    LIT.lReflect = uloc(LIT.prog, "uReflect");
    LIT.lEdge = uloc(LIT.prog, "uEdge");
    LIT.lUvScale = uloc(LIT.prog, "uUvScale");
    LIT.lUvOffset = uloc(LIT.prog, "uUvOffset");
    LIT.lIor = uloc(LIT.prog, "uIor");
    LIT.lRough = uloc(LIT.prog, "uRough");
    LIT.lGrab = uloc(LIT.prog, "uGrab");
    LIT.lGrabRect = uloc(LIT.prog, "uGrabRect");
    LIT.lSkyTex = uloc(LIT.prog, "uSkyTex");
    LIT.lHasSky = uloc(LIT.prog, "uHasSky");
    lightLocs(LIT.prog);
    LIT.lTraceOn = uloc(LIT.prog, "uTraceOn");
    LIT.lThickness = uloc(LIT.prog, "uThickness");
    LIT.lCloud = uloc(LIT.prog, "uCloud");
    LIT.lTraceShadowAll = uloc(LIT.prog, "uTraceShadowAll");
    LIT.lTraceNear = uloc(LIT.prog, "uTraceNear");
    LIT.lMapOn = uloc(LIT.prog, "uMapOn");
    LIT.lBounces = uloc(LIT.prog, "uBounces");
    LIT.lSamples = uloc(LIT.prog, "uSamples");
    LIT.lTraceShadows = uloc(LIT.prog, "uTraceShadows");
    LIT.lGrabbed = uloc(LIT.prog, "uGrabbed");
    LIT.lTime = uloc(LIT.prog, "uTime");
    LIT.lResolution = uloc(LIT.prog, "uResolution");
    // Each sampler gets its own unit; two sampler types sharing unit 0 would fail every draw.
    samplerUnits(LIT.prog);
    glUseProgram(LIT.prog);
    glUniform1i(LIT.lAlbedo, 1);
    glUniform1i(LIT.lShadow, 0);
    glUniform1f(LIT.lCutout, 0);
    glUniform1f(LIT.lFlat, 0);
    glUniform1f(LIT.lAlpha, 1);
    glUniform2f(LIT.lNudge, 0, 0);
}

/// `compile` that returns 0 and appends the driver's log instead of panicking.
fn tryCompile(kind: u32, src: string, log: &Text): u32 {
    let sh = glCreateShader(kind);
    if sh == 0 {
        log.pushStr("glCreateShader failed\n");
        return 0;
    }
    let p: ptr = src.ptr as ptr;
    let n: i32 = i32(src.len);
    glShaderSource(sh, 1, &p as ptr, &n as ptr);
    glCompileShader(sh);
    let ok: i32 = 0;
    glGetShaderiv(sh, GL_COMPILE_STATUS, &ok as ptr);
    if ok != 0 { return sh; }
    let wrote: i32 = 0;
    glGetShaderInfoLog(sh, 2048, &wrote as ptr, &LOG[0] as ptr);
    pushLog(log, wrote);
    glDeleteShader(sh);
    return 0;
}

/// `link` that returns 0 and appends the driver's log instead of panicking. Deletes both
/// shaders; either may be 0 (an earlier `tryCompile` failed).
fn tryLink(vs: u32, fs: u32, log: &Text): u32 {
    if vs == 0 || fs == 0 {
        if vs != 0 { glDeleteShader(vs); }
        if fs != 0 { glDeleteShader(fs); }
        return 0;
    }
    let prog = glCreateProgram();
    glAttachShader(prog, vs);
    glAttachShader(prog, fs);
    glLinkProgram(prog);
    glDeleteShader(vs);
    glDeleteShader(fs);
    let ok: i32 = 0;
    glGetProgramiv(prog, GL_LINK_STATUS, &ok as ptr);
    if ok != 0 { return prog; }
    let wrote: i32 = 0;
    glGetProgramInfoLog(prog, 2048, &wrote as ptr, &LOG[0] as ptr);
    pushLog(log, wrote);
    glDeleteProgram(prog);
    return 0;
}

fn pushLog(log: &Text, n: i32) {
    let i = 0;
    while i < int(n) && i < 2048 && LOG[i] != 0 {
        log.push(LOG[i]);
        i += 1;
    }
    if log.len() > 0 && log.bytes[log.len() - 1] != 10 { log.push(10); }
}

/// Switch to lit variant `level` (`LIT_*` flags added), compiling it on first use.
fn useLit(level: int) {
    if LITS[level].prog == 0 { litProgram(level); }
    LIT = LITS[level];
    glUseProgram(LIT.prog);
}

/// Delete programs and the shadow map; clear ready state.
pub fn shutdown() {
    if !G.ready {
        return;
    }
    if G.depth != 0 {
        glDeleteProgram(G.depth);
        G.depth = 0;
    }
    let v = 0;
    while v < 8 {
        if LITS[v].prog != 0 { glDeleteProgram(LITS[v].prog); }
        LITS[v].prog = 0;
        v += 1;
    }
    v = 0;
    while v < 32 {
        freeEffect(v + 1);
        v += 1;
    }
    COPY_FX = 0;
    v = 0;
    while v < 4 {
        freeTarget(&POOL[v].a);
        freeTarget(&POOL[v].b);
        POOL[v].used = 0;
        v += 1;
    }
    POST.read = 0;
    POST.vao = 0;
    if G.shadowFbo != 0 {
        let fbo = G.shadowFbo;
        glDeleteFramebuffers(1, &fbo as ptr);
        G.shadowFbo = 0;
    }
    if G.shadowTex != 0 {
        let tex = G.shadowTex;
        glDeleteTextures(1, &tex as ptr);
        G.shadowTex = 0;
    }
    if G.white != 0 {
        let white = G.white;
        glDeleteTextures(1, &white as ptr);
        G.white = 0;
        G.albedo = 0;
    }
    G.ready = false;
    G.pass = PASS_NONE;
}
