fn glUniform1f(loc: i32, v: f32) {
    let f = P.uniform1f as fn(i32, f32);
    f(loc, v);
}

fn glUniform4f(loc: i32, x: f32, y: f32, z: f32, w: f32) {
    let f = P.uniform4f as fn(i32, f32, f32, f32, f32);
    f(loc, x, y, z, w);
}

fn glCopyTexSubImage2D(target: u32, level: i32, dx: i32, dy: i32, x: i32, y: i32, w: i32, h: i32) {
    let f = P.copyTexSubImage2D as fn(u32, i32, i32, i32, i32, i32, i32, i32);
    f(target, level, dx, dy, x, y, w, h);
}

