fn glBindVertexArray(vao: u32) {
    let f = P.bindVertexArray as fn(u32);
    f(vao);
}

/// glGenBuffers.
fn glGenBuffers(n: i32, ids: ptr) {
    let f = P.genBuffers as fn(i32, ptr);
    f(n, ids);
}

/// glBindBuffer.
fn glBindBuffer(target: u32, buf: u32) {
    let f = P.bindBuffer as fn(u32, u32);
    f(target, buf);
}

