    f(loc, x, y);
}

fn glUniform3f(loc: i32, x: f32, y: f32, z: f32) {
    let f = P.uniform3f as fn(i32, f32, f32, f32);
    f(loc, x, y, z);
}

/// glUniformMatrix4fv.
fn glUniformMatrix4fv(loc: i32, count: i32, transpose: u8, value: ptr) {
    let f = P.uniformMatrix4fv as fn(i32, i32, u8, ptr);
    f(loc, count, transpose, value);
}

/// glActiveTexture.
fn glActiveTexture(unit: u32) {
    let f = P.activeTexture as fn(u32);
    f(unit);
}

/// glDrawArrays.
fn glDrawArrays(mode: u32, first: i32, count: i32) {
    game.p2Flush();
    let f = P.drawArrays as fn(u32, i32, i32);
    f(mode, first, count);
    game.profDraw(if mode == GL_TRIANGLES { int(count) / 3 } else { 0 });
}

/// glDrawArraysInstanced.
fn glDrawArraysInstanced(mode: u32, first: i32, count: i32, primcount: i32) {
    game.p2Flush();
    let f = P.drawArraysInstanced as fn(u32, i32, i32, i32);
    f(mode, first, count, primcount);
    game.profDraw(int(count) / 3 * int(primcount));
}

