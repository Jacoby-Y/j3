/// Private GL post pipeline used by paint. Targets contain premultiplied RGBA8 pixels.
/// Main thread only. No feedback: every pass has distinct source and destination textures.
module j3.gfx.post;

use j3.game;
use j3.game.Texture;
use j3.math.{
    Vec2, cos, sin
};
use j3.sys.panic;
use j3.io.printLn;
use j3.text.{
    cstr, Text
};
use j3.memory.Arena;
use j3.gpu.{ Source };

struct Surface {
    live: bool;
    w: int;
    h: int;
    tex:[4] u32;
    fb:[4] u32;
    /// Physical top-left rect of `tex[0]` that may hold pixels (x0, y0, x1, y1); a layer clears only this.
    dirty:[4] int;
}
/// GL entry points, looked up once in `init` (`SDL_GL_GetProcAddress` is a string lookup).
struct Gl {
    getInt: ptr; getFloat: ptr; isOn: ptr; enable: ptr; disable: ptr; active: ptr; bindTex: ptr; bindFb: ptr;
    useProg: ptr; bindVa: ptr; bindBuf: ptr; viewport: ptr; scissor: ptr; loc: ptr; u1i: ptr; u1f: ptr; u2f: ptr;
    u4f: ptr; blendSep: ptr; colorMask: ptr; clearColor: ptr; clear: ptr; draw: ptr; copy: ptr; readBuf: ptr;
    mip: ptr; texParam: ptr;
}
struct Saved {
    vp:[4] i32;
    sc:[4] i32;
    color:[4] i32;
    clear:[4] f32;
    textures:[4] i32;
    prog: i32 = 0;
    vao: i32 = 0;
    buf: i32 = 0;
    draw: i32 = 0;
    read: i32 = 0;
    active: i32 = 0;
    src: i32 = 0;
    dst: i32 = 0;
    srca: i32 = 0;
    dsta: i32 = 0;
    depth: bool = false;
    cull: bool = false;
    blend: bool = false;
    clip: bool = false;
    stencil: bool = false;
    srgb: bool = false;
}
#[singleton]
let SURF:[96] Surface;
#[singleton]
let SHADER:[32] u32;
#[singleton]
let SAVED:[16] Saved;
#[singleton]
let STACK:[16] int;
#[singleton]
let KIND:[16] int;
#[singleton]
let BASESTACK:[16] u32;
#[singleton]
let DEPTH: int;
#[singleton]
let LAYERS:[8] int;
#[singleton]
let LDEPTH: int;
#[singleton]
let READY: bool;
#[singleton]
let VAO: u32;
#[singleton]
let VBO: u32;
#[singleton]
let BLUR: u32;
#[singleton]
let FX: u32;
#[singleton]
let BRIGHT: u32;
#[singleton]
let PROJECT: u32;
#[singleton]
let OVER: u32;
#[singleton]
let LOG:[4096] u8;
#[singleton]
let GL: Gl;
/// Uniform locations by (program, name literal): `uloc`. Purged when a program goes away.
#[singleton]
let ULP:[128] u32;
#[singleton]
let ULN:[128] int;
#[singleton]
let ULV:[128] i32;
#[singleton]
let ULC: int;
/// Per open layer depth: the parent's draw framebuffer and draw buffer, its `p2FbRect` (GL x, y, w, h), whether
/// the parent capture is a layer (whose backdrop sits under ours), and the backdrop texture (`baseOf`, lazy).
#[singleton]
let LPFB:[8] u32;
#[singleton]
let LPBUF:[8] i32;
#[singleton]
let LRECT:[32] int;
#[singleton]
let LPARENT:[8] bool;
#[singleton]
let BPEND:[8] bool;
#[singleton]
let BTEX:[8] u32;
/// `BASESTACK` entry was a lazy (not yet copied) backdrop.
#[singleton]
let BASELAZY:[16] bool;
/// Effect targets sized to a group's drawn area (exact sizes; least recently used goes first).
#[singleton]
let POOL:[32] int;
#[singleton]
let POOLAT:[32] int;
#[singleton]
let POOLTICK: int;
/// Physical rect (x, y, w, h, top-left) the last `endLayer` output covers; w 0 = the whole surface.
#[singleton]
let OUTRECT:[4] f32;
