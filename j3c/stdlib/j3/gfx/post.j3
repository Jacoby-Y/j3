/// Private GL post pipeline used by paint. Targets contain premultiplied RGBA8 pixels.
/// Main thread only. No feedback: every pass has distinct source and destination textures.
module j3.gfx.post;

use j3.game;
use j3.game.Texture;
use j3.math.{
    Vec2, cos, sin
};
use j3.sys.panic;
use j3.io.printLn;
use j3.text.{
    cstr, Text
};
use j3.memory.Arena;
use j3.gpu.{ Source };

struct Surface {
    live: bool;
    w: int;
    h: int;
    tex:[4] u32;
    fb:[4] u32;
}
struct Saved {
    vp:[4] i32;
    sc:[4] i32;
    color:[4] i32;
    clear:[4] f32;
    textures:[4] i32;
    prog: i32 = 0;
    vao: i32 = 0;
    buf: i32 = 0;
    draw: i32 = 0;
    read: i32 = 0;
    active: i32 = 0;
    src: i32 = 0;
    dst: i32 = 0;
    srca: i32 = 0;
    dsta: i32 = 0;
    depth: bool = false;
    cull: bool = false;
    blend: bool = false;
    clip: bool = false;
    stencil: bool = false;
    srgb: bool = false;
}
#[singleton]
let SURF:[64] Surface;
#[singleton]
let SHADER:[32] u32;
#[singleton]
let SAVED:[16] Saved;
#[singleton]
let STACK:[16] int;
#[singleton]
let KIND:[16] int;
#[singleton]
let BASESTACK:[16] u32;
#[singleton]
let DEPTH: int;
#[singleton]
let LAYERS:[8] int;
#[singleton]
let LDEPTH: int;
#[singleton]
let READY: bool;
#[singleton]
let VAO: u32;
#[singleton]
let VBO: u32;
#[singleton]
let BLUR: u32;
#[singleton]
let FX: u32;
#[singleton]
let BRIGHT: u32;
#[singleton]
let PROJECT: u32;
#[singleton]
let OVER: u32;
#[singleton]
let LOG:[4096] u8;
