// Part of j3.gfx.paint (layer capture, render targets, shaders, projected textures).

module j3.gfx.paint;

#[singleton]
let CAPSTATE: [16]State;
#[singleton]
let CAPSHAPE: [131072]f32;
#[singleton]
let CAPN: [32]int;
#[singleton]
let CAPRULE: [32]int;
#[singleton]
let CAPMASK: [112]f32;
#[singleton]
let CAPDEPTH: int;
#[singleton]
let CAPCKB: [16]int;

fn captureState(reset: bool) {
    ensure(); game.p2Flush();
    if CAPDEPTH >= 16 { panic("paint capture nesting exceeds sixteen"); }
    let n = CAPDEPTH; CAPSTATE[n] = P; CAPDEPTH += 1;
    for slot in 0..2 {
        CAPN[n * 2 + slot] = SHN[slot]; CAPRULE[n * 2 + slot] = SHR[slot];
        for i in 0..SHN[slot] * 2 { CAPSHAPE[n * 8192 + slot * (2 * MAXPT) + i] = SHP[slot * (2 * MAXPT) + i]; }
        SHN[slot] = 0;
    }
    for i in 0..7 { CAPMASK[n * 7 + i] = MCUR[i]; MCUR[i] = 0; }
    P.a = 1; P.clipOn = false;
    CAPCKB[n] = CKI[1];
    if CKI[0] > CKI[1] { CKI[1] = CKI[0]; applyClips(true); }
    if reset { P.s = 1; P.tx = 0; P.ty = 0; P.rot = false; }
    game.p2Clip(false, 0, 0, 0, 0); applyShape(0); applyShape(1); applyMask();
    if reset { applyRot(); }
}
fn restoreCapture() {
    if CAPDEPTH <= 0 { panic("unbalanced paint capture"); }
    CAPDEPTH -= 1; let n = CAPDEPTH; P = CAPSTATE[n];
    let wasClips = CKI[0] > CKI[1];
    CKI[1] = CAPCKB[n];
    for slot in 0..2 {
        SHN[slot] = CAPN[n * 2 + slot]; SHR[slot] = CAPRULE[n * 2 + slot];
        for i in 0..SHN[slot] * 2 { SHP[slot * (2 * MAXPT) + i] = CAPSHAPE[n * 8192 + slot * (2 * MAXPT) + i]; }
        applyShape(slot);
    }
    for i in 0..7 { MCUR[i] = CAPMASK[n * 7 + i]; }
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1); applyMask(); applyRot();
    if wasClips || CKI[0] > CKI[1] { applyClips(true); }
}
fn screenBounds(pos: Vec2, size: Vec2, box: []f32) {
    box[0] = 1000000000; box[1] = 1000000000;
    let x1: f32 = -1000000000; let y1: f32 = -1000000000;
    for i in 0..4 {
        let x = pos.x + (if i % 2 == 1 { size.x } else { 0.0 });
        let y = pos.y + (if i >= 2 { size.y } else { 0.0 });
        let p = game.p2ScreenPoint(Vec2 { x: x * P.s + P.tx, y: y * P.s + P.ty });
        if p.x < box[0] { box[0] = p.x; } if p.x > x1 { x1 = p.x; }
        if p.y < box[1] { box[1] = p.y; } if p.y > y1 { y1 = p.y; }
    }
    box[2] = x1 - box[0]; box[3] = y1 - box[1];
}
/// Capture a transparent content group. Eight nested groups; clip, mask and alpha apply once
/// when ending the group. Own drawing and child groups remain ordered within it.
pub fn beginLayer() { post.beginLayer(); captureState(false); }
/// Process captured content, then composite it. Perspective rotates the bounded plane in degrees;
/// distance is logical px (0 is orthographic). Content outside that box is cropped for 3D rotation.
pub fn endLayer(pos: Vec2, size: Vec2, fx: Effects) {
    ensure();
    let radius = fx.blur; if radius < 0 { radius = 0; } if radius > 64 { radius = 64; }
    let scale = P.s; if scale < 0 { scale = 0 - scale; }
    let f: [19]f32 = [radius * scale * game.paintScale(), fx.bloom, fx.bloomThreshold, fx.grain, fx.scanlines, fx.crt,
        fx.brightness, fx.contrast, fx.saturation, fx.grayscale, fx.sepia, fx.invert, fx.hue, f32(fx.blend), f32(fx.shader), fx.time,
        fx.perspective * scale * game.paintScale(), fx.rotateX, fx.rotateY];
    let box: [4]f32 = [0, 0, 0, 0];
    screenBounds(pos, size, []f32 { ptr: &box[0], len: 4 });
    let tex = post.endLayer([]f32 { ptr: &f[0], len: 19 }, []f32 { ptr: &box[0], len: 4 });
    restoreCapture(); post.composite(tex, P.a);
}
/// Reusable render texture handle (1..8192 px per side). All handles are context-owned and
/// automatically destroyed at shutdown; explicit destruction is available for early release.
pub fn target(width: int, height: int): int { return post.target(width, height); }
pub fn beginTarget(handle: int) { captureState(true); post.beginTarget(handle); }
pub fn endTarget() { post.endTarget(); restoreCapture(); }
/// Borrowed GL texture. FBO pixels are vertically flipped for ordinary `image`; use
/// `projectTexture` (including zero rotations) to display it. Invalid after target destruction.
pub fn targetTexture(handle: int): Texture { return post.targetTexture(handle); }
pub fn destroyTarget(handle: int) { post.destroyTarget(handle); }
/// GLSL330 source defines vec4 effect(vec2 uv, vec4 color). color is straight RGBA;
/// uniforms: sampler2D uTex (premultiplied), vec2 uResolution, float uTime. Returns 0 with
/// the GL compiler/linker diagnostic on failure. Existing shaders remain valid.
pub fn shader(source: string): int { return post.shader(source); }
pub fn destroyShader(id: int) { post.destroyShader(id); }
/// Draw a target texture as a perspective-correct UI plane, with rotations in degrees.
/// Distance 0 is orthographic; positive distance is logical px. Clip/mask/alpha apply once.
/// Supports translation and positive scale; capture 2D rotated content in a layer before projection.
pub fn projectTexture(tex: Texture, pos: Vec2, size: Vec2, rotateX: f32, rotateY: f32, perspective: f32) {
    ensure();
    if P.s <= 0 || (P.rot && (P.rb != 0 || P.rc != 0 || P.ra <= 0 || P.rd <= 0)) { panic("projectTexture supports translation and positive scale; use a layer for 2D rotation"); }
    let box: [4]f32 = [0, 0, 0, 0];
    screenBounds(pos, size, []f32 { ptr: &box[0], len: 4 });
    let out = post.projectTexture(tex, []f32 { ptr: &box[0], len: 4 }, rotateX, rotateY, perspective * P.s * game.paintScale());
    post.composite(out, P.a);
}
