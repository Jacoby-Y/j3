// Part of j3.gfx.paint (shape clips, path fills, masks).

module j3.gfx.paint;

/// Current shape clips (slot 0: `clip-path`, slot 1: inner shapes such as rounded image corners and
/// path fills), 2 * MAXPT floats each in device-local pixels, and what is saved under them.
#[singleton]
let SHP: [8192]f32;
#[singleton]
let SHN: [2]int;
#[singleton]
let SHR: [2]int;
/// Saved shapes: slot * 4 + depth, 2 * MAXPT floats each.
#[singleton]
let SSTK: [32768]f32;
#[singleton]
let SSN: [8]int;
#[singleton]
let SSR: [8]int;
#[singleton]
let SDEPTH: [2]int;

fn applyShape(slot: int) {
    game.p2Shape(slot, &SHP[slot * (2 * MAXPT)] as ptr, SHN[slot], SHR[slot] == 1);
}

/// Clip later draws to an outline: `n` x, y pairs in the current coordinates (at most `path.MAXPT` points, a
/// point with x below -1e8 starts a new contour, each contour repeats its first point), antialiased,
/// non-zero winding or `evenOdd`. Slot 0 is for `clip-path`, slot 1 for shapes drawn inside it (rounded
/// image corners, `fillShape`); one outline per slot is active, a nested push replaces the outer one
/// until its `popShape(slot)` (four deep). The outline moves with `pushRotate` and `pushXform` (the
/// clip rect of `pushClip` does not). See `j3.gfx.clip` for builders.
pub fn pushShape(slot: int, pts: []f32, n: int, evenOdd: bool) {
    ensure();
    let d = SDEPTH[slot];
    SDEPTH[slot] = d + 1;
    if d >= 4 {
        return;
    }
    let o = (slot * 4 + d) * (2 * MAXPT);
    for i in 0..SHN[slot] * 2 {
        SSTK[o + i] = SHP[slot * (2 * MAXPT) + i];
    }
    SSN[slot * 4 + d] = SHN[slot];
    SSR[slot * 4 + d] = SHR[slot];
    let m = n;
    if m > MAXPT {
        m = MAXPT;
    }
    if 2 * m > pts.len {
        m = pts.len / 2;
    }
    for i in 0..m {
        let x = pts[2 * i];
        if x < -100000000.0 {
            SHP[slot * (2 * MAXPT) + 2 * i] = x;
            SHP[slot * (2 * MAXPT) + 2 * i + 1] = 0.0;
        } else {
            SHP[slot * (2 * MAXPT) + 2 * i] = x * P.s + P.tx;
            SHP[slot * (2 * MAXPT) + 2 * i + 1] = pts[2 * i + 1] * P.s + P.ty;
        }
    }
    SHN[slot] = m;
    SHR[slot] = if evenOdd { 1 } else { 0 };
    applyShape(slot);
}

/// Undo the last `pushShape` of `slot`.
pub fn popShape(slot: int) {
    ensure();
    if SDEPTH[slot] == 0 {
        return;
    }
    SDEPTH[slot] -= 1;
    let d = SDEPTH[slot];
    if d >= 4 {
        return;
    }
    let o = (slot * 4 + d) * (2 * MAXPT);
    SHN[slot] = SSN[slot * 4 + d];
    SHR[slot] = SSR[slot * 4 + d];
    for i in 0..SHN[slot] * 2 {
        SHP[slot * (2 * MAXPT) + i] = SSTK[o + i];
    }
    applyShape(slot);
}

/// Fill the outline `pts` (see `pushShape`; concave, holes and self-crossings follow the fill rule)
/// with one color. Uses slot 1 for the duration and flushes twice, so it is a draw call per path.
pub fn fillShape(pts: []f32, n: int, evenOdd: bool, color: Color) {
    let x0: f32 = 1000000000.0;
    let y0: f32 = 1000000000.0;
    let x1: f32 = -1000000000.0;
    let y1: f32 = -1000000000.0;
    for i in 0..n {
        let x = pts[2 * i];
        if x < -100000000.0 {
            continue;
        }
        let y = pts[2 * i + 1];
        if x < x0 { x0 = x; }
        if y < y0 { y0 = y; }
        if x > x1 { x1 = x; }
        if y > y1 { y1 = y; }
    }
    if x1 < x0 {
        return;
    }
    pushShape(1, pts, n, evenOdd);
    rect(Vec2 { x: x0 - 1.0, y: y0 - 1.0 }, Vec2 { x: x1 - x0 + 2.0, y: y1 - y0 + 2.0 }, color);
    popShape(1);
}

/// Saved masks: kind, row, angle, x, y, w, h each, and the current one.
#[singleton]
let MSTK: [28]f32;
#[singleton]
let MCUR: [7]f32;
#[singleton]
let MDEPTH: [1]int;

fn applyMask() {
    game.p2Mask(int(MCUR[0]), int(MCUR[1]), MCUR[2], MCUR[3], MCUR[4], MCUR[5], MCUR[6]);
}

/// Multiply the alpha of later draws by the gradient `row` (from `gradient`) laid over the box
/// `pos`/`size`: `kind` 1 linear at `angle` radians (0 up, clockwise), 2 radial from the center
/// (`mask-image`). One mask is active; a nested push replaces it until `popMask` (four deep).
pub fn pushMask(kind: int, row: int, angle: f32, pos: Vec2, size: Vec2) {
    ensure();
    let d = MDEPTH[0];
    MDEPTH[0] = d + 1;
    if d >= 4 {
        return;
    }
    for i in 0..7 {
        MSTK[d * 7 + i] = MCUR[i];
    }
    MCUR[0] = f32(kind);
    MCUR[1] = f32(row);
    MCUR[2] = angle;
    MCUR[3] = pos.x * P.s + P.tx;
    MCUR[4] = pos.y * P.s + P.ty;
    MCUR[5] = size.x * P.s;
    MCUR[6] = size.y * P.s;
    applyMask();
}

/// Undo the last `pushMask`.
pub fn popMask() {
    ensure();
    if MDEPTH[0] == 0 {
        return;
    }
    MDEPTH[0] -= 1;
    let d = MDEPTH[0];
    if d >= 4 {
        return;
    }
    for i in 0..7 {
        MCUR[i] = MSTK[d * 7 + i];
    }
    applyMask();
}
