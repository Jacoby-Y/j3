// Part of j3.gfx.paint (gradient ramps and gradient rects/borders).

module j3.gfx.paint;

/// `push` for the kinds that read `u0..dv` (gradient, shadow, dashed border).
fn pushG(kind: int, x: f32, y: f32, w: f32, h: f32, g0: f32, g1: f32, g2: f32, g3: f32, c1: Color, c2: Color, p0: f32, p1: f32, p2: f32, p3: f32, bw: f32) {
    ensure();
    game.p2Push(kind, x * P.s + P.tx, y * P.s + P.ty, w * P.s, h * P.s, g0, g1, g2, g3, tint(c1), tint(c2), p0, p1, p2, p3, bw, 0);
}

/// Write texel `i` of the ramp being baked from premultiplied 0..255 channels.
fn rampPut(i: int, pr: f32, pg: f32, pb: f32, pa: f32) {
    let k: f32 = 1.0;
    if pa > 0.5 {
        k = 255.0 / pa;
    }
    RAMPBUF[i * 4] = u8(pr * k + 0.5);
    RAMPBUF[i * 4 + 1] = u8(pg * k + 0.5);
    RAMPBUF[i * 4 + 2] = u8(pb * k + 0.5);
    RAMPBUF[i * 4 + 3] = u8(pa + 0.5);
}

/// Bake `stops` into `RAMPBUF`, blending premultiplied like CSS so a fade to transparent has no
/// dark fringe.
fn bake(stops: []Stop) {
    let n = stops.len;
    for i in 0..game.RAMP_W {
        let t = f32(i) / f32(game.RAMP_W - 1);
        let lo = stops[0];
        let hi = stops[n - 1];
        if t <= lo.at {
            hi = lo;
            t = lo.at;
        } else if t >= hi.at {
            lo = hi;
        } else {
            let k = 1;
            while stops[k].at < t {
                k += 1;
            }
            lo = stops[k - 1];
            hi = stops[k];
        }
        let f: f32 = 0.0;
        if hi.at - lo.at > 0.0001 {
            f = (t - lo.at) / (hi.at - lo.at);
        }
        let la = f32(lo.color.a);
        let ha = f32(hi.color.a);
        let pa = la + (ha - la) * f;
        let pr = f32(lo.color.r) * la / 255.0;
        let pg = f32(lo.color.g) * la / 255.0;
        let pb = f32(lo.color.b) * la / 255.0;
        let qr = f32(hi.color.r) * ha / 255.0;
        let qg = f32(hi.color.g) * ha / 255.0;
        let qb = f32(hi.color.b) * ha / 255.0;
        rampPut(i, pr + (qr - pr) * f, pg + (qg - pg) * f, pb + (qb - pb) * f, pa);
    }
}

/// Ramp row for a stop list, baking it on first use (64 distinct lists; the oldest row is reused
/// after that). Cheap to call every frame. `stops` must be ascending in `at`; empty gives row 0.
pub fn gradient(stops: []Stop): int {
    ensure();
    if stops.len == 0 {
        return 0;
    }
    let h = 7;
    for s in stops {
        h = h * 31 + int(s.at * 1000.0);
        h = h * 31 + int(s.color.r) + int(s.color.g) * 256 + int(s.color.b) * 65536 + int(s.color.a) * 16777216;
    }
    if h == 0 {
        h = 1;
    }
    for row in 0..game.RAMP_ROWS {
        if GKEY[row] == h {
            return row;
        }
    }
    let row = P.gnext;
    P.gnext = (row + 1) % game.RAMP_ROWS;
    GKEY[row] = h;
    bake(stops);
    game.p2RampRow(row, &RAMPBUF[0] as ptr);
    return row;
}

/// `roundRectEx` filled with gradient `row`. `kind`: 0 linear (`angle` in degrees, CSS style: 0
/// points up, 90 right), 1 radial (centered ellipse to the farthest corner), 2 conic (`angle`
/// is where it starts, clockwise from up). The border is the solid `border` of width `bw`.
pub fn gradientRect(pos: Vec2, size: Vec2, c: Corners, row: int, kind: int, angle: f32, bw: f32, border: Color) {
    ensure();
    let white = Color { r: 255, g: 255, b: 255, a: 255 };
    pushG(6, pos.x, pos.y, size.x, size.y, angle * 0.017453292, f32(row), f32(kind), 0,
        white, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// `roundRectEx` whose border of width `bw` is gradient `row` (see `gradientRect`) over the solid
/// `fill`.
pub fn gradientBorder(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, row: int, kind: int, angle: f32) {
    ensure();
    let white = Color { r: 255, g: 255, b: 255, a: 255 };
    pushG(6, pos.x, pos.y, size.x, size.y, angle * 0.017453292, f32(row), f32(kind), 1,
        fill, white, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}
