// Part of j3.gfx.paint (transforms, alpha, views).

module j3.gfx.paint;

fn saveTransform() {
    if P.tn >= 32 {
        panic("paint: transform stack too deep");
    }
    let o = P.tn * 3;
    TSTACK[o] = P.s;
    TSTACK[o + 1] = P.tx;
    TSTACK[o + 2] = P.ty;
    let r = P.tn * 7;
    RSTACK[r] = 0;
    if P.rot {
        RSTACK[r] = 1;
    }
    RSTACK[r + 1] = P.ra;
    RSTACK[r + 2] = P.rb;
    RSTACK[r + 3] = P.rc;
    RSTACK[r + 4] = P.rd;
    RSTACK[r + 5] = P.rx;
    RSTACK[r + 6] = P.ry;
    P.tn += 1;
}

fn applyRot() {
    game.p2Affine(P.rot, P.ra, P.rb, P.rc, P.rd, P.rx, P.ry);
    if CKI[0] > CKI[1] {
        applyClips(false);
    }
}

/// Turn later draws by `rad` about the point `(px, py)` in view pixels (composes with what is set).
fn rotateAbout(px: f32, py: f32, rad: f32) {
    let cs = cos(rad);
    let sn = sin(rad);
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    let u = px - (cs * px - sn * py);
    let v = py - (sn * px + cs * py);
    let na = P.ra * cs + P.rc * sn;
    let nc = 0 - P.ra * sn + P.rc * cs;
    let nb = P.rb * cs + P.rd * sn;
    let nd = 0 - P.rb * sn + P.rd * cs;
    let nx = P.ra * u + P.rc * v + P.rx;
    let ny = P.rb * u + P.rd * v + P.ry;
    P.ra = na;
    P.rb = nb;
    P.rc = nc;
    P.rd = nd;
    P.rx = nx;
    P.ry = ny;
    applyRot();
}

/// Turn later draws by `rad` radians (clockwise on screen) about `origin` (current coordinates).
/// Shapes, text, and images rotate, and a `pushClip` after it clips to the turned rect (see `pushClip`). Undo with `popTransform`.
pub fn pushRotate(origin: Vec2, rad: f32) {
    ensure();
    saveTransform();
    rotateAbout(origin.x * P.s + P.tx, origin.y * P.s + P.ty, rad);
}

/// Slant later draws horizontally: a point `y` above `origin` moves right by `k * y` (`k` 0.2 is a faux italic), the
/// row of `origin` stays put. Shapes, text, and images slant like `pushRotate` turns them. Undo with `popTransform`.
pub fn pushSkew(origin: Vec2, k: f32) {
    ensure();
    saveTransform();
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    let u = k * (origin.y * P.s + P.ty);
    P.rx = P.ra * u + P.rx;
    P.ry = P.rb * u + P.ry;
    P.rc = P.rc - k * P.ra;
    P.rd = P.rd - k * P.rb;
    applyRot();
}

/// Translate by `move`, turn by `rad`, then scale by `s`, the last two about `origin`: a CSS
/// `transform` box in one stack entry. Undo with `popTransform`.
pub fn pushXform(origin: Vec2, move: Vec2, rad: f32, s: f32) {
    ensure();
    saveTransform();
    P.tx = P.tx + move.x * P.s;
    P.ty = P.ty + move.y * P.s;
    if rad != 0 {
        rotateAbout(origin.x * P.s + P.tx, origin.y * P.s + P.ty, rad);
    }
    if s != 1 {
        P.tx = P.tx + origin.x * P.s * (1 - s);
        P.ty = P.ty + origin.y * P.s * (1 - s);
        P.s = P.s * s;
    }
}

/// Apply the 2D affine matrix `a b c d e f` (CSS `matrix()`: `x' = a x + c y + e`, `y' = b x + d y + f`) to later draws, in
/// current coordinates. Translation and uniform scale stay on the fast path (clips follow them); rotation, skew and non-uniform
/// scale go through `game.p2Affine` (shapes, text and images follow, and a later `pushClip` clips to the turned rect). Undo with `popTransform`.
pub fn pushAffine(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) {
    ensure();
    saveTransform();
    let s = P.s;
    if b == 0 && c == 0 && a == d && a > 0 {
        P.tx = P.tx + e * s;
        P.ty = P.ty + f * s;
        P.s = s * a;
        return;
    }
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    // view' = A (view - t) + s B + t, then composed after the current rotation layer
    let vx = P.tx - (a * P.tx + c * P.ty) + s * e;
    let vy = P.ty - (b * P.tx + d * P.ty) + s * f;
    let na = P.ra * a + P.rc * b;
    let nc = P.ra * c + P.rc * d;
    let nb = P.rb * a + P.rd * b;
    let nd = P.rb * c + P.rd * d;
    let nx = P.ra * vx + P.rc * vy + P.rx;
    let ny = P.rb * vx + P.rd * vy + P.ry;
    P.ra = na;
    P.rb = nb;
    P.rc = nc;
    P.rd = nd;
    P.rx = nx;
    P.ry = ny;
    applyRot();
}

/// Move the origin by `d` (in the current, possibly scaled, coordinates).
pub fn pushTranslate(d: Vec2) {
    ensure();
    saveTransform();
    P.tx = P.tx + d.x * P.s;
    P.ty = P.ty + d.y * P.s;
}

/// Scale about `origin` (current coordinates) by `s`. Uniform scale only (`pushRotate` turns).
pub fn pushScale(origin: Vec2, s: f32) {
    ensure();
    saveTransform();
    P.tx = P.tx + origin.x * P.s * (1 - s);
    P.ty = P.ty + origin.y * P.s * (1 - s);
    P.s = P.s * s;
}

/// Reset the transform to identity (undo with `popTransform`). For code that draws in view
/// coordinates inside a `pushView`, such as a `<canvas>` body.
pub fn pushIdentity() {
    ensure();
    saveTransform();
    P.s = 1;
    P.tx = 0;
    P.ty = 0;
    P.rot = false;
    applyRot();
}

/// Undo the last `pushTranslate`, `pushScale`, `pushRotate`, `pushXform`, or `pushIdentity`.
pub fn popTransform() {
    ensure();
    if P.tn == 0 {
        return;
    }
    P.tn -= 1;
    let o = P.tn * 3;
    P.s = TSTACK[o];
    P.tx = TSTACK[o + 1];
    P.ty = TSTACK[o + 2];
    let r = P.tn * 7;
    P.rot = RSTACK[r] > 0.5;
    P.ra = RSTACK[r + 1];
    P.rb = RSTACK[r + 2];
    P.rc = RSTACK[r + 3];
    P.rd = RSTACK[r + 4];
    P.rx = RSTACK[r + 5];
    P.ry = RSTACK[r + 6];
    applyRot();
}

/// Multiply the alpha of later draws by `a` (0 to 1).
/// ponytail: this fades each shape on its own, so overlapping children show through each other;
/// real group opacity needs a render-to-texture layer.
pub fn pushAlpha(a: f32) {
    ensure();
    if P.an >= 32 {
        panic("paint: alpha stack too deep");
    }
    ASTACK[P.an] = P.a;
    P.an += 1;
    P.a = P.a * a;
}

/// Undo the last `pushAlpha`.
pub fn popAlpha() {
    ensure();
    if P.an == 0 {
        return;
    }
    P.an -= 1;
    P.a = ASTACK[P.an];
}

/// Draw into a sub-rectangle of the window: `(0, 0)` becomes `pos` and clipping follows its
/// bounds. Nests. Flushes, and `j3.game` 2D draws follow it too; turned clips stay where they are on screen.
pub fn pushView(pos: Vec2, size: Vec2) {
    ensure();
    game.p2PushView(pos, size);
    // The active clip is in the outer view's coordinates; move it into this one's.
    saveClip();
    P.cx0 -= pos.x;
    P.cy0 -= pos.y;
    P.cx1 -= pos.x;
    P.cy1 -= pos.y;
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1);
    CKO[0] += pos.x;
    CKO[1] += pos.y;
    if CKI[0] > CKI[1] {
        applyClips(true);
    }
}

/// Undo the last `pushView`.
pub fn popView() {
    game.p2PopView();
    popClip();
}
