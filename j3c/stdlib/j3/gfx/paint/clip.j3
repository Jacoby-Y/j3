// Part of j3.gfx.paint (clip rects and shape clips).

module j3.gfx.paint;

/// Clip later draws to a rect (intersected with the clip already active). Under a rotation or skew the clip is the
/// turned rect itself: a scissor on its bounding box plus an antialiased shape test in the shader (`game.p2ClipShapes`),
/// intersected with every outer clip, rect or shape. At most four such shape clips are nested at once (layers, `beginLayer`,
/// count too); a fifth falls back to the bounding box and prints one warning to stderr.
pub fn pushClip(pos: Vec2, size: Vec2) {
    ensure();
    saveClip();
    let x0 = pos.x * P.s + P.tx;
    let y0 = pos.y * P.s + P.ty;
    let x1 = x0 + size.x * P.s;
    let y1 = y0 + size.y * P.s;
    let shaped = false;
    if P.rot {
        if !axisAligned() {
            shaped = addClipShape(x0, y0, x1, y1);
        }
        // the scissor is the bounding box of the turned rect
        let ax = P.ra * x0 + P.rc * y0 + P.rx;
        let ay = P.rb * x0 + P.rd * y0 + P.ry;
        let bx = P.ra * x1 + P.rc * y0 + P.rx;
        let by = P.rb * x1 + P.rd * y0 + P.ry;
        let cx = P.ra * x0 + P.rc * y1 + P.rx;
        let cy = P.rb * x0 + P.rd * y1 + P.ry;
        let dx = P.ra * x1 + P.rc * y1 + P.rx;
        let dy = P.rb * x1 + P.rd * y1 + P.ry;
        x0 = min(min(ax, bx), min(cx, dx));
        x1 = max(max(ax, bx), max(cx, dx));
        y0 = min(min(ay, by), min(cy, dy));
        y1 = max(max(ay, by), max(cy, dy));
    }
    if P.clipOn {
        if x0 < P.cx0 { x0 = P.cx0; }
        if y0 < P.cy0 { y0 = P.cy0; }
        if x1 > P.cx1 { x1 = P.cx1; }
        if y1 > P.cy1 { y1 = P.cy1; }
        if x1 < x0 { x1 = x0; }
        if y1 < y0 { y1 = y0; }
    }
    P.clipOn = true;
    P.cx0 = x0;
    P.cy0 = y0;
    P.cx1 = x1;
    P.cy1 = y1;
    game.p2Clip(true, x0, y0, x1, y1);
    if shaped {
        applyClips(true);
    }
}

/// Screen-space outlines of the active turned clips (4 rows of 128 floats), the same in the frame the
/// affine turns (what the shader tests), their point counts, and: top, base (clips below it belong to a
/// captured layer or were escaped by `pushNoClip`), warned, and the affine the frame rows were made for.
#[singleton]
let CKS: [512]f32;
#[singleton]
let CKF: [512]f32;
#[singleton]
let CKC: [4]int;
#[singleton]
let CKI: [3]int;
#[singleton]
let CKA: [7]f32;
/// Where the current `pushView` sits in the outermost view: `CKS` is kept in those coordinates.
#[singleton]
let CKO: [2]f32;

/// Whether the current rotation layer keeps axes on axes (quarter turns, flips, non-uniform scale): the scissor is exact then.
fn axisAligned(): bool {
    let d = max(abs(P.ra), abs(P.rd));
    let o = max(abs(P.rb), abs(P.rc));
    return o < 0.0001 * d || d < 0.0001 * o;
}

/// Push the turned rect (frame coordinates, ends at most 1e5 out so an unclipped axis stays a strip) as a shape clip.
/// False when four are already nested: the caller keeps the bounding box and a warning is printed once.
fn addClipShape(x0: f32, y0: f32, x1: f32, y1: f32): bool {
    let k = CKI[0];
    if k >= 4 {
        if CKI[2] == 0 {
            CKI[2] = 1;
            let m = "paint.pushClip: more than four nested rotated clips, the inner ones clip to their bounding box\n";
            write(2, m.ptr as ptr, m.len);
        }
        return false;
    }
    x0 = max(x0, -100000.0);
    y0 = max(y0, -100000.0);
    x1 = min(x1, 100000.0);
    y1 = min(y1, 100000.0);
    let o = k * 128;
    for i in 0..5 {
        let x = if i == 1 || i == 2 { x1 } else { x0 };
        let y = if i == 2 || i == 3 { y1 } else { y0 };
        CKS[o + 2 * i] = P.ra * x + P.rc * y + P.rx + CKO[0];
        CKS[o + 2 * i + 1] = P.rb * x + P.rd * y + P.ry + CKO[1];
    }
    CKC[k] = 5;
    CKI[0] = k + 1;
    return true;
}

/// Hand the active turned clips to the painter, mapped back into the frame the current affine turns. Skipped when
/// nothing changed (same clips and affine), so child transforms inside a clip do not break batches.
fn applyClips(force: bool) {
    let n = CKI[0] - CKI[1];
    let on = P.rot;
    if !force && n > 0 && CKA[0] == (if on { 1.0 } else { 0.0 }) && CKA[1] == P.ra && CKA[2] == P.rb && CKA[3] == P.rc && CKA[4] == P.rd && CKA[5] == P.rx && CKA[6] == P.ry {
        return;
    }
    // draws queued under the old rows go out before CKF is rewritten (they read it at flush)
    game.p2Flush();
    CKA[0] = if on { 1.0 } else { 0.0 };
    CKA[1] = P.ra; CKA[2] = P.rb; CKA[3] = P.rc; CKA[4] = P.rd; CKA[5] = P.rx; CKA[6] = P.ry;
    let det = P.ra * P.rd - P.rb * P.rc;
    if n <= 0 || (on && abs(det) < 0.000000001) {
        game.p2ClipShapes(0, &CKF[0] as ptr, 0, 0, 0, 0);
        return;
    }
    for j in 0..n {
        let o = (CKI[1] + j) * 128;
        for i in 0..CKC[CKI[1] + j] {
            let x = CKS[o + 2 * i];
            let y = CKS[o + 2 * i + 1];
            if !on {
                x = x - CKO[0];
                y = y - CKO[1];
            } else {
                let dx = x - CKO[0] - P.rx;
                let dy = y - CKO[1] - P.ry;
                x = (P.rd * dx - P.rc * dy) / det;
                y = (P.ra * dy - P.rb * dx) / det;
            }
            CKF[o + 2 * i] = x;
            CKF[o + 2 * i + 1] = y;
        }
    }
    let b = CKI[1];
    game.p2ClipShapes(n, &CKF[b * 128] as ptr, CKC[b], if n > 1 { CKC[b + 1] } else { 0 }, if n > 2 { CKC[b + 2] } else { 0 }, if n > 3 { CKC[b + 3] } else { 0 });
}

/// Draw later content without any clip, like a `position: fixed` box escaping its ancestors'
/// `overflow`. Undo with `popClip`.
pub fn pushNoClip() {
    ensure();
    saveClip();
    P.clipOn = false;
    game.p2Clip(false, 0.0, 0.0, 0.0, 0.0);
    if CKI[0] > CKI[1] {
        CKI[1] = CKI[0];
        applyClips(true);
    }
}

fn saveClip() {
    if P.cn >= 16 {
        panic("paint.pushClip: nested too deep");
    }
    let o = P.cn * 9;
    CSTACK[o + 7] = CKO[0];
    CSTACK[o + 8] = CKO[1];
    CSTACK[o + 5] = f32(CKI[0]);
    CSTACK[o + 6] = f32(CKI[1]);
    CSTACK[o] = if P.clipOn { 1.0 } else { 0.0 };
    CSTACK[o + 1] = P.cx0;
    CSTACK[o + 2] = P.cy0;
    CSTACK[o + 3] = P.cx1;
    CSTACK[o + 4] = P.cy1;
    P.cn += 1;
}

/// Undo the last `pushClip`.
pub fn popClip() {
    ensure();
    if P.cn == 0 {
        return;
    }
    P.cn -= 1;
    let o = P.cn * 9;
    let was = CKI[0] > CKI[1];
    CKO[0] = CSTACK[o + 7];
    CKO[1] = CSTACK[o + 8];
    CKI[0] = int(CSTACK[o + 5]);
    CKI[1] = int(CSTACK[o + 6]);
    if was || CKI[0] > CKI[1] {
        applyClips(true);
    }
    P.clipOn = CSTACK[o] > 0.5;
    P.cx0 = CSTACK[o + 1];
    P.cy0 = CSTACK[o + 2];
    P.cx1 = CSTACK[o + 3];
    P.cy1 = CSTACK[o + 4];
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1);
}
