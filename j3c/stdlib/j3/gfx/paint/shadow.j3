// Part of j3.gfx.paint (box shadows, inset shadows, dashed borders).

module j3.gfx.paint;

/// Soft shadow of a rounded box like CSS `box-shadow` (`blur` is the CSS blur radius, so the
/// Gaussian sigma is half of it; `spread` grows the box). Draw it before the box. A bright
/// `color` with zero `offset` is a glow.
pub fn shadow(pos: Vec2, size: Vec2, c: Corners, offset: Vec2, blur: f32, spread: f32, color: Color) {
    ensure();
    let sg = blur * 0.5;
    if sg < 0.25 {
        sg = 0.25;
    }
    let grow = 3.0 * sg;
    let hx = size.x * 0.5 + spread;
    let hy = size.y * 0.5 + spread;
    if hx <= 0 || hy <= 0 {
        return;
    }
    let cx = pos.x + size.x * 0.5 + offset.x;
    let cy = pos.y + size.y * 0.5 + offset.y;
    let r = P.s;
    pushG(7, cx - hx - grow, cy - hy - grow, (hx + grow) * 2, (hy + grow) * 2, hx * r, hy * r, sg * r, 0,
        color, color, grown(c.tl, spread) * r, grown(c.tr, spread) * r, grown(c.br, spread) * r, grown(c.bl, spread) * r, 0);
}

/// Corner radius `r` after growing the box by `spread` (a sharp corner stays sharp).
fn grown(r: f32, spread: f32): f32 {
    if r <= 0 {
        return 0;
    }
    let g = r + spread;
    if g < 0 {
        return 0;
    }
    return g;
}

/// Inner shadow like CSS `box-shadow: inset`: the box edges darken inward, the hole shifted by
/// `offset` and shrunk by `spread`. Draw it over the fill.
pub fn insetShadow(pos: Vec2, size: Vec2, c: Corners, offset: Vec2, blur: f32, spread: f32, color: Color) {
    ensure();
    let sg = blur * 0.5;
    if sg < 0.25 {
        sg = 0.25;
    }
    let r = P.s;
    pushG(8, pos.x, pos.y, size.x, size.y, offset.x * r, offset.y * r, sg * r, spread * r,
        color, color, c.tl * r, c.tr * r, c.br * r, c.bl * r, 0);
}

/// `roundRectEx` with a dashed (`style` 1) or dotted (`style` 2) border of width `bw`. Dashes
/// restart on each side, so a corner may not land on one.
pub fn roundRectDashed(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, border: Color, style: int) {
    ensure();
    let period = bw * 5.0;
    if style == 2 {
        period = bw * 2.0;
    }
    if period < 4.0 {
        period = 4.0;
    }
    pushG(9, pos.x, pos.y, size.x, size.y, f32(style), period * P.s, 0, 0,
        fill, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}
