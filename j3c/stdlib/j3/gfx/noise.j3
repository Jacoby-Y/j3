/// Tileable 2D noise for textures: value, gradient (Perlin), cells (Worley), and stripes,
/// summed in octaves and shaped by modifiers, then colored by a ramp. Everything wraps at
/// the texture's edge, so baked textures repeat without seams. No bitwise ops: the hash is
/// a seeded permutation table.

module j3.gfx.noise;

use j3.math.{ Vec3, floor, sin, sqrt, PI };
use j3.memory.Arena;
use j3.rand.Rng;

/// Base patterns.
pub const VALUE: int = 0;
pub const PERLIN: int = 1;
pub const CELLS: int = 2;
pub const STRIPES: int = 3;
pub const KINDS: int = 4;

/// How octaves combine.
pub const SINGLE: int = 0;
pub const FBM: int = 1;
pub const RIDGED: int = 2;
pub const BILLOW: int = 3;
pub const FRACTALS: int = 4;

/// What `CELLS` measures: distance to the nearest point, the second nearest, or the gap
/// between them (cracks).
pub const NEAREST: int = 0;
pub const SECOND: int = 1;
pub const EDGES: int = 2;
pub const CELL_MODES: int = 3;

pub struct Noise {
    kind: int;
    fractal: int;
    /// 1..8.
    octaves: int;
    /// Frequency step between octaves; whole numbers keep the texture tiling.
    lacunarity: int;
    /// Weight step between octaves.
    gain: f32;
    /// Features across the texture; rounded so it tiles.
    scale: f32;
    seed: int;
    /// Domain warp strength, in features.
    warp: f32;
    /// `NEAREST`, `SECOND`, or `EDGES` for `CELLS`.
    cell: int;
    contrast: f32;
    brightness: f32;
    invert: bool;
    /// Posterize to this many levels; 0 or 1 is off.
    steps: int;
    /// Hard cut: at or above is 1, below is 0. 0 is off.
    threshold: f32;
    /// Seeded permutation of 0..255, twice.
    perm: []int;
}

/// Color stops, positions ascending in 0..1.
pub struct Ramp {
    count: int;
    pos: [4]f32;
    color: [4]Vec3;
}

/// Defaults: 4 octaves of Perlin fbm, 8 features across. The table lives in `arena`.
pub fn make(seed: int, arena: &Arena): Noise {
    let n = Noise {
        kind: PERLIN,
        fractal: FBM,
        octaves: 4,
        lacunarity: 2,
        gain: 0.5,
        scale: 8,
        seed: seed,
        warp: 0,
        cell: NEAREST,
        contrast: 1,
        brightness: 0,
        invert: false,
        steps: 0,
        threshold: 0,
        perm: arena.alloc::<int>(512),
    };
    reseed(&n, seed);
    return n;
}

/// Shuffle the permutation table for `seed`.
pub fn reseed(n: &Noise, seed: int) {
    n.seed = seed;
    let i = 0;
    while i < 256 {
        n.perm[i] = i;
        i += 1;
    }
    let rng = Rng.new(seed * 7919 + 17);
    i = 255;
    while i > 0 {
        let j = rng.intRange(0, i + 1);
        let keep = n.perm[i];
        n.perm[i] = n.perm[j];
        n.perm[j] = keep;
        i -= 1;
    }
    i = 0;
    while i < 256 {
        n.perm[i + 256] = n.perm[i];
        i += 1;
    }
}

/// A two-stop ramp from `a` to `b`.
pub fn ramp2(a: Vec3, b: Vec3): Ramp {
    let r = Ramp {
        count: 2,
        pos: [0, 1, 1, 1],
        color: [a, b, b, b],
    };
    return r;
}

/// The ramp's color at `t` (0..1).
pub fn shade(r: &Ramp, t: f32): Vec3 {
    if r.count <= 0 { return Vec3.xyz(t, t, t); }
    if t <= r.pos[0] { return r.color[0]; }
    let i = 1;
    while i < r.count {
        if t <= r.pos[i] {
            let span = r.pos[i] - r.pos[i - 1];
            let f: f32 = 1;
            if span > 0.00001 { f = (t - r.pos[i - 1]) / span; }
            return r.color[i - 1] + (r.color[i] - r.color[i - 1]) * f;
        }
        i += 1;
    }
    return r.color[r.count - 1];
}

/// Noise at texture coordinates `x`, `y` (0..1 covers the texture once), in 0..1.
pub fn sample(n: &Noise, x: f32, y: f32): f32 {
    let period = periodOf(n.scale);
    let px = x * f32(period);
    let py = y * f32(period);
    if n.warp > 0 {
        // Push the lookup by another noise; the offsets tile with the same period.
        let wx = fractal(n, PERLIN, px + 5.2, py + 1.3, period) - 0.5;
        let wy = fractal(n, PERLIN, px + 9.7, py + 4.1, period) - 0.5;
        px += wx * n.warp * 2;
        py += wy * n.warp * 2;
    }
    let v = fractal(n, n.kind, px, py, period);
    v = (v - 0.5) * n.contrast + 0.5 + n.brightness;
    if n.invert { v = 1 - v; }
    v = unit(v);
    if n.steps > 1 {
        let level = floor(v * f32(n.steps));
        if level > f32(n.steps - 1) { level = f32(n.steps - 1); }
        v = level / f32(n.steps - 1);
    }
    if n.threshold > 0 {
        if v >= n.threshold { v = 1; } else { v = 0; }
    }
    return v;
}

/// Bake a `size` x `size` RGBA texture of `n` colored by `r`.
pub fn bake(n: &Noise, r: &Ramp, size: int, arena: &Arena): []u8 {
    let pixels = arena.alloc::<u8>(size * size * 4);
    let y = 0;
    while y < size {
        let x = 0;
        while x < size {
            let c = shade(r, sample(n, (f32(x) + 0.5) / f32(size), (f32(y) + 0.5) / f32(size)));
            let at = (y * size + x) * 4;
            pixels[at] = u8(unit(c.x) * 255 + 0.5);
            pixels[at + 1] = u8(unit(c.y) * 255 + 0.5);
            pixels[at + 2] = u8(unit(c.z) * 255 + 0.5);
            pixels[at + 3] = 255;
            x += 1;
        }
        y += 1;
    }
    return pixels;
}

fn periodOf(scale: f32): int {
    let p = int(scale + 0.5);
    if p < 1 { p = 1; }
    if p > 256 { p = 256; }
    return p;
}

fn unit(v: f32): f32 {
    if v < 0 { return 0; }
    if v > 1 { return 1; }
    return v;
}

fn absf(v: f32): f32 {
    if v < 0 { return 0 - v; }
    return v;
}

/// Octaves of `kind` combined by `n.fractal`, in 0..1.
fn fractal(n: &Noise, kind: int, x: f32, y: f32, period: int): f32 {
    if n.fractal == SINGLE || n.octaves <= 1 { return base(n, kind, x, y, period); }
    let lac = n.lacunarity;
    if lac < 1 { lac = 1; }
    let sum: f32 = 0;
    let total: f32 = 0;
    let weight: f32 = 1;
    let freq = 1;
    let k = 0;
    while k < n.octaves && k < 8 {
        let b = base(n, kind, x * f32(freq) + f32(k) * 31.7, y * f32(freq) + f32(k) * 17.3, period * freq);
        let v = b;
        if n.fractal == RIDGED {
            v = 1 - absf(b * 2 - 1);
            v = v * v;
        } else if n.fractal == BILLOW {
            v = absf(b * 2 - 1);
        }
        sum += v * weight;
        total += weight;
        weight *= n.gain;
        freq *= lac;
        k += 1;
    }
    if total <= 0 { return 0; }
    return sum / total;
}

fn base(n: &Noise, kind: int, x: f32, y: f32, period: int): f32 {
    if kind == VALUE { return valueAt(n, x, y, period); }
    if kind == CELLS { return cellsAt(n, x, y, period); }
    if kind == STRIPES { return 0.5 + 0.5 * sin(x * 2 * PI); }
    return perlinAt(n, x, y, period);
}

/// `i` wrapped into 0..period.
fn wrap(i: int, period: int): int {
    let r = i - (i / period) * period;
    if r < 0 { r += period; }
    return r;
}

/// Lattice point hash, 0..255.
fn hash(n: &Noise, ix: int, iy: int): int {
    let a = n.perm[wrap(ix, 256)];
    return n.perm[a + wrap(iy, 256)];
}

fn smooth(t: f32): f32 { return t * t * t * (t * (t * 6 - 15) + 10); }

fn valueAt(n: &Noise, x: f32, y: f32, period: int): f32 {
    let fx = floor(x);
    let fy = floor(y);
    let ix = int(fx);
    let iy = int(fy);
    let tx = smooth(x - fx);
    let ty = smooth(y - fy);
    let x0 = wrap(ix, period);
    let x1 = wrap(ix + 1, period);
    let y0 = wrap(iy, period);
    let y1 = wrap(iy + 1, period);
    let a = f32(hash(n, x0, y0)) / 255;
    let b = f32(hash(n, x1, y0)) / 255;
    let c = f32(hash(n, x0, y1)) / 255;
    let d = f32(hash(n, x1, y1)) / 255;
    let top = a + (b - a) * tx;
    let bottom = c + (d - c) * tx;
    return top + (bottom - top) * ty;
}

/// Dot of one of 8 gradient directions (picked by `h`) with `(dx, dy)`.
fn grad(h: int, dx: f32, dy: f32): f32 {
    let g = h - (h / 8) * 8;
    if g == 0 { return dx + dy; }
    if g == 1 { return dx - dy; }
    if g == 2 { return 0 - dx + dy; }
    if g == 3 { return 0 - dx - dy; }
    if g == 4 { return dx * 1.4142; }
    if g == 5 { return 0 - dx * 1.4142; }
    if g == 6 { return dy * 1.4142; }
    return 0 - dy * 1.4142;
}

fn perlinAt(n: &Noise, x: f32, y: f32, period: int): f32 {
    let fx = floor(x);
    let fy = floor(y);
    let ix = int(fx);
    let iy = int(fy);
    let dx = x - fx;
    let dy = y - fy;
    let tx = smooth(dx);
    let ty = smooth(dy);
    let x0 = wrap(ix, period);
    let x1 = wrap(ix + 1, period);
    let y0 = wrap(iy, period);
    let y1 = wrap(iy + 1, period);
    let a = grad(hash(n, x0, y0), dx, dy);
    let b = grad(hash(n, x1, y0), dx - 1, dy);
    let c = grad(hash(n, x0, y1), dx, dy - 1);
    let d = grad(hash(n, x1, y1), dx - 1, dy - 1);
    let top = a + (b - a) * tx;
    let bottom = c + (d - c) * tx;
    // Gradient noise stays within about +-1; center it on 0.5.
    return unit(0.5 + (top + (bottom - top) * ty) * 0.5);
}

/// Worley noise: one point per cell, jittered by the hash.
fn cellsAt(n: &Noise, x: f32, y: f32, period: int): f32 {
    let fx = floor(x);
    let fy = floor(y);
    let ix = int(fx);
    let iy = int(fy);
    let d1: f32 = 9;
    let d2: f32 = 9;
    let j = -1;
    while j <= 1 {
        let i = -1;
        while i <= 1 {
            let cx = wrap(ix + i, period);
            let cy = wrap(iy + j, period);
            let h = hash(n, cx, cy);
            let ox = f32(h) / 255;
            let oy = f32(hash(n, cx + 101, cy + 57)) / 255;
            let px = fx + f32(i) + ox - x;
            let py = fy + f32(j) + oy - y;
            let d = sqrt(px * px + py * py);
            if d < d1 {
                d2 = d1;
                d1 = d;
            } else if d < d2 {
                d2 = d;
            }
            i += 1;
        }
        j += 1;
    }
    if n.cell == SECOND { return unit(d2 * 0.75); }
    if n.cell == EDGES { return unit((d2 - d1) * 1.5); }
    return unit(d1);
}
