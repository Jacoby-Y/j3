// Part of j3.gfx (the shared mesh draw, effect uniforms, lights upload).

module j3.gfx;

/// Shared draw for opaque and cutout meshes. `flat` above 0.5 replaces lighting with `color`.
fn drawMesh(mesh: Mesh, model: Mat4, cutout: bool, flat: f32, color: Vec3, nx: f32, ny: f32, alpha: f32) {
    ensure();
    if G.pass == PASS_NONE {
        panic("gfx.draw");
    }
    if mesh.vbo == 0 || mesh.count <= 0 {
        panic("gfx.draw");
    }
    let cut: f32 = 0;
    if cutout {
        cut = 1;
        glDisable(GL_CULL_FACE);
    }
    bindAlbedo();
    if G.pass == PASS_SHADOW { G.mapUsed = true; }
    let see = G.shadowLet;
    if G.pass == PASS_SHADOW && (see.x > 0.001 || see.y > 0.001 || see.z > 0.001) {
        // Multiply the light it lets through into the translucent shadow, keeping the
        // nearest depth, instead of blocking the sun.
        glBindFramebuffer(GL_FRAMEBUFFER, G.passFbo);
        glUseProgram(G.passProg);
        uMat(G.pLight, G.light);
        uMat(G.pModel, model);
        glUniform3f(G.pPass, see.x, see.y, see.z);
        glDisable(GL_DEPTH_TEST);
        glEnable(GL_BLEND);
        glBlendFuncSeparate(GL_ZERO, GL_SRC_COLOR, GL_ONE, GL_ONE);
        glBlendEquationSeparate(GL_FUNC_ADD, GL_MIN);
        submit(mesh, G.pInst);
        glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        glDisable(GL_BLEND);
        glEnable(GL_DEPTH_TEST);
        glBindFramebuffer(GL_FRAMEBUFFER, G.shadowFbo);
        glUseProgram(G.depth);
        if cutout {
            glEnable(GL_CULL_FACE);
        }
        return;
    }
    let shadowInst = G.dInst;
    if G.pass == PASS_SHADOW {
        let own = G.surf.fx;
        if own > 0 && own <= 32 && FXP[own - 1].depth.prog != 0 {
            let d = FXP[own - 1].depth;
            glUseProgram(d.prog);
            uMat(d.light, G.light);
            uMat(d.model, model);
            glUniform1i(d.albedo, 1);
            glUniform1f(d.cutout, cut);
            glUniform1f(d.time, f32(game.ticks()) / 1000);
            fxUniforms(own - 1, []f32 { ptr: &G.surf.fxVals[0], len: 16 }, true);
            shadowInst = d.inst;
        } else {
            glUseProgram(G.depth);
            uMat(G.dLight, G.light);
            uMat(G.dModel, model);
            glUniform1i(G.dAlbedo, 1);
            glUniform1f(G.dCutout, cut);
        }
    } else {
        let level = LIT_PLAIN;
        if G.trace.count > 0 {
            if G.traceShadows { level += LIT_SUN; }
            if G.surf.ior > 1.001 { level += LIT_GLASS; } else if G.surf.reflect > 0.001 { level += LIT_MIRROR; }
        }
        let fx = G.surf.fx;
        if fx > 0 && fx <= 32 && FXP[fx - 1].lit.prog != 0 {
            LIT = FXP[fx - 1].lit;
            glUseProgram(LIT.prog);
            // A slice, not the array: passing a `[16]f32` field by value hits an LLVM-backend bug.
            fxUniforms(fx - 1, []f32 { ptr: &G.surf.fxVals[0], len: 16 }, false);
            fxTextures(fx - 1);
        } else {
            useLit(level);
        }
        uMat(LIT.lProj, G.proj);
        uMat(LIT.lView, G.view);
        uMat(LIT.lLight, G.light);
        uMat(LIT.lModel, model);
        glUniform3f(LIT.lSun, G.sun.x, G.sun.y, G.sun.z);
        glUniform3f(LIT.lSunColor, G.sunColor.x, G.sunColor.y, G.sunColor.z);
        glUniform3f(LIT.lSky, G.sky.x, G.sky.y, G.sky.z);
        glUniform3f(LIT.lEye, G.eye.x, G.eye.y, G.eye.z);
        glUniform1f(LIT.lFog0, G.fogStart);
        glUniform1f(LIT.lFog1, G.fogEnd);
        glActiveTexture(GL_TEXTURE0);
        glBindTexture(GL_TEXTURE_2D, G.shadowTex);
        glUniform1i(LIT.lShadow, 0);
        glUniform1i(LIT.lAlbedo, 1);
        glUniform1f(LIT.lCutout, cut);
        glUniform1f(LIT.lFlat, flat);
        glUniform3f(LIT.lFlatColor, color.x, color.y, color.z);
        glUniform1f(LIT.lAlpha, alpha);
        let sf = G.surf;
        glUniform3f(LIT.lTint, sf.tint.x, sf.tint.y, sf.tint.z);
        glUniform3f(LIT.lGlow, sf.glow.x, sf.glow.y, sf.glow.z);
        glUniform1f(LIT.lSpec, sf.spec);
        glUniform1f(LIT.lShine, sf.shine);
        glUniform1f(LIT.lReflect, sf.reflect);
        glUniform1f(LIT.lEdge, sf.edge);
        glUniform1f(LIT.lIor, sf.ior);
        glUniform1f(LIT.lRough, sf.rough);
        glUniform4f(LIT.lGrabRect, G.grabRect[0], G.grabRect[1], G.grabRect[2], G.grabRect[3]);
        glActiveTexture(GL_TEXTURE3);
        glBindTexture(GL_TEXTURE_2D, if G.grabTex == 0 { G.white } else { G.grabTex });
        glUniform1i(LIT.lGrab, 3);
        glActiveTexture(GL_TEXTURE4);
        glBindTexture(GL_TEXTURE_2D, if G.skyTex == 0 { G.white } else { G.skyTex });
        glUniform1i(LIT.lSkyTex, 4);
        glUniform1f(LIT.lHasSky, if G.skyTex == 0 { 0 } else { 1 });
        glActiveTexture(GL_TEXTURE7);
        glBindTexture(GL_TEXTURE_2D, G.passTex);
        glUniform1f(LIT.lGrabbed, if G.grabbed { 1 } else { 0 });
        glUniform1f(LIT.lThickness, sf.thickness);
        glUniform1f(LIT.lCloud, sf.cloud);
        let tracing = G.trace.count > 0 && (sf.reflect > 0.001 || sf.ior > 1.001);
        glUniform1f(LIT.lTraceOn, if tracing { 1 } else { 0 });
        glUniform1f(LIT.lTraceShadowAll, if G.trace.count > 0 && G.traceShadows { 1 } else { 0 });
        if G.trace.count > 0 {
            glActiveTexture(GL_TEXTURE5);
            glBindTexture(GL_TEXTURE_2D, G.trace.tris);
            glActiveTexture(GL_TEXTURE6);
            glBindTexture(GL_TEXTURE_2D, G.trace.nodes);
            glActiveTexture(GL_TEXTURE8);
            glBindTexture(GL_TEXTURE_2D, G.trace.top);
            glActiveTexture(GL_TEXTURE9);
            glBindTexture(GL_TEXTURE_2D, G.trace.inst);
            glUniform1i(LIT.lBounces, i32(G.traceBounces));
            glUniform1i(LIT.lSamples, i32(G.traceSamples));
            glUniform1f(LIT.lTraceShadows, if G.traceShadows { 1 } else { 0 });
            glUniform1f(LIT.lTraceNear, G.traceNear);
            glUniform1f(LIT.lMapOn, if G.mapUsed { 1 } else { 0 });
        }
        glActiveTexture(GL_TEXTURE0);
        glUniform2f(LIT.lUvScale, sf.uvScale.x, sf.uvScale.y);
        glUniform2f(LIT.lUvOffset, sf.uvOffset.x, sf.uvOffset.y);
        glUniform2f(LIT.lNudge, nx, ny);
        glUniform1f(LIT.lTime, f32(game.ticks()) / 1000);
        let res = viewExtent();
        glUniform2f(LIT.lResolution, res.x, res.y);
        uploadLights();
        if alpha < 0.999 || G.blendNext {
            glEnable(GL_BLEND);
            glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
            glDepthMask(0);
        }
    }
    submit(mesh, if G.pass == PASS_SHADOW { shadowInst } else { LIT.lInst });
    if (alpha < 0.999 || G.blendNext) && G.pass != PASS_SHADOW {
        glDepthMask(1);
        glDisable(GL_BLEND);
    }
    if cutout {
        glEnable(GL_CULL_FACE);
    }
}

/// Upload effect program `slot`'s params from `vals` (in param order; a color takes three),
/// into its shadow depth program when `depth`.
fn fxUniforms(slot: int, vals: []f32, depth: bool) {
    let k = 0;
    let at = 0;
    while k < FXP[slot].count {
        let kind = FXP[slot].kinds[k];
        if at + fxWidth(kind) > vals.len { return; }
        let loc = if depth { FXP[slot].depthLocs[k] } else { FXP[slot].locs[k] };
        if kind == FX_COLOR { glUniform3f(loc, vals[at], vals[at + 1], vals[at + 2]); }
        else if kind == FX_FLOAT { glUniform1f(loc, vals[at]); }
        else { glUniform1i(loc, i32(vals[at])); }
        at += fxWidth(kind);
        k += 1;
    }
}

fn samplerUnits(prog: u32) {
    glUseProgram(prog);
    glUniform1i(uloc(prog, "uShadow"), 0);
    glUniform1i(uloc(prog, "uAlbedo"), 1);
    glUniform1i(uloc(prog, "uGrab"), 3);
    glUniform1i(uloc(prog, "uSkyTex"), 4);
    glUniform1i(uloc(prog, "uTris"), 5);
    glUniform1i(uloc(prog, "uNodes"), 6);
    glUniform1i(uloc(prog, "uTop"), 8);
    glUniform1i(uloc(prog, "uObjects"), 9);
    glUniform1i(uloc(prog, "uPassShadow"), 7);
    glUseProgram(0);
}

/// Find `uLP[i]`, `uLC[i]`, `uLR[i]` in `prog`: the instanced program's when `inst`.
fn lightLocs(prog: u32) {
    let i = 0;
    while i < LIGHTS {
        LIT.lP[i] = uloc(prog, indexed("uLP[", i));
        LIT.lC[i] = uloc(prog, indexed("uLC[", i));
        LIT.lR[i] = uloc(prog, indexed("uLR[", i));
        i += 1;
    }
}

/// `name` + `i` + "]", for a uniform array element.
fn indexed(name: string, i: int): string {
    let t = Text.new(scratch(0));
    t.pushStr(name);
    t.pushInt(i);
    t.pushStr("]");
    return t.str();
}

/// Write the point lights into the lit program.
fn uploadLights() {
    let i = 0;
    while i < LIGHTS {
        glUniform3f(LIT.lP[i], G.pPos[i].x, G.pPos[i].y, G.pPos[i].z);
        glUniform3f(LIT.lC[i], G.pCol[i].x, G.pCol[i].y, G.pCol[i].z);
        glUniform1f(LIT.lR[i], G.pRad[i]);
        i += 1;
    }
}
