/// Outlines for `clip-path` and rounded image corners, as point lists the painter's shape clip takes
/// (`paint.pushShape`), plus the same inside test the shader runs. No GL. A shape is x, y pairs;
/// a point whose x is below `-1e8` (`path.SEP_OPEN`) ends a contour, and every contour repeats its
/// first point at the end (closed).
///
/// ```
/// let buf = mem.alloc::<f32>(2 * 64);
/// let n = clip.rrect(buf, 0.0, 0.0, 120.0, 60.0, 12.0, 12.0, 12.0, 12.0);
/// let hit = clip.contains(buf, n, 5.0, 5.0, false);   // false: the corner is cut
/// ```

module j3.gfx.clip;

use j3.gfx.path.{ isSep, SEP_OPEN };
use j3.math.{ cos, min, PI, sin };

/// Points one `ellipse` makes (without the closing one).
pub const ELLIPSE_PTS: int = 48;

fn put(out: []f32, n: int, x: f32, y: f32): int {
    if 2 * n + 1 >= out.len {
        return n;
    }
    out[2 * n] = x;
    out[2 * n + 1] = y;
    return n + 1;
}

/// One corner arc of radius `r` about `(cx, cy)` from angle `a0` to `a0 + PI/2`.
fn arc(out: []f32, n0: int, cx: f32, cy: f32, r: f32, a0: f32): int {
    let n = n0;
    if r <= 0.0 {
        return put(out, n, cx, cy);
    }
    let seg = int(r / 2.0) + 2;
    if seg > 10 {
        seg = 10;
    }
    for i in 0..seg + 1 {
        let a = a0 + (PI * 0.5) * f32(i) / f32(seg);
        n = put(out, n, cx + cos(a) * r, cy + sin(a) * r);
    }
    return n;
}

/// A rounded rectangle with the radii top-left, top-right, bottom-right, bottom-left. Radii that
/// do not fit shrink together (CSS rule). Returns the point count (closed).
pub fn rrect(out: []f32, x: f32, y: f32, w: f32, h: f32, tl: f32, tr: f32, br: f32, bl: f32): int {
    let f: f32 = 1.0;
    if tl + tr > w { f = min(f, w / (tl + tr)); }
    if bl + br > w { f = min(f, w / (bl + br)); }
    if tl + bl > h { f = min(f, h / (tl + bl)); }
    if tr + br > h { f = min(f, h / (tr + br)); }
    tl = tl * f;
    tr = tr * f;
    br = br * f;
    bl = bl * f;
    let n = 0;
    n = arc(out, n, x + tl, y + tl, tl, PI);
    n = arc(out, n, x + w - tr, y + tr, tr, PI * 1.5);
    n = arc(out, n, x + w - br, y + h - br, br, 0.0);
    n = arc(out, n, x + bl, y + h - bl, bl, PI * 0.5);
    return put(out, n, out[0], out[1]);
}

/// An ellipse centered `(cx, cy)` with radii `rx`, `ry` (closed).
pub fn ellipse(out: []f32, cx: f32, cy: f32, rx: f32, ry: f32): int {
    let n = 0;
    for i in 0..ELLIPSE_PTS {
        let a = 2.0 * PI * f32(i) / f32(ELLIPSE_PTS);
        n = put(out, n, cx + cos(a) * rx, cy + sin(a) * ry);
    }
    return put(out, n, out[0], out[1]);
}

/// A CSS length resolved against `ref`: `unit` 0 is px, 1 is a percentage of `ref`.
pub fn resolve(v: f32, unit: int, ref: f32): f32 {
    if unit == 1 {
        return v * ref / 100.0;
    }
    return v;
}

/// The inside test the shader runs: winding number (`evenOdd` false) or crossing parity. Contours
/// are separated by `SEP` points; edges touching a separator are skipped.
pub fn contains(pts: []f32, n: int, px: f32, py: f32, evenOdd: bool): bool {
    let wn = 0;
    for i in 0..n - 1 {
        let ax = pts[2 * i];
        let bx = pts[2 * i + 2];
        if isSep(ax) || isSep(bx) {
            continue;
        }
        let ay = pts[2 * i + 1];
        let by = pts[2 * i + 3];
        let cross = (bx - ax) * (py - ay) - (by - ay) * (px - ax);
        if ay <= py {
            if by > py && cross > 0.0 {
                wn += 1;
            }
        } else if by <= py && cross < 0.0 {
            wn -= 1;
        }
    }
    if evenOdd {
        return wn % 2 != 0;
    }
    return wn != 0;
}

/// Append a separator after the contour that ends at point `n - 1`; returns the new count.
pub fn endContour(out: []f32, n: int): int {
    return put(out, n, SEP_OPEN, 0.0);
}
