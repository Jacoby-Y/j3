// Part of j3.gfx (camera and shadow passes).

module j3.gfx;

/// Upload a mat4 uniform.
fn uMat(loc: i32, m: Mat4) {
    glUniformMatrix4fv(loc, 1, 0, &m.m[0] as ptr);
}

/// Expand an AABB by transforming point p through m.
fn grow(m: Mat4, p: Vec3, minx: &f32, maxx: &f32, miny: &f32, maxy: &f32, minz: &f32, maxz: &f32) {
    let q = m.transformPoint(p);
    if q.x < *minx {
        *minx = q.x;
    }
    if q.x > *maxx {
        *maxx = q.x;
    }
    if q.y < *miny {
        *miny = q.y;
    }
    if q.y > *maxy {
        *maxy = q.y;
    }
    if q.z < *minz {
        *minz = q.z;
    }
    if q.z > *maxz {
        *maxz = q.z;
    }
}

/// Orthographic light matrix fitting the world AABB around sun.
fn fitLight(sun: Vec3, lo: Vec3, hi: Vec3): Mat4 {
    let mid = Vec3.xyz((lo.x + hi.x) * 0.5, (lo.y + hi.y) * 0.5, (lo.z + hi.z) * 0.5);
    let rad = (hi - lo).length() * 0.5 + 2;
    if rad < 1 {
        rad = 1;
    }
    let dir = sun.normalize();
    let eye = mid + dir * (rad + 4);
    let up = Vec3.up();
    if abs(dir.dot(up)) > 0.9 {
        up = Vec3.xyz(1, 0, 0);
    }
    let view = Mat4.lookAt(eye, mid, up);
    let first = view.transformPoint(lo);
    let minx = first.x;
    let maxx = first.x;
    let miny = first.y;
    let maxy = first.y;
    let minz = first.z;
    let maxz = first.z;
    grow(view, Vec3.xyz(hi.x, lo.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, hi.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, hi.y, lo.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, lo.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, lo.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(lo.x, hi.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    grow(view, Vec3.xyz(hi.x, hi.y, hi.z), &minx, &maxx, &miny, &maxy, &minz, &maxz);
    let pad: f32 = 2;
    return Mat4.ortho(minx - pad, maxx + pad, miny - pad, maxy + pad, 0 - maxz - pad, 0 - minz + pad).mul(view);
}

/// Begin the shadow depth pass for the given sun and world bounds.
pub fn shadowPass(sun: Vec3, boundsMin: Vec3, boundsMax: Vec3) {
    ensure();
    G.sun = sun.normalize();
    G.light = fitLight(G.sun, boundsMin, boundsMax);
    G.pass = PASS_SHADOW;
    G.mapUsed = false;
    SHADOWS += 1;
    game.profZone(game.ZONE_SHADOW);
    // Nothing translucent yet: all light passes, at the far depth.
    glBindFramebuffer(GL_FRAMEBUFFER, G.passFbo);
    glViewport(0, 0, SHADOW, SHADOW);
    glClearColor(1, 1, 1, 1);
    glClear(GL_COLOR_BUFFER_BIT);
    glBindFramebuffer(GL_FRAMEBUFFER, G.shadowFbo);
    glEnable(GL_POLYGON_OFFSET_FILL);
    glPolygonOffset(4, 4);
    glCullFace(GL_BACK);
    glClear(GL_DEPTH_BUFFER_BIT);
    glUseProgram(G.depth);
    uMat(G.dLight, G.light);
}

/// Begin the lit camera pass from an orbit camera.
pub fn cameraPass(cam: Orbit, sun: Vec3, sky: Vec3, sunColor: Vec3) {
    beginCamera(cam.eye(), cam.view(), sun, sky, sunColor, fov());
    if G.orthoHalf > 0 {
        let sz = viewExtent();
        let aspect = sz.x / sz.y;
        let h = G.orthoHalf;
        // Nothing clips at the eye, so objects between it and the target stay visible.
        G.proj = Mat4.ortho(0 - h * aspect, h * aspect, 0 - h, h, 0 - G.clipFar, G.clipFar);
        uMat(LIT.lProj, G.proj);
    }
}

/// Begin the lit camera pass from a look camera.
pub fn cameraPassLook(cam: Look, sun: Vec3, sky: Vec3, sunColor: Vec3) {
    beginCamera(cam.eye, cam.view(), sun, sky, sunColor, fov());
}

/// Begin the lit camera pass with a game camera's vertical FOV in degrees.
pub fn cameraPassLookFov(cam: Look, sun: Vec3, sky: Vec3, sunColor: Vec3, degrees: f32) {
    let angle = clamp(degrees, 20, 120) * PI / 180;
    beginCamera(cam.eye, cam.view(), sun, sky, sunColor, angle);
}

/// Shared camera-pass setup: viewport, clear, uniforms, and shadow bind.
fn beginCamera(eye: Vec3, view: Mat4, sun: Vec3, sky: Vec3, sunColor: Vec3, angle: f32) {
    ensure();
    G.sun = sun.normalize();
    G.sky = sky;
    G.sunColor = sunColor;
    G.eye = eye;
    G.view = view;
    let at = viewOrigin();
    let sz = viewExtent();
    let w = i32(sz.x);
    let h = i32(sz.y);
    if h < 1 {
        h = 1;
    }
    let aspect = sz.x / sz.y;
    if aspect < 0.1 {
        aspect = 0.1;
    }
    let near = G.clipNear;
    if near < 0.01 {
        near = f32(15) / f32(100);
    }
    G.proj = Mat4.perspective(angle, aspect, near, G.clipFar);
    G.pass = PASS_CAMERA;
    game.profZone(game.ZONE_CAMERA);
    G.grabbed = false;
    glBindFramebuffer(GL_FRAMEBUFFER, G.outputFbo);
    let r = glView(at.x, at.y, sz.x, sz.y);
    glViewport(i32(r.x), i32(r.y), i32(r.w), i32(r.h));
    glDisable(GL_POLYGON_OFFSET_FILL);
    glCullFace(GL_BACK);
    glClearColor(sky.x, sky.y, sky.z, 1);
    // Clear only the view rect, so a second view (a picture-in-picture) leaves the first alone.
    glEnable(GL_SCISSOR_TEST);
    glScissor(i32(r.x), i32(r.y), i32(r.w), i32(r.h));
    glClear(GL_COLOR_BUFFER_BIT + GL_DEPTH_BUFFER_BIT);
    glDisable(GL_SCISSOR_TEST);
    useLit(LIT_PLAIN);
    uMat(LIT.lProj, G.proj);
    uMat(LIT.lView, G.view);
    uMat(LIT.lLight, G.light);
    glUniform3f(LIT.lSun, G.sun.x, G.sun.y, G.sun.z);
    glUniform3f(LIT.lSunColor, sunColor.x, sunColor.y, sunColor.z);
    glUniform3f(LIT.lSky, sky.x, sky.y, sky.z);
    glUniform3f(LIT.lEye, G.eye.x, G.eye.y, G.eye.z);
    glUniform1f(LIT.lFog0, G.fogStart);
    glUniform1f(LIT.lFog1, G.fogEnd);
    G.albedo = G.white;
    bindAlbedo();
    glActiveTexture(GL_TEXTURE0);
    glBindTexture(GL_TEXTURE_2D, G.shadowTex);
    glUniform1i(LIT.lShadow, 0);
}
