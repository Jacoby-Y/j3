/// Text effects on top of `j3.gfx.paint`: drop shadows and glows with a blur, outlines, and the
/// gradient line for gradient fills. Each effect draws extra copies of the glyphs (the glyph sheet
/// batches them), so a blur costs up to about 70 copies of the text: use it on headings and
/// labels, not on pages of text. Needs GL like all of paint; main thread only.
///
/// `j3.ui.dom` calls these for `text-shadow`, `-webkit-text-stroke`, and `background-clip: text`.
/// Draw order for one string: `shadowList` (or `shadow`), then `outline`, then the fill.
///
/// ```
/// textfx.shadow(font, pos, "Glow", Vec2 { x: 0, y: 0 }, 8, rgba(120, 200, 255, 255), false);
/// textfx.outline(font, pos, "Glow", 2, rgb(0, 0, 0), false);
/// paint.text(font, pos, "Glow", rgb(255, 255, 255));
/// ```

module j3.gfx.textfx;

use j3.game.{ Color, Font };
use j3.gfx.paint;
use j3.math.{ abs, ceil, clamp, cos, exp, sin, Vec2 };

const TAU: f32 = 6.2831853;

/// Two points a gradient runs between.
pub struct Line {
    a: Vec2;
    b: Vec2;
}

/// The CSS `linear-gradient(<angle>)` line across a `w` by `h` box (0 degrees up, 90 right, 180
/// down): where it is 0 and where it is 1, in the box's own pixels.
pub fn gradientLine(w: f32, h: f32, deg: f32): Line {
    let t = deg * 0.017453292;
    let dx = sin(t);
    let dy = -cos(t);
    let half = (abs(w * dx) + abs(h * dy)) * 0.5;
    return Line {
        a: Vec2 { x: w * 0.5 - dx * half, y: h * 0.5 - dy * half },
        b: Vec2 { x: w * 0.5 + dx * half, y: h * 0.5 + dy * half },
    };
}

fn once(font: Font, pos: Vec2, msg: string, color: Color, bold: bool) {
    if bold {
        paint.textBold(font, pos, msg, color);
    } else {
        paint.text(font, pos, msg, color);
    }
}

/// `n` copies on a circle of radius `r` around `pos`.
fn ring(font: Font, pos: Vec2, msg: string, r: f32, n: int, phase: f32, color: Color, bold: bool) {
    for k in 0..n {
        let a = phase + TAU * f32(k) / f32(n);
        once(font, Vec2 { x: pos.x + cos(a) * r, y: pos.y + sin(a) * r }, msg, color, bold);
    }
}

fn tapCount(r: f32): int {
    return int(clamp(TAU * r / 2.0, 6.0, 24.0));
}

fn withAlpha(c: Color, a: f32): Color {
    return Color { r: c.r, g: c.g, b: c.b, a: u8(clamp(a, 0.0, 255.0) + 0.5) };
}

/// A text shadow like CSS `text-shadow`: `msg` at `pos + off` in `color`, blurred by `blur` (the CSS
/// blur radius, Gaussian sigma `blur / 2`) as rings of faint copies. Draw it before the text. A
/// bright color with zero offset is a glow.
pub fn shadow(font: Font, pos: Vec2, msg: string, off: Vec2, blur: f32, color: Color, bold: bool) {
    let at = Vec2 { x: pos.x + off.x, y: pos.y + off.y };
    if blur < 0.5 {
        once(font, at, msg, color, bold);
        return;
    }
    let sigma = blur * 0.5;
    let rings = int(clamp(ceil(blur / 3.0), 1.0, 4.0));
    // Gaussian weights of the taps: the center and `rings` rings out to `blur`
    let total: f32 = 1.0;
    for i in 1..(rings + 1) {
        let r = blur * f32(i) / f32(rings);
        total += f32(tapCount(r)) * exp(-r * r / (2.0 * sigma * sigma));
    }
    let a = f32(color.a);
    once(font, at, msg, withAlpha(color, a * 1.6 / total), bold);
    for i in 1..(rings + 1) {
        let r2 = blur * f32(i) / f32(rings);
        let w = exp(-r2 * r2 / (2.0 * sigma * sigma));
        ring(font, at, msg, r2, tapCount(r2), f32(i) * 0.5, withAlpha(color, a * 1.6 * w / total), bold);
    }
}

/// The shadows of a `V_SHADOW` list (`a[o]` is the count, then `[inset, x, y, blur, spread, r, g, b, a]`
/// each; the first is on top, so it is drawn last). Insets are skipped.
pub fn shadowList(font: Font, pos: Vec2, msg: string, bold: bool, a: []f32, o: int) {
    let i = int(a[o]) - 1;
    while i >= 0 {
        let q = o + 1 + i * 9;
        if a[q] < 0.5 {
            let c = Color { r: u8(a[q + 5]), g: u8(a[q + 6]), b: u8(a[q + 7]), a: u8(a[q + 8]) };
            shadow(font, pos, msg, Vec2 { x: a[q + 1], y: a[q + 2] }, a[q + 3], c, bold);
        }
        i -= 1;
    }
}

/// An outline `width` px wide around the glyphs (half of it outside the glyph edge, like
/// `paint-order: stroke fill`): copies of `msg` all around it in `color`. Draw the fill over it. The
/// glyph interior is not erased, so it cannot make hollow text.
pub fn outline(font: Font, pos: Vec2, msg: string, width: f32, color: Color, bold: bool) {
    if width <= 0.0 {
        return;
    }
    let r = width * 0.5;
    if r >= 2.0 {
        ring(font, pos, msg, r * 0.5, tapCount(r * 0.5), 0.3, color, bold);
    }
    ring(font, pos, msg, r, tapCount(r), 0.0, color, bold);
}
