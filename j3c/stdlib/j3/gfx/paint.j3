/// Batched 2D painter: immediate canvas-style calls (no paths) that collect into one instanced
/// draw, so thousands of rects, rounded boxes, circles, lines, glyphs, and images cost a few draw
/// calls. Shapes are antialiased signed-distance quads (about 1 px of coverage).
///
/// GL only: needs `app.useGl()`; the first call panics otherwise. Main thread
/// only (`j3c doc threads`). Coordinates are logical pixels, origin top left, like `j3.game`
/// (they respect `platform.ui_scale`). Colors are `j3.game.Color`. Blending is straight alpha.
///
/// Draws queue until the texture, clip, or view changes, or `present`; `j3.gfx` draws flush it
/// first. Call `flush()` only before raw GL. `j3.game.drawRect` and `drawText` share the same
/// batch, so mixing them with paint keeps their order.
///
/// Text effects: `textGradient` here, shadows and outlines in `j3.gfx.textfx`.
///
/// Untested in a real game (checked by goldens and benchmarks only): nested clips with views, text
/// under `pushScale`, non-ASCII text, and mixing with `j3.gfx` 3D passes beyond the fps-shooter HUD.
/// Backdrop blur has headless integration coverage only; real-window behavior is not yet verified.
///
/// ```
/// paint.roundRect(Vec2 { x: 10, y: 10 }, Vec2 { x: 200, y: 60 }, 10, rgb(49, 50, 68));
/// paint.text(font, Vec2 { x: 20, y: 24 }, "gold 120", rgb(255, 255, 255));
/// ```

module j3.gfx.paint;

use j3.game;
use j3.gfx.post;
use j3.game.{ Color, Font, Texture };
use j3.gfx.path.MAXPT;
use j3.math.{ abs, cos, max, min, sin, Vec2 };
use j3.sys.{ panic, write };

/// Per-corner radii for `roundRectEx`, in pixels.
pub struct Corners {
    /// Top left.
    tl: f32;
    /// Top right.
    tr: f32;
    /// Bottom right.
    br: f32;
    /// Bottom left.
    bl: f32;
}

/// A content group's canonical filter pipeline. Amounts 0..1 unless documented; RGB filters
/// use straight colors, while blur and bloom preserve premultiplied transparent edges.
pub struct Effects {
    blur: f32 = 0;
    bloom: f32 = 0;
    bloomThreshold: f32 = 0.7;
    grain: f32 = 0;
    scanlines: f32 = 0;
    crt: f32 = 0;
    brightness: f32 = 1;
    contrast: f32 = 1;
    saturation: f32 = 1;
    grayscale: f32 = 0;
    sepia: f32 = 0;
    invert: f32 = 0;
    hue: f32 = 0;
    blend: int = 0;
    shader: int = 0;
    time: f32 = 0;
    perspective: f32 = 0;
    rotateX: f32 = 0;
    rotateY: f32 = 0;
}

/// One color stop of a gradient: `at` runs 0 to 1 along the gradient line, ascending.
pub struct Stop {
    at: f32;
    color: Color;
}

/// Current transform and alpha, and their stacks. Zero until `ensure`.
struct State {
    ready: bool;
    /// Scale and translation: `device = p * s + t`.
    s: f32;
    tx: f32;
    ty: f32;
    /// Rotation applied after `s`/`tx`/`ty` (see `game.p2Affine`): `x' = ra x + rc y + rx`, `y' = rb x + rd y + ry`.
    rot: bool;
    ra: f32;
    rb: f32;
    rc: f32;
    rd: f32;
    rx: f32;
    ry: f32;
    /// Alpha multiplier.
    a: f32;
    tn: int;
    an: int;
    cn: int;
    /// Clip active, and its rect in view-local pixels.
    clipOn: bool;
    cx0: f32;
    cy0: f32;
    cx1: f32;
    cy1: f32;
    /// Next gradient ramp row to (over)write.
    gnext: int;
}

#[singleton]
let P: State;
/// Saved transforms: s, tx, ty each.
#[singleton]
let TSTACK: [96]f32;
/// Saved rotations: on, ra, rb, rc, rd, rx, ry each.
#[singleton]
let RSTACK: [224]f32;
#[singleton]
let ASTACK: [32]f32;
/// Saved clips: on, x0, y0, x1, y1 each.
#[singleton]
let CSTACK: [144]f32;

/// Hashes of the stop lists baked into the ramp rows (0: row empty).
#[singleton]
let GKEY: [64]int;
/// One ramp row while it is baked.
#[singleton]
let RAMPBUF: [1024]u8;

fn ensure() {
    if !P.ready {
        P.ready = true;
        P.s = 1;
        P.a = 1;
    }
}

/// `c` with its alpha multiplied by the current alpha.
fn tint(c: Color): Color {
    if P.a >= 1 {
        return c;
    }
    return Color { r: c.r, g: c.g, b: c.b, a: u8(f32(c.a) * P.a + 0.5) };
}

fn push(kind: int, x: f32, y: f32, w: f32, h: f32, c1: Color, c2: Color, p0: f32, p1: f32, p2: f32, p3: f32, bw: f32) {
    ensure();
    game.p2Push(kind, x * P.s + P.tx, y * P.s + P.ty, w * P.s, h * P.s, 0, 0, 0, 0, tint(c1), tint(c2), p0, p1, p2, p3, bw, 0);
}

/// Fill a rect with no antialiasing.
pub fn rect(pos: Vec2, size: Vec2, color: Color) {
    push(0, pos.x, pos.y, size.x, size.y, color, color, 0, 0, 0, 0, 0);
}

/// Fill a rect with all four corners rounded by `radius`.
pub fn roundRect(pos: Vec2, size: Vec2, radius: f32, color: Color) {
    let r = radius * P.s;
    push(2, pos.x, pos.y, size.x, size.y, color, color, r, r, r, r, 0);
}

/// Rounded rect with per-corner radii and an inside border of width `bw` in `border`. Radii
/// larger than half the shorter side shrink to fit; a border wider than half the size covers it.
pub fn roundRectEx(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, border: Color) {
    ensure();
    push(2, pos.x, pos.y, size.x, size.y, fill, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// Blur what has already been painted behind this rounded box, before drawing its own fill.
/// `radius` is Gaussian sigma in logical pixels, clamped to 64; <= 0 is a no-op.
/// Uses two reusable window-sized RGBA8 targets and two 25-tap Gaussian passes (GL only).
/// The framebuffer edge is clamped; clips, masks, affine transforms and alpha apply to the result.
pub fn backdropBlur(pos: Vec2, size: Vec2, c: Corners, radius: f32) {
    if radius <= 0 || size.x <= 0 || size.y <= 0 { return; }
    ensure();
    if radius > 64 { radius = 64; }
    let s = P.s;
    if s < 0 { s = 0 - s; }
    game.p2BackdropBlur(pos.x * P.s + P.tx, pos.y * P.s + P.ty, size.x * P.s, size.y * P.s,
        c.tl * s, c.tr * s, c.br * s, c.bl * s, radius * s, P.a);
}

/// Filled circle.
pub fn circle(center: Vec2, r: f32, color: Color) {
    push(3, center.x - r, center.y - r, r * 2, r * 2, color, color, r * P.s, 0, 0, 0, 0);
}

/// Circle outline of `width`, inside radius `r`.
pub fn ring(center: Vec2, r: f32, width: f32, color: Color) {
    push(4, center.x - r, center.y - r, r * 2, r * 2, color, color, r * P.s, 0, 0, 0, width * P.s);
}

/// Line of `width` from `a` to `b` with round caps.
pub fn line(a: Vec2, b: Vec2, width: f32, color: Color) {
    ensure();
    let h = width * 0.5;
    let x0 = a.x; if b.x < x0 { x0 = b.x; }
    let y0 = a.y; if b.y < y0 { y0 = b.y; }
    let x1 = a.x; if b.x > x1 { x1 = b.x; }
    let y1 = a.y; if b.y > y1 { y1 = b.y; }
    game.p2Push(5, (x0 - h) * P.s + P.tx, (y0 - h) * P.s + P.ty, (x1 - x0 + width) * P.s, (y1 - y0 + width) * P.s,
        0, 0, 0, 0, tint(color), tint(color),
        a.x * P.s + P.tx, a.y * P.s + P.ty, b.x * P.s + P.tx, b.y * P.s + P.ty, h * P.s, 0);
}

/// Draw `msg` with its top left at `pos`. ASCII shares one glyph sheet per font, so a screen of
/// text is a handful of draws; other text goes through `j3.game`'s cached rasters. The glyph
/// size follows `pushScale`.
pub fn text(font: Font, pos: Vec2, msg: string, color: Color) {
    ensure();
    game.p2Text(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, tint(color), P.s);
}

/// `text` with emboldened glyphs.
pub fn textBold(font: Font, pos: Vec2, msg: string, color: Color) {
    ensure();
    game.p2TextBold(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, tint(color), P.s);
}

/// `text` filled from gradient `row` (see `gradient`) along the line `from` to `to`, in the same
/// coordinates as `pos`. The gradient is per pixel, so it runs across glyphs and lines; `alpha`
/// scales it. Needs the GL path (like all of paint).
pub fn textGradient(font: Font, pos: Vec2, msg: string, row: int, from: Vec2, to: Vec2, alpha: f32, bold: bool) {
    ensure();
    let a = tint(Color { r: 255, g: 255, b: 255, a: u8(alpha * 255.0 + 0.5) });
    game.p2TextGradient(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, a, P.s, bold, row,
        Vec2 { x: from.x * P.s + P.tx, y: from.y * P.s + P.ty }, Vec2 { x: to.x * P.s + P.tx, y: to.y * P.s + P.ty });
}

/// Draw the whole texture into a rect.
pub fn image(tex: Texture, pos: Vec2, size: Vec2) {
    imageSrc(tex, Vec2 { x: 0, y: 0 }, Vec2 { x: f32(tex.w), y: f32(tex.h) }, pos, size, Color { r: 255, g: 255, b: 255, a: 255 });
}

/// Draw `srcSize` pixels of `tex` from `src` into a rect, multiplied by `tint`.
pub fn imageSrc(tex: Texture, src: Vec2, srcSize: Vec2, pos: Vec2, size: Vec2, color: Color) {
    ensure();
    if tex.raw == 0 || tex.w < 1 || tex.h < 1 {
        return;
    }
    let c = tint(color);
    game.p2Push(1, pos.x * P.s + P.tx, pos.y * P.s + P.ty, size.x * P.s, size.y * P.s,
        src.x / f32(tex.w), src.y / f32(tex.h), srcSize.x / f32(tex.w), srcSize.y / f32(tex.h),
        c, c, 0, 0, 0, 0, 0, u32(tex.raw as int));
}

/// Draw everything queued now. Only needed before raw GL.
pub fn flush() {
    game.p2Flush();
}
