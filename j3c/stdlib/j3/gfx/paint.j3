/// Batched 2D painter: immediate canvas-style calls (no paths) that collect into one instanced
/// draw, so thousands of rects, rounded boxes, circles, lines, glyphs, and images cost a few draw
/// calls. Shapes are antialiased signed-distance quads (about 1 px of coverage).
///
/// GL only: needs `app.useGl()` and `use lib "GL"`; the first call panics otherwise. Main thread
/// only (`j3c doc threads`). Coordinates are logical pixels, origin top left, like `j3.game`
/// (they respect `platform.ui_scale`). Colors are `j3.game.Color`. Blending is straight alpha.
///
/// Draws queue until the texture, clip, or view changes, or `present`; `j3.gfx` draws flush it
/// first. Call `flush()` only before raw GL. `j3.game.drawRect` and `drawText` share the same
/// batch, so mixing them with paint keeps their order.
///
/// Text effects: `textGradient` here, shadows and outlines in `j3.gfx.textfx`.
///
/// Untested in a real game (checked by goldens and benchmarks only): nested clips with views, text
/// under `pushScale`, non-ASCII text, and mixing with `j3.gfx` 3D passes beyond the fps-shooter HUD.
/// Backdrop blur has headless integration coverage only; real-window behavior is not yet verified.
///
/// ```
/// paint.roundRect(Vec2 { x: 10, y: 10 }, Vec2 { x: 200, y: 60 }, 10, rgb(49, 50, 68));
/// paint.text(font, Vec2 { x: 20, y: 24 }, "gold 120", rgb(255, 255, 255));
/// ```

module j3.gfx.paint;

use j3.game;
use j3.gfx.post;
use j3.game.{ Color, Font, Texture };
use j3.gfx.path.MAXPT;
use j3.math.{ abs, cos, max, min, sin, Vec2 };
use j3.sys.{ panic, write };

/// Per-corner radii for `roundRectEx`, in pixels.
pub struct Corners {
    /// Top left.
    tl: f32;
    /// Top right.
    tr: f32;
    /// Bottom right.
    br: f32;
    /// Bottom left.
    bl: f32;
}

/// A content group's canonical filter pipeline. Amounts 0..1 unless documented; RGB filters
/// use straight colors, while blur and bloom preserve premultiplied transparent edges.
pub struct Effects {
    blur: f32 = 0;
    bloom: f32 = 0;
    bloomThreshold: f32 = 0.7;
    grain: f32 = 0;
    scanlines: f32 = 0;
    crt: f32 = 0;
    brightness: f32 = 1;
    contrast: f32 = 1;
    saturation: f32 = 1;
    grayscale: f32 = 0;
    sepia: f32 = 0;
    invert: f32 = 0;
    hue: f32 = 0;
    blend: int = 0;
    shader: int = 0;
    time: f32 = 0;
    perspective: f32 = 0;
    rotateX: f32 = 0;
    rotateY: f32 = 0;
}
#[singleton]
let CAPSTATE: [16]State;
#[singleton]
let CAPSHAPE: [131072]f32;
#[singleton]
let CAPN: [32]int;
#[singleton]
let CAPRULE: [32]int;
#[singleton]
let CAPMASK: [112]f32;
#[singleton]
let CAPDEPTH: int;
#[singleton]
let CAPCKB: [16]int;

fn captureState(reset: bool) {
    ensure(); game.p2Flush();
    if CAPDEPTH >= 16 { panic("paint capture nesting exceeds sixteen"); }
    let n = CAPDEPTH; CAPSTATE[n] = P; CAPDEPTH += 1;
    for slot in 0..2 {
        CAPN[n * 2 + slot] = SHN[slot]; CAPRULE[n * 2 + slot] = SHR[slot];
        for i in 0..SHN[slot] * 2 { CAPSHAPE[n * 8192 + slot * (2 * MAXPT) + i] = SHP[slot * (2 * MAXPT) + i]; }
        SHN[slot] = 0;
    }
    for i in 0..7 { CAPMASK[n * 7 + i] = MCUR[i]; MCUR[i] = 0; }
    P.a = 1; P.clipOn = false;
    CAPCKB[n] = CKI[1];
    if CKI[0] > CKI[1] { CKI[1] = CKI[0]; applyClips(true); }
    if reset { P.s = 1; P.tx = 0; P.ty = 0; P.rot = false; }
    game.p2Clip(false, 0, 0, 0, 0); applyShape(0); applyShape(1); applyMask();
    if reset { applyRot(); }
}
fn restoreCapture() {
    if CAPDEPTH <= 0 { panic("unbalanced paint capture"); }
    CAPDEPTH -= 1; let n = CAPDEPTH; P = CAPSTATE[n];
    let wasClips = CKI[0] > CKI[1];
    CKI[1] = CAPCKB[n];
    for slot in 0..2 {
        SHN[slot] = CAPN[n * 2 + slot]; SHR[slot] = CAPRULE[n * 2 + slot];
        for i in 0..SHN[slot] * 2 { SHP[slot * (2 * MAXPT) + i] = CAPSHAPE[n * 8192 + slot * (2 * MAXPT) + i]; }
        applyShape(slot);
    }
    for i in 0..7 { MCUR[i] = CAPMASK[n * 7 + i]; }
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1); applyMask(); applyRot();
    if wasClips || CKI[0] > CKI[1] { applyClips(true); }
}
fn screenBounds(pos: Vec2, size: Vec2, box: []f32) {
    box[0] = 1000000000; box[1] = 1000000000;
    let x1: f32 = -1000000000; let y1: f32 = -1000000000;
    for i in 0..4 {
        let x = pos.x + (if i % 2 == 1 { size.x } else { 0.0 });
        let y = pos.y + (if i >= 2 { size.y } else { 0.0 });
        let p = game.p2ScreenPoint(Vec2 { x: x * P.s + P.tx, y: y * P.s + P.ty });
        if p.x < box[0] { box[0] = p.x; } if p.x > x1 { x1 = p.x; }
        if p.y < box[1] { box[1] = p.y; } if p.y > y1 { y1 = p.y; }
    }
    box[2] = x1 - box[0]; box[3] = y1 - box[1];
}
/// Capture a transparent content group. Eight nested groups; clip, mask and alpha apply once
/// when ending the group. Own drawing and child groups remain ordered within it.
pub fn beginLayer() { post.beginLayer(); captureState(false); }
/// Process captured content, then composite it. Perspective rotates the bounded plane in degrees;
/// distance is logical px (0 is orthographic). Content outside that box is cropped for 3D rotation.
pub fn endLayer(pos: Vec2, size: Vec2, fx: Effects) {
    ensure();
    let radius = fx.blur; if radius < 0 { radius = 0; } if radius > 64 { radius = 64; }
    let scale = P.s; if scale < 0 { scale = 0 - scale; }
    let f: [19]f32 = [radius * scale * game.paintScale(), fx.bloom, fx.bloomThreshold, fx.grain, fx.scanlines, fx.crt,
        fx.brightness, fx.contrast, fx.saturation, fx.grayscale, fx.sepia, fx.invert, fx.hue, f32(fx.blend), f32(fx.shader), fx.time,
        fx.perspective * scale * game.paintScale(), fx.rotateX, fx.rotateY];
    let box: [4]f32 = [0, 0, 0, 0];
    screenBounds(pos, size, []f32 { ptr: &box[0], len: 4 });
    let tex = post.endLayer([]f32 { ptr: &f[0], len: 19 }, []f32 { ptr: &box[0], len: 4 });
    restoreCapture(); post.composite(tex, P.a);
}
/// Reusable render texture handle (1..8192 px per side). All handles are context-owned and
/// automatically destroyed at shutdown; explicit destruction is available for early release.
pub fn target(width: int, height: int): int { return post.target(width, height); }
pub fn beginTarget(handle: int) { captureState(true); post.beginTarget(handle); }
pub fn endTarget() { post.endTarget(); restoreCapture(); }
/// Borrowed GL texture. FBO pixels are vertically flipped for ordinary `image`; use
/// `projectTexture` (including zero rotations) to display it. Invalid after target destruction.
pub fn targetTexture(handle: int): Texture { return post.targetTexture(handle); }
pub fn destroyTarget(handle: int) { post.destroyTarget(handle); }
/// GLSL330 source defines vec4 effect(vec2 uv, vec4 color). color is straight RGBA;
/// uniforms: sampler2D uTex (premultiplied), vec2 uResolution, float uTime. Returns 0 with
/// the GL compiler/linker diagnostic on failure. Existing shaders remain valid.
pub fn shader(source: string): int { return post.shader(source); }
pub fn destroyShader(id: int) { post.destroyShader(id); }
/// Draw a target texture as a perspective-correct UI plane, with rotations in degrees.
/// Distance 0 is orthographic; positive distance is logical px. Clip/mask/alpha apply once.
/// Supports translation and positive scale; capture 2D rotated content in a layer before projection.
pub fn projectTexture(tex: Texture, pos: Vec2, size: Vec2, rotateX: f32, rotateY: f32, perspective: f32) {
    ensure();
    if P.s <= 0 || (P.rot && (P.rb != 0 || P.rc != 0 || P.ra <= 0 || P.rd <= 0)) { panic("projectTexture supports translation and positive scale; use a layer for 2D rotation"); }
    let box: [4]f32 = [0, 0, 0, 0];
    screenBounds(pos, size, []f32 { ptr: &box[0], len: 4 });
    let out = post.projectTexture(tex, []f32 { ptr: &box[0], len: 4 }, rotateX, rotateY, perspective * P.s * game.paintScale());
    post.composite(out, P.a);
}

/// One color stop of a gradient: `at` runs 0 to 1 along the gradient line, ascending.
pub struct Stop {
    at: f32;
    color: Color;
}

/// Current transform and alpha, and their stacks. Zero until `ensure`.
struct State {
    ready: bool;
    /// Scale and translation: `device = p * s + t`.
    s: f32;
    tx: f32;
    ty: f32;
    /// Rotation applied after `s`/`tx`/`ty` (see `game.p2Affine`): `x' = ra x + rc y + rx`, `y' = rb x + rd y + ry`.
    rot: bool;
    ra: f32;
    rb: f32;
    rc: f32;
    rd: f32;
    rx: f32;
    ry: f32;
    /// Alpha multiplier.
    a: f32;
    tn: int;
    an: int;
    cn: int;
    /// Clip active, and its rect in view-local pixels.
    clipOn: bool;
    cx0: f32;
    cy0: f32;
    cx1: f32;
    cy1: f32;
    /// Next gradient ramp row to (over)write.
    gnext: int;
}

#[singleton]
let P: State;
/// Saved transforms: s, tx, ty each.
#[singleton]
let TSTACK: [96]f32;
/// Saved rotations: on, ra, rb, rc, rd, rx, ry each.
#[singleton]
let RSTACK: [224]f32;
#[singleton]
let ASTACK: [32]f32;
/// Saved clips: on, x0, y0, x1, y1 each.
#[singleton]
let CSTACK: [144]f32;

/// Hashes of the stop lists baked into the ramp rows (0: row empty).
#[singleton]
let GKEY: [64]int;
/// One ramp row while it is baked.
#[singleton]
let RAMPBUF: [1024]u8;

fn ensure() {
    if !P.ready {
        P.ready = true;
        P.s = 1;
        P.a = 1;
    }
}

/// `c` with its alpha multiplied by the current alpha.
fn tint(c: Color): Color {
    if P.a >= 1 {
        return c;
    }
    return Color { r: c.r, g: c.g, b: c.b, a: u8(f32(c.a) * P.a + 0.5) };
}

fn push(kind: int, x: f32, y: f32, w: f32, h: f32, c1: Color, c2: Color, p0: f32, p1: f32, p2: f32, p3: f32, bw: f32) {
    ensure();
    game.p2Push(kind, x * P.s + P.tx, y * P.s + P.ty, w * P.s, h * P.s, 0, 0, 0, 0, tint(c1), tint(c2), p0, p1, p2, p3, bw, 0);
}

/// Fill a rect with no antialiasing.
pub fn rect(pos: Vec2, size: Vec2, color: Color) {
    push(0, pos.x, pos.y, size.x, size.y, color, color, 0, 0, 0, 0, 0);
}

/// Fill a rect with all four corners rounded by `radius`.
pub fn roundRect(pos: Vec2, size: Vec2, radius: f32, color: Color) {
    let r = radius * P.s;
    push(2, pos.x, pos.y, size.x, size.y, color, color, r, r, r, r, 0);
}

/// Rounded rect with per-corner radii and an inside border of width `bw` in `border`. Radii
/// larger than half the shorter side shrink to fit; a border wider than half the size covers it.
pub fn roundRectEx(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, border: Color) {
    ensure();
    push(2, pos.x, pos.y, size.x, size.y, fill, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// Blur what has already been painted behind this rounded box, before drawing its own fill.
/// `radius` is Gaussian sigma in logical pixels, clamped to 64; <= 0 is a no-op.
/// Uses two reusable window-sized RGBA8 targets and two 25-tap Gaussian passes (GL only).
/// The framebuffer edge is clamped; clips, masks, affine transforms and alpha apply to the result.
pub fn backdropBlur(pos: Vec2, size: Vec2, c: Corners, radius: f32) {
    if radius <= 0 || size.x <= 0 || size.y <= 0 { return; }
    ensure();
    if radius > 64 { radius = 64; }
    let s = P.s;
    if s < 0 { s = 0 - s; }
    game.p2BackdropBlur(pos.x * P.s + P.tx, pos.y * P.s + P.ty, size.x * P.s, size.y * P.s,
        c.tl * s, c.tr * s, c.br * s, c.bl * s, radius * s, P.a);
}

/// Filled circle.
pub fn circle(center: Vec2, r: f32, color: Color) {
    push(3, center.x - r, center.y - r, r * 2, r * 2, color, color, r * P.s, 0, 0, 0, 0);
}

/// Circle outline of `width`, inside radius `r`.
pub fn ring(center: Vec2, r: f32, width: f32, color: Color) {
    push(4, center.x - r, center.y - r, r * 2, r * 2, color, color, r * P.s, 0, 0, 0, width * P.s);
}

/// Line of `width` from `a` to `b` with round caps.
pub fn line(a: Vec2, b: Vec2, width: f32, color: Color) {
    ensure();
    let h = width * 0.5;
    let x0 = a.x; if b.x < x0 { x0 = b.x; }
    let y0 = a.y; if b.y < y0 { y0 = b.y; }
    let x1 = a.x; if b.x > x1 { x1 = b.x; }
    let y1 = a.y; if b.y > y1 { y1 = b.y; }
    game.p2Push(5, (x0 - h) * P.s + P.tx, (y0 - h) * P.s + P.ty, (x1 - x0 + width) * P.s, (y1 - y0 + width) * P.s,
        0, 0, 0, 0, tint(color), tint(color),
        a.x * P.s + P.tx, a.y * P.s + P.ty, b.x * P.s + P.tx, b.y * P.s + P.ty, h * P.s, 0);
}

/// `push` for the kinds that read `u0..dv` (gradient, shadow, dashed border).
fn pushG(kind: int, x: f32, y: f32, w: f32, h: f32, g0: f32, g1: f32, g2: f32, g3: f32, c1: Color, c2: Color, p0: f32, p1: f32, p2: f32, p3: f32, bw: f32) {
    ensure();
    game.p2Push(kind, x * P.s + P.tx, y * P.s + P.ty, w * P.s, h * P.s, g0, g1, g2, g3, tint(c1), tint(c2), p0, p1, p2, p3, bw, 0);
}

/// Write texel `i` of the ramp being baked from premultiplied 0..255 channels.
fn rampPut(i: int, pr: f32, pg: f32, pb: f32, pa: f32) {
    let k: f32 = 1.0;
    if pa > 0.5 {
        k = 255.0 / pa;
    }
    RAMPBUF[i * 4] = u8(pr * k + 0.5);
    RAMPBUF[i * 4 + 1] = u8(pg * k + 0.5);
    RAMPBUF[i * 4 + 2] = u8(pb * k + 0.5);
    RAMPBUF[i * 4 + 3] = u8(pa + 0.5);
}

/// Bake `stops` into `RAMPBUF`, blending premultiplied like CSS so a fade to transparent has no
/// dark fringe.
fn bake(stops: []Stop) {
    let n = stops.len;
    for i in 0..game.RAMP_W {
        let t = f32(i) / f32(game.RAMP_W - 1);
        let lo = stops[0];
        let hi = stops[n - 1];
        if t <= lo.at {
            hi = lo;
            t = lo.at;
        } else if t >= hi.at {
            lo = hi;
        } else {
            let k = 1;
            while stops[k].at < t {
                k += 1;
            }
            lo = stops[k - 1];
            hi = stops[k];
        }
        let f: f32 = 0.0;
        if hi.at - lo.at > 0.0001 {
            f = (t - lo.at) / (hi.at - lo.at);
        }
        let la = f32(lo.color.a);
        let ha = f32(hi.color.a);
        let pa = la + (ha - la) * f;
        let pr = f32(lo.color.r) * la / 255.0;
        let pg = f32(lo.color.g) * la / 255.0;
        let pb = f32(lo.color.b) * la / 255.0;
        let qr = f32(hi.color.r) * ha / 255.0;
        let qg = f32(hi.color.g) * ha / 255.0;
        let qb = f32(hi.color.b) * ha / 255.0;
        rampPut(i, pr + (qr - pr) * f, pg + (qg - pg) * f, pb + (qb - pb) * f, pa);
    }
}

/// Ramp row for a stop list, baking it on first use (64 distinct lists; the oldest row is reused
/// after that). Cheap to call every frame. `stops` must be ascending in `at`; empty gives row 0.
pub fn gradient(stops: []Stop): int {
    ensure();
    if stops.len == 0 {
        return 0;
    }
    let h = 7;
    for s in stops {
        h = h * 31 + int(s.at * 1000.0);
        h = h * 31 + int(s.color.r) + int(s.color.g) * 256 + int(s.color.b) * 65536 + int(s.color.a) * 16777216;
    }
    if h == 0 {
        h = 1;
    }
    for row in 0..game.RAMP_ROWS {
        if GKEY[row] == h {
            return row;
        }
    }
    let row = P.gnext;
    P.gnext = (row + 1) % game.RAMP_ROWS;
    GKEY[row] = h;
    bake(stops);
    game.p2RampRow(row, &RAMPBUF[0] as ptr);
    return row;
}

/// `roundRectEx` filled with gradient `row`. `kind`: 0 linear (`angle` in degrees, CSS style: 0
/// points up, 90 right), 1 radial (centered ellipse to the farthest corner), 2 conic (`angle`
/// is where it starts, clockwise from up). The border is the solid `border` of width `bw`.
pub fn gradientRect(pos: Vec2, size: Vec2, c: Corners, row: int, kind: int, angle: f32, bw: f32, border: Color) {
    ensure();
    let white = Color { r: 255, g: 255, b: 255, a: 255 };
    pushG(6, pos.x, pos.y, size.x, size.y, angle * 0.017453292, f32(row), f32(kind), 0,
        white, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// `roundRectEx` whose border of width `bw` is gradient `row` (see `gradientRect`) over the solid
/// `fill`.
pub fn gradientBorder(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, row: int, kind: int, angle: f32) {
    ensure();
    let white = Color { r: 255, g: 255, b: 255, a: 255 };
    pushG(6, pos.x, pos.y, size.x, size.y, angle * 0.017453292, f32(row), f32(kind), 1,
        fill, white, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// Soft shadow of a rounded box like CSS `box-shadow` (`blur` is the CSS blur radius, so the
/// Gaussian sigma is half of it; `spread` grows the box). Draw it before the box. A bright
/// `color` with zero `offset` is a glow.
pub fn shadow(pos: Vec2, size: Vec2, c: Corners, offset: Vec2, blur: f32, spread: f32, color: Color) {
    ensure();
    let sg = blur * 0.5;
    if sg < 0.25 {
        sg = 0.25;
    }
    let grow = 3.0 * sg;
    let hx = size.x * 0.5 + spread;
    let hy = size.y * 0.5 + spread;
    if hx <= 0 || hy <= 0 {
        return;
    }
    let cx = pos.x + size.x * 0.5 + offset.x;
    let cy = pos.y + size.y * 0.5 + offset.y;
    let r = P.s;
    pushG(7, cx - hx - grow, cy - hy - grow, (hx + grow) * 2, (hy + grow) * 2, hx * r, hy * r, sg * r, 0,
        color, color, grown(c.tl, spread) * r, grown(c.tr, spread) * r, grown(c.br, spread) * r, grown(c.bl, spread) * r, 0);
}

/// Corner radius `r` after growing the box by `spread` (a sharp corner stays sharp).
fn grown(r: f32, spread: f32): f32 {
    if r <= 0 {
        return 0;
    }
    let g = r + spread;
    if g < 0 {
        return 0;
    }
    return g;
}

/// Inner shadow like CSS `box-shadow: inset`: the box edges darken inward, the hole shifted by
/// `offset` and shrunk by `spread`. Draw it over the fill.
pub fn insetShadow(pos: Vec2, size: Vec2, c: Corners, offset: Vec2, blur: f32, spread: f32, color: Color) {
    ensure();
    let sg = blur * 0.5;
    if sg < 0.25 {
        sg = 0.25;
    }
    let r = P.s;
    pushG(8, pos.x, pos.y, size.x, size.y, offset.x * r, offset.y * r, sg * r, spread * r,
        color, color, c.tl * r, c.tr * r, c.br * r, c.bl * r, 0);
}

/// `roundRectEx` with a dashed (`style` 1) or dotted (`style` 2) border of width `bw`. Dashes
/// restart on each side, so a corner may not land on one.
pub fn roundRectDashed(pos: Vec2, size: Vec2, c: Corners, fill: Color, bw: f32, border: Color, style: int) {
    ensure();
    let period = bw * 5.0;
    if style == 2 {
        period = bw * 2.0;
    }
    if period < 4.0 {
        period = 4.0;
    }
    pushG(9, pos.x, pos.y, size.x, size.y, f32(style), period * P.s, 0, 0,
        fill, border, c.tl * P.s, c.tr * P.s, c.br * P.s, c.bl * P.s, bw * P.s);
}

/// Draw `msg` with its top left at `pos`. ASCII shares one glyph sheet per font, so a screen of
/// text is a handful of draws; other text goes through `j3.game`'s cached rasters. The glyph
/// size follows `pushScale`.
pub fn text(font: Font, pos: Vec2, msg: string, color: Color) {
    ensure();
    game.p2Text(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, tint(color), P.s);
}

/// `text` with emboldened glyphs.
pub fn textBold(font: Font, pos: Vec2, msg: string, color: Color) {
    ensure();
    game.p2TextBold(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, tint(color), P.s);
}

/// `text` filled from gradient `row` (see `gradient`) along the line `from` to `to`, in the same
/// coordinates as `pos`. The gradient is per pixel, so it runs across glyphs and lines; `alpha`
/// scales it. Needs the GL path (like all of paint).
pub fn textGradient(font: Font, pos: Vec2, msg: string, row: int, from: Vec2, to: Vec2, alpha: f32, bold: bool) {
    ensure();
    let a = tint(Color { r: 255, g: 255, b: 255, a: u8(alpha * 255.0 + 0.5) });
    game.p2TextGradient(font, Vec2 { x: pos.x * P.s + P.tx, y: pos.y * P.s + P.ty }, msg, a, P.s, bold, row,
        Vec2 { x: from.x * P.s + P.tx, y: from.y * P.s + P.ty }, Vec2 { x: to.x * P.s + P.tx, y: to.y * P.s + P.ty });
}

/// Draw the whole texture into a rect.
pub fn image(tex: Texture, pos: Vec2, size: Vec2) {
    imageSrc(tex, Vec2 { x: 0, y: 0 }, Vec2 { x: f32(tex.w), y: f32(tex.h) }, pos, size, Color { r: 255, g: 255, b: 255, a: 255 });
}

/// Draw `srcSize` pixels of `tex` from `src` into a rect, multiplied by `tint`.
pub fn imageSrc(tex: Texture, src: Vec2, srcSize: Vec2, pos: Vec2, size: Vec2, color: Color) {
    ensure();
    if tex.raw == 0 || tex.w < 1 || tex.h < 1 {
        return;
    }
    let c = tint(color);
    game.p2Push(1, pos.x * P.s + P.tx, pos.y * P.s + P.ty, size.x * P.s, size.y * P.s,
        src.x / f32(tex.w), src.y / f32(tex.h), srcSize.x / f32(tex.w), srcSize.y / f32(tex.h),
        c, c, 0, 0, 0, 0, 0, u32(tex.raw as int));
}

/// Clip later draws to a rect (intersected with the clip already active). Under a rotation or skew the clip is the
/// turned rect itself: a scissor on its bounding box plus an antialiased shape test in the shader (`game.p2ClipShapes`),
/// intersected with every outer clip, rect or shape. At most four such shape clips are nested at once (layers, `beginLayer`,
/// count too); a fifth falls back to the bounding box and prints one warning to stderr.
pub fn pushClip(pos: Vec2, size: Vec2) {
    ensure();
    saveClip();
    let x0 = pos.x * P.s + P.tx;
    let y0 = pos.y * P.s + P.ty;
    let x1 = x0 + size.x * P.s;
    let y1 = y0 + size.y * P.s;
    let shaped = false;
    if P.rot {
        if !axisAligned() {
            shaped = addClipShape(x0, y0, x1, y1);
        }
        // the scissor is the bounding box of the turned rect
        let ax = P.ra * x0 + P.rc * y0 + P.rx;
        let ay = P.rb * x0 + P.rd * y0 + P.ry;
        let bx = P.ra * x1 + P.rc * y0 + P.rx;
        let by = P.rb * x1 + P.rd * y0 + P.ry;
        let cx = P.ra * x0 + P.rc * y1 + P.rx;
        let cy = P.rb * x0 + P.rd * y1 + P.ry;
        let dx = P.ra * x1 + P.rc * y1 + P.rx;
        let dy = P.rb * x1 + P.rd * y1 + P.ry;
        x0 = min(min(ax, bx), min(cx, dx));
        x1 = max(max(ax, bx), max(cx, dx));
        y0 = min(min(ay, by), min(cy, dy));
        y1 = max(max(ay, by), max(cy, dy));
    }
    if P.clipOn {
        if x0 < P.cx0 { x0 = P.cx0; }
        if y0 < P.cy0 { y0 = P.cy0; }
        if x1 > P.cx1 { x1 = P.cx1; }
        if y1 > P.cy1 { y1 = P.cy1; }
        if x1 < x0 { x1 = x0; }
        if y1 < y0 { y1 = y0; }
    }
    P.clipOn = true;
    P.cx0 = x0;
    P.cy0 = y0;
    P.cx1 = x1;
    P.cy1 = y1;
    game.p2Clip(true, x0, y0, x1, y1);
    if shaped {
        applyClips(true);
    }
}

/// Screen-space outlines of the active turned clips (4 rows of 128 floats), the same in the frame the
/// affine turns (what the shader tests), their point counts, and: top, base (clips below it belong to a
/// captured layer or were escaped by `pushNoClip`), warned, and the affine the frame rows were made for.
#[singleton]
let CKS: [512]f32;
#[singleton]
let CKF: [512]f32;
#[singleton]
let CKC: [4]int;
#[singleton]
let CKI: [3]int;
#[singleton]
let CKA: [7]f32;
/// Where the current `pushView` sits in the outermost view: `CKS` is kept in those coordinates.
#[singleton]
let CKO: [2]f32;

/// Whether the current rotation layer keeps axes on axes (quarter turns, flips, non-uniform scale): the scissor is exact then.
fn axisAligned(): bool {
    let d = max(abs(P.ra), abs(P.rd));
    let o = max(abs(P.rb), abs(P.rc));
    return o < 0.0001 * d || d < 0.0001 * o;
}

/// Push the turned rect (frame coordinates, ends at most 1e5 out so an unclipped axis stays a strip) as a shape clip.
/// False when four are already nested: the caller keeps the bounding box and a warning is printed once.
fn addClipShape(x0: f32, y0: f32, x1: f32, y1: f32): bool {
    let k = CKI[0];
    if k >= 4 {
        if CKI[2] == 0 {
            CKI[2] = 1;
            let m = "paint.pushClip: more than four nested rotated clips, the inner ones clip to their bounding box\n";
            write(2, m.ptr as ptr, m.len);
        }
        return false;
    }
    x0 = max(x0, -100000.0);
    y0 = max(y0, -100000.0);
    x1 = min(x1, 100000.0);
    y1 = min(y1, 100000.0);
    let o = k * 128;
    for i in 0..5 {
        let x = if i == 1 || i == 2 { x1 } else { x0 };
        let y = if i == 2 || i == 3 { y1 } else { y0 };
        CKS[o + 2 * i] = P.ra * x + P.rc * y + P.rx + CKO[0];
        CKS[o + 2 * i + 1] = P.rb * x + P.rd * y + P.ry + CKO[1];
    }
    CKC[k] = 5;
    CKI[0] = k + 1;
    return true;
}

/// Hand the active turned clips to the painter, mapped back into the frame the current affine turns. Skipped when
/// nothing changed (same clips and affine), so child transforms inside a clip do not break batches.
fn applyClips(force: bool) {
    let n = CKI[0] - CKI[1];
    let on = P.rot;
    if !force && n > 0 && CKA[0] == (if on { 1.0 } else { 0.0 }) && CKA[1] == P.ra && CKA[2] == P.rb && CKA[3] == P.rc && CKA[4] == P.rd && CKA[5] == P.rx && CKA[6] == P.ry {
        return;
    }
    // draws queued under the old rows go out before CKF is rewritten (they read it at flush)
    game.p2Flush();
    CKA[0] = if on { 1.0 } else { 0.0 };
    CKA[1] = P.ra; CKA[2] = P.rb; CKA[3] = P.rc; CKA[4] = P.rd; CKA[5] = P.rx; CKA[6] = P.ry;
    let det = P.ra * P.rd - P.rb * P.rc;
    if n <= 0 || (on && abs(det) < 0.000000001) {
        game.p2ClipShapes(0, &CKF[0] as ptr, 0, 0, 0, 0);
        return;
    }
    for j in 0..n {
        let o = (CKI[1] + j) * 128;
        for i in 0..CKC[CKI[1] + j] {
            let x = CKS[o + 2 * i];
            let y = CKS[o + 2 * i + 1];
            if !on {
                x = x - CKO[0];
                y = y - CKO[1];
            } else {
                let dx = x - CKO[0] - P.rx;
                let dy = y - CKO[1] - P.ry;
                x = (P.rd * dx - P.rc * dy) / det;
                y = (P.ra * dy - P.rb * dx) / det;
            }
            CKF[o + 2 * i] = x;
            CKF[o + 2 * i + 1] = y;
        }
    }
    let b = CKI[1];
    game.p2ClipShapes(n, &CKF[b * 128] as ptr, CKC[b], if n > 1 { CKC[b + 1] } else { 0 }, if n > 2 { CKC[b + 2] } else { 0 }, if n > 3 { CKC[b + 3] } else { 0 });
}

/// Draw later content without any clip, like a `position: fixed` box escaping its ancestors'
/// `overflow`. Undo with `popClip`.
pub fn pushNoClip() {
    ensure();
    saveClip();
    P.clipOn = false;
    game.p2Clip(false, 0.0, 0.0, 0.0, 0.0);
    if CKI[0] > CKI[1] {
        CKI[1] = CKI[0];
        applyClips(true);
    }
}

fn saveClip() {
    if P.cn >= 16 {
        panic("paint.pushClip: nested too deep");
    }
    let o = P.cn * 9;
    CSTACK[o + 7] = CKO[0];
    CSTACK[o + 8] = CKO[1];
    CSTACK[o + 5] = f32(CKI[0]);
    CSTACK[o + 6] = f32(CKI[1]);
    CSTACK[o] = if P.clipOn { 1.0 } else { 0.0 };
    CSTACK[o + 1] = P.cx0;
    CSTACK[o + 2] = P.cy0;
    CSTACK[o + 3] = P.cx1;
    CSTACK[o + 4] = P.cy1;
    P.cn += 1;
}

/// Undo the last `pushClip`.
pub fn popClip() {
    ensure();
    if P.cn == 0 {
        return;
    }
    P.cn -= 1;
    let o = P.cn * 9;
    let was = CKI[0] > CKI[1];
    CKO[0] = CSTACK[o + 7];
    CKO[1] = CSTACK[o + 8];
    CKI[0] = int(CSTACK[o + 5]);
    CKI[1] = int(CSTACK[o + 6]);
    if was || CKI[0] > CKI[1] {
        applyClips(true);
    }
    P.clipOn = CSTACK[o] > 0.5;
    P.cx0 = CSTACK[o + 1];
    P.cy0 = CSTACK[o + 2];
    P.cx1 = CSTACK[o + 3];
    P.cy1 = CSTACK[o + 4];
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1);
}

/// Current shape clips (slot 0: `clip-path`, slot 1: inner shapes such as rounded image corners and
/// path fills), 2 * MAXPT floats each in device-local pixels, and what is saved under them.
#[singleton]
let SHP: [8192]f32;
#[singleton]
let SHN: [2]int;
#[singleton]
let SHR: [2]int;
/// Saved shapes: slot * 4 + depth, 2 * MAXPT floats each.
#[singleton]
let SSTK: [32768]f32;
#[singleton]
let SSN: [8]int;
#[singleton]
let SSR: [8]int;
#[singleton]
let SDEPTH: [2]int;

fn applyShape(slot: int) {
    game.p2Shape(slot, &SHP[slot * (2 * MAXPT)] as ptr, SHN[slot], SHR[slot] == 1);
}

/// Clip later draws to an outline: `n` x, y pairs in the current coordinates (at most `path.MAXPT` points, a
/// point with x below -1e8 starts a new contour, each contour repeats its first point), antialiased,
/// non-zero winding or `evenOdd`. Slot 0 is for `clip-path`, slot 1 for shapes drawn inside it (rounded
/// image corners, `fillShape`); one outline per slot is active, a nested push replaces the outer one
/// until its `popShape(slot)` (four deep). The outline moves with `pushRotate` and `pushXform` (the
/// clip rect of `pushClip` does not). See `j3.gfx.clip` for builders.
pub fn pushShape(slot: int, pts: []f32, n: int, evenOdd: bool) {
    ensure();
    let d = SDEPTH[slot];
    SDEPTH[slot] = d + 1;
    if d >= 4 {
        return;
    }
    let o = (slot * 4 + d) * (2 * MAXPT);
    for i in 0..SHN[slot] * 2 {
        SSTK[o + i] = SHP[slot * (2 * MAXPT) + i];
    }
    SSN[slot * 4 + d] = SHN[slot];
    SSR[slot * 4 + d] = SHR[slot];
    let m = n;
    if m > MAXPT {
        m = MAXPT;
    }
    if 2 * m > pts.len {
        m = pts.len / 2;
    }
    for i in 0..m {
        let x = pts[2 * i];
        if x < -100000000.0 {
            SHP[slot * (2 * MAXPT) + 2 * i] = x;
            SHP[slot * (2 * MAXPT) + 2 * i + 1] = 0.0;
        } else {
            SHP[slot * (2 * MAXPT) + 2 * i] = x * P.s + P.tx;
            SHP[slot * (2 * MAXPT) + 2 * i + 1] = pts[2 * i + 1] * P.s + P.ty;
        }
    }
    SHN[slot] = m;
    SHR[slot] = if evenOdd { 1 } else { 0 };
    applyShape(slot);
}

/// Undo the last `pushShape` of `slot`.
pub fn popShape(slot: int) {
    ensure();
    if SDEPTH[slot] == 0 {
        return;
    }
    SDEPTH[slot] -= 1;
    let d = SDEPTH[slot];
    if d >= 4 {
        return;
    }
    let o = (slot * 4 + d) * (2 * MAXPT);
    SHN[slot] = SSN[slot * 4 + d];
    SHR[slot] = SSR[slot * 4 + d];
    for i in 0..SHN[slot] * 2 {
        SHP[slot * (2 * MAXPT) + i] = SSTK[o + i];
    }
    applyShape(slot);
}

/// Fill the outline `pts` (see `pushShape`; concave, holes and self-crossings follow the fill rule)
/// with one color. Uses slot 1 for the duration and flushes twice, so it is a draw call per path.
pub fn fillShape(pts: []f32, n: int, evenOdd: bool, color: Color) {
    let x0: f32 = 1000000000.0;
    let y0: f32 = 1000000000.0;
    let x1: f32 = -1000000000.0;
    let y1: f32 = -1000000000.0;
    for i in 0..n {
        let x = pts[2 * i];
        if x < -100000000.0 {
            continue;
        }
        let y = pts[2 * i + 1];
        if x < x0 { x0 = x; }
        if y < y0 { y0 = y; }
        if x > x1 { x1 = x; }
        if y > y1 { y1 = y; }
    }
    if x1 < x0 {
        return;
    }
    pushShape(1, pts, n, evenOdd);
    rect(Vec2 { x: x0 - 1.0, y: y0 - 1.0 }, Vec2 { x: x1 - x0 + 2.0, y: y1 - y0 + 2.0 }, color);
    popShape(1);
}

/// Saved masks: kind, row, angle, x, y, w, h each, and the current one.
#[singleton]
let MSTK: [28]f32;
#[singleton]
let MCUR: [7]f32;
#[singleton]
let MDEPTH: [1]int;

fn applyMask() {
    game.p2Mask(int(MCUR[0]), int(MCUR[1]), MCUR[2], MCUR[3], MCUR[4], MCUR[5], MCUR[6]);
}

/// Multiply the alpha of later draws by the gradient `row` (from `gradient`) laid over the box
/// `pos`/`size`: `kind` 1 linear at `angle` radians (0 up, clockwise), 2 radial from the center
/// (`mask-image`). One mask is active; a nested push replaces it until `popMask` (four deep).
pub fn pushMask(kind: int, row: int, angle: f32, pos: Vec2, size: Vec2) {
    ensure();
    let d = MDEPTH[0];
    MDEPTH[0] = d + 1;
    if d >= 4 {
        return;
    }
    for i in 0..7 {
        MSTK[d * 7 + i] = MCUR[i];
    }
    MCUR[0] = f32(kind);
    MCUR[1] = f32(row);
    MCUR[2] = angle;
    MCUR[3] = pos.x * P.s + P.tx;
    MCUR[4] = pos.y * P.s + P.ty;
    MCUR[5] = size.x * P.s;
    MCUR[6] = size.y * P.s;
    applyMask();
}

/// Undo the last `pushMask`.
pub fn popMask() {
    ensure();
    if MDEPTH[0] == 0 {
        return;
    }
    MDEPTH[0] -= 1;
    let d = MDEPTH[0];
    if d >= 4 {
        return;
    }
    for i in 0..7 {
        MCUR[i] = MSTK[d * 7 + i];
    }
    applyMask();
}

fn saveTransform() {
    if P.tn >= 32 {
        panic("paint: transform stack too deep");
    }
    let o = P.tn * 3;
    TSTACK[o] = P.s;
    TSTACK[o + 1] = P.tx;
    TSTACK[o + 2] = P.ty;
    let r = P.tn * 7;
    RSTACK[r] = 0;
    if P.rot {
        RSTACK[r] = 1;
    }
    RSTACK[r + 1] = P.ra;
    RSTACK[r + 2] = P.rb;
    RSTACK[r + 3] = P.rc;
    RSTACK[r + 4] = P.rd;
    RSTACK[r + 5] = P.rx;
    RSTACK[r + 6] = P.ry;
    P.tn += 1;
}

fn applyRot() {
    game.p2Affine(P.rot, P.ra, P.rb, P.rc, P.rd, P.rx, P.ry);
    if CKI[0] > CKI[1] {
        applyClips(false);
    }
}

/// Turn later draws by `rad` about the point `(px, py)` in view pixels (composes with what is set).
fn rotateAbout(px: f32, py: f32, rad: f32) {
    let cs = cos(rad);
    let sn = sin(rad);
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    let u = px - (cs * px - sn * py);
    let v = py - (sn * px + cs * py);
    let na = P.ra * cs + P.rc * sn;
    let nc = 0 - P.ra * sn + P.rc * cs;
    let nb = P.rb * cs + P.rd * sn;
    let nd = 0 - P.rb * sn + P.rd * cs;
    let nx = P.ra * u + P.rc * v + P.rx;
    let ny = P.rb * u + P.rd * v + P.ry;
    P.ra = na;
    P.rb = nb;
    P.rc = nc;
    P.rd = nd;
    P.rx = nx;
    P.ry = ny;
    applyRot();
}

/// Turn later draws by `rad` radians (clockwise on screen) about `origin` (current coordinates).
/// Shapes, text, and images rotate, and a `pushClip` after it clips to the turned rect (see `pushClip`). Undo with `popTransform`.
pub fn pushRotate(origin: Vec2, rad: f32) {
    ensure();
    saveTransform();
    rotateAbout(origin.x * P.s + P.tx, origin.y * P.s + P.ty, rad);
}

/// Slant later draws horizontally: a point `y` above `origin` moves right by `k * y` (`k` 0.2 is a faux italic), the
/// row of `origin` stays put. Shapes, text, and images slant like `pushRotate` turns them. Undo with `popTransform`.
pub fn pushSkew(origin: Vec2, k: f32) {
    ensure();
    saveTransform();
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    let u = k * (origin.y * P.s + P.ty);
    P.rx = P.ra * u + P.rx;
    P.ry = P.rb * u + P.ry;
    P.rc = P.rc - k * P.ra;
    P.rd = P.rd - k * P.rb;
    applyRot();
}

/// Translate by `move`, turn by `rad`, then scale by `s`, the last two about `origin`: a CSS
/// `transform` box in one stack entry. Undo with `popTransform`.
pub fn pushXform(origin: Vec2, move: Vec2, rad: f32, s: f32) {
    ensure();
    saveTransform();
    P.tx = P.tx + move.x * P.s;
    P.ty = P.ty + move.y * P.s;
    if rad != 0 {
        rotateAbout(origin.x * P.s + P.tx, origin.y * P.s + P.ty, rad);
    }
    if s != 1 {
        P.tx = P.tx + origin.x * P.s * (1 - s);
        P.ty = P.ty + origin.y * P.s * (1 - s);
        P.s = P.s * s;
    }
}

/// Apply the 2D affine matrix `a b c d e f` (CSS `matrix()`: `x' = a x + c y + e`, `y' = b x + d y + f`) to later draws, in
/// current coordinates. Translation and uniform scale stay on the fast path (clips follow them); rotation, skew and non-uniform
/// scale go through `game.p2Affine` (shapes, text and images follow, and a later `pushClip` clips to the turned rect). Undo with `popTransform`.
pub fn pushAffine(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) {
    ensure();
    saveTransform();
    let s = P.s;
    if b == 0 && c == 0 && a == d && a > 0 {
        P.tx = P.tx + e * s;
        P.ty = P.ty + f * s;
        P.s = s * a;
        return;
    }
    if !P.rot {
        P.rot = true;
        P.ra = 1;
        P.rb = 0;
        P.rc = 0;
        P.rd = 1;
        P.rx = 0;
        P.ry = 0;
    }
    // view' = A (view - t) + s B + t, then composed after the current rotation layer
    let vx = P.tx - (a * P.tx + c * P.ty) + s * e;
    let vy = P.ty - (b * P.tx + d * P.ty) + s * f;
    let na = P.ra * a + P.rc * b;
    let nc = P.ra * c + P.rc * d;
    let nb = P.rb * a + P.rd * b;
    let nd = P.rb * c + P.rd * d;
    let nx = P.ra * vx + P.rc * vy + P.rx;
    let ny = P.rb * vx + P.rd * vy + P.ry;
    P.ra = na;
    P.rb = nb;
    P.rc = nc;
    P.rd = nd;
    P.rx = nx;
    P.ry = ny;
    applyRot();
}

/// Move the origin by `d` (in the current, possibly scaled, coordinates).
pub fn pushTranslate(d: Vec2) {
    ensure();
    saveTransform();
    P.tx = P.tx + d.x * P.s;
    P.ty = P.ty + d.y * P.s;
}

/// Scale about `origin` (current coordinates) by `s`. Uniform scale only (`pushRotate` turns).
pub fn pushScale(origin: Vec2, s: f32) {
    ensure();
    saveTransform();
    P.tx = P.tx + origin.x * P.s * (1 - s);
    P.ty = P.ty + origin.y * P.s * (1 - s);
    P.s = P.s * s;
}

/// Reset the transform to identity (undo with `popTransform`). For code that draws in view
/// coordinates inside a `pushView`, such as a `<canvas>` body.
pub fn pushIdentity() {
    ensure();
    saveTransform();
    P.s = 1;
    P.tx = 0;
    P.ty = 0;
    P.rot = false;
    applyRot();
}

/// Undo the last `pushTranslate`, `pushScale`, `pushRotate`, `pushXform`, or `pushIdentity`.
pub fn popTransform() {
    ensure();
    if P.tn == 0 {
        return;
    }
    P.tn -= 1;
    let o = P.tn * 3;
    P.s = TSTACK[o];
    P.tx = TSTACK[o + 1];
    P.ty = TSTACK[o + 2];
    let r = P.tn * 7;
    P.rot = RSTACK[r] > 0.5;
    P.ra = RSTACK[r + 1];
    P.rb = RSTACK[r + 2];
    P.rc = RSTACK[r + 3];
    P.rd = RSTACK[r + 4];
    P.rx = RSTACK[r + 5];
    P.ry = RSTACK[r + 6];
    applyRot();
}

/// Multiply the alpha of later draws by `a` (0 to 1).
/// ponytail: this fades each shape on its own, so overlapping children show through each other;
/// real group opacity needs a render-to-texture layer.
pub fn pushAlpha(a: f32) {
    ensure();
    if P.an >= 32 {
        panic("paint: alpha stack too deep");
    }
    ASTACK[P.an] = P.a;
    P.an += 1;
    P.a = P.a * a;
}

/// Undo the last `pushAlpha`.
pub fn popAlpha() {
    ensure();
    if P.an == 0 {
        return;
    }
    P.an -= 1;
    P.a = ASTACK[P.an];
}

/// Draw into a sub-rectangle of the window: `(0, 0)` becomes `pos` and clipping follows its
/// bounds. Nests. Flushes, and `j3.game` 2D draws follow it too; turned clips stay where they are on screen.
pub fn pushView(pos: Vec2, size: Vec2) {
    ensure();
    game.p2PushView(pos, size);
    // The active clip is in the outer view's coordinates; move it into this one's.
    saveClip();
    P.cx0 -= pos.x;
    P.cy0 -= pos.y;
    P.cx1 -= pos.x;
    P.cy1 -= pos.y;
    game.p2Clip(P.clipOn, P.cx0, P.cy0, P.cx1, P.cy1);
    CKO[0] += pos.x;
    CKO[1] += pos.y;
    if CKI[0] > CKI[1] {
        applyClips(true);
    }
}

/// Undo the last `pushView`.
pub fn popView() {
    game.p2PopView();
    popClip();
}

/// Draw everything queued now. Only needed before raw GL.
pub fn flush() {
    game.p2Flush();
}
