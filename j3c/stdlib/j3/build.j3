/// How this program was built, fixed at compile time. A dev build (`j3c run`, `j3c build`)
/// gets this file; `--release` (`j3c build --release`, `j3c run --release`) gets
/// `build_release.j3`, which has the same names. Code under `if build.DEV { ... }` stays
/// in a release binary only as a dead branch the optimizer drops.

module j3.build;

/// True in a `--release` build.
pub const RELEASE: bool = false;
/// True in a dev build (not `--release`): debug keys, cheats, extra logging.
pub const DEV: bool = true;
