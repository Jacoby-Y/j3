/// j2: a small dynamic script language the game reads from plain text at runtime, for modders
/// and designers without the source. It looks like J3 (`let`, `fn`, `{ }`, backtick strings,
/// `match`, `use`, `pub`) and behaves like Lua (values carry their types, tables, closures, GC).
/// Pure J3, no window: lexer, parser, compiler, VM and heap. Guide: `j3c doc j2` (host),
/// `j3c doc j2 lang` (the language, for script writers), `j3c doc recipes j2`.
///
/// Host API: `Vm.new(mem, Limits)`, `openLibs(LIB_*)`, `bind(name, native)`, `vm.host`,
/// `vm.resolver`/`resolverCtx` (how `use name;` finds a script), `loadString`/`loadFile` (give the
/// exports table), `call`/`callWithThis` (re-entrant from natives), `keep`/`value`/`get`/`release`,
/// `getNum`/`setNum`, `newTable`/`newArray`/`intern`/`raise`, `protect`, `seed`, `stats`/`collect`,
/// `Args` getters, `Table`/`Array` views, `nil()` `none()` `num()` `int()` `str()` `noArgs()`.
/// Every entry returns `Result<_, Error>`; nothing panics on script input, and the `Vm` keeps
/// working after any error. One `Vm` per thread.
/// Inside (the other public names): values (`value.j3`), the heap (`heap.j3`, `str.j3`,
/// `table.j3`, `array.j3`), `fmt.j3`, the front end in `j3.j2.lex` / `j3.j2.parse`, the compiler
/// (`compile*.j3`, `code.j3`), the VM (`vm*.j3`), the GC (`gc.j3`), the built-ins (`lib*.j3`),
/// `dumpProto`. Example: `examples/j2_script`.

module j3.j2;

use j3.cmp;
use j3.data.map.Map;
use j3.io;
use j3.j2.lex;
use j3.j2.lex.SyntaxError;
use j3.j2.parse;
use j3.j2.parse.{ Ast, Node };
use j3.memory.{ Arena, List };
use j3.result.Result;
use j3.sys;
use j3.sys.{ mmapAnon, munmap, panic };
use j3.text.Text;

use lib "m" as libm {
    fn sqrt(x: f64): f64;
    fn sin(x: f64): f64;
    fn cos(x: f64): f64;
    fn tan(x: f64): f64;
    fn atan2(y: f64, x: f64): f64;
    fn floor(x: f64): f64;
    fn ceil(x: f64): f64;
}

use lib "c" as libc {
    fn strtod(s: ptr, end: ptr): f64;
}

/// `nil`.
pub fn nil(): Value { return nilv(); }

/// An int value.
pub fn int(n: int): Value { return intv(n); }

/// A float value.
pub fn num(x: f64): Value { return floatv(x); }

/// A bool value.
pub fn boolean(b: bool): Value { return boolv(b); }

/// No arguments, for `vm.call(f, j2.noArgs())` (J3 has no empty array literal).
pub fn noArgs(): []Value { return @slice(0 as ptr, 0); }

/// The `Ref` that holds nothing; `value` of it is nil and releasing it does nothing.
pub fn none(): Ref { return Ref { id: 0 }; }
