// Tests for j3.i18n: locale files, lookup and the fallback chain, placeholders, plural rules (CLDR vectors),
// number formats, the once-per-key missing warning, rtl, and a Dom whose text comes from t(): setLocale changes the
// text and idle frames after it do no layout or restyle. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/i18n_test.j3 --headless

module i18n_test;

use j3.i18n;
use j3.i18n.{ Arg, named, num, real, t, tf, tf2 };
use j3.io.{ printLn, writeFile };
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ same, scratchText };
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CHECKS: int;
#[singleton]
let TID: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(got: string, want: string, msg: string) {
    CHECKS += 1;
    if !same(got, want) {
        printLn(`FAIL: {msg}: got "{got}" want "{want}"`);
        panic(msg);
    }
}

fn pl(lang: string, n: int, want: string) {
    eq(i18n.plural(lang, n, false), want, `plural {lang} {n}`);
}

fn frame(d: &Dom) {
    d.simInput(-5.0, -5.0, false, 0.0);
    d.beginFrame(Vec2 { x: 300.0, y: 100.0 });
    let a = d.open(0, d.tag("div"), 1);
    TID = d.text(t("app.title"));
    d.close();
    let b = d.open(1, d.tag("div"), 1);
    d.text(tf("shop.items", named("count", num(3))));
    d.close();
    d.layout();
    d.endFrame();
}

fn main() {
    i18n.quiet(true);
    i18n.init("j3c/stdlib/tests/i18n_locales", "en", "en");

    // lookup, comments, escapes
    eq(t("app.title"), "Shop", "en title");
    eq(t("multi"), "line one\nline two", "escape");
    eq(tf("braces", text0()), "{literal} x", "doubled braces");
    ok(i18n.has("shop.buy") && !i18n.has("nope"), "has");

    // placeholders: positional and named, numbers grouped
    eq(tf2("shop.buy", num(1234567), named("price", real(2.5))), "Buy 1,234,567 for 2.5", "placeholders");
    eq(tf("shop.buy", num(3)), "Buy 3 for {price}", "unknown placeholder stays");

    // fallback chain: de -> en; pt-BR -> pt -> en
    i18n.setLocale("de");
    eq(t("app.title"), "Laden", "de");
    eq(t("only.en"), "Only English", "de falls back to en");
    i18n.setLocale("pt-BR");
    eq(t("app.title"), "Loja", "pt-BR uses pt");
    eq(t("only.pt"), "So pt", "pt-BR base");
    eq(t("only.en"), "Only English", "pt-BR falls to en");
    ok(!i18n.rtl(), "pt not rtl");

    // missing key: the key itself, counted once
    let m0 = i18n.missing();
    eq(t("zz.missing"), "zz.missing", "missing returns key");
    eq(t("zz.missing"), "zz.missing", "missing again");
    ok(i18n.missing() == m0 + 1, "missing warned once per key");

    // plural rules (CLDR): counts 0 1 2 3 5 11 21 22 101
    pl("en", 0, "other"); pl("en", 1, "one"); pl("en", 2, "other"); pl("en", 101, "other");
    eq(i18n.plural("en", 1, true), "other", "en 1.5");
    pl("de", 1, "one"); pl("de", 0, "other");
    pl("es", 0, "other"); pl("es", 1, "one"); pl("it", 1, "one"); pl("it", 5, "other");
    pl("fr", 0, "one"); pl("fr", 1, "one"); pl("fr", 2, "other");
    eq(i18n.plural("fr", 1, true), "one", "fr 1.5");
    pl("pt", 0, "one"); pl("pt-BR", 1, "one"); pl("pt", 2, "other");
    pl("ru", 0, "many"); pl("ru", 1, "one"); pl("ru", 2, "few"); pl("ru", 3, "few"); pl("ru", 5, "many");
    pl("ru", 11, "many"); pl("ru", 21, "one"); pl("ru", 22, "few"); pl("ru", 101, "one"); pl("ru", 112, "many");
    eq(i18n.plural("ru", 1, true), "other", "ru 1.5");
    pl("uk", 21, "one"); pl("uk", 3, "few");
    pl("pl", 0, "many"); pl("pl", 1, "one"); pl("pl", 2, "few"); pl("pl", 5, "many"); pl("pl", 11, "many");
    pl("pl", 21, "many"); pl("pl", 22, "few"); pl("pl", 101, "many");
    pl("ar", 0, "zero"); pl("ar", 1, "one"); pl("ar", 2, "two"); pl("ar", 3, "few"); pl("ar", 5, "few");
    pl("ar", 11, "many"); pl("ar", 21, "many"); pl("ar", 22, "many"); pl("ar", 101, "other"); pl("ar", 102, "other");
    eq(i18n.plural("ar", 1, true), "other", "ar 1.5");
    for n in 0..4 {
        pl("ja", n, "other"); pl("zh", n, "other"); pl("ko", n, "other");
    }

    // plural selection through tf, with the locale's own forms
    i18n.setLocale("en");
    eq(tf("shop.items", num(1)), "1 item", "en one");
    eq(tf("shop.items", num(2)), "2 items", "en other");
    eq(tf("shop.items", real(1.5)), "1.5 items", "en 1.5");
    i18n.setLocale("ru");
    eq(tf("shop.items", num(2)), "2 штуки", "ru few");
    eq(tf("shop.items", num(5)), "5 штук", "ru many");
    eq(tf("shop.items", num(21)), "21 штука", "ru one");
    i18n.setLocale("ar");
    ok(i18n.rtl(), "ar is rtl");
    eq(tf("shop.items", num(0)), "لا عناصر", "ar zero");
    eq(tf("shop.items", num(2)), "عنصران", "ar two");
    eq(tf("shop.items", num(101)), "101 عنصر", "ar other");

    // numbers per locale
    i18n.setLocale("en");
    eq(i18n.fmtNum(1234567), "1,234,567", "en num");
    eq(i18n.fmtNum(-1234), "-1,234", "en negative");
    eq(i18n.fmtNum(999), "999", "en small");
    eq(i18n.fmtReal(1234.5), "1,234.5", "en real");
    eq(i18n.fmtReal(-0.25), "-0.25", "en negative real");
    i18n.setLocale("de");
    eq(i18n.fmtNum(1234567), "1.234.567", "de num");
    eq(i18n.fmtReal(1234.5), "1.234,5", "de real");
    i18n.setLocale("fr");
    eq(i18n.fmtNum(1234567), "1 234 567", "fr num");
    i18n.setLocale("ru");
    eq(i18n.fmtNum(1234), "1 234", "ru num");
    i18n.setLocale("es");
    eq(i18n.fmtNum(1234), "1234", "es four digits");
    eq(i18n.fmtNum(12345), "12.345", "es five digits");

    // a Dom whose text comes from t(): the locale switch re-renders, idle frames cost nothing
    let mem = Arena.create(8 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, "div { width: 200px; height: 20px; }", "i18n.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    i18n.setLocale("en");
    frame(&d);
    frame(&d);
    eq(d.textOf(TID), "Shop", "dom en");
    i18n.setLocale("de");
    frame(&d);
    eq(d.textOf(TID), "Laden", "dom de after setLocale");
    frame(&d);
    let r0 = d.restyled;
    let l0 = d.laid;
    for i in 0..30 { frame(&d); }
    ok(d.restyled == r0 && d.laid == l0, "idle frames neither restyle nor lay out");
    // hot reload: an unchanged file reloads nothing, a changed one shows on the next lookup
    let path = "/tmp/j3i18n_reload.txt";
    let v1 = "greet = Hello\n";
    writeFile(path, @slice(v1.ptr as ptr, v1.len));
    i18n.init("/tmp", "j3i18n_reload", "j3i18n_reload");
    eq(t("greet"), "Hello", "reload: first load");
    let ver = i18n.version();
    ok(!i18n.reloadIfChanged(), "reload: nothing changed");
    ok(i18n.version() == ver, "reload: version steady");
    let v2 = "greet = Howdy\n";
    writeFile(path, @slice(v2.ptr as ptr, v2.len));
    ok(i18n.reloadIfChanged(), "reload: change seen");
    eq(t("greet"), "Howdy", "reload: new text");
    ok(i18n.version() == ver + 1, "reload: version bumped");
    ok(!i18n.reloadIfChanged(), "reload: settled");

    // more than 256 distinct missing keys: no crash, the count stops at the cap
    for i in 0..300 {
        t(fmtKey(i));
    }
    ok(i18n.missing() == 256, "missing cap");
    printLn(`i18n_test: {CHECKS} checks passed`);
}

fn text0(): Arg {
    return i18n.text("x");
}

fn fmtKey(i: int): string {
    let k = scratchText();
    k.pushStr("cap.");
    k.pushInt(i);
    return k.bytes as string;
}
