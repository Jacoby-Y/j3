// Fake `j3.game` input (`simKey`, `simText`, `simPreedit`, `simDrop`) seen by code that reads `j3.game`, as if SDL sent
// it on the next poll: `j3.term.view.View.input` turns `simText("ls")` + Enter into "ls\r", and a shell on a pty reads
// that line. Run from the repo root, headless (the window never shows):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/sim_input_test.j3

module sim_input_test;

use j3.game;
use j3.game.Key;
use j3.game.Mouse;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.term.grid.Grid;
use j3.term.pty;
use j3.term.pty.Pty;
use j3.term.view.View;
use j3.text.{ contains, same, Text };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn main() {
    let a = Arena.create(8 * 1024 * 1024);
    game.initGlHidden("sim input", 320, 200);
    game.poll();

    // key edges and holds
    game.simKey(Key.Enter, true);
    game.poll();
    ok(game.keyPressedRaw(Key.Enter) && game.keyPressed(Key.Enter) && game.keyDown(Key.Enter), "sim press");
    game.poll();
    ok(!game.keyPressed(Key.Enter) && game.keyDown(Key.Enter), "press once, then held");
    game.simKey(Key.Enter, true);
    game.poll();
    ok(!game.keyPressed(Key.Enter), "a down while held is a repeat");
    game.simKey(Key.Enter, false);
    game.poll();
    ok(game.keyReleased(Key.Enter) && !game.keyDown(Key.Enter), "sim release");
    game.poll();
    ok(!game.keyReleased(Key.Enter), "release once");
    game.simKey(Key.Ctrl, true);
    game.simKey(Key.Shift, true);
    game.simKey(Key.V, true);
    game.poll();
    ok(game.keyDown(Key.Ctrl) && game.keyDown(Key.Shift) && game.keyPressed(Key.V), "Ctrl+Shift+V");
    game.simKey(Key.V, false);
    game.simKey(Key.Shift, false);
    game.simKey(Key.Ctrl, false);
    game.poll();
    ok(!game.keyDown(Key.Ctrl), "modifiers up");

    // text, composition, drop
    game.simText("héllo");
    game.poll();
    ok(same(game.textTyped(), "héllo"), "sim text");
    game.poll();
    ok(game.textTyped().len == 0, "text once");
    game.simPreedit("にほ", 3);
    game.poll();
    ok(same(game.textComposing(), "にほ") && game.textComposingCaret() == 3, "sim preedit");
    game.simText("日本");
    game.poll();
    ok(game.textComposing().len == 0 && same(game.textTyped(), "日本"), "commit ends the composition");
    game.simDrop("/tmp/a.png");
    game.poll();
    ok(same(game.droppedFile(), "/tmp/a.png"), "sim drop");
    game.poll();
    ok(game.droppedFile().len == 0, "drop once");

    // mouse: position, one-frame press, hold, release, a quick click, wheel, virtual size
    game.simMouse(100, 100);
    game.simButton(Mouse.Left, true);
    game.poll();
    let mp = game.mousePos();
    ok(mp.x == 100.0 && mp.y == 100.0, "sim mouse pos");
    ok(game.mousePressed(Mouse.Left) && game.mouseDown(Mouse.Left), "sim press");
    game.poll();
    ok(!game.mousePressed(Mouse.Left) && game.mouseDown(Mouse.Left), "mouse press once, then held");
    game.simButton(Mouse.Left, false);
    game.poll();
    ok(game.mouseReleased(Mouse.Left) && !game.mouseDown(Mouse.Left), "sim mouse release");
    game.poll();
    ok(!game.mouseReleased(Mouse.Left), "mouse release once");
    game.simButton(Mouse.Right, true);
    game.simButton(Mouse.Right, false);
    game.poll();
    ok(game.mousePressed(Mouse.Right), "quick click: down frame");
    game.poll();
    ok(game.mouseReleased(Mouse.Right), "quick click: up frame");
    game.simWheel(-2);
    game.poll();
    ok(game.mouseWheel() == -2.0, "sim wheel");
    game.poll();
    ok(game.mouseWheel() == 0.0, "wheel once");
    game.setVirtualSize(160, 100);
    game.simMouse(160, 100);
    game.poll();
    let vp = game.mousePos();
    ok(vp.x == 80.0 && vp.y == 50.0, `virtual size maps the sim cursor (got {vp.x}, {vp.y})`);
    game.setVirtualSize(0, 0);

    // through j3.term.view into a pty
    // run from the repo root (built at run time, so `check` does not look the path up beside this file)
    let fontPath = Text.new(&a);
    fontPath.pushStr("examples/terminal/");
    fontPath.pushStr("assets/mono.ttf");
    let font = game.loadFont(fontPath.str(), 14);
    let view = View.new(&a, font);
    let g = Grid.new(&a, 40, 10, 0);
    let out = Text.new(&a);
    let argv: [3]string = ["/bin/sh", "-c", "read x; printf '<%s>' \"$x\""];
    let none: [1]string = [""];
    let p = Pty { fd: -1, pid: -1, pend: Text.new(&a) };
    match pty.spawn(argv, "", none[0..0], 40, 10, &a) {
        Result.Ok(q) { p = q; }
        Result.Err(_) { panic("could not spawn /bin/sh"); }
    }
    game.poll();
    view.input(&g, &out);
    game.simText("ls");
    game.simKey(Key.Enter, true);
    game.poll();
    view.input(&g, &out);
    ok(same(out.str(), "ls\r"), `View.input sent "ls\\r" (got {out.len()} bytes)`);
    ok(view.blinkT0 > 0, "sending input restarts the blink phase");
    // cursor blink: on for blinkMs, off for blinkMs, steady shapes (2, 4, 6) always on
    view.blinkMs = 500;
    view.blinkT0 = 1000;
    ok(view.blinkOn(0, 1200) && !view.blinkOn(0, 1700) && view.blinkOn(1, 2100), "blink phases");
    ok(view.blinkOn(2, 1700) && view.blinkOn(6, 1700), "steady shapes do not blink");
    view.blinkMs = 0;
    ok(view.blinkOn(0, 1700), "blinkMs 0 is steady");
    ok(p.write(out.str() as []u8), "pty write");
    game.simKey(Key.Enter, false);
    game.poll();
    let got = Text.new(&a);
    let buf = a.alloc::<u8>(4096);
    for i in 0..100 {
        let pfd: [2]i32 = [i32(p.fd), i32(sys.POLLIN)];
        sys.pollFds(&pfd[0] as ptr, 1, 50);
        got.pushStr(p.tryRead(buf));
        if contains(got.str(), "<ls>") || p.eof { break; }
    }
    ok(contains(got.str(), "<ls>"), "the shell read the line ls");
    printLn("sim_input_test ok");
}
