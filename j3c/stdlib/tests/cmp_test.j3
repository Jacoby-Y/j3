// Tests for j3.cmp: hashes, helpers, bounds on a user type.
//   timeout 60 j3c run j3c/stdlib/tests/cmp_test.j3
// Panics on the first failed check.

module cmp_test;

use j3.cmp.{ Hash, hashOf, contains, indexOf, minOf, maxOf, combine };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;

struct P {
    x: int;
    y: int;
    fn operator==(this: P, o: P): bool { return this.x == o.x && this.y == o.y; }
    fn operator<(this: P, o: P): bool { return this.x < o.x; }
    fn hash(this: P): u64 { return combine(hashOf(this.x), hashOf(this.y)); }
}

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("cmp_test");
    }
}

fn main() {
    ok(hashOf(5) == hashOf(5) && hashOf(5) != hashOf(6), "int");
    ok(hashOf("abc") == hashOf("abc") && hashOf("abc") != hashOf("abd") && hashOf("") != hashOf("a"), "string");
    ok(hashOf(0.0) == hashOf(-0.0) && hashOf(1.5) != hashOf(2.5), "float zero");
    ok(hashOf(true) != hashOf(false), "bool");
    // Sequential keys spread over the low bits (identity hashing would fill 8 buckets evenly: so check 64 distinct).
    let mem = Arena.create(4096);
    let seen = mem.alloc::<int>(64);
    for i in 0..64 { seen[i] = 0; }
    for i in 0..1000 { seen[int(hashOf(i) & u64(63))] = 1; }
    let n = 0;
    for i in 0..64 { n += seen[i]; }
    ok(n > 50, "low bits spread");
    ok(hashOf(P { x: 1, y: 2 }) != hashOf(P { x: 2, y: 1 }), "combine is ordered");
    let xs = mem.alloc::<int>(4);
    xs[0] = 7; xs[1] = 8; xs[2] = 9; xs[3] = 8;
    ok(indexOf(xs, 8) == 1 && indexOf(xs, 5) == -1 && contains(xs, 9), "indexOf");
    let ps = mem.alloc::<P>(2);
    ps[0] = P { x: 1, y: 1 };
    ps[1] = P { x: 2, y: 2 };
    ok(contains(ps, P { x: 2, y: 2 }) && !contains(ps, P { x: 2, y: 3 }), "contains struct");
    ok(minOf(3, 2) == 2 && maxOf(3, 2) == 3 && maxOf(1.5, 2.5) == 2.5, "min max");
    ok(maxOf(P { x: 1, y: 0 }, P { x: 5, y: 0 }).x == 5, "max struct");
    printLn("cmp_test ok");
}
