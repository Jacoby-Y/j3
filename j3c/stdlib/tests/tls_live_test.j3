// Live tests for j3.net.tls and https in j3.net.http: needs the internet and libssl.so.3.
// Not part of an offline run. From the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/tls_live_test.j3
// Panics on the first failed check.

module tls_live_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.net.http;
use j3.net.tls;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// The request must fail with a TLS error; print OpenSSL's reason.
fn refused(url: string, a: &Arena) {
    let req = http.get(url, a);
    req.timeoutMs = 15000;
    match http.request(&req, a) {
        Result.Ok(_) { ok(false, `{url} was trusted`); }
        Result.Err(e) {
            let t = Text.new(a);
            tls.lastError(&t);
            printLn(`  {url}: {http.errorName(e)} ({t.str()})`);
            ok(eq(http.errorName(e), "tls"), url);
        }
    }
}

fn main() {
    let a = Arena.create(8388608);

    let req = http.get("https://example.com/", &a);
    req.timeoutMs = 15000;
    match http.request(&req, &a) {
        Result.Ok(r) { ok(r.status == 200 && r.body.len > 100, "https GET"); }
        Result.Err(e) { ok(false, `https GET: {http.errorName(e)}`); }
    }

    refused("https://expired.badssl.com/", &a);
    refused("https://wrong.host.badssl.com/", &a);
    refused("https://self-signed.badssl.com/", &a);
    refused("https://untrusted-root.badssl.com/", &a);

    printLn(`tls_live_test: {CHECKS} checks ok`);
}
