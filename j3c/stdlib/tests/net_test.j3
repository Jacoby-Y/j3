// Tests for j3.net.tcp, j3.net.dns, and j3.net.http against a loopback server on a thread
// (no internet needed). Linux. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/net_test.j3
// TLS against real hosts is tls_live_test.j3. Panics on the first failed check.

module net_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.net.dns;
use j3.net.http;
use j3.net.http.{ Header, Request, Response };
use j3.net.tcp;
use j3.net.tcp.{ Conn, Listener, TcpError };
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;
use j3.thread.{ Thread, join, spawn };

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn has(s: string, part: string): bool {
    if part.len > s.len {
        return false;
    }
    for i in 0..s.len - part.len + 1 {
        if eq(s[i..i + part.len], part) {
            return true;
        }
    }
    return false;
}

/// Replies the server sends, one per connection, and the requests it saw.
struct Server {
    ls: Listener;
    replies: []string;
    seen: List<string>;
    mem: &Arena;
}

#[singleton]
#[thread]
let BUF: [4096]u8;

fn scratchBuf(): []u8 {
    return BUF[:];
}

/// Read one request (headers plus a `Content-Length` body), or until the client closes.
fn readRequest(c: &Conn, t: &Text) {
    let buf = scratchBuf();
    let want = -1;
    while true {
        let n = c.read(buf);
        if n <= 0 {
            return;
        }
        t.pushBytes(buf[0..n]);
        let s = t.str();
        if want < 0 {
            for i in 0..s.len - 3 {
                if s[i] == 13 && s[i + 1] == 10 && s[i + 2] == 13 && s[i + 3] == 10 {
                    want = i + 4 + contentLength(s[0..i]);
                    break;
                }
            }
        }
        if want >= 0 && s.len >= want {
            return;
        }
    }
}

fn contentLength(head: string): int {
    let key = "Content-Length: ";
    for i in 0..head.len - key.len {
        if eq(head[i..i + key.len], key) {
            let n = 0;
            let k = i + key.len;
            while k < head.len && head[k] >= 48 && head[k] <= 57 {
                n = n * 10 + int(head[k]) - 48;
                k += 1;
            }
            return n;
        }
    }
    return 0;
}

fn serve(arg: ptr) {
    let s = arg as &Server;
    for i in 0..s.replies.len {
        match s.ls.accept() {
            Result.Ok(c) {
                let t = Text.new(s.mem);
                readRequest(&c, &t);
                s.seen.push(t.str());
                let r = s.replies[i];
                if r.len == 0 {
                    // say nothing: wait for the client to give up and close
                    c.setTimeout(5000);
                    let one: [1]u8 = [0];
                    c.read(one[:]);
                } else {
                    c.writeAll(r as []u8);
                }
                c.close();
            }
            Result.Err(_) { return; }
        }
    }
}

fn url(port: int, path: string, a: &Arena): string {
    let t = Text.new(a);
    t.pushStr("http://127.0.0.1:");
    t.pushInt(port);
    t.pushStr(path);
    return t.str();
}

fn fetch(req: &Request, a: &Arena): Response {
    match http.request(req, a) {
        Result.Ok(r) { return r; }
        Result.Err(e) { panic(`request failed: {http.errorName(e)}`); }
    }
    return Response { status: 0, headers: List<Header>.new(a), body: "" as []u8 };
}

fn main() {
    let a = Arena.create(4194304);

    // URLs
    match http.parseUrl("https://Example.com:8443/a/b?q=1#frag") {
        Result.Ok(u) { ok(u.https && eq(u.host, "Example.com") && u.port == 8443 && eq(u.path, "/a/b?q=1"), "parseUrl full"); }
        Result.Err(_) { ok(false, "parseUrl full"); }
    }
    match http.parseUrl("http://[::1]/") {
        Result.Ok(u) { ok(!u.https && eq(u.host, "::1") && u.port == 80, "parseUrl v6"); }
        Result.Err(_) { ok(false, "parseUrl v6"); }
    }
    match http.parseUrl("https://h.io") {
        Result.Ok(u) { ok(eq(u.path, "/") && u.port == 443, "parseUrl bare host"); }
        Result.Err(_) { ok(false, "parseUrl bare host"); }
    }
    let badUrls: [5]string = ["ftp://x", "http://", "http://h:0/", "http://h:99999/", "http://[::1"];
    for b in badUrls {
        match http.parseUrl(b) {
            Result.Ok(_) { ok(false, `accepted {b}`); }
            Result.Err(_) { ok(true, b); }
        }
    }

    // DNS
    match dns.resolve("localhost", 80, &a) {
        Result.Ok(eps) { ok(eps.len >= 1, "localhost resolves"); }
        Result.Err(_) { ok(false, "localhost resolves"); }
    }
    match dns.resolve("no-such-host.invalid", 80, &a) {
        Result.Ok(_) { ok(false, ".invalid resolved"); }
        Result.Err(_) { ok(true, ".invalid fails"); }
    }

    // a closed port refuses
    let probe = Listener {};
    match tcp.listen(0) {
        Result.Ok(l) { probe = l; }
        Result.Err(_) { panic("listen"); }
    }
    let freePort = probe.port;
    probe.close();
    match tcp.dial("127.0.0.1", freePort, 2000, &a) {
        Result.Ok(_) { ok(false, "dial a closed port"); }
        Result.Err(e) {
            match e {
                TcpError.Refused { ok(true, "refused"); }
                TcpError.Resolve { ok(false, "refused: Resolve"); }
                TcpError.Timeout { ok(false, "refused: Timeout"); }
                TcpError.Fail { ok(false, "refused: Fail"); }
            }
        }
    }

    // HTTP against the loopback server
    let replies: [8]string = [
        "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nX-Thing:  spaced  \r\n\r\nhello",
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5;ext=1\r\nhello\r\n6\r\n world\r\n0\r\nTrailer: x\r\n\r\n",
        "HTTP/1.1 302 Found\r\nLocation: /next\r\nContent-Length: 0\r\n\r\n",
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok",
        "HTTP/1.0 200 OK\r\n\r\nuntil close",
        "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 201 Created\r\nTransfer-Encoding: chunked\r\n\r\n8\r\ndata: a\n\r\nA\r\n\ndata: b\r\n\r\n0\r\n\r\n",
        "",
        "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nshort",
    ];
    // the server thread gets its own arena: an Arena is not shared between threads
    let srvMem = Arena.create(1048576);
    let srv = Server { ls: Listener {}, replies: replies[:], seen: List<string>.new(&srvMem), mem: &srvMem };
    match tcp.listen(0) {
        Result.Ok(l) { srv.ls = l; }
        Result.Err(_) { panic("listen"); }
    }
    let port = srv.ls.port;
    let th = Thread { f: serve };
    spawn(&th, "server", serve, &srv as ptr);

    // 1: Content-Length, header trimming, request shape
    let r1 = http.post(url(port, "/one?x=1", &a), "{\"a\":1}", &a);
    r1.header("Content-Type", "application/json");
    r1.header("Authorization", "Bearer secret");
    let res1 = fetch(&r1, &a);
    ok(res1.status == 200 && eq(res1.bodyStr(), "hello"), "content-length body");
    ok(eq(res1.header("x-thing"), "spaced"), "header lookup ignores case and trims");

    // 2: chunked with an extension and a trailer
    let r2 = http.get(url(port, "/two", &a), &a);
    let res2 = fetch(&r2, &a);
    ok(eq(res2.bodyStr(), "hello world"), "chunked body");

    // 3 + 4: a redirect on the same host keeps the auth header
    let r3 = http.get(url(port, "/three", &a), &a);
    r3.header("Authorization", "Bearer keep");
    let res3 = fetch(&r3, &a);
    ok(res3.status == 200 && eq(res3.bodyStr(), "ok"), "redirect followed");

    // 5: body ends when the server closes
    let r5 = http.get(url(port, "/five", &a), &a);
    ok(eq(fetch(&r5, &a).bodyStr(), "until close"), "close-delimited body");

    // 6: a 1xx is skipped; lines stream out of a chunked body even across chunk edges
    let r6 = http.get(url(port, "/six", &a), &a);
    match http.open(&r6, &a) {
        Result.Ok(s) {
            ok(s.status == 201, "1xx skipped");
            let line = Text.new(&a);
            let lines = List<string>.new(&a);
            while s.readLine(&line) {
                let keep = Text.new(&a);
                keep.pushStr(line.str());
                lines.push(keep.str());
            }
            s.close();
            ok(lines.len == 3, "three lines");
            ok(eq(lines.items[0], "data: a") && eq(lines.items[1], "") && eq(lines.items[2], "data: b"), "SSE lines");
        }
        Result.Err(e) { ok(false, `open: {http.errorName(e)}`); }
    }

    // 7: the server never answers
    let r7 = http.get(url(port, "/seven", &a), &a);
    r7.timeoutMs = 300;
    match http.request(&r7, &a) {
        Result.Ok(_) { ok(false, "silent server answered"); }
        Result.Err(e) { ok(eq(http.errorName(e), "timeout"), `timeout: got {http.errorName(e)}`); }
    }

    // 8: the body is cut short
    let r8 = http.get(url(port, "/eight", &a), &a);
    match http.request(&r8, &a) {
        Result.Ok(_) { ok(false, "short body accepted"); }
        Result.Err(_) { ok(true, "short body"); }
    }

    join(&th);
    srv.ls.close();

    let seen = srv.seen;
    ok(seen.len == 8, "server saw eight requests");
    let q1 = seen.items[0];
    ok(has(q1, "POST /one?x=1 HTTP/1.1\r\n"), "request line");
    ok(has(q1, "Host: 127.0.0.1:"), "host with port");
    ok(has(q1, "Content-Length: 7\r\n"), "content length");
    ok(has(q1, "Authorization: Bearer secret\r\n"), "custom header");
    ok(has(q1, "Connection: close\r\n"), "connection close");
    ok(has(q1, "\r\n\r\n{\"a\":1}"), "body sent");
    ok(has(seen.items[3], "GET /next HTTP/1.1"), "redirect path");
    ok(has(seen.items[3], "Authorization: Bearer keep"), "same-host redirect keeps auth");

    let inj = http.get(url(port, "/x", &a), &a);
    inj.header("X-Evil", "a\r\nInjected: 1");
    match http.request(&inj, &a) {
        Result.Ok(_) { ok(false, "header injection sent"); }
        Result.Err(e) { ok(eq(http.errorName(e), "bad request"), "header injection refused"); }
    }

    printLn(`net_test: {CHECKS} checks ok`);
}
