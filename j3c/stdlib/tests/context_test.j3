// Windowless interaction fixture for plan 023/3c. SDL_ttf only; run with offscreen/dummy.
module context_test;
use j3.memory.Arena;
use j3.io.printLn;
use j3.sys.panic;
use j3.math.Vec2;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton] let OPEN: bool;
#[singleton] let CARD: bool;
#[singleton] let OWNER: int;
#[singleton] let MENU: int;
#[singleton] let ITEM: [5]int;
#[singleton] let NESTED: int;
#[singleton] let FIELD: int;
#[singleton] let SIBSELECT: int;
#[singleton] let SELECT: int;
#[singleton] let HOVER: int;
#[singleton] let BOX: int;
#[singleton] let BUTTON: int;
#[singleton] let SHOW: bool;
#[singleton] let MODAL: bool;
#[singleton] let CLICKS: int;
#[singleton] let REQUESTS: int;
#[singleton] let CHECKS: int;
fn ok(b: bool, msg: string) { CHECKS += 1; if !b { panic(msg); } }
fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 400.0, y: 300.0 }); inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    OWNER = d.open(0, d.tag("div"), 1); d.cls(OWNER, "owner"); d.attrTabIndex(OWNER);
    if d.contextAt(OWNER) { OPEN = true; REQUESTS += 1; }
    if d.clicked(OWNER) { CLICKS += 1; }
    if OPEN {
        MENU = d.open(0, d.tag("div"), 1); d.cls(MENU, "menu"); d.attrContext(MENU);
        if d.closeRequested(MENU) { OPEN = false; }
        for i in 0..5 {
            ITEM[i] = d.open(i, d.tag("button"), 1);
            if i == 0 { d.text("Apple"); }
            else if i == 1 { d.text("Apricot"); }
            else if i == 2 { d.text("Banana"); d.attrDisabled(ITEM[i], true); }
            else if i == 3 { d.text("Blueberry"); }
            else { d.text("Éclair"); }
            d.close();
        }
        let hidden = d.open(6, d.tag("button"), 1); d.cls(hidden, "hidden"); d.text("Blackberry"); d.close();
        let sub = d.open(7, d.tag("div"), 1); d.cls(sub, "sub");
        NESTED = d.open(0, d.tag("button"), 1); d.text("Blackberry"); d.close(); d.close();
        FIELD = d.open(8, d.tag("input"), 1); d.attrType(FIELD, "text"); d.close();
        SELECT = d.open(9, d.tag("select"), 1);
        let opt = d.open(0, d.tag("option"), 1); d.text("One"); d.close();
        let opt2 = d.open(1, d.tag("option"), 1); d.text("Two"); d.close(); d.close();
        d.close();
    }
    if OPEN {
        SIBSELECT = d.open(1, d.tag("select"), 1);
        let siblingOpt = d.open(0, d.tag("option"), 1); d.text("Blue choice"); d.close(); d.close();
    }
    d.close();
    if SHOW {
        HOVER = d.open(1, d.tag("div"), 1); d.cls(HOVER, "owner"); d.cls(HOVER, "hover"); d.attrTitle(HOVER, "ordinary title");
        CARD = d.hoverCard(HOVER);
        if CARD {
            BOX = d.open(0, d.tag("div"), 1); d.cls(BOX, "card"); d.attrOverlay(BOX, dom.OV_POPOVER);
            d.text("Custom content");
            BUTTON = d.open(0, d.tag("button"), 1); d.text("Focusable"); d.close(); d.close();
        }
        d.close();
    }
    if MODAL {
        let modal = d.open(2, d.tag("dialog"), 1); d.attrOverlay(modal, dom.OV_MODAL); d.close();
    }
    d.close(); d.layout(); d.endFrame();
}
fn step(d: &Dom, n: int) { for i in 0..n { frame(d); } }
fn key(d: &Dom, text: string, names: string) { d.simKeys(text, names); frame(d); frame(d); }
// Owner and programmatic popup can mount together before any geometry exists.
fn mountFrameAt(d: &Dom, show: bool, request: bool, w: f32, h: f32): int {
    d.beginFrame(Vec2 { x: w, y: h }); inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let menu = -1;
    if show {
        let owner = d.open(0, d.tag("div"), 1); d.cls(owner, "owner");
        if request { d.ctxNode = owner; d.ctxX = 380.0; d.ctxY = 280.0; }
        menu = d.open(0, d.tag("div"), 1); d.cls(menu, "menu"); d.attrContext(menu);
        d.close(); d.close();
    }
    d.close(); d.layout(); d.endFrame(); return menu;
}
fn mountFrame(d: &Dom, show: bool, request: bool): int { return mountFrameAt(d, show, request, 400.0, 300.0); }
fn testInitialAnchor(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; } .menu { width: 120px; height: 150px; }", "mount.css", 1);
    let d = Dom.new(mem, &css); d.setFrameMs(16.0); d.simInput(-5.0, -5.0, false, 0.0);
    let menu = mountFrame(&d, true, false);
    ok(d.nodes.items[menu].atx == 300.0 && d.nodes.items[menu].aty == 290.0, "first-render fallback uses laid-out owner geometry");
    ok(d.absX(menu) == 280.0 && d.absY(menu) == 150.0, "first-render fallback clamps in same layout");
    mountFrameAt(&d, true, false, 320.0, 240.0);
    ok(d.nodes.items[menu].atx == 300.0 && d.absX(menu) == 200.0 && d.absY(menu) == 90.0, "resize preserves captured anchor and reclamps popup");
    mountFrame(&d, false, false);
    let mounted = mountFrame(&d, true, false);
    ok(d.nodes.items[mounted].atx == 300.0 && d.nodes.items[mounted].aty == 290.0, "new conditional owner resolves fallback on mount");
    mountFrame(&d, false, false);
    let pointed = mountFrame(&d, true, true);
    ok(d.nodes.items[pointed].atx == 380.0 && d.nodes.items[pointed].aty == 280.0, "current request wins over fallback on first layout");
    mountFrame(&d, true, false);
    ok(d.nodes.items[pointed].atx == 380.0 && !d.nodes.items[pointed].ctxPending, "later frames cannot reapply fallback over captured request");
    mountFrame(&d, false, false); ok(d.ovs.len == 0, "anchored owner removal drops overlay");
}
fn main() {
    let mem = Arena.create(64 * 1024 * 1024); testInitialAnchor(&mem); let css = Css.new(&mem);
    parse(&css, ".owner { position: absolute; left: 300px; top: 240px; width: 90px; height: 50px; } .hover { left: 20px; top: 20px; } .menu { width: 120px; height: 150px; } .card { left: 20px; top: 76px; width: 180px; height: 90px; } .hidden { display: none; } button { display: block; width: 100px; height: 24px; }", "context.css", 1);
    let d = Dom.new(&mem, &css); d.setFrameMs(16.0); SHOW = true;
    d.simInput(380.0, 280.0, false, 0.0); frame(&d); d.focusNode(OWNER);
    d.simRight(true); step(&d, 3); d.simRight(false); frame(&d);
    ok(REQUESTS == 1 && OPEN, "right click dispatches request once");
    ok(d.nodes.items[MENU].atx == 380.0 && d.nodes.items[MENU].aty == 280.0, "anchor captures pointer");
    ok(d.absX(MENU) == 280.0 && d.absY(MENU) == 150.0, "pointer popup clamps to viewport");
    ok(d.focus == ITEM[0], "context popup takes first focus");
    key(&d, "a", ""); ok(d.focus == ITEM[1], "prefix starts from first matching entry with wrap");
    key(&d, "a", ""); ok(d.focus == ITEM[0], "repeated ASCII cycles");
    step(&d, 65); key(&d, "b", ""); ok(d.focus == ITEM[3], "prefix skips disabled, hidden and other submenu levels");
    step(&d, 65); key(&d, "É", ""); ok(d.focus == ITEM[4], "UTF8 prefix compares exact bytes");
    key(&d, "ÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉÉ", ""); ok(d.focus == ITEM[4], "oversized UTF8 prefix is ignored without partial bytes");
    d.simKeys("", "Down"); d.simK.comp = "é"; frame(&d); frame(&d);
    ok(d.focus == ITEM[4], "IME composition keeps menu arrows from changing focus");
    d.focusNode(NESTED); key(&d, "b", ""); ok(d.focus == NESTED, "prefix is scoped to submenu level");
    d.focusNode(OWNER); key(&d, "b", ""); ok(d.focus == ITEM[3], "typing from trigger enters menu with reset prefix");
    d.focusNode(SIBSELECT); key(&d, "b", ""); ok(d.focus == SIBSELECT, "sibling select keeps typing instead of entering menu");
    key(&d, "", "Down"); ok(d.focus == SIBSELECT, "sibling select keeps arrows instead of entering menu");
    d.focusNode(FIELD); key(&d, "hello", ""); ok(d.strValue(FIELD).len == 5, "menu textbox keeps typed input");
    key(&d, "", "Down"); ok(d.focus == FIELD, "textbox retains arrows");
    d.focusNode(SELECT); key(&d, "", "Down"); ok(d.focus == SELECT, "select retains arrows");
    d.focusNode(ITEM[4]);
    key(&d, "", "Home"); ok(d.focus == ITEM[0], "Home navigates context menu");
    key(&d, "", "Escape"); frame(&d); ok(!OPEN && d.focus == OWNER, "Escape restores context owner focus");
    key(&d, "", "F10"); ok(!OPEN && REQUESTS == 1 && CLICKS == 0, "bare F10 and held right button do not synthesize a context request or click");
    key(&d, "", "S+F10"); ok(OPEN && REQUESTS == 2, "keyboard context request dispatches same handler");
    key(&d, "É", ""); ok(d.focus == ITEM[4], "closing and reopening clears prefix");
    ok(d.nodes.items[MENU].atx == 300.0 && d.nodes.items[MENU].aty == 290.0, "keyboard anchor is owner bottom");
    key(&d, "", "Escape"); frame(&d);
    d.simRight(true); frame(&d); d.simRight(false); frame(&d);
    ok(OPEN, "reopen by pointer after keyboard close");
    d.simInput(350.0, 260.0, false, 0.0); d.simRight(true); frame(&d); d.simRight(false); frame(&d);
    ok(OPEN && d.nodes.items[MENU].atx == 350.0, "second context request reanchors without outside-close race");
    d.simInput(8.0, 180.0, true, 0.0); frame(&d); d.simInput(8.0, 180.0, false, 0.0); step(&d, 2);
    ok(!OPEN, "outside press closes context popover");
    d.simInput(350.0, 250.0, true, 0.0); frame(&d); d.simInput(350.0, 250.0, false, 0.0); frame(&d);
    ok(CLICKS == 1 && !OPEN, "normal left click remains independent of context dispatch");
    OPEN = true; frame(&d); frame(&d);
    ok(d.ctxNode < 0 && d.nodes.items[MENU].atx == 300.0 && d.nodes.items[MENU].aty == 290.0, "fresh programmatic reopen cannot reuse old context coordinates");
    key(&d, "", "Escape"); frame(&d);
    d.focusNode(OWNER);
    d.simInput(30.0, 30.0, false, 0.0); frame(&d); step(&d, 20); ok(!CARD, "hover card waits delay");
    step(&d, 20); ok(CARD && d.focus == OWNER, "delayed markup opens without stealing focus");
    step(&d, 2); ok(d.ttRoot < 0, "shown custom card suppresses owner's title");
    d.simInput(30.0, 72.0, false, 0.0); step(&d, 8); ok(CARD, "crossing gap has grace");
    d.simInput(30.0, 90.0, false, 0.0); step(&d, 25); ok(CARD, "pointer inside card keeps it open");
    d.focusNode(BUTTON); d.simInput(250.0, 100.0, false, 0.0); step(&d, 30); ok(CARD, "keyboard focus inside retains card");
    key(&d, "", "Escape"); frame(&d); ok(!CARD, "Escape closes custom card");
    d.simInput(30.0, 30.0, false, 0.0); step(&d, 40); ok(CARD, "returning opens card again");
    key(&d, "", "Escape"); step(&d, 40); ok(!CARD, "Escape while over owner suppresses immediate reopen");
    d.simInput(250.0, 100.0, false, 0.0); step(&d, 21); d.simInput(30.0, 30.0, false, 0.0); step(&d, 40);
    MODAL = true; step(&d, 3); ok(!CARD, "modal filters custom tooltip owner"); MODAL = false; frame(&d);
    d.simInput(250.0, 100.0, false, 0.0); step(&d, 30); d.simInput(30.0, 30.0, false, 0.0); step(&d, 40);
    for warm in 0..3 {
        d.simInput(250.0, 100.0, false, 0.0); step(&d, 21);
        d.simInput(30.0, 30.0, false, 0.0); step(&d, 34);
    }
    let replayStart = mem.used;
    for replay in 0..3 {
        d.simInput(250.0, 100.0, false, 0.0); step(&d, 21);
        d.simInput(30.0, 30.0, false, 0.0); step(&d, 34);
    }
    ok(mem.used == replayStart, "warmup replay is flat before long reopen loop");
    let used = mem.used; let laid = d.laid; let styled = d.restyled;
    step(&d, 100); ok(mem.used == used && d.laid == laid && d.restyled == styled, "steady custom tooltip costs 0/0/0");
    for j in 0..1000 {
        d.simInput(250.0, 100.0, false, 0.0); step(&d, 21);
        d.simInput(30.0, 30.0, false, 0.0); step(&d, 34);
    }
    printLn(`reopen arena growth: {mem.used - used}`);
    ok(mem.used == used, "1000 custom card reopens allocate nothing after warmup");
    SHOW = false; step(&d, 2); ok(d.ovs.len == 0, "owner removal removes hover card stack entry");
    SHOW = true; frame(&d); ok(!CARD, "recycled owner starts with fresh hover delay");
    step(&d, 20); ok(!CARD, "recycled owner cannot inherit previous open state");
    printLn(`context_test ok, checks passed: {CHECKS}`);
}
