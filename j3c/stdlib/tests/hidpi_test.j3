// 2D scale checks under `J3_UI_SCALE=2` (the same path as a high-DPI drawable): logical `windowSize`,
// physical `drawSize`, and a paint rect landing on twice the pixels. Never opens a visible window:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_UI_SCALE=2 timeout 60 j3c run j3c/stdlib/tests/hidpi_test.j3
// Without J3_UI_SCALE it checks the unscaled values instead.
module hidpi_test;

use j3.game;
use j3.game.Color;
use j3.gfx.paint;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;

fn ok(b: bool, msg: string) {
    if !b {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn main() {
    let mem = Arena.create(4 * 1024 * 1024);
    game.initGlHidden("hidpi checks", 400, 300);
    let k: f32 = 1.0;
    if same(game.env("J3_UI_SCALE"), "2") {
        k = 2.0;
    }
    ok(game.dpiScale() == k, "dpiScale follows J3_UI_SCALE");
    let ws = game.windowSize();
    ok(ws.x == 400.0 / k && ws.y == 300.0 / k, "windowSize is logical");
    let ds = game.drawSize();
    ok(ds.x == 400.0 && ds.y == 300.0, "drawSize is physical");
    let ui = game.uiSize();
    ok(ui.x == ws.x, "uiSize follows windowSize");
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    paint.rect(Vec2 { x: 0, y: 0 }, Vec2 { x: 100, y: 75 }, Color { r: 255, g: 255, b: 255, a: 255 });
    paint.flush();
    let px = mem.alloc::<u8>(400 * 300 * 4);
    ok(game.readWindow(px), "read the frame");
    let edgeX = int(100.0 * k);
    let edgeY = int(75.0 * k);
    ok(px[((edgeY - 1) * 400 + edgeX - 1) * 4] > 200, "the rect fills up to its scaled corner");
    ok(px[((edgeY + 1) * 400 + edgeX + 1) * 4] < 20, "and stops there");
    // color emoji: the strike is scaled to the font size on the HiDPI twin too (ink spans about 16 logical px, not 109)
    let ef = game.tryLoadFont("/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf", 16);
    if ef.raw == 0 {
        printLn("hidpi emoji: SKIPPED (no Noto Color Emoji)");
    } else {
        game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
        game.p2Text(ef, Vec2 { x: 20, y: 20 }, "🥳", Color { r: 255, g: 255, b: 255, a: 255 }, 1.0);
        paint.flush();
        ok(game.readWindow(px), "read the emoji frame");
        let x0 = 400;
        let x1 = 0;
        for y in 0..300 {
            for x in 0..400 {
                if int(px[(y * 400 + x) * 4]) + int(px[(y * 400 + x) * 4 + 1]) + int(px[(y * 400 + x) * 4 + 2]) > 60 {
                    if x < x0 { x0 = x; }
                    if x > x1 { x1 = x; }
                }
            }
        }
        let span = f32(x1 - x0 + 1);
        ok(x1 >= x0 && span >= 10.0 * k && span <= 24.0 * k, "emoji ink spans about the font size at this scale");
    }
    printLn("hidpi_test ok");
}
