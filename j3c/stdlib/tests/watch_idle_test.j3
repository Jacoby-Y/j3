// A watched file changing wakes a sleeping idle loop (`game.idleWait`) before its 250 ms safety tick. Same loop order as
// `App.run`. Never opens a visible window; idle skip must be forced on, since offscreen turns it off:
//   J3_IDLE_SKIP=1 SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/watch_idle_test.j3

module watch_idle_test;

use j3.game;
use j3.io;
use j3.io.printLn;
use j3.io.watch.{ Event, Watcher };
use j3.memory.{ List, newArena };
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.thread;
use j3.thread.Thread;

const F = "/tmp/j3_watch_idle_test.txt";

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// Write the file once the main thread is asleep.
fn writer(p: ptr) {
    game.delayMs(60);
    io.writeFile(F, "changed" as []u8);
}

/// One loop turn after a Dom frame said nothing is due; how long it slept, in ms.
fn frame(): int {
    game.idleReport(game.IDLE_FOREVER);
    let t0 = sys.monotonicMs();
    ok(game.idleWait(), "slept");
    game.poll();
    return sys.monotonicMs() - t0;
}

fn main() {
    let a = newArena(1048576);
    io.writeFile(F, "start" as []u8);
    game.initGlHidden("watch idle checks", 200, 100);
    ok(game.idleSkipAllowed(), "run with J3_IDLE_SKIP=1");
    game.poll();
    let w = Watcher.create(&a);
    match w.add(F) {
        Result.Ok(_) { }
        Result.Err(_) { ok(false, "add"); }
    }
    let evs = List<Event>.new(&a);
    // settle: window events from startup end the first sleeps
    for i in 0..3 { frame(); }
    ok(frame() >= 200, "nothing changed: sleeps to the safety tick");

    let t = Thread { f: writer };
    thread.spawn(&t, "writer", writer, 0 as ptr);
    let slept = frame();
    thread.join(&t);
    ok(slept < 200, `woke on the change ({slept} ms)`);
    ok(w.poll(&evs) >= 1, "the change is there");
    w.close();
    io.remove(F);
    printLn("watch_idle_test ok");
}
