// Tests for j3.gfx.glsl.prep (GLSL source prep for OpenGL ES; no GL). Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/glsl_test.j3
// Panics on the first failed check.

module glsl_test;

use j3.gfx.glsl;
use j3.io.printLn;
use j3.sys.panic;
use j3.text.{ contains, find, same };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// Number of newline bytes in `s`.
fn lines(s: string): int {
    let n = 0;
    for i in 0..s.len {
        if s[i] == 10 { n += 1; }
    }
    return n;
}

fn main() {
    let plain = "#version 330 core\nin vec2 vUv;\nout vec4 oColor;\nuniform sampler2D uTex;\nvoid main(){ oColor = texture(uTex, vUv); }\n";

    // Desktop: the very same string back (same pointer, same length).
    let d = glsl.prep(plain, false);
    ok(d.ptr == plain.ptr && d.len == plain.len, "desktop returns the input unchanged");

    // ES: version swapped, precision added, rest kept.
    let e = glsl.prep(plain, true);
    ok(find(e, "#version 300 es\n") == 0, "starts with #version 300 es");
    ok(!contains(e, "330"), "no 330 left");
    ok(contains(e, "precision highp float;"), "float precision");
    ok(contains(e, "precision highp int;"), "int precision");
    ok(contains(e, "precision highp sampler2D;"), "sampler2D precision when used");
    ok(!contains(e, "sampler3D"), "no sampler3D precision when unused");
    ok(contains(e, "void main(){ oColor = texture(uTex, vUv); }"), "body kept");
    ok(find(e, "precision highp float;") < find(e, "in vec2 vUv;"), "precision before declarations");
    ok(lines(e) == lines(plain), "line count unchanged, so driver log lines match the source");

    // Directive lines (#extension, #define) stay ahead of the precision statements.
    let ext = "#version 330 core\n#extension GL_OES_standard_derivatives : enable\n#define TRACE_LEVEL 2\nuniform sampler2DShadow uShadow;\nvoid main(){}\n";
    let x = glsl.prep(ext, true);
    ok(find(x, "#extension") < find(x, "precision highp float;"), "precision after #extension");
    ok(find(x, "#define TRACE_LEVEL 2") < find(x, "precision highp float;"), "precision after #define");
    ok(contains(x, "precision highp sampler2DShadow;"), "shadow sampler precision");
    ok(lines(x) == lines(ext), "line count unchanged with directives");

    // No #version line: ES gets one (GLSL ES 1.00 would be assumed otherwise), desktop is untouched.
    let bare = "void main(){}\n";
    ok(glsl.prep(bare, false).ptr == bare.ptr, "desktop leaves a version-less source alone");
    let b = glsl.prep(bare, true);
    ok(find(b, "#version 300 es\n") == 0, "version-less source gets #version 300 es");
    ok(contains(b, "void main(){}"), "version-less body kept");

    // A source that is only a version line still works.
    let only = glsl.prep("#version 330 core", true);
    ok(find(only, "#version 300 es\n") == 0 && contains(only, "precision highp float;"), "version-only source");

    // A leading conditional: precision goes above the #ifdef, not inside it.
    let cond = "#version 330 core\n#ifdef FOO\nuniform float a;\n#endif\nvoid main(){}\n";
    let c = glsl.prep(cond, true);
    ok(find(c, "precision highp float;") < find(c, "#ifdef FOO"), "precision before a leading #ifdef");
    ok(lines(c) == lines(cond), "line count unchanged with #ifdef");

    // Comment and blank lines before #extension do not count as code.
    let com = "#version 330 core\n// note\n#extension GL_X : enable\nvoid main(){}\n";
    let m = glsl.prep(com, true);
    ok(find(m, "#extension") < find(m, "precision highp float;"), "precision after comment then #extension");
    ok(lines(m) == lines(com), "line count unchanged with comment");
    let blank = "#version 330 core\n\n#extension GL_X : enable\nvoid main(){}\n";
    let k = glsl.prep(blank, true);
    ok(find(k, "#extension") < find(k, "precision highp float;"), "precision after blank then #extension");
    ok(lines(k) == lines(blank), "line count unchanged with blank line");
    let lead = glsl.prep("// header\n#version 330 core\nvoid main(){}\n", true);
    ok(find(lead, "#version 300 es") > 0 && !contains(lead, "330") && !contains(lead, "#version 300 es\n#version"), "comment before #version");

    printLn("glsl_test ok");
}
