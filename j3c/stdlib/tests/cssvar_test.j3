// Tests for `var()` inside compound values (gradient stops, shadows, color-mix, border shorthands): a theme flip via a
// class on the root restyles once and is then steady, siblings under different --accent differ, and a gradient
// transition blends stops that came from var(). Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/cssvar_test.j3 --headless

module cssvar_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.{ Css, MatchNode, P_BG_IMAGE, P_BOX_SHADOW, P_BACKGROUND, V_URL };
use j3.text.same;
use j3.ui.cssmatch.computeStyle;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.motion;

#[singleton]
let THEME: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    ok(a > b - 1.0 && a < b + 1.0, msg);
}

const USHEET: string = ":root { --bg: url(a.png); } .night { --bg: url(sub/b.png); } .pic { width: 4px; height: 4px; background-image: var(--bg); } .pulse { width: 10px; height: 10px; animation: pulse 1s linear infinite; } @keyframes pulse { from { opacity: 0.2; } to { opacity: 1; } }";

fn uframe(d: &Dom): int {
    d.simInput(-5.0, -5.0, false, 0.0);
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    let root = d.open(0, d.tag("div"), 1);
    d.clsIf(root, "night", THEME == 2);
    let pic = d.open(0, d.tag("div"), 1);
    d.cls(pic, "pic");
    d.close();
    for i in 1..500 {
        let more = d.open(i, d.tag("div"), 1);
        d.cls(more, "pic");
        d.close();
    }
    let pl = d.open(500, d.tag("div"), 1);
    d.cls(pl, "pulse");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    return pic;
}

fn run2(d: &Dom, n: int) {
    for i in 0..n {
        uframe(d);
    }
}

const SHEET: string = ".t1 { --accent: #ff0000; --edge: #000000; } .t2 { --accent: #0000ff; --edge: #ffffff; } .card { width: 40px; height: 40px; background-image: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 50%, white) 80%); box-shadow: 0 2px 6px var(--edge); border: 2px solid var(--accent); transition: background-image 100ms linear; } .plain { width: 10px; height: 10px; }";

fn frame(d: &Dom): int {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    let root = d.open(0, d.tag("div"), 1);
    d.clsIf(root, "t1", THEME == 1);
    d.clsIf(root, "t2", THEME == 2);
    let card = d.open(0, d.tag("div"), 1);
    d.cls(card, "card");
    d.close();
    d.close();
    let other = d.open(1, d.tag("div"), 1);
    d.cls(other, "t2");
    let card2 = d.open(0, d.tag("div"), 1);
    d.cls(card2, "card");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    return card;
}

fn run(d: &Dom, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d);
    }
}

/// First stop (field f: 1 r, 2 g, 3 b) of the gradient of style `st`.
fn stop0(css: &Css, st: int, f: int): f32 {
    return css.paints.items[css.get(st, P_BG_IMAGE).i + 4 + f];
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "v.css", 1);
    ok(css.warns.len == 0, "sheet parses clean");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    THEME = 1;
    run(&d, 3);
    let card = frame(&d);
    let st = d.nodes.items[card].tstyle;
    near(stop0(&css, st, 1), 255.0, "theme 1: red first stop");
    near(stop0(&css, st, 3), 0.0, "theme 1: no blue");
    let rest = d.restyled;
    run(&d, 10);
    ok(d.restyled == rest, "steady frames do not restyle");

    THEME = 2;
    card = frame(&d);
    ok(d.restyled > rest, "the class flip restyles");
    st = d.nodes.items[card].tstyle;
    near(stop0(&css, st, 1), 0.0, "theme 2: first stop lost its red");
    near(stop0(&css, st, 3), 255.0, "theme 2: blue first stop");
    rest = d.restyled;
    let np = css.paints.len;
    run(&d, 20);
    ok(d.restyled == rest && css.paints.len == np, "steady after the flip: no restyle, no new paint data");
    THEME = 1;
    frame(&d);
    ok(d.restyled > rest, "flip back restyles");
    rest = d.restyled;
    THEME = 2;
    frame(&d);
    THEME = 1;
    frame(&d);
    np = css.paints.len;
    run(&d, 5);
    ok(css.paints.len == np, "back and forth reuses cached styles");

    // a game toggling dark mode: 200 flips allocate nothing after the first two builds
    THEME = 1;
    frame(&d);
    THEME = 2;
    frame(&d);
    let used = mem.used;
    np = css.paints.len;
    let nw = css.warns.len;
    for i in 0..200 {
        THEME = 1 + i % 2;
        frame(&d);
    }
    ok(mem.used == used && css.paints.len == np && css.warns.len == nw, "200 theme flips: arena, paint data and warnings stay flat");

    // two parents with different --accent give different gradients
    let c = Css.new(&mem);
    parse(&c, SHEET, "v2.css", 0);
    let nodes = mem.alloc::<MatchNode>(4);
    let cs = mem.alloc::<int>(1);
    cs[0] = c.intern("t1");
    nodes[0] = MatchNode { tag: c.intern("div"), classes: cs, parent: -1, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    let cs2 = mem.alloc::<int>(1);
    cs2[0] = c.intern("t2");
    nodes[1] = MatchNode { tag: c.intern("div"), classes: cs2, parent: -1, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    let cc = mem.alloc::<int>(1);
    cc[0] = c.intern("card");
    nodes[2] = MatchNode { tag: c.intern("div"), classes: cc, parent: 0, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    nodes[3] = MatchNode { tag: c.intern("div"), classes: cc, parent: 1, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    let s0 = computeStyle(&c, nodes, 0, -1);
    let s1 = computeStyle(&c, nodes, 1, -1);
    let a = computeStyle(&c, nodes, 2, s0);
    let b = computeStyle(&c, nodes, 3, s1);
    ok(a != b, "different --accent: different styles");
    near(stop0(&c, a, 1), 255.0, "card under t1 is red");
    near(stop0(&c, b, 3), 255.0, "card under t2 is blue");
    // the color-mix stop: 50% of the accent and white
    let g = c.get(a, P_BG_IMAGE).i;
    near(c.paints.items[g + 4 + 5 + 2], 128.0, "the second stop is color-mix of red and white");
    ok(c.paints.items[g + 4 + 5] > 0.79 && c.paints.items[g + 4 + 5] < 0.81, "second stop sits at 80%");

    // a gradient transition between the two blends the var()-built stops
    let m = motion.fresh();
    motion.onStyle(&m, &c, a, b, 0.0);
    ok(motion.active(&m), "gradient transition starts");
    motion.step(&m, &c, b, 50.0, 0.0);
    near(stop0(&c, m.ov, 1), 127.5, "red fades halfway");
    near(stop0(&c, m.ov, 3), 127.5, "blue rises halfway");

    // url() in a custom property: a class flip swaps the image; restyles are cached and textures load once per path
    let uc = Css.new(&mem);
    parse(&uc, USHEET, "theme.css", 0);
    ok(uc.warns.len == 0, "url() custom property sheet parses clean");
    let ud = Dom.new(&mem, &uc);
    ud.setFrameMs(16.0);
    THEME = 1;
    let pic = uframe(&ud);
    let ust = ud.nodes.items[pic].tstyle;
    ok(uc.get(ust, P_BG_IMAGE).kind == V_URL && same(uc.name(uc.get(ust, P_BG_IMAGE).i), "a.png"), "day: a.png");
    THEME = 2;
    pic = uframe(&ud);
    ust = ud.nodes.items[pic].tstyle;
    ok(uc.get(ust, P_BG_IMAGE).kind == V_URL && same(uc.name(uc.get(ust, P_BG_IMAGE).i), "sub/b.png"), "night: sub/b.png");
    let loads = ud.imgs.ents.len;
    let uused = mem.used;
    let unp = uc.paints.len;
    for i in 0..200 {
        THEME = 1 + i % 2;
        uframe(&ud);
    }
    ok(ud.imgs.ents.len == loads && ud.imgs.ents.len <= 2, "200 flips: no texture is loaded again");
    ok(mem.used == uused && uc.paints.len == unp, "200 flips: arena and paint data stay flat");
    // 500 nodes read --bg and a sibling animates opacity: frames neither restyle nor re-parse the deferred image
    let urest = ud.restyled;
    uused = mem.used;
    unp = uc.paints.len;
    let unw = uc.warns.len;
    run2(&ud, 60);
    ok(ud.restyled == urest && mem.used == uused && uc.paints.len == unp && uc.warns.len == unw, "an unrelated running animation does not re-substitute the var() images");
    printLn(`url flips: {ud.imgs.ents.len} textures (nothing paints in this test; golden 65 counts real loads)`);
    printLn("cssvar_test ok");
}
