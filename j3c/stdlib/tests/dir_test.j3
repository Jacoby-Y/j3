// Tests for j3.io directory and file-metadata calls. Linux. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/dir_test.j3
// Panics on the first failed check.

module dir_test;

use j3.io;
use j3.io.{ DirEntry, IoError, printLn };
use j3.memory.{ Arena, newArena };
use j3.result.Result;
use j3.proc;
use j3.sys;
use j3.sys.panic;
use j3.text.cstr;
use j3.thread;
use j3.thread.Thread;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

// ponytail: one wrapper per call; a stdlib `Result` passed to a local fn param does not unify yet
fn mk(p: string): bool {
    match io.makeDirs(p) { Result.Ok(_) { return true; } Result.Err(_) { return false; } }
}
fn mv(a: string, b: string): bool {
    match io.rename(a, b) { Result.Ok(_) { return true; } Result.Err(_) { return false; } }
}
fn rm(p: string): bool {
    match io.remove(p) { Result.Ok(_) { return true; } Result.Err(_) { return false; } }
}

fn list(path: string, a: &Arena): []DirEntry {
    match io.listDir(path, a) {
        Result.Ok(es) { return es; }
        Result.Err(_) { panic("listDir failed"); }
    }
    return a.alloc::<DirEntry>(0);
}

fn find(es: []DirEntry, name: string): int {
    for i in 0..es.len {
        if eq(es[i].name, name) {
            return i;
        }
    }
    return -1;
}

fn worker(arg: ptr) {
    let a = newArena(65536);
    let es = list("/tmp/j3_dir_test/x", &a);
    ok(find(es, "y") >= 0, "worker sees y");
}

fn sh(cmd: string, a: &Arena) {
    match proc.run(["/bin/sh", "-c", cmd], "", a) {
        Result.Ok(o) { ok(o.code == 0, cmd); }
        Result.Err(_) { ok(false, cmd); }
    }
}

fn st(follow: bool, path: string, out: []int): bool {
    let p = cstr(path) as ptr;
    out[3] = 7;
    let r = if follow { sys.statAt(sys.AT_FDCWD, p, out) } else { sys.lstatAt(sys.AT_FDCWD, p, out) };
    return r >= 0;
}

fn symlinks(a: &Arena) {
    sh("rm -rf /tmp/j3_dir_test/lt && mkdir -p /tmp/j3_dir_test/lt/d && cd /tmp/j3_dir_test/lt && printf 'hello\\n' > f && ln -s f lf && ln -s d ld && ln -s /no/such/target broken", a);
    let s: [4]int = [0, 0, 0, 0];
    ok(st(false, "/tmp/j3_dir_test/lt/lf", s[:]) && s[0] == 0 && s[1] == 1 && s[3] == 1, "lstat lf");
    ok(st(false, "/tmp/j3_dir_test/lt/ld", s[:]) && s[0] == 0 && s[1] == 1 && s[3] == 1, "lstat ld");
    ok(st(true, "/tmp/j3_dir_test/lt/ld", s[:]) && s[0] == 1 && s[3] == 0, "stat ld");
    ok(st(false, "/tmp/j3_dir_test/lt/broken", s[:]) && s[1] == 15 && s[3] == 1, "lstat broken");
    ok(!st(true, "/tmp/j3_dir_test/lt/broken", s[:]), "stat broken fails");
    ok(st(false, "/tmp/j3_dir_test/lt/f", s[:]) && s[0] == 0 && s[1] == 6 && s[3] == 0, "lstat f");
    ok(st(true, "/tmp/j3_dir_test/lt/f", s[:]) && s[0] == 0 && s[1] == 6 && s[3] == 0, "stat f");
    let three: [3]int = [0, 0, 0];
    ok(sys.lstatAt(sys.AT_FDCWD, cstr("/tmp/j3_dir_test/lt/lf") as ptr, three[:]) >= 0 && three[1] == 1, "3-slot lstat");

    let es = list("/tmp/j3_dir_test/lt", a);
    ok(es.len == 5, "five lt entries");
    ok(es[find(es, "lf")].isLink && es[find(es, "lf")].size == 6, "listDir lf");
    ok(es[find(es, "ld")].isLink && es[find(es, "ld")].isDir, "listDir ld");
    ok(es[find(es, "broken")].isLink, "listDir broken");
    ok(!es[find(es, "f")].isLink && !es[find(es, "d")].isLink, "listDir plain");

    match io.lstat("/tmp/j3_dir_test/lt/ld") {
        Result.Ok(e) { ok(e.isLink && !e.isDir && e.size == 1, "io.lstat ld"); }
        Result.Err(_) { ok(false, "io.lstat ld"); }
    }
    match io.stat("/tmp/j3_dir_test/lt/ld") {
        Result.Ok(e) { ok(!e.isLink && e.isDir, "io.stat ld"); }
        Result.Err(_) { ok(false, "io.stat ld"); }
    }
    sh("rm -rf /tmp/j3_dir_test/lt", a);
}

fn main() {
    let a = newArena(1048576);
    ok(mk("/tmp/j3_dir_test/x/y/z"), "makeDirs");
    ok(mk("/tmp/j3_dir_test/x/y/z/"), "makeDirs again");
    io.writeFile("/tmp/j3_dir_test/x/f.txt", "hello" as []u8);
    ok(!mk("/tmp/j3_dir_test/x/f.txt"), "makeDirs over a file");

    let es = list("/tmp/j3_dir_test/x", &a);
    ok(es.len == 2, "two entries");
    ok(find(es, ".") < 0 && find(es, "..") < 0, "no dot entries");
    let f = find(es, "f.txt");
    ok(f >= 0 && !es[f].isDir && es[f].size == 5 && es[f].mtime > 1600000000, "file entry");
    let y = find(es, "y");
    ok(y >= 0 && es[y].isDir, "dir entry");

    match io.stat("/tmp/j3_dir_test/x/f.txt") {
        Result.Ok(e) { ok(e.size == 5 && !e.isDir, "stat file"); }
        Result.Err(_) { ok(false, "stat file"); }
    }
    match io.stat("/tmp/j3_dir_test/nope") {
        Result.Ok(_) { ok(false, "stat missing"); }
        Result.Err(e) {
            match e {
                IoError.NotFound { }
                IoError.Other { ok(false, "stat missing is NotFound"); }
            }
        }
    }
    match io.listDir("/tmp/j3_dir_test/nope", &a) {
        Result.Ok(_) { ok(false, "listDir missing"); }
        Result.Err(_) { }
    }

    ok(mv("/tmp/j3_dir_test/x/f.txt", "/tmp/j3_dir_test/x/g.txt"), "rename");
    ok(!io.exists("/tmp/j3_dir_test/x/f.txt") && io.exists("/tmp/j3_dir_test/x/g.txt"), "renamed");
    ok(rm("/tmp/j3_dir_test/x/g.txt"), "remove");
    ok(!io.exists("/tmp/j3_dir_test/x/g.txt"), "removed");
    ok(!rm("/tmp/j3_dir_test/x/g.txt"), "remove missing");

    // many entries: more than one getdents64 buffer
    for i in 0..300 {
        io.writeFile(`/tmp/j3_dir_test/x/y/z/file_number_{i}.dat`, "" as []u8);
    }
    ok(list("/tmp/j3_dir_test/x/y/z", &a).len == 300, "300 entries");
    for i in 0..300 {
        io.remove(`/tmp/j3_dir_test/x/y/z/file_number_{i}.dat`);
    }

    symlinks(&a);

    let t = Thread { f: worker };
    thread.spawn(&t, "dirw", worker, 0 as ptr);
    thread.join(&t);
    printLn("dir_test ok");
}
