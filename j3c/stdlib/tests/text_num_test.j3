// Tests for `font-variant-numeric: tabular-nums` (j3.game.TextMode, dom.enterText, inputs, text-wave, `style:`).
// Separate process, like text_css_test: fresh DOM/font probes exceed game.FONT_SRC's 32-handle budget. Run from the repo root:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/text_num_test.j3 --headless
// Panics on the first failed check.

module text_num_test;

use j3.game.{ loadFont, setTextMode, textCaretX, TextMode, textWidth, Font };
use j3.io.printLn;
use j3.memory.Arena;
use j3.math.Vec2;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let FONTPATH: string;
const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"speculative/42_ui_numeric/assets/num.ttf\"); } .box { font-family: \"T\"; font-size: 16px; } .tab { font-variant-numeric: tabular-nums; } .wave { text-wave-amplitude: 2px; text-wave-length: 40px; text-wave-period: 1s; }";

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 { d = 0.0 - d; }
    ok(d <= tol, msg);
}

fn bytes(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

fn w(f: Font, s: string): f32 {
    return textWidth(f, bytes(s), false);
}

/// Width of the text of a nowrap block with `cls`, from its laid-out box (shrink-to-fit in a flex row).
fn boxW(mem: &Arena, css: &Css, cls: string, text: string): f32 {
    let d = Dom.new(mem, css);
    d.begin();
    let row = d.open(0, d.tag("div"), 1);
    d.styleStr(row, 1, "display", "flex");
    let id = d.open(0, d.tag("div"), 1);
    d.cls(id, "box");
    let a = 0;
    for i in 0..cls.len + 1 {
        if i == cls.len || cls[i] == 32 {
            if i > a { d.cls(id, cls[a..i]); }
            a = i + 1;
        }
    }
    d.text(text);
    d.close();
    d.close();
    d.end();
    d.layoutAt(800.0, 400.0);
    return d.nodes.items[id].w;
}

fn testGame(f: Font) {
    let n1 = w(f, "1111");
    let n8 = w(f, "8888");
    let ni = w(f, "iiii");
    setTextMode(TextMode { tabular: true, letterSp: 0.0, wordSp: 0.0, shaped: false });
    let t1 = w(f, "1111");
    let t8 = w(f, "8888");
    let mx = w(f, "0");
    for c in 1..10 {
        let ch = "0";
        if c == 1 { ch = "1"; } else if c == 2 { ch = "2"; } else if c == 3 { ch = "3"; } else if c == 4 { ch = "4"; }
        else if c == 5 { ch = "5"; } else if c == 6 { ch = "6"; } else if c == 7 { ch = "7"; } else if c == 8 { ch = "8"; } else { ch = "9"; }
        if w(f, ch) > mx { mx = w(f, ch); }
    }
    ok(t1 == t8, "tabular 1111 and 8888 are the same width");
    near(t1, 4.0 * mx, 0.01, "tabular width is 4 x the digit advance");
    ok(w(f, "1234567890") == 10.0 * mx, "all ten digits share the advance");
    near(w(f, "Score: 1,234"), w(f, "Score: ,") + 4.0 * mx, 0.01, "mixed text: only digits change");
    ok(w(f, "iiii") == ni, "letters keep their advance");
    near(textCaretX(f, bytes("1234"), false, 2), 2.0 * mx, 0.01, "caret after two digits is two cells in");
    setTextMode(TextMode { tabular: false, letterSp: 0.0, wordSp: 0.0, shaped: false });
    ok(w(f, "1111") == n1 && w(f, "8888") == n8, "normal widths are unchanged after switching off");
}

fn testDom(mem: &Arena, css: &Css, f: Font) {
    let p = boxW(mem, css, "", "1111");
    let t1 = boxW(mem, css, "tab", "1111");
    let t8 = boxW(mem, css, "tab", "8888");
    let tm = boxW(mem, css, "tab", "1,234");
    ok(t1 == t8, "a tabular block is as wide for 1111 as for 8888");
    near(boxW(mem, css, "", "1111"), p, 0.01, "normal blocks measure as before");
    setTextMode(TextMode { tabular: true, letterSp: 0.0, wordSp: 0.0, shaped: false });
    let want = w(f, "1,234");
    setTextMode(TextMode { tabular: false, letterSp: 0.0, wordSp: 0.0, shaped: false });
    near(tm, want, 0.6, "block width equals the tabular text width");
    ok(boxW(mem, css, "tab", "iiii") == boxW(mem, css, "", "iiii"), "letters only: no change");
    ok(boxW(mem, css, "wave tab", "1111") == t1 && t1 != p, "text-wave measures with tabular digits");
    // layout clears the latch, so the app's own text measures as before
    boxW(mem, css, "tab", "1111");
    near(w(f, "1111"), p, 0.01, "the latch does not leak out of layout");
}

fn frame(e: &Dom, cls: string) {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    inputs.begin(e);
    let p = e.open(0, e.tag("input"), 1); e.cls(p, "box"); if cls.len > 0 { e.cls(p, cls); } e.attrType(p, "text"); e.attrText(p, "1111"); e.close();
    e.layout(); e.endFrame();
}

fn testInput(mem: &Arena, css: &Css, f: Font) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { frame(&e, "tab"); }
    let id = e.nodes.items[0].first;
    e.focusNode(id); e.simKeys("", "End"); frame(&e, "tab");
    let c = e.caretRect(id);
    let x0 = e.absX(id);
    setTextMode(TextMode { tabular: true, letterSp: 0.0, wordSp: 0.0, shaped: false });
    let want = w(f, "1111");
    setTextMode(TextMode { tabular: false, letterSp: 0.0, wordSp: 0.0, shaped: false });
    near(c.x - x0, want, 2.0, "caret at the end of a tabular input sits after four tabular digits");
    let e2 = Dom.new(mem, css); e2.setFrameMs(16.0); e2.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { frame(&e2, ""); }
    let id2 = e2.nodes.items[0].first;
    e2.focusNode(id2); e2.simKeys("", "End"); frame(&e2, "");
    let c2 = e2.caretRect(id2);
    near(c2.x - e2.absX(id2), w(f, "1111"), 2.0, "normal input caret follows the proportional width");
}

fn tframe(e: &Dom, on: bool): int {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = e.open(0, e.tag("div"), 1); e.styleStr(row, 1, "display", "flex");
    let id = e.open(0, e.tag("div"), 1); e.cls(id, "box"); e.clsIf(id, "tab", on); e.text("1111"); e.close();
    e.close();
    e.layout(); e.endFrame();
    return id;
}

/// Toggling the class restyles and lays out, then idle frames cost nothing.
fn testToggle(mem: &Arena, css: &Css) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    let id = 0;
    for k in 0..3 { id = tframe(&e, false); }
    let off = e.nodes.items[id].w;
    id = tframe(&e, true);
    let on = e.nodes.items[id].w;
    ok(on > off, "turning tabular-nums on widens '1111' in a proportional-digit font");
    let laid = e.laid; let rs = e.restyled; let used = e.mem.used;
    for k in 0..4 { tframe(&e, true); }
    ok(e.laid == laid && e.restyled == rs && e.mem.used == used, "steady frames after the toggle do not lay out, restyle or allocate");
    // inline `style:font-variant-numeric="tabular-nums"` does the same as the class
    let f = Dom.new(mem, css); f.setFrameMs(16.0); f.simInput(-5.0, -5.0, false, 0.0);
    f.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = f.open(0, f.tag("div"), 1); f.styleStr(row, 1, "display", "flex");
    let sid = f.open(0, f.tag("div"), 1); f.cls(sid, "box"); f.styleStr(sid, 0, "font-variant-numeric", "tabular-nums"); f.text("1111"); f.close();
    f.close(); f.layout(); f.endFrame();
    near(f.nodes.items[sid].w, on, 0.01, "style:font-variant-numeric text value gives tabular digits");
    id = tframe(&e, false);
    near(e.nodes.items[id].w, off, 0.01, "turning it off restores the proportional width");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);
    FONTPATH = css.fonts.items[0].path;
    let f = loadFont(FONTPATH, 16);
    testGame(f);
    testDom(&mem, &css, f);
    testInput(&mem, &css, f);
    testToggle(&mem, &css);
    printLn(`text_num_test: {CHECKS} checks passed`);
}
