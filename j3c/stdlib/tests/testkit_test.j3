// Tests for j3.ui.testkit: click by text / tag / text inside a tag, typeInto, hasText, several keys in one
// frame, and the not-found report (counted in misses()).
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/testkit_test.j3

module testkit_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;

#[singleton]
let CHECKS: int;
#[singleton]
let STATE: St;

struct St {
    clicks: int = 0;
    ok: int = 0;
    name: string = "";
    gone: bool = false;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = "button { width: 80px; height: 24px; } input { width: 120px; height: 24px; } dialog { width: 200px; height: 80px; } .gone { display: none; } .far { position: absolute; left: 900px; top: 0px; }";

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    let b = d.open(1, d.tag("button"), 1);
    d.text("Go");
    if d.clicked(b) {
        STATE.clicks += 1;
    }
    d.close();
    let tb = d.open(2, d.tag("input"), 1);
    d.attrType(tb, "text");
    if d.changed(tb) {
        STATE.name = d.strValue(tb);
    }
    d.attrText(tb, STATE.name);
    d.close();
    d.open(3, d.tag("dialog"), 1);
    let b2 = d.open(0, d.tag("button"), 1);
    if STATE.gone {
        d.cls(b2, "gone");
    }
    d.text("Go2");
    if d.clicked(b2) {
        STATE.ok += 1;
    }
    d.close();
    let b3 = d.open(1, d.tag("button"), 1);
    d.text("Go");
    if d.clicked(b3) {
        STATE.ok += 100;
    }
    d.close();
    d.close();
    let hb = d.open(4, d.tag("button"), 1);
    d.cls(hb, "gone");
    d.text("Hidden");
    if d.clicked(hb) {
        STATE.clicks += 1000;
    }
    d.close();
    let fb = d.open(5, d.tag("button"), 1);
    d.cls(fb, "far");
    d.text("Far");
    if d.clicked(fb) {
        STATE.clicks += 1000;
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    STATE = St {};
    frame(&d);
    frame(&d);
    ok(testkit.hasText(&d, "Go") && !testkit.hasText(&d, "Nope"), "hasText");
    ok(testkit.countText(&d, "Go") == 2, "countText");
    ok(testkit.tagNode(&d, "button", 2) >= 0 && testkit.tagNode(&d, "button", 4) < 0, "tagNode counts elements in order");
    ok(testkit.textNodeIn(&d, "dialog", "Go") >= 0 && testkit.textNodeIn(&d, "div", "Nope") < 0, "textNodeIn");

    // a click is three frames, and only those
    for f in 1..8 {
        testkit.clickText(&d, f, 2, "Go");
        frame(&d);
        if f == 2 || f == 3 {
            ok(STATE.clicks == 0, "no click before the release");
        }
    }
    ok(STATE.clicks == 1, "clickText clicks once (the first text)");
    for f in 1..6 {
        testkit.clickTextIn(&d, f, 1, "dialog", "Go2");
        frame(&d);
    }
    ok(STATE.ok == 1, "clickTextIn finds the text inside the dialog");
    for f in 1..6 {
        testkit.clickTag(&d, f, 1, "button", 2);
        frame(&d);
    }
    ok(STATE.ok == 101, "clickTag clicks the k-th element");

    // type into the input: click it, then the text lands on the fourth frame
    for f in 1..9 {
        testkit.typeInto(&d, f, 1, "input", 0, "hello");
        frame(&d);
    }
    ok(d.focused() >= 0 && STATE.name.len == 5, "typeInto focuses the input and types");

    // several keys in one frame: Ctrl+A then Backspace empties the box
    for f in 1..6 {
        testkit.simKeys(&d, f, 2, "", "C+a Backspace");
        frame(&d);
    }
    ok(STATE.name.len == 0, "two key names in one frame");

    // not found: reported, counted, nothing clicked
    ok(testkit.misses() == 0, "no misses so far");
    for f in 1..6 {
        testkit.clickText(&d, f, 1, "Nowhere");
        frame(&d);
    }
    ok(testkit.misses() == 1 && STATE.clicks == 1, "a missing target is one miss over its three frames and clicks nothing");
    // hidden (display: none) and off-screen targets are misses too, and nothing is clicked
    ok(!testkit.hasText(&d, "Hidden") && testkit.hasText(&d, "Far"), "hasText skips display: none");
    for f in 1..6 {
        testkit.clickText(&d, f, 1, "Hidden");
        frame(&d);
    }
    ok(testkit.misses() == 2 && STATE.clicks == 1, "a display: none target is a miss, not a click");
    for f in 1..6 {
        testkit.clickText(&d, f, 1, "Far");
        frame(&d);
    }
    ok(testkit.misses() == 3 && STATE.clicks == 1, "an off-screen target is a miss, not a click");
    // a target that vanishes after the first frame of a click: one miss, not two
    for f in 1..6 {
        testkit.clickText(&d, f, 1, "Go2");
        STATE.gone = true;
        frame(&d);
    }
    ok(testkit.misses() == 4, "a target gone mid-click counts once");
    testkit.resetMisses();
    ok(testkit.misses() == 0, "resetMisses starts again");
    // two different missing targets back to back are two misses (the second must not be skipped as a repeat)
    for f in 1..9 {
        testkit.clickText(&d, f, 3, "A");
        testkit.clickText(&d, f, 6, "B");
        frame(&d);
    }
    ok(testkit.misses() == 2, "two missing targets back to back count twice");
    testkit.click(&d, 1, 1, -1);
    ok(testkit.misses() == 3, "click on a bad id is a miss");
    printLn(`all passed ({CHECKS} checks)`);
}
