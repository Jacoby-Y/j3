// Test vectors for j3.hash: FNV-1a 64, XXH3 64 (seed 0) for every length class against the
// reference xxhash.h 0.8, SHA-256 from FIPS 180-2 / NIST, and incremental == one-shot across
// every split point. Run from the repo root (cargo runs it on both backends):
//   timeout 60 j3c run j3c/stdlib/tests/hash_test.j3

module hash_test;

use j3.hash;
use j3.hash.{ Fnv1a64, Sha256, Xxh3 };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// `v` as 16 hex digits.
fn hex16(t: &Text, v: u64): string {
    t.clear();
    let digits = "0123456789abcdef";
    let k = 60;
    while k >= 0 {
        t.push(digits[int((v >> u64(k)) & 15)]);
        k -= 4;
    }
    return t.str();
}

fn sha(t: &Text, b: []u8): string {
    t.clear();
    hash.sha256(b).hex(t);
    return t.str();
}

fn main() {
    let a = Arena.create(4 * 1024 * 1024);
    let t = Text.new(&a);
    let buf = a.alloc::<u8>(100000);
    for i in 0..buf.len {
        buf[i] = u8((i * 31 + 7) & 0xFF);
    }

    // FNV-1a 64 (Fowler/Noll/Vo reference values)
    ok(hex16(&t, hash.fnv1a64("" as []u8)) == "cbf29ce484222325", "fnv empty");
    ok(hex16(&t, hash.fnv1a64("a" as []u8)) == "af63dc4c8601ec8c", "fnv a");
    ok(hex16(&t, hash.fnv1a64("foobar" as []u8)) == "85944171f73967e8", "fnv foobar");

    // XXH3 64, seed 0: byte i of the input is (i * 31 + 7) & 0xFF
    let lens: [34]int = [0, 1, 2, 3, 4, 5, 8, 9, 15, 16, 17, 31, 32, 33, 64, 65, 96, 97, 127, 128, 129, 200, 239, 240, 241, 255, 256, 257, 1023, 1024, 1025, 2048, 4097, 100000];
    let want: [34]string = [
        "2d06800538d394c2",
        "4c5cca45d0f4811f",
        "a7e250c97710ff27",
        "15f7093b173d005c",
        "dca012f95811b6b9",
        "b290cafc7b254345",
        "dec6a9a43575982e",
        "cbe393399f17ffbd",
        "545e19990471dc37",
        "7e484c18d74895d0",
        "208bde5ee2bed407",
        "a937652b0119ca11",
        "03df0ac5255d1446",
        "199a362122d71f46",
        "dd30702ab46b3745",
        "fab36b851b94ce20",
        "d245cd2541582982",
        "60e3e1d0d43785b3",
        "a915ed6396db8cc0",
        "f92b70eaa21a6288",
        "f8f76713f2bb60fa",
        "12fdb864685f344d",
        "caa9b7a588464745",
        "ccc7375172c41f03",
        "0b3b630948ce4a00",
        "89932170686cdd9a",
        "ec85b75bafe6ca74",
        "12ef0ff633841459",
        "f0d330ce2b3300fb",
        "23bc880ebf0d29c6",
        "c09fdfbc398c7d82",
        "19f6f9c987331373",
        "b319759b4671c221",
        "ccf90df7e7e37036"
    ];
    for k in 0..lens.len {
        ok(hex16(&t, hash.xxh3_64(buf[0..lens[k]])) == want[k], `xxh3 len {lens[k]}`);
    }
    ok(hex16(&t, hash.xxh3_64("a" as []u8)) == "e6c632b61e964e1f", "xxh3 a");
    ok(hex16(&t, hash.xxh3_64("abc" as []u8)) == "78af5f94892f3950", "xxh3 abc");
    ok(hex16(&t, hash.xxh3_64("hello world" as []u8)) == "d447b1ea40e6988b", "xxh3 hello world");
    ok(hex16(&t, hash.xxh3_64("The quick brown fox jumps over the lazy dog" as []u8)) == "ce7d19a5418fb365", "xxh3 The quick brown fox jumps over the lazy dog");

    // SHA-256 (FIPS 180-2 appendix B and the NIST one-million-a vector)
    ok(sha(&t, "" as []u8) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha empty");
    ok(sha(&t, "abc" as []u8) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha abc");
    ok(sha(&t, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" as []u8) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "sha 448 bits");
    let ma = a.alloc::<u8>(1000000);
    for i in 0..ma.len { ma[i] = 'a'; }
    ok(sha(&t, ma) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0", "sha million a");

    // incremental: every split of a 3000-byte input into two pieces, then pieces of each size
    let n = 3000;
    let whole = buf[0..n];
    let wx = hash.xxh3_64(whole);
    let wf = hash.fnv1a64(whole);
    let ws = sha(&t, whole);
    for cut in 0..n + 1 {
        let x = Xxh3.new();
        x.update(whole[0..cut]);
        x.update(whole[cut..n]);
        ok(x.finish() == wx, `xxh3 split at {cut}`);
        let f = Fnv1a64.new();
        f.update(whole[0..cut]);
        f.update(whole[cut..n]);
        ok(f.finish() == wf, "fnv split");
        if cut % 7 == 0 || cut < 130 {
            let s = Sha256.new();
            s.update(whole[0..cut]);
            s.update(whole[cut..n]);
            t.clear();
            s.finish().hex(&t);
            ok(t.str() == ws, `sha split at {cut}`);
        }
    }
    for step in 1..300 {
        let x = Xxh3.new();
        let s = Sha256.new();
        let at = 0;
        while at < n {
            let e = if at + step > n { n } else { at + step };
            x.update(whole[at..e]);
            s.update(whole[at..e]);
            at = e;
        }
        ok(x.finish() == wx, `xxh3 pieces of {step}`);
        t.clear();
        s.finish().hex(&t);
        ok(t.str() == ws, `sha pieces of {step}`);
    }
    // every short length through the hasher (inputs up to 240 bytes are hashed whole at finish)
    for len in 0..600 {
        let x = Xxh3.new();
        x.update(buf[0..len / 2]);
        x.update(buf[len / 2..len]);
        ok(x.finish() == hash.xxh3_64(buf[0..len]), `xxh3 short {len}`);
    }
    printLn("hash_test ok");
}
