// Tests for j3.proc: run programs, pipes, exit codes, PATH lookup. Linux. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/proc_test.j3
// Panics on the first failed check.

module proc_test;

use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.proc;
use j3.proc.{ Output, ProcError, StartOpts };
use j3.option.Option;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn run(argv: []string, input: string, a: &Arena): Output {
    match proc.run(argv, input, a) {
        Result.Ok(o) { return o; }
        Result.Err(_) { panic(`could not run {argv[0]}`); }
    }
    return Output { code: -1, out: "" as []u8, err: "" as []u8 };
}

fn main() {
    let a = Arena.create(4194304);

    let echo: [3]string = ["echo", "hi", "there"];
    let o = run(echo[:], "", &a);
    ok(eq(o.outStr(), "hi there\n") && o.code == 0, "echo");

    let sh: [3]string = ["sh", "-c", "cat; echo oops >&2; exit 3"];
    let o2 = run(sh[:], "fed in", &a);
    ok(eq(o2.outStr(), "fed in"), "stdin reaches the program");
    ok(eq(o2.errStr(), "oops\n"), "stderr kept apart");
    ok(o2.code == 3, "exit code");

    // a megabyte through cat: stdin and stdout must be pumped together or both pipes fill
    let big = a.alloc::<u8>(1048576);
    for i in 0..big.len {
        big[i] = u8(97 + i % 26);
    }
    let cat: [1]string = ["cat"];
    let o3 = run(cat[:], big as string, &a);
    ok(o3.out.len == big.len, "1 MiB through cat");
    ok(o3.out[777777] == big[777777], "bytes intact");

    let killed: [3]string = ["sh", "-c", "kill -9 $$"];
    ok(run(killed[:], "", &a).code == 128 + 9, "signal shows as 128 + n");

    let nope: [1]string = ["j3-no-such-program"];
    match proc.run(nope[:], "", &a) {
        Result.Ok(_) { ok(false, "missing program ran"); }
        Result.Err(e) {
            match e {
                ProcError.NotFound { ok(true, "missing program"); }
                ProcError.ExecFailed { ok(false, "missing program: ExecFailed"); }
                ProcError.Fail { ok(false, "missing program: Fail"); }
            }
        }
    }
    let notExec: [1]string = ["/etc/hostname"];
    match proc.run(notExec[:], "", &a) {
        Result.Ok(_) { ok(false, "non-executable ran"); }
        Result.Err(e) {
            match e {
                ProcError.NotFound { ok(false, "non-executable: NotFound"); }
                ProcError.ExecFailed { ok(true, "non-executable"); }
                ProcError.Fail { ok(false, "non-executable: Fail"); }
            }
        }
    }

    let pwd: [1]string = ["pwd"];
    match proc.startIn(pwd[:], "/tmp", &a) {
        Result.Ok(c) {
            let out = c.collect("" as []u8, &a);
            ok(eq(out.outStr(), "/tmp\n"), "working directory");
        }
        Result.Err(_) { ok(false, "startIn"); }
    }

    ok(sys.env("PATH").len > 0, "env PATH");
    ok(sys.env("J3_SURELY_UNSET_VAR").len == 0, "env unset");
    let envsh: [3]string = ["sh", "-c", "printf %s \"$HOME\""];
    ok(eq(run(envsh[:], "", &a).outStr(), sys.env("HOME")), "child inherits the environment");

    // tryWait / tryReadErr: a child that waits for a line on stdin, then writes to stderr and exits 3
    let errsh: [3]string = ["sh", "-c", "read x; printf err >&2; exit 3"];
    match proc.start(errsh[:], &a) {
        Result.Ok(c) {
            let buf = a.alloc::<u8>(16);
            let running = false;
            match c.tryWait() { Option.Some(_) {} Option.None { running = true; } }
            ok(running, "tryWait while running");
            let empty = false;
            match c.tryReadErr(buf) { Option.Some(_) {} Option.None { empty = true; } }
            ok(empty, "tryReadErr before output");
            ok(c.write("go\n" as []u8), "write string bytes");
            let code = -1;
            let tries = 0;
            while tries < 2000 {
                match c.tryWait() {
                    Option.Some(k) { code = k; break; }
                    Option.None { sys.pollFds(0 as ptr, 0, 1); }
                }
                tries += 1;
            }
            ok(code == 3, "tryWait exit code");
            ok(c.readErr(buf) == 3 && eq(buf[0..3] as string, "err"), "readErr after exit");
            ok(c.wait() == 3, "wait after tryWait");
        }
        Result.Err(_) { ok(false, "start sh"); }
    }
    ok(io.canExec("/bin/sh") && !io.canExec("/etc/passwd"), "io.canExec");
    ok(io.openPath("/surely/missing", sys.O_RDONLY, 0) < 0, "io.openPath missing");
    ok((1 << 20) == 1048576 && (-16 >> 2) == -4, "shifts");
    let envsh2: [3]string = ["sh", "-c", "echo $JZ_TEST$HOME"];
    let extra: [1]string = ["JZ_TEST=hello"];
    let home = sys.env("HOME");
    match proc.runEnv(envsh2[:], "", extra[:], &a) {
        Result.Ok(eo) {
            let s = eo.outStr();
            ok(s.len == home.len + 6 && eq(s[0..5], "hello") && eq(s[5..5 + home.len], home), "runEnv adds to the environment");
        }
        Result.Err(_) { ok(false, "runEnv"); }
    }
    ok(run(envsh2[:], "", &a).outStr().len == home.len + 1, "run without env");
    // a bare name removes it; proc.environ sees setenv
    sys.setenv("JZ_SECRET", "s");
    let seen = false;
    let envs = proc.environ(&a);
    for i in 0..envs.len { if eq(envs[i], "JZ_SECRET=s") { seen = true; } }
    ok(seen, "proc.environ shows setenv");
    let envsh3: [3]string = ["sh", "-c", "echo [$JZ_SECRET]"];
    let gone: [1]string = ["JZ_SECRET"];
    match proc.runEnv(envsh3[:], "", gone[:], &a) {
        Result.Ok(go) { ok(eq(go.outStr(), "[]\n"), "bare name unsets"); }
        Result.Err(_) { ok(false, "bare name unsets"); }
    }
    ok(io.cwd(&a).len > 0 && io.cwd(&a)[0] == 47, "io.cwd");
    let t0 = sys.monotonicMs();
    ok(t0 > 0, "monotonicMs");

    pdeathsigTest(&a);
    signalTest(&a);

    printLn(`proc_test: {CHECKS} checks ok`);
}

/// Gone or a zombie, from /proc/PID/stat ("pid (comm) S ...").
fn procDead(pid: int, a: &Arena): bool {
    match io.readFile(`/proc/{pid}/stat`, a) {
        Result.Ok(b) {
            for i in 0..b.len {
                if b[i] == 41 && i + 2 < b.len {
                    return b[i + 2] == 90;   // ')' then " Z"
                }
            }
            return false;
        }
        Result.Err(_) { return true; }
    }
    return true;
}

/// A middle process starts `sleep 30` with parentDeathSignal and exits: the sleep must die with it.
fn pdeathsigTest(a: &Arena) {
    let fds: [2]i32 = [0, 0];
    ok(sys.pipe(fds[:], 0) == 0, "pipe");
    let mid = sys.fork();
    if mid == 0 {
        let argv: [2]string = ["sleep", "30"];
        let opts = StartOpts { group: true, parentDeathSignal: sys.SIGKILL };
        let pid = 0;
        match proc.startWith(argv[:], argv[0..0], opts, a) {
            Result.Ok(c) { pid = c.pid; }
            Result.Err(_) {}
        }
        sys.write(int(fds[1]), &pid as ptr, 8);
        sys.exit(0);
    }
    sys.close(int(fds[1]));
    let pid = 0;
    ok(sys.read(int(fds[0]), &pid as ptr, 8) == 8 && pid > 0, "parentDeathSignal: child started");
    sys.close(int(fds[0]));
    let st: i32 = 0;
    sys.waitpid(mid, &st, 0);
    let dead = false;
    for _ in 0..100 {
        if procDead(pid, a) { dead = true; break; }
        sys.sleepMs(10);
    }
    if !dead { sys.kill(pid, sys.SIGKILL); }
    ok(dead, "parentDeathSignal kills the child when its parent dies");
}

fn signalTest(a: &Arena) {
    ok(sys.pendingSignal() == 0, "no signal before watchSignals");
    let sigs: [2]int = [sys.SIGTERM, sys.SIGINT];
    ok(sys.watchSignals(sigs[:]), "watchSignals");
    ok(sys.pendingSignal() == 0, "nothing pending yet");
    sys.kill(sys.getpid(), sys.SIGTERM);
    sys.kill(sys.getpid(), sys.SIGINT);
    let got = sys.pendingSignal() + sys.pendingSignal() * 100;
    ok(got == 15 + 200 || got == 2 + 1500, "SIGTERM and SIGINT queued");
    ok(sys.pendingSignal() == 0, "drained");
    // a child starts with signals unblocked, so SIGTERM still ends it
    let sh: [3]string = ["sh", "-c", "kill -TERM $$; sleep 5"];
    match proc.startWith(sh[:], sh[0..0], StartOpts {}, a) {
        Result.Ok(c) {
            let cc = c;
            ok(cc.wait() == 143, "child of a watching process dies of SIGTERM");
        }
        Result.Err(_) { ok(false, "start sh"); }
    }
}

