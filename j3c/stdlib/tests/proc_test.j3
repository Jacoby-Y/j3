// Tests for j3.proc: run programs, pipes, exit codes, PATH lookup. Linux. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/proc_test.j3
// Panics on the first failed check.

module proc_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.proc;
use j3.proc.{ Output, ProcError };
use j3.result.Result;
use j3.sys;
use j3.sys.panic;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

fn run(argv: []string, input: string, a: &Arena): Output {
    match proc.run(argv, input, a) {
        Result.Ok(o) { return o; }
        Result.Err(_) { panic(`could not run {argv[0]}`); }
    }
    return Output { code: -1, out: "" as []u8, err: "" as []u8 };
}

fn main() {
    let a = Arena.create(4194304);

    let echo: [3]string = ["echo", "hi", "there"];
    let o = run(echo[:], "", &a);
    ok(eq(o.outStr(), "hi there\n") && o.code == 0, "echo");

    let sh: [3]string = ["sh", "-c", "cat; echo oops >&2; exit 3"];
    let o2 = run(sh[:], "fed in", &a);
    ok(eq(o2.outStr(), "fed in"), "stdin reaches the program");
    ok(eq(o2.errStr(), "oops\n"), "stderr kept apart");
    ok(o2.code == 3, "exit code");

    // a megabyte through cat: stdin and stdout must be pumped together or both pipes fill
    let big = a.alloc::<u8>(1048576);
    for i in 0..big.len {
        big[i] = u8(97 + i % 26);
    }
    let cat: [1]string = ["cat"];
    let o3 = run(cat[:], big as string, &a);
    ok(o3.out.len == big.len, "1 MiB through cat");
    ok(o3.out[777777] == big[777777], "bytes intact");

    let killed: [3]string = ["sh", "-c", "kill -9 $$"];
    ok(run(killed[:], "", &a).code == 128 + 9, "signal shows as 128 + n");

    let nope: [1]string = ["j3-no-such-program"];
    match proc.run(nope[:], "", &a) {
        Result.Ok(_) { ok(false, "missing program ran"); }
        Result.Err(e) {
            match e {
                ProcError.NotFound { ok(true, "missing program"); }
                ProcError.ExecFailed { ok(false, "missing program: ExecFailed"); }
                ProcError.Fail { ok(false, "missing program: Fail"); }
            }
        }
    }
    let notExec: [1]string = ["/etc/hostname"];
    match proc.run(notExec[:], "", &a) {
        Result.Ok(_) { ok(false, "non-executable ran"); }
        Result.Err(e) {
            match e {
                ProcError.NotFound { ok(false, "non-executable: NotFound"); }
                ProcError.ExecFailed { ok(true, "non-executable"); }
                ProcError.Fail { ok(false, "non-executable: Fail"); }
            }
        }
    }

    let pwd: [1]string = ["pwd"];
    match proc.startIn(pwd[:], "/tmp", &a) {
        Result.Ok(c) {
            let out = c.collect("" as []u8, &a);
            ok(eq(out.outStr(), "/tmp\n"), "working directory");
        }
        Result.Err(_) { ok(false, "startIn"); }
    }

    ok(sys.env("PATH").len > 0, "env PATH");
    ok(sys.env("J3_SURELY_UNSET_VAR").len == 0, "env unset");
    let envsh: [3]string = ["sh", "-c", "printf %s \"$HOME\""];
    ok(eq(run(envsh[:], "", &a).outStr(), sys.env("HOME")), "child inherits the environment");

    printLn(`proc_test: {CHECKS} checks ok`);
}
