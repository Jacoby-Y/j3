// Tests for `@property` custom properties that transition and animate (j3.ui.motion `applyVars`, the Dom's `followVars`).
// No window, no font:
//   timeout 60 j3c run j3c/stdlib/tests/prop_test.j3 --headless
// Panics on the first failed check.

module prop_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.{ Css, MatchNode, P_BACKGROUND, P_BG_IMAGE, P_HEIGHT, P_WIDTH, V_CALC, V_COLOR, V_GRAD };
use j3.ui.csscalc.calcEval;
use j3.ui.cssmatch.computeStyle;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.motion;
use j3.ui.motionbase.Motion;

const S_TEST: int = 1;

#[singleton]
let CHECKS: int;

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > tol {
        printLn(`{a} vs {b}`);
    }
    ok(d <= tol, msg);
}

const SHEET: string = "@property --c { syntax: '<color>'; inherits: false; initial-value: #000000; }\n@property --w { syntax: '<length>'; inherits: true; initial-value: 0px; }\n@property --a { syntax: '<angle>'; inherits: true; initial-value: 0deg; }\n@property --n { syntax: '<number>'; inherits: true; initial-value: 0; }\n.c1 { --c: #000000; background: var(--c); transition: --c 100ms linear; }\n.c2 { --c: #ffffff; background: var(--c); transition: --c 100ms linear; }\n.w1 { --w: 0px; width: var(--w); height: calc(var(--w) * 2); transition: --w 100ms linear; }\n.w2 { --w: 100px; width: var(--w); height: calc(var(--w) * 2); transition: --w 100ms linear; }\n.all1 { --w: 0px; width: var(--w); transition: all 100ms linear; }\n.all2 { --w: 100px; width: var(--w); transition: all 100ms linear; }\n.g1 { --a: 0deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); transition: --a 100ms linear; }\n.g2 { --a: 180deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); transition: --a 100ms linear; }\n@keyframes spin { to { --a: 360deg; } }\n.k { --a: 0deg; background-image: conic-gradient(from var(--a), #ff0000, #0000ff); animation: spin 1000ms linear infinite; }\n@keyframes grow { to { --w: 100px; } }\n.kw { --w: 0px; width: var(--w); animation: grow 100ms linear forwards; }\n.u1 { --z: 0px; width: var(--z); transition: --z 100ms linear; }\n.u2 { --z: 100px; width: var(--z); transition: --z 100ms linear; }\n@keyframes uz { to { --z: 100px; } }\n.uk { --z: 0px; width: var(--z); animation: uz 100ms linear forwards; }\n.pa { --w: 0px; animation: grow 100ms linear forwards; }\n.ch { width: var(--w); height: 10px; }\n.own { --w: 7px; width: var(--w); height: 10px; }\n.deep { height: 10px; }\n.gc { width: var(--w); height: 10px; }\n.none { animation: none; }\n.dr { --w: 0px; --b: var(--w); height: var(--b); animation: grow 100ms linear forwards; }\n.cb { width: var(--b, 7px); height: 10px; }\n.pb { --w: 0px; animation: grow 100ms linear; }\n.mp { width: 40px; height: 10px; }\n";

fn style(mem: &Arena, css: &Css, cls: string): int {
    let nodes = mem.alloc::<MatchNode>(1);
    let cs = mem.alloc::<int>(1);
    cs[0] = css.intern(cls);
    nodes[0] = MatchNode { tag: css.intern("div"), classes: cs, parent: -1, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    return computeStyle(css, nodes, 0, -1);
}

fn gf(css: &Css, st: int, p: int): f32 {
    return css.get(st, p).f;
}

/// Angle of the first gradient layer of style `st`'s background-image.
fn gradAngle(css: &Css, st: int): f32 {
    let v = css.get(st, P_BG_IMAGE);
    ok(v.kind == V_GRAD, "a gradient");
    return css.paints.items[v.i + 2];
}

fn calcPx(css: &Css, st: int, p: int): f32 {
    let v = css.get(st, p);
    if v.kind != V_CALC {
        return v.f;
    }
    let px: f32 = 0.0;
    ok(calcEval(css, v, 0.0, &px), "calc evaluates");
    return px;
}

fn testTransitions(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", 0);
    ok(css.warns.len == 0, "sheet parses without warnings");
    // color
    let c1 = style(mem, &css, "c1");
    let c2 = style(mem, &css, "c2");
    let m = motion.fresh();
    motion.onStyle(&m, &css, c1, c2, 0.0);
    let r = motion.step(&m, &css, c2, 50.0, 0.0);
    let v = css.get(m.ov, P_BACKGROUND);
    ok(v.kind == V_COLOR && (v.c / 65536) % 256 > 120 && (v.c / 65536) % 256 < 136, "a registered color var is mid-blend");
    ok(r % 2 == 1, "and the node is live");
    r = motion.step(&m, &css, c2, 200.0, 0.0);
    ok(css.get(m.ov, P_BACKGROUND).c == 0xffffffff, "the color var ends at its target");
    ok(r % 2 == 0, "and the node is idle");
    motion.step(&m, &css, c2, 216.0, 0.0);
    ok(m.vn == 0 && m.vprev == 0, "a frame later nothing is overridden");
    // length, and a calc() reader
    let w1 = style(mem, &css, "w1");
    let w2 = style(mem, &css, "w2");
    let mw = motion.fresh();
    motion.onStyle(&mw, &css, w1, w2, 0.0);
    r = motion.step(&mw, &css, w2, 25.0, 0.0);
    near(gf(&css, mw.ov, P_WIDTH), 25.0, 0.01, "length var at a quarter");
    near(calcPx(&css, mw.ov, P_HEIGHT), 50.0, 0.01, "a calc() reader follows it");
    r = motion.step(&mw, &css, w2, 500.0, 0.0);
    near(gf(&css, mw.ov, P_WIDTH), 100.0, 0.01, "length var ends at 100");
    ok(r % 2 == 0, "length transition finished");
    // `transition: all` covers registered properties
    let a1 = style(mem, &css, "all1");
    let a2 = style(mem, &css, "all2");
    let ma = motion.fresh();
    motion.onStyle(&ma, &css, a1, a2, 0.0);
    motion.step(&ma, &css, a2, 50.0, 0.0);
    near(gf(&css, ma.ov, P_WIDTH), 50.0, 0.01, "`all` transitions a registered var");
    // angle into a conic gradient
    let g1 = style(mem, &css, "g1");
    let g2 = style(mem, &css, "g2");
    near(gradAngle(&css, g2), 180.0, 0.01, "the gradient reads the var");
    let mg = motion.fresh();
    motion.onStyle(&mg, &css, g1, g2, 0.0);
    motion.step(&mg, &css, g2, 50.0, 0.0);
    near(gradAngle(&css, mg.ov), 90.0, 0.5, "angle var half way drives the gradient");
    // an unregistered var is discrete: the reader jumps at once
    let u1 = style(mem, &css, "u1");
    let u2 = style(mem, &css, "u2");
    let mu = motion.fresh();
    motion.onStyle(&mu, &css, u1, u2, 0.0);
    ok(!motion.active(&mu), "an unregistered var starts no transition");
    near(gf(&css, u2, P_WIDTH), 100.0, 0.01, "its readers jump at once");
}

fn testKeyframes(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", 0);
    let k = style(mem, &css, "k");
    let m = motion.fresh();
    motion.onStyle(&m, &css, -1, k, 0.0);
    motion.step(&m, &css, k, 250.0, 0.0);
    near(gradAngle(&css, m.ov), 90.0, 0.5, "keyframes drive a conic gradient's from angle");
    motion.step(&m, &css, k, 500.0, 0.0);
    near(gradAngle(&css, m.ov), 180.0, 0.5, "half way round");
    // no allocation or parsing while it runs
    let np = css.paints.len;
    let nd = css.decls.len;
    let nv = css.vsEnt.len;
    let nvo = css.vso.len;
    let nf = css.fbs.len;
    let nw = css.warns.len;
    let used = mem.checkpoint();
    for f in 0..40 {
        motion.step(&m, &css, k, 10.0 + f32(f) * 16.0, 0.0);
    }
    ok(css.paints.len == np && css.decls.len == nd && css.vsEnt.len == nv && css.vso.len == nvo && css.fbs.len == nf && css.warns.len == nw, "steady frames grow no list");
    ok(mem.checkpoint() == used, "steady frames allocate no memory");
    // width from a var, held at the end
    let kw = style(mem, &css, "kw");
    let mk = motion.fresh();
    motion.onStyle(&mk, &css, -1, kw, 0.0);
    motion.step(&mk, &css, kw, 50.0, 0.0);
    near(gf(&css, mk.ov, P_WIDTH), 50.0, 0.01, "a width driven by a keyframed var");
    let r = motion.step(&mk, &css, kw, 400.0, 0.0);
    near(gf(&css, mk.ov, P_WIDTH), 100.0, 0.01, "holds the final value");
    ok(r % 2 == 0, "and is no longer live");
    // unregistered: keyframes on it do nothing
    let uk = style(mem, &css, "uk");
    let mu = motion.fresh();
    motion.onStyle(&mu, &css, -1, uk, 0.0);
    motion.step(&mu, &css, uk, 50.0, 0.0);
    near(gf(&css, mu.ov, P_WIDTH), 0.0, 0.01, "keyframes on an unregistered var do not interpolate");
}


fn el(d: &Dom, slot: int, cls: string): int {
    let id = d.open(slot, d.tag("div"), S_TEST);
    d.cls(id, cls);
    return id;
}

/// `<div class=root><div class="ch"/><div class="own"/><div class="deep"><div class="gc"/></div></div>`; the ids are written to `ids`.
fn frame(d: &Dom, root: string, ids: []int) {
    d.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    ids[0] = el(d, 0, "pa");
    d.clsDyn(ids[0], root);
    ids[1] = el(d, 0, "ch");
    d.close();
    ids[2] = el(d, 1, "own");
    d.close();
    ids[3] = el(d, 2, "deep");
    ids[4] = el(d, 0, "gc");
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

/// Descendants that read an inherited animated var follow it; one that declares the var itself does not; nothing runs afterwards.
fn testDescendants(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(5);
    frame(&d, "", ids);
    ok(d.animating == 1, "the keyframes run on the parent");
    for k in 0..3 {
        frame(&d, "", ids);
    }
    let w = d.nodes.items[ids[1]].w;
    ok(w > 5.0 && w < 95.0, "a child reading the inherited var is mid-way");
    near(d.nodes.items[ids[2]].w, 7.0, 0.01, "a child that declares the var itself is not animated");
    let wg = d.nodes.items[ids[4]].w;
    ok(wg > 5.0 && wg < 95.0, "so is a grandchild under a non-reader");
    // no allocation while it runs
    let used = mem.checkpoint();
    let np = css.paints.len;
    let nv = css.vsEnt.len;
    for k in 0..2 {
        frame(&d, "", ids);
    }
    ok(css.paints.len == np && css.vsEnt.len == nv, "descendant frames grow no list");
    ok(mem.checkpoint() == used, "and allocate no memory");
    for k in 0..12 {
        frame(&d, "", ids);
    }
    near(d.nodes.items[ids[1]].w, 100.0, 0.01, "the child ends at the final value");
    near(d.nodes.items[ids[4]].w, 100.0, 0.01, "and the grandchild");
    ok(d.animating == 0, "the animation is over (held)");
    // finished: frames cost no restyle and move nothing
    let r0 = d.restyled;
    for k in 0..4 {
        frame(&d, "", ids);
    }
    ok(d.restyled == r0, "idle frames restyle nothing");
    near(d.nodes.items[ids[1]].w, 100.0, 0.01, "and the value stays");
    // `animation: none` (the parent's class changes): every follower is back on its computed style
    frame(&d, "none", ids);
    frame(&d, "none", ids);
    near(d.nodes.items[ids[1]].w, 0.0, 0.01, "dropping the animation puts the child back");
    near(d.nodes.items[ids[4]].w, 0.0, 0.01, "and the grandchild");
}

/// `<div class="pa root"><div class="ch"/><div class="cb"/></div>`; mode 1 gives the `ch` child `style:width` and `style:height="var(--w)"`.
fn frame2(d: &Dom, root: string, mode: int, ids: []int) {
    d.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    ids[0] = el(d, 0, "pa");
    d.clsDyn(ids[0], root);
    ids[1] = el(d, 0, "ch");
    if mode == 1 {
        d.styleNum(ids[1], 0, "width", 33.0);
        d.styleStr(ids[1], 1, "height", "var(--w)");
    }
    d.close();
    ids[2] = el(d, 1, "cb");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

/// `style:` overrides keep beating the rules while a var animates; a var() inside one follows it.
fn testInline(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(3);
    for k in 0..4 {
        frame2(&d, "", 1, ids);
    }
    near(d.nodes.items[ids[1]].w, 33.0, 0.01, "style:width beats the rule that reads the var");
    for k in 0..12 {
        frame2(&d, "", 1, ids);
    }
    near(d.nodes.items[ids[1]].w, 33.0, 0.01, "and still does when the animation ends");
    near(d.nodes.items[ids[1]].h, 100.0, 0.01, "an inline var() follows the animated var");
}

/// A property derived from an animated one (`--b: var(--w)`) follows it, on the node and in descendants.
fn testDerived(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", 0);
    let dr = style(mem, &css, "dr");
    let m = motion.fresh();
    motion.onStyle(&m, &css, -1, dr, 0.0);
    motion.step(&m, &css, dr, 50.0, 0.0);
    near(gf(&css, m.ov, P_HEIGHT), 50.0, 0.01, "a reader of a derived var follows the animated one");
    let css2 = Css.new(mem);
    parse(&css2, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css2);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(3);
    for k in 0..4 {
        frame2(&d, "dr", 0, ids);
    }
    let w = d.nodes.items[ids[2]].w;
    ok(w > 8.0 && w < 95.0, "a descendant reading the derived var follows too");
    for k in 0..12 {
        frame2(&d, "dr", 0, ids);
    }
    near(d.nodes.items[ids[2]].w, 100.0, 0.01, "and ends at the final value");
}

fn bigFrame(d: &Dom, root: string) {
    d.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let r = el(d, 0, "pa");
    d.clsDyn(r, root);
    for i in 0..1000 {
        let c = d.open(i + 1, d.tag("div"), S_TEST);
        d.cls(c, if i % 333 == 0 { "ch" } else { "mp" });
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

/// Only the readers of an animated var are rebuilt, in a big tree.
fn testBig(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..3 {
        bigFrame(&d, "none");
    }
    let t0 = micros();
    for f in 0..4 {
        bigFrame(&d, "none");
    }
    let still = (micros() - t0) / 4;
    ok(d.followed == 0, "no follower while nothing animates");
    bigFrame(&d, "");
    let before = d.followed;
    t0 = micros();
    for f in 0..4 {
        bigFrame(&d, "");
    }
    let moving = (micros() - t0) / 4;
    ok(d.followed - before == 16, "four readers of 1000 children are rebuilt each frame, not all");
    printLn(`1000 nodes, 4 readers: {still} us per frame still, {moving} us while a var animates`);
}

/// An animation without fill lets everything go: followers and the node return to their computed styles and later restyles are ordinary.
fn testCleanup(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(3);
    for k in 0..4 {
        frame2(&d, "pb", 0, ids);
    }
    ok(d.nodes.items[ids[1]].tr >= 0, "a follower while it runs");
    for k in 0..14 {
        frame2(&d, "pb", 0, ids);
    }
    let n1 = &d.nodes.items[ids[1]];
    ok(n1.tr < 0 && n1.style == n1.tstyle, "the follower is released and back on its computed style");
    let n0 = &d.nodes.items[ids[0]];
    ok(!motion.active(&d.trs.items[n0.tr]) && n0.style == n0.tstyle, "so is the node");
    near(d.nodes.items[ids[1]].w, 0.0, 0.01, "reading the base value again");
    ok(d.animating == 0, "nothing counted as running");
    let r0 = d.restyled;
    let f0 = d.followed;
    for k in 0..5 {
        frame2(&d, "pb", 0, ids);
    }
    ok(d.restyled == r0 && d.followed == f0, "idle frames restyle and rebuild nothing");
    frame2(&d, "mp", 0, ids);
    ok(d.restyled > r0, "a class change restyles as usual");
    for k in 0..3 {
        frame2(&d, "mp", 0, ids);
    }
    ok(d.animating == 0 && d.nodes.items[ids[1]].tr < 0, "and starts nothing");
}

/// Hot reload: `Css.reset` and `parse` again register the properties anew and the animation runs.
fn testReload(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, SHEET, "prop.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(5);
    for k in 0..4 {
        frame(&d, "", ids);
    }
    css.reset();
    ok(css.regs.len == 0, "reset forgets the registrations");
    parse(&css, SHEET, "prop.css", S_TEST);
    ok(css.regs.len == 4, "parse registers them again");
    d.restyle();
    frame(&d, "mp", ids);
    ok(d.nodes.items[ids[1]].tr < 0 && d.animating == 0, "the reload let go of every follower");
    for k in 0..3 {
        frame(&d, "", ids);
    }
    let w = d.nodes.items[ids[1]].w;
    ok(w > 5.0 && w < 95.0, "the animation runs after a reload");
    for k in 0..14 {
        frame(&d, "", ids);
    }
    near(d.nodes.items[ids[1]].w, 100.0, 0.01, "and ends");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    testTransitions(&mem);
    testKeyframes(&mem);
    testDescendants(&mem);
    testInline(&mem);
    testDerived(&mem);
    testBig(&mem);
    testCleanup(&mem);
    testReload(&mem);
    printLn(`prop_test ok, checks passed: {CHECKS}`);
}
