// Tests for enter / leave transitions (Dom.trans, Trans table): fade, fly, slide, scale in both directions, `in:` only,
// different kinds per direction, a leave started mid-enter, hit testing of a flying box, the state freed with the node, idle frames.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/transition_test.j3 --headless

module transition_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.anim;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CLICKED: int;

/// `Css.eases` index of the next `frame` (1 linear, 3 ease-out).
#[singleton]
let EASE: int;

/// The sibling after the sliding box in `slideFrame`.
#[singleton]
let SIB: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    if a - b > 0.02 || b - a > 0.02 {
        printLn(`FAIL: {msg}: {a} vs {b}`);
        panic(msg);
    }
}

const SHEET: string = ".e { width: 100px; height: 20px; } .s { width: 50px; height: 10px; } .row { display: flex; } .col { display: flex; flex-direction: column; }";

/// One element `.e` (when `on`) with transitions: enter kind `ik`, leave kind `ok_`, 160 ms, linear; fly (40, 0), scale from 0.5.
fn frame(d: &Dom, on: bool, ik: int, ok_: int): int {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    let e = -1;
    if on {
        e = d.open(0, d.tag("div"), 1);
        d.cls(e, "e");
        d.trans(e, ik, 160.0, ok_, 160.0, EASE, 40.0, 0.0, 0.5, 0);
        CLICKED = if d.clicked(e) { 1 } else { 0 };
        d.close();
    }
    d.layout();
    d.endFrame();
    return e;
}

fn run(d: &Dom, on: bool, ik: int, ok_: int, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d, on, ik, ok_);
    }
}

/// What the kind shows at amount `a`: fly offset, scale.
fn check(d: &Dom, e: int, k: int, a: f32, msg: string) {
    near(d.trAmt(e), a, `{msg}: amount`);
    near(d.trDx(e), if k == 2 { 40.0 * (1.0 - a) } else { 0.0 }, `{msg}: fly offset`);
    near(d.trScale(e), if k == 4 { 0.5 + 0.5 * a } else { 1.0 }, `{msg}: scale`);
}

fn kindTest(d: &Dom, k: int) {
    run(d, false, k, k, 2);
    let e = frame(d, true, k, k);
    ok(d.trns.len == 1 && d.nodes.items[e].trn == 0, "one record");
    ok(d.trKind(e) == k, "enter plays its kind");
    check(d, e, k, 0.0, "enter start");
    let laid = d.laid;
    let rest = d.restyled;
    run(d, true, k, k, 5);
    check(d, e, k, 0.5, "enter mid");
    ok((k == 3 || d.laid == laid) && d.restyled == rest, "a transition in flight neither lays out (slide does) nor restyles");
    run(d, true, k, k, 6);
    ok(d.trKind(e) == 0, "enter done");
    check(d, e, k, 1.0, "enter end");
    // steady: nothing allocates, lays out or restyles
    let used = d.mem.used;
    laid = d.laid;
    rest = d.restyled;
    run(d, true, k, k, 10);
    ok(d.mem.used == used && d.laid == laid && d.restyled == rest, "steady frames are free");
    // leave
    frame(d, false, k, k);
    ok(d.ghosts == 1 && d.nodes.items[e].ghost, "removed element stays as a ghost");
    ok(d.trKind(e) == k, "leave plays its kind");
    check(d, e, k, 1.0, "leave start");
    run(d, false, k, k, 5);
    check(d, e, k, 0.5, "leave mid");
    run(d, false, k, k, 8);
    ok(d.ghosts == 0 && d.trns.len == 0, "ghost dropped, record freed");
}

/// Keyed rows `ord[0..n]` each with a fly transition.
fn rowFrame(d: &Dom, ord: []int, n: int, uids: []int, rows: []int) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    for i in 0..n {
        let r = ord[i];
        if uids[r] < 0 {
            uids[r] = d.groupNew(-1);
        }
        d.keyBegin(uids[r]);
        let e = d.open(0, d.tag("div"), 1);
        d.cls(e, "e");
        d.trans(e, 2, 160.0, 2, 160.0, 1, 40.0, 0.0, 0.5, 0);
        rows[r] = e;
        d.close();
        d.keyEnd();
    }
    d.layout();
    d.endFrame();
}

/// A keyed row that is removed (middle and tail) leaves as a ghost, then its state is freed.
fn eachTest(d: &Dom) {
    let ord = d.mem.alloc::<int>(4);
    let uids = d.mem.alloc::<int>(4);
    let rows = d.mem.alloc::<int>(4);
    for i in 0..4 {
        ord[i] = i;
        uids[i] = -1;
        rows[i] = -1;
    }
    for i in 0..14 {
        rowFrame(d, ord, 3, uids, rows);
    }
    ok(d.trns.len == 3 && d.trKind(rows[1]) == 0, "rows entered");
    ord[1] = 2;
    rowFrame(d, ord, 2, uids, rows);
    ok(d.ghosts == 1 && d.nodes.items[rows[1]].ghost && d.trKind(rows[1]) == 2, "the removed middle row leaves");
    ok(d.trKind(rows[0]) == 0 && d.trKind(rows[2]) == 0, "the others stay");
    for i in 0..14 {
        rowFrame(d, ord, 2, uids, rows);
    }
    ok(d.ghosts == 0 && d.trns.len == 2, "gone, two records left");
    rowFrame(d, ord, 1, uids, rows);
    ok(d.ghosts == 1, "the removed tail row leaves");
    for i in 0..14 {
        rowFrame(d, ord, 1, uids, rows);
    }
    ok(d.ghosts == 0 && d.trns.len == 1, "tail gone");
    // empty the root, or later tests would reuse the last row as their own element
    for i in 0..14 {
        rowFrame(d, ord, 0, uids, rows);
    }
    ok(d.ghosts == 0 && d.trns.len == 0, "all rows gone");
}

/// A flex box holding the element `.e` (when `on`; slide, 160 ms, linear, on `axis`) and a sibling `.s` after it.
fn slideFrame(d: &Dom, on: bool, mode: int): int {
    let axis = if mode == 1 { 1 } else { 0 };
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, if mode == 1 { "row" } else if mode == 2 { "col" } else { "blk" });
    let e = -1;
    if on {
        e = d.open(0, d.tag("div"), 1);
        d.cls(e, "e");
        d.trans(e, 3, 160.0, 3, 160.0, 1, 0.0, 0.0, 0.5, axis);
        d.close();
    }
    SIB = d.open(1, d.tag("div"), 1);
    d.cls(SIB, "s");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    return e;
}

fn slideRun(d: &Dom, on: bool, mode: int, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        slideFrame(d, on, mode);
    }
}

fn sibAt(d: &Dom, axis: int): f32 {
    return if axis == 1 { d.nodes.items[SIB].x } else { d.nodes.items[SIB].y };
}

/// A slide changes the size in layout while it flies, so the sibling after it sits at an interpolated place; idle after.
fn slideFlowTest(d: &Dom, axis: int) {
    // axis: 0 block flow, 1 flex row (slide-axis x), 2 flex column
    let size: f32 = if axis == 1 { 100.0 } else { 20.0 };
    slideRun(d, false, axis, 2);
    near(sibAt(d, axis), 0.0, "no box, sibling first");
    let e = slideFrame(d, true, axis);
    
    near(sibAt(d, axis), 0.0, "enter start: no space taken yet");
    slideRun(d, true, axis, 5);
    near(sibAt(d, axis), size * 0.5, "enter mid: the sibling is half way");
    let laid = d.laid;
    slideRun(d, true, axis, 1);
    ok(d.laid > laid, "a flying slide lays out each frame");
    slideRun(d, true, axis, 6);
    near(sibAt(d, axis), size, "enter end: full size");
    ok(d.trKind(e) == 0, "enter done");
    let used = d.mem.used;
    laid = d.laid;
    slideRun(d, true, axis, 10);
    ok(d.laid == laid && d.mem.used == used, "no layout once the slide is done");
    // leave: the ghost shrinks in flow
    slideFrame(d, false, axis);
    near(sibAt(d, axis), size, "leave start");
    slideRun(d, false, axis, 5);
    near(sibAt(d, axis), size * 0.5, "leave mid: the sibling is half way back");
    slideRun(d, false, axis, 8);
    near(sibAt(d, axis), 0.0, "leave end");
    laid = d.laid;
    slideRun(d, false, axis, 10);
    ok(d.laid == laid && d.ghosts == 0 && d.trns.len == 0, "idle after the leave");
}

/// Toggled every other frame: the leaving ghost comes back instead of piling up copies.
fn toggleTest(d: &Dom) {
    let on = false;
    let max_nodes = 0;
    for i in 0..100 {
        if i % 2 == 0 { on = !on; }
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d, on, 1, 1);
        ok(d.ghosts <= 1 && d.trns.len <= 1, "toggling keeps one record and at most one ghost");
        let live = 0;
        for k in 0..d.nodes.len {
            if d.nodes.items[k].kind != 0 { live += 1; }
        }
        if live > max_nodes { max_nodes = live; }
    }
    ok(max_nodes <= 4, "the node count stays bounded");
    // 100 frames: the last toggle (i == 98) turned it off: it leaves and is dropped
    run(d, true, 1, 1, 20);
    let e = frame(d, true, 1, 1);
    ok(d.trKind(e) == 0 && d.trns.len == 1, "back on and settled");
    near(d.trAmt(e), 1.0, "fully shown");
    run(d, false, 1, 1, 14);
    ok(d.ghosts == 0 && d.trns.len == 0, "off: gone");
    // a revived ghost enters from its current amount (no jump)
    e = frame(d, true, 1, 1);
    run(d, true, 1, 1, 14);
    frame(d, false, 1, 1);
    run(d, false, 1, 1, 4);
    let before = d.trAmt(e);
    let e2 = frame(d, true, 1, 1);
    ok(e2 == e && d.ghosts == 0, "the same node comes back");
    near(d.trAmt(e2), before - 0.1 + 0.0, "enters from the visual amount (one frame later)");
    run(d, true, 1, 1, 14);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    EASE = 1;
    for k in 1..5 {
        kindTest(&d, k);
    }

    // in:fly out:fade, different kinds per direction
    let e = frame(&d, true, 2, 1);
    ok(d.trKind(e) == 2, "enter is a fly");
    run(&d, true, 2, 1, 12);
    frame(&d, false, 2, 1);
    ok(d.trKind(e) == 1, "leave is a fade");
    near(d.trDx(e), 0.0, "a fade does not move");
    run(&d, false, 2, 1, 12);
    ok(d.ghosts == 0 && d.trns.len == 0, "dropped");

    // in: only: leaving removes at once
    e = frame(&d, true, 4, 0);
    run(&d, true, 4, 0, 12);
    frame(&d, false, 4, 0);
    ok(d.ghosts == 0 && d.trns.len == 0, "no out: no ghost, state freed");
    // out: only: no enter effect
    e = frame(&d, true, 0, 3);
    ok(d.trKind(e) == 0, "no in: shown at once");
    frame(&d, false, 0, 3);
    ok(d.ghosts == 1 && d.trKind(e) == 3, "out: leaves");
    run(&d, false, 0, 3, 12);
    ok(d.ghosts == 0, "dropped");

    // removed mid-enter: the leave continues from the enter's progress
    e = frame(&d, true, 1, 1);
    run(&d, true, 1, 1, 4);
    let before = d.trAmt(e);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, false, 1, 1);
    near(d.trAmt(e), before + 0.1, "leave starts at the enter progress (one frame later)");
    run(&d, false, 1, 1, 12);
    ok(d.ghosts == 0 && d.trns.len == 0, "dropped");

    // hit testing follows the fly: at the start the box is 40 px right of its layout slot
    e = frame(&d, true, 2, 2);
    CLICKED = 0;
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, true, 2, 2);
    d.simInput(10.0, 10.0, true, 0.0);
    frame(&d, true, 2, 2);
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, true, 2, 2);
    ok(CLICKED == 0, "a click on the empty layout slot misses the flying box");
    d.simInput(80.0, 10.0, false, 0.0);
    frame(&d, true, 2, 2);
    d.simInput(80.0, 10.0, true, 0.0);
    frame(&d, true, 2, 2);
    d.simInput(80.0, 10.0, false, 0.0);
    frame(&d, true, 2, 2);
    ok(CLICKED == 1, "a click on the drawn box lands");
    eachTest(&d);
    slideFlowTest(&d, 0);
    slideFlowTest(&d, 1);
    slideFlowTest(&d, 2);
    toggleTest(&d);
    // an easing preset: ease-out is ahead of linear mid enter; amount is the curve at progress 0.5
    EASE = 3;
    run(&d, false, 2, 2, 14);
    e = frame(&d, true, 2, 2);
    run(&d, true, 2, 2, 5);
    near(d.trAmt(e), anim.ease(&d.css.eases.items[3], 0.5), "ease-out mid enter follows the curve");
    ok(d.trAmt(e) > 0.6, "ease-out is ahead of linear");
    run(&d, true, 2, 2, 8);
    frame(&d, false, 2, 2);
    run(&d, false, 2, 2, 5);
    near(d.trAmt(e), 1.0 - anim.ease(&d.css.eases.items[3], 0.5), "and mirrored on the leave");
    run(&d, false, 2, 2, 8);
    EASE = 1;
    printLn("transition_test ok");
}
