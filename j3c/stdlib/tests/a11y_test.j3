// Tests for j3.ui.a11y (the semantic tree) and keyboard reach: roles, names (text, aria-label, alt, wrapping
// label, placeholder, title), states, hidden nodes, password values never in the dump, actions through `perform`,
// and a Tab walk that lands on exactly the nodes that offer `focus`.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/a11y_test.j3

module a11y_test;

use j3.io.{ printLn, readFile };
use j3.result.Result;
use j3.ui.domhtml.dumpHtml;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same, Text };
use j3.ui.a11y;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;
#[singleton]
let STATE: St;

struct St {
    checked: bool = false;
    clicks: int = 0;
    vol: f32 = 3.0;
    name: string = "Ann";
    pw: string = "hunter2";
    changes: int = 0;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = ".gone { display: none; } input { width: 120px; } button { width: 80px; }";

fn leaf(d: &Dom, slot: int, tag: string, text: string): int {
    let id = d.open(slot, d.tag(tag), 1);
    d.text(text);
    d.close();
    return id;
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    leaf(d, 0, "h1", "Settings");
    let b = d.open(1, d.tag("button"), 1);
    d.text("  Save   now ");
    if d.clicked(b) {
        STATE.clicks += 1;
    }
    d.close();
    let ic = d.open(2, d.tag("button"), 1);
    d.attrAria(ic, "Close");
    d.open(0, d.tag("svg"), 1);
    d.close();
    d.close();
    let dis = d.open(3, d.tag("button"), 1);
    d.attrDisabled(dis, true);
    d.text("Nope");
    d.close();
    let gone = d.open(4, d.tag("button"), 1);
    d.cls(gone, "gone");
    d.text("Hidden");
    d.close();
    let box = d.open(12, d.tag("div"), 1);
    d.cls(box, "gone");
    leaf(d, 0, "button", "Deep");
    d.close();
    let lb = d.open(5, d.tag("label"), 1);
    d.text("Dark mode");
    let cb = d.open(0, d.tag("input"), 1);
    d.attrType(cb, "checkbox");
    d.attrChecked(cb, STATE.checked);
    if d.clicked(cb) {
        STATE.checked = !STATE.checked;
    }
    d.close();
    d.close();
    let tb = d.open(6, d.tag("input"), 1);
    d.attrType(tb, "text");
    d.attrPlaceholder(tb, "Your name");
    if d.changed(tb) {
        STATE.name = d.strValue(tb);
        STATE.changes += 1;
    }
    d.attrText(tb, STATE.name);
    d.close();
    let pw = d.open(7, d.tag("input"), 1);
    d.attrType(pw, "password");
    d.attrAria(pw, "Passphrase");
    d.attrText(pw, STATE.pw);
    d.close();
    let rg = d.open(8, d.tag("input"), 1);
    d.attrType(rg, "range");
    d.attrMin(rg, 0.0);
    d.attrMax(rg, 10.0);
    d.attrStep(rg, 1.0);
    d.attrTitle(rg, "Volume");
    if d.changed(rg) {
        STATE.vol = d.value(rg);
    }
    d.attrValue(rg, STATE.vol);
    d.close();
    let sl = d.open(9, d.tag("select"), 1);
    d.attrAria(sl, "Color");
    d.attrText(sl, "g");
    let o1 = d.open(0, d.tag("option"), 1);
    d.attrText(o1, "r");
    d.text("Red");
    d.close();
    let o2 = d.open(1, d.tag("option"), 1);
    d.attrText(o2, "g");
    d.text("Green");
    d.close();
    d.close();
    let mi = d.open(10, d.tag("div"), 1);
    d.attrMenuItem(mi);
    d.text("Copy");
    d.close();
    let nv = d.open(11, d.tag("div"), 1);
    d.attrRole(nv, "list");
    leaf(d, 0, "p", "one");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn dump(d: &Dom, mem: &Arena): string {
    let t = Text.new(mem);
    a11y.dump(d, mem, &t);
    return t.str();
}

fn has(s: string, part: string, msg: string) {
    if !contains(s, part) {
        printLn(s);
    }
    ok(contains(s, part), msg);
}

// the roles of the HTML text tags: lists, list items, links, rules, headings h3-h6
fn htmlRoles(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    d.open(0, d.tag("div"), 1);
    let ul = d.open(0, d.tag("ul"), 1);
    let li = d.open(0, d.tag("li"), 1);
    d.text("one");
    d.close();
    d.close();
    let a = d.open(1, d.tag("a"), 1);
    d.text("link");
    d.close();
    let hr = d.open(2, d.tag("hr"), 1);
    d.close();
    let h3 = d.open(3, d.tag("h3"), 1);
    d.text("Three");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    ok(same(a11y.role(&d, ul), "list"), "ul is a list");
    ok(same(a11y.role(&d, li), "listitem"), "li is a listitem");
    ok(same(a11y.role(&d, a), "link"), "a is a link");
    ok(same(a11y.role(&d, hr), "separator"), "hr is a separator");
    ok(same(a11y.role(&d, h3), "heading"), "h3 is a heading");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    STATE = St {};
    frame(&d);
    frame(&d);
    let s = dump(&d, &mem);
    has(s, "heading \"Settings\"", "h1 is a heading named by its text");
    has(s, "button \"Save now\" actions=focus,click", "a button: text squashed, focus and click");
    has(s, "button \"Close\"", "an icon-only button takes its aria-label");
    has(s, "button \"Nope\" disabled\n", "a disabled button says so and offers nothing");
    ok(!contains(s, "Hidden") && !contains(s, "Deep"), "display: none is left out, and so is what is inside it");
    has(s, "checkbox \"Dark mode\" checked=false actions=focus,click", "a wrapping label names the checkbox");
    has(s, "textbox \"Your name\" value=\"Ann\" actions=focus,set", "placeholder names a text box, value shown");
    has(s, "textbox \"Passphrase\" secret", "a password box has a role and a name");
    ok(!contains(s, "hunter2"), "the password value never appears");
    has(s, "slider \"Volume\" min=0 max=10 now=3", "a slider: title name, min, max, now");
    has(s, "combobox \"Color\" expanded=false", "a select is a combobox");
    has(s, "option \"Green\" selected", "the chosen option is selected");
    has(s, "menuitem \"Copy\"", "menuitem attribute");
    has(s, "list\n  paragraph\n    text \"one\"", "role= attribute, plain text kept");
    // dumpHtml writes entered state, and never a password's value
    STATE.checked = true;
    frame(&d);
    ok(dumpHtml(&d, "/tmp/j3_a11y_test.html"), "dumpHtml writes");
    match readFile("/tmp/j3_a11y_test.html", &mem) {
        Result.Ok(bytes) {
            let h: string = bytes as string;
            has(h, "type=\"checkbox\" checked", "html: checkbox checked");
            has(h, "type=\"text\" value=\"Ann\"", "html: text value");
            has(h, "<select class=\"s1\" value=\"g\"", "html: select value");
            has(h, "selected>Green", "html: selected option");
            has(h, "disabled>Nope", "html: disabled");
            ok(!contains(h, "hunter2"), "html: no password value");
            ok(!contains(h, "type=\"password\" value"), "html: password has no value attribute");
        }
        Result.Err(_) { ok(false, "read snapshot back"); }
    }
    STATE.checked = false;
    frame(&d);
    // keyboard: Tab lands on exactly the nodes that offer focus, in order, then wraps
    let want = 0;
    let c = 0;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == dom.K_ELEM && a11y.actions(&d, i) != 0 {
            want += 1;
        }
    }
    ok(want == 8, "eight operable controls (disabled and hidden ones excluded)");
    let first = -1;
    let prev = -1;
    let steps = 0;
    while steps < want {
        d.simKeys("", "Tab");
        frame(&d);
        let f = d.focused();
        ok(f > prev, "Tab moves forward in document order");
        ok(a11y.actions(&d, f) != 0, "and lands on an operable node");
        prev = f;
        if first < 0 { first = f; }
        steps += 1;
    }
    d.simKeys("", "Tab");
    frame(&d);
    ok(d.focused() == first, "Tab wraps to the first control");
    ok(contains(dump(&d, &mem), "focused"), "the focus shows in the tree");
    // actions
    let cb = -1;
    let rg = -1;
    let tb = -1;
    for i in 0..d.nodes.len {
        if d.nodes.items[i].kind == dom.K_ELEM && a11y.actions(&d, i) != 0 {
            let r = a11y.role(&d, i);
            if same(r, "checkbox") { cb = i; }
            if same(r, "slider") { rg = i; }
            if same(r, "textbox") && d.nodes.items[i].ph.len > 0 { tb = i; }
        }
    }
    ok(a11y.perform(&d, cb, a11y.A_CLICK, 0.0, ""), "click is offered");
    frame(&d);
    frame(&d);
    ok(STATE.checked, "perform click flips the checkbox");
    ok(!a11y.perform(&d, cb, a11y.A_SET, 1.0, ""), "set value is not offered on a checkbox");
    ok(a11y.perform(&d, rg, a11y.A_SET, 7.0, ""), "set value on the slider");
    frame(&d);
    ok(STATE.vol == 7.0, "the slider took 7");
    ok(a11y.perform(&d, tb, a11y.A_SET, 0.0, "Bob"), "set value on the text box");
    frame(&d);
    ok(same(STATE.name, "Bob") && STATE.changes == 1, "the text box took Bob");
    htmlRoles(&mem, &css);
    CHECKS += 0;
    printLn(`a11y_test ok, checks passed: {CHECKS}`);
}
