// Tests for j3.steam achievements, stats and leaderboards: absent no-ops, fake mode, struct layouts
// for both pack rules. Run from j3c/:
//   timeout 120 target/release/j3c run stdlib/tests/steam_stats_test.j3
// Panics on the first failed check.

module steam_stats_test;

use j3.io.printLn;
use j3.steam;
use j3.steam.{ Scores, Uploaded };
use j3.sys.panic;

#[singleton]
let PCT_OK: bool;
#[singleton]
let PCT_N: int;
#[singleton]
let FOUND: u64;
#[singleton]
let FOUND_OK: bool;
#[singleton]
let FOUND_N: int;
#[singleton]
let UP_OK: bool;
#[singleton]
let UP_CHANGED: bool;
#[singleton]
let UP_RANK: i32;
#[singleton]
let UP_PREV: i32;
#[singleton]
let UP_N: int;
#[singleton]
let DL_OK: bool;
#[singleton]
let DL_N: int;
#[singleton]
let DL_COUNT: int;
#[singleton]
let RANKS: [8]i32;
#[singleton]
let SCORES: [8]i32;
#[singleton]
let USERS: [8]u64;
#[singleton]
let DET0: i32;
#[singleton]
let DET_N: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onPct(good: bool, ctx: u64) {
    PCT_OK = good;
    PCT_N += 1;
}

fn onFind(board: u64, found: bool, ctx: u64) {
    FOUND = board;
    FOUND_OK = found;
    FOUND_N += 1;
}

fn onUp(up: &Uploaded, ctx: u64) {
    UP_OK = up.ok;
    UP_CHANGED = up.changed;
    UP_RANK = up.rank;
    UP_PREV = up.prevRank;
    UP_N += 1;
}

fn onDown(s: &Scores, good: bool, ctx: u64) {
    DL_OK = good;
    DL_N += 1;
    DL_COUNT = s.count;
    for i in 0..s.count {
        if i < 8 {
            let e = s.entry(i);
            RANKS[i] = e.rank;
            SCORES[i] = e.score;
            USERS[i] = e.user;
        }
    }
    if s.count > 0 {
        let d: [4]i32 = [0, 0, 0, 0];
        DET_N = s.entryDetails(0, d[0..4]);
        DET0 = d[0];
    }
}

fn upload(board: u64, method: i32, score: i32) {
    let none: []i32 = @slice(0 as ptr, 0);
    steam.uploadScore(board, method, score, none, onUp, u64(1));
    steam.frame();
}

fn absent() {
    ok(!steam.unlock("A"), "absent unlock");
    ok(!steam.clear("A"), "absent clear");
    ok(!steam.unlocked("A"), "absent unlocked");
    ok(!steam.indicate("A", u32(1), u32(2)), "absent indicate");
    ok(steam.achievementCount() == u32(0), "absent count");
    ok(steam.achievementName(u32(0)).len == 0, "absent name");
    ok(steam.achievementAttr("A", "name").len == 0, "absent attr");
    ok(steam.statInt("s") == 0 && steam.statFloat("s") == 0.0, "absent stats");
    ok(!steam.setStatInt("s", 1) && !steam.setStatFloat("s", 1.0), "absent set");
    ok(!steam.updateAvgRate("s", 1.0, 2.0), "absent avg");
    ok(!steam.store() && !steam.resetAll(true), "absent store/reset");
    ok(steam.globalPercent("A") == 0.0 - 1.0, "absent percent");
    ok(steam.boardName(u64(1)).len == 0 && steam.boardEntryCount(u64(1)) == 0, "absent board info");
    let long = "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789";
    ok(long.len > 128, "long name is long");
    ok(!steam.unlock(long), "long name refused");
    // handlers still run, once, with failure
    steam.requestGlobalPercents(onPct, u64(0));
    steam.findBoard("b", onFind, u64(0));
    let none: []i32 = @slice(0 as ptr, 0);
    steam.uploadScore(u64(1), steam.UPLOAD_FORCE, 5, none, onUp, u64(0));
    steam.downloadScores(u64(1), steam.DOWNLOAD_GLOBAL, 1, 5, onDown, u64(0));
    steam.frame();
    ok(PCT_N == 1 && !PCT_OK, "absent percents fail");
    ok(FOUND_N == 1 && !FOUND_OK, "absent find fails");
    ok(UP_N == 1 && !UP_OK, "absent upload fails");
    ok(DL_N == 1 && !DL_OK && DL_COUNT == 0, "absent download fails");
    steam.frame();
    ok(PCT_N == 1 && FOUND_N == 1 && UP_N == 1 && DL_N == 1, "each handler runs once");
}

fn layouts() {
    let sizes = [28, 32];
    for v in 0..2 {
        let large = v == 1;
        let pick = if large { 1 } else { 0 };
        ok(steam.layAt("LeaderboardFindResult_t", steam.SIZE, large) == [12, 16][pick], "find size");
        ok(steam.layAt("LeaderboardScoreUploaded_t", steam.SIZE, large) == sizes[pick], "upload size");
        ok(steam.layAt("LeaderboardScoreUploaded_t", "hSteamLeaderboard", large) == [4, 8][pick], "upload board");
        ok(steam.layAt("LeaderboardScoreUploaded_t", "nGlobalRankPrevious", large) == [24, 28][pick], "upload prev");
        ok(steam.layAt("LeaderboardScoresDownloaded_t", steam.SIZE, large) == [20, 24][pick], "dl size");
        ok(steam.layAt("LeaderboardEntry_t", "hUGC", large) == [20, 24][pick], "entry ugc");
        ok(steam.layAt("LeaderboardEntry_t", steam.SIZE, large) == [28, 32][pick], "entry size");
        ok(steam.layAt("UserStatsStored_t", steam.SIZE, large) == [12, 16][pick], "stored size");
        ok(steam.layAt("GlobalAchievementPercentagesReady_t", "eResult", large) == 8, "pct result");
    }
}

fn fakeStats() {
    ok(!steam.unlocked("WIN"), "locked at start");
    ok(steam.unlock("WIN"), "fake unlock");
    ok(steam.unlocked("WIN"), "unlocked");
    ok(steam.clear("WIN") && !steam.unlocked("WIN"), "clear round trip");
    ok(steam.indicate("RUN", u32(3), u32(10)), "indicate");
    ok(steam.achievementCount() == u32(2), "two known");
    ok(steam.achievementName(u32(1)) == "RUN", "name by index");
    ok(steam.achievementAttr("RUN", "name") == "RUN" && steam.achievementAttr("RUN", "hidden") == "0", "attrs");
    ok(steam.setStatInt("kills", 7) && steam.statInt("kills") == 7, "int stat");
    ok(steam.setStatFloat("dist", 2.5) && steam.statFloat("dist") == 2.5, "float stat");
    ok(steam.statFloat("kills") == 0.0, "int stat is not a float stat");
    ok(steam.updateAvgRate("kph", 10.0, 2.0) && steam.statFloat("kph") == 5.0, "avg rate");
    ok(steam.updateAvgRate("kph", 10.0, 3.0) && steam.statFloat("kph") == 4.0, "avg rate accumulates");
    let n0 = steam.fakeStores();
    ok(steam.store(), "store");
    ok(steam.fakeStores() == n0 + 1, "store counted");
    steam.frame();
    steam.unlock("WIN");
    ok(steam.resetAll(false) && steam.statInt("kills") == 0 && steam.unlocked("WIN"), "reset stats only");
    ok(steam.resetAll(true) && !steam.unlocked("WIN"), "reset all");
    ok(steam.globalPercent("WIN") == 0.0 - 1.0, "percent before request");
    steam.requestGlobalPercents(onPct, u64(0));
    steam.frame();
    ok(PCT_N == 2 && PCT_OK, "fake percents delivered");
    ok(steam.globalPercent("WIN") == 50.0, "percent 50");
}

fn fakeBoards() {
    FOUND_N = 0;
    steam.findBoard("scores", onFind, u64(0));
    steam.frame();
    ok(FOUND_N == 1 && !FOUND_OK, "missing board is not found");
    steam.findOrCreateBoard("scores", steam.SORT_DESC, steam.DISPLAY_NUMERIC, onFind, u64(0));
    steam.frame();
    ok(FOUND_OK && FOUND != u64(0), "created");
    let b = FOUND;
    steam.findBoard("scores", onFind, u64(0));
    steam.frame();
    ok(FOUND_OK && FOUND == b, "found again");
    ok(steam.boardName(b) == "scores" && steam.boardEntryCount(b) == 0, "board info");

    ok(steam.fakeScore(b, u64(11), 100), "rival 1");
    ok(steam.fakeScore(b, u64(12), 300), "rival 2");
    ok(steam.fakeScore(b, u64(13), 200), "rival 3");
    ok(steam.fakeScore(b, u64(14), 200), "rival 4 ties rival 3");
    upload(b, steam.UPLOAD_KEEP_BEST, 250);
    ok(UP_OK && UP_CHANGED && UP_RANK == 2 && UP_PREV == 0, "first upload ranks 2");
    upload(b, steam.UPLOAD_KEEP_BEST, 150);
    ok(UP_OK && !UP_CHANGED && UP_RANK == 2 && UP_PREV == 2, "keep best keeps 250");
    upload(b, steam.UPLOAD_FORCE, 150);
    ok(UP_CHANGED && UP_RANK == 4 && UP_PREV == 2, "force lowers to rank 4");
    upload(b, steam.UPLOAD_KEEP_BEST, 400);
    ok(UP_CHANGED && UP_RANK == 1 && UP_PREV == 4, "better score ranks 1");
    ok(steam.boardEntryCount(b) == 5, "five players");

    // order now: 400 me, 300, 200 (13), 200 (14), 100
    steam.downloadScores(b, steam.DOWNLOAD_GLOBAL, 1, 3, onDown, u64(0));
    steam.frame();
    ok(DL_OK && DL_COUNT == 3, "top three");
    ok(RANKS[0] == 1 && RANKS[1] == 2 && RANKS[2] == 3, "ranks 1-based");
    ok(SCORES[0] == 400 && SCORES[1] == 300 && SCORES[2] == 200 && USERS[2] == u64(13), "order with insertion tiebreak");
    steam.downloadScores(b, steam.DOWNLOAD_AROUND_USER, 0 - 3, 3, onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 4 && RANKS[0] == 1 && RANKS[3] == 4, "around user clamps at the top");
    steam.downloadScores(b, steam.DOWNLOAD_GLOBAL, 4, 99, onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 2 && RANKS[0] == 4 && SCORES[1] == 100, "end clamps");
    steam.downloadScores(b, steam.DOWNLOAD_FRIENDS, 0, 0, onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 1 && SCORES[0] == 400, "friends is me");
    let ids = [u64(12), u64(14), u64(99)];
    steam.downloadScoresForUsers(b, ids[0..3], onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 2 && USERS[0] == u64(12) && USERS[1] == u64(14), "for users");

    // around the user in the middle: drop to rank 2 and ask for one row each side
    upload(b, steam.UPLOAD_FORCE, 250);
    ok(UP_RANK == 2, "back to rank 2");
    steam.downloadScores(b, steam.DOWNLOAD_AROUND_USER, 0 - 1, 1, onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 3 && SCORES[0] == 300 && SCORES[1] == 250 && SCORES[2] == 200, "around user window");
    steam.downloadScores(b, steam.DOWNLOAD_AROUND_USER, 0 - 9, 9, onDown, u64(0));
    steam.frame();
    ok(DL_COUNT == 5, "window clamps at both ends");

    // details round trip
    let d: [3]i32 = [7, 8, 9];
    steam.uploadScore(b, steam.UPLOAD_FORCE, 500, d[0..3], onUp, u64(0));
    steam.frame();
    steam.downloadScores(b, steam.DOWNLOAD_GLOBAL, 1, 1, onDown, u64(0));
    steam.frame();
    ok(DET_N == 3 && DET0 == 7, "details come back");
}

fn main() {
    absent();
    layouts();
    ok(steam.initFake(u32(480)) == steam.Status.Fake, "fake init");
    fakeStats();
    fakeBoards();
    // a changed stat is stored by shutdown, an unchanged session is not
    steam.setStatInt("late", 1);
    let n0 = steam.fakeStores();
    steam.shutdown();
    ok(steam.fakeStores() == n0 + 1, "shutdown stored the change");
    steam.initFake(u32(480));
    steam.shutdown();
    ok(steam.fakeStores() == n0 + 1, "clean shutdown does not store");
    ok(!steam.unlocked("WIN") && steam.statInt("late") == 0, "absent after shutdown");
    printLn("steam_stats_test ok");
}
