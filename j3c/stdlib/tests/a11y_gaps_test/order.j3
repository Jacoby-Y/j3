// a11y_gaps_test: tab order with disabled, modal and trap cases.

module a11y_gaps_test;

// ---- positive tabindex: 3 1 2 0 0 -1 (+ a disabled 1 and an optional modal)
#[singleton]
let ORD: [8]int;

#[singleton]
let ORD_V: [8]int;

#[singleton]
let ORD_DIS: bool;

#[singleton]
let ORD_MODAL: bool;

#[singleton]
let ORD_NO7: bool;

#[singleton]
let ORD_TRAP: bool;

fn ordFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    for i in 0..8 {
        if i == 7 && ORD_NO7 { continue; }
        if ORD_TRAP && i == 3 {
            // a trap group around the elements 3 and 4
            let g = d.open(20, d.tag("div"), 1);
            d.attrNav(g, 0, "trap");
        }
        ORD[i] = d.open(i, d.tag("div"), 1);
        d.attrTabIndexN(ORD[i], ORD_V[i]);
        if i == 6 { d.attrDisabled(ORD[i], ORD_DIS); }
        d.text("x");
        d.close();
        if ORD_TRAP && i == 4 { d.close(); }
    }
    // hidden content never takes Tab, whatever its tabindex
    let h1 = d.open(30, d.tag("div"), 1); d.cls(h1, "inv"); d.attrTabIndexN(h1, 1); d.text("h"); d.close();
    let h2 = d.open(31, d.tag("div"), 1); d.cls(h2, "none"); d.attrTabIndexN(h2, 1); d.text("h"); d.close();
    let h3 = d.open(32, d.tag("div"), 1); d.cls(h3, "none");
    let h4 = d.open(0, d.tag("div"), 1); d.attrTabIndexN(h4, 1); d.text("h"); d.close();
    d.close();
    let h5 = d.open(33, d.tag("details"), 1);
    let h6 = d.open(0, d.tag("div"), 1); d.attrTabIndexN(h6, 1); d.text("h"); d.close();
    d.close();
    if ORD_MODAL {
        let m = d.open(9, d.tag("dialog"), 1);
        d.attrOverlay(m, dom.OV_MODAL);
        ORD[0] = d.open(0, d.tag("div"), 1); d.attrTabIndexN(ORD[0], 0); d.text("m0"); d.close();
        ORD[1] = d.open(1, d.tag("div"), 1); d.attrTabIndexN(ORD[1], 2); d.text("m1"); d.close();
        ORD[2] = d.open(2, d.tag("div"), 1); d.attrTabIndexN(ORD[2], 1); d.text("m2"); d.close();
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn ordTab(d: &Dom, keys: string) {
    d.simKeys("", keys);
    ordFrame(d);
    ordFrame(d);
}

fn ordTest(mem: &Arena, css: &Css) {
    ORD_V = [3, 1, 2, 0, 0, -1, 1, 0];
    ORD_DIS = true;
    ORD_MODAL = false;
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    ordFrame(&d);
    ordFrame(&d);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab from nothing starts at the lowest tabindex");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[2], "then 2");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[0], "then 3");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[3], "then tabindex 0 in tree order");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "and the next 0 (-1 is skipped)");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[7], "a disabled tabindex=1 is skipped, the last 0 follows");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab wraps to the lowest tabindex");

    // Shift+Tab goes the other way and wraps to the end
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[7], "Shift+Tab from the first wraps to the last");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "back over the zeros");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[3], "and the first zero");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[0], "then the highest positive");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[2], "then 2");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[1], "then 1");

    // ties go in tree order; a dynamic change takes effect
    ORD_DIS = false;
    ORD_V[4] = 1;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[1]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "a tabindex changed to 1 ties with the other 1 in tree order");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[6], "disabled gone: the third 1 (tree order)");
    ORD_V[4] = 0;
    ordFrame(&d); ordFrame(&d);

    // inside a modal the order is computed within the dialog
    ORD_MODAL = true;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[2]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "in a modal: 1 then 2");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[0], "then 0");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[2], "and wraps inside the dialog");
    ORD_MODAL = false;

    ordFrame(&d); ordFrame(&d);
    // the starting point: a focused tabindex=-1 element (between the zeros) goes on to the next one after it, either way
    d.focusNode(ORD[5]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[7], "Tab from a tabindex=-1 element goes to the next after it in tree order");
    d.focusNode(ORD[5]);
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "Shift+Tab goes to the one before it");
    ok(d.focusVisible(), "a Tab-focused div with a tabindex shows :focus-visible");
    // a removed focus: Tab starts again at the first, Shift+Tab at the last
    d.focusNode(ORD[7]);
    ORD_NO7 = true;
    ordFrame(&d); ordFrame(&d);
    ok(d.focused() < 0, "the focused node is gone");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab after a removed focus starts at the first");
    d.focusNode(-1);
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "Shift+Tab with no focus starts at the last");

    // a focus-group trap keeps Tab inside it
    ORD_TRAP = true;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[3]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "Tab inside a trap");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[3], "wraps inside the trap");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "and back");
    ORD_TRAP = false;
    ORD_NO7 = false;
}
