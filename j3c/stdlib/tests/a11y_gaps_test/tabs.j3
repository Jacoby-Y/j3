// a11y_gaps_test: tab order of a tablist.

module a11y_gaps_test;

#[singleton]
let TAB: TabIds;

struct TabIds {
    a: int = -1;
    b: int = -1;
    c: int = -1;
}

fn tabFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    TAB.a = d.open(0, d.tag("button"), 1);
    d.text("A");
    d.close();
    TAB.b = d.open(1, d.tag("div"), 1);
    d.attrTabIndexOff(TAB.b);
    d.text("B");
    d.close();
    TAB.c = d.open(2, d.tag("button"), 1);
    d.text("C");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn tabTest(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    TAB = TabIds {};
    tabFrame(&d);
    tabFrame(&d);
    d.focusNode(TAB.a);
    d.simKeys("", "Tab");
    tabFrame(&d);
    tabFrame(&d);
    ok(d.focused() == TAB.c, "Tab skips tabindex=-1");
    d.simKeys("", "S+Tab");
    tabFrame(&d);
    tabFrame(&d);
    ok(d.focused() == TAB.a, "Shift+Tab skips it too");
    ok(a11y.perform(&d, TAB.b, a11y.A_FOCUS, 0.0, ""), "AT can still focus it");
    ok(d.focused() == TAB.b, "focusNode reaches a tabindex=-1 element");
}
