// a11y_gaps_test: idle frames queue nothing.

module a11y_gaps_test;

fn quietFrame(d: &Dom, f: int) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    d.open(0, d.tag("div"), 1);
    let sp = d.open(0, d.tag("div"), 1);
    d.attrLive(sp, "polite");
    d.attrSelected(sp, f % 2 == 0);
    d.text(if f % 2 == 0 { "one" } else { "two" });
    d.close();
    let b = d.open(1, d.tag("button"), 1);
    d.attrAria(b, if f % 2 == 0 { "A" } else { "B" });
    d.close();
    if f % 3 == 0 {
        let x = d.open(2, d.tag("button"), 1);
        d.text("extra");
        d.close();
    }
    let c = d.open(3, d.tag("input"), 1);
    d.attrType(c, "checkbox");
    d.attrChecked(c, f % 2 == 0);
    d.close();
    let t = d.open(4, d.tag("input"), 1);
    d.attrType(t, "text");
    d.attrText(t, if f % 2 == 0 { "x" } else { "yy" });
    d.close();
    let r = d.open(5, d.tag("input"), 1);
    d.attrType(r, "range");
    d.attrValue(r, f2(f % 7));
    d.close();
    let dt = d.open(6, d.tag("details"), 1);
    d.attrOpen(dt, f % 4 < 2);
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    d.focusNode(if f % 2 == 0 { b } else { -1 });
}

fn f2(n: int): f32 {
    return f32(n);
}

/// Never enabled: all the hooks fire (text, checked, value, focus, children, live) and nothing is stored.
fn quietTest(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..10000 {
        quietFrame(&d, f);
    }
    ok(d.aevTotal == 0 && d.aev.len == 0 && d.lq.len == 0, "disabled: nothing is queued");
    ok(d.aev.items.len == 0 && d.lq.items.len == 0, "disabled: no queue storage was ever allocated");
    ok(a11y.events(&d, mem).len == 0 && a11y.liveChanges(&d, mem).len == 0, "disabled: nothing to drain");
    // enabled, the same frames fill and are bounded
    a11y.enable(&d);
    for f in 0..50 {
        quietFrame(&d, f);
    }
    ok(d.aevTotal > 0 && d.aev.len <= 256, "enabled: events queue, bounded at 256");
    ok(d.lq.len <= 1, "enabled: a live region is queued once");
}
