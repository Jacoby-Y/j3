// Tests for `vertical-align` on inline boxes in j3.ui.dom: each keyword and a length / percentage shifts the span's text and
// grows the line like a browser (super / sub / middle / text-top / text-bottom); `top` / `bottom` sit against the line box;
// mixed font sizes on one line; a wrapped line; the box of a decorated span follows its text; not inherited. Run from the repo
// root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/valign_test.j3
// Panics on the first failed check.

module valign_test;

use j3.game.{ fontAscent, fontLine, loadFont, Font };
use j3.io.printLn;
use j3.math.{ max, Vec2 };
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, Frag };
use j3.ui.inputs;
use j3.text.same;
use j3.ui.textsel;

#[singleton]
let CHECKS: int;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .narrow { width: 100px; } .sm { font-size: 8px; } .big { font-size: 32px; } .sup { vertical-align: super; } .sub { vertical-align: sub; } .top { vertical-align: top; } .bot { vertical-align: bottom; } .mid { vertical-align: middle; } .tt { vertical-align: text-top; } .tb { vertical-align: text-bottom; } .up5 { vertical-align: 5px; } .dn3 { vertical-align: -3px; } .pct { vertical-align: 50%; } .bad { vertical-align: 5; } .pill { padding: 0 4px; background: #888888; } .kid { font-size: 8px; } .box { user-select: text; }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff > 0.02 {
        printLn(`FAIL: {msg}: got {a}, want {b}`);
        panic(msg);
    }
}

struct Run {
    h: f32;
    y3: f32;
    shLast: f32;
    vmLast: int;
    y0: f32;
    y1: f32;
    y2: f32;
    boxY: f32;
    c: int;
}

fn fragN(d: &Dom, owner: int, k: int): Frag {
    let f = d.nodes.items[owner].frag0;
    while k > 0 {
        f = d.frags.items[f].next;
        k -= 1;
    }
    return d.frags.items[f];
}

/// The y of the k-th fragment, or -1 when the run has fewer.
fn fragY(d: &Dom, owner: int, k: int): f32 {
    let f = d.nodes.items[owner].frag0;
    while k > 0 && f >= 0 {
        f = d.frags.items[f].next;
        k -= 1;
    }
    if f < 0 { let none: f32 = 0.0; return none - 1.0; }
    return d.frags.items[f].y;
}

/// `class="a b"` as one or two `d.cls` calls (it takes one name).
fn addCls(d: &Dom, id: int, cls: string) {
    let sp = 0;
    while sp < cls.len && cls[sp] != 32 { sp += 1; }
    if cls.len > 0 { d.cls(id, cls[0..sp]); }
    if sp < cls.len { d.cls(id, cls[sp + 1..cls.len]); }
}

/// One frame of `ab <span class=cls>text</span> cd` in a block of class `outer`; a non-empty `inner` makes the span
/// `x<span class=inner>y</span>` instead. `user-select: text` is on the block.
fn frameOn(d: &Dom, outer: string, cls: string, inner: string, text: string): int {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let c = d.open(0, d.tag("div"), 1);
    addCls(d, c, outer);
    d.text("ab ");
    let s = d.open(0, d.tag("span"), 1);
    addCls(d, s, cls);
    if inner.len > 0 {
        d.text("x");
        let k = d.open(0, d.tag("span"), 1);
        addCls(d, k, inner);
        d.text("y");
        d.close();
    } else {
        d.text(text);
    }
    d.close();
    d.text(" cd");
    d.close();
    d.layout();
    d.endFrame();
    return c;
}

fn build(mem: &Arena, css: &Css, outer: string, cls: string, inner: string, text: string): Run {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let c = frameOn(&d, outer, cls, inner, text);
    c = frameOn(&d, outer, cls, inner, text);
    let tl = &d.frags.items[d.nodes.items[c].fragTail];
    let r = Run { h: d.nodes.items[c].h, y0: fragY(&d, c, 0), y1: fragY(&d, c, 1), y2: fragY(&d, c, 2), y3: fragY(&d, c, 3), boxY: 0.0,
        shLast: tl.sh, vmLast: tl.vm, c: c };
    if d.nodes.items[c].box0 >= 0 { r.boxY = d.boxes.items[d.nodes.items[c].box0].y; }
    return r;
}

/// Double-click the point and return the selected text.
fn dblClick(d: &Dom, outer: string, cls: string, x: f32, y: f32): string {
    d.simInput(x, y, true, 0.0);
    frameOn(d, outer, cls, "", "Rare");
    d.simInput(x, y, false, 0.0);
    frameOn(d, outer, cls, "", "Rare");
    d.simInput(x, y, true, 0.0);
    frameOn(d, outer, cls, "", "Rare");
    d.simInput(x, y, false, 0.0);
    frameOn(d, outer, cls, "", "Rare");
    return textsel.selected(d);
}

/// Hover and word selection at the middle of the shifted span's text land on the span's text, not on the unshifted spot.
fn testPick(mem: &Arena, css: &Css, cls: string, hover: bool) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let c = frameOn(&d, "box", cls, "", "Rare");
    c = frameOn(&d, "box", cls, "", "Rare");
    let f = fragN(&d, c, 1);
    let x = d.absX(c) + f.x + f.w / 2.0;
    let y = d.absY(c) + f.y + 4.0;
    if hover {
        d.simInput(x, y, false, 0.0);
        frameOn(&d, "box", cls, "", "Rare");
        frameOn(&d, "box", cls, "", "Rare");
        ok(d.hover == d.nodes.items[f.node].parent, "a decorated shifted span is hovered at its text");
    }
    ok(same(dblClick(&d, "box", cls, x, y), "Rare"), "a double click on the shifted text selects its word");
    textsel.clear(&d);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);
    let f16 = loadFont(css.fonts.items[0].path, 16);
    let f8 = loadFont(css.fonts.items[0].path, 8);
    let lh = f32(fontLine(f16));
    let asc = f32(fontAscent(f16));
    let sz: f32 = 16.0;
    let r = sz / 3.0 + 1.0;
    let sb = sz / 5.0 + 1.0;
    let half: f32 = lh * 0.5;
    let qtr = sz * 0.25;

    // baseline, and the keyword not inherited / bad values dropped
    let base = build(&mem, &css, "box", "", "",  "Rare");
    near(base.h, lh, "one plain line is the font's line height");
    near(base.y1, base.y0, "baseline: the span sits on the line's baseline");
    let bad = build(&mem, &css, "box", "bad", "",  "Rare");
    near(bad.y1 - bad.y0, 0.0, "a unitless length is dropped");

    // super / sub: raised by a third of the parent's font size + 1, lowered by a fifth + 1; the line grows by the shift
    let sup = build(&mem, &css, "box", "sup", "",  "Rare");
    near(sup.y0 - sup.y1, r, "super raises by size/3 + 1");
    near(sup.h, lh + r, "super grows the line by the raise");
    near(sup.y2, sup.y0, "text after the span is back on the baseline");
    let sub = build(&mem, &css, "box", "sub", "",  "Rare");
    near(sub.y1 - sub.y0, sb, "sub lowers by size/5 + 1");
    near(sub.h, lh + sb, "sub grows the line below");

    // lengths and percentages (of the element's own line-height); negative lowers
    let up = build(&mem, &css, "box", "up5", "",  "Rare");
    near(up.y0 - up.y1, 5.0, "5px raises 5px");
    near(up.h, lh + 5.0, "5px grows the line");
    let dn = build(&mem, &css, "box", "dn3", "",  "Rare");
    near(dn.y1 - dn.y0, 3.0, "-3px lowers 3px");
    near(dn.h, lh + 3.0, "-3px grows the line");
    let pct = build(&mem, &css, "box", "pct", "",  "Rare");
    near(pct.y0 - pct.y1, half, "50% is half the line-height");
    near(pct.h, lh + half, "50% grows the line");

    // smaller text on a bigger line: the baseline-aligned small text sits on the baseline and the line does not grow
    let sm = build(&mem, &css, "box", "sm", "",  "Rare");
    near(sm.h, lh, "a smaller span does not change the line");
    near(sm.y1 + f32(fontAscent(f8)), sm.y0 + asc, "the small span shares the baseline");
    // ... and super of it: the raise is the parent's size, the line grows when the small text pokes out
    let ssup = build(&mem, &css, "box", "sm sup", "",  "Rare");
    let a8 = f32(fontAscent(f8));
    let d8 = f32(fontLine(f8)) - a8;
    let wantA = max(asc, a8 + r);
    let wantD = max(lh - asc, d8 - r);
    near(ssup.h, wantA + wantD, "small super: line is the larger of the strut and the raised text");
    near((ssup.y0 + asc) - (ssup.y1 + a8), r, "small super: the text baseline is raised from the line's");

    // middle: the midpoint of the box at the parent's baseline + half the x-height (size / 4)
    let mid = build(&mem, &css, "box", "sm mid", "",  "Rare");
    let midRaise = qtr - (a8 - d8) / 2.0;
    near((mid.y0 + asc) - (mid.y1 + a8), midRaise, "middle raises the small text to the midline");
    // text-top / text-bottom: the box edge at the parent's content-area edge
    let tt = build(&mem, &css, "box", "sm tt", "",  "Rare");
    near((tt.y0 + asc) - (tt.y1 + a8), asc - a8, "text-top: the small text's top at the parent's ascent line");
    let tb = build(&mem, &css, "box", "sm tb", "",  "Rare");
    near((tb.y1 + a8) - (tb.y0 + asc), (lh - asc) - d8, "text-bottom: the small text's bottom at the parent's descent line");

    // top / bottom: against the line box (here the strut sets the line)
    let top = build(&mem, &css, "box", "sm top", "",  "Rare");
    near(top.h, lh, "top: a small box does not grow the line");
    near(top.y1, top.y0, "top: placed at the top edge of the line");
    let bot = build(&mem, &css, "box", "sm bot", "",  "Rare");
    near(bot.h, lh, "bottom: a small box does not grow the line");
    near(bot.y1 + f32(fontLine(f8)), top.y0 + lh, "bottom: its bottom on the line's bottom");
    // a taller top box grows the line downward (the rest stays at the top); a taller bottom box grows it upward
    let f32f = loadFont(css.fonts.items[0].path, 32);
    let tallH = f32(fontLine(f32f));
    let bigTop = build(&mem, &css, "box", "big top", "",  "Rare");
    near(bigTop.h, tallH, "top: a taller box sets the line height");
    near(bigTop.y1, bigTop.y0, "top: the taller box and the baseline text share the top edge");
    let bigBot = build(&mem, &css, "box", "big bot", "",  "Rare");
    near(bigBot.h, tallH, "bottom: a taller box sets the line height");
    near(bigBot.y0 - bigBot.y1, tallH - (lh - asc) - asc, "bottom: the baseline text is pushed down by the growth above it");

    // wrapped: every line the raised span reaches grows by the raise (the first line holds "ab" too, the last " cd")
    let wrap = build(&mem, &css, "narrow", "sup", "",  "alpha beta gamma delta");
    let plainWrap = build(&mem, &css, "narrow", "", "",  "alpha beta gamma delta");
    let lines = plainWrap.h / lh;
    ok(lines > 2.5, "wrapped: more than two lines");
    near(wrap.h, plainWrap.h + lines * r, "wrapped: each line of the span grows by the raise");
    near(wrap.y0, plainWrap.y0 + r, "wrapped: the first line's plain text moves down by the raise");

    // the decorated span's box follows its raised text
    let pill = build(&mem, &css, "box", "pill sup", "",  "Rare");
    let pill0 = build(&mem, &css, "box", "pill", "",  "Rare");
    near(pill.boxY, pill0.boxY + 0.0, "the pill box moves with the raise (line grows by the raise, box up by it)");
    near(pill.y1 - pill.boxY, pill0.y1 - pill0.boxY, "the box keeps its place around the text");

    // top group with mixed sizes: "x" (16px) and a nested 8px "y" align as one box on one baseline
    let g = build(&mem, &css, "box", "top", "kid", "");
    near(g.y1, g.y0, "top group: the 16px part sits at the line top");
    near(g.y2 + a8, g.y1 + asc, "top group: the nested small text shares the group's baseline");
    near(g.y3, g.y0, "text after a top group is on the baseline");
    near(g.h, lh, "top group: a group no taller than the line leaves it alone");
    let gb = build(&mem, &css, "box", "big top", "kid", "");
    near(gb.y2 + a8, gb.y1 + f32(fontAscent(f32f)), "big top group: the small part shares the big part's baseline");
    near(gb.h, tallH, "big top group: the line is the group's height");
    let gbot = build(&mem, &css, "box", "big bot", "kid", "");
    near(gbot.y2 + a8, gbot.y1 + f32(fontAscent(f32f)), "big bottom group: one baseline too");
    near(gbot.y3, gbot.y0, "text after a bottom group is on the baseline");

    // nested shifts accumulate and do not leak to the siblings after the span closes
    let ss = build(&mem, &css, "box", "sup", "sup", "");
    near(ss.y0 - ss.y1, r, "super: the outer text is raised once");
    near(ss.y0 - ss.y2, r + r, "super in super: the raise accumulates");
    near(ss.h, lh + r + r, "super in super: the line grows by both");
    near(ss.y3, ss.y0, "text after nested supers is back on the baseline");
    ok(ss.shLast == 0.0 && ss.vmLast == 0, "no shift leaks to the last fragment");
    let ts = build(&mem, &css, "box", "top", "sub", "");
    near(ts.y1, ts.y0, "sub in top: the top text sits at the line top");
    near(ts.y2 - ts.y1, sb, "sub in top: lowered from the group's baseline");
    near(ts.h, lh + sb, "sub in top: the group grows the line by the lowering");
    near(ts.y3, ts.y0, "sub in top: text after it is back on the baseline (the line grew downward)");
    ok(ts.shLast == 0.0 && ts.vmLast == 0, "no top mode leaks past the closing tag");
    let wsup = build(&mem, &css, "narrow", "sup", "", "alpha beta gamma delta");
    ok(wsup.shLast == 0.0 && wsup.vmLast == 0, "a span that wraps leaves nothing behind for the text after it");
    let wtop = build(&mem, &css, "narrow", "top", "", "alpha beta gamma delta");
    near(wtop.h, plainWrap.h, "a top span that wraps keeps every line's height");
    ok(wtop.vmLast == 0, "no top mode after a wrapped top span");

    // hit testing and the text position follow the shifted fragment
    testPick(&mem, &css, "pill sup", true);
    testPick(&mem, &css, "sub", false);
    testPick(&mem, &css, "sm top", false);
    testPick(&mem, &css, "pill bot", true);

    printLn(`valign_test: {CHECKS} checks passed`);
}
