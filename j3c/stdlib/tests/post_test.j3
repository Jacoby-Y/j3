// Backdrop filter parsing, cascade and retained DOM state. No window is opened.
//   timeout 60 j3c run j3c/stdlib/tests/post_test.j3
// Pixel output and GL state: post_render_test.j3, post_dom_render_test.j3 and review page captures.
module post_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;
use j3.ui.css.{ Css, MatchNode, P_BACKDROP_FILTER, P_WIDTH, V_NONE, V_PX };
use j3.ui.css.{ FILTER_NAMES, NFILTERS, P_FILTER, P_MIX_BLEND_MODE, P_PERSPECTIVE, P_ROTATE_X, P_ROTATE_Y, V_LIST, V_NUM };
use j3.ui.cssmatch.computeStyle;
use j3.ui.cssparse.parse;
use j3.ui.cssvalue.{ inherits, initial, propId };
use j3.ui.dom.{ Dom, effectsOf };

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn testValues(mem: &Arena) {
    ok(propId("backdrop-filter") == P_BACKDROP_FILTER, "property table includes backdrop-filter");
    let start = initial(P_BACKDROP_FILTER);
    ok(start.kind == V_NONE, "initial filter is none");
    ok(!inherits(P_BACKDROP_FILTER), "filter does not inherit by default");
    let values: [5]string = ["none", "blur(0)", "blur(0px)", "blur(2.5px)", "blur(64px)"];
    let sigmas: [5]f32 = [0.0, 0.0, 0.0, 2.5, 64.0];
    for i in 0..5 {
        let css = Css.new(mem);
        let src = Text.new(mem);
        src.pushStr("div { backdrop-filter: ");
        src.pushStr(values[i]);
        src.pushStr("; }");
        parse(&css, src.str(), "post.css", 0);
        ok(css.warns.len == 0 && css.decls.len == 1, `accepted {values[i]}`);
        let v = css.decls.items[0].v;
        ok(v.kind == (if i == 0 { V_NONE } else { V_PX }) && v.f == sigmas[i], `typed {values[i]}`);
    }
    let bad: [17]string = ["blur(-1px)", "blur(2)", "blur(2%)", "blur(2em)", "blur()", "blur(1px, 2px)", "blur(1px 2px)", "blur(1px) blur(2px)", "brightness(2)", "none blur(1px)", "blur(1px) none", "2px", "0", "blur(auto)", "blur(1px 0)", "blur(1deg)", "blur(1px))"];
    for i in 0..17 {
        let rejected = Css.new(mem);
        let badSrc = Text.new(mem);
        badSrc.pushStr("div { backdrop-filter: ");
        badSrc.pushStr(bad[i]);
        badSrc.pushStr("; width: 17px; }");
        parse(&rejected, badSrc.str(), "post.rejected", 0);
        ok(rejected.warns.len == 1, `diagnostic for {bad[i]}`);
        ok(rejected.decls.len == 1 && rejected.decls.items[0].prop == P_WIDTH, `invalid filter discarded, next declaration preserved: {bad[i]}`);
    }
}

fn testCascade(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, "div { backdrop-filter: blur(7px); } span { width: 30px; } .inherit { backdrop-filter: inherit; } .off { backdrop-filter: none; } .invalid { backdrop-filter: blur(3px); backdrop-filter: blur(-4px); } :root { --sigma: -4px; } .custom { backdrop-filter: blur(3px); backdrop-filter: var(--sigma); }", "cascade.css", 0);
    ok(css.warns.len == 1, "cascade has only the intended negative-radius diagnostic");
    let nodes = mem.alloc::<MatchNode>(6);
    let names: [6]string = ["", "", "inherit", "off", "invalid", "custom"];
    for i in 0..6 {
        let classes = mem.alloc::<int>(if i < 2 { 0 } else { 1 });
        if i >= 2 { classes[0] = css.intern(names[i]); }
        nodes[i] = MatchNode { tag: css.intern(if i == 0 { "div" } else { "span" }), classes: classes, parent: if i == 0 { -1 } else { 0 }, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    }
    let parent = computeStyle(&css, nodes, 0, -1);
    let pv = css.get(parent, P_BACKDROP_FILTER);
    ok(pv.kind == V_PX && pv.f == 7.0, "parent blur applied");
    let child = css.get(computeStyle(&css, nodes, 1, parent), P_BACKDROP_FILTER);
    ok(child.kind == V_NONE, "child gets none");
    let inh = css.get(computeStyle(&css, nodes, 2, parent), P_BACKDROP_FILTER);
    ok(inh.kind == V_PX && inh.f == 7.0, "explicit inherit copies filter");
    let off = css.get(computeStyle(&css, nodes, 3, parent), P_BACKDROP_FILTER);
    ok(off.kind == V_NONE, "none disables inherited filter");
    let invalid = css.get(computeStyle(&css, nodes, 4, parent), P_BACKDROP_FILTER);
    ok(invalid.kind == V_PX && invalid.f == 3.0, "invalid declaration preserves previous valid filter");
    let custom = css.get(computeStyle(&css, nodes, 5, parent), P_BACKDROP_FILTER);
    ok(custom.kind == V_PX && custom.f == 3.0, "generic custom length cannot bypass filter grammar");
}

fn testDom(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".panel { display: block; width: 120px; height: 60px; border-radius: 12px; backdrop-filter: blur(8px); } .off { backdrop-filter: none; }", "dom.css", 1);
    let d = Dom.new(mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    for frame in 0..3 {
        d.beginFrame(Vec2 { x: 320.0, y: 200.0 });
        let id = d.open(0, d.tag("div"), 1);
        d.cls(id, "panel");
        d.clsIf(id, "off", frame == 1);
        d.close();
        d.layout();
        d.endFrame();
        let n = &d.nodes.items[id];
        let v = css.get(n.style, P_BACKDROP_FILTER);
        ok(n.w == 120.0 && n.h == 60.0, "filter changes preserve box geometry");
        ok(v.kind == (if frame == 1 { V_NONE } else { V_PX }), "retained DOM filter toggles on, off, on");
        if frame != 1 { ok(v.f == 8.0, "retained DOM keeps sigma"); }
    }
}

fn testContentValues(mem: &Arena) {
    ok(propId("filter") == P_FILTER && propId("mix-blend-mode") == P_MIX_BLEND_MODE, "content property names");
    ok(propId("perspective") == P_PERSPECTIVE && propId("rotate-x") == P_ROTATE_X && propId("rotate-y") == P_ROTATE_Y, "projection extension property names");
    let empty = initial(P_FILTER);
    let perspective = initial(P_PERSPECTIVE);
    let angle = initial(P_ROTATE_X);
    ok(empty.kind == V_NONE && perspective.kind == V_NONE && angle.kind == V_NUM && angle.f == 0.0, "content/projection defaults");
    ok(!inherits(P_FILTER) && !inherits(P_MIX_BLEND_MODE) && !inherits(P_PERSPECTIVE) && !inherits(P_ROTATE_X) && !inherits(P_ROTATE_Y), "post effects are non-inherited");
    let css = Css.new(mem);
    parse(&css, "div { filter: blur(2.5px) bloom(75%) grain(0.1) scanlines(0.2) crt(0.3) brightness(120%) contrast(0.9) saturate(2) grayscale(0.4) sepia(0.5) invert(0.6) hue-rotate(0.25turn); mix-blend-mode: screen; perspective: 600px; rotate-x: -20deg; rotate-y: 0.125turn; }", "content.css", 0);
    ok(css.warns.len == 0 && css.decls.len == 5, "canonical full chain and projection parse");
    let v = css.decls.items[0].v;
    ok(v.kind == V_LIST && css.paints.len == NFILTERS, "filter typed list has one amount per renderer stage");
    let expected: [12]f32 = [2.5, 0.75, 0.1, 0.2, 0.3, 1.2, 0.9, 2.0, 0.4, 0.5, 0.6, 90.0];
    for i in 0..NFILTERS {
        ok(css.paints.items[v.i + i] == expected[i], `filter slot {i} has the right amount`);
    }
    ok(css.decls.items[1].v.i == 2 && css.decls.items[2].v.f == 600.0 && css.decls.items[3].v.f == -20.0 && css.decls.items[4].v.f == 45.0, "blend and projection typed values");
    let defaults = Css.new(mem);
    parse(&defaults, "div { filter: brightness(1.5); }", "defaults.css", 0);
    let dv = defaults.decls.items[0].v;
    ok(defaults.warns.len == 0 && defaults.paints.items[dv.i] == 0.0 && defaults.paints.items[dv.i + 5] == 1.5 && defaults.paints.items[dv.i + 6] == 1.0 && defaults.paints.items[dv.i + 7] == 1.0, "omitted filter stages are neutral");
    let bad: [25]string = ["blur(-1px)", "blur(2)", "bloom(-1)", "bloom(4.1)", "grain(1.1)", "scanlines(-0.1)", "crt(101%)", "brightness(5)", "contrast(-1)", "saturate(401%)", "grayscale(2)", "sepia(-1)", "invert(1px)", "hue-rotate(2)", "blur(2px) blur(3px)", "invert(0.2) grayscale(0.2)", "brightness(1) blur(2px)", "bloom(0.2) grain(0.1) bloom(0.3)", "noise(0.2)", "blur()", "grain(0.1,0.2)", "blur(1px) none", "none blur(1px)", "brightness(1em)", "blur(1px) unknown(1)"];
    for i in 0..25 {
        let rejected = Css.new(mem);
        let src = Text.new(mem);
        src.pushStr("div { filter: ");
        src.pushStr(bad[i]);
        src.pushStr("; width: 17px; }");
        parse(&rejected, src.str(), "invalid-content.css", 0);
        ok(rejected.warns.len == 1 && rejected.decls.len == 1 && rejected.decls.items[0].prop == P_WIDTH, `invalid chain rejected with recovery: {bad[i]}`);
        ok(rejected.paints.len == 0, "invalid chain does not allocate partial stages");
    }
    let invalidProjection = Css.new(mem);
    parse(&invalidProjection, "div { perspective: 0; perspective: -4px; perspective: 40%; rotate-x: 5; rotate-y: none; mix-blend-mode: difference; }", "projection.css", 0);
    ok(invalidProjection.warns.len == 6 && invalidProjection.decls.len == 0, "unsupported projection/blend syntax is rejected");
}

fn testContentDom(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".panel { display: block; width: 120px; height: 60px; filter: blur(4px) bloom(0.5) grain(0.1) scanlines(0.2) crt(0.3) brightness(1.5) contrast(0.9) saturate(0.8) grayscale(0.2) sepia(0.3) invert(0.4) hue-rotate(15deg); mix-blend-mode: multiply; perspective: 500px; rotate-x: 10deg; rotate-y: -15deg; } .off { filter: none; mix-blend-mode: normal; perspective: none; rotate-x: 0; rotate-y: 0; } .child { display: block; width: 20px; height: 10px; z-index: 2; }", "content-dom.css", 1);
    ok(css.warns.len == 0, "content DOM sheet parses");
    let d = Dom.new(mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    for frame in 0..3 {
        d.beginFrame(Vec2 { x: 320.0, y: 200.0 });
        let id = d.open(0, d.tag("div"), 1);
        d.cls(id, "panel");
        d.clsIf(id, "off", frame == 1);
        let child = d.open(0, d.tag("div"), 1);
        d.cls(child, "child");
        d.close();
        d.close();
        d.layout();
        d.endFrame();
        let n = &d.nodes.items[id];
        let fx = effectsOf(&d, n.style);
        ok(n.w == 120.0 && n.h == 60.0, "content effects do not change layout");
        if frame == 1 {
            ok(fx.blur == 0.0 && fx.bloom == 0.0 && fx.brightness == 1.0 && fx.contrast == 1.0 && fx.saturation == 1.0 && fx.blend == 0 && fx.perspective == 0.0 && fx.rotateX == 0.0 && fx.rotateY == 0.0, "all effects reset through retained styles");
        } else {
            ok(fx.blur == 4.0 && fx.bloom == 0.5 && fx.grain == 0.1 && fx.scanlines == 0.2 && fx.crt == 0.3, "spatial effects map to paint settings");
            ok(fx.brightness == 1.5 && fx.contrast == 0.9 && fx.saturation == 0.8 && fx.grayscale == 0.2 && fx.sepia == 0.3 && fx.invert == 0.4 && fx.hue == 15.0, "color stages map to paint settings");
            ok(fx.blend == 1 && fx.perspective == 500.0 && fx.rotateX == 10.0 && fx.rotateY == -15.0, "blend/projection map to paint settings");
        }
        let childFx = effectsOf(&d, d.nodes.items[child].style);
        ok(childFx.blur == 0.0 && childFx.blend == 0 && childFx.perspective == 0.0, "child has neutral style (parent group affects painted subtree only)");
        // An effect group is a stacking context: it holds its whole subtree, whatever the z-index inside it.
        d.stack();
        ok(d.nodes.items[id].ctx == (frame != 1), "a box with post effects is a stacking context, one without is not");
        ok(!d.nodes.items[child].lift, "z-index on a static box does nothing");
    }
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    testValues(&mem);
    testCascade(&mem);
    testDom(&mem);
    testContentValues(&mem);
    testContentDom(&mem);
    printLn(`post_test ok, checks passed: {CHECKS}`);
}
