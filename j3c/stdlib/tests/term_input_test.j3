// Tests for j3.term.input: decode (arrows, SS3, tilde keys, modifiers, Alt, Ctrl, UTF-8 and paste split across
// feeds, SGR mouse, focus, ESC timeout, garbage) and encode (cursor-key modes, F1-F12, paste injection, mouse),
// plus an encode-then-decode round trip.
//   timeout 120 j3c run j3c/stdlib/tests/term_input_test.j3
// Panics on the first failed check. In samples `@` is ESC.

module term_input_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.term.grid.MODE_CURSOR_KEYS;
use j3.term.grid.MODE_MOUSE_CLICK;
use j3.term.grid.MODE_MOUSE_DRAG;
use j3.term.grid.MODE_MOUSE_MOVE;
use j3.term.grid.MODE_MOUSE_SGR;
use j3.term.grid.MODE_PASTE;
use j3.term.ansi.Parser;
use j3.term.ansi;
use j3.term.grid.Grid;
use j3.term.input;
use j3.term.input.Decoder;
use j3.term.input.Event;
use j3.text.Text;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eqi(a: int, b: int, msg: string) {
    if a != b {
        printLn(`FAIL: {msg}: want {b} got {a}`);
        panic(msg);
    }
}

// `@` becomes ESC.
fn s(x: string, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..x.len {
        t.push(if x[i] == 0x40 { 0x1b } else { x[i] });
    }
    return t.str();
}

// One control byte as a string.
fn byte(b: u8, a: &Arena): string {
    let t = Text.new(a);
    t.push(b);
    return t.str();
}

// A string of the given byte values.
fn bs(xs: []int, a: &Arena): string {
    let t = Text.new(a);
    for x in xs {
        t.push(u8(x));
    }
    return t.str();
}

fn feed(d: &Decoder, x: string, now: int) {
    d.feed(x as []u8, now);
}

fn expectKey(d: &Decoder, key: int, mods: int, cp: i32, msg: string) {
    let ev = Event {};
    ok(d.next(0, &ev), msg);
    eqi(ev.kind, input.EV_KEY, msg);
    eqi(ev.key, key, msg);
    eqi(ev.mods, mods, msg);
    eqi(int(ev.cp), int(cp), msg);
}

fn drained(d: &Decoder, msg: string) {
    let ev = Event {};
    ok(!d.next(100000, &ev), msg);
}

// Feed `x` and expect exactly one key.
fn key1(d: &Decoder, x: string, key: int, mods: int, cp: i32, msg: string) {
    feed(d, x, 0);
    expectKey(d, key, mods, cp, msg);
    drained(d, msg);
}

fn enc(key: int, mods: int, cp: i32, modes: int, want: string, a: &Arena, msg: string) {
    let t = Text.new(a);
    input.encodeKey(key, mods, cp, modes, &t);
    if !(t.str() == want) {
        printLn(`FAIL: {msg}: want {want.len} bytes, got {t.len()}: {t.str()}`);
        panic(msg);
    }
}

fn arrows(a: &Arena) {
    let d = Decoder.new(a);
    key1(&d, s("@[A", a), input.KEY_UP, 0, 0, "up");
    key1(&d, s("@[B", a), input.KEY_DOWN, 0, 0, "down");
    key1(&d, s("@[C", a), input.KEY_RIGHT, 0, 0, "right");
    key1(&d, s("@[D", a), input.KEY_LEFT, 0, 0, "left");
    key1(&d, s("@OA", a), input.KEY_UP, 0, 0, "ss3 up");
    key1(&d, s("@OH", a), input.KEY_HOME, 0, 0, "ss3 home");
    key1(&d, s("@[F", a), input.KEY_END, 0, 0, "end");
    key1(&d, s("@[1;5A", a), input.KEY_UP, input.MOD_CTRL, 0, "ctrl up");
    key1(&d, s("@[1;2D", a), input.KEY_LEFT, input.MOD_SHIFT, 0, "shift left");
    key1(&d, s("@[1;8C", a), input.KEY_RIGHT, 7, 0, "all mods (meta ignored)");
    key1(&d, s("@[Z", a), input.KEY_TAB, input.MOD_SHIFT, 0, "shift tab");
    key1(&d, s("@[3~", a), input.KEY_DELETE, 0, 0, "delete");
    key1(&d, s("@[5;3~", a), input.KEY_PGUP, input.MOD_ALT, 0, "alt pgup");
    key1(&d, s("@[7~", a), input.KEY_HOME, 0, 0, "home 7");
    key1(&d, s("@[8~", a), input.KEY_END, 0, 0, "end 8");
    key1(&d, s("@[2~", a), input.KEY_INSERT, 0, 0, "insert");
    key1(&d, s("@[6~", a), input.KEY_PGDN, 0, 0, "pgdn");
    enc(input.KEY_UP, 0, 0, 0, s("@[A", a), a, "enc up");
    enc(input.KEY_UP, 0, 0, MODE_CURSOR_KEYS, s("@OA", a), a, "enc app up");
    enc(input.KEY_DOWN, 0, 0, MODE_CURSOR_KEYS, s("@OB", a), a, "enc app down");
    enc(input.KEY_RIGHT, 0, 0, MODE_CURSOR_KEYS, s("@OC", a), a, "enc app right");
    enc(input.KEY_LEFT, 0, 0, MODE_CURSOR_KEYS, s("@OD", a), a, "enc app left");
    enc(input.KEY_RIGHT, 0, 0, 0, s("@[C", a), a, "enc right");
    enc(input.KEY_HOME, 0, 0, MODE_CURSOR_KEYS, s("@OH", a), a, "enc app home");
    enc(input.KEY_END, 0, 0, 0, s("@[F", a), a, "enc end");
    enc(input.KEY_UP, input.MOD_CTRL, 0, MODE_CURSOR_KEYS, s("@[1;5A", a), a, "enc ctrl up in app mode");
    enc(input.KEY_TAB, input.MOD_SHIFT, 0, 0, s("@[Z", a), a, "enc shift tab");
    enc(input.KEY_DELETE, 0, 0, 0, s("@[3~", a), a, "enc delete");
    enc(input.KEY_PGDN, input.MOD_ALT, 0, 0, s("@[6;3~", a), a, "enc alt pgdn");
}

fn functionKeys(a: &Arena) {
    let codes = ["", "", "", "", "15", "17", "18", "19", "20", "21", "23", "24"];
    let ss3 = ["P", "Q", "R", "S"];
    let d = Decoder.new(a);
    for n in 0..12 {
        let k = input.KEY_F1 + n;
        let plain = Text.new(a);
        let ctrl = Text.new(a);
        if n < 4 {
            plain.pushStr(s("@O", a));
            plain.pushStr(ss3[n]);
            ctrl.pushStr(s("@[1;5", a));
            ctrl.pushStr(ss3[n]);
        } else {
            plain.pushStr(s("@[", a));
            plain.pushStr(codes[n]);
            plain.pushStr("~");
            ctrl.pushStr(s("@[", a));
            ctrl.pushStr(codes[n]);
            ctrl.pushStr(";5~");
        }
        key1(&d, plain.str(), k, 0, 0, `F{n + 1} decode`);
        key1(&d, ctrl.str(), k, input.MOD_CTRL, 0, `F{n + 1} ctrl decode`);
        enc(k, 0, 0, 0, plain.str(), a, `F{n + 1} encode`);
        enc(k, 0, 0, MODE_CURSOR_KEYS, plain.str(), a, `F{n + 1} encode app`);
        enc(k, input.MOD_CTRL, 0, 0, ctrl.str(), a, `F{n + 1} encode ctrl`);
    }
}

fn altCtrl(a: &Arena) {
    let d = Decoder.new(a);
    key1(&d, s("@x", a), input.KEY_CHAR, input.MOD_ALT, 120, "alt x");
    key1(&d, s("@@[A", a), input.KEY_UP, input.MOD_ALT, 0, "alt up");
    key1(&d, byte(3, a), input.KEY_CHAR, input.MOD_CTRL, 99, "ctrl c");
    key1(&d, byte(1, a), input.KEY_CHAR, input.MOD_CTRL, 97, "ctrl a");
    key1(&d, byte(13, a), input.KEY_ENTER, 0, 0, "enter");
    key1(&d, byte(9, a), input.KEY_TAB, 0, 0, "tab");
    key1(&d, byte(127, a), input.KEY_BACKSPACE, 0, 0, "bs 7f");
    key1(&d, byte(8, a), input.KEY_BACKSPACE, input.MOD_CTRL, 0, "bs 08 is ctrl+bs");
    key1(&d, byte(10, a), input.KEY_CHAR, input.MOD_CTRL, 106, "lf is ctrl+j");
    key1(&d, byte(0, a), input.KEY_CHAR, input.MOD_CTRL, 32, "ctrl space");
    key1(&d, byte(28, a), input.KEY_CHAR, input.MOD_CTRL, 92, "ctrl backslash");
    enc(input.KEY_CHAR, input.MOD_CTRL, 99, 0, byte(3, a), a, "enc ctrl c");
    enc(input.KEY_CHAR, input.MOD_CTRL, 67, 0, byte(3, a), a, "enc ctrl C");
    enc(input.KEY_CHAR, input.MOD_CTRL, 32, 0, byte(0, a), a, "enc ctrl space");
    enc(input.KEY_CHAR, input.MOD_CTRL, 64, 0, byte(0, a), a, "enc ctrl @");
    enc(input.KEY_CHAR, input.MOD_CTRL, 93, 0, byte(29, a), a, "enc ctrl ]");
    enc(input.KEY_CHAR, input.MOD_ALT, 120, 0, s("@x", a), a, "enc alt x");
    enc(input.KEY_CHAR, 0, 233, 0, bs([0xc3, 0xa9], a), a, "enc utf8 2 bytes");
    enc(input.KEY_CHAR, 0, 0x1f600, 0, bs([0xf0, 0x9f, 0x98, 0x80], a), a, "enc utf8 4 bytes");
    enc(input.KEY_ENTER, 0, 0, 0, byte(13, a), a, "enc enter");
    enc(input.KEY_BACKSPACE, 0, 0, 0, byte(127, a), a, "enc bs");
    enc(input.KEY_BACKSPACE, input.MOD_CTRL, 0, 0, byte(8, a), a, "enc ctrl bs");
    enc(input.KEY_TAB, 0, 0, 0, byte(9, a), a, "enc tab");
    enc(input.KEY_ESC, 0, 0, 0, byte(27, a), a, "enc esc");
}

fn utf8Split(a: &Arena) {
    let d = Decoder.new(a);
    // U+20AC (3 bytes) split 1+2, then U+1F600 (4 bytes) split 1+1+2.
    let e = bs([0xe2, 0x82, 0xac], a);
    let f = bs([0xf0, 0x9f, 0x98, 0x80], a);
    feed(&d, e[0..1], 0);
    let ev = Event {};
    ok(!d.next(0, &ev), "half a char waits");
    feed(&d, e[1..3], 0);
    expectKey(&d, input.KEY_CHAR, 0, 0x20ac, "euro");
    feed(&d, f[0..1], 0);
    feed(&d, f[1..2], 0);
    ok(!d.next(0, &ev), "still waiting");
    feed(&d, f[2..4], 0);
    expectKey(&d, input.KEY_CHAR, 0, 0x1f600, "emoji");
    drained(&d, "empty");
    // A stray continuation byte and a bad sequence come out as U+FFFD without stalling.
    feed(&d, bs([0x80, 0xe2, 0x41], a), 0);
    expectKey(&d, input.KEY_CHAR, 0, 65533, "stray continuation");
    expectKey(&d, input.KEY_CHAR, 0, 65533, "bad sequence");
    expectKey(&d, input.KEY_CHAR, 0, 65, "A after it");
}

fn paste(a: &Arena) {
    let d = Decoder.new(a);
    let ev = Event {};
    feed(&d, s("a@[200~hel", a), 0);
    expectKey(&d, input.KEY_CHAR, 0, 97, "key before paste");
    ok(!d.next(0, &ev), "paste incomplete");
    feed(&d, s("lo @[A and @[2", a), 0);
    ok(!d.next(0, &ev), "paste still open");
    // The end marker is split inside itself: ESC [ 2 | 0 1 ~.
    feed(&d, s("01~b", a), 0);
    ok(d.next(0, &ev), "paste done");
    eqi(ev.kind, input.EV_PASTE, "kind");
    ok(ev.text == s("hello @[A and ", a), "paste text verbatim");
    expectKey(&d, input.KEY_CHAR, 0, 98, "key after paste");
    drained(&d, "empty");
    // Paste split across 3 feeds, marker cut after ESC.
    feed(&d, s("@[200~one", a), 0);
    feed(&d, s("two@", a), 0);
    ok(!d.next(0, &ev), "held at ESC");
    feed(&d, s("[201~", a), 0);
    ok(d.next(0, &ev), "paste 2 done");
    ok(ev.text == "onetwo", "paste 2 text");
    // Empty paste, and one that holds a newline.
    feed(&d, s("@[200~@[201~@[200~a\nb@[201~", a), 0);
    ok(d.next(0, &ev) && ev.text == "", "empty paste");
    ok(d.next(0, &ev) && ev.text == "a\nb", "newline paste");
    // Encode: wrapped only in paste mode, and any embedded end marker is removed (even a joined one).
    let t = Text.new(a);
    input.encodePaste("hi", 0, &t);
    ok(t.str() == "hi", "raw paste");
    t.clear();
    input.encodePaste("hi", MODE_PASTE, &t);
    ok(t.str() == s("@[200~hi@[201~", a), "wrapped paste");
    t.clear();
    input.encodePaste(s("a@[201~b@[20@[201~1~c", a), MODE_PASTE, &t);
    ok(t.str() == s("@[200~ab@[201~", a) || t.str() == s("@[200~abc@[201~", a), "injection stripped");
    ok(t.str() == s("@[200~abc@[201~", a), "joined marker stripped too");
}

fn mouse(a: &Arena) {
    let d = Decoder.new(a);
    let ev = Event {};
    feed(&d, s("@[<0;10;5M@[<0;10;5m@[<64;3;4M@[<65;1;1M@[<35;2;2M@[<34;2;2M@[<2;1;1M@[<16;7;7M", a), 0);
    ok(d.next(0, &ev), "press");
    eqi(ev.kind, input.EV_MOUSE, "mouse");
    eqi(ev.x, 9, "x 0-based");
    eqi(ev.y, 4, "y 0-based");
    eqi(ev.button, input.MB_LEFT, "left");
    eqi(ev.action, input.MA_PRESS, "press action");
    ok(d.next(0, &ev), "release");
    eqi(ev.action, input.MA_RELEASE, "release action");
    eqi(ev.button, input.MB_LEFT, "release button");
    ok(d.next(0, &ev), "wheel up");
    eqi(ev.action, input.MA_WHEEL, "wheel");
    eqi(ev.button, input.MB_WHEEL_UP, "wheel up button");
    ok(d.next(0, &ev), "wheel down");
    eqi(ev.button, input.MB_WHEEL_DOWN, "wheel down button");
    ok(d.next(0, &ev), "move");
    eqi(ev.action, input.MA_MOVE, "move action");
    eqi(ev.button, input.MB_NONE, "move without button");
    ok(d.next(0, &ev), "drag");
    eqi(ev.action, input.MA_MOVE, "drag action");
    eqi(ev.button, input.MB_RIGHT, "drag button");
    ok(d.next(0, &ev), "right");
    eqi(ev.button, input.MB_RIGHT, "right press");
    ok(d.next(0, &ev), "ctrl");
    eqi(ev.mods, input.MOD_CTRL, "ctrl mouse");
    drained(&d, "mouse empty");
    // Focus.
    feed(&d, s("@[I@[O", a), 0);
    ok(d.next(0, &ev) && ev.kind == input.EV_FOCUS && ev.on, "focus in");
    ok(d.next(0, &ev) && ev.kind == input.EV_FOCUS && !ev.on, "focus out");
    // Encode.
    let m = MODE_MOUSE_CLICK | MODE_MOUSE_SGR;
    let t = Text.new(a);
    input.encodeMouse(input.MB_LEFT, input.MA_PRESS, 9, 4, 0, m, &t);
    ok(t.str() == s("@[<0;10;5M", a), "enc press");
    t.clear();
    input.encodeMouse(input.MB_LEFT, input.MA_RELEASE, 9, 4, 0, m, &t);
    ok(t.str() == s("@[<0;10;5m", a), "enc release");
    t.clear();
    input.encodeMouse(input.MB_WHEEL_DOWN, input.MA_WHEEL, 0, 0, input.MOD_CTRL, m, &t);
    ok(t.str() == s("@[<81;1;1M", a), "enc wheel ctrl");
    t.clear();
    input.encodeMouse(input.MB_LEFT, input.MA_MOVE, 1, 1, 0, m, &t);
    input.encodeMouse(input.MB_LEFT, input.MA_PRESS, 1, 1, 0, MODE_MOUSE_CLICK, &t);
    input.encodeMouse(input.MB_LEFT, input.MA_PRESS, 1, 1, 0, MODE_MOUSE_SGR, &t);
    eqi(t.len(), 0, "no drag without drag mode, no SGR, no mouse mode");
    input.encodeMouse(input.MB_LEFT, input.MA_MOVE, 1, 1, 0, m | MODE_MOUSE_DRAG, &t);
    ok(t.str() == s("@[<32;2;2M", a), "enc drag");
    t.clear();
    input.encodeMouse(input.MB_NONE, input.MA_MOVE, 1, 1, 0, m | MODE_MOUSE_DRAG, &t);
    eqi(t.len(), 0, "no bare motion in drag mode");
    input.encodeMouse(input.MB_NONE, input.MA_MOVE, 1, 1, 0, m | MODE_MOUSE_MOVE, &t);
    ok(t.str() == s("@[<35;2;2M", a), "enc bare motion");
}

fn escTimeout(a: &Arena) {
    let d = Decoder.new(a);
    let ev = Event {};
    feed(&d, s("@", a), 100);
    ok(!d.next(100, &ev), "lone ESC held");
    ok(!d.next(124, &ev), "lone ESC held until the timeout");
    ok(d.next(125, &ev), "lone ESC released");
    eqi(ev.key, input.KEY_ESC, "esc key");
    eqi(ev.mods, 0, "esc has no mods");
    ok(!d.next(500, &ev), "nothing left");
    // ESC then x quickly: Alt+x.
    feed(&d, s("@", a), 200);
    ok(!d.next(205, &ev), "held");
    feed(&d, "x", 210);
    ok(d.next(210, &ev) && ev.key == input.KEY_CHAR && ev.mods == input.MOD_ALT && ev.cp == 120, "alt x after a gap");
    // A truncated CSI waits, then its bytes come out as keys and nothing is lost.
    feed(&d, s("@[1;", a), 300);
    ok(!d.next(310, &ev), "truncated CSI waits");
    ok(d.next(330, &ev) && ev.key == input.KEY_ESC, "ESC released");
    ok(d.next(330, &ev) && ev.cp == 91, "[ as a key");
    ok(d.next(330, &ev) && ev.cp == 49, "1 as a key");
    ok(d.next(330, &ev) && ev.cp == 59, "; as a key");
    ok(!d.next(330, &ev), "all released");
    // A truncated UTF-8 lead is released as U+FFFD.
    feed(&d, bs([0xe2, 0x82], a), 400);
    ok(!d.next(401, &ev), "half char waits");
    ok(d.next(430, &ev) && ev.cp == 65533, "released as replacement");
}

fn pasteTimeout(a: &Arena) {
    let d = Decoder.new(a);
    let ev = Event {};
    feed(&d, s("@[200~abc@[20", a), 100);
    ok(!d.next(500, &ev), "open paste waits");
    ok(!d.next(1099, &ev), "open paste waits until the timeout");
    ok(d.next(1100, &ev) && ev.kind == input.EV_PASTE, "unterminated paste delivered");
    ok(ev.text == s("abc@[20", a), "held marker prefix included");
    ok(!d.next(1100, &ev), "nothing left");
    feed(&d, "z", 1200);
    expectKey(&d, input.KEY_CHAR, 0, 122, "input flows after the timeout");
}

fn garbage(a: &Arena) {
    let d = Decoder.new(a);
    // Unknown CSI (with params, intermediate, private marker), unknown SS3, a CSI cut by a control byte.
    feed(&d, s("@[99z@[?25h@[1 q@OZ@[12;@[AX", a), 0);
    expectKey(&d, input.KEY_UP, 0, 0, "up after garbage");
    expectKey(&d, input.KEY_CHAR, 0, 88, "X after garbage");
    // @[12; then ESC: the broken CSI is dropped, the ESC starts the next sequence.
    drained(&d, "empty");
    // 1000 bytes of garbage parameters never stall.
    let t = Text.new(a);
    t.push(0x1b);
    t.push(0x5b);
    for i in 0..1000 {
        t.push(0x31);
    }
    t.push(0x7a);
    t.push(0x71);
    feed(&d, t.str(), 0);
    expectKey(&d, input.KEY_CHAR, 0, 113, "q after a long CSI");
    drained(&d, "empty after long CSI");
}

fn roundTrip(a: &Arena) {
    let d = Decoder.new(a);
    let keys = [
        input.KEY_ENTER, input.KEY_TAB, input.KEY_BACKSPACE, input.KEY_ESC, input.KEY_UP, input.KEY_DOWN,
        input.KEY_LEFT, input.KEY_RIGHT, input.KEY_HOME, input.KEY_END, input.KEY_PGUP, input.KEY_PGDN,
        input.KEY_INSERT, input.KEY_DELETE,
    ];
    let n = 0;
    for m in 0..8 {
        for k in 0..12 {
            keys_check(&d, input.KEY_F1 + k, m, 0, 0, a);
            n += 1;
        }
        for k in keys {
            // ESC alone waits for the timeout by design (see escTimeout); Ctrl/Shift on Enter, Backspace(shift) and
            // Tab (ctrl) have no distinct wire form.
            if k == input.KEY_ESC || (k == input.KEY_ENTER && (m & 5) != 0) || (k == input.KEY_TAB && (m & 4) != 0) {
                continue;
            }
            if k == input.KEY_BACKSPACE && (m & 1) != 0 {
                continue;
            }
            if k == input.KEY_TAB && (m & 1) != 0 && m != 1 {
                continue;
            }
            keys_check(&d, k, m, 0, MODE_CURSOR_KEYS * (n % 2), a);
            n += 1;
        }
    }
    // Characters: plain, Alt, Ctrl+letter, non-ASCII.
    let cps = [97, 122, 65, 48, 32, 126, 233, 8364, 128512];
    for cp in cps {
        keys_check(&d, input.KEY_CHAR, 0, i32(cp), 0, a);
        keys_check(&d, input.KEY_CHAR, input.MOD_ALT, i32(cp), 0, a);
    }
    let letters = [97, 99, 122];
    for cp in letters {
        keys_check(&d, input.KEY_CHAR, input.MOD_CTRL, i32(cp), 0, a);
        keys_check(&d, input.KEY_CHAR, input.MOD_CTRL | input.MOD_ALT, i32(cp), 0, a);
    }
    ok(n > 100, "round trip covered many keys");
}

fn keys_check(d: &Decoder, key: int, mods: int, cp: i32, modes: int, a: &Arena) {
    let t = Text.new(a);
    input.encodeKey(key, mods, cp, modes, &t);
    ok(t.len() > 0, `encoded something for key {key} mods {mods}`);
    feed(d, t.str(), 0);
    expectKey(d, key, mods, cp, `round trip key {key} mods {mods}`);
    drained(d, "round trip drained");
}

fn encEv(key: int, mods: int, cp: i32, ev: int, modes: int, want: string, a: &Arena, msg: string) {
    let t = Text.new(a);
    input.encodeKeyEvent(key, mods, cp, ev, modes, &t);
    if !(t.str() == want) {
        printLn(`FAIL: {msg}: want {want.len} bytes, got {t.len()}: {t.str()}`);
        panic(msg);
    }
}

// Kitty keyboard protocol: the grid's flag stack (push, pop, set, query, per screen, reset) and the encoding.
fn kitty(a: &Arena) {
    let g = Grid.new(a, 20, 5, 0);
    let p = Parser.new(a);
    ansi.feed(&p, s("@[?u", a), &g);
    ok(g.reply.str() == s("@[?0u", a), "kitty query empty");
    g.reply.clear();
    ansi.feed(&p, s("@[>1u", a), &g);
    ansi.feed(&p, s("@[?u", a), &g);
    ok(g.reply.str() == s("@[?1u", a), "kitty query after push");
    g.reply.clear();
    let m = g.modes;
    enc(input.KEY_CHAR, input.MOD_CTRL, 105, m, s("@[105;5u", a), a, "ctrl+i disambiguated");
    enc(input.KEY_CHAR, input.MOD_CTRL, 105, 0, "\t", a, "ctrl+i legacy");
    enc(input.KEY_ESC, 0, 0, m, s("@[27u", a), a, "esc");
    enc(input.KEY_CHAR, 0, 97, m, "a", a, "plain a is text");
    enc(input.KEY_CHAR, input.MOD_SHIFT, 65, m, "A", a, "shift a is text");
    enc(input.KEY_ENTER, 0, 0, m, "\r", a, "enter stays legacy");
    enc(input.KEY_ENTER, input.MOD_SHIFT, 0, m, s("@[13;2u", a), a, "shift enter");
    enc(input.KEY_UP, input.MOD_CTRL, 0, m, s("@[1;5A", a), a, "ctrl up");
    enc(input.KEY_F1 + 2, input.MOD_SHIFT, 0, m, s("@[13;2~", a), a, "shift f3");
    encEv(input.KEY_CHAR, 0, 97, input.KEV_RELEASE, m, "", a, "no release without flag 2");
    // = 31 ; 1: every flag.
    ansi.feed(&p, s("@[=31;1u", a), &g);
    m = g.modes;
    enc(input.KEY_CHAR, 0, 97, m, s("@[97;;97u", a), a, "all keys: a with text");
    enc(input.KEY_CHAR, input.MOD_SHIFT, 65, m, s("@[97:65;2;65u", a), a, "shift a alternate + text");
    enc(input.KEY_ENTER, 0, 0, m, s("@[13u", a), a, "all keys: enter");
    enc(input.KEY_UP, 0, 0, m, s("@[A", a), a, "all keys: up");
    encEv(input.KEY_CHAR, input.MOD_CTRL, 97, input.KEV_RELEASE, m, s("@[97;5:3u", a), a, "ctrl a release");
    encEv(input.KEY_UP, 0, 0, input.KEV_REPEAT, m, s("@[1;1:2A", a), a, "up repeat");
    // = 2 ; 3 clears bit 2 (event types).
    ansi.feed(&p, s("@[=2;3u@[?u", a), &g);
    ok(g.reply.str() == s("@[?29u", a), "kitty and-not");
    g.reply.clear();
    // The alt screen has its own stack; leaving it brings the primary's back.
    ansi.feed(&p, s("@[?1049h@[?u", a), &g);
    ok(g.reply.str() == s("@[?0u", a), "alt stack empty");
    g.reply.clear();
    ansi.feed(&p, s("@[?1049l@[<u@[?u", a), &g);
    ok(g.reply.str() == s("@[?0u", a), "popped to base");
    g.reply.clear();
    ansi.feed(&p, s("@[>8u@c@[?u", a), &g);
    ok(g.reply.str() == s("@[?0u", a), "RIS clears the stack");
}

fn main() {
    let a = Arena.create(64 * 1024 * 1024);
    arrows(&a);
    kitty(&a);
    functionKeys(&a);
    altCtrl(&a);
    utf8Split(&a);
    paste(&a);
    mouse(&a);
    escTimeout(&a);
    pasteTimeout(&a);
    garbage(&a);
    roundTrip(&a);
    printLn("term_input_test ok");
}
