// Data grid (plan 023 stage 6a): the cell model in `j3.ui.gridstate` (no Dom) and the keyboard / edit lifecycle of
// `j3.ui.grid` on a hand-built `virtual`-style box (rows built for the window only, like the generated code), at
// 100000 x 50. No window, SDL_ttf only. Run: SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy j3c run j3c/stdlib/tests/grid_test.j3
module grid_test;
use j3.memory.{ Arena, List };
use j3.game;
use j3.io.printLn;
use j3.sys.panic;
use j3.text.{ same, Text };
use j3.math.Vec2;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, K_FREE };
use j3.ui.grid;
use j3.ui.gridstate.{ Grid, MAX_BYTES, MAX_CELLS };
use j3.ui.tsv;
use j3.ui.inputs;
use j3.ui.uastyle;
use j3.ui.vlist;
use j3.ui.vstate.VList;

#[singleton] let G: Grid;
#[singleton] let CELLS: Text;
#[singleton] let BOX: int;
#[singleton] let CHECKS: int;
#[singleton] let EVN: int;
#[singleton] let EVK: int;
#[singleton] let EVR: int;
#[singleton] let EVC: int;
#[singleton] let EVT: Text;
#[singleton] let G2: Grid;
#[singleton] let G3: Grid;
#[singleton] let VL3: VList;
#[singleton] let TALL: bool;
#[singleton] let VL: VList;
#[singleton] let VL2: VList;
#[singleton] let BOX2: int;
#[singleton] let PLAIN: bool;
#[singleton] let TWO: bool;
#[singleton] let NR: int;
#[singleton] let SPAN: int;
#[singleton] let PASTE: string;
#[singleton] let PN: int;
#[singleton] let PT: Text;
#[singleton] let PR: int;
#[singleton] let PC: int;
#[singleton] let CT: Text;
#[singleton] let SPECIAL: bool;
#[singleton] let FZ: bool;
#[singleton] let EVRZ: int;
const ROWS: int = 100000;
const COLS: int = 50;
const SHEET: string = "@font-face { font-family: T; src: url(examples/big_ui_test/assets/font.ttf); } * { margin: 0; padding: 0; box-sizing: border-box; font-family: T; font-size: 12px; } .plain { box-sizing: content-box; } .page { width: 400px; height: 150px; overflow: auto; } .body { width: 400px; height: 196px; overflow: auto; } .row { display: flex; height: 24px; } .cell { height: 24px; } input { width: 70px; height: 24px; } .tall { height: 600px; } .sel { background: #ccf; } .sheet { width: 400px; height: 220px; } .head { position: relative; width: 400px; height: 24px; overflow: hidden; } .hrow { display: flex; height: 24px; } .hc { position: relative; height: 24px; } .hc.frozen { position: absolute; top: 0; z-index: 2; } .grip { position: absolute; top: 0; right: -4px; width: 8px; height: 24px; z-index: 3; } .row { position: relative; } .cell.frozen { position: absolute; top: 0; z-index: 2; background: #fff; }";
fn ok(b: bool, s: string) { CHECKS += 1; if !b { panic(s); } }
/// Cells with data for Ctrl+arrow: rows 10..19 of columns 3..6, and everything in row 40.
fn filled(r: int, c: int): bool {
    return (r >= 10 && r < 20 && c >= 3 && c < 7) || r == 40;
}
/// One grid box built like the generated code does: `vlist.step` picks the window (and keeps the focused row alive).
fn build(d: &Dom, g: &Grid, v: &VList, which: int, plain: bool): int {
    let box = d.open(0, d.tag("div"), 1);
    d.cls(box, "body"); d.clsIf(box, "plain", plain); d.clsIf(box, "tall", which == 3); d.attrTabIndex(box);
    d.gridBind(box, g.sized(NR));
    if d.gridEdit(box) {
        if which == 1 && g.evKind == 3 { EVRZ = g.evCol; }
        if which == 1 { EVN += 1; EVK = g.evKind; EVR = g.evRow; EVC = g.evCol; EVT.clear(); EVT.pushStr(g.evText); }
        if which == 1 && g.evKind == 2 {
            PN += 1; PR = g.pasteRows; PC = g.pasteCols; PT.clear();
            for pi in 0..g.pasteRows { for pj in 0..g.pasteCols { PT.pushStr(g.pasteCell(pi, pj)); PT.push(124); } }
        }
        if g.evKind == 0 { g.draft = g.initial("cell"); }
    }
    v.cfg(24.0, 40.0, false, false);
    let w = vlist.step(d, box, v, NR);
    // The rows are unkeyed here, so `keep` (the focused row stays alive) is not exercised; `speculative/26_ui_grid` does
    SPAN = w.hi - w.lo;
    if SPAN > 200 { panic("window not bounded"); }
    for i in w.lo..w.hi {
        let tok = d.enter(i / 4096);
        let row = d.open(i % 4096, d.tag("div"), 1); d.cls(row, "row"); d.styleNum(row, 0, "width", g.total); if FZ { d.styleNum(row, 1, "padding-left", g.fw()); }
        for j in 0..COLS {
            let c = d.open(j, d.tag("div"), 1); d.cls(c, "cell"); d.clsIf(c, "active", g.on(i, j)); d.clsIf(c, "sel", g.inRange(i, j)); d.styleNum(c, 0, "width", g.w(j)); if FZ { d.clsIf(c, "frozen", g.fz(j)); d.styleNum(c, 1, "left", g.bx(j)); }
            if g.editAt(i, j) {
                let e = d.open(0, d.tag("input"), 1); d.attrType(e, "text"); if d.changed(e) { g.draft = d.strValue(e); } d.attrText(e, g.draft); d.close();
            } else {
                d.text("x");
            }
            d.close();
        }
        d.close(); d.leave(tok);
    }
    d.close();
    return box;
}
fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 400.0, y: 220.0 }); inputs.begin(d);
    if PASTE.len > 0 { grid.paste(d, &G, PASTE); PASTE = ""; }
    if FZ {
        let sh = d.open(0, d.tag("div"), 1); d.cls(sh, "sheet");
        let hd = d.open(0, d.tag("div"), 1); d.cls(hd, "head");
        let hr = d.open(0, d.tag("div"), 1); d.cls(hr, "hrow"); d.styleNum(hr, 0, "margin-left", 0.0 - G.sx); d.styleNum(hr, 1, "width", G.total); d.styleNum(hr, 2, "padding-left", G.fw());
        for j in 0..COLS {
            let hc = d.open(j, d.tag("div"), 1); d.cls(hc, "hc"); d.clsIf(hc, "frozen", G.fz(j)); d.styleNum(hc, 0, "left", G.hx(j)); d.styleNum(hc, 1, "width", G.w(j));
            let gp = d.open(0, d.tag("div"), 1); d.cls(gp, "grip"); if d.mouseDown(gp) { G.grab(j); }
            d.close(); d.close();
        }
        d.close(); d.close();
        let wr = d.open(1, d.tag("div"), 1);
        BOX = build(d, &G, &VL, 1, false);
        d.close(); d.close();
    } else if TALL {
        let pg = d.open(0, d.tag("div"), 1); d.cls(pg, "page");
        build(d, &G3, &VL3, 3, false);
        d.close();
    } else {
        BOX = build(d, &G, &VL, 1, PLAIN);
        if TWO { BOX2 = build(d, &G2, &VL2, 2, false); }
    }
    d.layout(); d.endFrame();
}
fn frames(d: &Dom, n: int) { for i in 0..n { frame(d); } }
fn key(d: &Dom, k: string) { d.simKeys("", k); frames(d, 2); }
fn type(d: &Dom, s: string) { d.simKeys(s, ""); frames(d, 2); }
fn at(r: int, c: int): bool { return G.row == r && G.col == c; }
fn editor(d: &Dom): int {
    for i in 0..d.nodes.len { if d.nodes.items[i].kind != K_FREE && d.nodes.items[i].tag == d.tInput { return i; } }
    return -1;
}
fn text(d: &Dom): string { return d.eds.items[d.nodes.items[editor(d)].edit].str(); }
fn pureModel(mem: &Arena) {
    let g = Grid.new(mem, COLS, 24.0, 80.0);
    g.sized(ROWS);
    ok(g.total == 4000.0 && g.colX(3) == 240.0 && g.colAt(239.0) == 2 && g.colAt(240.0) == 3 && g.colAt(99999.0) == 49, "column widths: total, left edge, hit test");
    ok(g.rowAt(-5.0) == 0 && g.rowAt(48.0) == 2 && g.rowAt(1000000000.0) == ROWS - 1, "row hit test clamps");
    g.setWidth(1, 120.0);
    ok(g.total == 4040.0 && g.colX(2) == 200.0, "setWidth keeps total and offsets in step");
    g.move(-1, -1); ok(at2(&g, 0, 0), "move clamps at the top left");
    g.jump(1, 0); ok(at2(&g, ROWS - 1, 0), "Ctrl+Down without data is the last row");
    g.jump(0, 1); ok(at2(&g, ROWS - 1, COLS - 1), "Ctrl+Right without data is the last column");
    g.jump(1, 0); ok(at2(&g, ROWS - 1, COLS - 1), "at the edge Ctrl+arrow stays");
    g.tab(1); ok(at2(&g, ROWS - 1, COLS - 1), "Tab at the last cell stays");
    g.homeEnd(false, true); ok(at2(&g, 0, 0), "Ctrl+Home");
    g.hasFilled = true; g.filled = filled;
    g.goto(10, 3); g.jump(1, 0); ok(at2(&g, 19, 3), "Ctrl+Down inside a run stops at its last cell");
    g.jump(1, 0); ok(at2(&g, 40, 3), "Ctrl+Down from a run end skips blanks to the next data");
    g.jump(1, 0); ok(at2(&g, ROWS - 1, 3), "Ctrl+Down past the last data runs to the edge");
    g.jump(-1, 0); ok(at2(&g, 40, 3), "Ctrl+Up from the edge stops at the first data above");
}
/// Cell text for copy: "r{row}c{col}", with awkward cells when SPECIAL.
fn cellText(r: int, c: int): string {
    if SPECIAL {
        if r == 0 && c == 1 { return "a\tb"; }
        if r == 1 && c == 0 { return "line1\nline2"; }
        if r == 1 && c == 1 { return "q\"uote\"\""; }
        if r == 2 && c == 2 { return ""; }
    }
    CT.clear(); CT.pushStr("r"); CT.pushInt(r); CT.pushStr("c"); CT.pushInt(c);
    return CT.str();
}
fn is(data: &Text, ends: &List<int>, rows: &List<int>, i: int, j: int, want: string): bool { return same(tsv.cell(data, ends, rows, i, j), want); }
fn tsvTests(mem: &Arena) {
    let o = Text.new(mem);
    tsv.field(&o, "plain"); o.push(9); tsv.field(&o, "a\tb"); o.push(9); tsv.field(&o, "say \"hi\""); o.push(9); tsv.field(&o, "x\ny");
    ok(same(o.str(), "plain\t\"a\tb\"\t\"say \"\"hi\"\"\"\t\"x\ny\""), "field quotes tab, quote and newline; quotes are doubled");
    let data = Text.new(mem); let ends = List<int>.new(mem); let rows = List<int>.new(mem);
    ok(tsv.parse("a\tb\r\nc\t\"d\te\"\"f\ng\"\n", &data, &ends, &rows, 1000, 1000) && rows.len == 2, "CRLF rows, quoted field with tab, doubled quote and newline; trailing newline ends no row");
    ok(is(&data, &ends, &rows, 0, 1, "b") && is(&data, &ends, &rows, 1, 0, "c") && is(&data, &ends, &rows, 1, 1, "d\te\"f\ng"), "parsed fields");
    tsv.parse("a\t\tb\t\n\nx", &data, &ends, &rows, 1000, 1000);
    ok(rows.len == 3 && tsv.rowLen(&rows, 0) == 4 && tsv.rowLen(&rows, 1) == 1 && tsv.rowLen(&rows, 2) == 1 && tsv.maxCols(&rows) == 4, "empty cells, trailing tab, blank line, ragged rows");
    ok(is(&data, &ends, &rows, 0, 1, "") && is(&data, &ends, &rows, 0, 2, "b") && is(&data, &ends, &rows, 0, 3, "") && is(&data, &ends, &rows, 1, 0, "") && is(&data, &ends, &rows, 1, 5, "") && is(&data, &ends, &rows, 9, 0, ""), "empty and out-of-range reads");
    tsv.parse("", &data, &ends, &rows, 1000, 1000); ok(rows.len == 0, "empty text has no rows");
    tsv.parse("\"open\tnever closed", &data, &ends, &rows, 1000, 1000); ok(rows.len == 1 && is(&data, &ends, &rows, 0, 0, "open\tnever closed"), "an unclosed quote runs to the end");
    ok(!tsv.parse("a\tb\tc\td", &data, &ends, &rows, 2, 1000) && ends.len == 2 && rows.len == 1, "cell cap truncates");
    // round trip through Grid.copyText: every awkward cell comes back
    SPECIAL = true;
    let g = Grid.new(mem, 5, 24.0, 80.0); g.sized(10); g.cells(cellText);
    g.goto(0, 0); g.ext = true; g.goto(2, 2); g.ext = false;
    let t = g.copyText();
    ok(tsv.parse(t, &data, &ends, &rows, 1000, 100000) && rows.len == 3, "copyText parses back to 3 rows");
    for i in 0..3 { for j in 0..3 { ok(is(&data, &ends, &rows, i, j, cellText(i, j)), `round trip cell {i},{j}`); } }
    SPECIAL = false;
    g.goto(4, 1); ok(same(g.copyText(), "r4c1"), "no range: the active cell is copied");
    // paste clipping, fill, short rows
    g.goto(8, 3);
    ok(g.stagePaste("1\t2\t3\n4\n5\t6\t7") && g.pasteRow == 8 && g.pasteCol == 3 && g.pasteRows == 2 && g.pasteCols == 2, "paste clips to the grid edges");
    ok(same(g.pasteCell(0, 1), "2") && same(g.pasteCell(1, 0), "4") && same(g.pasteCell(1, 1), ""), "short row reads empty");
    g.goto(1, 1); g.ext = true; g.goto(3, 2); g.ext = false;
    ok(g.stagePaste("z") && g.pasteFill && g.pasteRows == 3 && g.pasteCols == 2 && same(g.pasteCell(2, 1), "z"), "one field fills the range");
    ok(!g.stagePaste(""), "empty clipboard stages nothing");
    // cutting at the byte cap keeps a character whole
    ok(!tsv.parse("abé\tz", &data, &ends, &rows, 1000, 3) && same(tsv.cell(&data, &ends, &rows, 0, 0), "ab") && ends.len == 1, "a 2-byte character straddling the cap is dropped whole");
    ok(!tsv.parse("abé", &data, &ends, &rows, 1000, 4) || same(tsv.cell(&data, &ends, &rows, 0, 0), "abé"), "a character that fits is kept");
    ok(!tsv.parse("x\t\"ab€cd\"\ty", &data, &ends, &rows, 1000, 3) && same(tsv.cell(&data, &ends, &rows, 0, 1), "ab") && rows.len == 1 && tsv.rowLen(&rows, 0) == 2, "a quoted field cut mid-character ends the paste there");
    // a direct write to row/col collapses the range; shrinking the list keeps a consistent range
    g.sized(10); g.goto(2, 1); g.ext = true; g.goto(6, 3); g.ext = false;
    g.row = 1; g.col = 0; g.sized(10);
    ok(!g.hasRange(), "writing row/col directly collapses the range");
    g.goto(8, 0); g.ext = true; g.goto(9, 1); g.ext = false; g.sized(5);
    ok(g.row == 4 && g.ar == 4, "shrinking the list clamps both corners");
    g.ext = true; g.move(1, 0); g.ext = false;
    ok(g.row == 4 && g.r0() == 4 && g.r1() == 4, "Shift+Down after the list shrank stays in range");
    g.sized(10);
    // a big paste: field reads are O(1), so 1000 x 100 is quick and the staging buffers are reused
    let wide = Grid.new(mem, 100, 24.0, 80.0); wide.sized(1000);
    let blk = Text.new(mem);
    for r in 0..1000 { for c in 0..100 { if c > 0 { blk.push(9); } blk.push(48 + (c % 10) as u8); } blk.push(10); }
    ok(wide.stagePaste(blk.str()) && wide.pasteRows == 1000 && wide.pasteCols == 100, "1000 x 100 paste staged");
    let total = 0;
    for r in 0..1000 { for c in 0..100 { total += wide.pasteCell(r, c).len; } }
    ok(total == 100000, "every pasted cell read back");
    let u = mem.used;
    for k in 0..3 { wide.stagePaste(blk.str()); }
    ok(mem.used == u, "restaging the same paste allocates nothing");
    // a huge clipboard is bounded
    let big = Text.new(mem);
    for i in 0..(MAX_BYTES + 1000) { big.push(120); }
    g.goto(0, 0);
    ok(g.stagePaste(big.str()) && g.pdata.len() == MAX_BYTES && g.pasteRows == 1, `one huge field is cut to {g.pdata.len()} bytes`);
    big.clear();
    for i in 0..(MAX_CELLS + 5000) { big.push(120); big.push(9); }
    ok(g.stagePaste(big.str()) && g.pends.len == MAX_CELLS && g.pasteCols == 5, `many cells stop at {g.pends.len}`);
}
fn at2(g: &Grid, r: int, c: int): bool { return g.row == r && g.col == c; }
fn nth(d: &Dom, n: int, j: int): int { let c = d.nodes.items[n].first; for i in 0..j { c = d.nodes.items[c].next; } return c; }
fn headRow(d: &Dom): int { let wr = d.nodes.items[BOX].parent; return d.nodes.items[d.nodes.items[wr].prev].first; }
fn unscroll(d: &Dom) { d.scrollByX(BOX, 0.0 - d.nodes.items[BOX].scrollX); frames(d, 2); }
fn gripX(d: &Dom, hr: int, j: int): f32 { return d.absX(d.nodes.items[nth(d, hr, j)].last) + 4.0; }
fn drag(d: &Dom, x: f32, y: f32, x2: f32) {
    d.simInput(x, y, false, 0.0); frame(d); d.simInput(x, y, true, 0.0); frame(d); d.simInput(x2, y, true, 0.0); frames(d, 2); d.simInput(x2, y, false, 0.0); frames(d, 2);
}
/// Stage 6c: frozen first column, header following the scroll, resize by the header edge (a sheet with a header).
fn frozenResize(d: &Dom, mem: &Arena) {
    FZ = true; G.freeze(1); frames(d, 3);
    d.focusNode(BOX); key(d, "C+Home"); frames(d, 3);
    ok(G.fw() == 80.0 && G.fz(0) && !G.fz(1) && G.bx(0) == 0.0 && G.bx(1) == 0.0, "frozen width and flags");
    let hr = headRow(d);
    let bl = d.absX(BOX); let hl = d.absX(d.nodes.items[hr].parent);
    ok(bl == hl && d.absX(nth(d, nth(d, BOX, 0), 0)) == bl && d.absX(nth(d, hr, 0)) == hl, "frozen cell and header cell at the left edge");
    ok(d.absX(nth(d, nth(d, BOX, 0), 1)) == bl + 80.0 && d.absX(nth(d, hr, 1)) == hl + 80.0, "the next column starts where it would unfrozen");
    key(d, "C+Right");
    let sx = d.nodes.items[BOX].scrollX;
    ok(sx > 3500.0 && G.sx == sx, "scrolled sideways");
    ok(d.absX(nth(d, nth(d, BOX, 0), 0)) == bl && d.absX(nth(d, hr, 0)) == hl, "frozen body and header cells stay put while the sheet scrolls");
    ok(d.absX(nth(d, hr, 49)) == hl - sx + G.colX(49) && d.absX(nth(d, nth(d, BOX, 0), 49)) == bl - sx + G.colX(49), "the other header and body cells scroll with it, same frame");
    ok(G.colAtView(10.0) == 0 && G.colAtView(79.0) == 0 && G.colAtView(80.0) == G.colAt(80.0 + sx), "hit test: frozen columns where drawn, the rest shifted by the scroll");
    let l0 = d.laid; let r0 = d.restyled;
    d.scrollByX(BOX, -80.0); frame(d);
    ok(d.absX(nth(d, nth(d, BOX, 0), 0)) == bl && d.absX(nth(d, hr, 0)) == hl, "a scroll step keeps them in place");
    ok(d.laid - l0 < 400 && d.restyled - r0 < 400, "a horizontal scroll step costs the visible rows");
    key(d, "Left"); key(d, "Left");
    ok(G.col == 47 && d.nodes.items[BOX].scrollX < sx, "Left moves on");
    let sx2 = d.nodes.items[BOX].scrollX;
    key(d, "C+Home");
    ok(d.nodes.items[BOX].scrollX == sx2 && at(0, 0), "moving onto the frozen column leaves the scroll alone");
    key(d, "Right"); ok(at(0, 1) && d.nodes.items[BOX].scrollX < sx2 && d.absX(nth(d, nth(d, BOX, 0), 1)) >= bl + 80.0, "the next column scrolls clear of the frozen one, not under it");
    unscroll(d);
    G.goto(0, 5); frames(d, 2); G.goto(0, 1); frames(d, 2);
    ok(d.nodes.items[BOX].scrollX == 0.0 && d.absX(nth(d, nth(d, BOX, 0), 1)) == bl + 80.0, "column 1 stays right of the frozen column");
    key(d, "C+Home"); unscroll(d);
    // frozen count 2
    G.freeze(2); frames(d, 3);
    ok(G.fw() == 160.0 && d.absX(nth(d, nth(d, BOX, 0), 2)) == bl + 160.0 && d.absX(nth(d, hr, 2)) == hl + 160.0, "two frozen columns: the third starts after both");
    key(d, "C+Right"); sx = d.nodes.items[BOX].scrollX;
    ok(d.absX(nth(d, nth(d, BOX, 0), 1)) == bl + 80.0 && d.absX(nth(d, hr, 1)) == hl + 80.0 && d.absX(nth(d, nth(d, BOX, 0), 0)) == bl, "two frozen columns stay put while scrolled");
    ok(G.colAtView(100.0) == 1 && G.colAtView(170.0) == G.colAt(170.0 + sx), "hit test with two frozen columns");
    G.freeze(1); key(d, "C+Home"); unscroll(d);
    // resize by the header edge
    let gy = d.absY(d.nodes.items[nth(d, hr, 2)].last) + 6.0;
    let gx = gripX(d, hr, 2);
    let t0 = G.total; let row0 = G.row; let col0 = G.col;
    d.simInput(gx, gy, false, 0.0); frames(d, 2);
    drag(d, gx, gy, gx + 30.0);
    ok(G.w(2) == 110.0 && G.total == t0 + 30.0 && G.colX(3) == 270.0, "dragging the edge sets width, total and offsets");
    ok(d.nodes.items[nth(d, hr, 2)].w == 110.0 && d.nodes.items[nth(d, nth(d, BOX, 0), 2)].w == 110.0 && d.nodes.items[nth(d, nth(d, BOX, 3), 2)].w == 110.0, "header and body cells have the new width");
    ok(G.colAt(269.0) == 2 && G.colAt(270.0) == 3, "colAt follows");
    ok(G.row == row0 && G.col == col0 && !G.hasRange() && !G.drag && d.focused() == BOX, "selection, drag and focus untouched");
    ok(EVRZ == 2 && EVK == 3, "one resize event on release, with the column");
    // drag left past the minimum and back
    gx = gripX(d, hr, 2);
    let n0 = EVN;
    drag(d, gx, gy, gx - 500.0);
    ok(G.w(2) == 24.0 && G.total == t0 - 56.0, "the width stops at the 24 px minimum");
    gx = gripX(d, hr, 2);
    d.simInput(gx, gy, false, 0.0); frame(d); d.simInput(gx, gy, true, 0.0); frame(d);
    d.simInput(gx - 300.0, gy, true, 0.0); frame(d); ok(G.w(2) == 24.0, "still held at the minimum");
    d.simInput(gx + 50.0, gy, true, 0.0); frame(d); frame(d); ok(G.w(2) == 74.0, "and back: the width follows the pointer again");
    d.simInput(gx + 50.0, gy, false, 0.0); frames(d, 2);
    // a click on the edge without moving: no change, no event, focus kept
    gx = gripX(d, hr, 2); n0 = EVN; let wb = G.w(2);
    drag(d, gx, gy, gx);
    ok(G.w(2) == wb && EVN == n0 && d.focused() == BOX && G.rj < 0, "a click on the edge changes nothing, fires nothing, keeps focus");
    // the release outside the window ends the drag too
    d.simInput(gx, gy, false, 0.0); frame(d); d.simInput(gx, gy, true, 0.0); frame(d); d.simInput(gx + 20.0, gy, true, 0.0); frames(d, 2);
    d.simInput(-50.0, -50.0, false, 0.0); frames(d, 2);
    ok(G.rj < 0 && G.w(2) == wb + 20.0 && d.focused() == BOX, "a release outside the window ends the drag");
    // a press on the edge in the frame right after focus moved into the grid (what Tab does) keeps the focus
    d.focusNode(-1); frame(d);
    d.focusNode(BOX);
    gx = gripX(d, hr, 2);
    d.simInput(gx, gy, true, 0.0); frames(d, 2); d.simInput(gx, gy, false, 0.0); frames(d, 2);
    ok(d.focused() == BOX, "pressing the edge right after focus arrived keeps the grid focused");
    // an open editor: the press commits it, then the drag resizes
    d.focusNode(BOX); key(d, "Enter"); type(d, "e"); ok(G.editing, "editing");
    gx = gripX(d, hr, 2); wb = G.w(2); n0 = EVN;
    drag(d, gx, gy, gx + 10.0);
    ok(!G.editing && EVN > n0 && G.w(2) == wb + 10.0 && d.focused() == BOX, "a resize while editing commits the edit first, then resizes");
    // a frozen column: body padding and the next cells follow in the same frame
    gx = gripX(d, hr, 0); wb = G.w(0);
    d.simInput(gx, gy, false, 0.0); frame(d); d.simInput(gx, gy, true, 0.0); frame(d); d.simInput(gx + 20.0, gy, true, 0.0); frame(d);
    ok(G.fw() == wb + 20.0 && d.absX(nth(d, nth(d, BOX, 0), 1)) == bl + wb + 20.0 && d.absX(nth(d, hr, 1)) == hl + wb + 20.0 && d.nodes.items[nth(d, nth(d, BOX, 0), 0)].w == wb + 20.0, "resizing the frozen column moves the rest in the same frame");
    d.simInput(gx + 20.0, gy, false, 0.0); frames(d, 2);
    // drag-select across the frozen boundary while scrolled
    G.setWidth(0, 80.0); G.setWidth(2, 130.0); frames(d, 2);
    key(d, "C+Home"); unscroll(d); d.scrollByX(BOX, 300.0); frames(d, 2);
    let cy = d.absY(nth(d, BOX, 2)) + 12.0;
    let px = bl + 200.0;
    let c0 = G.colAtView(200.0);
    d.simInput(px, cy, false, 0.0); frame(d); d.simInput(px, cy, true, 0.0); frame(d);
    ok(G.col == c0 && G.row == 2 && G.drag, "a press on a scrolled cell picks the column under it");
    d.simInput(bl + 40.0, cy + 24.0, true, 0.0); frames(d, 2);
    ok(G.col == 0 && G.row == 3 && G.ac == c0 && G.hasRange() && G.inRange(2, 0) && G.inRange(3, c0), "dragging over the frozen column extends the range to column 0");
    d.simInput(bl + 140.0, cy, true, 0.0); frames(d, 2);
    ok(G.col == G.colAtView(140.0) && G.col > 0 && G.row == 2, "dragging back over a scrolled column");
    d.simInput(bl + 140.0, cy, false, 0.0); frames(d, 2);
    unscroll(d);
    FZ = false;
}
fn main() {
    // The real clipboard needs SDL video; only the offscreen driver is safe (no window, no desktop clipboard touched).
    let real = same(game.env("SDL_VIDEODRIVER"), "offscreen");
    if real { game.init("grid_test", 64, 64); } else { printLn("grid_test: SDL_VIDEODRIVER is not offscreen, skipping the real clipboard checks"); }
    let used0 = 0; let laid = 0; let rest = 0; let used = 0;
    let mem = Arena.create(512 * 1024 * 1024); let css = Css.new(&mem); uastyle.load(&css); parse(&css, SHEET, "grid.css", 1);
    G = Grid.new(&mem, COLS, 24.0, 80.0); G2 = Grid.new(&mem, COLS, 24.0, 80.0); G3 = Grid.new(&mem, COLS, 24.0, 80.0); VL3 = VList.new(&mem); CELLS = Text.new(&mem); EVT = Text.new(&mem); VL = VList.new(&mem); VL2 = VList.new(&mem); NR = ROWS;
    G.sized(0); PT = Text.new(&mem); CT = Text.new(&mem);
    pureModel(&mem); tsvTests(&mem);
    G = Grid.new(&mem, COLS, 24.0, 80.0);
    let d = Dom.new(&mem, &css); d.setFrameMs(16.0); d.simInput(-5.0, -5.0, false, 0.0);
    frames(&d, 3);
    ok(d.isGrid(BOX) && G.rows == ROWS, "the box is the bound grid");
    d.focusNode(BOX); frame(&d);
    key(&d, "Down"); key(&d, "Down"); key(&d, "Right");
    ok(at(2, 1), "arrows move the active cell");
    key(&d, "C+Down"); ok(at(ROWS - 1, 1) && d.nodes.items[BOX].scrollY > 2399000.0, "Ctrl+Down: last row, scrolled to it");
    key(&d, "C+Up"); ok(at(0, 1) && d.nodes.items[BOX].scrollY == 0.0, "Ctrl+Up: first row, scrolled back");
    key(&d, "C+Right"); ok(at(0, COLS - 1) && d.nodes.items[BOX].scrollX > 3500.0, "Ctrl+Right: last column in view");
    key(&d, "Tab"); ok(at(1, 0) && d.nodes.items[BOX].scrollX == 0.0, "Tab wraps to the next row");
    key(&d, "S+Tab"); ok(at(0, COLS - 1), "Shift+Tab wraps back");
    key(&d, "Home"); key(&d, "PageDown"); let page = G.row; ok(page >= 6 && page <= 8 && d.nodes.items[BOX].scrollY >= 0.0, `PageDown moves a screenful ({page})`);
    key(&d, "PageDown"); key(&d, "PageDown"); key(&d, "PageUp"); ok(G.row == 2 * page, "PageUp undoes one PageDown");
    let y = d.nodes.items[BOX].scrollY; ok(y + 196.0 >= (G.row as f32 + 1.0) * 24.0 - 1.0 && y <= G.row as f32 * 24.0, "the page's active row is in view");
    key(&d, "C+Home"); ok(at(0, 0), "Ctrl+Home");
    // editing
    key(&d, "Down"); key(&d, "Right");
    ok(EVN == 0, "no edit events yet");
    key(&d, "Enter");
    ok(G.editing && editor(&d) >= 0 && d.focused() == editor(&d) && EVN == 1 && EVK == 0 && EVR == 1 && EVC == 1, "Enter begins an edit (event) and focuses the editor");
    ok(same(text(&d), "cell"), "the editor opens with the cell text");
    type(&d, "!"); ok(same(text(&d), "cell!"), "typing goes to the editor"); key(&d, "C+z"); ok(same(text(&d), "cell"), "undo in the editor");
    key(&d, "Escape"); ok(!G.editing && editor(&d) < 0 && EVN == 1 && at(1, 1) && d.focused() == BOX, "Escape cancels: no commit event, focus back");
    key(&d, "F2"); d.eds.items[d.nodes.items[editor(&d)].edit].selectAll(); type(&d, "ab");
    key(&d, "Enter");
    ok(EVN == 3 && EVK == 1 && EVR == 1 && EVC == 1 && same(EVT.str(), "ab") && at(2, 1) && !G.editing && d.focused() == BOX, "Enter commits (row, col, text), moves down");
    type(&d, "q"); ok(G.editing && same(text(&d), "q") && EVK == 0, "a typed character begins the edit with it");
    type(&d, "r"); key(&d, "Tab");
    ok(EVK == 1 && same(EVT.str(), "qr") && at(2, 2) && !G.editing, "Tab commits and moves right");
    key(&d, "Enter"); key(&d, "S+Tab"); ok(EVK == 1 && same(EVT.str(), "cell") && at(2, 1), "Shift+Tab commits and moves left");
    // a click on another cell commits the open editor and selects the clicked cell
    key(&d, "Enter");
    d.simInput(200.0, 100.0, false, 0.0); frame(&d); d.simInput(200.0, 100.0, true, 0.0); frame(&d); d.simInput(200.0, 100.0, false, 0.0); frames(&d, 2);
    ok(EVK == 1 && !G.editing && G.row == 4 && G.col == 2 && d.focused() == BOX, "a click elsewhere commits and picks the cell");
    // wheel while editing: here the row is built only for the window (no `keep`), so its box is freed and the text is committed
    key(&d, "Enter"); ok(G.editing, "editing again"); type(&d, "w");
    d.scrollBy(BOX, 240000.0); frames(&d, 3);
    ok(!G.editing && EVK == 1 && EVR == 4 && EVC == 2 && same(EVT.str(), "cellw") && d.focused() == BOX, "the editor's row left the window: its text was committed, focus is on the grid");
    key(&d, "C+Home"); key(&d, "Down"); key(&d, "Down"); key(&d, "Down"); key(&d, "Down"); key(&d, "Down");
    // the row vanishes under the editor (the list shrank): its text is committed, not dropped
    key(&d, "Enter"); type(&d, "s"); NR = 3; frames(&d, 3);
    ok(!G.editing && EVK == 1 && EVR == 5 && same(EVT.str(), "cells"), "the list shrank under an open edit: committed");
    NR = ROWS; frames(&d, 2); key(&d, "C+Home");
    // typing two characters in the frame that starts the edit, one in the next frame, one more after: all land, in order
    d.simKeys("ab", ""); frame(&d); d.simKeys("c", ""); frame(&d); d.simKeys("d", ""); frames(&d, 2);
    ok(G.editing && same(text(&d), "abcd"), `typed text across the focus frame lands in order ({text(&d)})`);
    key(&d, "Escape");
    // a plain box (no border-box): the spacers are padding, the window must stay bounded
    PLAIN = true; frames(&d, 3); d.scrollBy(BOX, 1200000.0); frames(&d, 3);
    ok(SPAN < 40 && d.nodes.items[BOX].h > 100000.0, `content-box virtual box: window of {SPAN} rows although the box measures {d.nodes.items[BOX].h} px`);
    PLAIN = false; frames(&d, 3); key(&d, "C+Home");
    // a virtual box taller than the window (600 px, window 220) inside a scrolling page builds rows for its whole height
    TALL = true; frames(&d, 4);
    ok(SPAN >= 25 && SPAN < 60, `tall box inside a scrolling parent: {SPAN} rows built for 600 px (not just the 220 px window)`);
    TALL = false; frames(&d, 3);
    // two grids on one screen keep their own state and events
    TWO = true; frames(&d, 3); d.focusNode(BOX2); frame(&d);
    key(&d, "Down"); key(&d, "Right");
    ok(G2.row == 1 && G2.col == 1 && at(0, 0), "the focused grid moves, the other stays");
    key(&d, "Enter"); ok(G2.editing && !G.editing && G2.evKind == 0 && editor(&d) >= 0 && d.focused() == editor(&d), "an edit begins in the second grid only");
    type(&d, "k"); key(&d, "Enter");
    ok(!G2.editing && G2.evKind == 1 && G2.evRow == 1 && G2.row == 2 && at(0, 0), "and commits there");
    d.focusNode(BOX); frame(&d); key(&d, "Down"); ok(at(1, 0) && G2.row == 2, "focus back on the first grid");
    TWO = false; frames(&d, 3);
    key(&d, "C+Home");
    // edit cycles: the editor box is made per edit and freed; the arena stays flat
    for i in 0..20 { key(&d, "Enter"); type(&d, "z"); key(&d, "Enter"); key(&d, "C+Home"); }
    used0 = mem.used;
    for i in 0..1000 { key(&d, "Enter"); type(&d, "z"); key(&d, "Enter"); key(&d, "C+Home"); }
    ok(mem.used == used0, `1000 begin/commit cycles allocate nothing ({mem.used - used0} bytes)`);
    used0 = mem.used;
    for i in 0..1000 { key(&d, "Enter"); type(&d, "z"); key(&d, "Escape"); }
    ok(mem.used == used0, `1000 begin/cancel cycles allocate nothing ({mem.used - used0} bytes)`);
    // Ctrl+A/C/X/V while the cell editor is open belong to the editor, not the grid
    key(&d, "C+Home"); key(&d, "Enter"); type(&d, "hello");
    PN = 0; let pr = G.row; let pc = G.col;
    key(&d, "C+a"); ok(G.editing && !G.hasRange() && d.eds.items[d.nodes.items[editor(&d)].edit].hasSel(), "Ctrl+A selects the editor's text, not the cells");
    key(&d, "C+c"); key(&d, "C+v"); ok(G.editing && same(text(&d), "cellhello") && PN == 0 && !G.hasRange(), "Ctrl+C / Ctrl+V in the editor leave the grid alone");
    key(&d, "C+a"); key(&d, "C+x"); ok(G.editing && same(text(&d), "") && PN == 0 && !G.hasRange() && G.row == pr && G.col == pc, "Ctrl+X cuts the editor's text only");
    key(&d, "Escape");
    // range selection
    G.cells(cellText); key(&d, "C+Home");
    key(&d, "S+Down"); key(&d, "S+Down"); key(&d, "S+Right");
    ok(at(2, 1) && G.hasRange() && G.ar == 0 && G.ac == 0 && G.inRange(1, 1) && G.inRange(0, 0) && !G.inRange(3, 0) && !G.inRange(0, 2), "Shift+arrows extend a range from the anchor");
    key(&d, "S+Up"); key(&d, "S+Left"); ok(at(1, 0) && G.r1() == 1 && G.c1() == 0, "and shrink it back");
    key(&d, "Down"); ok(at(2, 0) && !G.hasRange() && !G.inRange(2, 0), "a plain move collapses the range");
    key(&d, "C+S+Right"); ok(at(2, COLS - 1) && G.ac == 0 && G.inRange(2, 30), "Ctrl+Shift+Right extends to the edge");
    key(&d, "S+Home"); ok(at(2, 0) && !G.hasRange(), "Shift+Home back to the first column");
    key(&d, "S+PageDown"); ok(G.row > 4 && G.row < 12 && G.ar == 2 && G.col == 0 && G.hasRange(), "Shift+PageDown extends a screenful");
    key(&d, "C+S+Down"); ok(G.row == ROWS - 1 && G.ar == 2 && d.nodes.items[BOX].scrollY > 2399000.0, "Ctrl+Shift+Down extends to the last row and scrolls");
    key(&d, "S+Home"); key(&d, "C+Home"); ok(at(0, 0) && !G.hasRange(), "Ctrl+Home collapses");
    key(&d, "S+End"); ok(at(0, COLS - 1) && G.ac == 0, "Shift+End extends along the row");
    key(&d, "C+a"); ok(G.r0() == 0 && G.r1() == ROWS - 1 && G.c0() == 0 && G.c1() == COLS - 1, "Ctrl+A selects everything");
    key(&d, "C+Home");
    // drag
    d.simInput(100.0, 30.0, false, 0.0); frame(&d); d.simInput(100.0, 30.0, true, 0.0); frame(&d);
    ok(at(1, 1) && !G.hasRange(), "press picks the anchor");
    d.simInput(300.0, 100.0, true, 0.0); frame(&d);
    ok(at(4, 3) && G.ar == 1 && G.ac == 1 && G.inRange(2, 2), "dragging extends the range to the pointer's cell");
    d.simInput(300.0, 100.0, false, 0.0); frames(&d, 2); d.simInput(20.0, 20.0, false, 0.0); frames(&d, 2);
    ok(at(4, 3) && G.ar == 1, "releasing keeps the range, a later move does not change it");
    d.simInput(100.0, 30.0, true, 0.0); frame(&d); d.simInput(100.0, 215.0, true, 0.0); frames(&d, 4);
    ok(G.row > 8 && d.nodes.items[BOX].scrollY > 0.0 && G.ar == 1, `dragging below the box scrolls and extends (row {G.row}, scroll {d.nodes.items[BOX].scrollY})`);
    d.simInput(100.0, 215.0, false, 0.0); frames(&d, 2); d.simInput(-5.0, -5.0, false, 0.0); frames(&d, 2);
    ok(!G.drag, "releasing ends the drag");
    key(&d, "C+Home");
    // dragging above the box at the top stays on row 0; releasing outside the window ends the drag
    d.simInput(100.0, 80.0, false, 0.0); frame(&d); d.simInput(100.0, 80.0, true, 0.0); frame(&d); d.simInput(100.0, -5.0, true, 0.0); frames(&d, 3);
    ok(G.row == 0 && G.ar == 3 && d.nodes.items[BOX].scrollY == 0.0 && G.drag, "dragging above the top clamps at the first row");
    d.simInput(-5.0, -5.0, false, 0.0); frames(&d, 2); ok(!G.drag, "releasing outside the window ends the drag");
    key(&d, "C+Home");
    // shift-click extends
    d.simInput(200.0, 100.0, false, 0.0); frame(&d); d.simInput(200.0, 100.0, true, 0.0); d.simKeys("", "Shift"); frame(&d); d.simInput(200.0, 100.0, false, 0.0); frames(&d, 2);
    ok(at(4, 2) && G.ar == 0 && G.ac == 0, "Shift+click extends from the active cell");
    d.simInput(-5.0, -5.0, false, 0.0); key(&d, "C+Home");
    // copy: no crash and the text is the range's TSV (the clipboard itself is a stub headless)
    key(&d, "S+Down"); key(&d, "S+Right"); key(&d, "C+c");
    ok(same(G.copyText(), "r0c0\tr0c1\nr1c0\tr1c1") && G.hasRange(), "Ctrl+C keeps the range; copy text is TSV");
    // the real clipboard (offscreen SDL): Ctrl+C then Ctrl+V on the keys round-trips the range elsewhere
    if real {
        key(&d, "C+c"); key(&d, "C+Home"); key(&d, "Down"); key(&d, "Down"); PN = 0; key(&d, "C+v");
        ok(PN == 1 && PR == 2 && PC == 2 && same(PT.str(), "r0c0|r0c1|r1c0|r1c1|") && G.row == 3 && G.col == 1, "Ctrl+C then Ctrl+V through the system clipboard pastes the copied range");
        game.setClipboard("a\tb\n\"c\td\"\te"); key(&d, "C+Home"); PN = 0; key(&d, "C+v");
        ok(PN == 1 && same(PT.str(), "a|b|c\td|e|"), "pasting spreadsheet text from the system clipboard");
        key(&d, "C+Home"); key(&d, "S+Down"); key(&d, "S+Right"); key(&d, "C+x");
        ok(same(game.clipboard(), "r0c0\tr0c1\nr1c0\tr1c1"), "Ctrl+X copies the range");
    }
    // paste: one event, one batch, clipped, the target becomes the selection
    PN = 0; PASTE = "a\tb\nc\td"; frames(&d, 3);
    ok(PN == 1 && PR == 2 && PC == 2 && same(PT.str(), "a|b|c|d|") && G.hasRange() && G.r1() == 1 && G.c1() == 1, "a paste is one event with the whole block");
    key(&d, "C+Home"); key(&d, "C+Down"); key(&d, "C+Right"); PN = 0; PASTE = "1\t2\n3\t4\n5\t6"; frames(&d, 3);
    ok(PN == 1 && PR == 1 && PC == 1 && same(PT.str(), "1|") && G.row == ROWS - 1 && G.col == COLS - 1 && !G.hasRange(), "pasting at the last cell clips to it");
    key(&d, "C+Home"); key(&d, "S+Down"); key(&d, "S+Down"); key(&d, "S+Right"); PN = 0; PASTE = "z"; frames(&d, 3);
    ok(PN == 1 && PR == 3 && PC == 2 && same(PT.str(), "z|z|z|z|z|z|") && G.hasRange(), "one cell pasted into a range fills it");
    PN = 0; frames(&d, 5); ok(PN == 0, "the paste event does not repeat");
    key(&d, "C+Home");
    // steady with a range selected
    key(&d, "S+Down"); key(&d, "S+Right"); frames(&d, 30);
    laid = d.laid; rest = d.restyled; used = mem.used; frames(&d, 200);
    ok(d.laid == laid && d.restyled == rest && mem.used == used, "a selected range: idle frames have zero layouts, restyles and arena growth");
    // steady
    key(&d, "C+Home"); frames(&d, 30);
    laid = d.laid; rest = d.restyled; used = mem.used; frames(&d, 300);
    ok(d.laid == laid && d.restyled == rest && mem.used == used, "100000 x 50: idle frames have zero layouts, restyles and arena growth");
    key(&d, "Enter"); frames(&d, 30);
    laid = d.laid; rest = d.restyled; used = mem.used; frames(&d, 100);
    ok(d.laid == laid && d.restyled == rest && mem.used == used, "idle while editing: zero layouts, restyles and arena growth");
    key(&d, "Escape");
    frozenResize(&d, &mem);
    printLn(`grid_test ok, checks passed: {CHECKS}`);
}
