// Tests for `letter-spacing`, `word-spacing`, `text-transform` and `text-indent` (j3.game.TextMode, dom.shownText, indentOf).
// Separate process, like text_num_test (fresh DOM/font probes exceed game.FONT_SRC's 32-handle budget). Run from the repo root:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/text_spacing_test.j3 --headless
// Panics on the first failed check.

module text_spacing_test;

use j3.game.{ micros, selRectW, selRectX, textSelRects, loadFont, setTextMode, textCaretX, TextMode, textWidth, Font };
use j3.io.printLn;
use j3.memory.Arena;
use j3.math.Vec2;
use j3.sys.panic;
use j3.ui.css.{ Css, P_LETTER_SPACING };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"speculative/42_ui_numeric/assets/num.ttf\"); } .box { font-family: \"T\"; font-size: 16px; } .ls { letter-spacing: 2px; } .lsem { letter-spacing: 0.5em; } .lsneg { letter-spacing: -1px; } .ws { word-spacing: 6px; } .nw { white-space: nowrap; } .blk { width: 200px; } .just { text-align: justify; } .ell { width: 80px; white-space: nowrap; overflow-y: hidden; text-overflow: ellipsis; } .clamp { width: 90px; line-clamp: 2; } .up { text-transform: uppercase; } .low { text-transform: lowercase; } .cap { text-transform: capitalize; } .ind { text-indent: 30px; } .indp { text-indent: 10%; } .right { text-align: right; } .kid { text-indent: 0px; } .tr { transition: letter-spacing 200ms linear; } .tr2 { transition: letter-spacing 160ms linear, word-spacing 160ms linear; } .px0 { letter-spacing: 0px; } .lsb { letter-spacing: 10px; } .lse { letter-spacing: 1em; } .wsa { word-spacing: 20px; } .wsb { word-spacing: 40px; } @keyframes sp { from { letter-spacing: 0px; } to { letter-spacing: 10px; } } .kfa { animation: sp 160ms linear forwards; } .sps { transition: letter-spacing 160ms linear; } .own { letter-spacing: 0px; } @keyframes fade { from { opacity: 0.2; } to { opacity: 0.9; } } .fd { animation: fade 1s linear forwards; } .all { transition: all 160ms linear; } .bgc { background: #333333; } @property --ls { syntax: '<length>'; inherits: true; initial-value: 0px; } .vp { transition: --ls 160ms linear; letter-spacing: var(--ls); } .vp.von { --ls: 10px; }";

#[singleton]
let CHECKS: int;

#[singleton]
let LASTID: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 { d = 0.0 - d; }
    ok(d <= tol, msg);
}

fn bytes(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

fn w(f: Font, s: string): f32 {
    return textWidth(f, bytes(s), false);
}

fn mode(ls: f32, ws: f32) {
    setTextMode(TextMode { tabular: false, letterSp: ls, wordSp: ws, shaped: false });
}

/// One block `cls` holding `text`, laid out in a 600 x 400 view; the block is `LASTID`.
fn build(mem: &Arena, css: &Css, cls: string, text: string): Dom {
    let d = Dom.new(mem, css);
    d.begin();
    let row = d.open(0, d.tag("div"), 1);
    d.styleStr(row, 1, "display", "flex");
    let id = d.open(0, d.tag("div"), 1);
    d.cls(id, "box");
    let a = 0;
    for i in 0..cls.len + 1 {
        if i == cls.len || cls[i] == 32 {
            if i > a { d.cls(id, cls[a..i]); }
            a = i + 1;
        }
    }
    d.text(text);
    d.close();
    d.close();
    d.end();
    d.layoutAt(600.0, 400.0);
    LASTID = id;
    return d;
}

fn boxW(mem: &Arena, css: &Css, cls: string, text: string): f32 {
    let d = build(mem, css, cls, text);
    return d.nodes.items[LASTID].w;
}

fn testGame(f: Font) {
    let base = w(f, "abc");
    let ab = w(f, "a b");
    mode(2.0, 0.0);
    near(w(f, "abc"), base + 6.0, 0.001, "letter-spacing adds after every glyph, the last included");
    near(w(f, "a b"), ab + 6.0, 0.001, "a space is a glyph too");
    mode(0.0, 0.0);
    let plain = w(f, "a b c");
    mode(0.0, 5.0);
    near(w(f, "a b c"), plain + 10.0, 0.001, "word-spacing adds on each space only");
    near(w(f, "abc"), base, 0.001, "no spaces, no word-spacing");
    mode(2.0, 5.0);
    near(w(f, "a b c"), plain + 20.0, 0.001, "both compose");
    mode(0.0, 0.0);
    let e1 = w(f, "é");
    mode(3.0, 0.0);
    near(w(f, "é"), e1 + 3.0, 0.001, "non-ASCII: one spacing per code point");
    near(w(f, "éé"), 2.0 * (e1 + 3.0), 1.5, "two code points, two spacings");
    mode(-1.0, 0.0);
    near(w(f, "abc"), base - 3.0, 0.001, "negative spacing narrows");
    mode(2.0, 0.0);
    near(textCaretX(f, bytes("abc"), false, 2), w(f, "ab"), 0.001, "caret x follows the spaced prefix width");
    // selection rectangles of a static span use the same prefix widths
    let n = textSelRects(f, bytes("abc"), false, 1, 2);
    ok(n == 1, "one selection rect");
    near(selRectX(0), w(f, "a"), 0.001, "selection starts after the spaced 'a'");
    near(selRectW(0), w(f, "b"), 0.001, "selection is as wide as the spaced 'b'");
    mode(0.0, 0.0);
    near(w(f, "abc"), base, 0.001, "mode restored");
}

fn testBlocks(mem: &Arena, css: &Css, f: Font) {
    let p = boxW(mem, css, "nw", "abcd");
    near(boxW(mem, css, "nw ls", "abcd"), p + 8.0, 0.01, "block width includes letter-spacing");
    near(boxW(mem, css, "nw lsem", "abcd"), p + 32.0, 0.01, "0.5em at 16px is 8px a letter");
    near(boxW(mem, css, "nw lsneg", "abcd"), p - 4.0, 0.01, "negative letter-spacing");
    let q = boxW(mem, css, "nw", "a b");
    near(boxW(mem, css, "nw ws", "a b"), q + 6.0, 0.01, "word-spacing on the space");
    mode(2.0, 0.0);
    near(boxW(mem, css, "nw ls", "abcd"), w(f, "abcd"), 0.01, "block width equals the spaced text width");
    mode(0.0, 0.0);
    near(w(f, "abcd"), p, 0.01, "layout leaves no spacing behind");
    // the spaced caret in an <input> and the sizes of a static selectable are in testInput / the golden
}

fn frame(e: &Dom, cls: string) {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    inputs.begin(e);
    let p = e.open(0, e.tag("input"), 1); e.cls(p, "box"); if cls.len > 0 { e.cls(p, cls); } e.attrType(p, "text"); e.attrText(p, "abcd"); e.close();
    e.layout(); e.endFrame();
}

fn testInput(mem: &Arena, css: &Css, f: Font) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { frame(&e, "ls"); }
    let id = e.nodes.items[0].first;
    e.focusNode(id); e.simKeys("", "End"); frame(&e, "ls");
    let c = e.caretRect(id);
    mode(2.0, 0.0);
    let want = w(f, "abcd");
    mode(0.0, 0.0);
    near(c.x - e.absX(id), want, 2.0, "input caret at the end follows the letter-spaced text");
    ok(want > w(f, "abcd") + 7.0, "(spaced text is wider)");
}

fn iframe(e: &Dom, on: bool) {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    inputs.begin(e);
    let p = e.open(0, e.tag("input"), 1); e.cls(p, "box"); e.cls(p, "tr2"); e.clsIf(p, "lsb", on); e.attrType(p, "text"); e.attrText(p, "abcd"); e.close();
    e.layout(); e.endFrame();
}

/// The caret of a focused `<input>` follows the painted, mid-transition letter-spacing frame by frame.
fn testInputGlide(mem: &Arena, css: &Css, f: Font) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { iframe(&e, false); }
    let id = e.nodes.items[0].first;
    e.focusNode(id); e.simKeys("", "End");
    let mid = false;
    for k in 0..8 {
        iframe(&e, true);
        let ls = e.css.get(e.nodes.items[id].style, P_LETTER_SPACING).f;
        if ls > 0.5 && ls < 9.5 { mid = true; }
        mode(ls, 0.0);
        let want = w(f, "abcd");
        mode(0.0, 0.0);
        near(e.caretRect(id).x - e.absX(id), want, 2.0, "input caret tracks the spacing mid-transition");
    }
    ok(mid, "the input's letter-spacing was mid-transition");
}

/// The first line's fragments: their right edge, and how many lines (distinct y) there are.
fn lines(d: &Dom, owner: int): int {
    let f = d.nodes.items[owner].frag0;
    let n = 0;
    let y: f32 = -1000.0;
    while f >= 0 {
        if d.frags.items[f].y != y { n += 1; y = d.frags.items[f].y; }
        f = d.frags.items[f].next;
    }
    return n;
}

fn firstLineRight(d: &Dom, owner: int): f32 {
    let f = d.nodes.items[owner].frag0;
    let y = d.frags.items[f].y;
    let r: f32 = 0.0;
    while f >= 0 && d.frags.items[f].y == y {
        r = d.frags.items[f].x + d.frags.items[f].w;
        f = d.frags.items[f].next;
    }
    return r;
}

fn testJustify(mem: &Arena, css: &Css) {
    let t = "aa bb cc dd ee ff gg hh ii jj kk ll mm";
    let d = build(mem, css, "blk just ws", t);
    ok(lines(&d, LASTID) > 1, "justify + word-spacing wraps");
    near(firstLineRight(&d, LASTID), 200.0, 0.6, "justified first line still fills the box with word-spacing");
    let d2 = build(mem, css, "blk just ls", t);
    near(firstLineRight(&d2, LASTID), 200.0, 0.6, "justified first line fills the box with letter-spacing");
}

fn testClip(mem: &Arena, css: &Css, f: Font) {
    let t = "abcdefghijklmnopqrstuvwxyz";
    let d = build(mem, css, "ell ls", t);
    let tail = d.nodes.items[LASTID].fragTail;
    let fr = d.frags.items[tail];
    ok(fr.ell >= 0.0, "ellipsis cuts the spaced line");
    ok(fr.x + fr.w <= 80.01, "the cut line with its ellipsis fits the box");
    let d0 = build(mem, css, "ell", t);
    let fr0 = d0.frags.items[d0.nodes.items[LASTID].fragTail];
    ok(fr.end < fr0.end, "letter-spacing fits fewer letters before the ellipsis");
    let c = build(mem, css, "clamp ls", "aaa bbb ccc ddd eee fff ggg hhh");
    ok(lines(&c, LASTID) == 2, "line-clamp: 2 keeps two spaced lines");
}

fn testTransform(mem: &Arena, css: &Css, f: Font) {
    near(boxW(mem, css, "nw up", "abc xyz"), w(f, "ABC XYZ"), 0.01, "uppercase measures the upper case");
    near(boxW(mem, css, "nw low", "ABC XYZ"), w(f, "abc xyz"), 0.01, "lowercase measures the lower case");
    near(boxW(mem, css, "nw cap", "hello wide world"), w(f, "Hello Wide World"), 0.01, "capitalize raises each word's first letter");
    near(boxW(mem, css, "nw cap", "it's a day-off"), w(f, "It's A Day-Off"), 0.01, "capitalize: apostrophe stays in the word, hyphen splits");
    near(boxW(mem, css, "nw up", "éa à"), w(f, "ÉA À"), 0.01, "Latin-1 letters change case");
    near(boxW(mem, css, "nw up", "ß×"), w(f, "ß×"), 0.01, "sharp s and the sign are left alone");
    let d = build(mem, css, "up", "abc é");
    let s = dom.shownText(&d, d.nodes.items[LASTID].first);
    ok(s.len == 6 && s[0] == 65 && s[1] == 66 && s[2] == 67 && s[4] == 195 && s[5] == 137, "shownText bytes");
    // a text change re-transforms; idle frames allocate and lay out nothing
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { tframe(&e, "abc"); }
    let laid = e.laid; let rs = e.restyled; let used = e.mem.used;
    for k in 0..6 { tframe(&e, "abc"); }
    ok(e.laid == laid && e.restyled == rs && e.mem.used == used, "steady uppercase frames do not lay out, restyle or allocate");
    let before = e.nodes.items[tframe(&e, "abc")].w;
    let after = e.nodes.items[tframe(&e, "mmmmmm")].w;
    ok(after > before, "new text is re-transformed and re-measured");
}

fn tframe(e: &Dom, text: string): int {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = e.open(0, e.tag("div"), 1); e.styleStr(row, 1, "display", "flex");
    let id = e.open(0, e.tag("div"), 1); e.cls(id, "box"); e.cls(id, "up"); e.cls(id, "ls"); e.text(text); e.close();
    e.close();
    e.layout(); e.endFrame();
    return id;
}

fn testIndent(mem: &Arena, css: &Css, f: Font) {
    let t = "aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk";
    let d = build(mem, css, "blk ind", t);
    let f0 = d.nodes.items[LASTID].frag0;
    near(d.frags.items[f0].x, 30.0, 0.01, "the first line starts 30px in");
    let y0 = d.frags.items[f0].y;
    let g = f0;
    while g >= 0 && d.frags.items[g].y == y0 { g = d.frags.items[g].next; }
    ok(g >= 0, "wraps");
    near(d.frags.items[g].x, 0.0, 0.01, "the second line is not indented");
    let d1 = build(mem, css, "blk", t);
    let n1 = d1.frags.items[d1.nodes.items[LASTID].frag0];
    near(n1.x, 0.0, 0.01, "no indent without text-indent");
    // the indent costs width on the first line only: fewer words fit
    let a = firstLineRight(&d, LASTID);
    ok(a <= 200.01, "first line stays inside the box");
    let cnt = 0; let cnt1 = 0;
    let q = d.nodes.items[LASTID].frag0; while q >= 0 && d.frags.items[q].y == y0 { cnt = d.frags.items[q].end; q = d.frags.items[q].next; }
    let q1 = d1.nodes.items[LASTID].frag0; let y1 = d1.frags.items[q1].y;
    while q1 >= 0 && d1.frags.items[q1].y == y1 { cnt1 = d1.frags.items[q1].end; q1 = d1.frags.items[q1].next; }
    ok(cnt < cnt1, "the indent shortens the first line's break");
    let p = build(mem, css, "blk indp", t);
    near(p.frags.items[p.nodes.items[LASTID].frag0].x, 20.0, 0.01, "10% of the 200px box");
    let r = build(mem, css, "blk ind right", "aaa bbb");
    near(firstLineRight(&r, LASTID), 200.0, 0.01, "right alignment still ends at the box edge, indent inside the line");
    // max-content (shrink-to-fit) includes the indent
    near(boxW(mem, css, "nw ind", "abcd"), boxW(mem, css, "nw", "abcd") + 30.0, 0.01, "shrink-to-fit width includes the indent");
}

fn same(a: []u8, b: string): bool {
    if a.len != b.len { return false; }
    for i in 0..a.len { if a[i] != b[i] { return false; } }
    return true;
}

fn tgl(e: &Dom, up: bool, low: bool): int {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = e.open(0, e.tag("div"), 1); e.styleStr(row, 1, "display", "flex");
    let id = e.open(0, e.tag("div"), 1); e.cls(id, "box"); e.clsIf(id, "up", up); e.clsIf(id, "low", low); e.text("Ab é"); e.close();
    e.close();
    e.layout(); e.endFrame();
    return id;
}

/// A style-only change (class toggled, text unchanged) switches the shown text both ways, and the one copy buffer is reused.
fn testToggleTransform(mem: &Arena, css: &Css) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    let id = 0;
    for k in 0..3 { id = tgl(&e, false, false); }
    let t = e.nodes.items[id].first;
    ok(same(dom.shownText(&e, t), "Ab é"), "none shows the text as written");
    id = tgl(&e, true, false);
    ok(same(dom.shownText(&e, t), "AB É"), "toggling uppercase on shows the upper case");
    id = tgl(&e, false, true);
    ok(same(dom.shownText(&e, t), "ab é"), "switching to lowercase does not serve the uppercase copy");
    id = tgl(&e, false, false);
    ok(same(dom.shownText(&e, t), "Ab é"), "toggling it off shows the original again");
    let used = e.mem.used;
    for k in 0..6 {
        id = tgl(&e, k % 2 == 0, k % 2 == 1);
        ok(same(dom.shownText(&e, t), if k % 2 == 0 { "AB É" } else { "ab é" }), "back and forth stays correct");
    }
    ok(e.mem.used == used, "toggling back and forth reuses the copy buffer");
}

/// Multibyte characters outside the Latin-1 letters pass through byte for byte; edge letters are left alone (documented).
fn testUtf8(mem: &Arena, css: &Css) {
    let d = build(mem, css, "up", "straße ǆ ÿ 日本 æ");
    let t = d.nodes.items[LASTID].first;
    ok(same(dom.shownText(&d, t), "STRAßE ǆ ÿ 日本 Æ"), "uppercase: ß, ǆ, ÿ and CJK are untouched, æ becomes Æ, no sequence is split");
    let l = build(mem, css, "low", "STRASSE Ǆ Ÿ 日本 Æ");
    ok(same(dom.shownText(&l, l.nodes.items[LASTID].first), "strasse Ǆ Ÿ 日本 æ"), "lowercase: Ǆ and Ÿ are untouched, Æ becomes æ");
    let c = build(mem, css, "cap", "éa ñu 日本 ǆx");
    ok(same(dom.shownText(&c, c.nodes.items[LASTID].first), "Éa Ñu 日本 ǆx"), "capitalize: Latin-1 letters rise, other scripts stay in their word");
}

fn lsframe(e: &Dom, on: bool): int {
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = e.open(0, e.tag("div"), 1); e.styleStr(row, 1, "display", "flex");
    let id = e.open(0, e.tag("div"), 1); e.cls(id, "box"); e.cls(id, "nw"); e.cls(id, "tr"); e.clsIf(id, "ls", on); e.text("abcd"); e.close();
    e.close();
    e.layout(); e.endFrame();
    return id;
}

/// One block of `text` in the shape `kind`: 0 the block itself carries `transition` and the class `cls`; 1 a static block with a
/// `<span>` that transitions (`lsb` on); 2 the block transitions `lsb` and holds a `<span>` with its own `letter-spacing: 0px`;
/// 3 `transition: all`; 4 `@property --ls` transitioned and read by `letter-spacing: var(--ls)` (`von` on). Returns the block's width.
fn spframe(e: &Dom, kind: int, cls: string, text: string): f32 {
    let on = cls.len > 0;
    e.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let row = e.open(0, e.tag("div"), 1); e.styleStr(row, 1, "display", "flex");
    let id = e.open(0, e.tag("div"), 1); e.cls(id, "box"); e.cls(id, "nw");
    if kind == 0 {
        e.cls(id, "tr2"); e.clsIf(id, "px0", same(bytes(cls), "px0")); e.clsIf(id, "lsb", same(bytes(cls), "lsb")); e.clsIf(id, "lse", same(bytes(cls), "lse")); e.clsIf(id, "wsa", same(bytes(cls), "wsa")); e.clsIf(id, "wsb", same(bytes(cls), "wsb")); e.clsIf(id, "kfa", same(bytes(cls), "kfa")); e.text(text);
    } else if kind == 1 {
        let sp = e.open(0, e.tag("span"), 1); e.cls(sp, "sps"); e.clsIf(sp, "lsb", on); e.text(text); e.close();
    } else if kind == 2 {
        e.cls(id, "tr2"); e.clsIf(id, "lsb", on); e.text("ab");
        let sq = e.open(0, e.tag("span"), 1); e.cls(sq, "own"); e.text("cd"); e.close();
    } else if kind == 5 {
        e.cls(id, "tr2"); e.clsIf(id, "lsb", on);
        let sf = e.open(0, e.tag("span"), 1); e.cls(sf, "fd"); e.text(text); e.close();
    } else if kind == 3 {
        e.cls(id, "all"); e.clsIf(id, "lsb", same(bytes(cls), "lsb")); e.clsIf(id, "bgc", same(bytes(cls), "bgc")); e.text(text);
    } else {
        e.cls(id, "vp"); e.clsIf(id, "von", on); e.text(text);
    }
    e.close();
    e.close();
    e.layout(); e.endFrame();
    return e.nodes.items[id].w;
}

/// Settle on `from`, switch to `to`, and check the text width moves between the two while the transition runs
/// (it lays out then) and is steady (no layout) once it has finished.
fn glide(mem: &Arena, css: &Css, from: string, to: string, text: string, w0: f32, w1: f32, msg: string) {
    glideK(mem, css, 0, from, to, text, w0, w1, w1, msg);
}

/// `glide` for block shape `kind` (`spframe`); the width never goes past `cap` on the way.
fn glideK(mem: &Arena, css: &Css, kind: int, from: string, to: string, text: string, w0: f32, w1: f32, cap: f32, msg: string) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    let x: f32 = 0.0;
    for k in 0..3 { x = spframe(&e, kind, from, text); }
    near(x, w0, 0.01, `{msg}: start width`);
    let laid = e.laid;
    let mid = false;
    let mono = true;
    let prev = x;
    for k in 0..6 {
        x = spframe(&e, kind, to, text);
        if (x - w0) * (x - w0) > 0.01 && (x - w1) * (x - w1) > 0.01 { mid = true; }
        if (w1 > w0 && x < prev - 0.01) || (w1 < w0 && x > prev + 0.01) { mono = false; }
        if w1 > w0 && x > cap + 0.01 { mono = false; }
        prev = x;
    }
    ok(mid, `{msg}: a width strictly between start and end appears`);
    ok(mono, `{msg}: width moves one way`);
    ok(e.laid > laid, `{msg}: lays out while it runs`);
    for k in 0..30 { x = spframe(&e, kind, to, text); }
    near(x, w1, 0.01, `{msg}: ends on the target`);
    laid = e.laid;
    for k in 0..30 { x = spframe(&e, kind, to, text); }
    ok(e.laid == laid, `{msg}: steady afterwards`);
}

/// `letter-spacing` and `word-spacing` transition and animate like other lengths.
fn testTransition(mem: &Arena, css: &Css) {
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    let id = 0;
    for k in 0..3 { id = lsframe(&e, false); }
    let off = e.nodes.items[id].w;
    id = lsframe(&e, true);
    id = lsframe(&e, true);
    ok(e.nodes.items[id].w > off && e.nodes.items[id].w < off + 8.0, "a letter-spacing change with a transition starts in between");
    for k in 0..30 { id = lsframe(&e, true); }
    near(e.nodes.items[id].w, off + 8.0, 0.01, "and ends on the target");
    let laid = e.laid;
    for k in 0..30 { id = lsframe(&e, true); }
    ok(e.laid == laid, "and no transition keeps laying out afterwards");
    let p = boxW(mem, css, "nw", "abcd");
    glide(mem, css, "px0", "lsb", "abcd", p, p + 40.0, "px to px");
    glide(mem, css, "", "lsb", "abcd", p, p + 40.0, "normal to px");
    glide(mem, css, "lsb", "px0", "abcd", p + 40.0, p, "px to 0px");
    glide(mem, css, "px0", "lse", "abcd", p, p + 64.0, "px to em (16px)");
    let q = boxW(mem, css, "nw", "a b");
    glide(mem, css, "wsa", "wsb", "a b", q + 20.0, q + 40.0, "word-spacing px to px");
    glide(mem, css, "", "wsb", "a b", q, q + 40.0, "word-spacing normal to px");
    // an inline span that transitions inside a static block, and a span with its own spacing inside a transitioning block
    glideK(mem, css, 1, "", "lsb", "abcd", p, p + 40.0, p + 40.0, "span transitions in a static block");
    let o = boxW(mem, css, "nw", "abcd");
    glideK(mem, css, 2, "", "lsb", "", o, o + 20.0, o + 20.0, "span with its own spacing keeps it in an animating block");
    glideK(mem, css, 5, "", "lsb", "abcd", p, p + 40.0, p + 40.0, "text under an opacity-animating span in a spacing-animating block");
    glideK(mem, css, 3, "", "lsb", "abcd", p, p + 40.0, p + 40.0, "transition: all");
    let h = Dom.new(mem, css); h.setFrameMs(16.0); h.simInput(-5.0, -5.0, false, 0.0);
    for i in 0..3 { spframe(&h, 3, "", "abcd"); }
    for i in 0..4 { spframe(&h, 3, "bgc", "abcd"); }
    ok(h.spMo == 0, "transition: all on an unrelated change starts no spacing track");
    spframe(&h, 3, "lsb", "abcd");
    ok(h.spMo == 1, "transition: all counts a spacing track");
    for i in 0..30 { spframe(&h, 3, "lsb", "abcd"); }
    ok(h.spMo == 0, "and releases it when the Motion drops");
    glideK(mem, css, 4, "", "von", "abcd", p, p + 40.0, p + 40.0, "@property length through var()");
    // @keyframes
    let k = Dom.new(mem, css); k.setFrameMs(16.0); k.simInput(-5.0, -5.0, false, 0.0);
    let x: f32 = 0.0;
    for i in 0..2 { x = spframe(&k, 0, "", "abcd"); }
    let kl = k.laid;
    let mid = false;
    for i in 0..5 {
        x = spframe(&k, 0, "kfa", "abcd");
        if x > p + 0.5 && x < p + 39.5 { mid = true; }
    }
    ok(mid, "keyframes: letter-spacing is between 0 and 10px mid-animation");
    ok(k.laid > kl, "keyframes: lays out while it runs");
    for i in 0..30 { x = spframe(&k, 0, "kfa", "abcd"); }
    near(x, p + 40.0, 0.01, "keyframes: ends on the last stop");
    kl = k.laid;
    for i in 0..30 { x = spframe(&k, 0, "kfa", "abcd"); }
    ok(k.laid == kl, "keyframes: steady afterwards");
}

/// A long spaced paragraph (ASCII and non-ASCII) lays out in a blink, and idle frames afterwards cost nothing.
fn testScale(mem: &Arena, css: &Css) {
    let para = mem.alloc::<u8>(2400);
    for i in 0..2400 { para[i] = if i % 6 == 5 { 32 } else { 97 + u8(i % 7) }; }
    let t0 = micros();
    let d = build(mem, css, "blk ls ws", ([]u8 { ptr: para.ptr, len: 2400 }) as string);
    let dt = micros() - t0;
    ok(lines(&d, LASTID) > 5, "the long paragraph wraps");
    ok(dt < 500000, "2400 spaced characters lay out in under half a second");
    let acc = "é";
    let ub = mem.alloc::<u8>(2000);
    for i in 0..1000 { ub[2 * i] = acc[0]; ub[2 * i + 1] = acc[1]; }
    let t1 = micros();
    let d2 = build(mem, css, "blk ls", ([]u8 { ptr: ub.ptr, len: 2000 }) as string);
    ok(micros() - t1 < 500000, "1000 spaced non-ASCII code points lay out in under half a second");
    ok(d2.nodes.items[LASTID].w > 0.0, "laid out");
    let e = Dom.new(mem, css); e.setFrameMs(16.0); e.simInput(-5.0, -5.0, false, 0.0);
    for k in 0..3 { tframe(&e, "abc é日 déjà"); }
    let laid = e.laid; let rs = e.restyled; let used = e.mem.used;
    for k in 0..6 { tframe(&e, "abc é日 déjà"); }
    ok(e.laid == laid && e.restyled == rs && e.mem.used == used, "steady spaced non-ASCII frames lay out, restyle and allocate nothing");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);
    let f = loadFont(css.fonts.items[0].path, 16);
    testGame(f);
    testBlocks(&mem, &css, f);
    testInput(&mem, &css, f);
    testInputGlide(&mem, &css, f);
    testJustify(&mem, &css);
    testClip(&mem, &css, f);
    testTransform(&mem, &css, f);
    testIndent(&mem, &css, f);
    testToggleTransform(&mem, &css);
    testUtf8(&mem, &css);
    testTransition(&mem, &css);
    testScale(&mem, &css);
    printLn(`text_spacing_test: {CHECKS} checks passed`);
}
