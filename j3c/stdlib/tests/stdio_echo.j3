// A stdio echo server over `j3.io.stdin()`/`stdout()` with `Content-Length` framing (LSP/MCP
// style): each message is headers, a blank line, then exactly that many bytes; it is sent back
// framed the same way with an `echo:` prefix. Ends at the end of input. Driven by
// `compile/tests/stdlib_cmp.rs` (`stdio_echo_*`), which splits messages across writes and packs
// two into one.

module stdio_echo;

use j3.io;
use j3.io.IoError;
use j3.memory.Arena;
use j3.option.Option;
use j3.result.Result;
use j3.text.{ parseInt, startsWith };

fn serve(a: &Arena): Result<int, IoError> {
    let inp = io.stdin();
    let out = io.stdout();
    let count = 0;
    while true {
        let len = -1;
        while true {
            let line = "";
            match inp.readLine(a)? {
                Option.Some(l) { line = l; }
                Option.None { return Result.Ok(count); }
            }
            if line.len == 0 {
                break;
            }
            let key = "Content-Length: ";
            if startsWith(line, key) {
                if let Option.Some(n) = parseInt(line[key.len..line.len], 10) {
                    len = n;
                }
            }
        }
        if len < 0 {
            return Result.Err(IoError.Other);
        }
        let body = inp.readExact(len, a)?;
        out.writeStr(`Content-Length: {len + 6}`)?;
        out.writeStr("\r\n\r\necho:")?;
        out.write(body)?;
        out.writeStr("\n")?;
        out.flush()?;
        count += 1;
    }
    return Result.Ok(count);
}

fn main() {
    let a = Arena.create(1 << 16);
    match serve(&a) {
        Result.Ok(n) { io.printLn(`done {n}`); }
        Result.Err(_) { io.printLn("error"); }
    }
}
