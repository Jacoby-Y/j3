// Tests for static text selection (j3.ui.textsel): double-click word, triple-click block, Shift+click extend,
// Ctrl+A (document, top modal, not inside a text box), a selection across a decorated span, Ctrl+C text, and
// steady frames with a selection. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/textsel_test.j3
// Panics on the first failed check.

module textsel_test;

use j3.game.{ clipboard, setClipboard, textWidth };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.{ Dom, fontOf, isBold };
use j3.ui.inputs;
use j3.ui.testkit.textNode;
use j3.ui.textsel;

#[singleton]
let CHECKS: int;
#[singleton]
let MODAL: bool;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, input, dialog { font-family: \"T\"; font-size: 14px; } .sel { user-select: text; } .box { background: #223344; padding: 0 3px; } .tb { width: 120px; padding: 4px; border: 1px solid #888888; } .col { display: flex; flex-direction: column; gap: 6px; width: 400px; } dialog { padding: 10px; background: #333333; }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let a = d.open(0, d.tag("div"), 1);
    d.cls(a, "sel");
    d.text("héllo wörld 123");
    d.close();
    let b = d.open(1, d.tag("div"), 1);
    d.cls(b, "sel");
    d.text("foo, bar");
    d.close();
    let c = d.open(2, d.tag("div"), 1);
    d.cls(c, "sel");
    d.text("ab ");
    let s = d.open(0, d.tag("span"), 1);
    d.cls(s, "box");
    d.text("cd");
    d.close();
    d.text(" ef");
    d.close();
    let t = d.open(3, d.tag("input"), 1);
    d.cls(t, "tb");
    d.attrType(t, "text");
    d.attrText(t, "boxed");
    d.close();
    d.close();
    if MODAL {
        let m = d.open(1, d.tag("dialog"), 1);
        d.attrOverlay(m, dom.OV_MODAL);
        let e = d.open(0, d.tag("div"), 1);
        d.cls(e, "sel");
        d.text("in dialog");
        d.close();
        d.close();
    }
    d.end();
    d.layoutAt(600.0, 400.0);
}

fn step(d: &Dom, x: f32, y: f32, down: bool) {
    d.simInput(x, y, down, 0.0);
    frame(d);
}

/// Window x of byte `off` of text node `tn`, and y in its line.
fn px(d: &Dom, tn: int, off: int): f32 {
    let owner = tn;
    while d.nodes.items[owner].frag0 < 0 { owner = d.nodes.items[owner].parent; }
    let f = d.nodes.items[owner].frag0;
    while f >= 0 {
        let g = d.frags.items[f];
        if g.kind == 0 && g.node == tn && off >= g.start && off <= g.end {
            let n = d.nodes.items[tn];
            let whole = []u8 { ptr: n.buf.ptr, len: n.tlen };
            let w = textWidth(fontOf(d, n.style), whole[g.start..off], isBold(d, n.style));
            return d.absX(owner) + g.x + w;
        }
        f = g.next;
    }
    return -1.0;
}

fn py(d: &Dom, tn: int): f32 {
    let owner = tn;
    while d.nodes.items[owner].frag0 < 0 { owner = d.nodes.items[owner].parent; }
    return d.absY(owner) + d.frags.items[d.nodes.items[owner].frag0].y + 5.0;
}

/// One click at byte `off` of text node `tn` (a little right of the boundary so the pick lands inside).
fn click(d: &Dom, tn: int, off: int, shift: bool) {
    let x = px(d, tn, off) + 1.0;
    let y = py(d, tn);
    step(d, x, y, false);
    if shift { d.simKeys("", "S+q"); }
    step(d, x, y, true);
    step(d, x, y, false);
}

fn away(d: &Dom) {
    step(d, 590.0, 390.0, false);
    step(d, 590.0, 390.0, true);
    step(d, 590.0, 390.0, false);
}

fn sel(d: &Dom): string {
    return textsel.selected(d);
}

fn main() {
    let mem = Arena.create(32 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "textsel.css", 1);
    ok(css.warns.len == 0, "sheet parses");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d);
    frame(&d);
    ok(d.fontMissing == 0, "font loaded");
    let t1 = textNode(&d, "héllo wörld 123");
    let t2 = textNode(&d, "foo, bar");
    let t3 = textNode(&d, "ab ");
    let t4 = textNode(&d, "cd");
    let t5 = textNode(&d, " ef");
    ok(t1 >= 0 && t2 >= 0 && t3 >= 0 && t4 >= 0 && t5 >= 0, "text nodes found");

    // double click: an accented word, a digit run, a word with punctuation (a word is a run of non-spaces, as in text boxes)
    click(&d, t1, 7, false);
    click(&d, t1, 7, false);
    ok(same(sel(&d), "wörld"), "double click selects the accented word");
    away(&d);
    ok(!textsel.active(&d), "a click elsewhere clears it");
    click(&d, t1, 15, false);
    click(&d, t1, 15, false);
    ok(same(sel(&d), "123"), "double click selects digits");
    away(&d);
    click(&d, t2, 1, false);
    click(&d, t2, 1, false);
    ok(same(sel(&d), "foo"), "double click on a word next to punctuation selects only the word");
    away(&d);
    click(&d, t2, 3, false);
    click(&d, t2, 3, false);
    ok(same(sel(&d), ","), "double click on punctuation selects the punctuation run");
    away(&d);
    click(&d, t2, 4, false);
    click(&d, t2, 4, false);
    ok(sel(&d).len > 0 && (same(sel(&d), " ") || same(sel(&d), ",") || same(sel(&d), "bar")), "double click on the space picks the space run or a neighbour");
    away(&d);

    // a plain click leaves a collapsed anchor: nothing highlighted, and Shift+click selects from it
    click(&d, t1, 7, false);
    ok(!textsel.active(&d) && sel(&d).len == 0, "a plain click highlights nothing");
    ok(!d.selMarked && d.selA >= 0, "a collapsed anchor leaves no marks");
    // idle frames skip `mark` entirely: a sentinel written to a node survives
    d.nodes.items[t2].sa = 99;
    for i in 0..5 { step(&d, 590.0, 380.0, false); }
    ok(d.nodes.items[t2].sa == 99, "idle frames with a collapsed anchor do not walk the nodes");
    d.nodes.items[t2].sa = -1;
    click(&d, t1, 15, true);
    ok(same(sel(&d), "wörld 1"), "Shift+click without a range selects from the clicked point");
    away(&d);
    click(&d, t2, 5, false);
    click(&d, t1, 7, true);
    ok(same(sel(&d), "wörld 123\nfoo, "), "Shift+click backward from a plain click");
    away(&d);

    // two clicks far apart in time are not a double click
    click(&d, t1, 7, false);
    for i in 0..40 { step(&d, 590.0, 390.0, false); }
    click(&d, t1, 7, false);
    ok(!textsel.active(&d), "slow clicks are two single clicks");
    away(&d);

    // triple click: the block, across the decorated span
    click(&d, t3, 1, false);
    click(&d, t3, 1, false);
    click(&d, t3, 1, false);
    ok(same(sel(&d), "ab cd ef"), "triple click selects the block across a decorated span");
    away(&d);

    // double click inside the span selects its own word
    click(&d, t4, 1, false);
    click(&d, t4, 1, false);
    ok(same(sel(&d), "cd"), "double click inside a decorated span");
    away(&d);

    // shift+click extends from the anchor (a word selected by double click) forward, across blocks and backward
    click(&d, t1, 7, false);
    click(&d, t1, 7, false);
    click(&d, t1, 15, true);
    ok(same(sel(&d), "wörld 1"), "shift+click extends within a block");
    away(&d);
    click(&d, t1, 7, false);
    click(&d, t1, 7, false);
    click(&d, t2, 2, true);
    ok(same(sel(&d), "wörld 123\nfo"), "shift+click extends forward across blocks");
    click(&d, t1, 3, true);
    ok(same(sel(&d), "llo "), "shift+click backward moves the far end");
    away(&d);
    click(&d, t2, 1, false);
    click(&d, t2, 1, false);
    click(&d, t1, 7, true);
    ok(same(sel(&d), "wörld 123"), "shift+click backward selects up to the anchor");
    away(&d);

    // Ctrl+A: all selectable text with newlines, copy equals it
    d.simKeys("", "C+a");
    step(&d, -5.0, -5.0, false);
    ok(same(sel(&d), "héllo wörld 123\nfoo, bar\nab cd ef"), "Ctrl+A selects all selectable text");
    setClipboard("zz");
    let live = same(clipboard(), "zz");
    d.simKeys("", "C+c");
    step(&d, -5.0, -5.0, false);
    ok(!live || same(clipboard(), "héllo wörld 123\nfoo, bar\nab cd ef"), "Ctrl+C copies the Ctrl+A text");
    away(&d);

    // Ctrl+A inside a text box stays in the box
    let tb = -1;
    for i in 0..d.nodes.len { if d.nodes.items[i].tag == d.tag("input") { tb = i; } }
    step(&d, d.absX(tb) + 5.0, d.absY(tb) + 5.0, false);
    step(&d, d.absX(tb) + 5.0, d.absY(tb) + 5.0, true);
    step(&d, d.absX(tb) + 5.0, d.absY(tb) + 5.0, false);
    ok(d.focus == tb, "input focused");
    d.simKeys("", "C+a");
    step(&d, d.absX(tb) + 5.0, d.absY(tb) + 5.0, false);
    ok(!textsel.active(&d), "Ctrl+A in an input does not select page text");
    ok(d.eds.items[d.nodes.items[tb].edit].lo() == 0 && d.eds.items[d.nodes.items[tb].edit].hi() == 5, "and selects the input's text");
    away(&d);

    // Ctrl+A in a modal: only the dialog
    MODAL = true;
    for i in 0..12 { step(&d, -5.0, -5.0, false); }
    d.simKeys("", "C+a");
    step(&d, -5.0, -5.0, false);
    ok(same(sel(&d), "in dialog"), "Ctrl+A in a modal selects only the dialog");
    MODAL = false;
    for i in 0..30 { step(&d, -5.0, -5.0, false); }
    away(&d);

    // steady frames with a selection do not allocate
    d.simKeys("", "C+a");
    step(&d, -5.0, -5.0, false);
    for i in 0..4 { step(&d, -5.0, -5.0, false); }
    let m0 = mem.checkpoint();
    for i in 0..20 { step(&d, -5.0, -5.0, false); }
    ok(textsel.active(&d), "selection persists across idle frames");
    ok(mem.checkpoint() == m0, "idle frames with a selection allocate nothing");

    printLn(`textsel_test ok, checks passed: {CHECKS}`);
}
