// Tests for j3.game.letterbox, the math under game.setVirtualSize: the fit, pointer mapping both
// ways, and GL rect edges. Pure, so no window or SDL is needed.
//   timeout 60 j3c run j3c/stdlib/tests/letterbox_test.j3
// Panics on the first failed check.

module letterbox_test;

use j3.game.letterbox.{ fit, glRect, toVirtual, toWindow };
use j3.io.printLn;
use j3.math.abs;
use j3.sys.panic;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("letterbox_test");
    }
}

fn near(a: f32, b: f32): bool {
    return abs(a - b) < 0.5;
}

fn main() {
    // Off: the whole window, scale 1, mapping is identity.
    let r = fit(1400, 700, 0, 0);
    ok(r.x == 0 && r.y == 0 && r.w == 1400 && r.h == 700 && r.s == 1.0, "off");
    let v = toVirtual(r, 30, 40);
    ok(near(v.x, 30) && near(v.y, 40), "off map");

    // Wide window, 16:9 content: pillarbox. 1400x700 -> 1244x700, bars 78 each side.
    r = fit(1400, 700, 1920, 1080);
    ok(r.h == 700 && r.w == 1244 && r.x == 78 && r.y == 0, "pillarbox rect");
    ok(near(r.s, f32(700) / f32(1080)), "pillarbox scale");
    v = toVirtual(r, 78, 0);
    ok(near(v.x, 0) && near(v.y, 0), "rect corner is virtual origin");
    v = toVirtual(r, 700, 350);
    ok(near(v.x, 960) && near(v.y, 540), "window center is virtual center");
    v = toVirtual(r, 10, 350);
    ok(v.x < 0, "a click in the left bar is negative, not clamped");
    v = toVirtual(r, 1390, 350);
    ok(v.x > 1920, "a click in the right bar is past the width");
    let w = toWindow(r, 960, 540);
    ok(near(w.x, 700) && near(w.y, 350), "to window");

    // Tall window: letterbox. 1000x900 -> 1000x563, bars 168/169.
    r = fit(1000, 900, 1920, 1080);
    ok(r.w == 1000 && r.h == 563 && r.x == 0 && r.y == 168, "letterbox rect");

    // Same aspect: fills the window exactly.
    r = fit(960, 540, 1920, 1080);
    ok(r.x == 0 && r.y == 0 && r.w == 960 && r.h == 540 && near(r.s, 0.5), "exact fit");

    // Degenerate windows never give a zero or overhanging rect.
    r = fit(1, 700, 1920, 1080);
    ok(r.w == 1 && r.h >= 1 && r.h <= 700 && r.x == 0, "1px wide window");
    r = fit(1400, 0, 1920, 1080);
    ok(r.h == 1 && r.w >= 1 && r.w <= 1400, "0px tall window");

    // GL rect: bottom-left origin, edges rounded so neighbours share an edge.
    r = fit(1400, 700, 1920, 1080);
    let g = glRect(r, 700, 0, 0, 1920, 1080);
    ok(g.x == 78 && g.y == 0 && g.w == 1244 && g.h == 700, "full rect in GL");
    let a = glRect(r, 700, 0, 0, 100.5, 100.5);
    let b = glRect(r, 700, 100.5, 0, 100.5, 100.5);
    ok(a.x + a.w == b.x, "adjacent rects meet without a seam");
    let t = glRect(r, 700, 0, 0, 0.1, 0.1);
    ok(t.w >= 1 && t.h >= 1, "a tiny rect keeps one pixel");
    printLn("letterbox_test ok");
}
