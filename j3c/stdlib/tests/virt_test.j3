// Tests for the virtual list window (j3.ui.virt): pure arithmetic.
//   timeout 60 j3c run j3c/stdlib/tests/virt_test.j3
// Panics on the first failed check.

module virt_test;

use j3.io.printLn;
use j3.sys.panic;
use j3.memory.{ Arena, List };
use j3.ui.virt.{ follow, Tree, window, windowTree, Win };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("virt_test");
    }
}

fn is(w: Win, lo: int, hi: int, msg: string) {
    if w.lo != lo || w.hi != hi {
        printLn(`FAIL: {msg}: got {w.lo}..{w.hi}, want {lo}..{hi}`);
        panic("virt_test");
    }
}

fn close(a: f32, b: f32): bool {
    return a - b < 1.0 && b - a < 1.0;
}

fn near(a: f32, b: f32): bool {
    return a - b < 0.01 && b - a < 0.01;
}

/// Reference: px above row `i` by walking every row (what the tree must equal).
fn walk(h: []f32, n: int, i: int, avg: f32): f32 {
    let sum: f32 = 0.0;
    for r in 0..i {
        sum += if h[r] >= 0.0 { h[r] } else { avg };
    }
    return sum;
}

fn trees() {
    let arena = Arena.create(16777216);
    let mem = &arena;
    let t = Tree.new(mem, 40.0);
    // nothing measured: every row is the estimate
    t.reset(10);
    ok(near(t.total(), 400.0) && near(t.prefix(3), 120.0) && near(t.avg(), 40.0), "unmeasured rows are the estimate");
    ok(t.find(0.0) == 0 && t.find(39.9) == 0 && t.find(40.0) == 1 && t.find(399.0) == 9 && t.find(5000.0) == 9, "find on estimates");
    // measure rows 0 and 1: 100 and 20 (mean 60); the other 8 become 60
    ok(t.set(0, 100.0) && t.set(1, 20.0), "set reports a change");
    ok(!t.set(1, 20.01), "a change under 0.05 px is not one");
    ok(near(t.avg(), 60.0) && near(t.total(), 600.0), "the mean of the measured rows replaces the estimate");
    ok(near(t.prefix(0), 0.0) && near(t.prefix(1), 100.0) && near(t.prefix(2), 120.0) && near(t.prefix(5), 300.0), "prefix mixes measured and unmeasured");
    ok(t.find(99.9) == 0 && t.find(100.0) == 1 && t.find(119.9) == 1 && t.find(120.0) == 2 && t.find(599.0) == 9, "find follows measured heights");
    // against a walk, 1000 rows with a pseudo-random subset measured
    let n = 1000;
    let h = mem.alloc::<f32>(n);
    t.reset(n);
    for u in 0..n {
        h[u] = -1.0;
    }
    let seed = 7;
    let sum: f32 = 0.0;
    let known = 0;
    for k in 0..300 {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let ri = seed % n;
        let v = f32(1 + (seed / 7) % 90);
        if h[ri] < 0.0 {
            known += 1;
            sum += v;
        } else {
            sum += v - h[ri];
        }
        h[ri] = v;
        t.set(ri, v);
    }
    let avg = sum / f32(known);
    ok(close(t.avg(), avg), "avg over 300 measured rows");
    let allOk = true;
    for p1 in 0..n + 1 {
        if !(t.prefix(p1) - walk(h, n, p1, avg) < 0.5 && walk(h, n, p1, avg) - t.prefix(p1) < 0.5) {
            allOk = false;
        }
    }
    ok(allOk, "prefix equals a walk over every row");
    let findOk = true;
    for p2 in 0..n {
        // the middle of row p2 is found as row p2 (rows of height 0 aside: none here)
        let mid = walk(h, n, p2, avg) + (walk(h, n, p2 + 1, avg) - walk(h, n, p2, avg)) / 2.0;
        if t.find(mid) != p2 {
            findOk = false;
        }
    }
    ok(findOk, "find returns the row at the middle of every row");
    ok(close(t.total(), walk(h, n, n, avg)), "total equals the walk");
    // the list changed: new row q was row from[q]; measured heights follow their rows, new rows are unmeasured
    let from = List<int>.new(mem);
    for q in 0..100 {
        from.push(-1);
    }
    for q in 0..n {
        from.push(q);
    }
    let before = t.prefix(500);
    t.remap(&from);
    ok(t.n == n + 100 && t.isKnown(100 + 500) == (h[500] >= 0.0), "remap keeps heights with their rows");
    ok(!t.isKnown(0) && !t.isKnown(99), "remap: new rows are unmeasured");
    ok(close(t.prefix(600) - t.prefix(100), before), "remap: the rows after the 100 new ones keep their offsets");
    ok(close(t.avg(), avg), "the mean survives a remap");
    // rows dropped
    let from2 = List<int>.new(mem);
    for q in 0..10 {
        from2.push(q * 2);
    }
    t.remap(&from2);
    ok(t.n == 10, "remap to fewer rows");
    t.reset(0);
    ok(t.total() == 0.0 && t.find(5.0) == 0 && t.prefix(0) == 0.0, "empty tree");
    // append: new rows are unmeasured, old heights and offsets stay (across the doubling of the tree)
    t.reset(3);
    t.set(0, 10.0);
    t.set(1, 20.0);
    t.set(2, 30.0);
    t.append(1);
    ok(t.n == 4 && near(t.prefix(3), 60.0) && near(t.total(), 80.0) && !t.isKnown(3), "append: one unmeasured row at the end");
    t.append(100);
    ok(t.n == 104 && near(t.prefix(3), 60.0) && near(t.total(), f32(60 + 101 * 20)) && t.find(f32(60 + 20 * 50)) == 53, "append: many rows, the mean is unchanged");
    t.set(103, 5.0);
    ok(near(t.prefix(103), 1685.0) && near(t.prefix(104), t.total()), "append: a new row can be measured");
    // windows: rows 0..9 of 100 px in a 250 px box at offset 300
    t.reset(10);
    for p3 in 0..10 {
        t.set(p3, 100.0);
    }
    let w = windowTree(&t, 300.0, 250.0, 1);
    ok(w.lo == 2 && w.hi == 7 && near(w.top, 200.0) && near(w.bottom, 300.0), "windowTree: rows 3..5 visible plus one each side");
    let e = windowTree(&t, 99999.0, 250.0, 1);
    ok(e.lo == 6 && e.hi == 10 && near(e.top, 600.0) && near(e.bottom, 0.0), "windowTree clamps a scroll past the end");
    let z = windowTree(&t, 0.0, 250.0, 0);
    ok(z.lo == 0 && z.hi == 3, "windowTree at the top, no overscan");
    // a row in the middle grows: rows below it move, rows above do not
    let p3 = t.prefix(3);
    t.set(1, 150.0);
    ok(near(t.prefix(1), 100.0) && near(t.prefix(3), p3 + 50.0) && near(t.total(), 1050.0), "a measured row moves only the rows below it");
}

fn followed(y: f32, last: f32, shift: f32, total: f32, view: f32, stick: bool, want: bool, wantY: f32, wantStick: bool, msg: string) {
    let f = follow(y, last, shift, total, view, stick, want);
    if !near(f.y, wantY) || f.stick != wantStick {
        printLn(`FAIL: {msg}: got y {f.y} stick {f.stick}, want y {wantY} stick {wantStick}`);
        panic("virt_test");
    }
}

fn follows() {
    // anchoring only (no stick): the shift is added, clamped to the range
    followed(500.0, 500.0, 120.0, 2000.0, 200.0, false, false, 620.0, false, "rows above grew by 120");
    followed(500.0, 500.0, f32(0 - 120), 2000.0, 200.0, false, false, 380.0, false, "rows above shrank by 120");
    followed(50.0, 50.0, f32(0 - 120), 2000.0, 200.0, false, false, 0.0, false, "never below 0");
    followed(1790.0, 1790.0, 50.0, 2000.0, 200.0, false, false, 1800.0, false, "never past the end");
    followed(500.0, 480.0, 0.0, 2000.0, 200.0, false, false, 500.0, false, "the user scrolled 20 px: kept, no shift");
    followed(500.0, 480.0, 30.0, 2000.0, 200.0, false, false, 530.0, false, "user scroll and a shift add up");
    // stick-to-bottom: pinned to the end while at the end
    followed(1800.0, 1800.0, 0.0, 2300.0, 200.0, true, true, 2100.0, true, "an append moves the end: follow it");
    followed(1800.0, 1800.0, 77.0, 2300.0, 200.0, true, true, 2100.0, true, "stuck: the anchor shift is ignored");
    followed(1790.0, 1800.0, 0.0, 2000.0, 200.0, true, true, 1790.0, false, "10 px up from the end is a release");
    followed(1799.5, 1800.0, 0.0, 2000.0, 200.0, true, true, 1800.0, true, "half a px up is not");
    followed(1700.0, 1800.0, 0.0, 2000.0, 200.0, true, true, 1700.0, false, "scrolled up 100 px: released");
    followed(1700.0, 1700.0, 0.0, 2500.0, 200.0, false, true, 1700.0, false, "released: an append leaves the view alone");
    followed(2300.0, 1700.0, 0.0, 2500.0, 200.0, false, true, 2300.0, true, "scrolled back to the end: stuck again");
    followed(2299.5, 1700.0, 0.0, 2500.0, 200.0, false, true, 2300.0, true, "within 1 px of the end counts");
    // the box got taller (the end moved up): not a scroll up
    followed(1800.0, 1800.0, 0.0, 2000.0, 400.0, true, true, 1600.0, true, "a taller box lowers the end: still stuck");
    // short content: stuck at 0
    followed(0.0, 0.0, 0.0, 100.0, 200.0, true, true, 0.0, true, "content shorter than the box");
    // no stick-to-bottom attribute: never stuck
    followed(1800.0, 1800.0, 0.0, 2300.0, 200.0, true, false, 1800.0, false, "without the attribute nothing sticks");
}

fn main() {
    // 1000 rows of 20 px in a 100 px box (5 rows visible), 4 rows of overscan
    is(window(1000, 20.0, 0.0, 100.0, 4), 0, 9, "top: overscan only below");
    is(window(1000, 20.0, 2000.0, 100.0, 4), 96, 109, "middle: rows 100..105 visible");
    is(window(1000, 20.0, 2010.0, 100.0, 4), 96, 110, "middle, mid-row offset");
    is(window(1000, 20.0, 19900.0, 100.0, 4), 991, 1000, "end: overscan clamped at count");
    is(window(1000, 20.0, 99999.0, 100.0, 4), 991, 1000, "scrolled past the end is clamped");
    is(window(1000, 20.0, -50.0, 100.0, 4), 0, 9, "negative scroll is clamped");
    is(window(1000, 20.0, 40.0, 100.0, 0), 2, 7, "no overscan");
    is(window(0, 20.0, 0.0, 100.0, 4), 0, 0, "empty list");
    is(window(0, 20.0, 500.0, 100.0, 4), 0, 0, "empty list, stale scroll");
    is(window(3, 20.0, 0.0, 100.0, 4), 0, 3, "fewer rows than the box");
    // the list shrank from 1000 to 30 rows under a box scrolled to 19900
    is(window(30, 20.0, 19900.0, 100.0, 4), 21, 30, "shrunk under a scrolled-down box");
    is(window(1, 20.0, 19900.0, 100.0, 4), 0, 1, "shrunk to one row");
    // first frame: h = 0 callers pass the window height instead; a 0-height box still gives a sane window
    is(window(1000, 20.0, 0.0, 0.0, 4), 0, 4, "zero-height viewport");
    is(window(1000, 20.0, 0.0, 240.0, 4), 0, 16, "first frame uses the fallback height");
    is(window(100000, 26.0, 1300000.0, 200.0, 4), 49996, 50012, "100000 rows, middle");
    let t = window(1000, 20.0, 2000.0, 100.0, 4);
    ok(t.top == 1920.0 && t.bottom == 20.0 * f32(1000 - t.hi), "spacers are the px of the dead rows");
    ok(window(10, 0.0, 0.0, 100.0, 4).hi == 0, "zero row height is empty, not a divide by zero");
    // every window is valid
    for c in 0..40 {
        for s in 0..60 {
            let w = window(c, 17.0, f32(s) * 13.0, 90.0, 3);
            ok(w.lo >= 0 && w.lo <= w.hi && w.hi <= c, "lo <= hi <= count");
        }
    }
    trees();
    follows();
    printLn("virt_test: all passed");
}
