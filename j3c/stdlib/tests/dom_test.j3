// Layout tests and timings for j3.ui.dom. Run from the repo root, headless (SDL_ttf measures text; no window opens):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/dom_test.j3
//   j3c build --release j3c/stdlib/tests/dom_test.j3 && ./dom_test      (for the release timings)
// Builds trees by hand like the stage-06 generator will, mirroring examples/idle-breakout (the real theme.css
// and <style> blocks). Expected rects are numbers derived from the CSS rules; each check says how. Anything
// that depends on a glyph is written against the font's own metrics (line height F<size>, text widths), with a
// 1 px tolerance. Panics on the first failed check; timings are printed, not asserted.

module dom_test;

use j3.game.{ Font, fontAscent, fontLine, loadFont, textWidth };
use j3.io.{ exists, printLn, readFile };
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.find;
use j3.ui.css.{ Css, FL_HOVER, P_COLOR, P_PADDING_TOP, V_AUTO, V_COLOR, P_BORDER_TOP_WIDTH, P_CURSOR, P_FONT_STYLE, P_FONT_WEIGHT, P_WHITE_SPACE, P_WIDTH, WS_PRE };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.{ Dom, Frag };
use j3.ui.uastyle;

const S_BALLCARD: int = 1;
const S_BALLSHOP: int = 2;
const S_GAME: int = 3;
const S_PRESTIGE: int = 4;
const S_SETTINGS: int = 5;
const S_SIDEBAR: int = 6;
const S_STATS: int = 7;
const S_UPGRADEROW: int = 8;
const S_UPGRADES: int = 9;
const S_TEST: int = 10;
const VH: f32 = 760.0;
const HW: f32 = 640.0;

#[singleton]
let CHECKS: int;

#[singleton]
let FONTS: [64]Font;

#[singleton]
let FONTPATH: string;

#[singleton]
let TMP: [64]int;

#[singleton]
let CARDS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff > tol {
        printLn(`FAIL: {msg}: got {a}, want {b} (+-{tol})`);
        panic(msg);
    }
}

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

fn load(mem: &Arena, path: string): string {
    match readFile(path, mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) { panic(`cannot read {path}`); }
    }
}

fn font(size: int): Font {
    if FONTS[size].raw == 0 {
        FONTS[size] = loadFont(FONTPATH, size);
    }
    return FONTS[size];
}

/// Font line height at `size` (the natural line-height: normal).
fn fl(size: int): f32 {
    return f32(fontLine(font(size)));
}

/// Width of `s` at `size`.
fn tw(size: int, bold: bool, s: string): f32 {
    return textWidth(font(size), []u8 { ptr: s.ptr, len: s.len }, bold);
}

// ---- tree builders (what the generated code does) ---------------------------------------------------

fn el(d: &Dom, slot: int, tag: string, scope: int, cls: string): int {
    let id = d.open(slot, d.tag(tag), scope);
    if cls.len > 0 {
        d.cls(id, cls);
    }
    return id;
}

/// <tag class=cls>text</tag>
fn leaf(d: &Dom, slot: int, tag: string, scope: int, cls: string, text: string): int {
    let id = el(d, slot, tag, scope, cls);
    d.text(text);
    d.close();
    return id;
}

fn ballCard(d: &Dom, slot: int, name: string, owned: string, dmg: string, price: string): int {
    let card = el(d, slot, "div", S_BALLCARD, "card");
    el(d, 0, "div", S_BALLCARD, "top");
    leaf(d, 0, "span", S_BALLCARD, "name", name);
    leaf(d, 1, "span", S_BALLCARD, "owned", owned);
    d.close();
    leaf(d, 1, "small", S_BALLCARD, "", "Fires straight up, hits hard.");
    el(d, 2, "div", S_BALLCARD, "stats");
    leaf(d, 0, "span", S_BALLCARD, "", dmg);
    leaf(d, 1, "span", S_BALLCARD, "", "spd 320");
    d.close();
    el(d, 3, "button", S_BALLCARD, "");
    d.text("Buy · ");
    leaf(d, 1, "span", S_BALLCARD, "price", price);
    d.close();
    d.close();
    return card;
}

fn ballShop(d: &Dom, n: int): int {
    leaf(d, 0, "h2", S_BALLSHOP, "", "Balls 3 / 40");
    let grid = el(d, 1, "div", S_BALLSHOP, "grid");
    for k in 0..n {
        ballCard(d, k, "Plain", "x3", "dmg 5", "120");
    }
    d.close();
    return grid;
}

fn upgradeRow(d: &Dom, slot: int, label: string, value: string, cost: string): int {
    let row = el(d, slot, "div", S_UPGRADEROW, "row");
    leaf(d, 0, "span", S_UPGRADEROW, "label", label);
    leaf(d, 1, "span", S_UPGRADEROW, "value", value);
    leaf(d, 2, "button", S_UPGRADEROW, "", cost);
    d.close();
    return row;
}

fn upgrades(d: &Dom, rows: int): int {
    let sec = el(d, 0, "section", S_UPGRADES, "");
    leaf(d, 0, "h2", S_UPGRADES, "", "Click");
    for k in 0..rows {
        upgradeRow(d, k + 1, "Click damage", "12", "250");
    }
    d.close();
    return sec;
}

fn prestige(d: &Dom, longText: string): int {
    let box = el(d, 0, "div", S_PRESTIGE, "box");
    leaf(d, 0, "h1", S_PRESTIGE, "", "Prestige");
    leaf(d, 1, "p", S_PRESTIGE, "", longText);
    el(d, 2, "div", S_PRESTIGE, "gain");
    leaf(d, 0, "span", S_PRESTIGE, "", "You would get");
    leaf(d, 1, "span", S_PRESTIGE, "crystal", "+5");
    d.close();
    leaf(d, 3, "small", S_PRESTIGE, "", "Crystals = √(gold earned this run / 1000). Earned so far: 98765 and a fair amount of padding text so it wraps.");
    leaf(d, 4, "button", S_PRESTIGE, "go", "Prestige");
    d.close();
    return box;
}

fn stats(d: &Dom): int {
    let dl = el(d, 0, "dl", S_STATS, "");
    let names: [9]string = ["Level", "Bricks left", "Bricks broken", "Damage / second", "Balls", "Click damage", "Gold this run", "Crystals", "Prestiges"];
    let vals: [9]string = ["12", "340", "1200", "55", "4", "3", "98765", "7", "0"];
    for k in 0..9 {
        leaf(d, k * 2, "dt", S_STATS, "", names[k]);
        let cl = "";
        if k == 6 {
            cl = "gold";
        }
        leaf(d, k * 2 + 1, "dd", S_STATS, cl, vals[k]);
    }
    d.close();
    return dl;
}

fn settings(d: &Dom): int {
    let list = el(d, 0, "div", S_SETTINGS, "list");
    el(d, 0, "label", S_SETTINGS, "");
    leaf(d, 0, "span", S_SETTINGS, "", "Paused");
    let cb = el(d, 1, "input", S_SETTINGS, "");
    d.attrType(cb, "checkbox");
    d.close();
    d.close();
    el(d, 1, "label", S_SETTINGS, "");
    leaf(d, 0, "span", S_SETTINGS, "", "Game speed");
    let rg = el(d, 1, "input", S_SETTINGS, "");
    d.attrType(rg, "range");
    d.close();
    leaf(d, 2, "span", S_SETTINGS, "val", "1x");
    d.close();
    d.close();
    return list;
}

/// Sidebar; the main area shows `tab` (0 shop, 1 upgrades, 2 prestige, 3 stats, 4 settings).
fn sidebar(d: &Dom, tab: int, count: int, longText: string, gold: string) {
    el(d, 0, "div", S_SIDEBAR, "side");
    el(d, 0, "header", S_SIDEBAR, "");
    el(d, 0, "div", S_SIDEBAR, "wallet");
    leaf(d, 0, "span", S_SIDEBAR, "gold", gold);
    leaf(d, 1, "span", S_SIDEBAR, "crystal", "7 crystals");
    d.close();
    leaf(d, 1, "small", S_SIDEBAR, "", "Level 3 · 55 dmg/s");
    d.close();
    el(d, 1, "nav", S_SIDEBAR, "");
    let names: [5]string = ["Balls", "Upgrades", "Prestige", "Stats", "Settings"];
    for i in 0..5 {
        let b = el(d, i, "button", S_SIDEBAR, "");
        d.clsIf(b, "active", tab == i);
        d.text(names[i]);
        d.close();
    }
    d.close();
    el(d, 2, "main", S_SIDEBAR, "");
    if tab == 0 {
        ballShop(d, count);
    } else if tab == 1 {
        upgrades(d, count);
    } else if tab == 2 {
        prestige(d, longText);
    } else if tab == 3 {
        stats(d);
    } else {
        settings(d);
    }
    d.close();
    d.close();
}

fn game(d: &Dom, tab: int, count: int, paused: bool, longText: string, gold: string) {
    d.begin();
    el(d, 0, "div", S_GAME, "app");
    el(d, 0, "canvas", S_GAME, "field");
    el(d, 0, "div", S_GAME, "hud");
    leaf(d, 0, "span", S_GAME, "level", "Level 3");
    leaf(d, 1, "span", S_GAME, "", "42 bricks");
    d.close();
    if paused {
        el(d, 1, "div", S_GAME, "paused");
        leaf(d, 0, "h1", S_GAME, "", "Paused");
        leaf(d, 1, "button", S_GAME, "", "Resume");
        d.close();
    }
    d.close();
    el(d, 1, "div", S_GAME, "half");
    sidebar(d, tab, count, longText, gold);
    d.close();
    d.close();
    d.end();
}

// ---- tree queries ----------------------------------------------------------------------------------

fn kid(d: &Dom, id: int, n: int): int {
    let c = d.nodes.items[id].first;
    for i in 0..n {
        c = d.nodes.items[c].next;
    }
    return c;
}

fn nx(d: &Dom, id: int): f32 { return d.nodes.items[id].x; }
fn ny(d: &Dom, id: int): f32 { return d.nodes.items[id].y; }
fn nw(d: &Dom, id: int): f32 { return d.nodes.items[id].w; }
fn nh(d: &Dom, id: int): f32 { return d.nodes.items[id].h; }

fn fragCount(d: &Dom, id: int): int {
    let n = 0;
    let f = d.nodes.items[id].frag0;
    while f >= 0 {
        n += 1;
        f = d.frags.items[f].next;
    }
    return n;
}

/// Lines of a block's fragments: the number of distinct y values.
fn lineCount(d: &Dom, id: int): int {
    let n = 0;
    let lastY: f32 = -1000.0;
    let f = d.nodes.items[id].frag0;
    while f >= 0 {
        let y = d.frags.items[f].y;
        if y - lastY > 0.5 || lastY - y > 0.5 {
            n += 1;
            lastY = y;
        }
        f = d.frags.items[f].next;
    }
    return n;
}

/// Reference greedy wrap of `text` at `size` into `width` px, independent of the dom code. Returns the line count.
fn refLines(text: string, size: int, width: f32): int {
    let lines = 1;
    let x: f32 = 0.0;
    let sp = tw(size, false, " ");
    let i = 0;
    let has = false;
    while i < text.len {
        if text[i] == 32 {
            i += 1;
        } else {
            let j = i;
            while j < text.len && text[j] != 32 {
                j += 1;
            }
            let ww = tw(size, false, text[i..j]);
            if has && x + sp + ww > width + 0.01 {
                lines += 1;
                x = ww;
            } else if has {
                x = x + sp + ww;
            } else {
                x = ww;
                has = true;
            }
            i = j;
        }
    }
    return lines;
}

fn walk(d: &Dom, id: int, depth: int) {
    let n = &d.nodes.items[id];
    let pad = "";
    let tag = d.css.name(n.tag);
    printLn(`{depth} #{id} {tag} x={n.x} y={n.y} w={n.w} h={n.h}`);
    let c = n.first;
    while c >= 0 {
        walk(d, c, depth + 1);
        c = d.nodes.items[c].next;
    }
}

fn main() {
    let mem = Arena.create(256 * 1024 * 1024);
    let dir = "examples/idle-breakout/ui/";
    if !exists(`{dir}theme.css`) {
        dir = "../examples/idle-breakout/ui/";
    }
    let files: [9]string = ["BallCard", "BallShop", "Game", "Prestige", "Settings", "Sidebar", "Stats", "UpgradeRow", "Upgrades"];
    let css = Css.new(&mem);
    parse(&css, load(&mem, `{dir}theme.css`), `{dir}theme.css`, 0);
    for i in 0..9 {
        let name = files[i];
        let src = load(&mem, `{dir}{name}.j3ui`);
        let a = find(src, "<style>");
        let b = find(src, "</style>");
        parse(&css, src[a + 7..b], `{dir}{name}.j3ui`, i + 1);
    }
    // extra sheet for the flex/min-width and box-model tests
    parse(&css, ".row { display: flex; width: 200px; } .fa { flex: 1; } .fz { flex: 1; min-width: 0; } .fb { width: 50px; } .s150 { width: 150px; } .wide { width: 300px; height: 10px; } .none { display: none; } .pct { width: 50%; height: 20px; } .cbx { box-sizing: content-box; width: 100px; padding: 10px; border: 2px solid #fff; height: 30px; } .ctr { text-align: center; } .mg { margin: 5px 7px; height: 10px; } .rel { position: relative; width: 100px; height: 80px; } .abr { position: absolute; right: 10px; bottom: 5px; width: 20px; height: 8px; } .abs2 { position: absolute; top: 3px; left: 4px; }", "test.css", S_TEST);
    ok(css.warns.len == 0, "styles parse with zero warnings");
    FONTPATH = css.fonts.items[0].path;
    printLn(`font {FONTPATH}`);
    let longText = "Start over at level 1 with no balls. Each crystal adds 10% to all gold, forever, and then some more words to make sure it wraps at least twice on a box.";

    let d = Dom.new(&mem, &css);
    ok(d.fontMissing == 0, "no font missing");

    // ===== 1. Game at 1280x760 =====
    game(&d, 0, 6, true, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    ok(d.fontMissing == 0, "fonts loaded");
    let app = kid(&d, 0, 0);
    let field = kid(&d, app, 0);
    let half = kid(&d, app, 1);
    near(nw(&d, app), 1280.0, 0.01, "app width");
    near(nh(&d, app), 760.0, 0.01, "app height is 100% of the root");
    near(nw(&d, field), 640.0, 0.01, "canvas half width");
    near(nw(&d, half), 640.0, 0.01, "sidebar half width");
    near(nx(&d, half), 640.0, 0.01, "sidebar half x");
    near(nh(&d, field), 760.0, 0.01, "canvas stretched to the app height");
    near(nh(&d, half), 760.0, 0.01, "half height");
    // the hud: absolute, left 12, bottom 12, shrink-to-fit
    let hud = kid(&d, field, 0);
    let paused = kid(&d, field, 1);
    near(nx(&d, hud), 12.0, 0.01, "hud left");
    let hudW = 24.0 + tw(13, true, "Level 3") + 12.0 + tw(13, false, "42 bricks");
    near(nw(&d, hud), hudW, 1.0, "hud shrink-to-fit width (padding 12 + two spans + gap 12)");
    near(nh(&d, hud), fl(13) + 12.0, 1.0, "hud height (line + padding 6 6)");
    near(ny(&d, hud), VH - 12.0 - nh(&d, hud), 0.01, "hud bottom 12");
    // the paused overlay covers the canvas exactly
    near(nx(&d, paused), 0.0, 0.01, "overlay x");
    near(ny(&d, paused), 0.0, 0.01, "overlay y");
    near(nw(&d, paused), 640.0, 0.01, "overlay covers the canvas width");
    near(nh(&d, paused), 760.0, 0.01, "overlay covers the canvas height");
    let h1 = kid(&d, paused, 0);
    let resume = kid(&d, paused, 1);
    let colH = fl(22) + 12.0 + fl(15) + 16.0;
    near(ny(&d, h1), (VH - colH) / 2.0, 1.0, "overlay column centered vertically");
    near(ny(&d, resume), (VH - colH) / 2.0 + fl(22) + 12.0, 1.0, "gap 12 between h1 and button");
    near(nw(&d, h1), tw(22, true, "Paused"), 1.0, "h1 shrink-to-fit in a centered column");
    near(nx(&d, h1), (HW - tw(22, true, "Paused")) / 2.0, 1.0, "h1 centered horizontally");
    near(nw(&d, resume), 28.0 + tw(15, false, "Resume"), 1.0, "button width = text + padding 14 14");
    near(nh(&d, resume), fl(15) + 16.0, 0.01, "button height = line + padding 8 8");

    // ===== 2. Sidebar =====
    let side = kid(&d, half, 0);
    near(nw(&d, side), 640.0, 0.01, "side width");
    near(nh(&d, side), 760.0, 0.01, "side is 100% of a stretched flex item");
    let header = kid(&d, side, 0);
    let nav = kid(&d, side, 1);
    let mainEl = kid(&d, side, 2);
    near(nx(&d, header), 1.0, 0.01, "side border-left 1px shifts the children");
    near(nh(&d, header), 32.0 + fl(24), 1.0, "header = padding 16+16 + the 24px line (baseline row)");
    // baseline alignment: small sits so its baseline matches the wallet's
    let wallet = kid(&d, header, 0);
    let small = kid(&d, header, 1);
    near(ny(&d, wallet), 16.0, 0.01, "wallet top is the header padding");
    near(ny(&d, small), 16.0 + baselineGap(24, 12), 1.5, "small aligned to the wallet baseline");
    near(nw(&d, header), 639.0, 0.01, "header stretches to the side content width");
    // wallet: gap 16 between the two spans
    let gold = kid(&d, wallet, 0);
    let crystal = kid(&d, wallet, 1);
    near(nx(&d, crystal), nx(&d, gold) + nw(&d, gold) + 16.0, 0.01, "wallet gap 16");
    near(nw(&d, gold), tw(24, true, "1234 gold"), 1.0, "gold span is its text (flex item shrink-to-fit)");
    // nav
    near(ny(&d, nav), nh(&d, header), 0.01, "nav under the header");
    near(nw(&d, nav), 639.0, 0.01, "nav width");
    let navBtn = fl(15) + 18.0;
    near(nh(&d, nav), navBtn + 1.0, 1.0, "nav = tallest button (active has border-bottom 2) + border-bottom 1");
    // five equal buttons: (639 - 32 padding - 4*4 gaps) / 5 = 118.2
    for k in 0..5 {
        let btn = kid(&d, nav, k);
        near(nw(&d, btn), 118.2, 0.02, "nav button width (5 equal flex:1 columns)");
        near(nx(&d, btn), 16.0 + f32(k) * 122.2, 0.05, "nav button x");
        near(nh(&d, btn), navBtn, 1.0, "nav buttons stretch to the active one");
        // UA: button text is centered (the label is shorter than the 118.2 button)
        let bf = d.frags.items[d.nodes.items[btn].frag0];
        near(bf.x, (118.2 - bf.w) / 2.0, 0.6, "button text centered horizontally");
    }
    // main fills the rest
    near(ny(&d, mainEl), nh(&d, header) + nh(&d, nav), 0.01, "main y");
    near(nh(&d, mainEl), 760.0 - nh(&d, header) - nh(&d, nav), 0.01, "main fills the remaining height (flex:1, min-height 0)");
    near(nw(&d, mainEl), 639.0, 0.01, "main width");

    // ===== 3. BallShop grid =====
    let h2 = kid(&d, mainEl, 0);
    let grid = kid(&d, mainEl, 1);
    near(ny(&d, h2), 16.0, 0.01, "h2 at the main padding");
    near(nx(&d, h2), 20.0, 0.01, "h2 x = padding 20");
    near(nh(&d, h2), fl(17), 1.0, "h2 line");
    near(ny(&d, grid), 16.0 + fl(17) + 12.0, 1.0, "grid margin-top 12");
    near(nw(&d, grid), 599.0, 0.01, "grid width = 639 - 40");
    let c0 = kid(&d, grid, 0);
    let c1 = kid(&d, grid, 1);
    let c2 = kid(&d, grid, 2);
    near(nw(&d, c0), 295.5, 0.02, "two equal columns: (599 - 8) / 2");
    near(nw(&d, c1), 295.5, 0.02, "second column");
    near(nx(&d, c1) - nx(&d, c0) - nw(&d, c0), 8.0, 0.02, "column gap 8");
    near(ny(&d, c2) - ny(&d, c0) - nh(&d, c0), 8.0, 0.02, "row gap 8 (gap shorthand)");
    let cardH = 64.0 + 2.0 * fl(15) + fl(12) + fl(13);
    near(nh(&d, c0), cardH, 1.5, "card = border 1+1, padding 12+12, rows + gaps 6, button margin-top 4");
    near(nh(&d, c1), nh(&d, c0), 0.01, "cards in a row are equally tall");
    // justify-content: space-between in .top
    let top = kid(&d, c0, 0);
    let nameSp = kid(&d, top, 0);
    let ownedSp = kid(&d, top, 1);
    near(nx(&d, nameSp), 0.0, 0.01, "space-between: first at the start");
    near(nx(&d, ownedSp) + nw(&d, ownedSp), nw(&d, top), 0.01, "space-between: last at the end");
    // a button is a flex item stretched across the column card
    let buy = kid(&d, c0, 3);
    near(nw(&d, buy), 269.5, 0.02, "button stretches in a column card");
    near(nh(&d, buy), fl(15) + 16.0, 0.01, "button height");
    // the button's text: 'Buy · ' then the price span, merged on one line
    ok(lineCount(&d, buy) == 1, "button text is one line");

    // ===== 4. Upgrades with 30 rows: scroll range =====
    game(&d, 1, 30, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let app2 = kid(&d, 0, 0);
    let side2 = kid(&d, kid(&d, app2, 1), 0);
    let main2 = kid(&d, side2, 2);
    let hdr2 = kid(&d, side2, 0);
    let nav2 = kid(&d, side2, 1);
    // the active class moved to the second tab button: its border-bottom is 2px, the first one's is 0
    let ab1 = d.css.get(d.nodes.items[kid(&d, nav2, 1)].style, P_BORDER_TOP_WIDTH + 2);
    let ab0 = d.css.get(d.nodes.items[kid(&d, nav2, 0)].style, P_BORDER_TOP_WIDTH + 2);
    ok(ab1.f == 2.0 && ab0.f == 0.0, "class:active moves with the tab (restyled on the class change)");
    ok(d.nodes.items[kid(&d, kid(&d, kid(&d, app2, 0), 0), 0)].kind == 0, "the paused overlay is gone (field has only the hud)");
    ok(kid(&d, kid(&d, app2, 0), 1) < 0, "no overlay child after paused = false");
    let mainH = 760.0 - nh(&d, hdr2) - nh(&d, nav2);
    near(nh(&d, main2), mainH, 0.01, "main keeps its height with 30 rows");
    let sec = kid(&d, main2, 0);
    let rowH = fl(15) + 32.0;
    let secH = fl(17) + 30.0 * rowH + 180.0;
    near(nh(&d, sec), secH, 2.0, "section = h2 + 30 rows + 30 gaps of 6 (flex column)");
    let contentH = 16.0 + nh(&d, sec) + 18.0 + 16.0;
    near(d.nodes.items[main2].contentH, contentH, 0.01, "scroll height = padding + section + margin-bottom 18 + padding");
    near(d.nodes.items[main2].scrollMax, contentH - mainH, 0.01, "scroll range");
    ok(d.nodes.items[main2].scrollMax > 1000.0, "30 rows overflow into a real scroll range");
    d.scrollBy(main2, 100000.0);
    near(d.nodes.items[main2].scrollY, d.nodes.items[main2].scrollMax, 0.01, "scroll clamps at the end");
    near(d.absY(sec), nh(&d, hdr2) + nh(&d, nav2) + 16.0 - d.nodes.items[main2].scrollMax, 0.01, "absY includes the scroll offset");
    d.scrollBy(main2, -100000.0);
    // an upgrade row: label flex:1 takes what is left after value (min-width 48) and button (min-width 90)
    let row = kid(&d, sec, 1);
    near(nw(&d, row), 599.0, 0.01, "row stretches in the column");
    near(nh(&d, row), rowH, 1.0, "row = button height + padding 8 8, items centered");
    let label = kid(&d, row, 0);
    let value = kid(&d, row, 1);
    let rbtn = kid(&d, row, 2);
    near(nw(&d, rbtn), 90.0, 0.01, "button min-width 90");
    near(nw(&d, value), 48.0, 0.01, "value min-width 48");
    near(nw(&d, label), 413.0, 0.02, "label flex:1 = row - padding 24 - gaps 24 - value - button");
    near(ny(&d, label), (nh(&d, row) - nh(&d, label)) / 2.0, 0.6, "align-items: center");
    // text-align right inside the value span
    let vf = d.frags.items[d.nodes.items[value].frag0];
    near(vf.x, 48.0 - tw(15, false, "12"), 1.0, "value text is right aligned");

    // ===== 5. Stats =====
    game(&d, 3, 0, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let side3 = kid(&d, kid(&d, kid(&d, 0, 0), 1), 0);
    let main3 = kid(&d, side3, 2);
    let dl = kid(&d, main3, 0);
    near(nw(&d, dl), 599.0, 0.01, "dl width");
    let ddW = tw(15, true, "98765");
    near(nx(&d, kid(&d, dl, 0)), 16.0, 0.01, "dt at the left padding");
    near(nw(&d, kid(&d, dl, 1)), ddW, 1.0, "auto column = widest dd");
    near(nx(&d, kid(&d, dl, 1)) + nw(&d, kid(&d, dl, 1)), 583.0, 0.01, "dd column ends at the right padding");
    near(nw(&d, kid(&d, dl, 0)), 567.0 - ddW, 1.0, "1fr column = the rest");
    near(ny(&d, kid(&d, dl, 2)) - ny(&d, kid(&d, dl, 0)), fl(15) + 10.0, 1.0, "row-gap 10 between rows");
    near(nh(&d, dl), 32.0 + 9.0 * fl(15) + 80.0, 1.5, "dl height = 9 rows + 8 gaps + padding");
    let ddNode = kid(&d, dl, 1);
    let ddFrag = d.frags.items[d.nodes.items[ddNode].frag0];
    near(ddFrag.x, nw(&d, ddNode) - tw(15, true, "12"), 1.0, "dd text-align: right");
    // labels left, values right
    ok(nx(&d, kid(&d, dl, 1)) > nx(&d, kid(&d, dl, 0)) + 200.0, "values are right of labels");

    // ===== 6. Prestige wrap =====
    game(&d, 2, 0, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let side4 = kid(&d, kid(&d, kid(&d, 0, 0), 1), 0);
    let main4 = kid(&d, side4, 2);
    let box = kid(&d, main4, 0);
    near(nw(&d, box), 599.0, 0.01, "box width");
    let p = kid(&d, box, 1);
    near(nw(&d, p), 557.0, 0.01, "p width = box - padding 40 - border 2");
    let want = refLines(longText, 15, 557.0);
    ok(want >= 2, "reference text wraps");
    ok(lineCount(&d, p) == want, `p wraps like the reference greedy wrap ({lineCount(&d, p)} vs {want})`);
    near(nh(&d, p), f32(want) * 21.0, 0.01, "p height = lines * line-height 1.4 * 15");
    let pf = d.nodes.items[p].frag0;
    let maxRight: f32 = 0.0;
    while pf >= 0 {
        let fr = d.frags.items[pf];
        if fr.x + fr.w > maxRight {
            maxRight = fr.x + fr.w;
        }
        pf = fr.next;
    }
    ok(maxRight <= 557.5, "no fragment passes the box width");
    let sm = kid(&d, box, 3);
    ok(lineCount(&d, sm) >= 2, "small wraps too");
    // flex column: box height = children + gaps 12 + padding/border
    let sum: f32 = 0.0;
    let nkids = 0;
    let kc = d.nodes.items[box].first;
    while kc >= 0 {
        sum += nh(&d, kc);
        nkids += 1;
        kc = d.nodes.items[kc].next;
    }
    near(nh(&d, box), sum + f32(nkids - 1) * 12.0 + 42.0, 0.5, "box height = children + gaps + padding + border");
    // baseline row: 'You would get' sits on the big number's baseline
    let gain = kid(&d, box, 2);
    near(nh(&d, gain), fl(32), 1.5, "gain row height is the 32px line");
    let youSpan = kid(&d, gain, 0);
    near(ny(&d, youSpan), baselineGap(32, 15), 1.5, "baseline alignment of the small label");

    // ===== 7. Settings =====
    game(&d, 4, 0, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let side5 = kid(&d, kid(&d, kid(&d, 0, 0), 1), 0);
    let list = kid(&d, kid(&d, side5, 2), 0);
    let lab0 = kid(&d, list, 0);
    near(nh(&d, lab0), 20.0 + max2(fl(15), 16.0), 1.0, "label = padding 10 10 + tallest item");
    near(nw(&d, kid(&d, lab0, 0)), 543.0, 0.02, "label span:first-child flex:1 beside a 16px checkbox");
    near(nw(&d, kid(&d, lab0, 1)), 16.0, 0.01, "checkbox width");
    near(nh(&d, kid(&d, lab0, 1)), 16.0, 0.01, "checkbox height");
    let lab1 = kid(&d, list, 1);
    near(nw(&d, kid(&d, lab1, 1)), 140.0, 0.01, "range width 140");
    near(nh(&d, kid(&d, lab1, 1)), 16.0, 0.01, "range height");
    near(nw(&d, kid(&d, lab1, 2)), max2(36.0, tw(15, false, "1x")), 1.0, "val min-width 36");

    testMinWidth(&mem, &css);
    testContents(&mem);
    testContents2(&mem);
    testContentsBlock(&mem);
    testBoxes(&mem, &css);
    testHtmlTags(&mem);
    testRuntime(&mem);
    testZIndex(&mem);
    testDyn(&mem);
    testMultiAnim(&mem);
    testVars(&mem);
    testFallbackText(&mem);
    testWideStyle(&mem);

    // hover on a card changes its style id (border-color transition target) and back
    game(&d, 0, 6, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let hs = kid(&d, kid(&d, kid(&d, kid(&d, kid(&d, 0, 0), 1), 0), 2), 1);
    let hcard = kid(&d, hs, 0);
    let st0 = d.nodes.items[hcard].tstyle;
    d.setFlag(hcard, FL_HOVER, true);
    d.layoutAt(1280.0, 760.0);
    let st1 = d.nodes.items[hcard].tstyle;
    ok(st1 != st0, ":hover gives the card another style");
    d.setFlag(hcard, FL_HOVER, false);
    d.layoutAt(1280.0, 760.0);
    ok(d.nodes.items[hcard].tstyle == st0, "hover off restores the cached style id");

    // ===== 10. incremental: nothing changes, nothing is laid out =====
    game(&d, 0, 6, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let laid0 = d.laid;
    let sty0 = d.restyled;
    game(&d, 0, 6, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    ok(d.laid == laid0, "steady frame: no box laid out");
    ok(d.restyled == sty0, "steady frame: no style recomputed");
    // a resize runs layout again, same size does not
    d.layoutAt(1281.0, 760.0);
    ok(d.laid > laid0, "a new viewport size lays out");
    d.layoutAt(1280.0, 760.0);
    // a class change restyles that node only (cache hit for the rest)
    let laid1 = d.laid;
    game(&d, 2, 0, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    ok(d.laid > laid1, "switching tabs lays out");
    // removing and re-adding frees and reuses ids
    game(&d, 0, 6, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    let live = d.count();
    game(&d, 0, 2, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    ok(d.count() < live, "fewer cards, fewer live nodes");
    let free = d.free.len;
    ok(free > 0, "removed nodes are on the free list");
    game(&d, 0, 6, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    ok(d.free.len < free, "freed ids are reused");

    // ===== 11. timings =====
    timings(&d, &mem, longText, 56);
    timings(&d, &mem, longText, 125);
    printLn(`dom_test ok, checks passed: {CHECKS}`);
}

fn testMinWidth(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let r1 = el(&t, 0, "div", S_TEST, "row");
    let a1 = el(&t, 0, "div", S_TEST, "fa");
    let wd1 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b1 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    let r2 = el(&t, 1, "div", S_TEST, "row");
    let a2 = el(&t, 0, "div", S_TEST, "fz");
    let wd2 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b2 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    t.end();
    t.layoutAt(1000.0, 600.0);
    // fa: min-width auto = min-content = the 300px child, so it overflows the 200px row
    near(nw(&t, a1), 300.0, 0.01, "min-width:auto: the item keeps its 300px min-content");
    near(nw(&t, b1), 0.0, 0.01, "overflowing row: the 50px empty item shrinks (flex-shrink 1, its auto min is 0)");
    near(nx(&t, b1), 300.0, 0.01, "second item pushed past the row end");
    // fz: min-width 0, flex:1 -> 200 - 50
    near(nw(&t, a2), 150.0, 0.01, "min-width:0: the item shrinks to the free space");
    near(nx(&t, b2), 150.0, 0.01, "second item stays inside the row");
    near(nw(&t, b2), 50.0, 0.01, "second item keeps its 50px");
    // shrink: two 150px items in 200px -> 100 each (proportional to base size)
    let t3 = Dom.new(mem, css);
    t3.begin();
    el(&t3, 0, "div", S_TEST, "row");
    let sa = el(&t3, 0, "div", S_TEST, "s150");
    t3.close();
    let sb = el(&t3, 1, "div", S_TEST, "s150");
    t3.close();
    t3.close();
    t3.end();
    t3.layoutAt(1000.0, 600.0);
    near(nw(&t3, sa), 100.0, 0.01, "shrink: 150px items in a 200px row -> 100");
    near(nw(&t3, sb), 100.0, 0.01, "shrink: second item");
    near(nx(&t3, sb), 100.0, 0.01, "shrink: second item x");
    ok(r1 >= 0 && r2 >= 0 && wd1 >= 0 && wd2 >= 0, "ids");

}

fn testBoxes(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let cb = el(&t, 0, "div", S_TEST, "cbx");
    t.close();
    let nn = el(&t, 1, "div", S_TEST, "none");
    t.close();
    let pc = el(&t, 2, "div", S_TEST, "pct");
    t.close();
    let mg = el(&t, 3, "div", S_TEST, "mg");
    t.close();
    let rel = el(&t, 4, "div", S_TEST, "rel");
    let ab = el(&t, 0, "div", S_TEST, "abr");
    t.close();
    let ab2 = el(&t, 1, "div", S_TEST, "abs2");
    t.text("hi");
    t.close();
    t.close();
    let after = el(&t, 5, "div", S_TEST, "mg");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    near(nw(&t, cb), 124.0, 0.01, "content-box: width 100 + padding 20 + border 4");
    near(nh(&t, cb), 54.0, 0.01, "content-box: height 30 + 24");
    near(ny(&t, pc), nh(&t, cb), 0.01, "display:none takes no space");
    near(nw(&t, pc), 200.0, 0.01, "width 50% of 400");
    near(nx(&t, mg), 7.0, 0.01, "margin-left 7");
    near(ny(&t, mg), nh(&t, cb) + 20.0 + 5.0, 0.01, "margin-top 5, no collapsing with the previous sibling");
    near(nw(&t, mg), 386.0, 0.01, "block stretches between margins");
    near(ny(&t, rel), ny(&t, mg) + 10.0 + 5.0, 0.01, "next after margin-bottom 5");
    near(nx(&t, ab), 70.0, 0.01, "absolute right:10");
    near(ny(&t, ab), 67.0, 0.01, "absolute bottom:5");
    near(nx(&t, ab2), 4.0, 0.01, "absolute left:4");
    near(ny(&t, ab2), 3.0, 0.01, "absolute top:3");
    near(nw(&t, ab2), tw(16, false, "hi"), 1.0, "absolute shrink-to-fit width (only left set)");
    ok(nn >= 0 && after >= 0, "ids");

}

// The built-in tag styles (the `j3.ui.uastyle` UA sheet, `tagDisplay`) and how they meet author rules: an author
// class beats the UA rule, an equal-weight author tag rule comes later and wins, and inherited `white-space` reaches code.
const HTML_CSS: string = ".title { font-weight: 400; } .pl { font-weight: 400; } .box { width: 300px; } .m { margin: 8px 0; } b { font-weight: 300; }";

fn testHtmlTags(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c); // first, as a generated root does: the author sheet below comes after it
    parse(&c, HTML_CSS, "html.css", S_TEST);
    let t = Dom.new(mem, &c);
    t.begin();
    let ul = el(&t, 0, "ul", S_TEST, "");
    let li = el(&t, 0, "li", S_TEST, "");
    let st = el(&t, 0, "strong", S_TEST, "");
    t.text("bold");
    t.close();
    let tt = el(&t, 1, "strong", S_TEST, "title");
    t.text("title");
    t.close();
    t.close();
    t.close();
    let p = el(&t, 1, "p", S_TEST, "pl");
    let sp = el(&t, 0, "strong", S_TEST, "");
    t.text("in p");
    t.close();
    t.close();
    let h3 = el(&t, 2, "h3", S_TEST, "");
    let em = el(&t, 0, "em", S_TEST, "");
    t.text("x");
    t.close();
    t.close();
    let pre = el(&t, 3, "pre", S_TEST, "");
    let cd = el(&t, 0, "code", S_TEST, "");
    t.text("k");
    t.close();
    t.close();
    let bx = el(&t, 4, "div", S_TEST, "box");
    let hr = el(&t, 0, "hr", S_TEST, "m");
    t.close();
    t.close();
    let bb = el(&t, 5, "b", S_TEST, "");
    t.text("b");
    t.close();
    let a = el(&t, 6, "a", S_TEST, "");
    t.text("link");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    ok(t.nodes.items[ul].disp == dom.DP_BLOCK && t.nodes.items[li].disp == dom.DP_BLOCK, "ul and li are blocks");
    ok(t.nodes.items[pre].disp == dom.DP_BLOCK && t.nodes.items[hr].disp == dom.DP_BLOCK, "pre and hr are blocks");
    ok(t.nodes.items[h3].disp == dom.DP_BLOCK && t.nodes.items[bx].disp == dom.DP_BLOCK, "h3 and a div are blocks");
    ok(t.nodes.items[st].disp == dom.DP_INLINE && t.nodes.items[a].disp == dom.DP_INLINE, "strong and a are inline");
    ok(t.nodes.items[cd].disp == dom.DP_INLINE, "code is inline");
    ok(c.get(t.nodes.items[st].tstyle, P_FONT_WEIGHT).f == 700.0, "strong is bold (700)");
    ok(c.get(t.nodes.items[tt].tstyle, P_FONT_WEIGHT).f == 400.0, "an author class beats the UA strong rule");
    ok(c.get(t.nodes.items[sp].tstyle, P_FONT_WEIGHT).f == 700.0, "strong inside a font-weight 400 p is still bold");
    ok(c.get(t.nodes.items[bb].tstyle, P_FONT_WEIGHT).f == 300.0, "an author b rule after the UA sheet wins at equal weight");
    ok(c.get(t.nodes.items[em].tstyle, P_FONT_STYLE).i == 1, "em is italic, also inside an h3");
    ok(c.get(t.nodes.items[cd].tstyle, P_WHITE_SPACE).i == WS_PRE, "pre's white-space reaches a nested code");
    ok(c.get(t.nodes.items[a].tstyle, P_CURSOR).i == 2, "a has a pointer cursor");
    near(nh(&t, hr), 1.0, 0.01, "hr is a 1px rule");
    near(nw(&t, hr), nw(&t, bx), 0.01, "hr with margin 8px 0 is the full width of its block");
    near(nw(&t, hr), 300.0, 0.01, "hr width is the box's 300");
    near(ny(&t, hr) - ny(&t, bx), 8.0, 0.01, "hr keeps its margin-top 8");
    // a universal author rule is a later, user origin: it beats the UA em rule at specificity 0
    let c2 = Css.new(mem);
    uastyle.load(&c2);
    parse(&c2, "* { font-style: normal; }", "star.css", S_TEST);
    let t2 = Dom.new(mem, &c2);
    t2.begin();
    let e2 = el(&t2, 0, "em", S_TEST, "");
    t2.text("x");
    t2.close();
    t2.end();
    t2.layoutAt(400.0, 300.0);
    ok(c2.get(t2.nodes.items[e2].tstyle, P_FONT_STYLE).i == 0, "a universal author rule beats the UA em rule");
    ok(p >= 0 && sp >= 0, "ids");
}

fn max2(a: f32, b: f32): f32 {
    if a > b {
        return a;
    }
    return b;
}

/// Gap between two baselines' tops when a `small`-size item is baseline-aligned with a `big`-size one.
fn baselineGap(big: int, small: int): f32 {
    return f32(fontAscent2(big)) - f32(fontAscent2(small));
}

fn fontAscent2(size: int): int {
    return fontAscent(font(size));
}

fn timings(d0: &Dom, mem: &Arena, longText: string, cards: int) {
    // 125 BallCards in the shop grid, the sidebar around them
    let css = d0.css;
    let d = Dom.new(mem, css);
    game(&d, 0, cards, false, longText, "1234 gold");
    d.layoutAt(1280.0, 760.0);
    printLn(`nodes={d.count()} ({cards} cards)`);
    // full layout: every box dirty, same tree
    let reps = 51;
    let samples = mem.alloc::<int>(reps);
    for r in 0..reps {
        d.invalidate();
        let t0 = micros();
        d.layoutAt(1280.0, 760.0);
        samples[r] = micros() - t0;
    }
    printLn(`full layout of {d.count()} nodes (median of {reps}): {median(samples, reps)} us   [target <= 500 us release]`);
    // steady frame: build calls with nothing changed + layout (no layout run)
    let laid0 = d.laid;
    for r2 in 0..reps {
        let t1 = micros();
        game(&d, 0, cards, false, longText, "1234 gold");
        d.layoutAt(1280.0, 760.0);
        samples[r2] = micros() - t1;
    }
    ok(d.laid == laid0, "steady frames ran no layout");
    printLn(`steady frame (build + layout, nothing changed), {d.count()} nodes (median): {median(samples, reps)} us   [target <= 100 us release]`);
    // the stacking lists on a steady tree: the fingerprint pass alone (paint and the hit test each run it once per frame)
    d.stack();
    let builds0 = d.stackBuilds;
    for r3 in 0..reps {
        let tfp = micros();
        d.stack();
        samples[r3] = micros() - tfp;
    }
    ok(d.stackBuilds == builds0, "a steady tree does not rebuild the stacking lists");
    printLn(`stacking fingerprint, {d.count()} nodes (median): {median(samples, reps)} us`);
    // pre-interned ids (what generated code does): build only
    // one counter text changes per frame
    let sidebarTab = 0;
    let counter = mem.alloc::<string>(2);
    counter[0] = "1234 gold";
    counter[1] = "1235 gold";
    for r3 in 0..reps {
        let t2 = micros();
        CARDS = cards;
        counterFrame(&d, counter[r3 % 2], longText);
        d.layoutAt(1280.0, 760.0);
        samples[r3] = micros() - t2;
    }
    let laidA = d.laid;
    counterFrame(&d, counter[1], longText);
    d.layoutAt(1280.0, 760.0);
    counterFrame(&d, counter[0], longText);
    d.layoutAt(1280.0, 760.0);
    printLn(`boxes laid out per counter change: {(d.laid - laidA) / 2} of {d.count()} nodes`);
    printLn(`one counter text changes per frame (median): {median(samples, reps)} us   [target <= 100 us release]`);
    // no allocation in steady state: arena use is flat over 10000 frames
    let used0 = mem.used;
    for r4 in 0..10000 {
        counterFrame(&d, counter[r4 % 2], longText);
        d.layoutAt(1280.0, 760.0);
    }
    let used1 = mem.used;
    printLn(`arena used before/after 10000 changing frames: {used0} / {used1}`);
    ok(used1 == used0, "no per-frame arena allocation in steady state");
    ok(sidebarTab == 0, "unused");
}

/// Like `game` for tab 0 but with the wallet text replaced (the one thing that changes).
fn counterFrame(d: &Dom, gold: string, longText: string) {
    game(d, 0, CARDS, false, longText, gold);
}

fn median(xs: []int, n: int): int {
    // insertion sort a copy
    let i = 0;
    while i < n {
        TMP[i] = xs[i];
        i += 1;
    }
    let a = 1;
    while a < n {
        let v = TMP[a];
        let b = a - 1;
        while b >= 0 && TMP[b] > v {
            TMP[b + 1] = TMP[b];
            b -= 1;
        }
        TMP[b + 1] = v;
        a += 1;
    }
    return TMP[n / 2];
}

// ---- runtime: input, events, scroll, fade ghosts (no GL: paint is covered by speculative/12_ui_runtime) ----

#[singleton]
let RT: [8]int;

const RT_CSS: string = ".box { height: 100px; overflow-y: auto; } .b { height: 30px; background: #000000; } .card { height: 20px; background: #ff0000; transition: background 100ms; } .card:hover { background: #0000ff; } .fade { height: 10px; }";

fn rtFrame(d: &Dom, on: bool) {
    d.beginFrame(Vec2 { x: 1000.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "box");
    for k in 0..6 {
        let b = el(d, k, "div", S_TEST, "b");
        d.attrDisabled(b, k == 3);
        RT[k] = if d.clicked(b) { 1 } else { 0 };
        d.close();
    }
    d.close();
    el(d, 1, "div", S_TEST, "card");
    d.close();
    if on {
        let f = el(d, 2, "div", S_TEST, "fade");
        d.fade(f, 100.0);
        d.close();
    }
    d.layout();
    d.endFrame();
}

fn rtClick(d: &Dom, on: bool, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    rtFrame(d, on);
    d.simInput(x, y, true, 0.0);
    rtFrame(d, on);
    d.simInput(x, y, false, 0.0);
    rtFrame(d, on);
}

const Z_CSS: string = ".host { position: relative; height: 40px; } .top { position: absolute; left: 0px; top: 0px; width: 50px; height: 50px; z-index: 5; } .under { height: 40px; }";

fn zFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    el(d, 0, "div", S_TEST, "host");
    let t = el(d, 0, "div", S_TEST, "top");
    RT[0] = if d.clicked(t) { 1 } else { 0 };
    d.close();
    d.close();
    let u = el(d, 1, "div", S_TEST, "under");
    RT[1] = if d.clicked(u) { 1 } else { 0 };
    d.close();
    d.layout();
    d.endFrame();
}

/// `z-index`: a positioned element overlapping a later sibling wins the hit test, and the layer list is built.
fn testZIndex(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, Z_CSS, "z.css", S_TEST);
    ok(css.warns.len == 0, "z-index parses with no warning");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(10.0, 45.0, false, 0.0);
    zFrame(&d);
    d.simInput(10.0, 45.0, true, 0.0);
    zFrame(&d);
    d.simInput(10.0, 45.0, false, 0.0);
    zFrame(&d);
    ok(RT[0] == 1 && RT[1] == 0, "the z-indexed element is hit over the later sibling");
    ok(d.timeMs() == 48.0, "timeMs follows setFrameMs: three frames of 16 ms");
    ok(d.stackBuilds >= 1 && d.nodes.items[1].lift, "the hit test built the stacking lists (the z-indexed box is lifted)");
}

const DYN_CSS: string = ".bx { width: 100px; height: 10px; transition: width 100ms linear; } .a { height: 20px; } .w50 { width: 50px; } .p { padding: 1px; }";

/// One `<div class="bx {extra}" style:width={w} style:width="{pct}">` frame.
fn dynFrame(d: &Dom, w: f32, pct: string, extra: string): int {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    let id = el(d, 0, "div", S_TEST, "bx");
    d.clsDyn(id, extra);
    d.styleNum(id, 0, "width", w);
    d.styleStr(id, 1, "width", pct);
    d.close();
    d.layout();
    d.endFrame();
    return id;
}

const MULTI_CSS: string = ".bx { width: 50px; height: 10px; } .m { animation: gw 100ms linear forwards, go 1s linear infinite; } .z { animation: none; } @keyframes gw { to { width: 150px; } } @keyframes go { to { opacity: 0.5; } }";

/// One `<div class="bx {extra}">` frame, or none when `on` is false.
fn multiFrame(d: &Dom, on: bool, extra: string): int {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    let id = -1;
    if on {
        id = el(d, 0, "div", S_TEST, "bx");
        d.clsDyn(id, extra);
        d.close();
    }
    d.layout();
    d.endFrame();
    return id;
}

/// Several animations on a node: counted while they run, dropped by `animation: none`, freed with the node (a reused node starts clean).
fn testMultiAnim(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, MULTI_CSS, "multi.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let id = multiFrame(&d, true, "m");
    ok(d.animating == 2, "two animations running");
    for k in 0..4 {
        multiFrame(&d, true, "m");
    }
    ok(d.nodes.items[id].w > 50.0 && d.nodes.items[id].w < 150.0, "width runs beside the opacity animation");
    for k in 0..12 {
        multiFrame(&d, true, "m");
    }
    near(d.nodes.items[id].w, 150.0, 0.01, "the finished animation holds its end");
    ok(d.animating == 1, "only the infinite one is still live");
    // `animation: none` after the list: both stop, the node is back on its computed style
    multiFrame(&d, true, "m z");
    multiFrame(&d, true, "m z");
    ok(d.animating == 0, "animation: none stops every slot");
    near(d.nodes.items[id].w, 50.0, 0.01, "and drops the held frame");
    // removed mid-run: the count is released and a node that reuses the slot does not inherit the animations
    multiFrame(&d, true, "m");
    multiFrame(&d, true, "m");
    ok(d.animating == 2, "restarted");
    multiFrame(&d, false, "");
    ok(d.animating == 0, "a removed element gives its animations back");
    let id2 = multiFrame(&d, true, "");
    for k in 0..4 {
        multiFrame(&d, true, "");
    }
    ok(d.animating == 0 && d.nodes.items[id2].w == 50.0, "a new element runs nothing");
}

/// `class` holes and `style:` overrides: they beat rules, transition, and cost nothing when unchanged.
fn testDyn(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, DYN_CSS, "dyn.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let id = dynFrame(&d, 40.0, "", "w50 a");
    near(d.nodes.items[id].w, 40.0, 0.01, "style:width beats a class rule");
    near(d.nodes.items[id].h, 20.0, 0.01, "a class hole adds its words");
    dynFrame(&d, 40.0, "", "");
    near(d.nodes.items[id].h, 10.0, 0.01, "an empty hole drops them again");
    let r0 = d.restyled;
    dynFrame(&d, 40.0, "", "");
    ok(d.restyled == r0, "the same hole text and value restyle nothing");
    dynFrame(&d, 40.0, "25%", "");
    near(d.nodes.items[id].w, 50.0, 0.01, "a later style: text wins and parses with units");
    dynFrame(&d, 40.0, "", "");
    near(d.nodes.items[id].w, 40.0, 0.01, "empty text clears the override (the number below it shows)");
    // a number changes: the width transition retargets from where it is
    dynFrame(&d, 80.0, "", "");
    dynFrame(&d, 80.0, "", "");
    let w1 = d.nodes.items[id].w;
    ok(w1 > 40.0 && w1 < 80.0 && d.animating == 1, "a new style:width transitions");
    for q in 0..4 {
        dynFrame(&d, 20.0, "", "");
    }
    ok(d.nodes.items[id].w < w1, "retargeted mid-flight, it turns around");
    for k in 0..12 {
        dynFrame(&d, 20.0, "", "");
    }
    near(d.nodes.items[id].w, 20.0, 0.01, "and lands on the new value");
    ok(d.animating == 0, "transition finished");
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..10000 {
        dynFrame(&d, 20.0, "", "");
    }
    ok(d.laid == laid0 && d.restyled == re0, "10000 idle frames: 0 layouts, 0 style recomputes");
    ok(mem.used == used0, "10000 idle frames: no arena growth");
}

const WIDE_CSS: string = ".bx { width: 100px; padding: 7px; color: #ff0000; } .fw { font-weight: 300; }";

/// One frame of `<tag class=cls style:<n0>=t0 style:<n1>=t1>`; returns the node.
fn wideFrame(d: &Dom, tag: string, cls: string, n0: string, t0: string, n1: string, t1: string): int {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    let id = el(d, 0, tag, S_TEST, cls);
    d.styleStr(id, 0, n0, t0);
    d.styleStr(id, 1, n1, t1);
    d.close();
    d.layout();
    d.endFrame();
    return id;
}

/// CSS-wide keywords in `style:` text: `padding` and `all` override a class, empty text restores it; `revert` there is `unset`
/// (also with `@property` registered: `build` never runs the cascade, only `rebuildReaders` does, see css_test).
fn testWideStyle(mem: &Arena) {
    for reg in 0..2 {
        let css = Css.new(mem);
        uastyle.load(&css);
        parse(&css, WIDE_CSS, "wide.css", S_TEST);
        if reg == 1 {
            parse(&css, "@property --z { syntax: '<length>'; inherits: false; initial-value: 1px; }", "reg.css", S_TEST);
        }
        let d = Dom.new(mem, &css);
        d.setFrameMs(16.0);
        d.simInput(-5.0, -5.0, false, 0.0);
        let id = wideFrame(&d, "div", "bx", "padding", "", "color", "");
        ok(css.get(d.nodes.items[id].tstyle, P_PADDING_TOP).f == 7.0, "the class padding");
        wideFrame(&d, "div", "bx", "padding", "initial", "color", "");
        ok(css.get(d.nodes.items[id].tstyle, P_PADDING_TOP).f == 0.0, "style:padding=initial");
        wideFrame(&d, "div", "bx", "padding", "", "color", "");
        ok(css.get(d.nodes.items[id].tstyle, P_PADDING_TOP).f == 7.0, "empty text restores the class value");
        wideFrame(&d, "div", "bx", "all", "unset", "color", "");
        let st = d.nodes.items[id].tstyle;
        ok(css.get(st, P_WIDTH).kind == V_AUTO && css.get(st, P_PADDING_TOP).f == 0.0 && css.get(st, P_COLOR).c == 255, "style:all=unset beats the class (no parent color: initial black)");
        wideFrame(&d, "div", "bx", "all", "unset", "color", "#00ff00");
        ok(css.get(d.nodes.items[id].tstyle, P_COLOR).c == 0x00ff00ff, "a later style: declaration wins over all");
        wideFrame(&d, "div", "bx", "all", "", "color", "");
        st = d.nodes.items[id].tstyle;
        ok(css.get(st, P_WIDTH).f == 100.0 && css.get(st, P_PADDING_TOP).f == 7.0 && css.get(st, P_COLOR).c == 0xff0000ff, "clearing all brings the class back");
        let sid = wideFrame(&d, "strong", "fw", "font-weight", "revert", "color", "");
        let fw = css.get(d.nodes.items[sid].tstyle, P_FONT_WEIGHT).f;
        ok(fw == 400.0, "style:font-weight=revert is unset (inherits 400), with or without @property");
        wideFrame(&d, "strong", "fw", "font-weight", "", "color", "");
        ok(css.get(d.nodes.items[sid].tstyle, P_FONT_WEIGHT).f == 300.0, "and clearing it restores the class");
    }
}

const VAR_CSS: string = ".t { --w: 30px; } .u { --w: 60px; } .bx { width: var(--w, 10px); height: 10px; transition: width 100ms linear; }";

/// Two subtrees (`.t`/`.u` per `kind`) and a bare one; `kind` 0 = t, 1 = u on the first. Sets `ids[0..3]` to the three `.bx`.
fn varFrame(d: &Dom, kind: int, ids: []int) {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    el(d, 0, "div", S_TEST, "");
    let tu = el(d, 0, "div", S_TEST, "");
    d.clsDyn(tu, if kind == 0 { "t" } else { "u" });
    el(d, 0, "div", S_TEST, "");
    ids[0] = el(d, 0, "div", S_TEST, "bx");
    d.close();
    d.close();
    d.close();
    el(d, 1, "div", S_TEST, "u");
    ids[1] = el(d, 0, "div", S_TEST, "bx");
    d.close();
    d.close();
    ids[2] = el(d, 2, "div", S_TEST, "bx");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

/// Per-subtree custom properties: inherited, the fallback, a class change moves one subtree, steady frames cost nothing, hot reload.
fn testVars(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, VAR_CSS, "var.css", S_TEST);
    ok(css.warns.len == 0, "custom properties on classes parse");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ids = mem.alloc::<int>(3);
    varFrame(&d, 0, ids);
    near(d.nodes.items[ids[0]].w, 30.0, 0.01, "--w from a grandparent class");
    near(d.nodes.items[ids[1]].w, 60.0, 0.01, "a sibling subtree has its own value");
    near(d.nodes.items[ids[2]].w, 10.0, 0.01, "no --w above: the fallback");
    let r0 = d.restyled;
    let used0 = mem.used;
    let laid0 = d.laid;
    for k in 0..1000 {
        varFrame(&d, 0, ids);
    }
    ok(d.restyled == r0 && d.laid == laid0, "1000 steady frames: 0 restyles, 0 layouts");
    ok(mem.used == used0, "1000 steady frames: no arena growth");
    varFrame(&d, 1, ids);
    varFrame(&d, 1, ids);
    ok(d.nodes.items[ids[0]].w > 30.0, "swapping the class moves the descendant (it transitions)");
    for k in 0..12 {
        varFrame(&d, 1, ids);
    }
    near(d.nodes.items[ids[0]].w, 60.0, 0.01, "and lands on the new --w");
    let vs0 = css.vsEnt.len;
    let ns0 = css.nstyles;
    for k in 0..2000 {
        varFrame(&d, k % 2, ids);
    }
    ok(css.vsEnt.len == vs0 && css.nstyles == ns0, "toggling a class that changes a var: the style cache and var sets stop growing");
    for k in 0..12 {
        varFrame(&d, 0, ids);
    }
    near(d.nodes.items[ids[0]].w, 30.0, 0.01, "back to the first class");
    css.reset();
    parse(&css, ".t { --w: 44px; } .u { --w: 60px; } .bx { width: var(--w, 10px); height: 10px; }", "var.css", S_TEST);
    d.restyle();
    varFrame(&d, 0, ids);
    varFrame(&d, 0, ids);
    near(d.nodes.items[ids[0]].w, 44.0, 0.01, "hot reload: restyle picks up the new --w");
}

/// An inline `style:` text with a `var()` fallback that changes every frame keeps `css.fbs` and the arena flat.
fn testFallbackText(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, DYN_CSS, "dyn.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let texts = mem.alloc::<string>(64);
    for i in 0..64 {
        texts[i] = `var(--none, {20 + i}px)`;
    }
    let id = 0;
    for k in 0..200 {
        d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
        id = el(&d, 0, "div", S_TEST, "bx");
        d.styleStr(id, 0, "width", texts[k % 64]);
        d.close();
        d.layout();
        d.endFrame();
    }
    let f0 = css.fbs.len;
    let used0 = mem.used;
    for k in 0..10000 {
        d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
        id = el(&d, 0, "div", S_TEST, "bx");
        d.styleStr(id, 0, "width", texts[k % 64]);
        d.close();
        d.layout();
        d.endFrame();
    }
    ok(css.fbs.len == f0 && f0 <= 2, "10000 frames of changing fallback text: fbs flat");
    ok(mem.used == used0, "...and no arena growth");
    ok(css.get(d.nodes.items[id].tstyle, P_WIDTH).kind != 0, "the style resolves");
}

fn testRuntime(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, RT_CSS, "rt.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    rtFrame(&d, false);
    rtFrame(&d, false);
    // click: press and release on the same node
    rtClick(&d, false, 10.0, 45.0);
    ok(RT[1] == 1 && RT[0] == 0 && RT[2] == 0, "click lands on the one node under the mouse");
    // disabled node swallows the click
    rtClick(&d, false, 10.0, 91.0);
    ok(RT[3] == 0 && RT[2] == 0 && RT[4] == 0, "disabled node gets no click");
    // press on one node, release on another: no click
    d.simInput(10.0, 15.0, false, 0.0);
    rtFrame(&d, false);
    d.simInput(10.0, 15.0, true, 0.0);
    rtFrame(&d, false);
    d.simInput(10.0, 75.0, false, 0.0);
    rtFrame(&d, false);
    ok(RT[0] == 0 && RT[2] == 0 && RT[1] == 0, "press and release on different nodes is not a click");
    // hover: the card restyles and starts a background transition
    let r0 = d.restyled;
    d.simInput(10.0, 110.0, false, 0.0);
    rtFrame(&d, false);
    rtFrame(&d, false);
    ok(d.restyled > r0, "hover restyles");
    ok(d.animating == 1, "hover starts one transition");
    // wheel scrolls the nearest scrollable ancestor, clamped to scrollMax
    let box = kid(&d, 0, 0);
    d.simInput(10.0, 50.0, false, -1.0);
    rtFrame(&d, false);
    near(d.nodes.items[box].scrollY, 48.0, 0.01, "wheel scrolls by 48");
    d.simInput(10.0, 50.0, false, -5.0);
    rtFrame(&d, false);
    near(d.nodes.items[box].scrollY, 80.0, 0.01, "scroll clamps at scrollMax");
    // hit test follows the scroll offset: y=50 is now content y=130, which is node 4
    rtClick(&d, false, 10.0, 50.0);
    ok(RT[4] == 1, "click after scrolling hits the node under the mouse");
    // fade ghost: leaving keeps the node, then the sweep removes it
    d.simInput(-5.0, -5.0, false, 0.0);
    rtFrame(&d, true);
    ok(d.ghosts == 0, "no ghost while the node is present");
    rtFrame(&d, false);
    ok(d.ghosts == 1, "leaving a transition:fade node keeps a ghost");
    ok(d.nodes.items[0].last >= 0 && d.nodes.items[d.nodes.items[0].last].ghost, "the ghost stays in the tree");
    for k in 0..8 {
        rtFrame(&d, false);
    }
    ok(d.ghosts == 0, "ghost removed after its fade");
    // steady: idle frames cost no layout, no restyle, no allocation
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..10000 {
        rtFrame(&d, false);
    }
    ok(d.laid == laid0 && d.restyled == re0, "10000 idle frames: 0 layouts, 0 style recomputes");
    ok(mem.used == used0, "10000 idle frames: no arena growth");
    // slots: enter/leave keep nested constructs apart
    d.begin();
    let s1 = d.enter(1);
    let a = el(&d, 0, "div", S_TEST, "b");
    d.close();
    d.leave(s1);
    let s2 = d.enter(2);
    let c = el(&d, 0, "div", S_TEST, "b");
    d.close();
    d.leave(s2);
    ok(a != c && d.nodes.items[a].slot < d.nodes.items[c].slot, "enter(1) sorts before enter(2)");
    d.end();
}

// ===== display: contents rows sharing a grid's columns (chunk 6d) =====
const CT_CSS: string = ".g { display: grid; grid-template-columns: 1fr 140px 100px; width: 600px; height: 300px; overflow-y: auto; } .r { display: contents; } .c { height: 20px; } .w { display: grid; grid-template-columns: 10px 20px 30px 40px 50px 60px; width: 400px; } .w2 { display: grid; grid-template-columns: 1fr 1fr 2fr 50px 1fr; width: 450px; }";
#[singleton]
let CT_CLICK: int;

fn ctFrame(d: &Dom, ord: []int, n: int, uids: []int) {
    d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "g");
    el(d, 0, "div", S_TEST, "r");
    for c in 0..3 {
        el(d, c, "div", S_TEST, "c");
        d.close();
    }
    d.close();
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        el(d, 0, "div", S_TEST, "r");
        for c in 0..3 {
            let cell = el(d, c, "div", S_TEST, "c");
            if d.clicked(cell) {
                CT_CLICK = row * 10 + c;
            }
            d.close();
        }
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn testContents(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, CT_CSS, "ct.css", S_TEST);
    let ok1 = css.warns.len == 0;
    ok(ok1, "contents css parses clean");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    let ord = mem.alloc::<int>(1000);
    let uids = mem.alloc::<int>(1000);
    for i in 0..1000 {
        ord[i] = i;
        uids[i] = -1;
    }
    d.simInput(-5.0, -5.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ctFrame(&d, ord, 1000, uids);
    let g = kid(&d, 0, 0);
    let hr = kid(&d, g, 0);
    near(nw(&d, hr), 0.0, 0.01, "a contents element has no box");
    near(nw(&d, kid(&d, hr, 0)), 360.0, 0.01, "header cell 0: 1fr takes the rest");
    near(nw(&d, kid(&d, hr, 1)), 140.0, 0.01, "header cell 1: 140px");
    near(nx(&d, kid(&d, hr, 1)), 360.0, 0.01, "header cell 1 x");
    near(nx(&d, kid(&d, hr, 2)), 500.0, 0.01, "header cell 2 x");
    let ok2 = true;
    for i in 0..1000 {
        let r = kid(&d, g, i + 1);
        let a = kid(&d, r, 0);
        let b = kid(&d, r, 1);
        let c = kid(&d, r, 2);
        if nx(&d, a) != 0.0 || nx(&d, b) != 360.0 || nx(&d, c) != 500.0 || nw(&d, a) != 360.0 || nw(&d, c) != 100.0 || ny(&d, a) != f32(20 * (i + 1)) || ny(&d, c) != ny(&d, a) {
            ok2 = false;
        }
    }
    ok(ok2, "1000 keyed contents rows share the header's column x, widths and row y");
    near(d.nodes.items[g].contentH, 20020.0, 0.01, "grid content height counts the flattened rows");
    // hit test: a cell of a contents row takes the click
    CT_CLICK = -1;
    d.simInput(400.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(400.0, 50.0, true, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(400.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ok(CT_CLICK == 11, "click at (400, 50) lands on row 1 cell 1 through the contents row");
    // scroll: far rows still paint and hit (the contents row is never culled as a zero box)
    for k in 0..40 {
        d.simInput(400.0, 50.0, false, -5.0);
        ctFrame(&d, ord, 1000, uids);
    }
    let sy = d.nodes.items[g].scrollY;
    ok(sy > 1000.0, "wheel scrolls through the contents rows");
    CT_CLICK = -1;
    d.simInput(10.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(10.0, 50.0, true, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(10.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ok(CT_CLICK == (int((50.0 + sy) / 20.0) - 1) * 10, "click after scrolling hits the row under the mouse");
    // reorder (reverse) and remove one row
    for i in 0..1000 {
        ord[i] = 999 - i;
    }
    ctFrame(&d, ord, 1000, uids);
    let r1 = kid(&d, g, 1);
    let ok3 = nx(&d, kid(&d, r1, 1)) == 360.0 && nw(&d, kid(&d, r1, 0)) == 360.0;
    ok(ok3, "reordered rows keep the shared columns");
    for i in 0..999 {
        ord[i] = 998 - i;
    }
    d.groupFree(uids[999]);
    ctFrame(&d, ord, 999, uids);
    ok(kid(&d, g, 1000) < 0, "removed row is gone (999 rows + header)");
    near(d.nodes.items[g].contentH, 20000.0, 0.01, "content height after removal");
    // steady: idle frames cost nothing
    d.simInput(-5.0, -5.0, false, 0.0);
    ctFrame(&d, ord, 999, uids);
    ctFrame(&d, ord, 999, uids);
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..300 {
        ctFrame(&d, ord, 999, uids);
    }
    ok(d.laid == laid0 && d.restyled == re0, "300 idle frames: 0 layouts, 0 style recomputes");
    ok(mem.used == used0, "300 idle frames: no arena growth");
    // N tracks
    let t = Dom.new(mem, &css);
    t.begin();
    el(&t, 0, "div", S_TEST, "w");
    for q in 0..6 {
        el(&t, q, "div", S_TEST, "c");
        t.close();
    }
    t.close();
    el(&t, 1, "div", S_TEST, "w2");
    for q in 0..5 {
        el(&t, q, "div", S_TEST, "c");
        t.close();
    }
    t.close();
    t.end();
    t.layoutAt(800.0, 600.0);
    let w = kid(&t, 0, 0);
    near(nx(&t, kid(&t, w, 5)), 150.0, 0.01, "six px tracks: column 5 x");
    near(nw(&t, kid(&t, w, 5)), 60.0, 0.01, "six px tracks: column 5 width");
    let w2 = kid(&t, 0, 1);
    near(nw(&t, kid(&t, w2, 0)), 80.0, 0.01, "fr tracks: 1fr of 400px over 5fr");
    near(nw(&t, kid(&t, w2, 2)), 160.0, 0.01, "fr tracks: 2fr");
    near(nx(&t, kid(&t, w2, 3)), 320.0, 0.01, "fr tracks: the 50px track x");
}

const CT2_CSS: string = ".t { display: grid; grid-template-columns: auto 50% 40px; width: 400px; } .r { display: contents; } .c { height: 20px; background: #000000; } .r:hover > .c { background: #ff0000; } .r.sel > .c { height: 30px; }";
#[singleton]
let CT2_TXT: string;

fn ct2Frame(d: &Dom, sel: bool) {
    d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "t");
    for r in 0..3 {
        let rr = el(d, r, "div", S_TEST, "r");
        d.clsIf(rr, "sel", r == 1 && sel);
        el(d, 0, "div", S_TEST, "c");
        d.text(if r == 2 { CT2_TXT } else { "x" });
        d.close();
        el(d, 1, "div", S_TEST, "c");
        d.close();
        el(d, 2, "div", S_TEST, "c");
        d.close();
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

// display: contents outside a grid is a block: own box, own children, counted by the scroll extent
const CB_CSS: string = ".sb { display: block; width: 200px; height: 100px; overflow: auto; } .fx { display: flex; width: 300px; } .r { display: contents; width: 80px; height: 300px; margin-left: 50px; } .c { height: 20px; }";

fn testContentsBlock(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, CB_CSS, "cb.css", S_TEST);
    ok(css.warns.len == 0, "contents block css parses clean");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..2 {
        d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
        el(&d, 0, "div", S_TEST, "sb");
        el(&d, 0, "div", S_TEST, "r");
        el(&d, 0, "div", S_TEST, "c");
        d.close();
        d.close();
        d.close();
        el(&d, 1, "div", S_TEST, "fx");
        el(&d, 0, "div", S_TEST, "r");
        el(&d, 0, "div", S_TEST, "c");
        d.close();
        d.close();
        d.close();
        d.layout();
        d.endFrame();
    }
    let sb = kid(&d, 0, 0);
    let r = kid(&d, sb, 0);
    near(nh(&d, r), 300.0, 0.01, "contents in a block parent has its own height");
    near(nw(&d, kid(&d, r, 0)), nw(&d, r), 0.01, "its child lies inside it");
    near(d.nodes.items[sb].contentH, 300.0, 0.01, "scroll extent covers a contents block");
    near(d.nodes.items[sb].contentW, 130.0, 0.01, "content width counts the contents block's own offset");
    let fx = kid(&d, 0, 1);
    let fr = kid(&d, fx, 0);
    near(nw(&d, fr), 80.0, 0.01, "contents in a flex parent is a box with its width");
    near(nw(&d, kid(&d, fr, 0)), 80.0, 0.01, "its child sits inside it");
}

fn testContents2(mem: &Arena) {
    let css = Css.new(mem);
    // text needs a font: the idle-breakout theme declares one
    let dir = "examples/idle-breakout/ui/";
    if !exists(`{dir}theme.css`) {
        dir = "../examples/idle-breakout/ui/";
    }
    parse(&css, load(mem, `{dir}theme.css`), `{dir}theme.css`, 0);
    // the real app puts its 15px text size on `.app` (theme.css has a 16px root, one rem); this tree has no `.app`
    parse(&css, "div { font-size: 0.9375rem; }", "app.css", 0);
    parse(&css, CT2_CSS, "ct2.css", S_TEST);
    ok(css.warns.len == 0, "contents2 css parses clean");
    FONTPATH = css.fonts.items[0].path;
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    CT2_TXT = "x";
    d.simInput(-5.0, -5.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    let t = kid(&d, 0, 0);
    let r0 = kid(&d, t, 0);
    let r1 = kid(&d, t, 1);
    let r2 = kid(&d, t, 2);
    near(nx(&d, kid(&d, r0, 1)), tw(15, false, "x") + 0.0, 3.0, "auto track fits the widest cell text");
    near(nw(&d, kid(&d, r0, 1)), 200.0, 0.01, "50% track is half the container's content width");
    near(nx(&d, kid(&d, r0, 2)) + nw(&d, kid(&d, r0, 2)), nx(&d, kid(&d, r0, 1)) + 200.0 + 40.0, 0.01, "px track after the % track");
    // hover a cell: the contents row matches :hover and restyles its cells
    let cell = kid(&d, r0, 0);
    let st0 = d.nodes.items[cell].tstyle;
    d.simInput(2.0, 2.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    ok(d.nodes.items[cell].tstyle != st0, ".row:hover > .cell restyles the cell through a contents row");
    ok(d.nodes.items[kid(&d, r0, 1)].tstyle != st0 && d.nodes.items[kid(&d, r1, 0)].tstyle == st0, "only the hovered row's cells restyle");
    d.simInput(-5.0, -5.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    ok(d.nodes.items[cell].tstyle == st0, "hover off restores the cell style");
    // toggling a class on the contents row restyles its cells and relayouts the grid
    near(ny(&d, kid(&d, r2, 0)), 40.0, 0.01, "row 2 starts at 40");
    ct2Frame(&d, true);
    near(nh(&d, kid(&d, r1, 0)), 30.0, 0.01, ".row.sel > .cell changes the cell height");
    near(ny(&d, kid(&d, r2, 0)), 50.0, 0.01, "the grid relayouts: row 2 moves down by 10");
    ct2Frame(&d, false);
    near(ny(&d, kid(&d, r2, 0)), 40.0, 0.01, "class removed: row 2 moves back");
    // a text change inside one cell relayouts the container and widens the auto track
    let wBefore = nw(&d, kid(&d, r0, 0));
    CT2_TXT = "a much longer cell text";
    ct2Frame(&d, false);
    near(nw(&d, kid(&d, r0, 0)), tw(15, false, "a much longer cell text"), 3.0, "auto track follows the widest cell after a text change");
    ok(nw(&d, kid(&d, r0, 0)) > wBefore + 20.0, "auto track grew");
    near(nx(&d, kid(&d, r0, 1)), nw(&d, kid(&d, r0, 0)), 0.01, "later tracks shift with it");
    ct2Frame(&d, false);
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..200 {
        ct2Frame(&d, false);
    }
    ok(d.laid == laid0 && d.restyled == re0 && mem.used == used0, "200 idle frames after the text change: 0 layouts, 0 restyles, no arena growth");
}
