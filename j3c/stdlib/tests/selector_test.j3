// Tests for `#id`, the sibling combinators `+` / `~` and `::before` / `::after` through j3.ui.dom: matching after
// insert / remove / keyed reorder, sibling :hover, restyle cost, pseudo-element boxes (size, content change, removal,
// keyed rows, hit testing, steady frames). Parsing and specificity are in css_test.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/selector_test.j3
// Panics on the first failed check.

module selector_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff > 0.01 {
        printLn(`FAIL: {msg}: got {a}, want {b}`);
        panic(msg);
    }
}

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } .list { width: 300px; } .it { height: 20px; } .it + .it { margin-top: 10px; } .it.on ~ .it { width: 77px; } .it:hover + .it { height: 40px; } .it.on + .it + .it { padding-left: 5px; } #hero { width: 123px; } .it.k { width: 10px; } .card { position: relative; width: 200px; } .card::before { content: \"AB\"; display: block; width: 30px; height: 12px; } .card::after { content: \"x\"; display: block; position: absolute; right: 0; top: 0; width: 8px; height: 8px; } .card.plain::before { content: none; } .card.alt::before { content: \"CD\"; } .card > .kid { height: 10px; } .card > .kid:first-child { width: 11px; } .gone::after { content: \"!\"; } .kl::before { content: \"b\"; display: block; height: 4px; } .kl::after { content: \"a\"; display: block; height: 4px; }";

#[singleton]
let HOVER_Y: f32;
#[singleton]
let ITEMS: [16]int;
#[singleton]
let ON: int;
#[singleton]
let HERO: int;

// the list: `n` items in the order `ord` (keyed by uid), `on` marks one with class `on`
fn listFrame(d: &Dom, n: int, ord: []int, uids: []int, onItem: int) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let ul = d.open(0, d.tag("div"), 1);
    d.cls(ul, "list");
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        let li = d.open(0, d.tag("div"), 1);
        d.cls(li, "it");
        d.clsIf(li, "on", row == onItem);
        if row == 2 {
            d.attrId(li, "hero");
            HERO = li;
        }
        ITEMS[row] = li;
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn settle(d: &Dom, n: int, ord: []int, uids: []int, onItem: int) {
    listFrame(d, n, ord, uids, onItem);
    listFrame(d, n, ord, uids, onItem);
}

fn testSiblings(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ord = mem.alloc::<int>(16);
    let uids = mem.alloc::<int>(16);
    for i in 0..16 {
        ord[i] = i;
        uids[i] = -1;
    }
    settle(&d, 4, ord, uids, -1);
    let n = &d.nodes;
    near(n.items[ITEMS[0]].y, 0.0, "the first item has no margin");
    near(n.items[ITEMS[1]].y, 30.0, "li + li: the second item is pushed 10px");
    near(n.items[ITEMS[2]].y, 60.0, "third");
    near(n.items[ITEMS[3]].y, 90.0, "fourth");
    // remove the first item: the new first loses its margin
    ord[0] = 1;
    ord[1] = 2;
    ord[2] = 3;
    settle(&d, 3, ord, uids, -1);
    near(n.items[ITEMS[1]].y, 0.0, "after removing the first item the next one has no preceding sibling");
    near(n.items[ITEMS[2]].y, 30.0, "and the rest keep their separator");
    // insert at the front again
    ord[0] = 0;
    ord[1] = 1;
    ord[2] = 2;
    ord[3] = 3;
    settle(&d, 4, ord, uids, -1);
    near(n.items[ITEMS[0]].y, 0.0, "re-inserted first item");
    near(n.items[ITEMS[1]].y, 30.0, "the old first item has a preceding sibling again");
    // keyed reorder: 3 moves to the front
    ord[0] = 3;
    ord[1] = 0;
    ord[2] = 1;
    ord[3] = 2;
    settle(&d, 4, ord, uids, -1);
    near(n.items[ITEMS[3]].y, 0.0, "reorder: the moved item is first and unseparated");
    near(n.items[ITEMS[0]].y, 30.0, "reorder: the former first is now separated");
    near(n.items[ITEMS[2]].y, 90.0, "reorder: the last");
    // ~ and chained +: .on marks item 0 (first in order is 3)
    settle(&d, 4, ord, uids, 0);
    near(n.items[ITEMS[1]].w, 77.0, ".on ~ .it styles later siblings");
    near(n.items[ITEMS[2]].w, 128.0, "this one has #hero (123) plus the chained rule padding");
    near(n.items[ITEMS[3]].w, 300.0, "but not the earlier one");
    near(n.items[ITEMS[0]].w, 300.0, "nor itself");
    // moving .on to the item before: only the later ones change
    settle(&d, 4, ord, uids, 3);
    near(n.items[ITEMS[0]].w, 77.0, ".on moved: the item after it is styled");
    near(n.items[ITEMS[3]].w, 300.0, "and the old marked one is plain again");
    settle(&d, 4, ord, uids, -1);
    near(n.items[ITEMS[1]].w, 300.0, "removing .on clears every later sibling");
    // bounded restyle: .on on the LAST item restyles that item only; on the first, all after it
    let r0 = d.restyled;
    settle(&d, 4, ord, uids, 2);
    ok(d.restyled - r0 <= 2, "a change on the last item restyles at most itself");
    r0 = d.restyled;
    settle(&d, 4, ord, uids, 3);
    ok(d.restyled - r0 >= 4 && d.restyled - r0 <= 12, "a change on the first item restyles the items after it");
    // steady
    settle(&d, 4, ord, uids, 3);
    let l0 = d.laid;
    let s0 = d.restyled;
    listFrame(&d, 4, ord, uids, 3);
    listFrame(&d, 4, ord, uids, 3);
    ok(d.laid == l0 && d.restyled == s0, "steady frames lay out and restyle nothing");
    // sibling :hover  (.it:hover + .it { height: 40px })
    settle(&d, 4, ord, uids, -1);
    let hy = n.items[ITEMS[ord[1]]].y + 5.0;
    d.simInput(10.0, hy, false, 0.0);
    listFrame(&d, 4, ord, uids, -1);
    listFrame(&d, 4, ord, uids, -1);
    near(n.items[ITEMS[ord[2]]].h, 40.0, ":hover + sibling: the next item is taller");
    near(n.items[ITEMS[ord[1]]].h, 20.0, "the hovered item itself is not");
    near(n.items[ITEMS[ord[3]]].h, 20.0, "a lone + does not reach the one after");
    d.simInput(-5.0, -5.0, false, 0.0);
    listFrame(&d, 4, ord, uids, -1);
    listFrame(&d, 4, ord, uids, -1);
    near(n.items[ITEMS[ord[2]]].h, 20.0, "leaving restores the sibling");
    // chained +: .on + .it + .it { padding-left: 5px }
    settle(&d, 4, ord, uids, 3);
    near(n.items[ITEMS[1]].w, 82.0, "chained .on + .it + .it adds padding to the second after .on");
    // #id beats .it.k? (1,0,0 vs 0,2,0): hero has id and 'it' class, #hero width wins over .it.on ~ width
    ok(HERO >= 0, "an item with an id");
    near(n.items[HERO].w, 123.0, "#hero beats class rules (.it.on ~ .it)");
}

fn cardFrame(d: &Dom, cls: string, nkids: int, extra: bool) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, "card");
    if cls.len > 0 {
        d.clsDyn(c, cls);
    }
    ITEMS[0] = c;
    for i in 0..nkids {
        let k = d.open(i, d.tag("div"), 1);
        d.cls(k, "kid");
        ITEMS[1 + i] = k;
        d.close();
    }
    d.close();
    if extra {
        let g = d.open(1, d.tag("div"), 1);
        d.cls(g, "gone");
        ITEMS[10] = g;
        d.close();
    }
    d.layout();
    d.endFrame();
}

fn testPseudo(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    cardFrame(&d, "", 2, true);
    cardFrame(&d, "", 2, true);
    let n = &d.nodes;
    let c = ITEMS[0];
    let b = n.items[c].first;
    let a = n.items[c].last;
    ok(n.items[b].pe == 1 && n.items[a].pe == 2, "::before is the first child, ::after the last");
    ok(n.items[ITEMS[1]].prev == b && n.items[ITEMS[2]].next == a, "the real children sit between them");
    near(n.items[b].h, 12.0, "::before has the declared height");
    near(n.items[b].w, 30.0, "and width");
    near(n.items[ITEMS[1]].y, 12.0, "the first real child starts below the ::before box");
    near(n.items[ITEMS[1]].w, 11.0, ":first-child ignores the pseudo-element boxes");
    near(n.items[ITEMS[2]].w, 200.0, "second child is not first-child");
    near(n.items[c].h, 32.0, "the card holds ::before and both children");
    near(n.items[a].x, 192.0, "::after is absolutely placed at the right edge");
    near(n.items[a].y, 0.0, "and the top");
    ok(same(d.textOf(n.items[b].first), "AB"), "::before holds its content text");
    ok(same(d.textOf(n.items[a].first), "x"), "::after holds its content text");
    ok(n.items[ITEMS[10]].first >= 0 && n.items[n.items[ITEMS[10]].first].pe == 2, "a rule that names only ::after still makes the box");
    // hit testing: the box is not a target, the card is
    d.simInput(5.0, 5.0, false, 0.0);
    cardFrame(&d, "", 2, true);
    cardFrame(&d, "", 2, true);
    ok(d.hover == c, "the pointer over ::before hovers its host");
    d.simInput(-5.0, -5.0, false, 0.0);
    // steady frame
    cardFrame(&d, "", 2, true);
    cardFrame(&d, "", 2, true);
    let l0 = d.laid;
    let s0 = d.restyled;
    let nodes0 = n.len;
    cardFrame(&d, "", 2, true);
    cardFrame(&d, "", 2, true);
    ok(d.laid == l0 && d.restyled == s0 && n.len == nodes0, "steady frames: nothing laid out, restyled or allocated");
    // class toggles: content: none removes the box (display: none), a different content updates the text
    cardFrame(&d, "plain", 2, true);
    cardFrame(&d, "plain", 2, true);
    b = n.items[c].first;
    near(n.items[ITEMS[1]].y, 0.0, "content: none: no ::before box, the child moves up");
    ok(n.items[b].pe == 1, "(the node itself stays while its rule matches)");
    cardFrame(&d, "alt", 2, true);
    cardFrame(&d, "alt", 2, true);
    b = n.items[c].first;
    ok(same(d.textOf(n.items[b].first), "CD"), "a class toggle changes the content text");
    near(n.items[ITEMS[1]].y, 12.0, "and the box is back");
    // the host stops matching: boxes are removed
    cardFrame(&d, "alt", 2, false);
    cardFrame(&d, "alt", 2, false);
    ok(n.items[ITEMS[10]].kind != 1 || n.items[ITEMS[10]].first < 0 || n.items[n.items[ITEMS[10]].first].pe == 0, "the removed .gone element is gone");
    ok(n.items[ITEMS[1]].first < 0, "an element no pseudo rule matches has no box");
}

// pseudo-element boxes inside keyed rows
fn rowsFrame(d: &Dom, ord: []int, n: int, uids: []int, cls: string) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let root = d.open(0, d.tag("div"), 1);
    d.cls(root, "list");
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        let c = d.open(0, d.tag("div"), 1);
        d.cls(c, "card");
        d.clsDyn(c, cls);
        ITEMS[row] = c;
        let k = d.open(0, d.tag("div"), 1);
        d.cls(k, "kid");
        d.close();
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn testRows(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ord = mem.alloc::<int>(8);
    let uids = mem.alloc::<int>(8);
    for i in 0..8 {
        ord[i] = i;
        uids[i] = -1;
    }
    rowsFrame(&d, ord, 4, uids, "");
    rowsFrame(&d, ord, 4, uids, "");
    let n = &d.nodes;
    for r in 0..4 {
        ok(n.items[n.items[ITEMS[r]].first].pe == 1 && n.items[n.items[ITEMS[r]].last].pe == 2, "every keyed row has its boxes");
        near(n.items[ITEMS[r]].y, f32(r) * 22.0, "rows stack by their height including the ::before box");
    }
    let len0 = n.len;
    ord[0] = 2;
    ord[1] = 0;
    ord[2] = 3;
    ord[3] = 1;
    rowsFrame(&d, ord, 4, uids, "");
    rowsFrame(&d, ord, 4, uids, "");
    for r in 0..4 {
        ok(n.items[n.items[ITEMS[r]].first].pe == 1 && n.items[n.items[ITEMS[r]].last].pe == 2, "boxes follow a reordered row");
    }
    near(n.items[ITEMS[2]].y, 0.0, "reordered rows move with their boxes");
    near(n.items[ITEMS[1]].y, 66.0, "row 1 moved to the end");
    ok(n.len == len0, "a reorder makes and frees no nodes");
    // drop a row: its boxes go with it
    rowsFrame(&d, ord, 3, uids, "");
    rowsFrame(&d, ord, 3, uids, "");
    let l0 = d.laid;
    let s0 = d.restyled;
    rowsFrame(&d, ord, 3, uids, "");
    rowsFrame(&d, ord, 3, uids, "");
    ok(d.laid == l0 && d.restyled == s0, "steady keyed rows with boxes cost nothing");
}

// scoped component styles (scope 3), a parent component (scope 4) that passes a class to a root, and an outsider (scope 5)
const SCOPED3: string = ".item { height: 20px; } .item + .item { margin-top: 10px; } .badge::after { content: \"!\"; display: block; height: 6px; }";
const SCOPED4: string = ".hl::before { content: \"P\"; display: block; height: 5px; } .hl { height: 20px; }";

fn scopedFrame(d: &Dom, outsider: bool) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let ul = d.open(0, d.tag("div"), 4);
    for i in 0..4 {
        let li = d.open(i, d.tag("div"), 3);
        d.cls(li, "item");
        d.clsIf(li, "badge", i == 1);
        if i == 0 {
            d.cls(li, "hl");
            d.scopePass(li, 4);
        }
        ITEMS[i] = li;
        d.close();
    }
    if outsider {
        let o = d.open(4, d.tag("div"), 5);
        d.cls(o, "item");
        d.cls(o, "badge");
        ITEMS[4] = o;
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn testScoped(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); }", "f.css", 0);
    parse(&css, SCOPED3, "s3.css", 3);
    parse(&css, SCOPED4, "s4.css", 4);
    ok(css.warns.len == 0, "scoped sheets parse");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    scopedFrame(&d, true);
    scopedFrame(&d, true);
    let n = &d.nodes;
    near(n.items[ITEMS[0]].y, 0.0, "scoped: first item");
    near(n.items[ITEMS[1]].y, 30.0, "a component's own `.item + .item` applies to its elements");
    near(n.items[ITEMS[3]].y, 90.0, "and to later siblings");
    near(n.items[ITEMS[4]].y, 110.0, "an element of another component gets no scoped sibling rule");
    ok(n.items[n.items[ITEMS[1]].last].pe == 2, "the component's `.badge::after` makes a box");
    ok(n.items[ITEMS[4]].first < 0, "the same selector in another component makes none");
    ok(n.items[ITEMS[0]].first >= 0 && n.items[n.items[ITEMS[0]].first].pe == 1, "a parent component's `.hl::before` reaches a root through scope2");
    near(n.items[n.items[ITEMS[0]].first].h, 5.0, "with its own size");
    ok(n.items[ITEMS[2]].first < 0, "an element without the passed class has none");
    let l0 = d.laid;
    let s0 = d.restyled;
    scopedFrame(&d, true);
    scopedFrame(&d, true);
    ok(d.laid == l0 && d.restyled == s0, "steady scoped frames cost nothing");
}

// leaving ghosts are not siblings: `li + li` does not see an element that is fading out
fn ghostFrame(d: &Dom, n: int) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let ul = d.open(0, d.tag("div"), 1);
    d.cls(ul, "list");
    for i in 0..n {
        let li = d.open(i, d.tag("div"), 1);
        d.cls(li, "it");
        d.fade(li, 1000.0);
        ITEMS[i] = li;
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn klFrame(d: &Dom, ord: []int, n: int, uids: []int) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let h = d.open(0, d.tag("div"), 1);
    d.cls(h, "kl");
    ITEMS[15] = h;
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        let r = d.open(0, d.tag("div"), 1);
        d.cls(r, "it");
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

// `::before` / `::after` of a host whose children are keyed rows: still first / last after shuffles, inserts and removals
fn testRowsAfter(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ord = mem.alloc::<int>(12);
    let uids = mem.alloc::<int>(12);
    for i in 0..12 {
        ord[i] = i;
        uids[i] = -1;
    }
    let n = &d.nodes;
    let seed = 12345;
    let cnt = 8;
    for round in 0..40 {
        // shuffle the first `cnt`, sometimes grow or shrink
        for i in 0..cnt {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            let j = seed % cnt;
            let t = ord[i];
            ord[i] = ord[j];
            ord[j] = t;
        }
        if round % 7 == 3 && cnt < 12 {
            cnt += 2;
        } else if round % 7 == 5 && cnt > 4 {
            cnt -= 3;
        }
        klFrame(&d, ord, cnt, uids);
        let h = ITEMS[15];
        ok(n.items[n.items[h].first].pe == 1, "keyed host: ::before stays first");
        ok(n.items[n.items[h].last].pe == 2, "keyed host: ::after stays last after a shuffle");
        let c = n.items[n.items[h].first].next;
        let rows = 0;
        while c != n.items[h].last {
            ok(n.items[c].pe == 0, "only rows between the boxes");
            rows += 1;
            c = n.items[c].next;
        }
        ok(rows == cnt, "every row is between the boxes");
        near(n.items[h].h, f32(cnt) * 20.0 + 8.0 + f32(cnt - 1) * 10.0, "height: rows, separators and both boxes");
    }
}

fn testGhost(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    ghostFrame(&d, 3);
    ghostFrame(&d, 3);
    let n = &d.nodes;
    let first = ITEMS[0];
    let second = ITEMS[1];
    near(n.items[second].y, 30.0, "ghost test: separator before the first removal");
    ghostFrame(&d, 2);
    ghostFrame(&d, 2);
    near(n.items[first].y, 0.0, "the first item stays first");
    near(n.items[second].y, 30.0, "the remaining second item keeps one separator");
    // remove the first item instead: the next one must not be separated from a ghost
    let ids = mem.alloc::<int>(1);
    ids[0] = 0;
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(&d);
    let ul = d.open(0, d.tag("div"), 1);
    d.cls(ul, "list");
    let li = d.open(1, d.tag("div"), 1);
    d.cls(li, "it");
    d.fade(li, 1000.0);
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    ok(n.items[first].ghost, "the first item is fading out");
    near(n.items[li].y, 20.0, "a leaving element still takes room but is not a sibling: no separator margin");
}

const FONT: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } .x { width: 50px; } ";
const WITH: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } .x { width: 50px; } .x::after { content: \"z\"; display: block; height: 5px; }";

fn xFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let x = d.open(0, d.tag("div"), 1);
    d.cls(x, "x");
    ITEMS[0] = x;
    d.close();
    d.layout();
    d.endFrame();
}

// hot reload: dropping the last pseudo-element rule removes the boxes, bringing it back makes them again
fn testReload(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, WITH, "r.css", 1);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    xFrame(&d);
    xFrame(&d);
    let n = &d.nodes;
    ok(n.items[ITEMS[0]].first >= 0 && n.items[n.items[ITEMS[0]].last].pe == 2, "reload: the box exists");
    css.reset();
    parse(&css, FONT, "r.css", 1);
    d.restyle();
    xFrame(&d);
    xFrame(&d);
    ok(n.items[ITEMS[0]].first < 0 && d.npe == 0, "reload without the rule: the box is gone");
    css.reset();
    parse(&css, WITH, "r.css", 1);
    d.restyle();
    xFrame(&d);
    xFrame(&d);
    ok(n.items[ITEMS[0]].first >= 0 && n.items[n.items[ITEMS[0]].last].pe == 2 && d.npe == 1, "reload with the rule again: the box is back");
}

const FONT2: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, label, input { font-family: \"T\"; font-size: 14px; } .sl { width: 300px; } .sl > .r { height: 20px; display: block; } .em { height: 15px; display: block; } label { display: block; height: 10px; } input[type=text] { width: 120px; }";
const STRUCT2: string = ".sl > .r:nth-last-child(1) { height: 31px; } .sl > .r:only-child { height: 42px; } .sl > .r:first-of-type { width: 111px; } .sl > .r:last-of-type { width: 77px; } .em:empty { height: 9px; } input:checked + label { width: 55px; } input:placeholder-shown { width: 66px; } input:enabled { height: 18px; } .sl > .r:nth-last-of-type(2) { padding-left: 4px; }";

#[singleton]
let CHK: bool;
#[singleton]
let TXT2: string;
#[singleton]
let BIND: bool;

// .sl with `n` keyed rows (+ a trailing span), an `.em` box holding `txt`, a checkbox + label, a text box with a placeholder
fn structFrame(d: &Dom, n: int, ord: []int, uids: []int, span: bool, txt: string) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let sl = d.open(0, d.tag("div"), 1);
    d.cls(sl, "sl");
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        let r = d.open(0, d.tag("div"), 1);
        d.cls(r, "r");
        ITEMS[row] = r;
        d.close();
        d.keyEnd();
    }
    if span {
        let sp = d.open(20, d.tag("span"), 1);
        ITEMS[14] = sp;
        d.close();
    }
    d.close();
    let em = d.open(1, d.tag("div"), 1);
    d.cls(em, "em");
    ITEMS[10] = em;
    if txt.len > 0 {
        d.text(txt);
    }
    d.close();
    let cb = d.open(2, d.tag("input"), 1);
    d.attrType(cb, "checkbox");
    d.attrChecked(cb, CHK);
    if d.clicked(cb) {
        CHK = !CHK;
    }
    ITEMS[12] = cb;
    d.close();
    let lb = d.open(3, d.tag("label"), 1);
    d.text("x");
    ITEMS[13] = lb;
    d.close();
    let tb = d.open(4, d.tag("input"), 1);
    d.attrType(tb, "text");
    d.attrPlaceholder(tb, "name");
    if BIND {
        if d.changed(tb) {
            TXT2 = d.strValue(tb);
        }
        d.attrText(tb, TXT2);
    }
    ITEMS[11] = tb;
    d.close();
    d.layout();
    d.endFrame();
}

fn structSettle(d: &Dom, n: int, ord: []int, uids: []int, span: bool, txt: string) {
    structFrame(d, n, ord, uids, span, txt);
    structFrame(d, n, ord, uids, span, txt);
}

// :nth-last-child :only-child :first/last-of-type :empty :checked :enabled :placeholder-shown through the DOM: matching after
// insert / remove / keyed move / text change, the restyle cost, and zero cost without such rules
fn testStruct(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, FONT2, "struct.css", 1);
    parse(&css, STRUCT2, "struct2.css", 1);
    ok(css.warns.len == 0 && css.structMode == 1, "structural sheet parses");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ord = mem.alloc::<int>(16);
    let uids = mem.alloc::<int>(16);
    for i in 0..16 {
        ord[i] = i;
        uids[i] = -1;
    }
    CHK = false;
    TXT2 = "";
    BIND = true;
    let n = &d.nodes;
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[3]].h, 31.0, ":nth-last-child(1): the last row");
    near(n.items[ITEMS[2]].h, 20.0, "and not the one before");
    near(n.items[ITEMS[0]].w, 111.0, ":first-of-type");
    near(n.items[ITEMS[3]].w, 77.0, ":last-of-type");
    near(n.items[ITEMS[1]].w, 300.0, "a middle row has neither");
    near(n.items[ITEMS[2]].w, 300.0, "nth-last-of-type(2) only sets padding, the width stays");
    // a trailing span: the last row is no longer the last child, but still the last div
    structSettle(&d, 4, ord, uids, true, "");
    near(n.items[ITEMS[3]].h, 20.0, "a later sibling of another type: no longer :nth-last-child(1)");
    near(n.items[ITEMS[3]].w, 77.0, "but still :last-of-type");
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[3]].h, 31.0, "removing the span restyles the rows before it");
    // remove the last row: the one before it takes over
    let r0 = d.restyled;
    structSettle(&d, 3, ord, uids, false, "");
    near(n.items[ITEMS[2]].h, 31.0, "after removing the last row the new last one is :nth-last-child(1)");
    near(n.items[ITEMS[2]].w, 77.0, "and :last-of-type");
    ok(d.restyled - r0 <= 12, "a removal restyles the parent, its children and nothing else");
    // insert at the end again, then a keyed move
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[3]].h, 31.0, "re-added last row");
    near(n.items[ITEMS[2]].h, 20.0, "the former last row is plain again");
    ord[0] = 3;
    ord[1] = 0;
    ord[2] = 1;
    ord[3] = 2;
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[3]].w, 111.0, "keyed move: the moved row is :first-of-type");
    near(n.items[ITEMS[0]].w, 300.0, "the former first lost it");
    near(n.items[ITEMS[2]].w, 77.0, "and the new last has :last-of-type");
    near(n.items[ITEMS[2]].h, 31.0, "and :nth-last-child(1)");
    // only child
    ord[0] = 1;
    structSettle(&d, 1, ord, uids, false, "");
    near(n.items[ITEMS[1]].h, 42.0, ":only-child");
    ord[0] = 0;
    ord[1] = 1;
    ord[2] = 2;
    ord[3] = 3;
    structSettle(&d, 4, ord, uids, false, "");
    // :empty: text arrives, goes blank, goes away
    near(n.items[ITEMS[10]].h, 9.0, ":empty box");
    structSettle(&d, 4, ord, uids, false, "  ");
    near(n.items[ITEMS[10]].h, 9.0, "whitespace-only text keeps it :empty (Selectors 4)");
    structSettle(&d, 4, ord, uids, false, "hi");
    near(n.items[ITEMS[10]].h, 15.0, "text makes it not :empty");
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[10]].h, 9.0, "removing the text: :empty again");
    // :checked + label, by a click
    near(n.items[ITEMS[13]].w, 800.0, "unchecked: the label is full width");
    let cx = d.absX(ITEMS[12]) + 3.0;
    let cy = d.absY(ITEMS[12]) + 3.0;
    d.simInput(cx, cy, false, 0.0);
    structSettle(&d, 4, ord, uids, false, "");
    d.simInput(cx, cy, true, 0.0);
    structFrame(&d, 4, ord, uids, false, "");
    d.simInput(cx, cy, false, 0.0);
    structSettle(&d, 4, ord, uids, false, "");
    ok(CHK, "the click checked the box");
    near(n.items[ITEMS[13]].w, 55.0, "input:checked + label restyles the label");
    near(n.items[ITEMS[12]].h, 18.0, ":enabled");
    // :placeholder-shown while the value is empty
    near(n.items[ITEMS[11]].w, 66.0, ":placeholder-shown");
    TXT2 = "abc";
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[11]].w, 120.0, "a value hides the placeholder");
    TXT2 = "";
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[11]].w, 66.0, "and clearing it brings :placeholder-shown back");
    // typing into a box that is not bound reaches the flag the same frame (the edit path sets it, not the bound value)
    BIND = false;
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[11]].w, 66.0, "unbound box: still :placeholder-shown");
    let tx = d.absX(ITEMS[11]) + 5.0;
    let ty = d.absY(ITEMS[11]) + 5.0;
    d.simInput(tx, ty, true, 0.0);
    structFrame(&d, 4, ord, uids, false, "");
    d.simInput(tx, ty, false, 0.0);
    structSettle(&d, 4, ord, uids, false, "");
    d.simKeys("a", "");
    structFrame(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[11]].w, 120.0, "one typed character turns :placeholder-shown off in that frame");
    d.simKeys("", "Backspace");
    structFrame(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[11]].w, 66.0, "and Backspace turns it back on");
    BIND = true;
    structSettle(&d, 4, ord, uids, false, "");
    // steady
    let l0 = d.laid;
    let s0 = d.restyled;
    structFrame(&d, 4, ord, uids, false, "");
    structFrame(&d, 4, ord, uids, false, "");
    ok(d.laid == l0 && d.restyled == s0, "steady frames lay out and restyle nothing");
    // without a structural rule nothing extra restyles
    let plain = Css.new(mem);
    parse(&plain, FONT2, "plain.css", 1);
    parse(&plain, "input:checked + label { width: 55px; }", "plain2.css", 1);
    ok(plain.structMode == 0, "no structural rule, no structural mode");
    let d2 = Dom.new(mem, &plain);
    d2.setFrameMs(16.0);
    d2.simInput(-5.0, -5.0, false, 0.0);
    for i in 0..16 {
        uids[i] = -1;
    }
    structSettle(&d2, 8, ord, uids, false, "");
    r0 = d2.restyled;
    structSettle(&d2, 7, ord, uids, false, "");
    ok(d2.restyled - r0 <= 2, "a removal restyles only the new last row (the :last-child flag), not its siblings");
}

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

fn massFrame(d: &Dom, n: int) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let sl = d.open(0, d.tag("div"), 1);
    d.cls(sl, "sl");
    for i in 0..n {
        let r = d.open(i, d.tag("div"), 1);
        d.cls(r, "r");
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

// 2000 children mounted in one frame under a structural rule: each parent's children are flagged once, not once per insert
fn testMass(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, FONT2, "mass.css", 1);
    parse(&css, ".sl > .r:nth-of-type(even) { width: 11px; } .sl > .r:nth-last-child(1) { height: 5px; }", "mass2.css", 1);
    ok(css.warns.len == 0 && css.structMode == 1, "zebra sheet parses");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let t0 = micros();
    massFrame(&d, 2000);
    let dt = micros() - t0;
    ok(d.kidMarks <= 100, "mounting 2000 rows flags the children of a parent once, not once per insert");
    ok(dt < 3000000, "mounting 2000 rows with structural rules takes well under 3 s");
    massFrame(&d, 2000);
    near(d.nodes.items[d.nodes.items[d.nodes.items[0].first].first].w, 300.0, "row 1 is odd");
    let r1 = d.nodes.items[d.nodes.items[d.nodes.items[0].first].first].next;
    near(d.nodes.items[r1].w, 11.0, "row 2 is even");
    let k0 = d.kidMarks;
    massFrame(&d, 2001);
    ok(d.kidMarks - k0 <= 2100, "one more row restyles the children once");
}

// a nested rule with structural pseudo-classes, and a keyed reverse: the zebra follows the position
fn testNested(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, FONT2, "nest.css", 1);
    parse(&css, ".sl { & > .r:nth-of-type(odd) { width: 88px; } .r:last-of-type { height: 33px; } }", "nest2.css", 1);
    ok(css.warns.len == 0 && css.structMode == 1, "nested structural rules parse");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let ord = mem.alloc::<int>(16);
    let uids = mem.alloc::<int>(16);
    for i in 0..16 {
        ord[i] = i;
        uids[i] = -1;
    }
    BIND = true;
    let n = &d.nodes;
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[0]].w, 88.0, "nested :nth-of-type(odd): first row");
    near(n.items[ITEMS[1]].w, 300.0, "second row");
    near(n.items[ITEMS[2]].w, 88.0, "third row");
    near(n.items[ITEMS[3]].h, 33.0, "nested :last-of-type");
    for i in 0..4 {
        ord[i] = 3 - i;
    }
    structSettle(&d, 4, ord, uids, false, "");
    near(n.items[ITEMS[3]].w, 88.0, "keyed reverse: the stripe follows the position (new first)");
    near(n.items[ITEMS[2]].w, 300.0, "new second");
    near(n.items[ITEMS[1]].w, 88.0, "new third");
    near(n.items[ITEMS[0]].w, 300.0, "new last: not odd");
    near(n.items[ITEMS[0]].h, 33.0, "and it is :last-of-type now");
    near(n.items[ITEMS[3]].h, 20.0, "the old last is plain");
}

fn main() {
    let mem0 = Arena.create(16 * 1024 * 1024);
    testScoped(&mem0);
    testReload(&mem0);
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "selector.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    ok(css.sibMode == 2, "the sheet needs the all-following sibling mode");
    testSiblings(&mem, &css);
    testPseudo(&mem, &css);
    testRows(&mem, &css);
    testGhost(&mem, &css);
    testRowsAfter(&mem, &css);
    testStruct(&mem);
    testNested(&mem);
    testMass(&mem);
    printLn(`selector_test ok, checks passed: {CHECKS}`);
}
