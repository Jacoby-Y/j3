// `View.setFont` swaps the font in place: cell metrics match a fresh `View.new`, palette and cursor stay, the arena
// does not grow across 1000 swaps, and a frame drawn after the swap matches one from a fresh View. Run from the repo
// root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_STDLIB=$PWD/j3c/stdlib timeout 60 j3c run j3c/stdlib/tests/term_setfont_test.j3
module term_setfont_test;

use j3.game;
use j3.game.Color;
use j3.io.printLn;
use j3.io.readFile;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.term.ansi;
use j3.term.ansi.Parser;
use j3.term.grid.Grid;
use j3.term.view.View;
use j3.text.{ same, Text };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn shot(v: &View, g: &Grid, path: string, a: &Arena): string {
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    v.draw(g, 0.0, 0.0);
    game.p2Flush();
    ok(game.captureFrame(path), "capture");
    match readFile(path, a) {
        Result.Ok(b) { return b as string; }
        Result.Err(_) { panic("read capture"); }
    }
    return "";
}

fn main() {
    let a = Arena.create(16 * 1024 * 1024);
    game.initGlHidden("setFont", 400, 200);
    // built at run time, so `check` does not look the path up beside this file
    let path = Text.new(&a);
    path.pushStr("examples/terminal/");
    path.pushStr("assets/mono.ttf");
    let small = game.loadFont(path.str(), 12);
    let big = game.loadFont(path.str(), 22);

    let g = Grid.new(&a, 30, 6, 0);
    let p = Parser.new(&a);
    let t = Text.new(&a);
    for ch in "hello @[31mred@[0m world -> != ~~\r\n@[1mbold@[0m @[3mital@[0m" {
        if ch == 64 { t.push(27); } else if ch == 126 { t.pushStr("─"); } else { t.push(ch); }
    }
    ansi.feed(&p, t.str(), &g);

    let fresh = View.new(&a, big);
    let v = View.new(&a, small);
    v.cursorColor = 0x00ff00;
    v.pal[1] = 0x123456;
    v.defaultBg = 0x101010;
    for i in 0..4 {
        v.setFont(if i % 2 == 0 { big } else { small });
        v.draw(&g, 0.0, 0.0);
    }
    let used = a.used;
    for i in 0..1000 {
        v.setFont(if i % 2 == 0 { big } else { small });
        v.draw(&g, 0.0, 0.0);
    }
    game.p2Flush();
    ok(a.used == used, `arena grew across setFont ({used} -> {a.used})`);

    v.setFont(big);
    ok(v.cellW == fresh.cellW && v.cellH == fresh.cellH && v.fontH == fresh.fontH && v.textDy == fresh.textDy, "metrics match View.new");
    ok(v.colsFor(333.0) == fresh.colsFor(333.0) && v.rowsFor(177.0) == fresh.rowsFor(177.0), "colsFor/rowsFor match");
    ok(v.cursorColor == 0x00ff00 && v.pal[1] == 0x123456 && v.defaultBg == 0x101010, "palette and cursor kept");

    fresh.cursorColor = 0x00ff00;
    fresh.pal[1] = 0x123456;
    fresh.defaultBg = 0x101010;
    let pa = shot(&fresh, &g, "/tmp/j3-setfont-a.png", &a);
    let pb = shot(&v, &g, "/tmp/j3-setfont-b.png", &a);
    ok(same(pa, pb), "frame after setFont matches a fresh View");
    printLn("term_setfont_test ok");
}
