// j3.sys localOffsetSec: TZ=UTC is 0, Asia/Kolkata is +5:30, New York follows DST. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/tz_test.j3

module tz_test;

use j3.io.printLn;
use j3.sys;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        sys.panic(msg);
    }
}

fn main() {
    let jan: int = 1767225600000; // 2026-01-01T00:00:00Z
    let jul: int = 1782864000000; // 2026-07-01T00:00:00Z
    ok(sys.setenv("TZ", "UTC"), "setenv UTC");
    ok(sys.localOffsetSec(jan) == 0, "UTC is 0");
    ok(sys.setenv("TZ", "Asia/Kolkata"), "setenv Kolkata");
    ok(sys.localOffsetSec(jan) == 19800, "Kolkata is 19800");
    ok(sys.localOffsetSec(jul) == 19800, "Kolkata has no DST");
    ok(sys.setenv("TZ", "America/New_York"), "setenv New York");
    ok(sys.localOffsetSec(jan) == -18000, "New York winter -18000");
    ok(sys.localOffsetSec(jul) == -14400, "New York summer -14400");
    ok(sys.localOffsetSec(0 - 1500) == -18000, "negative ms rounds down");
    printLn("tz_test ok");
}
