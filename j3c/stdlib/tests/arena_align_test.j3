// Arena allocations are 8-aligned (a Mutex at an odd address aborts in futex under contention).
//   timeout 60 j3c run j3c/stdlib/tests/arena_align_test.j3

module arena_align_test;

use j3.io.printLn;
use j3.sys.panic;
use j3.memory.Arena;
use j3.thread.Mutex;

fn main() {
    let a = Arena.create(64);
    let odd = a.alloc::<u8>(1);
    let m = a.alloc::<Mutex>(1);
    if (m.ptr as int) % 8 != 0 {
        panic("Mutex slot not 8-aligned");
    }
    a.allocBytes(3);
    let p = a.allocBytes(100);
    if (p as int) % 8 != 0 {
        panic("allocBytes not 8-aligned");
    }
    odd[0] = 1;
    printLn("arena_align_test ok");
}
