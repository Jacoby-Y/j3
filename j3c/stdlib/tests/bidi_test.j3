// Tests for the bidi subset in j3.game (UAX #9 weak types W2-W7, neutrals N1/N2, levels I1/I2, reorder L2).
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/bidi_test.j3 --headless
// Expected values are the visual order of the runs, `text@level` joined by `|`, derived by hand from UAX #9 (the
// reasoning is next to each case). Panics on the first failed check.

module bidi_test;

use j3.game.{ Font, textCaretX, textIndexAt, textShaping, textVisualRuns, textWidth, tryLoadFont };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ Text, same };

#[singleton]
let CHECKS: int;

#[singleton]
let OUT: [96]int;

fn bytes(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

/// Visual runs of `s` as `text@level|...`; empty when the text is not reordered.
fn vis(mem: &Arena, f: Font, s: string): string {
    let msg = bytes(s);
    let n = textVisualRuns(f, msg, OUT[0..96]);
    let t = Text.new(mem);
    for k in 0..n {
        if k > 0 { t.pushStr("|"); }
        t.pushStr(msg[OUT[3 * k]..OUT[3 * k + 1]] as string);
        t.pushStr("@");
        t.pushInt(OUT[3 * k + 2]);
    }
    return t.str();
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(mem: &Arena, f: Font, s: string, want: string) {
    CHECKS += 1;
    let got = vis(mem, f, s);
    if !same(got, want) {
        printLn(`FAIL: "{s}"`);
        printLn(`  got  {got}`);
        printLn(`  want {want}`);
        panic("bidi order");
    }
}

/// Caret and hit test across the finer runs of "النتيجة: 12": x falls through the Arabic and ": " (indices 0..16), then the
/// left-to-right "12" run reads left to right (16..18); every boundary maps back to its index.
fn testCaret(f: Font) {
    let m = bytes("النتيجة: 12");
    let w = textWidth(f, m, false);
    let w12 = textWidth(f, bytes("12"), false);
    let prev = w + 1.0;
    let i = 0;
    while i <= 16 {
        let x = textCaretX(f, m, false, i);
        ok(x < prev, "caret x falls through the Arabic word and the colon");
        prev = x;
        i += 1;
        if i < 14 && i % 2 == 1 { i += 1; }
    }
    ok(textCaretX(f, m, false, 0) > w - 1.0, "index 0 is the right edge");
    let x17 = textCaretX(f, m, false, 17);
    ok(x17 > 0.5 && x17 < w12 - 0.5, "caret between 1 and 2 lies inside the digit run");
    ok(textCaretX(f, m, false, 18) > w12 - 1.0 && textCaretX(f, m, false, 18) < w12 + 1.0, "caret at the end is the right edge of 12");
    ok(textIndexAt(f, m, false, x17) == 17, "click between the digits maps to 17");
    ok(textIndexAt(f, m, false, textCaretX(f, m, false, 0)) == 0, "click at the right edge maps to 0");
    ok(textIndexAt(f, m, false, textCaretX(f, m, false, 4)) == 4, "click inside the word maps back");
}

/// More than 256 runs (the old cap) order correctly: the logical end is leftmost, "199" read left to right. A text past
/// the 1024-run cap only warns once on stderr (the tail is one run) and still returns.
fn testManyRuns(mem: &Arena, f: Font) {
    for pass in 0..2 {
        let words = 200 + 100 * pass;
        let t = Text.new(mem);
        for k in 0..words {
            t.pushStr("كلمة ");
            t.pushInt(k);
            t.pushStr(" ");
        }
        let msg = bytes(t.str());
        let n = textVisualRuns(f, msg, OUT[0..96]);
        ok(n == 32, "output is limited by the caller's buffer");
        if words == 200 {
            // leftmost run: the final space (level 1), then "199" (level 2)
            ok(OUT[2] == 1 && OUT[5] == 2 && OUT[4] - OUT[3] == 3, "the last number sits at the left, in reading order");
        }
    }
}

fn main() {
    let f = tryLoadFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24);
    if f.raw == 0 || !textShaping() {
        printLn("bidi: skipped (no DejaVu or no HarfBuzz)");
        return;
    }
    let mem = Arena.create(1024 * 1024);
    // Base direction is the first strong letter. Arabic letters are AL: W2 turns a following EN into AN, W3 turns AL
    // into R. In every case below the Arabic word is level 1 and the reversed order puts the number first.

    // "ar: 12": ':' and ' ' are neutral (W6) between R and AN (counts as R): N1 gives R, level 1. 12 is AN, level 2.
    eq(&mem, f, "النتيجة: 12", "12@2|: @1|النتيجة@1");
    // "10:30": W2 makes both numbers AN; W4: a single CS between two ANs is AN. One level-2 run, read left to right.
    eq(&mem, f, "الساعة 10:30", "10:30@2| @1|الساعة@1");
    // "3,5" and "1.000,50": same W4 chain.
    eq(&mem, f, "السعر 3,5", "3,5@2| @1|السعر@1");
    eq(&mem, f, "السعر 1.000,50", "1.000,50@2| @1|السعر@1");
    // "1/2": '/' is CS.
    eq(&mem, f, "النسبة 1/2", "1/2@2| @1|النسبة@1");
    // "50%" after Arabic letters: 50 is AN (W2), so '%' (ET) is not next to an EN (W5 does not apply): it is neutral,
    // N1 gives R. In an RTL line the percent sign is left of the number.
    eq(&mem, f, "نسبة 50%", "%@1|50@2| @1|نسبة@1");
    // After a Hebrew letter no AL is involved: 50 stays EN, W5 pulls '%' into the number: one level-2 run "50%".
    eq(&mem, f, "אחוז 50%", "50%@2| @1|אחוז@1");
    // "-5": '-' is ES, not between two ENs: W6 neutral, N1 R. The minus ends up right of the 5 (RTL reading order).
    eq(&mem, f, "הפרש -5", "5@2| -@1|הפרש@1");
    // "$20": Hebrew: W5 makes '$' part of the EN run. Arabic: 20 is AN, '$' is neutral and stays with the word.
    eq(&mem, f, "מחיר $20", "$20@2| @1|מחיר@1");
    eq(&mem, f, "السعر $20", "20@2| $@1|السعر@1");
    // Arabic-Indic digits are AN; ':' between two ANs is AN (W4). The three level-2 runs (digits and ':' are
    // separate script runs) are reversed twice by L2, so 10:30 reads left to right.
    eq(&mem, f, "الساعة ١٠:٣٠", "١٠@2|:@2|٣٠@2| @1|الساعة@1");
    // Extended Arabic-Indic digits U+06F0.. are EN: after AL, W2 turns them into AN as well.
    eq(&mem, f, "الساعة ۱۰:۳۰", "۱۰@2|:@2|۳۰@2| @1|الساعة@1");
    // Hebrew, number, final '.': '.' has no number after it (W6 neutral), N1 takes it to R: it is the leftmost run.
    eq(&mem, f, "יש 12.", ".@1|12@2| @1|יש@1");
    // Left-to-right paragraph (first strong is L): the neutral space before the Arabic phrase sits between L and R, so
    // N2 gives the base level 0; the space between the phrase and the AN is R; the one before "ok" is base again.
    eq(&mem, f, "Say النتيجة 12 ok", "Say @0|12@2| @1|النتيجة@1| ok@0");
    // Arabic-Indic then ASCII digits: both AN after AL (W2). Digits and the ',' are separate script runs, all level 2,
    // reversed twice so they read left to right.
    eq(&mem, f, "الرقم ١٢3", "١٢@2|3@2| @1|الرقم@1");
    eq(&mem, f, "الرقم ١٢٣,٤٥٦", "١٢٣@2|,@2|٤٥٦@2| @1|الرقم@1");
    // Hebrew has no AL: the ASCII digit stays EN, still level 2 beside the AN digits.
    eq(&mem, f, "מספר ١٢3", "١٢@2|3@2| @1|מספר@1");
    // W1: harakat after a letter keep the word in one run (no split, no reorder).
    eq(&mem, f, "كَتَبَ", "كَتَبَ@1");
    eq(&mem, f, "الساعة 12:30", "12:30@2| @1|الساعة@1");
    // A lone ',' or '.' beside Latin text does not split the left-to-right run (kerning and widths stay as one run).
    eq(&mem, f, "x 3,5.a ن", "x 3,5.a @0|ن@1");
    // No right-to-left run: drawn in logical order, nothing to report.
    eq(&mem, f, "abc 12, 3:4 5%", "");
    testCaret(f);
    testManyRuns(&mem, f);
    printLn(`bidi_test: {CHECKS} checks passed`);
}
