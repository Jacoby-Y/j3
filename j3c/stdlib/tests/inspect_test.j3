// Tests for the UI inspector (j3.ui.inspect): off by default and no work while off, on/off by `setInspector` and F12 (only with the hotkey allowed),
// the hover target is `hitNode`'s, a click pins without reaching the app, arrow keys walk parent / child / siblings and Escape unpins, the app gets
// its clicks again when it is off, and `inspect.text` lists the box, non-default computed values, matched rules with file:line (overridden
// declarations marked) and custom properties; the text is built once per pin / style change. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/inspect_test.j3
// Panics on the first failed check.

module inspect_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same };
use j3.ui.css.{ Css, FL_ACTIVE, hasBit };
use j3.ui.cssparse.{ parse, parseAt };
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.inspect;
use j3.ui.testkit;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); }\ndiv, button, p { font-family: \"T\"; font-size: 16px; display: block; } p { transform-origin: 1em 25%; }\nbutton { color: #ff0000; width: 100px; --accent: 3px; }\n.big { color: #0000ff; padding-top: 4px; }\n";

#[singleton]
let CLICKS: int;
#[singleton]
let IDS: [4]int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    IDS[0] = d.open(0, d.tag("div"), 1);
    d.attrId(IDS[0], "root");
    IDS[1] = d.open(1, d.tag("button"), 1);
    d.cls(IDS[1], "big");
    if d.clicked(IDS[1]) { CLICKS += 1; }
    d.text("Go");
    d.close();
    IDS[2] = d.open(2, d.tag("p"), 1);
    d.styleStr(IDS[2], 0, "width", "50%");
    d.styleStr(IDS[2], 1, "background-image", "linear-gradient(90deg, #ff0000, #0000ff)");
    d.styleStr(IDS[2], 2, "box-shadow", "1px 2px 3px 4px #00000080");
    d.styleStr(IDS[2], 3, "transform", "translate(0.5em, 6px) rotate(10deg)");
    d.styleStr(IDS[2], 4, "transition", "color 200ms ease-in");
    d.styleStr(IDS[2], 5, "grid-template-columns", "100px minmax(10px, 1fr) 20%");
    d.styleStr(IDS[2], 6, "animation-duration", "300ms");
    d.styleStr(IDS[2], 7, "background-size", "cover");
    d.styleStr(IDS[2], 8, "color", "var(--accent)");
    d.text("Note");
    d.close();
    d.close();
    d.layout();
    if !d.insp { inputs.overlay(d); } // the inspector paints through GL
    d.endFrame();
}

fn click(d: &Dom, id: int) {
    for f in 0..4 {
        testkit.click(d, f, 0, id);
        frame(d);
    }
}

fn key(d: &Dom, names: string) {
    d.simKeys("", names);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(d);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "ui/i.css", 1);
    ok(css.warns.len == 0, "sheet parses");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d);
    frame(&d);
    ok(!d.insp && d.inspBuilds == 0, "off by default, nothing built");
    click(&d, IDS[1]);
    ok(CLICKS == 1, "the app gets clicks while the inspector is off");

    key(&d, "F12");
    ok(!d.insp, "F12 does nothing without J3_INSPECT");
    d.inspHot = true;
    key(&d, "F12");
    ok(d.insp, "F12 turns it on");
    key(&d, "F12");
    ok(!d.insp, "F12 turns it off");
    d.setInspector(true);

    testkit.click(&d, 0, 0, IDS[1]);
    frame(&d);
    ok(d.rawHit == IDS[1], "hover target is the hit element");
    for f in 1..4 {
        testkit.click(&d, f, 0, IDS[1]);
        frame(&d);
    }
    ok(d.inspPin == IDS[1], "a click pins the element");
    ok(CLICKS == 1, "the click did not reach the app");
    ok(d.inspBuilds == 0, "no text built before the panel needs it");
    inspect.panelText(&d);
    inspect.panelText(&d);
    ok(d.inspBuilds == 1, "panel text is built once for a pin");
    frame(&d);
    inspect.panelText(&d);
    ok(d.inspBuilds == 1, "and not again while nothing changes");

    key(&d, "Up");
    ok(d.inspPin == IDS[0], "Up walks to the parent");
    key(&d, "Down");
    ok(d.inspPin == IDS[1], "Down walks to the first child");
    key(&d, "Right");
    ok(d.inspPin == IDS[2], "Right walks to the next sibling");
    key(&d, "Left");
    ok(d.inspPin == IDS[1], "Left walks to the previous sibling");
    key(&d, "Escape");
    ok(d.inspPin == -1, "Escape unpins");

    ok(d.inspBuilds == 1, "walking built nothing");
    let ps = inspect.text(&d, IDS[2]);
    ok(!contains(ps, "<kind"), "no value prints as <kind N>");
    ok(contains(ps, "style:  inline"), "inline style: listed as the first pseudo-rule");
    ok(contains(ps, "  width: 50.0%"), "percentage");
    ok(contains(ps, "linear-gradient(90.0deg, #ff0000ff 0.0%, #0000ffff 100.0%)"), "gradient summary");
    ok(contains(ps, "box-shadow: 1.0px 2.0px 3.0px 4.0px #00000080"), "shadow");
    ok(contains(ps, "transform: translate(8.0px, 6.0px) rotate(10.0deg)"), "an em transform prints as px");
    ok(contains(ps, "transform-origin: 16.0px 25.0%"), "an em origin prints as px, a percentage as %");
    ok(contains(ps, "color 200.0ms ease-in"), "transition");
    ok(contains(ps, "100.0px minmax(10.0px, 1.0fr) 20.0%"), "grid tracks");
    ok(contains(ps, "animation-duration: 300.0ms"), "time");
    ok(contains(ps, "background-size: cover"), "background-size");
    ok(contains(ps, "color: var(--accent)"), "var() source");
    ok(contains(ps, "display: block  (overridden)") == false, "a rule declaration only inline style replaces is marked");
    let s = inspect.text(&d, IDS[1]);
    ok(contains(s, "button.big"), "header names tag and class");
    ok(contains(s, "ui/i.css:3"), "the tag rule's file:line");
    ok(contains(s, "ui/i.css:4"), "the class rule's file:line");
    ok(contains(s, "color: #ff0000ff  (overridden)"), "the beaten color declaration is marked");
    ok(contains(s, "color: #0000ffff\n"), "the winning color is not marked");
    ok(contains(s, "width: 100.0px"), "computed width");
    ok(contains(s, "--accent: 3.0px"), "custom property in scope");
    ok(contains(s, "padding: 4.0 0.0 0.0 0.0") || contains(s, "padding: 4"), "box padding");
    ok(same(inspect.text(&d, 9999), "(no element)\n"), "bad id");
    ok(inspect.find(&d, ".big") == IDS[1] && inspect.find(&d, "#root") == IDS[0] && inspect.find(&d, "p") == IDS[2], "selectors find elements");

    // growth: re-pinning 100 times builds the text 100 times in the same scratch arena
    inspect.panelText(&d);
    let used = mem.used;
    for i in 0..100 {
        d.inspPin = IDS[1 + i % 2];
        inspect.panelText(&d);
    }
    ok(d.inspBuilds >= 100, "every re-pin rebuilt the text");
    ok(mem.used == used, "re-pinning allocates nothing from the Dom arena");

    // the app's hover does not follow the pointer while the inspector is on
    d.setInspector(false);
    d.simInput(d.absX(IDS[1]) + 3.0, d.absY(IDS[1]) + 3.0, false, 0.0);
    frame(&d);
    frame(&d);
    let hv = d.hover;
    ok(hv >= 0, "the button is hovered while the inspector is off");
    d.setInspector(true);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d);
    frame(&d);
    ok(d.hover == hv, "app hover frozen while inspecting");
    d.simInput(d.absX(IDS[0]) + 3.0, d.absY(IDS[0]) + 3.0, false, 0.0);
    frame(&d);
    ok(d.rawHit >= 0 && d.hover == hv, "the inspector still sees its own hover target");

    // a style block that starts below the top of its file: lines are the file's
    let css2 = Css.new(&mem);
    parseAt(&css2, "\n.x { color: red; }\n.y { bogus: 1; }", "ui/s.j3ui", 1, 10);
    ok(css2.rules.items[0].line == 12 && css2.rules.items[0].file.len > 0, "rule line is offset by line0");
    ok(css2.warns.len == 1 && css2.warns.items[0].line == 13, "warning line is offset by line0, once");

    // a button held while the inspector comes on: released under it, nothing stays active and no click is delivered
    d.setInspector(false);
    let bx = d.absX(IDS[1]) + 3.0;
    let by = d.absY(IDS[1]) + 3.0;
    d.simInput(bx, by, false, 0.0);
    frame(&d);
    d.simInput(bx, by, true, 0.0);
    frame(&d);
    ok(hasBit(d.mnodes.items[IDS[1]].flags, FL_ACTIVE), "pressed button is active");
    d.setInspector(true);
    d.simInput(bx, by, false, 0.0);
    frame(&d);
    d.setInspector(false);
    d.simInput(bx, by, false, 0.0);
    frame(&d);
    frame(&d);
    ok(!hasBit(d.mnodes.items[IDS[1]].flags, FL_ACTIVE) && d.pressNode < 0, "no stuck :active after the switch");
    ok(CLICKS == 1, "no click delivered for a press the inspector took over");
    // held across the switch off: no phantom press when it goes off while the button is down
    d.setInspector(true);
    d.simInput(bx, by, true, 0.0);
    frame(&d);
    d.setInspector(false);
    d.simInput(bx, by, true, 0.0);
    frame(&d);
    d.simInput(bx, by, false, 0.0);
    frame(&d);
    ok(CLICKS == 1, "no phantom click when the button is held while it turns off");

    d.setInspector(false);
    click(&d, IDS[1]);
    ok(CLICKS == 2, "clicks reach the app again once it is off");
    printLn("inspect_test ok");
}
