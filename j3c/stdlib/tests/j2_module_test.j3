// Tests for j2 modules: `pub` names living in the exports table (another script sees a write),
// `use` through `vm.resolver` (a script used twice gets the same exports, a reload is a fresh
// module), `use` cycles, unknown names and `const` at load time, hoisting.
//   timeout 60 j3c run j3c/stdlib/tests/j2_module_test.j3
// Panics on the first failed check.

module j2_module_test;

use j3.io.printLn;
use j3.j2;
use j3.j2.{ Vm, Args, Value, Limits, Ref };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

const NSRC: int = 6;

/// The "files" a `use` may name, and the exports of the ones loaded (kept).
struct Lib {
    loaded: [6]Ref;
    out: Text;
}

const NAMES: [6]string = ["a", "b", "e", "c", "d", "self"];
const SRCS: [6]string = [
    "pub let wave = 1;\npub const MAX = 3;\npub fn next() { wave += 1; return wave; }\npub fn twice(x) { return x * 2; }\npub fn six() { return (3).twice(); }",
    "use a;\npub fn get() { return a.wave; }\npub fn mod() { return a; }",
    "use a;\npub fn mod() { return a; }",
    "use d;\npub let x = 1;",
    "use c;\npub let y = 2;",
    "use self;",
];

fn libOf(vm: &Vm): &Lib { return vm.host as &Lib; }

fn capture(vm: &Vm, args: Args): Value {
    let l = libOf(vm);
    l.out.pushStr(args.joined(" "));
    l.out.push(10);
    return j2.nil();
}

/// Loads a script by name the first time it is used and hands back the same exports after.
fn resolve(_ctx: ptr, vm: &Vm, name: string): Value {
    let l = libOf(vm);
    for i in 0..NSRC {
        if NAMES[i] == name {
            let have = vm.value(l.loaded[i]);
            if !have.isNil() { return have; }
            match vm.loadString(name, SRCS[i]) {
                Result.Ok(t) {
                    l.loaded[i] = vm.keep(t);
                    return t;
                }
                Result.Err(e) { return vm.raise(e.message); }
            }
        }
    }
    return vm.raise("no such script");
}

fn check(got: string, want: string, what: string) {
    if !(got == want) {
        printLn(`got  [{got}]`);
        printLn(`want [{want}]`);
        panic(what);
    }
}

fn call0(vm: &Vm, t: Value, name: string): Value {
    match vm.call(t.asTable().get(name), @slice(0 as ptr, 0)) {
        Result.Ok(v) { return v; }
        Result.Err(e) {
            printLn(e.message);
            panic("call");
        }
    }
}

fn loadOk(vm: &Vm, name: string, src: string): Value {
    match vm.loadString(name, src) {
        Result.Ok(t) {
            vm.keep(t); // the host holds exports across calls (the GC may run in any call)
            return t;
        }
        Result.Err(e) {
            printLn(e.message);
            panic("unexpected load error");
        }
    }
}

fn loadErr(vm: &Vm, name: string, src: string): string {
    match vm.loadString(name, src) {
        Result.Ok(_) { panic("expected a load error"); }
        Result.Err(e) { return e.message; }
    }
}

fn main() {
    let mem = Arena.create(1 << 20);
    let l = Lib { loaded: [j2.none(), j2.none(), j2.none(), j2.none(), j2.none(), j2.none()],
        out: Text.new(&mem) };
    let vm = Vm.new(&mem, Limits { });
    vm.openLibs(j2.LIB_ALL);
    vm.bind("print", capture);
    vm.host = &l as ptr;
    vm.resolver = resolve;

    // B uses A and sees A's `pub let` change, whoever writes it
    let b = loadOk(&vm, "b", "use a;\npub fn get() { return a.wave; }");
    let a = vm.value(l.loaded[0]);
    if call0(&vm, b, "get").bits != 1 { panic("first read"); }
    if call0(&vm, a, "next").bits != 2 { panic("next"); }
    if call0(&vm, b, "get").bits != 2 { panic("B sees A's write"); }
    a.asTable().set("wave", j2.int(10));
    if call0(&vm, a, "next").bits != 11 { panic("A sees the host's write to its exports"); }
    if a.asTable().getNum("MAX", 0.0) != 3.0 || call0(&vm, a, "six").bits != 6 { panic("pub const, pub fn fallback"); }

    // a script used twice gets the same exports; a reload is a fresh module
    let e = loadOk(&vm, "e", "use a;\npub fn mod() { return a; }");
    let b2 = loadOk(&vm, "b2", "use a;\npub fn mod() { return a; }");
    if !j2.same(call0(&vm, e, "mod"), call0(&vm, b2, "mod")) || !j2.same(call0(&vm, e, "mod"), a) { panic("use reuses exports"); }
    let fresh = loadOk(&vm, "a", SRCS[0]);
    if j2.same(fresh, a) || fresh.asTable().getNum("wave", 0.0) != 1.0 { panic("reload is fresh"); }
    if call0(&vm, b, "get").bits != 11 { panic("old users keep the old module"); }

    // cycles
    check(loadErr(&vm, "c", SRCS[3]), "c:1:1: d:1:1: use cycle: c -> d -> c", "cycle");
    check(loadErr(&vm, "self", "use self;"), "self:1:1: use cycle: self -> self", "self cycle");
    check(loadErr(&vm, "x", "let k = 1;\nuse nothing;"), "x:2:1: no such script", "resolver raise");

    // names are checked at load
    check(loadErr(&vm, "t", "let x = 1;\nfn f() {\n    spwan(x);\n}"), "t:3:5: unknown name \"spwan\"", "typo");
    check(loadErr(&vm, "t", "pub const K = 1;\nfn f() { K = 2; }"), "t:2:10: can't assign to const \"K\"", "pub const");
    check(loadErr(&vm, "t", "print = 1;"), "t:1:1: can't assign to the host's \"print\"", "host name");
    check(loadErr(&vm, "t", "fn f() { use a; }"), "t:1:10: `use` is only allowed at the top level", "nested use");

    // hoisting across pub and private names, and the exports holding only pub ones
    let h = loadOk(&vm, "h", "let n = 1;\nprint(later(2));\npub fn later(x) { return helper(x) + n; }\nfn helper(x) { return x * 10; }\npub let shown = 5;");
    check(l.out.str(), "21\n", "hoisting");
    if h.asTable().count() != 2 || !h.asTable().get("helper").isNil() { panic("exports hold only pub names"); }

    // a Vm without a resolver says so
    let mem2 = Arena.create(1 << 16);
    let bare = Vm.new(&mem2, Limits { });
    match bare.loadString("u", "use a;") {
        Result.Ok(_) { panic("use with no resolver"); }
        Result.Err(err) {
            check(err.message, "u:1:1: use a: this host loads no other scripts (vm.resolver is not set)", "no resolver");
        }
    }
    bare.destroy();

    // loadFile reads through j3.io; a missing file names its path
    match vm.loadFile("gone", "/nonexistent/j2/main.j2") {
        Result.Ok(_) { panic("missing file"); }
        Result.Err(err) {
            check(err.message, "can't read /nonexistent/j2/main.j2", "missing file");
            check(err.chunk, "gone", "missing file chunk");
        }
    }
    vm.destroy();
    printLn("j2_module_test ok");
}
