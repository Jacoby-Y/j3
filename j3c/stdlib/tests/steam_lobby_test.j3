// Tests for j3.steam lobbies (ISteamMatchmaking): absent no-ops, fake matchmaking (create, search filters, join,
// capacity, owner migration, data, member data, chat, game server), callbacks decoded from hand-written buffers
// under the host pack rule, and every lobby struct layout for both pack rules.
// Run from j3c/:  timeout 120 target/release/j3c run stdlib/tests/steam_lobby_test.j3
// Panics on the first failed check.

module steam_lobby_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.steam;
use j3.sys.panic;

#[singleton]
let C_LOBBY: u64;
#[singleton]
let C_OK: int;
#[singleton]
let C_N: int;
#[singleton]
let C_CTX: u64;
#[singleton]
let L_COUNT: int;
#[singleton]
let L_OK: int;
#[singleton]
let J_RESP: int;
#[singleton]
let J_LOCKED: bool;
#[singleton]
let J_N: int;
#[singleton]
let D_N: int;
#[singleton]
let D_LOBBY: u64;
#[singleton]
let D_MEMBER: u64;
#[singleton]
let D_OK: bool;
#[singleton]
let M_N: int;
#[singleton]
let M_USER: u64;
#[singleton]
let M_BY: u64;
#[singleton]
let M_CHANGE: u32;
#[singleton]
let T_N: int;
#[singleton]
let T_USER: u64;
#[singleton]
let T_ID: int;
#[singleton]
let S_N: int;
#[singleton]
let S_IP: u32;
#[singleton]
let S_PORT: int;
#[singleton]
let S_ID: u64;
#[singleton]
let I_FROM: u64;
#[singleton]
let I_LOBBY: u64;
#[singleton]
let K_LOBBY: u64;
#[singleton]
let K_DISC: bool;
#[singleton]
let R_LOBBY: u64;
#[singleton]
let R_FRIEND: u64;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onCreated(lobby: u64, good: bool, ctx: u64) {
    C_LOBBY = lobby;
    C_CTX = ctx;
    C_N += 1;
    if good {
        C_OK = 1;
    } else {
        C_OK = 2;
    }
}

fn onList(count: int, good: bool, ctx: u64) {
    L_COUNT = count;
    if good {
        L_OK = 1;
    } else {
        L_OK = 2;
    }
}

fn onJoined(lobby: u64, resp: int, locked: bool, ctx: u64) {
    J_RESP = resp;
    J_LOCKED = locked;
    J_N += 1;
}

fn onData(lobby: u64, member: u64, good: bool) {
    D_N += 1;
    D_LOBBY = lobby;
    D_MEMBER = member;
    D_OK = good;
}

fn onMembers(lobby: u64, user: u64, by: u64, change: u32) {
    M_N += 1;
    M_USER = user;
    M_BY = by;
    M_CHANGE = change;
}

fn onMsg(lobby: u64, user: u64, id: int) {
    T_N += 1;
    T_USER = user;
    T_ID = id;
}

fn onServer(lobby: u64, ip: u32, port: int, server: u64) {
    S_N += 1;
    S_IP = ip;
    S_PORT = port;
    S_ID = server;
}

fn onInvite(from: u64, lobby: u64) {
    I_FROM = from;
    I_LOBBY = lobby;
}

fn onKicked(lobby: u64, admin: u64, disc: bool) {
    K_LOBBY = lobby;
    K_DISC = disc;
}

fn onJoinReq(lobby: u64, friend: u64) {
    R_LOBBY = lobby;
    R_FRIEND = friend;
}

fn handlers() {
    steam.onLobbyData(onData);
    steam.onLobbyMembers(onMembers);
    steam.onLobbyMsg(onMsg);
    steam.onLobbyServer(onServer);
    steam.onLobbyInvite(onInvite);
    steam.onLobbyKicked(onKicked);
    steam.onLobbyJoinRequest(onJoinReq);
}

fn absent() {
    ok(!steam.on(), "starts absent");
    steam.createLobby(steam.LOBBY_PUBLIC, 4, onCreated, u64(7));
    steam.findLobbies(onList, u64(0));
    steam.joinLobby(u64(5), onJoined, u64(0));
    steam.frame();
    ok(C_N == 1 && C_OK == 2 && C_LOBBY == u64(0) && C_CTX == u64(7), "absent create fails on the next frame with ctx");
    ok(L_OK == 2 && L_COUNT == 0, "absent find fails");
    ok(J_N == 1 && J_RESP == steam.ENTER_ERROR && !J_LOCKED, "absent join gives ENTER_ERROR");
    ok(steam.lobbyAt(0) == u64(0) && steam.memberCount(u64(5)) == 0 && steam.memberAt(u64(5), 0) == u64(0), "absent reads");
    ok(steam.lobbyData(u64(5), "k") == "" && !steam.setLobbyData(u64(5), "k", "v") && steam.lobbyDataCount(u64(5)) == 0, "absent data");
    ok(steam.lobbyOwner(u64(5)) == u64(0) && !steam.setLobbyOwner(u64(5), u64(6)) && !steam.setJoinable(u64(5), true), "absent owner");
    ok(!steam.sendLobbyMsg(u64(5), "hi" as []u8), "absent send");
    ok(!steam.lobbyServer(u64(5)).ok && !steam.inviteToLobby(u64(5), u64(6)), "absent server and invite");
    ok(steam.connectLobbyArg() == u64(0), "no connect arg");
    steam.leaveLobby(u64(5));
    steam.overlayInvite(u64(5));
    steam.filterString("a", "b", steam.CMP_EQUAL);
    steam.filterNumber("a", 1, steam.CMP_EQUAL);
    steam.filterNear("a", 1);
    steam.filterSlots(1);
    steam.filterDistance(steam.DISTANCE_FAR);
    steam.filterCount(3);
    steam.filterCompatible(u64(5));
}

fn layouts() {
    for v in 0..2 {
        let big = v == 1;
        ok(steam.layAt("LobbyCreated_t", "eResult", big) == 0 && steam.layAt("LobbyCreated_t", "ulSteamIDLobby", big) == [4, 8][v], "513 offsets");
        ok(steam.layAt("LobbyCreated_t", steam.SIZE, big) == [12, 16][v], "513 size");
        ok(steam.layAt("LobbyMatchList_t", "nLobbiesMatching", big) == 0 && steam.layAt("LobbyMatchList_t", steam.SIZE, big) == 4, "510");
        let e = "LobbyEnter_t";
        ok(steam.layAt(e, "ulSteamIDLobby", big) == 0 && steam.layAt(e, "rgfChatPermissions", big) == 8, "504 offsets");
        ok(steam.layAt(e, "bLocked", big) == 12 && steam.layAt(e, "EChatRoomEnterResponse", big) == 16, "504 offsets 2");
        ok(steam.layAt(e, steam.SIZE, big) == [20, 24][v], "504 size");
        let d = "LobbyDataUpdate_t";
        ok(steam.layAt(d, "ulSteamIDMember", big) == 8 && steam.layAt(d, "bSuccess", big) == 16, "505 offsets");
        ok(steam.layAt(d, steam.SIZE, big) == [20, 24][v], "505 size");
        let c = "LobbyChatUpdate_t";
        ok(steam.layAt(c, "ulSteamIDUserChanged", big) == 8 && steam.layAt(c, "ulSteamIDMakingChange", big) == 16, "506 offsets");
        ok(steam.layAt(c, "rgfChatMemberStateChange", big) == 24 && steam.layAt(c, steam.SIZE, big) == [28, 32][v], "506 change and size");
        let m = "LobbyChatMsg_t";
        ok(steam.layAt(m, "ulSteamIDUser", big) == 8 && steam.layAt(m, "eChatEntryType", big) == 16, "507 offsets");
        ok(steam.layAt(m, "iChatID", big) == 20 && steam.layAt(m, steam.SIZE, big) == 24, "507 id and size");
        let g = "LobbyGameCreated_t";
        ok(steam.layAt(g, "ulSteamIDGameServer", big) == 8 && steam.layAt(g, "unIP", big) == 16, "509 offsets");
        ok(steam.layAt(g, "usPort", big) == 20 && steam.layAt(g, steam.SIZE, big) == 24, "509 port and size");
        let i = "LobbyInvite_t";
        ok(steam.layAt(i, "ulSteamIDLobby", big) == 8 && steam.layAt(i, "ulGameID", big) == 16 && steam.layAt(i, steam.SIZE, big) == 24, "503");
        let k = "LobbyKicked_t";
        ok(steam.layAt(k, "ulSteamIDAdmin", big) == 8 && steam.layAt(k, "bKickedDueToDisconnect", big) == 16, "512 offsets");
        ok(steam.layAt(k, steam.SIZE, big) == [20, 24][v], "512 size");
        let j = "GameLobbyJoinRequested_t";
        ok(steam.layAt(j, "steamIDFriend", big) == 8 && steam.layAt(j, steam.SIZE, big) == 16, "333");
    }
}

/// Callbacks decoded from buffers written with literal offsets (the host's pack rule).
fn decode() {
    let mem = Arena.create(1024);
    let b = mem.alloc::<u8>(64);
    let p = b.ptr as ptr;
    let big = steam.packLarge();
    let v = 0;
    if big {
        v = 1;
    }
    // 505: lobby 0, member 8, ok 16
    steam.wrU64(p, 0, u64(11));
    steam.wrU64(p, 8, u64(22));
    steam.wrU8(p, 16, u8(1));
    let s505: []u8 = @slice(p, [20, 24][v]);
    steam.fakeCallback(505, s505);
    // 506: lobby 0, user 8, by 16, change 24
    steam.wrU64(p, 0, u64(12));
    steam.wrU64(p, 8, u64(23));
    steam.wrU64(p, 16, u64(24));
    steam.wrU32(p, 24, u32(8));
    let s506: []u8 = @slice(p, [28, 32][v]);
    steam.fakeCallback(506, s506);
    // 507: lobby 0, user 8, type 16, id 20
    steam.wrU64(p, 0, u64(13));
    steam.wrU64(p, 8, u64(25));
    steam.wrU8(p, 16, u8(1));
    steam.wrI32(p, 20, i32(9));
    let s507: []u8 = @slice(p, 24);
    steam.fakeCallback(507, s507);
    // 509: lobby 0, server 8, ip 16, port 20 (little endian)
    steam.wrU64(p, 0, u64(14));
    steam.wrU64(p, 8, u64(26));
    steam.wrU32(p, 16, u32(16909060));
    steam.wrU8(p, 20, u8(0x39));
    steam.wrU8(p, 21, u8(0x30));
    let s509: []u8 = @slice(p, 24);
    steam.fakeCallback(509, s509);
    // 503: user 0, lobby 8, game 16
    steam.wrU64(p, 0, u64(27));
    steam.wrU64(p, 8, u64(15));
    steam.wrU64(p, 16, u64(480));
    steam.fakeCallback(503, @slice(p, 24));
    // 512: lobby 0, admin 8, disc 16
    steam.wrU64(p, 0, u64(16));
    steam.wrU64(p, 8, u64(28));
    steam.wrU8(p, 16, u8(1));
    steam.fakeCallback(512, @slice(p, [20, 24][v]));
    // 333: lobby 0, friend 8
    steam.wrU64(p, 0, u64(17));
    steam.wrU64(p, 8, u64(29));
    steam.fakeCallback(333, @slice(p, 16));
    steam.frame();
    ok(D_N == 1 && D_LOBBY == u64(11) && D_MEMBER == u64(22) && D_OK, "505 decoded");
    ok(M_N == 1 && M_USER == u64(23) && M_BY == u64(24) && M_CHANGE == steam.LOBBY_KICKED, "506 decoded");
    ok(T_N == 1 && T_USER == u64(25) && T_ID == 9, "507 decoded");
    ok(S_N == 1 && S_IP == u32(16909060) && S_PORT == 12345 && S_ID == u64(26), "509 decoded");
    ok(I_FROM == u64(27) && I_LOBBY == u64(15), "503 decoded");
    ok(K_LOBBY == u64(16) && K_DISC, "512 decoded");
    ok(R_LOBBY == u64(17) && R_FRIEND == u64(29), "333 decoded");
    D_N = 0;
    M_N = 0;
    T_N = 0;
    S_N = 0;
}

fn results() {
    let mem = Arena.create(256);
    let b = mem.alloc::<u8>(32);
    let p = b.ptr as ptr;
    for v in 0..2 {
        let big = v == 1;
        for i in 0..4 {
            steam.wrU64(p, i * 8, u64(0));
        }
        // 513: eResult 0, lobby at 4 (pack4) or 8 (pack8)
        steam.wrI32(p, 0, i32(1));
        steam.wrU64(p, [4, 8][v], u64(777));
        C_N = 0;
        C_LOBBY = u64(0);
        steam.fakeLobbyResult(0, @slice(p, [12, 16][v]), big, onCreated as ptr, u64(5));
        ok(C_N == 1 && C_OK == 1 && C_LOBBY == u64(777) && C_CTX == u64(5), "513 decoded");
        steam.wrI32(p, 0, i32(2));
        steam.fakeLobbyResult(0, @slice(p, [12, 16][v]), big, onCreated as ptr, u64(5));
        ok(C_N == 2 && C_OK == 2 && C_LOBBY == u64(0), "513 failure result");
        // 510: count at 0
        steam.wrU32(p, 0, u32(6));
        steam.fakeLobbyResult(1, @slice(p, 4), big, onList as ptr, u64(0));
        ok(L_OK == 1 && L_COUNT == 6, "510 decoded");
        // 504: lobby 0, locked 12, response 16
        for i in 0..4 {
            steam.wrU64(p, i * 8, u64(0));
        }
        steam.wrU64(p, 0, u64(888));
        steam.wrU8(p, 12, u8(1));
        steam.wrU32(p, 16, u32(4));
        J_N = 0;
        steam.fakeLobbyResult(2, @slice(p, [20, 24][v]), big, onJoined as ptr, u64(0));
        ok(J_N == 1 && J_RESP == steam.ENTER_FULL && J_LOCKED, "504 decoded");
    }
}

fn make(kind: int, max: int): u64 {
    let before = C_N;
    steam.createLobby(kind, max, onCreated, u64(41));
    ok(C_N == before, "create answers on a later frame");
    steam.frame();
    ok(C_N == before + 1 && C_CTX == u64(41), "create handler ran with ctx");
    return C_LOBBY;
}

fn find(): int {
    steam.findLobbies(onList, u64(0));
    steam.frame();
    ok(L_OK == 1, "find ok");
    return L_COUNT;
}

fn join(lobby: u64): int {
    steam.joinLobby(lobby, onJoined, u64(0));
    steam.frame();
    return J_RESP;
}

fn fakeCreateAndMembers() {
    let me = steam.userId();
    ok(make(steam.LOBBY_PUBLIC, 0) == u64(0) && C_OK == 2, "zero members refused");
    ok(make(steam.LOBBY_PUBLIC, 251) == u64(0) && C_OK == 2, "over 250 members refused");
    ok(make(9, 4) == u64(0) && C_OK == 2, "bad type refused");
    let a = make(steam.LOBBY_PUBLIC, 3);
    ok(a != u64(0) && C_OK == 1, "create ok");
    let b = make(steam.LOBBY_PUBLIC, 4);
    ok(b != a, "ids differ");
    ok(steam.lobbyOwner(a) == me && steam.memberCount(a) == 1 && steam.memberAt(a, 0) == me, "creator owns and is member 0");
    ok(steam.memberAt(a, 1) == u64(0) && steam.memberAt(a, 0 - 1) == u64(0), "memberAt out of range");
    ok(steam.memberLimit(a) == 3, "limit");
    // capacity
    ok(steam.fakeLobbyJoin(a, u64(101)) && M_N == 0, "join returns before the frame");
    steam.frame();
    ok(M_N == 1 && M_USER == u64(101) && M_BY == u64(101) && M_CHANGE == steam.LOBBY_ENTERED, "506 entered on fake join");
    ok(steam.fakeLobbyJoin(a, u64(102)), "second join");
    ok(!steam.fakeLobbyJoin(a, u64(103)), "full lobby refuses");
    ok(steam.memberCount(a) == 3 && steam.memberAt(a, 1) == u64(101) && steam.memberAt(a, 2) == u64(102), "member order is join order");
    ok(join(a) == steam.ENTER_SUCCESS, "owner already inside succeeds");
    ok(steam.setMemberLimit(a, 4) && steam.memberLimit(a) == 4 && steam.fakeLobbyJoin(a, u64(103)), "raise limit");
    ok(!steam.setMemberLimit(a, 2), "limit below members refused");
    ok(!steam.fakeLobbyLeave(a, u64(999)), "leave by a stranger");
    // join responses
    ok(join(u64(12345)) == steam.ENTER_DOESNT_EXIST, "missing lobby");
    let c = make(steam.LOBBY_PUBLIC, 1);
    ok(join(c) == steam.ENTER_SUCCESS, "own lobby");
    ok(steam.fakeLobbyJoin(b, u64(201)) && steam.memberCount(b) == 2, "other lobby join");
    steam.leaveLobby(c);
    ok(steam.memberCount(c) == 0 && steam.lobbyOwner(c) == u64(0), "empty lobby disappears");
    ok(join(c) == steam.ENTER_DOESNT_EXIST, "gone lobby");
    ok(steam.setJoinable(b, false), "close");
    ok(join(b) == steam.ENTER_SUCCESS, "member of a closed lobby stays");
    ok(!steam.fakeLobbyJoin(b, u64(202)), "closed lobby refuses");
    steam.leaveLobby(b);
    ok(join(b) == steam.ENTER_NOT_ALLOWED && J_LOCKED, "closed lobby: not allowed and locked");
    ok(steam.setJoinable(b, true) == false, "not owner anymore");
    // owner migration
    ok(steam.lobbyOwner(b) == u64(201), "owner moved to the oldest member");
    ok(steam.lobbyOwner(a) == me, "still owner of a");
    ok(steam.setLobbyOwner(a, u64(102)) && steam.lobbyOwner(a) == u64(102), "hand over");
    ok(!steam.setLobbyOwner(a, me), "no longer allowed");
    M_N = 0;
    ok(steam.fakeLobbyLeave(a, u64(102)), "owner leaves");
    steam.frame();
    ok(steam.lobbyOwner(a) == me && M_N == 1 && M_USER == u64(102) && M_CHANGE == steam.LOBBY_LEFT, "migrates to the oldest (me) and fires LEFT");
    ok(steam.memberCount(a) == 3 && steam.memberAt(a, 0) == me && steam.memberAt(a, 1) == u64(101) && steam.memberAt(a, 2) == u64(103), "order kept after a leave");
    steam.leaveLobby(a);
    ok(steam.lobbyOwner(a) == u64(101) && steam.memberCount(a) == 2, "I left: oldest remaining owns");
    steam.leaveLobby(a);
    ok(steam.fakeLobbyLeave(a, u64(101)) && steam.fakeLobbyLeave(a, u64(103)) && steam.memberCount(a) == 0, "everyone gone");
    ok(steam.lobbyOwner(a) == u64(0), "lobby removed");
    steam.fakeLobbyLeave(b, u64(201));
    M_N = 0;
}

fn fakeSearch() {
    let me = steam.userId();
    let a = make(steam.LOBBY_PUBLIC, 4);
    let b = make(steam.LOBBY_PUBLIC, 2);
    let c = make(steam.LOBBY_FRIENDS_ONLY, 8);
    let hidden = make(steam.LOBBY_PRIVATE, 8);
    let inv = make(steam.LOBBY_INVISIBLE, 8);
    ok(steam.setLobbyData(a, "mode", "ctf") && steam.setLobbyData(a, "level", "7"), "set a");
    ok(steam.setLobbyData(b, "mode", "dm") && steam.setLobbyData(b, "level", "3"), "set b");
    ok(steam.setLobbyData(c, "mode", "ctf") && steam.setLobbyData(c, "level", "12"), "set c");
    ok(steam.setLobbyData(hidden, "mode", "ctf"), "set hidden");
    ok(find() == 3 && steam.lobbyAt(0) == a && steam.lobbyAt(1) == b && steam.lobbyAt(2) == c && steam.lobbyAt(3) == u64(0), "all visible, creation order");
    steam.filterString("mode", "ctf", steam.CMP_EQUAL);
    ok(find() == 2 && steam.lobbyAt(0) == a && steam.lobbyAt(1) == c, "string equal");
    ok(find() == 3, "filters are cleared after one search");
    steam.filterString("mode", "ctf", steam.CMP_NOT_EQUAL);
    ok(find() == 1 && steam.lobbyAt(0) == b, "string not equal");
    steam.filterNumber("level", 7, steam.CMP_EQUAL_OR_GREATER);
    ok(find() == 2 && steam.lobbyAt(0) == a && steam.lobbyAt(1) == c, "number at least");
    steam.filterNumber("level", 7, steam.CMP_LESS);
    ok(find() == 1 && steam.lobbyAt(0) == b, "number less");
    steam.filterNumber("level", 7, steam.CMP_GREATER);
    steam.filterString("mode", "ctf", steam.CMP_EQUAL);
    ok(find() == 1 && steam.lobbyAt(0) == c, "two filters both apply");
    steam.fakeLobbyJoin(b, u64(300));
    steam.filterSlots(1);
    ok(find() == 2 && steam.lobbyAt(0) == a && steam.lobbyAt(1) == c, "slots: the full b is out");
    steam.filterSlots(5);
    ok(find() == 1 && steam.lobbyAt(0) == c, "slots 5");
    steam.filterNear("level", 6);
    ok(find() == 3 && steam.lobbyAt(0) == a && steam.lobbyAt(1) == b && steam.lobbyAt(2) == c, "near: 7 is 1 away, 3 is 3, 12 is 6");
    steam.filterNear("level", 11);
    steam.filterCount(2);
    ok(find() == 2 && steam.lobbyAt(0) == c && steam.lobbyAt(1) == a, "near then count");
    steam.filterDistance(steam.DISTANCE_WORLDWIDE);
    steam.filterCompatible(a);
    ok(find() == 3, "distance and compatible change nothing in fake mode");
    // refs: keys over the limit are refused
    ok(!steam.setLobbyData(a, "", "x"), "empty key refused");
    let long = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx";
    ok(long.len > steam.LOBBY_KEY_MAX && !steam.setLobbyData(a, long, "x"), "key over 255 refused");
    steam.leaveLobby(a);
    steam.leaveLobby(b);
    steam.leaveLobby(c);
    steam.leaveLobby(hidden);
    steam.leaveLobby(inv);
    ok(me != u64(0), "me");
    steam.fakeLobbyLeave(b, u64(300));
}

fn fakeData() {
    let me = steam.userId();
    let a = make(steam.LOBBY_PUBLIC, 4);
    D_N = 0;
    ok(steam.setLobbyData(a, "map", "dust") && steam.lobbyData(a, "map") == "dust", "set and get");
    steam.frame();
    ok(D_N == 1 && D_LOBBY == a && D_MEMBER == a && D_OK, "505 for lobby data has member == lobby");
    ok(steam.setLobbyData(a, "map", "mirage") && steam.lobbyData(a, "map") == "mirage" && steam.lobbyDataCount(a) == 1, "replace");
    ok(steam.setLobbyData(a, "empty", "") && steam.lobbyData(a, "empty") == "" && steam.lobbyDataCount(a) == 2, "empty value is still a key");
    let kv = steam.lobbyDataAt(a, 0);
    ok(kv.key == "map" && kv.value == "mirage", "data at 0");
    ok(steam.lobbyDataAt(a, 1).key == "empty" && steam.lobbyDataAt(a, 2).key == "" && steam.lobbyDataAt(a, 0 - 1).key == "", "data at range");
    ok(steam.deleteLobbyData(a, "map") && !steam.deleteLobbyData(a, "map") && steam.lobbyDataCount(a) == 1, "delete");
    // a big value (near the 8 KB limit)
    let mem = Arena.create(32768);
    let big = mem.alloc::<u8>(8191);
    for i in 0..8191 {
        big[i] = u8(97 + i % 26);
    }
    ok(steam.setLobbyData(a, "big", big as string) && steam.lobbyData(a, "big").len == 8191, "8191 byte value");
    let bigger = mem.alloc::<u8>(8192);
    ok(!steam.setLobbyData(a, "big2", bigger as string), "8192 byte value refused");
    // member data
    steam.frame();
    D_N = 0;
    steam.setMemberData(a, "team", "red");
    steam.frame();
    ok(steam.memberData(a, me, "team") == "red" && steam.memberData(a, u64(555), "team") == "", "member data is per member");
    ok(D_N == 1 && D_MEMBER == me, "505 for member data names the member");
    ok(steam.lobbyDataCount(a) == 2, "member data is not lobby data");
    // non-owner cannot write lobby data
    steam.fakeLobbyJoin(a, u64(600));
    ok(steam.setLobbyOwner(a, u64(600)) && !steam.setLobbyData(a, "map", "x") && !steam.deleteLobbyData(a, "big"), "non-owner writes refused");
    ok(steam.lobbyData(a, "empty") == "" && steam.refreshLobby(a) && !steam.refreshLobby(u64(1)), "refresh");
    D_N = 0;
    steam.frame();
    ok(D_N == 1, "refresh fires 505");
    ok(!steam.setLinkedLobby(a, u64(4)), "linking needs ownership and a real lobby");
    steam.leaveLobby(a);
    steam.fakeLobbyLeave(a, u64(600));
}

fn fakeChatAndServer() {
    let me = steam.userId();
    let a = make(steam.LOBBY_PUBLIC, 4);
    steam.fakeLobbyJoin(a, u64(700));
    steam.frame();
    T_N = 0;
    let mem = Arena.create(16384);
    let msg = mem.alloc::<u8>(5);
    msg[0] = u8(1);
    msg[1] = u8(0);
    msg[2] = u8(255);
    msg[3] = u8(0);
    msg[4] = u8(66);
    ok(steam.sendLobbyMsg(a, msg), "send binary");
    steam.frame();
    ok(T_N == 1 && T_USER == me && T_ID == 0, "the sender gets 507 too");
    ok(steam.fakeLobbyMsg(a, u64(700), "hello" as []u8), "other member sends");
    steam.frame();
    ok(T_N == 2 && T_USER == u64(700) && T_ID == 1, "chat ids count up");
    let out = mem.alloc::<u8>(16);
    let m0 = steam.lobbyMsg(a, 0, out);
    ok(m0.user == me && m0.len == 5 && m0.kind == steam.CHAT_MSG, "message 0 header");
    ok(out[0] == u8(1) && out[1] == u8(0) && out[2] == u8(255) && out[3] == u8(0) && out[4] == u8(66), "binary bytes kept, NULs included");
    let small = mem.alloc::<u8>(3);
    ok(steam.lobbyMsg(a, 1, small).len == 3 && small[0] == u8(104), "cut to the buffer");
    ok(steam.lobbyMsg(a, 9, out).len == 0 && steam.lobbyMsg(a, 9, out).user == u64(0), "unknown message");
    ok(!steam.fakeLobbyMsg(a, u64(9999), "x" as []u8), "strangers cannot talk");
    let huge = mem.alloc::<u8>(4097);
    ok(!steam.sendLobbyMsg(a, huge), "4097 bytes refused");
    let max = mem.alloc::<u8>(4096);
    ok(steam.sendLobbyMsg(a, max) && !steam.sendLobbyMsg(a, mem.alloc::<u8>(0)), "4096 ok, empty refused");
    steam.leaveLobby(a);
    ok(!steam.sendLobbyMsg(a, msg), "not a member cannot send");
    // game server
    steam.setLobbyServer(a, u32(2130706433), 27015, u64(3));
    ok(!steam.lobbyServer(a).ok, "a non-owner cannot set the server");
    ok(steam.lobbyOwner(a) == u64(700), "owner migrated to the other member");
    steam.fakeLobbyLeave(a, u64(700));
    let b = make(steam.LOBBY_PUBLIC, 2);
    ok(!steam.lobbyServer(b).ok, "no server yet");
    S_N = 0;
    steam.setLobbyServer(b, u32(2130706433), 27015, u64(99));
    steam.frame();
    let s = steam.lobbyServer(b);
    ok(s.ok && s.ip == u32(2130706433) && s.port == 27015 && s.server == u64(99), "server stored");
    ok(S_N == 1 && S_IP == u32(2130706433) && S_PORT == 27015 && S_ID == u64(99), "509 fired");
    steam.setLobbyServer(b, u32(1), 70000, u64(1));
    steam.frame();
    ok(S_N == 1, "bad port ignored");
    // invite
    ok(steam.inviteToLobby(b, u64(800)) && !steam.inviteToLobby(b, u64(0)) && !steam.inviteToLobby(u64(1), u64(800)), "invite");
    steam.overlayInvite(b);
    steam.leaveLobby(b);
}

fn lateAndShutdown() {
    handlers();
    let a = make(steam.LOBBY_PUBLIC, 2);
    steam.createLobby(steam.LOBBY_PUBLIC, 2, onCreated, u64(1));
    let n = C_N;
    steam.shutdown();
    steam.initFake(u32(1001));
    handlers();
    steam.frame();
    ok(C_N == n, "a result queued before shutdown is dropped");
    ok(steam.lobbyOwner(a) == u64(0) && steam.memberCount(a) == 0, "lobbies cleared at shutdown");
    steam.filterString("x", "y", steam.CMP_EQUAL);
    steam.shutdown();
    steam.initFake(u32(1001));
    ok(find() == 0, "filters cleared at shutdown too");
    let b = make(steam.LOBBY_PUBLIC, 2);
    ok(b == u64(109775241000000001), "ids restart from the base after shutdown");
}

fn main() {
    absent();
    layouts();
    ok(steam.initFake(u32(1001)) == steam.Status.Fake, "fake init");
    handlers();
    decode();
    results();
    fakeCreateAndMembers();
    fakeSearch();
    fakeData();
    fakeChatAndServer();
    lateAndShutdown();
    steam.shutdown();
    printLn("steam_lobby_test ok");
}
