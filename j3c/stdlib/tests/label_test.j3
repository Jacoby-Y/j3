// Tests for `<label>` activating its control through j3.ui.dom + j3.ui.inputs: a wrapping label toggles its checkbox once, `for="id"`
// finds a control anywhere (first of duplicate ids; gone when the control is removed, back when re-added), a click on the control itself
// does not double-activate, disabled controls and drags do nothing, text boxes take focus, a button is clicked, and the label's text is
// the control's accessible name. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/label_test.j3
// Panics on the first failed check.

module label_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, Text };
use j3.ui.a11y;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, label, button, span { font-family: \"T\"; font-size: 16px; } label { display: block; }";

#[singleton]
let CHECKS: int;
// control node ids: 0 wrapped checkbox, 1 `for` checkbox, 2 wrapped text box, 3 disabled checkbox, 4 first dup, 5 second dup, 6 button, 7 control inside a label with a click
#[singleton]
let ID: [9]int;
#[singleton]
let ON: [8]bool;
#[singleton]
let HITS: [8]int;
#[singleton]
let SHOW_B: bool;
// the labels' own on:click counts: 0 wrapping Alpha, 1 `for` Beta
#[singleton]
let LC: [2]int;
#[singleton]
let MANY: bool;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// A checkbox the way `bind:checked` generates it: a click flips the variable, which is written back.
fn box(d: &Dom, k: int) {
    let c = d.open(k, d.tag("input"), 1);
    d.attrType(c, "checkbox");
    ID[k] = c;
    if d.clicked(c) {
        ON[k] = !ON[k];
        HITS[k] += 1;
    }
    d.attrChecked(c, ON[k]);
    d.close();
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    // implicit
    let al = d.open(0, d.tag("label"), 1);
    if d.clicked(al) { LC[0] += 1; }
    box(d, 0);
    d.text("Alpha");
    d.close();
    // explicit, the control later in the tree
    let l = d.open(1, d.tag("label"), 1);
    d.attrFor(l, "b");
    if d.clicked(l) { LC[1] += 1; }
    d.text("Beta");
    d.close();
    if SHOW_B {
        let bc = d.open(1, d.tag("input"), 1);
        d.attrId(bc, "b");
        d.attrType(bc, "checkbox");
        ID[1] = bc;
        if d.clicked(bc) { ON[1] = !ON[1]; HITS[1] += 1; }
        d.attrChecked(bc, ON[1]);
        d.close();
    }
    // wrapped text box
    d.open(2, d.tag("label"), 1);
    let t = d.open(2, d.tag("input"), 1);
    d.attrType(t, "text");
    ID[2] = t;
    d.close();
    d.text("Name");
    d.close();
    // a textarea in a label, and one named by for=
    d.open(7, d.tag("label"), 1);
    let ta = d.open(7, d.tag("input"), 1);
    d.attrType(ta, "textarea");
    ID[7] = ta;
    d.close();
    d.text("Notes");
    d.close();
    let nl = d.open(8, d.tag("label"), 1);
    d.attrFor(nl, "ta2");
    d.text("More");
    d.close();
    let ta2 = d.open(8, d.tag("input"), 1);
    d.attrId(ta2, "ta2");
    d.attrType(ta2, "textarea");
    ID[8] = ta2;
    d.close();
    // disabled target
    let g = d.open(3, d.tag("label"), 1);
    d.attrFor(g, "dis");
    d.text("Gamma");
    d.close();
    let dis = d.open(3, d.tag("input"), 1);
    d.attrId(dis, "dis");
    d.attrType(dis, "checkbox");
    d.attrDisabled(dis, true);
    ID[3] = dis;
    if d.clicked(dis) { HITS[3] += 1; }
    d.close();
    // duplicate ids: the first wins
    let dl = d.open(4, d.tag("label"), 1);
    d.attrFor(dl, "dup");
    d.text("Dup");
    d.close();
    for k in 4..6 {
        let c = d.open(k, d.tag("input"), 1);
        d.attrId(c, "dup");
        d.attrType(c, "checkbox");
        ID[k] = c;
        if d.clicked(c) { ON[k] = !ON[k]; HITS[k] += 1; }
        d.attrChecked(c, ON[k]);
        d.close();
    }
    // a button inside a label
    d.open(6, d.tag("label"), 1);
    let bt = d.open(6, d.tag("button"), 1);
    ID[6] = bt;
    if d.clicked(bt) { HITS[6] += 1; }
    d.text("Go");
    d.close();
    d.text("Press");
    d.close();
    d.close();
    if MANY {
        for k in 0..500 {
            let mc = d.open(10 + k, d.tag("input"), 1);
            d.attrType(c, "text");
            d.attrId(c, `m{k}`);
            d.close();
            if k % 100 == 0 {
                let ml = d.open(10 + k, d.tag("label"), 1);
                d.attrFor(ml, `m{k}`);
                d.text(`Many {k}`);
                d.close();
            }
        }
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn clickText(d: &Dom, text: string) {
    for f in 0..4 {
        testkit.clickText(d, f, 0, text);
        frame(d);
    }
}

fn clickNode(d: &Dom, id: int) {
    for f in 0..4 {
        testkit.click(d, f, 0, id);
        frame(d);
    }
}

fn idle(d: &Dom) {
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(d);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "label.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    SHOW_B = true;
    idle(&d);
    idle(&d);

    clickText(&d, "Alpha");
    ok(ON[0] && HITS[0] == 1, "a wrapping label toggles its checkbox once");
    ok(LC[0] == 1, "the wrapping label's own on:click fires once");
    clickNode(&d, ID[0]);
    ok(!ON[0] && HITS[0] == 2, "a click on the checkbox itself activates it once, not twice");

    clickText(&d, "Beta");
    ok(ON[1] && HITS[1] == 1, "for= toggles a checkbox elsewhere");
    ok(LC[1] == 1, "the for= label's own on:click fires once too");

    clickText(&d, "Name");
    ok(d.focus == ID[2], "a label focuses its text box");
    idle(&d);

    clickText(&d, "Notes");
    ok(d.focus == ID[7], "a wrapping label focuses its textarea");
    idle(&d);
    clickText(&d, "More");
    ok(d.focus == ID[8], "for= focuses a textarea");
    idle(&d);

    clickText(&d, "Gamma");
    ok(HITS[3] == 0, "a disabled control is not activated");

    clickText(&d, "Dup");
    ok(ON[4] && !ON[5] && HITS[4] == 1 && HITS[5] == 0, "the first of duplicate ids wins");

    clickText(&d, "Press");
    ok(HITS[6] == 1, "a label clicks its button once");

    // the control is removed: nothing happens; re-added: it works again
    SHOW_B = false;
    idle(&d);
    idle(&d);
    let h = HITS[1];
    clickText(&d, "Beta");
    ok(HITS[1] == h, "no control with that id: no activation");
    SHOW_B = true;
    idle(&d);
    idle(&d);
    clickText(&d, "Beta");
    ok(HITS[1] == h + 1 && !ON[1], "re-added: the label finds it again");
    clickText(&d, "Dup");
    ok(d.css.warns.len == 1, "the duplicate id warned once, not on every click");

    // a drag that starts on the label and ends elsewhere does not activate
    let t = testkit.textNode(&d, "Alpha");
    let e = d.nodes.items[t].parent;
    let sx = d.absX(e) + 3.0;
    let sy = d.absY(e) + 3.0;
    let h0 = HITS[0];
    d.simInput(sx, sy, false, 0.0); frame(&d);
    d.simInput(sx, sy, true, 0.0); frame(&d);
    d.simInput(sx + 12.0, sy, true, 0.0); frame(&d);
    d.simInput(sx + 300.0, sy + 200.0, true, 0.0); frame(&d);
    d.simInput(sx + 300.0, sy + 200.0, false, 0.0); frame(&d);
    idle(&d);
    ok(HITS[0] == h0, "a drag does not activate");

    // the accessible name
    let tx = Text.new(&mem);
    a11y.dump(&d, &mem, &tx);
    let s = tx.str();
    ok(contains(s, "checkbox \"Beta\"") && contains(s, "checkbox \"Alpha\""), "the label text names the control");

    // many controls: the dump finishes within this run's `timeout` (no clock in the headless runtime) and still names them
    MANY = true;
    idle(&d);
    idle(&d);
    let big = Text.new(&mem);
    a11y.dump(&d, &mem, &big);
    ok(contains(big.str(), "Many 300"), "the labels of the many are named");
    MANY = false;
    idle(&d);
    idle(&d);

    // idle frames cost nothing
    let r0 = d.restyled;
    let l0 = d.laid;
    for i in 0..10 { idle(&d); }
    ok(d.restyled == r0 && d.laid == l0, "idle frames neither restyle nor lay out");
    printLn(`label_test: {CHECKS} checks passed`);
}
