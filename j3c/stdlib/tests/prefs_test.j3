// Tests for `@media (prefers-reduced-motion)` / `(prefers-color-scheme)` and the Dom setters: parsing, combination with
// width features, not / or, one restyle per toggle then steady frames, and the built-in motion stopping under reduced motion.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/prefs_test.j3 --headless

module prefs_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let ON: bool;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = ".a { width: 10px; height: 10px; ripple: #ffffff 200ms; } .l { width: 50px; height: 50px; overflow-y: auto; scroll-behavior: smooth; } .r { height: 40px; } .e { width: 20px; height: 20px; } .f { width: 20px; height: 20px; } .a { width: 10px; } @media (prefers-color-scheme: dark) { .a { width: 20px; } } @media (prefers-reduced-motion: reduce) { .a { height: 30px; } } @media (prefers-reduced-motion: reduce) and (prefers-color-scheme: light) and (min-width: 100px) { .a { width: 40px; } } @media not (prefers-color-scheme: dark), (max-width: 50px) { .e { width: 25px; } }";

fn frame(d: &Dom): int {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    let a = d.open(0, d.tag("div"), 1);
    d.cls(a, "a");
    d.close();
    let l = d.open(1, d.tag("div"), 1);
    d.cls(l, "l");
    for i in 0..4 {
        let r = d.open(i, d.tag("div"), 1);
        d.cls(r, "r");
        d.close();
    }
    d.close();
    if ON {
        let e = d.open(2, d.tag("div"), 1);
        d.cls(e, "e");
        d.trans(e, 1, 160.0, 1, 160.0, 1, 0.0, 0.0, 0.5, 0);
        d.close();
    }
    d.layout();
    d.endFrame();
    return a;
}

fn run(d: &Dom, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d);
    }
}

fn warns(src: string): int {
    let mem = Arena.create(1024 * 1024);
    let c = Css.new(&mem);
    parse(&c, src, "w.css", 1);
    return c.warns.len;
}

fn main() {
    ok(warns("@media (prefers-reduced-motion: reduce) { .a { color: #ff0000; } } @media (prefers-reduced-motion: no-preference) { .a { color: #ff0000; } } @media (prefers-color-scheme: dark) { .a { color: #ff0000; } } @media (prefers-color-scheme: light) and (min-width: 300px), not (prefers-color-scheme: dark) { .a { color: #ff0000; } } @media screen and (prefers-reduced-motion: reduce) and (max-height: 400px) { .a { color: #ff0000; } }") == 0, "valid prefers-* queries parse");
    ok(warns("@media (prefers-color-scheme: blue) { .a { color: #ff0000; } }") == 1, "bad color scheme value warns");
    ok(warns("@media (prefers-reduced-motion: 3) { .a { color: #ff0000; } }") == 1, "bad motion value warns");
    ok(warns("@media (prefers-contrast: more) { .a { color: #ff0000; } }") == 1, "other prefers-* warns");

    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    ok(css.warns.len == 0, "sheet parses clean");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    ON = false;
    run(&d, 3);
    let a = frame(&d);
    ok(!d.reducedMotion() && !d.darkScheme(), "defaults: no-preference, light");
    ok(d.nodes.items[a].w == 10.0 && d.nodes.items[a].h == 10.0, "base style");

    let rest = d.restyled;
    d.setColorScheme(true);
    a = frame(&d);
    ok(d.restyled > rest && d.nodes.items[a].w == 20.0, "dark restyles and applies");
    rest = d.restyled;
    run(&d, 5);
    ok(d.restyled == rest, "steady after the toggle");
    d.setColorScheme(true);
    a = frame(&d);
    ok(d.restyled == rest, "same value restyles nothing");

    d.setReducedMotion(true);
    a = frame(&d);
    ok(d.restyled > rest && d.nodes.items[a].h == 30.0 && d.nodes.items[a].w == 20.0, "reduced motion applies, dark kept");
    rest = d.restyled;
    run(&d, 5);
    ok(d.restyled == rest, "steady again");
    d.setColorScheme(false);
    a = frame(&d);
    ok(d.nodes.items[a].w == 40.0, "reduce and light and min-width combine");
    d.setReducedMotion(false);
    d.setColorScheme(false);
    a = frame(&d);
    ok(d.nodes.items[a].w == 10.0 && d.nodes.items[a].h == 10.0, "back to the base style");

    // reduced motion: enter / leave transitions finish at once
    d.setReducedMotion(true);
    ON = true;
    run(&d, 1);
    let e = d.nodes.items[0].last;
    ok(d.trKind(e) == 0 && d.trAmt(e) == 1.0, "enter transition is instant");
    ON = false;
    run(&d, 1);
    ok(d.ghosts == 0 && d.trns.len == 0, "no leave ghost");
    d.setReducedMotion(false);
    ON = true;
    run(&d, 1);
    ON = false;
    run(&d, 1);
    ok(d.ghosts == 1, "ghost without reduced motion");
    d.setReducedMotion(true);
    run(&d, 1);
    ok(d.ghosts == 0, "turning reduced motion on finishes a leave in flight");
    d.setReducedMotion(false);

    // smooth scroll is instant, ripple does not start
    run(&d, 2);
    d.setReducedMotion(true);
    d.simInput(25.0, 30.0, false, -1.0);
    frame(&d);
    let l = d.nodes.items[0].last;
    ok(d.coasting == 0, "no wheel inertia");
    d.setReducedMotion(false);
    d.simInput(25.0, 30.0, false, -1.0);
    frame(&d);
    ok(d.coasting > 0, "inertia without reduced motion");
    run(&d, 40);
    d.setReducedMotion(true);
    d.simInput(5.0, 5.0, true, 0.0);
    frame(&d);
    ok(d.rip.n == 0, "no ripple");
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d);
    d.setReducedMotion(false);
    run(&d, 30);
    d.simInput(5.0, 5.0, true, 0.0);
    frame(&d);
    ok(d.rip.n == 1, "ripple without reduced motion");

    // an enter in flight finishes when reduced motion turns on, with no layout churn afterwards; turned off, motion works again
    d.setReducedMotion(false);
    ON = false;
    run(&d, 20);
    ON = true;
    run(&d, 4);
    e = d.nodes.items[0].last;
    ok(d.trKind(e) == 1 && d.trAmt(e) < 0.9, "enter in flight");
    d.setReducedMotion(true);
    ok(d.trKind(e) == 0 && d.trAmt(e) == 1.0, "enter finished at once");
    run(&d, 2);
    let laid = d.laid;
    let used = d.mem.used;
    run(&d, 10);
    ok(d.laid == laid && d.mem.used == used, "no layout or allocation after the toggle");
    d.setReducedMotion(false);
    ON = false;
    run(&d, 20);
    ON = true;
    run(&d, 1);
    e = d.nodes.items[0].last;
    ok(d.trKind(e) == 1, "enter plays again after reduced motion is off");
    ON = false;

    // a setter before the first render adds no restyle; the same value every frame is free
    let mem2 = Arena.create(8 * 1024 * 1024);
    let c2 = Css.new(&mem2);
    parse(&c2, SHEET, "a.css", 1);
    let base = Dom.new(&mem2, &c2);
    base.setFrameMs(16.0);
    base.simInput(-5.0, -5.0, false, 0.0);
    frame(&base);
    let c3 = Css.new(&mem2);
    parse(&c3, SHEET, "a.css", 1);
    let d3 = Dom.new(&mem2, &c3);
    d3.setFrameMs(16.0);
    d3.setColorScheme(false);
    d3.setReducedMotion(false);
    ok(d3.restyled == 0, "a setter before the first render restyles nothing");
    d3.simInput(-5.0, -5.0, false, 0.0);
    frame(&d3);
    ok(d3.restyled == base.restyled, "first build costs the same with the setters called");
    let r3 = d3.restyled;
    let l3 = d3.laid;
    let u3 = d3.mem.used;
    for i in 0..20 {
        d3.setColorScheme(false);
        d3.setReducedMotion(false);
        d3.simInput(-5.0, -5.0, false, 0.0);
        frame(&d3);
    }
    ok(d3.restyled == r3 && d3.laid == l3 && d3.mem.used == u3, "same value every frame is free");

    // a program's setter survives a second Dom on the same Css (the env defaults are applied only before it)
    d3.setReducedMotion(true);
    let d4 = Dom.new(&mem2, &c3);
    ok(d4.reducedMotion() && c3.prefsSet, "the second Dom keeps the program's value");
    printLn("prefs_test ok");
}
