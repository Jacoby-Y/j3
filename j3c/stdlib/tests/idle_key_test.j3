// Key edges survive the idle loop: a key event that ends an idle sleep (`game.idleWait`) must make `keyPressedRaw` /
// `keyReleased` true on the next `poll`, exactly once. Same loop order as `App.run` (idleWait, poll, draw). Never opens
// a visible window; idle skip must be forced on, since offscreen turns it off:
//   J3_IDLE_SKIP=1 SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/idle_key_test.j3
// A key event has its repeat byte at 13 and scancode at 16 (SDL 2 SDL_KeyboardEvent).

module idle_key_test;

use j3.game;
use j3.game.Key;
use j3.io.printLn;
use j3.sys.panic;

use lib "SDL2" as sdl {
    fn SDL_PushEvent(event: ptr): i32;
}

#[singleton]
let BUF: [8]int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// Push an Enter key event (scancode 40) and let the next loop sleep on it.
fn pushEnter(down: bool, repeat: u8) {
    let i = 0;
    while i < 8 { BUF[i] = 0; i += 1; }
    let bytes: []u8 = []u8 { ptr: &BUF[0] as ptr as &u8, len: 64 };
    bytes[0] = if down { 0 } else { 1 };
    bytes[1] = 3; // 0x300 KEYDOWN / 0x301 KEYUP, little-endian
    bytes[12] = if down { 1 } else { 0 };
    bytes[13] = repeat;
    bytes[16] = 40;
    ok(sdl.SDL_PushEvent(&BUF[0] as ptr) == 1, "push key");
}

/// One `App.run` loop turn after a Dom frame said nothing is due.
fn frame(): bool {
    game.idleReport(game.IDLE_FOREVER);
    let slept = game.idleWait();
    game.poll();
    return slept;
}

fn main() {
    game.initGlHidden("idle key checks", 200, 100);
    ok(game.idleSkipAllowed(), "run with J3_IDLE_SKIP=1");
    game.poll();
    ok(!game.keyPressedRaw(Key.Enter), "starts up");

    pushEnter(true, 0);
    ok(frame(), "slept");
    ok(game.keyPressedRaw(Key.Enter) && game.keyPressed(Key.Enter), "press seen after idle sleep");
    ok(!game.keyReleased(Key.Enter), "no release yet");

    pushEnter(true, 1); // auto-repeat: not a new press
    frame();
    ok(!game.keyPressedRaw(Key.Enter), "press once, repeat ignored");

    pushEnter(false, 0);
    frame();
    ok(game.keyReleased(Key.Enter) && !game.keyPressedRaw(Key.Enter), "release seen after idle sleep");

    pushEnter(false, 0); // a stray release, then a plain poll: nothing stays latched
    frame();
    game.poll();
    ok(!game.keyReleased(Key.Enter) && !game.keyPressedRaw(Key.Enter), "edges cleared");

    // down and up inside one frame still give a press and a release
    pushEnter(true, 0);
    pushEnter(false, 0);
    frame();
    ok(game.keyPressedRaw(Key.Enter) && game.keyReleased(Key.Enter), "tap in one pump");

    // `game.simKey` wakes the sleep too and is reported once
    game.simKey(Key.Tab, true);
    ok(frame(), "slept on a sim key");
    ok(game.keyPressedRaw(Key.Tab) && game.keyDown(Key.Tab), "sim press after idle sleep");
    frame();
    ok(!game.keyPressedRaw(Key.Tab) && game.keyDown(Key.Tab), "sim press once, then held");
    game.simKey(Key.Tab, false);
    frame();
    ok(game.keyReleased(Key.Tab) && !game.keyDown(Key.Tab), "sim release after idle sleep");
    printLn("idle_key_test ok");
}
