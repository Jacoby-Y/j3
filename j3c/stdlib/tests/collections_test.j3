// Tests for the compiler-workload collections: List (pop last insert clear extend indexOf contains),
// stable sort / sortBy, Map (getPtr getOrPut each sortedKeys free), Set, Interner. Each container also
// runs a randomized test of about 1M operations against a naive reference.
//   timeout 120 j3c run --opt 2 j3c/stdlib/tests/collections_test.j3
// Panics on the first failed check.

module collections_test;

use j3.cmp.{ sort, sortBy };
use j3.data.intern.Interner;
use j3.data.map.Map;
use j3.data.set.Set;
use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.rand.Rng;
use j3.sys.panic;

const OPS: int = 1000000;

/// No `operator==`: a `List` of it compiles because `indexOf` is never called on it.
struct NoEq {
    a: int;
}

struct Rec {
    key: int;
    seq: int;
}

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("collections_test");
    }
}

/// A value in `0..n` from the high bits of the LCG.
fn roll(r: &Rng, n: int): int { return (r.next() >> 20) % n; }

fn listBasics(mem: &Arena) {
    let xs = List<int>.new(mem);
    xs.extend(mem.alloc::<int>(0));
    ok(xs.len == 0, "extend empty");
    for i in 0..5 { xs.push(i); }
    ok(xs.pop() == 4 && xs.len == 4 && xs.last() == 3, "pop last");
    xs.insert(0, 9);
    xs.insert(5, 8);
    xs.insert(2, 7);
    ok(xs.len == 7 && xs.items[0] == 9 && xs.items[2] == 7 && xs.items[6] == 8, "insert");
    ok(xs.indexOf(7) == 2 && xs.indexOf(42) == -1 && xs.contains(8) && !xs.contains(5), "indexOf contains");
    let more = mem.alloc::<int>(3);
    more[0] = 1; more[1] = 2; more[2] = 3;
    xs.extend(more);
    ok(xs.len == 10 && xs.slice().len == 10 && xs.slice()[9] == 3, "extend slice");
    xs.clear();
    ok(xs.len == 0, "clear");
    let ne = List<NoEq>.new(mem);
    ne.push(NoEq { a: 1 });
    ok(ne.pop().a == 1, "List of a type without ==");
}

fn listRandom(mem: &Arena) {
    let r = Rng.new(11);
    let xs = List<int>.new(mem);
    let ref = mem.alloc::<int>(256);
    let n = 0;
    for _ in 0..OPS {
        let op = roll(&r, 10);
        let v = roll(&r, 50);
        if op <= 2 && n < 200 {
            xs.push(v);
            ref[n] = v;
            n += 1;
        } else if op == 3 && n > 0 {
            n -= 1;
            ok(xs.pop() == ref[n], "rand pop");
        } else if op == 4 && n < 200 {
            let at = roll(&r, n + 1);
            xs.insert(at, v);
            let j = n;
            while j > at { ref[j] = ref[j - 1]; j -= 1; }
            ref[at] = v;
            n += 1;
        } else if op == 5 && n > 0 {
            let at = roll(&r, n);
            xs.remove(at);
            for j in at..n - 1 { ref[j] = ref[j + 1]; }
            n -= 1;
        } else if op == 6 && n > 0 {
            let at = roll(&r, n);
            xs.swapRemove(at);
            ref[at] = ref[n - 1];
            n -= 1;
        } else if op == 7 {
            let want = -1;
            for j in 0..n {
                if ref[j] == v { want = j; break; }
            }
            ok(xs.indexOf(v) == want && xs.contains(v) == (want >= 0), "rand indexOf");
        } else if op == 8 && n > 0 {
            ok(xs.last() == ref[n - 1], "rand last");
        } else if op == 9 && roll(&r, 1000) == 0 {
            xs.clear();
            n = 0;
        }
        ok(xs.len == n, "rand len");
    }
    for j in 0..n { ok(xs.items[j] == ref[j], "rand final contents"); }
}

fn sortTests(mem: &Arena) {
    let r = Rng.new(5);
    let recs = mem.alloc::<Rec>(5000);
    let ints = mem.alloc::<int>(5000);
    // ~1M elements sorted in total, sizes 0..5000, few distinct keys so ties are common.
    let total = 0;
    let round = 0;
    while total < OPS {
        let n = if round < 40 { round } else { roll(&r, 5000) };
        round += 1;
        total += n + 1;
        let sum = 0;
        for i in 0..n {
            recs[i] = Rec { key: roll(&r, 20), seq: i };
            ints[i] = roll(&r, 100000) - 50000;
            sum += ints[i];
        }
        let rs = recs[0..n];
        sortBy(rs, fn(a: Rec, b: Rec): bool { return a.key < b.key; });
        let is = ints[0..n];
        sort(is);
        let seen = 0;
        for i in 0..n {
            seen += is[i];
            if i > 0 {
                ok(is[i - 1] <= is[i], "sort order");
                ok(rs[i - 1].key <= rs[i].key, "sortBy order");
                if rs[i - 1].key == rs[i].key { ok(rs[i - 1].seq < rs[i].seq, "sortBy stable"); }
            }
        }
        ok(seen == sum, "sort keeps the elements");
    }
}

fn mapBasics(mem: &Arena) {
    let m = Map<string, int>.new(mem, 4);
    m.put("a", 1);
    let pa = m.getPtr("a");
    *pa += 10;
    let pb = m.getOrPut("b", 5);
    *pb += 1;
    let pc = m.getOrPut("a", 0);
    *pc += 1;
    ok(m.getOr("a", 0) == 12 && m.getOr("b", 0) == 6, "getPtr getOrPut");
    let sum = 0;
    let count = 0;
    m.each(fn(k: string, v: int) { sum += v; count += k.len; });
    ok(sum == 18 && count == 2, "each");
    let keys = m.sortedKeys(mem);
    ok(keys.len == 2 && keys[0] == "a" && keys[1] == "b", "sortedKeys strings");
    m.free();
    ok(m.len == 0 && !m.has("a") && m.sortedKeys(mem).len == 0, "free empties");
    m.put("c", 3);
    ok(m.getOr("c", 0) == 3 && m.len == 1, "put after free");
}

const KEYS: int = 2048;

fn mapRandom(mem: &Arena) {
    let r = Rng.new(7);
    let m = Map<int, int>.new(mem, 0);
    let s = Set<int>.new(mem, 0);
    let has = mem.alloc::<bool>(KEYS);
    let val = mem.alloc::<int>(KEYS);
    let inSet = mem.alloc::<bool>(KEYS);
    for i in 0..KEYS { has[i] = false; inSet[i] = false; }
    let n = 0;
    let sn = 0;
    for step in 0..OPS {
        let k = roll(&r, KEYS);
        let op = roll(&r, 8);
        if op <= 1 {
            let v = roll(&r, 1000);
            m.put(k, v);
            if !has[k] { n += 1; }
            has[k] = true;
            val[k] = v;
        } else if op == 2 {
            ok(m.remove(k) == has[k], "rand map remove");
            if has[k] { n -= 1; }
            has[k] = false;
        } else if op == 3 {
            ok(m.has(k) == has[k] && m.getOr(k, -1) == (if has[k] { val[k] } else { -1 }), "rand map get");
        } else if op == 4 {
            let p = m.getOrPut(k, 0);
            *p += 1;
            if !has[k] { n += 1; has[k] = true; val[k] = 0; }
            val[k] += 1;
        } else if op == 5 {
            ok(s.add(k) == !inSet[k], "rand set add");
            if !inSet[k] { sn += 1; }
            inSet[k] = true;
        } else if op == 6 {
            ok(s.remove(k) == inSet[k], "rand set remove");
            if inSet[k] { sn -= 1; }
            inSet[k] = false;
        } else {
            ok(s.has(k) == inSet[k], "rand set has");
        }
        ok(m.len == n && s.len() == sn, "rand len");
        if step % 100000 == 99999 {
            let mark = mem.checkpoint();
            let keys = m.sortedKeys(mem);
            let j = 0;
            for i in 0..KEYS {
                if has[i] {
                    ok(keys[j] == i, "rand sortedKeys");
                    j += 1;
                }
            }
            ok(j == keys.len, "rand sortedKeys len");
            let total = 0;
            m.each(fn(key: int, v: int) { total += key * 7 + v; });
            let want = 0;
            for i in 0..KEYS { if has[i] { want += i * 7 + val[i]; } }
            ok(total == want, "rand each");
            let sk = s.sorted(mem);
            let c = 0;
            for i in 0..KEYS { if inSet[i] { ok(sk[c] == i, "rand set sorted"); c += 1; } }
            mem.rewind(mark);
        }
    }
}

fn internTests(mem: &Arena) {
    let it = Interner.new(mem);
    ok(it.intern("x") == u32(0) && it.intern("y") == u32(1) && it.intern("x") == u32(0), "intern ids");
    ok(it.str(u32(1)) == "y" && it.find("z") == -1 && it.len() == 2, "intern str find");
    let r = Rng.new(3);
    let words = 5000;
    let ids = mem.alloc::<int>(words);
    for i in 0..words { ids[i] = -1; }
    let next = 2;
    for _ in 0..OPS {
        let w = roll(&r, words);
        let s = `w{w}`;
        if roll(&r, 4) == 0 {
            ok(it.find(s) == ids[w], "rand intern find");
            continue;
        }
        let id = int(it.intern(s));
        if ids[w] < 0 {
            ok(id == next, "rand intern new id");
            ids[w] = id;
            next += 1;
        }
        ok(id == ids[w] && it.str(u32(id)) == s, "rand intern round trip");
    }
    ok(it.len() == next, "rand intern len");
}

fn main() {
    let mem = Arena.create(1 << 20);
    listBasics(&mem);
    listRandom(&mem);
    sortTests(&mem);
    mapBasics(&mem);
    mapRandom(&mem);
    internTests(&mem);
    printLn("collections_test ok");
}
