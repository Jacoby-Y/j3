// Tests for j3.data.json: parse, read, build, write. Run from the repo root:
//   timeout 60 j3c run j3c/stdlib/tests/json_test.j3
// Panics on the first failed check.

module json_test;

use j3.data.json;
use j3.data.json.{ Json, Kind };
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eq(a: string, b: string): bool {
    if a.len != b.len {
        return false;
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// Parse `src`, write it back, and compare with `want`.
fn round(src: string, want: string, a: &Arena) {
    match json.parseStr(src, a) {
        Result.Ok(j) {
            let got = json.stringify(j, a);
            if !eq(got, want) {
                printLn(`got  {got}`);
                printLn(`want {want}`);
            }
            ok(eq(got, want), src);
        }
        Result.Err(e) {
            printLn(`{src}: {e.msg} at {e.at}`);
            ok(false, src);
        }
    }
}

fn bad(src: string, a: &Arena) {
    match json.parseStr(src, a) {
        Result.Ok(_) { ok(false, `accepted bad input {src}`); }
        Result.Err(_) { ok(true, src); }
    }
}

fn parsed(src: string, a: &Arena): &Json {
    match json.parseStr(src, a) {
        Result.Ok(j) { return j; }
        Result.Err(e) { printLn(`{src}: {e.msg} at {e.at}`); panic("parse"); }
    }
    return json.null(a);
}

fn main() {
    let a = Arena.create(1048576);

    // round trips
    round("null", "null", &a);
    round(" true ", "true", &a);
    round("[]", "[]", &a);
    round("{}", "{}", &a);
    round("[1, 2.5, -3, 0.1, 1e3, 1.5E-3, 123456789012]", "[1,2.5,-3,0.1,1000,0.0015,123456789012]", &a);
    round("{\"a\":{\"b\":[true,false,null]},\"c\":\"d\"}", "{\"a\":{\"b\":[true,false,null]},\"c\":\"d\"}", &a);
    round("\"tab\\there \\\"q\\\" back\\\\ slash\\/\"", "\"tab\\there \\\"q\\\" back\\\\ slash/\"", &a);
    round("\"\\u0001\\u001f\"", "\"\\u0001\\u001f\"", &a);
    round("\"\\u00e9\\u4e2d\\ud83d\\ude00\"", "\"é中😀\"", &a);
    round("\"\\ud800x\"", "\"�x\"", &a);
    round("1e308", "1e+308", &a);
    round("-0", "0", &a);
    round("{\"k\":1,\"k\":2}", "{\"k\":2}", &a);

    // rejected
    bad("", &a);
    bad("[1,]", &a);
    bad("{\"a\":1,}", &a);
    bad("01", &a);
    bad("1.", &a);
    bad(".5", &a);
    bad("+1", &a);
    bad("\"\\x\"", &a);
    bad("\"a\nb\"", &a);
    bad("[1 2]", &a);
    bad("{a:1}", &a);
    bad("tru", &a);
    bad("1 2", &a);
    bad("\"open", &a);
    let deep = Text.new(&a);
    for i in 0..600 {
        deep.push(91);
    }
    for i in 0..600 {
        deep.push(93);
    }
    bad(deep.str(), &a);

    // reading
    let doc = parsed("{\"choices\":[{\"message\":{\"content\":\"hi\"}}],\"n\":42,\"ok\":true}", &a);
    ok(eq(doc.path("choices.0.message.content").asStr(), "hi"), "path");
    ok(doc.path("choices.5.message").isNull(), "path past the end");
    ok(doc.path("nope.deeper").isNull(), "missing path");
    ok(doc.get("n").asInt() == 42, "asInt");
    ok(doc.get("ok").asBool(), "asBool");
    ok(eq(doc.get("n").asStr(), ""), "wrong kind gives empty");
    ok(doc.get("choices").len() == 1, "len");
    ok(doc.has("n") && !doc.has("m"), "has");
    ok(doc.get("choices").kind == Kind.Arr, "kind");

    // building
    let msg = json.obj(&a);
    msg.set("role", json.str("user", &a));
    msg.set("content", json.str("line\none \"q\"", &a));
    let list = json.arr(&a);
    list.push(msg);
    list.push(json.num(0.25, &a));
    list.push(json.boolean(false, &a));
    list.push(json.null(&a));
    let body = json.obj(&a);
    body.set("messages", list);
    body.set("max", json.num(100.0, &a));
    body.set("max", json.num(200.0, &a));
    ok(eq(json.stringify(body, &a), "{\"messages\":[{\"role\":\"user\",\"content\":\"line\\none \\\"q\\\"\"},0.25,false,null],\"max\":200}"), "build");

    // numbers write back exactly
    let nums: [4]f64 = [0.1, 1.0 / 3.0, 123.456, -2.5];
    for i in 0..4 {
        let t = Text.new(&a);
        json.writeNum(nums[i], &t);
        ok(parsed(t.str(), &a).asNum() == nums[i], `number {i} round trips`);
    }
    // exact text, as glibc gcvt printed it (bionic has no gcvt; the same `%.*g` runs everywhere)
    let big = 1.0;
    for i in 0..300 {
        big = big * 10.0;
    }
    let tiny = 1.0;
    for i in 0..1074 {
        tiny = tiny / 2.0;
    }
    let fs: [7]f64 = [0.1, 1.0 / 3.0, 123.456, -2.5, big, 0.00000015, tiny];
    let want: [7]string = ["0.1", "0.3333333333333333", "123.456", "-2.5", "1.0000000000000002e+300", "1.5e-07", "4.94065645841247e-324"];
    for i in 0..7 {
        let ft = Text.new(&a);
        json.writeNum(fs[i], &ft);
        ok(eq(ft.str(), want[i]), `number {i} writes {want[i]}`);
    }
    let inf = 1.0;
    for i in 0..400 {
        inf = inf * 10.0;
    }
    let it = Text.new(&a);
    json.writeNum(inf, &it);
    ok(eq(it.str(), "null"), "infinity writes null");

    printLn(`json_test: {CHECKS} checks ok`);
}
