// Tests for j3.term.width: the column width of code points (controls, ASCII, combining, CJK, Hangul, emoji,
// range edges). Tables are generated (tools/gen_wcwidth.py), so the cases are the edges of known ranges.
//   timeout 120 j3c run j3c/stdlib/tests/term_width_test.j3
// Panics on the first failed check.

module term_width_test;

use j3.io.printLn;
use j3.sys.panic;
use j3.term.width.cpWidth;

fn want(cp: i32, w: int) {
    let got = cpWidth(cp);
    if got != w {
        printLn(`FAIL: cp {cp} want {w} got {got}`);
        panic("cpWidth");
    }
}

fn testControls() {
    want(0x00, 0);
    want(0x07, 0);
    want(0x1b, 0);
    want(0x7f, 0);
    want(0x80, 0);
    want(0x9f, 0);
    want(-1, 0);
}

fn testAscii() {
    for i in 32..127 {
        want(i32(i), 1);
    }
    want(0xa0, 1);
    want(0xad, 1);
    want(0xe9, 1);
    want(0x10ffff, 1);
}

fn testWide() {
    want(0x4e2d, 2);
    want(0x3042, 2);
    want(0xac00, 2);
    want(0xff21, 2);
    want(0x1f600, 2);
    // Edges of the wide ranges, and the Hangul jamo right after them.
    want(0x1100, 2);
    want(0x115f, 2);
    want(0x10ff, 1);
    want(0x1f300, 2);
    want(0x1f64f, 2);
    want(0x1f650, 1);
    want(0x1f900, 2);
    want(0x1f9ff, 2);
    want(0x1fa00, 1);
    want(0x3fffd, 2);
    want(0x3fffe, 1);
}

fn testZero() {
    want(0x0301, 0);
    want(0x200b, 0);
    want(0xfe0f, 0);
    // Edges of the zero ranges, and the letters just outside them.
    want(0x300, 0);
    want(0x36f, 0);
    want(0x370, 1);
    want(0x1160, 0);
    want(0x11ff, 0);
    want(0x1200, 1);
    want(0xe01ef, 0);
    want(0xe01f0, 1);
    // A combining mark that is W in Unicode: zero wins.
    want(0x302a, 0);
    want(0x3099, 0);
}

fn main() {
    testControls();
    testAscii();
    testWide();
    testZero();
    printLn("term_width_test ok");
}
