// Tests for the accessibility gaps (plan 023 stage 13): AT ids (handles), bounds, aria-selected / aria-live / aria-describedby,
// details expanded, names for gauges, `<label for>` correctness, the text interface (never a password), the event and live queues
// (nothing on idle frames), and the wake hook.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/a11y_gaps_test.j3 --headless

module a11y_gaps_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same, Text };
use j3.i18n;
use j3.ui.a11y;
use j3.ui.a11y.TextInfo;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;
#[singleton]
let STATE: St;
#[singleton]
let IDS: Ids;

struct St {
    msg: string = "a";
    alert: string = "x";
    checked: bool = false;
    withBtn: bool = true;
    selTab: bool = false;
    open: bool = false;
}

struct Ids {
    btn: int = -1;
    mv: int = -1;
    tb: int = -1;
    pw: int = -1;
    cb: int = -1;
    tab: int = -1;
    det: int = -1;
    inp: int = -1;
    prog: int = -1;
    meter: int = -1;
    wrapB: int = -1;
    ctlA: int = -1;
    live: int = -1;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    STATE = St {};
    IDS = Ids {};
    a11y.enable(&d);
    frame(&d);
    frame(&d);
    let ev0 = a11y.events(&d, &mem);
    let lv0 = a11y.liveChanges(&d, &mem);
    ok(lv0.len == 0, "a live region's first content is not announced");

    // ---- idle frames: no events, no live changes, nothing counted
    let total = d.aevTotal;
    for i in 0..5 {
        frame(&d);
    }
    ok(d.aevTotal == total && d.aev.len == 0 && d.lq.len == 0, "idle frames queue nothing");
    ok(a11y.events(&d, &mem).len == 0 && a11y.liveChanges(&d, &mem).len == 0, "idle frames: events and liveChanges are empty");

    // ---- stable ids: a handle survives frames, a freed node's handle goes stale even when its id is reused
    let h = d.handle(IDS.btn);
    ok(h >= dom.HANDLE_UNIT, "an AT id is a handle");
    ok(same(nm(&d, &mem, h), "Save"), "name by handle");
    ok(same(a11y.role(&d, h), "button") && a11y.actions(&d, h) == 3, "role and actions by handle");
    STATE.withBtn = false;
    frame(&d);
    ok(!d.alive(h), "the removed node's handle is gone");
    ok(a11y.name(&d, &mem, h).len == 0 && a11y.role(&d, h).len == 0 && a11y.actions(&d, h) == 0, "a stale handle answers nothing");
    ok(!a11y.perform(&d, h, a11y.A_CLICK, 0.0, ""), "a stale handle performs nothing");
    let ev = a11y.events(&d, &mem);
    let kids = false;
    for i in 0..ev.len {
        if ev.items[i].kind == a11y.EV_CHILDREN {
            kids = true;
        }
    }
    ok(kids, "removing a child queues a children-changed event");
    STATE.withBtn = true;
    frame(&d);
    ok(d.handle(IDS.btn) != h, "a recycled id has a new handle");
    ok(!d.alive(h), "and the old handle stays stale");
    a11y.events(&d, &mem);

    // ---- bounds
    let b = a11y.bounds(&d, IDS.btn);
    ok(b.ok && b.w == d.size(IDS.btn).x && b.h == d.size(IDS.btn).y, "bounds size");
    ok(b.x == d.absX(IDS.btn) && b.y == d.absY(IDS.btn), "bounds origin");
    let m = a11y.bounds(&d, IDS.mv);
    ok(m.ok && m.x == d.absX(IDS.mv) + 30.0 && m.y == d.absY(IDS.mv) && m.w == d.size(IDS.mv).x, "a transform moves the bounds");
    ok(!a11y.bounds(&d, h).ok, "a stale handle has no bounds");

    // ---- aria-selected / expanded on details / describedby
    let s = Text.new(&mem);
    a11y.dump(&d, &mem, &s);
    let dump = s.str();
    ok(contains(dump, "tab \"General\" selected=false"), "aria-selected false");
    ok(contains(dump, "group \"\" expanded=false") || contains(dump, "expanded=false"), "details has expanded of its own");
    ok(contains(dump, "desc=\"At least 8 characters\""), "describedby is resolved by id");
    ok(contains(dump, "live=polite") && contains(dump, "live=assertive"), "aria-live shows");
    ok(same(a11y.describedBy(&d, &mem, IDS.inp), "At least 8 characters"), "describedBy text");
    STATE.selTab = true;
    STATE.open = true;
    frame(&d);
    let ev2 = a11y.events(&d, &mem);
    let sawSel = false;
    let sawExp = false;
    for i in 0..ev2.len {
        if ev2.items[i].kind == a11y.EV_SELECTED && ev2.items[i].h == d.handle(IDS.tab) { sawSel = true; }
        if ev2.items[i].kind == a11y.EV_EXPANDED && ev2.items[i].h == d.handle(IDS.det) { sawExp = true; }
    }
    ok(sawSel && sawExp, "selected and expanded changes are events");
    let s2 = Text.new(&mem);
    a11y.dump(&d, &mem, &s2);
    ok(contains(s2.str(), "tab \"General\" selected\n") || contains(s2.str(), "tab \"General\" selected "), "aria-selected true");
    ok(contains(s2.str(), "expanded=true"), "details open is expanded");

    // ---- names for gauges and label correctness
    ok(same(nm(&d, &mem, IDS.prog), "Loading"), "progress named by its wrapping label");
    ok(same(nm(&d, &mem, IDS.meter), "Fuel"), "meter named by label for");
    ok(same(nm(&d, &mem, IDS.ctlA), "Alpha"), "the control a label points at takes its text");
    ok(nm(&d, &mem, IDS.wrapB).len == 0, "a control inside a label that is for another control does not take its name");
    ok(contains(dump, "text \"Alpha\""), "that label's text is still read");

    // ---- text interface
    let ti = TextInfo { value: "", caret: 0, selLo: 0, selHi: 0 };
    ok(a11y.perform(&d, IDS.tb, a11y.A_SET, 0.0, "hello world"), "set a text box");
    frame(&d);
    ok(a11y.text(&d, IDS.tb, &ti) && same(ti.value, "hello world"), "text value");
    let e = &d.eds.items[d.claim(IDS.tb)];
    e.anc = 1;
    e.cur = 4;
    ok(a11y.text(&d, IDS.tb, &ti) && ti.caret == 4 && ti.selLo == 1 && ti.selHi == 4, "caret and selection");
    ok(!a11y.text(&d, IDS.pw, &ti), "a password's text is refused");
    ok(!a11y.text(&d, IDS.cb, &ti), "a checkbox has no text interface");
    a11y.events(&d, &mem);

    // ---- events from state changes, focus; keyboard focus ring
    STATE.checked = true;
    frame(&d);
    let ev3 = a11y.events(&d, &mem);
    let sawChk = false;
    for i in 0..ev3.len {
        if ev3.items[i].kind == a11y.EV_CHECKED && ev3.items[i].h == d.handle(IDS.cb) { sawChk = true; }
    }
    ok(sawChk, "checked change is an event");
    ok(a11y.perform(&d, d.handle(IDS.btn), a11y.A_FOCUS, 0.0, ""), "focus by handle");
    ok(d.focusVisible(), "a screen-reader focus shows the focus ring");
    let ev4 = a11y.events(&d, &mem);
    let sawFocus = false;
    for i in 0..ev4.len {
        if ev4.items[i].kind == a11y.EV_FOCUS && ev4.items[i].h == d.handle(IDS.btn) { sawFocus = true; }
    }
    ok(sawFocus, "focus change is an event");
    // a value set through AT: one event, none after it
    frame(&d);
    a11y.events(&d, &mem);
    let t2 = d.aevTotal;
    frame(&d);
    frame(&d);
    ok(d.aevTotal == t2, "no events once things settle");

    // ---- live regions: polite vs assertive, each once, in order
    a11y.liveChanges(&d, &mem);
    STATE.msg = "saved";
    frame(&d);
    let l = a11y.liveChanges(&d, &mem);
    ok(l.len == 1 && same(l.items[0].text, "saved") && !l.items[0].assertive, "a polite live change");
    ok(l.items[0].h == d.handle(IDS.live), "live change names the region");
    STATE.msg = "saved again";
    STATE.alert = "error!";
    frame(&d);
    let l2 = a11y.liveChanges(&d, &mem);
    ok(l2.len == 2 && !l2.items[0].assertive && l2.items[1].assertive && same(l2.items[1].text, "error!"), "polite then assertive");
    frame(&d);
    ok(a11y.liveChanges(&d, &mem).len == 0, "drained once");

    // ---- wake hook: an AT thread posts, the idle loop sees it
    ok(!d.wantsFrame(), "idle: no frame wanted");
    let ib = a11y.inbox(&mem, &d, 4);
    ok(a11y.post(ib, d.handle(IDS.tb), a11y.A_SET, 0.0, "from AT"), "post");
    ok(d.wantsFrame(), "a post asks for a frame");
    ok(!d.wantsFrame(), "and it is consumed");
    ok(a11y.drain(ib, &mem) == 1, "drain runs it");
    frame(&d);
    ok(a11y.text(&d, IDS.tb, &ti) && same(ti.value, "from AT"), "the posted action ran");
    ok(a11y.drain(ib, &mem) == 0, "nothing left");

    // ---- visibility: hidden leaves the tree
    ok(!contains(dump, "Ghostly"), "visibility: hidden is left out of the tree");

    // ---- document language
    i18n.setLocale("de");
    ok(same(a11y.language(), "de"), "the locale is the document language");
    i18n.setLocale("");

    // ---- tabindex=-1: focusable by code, skipped by Tab
    tabTest(&mem, &css);
    ordTest(&mem, &css);

    // ---- disabled: no events, no storage, over 10k changing frames
    quietTest(&mem, &css);

    printLn(`a11y_gaps_test ok, checks passed: {CHECKS}`);
}
