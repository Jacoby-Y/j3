// Tests for the accessibility gaps (plan 023 stage 13): AT ids (handles), bounds, aria-selected / aria-live / aria-describedby,
// details expanded, names for gauges, `<label for>` correctness, the text interface (never a password), the event and live queues
// (nothing on idle frames), and the wake hook.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/a11y_gaps_test.j3 --headless

module a11y_gaps_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same, Text };
use j3.i18n;
use j3.ui.a11y;
use j3.ui.a11y.TextInfo;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;
#[singleton]
let STATE: St;
#[singleton]
let IDS: Ids;

struct St {
    msg: string = "a";
    alert: string = "x";
    checked: bool = false;
    withBtn: bool = true;
    selTab: bool = false;
    open: bool = false;
}

struct Ids {
    btn: int = -1;
    mv: int = -1;
    tb: int = -1;
    pw: int = -1;
    cb: int = -1;
    tab: int = -1;
    det: int = -1;
    inp: int = -1;
    prog: int = -1;
    meter: int = -1;
    wrapB: int = -1;
    ctlA: int = -1;
    live: int = -1;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = "input { width: 120px; } button { width: 80px; } .mv { transform: translate(30px, 0); } .box { width: 100px; height: 50px; overflow: scroll; } .tall { height: 200px; } .inv { visibility: hidden; } .none { display: none; }";

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    if STATE.withBtn {
        IDS.btn = d.open(1, d.tag("button"), 1);
        d.text("Save");
        d.close();
    }
    IDS.mv = d.open(2, d.tag("button"), 1);
    d.cls(IDS.mv, "mv");
    d.text("Moved");
    d.close();
    IDS.live = d.open(3, d.tag("div"), 1);
    d.attrRole(IDS.live, "status");
    d.attrLive(IDS.live, "polite");
    d.text(STATE.msg);
    d.close();
    let al = d.open(4, d.tag("div"), 1);
    d.attrRole(al, "alert");
    d.attrLive(al, "assertive");
    d.text(STATE.alert);
    d.close();
    let hint = d.open(5, d.tag("p"), 1);
    d.attrId(hint, "hint");
    d.text("At least 8 characters");
    d.close();
    IDS.inp = d.open(6, d.tag("input"), 1);
    d.attrType(IDS.inp, "text");
    d.attrAria(IDS.inp, "Password hint");
    d.attrDescBy(IDS.inp, "hint");
    d.close();
    IDS.tab = d.open(7, d.tag("div"), 1);
    d.attrRole(IDS.tab, "tab");
    d.attrSelected(IDS.tab, STATE.selTab);
    d.text("General");
    d.close();
    IDS.det = d.open(8, d.tag("details"), 1);
    d.attrOpen(IDS.det, STATE.open);
    let sm = d.open(0, d.tag("summary"), 1);
    d.text("More");
    d.close();
    d.close();
    // a gauge named by a wrapping label, one by `for`, and one by neither
    let l1 = d.open(9, d.tag("label"), 1);
    d.text("Loading");
    IDS.prog = d.open(0, d.tag("progress"), 1);
    d.attrValue(IDS.prog, 30.0);
    d.close();
    d.close();
    let l2 = d.open(10, d.tag("label"), 1);
    d.attrFor(l2, "fuel");
    d.text("Fuel");
    d.close();
    IDS.meter = d.open(11, d.tag("meter"), 1);
    d.attrId(IDS.meter, "fuel");
    d.attrValue(IDS.meter, 40.0);
    d.close();
    // a label that wraps one control but is `for` another: it names the other
    let l3 = d.open(12, d.tag("label"), 1);
    d.attrFor(l3, "ctlA");
    d.text("Alpha");
    IDS.wrapB = d.open(0, d.tag("input"), 1);
    d.attrType(IDS.wrapB, "text");
    d.close();
    IDS.ctlA = d.open(13, d.tag("input"), 1);
    d.attrId(IDS.ctlA, "ctlA");
    d.attrType(IDS.ctlA, "text");
    d.close();
    IDS.cb = d.open(14, d.tag("input"), 1);
    d.attrType(IDS.cb, "checkbox");
    d.attrChecked(IDS.cb, STATE.checked);
    d.attrAria(IDS.cb, "Agree");
    d.close();
    IDS.tb = d.open(15, d.tag("input"), 1);
    d.attrType(IDS.tb, "text");
    d.attrAria(IDS.tb, "Name");
    d.close();
    IDS.pw = d.open(16, d.tag("input"), 1);
    d.attrType(IDS.pw, "password");
    d.attrAria(IDS.pw, "Secret");
    d.attrText(IDS.pw, "hunter2");
    d.close();
    let hb = d.open(18, d.tag("button"), 1);
    d.cls(hb, "inv");
    d.text("Ghostly");
    d.close();
    let bx = d.open(17, d.tag("div"), 1);
    d.cls(bx, "box");
    let tl = d.open(0, d.tag("div"), 1);
    d.cls(tl, "tall");
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn nm(d: &Dom, mem: &Arena, id: int): string {
    return a11y.name(d, mem, id);
}

#[singleton]
let TAB: TabIds;

struct TabIds {
    a: int = -1;
    b: int = -1;
    c: int = -1;
}

fn tabFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    TAB.a = d.open(0, d.tag("button"), 1);
    d.text("A");
    d.close();
    TAB.b = d.open(1, d.tag("div"), 1);
    d.attrTabIndexOff(TAB.b);
    d.text("B");
    d.close();
    TAB.c = d.open(2, d.tag("button"), 1);
    d.text("C");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn tabTest(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    TAB = TabIds {};
    tabFrame(&d);
    tabFrame(&d);
    d.focusNode(TAB.a);
    d.simKeys("", "Tab");
    tabFrame(&d);
    tabFrame(&d);
    ok(d.focused() == TAB.c, "Tab skips tabindex=-1");
    d.simKeys("", "S+Tab");
    tabFrame(&d);
    tabFrame(&d);
    ok(d.focused() == TAB.a, "Shift+Tab skips it too");
    ok(a11y.perform(&d, TAB.b, a11y.A_FOCUS, 0.0, ""), "AT can still focus it");
    ok(d.focused() == TAB.b, "focusNode reaches a tabindex=-1 element");
}

// ---- positive tabindex: 3 1 2 0 0 -1 (+ a disabled 1 and an optional modal)
#[singleton]
let ORD: [8]int;
#[singleton]
let ORD_V: [8]int;
#[singleton]
let ORD_DIS: bool;
#[singleton]
let ORD_MODAL: bool;
#[singleton]
let ORD_NO7: bool;
#[singleton]
let ORD_TRAP: bool;

fn ordFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    for i in 0..8 {
        if i == 7 && ORD_NO7 { continue; }
        if ORD_TRAP && i == 3 {
            // a trap group around the elements 3 and 4
            let g = d.open(20, d.tag("div"), 1);
            d.attrNav(g, 0, "trap");
        }
        ORD[i] = d.open(i, d.tag("div"), 1);
        d.attrTabIndexN(ORD[i], ORD_V[i]);
        if i == 6 { d.attrDisabled(ORD[i], ORD_DIS); }
        d.text("x");
        d.close();
        if ORD_TRAP && i == 4 { d.close(); }
    }
    // hidden content never takes Tab, whatever its tabindex
    let h1 = d.open(30, d.tag("div"), 1); d.cls(h1, "inv"); d.attrTabIndexN(h1, 1); d.text("h"); d.close();
    let h2 = d.open(31, d.tag("div"), 1); d.cls(h2, "none"); d.attrTabIndexN(h2, 1); d.text("h"); d.close();
    let h3 = d.open(32, d.tag("div"), 1); d.cls(h3, "none");
    let h4 = d.open(0, d.tag("div"), 1); d.attrTabIndexN(h4, 1); d.text("h"); d.close();
    d.close();
    let h5 = d.open(33, d.tag("details"), 1);
    let h6 = d.open(0, d.tag("div"), 1); d.attrTabIndexN(h6, 1); d.text("h"); d.close();
    d.close();
    if ORD_MODAL {
        let m = d.open(9, d.tag("dialog"), 1);
        d.attrOverlay(m, dom.OV_MODAL);
        ORD[0] = d.open(0, d.tag("div"), 1); d.attrTabIndexN(ORD[0], 0); d.text("m0"); d.close();
        ORD[1] = d.open(1, d.tag("div"), 1); d.attrTabIndexN(ORD[1], 2); d.text("m1"); d.close();
        ORD[2] = d.open(2, d.tag("div"), 1); d.attrTabIndexN(ORD[2], 1); d.text("m2"); d.close();
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn ordTab(d: &Dom, keys: string) {
    d.simKeys("", keys);
    ordFrame(d);
    ordFrame(d);
}

fn ordTest(mem: &Arena, css: &Css) {
    ORD_V = [3, 1, 2, 0, 0, -1, 1, 0];
    ORD_DIS = true;
    ORD_MODAL = false;
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    ordFrame(&d);
    ordFrame(&d);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab from nothing starts at the lowest tabindex");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[2], "then 2");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[0], "then 3");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[3], "then tabindex 0 in tree order");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "and the next 0 (-1 is skipped)");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[7], "a disabled tabindex=1 is skipped, the last 0 follows");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab wraps to the lowest tabindex");

    // Shift+Tab goes the other way and wraps to the end
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[7], "Shift+Tab from the first wraps to the last");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "back over the zeros");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[3], "and the first zero");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[0], "then the highest positive");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[2], "then 2");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[1], "then 1");

    // ties go in tree order; a dynamic change takes effect
    ORD_DIS = false;
    ORD_V[4] = 1;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[1]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "a tabindex changed to 1 ties with the other 1 in tree order");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[6], "disabled gone: the third 1 (tree order)");
    ORD_V[4] = 0;
    ordFrame(&d); ordFrame(&d);

    // inside a modal the order is computed within the dialog
    ORD_MODAL = true;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[2]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "in a modal: 1 then 2");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[0], "then 0");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[2], "and wraps inside the dialog");
    ORD_MODAL = false;

    ordFrame(&d); ordFrame(&d);
    // the starting point: a focused tabindex=-1 element (between the zeros) goes on to the next one after it, either way
    d.focusNode(ORD[5]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[7], "Tab from a tabindex=-1 element goes to the next after it in tree order");
    d.focusNode(ORD[5]);
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "Shift+Tab goes to the one before it");
    ok(d.focusVisible(), "a Tab-focused div with a tabindex shows :focus-visible");
    // a removed focus: Tab starts again at the first, Shift+Tab at the last
    d.focusNode(ORD[7]);
    ORD_NO7 = true;
    ordFrame(&d); ordFrame(&d);
    ok(d.focused() < 0, "the focused node is gone");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[1], "Tab after a removed focus starts at the first");
    d.focusNode(-1);
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "Shift+Tab with no focus starts at the last");

    // a focus-group trap keeps Tab inside it
    ORD_TRAP = true;
    ordFrame(&d); ordFrame(&d);
    d.focusNode(ORD[3]);
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[4], "Tab inside a trap");
    ordTab(&d, "Tab");
    ok(d.focused() == ORD[3], "wraps inside the trap");
    ordTab(&d, "S+Tab");
    ok(d.focused() == ORD[4], "and back");
    ORD_TRAP = false;
    ORD_NO7 = false;
}

fn quietFrame(d: &Dom, f: int) {
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    d.open(0, d.tag("div"), 1);
    let sp = d.open(0, d.tag("div"), 1);
    d.attrLive(sp, "polite");
    d.attrSelected(sp, f % 2 == 0);
    d.text(if f % 2 == 0 { "one" } else { "two" });
    d.close();
    let b = d.open(1, d.tag("button"), 1);
    d.attrAria(b, if f % 2 == 0 { "A" } else { "B" });
    d.close();
    if f % 3 == 0 {
        let x = d.open(2, d.tag("button"), 1);
        d.text("extra");
        d.close();
    }
    let c = d.open(3, d.tag("input"), 1);
    d.attrType(c, "checkbox");
    d.attrChecked(c, f % 2 == 0);
    d.close();
    let t = d.open(4, d.tag("input"), 1);
    d.attrType(t, "text");
    d.attrText(t, if f % 2 == 0 { "x" } else { "yy" });
    d.close();
    let r = d.open(5, d.tag("input"), 1);
    d.attrType(r, "range");
    d.attrValue(r, f2(f % 7));
    d.close();
    let dt = d.open(6, d.tag("details"), 1);
    d.attrOpen(dt, f % 4 < 2);
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    d.focusNode(if f % 2 == 0 { b } else { -1 });
}

fn f2(n: int): f32 {
    return f32(n);
}

/// Never enabled: all the hooks fire (text, checked, value, focus, children, live) and nothing is stored.
fn quietTest(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..10000 {
        quietFrame(&d, f);
    }
    ok(d.aevTotal == 0 && d.aev.len == 0 && d.lq.len == 0, "disabled: nothing is queued");
    ok(d.aev.items.len == 0 && d.lq.items.len == 0, "disabled: no queue storage was ever allocated");
    ok(a11y.events(&d, mem).len == 0 && a11y.liveChanges(&d, mem).len == 0, "disabled: nothing to drain");
    // enabled, the same frames fill and are bounded
    a11y.enable(&d);
    for f in 0..50 {
        quietFrame(&d, f);
    }
    ok(d.aevTotal > 0 && d.aev.len <= 256, "enabled: events queue, bounded at 256");
    ok(d.lq.len <= 1, "enabled: a live region is queued once");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    STATE = St {};
    IDS = Ids {};
    a11y.enable(&d);
    frame(&d);
    frame(&d);
    let ev0 = a11y.events(&d, &mem);
    let lv0 = a11y.liveChanges(&d, &mem);
    ok(lv0.len == 0, "a live region's first content is not announced");

    // ---- idle frames: no events, no live changes, nothing counted
    let total = d.aevTotal;
    for i in 0..5 {
        frame(&d);
    }
    ok(d.aevTotal == total && d.aev.len == 0 && d.lq.len == 0, "idle frames queue nothing");
    ok(a11y.events(&d, &mem).len == 0 && a11y.liveChanges(&d, &mem).len == 0, "idle frames: events and liveChanges are empty");

    // ---- stable ids: a handle survives frames, a freed node's handle goes stale even when its id is reused
    let h = d.handle(IDS.btn);
    ok(h >= dom.HANDLE_UNIT, "an AT id is a handle");
    ok(same(nm(&d, &mem, h), "Save"), "name by handle");
    ok(same(a11y.role(&d, h), "button") && a11y.actions(&d, h) == 3, "role and actions by handle");
    STATE.withBtn = false;
    frame(&d);
    ok(!d.alive(h), "the removed node's handle is gone");
    ok(a11y.name(&d, &mem, h).len == 0 && a11y.role(&d, h).len == 0 && a11y.actions(&d, h) == 0, "a stale handle answers nothing");
    ok(!a11y.perform(&d, h, a11y.A_CLICK, 0.0, ""), "a stale handle performs nothing");
    let ev = a11y.events(&d, &mem);
    let kids = false;
    for i in 0..ev.len {
        if ev.items[i].kind == a11y.EV_CHILDREN {
            kids = true;
        }
    }
    ok(kids, "removing a child queues a children-changed event");
    STATE.withBtn = true;
    frame(&d);
    ok(d.handle(IDS.btn) != h, "a recycled id has a new handle");
    ok(!d.alive(h), "and the old handle stays stale");
    a11y.events(&d, &mem);

    // ---- bounds
    let b = a11y.bounds(&d, IDS.btn);
    ok(b.ok && b.w == d.size(IDS.btn).x && b.h == d.size(IDS.btn).y, "bounds size");
    ok(b.x == d.absX(IDS.btn) && b.y == d.absY(IDS.btn), "bounds origin");
    let m = a11y.bounds(&d, IDS.mv);
    ok(m.ok && m.x == d.absX(IDS.mv) + 30.0 && m.y == d.absY(IDS.mv) && m.w == d.size(IDS.mv).x, "a transform moves the bounds");
    ok(!a11y.bounds(&d, h).ok, "a stale handle has no bounds");

    // ---- aria-selected / expanded on details / describedby
    let s = Text.new(&mem);
    a11y.dump(&d, &mem, &s);
    let dump = s.str();
    ok(contains(dump, "tab \"General\" selected=false"), "aria-selected false");
    ok(contains(dump, "group \"\" expanded=false") || contains(dump, "expanded=false"), "details has expanded of its own");
    ok(contains(dump, "desc=\"At least 8 characters\""), "describedby is resolved by id");
    ok(contains(dump, "live=polite") && contains(dump, "live=assertive"), "aria-live shows");
    ok(same(a11y.describedBy(&d, &mem, IDS.inp), "At least 8 characters"), "describedBy text");
    STATE.selTab = true;
    STATE.open = true;
    frame(&d);
    let ev2 = a11y.events(&d, &mem);
    let sawSel = false;
    let sawExp = false;
    for i in 0..ev2.len {
        if ev2.items[i].kind == a11y.EV_SELECTED && ev2.items[i].h == d.handle(IDS.tab) { sawSel = true; }
        if ev2.items[i].kind == a11y.EV_EXPANDED && ev2.items[i].h == d.handle(IDS.det) { sawExp = true; }
    }
    ok(sawSel && sawExp, "selected and expanded changes are events");
    let s2 = Text.new(&mem);
    a11y.dump(&d, &mem, &s2);
    ok(contains(s2.str(), "tab \"General\" selected\n") || contains(s2.str(), "tab \"General\" selected "), "aria-selected true");
    ok(contains(s2.str(), "expanded=true"), "details open is expanded");

    // ---- names for gauges and label correctness
    ok(same(nm(&d, &mem, IDS.prog), "Loading"), "progress named by its wrapping label");
    ok(same(nm(&d, &mem, IDS.meter), "Fuel"), "meter named by label for");
    ok(same(nm(&d, &mem, IDS.ctlA), "Alpha"), "the control a label points at takes its text");
    ok(nm(&d, &mem, IDS.wrapB).len == 0, "a control inside a label that is for another control does not take its name");
    ok(contains(dump, "text \"Alpha\""), "that label's text is still read");

    // ---- text interface
    let ti = TextInfo { value: "", caret: 0, selLo: 0, selHi: 0 };
    ok(a11y.perform(&d, IDS.tb, a11y.A_SET, 0.0, "hello world"), "set a text box");
    frame(&d);
    ok(a11y.text(&d, IDS.tb, &ti) && same(ti.value, "hello world"), "text value");
    let e = &d.eds.items[d.claim(IDS.tb)];
    e.anc = 1;
    e.cur = 4;
    ok(a11y.text(&d, IDS.tb, &ti) && ti.caret == 4 && ti.selLo == 1 && ti.selHi == 4, "caret and selection");
    ok(!a11y.text(&d, IDS.pw, &ti), "a password's text is refused");
    ok(!a11y.text(&d, IDS.cb, &ti), "a checkbox has no text interface");
    a11y.events(&d, &mem);

    // ---- events from state changes, focus; keyboard focus ring
    STATE.checked = true;
    frame(&d);
    let ev3 = a11y.events(&d, &mem);
    let sawChk = false;
    for i in 0..ev3.len {
        if ev3.items[i].kind == a11y.EV_CHECKED && ev3.items[i].h == d.handle(IDS.cb) { sawChk = true; }
    }
    ok(sawChk, "checked change is an event");
    ok(a11y.perform(&d, d.handle(IDS.btn), a11y.A_FOCUS, 0.0, ""), "focus by handle");
    ok(d.focusVisible(), "a screen-reader focus shows the focus ring");
    let ev4 = a11y.events(&d, &mem);
    let sawFocus = false;
    for i in 0..ev4.len {
        if ev4.items[i].kind == a11y.EV_FOCUS && ev4.items[i].h == d.handle(IDS.btn) { sawFocus = true; }
    }
    ok(sawFocus, "focus change is an event");
    // a value set through AT: one event, none after it
    frame(&d);
    a11y.events(&d, &mem);
    let t2 = d.aevTotal;
    frame(&d);
    frame(&d);
    ok(d.aevTotal == t2, "no events once things settle");

    // ---- live regions: polite vs assertive, each once, in order
    a11y.liveChanges(&d, &mem);
    STATE.msg = "saved";
    frame(&d);
    let l = a11y.liveChanges(&d, &mem);
    ok(l.len == 1 && same(l.items[0].text, "saved") && !l.items[0].assertive, "a polite live change");
    ok(l.items[0].h == d.handle(IDS.live), "live change names the region");
    STATE.msg = "saved again";
    STATE.alert = "error!";
    frame(&d);
    let l2 = a11y.liveChanges(&d, &mem);
    ok(l2.len == 2 && !l2.items[0].assertive && l2.items[1].assertive && same(l2.items[1].text, "error!"), "polite then assertive");
    frame(&d);
    ok(a11y.liveChanges(&d, &mem).len == 0, "drained once");

    // ---- wake hook: an AT thread posts, the idle loop sees it
    ok(!d.wantsFrame(), "idle: no frame wanted");
    let ib = a11y.inbox(&mem, &d, 4);
    ok(a11y.post(ib, d.handle(IDS.tb), a11y.A_SET, 0.0, "from AT"), "post");
    ok(d.wantsFrame(), "a post asks for a frame");
    ok(!d.wantsFrame(), "and it is consumed");
    ok(a11y.drain(ib, &mem) == 1, "drain runs it");
    frame(&d);
    ok(a11y.text(&d, IDS.tb, &ti) && same(ti.value, "from AT"), "the posted action ran");
    ok(a11y.drain(ib, &mem) == 0, "nothing left");

    // ---- visibility: hidden leaves the tree
    ok(!contains(dump, "Ghostly"), "visibility: hidden is left out of the tree");

    // ---- document language
    i18n.setLocale("de");
    ok(same(a11y.language(), "de"), "the locale is the document language");
    i18n.setLocale("");

    // ---- tabindex=-1: focusable by code, skipped by Tab
    tabTest(&mem, &css);
    ordTest(&mem, &css);

    // ---- disabled: no events, no storage, over 10k changing frames
    quietTest(&mem, &css);

    printLn(`a11y_gaps_test ok, checks passed: {CHECKS}`);
}
