// Tests for scrolling and overlays: j3.ui.scroll and j3.ui.scrollbar math, j3.ui.toast slots, and the whole path
// through j3.ui.dom + j3.ui.inputs + j3.ui.overlays with synthetic mouse, wheel, right button and keys: wheel
// scrolling on both axes, chaining and `overscroll-behavior`, inertia, thumb drag and track paging, content that
// shrinks under the offset, a long list's cost, modal dialogs (input block, focus in/out, Tab trap, Escape),
// popovers (light dismiss, trigger press, Escape only on the top one), `position: fixed`, `left`/`top`, flip and
// edge clamp, a modal and a popover owner that go away while open, resize, context click, `title` tooltips, and the
// `<select>` list as real nodes (open/close, `.selected`, keys, themed shadow and max-height, 5000 options, cost).
// Run from the repo root, headless (SDL_ttf measures text; no window opens):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/overlay_test.j3
// Panics on the first failed check.

module overlay_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.{ Css, P_BACKGROUND, P_BOX_SHADOW, P_FONT_SIZE, V_SHADOW };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.dropdown;
use j3.ui.colorpick;
use j3.ui.inputs;
use j3.ui.overlays;
use j3.ui.popup;
use j3.ui.scroll;
use j3.ui.scrollbar;
use j3.ui.scrollbar.Bars;
use j3.ui.toast.Toasts;
use j3.ui.uastyle;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > tol {
        printLn(`{msg}: {a} vs {b}`);
    }
    ok(d <= tol, msg);
}

// ---- pure math ---------------------------------------------------------------------------------------

fn testMath() {
    near(scroll.clampOff(10.0, 100.0, 50.0), 50.0, 0.001, "clamp above");
    near(scroll.clampOff(10.0, -100.0, 50.0), 0.0, 0.001, "clamp below");
    ok(scroll.canMove(0.0, 50.0, 1.0) && !scroll.canMove(0.0, 50.0, -1.0), "at the start only forward moves");
    ok(!scroll.canMove(50.0, 50.0, 1.0) && scroll.canMove(50.0, 50.0, -1.0), "at the end only back moves");
    // inertia: a notch coasts about NOTCH px in total and then stops
    let v = scroll.kick(0.0, 1.0);
    let total: f32 = 0.0;
    for i in 0..200 {
        let nv: f32 = 0.0;
        total += scroll.coast(v, 16.0, &nv);
        v = nv;
    }
    near(total, scroll.NOTCH, 1.0, "one notch of inertia travels one notch");
    ok(v == 0.0, "and the speed reaches zero");
    // bars: thumb size and position, and the inverse
    let th = scrollbar.thumb(100.0, 100.0, 400.0, 0.0, 300.0);
    near(th.len, 25.0, 0.01, "thumb is the view's share of the track");
    near(th.pos, 0.0, 0.01, "thumb at the top");
    let th2 = scrollbar.thumb(100.0, 100.0, 400.0, 300.0, 300.0);
    near(th2.pos, 75.0, 0.01, "thumb at the end");
    let tiny = scrollbar.thumb(100.0, 100.0, 100000.0, 0.0, 99900.0);
    near(tiny.len, 24.0, 0.01, "thumb keeps a grab size");
    near(scrollbar.offsetFor(100.0, 100.0, 400.0, 300.0, 37.5), 150.0, 0.01, "offsetFor inverts thumb");
    near(scrollbar.offsetFor(100.0, 100.0, 400.0, 300.0, 500.0), 300.0, 0.01, "offsetFor clamps");
    let b = Bars { w: 200.0, h: 100.0, t: 10.0, showX: true, showY: true, offX: 0.0, maxX: 100.0, contX: 300.0, offY: 0.0, maxY: 300.0, contY: 400.0 };
    ok(scrollbar.hit(&b, 195.0, 5.0) == scrollbar.Y_THUMB, "hit y thumb");
    ok(scrollbar.hit(&b, 195.0, 80.0) == scrollbar.Y_TRACK, "hit y track");
    ok(scrollbar.hit(&b, 20.0, 95.0) == scrollbar.X_THUMB, "hit x thumb");
    ok(scrollbar.hit(&b, 150.0, 95.0) == scrollbar.X_TRACK, "hit x track");
    ok(scrollbar.hit(&b, 50.0, 50.0) == scrollbar.NONE, "no hit in the content");
    b.t = 0.0;
    b.showX = false;
    b.showY = false;
    ok(scrollbar.hit(&b, 195.0, 5.0) == scrollbar.NONE, "no bar when hidden");
}

fn testToast(mem: &Arena) {
    let t = Toasts.new();
    ok(t.count() == 0 && !t.live(0), "empty");
    let a = t.push("one", 1, 1000.0, 0.0);
    let b = t.push("two", 2, 1000.0, 100.0);
    ok(a == 0 && b == 1 && t.count() == 2, "slots fill in order");
    ok(same(t.text(0), "one") && same(t.text(1), "two") && t.kind(1) == 2, "text and kind are kept");
    t.tick(1050.0);
    ok(!t.live(0) && t.live(1), "the first expires first");
    let c = t.push("three", 0, 1000.0, 1060.0);
    ok(c == 0 && same(t.text(1), "two"), "a freed slot is reused and the other keeps its place");
    let u = Toasts.new();
    for i in 0..6 {
        u.push("fill", 0, 5000.0, f32(10 + i));
    }
    ok(u.count() == 6, "never more than the slots");
    let oldest = u.push("new", 0, 5000.0, 2000.0);
    ok(oldest == 0 && same(u.text(0), "new"), "with none free the longest-up one is replaced");
    u.dismiss(2);
    ok(!u.live(2) && u.count() == 5, "dismiss closes one");
    let long = u.push("0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789", 0, 10.0, 0.0);
    let lt = u.text(long);
    ok(lt.len == 127, "long text is cut");
}

// ---- the tree ------------------------------------------------------------------------------------------

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button, input, dialog { font-family: \"T\"; font-size: 14px; } .page { display: flex; flex-direction: column; gap: 4px; } .list { height: 100px; width: 200px; overflow-y: auto; } .smooth { scroll-behavior: smooth; } .row { height: 20px; } .strip { display: flex; width: 100px; height: 40px; overflow-x: auto; } .cell { width: 60px; min-width: 60px; height: 20px; } .outer { height: 80px; width: 200px; overflow-y: auto; } .inner { height: 40px; overflow-y: auto; } .contain { overscroll-behavior: contain; } .pad { height: 30px; } .anchor { position: relative; width: 90px; height: 20px; } .menu { position: absolute; left: 0; top: 100%; width: 80px; height: 60px; background: #333333; } .btn { width: 60px; height: 24px; } .fx { position: fixed; width: 80px; height: 40px; z-index: 5; } .flip { position: fixed; width: 80px; height: 40px; position-try-fallbacks: flip-both; } dialog { width: 200px; height: 100px; } .tb { width: 100px; height: 20px; }";

#[singleton]
let ROWS: int;
#[singleton]
let SHOW_MODAL: bool;
#[singleton]
let SHOW_POP: bool;
#[singleton]
let SHOW_CTX: bool;
#[singleton]
let SHOW_FX: bool;
#[singleton]
let SHOW_INNER_POP: bool;
#[singleton]
let CLOSE_MODAL: int;
#[singleton]
let CLOSE_POP: int;
#[singleton]
let CLOSE_CTX: int;
#[singleton]
let CLOSE_INNER: int;
#[singleton]
let PAGE_CLICKS: int;
#[singleton]
let CTX: int;
#[singleton]
let VW: f32;
#[singleton]
let VH: f32;
#[singleton]
let SMOOTH: bool;
#[singleton]
let CTX_X: f32;
#[singleton]
let CTX_Y: f32;

struct Ids {
    list: int;
    strip: int;
    outer: int;
    inner: int;
    outer2: int;
    inner2: int;
    open: int;
    trig: int;
    anchor: int;
    menu: int;
    modal: int;
    tb: int;
    ok: int;
    cancel: int;
    ctx: int;
    fx: int;
    titled: int;
    inpop: int;
    pad: int;
    plain: int;
}

#[singleton]
let IDS: Ids;

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: VW, y: VH });
    inputs.begin(d);
    let ids = Ids { list: -1, strip: -1, outer: -1, inner: -1, outer2: -1, inner2: -1, open: -1, trig: -1, anchor: -1, menu: -1, modal: -1, tb: -1, ok: -1, cancel: -1, ctx: -1, fx: -1, titled: -1, inpop: -1, pad: -1, plain: -1 };
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    ids.list = d.open(0, d.tag("div"), 1);
    d.cls(ids.list, "list");
    if SMOOTH {
        d.cls(ids.list, "smooth");
    }
    for i in 0..ROWS {
        let r1 = d.open(i, d.tag("div"), 1);
        d.cls(r1, "row");
        d.close();
    }
    d.close();
    ids.strip = d.open(1, d.tag("div"), 1);
    d.cls(ids.strip, "strip");
    for j in 0..6 {
        let c1 = d.open(j, d.tag("div"), 1);
        d.cls(c1, "cell");
        d.close();
    }
    d.close();
    ids.outer = d.open(2, d.tag("div"), 1);
    d.cls(ids.outer, "outer");
    ids.inner = d.open(0, d.tag("div"), 1);
    d.cls(ids.inner, "inner");
    for k in 0..6 {
        let c2 = d.open(k, d.tag("div"), 1);
        d.cls(c2, "row");
        d.close();
    }
    d.close();
    for m in 0..6 {
        let c3 = d.open(1 + m, d.tag("div"), 1);
        d.cls(c3, "row");
        d.close();
    }
    d.close();
    ids.outer2 = d.open(3, d.tag("div"), 1);
    d.cls(ids.outer2, "outer");
    ids.inner2 = d.open(0, d.tag("div"), 1);
    d.cls(ids.inner2, "inner");
    d.cls(ids.inner2, "contain");
    for k2 in 0..6 {
        let c4 = d.open(k2, d.tag("div"), 1);
        d.cls(c4, "row");
        d.close();
    }
    d.close();
    for m2 in 0..6 {
        let c5 = d.open(1 + m2, d.tag("div"), 1);
        d.cls(c5, "row");
        d.close();
    }
    d.close();
    ids.open = d.open(4, d.tag("button"), 1);
    d.cls(ids.open, "btn");
    if d.clicked(ids.open) {
        SHOW_MODAL = true;
    }
    d.attrTitle(ids.open, "Open it");
    d.close();
    ids.anchor = d.open(5, d.tag("div"), 1);
    d.cls(ids.anchor, "anchor");
    ids.trig = d.open(0, d.tag("button"), 1);
    d.cls(ids.trig, "btn");
    if d.clicked(ids.trig) {
        PAGE_CLICKS += 1;
        SHOW_POP = !SHOW_POP;
    }
    d.close();
    if SHOW_POP {
        ids.menu = d.open(1, d.tag("div"), 1);
        d.cls(ids.menu, "menu");
        d.attrOverlay(ids.menu, dom.OV_POPOVER);
        if d.closeRequested(ids.menu) {
            CLOSE_POP += 1;
            SHOW_POP = false;
        }
        d.close();
    }
    d.close();
    ids.ctx = d.open(6, d.tag("div"), 1);
    d.cls(ids.ctx, "pad");
    if d.contextAt(ids.ctx) {
        CTX += 1;
        SHOW_CTX = true;
        let mp = d.mouseAt();
        CTX_X = mp.x;
        CTX_Y = mp.y;
    }
    d.close();
    ids.pad = ids.ctx;
    if SHOW_CTX {
        ids.fx = d.open(7, d.tag("div"), 1);
        d.cls(ids.fx, "flip");
        d.attrOverlay(ids.fx, dom.OV_POPOVER);
        d.attrLeft(ids.fx, CTX_X);
        d.attrTop(ids.fx, CTX_Y);
        if d.closeRequested(ids.fx) {
            CLOSE_CTX += 1;
            SHOW_CTX = false;
        }
        d.close();
    }
    if SHOW_FX {
        ids.plain = d.open(8, d.tag("div"), 1);
        d.cls(ids.plain, "fx");
        d.attrLeft(ids.plain, 590.0);
        d.attrTop(ids.plain, 390.0);
        d.close();
    }
    d.close();
    if SHOW_MODAL {
        ids.modal = d.open(1, d.tag("dialog"), 1);
        d.attrOverlay(ids.modal, dom.OV_MODAL);
        if d.closeRequested(ids.modal) {
            CLOSE_MODAL += 1;
            SHOW_MODAL = false;
        }
        ids.tb = d.open(0, d.tag("input"), 1);
        d.cls(ids.tb, "tb");
        d.attrType(ids.tb, "text");
        d.close();
        ids.ok = d.open(1, d.tag("button"), 1);
        d.cls(ids.ok, "btn");
        d.close();
        ids.cancel = d.open(2, d.tag("button"), 1);
        d.cls(ids.cancel, "btn");
        d.close();
        if SHOW_INNER_POP {
            ids.inpop = d.open(3, d.tag("div"), 1);
            d.cls(ids.inpop, "menu");
            d.attrOverlay(ids.inpop, dom.OV_POPOVER);
            if d.closeRequested(ids.inpop) {
                CLOSE_INNER += 1;
                SHOW_INNER_POP = false;
            }
            d.close();
        }
        d.close();
    }
    d.close();
    IDS = ids;
    d.layout();
    d.endFrame();
}

fn fresh(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    ROWS = 30;
    SHOW_MODAL = false;
    SHOW_POP = false;
    SHOW_CTX = false;
    SHOW_FX = false;
    SHOW_INNER_POP = false;
    CLOSE_MODAL = 0;
    CLOSE_POP = 0;
    CLOSE_CTX = 0;
    CLOSE_INNER = 0;
    PAGE_CLICKS = 0;
    CTX = 0;
    VW = 600.0;
    VH = 400.0;
    SMOOTH = false;
    frame(&d);
    frame(&d);
    return d;
}

fn cx(d: &Dom, id: int): f32 {
    return d.absX(id) + d.nodes.items[id].w / 2.0;
}

fn cy(d: &Dom, id: int): f32 {
    return d.absY(id) + d.nodes.items[id].h / 2.0;
}

fn at(d: &Dom, id: int) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0);
    frame(d);
}

fn click(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    frame(d);
    d.simInput(x, y, true, 0.0);
    frame(d);
    d.simInput(x, y, false, 0.0);
    frame(d);
}

fn clickOn(d: &Dom, id: int) {
    click(d, cx(d, id), cy(d, id));
}

/// `notches` forward (positive scrolls down) over the middle of `id`.
fn wheel(d: &Dom, id: int, notches: f32) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0 - notches);
    frame(d);
}

fn key(d: &Dom, names: string) {
    d.simKeys("", names);
    frame(d);
}

// ---- scrolling -------------------------------------------------------------------------------------------

fn testScroll(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let l = IDS.list;
    near(d.nodes.items[l].scrollMax, f32(30 * 20 - 100), 0.01, "scroll range is content minus view");
    wheel(&d, l, 2.0);
    near(d.nodes.items[l].scrollY, 96.0, 0.01, "two notches scroll 96 px");
    wheel(&d, l, -1.0);
    near(d.nodes.items[l].scrollY, 48.0, 0.01, "and one back");
    wheel(&d, l, 1000.0);
    near(d.nodes.items[l].scrollY, d.nodes.items[l].scrollMax, 0.01, "the end clamps");
    // the content shrinks under the offset
    ROWS = 10;
    frame(&d);
    near(d.nodes.items[l].scrollY, 100.0, 0.01, "fewer rows pull the offset back");
    ROWS = 3;
    frame(&d);
    near(d.nodes.items[l].scrollY, 0.0, 0.01, "content that fits has no offset");
    ok(d.nodes.items[l].scrollMax == 0.0, "and no range");
    ROWS = 30;
    frame(&d);
    // horizontal: Shift + wheel
    let s = IDS.strip;
    near(d.nodes.items[s].scrollMaxX, f32(6 * 60 - 100), 0.5, "horizontal range from the content width");
    d.simInput(cx(&d, s), cy(&d, s), false, -1.0);
    d.simKeys("", "Shift");
    frame(&d);
    near(d.nodes.items[s].scrollX, 48.0, 0.01, "Shift + wheel scrolls sideways");
    near(d.nodes.items[s].scrollY, 0.0, 0.01, "and not down");
    // a box with only an x axis takes the plain wheel
    wheel(&d, s, 1.0);
    near(d.nodes.items[s].scrollX, 96.0, 0.01, "a horizontal-only box takes the plain wheel");
    near(d.absX(IDS.strip + 2) - d.absX(IDS.strip), f32(60 - 96), 0.5, "children move with the offset");
    // chaining
    let o = IDS.outer;
    let i = IDS.inner;
    near(d.nodes.items[i].scrollMax, f32(6 * 20 - 40), 0.01, "inner range");
    wheel(&d, i, 5.0);
    near(d.nodes.items[i].scrollY, 80.0, 0.01, "the inner box scrolls first");
    near(d.nodes.items[o].scrollY, 0.0, 0.01, "the outer waits");
    wheel(&d, i, 1.0);
    ok(d.nodes.items[o].scrollY > 0.0, "at its end the wheel goes to the outer box");
    let i2 = IDS.inner2;
    let o2 = IDS.outer2;
    wheel(&d, i2, 5.0);
    wheel(&d, i2, 3.0);
    near(d.nodes.items[o2].scrollY, 0.0, 0.01, "overscroll-behavior: contain keeps the wheel in the inner box");
}

fn testInertia(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    SMOOTH = true;
    frame(&d);
    let l = IDS.list;
    wheel(&d, l, 3.0);
    ok(d.nodes.items[l].scrollY < 96.0, "smooth: the first frame has not arrived yet");
    ok(d.coasting > 0, "and the box is coasting");
    let prev: f32 = d.nodes.items[l].scrollY;
    let mono = true;
    for k in 0..90 {
        frame(&d);
        if d.nodes.items[l].scrollY < prev {
            mono = false;
        }
        prev = d.nodes.items[l].scrollY;
    }
    ok(mono, "it only moves forward");
    near(d.nodes.items[l].scrollY, 144.0, 1.5, "three notches travel 144 px in total");
    ok(d.coasting == 0, "and then the box rests");
    // coasting into the end stops there
    wheel(&d, l, 40.0);
    for k2 in 0..200 {
        frame(&d);
    }
    near(d.nodes.items[l].scrollY, d.nodes.items[l].scrollMax, 0.01, "inertia stops at the end");
    ok(d.nodes.items[l].velY == 0.0, "with no speed left");
}

fn testBars(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let l = IDS.list;
    let n = &d.nodes.items[l];
    let bars = dom.barsOf(&d, l);
    ok(bars.showY && !bars.showX, "an overflowing auto box shows a y bar");
    let ty = scrollbar.trackY(&bars);
    let th = scrollbar.thumb(ty, bars.h, bars.contY, 0.0, bars.maxY);
    let x = d.absX(l) + bars.w - 5.0;
    let y0 = d.absY(l) + 2.0 + th.pos + th.len / 2.0;
    // hovering the bar targets the box, not a row under it
    d.simInput(x, y0, false, 0.0);
    frame(&d);
    ok(d.hover == l && d.barOf == l, "the bar sits above the rows");
    // drag the thumb by a third of the free track
    d.simInput(x, y0, true, 0.0);
    frame(&d);
    ok(d.barNode == l, "pressing the thumb starts a drag");
    let free = ty - th.len;
    d.simInput(x, y0 + free / 3.0, true, 0.0);
    frame(&d);
    near(d.nodes.items[l].scrollY, bars.maxY / 3.0, 3.0, "dragging a third of the track scrolls a third");
    d.simInput(x, y0 + free * 5.0, true, 0.0);
    frame(&d);
    near(d.nodes.items[l].scrollY, bars.maxY, 0.5, "dragging past the end clamps");
    d.simInput(x, y0 + free * 5.0, false, 0.0);
    frame(&d);
    ok(d.barNode == -1 && PAGE_CLICKS == 0, "release ends the drag without a click");
    // a press on the track pages toward it
    d.nodes.items[l].scrollY = 0.0;
    frame(&d);
    click(&d, x, d.absY(l) + 90.0);
    near(d.nodes.items[l].scrollY, 90.0, 1.0, "a press on the track below the thumb pages down 90% of the view");
    let none = fresh(mem, css);
    ok(none.nodes.items[IDS.strip].scrollX == 0.0, "a fresh box starts at 0");
}

fn testLongList(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    ROWS = 4000;
    frame(&d);
    frame(&d);
    let l = IDS.list;
    near(d.nodes.items[l].scrollMax, f32(4000 * 20 - 100), 0.5, "a long list has its range");
    d.nodes.items[l].scrollY = 40000.0;
    frame(&d);
    let mid = 2500;
    // the row under the pointer is the right one even deep in the list
    d.simInput(cx(&d, l), d.absY(l) + 50.0, false, 0.0);
    frame(&d);
    let row = d.hover;
    ok(row >= 0 && d.nodes.items[row].parent == l, "hit testing finds a row of the long list");
    near(d.nodes.items[row].y, f32(40040), 21.0, "and it is the one at that offset");
    ok(d.laid > 0, "layout ran");
    // cost of a steady frame (build + layout + input, nothing changing) and of a scrolling one
    let t0 = micros();
    for k in 0..50 {
        frame(&d);
    }
    let steady = (micros() - t0) / 50;
    let t1 = micros();
    for k2 in 0..50 {
        d.simInput(cx(&d, l), cy(&d, l), false, -1.0);
        frame(&d);
    }
    let scrolling = (micros() - t1) / 50;
    printLn(`4000-row list, steady frame: {steady} us, scrolling frame: {scrolling} us   [dev build, no paint]`);
}

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

// ---- overlays --------------------------------------------------------------------------------------------

fn testModal(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    clickOn(&d, IDS.open);
    ok(SHOW_MODAL && d.ovs.len == 1, "the open button shows the dialog and it joins the stack");
    ok(d.nodes.items[IDS.modal].isFixed, "a dialog is placed in the viewport");
    near(d.nodes.items[IDS.modal].x, 200.0, 0.5, "and centered across");
    near(d.nodes.items[IDS.modal].y, 150.0, 0.5, "and down");
    frame(&d);
    ok(d.focused() == IDS.tb, "focus moves into the dialog");
    // the page behind takes no click
    let before = PAGE_CLICKS;
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before, "a click on the page behind a modal does nothing");
    ok(CLOSE_MODAL == 0, "and a modal does not close on an outside press");
    // Tab stays inside
    key(&d, "Tab");
    ok(d.focused() == IDS.ok, "Tab goes to the next control in the dialog");
    key(&d, "Tab");
    ok(d.focused() == IDS.cancel, "and the next");
    key(&d, "Tab");
    ok(d.focused() == IDS.tb, "then wraps inside the dialog");
    key(&d, "S+Tab");
    ok(d.focused() == IDS.cancel, "Shift+Tab wraps backwards inside it");
    // hover under the dim is none
    d.simInput(cx(&d, IDS.trig), cy(&d, IDS.trig), false, 0.0);
    frame(&d);
    ok(d.hover < 0, "nothing under the dim is hovered");
    // Escape closes only the top overlay
    SHOW_INNER_POP = true;
    frame(&d);
    ok(d.ovs.len == 2, "a popover over the modal is on top");
    key(&d, "Escape");
    ok(CLOSE_INNER == 1 && CLOSE_MODAL == 0, "Escape closes only the top layer");
    frame(&d);
    ok(d.ovs.len == 1, "that one has left the stack");
    key(&d, "Escape");
    ok(CLOSE_MODAL == 1 && !SHOW_MODAL, "the next Escape closes the dialog");
    frame(&d);
    ok(d.ovs.len == 0, "the stack is empty");
    ok(d.focused() == IDS.open, "focus goes back to the button that opened it");
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before + 1, "the page takes clicks again");
}

fn testBackdropAndRemoval(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    clickOn(&d, IDS.open);
    frame(&d);
    // the dialog's owner is removed with the dialog open: no stale stack entry, no stuck modal
    SHOW_MODAL = false;
    frame(&d);
    frame(&d);
    ok(d.ovs.len == 0 && dom.modalIndex(&d) < 0, "removing the dialog frees its stack slot");
    let before = PAGE_CLICKS;
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before + 1, "and the page is live");
    // resize while a modal is open: it stays centered
    SHOW_MODAL = true;
    frame(&d);
    frame(&d);
    VW = 800.0;
    VH = 500.0;
    frame(&d);
    near(d.nodes.items[IDS.modal].x, 300.0, 0.5, "a resize recenters the modal across");
    near(d.nodes.items[IDS.modal].y, 200.0, 0.5, "and down");
    VW = 120.0;
    VH = 80.0;
    frame(&d);
    near(d.nodes.items[IDS.modal].x, 0.0, 0.01, "a window smaller than the dialog pins it to the top left");
    VW = 600.0;
    VH = 400.0;
    frame(&d);
    // the tree is rebuilt without the owner of a popover
    SHOW_MODAL = false;
    frame(&d);
    SHOW_POP = true;
    frame(&d);
    ok(d.ovs.len == 1, "a popover joins");
    SHOW_POP = false;
    frame(&d);
    frame(&d);
    ok(d.ovs.len == 0, "and leaves when its element goes");
}

fn testPopover(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    VH = 600.0;
    frame(&d);
    clickOn(&d, IDS.trig);
    ok(SHOW_POP && d.ovs.len == 1, "the trigger opens the popover");
    ok(d.nodes.items[IDS.menu].isFixed, "a popover is in viewport coordinates");
    near(d.nodes.items[IDS.menu].x, d.absX(IDS.anchor), 0.5, "below its anchor, left aligned");
    near(d.nodes.items[IDS.menu].y, d.absY(IDS.anchor) + 20.0, 0.5, "top: 100% is the anchor's height");
    // a press on the trigger belongs to the trigger: the toggle closes it, no dismissal first
    clickOn(&d, IDS.trig);
    ok(!SHOW_POP && CLOSE_POP == 0, "the trigger toggles it with no light dismiss");
    clickOn(&d, IDS.trig);
    ok(SHOW_POP, "open again");
    // a press elsewhere dismisses
    click(&d, 400.0, 300.0);
    ok(CLOSE_POP == 1 && !SHOW_POP, "a press outside asks it to close");
    // a press inside does not
    clickOn(&d, IDS.trig);
    ok(SHOW_POP, "open");
    click(&d, d.nodes.items[IDS.menu].x + 5.0, d.nodes.items[IDS.menu].y + 5.0);
    ok(SHOW_POP && CLOSE_POP == 1, "a press inside it keeps it open");
    key(&d, "Escape");
    ok(CLOSE_POP == 2 && !SHOW_POP, "Escape closes it");
    // a right press elsewhere dismisses too
    clickOn(&d, IDS.trig);
    d.simRight(true);
    d.simInput(500.0, 300.0, false, 0.0);
    frame(&d);
    d.simRight(false);
    frame(&d);
    ok(CLOSE_POP == 3, "a right press outside dismisses");
}

fn testPlacement(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    VH = 600.0;
    frame(&d);
    // right button on the pad: a context request with the pointer position
    let px = cx(&d, IDS.pad);
    let py = cy(&d, IDS.pad);
    d.simRight(true);
    d.simInput(px, py, false, 0.0);
    frame(&d);
    ok(CTX == 1 && SHOW_CTX, "a right press is a context request");
    d.simRight(false);
    frame(&d);
    let f = IDS.fx;
    near(d.nodes.items[f].x, px, 0.5, "the menu opens at the pointer");
    near(d.nodes.items[f].y, py, 0.5, "in x and y");
    // near the bottom right edge, flip-both puts it up and to the left of the pointer
    SHOW_CTX = false;
    VH = 400.0;
    frame(&d);
    CTX_X = 560.0;
    CTX_Y = 370.0;
    SHOW_CTX = true;
    frame(&d);
    frame(&d);
    near(d.nodes.items[IDS.fx].x, f32(480), 0.5, "past the right edge it flips to the left of the point");
    near(d.nodes.items[IDS.fx].y, f32(330), 0.5, "past the bottom edge it flips above the point");
    // clamp: a point past the edge keeps a popover on screen (no room to flip either way)
    VW = 70.0;
    VH = 30.0;
    frame(&d);
    ok(d.nodes.items[IDS.fx].x >= 0.0 && d.nodes.items[IDS.fx].y >= 0.0, "never off the top left");
    VW = 600.0;
    VH = 400.0;
    SHOW_CTX = false;
    frame(&d);
    // a position: fixed box ignores the ancestors' scroll and clip
    SHOW_FX = true;
    frame(&d);
    d.nodes.items[IDS.list].scrollY = 40.0;
    frame(&d);
        let fb = IDS.plain;
    ok(d.nodes.items[fb].isFixed, "a fixed box is in viewport coordinates");
    near(d.nodes.items[fb].x, 520.0, 0.01, "left=590 of an 80 px box is pulled back inside a 600 px window");
    near(d.nodes.items[fb].y, 360.0, 0.01, "and top=390 of a 40 px box inside 400");
}

fn testTooltip(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "no tooltip at first");
    for i in 0..20 {
        frame(&d);
    }
    ok(overlays.tipAlpha(&d) == 0.0, "and none before the delay");
    for k in 0..20 {
        frame(&d);
    }
    ok(overlays.tipAlpha(&d) > 0.0 && d.tipNode == IDS.open, "after 500 ms of rest the title shows");
    ok(same(d.tipOf(IDS.open), "Open it"), "with the title text");
    d.simInput(cx(&d, IDS.open) + 3.0, cy(&d, IDS.open), false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) > 0.0, "a small move keeps a tip that is showing");
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), true, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "a press hides it");
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), false, 0.0);
    frame(&d);
    d.simInput(300.0, 300.0, false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "moving off an element ends its tip");
}

// ---- menu keys, hover intent, themed tooltip --------------------------------------------------------------

const MSHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button { font-family: \"T\"; font-size: 14px; } .anchor { position: relative; width: 90px; height: 20px; } .menu { position: absolute; left: 0; top: 100%; width: 120px; } .item { height: 20px; } .host { position: relative; } .sub { display: none; position: absolute; left: 100%; top: 0; width: 80px; } .host:hover > .sub { display: block; } .btn { width: 60px; height: 20px; }";

#[singleton]
let MOPEN: bool;
#[singleton]
let MCLOSE: int;
#[singleton]
let MCLICK: int;
#[singleton]
let MI: [8]int;

// MI: 0 trigger, 1 a, 2 host b, 3 c (in sub), 4 d (in sub), 5 disabled e, 6 f, 7 sub
fn mitem(d: &Dom, slot: int, ix: int, tag: string, cls: string) {
    MI[ix] = d.open(slot, d.tag(tag), 1);
    d.cls(MI[ix], "item");
    if cls.len > 4 {
        d.cls(MI[ix], "host");
    }
    d.attrMenuItem(MI[ix]);
    if d.clicked(MI[ix]) {
        MCLICK = ix;
    }
}

fn mframe(d: &Dom) {
    d.beginFrame(Vec2 { x: 400.0, y: 300.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let anchor = d.open(0, d.tag("div"), 1);
    d.cls(anchor, "anchor");
    MI[0] = d.open(0, d.tag("button"), 1);
    d.cls(MI[0], "btn");
    d.close();
    if MOPEN {
        let menu = d.open(1, d.tag("div"), 1);
        d.cls(menu, "menu");
        d.attrOverlay(menu, dom.OV_POPOVER);
        if d.closeRequested(menu) {
            MCLOSE += 1;
            MOPEN = false;
        }
        mitem(d, 0, 1, "div", "item");
        d.close();
        mitem(d, 1, 2, "div", "item host");
        MI[7] = d.open(0, d.tag("div"), 1);
        d.cls(MI[7], "sub");
        mitem(d, 0, 3, "div", "item");
        d.close();
        mitem(d, 1, 4, "div", "item");
        d.close();
        d.close();
        d.close();
        mitem(d, 2, 5, "button", "item");
        d.attrDisabled(MI[5], true);
        d.close();
        mitem(d, 3, 6, "div", "item");
        d.close();
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn mkey(d: &Dom, names: string) {
    d.simKeys("", names);
    mframe(d);
    mframe(d);
}

fn hovered(d: &Dom, id: int): bool {
    return (d.mnodes.items[id].flags / 1) % 2 == 1;
}

fn testMenuKeys(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, MSHEET, "menu.css", 1);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    MOPEN = false;
    MCLOSE = 0;
    MCLICK = -1;
    mframe(&d);
    d.focusNode(MI[0]);
    MOPEN = true;
    mframe(&d);
    mframe(&d);
    ok(d.ovs.len == 1, "the menu is open");
    mkey(&d, "Down");
    ok(d.focus == MI[1], "Down from the trigger enters the menu on the first entry");
    mkey(&d, "Down");
    ok(d.focus == MI[2], "Down moves to the next entry");
    mkey(&d, "Down");
    ok(d.focus == MI[6], "a disabled entry is skipped");
    mkey(&d, "Down");
    ok(d.focus == MI[1], "Down wraps to the first");
    mkey(&d, "Up");
    ok(d.focus == MI[6], "Up wraps to the last");
    mkey(&d, "Home");
    ok(d.focus == MI[1], "Home");
    mkey(&d, "End");
    ok(d.focus == MI[6], "End");
    mkey(&d, "Right");
    ok(d.focus == MI[6] && MCLICK < 0, "Right on an entry without a submenu does nothing");
    mkey(&d, "Up");
    ok(d.focus == MI[2], "back on the host");
    ok(!hovered(&d, MI[2]), "keyboard focus on the host does not open its submenu");
    mkey(&d, "Right");
    ok(d.focus == MI[3] && hovered(&d, MI[2]), "Right opens the submenu and focuses its first entry");
    mkey(&d, "Down");
    ok(d.focus == MI[4], "Down inside the submenu stays in it");
    mkey(&d, "Down");
    ok(d.focus == MI[3], "and wraps inside it");
    mkey(&d, "Left");
    ok(d.focus == MI[2] && !hovered(&d, MI[2]), "Left closes one level and refocuses the host");
    mkey(&d, "Right");
    mkey(&d, "Escape");
    ok(d.focus == MI[2] && MCLOSE == 0 && MOPEN, "Escape in a submenu closes only the submenu");
    mkey(&d, "Down");
    mkey(&d, "Enter");
    ok(MCLICK == 6, "Enter clicks the focused entry");
    mkey(&d, "Escape");
    ok(MCLOSE == 1 && !MOPEN, "Escape on the top level closes the menu");
    mframe(&d);
    ok(d.focus == MI[0], "and focus goes back to the trigger");
    // hover intent: leaving the host toward a sibling keeps the submenu open for 300 ms
    MOPEN = true;
    mframe(&d);
    mframe(&d);
    d.simInput(cx(&d, MI[2]), cy(&d, MI[2]), false, 0.0);
    mframe(&d);
    ok(hovered(&d, MI[2]), "pointer on the host hovers it");
    d.simInput(cx(&d, MI[6]), cy(&d, MI[6]), false, 0.0);
    mframe(&d);
    mframe(&d);
    ok(hovered(&d, MI[2]), "leaving it keeps the submenu open for a moment");
    for i in 0..30 {
        mframe(&d);
    }
    ok(!hovered(&d, MI[2]), "and closes it after the delay");
    // the tooltip: delay from the theme, multi-line title
    let css2 = Css.new(mem);
    parse(&css2, MSHEET, "menu.css", 1);
    ok(uastyle.tipDelay(&css2) == 500.0, "default tooltip delay");
    parse(&css2, ":root { --j3-tooltip-delay: 0.2s; }", "theme.css", 0);
    ok(uastyle.tipDelay(&css2) == 200.0, "a theme sets --j3-tooltip-delay in seconds");
    parse(&css2, ":root { --j3-tooltip-delay: soon; }", "bad.css", 0);
    ok(css2.warns.len == 1 && uastyle.tipDelay(&css2) == 200.0, "an invalid delay warns and keeps the last good one");

}

// ---- the select list as real nodes ------------------------------------------------------------------------

const SSHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, select, option { font-family: \"T\"; font-size: 14px; color: #cdd6f4; } select { width: 150px; height: 28px; position: absolute; top: 0px; } .p { left: 0px; } .t { left: 200px; } .gone { left: 400px; } select.t .j3-select-list { box-shadow: 0 4px 10px #000000; max-height: 120px; border-radius: 12px; } select.t .j3-option { height: auto; padding: 8px 10px; } select.t .j3-check { display: none; } dialog { width: 300px; height: 150px; } dialog select { position: static; }";

#[singleton]
let S_SHOW: bool;
#[singleton]
let S_N: int;
#[singleton]
let S_N2: int;
#[singleton]
let S_DIS: int;
#[singleton]
let S_VAL: string;
#[singleton]
let S_VAL2: string;
#[singleton]
let S_MULTI: bool;
#[singleton]
let S_IDS: [3]int;
#[singleton]
let S_CHG: int;
#[singleton]
let S_DLG: bool;

fn sselect(d: &Dom, slot: int, cls: string, n: int, multi: bool, dis: int): int {
    let id = d.open(slot, d.tag("select"), 1);
    d.cls(id, cls);
    d.attrMultiple(id, multi);
    for i in 0..n {
        let tok = d.enter(i / 4096);
        let o = d.open(i % 4096, d.tag("option"), 1);
        d.attrDisabled(o, i == dis);
        d.text(`Option {i}`);
        d.close();
        d.leave(tok);
    }
    // what `bind:value` does: read the change first, then write the variable back
    if d.changed(id) {
        if slot == 0 {
            S_VAL = d.strValue(id);
            S_CHG += 1;
        } else {
            S_VAL2 = d.strValue(id);
        }
    }
    d.attrText(id, if slot == 0 { S_VAL } else { S_VAL2 });
    d.close();
    return id;
}

fn sframe(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    if S_SHOW {
        S_IDS[0] = sselect(d, 0, "p", S_N, S_MULTI, S_DIS);
    }
    S_IDS[1] = sselect(d, 1, "t", S_N2, false, -1);
    if S_DLG {
        let dlg = d.open(2, d.tag("dialog"), 1);
        d.attrOverlay(dlg, dom.OV_MODAL);
        S_IDS[2] = sselect(d, 0, "q", 4, false, -1);
        d.close();
    }
    d.close();
    d.layout();
    dropdown.settle(d);
    d.endFrame();
}

fn sfr(d: &Dom, n: int) {
    for i in 0..n {
        sframe(d);
    }
}

fn sclick(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    sframe(d);
    d.simInput(x, y, true, 0.0);
    sframe(d);
    d.simInput(x, y, false, 0.0);
    sframe(d);
    sframe(d);
}

fn skey(d: &Dom, names: string) {
    d.simKeys("", names);
    sframe(d);
    sframe(d);
}

fn sopen(d: &Dom, id: int) {
    sclick(d, d.absX(id) + 40.0, d.absY(id) + 14.0);
}

/// The list row for option `i` (-1 when it is not built).
fn srow(d: &Dom, i: int): int {
    if d.ptRoot < 0 {
        return -1;
    }
    let c = d.nodes.items[d.ptRoot].first;
    while c >= 0 {
        if d.nodes.items[c].pidx == i {
            return c;
        }
        c = d.nodes.items[c].next;
    }
    return -1;
}

fn srows(d: &Dom): int {
    let n = 0;
    if d.ptRoot >= 0 {
        let c = d.nodes.items[d.ptRoot].first;
        while c >= 0 {
            if d.nodes.items[c].pidx >= 0 {
                n += 1;
            }
            c = d.nodes.items[c].next;
        }
    }
    return n;
}

fn hasClass(d: &Dom, id: int, name: string): bool {
    let c = d.css.intern(name);
    let cl = d.mnodes.items[id].classes;
    for i in 0..cl.len {
        if cl[i] == c {
            return true;
        }
    }
    return false;
}

fn sdom(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    S_SHOW = true;
    S_N = 5;
    S_N2 = 12;
    S_DIS = -1;
    S_VAL = "Option 1";
    S_VAL2 = "Option 0";
    S_MULTI = false;
    S_CHG = 0;
    S_DLG = false;
    sfr(&d, 3);
    return d;
}

fn testSelect(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, SSHEET, "select.css", 1);
    ok(css.warns.len == 0, "the select test sheet parses with no warning");
    let d = sdom(mem, &css);
    let nodes0 = d.count();
    ok(d.ptRoot < 0 && d.pop.kind == popup.NONE, "a closed select has no list nodes");
    // open: real nodes under the select, on the overlay layer, the chosen row is .selected
    sopen(&d, S_IDS[0]);
    ok(d.pop.kind == popup.SELECT && d.ptRoot >= 0, "a click opens the list");
    ok(d.nodes.items[d.ptRoot].parent == S_IDS[0] && d.nodes.items[d.ptRoot].isFixed && d.nodes.items[d.ptRoot].rt, "the list is a fixed child of its select");
    ok(hasClass(&d, d.ptRoot, "j3-select-list") && srows(&d) == 5, "it has the .j3-select-list class and a row per option");
    ok(hasClass(&d, srow(&d, 1), "j3-option") && hasClass(&d, srow(&d, 1), "selected"), "the chosen row is .j3-option.selected");
    ok(!hasClass(&d, srow(&d, 0), "selected") && !hasClass(&d, srow(&d, 4), "selected"), "the others are not");
    near(d.nodes.items[d.ptRoot].h, f32(5 * 26 + 8), 0.5, "the default list is 26 px a row plus 8");
    near(d.nodes.items[d.ptRoot].y, d.absY(S_IDS[0]) + d.nodes.items[S_IDS[0]].h + 2.0, 0.5, "below its select");
    ok(d.nodes.items[d.ptRoot].w >= 150.0 && d.nodes.items[d.ptRoot].w < 151.0, "as wide as the select (min 120)");
    ok(d.css.get(d.nodes.items[d.ptRoot].style, P_BOX_SHADOW).kind != V_SHADOW, "the default list has no shadow");
    ok(d.count() > nodes0 + 10, "the rows are in the tree");
    // the highlight is the chosen row; keys move it; the pointer is away
    ok(d.pop.hot == 1 && hovered(&d, srow(&d, 1)), "the highlight starts on the chosen row");
    skey(&d, "Down");
    ok(d.pop.hot == 2 && hovered(&d, srow(&d, 2)) && !hovered(&d, srow(&d, 1)), "Down moves the highlight");
    skey(&d, "End");
    ok(d.pop.hot == 4, "End goes to the last");
    skey(&d, "Home");
    ok(d.pop.hot == 0, "Home goes to the first");
    skey(&d, "PageDown");
    ok(d.pop.hot == 4, "PageDown goes down a page (clamped)");
    skey(&d, "Up");
    skey(&d, "Enter");
    ok(d.pop.kind == popup.NONE && d.ptRoot < 0, "Enter closes and removes the nodes");
    ok(same(S_VAL, "Option 3") && S_CHG == 1, `and picked the highlighted option ({S_VAL} {S_CHG})`);
    ok(d.count() == nodes0, "no node is left behind");
    ok(d.focus == S_IDS[0], "the select keeps the focus");
    // a click on a row picks it; a disabled one does nothing
    S_DIS = 2;
    sfr(&d, 2);
    sopen(&d, S_IDS[0]);
    let r2 = srow(&d, 2);
    ok(hasClass(&d, r2, "j3-option") && d.mnodes.items[r2].flags / 4 % 2 == 1, "a disabled option's row has :disabled");
    sclick(&d, cx(&d, r2), cy(&d, r2));
    ok(d.pop.kind == popup.SELECT && same(S_VAL, "Option 3"), "a click on a disabled row keeps the list open and the value");
    let r4 = srow(&d, 4);
    sclick(&d, cx(&d, r4), cy(&d, r4));
    ok(d.pop.kind == popup.NONE && same(S_VAL, "Option 4") && S_CHG == 2, "a click on a row picks it and closes");
    // light dismiss and Escape
    sopen(&d, S_IDS[0]);
    ok(d.pop.kind == popup.SELECT, "reopened");
    sclick(&d, 300.0, 300.0);
    ok(d.pop.kind == popup.NONE && d.ptRoot < 0 && same(S_VAL, "Option 4"), "a press outside closes it without picking");
    sopen(&d, S_IDS[0]);
    skey(&d, "Escape");
    ok(d.pop.kind == popup.NONE && d.ptRoot < 0, "Escape closes it");
    sopen(&d, S_IDS[0]);
    sclick(&d, d.absX(S_IDS[0]) + 40.0, d.absY(S_IDS[0]) + 14.0);
    ok(d.pop.kind == popup.NONE, "a press on the select again closes it");
    // the pointer highlights the row it is over
    sopen(&d, S_IDS[0]);
    let r3 = srow(&d, 3);
    d.simInput(cx(&d, r3), cy(&d, r3), false, 0.0);
    sfr(&d, 2);
    ok(d.pop.hot == 3 && hovered(&d, r3), "hovering a row highlights it");
    d.simInput(-5.0, -5.0, false, 0.0);
    skey(&d, "Escape");
    // type-ahead picks by first letters while open
    S_VAL = "Option 0";
    sfr(&d, 2);
    // multiple: a pick toggles and keeps the list open
    S_MULTI = true;
    S_VAL = "Option 0";
    sfr(&d, 2);
    sopen(&d, S_IDS[0]);
    let m1 = srow(&d, 1);
    sclick(&d, cx(&d, m1), cy(&d, m1));
    ok(d.pop.kind == popup.SELECT && same(S_VAL, "Option 0,Option 1"), `multiple: a click adds and stays open ({S_VAL})`);
    ok(hasClass(&d, srow(&d, 1), "selected") && hasClass(&d, srow(&d, 0), "selected"), "both rows are .selected");
    let m0 = srow(&d, 0);
    sclick(&d, cx(&d, m0), cy(&d, m0));
    ok(same(S_VAL, "Option 1") && !hasClass(&d, srow(&d, 0), "selected"), `and a second click removes ({S_VAL})`);
    skey(&d, "Escape");
    S_MULTI = false;
    S_VAL = "Option 1";
    sfr(&d, 2);
    // steady frames while open: no layout, no restyle, no allocation
    sopen(&d, S_IDS[0]);
    d.simInput(-5.0, -5.0, false, 0.0);
    sfr(&d, 6);
    let laid = d.laid;
    let rs = d.restyled;
    let used = mem.used;
    sfr(&d, 100);
    ok(d.laid == laid && d.restyled == rs, `100 steady frames with the list open: 0 layouts ({d.laid - laid}), 0 restyles ({d.restyled - rs})`);
    ok(mem.used == used, `and 0 arena growth ({mem.used - used})`);
    // hot reload (restyle) while open: the list stays and settles again
    d.restyle();
    sfr(&d, 4);
    ok(d.pop.kind == popup.SELECT && srows(&d) == 5, "a restyle while open keeps the list");
    let laid2 = d.laid;
    sfr(&d, 20);
    ok(d.laid == laid2, "and it settles");
    skey(&d, "Escape");
    // the owner goes away while open
    sopen(&d, S_IDS[0]);
    ok(d.ptRoot >= 0, "open again");
    let before = d.count();
    S_SHOW = false;
    sfr(&d, 2);
    ok(d.ptRoot < 0 && d.pop.kind == popup.NONE, "the select leaves while open: the list and the popup state go with it");
    ok(d.count() < before - 5, "its nodes are freed");
    S_SHOW = true;
    sfr(&d, 2);
    // open and close 1000 times: the arena stays flat
    for w in 0..20 {
        sopen(&d, S_IDS[0]);
        skey(&d, "Escape");
    }
    let flat = mem.used;
    let nodes1 = d.count();
    for k in 0..1000 {
        d.simInput(d.absX(S_IDS[0]) + 40.0, d.absY(S_IDS[0]) + 14.0, true, 0.0);
        sframe(&d);
        d.simInput(d.absX(S_IDS[0]) + 40.0, d.absY(S_IDS[0]) + 14.0, false, 0.0);
        sframe(&d);
        sframe(&d);
        d.simKeys("", "Escape");
        sframe(&d);
    }
    ok(d.ptRoot < 0 && d.count() == nodes1, "1000 open/close cycles leave no node behind");
    ok(mem.used == flat, `1000 open/close cycles: arena flat ({mem.used - flat} bytes)`);
}

/// A select inside a modal dialog: the list is inside the dialog's subtree, so the modal lets its rows take presses.
fn testSelectInModal(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, SSHEET, "select.css", 1);
    let d = sdom(mem, &css);
    S_DLG = true;
    sfr(&d, 3);
    let q = S_IDS[2];
    ok(q >= 0 && dom.inside(&d, d.ovs.items[0].v, q), "the select is inside the modal");
    S_VAL2 = "Option 0";
    sopen(&d, q);
    ok(d.pop.kind == popup.SELECT && d.pop.owner == q && d.ptRoot >= 0, "it opens inside the modal");
    let r2 = srow(&d, 2);
    sclick(&d, cx(&d, r2), cy(&d, r2));
    ok(d.pop.kind == popup.NONE && d.ptRoot < 0 && d.ovs.len == 1, "a row click picks and closes the list, the modal stays");
    // the list is above the dialog: its rows are hit first
    sopen(&d, q);
    let r1 = srow(&d, 1);
    d.simInput(cx(&d, r1), cy(&d, r1), false, 0.0);
    sfr(&d, 2);
    ok(d.hover >= 0 && dom.inside(&d, d.ptRoot, d.hover), "the pointer over the list hits the list, not the dialog");
    skey(&d, "Escape");
    ok(d.pop.kind == popup.NONE && d.ovs.len == 1, "Escape closes the list first and keeps the modal");
    S_DLG = false;
}

fn testSelectRem(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, SSHEET, "select.css", 1);
    parse(&css, "select.t .j3-select-list { font-size: 30px; } select.t .j3-option { height: 2rem; padding: 0; }", "rem.css", 1);
    let d = sdom(mem, &css);
    sopen(&d, S_IDS[1]);
    ok(d.pop.kind == popup.SELECT && d.ptRoot >= 0, "the select opens");
    ok(css.get(d.nodes.items[d.ptRoot].style, P_FONT_SIZE).f == 30.0, "the popup has its own font-size");
    near(css.rootFs, 16.0, 0.001, "a popup's font-size does not become the root's");
    near(d.nodes.items[srow(&d, 0)].h, 32.0, 0.01, "rem inside a popup is the document root's, not the popup's");
}

fn testSelectTheme(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, SSHEET, "select.css", 1);
    let d = sdom(mem, &css);
    sopen(&d, S_IDS[1]);
    ok(d.pop.kind == popup.SELECT && d.pop.owner == S_IDS[1], "the themed select opens");
    let root = d.ptRoot;
    ok(d.css.get(d.nodes.items[root].style, P_BOX_SHADOW).kind == V_SHADOW, "a theme's box-shadow reaches the computed style of .j3-select-list");
    near(d.nodes.items[root].h, 120.0, 0.5, "max-height: 120px limits the list (12 options)");
    ok(d.nodes.items[root].scrollMax > 50.0, `and it scrolls ({d.nodes.items[root].scrollMax})`);
    let row0 = srow(&d, 0);
    ok(d.nodes.items[row0].h > 30.0, `taller rows from the theme's padding ({d.nodes.items[row0].h})`);
    ok(d.nodes.items[srow(&d, 0)].first >= 0 && d.nodes.items[d.nodes.items[row0].first].disp == dom.DP_NONE, "a theme hides the check mark with display: none");
    // the wheel scrolls the list, not the page; the chosen row scrolls in when it is far down
    d.simInput(cx(&d, root), cy(&d, root), false, -3.0);
    sframe(&d);
    ok(d.nodes.items[root].scrollY > 10.0, "the wheel scrolls the list");
    d.simInput(-5.0, -5.0, false, 0.0);
    skey(&d, "End");
    ok(d.pop.hot == 11, "End highlights the last");
    near(d.nodes.items[root].scrollY, d.nodes.items[root].scrollMax, 1.0, "and scrolls it to the end");
    ok(hovered(&d, srow(&d, 11)), "its row is highlighted");
    skey(&d, "Enter");
    ok(same(S_VAL2, "Option 11") && d.ptRoot < 0, "Enter on a scrolled list picks the last row");
    // opens with the chosen row in view
    sopen(&d, S_IDS[1]);
    let sel = srow(&d, 11);
    ok(sel >= 0 && d.absY(sel) >= d.absY(d.ptRoot) && d.absY(sel) + d.nodes.items[sel].h <= d.absY(d.ptRoot) + d.nodes.items[d.ptRoot].h + 0.5, "opening scrolls the chosen row into view");
    skey(&d, "Escape");
    // squeezed: little room below and above
    S_N2 = 12;
    d.simInput(-5.0, -5.0, false, 0.0);
    sfr(&d, 2);
}

fn testSelectBig(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, SSHEET, "select.css", 1);
    let d = sdom(mem, &css);
    S_N = 5000;
    S_VAL = "Option 3000";
    let t0 = micros();
    sfr(&d, 2);
    let build = micros() - t0;
    let px = d.absX(S_IDS[0]) + 40.0;
    let py = d.absY(S_IDS[0]) + 14.0;
    d.simInput(px, py, false, 0.0);
    sframe(&d);
    d.simInput(px, py, true, 0.0);
    let t2 = micros();
    sframe(&d);
    let openUs = micros() - t2;
    d.simInput(px, py, false, 0.0);
    sfr(&d, 3);
    ok(d.pop.kind == popup.SELECT && srows(&d) < 24, `5000 options build only the rows near the viewport ({srows(&d)})`);
    let live = d.count();
    let sel = srow(&d, 3000);
    ok(sel >= 0 && d.absY(sel) >= d.absY(d.ptRoot) && d.absY(sel) + d.nodes.items[sel].h <= d.absY(d.ptRoot) + d.nodes.items[d.ptRoot].h + 0.5, "the chosen row (3000) is in view on open");
    ok(hasClass(&d, sel, "selected"), "and it is .selected");
    near(d.nodes.items[d.ptRoot].h, 216.0, 0.5, "the list is eight rows tall");
    near(d.nodes.items[d.ptRoot].scrollMax, f32(5000 * 26 + 8 - 216), 4.0, "its scroll range covers every option");
    // End goes to the last option; the wheel moves a window
    skey(&d, "End");
    ok(d.pop.hot == 4999 && srow(&d, 4999) >= 0 && srows(&d) < 24, "End builds the last rows");
    skey(&d, "Home");
    ok(d.pop.hot == 0 && srow(&d, 0) >= 0 && srow(&d, 4999) < 0, "Home goes back; the far rows are gone");
    ok(d.count() < live + 30, "the live node count stays small");
    d.simInput(cx(&d, d.ptRoot), cy(&d, d.ptRoot), false, -5.0);
    sframe(&d);
    sfr(&d, 2);
    ok(d.nodes.items[d.ptRoot].scrollY > 50.0 && srows(&d) < 24, "the wheel moves the window");
    d.simInput(-5.0, -5.0, false, 0.0);
    sfr(&d, 6);
    let laid = d.laid;
    let rs = d.restyled;
    let used = mem.used;
    sfr(&d, 100);
    ok(d.laid == laid && d.restyled == rs && mem.used == used, "100 steady frames with 5000 options: 0 layouts, 0 restyles, 0 arena growth");
    // cost: a frame with the list open (build + layout + input) for 5000 options
    let t1 = micros();
    for i in 0..50 {
        d.simInput(cx(&d, d.ptRoot), cy(&d, d.ptRoot), false, if i % 2 == 0 { -1.0 } else { 1.0 });
        sframe(&d);
    }
    let open = (micros() - t1) / 50;
    printLn(`5000-option select: page with 5000 option nodes first frame {build} us, the press that opens the list {openUs} us, scrolling frame with the list open {open} us   [dev build, no paint]`);
    skey(&d, "Escape");
    ok(d.ptRoot < 0, "closed");
}

// ---- tooltip and color runtime trees (023/3b) ----------------------------------------------------------

#[singleton]
let P_SHOW: bool;
#[singleton]
let P_MODAL: bool;
#[singleton]
let P_W: f32;
#[singleton]
let P_IDS: [4]int;
#[singleton]
let P_TEXT: string;
#[singleton]
let P_COLOR: string;

const PSHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } .page { font-family: \"T\"; font-size: 14px; color: #cdd6f4; } .tip { position: absolute; left: 350px; top: 20px; width: 100px; height: 30px; } .picker { position: absolute; left: 20px; top: 20px; width: 100px; height: 30px; } .selp { position: absolute; left: 200px; top: 20px; width: 100px; height: 30px; } dialog { width: 500px; height: 300px; } .page .j3-tooltip { width: 180px; padding: 8px 12px; box-shadow: 0 4px 12px #000000; } .page .j3-color-panel { width: 250px; padding: 14px; box-shadow: 0 8px 16px #000000; } .page .j3-color-sv { height: 100px; } :root { --j3-tooltip-delay: 0ms; }";

fn pframe(d: &Dom) {
    d.beginFrame(Vec2 { x: P_W, y: 400.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("j3-page"), 1);
    d.cls(page, "page");
    if P_MODAL {
        let modal = d.open(0, d.tag("dialog"), 1);
        d.attrOverlay(modal, dom.OV_MODAL);
        P_IDS[3] = modal;
    }
    if P_SHOW {
        let co = d.open(1, d.tag("input"), 1);
        d.cls(co, "picker");
        d.attrType(co, "color");
        if d.changed(co) { P_COLOR = d.strValue(co); }
        d.attrText(co, P_COLOR);
        P_IDS[0] = co;
        d.close();
        let tip = d.open(2, d.tag("button"), 1);
        d.cls(tip, "tip");
        d.attrTitle(tip, P_TEXT);
        d.text("Hover here");
        P_IDS[1] = tip;
        d.close();
        let sel = d.open(3, d.tag("select"), 1);
        d.cls(sel, "selp");
        let opt = d.open(0, d.tag("option"), 1);
        d.text("One");
        d.close();
        P_IDS[2] = sel;
        d.close();
    }
    if P_MODAL { d.close(); }
    d.close();
    d.layout();
    dropdown.settle(d);
    overlays.settleTip(d);
    d.endFrame();
}

fn pframes(d: &Dom, n: int) { for i in 0..n { pframe(d); } }
fn pclick(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0); pframe(d);
    d.simInput(x, y, true, 0.0); pframe(d);
    d.simInput(x, y, false, 0.0); pframes(d, 3);
}
fn pkey(d: &Dom, key: string) { d.simKeys("", key); pframes(d, 2); }
fn phover(d: &Dom) { d.simInput(cx(d, P_IDS[1]), cy(d, P_IDS[1]), false, 0.0); pframes(d, 12); }

/// Verify effective color slots, not merely the retained RGB cache on the nodes.
fn pcolors(d: &Dom, when: string) {
    let sq = d.nodes.items[d.ptRoot].first;
    let bar = d.nodes.items[sq].next;
    let handle = d.nodes.items[bar].first;
    let preview = d.nodes.items[d.nodes.items[bar].next].first;
    let hue = colorpick.fromHsv(d.pop.hsv.h, 1.0, 1.0) * 256 + 255;
    let rgb = colorpick.fromHsv(d.pop.hsv.h, d.pop.hsv.s, d.pop.hsv.v) * 256 + 255;
    ok(dom.colorOf(d, d.nodes.items[sq].style, P_BACKGROUND) == hue, `SV hue survives {when}`);
    ok(dom.colorOf(d, d.nodes.items[handle].style, P_BACKGROUND) == hue, `hue handle fill survives {when}`);
    ok(dom.colorOf(d, d.nodes.items[preview].style, P_BACKGROUND) == rgb, `preview fill survives {when}`);
}

fn testRuntimePopups(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, PSHEET, "popups.css", 1);
    ok(css.warns.len == 0, "popup theme and UA parse cleanly");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    P_W = 600.0; P_SHOW = true; P_MODAL = false; P_COLOR = "#ff0000";
    P_TEXT = "A long title wraps across several lines, preserving explicit\nnewlines and breaking SupercalifragilisticexpialidociousSupercalifragilisticexpialidocious.";
    pframes(&d, 3);
    let base = d.count();
    phover(&d);
    let tip = d.ttRoot;
    ok(tip >= 0 && hasClass(&d, tip, "j3-tooltip") && d.nodes.items[tip].parent == P_IDS[1], "title builds a separate real subtree under its owner");
    ok(d.nodes.items[d.nodes.items[tip].first].kind == dom.K_TEXT, "tooltip contains ordinary text");
    near(d.nodes.items[tip].w, 180.0, 0.5, "component ancestor selector sets tooltip width");
    ok(d.nodes.items[tip].h > 90.0 && d.css.get(d.nodes.items[tip].style, P_BOX_SHADOW).kind == V_SHADOW, "long title wraps and ordinary shadow applies");
    let fr = d.nodes.items[tip].frag0;
    let lines = 0;
    while fr >= 0 {
        ok(d.frags.items[fr].w <= 154.5, "wrapped text stays inside tooltip padding");
        lines += 1; fr = d.frags.items[fr].next;
    }
    ok(lines > 4, "text fragments include wrapped lines");
    let used = mem.used; let laid = d.laid; let styled = d.restyled;
    pframes(&d, 100);
    ok(mem.used == used && d.laid == laid && d.restyled == styled, "steady tooltip: no arena growth, layouts or restyles");
    d.attrDisabled(P_IDS[1], true); phover(&d);
    ok(d.ttRoot == tip, "a disabled owner retains its title like the painted tooltip did");
    d.attrDisabled(P_IDS[1], false);
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), true, 0.0); pframe(&d);
    let root = d.ptRoot;
    let initialSq = d.nodes.items[root].first;
    let initialMark = d.nodes.items[initialSq].last;
    near(d.nodes.items[initialMark].x + d.nodes.items[initialMark].w * 0.5, d.nodes.items[initialSq].w, 0.01, "marker is correctly placed on the first opening frame");
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), false, 0.0); pframes(&d, 3);
    ok(root >= 0 && hasClass(&d, root, "j3-color-panel") && d.ttRoot < 0, "color opens as real nodes and press hides tooltip");
    near(d.nodes.items[root].w, 250.0, 0.5, "color panel accepts themed width");
    ok(d.css.get(d.nodes.items[root].style, P_BOX_SHADOW).kind == V_SHADOW, "color panel accepts ordinary shadow");
    let sq = d.nodes.items[root].first;
    let bar = d.nodes.items[sq].next;
    near(d.nodes.items[sq].w, 220.0, 0.5, "SV area follows themed panel padding and width");
    near(d.nodes.items[sq].h, 100.0, 0.5, "SV area accepts themed height");
    ok(hasClass(&d, sq, "j3-color-sv") && hasClass(&d, bar, "j3-color-hue"), "square and hue bar are real children");
    let focus = d.focus;
    pclick(&d, d.absX(sq) + d.nodes.items[sq].w * 0.5, d.absY(sq));
    ok(same(P_COLOR, "#ff8080") && d.focus == focus, "themed SV hit area picks color without taking focus");
    pclick(&d, d.absX(bar) + d.nodes.items[bar].w * 0.5, cy(&d, bar));
    ok(same(P_COLOR, "#80ffff"), "themed hue hit area picks hue");
    P_COLOR = "#0000ff"; pframes(&d, 4);
    ok(d.pop.hsv.h > 239.0 && d.pop.hsv.h < 241.0, "program color changes update the open subtree");
    d.restyle(); pframes(&d, 3);
    pcolors(&d, "direct restyle");
    css.reset(); uastyle.load(&css); parse(&css, PSHEET, "popups.css", 1);
    d.restyle(); pframes(&d, 3);
    pcolors(&d, "CSS reset/reload");
    P_COLOR = "#804020"; pframes(&d, 3);
    pcolors(&d, "a live color update after reload");
    P_COLOR = "#0000ff"; pframes(&d, 3);
    parse(&css, ".page .j3-color-panel { width: 280px; padding: 20px; } .page .j3-color-marker { width: 20px; height: 18px; } .page .j3-color-handle { width: 22px; }", "resize.css", 1);
    d.restyle(); pframe(&d);
    let resizedMark = d.nodes.items[sq].last;
    let resizedHandle = d.nodes.items[bar].first;
    near(d.nodes.items[resizedMark].x + d.nodes.items[resizedMark].w * 0.5, d.pop.hsv.s * d.nodes.items[sq].w, 0.01, "resize and themed marker width are reflected in the same frame");
    near(d.nodes.items[resizedHandle].x + d.nodes.items[resizedHandle].w * 0.5, d.pop.hsv.h / 359.9 * d.nodes.items[bar].w, 0.01, "themed hue handle stays centered on its value");
    d.simInput(cx(&d, sq), cy(&d, sq), true, 0.0); pframe(&d);
    ok(d.pop.drag == 1, "SV shade child starts the square drag");
    d.simInput(d.absX(sq) + d.nodes.items[sq].w + 100.0, d.absY(sq) - 100.0, true, 0.0); pframe(&d);
    ok(d.pop.hsv.s == 1.0 && d.pop.hsv.v == 1.0 && d.pop.kind == popup.COLOR, "drag outside the square clamps and keeps the panel open");
    d.simInput(-5.0, -5.0, false, 0.0); pframe(&d);
    ok(d.pop.drag == 0, "release outside ends the drag");
    phover(&d);
    ok(d.ttRoot >= 0 && d.ptRoot == root && d.pop.kind == popup.COLOR, "tooltip coexists with color panel without replacing its slot");
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), false, 0.0); pframes(&d, 2);
    ok(d.ttRoot < 0 && d.ptRoot == root, "crossing back to an untitled popup owner drops only the tooltip");
    d.simInput(cx(&d, sq), cy(&d, sq), false, 0.0); pframes(&d, 2);
    ok(d.ttRoot < 0 && d.ptRoot == root, "crossing a popup child keeps the input subtree intact");
    phover(&d);
    let used2 = mem.used; let laid2 = d.laid; let styled2 = d.restyled;
    pframes(&d, 100);
    ok(mem.used == used2 && d.laid == laid2 && d.restyled == styled2, "steady color plus tooltip: no arena growth, layouts or restyles");
    pkey(&d, "Escape");
    ok(d.ptRoot < 0 && d.ttRoot >= 0 && d.focus == focus, "Escape removes color subtree and keeps passive tooltip/focus");
    pclick(&d, cx(&d, P_IDS[2]), cy(&d, P_IDS[2]));
    let select = d.ptRoot;
    phover(&d);
    ok(d.ttRoot >= 0 && d.ptRoot == select && d.pop.kind == popup.SELECT, `tooltip coexists with select list (tip {d.ttRoot}, popup {d.ptRoot}, expected {select}, kind {d.pop.kind}, hover {d.hover})`);
    pkey(&d, "Enter");
    ok(d.ptRoot < 0 && d.pop.kind == popup.NONE, "select keyboard still picks beside tooltip");
    parse(&css, ".page .j3-tooltip { width: auto; }", "auto.css", 1);
    d.restyle(); pframes(&d, 4);
    near(d.nodes.items[d.ttRoot].w, 320.0, 0.5, "auto-width tooltip wraps at the default 320px cap after restyle");
    parse(&css, ".tip { left: 10px; }", "narrow.css", 1); d.restyle();
    P_W = 160.0; pframes(&d, 2); phover(&d);
    // Pointer and trigger must stay in the resized viewport for the tip to remain eligible.
    ok(d.nodes.items[d.ttRoot].w <= 152.5 && d.nodes.items[d.ttRoot].x >= 4.0, "auto-width tooltip clamps to a narrow viewport");
    parse(&css, ".tip { left: 350px; }", "wide.css", 1); d.restyle();
    P_W = 600.0; P_TEXT = "short\nnext"; pframes(&d, 2); phover(&d);
    ok(d.nodes.items[d.ttRoot].w < 100.0 && d.nodes.items[d.ttRoot].h < 65.0, "title updates shrink the real text box and preserve newlines");
    let utfTitle = "é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界\nmore UTF-8 text";
    P_TEXT = utfTitle; pframes(&d, 3);
    let utfFrag = d.nodes.items[d.ttRoot].frag0;
    let validUtf = true;
    while utfFrag >= 0 {
        let f = &d.frags.items[utfFrag];
        if f.start < utfTitle.len && utfTitle[f.start] >= 128 && utfTitle[f.start] < 192 { validUtf = false; }
        if f.end < utfTitle.len && utfTitle[f.end] >= 128 && utfTitle[f.end] < 192 { validUtf = false; }
        utfFrag = f.next;
    }
    ok(validUtf && d.nodes.items[d.ttRoot].h > 60.0, "wrapped UTF-8 fragments start and end on code point boundaries");
    for i in 0..20 { P_TEXT = if i % 2 == 0 { utfTitle } else { "short\nnext" }; pframes(&d, 3); }
    let titleUsed = mem.used;
    for i in 0..1000 { P_TEXT = if i % 2 == 0 { utfTitle } else { "short\nnext" }; pframes(&d, 3); }
    ok(mem.used == titleUsed, "1000 updates while shown reuse tooltip text and fragment buffers");
    P_TEXT = ""; pframes(&d, 3);
    ok(d.ttRoot < 0, "clearing a title destroys its tooltip");
    P_TEXT = "Restored tooltip"; phover(&d);
    P_SHOW = false; pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.tipNode < 0, "removing tooltip owner destroys its subtree");
    P_SHOW = true; P_MODAL = true; pframes(&d, 4);
    pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0]));
    phover(&d);
    ok(d.ptRoot >= 0 && d.ttRoot >= 0 && d.focus == P_IDS[0], "color and tooltip coexist in a modal without stealing focus");
    d.attrTitle(0, "Outside modal");
    d.simInput(590.0, 390.0, false, 0.0); pframes(&d, 12);
    ok(d.ttRoot < 0 && d.tipNode < 0 && d.ptRoot >= 0, "a title behind a modal cannot show through its input filter");
    d.attrTitle(0, "");
    pkey(&d, "Escape");
    ok(d.ptRoot < 0 && d.ovs.len == 1 && !d.closeRequested(P_IDS[3]), "Escape closes color before modal");
    pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0]));
    P_SHOW = false; pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.pop.kind == popup.NONE, "removing color owner destroys panel and clears drag state");
    P_MODAL = false; P_SHOW = true; pframes(&d, 3);
    // Warm node/style/fragment pools, then repeat the same open/close cycles.
    for i in 0..20 { pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0])); phover(&d); pkey(&d, "Escape"); }
    let steady = mem.used;
    let count = d.count();
    for i in 0..1000 { pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0])); phover(&d); pkey(&d, "Escape"); }
    ok(mem.used == steady && d.count() == count, "1000 reopen/close cycles reuse popup nodes/styles/text without arena growth");
    d.simInput(-5.0, -5.0, false, 0.0); pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.count() == base, "closed popups leave no live runtime nodes");
}

// ---- dialog inputs: autoselect and the default button ----------------------------------------------------

#[singleton]
let D_OPEN: bool;
#[singleton]
let D_AUTO: bool;
#[singleton]
let D_SUB: bool;
#[singleton]
let D_DEF: bool;
#[singleton]
let D_DIS: bool;
#[singleton]
let D_NEST: bool;
#[singleton]
let D_NP: int;
#[singleton]
let D_SEL: bool;
#[singleton]
let D_PICK: int;
#[singleton]
let D_VAL: string;
#[singleton]
let D_P: int;
#[singleton]
let D_S: int;
#[singleton]
let D_SUBS: int;
#[singleton]
let D_IDS: [5]int;

fn dframe(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    if D_OPEN {
        let dlg = d.open(1, d.tag("dialog"), 1);
        d.attrOverlay(dlg, dom.OV_MODAL);
        if D_AUTO { d.attrFlag(dlg, 1); }
        let tb = d.open(0, d.tag("input"), 1);
        d.cls(tb, "tb");
        d.attrType(tb, "text");
        if D_SUB { d.attrFlag(tb, 2); }
        if d.changed(tb) { D_VAL = d.strValue(tb); }
        if d.submitted(tb) { D_SUBS += 1; }
        d.attrText(tb, D_VAL);
        d.close();
        let ta = d.open(1, d.tag("input"), 1);
        d.cls(ta, "tb");
        d.attrType(ta, "textarea");
        d.close();
        if D_NEST {
            let pp = d.open(5, d.tag("div"), 1);
            d.attrOverlay(pp, dom.OV_POPOVER);
            let nb = d.open(0, d.tag("button"), 1);
            d.cls(nb, "btn");
            d.cls(nb, "primary");
            if d.clicked(nb) { D_NP += 1; }
            d.close();
            d.close();
        }
        if D_SEL {
            let se = d.open(4, d.tag("select"), 1);
            for i in 0..3 {
                let o = d.open(i, d.tag("option"), 1);
                d.text(`Opt {i}`);
                d.close();
            }
            if d.changed(se) { D_PICK += 1; }
            d.close();
        }
        let pr = d.open(2, d.tag("button"), 1);
        d.cls(pr, "btn");
        d.cls(pr, "primary");
        d.attrDisabled(pr, D_DIS);
        if d.clicked(pr) { D_P += 1; }
        d.close();
        let sc = d.open(3, d.tag("button"), 1);
        d.cls(sc, "btn");
        if D_DEF { d.attrFlag(sc, 3); }
        if d.clicked(sc) { D_S += 1; }
        d.close();
        D_IDS[0] = tb;
        D_IDS[1] = ta;
        D_IDS[2] = pr;
        D_IDS[3] = sc;
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn dkey(d: &Dom, typed: string, names: string) {
    d.simKeys(typed, names);
    dframe(d);
    dframe(d);
}

fn dopen(mem: &Arena, css: &Css, val: string): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    D_OPEN = false;
    D_VAL = val;
    D_P = 0;
    D_S = 0;
    D_SUBS = 0;
    D_PICK = 0;
    dframe(&d);
    dframe(&d);
    D_OPEN = true;
    for i in 0..5 {
        dframe(&d);
    }
    return d;
}

fn testDialogInputs(mem: &Arena, css: &Css) {
    // autoselect: the box is focused with all its text selected, typing replaces it
    D_AUTO = true; D_SUB = false; D_DEF = false; D_DIS = false;
    let d = dopen(mem, css, "report.txt");
    let tb = D_IDS[0];
    ok(d.focused() == tb, "autoselect: the first text box has focus");
    let e = &d.eds.items[d.nodes.items[tb].edit];
    ok(e.anc == 0 && e.cur == 10, "autoselect: all the text is selected on open");
    dkey(&d, "x", "");
    ok(same(D_VAL, "x"), "typing replaces the selection");
    // a second focus by Tab does not select again
    dkey(&d, "", "S+Tab");
    dkey(&d, "", "Tab");
    ok(d.focused() == tb && !d.eds.items[d.nodes.items[tb].edit].hasSel(), "a later focus does not autoselect");
    // Enter in the box (no on:submit) clicks the primary button
    dkey(&d, "", "Enter");
    ok(D_P == 1 && D_S == 0, "Enter clicks button.primary");
    // without autoselect: caret at the end, no selection
    D_AUTO = false;
    let d2 = dopen(mem, css, "abc");
    ok(!d2.eds.items[d2.nodes.items[D_IDS[0]].edit].hasSel(), "no autoselect: nothing selected");
    // `default` wins over `.primary`
    D_DEF = true;
    let d3 = dopen(mem, css, "abc");
    dkey(&d3, "", "Enter");
    ok(D_S == 1 && D_P == 0, "a `default` button beats button.primary");
    // a disabled default does nothing, and does not fall through to primary
    D_DIS = true; D_DEF = false;
    let d4 = dopen(mem, css, "abc");
    dkey(&d4, "", "Enter");
    ok(D_P == 0 && D_S == 0, "a disabled primary button is not clicked");
    // on:submit keeps the key to itself
    D_DIS = false; D_SUB = true;
    let d5 = dopen(mem, css, "abc");
    dkey(&d5, "", "Enter");
    ok(D_SUBS == 1 && D_P == 0, "an input with on:submit submits and does not click the default");
    // a textarea takes Enter as a newline
    D_SUB = false;
    let d6 = dopen(mem, css, "abc");
    dkey(&d6, "", "Tab");
    ok(d6.focused() == D_IDS[1], "Tab reaches the textarea");
    dkey(&d6, "", "Enter");
    ok(D_P == 0 && d6.eds.items[d6.nodes.items[D_IDS[1]].edit].text.len() == 1, "textarea: Enter inserts a newline, no default click");
    // Enter on the primary button itself still clicks it once
    dkey(&d6, "", "Tab");
    ok(d6.focused() == D_IDS[2], "Tab reaches the primary button");
    dkey(&d6, "", "Enter");
    ok(D_P == 1, "Enter on a focused button clicks it once");
    // Enter queued for the very frame the dialog takes focus: on:submit is already known (set by the build that made the box)
    D_SUB = true;
    let d7 = dopen(mem, css, "abc");
    D_OPEN = false;
    dframe(&d7);
    dframe(&d7);
    D_P = 0; D_SUBS = 0;
    D_OPEN = true;
    dframe(&d7);
    dkey(&d7, "", "Enter");
    ok(D_P == 0, "Enter right after the dialog is built never falls through to the default when on:submit exists");
    // an open select list takes Enter: it picks, the default button is not clicked
    D_SUB = false; D_SEL = true;
    let d8 = dopen(mem, css, "abc");
    dkey(&d8, "", "Tab");
    dkey(&d8, "", "Tab");
    ok(d8.pop.kind != popup.NONE || d8.focused() >= 0, "focus is on the select");
    dkey(&d8, "", "Enter");
    ok(d8.pop.kind != popup.NONE && D_P == 0, "Enter on a select opens its list, no default click");
    dkey(&d8, "", "Down");
    dkey(&d8, "", "Enter");
    ok(D_PICK == 1 && D_P == 0 && d8.pop.kind == popup.NONE, "Enter in the open list picks the option and does not click the default button");
    D_SEL = false;
    // a popover nested in the dialog is another layer: its .primary is not the dialog's default
    D_NEST = true; D_NP = 0;
    let d9 = dopen(mem, css, "abc");
    dkey(&d9, "", "Enter");
    D_NEST = false;
    ok(D_P == 1 && D_NP == 0, "the default button search skips nested overlays");
}

fn main() {
    let mem = Arena.create(256 * 1024 * 1024);
    testMath();
    testToast(&mem);
    let css = Css.new(&mem);
    parse(&css, SHEET, "overlay.css", 1);
    ok(css.warns.len == 0, "the test sheet parses with no warning");
    testScroll(&mem, &css);
    testInertia(&mem, &css);
    testBars(&mem, &css);
    testLongList(&mem, &css);
    testModal(&mem, &css);
    testBackdropAndRemoval(&mem, &css);
    testPopover(&mem, &css);
    testPlacement(&mem, &css);
    testTooltip(&mem, &css);
    testMenuKeys(&mem);
    testSelect(&mem);
    testSelectInModal(&mem);
    testSelectTheme(&mem);
    testSelectRem(&mem);
    testSelectBig(&mem);
    testRuntimePopups(&mem);
    testDialogInputs(&mem, &css);
    printLn(`overlay_test ok, checks passed: {CHECKS}`);
}
