// padnav_test: the test page, its state and frame helpers.

module padnav_test;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } * { margin: 0; padding: 0; } div, button, input, summary { font-family: \"T\"; font-size: 14px; } button, input { width: 60px; height: 30px; } .wrap { display: flex; gap: 100px; } .big { display: flex; flex-wrap: wrap; width: 1750px; gap: 10px; } .g { display: flex; flex-wrap: wrap; width: 230px; gap: 10px; } .g2 { display: flex; flex-direction: column; gap: 10px; } .inv { visibility: hidden; } .row { display: flex; gap: 10px; margin-top: 20px; } .col { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; } .sc { height: 100px; overflow-y: auto; margin-top: 20px; } .sc button { display: block; margin-bottom: 10px; } dialog { position: fixed; left: 400px; top: 300px; width: 200px; height: 100px; } summary { display: block; width: 60px; height: 20px; }";

// page buttons: 0..8 the 3x3 grid, 9 and 10 the column beside it; focus-group rows; override column; scroll list; extras
#[singleton]
let G: [9]int;

#[singleton]
let C: [2]int;

#[singleton]
let W: [3]int;

#[singleton]
let T: [2]int;

#[singleton]
let AFTER: int;

#[singleton]
let N: [3]int;

#[singleton]
let L: [12]int;

#[singleton]
let SCB: int;

#[singleton]
let MB: [2]int;

#[singleton]
let MODAL: int;

#[singleton]
let EXTRA: int;

#[singleton]
let CHK: int;

#[singleton]
let SEL: int;

#[singleton]
let SUM: int;

#[singleton]
let TXT: int;

#[singleton]
let TA: int;

#[singleton]
let AR: [2]int;

// switches
#[singleton]
let SHOW_MODAL: bool;

#[singleton]
let SHOW_EXTRA: bool;

#[singleton]
let HIDE1: bool;

#[singleton]
let DIS4: bool;

#[singleton]
let SHOW_ALL: bool;

// results
#[singleton]
let CLICKS: int;

#[singleton]
let CHECKED: bool;

#[singleton]
let TOGGLES: int;

#[singleton]
let OPEN: bool;

#[singleton]
let CHOSEN: string;

#[singleton]
let CHOSEN_N: int;

fn btn(d: &Dom, slot: int): int {
    let b = d.open(slot, d.tag("button"), 1);
    if d.clicked(b) { CLICKS += 1; }
    d.close();
    return b;
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let wrap = d.open(0, d.tag("div"), 1);
    d.cls(wrap, "wrap");
    let g = d.open(0, d.tag("div"), 1);
    d.cls(g, "g");
    for i in 0..9 {
        G[i] = d.open(i, d.tag("button"), 1);
        if i == 1 && HIDE1 { d.cls(G[i], "inv"); }
        d.attrDisabled(G[i], i == 4 && DIS4);
        if d.clicked(G[i]) { CLICKS += 1; }
        d.close();
    }
    d.close();
    let g2 = d.open(1, d.tag("div"), 1);
    d.cls(g2, "g2");
    C[0] = btn(d, 0);
    C[1] = btn(d, 1);
    d.close();
    d.close();
    // a wrapping row
    let r = d.open(1, d.tag("div"), 1);
    d.cls(r, "row");
    d.attrNav(r, 0, "wrap");
    for i in 0..3 { W[i] = btn(d, i); }
    d.close();
    // a trapping row, with a button beside it that Right must not reach
    let tr = d.open(2, d.tag("div"), 1);
    d.cls(tr, "row");
    let tg = d.open(0, d.tag("div"), 1);
    d.cls(tg, "row");
    d.attrNav(tg, 0, "trap");
    T[0] = btn(d, 0);
    T[1] = btn(d, 1);
    d.close();
    AFTER = btn(d, 1);
    d.close();
    // overrides: n0 down -> n2, n2 right -> a missing id
    let nc = d.open(3, d.tag("div"), 1);
    d.cls(nc, "col");
    N[0] = btn(d, 0);
    N[1] = btn(d, 1);
    N[2] = btn(d, 2);
    d.attrNav(N[0], 2, "n2");
    d.attrNav(N[2], 4, "nowhere");
    d.attrId(N[2], "n2");
    d.close();
    // a scrolling list
    SCB = d.open(4, d.tag("div"), 1);
    d.cls(SCB, "sc");
    for i in 0..12 { L[i] = btn(d, i); }
    d.close();
    // activation targets
    let ac = d.open(5, d.tag("div"), 1);
    d.cls(ac, "row");
    CHK = d.open(0, d.tag("input"), 1);
    d.attrType(CHK, "checkbox");
    if d.clicked(CHK) { CHECKED = !CHECKED; }
    d.attrChecked(CHK, CHECKED);
    d.close();
    let det = d.open(1, d.tag("details"), 1);
    if d.userToggled(det) { OPEN = d.isOpen(det); TOGGLES += 1; }
    d.attrOpen(det, OPEN);
    SUM = d.open(0, d.tag("summary"), 1);
    d.attrTabIndex(SUM);
    d.text("S");
    d.close();
    let body = d.open(1, d.tag("div"), 1);
    d.close();
    d.close();
    SEL = d.open(2, d.tag("select"), 1);
    for i in 0..4 {
        let o = d.open(i, d.tag("option"), 1);
        d.text(`Opt {i}`);
        d.close();
    }
    if d.changed(SEL) { CHOSEN = d.strValue(SEL); CHOSEN_N += 1; }
    d.attrText(SEL, CHOSEN);
    d.close();
    TXT = d.open(3, d.tag("input"), 1);
    d.attrType(TXT, "text");
    d.close();
    TA = d.open(4, d.tag("input"), 1);
    d.attrType(TA, "textarea");
    d.close();
    d.close();
    // the arrow-key group: a button, a text box and a button
    let ar = d.open(6, d.tag("div"), 1);
    d.cls(ar, "row");
    d.attrNav(ar, 0, "arrows");
    AR[0] = btn(d, 0);
    let ai = d.open(1, d.tag("input"), 1);
    d.attrType(ai, "text");
    d.close();
    AR[1] = btn(d, 2);
    d.close();
    if SHOW_MODAL {
        MODAL = d.open(7, d.tag("dialog"), 1);
        d.attrOverlay(MODAL, dom.OV_MODAL);
        if d.closeRequested(MODAL) { SHOW_MODAL = false; }
        MB[0] = btn(d, 0);
        MB[1] = btn(d, 1);
        d.close();
    }
    d.close();
    d.layout();
    dropdown.settle(d);
    d.endFrame();
}

fn bigFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let big = d.open(0, d.tag("div"), 1);
    d.cls(big, "big");
    for i in 0..500 {
        let b = d.open(i, d.tag("button"), 1);
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn fresh(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    SHOW_MODAL = false;
    HIDE1 = false;
    DIS4 = false;
    CLICKS = 0;
    CHECKED = false;
    OPEN = false;
    TOGGLES = 0;
    CHOSEN = "";
    CHOSEN_N = 0;
    frame(&d);
    frame(&d);
    return d;
}

/// One pad press (a frame down, a frame up).
fn press(d: &Dom, names: string) {
    d.setPad(padin.parse(names));
    frame(d);
    d.setPad(padin.parse(""));
    frame(d);
}

fn at(d: &Dom, id: int, msg: string) {
    ok(d.focused() == id, msg);
}

fn press2(d: &Dom, names: string) {
    d.setPad(padin.parse(names));
    bigFrame(d);
    d.setPad(padin.parse(""));
    bigFrame(d);
}
