// padnav_test: stick repeat, misc keys, arrows, hotplug, textarea, mouse, idle cost.

module padnav_test;

fn testRepeat(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(L[0]);
    let moves = 0;
    let last = d.focused();
    let at25 = -1;
    let movesAt24 = 0;
    d.setPad(padin.parse("Down"));
    for f in 0..40 {
        frame(&d);
        if d.focused() != last {
            moves += 1;
            last = d.focused();
        }
        if f == 24 { movesAt24 = moves; }
        if f == 25 { at25 = moves; }
    }
    d.setPad(padin.parse(""));
    frame(&d);
    ok(movesAt24 == 1, "held: one move at once, none before 400 ms");
    ok(at25 == 2, "the first repeat at 400 ms (frame 25 of 16 ms)");
    ok(moves == 3, "then every 120 ms (the next at frame 33, and not at 40)");
}

fn testMisc(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[0]);
    d.setPad(padin.parse("RB"));
    frame(&d);
    ok(d.padShoulder == 1, "RB reads as shoulder +1");
    frame(&d);
    ok(d.padShoulder == 0, "for one frame");
    d.setPad(padin.parse("LB"));
    frame(&d);
    ok(d.padShoulder == -1, "LB reads as -1");
    d.setPad(padin.parse(""));
    frame(&d);
    // the on-screen keyboard hook
    d.focusNode(AR[0]);
    d.setPad(padin.parse("Right"));
    frame(&d);
    ok(d.padText >= 0 && d.padText == d.focused() && d.focused() != AR[0], "moving onto a text box names it in padText (the on-screen keyboard hook)");
    d.setPad(padin.parse(""));
    frame(&d);
    ok(d.padText == -1, "for one frame");
    d.focusNode(G[0]);
    // mouse move hides the ring
    press(&d, "Down");
    ok(d.focusVisible(), "ring shows after a pad move");
    d.simInput(300.0, 500.0, false, 0.0);
    frame(&d);
    ok(!d.focusVisible() && !d.keyboard(), "a mouse move hides the ring again");
    // hotplug: no pad at all, polled
    d.usePad(false);
    for i in 0..5 { frame(&d); }
    ok(d.focused() >= 0, "polling with no pad attached does nothing");
}

fn testArrows(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(AR[0]);
    d.setKeyboard(true);
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() != AR[0] && d.focused() >= 0, "an arrow moves focus inside a focus-group with arrows");
    let tb = d.focused();
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() == tb, "a text box keeps its arrow keys");
    d.focusNode(G[0]);
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() == G[0], "outside such a group the arrows do nothing");
}

fn testHotplug(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(L[0]);
    d.setPad(padin.parse("Down"));
    for f in 0..30 { frame(&d); }
    let held = d.focused();
    ok(held != L[0], "a held direction moves");
    // unplugged while held: nothing repeats, focus stays
    d.setPad(PadRaw { attached: false, mask: 1 + 2 + 16 });
    for f in 0..60 { frame(&d); }
    ok(d.focused() == held, "a pad unplugged mid-hold stops repeating and focus stays");
    ok(CLICKS == 0, "and no button was activated");
    // plugged in again with the direction still down: moves at once, then repeats on the clock
    d.setPad(padin.parse("Down"));
    frame(&d);
    ok(d.focused() != held, "plugged in again: the held direction moves at once");
    let at = d.focused();
    for f in 0..10 { frame(&d); }
    ok(d.focused() == at, "and waits the first-repeat delay");
    d.setPad(PadRaw { attached: false });
    for f in 0..60 { frame(&d); }
    ok(d.focused() == at, "unplugged again: still");
    d.usePad(false);
    for f in 0..5 { frame(&d); }
    ok(d.focused() == at, "back to polling: no crash, no move");
    // two pads at once: any pad's button counts, the larger push wins an axis
    let a = padin.parse("Down SLeft");
    let b = padin.parse("A SRight RT");
    b.lx = 0.9;
    a.lx = -0.4;
    let m = padin.merge(&a, &b);
    ok(padin.has(m.mask, padin.B_DOWN) && padin.has(m.mask, padin.B_A) && m.lx == 0.9 && m.rt == 1.0 && m.attached, "two pads merge: buttons or'd, larger axis wins");
    let off = PadRaw { attached: false };
    let un = padin.merge(&off, &off);
    ok(!un.attached, "two unplugged pads are unplugged");
    let one = padin.merge(&off, &b);
    ok(one.attached && padin.has(one.mask, padin.B_A), "one of two plugged in drives");
    // pad 1 pressing while pad 0 is also held: one move per direction, driven by the merged state
    d.focusNode(L[0]);
    d.setPad(m);
    frame(&d);
    ok(CLICKS == 1 || d.focused() >= 0, "merged input runs");
}

fn testTextareaA(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(TA);
    d.setPad(padin.parse("A"));
    frame(&d);
    ok(d.padText == TA, "A on a textarea asks for the on-screen keyboard");
    d.setPad(padin.parse(""));
    frame(&d);
    frame(&d);
    ok(d.strValue(TA).len == 0, "and types no newline");
    d.focusNode(TXT);
    d.setPad(padin.parse("A"));
    frame(&d);
    ok(d.padText == -1 && d.kin.enter, "A on a single-line box is still Enter (submit)");
}

fn testMouseAfterPad(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    press(&d, "Down");
    press(&d, "Right");
    ok(d.focusVisible() && padnav.usingPad(&d), "pad focus: ring, pad is the last device");
    // a click on the focused button (no focus change, no big move) switches back
    let f = d.focused();
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    ok(!padnav.usingPad(&d), "a mouse move ends pad mode");
    press(&d, "Down");
    ok(d.focusVisible() && padnav.usingPad(&d) && d.keyboard(), "pad input again restores the ring");
    f = d.focused();
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, true, 0.0);
    frame(&d);
    ok(!d.keyboard() && !d.focusVisible() && !padnav.usingPad(&d), "a mouse press hides the ring and sets pointer modality");
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    press(&d, "Right");
    ok(d.keyboard() && d.focusVisible() && padnav.usingPad(&d), "and the pad restores it again");
}

fn testIdleCost(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[0]);
    d.usePad(false);
    let v0 = d.padVisits;
    let r0 = d.padReads;
    for i in 0..60 { frame(&d); }
    ok(d.padReads == r0 && d.padVisits == v0, "no pad attached: no pad reads and no geometry in 60 frames");
    // a plugged-in pad that is not touched: read each frame, still no geometry
    d.setPad(padin.parse(""));
    for i in 0..60 { frame(&d); }
    ok(d.padReads == r0 + 60 && d.padVisits == v0, "an idle pad is one read per frame and no search");
}

fn testBig(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    bigFrame(&d);
    bigFrame(&d);
    ok(d.nodes.len > 500, "500 buttons built");
    press2(&d, "Down");
    let first = d.focused();
    ok(first >= 0, "the first move focuses the first button");
    let v0 = d.padVisits;
    press2(&d, "Down");
    let visits = d.padVisits - v0;
    ok(visits <= d.nodes.len && visits > 0, `one move looks at each node at most once ({visits} of {d.nodes.len})`);
    ok(d.absY(d.focused()) > d.absY(first) && d.absX(d.focused()) == d.absX(first), "and moves one row down");
    // 50 moves: linear, not quadratic
    v0 = d.padVisits;
    for i in 0..50 { press2(&d, "Right"); }
    ok(d.padVisits - v0 <= 50 * d.nodes.len, "50 moves cost at most 50 passes");
    ok(d.laid < 100000, "no layout storm");
}

fn testIdle(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    press(&d, "Down");
    press(&d, "Right");
    frame(&d);
    let used = d.mem.used;
    let laid = d.laid;
    let rest = d.restyled;
    for i in 0..30 { frame(&d); }
    ok(d.mem.used == used && d.laid == laid && d.restyled == rest, "idle frames with the pad polled allocate, lay out and restyle nothing");
}
