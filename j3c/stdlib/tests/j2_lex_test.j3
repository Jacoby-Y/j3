// Tests for the j2 lexer (`j3.j2.lex`): the example scripts lex cleanly, every token kind,
// backtick strings with nested holes, line:col after a multiline string, and error text.
//   timeout 60 j3c run j3c/stdlib/tests/j2_lex_test.j3   (from the repo root or j3c/)
// Panics on the first failed check.

module j2_lex_test;

use j3.io.{ exists, printLn, readFile };
use j3.j2.lex;
use j3.j2.lex.{ Token, SyntaxError };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.text.Text;

fn ok(cond: bool, msg: string) {
    if !cond {
        panic(msg);
    }
}

fn toks(src: string, mem: &Arena): []Token {
    match lex.lex("t.j2", src, mem) {
        Result.Ok(ts) { return ts; }
        Result.Err(e) {
            printLn(e.text);
            panic("unexpected lex error");
        }
    }
    return mem.alloc::<Token>(0);
}

fn lexErr(src: string, want: string, mem: &Arena) {
    match lex.lex("t.j2", src, mem) {
        Result.Ok(_) {
            printLn(`no error for: {src}`);
            panic("expected a lex error");
        }
        Result.Err(e) {
            if !(e.text == want) {
                printLn(`got  [{e.text}]`);
                printLn(`want [{want}]`);
                panic("lex error text");
            }
        }
    }
}

/// Kinds of `src`'s tokens, without the final EOF, as a comma list.
fn kinds(src: string, mem: &Arena): string {
    let ts = toks(src, mem);
    let t = Text.new(mem);
    for i in 0..ts.len - 1 {
        if i > 0 { t.push(44); }
        t.pushInt(ts[i].kind);
    }
    return t.str();
}

fn testKinds(mem: &Arena) {
    let src = "( ) { } [ ] , ; : . .. = == ! != < <= > >= + - * / % && || += -= *= /= %=";
    let ts = toks(src, mem);
    let want: [31]int = [lex.T_LPAREN, lex.T_RPAREN, lex.T_LBRACE, lex.T_RBRACE, lex.T_LBRACK, lex.T_RBRACK,
        lex.T_COMMA, lex.T_SEMI, lex.T_COLON, lex.T_DOT, lex.T_DOTDOT, lex.T_ASSIGN, lex.T_EQ, lex.T_NOT, lex.T_NE,
        lex.T_LT, lex.T_LE, lex.T_GT, lex.T_GE, lex.T_PLUS, lex.T_MINUS, lex.T_STAR, lex.T_SLASH, lex.T_PERCENT,
        lex.T_AND, lex.T_OR, lex.T_PLUS_EQ, lex.T_MINUS_EQ, lex.T_STAR_EQ, lex.T_SLASH_EQ, lex.T_PERCENT_EQ];
    ok(ts.len == want.len + 1, "punct count");
    for i in 0..want.len { ok(ts[i].kind == want[i], "punct kind"); }
    ok(ts[want.len].kind == lex.T_EOF, "ends with EOF");

    let kw = toks("let const fn return if else while for in break continue match pub use nil true false this _ x1", mem);
    for i in 0..17 { ok(kw[i].kind == lex.K_LET + i, "keyword kind"); }
    ok(kw[17].kind == lex.T_NAME && kw[18].kind == lex.T_NAME && kw[19].kind == lex.T_NAME, "names");

    let nums = toks("42 0xff 1_000 2.5 1e9 3.0e-2 0..3 7.x", mem);
    ok(nums[0].kind == lex.T_INT && nums[0].i == 42, "int");
    ok(nums[1].kind == lex.T_INT && nums[1].i == 255, "hex");
    ok(nums[2].kind == lex.T_INT && nums[2].i == 1000, "underscores");
    ok(nums[3].kind == lex.T_FLOAT && nums[3].f == 2.5, "float");
    ok(nums[4].kind == lex.T_FLOAT && nums[4].f == 1000000000.0, "exponent");
    ok(nums[5].kind == lex.T_FLOAT && nums[5].f == 0.03, "negative exponent");
    ok(nums[6].kind == lex.T_INT && nums[7].kind == lex.T_DOTDOT && nums[8].kind == lex.T_INT, "range is int .. int");
    ok(nums[9].kind == lex.T_INT && nums[10].kind == lex.T_DOT && nums[11].kind == lex.T_NAME, "7.x");
    let big = toks("9223372036854775807", mem);
    ok(big[0].i == 9223372036854775807, "max int");

    let strs = toks("\"a\\n\\\"b\" `plain` // comment\n", mem);
    ok(strs[0].kind == lex.T_STR && lex.decode("\"a\\n\\\"b\"", strs[0].s, strs[0].e, mem) == "a\n\"b", "escapes");
    ok(strs[1].kind == lex.T_STR, "backtick without holes is a string");
    let ansi = "\"\\e[31mR\\x1b[0m \\u{e9}\\u{20ac}\\u{1F600}\"";
    let at = toks(ansi, mem);
    let d = lex.decode(ansi, at[0].s, at[0].e, mem);
    let bytes: [20]u8 = [27, 91, 51, 49, 109, 82, 27, 91, 48, 109, 32, 0xc3, 0xa9, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80];
    let same = at[0].kind == lex.T_STR && d.len == 20;
    for i in 0..20 {
        if same && d[i] != bytes[i] { same = false; }
    }
    ok(same, "hex, esc, unicode escapes");
    ok(strs[2].kind == lex.T_EOF, "comment skipped");
}

fn testTemplates(mem: &Arena) {
    // `x {a.b(c)} y {`{n}`} z` with a table literal inside a hole
    let src = "`x {a.b(c)} y {f({k: `{n}`})} z`";
    let k = kinds(src, mem);
    let t = Text.new(mem);
    let parts: [21]int = [lex.T_TPL_HEAD, lex.T_NAME, lex.T_DOT, lex.T_NAME, lex.T_LPAREN, lex.T_NAME, lex.T_RPAREN,
        lex.T_TPL_MID, lex.T_NAME, lex.T_LPAREN, lex.T_LBRACE, lex.T_NAME, lex.T_COLON,
        lex.T_TPL_HEAD, lex.T_NAME, lex.T_TPL_TAIL, lex.T_RBRACE, lex.T_RPAREN, lex.T_TPL_TAIL, -1, -1];
    for i in 0..19 {
        if i > 0 { t.push(44); }
        t.pushInt(parts[i]);
    }
    if !(k == t.str()) {
        printLn(`got  {k}`);
        printLn(`want {t.str()}`);
        panic("template tokens");
    }
    let ts = toks(src, mem);
    ok(lex.decode(src, ts[0].s, ts[0].e, mem) == "x ", "head text");
    ok(lex.decode(src, ts[7].s, ts[7].e, mem) == " y ", "mid text");
    ok(lex.decode(src, ts[18].s, ts[18].e, mem) == " z", "tail text");
    // an escaped brace is text, not a hole
    let esc = toks("`a \\{b} c`", mem);
    ok(esc[0].kind == lex.T_STR && esc[1].kind == lex.T_EOF, "escaped brace");
}

fn testPositions(mem: &Arena) {
    let src = "let s = `one\ntwo {x}\nthree`;\n  next";
    let ts = toks(src, mem);
    // let s = HEAD x TAIL ; next EOF
    ok(ts[3].kind == lex.T_TPL_HEAD && ts[3].line == 1 && ts[3].col == 9, "template start");
    ok(ts[4].kind == lex.T_NAME && ts[4].line == 2 && ts[4].col == 6, "hole name position");
    ok(ts[5].kind == lex.T_TPL_TAIL && ts[5].line == 2 && ts[5].col == 7, "tail position");
    ok(ts[6].kind == lex.T_SEMI && ts[6].line == 3 && ts[6].col == 7, "after multiline string");
    ok(ts[7].kind == lex.T_NAME && ts[7].line == 4 && ts[7].col == 3, "next line");
}

fn testErrors(mem: &Arena) {
    lexErr("let s = \"abc", "t.j2:1:9: unterminated string", mem);
    lexErr("let s = \"ab\nc\";", "t.j2:1:9: unterminated string", mem);
    lexErr("x\n  `abc\n\n", "t.j2:2:3: unterminated string", mem);
    lexErr("`a {b", "t.j2:1:1: unterminated string", mem);
    lexErr("`a {`b {c}", "t.j2:1:5: unterminated string", mem);
    lexErr("let a = 1 # 2;", "t.j2:1:11: unexpected character `#`", mem);
    lexErr("a & b", "t.j2:1:3: unexpected character `&`", mem);
    lexErr("\"bad \\q\"", "t.j2:1:6: unknown escape `\\q`", mem);
    lexErr("\"bad \\x4\"", "t.j2:1:6: unknown escape `\\x`", mem);
    lexErr("\"bad \\u{110000}\"", "t.j2:1:6: unknown escape `\\u`", mem);
    lexErr("99999999999999999999", "t.j2:1:1: number too big", mem);
    lexErr("1e999", "t.j2:1:1: number too big", mem);
    lexErr("0x", "t.j2:1:1: expected hex digits after `0x`", mem);
    lexErr("1e+", "t.j2:1:2: expected digits after the exponent", mem);
    // nothing in an arbitrary byte soup can crash the lexer
    let soup = mem.alloc::<u8>(4096);
    let seed = 12345;
    for i in 0..soup.len {
        seed = seed * 6364136223846793005 + 1442695040888963407;
        soup[i] = u8((seed >> 33) & 127);
    }
    for n in 0..64 {
        match lex.lex("soup", (soup[0..n * 64] as string), mem) {
            Result.Ok(_) { }
            Result.Err(_) { }
        }
    }
}

fn scriptDir(): string {
    if exists("examples/j2_script/j2-scripts/hello/main.j2") {
        return "examples/j2_script/j2-scripts/";
    }
    return "../examples/j2_script/j2-scripts/";
}

fn testScripts(mem: &Arena) {
    let names: [4]string = ["base", "hello", "slimes", "turrets"];
    for i in 0..names.len {
        let path = Text.new(mem);
        path.pushStr(scriptDir());
        path.pushStr(names[i]);
        path.pushStr("/main.j2");
        match readFile(path.str(), mem) {
            Result.Ok(bytes) {
                let ts = toks(bytes as string, mem);
                ok(ts.len > 20, "script has tokens");
            }
            Result.Err(_) {
                printLn(path.str());
                panic("cannot read example script");
            }
        }
    }
}

fn main() {
    let mem = Arena.create(1 << 20);
    testKinds(&mem);
    testTemplates(&mem);
    testPositions(&mem);
    testErrors(&mem);
    testScripts(&mem);
    printLn("j2_lex_test ok");
}
