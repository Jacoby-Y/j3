// j3.game.clipboardTypes / clipboardData under the offscreen driver: both come back empty, nothing crashes.
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/clipdata_test.j3
// Without SDL_VIDEODRIVER it reads the real desktop clipboard and prints what it found (copy something first).

module clipdata_test;

use j3.game;
use j3.io.printLn;
use j3.sys.{ env, panic };
use j3.text.same;

fn main() {
    let headless = same(env("SDL_VIDEODRIVER"), "offscreen");
    let types = game.clipboardTypes();
    for i in 0..types.len {
        printLn(types[i]);
    }
    let png = game.clipboardData("image/png");
    let text = game.clipboardData("text/plain");
    let none = game.clipboardData("application/x-not-offered");
    if none.len != 0 {
        panic("clipdata: unoffered type gave bytes");
    }
    if headless && (types.len != 0 || png.len != 0 || text.len != 0) {
        panic("clipdata: headless clipboard not empty");
    }
    printLn("clipdata ok");
}
