// Tests for j3.game.hotkey: headless and no-display runs return an error instead of grabbing keys.
//   SDL_VIDEODRIVER=offscreen timeout 60 j3c run j3c/stdlib/tests/hotkey_test.j3
// Panics on the first failed check.

module hotkey_test;

use j3.game.Key;
use j3.game.hotkey;
use j3.game.hotkey.HotkeyError;
use j3.io.printLn;
use j3.result.Result;
use j3.sys.panic;

fn main() {
    match hotkey.register(Key.F8, hotkey.CTRL + hotkey.SHIFT) {
        Result.Ok(h) { panic("hotkey_test: registered under offscreen"); }
        Result.Err(e) {
            match e {
                HotkeyError.NoDisplay { printLn("ok: NoDisplay"); }
                HotkeyError.Unsupported { panic("hotkey_test: Unsupported"); }
                HotkeyError.Taken { panic("hotkey_test: Taken"); }
                HotkeyError.UnknownKey { panic("hotkey_test: UnknownKey"); }
                HotkeyError.Full { panic("hotkey_test: Full"); }
            }
        }
    }
}
