// Tests for scroll snap, scroll-padding / -margin, animated scrolling, scrollIntoView, byId and scrollToKey (`j3.ui.dom` part
// `dom/snap.j3`, `j3.ui.vlist`) with synthetic wheel input. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 120 j3c run j3c/stdlib/tests/scroll_test.j3 --headless
// Panics on the first failed check.

module scroll_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.{ Dom, SC_CENTER, SC_END, SC_NEAREST, SC_START };
use j3.ui.inputs;
use j3.ui.vlist;
use j3.ui.vstate.VList;

const SHEET: string = ".car { display: flex; width: 300px; height: 100px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; } .card { flex-shrink: 0; width: 100px; height: 100px; scroll-snap-align: start; } .card.wide { width: 150px; } .col { width: 100px; height: 100px; overflow-y: auto; scroll-snap-type: y mandatory; } .prox { scroll-snap-type: y proximity; } .pad { scroll-padding-top: 10px; } .row { height: 50px; scroll-snap-align: start; } .big { height: 200px; } .alw { scroll-snap-stop: always; } .outer { width: 100px; height: 100px; overflow-y: auto; } .outer.pm { scroll-padding-top: 15px; } .inner { height: 80px; overflow-y: auto; } .spacer { height: 200px; } .tgt { height: 20px; } .pm .tgt { scroll-margin-top: 5px; } .fill { height: 120px; } .tail { height: 300px; } .btn { display: block; height: 20px; } dialog { width: 80px; height: 300px; } .dbtn { display: block; margin-top: 250px; height: 20px; } .gone { display: none; } .virt { box-sizing: border-box; width: 100px; height: 100px; overflow-y: auto; } .vrow { height: 30px; } .vrow.tall { height: 50px; }";

#[singleton]
let CHECKS: int;
// node ids: 0 carousel, 1 mandatory column, 2 proximity column, 3 always column, 4 padded column, 5 outer, 6 inner, 7 target, 8 button, 9 virtual box, 10 variable virtual box
#[singleton]
let ID: [12]int;
#[singleton]
let UID: [1100]int;
// the order the carousel cards are built in (their keys), and each key's node
#[singleton]
let ORDER: [6]int;
#[singleton]
let CARD: [7]int;
#[singleton]
let DROP2: bool;
#[singleton]
let EXTRA: bool;
#[singleton]
let HIDEV: bool;
#[singleton]
let MODAL: bool;
#[singleton]
let DB: int;
#[singleton]
let WIDE: bool;
#[singleton]
let PM: bool;
#[singleton]
let VLF: VList;
#[singleton]
let VLV: VList;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    let e = a - b;
    if e < 0.0 { e = 0.0 - e; }
    if e > 0.6 {
        printLn(`{msg}: {a} vs {b}`);
    }
    ok(e <= 0.6, msg);
}

fn column(d: &Dom, k: int, cls: string, big: bool, always: bool) {
    let c = d.open(k, d.tag("div"), 1);
    d.cls(c, "col");
    if cls.len > 0 { d.cls(c, cls); }
    ID[k] = c;
    for i in 0..6 {
        let r = d.open(i, d.tag("div"), 1);
        d.cls(r, "row");
        if big { d.cls(r, "big"); }
        if always { d.cls(r, "alw"); }
        d.close();
    }
    d.close();
}

/// A virtual list built the way generated code does: keys `k0`.., window from `vlist.step`.
fn virt(d: &Dom, k: int, v: &VList, variable: bool) {
    let n = 100;
    let b = d.open(k, d.tag("div"), 1);
    d.cls(b, "virt");
    if k == 10 { d.clsIf(b, "gone", HIDEV); }
    ID[k] = b;
    v.cfg(if variable { 0.0 } else { 30.0 }, 30.0, false, false);
    if v.stale(n) {
        v.all.begin();
        for i in 0..n { v.all.add(`k{i}`); }
        v.all.finish("virt");
        v.rebuilt(n);
    }
    let w = vlist.step(d, b, v, n);
    for q in 0..v.cnt {
        let i = v.at(q);
        // each row is a keyed group, as `{#each}` makes it (the list measures rows as runs of one group)
        if UID[k * 100 + i] < 0 { UID[k * 100 + i] = d.groupNew(-1); }
        d.keyBegin(UID[k * 100 + i]);
        let r = d.open(0, d.tag("div"), 1);
        d.cls(r, "vrow");
        if variable && i % 2 == 1 { d.cls(r, "tall"); }
        d.attrId(r, `r{k}_{i}`);
        d.close();
        d.keyEnd();
    }
    d.close();
}

/// One keyed carousel card, as `{#each cards as c (c)}` makes it: it follows its key when the order changes.
fn card(d: &Dom, key: int) {
    if UID[1000 + key] < 0 { UID[1000 + key] = d.groupNew(-1); }
    d.keyBegin(UID[1000 + key]);
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, "card");
    d.clsIf(c, "wide", WIDE);
    CARD[key] = c;
    d.close();
    d.keyEnd();
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 1000.0 });
    inputs.begin(d);
    let car = d.open(0, d.tag("div"), 1);
    d.cls(car, "car");
    ID[0] = car;
    for q in 0..6 {
        if !(DROP2 && ORDER[q] == 2) { card(d, ORDER[q]); }
    }
    if EXTRA { card(d, 6); }
    d.close();
    column(d, 1, "", false, false);
    column(d, 2, "prox", true, false);
    column(d, 3, "", false, true);
    column(d, 4, "pad", false, false);
    let o = d.open(5, d.tag("div"), 1);
    d.cls(o, "outer");
    d.clsIf(o, "pm", PM);
    ID[5] = o;
    let f = d.open(0, d.tag("div"), 1);
    d.cls(f, "fill");
    let vb = d.open(4, d.tag("button"), 1);
    d.cls(vb, "btn");
    ID[11] = vb;
    d.close();
    d.close();
    let inn = d.open(1, d.tag("div"), 1);
    d.cls(inn, "inner");
    ID[6] = inn;
    let sp = d.open(0, d.tag("div"), 1);
    d.cls(sp, "spacer");
    d.close();
    let t = d.open(1, d.tag("div"), 1);
    d.cls(t, "tgt");
    d.attrId(t, "tgt");
    ID[7] = t;
    d.close();
    let tl = d.open(2, d.tag("div"), 1);
    d.cls(tl, "tail");
    d.close();
    d.close();
    let tl2 = d.open(2, d.tag("div"), 1);
    d.cls(tl2, "tail");
    d.close();
    if MODAL {
        // a modal dialog inside the scroll box: fixed to the viewport, so it is no business of the box's scroll
        let dg = d.open(5, d.tag("dialog"), 1);
        d.attrOverlay(dg, dom.OV_MODAL);
        let db = d.open(0, d.tag("button"), 1);
        d.cls(db, "dbtn");
        DB = db;
        d.close();
        d.close();
    }
    let bt = d.open(3, d.tag("button"), 1);
    d.cls(bt, "btn");
    ID[8] = bt;
    d.close();
    d.close();
    virt(d, 9, &VLF, false);
    virt(d, 10, &VLV, true);
    d.layout();
    d.endFrame();
}

fn idle(d: &Dom, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d);
    }
}

fn cx(d: &Dom, id: int): f32 { return d.absX(id) + d.nodes.items[id].w / 2.0; }
fn cy(d: &Dom, id: int): f32 { return d.absY(id) + d.nodes.items[id].h / 2.0; }

/// `notches` forward over the middle of `id`.
fn wheel(d: &Dom, id: int, notches: f32) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0 - notches);
    frame(d);
}

fn sy(d: &Dom, k: int): f32 { return d.nodes.items[ID[k]].scrollY; }
fn sx(d: &Dom, k: int): f32 { return d.nodes.items[ID[k]].scrollX; }

fn testSnap(d: &Dom) {
    ok(sx(d, 0) == 0.0 && d.nodes.items[ID[0]].scrollMaxX == 300.0, "carousel starts at 0 and can scroll 300");
    wheel(d, ID[0], 2.0);
    near(sx(d, 0), 96.0, "two notches scroll 96 px at once");
    idle(d, 2);
    near(sx(d, 0), 96.0, "the box waits for the gesture to rest before snapping");
    ok(d.isLive(), "live while a snap is pending");
    idle(d, 10);
    ok(sx(d, 0) > 96.0 && sx(d, 0) < 100.0 || d.isLive(), "the settle animates");
    ok(d.isLive(), "live while the settle runs");
    idle(d, 60);
    near(sx(d, 0), 100.0, "mandatory snap lands on the nearest card");
    ok(!d.isLive() && d.snapPend == 0, "idle after the settle");
    // a notch less than half a card goes back
    wheel(d, ID[0], 1.0);
    idle(d, 70);
    near(sx(d, 0), 100.0, "48 px past a snap point returns to it");
    wheel(d, ID[0], 5.0);
    idle(d, 70);
    near(sx(d, 0), 300.0, "the last card (clamped range) is a snap point");
    wheel(d, ID[0], -1.0);
    idle(d, 70);
    near(sx(d, 0), 300.0, "backwards 48 px from 300 snaps back to 300");

    // proximity: far from a snap point it does nothing, near one it snaps
    d.scrollBy(ID[2], 48.0);
    idle(d, 70);
    near(sy(d, 2), 48.0, "proximity: 48 px from a point 200 px apart (view 100) stays");
    d.scrollBy(ID[2], -28.0);
    idle(d, 70);
    near(sy(d, 2), 0.0, "proximity: 20 px from a point snaps to it");

    // scroll-snap-stop: always
    for i in 0..4 { wheel(d, ID[3], 1.0); }
    near(sy(d, 3), 192.0, "four notches in one gesture");
    idle(d, 70);
    near(sy(d, 3), 50.0, "always: the gesture stops at the first row it reached");
    for i in 0..4 { wheel(d, ID[1], 1.0); }
    idle(d, 70);
    near(sy(d, 1), 200.0, "normal stop: the nearest point, the end");

    // scroll-padding
    wheel(d, ID[4], 1.0);
    idle(d, 70);
    near(sy(d, 4), 40.0, "scroll-padding-top 10 puts the row 10 px below the top");
    ok(!d.isLive(), "steady after every settle");

    // resize / relayout keeps the snapped card
    wheel(d, ID[0], -4.0);
    idle(d, 70);
    d.scrollTo(ID[0], 100.0, 0.0, false);
    near(sx(d, 0), 100.0, "scrollTo a snap point");
    WIDE = true;
    frame(d);
    near(sx(d, 0), 150.0, "after cards grow the box is still on the second card");
    WIDE = false;
    frame(d);
    near(sx(d, 0), 100.0, "and back");
    d.scrollTo(ID[0], 130.0, 0.0, false);
    near(sx(d, 0), 100.0, "scrollTo snaps to the nearest point");

    // reduced motion: the settle jumps
    d.setReducedMotion(true);
    wheel(d, ID[0], 2.0);
    idle(d, 9);
    near(sx(d, 0), 200.0, "reduced motion: the snap is a jump");
    ok(!d.isLive(), "no animation under reduced motion");
    d.setReducedMotion(false);
    d.scrollTo(ID[0], 0.0, 0.0, false);
    idle(d, 3);

    // a snap container with nothing scrolling does no snap work and lays nothing out
    let work = d.snapWork;
    let laid = d.laid;
    let styled = d.restyled;
    idle(d, 40);
    ok(d.snapWork == work && d.laid == laid && d.restyled == styled && d.snapPend == 0 && !d.snapDirty, "idle frames with snap containers do no snap, layout or style work");

    // keyed reorder: the carousel stays on the card it snapped to (the same key, not the same index)
    d.scrollTo(ID[0], 200.0, 0.0, false);
    ok(CARD[2] == d.nodes.items[ID[0]].snapKx, "card with key 2 is the snapped item");
    for q in 0..6 { ORDER[q] = 5 - q; }
    frame(d);
    near(sx(d, 0), 300.0, "after a reverse sort the box follows key 2 to index 3");
    near(d.absX(CARD[2]) - d.absX(ID[0]), 0.0, "and it still sits at the start edge");
    for q in 0..6 { ORDER[q] = q; }
    frame(d);
    near(sx(d, 0), 200.0, "sorted back, back on index 2");

    // the snapped card is freed and its node id reused by a new card before the box re-snaps: the new card is not followed
    d.scrollTo(ID[0], 200.0, 0.0, false);
    let old = CARD[2];
    ok(d.nodes.items[ID[0]].snapKx == old, "snapped to card 2");
    d.scrollByX(ID[0], 1.0);
    DROP2 = true;
    frame(d);
    EXTRA = true;
    frame(d);
    ok(CARD[6] == old, "the new card reuses the freed node id");
    d.nodes.items[ID[0]].snapAt = -1.0;
    d.snapPend = 0;
    WIDE = true;
    frame(d);
    ok(d.nodes.items[ID[0]].snapKx == -1, "the reused id is not taken for the snapped card");
    WIDE = false;
    DROP2 = false;
    EXTRA = false;
    frame(d);
    d.scrollTo(ID[0], 0.0, 0.0, false);
    idle(d, 3);
}

fn testIntoView(d: &Dom) {
    frame(d);
    ok(d.byId("tgt") == ID[7] && d.byId("nope") == -1, "byId finds a static id, -1 for none");
    d.scrollIntoView(ID[7], SC_START, false);
    near(d.nodes.items[ID[6]].scrollY, 200.0, "start: the inner box scrolls the target to its top");
    near(d.nodes.items[ID[5]].scrollY, 120.0, "start: then the outer box brings the inner one up");
    d.scrollIntoView(ID[7], SC_CENTER, false);
    near(d.nodes.items[ID[6]].scrollY, 170.0, "center: inner");
    near(d.nodes.items[ID[5]].scrollY, 110.0, "center: outer");
    d.scrollIntoView(ID[7], SC_NEAREST, false);
    near(d.nodes.items[ID[6]].scrollY, 170.0, "nearest: nothing moves when it shows");
    near(d.nodes.items[ID[5]].scrollY, 110.0, "nearest: outer too");
    d.scrollIntoView(ID[7], SC_END, false);
    near(d.nodes.items[ID[6]].scrollY, 140.0, "end: inner");
    near(d.nodes.items[ID[5]].scrollY, 100.0, "end: outer");
    d.scrollTo(ID[5], 0.0, 0.0, false);
    d.scrollTo(ID[6], 0.0, 0.0, false);
    PM = true;
    frame(d);
    d.scrollIntoView(ID[7], SC_START, false);
    near(d.nodes.items[ID[6]].scrollY, 195.0, "scroll-margin-top 5 of the target");
    near(d.nodes.items[ID[5]].scrollY, 105.0, "scroll-padding-top 15 of the outer box");
    PM = false;
    d.scrollTo(ID[5], 0.0, 0.0, false);
    d.scrollTo(ID[6], 0.0, 0.0, false);
    frame(d);

    // smooth: the target is reached over frames; reduced motion jumps
    d.scrollIntoView(ID[7], SC_START, true);
    near(d.nodes.items[ID[5]].scrollY, 0.0, "smooth: nothing moves at once");
    ok(d.isLive(), "smooth scroll is live");
    idle(d, 5);
    ok(d.nodes.items[ID[6]].scrollY > 0.0 && d.nodes.items[ID[6]].scrollY < 200.0, "smooth: on the way");
    idle(d, 80);
    near(d.nodes.items[ID[6]].scrollY, 200.0, "smooth: arrives (inner)");
    near(d.nodes.items[ID[5]].scrollY, 120.0, "smooth: arrives (outer)");
    ok(!d.isLive(), "smooth scroll ends");
    d.scrollTo(ID[5], 0.0, 0.0, false);
    d.scrollTo(ID[6], 0.0, 0.0, false);
    d.setReducedMotion(true);
    d.scrollIntoView(ID[7], SC_START, true);
    near(d.nodes.items[ID[6]].scrollY, 200.0, "reduced motion: smooth is instant");
    d.setReducedMotion(false);
    d.scrollTo(ID[5], 0.0, 0.0, false);
    d.scrollTo(ID[6], 0.0, 0.0, false);

    // a key moves focus to a button below the fold: it is revealed
    idle(d, 2);
    d.setKeyboard(true);
    d.focusNode(ID[8]);
    idle(d, 3);
    ok(d.nodes.items[ID[5]].scrollY > 0.0, "keyboard focus scrolls the box");
    let b = ID[8];
    ok(d.absY(b) >= d.absY(ID[5]) - 0.5 && d.absY(b) + 20.0 <= d.absY(ID[5]) + 100.5, "and the button is inside it");
    d.setKeyboard(false);
    d.focusNode(-1);

    // nearest does nothing for a button that already shows, even one a key focuses
    d.scrollTo(ID[5], 0.0, 0.0, false);
    idle(d, 2);
    d.setKeyboard(true);
    d.focusNode(ID[11]);
    idle(d, 3);
    near(d.nodes.items[ID[5]].scrollY, 0.0, "focusing a fully visible button scrolls nothing");
    d.scrollTo(ID[5], 10.0, 0.0, false);
    idle(d, 2);
    d.focusNode(-1);
    d.focusNode(ID[11]);
    idle(d, 3);
    near(d.nodes.items[ID[5]].scrollY, 0.0, "a button half out of view is brought in (nearest)");

    // a modal dialog inside the box is fixed to the viewport: focusing its button moves nothing behind it
    d.scrollTo(ID[5], 0.0, 0.0, false);
    MODAL = true;
    idle(d, 3);
    ok(d.nodes.items[DB].laid && d.absY(DB) >= d.absY(ID[5]) + 99.5, "the dialog's button is below the box's view");
    d.setKeyboard(true);
    d.focusNode(DB);
    idle(d, 4);
    near(d.nodes.items[ID[5]].scrollY, 0.0, "focus in a modal dialog does not scroll the page behind it");
    MODAL = false;
    d.setKeyboard(false);
    d.focusNode(-1);
    idle(d, 3);
}

fn rowTop(d: &Dom, k: int, i: int): f32 {
    let r = d.byId(`r{k}_{i}`);
    ok(r >= 0, `row {i} is built`);
    return d.absY(r) - d.absY(ID[k]);
}

fn testVirtual(d: &Dom) {
    idle(d, 2);
    ok(d.byId("r9_60") == -1, "row 60 is not built yet");
    ok(!d.scrollToKey(ID[9], "nokey", SC_START), "an unknown key is refused");
    ok(!d.scrollToKey(ID[3], "k1", SC_START), "a box that is no virtual list is refused");
    ok(d.scrollToKey(ID[9], "k60", SC_START), "scrollToKey accepts a known key");
    idle(d, 2);
    near(sy(d, 9), 1800.0, "fixed rows: the box scrolled to row 60");
    near(rowTop(d, 9, 60), 0.0, "row 60 is at the top");
    ok(d.scrollToKey(ID[9], "k10", SC_CENTER), "center");
    idle(d, 2);
    near(rowTop(d, 9, 10), 35.0, "row 10 is centered");
    ok(d.scrollToKey(ID[9], "k99", SC_END), "end");
    idle(d, 2);
    near(rowTop(d, 9, 99), 70.0, "row 99 ends at the bottom");

    // variable heights: the estimate is wrong (30 against 30 / 50), so the aim is corrected once rows are measured
    idle(d, 2);
    ok(d.scrollToKey(ID[10], "k61", SC_START), "variable list accepts the key");
    idle(d, 6);
    near(rowTop(d, 10, 61), 0.0, "variable rows: row 61 ends at the top once measured");
    let y = sy(d, 10);
    idle(d, 5);
    near(sy(d, 10), y, "and stays there");
    ok(d.scrollToKey(ID[10], "k5", SC_START), "scroll back up");
    idle(d, 6);
    near(rowTop(d, 10, 5), 0.0, "row 5 at the top");

    // a list that is hidden while scrollToKey aims gives the aim up; so does one that never measures
    ok(d.scrollToKey(ID[10], "k90", SC_START), "aim again");
    HIDEV = true;
    idle(d, 4);
    ok(VLV.want == -1 && !d.isLive(), "a hidden list drops the aim and is not live");
    HIDEV = false;
    idle(d, 3);
    ok(d.scrollToKey(ID[10], "k40", SC_START), "aim");
    VLV.wantN = 31;
    idle(d, 2);
    ok(VLV.want == -1, "the aim is given up after its tries");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "scroll.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    for q in 0..1100 { UID[q] = -1; }
    for q in 0..6 { ORDER[q] = q; }
    VLF = VList.new(&mem);
    VLV = VList.new(&mem);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    idle(&d, 3);
    testSnap(&d);
    testIntoView(&d);
    testVirtual(&d);
    let used = d.mem.used;
    let laid = d.laid;
    idle(&d, 30);
    ok(d.mem.used == used && d.laid == laid && !d.isLive(), "idle frames after all that allocate and lay out nothing");
    printLn(`scroll_test ok, checks passed: {CHECKS}`);
}
