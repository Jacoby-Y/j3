// Tests for j3.game.display: mode cycling, frame-cap stepping, index wrap, and the save round trip.
// Headless `j3.game`, so no window or SDL is needed.
//   timeout 60 j3c run j3c/stdlib/tests/display_test.j3
// Panics on the first failed check.

module display_test;

use j3.game;
use j3.game.display;
use j3.game.WindowMode;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ Text, same };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("display_test");
    }
}

fn main() {
    let arena = Arena.create(1024 * 1024);
    let mem = &arena;

    ok(same(display.modeName(display.nextMode(WindowMode.Windowed)), "Borderless"), "windowed -> borderless");
    ok(same(display.modeName(display.nextMode(WindowMode.Borderless)), "Fullscreen"), "borderless -> fullscreen");
    ok(same(display.modeName(display.nextMode(WindowMode.Fullscreen)), "Windowed"), "fullscreen wraps");

    ok(display.stepFps(0, 1) == 30, "off -> 30");
    ok(display.stepFps(60, 1) == 120, "60 -> 120");
    ok(display.stepFps(240, 1) == 240, "stops at 240");
    ok(display.stepFps(30, -1) == 0, "30 -> off");
    ok(display.stepFps(0, -1) == 0, "stops at off");
    ok(display.stepFps(100, 1) == 120, "off-list steps up to the next");
    ok(display.stepFps(100, -1) == 60, "off-list steps down to the previous");

    ok(display.wrapIndex(0, -1, 4) == 3, "wrap down");
    ok(display.wrapIndex(3, 1, 4) == 0, "wrap up");
    ok(display.wrapIndex(2, 1, 0) == 0, "empty list");

    let s = display.current();
    s.mode = WindowMode.Fullscreen;
    s.w = 1920;
    s.h = 1080;
    s.vsync = true;
    s.fpsLimit = 144;
    display.store(&s, "/tmp/j3_display_test.cfg", mem);
    let back = display.load("/tmp/j3_display_test.cfg", mem);
    ok(same(display.modeName(back.mode), "Fullscreen"), "mode round trip");
    ok(back.w == 1920 && back.h == 1080, "size round trip");
    ok(back.vsync, "vsync round trip");
    ok(back.fpsLimit == 144, "fps round trip");

    display.apply(&back);
    ok(game.vsync() && game.fpsLimit() == 144, "apply records vsync and cap");

    let t = Text.new(mem);
    ok(same(display.resolutionLabel(&back, &t), "1920 x 1080"), "resolution label");
    ok(same(display.fpsLabel(0, &t), "Unlimited"), "fps label off");
    ok(same(display.fpsLabel(60, &t), "60"), "fps label");

    printLn("display_test ok");
}
