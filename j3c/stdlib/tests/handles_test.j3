// Tests for arena-built recursive data and typed handles: `Arena.new`, a 10k-node tree of `&Expr`,
// `#[Debug]` on a recursive enum, `Pool<T>` / `Id<T>` and an `Id` as a `Map` key.
//   timeout 60 j3c run j3c/stdlib/tests/handles_test.j3
// Panics on the first failed check.

module handles_test;

use j3.data.map.Map;
use j3.data.pool.{ Id, Pool };
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;

#[Debug]
enum Expr {
    Num(int),
    Neg(&Expr),
    Add(&Expr, &Expr),
}

struct Stmt {
    name: string;
    value: Id<Expr>;
}

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("handles_test");
    }
}

fn eval(e: &Expr): int {
    match *e {
        Expr.Num(n) { return n; }
        Expr.Neg(x) { return 0 - eval(x); }
        Expr.Add(l, r) { return eval(l) + eval(r); }
    }
}

fn count(e: &Expr): int {
    match *e {
        Expr.Num(_) { return 1; }
        Expr.Neg(x) { return 1 + count(x); }
        Expr.Add(l, r) { return 1 + count(l) + count(r); }
    }
}

/// A balanced tree of `n` leaves 1..n (2n - 1 nodes), built bottom-up with `mem.new`.
fn build(mem: &Arena, lo: int, hi: int): &Expr {
    if lo == hi { return mem.new(Expr.Num(lo)); }
    let mid = (lo + hi) / 2;
    return mem.new(Expr.Add(build(mem, lo, mid), build(mem, mid + 1, hi)));
}

fn main() {
    let mem = Arena.create(1 << 16);
    let leaves = 5000;
    let tree = build(&mem, 1, leaves);
    ok(count(tree) == 2 * leaves - 1, "10k nodes");
    ok(eval(tree) == leaves * (leaves + 1) / 2, "walk sums the leaves");
    // A chain 10k deep through `Neg`.
    let chain = mem.new(Expr.Num(7));
    for _ in 0..10000 { chain = mem.new(Expr.Neg(chain)); }
    ok(count(chain) == 10001 && eval(chain) == 7, "deep chain");
    // Debug prints one level: pointers show as their type, so a recursive value never loops.
    ok(`{*tree}` == "Expr.Add(&Expr, &Expr)", "debug of a recursive enum");

    let exprs = Pool<Expr>.new(&mem);
    let stmts = Pool<Stmt>.new(&mem);
    let a = exprs.add(Expr.Num(1));
    let b = exprs.add(Expr.Num(2));
    let s = stmts.add(Stmt { name: "x", value: b });
    ok(exprs.len() == 2 && stmts.len() == 1, "pool len");
    ok(eval(exprs.get(stmts.get(s).value)) == 2 && stmts.get(s).name == "x", "pool get");
    ok(a == exprs.idAt(0) && a != b, "id equality");
    let p = exprs.get(a);
    *p = Expr.Num(10);
    ok(eval(exprs.get(a)) == 10, "pool get is a pointer");

    let uses = Map<Id<Expr>, int>.new(&mem, 0);
    for i in 0..1000 {
        let id = exprs.add(Expr.Num(i));
        uses.put(id, i * 2);
    }
    uses.put(a, -1);
    ok(uses.len == 1001 && uses.getOr(exprs.idAt(500), 0) == 996 && uses.getOr(a, 0) == -1, "Id as Map key");
    printLn("handles_test ok");
}
