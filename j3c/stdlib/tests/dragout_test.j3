// j3.game.dragFiles / dragState under the offscreen driver: no drag starts, state stays Idle.
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/dragout_test.j3
// The real drag (XDND to Discord, a browser, a file manager) is tested by hand: j3c doc recipes dragout.

module dragout_test;

use j3.game;
use j3.game.DragState;
use j3.io.printLn;
use j3.sys.panic;

fn main() {
    game.init("dragout", 64, 64);
    game.poll();
    if game.dragFiles(["/tmp/x.png"]) {
        panic("dragout: drag started headless");
    }
    game.poll();
    if game.dragState() != DragState.Idle {
        panic("dragout: state not Idle");
    }
    printLn("dragout ok");
}
