// Absolute boxes inside absolute boxes keep their offsets when a sibling `{#if}` box unmounts and a `style:left` box
// mounts, moves and unmounts (`layoutAbs` lays ancestors out before descendants; `dropAbs` reorders `Dom.abs`), and an
// open `<dialog modal>` inside an `overflow-y: auto` absolute page stays centered while toasts before it come and go.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/absorder_test.j3 --headless

module absorder_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.testkit;

const SHEET: string = ".page { position: relative; height: 100%; } .extra { position: absolute; left: 4px; top: 4px; } .panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; } .info { position: absolute; left: 112px; top: 32px; display: flex; flex-direction: column; } .card { position: absolute; width: 120px; } .toasts { position: absolute; top: 30px; } .settings { position: absolute; inset: 0; overflow-y: auto; } dialog { width: 100px; height: 80px; }";

/// The shape `Upgrades.j3ui` generates: `{#if extra}` box, then a panel holding `.info` and an `{#if hover}` card.
fn frame(d: &Dom, extra: bool, hover: bool, cardX: f32) {
    d.beginFrame(Vec2 { x: 640.0, y: 360.0 });
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    if extra {
        let x = d.open(0, d.tag("div"), 1);
        d.cls(x, "extra");
        d.text("Extra");
        d.close();
    }
    let panel = d.open(1, d.tag("div"), 1);
    d.cls(panel, "panel");
    let info = d.open(0, d.tag("div"), 1);
    d.cls(info, "info");
    d.text("Info");
    d.close();
    if hover {
        let c = d.open(1, d.tag("div"), 1);
        d.cls(c, "card");
        d.styleNum(c, 0, "left", cardX);
        d.styleNum(c, 1, "top", 40.0);
        d.text("Card");
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

/// The shape of a settings page: `{#if}` toasts (absolute) ahead of an absolute scroller whose rows hold a modal dialog.
fn dialogFrame(d: &Dom, toasts: bool, tick: int) {
    d.beginFrame(Vec2 { x: 640.0, y: 360.0 });
    let page = d.open(2, d.tag("div"), 1);
    d.cls(page, "page");
    if toasts {
        let t = d.open(0, d.tag("div"), 1);
        d.cls(t, "toasts");
        d.text("Toast");
        d.close();
    }
    let s = d.open(1, d.tag("div"), 1);
    d.cls(s, "settings");
    let g = d.open(0, d.tag("dialog"), 1);
    d.attrOverlay(g, 1);
    d.text(`Stats {tick}`);
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..40 {
        frame(&d, f < 2, f >= 4 && f % 7 != 0, 50.0 + f32(f) * 9.0);
        let info = d.nodes.items[testkit.textNode(&d, "Info")].parent;
        if d.absX(info) != 112.0 || d.absY(info) != 32.0 {
            printLn(`FAIL: frame {f}: .info at {d.absX(info)},{d.absY(info)}`);
            panic(".info lost its offsets");
        }
    }
    for f in 0..20 {
        dialogFrame(&d, (f / 3) % 2 == 0, f);
        let g = d.nodes.items[testkit.textNode(&d, `Stats {f}`)].parent;
        if d.absX(g) != 270.0 || d.absY(g) != 140.0 {
            printLn(`FAIL: frame {f}: dialog at {d.absX(g)},{d.absY(g)}`);
            panic("the dialog left the center");
        }
    }
    printLn("absorder_test: PASS");
}
