// Tests for j3.steam networking messages (ISteamNetworkingMessages), relay status and the shared networking types:
// absent no-ops, the fake in-process network (sessions, accept, echo, failure, bounded inbox, handler re-entrancy),
// connection info and callbacks decoded from hand-written buffers, and every networking struct layout for both pack rules.
// Run from j3c/:  timeout 120 target/release/j3c run stdlib/tests/steam_net_test.j3
// Panics on the first failed check.

module steam_net_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.steam;
use j3.sys.panic;

#[singleton]
let R_FROM: u64;
#[singleton]
let R_N: int;
#[singleton]
let R_ACCEPT: bool;
#[singleton]
let G_N: int;
#[singleton]
let G_FROM: u64;
#[singleton]
let G_CH: i32;
#[singleton]
let G_NUM: i64;
#[singleton]
let G_CTX: u64;
#[singleton]
let G_FIRST: u8;
#[singleton]
let G_LEN: int;
#[singleton]
let G_SUM: int;
#[singleton]
let G_REENTER: int;
#[singleton]
let F_N: int;
#[singleton]
let F_PEER: u64;
#[singleton]
let F_REASON: i32;
#[singleton]
let F_DBG: string;
#[singleton]
let S_N: int;
#[singleton]
let S_AVAIL: i32;
#[singleton]
let S_MSG: string;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onReq(from: u64) {
    R_N += 1;
    R_FROM = from;
    if R_ACCEPT {
        steam.netAccept(from);
    }
}

fn onGot(from: u64, data: []u8, channel: i32, num: i64, ctx: u64) {
    G_N += 1;
    G_FROM = from;
    G_CH = channel;
    G_NUM = num;
    G_CTX = ctx;
    G_LEN = data.len;
    G_SUM += data.len;
    if data.len > 0 {
        G_FIRST = data[0];
    }
}

fn onReenter(from: u64, data: []u8, channel: i32, num: i64, ctx: u64) {
    G_N += 1;
    G_REENTER += steam.netReceive(channel, onGot, u64(0), 10);
    // a send and a delivery from inside the handler must not disturb the view of the message being handled
    steam.fakeNetDeliver(steam.FAKE_FRIEND2, channel, [u8(9), u8(9)]);
    steam.netSend(steam.FAKE_FRIEND, [u8(1)], steam.SEND_RELIABLE, channel);
    ok(data.len == 3 && data[0] == u8(7) && data[2] == u8(7), "view intact inside handler");
}

fn onFail(peer: u64, reason: i32, debug: string) {
    F_N += 1;
    F_PEER = peer;
    F_REASON = reason;
    F_DBG = debug;
}

fn onRelay(avail: i32, msg: string) {
    S_N += 1;
    S_AVAIL = avail;
    S_MSG = msg;
}

fn layouts() {
    for v in 0..2 {
        let big = v == 1;
        ok(steam.layAt("SteamNetworkingIdentity", "eType", big) == 0 && steam.layAt("SteamNetworkingIdentity", "cbSize", big) == 4, "identity head");
        ok(steam.layAt("SteamNetworkingIdentity", "steamID64", big) == 8 && steam.layAt("SteamNetworkingIdentity", steam.SIZE, big) == 136, "identity body");
        ok(steam.layAt("SteamNetworkingIPAddr", "port", big) == 16 && steam.layAt("SteamNetworkingIPAddr", steam.SIZE, big) == 18, "ipaddr");
        let m = "SteamNetworkingMessage_t";
        ok(steam.layAt(m, "pData", big) == 0 && steam.layAt(m, "cbSize", big) == 8 && steam.layAt(m, "conn", big) == 12, "message head");
        ok(steam.layAt(m, "identityPeer", big) == 16 && steam.layAt(m, "connUserData", big) == 152, "message identity");
        ok(steam.layAt(m, "usecTimeReceived", big) == 160 && steam.layAt(m, "nMessageNumber", big) == 168, "message numbers");
        ok(steam.layAt(m, "freeData", big) == 176 && steam.layAt(m, "release", big) == 184, "message fns");
        ok(steam.layAt(m, "channel", big) == 192 && steam.layAt(m, "flags", big) == 196, "message channel");
        ok(steam.layAt(m, "userData", big) == 200 && steam.layAt(m, "idxLane", big) == 208 && steam.layAt(m, steam.SIZE, big) == 216, "message tail");
        let c = "SteamNetConnectionInfo_t";
        ok(steam.layAt(c, "identityRemote", big) == 0 && steam.layAt(c, "userData", big) == 136 && steam.layAt(c, "listenSocket", big) == 144, "conn head");
        ok(steam.layAt(c, "addrRemote", big) == 148 && steam.layAt(c, "idPOPRemote", big) == 168 && steam.layAt(c, "idPOPRelay", big) == 172, "conn addr");
        ok(steam.layAt(c, "eState", big) == 176 && steam.layAt(c, "eEndReason", big) == 180, "conn state");
        ok(steam.layAt(c, "szEndDebug", big) == 184 && steam.layAt(c, "szConnectionDescription", big) == 312, "conn strings");
        ok(steam.layAt(c, "nFlags", big) == 440 && steam.layAt(c, steam.SIZE, big) == 696, "conn tail");
        ok(steam.layAt("SteamNetConnectionRealTimeStatus_t", "nPing", big) == 4, "rt ping");
        ok(steam.layAt("SteamNetworkingMessagesSessionRequest_t", "identityRemote", big) == 0, "1251 id");
        ok(steam.layAt("SteamNetworkingMessagesSessionRequest_t", steam.SIZE, big) == 136, "1251 size");
        ok(steam.layAt("SteamNetworkingMessagesSessionFailed_t", "info", big) == 0, "1252 info");
        ok(steam.layAt("SteamNetworkingMessagesSessionFailed_t", steam.SIZE, big) == 696, "1252 size");
        let r = "SteamRelayNetworkStatus_t";
        ok(steam.layAt(r, "eAvail", big) == 0 && steam.layAt(r, "eAvailNetworkConfig", big) == 8 && steam.layAt(r, "eAvailAnyRelay", big) == 12, "1281 avail");
        ok(steam.layAt(r, "debugMsg", big) == 16 && steam.layAt(r, steam.SIZE, big) == 272, "1281 text");
    }
}

/// A hand-written SteamNetConnectionInfo_t (SteamID peer, IPv4 addr, texts) decodes field by field.
fn decode() {
    let mem = Arena.create(8192);
    let b = mem.allocBytes(696);
    for i in 0..696 {
        steam.wrU8(b, i, u8(0));
    }
    steam.wrI32(b, steam.lay("SteamNetConnectionInfo_t", "identityRemote") + steam.lay("SteamNetworkingIdentity", "eType"), i32(16));
    steam.wrI32(b, steam.lay("SteamNetConnectionInfo_t", "identityRemote") + steam.lay("SteamNetworkingIdentity", "cbSize"), i32(8));
    steam.wrU64(b, steam.lay("SteamNetConnectionInfo_t", "identityRemote") + steam.lay("SteamNetworkingIdentity", "steamID64"), u64(76561197960265800));
    steam.wrU64(b, steam.lay("SteamNetConnectionInfo_t", "userData"), u64(77));
    steam.wrU32(b, steam.lay("SteamNetConnectionInfo_t", "listenSocket"), u32(5));
    let a = steam.lay("SteamNetConnectionInfo_t", "addrRemote");
    steam.wrU8(b, a + 10, u8(255));
    steam.wrU8(b, a + 11, u8(255));
    steam.wrU8(b, a + 12, u8(1));
    steam.wrU8(b, a + 13, u8(2));
    steam.wrU8(b, a + 14, u8(3));
    steam.wrU8(b, a + 15, u8(4));
    steam.wrU8(b, a + 16, u8(135));
    steam.wrU8(b, a + 17, u8(105));
    steam.wrU32(b, steam.lay("SteamNetConnectionInfo_t", "idPOPRemote"), u32(1000));
    steam.wrI32(b, steam.lay("SteamNetConnectionInfo_t", "eState"), steam.NET_STATE_CLOSED_BY_PEER);
    steam.wrI32(b, steam.lay("SteamNetConnectionInfo_t", "eEndReason"), i32(1002));
    let d = "bye now";
    for i in 0..d.len {
        steam.wrU8(b, steam.lay("SteamNetConnectionInfo_t", "szEndDebug") + i, d[i]);
    }
    steam.wrU8(b, steam.lay("SteamNetConnectionInfo_t", "szConnectionDescription"), u8(88));
    steam.wrI32(b, steam.lay("SteamNetConnectionInfo_t", "nFlags"), i32(9));
    let c = steam.decodeConn(b);
    ok(c.peer == u64(76561197960265800) && c.userData == i64(77) && c.listenSocket == u32(5), "conn ids");
    ok(c.state == steam.NET_STATE_CLOSED_BY_PEER && c.endReason == i32(1002), "conn state");
    ok(c.endDebug == "bye now" && c.description == "X" && c.flags == i32(9), "conn text");
    ok(c.addr.set && c.addr.v4 && c.addr.ip == u32(16909060) && c.addr.port == i32(27015), "conn addr");
    ok(c.popRemote == u32(1000) && c.popRelay == u32(0), "conn pop");
    for i in 0..18 {
        steam.wrU8(b, a + i, u8(0));
    }
    ok(!steam.decodeConn(b).addr.set, "empty addr");
    // a non-Steam identity has no peer
    steam.wrI32(b, steam.lay("SteamNetworkingIdentity", "eType"), i32(1));
    ok(steam.decodeConn(b).peer == u64(0), "non-steam identity");
}

/// 1251, 1252 and 1281 written by hand, delivered through fakeCallback: the same decode the real pump uses.
fn callbacks() {
    let mem = Arena.create(8192);
    let q = mem.allocBytes(136);
    for i in 0..136 {
        steam.wrU8(q, i, u8(0));
    }
    steam.wrI32(q, steam.lay("SteamNetworkingMessagesSessionRequest_t", "identityRemote"), i32(16));
    steam.wrI32(q, 4, i32(8));
    steam.wrU64(q, 8, u64(555));
    steam.fakeCallback(i32(1251), @slice(q, 136));
    let f = mem.allocBytes(696);
    for i in 0..696 {
        steam.wrU8(f, i, u8(0));
    }
    steam.wrI32(f, 0, i32(16));
    steam.wrI32(f, 4, i32(8));
    steam.wrU64(f, 8, u64(556));
    steam.wrI32(f, steam.lay("SteamNetConnectionInfo_t", "eEndReason"), i32(5003));
    steam.wrU8(f, steam.lay("SteamNetConnectionInfo_t", "szEndDebug"), u8(110));
    steam.fakeCallback(i32(1252), @slice(f, 696));
    let s = mem.allocBytes(272);
    for i in 0..272 {
        steam.wrU8(s, i, u8(0));
    }
    steam.wrI32(s, steam.lay("SteamRelayNetworkStatus_t", "eAvail"), steam.RELAY_ATTEMPTING);
    steam.wrU8(s, steam.lay("SteamRelayNetworkStatus_t", "debugMsg"), u8(122));
    steam.fakeCallback(i32(1281), @slice(s, 272));
    R_N = 0;
    F_N = 0;
    S_N = 0;
    steam.frame();
    ok(R_N == 1 && R_FROM == u64(555), "1251 decoded");
    ok(F_N == 1 && F_PEER == u64(556) && F_REASON == i32(5003) && F_DBG == "n", "1252 decoded");
    ok(S_N == 1 && S_AVAIL == steam.RELAY_ATTEMPTING && S_MSG == "z", "1281 decoded");
}

fn absent() {
    ok(steam.netSend(steam.FAKE_FRIEND, [u8(1)], steam.SEND_RELIABLE, i32(0)) == i32(0), "send absent");
    ok(steam.netReceive(i32(0), onGot, u64(0), 10) == 0, "receive absent");
    ok(!steam.netAccept(steam.FAKE_FRIEND) && !steam.netClose(steam.FAKE_FRIEND) && !steam.netCloseChannel(steam.FAKE_FRIEND, i32(0)), "sessions absent");
    ok(steam.netSessionState(steam.FAKE_FRIEND) == steam.NET_STATE_NONE, "state absent");
    ok(steam.netSessionInfo(steam.FAKE_FRIEND).ping == i32(-1), "info absent");
    ok(steam.relayStatus() == steam.RELAY_UNKNOWN && steam.netTimestamp() == i64(0), "relay absent");
    steam.relayInit();
    steam.fakeNetDeliver(steam.FAKE_FRIEND, i32(0), [u8(1)]);
    ok(steam.netReceive(i32(0), onGot, u64(0), 10) == 0, "deliver ignored when not fake");
}

fn relay() {
    ok(steam.relayStatus() == steam.RELAY_NEVER_TRIED, "relay never tried");
    S_N = 0;
    steam.relayInit();
    steam.frame();
    ok(S_N == 1 && S_AVAIL == steam.RELAY_CURRENT && S_MSG == "OK", "relay callback");
    ok(steam.relayStatus() == steam.RELAY_CURRENT, "relay current");
    let t1 = steam.netTimestamp();
    ok(steam.netTimestamp() > t1, "clock moves");
}

fn sessions() {
    let A: u64 = steam.FAKE_FRIEND;
    R_N = 0;
    R_ACCEPT = false;
    G_N = 0;
    steam.fakeNetDeliver(A, i32(5), [u8(104), u8(105)]);
    steam.frame();
    ok(R_N == 1 && R_FROM == A, "request raised");
    ok(steam.netSessionState(A) == steam.NET_STATE_CONNECTING, "connecting");
    ok(steam.netReceive(i32(5), onGot, u64(0), 10) == 0 && G_N == 0, "unaccepted waits");
    ok(steam.netAccept(A) && !steam.netAccept(A), "accept once");
    ok(steam.netSessionState(A) == steam.NET_STATE_CONNECTED && steam.netSessionInfo(A).ping == i32(20), "connected");
    ok(steam.netReceive(i32(6), onGot, u64(0), 10) == 0, "other channel empty");
    ok(steam.netReceive(i32(5), onGot, u64(42), 10) == 1, "one message");
    ok(G_N == 1 && G_FROM == A && G_CH == i32(5) && G_CTX == u64(42) && G_LEN == 2 && G_FIRST == u8(104) && G_NUM > i64(0), "message fields");
    ok(steam.netReceive(i32(5), onGot, u64(0), 10) == 0, "drained");
    // a second delivery from a live session raises no request
    steam.fakeNetDeliver(A, i32(5), [u8(1)]);
    steam.fakeNetDeliver(A, i32(5), [u8(2), u8(2)]);
    steam.frame();
    ok(R_N == 1, "no second request");
    ok(steam.netReceive(i32(5), onGot, u64(0), 1) == 1 && G_FIRST == u8(1), "max respected");
    ok(steam.netReceive(i32(5), onGot, u64(0), 10) == 1 && G_FIRST == u8(2) && G_LEN == 2, "rest in order");
    // the handler can accept
    R_ACCEPT = true;
    R_N = 0;
    steam.fakeNetDeliver(steam.FAKE_FRIEND2, i32(1), [u8(3)]);
    steam.frame();
    ok(R_N == 1 && steam.netSessionState(steam.FAKE_FRIEND2) == steam.NET_STATE_CONNECTED, "accepted in handler");
    G_N = 0;
    ok(steam.netReceive(i32(1), onGot, u64(0), 10) == 1 && G_FROM == steam.FAKE_FRIEND2, "message after accept");
}

fn dropAndReenter() {
    let A: u64 = steam.FAKE_FRIEND;
    let nf = (0 as ptr) as fn(u64, []u8, i32, i64, u64);
    steam.fakeNetDeliver(A, i32(2), [u8(1)]);
    steam.fakeNetDeliver(A, i32(2), [u8(2)]);
    steam.fakeNetDeliver(A, i32(2), [u8(3)]);
    ok(steam.netReceive(i32(2), nf, u64(0), 10) == 3, "null handler takes them");
    ok(steam.netReceive(i32(2), onGot, u64(0), 10) == 0, "and drops them");
    G_N = 0;
    G_REENTER = 0;
    steam.fakeNetDeliver(A, i32(3), [u8(7), u8(8), u8(7)]);
    ok(steam.netReceive(i32(3), onReenter, u64(0), 10) == 1, "reenter outer");
    ok(G_REENTER == 0 && G_N == 1, "nested receive refused");
    ok(steam.netReceive(i32(3), onGot, u64(0), 10) == 1 && G_N == 2 && G_FROM == steam.FAKE_FRIEND2, "later deliveries arrive");
    ok(steam.netReceive(i32(0), onGot, u64(0), 0) == 0, "max 0");
}

fn sending() {
    let A: u64 = steam.FAKE_FRIEND;
    G_N = 0;
    ok(steam.netSend(A, [u8(5), u8(6)], steam.SEND_RELIABLE, i32(9)) == steam.NET_OK, "send ok");
    ok(steam.netReceive(i32(9), onGot, u64(0), 10) == 0, "no echo by default");
    steam.fakeNetEcho(true);
    ok(steam.netSend(A, [u8(5), u8(6)], steam.SEND_UNRELIABLE, i32(9)) == steam.NET_OK, "send echo");
    ok(steam.netReceive(i32(9), onGot, u64(0), 10) == 1 && G_FROM == A && G_LEN == 2 && G_FIRST == u8(5), "echo back");
    steam.fakeNetEcho(false);
    ok(steam.netSend(u64(0), [u8(1)], i32(0), i32(0)) == steam.NET_INVALID_PARAM, "user 0");
    let mem = Arena.create(1048576 + 4096);
    let big = mem.alloc::<u8>(steam.NET_MAX_MESSAGE + 1);
    ok(steam.netSend(A, big, steam.SEND_RELIABLE, i32(0)) == steam.NET_LIMIT_EXCEEDED, "over the limit");
    let top: []u8 = @slice(big.ptr as ptr, steam.NET_MAX_MESSAGE);
    ok(steam.netSend(A, top, steam.SEND_RELIABLE, i32(0)) == steam.NET_OK, "exactly the limit");
}

fn failing() {
    let B: u64 = steam.FAKE_FRIEND2;
    F_N = 0;
    steam.fakeNetFail(B, i32(1002), "peer left");
    steam.frame();
    ok(F_N == 1 && F_PEER == B && F_REASON == i32(1002) && F_DBG == "peer left", "failed callback");
    ok(steam.netSessionState(B) == steam.NET_STATE_CLOSED_BY_PEER, "closed by peer");
    let info = steam.netSessionInfo(B);
    ok(info.endReason == i32(1002) && info.endDebug == "peer left" && info.ping == i32(-1), "failed info");
    ok(steam.netSend(B, [u8(1)], steam.SEND_RELIABLE, i32(0)) == steam.NET_NO_CONNECTION, "no connection");
    ok(steam.netSend(B, [u8(1)], steam.SEND_RELIABLE + steam.SEND_AUTO_RESTART_BROKEN_SESSION, i32(0)) == steam.NET_OK, "auto restart");
    ok(steam.netSessionState(B) == steam.NET_STATE_CONNECTED, "restarted");
    steam.fakeNetFail(B, i32(3001), "local");
    ok(steam.netSessionState(B) == steam.NET_STATE_PROBLEM_LOCALLY, "local problem");
    ok(steam.netClose(B) && steam.netSessionState(B) == steam.NET_STATE_NONE && !steam.netClose(B), "close");
}

fn closing() {
    let A: u64 = steam.FAKE_FRIEND;
    G_N = 0;
    steam.fakeNetDeliver(A, i32(1), [u8(1)]);
    steam.fakeNetDeliver(A, i32(2), [u8(2)]);
    ok(steam.netCloseChannel(A, i32(1)), "close channel");
    ok(steam.netReceive(i32(1), onGot, u64(0), 10) == 0 && steam.netReceive(i32(2), onGot, u64(0), 10) == 1, "only that channel dropped");
    steam.fakeNetDeliver(A, i32(2), [u8(2)]);
    ok(steam.netClose(A), "close session");
    ok(steam.netReceive(i32(2), onGot, u64(0), 10) == 0, "close drops the queue");
    ok(!steam.netCloseChannel(A, i32(2)), "no session");
}

fn bounded() {
    let A: u64 = steam.FAKE_FRIEND;
    steam.netSend(A, [u8(0)], i32(0), i32(0));
    for i in 0..300 {
        steam.fakeNetDeliver(A, i32(4), [u8(i % 256), u8(1), u8(2)]);
    }
    G_N = 0;
    ok(steam.netReceive(i32(4), onGot, u64(0), 1000) == 128, "inbox keeps 128");
    // 300 delivered, the oldest 172 dropped: the first kept is number 172, value 172
    ok(G_N == 128 && G_FIRST == u8(299 % 256), "oldest dropped, newest last");
    steam.netSend(A, [u8(0)], i32(0), i32(0));
}

fn main() {
    layouts();
    decode();
    steam.onNetRequest(onReq);
    steam.onNetFailed(onFail);
    steam.onRelayStatus(onRelay);
    absent();
    ok(steam.initFake(u32(480)) == steam.Status.Fake, "fake");
    callbacks();
    relay();
    sessions();
    dropAndReenter();
    sending();
    failing();
    closing();
    bounded();
    steam.shutdown();
    ok(steam.netSessionState(steam.FAKE_FRIEND) == steam.NET_STATE_NONE, "state cleared at shutdown");
    ok(steam.netReceive(i32(4), onGot, u64(0), 10) == 0, "nothing after shutdown");
    steam.initFake(u32(480));
    ok(steam.netSessionState(steam.FAKE_FRIEND) == steam.NET_STATE_NONE && steam.netReceive(i32(4), onGot, u64(0), 10) == 0, "fresh after re-init");
    ok(steam.relayStatus() == steam.RELAY_NEVER_TRIED, "relay reset");
    steam.shutdown();
    printLn("steam_net_test ok");
}
