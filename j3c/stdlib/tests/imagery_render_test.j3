// Draw-call cost of tiled images: a repeat/round border-image frame and a layered background batch per texture, and a single
// stretched background stays one draw. No visible window:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_STDLIB=$PWD/j3c/stdlib timeout 60 j3c run j3c/stdlib/tests/imagery_render_test.j3
module imagery_render_test;

use j3.game;
use j3.game.Color;
use j3.gfx.canvas.{ Canvas, Mode, rgba };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CHECKS: int;

const W: int = 400;
const H: int = 300;

const SHEET: string = ".stage { display: block; width: 400px; height: 300px; } .box { width: 300px; height: 200px; } .one { background: url(/tmp/j3-img-a.png); } .frame { border: 16px solid transparent; border-image: url(/tmp/j3-img-a.png) 8 fill / 16px repeat; } .round { border-image-repeat: round; } .layers { background: url(/tmp/j3-img-a.png) 0 0 / 8px 8px repeat, url(/tmp/j3-img-b.png) 0 0 / 8px 8px repeat; } .space { background: url(/tmp/j3-img-a.png) 0 0 / 10px 10px space; }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond { printLn(`FAIL: {msg}`); panic(msg); }
}

fn png(mem: &Arena, path: string, w: i32, h: i32, c: u8) {
    let image = Canvas.create(mem, w, h, Mode.Pixel);
    image.clear(rgba(c, 200 - c, 128, 255));
    match image.savePng(path, mem) {
        Result.Ok(_) {}
        Result.Err(_) { panic("save image fixture"); }
    }
}

/// Draw calls one box with `cls` costs (the images are loaded by an earlier frame, so uploads do not count).
fn draws(d: &Dom, cls: string): int {
    let n = 0;
    for pass in 0..2 {
        game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
        d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
        let stage = d.open(0, d.tag("div"), 1);
        d.cls(stage, "stage");
        let box = d.open(0, d.tag("div"), 1);
        d.cls(box, "box");
        d.cls(box, cls);
        d.close();
        d.close();
        d.layout();
        let before = game.drawsNow();
        d.paintAll();
        game.p2Flush();
        n = game.drawsNow() - before;
        d.endFrame();
    }
    return n;
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    game.initGlHidden("imagery draw counts", W, H);
    png(&mem, "/tmp/j3-img-a.png", 24, 24, 60);
    png(&mem, "/tmp/j3-img-b.png", 8, 8, 150);
    let css = Css.new(&mem);
    parse(&css, SHEET, "imagery.css", 1);
    ok(css.warns.len == 0, "imagery fixture CSS parses");
    let d = Dom.new(&mem, &css);
    d.simInput(-10.0, -10.0, false, 0.0);
    d.setFrameMs(16.0);
    let one = draws(&d, "one");
    printLn(`one stretched url background: {one} draw(s)`);
    ok(one == 1, "a single url background is one draw");
    // 300 x 200 box with 16 px edges and 16 px tiles: about 17 + 10 edge tiles and 17 * 10 center tiles, still one texture
    let frame = draws(&d, "frame");
    printLn(`repeat frame: {frame} draw(s)`);
    ok(frame == 1, "a repeat border-image frame is one draw");
    let round = draws(&d, "frame round");
    ok(round == 1, "a round border-image frame is one draw");
    // 300 x 200 / 8 px = 37 x 25 tiles of each of two textures: draws follow the layer count, not the tile count
    let layers = draws(&d, "layers");
    printLn(`two tiled layers: {layers} draw(s)`);
    ok(layers <= 2, "two tiled url layers cost at most one draw each");
    let space = draws(&d, "space");
    ok(space == 1, "a space background is one draw");
    printLn(`imagery_render_test: {CHECKS} checks passed`);
}
