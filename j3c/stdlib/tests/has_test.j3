// Tests for the limited `:has()` through j3.ui.dom: each supported form matches, and a change that could flip it restyles the
// carrying element (checkbox toggled, `<img>` inserted / removed, class and state flags, sibling forms); a change nothing in the
// sheet tests restyles only its own node; no `:has()` rule, no `hasMode`; idle frames cost nothing.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/has_test.j3
// Panics on the first failed check.

module has_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.{ Css, FL_HOVER };
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, label, input, img { font-family: \"T\"; font-size: 14px; display: block; } .row { height: 20px; width: 10px; } .row:has(input:checked) { width: 99px; } .card { width: 100px; height: 10px; } .card:has(> img) { width: 150px; } .card:has(> img) .title { width: 33px; } .box { width: 10px; } .box:has(.hot) { width: 77px; } .lab { width: 10px; } .lab:has(+ input:disabled) { width: 66px; } .sib { width: 10px; } .sib:has(~ .flag, > .flag) { width: 55px; } .hv { width: 10px; } .hv:has(:hover) { width: 44px; } .hv:has(.a, .b) { height: 31px; }";

#[singleton]
let CHK: [3]bool;
#[singleton]
let IMG: bool;
#[singleton]
let HOT: bool;
#[singleton]
let Z: bool;
#[singleton]
let DIS: bool;
#[singleton]
let FLAG: bool;
#[singleton]
let B: bool;
#[singleton]
let ID: [16]int;

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let ul = d.open(0, d.tag("div"), 1);
    for i in 0..3 {
        let li = d.open(i, d.tag("div"), 1);
        d.cls(li, "row");
        ID[i] = li;
        let cb = d.open(0, d.tag("input"), 1);
        d.attrType(cb, "checkbox");
        d.attrChecked(cb, CHK[i]);
        d.close();
        d.close();
    }
    d.close();
    let card = d.open(1, d.tag("div"), 1);
    d.cls(card, "card");
    ID[3] = card;
    if IMG {
        d.open(0, d.tag("img"), 1);
        d.close();
    }
    let ti = d.open(1, d.tag("div"), 1);
    d.cls(ti, "title");
    ID[4] = ti;
    d.close();
    d.close();
    let box = d.open(2, d.tag("div"), 1);
    d.cls(box, "box");
    ID[5] = box;
    for k in 0..12 {
        d.open(0, d.tag("div"), 1);
    }
    let deep = d.open(0, d.tag("div"), 1);
    d.clsIf(deep, "hot", HOT);
    for k in 0..12 {
        d.close();
    }
    d.close();
    d.close();
    let noise = d.open(3, d.tag("div"), 1);
    d.clsIf(noise, "z", Z);
    ID[6] = noise;
    d.close();
    let lab = d.open(4, d.tag("label"), 1);
    d.cls(lab, "lab");
    ID[7] = lab;
    d.close();
    let ip = d.open(5, d.tag("input"), 1);
    d.attrDisabled(ip, DIS);
    d.close();
    let sib = d.open(6, d.tag("div"), 1);
    d.cls(sib, "sib");
    ID[8] = sib;
    if B {
        let kid = d.open(0, d.tag("span"), 1);
        d.cls(kid, "flag");
        d.close();
    }
    d.close();
    let nx = d.open(7, d.tag("span"), 1);
    d.clsIf(nx, "flag", FLAG);
    d.close();
    let hv = d.open(8, d.tag("div"), 1);
    d.cls(hv, "hv");
    ID[9] = hv;
    let hk = d.open(0, d.tag("span"), 1);
    ID[10] = hk;
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn settle(d: &Dom) {
    frame(d);
    frame(d);
}

fn w(d: &Dom, i: int): f32 {
    return d.nodes.items[ID[i]].w;
}

const FONT: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, input { font-family: \"T\"; font-size: 14px; display: block; } ";

#[singleton]
let NLEAF: int;
#[singleton]
let DEPTH: int;
#[singleton]
let HOTLEAF: bool;
#[singleton]
let KIDS: int;
#[singleton]
let HOT2: bool;
#[singleton]
let TXT: bool;
#[singleton]
let CARRIER: int;

// a chain of DEPTH divs, each holding NLEAF leaf divs; the deepest leaf gets `.x` when HOTLEAF
fn combFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    for i in 0..DEPTH {
        d.open(0, d.tag("div"), 1);
        for j in 0..NLEAF {
            let l = d.open(j + 1, d.tag("div"), 1);
            if HOTLEAF && i == DEPTH - 1 && (j == 0 || (HOT2 && j == 1)) {
                d.cls(l, "x");
            }
            d.close();
        }
    }
    for i in 0..DEPTH {
        d.close();
    }
    d.layout();
    d.endFrame();
}

// `.panel:has(input:checked)` holding KIDS rows under a chain of 10 divs; TXT adds a text node to the panel
fn panelFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    for i in 0..10 {
        d.open(0, d.tag("div"), 1);
    }
    let p = d.open(0, d.tag("div"), 1);
    d.cls(p, "panel");
    CARRIER = p;
    for i in 0..KIDS {
        d.open(i, d.tag("div"), 1);
        d.close();
    }
    if TXT {
        d.text("hello");
    }
    d.close();
    for i in 0..10 {
        d.close();
    }
    d.layout();
    d.endFrame();
}

// evaluations of `div:has(.x)` for one change in a tree of `depth` x `leaves` nodes
fn combEvals(mem: &Arena, depth: int, leaves: int): int {
    let css = Css.new(mem);
    parse(&css, FONT, "font.css", 1);
    parse(&css, "div:has(.x) { width: 77px; }", "comb.css", 1);
    ok(css.warns.len == 0, "comb sheet parses");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    DEPTH = depth;
    NLEAF = leaves;
    HOTLEAF = false;
    settleWith(&d, 0);
    css.hasEvals = 0;
    HOTLEAF = true;
    combFrame(&d);
    return css.hasEvals;
}

fn settleWith(d: &Dom, which: int) {
    if which == 0 {
        combFrame(d);
        combFrame(d);
    } else {
        panelFrame(d);
        panelFrame(d);
    }
}

// nodes restyled when a second `.x` joins the first under the deepest group of a 50 x 20 comb
fn combRestyled(mem: &Arena, rule: string): int {
    let css = Css.new(mem);
    parse(&css, FONT, "font.css", 1);
    parse(&css, rule, "cr.css", 1);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    DEPTH = 50;
    NLEAF = 20;
    HOTLEAF = true;
    HOT2 = false;
    settleWith(&d, 0);
    let r0 = d.restyled;
    HOT2 = true;
    combFrame(&d);
    HOT2 = false;
    return d.restyled - r0;
}

fn testCost(mem: &Arena) {
    // style pass memo: one change in 1000 vs 2000 nodes: linear (a pass that searched each subtree again would be about 4x)
    let e1 = combEvals(mem, 50, 20);
    let e2 = combEvals(mem, 100, 20);
    ok(e1 > 0 && e2 > 0, "the carriers were evaluated");
    ok(e2 < 3 * e1, "doubling the tree less than triples the :has() work");
    ok(e2 <= 4 * 2100, "and it is about one test per node, not per node and ancestor");

    // mass insert: the ancestor walk stops at a node an earlier walk covered
    let css = Css.new(mem);
    parse(&css, FONT, "font.css", 1);
    parse(&css, ".panel:has(input:checked) { width: 77px; }", "mass.css", 1);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    KIDS = 2000;
    TXT = false;
    css.hasWalked = 0;
    panelFrame(&d);
    ok(css.hasWalked <= 3 * 2000, "mounting 2000 children walks ancestors about once each, not once per insert");
    ok(css.hasWalked > 0, "the walk ran");
    panelFrame(&d);
    // a text child and its blankness are no argument match: nothing walks
    css.hasWalked = 0;
    TXT = true;
    panelFrame(&d);
    ok(css.hasWalked == 0, "inserting a text node walks nothing");
    TXT = false;
    panelFrame(&d);
    ok(css.hasWalked == 0, "removing it walks nothing");

    // carriers whose answer does not change keep their style id, so their subtrees are not restyled (a second .x below already-matching
    // ancestors); with a :has() before a descendant combinator every carrier restyles its subtree
    ok(combRestyled(mem, "div:has(.x) { width: 77px; }") <= 3 * 50, "a second match below matching carriers restyles the carriers, not their subtrees");
    ok(combRestyled(mem, "div:has(.x) .y { width: 77px; }") >= 1000, "with :has() before a combinator the subtrees restyle");
}

fn main() {
    let mem = Arena.create(32 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "has.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    ok(css.hasMode == 15, "all four relations in use");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    settle(&d);
    ok(w(&d, 0) == 10.0 && w(&d, 3) == 100.0 && w(&d, 5) == 10.0, "nothing matches at first");

    // li:has(input:checked)
    CHK[1] = true;
    frame(&d);
    ok(w(&d, 1) == 99.0 && w(&d, 0) == 10.0, "checking a box restyles its li");
    CHK[1] = false;
    frame(&d);
    ok(w(&d, 1) == 10.0, "unchecking restores it");

    // .card:has(> img), and the descendant rule after it
    IMG = true;
    frame(&d);
    ok(w(&d, 3) == 150.0 && w(&d, 4) == 33.0, "an inserted img flips .card:has(> img) and .card:has(> img) .title");
    IMG = false;
    frame(&d);
    ok(w(&d, 3) == 100.0 && w(&d, 4) != 33.0, "removing it flips both back");

    // .box:has(.hot): a descendant 13 deep
    HOT = true;
    frame(&d);
    ok(w(&d, 5) == 77.0, "a class on a deep descendant flips the ancestor");
    HOT = false;
    frame(&d);
    ok(w(&d, 5) == 10.0, "and back");

    // a class no :has() argument tests restyles only its own node
    settle(&d);
    let r0 = d.restyled;
    Z = true;
    frame(&d);
    ok(d.restyled - r0 == 1, "an unrelated class restyles one node, no ancestor walk");
    Z = false;
    settle(&d);

    // .lab:has(+ input:disabled)
    DIS = true;
    frame(&d);
    ok(w(&d, 7) == 66.0, "a later sibling's flag flips the earlier sibling");
    DIS = false;
    frame(&d);
    ok(w(&d, 7) == 10.0, "and back");

    // .sib:has(~ .flag, > .flag): later sibling or child, either argument
    FLAG = true;
    frame(&d);
    ok(w(&d, 8) == 55.0, "a class on a later sibling flips :has(~ .flag)");
    FLAG = false;
    B = true;
    frame(&d);
    ok(w(&d, 8) == 55.0, "a child .flag flips the other argument");
    B = false;
    frame(&d);
    ok(w(&d, 8) == 10.0, "neither: off");

    // .hv:has(:hover)
    d.setFlag(ID[10], FL_HOVER, true);
    frame(&d);
    ok(w(&d, 9) == 44.0, "hover on a descendant flips the ancestor");
    d.setFlag(ID[10], FL_HOVER, false);
    frame(&d);
    ok(w(&d, 9) == 10.0, "and back");

    // idle frames
    let l0 = d.laid;
    let s0 = d.restyled;
    settle(&d);
    settle(&d);
    ok(d.laid == l0 && d.restyled == s0, "steady frames lay out and restyle nothing");

    // no :has() rule: no mode, a class change restyles its node only
    let plain = Css.new(&mem);
    parse(&plain, "div { width: 10px; } li:hover { width: 5px; }", "p2.css", 1);
    ok(plain.hasMode == 0 && plain.hasSubj.len == 0, "without :has() rules the mode is off");
    testCost(&mem);
    printLn(`has_test ok, checks passed: {CHECKS}`);
}
