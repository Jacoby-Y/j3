// Tests for j3.term.grid: cursor, deferred wrap, scroll regions, erase, wide chars, alt screen, resize,
// scrollback, replies, DEC line drawing, 1 MB of text, and captured program output (term_fixtures/).
//   timeout 120 j3c run j3c/stdlib/tests/term_grid_test.j3
// Panics on the first failed check. In samples `~` is ESC, `$` is BEL and `^` is BS.

module term_grid_test;

use j3.io.exists;
use j3.io.printLn;
use j3.io.readFile;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.term.Color;
use j3.term.Style;
use j3.term.ansi.Parser;
use j3.term.ansi.feed;
use j3.term.grid;
use j3.term.grid.Grid;
use j3.text.Text;

fn eq(a: string, b: string, msg: string) {
    if !(a == b) {
        printLn(`FAIL: {msg}`);
        printLn("  want:");
        printLn(b);
        printLn("  got:");
        printLn(a);
        panic(msg);
    }
}

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn eqi(a: int, b: int, msg: string) {
    if a != b {
        printLn(`FAIL: {msg}: want {b} got {a}`);
        panic(msg);
    }
}

fn mk(s: string, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..s.len {
        let c = s[i];
        t.push(if c == 0x7e { 0x1b } else if c == 0x24 { 0x07 } else if c == 0x5e { 0x08 } else { c });
    }
    return t.str();
}

/// A grid and its parser; `go` feeds a sample.
struct Term {
    g: Grid;
    p: Parser;
    a: &Arena;

    fn go(this: &Term, s: string) {
        let b = mk(s, this.a);
        this.p.feed(b, &this.g);
    }

    fn dump(this: &Term): string {
        return this.g.dumpText(this.a);
    }
}

fn term(a: &Arena, cols: int, rows: int, sb: int): Term {
    return Term { g: Grid.new(a, cols, rows, sb), p: Parser.new(a), a: a };
}

fn cursor(t: &Term, x: int, y: int, msg: string) {
    eqi(t.g.cursorX(), x, `{msg} cursor x`);
    eqi(t.g.cursorY(), y, `{msg} cursor y`);
}

fn repeat(s: string, n: int, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..n {
        t.add(s);
    }
    return t.str();
}

fn join(x: string, y: string, a: &Arena): string {
    let t = Text.new(a);
    t.add(x).add(y);
    return t.str();
}

fn moves(a: &Arena) {
    let t = term(a, 10, 4, 0);
    t.go("abc~[2;3Hx~[Ay~[2Dz");
    eq(t.dump(), "abzy\n  x\n\n", "CUP, CUU, CUB");
    cursor(&t, 3, 0, "after CUB");
    t.go("~[10C~[99B~[99;99H");
    cursor(&t, 9, 3, "clamped");
    t.go("~[H~[0;0H");
    cursor(&t, 0, 0, "0 means 1");
    t.go("~[3;4H~[E");
    cursor(&t, 0, 3, "CNL clamps");
    t.go("~[2F");
    cursor(&t, 0, 1, "CPL");
    t.go("~[5G");
    cursor(&t, 4, 1, "CHA");
    t.go("~[3d");
    cursor(&t, 4, 2, "VPA");
    t.go("~[1;1H~[2J~[3;1H1234567890~[1;8H~[2J");
    eq(t.dump(), "\n\n\n", "ED 2");
    t.go("~[65535A~[65535D");
    cursor(&t, 0, 0, "huge moves clamp");
    t.go("~[3;3H~[s");
    cursor(&t, 2, 2, "unknown CSI ignored");
    t.go("ab~D");
    cursor(&t, 4, 3, "IND moves down");
    t.go("~E");
    cursor(&t, 0, 3, "NEL");
}

fn tabs(a: &Arena) {
    let t = term(a, 20, 2, 0);
    t.go("a\tb\tc");
    eq(t.dump(), "a       b       c\n", "default tab stops");
    t.go("~[2J~[H~[3g~[5G~H~[1;1H\ty");
    eq(t.dump(), "    y\n", "TBC 3 and HTS");
    t.go("~[1;10H~[Z");
    cursor(&t, 4, 0, "CBT to the stop");
    t.go("~[Z");
    cursor(&t, 0, 0, "CBT to column 0");
    t.go("~[3I");
    cursor(&t, 19, 0, "CHT past the last stop ends on the last column");
}

fn deferredWrap(a: &Arena) {
    let t = term(a, 80, 2, 5);
    t.go(repeat("a", 80, a));
    cursor(&t, 79, 0, "80 chars");
    ok(t.g.wrapPending, "pending wrap set");
    t.go(repeat("b", 80, a));
    cursor(&t, 79, 1, "160 chars");
    eqi(t.g.scrollbackLen(), 0, "no scroll until the 161st char");
    t.go("c");
    eqi(t.g.scrollbackLen(), 1, "161st char scrolls");
    eq(t.dump(), join(repeat("b", 80, a), "\nc", a), "scrolled");

    let u = term(a, 80, 3, 0);
    u.go(repeat("a", 80, a));
    u.go("\r\nb");
    eq(u.dump(), join(repeat("a", 80, a), "\nb\n", a), "CR LF at the last column makes no blank line");

    let w = term(a, 5, 2, 0);
    w.go("abcde^X");
    eq(w.dump(), "abcXe\n", "BS from the pending column");
    let v = term(a, 5, 2, 0);
    v.go("abcde~[1;5Hf");
    eq(v.dump(), "abcdf\n", "CUP clears the pending wrap");
    let r = term(a, 5, 2, 0);
    r.go("abcde\rX");
    eq(r.dump(), "Xbcde\n", "CR clears the pending wrap");
    let n = term(a, 5, 2, 0);
    n.go("~[?7labcdefg");
    eq(n.dump(), "abcdg\n", "autowrap off overwrites the last column");
}

fn regions(a: &Arena) {
    let t = term(a, 6, 6, 4);
    t.go("1\r\n2\r\n3\r\n4\r\n5\r\n6");
    t.go("~[2;4r");
    cursor(&t, 0, 0, "DECSTBM homes the cursor");
    t.go("~[4;1H\n");
    eq(t.dump(), "1\n3\n4\n\n5\n6", "LF at the bottom margin scrolls only the region");
    eqi(t.g.scrollbackLen(), 0, "region scroll does not reach scrollback");
    t.go("~[6;1H\n\n");
    eq(t.dump(), "1\n3\n4\n\n5\n6", "LF on the last row below the region does nothing");
    cursor(&t, 0, 5, "stays on the last row");
    t.go("~[3;3H~[L");
    eq(t.dump(), "1\n3\n\n4\n5\n6", "IL inside the region");
    cursor(&t, 0, 2, "IL resets x");
    t.go("~[M~[M");
    eq(t.dump(), "1\n3\n\n\n5\n6", "DL inside the region");
    t.go("~[1;1H~[L~[99M");
    eq(t.dump(), "1\n3\n\n\n5\n6", "IL/DL outside the region do nothing");
    t.go("~[3;1HX~[99L");
    eq(t.dump(), "1\n3\n\n\n5\n6", "huge IL clamps to the region");
    eqi(t.g.scrollbackLen(), 0, "IL/DL never feed scrollback");
    t.go("~[2;1H~[S");
    eq(t.dump(), "1\n\n\n\n5\n6", "SU");
    t.go("~[2;1Ha~[3;1Hb~[T");
    eq(t.dump(), "1\n\na\nb\n5\n6", "SD");
    t.go("~[1;1H~M");
    eq(t.dump(), "1\n\na\nb\n5\n6", "RI above the region just moves up");
    t.go("~[2;1H~M");
    eq(t.dump(), "1\n\n\na\n5\n6", "RI at the top margin scrolls the region down");
    t.go("~[r");
    cursor(&t, 0, 0, "DECSTBM reset homes");
    t.go("~[6;1H\n");
    eqi(t.g.scrollbackLen(), 1, "full-screen region feeds scrollback");
    eq(t.g.lineString(0, a), "1", "oldest scrollback line");
    t.go("~[3;3r");
    cursor(&t, 0, 5, "one-row region is ignored");
    t.go("~[7;9r");
    cursor(&t, 0, 5, "bad region is ignored");
}

fn origin(a: &Arena) {
    let t = term(a, 6, 6, 0);
    t.go("~[2;4r~[?6h~[1;1Hx~[99;1Hy");
    eq(t.dump(), "\nx\n\ny\n\n", "origin mode addresses inside the region");
    t.g.reply.clear();
    t.go("~[6n");
    eq(t.g.reply.str(), mk("~[3;2R", a), "CPR is relative to the region in origin mode");
    t.go("~[?6l");
    cursor(&t, 0, 0, "leaving origin mode homes");
}

fn erase(a: &Arena) {
    let t = term(a, 10, 3, 0);
    let fill = "~[2J~[Haaaaaaaaaa\r\nbbbbbbbbbb\r\ncccccccccc~[2;5H";
    t.go(fill);
    t.go("~[J");
    eq(t.dump(), "aaaaaaaaaa\nbbbb\n", "ED 0");
    t.go(fill);
    t.go("~[1J");
    eq(t.dump(), "\n     bbbbb\ncccccccccc", "ED 1");
    t.go(fill);
    t.go("~[K");
    eq(t.dump(), "aaaaaaaaaa\nbbbb\ncccccccccc", "EL 0");
    t.go(fill);
    t.go("~[1K");
    eq(t.dump(), "aaaaaaaaaa\n     bbbbb\ncccccccccc", "EL 1");
    t.go(fill);
    t.go("~[2K");
    eq(t.dump(), "aaaaaaaaaa\n\ncccccccccc", "EL 2");
    t.go(fill);
    t.go("~[3X");
    eq(t.dump(), "aaaaaaaaaa\nbbbb   bbb\ncccccccccc", "ECH");
    t.go(fill);
    t.go("~[2P");
    eq(t.dump(), "aaaaaaaaaa\nbbbbbbbb\ncccccccccc", "DCH");
    t.go(fill);
    t.go("~[2@");
    eq(t.dump(), "aaaaaaaaaa\nbbbb  bbbb\ncccccccccc", "ICH");
    t.go(fill);
    t.go("~[65535X");
    eq(t.dump(), "aaaaaaaaaa\nbbbb\ncccccccccc", "huge ECH");
    t.go(fill);
    t.go("~[65535@~[65535P");
    eq(t.dump(), "aaaaaaaaaa\nbbbb\ncccccccccc", "huge ICH and DCH");
    t.go(fill);
    t.go("~[4h~[1;1HXY~[4l");
    eq(t.dump(), "XYaaaaaaaa\nbbbbbbbbbb\ncccccccccc", "IRM shifts the row right");

    let b = term(a, 8, 2, 0);
    b.go("~[1;31;42m~[2J");
    eq(b.g.dumpStyled(a), "{-;p2;0}        {-;-;0}\n{-;p2;0}        {-;-;0}", "BCE keeps only the background");
    b.go("~[0m~[H~[44mab~[0mc~[K");
    eq(b.g.dumpStyled(a), "{-;p4;0}ab{-;-;0}c\n{-;p2;0}        {-;-;0}", "EL with a plain pen blanks plain");
    b.go("~[H~[44m~[K");
    eq(b.g.dumpStyled(a), "{-;p4;0}        {-;-;0}\n{-;p2;0}        {-;-;0}", "EL with a blue pen blanks blue");
}

fn pen(a: &Arena) {
    let t = term(a, 10, 3, 0);
    t.go("~[1;38;5;196mX~[0m~[38;2;1;2;3mY");
    let x = t.g.cell(0, 0);
    ok(x.style.has(1) && x.style.fg == Color.palette(196), "SGR on a cell");
    ok(t.g.cell(1, 0).style.fg == Color.rgb(1, 2, 3), "rgb color");
    t.go("~[0m~[31m~[2;3H~7~[0m~[H~8");
    cursor(&t, 2, 1, "DECRC position");
    ok(t.g.pen.fg == Color.palette(1), "DECRC pen");
    t.go("~[1;1H~[2Jx~[5b");
    eq(t.dump(), "xxxxxx\n\n", "REP");
    t.go("~[1;1H~[2Jx~[65535b");
    eq(t.dump(), "xxxxxxxxxx\nx\n", "huge REP is capped at the width");
    t.go("~[4 q");
    eqi(t.g.cursorShape, 4, "DECSCUSR");
}

fn wide(a: &Arena) {
    let t = term(a, 5, 3, 0);
    t.go("abcd中");
    eq(t.dump(), "abcd\n中\n", "wide char wraps when one column is left");
    eqi(int(t.g.cell(0, 1).width), 2, "head width");
    eqi(int(t.g.cell(1, 1).width), 0, "spacer width");
    cursor(&t, 2, 1, "after a wide char");
    t.go("~[2;2Hx");
    eq(t.dump(), "abcd\n x\n", "overwriting the right half blanks the left");
    t.go("~[2;1H中~[2;1Hy");
    eq(t.dump(), "abcd\ny\n", "overwriting the left half blanks the right");
    eqi(int(t.g.cell(1, 1).width), 1, "right half is a normal blank");
    t.go("~[3;4H中");
    eq(t.dump(), "abcd\ny\n   中", "wide char in the last two columns");
    ok(t.g.wrapPending, "pending after it");
    t.go("~[2J~[H~[4hab~[H中");
    eq(t.dump(), "中ab\n\n", "insert mode shifts the row right by the width");
    t.go("~[4l~[2J~[Hab中d~[1;4H~[P");
    eq(t.dump(), "ab d\n\n", "DCH through the left half of a wide char blanks it");
    t.go("~[2J~[H~[1;5H中");
    eq(t.dump(), "\n中\n", "wide char at the last column wraps");
    // width 0 code points join the cell before
    let u = term(a, 5, 1, 0);
    u.p.feed("e", &u.g);
    let comb = Text.new(a);
    comb.push(0xcc);
    comb.push(0x81);
    u.p.feed(comb.str(), &u.g);
    u.go("x");
    eq(u.dump(), "éx", "combining mark joins its base, cursor not moved");
}

fn altScreen(a: &Arena) {
    let t = term(a, 10, 3, 4);
    t.go("~[31mabc\r\ndef");
    cursor(&t, 3, 1, "primary");
    t.go("~[?1049h");
    ok(t.g.altScreen(), "alt on");
    eq(t.dump(), "\n\n", "alt screen starts blank");
    t.go("~[0m~[Hxyz\r\n\r\n\r\n\r\n\r\nlast");
    eq(t.dump(), "\n\nlast", "alt content scrolled");
    eqi(t.g.scrollbackLen(), 0, "alt scroll feeds no scrollback");
    t.go("~[?1049l");
    ok(!t.g.altScreen(), "alt off");
    eq(t.dump(), "abc\ndef\n", "primary restored");
    cursor(&t, 3, 1, "cursor restored");
    ok(t.g.pen.fg == Color.palette(1), "pen restored");
    t.go("~[?1049h");
    eq(t.dump(), "\n\n", "second visit starts blank again");
    t.go("~[?1049l");
    t.go("~[?47hq~[?47l");
    eq(t.dump(), "abc\ndef\n", "?47 switches without touching primary");
    t.go("~[?47h");
    eq(t.dump(), "\n   q\n", "?47 keeps the alt content");
    t.go("~[?47l~[?1047h");
    eq(t.dump(), "\n\n", "?1047 clears on entry");
    t.go("~[?1047l");
    ok(!t.g.altScreen(), "1047 off");
}

fn modes(a: &Arena) {
    let t = term(a, 10, 3, 0);
    ok(t.g.mode(grid.MODE_WRAP) && t.g.cursorVisible(), "defaults");
    t.go("~[?1h~=~[?25l~[?2004h~[?1000;1006;1004h");
    ok(t.g.mode(grid.MODE_CURSOR_KEYS), "cursor keys app");
    ok(t.g.mode(grid.MODE_KEYPAD), "keypad app");
    ok(!t.g.cursorVisible(), "cursor hidden");
    ok(t.g.mode(grid.MODE_PASTE) && t.g.mode(grid.MODE_MOUSE_CLICK) && t.g.mode(grid.MODE_MOUSE_SGR) && t.g.mode(grid.MODE_FOCUS), "paste, mouse, focus");
    t.go("~[?1l~>~[?25h~[?2004l~[?1000l~[?1002h~[?1003h");
    ok(!t.g.mode(grid.MODE_CURSOR_KEYS) && !t.g.mode(grid.MODE_KEYPAD) && t.g.cursorVisible(), "reset");
    ok(t.g.mode(grid.MODE_MOUSE_DRAG) && t.g.mode(grid.MODE_MOUSE_MOVE) && !t.g.mode(grid.MODE_MOUSE_CLICK), "mouse modes are separate bits");
    t.go("~[?7l~[4h~[2;3r~[!p");
    ok(t.g.mode(grid.MODE_WRAP) && !t.g.mode(grid.MODE_INSERT), "DECSTR");
    ok(t.g.mode(grid.MODE_MOUSE_DRAG), "DECSTR keeps mouse reporting");
    eqi(t.g.top, 0, "DECSTR region");
    t.go("abc~c");
    eq(t.dump(), "\n\n", "RIS clears");
    ok(!t.g.mode(grid.MODE_MOUSE_DRAG), "RIS resets modes");
    cursor(&t, 0, 0, "RIS homes");
}

fn replies(a: &Arena) {
    let t = term(a, 10, 5, 0);
    t.go("~[3;5H~[6n");
    eq(t.g.reply.str(), mk("~[3;5R", a), "CPR");
    t.g.reply.clear();
    t.go("~[5n");
    eq(t.g.reply.str(), mk("~[0n", a), "DSR 5");
    t.g.reply.clear();
    t.go("~[c~[>c");
    eq(t.g.reply.str(), mk("~[?62;22c~[>0;0;0c", a), "DA1 and DA2");
    t.g.reply.clear();
    eqi(t.g.reply.len(), 0, "drained");
    t.go("$$");
    eqi(t.g.bells, 2, "BEL counted");
    let rq = fn(u: &Term, m: string) { u.go(m); u.p.feed("$p", &u.g); };
    rq(&t, "~[?2026");
    eq(t.g.reply.str(), join(mk("~[?2026;2", a), "$y", a), "DECRQM 2026 reset");
    t.g.reply.clear();
    t.go("~[?2026h");
    rq(&t, "~[?2026");
    rq(&t, "~[?9999");
    eq(t.g.reply.str(), join(join(mk("~[?2026;1", a), "$y", a), join(mk("~[?9999;0", a), "$y", a), a), "DECRQM 2026 set, unknown mode 0");
    t.g.reply.clear();
    ok(t.g.syncHeld(1000), "held after ?2026 h");
    ok(t.g.syncHeld(1149), "still held before the timeout");
    ok(!t.g.syncHeld(1150), "released after 150 ms");
    ok(!t.g.mode(grid.MODE_SYNC), "the timeout clears the mode");
    t.go("~[?2026h");
    ok(t.g.syncHeld(5000), "held again");
    t.go("~[?2026l");
    ok(!t.g.syncHeld(5001), "?2026 l releases");
}

fn textAttrs(a: &Arena) {
    let t = term(a, 10, 2, 0);
    t.go("~(0lqqk~(Bq");
    eq(t.dump(), "┌──┐q\n", "DEC line drawing");
    t.go("~[2J~[H~(0x~(Bx");
    eq(t.dump(), "│x\n", "charset back to ASCII");
    t.go("~[2J~[H~]2;my title$");
    eq(t.g.title.str(), "my title", "OSC 2");
    t.go("~]0;other~\\");
    eq(t.g.title.str(), "other", "OSC 0 with ST");
    t.go("~[2J~[H~]8;;http://x.test/a~\\ab~]8;;~\\c~]8;;http://x.test/a~\\d~]8;;http://y~\\e~]8;;~\\");
    eqi(int(t.g.cell(0, 0).link), 1, "linked cell");
    eqi(int(t.g.cell(2, 0).link), 0, "unlinked cell");
    eqi(int(t.g.cell(3, 0).link), 1, "same URI reuses its id");
    eqi(int(t.g.cell(4, 0).link), 2, "new URI gets a new id");
    eq(t.g.linkUri(1), "http://x.test/a", "linkUri");
    eq(t.g.linkUri(2), "http://y", "linkUri 2");
}

fn resizing(a: &Arena) {
    let t = term(a, 10, 4, 10);
    t.go("r0\r\nr1\r\nr2\r\nr3");
    cursor(&t, 2, 3, "before resize");
    t.g.resize(6, 2);
    eq(t.dump(), "r2\nr3", "shrunk: the cursor line stays, the top goes to scrollback");
    cursor(&t, 2, 1, "cursor after shrink");
    eqi(t.g.scrollbackLen(), 2, "two rows pushed");
    eq(t.g.lineString(0, a), "r0", "scrollback line");
    t.g.resize(12, 5);
    eq(t.dump(), "r2\nr3\n\n\n", "grown: padded with blank rows");
    cursor(&t, 2, 1, "cursor after growth");
    t.go("~[5;12Hz");
    ok(t.g.cell(11, 4).cp == 122, "new columns are usable");
    t.go("~[1;1H\ta");
    ok(t.g.cell(8, 0).cp == 97, "tab stops exist in new columns");
    t.g.resize(3, 3);
    cursor(&t, 2, 2, "cursor follows its text through reflow");
    eqi(t.g.scrollbackLen(), 2, "no push when the cursor fits");
    let w = term(a, 4, 2, 0);
    w.go("ab中");
    w.g.resize(3, 2);
    eq(w.dump(), "ab\n中", "a wide char past the new edge moves to the next row");
    w.g.resize(8, 2);
    w.go("~[?1049h~[?1049l");
    eq(w.dump(), "ab中\n", "alt switch after resize");
    let v = term(a, 4, 2, 0);
    v.go("~[?1049hab中");
    v.g.resize(3, 2);
    eq(v.dump(), "ab\n", "the alt screen is cut, not reflowed");
    let s = term(a, 10, 6, 0);
    s.go("~[2;4r");
    s.g.resize(10, 3);
    eqi(s.g.top, 0, "region reset by resize");
    eqi(s.g.bot, 2, "region reset to the new height");
    s.go("~[1;1Habc");
    s.g.resize(300, 100);
    s.go("~[3;300Hz");
    ok(s.g.cell(299, 2).cp == 122, "storage growth past the limits keeps working");
    ok(s.g.cell(0, 0).cp == 97 && s.g.cell(2, 0).cp == 99, "content kept across growth");
}

fn reflow(a: &Arena) {
    let x30 = repeat("x", 30, a);
    let x10 = repeat("x", 10, a);
    let t = term(a, 20, 6, 100);
    t.go(x30);
    t.go("\r\nok");
    ok(t.g.wrapped(0) && !t.g.wrapped(1), "a printed wrap is marked");
    t.g.resize(10, 6);
    eq(t.dump(), join(repeat(join(x10, "\n", a), 3, a), "ok\n\n", a), "narrower: 3 rows of x then ok");
    cursor(&t, 2, 3, "cursor after ok (narrow)");
    ok(t.g.wrapped(0) && t.g.wrapped(1) && !t.g.wrapped(2), "rewrapped rows are marked");
    t.g.resize(40, 6);
    eq(t.dump(), join(x30, "\nok\n\n\n\n", a), "wider: one line again");
    cursor(&t, 2, 1, "cursor after ok (wide)");
    // with the lines in scrollback
    let u = term(a, 20, 2, 100);
    u.go(x30);
    u.go("\r\nok");
    eqi(u.g.scrollbackLen(), 1, "first row in scrollback");
    u.g.resize(10, 2);
    eq(u.dump(), join(x10, "\nok", a), "narrower with scrollback");
    eqi(u.g.scrollbackLen(), 2, "two rows of x in scrollback");
    cursor(&u, 2, 1, "cursor (narrow, scrolled)");
    u.g.resize(40, 2);
    eq(u.dump(), join(x30, "\nok", a), "wider with scrollback: joined back");
    eqi(u.g.scrollbackLen(), 0, "scrollback rows rejoined");
    cursor(&u, 2, 1, "cursor (wide, scrolled)");
    // pending wrap at the end of a full row
    let p = term(a, 10, 3, 10);
    p.go("abcdefghij");
    p.g.resize(5, 3);
    eq(p.dump(), "abcde\nfghij\n", "full row split");
    cursor(&p, 4, 1, "cursor pending at the end");
    p.go("k");
    eq(p.dump(), "abcde\nfghij\nk", "the pending wrap survives a reflow");
}

fn marks(a: &Arena) {
    let t = term(a, 4, 2, 0);
    t.go("éx");
    eq(t.dump(), "éx\n", "a combining mark stays with its base");
    ok(t.g.cell(0, 0).mark(0) == 0x301 && t.g.cell(1, 0).cp == 120, "one cell for e + U+0301");
    t.go("\r\ń");
    eq(t.dump(), "éx\n", "a mark at the start of a row is dropped");
    t.go("~[1;4Hȫ́");
    ok(t.g.cell(3, 0).mark(0) == 0x308 && t.g.cell(3, 0).mark(1) == 0x304, "two marks kept on a pending-wrap cell, a third dropped");
    t.go("~[2;1H中́");
    ok(t.g.cell(0, 1).mark(0) == 0x301, "a mark after a wide char goes on its head");
    t.go("~[2;1Hz");
    ok(t.g.cell(0, 1).marks == 0, "overwriting clears the marks");
}

fn dragWide(a: &Arena) {
    let t = term(a, 80, 4, 50);
    t.go("hello\r\nworld");
    for c in 81..1001 {
        t.g.resize(c, 4);
    }
    for c in 0..920 {
        t.g.resize(1000 - c, 4);
    }
    ok(t.g.reserves <= 3, "one-column resizes grow storage geometrically");
    eq(t.dump(), "hello\nworld\n\n", "content survives a wide drag");
    t.g.resize(1000, 4);
    t.go("~[1;1H~[3;1Habc");
    ok(t.g.cell(2, 2).cp == 99, "grid usable after growth");
}

fn scrollback(a: &Arena) {
    let t = term(a, 4, 2, 3);
    t.go("1\r\n2\r\n3\r\n4\r\n5\r\n6\r\n7");
    eqi(t.g.scrollbackLen(), 3, "capped");
    eq(t.g.lineString(0, a), "3", "oldest kept");
    eq(t.g.lineString(2, a), "5", "newest scrollback");
    eq(t.g.lineString(3, a), "6", "first screen row");
    eq(t.g.lineString(4, a), "7", "last screen row");
    eqi(t.g.lineCount(), 5, "lineCount");
    eqi(t.g.viewLine(1, 0).len, 4, "view row width");
    eqi(int(t.g.viewLine(1, 0)[0].cp), 53, "viewLine scrolled back one line shows 5 first");
    eqi(int(t.g.viewLine(99, 0)[0].cp), 51, "view offset clamps to the oldest line");
    eqi(int(t.g.viewLine(0, 1)[0].cp), 55, "offset 0 is the screen");
    t.go("~[3J");
    eqi(t.g.scrollbackLen(), 0, "ED 3 drops scrollback");
    let z = term(a, 4, 2, 0);
    z.go("1\r\n2\r\n3");
    eqi(z.g.scrollbackLen(), 0, "zero capacity keeps nothing");
    eq(z.dump(), "2\n3", "and still scrolls");
    let d = term(a, 4, 2, 5);
    d.g.clearDirty();
    ok(!d.g.anyDirty(), "clean after clearDirty");
    d.go("a");
    ok(d.g.isDirty(0) && !d.g.isDirty(1), "print marks its row");
    d.g.clearDirty();
    d.go("\r\n\r\nx");
    ok(d.g.isDirty(0) && d.g.isDirty(1), "a scroll marks the region");
}

fn lineOf(i: int, a: &Arena): string {
    let t = Text.new(a);
    t.add("line ");
    t.pushInt(i);
    t.add(" ").add("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
    return t.str();
}

fn bulk(a: &Arena) {
    let all = Text.new(a);
    for i in 0..14000 {
        all.add(lineOf(i, a)).add("\r\n");
    }
    ok(all.len() > 900000, "about 1 MB of input");
    let t = term(a, 80, 24, 1000);
    t.p.feed(all.str(), &t.g);
    eqi(t.g.scrollbackLen(), 1000, "scrollback capped");
    eq(t.g.lineString(1000 + 22, a), lineOf(13999, a), "last line");
    eq(t.g.lineString(1000 + 0, a), lineOf(13977, a), "first screen line");
    eq(t.g.lineString(1000 + 23, a), "", "cursor row is empty");
    eq(t.g.lineString(0, a), lineOf(13977 - 1000, a), "oldest kept");
}

fn fixtureDir(): string {
    return if exists("stdlib/tests/term_fixtures/ls.bin") { "stdlib/tests/term_fixtures/" } else { "j3c/stdlib/tests/term_fixtures/" };
}

fn readFix(name: string, a: &Arena): string {
    let t = Text.new(a);
    t.add(fixtureDir()).add(name);
    let out = "";
    match readFile(t.str(), a) {
        Result.Ok(b) {
            out = b as string;
        }
        Result.Err(e) {
            printLn(`FAIL: cannot read fixture {t.str()}`);
            panic("fixture");
        }
    }
    return out;
}

fn fixture(name: string, cols: int, rows: int, a: &Arena) {
    let bin = Text.new(a);
    bin.add(name).add(".bin");
    let txt = Text.new(a);
    txt.add(name).add(".txt");
    let t = term(a, cols, rows, 100);
    let bytes = readFix(bin.str(), a);
    // whole, then in 7-byte pieces: the same screen
    t.p.feed(bytes, &t.g);
    let want = readFix(txt.str(), a);
    let got = t.dump();
    let w = if want.len > 0 && want[want.len - 1] == 10 { want[0..want.len - 1] } else { want };
    eq(got, w, `fixture {name}`);
    let u = term(a, cols, rows, 100);
    let i = 0;
    while i < bytes.len {
        let e = if i + 7 < bytes.len { i + 7 } else { bytes.len };
        u.p.feed(bytes[i..e], &u.g);
        i = e;
    }
    eq(u.dump(), got, `fixture {name} in pieces`);
}

fn main() {
    let a = Arena.create(256 * 1024 * 1024);
    moves(&a);
    tabs(&a);
    deferredWrap(&a);
    regions(&a);
    origin(&a);
    erase(&a);
    pen(&a);
    wide(&a);
    altScreen(&a);
    modes(&a);
    replies(&a);
    textAttrs(&a);
    resizing(&a);
    reflow(&a);
    marks(&a);
    scrollback(&a);
    dragWide(&a);
    bulk(&a);
    fixture("ls", 80, 24, &a);
    fixture("vim", 80, 24, &a);
    fixture("less", 80, 24, &a);
    printLn("term_grid_test ok");
}
