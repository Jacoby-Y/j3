// Tests for :focus-within and :focus-visible through j3.ui.dom: Tab focus shows, a click on a button does not, a click on a
// text box does, the ancestor chain follows the focus (and costs depth, not size), a popover's content counts for its owner,
// a focused node that goes away, the modality setter (a gamepad layer), and steady frames. Parsing and specificity are in css_test.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/focus_test.j3 --headless
// Panics on the first failed check.

module focus_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.{ Css, FL_FOCUS, FL_FOCUS_VIS, FL_FOCUS_WITHIN };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button, input { font-family: \"T\"; font-size: 14px; } .o { width: 300px; } .o:focus-within { width: 301px; } button { width: 50px; height: 20px; } button:focus-visible { height: 21px; } button:not(:focus-visible) { width: 51px; } .anchor { position: relative; width: 90px; height: 20px; } .menu { position: absolute; left: 0; top: 100%; width: 80px; height: 40px; } .fill { height: 2px; } .ct { display: contents; } .ct:focus-within > button { height: 33px; }";

#[singleton]
let SHOW_MID: bool;
#[singleton]
let SHOW_POP: bool;
#[singleton]
let FILL: int;
#[singleton]
let A: int;
#[singleton]
let B: int;
#[singleton]
let OUTER: int;
#[singleton]
let MID: int;
#[singleton]
let TB: int;
#[singleton]
let OTHER: int;
#[singleton]
let ANCHOR: int;
#[singleton]
let PB: int;
#[singleton]
let CHK: int;
#[singleton]
let CT: int;
#[singleton]
let CB: int;

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    for i in 0..FILL {
        let f = d.open(100 + i, d.tag("div"), 1);
        d.cls(f, "fill");
        d.close();
    }
    OUTER = d.open(0, d.tag("div"), 1);
    d.cls(OUTER, "o");
    if SHOW_MID {
        MID = d.open(0, d.tag("div"), 1);
        A = d.open(0, d.tag("button"), 1);
        d.close();
        B = d.open(1, d.tag("button"), 1);
        d.close();
        d.close();
    }
    d.close();
    OTHER = d.open(1, d.tag("div"), 1);
    d.cls(OTHER, "o");
    TB = d.open(0, d.tag("input"), 1);
    d.attrType(TB, "text");
    d.close();
    CHK = d.open(1, d.tag("input"), 1);
    d.attrType(CHK, "checkbox");
    d.close();
    d.close();
    ANCHOR = d.open(2, d.tag("div"), 1);
    d.cls(ANCHOR, "anchor");
    if SHOW_POP {
        let m = d.open(0, d.tag("div"), 1);
        d.cls(m, "menu");
        d.attrOverlay(m, dom.OV_POPOVER);
        PB = d.open(0, d.tag("button"), 1);
        d.close();
        d.close();
    }
    d.close();
    CT = d.open(3, d.tag("div"), 1);
    d.cls(CT, "ct");
    CB = d.open(0, d.tag("button"), 1);
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn cx(d: &Dom, id: int): f32 { return d.absX(id) + d.nodes.items[id].w / 2.0; }
fn cy(d: &Dom, id: int): f32 { return d.absY(id) + d.nodes.items[id].h / 2.0; }

fn click(d: &Dom, id: int) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0);
    frame(d);
    d.simInput(cx(d, id), cy(d, id), true, 0.0);
    frame(d);
    d.simInput(cx(d, id), cy(d, id), false, 0.0);
    frame(d);
}

fn key(d: &Dom, names: string) {
    d.simKeys("", names);
    frame(d);
}

fn has(d: &Dom, id: int, bit: int): bool {
    return (d.mnodes.items[id].flags / bit) % 2 == 1;
}

fn fresh(mem: &Arena, css: &Css, fill: int): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    SHOW_MID = true;
    SHOW_POP = false;
    FILL = fill;
    frame(&d);
    frame(&d);
    return d;
}

fn testKeyboardAndMouse(mem: &Arena, css: &Css) {
    let d = fresh(mem, css, 0);
    ok(!has(&d, OUTER, FL_FOCUS_WITHIN) && !d.focusVisible(), "nothing focused at the start");
    key(&d, "Tab");
    ok(d.focused() == A && d.keyboard(), "Tab focuses the first button");
    ok(has(&d, A, FL_FOCUS) && has(&d, A, FL_FOCUS_VIS) && d.focusVisible(), "a Tab focus is :focus-visible");
    ok(has(&d, A, FL_FOCUS_WITHIN) && has(&d, MID, FL_FOCUS_WITHIN) && has(&d, OUTER, FL_FOCUS_WITHIN), ":focus-within is the node and all its ancestors");
    ok(!has(&d, OTHER, FL_FOCUS_WITHIN) && !has(&d, B, FL_FOCUS_WITHIN), "and nothing else");
    ok(d.nodes.items[OUTER].w == 301.0 && d.nodes.items[A].h == 21.0 && d.nodes.items[A].w == 50.0, "the rules apply: ring on, :not(:focus-visible) off");
    key(&d, "Tab");
    ok(d.focused() == B && !has(&d, A, FL_FOCUS_VIS) && !has(&d, A, FL_FOCUS_WITHIN) && has(&d, B, FL_FOCUS_VIS), "Tab moves visibility with the focus");
    ok(has(&d, OUTER, FL_FOCUS_WITHIN), "the shared ancestor stays");
    // text box: Tab goes on to it; focus-within moves to the other container
    key(&d, "Tab");
    ok(d.focused() == TB && has(&d, TB, FL_FOCUS_VIS) && has(&d, OTHER, FL_FOCUS_WITHIN) && !has(&d, OUTER, FL_FOCUS_WITHIN), "focus-within moves to the other container");
    ok(d.nodes.items[OUTER].w == 300.0 && d.nodes.items[OTHER].w == 301.0, "and the old ring is off");
    // a click on a button after keyboard use: pointer modality, not visible
    click(&d, A);
    ok(d.focused() == A && !d.keyboard(), "a click focuses the button and flips the modality");
    ok(has(&d, A, FL_FOCUS) && !has(&d, A, FL_FOCUS_VIS) && !d.focusVisible(), "a click focus is not :focus-visible");
    ok(has(&d, OUTER, FL_FOCUS_WITHIN), ":focus-within does not care how");
    ok(d.nodes.items[A].h == 20.0 && d.nodes.items[A].w == 51.0, "so :not(:focus-visible) applies");
    // a click on a text box always shows
    click(&d, TB);
    ok(d.focused() == TB && has(&d, TB, FL_FOCUS_VIS) && !d.keyboard(), "a click on a text box is :focus-visible");
    // a click on a checkbox is a button-like focus
    click(&d, CHK);
    ok(d.focused() == CHK && !has(&d, CHK, FL_FOCUS_VIS), "a click on a checkbox is not");
    // Tab after a click goes back to visible
    key(&d, "Tab");
    ok(d.keyboard() && d.focusVisible(), "a key makes the next focus visible again");
    // a key while a mouse-focused button has focus shows the ring on it (one restyle), as in a browser
    click(&d, A);
    ok(d.focused() == A && !d.focusVisible(), "mouse focus again");
    let r0 = d.restyled;
    key(&d, "Down");
    ok(d.focused() == A && d.focusVisible() && d.keyboard(), "a key shows the ring on the focused node");
    ok(d.restyled - r0 <= 2, "and restyles that node only");
    // a press and a key in one frame: the press moves focus first, then the key (inputs.begin) makes it visible
    d.simInput(cx(&d, B), cy(&d, B), false, 0.0);
    frame(&d);
    d.setKeyboard(false);
    d.simInput(cx(&d, B), cy(&d, B), true, 0.0);
    d.simKeys("", "Down");
    frame(&d);
    ok(d.focused() == B && d.focusVisible() && d.keyboard(), "press and key in one frame: keyboard mode, ring on the pressed button");
    d.simInput(cx(&d, B), cy(&d, B), false, 0.0);
    frame(&d);
    // blur
    click(&d, d.nodes.items[OTHER].next);
    ok(d.focused() < 0 && !has(&d, OTHER, FL_FOCUS_WITHIN) && !d.focusVisible(), "a click on nothing clears focus and the chain");
    // the seam: a gamepad layer says "keyboard" and moves focus in code
    d.setKeyboard(true);
    d.focusNode(B);
    ok(d.focusVisible(), "programmatic focus after setKeyboard(true) is visible");
    d.setKeyboard(false);
    d.focusNode(A);
    ok(!d.focusVisible() && has(&d, A, FL_FOCUS), "and not after setKeyboard(false)");
    d.focusNode(TB);
    ok(d.focusVisible(), "a text box is visible whatever the modality");
}

// `display: contents` takes no box but stays in the tree: its :focus-within works and styles its children
fn testContents(mem: &Arena, css: &Css) {
    let d = fresh(mem, css, 0);
    ok(d.nodes.items[CB].h == 20.0, "setup");
    d.focusNode(CB);
    frame(&d);
    ok(has(&d, CT, FL_FOCUS_WITHIN) && d.nodes.items[CB].h == 33.0, "a contents parent is :focus-within and restyles its child");
    d.focusNode(A);
    frame(&d);
    ok(!has(&d, CT, FL_FOCUS_WITHIN) && d.nodes.items[CB].h == 20.0, "and lets go");
}

fn testCost(mem: &Arena, css: &Css) {
    let d = fresh(mem, css, 60);
    key(&d, "Tab");
    let r0 = d.restyled;
    key(&d, "Tab");
    ok(d.focused() == B, "to the second button");
    ok(d.restyled - r0 <= 3, "a move inside one container restyles the two buttons at most");
    r0 = d.restyled;
    key(&d, "Tab");
    ok(d.focused() == TB, "to the text box");
    // old: B, MID, OUTER; new: TB, OTHER (+ their children); the 60 fillers and the page are not touched
    ok(d.restyled - r0 <= 10, `a move across containers restyles the two chains and what inherits from them ({d.restyled - r0})`);
    // the text box allocates its edit buffer on the first frame it has focus (not ours); after that idle is free
    frame(&d);
    let u1 = d.mem.used;
    let l1 = d.laid;
    let r1 = d.restyled;
    for i in 0..30 {
        frame(&d);
    }
    ok(d.mem.used == u1 && d.laid == l1 && d.restyled == r1, "idle frames with a focused text box are free");
    // steady, with the ring on (a focused text box has its own caret cost, not this chunk's)
    key(&d, "S+Tab");
    ok(d.focused() == B && d.focusVisible(), "back to the button");
    frame(&d);
    let used = d.mem.used;
    let laid = d.laid;
    let rest = d.restyled;
    for i in 0..30 {
        frame(&d);
    }
    ok(d.mem.used == used && d.laid == laid && d.restyled == rest, "idle frames allocate, lay out and restyle nothing");
}

fn testPopover(mem: &Arena, css: &Css) {
    let d = fresh(mem, css, 0);
    SHOW_POP = true;
    frame(&d);
    ok(d.nodes.items[d.nodes.items[PB].parent].parent == ANCHOR, "the popover is a child of its owner");
    d.setKeyboard(true);
    d.focusNode(PB);
    ok(d.focused() == PB && has(&d, ANCHOR, FL_FOCUS_WITHIN), "focus in a popover is :focus-within for its owner");
    SHOW_POP = false;
    frame(&d);
    frame(&d);
    ok(d.focused() < 0 && !has(&d, ANCHOR, FL_FOCUS_WITHIN), "the popover closing takes the focus and the chain with it");
}

fn testRemoved(mem: &Arena, css: &Css) {
    let d = fresh(mem, css, 0);
    key(&d, "Tab");
    ok(has(&d, OUTER, FL_FOCUS_WITHIN), "setup");
    SHOW_MID = false;
    frame(&d);
    frame(&d);
    ok(d.focused() < 0, "a removed focused node loses focus");
    ok(!has(&d, OUTER, FL_FOCUS_WITHIN), "and its surviving ancestor stops matching");
    ok(d.nodes.items[OUTER].w == 300.0, "the ring is gone");
    SHOW_MID = true;
    frame(&d);
    ok(!has(&d, A, FL_FOCUS_WITHIN) && !has(&d, A, FL_FOCUS) && !has(&d, A, FL_FOCUS_VIS), "a recycled node starts clean");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "focus.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    testKeyboardAndMouse(&mem, &css);
    testContents(&mem, &css);
    testCost(&mem, &css);
    testPopover(&mem, &css);
    testRemoved(&mem, &css);
    printLn(`focus_test ok, checks passed: {CHECKS}`);
}
