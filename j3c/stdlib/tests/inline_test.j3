// Tests for inline boxes (`display: inline` elements with padding, border, margin or background) in j3.ui.dom:
// box geometry on one line, per-line pieces of a wrapped span, nested spans, hit testing and :hover on the padding,
// line-clamp, justify, `::before` pills, steady frames. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/inline_test.j3
// Panics on the first failed check.

module inline_test;

use j3.game.{ fontLine, loadFont, textWidth, Font };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, Frag };
use j3.ui.inputs;

#[singleton]
let CHECKS: int;
#[singleton]
let ITEMS: [8]int;
#[singleton]
let WPX: int;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .n100 { width: 100px; } .n180 { width: 180px; } .pill { padding: 2px 6px; border: 1px solid #ff0000; background: #0000ff; } .pill:hover { background: #00ff00; } .o { padding: 0 4px; background: #888888; } .i { padding: 0 3px; background: #444444; } .m { margin: 0 10px; background: #888888; } .tag::before { content: \"[\"; padding: 0 2px; background: #00aa00; border-radius: 3px; } .clamp { line-clamp: 1; } .just { text-align: justify; } .nob { background: #888888; } .ib { position: absolute; } .fl { display: flex; width: 400px; } .fl30 { display: flex; width: 30px; } .padt { padding-top: 10px; }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff > tol {
        printLn(`FAIL: {msg}: got {a}, want {b}`);
        panic(msg);
    }
}

fn bytes(s: string): []u8 {
    return []u8 { ptr: s.ptr, len: s.len };
}

const LONG: string = "alpha beta gamma delta epsilon zeta eta theta";

/// kind 0: `ab <pill>Rare</pill> cd`; 1: a pill alone with long text; 2: `<o><i>xyz</i></o>`; 3: `<tag>Rare</tag>`;
/// 4: margin only; 5: pill in the middle of long text; 6: plain (no box).
fn frame(d: &Dom, kind: int, cls: string, spanCls: string) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let outer = -1;
    if kind == 7 {
        outer = d.open(0, d.tag("div"), 1);
        d.cls(outer, "padt");
        ITEMS[3] = outer;
    }
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, "box");
    if cls.len > 0 { d.cls(c, if cls.len > 4 { "n100" } else { cls }); }
    if same(cls, "n100 clamp") { d.cls(c, "clamp"); } else if same(cls, "n100 just") { d.cls(c, "just"); }
    ITEMS[0] = c;
    if same(cls, "title") { d.attrTitle(c, "tip"); }
    if kind == 0 {
        d.text("ab ");
        let s = d.open(0, d.tag("span"), 1);
        d.cls(s, spanCls);
        ITEMS[1] = s;
        d.text("Rare");
        d.close();
        d.text(" cd");
    } else if kind == 1 {
        let s1 = d.open(0, d.tag("span"), 1);
        d.cls(s1, spanCls);
        ITEMS[1] = s1;
        d.text(LONG);
        d.close();
    } else if kind == 2 {
        let o = d.open(0, d.tag("span"), 1);
        d.cls(o, "o");
        ITEMS[1] = o;
        let i = d.open(0, d.tag("span"), 1);
        d.cls(i, "i");
        ITEMS[2] = i;
        d.text("xyz");
        d.close();
        d.close();
    } else if kind == 3 {
        let s3 = d.open(0, d.tag("span"), 1);
        d.cls(s3, "tag");
        ITEMS[1] = s3;
        d.text("Rare");
        d.close();
    } else if kind == 4 {
        d.text("ab");
        let s4 = d.open(0, d.tag("span"), 1);
        d.cls(s4, "m");
        ITEMS[1] = s4;
        d.text("cd");
        d.close();
        d.text("ef");
    } else if kind == 5 {
        d.text("alpha beta ");
        let s5 = d.open(0, d.tag("span"), 1);
        d.cls(s5, spanCls);
        ITEMS[1] = s5;
        d.text("gamma delta epsilon zeta");
        d.close();
        d.text(" eta theta iota");
    } else if kind == 7 {
        d.text("ab ");
        let s7 = d.open(0, d.tag("span"), 1);
        d.cls(s7, "pill");
        ITEMS[1] = s7;
        d.text("Rare");
        d.close();
    } else if kind == 8 {
        let ib = d.open(0, d.tag("div"), 1);
        d.cls(ib, "ib");
        ITEMS[2] = ib;
        let s8 = d.open(0, d.tag("span"), 1);
        d.cls(s8, "pill");
        ITEMS[1] = s8;
        d.text("Rare");
        d.close();
        d.close();
    } else if kind == 9 {
        let fi = d.open(0, d.tag("div"), 1);
        ITEMS[2] = fi;
        let s9 = d.open(0, d.tag("span"), 1);
        d.cls(s9, "pill");
        ITEMS[1] = s9;
        d.text("Rare");
        d.close();
        d.close();
    } else if kind == 10 {
        d.styleStr(c, 0, "width", `{WPX}px`);
        d.text("alpha beta ");
        let sa = d.open(0, d.tag("span"), 1);
        d.cls(sa, "pill");
        ITEMS[1] = sa;
        d.text("gamma");
        d.close();
    } else {
        d.text("ab ");
        let s6 = d.open(0, d.tag("span"), 1);
        ITEMS[1] = s6;
        d.text("Rare");
        d.close();
    }
    if kind == 7 { d.close(); }
    d.layout();
    d.endFrame();
}

fn nbox(d: &Dom, owner: int): int {
    let n = 0;
    let f = d.nodes.items[owner].box0;
    while f >= 0 {
        n += 1;
        f = d.boxes.items[f].next;
    }
    return n;
}

fn boxN(d: &Dom, owner: int, k: int): Frag {
    let f = d.nodes.items[owner].box0;
    while k > 0 {
        f = d.boxes.items[f].next;
        k -= 1;
    }
    return d.boxes.items[f];
}

/// The k-th text fragment of `owner`.
fn fragN(d: &Dom, owner: int, k: int): Frag {
    let f = d.nodes.items[owner].frag0;
    while k > 0 {
        f = d.frags.items[f].next;
        k -= 1;
    }
    return d.frags.items[f];
}

fn nfrag(d: &Dom, owner: int): int {
    let n = 0;
    let f = d.nodes.items[owner].frag0;
    while f >= 0 {
        n += 1;
        f = d.frags.items[f].next;
    }
    return n;
}

fn testSingle(mem: &Arena, css: &Css, font: Font) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 0, "", "pill");
    frame(&d, 0, "", "pill");
    let c = ITEMS[0];
    let lh = f32(fontLine(font));
    ok(nbox(&d, c) == 1, "one box for a one-line span");
    let b = boxN(&d, c, 0);
    let rare = fragN(&d, c, 1);
    ok(d.nodes.items[rare.node].parent == ITEMS[1], "the second fragment is the span's text");
    near(b.x, rare.x - 7.0, 0.01, "box starts padding + border before the text");
    near(b.w, rare.w + 14.0, 0.01, "box is text + 2 x (padding 6 + border 1) wide");
    near(b.y, rare.y - 3.0, 0.01, "box top is padding 2 + border 1 above the text");
    near(b.ap, lh + 6.0, 0.01, "box height is the line + vertical padding and border");
    ok(b.node == ITEMS[1] && b.start == 1 && b.end == 1, "a one-line box is both first and last");
    let cd = fragN(&d, c, 2);
    near(cd.x - (b.x + b.w), textWidth(font, bytes(" "), false), 0.6, "text after the box follows its right edge plus the space");
    near(d.nodes.items[c].h, lh, 0.01, "vertical padding and border do not change the line height");
    let plain = Dom.new(mem, css);
    plain.setFrameMs(16.0);
    plain.simInput(-5.0, -5.0, false, 0.0);
    frame(&plain, 6, "", "");
    frame(&plain, 6, "", "");
    ok(nbox(&plain, ITEMS[0]) == 0, "a span with no decoration has no box");
    // widening: the box adds 14px to the line
    let w0 = fragN(&plain, ITEMS[0], 1).x;
    near(rare.x - w0, 7.0, 0.6, "the left edge pushes the text right");
    // margin only: takes room, paints nothing visible but keeps geometry
    let m = Dom.new(mem, css);
    m.setFrameMs(16.0);
    m.simInput(-5.0, -5.0, false, 0.0);
    frame(&m, 4, "", "");
    frame(&m, 4, "", "");
    let ab = fragN(&m, ITEMS[0], 0);
    let cdm = fragN(&m, ITEMS[0], 1);
    let ef = fragN(&m, ITEMS[0], 2);
    near(cdm.x - (ab.x + ab.w), 10.0, 0.6, "margin-left of a span pushes its text");
    near(ef.x - (cdm.x + cdm.w), 10.0, 0.6, "margin-right pushes what follows");
    let mb = boxN(&m, ITEMS[0], 0);
    near(mb.x, cdm.x, 0.01, "the box excludes the margin");
    near(mb.w, cdm.w, 0.01, "and has no padding");
    // hit test on the padding
    d.simInput(b.x + 2.0, b.y + 5.0, false, 0.0);
    frame(&d, 0, "", "pill");
    frame(&d, 0, "", "pill");
    ok(d.hover == ITEMS[1], "the pointer over the span's padding hovers the span");
    let sty = d.nodes.items[ITEMS[1]].style;
    d.simInput(b.x - 3.0, b.y + 5.0, false, 0.0);
    frame(&d, 0, "", "pill");
    frame(&d, 0, "", "pill");
    ok(d.hover == c, "left of the box hovers the block");
    ok(d.nodes.items[ITEMS[1]].style != sty, "the :hover rule left the span's style");
    d.simInput(b.x + b.w - 1.0, b.y + 5.0, false, 0.0);
    frame(&d, 0, "", "pill");
    frame(&d, 0, "", "pill");
    ok(d.hover == ITEMS[1], "the right border hovers the span");
    // exact-target handlers on the block still see a press / move / wheel on its span's padding
    let m2 = Dom.new(mem, css);
    m2.setFrameMs(16.0);
    m2.simInput(b.x + 2.0, b.y + 5.0, false, 0.0);
    frame(&m2, 0, "", "pill");
    frame(&m2, 0, "", "pill");
    m2.simInput(b.x + 6.0, b.y + 5.0, false, 0.0);
    frame(&m2, 0, "", "pill");
    ok(m2.mouseMove(ITEMS[0]) && m2.hover == ITEMS[1], "mouseMove on the block fires over its span");
    m2.simInput(b.x + 6.0, b.y + 5.0, true, 0.0);
    frame(&m2, 0, "", "pill");
    ok(m2.mouseDown(ITEMS[0]) && m2.mouseDown(ITEMS[1]), "mouseDown on the block fires for a press on its span");
    m2.simInput(b.x + 6.0, b.y + 5.0, false, 0.0);
    frame(&m2, 0, "", "pill");
    ok(m2.mouseUp(ITEMS[0]), "mouseUp on the block fires for a release on its span");
    // a title on the block still shows when the pointer is on the span
    let t = Dom.new(mem, css);
    t.setFrameMs(16.0);
    t.simInput(b.x + 2.0, b.y + 5.0, false, 0.0);
    frame(&t, 0, "title", "pill");
    frame(&t, 0, "title", "pill");
    ok(t.hover == ITEMS[1] && t.tipNode == ITEMS[0], "the block's title is the tooltip of its span's padding");
    // steady
    let l0 = d.laid;
    let s0 = d.restyled;
    let n0 = d.nodes.len;
    let bx0 = d.boxes.len;
    let fr0 = d.frags.len;
    for i in 0..30 { frame(&d, 0, "", "pill"); }
    ok(d.laid == l0 && d.restyled == s0 && d.nodes.len == n0 && d.boxes.len == bx0 && d.frags.len == fr0, "steady frames: no layout, restyle or allocation");
}

fn testWrap(mem: &Arena, css: &Css, font: Font) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 1, "n100", "pill");
    frame(&d, 1, "n100", "pill");
    let c = ITEMS[0];
    let nb = nbox(&d, c);
    ok(nb >= 3, "a wrapped span has a box per line");
    let b0 = boxN(&d, c, 0);
    let b1 = boxN(&d, c, 1);
    let bl = boxN(&d, c, nb - 1);
    ok(b0.start == 1 && b0.end == 0, "first piece: left edge only");
    ok(b1.start == 0 && b1.end == (if nb == 2 { 1 } else { 0 }), "middle piece: no edges");
    ok(bl.start == 0 && bl.end == 1, "last piece: right edge only");
    near(b0.x, 0.0, 0.01, "first piece starts at the line start");
    near(bl.x, 0.0, 0.01, "later pieces start at the line start (no left padding)");
    ok(b1.y > b0.y + 10.0 && bl.y > b1.y - 0.01, "pieces sit on successive lines");
    // last piece's right edge: its last text fragment end + padding + border
    let lastF = fragN(&d, c, nfrag(&d, c) - 1);
    near(bl.x + bl.w, lastF.x + lastF.w + 7.0, 0.01, "the last piece ends 7px past the last word");
    // first piece's right edge is the end of the first line's last fragment (no padding on a wrapped line)
    let firstLast = fragN(&d, c, 0);
    let k = 0;
    while fragN(&d, c, k + 1).y == firstLast.y && k + 1 < nfrag(&d, c) - 1 {
        k += 1;
    }
    let fl = fragN(&d, c, k);
    near(b0.x + b0.w, fl.x + fl.w, 0.01, "a wrapped line's piece ends at its last word");
    near(fragN(&d, c, 0).x, 7.0, 0.01, "first word is 7px in");
    // hit on the second line's piece
    d.simInput(b1.x + 2.0, b1.y + 5.0, false, 0.0);
    frame(&d, 1, "n100", "pill");
    frame(&d, 1, "n100", "pill");
    ok(d.hover == ITEMS[1], "a click on any line's piece targets the span");
    // block height is lines x line height
    let lh = f32(fontLine(font));
    near(d.nodes.items[c].h, lh * f32(nb), 0.01, "padding does not grow wrapped lines");
    // line-clamp (classes are only ever added to a reused node: a new Dom each time)
    d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 1, "n100 clamp", "pill");
    frame(&d, 1, "n100 clamp", "pill");
    ok(nbox(&d, c) == 1, "line-clamp: one piece, the cut-off lines have none");
    let cb = boxN(&d, c, 0);
    ok(cb.start == 1 && cb.end == 0, "the clamped piece keeps no right edge");
    // justify: the first line is stretched to the width, the piece follows
    d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 1, "n100 just", "nob");
    frame(&d, 1, "n100 just", "nob");
    let j0 = boxN(&d, c, 0);
    near(j0.x + j0.w, 100.0, 0.5, "justify: the piece spans the stretched line");
    d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 5, "n180", "pill");
    frame(&d, 5, "n180", "pill");
    ok(nbox(&d, c) >= 2, "a span in the middle of the text wraps into pieces");
    let m0 = boxN(&d, c, 0);
    ok(m0.start == 1 && m0.x > 0.0, "the first piece starts after the preceding words");
}

fn testEdges(mem: &Arena, css: &Css, font: Font) {
    // the closing edge fits with the last word: "gamma" + 7px must not hang over the line end
    let w0 = textWidth(font, bytes("alpha beta "), false) + 7.0 + textWidth(font, bytes("gamma"), false);
    WPX = int(w0) + 3;
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 10, "", "");
    frame(&d, 10, "", "");
    let c = ITEMS[0];
    let lh = f32(fontLine(font));
    ok(d.nodes.items[c].h > lh * 1.5, "the last word wraps when its closing edge would overflow");
    let b = boxN(&d, c, nbox(&d, c) - 1);
    ok(b.x + b.w <= f32(WPX) + 0.01, "the pill ends inside the line");
    WPX = int(w0) + 8;
    let e = Dom.new(mem, css);
    e.setFrameMs(16.0);
    e.simInput(-5.0, -5.0, false, 0.0);
    frame(&e, 10, "", "");
    frame(&e, 10, "", "");
    near(e.nodes.items[ITEMS[0]].h, lh, 0.01, "with room for the edge it stays on one line");
    // shrink-to-fit: absolute and flex items holding just a padded span
    let rare = textWidth(font, bytes("Rare"), false);
    let f1 = Dom.new(mem, css);
    f1.setFrameMs(16.0);
    f1.simInput(-5.0, -5.0, false, 0.0);
    frame(&f1, 8, "", "");
    frame(&f1, 8, "", "");
    near(f1.nodes.items[ITEMS[2]].w, rare + 14.0, 0.6, "absolute (shrink-to-fit) width: text + both edges");
    let f2 = Dom.new(mem, css);
    f2.setFrameMs(16.0);
    f2.simInput(-5.0, -5.0, false, 0.0);
    frame(&f2, 9, "fl", "");
    frame(&f2, 9, "fl", "");
    near(f2.nodes.items[ITEMS[2]].w, rare + 14.0, 0.6, "flex item width: text + both edges");
    let f3 = Dom.new(mem, css);
    f3.setFrameMs(16.0);
    f3.simInput(-5.0, -5.0, false, 0.0);
    frame(&f3, 9, "fl30", "");
    frame(&f3, 9, "fl30", "");
    near(f3.nodes.items[ITEMS[2]].w, rare + 14.0, 0.6, "min-content of a flex item holds the word and both edges");
    // out-of-block hit: the pill's top sticks out above its own block
    let g = Dom.new(mem, css);
    g.setFrameMs(16.0);
    g.simInput(-5.0, -5.0, false, 0.0);
    frame(&g, 7, "", "");
    frame(&g, 7, "", "");
    let gb = boxN(&g, ITEMS[0], 0);
    let top = g.absY(ITEMS[0]) + gb.y;
    ok(top < g.absY(ITEMS[0]) - 1.0, "the box starts above its block");
    g.simInput(g.absX(ITEMS[0]) + gb.x + 3.0, top + 1.0, false, 0.0);
    frame(&g, 7, "", "");
    frame(&g, 7, "", "");
    ok(g.hover == ITEMS[1], "a pill is hit where it sticks out of its block");
}

fn testNested(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 2, "", "");
    frame(&d, 2, "", "");
    let c = ITEMS[0];
    ok(nbox(&d, c) == 2, "two nested boxes");
    let o = boxN(&d, c, 0);
    let i = boxN(&d, c, 1);
    ok(o.node == ITEMS[1] && i.node == ITEMS[2], "the outer box comes first (painted under the inner)");
    near(i.x, o.x + 4.0, 0.01, "inner starts after the outer padding");
    near(o.w, i.w + 8.0, 0.01, "outer is the inner plus its own padding");
    near(i.w, fragN(&d, c, 0).w + 6.0, 0.01, "inner is the text plus its padding");
    d.simInput(i.x + 1.0, i.y + 5.0, false, 0.0);
    frame(&d, 2, "", "");
    frame(&d, 2, "", "");
    ok(d.hover == ITEMS[2], "the innermost box takes the pointer");
    d.simInput(o.x + 1.0, o.y + 5.0, false, 0.0);
    frame(&d, 2, "", "");
    frame(&d, 2, "", "");
    ok(d.hover == ITEMS[1], "the outer padding hovers the outer span");
}

fn testPseudo(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 3, "", "");
    frame(&d, 3, "", "");
    let c = ITEMS[0];
    ok(nbox(&d, c) == 1, "the ::before pill is a box");
    let b = boxN(&d, c, 0);
    ok(d.nodes.items[b.node].pe == 1, "it belongs to the ::before node");
    ok(b.w > 4.0 && b.start == 1 && b.end == 1, "pill is the bracket plus 2 x 2px padding");
    d.simInput(b.x + 1.0, b.y + 5.0, false, 0.0);
    frame(&d, 3, "", "");
    frame(&d, 3, "", "");
    ok(d.hover == ITEMS[1], "the pill answers for its host span");
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, 3, "", "");
    frame(&d, 3, "", "");
    let l0 = d.laid;
    let s0 = d.restyled;
    let n0 = d.nodes.len;
    let bx0 = d.boxes.len;
    for i in 0..30 { frame(&d, 3, "", ""); }
    ok(d.laid == l0 && d.restyled == s0 && d.nodes.len == n0 && d.boxes.len == bx0, "steady pill frames cost nothing");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);
    let font = loadFont(css.fonts.items[0].path, 16);
    testSingle(&mem, &css, font);
    testWrap(&mem, &css, font);
    testEdges(&mem, &css, font);
    testNested(&mem, &css);
    testPseudo(&mem, &css);
    printLn(`inline_test: {CHECKS} checks passed`);
}
