// Tests for j3.ui.ansi.AnsiLog: colors, attributes, split feeds, dropped escapes, CR overwrite.
//   timeout 120 j3c run j3c/stdlib/tests/ui_ansi_test.j3
// Panics on the first failed check. In samples `~` stands for ESC.

module ui_ansi_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;
use j3.ui.ansi.AnsiLog;
use j3.term.paletteRgb;

fn eq(a: string, b: string, msg: string) {
    if !(a == b) {
        printLn(`FAIL: {msg}: want [{b}] got [{a}]`);
        panic(msg);
    }
}

fn ok(c: bool, msg: string) {
    if !c {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn esc(s: string, arena: &Arena): string {
    let t = Text.new(arena);
    for i in 0..s.len {
        if s[i] == 126 {
            t.push(27);
        } else {
            t.push(s[i]);
        }
    }
    return t.str();
}

fn main() {
    let a = Arena.create(1048576);
    let l = AnsiLog.new(0xcccccc, 0x101010, 0);
    l.append(esc("plain ~[1;31mred bold~[0m ok\n~[38;5;196mx~[48;2;1;2;3my~[0m\n", &a));
    eq(`{l.lines.len}`, "3", "lines");
    let s = l.line(0);
    eq(`{s.len}`, "3", "segs line0");
    eq(s[0].text, "plain ", "seg0");
    eq(s[0].fg, "", "inherit fg");
    eq(s[1].text, "red bold", "seg1");
    eq(s[1].fg, "#cd3131", "red");
    eq(s[1].weight, "bold", "bold");
    eq(s[2].text, " ok", "seg2");
    eq(l.line(1)[0].fg, "#ff0000", "256 red");
    eq(l.line(1)[1].bg, "#010203", "rgb bg");
    eq(`{paletteRgb(232)}`, `{0x080808}`, "gray");
    eq(`{paletteRgb(231)}`, `{0xffffff}`, "cube end");

    // split anywhere, plus dropped non-SGR escapes
    let b = AnsiLog.new(0xcccccc, 0x101010, 0);
    b.append(esc("a~[3", &a));
    b.append(esc("1mb~[2K~[1;1H~]0;title~Gc~[7mi~[0m\n", &a));
    eq(`{b.line(0).len}`, "3", "split segs");
    eq(b.line(0)[0].text, "a", "split a");
    eq(b.line(0)[1].text, "bc", "split bc");
    eq(b.line(0)[1].fg, "#cd3131", "split red");
    eq(b.line(0)[2].fg, "#101010", "inverse fg is pane bg");
    eq(b.line(0)[2].bg, "#cd3131", "inverse bg is the old fg");

    // CR overwrite keeps the last frame, CRLF keeps the line, tab pads to 8
    let c = AnsiLog.new(0xcccccc, 0x101010, 0);
    c.append("10%\r50%\r100%\r\nab\tc\n");
    eq(c.line(0)[0].text, "100%", "cr overwrite");
    eq(c.line(1)[0].text, "ab      c", "tab");
    eq(`{c.lines.len}`, "3", "crlf lines");
    // a cap keeps the newest lines and memory bounded: 100k CR progress lines, cap 1000
    let d = AnsiLog.new(0xcccccc, 0x101010, 1000);
    let big = 0;
    for i in 0..100000 {
        let t = Text.new(&a);
        t.pushStr("~[32mprogress ");
        t.pushInt(i);
        t.pushStr(" 10%\r~[32mprogress 50%\rdone ");
        t.pushInt(i);
        t.push(10);
        d.append(esc(t.str(), &a));
        if d.memCap() > big {
            big = d.memCap();
        }
    }
    eq(`{d.count() <= 1001}`, "true", "capped count");
    eq(d.line(d.count() - 2)[0].text, "done 99999", "newest kept");
    eq(d.line(0)[0].text, `done {100000 - (d.count() - 1)}`, "oldest kept");
    ok(big <= 1048576, "arena bounded");
    d.clear();
    eq(`{d.count()}`, "1", "cleared");
    d.append("x\n");
    eq(d.line(0)[0].text, "x", "after clear");
    d.destroy();
    printLn("ui_ansi_test ok");
}
