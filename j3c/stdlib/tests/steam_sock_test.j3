// Tests for j3.steam P2P sockets (ISteamNetworkingSockets): absent no-ops, the fake loopback (listen, connect,
// accept, state callbacks in order, send/receive, poll groups, close, bounded queue), and callbacks 1221 and 1222
// decoded from hand-written buffers for both pack rules.
// Run from j3c/:  timeout 120 target/release/j3c run stdlib/tests/steam_sock_test.j3
// Panics on the first failed check.

module steam_sock_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.steam;
use j3.steam.ConnInfo;
use j3.sys.panic;

#[singleton]
let EV_N: int;
#[singleton]
let EV_CONN: []u32;
#[singleton]
let EV_OLD: []i32;
#[singleton]
let EV_NEW: []i32;
#[singleton]
let EV_LISTEN: []u32;
#[singleton]
let EV_REASON: i32;
#[singleton]
let EV_DBG: string;
#[singleton]
let EV_PEER: u64;
#[singleton]
let AUTH_N: int;
#[singleton]
let AUTH_AVAIL: i32;
#[singleton]
let AUTO_ACCEPT: bool;
#[singleton]
let R_N: int;
#[singleton]
let R_CONN: u32;
#[singleton]
let R_FROM: u64;
#[singleton]
let R_FIRST: u8;
#[singleton]
let R_LEN: int;
#[singleton]
let R_NUM: i64;
#[singleton]
let R_DATA: i64;
#[singleton]
let R_SUM: int;
#[singleton]
let R_NEST: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onConn(conn: u32, old: i32, info: ConnInfo) {
    if EV_N < 64 {
        EV_CONN[EV_N] = conn;
        EV_OLD[EV_N] = old;
        EV_NEW[EV_N] = info.state;
        EV_LISTEN[EV_N] = info.listenSocket;
    }
    EV_N += 1;
    EV_REASON = info.endReason;
    EV_DBG = info.endDebug;
    EV_PEER = info.peer;
    if AUTO_ACCEPT && info.state == steam.NET_STATE_CONNECTING && info.listenSocket != u32(0) {
        steam.acceptConn(conn);
    }
}

fn onAuth(avail: i32, debug: string) {
    AUTH_N += 1;
    AUTH_AVAIL = avail;
}

fn onGot(conn: u32, from: u64, data: []u8, num: i64, cdata: i64, ctx: u64) {
    R_N += 1;
    R_CONN = conn;
    R_FROM = from;
    R_NUM = num;
    R_DATA = cdata;
    R_LEN = data.len;
    R_SUM += data.len;
    if data.len > 0 {
        R_FIRST = data[0];
    }
}

fn onNested(conn: u32, from: u64, data: []u8, num: i64, cdata: i64, ctx: u64) {
    R_N += 1;
    R_NEST += steam.receiveConn(conn, onGot, u64(0), 10);
    R_NEST += steam.receiveGroup(u32(1), onGot, u64(0), 10);
}

fn layouts() {
    let c = "SteamNetConnectionStatusChangedCallback_t";
    ok(steam.layAt(c, "hConn", false) == 0 && steam.layAt(c, "info", false) == 4, "1221 pack4 info");
    ok(steam.layAt(c, "eOldState", false) == 700 && steam.layAt(c, steam.SIZE, false) == 704, "1221 pack4 tail");
    ok(steam.layAt(c, "hConn", true) == 0 && steam.layAt(c, "info", true) == 8, "1221 pack8 info");
    ok(steam.layAt(c, "eOldState", true) == 704 && steam.layAt(c, steam.SIZE, true) == 712, "1221 pack8 tail");
    // the info is followed by the old state with no gap beyond its own 696 bytes
    ok(steam.layAt(c, "eOldState", false) == steam.layAt(c, "info", false) + steam.layAt("SteamNetConnectionInfo_t", steam.SIZE, false), "1221 pack4 adjoins");
    ok(steam.layAt(c, "eOldState", true) == steam.layAt(c, "info", true) + steam.layAt("SteamNetConnectionInfo_t", steam.SIZE, true), "1221 pack8 adjoins");
    for v in 0..2 {
        let big = v == 1;
        let a = "SteamNetAuthenticationStatus_t";
        ok(steam.layAt(a, "eAvail", big) == 0 && steam.layAt(a, "debugMsg", big) == 4 && steam.layAt(a, steam.SIZE, big) == 260, "1222");
        let r = "SteamNetConnectionRealTimeStatus_t";
        ok(steam.layAt(r, "flConnectionQualityLocal", big) == 8 && steam.layAt(r, "flInBytesPerSec", big) == 28, "rt floats");
        ok(steam.layAt(r, "nSendRateBytesPerSecond", big) == 32 && steam.layAt(r, "cbSentUnackedReliable", big) == 44, "rt ints");
        ok(steam.layAt(r, "usecQueueTime", big) == 48 && steam.layAt(r, steam.SIZE, big) == 120, "rt tail");
    }
}

fn zero(b: ptr, n: int) {
    for i in 0..n {
        steam.wrU8(b, i, u8(0));
    }
}

/// 1221 and 1222 written by hand at the offsets the current pack uses, delivered through fakeCallback.
fn callbacks() {
    let mem = Arena.create(8192);
    let size = steam.lay("SteamNetConnectionStatusChangedCallback_t", steam.SIZE);
    let info = steam.lay("SteamNetConnectionStatusChangedCallback_t", "info");
    let b = mem.allocBytes(size);
    zero(b, size);
    steam.wrU32(b, steam.lay("SteamNetConnectionStatusChangedCallback_t", "hConn"), u32(41));
    steam.wrI32(b, info, i32(16));
    steam.wrI32(b, info + 4, i32(8));
    steam.wrU64(b, info + 8, u64(76561197960265800));
    steam.wrU64(b, info + steam.lay("SteamNetConnectionInfo_t", "userData"), u64(9));
    steam.wrU32(b, info + steam.lay("SteamNetConnectionInfo_t", "listenSocket"), u32(3));
    steam.wrI32(b, info + steam.lay("SteamNetConnectionInfo_t", "eState"), steam.NET_STATE_PROBLEM_LOCALLY);
    steam.wrI32(b, info + steam.lay("SteamNetConnectionInfo_t", "eEndReason"), i32(1234));
    steam.wrU8(b, info + steam.lay("SteamNetConnectionInfo_t", "szEndDebug"), u8(113));
    steam.wrI32(b, steam.lay("SteamNetConnectionStatusChangedCallback_t", "eOldState"), steam.NET_STATE_CONNECTED);
    steam.fakeCallback(i32(1221), @slice(b, size));
    let a = mem.allocBytes(260);
    zero(a, 260);
    steam.wrI32(a, 0, steam.RELAY_ATTEMPTING);
    steam.fakeCallback(i32(1222), @slice(a, 260));
    EV_N = 0;
    AUTH_N = 0;
    steam.frame();
    ok(EV_N == 1 && EV_CONN[0] == u32(41) && EV_OLD[0] == steam.NET_STATE_CONNECTED, "1221 head");
    ok(EV_NEW[0] == steam.NET_STATE_PROBLEM_LOCALLY && EV_LISTEN[0] == u32(3) && EV_REASON == i32(1234), "1221 info");
    ok(EV_DBG == "q" && EV_PEER == u64(76561197960265800), "1221 text and peer");
    ok(AUTH_N == 1 && AUTH_AVAIL == steam.RELAY_ATTEMPTING, "1222");
}

fn absent() {
    ok(steam.listenP2P(i32(1)) == u32(0) && !steam.closeListen(u32(1)), "listen absent");
    ok(steam.connectP2P(steam.FAKE_FRIEND, i32(1)) == u32(0), "connect absent");
    ok(steam.acceptConn(u32(1)) == i32(0) && !steam.closeConn(u32(1), i32(1000), "x", false), "accept and close absent");
    ok(!steam.setConnData(u32(1), i64(5)) && steam.connData(u32(1)) == i64(0), "data absent");
    steam.setConnName(u32(1), "n");
    ok(steam.connName(u32(1)) == "", "name absent");
    let s = steam.sendConn(u32(1), [u8(1)], steam.SEND_RELIABLE);
    ok(s.result == i32(0) && s.msgNum == i64(0), "send absent");
    ok(steam.flushConn(u32(1)) == i32(0), "flush absent");
    ok(steam.receiveConn(u32(1), onGot, u64(0), 10) == 0 && steam.receiveGroup(u32(1), onGot, u64(0), 10) == 0, "receive absent");
    ok(steam.pollGroup() == u32(0) && !steam.destroyPollGroup(u32(1)) && !steam.setPollGroup(u32(1), u32(1)), "groups absent");
    ok(steam.connInfo(u32(1)).state == steam.NET_STATE_NONE && steam.connStatus(u32(1)).ping == i32(-1), "info absent");
    ok(steam.myIdentity() == u64(0) && steam.initAuth() == steam.RELAY_UNKNOWN && steam.authStatus().avail == steam.RELAY_UNKNOWN, "identity absent");
}

fn basics() {
    ok(steam.myIdentity() == steam.FAKE_USER, "identity");
    AUTH_N = 0;
    ok(steam.initAuth() == steam.RELAY_CURRENT && steam.authStatus().avail == steam.RELAY_CURRENT && steam.authStatus().debug == "OK", "auth");
    steam.frame();
    ok(AUTH_N == 1 && AUTH_AVAIL == steam.RELAY_CURRENT, "auth callback");
    ok(steam.closeConn(u32(99), i32(1000), "x", false) == false, "unknown close");
    ok(steam.acceptConn(u32(99)) == steam.NET_INVALID_PARAM, "unknown accept");
    ok(steam.connectP2P(u64(0), i32(1)) == u32(0), "connect to 0");
}

fn handshake() {
    let L = steam.listenP2P(i32(7));
    ok(L == u32(1), "first listen socket is 1");
    ok(steam.listenP2P(i32(7)) == u32(0), "port taken");
    EV_N = 0;
    AUTO_ACCEPT = false;
    let c = steam.connectP2P(steam.FAKE_USER, i32(7));
    ok(c == u32(1), "first connection is 1");
    steam.frame();
    // client first (None -> Connecting), then the server end (handle 2) with its listen socket
    ok(EV_N == 2, "two events before accept");
    ok(EV_CONN[0] == c && EV_OLD[0] == steam.NET_STATE_NONE && EV_NEW[0] == steam.NET_STATE_CONNECTING && EV_LISTEN[0] == u32(0), "client connecting");
    let s = EV_CONN[1];
    ok(s == u32(2) && EV_NEW[1] == steam.NET_STATE_CONNECTING && EV_LISTEN[1] == L, "server connecting with listen socket");
    ok(steam.connInfo(c).state == steam.NET_STATE_CONNECTING && steam.connInfo(s).listenSocket == L && steam.connInfo(s).peer == steam.FAKE_USER, "info before accept");
    ok(steam.acceptConn(c) == steam.NET_INVALID_STATE, "client cannot accept");
    ok(steam.acceptConn(s) == steam.NET_OK && steam.acceptConn(s) == steam.NET_INVALID_STATE, "accept once");
    EV_N = 0;
    steam.frame();
    ok(EV_N == 2 && EV_CONN[0] == s && EV_OLD[0] == steam.NET_STATE_CONNECTING && EV_NEW[0] == steam.NET_STATE_CONNECTED, "server connected first");
    ok(EV_CONN[1] == c && EV_NEW[1] == steam.NET_STATE_CONNECTED, "client connected second");
    ok(steam.connStatus(c).state == steam.NET_STATE_CONNECTED && steam.connStatus(c).ping == i32(0) && steam.connStatus(c).qualityLocal == 1.0, "status");
    ok(steam.connStatus(u32(50)).ping == i32(-1), "status unknown");
    // user data and name
    ok(steam.connData(s) == i64(-1) && steam.setConnData(s, i64(77)) && steam.connData(s) == i64(77), "conn data");
    steam.setConnName(s, "player one");
    ok(steam.connName(s) == "player one" && steam.connName(c) == "", "conn name");
    ok(steam.connInfo(s).userData == i64(77), "info user data");
    // the canonical flow: auto accept
    AUTO_ACCEPT = true;
    EV_N = 0;
    let c2 = steam.connectP2P(steam.FAKE_USER, i32(7));
    steam.frame();
    steam.frame();
    ok(c2 == u32(3) && EV_N == 4 && EV_NEW[2] == steam.NET_STATE_CONNECTED && EV_NEW[3] == steam.NET_STATE_CONNECTED, "auto accept reaches connected on both ends");
    ok(steam.closeConn(c2, i32(1000), "", false) && steam.closeConn(u32(4), i32(1000), "", false), "close auto pair");
    AUTO_ACCEPT = false;
    EV_N = 0;
    steam.frame();
}

fn messages() {
    let c = u32(1);
    let s = u32(2);
    R_N = 0;
    let r = steam.sendConn(c, [u8(10), u8(11), u8(12)], steam.SEND_RELIABLE);
    ok(r.result == steam.NET_OK && r.msgNum == i64(1), "send ok");
    let r2 = steam.sendConn(c, [u8(20)], steam.SEND_UNRELIABLE);
    ok(r2.msgNum == i64(2), "message numbers count up");
    ok(steam.receiveConn(c, onGot, u64(0), 10) == 0, "nothing for the sender");
    ok(steam.receiveConn(s, onGot, u64(5), 1) == 1, "max respected");
    ok(R_N == 1 && R_CONN == s && R_FROM == steam.FAKE_USER && R_LEN == 3 && R_FIRST == u8(10) && R_NUM == i64(1) && R_DATA == i64(77), "message fields");
    ok(steam.receiveConn(s, onGot, u64(0), 10) == 1 && R_FIRST == u8(20) && R_NUM == i64(2), "rest");
    ok(steam.receiveConn(s, onGot, u64(0), 10) == 0, "drained");
    // reply goes the other way and carries the client's peer
    steam.sendConn(s, [u8(9)], i32(0));
    ok(steam.receiveConn(c, onGot, u64(0), 10) == 1 && R_CONN == c && R_DATA == i64(-1), "reply");
    // null handler drops
    let nf = (0 as ptr) as fn(u32, u64, []u8, i64, i64, u64);
    steam.sendConn(c, [u8(1)], i32(0));
    steam.sendConn(c, [u8(2)], i32(0));
    ok(steam.receiveConn(s, nf, u64(0), 10) == 2 && steam.receiveConn(s, onGot, u64(0), 10) == 0, "null handler drops");
    // nested receive refused
    steam.sendConn(c, [u8(3)], i32(0));
    R_N = 0;
    R_NEST = 0;
    ok(steam.receiveConn(s, onNested, u64(0), 10) == 1 && R_N == 1 && R_NEST == 0, "nested refused");
    ok(steam.receiveConn(s, onGot, u64(0), 0) == 0, "max 0");
    ok(steam.sendConn(u32(88), [u8(1)], i32(0)).result == steam.NET_INVALID_PARAM, "send unknown");
    ok(steam.flushConn(c) == steam.NET_OK && steam.flushConn(u32(88)) == steam.NET_INVALID_PARAM, "flush");
    let mem = Arena.create(1048576 + 4096);
    let big = mem.alloc::<u8>(steam.NET_MAX_MESSAGE + 1);
    ok(steam.sendConn(c, big, i32(8)).result == steam.NET_LIMIT_EXCEEDED, "over the limit");
    let top: []u8 = @slice(big.ptr as ptr, steam.NET_MAX_MESSAGE);
    ok(steam.sendConn(c, top, i32(8)).result == steam.NET_OK, "exactly the limit");
    ok(steam.receiveConn(s, nf, u64(0), 10) == 1, "limit message arrives");
}

fn groups() {
    let c = u32(1);
    let s = u32(2);
    let g = steam.pollGroup();
    ok(g == u32(1) && steam.pollGroup() == u32(2) && steam.destroyPollGroup(u32(2)) && !steam.destroyPollGroup(u32(2)), "group handles");
    ok(!steam.setPollGroup(s, u32(9)) && !steam.setPollGroup(u32(77), g) && steam.setPollGroup(s, g), "set group");
    steam.sendConn(c, [u8(5), u8(5)], i32(0));
    ok(steam.receiveConn(s, onGot, u64(0), 10) == 0, "grouped conn is read through the group");
    R_N = 0;
    ok(steam.receiveGroup(g, onGot, u64(0), 10) == 1 && R_CONN == s && R_LEN == 2, "group receive");
    // a second connection in the same group
    let c3 = steam.connectP2P(steam.FAKE_USER, i32(7));
    steam.frame();
    ok(steam.acceptConn(u32(6)) == steam.NET_OK, "third pair accepted");
    steam.setPollGroup(u32(6), g);
    steam.sendConn(c3, [u8(7)], i32(0));
    steam.sendConn(c, [u8(8)], i32(0));
    steam.sendConn(c3, [u8(9)], i32(0));
    R_N = 0;
    R_SUM = 0;
    ok(steam.receiveGroup(g, onGot, u64(0), 10) == 3 && R_N == 3 && R_CONN == u32(6) && R_FIRST == u8(9), "group order across connections");
    ok(steam.receiveGroup(g, onGot, u64(0), 10) == 0, "group drained");
    steam.sendConn(c, [u8(1)], i32(0));
    steam.sendConn(c, [u8(1)], i32(0));
    ok(steam.receiveGroup(g, onGot, u64(0), 1) == 1 && steam.receiveGroup(g, onGot, u64(0), 10) == 1, "group max");
    // nested receive refused
    steam.sendConn(c, [u8(1)], i32(0));
    R_N = 0;
    R_NEST = 0;
    ok(steam.receiveGroup(g, onNested, u64(0), 10) == 1 && R_NEST == 0, "group nested refused");
    ok(steam.receiveGroup(u32(0), onGot, u64(0), 10) == 0 && steam.receiveGroup(u32(99), onGot, u64(0), 10) == 0, "group 0 and unknown group read nothing");
    // leaving the group frees the connection for receiveConn
    steam.sendConn(c, [u8(4)], i32(0));
    ok(steam.setPollGroup(s, u32(0)) && steam.receiveGroup(g, onGot, u64(0), 10) == 0 && steam.receiveConn(s, onGot, u64(0), 10) == 1, "leave group");
    // destroying the group keeps the connections
    steam.setPollGroup(s, g);
    steam.sendConn(c, [u8(4)], i32(0));
    ok(steam.destroyPollGroup(g) && steam.receiveConn(s, onGot, u64(0), 10) == 1, "destroy group");
    ok(steam.closeConn(c3, i32(1000), "", false) && steam.closeConn(u32(6), i32(1000), "", false), "close third pair");
    EV_N = 0;
    steam.frame();
}

fn closing() {
    let c = u32(1);
    let s = u32(2);
    steam.sendConn(c, [u8(1)], i32(0));
    EV_N = 0;
    ok(steam.closeConn(c, i32(1500), "bye", true), "close");
    ok(!steam.closeConn(c, i32(1500), "bye", true), "closed handle is dead");
    ok(steam.connInfo(c).state == steam.NET_STATE_NONE, "closed handle unknown");
    steam.frame();
    ok(EV_N == 1 && EV_CONN[0] == s && EV_OLD[0] == steam.NET_STATE_CONNECTED && EV_NEW[0] == steam.NET_STATE_CLOSED_BY_PEER, "peer sees closed by peer");
    ok(EV_REASON == i32(1500) && EV_DBG == "bye" && steam.connInfo(s).endReason == i32(1500), "reason and debug");
    ok(steam.sendConn(s, [u8(1)], i32(0)).result == steam.NET_INVALID_STATE, "no send after close by peer");
    ok(steam.receiveConn(s, onGot, u64(0), 10) == 1, "queued message still readable after close by peer");
    ok(steam.closeConn(s, i32(5), "", false), "close the other end (reason clamped)");
    // listen socket close takes its connections
    EV_N = 0;
    AUTO_ACCEPT = true;
    let c2 = steam.connectP2P(steam.FAKE_USER, i32(7));
    steam.frame();
    steam.frame();
    EV_N = 0;
    ok(steam.closeListen(u32(1)) && !steam.closeListen(u32(1)), "close listen");
    steam.frame();
    ok(EV_N == 1 && EV_CONN[0] == c2 && EV_NEW[0] == steam.NET_STATE_CLOSED_BY_PEER && EV_REASON == steam.CONN_APP_GENERIC, "listen close drops the pair");
    ok(steam.closeConn(c2, i32(1000), "", false), "close client end");
    AUTO_ACCEPT = false;
    // no listener: a connect to yourself times out; to a friend it connects
    EV_N = 0;
    let t = steam.connectP2P(steam.FAKE_USER, i32(7));
    steam.frame();
    ok(EV_N == 2 && EV_NEW[1] == steam.NET_STATE_PROBLEM_LOCALLY && EV_REASON == i32(5003) && steam.connInfo(t).state == steam.NET_STATE_PROBLEM_LOCALLY, "connect to nobody");
    steam.closeConn(t, i32(1000), "", false);
    EV_N = 0;
    let f = steam.connectP2P(steam.FAKE_FRIEND, i32(7));
    steam.frame();
    ok(EV_N == 2 && EV_NEW[0] == steam.NET_STATE_CONNECTING && EV_NEW[1] == steam.NET_STATE_CONNECTED && steam.connInfo(f).peer == steam.FAKE_FRIEND, "friend connects at once");
    ok(steam.sendConn(f, [u8(1)], i32(0)).result == steam.NET_OK && steam.receiveConn(f, onGot, u64(0), 10) == 0, "friend drops sends");
    steam.fakeNetEcho(true);
    R_N = 0;
    steam.sendConn(f, [u8(6)], i32(0));
    ok(steam.receiveConn(f, onGot, u64(0), 10) == 1 && R_FROM == steam.FAKE_FRIEND, "friend echo");
    steam.fakeNetEcho(false);
    ok(steam.closeConn(f, i32(1000), "", false), "close friend conn");
}

fn bounded() {
    steam.listenP2P(i32(8));
    AUTO_ACCEPT = true;
    let c = steam.connectP2P(steam.FAKE_USER, i32(8));
    steam.frame();
    steam.frame();
    AUTO_ACCEPT = false;
    let nf = (0 as ptr) as fn(u32, u64, []u8, i64, i64, u64);
    for i in 0..300 {
        steam.sendConn(c, [u8(i % 256), u8(1)], i32(0));
    }
    R_N = 0;
    let s = c + u32(1);
    ok(steam.receiveConn(s, onGot, u64(0), 1000) == 128 && R_N == 128 && R_FIRST == u8(299 % 256), "queue keeps 128, newest last");
    // closing drops queued messages
    steam.sendConn(c, [u8(1)], i32(0));
    steam.closeConn(s, i32(1000), "", false);
    ok(steam.receiveConn(s, nf, u64(0), 10) == 0, "closed conn has nothing");
    steam.closeConn(c, i32(1000), "", false);
}

fn main() {
    EV_CONN = Arena.create(4096).alloc::<u32>(64);
    EV_OLD = Arena.create(4096).alloc::<i32>(64);
    EV_NEW = Arena.create(4096).alloc::<i32>(64);
    EV_LISTEN = Arena.create(4096).alloc::<u32>(64);
    layouts();
    steam.onConnStatus(onConn);
    steam.onAuthStatus(onAuth);
    absent();
    ok(steam.initFake(u32(480)) == steam.Status.Fake, "fake");
    callbacks();
    basics();
    handshake();
    messages();
    groups();
    closing();
    bounded();
    steam.shutdown();
    ok(steam.connInfo(u32(1)).state == steam.NET_STATE_NONE && steam.receiveConn(u32(2), onGot, u64(0), 10) == 0, "nothing after shutdown");
    steam.initFake(u32(480));
    ok(steam.listenP2P(i32(7)) == u32(1) && steam.connectP2P(steam.FAKE_USER, i32(7)) == u32(1), "handles restart after re-init");
    steam.shutdown();
    printLn("steam_sock_test ok");
}
