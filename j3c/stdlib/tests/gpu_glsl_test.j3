// Driver test for the shader language (`j3c doc shaders`): the two toy programs below are compiled and linked by
// a real GL driver, once as GLSL 3.30 core and once as ES 3.0 (`J3_GLES=1`, the text `glsl.prep` makes). Run from the
// repo root, headless (mesa llvmpipe is enough):
//   __GL_SHADER_DISK_CACHE=0 SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/gpu_glsl_test.j3 --headless
//   J3_GLES=1 __GL_SHADER_DISK_CACHE=0 SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/gpu_glsl_test.j3 --headless
// Prints `gpu_glsl_test ok` on success and panics with the driver log otherwise. Without a GL context it cannot start
// (the `cargo test` wrapper `shaders_compile_on_a_gl_driver` reports that as skipped, never as a pass).
// The text above the MAIN marker line is also the source of the goldens in `src/compile/tests/glsl/`.

module gpu_glsl_test;

use j3.gpu.{ Source, attrib };
use j3.io.printLn;
use j3.math.{ Mat4, Vec2, Vec3 };
use j3.game;
use j3.sys.panic;
use j3.text.cstr;

#[vertex] struct Quad { q: Vec2; }
#[vertex(instance)] struct Inst { rect: vec4f; k: Vec2; _pad: Vec2; }

#[varying] struct V { position: vec4; uv: vec2; #[flat] rect: vec4; }

#[uniform] let uScreen: vec2;
#[uniform] let uTex: sampler2D;
#[uniform] let uTint: vec4;

const KERNEL: [3]f32 = [0.25, 0.5, 0.25];

#[shader]
fn unusedHelper(x: f32): f32 { return x; }

#[shader]
fn shade(input: vec4, sample: f32): vec4 {
    let mix = input;
    mix.rgb = mix.rgb * sample * uTint.rgb;
    return mix;
}

#[shader(vertex)]
fn vs(q: Quad, i: Inst): V {
    let p = i.rect.xy + q.q * i.rect.zw;
    let ndc = p / uScreen * 2.0 - 1.0;
    return V { position: vec4(ndc.x, -ndc.y, 0.0, 1.0), uv: q.q, rect: i.rect };
}

#[shader(fragment)]
fn fs(v: V): vec4 {
    let c = @texture(uTex, v.uv);
    let a = 0.0;
    for k in 0..3 {
        a += KERNEL[k] * c.a;
    }
    if a < 0.01 { @discard(); }
    return shade(c, a);
}

#[shader(vertex)]
fn vsFull(): V {
    let id = @vertexId();
    let p = vec2(f32((id << 1) & 2), f32(id & 2));
    return V { position: vec4(p * 2.0 - 1.0, 0.0, 1.0), uv: p, rect: vec4(0.0) };
}

#[shader(fragment)]
fn fsKinds(v: V): vec4 {
    let kind = i32(v.rect.x);
    let c = vec4(0.0);
    match kind {
        0 { c = vec4(v.uv, 0.0, 1.0); }
        1 { c = vec4(1.0); }
        _ { c = vec4(@mix(vec3(0.0), vec3(1.0), 0.5), 1.0); }
    }
    return c;
}

const PROG: Source = @shader(vs, fs);
const FULL: Source = @shader(vsFull, fsKinds);

// A third program with the rest of the subset: a matrix attribute, an integer varying, a plain struct, an `inout`
// parameter, a uniform array, `while`, `if` as a value, u32 bits, `texelFetch`.
#[vertex] struct Mesh { pos: Vec3; uv: Vec2; id: u32; }
#[vertex(instance)] struct Model { m: Mat4; tint: vec4f; }
#[varying] struct KV { position: vec4; uv: vec2; id: u32; n: vec3; }
#[shader] struct Light { dir: vec3; power: f32; }

#[uniform] let uViewProj: mat4;
#[uniform] let uLights: [2]vec4;
#[uniform] let uImg: sampler2D;

const PI = 3.14159;
const TAU: f32 = 6.28318;

#[shader]
fn bump(x: &f32, by: f32) {
    x += by;
}

#[shader]
fn lighting(l: Light, n: vec3): f32 {
    return @max(@dot(n, @normalize(l.dir)), 0.0) * l.power;
}

#[shader(vertex)]
fn kvs(m: Mesh, i: Model): KV {
    let w = i.m * vec4(m.pos, 1.0);
    return KV { position: uViewProj * w, uv: m.uv, id: m.id, n: w.xyz };
}

#[shader(fragment)]
fn kfs(v: KV): vec4 {
    let lights: [2]vec4 = [uLights[0], uLights[1]];
    let acc = 0.0;
    let i = 0;
    while i < 2 {
        let l = Light { dir: lights[i].xyz, power: lights[i].w };
        bump(&acc, lighting(l, @normalize(v.n)));
        i += 1;
    }
    let size = @textureSize(uImg, 0);
    let t = @texelFetch(uImg, ivec2(i32(v.id & 3), 0), 0);
    let k = if v.id > 2 { 1.0 } else { acc };
    let flag = (v.id & 1) == 1 && acc > 0.1;
    let shade = if flag { TAU / PI } else { 1.0 };
    return vec4(t.rgb * shade * k, f32(size.x) / 256.0);
}

const KITCHEN: Source = @shader(kvs, kfs);

// Names GLSL reserves, used as param, field and fn names: `main()` must not use them as locals.
#[vertex] struct A { p: Vec2; }
#[varying] struct W { position: vec4; mix: vec2; }

#[shader(vertex)]
fn vq(input: A, r: A): W {
    return W { position: vec4(input.p + r.p, 0.0, 1.0), mix: r.p };
}

#[shader(fragment)]
fn fq(output: W): vec4 {
    return vec4(output.mix, 0.0, 1.0);
}

const QUIRKS: Source = @shader(vq, fq);

//MAIN
#[singleton]
let LOG: [4096]u8;

/// Compile one stage; the driver's log is printed when it refuses.
fn stage(what: string, kind: u32, src: string): u32 {
    let mk = game.glProc("glCreateShader") as fn(u32): u32;
    let sh = mk(kind);
    let source = game.glProc("glShaderSource") as fn(u32, i32, ptr, ptr);
    let full = game.prepGl(src);
    let p = full.ptr as ptr;
    let n = i32(full.len);
    source(sh, 1, &p as ptr, &n as ptr);
    let comp = game.glProc("glCompileShader") as fn(u32);
    comp(sh);
    let status = game.glProc("glGetShaderiv") as fn(u32, u32, ptr);
    let ok: i32 = 0;
    status(sh, 0x8B81, &ok as ptr);
    if ok == 0 {
        let log = game.glProc("glGetShaderInfoLog") as fn(u32, i32, ptr, ptr);
        let len: i32 = 0;
        log(sh, 4095, &len as ptr, &LOG[0] as ptr);
        printLn(`{what} did not compile:`);
        printLn([]u8 { ptr: &LOG[0], len: int(len) } as string);
        return 0;
    }
    return sh;
}

/// Compile, link and look up every uniform the program names.
fn check(name: string, s: &Source): bool {
    let vs = stage(`{name} vertex`, 0x8B31, s.vert);
    let fs = stage(`{name} fragment`, 0x8B30, s.frag);
    if vs == 0 || fs == 0 { return false; }
    let mk = game.glProc("glCreateProgram") as fn(): u32;
    let prog = mk();
    let attach = game.glProc("glAttachShader") as fn(u32, u32);
    attach(prog, vs);
    attach(prog, fs);
    let linkFn = game.glProc("glLinkProgram") as fn(u32);
    linkFn(prog);
    let status = game.glProc("glGetProgramiv") as fn(u32, u32, ptr);
    let ok: i32 = 0;
    status(prog, 0x8B82, &ok as ptr);
    if ok == 0 {
        let log = game.glProc("glGetProgramInfoLog") as fn(u32, i32, ptr, ptr);
        let len: i32 = 0;
        log(prog, 4095, &len as ptr, &LOG[0] as ptr);
        printLn(`{name} did not link:`);
        printLn([]u8 { ptr: &LOG[0], len: int(len) } as string);
        return false;
    }
    // every name in `uniforms` is bound by name, as the CPU does it
    let loc = game.glProc("glGetUniformLocation") as fn(u32, ptr): i32;
    let start = 0;
    for i in 0..=s.uniforms.len {
        if i == s.uniforms.len || s.uniforms[i] == 32 {
            let u = s.uniforms[start..i] as string;
            if u.len > 0 && loc(prog, cstr(u) as ptr) < 0 {
                printLn(`{name}: uniform {u} has no location`);
                return false;
            }
            start = i + 1;
        }
    }
    printLn(`{name} ok ({s.count} attributes)`);
    return true;
}

fn main() {
    game.initGlHidden("gpu_glsl_test", 64, 64);
    let a = check("PROG", &PROG);
    let b = check("FULL", &FULL);
    let c = check("KITCHEN", &KITCHEN);
    let d = check("QUIRKS", &QUIRKS);
    if !a || !b || !c || !d { panic("gpu_glsl_test FAILED"); }
    printLn(`gpu_glsl_test ok es={game.isGles()}`);
}
