// Tests for List.remove and List.swapRemove.
//   timeout 60 j3c run j3c/stdlib/tests/list_test.j3
// Panics on the first failed check.

module list_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.sys.panic;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("list_test");
    }
}

fn main() {
    let mem = Arena.create(4096);
    let xs = List<int>.new(&mem);
    for i in 0..5 { xs.push(i * 10); }
    xs.remove(1);
    ok(xs.len == 4 && xs.items[0] == 0 && xs.items[1] == 20 && xs.items[3] == 40, "remove keeps order");
    xs.swapRemove(0);
    ok(xs.len == 3 && xs.items[0] == 40 && xs.items[1] == 20, "swapRemove moves last");
    xs.remove(2);
    ok(xs.len == 2 && xs.items[1] == 20, "remove last");
    xs.remove(5);
    xs.swapRemove(-1);
    ok(xs.len == 2, "out of range is a no-op");
    xs.swapRemove(1);
    xs.swapRemove(0);
    ok(xs.len == 0, "empty");
    printLn("list_test ok");
}
