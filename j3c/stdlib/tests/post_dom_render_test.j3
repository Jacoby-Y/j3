// Retained DOM post effects integration. No visible window:
// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_STDLIB=$PWD/j3c/stdlib timeout 60 j3c run j3c/stdlib/tests/post_dom_render_test.j3
module post_dom_render_test;

use lib "GL" as gl { fn glGetError(): u32; }
use j3.game;
use j3.game.Color;
use j3.gfx.paint;
use j3.gfx.canvas.{ Canvas, Mode, rgba };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, K_ELEM };
use j3.ui.media;

#[singleton]
let CHECKS: int;

const W: int = 480;
const H: int = 320;

const SHEET: string = ".stage { display: block; position: relative; width: 480px; height: 320px; } .host { display: block; position: relative; width: 480px; height: 320px; } .group { position: absolute; left: 40px; top: 40px; width: 140px; height: 80px; background: #ff0000; } .child { position: absolute; left: 40px; top: 20px; width: 80px; height: 40px; background: #0000ff; } .neutral { filter: brightness(1); } .half { opacity: .5; } .masked { mask-image: linear-gradient(90deg, #ffffff80, #ffffff80); } .rotated { transform: rotate(17deg); } .cliphost { position: absolute; left: 220px; top: 20px; width: 100px; height: 100px; overflow: hidden; } .oversize { left: 20px; top: 10px; width: 150px; height: 80px; filter: blur(8px); } .glass { background: transparent; backdrop-filter: blur(8px); } .gray { filter: grayscale(1); } .upper { z-index: 2; } .ownclip { overflow: hidden; filter: blur(8px); } .projected { rotate-y: 60deg; } .projective { perspective: 600px; } .gradmask { mask-image: linear-gradient(90deg, #ffffff00 0%, #ffffff00 40%, #ffffffff 60%, #ffffffff 100%); } .shaped { clip-path: circle(30px at 50% 50%); }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond { printLn(`FAIL: {msg}`); panic(msg); }
}

fn near(v: int, expected: int, tolerance: int, msg: string) {
    CHECKS += 1;
    let diff = v - expected;
    if diff < 0 { diff = 0 - diff; }
    if diff > tolerance {
        printLn(`FAIL: {msg}: {v}, expected {expected}`);
        panic(msg);
    }
}

fn channel(p: []u8, x: int, y: int, c: int): int { return int(p[(y * W + x) * 4 + c]); }

fn stripes() {
    for i in 0..W / 4 {
        paint.rect(Vec2 { x: f32(i * 4), y: 0.0 }, Vec2 { x: 4.0, y: f32(H) }, Color { r: if i % 2 == 0 { 0 } else { 255 }, g: 0, b: 0, a: 255 });
    }
}

fn frame(d: &Dom, mode: int, pixels: []u8) {
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    if mode == 6 || mode == 7 { stripes(); }
    d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
    let stage = d.open(0, d.tag("div"), 1);
    d.cls(stage, "stage");
    let host = d.open(0, d.tag("div"), 1);
    d.cls(host, "host");
    d.clsIf(host, "masked", mode == 1 || mode == 14);
    d.clsIf(host, "cliphost", mode == 5);
    let group = d.open(0, d.tag("div"), 1);
    d.cls(group, "group");
    d.clsIf(group, "neutral", mode == 0 || mode == 1 || mode == 2 || mode == 4 || mode == 6 || mode == 9);
    d.clsIf(group, "half", mode == 0 || mode == 2 || mode == 11 || mode == 14);
    d.clsIf(group, "rotated", mode == 3 || mode == 4);
    d.clsIf(group, "oversize", mode == 5);
    d.clsIf(group, "glass", mode == 6 || mode == 7);
    d.clsIf(group, "gray", mode == 8);
    d.clsIf(group, "masked", mode == 9 || mode == 12 || mode == 14);
    d.clsIf(group, "ownclip", mode == 10);
    d.clsIf(group, "projected", mode >= 11);
    d.clsIf(group, "projective", mode == 14);
    d.clsIf(group, "gradmask", mode == 11);
    d.clsIf(group, "shaped", mode == 13);
    if mode != 6 && mode != 7 {
        let child = d.open(0, d.tag("div"), 1);
        d.cls(child, "child");
        d.clsIf(child, "neutral", mode == 2);
        d.clsIf(child, "half", mode == 2);
        d.clsIf(child, "upper", mode == 8);
        d.close();
    }
    d.close();
    d.close();
    d.close();
    d.layout();
    d.paintAll();
    d.endFrame();
    ok(game.readWindow(pixels), "read retained DOM output");
    let error = gl.glGetError();
    if error != 0 { printLn(`mode {mode}: GL error {error}`); }
    ok(error == 0, "retained DOM paint has no GL error");
}

fn equal(a: []u8, b: []u8, tolerance: int, msg: string) {
    let worst = 0;
    let bad = 0;
    for i in 0..a.len {
        let diff = int(a[i]) - int(b[i]);
        if diff < 0 { diff = 0 - diff; }
        if diff > worst { worst = diff; }
        if diff > tolerance { bad += 1; }
    }
    if bad > 0 { printLn(`{msg}: {bad} channels differ, worst={worst}`); }
    ok(bad == 0, msg);
}

// Layout and all paint paths must resolve percentage edges against the containing width.
fn testSizing(mem: &Arena, pixels: []u8, reference: []u8) {
    let image = Canvas.create(mem, 100, 50, Mode.Pixel);
    image.clear(rgba(0, 0, 255, 255));
    match image.savePng("/tmp/j3-sizing-media.png", mem) {
        Result.Ok(_) {}
        Result.Err(_) { panic("save sizing image fixture"); }
    }
    let css = Css.new(mem);
    parse(&css, ".host { width: 400px; } svg, img { width: 200px; max-width: 100px; background: #ff0000; border: 4px solid #00ff00; }", "sizing.css", 0);
    ok(css.warns.len == 0, "media sizing sheet parses");
    let d = Dom.new(mem, &css);
    d.simInput(-10.0, -10.0, false, 0.0);
    for kind in 0..2 {
        for box in 0..2 {
            for px in 0..2 {
                game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
                d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
                let host = d.open(0, d.tag("div"), 1); d.cls(host, "host");
                let id = d.open(0, d.tag(if kind == 0 { "svg" } else { "img" }), 1);
                d.styleStr(id, 0, "box-sizing", if box == 0 { "border-box" } else { "content-box" });
                d.styleStr(id, 1, "padding", if px == 0 { "10%" } else { "40px" });
                d.styleStr(id, 2, "border-width", if px == 0 { "1%" } else { "4px" });
                if kind == 0 {
                    d.attrMedia(id, media.M_VIEWBOX, "0 0 100 50");
                    let path = d.open(0, d.tag("path"), 1);
                    d.attrMedia(path, media.M_D, "M0 0H100V50H0Z");
                    d.attrMedia(path, media.M_FILL, "#0000ff");
                    d.close();
                } else { d.attrMedia(id, media.M_SRC, "/tmp/j3-sizing-media.png"); }
                d.close(); d.close(); d.layout();
                let n = &d.nodes.items[id];
                ok(n.basisW == 400.0, "clamped media retains containing width");
                ok(n.w == if box == 0 { 100.0 } else { 188.0 }, "media width obeys box sizing and max");
                ok(n.h == if box == 0 { 94.0 } else { 138.0 }, "media height uses the same padding and border basis");
                d.paintAll();
                d.endFrame();
                ok(game.readWindow(pixels), "read media sizing output");
                near(channel(pixels, 20, 30, 0), 255, 0, "media keeps red padding under a width clamp");
                near(channel(pixels, 20, 30, 2), 0, 0, "media does not draw into padding");
                near(channel(pixels, 50, 45, 2), 255, 0, "media content remains blue");
                near(channel(pixels, 2, 20, 1), 255, 0, "paint border matches layout percentage border");
                if px == 0 { for i in 0..pixels.len { reference[i] = pixels[i]; } }
                else { equal(reference, pixels, 0, "percentage media edges paint identically to equivalent px"); }
            }
        }
    }
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    game.initGlHidden("retained post effects checks", W, H);
    let css = Css.new(&mem);
    parse(&css, SHEET, "post-dom.css", 1);
    ok(css.warns.len == 0, "retained fixture CSS parses");
    let d = Dom.new(&mem, &css);
    d.simInput(-10.0, -10.0, false, 0.0);
    d.setFrameMs(16.0);
    let pixels = mem.alloc::<u8>(W * H * 4);
    let reference = mem.alloc::<u8>(W * H * 4);
    frame(&d, 0, pixels);
    near(channel(pixels, 50, 50, 0), 128, 2, "group opacity applies once to parent fill");
    near(channel(pixels, 100, 80, 0), 0, 2, "opaque child replaces parent inside group");
    near(channel(pixels, 100, 80, 2), 128, 2, "group opacity applies once to child");
    frame(&d, 1, pixels);
    near(channel(pixels, 50, 50, 0), 128, 2, "ancestor mask applied once to group");
    near(channel(pixels, 100, 80, 2), 128, 2, "ancestor mask applied once over child");
    frame(&d, 9, pixels);
    near(channel(pixels, 50, 50, 0), 128, 2, "own mask applied once to group");
    near(channel(pixels, 100, 80, 2), 128, 2, "own mask applied once over child");
    frame(&d, 2, pixels);
    near(channel(pixels, 100, 80, 0), 64, 3, "nested group preserves red through half-opacity blue");
    near(channel(pixels, 100, 80, 2), 64, 3, "nested group alpha multiplies once per group");
    frame(&d, 3, reference);
    frame(&d, 4, pixels);
    equal(reference, pixels, 2, "neutral group preserves transformed content coordinates");
    frame(&d, 5, pixels);
    near(channel(pixels, 321, 60, 0), 0, 0, "blur cannot escape ancestor right clip");
    near(channel(pixels, 260, 19, 0), 0, 0, "blur cannot escape ancestor top clip");
    ok(channel(pixels, 260, 55, 0) > 100, "clipped blur has visible content");
    frame(&d, 10, pixels);
    ok(channel(pixels, 36, 80, 0) > 5, "own overflow clips captured children, then blur may spread outside the box");
    near(channel(pixels, 5, 80, 0), 0, 0, "own overflow blur spill remains local");
    frame(&d, 8, pixels);
    near(channel(pixels, 50, 50, 0), channel(pixels, 50, 50, 1), 2, "parent grayscale group is painted in its layer");
    near(channel(pixels, 100, 80, 2), 18, 2, "higher z child is inside its parent's group: grayscale turns blue dark gray");
    near(channel(pixels, 100, 80, 0), 18, 2, "higher z child color goes through the parent's filter");
    frame(&d, 7, reference);
    frame(&d, 6, pixels);
    equal(reference, pixels, 2, "backdrop blur survives neutral content group");
    frame(&d, 11, pixels);
    near(channel(pixels, 100, 80, 2), 0, 2, "gradient transparent region projects with own texture");
    near(channel(pixels, 127, 80, 2), 128, 3, "gradient opaque region projects with own texture and group opacity");
    near(channel(pixels, 127, 80, 0), 0, 2, "projected mask covers opaque child once over parent fill");
    frame(&d, 12, pixels);
    near(channel(pixels, 110, 80, 2), 128, 3, "projected constant mask applies once over overlapping content");
    near(channel(pixels, 110, 80, 0), 0, 2, "projected masked child replaces parent fill");
    frame(&d, 13, pixels);
    near(channel(pixels, 90, 80, 0), 0, 2, "own clip-path contracts with projected plane");
    near(channel(pixels, 100, 80, 2), 255, 3, "own clip-path preserves projected interior");
    frame(&d, 14, pixels);
    near(channel(pixels, 110, 80, 2), 32, 3, "perspective own mask, ancestor mask and group alpha each apply once");
    near(channel(pixels, 110, 80, 0), 0, 2, "perspective masked overlapping content stays atomic");
    let capture = Canvas.create(&mem, i32(W), i32(H), Mode.Pixel);
    for i in 0..pixels.len { capture.pixels[i] = pixels[i]; }
    match capture.savePng("/tmp/j3-post-dom.png", &mem) {
        Result.Ok(_) {}
        Result.Err(_) { panic("save retained DOM capture"); }
    }
    testSizing(&mem, pixels, reference);
    game.destroy();
    mem.destroy();
    printLn(`post_dom_render_test ok, checks passed: {CHECKS}`);
}
