// Rotated `overflow` clips (plan 027 chunk 1): a turned box clips to its real shape (paint and hit testing agree), a turned clip
// inside a differently turned one intersects with it, `overflow-x` alone on a turned box cuts only the two turned side edges, and more
// than four nested turned clips fall back to bounding boxes without crashing. Needs GL, no visible window:
// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/clipshape_test.j3 --headless
module clipshape_test;

use j3.game;
use j3.game.Color;
use j3.gfx.paint;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CHECKS: int;

#[singleton]
let KIDS: [5]int;

const W: int = 600;
const H: int = 400;

/// Scenario cells centered at (100, 100), (300, 100), (500, 100); every box is 100x100 and turns about its center. `.k` is the red
/// content, bigger than any box; the box itself paints nothing, so black means clipped.
const SHEET: string = ".stage { display: block; width: 600px; height: 400px; } .o { position: absolute; top: 50px; width: 100px; height: 100px; overflow: hidden; transform: rotate(45deg); } .a { left: 50px; } .b { left: 250px; } .c { left: 450px; overflow-x: clip; overflow-y: visible; } .d { left: 50px; top: 250px; } .d2 { width: 100px; height: 100px; overflow: hidden; transform: rotate(-30deg); } .d3 { width: 60px; height: 60px; margin: 20px; overflow: hidden; transform: rotate(20deg); } .z { position: absolute; left: -100px; top: -100px; width: 300px; height: 300px; z-index: 1; background: #ff0000; } .kc { width: 20px; height: 8px; margin: 1px; background: #00ff00; } .in { width: 100px; height: 100px; overflow: hidden; transform: rotate(-30deg); } .k { width: 300px; height: 300px; background: #ff0000; }";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn box(d: &Dom, slot: int, cls: string): int {
    let id = d.open(slot, d.tag("div"), 1);
    d.clsDyn(id, cls);
    return id;
}

fn build(d: &Dom) {
    box(d, 0, "stage");
    // a: one 45 degree box
    box(d, 0, "o a");
    KIDS[0] = box(d, 0, "k");
    d.close();
    d.close();
    // b: a box turned 45 degrees holding one turned -30 (net 15)
    box(d, 1, "o b");
    box(d, 0, "in");
    KIDS[1] = box(d, 0, "k");
    d.close();
    d.close();
    d.close();
    // c: x-only clip
    box(d, 2, "o c");
    KIDS[2] = box(d, 0, "k");
    d.close();
    d.close();
    // d: three turned clips (net 45, 15, 35 degrees) around a z-indexed child, painted as an entry of the innermost context
    box(d, 3, "o d");
    box(d, 0, "d2");
    box(d, 0, "d3");
    KIDS[3] = box(d, 0, "z");
    d.close();
    d.close();
    d.close();
    d.close();
    d.close();
}

fn frame(d: &Dom, px: f32, py: f32, pixels: []u8) {
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    d.simInput(px, py, false, 0.0);
    d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
    build(d);
    d.layout();
    d.paintAll();
    d.endFrame();
    ok(game.readWindow(pixels), "read the frame");
}

/// The pointer at `(x, y)` (two frames: the hit test reads the last layout): the pixel is red or black, and the red content is hit or not.
fn at(d: &Dom, pixels: []u8, x: int, y: int, red: bool, kid: int, msg: string) {
    frame(d, f32(x), f32(y), pixels);
    frame(d, f32(x), f32(y), pixels);
    let i = (y * W + x) * 4;
    let r = int(pixels[i]);
    ok(if red { r > 250 } else { r < 5 }, `paint: {msg} (red {r})`);
    ok((d.hover == KIDS[kid]) == red, `hit: {msg}`);
}

/// A `<canvas>` body is `pushView` + `pushIdentity`: the turned clip around it stays in place on screen.
fn testCanvas(pixels: []u8) {
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    // a 100 px square turned 45 degrees about (100, 100), clipped, then a view at (60, 40) drawing a red rect over all of it
    paint.pushXform(Vec2 { x: 100.0, y: 100.0 }, Vec2 { x: 0.0, y: 0.0 }, 0.785398, 1.0);
    paint.pushClip(Vec2 { x: 50.0, y: 50.0 }, Vec2 { x: 100.0, y: 100.0 });
    paint.pushView(Vec2 { x: 60.0, y: 40.0 }, Vec2 { x: 200.0, y: 200.0 });
    paint.pushIdentity();
    paint.rect(Vec2 { x: 0.0, y: 0.0 }, Vec2 { x: 200.0, y: 200.0 }, Color { r: 255, g: 0, b: 0, a: 255 });
    paint.popTransform();
    paint.popView();
    paint.popClip();
    paint.popTransform();
    paint.flush();
    ok(game.readWindow(pixels), "read the canvas frame");
    let c = (100 * W + 100) * 4;
    ok(pixels[c] > 250, "canvas content shows in the middle of the turned clip");
    let k = (150 * W + 150) * 4;
    ok(pixels[k] < 5, "canvas content does not leak into the corner of the bounding box");
    let e = (100 * W + 165) * 4;
    ok(pixels[e] > 250, "canvas content shows inside the diamond near its tip");
}

fn micros(): int {
    return game.micros();
}

/// Cost of repainting a turned overflow box with 300 children, for the report.
fn bench(d: &Dom, pixels: []u8) {
    let t0 = micros();
    for i in 0..60 {
        game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
        d.simInput(-5.0, -5.0, false, 0.0);
        d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
        box(d, 0, "stage");
        box(d, 0, "o a");
        for j in 0..300 {
            box(d, j, "kc");
            d.close();
        }
        d.close();
        d.close();
        d.layout();
        d.paintAll();
        d.endFrame();
    }
    game.readWindow(pixels);
    printLn(`turned overflow box, 300 children: {(micros() - t0) / 60} us per frame`);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    game.initGlHidden("clip shapes", W, H);
    let css = Css.new(&mem);
    parse(&css, SHEET, "clipshape.css", 1);
    ok(css.warns.len == 0, "fixture CSS parses");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    let pixels = mem.alloc::<u8>(W * H * 4);
    // a: the diamond |dx| + |dy| <= 70.7 around (100, 100)
    at(&d, pixels, 100, 100, true, 0, "centre of a turned clip shows");
    at(&d, pixels, 150, 100, true, 0, "inside the diamond shows");
    at(&d, pixels, 150, 150, false, 0, "a corner of the bounding box does not leak");
    at(&d, pixels, 55, 145, false, 0, "the opposite corner does not leak either");
    // b: the inner square (net 15 degrees) and the outer diamond both bound the content
    at(&d, pixels, 320, 110, true, 1, "inside both clips shows");
    at(&d, pixels, 332, 156, false, 1, "inside the inner clip but outside the outer one is cut");
    at(&d, pixels, 360, 100, false, 1, "inside the outer clip but outside the inner one is cut");
    // c: overflow-x alone keeps the strip between the two turned side edges
    at(&d, pixels, 500, 100, true, 2, "x-only clip shows its centre");
    at(&d, pixels, 429, 171, true, 2, "x-only clip lets the content past the turned top and bottom edge");
    at(&d, pixels, 571, 171, false, 2, "x-only clip cuts past the turned side edge");
    // d: only the smallest square (60 px, net 35 degrees) shows the child
    at(&d, pixels, 120, 310, true, 3, "inside all three turned clips shows (z-indexed child)");
    at(&d, pixels, 145, 300, false, 3, "inside the two outer clips but outside the inner one is cut (z-indexed child)");
    at(&d, pixels, 100, 380, false, 3, "far outside is cut (z-indexed child)");
    testCanvas(pixels);
    bench(&d, pixels);
    printLn(`clipshape_test ok, checks passed: {CHECKS}`);
}
