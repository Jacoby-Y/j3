// Tests for CSS grid layout (j3.ui.dom grid.j3): explicit and implicit rows, fr and percent rows with a definite or
// unknown height, minmax(), auto-fill / auto-fit counts at several widths and after a resize, auto-fit collapse,
// spans, explicit placement and auto-placement (sparse and dense, row and column flow), gaps across spans,
// spanning items over auto tracks, and a steady frame that lays out nothing.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/gridlayout_test.j3
// Panics on the first failed check.

module gridlayout_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.Text;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CHECKS: int;

fn near(a: f32, b: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff > 0.01 {
        printLn(`FAIL: {msg}: {a} vs {b}`);
        panic(msg);
    }
}

const CSS: string = "* { box-sizing: border-box; margin: 0; padding: 0; } .host { width: 100%; } .i { height: 20px; } .n { margin: 0; }\n.ga { display: grid; width: 300px; grid-template-columns: 100px 100px; grid-template-rows: 30px 50px; gap: 10px 20px; }\n.gb { display: grid; width: 200px; height: 200px; grid-template-rows: 1fr 2fr 20px; row-gap: 10px; }\n.gb2 { display: grid; width: 200px; grid-template-rows: 1fr 2fr 20px; row-gap: 10px; }\n.gc { display: grid; width: 300px; grid-template-columns: minmax(100px, 200px) minmax(50px, 1fr); }\n.gc2 { display: grid; width: 500px; grid-template-columns: minmax(100px, 200px) minmax(50px, 100px); }\n.gc3 { display: grid; width: 120px; grid-template-columns: minmax(100px, 1fr) minmax(0, 1fr); }\n.gd { display: grid; gap: 4px; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); }\n.ge { display: grid; width: 300px; grid-template-columns: repeat(auto-fit, minmax(50px, 1fr)); }\n.ge2 { display: grid; width: 300px; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); }\n.gf { display: grid; width: 300px; grid-template-columns: repeat(3, 100px); gap: 10px; }\n.s2 { grid-column: span 2; } .p { grid-column: 2 / 4; } .r { grid-row: 2; grid-column: 1; }\n.gg { display: grid; width: 300px; grid-template-columns: 100px; grid-auto-columns: 50px; grid-auto-rows: 30px; }\n.c3 { grid-column: 3; }\n.gh { display: grid; width: 300px; grid-template-rows: 20px 20px; grid-auto-flow: column; grid-auto-columns: 60px; }\n.gdn { display: grid; width: 150px; grid-template-columns: repeat(3, 50px); grid-auto-flow: row dense; }\n.gsp { display: grid; width: 150px; grid-template-columns: repeat(3, 50px); }\n.gk { display: grid; width: 400px; grid-template-columns: auto auto; }\n.w150s { width: 150px; grid-column: span 2; } .w40 { width: 40px; } .w30 { width: 30px; }\n.gm { display: grid; width: 100px; height: 200px; grid-template-rows: 25% 1fr; }\n.gm2 { display: grid; width: 100px; grid-template-rows: 25% 1fr; }\n.gbig { display: grid; gap: 4px; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); } .grows { display: grid; }\n.gn { display: grid; width: 300px; grid-template-columns: 100px 100px; grid-template-rows: 30px; }\n.gz { display: grid; width: 0; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); }\n.gs { display: grid; width: 400px; grid-template-columns: 50px 50px; } .w300 { width: 300px; } .s4 { grid-column: span 4; } .c4 { grid-column: 4; }\n.gneg { display: grid; width: 400px; grid-template-columns: 50px 50px; } .neg { grid-column: -5 / -1; }\n.gemp { display: grid; width: 300px; grid-template-columns: repeat(3, 100px); }\n.gsame { display: grid; width: 200px; grid-template-columns: 100px 100px; } .same { grid-column: 1; grid-row: 1; }\n.gfr { display: grid; width: 200px; grid-template-columns: 1fr 1fr; } .w500 { width: 500px; } .s2x { grid-column: span 2; }\n.gma { display: grid; width: 200px; grid-template-columns: minmax(auto, 1fr) 100px; } .w150 { width: 150px; } .w60 { width: 60px; }\n";

fn node(d: &Dom, key: int, cls: string): int {
    let id = d.open(key, d.tag("div"), 1);
    d.clsDyn(id, cls);
    return id;
}

fn leaf(d: &Dom, key: int, cls: string) {
    node(d, key, cls);
    d.close();
}

fn build(d: &Dom, w: f32) {
    d.beginFrame(Vec2 { x: w, y: 600.0 });
    node(d, 0, "host");
    node(d, 0, "ga");
    leaf(d, 0, "n"); leaf(d, 1, "n"); leaf(d, 2, "n"); leaf(d, 3, "n"); leaf(d, 4, "i");
    d.close();
    node(d, 1, "gb");
    leaf(d, 0, "n"); leaf(d, 1, "n"); leaf(d, 2, "n");
    d.close();
    node(d, 2, "gb2");
    leaf(d, 0, "i"); leaf(d, 1, "i"); leaf(d, 2, "i");
    d.close();
    node(d, 3, "gc"); leaf(d, 0, "n"); leaf(d, 1, "n"); d.close();
    node(d, 4, "gc2"); leaf(d, 0, "n"); leaf(d, 1, "n"); d.close();
    node(d, 5, "gc3"); leaf(d, 0, "n"); leaf(d, 1, "n"); d.close();
    node(d, 6, "gd");
    leaf(d, 0, "i"); leaf(d, 1, "i"); leaf(d, 2, "i"); leaf(d, 3, "i"); leaf(d, 4, "i"); leaf(d, 5, "i");
    d.close();
    node(d, 7, "ge"); leaf(d, 0, "i"); leaf(d, 1, "i"); d.close();
    node(d, 8, "ge2"); leaf(d, 0, "i"); leaf(d, 1, "i"); d.close();
    node(d, 9, "gf");
    leaf(d, 0, "i s2"); leaf(d, 1, "i"); leaf(d, 2, "i p"); leaf(d, 3, "i"); leaf(d, 4, "i r");
    d.close();
    node(d, 10, "gg"); leaf(d, 0, "i"); leaf(d, 1, "n c3"); d.close();
    node(d, 11, "gh");
    leaf(d, 0, "n"); leaf(d, 1, "n"); leaf(d, 2, "n"); leaf(d, 3, "n"); leaf(d, 4, "n");
    d.close();
    node(d, 12, "gdn"); leaf(d, 0, "i s2"); leaf(d, 1, "i s2"); leaf(d, 2, "i"); d.close();
    node(d, 13, "gsp"); leaf(d, 0, "i s2"); leaf(d, 1, "i s2"); leaf(d, 2, "i"); d.close();
    node(d, 14, "gk"); leaf(d, 0, "w150s"); leaf(d, 1, "w40"); leaf(d, 2, "w30"); d.close();
    node(d, 15, "gm"); leaf(d, 0, "n"); leaf(d, 1, "n"); d.close();
    node(d, 16, "gm2"); leaf(d, 0, "i"); leaf(d, 1, "i"); d.close();
    node(d, 17, "gn"); leaf(d, 0, "n"); leaf(d, 1, "n"); leaf(d, 2, "n"); d.close();
    node(d, 18, "gz"); leaf(d, 0, "i"); leaf(d, 1, "i"); d.close();
    node(d, 19, "gs"); leaf(d, 0, "w300 s4 i"); leaf(d, 1, "n c4"); d.close();
    node(d, 20, "gneg"); leaf(d, 0, "n neg"); d.close();
    node(d, 21, "gemp"); d.close();
    node(d, 22, "gsame"); leaf(d, 0, "n same"); leaf(d, 1, "n same"); d.close();
    node(d, 23, "gfr"); leaf(d, 0, "w500 s2x i"); leaf(d, 1, "n"); leaf(d, 2, "n"); d.close();
    node(d, 24, "gma"); leaf(d, 0, "w150"); leaf(d, 1, "n"); d.close();
    node(d, 25, "gma"); leaf(d, 0, "w60"); leaf(d, 1, "n"); d.close();
    d.close();
    d.layout();
    d.endFrame();
}

/// The `n`th child of `id`.
fn kid(d: &Dom, id: int, n: int): int {
    let c = d.nodes.items[id].first;
    for q in 0..n {
        c = d.nodes.items[c].next;
    }
    return c;
}

/// The grid `n` of the page (the host's children, in `build` order).
fn grid(d: &Dom, n: int): int {
    return kid(d, d.nodes.items[0].first, n);
}

fn at(d: &Dom, g: int, n: int, x: f32, y: f32, w: f32, h: f32, msg: string) {
    let c = kid(d, g, n);
    let nd = &d.nodes.items[c];
    near(nd.x, x, `{msg}: x`);
    near(nd.y, y, `{msg}: y`);
    near(nd.w, w, `{msg}: w`);
    near(nd.h, h, `{msg}: h`);
}

fn testRows(d: &Dom) {
    let a = grid(d, 0);
    at(d, a, 0, 0.0, 0.0, 100.0, 30.0, "explicit rows: first");
    at(d, a, 1, 120.0, 0.0, 100.0, 30.0, "explicit rows: column gap");
    at(d, a, 2, 0.0, 40.0, 100.0, 50.0, "explicit rows: second row, row gap");
    at(d, a, 3, 120.0, 40.0, 100.0, 50.0, "explicit rows: fourth");
    at(d, a, 4, 0.0, 100.0, 100.0, 20.0, "implicit auto row after the template");
    near(d.nodes.items[a].h, 120.0, "explicit rows: grid height");
    let b = grid(d, 1);
    let third: f32 = 53.33333;
    at(d, b, 0, 0.0, 0.0, 200.0, third, "fr rows with a definite height: 1fr");
    at(d, b, 1, 0.0, third + 10.0, 200.0, third * 2.0, "fr rows with a definite height: 2fr");
    at(d, b, 2, 0.0, 180.0, 200.0, 20.0, "fr rows: fixed last row");
    let b2 = grid(d, 2);
    at(d, b2, 0, 0.0, 0.0, 200.0, 20.0, "fr rows with an unknown height are auto: first");
    at(d, b2, 1, 0.0, 30.0, 200.0, 20.0, "fr rows with an unknown height are auto: second");
    at(d, b2, 2, 0.0, 60.0, 200.0, 20.0, "fixed row");
    near(d.nodes.items[b2].h, 80.0, "unknown height: grid height is the rows plus gaps");
    let m = grid(d, 15);
    at(d, m, 0, 0.0, 0.0, 100.0, 50.0, "percent row of a definite height");
    at(d, m, 1, 0.0, 50.0, 100.0, 150.0, "fr row takes the rest");
    let m2 = grid(d, 16);
    at(d, m2, 0, 0.0, 0.0, 100.0, 20.0, "percent row of an unknown height is auto");
    at(d, m2, 1, 0.0, 20.0, 100.0, 20.0, "fr row of an unknown height is auto");
    let n = grid(d, 17);
    at(d, n, 2, 0.0, 30.0, 100.0, 0.0, "third item wraps to an implicit auto row");
}

fn testMinmax(d: &Dom) {
    let c = grid(d, 3);
    at(d, c, 0, 0.0, 0.0, 200.0, 0.0, "minmax(100px, 200px) grows to its maximum");
    at(d, c, 1, 200.0, 0.0, 100.0, 0.0, "minmax(50px, 1fr) takes the rest");
    let c2 = grid(d, 4);
    at(d, c2, 0, 0.0, 0.0, 200.0, 0.0, "minmax stops at its maximum");
    at(d, c2, 1, 200.0, 0.0, 100.0, 0.0, "second minmax stops at its maximum");
    let c3 = grid(d, 5);
    at(d, c3, 0, 0.0, 0.0, 100.0, 0.0, "minmax(100px, 1fr) is not squeezed below 100px");
    at(d, c3, 1, 100.0, 0.0, 20.0, 0.0, "the other fr gets what is left");
}

fn testFill(d: &Dom, w: f32, n: int, msg: string) {
    let g = grid(d, 6);
    let tw = (w - 4.0 * f32(n - 1)) / f32(n);
    if w < 68.0 {
        tw = 64.0;
    }
    let nd = &d.nodes.items[g];
    near(nd.w, w, `{msg}: grid width`);
    at(d, g, 0, 0.0, 0.0, tw, 20.0, `{msg}: first`);
    if n > 1 {
        at(d, g, 1, tw + 4.0, 0.0, tw, 20.0, `{msg}: second`);
    }
    // item 5 (the sixth) sits in column 5 % n, row 5 / n
    at(d, g, 5, f32(5 % n) * (tw + 4.0), f32(5 / n) * 24.0, tw, 20.0, `{msg}: last wraps by the count`);
}

fn testFit(d: &Dom) {
    let e = grid(d, 7);
    at(d, e, 0, 0.0, 0.0, 150.0, 20.0, "auto-fit: the empty tracks collapse, the others stretch");
    at(d, e, 1, 150.0, 0.0, 150.0, 20.0, "auto-fit: second");
    let e2 = grid(d, 8);
    at(d, e2, 0, 0.0, 0.0, 50.0, 20.0, "auto-fill keeps the empty tracks");
    at(d, e2, 1, 50.0, 0.0, 50.0, 20.0, "auto-fill: second");
}

fn testPlacement(d: &Dom) {
    let f = grid(d, 9);
    at(d, f, 0, 0.0, 0.0, 210.0, 20.0, "span 2 includes the gap");
    at(d, f, 1, 220.0, 0.0, 100.0, 20.0, "auto item takes the next free cell");
    at(d, f, 2, 110.0, 30.0, 210.0, 20.0, "2 / 4 starts left of the cursor: next row");
    at(d, f, 3, 0.0, 60.0, 100.0, 20.0, "auto item skips the occupied cells and wraps");
    at(d, f, 4, 0.0, 30.0, 100.0, 20.0, "fixed row and column are placed first");
    near(d.nodes.items[f].h, 80.0, "three rows with gaps");
    let g = grid(d, 10);
    at(d, g, 1, 150.0, 0.0, 50.0, 30.0, "implicit column and auto-rows size");
    near(d.nodes.items[g].h, 30.0, "implicit row height");
    let h = grid(d, 11);
    at(d, h, 1, 0.0, 20.0, 60.0, 20.0, "column flow fills the rows first");
    at(d, h, 2, 60.0, 0.0, 60.0, 20.0, "column flow: next column");
    at(d, h, 4, 120.0, 0.0, 60.0, 20.0, "column flow: third column");
    let dn = grid(d, 12);
    at(d, dn, 1, 0.0, 20.0, 100.0, 20.0, "dense: the second span wraps");
    at(d, dn, 2, 100.0, 0.0, 50.0, 20.0, "dense fills the hole");
    let sp = grid(d, 13);
    at(d, sp, 2, 100.0, 20.0, 50.0, 20.0, "sparse leaves the hole");
    let k = grid(d, 14);
    at(d, k, 0, 0.0, 0.0, 150.0, 0.0, "item spanning two auto tracks");
    at(d, k, 1, 0.0, 0.0, 40.0, 0.0, "spanned tracks share the extra: first");
    at(d, k, 2, 80.0, 0.0, 30.0, 0.0, "spanned tracks share the extra: second starts at 80");
}


fn testEdges(d: &Dom) {
    let z = grid(d, 18);
    at(d, z, 0, 0.0, 0.0, 64.0, 20.0, "zero-width container still has one track");
    at(d, z, 1, 0.0, 20.0, 64.0, 20.0, "zero-width container: next item wraps");
    let s = grid(d, 19);
    at(d, s, 0, 0.0, 0.0, 300.0, 20.0, "span past the explicit grid");
    at(d, s, 1, 200.0, 20.0, 100.0, 0.0, "implicit tracks took the spanning item's extra, evenly");
    let neg = grid(d, 20);
    at(d, neg, 0, 0.0, 0.0, 100.0, 0.0, "negative lines past the start clamp to the first line");
    near(d.nodes.items[grid(d, 21)].h, 0.0, "an empty grid with columns has no height");
    let same = grid(d, 22);
    at(d, same, 0, 0.0, 0.0, 100.0, 0.0, "items in one cell overlap: first");
    at(d, same, 1, 0.0, 0.0, 100.0, 0.0, "items in one cell overlap: second");
    let fr = grid(d, 23);
    at(d, fr, 1, 0.0, 20.0, 250.0, 0.0, "fr tracks grow to a spanning item's minimum: first");
    at(d, fr, 2, 250.0, 20.0, 250.0, 0.0, "fr tracks grow to a spanning item's minimum: second");
    at(d, grid(d, 24), 1, 150.0, 0.0, 100.0, 0.0, "minmax(auto, 1fr) is not squeezed below its content");
    at(d, grid(d, 25), 1, 100.0, 0.0, 100.0, 0.0, "minmax(auto, 1fr) shares when the content fits");
}

/// `n` items in `cls`, timed: the grid's last item, laid out at width 600.
fn bigFrame(d: &Dom, n: int, cls: string) {
    d.beginFrame(Vec2 { x: 600.0, y: 600.0 });
    node(d, 0, "host");
    node(d, 0, cls);
    for q in 0..n {
        leaf(d, 0, "i");
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

/// 1000 inventory slots and a 10000-row implicit grid must lay out in linear time (no per-item scans of the table).
fn testScale(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.simInput(-5.0, -5.0, false, 0.0);
    let t0 = micros();
    bigFrame(&d, 1000, "gbig");
    let t1 = micros();
    let g = grid(&d, 0);
    // 600 wide, 4px gaps, 64px minimum: 8 columns of 71.5px; item 999 is row 124, column 7
    at(&d, g, 999, 528.5, 2976.0, 71.5, 20.0, "1000-slot inventory: last slot");
    bigFrame(&d, 10000, "grows");
    let t2 = micros();
    let g2 = grid(&d, 0);
    at(&d, g2, 9999, 0.0, 199980.0, 600.0, 20.0, "10000-row implicit grid: last row");
    printLn(`grid scale: 1000 auto-fill items {t1 - t0} us, 10000 implicit rows {t2 - t1} us`);
    CHECKS += 1;
    if t1 - t0 > 500000 || t2 - t1 > 1500000 {
        panic("grid layout of 1000 / 10000 items is too slow");
    }
}

const CSS2: string = "* { box-sizing: border-box; margin: 0; padding: 0; } .host { width: 100%; } .n { margin: 0; } .w30 { width: 30px; height: 10px; }\n.a { display: grid; width: 300px; height: 200px; grid-template-columns: 100px 1fr; grid-template-rows: 40px 1fr 30px; grid-template-areas: \"head head\" \"side main\" \"foot foot\"; }\n.head { grid-area: head; } .side { grid-area: side; } .main { grid-area: main; } .foot { grid-area: foot; }\n.b { display: grid; width: 300px; grid-template-columns: 50px; grid-auto-columns: 100px; grid-auto-rows: 20px; grid-template-areas: \"p q r\" \"p q r\"; } .q { grid-area: q; } .z { grid-area: nosuch; }\n.c { display: grid; width: 200px; grid-template-columns: 100px 100px; grid-auto-rows: 20px; grid-template-areas: \". x\" \". x\"; } .cx { grid-column: x; grid-row: 2; } .num { grid-area: 2 / 1 / 3 / 2; }\n.d { display: grid; width: 200px; height: 100px; grid-template-columns: 200px; grid-template-rows: 100px; }\n.js-s { justify-self: start; } .js-e { justify-self: end; } .js-c { justify-self: center; } .js-fe { justify-self: flex-end; } .as-s { align-self: start; } .as-e { align-self: end; } .as-c { align-self: center; } .as-fs { align-self: flex-start; }\n.dc { justify-items: center; align-items: end; } .dp { place-items: center; } .ps { place-self: center end; } .ma { margin: auto; } .ml { margin-left: auto; } .mt { margin-top: auto; }\n.e { display: grid; width: 300px; height: 100px; grid-template-columns: 50px 50px; grid-template-rows: 20px 20px; }\n.jc-c { justify-content: center; } .jc-e { justify-content: end; } .jc-b { justify-content: space-between; } .jc-a { justify-content: space-around; } .jc-v { justify-content: space-evenly; } .ac-c { align-content: center; } .ac-b { align-content: space-between; }\n";

fn build2(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 600.0 });
    node(d, 0, "host");
    node(d, 0, "a"); leaf(d, 0, "head"); leaf(d, 1, "main"); leaf(d, 2, "foot"); leaf(d, 3, "side"); d.close();
    node(d, 1, "b"); leaf(d, 0, "q"); leaf(d, 1, "z"); d.close();
    node(d, 2, "c"); leaf(d, 0, "cx"); leaf(d, 1, "num"); d.close();
    let k = 3;
    let cls = ["", "js-s as-s", "js-e as-e", "js-c as-c", "js-fe as-fs", "ps", "ma", "ml", "mt"];
    for q in 0..9 {
        node(d, k, "d"); node(d, 0, cat(d.mem, "box ", cls[q])); leaf(d, 0, "w30"); d.close(); d.close();
        k += 1;
    }
    node(d, k, "d dc"); node(d, 0, "box"); leaf(d, 0, "w30"); d.close(); d.close();
    k += 1;
    node(d, k, "d dp"); node(d, 0, "box js-s"); leaf(d, 0, "w30"); d.close(); d.close();
    k += 1;
    let jc = ["jc-c", "jc-e", "jc-b", "jc-a", "jc-v", "ac-c", "ac-b"];
    for q in 0..7 {
        node(d, k, cat(d.mem, "e ", jc[q])); leaf(d, 0, "n"); leaf(d, 1, "n"); leaf(d, 2, "n"); leaf(d, 3, "n"); d.close();
        k += 1;
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn cat(mem: &Arena, a: string, b: string): string {
    let t = Text.new(mem);
    t.pushStr(a);
    t.pushStr(b);
    return t.str();
}

fn testAreas(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, CSS2, "gridareas.css", 0);
    if css.warns.len != 0 {
        printLn(css.warns.items[0].msg);
    }
    CHECKS += 1;
    if css.warns.len != 0 {
        panic("area css parses without warnings");
    }
    let d = Dom.new(mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    build2(&d);
    // header / sidebar / main / footer: `1fr` tracks take the rest of the definite size
    let a = grid(&d, 0);
    at(&d, a, 0, 0.0, 0.0, 300.0, 40.0, "areas: head spans both columns");
    at(&d, a, 1, 100.0, 40.0, 200.0, 130.0, "areas: main");
    at(&d, a, 2, 0.0, 170.0, 300.0, 30.0, "areas: foot");
    at(&d, a, 3, 0.0, 40.0, 100.0, 130.0, "areas: side (placed whatever its source order)");
    // the areas make three columns and two rows explicit past the one-track template; the rest are auto sized
    let b = grid(&d, 1);
    at(&d, b, 0, 50.0, 0.0, 100.0, 40.0, "areas imply tracks: q is columns 2 (auto-columns 100px), both rows");
    at(&d, b, 1, 0.0, 0.0, 50.0, 20.0, "an unknown area name is auto placement");
    let c = grid(&d, 2);
    at(&d, c, 0, 100.0, 20.0, 100.0, 20.0, "grid-column: <area name>");
    at(&d, c, 1, 0.0, 20.0, 100.0, 20.0, "grid-area: rs / cs / re / ce");
    // one 30 x 10 box in a 200 x 100 cell
    let r: [9][4]f32 = [[0.0, 0.0, 200.0, 100.0], [0.0, 0.0, 30.0, 10.0], [170.0, 90.0, 30.0, 10.0], [85.0, 45.0, 30.0, 10.0], [170.0, 0.0, 30.0, 10.0], [170.0, 45.0, 30.0, 10.0], [85.0, 45.0, 30.0, 10.0], [170.0, 0.0, 30.0, 100.0], [0.0, 90.0, 200.0, 10.0]];
    let names = ["stretch is the default", "start", "end", "center", "flex-end / flex-start aliases", "place-self: center end", "margin: auto", "margin-left: auto", "margin-top: auto"];
    for q in 0..9 {
        at(&d, kid(&d, d.nodes.items[0].first, 3 + q), 0, r[q][0], r[q][1], r[q][2], r[q][3], names[q]);
    }
    let dc = grid(&d, 12);
    at(&d, dc, 0, 85.0, 90.0, 30.0, 10.0, "justify-items: center; align-items: end");
    let dp = grid(&d, 13);
    at(&d, dp, 0, 0.0, 45.0, 30.0, 10.0, "place-items: center, justify-self overrides");
    // 300 x 100 grid of 2 x 50px columns, 2 x 20px rows: free space 200 x 60
    let xs: [5]f32 = [100.0, 200.0, 0.0, 50.0, 66.66667];
    let x1: [5]f32 = [150.0, 250.0, 250.0, 200.0, 183.33333];
    for q in 0..5 {
        let g = grid(&d, 14 + q);
        near(d.nodes.items[kid(&d, g, 0)].x, xs[q], "content distribution: first column");
        near(d.nodes.items[kid(&d, g, 1)].x, x1[q], "content distribution: second column");
        near(d.nodes.items[kid(&d, g, 0)].y, 0.0, "justify-content leaves rows alone");
    }
    let g5 = grid(&d, 19);
    near(d.nodes.items[kid(&d, g5, 0)].y, 30.0, "align-content: center, first row");
    near(d.nodes.items[kid(&d, g5, 2)].y, 50.0, "align-content: center, second row");
    near(d.nodes.items[kid(&d, g5, 0)].x, 0.0, "align-content leaves columns alone");
    let g6 = grid(&d, 20);
    near(d.nodes.items[kid(&d, g6, 2)].y, 80.0, "align-content: space-between");
    let laid = d.laid;
    build2(&d);
    CHECKS += 1;
    if d.laid != laid {
        panic("a steady frame of the areas page lays out nothing");
    }
}

fn main() {
    let mem = Arena.create(256 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, CSS, "gridlayout.css", 0);
    if css.warns.len != 0 {
        printLn(css.warns.items[0].msg);
    }
    CHECKS += 1;
    if css.warns.len != 0 {
        panic("grid css parses without warnings");
    }
    let d = Dom.new(&mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    build(&d, 300.0);
    testRows(&d);
    testMinmax(&d);
    testFill(&d, 300.0, 4, "auto-fill at 300");
    testFit(&d);
    testPlacement(&d);
    testEdges(&d);
    // a steady frame lays out nothing
    let laid = d.laid;
    build(&d, 300.0);
    CHECKS += 1;
    if d.laid != laid {
        panic("a steady frame lays out nothing");
    }
    // resize: the track count follows the width, every row moves
    build(&d, 140.0);
    testFill(&d, 140.0, 2, "auto-fill at 140");
    build(&d, 30.0);
    testFill(&d, 30.0, 1, "auto-fill at 30");
    build(&d, 64.0);
    testFill(&d, 64.0, 1, "auto-fill at exactly one track");
    build(&d, 300.0);
    testFill(&d, 300.0, 4, "auto-fill back at 300");
    testRows(&d);
    testPlacement(&d);
    testScale(&mem, &css);
    testAreas(&mem);
    printLn(`gridlayout_test ok, checks passed: {CHECKS}`);
}
