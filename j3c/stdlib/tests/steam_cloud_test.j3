// Tests for j3.steam apps (ownership, DLC) and Steam Cloud (files, async, cloudSync), plus data.save.userDir:
// absent no-ops, fake mode, struct layouts for both pack rules, the newest-wins sync rule on a scratch folder.
// Run from j3c/:  timeout 120 target/release/j3c run stdlib/tests/steam_cloud_test.j3
// Panics on the first failed check.

module steam_cloud_test;

use j3.data.save;
use j3.io;
use j3.io.printLn;
use j3.memory.Arena;
use j3.result.Result;
use j3.steam;
use j3.sys.panic;

#[singleton]
let DLC_ID: u32;
#[singleton]
let LAUNCH_N: int;
#[singleton]
let W_OK: int;
#[singleton]
let W_CTX: u64;
#[singleton]
let R_LEN: int;
#[singleton]
let R_OK: int;
#[singleton]
let R_FIRST: u8;
#[singleton]
let R_CTX: u64;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onDlc(id: u32) {
    DLC_ID = id;
}

fn onLaunch() {
    LAUNCH_N += 1;
}

fn onWrite(good: bool, ctx: u64) {
    if good {
        W_OK = 1;
    } else {
        W_OK = 2;
    }
    W_CTX = ctx;
}

fn onRead(data: []u8, good: bool, ctx: u64) {
    R_LEN = data.len;
    if good {
        R_OK = 1;
    } else {
        R_OK = 2;
    }
    if data.len > 0 {
        R_FIRST = data[0];
    }
    R_CTX = ctx;
}

fn bytes(s: string, mem: &Arena): []u8 {
    let out = mem.alloc::<u8>(s.len);
    for i in 0..s.len {
        out[i] = s[i];
    }
    return out;
}

fn text(b: []u8): string {
    return b as string;
}

fn absent() {
    let mem = Arena.create(4096);
    ok(!steam.owns() && !steam.ownsApp(u32(480)) && !steam.dlcInstalled(u32(1)), "absent ownership");
    ok(steam.dlcCount() == 0 && steam.dlcAt(0).id == u32(0) && steam.dlcAt(0).name.len == 0, "absent dlc");
    steam.installDlc(u32(1));
    steam.uninstallDlc(u32(1));
    ok(!steam.dlcProgress(u32(1)).ok, "absent progress");
    ok(steam.beta().len == 0 && steam.buildId() == 0 && steam.appOwner() == u64(0), "absent build info");
    ok(!steam.appInstalled(u32(1)) && steam.installDir(u32(1)).len == 0 && steam.purchaseTime(u32(1)) == u32(0), "absent install");
    ok(!steam.freeWeekend() && !steam.familyShared() && !steam.lowViolence() && !steam.vacBanned(), "absent flags");
    ok(steam.languages().len == 0 && steam.launchParam("k").len == 0, "absent languages");
    steam.markCorrupt(true);
    ok(!steam.cloudOn(), "absent cloudOn");
    steam.cloudSetApp(true);
    let d = bytes("hi", &mem);
    ok(!steam.cloudWrite("a.txt", d), "absent write");
    ok(steam.cloudRead("a.txt", &mem).len == 0, "absent read");
    ok(!steam.cloudExists("a") && !steam.cloudPersisted("a") && !steam.cloudDelete("a") && !steam.cloudForget("a"), "absent file calls");
    ok(steam.cloudSize("a") == 0 && steam.cloudTime("a") == i64(0) && steam.cloudCount() == 0, "absent size/time/count");
    ok(steam.cloudAt(0).name.len == 0 && steam.cloudQuota().total == u64(0), "absent at/quota");
    steam.cloudBatch(true);
    steam.cloudBatch(false);
    ok(steam.cloudSync("a", "/tmp/j3_nope", &mem) == steam.Sync.Off, "absent sync");
    steam.cloudWriteAsync("a", d, onWrite, u64(5));
    steam.cloudReadAsync("a", u32(0), u32(2), &mem, onRead, u64(6));
    steam.frame();
    ok(W_OK == 2 && W_CTX == u64(5) && R_OK == 2 && R_LEN == 0 && R_CTX == u64(6), "absent async handlers fail on the next frame");
    W_OK = 0;
    R_OK = 0;
}

fn userDirs() {
    ok(save.userDir("").len == 0 && save.userDir(".").len == 0, "empty game");
    ok(save.userDir("a/b").len == 0 && save.userDir("a\\b").len == 0, "separators");
    ok(save.userDir("..").len == 0 && save.userDir("x..y").len == 0, "dotdot");
}

fn layouts() {
    for v in 0..2 {
        let large = v == 1;
        ok(steam.layAt("DlcInstalled_t", steam.SIZE, large) == 4 && steam.layAt("DlcInstalled_t", "nAppID", large) == 0, "dlc layout");
        ok(steam.layAt("NewUrlLaunchParameters_t", steam.SIZE, large) == 1, "launch layout");
        ok(steam.layAt("RemoteStorageFileWriteAsyncComplete_t", steam.SIZE, large) == 4, "write done size");
        ok(steam.layAt("RemoteStorageFileWriteAsyncComplete_t", "eResult", large) == 0, "write done result");
        let r = "RemoteStorageFileReadAsyncComplete_t";
        ok(steam.layAt(r, steam.SIZE, large) == [20, 24][v], "read done size");
        ok(steam.layAt(r, "hFileReadAsync", large) == 0 && steam.layAt(r, "eResult", large) == 8, "read done offsets");
        ok(steam.layAt(r, "nOffset", large) == 12 && steam.layAt(r, "cubRead", large) == 16, "read done offsets 2");
    }
}

fn pushCb(id: i32, b: []u8) {
    steam.fakeCallback(id, b);
    steam.frame();
}

fn fakeApps() {
    ok(steam.owns() && steam.ownsApp(u32(1001)) && !steam.ownsApp(u32(7)), "fake ownership");
    ok(steam.dlcCount() == 2, "fake dlc count");
    let a = steam.dlcAt(0);
    let b = steam.dlcAt(1);
    ok(a.id == u32(1001) && a.available && a.name.len > 0 && b.id == u32(1002), "fake dlc rows");
    ok(steam.dlcAt(2).id == u32(0), "dlc out of range");
    ok(steam.dlcInstalled(u32(1001)) && !steam.dlcInstalled(u32(1002)), "fake installed");
    steam.onDlcInstalled(onDlc);
    steam.installDlc(u32(1002));
    ok(DLC_ID == u32(0), "dlc event waits for the frame");
    steam.frame();
    ok(DLC_ID == u32(1002) && steam.dlcInstalled(u32(1002)), "dlc installed event");
    steam.uninstallDlc(u32(1002));
    ok(!steam.dlcInstalled(u32(1002)), "dlc uninstalled");
    ok(steam.beta().len == 0 && steam.buildId() == 1 && steam.languages() == "english", "fake build info");
    ok(steam.appOwner() != u64(0) && steam.appInstalled(u32(1001)), "fake owner");
    steam.onLaunchParams(onLaunch);
    let mem = Arena.create(4096);
    let one = mem.alloc::<u8>(1);
    pushCb(1014, one);
    ok(LAUNCH_N == 1, "launch params event");
    let four = mem.alloc::<u8>(4);
    four[0] = u8(210);
    four[1] = u8(4);
    pushCb(1005, four);
    ok(DLC_ID == u32(1234), "dlc event decodes the app id");
}

fn fakeCloud() {
    let mem = Arena.create(1048576);
    ok(steam.cloudOn(), "fake cloud on");
    ok(steam.cloudWrite("one.txt", bytes("hello", &mem)), "write");
    ok(text(steam.cloudRead("one.txt", &mem)) == "hello" && steam.cloudSize("one.txt") == 5, "read back");
    ok(steam.cloudExists("one.txt") && steam.cloudPersisted("one.txt"), "exists");
    ok(steam.cloudTime("one.txt") > i64(1700000000) && steam.cloudTime("none") == i64(0), "time");
    ok(steam.cloudWrite("empty", mem.alloc::<u8>(0)), "write empty");
    ok(steam.cloudExists("empty") && steam.cloudRead("empty", &mem).len == 0 && steam.cloudSize("empty") == 0, "empty file exists");
    ok(!steam.cloudExists("none") && steam.cloudRead("none", &mem).len == 0, "missing file");
    ok(steam.cloudCount() == 2 && steam.cloudAt(0).name == "one.txt" && steam.cloudAt(0).size == 5 && steam.cloudAt(2).name.len == 0, "listing");
    ok(steam.cloudQuota().total == u64(1073741824) && steam.cloudQuota().available == u64(1073741819), "quota");
    ok(steam.cloudForget("one.txt") && !steam.cloudPersisted("one.txt") && steam.cloudExists("one.txt"), "forget");
    ok(steam.cloudDelete("one.txt") && !steam.cloudExists("one.txt") && !steam.cloudDelete("one.txt"), "delete");
    steam.cloudBatch(true);
    steam.cloudBatch(false);
    let tiny = mem.alloc::<u8>(4);
    let huge: []u8 = @slice(&tiny[0] as ptr, 104857601);
    ok(!steam.cloudWrite("big", huge) && !steam.cloudExists("big"), "over 100 MiB refused");
    // async
    steam.cloudWriteAsync("a.bin", bytes("ABCDEFG", &mem), onWrite, u64(11));
    ok(W_OK == 0, "async write waits for the frame");
    steam.frame();
    ok(W_OK == 1 && W_CTX == u64(11) && steam.cloudSize("a.bin") == 7, "async write");
    steam.cloudReadAsync("a.bin", u32(2), u32(3), &mem, onRead, u64(12));
    steam.frame();
    ok(R_OK == 1 && R_LEN == 3 && R_FIRST == u8(67) && R_CTX == u64(12), "async read slice");
    steam.cloudReadAsync("a.bin", u32(5), u32(99), &mem, onRead, u64(13));
    steam.frame();
    ok(R_OK == 1 && R_LEN == 2 && R_FIRST == u8(70), "async read clamps to the end");
    steam.cloudReadAsync("nope", u32(0), u32(4), &mem, onRead, u64(14));
    steam.frame();
    ok(R_OK == 2 && R_LEN == 0 && R_CTX == u64(14), "async read of a missing file");
    steam.cloudSetApp(false);
    ok(!steam.cloudOn() && !steam.cloudWrite("x", bytes("x", &mem)), "cloud off");
    ok(steam.cloudSync("a.bin", "/tmp/j3_steam_cloud_test/never", &mem) == steam.Sync.Off, "sync is off");
    steam.cloudSetApp(true);
}

fn put(path: string, s: string, mem: &Arena) {
    match io.writeFile(path, bytes(s, mem)) {
        Result.Ok(_) {}
        Result.Err(_) {
            panic("test write failed");
        }
    }
}

fn get(path: string, mem: &Arena): string {
    match io.readFile(path, mem) {
        Result.Ok(b) {
            return text(b);
        }
        Result.Err(_) {
            return "<missing>";
        }
    }
}

fn mtime(path: string): int {
    match io.stat(path) {
        Result.Ok(e) {
            return e.mtime;
        }
        Result.Err(_) {
            return 0;
        }
    }
}

fn syncRule() {
    let mem = Arena.create(65536);
    let dir = "/tmp/j3_steam_cloud_test";
    io.makeDirs(dir);
    let path = `{dir}/save.txt`;
    io.remove(path);
    io.remove(`{path}.bak`);
    io.remove(`{path}.cloud.bak`);
    io.remove(`{path}.tmp`);
    steam.cloudDelete("save");
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Same, "neither side exists");
    // local only: pushed
    put(path, "local1", &mem);
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Pushed, "local only pushes");
    ok(get(path, &mem) == "local1" && text(steam.cloudRead("save", &mem)) == "local1", "push content");
    let lt = mtime(path);
    // equal time, different bytes: local wins, the cloud copy is kept
    steam.fakeCloudTime("save", i64(lt));
    steam.cloudWrite("save", bytes("cloudX", &mem));
    steam.fakeCloudTime("save", i64(lt));
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Pushed, "equal time with different bytes pushes");
    ok(get(path, &mem) == "local1" && text(steam.cloudRead("save", &mem)) == "local1" && get(`{path}.cloud.bak`, &mem) == "cloudX", "tie keeps the cloud copy");
    steam.fakeCloudTime("save", i64(lt));
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Same, "equal time, same bytes");
    steam.cloudWrite("save", bytes("cloudX", &mem));
    // cloud newer: pulled, old local kept as .bak
    steam.fakeCloudTime("save", i64(lt + 100));
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Pulled, "cloud newer pulls");
    ok(get(path, &mem) == "cloudX" && get(`{path}.bak`, &mem) == "local1", "pull keeps the old local file");
    ok(get(`{path}.tmp`, &mem) == "<missing>", "tmp file is gone");
    // identical bytes: same whatever the times
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Same, "identical bytes are same");
    // local newer: pushed, old cloud bytes kept as .cloud.bak
    put(path, "local2", &mem);
    steam.fakeCloudTime("save", i64(1));
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Pushed, "local newer pushes");
    ok(text(steam.cloudRead("save", &mem)) == "local2" && get(`{path}.cloud.bak`, &mem) == "cloudX", "push keeps the old cloud bytes");
    // cloud only: pulled
    io.remove(path);
    ok(steam.cloudSync("save", path, &mem) == steam.Sync.Pulled, "cloud only pulls");
    ok(get(path, &mem) == "local2", "pull content");
    // failure: unwritable local path, the cloud file stays
    ok(steam.cloudSync("save", "/tmp/j3_steam_cloud_test/no/such/dir/f", &mem) == steam.Sync.Failed, "unwritable path fails");
    ok(steam.cloudExists("save") && text(steam.cloudRead("save", &mem)) == "local2", "failure loses nothing");
}

fn main() {
    absent();
    userDirs();
    layouts();
    ok(steam.initFake(u32(1001)) == steam.Status.Fake, "fake init");
    fakeApps();
    fakeCloud();
    syncRule();
    steam.shutdown();
    ok(!steam.cloudExists("a.bin") && steam.cloudCount() == 0 && !steam.dlcInstalled(u32(1001)), "absent after shutdown");
    steam.initFake(u32(1001));
    ok(steam.cloudCount() == 0 && !steam.dlcInstalled(u32(1002)), "fake state cleared at shutdown");
    steam.shutdown();
    printLn("steam_cloud_test ok");
}
