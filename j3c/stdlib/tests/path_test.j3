// A* on grids past the old 4096-cell cap, detours, walled-off goals.
//   timeout 60 j3c run j3c/stdlib/tests/path_test.j3

module path_test;

use j3.io.printLn;
use j3.sys.{ panic, monotonicMs };
use j3.game.path;
use j3.memory.{ scratch, rewindScratch };

/// `n` x `n` open grid with column `n/2` blocked for y < `wall`.
fn grid(n: int, wall: int): []u8 {
    let c = scratch(1).alloc::<u8>(n * n);
    for i in 0..(n * n) { c[i] = 0; }
    for y in 0..wall { c[y * n + n / 2] = 1; }
    return c;
}

fn main() {
    let sizes = [64, 65, 100, 192, 256];
    for k in 0..5 {
        let n = sizes[k];
        let wall = n - n / 20 - 1;
        let c = grid(n, wall);
        let t0 = monotonicMs();
        let p = path.search(c, n, n, 0, 0, n - 1, 0, 0, 0);
        if p.len == 0 || p[0] != 0 || p[p.len - 1] != n - 1 {
            panic(`no path at {n}`);
        }
        // Shortest: down to y = wall, across, back up.
        if p.len != 2 * wall + n {
            panic(`path at {n} has {p.len} cells, want {2 * wall + n}`);
        }
        let around = false;
        for i in 0..p.len {
            if p[i] % n == n / 2 && p[i] / n >= wall { around = true; }
        }
        if !around { panic(`path at {n} does not go around the wall`); }
        if n == 192 { printLn(`192x192 detour: {monotonicMs() - t0} ms, {p.len} cells`); }
        rewindScratch();
    }
    // Goal fully walled off.
    let c = grid(192, 0);
    let g = 100 * 192 + 100;
    c[g - 1] = 1; c[g + 1] = 1; c[g - 192] = 1; c[g + 192] = 1;
    if path.search(c, 192, 192, 0, 0, 100, 100, 0, 0).len != 0 {
        panic("walled-off goal returned a path");
    }
    printLn("path_test ok");
}
