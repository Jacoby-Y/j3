// overlay_test: math, toast, scrolling, inertia, scroll bars, long lists.

module overlay_test;

// ---- pure math ---------------------------------------------------------------------------------------

fn testMath() {
    near(scroll.clampOff(10.0, 100.0, 50.0), 50.0, 0.001, "clamp above");
    near(scroll.clampOff(10.0, -100.0, 50.0), 0.0, 0.001, "clamp below");
    ok(scroll.canMove(0.0, 50.0, 1.0) && !scroll.canMove(0.0, 50.0, -1.0), "at the start only forward moves");
    ok(!scroll.canMove(50.0, 50.0, 1.0) && scroll.canMove(50.0, 50.0, -1.0), "at the end only back moves");
    // inertia: a notch coasts about NOTCH px in total and then stops
    let v = scroll.kick(0.0, 1.0);
    let total: f32 = 0.0;
    for i in 0..200 {
        let nv: f32 = 0.0;
        total += scroll.coast(v, 16.0, &nv);
        v = nv;
    }
    near(total, scroll.NOTCH, 1.0, "one notch of inertia travels one notch");
    ok(v == 0.0, "and the speed reaches zero");
    // bars: thumb size and position, and the inverse
    let th = scrollbar.thumb(100.0, 100.0, 400.0, 0.0, 300.0);
    near(th.len, 25.0, 0.01, "thumb is the view's share of the track");
    near(th.pos, 0.0, 0.01, "thumb at the top");
    let th2 = scrollbar.thumb(100.0, 100.0, 400.0, 300.0, 300.0);
    near(th2.pos, 75.0, 0.01, "thumb at the end");
    let tiny = scrollbar.thumb(100.0, 100.0, 100000.0, 0.0, 99900.0);
    near(tiny.len, 24.0, 0.01, "thumb keeps a grab size");
    near(scrollbar.offsetFor(100.0, 100.0, 400.0, 300.0, 37.5), 150.0, 0.01, "offsetFor inverts thumb");
    near(scrollbar.offsetFor(100.0, 100.0, 400.0, 300.0, 500.0), 300.0, 0.01, "offsetFor clamps");
    let b = Bars { w: 200.0, h: 100.0, t: 10.0, showX: true, showY: true, offX: 0.0, maxX: 100.0, contX: 300.0, offY: 0.0, maxY: 300.0, contY: 400.0 };
    ok(scrollbar.hit(&b, 195.0, 5.0) == scrollbar.Y_THUMB, "hit y thumb");
    ok(scrollbar.hit(&b, 195.0, 80.0) == scrollbar.Y_TRACK, "hit y track");
    ok(scrollbar.hit(&b, 20.0, 95.0) == scrollbar.X_THUMB, "hit x thumb");
    ok(scrollbar.hit(&b, 150.0, 95.0) == scrollbar.X_TRACK, "hit x track");
    ok(scrollbar.hit(&b, 50.0, 50.0) == scrollbar.NONE, "no hit in the content");
    b.t = 0.0;
    b.showX = false;
    b.showY = false;
    ok(scrollbar.hit(&b, 195.0, 5.0) == scrollbar.NONE, "no bar when hidden");
}

fn testToast(mem: &Arena) {
    let t = Toasts.new();
    ok(t.count() == 0 && !t.live(0), "empty");
    let a = t.push("one", 1, 1000.0, 0.0);
    let b = t.push("two", 2, 1000.0, 100.0);
    ok(a == 0 && b == 1 && t.count() == 2, "slots fill in order");
    ok(same(t.text(0), "one") && same(t.text(1), "two") && t.kind(1) == 2, "text and kind are kept");
    t.tick(1050.0);
    ok(!t.live(0) && t.live(1), "the first expires first");
    let c = t.push("three", 0, 1000.0, 1060.0);
    ok(c == 0 && same(t.text(1), "two"), "a freed slot is reused and the other keeps its place");
    let u = Toasts.new();
    for i in 0..6 {
        u.push("fill", 0, 5000.0, f32(10 + i));
    }
    ok(u.count() == 6, "never more than the slots");
    let oldest = u.push("new", 0, 5000.0, 2000.0);
    ok(oldest == 0 && same(u.text(0), "new"), "with none free the longest-up one is replaced");
    u.dismiss(2);
    ok(!u.live(2) && u.count() == 5, "dismiss closes one");
    let long = u.push("0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789", 0, 10.0, 0.0);
    let lt = u.text(long);
    ok(lt.len == 127, "long text is cut");
}

// ---- scrolling -------------------------------------------------------------------------------------------

fn testScroll(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let l = IDS.list;
    near(d.nodes.items[l].scrollMax, f32(30 * 20 - 100), 0.01, "scroll range is content minus view");
    wheel(&d, l, 2.0);
    near(d.nodes.items[l].scrollY, 96.0, 0.01, "two notches scroll 96 px");
    wheel(&d, l, -1.0);
    near(d.nodes.items[l].scrollY, 48.0, 0.01, "and one back");
    wheel(&d, l, 1000.0);
    near(d.nodes.items[l].scrollY, d.nodes.items[l].scrollMax, 0.01, "the end clamps");
    // the content shrinks under the offset
    ROWS = 10;
    frame(&d);
    near(d.nodes.items[l].scrollY, 100.0, 0.01, "fewer rows pull the offset back");
    ROWS = 3;
    frame(&d);
    near(d.nodes.items[l].scrollY, 0.0, 0.01, "content that fits has no offset");
    ok(d.nodes.items[l].scrollMax == 0.0, "and no range");
    ROWS = 30;
    frame(&d);
    // horizontal: Shift + wheel
    let s = IDS.strip;
    near(d.nodes.items[s].scrollMaxX, f32(6 * 60 - 100), 0.5, "horizontal range from the content width");
    d.simInput(cx(&d, s), cy(&d, s), false, -1.0);
    d.simKeys("", "Shift");
    frame(&d);
    near(d.nodes.items[s].scrollX, 48.0, 0.01, "Shift + wheel scrolls sideways");
    near(d.nodes.items[s].scrollY, 0.0, 0.01, "and not down");
    // a box with only an x axis takes the plain wheel
    wheel(&d, s, 1.0);
    near(d.nodes.items[s].scrollX, 96.0, 0.01, "a horizontal-only box takes the plain wheel");
    near(d.absX(IDS.strip + 2) - d.absX(IDS.strip), f32(60 - 96), 0.5, "children move with the offset");
    // chaining
    let o = IDS.outer;
    let i = IDS.inner;
    near(d.nodes.items[i].scrollMax, f32(6 * 20 - 40), 0.01, "inner range");
    wheel(&d, i, 5.0);
    near(d.nodes.items[i].scrollY, 80.0, 0.01, "the inner box scrolls first");
    near(d.nodes.items[o].scrollY, 0.0, 0.01, "the outer waits");
    wheel(&d, i, 1.0);
    ok(d.nodes.items[o].scrollY > 0.0, "at its end the wheel goes to the outer box");
    let i2 = IDS.inner2;
    let o2 = IDS.outer2;
    wheel(&d, i2, 5.0);
    wheel(&d, i2, 3.0);
    near(d.nodes.items[o2].scrollY, 0.0, 0.01, "overscroll-behavior: contain keeps the wheel in the inner box");
}

fn testInertia(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    SMOOTH = true;
    frame(&d);
    let l = IDS.list;
    wheel(&d, l, 3.0);
    ok(d.nodes.items[l].scrollY < 96.0, "smooth: the first frame has not arrived yet");
    ok(d.coasting > 0, "and the box is coasting");
    let prev: f32 = d.nodes.items[l].scrollY;
    let mono = true;
    for k in 0..90 {
        frame(&d);
        if d.nodes.items[l].scrollY < prev {
            mono = false;
        }
        prev = d.nodes.items[l].scrollY;
    }
    ok(mono, "it only moves forward");
    near(d.nodes.items[l].scrollY, 144.0, 1.5, "three notches travel 144 px in total");
    ok(d.coasting == 0, "and then the box rests");
    // coasting into the end stops there
    wheel(&d, l, 40.0);
    for k2 in 0..200 {
        frame(&d);
    }
    near(d.nodes.items[l].scrollY, d.nodes.items[l].scrollMax, 0.01, "inertia stops at the end");
    ok(d.nodes.items[l].velY == 0.0, "with no speed left");
}

fn testBars(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let l = IDS.list;
    let n = &d.nodes.items[l];
    let bars = dom.barsOf(&d, l);
    ok(bars.showY && !bars.showX, "an overflowing auto box shows a y bar");
    let ty = scrollbar.trackY(&bars);
    let th = scrollbar.thumb(ty, bars.h, bars.contY, 0.0, bars.maxY);
    let x = d.absX(l) + bars.w - 5.0;
    let y0 = d.absY(l) + 2.0 + th.pos + th.len / 2.0;
    // hovering the bar targets the box, not a row under it
    d.simInput(x, y0, false, 0.0);
    frame(&d);
    ok(d.hover == l && d.barOf == l, "the bar sits above the rows");
    // drag the thumb by a third of the free track
    d.simInput(x, y0, true, 0.0);
    frame(&d);
    ok(d.barNode == l, "pressing the thumb starts a drag");
    let free = ty - th.len;
    d.simInput(x, y0 + free / 3.0, true, 0.0);
    frame(&d);
    near(d.nodes.items[l].scrollY, bars.maxY / 3.0, 3.0, "dragging a third of the track scrolls a third");
    d.simInput(x, y0 + free * 5.0, true, 0.0);
    frame(&d);
    near(d.nodes.items[l].scrollY, bars.maxY, 0.5, "dragging past the end clamps");
    d.simInput(x, y0 + free * 5.0, false, 0.0);
    frame(&d);
    ok(d.barNode == -1 && PAGE_CLICKS == 0, "release ends the drag without a click");
    // a press on the track pages toward it
    d.nodes.items[l].scrollY = 0.0;
    frame(&d);
    click(&d, x, d.absY(l) + 90.0);
    near(d.nodes.items[l].scrollY, 90.0, 1.0, "a press on the track below the thumb pages down 90% of the view");
    let none = fresh(mem, css);
    ok(none.nodes.items[IDS.strip].scrollX == 0.0, "a fresh box starts at 0");
}

fn testLongList(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    ROWS = 4000;
    frame(&d);
    frame(&d);
    let l = IDS.list;
    near(d.nodes.items[l].scrollMax, f32(4000 * 20 - 100), 0.5, "a long list has its range");
    d.nodes.items[l].scrollY = 40000.0;
    frame(&d);
    let mid = 2500;
    // the row under the pointer is the right one even deep in the list
    d.simInput(cx(&d, l), d.absY(l) + 50.0, false, 0.0);
    frame(&d);
    let row = d.hover;
    ok(row >= 0 && d.nodes.items[row].parent == l, "hit testing finds a row of the long list");
    near(d.nodes.items[row].y, f32(40040), 21.0, "and it is the one at that offset");
    ok(d.laid > 0, "layout ran");
    // cost of a steady frame (build + layout + input, nothing changing) and of a scrolling one
    let t0 = micros();
    for k in 0..50 {
        frame(&d);
    }
    let steady = (micros() - t0) / 50;
    let t1 = micros();
    for k2 in 0..50 {
        d.simInput(cx(&d, l), cy(&d, l), false, -1.0);
        frame(&d);
    }
    let scrolling = (micros() - t1) / 50;
    printLn(`4000-row list, steady frame: {steady} us, scrolling frame: {scrolling} us   [dev build, no paint]`);
}

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}
