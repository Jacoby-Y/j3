// overlay_test: modal, backdrop, popover, placement, tooltip.

module overlay_test;

// ---- overlays --------------------------------------------------------------------------------------------

fn testModal(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    clickOn(&d, IDS.open);
    ok(SHOW_MODAL && d.ovs.len == 1, "the open button shows the dialog and it joins the stack");
    ok(d.nodes.items[IDS.modal].isFixed, "a dialog is placed in the viewport");
    near(d.nodes.items[IDS.modal].x, 200.0, 0.5, "and centered across");
    near(d.nodes.items[IDS.modal].y, 150.0, 0.5, "and down");
    frame(&d);
    ok(d.focused() == IDS.tb, "focus moves into the dialog");
    // the page behind takes no click
    let before = PAGE_CLICKS;
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before, "a click on the page behind a modal does nothing");
    ok(CLOSE_MODAL == 0, "and a modal does not close on an outside press");
    // Tab stays inside
    key(&d, "Tab");
    ok(d.focused() == IDS.ok, "Tab goes to the next control in the dialog");
    key(&d, "Tab");
    ok(d.focused() == IDS.cancel, "and the next");
    key(&d, "Tab");
    ok(d.focused() == IDS.tb, "then wraps inside the dialog");
    key(&d, "S+Tab");
    ok(d.focused() == IDS.cancel, "Shift+Tab wraps backwards inside it");
    // hover under the dim is none
    d.simInput(cx(&d, IDS.trig), cy(&d, IDS.trig), false, 0.0);
    frame(&d);
    ok(d.hover < 0, "nothing under the dim is hovered");
    // Escape closes only the top overlay
    SHOW_INNER_POP = true;
    frame(&d);
    ok(d.ovs.len == 2, "a popover over the modal is on top");
    key(&d, "Escape");
    ok(CLOSE_INNER == 1 && CLOSE_MODAL == 0, "Escape closes only the top layer");
    frame(&d);
    ok(d.ovs.len == 1, "that one has left the stack");
    key(&d, "Escape");
    ok(CLOSE_MODAL == 1 && !SHOW_MODAL, "the next Escape closes the dialog");
    frame(&d);
    ok(d.ovs.len == 0, "the stack is empty");
    ok(d.focused() == IDS.open, "focus goes back to the button that opened it");
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before + 1, "the page takes clicks again");
}

fn testBackdropAndRemoval(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    clickOn(&d, IDS.open);
    frame(&d);
    // the dialog's owner is removed with the dialog open: no stale stack entry, no stuck modal
    SHOW_MODAL = false;
    frame(&d);
    frame(&d);
    ok(d.ovs.len == 0 && dom.modalIndex(&d) < 0, "removing the dialog frees its stack slot");
    let before = PAGE_CLICKS;
    clickOn(&d, IDS.trig);
    ok(PAGE_CLICKS == before + 1, "and the page is live");
    // resize while a modal is open: it stays centered
    SHOW_MODAL = true;
    frame(&d);
    frame(&d);
    VW = 800.0;
    VH = 500.0;
    frame(&d);
    near(d.nodes.items[IDS.modal].x, 300.0, 0.5, "a resize recenters the modal across");
    near(d.nodes.items[IDS.modal].y, 200.0, 0.5, "and down");
    VW = 120.0;
    VH = 80.0;
    frame(&d);
    near(d.nodes.items[IDS.modal].x, 0.0, 0.01, "a window smaller than the dialog pins it to the top left");
    VW = 600.0;
    VH = 400.0;
    frame(&d);
    // the tree is rebuilt without the owner of a popover
    SHOW_MODAL = false;
    frame(&d);
    SHOW_POP = true;
    frame(&d);
    ok(d.ovs.len == 1, "a popover joins");
    SHOW_POP = false;
    frame(&d);
    frame(&d);
    ok(d.ovs.len == 0, "and leaves when its element goes");
}

fn testPopover(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    VH = 600.0;
    frame(&d);
    clickOn(&d, IDS.trig);
    ok(SHOW_POP && d.ovs.len == 1, "the trigger opens the popover");
    ok(d.nodes.items[IDS.menu].isFixed, "a popover is in viewport coordinates");
    near(d.nodes.items[IDS.menu].x, d.absX(IDS.anchor), 0.5, "below its anchor, left aligned");
    near(d.nodes.items[IDS.menu].y, d.absY(IDS.anchor) + 20.0, 0.5, "top: 100% is the anchor's height");
    // a press on the trigger belongs to the trigger: the toggle closes it, no dismissal first
    clickOn(&d, IDS.trig);
    ok(!SHOW_POP && CLOSE_POP == 0, "the trigger toggles it with no light dismiss");
    clickOn(&d, IDS.trig);
    ok(SHOW_POP, "open again");
    // a press elsewhere dismisses
    click(&d, 400.0, 300.0);
    ok(CLOSE_POP == 1 && !SHOW_POP, "a press outside asks it to close");
    // a press inside does not
    clickOn(&d, IDS.trig);
    ok(SHOW_POP, "open");
    click(&d, d.nodes.items[IDS.menu].x + 5.0, d.nodes.items[IDS.menu].y + 5.0);
    ok(SHOW_POP && CLOSE_POP == 1, "a press inside it keeps it open");
    key(&d, "Escape");
    ok(CLOSE_POP == 2 && !SHOW_POP, "Escape closes it");
    // a right press elsewhere dismisses too
    clickOn(&d, IDS.trig);
    d.simRight(true);
    d.simInput(500.0, 300.0, false, 0.0);
    frame(&d);
    d.simRight(false);
    frame(&d);
    ok(CLOSE_POP == 3, "a right press outside dismisses");
}

fn testPlacement(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    VH = 600.0;
    frame(&d);
    // right button on the pad: a context request with the pointer position
    let px = cx(&d, IDS.pad);
    let py = cy(&d, IDS.pad);
    d.simRight(true);
    d.simInput(px, py, false, 0.0);
    frame(&d);
    ok(CTX == 1 && SHOW_CTX, "a right press is a context request");
    d.simRight(false);
    frame(&d);
    let f = IDS.fx;
    near(d.nodes.items[f].x, px, 0.5, "the menu opens at the pointer");
    near(d.nodes.items[f].y, py, 0.5, "in x and y");
    // near the bottom right edge, flip-both puts it up and to the left of the pointer
    SHOW_CTX = false;
    VH = 400.0;
    frame(&d);
    CTX_X = 560.0;
    CTX_Y = 370.0;
    SHOW_CTX = true;
    frame(&d);
    frame(&d);
    near(d.nodes.items[IDS.fx].x, f32(480), 0.5, "past the right edge it flips to the left of the point");
    near(d.nodes.items[IDS.fx].y, f32(330), 0.5, "past the bottom edge it flips above the point");
    // clamp: a point past the edge keeps a popover on screen (no room to flip either way)
    VW = 70.0;
    VH = 30.0;
    frame(&d);
    ok(d.nodes.items[IDS.fx].x >= 0.0 && d.nodes.items[IDS.fx].y >= 0.0, "never off the top left");
    VW = 600.0;
    VH = 400.0;
    SHOW_CTX = false;
    frame(&d);
    // a position: fixed box ignores the ancestors' scroll and clip
    SHOW_FX = true;
    frame(&d);
    d.nodes.items[IDS.list].scrollY = 40.0;
    frame(&d);
        let fb = IDS.plain;
    ok(d.nodes.items[fb].isFixed, "a fixed box is in viewport coordinates");
    near(d.nodes.items[fb].x, 520.0, 0.01, "left=590 of an 80 px box is pulled back inside a 600 px window");
    near(d.nodes.items[fb].y, 360.0, 0.01, "and top=390 of a 40 px box inside 400");
}

fn testTooltip(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "no tooltip at first");
    for i in 0..20 {
        frame(&d);
    }
    ok(overlays.tipAlpha(&d) == 0.0, "and none before the delay");
    for k in 0..20 {
        frame(&d);
    }
    ok(overlays.tipAlpha(&d) > 0.0 && d.tipNode == IDS.open, "after 500 ms of rest the title shows");
    ok(same(d.tipOf(IDS.open), "Open it"), "with the title text");
    d.simInput(cx(&d, IDS.open) + 3.0, cy(&d, IDS.open), false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) > 0.0, "a small move keeps a tip that is showing");
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), true, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "a press hides it");
    d.simInput(cx(&d, IDS.open), cy(&d, IDS.open), false, 0.0);
    frame(&d);
    d.simInput(300.0, 300.0, false, 0.0);
    frame(&d);
    ok(overlays.tipAlpha(&d) == 0.0, "moving off an element ends its tip");
}
