// overlay_test: the shared test page, its state and event helpers.

module overlay_test;

// ---- the tree ------------------------------------------------------------------------------------------

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button, input, dialog { font-family: \"T\"; font-size: 14px; } .page { display: flex; flex-direction: column; gap: 4px; } .list { height: 100px; width: 200px; overflow-y: auto; } .smooth { scroll-behavior: smooth; } .row { height: 20px; } .strip { display: flex; width: 100px; height: 40px; overflow-x: auto; } .cell { width: 60px; min-width: 60px; height: 20px; } .outer { height: 80px; width: 200px; overflow-y: auto; } .inner { height: 40px; overflow-y: auto; } .contain { overscroll-behavior: contain; } .pad { height: 30px; } .anchor { position: relative; width: 90px; height: 20px; } .menu { position: absolute; left: 0; top: 100%; width: 80px; height: 60px; background: #333333; } .btn { width: 60px; height: 24px; } .fx { position: fixed; width: 80px; height: 40px; z-index: 5; } .flip { position: fixed; width: 80px; height: 40px; position-try-fallbacks: flip-both; } dialog { width: 200px; height: 100px; } .tb { width: 100px; height: 20px; }";

#[singleton]
let ROWS: int;

#[singleton]
let SHOW_MODAL: bool;

#[singleton]
let SHOW_POP: bool;

#[singleton]
let SHOW_CTX: bool;

#[singleton]
let SHOW_FX: bool;

#[singleton]
let SHOW_INNER_POP: bool;

#[singleton]
let CLOSE_MODAL: int;

#[singleton]
let CLOSE_POP: int;

#[singleton]
let CLOSE_CTX: int;

#[singleton]
let CLOSE_INNER: int;

#[singleton]
let PAGE_CLICKS: int;

#[singleton]
let CTX: int;

#[singleton]
let VW: f32;

#[singleton]
let VH: f32;

#[singleton]
let SMOOTH: bool;

#[singleton]
let CTX_X: f32;

#[singleton]
let CTX_Y: f32;

struct Ids {
    list: int;
    strip: int;
    outer: int;
    inner: int;
    outer2: int;
    inner2: int;
    open: int;
    trig: int;
    anchor: int;
    menu: int;
    modal: int;
    tb: int;
    ok: int;
    cancel: int;
    ctx: int;
    fx: int;
    titled: int;
    inpop: int;
    pad: int;
    plain: int;
}

#[singleton]
let IDS: Ids;

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: VW, y: VH });
    inputs.begin(d);
    let ids = Ids { list: -1, strip: -1, outer: -1, inner: -1, outer2: -1, inner2: -1, open: -1, trig: -1, anchor: -1, menu: -1, modal: -1, tb: -1, ok: -1, cancel: -1, ctx: -1, fx: -1, titled: -1, inpop: -1, pad: -1, plain: -1 };
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    ids.list = d.open(0, d.tag("div"), 1);
    d.cls(ids.list, "list");
    if SMOOTH {
        d.cls(ids.list, "smooth");
    }
    for i in 0..ROWS {
        let r1 = d.open(i, d.tag("div"), 1);
        d.cls(r1, "row");
        d.close();
    }
    d.close();
    ids.strip = d.open(1, d.tag("div"), 1);
    d.cls(ids.strip, "strip");
    for j in 0..6 {
        let c1 = d.open(j, d.tag("div"), 1);
        d.cls(c1, "cell");
        d.close();
    }
    d.close();
    ids.outer = d.open(2, d.tag("div"), 1);
    d.cls(ids.outer, "outer");
    ids.inner = d.open(0, d.tag("div"), 1);
    d.cls(ids.inner, "inner");
    for k in 0..6 {
        let c2 = d.open(k, d.tag("div"), 1);
        d.cls(c2, "row");
        d.close();
    }
    d.close();
    for m in 0..6 {
        let c3 = d.open(1 + m, d.tag("div"), 1);
        d.cls(c3, "row");
        d.close();
    }
    d.close();
    ids.outer2 = d.open(3, d.tag("div"), 1);
    d.cls(ids.outer2, "outer");
    ids.inner2 = d.open(0, d.tag("div"), 1);
    d.cls(ids.inner2, "inner");
    d.cls(ids.inner2, "contain");
    for k2 in 0..6 {
        let c4 = d.open(k2, d.tag("div"), 1);
        d.cls(c4, "row");
        d.close();
    }
    d.close();
    for m2 in 0..6 {
        let c5 = d.open(1 + m2, d.tag("div"), 1);
        d.cls(c5, "row");
        d.close();
    }
    d.close();
    ids.open = d.open(4, d.tag("button"), 1);
    d.cls(ids.open, "btn");
    if d.clicked(ids.open) {
        SHOW_MODAL = true;
    }
    d.attrTitle(ids.open, "Open it");
    d.close();
    ids.anchor = d.open(5, d.tag("div"), 1);
    d.cls(ids.anchor, "anchor");
    ids.trig = d.open(0, d.tag("button"), 1);
    d.cls(ids.trig, "btn");
    if d.clicked(ids.trig) {
        PAGE_CLICKS += 1;
        SHOW_POP = !SHOW_POP;
    }
    d.close();
    if SHOW_POP {
        ids.menu = d.open(1, d.tag("div"), 1);
        d.cls(ids.menu, "menu");
        d.attrOverlay(ids.menu, dom.OV_POPOVER);
        if d.closeRequested(ids.menu) {
            CLOSE_POP += 1;
            SHOW_POP = false;
        }
        d.close();
    }
    d.close();
    ids.ctx = d.open(6, d.tag("div"), 1);
    d.cls(ids.ctx, "pad");
    if d.contextAt(ids.ctx) {
        CTX += 1;
        SHOW_CTX = true;
        let mp = d.mouseAt();
        CTX_X = mp.x;
        CTX_Y = mp.y;
    }
    d.close();
    ids.pad = ids.ctx;
    if SHOW_CTX {
        ids.fx = d.open(7, d.tag("div"), 1);
        d.cls(ids.fx, "flip");
        d.attrOverlay(ids.fx, dom.OV_POPOVER);
        d.attrLeft(ids.fx, CTX_X);
        d.attrTop(ids.fx, CTX_Y);
        if d.closeRequested(ids.fx) {
            CLOSE_CTX += 1;
            SHOW_CTX = false;
        }
        d.close();
    }
    if SHOW_FX {
        ids.plain = d.open(8, d.tag("div"), 1);
        d.cls(ids.plain, "fx");
        d.attrLeft(ids.plain, 590.0);
        d.attrTop(ids.plain, 390.0);
        d.close();
    }
    d.close();
    if SHOW_MODAL {
        ids.modal = d.open(1, d.tag("dialog"), 1);
        d.attrOverlay(ids.modal, dom.OV_MODAL);
        if d.closeRequested(ids.modal) {
            CLOSE_MODAL += 1;
            SHOW_MODAL = false;
        }
        ids.tb = d.open(0, d.tag("input"), 1);
        d.cls(ids.tb, "tb");
        d.attrType(ids.tb, "text");
        d.close();
        ids.ok = d.open(1, d.tag("button"), 1);
        d.cls(ids.ok, "btn");
        d.close();
        ids.cancel = d.open(2, d.tag("button"), 1);
        d.cls(ids.cancel, "btn");
        d.close();
        if SHOW_INNER_POP {
            ids.inpop = d.open(3, d.tag("div"), 1);
            d.cls(ids.inpop, "menu");
            d.attrOverlay(ids.inpop, dom.OV_POPOVER);
            if d.closeRequested(ids.inpop) {
                CLOSE_INNER += 1;
                SHOW_INNER_POP = false;
            }
            d.close();
        }
        d.close();
    }
    d.close();
    IDS = ids;
    d.layout();
    d.endFrame();
}

fn fresh(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    ROWS = 30;
    SHOW_MODAL = false;
    SHOW_POP = false;
    SHOW_CTX = false;
    SHOW_FX = false;
    SHOW_INNER_POP = false;
    CLOSE_MODAL = 0;
    CLOSE_POP = 0;
    CLOSE_CTX = 0;
    CLOSE_INNER = 0;
    PAGE_CLICKS = 0;
    CTX = 0;
    VW = 600.0;
    VH = 400.0;
    SMOOTH = false;
    frame(&d);
    frame(&d);
    return d;
}

fn cx(d: &Dom, id: int): f32 {
    return d.absX(id) + d.nodes.items[id].w / 2.0;
}

fn cy(d: &Dom, id: int): f32 {
    return d.absY(id) + d.nodes.items[id].h / 2.0;
}

fn at(d: &Dom, id: int) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0);
    frame(d);
}

fn click(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    frame(d);
    d.simInput(x, y, true, 0.0);
    frame(d);
    d.simInput(x, y, false, 0.0);
    frame(d);
}

fn clickOn(d: &Dom, id: int) {
    click(d, cx(d, id), cy(d, id));
}

/// `notches` forward (positive scrolls down) over the middle of `id`.
fn wheel(d: &Dom, id: int, notches: f32) {
    d.simInput(cx(d, id), cy(d, id), false, 0.0 - notches);
    frame(d);
}

fn key(d: &Dom, names: string) {
    d.simKeys("", names);
    frame(d);
}
