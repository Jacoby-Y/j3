// overlay_test: runtime popups (colors, hover, keys).

module overlay_test;

// ---- tooltip and color runtime trees (023/3b) ----------------------------------------------------------

#[singleton]
let P_SHOW: bool;

#[singleton]
let P_MODAL: bool;

#[singleton]
let P_W: f32;

#[singleton]
let P_IDS: [4]int;

#[singleton]
let P_TEXT: string;

#[singleton]
let P_COLOR: string;

const PSHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } .page { font-family: \"T\"; font-size: 14px; color: #cdd6f4; } .tip { position: absolute; left: 350px; top: 20px; width: 100px; height: 30px; } .picker { position: absolute; left: 20px; top: 20px; width: 100px; height: 30px; } .selp { position: absolute; left: 200px; top: 20px; width: 100px; height: 30px; } dialog { width: 500px; height: 300px; } .page .j3-tooltip { width: 180px; padding: 8px 12px; box-shadow: 0 4px 12px #000000; } .page .j3-color-panel { width: 250px; padding: 14px; box-shadow: 0 8px 16px #000000; } .page .j3-color-sv { height: 100px; } :root { --j3-tooltip-delay: 0ms; }";

fn pframe(d: &Dom) {
    d.beginFrame(Vec2 { x: P_W, y: 400.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("j3-page"), 1);
    d.cls(page, "page");
    if P_MODAL {
        let modal = d.open(0, d.tag("dialog"), 1);
        d.attrOverlay(modal, dom.OV_MODAL);
        P_IDS[3] = modal;
    }
    if P_SHOW {
        let co = d.open(1, d.tag("input"), 1);
        d.cls(co, "picker");
        d.attrType(co, "color");
        if d.changed(co) { P_COLOR = d.strValue(co); }
        d.attrText(co, P_COLOR);
        P_IDS[0] = co;
        d.close();
        let tip = d.open(2, d.tag("button"), 1);
        d.cls(tip, "tip");
        d.attrTitle(tip, P_TEXT);
        d.text("Hover here");
        P_IDS[1] = tip;
        d.close();
        let sel = d.open(3, d.tag("select"), 1);
        d.cls(sel, "selp");
        let opt = d.open(0, d.tag("option"), 1);
        d.text("One");
        d.close();
        P_IDS[2] = sel;
        d.close();
    }
    if P_MODAL { d.close(); }
    d.close();
    d.layout();
    dropdown.settle(d);
    overlays.settleTip(d);
    d.endFrame();
}

fn pframes(d: &Dom, n: int) { for i in 0..n { pframe(d); } }

fn pclick(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0); pframe(d);
    d.simInput(x, y, true, 0.0); pframe(d);
    d.simInput(x, y, false, 0.0); pframes(d, 3);
}

fn pkey(d: &Dom, key: string) { d.simKeys("", key); pframes(d, 2); }

fn phover(d: &Dom) { d.simInput(cx(d, P_IDS[1]), cy(d, P_IDS[1]), false, 0.0); pframes(d, 12); }

/// Verify effective color slots, not merely the retained RGB cache on the nodes.
fn pcolors(d: &Dom, when: string) {
    let sq = d.nodes.items[d.ptRoot].first;
    let bar = d.nodes.items[sq].next;
    let handle = d.nodes.items[bar].first;
    let preview = d.nodes.items[d.nodes.items[bar].next].first;
    let hue = colorpick.fromHsv(d.pop.hsv.h, 1.0, 1.0) * 256 + 255;
    let rgb = colorpick.fromHsv(d.pop.hsv.h, d.pop.hsv.s, d.pop.hsv.v) * 256 + 255;
    ok(dom.colorOf(d, d.nodes.items[sq].style, P_BACKGROUND) == hue, `SV hue survives {when}`);
    ok(dom.colorOf(d, d.nodes.items[handle].style, P_BACKGROUND) == hue, `hue handle fill survives {when}`);
    ok(dom.colorOf(d, d.nodes.items[preview].style, P_BACKGROUND) == rgb, `preview fill survives {when}`);
}

fn testRuntimePopups(mem: &Arena) {
    let css = Css.new(mem);
    uastyle.load(&css);
    parse(&css, PSHEET, "popups.css", 1);
    ok(css.warns.len == 0, "popup theme and UA parse cleanly");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    P_W = 600.0; P_SHOW = true; P_MODAL = false; P_COLOR = "#ff0000";
    P_TEXT = "A long title wraps across several lines, preserving explicit\nnewlines and breaking SupercalifragilisticexpialidociousSupercalifragilisticexpialidocious.";
    pframes(&d, 3);
    let base = d.count();
    phover(&d);
    let tip = d.ttRoot;
    ok(tip >= 0 && hasClass(&d, tip, "j3-tooltip") && d.nodes.items[tip].parent == P_IDS[1], "title builds a separate real subtree under its owner");
    ok(d.nodes.items[d.nodes.items[tip].first].kind == dom.K_TEXT, "tooltip contains ordinary text");
    near(d.nodes.items[tip].w, 180.0, 0.5, "component ancestor selector sets tooltip width");
    ok(d.nodes.items[tip].h > 90.0 && d.css.get(d.nodes.items[tip].style, P_BOX_SHADOW).kind == V_SHADOW, "long title wraps and ordinary shadow applies");
    let fr = d.nodes.items[tip].frag0;
    let lines = 0;
    while fr >= 0 {
        ok(d.frags.items[fr].w <= 154.5, "wrapped text stays inside tooltip padding");
        lines += 1; fr = d.frags.items[fr].next;
    }
    ok(lines > 4, "text fragments include wrapped lines");
    let used = mem.used; let laid = d.laid; let styled = d.restyled;
    pframes(&d, 100);
    ok(mem.used == used && d.laid == laid && d.restyled == styled, "steady tooltip: no arena growth, layouts or restyles");
    d.attrDisabled(P_IDS[1], true); phover(&d);
    ok(d.ttRoot == tip, "a disabled owner retains its title like the painted tooltip did");
    d.attrDisabled(P_IDS[1], false);
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), true, 0.0); pframe(&d);
    let root = d.ptRoot;
    let initialSq = d.nodes.items[root].first;
    let initialMark = d.nodes.items[initialSq].last;
    near(d.nodes.items[initialMark].x + d.nodes.items[initialMark].w * 0.5, d.nodes.items[initialSq].w, 0.01, "marker is correctly placed on the first opening frame");
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), false, 0.0); pframes(&d, 3);
    ok(root >= 0 && hasClass(&d, root, "j3-color-panel") && d.ttRoot < 0, "color opens as real nodes and press hides tooltip");
    near(d.nodes.items[root].w, 250.0, 0.5, "color panel accepts themed width");
    ok(d.css.get(d.nodes.items[root].style, P_BOX_SHADOW).kind == V_SHADOW, "color panel accepts ordinary shadow");
    let sq = d.nodes.items[root].first;
    let bar = d.nodes.items[sq].next;
    near(d.nodes.items[sq].w, 220.0, 0.5, "SV area follows themed panel padding and width");
    near(d.nodes.items[sq].h, 100.0, 0.5, "SV area accepts themed height");
    ok(hasClass(&d, sq, "j3-color-sv") && hasClass(&d, bar, "j3-color-hue"), "square and hue bar are real children");
    let focus = d.focus;
    pclick(&d, d.absX(sq) + d.nodes.items[sq].w * 0.5, d.absY(sq));
    ok(same(P_COLOR, "#ff8080") && d.focus == focus, "themed SV hit area picks color without taking focus");
    pclick(&d, d.absX(bar) + d.nodes.items[bar].w * 0.5, cy(&d, bar));
    ok(same(P_COLOR, "#80ffff"), "themed hue hit area picks hue");
    P_COLOR = "#0000ff"; pframes(&d, 4);
    ok(d.pop.hsv.h > 239.0 && d.pop.hsv.h < 241.0, "program color changes update the open subtree");
    d.restyle(); pframes(&d, 3);
    pcolors(&d, "direct restyle");
    css.reset(); uastyle.load(&css); parse(&css, PSHEET, "popups.css", 1);
    d.restyle(); pframes(&d, 3);
    pcolors(&d, "CSS reset/reload");
    P_COLOR = "#804020"; pframes(&d, 3);
    pcolors(&d, "a live color update after reload");
    P_COLOR = "#0000ff"; pframes(&d, 3);
    parse(&css, ".page .j3-color-panel { width: 280px; padding: 20px; } .page .j3-color-marker { width: 20px; height: 18px; } .page .j3-color-handle { width: 22px; }", "resize.css", 1);
    d.restyle(); pframe(&d);
    let resizedMark = d.nodes.items[sq].last;
    let resizedHandle = d.nodes.items[bar].first;
    near(d.nodes.items[resizedMark].x + d.nodes.items[resizedMark].w * 0.5, d.pop.hsv.s * d.nodes.items[sq].w, 0.01, "resize and themed marker width are reflected in the same frame");
    near(d.nodes.items[resizedHandle].x + d.nodes.items[resizedHandle].w * 0.5, d.pop.hsv.h / 359.9 * d.nodes.items[bar].w, 0.01, "themed hue handle stays centered on its value");
    d.simInput(cx(&d, sq), cy(&d, sq), true, 0.0); pframe(&d);
    ok(d.pop.drag == 1, "SV shade child starts the square drag");
    d.simInput(d.absX(sq) + d.nodes.items[sq].w + 100.0, d.absY(sq) - 100.0, true, 0.0); pframe(&d);
    ok(d.pop.hsv.s == 1.0 && d.pop.hsv.v == 1.0 && d.pop.kind == popup.COLOR, "drag outside the square clamps and keeps the panel open");
    d.simInput(-5.0, -5.0, false, 0.0); pframe(&d);
    ok(d.pop.drag == 0, "release outside ends the drag");
    phover(&d);
    ok(d.ttRoot >= 0 && d.ptRoot == root && d.pop.kind == popup.COLOR, "tooltip coexists with color panel without replacing its slot");
    d.simInput(cx(&d, P_IDS[0]), cy(&d, P_IDS[0]), false, 0.0); pframes(&d, 2);
    ok(d.ttRoot < 0 && d.ptRoot == root, "crossing back to an untitled popup owner drops only the tooltip");
    d.simInput(cx(&d, sq), cy(&d, sq), false, 0.0); pframes(&d, 2);
    ok(d.ttRoot < 0 && d.ptRoot == root, "crossing a popup child keeps the input subtree intact");
    phover(&d);
    let used2 = mem.used; let laid2 = d.laid; let styled2 = d.restyled;
    pframes(&d, 100);
    ok(mem.used == used2 && d.laid == laid2 && d.restyled == styled2, "steady color plus tooltip: no arena growth, layouts or restyles");
    pkey(&d, "Escape");
    ok(d.ptRoot < 0 && d.ttRoot >= 0 && d.focus == focus, "Escape removes color subtree and keeps passive tooltip/focus");
    pclick(&d, cx(&d, P_IDS[2]), cy(&d, P_IDS[2]));
    let select = d.ptRoot;
    phover(&d);
    ok(d.ttRoot >= 0 && d.ptRoot == select && d.pop.kind == popup.SELECT, `tooltip coexists with select list (tip {d.ttRoot}, popup {d.ptRoot}, expected {select}, kind {d.pop.kind}, hover {d.hover})`);
    pkey(&d, "Enter");
    ok(d.ptRoot < 0 && d.pop.kind == popup.NONE, "select keyboard still picks beside tooltip");
    parse(&css, ".page .j3-tooltip { width: auto; }", "auto.css", 1);
    d.restyle(); pframes(&d, 4);
    near(d.nodes.items[d.ttRoot].w, 320.0, 0.5, "auto-width tooltip wraps at the default 320px cap after restyle");
    parse(&css, ".tip { left: 10px; }", "narrow.css", 1); d.restyle();
    P_W = 160.0; pframes(&d, 2); phover(&d);
    // Pointer and trigger must stay in the resized viewport for the tip to remain eligible.
    ok(d.nodes.items[d.ttRoot].w <= 152.5 && d.nodes.items[d.ttRoot].x >= 4.0, "auto-width tooltip clamps to a narrow viewport");
    parse(&css, ".tip { left: 350px; }", "wide.css", 1); d.restyle();
    P_W = 600.0; P_TEXT = "short\nnext"; pframes(&d, 2); phover(&d);
    ok(d.nodes.items[d.ttRoot].w < 100.0 && d.nodes.items[d.ttRoot].h < 65.0, "title updates shrink the real text box and preserve newlines");
    let utfTitle = "é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界é世界\nmore UTF-8 text";
    P_TEXT = utfTitle; pframes(&d, 3);
    let utfFrag = d.nodes.items[d.ttRoot].frag0;
    let validUtf = true;
    while utfFrag >= 0 {
        let f = &d.frags.items[utfFrag];
        if f.start < utfTitle.len && utfTitle[f.start] >= 128 && utfTitle[f.start] < 192 { validUtf = false; }
        if f.end < utfTitle.len && utfTitle[f.end] >= 128 && utfTitle[f.end] < 192 { validUtf = false; }
        utfFrag = f.next;
    }
    ok(validUtf && d.nodes.items[d.ttRoot].h > 60.0, "wrapped UTF-8 fragments start and end on code point boundaries");
    for i in 0..20 { P_TEXT = if i % 2 == 0 { utfTitle } else { "short\nnext" }; pframes(&d, 3); }
    let titleUsed = mem.used;
    for i in 0..1000 { P_TEXT = if i % 2 == 0 { utfTitle } else { "short\nnext" }; pframes(&d, 3); }
    ok(mem.used == titleUsed, "1000 updates while shown reuse tooltip text and fragment buffers");
    P_TEXT = ""; pframes(&d, 3);
    ok(d.ttRoot < 0, "clearing a title destroys its tooltip");
    P_TEXT = "Restored tooltip"; phover(&d);
    P_SHOW = false; pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.tipNode < 0, "removing tooltip owner destroys its subtree");
    P_SHOW = true; P_MODAL = true; pframes(&d, 4);
    pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0]));
    phover(&d);
    ok(d.ptRoot >= 0 && d.ttRoot >= 0 && d.focus == P_IDS[0], "color and tooltip coexist in a modal without stealing focus");
    d.attrTitle(0, "Outside modal");
    d.simInput(590.0, 390.0, false, 0.0); pframes(&d, 12);
    ok(d.ttRoot < 0 && d.tipNode < 0 && d.ptRoot >= 0, "a title behind a modal cannot show through its input filter");
    d.attrTitle(0, "");
    pkey(&d, "Escape");
    ok(d.ptRoot < 0 && d.ovs.len == 1 && !d.closeRequested(P_IDS[3]), "Escape closes color before modal");
    pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0]));
    P_SHOW = false; pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.pop.kind == popup.NONE, "removing color owner destroys panel and clears drag state");
    P_MODAL = false; P_SHOW = true; pframes(&d, 3);
    // Warm node/style/fragment pools, then repeat the same open/close cycles.
    for i in 0..20 { pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0])); phover(&d); pkey(&d, "Escape"); }
    let steady = mem.used;
    let count = d.count();
    for i in 0..1000 { pclick(&d, cx(&d, P_IDS[0]), cy(&d, P_IDS[0])); phover(&d); pkey(&d, "Escape"); }
    ok(mem.used == steady && d.count() == count, "1000 reopen/close cycles reuse popup nodes/styles/text without arena growth");
    d.simInput(-5.0, -5.0, false, 0.0); pframes(&d, 2);
    ok(d.ptRoot < 0 && d.ttRoot < 0 && d.count() == base, "closed popups leave no live runtime nodes");
}
