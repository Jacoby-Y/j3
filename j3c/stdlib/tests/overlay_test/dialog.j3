// overlay_test: dialog inputs.

module overlay_test;

// ---- dialog inputs: autoselect and the default button ----------------------------------------------------

#[singleton]
let D_OPEN: bool;

#[singleton]
let D_AUTO: bool;

#[singleton]
let D_SUB: bool;

#[singleton]
let D_DEF: bool;

#[singleton]
let D_DIS: bool;

#[singleton]
let D_NEST: bool;

#[singleton]
let D_NP: int;

#[singleton]
let D_SEL: bool;

#[singleton]
let D_PICK: int;

#[singleton]
let D_VAL: string;

#[singleton]
let D_P: int;

#[singleton]
let D_S: int;

#[singleton]
let D_SUBS: int;

#[singleton]
let D_IDS: [5]int;

fn dframe(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    if D_OPEN {
        let dlg = d.open(1, d.tag("dialog"), 1);
        d.attrOverlay(dlg, dom.OV_MODAL);
        if D_AUTO { d.attrFlag(dlg, 1); }
        let tb = d.open(0, d.tag("input"), 1);
        d.cls(tb, "tb");
        d.attrType(tb, "text");
        if D_SUB { d.attrFlag(tb, 2); }
        if d.changed(tb) { D_VAL = d.strValue(tb); }
        if d.submitted(tb) { D_SUBS += 1; }
        d.attrText(tb, D_VAL);
        d.close();
        let ta = d.open(1, d.tag("input"), 1);
        d.cls(ta, "tb");
        d.attrType(ta, "textarea");
        d.close();
        if D_NEST {
            let pp = d.open(5, d.tag("div"), 1);
            d.attrOverlay(pp, dom.OV_POPOVER);
            let nb = d.open(0, d.tag("button"), 1);
            d.cls(nb, "btn");
            d.cls(nb, "primary");
            if d.clicked(nb) { D_NP += 1; }
            d.close();
            d.close();
        }
        if D_SEL {
            let se = d.open(4, d.tag("select"), 1);
            for i in 0..3 {
                let o = d.open(i, d.tag("option"), 1);
                d.text(`Opt {i}`);
                d.close();
            }
            if d.changed(se) { D_PICK += 1; }
            d.close();
        }
        let pr = d.open(2, d.tag("button"), 1);
        d.cls(pr, "btn");
        d.cls(pr, "primary");
        d.attrDisabled(pr, D_DIS);
        if d.clicked(pr) { D_P += 1; }
        d.close();
        let sc = d.open(3, d.tag("button"), 1);
        d.cls(sc, "btn");
        if D_DEF { d.attrFlag(sc, 3); }
        if d.clicked(sc) { D_S += 1; }
        d.close();
        D_IDS[0] = tb;
        D_IDS[1] = ta;
        D_IDS[2] = pr;
        D_IDS[3] = sc;
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn dkey(d: &Dom, typed: string, names: string) {
    d.simKeys(typed, names);
    dframe(d);
    dframe(d);
}

fn dopen(mem: &Arena, css: &Css, val: string): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    D_OPEN = false;
    D_VAL = val;
    D_P = 0;
    D_S = 0;
    D_SUBS = 0;
    D_PICK = 0;
    dframe(&d);
    dframe(&d);
    D_OPEN = true;
    for i in 0..5 {
        dframe(&d);
    }
    return d;
}

fn testDialogInputs(mem: &Arena, css: &Css) {
    // autoselect: the box is focused with all its text selected, typing replaces it
    D_AUTO = true; D_SUB = false; D_DEF = false; D_DIS = false;
    let d = dopen(mem, css, "report.txt");
    let tb = D_IDS[0];
    ok(d.focused() == tb, "autoselect: the first text box has focus");
    let e = &d.eds.items[d.nodes.items[tb].edit];
    ok(e.anc == 0 && e.cur == 10, "autoselect: all the text is selected on open");
    dkey(&d, "x", "");
    ok(same(D_VAL, "x"), "typing replaces the selection");
    // a second focus by Tab does not select again
    dkey(&d, "", "S+Tab");
    dkey(&d, "", "Tab");
    ok(d.focused() == tb && !d.eds.items[d.nodes.items[tb].edit].hasSel(), "a later focus does not autoselect");
    // Enter in the box (no on:submit) clicks the primary button
    dkey(&d, "", "Enter");
    ok(D_P == 1 && D_S == 0, "Enter clicks button.primary");
    // without autoselect: caret at the end, no selection
    D_AUTO = false;
    let d2 = dopen(mem, css, "abc");
    ok(!d2.eds.items[d2.nodes.items[D_IDS[0]].edit].hasSel(), "no autoselect: nothing selected");
    // `default` wins over `.primary`
    D_DEF = true;
    let d3 = dopen(mem, css, "abc");
    dkey(&d3, "", "Enter");
    ok(D_S == 1 && D_P == 0, "a `default` button beats button.primary");
    // a disabled default does nothing, and does not fall through to primary
    D_DIS = true; D_DEF = false;
    let d4 = dopen(mem, css, "abc");
    dkey(&d4, "", "Enter");
    ok(D_P == 0 && D_S == 0, "a disabled primary button is not clicked");
    // on:submit keeps the key to itself
    D_DIS = false; D_SUB = true;
    let d5 = dopen(mem, css, "abc");
    dkey(&d5, "", "Enter");
    ok(D_SUBS == 1 && D_P == 0, "an input with on:submit submits and does not click the default");
    // a textarea takes Enter as a newline
    D_SUB = false;
    let d6 = dopen(mem, css, "abc");
    dkey(&d6, "", "Tab");
    ok(d6.focused() == D_IDS[1], "Tab reaches the textarea");
    dkey(&d6, "", "Enter");
    ok(D_P == 0 && d6.eds.items[d6.nodes.items[D_IDS[1]].edit].text.len() == 1, "textarea: Enter inserts a newline, no default click");
    // Enter on the primary button itself still clicks it once
    dkey(&d6, "", "Tab");
    ok(d6.focused() == D_IDS[2], "Tab reaches the primary button");
    dkey(&d6, "", "Enter");
    ok(D_P == 1, "Enter on a focused button clicks it once");
    // Enter queued for the very frame the dialog takes focus: on:submit is already known (set by the build that made the box)
    D_SUB = true;
    let d7 = dopen(mem, css, "abc");
    D_OPEN = false;
    dframe(&d7);
    dframe(&d7);
    D_P = 0; D_SUBS = 0;
    D_OPEN = true;
    dframe(&d7);
    dkey(&d7, "", "Enter");
    ok(D_P == 0, "Enter right after the dialog is built never falls through to the default when on:submit exists");
    // an open select list takes Enter: it picks, the default button is not clicked
    D_SUB = false; D_SEL = true;
    let d8 = dopen(mem, css, "abc");
    dkey(&d8, "", "Tab");
    dkey(&d8, "", "Tab");
    ok(d8.pop.kind != popup.NONE || d8.focused() >= 0, "focus is on the select");
    dkey(&d8, "", "Enter");
    ok(d8.pop.kind != popup.NONE && D_P == 0, "Enter on a select opens its list, no default click");
    dkey(&d8, "", "Down");
    dkey(&d8, "", "Enter");
    ok(D_PICK == 1 && D_P == 0 && d8.pop.kind == popup.NONE, "Enter in the open list picks the option and does not click the default button");
    D_SEL = false;
    // a popover nested in the dialog is another layer: its .primary is not the dialog's default
    D_NEST = true; D_NP = 0;
    let d9 = dopen(mem, css, "abc");
    dkey(&d9, "", "Enter");
    D_NEST = false;
    ok(D_P == 1 && D_NP == 0, "the default button search skips nested overlays");
}
