// Nested stacking contexts (`dom/stack.j3`): paint order and hit order for the classic cases, rebuild counters. Needs GL, no visible window:
// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/stacking_test.j3 --headless
module stacking_test;

use j3.game;
use j3.game.Color;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, OV_POPOVER };
use j3.ui.sticky;

#[singleton]
let CHECKS: int;

const W: int = 1340;
const H: int = 260;

/// Scenario `k` sits in the 120 px cell at `130 * k` (`.sc` is a context of its own, so the scenarios never meet).
const SHEET: string = ".stage { display: block; width: 1340px; height: 260px; } .sc { position: absolute; top: 0; width: 120px; height: 120px; z-index: 0; } .box { position: absolute; } .k0 { left: 0; } .k1 { left: 130px; } .k2 { left: 260px; } .k3 { left: 390px; } .k4 { left: 520px; } .k5 { left: 650px; } .k6 { left: 780px; } .k7 { left: 910px; } .k8 { left: 1040px; } .k9 { left: 1170px; } .red { background: #ff0000; } .green { background: #00ff00; } .blue { background: #0000ff; } .yellow { background: #ffff00; } .gray { background: #888888; } .pink { background: #ff00ff; } .c1 { left: 0; top: 0; width: 70px; height: 70px; z-index: 1; } .inn { left: 30px; top: 30px; width: 70px; height: 70px; z-index: 9999; } .c2 { left: 50px; top: 0; width: 70px; height: 70px; z-index: 2; } .pb { left: 0; top: 0; width: 100px; height: 100px; z-index: 0; } .negc { left: 20px; top: 20px; width: 60px; height: 60px; z-index: -1; } .flowc { display: block; margin: 40px 0 0 40px; width: 30px; height: 30px; } .oc { left: 0; top: 0; width: 100px; height: 100px; opacity: 0.999; } .tc { left: 0; top: 0; width: 100px; height: 100px; transform: translate(1px, 0); } .ic { left: 0; top: 0; width: 100px; height: 100px; isolation: isolate; } .ci { left: 0; top: 0; width: 70px; height: 70px; z-index: 5; } .cs { left: 40px; top: 40px; width: 60px; height: 60px; z-index: 3; } .fc { left: 0; top: 0; width: 60px; height: 60px; overflow: hidden; } .fx { position: fixed; left: 690px; top: 200px; width: 30px; height: 30px; } .hi { left: 0; top: 0; width: 70px; height: 70px; z-index: 99999; } .pop { width: 50px; height: 50px; } .row { position: absolute; left: 0; top: 0; display: flex; width: 120px; height: 60px; } .it { width: 50px; height: 50px; margin-right: -30px; } .frow { position: absolute; left: 0; top: 0; display: flex; width: 120px; height: 60px; } .fi { width: 50px; height: 50px; margin-right: -30px; } .fz { z-index: 2; } .tr1 { left: 0; top: 80px; width: 20px; height: 20px; color: #000000; transition: color 10s linear; } .tr2 { left: 30px; top: 80px; width: 20px; height: 20px; opacity: 1; transition: opacity 10s linear; } .tr1.on { color: #ffffff; } .tr2.on { opacity: 0.2; } .z3 { z-index: 3; } .pe1 { left: 0; top: 0; width: 70px; height: 70px; z-index: 1; } .pe2 { left: 20px; top: 20px; width: 70px; height: 70px; z-index: 2; pointer-events: none; } .k10 { left: 0; top: 130px; } .k11 { left: 130px; top: 130px; } .k12 { left: 260px; top: 130px; } .k13 { left: 390px; top: 130px; } .k14 { left: 520px; top: 130px; } .k15 { left: 1040px; top: 130px; } .s2 { display: block; width: 60px; height: 60px; overflow: auto; } .rel { position: relative; display: block; width: 20px; height: 20px; } .md { left: 0; top: 20px; width: 120px; height: 80px; z-index: 100; } .ss { position: absolute; left: 0; top: 0; width: 60px; height: 60px; overflow: auto; } .st { position: sticky; top: 0; display: block; width: 40px; height: 10px; } .sb { position: absolute; left: 0; top: 0; width: 60px; height: 60px; overflow: auto; } .sbo { position: absolute; left: 0; top: 0; width: 110px; height: 110px; overflow: auto; } .sbi { position: relative; display: block; margin: 10px; width: 70px; height: 70px; overflow: auto; } .tall { display: block; width: 40px; height: 300px; } .szc { left: 10px; top: 40px; width: 80px; height: 80px; z-index: 10; } .szs { left: 30px; top: 30px; width: 80px; height: 80px; z-index: 5; } .zc2 { left: 0; top: 0; width: 100px; height: 100px; z-index: 10; } .zs2 { left: 0; top: 0; width: 120px; height: 120px; z-index: 5; } .rw { left: 0; top: 0; width: 120px; height: 120px; transform: rotate(30deg); } .rsb { position: absolute; left: 0; top: 0; width: 60px; height: 40px; overflow: auto; } .rzc { left: 0; top: 0; width: 100px; height: 100px; z-index: 10; } .rzs { left: 0; top: 0; width: 100px; height: 100px; z-index: 5; }";

// node ids by name, filled by `build`
const NA1: int = 0;
const NAINN: int = 1;
const NA2: int = 2;
const NBPAR: int = 3;
const NBNEG: int = 4;
const NBFLOW: int = 5;
const NC0: int = 6; // container, then inner, then sibling: C, D, E use 6..14
const NFX: int = 15;
const NHI: int = 16;
const NPOP: int = 17;
const NIT0: int = 18; // three flex items
const NPE1: int = 21;
const NPE2: int = 22;
const NSTAGE: int = 23;
const NFC: int = 24;
const NFI0: int = 25; // two flex items
const NTR1: int = 27;
const NTR2: int = 28;
const NSB: int = 29; // scroll box, its z 10 child, the z 5 sibling
const NSBZC: int = 30;
const NSBZS: int = 31;
const NSBO: int = 32; // nested: outer, inner, z 10 child, z 5 sibling
const NSBI: int = 33;
const NZC2: int = 34;
const NZS2: int = 35;
const NRW: int = 36; // rotated wrapper, scroll box, z 10 child, z 5 sibling
const NRSB: int = 37;
const NRZC: int = 38;
const NRZS: int = 39;
const NMSB: int = 40; // modal over a scroller: the scroller, its z 10 child, the z 100 modal
const NMZC: int = 41;
const NMD: int = 42;
const NSS: int = 43; // sticky header in a scroller
const NSST: int = 44;
const NTALL: int = 45; // the scrollers' filler boxes (only the last is kept)
const NS2: int = 46; // a static scroller with a plain positioned child
const NS2R: int = 47;
const NIDS: int = 48;

#[singleton]
let IDS: [48]int;
#[singleton]
let ANIM: bool;
#[singleton]
let HOOKS: [2]int;

fn hookA(p: ptr) {
    HOOKS[0] += 1;
}

fn hookB(p: ptr) {
    HOOKS[1] += 1;
}

fn canvasFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
    let c = d.open(0, d.tag("canvas"), 1);
    d.styleStr(c, 0, "width", "40px");
    d.styleStr(c, 1, "height", "40px");
    d.close();
    d.layout();
    d.paintAll();
    d.endFrame();
}

#[singleton]
let TWEAK: bool;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn channel(p: []u8, x: int, y: int, c: int): int {
    return int(p[(y * W + x) * 4 + c]);
}

/// The pixel at `(x, y)` is the color `(r, g, b)`.
fn pixel(p: []u8, x: int, y: int, r: int, g: int, b: int, msg: string) {
    CHECKS += 1;
    let dr = channel(p, x, y, 0) - r;
    let dg = channel(p, x, y, 1) - g;
    let db = channel(p, x, y, 2) - b;
    if dr < -3 || dr > 3 || dg < -3 || dg > 3 || db < -3 || db > 3 {
        printLn(`FAIL: {msg}: ({channel(p, x, y, 0)}, {channel(p, x, y, 1)}, {channel(p, x, y, 2)}), expected ({r}, {g}, {b})`);
        panic(msg);
    }
}

fn box(d: &Dom, slot: int, cls: string, name: int): int {
    let id = d.open(slot, d.tag("div"), 1);
    d.clsDyn(id, cls);
    IDS[name] = id;
    return id;
}

/// One scenario cell: a context holding the boxes of `body`.
fn cell(d: &Dom, slot: int, k: int): int {
    let sc = d.open(slot, d.tag("div"), 1);
    d.clsDyn(sc, `sc k{k}`);
    return sc;
}

fn build(d: &Dom) {
    let stage = box(d, 0, "stage", NSTAGE);
    // 0: a z-index 9999 inside a z-index 1 card stays under a z-index 2 sibling card
    cell(d, 0, 0);
    box(d, 0, if TWEAK { "box c1 red z3" } else { "box c1 red" }, NA1);
    box(d, 0, "box inn blue", NAINN);
    d.close();
    d.close();
    box(d, 1, "box c2 green", NA2);
    d.close();
    d.close();
    // 1: negative z-index is above the context's background, under its in-flow content
    cell(d, 1, 1);
    box(d, 0, "box pb yellow", NBPAR);
    box(d, 0, "box negc red", NBNEG);
    d.close();
    box(d, 1, "flowc blue", NBFLOW);
    d.close();
    d.close();
    d.close();
    // 2, 3, 4: opacity, transform and isolation each make a context: z-index 5 inside it is under the sibling's z-index 3
    for q in 0..3 {
        cell(d, 2 + q, 2 + q);
        box(d, 0, if q == 0 { "box oc" } else if q == 1 { "box tc" } else { "box ic" }, NC0 + q * 3);
        box(d, 0, "box ci red", NC0 + q * 3 + 1);
        d.close();
        d.close();
        box(d, 1, "box cs green", NC0 + q * 3 + 2);
        d.close();
        d.close();
    }
    // 5: a fixed box escapes the overflow clip of its parent
    cell(d, 5, 5);
    box(d, 0, "box fc gray", NFC);
    box(d, 0, "fx pink", NFX);
    d.close();
    d.close();
    d.close();
    // 6: an overlay is above z-index 99999
    cell(d, 6, 6);
    box(d, 0, "box hi red", NHI);
    d.close();
    d.close();
    let pop = box(d, 7, "pop blue", NPOP);
    d.attrOverlay(pop, OV_POPOVER);
    d.attrLeft(pop, 790.0);
    d.attrTop(pop, 10.0);
    d.close();
    // 7: `order` is the paint order of flex items
    cell(d, 8, 7);
    box(d, 0, "row", NSTAGE);
    let a = box(d, 0, "it red", NIT0);
    d.styleNum(a, 0, "order", 2.0);
    d.close();
    let b = box(d, 1, "it green", NIT0 + 1);
    d.styleNum(b, 0, "order", 1.0);
    d.close();
    let c = box(d, 2, "it blue", NIT0 + 2);
    d.styleNum(c, 0, "order", 0.0);
    d.close();
    d.close();
    d.close();
    // 8: pointer-events: none does not hide what is under it from the pointer, it still paints
    cell(d, 9, 8);
    box(d, 0, "box pe1 green", NPE1);
    d.close();
    box(d, 1, "box pe2 red", NPE2);
    d.close();
    d.close();
    d.close();
    // 9: `z-index` counts on a flex item without `position`; a color transition does not make a context, an opacity one does
    cell(d, 10, 9);
    box(d, 0, "frow", NSTAGE);
    box(d, 0, "fi fz red", NFI0);
    d.close();
    box(d, 1, "fi green", NFI0 + 1);
    d.close();
    d.close();
    let t1 = box(d, 1, "box tr1", NTR1);
    d.clsIf(t1, "on", ANIM);
    d.close();
    let t2 = box(d, 2, "box tr2", NTR2);
    d.clsIf(t2, "on", ANIM);
    d.close();
    d.close();
    // 10: a z-index 10 box inside a scroll box (no context) is above a z-index 5 sibling of the scroll box, still clipped and scrolled by it
    cell(d, 11, 10);
    box(d, 0, "sb yellow", NSB);
    box(d, 0, "tall gray", NTALL);
    d.close();
    box(d, 1, "box szc blue", NSBZC);
    d.close();
    d.close();
    box(d, 1, "box szs green", NSBZS);
    d.close();
    d.close();
    // 11: nested scroll boxes; the inner one clips its z-index 10 child
    cell(d, 12, 11);
    box(d, 0, "sbo yellow", NSBO);
    box(d, 0, "sbi gray", NSBI);
    box(d, 0, "tall yellow", NTALL);
    d.close();
    box(d, 1, "box zc2 red", NZC2);
    d.close();
    d.close();
    d.close();
    box(d, 1, "box zs2 green", NZS2);
    d.close();
    d.close();
    // 12: the scroll box sits in a rotated context, so its clip is a shape that is pushed again for the z-index child
    cell(d, 13, 12);
    box(d, 0, "box rw gray", NRW);
    box(d, 0, "rsb yellow", NRSB);
    box(d, 0, "tall gray", NTALL);
    d.close();
    box(d, 1, "box rzc blue", NRZC);
    d.close();
    d.close();
    box(d, 1, "box rzs green", NRZS);
    d.close();
    d.close();
    d.close();
    // 13: a modal with z-index 100 over a scroller with a z-index 10 child: bars and child are under it
    cell(d, 14, 13);
    box(d, 0, "sb yellow", NMSB);
    box(d, 0, "tall gray", NTALL);
    d.close();
    box(d, 1, "box szc blue", NMZC);
    d.close();
    d.close();
    box(d, 1, "box md red", NMD);
    d.close();
    d.close();
    // 14: a sticky header in a scroller stays at its top
    cell(d, 15, 14);
    box(d, 0, "ss yellow", NSS);
    box(d, 0, "st red", NSST);
    d.close();
    box(d, 1, "tall gray", NTALL);
    d.close();
    d.close();
    d.close();
    // 15: nothing but a plain positioned box inside a scroller: the scroller stays a context, one walk (`onlyInScrollers`)
    cell(d, 16, 15);
    box(d, 0, "s2 yellow", NS2);
    box(d, 0, "rel blue", NS2R);
    d.close();
    box(d, 1, "tall gray", NTALL);
    d.close();
    d.close();
    d.close();
    d.close();
}

fn frame(d: &Dom, px: f32, py: f32, pixels: []u8) {
    game.clearTo(Color { r: 0, g: 0, b: 0, a: 255 });
    d.simInput(px, py, false, 0.0);
    d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
    build(d);
    d.layout();
    sticky.step(d);
    d.paintAll();
    d.endFrame();
    ok(game.readWindow(pixels), "read the frame");
}

/// Move the pointer to `(x, y)` (two frames: the hit test reads the last layout), check the pixel there and the box it hits.
fn at(d: &Dom, pixels: []u8, x: int, y: int, r: int, g: int, b: int, hit: int, msg: string) {
    frame(d, f32(x), f32(y), pixels);
    frame(d, f32(x), f32(y), pixels);
    pixel(pixels, x, y, r, g, b, `paint: {msg}`);
    ok(d.hover == IDS[hit], `hit: {msg}`);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    game.initGlHidden("stacking contexts", W, H);
    let css = Css.new(&mem);
    parse(&css, SHEET, "stacking.css", 1);
    ok(css.warns.len == 0, "fixture CSS parses");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    let pixels = mem.alloc::<u8>(W * H * 4);
    frame(&d, -10.0, -10.0, pixels);
    frame(&d, -10.0, -10.0, pixels);
    // the lists: the cell's entries are its z-indexed boxes in key order, and the inner box of a context is not one of them
    let sc0 = d.nodes.items[IDS[NA1]].parent;
    ok(d.nodes.items[sc0].ctx && d.nodes.items[sc0].zc == 2, "a z-indexed cell lists its two cards, not the inner box");
    ok(d.zl.items[d.nodes.items[sc0].zs].v == IDS[NA1] && d.zl.items[d.nodes.items[sc0].zs + 1].v == IDS[NA2], "entries in ascending z-index");
    ok(d.nodes.items[IDS[NA1]].ctx && d.nodes.items[IDS[NA1]].zc == 1, "a z-indexed card is a context with the inner box as its entry");
    let sc1 = d.nodes.items[IDS[NBPAR]].parent;
    ok(d.nodes.items[IDS[NBPAR]].zneg == 1 && d.nodes.items[IDS[NBPAR]].zc == 1 && sc1 >= 0, "a negative z-index is counted as below the in-flow content");
    ok(!d.nodes.items[IDS[NBFLOW]].lift, "in-flow content is not lifted");
    ok(d.nodes.items[IDS[NC0 + 3]].ctx && d.nodes.items[IDS[NC0 + 6]].ctx && d.nodes.items[IDS[NC0]].ctx, "opacity, transform and isolation make contexts");

    // 0: nested z-index
    at(&d, pixels, 60, 40, 0, 255, 0, NA2, "z-index 9999 inside a z-index 1 card is under the z-index 2 card");
    at(&d, pixels, 10, 10, 255, 0, 0, NA1, "the card alone");
    at(&d, pixels, 40, 90, 0, 0, 255, NAINN, "the inner box outside the sibling");
    // 1: negative z-index
    at(&d, pixels, 130 + 5, 5, 255, 255, 0, NBPAR, "context background");
    at(&d, pixels, 130 + 25, 25, 255, 0, 0, NBNEG, "negative z-index above the background");
    at(&d, pixels, 130 + 50, 50, 0, 0, 255, NBFLOW, "in-flow content above the negative z-index");
    // 2, 3, 4: effects that make a context
    for q in 0..3 {
        let x0 = 260 + 130 * q;
        at(&d, pixels, x0 + 50, 50, 0, 255, 0, NC0 + q * 3 + 2, "sibling z-index 3 over z-index 5 inside an effect context");
        at(&d, pixels, x0 + 10, 10, 255, 0, 0, NC0 + q * 3 + 1, "the inner box alone");
    }
    // 5: fixed escapes the clip
    at(&d, pixels, 700, 210, 255, 0, 255, NFX, "a fixed box paints and is hit outside its parent's overflow clip");
    at(&d, pixels, 650 + 30, 30, 136, 136, 136, NFC, "the clipping parent");
    // 6: overlay
    at(&d, pixels, 800, 20, 0, 0, 255, NPOP, "an overlay is above a z-index 99999 box");
    at(&d, pixels, 780 + 5, 65, 255, 0, 0, NHI, "the z-index box where no overlay is");
    // 7: flex order
    at(&d, pixels, 910 + 45, 25, 255, 0, 0, NIT0, "the last flex item in visual order is on top");
    at(&d, pixels, 910 + 25, 25, 0, 255, 0, NIT0 + 1, "the middle one over the first");
    // 8: pointer-events none
    at(&d, pixels, 1040 + 40, 40, 255, 0, 0, NPE1, "a box with pointer-events: none paints on top and lets the pointer through");

    // 9: a flex item's z-index (the red item comes first in the tree but has z-index 2)
    at(&d, pixels, 1170 + 40, 25, 255, 0, 0, NFI0, "a z-index on a static flex item puts it over the later item");
    at(&d, pixels, 1170 + 60, 25, 0, 255, 0, NFI0 + 1, "the later item where the first is not");
    ok(d.nodes.items[IDS[NFI0]].ctx && !d.nodes.items[IDS[NFI0 + 1]].ctx, "the z-indexed flex item is a context, the other is not");
    // 10: a scroll box is no context, so its z-index 10 child outranks the z-index 5 sibling, within the scroll clip
    let by = 130;
    ok(!d.nodes.items[IDS[NSB]].ctx && d.nodes.items[IDS[NSB]].lift, "a scroll box is no stacking context, only lifted by its position");
    at(&d, pixels, 35, by + 50, 0, 0, 255, NSBZC, "a z-index 10 child of a scroll box is above a z-index 5 sibling of the scroll box");
    at(&d, pixels, 35, by + 80, 0, 255, 0, NSBZS, "outside the scroll clip the child is gone and the z-index 5 sibling shows");
    // its scrollbar paints and is hit above the z-index child (the track tints the blue)
    frame(&d, 55.0, f32(by + 50), pixels);
    frame(&d, 55.0, f32(by + 50), pixels);
    ok(channel(pixels, 55, by + 50, 0) >= 8 && d.hover == IDS[NSB] && d.barOf == IDS[NSB], "a scroller's bar is above its z-index child, painted and hit");
    // a detached paint of a scroller that is no context (a popup, a drag): its bars are above its z-index child as well
    d.simInput(-5.0, -5.0, false, 0.0);
    d.beginFrame(Vec2 { x: f32(W), y: f32(H) });
    build(&d);
    d.layout();
    d.paintAll();
    d.paintDetached(IDS[NSB]);
    d.endFrame();
    ok(game.readWindow(pixels), "read the frame");
    ok(channel(pixels, 55, 50, 0) >= 8 && channel(pixels, 55, 50, 2) > 240, "a detached scroller paints its bars over its child");
    // the wheel over the child scrolls the scroll box, and the child moves with it
    d.simInput(35.0, f32(by + 50), false, -1.0);
    frame(&d, 35.0, f32(by + 50), pixels);
    frame(&d, 35.0, f32(by + 50), pixels);
    ok(d.nodes.items[IDS[NSB]].scrollY > 0.0, "the wheel over a scroll box's z-index child scrolls the scroll box");
    at(&d, pixels, 35, by + 5, 0, 0, 255, NSBZC, "the child moved up with the scroll offset and shows where the box was bare");
    at(&d, pixels, 35, by + 80, 0, 255, 0, NSBZS, "and is still clipped below the scroll box");
    // 11: nested scroll boxes: the inner clip bounds the child, the outer does not hold it
    at(&d, pixels, 130 + 45, by + 45, 255, 0, 0, NZC2, "a z-index 10 child inside two scroll boxes is above the z-index 5 sibling");
    at(&d, pixels, 130 + 95, by + 95, 0, 255, 0, NZS2, "outside the inner scroll clip the sibling shows");
    d.simInput(f32(130 + 45), f32(by + 45), false, -1.0);
    frame(&d, f32(130 + 45), f32(by + 45), pixels);
    frame(&d, f32(130 + 45), f32(by + 45), pixels);
    ok(d.nodes.items[IDS[NSBI]].scrollY > 0.0 && d.nodes.items[IDS[NSBO]].scrollY == 0.0, "the wheel scrolls the nearest scroll box, the inner one");
    at(&d, pixels, 130 + 45, by + 45, 255, 0, 0, NZC2, "the child still fills the inner clip after it scrolled");
    // 12: in a rotated context the scroll clip is a shape that is pushed again for the child
    at(&d, pixels, 260 + 54, by + 10, 0, 0, 255, NRZC, "rotated: the z-index 10 child inside the scroll clip");
    at(&d, pixels, 260 + 46, by + 23, 0, 0, 255, NRZC, "rotated: just inside the scroll clip edge");
    at(&d, pixels, 260 + 41, by + 33, 0, 255, 0, NRZS, "rotated: just outside the scroll clip edge the sibling shows and is hit");
    at(&d, pixels, 260 + 29, by + 54, 0, 255, 0, NRZS, "rotated: far outside the clip");
    // 13: the modal covers the child and the bars, painted and hit
    at(&d, pixels, 390 + 35, by + 50, 255, 0, 0, NMD, "a z-index 100 box covers a scroller and its z-index 10 child");
    at(&d, pixels, 390 + 55, by + 45, 255, 0, 0, NMD, "and the scroller's bars");
    // 14: a sticky header in a scroller stays at its top while the scroller scrolls, clipped by it
    at(&d, pixels, 520 + 5, by + 5, 255, 0, 0, NSST, "the sticky header at rest");
    d.simInput(f32(520 + 5), f32(by + 30), false, -1.0);
    frame(&d, f32(520 + 5), f32(by + 30), pixels);
    frame(&d, f32(520 + 5), f32(by + 30), pixels);
    ok(d.nodes.items[IDS[NSS]].scrollY > 0.0, "the wheel scrolled the scroller with the sticky header");
    at(&d, pixels, 520 + 5, by + 5, 255, 0, 0, NSST, "the sticky header stays at the top of the scroller after it scrolled");
    frame(&d, -10.0, -10.0, pixels);
    pixel(pixels, 520 + 5, by + 70, 0, 0, 0, "and nothing of the scroller shows below its clip");
    ok(d.nodes.items[IDS[NS2]].ctx && d.nodes.items[IDS[NS2R]].lift, "a scroller whose only lifted boxes are plain positioned ones inside it stays a context");
    ok(!d.nodes.items[IDS[NSB]].ctx && !d.nodes.items[IDS[NMSB]].ctx, "a scroller with a z-indexed box inside is none");
    // transitions: only one of a property that can make a context counts
    ANIM = true;
    for i in 0..6 {
        frame(&d, -10.0, -10.0, pixels);
    }
    ok(d.nodes.items[IDS[NTR1]].style != d.nodes.items[IDS[NTR1]].tstyle, "the color transition is running");
    ok(!d.nodes.items[IDS[NTR1]].ctx, "a color transition does not make a stacking context");
    ok(d.nodes.items[IDS[NTR2]].ctx, "an opacity transition does");
    ANIM = false;
    // idle frames rebuild nothing, a changed tree does
    frame(&d, -10.0, -10.0, pixels);
    let builds = d.stackBuilds;
    for i in 0..20 {
        frame(&d, -10.0, -10.0, pixels);
    }
    ok(d.stackBuilds == builds, "idle frames do not rebuild the stacking lists");
    // a z-index that changes does: the first card now outranks its sibling, and its z-index 9999 box shows
    TWEAK = true;
    at(&d, pixels, 60, 40, 0, 0, 255, NAINN, "raising the first card's z-index above the second puts its inner box on top");
    ok(d.stackBuilds == builds + 1, "one rebuild for one changed z-index");
    for i in 0..20 {
        frame(&d, -10.0, -10.0, pixels);
    }
    ok(d.stackBuilds == builds + 1, "and none after it");
    // each Dom keeps its own paint hook: two roots do not share or clobber one
    let da = Dom.new(&mem, &css);
    let db = Dom.new(&mem, &css);
    da.setPaintHook(hookA, &HOOKS[0] as ptr);
    db.setPaintHook(hookB, &HOOKS[1] as ptr);
    canvasFrame(&da);
    ok(HOOKS[0] == 1 && HOOKS[1] == 0, "the first Dom's canvas calls its own hook");
    canvasFrame(&db);
    canvasFrame(&db);
    ok(HOOKS[0] == 1 && HOOKS[1] == 2, "the second Dom's canvas calls only its own");
    printLn(`stacking_test ok, checks passed: {CHECKS}`);
    game.destroy();
    mem.destroy();
}
