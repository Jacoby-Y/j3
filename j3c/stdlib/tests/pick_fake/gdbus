#!/bin/sh
# Fake gdbus for pick_test: a portal that answers OpenFile with $PICK_FAKE_URI (code $PICK_FAKE_CODE).
case "$1" in
introspect) [ -n "$PICK_FAKE_NOPORTAL" ] && exit 1; echo "interface org.freedesktop.portal.FileChooser {" ;;
call) shift; printf '%s\n' "$@" > "$PICK_FAKE_LOG"; t=$(printf '%s' "$*" | sed "s/.*'handle_token': <'\([^']*\)'.*/\1/")
      echo "(objectpath '/org/freedesktop/portal/desktop/request/1_9/$t',)"; echo "$t" > "$PICK_FAKE_LOG.tok" ;;
monitor) while [ ! -s "$PICK_FAKE_LOG.tok" ]; do sleep 0.05; done; t=$(cat "$PICK_FAKE_LOG.tok")
      echo "/org/freedesktop/portal/desktop/request/1_9/$t: org.freedesktop.portal.Request.Response (uint32 ${PICK_FAKE_CODE:-0}, {'uris': <['$PICK_FAKE_URI']>, 'choices': <@a(ss) []>})"
      exec sleep 30 ;;
esac
