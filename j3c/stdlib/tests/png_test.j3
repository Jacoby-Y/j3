// savePng writes compressed DEFLATE; loadPng reads it back pixel for pixel.
// Run from the repo root: timeout 60 j3c run j3c/stdlib/tests/png_test.j3
module png_test;
use j3.gfx.canvas;
use j3.gfx.canvas.{ Canvas, Mode, rgb };
use j3.io.{ printLn, readFile };
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;
fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let c = Canvas.create(&mem, 301, 97, Mode.Pixel);
    for i in 0..c.pixels.len { c.pixels[i] = u8((i * 7 + i / 1203) % 251); }
    c.fillRect(10, 10, 200, 50, rgb(30, 40, 50));
    match c.savePng("/tmp/j3-png-test.png", &mem) { Result.Ok(_) {} Result.Err(_) { panic("save"); } }
    let back = canvas.loadPng("/tmp/j3-png-test.png", &mem);
    if back.w != c.w || back.h != c.h { panic("size"); }
    for i in 0..c.pixels.len { if back.pixels[i] != c.pixels[i] { panic("pixel"); } }
    printLn("png ok");
}
