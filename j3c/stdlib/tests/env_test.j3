// j3.sys setenv: set, read back with env, overwrite, refuse bad names. Run from the repo root (cargo runs it on
// both backends):
//   timeout 60 j3c run j3c/stdlib/tests/env_test.j3

module env_test;

use j3.io.printLn;
use j3.sys;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        sys.panic(msg);
    }
}

fn main() {
    ok(sys.env("J3_ENV_TEST_X") == "", "unset at start");
    ok(sys.setenv("J3_ENV_TEST_X", "one two"), "setenv");
    ok(sys.env("J3_ENV_TEST_X") == "one two", "read back");
    ok(sys.setenv("J3_ENV_TEST_X", "2"), "overwrite");
    ok(sys.env("J3_ENV_TEST_X") == "2", "read back overwritten");
    ok(sys.setenv("J3_ENV_TEST_X", ""), "set empty");
    ok(sys.env("J3_ENV_TEST_X") == "", "read back empty");
    ok(sys.env("HOME").len > 0 || sys.env("PATH").len > 0, "inherited variables still read");
    ok(!sys.setenv("", "x"), "empty name refused");
    ok(!sys.setenv("A=B", "x"), "name with = refused");
    printLn("env_test ok");
}
