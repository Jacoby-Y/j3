// Tests for `box-decoration-break` on a decorated inline span that wraps over several lines in j3.ui.dom: `slice` (default) puts
// the left padding / border only on the first piece and the right only on the last; `clone` repeats both on every piece, so each
// piece is wider and the line breaks account for it. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/boxbreak_test.j3
// Panics on the first failed check.

module boxbreak_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.{ Dom, Frag };
use j3.ui.inputs;
use j3.text.same;

#[singleton]
let CHECKS: int;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 16px; width: 110px; } span { padding: 0 6px; border: 2px solid #ff0000; background: #888888; } .clone { box-decoration-break: clone; } .slice { box-decoration-break: slice; } .bad { box-decoration-break: nope; } .ra { text-align: right; } .ce { text-align: center; } .k { padding: 0 3px; border: 1px solid #00ff00; background: #444444; } .fx { display: flex; width: 20px; } .it { width: auto; } .top { vertical-align: top; } .tf { transform: translate(3px, 2px); } .sh { box-shadow: 0 2px 4px #000000; border-radius: 4px; }";
const WORDS: string = "alpha beta gamma delta epsilon zeta eta theta";

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff > 0.02 {
        printLn(`FAIL: {msg}: got {a}, want {b}`);
        panic(msg);
    }
}

fn frame(d: &Dom, cls: string): int {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let c = d.open(0, d.tag("div"), 1);
    let s = d.open(0, d.tag("span"), 1);
    if cls.len > 0 { d.cls(s, cls); }
    d.text(WORDS);
    d.close();
    d.close();
    d.layout();
    d.endFrame();
    return c;
}

/// Lay out one frame set and return the block id.
fn build(d: &Dom, cls: string): int {
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let c = frame(d, cls);
    c = frame(d, cls);
    return c;
}

fn pieces(d: &Dom, c: int): int {
    let n = 0;
    let b = d.nodes.items[c].box0;
    while b >= 0 { n += 1; b = d.boxes.items[b].next; }
    return n;
}

fn piece(d: &Dom, c: int, k: int): Frag {
    let b = d.nodes.items[c].box0;
    while k > 0 { b = d.boxes.items[b].next; k -= 1; }
    return d.boxes.items[b];
}

/// Left edge and right edge of the text on the k-th line (by the pieces' y order).
fn lineMin(d: &Dom, c: int, k: int): f32 {
    let y = piece(d, c, k).y;
    let m: f32 = 100000.0;
    let f = d.nodes.items[c].frag0;
    while f >= 0 {
        let fr = d.frags.items[f];
        if fr.kind == 0 && fr.y + fr.asc > y && fr.y + fr.asc < y + piece(d, c, k).ap && fr.x < m { m = fr.x; }
        f = fr.next;
    }
    return m;
}

fn lineMax(d: &Dom, c: int, k: int): f32 {
    let y = piece(d, c, k).y;
    let m: f32 = 0.0;
    let f = d.nodes.items[c].frag0;
    while f >= 0 {
        let fr = d.frags.items[f];
        if fr.kind == 0 && fr.y + fr.asc > y && fr.y + fr.asc < y + piece(d, c, k).ap && fr.x + fr.w > m { m = fr.x + fr.w; }
        f = fr.next;
    }
    return m;
}

/// The ids a nested frame hands back: block, outer span, inner span.
struct Ids {
    c: int;
    o: int;
    i: int;
}

fn addCls(d: &Dom, id: int, cls: string) {
    let sp = 0;
    while sp < cls.len && cls[sp] != 32 { sp += 1; }
    if cls.len > 0 { d.cls(id, cls[0..sp]); }
    if sp < cls.len { d.cls(id, cls[sp + 1..cls.len]); }
}

/// `<div blk><span o>alpha beta <span i>gamma delta epsilon </span>zeta eta theta</span>tail</div>`; without `i` the span is
/// plain words, without `tail` nothing follows it. `wrap` puts the block in a flex container (its own item).
fn frame2(d: &Dom, blk: string, o: string, i: string, tail: string, wrap: bool): Ids {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let fx = -1;
    if wrap {
        fx = d.open(0, d.tag("div"), 1);
        d.cls(fx, "fx");
    }
    let c = d.open(0, d.tag("div"), 1);
    addCls(d, c, blk);
    let os = d.open(0, d.tag("span"), 1);
    addCls(d, os, o);
    let ins = -1;
    if i.len > 0 {
        d.text("alpha beta ");
        ins = d.open(0, d.tag("span"), 1);
        addCls(d, ins, i);
        d.text("gamma delta epsilon ");
        d.close();
        d.text("zeta eta theta");
    } else {
        d.text(WORDS);
    }
    d.close();
    if tail.len > 0 { d.text(tail); }
    d.close();
    if wrap { d.close(); }
    d.layout();
    d.endFrame();
    return Ids { c: c, o: os, i: ins };
}

fn build2(d: &Dom, blk: string, o: string, i: string, tail: string, wrap: bool): Ids {
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let r = frame2(d, blk, o, i, tail, wrap);
    r = frame2(d, blk, o, i, tail, wrap);
    return r;
}

fn countOf(d: &Dom, c: int, node: int): int {
    let n = 0;
    let b = d.nodes.items[c].box0;
    while b >= 0 {
        if d.boxes.items[b].node == node { n += 1; }
        b = d.boxes.items[b].next;
    }
    return n;
}

fn pieceOf(d: &Dom, c: int, node: int, k: int): Frag {
    let b = d.nodes.items[c].box0;
    while b >= 0 {
        if d.boxes.items[b].node == node {
            if k == 0 { return d.boxes.items[b]; }
            k -= 1;
        }
        b = d.boxes.items[b].next;
    }
    panic("no such piece");
    return d.boxes.items[0];
}

/// The text fragment that is last / first on the line whose top is within the piece `p`.
fn lineFrag(d: &Dom, c: int, p: Frag, last: bool): Frag {
    let best = d.frags.items[d.nodes.items[c].frag0];
    let have = false;
    let f = d.nodes.items[c].frag0;
    while f >= 0 {
        let fr = d.frags.items[f];
        if fr.kind == 0 && fr.y + fr.asc > p.y && fr.y + fr.asc < p.y + p.ap {
            if !have || (last && fr.x > best.x) || (!last && fr.x < best.x) { best = fr; have = true; }
        }
        f = fr.next;
    }
    return best;
}

/// Right / center alignment: the closing edge is counted once, so a piece that ends its line sits flush with the edge.
fn testAlign(mem: &Arena, css: &Css) {
    for al in 0..2 {
        let cls = if al == 0 { "ra" } else { "ce" };
        let d = Dom.new(mem, css);
        let r = build2(&d, cls, "clone", "", "", false);
        let m = countOf(&d, r.c, r.o);
        ok(m >= 3, "aligned clone span wraps");
        for k in 0..m {
            let p = pieceOf(&d, r.c, r.o, k);
            if al == 0 { near(p.x + p.w, 110.0, "right-aligned clone piece is flush with the line end (closing edge counted once)"); }
            else { near(p.x + p.w / 2.0, 55.0, "centered clone piece is centered (closing edge counted once)"); }
        }
        // the span closes mid-line, followed by text: the last piece ends before the tail, which is flush right
        let t = Dom.new(mem, css);
        let q = build2(&t, cls, "clone", "", " tail", false);
        let n = countOf(&t, q.c, q.o);
        let lp = pieceOf(&t, q.c, q.o, n - 1);
        let tl = lineFrag(&t, q.c, lp, true);
        let gap = tl.x - (lp.x + lp.w);
        ok(gap > 0.0 && gap < 8.0, "the last piece closes with its edge before the tail text, once");
        if al == 0 { near(tl.x + tl.w, 110.0, "right-aligned line ends with the tail"); }
    }
}

/// `inner` and `outer` pieces on a 3+ line wrap: edges per box follow its own value; the inner box sits inside the outer on every line.
fn testNested(mem: &Arena, css: &Css, o: string, i: string) {
    let d = Dom.new(mem, css);
    let r = build2(&d, "", o, if same(i, "clone") { "clone k" } else { "slice k" }, "", false);
    let mo = countOf(&d, r.c, r.o);
    let mi = countOf(&d, r.c, r.i);
    ok(mo >= 3, "nested: the outer span wraps over 3 lines");
    ok(mi >= 2, "nested: the inner span wraps");
    let oc = same(o, "clone");
    let ic = same(i, "clone");
    for k in 0..mo {
        let p = pieceOf(&d, r.c, r.o, k);
        ok(p.start == (if oc || k == 0 { 1 } else { 0 }), "nested: outer left edge");
        ok(p.end == (if oc || k == mo - 1 { 1 } else { 0 }), "nested: outer right edge");
        ok(p.x + p.w <= 110.02, "nested: every outer piece fits the line");
        if oc { near(p.x, 0.0, "nested: a cloned outer piece starts at the line start"); }
    }
    for k in 0..mi {
        let ip = pieceOf(&d, r.c, r.i, k);
        ok(ip.start == (if ic || k == 0 { 1 } else { 0 }), "nested: inner left edge");
        ok(ip.end == (if ic || k == mi - 1 { 1 } else { 0 }), "nested: inner right edge");
        ok(ip.x + ip.w <= 110.02, "nested: every inner piece fits the line");
        // inside the outer piece of its line (same y, +-1 for the border-box rounding of a taller box)
        let inside = false;
        for q in 0..mo {
            let po = pieceOf(&d, r.c, r.o, q);
            if po.y - 0.01 <= ip.y && ip.y <= po.y + 4.0 && po.x - 0.01 <= ip.x && ip.x + ip.w <= po.x + po.w + 0.01 { inside = true; }
        }
        ok(inside, "nested: an inner piece lies inside an outer piece of its line");
    }
}

/// Min-content: a span as a shrink-to-fit flex item is exactly as wide as its widest piece, the longest word (`epsilon`, on a middle line) with its cloned edges.
fn testMin(mem: &Arena, css: &Css, cls: string) {
    let d = Dom.new(mem, css);
    let r = build2(&d, "it", cls, "", "", true);
    let w = d.nodes.items[r.c].w;
    ok(w > 20.0 && w < 110.0, "the flex item shrank to its min-content width");
    let widest: f32 = 0.0;
    for k in 0..countOf(&d, r.c, r.o) {
        let p = pieceOf(&d, r.c, r.o, k);
        if p.w > widest { widest = p.w; }
        ok(p.x + p.w <= w + 0.02, "no piece of the shrunk item overflows it");
    }
    near(w, widest, "min-content is exactly the widest piece (clone counts both cloned edges of the longest word)");
}

/// `vertical-align: top` and a transform on the block: the pieces still follow their text, nothing moves in layout.
fn testPlace(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    let r = build2(&d, "", "clone top", "", "", false);
    let m = countOf(&d, r.c, r.o);
    ok(m >= 3, "top: wraps");
    for k in 0..m {
        let p = pieceOf(&d, r.c, r.o, k);
        let fr = lineFrag(&d, r.c, p, false);
        near(p.y + 2.0, fr.y, "top: a cloned piece sits on its line's text (border 2px)");
    }
    let t = Dom.new(mem, css);
    let q = build2(&t, "tf", "clone sh", "", "", false);
    ok(countOf(&t, q.c, q.o) == m || countOf(&t, q.c, q.o) >= 3, "transform + shadow: still wraps");
    for k in 0..countOf(&t, q.c, q.o) {
        let tp = pieceOf(&t, q.c, q.o, k);
        let tfr = lineFrag(&t, q.c, tp, false);
        near(tp.y + 2.0, tfr.y, "transform + shadow: pieces sit on their lines");
    }
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);

    let ds = Dom.new(&mem, &css);
    let cs = build(&ds, "");
    let n = pieces(&ds, cs);
    ok(n >= 3, "the span wraps over at least 3 lines");
    ok(piece(&ds, cs, 0).start == 1 && piece(&ds, cs, 0).end == 0, "slice: first piece is a start only");
    ok(piece(&ds, cs, 1).start == 0 && piece(&ds, cs, 1).end == 0, "slice: middle piece has neither edge");
    ok(piece(&ds, cs, n - 1).start == 0 && piece(&ds, cs, n - 1).end == 1, "slice: last piece is an end only");
    near(piece(&ds, cs, 0).x, 0.0, "slice: first piece starts at the line start");
    near(lineMin(&ds, cs, 0), 8.0, "slice: text starts after the padding and border on the first line");
    near(lineMin(&ds, cs, 1), 0.0, "slice: a continuation line starts at the edge");
    near(piece(&ds, cs, 1).x, 0.0, "slice: continuation piece starts at the edge");
    near(piece(&ds, cs, 0).w, lineMax(&ds, cs, 0), "slice: a non-last piece ends at its text");
    near(piece(&ds, cs, n - 1).w, lineMax(&ds, cs, n - 1) + 8.0, "slice: the last piece closes with the right edge");

    let dc = Dom.new(&mem, &css);
    let cc = build(&dc, "clone");
    let m = pieces(&dc, cc);
    ok(m > n, "clone wraps over more lines: every piece is wider (here 6 vs 4)");
    for k in 0..m {
        let p = piece(&dc, cc, k);
        ok(p.start == 1 && p.end == 1, "clone: every piece has both edges");
        near(p.x, 0.0, "clone: every piece starts at the line start");
        near(lineMin(&dc, cc, k), 8.0, "clone: text on every line starts after the left padding and border");
        near(p.w, lineMax(&dc, cc, k) + 8.0, "clone: every piece closes with the right padding and border");
        ok(p.x + p.w <= 110.02, "clone: the closing edge fits in the line");
    }
    // slice's non-last line ends fit without the right edge; a cloned line must leave room for it
    ok(m > n || lineMax(&dc, cc, 0) <= lineMax(&ds, cs, 0) + 0.01, "clone's first line is no longer than slice's");

    let db = Dom.new(&mem, &css);
    let cb = build(&db, "bad");
    ok(pieces(&db, cb) == n && piece(&db, cb, 1).start == 0, "an invalid value is dropped (slice)");
    let dl = Dom.new(&mem, &css);
    let cl = build(&dl, "slice");
    ok(pieces(&dl, cl) == n && piece(&dl, cl, 1).start == 0, "explicit slice is the default");

    testAlign(&mem, &css);
    testNested(&mem, &css, "clone", "clone");
    testNested(&mem, &css, "clone", "slice");
    testNested(&mem, &css, "slice", "clone");
    testNested(&mem, &css, "slice", "slice");
    testMin(&mem, &css, "clone");
    testMin(&mem, &css, "slice");
    testPlace(&mem, &css);

    printLn(`boxbreak_test: {CHECKS} checks passed`);
}
