// dom_test: scroll/click runtime and z-index.

module dom_test;

const RT_CSS: string = ".box { height: 100px; overflow-y: auto; } .b { height: 30px; background: #000000; } .card { height: 20px; background: #ff0000; transition: background 100ms; } .card:hover { background: #0000ff; } .fade { height: 10px; }";

fn rtFrame(d: &Dom, on: bool) {
    d.beginFrame(Vec2 { x: 1000.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "box");
    for k in 0..6 {
        let b = el(d, k, "div", S_TEST, "b");
        d.attrDisabled(b, k == 3);
        RT[k] = if d.clicked(b) { 1 } else { 0 };
        d.close();
    }
    d.close();
    el(d, 1, "div", S_TEST, "card");
    d.close();
    if on {
        let f = el(d, 2, "div", S_TEST, "fade");
        d.fade(f, 100.0);
        d.close();
    }
    d.layout();
    d.endFrame();
}

fn rtClick(d: &Dom, on: bool, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    rtFrame(d, on);
    d.simInput(x, y, true, 0.0);
    rtFrame(d, on);
    d.simInput(x, y, false, 0.0);
    rtFrame(d, on);
}

const Z_CSS: string = ".host { position: relative; height: 40px; } .top { position: absolute; left: 0px; top: 0px; width: 50px; height: 50px; z-index: 5; } .under { height: 40px; }";

fn zFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 200.0, y: 200.0 });
    el(d, 0, "div", S_TEST, "host");
    let t = el(d, 0, "div", S_TEST, "top");
    RT[0] = if d.clicked(t) { 1 } else { 0 };
    d.close();
    d.close();
    let u = el(d, 1, "div", S_TEST, "under");
    RT[1] = if d.clicked(u) { 1 } else { 0 };
    d.close();
    d.layout();
    d.endFrame();
}

/// `z-index`: a positioned element overlapping a later sibling wins the hit test, and the layer list is built.
fn testZIndex(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, Z_CSS, "z.css", S_TEST);
    ok(css.warns.len == 0, "z-index parses with no warning");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(10.0, 45.0, false, 0.0);
    zFrame(&d);
    d.simInput(10.0, 45.0, true, 0.0);
    zFrame(&d);
    d.simInput(10.0, 45.0, false, 0.0);
    zFrame(&d);
    ok(RT[0] == 1 && RT[1] == 0, "the z-indexed element is hit over the later sibling");
    ok(d.timeMs() == 48.0, "timeMs follows setFrameMs: three frames of 16 ms");
    ok(d.stackBuilds >= 1 && d.nodes.items[1].lift, "the hit test built the stacking lists (the z-indexed box is lifted)");
}

fn testRuntime(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, RT_CSS, "rt.css", S_TEST);
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    rtFrame(&d, false);
    rtFrame(&d, false);
    // click: press and release on the same node
    rtClick(&d, false, 10.0, 45.0);
    ok(RT[1] == 1 && RT[0] == 0 && RT[2] == 0, "click lands on the one node under the mouse");
    // disabled node swallows the click
    rtClick(&d, false, 10.0, 91.0);
    ok(RT[3] == 0 && RT[2] == 0 && RT[4] == 0, "disabled node gets no click");
    // press on one node, release on another: no click
    d.simInput(10.0, 15.0, false, 0.0);
    rtFrame(&d, false);
    d.simInput(10.0, 15.0, true, 0.0);
    rtFrame(&d, false);
    d.simInput(10.0, 75.0, false, 0.0);
    rtFrame(&d, false);
    ok(RT[0] == 0 && RT[2] == 0 && RT[1] == 0, "press and release on different nodes is not a click");
    // hover: the card restyles and starts a background transition
    let r0 = d.restyled;
    d.simInput(10.0, 110.0, false, 0.0);
    rtFrame(&d, false);
    rtFrame(&d, false);
    ok(d.restyled > r0, "hover restyles");
    ok(d.animating == 1, "hover starts one transition");
    // wheel scrolls the nearest scrollable ancestor, clamped to scrollMax
    let box = kid(&d, 0, 0);
    d.simInput(10.0, 50.0, false, -1.0);
    rtFrame(&d, false);
    near(d.nodes.items[box].scrollY, 48.0, 0.01, "wheel scrolls by 48");
    d.simInput(10.0, 50.0, false, -5.0);
    rtFrame(&d, false);
    near(d.nodes.items[box].scrollY, 80.0, 0.01, "scroll clamps at scrollMax");
    // hit test follows the scroll offset: y=50 is now content y=130, which is node 4
    rtClick(&d, false, 10.0, 50.0);
    ok(RT[4] == 1, "click after scrolling hits the node under the mouse");
    // bind:scrollY: a scroll by the user comes back, a new value from code moves the box
    near(d.bindScroll(box, 0.0, false), 80.0, 0.01, "bindScroll returns the wheel's offset");
    near(d.bindScroll(box, 20.0, false), 20.0, 0.01, "bindScroll takes a new value");
    near(d.nodes.items[box].scrollY, 20.0, 0.01, "...and moves the box");
    near(d.bindScroll(box, 500.0, false), 80.0, 0.01, "bindScroll clamps to the range");
    d.bindScroll(box, 20.0, false);
    // on:wheel|stop (flag 4): the wheel over the box scrolls nothing
    d.attrFlag(box, 4);
    d.simInput(10.0, 50.0, false, -1.0);
    rtFrame(&d, false);
    near(d.nodes.items[box].scrollY, 20.0, 0.01, "on:wheel|stop keeps the box still");
    d.nodes.items[box].fWheel = false;
    d.simInput(10.0, 50.0, false, -1.0);
    rtFrame(&d, false);
    near(d.bindScroll(box, 20.0, false), 68.0, 0.01, "without the flag the wheel scrolls, and the bind follows");
    d.nodes.items[box].scrollY = 80.0;
    // fade ghost: leaving keeps the node, then the sweep removes it
    d.simInput(-5.0, -5.0, false, 0.0);
    rtFrame(&d, true);
    ok(d.ghosts == 0, "no ghost while the node is present");
    rtFrame(&d, false);
    ok(d.ghosts == 1, "leaving a transition:fade node keeps a ghost");
    ok(d.nodes.items[0].last >= 0 && d.nodes.items[d.nodes.items[0].last].ghost, "the ghost stays in the tree");
    for k in 0..8 {
        rtFrame(&d, false);
    }
    ok(d.ghosts == 0, "ghost removed after its fade");
    // steady: idle frames cost no layout, no restyle, no allocation
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..10000 {
        rtFrame(&d, false);
    }
    ok(d.laid == laid0 && d.restyled == re0, "10000 idle frames: 0 layouts, 0 style recomputes");
    ok(mem.used == used0, "10000 idle frames: no arena growth");
    // slots: enter/leave keep nested constructs apart
    d.begin();
    let s1 = d.enter(1);
    let a = el(&d, 0, "div", S_TEST, "b");
    d.close();
    d.leave(s1);
    let s2 = d.enter(2);
    let c = el(&d, 0, "div", S_TEST, "b");
    d.close();
    d.leave(s2);
    ok(a != c && d.nodes.items[a].slot < d.nodes.items[c].slot, "enter(1) sorts before enter(2)");
    d.end();
}
