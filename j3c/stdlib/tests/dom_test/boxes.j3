// dom_test: min-width, box sizes and HTML tag defaults.

module dom_test;

fn testMinWidth(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let r1 = el(&t, 0, "div", S_TEST, "row");
    let a1 = el(&t, 0, "div", S_TEST, "fa");
    let wd1 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b1 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    let r2 = el(&t, 1, "div", S_TEST, "row");
    let a2 = el(&t, 0, "div", S_TEST, "fz");
    let wd2 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b2 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    t.end();
    t.layoutAt(1000.0, 600.0);
    // fa: min-width auto = min-content = the 300px child, so it overflows the 200px row
    near(nw(&t, a1), 300.0, 0.01, "min-width:auto: the item keeps its 300px min-content");
    near(nw(&t, b1), 0.0, 0.01, "overflowing row: the 50px empty item shrinks (flex-shrink 1, its auto min is 0)");
    near(nx(&t, b1), 300.0, 0.01, "second item pushed past the row end");
    // fz: min-width 0, flex:1 -> 200 - 50
    near(nw(&t, a2), 150.0, 0.01, "min-width:0: the item shrinks to the free space");
    near(nx(&t, b2), 150.0, 0.01, "second item stays inside the row");
    near(nw(&t, b2), 50.0, 0.01, "second item keeps its 50px");
    // shrink: two 150px items in 200px -> 100 each (proportional to base size)
    let t3 = Dom.new(mem, css);
    t3.begin();
    el(&t3, 0, "div", S_TEST, "row");
    let sa = el(&t3, 0, "div", S_TEST, "s150");
    t3.close();
    let sb = el(&t3, 1, "div", S_TEST, "s150");
    t3.close();
    t3.close();
    t3.end();
    t3.layoutAt(1000.0, 600.0);
    near(nw(&t3, sa), 100.0, 0.01, "shrink: 150px items in a 200px row -> 100");
    near(nw(&t3, sb), 100.0, 0.01, "shrink: second item");
    near(nx(&t3, sb), 100.0, 0.01, "shrink: second item x");
    ok(r1 >= 0 && r2 >= 0 && wd1 >= 0 && wd2 >= 0, "ids");

}

fn testBoxes(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let cb = el(&t, 0, "div", S_TEST, "cbx");
    t.close();
    let nn = el(&t, 1, "div", S_TEST, "none");
    t.close();
    let pc = el(&t, 2, "div", S_TEST, "pct");
    t.close();
    let mg = el(&t, 3, "div", S_TEST, "mg");
    t.close();
    let rel = el(&t, 4, "div", S_TEST, "rel");
    let ab = el(&t, 0, "div", S_TEST, "abr");
    t.close();
    let ab2 = el(&t, 1, "div", S_TEST, "abs2");
    t.text("hi");
    t.close();
    t.close();
    let after = el(&t, 5, "div", S_TEST, "mg");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    near(nw(&t, cb), 124.0, 0.01, "content-box: width 100 + padding 20 + border 4");
    near(nh(&t, cb), 54.0, 0.01, "content-box: height 30 + 24");
    near(ny(&t, pc), nh(&t, cb), 0.01, "display:none takes no space");
    near(nw(&t, pc), 200.0, 0.01, "width 50% of 400");
    near(nx(&t, mg), 7.0, 0.01, "margin-left 7");
    near(ny(&t, mg), nh(&t, cb) + 20.0 + 5.0, 0.01, "margin-top 5, no collapsing with the previous sibling");
    near(nw(&t, mg), 386.0, 0.01, "block stretches between margins");
    near(ny(&t, rel), ny(&t, mg) + 10.0 + 5.0, 0.01, "next after margin-bottom 5");
    near(nx(&t, ab), 70.0, 0.01, "absolute right:10");
    near(ny(&t, ab), 67.0, 0.01, "absolute bottom:5");
    near(nx(&t, ab2), 4.0, 0.01, "absolute left:4");
    near(ny(&t, ab2), 3.0, 0.01, "absolute top:3");
    near(nw(&t, ab2), tw(16, false, "hi"), 1.0, "absolute shrink-to-fit width (only left set)");
    ok(nn >= 0 && after >= 0, "ids");

}

// The built-in tag styles (the `j3.ui.uastyle` UA sheet, `tagDisplay`) and how they meet author rules: an author
// class beats the UA rule, an equal-weight author tag rule comes later and wins, and inherited `white-space` reaches code.
const HTML_CSS: string = ".title { font-weight: 400; } .pl { font-weight: 400; } .box { width: 300px; } .m { margin: 8px 0; } b { font-weight: 300; }";

fn testHtmlTags(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c); // first, as a generated root does: the author sheet below comes after it
    parse(&c, HTML_CSS, "html.css", S_TEST);
    let t = Dom.new(mem, &c);
    t.begin();
    let ul = el(&t, 0, "ul", S_TEST, "");
    let li = el(&t, 0, "li", S_TEST, "");
    let st = el(&t, 0, "strong", S_TEST, "");
    t.text("bold");
    t.close();
    let tt = el(&t, 1, "strong", S_TEST, "title");
    t.text("title");
    t.close();
    t.close();
    t.close();
    let p = el(&t, 1, "p", S_TEST, "pl");
    let sp = el(&t, 0, "strong", S_TEST, "");
    t.text("in p");
    t.close();
    t.close();
    let h3 = el(&t, 2, "h3", S_TEST, "");
    let em = el(&t, 0, "em", S_TEST, "");
    t.text("x");
    t.close();
    t.close();
    let pre = el(&t, 3, "pre", S_TEST, "");
    let cd = el(&t, 0, "code", S_TEST, "");
    t.text("k");
    t.close();
    t.close();
    let bx = el(&t, 4, "div", S_TEST, "box");
    let hr = el(&t, 0, "hr", S_TEST, "m");
    t.close();
    t.close();
    let bb = el(&t, 5, "b", S_TEST, "");
    t.text("b");
    t.close();
    let a = el(&t, 6, "a", S_TEST, "");
    t.text("link");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    ok(t.nodes.items[ul].disp == dom.DP_BLOCK && t.nodes.items[li].disp == dom.DP_BLOCK, "ul and li are blocks");
    ok(t.nodes.items[pre].disp == dom.DP_BLOCK && t.nodes.items[hr].disp == dom.DP_BLOCK, "pre and hr are blocks");
    ok(t.nodes.items[h3].disp == dom.DP_BLOCK && t.nodes.items[bx].disp == dom.DP_BLOCK, "h3 and a div are blocks");
    ok(t.nodes.items[st].disp == dom.DP_INLINE && t.nodes.items[a].disp == dom.DP_INLINE, "strong and a are inline");
    ok(t.nodes.items[cd].disp == dom.DP_INLINE, "code is inline");
    ok(c.get(t.nodes.items[st].tstyle, P_FONT_WEIGHT).f == 700.0, "strong is bold (700)");
    ok(c.get(t.nodes.items[tt].tstyle, P_FONT_WEIGHT).f == 400.0, "an author class beats the UA strong rule");
    ok(c.get(t.nodes.items[sp].tstyle, P_FONT_WEIGHT).f == 700.0, "strong inside a font-weight 400 p is still bold");
    ok(c.get(t.nodes.items[bb].tstyle, P_FONT_WEIGHT).f == 300.0, "an author b rule after the UA sheet wins at equal weight");
    ok(c.get(t.nodes.items[em].tstyle, P_FONT_STYLE).i == 1, "em is italic, also inside an h3");
    ok(c.get(t.nodes.items[cd].tstyle, P_WHITE_SPACE).i == WS_PRE, "pre's white-space reaches a nested code");
    ok(c.get(t.nodes.items[a].tstyle, P_CURSOR).i == 2, "a has a pointer cursor");
    near(nh(&t, hr), 1.0, 0.01, "hr is a 1px rule");
    near(nw(&t, hr), nw(&t, bx), 0.01, "hr with margin 8px 0 is the full width of its block");
    near(nw(&t, hr), 300.0, 0.01, "hr width is the box's 300");
    near(ny(&t, hr) - ny(&t, bx), 8.0, 0.01, "hr keeps its margin-top 8");
    // a universal author rule is a later, user origin: it beats the UA em rule at specificity 0
    let c2 = Css.new(mem);
    uastyle.load(&c2);
    parse(&c2, "* { font-style: normal; }", "star.css", S_TEST);
    let t2 = Dom.new(mem, &c2);
    t2.begin();
    let e2 = el(&t2, 0, "em", S_TEST, "");
    t2.text("x");
    t2.close();
    t2.end();
    t2.layoutAt(400.0, 300.0);
    ok(c2.get(t2.nodes.items[e2].tstyle, P_FONT_STYLE).i == 0, "a universal author rule beats the UA em rule");
    ok(p >= 0 && sp >= 0, "ids");
}
